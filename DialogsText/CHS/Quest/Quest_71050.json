    "talks": [
        {
            "id": "7105004",
            "objective": "test隐藏判断玩家在地下$HIDDEN",
            "dialogues": [
                {
                    "id": "710500401",
                    "speaker": "Player",
                    "text": "关于这种蘑菇…"
                },
                {
                    "id": "710500402",
                    "speaker": "海迪夫",
                    "text": "该说真不愧是经验丰富的冒险家吗，这么快就有所发现了。"
                },
                {
                    "id": "710500403",
                    "speaker": "海迪夫",
                    "text": "嗯？这确定是在这里采摘的菌类吗，这可有点奇怪啊…"
                },
                {
                    "id": "710500404",
                    "speaker": "Player",
                    "text": "地下不能长蘑菇吗？"
                },
                {
                    "id": "710500405",
                    "speaker": "海迪夫",
                    "text": "也不是不能长的问题。"
                },
                {
                    "id": "710500406",
                    "speaker": "海迪夫",
                    "text": "只是因为这个菌和生长在须弥的一种菌很像…"
                },
                {
                    "id": "710500407",
                    "speaker": "海迪夫",
                    "text": "只有一种不太够啊…如果有足够多的样本，说不定就能看出些什么。"
                },
                {
                    "id": "710500408",
                    "speaker": "海迪夫",
                    "text": "足够多的样本啊…这个既然也是你拿回来的，肯定知道在哪里还有…不如你帮我采点吧！"
                },
                {
                    "id": "710500409",
                    "speaker": "海迪夫",
                    "text": "你帮我采足够多的蘑菇，我给你足够多的钱作为报酬。"
                },
                {
                    "id": "710500410",
                    "speaker": "Player",
                    "text": "足够多是多少蘑菇？"
                },
                {
                    "id": "710500411",
                    "speaker": "海迪夫",
                    "text": "嗯…我想想，那就先采8个吧。"
                },
                {
                    "id": "710500412",
                    "speaker": "海迪夫",
                    "text": "没关系，只要你带过来，钱不会少你的！"
                }
            ]
        },
        {
            "id": "7105001",
            "objective": "与海迪夫谈论层岩蘑菇之事$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7105002",
            "objective": "收集8只发光的蘑菇",
            "dialogues": [
                {
                    "id": "710500201",
                    "speaker": "海迪夫",
                    "text": "收集齐了吗？牛"
                }
            ]
        },
        {
            "id": "7105003",
            "objective": "将采摘到的发光蘑菇交给海迪夫进行鉴定",
            "dialogues": [
                {
                    "id": "710500701",
                    "speaker": "Player",
                    "text": "蘑菇采回来了。"
                },
                {
                    "id": "710500702",
                    "speaker": "海迪夫",
                    "text": "嗯嗯，多谢多谢。"
                },
                {
                    "id": "710500703",
                    "speaker": "海迪夫",
                    "text": "有了你的帮助，我的调查就像是…有句璃月话是怎么说的来着，「就像猛虎插上了翅膀一样顺利」。"
                },
                {
                    "id": "710500704",
                    "speaker": "Player",
                    "text": "如虎添翼？"
                },
                {
                    "id": "710500705",
                    "speaker": "海迪夫",
                    "text": "对，简直就是如虎添翼。"
                },
                {
                    "id": "710500706",
                    "speaker": "海迪夫",
                    "text": "这些菌类，怎么会这样呢…"
                },
                {
                    "id": "710500707",
                    "speaker": "海迪夫",
                    "text": "这可奇怪了，这种菌类和须弥的一种菌类简直就是一模一样，但怎么会发光呢，在黑暗中生长所以长出了荧光素？"
                },
                {
                    "id": "710500708",
                    "speaker": "海迪夫",
                    "text": "但是既然已经进化出荧光素，为什么菌类的本体什么变化都没有？",
                    "choices": [
                        {
                            "id": "710500709",
                            "text": "完全听不懂…",
                            "response": [
                                {
                                    "id": "710500711",
                                    "speaker": "海迪夫",
                                    "text": "嗯…简单来说，菌类会适应环境进化，但是这种真菌的本体，显然是更适合生长在森林环境的品种。"
                                },
                                {
                                    "id": "710500712",
                                    "speaker": "海迪夫",
                                    "text": "所以，这种真菌本来是生长在须弥的，这点毋庸置疑。"
                                },
                                {
                                    "id": "710500713",
                                    "speaker": "Player",
                                    "text": "那发光是…"
                                },
                                {
                                    "id": "710500714",
                                    "speaker": "海迪夫",
                                    "text": "真菌不是层岩巨渊的原生种，就说明发光不是进化产物，而是非正常生态影响导致的…"
                                },
                                {
                                    "id": "710500715",
                                    "speaker": "海迪夫",
                                    "text": "大概因为那个天上掉下来的碎块吧，吸收了它的能量…",
                                    "choices": [
                                        {
                                            "id": "710500716",
                                            "text": "碎块？",
                                            "response": [
                                                {
                                                    "id": "710500718",
                                                    "speaker": "海迪夫",
                                                    "text": "咳咳…嗯？你刚才说什么，碎块？啊，我是说，肯定是因为真菌的碎块从天上飘下来的时候产生了…"
                                                },
                                                {
                                                    "id": "710500719",
                                                    "speaker": "海迪夫",
                                                    "text": "产生了偶发性的变异。"
                                                },
                                                {
                                                    "id": "710500720",
                                                    "speaker": "海迪夫",
                                                    "text": "一定是这样的！"
                                                },
                                                {
                                                    "id": "710500721",
                                                    "speaker": "海迪夫",
                                                    "text": "嗯，能采集这些真菌真是感谢你，辛苦了辛苦了，先去好好休息一下吧！"
                                                },
                                                {
                                                    "id": "710500722",
                                                    "speaker": "海迪夫",
                                                    "text": "我要对这些真菌再做些研究，旁边有人会打扰到我的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710500717",
                                            "text": "什么碎块？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710500710",
                            "text": "有什么问题吗？"
                        }
                    ]
                }
            ]
        }
    ]
