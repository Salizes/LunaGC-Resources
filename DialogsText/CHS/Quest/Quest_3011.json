    "talks": [
        {
            "id": "301118",
            "objective": "与纳西妲对话",
            "dialogues": []
        },
        {
            "id": "301101",
            "objective": "与纳西妲对话",
            "dialogues": [
                {
                    "id": "30111113",
                    "speaker": "纳西妲",
                    "text": "嗯…",
                    "choices": [
                        {
                            "id": "30111101",
                            "text": "时间没有在循环…",
                            "response": [
                                {
                                    "id": "30111103",
                                    "speaker": "派蒙",
                                    "text": "对哦！每天晚上虚空的那个音效，说不定就是在删除我们当天的记忆…"
                                },
                                {
                                    "id": "30111104",
                                    "speaker": "派蒙",
                                    "text": "所以一觉醒来，所有人都以为花神诞祭还没有度过，明明已经是「明天」了，但都还以为是「昨天」。"
                                },
                                {
                                    "id": "30111105",
                                    "speaker": "派蒙",
                                    "text": "可身体记忆是删除不了的，所以迪希雅的新大剑才越用越熟练！这下就都说得通了！"
                                },
                                {
                                    "id": "30111106",
                                    "speaker": "纳西妲",
                                    "text": "…很巧妙的推论。"
                                },
                                {
                                    "id": "30111107",
                                    "speaker": "派蒙",
                                    "text": "那到底说对了没有呀，纳西妲！"
                                },
                                {
                                    "id": "30111108",
                                    "speaker": "纳西妲",
                                    "text": "简单来说的话，像是捉了火元素的晶蝶来当作萤火虫去照明，太过注重「感受」，而忽略了其「本质」。"
                                },
                                {
                                    "id": "30111109",
                                    "speaker": "派蒙",
                                    "text": "这一点都不简单…"
                                },
                                {
                                    "id": "30111110",
                                    "speaker": "Player",
                                    "text": "依旧是错误的结论吗…"
                                },
                                {
                                    "id": "30111111",
                                    "speaker": "纳西妲",
                                    "text": "不妨你们再去找那位迪希雅小姐聊聊吧，会有新的收获也说不定。"
                                },
                                {
                                    "id": "30111112",
                                    "speaker": "派蒙",
                                    "text": "嗯，毕竟新的线索是从她身上发现的…我们走吧？"
                                }
                            ]
                        },
                        {
                            "id": "30111102",
                            "text": "而是我们的记忆每天都在被删除。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "301102",
            "objective": "与迪希雅对话",
            "dialogues": [
                {
                    "id": "30110201",
                    "speaker": "迪希雅",
                    "text": "…你们原来在这里，可算找到你们了。"
                },
                {
                    "id": "30110202",
                    "speaker": "派蒙",
                    "text": "今天的迪希雅果然也没有受伤呢。"
                },
                {
                    "id": "30110203",
                    "speaker": "迪希雅",
                    "text": "受伤？受什么伤？别太小瞧我了。"
                },
                {
                    "id": "30110204",
                    "speaker": "派蒙",
                    "text": "你的新大剑毕竟不是那么趁手嘛…"
                },
                {
                    "id": "30110205",
                    "speaker": "迪希雅",
                    "text": "其实我也觉得很奇怪，今天突然就变得趁手了起来…不对，你们怎么知道我换过大剑的事？我应该不可能透露过…"
                },
                {
                    "id": "30110206",
                    "speaker": "派蒙",
                    "text": "唔，这次还是你来解释吧，我实在已经解释腻了…",
                    "choices": [
                        {
                            "id": "30110207",
                            "text": "其实也没必要完全让迪希雅理解。",
                            "response": [
                                {
                                    "id": "30110209",
                                    "speaker": "派蒙",
                                    "text": "这样啊，也是。"
                                },
                                {
                                    "id": "30110210",
                                    "speaker": "Player",
                                    "text": "你的大剑忽然变得趁手的原因…",
                                    "choices": [
                                        {
                                            "id": "30110211",
                                            "text": "是我们连续度过了许多个花神诞日。",
                                            "response": [
                                                {
                                                    "id": "30110213",
                                                    "speaker": "迪希雅",
                                                    "text": "…我不在的这会儿你们怎么了，是被什么奇奇怪怪的人传教了吗？"
                                                },
                                                {
                                                    "id": "30110214",
                                                    "speaker": "派蒙",
                                                    "text": "哎呀，别管那么多，你就当做是真的吧。"
                                                },
                                                {
                                                    "id": "30110215",
                                                    "speaker": "迪希雅",
                                                    "text": "…好吧，我理解你们的意思。就是说我的身体记忆已经让我完全适应这把剑了，只是我的大脑不记得这件事了，对吗？"
                                                },
                                                {
                                                    "id": "30110216",
                                                    "speaker": "派蒙",
                                                    "text": "没错，每天都会忘记一次。"
                                                },
                                                {
                                                    "id": "30110217",
                                                    "speaker": "迪希雅",
                                                    "text": "那我可反驳了哦？这种情况是绝对不可能的。"
                                                },
                                                {
                                                    "id": "30110218",
                                                    "speaker": "派蒙",
                                                    "text": "哦？说来听听？"
                                                },
                                                {
                                                    "id": "30110219",
                                                    "speaker": "迪希雅",
                                                    "text": "如果一连很多天都是花神诞祭，只是我们不记得的话，那所有的物资消耗，花掉的钱，吃掉的东西该怎么办？"
                                                },
                                                {
                                                    "id": "30110220",
                                                    "speaker": "迪希雅",
                                                    "text": "按理说我的钱包早该空空如也了，不可能没发现的吧？"
                                                },
                                                {
                                                    "id": "30110221",
                                                    "speaker": "Player",
                                                    "text": "这一点我也想到过。",
                                                    "choices": [
                                                        {
                                                            "id": "30110222",
                                                            "text": "在幕后黑手是贤者的情况下…",
                                                            "response": [
                                                                {
                                                                    "id": "30110224",
                                                                    "speaker": "派蒙",
                                                                    "text": "的确…用虚空记录全城人每天的行为，再动用全城的资源去恢复到这一天的开始…"
                                                                },
                                                                {
                                                                    "id": "30110225",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽说不太可能，但或许还是可以做到的。"
                                                                },
                                                                {
                                                                    "id": "30110226",
                                                                    "speaker": "迪希雅",
                                                                    "text": "不可能不可能，我有证据。"
                                                                },
                                                                {
                                                                    "id": "30110227",
                                                                    "speaker": "派蒙",
                                                                    "text": "你有证据？在哪里？"
                                                                },
                                                                {
                                                                    "id": "30110228",
                                                                    "speaker": "迪希雅",
                                                                    "text": "唉…你们对这种莫名其妙的讨论还真是认真啊，好吧好吧，就让我再陪你们一会儿。"
                                                                },
                                                                {
                                                                    "id": "30110229",
                                                                    "speaker": "迪希雅",
                                                                    "text": "跟我来吧，还有迪娜泽黛小姐也请一起，目前还没法保证这附近的安全。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "30110223",
                                                            "text": "如果利用虚空的数据和全城的资源…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30110212",
                                            "text": "只是每天晚上会被消除当天的记忆。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30110208",
                            "text": "直接切入重点好了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "301103",
            "objective": "前往查看迪希雅所说的「证据」",
            "dialogues": [
                {
                    "id": "30110301",
                    "speaker": "迪希雅",
                    "text": "就是这个了。"
                },
                {
                    "id": "30110302",
                    "speaker": "派蒙",
                    "text": "这什么呀，你练剑的木人桩吗？这个怎么了？"
                },
                {
                    "id": "30110303",
                    "speaker": "迪希雅",
                    "text": "看到上面的痕迹了吗？是我这几天的积累。"
                },
                {
                    "id": "30110304",
                    "speaker": "迪希雅",
                    "text": "假设贤者不会每天来把它换掉，它应该早就已经被砍的破破烂烂了对吧？"
                },
                {
                    "id": "30110305",
                    "speaker": "派蒙",
                    "text": "对呀，那每天都换一个的情况呢？"
                },
                {
                    "id": "30110306",
                    "speaker": "迪希雅",
                    "text": "那贤者每次都要在新的木人桩上复制出我之前练剑的剑痕。"
                },
                {
                    "id": "30110307",
                    "speaker": "迪希雅",
                    "text": "好歹我也是武者，在我的武学流派里，对「控制」的讲求非常精细。"
                },
                {
                    "id": "30110308",
                    "speaker": "迪希雅",
                    "text": "每一次挥剑，力度、角度、切入点都是用心控制过的，所以上面每一道伤痕我都记得，也记得挥出那一剑的心境。"
                },
                {
                    "id": "30110309",
                    "speaker": "迪希雅",
                    "text": "正如有句话，武者之剑乃独一无二，没有人可以挥出完全相同的两剑。想要完全复制我的剑痕，绝对不可能。"
                },
                {
                    "id": "30110310",
                    "speaker": "派蒙",
                    "text": "不可能吗？如果是用什么精细的仪器一点点「雕刻」呢？"
                },
                {
                    "id": "30110311",
                    "speaker": "迪希雅",
                    "text": "常有人说，留影机的画片永远不能替代画家画出来的风景画，因为前者是没有灵魂的。"
                },
                {
                    "id": "30110312",
                    "speaker": "迪希雅",
                    "text": "对我也一样，雕刻出的剑痕和作为武艺修炼结晶的剑痕…我一眼就能分辨得出。",
                    "choices": [
                        {
                            "id": "30110313",
                            "text": "…也有道理。",
                            "response": [
                                {
                                    "id": "30110315",
                                    "speaker": "迪希雅",
                                    "text": "呼…这回应该没什么疑问了吧？欸，这是不是最近学者之间流行的叫做「头脑急转弯」的游戏？想不到还挺有趣的。"
                                },
                                {
                                    "id": "30110316",
                                    "speaker": "迪希雅",
                                    "text": "那就这样吧，我看时候也不早了，我护送迪娜泽黛小姐去妮露那边了，回见。"
                                },
                                {
                                    "id": "30110317",
                                    "speaker": "派蒙",
                                    "text": "唉…又是一条走不通的路，「记忆删除」理论也是错误的吗？"
                                },
                                {
                                    "id": "30110318",
                                    "speaker": "派蒙",
                                    "text": "但至少我们也有了一些阶段性的结论吧？",
                                    "choices": [
                                        {
                                            "id": "30110319",
                                            "text": "时间并未循环。",
                                            "response": [
                                                {
                                                    "id": "30110321",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，的确如此，那现在我们还能找到一些新的思路吗？",
                                                    "choices": [
                                                        {
                                                            "id": "30110322",
                                                            "text": "让我想想…",
                                                            "response": [
                                                                {
                                                                    "id": "30110324",
                                                                    "speaker": "派蒙",
                                                                    "text": "蹊跷？我觉得最近全是很蹊跷的事…"
                                                                },
                                                                {
                                                                    "id": "30110325",
                                                                    "speaker": "Player",
                                                                    "text": "我们…为何从没考虑过出城？"
                                                                },
                                                                {
                                                                    "id": "30110326",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸…？出城…对哦！这么容易想到的尝试，我们居然没试过。看看城外的时间是不是还卡在同一天，就能确定很多事。"
                                                                },
                                                                {
                                                                    "id": "30110327",
                                                                    "speaker": "派蒙",
                                                                    "text": "真是不可思议，是我们之前太钻牛角尖了呢，还是累得晕头转向了才想不到的…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "30110328",
                                                                            "text": "这真的很奇怪。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "30110330",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "要不我们还是回去问问纳西妲吧，关于出城的事，莫非是我们忘记了什么。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "30110329",
                                                                            "text": "总觉得应该很早就想到了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "30110323",
                                                            "text": "我忽然感觉有件事很蹊跷…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30110320",
                                            "text": "我们不在现实。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30110314",
                            "text": "看来只能放弃这种可能性了吗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "301104",
            "objective": "与纳西妲对话",
            "dialogues": [
                {
                    "id": "30110401",
                    "speaker": "派蒙",
                    "text": "纳西妲，我们回来了。"
                },
                {
                    "id": "30110402",
                    "speaker": "纳西妲",
                    "text": "今天回来得很早呢，莫非是有了什么新的收获。"
                },
                {
                    "id": "30110403",
                    "speaker": "派蒙",
                    "text": "算是有吧，我们基本确定了时间并未循环，这里也应该不是现实…可同时我们又有了新的疑惑…",
                    "choices": [
                        {
                            "id": "30110404",
                            "text": "出城的话会怎么样？",
                            "response": [
                                {
                                    "id": "30110406",
                                    "speaker": "纳西妲",
                                    "text": "出城…在我印象里，有两次你们都提及过出城相关的计划…"
                                },
                                {
                                    "id": "30110407",
                                    "speaker": "Player",
                                    "text": "！？"
                                },
                                {
                                    "id": "30110408",
                                    "speaker": "派蒙",
                                    "text": "我们说过吗！我们怎么完全没有印象了，后来呢？我们回来之后怎么说？"
                                },
                                {
                                    "id": "30110409",
                                    "speaker": "纳西妲",
                                    "text": "让我想想…好像你们从未提起过出城计划的结果如何，哦，不如说，那两次出城计划的当晚你们都没有回来。"
                                },
                                {
                                    "id": "30110410",
                                    "speaker": "纳西妲",
                                    "text": "不过平时你们也有不少个晚上「夜不归宿」的，所以我当时也不觉得这能证明什么。"
                                },
                                {
                                    "id": "30110411",
                                    "speaker": "派蒙",
                                    "text": "确实有的时候会调查事情忘了时间，直接就到了第二天。可是你所说的出城当天的记忆，我们两个却都没有。"
                                },
                                {
                                    "id": "30110412",
                                    "speaker": "纳西妲",
                                    "text": "这样吗，这倒有些奇怪。理论上应该已经唤起了你们全部的记忆才对。",
                                    "choices": [
                                        {
                                            "id": "30110413",
                                            "text": "明天再试一次吧。",
                                            "response": [
                                                {
                                                    "id": "30110415",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！绝对有猫腻，明天一定要想办法查清楚！"
                                                },
                                                {
                                                    "id": "30110416",
                                                    "speaker": "？？？",
                                                    "text": "「嘀——」"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30110414",
                                            "text": "或许突破口就在这里。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30110405",
                            "text": "我们是不是真的没试过出城？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "301105",
            "objective": "(test)【隐藏】第4天隐藏控制出圈$HIDDEN",
            "dialogues": []
        },
