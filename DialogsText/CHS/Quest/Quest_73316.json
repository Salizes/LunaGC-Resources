    "talks": [
        {
            "id": "7331601",
            "objective": "(test)获得斯露莎小道具后才能接取任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7331602",
            "objective": "(test)到达精灵冢附近$HIDDEN",
            "dialogues": [
                {
                    "id": "733160201",
                    "speaker": "斯露莎",
                    "text": "没想到竟然变成这副模样了…还真是可怜。"
                },
                {
                    "id": "733160202",
                    "speaker": "派蒙",
                    "text": "咦，斯露莎在说什么呢？"
                },
                {
                    "id": "733160203",
                    "speaker": "斯露莎",
                    "text": "没什么，不过是看到了一些同族终末的丑态罢了，不用在意。"
                },
                {
                    "id": "733160204",
                    "speaker": "派蒙",
                    "text": "唔，这种说法反而更让人在意了吧！"
                },
                {
                    "id": "733160205",
                    "speaker": "派蒙",
                    "text": "让我看看…哦哦，那边有棵好奇怪的树呢，团成一圈感觉就像是个门一样。",
                    "choices": [
                        {
                            "id": "733160206",
                            "text": "要是穿过去的话…",
                            "response": [
                                {
                                    "id": "733160208",
                                    "speaker": "派蒙",
                                    "text": "这样一说，有点跃跃欲试起来了！"
                                },
                                {
                                    "id": "733160209",
                                    "speaker": "斯露莎",
                                    "text": "…这些「灵谷木」可不是什么门扉，若是冒冒失失地穿过去的话，可是会打扰到寄宿在其中的残灵的。"
                                },
                                {
                                    "id": "733160210",
                                    "speaker": "派蒙",
                                    "text": "哦哦，原来是叫「灵谷木」吗？不过你说残灵…明明什么都看不到嘛！"
                                },
                                {
                                    "id": "733160211",
                                    "speaker": "斯露莎",
                                    "text": "白飘飘当然看不到，毕竟这些残灵还停留在过去的执念当中。"
                                },
                                {
                                    "id": "733160212",
                                    "speaker": "斯露莎",
                                    "text": "虽说未必是其本心所愿，不过这般执着于世的样子，实在是目不忍视。"
                                },
                                {
                                    "id": "733160213",
                                    "speaker": "派蒙",
                                    "text": "明明看上去还很茂盛，感觉很亲切呢！"
                                },
                                {
                                    "id": "733160214",
                                    "speaker": "斯露莎",
                                    "text": "哼，白飘飘知道什么，这些「灵谷木」乃是那些与侵害大地的污秽战斗到最后一刻的花灵，用尽最后的力量所化而成的。"
                                },
                                {
                                    "id": "733160215",
                                    "speaker": "斯露莎",
                                    "text": "耗尽了力量而无法维持形体，又因为沾染了污秽而被花海所拒绝。"
                                },
                                {
                                    "id": "733160216",
                                    "speaker": "斯露莎",
                                    "text": "传说在古时矫论团会为她们举行净罪的仪式，使她们得以重回「甘露花海」。"
                                },
                                {
                                    "id": "733160217",
                                    "speaker": "斯露莎",
                                    "text": "不过如今矫论团早已无人能够主持这样的仪式，至多只能勉力维持这些「灵谷木」不至于枯死罢了。"
                                },
                                {
                                    "id": "733160218",
                                    "speaker": "斯露莎",
                                    "text": "但这也不过是延长了她们的痛苦，看她们如今的样子，估计除了需要独自忍受的苦痛追忆外，早已什么都不剩了吧。",
                                    "choices": [
                                        {
                                            "id": "733160219",
                                            "text": "看来应该帮帮她们。",
                                            "response": [
                                                {
                                                    "id": "733160221",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，什么独自受苦，听上去也太可怜了！"
                                                },
                                                {
                                                    "id": "733160222",
                                                    "speaker": "斯露莎",
                                                    "text": "虽说是这样，不过这也算是吾辈花灵的命运，说不定用这种方式守护大地也正是她们的愿望呢。"
                                                },
                                                {
                                                    "id": "733160223",
                                                    "speaker": "派蒙",
                                                    "text": "唔，虽然斯露莎是这样想的啦，不过说不定她们会有不同的想法呢！"
                                                },
                                                {
                                                    "id": "733160224",
                                                    "speaker": "派蒙",
                                                    "text": "毕竟如果是我的话，比起待在这种地方，还是更想回到花海和大家待在一起…"
                                                },
                                                {
                                                    "id": "733160225",
                                                    "speaker": "斯露莎",
                                                    "text": "白飘飘还真是看轻我们花灵了啊！"
                                                },
                                                {
                                                    "id": "733160226",
                                                    "speaker": "斯露莎",
                                                    "text": "哼，也罢，就姑且以吾之力量将其唤醒，让你们听听她的终末之声好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733160220",
                                            "text": "这样说就是有解救的方法…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733160207",
                            "text": "说不定会通往何处。"
                        }
                    ]
                }
            ]
        },
