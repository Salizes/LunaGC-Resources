        {
            "id": "100012",
            "objective": "（test）潜行成功——公子cutscene（隐）$HIDDEN",
            "dialogues": [
                {
                    "id": "10001201",
                    "speaker": "(test)玉京台 潜入AI1",
                    "text": "哪里逃！"
                }
            ]
        },
        {
            "id": "100013",
            "objective": "与陌生男子对话",
            "dialogues": [
                {
                    "id": "10001301",
                    "speaker": "派蒙",
                    "text": "呼…呼…跑得好累…",
                    "choices": [
                        {
                            "id": "10001302",
                            "text": "好像还是我比较累。",
                            "response": [
                                {
                                    "id": "10001304",
                                    "speaker": "派蒙",
                                    "text": "缺乏同情心！我的幻肢明明就跑得很累——啊！对了！"
                                },
                                {
                                    "id": "10001305",
                                    "speaker": "派蒙",
                                    "text": "这位小哥，你是谁啊？"
                                },
                                {
                                    "id": "10001306",
                                    "speaker": "？？？",
                                    "text": "你们可以叫我「公子」喔。"
                                },
                                {
                                    "id": "10001307",
                                    "speaker": "派蒙",
                                    "text": "哇…性格好糟糕，救过我们一次就把我们当仆人？"
                                },
                                {
                                    "id": "10001308",
                                    "speaker": "「公子」",
                                    "text": "哈哈，我没有那个意思。「名字」这种东西啊，只是代号而已。就好像…"
                                },
                                {
                                    "id": "10001309",
                                    "speaker": "「公子」",
                                    "text": "你们，应该在蒙德见过「女士」吧？"
                                },
                                {
                                    "id": "10001310",
                                    "speaker": "派蒙",
                                    "text": "「女士」…「公子」…"
                                },
                                {
                                    "id": "10001311",
                                    "speaker": "派蒙",
                                    "text": "你是「愚人众」的执行官？！"
                                },
                                {
                                    "id": "10001312",
                                    "speaker": "「公子」",
                                    "text": "啊，不要紧张。我不是来找你们打架的。"
                                },
                                {
                                    "id": "10001313",
                                    "speaker": "「公子」",
                                    "text": "「女士」给你们留下了很不好的印象吧？唉，那个女人…我也不喜欢她。"
                                },
                                {
                                    "id": "10001314",
                                    "speaker": "「公子」",
                                    "text": "好了，我们大家就先忘记那个女人的所作所为吧！我是来帮助你们的。",
                                    "choices": [
                                        {
                                            "id": "10001315",
                                            "text": "帮助？",
                                            "response": [
                                                {
                                                    "id": "10001316",
                                                    "speaker": "「公子」",
                                                    "text": "对啊，帮助。"
                                                },
                                                {
                                                    "id": "10001321",
                                                    "speaker": "「公子」",
                                                    "text": "我不是坏人…呃，我大概是坏人吧，但我不是来找你们麻烦的。"
                                                },
                                                {
                                                    "id": "10001322",
                                                    "speaker": "「公子」",
                                                    "text": "可不可以拜托你先别想着「立刻把这个人打倒」呢？"
                                                },
                                                {
                                                    "id": "10001323",
                                                    "speaker": "「公子」",
                                                    "text": "#哈哈，感谢你的风度，{NICKNAME}骑士。"
                                                },
                                                {
                                                    "id": "10001324",
                                                    "speaker": "「公子」",
                                                    "text": "我听说过你在蒙德的事迹，所以在刚才的仪式上稍微关注了你一下。"
                                                },
                                                {
                                                    "id": "10001325",
                                                    "speaker": "「公子」",
                                                    "text": "——正因如此，我知道你没做过什么可疑行为，想必暗害神明者另有其人。"
                                                },
                                                {
                                                    "id": "10001326",
                                                    "speaker": "「公子」",
                                                    "text": "但…可叹啊。愚人众身为至冬国使臣…在发生这种大事以后，一定无法得到信任吧。"
                                                },
                                                {
                                                    "id": "10001327",
                                                    "speaker": "「公子」",
                                                    "text": "统治璃月的七星，总是对我们抱有过多的怀疑…"
                                                },
                                                {
                                                    "id": "10001328",
                                                    "speaker": "派蒙",
                                                    "text": "我觉得这应该是愚人众的错。"
                                                },
                                                {
                                                    "id": "10001329",
                                                    "speaker": "「公子」",
                                                    "text": "哈哈哈哈！我该否认吗？"
                                                },
                                                {
                                                    "id": "10001330",
                                                    "speaker": "「公子」",
                                                    "text": "算了，陌生人之间保持距离也是好事，反正我也已经很习惯这种戒备的眼神了。"
                                                },
                                                {
                                                    "id": "10001331",
                                                    "speaker": "「公子」",
                                                    "text": "但现在，若要洗清「刺客」的嫌疑——就请你们移步「北国银行」吧。"
                                                },
                                                {
                                                    "id": "10001332",
                                                    "speaker": "「公子」",
                                                    "text": "我们不能继续在此停留了。须知璃月古谚：「隔墙有耳」。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10001317",
                                            "text": "我不需要愚人众的帮助。",
                                            "response": [
                                                {
                                                    "id": "10001318",
                                                    "speaker": "「公子」",
                                                    "text": "别那么冷淡嘛。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10001319",
                                            "text": "去，去。",
                                            "response": [
                                                {
                                                    "id": "10001320",
                                                    "speaker": "「公子」",
                                                    "text": "喂，我好歹也是「愚人众」的执行官，别这么不给面子吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10001303",
                            "text": "魔法飞行用到的是哪块肌肉啊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100014",
            "objective": "在北国银行与「公子」对话",
            "dialogues": [
                {
                    "id": "10001401",
                    "speaker": "派蒙",
                    "text": "北国银行…"
                },
                {
                    "id": "10001402",
                    "speaker": "「公子」",
                    "text": "没错，这里就是至冬国在璃月开设的银行。"
                },
                {
                    "id": "10001403",
                    "speaker": "「公子」",
                    "text": "虽然璃月是提瓦特最重要的商业中心，但我们国家也是很有钱的。"
                },
                {
                    "id": "10001404",
                    "speaker": "派蒙",
                    "text": "是哦，穷国也养不起那种对西风骑士团蹬鼻子上脸的外交官呢。"
                },
                {
                    "id": "10001405",
                    "speaker": "「公子」",
                    "text": "呵呵呵。"
                },
                {
                    "id": "10001406",
                    "speaker": "「公子」",
                    "text": "来，给你这个。"
                },
                {
                    "id": "10001407",
                    "speaker": "派蒙",
                    "text": "这是…"
                },
                {
                    "id": "10001408",
                    "speaker": "「公子」",
                    "text": "谁知道呢？有时候用钱只能买到「东西」，却买不到「名字」。"
                },
                {
                    "id": "10001409",
                    "speaker": "「公子」",
                    "text": "简单来说，这东西是一种信物。让「三眼五显仙人」不会伤害你的信物。"
                },
                {
                    "id": "10001410",
                    "speaker": "派蒙",
                    "text": "你说…仙人？"
                },
                {
                    "id": "10001411",
                    "speaker": "「公子」",
                    "text": "出城向北，在归离原之西，有一座石林，它的名字是「绝云间」。"
                },
                {
                    "id": "10001412",
                    "speaker": "「公子」",
                    "text": "璃月人相信，那是仙人洞府所在。",
                    "choices": [
                        {
                            "id": "10001413",
                            "text": "你说「相信」…",
                            "response": [
                                {
                                    "id": "10001415",
                                    "speaker": "「公子」",
                                    "text": "没错，他们相信传说，所以只在绝云间的外围供奉仙人，不敢继续深入。"
                                },
                                {
                                    "id": "10001416",
                                    "speaker": "「公子」",
                                    "text": "但我不需要「相信」——因为我「知道」，绝云间的仙人是真实存在的。"
                                },
                                {
                                    "id": "10001417",
                                    "speaker": "派蒙",
                                    "text": "看来愚人众的情报网很有用呢…但，你要我们去找仙人做什么呢？"
                                },
                                {
                                    "id": "10001418",
                                    "speaker": "「公子」",
                                    "text": "嘿，小家伙，你觉得世人求仙，能有多少理由呢？"
                                },
                                {
                                    "id": "10001419",
                                    "speaker": "「公子」",
                                    "text": "无非有人求财，有人求医，有人求姻缘…而你们就是为了——求个公道。"
                                },
                                {
                                    "id": "10001420",
                                    "speaker": "派蒙",
                                    "text": "公道？"
                                },
                                {
                                    "id": "10001421",
                                    "speaker": "「公子」",
                                    "text": "七星派出千岩军，要在观礼人士里寻找刺客。"
                                },
                                {
                                    "id": "10001422",
                                    "speaker": "「公子」",
                                    "text": "但凡人能够刺杀那位横扫千军的武神吗？岩王帝君可没有抛弃过自己的神力。"
                                },
                                {
                                    "id": "10001423",
                                    "speaker": "「公子」",
                                    "text": "这种粗糙的应对，可不符合他们应有的水准。令人怀疑…",
                                    "choices": [
                                        {
                                            "id": "10001424",
                                            "text": "是为了掩盖真正的凶手？",
                                            "response": [
                                                {
                                                    "id": "10001425",
                                                    "speaker": "「公子」",
                                                    "text": "或者…是为了掩盖别的什么东西。我也说不准。"
                                                },
                                                {
                                                    "id": "10001428",
                                                    "speaker": "「公子」",
                                                    "text": "现在，北国银行也不可能无限期地拖延千岩军的搜查，但仙人百无禁忌。"
                                                },
                                                {
                                                    "id": "10001429",
                                                    "speaker": "「公子」",
                                                    "text": "璃月就是岩神与仙人一同建立的——当然，是用武力建立的。"
                                                },
                                                {
                                                    "id": "10001430",
                                                    "speaker": "「公子」",
                                                    "text": "去找他们吧，要比七星的信使更快一步，把未经扭曲的信息带给他们。"
                                                },
                                                {
                                                    "id": "10001431",
                                                    "speaker": "「公子」",
                                                    "text": "如果说现在的璃月还有谁帮得上你的话…那就只能是绝云间的「三眼五显仙人」们了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10001426",
                                            "text": "七星才是真凶，想嫁祸给别人？",
                                            "response": [
                                                {
                                                    "id": "10001427",
                                                    "speaker": "「公子」",
                                                    "text": "你的想法比我更激进呢，荣誉骑士。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10001414",
                            "text": "只是传说而已吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10010101",
                    "speaker": "天权幕僚",
                    "text": "止步！七星请仙，无关人等暂请回避，不可向前！"
                },
                {
                    "id": "10010102",
                    "speaker": "派蒙",
                    "text": "嘁…小气…"
                },
                {
                    "id": "10010103",
                    "speaker": "千岩军士兵",
                    "text": "止步！七星请仙，无关人等暂请回避，不可向前！"
                },
                {
                    "id": "10010104",
                    "speaker": "派蒙",
                    "text": "嘁…小气…"
                }
            ]
        }
    ]
}