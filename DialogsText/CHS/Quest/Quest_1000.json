        {
            "id": "100021",
            "objective": "在玉京台进香许愿",
            "dialogues": [
                {
                    "id": "10002101",
                    "speaker": "长顺",
                    "text": "哦，你也是想来沾点「仙气」的吗？"
                },
                {
                    "id": "10002102",
                    "speaker": "长顺",
                    "text": "#哈哈，你很懂嘛，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_GIRLB]}！在这个日子许愿的话，帝君和仙人们都会保佑你的。"
                },
                {
                    "id": "10002103",
                    "speaker": "长顺",
                    "text": "我已经许完愿了，这里让给你。"
                },
                {
                    "id": "10002104",
                    "speaker": "派蒙",
                    "text": "谢谢！"
                },
                {
                    "id": "10002105",
                    "speaker": "Player",
                    "text": "#希望早点找到{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                }
            ]
        },
        {
            "id": "100022",
            "objective": "在玉京台进香许愿",
            "dialogues": [
                {
                    "id": "10002201",
                    "speaker": "伊凡诺维奇",
                    "text": "你们是第一次来璃月吗？其实我也是第一次来看「七星请仙典仪」。"
                },
                {
                    "id": "10002202",
                    "speaker": "伊凡诺维奇",
                    "text": "看！那位就是「璃月七星」中的「天权星」，凝光大人。"
                },
                {
                    "id": "10002203",
                    "speaker": "伊凡诺维奇",
                    "text": "只有那些掌控璃月的大人物，才有资格主持「请仙典仪」。"
                },
                {
                    "id": "10002204",
                    "speaker": "伊凡诺维奇",
                    "text": "对了，你知道吗？璃月的仙人们，大多都是兽形。"
                },
                {
                    "id": "10002205",
                    "speaker": "伊凡诺维奇",
                    "text": "听说连岩王帝君自己，在这种正式场合，也会以半麟半龙的仙体示人…"
                },
                {
                    "id": "10002206",
                    "speaker": "伊凡诺维奇",
                    "text": "…啊，不打扰你许愿了，来，这里让给你。"
                },
                {
                    "id": "10002207",
                    "speaker": "Player",
                    "text": "希望能从岩神那里得到线索…"
                }
            ]
        },
