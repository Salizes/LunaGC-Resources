        {
            "id": "100000",
            "objective": "前往璃月港",
            "dialogues": [
                {
                    "id": "10000001",
                    "speaker": "琳琅",
                    "text": "古董行还没开门…"
                }
            ]
        },
        {
            "id": "100001",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "10000101",
                    "speaker": "派蒙",
                    "text": "要寻找岩神的话，一年里只有这一次机会。"
                },
                {
                    "id": "10000102",
                    "speaker": "派蒙",
                    "text": "多亏之前温迪提醒，否则我们一定会错过今年的「七星请仙典仪」吧。",
                    "choices": [
                        {
                            "id": "10000103",
                            "text": "派蒙知道具体时间吗？",
                            "response": [
                                {
                                    "id": "10000104",
                                    "speaker": "派蒙",
                                    "text": "唔…说不定是今天，也说不定是明天的样子…"
                                },
                                {
                                    "id": "10000107",
                                    "speaker": "派蒙",
                                    "text": "既然来了璃月，还是去问问当地人吧。"
                                },
                                {
                                    "id": "10000108",
                                    "speaker": "派蒙",
                                    "text": "啊，对了。关于岩神「摩拉克斯」…"
                                },
                                {
                                    "id": "10000109",
                                    "speaker": "派蒙",
                                    "text": "你知道吗？我们用的「摩拉」就是以这位神灵命名的。"
                                },
                                {
                                    "id": "10000110",
                                    "speaker": "派蒙",
                                    "text": "但我们这些外国人如果在璃月这样称呼岩神，就会降级成「无礼的外国人」。"
                                },
                                {
                                    "id": "10000111",
                                    "speaker": "派蒙",
                                    "text": "所以，还是和璃月人一样，多用用「岩王帝君」这个名字比较好。"
                                }
                            ]
                        },
                        {
                            "id": "10000105",
                            "text": "派蒙知道具体地点吗？",
                            "response": [
                                {
                                    "id": "10000106",
                                    "speaker": "派蒙",
                                    "text": "既然时间都是温迪提醒的，我当然也…不知道地点啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "100002",
            "objective": "与市民交谈",
            "dialogues": [
                {
                    "id": "10000201",
                    "speaker": "观海",
                    "text": "哦！你们也是想看「七星请仙典仪」的外国人吗。"
                },
                {
                    "id": "10000202",
                    "speaker": "观海",
                    "text": "真有行动力啊…说起来我在璃月生活几十年，好像还没去围观过一次呢。"
                },
                {
                    "id": "10000203",
                    "speaker": "观海",
                    "text": "这就是所谓「本地人不会去的景点」吧…"
                },
                {
                    "id": "10000204",
                    "speaker": "观海",
                    "text": "不过，希望你们的行程愉快！璃月欢迎你们！"
                }
            ]
        },
        {
            "id": "100003",
            "objective": "与市民交谈",
            "dialogues": [
                {
                    "id": "10000301",
                    "speaker": "琳琅",
                    "text": "「七星请仙典仪」啊…确实，你们提醒我了，不就在今天么？"
                },
                {
                    "id": "10000302",
                    "speaker": "琳琅",
                    "text": "岩王帝君每年都会赐下神谕，指引这一年里经营璃月的方向。"
                },
                {
                    "id": "10000303",
                    "speaker": "琳琅",
                    "text": "去年恭请神谕的是「璃月七星」的「玉衡星」…",
                    "choices": [
                        {
                            "id": "10000304",
                            "text": "「璃月七星」？",
                            "response": [
                                {
                                    "id": "10000306",
                                    "speaker": "派蒙",
                                    "text": "哼哼，这个我知道！"
                                },
                                {
                                    "id": "10000307",
                                    "speaker": "派蒙",
                                    "text": "就好像蒙德是「自由」的城邦一样，璃月是「契约」的国度，崇尚商业和贸易。"
                                },
                                {
                                    "id": "10000308",
                                    "speaker": "派蒙",
                                    "text": "代表七种商业势力的七位大商人，「璃月七星」，就是这个国家实际的掌控者啦。"
                                },
                                {
                                    "id": "10000309",
                                    "speaker": "琳琅",
                                    "text": "哎呀，外国人总是这么说。"
                                },
                                {
                                    "id": "10000310",
                                    "speaker": "琳琅",
                                    "text": "但我们璃月真正的掌控者，永远都是岩王帝君啊。"
                                },
                                {
                                    "id": "10000311",
                                    "speaker": "琳琅",
                                    "text": "七星是人，帝君是神。「自由」之神不在蒙德，而我们的神永存永在。"
                                },
                                {
                                    "id": "10000312",
                                    "speaker": "琳琅",
                                    "text": "口说无凭，你们自己多在璃月港感受一下，就能明白…"
                                },
                                {
                                    "id": "10000313",
                                    "speaker": "琳琅",
                                    "text": "既然刚离开「神不在的城邦」，那就是时候体验我们的——「与神同行的历史」了。"
                                }
                            ]
                        },
                        {
                            "id": "10000305",
                            "text": "「玉衡星」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100004",
            "objective": "与市民交谈",
            "dialogues": [
                {
                    "id": "10000401",
                    "speaker": "博来",
                    "text": "你们也想瞻仰「七星请仙典仪」吗？我也想啊！大家都想！"
                },
                {
                    "id": "10000402",
                    "speaker": "博来",
                    "text": "身为经商之人，怎能不关注璃月最重要的商业动态！"
                },
                {
                    "id": "10000403",
                    "speaker": "博来",
                    "text": "去年的一十七条神谕，就造成了不小的市场震荡。"
                },
                {
                    "id": "10000404",
                    "speaker": "博来",
                    "text": "而且今年以来一直有风声，说「天权星」凝光大人暗中有所动作…"
                },
                {
                    "id": "10000405",
                    "speaker": "博来",
                    "text": "她想要把「神之眼」使用者靠元素力创造的岩石，在税务定义上排除出矿物范围。"
                },
                {
                    "id": "10000406",
                    "speaker": "派蒙",
                    "text": "这…真是非常专业的法律领域呢。"
                },
                {
                    "id": "10000407",
                    "speaker": "博来",
                    "text": "哈哈，时刻关注神谕与市场的人们，也是这座商港的魅力之一啊。"
                },
                {
                    "id": "10000408",
                    "speaker": "博来",
                    "text": "岩王帝君他老人家，是七神中最古老的神灵。"
                },
                {
                    "id": "10000409",
                    "speaker": "博来",
                    "text": "他老人家的战略目光，我们一向都是十分信任的。"
                },
                {
                    "id": "10000410",
                    "speaker": "博来",
                    "text": "第一时间了解今年的神谕，说不定就能快人一步，抢占发财的先机！"
                }
            ]
        },
