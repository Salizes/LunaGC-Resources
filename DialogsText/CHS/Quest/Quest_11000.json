    "talks": [
        {
            "id": "1100001",
            "objective": "接近林中的少女",
            "dialogues": [
                {
                    "id": "110000101",
                    "speaker": "派蒙",
                    "text": "你看，那边好像有个女孩子。"
                }
            ]
        },
        {
            "id": "1100002",
            "objective": "接近林中的少女（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1100003",
            "objective": "与香菱交谈",
            "dialogues": [
                {
                    "id": "110000301",
                    "speaker": "？？？",
                    "text": "小声点，我正在打猎呢。"
                },
                {
                    "id": "110000302",
                    "speaker": "？？？",
                    "text": "早就听说蒙德有很多好食材，现在一看果然名不虚传！",
                    "choices": [
                        {
                            "id": "110000303",
                            "text": "你是猎人？",
                            "response": [
                                {
                                    "id": "110000305",
                                    "speaker": "？？？",
                                    "text": "不不不，我是个厨师，立志走遍各地，搜寻珍奇食材的厨师！"
                                },
                                {
                                    "id": "110000306",
                                    "speaker": "香菱",
                                    "text": "我叫香菱，从璃月港来，你们呢？"
                                },
                                {
                                    "id": "110000307",
                                    "speaker": "Player",
                                    "text": "#我叫{NICKNAME}。"
                                },
                                {
                                    "id": "110000308",
                                    "speaker": "派蒙",
                                    "text": "你好啊，我是派蒙。"
                                },
                                {
                                    "id": "110000309",
                                    "speaker": "香菱",
                                    "text": "派蒙！"
                                },
                                {
                                    "id": "110000310",
                                    "speaker": "派蒙",
                                    "text": "怎么了？为什么突然盯着我看？"
                                },
                                {
                                    "id": "110000311",
                                    "speaker": "香菱",
                                    "text": "好奇妙的生物，这个可以吃吗？",
                                    "choices": [
                                        {
                                            "id": "110000312",
                                            "text": "她是我的好朋友。",
                                            "response": [
                                                {
                                                    "id": "110000313",
                                                    "speaker": "香菱",
                                                    "text": "可惜了，朋友那就是不能吃的。"
                                                },
                                                {
                                                    "id": "110000316",
                                                    "speaker": "香菱",
                                                    "text": "你们的关系真好，其实我也有这样的好朋友，叫作锅巴。"
                                                },
                                                {
                                                    "id": "110000317",
                                                    "speaker": "派蒙",
                                                    "text": "名字怎么还是吃的啊！"
                                                },
                                                {
                                                    "id": "110000318",
                                                    "speaker": "香菱",
                                                    "text": "哈哈，因为很可爱啊。"
                                                },
                                                {
                                                    "id": "110000319",
                                                    "speaker": "香菱",
                                                    "text": "对了对了，你们可以帮我狩猎吗？"
                                                },
                                                {
                                                    "id": "110000320",
                                                    "speaker": "香菱",
                                                    "text": "这里有好多猎物，全都是绝佳的食材。"
                                                },
                                                {
                                                    "id": "110000321",
                                                    "speaker": "香菱",
                                                    "text": "我一个人实在是抓不过来，放走了又太可惜了！"
                                                },
                                                {
                                                    "id": "110000322",
                                                    "speaker": "派蒙",
                                                    "text": "听起来好麻烦…"
                                                },
                                                {
                                                    "id": "110000323",
                                                    "speaker": "香菱",
                                                    "text": "别这么说嘛，等下送给你们好吃的！"
                                                },
                                                {
                                                    "id": "110000324",
                                                    "speaker": "派蒙",
                                                    "text": "#好、好吃的？一言为定，{NICKNAME}可擅长这个了！",
                                                    "choices": [
                                                        {
                                                            "id": "110000325",
                                                            "text": "一点立场都没有啊…",
                                                            "response": [
                                                                {
                                                                    "id": "110000327",
                                                                    "speaker": "香菱",
                                                                    "text": "嘿嘿，别在意别在意，你的朋友都已经答应了。"
                                                                },
                                                                {
                                                                    "id": "110000328",
                                                                    "speaker": "香菱",
                                                                    "text": "不管用什么方法，只要能带回来兽肉就好。"
                                                                },
                                                                {
                                                                    "id": "110000329",
                                                                    "speaker": "香菱",
                                                                    "text": "那就交给你们了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000326",
                                                            "text": "别无视我的意见啊。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000314",
                                            "text": "当然可以。",
                                            "response": [
                                                {
                                                    "id": "110000315",
                                                    "speaker": "派蒙",
                                                    "text": "不可以！派蒙不是吃的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000304",
                            "text": "你是冒险家？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100004",
            "objective": "帮助香菱收集兽肉",
            "dialogues": [
                {
                    "id": "110000401",
                    "speaker": "香菱",
                    "text": "这里的野猪太肥美了，还很有活力，肉质一定是极棒的。"
                },
                {
                    "id": "110000402",
                    "speaker": "香菱",
                    "text": "啊，说着说着肚子就饿了…"
                }
            ]
        },
        {
            "id": "1100005",
            "objective": "将三块兽肉交给香菱",
            "dialogues": [
                {
                    "id": "110000501",
                    "speaker": "香菱",
                    "text": "哇，有这么多，一部分用来煎，一部分配上蘑菇炒，还有些和史莱姆凝液试试看…",
                    "choices": [
                        {
                            "id": "110000502",
                            "text": "她瞬间就入迷了…",
                            "response": [
                                {
                                    "id": "110000503",
                                    "speaker": "派蒙",
                                    "text": "我们很自然地被忽略了…"
                                },
                                {
                                    "id": "110000506",
                                    "speaker": "香菱",
                                    "text": "啊啊，不好意思不好意思，一不小心就去想菜谱了。"
                                },
                                {
                                    "id": "110000507",
                                    "speaker": "香菱",
                                    "text": "这个是答应送你们的好吃的。现在就尝尝看吧！把感想告诉我！"
                                },
                                {
                                    "id": "110000508",
                                    "speaker": "派蒙",
                                    "text": "我们是被当成试菜员了吗？"
                                },
                                {
                                    "id": "110000509",
                                    "speaker": "派蒙",
                                    "text": "哦哦！这、这个…太好吃了！"
                                },
                                {
                                    "id": "110000510",
                                    "speaker": "派蒙",
                                    "text": "可以告诉我们是怎么做的吗！"
                                },
                                {
                                    "id": "110000511",
                                    "speaker": "香菱",
                                    "text": "嘿嘿，当然可以了！只不过我还没有写成菜谱，我想想看…"
                                },
                                {
                                    "id": "110000512",
                                    "speaker": "香菱",
                                    "text": "要不然这样吧！我现在再做一次，你们就照着学！看一遍肯定就明白了吧！"
                                },
                                {
                                    "id": "110000513",
                                    "speaker": "派蒙",
                                    "text": "这么复杂的菜看一次也记不住啦…而且锅和调味料都没有。"
                                },
                                {
                                    "id": "110000514",
                                    "speaker": "香菱",
                                    "text": "哎呀，这还不简单。"
                                },
                                {
                                    "id": "110000515",
                                    "speaker": "香菱",
                                    "text": "锅用岩板，油用刚刚猎到的野猪的油，搬石头堆成灶，木头和茅草生旺火。"
                                },
                                {
                                    "id": "110000516",
                                    "speaker": "香菱",
                                    "text": "糖用甜甜花，至于盐，我之前在一个洞穴里找到了很多崖盐，够用好几天的。",
                                    "choices": [
                                        {
                                            "id": "110000517",
                                            "text": "这、这也太轻车熟路了…",
                                            "response": [
                                                {
                                                    "id": "110000519",
                                                    "speaker": "香菱",
                                                    "text": "嘿嘿，我总按捺不住尝试新菜的心情。但又不能每次出门都带好锅碗瓢盆什么的。"
                                                },
                                                {
                                                    "id": "110000520",
                                                    "speaker": "香菱",
                                                    "text": "稍等下，我现在就去准备。"
                                                },
                                                {
                                                    "id": "110000521",
                                                    "speaker": "艾伦",
                                                    "text": "喂！你们在这里干什么啊！"
                                                },
                                                {
                                                    "id": "110000601",
                                                    "speaker": "艾伦",
                                                    "text": "这里是野猪们的栖息地，是不可以打猎的！把它们都吓跑了怎么办？"
                                                },
                                                {
                                                    "id": "110000602",
                                                    "speaker": "艾伦",
                                                    "text": "我们猎人不做杀鸡取卵的事。"
                                                },
                                                {
                                                    "id": "110000603",
                                                    "speaker": "香菱",
                                                    "text": "啊！我懂我懂！"
                                                },
                                                {
                                                    "id": "110000604",
                                                    "speaker": "香菱",
                                                    "text": "只有最合适的环境才能诞生这么鲜美的肉质！如果被吓跑的话…"
                                                },
                                                {
                                                    "id": "110000605",
                                                    "speaker": "香菱",
                                                    "text": "不行不行，那绝对是美食界…不对，是全人类的一大损失！",
                                                    "choices": [
                                                        {
                                                            "id": "110000606",
                                                            "text": "真是有个性的理解方式。",
                                                            "response": [
                                                                {
                                                                    "id": "110000608",
                                                                    "speaker": "香菱",
                                                                    "text": "对不起，没想到会造成这么大的影响！"
                                                                },
                                                                {
                                                                    "id": "110000609",
                                                                    "speaker": "艾伦",
                                                                    "text": "唉，你们去和杜拉夫先生道个歉吧。"
                                                                },
                                                                {
                                                                    "id": "110000610",
                                                                    "speaker": "艾伦",
                                                                    "text": "他是我们这些猎人的领头人，他很看重狩猎的规矩，现在特别生气。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110000611",
                                                                            "text": "现在该怎么办？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110000613",
                                                                                    "speaker": "香菱",
                                                                                    "text": "我觉得应该去和他道歉的，毕竟做错了事嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "110000614",
                                                                                    "speaker": "Player",
                                                                                    "text": "让我们陪你一起去吧。"
                                                                                },
                                                                                {
                                                                                    "id": "110000615",
                                                                                    "speaker": "香菱",
                                                                                    "text": "嘿嘿，谢谢你们。那这件事结束之后我再做菜给你们吃！"
                                                                                },
                                                                                {
                                                                                    "id": "110000616",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好的，放心吧，就算你忘了我都会记住的。"
                                                                                },
                                                                                {
                                                                                    "id": "110000617",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那就出发吧，那位杜拉夫先生他应该就在清泉镇。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110000612",
                                                                            "text": "还是听这位猎人的吧。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000607",
                                                            "text": "其实完全没懂吧…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000518",
                                            "text": "听起来就很费事！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000504",
                            "text": "我想尝尝史莱姆凝液！",
                            "response": [
                                {
                                    "id": "110000505",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，{NICKNAME}你终于能理解我的喜好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}