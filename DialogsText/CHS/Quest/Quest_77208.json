    "talks": [
        {
            "id": "7720801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772080101",
                    "speaker": "？？？",
                    "text": "哎呀…那边的两位，不会也是来这个冰上钓点垂钓的吧？"
                },
                {
                    "id": "772080102",
                    "speaker": "？？？",
                    "text": "不过你们可要白跑一趟咯。"
                },
                {
                    "id": "772080103",
                    "speaker": "派蒙",
                    "text": "咦…你是谁，怎么有人在冰面上搭了个帐篷呀！"
                },
                {
                    "id": "772080104",
                    "speaker": "利诺夫",
                    "text": "我叫利诺夫…哈哈，还有什么事能让至冬人在冰面上搭帐篷的，当然是在冰面上钓鱼。"
                },
                {
                    "id": "772080105",
                    "speaker": "利诺夫",
                    "text": "唉，我听说这里有好的钓点，着急忙慌地请了假，租了帐篷，结果到这一看…"
                },
                {
                    "id": "772080106",
                    "speaker": "利诺夫",
                    "text": "哎呀，钓点被冰住了。那咋办，打道回府吧，结果拉雪橇的费尔金大爷还狠狠摔了一跤，这几天看来都没法干活了。"
                },
                {
                    "id": "772080107",
                    "speaker": "利诺夫",
                    "text": "呵呵…人要是倒霉起来啊，那喝凉水都能呛着。"
                },
                {
                    "id": "772080108",
                    "speaker": "Player",
                    "text": "这附近有钓点？"
                },
                {
                    "id": "772080109",
                    "speaker": "利诺夫",
                    "text": "是啊…喏，就在前面，旁边还不知道谁插了块牌子。"
                },
                {
                    "id": "772080110",
                    "speaker": "利诺夫",
                    "text": "唉，但凡我要带点什么凿子钻子，我就把上面结冰给它凿穿了…可惜，巧妇难为无米之炊啊…"
                }
            ]
        },
        {
            "id": "7720802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772080201",
                    "speaker": "利诺夫",
                    "text": "天哪，了不起的英雄。你们居然真的把钓点处理出来了！"
                },
                {
                    "id": "772080202",
                    "speaker": "利诺夫",
                    "text": "…呼，这我不得钓上几竿。"
                },
                {
                    "id": "772080203",
                    "speaker": "利诺夫",
                    "text": "好了，鱼竿鱼竿，我的鱼竿呢！"
                }
            ]
        },
        {
            "id": "7720803",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772080301",
                    "speaker": "利诺夫",
                    "text": "嗯…再等等…这里有口，一定能中！"
                }
            ]
        },
        {
            "id": "7720804",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7720804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772080401",
                    "speaker": "插在钓点边的木板",
                    "text": "（一块临时设立此处的木板，上面写着：）"
                },
                {
                    "id": "772080402",
                    "speaker": "插在钓点边的木板",
                    "text": "「钓点被冰封啦，这两天钓不了了。天气暖和点再来吧，倒霉蛋们！」"
                }
            ]
        },
        {
            "id": "7720805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772080501",
                    "speaker": "插在钓点边的木板",
                    "text": "（一块临时设立此处的木板，上面写着：）"
                },
                {
                    "id": "772080502",
                    "speaker": "插在钓点边的木板",
                    "text": "「钓点被冰封啦，这两天钓不了了。天气暖和点再来吧，倒霉蛋们！」"
                },
                {
                    "id": "772080503",
                    "speaker": "插在钓点边的木板",
                    "text": "（下面有人歪歪扭扭写着…）"
                },
                {
                    "id": "772080504",
                    "speaker": "插在钓点边的木板",
                    "text": "「就算没被冰封，倒霉的人还是钓不上鱼！」"
                }
            ]
        },
        {
            "id": "7720806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772080601",
                    "speaker": "利诺夫",
                    "text": "唉，不如天上掉下个陨石，把那钓点给砸出来算了？"
                },
                {
                    "id": "772080602",
                    "speaker": "利诺夫",
                    "text": "砸不穿钓点，砸我得了，免得我还得在这冰面上无所事事待上好几天，白白浪费了请的假期…"
                }
            ]
        },
        {
            "id": "7720810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772081002",
                    "speaker": "插在钓点边的木板",
                    "text": "(test)请游客不要站上钓鱼冰面以免发生冰面破碎"
                }
            ]
        }
    ]
}