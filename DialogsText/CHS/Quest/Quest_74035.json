    "talks": [
        {
            "id": "7403502",
            "objective": "等到第二天早上（8点~12点）",
            "dialogues": [
                {
                    "id": "740350201",
                    "speaker": "洛耶茨",
                    "text": "旅行者，真高兴您又来这里参观，来杯咖啡？",
                    "choices": [
                        {
                            "id": "740350202",
                            "text": "这么一说…",
                            "response": [
                                {
                                    "id": "740350204",
                                    "speaker": "派蒙",
                                    "text": "我之前也想问来着，但…但那些人说话好大声，完全不敢说别的话题…"
                                },
                                {
                                    "id": "740350243",
                                    "speaker": "Player",
                                    "text": "我还以为会被直接赶出去。"
                                },
                                {
                                    "id": "740350205",
                                    "speaker": "洛耶茨",
                                    "text": "为什么？哈哈哈，不需要担心，门卫都让您进来了，我们又为什么非得自作主张，把您赶出去呢。"
                                },
                                {
                                    "id": "740350206",
                                    "speaker": "瑟米安",
                                    "text": "这是权责分明的一种形式。你好旅行者，我是瑟米安，真是幸会。",
                                    "choices": [
                                        {
                                            "id": "740350207",
                                            "text": "您好。",
                                            "response": [
                                                {
                                                    "id": "740350209",
                                                    "speaker": "洛耶茨",
                                                    "text": "瑟米安先生之前供职于审判庭，做助理书记员。因为一些…乱七八糟的事而被调回了复律庭。"
                                                },
                                                {
                                                    "id": "740350210",
                                                    "speaker": "洛耶茨",
                                                    "text": "许多我们之前解决不了的问题，都被他用理性的精准思维找到了解决方法。"
                                                },
                                                {
                                                    "id": "740350211",
                                                    "speaker": "瑟米安",
                                                    "text": "这是过誉，我只不过是将之前的工作经验照搬了过来，用事物的价值计量与其有关的事务。"
                                                },
                                                {
                                                    "id": "740350212",
                                                    "speaker": "瑟米安",
                                                    "text": "虽然践行实务时会偶遇不可计量之物，但洛耶茨先生所精通之人情公理亦可为我所助。"
                                                },
                                                {
                                                    "id": "740350213",
                                                    "speaker": "Player",
                                                    "text": "你的意思是…"
                                                },
                                                {
                                                    "id": "740350214",
                                                    "speaker": "洛耶茨",
                                                    "text": "简单来说，在处理事务时，瑟米安先生十分擅长平衡各方的心态，让每个人都意识到自己很重要。就像是将一个秤配平。"
                                                },
                                                {
                                                    "id": "740350215",
                                                    "speaker": "洛耶茨",
                                                    "text": "如果实在配不平，那我也可以提供一些「言语的重量」。",
                                                    "choices": [
                                                        {
                                                            "id": "740350216",
                                                            "text": "艾尤恩好像很辛苦…",
                                                            "response": [
                                                                {
                                                                    "id": "740350218",
                                                                    "speaker": "派蒙",
                                                                    "text": "对呀，感觉他随时都可能昏倒。"
                                                                },
                                                                {
                                                                    "id": "740350219",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "这是每个人的必经之路，如果现在我去帮艾尤恩写完文件，那他就记不住这次的教训了。"
                                                                },
                                                                {
                                                                    "id": "740350220",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "他总是对复律庭抱有一些不切实际的幻想。但幻想只属于年轻人，不属于复律庭职员。"
                                                                },
                                                                {
                                                                    "id": "740350221",
                                                                    "speaker": "瑟米安",
                                                                    "text": "我只是不会写文件。"
                                                                },
                                                                {
                                                                    "id": "740350222",
                                                                    "speaker": "Player",
                                                                    "text": "您倒是非常直接…"
                                                                },
                                                                {
                                                                    "id": "740350223",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "好啦，您来这里到底是想要办什么事？和我说说看，看我能不能…"
                                                                },
                                                                {
                                                                    "id": "740350224",
                                                                    "speaker": "Black Screen",
                                                                    "text": "艾尤恩突然慌慌张张地跑了过来…"
                                                                },
                                                                {
                                                                    "id": "740350225",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "真是倒霉透了…洛耶茨先生，您有备用的打字机键帽吗？"
                                                                },
                                                                {
                                                                    "id": "740350226",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "我刚才打字的时候，突然发现有一个键帽不知道什么时候不见了…"
                                                                },
                                                                {
                                                                    "id": "740350227",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "你在周围找过吗？可能是就掉在地上了。"
                                                                },
                                                                {
                                                                    "id": "740350228",
                                                                    "speaker": "瑟米安",
                                                                    "text": "或者是夹在书里，被压在文件下面…这些地方你找过吗？"
                                                                },
                                                                {
                                                                    "id": "740350229",
                                                                    "speaker": "Player",
                                                                    "text": "还有笔筒和袖子里。"
                                                                },
                                                                {
                                                                    "id": "740350230",
                                                                    "speaker": "派蒙",
                                                                    "text": "还有头发和茶杯里！"
                                                                },
                                                                {
                                                                    "id": "740350231",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "都找过了，我连衣服兜和鞋底都找了个遍，根本就没有。"
                                                                },
                                                                {
                                                                    "id": "740350232",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "好吧，你得去问问柯妮莉娅小姐，如果这东西真的有「备用部件」的话，应该也是在她那里申请。"
                                                                },
                                                                {
                                                                    "id": "740350233",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "不然我自己去买一个得了，找伊丝黛莱订做个键帽，也花不了多少时间。"
                                                                },
                                                                {
                                                                    "id": "740350234",
                                                                    "speaker": "洛耶茨",
                                                                    "text": "我的艾尤恩，你为什么非得自己花钱？这是复律庭的公物，找柯妮莉娅小姐申请理所应当。"
                                                                },
                                                                {
                                                                    "id": "740350235",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "这其实花不了多少钱…"
                                                                },
                                                                {
                                                                    "id": "740350236",
                                                                    "speaker": "瑟米安",
                                                                    "text": "这不是花钱多少的问题。这又是一个权责问题。"
                                                                },
                                                                {
                                                                    "id": "740350237",
                                                                    "speaker": "瑟米安",
                                                                    "text": "维修复律庭的公物，理应由复律庭的公账支出费用。"
                                                                },
                                                                {
                                                                    "id": "740350238",
                                                                    "speaker": "瑟米安",
                                                                    "text": "要是你用私账付了这笔钱，又没有把费用报销，到年终进行公务费用审算的时候，这一笔钱可就说不清了。"
                                                                },
                                                                {
                                                                    "id": "740350239",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "好吧！好吧！我这就去找柯妮莉娅小姐…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740350240",
                                                                            "text": "怎么买东西也这么麻烦…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740350242",
                                                                                    "speaker": "艾尤恩",
                                                                                    "text": "在复律庭里，这倒也正常。咱们走吧，去找柯妮莉娅小姐。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740350241",
                                                                            "text": "就连付钱也这么麻烦吗…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740350217",
                                                            "text": "你们不能帮帮他吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740350208",
                                            "text": "请问您是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740350203",
                            "text": "为什么你们之前见到我不惊讶？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403503",
            "objective": "与艾尤恩对话",
            "dialogues": [
                {
                    "id": "740350101",
                    "speaker": "艾尤恩",
                    "text": "啊…旅行者，很高兴见到你…",
                    "choices": [
                        {
                            "id": "740350102",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "740350104",
                                    "speaker": "派蒙",
                                    "text": "你的黑眼圈好重，说话也没力气了，不然还是去休息一下吧。"
                                },
                                {
                                    "id": "740350105",
                                    "speaker": "艾尤恩",
                                    "text": "我…我不能休息，昨晚上熬了一夜，写了好几稿都不行。现在我又开始重写…"
                                },
                                {
                                    "id": "740350106",
                                    "speaker": "艾尤恩",
                                    "text": "如果您想找我办什么事的话，请再等等吧…您可以去洛耶茨先生那边搬把椅子坐下，说不定他那边还有咖啡…"
                                },
                                {
                                    "id": "740350107",
                                    "speaker": "艾尤恩",
                                    "text": "我…我得继续写了…"
                                },
                                {
                                    "id": "740350108",
                                    "speaker": "艾尤恩",
                                    "text": "不行，用「各位亲爱的同僚」总显得不够正式…"
                                }
                            ]
                        },
                        {
                            "id": "740350103",
                            "text": "你看起来很不好…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403504",
            "objective": "与洛耶茨对话",
            "dialogues": []
        },
        {
            "id": "7403505",
            "objective": "与柯妮莉娅对话",
            "dialogues": [
                {
                    "id": "740350401",
                    "speaker": "柯妮莉娅",
                    "text": "您好，艾尤恩先生，有什么可以帮您的吗？"
                },
                {
                    "id": "740350402",
                    "speaker": "艾尤恩",
                    "text": "柯妮莉娅小姐，您也好。请问咱们有备用的打字机键帽吗？"
                },
                {
                    "id": "740350403",
                    "speaker": "柯妮莉娅",
                    "text": "什么？"
                },
                {
                    "id": "740350404",
                    "speaker": "艾尤恩",
                    "text": "我的打字机少了一个键帽，我想申请一个备用键帽换上。要是没有的话…帮我报销一个也成。"
                },
                {
                    "id": "740350405",
                    "speaker": "柯妮莉娅",
                    "text": "报销键帽…从原则上来说，倒是没有问题。"
                },
                {
                    "id": "740350406",
                    "speaker": "柯妮莉娅",
                    "text": "您在这签个字吧。就写「因打字机故障，需报销键帽一枚」，然后签上您的名字，还有办公室名。"
                },
                {
                    "id": "740350407",
                    "speaker": "艾尤恩",
                    "text": "好了，我今天应该能拿到这枚键帽吧，我还急着去工作。"
                },
                {
                    "id": "740350408",
                    "speaker": "柯妮莉娅",
                    "text": "艾尤恩先生，您之前报销过公物吗？"
                },
                {
                    "id": "740350409",
                    "speaker": "柯妮莉娅",
                    "text": "公物报销并不是您想象那样…来一件就报销一件，我们需要先以月为统计时间汇总报销单据，然后在月底统一交给枢律庭审批。"
                },
                {
                    "id": "740350410",
                    "speaker": "柯妮莉娅",
                    "text": "这审批事关整个复律庭的工资发放，如果报销的数额过大，枢律庭甚至需要呈给那维莱特大人审阅。"
                },
                {
                    "id": "740350427",
                    "speaker": "柯妮莉娅",
                    "text": "等他整体审阅完毕再签字后，才能正式开始拨款。"
                },
                {
                    "id": "740350411",
                    "speaker": "柯妮莉娅",
                    "text": "如果那维莱特大人对某个报销条目有疑问，对应的人员还需要提交一份书面说明…我们正准备这几天就把第一批提交上去呢。"
                },
                {
                    "id": "740350412",
                    "speaker": "艾尤恩",
                    "text": "你的意思是，如果我运气不好的话，想报销这枚键帽还得那维莱特大人点头？"
                },
                {
                    "id": "740350413",
                    "speaker": "柯妮莉娅",
                    "text": "规定如此，艾尤恩先生。而且这个月要报销的数额不小，很可能确实需要那维莱特大人审阅。"
                },
                {
                    "id": "740350414",
                    "speaker": "派蒙",
                    "text": "那维莱特大人…不就是那位「最高审判官」？"
                },
                {
                    "id": "740350415",
                    "speaker": "派蒙",
                    "text": "只不过是一个键帽，还要让他来签字…总感觉哪里不太对…",
                    "choices": [
                        {
                            "id": "740350416",
                            "text": "有没有别的方法？",
                            "response": [
                                {
                                    "id": "740350418",
                                    "speaker": "艾尤恩",
                                    "text": "我也这么想，只是一枚键帽而已，不用惊动那维莱特大人的大驾，真的不用了。"
                                },
                                {
                                    "id": "740350419",
                                    "speaker": "柯妮莉娅",
                                    "text": "倒是有别的方法。嗯…你可以先自己去买一枚键帽，然后我会在公账里给您打一个白条。"
                                },
                                {
                                    "id": "740350420",
                                    "speaker": "柯妮莉娅",
                                    "text": "在报销流程走完，款项拨下来之后，再将对应的费用从公账里拨付给您。"
                                },
                                {
                                    "id": "740350421",
                                    "speaker": "艾尤恩",
                                    "text": "好极了！就这样吧，一枚键帽也花不了多少钱，我付得起。"
                                },
                                {
                                    "id": "740350422",
                                    "speaker": "柯妮莉娅",
                                    "text": "那您在这里签个字，还是写「因打字机故障，需报销键帽一枚」…您是去伊丝黛莱小姐那买键帽吗？"
                                },
                                {
                                    "id": "740350423",
                                    "speaker": "艾尤恩",
                                    "text": "是的，怎么了？"
                                },
                                {
                                    "id": "740350424",
                                    "speaker": "柯妮莉娅",
                                    "text": "我稍后会拿着这张白条去找洛耶茨先生签字，然后再去找伊丝黛莱小姐核对账单。"
                                },
                                {
                                    "id": "740350425",
                                    "speaker": "柯妮莉娅",
                                    "text": "您就不用管这些事了，快点去买键帽吧，其他的事交给我处理就好。"
                                },
                                {
                                    "id": "740350426",
                                    "speaker": "艾尤恩",
                                    "text": "谢谢您。您真是太好了，柯妮莉娅小姐，我这就去买键帽…走吧旅行者，我们快出发。"
                                }
                            ]
                        },
                        {
                            "id": "740350417",
                            "text": "不然还是换个方法吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403506",
            "objective": "找伊丝黛莱购买键帽",
            "dialogues": [
                {
                    "id": "740350601",
                    "speaker": "伊丝黛莱",
                    "text": "艾尤恩，有什么事吗？你怎么上气不接下气的…"
                },
                {
                    "id": "740350602",
                    "speaker": "艾尤恩",
                    "text": "伊丝黛莱！快，快给我拿一个打字机的键帽！你这里应该有吧？"
                },
                {
                    "id": "740350603",
                    "speaker": "伊丝黛莱",
                    "text": "有啊，但打字机有好多键帽呢，你自己来看看要哪一个吧。"
                },
                {
                    "id": "740350604",
                    "speaker": "Black Screen",
                    "text": "艾尤恩开始飞快地翻找起了自己要的键帽…"
                },
                {
                    "id": "740350605",
                    "speaker": "艾尤恩",
                    "text": "就这个，我把钱放在这里了，谢谢了伊丝黛莱！"
                },
                {
                    "id": "740350606",
                    "speaker": "伊丝黛莱",
                    "text": "你上次说要和我去划船…艾尤恩！喂！艾尤恩！"
                }
            ]
        },
        {
            "id": "7403507",
            "objective": "与伊丝黛莱对话",
            "dialogues": []
        },
        {
            "id": "7403508",
            "objective": "返回复律庭",
            "dialogues": [
                {
                    "id": "740350801",
                    "speaker": "艾尤恩",
                    "text": "太好了，这下我可以继续工作了，今天一定要把这篇倡议书写出来。"
                },
                {
                    "id": "740350802",
                    "speaker": "艾尤恩",
                    "text": "太感谢你了，等我有空了，一定要请你吃一顿好的。"
                },
                {
                    "id": "740350807",
                    "speaker": "艾尤恩",
                    "text": "明天您有空吗？如果有的话，就来这里找我吧。"
                },
                {
                    "id": "740350808",
                    "speaker": "艾尤恩",
                    "text": "等我完成了工作，咱们就出去好好吃一顿！",
                    "choices": [
                        {
                            "id": "740350803",
                            "text": "那我就等着了。",
                            "response": [
                                {
                                    "id": "740350805",
                                    "speaker": "艾尤恩",
                                    "text": "你说得对，我必须再加快点速度…"
                                },
                                {
                                    "id": "740350806",
                                    "speaker": "艾尤恩",
                                    "text": "等会，下一句是什么来着？我应该用笔记下来了…"
                                }
                            ]
                        },
                        {
                            "id": "740350804",
                            "text": "你先把工作忙完吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403510",
            "objective": "将键帽安在打字机上",
            "dialogues": []
        },
        {
            "id": "7403509",
            "objective": "",
            "dialogues": [
                {
                    "id": "740350901",
                    "speaker": "艾尤恩",
