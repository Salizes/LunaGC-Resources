    },
    "talks": [
        {
            "id": "7518802",
            "objective": "(test)和NPC进行一段对话说明情况$HIDDEN",
            "dialogues": [
                {
                    "id": "751880201",
                    "speaker": "帕卡林",
                    "text": "那边的，对，没错，就是你！"
                },
                {
                    "id": "751880202",
                    "speaker": "帕卡林",
                    "text": "看你走路带风，跑得飞快，应该挺有力气的，像是经常锻炼的人。"
                },
                {
                    "id": "751880203",
                    "speaker": "帕卡林",
                    "text": "是我们「沃陆之邦」的勇士吗？还是说你来自其他部族？",
                    "choices": [
                        {
                            "id": "751880204",
                            "text": "我是路过的冒险家。",
                            "response": [
                                {
                                    "id": "751880206",
                                    "speaker": "帕卡林",
                                    "text": "这样啊，有点可惜了。唉，也是，正缺人的时候突然就碰上个帮忙的，这种好事也就是梦里才有。"
                                },
                                {
                                    "id": "751880207",
                                    "speaker": "Player",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "751880208",
                                    "speaker": "帕卡林",
                                    "text": "是这样的，你也看见了，我这里不是有片农场嘛。"
                                },
                                {
                                    "id": "751880209",
                                    "speaker": "帕卡林",
                                    "text": "这个农场一直是我一个人打理，但这阵子挺不巧的…"
                                },
                                {
                                    "id": "751880210",
                                    "speaker": "帕卡林",
                                    "text": "前几天，我去跟部族里的勇士角力，弄伤了背…是，我知道这件事挺蠢的。"
                                },
                                {
                                    "id": "751880211",
                                    "speaker": "帕卡林",
                                    "text": "结果，我现在既不能帮我爸爸开垦新田，也没法打理自己的农场，说实话，连走路都痛。"
                                },
                                {
                                    "id": "751880212",
                                    "speaker": "帕卡林",
                                    "text": "正想雇个人帮几天忙，恰好碰上你。"
                                },
                                {
                                    "id": "751880213",
                                    "speaker": "帕卡林",
                                    "text": "可惜你只是路过，种地得天天下田，你要是一会儿来一会儿不来，我这片田就荒废了。"
                                },
                                {
                                    "id": "751880214",
                                    "speaker": "帕卡林",
                                    "text": "但我现在也没力气跑大老远去部族里找人，唉，除了养的几只小突角龙，眼前也没什么人能帮忙了。"
                                },
                                {
                                    "id": "751880215",
                                    "speaker": "帕卡林",
                                    "text": "几只小捣蛋鬼这几天也不听话，三只全都赖在田里，都不肯到我脚边来。"
                                },
                                {
                                    "id": "751880216",
                                    "speaker": "帕卡林",
                                    "text": "这样吧，我能不能请你帮个小忙，替我把它们带回来，我真是不方便走路。"
                                },
                                {
                                    "id": "751880217",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "751880218",
                                    "speaker": "帕卡林",
                                    "text": "那就太好了，它们平时都还听话，经常陪我在田里忙活，只是这两天不知道怎么回事…"
                                },
                                {
                                    "id": "751880219",
                                    "speaker": "帕卡林",
                                    "text": "你招呼它们一声，我家的三只小龙大概自己就会回来了。"
                                }
                            ]
                        },
                        {
                            "id": "751880205",
                            "text": "我不是纳塔人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7518803",
            "objective": "(test)开始游玩抓小突角龙$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7518804",
            "objective": "(test)全抓住了之后再去和NPC对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751880401",
                    "speaker": "帕卡林",
                    "text": "这三个小家伙都回来了，应该都是你的功劳。"
                },
                {
                    "id": "751880402",
                    "speaker": "帕卡林",
                    "text": "路过的勇士，谢谢你这份好心。"
                },
                {
                    "id": "751880403",
                    "speaker": "帕卡林",
                    "text": "我这背还是疼，但至少有小龙在边上，有它们陪着，感觉舒坦多了。"
                },
                {
                    "id": "751880404",
                    "speaker": "帕卡林",
                    "text": "我也不是很富裕，但一点报酬还是出得起，这些东西请你拿着吧。"
                }
            ]
        },
        {
            "id": "7518801",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751880101",
                    "speaker": "帕卡林",
                    "text": "请你帮个忙，去田里找找我家<color=#00E1FFFF>三只小龙</color>，让它们回我脚边来吧。"
                }
            ]
        }
    ]
}