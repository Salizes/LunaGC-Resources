    },
    "talks": [
        {
            "id": "4024301",
            "objective": "与早柚对话",
            "dialogues": [
                {
                    "id": "402280901",
                    "speaker": "早柚",
                    "text": "呼噜…"
                },
                {
                    "id": "402280902",
                    "speaker": "派蒙",
                    "text": "早——柚——怎么又睡着啦。你很累吗？"
                },
                {
                    "id": "402280903",
                    "speaker": "早柚",
                    "text": "累…搬完凳子，又指挥大礼貉跑了好长一段路…真是辛苦我自己了，需要奖励自己睡一觉。"
                },
                {
                    "id": "402280904",
                    "speaker": "派蒙",
                    "text": "大狸貉？"
                },
                {
                    "id": "402280905",
                    "speaker": "早柚",
                    "text": "我就知道肯定会有人听成「狸」。大礼貉的「礼」是礼貌的「礼」，不是狸猫的「狸」！是很有礼貌的大貉貉。"
                },
                {
                    "id": "402280906",
                    "speaker": "派蒙",
                    "text": "好的。是礼貌不是狸猫。"
                },
                {
                    "id": "402280907",
                    "speaker": "早柚",
                    "text": "大礼貉是我的幻想朋友。一般情况下大家都看不见它嘛，所以我也没给你们正式介绍过。"
                },
                {
                    "id": "402280908",
                    "speaker": "派蒙",
                    "text": "果然小朋友们都有幻想朋友呢！"
                },
                {
                    "id": "402280909",
                    "speaker": "早柚",
                    "text": "嘘——「小朋友」这个称呼听上去会长不高，我是即将独当一面的忍者。嗯…即将。"
                },
                {
                    "id": "402280910",
                    "speaker": "早柚",
                    "text": "在独当一面前，跟好朋友共同当一面也没什么关系吧…"
                },
                {
                    "id": "402280911",
                    "speaker": "早柚",
                    "text": "而且…大家看不见大礼貉在帮我，所以在别人眼中我还是独当一面的样子哦。"
                },
                {
                    "id": "402280912",
                    "speaker": "派蒙",
                    "text": "感觉怪怪的…独当一面是这么用的吗？",
                    "choices": [
                        {
                            "id": "402280913",
                            "text": "哈哈，很有想象力的理解。",
                            "response": [
                                {
                                    "id": "402280915",
                                    "speaker": "早柚",
                                    "text": "真的吗？太好了，只需要打开这个忍术装置就可以跟它一起训练！"
                                },
                                {
                                    "id": "402280916",
                                    "speaker": "早柚",
                                    "text": "最近忙着跟小魔女们玩，落下了很多训练任务…"
                                },
                                {
                                    "id": "402280917",
                                    "speaker": "派蒙",
                                    "text": "训练任务？好呀早柚，想让我们帮你做任务，自己偷懒是吧！"
                                },
                                {
                                    "id": "402280918",
                                    "speaker": "早柚",
                                    "text": "这个那个…不是这样的！"
                                },
                                {
                                    "id": "402280919",
                                    "speaker": "早柚",
                                    "text": "这是老师离开前留给我的逃跑训练装置。如你们所见，我的逃跑技术已经相当熟练了。"
                                },
                                {
                                    "id": "402280920",
                                    "speaker": "早柚",
                                    "text": "属于我自己的训练任务早就完成了，我要偷的不是这个懒。"
                                },
                                {
                                    "id": "402280921",
                                    "speaker": "早柚",
                                    "text": "哎…大礼貉比我还懒，都快跟不上我的脚步了。不行啊，要逃就要一起逃。所以现在要做的是训练大礼貉的任务。"
                                },
                                {
                                    "id": "402280922",
                                    "speaker": "早柚",
                                    "text": "我想偷的是这个懒…"
                                },
                                {
                                    "id": "402280923",
                                    "speaker": "派蒙",
                                    "text": "这不还是偷懒吗！"
                                }
                            ]
                        },
                        {
                            "id": "402280914",
                            "text": "我很好奇大礼貉长什么样子。"
                        }
                    ]
                }
            ]
        }
    ]
}