    "talks": [
        {
            "id": "1020101",
            "objective": "前往低语森林，找到藏宝地",
            "dialogues": [
                {
                    "id": "102010101",
                    "speaker": "可莉",
                    "text": "到了到了！就在这附近！"
                },
                {
                    "id": "102010102",
                    "speaker": "可莉",
                    "text": "你们看，我那~~么大一个宝物，之前就是埋在这儿的…"
                },
                {
                    "id": "102010103",
                    "speaker": "派蒙",
                    "text": "被挖出了一个坑呢…"
                },
                {
                    "id": "102010104",
                    "speaker": "Player",
                    "text": "等等，那边有谁…"
                },
                {
                    "id": "102010105",
                    "speaker": "派蒙",
                    "text": "是深渊法师？！难道它就是琴团长之前警告的，偷偷接近蒙德城的…"
                },
                {
                    "id": "102010106",
                    "speaker": "派蒙",
                    "text": "咦？它手里拿着的是什么？"
                },
                {
                    "id": "102010107",
                    "speaker": "可莉",
                    "text": "是我的宝物！"
                },
                {
                    "id": "102010108",
                    "speaker": "派蒙",
                    "text": "欸？！"
                },
                {
                    "id": "102010109",
                    "speaker": "深渊法师",
                    "text": "嘁，那女孩居然带了帮手。计划有变…"
                },
                {
                    "id": "102010110",
                    "speaker": "派蒙",
                    "text": "喂！你有本事别逃呀！"
                },
                {
                    "id": "102010111",
                    "speaker": "Player",
                    "text": "我们追。"
                }
            ]
        },
        {
            "id": "1020112",
            "objective": "与可莉对话",
            "dialogues": []
        },
        {
            "id": "1020102",
            "objective": "与可莉一起追逐深渊法师（>50米失败）",
            "dialogues": [
                {
                    "id": "102010201",
                    "speaker": "可莉",
                    "text": "「深渊法师」？之前来森林里玩的时候，没有见过呢…"
                }
            ]
        },
        {
            "id": "1020103",
            "objective": "(test)追逐I$HIDDEN",
            "dialogues": [
                {
                    "id": "102010301",
                    "speaker": "派蒙",
                    "text": "啊，是秘境的入口！深渊法师一定是逃进去了吧。",
                    "choices": [
                        {
                            "id": "102010302",
                            "text": "那它也就没有退路了。",
                            "response": [
                                {
                                    "id": "102010304",
                                    "speaker": "可莉",
                                    "text": "呼…呼……"
                                },
                                {
                                    "id": "102010305",
                                    "speaker": "派蒙",
                                    "text": "小可莉，还跑得动吗？"
                                },
                                {
                                    "id": "102010306",
                                    "speaker": "派蒙",
                                    "text": "要不要留在这里，我们讨来宝物之后还给你。"
                                },
                                {
                                    "id": "102010307",
                                    "speaker": "可莉",
                                    "text": "…不，不行，我要跟你们一起去！"
                                },
                                {
                                    "id": "102010308",
                                    "speaker": "可莉",
                                    "text": "毛茸茸偷的是我的东西，我自己也要负责把它夺回来！",
                                    "choices": [
                                        {
                                            "id": "102010309",
                                            "text": "很有勇气呢。",
                                            "response": [
                                                {
                                                    "id": "102010311",
                                                    "speaker": "可莉",
                                                    "text": "嘿嘿，可莉是很厉害的！"
                                                },
                                                {
                                                    "id": "102010312",
                                                    "speaker": "可莉",
                                                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们走我们走。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102010310",
                                            "text": "但是秘境很危险哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102010303",
                            "text": "我们追上去吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020114",
            "objective": "(test)战斗I对话$HIDDEN",
            "dialogues": [
                {
                    "id": "102010601",
                    "speaker": "派蒙",
                    "text": "快把宝物交出来！"
                },
                {
                    "id": "102010602",
                    "speaker": "深渊法师",
                    "text": "呼…烦死了…"
                },
                {
                    "id": "102010603",
                    "speaker": "深渊法师",
                    "text": "好不容易到手的…怎么可能还给你。"
                },
                {
                    "id": "102010604",
                    "speaker": "深渊法师",
                    "text": "哼…"
                }
            ]
        },
        {
            "id": "1020104",
            "objective": "(test)战斗I$HIDDEN",
            "dialogues": [
                {
                    "id": "102010401",
                    "speaker": "深渊法师",
                    "text": "哼，追上来了吗。看来你们还算有两下子。"
                },
                {
                    "id": "102010402",
                    "speaker": "深渊法师",
                    "text": "不过，你们也就到此为止了。"
                },
                {
                    "id": "102010403",
                    "speaker": "派蒙",
                    "text": "你想要做什么？"
                },
                {
                    "id": "102010404",
                    "speaker": "深渊法师",
                    "text": "哈哈哈哈哈哈。"
                },
                {
                    "id": "102010405",
                    "speaker": "深渊法师",
                    "text": "我们可是在人类的传言里，收集到了详细的战力情报。"
                },
                {
                    "id": "102010406",
                    "speaker": "深渊法师",
                    "text": "这个红衣服的小女孩，拥有蒙德城最厉害的宝物。"
                },
                {
                    "id": "102010407",
                    "speaker": "深渊法师",
                    "text": "现在宝物在我手上，你们再着急也没用了。"
                },
                {
                    "id": "102010408",
                    "speaker": "深渊法师",
                    "text": "好——就用这个宝物来对付你们吧！"
                },
                {
                    "id": "102010409",
                    "speaker": "可莉",
                    "text": "不行！千…千万别动它！"
                },
                {
                    "id": "102010410",
                    "speaker": "深渊法师",
                    "text": "哼哼，看你慌张的样子，终于知道害怕了吗。"
                },
                {
                    "id": "102010411",
                    "speaker": "深渊法师",
                    "text": "让我看看，哦…火焰的标记吗，哼哼哼哼。"
                },
                {
                    "id": "102010412",
                    "speaker": "？？？",
                    "text": "嘣——"
                },
                {
                    "id": "102010501",
                    "speaker": "可莉",
                    "text": "啊！"
                },
                {
                    "id": "102010502",
                    "speaker": "可莉",
                    "text": "生存守则之——「炸弹伤人琴找上门」…"
                },
                {
                    "id": "102010503",
                    "speaker": "可莉",
                    "text": "完了完了…这下全完了呜呜呜……"
                },
                {
                    "id": "102010504",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "102010505",
                    "speaker": "派蒙",
                    "text": "可莉的「宝物」，原来是炸弹吗！",
                    "choices": [
                        {
                            "id": "102010506",
                            "text": "好厉害…",
                            "response": [
                                {
                                    "id": "102010508",
                                    "speaker": "派蒙",
                                    "text": "唔，难怪会有可莉是蒙德最强战力的传言呢。"
                                },
                                {
                                    "id": "102010509",
                                    "speaker": "派蒙",
                                    "text": "至少我是肯定不敢跟她打架的啦。"
                                },
                                {
                                    "id": "102010510",
                                    "speaker": "派蒙",
                                    "text": "但是，她为什么要逃走呢？",
                                    "choices": [
                                        {
                                            "id": "102010511",
                                            "text": "她好像提到了生存守则。",
                                            "response": [
                                                {
                                                    "id": "102010513",
                                                    "speaker": "派蒙",
                                                    "text": "唔，也对！"
                                                },
                                                {
                                                    "id": "102010514",
                                                    "speaker": "派蒙",
                                                    "text": "那我们还是先回<color=#00E1FFFF>骑士团</color>找琴团长汇报一下情况吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102010512",
                                            "text": "她刚刚提到了琴团长的名字…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102010507",
                            "text": "深渊法师一下子就被解决了。"
                        }
                    ]
                }
            ]
        },
        {
