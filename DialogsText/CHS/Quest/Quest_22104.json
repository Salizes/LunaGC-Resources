        }
    },
    "talks": [
        {
            "id": "2210401",
            "objective": "与菲尔戈黛特对话",
            "dialogues": [
                {
                    "id": "221040101",
                    "speaker": "菲尔戈黛特",
                    "text": "真是烦人…"
                },
                {
                    "id": "221040102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221040103",
                    "speaker": "菲尔戈黛特",
                    "text": "咦，抱歉，您是什么时候来的…"
                },
                {
                    "id": "221040104",
                    "speaker": "菲尔戈黛特",
                    "text": "是这样，周围的怪物越来越多了，虽然我丈夫老是说，他们不敢进客栈来…"
                },
                {
                    "id": "221040105",
                    "speaker": "菲尔戈黛特",
                    "text": "但是只有他一个人的拳脚…我还是有点担心。"
                },
                {
                    "id": "221040106",
                    "speaker": "菲尔戈黛特",
                    "text": "您如果有空的话，能帮我去客栈周围看看吗？",
                    "choices": [
                        {
                            "id": "221040107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221040109",
                                    "speaker": "菲尔戈黛特",
                                    "text": "谢谢您愿意帮忙。"
                                },
                                {
                                    "id": "221040113",
                                    "speaker": "菲尔戈黛特",
                                    "text": "总之，就拜托你了，报酬我也不会少您的。"
                                }
                            ]
                        },
                        {
                            "id": "221040108",
                            "text": "这家客栈…",
                            "response": [
                                {
                                    "id": "221040110",
                                    "speaker": "菲尔戈黛特",
                                    "text": "唔…只是一家很普通的客栈啦，只不过开的地方偏了点，收的客人多了点。"
                                },
                                {
                                    "id": "221040111",
                                    "speaker": "菲尔戈黛特",
                                    "text": "不过流落野外的人，有个地方能吃饭睡觉总是好的。"
                                },
                                {
                                    "id": "221040112",
                                    "speaker": "菲尔戈黛特",
                                    "text": "我和我丈夫是这么想的，也就是这么简单。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210402",
            "objective": "前往可疑地点查看",
            "dialogues": [
                {
                    "id": "221040201",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221040202",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "221040203",
                    "speaker": "菲尔戈黛特",
                    "text": "请您小心一些吧，我总感觉，周围怪怪的…"
                }
            ]
        },
        {
            "id": "2210403",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "221040301",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221040302",
                    "speaker": "Player",
                    "text": "处理好了。"
                },
                {
                    "id": "221040303",
                    "speaker": "菲尔戈黛特",
                    "text": "这下子，就能消停一点了吧。"
                },
                {
                    "id": "221040304",
                    "speaker": "菲尔戈黛特",
                    "text": "辛苦您了，这是给你的报酬。"
                }
            ]
        },
        {
            "id": "2210404",
            "objective": "向菲尔戈黛特回报",
            "dialogues": []
        }
    ]
}