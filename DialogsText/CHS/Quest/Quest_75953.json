        },
        {
            "id": "7595302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "664920401",
                    "speaker": "Player",
                    "text": "拉威亚说你卖隔夜的鱼。"
                },
                {
                    "id": "664920402",
                    "speaker": "特乌兹特利",
                    "text": "好小子，我说怎么店里营业额和成本对不上。原来这家伙在捣鬼，不能让他再留在店里了。"
                },
                {
                    "id": "664920403",
                    "speaker": "特乌兹特利",
                    "text": "客人您真是正义使者，市场上要是您这种人再多一点也不会这么乌烟瘴气！这些是我的谢意，感谢您。"
                }
            ]
        },
        {
            "id": "7595303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "664920501",
                    "speaker": "Player",
                    "text": "拉威亚说你的鱼很新鲜。"
                },
                {
                    "id": "664920502",
                    "speaker": "特乌兹特利",
                    "text": "哈哈，那小子还是很有眼光的啊，就跟我招了他一样有眼光。"
                },
                {
                    "id": "664920503",
                    "speaker": "特乌兹特利",
                    "text": "客人您也是识货的人，选择小店绝对没错，这些就送给您了吧。"
                }
            ]
        }
