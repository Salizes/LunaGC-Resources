    "talks": [
        {
            "id": "7153701",
            "objective": "等待至次日的8时至18时",
            "dialogues": [
                {
                    "id": "715370101",
                    "speaker": "诺艾尔",
                    "text": "荣誉骑士前辈，居然能在这里遇见你！"
                },
                {
                    "id": "715370102",
                    "speaker": "Player",
                    "text": "你在做「祝柬」么？"
                },
                {
                    "id": "715370103",
                    "speaker": "诺艾尔",
                    "text": "嗯，好不容易趁着休假来了璃月港，我正在采购礼物，准备带回去送给骑士团的各位。"
                },
                {
                    "id": "715370104",
                    "speaker": "诺艾尔",
                    "text": "然后我听说，在海灯节期间，璃月人送礼物时一般会写一封「祝柬」附在里面…"
                },
                {
                    "id": "715370105",
                    "speaker": "诺艾尔",
                    "text": "所以，我就想要效仿一下。也做几封漂亮的「祝柬」。但怎么做，似乎都不太好看…"
                },
                {
                    "id": "715370106",
                    "speaker": "诺艾尔",
                    "text": "荣誉骑士前辈，你知道怎么做的「祝柬」最好看么？"
                },
                {
                    "id": "715370107",
                    "speaker": "Player",
                    "text": "放心，包在我身上。"
                }
            ]
        },
        {
            "id": "7153702",
            "objective": "与诺艾尔对话",
            "dialogues": []
        },
        {
            "id": "7153703",
            "objective": "和诺艾尔一同完成祝柬",
            "dialogues": [
                {
                    "id": "715370301",
                    "speaker": "诺艾尔",
                    "text": "原来是这样…不愧是前辈！果然什么都很懂啊！"
                },
                {
                    "id": "715370302",
                    "speaker": "诺艾尔",
                    "text": "谢谢前辈的指导，这封「祝柬」我会好好珍藏的。"
                },
                {
                    "id": "715370303",
                    "speaker": "诺艾尔",
                    "text": "等下次蒙德举办「风花节」，你可一定要来啊。"
                },
                {
                    "id": "715370304",
                    "speaker": "诺艾尔",
                    "text": "到时候，我一定给你写一封和这份「祝柬」一样漂亮的贺卡。"
                }
            ]
        },
        {
            "id": "7153704",
