    "talks": [
        {
            "id": "4006801",
            "objective": "休息到第二天(6点-24点）",
            "dialogues": []
        },
        {
            "id": "4006802",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400680201",
                    "speaker": "派蒙",
                    "text": "起床啦——！太阳晒到屁股上啦！"
                },
                {
                    "id": "400680202",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "400680203",
                    "speaker": "Player",
                    "text": "派蒙，我是仰面朝上睡的。"
                },
                {
                    "id": "400680204",
                    "speaker": "派蒙",
                    "text": "好吧，那太阳晒到肚子上啦。"
                },
                {
                    "id": "400680205",
                    "speaker": "枫原万叶",
                    "text": "#{NICKNAME}，昨晚睡得好吗？",
                    "choices": [
                        {
                            "id": "400680206",
                            "text": "马马虎虎。",
                            "response": [
                                {
                                    "id": "400680208",
                                    "speaker": "枫原万叶",
                                    "text": "大家好像都跟你差不多。今天我起得最早，四处逛了逛，摘了水果给大家当早餐。"
                                },
                                {
                                    "id": "400680209",
                                    "speaker": "派蒙",
                                    "text": "为了等你起床，我可是一直忍着没先吃哦！"
                                },
                                {
                                    "id": "400680210",
                                    "speaker": "Black Screen",
                                    "text": "在大家的陪伴下享用了水果早餐，期间，众人闲聊起来…"
                                },
                                {
                                    "id": "400680211",
                                    "speaker": "派蒙",
                                    "text": "咦？菲谢尔一早就跑了？"
                                },
                                {
                                    "id": "400680212",
                                    "speaker": "辛焱",
                                    "text": "嗯，她似乎不太愿意跟我们一起行动，说是另有冒险家的工作。"
                                },
                                {
                                    "id": "400680213",
                                    "speaker": "派蒙",
                                    "text": "太假了吧！明明说是来光复幽夜净土的，怎么又给冒险家协会打工去了？"
                                },
                                {
                                    "id": "400680214",
                                    "speaker": "Player",
                                    "text": "好了…派蒙…"
                                },
                                {
                                    "id": "400680215",
                                    "speaker": "枫原万叶",
                                    "text": "瞧她的样子，应该是有心事吧。"
                                },
                                {
                                    "id": "400680216",
                                    "speaker": "辛焱",
                                    "text": "我们按原计划派出莫娜关怀她，没想到，她居然说莫娜不懂冒险家的工作，不能跟去冒险。"
                                },
                                {
                                    "id": "400680217",
                                    "speaker": "派蒙",
                                    "text": "菲谢尔为了独处，连幽夜净土这个借口都不用了呢…"
                                },
                                {
                                    "id": "400680218",
                                    "speaker": "枫原万叶",
                                    "text": "可见她遇到了不小的难题。"
                                },
                                {
                                    "id": "400680219",
                                    "speaker": "莫娜",
                                    "text": "唉，我身为朋友，很想帮帮她。不过有一句话她说对了，今天我们会去其他岛屿探索。"
                                },
                                {
                                    "id": "400680220",
                                    "speaker": "Player",
                                    "text": "欸？是这样吗？"
                                },
                                {
                                    "id": "400680221",
                                    "speaker": "派蒙",
                                    "text": "大家全票通过的呢！"
                                },
                                {
                                    "id": "400680222",
                                    "speaker": "Player",
                                    "text": "我都没参加，怎么能算全票！"
                                },
                                {
                                    "id": "400680223",
                                    "speaker": "辛焱",
                                    "text": "这个啊，刚才派蒙替你投了。她说，你和她是一伙的，你在哪儿她就在哪儿，反过来也一样。"
                                },
                                {
                                    "id": "400680224",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，你可是冒险家，肯定会去的啦。"
                                },
                                {
                                    "id": "400680225",
                                    "speaker": "Player",
                                    "text": "（派蒙这家伙，好吧…）"
                                },
                                {
                                    "id": "400680226",
                                    "speaker": "莫娜",
                                    "text": "菲谢尔建议我们一起行动，她自己还有其他想调查的事，让我们不用担心，她忙完就来跟我们会合。"
                                },
                                {
                                    "id": "400680227",
                                    "speaker": "莫娜",
                                    "text": "别看她平时那样，怎么说都是个经验丰富的冒险家，我想，我们应该相信她。"
                                },
                                {
                                    "id": "400680228",
                                    "speaker": "枫原万叶",
                                    "text": "跟菲谢尔认识不久，我的意见只是冒昧猜测而已。不过我认为…她的矛盾在于自身。"
                                },
                                {
                                    "id": "400680229",
                                    "speaker": "派蒙",
                                    "text": "好像还挺准的…"
                                },
                                {
                                    "id": "400680230",
                                    "speaker": "枫原万叶",
                                    "text": "与他人的矛盾，不是解决就是放弃，唯独跟自己，永远不能轻易放下。"
                                },
                                {
                                    "id": "400680231",
                                    "speaker": "枫原万叶",
                                    "text": "…我也有过那样的时期，很理解她。虽不知道她在苦恼什么，但现在她需要独处。"
                                },
                                {
                                    "id": "400680232",
                                    "speaker": "辛焱",
                                    "text": "我也同意，就是可惜了今天的冒险之旅…大家一起才有意思啊。"
                                },
                                {
                                    "id": "400680233",
                                    "speaker": "派蒙",
                                    "text": "辛焱太有进取精神了…"
                                },
                                {
                                    "id": "400680234",
                                    "speaker": "辛焱",
                                    "text": "#啊对了，还没告诉你们呢。今天早上，北边那座岛屿出现了幻象，等{NICKNAME}吃完早餐，我们就去调查吧。"
                                }
                            ]
                        },
                        {
                            "id": "400680207",
                            "text": "不错哦！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006803",
            "objective": "前往北边岛屿",
            "dialogues": [
                {
                    "id": "400680301",
                    "speaker": "派蒙",
                    "text": "看起来是正常的岛屿呢。"
                },
                {
                    "id": "400680302",
                    "speaker": "枫原万叶",
                    "text": "…风里似乎有灼烧的气味。"
                },
                {
                    "id": "400680303",
                    "speaker": "莫娜",
                    "text": "呃…我的水占盘变明亮一点了，可还是看不清楚…"
                },
                {
                    "id": "400680304",
                    "speaker": "辛焱",
                    "text": "喂！看我发现了什么！"
                },
                {
                    "id": "400680305",
                    "speaker": "辛焱",
                    "text": "这东西…该说它是一面鼓，还是一株植物？"
                },
                {
                    "id": "400680306",
                    "speaker": "枫原万叶",
                    "text": "是植物构成的乐器？那看来…"
                },
                {
                    "id": "400680307",
                    "speaker": "莫娜",
                    "text": "辛焱，这里该不会是跟你有关的岛屿吧？"
                },
                {
                    "id": "400680308",
                    "speaker": "辛焱",
                    "text": "唔，难道这是给我准备的乐器？那我先敲一敲…"
                },
                {
                    "id": "400680309",
                    "speaker": "枫原万叶",
                    "text": "稍等一下。昨天我碰了盆景中的假山，我们就被转移到某个特殊的空间内，辛焱，你要不要先做个准备？"
                },
                {
                    "id": "400680310",
                    "speaker": "辛焱",
                    "text": "你说得对，但我不担心这个。我对音乐，可是随时都有所准备的。"
                }
            ]
        },
        {
            "id": "4006818",
            "objective": "敲响造型奇特的植物",
            "dialogues": []
        },
        {
            "id": "4006804",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400680401",
                    "speaker": "派蒙",
                    "text": "咳咳，吃了一嘴灰…"
                },
                {
                    "id": "400680402",
                    "speaker": "辛焱",
                    "text": "没事吧派蒙？"
                },
                {
                    "id": "400680403",
                    "speaker": "枫原万叶",
                    "text": "果然，换地方了。"
                },
                {
                    "id": "400680404",
                    "speaker": "莫娜",
                    "text": "这里怎么有种荒凉的感觉…辛焱，这是跟你有关的幻境没错吧？"
                },
                {
                    "id": "400680405",
                    "speaker": "辛焱",
                    "text": "我猜没错，但…奇怪，怎么会这么荒凉？"
                },
                {
                    "id": "400680406",
                    "speaker": "派蒙",
                    "text": "你们看，那个地方好亮，像在邀请我们过去。"
                },
                {
                    "id": "400680407",
                    "speaker": "枫原万叶",
                    "text": "嗯，过去看看。"
                },
                {
                    "id": "400680408",
                    "speaker": "派蒙",
                    "text": "欸不对不对！这么明显，肯定是陷阱吧！"
                },
                {
                    "id": "400680409",
                    "speaker": "莫娜",
                    "text": "说是这么说，我们也没有其他路可走啊。"
                },
                {
                    "id": "400680410",
                    "speaker": "Player",
                    "text": "确实…"
                },
                {
                    "id": "400680411",
                    "speaker": "枫原万叶",
                    "text": "如果这的确是辛焱的幻境，应该不会有陷阱。"
                },
                {
                    "id": "400680412",
                    "speaker": "辛焱",
                    "text": "这话我爱听！一下就肯定了我的人品。"
                },
                {
                    "id": "400680413",
                    "speaker": "派蒙",
                    "text": "有道理欸，那我们过去看看吧，不过要小心一点。"
                }
            ]
        },
        {
            "id": "4006805",
            "objective": "前往光线明亮的地方",
            "dialogues": [
                {
                    "id": "400680501",
                    "speaker": "莫娜",
                    "text": "门锁住了。",
                    "choices": [
                        {
                            "id": "400680502",
                            "text": "莫娜，变成水钻进去！",
                            "response": [
                                {
                                    "id": "400680503",
                                    "speaker": "莫娜",
                                    "text": "说什么胡话啊你。"
                                },
                                {
                                    "id": "400680506",
                                    "speaker": "派蒙",
                                    "text": "辛焱，你干嘛把门锁起来？"
                                },
                                {
                                    "id": "400680507",
                                    "speaker": "辛焱",
                                    "text": "啊哈哈，就算你问我，我也…"
                                },
                                {
                                    "id": "400680508",
                                    "speaker": "辛焱",
                                    "text": "唔，不过我是个会把钥匙放在家门口花盆底下的人，所以…附近应该有钥匙。"
                                },
                                {
                                    "id": "400680509",
                                    "speaker": "派蒙",
                                    "text": "噢！这附近有花盆吗？"
                                },
                                {
                                    "id": "400680510",
                                    "speaker": "Player",
                                    "text": "没有花盆，但有…那个。"
                                },
                                {
                                    "id": "400680511",
                                    "speaker": "辛焱",
                                    "text": "不无可能。"
                                }
                            ]
                        },
                        {
                            "id": "400680504",
                            "text": "万叶用力跳起来，就能解决了！",
                            "response": [
                                {
                                    "id": "400680505",
                                    "speaker": "枫原万叶",
                                    "text": "…还是再想想吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006806",
            "objective": "寻找钥匙",
            "dialogues": []
        },
        {
            "id": "4006807",
            "objective": "用钥匙打开门扉",
            "dialogues": []
        },
        {
            "id": "4006808",
            "objective": "沿路前进",
            "dialogues": []
        },
        {
            "id": "4006809",
            "objective": "靠近巨大的花朵",
            "dialogues": [
                {
                    "id": "400680901",
                    "speaker": "派蒙",
                    "text": "哇！好大一朵花！"
                },
                {
                    "id": "400680902",
                    "speaker": "莫娜",
                    "text": "这里好热…跟那朵花有关系吗？"
                },
                {
                    "id": "400680903",
                    "speaker": "火炽之心",
                    "text": "没想到，这里会有客人。"
                },
                {
                    "id": "400680904",
                    "speaker": "派蒙",
                    "text": "咿啊啊啊啊它会说话！",
                    "choices": [
                        {
                            "id": "400680905",
                            "text": "昨天松鼠也说话了…",
                            "response": [
                                {
                                    "id": "400680907",
                                    "speaker": "派蒙",
                                    "text": "我知道啦！但、但就是不一样嘛…"
                                },
                                {
                                    "id": "400680908",
                                    "speaker": "辛焱",
                                    "text": "您好，我们触摸了外面海滩上那些长得像鼓一样的植物，就被送到这一带来。请问您是这里的主人吗？"
                                },
                                {
                                    "id": "400680909",
                                    "speaker": "火炽之心",
                                    "text": "这里是音乐的殿堂，我不过是区区守门者。朋友们，你们也是来追求极致音乐的吗？"
                                },
                                {
                                    "id": "400680910",
                                    "speaker": "辛焱",
                                    "text": "没错。"
                                },
                                {
                                    "id": "400680911",
                                    "speaker": "火炽之心",
                                    "text": "那么，你对音乐的寄托是…"
                                },
                                {
                                    "id": "400680912",
                                    "speaker": "辛焱",
                                    "text": "为反抗高歌！"
                                },
                                {
                                    "id": "400680913",
                                    "speaker": "火炽之心",
                                    "text": "你很懂嘛！太好了，能遇到知己，我可真有福气。"
                                },
                                {
                                    "id": "400680914",
                                    "speaker": "派蒙",
                                    "text": "跟奇怪的花都这么投缘…"
                                },
                                {
                                    "id": "400680915",
                                    "speaker": "莫娜",
                                    "text": "好相处的人，走到哪里都有很多朋友呢。"
                                },
                                {
                                    "id": "400680916",
                                    "speaker": "火炽之心",
                                    "text": "你们能走到这里，一定是想进入更深层的殿堂。不过很抱歉，进入殿堂需要我的歌喉，而我现在嗓子有点哑…"
                                },
                                {
                                    "id": "400680917",
                                    "speaker": "辛焱",
                                    "text": "你不要紧吧？要不要，呃，喝点驱寒的药？"
                                },
                                {
                                    "id": "400680918",
                                    "speaker": "火炽之心",
                                    "text": "不，我只是太久没喝「寒山甘泉」了。只要喝到那个，我就能重振歌喉，为你们打开道路。"
                                },
                                {
                                    "id": "400680919",
                                    "speaker": "辛焱",
                                    "text": "「寒山甘泉」？是泉水的名字？"
                                },
                                {
                                    "id": "400680920",
                                    "speaker": "火炽之心",
                                    "text": "对。只要喝下那种水，疲惫的大人，困倦的小鸟，无知的孩童…所有人都能唱出最优美的歌声。"
                                },
                                {
                                    "id": "400680921",
                                    "speaker": "辛焱",
                                    "text": "……"
                                },
                                {
                                    "id": "400680922",
                                    "speaker": "辛焱",
                                    "text": "好，我帮你找。你把泉水的所在地告诉我。"
                                },
                                {
                                    "id": "400680923",
                                    "speaker": "火炽之心",
                                    "text": "谢谢你！清澈的水令植物生长，它们变得茁壮，克服困难攀上高山…泉水，就在那些被植被庇护的山上。"
                                },
                                {
                                    "id": "400680924",
                                    "speaker": "派蒙",
                                    "text": "原来是上山啊！我还以为随便打点海水就行。"
                                },
                                {
                                    "id": "400680925",
                                    "speaker": "莫娜",
                                    "text": "山泉跟海水完全是两种东西吧。"
                                },
                                {
                                    "id": "400680926",
                                    "speaker": "火炽之心",
                                    "text": "只不过，想要看到那样的山泉，或许得靠我的力量。这位朋友，把手给我，这样你就能看到我所看见的事物。"
                                },
                                {
                                    "id": "400680927",
                                    "speaker": "辛焱",
                                    "text": "握了我的手，就是结交我这个朋友了哦。"
                                }
                            ]
                        },
                        {
                            "id": "400680906",
                            "text": "昨天船也说话了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006810",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400681001",
                    "speaker": "派蒙",
                    "text": "哇，出来了！"
                },
                {
                    "id": "400681002",
                    "speaker": "辛焱",
                    "text": "嗯~还是外面明亮，不过我也不讨厌那个热乎乎的山洞。"
                },
                {
                    "id": "400681003",
                    "speaker": "枫原万叶",
                    "text": "「寒山甘泉」就在这附近的山上，我们一起找。"
                },
                {
                    "id": "400681004",
                    "speaker": "莫娜",
                    "text": "等等，这地下怎么有光？这是…水脉？"
                },
                {
                    "id": "400681005",
                    "speaker": "辛焱",
                    "text": "根据那朵花说的话…水脉和植物有关，植物又跟山上的泉水有关。跟着水脉走，准没错。"
                }
            ]
        },
        {
            "id": "4006811",
            "objective": "疏通贯穿山体的水脉",
            "dialogues": []
        },
        {
            "id": "4006812",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400681201",
                    "speaker": "枫原万叶",
                    "text": "各位，这里有张纸条。"
                },
                {
                    "id": "400681202",
                    "speaker": "枫原万叶",
                    "text": "原来如此，这座岛真是有趣啊。"
                },
                {
                    "id": "400681203",
                    "speaker": "派蒙",
                    "text": "这种口吻，还有这个署名，是阿贝多呢！我们在蒙德的朋友。"
                },
                {
                    "id": "400681204",
                    "speaker": "派蒙",
                    "text": "阿贝多是很厉害的炼金术士，他也来过这片海岛哦，这张纸是他留给后来者的笔记。"
                },
                {
                    "id": "400681205",
                    "speaker": "枫原万叶",
                    "text": "哦？原来是他。"
                },
                {
                    "id": "400681206",
                    "speaker": "辛焱",
                    "text": "他的意思是，这整座岛都被做成了乐器？天哪，太厉害了。"
                },
                {
                    "id": "400681207",
                    "speaker": "派蒙",
                    "text": "而且还跟地下的水脉有关，唔，可能是要把水脉全部疏通才能奏响这座岛吧…"
                },
                {
                    "id": "400681208",
                    "speaker": "辛焱",
                    "text": "演奏乐器之前先做清扫工作，很合理。"
                }
            ]
        },
        {
            "id": "4006817",
            "objective": "疏通贯穿山体的水脉",
            "dialogues": []
        },
        {
            "id": "4006815",
            "objective": "汲取「寒山甘泉」",
            "dialogues": [
                {
                    "id": "400681501",
                    "speaker": "派蒙",
                    "text": "这应该就是我们要找的「寒山甘泉」了。"
                },
                {
                    "id": "400681502",
                    "speaker": "莫娜",
                    "text": "喝了这个，就能唱出美妙动人的歌声吗？"
                },
                {
                    "id": "400681503",
                    "speaker": "枫原万叶",
                    "text": "感兴趣的话，可以试试。"
                },
                {
                    "id": "400681504",
                    "speaker": "莫娜",
                    "text": "不不，我又不会唱歌…万一没用岂不是很尴尬。"
                },
                {
                    "id": "400681505",
                    "speaker": "辛焱",
                    "text": "哈哈哈，莫娜声音这么好听，很适合唱歌。要是你不嫌弃，等回营地我教你怎么运气发声。"
                },
                {
                    "id": "400681506",
                    "speaker": "莫娜",
                    "text": "欸？可、可以吗？你先保证，绝对不能笑我。"
                },
                {
                    "id": "400681507",
                    "speaker": "辛焱",
                    "text": "不笑不笑，谁都是从头开始学的嘛。"
                },
                {
                    "id": "400681508",
                    "speaker": "莫娜",
                    "text": "嗯…那我可以稍微试一试。"
                },
                {
                    "id": "400681509",
                    "speaker": "辛焱",
                    "text": "好。在那之前，我们先把山泉送到花那里。"
                },
                {
                    "id": "400681510",
                    "speaker": "枫原万叶",
                    "text": "触碰海滩上的鼓就能进入幻境了，再来一次吧。"
                }
            ]
        },
        {
