{
    "quest": {
        "id": "20514",
        "title": "大病初愈",
        "description": "安娜的病逐渐好了起来，她终于可以到处玩了。不过，安东尼总是找不到她…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 57,
        "total_speaker_counts": {
            "Player": 10,
            "塞琉斯": 6,
