            "安娜": 15
        }
    },
    "talks": [
        {
            "id": "2051401",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205140101",
                    "speaker": "安东尼",
                    "text": "这叫什么事啊…"
                },
                {
                    "id": "205140102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "205140103",
                    "speaker": "安东尼",
                    "text": "是你啊，来得正好…自从吃了那位神医的药，安娜的病逐渐好了。"
                },
                {
                    "id": "205140104",
                    "speaker": "安东尼",
                    "text": "她之前身体不好，必须要静养，在家里憋了太久。"
                },
                {
                    "id": "205140105",
                    "speaker": "安东尼",
                    "text": "现在她身体好起来了，每天都和我闹着要出去玩，我拗不过她，就答应了。"
                },
                {
                    "id": "205140106",
                    "speaker": "安东尼",
                    "text": "但是…现在我压根就找不到她了。这丫头到底跑到哪去玩了，你快点帮我找找吧！",
                    "choices": [
                        {
                            "id": "205140107",
                            "text": "我，我知道了。",
                            "response": [
                                {
                                    "id": "205140108",
                                    "speaker": "安东尼",
                                    "text": "我在这里等着，你快点去吧。"
                                },
                                {
                                    "id": "205140109",
                                    "speaker": "安东尼",
                                    "text": "这丫头，身体刚有点起色就瞎折腾，要是再出什么事怎么办…"
                                },
                                {
                                    "id": "205140116",
                                    "speaker": "安东尼",
                                    "text": "我已经在城里找了很久…就差冒险家协会那一片没找过，但是我实在是没力气了…"
                                },
                                {
                                    "id": "205140117",
                                    "speaker": "安东尼",
                                    "text": "你就先去冒险家协会那一片找找看吧。还有，说不定塞琉斯先生会注意到什么…"
                                },
                                {
                                    "id": "205140118",
                                    "speaker": "安东尼",
                                    "text": "希望能找到，不然我还得接着去找…"
                                }
                            ]
                        },
                        {
                            "id": "205140110",
                            "text": "你好像挺高兴的。",
                            "response": [
                                {
                                    "id": "205140111",
                                    "speaker": "安东尼",
                                    "text": "高兴？别，别开玩笑了，这丫头身体刚好一点，就开始这么闹腾。"
                                },
                                {
                                    "id": "205140112",
                                    "speaker": "安东尼",
                                    "text": "等她回来了，有她好看的！"
                                }
                            ]
                        },
                        {
                            "id": "205140113",
                            "text": "肚子饿了就会回来的。",
                            "response": [
                                {
                                    "id": "205140114",
                                    "speaker": "安东尼",
                                    "text": "你当我妹妹是猫吗…再说她病刚好，怎么能饿肚子。"
                                },
                                {
                                    "id": "205140115",
                                    "speaker": "安东尼",
                                    "text": "好了好了，你快帮我找找吧，我就在这等你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051402",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205140201",
                    "speaker": "安娜",
                    "text": "好高…这里哥哥应该找不到了。"
                },
                {
                    "id": "205140202",
                    "speaker": "Player",
                    "text": "你在这做什么…"
                },
                {
                    "id": "205140203",
                    "speaker": "安娜",
                    "text": "哇！你是怎么上来的，怎么一点动静都没有？"
                },
                {
                    "id": "205140204",
                    "speaker": "安娜",
                    "text": "还有你是怎么找到我的？"
                },
                {
                    "id": "205140205",
                    "speaker": "安娜",
                    "text": "我？我就是，爬着爬着就上来啦。"
                },
                {
                    "id": "205140206",
                    "speaker": "安娜",
                    "text": "哥哥在找我？咦，怎么都这个时间了，完全没有注意。"
                },
                {
                    "id": "205140207",
                    "speaker": "安娜",
                    "text": "我知道啦，我马上就回去啦，再在这里呆一会…"
                }
            ]
        },
        {
            "id": "2051403",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205140301",
                    "speaker": "安东尼",
                    "text": "你找到安娜了吗？"
                },
                {
                    "id": "205140302",
                    "speaker": "Player",
                    "text": "安娜在一架风车上。"
                },
                {
                    "id": "205140303",
                    "speaker": "安东尼",
                    "text": "风车？！这丫头是怎么上去的！我马上就去找西风骑士！"
                },
                {
                    "id": "205140304",
                    "speaker": "Player",
                    "text": "她说她等会就回来…"
                },
                {
                    "id": "205140305",
                    "speaker": "安东尼",
                    "text": "是，是这样吗，没事就好，吓死我了，我还以为她被困在风车上下不来了呢。"
                },
                {
                    "id": "205140306",
                    "speaker": "安东尼",
                    "text": "谢谢你，我马上就去找她。"
                },
                {
                    "id": "205140307",
                    "speaker": "安东尼",
                    "text": "病刚好就开始折腾，我非要好好训训她不可…"
                }
            ]
        },
        {
            "id": "2051404",
            "objective": "与塞琉斯对话$HIDDEN",
            "dialogues": [
                {
                    "id": "205140401",
                    "speaker": "塞琉斯",
                    "text": "唔？真是稀奇，你怎么来了？"
                },
                {
                    "id": "205140402",
                    "speaker": "Player",
                    "text": "你有没有见过一个女孩…"
                },
                {
                    "id": "205140403",
                    "speaker": "塞琉斯",
                    "text": "女孩？哦，你是说安娜吗？我看见了，她刚才往那边的风车跑了。"
                },
                {
                    "id": "205140404",
                    "speaker": "塞琉斯",
                    "text": "我还在奇怪呢，那孩子不是身体不好吗，怎么突然这么有活力了。"
                },
                {
                    "id": "205140405",
                    "speaker": "塞琉斯",
                    "text": "给我打了声招呼之后，就跑过去了。"
                },
                {
                    "id": "205140406",
                    "speaker": "塞琉斯",
                    "text": "这孩子，病是什么时候好的…你有头绪吗？"
                }
            ]
        },
        {
            "id": "2051405",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205140501",
                    "speaker": "安娜",
                    "text": "好高…这里哥哥应该找不到了。"
                },
                {
                    "id": "205140502",
                    "speaker": "Player",
                    "text": "你在这做什么…"
                },
                {
                    "id": "205140503",
                    "speaker": "安娜",
                    "text": "呜哇！你是怎么上来的，怎么一点动静都没有？"
                },
                {
                    "id": "205140504",
                    "speaker": "安娜",
                    "text": "还有，你是怎么找到我的？"
                },
                {
                    "id": "205140505",
                    "speaker": "安娜",
                    "text": "喔，我知道了，一定是塞琉斯先生告诉你的吧。"
                },
                {
                    "id": "205140506",
                    "speaker": "安娜",
                    "text": "他之前很照顾我和哥哥，我路过的时候就和他打了个招呼，他还一副很惊讶的样子呢。"
                },
                {
                    "id": "205140507",
                    "speaker": "安娜",
                    "text": "嗯…我要不要去冒险家协会试试呢，成为一个冒险家，说不定也不错呢…"
                },
                {
                    "id": "205140508",
                    "speaker": "安娜",
                    "text": "什么？哥哥在找我？咦，怎么都这个时间了，完全没有注意到！"
                },
                {
                    "id": "205140509",
                    "speaker": "安娜",
                    "text": "我知道啦，再在这里呆一会，我就会自己回去啦。"
                }
            ]
        },
        {
            "id": "2051406",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205140601",
                    "speaker": "安东尼",
                    "text": "你找到安娜了吗？"
                },
                {
                    "id": "205140602",
                    "speaker": "Player",
                    "text": "安娜在一架风车上。"
                },
                {
                    "id": "205140603",
                    "speaker": "安东尼",
                    "text": "风车？！这丫头是怎么上去的！我马上就去…"
                },
                {
                    "id": "205140604",
                    "speaker": "安东尼",
                    "text": "什么？她说想试试看成为一个冒险家？"
                },
                {
                    "id": "205140605",
                    "speaker": "安东尼",
                    "text": "病还没完全痊愈，她也想得太远了！"
                },
                {
                    "id": "205140606",
                    "speaker": "安东尼",
                    "text": "只要她病好了，她就是想全世界旅行一圈我都没有一点意见。"
                },
                {
                    "id": "205140607",
                    "speaker": "安东尼",
                    "text": "谢谢你，我马上就去找她。病刚好就开始折腾，我非要好好训训她不可…"
                }
            ]
        },
        {
            "id": "2051407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "205140701",
                    "speaker": "安东尼",
                    "text": "等找到安娜了，我一定要好好教训一下她。"
                }
            ]
        },
        {
            "id": "2051408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "205140801",
                    "speaker": "安娜",
                    "text": "这里的风感觉真好，真想再去更远的地方看看哪。"
                }
            ]
        },
        {
            "id": "2051409",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "205140901",
                    "speaker": "塞琉斯",
                    "text": "看起来，那孩子的病已经好了…"
                }
            ]
        }
    ]
}