    "talks": [
        {
            "id": "7550201",
            "objective": "(test)勾爪龙彩蛋对话$HIDDEN",
            "dialogues": [
                {
                    "id": "755020101",
                    "speaker": "「炫彩呆子」",
                    "text": "好啊…你们也来到了「悬木人」的领地…这附近的景色还不错吧？"
                },
                {
                    "id": "755020102",
                    "speaker": "「炫彩呆子」",
                    "text": "从高处环顾四周，能看到不一样的地形…各种事物的轮廓…也会呈现出另一种面貌…"
                },
                {
                    "id": "755020103",
                    "speaker": "「炫彩呆子」",
                    "text": "呼…呼…"
                },
                {
                    "id": "755020104",
                    "speaker": "派蒙",
                    "text": "「炫彩呆子」？没想到你比我们先到，看起来状态还不太好？",
                    "choices": [
                        {
                            "id": "755020105",
                            "text": "气喘吁吁的。",
                            "response": [
                                {
                                    "id": "755020107",
                                    "speaker": "「炫彩呆子」",
                                    "text": "所以我羡慕那些体能无穷无尽的部族战士…涂鸦也是一门体力活，但我们的体力根本不够用…"
                                },
                                {
                                    "id": "755020108",
                                    "speaker": "「炫彩呆子」",
                                    "text": "有的时候，我也觉得匿叶龙是很不错的伙伴，毕竟它们能在落差巨大的地形上轻松穿梭，简直是涂鸦人的福音。"
                                },
                                {
                                    "id": "755020109",
                                    "speaker": "派蒙",
                                    "text": "确实呢，有匿叶龙帮忙的话，旅行会轻松很多…"
                                },
                                {
                                    "id": "755020110",
                                    "speaker": "「炫彩呆子」",
                                    "text": "当然！我完全没有觉得嵴锋龙伙伴不够好，嵴锋龙们能做到的事，也有很多是匿叶龙没法想象的——"
                                },
                                {
                                    "id": "755020111",
                                    "speaker": "「炫彩呆子」",
                                    "text": "比如帮忙挖出地下关键的矿石，制作效果特别棒的颜料…这可是无价之宝！"
                                },
                                {
                                    "id": "755020112",
                                    "speaker": "「炫彩呆子」",
                                    "text": "而且，退一万步来说，伙伴最重要的不是能力，我更看重感情，功利性的目的都闪一边去！"
                                },
                                {
                                    "id": "755020113",
                                    "speaker": "「炫彩呆子」",
                                    "text": "就算爬山涉水累一点，也没什么好抱怨的。我更不会因此想着什么…离开「回声之子」，加入「悬木人」之类的离谱行为。"
                                },
                                {
                                    "id": "755020114",
                                    "speaker": "「炫彩呆子」",
                                    "text": "啊哟…我大概是累晕了，一下子讲了太多话，歇会儿…"
                                },
                                {
                                    "id": "755020115",
                                    "speaker": "派蒙",
                                    "text": "没想到「炫彩呆子」也会有这么正经的时候…现在我们知道你是个讲情义，重视伙伴的人了！"
                                },
                                {
                                    "id": "755020116",
                                    "speaker": "派蒙",
                                    "text": "#我和{NICKNAME}也跟你一样，交朋友的时候，从来不只想着「对方能为我做什么」，一切的开始在于…那什么来着？",
                                    "choices": [
                                        {
                                            "id": "755020117",
                                            "text": "合拍？",
                                            "response": [
                                                {
                                                    "id": "755020119",
                                                    "speaker": "派蒙",
                                                    "text": "唔，差不多是这个意思？"
                                                },
                                                {
                                                    "id": "755020120",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "说到伙伴…「悬木人」有位强大的猎龙人，叫作基尼奇，他的身边就时常跟着一名与众不同的伙伴。"
                                                },
                                                {
                                                    "id": "755020121",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "那个伙伴的色彩异常鲜艳，用枫丹画家的专业名词来形容…呃…饱和度特别高，它才是名副其实的炫彩！"
                                                },
                                                {
                                                    "id": "755020122",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "而且基尼奇本人的打扮也特别前卫，一看就很有艺术天分！"
                                                },
                                                {
                                                    "id": "755020123",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "只可惜，我们联盟的人为了吸引他，在他行动区域附近画上涂鸦，他好像都不怎么在乎，对涂鸦没什么感觉的样子。"
                                                },
                                                {
                                                    "id": "755020124",
                                                    "speaker": "派蒙",
                                                    "text": "涂鸦联盟平常是这样拉人入伙的吗？好像还挺费时费力的…",
                                                    "choices": [
                                                        {
                                                            "id": "755020125",
                                                            "text": "这就是不怎么合拍。",
                                                            "response": [
                                                                {
                                                                    "id": "755020127",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "也对，不强求！"
                                                                },
                                                                {
                                                                    "id": "755020128",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "强大的猎龙人应该只会被强者吸引，就比如你们两位。等你们成为了涂鸦联盟的著名成员，说不定就能让他对涂鸦感兴趣！"
                                                                },
                                                                {
                                                                    "id": "755020129",
                                                                    "speaker": "派蒙",
                                                                    "text": "你的逻辑也有点「前卫」，这种事情，只有以后试试看才知道喔。"
                                                                },
                                                                {
                                                                    "id": "755020130",
                                                                    "speaker": "派蒙",
                                                                    "text": "现在就不要太贪心啦！"
                                                                },
                                                                {
                                                                    "id": "755020131",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "好，这回就听你们的。"
                                                                },
                                                                {
                                                                    "id": "755020132",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "你们可要加油取材，快快积累足够多的灵感啊！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755020126",
                                                            "text": "没缘分就别强求拉。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755020118",
                                            "text": "缘分？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755020106",
                            "text": "爬上爬下不容易吧。"
                        }
                    ]
                }
            ]
        }
    ]
}