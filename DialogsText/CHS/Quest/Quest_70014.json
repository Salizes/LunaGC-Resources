            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700140101",
                    "speaker": "困惑的丘丘人",
                    "text": "Odomu! Ya dala?"
                },
                {
                    "id": "700140102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo, Odomu nye! Muhe mani?"
                },
                {
                    "id": "700140103",
                    "speaker": "困惑的丘丘人",
                    "text": "Mani? Mani! Yoyo mani mi?"
                },
                {
                    "id": "700140104",
                    "speaker": "艾拉·马斯克",
                    "text": "Dada! Muhe mani yeye!"
                },
                {
                    "id": "700140105",
                    "speaker": "困惑的丘丘人",
                    "text": "Dada! Mosi mita!"
                },
                {
                    "id": "700140106",
                    "speaker": "困惑的丘丘人",
                    "text": "Dada odomu! Kundala dada! Kundala zido, mi dada!"
                },
                {
                    "id": "700140107",
                    "speaker": "艾拉·马斯克",
                    "text": "Ya zido? Ye? Mi?"
                },
                {
                    "id": "700140108",
                    "speaker": "困惑的丘丘人",
                    "text": "Mi!"
                },
                {
                    "id": "700140109",
                    "speaker": "艾拉·马斯克",
                    "text": "经过这些天的考察，我想你也知道它的要求了，辛苦你再跑一趟了。"
                },
                {
                    "id": "700140110",
                    "speaker": "艾拉·马斯克",
                    "text": "那家伙的位置已经标在地图上了，接下来希望你能找到一直搜寻的目标吧！"
                },
                {
                    "id": "700140111",
                    "speaker": "困惑的丘丘人",
                    "text": "Dada, Valo!"
                }
            ]
        },
        {
