    "talks": [
        {
            "id": "7351001",
            "objective": "与哈贾娜德对话",
            "dialogues": [
                {
                    "id": "735100101",
                    "speaker": "派蒙",
                    "text": "哈贾娜德，大功告成啦，来听我们的好消息吧！"
                },
                {
                    "id": "735100102",
                    "speaker": "哈贾娜德",
                    "text": "稍等，让我感受一下，你们身上「震沸装置」的信号。"
                },
                {
                    "id": "735100103",
                    "speaker": "哈贾娜德",
                    "text": "啊，这炽热的余温和充满磁性的回响，就像是炼金药剂在火中的合奏，让我兴奋得战栗…"
                },
                {
                    "id": "735100104",
                    "speaker": "哈贾娜德",
                    "text": "简直无懈可击！利用你们提供的数据，我一定能写出最完美的报告！"
                },
                {
                    "id": "735100105",
                    "speaker": "派蒙",
                    "text": "真的吗？我怎么什么都没感觉到？"
                },
                {
                    "id": "735100106",
                    "speaker": "哈贾娜德",
                    "text": "「白色高智能浮游助手单元」，你应该阅读一些…教令院学生深夜语录，拓展你的语言多样性机能！"
                },
                {
                    "id": "735100107",
                    "speaker": "哈贾娜德",
                    "text": "这样一来，你就能理解各种精妙的比喻了，幽默力和抗压力都能超级加倍。"
                },
                {
                    "id": "735100108",
                    "speaker": "派蒙",
                    "text": "#才不要！根本听不懂啦，我哪来的什么压力，{NICKNAME}又不会要求我搞奇怪的研究！"
                },
                {
                    "id": "735100109",
                    "speaker": "派蒙",
                    "text": "你不要支开话题哦，我们按照约定，帮你测试了装置。"
                },
                {
                    "id": "735100110",
                    "speaker": "派蒙",
                    "text": "现在，快乐的发薪时间到了！"
                },
                {
                    "id": "735100111",
                    "speaker": "哈贾娜德",
                    "text": "给你们给你们！难道你们还信不过我吗？"
                },
                {
                    "id": "735100112",
                    "speaker": "派蒙",
                    "text": "咦？这就是五十人份的薪水吗？总感觉和想象的有点出入呢…"
                },
                {
                    "id": "735100113",
                    "speaker": "派蒙",
                    "text": "唔…倒也不是嫌弃太少…",
                    "choices": [
                        {
                            "id": "735100114",
                            "text": "算不上「一大笔摩拉」。",
                            "response": [
                                {
                                    "id": "735100116",
                                    "speaker": "哈贾娜德",
                                    "text": "咦？难道我攒了大半年的这笔钱还不够夸张吗！"
                                },
                                {
                                    "id": "735100117",
                                    "speaker": "哈贾娜德",
                                    "text": "是我低估了佣兵们的赚钱能力？我给佣兵们计划的日薪，和导师每天给我的资金一样多呢！"
                                },
                                {
                                    "id": "735100118",
                                    "speaker": "哈贾娜德",
                                    "text": "我的新导师出手超阔绰，跟着她以后，我每天都能享受一份烤肉卷大餐，资金还有盈余！"
                                },
                                {
                                    "id": "735100119",
                                    "speaker": "哈贾娜德",
                                    "text": "如果在商店买一袋面粉，去野外摘些墩墩桃，打几桶河水一起煮成面糊…一天的资金就够我生活两周。"
                                },
                                {
                                    "id": "735100120",
                                    "speaker": "哈贾娜德",
                                    "text": "余下的钱都可以投入到「震沸合剂」的研究里，这次雇佣佣兵的预算就是这么来的！",
                                    "choices": [
                                        {
                                            "id": "735100121",
                                            "text": "你对食物的要求好低。",
                                            "response": [
                                                {
                                                    "id": "735100123",
                                                    "speaker": "派蒙",
                                                    "text": "哈贾娜德，你到底是怎么撑到今天的…这种日子未免过得也太苦了，要对自己好一点！"
                                                },
                                                {
                                                    "id": "735100124",
                                                    "speaker": "派蒙",
                                                    "text": "一顿大餐，至少是吃烤肉卷到撑才行吧，一份怎么能算数！每天只吃这种面糊的话，也会把身体搞坏的啦！"
                                                },
                                                {
                                                    "id": "735100125",
                                                    "speaker": "哈贾娜德",
                                                    "text": "我明白我明白，我已经过得很好了！有的学生还要倒贴摩拉来完成学业哦，就像我以前那样，更顾不上好好吃饭了。"
                                                },
                                                {
                                                    "id": "735100126",
                                                    "speaker": "哈贾娜德",
                                                    "text": "我现在有了导师批准的预算，每天都能填饱肚子，已经超幸福了！"
                                                },
                                                {
                                                    "id": "735100127",
                                                    "speaker": "Player",
                                                    "text": "完全没明白吧…"
                                                },
                                                {
                                                    "id": "735100128",
                                                    "speaker": "派蒙",
                                                    "text": "想到了！我们就带哈贾娜德去吃顿豪华的饭菜，让她把自己的标准定高一点，至少不要每天都应付了事！"
                                                },
                                                {
                                                    "id": "735100129",
                                                    "speaker": "哈贾娜德",
                                                    "text": "不用不用！哪有让委托人请雇主吃饭的道理！感谢你们对我的关心啦，真的不用担心我！"
                                                },
                                                {
                                                    "id": "735100130",
                                                    "speaker": "哈贾娜德",
                                                    "text": "只要能取得学术进展，证明我的能力，迟早能出人头地！老是吃大餐的生活，可不是我这个阶段该想的事。"
                                                },
                                                {
                                                    "id": "735100131",
                                                    "speaker": "哈贾娜德",
                                                    "text": "不能浪费时间了，我这就回去写报告！"
                                                },
                                                {
                                                    "id": "735100132",
                                                    "speaker": "派蒙",
                                                    "text": "那你也可以拿一点水果和蔬菜回去补充营养，我们经常能找到日落果和卷心菜，包里还有不少！"
                                                },
                                                {
                                                    "id": "735100133",
                                                    "speaker": "哈贾娜德",
                                                    "text": "嘿嘿…呵呵…啊哈哈哈哈哈…我已经能想象导师下巴脱臼的表情了！"
                                                },
                                                {
                                                    "id": "735100134",
                                                    "speaker": "Black Screen",
                                                    "text": "哈贾娜德根本不听派蒙的话，傻笑着跌跌撞撞地离开了…"
                                                },
                                                {
                                                    "id": "735100135",
                                                    "speaker": "派蒙",
                                                    "text": "呃，自顾自地走掉了。"
                                                },
                                                {
                                                    "id": "735100136",
                                                    "speaker": "派蒙",
                                                    "text": "总觉得哈贾娜德这样下去，说不定哪天就会营养不良，饿晕过去呢。",
                                                    "choices": [
                                                        {
                                                            "id": "735100137",
                                                            "text": "她的导师应该会注意到的。",
                                                            "response": [
                                                                {
                                                                    "id": "735100139",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯…按照哈贾娜德的说法，她的导师应该很重视她。"
                                                                },
                                                                {
                                                                    "id": "735100140",
                                                                    "speaker": "派蒙",
                                                                    "text": "只能祝她能顺利完成研究，挣到更多摩拉了，然后过上正常的生活…"
                                                                },
                                                                {
                                                                    "id": "735100141",
                                                                    "speaker": "派蒙",
                                                                    "text": "没准之后还会碰见她，到时候，我们从她那里拿到再多报酬，也不用担心她营养不良！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735100138",
                                                            "text": "希望科研狂人别轻易倒下。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735100122",
                                            "text": "你的生活标准好危险。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735100115",
                            "text": "和期待的有点出入。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7351099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735109901",
                    "speaker": "派蒙",
                    "text": "嗯！这段时间我们好好测试了「震沸装置」，记录的数据应该差不多了。"
                },
                {
                    "id": "735109902",
                    "speaker": "派蒙",
                    "text": "现在就去找哈贾娜德，和她说说我们使用的体验吧！"
                }
            ]
        }
    ]
}