    "talks": [
        {
            "id": "2210701",
            "objective": "与志华对话",
            "dialogues": [
                {
                    "id": "221070101",
                    "speaker": "志华",
                    "text": "「爱情这种东西，远在天边，近在眼前。不需强求，总有一天会自己送到你眼前…」"
                },
                {
                    "id": "221070102",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "221070103",
                    "speaker": "志华",
                    "text": "当然是在说我的爱情运势啊。"
                },
                {
                    "id": "221070104",
                    "speaker": "志华",
                    "text": "这句话，可是绮命姐为我指点的爱情运势，远在天边，近在眼前…"
                },
                {
                    "id": "221070105",
                    "speaker": "志华",
                    "text": "她一定是在暗示我什么，但是到底在暗示什么呢？"
                },
                {
                    "id": "221070106",
                    "speaker": "志华",
                    "text": "我听说书的人说，当人的「运势」到来时，身边的各种事物都会显出征兆来。"
                },
                {
                    "id": "221070107",
                    "speaker": "志华",
                    "text": "我觉得我的「爱情运」已经到了！"
                },
                {
                    "id": "221070108",
                    "speaker": "志华",
                    "text": "你能帮我去周围看看，有什么特别的「征兆」吗？",
                    "choices": [
                        {
                            "id": "221070109",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221070111",
                                    "speaker": "志华",
                                    "text": "那就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "221070110",
                            "text": "你为什么不自己去…",
                            "response": [
                                {
                                    "id": "221070112",
                                    "speaker": "志华",
                                    "text": "所谓「当局者迷，旁观者清」，要是我自己去看的话…"
                                },
                                {
                                    "id": "221070113",
                                    "speaker": "志华",
                                    "text": "无论看见什么，我都会觉得是在暗示我的「爱情运」到来啦。"
                                },
                                {
                                    "id": "221070114",
                                    "speaker": "志华",
                                    "text": "所以，一切都拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
