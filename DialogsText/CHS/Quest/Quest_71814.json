        {
            "id": "7181403",
            "objective": "在南面码头清理水面上的漂浮物",
            "dialogues": [
                {
                    "id": "718140301",
                    "speaker": "大坤",
                    "text": "你们已经清扫完了吗？"
                },
                {
                    "id": "718140302",
                    "speaker": "Player",
                    "text": "发现了这些东西…"
                },
                {
                    "id": "718140303",
                    "speaker": "大坤",
                    "text": "嗯…这些摩拉你就自己收着吧，数量也不太多，就当做你帮忙的报酬吧。"
                },
                {
                    "id": "718140304",
                    "speaker": "大坤",
                    "text": "这个盒子我就不知道是什么了，不然你把它拿给百闻看看吧。"
                },
                {
                    "id": "718140305",
                    "speaker": "大坤",
                    "text": "她就在月海亭那边办公，也许她知道这是什么。"
                }
            ]
        },
        {
            "id": "7181404",
            "objective": "向大坤回报",
            "dialogues": []
        },
        {
            "id": "7181405",
            "objective": "把盒子交给百闻",
            "dialogues": [
                {
                    "id": "718140401",
                    "speaker": "百闻",
                    "text": "您好，有什么事吗？"
                },
                {
                    "id": "718140402",
                    "speaker": "Player",
                    "text": "在海上捡到了这个…"
                },
                {
                    "id": "718140403",
                    "speaker": "百闻",
                    "text": "嗯？请给我看看。"
                },
                {
                    "id": "718140404",
                    "speaker": "百闻",
                    "text": "没错，这确实是群玉阁上的东西。"
                },
                {
                    "id": "718140405",
                    "speaker": "Player",
                    "text": "那具体是…"
                },
                {
                    "id": "718140406",
                    "speaker": "百闻",
                    "text": "是一些文册，还有一些没有审阅过的公文。居然还这么完好，真是出乎意料。"
                },
                {
                    "id": "718140407",
                    "speaker": "百闻",
                    "text": "不过，能找到这些，确实也能节省一点工作量，毕竟现在这个情况，善后工作真是做不完。"
                },
                {
                    "id": "718140408",
                    "speaker": "百闻",
                    "text": "哦对了，谢谢您帮忙把这些拿来，这些给您，就当是谢礼吧。"
                }
            ]
        },
