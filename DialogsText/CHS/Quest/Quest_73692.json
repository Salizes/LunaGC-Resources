    "talks": [
        {
            "id": "7369201",
            "objective": "与帕兹对话",
            "dialogues": [
                {
                    "id": "736920101",
                    "speaker": "帕兹",
                    "text": "啊…你好，旅行者，看样子，你也是来参加学院游乐会的吧。"
                },
                {
                    "id": "736920102",
                    "speaker": "帕兹",
                    "text": "如果有兴趣的话，您愿意来试玩一下我们阿弥利多学院推出的小游戏吗？"
                },
                {
                    "id": "736920103",
                    "speaker": "Player",
                    "text": "是什么小游戏？"
                },
                {
                    "id": "736920104",
                    "speaker": "帕兹",
                    "text": "我们学院在学院游乐会期间推出了小游戏「仿生摹行」。"
                },
                {
                    "id": "736920105",
                    "speaker": "帕兹",
                    "text": "在这个游戏中，我会向您介绍一些动物的规律性行为。"
                },
                {
                    "id": "736920106",
                    "speaker": "帕兹",
                    "text": "当然了，这些「规律性」都经过了我们的简化和概括，很容易理解。"
                },
                {
                    "id": "736920107",
                    "speaker": "帕兹",
                    "text": "您需要做的，就是用这个我们已经准备好的模型来模仿对应动物的行为。",
                    "choices": [
                        {
                            "id": "736920108",
                            "text": "听着还蛮简单的…",
                            "response": [
                                {
                                    "id": "736920110",
                                    "speaker": "帕兹",
                                    "text": "是的。「动物具有规律性的习性」是一句很容易理解和接受的话。"
                                },
                                {
                                    "id": "736920111",
                                    "speaker": "帕兹",
                                    "text": "但在这句看似简单的话背后，却包含着探究不尽的谜题。"
                                },
                                {
                                    "id": "736920112",
                                    "speaker": "帕兹",
                                    "text": "不过…这段时间内，我们就暂时放下学术性的观察眼光，轻松地体会一下动物们的习性吧。",
                                    "choices": [
                                        {
                                            "id": "736920113",
                                            "text": "想要试玩一下。",
                                            "response": [
                                                {
                                                    "id": "736920114",
                                                    "speaker": "帕兹",
                                                    "text": "好的，请您到这边来。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736920115",
                                            "text": "还有别的事。",
                                            "response": [
                                                {
                                                    "id": "736920116",
                                                    "speaker": "帕兹",
                                                    "text": "没关系，这段时间，我的摊位会一直开着，您可以随时来试玩。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736920109",
                            "text": "感觉倒是不难。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7369299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736929901",
                    "speaker": "帕兹",
                    "text": "（如果经费再充足一点，应该能办得更好…）"
                }
            ]
        }
    ]
}