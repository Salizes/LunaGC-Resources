            "dialogues": [
                {
                    "id": "411210401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411210402",
                    "speaker": "莎拉",
                    "text": "是这样吗？好吧，我去找别人帮忙派送…"
                }
            ]
        },
        {
            "id": "4112101",
            "objective": "与莎拉对话",
            "dialogues": [
                {
                    "id": "411210101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411210102",
                    "speaker": "莎拉",
                    "text": "那就拜托你啦。"
                },
                {
                    "id": "411210103",
                    "speaker": "莎拉",
                    "text": "对了，这份蒙德土豆饼刚刚出炉，可要小心点派送。"
                },
                {
                    "id": "411210104",
                    "speaker": "莎拉",
                    "text": "千万<color=#00E1FFFF>别跑太快，别使用风之翼，也不要被卷入战斗中</color>，不然土豆饼说不定会被碰坏的。"
                },
                {
                    "id": "411210105",
                    "speaker": "莎拉",
                    "text": "好了，快点把这道菜送过去吧，凉了就不好吃了。"
                }
            ]
        },
        {
            "id": "4112102",
            "objective": "将餐品送给卖力的西瑞",
            "dialogues": [
                {
                    "id": "411210201",
                    "speaker": "卖力的西瑞",
                    "text": "呃…肚子好饿，我订的餐怎么还没送过来…"
                }
            ]
        },
        {
            "id": "4112103",
            "objective": "与卖力的西瑞对话",
            "dialogues": [
                {
                    "id": "411210601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411210602",
                    "speaker": "卖力的西瑞",
                    "text": "总算送来了，我都要饿死了…"
                },
                {
                    "id": "411210603",
                    "speaker": "卖力的西瑞",
                    "text": "谢谢你，这份土豆饼我收下了。"
                }
            ]
        },
        {
            "id": "4112103",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411210301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411210302",
                    "speaker": "莎拉",
                    "text": "对啊，你就是来帮忙派送订单的人吧，来得刚刚好，我刚把这份蒙德土豆饼做好。"
                },
                {
                    "id": "411210303",
                    "speaker": "莎拉",
                    "text": "订这份土豆饼的人是西瑞先生，他已经预付好了餐费，说自己会在望风角附近等着订单送过去。"
                }
            ]
        },
        {
            "id": "4112105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411210501",
                    "speaker": "卖力的西瑞",
                    "text": "呜…我订的餐什么时候才能送过来呀，我饿得都没力气了…"
                }
            ]
        }
    ]
