        {
            "id": "1909403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190940335",
                    "speaker": "凯亚",
                    "text": "巴顿，结账。"
                }
            ]
        },
        {
            "id": "1909407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190940701",
                    "speaker": "温迪",
                    "text": "…凯亚是个不好应付的人啊，不过免费的酒真好喝。"
                },
                {
                    "id": "190940702",
                    "speaker": "Player",
                    "text": "温迪可以拒绝的。"
                },
                {
                    "id": "190940703",
                    "speaker": "温迪",
                    "text": "虽然不是很明白西风教会在唱诗方面的条条框框，但没关系，只要真心喜欢音乐，我就一定能帮上忙。",
                    "choices": [
                        {
                            "id": "190940704",
                            "text": "听上去还挺需要功夫的…",
                            "response": [
                                {
                                    "id": "190940706",
                                    "speaker": "温迪",
                                    "text": "哎呀，我开心，修女开心，听众也开心，这不是大好事嘛。"
                                }
                            ]
                        },
                        {
                            "id": "190940705",
                            "text": "真的不是为了酒吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1909410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190941001",
                    "speaker": "温迪",
                    "text": "有了！用上这段旋律的话，会更有表现力…"
                }
            ]
        },
        {
            "id": "1909414",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190941401",
                    "speaker": "温迪",
                    "text": "想好了就可以写下来，然后我们再一起讨论。"
                },
                {
                    "id": "190941402",
                    "speaker": "芭芭拉",
                    "text": "我想，歌里可以表达和亲人团聚的幸福。"
                },
                {
                    "id": "190941403",
                    "speaker": "迪奥娜",
                    "text": "是写鱼头汤呢，还是璃月烤鱼呢…"
                }
            ]
        },
        {
            "id": "1909415",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190941501",
                    "speaker": "葛瑞丝",
                    "text": "太谢谢你们了，既然是专业人士，一定能帮上忙。"
                }
            ]
        },
        {
            "id": "1909416",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190941601",
                    "speaker": "梅尔克",
                    "text": "该怎么唱呢…"
                },
                {
                    "id": "190941602",
                    "speaker": "阿尔图",
                    "text": "羁风之人的故乡…这样写你觉得怎么样？"
                },
                {
                    "id": "190941603",
                    "speaker": "葛瑞丝",
                    "text": "不管怎么样，歌里总该提一下巴巴托斯大人吧。"
                }
            ]
        }
    ]
