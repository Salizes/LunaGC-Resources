            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 32,
        "total_speaker_counts": {
            "Player": 7,
            "提米": 25
        }
    },
    "talks": [
        {
            "id": "2004801",
            "objective": "与提米对话",
            "dialogues": [
                {
                    "id": "200480101",
                    "speaker": "提米",
                    "text": "哇啊！又是你！鸽子又全都飞走了！"
                },
                {
                    "id": "200480102",
                    "speaker": "提米",
                    "text": "我还在喂它们呢，你做什么啊？！"
                },
                {
                    "id": "200480103",
                    "speaker": "Player",
                    "text": "抱歉。"
                },
                {
                    "id": "200480104",
                    "speaker": "提米",
                    "text": "妈妈说，歉意要用实际行动来表示。"
                },
                {
                    "id": "200480105",
                    "speaker": "提米",
                    "text": "桥上的鸽子是我的好朋友，我一直在喂它们。"
                },
                {
                    "id": "200480106",
                    "speaker": "提米",
                    "text": "但最近附近的鸭子们经常来抢食物吃，搞得它们谁也吃不饱…"
                },
                {
                    "id": "200480107",
                    "speaker": "提米",
                    "text": "我想请你帮我找三份小麦来，帮我喂下鸭子们，我也会在桥上把鸽子们也喂饱的。"
                },
                {
                    "id": "200480108",
                    "speaker": "提米",
                    "text": "都吃饱了之后，它们一定会友好相处吧。",
                    "choices": [
                        {
                            "id": "200480109",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200480111",
                                    "speaker": "提米",
                                    "text": "那就拜托你啦。"
                                },
                                {
                                    "id": "200480112",
                                    "speaker": "提米",
                                    "text": "好好对待动物的话，你也可以和它们做朋友的。"
                                }
                            ]
                        },
                        {
                            "id": "200480110",
                            "text": "我不太想和鸽子做朋友…",
                            "response": [
                                {
                                    "id": "200480113",
                                    "speaker": "提米",
                                    "text": "无论想不想做朋友…你都要先向它们道歉。"
                                },
                                {
                                    "id": "200480114",
                                    "speaker": "提米",
                                    "text": "所以——快点去找小麦啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004802",
            "objective": "寻找并持有三份小麦",
            "dialogues": [
                {
                    "id": "200480201",
                    "speaker": "提米",
                    "text": "你找到小麦了吗？"
                },
                {
                    "id": "200480202",
                    "speaker": "Player",
                    "text": "找好了。"
                },
                {
                    "id": "200480203",
                    "speaker": "提米",
                    "text": "这些应该就够了。"
                },
                {
                    "id": "200480204",
                    "speaker": "提米",
                    "text": "把这些带到湖边，喂给鸭子们吧。"
                }
            ]
        },
        {
            "id": "2004803",
            "objective": "将小麦交给提米",
            "dialogues": []
        },
        {
            "id": "2004804",
            "objective": "去湖边播撒小麦",
            "dialogues": [
                {
                    "id": "200480401",
                    "speaker": "提米",
                    "text": "你找到小麦了吗？"
                },
                {
                    "id": "200480402",
                    "speaker": "Player",
                    "text": "还正在找。"
                },
                {
                    "id": "200480403",
                    "speaker": "提米",
                    "text": "好吧，一定要在鸭子们回家之前找到啊。"
                },
                {
                    "id": "200480404",
                    "speaker": "提米",
                    "text": "鸽子？鸽子还没来呢，没关系，它们总会来的。"
                }
            ]
        },
        {
            "id": "2004805",
            "objective": "与提米对话",
            "dialogues": [
                {
                    "id": "200480301",
                    "speaker": "提米",
                    "text": "唔，它们吃饱了以后，肯定能和平共处了吧。"
                },
                {
                    "id": "200480302",
                    "speaker": "提米",
                    "text": "下次走过的时候，记得不要再吓到鸽子了，它们好不容易才愿意回来。"
                },
                {
                    "id": "200480303",
                    "speaker": "Player",
                    "text": "知道了…"
                },
                {
                    "id": "200480304",
                    "speaker": "提米",
                    "text": "好啦，我原谅你了。这个给你，我最喜欢吃的蒙德土豆饼。"
                },
                {
                    "id": "200480305",
                    "speaker": "提米",
                    "text": "要对世界保持善意啊…这是妈妈教我的。"
                }
            ]
        },
        {
            "id": "2004806",
            "objective": "与生气的提米对话",
            "dialogues": [
                {
                    "id": "200480601",
                    "speaker": "提米",
                    "text": "你都干了什么啊！我都看见了！鸭子们都…都…"
                },
                {
                    "id": "200480602",
                    "speaker": "Player",
                    "text": "这也是为了鸽子们…"
                },
                {
                    "id": "200480603",
                    "speaker": "提米",
                    "text": "走开啦！我再也不想看见你了！"
                },
                {
                    "id": "200480604",
                    "speaker": "提米",
                    "text": "呜哇——我要回去告诉妈妈！"
                }
            ]
        },
        {
            "id": "2004805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200480501",
                    "speaker": "提米",
                    "text": "鸽子们怎么还不来呢…"
                }
            ]
        }
    ]
}