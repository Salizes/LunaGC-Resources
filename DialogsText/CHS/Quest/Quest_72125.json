    "talks": [
        {
            "id": "7212504",
            "objective": "",
            "dialogues": [
                {
                    "id": "721250401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "721250402",
                    "speaker": "叶名山薰",
                    "text": "嗯，再见。唉…到底哪里能找到花种呢…"
                }
            ]
        },
        {
            "id": "7212501",
            "objective": "",
            "dialogues": [
                {
                    "id": "721250102",
                    "speaker": "叶名山薰",
                    "text": "如果还能再种些花就好了…"
                },
                {
                    "id": "721250103",
                    "speaker": "叶名山薰",
                    "text": "啊，您好！初次见面…请问，你也是回来居住的人吗？抱歉呀，之前我好像没见过你…",
                    "choices": [
                        {
                            "id": "721250104",
                            "text": "回来居住？",
                            "response": [
                                {
                                    "id": "721250105",
                                    "speaker": "叶名山薰",
                                    "text": "嗯，之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。"
                                },
                                {
                                    "id": "721250106",
                                    "speaker": "叶名山薰",
                                    "text": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。"
                                },
                                {
                                    "id": "721250107",
                                    "speaker": "叶名山薰",
                                    "text": "得到许可了之后，我就带着东西，重新回来这里住啦。"
                                },
                                {
                                    "id": "721250108",
                                    "speaker": "叶名山薰",
                                    "text": "但是…和我一样愿意回来住的人，似乎也没多少呢…"
                                },
                                {
                                    "id": "721250115",
                                    "speaker": "叶名山薰",
                                    "text": "不过这也是没办法的事。"
                                },
                                {
                                    "id": "721250116",
                                    "speaker": "叶名山薰",
                                    "text": "毕竟之前「御影炉心」出了那么大的问题，大家都担心这种事还会发生。"
                                },
                                {
                                    "id": "721250117",
                                    "speaker": "Player",
                                    "text": "你不担心吗？"
                                },
                                {
                                    "id": "721250118",
                                    "speaker": "叶名山薰",
                                    "text": "我当然也担心啦…不过我这个人很恋家啦，而且也放心不下我种的那些花，嘿嘿。所以还是决定回来住了。"
                                },
                                {
                                    "id": "721250119",
                                    "speaker": "叶名山薰",
                                    "text": "但是，我之前种在这周围的花果然都枯了啊。现在我也找不到花种，真可惜…"
                                },
                                {
                                    "id": "721250120",
                                    "speaker": "叶名山薰",
                                    "text": "这里很适合种花的，无论播了什么种，都能很快开出一片的花海来。"
                                },
                                {
                                    "id": "721250121",
                                    "speaker": "叶名山薰",
                                    "text": "我之前还移植过外国的花呢，蒙德的小灯草、风车菊和蒲公英，还有璃月的霓裳花我都移植过。"
                                },
                                {
                                    "id": "721250122",
                                    "speaker": "叶名山薰",
                                    "text": "小灯草在夜里可好看了，就是要种在荫凉的地方，还要浇很多水，修剪掉枯掉的叶尖。"
                                },
                                {
                                    "id": "721250123",
                                    "speaker": "叶名山薰",
                                    "text": "风车菊我听说在有风的地方会长得很好，但我觉得，稻妻的风应该比不上蒙德的风…所以我经常过去给它用扇子扇风，不知道是不是真的有用。"
                                },
                                {
                                    "id": "721250124",
                                    "speaker": "叶名山薰",
                                    "text": "蒲公英是最不用担心的，它能自己照顾自己，不过…它太会照顾自己了，总是会长在各种奇怪的地方。"
                                },
                                {
                                    "id": "721250125",
                                    "speaker": "Player",
                                    "text": "呃，那个…"
                                },
                                {
                                    "id": "721250126",
                                    "speaker": "叶名山薰",
                                    "text": "还有璃月的霓裳花，打理霓裳花的叶子可是很麻烦的，那种叫做「鬼兜虫」的虫子总是会赖在霓裳花的花瓣里不走，我只能一个个挑走。"
                                },
                                {
                                    "id": "721250127",
                                    "speaker": "叶名山薰",
                                    "text": "不过，我移植清心倒是失败了，种下去的清心不是长不大，就是枯萎得很快。唉，这世界上有没有那种，无论种什么花都能顺利出花的神奇土地呢…"
                                },
                                {
                                    "id": "721250128",
                                    "speaker": "Player",
                                    "text": "我、我知道了…"
                                },
                                {
                                    "id": "721250129",
                                    "speaker": "叶名山薰",
                                    "text": "还有还有，你知道璃月有一种叫琉璃袋的花吗？那种花可难找了，我拜托了很多人…"
                                },
                                {
                                    "id": "721250130",
                                    "speaker": "叶名山薰",
                                    "text": "啊…"
                                },
                                {
                                    "id": "721250131",
                                    "speaker": "叶名山薰",
                                    "text": "啊！对不起，对不起！我一说起花来就会这样，真的非常抱歉！"
                                },
                                {
                                    "id": "721250132",
                                    "speaker": "Player",
                                    "text": "你、你真是喜欢花啊…"
                                },
                                {
                                    "id": "721250133",
                                    "speaker": "叶名山薰",
                                    "text": "只是稍微研究了一下而已，嘿嘿…但是现在我连花种都没有，连花都不能种了…"
                                }
                            ]
                        },
                        {
                            "id": "721250109",
                            "text": "我不是这里的居民。",
                            "response": [
                                {
                                    "id": "721250110",
                                    "speaker": "叶名山薰",
                                    "text": "欸？是这样吗？我还以为有人和我一样，愿意回来住了呢…"
                                },
                                {
                                    "id": "721250111",
                                    "speaker": "叶名山薰",
                                    "text": "之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。"
                                },
                                {
                                    "id": "721250112",
                                    "speaker": "叶名山薰",
                                    "text": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。"
                                },
                                {
                                    "id": "721250113",
                                    "speaker": "叶名山薰",
                                    "text": "得到许可了之后，我就带着东西，重新回来这里住啦。"
                                },
                                {
                                    "id": "721250114",
                                    "speaker": "叶名山薰",
                                    "text": "但是…和我一样愿意回来住的人，似乎也没多少呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212502",
            "objective": "",
            "dialogues": [
                {
                    "id": "721250501",
                    "speaker": "Player",
                    "text": "这些花种可以用吗？"
                },
                {
                    "id": "721250502",
                    "speaker": "叶名山薰",
                    "text": "这是…可以！当然可以，有了这些种子，我肯定能种出很多花来！"
                },
                {
                    "id": "721250503",
                    "speaker": "叶名山薰",
                    "text": "那、那个，抱歉，请稍等…我得给您点报酬才行…"
                },
                {
                    "id": "721250504",
                    "speaker": "叶名山薰",
                    "text": "这些给您，谢谢您的花种。您过段时间来，肯定能看见很漂亮的花海！"
                }
            ]
        },
        {
            "id": "7212503",
            "objective": "",
            "dialogues": [
                {
                    "id": "721250301",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "721250302",
                    "speaker": "叶名山薰",
                    "text": "我正在想，从哪里才能找到花种，把周围再种上花呢。"
                },
                {
                    "id": "721250303",
                    "speaker": "叶名山薰",
                    "text": "之前因为「御影炉心」的事，住在这座岛上的人都被疏散走了。"
                },
                {
                    "id": "721250304",
                    "speaker": "叶名山薰",
                    "text": "听说「御影炉心」事被解决了之后，我就自己回来了。"
                },
                {
                    "id": "721250305",
                    "speaker": "叶名山薰",
                    "text": "但是，我之前种在这周围的花全都枯萎了，我还找不到花种，真可惜，这周围可是很适合种花的…"
                }
            ]
        },
        {
            "id": "7212502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721250201",
                    "speaker": "叶名山薰",
                    "text": "到底怎么才能找到花种呢…"
                }
            ]
        },
        {
            "id": "7212506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721250601",
                    "speaker": "叶名山薰",
                    "text": "谢谢您帮我找来那些花种，我马上就把它们都播下去。过段时间，这里肯定能开出一片很好看的花。"
                }
            ]
        },
        {
            "id": "7212599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721259901",
                    "speaker": "派蒙",
                    "text": "咦，这是…好大一包花种。不知道是什么花的种子…但总之先拿着吧。"
                }
            ]
        }
    ]
