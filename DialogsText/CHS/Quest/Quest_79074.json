    },
    "talks": [
        {
            "id": "7907401",
            "objective": "与克朗谢对话",
            "dialogues": [
                {
                    "id": "790740101",
                    "speaker": "克朗谢",
                    "text": "瞧，又来了两位勇士！您是想要来挑战「北风吹流」的吗？"
                },
                {
                    "id": "790740102",
                    "speaker": "克朗谢",
                    "text": "来吧，往这边走，我期待着您能飞得比谁都好！",
                    "choices": [
                        {
                            "id": "790740103",
                            "text": "你冷静点！",
                            "response": [
                                {
                                    "id": "790740105",
                                    "speaker": "克朗谢",
                                    "text": "飞行不需要冷静，这位客人。绝对不需要。"
                                },
                                {
                                    "id": "790740106",
                                    "speaker": "克朗谢",
                                    "text": "冷静只会让你对风的感受变迟钝，只有在毫无准备的情况下面对狂风，才能发掘出自己的潜能。"
                                },
                                {
                                    "id": "790740107",
                                    "speaker": "克朗谢",
                                    "text": "如今的飞鼠都太胆小了！完全遗忘了那篇《勇敢的北风》里的教诲！"
                                },
                                {
                                    "id": "790740108",
                                    "speaker": "克朗谢",
                                    "text": "光是站在安全的地方，赞叹着树叶随风起舞的勇气，自己却怯手怯脚，不敢亲自踏进风里。"
                                },
                                {
                                    "id": "790740109",
                                    "speaker": "克朗谢",
                                    "text": "这样下去，我们还怎么和公主殿下一起守护整个王国！真是无理！无理！"
                                },
                                {
                                    "id": "790740110",
                                    "speaker": "派蒙",
                                    "text": "还真是一位有活力的飞鼠呢…"
                                },
                                {
                                    "id": "790740111",
                                    "speaker": "Player",
                                    "text": "看来他确实很喜欢飞行。"
                                },
                                {
                                    "id": "790740112",
                                    "speaker": "克朗谢",
                                    "text": "所以，我就找到了几条吹流格外激烈的风道，并且在里面设置了各类机关。"
                                },
                                {
                                    "id": "790740113",
                                    "speaker": "克朗谢",
                                    "text": "只有最勇敢，最擅长飞行的勇士，才能通过这条风道。"
                                },
                                {
                                    "id": "790740114",
                                    "speaker": "克朗谢",
                                    "text": "二位客人，你们有这个勇气吗？",
                                    "choices": [
                                        {
                                            "id": "790740115",
                                            "text": "想要试试看！",
                                            "response": [
                                                {
                                                    "id": "790740116",
                                                    "speaker": "克朗谢",
                                                    "text": "很好，请跟我来吧，风道就在不远处！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790740117",
                                            "text": "那个…还有别的事…",
                                            "response": [
                                                {
                                                    "id": "790740118",
                                                    "speaker": "克朗谢",
                                                    "text": "怎么？还要做准备吗？好吧，我就在此等待。"
                                                },
                                                {
                                                    "id": "790740119",
                                                    "speaker": "克朗谢",
                                                    "text": "二位客人想要挑战风道的话，尽管来这里找我。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790740104",
                            "text": "我还一句话都没说啊！"
                        }
                    ]
                }
            ]
        }
    ]
}