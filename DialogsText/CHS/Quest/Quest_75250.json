    "talks": [
        {
            "id": "7525001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752500101",
                    "speaker": "Black Screen",
                    "text": "买到玩偶的游客们陆续离开了，这时，有几位不速之客来到了绵驮园——"
                },
                {
                    "id": "752500102",
                    "speaker": "口齿不清的愚人众",
                    "text": "欸…"
                },
                {
                    "id": "752500103",
                    "speaker": "阿罗哈",
                    "text": "昨天来抢劫的愚人众？是你们！你们…你们还想干什么？"
                },
                {
                    "id": "752500104",
                    "speaker": "Player",
                    "text": "有我在，别担心。"
                },
                {
                    "id": "752500105",
                    "speaker": "口齿不清的愚人众",
                    "text": "不…"
                },
                {
                    "id": "752500106",
                    "speaker": "Black Screen",
                    "text": "为首的愚人众摆了摆手，递出了一张纸条。你摊开纸条，上面是歪歪扭扭的几句话——"
                },
                {
                    "id": "752500107",
                    "speaker": "Black Screen",
                    "text": "「我们是『队长』大人的部下…」"
                },
                {
                    "id": "752500108",
                    "speaker": "Black Screen",
                    "text": "「对不起，没办法开口，因为和『队长』大人一起作战时，喉咙受了伤…」"
                },
                {
                    "id": "752500109",
                    "speaker": "Black Screen",
                    "text": "「快要返回至冬，想带走一些纪念品…」"
                },
                {
                    "id": "752500110",
                    "speaker": "Black Screen",
                    "text": "「绵驮兽很好，很和平，希望所有人都是…」"
                },
                {
                    "id": "752500111",
                    "speaker": "Black Screen",
                    "text": "「钱已经付过了，在昨天的口袋里。请给我们三个绵驮玩具，谢谢。」"
                }
            ]
        },
        {
            "id": "7525002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7525003",
            "objective": "为愚人众定制合适颜色的玩具$HIDDEN",
            "dialogues": [
                {
                    "id": "752500301",
                    "speaker": "阿罗哈",
                    "text": "这位客人，你来啦。今天真是有点忙不过来，我们的商品都脱销了，只剩一些半成品。"
                },
                {
                    "id": "752500302",
                    "speaker": "阿罗哈",
                    "text": "您要是不介意…方不方便搭把手？给那些半成品上点色吧。"
                }
            ]
        },
        {
            "id": "7525004",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752500201",
                    "speaker": "Black Screen",
                    "text": "愚人众满足地离开了。"
                }
            ]
        },
        {
            "id": "7525004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752500401",
                    "speaker": "阿罗哈",
                    "text": "就给他们准备对应色彩的玩具吧？这样一定能让他们满意。"
                }
            ]
        }
    ]
}