    "talks": [
        {
            "id": "7220901",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722090101",
                    "speaker": "「寝子」",
                    "text": "今天又是清净的一天啊…"
                },
                {
                    "id": "722090102",
                    "speaker": "「寝子」",
                    "text": "唔喵，汝等来了啊，昨天汝等打扫好屋子之后，奴家睡得很舒服…喵喵…"
                },
                {
                    "id": "722090103",
                    "speaker": "「寝子」",
                    "text": "那两个绿绿的人类，昨天也在神社里悠闲地散步呢。"
                },
                {
                    "id": "722090104",
                    "speaker": "「寝子」",
                    "text": "虽然，除了那两个绿绿的人类之外，还是没有人类来神社参拜…真是奇怪…"
                },
                {
                    "id": "722090105",
                    "speaker": "「寝子」",
                    "text": "不过那两个绿绿的人类散步的时候，似乎对那边的木架子很感兴趣，喵喵。"
                },
                {
                    "id": "722090106",
                    "speaker": "「寝子」",
                    "text": "奴家记得阿响说…那种小木块叫做「绘马」，那个架子叫做「绘马架」，很多来神社的人，都是为了它来的。"
                },
                {
                    "id": "722090107",
                    "speaker": "「寝子」",
                    "text": "唔…人类很喜欢木头吗？来神社的人，往箱子塞钱之后，经常去木头架子摆弄，挂小木头块。"
                },
                {
                    "id": "722090108",
                    "speaker": "Player",
                    "text": "应该不是喜欢木头…"
                },
                {
                    "id": "722090109",
                    "speaker": "「寝子」",
                    "text": "是这样吗？那是人类因为喜欢马吗？",
                    "choices": [
                        {
                            "id": "722090110",
                            "text": "为什么是马…",
                            "response": [
                                {
                                    "id": "722090112",
                                    "speaker": "「寝子」",
                                    "text": "…无论如何，木头架子已经坏掉了，木头片也很少很少。"
                                },
                                {
                                    "id": "722090113",
                                    "speaker": "「寝子」",
                                    "text": "虽然不知道汝等人类和木头、和马有什么关系，总之神社应该要有这个才行。"
                                },
                                {
                                    "id": "722090114",
                                    "speaker": "「寝子」",
                                    "text": "所以说，一定是因为那个架子出了问题，上面的木头也都没了，所以才没人来神社的。"
                                },
                                {
                                    "id": "722090115",
                                    "speaker": "「寝子」",
                                    "text": "所以，奴家要拜托汝，去修好一下那个木头架子。",
                                    "choices": [
                                        {
                                            "id": "722090116",
                                            "text": "交给我们吧。",
                                            "response": [
                                                {
                                                    "id": "722090117",
                                                    "speaker": "派蒙",
                                                    "text": "这么说来…上次我们修理「塞钱箱」用的材料，应该还有多余的吧？"
                                                },
                                                {
                                                    "id": "722090118",
                                                    "speaker": "「寝子」",
                                                    "text": "这种事情奴家可不清楚…汝等人类，怎么这么喜欢木头。"
                                                },
                                                {
                                                    "id": "722090119",
                                                    "speaker": "派蒙",
                                                    "text": "呃…算了…我记得那些材料还有剩下的，我们去周围找找看吧。"
                                                },
                                                {
                                                    "id": "722090120",
                                                    "speaker": "「寝子」",
                                                    "text": "总之，维修架子的事就拜托汝等了，奴家继续留在这里打理神社，喵喵。"
                                                },
                                                {
                                                    "id": "722090129",
                                                    "speaker": "「寝子」",
                                                    "text": "箱子和架子都修好了之后，来神社的人应该会更多吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722090121",
                                            "text": "这绘马架多久没修了？",
                                            "response": [
                                                {
                                                    "id": "722090122",
                                                    "speaker": "「寝子」",
                                                    "text": "好久以前坏的，它比箱子先坏。箱子好久好久好久以前坏的。"
                                                },
                                                {
                                                    "id": "722090123",
                                                    "speaker": "派蒙",
                                                    "text": "根本不知道是什么时候坏的嘛…"
                                                },
                                                {
                                                    "id": "722090124",
                                                    "speaker": "「寝子」",
                                                    "text": "毕竟，奴家才不会特意去数太阳升起了多少次，又落下了多少次。"
                                                },
                                                {
                                                    "id": "722090125",
                                                    "speaker": "派蒙",
                                                    "text": "无论如何，上次我们修理「塞钱箱」用的材料，应该还有多余的吧？"
                                                },
                                                {
                                                    "id": "722090126",
                                                    "speaker": "「寝子」",
                                                    "text": "这种事情奴家可不清楚…汝等人类，怎么这么喜欢木头。"
                                                },
                                                {
                                                    "id": "722090127",
                                                    "speaker": "派蒙",
                                                    "text": "呃…算了…我记得那些材料还有剩下的，我们去周围找找看吧。"
                                                },
                                                {
                                                    "id": "722090128",
                                                    "speaker": "「寝子」",
                                                    "text": "总之，维修架子的事就拜托汝等了，奴家继续留在这里打理神社，喵喵。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722090111",
                            "text": "和马也没关系…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220902",
            "objective": "调查绘马架",
            "dialogues": [
                {
                    "id": "722090201",
                    "speaker": "大祐",
                    "text": "那个绘马架看起来已经坏了很久了啊…"
                },
                {
                    "id": "722090202",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "722090203",
                    "speaker": "大祐",
                    "text": "喔，旅行者。我和悦子小姐正在这神社周围做调查呢。"
                },
                {
                    "id": "722090204",
                    "speaker": "大祐",
                    "text": "虽然这神社里的各个设施都破落得不成样子了…但这些设施还真是齐全啊。"
                },
                {
                    "id": "722090205",
                    "speaker": "大祐",
                    "text": "附近村里的人都会来这里参拜吧。看来神社的荒废，或许和越石村废村也有关系…"
                }
            ]
        },
        {
            "id": "7220903",
            "objective": "修理绘马架",
            "dialogues": [
                {
                    "id": "722090301",
                    "speaker": "「寝子」",
                    "text": "喵喵喵，那个木头架子…"
                },
                {
                    "id": "722090302",
                    "speaker": "Player",
                    "text": "已经修好了。"
                },
                {
                    "id": "722090303",
                    "speaker": "「寝子」",
                    "text": "喔！真是不错，这样子神社也更像样了，喵喵！"
                },
                {
                    "id": "722090304",
                    "speaker": "「寝子」",
                    "text": "汝再去和那两个绿色的人类说一声吧，告诉他们，那个架子已经修好了，他们可以去挂小木块了。然后，也可以让其他人类来神社，然后塞钱。"
                },
                {
                    "id": "722090305",
                    "speaker": "Player",
                    "text": "你为什么不自己去？"
                },
                {
                    "id": "722090306",
                    "speaker": "「寝子」",
                    "text": "那、那个绿色的，高高的人类很可怕，他很了解猫的心思…可以轻而易举地看穿奴家，喵喵！"
                },
                {
                    "id": "722090307",
                    "speaker": "「寝子」",
                    "text": "而且奴家每次和他说话的时候，他都很激动…喵喵…"
                }
            ]
        },
        {
            "id": "7220904",
            "objective": "与寝子对话",
            "dialogues": []
        },
        {
            "id": "7220905",
            "objective": "与大祐对话",
            "dialogues": [
                {
                    "id": "722090401",
                    "speaker": "大祐",
                    "text": "喔，你好，旅行者，找我有什么事吗？"
                },
                {
                    "id": "722090402",
                    "speaker": "Player",
                    "text": "绘马架已经修好了喔。"
                },
                {
                    "id": "722090403",
                    "speaker": "大祐",
                    "text": "欸？是你修好的吗？你还真是热心啊…"
                },
                {
                    "id": "722090404",
                    "speaker": "Player",
                    "text": "是代宫司大人的委托。"
                },
                {
                    "id": "722090405",
                    "speaker": "大祐",
                    "text": "是、是寝子大人亲自委托你的吗！？"
                },
                {
                    "id": "722090406",
                    "speaker": "大祐",
                    "text": "难道是寝子大人注意到了我们的行动了？",
                    "choices": [
                        {
                            "id": "722090407",
                            "text": "也不完全是啦…",
                            "response": [
                                {
                                    "id": "722090409",
                                    "speaker": "大祐",
                                    "text": "悦子小姐！我们去绘马架那边看看吧！"
                                },
                                {
                                    "id": "722090410",
                                    "speaker": "悦子",
                                    "text": "先是塞钱箱，然后是绘马架…"
                                },
                                {
                                    "id": "722090411",
                                    "speaker": "悦子",
                                    "text": "这位代宫司大人，是认真想要整修这个神社吗…"
                                },
                                {
                                    "id": "722090412",
                                    "speaker": "悦子",
                                    "text": "但是，这周围的居民已经在很久之前都全部迁移走了。"
                                },
                                {
                                    "id": "722090413",
                                    "speaker": "悦子",
                                    "text": "换句话说，现在这座岛上除了我们之外，已经没有人会来神社参拜了。"
                                },
                                {
                                    "id": "722090414",
                                    "speaker": "大祐",
                                    "text": "悦子小姐，你想说什么？"
                                },
                                {
                                    "id": "722090415",
                                    "speaker": "悦子",
                                    "text": "那位代宫司大人，到底有没有意识到这件事呢？它整修这座神社的目的又到底是…"
                                },
                                {
                                    "id": "722090416",
                                    "speaker": "悦子",
                                    "text": "…抱歉，也许是我多疑了。去绘马架那边看看应该也没什么问题。"
                                },
                                {
                                    "id": "722090417",
                                    "speaker": "悦子",
                                    "text": "但总之，提高警惕总没错。"
                                },
                                {
                                    "id": "722090418",
                                    "speaker": "大祐",
                                    "text": "悦子小姐，寝子大人只是一只猫啦…"
                                }
                            ]
                        },
                        {
                            "id": "722090408",
                            "text": "这么说也没错…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220906",
            "objective": "与悦子对话",
            "dialogues": [
                {
                    "id": "722090501",
                    "speaker": "悦子",
                    "text": "这绘马架修得还真不错…你手艺可真好。",
                    "choices": [
                        {
                            "id": "722090502",
                            "text": "谢谢。",
                            "response": [
                                {
                                    "id": "722090504",
                                    "speaker": "悦子",
                                    "text": "不过这上面的绘马…已经完全看不清楚了，到底是过了多久…"
                                },
                                {
                                    "id": "722090505",
                                    "speaker": "大祐",
                                    "text": "悦子小姐！你看，我从旁边找到了几块木板，削了几块…呃…绘马。"
                                },
                                {
                                    "id": "722090506",
                                    "speaker": "大祐",
                                    "text": "既然这绘马架已经修好了，当然要往上面挂绘马啦，嘿嘿。"
                                },
                                {
                                    "id": "722090507",
                                    "speaker": "大祐",
                                    "text": "悦子小姐，你有什么愿望吗？我可以帮你画的。"
                                },
                                {
                                    "id": "722090508",
                                    "speaker": "悦子",
                                    "text": "在这个神社里挂绘马啊…"
                                },
                                {
                                    "id": "722090509",
                                    "speaker": "悦子",
                                    "text": "呵呵，感觉还真奇妙…把绘马给我，我来画吧。"
                                },
                                {
                                    "id": "722090510",
                                    "speaker": "派蒙",
                                    "text": "他们似乎已经在准备挂绘马了。"
                                },
                                {
                                    "id": "722090511",
                                    "speaker": "派蒙",
                                    "text": "我们回去告诉寝子吧，它一定会很高兴的。"
                                }
                            ]
                        },
                        {
                            "id": "722090503",
                            "text": "一点小手艺。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220907",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "722090601",
                    "speaker": "「寝子」",
                    "text": "奴家已经看见那两个绿绿的人类开始挂绘马了，汝等，真是可靠啊。"
                },
                {
                    "id": "722090602",
                    "speaker": "「寝子」",
                    "text": "那两个人类挂好绘马之后，肯定会告诉其他人类，那些人类肯定会来神社的。"
                },
                {
                    "id": "722090603",
                    "speaker": "「寝子」",
                    "text": "喵喵喵…除了那个箱子和「打扫」之外…这个这个架子果然也很重要啊。"
                },
                {
                    "id": "722090604",
                    "speaker": "「寝子」",
                    "text": "真不错，真不错，喵喵喵，照这样下去，神社一定会重新变得热闹的。"
                },
                {
                    "id": "722090605",
                    "speaker": "Player",
                    "text": "你为什么要重修神社？"
                },
                {
                    "id": "722090606",
                    "speaker": "「寝子」",
                    "text": "唔喵，为什么呢…因为奴家是这座神社的代宫司，必须要照顾好这座神社呢，让很多人来神社参拜，让神社变得热热闹闹的。"
                },
                {
                    "id": "722090607",
                    "speaker": "「寝子」",
                    "text": "还有，要是阿响回来的时候看见神社破破烂烂的，她一定会难过的…"
                },
                {
                    "id": "722090608",
                    "speaker": "「寝子」",
                    "text": "喵喵，但现在有了你帮忙，神社一定会很快恢复气派的。"
                },
                {
                    "id": "722090609",
                    "speaker": "「寝子」",
                    "text": "过段时间，说不定奴家还要请汝等帮忙，汝等可千万不要推辞啊，喵喵。"
                }
            ]
        },
        {
            "id": "7220907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722090701",
                    "speaker": "「寝子」",
                    "text": "拜托汝等去和那两个绿绿的人类说一声吧。那个架子已经修好了，可以往上面挂小木块了。"
                },
                {
                    "id": "722090702",
                    "speaker": "「寝子」",
                    "text": "喵喵…要是他们能告诉更多的人，箱子和架子都已经修好了这件事，也许就会有更多的人来神社了…"
                }
            ]
        },
        {
            "id": "7220908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722090801",
                    "speaker": "悦子",
                    "text": "愿望…呵呵，就写…「希望可以舒适地生活」好了。"
                }
            ]
        },
        {
            "id": "7220909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722090901",
                    "speaker": "大祐",
                    "text": "写什么好呢？呃…成为一个成功的冒险家怎么样…"
                }
            ]
        },
        {
            "id": "7220910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722091001",
                    "speaker": "「寝子」",
                    "text": "过段时间，说不定奴家还要请汝等帮忙，请千万不要推辞啊，喵喵。"
                }
            ]
        },
        {
            "id": "7220911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722091101",
                    "speaker": "悦子",
                    "text": "你好，有什么事吗？"
                },
                {
                    "id": "722091102",
                    "speaker": "Player",
                    "text": "你们在做什么呢？"
                },
                {
                    "id": "722091103",
                    "speaker": "悦子",
                    "text": "在这神社周围做调查…呵呵，这是大祐的想法。"
                },
                {
                    "id": "722091104",
                    "speaker": "悦子",
                    "text": "对我来说，我只不过是在这里稍微偷一下懒而已。"
                }
            ]
        }
    ]
}