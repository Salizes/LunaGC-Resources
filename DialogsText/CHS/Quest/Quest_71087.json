    "talks": [
        {
            "id": "7108701",
            "objective": "隐藏瑾武送汤$HIDDEN",
            "dialogues": [
                {
                    "id": "710380601",
                    "speaker": "瑾武",
                    "text": "海迪夫给她开了些药…志琼恢复了一点意识，但她什么也不愿意跟我说。"
                },
                {
                    "id": "710380602",
                    "speaker": "瑾武",
                    "text": "你们知道她是怎么回事吗？好好的一个人，怎么会变成这样？"
                },
                {
                    "id": "710380603",
                    "speaker": "Player",
                    "text": "我们发现她时，她被困在了黑泥里。"
                },
                {
                    "id": "710380604",
                    "speaker": "派蒙",
                    "text": "对呀对呀，幸好我们及时把她救出来了！"
                },
                {
                    "id": "710380605",
                    "speaker": "瑾武",
                    "text": "……"
                },
                {
                    "id": "710380606",
                    "speaker": "瑾武",
                    "text": "算了，志琼现在最需要休息。请替我把这碗汤趁热递给她吧。"
                },
                {
                    "id": "710380607",
                    "speaker": "瑾武",
                    "text": "虽然不太会做饭，照顾矿工的事情反正我也没少做过。还没人敢嫌弃我的手艺。"
                },
                {
                    "id": "710380608",
                    "speaker": "瑾武",
                    "text": "好了，去吧，看看志琼好些了吗。"
                },
                {
                    "id": "710380609",
                    "speaker": "瑾武",
                    "text": "我需要跟沐宁反映一下，志琼不能留在地下了。"
                }
            ]
        }
    ]
}