    "talks": [
        {
            "id": "7180401",
            "objective": "与伊凡诺维奇对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7180402",
            "objective": "抄写有关新经营许可证的公告",
            "dialogues": [
                {
                    "id": "718040201",
                    "speaker": "公告板",
                    "text": "此乃绯云坡公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。",
                    "choices": [
                        {
                            "id": "718040202",
                            "text": "关于总务司人事调动的说明…",
                            "response": [
                                {
                                    "id": "718040203",
                                    "speaker": "公告板",
                                    "text": "「总务司人事调动公示如下…」"
                                },
                                {
                                    "id": "718040204",
                                    "speaker": "派蒙",
                                    "text": "等一下，总务司的人事调动应该跟经营许可证没有关系吧。"
                                }
                            ]
                        },
                        {
                            "id": "718040205",
                            "text": "关于绯云坡水源污染问题的情况通报…",
                            "response": [
                                {
                                    "id": "718040206",
                                    "speaker": "公告板",
                                    "text": "「关于绯云坡近来水源污染一事…」"
                                },
                                {
                                    "id": "718040207",
                                    "speaker": "派蒙",
                                    "text": "伊凡诺维奇先生急着办事呢，我们没有时间关心水源污染问题啦。"
                                }
                            ]
                        },
                        {
                            "id": "718040208",
                            "text": "关于新版经营许可证的申请…",
                            "response": [
                                {
                                    "id": "718040209",
                                    "speaker": "公告板",
                                    "text": "「如需申请新版经营许可证，需有如下手续…」"
                                },
                                {
                                    "id": "718040210",
                                    "speaker": "派蒙",
                                    "text": "这应该就是伊凡诺维奇先生想要申请的新版经营许可证了，我们赶快抄下来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180403",
            "objective": "与伊凡诺维奇对话",
            "dialogues": [
                {
                    "id": "718040301",
                    "speaker": "伊凡诺维奇",
                    "text": "你找到关于新版经营许可证的公告了吗？"
                },
                {
                    "id": "718040302",
                    "speaker": "Player",
                    "text": "已经抄下来了。"
                },
                {
                    "id": "718040303",
                    "speaker": "伊凡诺维奇",
                    "text": "太好了，我来仔细看看…"
                },
                {
                    "id": "718040304",
                    "speaker": "伊凡诺维奇",
                    "text": "出海申请批复件，经营场所证明及经营安全许诺书和…还有旧的经营许可证…"
                },
                {
                    "id": "718040305",
                    "speaker": "伊凡诺维奇",
                    "text": "还好，还好，这几份文件我前几天刚刚跑去签好了，可把我跑得够呛。"
                },
                {
                    "id": "718040306",
                    "speaker": "伊凡诺维奇",
                    "text": "旅行者，麻烦你再帮我跑一趟，把这些文件分别交上去吧。"
                },
                {
                    "id": "718040307",
                    "speaker": "伊凡诺维奇",
                    "text": "咳咳…可能要交的人有点多…"
                },
                {
                    "id": "718040308",
                    "speaker": "伊凡诺维奇",
                    "text": "呃，首先，<color=#00E1FFFF>出海申请批复件</color>交给小安，<color=#00E1FFFF>经营场所证明及经营安全许诺书</color>交给千岩军嘉义…"
                },
                {
                    "id": "718040309",
                    "speaker": "伊凡诺维奇",
                    "text": "还有<color=#00E1FFFF>旧的经营许可</color>，去交给小昭就可以了。"
                },
                {
                    "id": "718040310",
                    "speaker": "伊凡诺维奇",
                    "text": "旅行者，就拜托你再帮我跑跑了，我一定会准备好足够的报酬。"
                },
                {
                    "id": "718040311",
                    "speaker": "Player",
                    "text": "好吧，好吧…"
                },
                {
                    "id": "718040312",
                    "speaker": "伊凡诺维奇",
                    "text": "希望跑完这些手续之后，我就不用再跑了…"
                },
                {
                    "id": "718040313",
                    "speaker": "Player",
                    "text": "希望以后不用跑了。"
                },
                {
                    "id": "718040314",
                    "speaker": "伊凡诺维奇",
                    "text": "你之后应该不用跑这种手续了，但是我嘛…在这里做生意，之后免不了还得跑。"
                },
                {
                    "id": "718040315",
                    "speaker": "伊凡诺维奇",
                    "text": "唉，虽然这种办事方式确实让人安心，但如果能再简化一些就更好了。"
                }
            ]
        },
        {
            "id": "7180404",
            "objective": "将相应材料交给小安",
            "dialogues": [
                {
                    "id": "718040401",
                    "speaker": "小安",
                    "text": "这份材料的手续怎么又不全…"
                },
                {
                    "id": "718040402",
                    "speaker": "Player",
                    "text": "关于伊凡诺维奇的新版经营许可证…"
                },
                {
                    "id": "718040403",
                    "speaker": "小安",
                    "text": "伊凡诺维奇…哦，之前他来过几趟，我有印象。"
                },
                {
                    "id": "718040404",
                    "speaker": "小安",
                    "text": "他是在跑新版经营许可证的手续吗？哈哈…那他估计跑得够呛…"
                },
                {
                    "id": "718040405",
                    "speaker": "小安",
                    "text": "你是来帮他代办的吧，<color=#00E1FFFF>出海申请批复件</color>带来了吗？我上次和他说了，他的手续不全，得去其他地方补一下…"
                }
            ]
        },
        {
            "id": "7180447",
            "objective": "将相应材料交给小安",
            "dialogues": [
                {
                    "id": "718044701",
                    "speaker": "小安",
                    "text": "我看看…这材料不对啊，我这里只处理海事司负责的业务，其他的材料不归我管。"
                }
            ]
        },
        {
            "id": "7180444",
            "objective": "将相应材料交给小安",
            "dialogues": [
                {
                    "id": "718044401",
                    "speaker": "小安",
                    "text": "我看看…这材料不对啊，我这里只处理海事司负责的业务，其他的材料不归我管。"
                }
            ]
        },
        {
            "id": "7180434",
            "objective": "将相应材料交给小安",
            "dialogues": [
                {
                    "id": "718043401",
                    "speaker": "小安",
                    "text": "我看看…嗯，这样应该就可以了，那这份文件我收下了。"
                }
            ]
        },
        {
            "id": "7180405",
            "objective": "将相应材料交给嘉义",
            "dialogues": [
                {
                    "id": "718040501",
                    "speaker": "嘉义",
                    "text": "请保持秩序，保持秩序！",
                    "choices": [
                        {
                            "id": "718040502",
                            "text": "关于伊凡诺维奇的新版经营许可证…",
                            "response": [
                                {
                                    "id": "718040503",
                                    "speaker": "嘉义",
                                    "text": "啊？你是来帮人代办的吧，那你把经营场所证明…和那什么来着？哦…经营安全许诺书，都带来了吗？"
                                }
                            ]
                        },
                        {
                            "id": "718040504",
                            "text": "你在负责经营许可证的事？",
                            "response": [
                                {
                                    "id": "718040505",
                                    "speaker": "嘉义",
                                    "text": "没有，没有。我只是临时过来帮忙的，小昭那边文件收不过来了，我暂时先来帮忙收一下，归个档。"
                                },
                                {
                                    "id": "718040506",
                                    "speaker": "嘉义",
                                    "text": "嗨，这活干得真是头晕…好了，你把经营场所证明，还有经营安全许诺书带来了吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180445",
            "objective": "将相应材料交给嘉义",
            "dialogues": [
                {
                    "id": "718044501",
                    "speaker": "嘉义",
                    "text": "你交的这个不对啊，我这边只收经营场所证明及经营安全许诺书。"
                }
            ]
        },
        {
            "id": "7180435",
            "objective": "将相应材料交给嘉义",
            "dialogues": [
                {
                    "id": "718043501",
                    "speaker": "嘉义",
                    "text": "行，我先把这些文件收着吧。等会我就交给小昭去。"
                }
            ]
        },
        {
            "id": "7180446",
            "objective": "请在白天工作时间找小昭办理业务",
            "dialogues": []
        },
        {
            "id": "7180406",
            "objective": "将相应材料交给小昭",
            "dialogues": [
                {
                    "id": "718040601",
                    "speaker": "小昭",
                    "text": "你好，有什么要提交的材料，或者有什么要问的吗？"
                },
                {
                    "id": "718040602",
                    "speaker": "Player",
                    "text": "关于伊凡诺维奇的新版经营许可证…"
                },
                {
                    "id": "718040603",
                    "speaker": "小昭",
                    "text": "你是帮他代办新的经营许可证吧，那伊凡诺维奇的<color=#00E1FFFF>旧经营许可证</color>带来了吗？"
                },
                {
                    "id": "718040604",
                    "speaker": "小昭",
                    "text": "带来的话就给我吧，要换成新经营许可证的话，旧的那张必须回收才行。"
                }
            ]
        },
        {
            "id": "7180436",
            "objective": "将相应材料交给小昭",
            "dialogues": [
                {
                    "id": "718043601",
                    "speaker": "小昭",
                    "text": "嗯，没错，那这张旧经营许可证我就收下了。"
                },
                {
                    "id": "718043602",
                    "speaker": "小昭",
                    "text": "还有其他的相关文件和材料，你都提交好了吗？如果没提交好的话，说不定过几天你又得再跑一趟了。"
                },
                {
                    "id": "718043603",
                    "speaker": "Player",
                    "text": "都提交了。"
                },
                {
                    "id": "718043604",
                    "speaker": "小昭",
                    "text": "好，如果材料齐全合规的话，新版经营许可证应该很快就能办下来了。"
                },
                {
                    "id": "718043605",
                    "speaker": "小昭",
                    "text": "办下来了之后，我会让人去通知伊凡诺维奇过来取的。"
                }
            ]
        },
        {
            "id": "7180407",
            "objective": "向伊凡诺维奇回报",
            "dialogues": [
                {
                    "id": "718040701",
                    "speaker": "伊凡诺维奇",
                    "text": "你把材料都提交好了吗？"
                },
                {
                    "id": "718040702",
                    "speaker": "Player",
                    "text": "都提交好了。"
                },
                {
                    "id": "718040703",
                    "speaker": "伊凡诺维奇",
                    "text": "呼，那太好了，只要新版经营许可证批下来，我就能接着在这做生意了。"
                },
                {
                    "id": "718040704",
                    "speaker": "伊凡诺维奇",
                    "text": "谢谢你帮我跑这一趟，实在是太感谢了，这是给你的报酬。"
                },
                {
                    "id": "718040705",
                    "speaker": "伊凡诺维奇",
                    "text": "希望以后不用再跑这么多手续了，真是…太让人疲惫了…"
                }
            ]
        },
        {
            "id": "7180451",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718045101",
                    "speaker": "伊凡诺维奇",
                    "text": "总算能歇一会了，再跑一天…我估计我非昏倒在地上不可…",
                    "choices": [
                        {
                            "id": "718045102",
                            "text": "怎么会有这么多手续？",
                            "response": [
                                {
                                    "id": "718045103",
                                    "speaker": "伊凡诺维奇",
                                    "text": "哈哈哈，毕竟在璃月港里「契约」是重点嘛。"
                                },
                                {
                                    "id": "718045104",
                                    "speaker": "伊凡诺维奇",
                                    "text": "大事小情，总要落个白纸黑字才能让人安心不是？"
                                },
                                {
                                    "id": "718045105",
                                    "speaker": "伊凡诺维奇",
                                    "text": "虽然…这些白纸实在是太多了，我头都要晕了…"
                                }
                            ]
                        },
                        {
                            "id": "718045106",
                            "text": "至冬国会这样吗？",
                            "response": [
                                {
                                    "id": "718045107",
                                    "speaker": "伊凡诺维奇",
                                    "text": "你说办事的方式吗？那还是有点不一样的…"
                                },
                                {
                                    "id": "718045108",
                                    "speaker": "伊凡诺维奇",
                                    "text": "唔，具体怎么个不一样法，光是说也说不清。"
                                },
                                {
                                    "id": "718045109",
                                    "speaker": "伊凡诺维奇",
                                    "text": "以后你要是有机会去至冬，就自己去感受一下吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180453",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718045301",
                    "speaker": "伊凡诺维奇",
                    "text": "唉，虽然这种办事方式确实让人安心，但如果能再简化一些就更好了。"
                }
            ]
        },
        {
            "id": "7180454",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718045401",
                    "speaker": "小安",
                    "text": "这个得盖章，这个缺证明，这个信息不全…"
                },
                {
                    "id": "718045402",
                    "speaker": "小安",
                    "text": "唉，这些又得送回去…"
                }
            ]
        },
        {
            "id": "7180455",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718045501",
                    "speaker": "嘉义",
                    "text": "这么多材料，这么多文件，要是弄混了可怎么办…"
                }
            ]
        },
        {
            "id": "7180456",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718045601",
                    "speaker": "小昭",
                    "text": "这些手续应该都齐全了…"
                }
            ]
        }
    ]
}