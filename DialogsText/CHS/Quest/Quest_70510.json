    "talks": [
        {
            "id": "7051001",
            "objective": "与卢卡对话",
            "dialogues": [
                {
                    "id": "705100401",
                    "speaker": "卢卡",
                    "text": "哎呀呀…这几天，酒馆里的人可以说是络绎不绝啊。"
                },
                {
                    "id": "705100402",
                    "speaker": "卢卡",
                    "text": "有冲着酒来的，更多的还是冲着你来的。"
                },
                {
                    "id": "705100403",
                    "speaker": "派蒙",
                    "text": "这话…听着怎么那么奇怪。"
                },
                {
                    "id": "705100404",
                    "speaker": "卢卡",
                    "text": "我还没见过那么成功的「酒保体验周」活动，这下生意和口碑都有了。"
                },
                {
                    "id": "705100405",
                    "speaker": "卢卡",
                    "text": "总之…干得漂亮，伙计。"
                },
                {
                    "id": "705100406",
                    "speaker": "派蒙",
                    "text": "才几天，怎么就变成伙计了啦！",
                    "choices": [
                        {
                            "id": "705100407",
                            "text": "某种意义上…",
                            "response": [
                                {
                                    "id": "705100409",
                                    "speaker": "卢卡",
                                    "text": "我说，要不要留下来接着干？"
                                },
                                {
                                    "id": "705100410",
                                    "speaker": "派蒙",
                                    "text": "#这可不行。虽然无限畅饮的诱惑力很大，但我可是答应过，要陪{M#他}{F#她}一直旅行下去的。"
                                },
                                {
                                    "id": "705100411",
                                    "speaker": "卢卡",
                                    "text": "好吧，那就不勉强啦，毕竟查尔斯也跟我说过这一点…"
                                },
                                {
                                    "id": "705100412",
                                    "speaker": "卢卡",
                                    "text": "总之，有机会的话，常来「天使的馈赠」坐坐，带上朋友一起！"
                                },
                                {
                                    "id": "705100413",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "705100414",
                                    "speaker": "卢卡",
                                    "text": "再见啦，祝你们一路顺利。"
                                }
                            ]
                        },
                        {
                            "id": "705100408",
                            "text": "他也没说错…"
                        }
                    ]
                }
            ]
        },
