        {
            "id": "7608915",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7608916",
            "objective": "继续向前探索",
            "dialogues": []
        },
        {
            "id": "7608917",
            "objective": "借助小右的能力，使画中空间复原",
            "dialogues": []
        },
        {
            "id": "7608918",
            "objective": "与枫丹人对话",
            "dialogues": [
                {
                    "id": "760891801",
                    "speaker": "「莫基」",
                    "text": "你们好。我是画家埃舍尔。"
                },
                {
                    "id": "760891802",
                    "speaker": "派蒙",
                    "text": "哦哦，你就是伊斯托利亚说的那个画出来的画很奇妙的「莫基」？"
                },
                {
                    "id": "760891803",
                    "speaker": "派蒙",
                    "text": "我想起来了，我们是不是见过？"
                },
                {
                    "id": "760891804",
                    "speaker": "「莫基」",
                    "text": "我出生就叫埃舍尔。"
                },
                {
                    "id": "760891805",
                    "speaker": "派蒙",
                    "text": "是吗，你有没有突然失踪的哥哥之类的？"
                },
                {
                    "id": "760891806",
                    "speaker": "「莫基」",
                    "text": "没有。"
                },
                {
                    "id": "760891807",
                    "speaker": "「莫基」",
                    "text": "请随我来，我带你们去安全的地方。"
                },
                {
                    "id": "760891808",
                    "speaker": "派蒙",
                    "text": "可是我们不是要去安全的地方啊。我们是来解决这里的问题的。"
                },
                {
                    "id": "760891809",
                    "speaker": "「莫基」",
                    "text": "是吗，那也请随我来。我来带你们去解决问题。"
                },
                {
                    "id": "760891810",
                    "speaker": "派蒙",
