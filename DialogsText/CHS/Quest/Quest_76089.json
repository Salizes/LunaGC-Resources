    "talks": [
        {
            "id": "7608901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760890101",
                    "speaker": "道子",
                    "text": "哦哦，久等了。看来你们也很顺利嘛。"
                },
                {
                    "id": "760890102",
                    "speaker": "派蒙",
                    "text": "道子，我和你说，我们遇到了一个假的埃舍尔。"
                },
                {
                    "id": "760890103",
                    "speaker": "Black Screen",
                    "text": "和道子说了刚才遇到的事情…"
                },
                {
                    "id": "760890104",
                    "speaker": "道子",
                    "text": "哼。应该是梅兰塔亲自干预了吧。"
                },
                {
                    "id": "760890105",
                    "speaker": "道子",
                    "text": "在他眼里，名字只是我们来到这里时被打的标签，和一串数字无异。"
                },
                {
                    "id": "760890106",
                    "speaker": "道子",
                    "text": "他哪里会知道，「莫基」是埃舍尔小时候祖父和父亲对他的爱称。"
                },
                {
                    "id": "760890107",
                    "speaker": "派蒙",
                    "text": "因为这里的大家关系都很好，所以才都叫他「莫基」啊。"
                },
                {
                    "id": "760890108",
                    "speaker": "道子",
                    "text": "虽然我们对他的画都有一些…感到震撼。但是我们并不讨厌他啊。"
                },
                {
                    "id": "760890109",
                    "speaker": "道子",
                    "text": "玩弄空间在这里可是了不得的大问题。"
                },
                {
                    "id": "760890110",
                    "speaker": "派蒙",
                    "text": "真想知道他画了什么。"
                },
                {
                    "id": "760890111",
                    "speaker": "道子",
                    "text": "有机会你们会看到的。"
                },
                {
                    "id": "760890112",
                    "speaker": "道子",
                    "text": "好了，既然联画皆在此处，尚缺一笔连通，就让我露拙，来一笔添足吧。"
                },
                {
                    "id": "760890113",
                    "speaker": "道子",
                    "text": "狩野的璃月山水画可是我指点过的。加这一笔，他不会怪我的。"
                },
                {
                    "id": "760890114",
                    "speaker": "道子",
                    "text": "通过这幅画，应该就可以去中央的丹青院了。"
                },
                {
                    "id": "760890115",
                    "speaker": "道子",
                    "text": "进去之后，且试伸手摘那天心。"
                },
                {
                    "id": "760890116",
                    "speaker": "道子",
                    "text": "突然想到，画蛇添足也是画龙，画龙点睛也是画龙。"
                },
                {
                    "id": "760890117",
                    "speaker": "道子",
                    "text": "意思却天差地别呢。"
                },
                {
                    "id": "760890118",
                    "speaker": "派蒙",
                    "text": "确实。"
                }
            ]
        },
        {
            "id": "7608933",
            "objective": "前往麓阳书院",
            "dialogues": []
        },
        {
            "id": "7608902",
            "objective": "调查奇怪的墨渍",
            "dialogues": [
                {
                    "id": "760890201",
                    "speaker": "道子",
                    "text": "且伸手，碰那画作。破却一层幻，回那器世间。"
                },
                {
                    "id": "760890202",
                    "speaker": "派蒙",
                    "text": "呃，你在说什么啊？"
                },
                {
                    "id": "760890203",
                    "speaker": "道子",
                    "text": "我是说，摸一下那幅画就能回去了。虽然外面也只是另一层虚幻罢了。"
                }
            ]
        },
        {
            "id": "7608903",
            "objective": "在房间内调查",
            "dialogues": [
                {
                    "id": "760890701",
                    "speaker": "派蒙",
                    "text": "#打不开。{NICKNAME}，你用力踹一下试试？"
                },
                {
                    "id": "760890702",
                    "speaker": "Player",
                    "text": "（用力踹）"
                },
                {
                    "id": "760890703",
                    "speaker": "派蒙",
                    "text": "怎么样？"
                },
                {
                    "id": "760890704",
                    "speaker": "Player",
                    "text": "麻。"
                },
                {
                    "id": "760890705",
                    "speaker": "派蒙",
                    "text": "噗。"
                }
            ]
        },
        {
            "id": "7608935",
            "objective": "在房间内调查",
            "dialogues": []
        },
        {
            "id": "7608904",
            "objective": "调查微缩景观",
            "dialogues": [
                {
                    "id": "760890401",
                    "speaker": "道子",
                    "text": "触碰这屏风应该就可以了。"
                },
                {
                    "id": "760890402",
                    "speaker": "道子",
                    "text": "之后，且试摘星。"
                }
            ]
        },
        {
            "id": "7608928",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7608905",
            "objective": "调查奇怪的墨渍",
            "dialogues": [
                {
                    "id": "760890501",
                    "speaker": "彩特琳德",
                    "text": "这些照片…"
                },
                {
                    "id": "760890502",
                    "speaker": "道子",
                    "text": "啊，这些是留影机画的吧。"
                },
                {
                    "id": "760890503",
                    "speaker": "道子",
                    "text": "当时你姐姐和我们说有一种东西能画出比最写实的画都逼真的图案。"
                },
                {
                    "id": "760890504",
                    "speaker": "道子",
                    "text": "我们都很感兴趣。"
                },
                {
                    "id": "760890505",
                    "speaker": "道子",
                    "text": "但是她当时手头没有留影机也没有机器画出来的画片。"
                },
                {
                    "id": "760890506",
                    "speaker": "道子",
                    "text": "如今看到了，确实惟妙惟肖啊。"
                },
                {
                    "id": "760890507",
                    "speaker": "派蒙",
                    "text": "哼哼，有没有扬眉吐气。写实被机器走到尽头了，写意还有无穷空间。"
                },
                {
                    "id": "760890508",
                    "speaker": "道子",
                    "text": "这话不对哦。哪怕是写实的画作，里面仍然有画家的情绪与审美。"
                },
                {
                    "id": "760890509",
                    "speaker": "道子",
                    "text": "有些颜色是现实里不会出现的，但是这种用色让你可以察觉到画家的心。"
                },
                {
                    "id": "760890510",
                    "speaker": "道子",
                    "text": "哪怕是最写实的画作，细枝末节里也有虚构、夸张、模糊的成分，这都是审美与技法。"
                },
                {
                    "id": "760890511",
                    "speaker": "派蒙",
                    "text": "好啦，我也不是不懂啊。只是想夸你几句，好之后求你给我们画画而已。",
                    "choices": [
                        {
                            "id": "760890512",
                            "text": "不是有阿贝多的画了吗？",
                            "response": [
                                {
                                    "id": "760890513",
                                    "speaker": "派蒙",
                                    "text": "我想看看写意的我是什么样的嘛。"
                                },
                                {
                                    "id": "760890518",
                                    "speaker": "彩特琳德",
                                    "text": "谢谢你们。"
                                },
                                {
                                    "id": "760890519",
                                    "speaker": "派蒙",
                                    "text": "彩特琳德，我能看看吗？"
                                },
                                {
                                    "id": "760890520",
                                    "speaker": "彩特琳德",
                                    "text": "嗯，都是些姐姐旅游时候的风景照。"
                                },
                                {
                                    "id": "760890521",
                                    "speaker": "彩特琳德",
                                    "text": "她委托的路人留影技术真烂啊。有的照片就最下面给她露了个脑袋。"
                                },
                                {
                                    "id": "760890522",
                                    "speaker": "道子",
                                    "text": "但是她笑得很开心啊。"
                                },
                                {
                                    "id": "760890523",
                                    "speaker": "彩特琳德",
                                    "text": "让你见笑了。姐姐这些照片光影、构图都很烂吧。毫无距离感、层次感。"
                                },
                                {
                                    "id": "760890524",
                                    "speaker": "道子",
                                    "text": "不会啊。我觉得这些是最好的…呃，画片了。"
                                },
                                {
                                    "id": "760890525",
                                    "speaker": "道子",
                                    "text": "如果不是你姐姐坚持要露一个脑袋，这些画片就只是最烂的风景画…啊，风景照。"
                                },
                                {
                                    "id": "760890526",
                                    "speaker": "道子",
                                    "text": "但是因为有她在，这些东西就是回忆与证明。她曾在此。"
                                },
                                {
                                    "id": "760890527",
                                    "speaker": "彩特琳德",
                                    "text": "…我有些明白了。"
                                },
                                {
                                    "id": "760890528",
                                    "speaker": "彩特琳德",
                                    "text": "我的东西已经找到了，让我们继续帮助道子吧。"
                                },
                                {
                                    "id": "760890529",
                                    "speaker": "道子",
                                    "text": "我想，那边的画作应该就能通往锦栖筑，你们试试看那里能不能通明光楼吧。"
                                },
                                {
                                    "id": "760890530",
                                    "speaker": "道子",
                                    "text": "接下来我就先不随诸位一起去了。"
                                },
                                {
                                    "id": "760890531",
                                    "speaker": "道子",
                                    "text": "我且回中央的区域和大家报一声平安。然后我会立刻赶回来的。"
                                },
                                {
                                    "id": "760890532",
                                    "speaker": "道子",
                                    "text": "不论此番事成与否，算算时间，等我回来应该差不多能再见上。"
                                }
                            ]
                        },
                        {
                            "id": "760890514",
                            "text": "能带下去吗？",
                            "response": [
                                {
                                    "id": "760890515",
                                    "speaker": "道子",
                                    "text": "我觉得应该是带不出去的。不然你们把我的画卖了定能赚好多摩拉。"
                                },
                                {
                                    "id": "760890516",
                                    "speaker": "派蒙",
                                    "text": "好多摩拉！难道你是历史有名的大画家？"
                                },
                                {
                                    "id": "760890517",
                                    "speaker": "道子",
                                    "text": "「我来看看。嗯，这竟然是上周画出来的云来道玄真迹！」"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7608906",
            "objective": "借助小右的能力，使画中空间复原",
            "dialogues": [
                {
                    "id": "760890601",
                    "speaker": "伊斯托利亚",
                    "text": "看起来很顺利啊。"
                },
                {
                    "id": "760890602",
                    "speaker": "派蒙",
                    "text": "伊斯托利亚，你怎么来了？"
                },
                {
                    "id": "760890603",
                    "speaker": "伊斯托利亚",
                    "text": "道子和我说了一声你们来到麓阳书院了。我就和他一起过来了。"
                },
                {
                    "id": "760890604",
                    "speaker": "伊斯托利亚",
                    "text": "怎么样，这次的东西找到了吗，彩特琳德？"
                },
                {
                    "id": "760890605",
                    "speaker": "彩特琳德",
                    "text": "已经找到了。"
                },
                {
                    "id": "760890606",
                    "speaker": "伊斯托利亚",
                    "text": "这次落到麓阳书院的是什么东西呢？这里毕竟是画匠们的领域。"
                },
                {
                    "id": "760890607",
                    "speaker": "伊斯托利亚",
                    "text": "我确实猜不到这里会有什么东西。"
                },
                {
                    "id": "760890608",
                    "speaker": "彩特琳德",
                    "text": "是姐姐的留影机相片。"
                },
                {
                    "id": "760890609",
                    "speaker": "伊斯托利亚",
                    "text": "留影机…听人们说到过这个东西。"
                },
                {
                    "id": "760890610",
                    "speaker": "派蒙",
                    "text": "哼哼，你落时了。画师们都听彩特琳德的姐姐说过留影机呢。"
                },
                {
                    "id": "760890611",
                    "speaker": "伊斯托利亚",
                    "text": "因为这里的人搞的是视觉艺术嘛。和他们聊这个很正常。"
                },
                {
                    "id": "760890612",
                    "speaker": "伊斯托利亚",
                    "text": "希尔妲和我聊的最多的是…哲学。"
                },
                {
                    "id": "760890613",
                    "speaker": "派蒙",
                    "text": "哲学！"
                },
                {
                    "id": "760890614",
                    "speaker": "彩特琳德",
                    "text": "很难想象我的姐姐和你这样博学的人聊这个的情景。"
                },
                {
                    "id": "760890615",
                    "speaker": "伊斯托利亚",
                    "text": "哪里哪里。我们也不会做很深刻复杂的思辨。无非是从身边的事情聊聊如何思考罢了。"
                },
                {
                    "id": "760890616",
                    "speaker": "伊斯托利亚",
                    "text": "比如，人活在世界上最根本的哲学问题，就是明天要不要自杀。"
                },
                {
                    "id": "760890617",
                    "speaker": "派蒙",
                    "text": "啊？"
                },
                {
                    "id": "760890618",
                    "speaker": "彩特琳德",
                    "text": "……"
                },
                {
                    "id": "760890619",
                    "speaker": "伊斯托利亚",
                    "text": "我来解释一下。我们试图研究世界，某种意义上是对世界寻找意义。"
                },
                {
                    "id": "760890620",
                    "speaker": "伊斯托利亚",
                    "text": "我们是众神膝畔的孩童也好、我们是无常的时间风中的回音也好。"
                },
                {
                    "id": "760890621",
                    "speaker": "伊斯托利亚",
                    "text": "这些都太远了。一般人如何拿自己与世界对等呢？普通人的世界无非就是他的生活。"
                },
                {
                    "id": "760890622",
                    "speaker": "伊斯托利亚",
                    "text": "如果有一天，我们发现了遥远未来一切必定归于虚无，我们现在的生活还有意义吗？"
                },
                {
                    "id": "760890623",
                    "speaker": "伊斯托利亚",
                    "text": "或者我们的生活本来就是一滩无涯的苦海，那世界其实也就是痛苦的集合。"
                },
                {
                    "id": "760890624",
                    "speaker": "伊斯托利亚",
                    "text": "这两种情况下，活与不活没有差别。后者甚至可以说是解脱。"
                },
                {
                    "id": "760890625",
                    "speaker": "派蒙",
                    "text": "我…我觉得这样不对。虽然我也不知道怎么去反驳。"
                },
                {
                    "id": "760890626",
                    "speaker": "彩特琳德",
                    "text": "我姐姐是怎么回答的？"
                },
                {
                    "id": "760890627",
                    "speaker": "伊斯托利亚",
                    "text": "别提了。我才是辩论里那个说「人生就算没意义也要活下去」的人。"
                },
                {
                    "id": "760890628",
                    "speaker": "彩特琳德",
                    "text": "啊，您还不知道。"
                },
                {
                    "id": "760890629",
                    "speaker": "彩特琳德",
                    "text": "在疗养院里，我见到了姐姐的墓碑。"
                },
                {
                    "id": "760890630",
                    "speaker": "伊斯托利亚",
                    "text": "……"
                },
                {
                    "id": "760890631",
                    "speaker": "彩特琳德",
                    "text": "谢谢您在最后，还尝试去救她。"
                },
                {
                    "id": "760890632",
                    "speaker": "伊斯托利亚",
                    "text": "她的墓志铭，写了什么吗？"
                },
                {
                    "id": "760890633",
                    "speaker": "彩特琳德",
                    "text": "「只活一次不算数。」"
                },
                {
                    "id": "760890634",
                    "speaker": "伊斯托利亚",
                    "text": "是吗？"
                },
                {
                    "id": "760890635",
                    "speaker": "伊斯托利亚",
                    "text": "是吗。"
                },
                {
                    "id": "760890636",
                    "speaker": "派蒙",
                    "text": "彩特琳德…"
                },
                {
                    "id": "760890637",
                    "speaker": "伊斯托利亚",
                    "text": "我难以相信，我也想要说些什么安慰你。"
                },
                {
                    "id": "760890638",
                    "speaker": "伊斯托利亚",
                    "text": "请给我点时间。"
                },
                {
                    "id": "760890639",
                    "speaker": "彩特琳德",
                    "text": "安慰就不必了。"
                },
                {
                    "id": "760890640",
                    "speaker": "彩特琳德",
                    "text": "我见到姐姐的墓碑，本以为自己会哭出来。结果我反而异常平静。"
                },
                {
                    "id": "760890641",
                    "speaker": "彩特琳德",
                    "text": "哭出来可能会好点吧。"
                },
                {
                    "id": "760890642",
                    "speaker": "伊斯托利亚",
                    "text": "我要说的不是这种安慰。"
                },
                {
                    "id": "760890643",
                    "speaker": "伊斯托利亚",
                    "text": "之后你会明白的。"
                }
            ]
        },
        {
            "id": "7608907",
            "objective": "继续向前探索",
            "dialogues": []
        },
        {
            "id": "7608908",
            "objective": "继续向前探索",
            "dialogues": [
                {
                    "id": "760890801",
                    "speaker": "「莫基」",
                    "text": "你们好。我是画家埃舍尔。"
                },
                {
                    "id": "760890802",
                    "speaker": "派蒙",
                    "text": "哦哦，你就是伊斯托利亚说的那个画出来的画很奇妙的「莫基」？"
                },
                {
                    "id": "760890803",
                    "speaker": "「莫基」",
                    "text": "我出生就叫埃舍尔。"
                },
                {
                    "id": "760890804",
                    "speaker": "「莫基」",
                    "text": "请随我来，我带你们去安全的地方。"
                },
                {
                    "id": "760890805",
                    "speaker": "派蒙",
                    "text": "可是我们不是要去安全的地方啊。我们是来解决这里的问题的。"
                },
                {
                    "id": "760890806",
                    "speaker": "「莫基」",
                    "text": "是吗，那也请随我来。我来带你们去解决问题。"
                }
            ]
        },
        {
            "id": "7608909",
            "objective": "击败守护者",
            "dialogues": [
                {
                    "id": "760890901",
                    "speaker": "派蒙",
                    "text": "这些瓜…"
                },
                {
                    "id": "760890902",
                    "speaker": "博斯",
                    "text": "嗯嗯。"
                },
                {
                    "id": "760890903",
                    "speaker": "派蒙",
                    "text": "熟吗？"
                },
                {
                    "id": "760890904",
                    "speaker": "博斯",
                    "text": "啊？"
                },
                {
                    "id": "760890905",
                    "speaker": "派蒙",
                    "text": "我问你这些瓜熟了吗？"
                },
                {
                    "id": "760890906",
                    "speaker": "博斯",
                    "text": "这不重要。"
                },
                {
                    "id": "760890907",
                    "speaker": "博斯",
                    "text": "琳德，我们曾经一起教你姐姐画过画。"
                },
                {
                    "id": "760890908",
                    "speaker": "彩特琳德",
                    "text": "是姐姐的署名。"
                },
                {
                    "id": "760890909",
                    "speaker": "博斯",
                    "text": "既然是你姐姐的东西，你就带走吧。我想这个应该是可以带走的。"
                },
                {
                    "id": "760890910",
                    "speaker": "彩特琳德",
                    "text": "在诸位看来，这幅画怎么样？"
                },
                {
                    "id": "760890911",
                    "speaker": "博斯",
                    "text": "怎么说呢。有人十多岁就能如大师一般画得好，所以他一生都在追求孩童一般的画。"
                },
                {
                    "id": "760890912",
                    "speaker": "博斯",
                    "text": "希尔妲的画既没有大师风范，也没有儿童般的意趣。"
                },
                {
                    "id": "760890913",
                    "speaker": "博斯",
                    "text": "但是里面却有一丝哀伤。"
                },
                {
                    "id": "760890914",
                    "speaker": "派蒙",
                    "text": "画水果画出来的哀伤不是很厉害吗？"
                },
                {
                    "id": "760890915",
                    "speaker": "劳姆希尔妲",
                    "text": "什么啊，你们说这画失去了孩童趣味也无大师风范？"
                },
                {
                    "id": "760890916",
                    "speaker": "道子",
                    "text": "大师风范毕竟需要天分和刻苦的练习嘛。"
                },
                {
                    "id": "760890917",
                    "speaker": "道子",
                    "text": "要、要不你忘了我们教的东西，再画一幅？"
                },
                {
                    "id": "760890918",
                    "speaker": "劳姆希尔妲",
                    "text": "笑死我了，你们这群人。"
                },
                {
                    "id": "760890919",
                    "speaker": "劳姆希尔妲",
                    "text": "不画了不画了。我已经体验过画画了，还蛮有趣的。"
                },
                {
                    "id": "760890920",
                    "speaker": "劳姆希尔妲",
                    "text": "但是已经画好的画布变不回纯白，学到的东西也没办法再忘掉。"
                },
                {
                    "id": "760890921",
                    "speaker": "劳姆希尔妲",
                    "text": "庸凡之作就继续庸凡吧。"
                },
                {
                    "id": "760890922",
                    "speaker": "彩特琳德",
                    "text": "是吗，只是个平庸之作啊。"
                },
                {
                    "id": "760890923",
                    "speaker": "彩特琳德",
                    "text": "她还是署名了。"
                },
                {
                    "id": "760890924",
                    "speaker": "博斯",
                    "text": "是的。我们画师有时候接委托，都会用秘密签名的技法署名。"
                },
                {
                    "id": "760890925",
                    "speaker": "博斯",
                    "text": "所以她给这幅画取名《生命万岁》之后就离开了。"
                },
                {
                    "id": "760890926",
                    "speaker": "芳年",
                    "text": "怎么样？你要带走姐姐的画吗？"
                },
                {
                    "id": "760890927",
                    "speaker": "彩特琳德",
                    "text": "不了，就留在这里吧。"
                },
                {
                    "id": "760890928",
                    "speaker": "彩特琳德",
                    "text": "这样的画流落人间可能百年不到就丢失损毁了，在你们这里还能得到一种永恒。"
                },
                {
                    "id": "760890929",
                    "speaker": "道子",
                    "text": "我明白了。"
                }
            ]
        },
        {
            "id": "7608910",
            "objective": "借助小右的能力，使画中空间复原",
            "dialogues": [
                {
                    "id": "760891001",
                    "speaker": "芳年",
                    "text": "话说我怎么没看到莫基？他最后是被困在「沙上楼阁」那里了吗？"
                },
                {
                    "id": "760891002",
                    "speaker": "道子",
                    "text": "你们这些人就是心思坏。把他哄去建筑区做什么。"
                },
                {
                    "id": "760891003",
                    "speaker": "芳年",
                    "text": "我们也不是排挤他啊，只是想让他把空间错乱的震撼给最讲究空间的「沙上楼阁」兄弟们体会一下。"
                },
                {
                    "id": "760891004",
                    "speaker": "道子",
                    "text": "玩弄空间可能会毁坏这里的规则，他或许被梅兰塔强制流放了吧。"
                }
            ]
        },
        {
            "id": "7608911",
            "objective": "与被解放者对话",
            "dialogues": [
                {
                    "id": "760891101",
                    "speaker": "道子",
                    "text": "哈哈哈。珉地重山压不住，破开叠云始见天。我道子自由了！"
                },
                {
                    "id": "760891102",
                    "speaker": "道子",
                    "text": "谢谢你们，希尔妲、小右，还有新来的朋友们。"
                },
                {
                    "id": "760891103",
                    "speaker": "彩特琳德",
                    "text": "我是她的妹妹彩特琳德。"
                },
                {
                    "id": "760891104",
                    "speaker": "道子",
                    "text": "是吗，你们长得真像啊。"
                },
                {
                    "id": "760891105",
                    "speaker": "彩特琳德",
                    "text": "是的，经常有人这么说。"
                },
                {
                    "id": "760891106",
                    "speaker": "道子",
                    "text": "这两位呢？"
                },
                {
                    "id": "760891107",
                    "speaker": "派蒙",
                    "text": "#我叫派蒙，这位是{NICKNAME}。是伊斯托利亚委托我们来的。"
                },
                {
                    "id": "760891108",
                    "speaker": "道子",
                    "text": "既然是如此，基本的事情我就不解释了。两位可懂拳脚把式？最好能打赢雷穆利亚督军那种。"
                },
                {
                    "id": "760891109",
                    "speaker": "派蒙",
                    "text": "这又是个什么描述啊？"
                },
                {
                    "id": "760891110",
                    "speaker": "道子",
                    "text": "啊，因为雷穆利亚灭亡之时，有个边境要塞被提了上来。"
                },
                {
                    "id": "760891111",
                    "speaker": "道子",
                    "text": "很久之后又来了个自称古华派代掌门的老头。"
                },
                {
                    "id": "760891112",
                    "speaker": "道子",
                    "text": "有一天他们发生了一点争端。"
                },
                {
                    "id": "760891113",
                    "speaker": "道子",
                    "text": "雷穆利亚那个指挥官说自己是军队里管音乐的，代掌门以为他很弱。"
                },
                {
                    "id": "760891114",
                    "speaker": "道子",
                    "text": "其实雷穆利亚军队里越懂音乐官职越大。何况他还石头化了。"
                },
                {
                    "id": "760891115",
                    "speaker": "道子",
                    "text": "哦，不知道你们知不知道这么个事：雷穆利亚核心圈的人都被弄成了灵露，成为了半永生石头人。"
                },
                {
                    "id": "760891116",
                    "speaker": "道子",
                    "text": "代掌门一个发劲把自己手打疼了。"
                },
                {
                    "id": "760891117",
                    "speaker": "派蒙",
                    "text": "呃。"
                },
                {
                    "id": "760891118",
                    "speaker": "道子",
                    "text": "然后代掌门抛下狠话。说自己这一代古华绝学不继，人才凋敝。自己也没神之眼啥的。"
                },
                {
                    "id": "760891119",
                    "speaker": "道子",
                    "text": "——不过有神之眼的话也不会被提选了。"
                },
                {
                    "id": "760891120",
                    "speaker": "道子",
                    "text": "经历了无想之间的折磨，我们也没办法再获得神之眼了。此乃闲话。"
                },
                {
                    "id": "760891121",
                    "speaker": "道子",
                    "text": "那个指挥官也反抛狠话，说雷穆利亚的督军比他厉害多了。"
                },
                {
                    "id": "760891122",
                    "speaker": "派蒙",
                    "text": "#好吧，真是个有趣的故事啊。我只知道{NICKNAME}肯定有这个实力。",
                    "choices": [
                        {
                            "id": "760891123",
                            "text": "没这么弱。",
                            "response": [
                                {
                                    "id": "760891125",
                                    "speaker": "道子",
                                    "text": "哈哈哈哈，那太好了。"
                                },
                                {
                                    "id": "760891126",
                                    "speaker": "派蒙",
                                    "text": "话说，你为什么在画里啊？还有那些人型墨渍都是什么啊？"
                                },
                                {
                                    "id": "760891127",
                                    "speaker": "道子",
                                    "text": "这便是此地梅兰塔降下谪罚的形式：把人封入画中，压为墨渍。"
                                },
                                {
                                    "id": "760891128",
                                    "speaker": "道子",
                                    "text": "像是我的牢笼，还被层层画作嵌套。"
                                },
                                {
                                    "id": "760891129",
                                    "speaker": "派蒙",
                                    "text": "所以，我们之前看到的墨渍都是…人？"
                                },
                                {
                                    "id": "760891130",
                                    "speaker": "道子",
                                    "text": "是的。"
                                },
                                {
                                    "id": "760891131",
                                    "speaker": "道子",
                                    "text": "我得提醒一下。"
                                },
                                {
                                    "id": "760891132",
                                    "speaker": "道子",
                                    "text": "越写实的画作越是方便作为心之依处，毕竟能让人一眼理解画的是什么。"
                                },
                                {
                                    "id": "760891133",
                                    "speaker": "道子",
                                    "text": "所以这里的看起来很写实的画都有可能暗藏玄机。"
                                },
                                {
                                    "id": "760891134",
                                    "speaker": "派蒙",
                                    "text": "那我们接下来要做什么啊？"
                                },
                                {
                                    "id": "760891135",
                                    "speaker": "道子",
                                    "text": "此处不是说话的地方，先回去吧。"
                                }
                            ]
                        },
                        {
                            "id": "760891124",
                            "text": "低调低调。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7608912",
            "objective": "调查画作",
            "dialogues": []
        },
        {
            "id": "7608930",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7608913",
            "objective": "与同行者对话",
            "dialogues": [
                {
                    "id": "760891301",
                    "speaker": "派蒙",
                    "text": "居然真的一下就回来了。"
                },
                {
                    "id": "760891302",
                    "speaker": "彩特琳德",
                    "text": "这个地方当真很神奇。"
                },
                {
                    "id": "760891303",
                    "speaker": "道子",
                    "text": "确有奥妙。恰如帝君的创龙点睛得助力。"
                },
                {
                    "id": "760891304",
                    "speaker": "道子",
                    "text": "看起来很真的画，在这里是可以凭借心的力量变现为真的。"
                },
                {
                    "id": "760891305",
                    "speaker": "派蒙",
                    "text": "那下一步我们要做什么？"
                },
                {
                    "id": "760891306",
                    "speaker": "道子",
                    "text": "恢复整个书院的重要环节当是要点那明星一笔，在那之前需要复原这幅画。"
                },
                {
                    "id": "760891307",
                    "speaker": "道子",
                    "text": "《天心既出四至皆白屏风》。"
                },
                {
                    "id": "760891308",
                    "speaker": "派蒙",
                    "text": "好、好气魄的名字。"
                },
                {
                    "id": "760891309",
                    "speaker": "道子",
                    "text": "他们稻妻人取名字就这样。"
                },
                {
                    "id": "760891310",
                    "speaker": "道子",
                    "text": "理论上去到明光楼应该就可以把这幅画缺的部分补全。"
                },
                {
                    "id": "760891311",
                    "speaker": "道子",
                    "text": "如今四路不通，八方不达。似乎只能去锦栖筑看看能不能取道明光楼了。"
                },
                {
                    "id": "760891312",
                    "speaker": "派蒙",
                    "text": "居然是这扇门后面吗？"
                },
                {
                    "id": "760891313",
                    "speaker": "派蒙",
                    "text": "#我之前让至少开山移海级的{NICKNAME}全力踹了一脚都没踹开。"
                },
                {
                    "id": "760891314",
                    "speaker": "道子",
                    "text": "你脚麻吗？"
                },
                {
                    "id": "760891315",
                    "speaker": "Player",
                    "text": "麻。"
                },
                {
                    "id": "760891316",
                    "speaker": "道子",
                    "text": "大概是因为这门是借画凭心而生的，不算一般意义上的物质吧。"
                },
                {
                    "id": "760891317",
                    "speaker": "道子",
                    "text": "伊斯托利亚说他有个老师叫亚里斯多克勒斯，总说「心胜于物」，大概这就是原因吧。"
                },
                {
                    "id": "760891318",
                    "speaker": "道子",
                    "text": "开山移海啊…那不是和若陀一样厉害。说到这个——"
                },
                {
                    "id": "760891319",
                    "speaker": "道子",
                    "text": "大方广之馆的虞黄衣和我说，在他的年代，若陀就已经存在了。"
                },
                {
                    "id": "760891320",
                    "speaker": "道子",
                    "text": "所以创龙点睛只是后人的故事罢了。「不过，确实是个好故事。」"
                },
                {
                    "id": "760891321",
                    "speaker": "派蒙",
                    "text": "那你恍然大悟了吗？"
                },
                {
                    "id": "760891322",
                    "speaker": "道子",
                    "text": "我对他说：「你这个家伙，毁了我的感动。」"
                },
                {
                    "id": "760891323",
                    "speaker": "彩特琳德",
                    "text": "能够理解。"
                },
                {
                    "id": "760891324",
                    "speaker": "道子",
                    "text": "唉，怎么说呢，你们就当个趣事听听吧。画门还需画师开。我去开门了。"
                },
                {
                    "id": "760891325",
                    "speaker": "彩特琳德",
                    "text": "你好像不是很惊讶。"
                },
                {
                    "id": "760891326",
                    "speaker": "派蒙",
                    "text": "#那是因为{NICKNAME}的经历更加神奇呀。"
                },
                {
                    "id": "760891327",
                    "speaker": "彩特琳德",
                    "text": "你是经历过许多非凡冒险的人呢。拯救过世界我也不奇怪。"
                },
                {
                    "id": "760891328",
                    "speaker": "派蒙",
                    "text": "#{F#她}{M#他}和{F#哥哥}{M#妹妹}被很坏很坏的神明分开了。"
                },
                {
                    "id": "760891329",
                    "speaker": "派蒙",
                    "text": "#我们的冒险主要就是在找{F#她}{M#他}丢失的血亲。"
                },
                {
                    "id": "760891330",
                    "speaker": "派蒙",
                    "text": "#所以{NICKNAME}多少也是能理解你的。"
                },
                {
                    "id": "760891331",
                    "speaker": "彩特琳德",
                    "text": "祝你最终可以找到血亲，平安幸福地活下去。"
                },
                {
                    "id": "760891332",
                    "speaker": "派蒙",
                    "text": "唔，对不起。我忘了你再也…"
                },
                {
                    "id": "760891333",
                    "speaker": "彩特琳德",
                    "text": "啊，不要道歉。是我的问题，我也不是这个意思。"
                },
                {
                    "id": "760891334",
                    "speaker": "彩特琳德",
                    "text": "我是发自真心的。"
                },
                {
                    "id": "760891335",
                    "speaker": "Player",
                    "text": "嗯，谢谢你。"
                },
                {
                    "id": "760891336",
                    "speaker": "道子",
                    "text": "好了，门应该这样就打开了。"
                },
                {
                    "id": "760891337",
                    "speaker": "派蒙",
                    "text": "那我们就快点出发吧。"
                }
            ]
        },
        {
            "id": "7608914",
            "objective": "前往锦栖筑",
            "dialogues": []
        },
        {
