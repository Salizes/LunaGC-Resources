            "dialogues": [
                {
                    "id": "760892701",
                    "speaker": "道子",
                    "text": "狩野、芳年、博斯，你们活了！"
                },
                {
                    "id": "760892702",
                    "speaker": "狩野",
                    "text": "啊，是啊。以后我再也不想画屏风了。"
                },
                {
                    "id": "760892703",
                    "speaker": "道子",
                    "text": "#你们也回来啦，{NICKNAME}、派蒙还有彩特琳德妹妹！"
