    "talks": [
        {
            "id": "2010001",
            "objective": "(test)冒险等级到达4级，完成随风而来的骑士（35403）$HIDDEN",
            "dialogues": [
                {
                    "id": "3580101",
                    "speaker": "凯亚",
                    "text": "…事情的经过，就是这样。"
                },
                {
                    "id": "3580102",
                    "speaker": "琴",
                    "text": "蒙德欢迎你们，随风而来的旅行者。"
                },
                {
                    "id": "3580103",
                    "speaker": "琴",
                    "text": "我是代理团长，琴。这位是丽莎，骑士团的图书管理员。"
                },
                {
                    "id": "3580104",
                    "speaker": "丽莎",
                    "text": "呀，是因为人手不足，所以来帮忙的好心孩子吗？"
                },
                {
                    "id": "3580105",
                    "speaker": "丽莎",
                    "text": "真可爱。"
                },
                {
                    "id": "3580106",
                    "speaker": "丽莎",
                    "text": "只是，时机不怎么巧…"
                },
                {
                    "id": "3580107",
                    "speaker": "丽莎",
                    "text": "风魔龙自从复苏以来，一直在城市周围活动，制造混乱。"
                },
                {
                    "id": "3580108",
                    "speaker": "丽莎",
                    "text": "现在蒙德的元素流动、地脉循环，都已经变得好像被猫咪抓过的线团一样了。"
                },
                {
                    "id": "3580109",
                    "speaker": "丽莎",
                    "text": "对魔法师来说这是最糟糕的情况喔…皮肤和心情都会变差…"
                },
                {
                    "id": "3580110",
                    "speaker": "琴",
                    "text": "如果不受这些干扰，骑士团就有比寻人启事更好的办法来帮助你们了。"
                },
                {
                    "id": "3580111",
                    "speaker": "琴",
                    "text": "现在就请在蒙德暂住一下，由我们西风骑士团来努力解决问题吧。",
                    "choices": [
                        {
                            "id": "3580112",
                            "text": "也不能只让骑士团烦心。",
                            "response": [
                                {
                                    "id": "3580113",
                                    "speaker": "派蒙",
                                    "text": "派蒙也会帮忙！"
                                },
                                {
                                    "id": "3580116",
                                    "speaker": "凯亚",
                                    "text": "那么，就来决定一下作战计划。"
                                },
                                {
                                    "id": "3580117",
                                    "speaker": "琴",
                                    "text": "风魔龙进攻蒙德，反而让我们见到了终结灾难源头的契机。"
                                },
                                {
                                    "id": "3580118",
                                    "speaker": "琴",
                                    "text": "在丽莎的魔法侦测之下，笼罩蒙德的飓风已经暴露了源流。"
                                },
                                {
                                    "id": "3580119",
                                    "speaker": "凯亚",
                                    "text": "哦？ 那么答案是…"
                                },
                                {
                                    "id": "3580120",
                                    "speaker": "丽莎",
                                    "text": "被废弃的<color=#00E1FFFF>「四风守护」庙宇</color>。"
                                },
                                {
                                    "id": "3580121",
                                    "speaker": "丽莎",
                                    "text": "风魔龙能够掀起这种程度的暴风，就是借助了那些残余的力量。"
                                },
                                {
                                    "id": "3580122",
                                    "speaker": "琴",
                                    "text": "而我们的目标，是这四座废弃庙宇中的<color=#00E1FFFF>三座</color>。"
                                },
                                {
                                    "id": "3580123",
                                    "speaker": "琴",
                                    "text": "只选三座的理由…大家应该都明白。"
                                },
                                {
                                    "id": "3580124",
                                    "speaker": "派蒙",
                                    "text": "我不明白。",
                                    "choices": [
                                        {
                                            "id": "3580125",
                                            "text": "这可能是本地人的默契…",
                                            "response": [
                                                {
                                                    "id": "3580127",
                                                    "speaker": "琴",
                                                    "text": "各位西风骑士，事不宜迟。"
                                                },
                                                {
                                                    "id": "3580128",
                                                    "speaker": "琴",
                                                    "text": "暴风正在肆虐，被动防守也没有意义。"
                                                },
                                                {
                                                    "id": "3580129",
                                                    "speaker": "琴",
                                                    "text": "在龙灾扩大之前，就由我们抢先一步，向<color=#00E1FFFF>废弃庙宇</color>的<color=#00E1FFFF>遗迹</color>进发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3580126",
                                            "text": "我们过会再问…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3580114",
                            "text": "那就全靠骑士团了。旅馆在哪里？",
                            "response": [
                                {
                                    "id": "3580115",
                                    "speaker": "派蒙",
                                    "text": "喂！不要偷懒，我们也该参与进来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "201002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20100206",
                    "speaker": "哲平",
                    "text": "准备，起航！"
                }
            ]
        }
    ]
}