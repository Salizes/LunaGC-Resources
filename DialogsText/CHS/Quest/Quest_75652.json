        {
            "id": "7565201",
            "objective": "",
            "dialogues": [
                {
                    "id": "756520201",
                    "speaker": "安柏",
                    "text": "#是{NICKNAME}啊，又在低语森林遇到你，真是太巧了。"
                },
                {
                    "id": "756520202",
                    "speaker": "安柏",
                    "text": "有阵子不见，最近在忙些什么？",
                    "choices": [
                        {
                            "id": "756520203",
                            "text": "通过留影记录走过的风景。",
                            "response": [
                                {
                                    "id": "756520205",
                                    "speaker": "安柏",
                                    "text": "难怪要来低语森林，这里的风景美丽又清幽，的确是留影的好地方。"
                                },
                                {
                                    "id": "756520206",
                                    "speaker": "安柏",
                                    "text": "每次执行侦察任务，我最喜欢的巡逻点就是这里。"
                                },
                                {
                                    "id": "756520207",
                                    "speaker": "安柏",
                                    "text": "记得第一次和你见面也是在这里，当时我还以为你是什么可疑人物呢，哎呀，想起来还有点不好意思。"
                                },
                                {
                                    "id": "756520208",
                                    "speaker": "安柏",
                                    "text": "后来多靠了你，风龙危机最终被解除了，蒙德城的大家又找回了过去的安宁生活。"
                                },
                                {
                                    "id": "756520209",
                                    "speaker": "安柏",
                                    "text": "#不过你的{M#妹妹}{F#哥哥}…虽然我贴了不少寻人启事，但好像没帮上忙…",
                                    "choices": [
                                        {
                                            "id": "756520210",
                                            "text": "没关系，安柏。",
                                            "response": [
                                                {
                                                    "id": "756520212",
                                                    "speaker": "安柏",
                                                    "text": "话是这么说啦，但不管怎么样，还有需要帮忙的地方，放心告诉我。"
                                                },
                                                {
                                                    "id": "756520213",
                                                    "speaker": "安柏",
                                                    "text": "西风骑士团侦察骑士，蒙德城的飞行冠军，你的朋友安柏，随时随地为你效劳。"
                                                },
                                                {
                                                    "id": "756520214",
                                                    "speaker": "Player",
                                                    "text": "想请你一起入镜！"
                                                },
                                                {
                                                    "id": "756520215",
                                                    "speaker": "安柏",
                                                    "text": "没问题，你觉得什么样的姿势比较好？",
                                                    "choices": [
                                                        {
                                                            "id": "756520216",
                                                            "text": "飒爽的姿势。",
                                                            "response": [
                                                                {
                                                                    "id": "756520219",
                                                                    "speaker": "安柏",
                                                                    "text": "好呀，这样可以吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756520220",
                                                                            "text": "很棒！我们开始留影吧！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520221",
                                                                                    "speaker": "安柏",
                                                                                    "text": "我准备好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520222",
                                                                            "text": "还是有趣的姿势合适。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520223",
                                                                                    "speaker": "安柏",
                                                                                    "text": "那就这样好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520224",
                                                                            "text": "还是端正的姿势合适。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520225",
                                                                                    "speaker": "安柏",
                                                                                    "text": "那就这样好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520226",
                                                                            "text": "还是飒爽的姿势合适。"
                                                                        },
                                                                        {
                                                                            "id": "756520227",
                                                                            "text": "我再考虑一下。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756520217",
                                                            "text": "有趣的姿势。"
                                                        },
                                                        {
                                                            "id": "756520218",
                                                            "text": "端正的姿势。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756520211",
                                            "text": "安柏尽力了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756520204",
                            "text": "在为我的传奇生涯留影。"
