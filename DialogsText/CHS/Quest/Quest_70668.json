    "talks": [
        {
            "id": "7066802",
            "objective": "前往「猫尾酒馆」",
            "dialogues": [
                {
                    "id": "706660101",
                    "speaker": "Player",
                    "text": "进行突破挑战！"
                },
                {
                    "id": "706660102",
                    "speaker": "「小王子」",
                    "text": "#喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，{NICKNAME}确实已经拥有了挑战的资格，那我这就…」"
                },
                {
                    "id": "706660103",
                    "speaker": "「小王子」",
                    "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
                }
            ]
        },
        {
            "id": "7066803",
            "objective": "与「小王子」进行突破对局",
            "dialogues": []
        },
        {
            "id": "7066804",
            "objective": "与「小王子」对话",
            "dialogues": [
                {
                    "id": "706680201",
                    "speaker": "「小王子」",
                    "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是大师牌手了！」"
                },
                {
                    "id": "706680202",
                    "speaker": "「小王子」",
                    "text": "喵。「成为大师牌手的意思就是…你的牌技已经超过很多钻研此道的人了，不付出努力的人是达不到这样的境界的。」"
                },
                {
                    "id": "706680203",
                    "speaker": "「小王子」",
                    "text": "「当然，不愿意付出努力的人，一定也无法理解为何我们会孜孜不倦地在他们看来只是玩乐的游戏上付出时间吧…」"
                },
                {
                    "id": "706680205",
                    "speaker": "「小王子」",
                    "text": "喵！「被你邀请过来的牌手，如果听闻你已经获得了大师的头衔，想必也会更认真地对待与你的对局。」"
                },
                {
                    "id": "706680206",
                    "speaker": "「小王子」",
                    "text": "「说不定也有听闻你成为大师牌手后，才愿意让你去挑战他设下的牌局的牌手呢…酒馆里也有这种乖僻的家伙。」"
                },
                {
                    "id": "706680207",
                    "speaker": "「小王子」",
                    "text": "#喵…「那么，{NICKNAME}…」"
                },
                {
                    "id": "706680208",
                    "speaker": "「小王子」",
                    "text": "「希望你能感受到『七圣召唤』的乐趣！」"
                }
            ]
        },
        {
            "id": "7066603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706660301",
                    "speaker": "「小王子」",
                    "text": "#喵…「嗯，{NICKNAME}得要再小心一点才行啊，先调整一下，之后再来挑战吧？」"
                },
                {
                    "id": "706660302",
                    "speaker": "「小王子」",
                    "text": "「我相信你是有足以完成试炼的实力的…」"
                }
            ]
        }
    ]
}