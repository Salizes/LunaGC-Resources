        {
            "id": "7401205",
            "objective": "前往附近的营地搜寻线索",
            "dialogues": [
                {
                    "id": "740120501",
                    "speaker": "派蒙",
                    "text": "呜哇，好严格！我可绝对不想在这家伙手下工作！"
                },
                {
                    "id": "740120502",
                    "speaker": "派蒙",
                    "text": "还说什么「集体荣誉感」…连饭都不让人吃，还有什么荣誉感嘛！",
                    "choices": [
                        {
                            "id": "740120503",
                            "text": "他说的也不是没有道理。",
                            "response": [
                                {
                                    "id": "740120504",
                                    "speaker": "派蒙",
                                    "text": "唔，纪律确实很重要啦…不过也没必要做到这种地步吧？"
                                },
                                {
                                    "id": "740120507",
                                    "speaker": "派蒙",
                                    "text": "咦？仔细想想的话，要是我们也敲锅的话，说不定就能把那个叫舒米洛夫的小队长给引下来了吧？"
                                },
                                {
                                    "id": "740120508",
                                    "speaker": "派蒙",
                                    "text": "#这样一来，我们说不定就能上去了…{NICKNAME}，我们快去试试看吧！"
                                }
                            ]
                        },
                        {
                            "id": "740120505",
                            "text": "真是莫名其妙的规定啊…",
                            "response": [
                                {
                                    "id": "740120506",
                                    "speaker": "派蒙",
                                    "text": "就是啊！越是不知道怎么才能做实事的家伙，就越喜欢搞这种奇怪的纪律和规定…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7401206",
            "objective": "敲击烹饪用的锅",
            "dialogues": [
                {
                    "id": "740120601",
                    "speaker": "Black Screen",
                    "text": "「咚——咚——咚——」\\n没过多久，一阵急匆匆的脚步声从塔楼上方传来…"
                }
            ]
        },
        {
            "id": "7401207",
            "objective": "击败愚人众",
            "dialogues": [
                {
                    "id": "740120701",
                    "speaker": "Black Screen",
                    "text": "小队长带着下属悻悻地逃走了…"
                }
            ]
        },
        {
            "id": "7401208",
            "objective": "继续探索高塔",
            "dialogues": []
        },
        {
            "id": "7401209",
            "objective": "调查终端",
            "dialogues": [
                {
                    "id": "740121001",
                    "speaker": "Player",
                    "text": "拉动拉杆。"
                },
                {
                    "id": "740121002",
                    "speaker": "派蒙",
                    "text": "#呜哇！{NICKNAME}，你在干什么啦！"
                },
                {
                    "id": "740121003",
                    "speaker": "Black Screen",
                    "text": "你毫不犹豫地拉动了拉杆。\\n下一个瞬间，伴随着宛若雷霆的震耳轰鸣，整座高塔开始剧烈地晃动起来，仿佛天为之崩、地为之裂…"
                },
                {
                    "id": "740121004",
                    "speaker": "Black Screen",
                    "text": "然后…噗地一声，机器吐出了一叠纸带，正好掉在你的手中。\\n一切重归沉寂。"
                },
                {
                    "id": "740121005",
                    "speaker": "派蒙",
                    "text": "就…就只是这样吗？"
                },
                {
                    "id": "740121006",
                    "speaker": "派蒙",
                    "text": "唔…完全看不懂上面刻了什么东西，但看上去好像挺重要的…"
                },
                {
                    "id": "740121007",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们还是先留着这些纸带吧？说不定之后会在什么地方用上…"
                }
            ]
        },
        {
            "id": "7401209",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740120901",
                    "speaker": "研察终端",
                    "text": "（控制台右侧的拉杆旁贴着一张便签，上面用整洁漂亮的字体写着：「千万不要动！」）"
                }
            ]
        },
        {
            "id": "7401211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740121101",
                    "speaker": "Player",
                    "text": "最好还是不要动它…"
                },
                {
                    "id": "740121102",
                    "speaker": "派蒙",
                    "text": "#是…是呀，总觉得是很危险的东西…{NICKNAME}，我们还是离它远一些比较好…"
                }
            ]
        },
        {
            "id": "7401212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740121201",
                    "speaker": "派蒙",
                    "text": "咦？是和之前在另外那座塔里一样的控制台…"
                },
                {
                    "id": "740121202",
                    "speaker": "Player",
                    "text": "拉动拉杆。"
                },
                {
                    "id": "740121203",
                    "speaker": "Black Screen",
                    "text": "你拉动了拉杆。\\n与之前一样，一阵轰鸣和晃动后，机器吐出了一叠纸带…"
                },
                {
                    "id": "740121204",
                    "speaker": "派蒙",
                    "text": "唔，是和之前一样的纸带…"
                },
                {
                    "id": "740121205",
                    "speaker": "派蒙",
                    "text": "虽然还是完全看不懂，但之后说不定会在什么地方用上，还是先带在身上吧？"
                }
            ]
        },
        {
            "id": "7401213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740121301",
                    "speaker": "派蒙",
                    "text": "让我看看…嗯，应该就是这个啦，写着「千万不要动！」的拉杆！"
                },
                {
                    "id": "740121302",
                    "speaker": "Player",
                    "text": "拉动拉杆。"
                },
                {
                    "id": "740121303",
                    "speaker": "Black Screen",
                    "text": "你拉动了拉杆。\\n一阵轰鸣和晃动后，机器吐出了一叠纸带…"
                },
                {
                    "id": "740121304",
                    "speaker": "派蒙",
                    "text": "好耶！这样一来，就拿到「桔桔薄饼站」的监测数据啦！"
                },
                {
                    "id": "740121305",
                    "speaker": "派蒙",
                    "text": "#接下来就只剩下「果果软糖站」那边了，{NICKNAME}，我们去那边吧！"
                }
            ]
        },
        {
            "id": "7401214",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740121401",
                    "speaker": "派蒙",
                    "text": "让我看看…嗯，应该就是这个啦，写着「千万不要动！」的拉杆！"
                },
                {
                    "id": "740121402",
                    "speaker": "Player",
                    "text": "拉动拉杆。"
                },
                {
                    "id": "740121403",
                    "speaker": "Black Screen",
                    "text": "你拉动了拉杆。\\n一阵轰鸣和晃动后，机器吐出了一叠纸带…"
                },
                {
                    "id": "740121404",
                    "speaker": "派蒙",
                    "text": "好耶！这样一来，就拿到「果果软糖站」和「桔桔薄饼站」的监测数据啦！"
                },
                {
                    "id": "740121405",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们快点回去找布罗意吧！"
                }
            ]
        }
    ]
