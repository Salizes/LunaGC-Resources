        {
            "id": "7054001",
            "objective": "前往「猫茸茸城堡」",
            "dialogues": [
                {
                    "id": "705400101",
                    "speaker": "凶凶的大猫",
                    "text": "嘶！"
                },
                {
                    "id": "705400102",
                    "speaker": "瓦乐瑞娜",
                    "text": "呜…罗莎莉亚小姐，它好凶好凶，我好怕！"
                },
                {
                    "id": "705400103",
                    "speaker": "罗莎莉亚",
                    "text": "你还是退后吧，不然会被它抓成大花脸。"
                },
                {
                    "id": "705400104",
                    "speaker": "派蒙",
                    "text": "怎么回事？瓦乐瑞娜小姐被猫猫欺负了？",
                    "choices": [
                        {
                            "id": "705400105",
                            "text": "难道是流浪猫的入侵者…",
                            "response": [
                                {
                                    "id": "705400107",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "荣誉骑士！白猫魔法师！「雪糕」出去散步的时候，那只大猫盯上了它，跟着它闯了进来…"
                                },
                                {
                                    "id": "705400108",
                                    "speaker": "罗莎莉亚",
                                    "text": "不用这么紧张，这里不会有人伤害你的。"
                                },
                                {
                                    "id": "705400109",
                                    "speaker": "罗莎莉亚",
                                    "text": "凶恶的东西，会让你去做坏事的家伙们，都被城墙挡在外边了。"
                                },
                                {
                                    "id": "705400110",
                                    "speaker": "罗莎莉亚",
                                    "text": "有些老好人会围着你转，虽然偶尔有点烦，但他们都是为了你好。放松下来，习惯悠闲的生活，也还不错。"
                                },
                                {
                                    "id": "705400111",
                                    "speaker": "凶凶的大猫",
                                    "text": "嘶——呜——"
                                },
                                {
                                    "id": "705400112",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "那，那只大猫居然听懂了吗？"
                                },
                                {
                                    "id": "705400113",
                                    "speaker": "罗莎莉亚",
                                    "text": "好像有效果了，看来这只猫还挺聪明的。"
                                },
                                {
                                    "id": "705400114",
                                    "speaker": "派蒙",
                                    "text": "比起其他的猫猫，它好大好大，颜色又像泡泡桔的果汁。仔细看，它还戴着一个围巾，围巾上还有骑士团的标志呢…"
                                },
                                {
                                    "id": "705400115",
                                    "speaker": "派蒙",
                                    "text": "不如，我们就叫它「大桔骑士」好了！"
                                },
                                {
                                    "id": "705400116",
                                    "speaker": "「大桔骑士」",
                                    "text": "喵！"
                                },
                                {
                                    "id": "705400117",
                                    "speaker": "罗莎莉亚",
                                    "text": "你的方法还真灵验，它彻底放下了戒心。"
                                },
                                {
                                    "id": "705400118",
                                    "speaker": "派蒙",
                                    "text": "但我觉得，「大桔骑士」和罗莎莉亚聊了两句以后，就没那么凶了，所以这回是罗莎莉亚立大功！",
                                    "choices": [
                                        {
                                            "id": "705400119",
                                            "text": "罗莎莉亚和猫猫的关系变好了！",
                                            "response": [
                                                {
                                                    "id": "705400121",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "无所谓吧，可爱的麻烦倒是不嫌多。"
                                                },
                                                {
                                                    "id": "705400122",
                                                    "speaker": "派蒙",
                                                    "text": "#接下来，{NICKNAME}，我们就多多使用猫猫魔法，让不知道为什么生气的「大桔骑士」彻底放松下来，开开心心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705400120",
                                            "text": "罗莎莉亚的特别工作更开心了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705400106",
                            "text": "又有点像猫猫独行骑士。"
                        }
                    ]
                }
            ]
        }
    ]
