    "talks": [
        {
            "id": "4091101",
            "objective": "去蒙德城找蒂玛乌斯",
            "dialogues": [
                {
                    "id": "409110101",
                    "speaker": "蒂玛乌斯",
                    "text": "哎，旅行者，旅行者，请稍等一下…"
                },
                {
                    "id": "409110102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "409110103",
                    "speaker": "蒂玛乌斯",
                    "text": "呃，说起来，有点不好意思…有件事我想请你帮忙。"
                },
                {
                    "id": "409110104",
                    "speaker": "蒂玛乌斯",
                    "text": "你也知道，我一直在研究炼金术，但一直没有什么新突破…"
                },
                {
                    "id": "409110105",
                    "speaker": "蒂玛乌斯",
                    "text": "如果一直这么循规蹈矩地研究下去，我的炼金术水平肯定也不会再有提升。"
                },
                {
                    "id": "409110106",
                    "speaker": "蒂玛乌斯",
                    "text": "所以，我找了个与众不同的切入点，想要开始一场新研究…",
                    "choices": [
                        {
                            "id": "409110107",
                            "text": "你要研究生物炼金？",
                            "response": [
                                {
                                    "id": "409110108",
                                    "speaker": "蒂玛乌斯",
                                    "text": "那个啊，那个已经有人研究了，算不上什么与众不同的切入点…"
                                },
                                {
                                    "id": "409110111",
                                    "speaker": "蒂玛乌斯",
                                    "text": "嗯…你知道炼金术里最重要的是什么吗？是「元素」。"
                                },
                                {
                                    "id": "409110112",
                                    "speaker": "蒂玛乌斯",
                                    "text": "在一般的炼金过程中，因为各种原因，所用的材料一般都是某种有元素附着的材料，而不是纯粹的元素力。"
                                },
                                {
                                    "id": "409110113",
                                    "speaker": "蒂玛乌斯",
                                    "text": "使用这种材料，会在炼金的过程中产生杂质。这种杂质会影响元素反应的效率…"
                                },
                                {
                                    "id": "409110114",
                                    "speaker": "蒂玛乌斯",
                                    "text": "不仅元素材料要加大剂量，还要时刻观察，防止那些杂质直接影响到炼金过程，导致炼金失败…"
                                },
                                {
                                    "id": "409110115",
                                    "speaker": "蒂玛乌斯",
                                    "text": "但对于没有「神之眼」的人来说，想要进行炼金，这也是不得不接受的额外成本。"
                                },
                                {
                                    "id": "409110116",
                                    "speaker": "蒂玛乌斯",
                                    "text": "而且最大的问题是，购置那些元素材料的费用，实在是太高了。"
                                },
                                {
                                    "id": "409110117",
                                    "speaker": "蒂玛乌斯",
                                    "text": "一场炼金术结束，账单比炼金成果更令人在意…"
                                },
                                {
                                    "id": "409110118",
                                    "speaker": "蒂玛乌斯",
                                    "text": "唉，也许就是因为这样，我的炼金术才始终没有突破吧…"
                                },
                                {
                                    "id": "409110119",
                                    "speaker": "Player",
                                    "text": "我也没有「神之眼」。"
                                },
                                {
                                    "id": "409110120",
                                    "speaker": "蒂玛乌斯",
                                    "text": "对…不过我听说了，你还是能操纵元素力，对吧？"
                                },
                                {
                                    "id": "409110123",
                                    "speaker": "蒂玛乌斯",
                                    "text": "是这样，我研究出了一种新的炼金炉，我叫它<color=#00E1FFFF>「原素烘炉」</color>，它的原理是…"
                                },
                                {
                                    "id": "409110124",
                                    "speaker": "蒂玛乌斯",
                                    "text": "呃，简单来说，就是一个能容纳纯粹的元素，并且能让它们互相反应的器皿。"
                                },
                                {
                                    "id": "409110125",
                                    "speaker": "蒂玛乌斯",
                                    "text": "用这个「原素烘炉」炼金出来的成果，说不定能让我的炼金水平有所突破…"
                                },
                                {
                                    "id": "409110126",
                                    "speaker": "蒂玛乌斯",
                                    "text": "现在万事俱备，只缺一个能够自由操纵元素力的人，来帮我「运输」一下那些纯粹的元素了。"
                                },
                                {
                                    "id": "409110127",
                                    "speaker": "蒂玛乌斯",
                                    "text": "如果你愿意的话，请到<color=#00E1FFFF>千风神殿</color>来找我吧，我已经拜托人把设备安装好了。"
                                },
                                {
                                    "id": "409110128",
                                    "speaker": "蒂玛乌斯",
                                    "text": "希望这次，我的炼金术能有所突破…"
                                }
                            ]
                        },
                        {
                            "id": "409110109",
                            "text": "你要研究古代炼金？",
                            "response": [
                                {
                                    "id": "409110110",
                                    "speaker": "蒂玛乌斯",
                                    "text": "古代炼金？呃，那个还不是我能够涉足的领域…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4091102",
            "objective": "前往千风神殿",
            "dialogues": []
        },
        {
            "id": "4091103",
            "objective": "与蒂玛乌斯对话",
            "dialogues": [
                {
                    "id": "409110301",
                    "speaker": "蒂玛乌斯",
                    "text": "你来了，这就是我的<color=#00E1FFFF>「原素烘炉」</color>了。"
                },
                {
                    "id": "409110302",
                    "speaker": "蒂玛乌斯",
                    "text": "多余的话也不说了，我们赶快开始试验吧。"
                }
            ]
        },
        {
            "id": "4091104",
            "objective": "去蒙德城找蒂玛乌斯",
            "dialogues": [
                {
                    "id": "409110401",
                    "speaker": "蒂玛乌斯",
                    "text": "只要再多启动几次…"
                },
                {
                    "id": "409110402",
                    "speaker": "蒂玛乌斯",
                    "text": "旅行者！你来得正好，还记得那座「原素烘炉」吗？"
                },
                {
                    "id": "409110403",
                    "speaker": "蒂玛乌斯",
                    "text": "在你启动「原素烘炉」之后，我在旁边也搜集了不少数据。"
                },
                {
                    "id": "409110404",
                    "speaker": "蒂玛乌斯",
                    "text": "而且最重要的是，我已经确定了它的可靠性。"
                },
                {
                    "id": "409110405",
                    "speaker": "蒂玛乌斯",
                    "text": "有了这么一座可靠的器材，接下来就可以进行更多的实验了…"
                },
                {
                    "id": "409110406",
                    "speaker": "蒂玛乌斯",
                    "text": "旅行者，如果你愿意的话，能帮我再去启动一下「原素烘炉」吗？",
                    "choices": [
                        {
                            "id": "409110407",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "409110408",
                                    "speaker": "蒂玛乌斯",
                                    "text": "那就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "409110409",
                            "text": "要实验多少次？",
                            "response": [
                                {
                                    "id": "409110410",
                                    "speaker": "蒂玛乌斯",
                                    "text": "当然是越多越好，像我这种没有「神之眼」的炼金术师，只能用这种笨办法来研究了…"
                                },
                                {
                                    "id": "409110411",
                                    "speaker": "蒂玛乌斯",
                                    "text": "所以就拜托你了，旅行者，帮我再去启动一下「原素烘炉」吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}