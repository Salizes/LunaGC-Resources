    "talks": [
        {
            "id": "7301801",
            "objective": "前往「歇脚处」",
            "dialogues": []
        },
        {
            "id": "7301802",
            "objective": "与兰般度对话",
            "dialogues": [
                {
                    "id": "730180201",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}，还有派蒙，感谢你们帮助了兰那罗。可以感受到，各处堵塞溪流的小枝已经被移除了。"
                },
                {
                    "id": "730180202",
                    "speaker": "派蒙",
                    "text": "哦！现在我们可以去治好法留纳神机了吧！"
                },
                {
                    "id": "730180203",
                    "speaker": "兰般度",
                    "text": "很快，但是还没有。根系在很深很深的地下，通向地下的入口在法留纳法宝的中心。"
                },
                {
                    "id": "730180204",
                    "speaker": "派蒙",
                    "text": "「法留纳法宝」，好像兰般度提过…"
                },
                {
                    "id": "730180205",
                    "speaker": "兰般度",
                    "text": "#是法留纳神机的力量的显现，它发挥力量的时候，比桓那最高的树更高，那菈{NICKNAME}和派蒙早就见过。"
                },
                {
                    "id": "730180206",
                    "speaker": "派蒙",
                    "text": "是说那个时不时喷射水柱的地方？…难道我们要从那玩意儿的中心进去？！",
                    "choices": [
                        {
                            "id": "730180207",
                            "text": "看起来可不像是入口。",
                            "response": [
                                {
                                    "id": "730180208",
                                    "speaker": "派蒙",
                                    "text": "对呀对呀！"
                                },
                                {
                                    "id": "730180211",
                                    "speaker": "派蒙",
                                    "text": "万一我们准备进去的时候它正好启动了…"
                                },
                                {
                                    "id": "730180212",
                                    "speaker": "派蒙",
                                    "text": "那么高的水柱，而且水势看起来也很强的样子…完全想不出来该怎么进到它的中心…",
                                    "choices": [
                                        {
                                            "id": "730180213",
                                            "text": "只能想办法从上面进去了。",
                                            "response": [
                                                {
                                                    "id": "730180214",
                                                    "speaker": "派蒙",
                                                    "text": "#就算我能飞上去，{NICKNAME}也上不去吧！"
                                                },
                                                {
                                                    "id": "730180219",
                                                    "speaker": "兰百梨迦",
                                                    "text": "为什么会这样？让它停下就可以了。"
                                                },
                                                {
                                                    "id": "730180220",
                                                    "speaker": "派蒙",
                                                    "text": "原来它还能停下的吗！"
                                                },
                                                {
                                                    "id": "730180221",
                                                    "speaker": "兰般度",
                                                    "text": "#之前是不行的，但是因为那菈{NICKNAME}和派蒙的帮助，法留纳神机的力量恢复了一部分，现在兰那罗可以让它停下了。"
                                                },
                                                {
                                                    "id": "730180222",
                                                    "speaker": "派蒙",
                                                    "text": "我们居然不知不觉做了这么了不起的事情！",
                                                    "choices": [
                                                        {
                                                            "id": "730180223",
                                                            "text": "倒也不是不知不觉…",
                                                            "response": [
                                                                {
                                                                    "id": "730180224",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊，确实，梦景林莽那儿找起来真不容易…"
                                                                },
                                                                {
                                                                    "id": "730180227",
                                                                    "speaker": "兰般度",
                                                                    "text": "#那菈{NICKNAME}，派蒙，我们一起过去。绿枝已经开过花，就快要到结果的时候。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730180225",
                                                            "text": "派蒙真是太厉害啦！",
                                                            "response": [
                                                                {
                                                                    "id": "730180226",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}也厉害，嘿嘿，咱俩都厉害！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730180215",
                                            "text": "只能正面硬闯了。",
                                            "response": [
                                                {
                                                    "id": "730180216",
                                                    "speaker": "派蒙",
                                                    "text": "听说有种修行方法是在瀑布下接受水流的冲洗…我们随随便便冲过去肯定会被卷走的啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730180217",
                                            "text": "也许可以在旁边挖个地道下去…",
                                            "response": [
                                                {
                                                    "id": "730180218",
                                                    "speaker": "派蒙",
                                                    "text": "这是什么崭新的解决方法？…等等，说不定真的有一试的价值…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730180209",
                            "text": "进不去，怎么想都进不去吧！",
                            "response": [
                                {
                                    "id": "730180210",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301806",
            "objective": "前往「法留纳法宝」附近",
            "dialogues": []
        },
        {
            "id": "7301807",
            "objective": "与兰般度对话",
            "dialogues": [
                {
                    "id": "730180401",
                    "speaker": "派蒙",
                    "text": "超近距离看感觉更震撼了…"
                },
                {
                    "id": "730180402",
                    "speaker": "兰般度",
                    "text": "法留纳神机，来自草木之王的创造，带来生命的水，把巴螺迦变成桓那，过去的黄色用绿色替代，让不毛的土地从此充满生机。"
                },
                {
                    "id": "730180403",
                    "speaker": "派蒙",
                    "text": "听起来好神奇哦，「带来生命的水」…唔…"
                },
                {
                    "id": "730180404",
                    "speaker": "派蒙",
                    "text": "那这水能喝吗？会不会有什么特别的效果？",
                    "choices": [
                        {
                            "id": "730180405",
                            "text": "说不定会返老还童。",
                            "response": [
                                {
                                    "id": "730180406",
                                    "speaker": "派蒙",
                                    "text": "#欸？那会是{NICKNAME}还是我呢？",
                                    "choices": [
                                        {
                                            "id": "730180407",
                                            "text": "那肯定是宝宝派蒙啦。",
                                            "response": [
                                                {
                                                    "id": "730180408",
                                                    "speaker": "派蒙",
                                                    "text": "比现在还小的话…"
                                                },
                                                {
                                                    "id": "730180409",
                                                    "speaker": "Player",
                                                    "text": "和飞萤一样呢。"
                                                },
                                                {
                                                    "id": "730180410",
                                                    "speaker": "派蒙",
                                                    "text": "才没有那么小啦！"
                                                },
                                                {
                                                    "id": "730180418",
                                                    "speaker": "兰那库拉",
                                                    "text": "派蒙想要水…"
                                                },
                                                {
                                                    "id": "730180419",
                                                    "speaker": "兰那库拉",
                                                    "text": "如果派蒙变成种子，兰那库拉会好好照顾派蒙，给派蒙浇水，还会让派蒙住在有阳光的地方，给派蒙松土。"
                                                },
                                                {
                                                    "id": "730180420",
                                                    "speaker": "兰贡迪",
                                                    "text": "给派蒙演奏音乐，讲派蒙不知道的桓那的事。"
                                                },
                                                {
                                                    "id": "730180421",
                                                    "speaker": "兰贡迪",
                                                    "text": "兰百梨迦不会经常来看派蒙，但是来的时候会带蘑菇来煮。"
                                                },
                                                {
                                                    "id": "730180422",
                                                    "speaker": "兰百梨迦",
                                                    "text": "兰百梨迦才不会做那种事。"
                                                },
                                                {
                                                    "id": "730180423",
                                                    "speaker": "派蒙",
                                                    "text": "哦，这生活听起来好惬意…等等！我是不会变成种子的！这是什么来了就别想走的可怕森林吗！"
                                                },
                                                {
                                                    "id": "730180424",
                                                    "speaker": "派蒙",
                                                    "text": "…想到这些话是可爱面孔的兰那罗说出来的就更觉得可怕了！"
                                                },
                                                {
                                                    "id": "730180425",
                                                    "speaker": "Player",
                                                    "text": "派蒙要茁壮成长早日结果啊。"
                                                },
                                                {
                                                    "id": "730180426",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}！不要连你也说这种吓人的话啦！"
                                                },
                                                {
                                                    "id": "730180427",
                                                    "speaker": "兰般度",
                                                    "text": "那菈和派蒙是不会像兰那罗一样一直在桓那的，兰那库拉应该知道。"
                                                },
                                                {
                                                    "id": "730180428",
                                                    "speaker": "兰那库拉",
                                                    "text": "#知道…那菈{NICKNAME}和派蒙有别的使命，会离开桓那，就像其他那菈那样…"
                                                },
                                                {
                                                    "id": "730180429",
                                                    "speaker": "兰般度",
                                                    "text": "现在我们要完成兰那罗的使命，要令法留纳神机停止，才能向下，去清除那些坏虫，治好法留纳神机。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730180411",
                                            "text": "总不能是我吧？",
                                            "response": [
                                                {
                                                    "id": "730180412",
                                                    "speaker": "派蒙",
                                                    "text": "如果是那样的话…"
                                                },
                                                {
                                                    "id": "730180413",
                                                    "speaker": "派蒙",
                                                    "text": "#嘿嘿，「乖乖{NICKNAME}，派蒙来照顾你哦，让我抱抱~」"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730180414",
                            "text": "说不定能长生不老。",
                            "response": [
                                {
                                    "id": "730180415",
                                    "speaker": "派蒙",
                                    "text": "哇，那岂不是可以吃遍提瓦特！"
                                },
                                {
                                    "id": "730180416",
                                    "speaker": "Player",
                                    "text": "但一起享用美食的伙伴会逐渐凋零…"
                                },
                                {
                                    "id": "730180417",
                                    "speaker": "派蒙",
                                    "text": "唔…活得太久，也不见得全是好事呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301828",
            "objective": "与兰般度对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7301808",
            "objective": "与兰般度对话",
            "dialogues": [
                {
                    "id": "730180801",
                    "speaker": "派蒙",
                    "text": "哇——通往地下的入口…真的打开了！"
                },
                {
                    "id": "730180802",
                    "speaker": "Player",
                    "text": "有种失落的感觉。"
                },
                {
                    "id": "730180803",
                    "speaker": "派蒙",
                    "text": "确实！开了个大洞…不过幸好不是心上开了个大洞？"
                },
                {
                    "id": "730180804",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}和派蒙，我们一起下去。"
                },
                {
                    "id": "730180805",
                    "speaker": "兰般度",
                    "text": "但是之后的路，要非常小心。地下是阳光很少的暗处，过去是种子安眠的地方，现在可能是「蕈兽」的巢穴。"
                },
                {
                    "id": "730180806",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}和派蒙是兰那罗的伙伴，虽然兰那罗的力量不大，如果遇到危险，兰那罗会努力保护你们。"
                },
                {
                    "id": "730180807",
                    "speaker": "兰百梨迦",
                    "text": "有兰百梨迦在，没什么可怕的。"
                },
                {
                    "id": "730180808",
                    "speaker": "派蒙",
                    "text": "#哦！我和{NICKNAME}可都是经历过大风大浪的！不会因为这点小事就害怕啦。"
                },
                {
                    "id": "730180809",
                    "speaker": "兰贡迪",
                    "text": "下面应该没有大风，水，可能会有，但是没有大浪。"
                },
                {
                    "id": "730180810",
                    "speaker": "派蒙",
                    "text": "唔…兰贡迪还是这样只从字面理解别人的话呢…"
                },
                {
                    "id": "730180811",
                    "speaker": "Player",
                    "text": "「大风大浪」是说经历过很多事。"
                },
                {
                    "id": "730180812",
                    "speaker": "兰贡迪",
                    "text": "现在懂了。派蒙讲话好难懂哦。"
                },
                {
                    "id": "730180813",
                    "speaker": "派蒙",
                    "text": "我们彼此彼此啦！"
                },
                {
                    "id": "730180814",
                    "speaker": "派蒙",
                    "text": "总之，蕈兽什么的一点也不可怕嘛！如果真的是蕈兽的巢穴…今天晚饭就吃蘑菇全餐！"
                },
                {
                    "id": "730180815",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，准备好了的话，我们就快下去吧！"
                }
            ]
        },
        {
            "id": "7301823",
            "objective": "前往地下",
            "dialogues": []
        },
        {
            "id": "7301809",
            "objective": "前往深处",
            "dialogues": [
                {
                    "id": "730180901",
                    "speaker": "派蒙",
                    "text": "这、这里可比荼诃之座深多了…没想到居然在地下这么深的地方。"
                },
                {
                    "id": "730180902",
                    "speaker": "派蒙",
                    "text": "而且，好多孢子！光是看到已经觉得难受了…"
                },
                {
                    "id": "730180903",
                    "speaker": "兰般度",
                    "text": "法留纳神机…被「孢子」给覆盖了…"
                },
                {
                    "id": "730180904",
                    "speaker": "兰那库拉",
                    "text": "一定是坏家伙留下的…呜呜…坏家伙，可能就在附近…"
                },
                {
                    "id": "730180905",
                    "speaker": "兰百梨迦",
                    "text": "兰那库拉，不要退缩。已经到了这里，就要把问题解决，无论是「孢子」还是「蕈兽」。这都是为了桓那。"
                },
                {
                    "id": "730180906",
                    "speaker": "兰贡迪",
                    "text": "被「孢子」裹住，法留纳神机一定也很难过。"
                },
                {
                    "id": "730180907",
                    "speaker": "派蒙",
                    "text": "是哦…被孢子裹住…想想都觉得可怕…"
                },
                {
                    "id": "730180908",
                    "speaker": "Player",
                    "text": "赶快把孢子清理掉吧。"
                },
                {
                    "id": "730180909",
                    "speaker": "派蒙",
                    "text": "嗯！就像之前清理谒颂幽境的纪念碑那样，「啪啦」一下清理干净就可以了吧。"
                }
            ]
        },
        {
            "id": "7301810",
            "objective": "清除孢子",
            "dialogues": [
                {
                    "id": "730181001",
                    "speaker": "兰般度",
                    "text": "#兰那罗来得不算太晚，但是…坏种子比好种子长得更快，唔…拜托那菈{NICKNAME}，把坏种子清除…"
                }
            ]
        },
        {
            "id": "7301811",
            "objective": "击败蕈兽",
            "dialogues": []
        },
        {
            "id": "7301813",
            "objective": "击败蕈兽",
            "dialogues": [
                {
                    "id": "730181301",
                    "speaker": "兰般度",
                    "text": "维摩庄的事，兰般度也会去寻找答案，请耐心等待一段时间。"
                }
            ]
        },
        {
            "id": "7301814",
            "objective": "击败蕈兽",
            "dialogues": [
                {
                    "id": "730181401",
                    "speaker": "兰那库拉",
                    "text": "#那菈{NICKNAME}要和兰那库拉一起去照料苗圃吗？虽然现在还什么也没有…"
                },
                {
                    "id": "730181402",
                    "speaker": "兰那库拉",
                    "text": "不过只要种下种子，很快，很快就会长出好看的花…"
                }
            ]
        },
        {
            "id": "7301816",
            "objective": "击败蕈兽",
            "dialogues": [
                {
                    "id": "730181601",
                    "speaker": "兰百梨迦",
                    "text": "哼。"
                },
                {
                    "id": "730181602",
                    "speaker": "兰百梨迦",
                    "text": "……"
                },
                {
                    "id": "730181603",
                    "speaker": "兰百梨迦",
                    "text": "#那菈{NICKNAME}不要被派蒙影响，变得放松大意。"
                }
            ]
        },
        {
            "id": "7301817",
            "objective": "击败蕈兽",
            "dialogues": [
                {
                    "id": "730181701",
                    "speaker": "兰贡迪",
                    "text": "金色的那菈~哼~♪"
                },
                {
                    "id": "730181702",
                    "speaker": "兰贡迪",
                    "text": "蘑菇好吃~哼哼~♪"
                },
                {
                    "id": "730181703",
                    "speaker": "Player",
                    "text": "（兰贡迪似乎完全沉浸在音乐的世界之中…）"
                }
            ]
        },
        {
            "id": "7301819",
            "objective": "击败蕈兽",
            "dialogues": []
        },
        {
            "id": "7301820",
            "objective": "击败蕈兽",
            "dialogues": []
        },
        {
            "id": "7301821",
            "objective": "与兰般度对话",
            "dialogues": [
                {
                    "id": "730182101",
                    "speaker": "派蒙",
                    "text": "现在应该…暂时安全了吧？"
                },
                {
                    "id": "730182102",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}，感谢你的勇敢，啃噬法留纳神机的根的坏虫被解决了。"
                },
                {
                    "id": "730182103",
                    "speaker": "兰般度",
                    "text": "分散在桓那各处的枝叶也把力量源源传递，现在兰那罗可以治好法留纳神机了。"
                },
                {
                    "id": "730182104",
                    "speaker": "Player",
                    "text": "小事一桩。"
                },
                {
                    "id": "730182105",
                    "speaker": "派蒙",
                    "text": "我就说，蕈兽根本就没什么可怕的嘛！再来十个也不怕！哼哼。",
                    "choices": [
                        {
                            "id": "730182106",
                            "text": "就当是热身了。",
                            "response": [
                                {
                                    "id": "730182107",
                                    "speaker": "派蒙",
                                    "text": "#我就知道，{NICKNAME}才不会怕蕈兽呢，哼哼。"
                                },
                                {
                                    "id": "730182110",
                                    "speaker": "兰那库拉",
                                    "text": "刚才大家都在努力对付坏家伙，只有派蒙…"
                                },
                                {
                                    "id": "730182111",
                                    "speaker": "兰贡迪",
                                    "text": "一点力气也没出呢！"
                                },
                                {
                                    "id": "730182112",
                                    "speaker": "派蒙",
                                    "text": "#哪有！我…我可是使出全力给{NICKNAME}加油了，{NICKNAME}一定也感受到我的心意了吧！",
                                    "choices": [
                                        {
                                            "id": "730182113",
                                            "text": "感受到了。",
                                            "response": [
                                                {
                                                    "id": "730182114",
                                                    "speaker": "派蒙",
                                                    "text": "#嘿嘿，果然我和{NICKNAME}是心意相通的！"
                                                },
                                                {
                                                    "id": "730182117",
                                                    "speaker": "兰般度",
                                                    "text": "#总之，要感谢那菈{NICKNAME}和派蒙，给了兰那罗许多帮助，接下来，轮到我们出力气了。"
                                                },
                                                {
                                                    "id": "730182118",
                                                    "speaker": "派蒙",
                                                    "text": "好耶！马上就能和这些让鼻子痒痒的孢子说再见了吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730182115",
                                            "text": "没有哦。",
                                            "response": [
                                                {
                                                    "id": "730182116",
                                                    "speaker": "派蒙",
                                                    "text": "#这不可能！{NICKNAME}应该更用力去感受我的心意…肯定能感受到！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730182108",
                            "text": "真来十个就拜托派蒙了。",
                            "response": [
                                {
                                    "id": "730182109",
                                    "speaker": "派蒙",
                                    "text": "欸？那怎么行！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301822",
            "objective": "与兰般度对话",
            "dialogues": [
                {
                    "id": "730182201",
                    "speaker": "派蒙",
                    "text": "哇！感觉空气都清新了好多！"
                },
                {
                    "id": "730182202",
                    "speaker": "Player",
                    "text": "可以畅快呼吸了。"
                },
                {
                    "id": "730182203",
                    "speaker": "派蒙",
                    "text": "嘿嘿，善见地这下也太平啦！不过不知道森林里的那些蕈兽…"
                },
                {
                    "id": "730182204",
                    "speaker": "兰般度",
                    "text": "之后，坏家伙也许会离开，也许不会。但是法留纳神机已经治好，不会再有那么多「孢子」，兰那罗不会让坏家伙破坏桓那。"
                },
                {
                    "id": "730182205",
                    "speaker": "兰那库拉",
                    "text": "苗圃也会恢复生机了吧…"
                },
                {
                    "id": "730182206",
                    "speaker": "兰百梨迦",
                    "text": "但无留陀还在，兰那罗还有很多事要做。"
                },
                {
                    "id": "730182207",
                    "speaker": "派蒙",
                    "text": "唔…兰百梨迦真的好严格啊，现在至少完成了一件事嘛，就让兰那库拉高兴一下吧！"
                },
                {
                    "id": "730182208",
                    "speaker": "兰百梨迦",
                    "text": "哼。"
                },
                {
                    "id": "730182209",
                    "speaker": "Player",
                    "text": "还是老样子呢。"
                },
                {
                    "id": "730182210",
                    "speaker": "派蒙",
                    "text": "唔…真不知道该怎么让他满意…"
                },
                {
                    "id": "730182211",
                    "speaker": "兰百梨迦",
                    "text": "派蒙，没有紧张感。大意，会吃大亏。"
                },
                {
                    "id": "730182212",
                    "speaker": "派蒙",
                    "text": "哦，这话之前听过啦。派蒙哪有大意，派蒙总是很小心的！"
                },
                {
                    "id": "730182213",
                    "speaker": "Player",
                    "text": "看来派蒙完全没记住教训。"
                },
                {
                    "id": "730182214",
                    "speaker": "派蒙",
                    "text": "#对了，我们还有件事想问问兰般度呢，对吧，{NICKNAME}？"
                },
                {
                    "id": "730182215",
                    "speaker": "Player",
                    "text": "关于维摩庄的孩子…"
                },
                {
                    "id": "730182216",
                    "speaker": "派蒙",
                    "text": "是东边的维摩庄发生的怪事，在那里生活的孩子有时会失踪一段时间，但是之后又会平安回来…"
                },
                {
                    "id": "730182217",
                    "speaker": "派蒙",
                    "text": "森林的事，兰那罗一定比我们更清楚吧，如果兰般度知道什么的话那就太好啦。"
                },
                {
                    "id": "730182218",
                    "speaker": "兰般度",
                    "text": "维摩庄的怪事…现在还不知道，但是记下了，其他的兰那罗或许知道。"
                },
                {
                    "id": "730182219",
                    "speaker": "兰般度",
                    "text": "之后会回桓那兰那，也许那时会有答案。"
                },
                {
                    "id": "730182220",
                    "speaker": "兰般度",
                    "text": "#关于法留纳神机…那菈{NICKNAME}现在知道了，兰那罗的音乐可以控制法留纳神机。"
                },
                {
                    "id": "730182221",
                    "speaker": "派蒙",
                    "text": "#欸？{NICKNAME}之前也学过兰那罗的音乐对吧？那我们也可以控制法留纳神机了吗？"
                },
                {
                    "id": "730182222",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}已经证明了自己，就像那菈法留纳一样，配得上兰那罗的友谊。"
                },
                {
                    "id": "730182223",
                    "speaker": "兰般度",
                    "text": "兰般度愿意将控制法留纳神机的乐谱教给你们。"
                },
                {
                    "id": "730182224",
                    "speaker": "派蒙",
                    "text": "好耶！不过，难道每次演奏都要下到这么深的地底吗…"
                },
                {
                    "id": "730182225",
                    "speaker": "兰贡迪",
                    "text": "派蒙太不聪明，既然法留纳神机能从桓那各处获得力量…"
                },
                {
                    "id": "730182226",
                    "speaker": "Player",
                    "text": "在桓那的别处也能控制法留纳神机。"
                },
                {
                    "id": "730182227",
                    "speaker": "派蒙",
                    "text": "这种兰那罗小知识正常来说都想不到的啦！"
                },
                {
                    "id": "730182228",
                    "speaker": "Black Screen",
                    "text": "掌握了源水的曲调。"
                },
                {
                    "id": "730182229",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}，还有派蒙，感谢你们的帮助，桓那不会忘记，兰那罗也不会忘记…"
                },
                {
                    "id": "730182230",
                    "speaker": "Player",
                    "text": "希望下次是在无忧节相见。"
                },
                {
                    "id": "730182231",
                    "speaker": "兰般度",
                    "text": "我们会再次相见的，在桓那兰那，祝愿金色的那菈度过一段无忧的时光，兰穆护昆达看顾你们。"
                }
            ]
        },
        {
            "id": "7301818",
            "objective": "",
            "dialogues": [
                {
                    "id": "730181801",
                    "speaker": "兰般度",
                    "text": "（test）boss逃跑对话表现3"
                }
