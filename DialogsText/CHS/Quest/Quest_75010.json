                }
            ]
        },
        {
            "id": "7501016",
            "objective": "解救胆小的绵驮兽",
            "dialogues": [
                {
                    "id": "750101601",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750101602",
                    "speaker": "Black Screen",
                    "text": "#在{REALNAME[ID(2)|SHOWHOST(true)]}听起来像是鼓励的「呀！呀！」声中，胆小的绵驮兽沿着刚才搭好的木板爬了上来…"
                },
                {
                    "id": "750101603",
                    "speaker": "胆小的绵驮兽",
                    "text": "嗯…嗯——"
                },
                {
                    "id": "750101604",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔？呀！呀呀！"
                },
                {
                    "id": "750101605",
                    "speaker": "Black Screen",
                    "text": "#面对热情的{REALNAME[ID(2)|SHOWHOST(true)]}，看起来十分胆小的绵驮兽没有表现出害怕的样子，反而是弯下身子用鼻尖轻轻碰了碰{REALNAME[ID(2)|SHOWHOST(true)]}…"
                },
                {
                    "id": "750101606",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呀！"
                },
                {
                    "id": "750101607",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这样算是表示感情不错吧？",
                    "choices": [
                        {
                            "id": "750101608",
                            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}的朋友就是我的朋友。",
                            "response": [
                                {
                                    "id": "750101609",
                                    "speaker": "派蒙",
                                    "text": "也是我的朋友！不对不对，你这是在和谁较劲啦。"
                                },
                                {
                                    "id": "750101612",
                                    "speaker": "派蒙",
                                    "text": "不过它独自在这边还是有点危险吧？还是和瓦达娜讲一下这件事好了。"
                                },
                                {
                                    "id": "750101613",
                                    "speaker": "派蒙",
                                    "text": "#她要是知道{REALNAME[ID(2)|SHOWHOST(true)]}交上绵驮兽朋友了，肯定也会替{REALNAME[ID(2)|SHOWHOST(true)]}高兴的！"
                                }
                            ]
                        },
                        {
                            "id": "750101610",
                            "text": "有点羡慕…",
                            "response": [
                                {
                                    "id": "750101611",
                                    "speaker": "派蒙",
                                    "text": "嗯？一时之间居然不知道你羡慕的究竟是哪边！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501012",
            "objective": "向瓦达娜回报",
            "dialogues": [
                {
                    "id": "750101201",
                    "speaker": "瓦达娜",
                    "text": "你回来啦小家伙，怎么样，交到绵驮兽朋友了吗？"
                },
                {
                    "id": "750101202",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750101203",
                    "speaker": "瓦达娜",
                    "text": "嗯嗯，看你高兴的样子，我也跟着高兴起来了，真好！"
                },
                {
                    "id": "750101204",
                    "speaker": "派蒙",
                    "text": "#瓦达娜也该多关心一下绵驮兽啦，和{REALNAME[ID(2)|SHOWHOST(true)]}交上朋友的那只绵驮兽刚才在好危险的地方呢。"
                },
                {
                    "id": "750101205",
                    "speaker": "瓦达娜",
                    "text": "哎呀，是这样吗？得告诉「半熟蛋」，让它以后多注意一下才行。",
                    "choices": [
                        {
                            "id": "750101206",
                            "text": "你也太放松了吧。",
                            "response": [
                                {
                                    "id": "750101207",
                                    "speaker": "瓦达娜",
                                    "text": "是啊，我已经过上了理想的生活，恭喜我吧！"
                                },
                                {
                                    "id": "750101211",
                                    "speaker": "瓦达娜",
                                    "text": "#对了，旁边的绵驮兽玩具，{REALNAME[ID(2)|SHOWHOST(true)]}要是喜欢就送给你们好啦。"
                                },
                                {
                                    "id": "750101212",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀！"
                                },
                                {
                                    "id": "750101213",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}还真是不客气啊。那就谢谢瓦达娜了！"
                                },
                                {
                                    "id": "750101214",
                                    "speaker": "瓦达娜",
                                    "text": "小事小事，也欢迎你们常来玩呀。"
                                }
                            ]
                        },
                        {
                            "id": "750101208",
                            "text": "「半熟蛋」也太辛苦了…",
                            "response": [
                                {
                                    "id": "750101209",
                                    "speaker": "瓦达娜",
                                    "text": "辛苦是辛苦…不过它生性就爱操心，你要是不让它看管这些绵驮兽，它反而会焦虑到掉毛呢。"
                                },
                                {
                                    "id": "750101210",
                                    "speaker": "瓦达娜",
                                    "text": "所以现在这样是最好的，它完成了工作会很满足，我也乐得轻松自在，很不错吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
