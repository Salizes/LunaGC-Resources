    "talks": [
        {
            "id": "7501013",
            "objective": "(test)遇到一群羊$HIDDEN",
            "dialogues": [
                {
                    "id": "750101301",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀呀！"
                },
                {
                    "id": "750101302",
                    "speaker": "警惕的匿叶龙",
                    "text": "呜！"
                },
                {
                    "id": "750101303",
                    "speaker": "派蒙",
                    "text": "我们是不是打扰到它用餐了？它看起来真的很生气…"
                }
            ]
        },
        {
            "id": "7501001",
            "objective": "让匿叶龙冷静下来",
            "dialogues": [
                {
                    "id": "750100101",
                    "speaker": "瓦达娜",
                    "text": "「我没有必须达成的目标，也没有迫切的渴望，我是个快乐的牧民，我只关心绵驮兽，关心日月花草、清风雨露…」"
                },
                {
                    "id": "750100102",
                    "speaker": "瓦达娜",
                    "text": "这是我最喜欢的小曲，怎么样？还不错吧。"
                }
            ]
        },
        {
            "id": "7501002",
            "objective": "与冷静下来的匿叶龙对话",
            "dialogues": [
                {
                    "id": "750100201",
                    "speaker": "Black Screen",
                    "text": "啊，是毛茸茸，有什么毛茸茸的东西拦住了你…"
                },
                {
                    "id": "750100202",
                    "speaker": "活泼的绵驮兽",
                    "text": "嗯——？"
                },
                {
                    "id": "750100203",
                    "speaker": "警惕的匿叶龙",
                    "text": "呜…"
                },
                {
                    "id": "750100204",
                    "speaker": "活泼的绵驮兽",
                    "text": "嗯嗯——"
                },
                {
                    "id": "750100205",
                    "speaker": "派蒙",
                    "text": "欸？原来你们是朋友吗？"
                },
                {
                    "id": "750100206",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750100207",
                    "speaker": "Black Screen",
                    "text": "看起来是在附近看管绵驮兽的人走过来安抚匿叶龙…"
                },
                {
                    "id": "750100208",
                    "speaker": "瓦达娜",
                    "text": "「半熟蛋」，你冷静一点喔，就是因为你老是这样轻率地下判断，所以才是个「半熟蛋」啊。"
                },
                {
                    "id": "750100209",
                    "speaker": "「半熟蛋」",
                    "text": "呜…"
                },
                {
                    "id": "750100210",
                    "speaker": "瓦达娜",
                    "text": "抱歉啦，它就是责任心太重，看到陌生人靠近就会很紧张。不过也多亏了它这么卖力看管绵驮兽，我才能悠闲度日，哈哈。"
                },
                {
                    "id": "750100211",
                    "speaker": "瓦达娜",
                    "text": "所以几位到这里来是有何贵干呢？"
                },
                {
                    "id": "750100212",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "只是四处冒险。"
                },
                {
                    "id": "750100213",
                    "speaker": "瓦达娜",
                    "text": "哎呀，原来是冒险家。说不定在「半熟蛋」的眼里，你是浑身散发出强敌气息的危险人物呢。"
                },
                {
                    "id": "750100216",
                    "speaker": "派蒙",
                    "text": "没想到匿叶龙还能替人看管绵驮兽。之前远远地看见它们，还以为绵驮兽要被袭击了，原来是我误会它了！"
                },
                {
                    "id": "750100217",
                    "speaker": "瓦达娜",
                    "text": "哈哈，常有的事。别看它凶凶的，其实和绵驮兽关系好得很呢，说是朋友也不为过。"
                },
                {
                    "id": "750100218",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呀！呀呀！"
                },
                {
                    "id": "750100219",
                    "speaker": "瓦达娜",
                    "text": "怎么啦，小家伙，你也想和它们交朋友吗？"
                },
                {
                    "id": "750100220",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀呀！"
                },
                {
                    "id": "750100221",
                    "speaker": "派蒙",
                    "text": "#哇，这么激动，看来是真的很想和它们交朋友。不过说来也是，平时都是和我还有{NICKNAME}在一起，能交上动物朋友的话…"
                },
                {
                    "id": "750100222",
                    "speaker": "瓦达娜",
                    "text": "那画面一定很可爱，被绵驮兽簇拥着的顽皮小嵴锋龙，光是看着这样的场景我就能吃下三碗火焰炖肉…"
                },
                {
                    "id": "750100223",
                    "speaker": "瓦达娜",
                    "text": "啊，不过也得看绵驮兽它们愿不愿意，毕竟友谊这事也勉强不来。对不对呀，「半熟蛋」？"
                },
                {
                    "id": "750100224",
                    "speaker": "「半熟蛋」",
                    "text": "呜。",
                    "choices": [
                        {
                            "id": "750100225",
                            "text": "#谁敢不喜欢我家{REALNAME[ID(2)|SHOWHOST(true)]}？",
                            "response": [
                                {
                                    "id": "750100226",
                                    "speaker": "派蒙",
                                    "text": "#你不要一副怪物监护人的样子啦！给{REALNAME[ID(2)|SHOWHOST(true)]}一点机会，让它自己试试吧。"
                                },
                                {
                                    "id": "750100227",
                                    "speaker": "派蒙",
                                    "text": "小孩子总归要靠自己努力尝试才能成长起来，嗯。"
                                },
                                {
                                    "id": "750100231",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750100232",
                                    "speaker": "瓦达娜",
                                    "text": "看它信心满满的样子应该是不用太担心了，那我就回去休息咯。遇到问题再来找我…"
                                },
                                {
                                    "id": "750100233",
                                    "speaker": "瓦达娜",
                                    "text": "哦，不过找我应该不如找「半熟蛋」有用，要说绵驮兽还是它最了解了，哈哈，开个玩笑。小家伙，希望你交朋友顺利呀。"
                                }
                            ]
                        },
                        {
                            "id": "750100228",
                            "text": "没事，它们不愿意还有我们在。",
                            "response": [
                                {
                                    "id": "750100229",
                                    "speaker": "派蒙",
                                    "text": "#虽然知道你是想让{REALNAME[ID(2)|SHOWHOST(true)]}即便失败了也不用太难过…但是也不用一开始就这么悲观吧！"
                                },
                                {
                                    "id": "750100230",
                                    "speaker": "派蒙",
                                    "text": "#小孩子就是要多鼓励才会健康成长的，所以多夸夸它吧！{REALNAME[ID(2)|SHOWHOST(true)]}肯定可以的！加油！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
