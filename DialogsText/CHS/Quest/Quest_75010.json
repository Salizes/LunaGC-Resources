                }
            ]
        },
        {
            "id": "7501011",
            "objective": "(test)帮助羊驼C$HIDDEN",
            "dialogues": [
                {
                    "id": "750101101",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750101102",
                    "speaker": "胆小的绵驮兽",
                    "text": "嗯…"
                },
                {
                    "id": "750101103",
                    "speaker": "派蒙",
                    "text": "欸？怎么在这里还有一只绵驮兽？"
                },
                {
                    "id": "750101104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750101105",
                    "speaker": "派蒙",
                    "text": "它这是怎么了？是被困在下面上不来了吗？"
                }
            ]
        },
        {
            "id": "7501010",
