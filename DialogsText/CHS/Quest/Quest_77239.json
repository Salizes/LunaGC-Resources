    "talks": [
        {
            "id": "7723901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772390101",
                    "speaker": "莉霍维多娃",
                    "text": "没有人来挑战了吗，海屑镇的男士们女士们，可别让我看不起你们！"
                },
                {
                    "id": "772390102",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "772390103",
                    "speaker": "莉霍维多娃",
                    "text": "我叫莉霍维多娃，嘿嘿，正是设计出了这个「雪球躲避大舞台」的人！"
                },
                {
                    "id": "772390104",
                    "speaker": "莉霍维多娃",
                    "text": "实不相瞒，我从前也是冒险家协会的一位冒险家，有一次在某个雪夜在冻土上冒险的时候，遇到了成群的软猬兽。"
                },
                {
                    "id": "772390105",
                    "speaker": "莉霍维多娃",
                    "text": "滚滚而来的软猬兽啊，就像是巨大的尖刺炮弹那样，把我追得狼狈不堪，涕泗横流…"
                },
                {
                    "id": "772390106",
                    "speaker": "莉霍维多娃",
                    "text": "从软猬兽的冲击下活下来的我决定刻苦锻炼，而用雪球模拟软猬兽的冲击，这就是我想出来的锻炼法！"
                },
                {
                    "id": "772390107",
                    "speaker": "莉霍维多娃",
                    "text": "等功成之日，再遇到软猬兽的时候，必能通过我灵活的身法反过来羞辱它们！哼哼…"
                },
                {
                    "id": "772390108",
                    "speaker": "莉霍维多娃",
                    "text": "这就是「雪球躲避大舞台」！"
                },
                {
                    "id": "772390109",
                    "speaker": "莉霍维多娃",
                    "text": "规则很简单，站在台上，想尽办法不要被雪球击中，时间越长，得到的奖励也越好！"
                },
                {
                    "id": "772390110",
                    "speaker": "莉霍维多娃",
                    "text": "#怎么样，我能看到你眼中深藏的战士般的意志，如何，要来尝试一下吗？{M#先生}{F#小姐}？",
                    "choices": [
                        {
                            "id": "772390111",
                            "text": "那就来试试吧。",
                            "response": [
                                {
                                    "id": "772390112",
                                    "speaker": "莉霍维多娃",
                                    "text": "好，那就请站到台子上吧！"
                                }
                            ]
                        },
                        {
                            "id": "772390113",
                            "text": "不，我还有别的事…",
                            "response": [
                                {
                                    "id": "772390114",
                                    "speaker": "莉霍维多娃",
                                    "text": "没有关系，就像团成团的软猬兽一直在雪夜的白桦林中等待着我，「雪球躲避大舞台」也会一直等待着你的！"
                                },
                                {
                                    "id": "772390115",
                                    "speaker": "莉霍维多娃",
                                    "text": "终有一日你会明白，是命运！是命运使你与「雪球躲避大舞台」在此处相遇的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7723902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772390201",
                    "speaker": "莉霍维多娃",
                    "text": "真是…真是巅峰的妙想，为了躲避这些雪球，这些假想的怪兽，您的一举一动真是充满了巧思！"
                },
                {
                    "id": "772390202",
                    "speaker": "莉霍维多娃",
                    "text": "可惜了，如果有留影机就好了，这样我就可以拍摄下您躲避的身姿并且反复观看。"
                },
                {
                    "id": "772390203",
                    "speaker": "莉霍维多娃",
                    "text": "这些…这些奖励就交给你了，呜…要是，要是当时我有这样灵活的身段，就算再会滚的软猬兽也触及不到分毫啊！"
                }
            ]
        },
        {
            "id": "7723903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772390301",
                    "speaker": "莉霍维多娃",
                    "text": "怎么样，有没有空，可以来试试「雪球躲避大舞台」吗？",
                    "choices": [
                        {
                            "id": "772390302",
                            "text": "那就来试试吧！",
                            "response": [
