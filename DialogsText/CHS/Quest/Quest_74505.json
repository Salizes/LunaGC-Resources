            "dialogues": [
                {
                    "id": "745050101",
                    "speaker": "阿尔芒",
                    "text": "两…两…两位好，我是…是阿…阿…阿尔芒…"
                },
                {
                    "id": "745050102",
                    "speaker": "派蒙",
                    "text": "你看起来好像有点紧张？"
                },
                {
                    "id": "745050103",
                    "speaker": "阿尔芒",
                    "text": "对…对…对不起！人多…我…我…说话就…"
                },
                {
                    "id": "745050104",
                    "speaker": "派蒙",
                    "text": "没关系没关系！你不用着急，我们只是来体验玩具的啦！"
                },
                {
                    "id": "745050105",
                    "speaker": "阿尔芒",
                    "text": "好…我准…准…准备了一份说…说明！给…给你们…"
                },
                {
                    "id": "745050106",
                    "speaker": "派蒙",
                    "text": "阿尔芒你真体贴！一会我们会认真看的。"
                },
                {
                    "id": "745050107",
                    "speaker": "阿尔芒",
                    "text": "不…不…看也没事，这个很…很简单…又…又好玩，试…试…试试吧？"
                },
                {
                    "id": "745050108",
                    "speaker": "Player",
                    "text": "谢谢，我一会试试。"
                },
                {
                    "id": "745050109",
                    "speaker": "阿尔芒",
                    "text": "祝…祝…祝两位…玩开心。"
                }
            ]
        }
    ]
