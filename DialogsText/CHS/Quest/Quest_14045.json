    "talks": [
        {
            "id": "1404501",
            "objective": "等待到第二天（12-16点）",
            "dialogues": [
                {
                    "id": "140450101",
                    "speaker": "瓦纳格姆",
                    "text": "…女士们，先生们！欢迎各位莅临本次料理对决现场！"
                },
                {
                    "id": "140450102",
                    "speaker": "爱可菲",
                    "text": "莎凡娜，你要的《德波大秘典》原本，我已经带来了。"
                },
                {
                    "id": "140450103",
                    "speaker": "莎凡娜",
                    "text": "…莫妮卡…哼。"
                },
                {
                    "id": "140450104",
                    "speaker": "莫妮卡",
                    "text": "唔…"
                },
                {
                    "id": "140450105",
                    "speaker": "瓦纳格姆",
                    "text": "为了确保公平，这次对决会以双盲测试的形式进行。完成的料理将送入后厨做上标记。"
                },
                {
                    "id": "140450106",
                    "speaker": "瓦纳格姆",
                    "text": "双方的标识藏在餐盘下方。直到评委们吃完料理、翻转餐盘之前，谁都不知道哪道料理是哪位选手完成的。"
                },
                {
                    "id": "140450107",
                    "speaker": "爱洛依丝",
                    "text": "…作为评议员，我会公正地评价所有料理。"
                },
                {
                    "id": "140450108",
                    "speaker": "雷诺德",
                    "text": "没想到昨天被打扰用餐的补偿，居然是受邀成为对决评委！这下还真是值回饭钱了！"
                },
                {
                    "id": "140450109",
                    "speaker": "瓦纳格姆",
                    "text": "双方选手已经就位，那么我宣布！德波大饭店特别料理对决——正式开始！"
                }
            ]
        },
        {
            "id": "1404502",
