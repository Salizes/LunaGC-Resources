            "dialogues": []
        },
        {
            "id": "1404504",
            "objective": "制作第一层蛋糕",
            "dialogues": [
                {
                    "id": "140450401",
                    "speaker": "瓦纳格姆",
                    "text": "——时间到！两方选手，请将料理送入后厨。"
                },
                {
                    "id": "140450402",
                    "speaker": "派蒙",
                    "text": "唔…光从外表上看，还真看不出是谁做的呢…"
                },
                {
                    "id": "140450403",
                    "speaker": "爱可菲",
                    "text": "毕竟我们做的都是同一道料理，莎凡娜再怎么说也曾是被我看好的厨师，总不会在外表方面失了水准。"
                },
                {
                    "id": "140450404",
                    "speaker": "雷诺德",
                    "text": "哦…这份料理相当不错呢！"
                },
                {
                    "id": "140450405",
                    "speaker": "爱洛依丝",
                    "text": "松软的口感，适宜的甜度…确实是能编进教材的模范！"
                },
                {
                    "id": "140450406",
                    "speaker": "莎凡娜",
                    "text": "…哼。"
                },
                {
                    "id": "140450407",
                    "speaker": "瓦纳格姆",
                    "text": "嗯…如果用十分制来打分…那至少得有九点九分吧！"
                },
                {
                    "id": "140450408",
                    "speaker": "瓦纳格姆",
                    "text": "…就是蛋糕胚的味道，跟从前比起来总感觉变了一点点…"
                },
                {
                    "id": "140450409",
                    "speaker": "雷诺德",
                    "text": "欸？是吗？我都没尝出来！"
                },
                {
                    "id": "140450410",
                    "speaker": "莎凡娜",
                    "text": "…啧！"
                },
                {
                    "id": "140450411",
                    "speaker": "瓦纳格姆",
                    "text": "哈哈，来试试第二份吧！嗯…还没入口就能闻到完美的清香呢！"
                },
                {
                    "id": "140450412",
                    "speaker": "爱洛依丝",
                    "text": "我有预感，这绝对是一份能送进博物馆的作品！"
                },
                {
                    "id": "140450413",
                    "speaker": "雷诺德",
                    "text": "这么厉害？——那我就开动啦！"
                },
                {
                    "id": "140450414",
                    "speaker": "瓦纳格姆",
                    "text": "欸…"
                },
                {
                    "id": "140450415",
                    "speaker": "爱洛依丝",
                    "text": "咦…"
                },
                {
                    "id": "140450416",
                    "speaker": "雷诺德",
                    "text": "唔…这糖霜…是不是放得太多了？"
                },
                {
                    "id": "140450417",
                    "speaker": "爱洛依丝",
                    "text": "调味也完全失衡了…到底是谁端上来的！"
                },
                {
                    "id": "140450418",
                    "speaker": "瓦纳格姆",
                    "text": "唉…看起来各位评委都已经做出了选择。我们一致认为，这份作品，实在是有失水准。"
                },
                {
                    "id": "140450419",
                    "speaker": "派蒙",
                    "text": "呼…我还以为她有多厉害呢，原来就只有这点水平！",
                    "choices": [
                        {
                            "id": "140450420",
                            "text": "是不是因为配合不佳？",
                            "response": [
                                {
                                    "id": "140450422",
                                    "speaker": "爱可菲",
                                    "text": "…不太对劲，她再怎么失误，也不至于这样…"
                                },
                                {
                                    "id": "140450423",
                                    "speaker": "瓦纳格姆",
                                    "text": "那么获胜的一方，就是第一份作品了。现在就来揭晓，这份餐盘底下…"
                                },
                                {
                                    "id": "140450424",
                                    "speaker": "雷诺德",
                                    "text": "——是、是莎凡娜的标记？！"
                                },
                                {
                                    "id": "140450425",
                                    "speaker": "娜维娅",
                                    "text": "怎么可能——！？"
                                },
                                {
                                    "id": "140450426",
                                    "speaker": "莎凡娜",
                                    "text": "哼。"
                                },
                                {
                                    "id": "140450427",
                                    "speaker": "派蒙",
                                    "text": "喂——莎凡娜！你这家伙，是作弊了吧！"
                                },
                                {
                                    "id": "140450428",
                                    "speaker": "派蒙",
                                    "text": "一定是你动的手脚！是…是不是你偷偷调换了盘子！"
                                },
                                {
                                    "id": "140450429",
                                    "speaker": "莎凡娜",
                                    "text": "哼，输不起就想耍赖吗？在场所有人可都看见了，从蛋糕出炉到上桌，我可连碰都没碰。"
                                },
                                {
                                    "id": "140450430",
                                    "speaker": "莎凡娜",
                                    "text": "在后厨做标记的人也都是瓦纳格姆安排的，要怎么怀疑也怀疑不到我头上吧？"
                                },
                                {
                                    "id": "140450431",
                                    "speaker": "莎凡娜",
                                    "text": "说不定，是爱可菲手生了？又或者是你们拖后腿了？"
                                },
                                {
                                    "id": "140450432",
                                    "speaker": "派蒙",
                                    "text": "你…！"
                                },
                                {
                                    "id": "140450433",
                                    "speaker": "娜维娅",
                                    "text": "裁判！我们要求重赛！"
                                },
                                {
                                    "id": "140450434",
                                    "speaker": "莫妮卡",
                                    "text": "……"
                                },
                                {
                                    "id": "140450435",
                                    "speaker": "爱可菲",
                                    "text": "够了…不用再说了。"
                                },
                                {
                                    "id": "140450436",
                                    "speaker": "爱可菲",
                                    "text": "不管是哪个环节出了问题，身为主厨…不，身为领队的我都有失察的责任。"
                                },
                                {
                                    "id": "140450437",
                                    "speaker": "爱可菲",
                                    "text": "莎凡娜…没想到，为了赢过我，你居然不惜做到这个地步…连厨师的自尊都忘了吗？"
                                },
                                {
                                    "id": "140450438",
                                    "speaker": "莎凡娜",
                                    "text": "…我可不知道你在说什么！"
                                },
                                {
                                    "id": "140450439",
                                    "speaker": "爱可菲",
                                    "text": "既然你那么想要《德波大秘典》，那我可以给你。"
                                },
                                {
                                    "id": "140450440",
                                    "speaker": "娜维娅",
                                    "text": "…爱可菲！"
                                },
                                {
                                    "id": "140450441",
                                    "speaker": "爱可菲",
                                    "text": "——但你必须答应我，去向菲尔曼赔偿道歉！"
                                },
                                {
                                    "id": "140450442",
                                    "speaker": "莎凡娜",
                                    "text": "你怎么还是这副口气…这场对决是我赢了吧？秘典原本也已经是我的了，凭什么要答应你！"
                                },
                                {
                                    "id": "140450443",
                                    "speaker": "爱可菲",
                                    "text": "莎凡娜，一场胜负骗得了别人，难道还能骗得了你自己吗？我可以不追究你都干了什么…"
                                },
                                {
                                    "id": "140450444",
                                    "speaker": "莫妮卡",
                                    "text": "……！"
                                },
                                {
                                    "id": "140450445",
                                    "speaker": "爱可菲",
                                    "text": "…但你必须答应我，以后别再给他们这么大的压力了。"
                                },
                                {
                                    "id": "140450446",
                                    "speaker": "莎凡娜",
                                    "text": "…哼，行吧，就当这是前主厨，交接下来的工作了。"
                                },
                                {
                                    "id": "140450447",
                                    "speaker": "莎凡娜",
                                    "text": "你要交代的事就只有这些了吗？前主厨？"
                                },
                                {
                                    "id": "140450448",
                                    "speaker": "爱可菲",
                                    "text": "这不是我作为前主厨的批评，只是作为一个厨师兼一个朋友的建议。"
                                },
                                {
                                    "id": "140450449",
                                    "speaker": "爱可菲",
                                    "text": "虽然不知道现在的你，还能不能听得进去。"
                                },
                                {
                                    "id": "140450450",
                                    "speaker": "莎凡娜",
                                    "text": "我知道自己在做什么…不需要你来关心！"
                                },
                                {
                                    "id": "140450451",
                                    "speaker": "爱可菲",
                                    "text": "是吗？那最好。"
                                },
                                {
                                    "id": "140450452",
                                    "speaker": "派蒙",
                                    "text": "啊…爱可菲！"
                                },
                                {
                                    "id": "140450453",
                                    "speaker": "莎凡娜",
                                    "text": "《德波大秘典》！这一次…一定能成功！"
                                },
                                {
                                    "id": "140450454",
                                    "speaker": "娜维娅",
                                    "text": "爱可菲！怎么能让她就这么得逞？"
                                },
                                {
                                    "id": "140450455",
                                    "speaker": "派蒙",
                                    "text": "是啊！那本秘典…明明是珍贵的纪念品吧？"
                                },
                                {
                                    "id": "140450456",
                                    "speaker": "爱可菲",
                                    "text": "…没事的，一场胜负而已，我又不在乎。"
                                },
                                {
                                    "id": "140450457",
                                    "speaker": "爱可菲",
                                    "text": "况且结果又不坏，她不是答应要补偿菲尔曼了吗？那刺玫会的委托也算解决了吧。"
                                },
                                {
                                    "id": "140450458",
                                    "speaker": "爱可菲",
                                    "text": "倒不如说，早知道简简单单把原本送出去就能解决问题，还搞什么料理对决？真是小题大做！",
                                    "choices": [
                                        {
                                            "id": "140450459",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "140450461",
                                                    "speaker": "Player",
                                                    "text": "（她的心里…其实并不好受吧。但是现在…）"
                                                },
                                                {
                                                    "id": "140450462",
                                                    "speaker": "莎凡娜",
                                                    "text": "——不会的，怎么可能，怎么可能！"
                                                },
                                                {
                                                    "id": "140450463",
                                                    "speaker": "阿尔方斯",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "140450464",
                                                    "speaker": "莎凡娜",
                                                    "text": "…没有？居然…什么秘密都没有？这不可能…不可能！！"
                                                },
                                                {
                                                    "id": "140450465",
                                                    "speaker": "加斯帕德",
                                                    "text": "——主厨！莎凡娜主厨！"
                                                },
                                                {
                                                    "id": "140450466",
                                                    "speaker": "爱可菲",
                                                    "text": "莎凡娜…！"
                                                },
                                                {
                                                    "id": "140450467",
                                                    "speaker": "Black Screen",
                                                    "text": "看过秘典原本的莎凡娜，突然昏迷过去…"
                                                },
                                                {
                                                    "id": "140450468",
                                                    "speaker": "瓦纳格姆",
                                                    "text": "…她看起来没有什么生命危险，只是平时压力太大，过于疲惫了，唉。"
                                                },
                                                {
                                                    "id": "140450469",
                                                    "speaker": "爱可菲",
                                                    "text": "这个家伙…我就知道！"
                                                },
                                                {
                                                    "id": "140450470",
                                                    "speaker": "派蒙",
                                                    "text": "压力太大…她？"
                                                },
                                                {
                                                    "id": "140450471",
                                                    "speaker": "阿尔方斯",
                                                    "text": "其实比起我们，主厨为难最多的人，还是她自己…"
                                                },
                                                {
                                                    "id": "140450472",
                                                    "speaker": "加斯帕德",
                                                    "text": "虽然有时候，我们会被要求重做到深夜。但主厨她几乎每天都会把自己关在厨房里钻研。"
                                                },
                                                {
                                                    "id": "140450473",
                                                    "speaker": "加斯帕德",
                                                    "text": "直到白天有人来上班了，才注意到自己一晚没睡…"
                                                },
                                                {
                                                    "id": "140450474",
                                                    "speaker": "娜维娅",
                                                    "text": "这…是为什么？"
                                                },
                                                {
                                                    "id": "140450475",
                                                    "speaker": "阿尔方斯",
                                                    "text": "我们猜…是她不想被人认为，自己不如爱可菲主厨吧。"
                                                },
                                                {
                                                    "id": "140450476",
                                                    "speaker": "爱可菲",
                                                    "text": "果然…"
                                                },
                                                {
                                                    "id": "140450477",
                                                    "speaker": "娜维娅",
                                                    "text": "就算是这样，也不能成为她迁怒你们的理由吧？"
                                                },
                                                {
                                                    "id": "140450478",
                                                    "speaker": "派蒙",
                                                    "text": "就是就是！也不能成为她在对决里作弊的借口！"
                                                },
                                                {
                                                    "id": "140450479",
                                                    "speaker": "加斯帕德",
                                                    "text": "这…说实话，我们也不知道主厨她到底做了什么。她就是让我们老老实实地做蛋糕…"
                                                },
                                                {
                                                    "id": "140450480",
                                                    "speaker": "瓦纳格姆",
                                                    "text": "后厨里负责标记的是蕾欧妮跟艾嘉莉亚，我刚刚问过了，她们俩也是一头雾水。"
                                                },
                                                {
                                                    "id": "140450481",
                                                    "speaker": "爱可菲",
                                                    "text": "没事，先跟我到楼下去吧。我要…亲自「审问」那块蛋糕！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140450460",
                                            "text": "爱可菲…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140450421",
                            "text": "刚刚看她一直在责怪下属…"
                        }
                    ]
                }
            ]
        },
