        },
        {
            "id": "7223304",
            "objective": "寻找剩余的键纹$HIDDEN",
            "dialogues": [
                {
                    "id": "722330401",
                    "speaker": "露子",
                    "text": "#{NICKNAME}，还有什么想问的吗？",
                    "choices": [
                        {
                            "id": "722330402",
                            "text": "关于键纹…",
                            "response": [
                                {
                                    "id": "722330403",
                                    "speaker": "露子",
                                    "text": "键纹被我们放在了「海神之鳍」与「海神之心」处。"
                                },
                                {
                                    "id": "722330404",
                                    "speaker": "露子",
                                    "text": "其实我们也就是就近移开了一点。毕竟两处海神之伤也还算是比较隐秘的地方了。"
                                },
                                {
                                    "id": "722330405",
                                    "speaker": "露子",
                                    "text": "尽力了，真的。"
                                }
                            ]
                        },
                        {
                            "id": "722330406",
                            "text": "关于祭坛…",
                            "response": [
                                {
                                    "id": "722330407",
                                    "speaker": "露子",
                                    "text": "祭坛在北方和正东边。就在下面月浴渊的第二重山之垣上。"
                                },
                                {
                                    "id": "722330408",
                                    "speaker": "露子",
                                    "text": "如果你从珊瑚宫到「海神之鳍」与「海神之心」连两条线…"
                                },
                                {
                                    "id": "722330409",
                                    "speaker": "露子",
                                    "text": "再和二重垣的弧线取两个交点。就是这两处啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7223305",
            "objective": "寻找剩余的键纹",
            "dialogues": [
                {
                    "id": "722330501",
                    "speaker": "露子",
                    "text": "#{NICKNAME}，还有什么想问的吗？"
                },
                {
                    "id": "722330502",
                    "speaker": "Player",
                    "text": "关于白夜国…"
                },
                {
                    "id": "722330503",
                    "speaker": "露子",
                    "text": "渊下宫曾经的名字就叫做白夜国。因为地下之国并无日月，只有白夜和常夜两种天象。"
                },
                {
                    "id": "722330504",
                    "speaker": "露子",
                    "text": "我的家系之中曾有一位名叫乌帽子的巫女，在白夜国历史里也算个人物，所以才让我负责「海祇御灵祭」。"
                }
            ]
        },
        {
            "id": "7223306",
