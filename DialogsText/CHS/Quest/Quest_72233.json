    "talks": [
        {
            "id": "7223301",
            "objective": "(test)自动完成播reminder$HIDDEN",
            "dialogues": [
                {
                    "id": "722330101",
                    "speaker": "露子",
                    "text": "#{NICKNAME}，你们好啊。"
                },
                {
                    "id": "722330102",
                    "speaker": "派蒙",
                    "text": "露子小姐，取珊瑚的事情准备的怎么样了啊？"
                },
                {
                    "id": "722330103",
                    "speaker": "露子",
                    "text": "哎呀，这不是又遇到了难处嘛。"
                },
                {
                    "id": "722330104",
                    "speaker": "派蒙",
                    "text": "虽然露子小姐你看起来悲伤地低下了头…"
                },
                {
                    "id": "722330105",
                    "speaker": "派蒙",
                    "text": "但这样不停地给我们使眼色，未免也太露骨了。"
                },
                {
                    "id": "722330106",
                    "speaker": "露子",
                    "text": "呜，果然你们也发现了情况危急。那我也不隐瞒了吧。"
                },
                {
                    "id": "722330107",
                    "speaker": "派蒙",
                    "text": "你根本就没想隐瞒吧！"
                },
                {
                    "id": "722330108",
                    "speaker": "露子",
                    "text": "之前虽然初步取得了「月浴渊之钥」，渊下宫正在缓慢苏醒。但是因为人手不足的原因，调查推进还是很慢。"
                },
                {
                    "id": "722330109",
                    "speaker": "露子",
                    "text": "毕竟最近还是特殊时期嘛，和鸣神岛的关系不知能不能缓和。"
                },
                {
                    "id": "722330110",
                    "speaker": "Player",
                    "text": "那，多我一个也不多…"
                },
                {
                    "id": "722330111",
                    "speaker": "露子",
                    "text": "那可不一样哦。要知道根据传统，取珊瑚最需要的人，就是「勇者」。"
                },
                {
                    "id": "722330112",
                    "speaker": "露子",
                    "text": "先建立根据地，然后协助「勇者」沿着先人足迹探索，最后迎来试炼。"
                },
                {
                    "id": "722330113",
                    "speaker": "露子",
                    "text": "所谓稳扎稳打的策略就是这样了。"
                },
                {
                    "id": "722330114",
                    "speaker": "派蒙",
                    "text": "但是因为最近人手不足，所以没办法探索咯。"
                },
                {
                    "id": "722330115",
                    "speaker": "露子",
                    "text": "正是如此，最关键的「勇者」现在连根头发丝都看不到呢。"
                },
                {
                    "id": "722330116",
                    "speaker": "露子",
                    "text": "现在好像看到了。似乎是一缕…一缕金发！"
                },
                {
                    "id": "722330117",
                    "speaker": "派蒙",
                    "text": "呜啊，听起来好麻烦的样子。根本不想趟这趟水。"
                },
                {
                    "id": "722330118",
                    "speaker": "露子",
                    "text": "不过探索通常都会发现一些奇珍异宝。按照惯例，拿到了都是要上缴珊瑚宫家的。"
                },
                {
                    "id": "722330119",
                    "speaker": "露子",
                    "text": "如果这次你下去找到点什么的话，咱们睁一只眼闭一只眼也不是不可以…",
                    "choices": [
                        {
                            "id": "722330120",
                            "text": "要不两只眼一起闭上吧。",
                            "response": [
                                {
                                    "id": "722330122",
                                    "speaker": "露子",
                                    "text": "英雄，大侠，好汉，救世主！这么说您是同意咯？"
                                },
                                {
                                    "id": "722330123",
                                    "speaker": "派蒙",
                                    "text": "我们怎么能对珊瑚宫的危险视而不见呢！"
                                },
                                {
                                    "id": "722330124",
                                    "speaker": "露子",
                                    "text": "您这么说是最好不过了。看来按照心海大人教的话术，确实能哄到人啊。"
                                },
                                {
                                    "id": "722330125",
                                    "speaker": "露子",
                                    "text": "珊瑚宫大人甚至连你们会回来找我也预料到了。"
                                },
                                {
                                    "id": "722330126",
                                    "speaker": "派蒙",
                                    "text": "你说什么？"
                                },
                                {
                                    "id": "722330127",
                                    "speaker": "露子",
                                    "text": "没什么没什么。那么请随我来，我来向您展示一个东西。"
                                },
                                {
                                    "id": "722330128",
                                    "speaker": "露子",
                                    "text": "我们就在前方下面的祭台那里见面吧。如果你看不到…"
                                },
                                {
                                    "id": "722330129",
                                    "speaker": "派蒙",
                                    "text": "如果看不到…"
                                },
                                {
                                    "id": "722330130",
                                    "speaker": "露子",
                                    "text": "就在东南方向，眯起眼睛看就看到啦。"
                                }
                            ]
                        },
                        {
                            "id": "722330121",
                            "text": "我和心海大人关系很好的！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7223302",
            "objective": "与露子对话",
            "dialogues": []
        },
        {
            "id": "7223303",
            "objective": "在祭坛处与露子对话",
            "dialogues": [
                {
                    "id": "722330201",
                    "speaker": "露子",
                    "text": "这个叫做「键纹」，是曾经渊下宫的通行纹章。只有当通路打开之时，它才会在地上浮现。"
                },
                {
                    "id": "722330202",
                    "speaker": "露子",
                    "text": "据说是渊下宫苏醒之时，为海祇岛之民递送的另一组钥匙。而这种键纹在珊瑚宫的记载里，一共有五种。"
                },
                {
                    "id": "722330203",
                    "speaker": "露子",
                    "text": "目前我们在海祇岛找到了其中的三种。如此操作之后就可以将其归位，解开封禁。"
                },
                {
                    "id": "722330204",
                    "speaker": "露子",
                    "text": "我们之前特地将这三个从键纹孔上拔了下来，并且放置到了海祇岛的其他地方。这样可以让屏障重新生效。"
                },
                {
                    "id": "722330205",
                    "speaker": "露子",
                    "text": "就是为了防止不懂事的熊孩子帮、愚人众间谍、鸣神岛居民和外乡人之类的家伙，偷偷潜下去。"
                },
                {
                    "id": "722330206",
                    "speaker": "露子",
                    "text": "哦，外乡人当然不包括您啦。哈哈哈…"
                },
                {
                    "id": "722330207",
                    "speaker": "露子",
                    "text": "现阶段没有办法和冒险家协会取得联系，所以冒险家都不给放下去哦。"
                },
                {
                    "id": "722330208",
                    "speaker": "派蒙",
                    "text": "你们还会放冒险家下去的吗？"
                },
                {
                    "id": "722330209",
                    "speaker": "露子",
                    "text": "历史上有这样的记录啦，合作共赢嘛。毕竟探索是他们和您的强项。"
                },
                {
                    "id": "722330210",
                    "speaker": "派蒙",
                    "text": "哦豁，也就是说这次没有别人抢跑的意思吧。"
                },
                {
                    "id": "722330211",
                    "speaker": "Player",
                    "text": "注意点吃相…"
                },
                {
                    "id": "722330212",
                    "speaker": "露子",
                    "text": "这怎么说呢…这种临时保护屏障挺不可靠的。因为从调查键纹位置到取出键纹的时间用得太久了，期间可能溜下去过几个人。"
                },
                {
                    "id": "722330213",
                    "speaker": "露子",
                    "text": "毕竟人手不够嘛…所以您在下面如果遇到愚人众、盗宝团、海乱鬼之类的，请毫不犹豫地把他们教训一顿吧。"
                },
                {
                    "id": "722330214",
                    "speaker": "派蒙",
                    "text": "如果他们这么容易就下去了，那之前我们拿到的月什么钥是为了什么啊。"
                },
                {
                    "id": "722330215",
                    "speaker": "露子",
                    "text": "只有取走「月浴渊之钥」，渊下宫才会转醒。同时只有用「月浴渊之钥」开门，试炼系统才会运作。"
                },
                {
                    "id": "722330216",
                    "speaker": "露子",
                    "text": "如果不是为了海祇御灵祭前往渊下宫，或许确实可以靠着外道邪法溜进去吧。"
                },
                {
                    "id": "722330217",
                    "speaker": "露子",
                    "text": "所以就希望你们能尽快动身，请去将海祇岛其他「键纹」取回吧。"
                },
                {
                    "id": "722330218",
                    "speaker": "露子",
                    "text": "键纹被我们放在了「海神之鳍」与「海神之心」处。而两座祭坛则在它们与珊瑚宫的连线里，坐落于月浴渊的第二重山垣上。"
                },
                {
                    "id": "722330219",
                    "speaker": "露子",
                    "text": "那么我就回到老地方静候您的消息了。"
                }
            ]
        },
        {
            "id": "7223311",
