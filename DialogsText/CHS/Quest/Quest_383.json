    "talks": [
        {
            "id": "38301",
            "objective": "前往晨曦酒庄",
            "dialogues": []
        },
        {
            "id": "38302",
            "objective": "与琴对话",
            "dialogues": [
                {
                    "id": "3830201",
                    "speaker": "派蒙",
                    "text": "唔吼——"
                },
                {
                    "id": "3830202",
                    "speaker": "派蒙",
                    "text": "「特瓦林保护协会」！再次集结！"
                },
                {
                    "id": "3830203",
                    "speaker": "温迪",
                    "text": "那么，快把收集到的结晶拿出来吧。"
                },
                {
                    "id": "3830204",
                    "speaker": "温迪",
                    "text": "啊…"
                },
                {
                    "id": "3830205",
                    "speaker": "温迪",
                    "text": "结晶的色泽似乎更加浑浊了…"
                },
                {
                    "id": "3830206",
                    "speaker": "温迪",
                    "text": "特瓦林…究竟在忍受怎样的折磨…"
                },
                {
                    "id": "3830207",
                    "speaker": "温迪",
                    "text": "总之，先把这些结晶净化吧。异邦的旅行者，拜托你了。"
                },
                {
                    "id": "3830208",
                    "speaker": "琴",
                    "text": "若不是亲眼所见，还真是难以置信…"
                },
                {
                    "id": "3830209",
                    "speaker": "迪卢克",
                    "text": "很有意思。就像滤酒一样，令人神清气爽。"
                },
                {
                    "id": "3830210",
                    "speaker": "温迪",
                    "text": "有这么多泪滴就够了。那么接下来…"
                }
            ]
        },
        {
            "id": "38303",
            "objective": "将风龙泪滴滴在天空之琴上",
            "dialogues": [
                {
                    "id": "3830301",
                    "speaker": "温迪",
                    "text": "#好了，{NICKNAME}赶紧修复天空之琴吧！"
                }
            ]
        },
        {
            "id": "38304",
            "objective": "(test)继续与琴对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3830401",
                    "speaker": "派蒙",
                    "text": "成功啦！"
                },
                {
                    "id": "3830402",
                    "speaker": "琴",
                    "text": "和原先的感觉完全不一样了。"
                },
                {
                    "id": "3830403",
                    "speaker": "温迪",
                    "text": "风元素…满溢到了活泼的程度呢。这样的话应该没问题了。"
                },
                {
                    "id": "3830404",
                    "speaker": "温迪",
                    "text": "#多亏了你呀，{NICKNAME}。"
                },
                {
                    "id": "3830405",
                    "speaker": "琴",
                    "text": "那么，我们该在哪里呼唤风魔龙？"
                },
                {
                    "id": "3830406",
                    "speaker": "琴",
                    "text": "在蒙德城内肯定不行，如果失败，就会造成难以弥补的损失。"
                },
                {
                    "id": "3830407",
                    "speaker": "琴",
                    "text": "就在这酒庄的话，显然也…"
                },
                {
                    "id": "3830408",
                    "speaker": "迪卢克",
                    "text": "哦。酒庄没了倒也不是什么难以弥补的损失，但最好不要。"
                },
                {
                    "id": "3830409",
                    "speaker": "琴",
                    "text": "……"
                },
                {
                    "id": "3830410",
                    "speaker": "温迪",
                    "text": "海风或者高处的风，都可以让诗人的歌声传颂得更远。"
                },
                {
                    "id": "3830411",
                    "speaker": "温迪",
                    "text": "如果空气干燥、沉闷又压抑，那不仅诗人，就连龙都会生气吧。"
                },
                {
                    "id": "3830412",
                    "speaker": "派蒙",
                    "text": "原来如此。海风或者高处的风，是吗？"
                },
                {
                    "id": "3830413",
                    "speaker": "派蒙",
                    "text": "所以，最适合弹奏的地方应该就是…",
                    "choices": [
                        {
                            "id": "3830414",
                            "text": "悬崖？",
                            "response": [
                                {
                                    "id": "3830418",
                                    "speaker": "迪卢克",
                                    "text": "从星落湖向东一段距离，在海滩的南方有一片山地。"
                                },
                                {
                                    "id": "3830419",
                                    "speaker": "派蒙",
                                    "text": "…啊！是在说你上次睡懒觉的那片海滩呢。"
                                },
                                {
                                    "id": "3830420",
                                    "speaker": "迪卢克",
                                    "text": "沿着山地延伸的方向攀登，可以抵达一个叫做<color=#00E1FFFF>摘星崖</color>的地方。"
                                },
                                {
                                    "id": "3830421",
                                    "speaker": "迪卢克",
                                    "text": "歌手，你想要的海风与高处的风，在那里都能找到吧。"
                                },
                                {
                                    "id": "3830422",
                                    "speaker": "温迪",
                                    "text": "嗯，我想想，摘星崖是吧…"
                                },
                                {
                                    "id": "3830423",
                                    "speaker": "温迪",
                                    "text": "…确实是很不错的位置呢，是个很衬我歌声的地方。"
                                },
                                {
                                    "id": "3830424",
                                    "speaker": "琴",
                                    "text": "很好。那我们就做好准备，在摘星崖集合吧。"
                                },
                                {
                                    "id": "3830425",
                                    "speaker": "琴",
                                    "text": "还请大家认真对待，不要迟到。"
                                },
                                {
                                    "id": "3830426",
                                    "speaker": "派蒙",
                                    "text": "遵命，团长大人！"
                                },
                                {
                                    "id": "3830427",
                                    "speaker": "琴",
                                    "text": "啊…抱歉，一不小心就…"
                                }
                            ]
                        },
                        {
                            "id": "3830415",
                            "text": "海边？"
                        },
                        {
                            "id": "3830416",
                            "text": "在天上一边滑翔一边弹？",
                            "response": [
                                {
                                    "id": "3830417",
                                    "speaker": "琴",
                                    "text": "那种事连安柏都做不到吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}