            "dialogues": [
                {
                    "id": "752510101",
                    "speaker": "帕帕",
                    "text": "喝！海内兄弟，继续喝！"
                },
                {
                    "id": "752510102",
                    "speaker": "派蒙",
                    "text": "呜哇！你是谁？怎么从树上掉下来了！"
                },
                {
                    "id": "752510103",
                    "speaker": "帕帕",
                    "text": "我是帕帕啊，海内兄弟，我们不是说好再喝一轮吗，今天我们相见恨晚…"
                },
                {
                    "id": "752510104",
                    "speaker": "帕帕",
                    "text": "唔…？嗯…？"
                },
                {
                    "id": "752510105",
                    "speaker": "Player",
                    "text": "嗯…？"
                },
                {
                    "id": "752510106",
                    "speaker": "帕帕",
                    "text": "海内兄弟，你怎么变成两个了？一个高个头海内…一个矮个头海内…"
                },
                {
                    "id": "752510107",
                    "speaker": "派蒙",
                    "text": "喂！你认错人了吧！"
                },
                {
                    "id": "752510108",
                    "speaker": "帕帕",
                    "text": "欸？噢…"
                },
                {
                    "id": "752510109",
                    "speaker": "帕帕",
                    "text": "海内兄！你在哪？我们继续喝啊！"
                },
                {
                    "id": "752510110",
                    "speaker": "Black Screen",
                    "text": "从树上掉下的醉汉摇摇晃晃地走远了。"
                }
            ]
        },
