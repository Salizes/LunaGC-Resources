    "talks": [
        {
            "id": "1111101",
            "objective": "回往生堂向老孟了解情况",
            "dialogues": [
                {
                    "id": "111110101",
                    "speaker": "胡桃",
                    "text": "老孟，我回来啦！很遗憾，还是没找到狼哥。"
                },
                {
                    "id": "111110102",
                    "speaker": "老孟",
                    "text": "这样啊，那就麻烦了。我们能猜到的地方，算是都找过了一遍了…"
                },
                {
                    "id": "111110103",
                    "speaker": "派蒙",
                    "text": "狼哥到底是谁啊？"
                },
                {
                    "id": "111110104",
                    "speaker": "老孟",
                    "text": "我还是从头开始解释吧。我的老家就在无妄坡附近，小时候，我有几个玩得很好的朋友。"
                },
                {
                    "id": "111110105",
                    "speaker": "老孟",
                    "text": "狼哥，就是其中之一，和我关系特别好，形影不离。可是，某一天因为意外，他不幸去世了。"
                },
                {
                    "id": "111110106",
                    "speaker": "老孟",
                    "text": "我总是忘不了这件事，可能因为我是个特别恋旧的人吧，所以我现在也经常回无妄坡看看。"
                },
                {
                    "id": "111110107",
                    "speaker": "老孟",
                    "text": "但就在前段时间我从无妄坡回来之后，我就觉得很不舒服，而且每天晚上的梦里，狼哥都会出现。"
                },
                {
                    "id": "111110108",
                    "speaker": "老孟",
                    "text": "我就觉得，是不是我惊动了他？",
                    "choices": [
                        {
                            "id": "111110109",
                            "text": "听着很像幻想故事。",
                            "response": [
                                {
                                    "id": "111110111",
                                    "speaker": "老孟",
                                    "text": "可能吧，虽然我没有证据，但我怎么都放心不下来，越想越担心。"
                                },
                                {
                                    "id": "111110112",
                                    "speaker": "老孟",
                                    "text": "想到孩提时代的友人，有可能变成了恶鬼，这种事怎么能接受啊？"
                                },
                                {
                                    "id": "111110113",
                                    "speaker": "胡桃",
                                    "text": "他就是因为这个原因，才加入的往生堂。拜这件事所赐，我也不用给他付工钱。"
                                },
                                {
                                    "id": "111110114",
                                    "speaker": "胡桃",
                                    "text": "不过，老孟说的这种事是有可能的，因为确实时不时就会有鬼灵在现世游荡。"
                                },
                                {
                                    "id": "111110115",
                                    "speaker": "胡桃",
                                    "text": "但恶鬼什么的，纯粹就是自己吓唬自己了，我自己都没有碰到过几次恶鬼呢。"
                                },
                                {
                                    "id": "111110116",
                                    "speaker": "老孟",
                                    "text": "可是，这也不能证明狼哥的事没有危险，我真的很不想看到他去到处害人。"
                                },
                                {
                                    "id": "111110117",
                                    "speaker": "胡桃",
                                    "text": "你们看，就是这样，如果不能把狼哥找出来的话，我说什么老孟都听不进去。"
                                },
                                {
                                    "id": "111110118",
                                    "speaker": "胡桃",
                                    "text": "刚刚我们找的那几个人，同样也是老孟的童年好友，本来以为狼哥会藏在他们那里，结果又扑了个空。"
                                },
                                {
                                    "id": "111110119",
                                    "speaker": "老孟",
                                    "text": "无妄坡附近也找了，以前的朋友也找了，这下线索是彻底断了…"
                                },
                                {
                                    "id": "111110120",
                                    "speaker": "？？？",
                                    "text": "抱歉，抱歉，请问你们是往生堂的人吗？"
                                },
                                {
                                    "id": "111110121",
                                    "speaker": "洛成",
                                    "text": "我叫洛成，我最近感觉很不对劲，感觉有什么东西在盯着我。"
                                },
                                {
                                    "id": "111110122",
                                    "speaker": "洛成",
                                    "text": "前几天我和朋友去无妄坡试胆，回来之后我就病倒了，每天都做噩梦，找医生也诊断不出毛病。"
                                },
                                {
                                    "id": "111110123",
                                    "speaker": "洛成",
                                    "text": "我这样，肯定是被诅咒了对吧！被魔神诅咒了！"
                                },
                                {
                                    "id": "111110124",
                                    "speaker": "胡桃",
                                    "text": "对对对，嗯，是的，魔神诅咒，可严重了。"
                                },
                                {
                                    "id": "111110125",
                                    "speaker": "洛成",
                                    "text": "你也知道对吧！就是那个，传说中在魔神战争中死去的魔神，对世间降下的痛苦诅咒。"
                                },
                                {
                                    "id": "111110126",
                                    "speaker": "洛成",
                                    "text": "只要无法驱逐这种诅咒，最后就会烧穿五脏，骨肉分离，下场非常凄惨！"
                                },
                                {
                                    "id": "111110127",
                                    "speaker": "洛成",
                                    "text": "传说里中了这种诅咒的症状，跟我现在简直是一模一样！"
                                },
                                {
                                    "id": "111110128",
                                    "speaker": "老孟",
                                    "text": "无妄坡，诅咒…不对，应该不是诅咒，多半是因为狼哥…"
                                },
                                {
                                    "id": "111110129",
                                    "speaker": "胡桃",
                                    "text": "唉，停一下停一下，你们两个，都就此打住，别再自说自话了。"
                                },
                                {
                                    "id": "111110130",
                                    "speaker": "派蒙",
                                    "text": "你才是最喜欢自说自话的人吧。"
                                },
                                {
                                    "id": "111110131",
                                    "speaker": "洛成",
                                    "text": "往生堂擅长解决这种鬼怪和魔神的事吧！能不能帮帮我！我还不想死！"
                                },
                                {
                                    "id": "111110132",
                                    "speaker": "胡桃",
                                    "text": "好啊，没问题，交给我吧，找我是找对人了。"
                                },
                                {
                                    "id": "111110133",
                                    "speaker": "胡桃",
                                    "text": "不过要解除诅咒需要一个合适的场地，还要提前做一点准备。"
                                },
                                {
                                    "id": "111110134",
                                    "speaker": "胡桃",
                                    "text": "新来的，我需要你帮我，跟我一起去吧。"
                                },
                                {
                                    "id": "111110135",
                                    "speaker": "老孟",
                                    "text": "那、那我也一起去…"
                                },
                                {
                                    "id": "111110136",
                                    "speaker": "胡桃",
                                    "text": "你先帮他做一下准备。焚香驱邪那一套，我教过你的。"
                                },
                                {
                                    "id": "111110137",
                                    "speaker": "胡桃",
                                    "text": "做完准备工作来找我。等这头忙完，我们再讨论狼哥的事。"
                                },
                                {
                                    "id": "111110138",
                                    "speaker": "老孟",
                                    "text": "好吧，只能这样了。"
                                },
                                {
                                    "id": "111110139",
                                    "speaker": "胡桃",
                                    "text": "那，我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "111110110",
                            "text": "这种事不存在吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111102",
            "objective": "前往驱咒地点",
            "dialogues": [
                {
                    "id": "111110201",
                    "speaker": "派蒙",
                    "text": "所以，神神秘秘的，到底要做什么啊？"
                },
                {
                    "id": "111110202",
                    "speaker": "胡桃",
                    "text": "什么都不做，在这儿等着。"
                },
                {
                    "id": "111110203",
                    "speaker": "派蒙",
                    "text": "欸？！"
                },
                {
                    "id": "111110204",
                    "speaker": "胡桃",
                    "text": "你不会把什么魔神诅咒的说法当真了吧？那种东西，早就被扑灭喽！"
                },
                {
                    "id": "111110205",
                    "speaker": "Player",
                    "text": "那我们为什么要到这里来？"
                },
                {
                    "id": "111110206",
                    "speaker": "胡桃",
                    "text": "你也看到那两个人了，一个觉得自己被诅咒，一个觉得挚友变成了恶鬼，都不好好听别人说话。"
                },
                {
                    "id": "111110207",
                    "speaker": "胡桃",
                    "text": "唉，所以我说，普通人什么都不知道才是最好的。"
                },
                {
                    "id": "111110208",
                    "speaker": "胡桃",
                    "text": "为这种事情绪失控的人，我见得太多了。想让人平静下来，必须让他们看到令人信服的东西。"
                },
                {
                    "id": "111110209",
                    "speaker": "胡桃",
                    "text": "面对相信鬼怪的人，就该当着他们的面消灭鬼怪。"
                },
                {
                    "id": "111110210",
                    "speaker": "派蒙",
                    "text": "唔…这话听起来像哄三岁小孩的把戏…",
                    "choices": [
                        {
                            "id": "111110211",
                            "text": "让普通人知晓一切或许更好？",
                            "response": [
                                {
                                    "id": "111110212",
                                    "speaker": "派蒙",
                                    "text": "对哦，如果说恐惧来源于未知的话。"
                                },
                                {
                                    "id": "111110216",
                                    "speaker": "胡桃",
                                    "text": "因为没有人能保证，把真相告诉无知之人，就能让现状变好而不是变糟。"
                                },
                                {
                                    "id": "111110217",
                                    "speaker": "胡桃",
                                    "text": "我要将靠近「边界」的人拉回去。既然是心理作用，就对症下药，当成心理作用来处理好了。"
                                },
                                {
                                    "id": "111110218",
                                    "speaker": "派蒙",
                                    "text": "倒是有点道理…那，诅咒的事又怎么说？"
                                },
                                {
                                    "id": "111110219",
                                    "speaker": "胡桃",
                                    "text": "这个嘛，你们听说过「夜叉」的历史吗？",
                                    "choices": [
                                        {
                                            "id": "111110220",
                                            "text": "没听过。",
                                            "response": [
                                                {
                                                    "id": "111110222",
                                                    "speaker": "胡桃",
                                                    "text": "他们曾经和魔神作战，打得眼花缭乱、昏天黑地。虽然魔神最后被击败，但它们的怨念久久不散。"
                                                },
                                                {
                                                    "id": "111110223",
                                                    "speaker": "胡桃",
                                                    "text": "有怨念化为瘟疫，在普通人之间传播开来，惶恐的人们都以为那是「魔神降下的诅咒」。"
                                                },
                                                {
                                                    "id": "111110224",
                                                    "speaker": "胡桃",
                                                    "text": "很多人被瘟疫夺去了性命，而这种瘟疫又以死去的人为温床，继续扩散。"
                                                },
                                                {
                                                    "id": "111110225",
                                                    "speaker": "胡桃",
                                                    "text": "后来有人发现了阻止瘟疫扩散的方法：净化空气，焚烧尸骸。而第一批开始做这种事的人，就是「往生堂」最初的创立者了。"
                                                },
                                                {
                                                    "id": "111110226",
                                                    "speaker": "派蒙",
                                                    "text": "原、原来是这样吗？"
                                                },
                                                {
                                                    "id": "111110227",
                                                    "speaker": "胡桃",
                                                    "text": "嗯，在那之后又过了许多年，那一场瘟疫终于被完全扑灭了。"
                                                },
                                                {
                                                    "id": "111110228",
                                                    "speaker": "胡桃",
                                                    "text": "类似的事件，历史上「往生堂」处理过很多次，最后的结果，都是让璃月的生死重新回到某种平衡。"
                                                },
                                                {
                                                    "id": "111110229",
                                                    "speaker": "胡桃",
                                                    "text": "简而言之，我们就像是「看门人」，不仅帮普通人看门，也帮不是人的东西看门，嘿嘿。",
                                                    "choices": [
                                                        {
                                                            "id": "111110230",
                                                            "text": "这就是「维护生死的边界」吗？",
                                                            "response": [
                                                                {
                                                                    "id": "111110232",
                                                                    "speaker": "胡桃",
                                                                    "text": "所以，「诅咒」只是心理作用，这我比谁都要清楚。但曾经存在这种事，也是不能告诉普通人的。"
                                                                },
                                                                {
                                                                    "id": "111110233",
                                                                    "speaker": "胡桃",
                                                                    "text": "我们稍微等一等吧，等会儿就用这个地脉镇石，演一出好戏。"
                                                                },
                                                                {
                                                                    "id": "111110234",
                                                                    "speaker": "胡桃",
                                                                    "text": "终于来了，我们也刚刚准备好。"
                                                                },
                                                                {
                                                                    "id": "111110235",
                                                                    "speaker": "胡桃",
                                                                    "text": "看，这就是用来驱邪的特殊装置，可以把诅咒从你的体内吸引出来，再具象化。"
                                                                },
                                                                {
                                                                    "id": "111110236",
                                                                    "speaker": "胡桃",
                                                                    "text": "不用担心会有危险，因为这边的旅行者是身经百战的。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "111110237",
                                                                            "text": "果然是我。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "111110239",
                                                                                    "speaker": "胡桃",
                                                                                    "text": "哦哦，对哦，忘记说了，哈哈，但是无所谓吧。"
                                                                                },
                                                                                {
                                                                                    "id": "111110240",
                                                                                    "speaker": "洛成",
                                                                                    "text": "这样真的就没问题了吗？"
                                                                                },
                                                                                {
                                                                                    "id": "111110241",
                                                                                    "speaker": "老孟",
                                                                                    "text": "相信堂主吧，虽然人看上去有点奇怪，但她做事是很认真的。"
                                                                                },
                                                                                {
                                                                                    "id": "111110242",
                                                                                    "speaker": "胡桃",
                                                                                    "text": "喂，怎么能用「奇怪」来形容我呀？至少也该是天真烂漫、不拘一格吧！"
                                                                                },
                                                                                {
                                                                                    "id": "111110243",
                                                                                    "speaker": "胡桃",
                                                                                    "text": "总之，速速开工！新来的，去启动装置。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "111110238",
                                                                            "text": "我可没听说过要战斗。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "111110231",
                                                            "text": "没想到还源远流长。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111110221",
                                            "text": "了解一点。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111110213",
                            "text": "派蒙今年几岁？",
                            "response": [
                                {
                                    "id": "111110214",
                                    "speaker": "派蒙",
                                    "text": "为什么突然问这个！"
                                },
                                {
                                    "id": "111110215",
                                    "speaker": "派蒙",
                                    "text": "我更关心为什么不能直接告诉大家真相！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111104",
            "objective": "守护地脉镇石，击退敌人",
            "dialogues": []
        },
        {
            "id": "1111105",
            "objective": "听胡桃对洛成讲述诅咒真相",
            "dialogues": [
                {
                    "id": "111110501",
                    "speaker": "胡桃",
                    "text": "怎么样，是不是觉得诅咒全都被驱散了？"
                },
                {
                    "id": "111110502",
                    "speaker": "洛成",
                    "text": "对，前所未有的舒畅！是健康的感觉！"
                },
                {
                    "id": "111110503",
                    "speaker": "洛成",
                    "text": "非常谢谢你，还有这位旅行者！不然我可能就真的因为诅咒暴毙了。"
                },
                {
                    "id": "111110504",
                    "speaker": "胡桃",
                    "text": "那，我现在就可以告诉你了——"
                },
                {
                    "id": "111110505",
                    "speaker": "胡桃",
                    "text": "锵锵！你被骗了！"
                },
                {
                    "id": "111110506",
                    "speaker": "洛成",
                    "text": "欸？怎、怎么了？"
                },
                {
                    "id": "111110507",
                    "speaker": "胡桃",
                    "text": "这个东西，一般人接触不到，但其实就是普通的地脉镇石啦，它很容易吸引怪物过来。"
                },
                {
                    "id": "111110508",
                    "speaker": "胡桃",
                    "text": "那些怪物也根本就不是什么诅咒的具象化，就是真正的怪物。"
                },
                {
                    "id": "111110509",
                    "speaker": "胡桃",
                    "text": "那就奇怪了，明明我什么都没做，你却感觉完全没事了，那说明什么呢？"
                },
                {
                    "id": "111110510",
                    "speaker": "洛成",
                    "text": "这、这个…难道，其实我没有被诅咒？"
                },
                {
                    "id": "111110511",
                    "speaker": "洛成",
                    "text": "可是，那我为什么会生病呢？"
                },
                {
                    "id": "111110512",
                    "speaker": "胡桃",
                    "text": "着凉了，吃了坏掉的东西，或者自己吓唬自己，都有可能…我倾向最后一种，是我这里的常见病哦。"
                },
                {
                    "id": "111110513",
                    "speaker": "老孟",
                    "text": "没想到是这样…"
                },
                {
                    "id": "111110514",
                    "speaker": "洛成",
                    "text": "我也没想到，但…总之还是要谢谢你。"
                },
                {
                    "id": "111110515",
                    "speaker": "胡桃",
                    "text": "道谢就不必了，以后不要这么疑神疑鬼的，我也不是每次都能找到合适的方法安慰你。"
                },
                {
                    "id": "111110516",
                    "speaker": "胡桃",
                    "text": "人这一辈子这么短，趁着还活着抓紧时间好好享受生活。"
                },
                {
                    "id": "111110517",
                    "speaker": "洛成",
                    "text": "这话怎么听着…有点怪。"
                },
                {
                    "id": "111110518",
                    "speaker": "洛成",
                    "text": "那、那我先走了，抱歉给你们添麻烦。"
                },
                {
                    "id": "111110519",
                    "speaker": "老孟",
                    "text": "看来不是狼哥干的，我稍微安心了一点。可是，只要狼哥没有下落，就不能阻止他乱来…"
                },
                {
                    "id": "111110520",
                    "speaker": "老孟",
                    "text": "既然这件事已经解决了，我们是不是可以继续去找狼哥了？"
                },
                {
                    "id": "111110521",
                    "speaker": "胡桃",
                    "text": "我觉得，应该没这个必要。"
                },
                {
                    "id": "111110522",
                    "speaker": "胡桃",
                    "text": "因为要找的人已经主动上门来了。"
                },
                {
                    "id": "111110523",
                    "speaker": "老孟",
                    "text": "狼、狼哥——？！"
                },
                {
                    "id": "111110524",
                    "speaker": "狼哥",
                    "text": "那、那个…抱歉，打扰你，还有你们了…"
                },
                {
                    "id": "111110525",
                    "speaker": "派蒙",
                    "text": "他就是狼哥？为什么是个小孩子？！"
                },
                {
                    "id": "111110526",
                    "speaker": "胡桃",
                    "text": "因为是幽灵嘛，理所当然地保持着他当年的样子。"
                },
                {
                    "id": "111110527",
                    "speaker": "派蒙",
                    "text": "呃，和「狼哥」这个名字给我留下的印象不太一样呢。"
                },
                {
                    "id": "111110528",
                    "speaker": "胡桃",
                    "text": "先带他回往生堂再说。接下来还有不少事要做。"
                }
            ]
        },
        {
            "id": "1111021",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111102101",
                    "speaker": "聪子",
                    "text": "还不走吗？那我真的要报告千岩军了。"
                }
            ]
        },
        {
            "id": "1111106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111110601",
                    "speaker": "洛成",
                    "text": "求求你们帮帮我，我还不想死啊。"
                },
                {
                    "id": "111110602",
                    "speaker": "老孟",
                    "text": "嗯，你不要着急，堂主是很厉害的人，会帮你想办法的。"
                }
            ]
        },
        {
            "id": "1111107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111110701",
                    "speaker": "观察装置",
                    "text": "（不管怎么看，都只是个普通的地脉镇石。）"
                }
            ]
        }
    ]
