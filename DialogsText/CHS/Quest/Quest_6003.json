        {
            "id": "600301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60030101",
                    "speaker": "派蒙",
                    "text": "看起来人都到齐了呢！"
                },
                {
                    "id": "60030102",
                    "speaker": "法尔伽",
                    "text": "#是的，我们都已经准备好了。{NICKNAME}，派蒙，你们呢？状态如何？"
                },
                {
                    "id": "60030103",
                    "speaker": "派蒙",
                    "text": "我准备好了！",
                    "choices": [
                        {
                            "id": "60030104",
                            "text": "我也准备好了！",
                            "response": [
                                {
                                    "id": "60030105",
                                    "speaker": "法尔伽",
                                    "text": "那太好了，马上进入正题吧。"
                                },
                                {
                                    "id": "60030113",
                                    "speaker": "法尔伽",
                                    "text": "那么，首先…"
                                },
                                {
                                    "id": "60030114",
                                    "speaker": "雅珂达",
                                    "text": "等等！"
                                },
                                {
                                    "id": "60030115",
                                    "speaker": "奈芙尔",
                                    "text": "有声音。"
                                },
                                {
                                    "id": "60030116",
                                    "speaker": "奈芙尔",
                                    "text": "我们听见你的脚步声了，不过嘛…"
                                },
                                {
                                    "id": "60030117",
                                    "speaker": "菲林斯",
                                    "text": "#您来这里有一会儿了，也许是跟着{NICKNAME}过来的？但您的气息，似乎不带有恶意。"
                                },
                                {
                                    "id": "60030118",
                                    "speaker": "奈芙尔",
                                    "text": "进来吧。"
                                },
                                {
                                    "id": "60030119",
                                    "speaker": "格迪米纳什",
                                    "text": "各位果然如我所想，反应快得很。"
                                },
                                {
                                    "id": "60030120",
                                    "speaker": "格迪米纳什",
                                    "text": "我奉「仆人」大人命令，前来传达她的口信。"
                                },
                                {
                                    "id": "60030121",
                                    "speaker": "「仆人」",
                                    "text": "多托雷佯装返回至冬，那显然是借口。但他并没回到月矩力试验设计局，也并未出现在那夏镇。"
                                },
                                {
                                    "id": "60030122",
                                    "speaker": "「木偶」",
                                    "text": "所以他只可能在最北面的那个实验室。哈，我说为什么他要申请自己的场地…原来是早有计划！"
                                },
                                {
                                    "id": "60030123",
                                    "speaker": "「仆人」",
                                    "text": "告诉他们，我和桑多涅先行一步。假如他们也关心此事的后续，那我们就在挪德卡莱最北方的研究所见。"
                                },
                                {
                                    "id": "60030124",
                                    "speaker": "法尔伽",
                                    "text": "那两位都是哥伦比娅小姐的至交，但她们行动前仍不忘与我们分享信息…诚挚感谢愚人众的帮助。"
                                },
                                {
                                    "id": "60030125",
                                    "speaker": "格迪米纳什",
                                    "text": "虽说「少女」大人已经脱离组织…但大人们对她的关心绝非虚假。何况，目前看来「博士」大人的行为充满谜团，我们必须关注。"
                                },
                                {
                                    "id": "60030126",
                                    "speaker": "格迪米纳什",
                                    "text": "我们常与人为敌，可那仅仅基于立场。人情与道义，我们向来都明白的。"
                                },
                                {
                                    "id": "60030127",
                                    "speaker": "格迪米纳什",
                                    "text": "各位是「少女」大人的朋友，有权知情。"
                                },
                                {
                                    "id": "60030128",
                                    "speaker": "奈芙尔",
                                    "text": "到底是最懂得审时度势的阿蕾奇诺，替我们省去了许多功夫。"
                                },
                                {
                                    "id": "60030129",
                                    "speaker": "格迪米纳什",
                                    "text": "地图我放在这里了。如果你们决定前往最北部的研究所，请务必注意安全。"
                                },
                                {
                                    "id": "60030130",
                                    "speaker": "格迪米纳什",
                                    "text": "务必记得，至少在挪德卡莱，「仆人」大人的下属可以是你们的同伴。"
                                },
                                {
                                    "id": "60030131",
                                    "speaker": "菲林斯",
                                    "text": "感谢您的周到。"
                                },
                                {
                                    "id": "60030132",
                                    "speaker": "格迪米纳什",
                                    "text": "分内之事罢了。那我就先告辞了，如有需要，可以到月矩力试验设计局找我们。"
                                },
                                {
                                    "id": "60030133",
                                    "speaker": "派蒙",
                                    "text": "「博士」离开了月矩力试验设计局，去了最北方的研究所…"
                                },
                                {
                                    "id": "60030134",
                                    "speaker": "法尔伽",
                                    "text": "「木偶」说「博士」早有准备，难道他在来挪德卡莱之前就有这个计划了吗？"
                                },
                                {
                                    "id": "60030135",
                                    "speaker": "菈乌玛",
                                    "text": "为女皇办事多半只是他的谎言。又或者，更简单一些——阳奉阴违。"
                                },
                                {
                                    "id": "60030136",
                                    "speaker": "奈芙尔",
                                    "text": "「博士」行事果断，作风狠辣歹毒，很不好对付。我们得做好准备。"
                                },
                                {
                                    "id": "60030137",
                                    "speaker": "菲林斯",
                                    "text": "现阶段，「博士」的行动难以预测。我建议兵分两路，留一些人守住那夏镇。"
                                },
                                {
                                    "id": "60030138",
                                    "speaker": "爱诺",
                                    "text": "唔…虽然很想帮忙啦，但我确实不是潜入研究所的最佳人选…"
                                },
                                {
                                    "id": "60030152",
                                    "speaker": "爱诺",
                                    "text": "但至少把「冷静一下鸭」带上吧！它应该能在战斗中帮到你们。"
                                },
                                {
                                    "id": "60030139",
                                    "speaker": "菲林斯",
                                    "text": "伊涅芙小姐是否和往常一样，决定留下保护爱诺小姐呢？"
                                },
                                {
                                    "id": "60030140",
                                    "speaker": "伊涅芙",
                                    "text": "检测到行动逻辑：保护爱诺，优先级：高。"
                                },
                                {
                                    "id": "60030141",
                                    "speaker": "菈乌玛",
                                    "text": "以防万一，法尔伽先生也留下比较好，研究所那边交给我们。"
                                },
                                {
                                    "id": "60030142",
                                    "speaker": "法尔伽",
                                    "text": "身为北风骑士，我不应在这种时候留守，但…好吧。"
                                },
                                {
                                    "id": "60030143",
                                    "speaker": "法尔伽",
                                    "text": "那夏镇交给我。几位也请务必注意安全，如果情况不可控，一定要及时撤退。"
                                },
                                {
                                    "id": "60030144",
                                    "speaker": "奈芙尔",
                                    "text": "雅珂达也会帮各位的。我不在的时候，情报工作就交给她了。"
                                },
                                {
                                    "id": "60030145",
                                    "speaker": "雅珂达",
                                    "text": "明白了老板。你们要安全回来哦！"
                                },
                                {
                                    "id": "60030146",
                                    "speaker": "菈乌玛",
                                    "text": "我们会的。"
                                },
                                {
                                    "id": "60030147",
                                    "speaker": "菲林斯",
                                    "text": "夜长梦多，早点出发比较好。",
                                    "choices": [
                                        {
                                            "id": "60030148",
                                            "text": "这次情况可能很凶险…",
                                            "response": [
                                                {
                                                    "id": "60030150",
                                                    "speaker": "派蒙",
                                                    "text": "潜入任务，还是研究所的话…好吧，既然你们打算狠狠打一场恶战，那我就帮其他人忙好了。"
                                                },
                                                {
                                                    "id": "60030151",
                                                    "speaker": "奈芙尔",
                                                    "text": "我们都得尽全力了。在那之前，你有没有没做完的事？",
                                                    "choices": [
                                                        {
                                                            "id": "60030401",
                                                            "text": "还有一些事…"
                                                        },
                                                        {
                                                            "id": "60030601",
                                                            "text": "我随时可以行动！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "60030149",
                                            "text": "派蒙留下帮大家吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "60030106",
                            "text": "好，再确认一下议题如何？",
                            "response": [
                                {
                                    "id": "60030107",
                                    "speaker": "法尔伽",
                                    "text": "哈哈，是不是有点紧张？那也不怪你，我们大家都是第一次碰到这种事。"
                                },
                                {
                                    "id": "60030108",
                                    "speaker": "法尔伽",
                                    "text": "哥伦比娅小姐不久前刚遭到「博士」袭击…而在那短暂的瞬间，你看到她消失在了那个「月亮倒影」内。"
                                },
                                {
                                    "id": "60030109",
                                    "speaker": "菈乌玛",
                                    "text": "嗯。事件发生时，我们所有人都只看到「博士」出现并使用了某种力量。随后哥伦比娅就消失了，你也从空中坠入大海。"
                                },
                                {
                                    "id": "60030110",
                                    "speaker": "法尔伽",
                                    "text": "必须救回哥伦比娅小姐，此外，愚人众执行官「博士」夺取三月的权柄一定有其目的。我们必须阻止他。"
                                },
                                {
                                    "id": "60030111",
                                    "speaker": "菈乌玛",
                                    "text": "寻回「月神」原本是我们霜月之子的职责，没想到大家都愿意帮忙…我谨代表霜月之子，向诸位送上谢意。"
                                },
                                {
                                    "id": "60030112",
                                    "speaker": "Player",
                                    "text": "（删除）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "600399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60039901",
                    "speaker": "派蒙",
                    "text": "时间差不多啦，该到秘闻馆去了。"
                },
                {
                    "id": "60039902",
                    "speaker": "派蒙",
                    "text": "我们得讨论非常重要的事，你应该还记得吧？"
                },
                {
                    "id": "60039903",
                    "speaker": "奈芙尔",
                    "text": "地上有很多被打坏的机关。有人先到了，难道是阿蕾奇诺和桑多涅？"
                }
            ]
        }
    ]
}