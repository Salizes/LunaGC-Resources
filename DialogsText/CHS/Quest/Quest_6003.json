        {
            "id": "600311",
            "objective": "撤离「博士」的研究所",
            "dialogues": [
                {
                    "id": "60031101",
                    "speaker": "「仆人」",
                    "text": "在未完成的人工月髓加持下，多托雷的力量已经达到我们无法匹敌的地步…不要恋战。"
                },
                {
                    "id": "60031102",
                    "speaker": "「仆人」",
                    "text": "抓紧时机！"
                },
                {
                    "id": "60031103",
                    "speaker": "菲林斯",
                    "text": "走！"
                },
                {
                    "id": "60031104",
                    "speaker": "「博士」",
                    "text": "逃跑比投降明智，我向来这样认为。"
                },
                {
                    "id": "60031105",
                    "speaker": "Player",
                    "text": "这是…"
                },
                {
                    "id": "60031106",
                    "speaker": "「仆人」",
                    "text": "小心！"
                },
                {
                    "id": "60031107",
                    "speaker": "Player",
                    "text": "别管我，你们——"
                },
                {
                    "id": "60031108",
                    "speaker": "奈芙尔",
                    "text": "#{NICKNAME}人呢？！"
                },
                {
                    "id": "60031109",
                    "speaker": "「仆人」",
                    "text": "啧…"
                },
                {
                    "id": "60031110",
                    "speaker": "菲林斯",
                    "text": "突破不了的话，只能先撤退。"
                }
            ]
        },
        {
            "id": "600306",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
