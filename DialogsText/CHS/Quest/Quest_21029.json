    "talks": [
        {
            "id": "2102901",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210290101",
                    "speaker": "小蒙",
                    "text": "呜哇！怎么…怎么又失败了…"
                },
                {
                    "id": "210290102",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "210290103",
                    "speaker": "小蒙",
                    "text": "#欸？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你呀。"
                },
                {
                    "id": "210290104",
                    "speaker": "小蒙",
                    "text": "你上次不是教我烹饪了吗？我正在尝试做那道菜呢，不过…到现在还没成功过…"
                },
                {
                    "id": "210290105",
                    "speaker": "小蒙",
                    "text": "我觉得，也许是因为我用的烹饪材料不对…"
                },
                {
                    "id": "210290106",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能再指导我一下吗？",
                    "choices": [
                        {
                            "id": "210290107",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "210290109",
                                    "speaker": "小蒙",
                                    "text": "这次…就做「野菇鸡肉串」好了！"
                                },
                                {
                                    "id": "210290110",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们这次用什么特别的食材呢？"
                                }
                            ]
                        },
                        {
                            "id": "210290108",
                            "text": "你要做什么菜？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102902",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210290901",
                    "speaker": "小蒙",
                    "text": "#那就拜托你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，请你帮我找找这些食材吧。"
                },
                {
                    "id": "210290902",
                    "speaker": "小蒙",
                    "text": "希望这道菜能好吃一点…"
                }
            ]
        },
        {
            "id": "2102903",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2102904",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2102905",
            "objective": "将绝云椒椒交给小蒙",
            "dialogues": []
        },
        {
            "id": "2102906",
            "objective": "将甜甜花交给小蒙",
            "dialogues": []
        },
        {
            "id": "2102907",
            "objective": "将史莱姆凝液交给小蒙",
            "dialogues": [
                {
                    "id": "210290701",
                    "speaker": "Player",
                    "text": "甜甜花。"
                },
                {
                    "id": "210290702",
                    "speaker": "派蒙",
                    "text": "要让这道菜再甜一点吗？"
                },
                {
                    "id": "210290703",
                    "speaker": "派蒙",
                    "text": "吃到甜甜的东西，确实能让人感觉很愉快。"
                },
                {
                    "id": "210290704",
                    "speaker": "派蒙",
                    "text": "那我们就去找几朵甜甜花来吧。"
                }
            ]
        },
        {
            "id": "2102908",
            "objective": "指导小蒙进行烹饪",
            "dialogues": [
                {
                    "id": "210291101",
                    "speaker": "小蒙",
                    "text": "太好了，那我们就快点开始做菜吧！"
                },
                {
                    "id": "210291102",
                    "speaker": "小蒙",
                    "text": "呜哇！好辣！水、水在哪，我要喝点水…"
                },
                {
                    "id": "210291103",
                    "speaker": "派蒙",
                    "text": "看来，绝云椒椒是放太多了呢…"
                },
                {
                    "id": "210291104",
                    "speaker": "小蒙",
                    "text": "呼…好了…"
                },
                {
                    "id": "210291105",
                    "speaker": "小蒙",
                    "text": "除了有些辣之外，我觉得这道菜的味道还不错呢。"
                },
                {
                    "id": "210291106",
                    "speaker": "小蒙",
                    "text": "而且，这么辣的味道，好像也有助于…提神？",
                    "choices": [
                        {
                            "id": "210291107",
                            "text": "还是少放点绝云椒椒吧。",
                            "response": [
                                {
                                    "id": "210291109",
                                    "speaker": "小蒙",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我会把这种做法记下来的。"
                                },
                                {
                                    "id": "210291110",
                                    "speaker": "小蒙",
                                    "text": "等我和爸爸去旅行的时候，再找机会做给他吃！"
                                },
                                {
                                    "id": "210291111",
                                    "speaker": "小蒙",
                                    "text": "嗯…爸爸能不能吃辣的来着？应该可以吧…"
                                }
                            ]
                        },
                        {
                            "id": "210291108",
                            "text": "味道过得去就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102909",
            "objective": "指导小蒙进行烹饪",
            "dialogues": [
                {
                    "id": "210291201",
                    "speaker": "小蒙",
                    "text": "太好了，那我们就快点开始做菜吧！"
                },
                {
                    "id": "210291202",
                    "speaker": "小蒙",
                    "text": "唔…这种甜甜的味道感觉还不错呢。"
                },
                {
                    "id": "210291203",
                    "speaker": "派蒙",
                    "text": "#味道确实很不错…嘿嘿，{NICKNAME}果然在烹饪上很有天赋。",
                    "choices": [
                        {
                            "id": "210291204",
                            "text": "只是普通的调味方法。",
                            "response": [
                                {
                                    "id": "210291206",
                                    "speaker": "小蒙",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我会把这种做法记下来的。"
                                },
                                {
                                    "id": "210291207",
                                    "speaker": "小蒙",
                                    "text": "等我和爸爸去旅行的时候，再找机会做给他吃！"
                                },
                                {
                                    "id": "210291208",
                                    "speaker": "小蒙",
                                    "text": "呜哇，不对，爸爸本来就不让我吃甜的…这道菜的做法不能让他知道…"
                                }
                            ]
                        },
                        {
                            "id": "210291205",
                            "text": "你们喜欢就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102910",
            "objective": "指导小蒙进行烹饪",
            "dialogues": [
                {
                    "id": "210291301",
                    "speaker": "小蒙",
                    "text": "太好了，那我们就快点开始做菜吧！"
                },
                {
                    "id": "210291302",
                    "speaker": "小蒙",
                    "text": "这、这道菜变得好奇怪…"
                },
                {
                    "id": "210291303",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，这…这道菜真的能吃吗…"
                },
                {
                    "id": "210291304",
                    "speaker": "派蒙",
                    "text": "肯定会很好吃的！",
                    "choices": [
                        {
                            "id": "210291305",
                            "text": "不然…还是尝尝看？",
                            "response": [
                                {
                                    "id": "210291307",
                                    "speaker": "小蒙",
                                    "text": "#好、好…我等会自己尝尝看，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                                },
                                {
                                    "id": "210291308",
                                    "speaker": "小蒙",
                                    "text": "对了，不如先让爸爸来试吃一下吧…"
                                }
                            ]
                        },
                        {
                            "id": "210291306",
                            "text": "应该…可以吃吧…"
                        }
                    ]
                }
            ]
        },
