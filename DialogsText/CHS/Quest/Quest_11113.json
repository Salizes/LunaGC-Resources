    "talks": [
        {
            "id": "1111301",
            "objective": "将信物带去无妄坡，交给胡桃",
            "dialogues": [
                {
                    "id": "111130101",
                    "speaker": "胡桃",
                    "text": "哦——！回来啦？比我想的还快！"
                },
                {
                    "id": "111130102",
                    "speaker": "胡桃",
                    "text": "派蒙，没有说漏嘴吧？"
                },
                {
                    "id": "111130103",
                    "speaker": "派蒙",
                    "text": "我看起来有这么不可靠吗！"
                },
                {
                    "id": "111130104",
                    "speaker": "胡桃",
                    "text": "嘿嘿，开玩笑的，其实没关系，他们愿意拿出信物，就说明他们多少猜到了一些。"
                },
                {
                    "id": "111130105",
                    "speaker": "胡桃",
                    "text": "不过，幽灵和亡魂相关的事，无论发生什么，都是奇怪的，同时也是不奇怪的。"
                },
                {
                    "id": "111130106",
                    "speaker": "胡桃",
                    "text": "他们不愿深究也是因为这一原因吧。要是真敢跟来，那…可就触碰到我的底线喽。",
                    "choices": [
                        {
                            "id": "111130107",
                            "text": "听上去有点吓人。",
                            "response": [
                                {
                                    "id": "111130109",
                                    "speaker": "胡桃",
                                    "text": "「维护生死的边界」，这是往生堂最重要的工作内容嘛，我也会稍微比平时认真一点。"
                                },
                                {
                                    "id": "111130110",
                                    "speaker": "派蒙",
                                    "text": "原来我们已经是特例了吗？跨越这种「边界」也没关系了？"
                                },
                                {
                                    "id": "111130111",
                                    "speaker": "胡桃",
                                    "text": "那是当然，毕竟你们已经被卷进来了，和老孟一样，不在乎让你们多看点东西。"
                                },
                                {
                                    "id": "111130112",
                                    "speaker": "胡桃",
                                    "text": "接下来要去的地方，无论看到什么，发生什么，都不要觉得惊讶。"
                                },
                                {
                                    "id": "111130113",
                                    "speaker": "胡桃",
                                    "text": "那是存在于生死边界的平凡之地。要说特别之处，也就是不为人知而已。"
                                },
                                {
                                    "id": "111130114",
                                    "speaker": "胡桃",
                                    "text": "千万千万不要大惊小怪哦？否则出来之前，我就得为你们清理记忆了。"
                                },
                                {
                                    "id": "111130115",
                                    "speaker": "胡桃",
                                    "text": "走吧！听话一点对大家都好。"
                                },
                                {
                                    "id": "111130116",
                                    "speaker": "派蒙",
                                    "text": "有、有点吓人…"
                                },
                                {
                                    "id": "111130117",
                                    "speaker": "派蒙",
                                    "text": "但就像她说的，我们已经被卷进来了，就走到最后吧。"
                                }
                            ]
                        },
                        {
                            "id": "111130108",
                            "text": "不知道你是认真的还是开玩笑。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111302",
            "objective": "前往胡桃所说的「寻常之地」",
            "dialogues": [
                {
                    "id": "111130201",
                    "speaker": "胡桃",
                    "text": "(test)进入夹缝"
                }
            ]
        },
        {
            "id": "1111306",
            "objective": "（test）通过第一个降魔印机关$HIDDEN",
            "dialogues": [
                {
                    "id": "111130601",
                    "speaker": "派蒙",
                    "text": "终于过来了，我还以为我们被困在了诡异的空间里面呢。"
                },
                {
                    "id": "111130602",
                    "speaker": "胡桃",
                    "text": "就是要给人这样的感觉，才能把擅闯者吓跑嘛。"
                },
                {
                    "id": "111130603",
                    "speaker": "派蒙",
                    "text": "之后应该不会再有什么古怪的东西了吧？"
                },
                {
                    "id": "111130604",
                    "speaker": "胡桃",
                    "text": "嗯，只需要从前面跳下去。"
                },
                {
                    "id": "111130605",
                    "speaker": "派蒙",
                    "text": "欸欸——？！"
                }
            ]
        },
        {
            "id": "1111308",
            "objective": "（test）通过第二个降魔印机关$HIDDEN",
            "dialogues": [
                {
                    "id": "111130801",
                    "speaker": "狼哥",
                    "text": "哇，这上面居然有我们五个人的名字？"
                },
                {
                    "id": "111130802",
                    "speaker": "狼哥",
                    "text": "嘿嘿，真好。对了，刚刚听你说每一年都会放灯，那以后上面的名字会不会越来越多？"
                },
                {
                    "id": "111130803",
                    "speaker": "狼哥",
                    "text": "比如，小五的孩子，木木的妻子之类的。"
                },
                {
                    "id": "111130804",
                    "speaker": "老孟",
                    "text": "其实确实有个好消息，木木他马上就要当爸爸了，最近总是在说这件事，好像既开心又紧张。"
                },
                {
                    "id": "111130805",
                    "speaker": "狼哥",
                    "text": "哈哈哈，他这么木讷的人，能当好爸爸吗？"
                },
                {
                    "id": "111130806",
                    "speaker": "老孟",
                    "text": "不不不，他现在精明得很，我来好好给你讲讲——"
                }
            ]
        },
        {
            "id": "1111303",
            "objective": "沿路深入，前往边界",
            "dialogues": []
        },
        {
            "id": "1111304",
            "objective": "继续向前，见证欢送仪式",
            "dialogues": [
                {
                    "id": "111130401",
                    "speaker": "回忆中的小五",
                    "text": "又是海灯节，要是有一天能真的去看灯就好了。"
                },
                {
                    "id": "111130402",
                    "speaker": "回忆中的聪子",
                    "text": "没有灯也可以许愿啊，我妈妈告诉我的，只要大声喊出来，梦想就会在未来实现。"
                },
                {
                    "id": "111130403",
                    "speaker": "回忆中的狼哥",
                    "text": "大声喊出来，是不是…有点丢脸？"
                },
                {
                    "id": "111130404",
                    "speaker": "回忆中的老孟",
                    "text": "你需要有人帮你起个头，大家都喊了，你就不会害羞了。"
                },
                {
                    "id": "111130405",
                    "speaker": "回忆中的聪子",
                    "text": "对对对，那小五，你先来。"
                },
                {
                    "id": "111130406",
                    "speaker": "回忆中的小五",
                    "text": "那…那我想，开一家大大的餐馆，有吃不完的饭菜还有点心！天天都能吃香嫩椒椒鸡！"
                },
                {
                    "id": "111130407",
                    "speaker": "回忆中的木木",
                    "text": "哈哈哈，瞧你这出息。"
                },
                {
                    "id": "111130408",
                    "speaker": "回忆中的小五",
                    "text": "你笑我，那你呢？"
                },
                {
                    "id": "111130409",
                    "speaker": "回忆中的木木",
                    "text": "那当然是赚钱！做大生意，赚很多很多钱！有钱了想干什么干什么，有钱了多开心啊！"
                },
                {
                    "id": "111130410",
                    "speaker": "回忆中的老孟",
                    "text": "对啊，有了钱，那个超贵的玩具箱，不也是想买就能买？"
                },
                {
                    "id": "111130411",
                    "speaker": "回忆中的木木",
                    "text": "不仅要买，还一人一个，不，一人好几个！"
                },
                {
                    "id": "111130412",
                    "speaker": "回忆中的聪子",
                    "text": "那既然木木要当大商人，我就没必要赚钱了吧。"
                },
                {
                    "id": "111130413",
                    "speaker": "回忆中的木木",
                    "text": "不行不行，赚钱很辛苦的，别光指望我一个人啊！"
                },
                {
                    "id": "111130414",
                    "speaker": "回忆中的聪子",
                    "text": "我以后，想学做明霄灯，就是好大好大的那个。霄灯我也要学，到时候当最好的工匠。"
                },
                {
                    "id": "111130415",
                    "speaker": "回忆中的狼哥",
                    "text": "对哦，这样我们就不用去璃月港，也可以放霄灯过节了！"
                },
                {
                    "id": "111130416",
                    "speaker": "回忆中的小五",
                    "text": "说了这么多，老孟，狼哥，你们两个呢？"
                },
                {
                    "id": "111130417",
                    "speaker": "回忆中的狼哥",
                    "text": "我啊…"
                },
                {
                    "id": "111130418",
                    "speaker": "派蒙",
                    "text": "啊，都消失了，最关键的东西没听到。"
                },
                {
                    "id": "111130419",
                    "speaker": "老孟",
                    "text": "真怀念啊，这是我们最后一次，五个人一起过的海灯节吧。"
                },
                {
                    "id": "111130420",
                    "speaker": "狼哥",
                    "text": "都已经过去这么久了，大家都长大了…"
                },
                {
                    "id": "111130421",
                    "speaker": "狼哥",
                    "text": "不知道当时喊出来的这些愿望，真的实现了吗？",
                    "choices": [
                        {
                            "id": "111130422",
                            "text": "实现了哦。",
                            "response": [
                                {
                                    "id": "111130424",
                                    "speaker": "派蒙",
                                    "text": "我们去找了他们三个，把信物都要来了！"
                                },
                                {
                                    "id": "111130425",
                                    "speaker": "派蒙",
                                    "text": "小五当了大厨，木木成了大商人，聪子也成了霄灯工匠！"
                                },
                                {
                                    "id": "111130426",
                                    "speaker": "狼哥",
                                    "text": "这样啊…"
                                },
                                {
                                    "id": "111130427",
                                    "speaker": "狼哥",
                                    "text": "唔…"
                                },
                                {
                                    "id": "111130428",
                                    "speaker": "老孟",
                                    "text": "当初说的，我们一直都记在心上，当作是无论如何都要完成的约定。"
                                },
                                {
                                    "id": "111130429",
                                    "speaker": "老孟",
                                    "text": "总之，先把这盏灯放起来吧。"
                                },
                                {
                                    "id": "111130430",
                                    "speaker": "胡桃",
                                    "text": "#喂，{NICKNAME}，别不解风情啦。"
                                },
                                {
                                    "id": "111130431",
                                    "speaker": "胡桃",
                                    "text": "他们叙旧的时候，我们站远一点随便聊聊吧。"
                                }
                            ]
                        },
                        {
                            "id": "111130423",
                            "text": "它们都在这里。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111305",
            "objective": "与胡桃交谈，等待两人叙旧",
            "dialogues": [
                {
                    "id": "111130501",
                    "speaker": "派蒙",
                    "text": "说我们不解风情，明明你才是最看不懂气氛的人。",
                    "choices": [
                        {
                            "id": "111130502",
                            "text": "不是要维护生死的「边界」吗？",
                            "response": [
                                {
                                    "id": "111130503",
                                    "speaker": "胡桃",
                                    "text": "老孟是已经跨越「边界」的人，只能像这样把他送回去。"
                                },
                                {
                                    "id": "111130506",
                                    "speaker": "胡桃",
                                    "text": "我之前说过，往生堂一开始做的并不是葬仪，而是类似医生一样的工作。"
                                },
                                {
                                    "id": "111130507",
                                    "speaker": "胡桃",
                                    "text": "魔神战争时期，尸横遍野，生灵涂炭，传染病四处蔓延，「死亡」疯狂侵吞我们生者的世界。"
                                },
                                {
                                    "id": "111130508",
                                    "speaker": "胡桃",
                                    "text": "那时候，往生堂诞生了，以微不足道的人类的身份，花费了漫长的时间，将死亡赶了回去。"
                                },
                                {
                                    "id": "111130509",
                                    "speaker": "派蒙",
                                    "text": "感觉付出了很大的代价。"
                                },
                                {
                                    "id": "111130510",
                                    "speaker": "胡桃",
                                    "text": "又过了很长时间，璃月港繁荣兴旺，所有人都在追逐名誉与摩拉，最后，疯狂的人触动了死亡的「遗产」。"
                                },
                                {
                                    "id": "111130511",
                                    "speaker": "胡桃",
                                    "text": "魔神残渣肆虐人世，具体的就不提了，总之那是「生」于极致的自毁，也是「死」在尽头的反噬。"
                                },
                                {
                                    "id": "111130512",
                                    "speaker": "胡桃",
                                    "text": "在那之后又是很久很久，很久很久，平衡恢复，界线划清，才有了今天你们见到的璃月港，你们见到的往生堂，还有，我。",
                                    "choices": [
                                        {
                                            "id": "111130513",
                                            "text": "原来你也会讲这么严肃的故事。",
                                            "response": [
                                                {
                                                    "id": "111130514",
                                                    "speaker": "胡桃",
                                                    "text": "哈哈哈，这是老堂主最喜欢絮叨的东西，我觉得我讲的比他们都好啊。"
                                                },
                                                {
                                                    "id": "111130517",
                                                    "speaker": "胡桃",
                                                    "text": "能理解多少，就看你们了，我更希望你们完全听不懂，往生堂就是做葬仪生意的，仅此而已。",
                                                    "choices": [
                                                        {
                                                            "id": "111130518",
                                                            "text": "或许这样最好。",
                                                            "response": [
                                                                {
                                                                    "id": "111130520",
                                                                    "speaker": "胡桃",
                                                                    "text": "这个时代是幸运的，但生与死能像这样和平相处，绝非理所当然。"
                                                                },
                                                                {
                                                                    "id": "111130521",
                                                                    "speaker": "胡桃",
                                                                    "text": "呼，差不多也到时候了，我们走吧！带他们去「起始与安息之地」！"
                                                                },
                                                                {
                                                                    "id": "111130522",
                                                                    "speaker": "派蒙",
                                                                    "text": "那是什么地方？"
                                                                },
                                                                {
                                                                    "id": "111130523",
                                                                    "speaker": "胡桃",
                                                                    "text": "就是我们一开始见面的地方。我随便想的名字，不要每句话都追问！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "111130519",
                                                            "text": "嗯，该回去了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111130515",
                                            "text": "能多讲一点吗？",
                                            "response": [
                                                {
                                                    "id": "111130516",
                                                    "speaker": "胡桃",
                                                    "text": "不能！你的好奇心还真是旺盛。别忘了我的话，不需要知道的事，不知道更好。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111130504",
                            "text": "往生堂和我想象中的差别太大了。",
                            "response": [
                                {
                                    "id": "111130505",
                                    "speaker": "胡桃",
                                    "text": "是吗？只要能达成目标，做什么和怎么做都是细节问题吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111307",
            "objective": "回到无妄坡，为狼哥送别",
            "dialogues": [
                {
                    "id": "111130701",
                    "speaker": "胡桃",
                    "text": "狼哥，现在你应该很满足了吧？"
                },
                {
                    "id": "111130702",
                    "speaker": "胡桃",
                    "text": "如果以后再动了什么歪念头，真的变成恶鬼，我可是会不念旧情直接消灭你的。"
                },
                {
                    "id": "111130703",
                    "speaker": "狼哥",
                    "text": "不会的，不会的，你们为我做了这么多，我已经心满意足了。"
                },
                {
                    "id": "111130704",
                    "speaker": "狼哥",
                    "text": "知道大家过得都很好，我也不想打扰他们的生活。"
                },
                {
                    "id": "111130705",
                    "speaker": "老孟",
                    "text": "我也要谢谢你们，这也算是圆了我的一场梦。"
                },
                {
                    "id": "111130706",
                    "speaker": "胡桃",
                    "text": "那刚刚的话也送给你，老孟，要是在这之后还念念不舍，我就提前一点送你们团聚。"
                },
                {
                    "id": "111130707",
                    "speaker": "老孟",
                    "text": "不、不会的…不要笑着说这么可怕的事。"
                },
                {
                    "id": "111130708",
                    "speaker": "胡桃",
                    "text": "哈哈哈。那么，最后的最后，每人都给狼哥送上一句告别吧。"
                },
                {
                    "id": "111130709",
                    "speaker": "派蒙",
                    "text": "再见啦，狼哥。"
                },
                {
                    "id": "111130710",
                    "speaker": "胡桃",
                    "text": "不对不对，不能再见，最多是「慢走」之类的说法，可不能「再见」啊。"
                },
                {
                    "id": "111130711",
                    "speaker": "狼哥",
                    "text": "哈哈哈，没关系，我安静离开就好了。"
                },
                {
                    "id": "111130712",
                    "speaker": "狼哥",
                    "text": "抱歉啊，只有我们当时喊出来的梦想，没办法实现了。"
                },
                {
                    "id": "111130713",
                    "speaker": "老孟",
                    "text": "没关系，总会有遗憾的，你就安心上路吧。"
                },
                {
                    "id": "111130714",
                    "speaker": "狼哥",
                    "text": "嗯，我会记住大家的，各位再见！"
                },
                {
                    "id": "111130715",
                    "speaker": "老孟",
                    "text": "走掉了，唉…"
                },
                {
                    "id": "111130716",
                    "speaker": "老孟",
                    "text": "就像是了结了人生中的一件大事，还是觉得心里空荡荡的。"
                },
                {
                    "id": "111130717",
                    "speaker": "派蒙",
                    "text": "所以，之前没有听到，你们两个人的愿望是什么？"
                },
                {
                    "id": "111130718",
                    "speaker": "老孟",
                    "text": "「成家立业之后，两家人一起过海灯节。」"
                },
                {
                    "id": "111130719",
                    "speaker": "老孟",
                    "text": "所以我很羡慕我的朋友们，小五他们都还有机会实现梦想，但是我的梦想，终究是没有机会了…",
                    "choices": [
                        {
                            "id": "111130720",
                            "text": "想开一点。",
                            "response": [
                                {
                                    "id": "111130722",
                                    "speaker": "胡桃",
                                    "text": "对嘛对嘛，而且你这么想，谁都会有被烧掉的一天。"
                                },
                                {
                                    "id": "111130723",
                                    "speaker": "胡桃",
                                    "text": "活着的时候好好活着，当活着的职责履行完了，你还能见到你想见的人，不也是一件好事吗？"
                                },
                                {
                                    "id": "111130724",
                                    "speaker": "老孟",
                                    "text": "呃…谢、谢谢。"
                                },
                                {
                                    "id": "111130725",
                                    "speaker": "老孟",
                                    "text": "总之，我以后应该再也不会回无妄坡了，我也需要好好收拾收拾我的心情。"
                                },
                                {
                                    "id": "111130726",
                                    "speaker": "胡桃",
                                    "text": "没关系，那就趁这个机会出去玩玩吧，我准假了。啊，当然和现在一样，是没有工钱的。"
                                },
                                {
                                    "id": "111130727",
                                    "speaker": "派蒙",
                                    "text": "不过，好像是不是忘了一件什么事？"
                                },
                                {
                                    "id": "111130728",
                                    "speaker": "Player",
                                    "text": "说好的「找人」。"
                                },
                                {
                                    "id": "111130729",
                                    "speaker": "胡桃",
                                    "text": "嗯？带你们去了「边界」，也是想让你们找找看啊。不过，看你们的反应，应该是没找到，可惜可惜。"
                                },
                                {
                                    "id": "111130730",
                                    "speaker": "派蒙",
                                    "text": "才不可惜呢！"
                                },
                                {
                                    "id": "111130731",
                                    "speaker": "胡桃",
                                    "text": "哈哈哈，我也帮你们找了找，用了些你们不用知道的办法。可惜我也没找到什么值得追查的东西。"
                                },
                                {
                                    "id": "111130732",
                                    "speaker": "胡桃",
                                    "text": "之后我会帮你留意这方面的线索的，一旦有什么消息会直接来找你。"
                                },
                                {
                                    "id": "111130733",
                                    "speaker": "派蒙",
                                    "text": "感觉你只是随便说说…"
                                },
                                {
                                    "id": "111130734",
                                    "speaker": "胡桃",
                                    "text": "嘿嘿，毕竟找活人不是我擅长的事嘛，如果让我找的是「边界」另一边的人…"
                                },
                                {
                                    "id": "111130735",
                                    "speaker": "派蒙",
                                    "text": "不要再说可怕的话了——！"
                                },
                                {
                                    "id": "111130736",
                                    "speaker": "胡桃",
                                    "text": "放心放心，会帮你们好好找那个活人的。真是的，什么时候才能听得懂我的玩笑话。",
                                    "choices": [
                                        {
                                            "id": "111130737",
                                            "text": "感觉你很享受这份工作。",
                                            "response": [
                                                {
                                                    "id": "111130739",
                                                    "speaker": "胡桃",
                                                    "text": "哈哈…我也有我的理由啦。"
                                                },
                                                {
                                                    "id": "111130740",
                                                    "speaker": "派蒙",
                                                    "text": "理由？"
                                                },
                                                {
                                                    "id": "111130741",
                                                    "speaker": "胡桃",
                                                    "text": "今天我们去的地方，能见到的，都是对生者世界尚有执念的死者。"
                                                },
                                                {
                                                    "id": "111130742",
                                                    "speaker": "胡桃",
                                                    "text": "可是在那里，我从来没见过历代「堂主」…一次都没有。"
                                                },
                                                {
                                                    "id": "111130743",
                                                    "speaker": "胡桃",
                                                    "text": "那就说明，成为往生堂的堂主，一定是非常正确，而且绝对不会留下遗憾的事。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111130738",
                                            "text": "感觉你很适合当堂主。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111130721",
                            "text": "人生还长。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1111223",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111122301",
                    "speaker": "木木",
                    "text": "说起来，你们两个人都是亲手做的东西，只有我的是买来的。"
                },
                {
                    "id": "111122302",
                    "speaker": "小五",
                    "text": "但你那一个，价值上来说，已经是我们的很多很多倍了吧。"
                },
                {
                    "id": "111122303",
                    "speaker": "聪子",
                    "text": "重要的不是价钱，而是这些东西在我们童年时期的分量。"
                },
                {
                    "id": "111122304",
                    "speaker": "聪子",
                    "text": "还有，永远不能忘记的承诺啊。"
                }
            ]
        },
        {
            "id": "1111310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111131001",
                    "speaker": "兰溪",
                    "text": "你们是…客人？抱歉，只是觉得有点意外。"
                },
                {
                    "id": "111131002",
                    "speaker": "兰溪",
                    "text": "看到是胡桃带你们来的，我也就安心了，只是这地方什么都没有，也难做什么招待。"
                },
                {
                    "id": "111131003",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "111131004",
                    "speaker": "兰溪",
                    "text": "我叫兰溪，一直在这里等一个人，已经数不清有多长时间了。"
                },
                {
                    "id": "111131005",
                    "speaker": "兰溪",
                    "text": "都说等待很难熬，但如果一直在这里走走看看，和新人旧人聊聊天，也没有什么好着急的。"
                },
                {
                    "id": "111131006",
                    "speaker": "兰溪",
                    "text": "等下去的话，能等到吗？还是等不到呢？"
                },
                {
                    "id": "111131007",
                    "speaker": "兰溪",
                    "text": "不管怎样都好，我是只能等下去了，如果你也有重要的人，最好就不要一直等下去。"
                }
            ]
        },
        {
            "id": "1111311",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111131101",
                    "speaker": "祝明",
                    "text": "你是新来的？巧了，我也是！"
                },
                {
                    "id": "111131102",
                    "speaker": "祝明",
                    "text": "没想到风景这么好！我以为会是黑漆漆，冷冰冰，连方向都分不清的地方呢！"
                },
                {
                    "id": "111131103",
                    "speaker": "祝明",
                    "text": "能在这里整理心情，再好不过了。哈哈，可能是我原本就没抱什么期待吧。"
                }
            ]
        },
        {
            "id": "1111312",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111131201",
                    "speaker": "舒杨",
                    "text": "说起来，你这几天见到老张了吗？"
                },
                {
                    "id": "111131202",
                    "speaker": "老墨",
                    "text": "他啊，我记得他说，差不多该放下了。"
                },
                {
                    "id": "111131203",
                    "speaker": "舒杨",
                    "text": "哦哦，那是好事啊，不知道接下来他会去什么地方呢？"
                },
                {
                    "id": "111131204",
                    "speaker": "老墨",
                    "text": "你好奇的话，我们也一起去看看？"
                },
                {
                    "id": "111131205",
                    "speaker": "舒杨",
                    "text": "哈哈，以后吧，现在我还想多待一待。"
                }
            ]
        }
    ]
}