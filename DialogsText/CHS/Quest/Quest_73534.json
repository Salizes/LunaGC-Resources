    "talks": [
        {
            "id": "7353401",
            "objective": "(test)隐藏任务-挂对话$HIDDEN",
            "dialogues": [
                {
                    "id": "735340101",
                    "speaker": "柯林伍德",
                    "text": "你好你好，要帮我进行梦境疗法的就是你吗？说实话，我也不知道会梦到些什么。"
                },
                {
                    "id": "735340102",
                    "speaker": "柯林伍德",
                    "text": "我是蒙德人，平时没什么爱好，也就是喝点酒。"
                },
                {
                    "id": "735340103",
                    "speaker": "柯林伍德",
                    "text": "有的时候喝多了，容易误事，这次就靠你了。"
                }
            ]
        },
        {
            "id": "7353402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340201",
                    "speaker": "柯林伍德",
                    "text": "这酒馆怎么越看越不对劲，呜呜…嗝，总觉得有东西摆得跟平常不一样，放歪了？"
                }
            ]
        },
        {
            "id": "7353403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340301",
                    "speaker": "幼光",
                    "text": "幸会，我们马上就得一同入梦了。"
                },
                {
                    "id": "735340302",
                    "speaker": "幼光",
                    "text": "我是来自璃月的镖师幼光，这次是因为走镖撞见了点不干净的东西，最近就没睡过好觉，所以来托您帮忙。"
                },
                {
                    "id": "735340303",
                    "speaker": "幼光",
                    "text": "要是能通过梦境疗法消灭我的噩梦就太好了，感激不尽。"
                }
            ]
        },
        {
            "id": "7353404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340401",
                    "speaker": "幼光",
                    "text": "各位妖魔鬼怪，神仙大爷，发发善心，别躲在东西里，快显形吧，我要被吓死了。"
                }
            ]
        },
        {
            "id": "7353405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340501",
                    "speaker": "樋口铁矢",
                    "text": "初次见面，我是稻妻的妖怪小说家樋口铁矢。"
                },
                {
                    "id": "735340502",
                    "speaker": "樋口铁矢",
                    "text": "最近的赶稿压力比较大，不论是什么办法，只要能调整好状态，我都愿意尝试。"
                },
                {
                    "id": "735340503",
                    "speaker": "樋口铁矢",
                    "text": "毕竟是根据我的问题创造的梦境，可能带有我的个人风格。如果待会儿您在梦里见到什么奇怪的东西，我提前道歉。"
                }
            ]
        },
        {
            "id": "7353406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340601",
                    "speaker": "樋口铁矢",
                    "text": "稻妻的妖怪们都躲在哪里，快出来吧，给我看看你们长什么样子！"
                }
            ]
        },
        {
            "id": "7353407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340701",
                    "speaker": "涅提",
                    "text": "哦，梦境试验的合格志愿者这么年轻吗？后生可畏啊。"
                },
                {
                    "id": "735340702",
                    "speaker": "涅提",
                    "text": "叫我涅提就好，我是素论派的游学者，目前长期在枫丹工作。"
                },
                {
                    "id": "735340703",
                    "speaker": "涅提",
                    "text": "人上了年纪就是容易碰上各种问题，年轻人，稍后就靠你在梦里帮我看看问题的源头了。"
                }
            ]
        },
        {
            "id": "7353408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340801",
                    "speaker": "涅提",
                    "text": "实验室的器材一个比一个不听话，别捣乱了，你们这些调皮好动的器材都给我老实点。"
                }
            ]
        },
        {
            "id": "7353409",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735340901",
                    "speaker": "比于什",
                    "text": "陀罗诘利介绍来的厉害朋友原来是您吗？我是比于什，在建筑行业工作。"
                },
                {
                    "id": "735340902",
                    "speaker": "比于什",
                    "text": "之前听卡维先生提到过您的名字，但一直没机会和您打招呼，这次也算是巧了。"
                },
                {
                    "id": "735340903",
                    "speaker": "比于什",
                    "text": "我猜待会儿会梦到我刚交付的项目吧，噩梦啊…第一次和您正式见面居然是这种场合，唉算了。"
                }
            ]
        },
        {
            "id": "7353410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735341001",
                    "speaker": "比于什",
                    "text": "忍不了了，怎么不按说好的图纸布置，凉亭、水池、喷泉和温室绿化带、坡道，就连温室内部也是，到处都没有注意对称！"
                }
            ]
        }
    ]
}