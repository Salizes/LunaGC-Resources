    "talks": [
        {
            "id": "7550802",
            "objective": "(test)隐藏任务用于开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7550801",
            "objective": "前往「流泉之众」",
            "dialogues": [
                {
                    "id": "755080101",
                    "speaker": "玛拉妮",
                    "text": "哟！"
                },
                {
                    "id": "755080102",
                    "speaker": "玛拉妮",
                    "text": "我们最最重要的客人来啦，说明气氛即将达到最热点！"
                },
                {
                    "id": "755080103",
                    "speaker": "派蒙",
                    "text": "玛拉妮，你好呀！希诺宁也在？"
                },
                {
                    "id": "755080104",
                    "speaker": "派蒙",
                    "text": "还有瑞希？你从稻妻过来啦？"
                },
                {
                    "id": "755080105",
                    "speaker": "梦见月瑞希",
                    "text": "没错哦，纳塔的朋友们待我就像家人，「流泉之众」就像是我异乡的家。"
                },
                {
                    "id": "755080106",
                    "speaker": "梦见月瑞希",
                    "text": "我也需要用心打理分店，才能为纳塔的大家提供力所能及的帮助嘛。"
                },
                {
                    "id": "755080107",
                    "speaker": "希诺宁",
                    "text": "说得不错，瑞希小姐的工作态度实在无可挑剔。"
                },
                {
                    "id": "755080108",
                    "speaker": "希诺宁",
                    "text": "和她一对比，传说中的乙方模板都会显得怠惰…",
                    "choices": [
                        {
                            "id": "755080109",
                            "text": "原来希诺宁也是瑞希的客户？",
                            "response": [
                                {
                                    "id": "755080111",
                                    "speaker": "希诺宁",
                                    "text": "最近做了几个奇怪的梦，比如…委托人把原本四周的订单工期缩短到一周。"
                                },
                                {
                                    "id": "755080112",
                                    "speaker": "希诺宁",
                                    "text": "或者接到的需求是「外形圆润又带着危险感的挂饰」，同样是四倍加急…",
                                    "choices": [
                                        {
                                            "id": "755080113",
                                            "text": "这题我会，史莱姆和蕈兽。",
                                            "response": [
                                                {
                                                    "id": "755080115",
                                                    "speaker": "派蒙",
                                                    "text": "反应这么快，该不会是你托梦给希诺宁下单的吧！"
                                                },
                                                {
                                                    "id": "755080116",
                                                    "speaker": "希诺宁",
                                                    "text": "这两种生物…危险吗？"
                                                },
                                                {
                                                    "id": "755080117",
                                                    "speaker": "希诺宁",
                                                    "text": "唔，工期倒是次要的，圆形图案处理起来比较费事，一旦加急，成品效果就未必完美了。"
                                                },
                                                {
                                                    "id": "755080118",
                                                    "speaker": "希诺宁",
                                                    "text": "梦里这类的麻烦订单还不少，我感觉有些不对劲，就把手头的单子都结了，来瑞希小姐的店里试了试…"
                                                },
                                                {
                                                    "id": "755080119",
                                                    "speaker": "希诺宁",
                                                    "text": "结果还真灵验，当天午睡时，我就没再做过奇怪的梦。"
                                                },
                                                {
                                                    "id": "755080120",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "能为希诺宁女士排遣烦扰，我深感荣幸。"
                                                },
                                                {
                                                    "id": "755080121",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "不过我觉得，希诺宁女士的古怪梦境会消散，主要的功劳应该还在于您自己啦…"
                                                },
                                                {
                                                    "id": "755080122",
                                                    "speaker": "玛拉妮",
                                                    "text": "总而言之，现在大家的精神状态都很不错，正是放松的好时机——"
                                                },
                                                {
                                                    "id": "755080123",
                                                    "speaker": "玛拉妮",
                                                    "text": "「流泉之众」要重启水上派对的传统，让大家玩个痛快！",
                                                    "choices": [
                                                        {
                                                            "id": "755080124",
                                                            "text": "水上派对~",
                                                            "response": [
                                                                {
                                                                    "id": "755080126",
                                                                    "speaker": "派蒙",
                                                                    "text": "好耶，玩个痛快！"
                                                                },
                                                                {
                                                                    "id": "755080127",
                                                                    "speaker": "派蒙",
                                                                    "text": "…不过，我以前还没参加过这种活动，只知道有好吃的东西和好喝的饮料…"
                                                                },
                                                                {
                                                                    "id": "755080128",
                                                                    "speaker": "派蒙",
                                                                    "text": "一般纳塔人会在派对上玩些什么呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755080129",
                                                                            "text": "鳍游龙拉着客人高速冲浪？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755080132",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我…我能玩这个？"
                                                                                },
                                                                                {
                                                                                    "id": "755080133",
                                                                                    "speaker": "玛拉妮",
                                                                                    "text": "哎呀，你们已经是成熟的极限运动爱好者了！我第一时间也想让客人们玩这个！"
                                                                                },
                                                                                {
                                                                                    "id": "755080134",
                                                                                    "speaker": "玛拉妮",
                                                                                    "text": "不过阿米娜很认真地说…咳咳…「对于一般人来说，这样的活动还是刺激过头了！」"
                                                                                },
                                                                                {
                                                                                    "id": "755080135",
                                                                                    "speaker": "玛拉妮",
                                                                                    "text": "「就算是普普通通的沙滩排球，一些客人都可能把握不住力道，导致同伴受伤哦！」"
                                                                                },
                                                                                {
                                                                                    "id": "755080136",
                                                                                    "speaker": "玛拉妮",
                                                                                    "text": "「要是参加了派对，一个不注意，没能玩个痛快，反而留下了心理阴影，到时候增加的就是瑞希小姐的工作量了！」"
                                                                                },
                                                                                {
                                                                                    "id": "755080137",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "我倒是不介意帮更多人排忧解难啦，但可不包括自己制造出的病患哦，还是别让客人受伤为妙。"
                                                                                },
                                                                                {
                                                                                    "id": "755080138",
                                                                                    "speaker": "玛拉妮",
                                                                                    "text": "嘿嘿，所以我才好好找你咨询了一番嘛！"
                                                                                },
                                                                                {
                                                                                    "id": "755080139",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "看来你们已经商量出了不错的方案？"
                                                                                },
                                                                                {
                                                                                    "id": "755080140",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "没错，我们达成了共识，希望更多没有极限运动基础的客人参加派对，而不是看着刺激的活动望而却步。"
                                                                                },
                                                                                {
                                                                                    "id": "755080141",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "在和我聊天时，玛拉妮小姐听说了稻妻的「三川花祭」，对历年祭典上的轻松游戏很感兴趣。"
                                                                                },
                                                                                {
                                                                                    "id": "755080142",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "就萌生了一个念头——将「秋津羽戏」与纳塔的氛围相结合，打造出既能休闲放松，又能玩个爽快的游戏「节拍撞球」。"
                                                                                },
                                                                                {
                                                                                    "id": "755080143",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "稻妻的游戏…纳塔的氛围…还真是以前从没想过的组合！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "755080144",
                                                                                            "text": "我看到了「回声之子」的「热舞乐台」。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "755080146",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "啊呀，「热舞乐台」明明还没调高音量，看来你对低音和鼓点还挺敏感的嘛…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080147",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "这次的主力游戏「节拍撞球」，就是跟着热情的音乐，畅玩弹球，打碎所有方块。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080148",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "顺从本能，释放自我，不必考虑复杂的技巧，不用担心安全问题，任何人都能玩个痛快。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080149",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "#当然，对于{NICKNAME}这种天赋异禀的选手，应该能打出…具有特别「节拍」和「层次」的效果。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080150",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "在不同的控碟乐师手中，一首曲子有可能展现出截然不同的风格，带有打击感的游戏也是同理。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080151",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "没准…「驰放」风格的基底音乐，经过你的处理，都会展现出类似「出神」或「艺核」的有趣律动呢。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080152",
                                                                                                    "speaker": "希诺宁",
                                                                                                    "text": "我有点期待哦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080153",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#听…听不太明白！不过感觉，应该是{NICKNAME}能做到的事…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "755080154",
                                                                                                            "text": "那我就来扮演音乐和游戏天才！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "755080156",
                                                                                                                    "speaker": "玛拉妮",
                                                                                                                    "text": "太对了，就是这种劲头！在我们的期待中，无论如何都要保证玩得最开心的客人，就是你和派蒙啦！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080157",
                                                                                                                    "speaker": "玛拉妮",
                                                                                                                    "text": "待会儿我要拿一堆零食和饮料，在一边开开心心地看！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080158",
                                                                                                                    "speaker": "梦见月瑞希",
                                                                                                                    "text": "当然，也请注意，别兴奋过头呀。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080159",
                                                                                                                    "speaker": "梦见月瑞希",
                                                                                                                    "text": "说不定晚上睡觉前，脑子里还在反复播放「热舞乐台」的音乐，停不下来呢。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080160",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "谢谢大家！我们一定玩个开心！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080161",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "话说回来，我记得希诺宁很会挑歌，就算梦里还在重播…应该也没问题？"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "755080155",
                                                                                                            "text": "不至于这么强，我会尽力的！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "755080145",
                                                                                            "text": "我的身体感受到了音乐的律动…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755080130",
                                                                            "text": "绒翼龙空投玩家高跳低开？"
                                                                        },
                                                                        {
                                                                            "id": "755080131",
                                                                            "text": "匿叶龙无绳蹦极…这个玩过了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755080125",
                                                            "text": "玩个痛快~"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755080114",
                                            "text": "说的是飘浮灵和球球章鱼？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755080110",
                            "text": "瑞希和希诺宁站在同一阵线了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7550899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "755089901",
                    "speaker": "派蒙",
                    "text": "我们收到了一封玛拉妮的信呢，真是个惊喜！"
                },
                {
                    "id": "755089902",
                    "speaker": "派蒙",
                    "text": "上面说，「流泉之众」正在举办一场…音乐派对？"
                },
                {
                    "id": "755089903",
                    "speaker": "派蒙",
                    "text": "听起来有点好玩欸，我们去看看情况吧！"
                }
            ]
        }
    ]
}