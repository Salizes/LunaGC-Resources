    "talks": [
        {
            "id": "7711503",
            "objective": "前往奥古洛夫镇附近$HIDDEN",
            "dialogues": [
                {
                    "id": "771150301",
                    "speaker": "「铁头老大」",
                    "text": "喂！你俩什么来路？不会是来抢货的吧！",
                    "choices": [
                        {
                            "id": "771150302",
                            "text": "我们是来帮忙炸开隧道口的。",
                            "response": [
                                {
                                    "id": "771150303",
                                    "speaker": "「铁头老大」",
                                    "text": "我可不记得我找的是两个小毛孩…你们是不是觉得「铁头老大」我很好骗？那就先尝尝我的厉害！"
                                }
                            ]
                        },
                        {
                            "id": "771150304",
                            "text": "你怎么随便冤枉人呢！",
                            "response": [
                                {
                                    "id": "771150305",
                                    "speaker": "「铁头老大」",
                                    "text": "哼，两个小家伙，还敢狡辩…先让「铁头老大」我教训教训你们！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7711505",
            "objective": "击败帮派兽灵",
            "dialogues": [
                {
                    "id": "771150501",
                    "speaker": "「铁头老大」",
                    "text": "喂！你俩什么来路？不会是来抢货的吧！",
                    "choices": [
                        {
                            "id": "771150502",
                            "text": "我们只是路过看看…",
                            "response": [
                                {
                                    "id": "771150503",
                                    "speaker": "「铁头老大」",
                                    "text": "嗐！谁会在这种地方瞎逛？你们是不是觉得「铁头老大」我很好骗？那就先尝尝我的厉害！"
                                }
                            ]
                        },
                        {
                            "id": "771150504",
                            "text": "你怎么随便冤枉人呢！",
                            "response": [
                                {
                                    "id": "771150505",
                                    "speaker": "「铁头老大」",
                                    "text": "哼，两个小家伙，还敢狡辩…先让「铁头老大」我教训教训你们！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7711506",
            "objective": "(test)与「铁头老大对话」",
            "dialogues": [
                {
                    "id": "771150601",
                    "speaker": "「铁头老大」",
                    "text": "饶命…饶命啊二位！是我有眼无珠了。"
                },
                {
                    "id": "771150602",
                    "speaker": "派蒙",
                    "text": "#喂喂，做了坏事还想要我们饶命？{NICKNAME}，上！"
                },
                {
                    "id": "771150603",
                    "speaker": "Player",
                    "text": "好嘞。"
                },
                {
                    "id": "771150604",
                    "speaker": "「铁头老大」",
                    "text": "等等！小的我可以交保命钱！"
                },
                {
                    "id": "771150605",
                    "speaker": "「铁头老大」",
                    "text": "您看到前面的隧道了吗？之前我们就从那进镇…现在那里是我们建的临时库房，装满了我们从奥古洛夫镇里搜罗出来的宝贝。"
                },
                {
                    "id": "771150606",
                    "speaker": "「铁头老大」",
                    "text": "当然——现在，这些宝贝全归您了。"
                },
                {
                    "id": "771150607",
                    "speaker": "「铁头老大」",
                    "text": "只是…"
                },
                {
                    "id": "771150608",
                    "speaker": "派蒙",
                    "text": "只是什么？你不会想要赖账吧！"
                },
                {
                    "id": "771150609",
                    "speaker": "「铁头老大」",
                    "text": "哎呦，我怎么敢…我是想说，隧道口塌了！现在我进不去，您也进不去。"
                },
                {
                    "id": "771150610",
                    "speaker": "「铁头老大」",
                    "text": "前段时间好不容易才找到个看起来傻傻的年轻人愿意来这帮忙，还照他给的方案准备好了炸药。"
                },
                {
                    "id": "771150611",
                    "speaker": "「铁头老大」",
                    "text": "但他拖了一天又一天，我和我的兄弟们都要冻成冰雕了…但等来的却是您。"
                },
                {
                    "id": "771150612",
                    "speaker": "「铁头老大」",
                    "text": "好在我还能去收我应得的100倍违约金，不然这趟就亏大了！"
                },
                {
                    "id": "771150613",
                    "speaker": "Player",
                    "text": "100倍是不是太夸张了。"
                },
                {
                    "id": "771150614",
                    "speaker": "派蒙",
                    "text": "没错没错，简直和抢劫没区别！"
                },
                {
                    "id": "771150615",
                    "speaker": "「铁头老大」",
                    "text": "我们抢劫怎么了？"
                },
                {
                    "id": "771150616",
                    "speaker": "「铁头老大」",
                    "text": "您看小的我这张破嘴…我们也没办法，去奥古洛夫镇里寻宝一趟，风险可太高了。"
                },
                {
                    "id": "771150617",
                    "speaker": "「铁头老大」",
                    "text": "虽然没碰到那传说中的大火鸟，但也快把命搭上了，才带出来了…十分稀罕的宝贝。"
                },
                {
                    "id": "771150618",
                    "speaker": "「铁头老大」",
                    "text": "现在这些宝贝还不归我了，只能想点别的办法保保本了…"
                },
                {
                    "id": "771150619",
                    "speaker": "派蒙",
                    "text": "#但不管怎么样，抢劫也是不对的！要不是我们{NICKNAME}武力高强…",
                    "choices": [
                        {
                            "id": "771150620",
                            "text": "还是趁早改邪归正。",
                            "response": [
                                {
                                    "id": "771150622",
                                    "speaker": "「铁头老大」",
                                    "text": "我再也不敢了…我发誓，现在起我就离这儿远远的，不碍着您的眼…"
                                }
                            ]
                        },
                        {
                            "id": "771150621",
                            "text": "100倍违约金…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7711507",
            "objective": "前往临时库房附近",
            "dialogues": []
        },
        {
            "id": "7711511",
            "objective": "清除废弃隧道口的障碍",
            "dialogues": []
        },
        {
            "id": "7711512",
            "objective": "进入废弃隧道",
            "dialogues": []
        },
        {
            "id": "7711514",
            "objective": "探索废弃隧道内的临时库房",
            "dialogues": [
                {
                    "id": "771151401",
                    "speaker": "派蒙",
                    "text": "#呜哇！{NICKNAME}，是个小女孩？！头上还长着树枝！是装饰吧，怎么可能有人头上会长树枝？"
                },
                {
                    "id": "771151402",
                    "speaker": "派蒙",
                    "text": "还、还是活着的吗？「活体」说的就是她？"
                },
                {
                    "id": "771151403",
                    "speaker": "派蒙",
                    "text": "「铁头老大」之前说的十分稀罕的宝贝…难道就是…"
                },
                {
                    "id": "771151404",
                    "speaker": "？？？",
                    "text": "呜呜…我没有宝贝，放过我吧…"
                },
                {
                    "id": "771151405",
                    "speaker": "派蒙",
                    "text": "吓我一跳！"
                },
                {
                    "id": "771151406",
                    "speaker": "Player",
                    "text": "别紧张，派蒙，只是个小女孩。"
                },
                {
                    "id": "771151407",
                    "speaker": "派蒙",
                    "text": "呃啊，不好意思…你不要害怕，刚刚就是我们把你放出来的，肯定不会伤害你。"
                },
                {
                    "id": "771151408",
                    "speaker": "？？？",
                    "text": "呼…我还以为我又要被抓走了…那群兽怪，如果扎拉在的话，他们每个都要被打成呆瓜、笨蛋、傻子…"
                },
                {
                    "id": "771151409",
                    "speaker": "派蒙",
                    "text": "那群兽怪？不会就是「铁头老大」他们吧…放心，刚刚我们已经好好收拾他们一顿了！不过，<color=#00E1FFFF>「扎拉」</color>是…"
                },
                {
                    "id": "771151410",
                    "speaker": "？？？",
                    "text": "扎拉是守护在镇子里的家人。啊，我住在奥古洛夫镇里，但我不知道我现在在哪里…"
                },
                {
                    "id": "771151411",
                    "speaker": "？？？",
                    "text": "…呜呜，这么久没回家，妈妈一定在「沙沙」、「沙沙」着哭泣。"
                },
                {
                    "id": "771151412",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，「眼镜」的身体很可能在那个叽里咕噜镇里面！",
                    "choices": [
                        {
                            "id": "771151413",
                            "text": "叽里咕噜，叽里咕噜！",
                            "response": [
                                {
                                    "id": "771151414",
                                    "speaker": "派蒙",
                                    "text": "欸呀，我只是记不清那个镇子的名字嘛！这不是重点！"
                                },
                                {
                                    "id": "771151415",
                                    "speaker": "派蒙",
                                    "text": "重点是…反正这个小女孩也要回镇子，不如一起出发，这样还能有个镇子里的人带路呢！"
                                },
                                {
                                    "id": "771151419",
                                    "speaker": "派蒙",
                                    "text": "#咳咳，这样吧，我叫派蒙，这位是{NICKNAME}，是了不起的冒险家，我们正好想要去镇子…呃，旅游一番！"
                                },
                                {
                                    "id": "771151420",
                                    "speaker": "派蒙",
                                    "text": "就让我们顺便把你送回镇子吧！"
                                },
                                {
                                    "id": "771151421",
                                    "speaker": "娜斯佳",
                                    "text": "哇，两位大冒险家愿意送我回家，真是好人！我叫娜斯佳，现在我们已经是朋友了，很快就能变成家人了。"
                                },
                                {
                                    "id": "771151422",
                                    "speaker": "派蒙",
                                    "text": "等等，成为家人也太快了吧。"
                                },
                                {
                                    "id": "771151423",
                                    "speaker": "娜斯佳",
                                    "text": "嘿嘿，是我心急了，要成为家人还要做很多事情呢…"
                                },
                                {
                                    "id": "771151424",
                                    "speaker": "娜斯佳",
                                    "text": "#{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙，我们还是先回到镇上吧，回到镇上，我就能给你们带路了。"
                                },
                                {
                                    "id": "771151425",
                                    "speaker": "派蒙",
                                    "text": "小小派蒙？明明娜斯佳也不大吧！这么叫有点奇奇怪怪的…不过至少不是什么难听的绰号。"
                                },
                                {
                                    "id": "771151426",
                                    "speaker": "派蒙",
                                    "text": "总之，作为最好的向导，还是让我先看看大致方向…"
                                },
                                {
                                    "id": "771151427",
                                    "speaker": "派蒙",
                                    "text": "之前「铁头老大」说这是通向镇里的隧道，那我们还是先顺着轨道走吧！不过怎么这里还堵着…"
                                },
                                {
                                    "id": "771151428",
                                    "speaker": "娜斯佳",
                                    "text": "嗯？我有办法，不过要你们帮帮我。"
                                }
                            ]
                        },
                        {
                            "id": "771151416",
                            "text": "哇，好巧哦！",
                            "response": [
                                {
                                    "id": "771151417",
                                    "speaker": "派蒙",
                                    "text": "是呀是呀，真的好巧呢！…啊，不是，谁在说这个啦，乱打岔！"
                                },
                                {
                                    "id": "771151418",
                                    "speaker": "派蒙",
                                    "text": "我是说，反正这个小女孩也要回镇子，不如一起出发，这样还能有个镇子里的人带路呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
