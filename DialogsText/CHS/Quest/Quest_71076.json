        },
        {
            "id": "7106228",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710622801",
                    "speaker": "拉多米尔",
                    "text": "谢谢你的食物，有什么话请跟安东连长说吧，我没什么可以告诉你的。"
                },
                {
                    "id": "710622802",
                    "speaker": "拉多米尔",
                    "text": "呃…请不要误会，我是说，关于部队机密，你明白的…"
                },
                {
                    "id": "710622803",
                    "speaker": "拉多米尔",
                    "text": "咳咳，总之…希望我们下次能作为朋友再见。"
                }
            ]
        },
        {
            "id": "7106229",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710622901",
                    "speaker": "达尼拉",
                    "text": "感谢你的帮助，实在抱歉没有什么能给你的。"
                },
                {
                    "id": "710622902",
                    "speaker": "达尼拉",
                    "text": "安托哈他还是第一次当连长，哈…恐怕也是最后一次咯。但只要能把我们都活着弄出去，他这个连长也是合格了。"
                },
                {
                    "id": "710622903",
                    "speaker": "达尼拉",
                    "text": "无论如何，希望你接下来的旅途一路平安。"
                }
            ]
        },
        {
            "id": "7106230",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710623001",
                    "speaker": "提莫尔",
                    "text": "哈，我们的大恩人来了。下次在野外如果再见到了我，还请你不要急着动手呀！"
                },
                {
                    "id": "710623002",
                    "speaker": "提莫尔",
                    "text": "嘿嘿…开玩笑的，希望下次再见面，我们不会是敌人。"
                }
            ]
        }
    ]
