        "rewards_formatted": "原石 x20, 摩拉 x20000, 大英雄的经验 x2",
        "chapter": {
            "icon": "UI_ChapterIcon_ThemeParkSim",
            "id": "10232",
            "num": "和旋舞剧·第一幕",
            "title": "一夜建成的乐园"
        },
        "total_dialogue_lines": 147,
        "total_speaker_counts": {
            "Black Screen": 1,
            "Player": 23,
            "娜维娅": 70,
            "派蒙": 30,
            "爱可菲": 23
        }
    },
    "talks": [
        {
            "id": "4018901",
            "objective": "与娜维娅对话",
            "dialogues": [
                {
                    "id": "401890429",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "401890401",
                    "speaker": "娜维娅",
                    "text": "接下来，我的好搭档和派蒙，我们要进入「海薇玛映影欢乐城」的正题了…"
                },
                {
                    "id": "401890402",
                    "speaker": "娜维娅",
                    "text": "之前说过，这次的「海薇玛映影欢乐城」由爱好者们发起，刺玫会负责统筹、建造和运营。"
                },
                {
                    "id": "401890403",
                    "speaker": "娜维娅",
                    "text": "不过，爱好者毕竟不是全能的专业人士，通常只负责活动展位的设计。"
                },
                {
                    "id": "401890404",
                    "speaker": "娜维娅",
                    "text": "我们的任务，就是进行「长期经营规划」，定制「标准玩法攻略」。"
                },
                {
                    "id": "401890405",
                    "speaker": "派蒙",
                    "text": "长期、经营、规划…听起来好高深！"
                },
                {
                    "id": "401890406",
                    "speaker": "派蒙",
                    "text": "我们两个平时都在冒险，甚至都没怎么摆摊卖过东西，能搞懂吗？",
                    "choices": [
                        {
                            "id": "401890407",
                            "text": "不是每个老板都读过商业学校喔！",
                            "response": [
                                {
                                    "id": "401890409",
                                    "speaker": "娜维娅",
                                    "text": "没错，就是这种气势！我的好搭档什么风浪都见过，影响过不少提瓦特的商业大事件！"
                                },
                                {
                                    "id": "401890410",
                                    "speaker": "娜维娅",
                                    "text": "总之，我们先来看看欢乐城的基本情况…"
                                },
                                {
                                    "id": "401890411",
                                    "speaker": "派蒙",
                                    "text": "#好像大概明白了，{NICKNAME}，你感觉怎么样？",
                                    "choices": [
                                        {
                                            "id": "401890412",
                                            "text": "哈哈，这是我的拿手好戏！",
                                            "response": [
                                                {
                                                    "id": "401890414",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！我们一起加油！"
                                                },
                                                {
                                                    "id": "401890415",
                                                    "speaker": "派蒙",
                                                    "text": "刚才，娜维娅好像还提到了「标准玩法攻略」…难道说，还有不标准的玩法？"
                                                },
                                                {
                                                    "id": "401890416",
                                                    "speaker": "娜维娅",
                                                    "text": "当然啦，毕竟每个人对映影和游乐项目的理解都不同，欢乐城里也不乏惊险刺激的活动。"
                                                },
                                                {
                                                    "id": "401890417",
                                                    "speaker": "娜维娅",
                                                    "text": "没准，有的游客认不清路，咕噜两下就跑出了游玩范围…"
                                                },
                                                {
                                                    "id": "401890418",
                                                    "speaker": "娜维娅",
                                                    "text": "有的游客或许会认错道具的用途，把危险的道具捏在手里。"
                                                },
                                                {
                                                    "id": "401890419",
                                                    "speaker": "娜维娅",
                                                    "text": "要避免游客们游玩时陷入困惑，我们就要给每个活动列出一个「标准玩法」，或者说，「流程攻略」！",
                                                    "choices": [
                                                        {
                                                            "id": "401890420",
                                                            "text": "我明白了，就由我来先玩。",
                                                            "response": [
                                                                {
                                                                    "id": "401890422",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么一说，我也能想象各种意外情况…"
                                                                },
                                                                {
                                                                    "id": "401890423",
                                                                    "speaker": "派蒙",
                                                                    "text": "如果碰见太难的关卡，也只有凭我们的实力才能轻松应付！"
                                                                },
                                                                {
                                                                    "id": "401890424",
                                                                    "speaker": "娜维娅",
                                                                    "text": "当然啦，我绝不希望我的好搭档遇见危险，在你们来之前，我已经把现有项目统统仔细检查过了，绝对不会有安全因素的缺陷。"
                                                                },
                                                                {
                                                                    "id": "401890425",
                                                                    "speaker": "娜维娅",
                                                                    "text": "我也希望你能成为最早体验到游乐项目的人，然后说说你对这些游乐项目的感受，提提建议！"
                                                                },
                                                                {
                                                                    "id": "401890426",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，不愧是娜维娅，总能让我们安安心心开开心心！"
                                                                },
                                                                {
                                                                    "id": "401890427",
                                                                    "speaker": "娜维娅",
                                                                    "text": "我很期待哦！你们的意见非常关键！"
                                                                },
                                                                {
                                                                    "id": "401890428",
                                                                    "speaker": "娜维娅",
                                                                    "text": "总之，我们就先将「缤纷蹈险奇行」投入运营，制定第一份攻略好了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401890421",
                                                            "text": "我懂了，我来当参考标准。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401890413",
                                            "text": "哇啊…一边工作一边学吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401890408",
                            "text": "我们也干过许多赚大钱的生意嘛！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4018902",
            "objective": "前往制定攻略",
            "dialogues": []
        },
        {
            "id": "4018903",
            "objective": "与娜维娅对话",
            "dialogues": [
                {
                    "id": "401890601",
                    "speaker": "娜维娅",
                    "text": "你们似乎比之前更有兴致了…看来第一次试玩没让你们失望！",
                    "choices": [
                        {
                            "id": "401890602",
                            "text": "挑战形式非常亲切！",
                            "response": [
                                {
                                    "id": "401890604",
                                    "speaker": "派蒙",
                                    "text": "虽然没看过多少映影，但试过这次的玩法后，我好像…来劲了？很想了解一下相关的作品！"
                                },
                                {
                                    "id": "401890605",
                                    "speaker": "娜维娅",
                                    "text": "派蒙真不错，领会到了爱好者们最纯粹的目标！"
                                },
                                {
                                    "id": "401890606",
                                    "speaker": "娜维娅",
                                    "text": "如果能让客人们对游乐项目的原型映影感兴趣，这些淳朴的爱好者就再快乐不过了！"
                                },
                                {
                                    "id": "401890607",
                                    "speaker": "娜维娅",
                                    "text": "在开销允许的范围内，他们甚至愿意多多自掏腰包！"
                                },
                                {
                                    "id": "401890608",
                                    "speaker": "派蒙",
                                    "text": "自…自掏腰包？"
                                },
                                {
                                    "id": "401890609",
                                    "speaker": "娜维娅",
                                    "text": "没错，基本的摊位建材和地租由刺玫会负责，许多爱好者自己出钱制作了宣传物料和相关商品哦！"
                                },
                                {
                                    "id": "401890610",
                                    "speaker": "娜维娅",
                                    "text": "对他们来说，展位的费用并不是大头，有人已经开始自行设计映影角色的衍生产品了。"
                                },
                                {
                                    "id": "401890611",
                                    "speaker": "娜维娅",
                                    "text": "比如这次的代言人海薇玛夫人，她在上次漫画映影的人气角色投票中取得了亚军，评语是「圆圆弹弹终极可爱」。"
                                },
                                {
                                    "id": "401890612",
                                    "speaker": "娜维娅",
                                    "text": "许多人都想以她的形象设计抱枕，用最顶级的布料，请最手巧的工匠来批量生产…"
                                },
                                {
                                    "id": "401890613",
                                    "speaker": "娜维娅",
                                    "text": "下一届展会上，这种抱枕就会正式发售，类似的商品还有很多！",
                                    "choices": [
                                        {
                                            "id": "401890614",
                                            "text": "这么一说，我也有点心动…",
                                            "response": [
                                                {
                                                    "id": "401890615",
                                                    "speaker": "娜维娅",
                                                    "text": "很不错吧！而且，作为肖像权代理人兼海薇玛夫人的监护人，芙宁娜会拿到销售额六成的分红呢！"
                                                },
                                                {
                                                    "id": "401890618",
                                                    "speaker": "娜维娅",
                                                    "text": "毕竟这些都是爱好者们自愿的，目的不是赚钱，而是宣传海薇玛夫人的可爱形象。"
                                                },
                                                {
                                                    "id": "401890619",
                                                    "speaker": "娜维娅",
                                                    "text": "芙宁娜手里的摩拉越多，海薇玛夫人的伙食就越好，大家都会为此开心~"
                                                },
                                                {
                                                    "id": "401890620",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，我喜欢这种感觉！大家为了共同的爱好努力，不计较利润！"
                                                },
                                                {
                                                    "id": "401890621",
                                                    "speaker": "娜维娅",
                                                    "text": "话说回来，完全不管摩拉，也有点极端，无论爱好者的作品，还是正规的商业项目，都需要考虑基本的收支平衡。"
                                                },
                                                {
                                                    "id": "401890622",
                                                    "speaker": "娜维娅",
                                                    "text": "这次的「海薇玛映影欢乐城」也是一样的道理。"
                                                },
                                                {
                                                    "id": "401890623",
                                                    "speaker": "娜维娅",
                                                    "text": "制定了「标准玩法攻略」后，游乐项目就可以正式对外开张。不过，我们不可能亲自来当售票员。"
                                                },
                                                {
                                                    "id": "401890624",
                                                    "speaker": "娜维娅",
                                                    "text": "展位上还有许多杂务需要处理，欢乐城也需要我们持续建设。所以，我们需要为每个游乐项目安排专门的员工，以便维护管理…"
                                                },
                                                {
                                                    "id": "401890625",
                                                    "speaker": "娜维娅",
                                                    "text": "乐园的展板有个应聘处，收到了许多份简历，他们各有所长，我们就要根据项目的需要，找出综合表现最不错的员工！"
                                                },
                                                {
                                                    "id": "401890626",
                                                    "speaker": "娜维娅",
                                                    "text": "接下来，员工就能把游乐项目持续运行下去，为「海薇玛映影欢乐城」不断带来收益！"
                                                },
                                                {
                                                    "id": "401890627",
                                                    "speaker": "派蒙",
                                                    "text": "欸？突然就从试玩专家变成招募员工的…老板？还没体验过这种事呢…",
                                                    "choices": [
                                                        {
                                                            "id": "401890628",
                                                            "text": "我筛简历可是很严格的！",
                                                            "response": [
                                                                {
                                                                    "id": "401890630",
                                                                    "speaker": "派蒙",
                                                                    "text": "你也不能把自己当成绝对标准，要求普通人和你一样能干哦…"
                                                                },
                                                                {
                                                                    "id": "401890631",
                                                                    "speaker": "派蒙",
                                                                    "text": "好啦，现在是简历时间！希望有大显神通的员工来应聘！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401890629",
                                                            "text": "我肯定是个称职的老板！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401890616",
                                            "text": "要不，多给芙宁娜几成分红？",
                                            "response": [
                                                {
                                                    "id": "401890617",
                                                    "speaker": "娜维娅",
                                                    "text": "放心哦，芙宁娜是海薇玛夫人的监护人，代管着她的肖像权，可以拿到销售额六成的分红呢！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401890603",
                            "text": "还结合了映影主题！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4018904",
            "objective": "前往聘用员工",
            "dialogues": []
        },
        {
            "id": "4018911",
            "objective": "与娜维娅对话",
            "dialogues": [
                {
                    "id": "401890801",
                    "speaker": "派蒙",
                    "text": "好，看起来这位员工已经进入工作状态了呢。",
                    "choices": [
                        {
                            "id": "401890802",
                            "text": "祝这位员工工作顺利。",
                            "response": [
                                {
                                    "id": "401890804",
                                    "speaker": "娜维娅",
                                    "text": "哈哈哈，你们也不赖嘛，比我更有老板的气势！"
                                },
                                {
                                    "id": "401890805",
                                    "speaker": "娜维娅",
                                    "text": "现在，「海薇玛映影欢乐城」就算正式开张了！"
                                },
                                {
                                    "id": "401890806",
                                    "speaker": "娜维娅",
                                    "text": "经营乐园是个长期的过程，心急赚不了大笔摩拉。"
                                },
                                {
                                    "id": "401890807",
                                    "speaker": "娜维娅",
                                    "text": "这次的工作布置已经差不多了，我们就小小休息一会儿，等待着这个周期的营收财报出炉吧。"
                                }
                            ]
                        },
                        {
                            "id": "401890803",
                            "text": "我会好好考勤的哦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4018905",
            "objective": "结束当前经营周期",
            "dialogues": [
                {
                    "id": "401890501",
                    "speaker": "娜维娅",
                    "text": "好，接下来就试试「缤纷蹈险奇行」吧，「标准玩法攻略」就由你们来制定啦！"
                }
            ]
        },
        {
            "id": "4018912",
            "objective": "与娜维娅对话",
            "dialogues": [
                {
                    "id": "401891001",
                    "speaker": "娜维娅",
                    "text": "哎呀，虽然数据不是很夸张，但考虑到刚刚开张，是个不错的开端！"
                },
                {
                    "id": "401891002",
                    "speaker": "娜维娅",
                    "text": "趁着这个势头，我们要在新一个周期里考虑更特别的经营策略了！"
                },
                {
                    "id": "401891003",
                    "speaker": "娜维娅",
                    "text": "为了欢乐城的人气，我专门请来了枫丹知名的厨师，我的好朋友爱可菲！"
                },
                {
                    "id": "401891004",
                    "speaker": "娜维娅",
                    "text": "乐园里的餐厅就是她表演的舞台，我们这就去找她聊聊！"
                },
                {
                    "id": "401891005",
                    "speaker": "派蒙",
                    "text": "餐厅也是经营策略的一环吗？还真是深奥呢…"
                }
            ]
        },
        {
            "id": "4018906",
            "objective": "前往主题餐厅",
            "dialogues": []
        },
        {
            "id": "4018907",
            "objective": "选择制作主题料理",
            "dialogues": [
                {
                    "id": "401890701",
                    "speaker": "娜维娅",
                    "text": "查看简历的时候，要注意对方擅长的工作哦！"
                }
            ]
        },
        {
            "id": "4018908",
            "objective": "与爱可菲对话",
            "dialogues": [
                {
                    "id": "401891401",
                    "speaker": "爱可菲",
                    "text": "这款「香烤肋排」使用了改良配比的酱汁，口感相比经典款更为饱满，但不油腻。"
                },
                {
                    "id": "401891402",
                    "speaker": "爱可菲",
                    "text": "佐料中的薄荷提取物还能给人神清气爽的回甘，适合在尽情游玩后吃个痛快。"
                },
                {
                    "id": "401891403",
                    "speaker": "爱可菲",
                    "text": "不过，相比客人，我觉得工匠们更需要这些料理。"
                },
                {
                    "id": "401891404",
                    "speaker": "派蒙",
                    "text": "工匠？"
                },
                {
                    "id": "401891405",
                    "speaker": "爱可菲",
                    "text": "这座乐园还没建设到最理想的状态吧？工匠们吃了这些「香烤肋排」，应当能更快地补充体力，消除疲惫。"
                },
                {
                    "id": "401891406",
                    "speaker": "爱可菲",
                    "text": "作为负责人，你们本来也要为工匠们提供伙食，不如就请他们来这里就餐？"
                },
                {
                    "id": "401891407",
                    "speaker": "爱可菲",
                    "text": "说不定，还能提升工匠们的士气，提升施工的效率呢。"
                },
                {
                    "id": "401891408",
                    "speaker": "娜维娅",
                    "text": "哦？我依稀记得，你以前也给灰河的搬运工们提供过特制的炸鱼薯条…"
                },
                {
                    "id": "401891409",
                    "speaker": "娜维娅",
                    "text": "结果那几天，工人们的效率超高，只用五小时就忙完了八小时的任务，提前下班休息，第二天也精神饱满。"
                },
                {
                    "id": "401891410",
                    "speaker": "爱可菲",
                    "text": "事不宜迟，趁着「香烤肋排」还热腾腾，去邀请工匠们吧，我这边再准备一些配菜和餐后甜点。"
                },
                {
                    "id": "401891411",
                    "speaker": "派蒙",
                    "text": "真有道理！不愧是爱可菲！"
                },
                {
                    "id": "401891412",
                    "speaker": "派蒙",
                    "text": "这样看来，「主题料理」一定能发挥超强的作用，每过一段时间，我们都要来找你！"
                },
                {
                    "id": "401891413",
                    "speaker": "Black Screen",
                    "text": "与娜维娅一起邀请了工匠们，请他们享用了特别的「香烤肋排」大餐…"
                }
            ]
        },
        {
            "id": "4018909",
            "objective": "前往升级设施",
            "dialogues": [
                {
                    "id": "401890901",
                    "speaker": "娜维娅",
                    "text": "这段时间的经营开了个好头，是时候进入下一个周期啦！"
                }
            ]
        },
        {
            "id": "4018910",
            "objective": "与娜维娅对话",
            "dialogues": [
                {
                    "id": "401891601",
                    "speaker": "娜维娅",
                    "text": "呼…万事俱备！运营「海薇玛映影欢乐城」的要点，已经全都被你们掌握了！"
                },
                {
                    "id": "401891602",
                    "speaker": "派蒙",
                    "text": "欸？掌握了吗？"
                },
                {
                    "id": "401891603",
                    "speaker": "派蒙",
                    "text": "不知不觉，好像确实学会了不少事？",
                    "choices": [
                        {
                            "id": "401891604",
                            "text": "说明娜维娅教得深入浅出。",
                            "response": [
                                {
                                    "id": "401891606",
                                    "speaker": "娜维娅",
                                    "text": "没有啦，没有啦，其实我也没教你们什么东西，你们自己的悟性才最关键！"
                                },
                                {
                                    "id": "401891607",
                                    "speaker": "娜维娅",
                                    "text": "初听「长期经营」这个词，好像很吓人，对不对？"
                                },
                                {
                                    "id": "401891608",
                                    "speaker": "娜维娅",
                                    "text": "但是不用怕，只要把复杂的东西拆成小事，一件一件做下去，就算没什么天赋，不是聪明绝顶的人，也一定能做到！"
                                },
                                {
                                    "id": "401891609",
                                    "speaker": "派蒙",
                                    "text": "喔喔喔！感觉到了自己的进步，动力源源不断涌上来了！我要把娜维娅鼓励人的话记在笔记本里！"
                                },
                                {
                                    "id": "401891610",
                                    "speaker": "派蒙",
                                    "text": "接下来，我们就和娜维娅一起，好好经营这座「海薇玛映影欢乐城」吧！"
                                }
                            ]
                        },
                        {
                            "id": "401891605",
                            "text": "我们跟着娜维娅成了好老板。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4018901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401890101",
                    "speaker": "娜维娅",
                    "text": "#{NICKNAME}，你来啦？"
                },
                {
                    "id": "401890102",
                    "speaker": "娜维娅",
                    "text": "准备好加入「海薇玛映影欢乐城」的大家庭了吗？"
                }
            ]
        },
        {
            "id": "4018903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401890301",
                    "speaker": "Player",
                    "text": "还有别的事要处理。"
                },
                {
                    "id": "401890302",
                    "speaker": "娜维娅",
                    "text": "好，随时等着你！"
                }
            ]
        },
        {
            "id": "4018911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401891101",
                    "speaker": "爱可菲",
                    "text": "嗯…"
                },
                {
                    "id": "401891102",
                    "speaker": "爱可菲",
                    "text": "餐厅的条件很不错，水畔用餐的氛围相当特别。映影的景观能让食客们的兴致高涨，更细致地品味美食…"
                },
                {
                    "id": "401891103",
                    "speaker": "爱可菲",
                    "text": "食材也就位了，准备好厨具，马上就能开工。"
                },
                {
                    "id": "401891104",
                    "speaker": "派蒙",
                    "text": "你好呀，爱可菲！"
                },
                {
                    "id": "401891105",
                    "speaker": "爱可菲",
                    "text": "哦？我的雇主们来了。"
                },
                {
                    "id": "401891106",
                    "speaker": "爱可菲",
                    "text": "#刺玫会的老板，加上著名的{NICKNAME}和派蒙…这样的阵容运营一个映影乐园，有点奢华。"
                },
                {
                    "id": "401891107",
                    "speaker": "娜维娅",
                    "text": "德波大饭店的前主厨才和「奢华」这个词关联最紧密吧？不管你走到哪，都会带来一股精致料理的香气哦。"
                },
                {
                    "id": "401891108",
                    "speaker": "爱可菲",
                    "text": "咳咳…正事要紧。"
                },
                {
                    "id": "401891109",
                    "speaker": "爱可菲",
                    "text": "#看来，娜维娅是想让{NICKNAME}决定各个时期的「主题料理」吧？"
                },
                {
                    "id": "401891110",
                    "speaker": "Player",
                    "text": "「主题料理」？"
                },
                {
                    "id": "401891111",
                    "speaker": "娜维娅",
                    "text": "这就是我之前提到的经营策略——用顶级厨师的料理，为「海薇玛映影欢乐城」吸引额外的客源！"
                },
                {
                    "id": "401891112",
                    "speaker": "娜维娅",
                    "text": "不…不止吸引客源，爱可菲的杰作肯定还能发挥其他惊喜的效果！"
                },
                {
                    "id": "401891113",
                    "speaker": "娜维娅",
                    "text": "你想想，派蒙，假如只需要一张乐园的门票，不仅能玩个痛快，还能吃到传说中的美食，你不心动吗？"
                },
                {
                    "id": "401891114",
                    "speaker": "派蒙",
                    "text": "那那那！那我一定天天来！",
                    "choices": [
                        {
                            "id": "401891115",
                            "text": "有没有年卡？年卡救一下？",
                            "response": [
                                {
                                    "id": "401891117",
                                    "speaker": "爱可菲",
                                    "text": "不过，要是公开菜单，吸引客人的效果就会减半了。"
                                },
                                {
                                    "id": "401891118",
                                    "speaker": "爱可菲",
                                    "text": "根据一位美食品牌顾问的调查，许多餐馆采用了「主厨随机料理」。"
                                },
                                {
                                    "id": "401891119",
                                    "speaker": "爱可菲",
                                    "text": "所以，每过几个经营周期，就由你来给我灵感，决定我应当制作什么「主题料理」。"
                                },
                                {
                                    "id": "401891120",
                                    "speaker": "爱可菲",
                                    "text": "把手给我。",
                                    "choices": [
                                        {
                                            "id": "401891121",
                                            "text": "手…手吗？",
                                            "response": [
                                                {
                                                    "id": "401891123",
                                                    "speaker": "爱可菲",
                                                    "text": "嗯，温暖而饱含活力的触感。"
                                                },
                                                {
                                                    "id": "401891124",
                                                    "speaker": "爱可菲",
                                                    "text": "长期接触剑柄的肌肤结有一层坚韧的茧，但很细腻，你持剑时，就像执掌提琴的弓弦…"
                                                },
                                                {
                                                    "id": "401891125",
                                                    "speaker": "爱可菲",
                                                    "text": "剑…我明白了，这次的主题是「力量」。"
                                                },
                                                {
                                                    "id": "401891126",
                                                    "speaker": "爱可菲",
                                                    "text": "来吧，看看你所带来的「力量」灵感，最终会凝聚成怎样的料理。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401891122",
                                            "text": "原来是物理传递灵感…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401891116",
                            "text": "我直接想个法子在这里住下！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4018912",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401891201",
                    "speaker": "爱可菲",
                    "text": "来吧，看看你所带来的「力量」灵感，最终会凝聚成怎样的料理。"
                }
            ]
        },
        {
            "id": "4018913",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401891301",
                    "speaker": "娜维娅",
                    "text": "啊呀，是爱可菲的经典即兴烹饪——「关键原料触发神秘料理」！"
                }
            ]
        },
        {
            "id": "4018915",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401891501",
                    "speaker": "娜维娅",
                    "text": "一切进行得非常顺利，是时候好好改良设施了！"
                }
            ]
        },
        {
            "id": "4018999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401899901",
                    "speaker": "派蒙",
                    "text": "有了「主题料理」的帮忙，工匠们干劲满满呢。"
                },
                {
                    "id": "401899902",
                    "speaker": "娜维娅",
                    "text": "正好，我们就抓住这个窗口，进一步改良「缤纷蹈险奇行」的设施吧。"
                },
                {
                    "id": "401899903",
                    "speaker": "娜维娅",
                    "text": "如你们所见，现在的欢乐城有点像没加糖的马卡龙，多个区域还在建设中。"
                },
                {
                    "id": "401899904",
                    "speaker": "娜维娅",
                    "text": "刺玫会聘请的工匠数量有限，我们的经验也不足以支撑太复杂的多线工作。"
                },
                {
                    "id": "401899905",
                    "speaker": "娜维娅",
                    "text": "所以说，我采用了「工作时间段」的规划方法——每段时间专心做好特定的工作。"
                },
                {
                    "id": "401899906",
                    "speaker": "娜维娅",
                    "text": "改良设施、扩建场地、雇佣员工…这些事都需要我们花费「资金」和「工作时间段」去完成。"
                },
                {
                    "id": "401899907",
                    "speaker": "娜维娅",
                    "text": "在每一个「经营周期」内，我们要将宝贵的「工作时间段」分配到最有价值的事务上。"
                },
                {
                    "id": "401899908",
                    "speaker": "娜维娅",
                    "text": "随着我们吸引更多客人，赚到更多「资金」，工作愈发熟练…"
                },
                {
                    "id": "401899909",
                    "speaker": "娜维娅",
                    "text": "相同周期内，能划分的「工作时间段」也会更细致，到时候，我们就能完成更多经营工作了！"
                },
                {
                    "id": "401899910",
                    "speaker": "派蒙",
                    "text": "也就是说，我们在每一段时间内，能够做出的决定、专心去做的工作并不多。"
                },
                {
                    "id": "401899911",
                    "speaker": "派蒙",
                    "text": "要用有限的行动次数和摩拉，去赚到更多摩拉！"
                },
                {
                    "id": "401899912",
                    "speaker": "派蒙",
                    "text": "其实和下棋、玩牌戏有一些相像的地方呢，先考虑好行动策略最重要。"
                },
                {
                    "id": "401899913",
                    "speaker": "派蒙",
                    "text": "这个摊位改良以后，应该能吸引更多顾客吧？"
                },
                {
                    "id": "401899914",
                    "speaker": "娜维娅",
                    "text": "没错，我根据刺玫会商业合作的经验，量化评估了「服务值」，以便你们直观理解摊位让顾客满意的水准——"
                },
                {
                    "id": "401899915",
                    "speaker": "娜维娅",
                    "text": "项目的「服务值」达到预期时，才能获得最理想的收益。随着我们改良和扩建设施，这个预期值也会相应提高。"
                },
                {
                    "id": "401899916",
                    "speaker": "娜维娅",
                    "text": "这种时候，我们可以安排能力更强的员工上阵，或者花费一定的资金培训员工，提升员工的工作水准！"
                }
            ]
        }
    ]
}