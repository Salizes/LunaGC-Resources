    "talks": [
        {
            "id": "7618201",
            "objective": "前往隐居处开启茶会",
            "dialogues": [
                {
                    "id": "761820101",
                    "speaker": "「少女」",
                    "text": "这就是你曾经生活的地方吗？真漂亮。"
                },
                {
                    "id": "761820102",
                    "speaker": "「木偶」",
                    "text": "以前更漂亮。我打理花园可是很有一手的。"
                },
                {
                    "id": "761820103",
                    "speaker": "「少女」",
                    "text": "哈哈。"
                },
                {
                    "id": "761820104",
                    "speaker": "「木偶」",
                    "text": "你又傻笑什么…"
                },
                {
                    "id": "761820105",
                    "speaker": "「少女」",
                    "text": "想象了一下那时的桑多涅蹲在花丛边的样子，觉得很可爱。"
                },
                {
                    "id": "761820106",
                    "speaker": "「少女」",
                    "text": "我等下可以进屋看看吗？"
                },
                {
                    "id": "761820107",
                    "speaker": "「木偶」",
                    "text": "当然，我已经把灰尘都清理过一遍了。"
                },
                {
                    "id": "761820108",
                    "speaker": "「少女」",
                    "text": "你今后打算怎么处理这个家？"
                },
                {
                    "id": "761820109",
                    "speaker": "「木偶」",
                    "text": "嗯…果然还是想留下它。有时间就回来打理一下吧。"
                },
                {
                    "id": "761820110",
                    "speaker": "「少女」",
                    "text": "没时间的话，我也可以来帮你打理。"
                },
                {
                    "id": "761820111",
                    "speaker": "「少女」",
                    "text": "这里和曾经你房间给我的感觉一样，令人安心。我很喜欢。"
                },
                {
                    "id": "761820112",
                    "speaker": "「木偶」",
                    "text": "哼…随你便吧。"
                }
            ]
        },
        {
            "id": "7618202",
            "objective": "前往隐居处开启茶会",
            "dialogues": [
                {
                    "id": "761820201",
