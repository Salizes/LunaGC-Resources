    "talks": [
        {
            "id": "7011201",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701120101",
                    "speaker": "乔瑟夫斯",
                    "text": "对了，德克斯特，今时不同往日。你也应该迎接童年的终结了。"
                },
                {
                    "id": "701120102",
                    "speaker": "乔瑟夫斯",
                    "text": "你也要接受成年的洗礼，学习大人才知道的事情。看好了，小右，我只教这一次。"
                },
                {
                    "id": "701120103",
                    "speaker": "派蒙",
                    "text": "听起来像是在交代后事一样。"
                },
                {
                    "id": "701120104",
                    "speaker": "乔瑟夫斯",
                    "text": "最后一课，先和我一起读：「元素的分类」。你来试试吧。"
                }
            ]
        },
        {
            "id": "7011202",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7011203",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701120301",
                    "speaker": "乔瑟夫斯",
                    "text": "我想学伊斯托利亚的语气说一句「真棒！」，但是我拉不下这个脸。"
                },
                {
                    "id": "701120302",
                    "speaker": "乔瑟夫斯",
                    "text": "我已经没有什么可以教你的了。最后一课到此结束。"
                },
                {
                    "id": "701120303",
                    "speaker": "派蒙",
                    "text": "#你教了什么啊。这不是{NICKNAME}教的吗！"
                }
            ]
        },
        {
            "id": "7011204",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701120201",
                    "speaker": "乔瑟夫斯",
                    "text": "做得不错。"
                },
                {
                    "id": "701120202",
                    "speaker": "派蒙",
                    "text": "不知道你是在夸哪一边。"
                },
                {
                    "id": "701120203",
                    "speaker": "乔瑟夫斯",
                    "text": "那么接下来，考虑一下事物之间的相互作用吧。"
                },
                {
                    "id": "701120204",
                    "speaker": "乔瑟夫斯",
                    "text": "注意元素的反应、长程力和短程力。要记得避开扰动。"
                },
                {
                    "id": "701120205",
                    "speaker": "派蒙",
                    "text": "你在说什么啊！"
                }
            ]
        },
