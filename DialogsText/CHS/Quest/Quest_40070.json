    "talks": [
        {
            "id": "4007001",
            "objective": "疏通岛屿水脉",
            "dialogues": []
        },
        {
            "id": "4007002",
            "objective": "疏通岛屿水脉",
            "dialogues": []
        },
        {
            "id": "4007003",
            "objective": "(test)(hide)回滚隔离环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007018",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400701801",
                    "speaker": "派蒙",
                    "text": "能做的都做了，剩下那两座山怎么也解决不了…"
                },
                {
                    "id": "400701802",
                    "speaker": "辛焱",
                    "text": "再想想，会有办法的。"
                },
                {
                    "id": "400701803",
                    "speaker": "莫娜",
                    "text": "刚才我仔细看过，岛上几座山内部多半都有水脉和植物，这种体系将它们串联在一起。"
                },
                {
                    "id": "400701804",
                    "speaker": "莫娜",
                    "text": "但现在山体坍塌，植物和水脉无法连通。"
                },
                {
                    "id": "400701805",
                    "speaker": "枫原万叶",
                    "text": "如果所有脉络都被打通，它们就会连接起来，形成阿贝多笔记中所说的「巨型乐器」，以岛屿为单位演奏了。"
                },
                {
                    "id": "400701806",
                    "speaker": "辛焱",
                    "text": "嗯，为了我想做的事，必须做到这一点…我想去问问那朵花，它应该知道办法。"
                }
            ]
        },
        {
            "id": "4007015",
            "objective": "寻求「火炽之心」的帮助",
            "dialogues": []
        },
        {
            "id": "4007004",
            "objective": "寻求「火炽之心」的帮助",
            "dialogues": [
                {
                    "id": "400700401",
                    "speaker": "辛焱",
                    "text": "岛上有些山体失去了植物和水脉，请问你有办法疏通它们吗？"
                },
                {
                    "id": "400700402",
                    "speaker": "火炽之心",
                    "text": "这件事，我知道一个人能帮忙。楼上住着我的同伴冰封之心，去问问它吧。"
                }
            ]
        },
        {
            "id": "4007005",
            "objective": "寻找「冰封之心」",
            "dialogues": [
                {
                    "id": "400700501",
                    "speaker": "冰封之心",
                    "text": "你们是什么人？竟然会到我这里来。"
                },
                {
                    "id": "400700502",
                    "speaker": "辛焱",
                    "text": "你好，我们想借助你的力量疏通岛上那几座山。"
                },
                {
                    "id": "400700503",
                    "speaker": "冰封之心",
                    "text": "山？噢，我知道了…你们也想成为大音乐家，是吗？"
                },
                {
                    "id": "400700504",
                    "speaker": "派蒙",
                    "text": "欸？是这样吗？"
                },
                {
                    "id": "400700505",
                    "speaker": "辛焱",
                    "text": "没错。"
                },
                {
                    "id": "400700506",
                    "speaker": "冰封之心",
                    "text": "既然如此，我们就是志同道合的伙伴了。即使我很柔弱，也要为你们献上一份力量。"
                },
                {
                    "id": "400700507",
                    "speaker": "冰封之心",
                    "text": "拿着我的花瓣，把它种在音律交汇的终点，沉入地下的山脉将为这乐声升起。只要我们还有音乐，生命就会流淌在每一寸土地上。"
                },
                {
                    "id": "400700508",
                    "speaker": "辛焱",
                    "text": "…谢谢你。"
                }
            ]
        },
        {
            "id": "4007009",
            "objective": "种下「冰封之心」的花瓣",
            "dialogues": []
        },
        {
            "id": "4007013",
            "objective": "使用「冰封之心」的力量",
            "dialogues": []
        },
        {
            "id": "4007006",
            "objective": "疏通岛屿水脉",
            "dialogues": []
        },
        {
            "id": "4007007",
            "objective": "疏通岛屿水脉",
            "dialogues": []
        },
        {
            "id": "4007008",
            "objective": "(test)(hide)回滚隔离环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007019",
            "objective": "将成果告知「冰封之心」",
            "dialogues": [
                {
                    "id": "400701901",
                    "speaker": "辛焱",
                    "text": "我们把花瓣种下去了，你能感觉到什么吗？"
                },
                {
                    "id": "400701902",
                    "speaker": "冰封之心",
                    "text": "嗯…有了。阳光不错，海上有宝石般绚烂的光芒，浪拍打着乳白色的沙滩，那些沙粒流入海中，又被推回来…"
                },
                {
                    "id": "400701903",
                    "speaker": "冰封之心",
                    "text": "…有海鸟落在岩石上，轻轻啄着，发出有节奏的乐曲。咚咚，咚咚…"
                },
                {
                    "id": "400701904",
                    "speaker": "辛焱",
                    "text": "是音乐。"
                },
                {
                    "id": "400701905",
                    "speaker": "冰封之心",
                    "text": "是音乐啊。说起来，这座岛本就是一件庞大的乐器。既然你是音乐人，应该能理解其中的深意。"
                },
                {
                    "id": "400701906",
                    "speaker": "辛焱",
                    "text": "用海风、浪花与潮汐演奏音乐，是这个世界上最浪漫的事。"
                },
                {
                    "id": "400701907",
                    "speaker": "辛焱",
                    "text": "走吧各位，是时候请你们听听我的演出了。"
                }
            ]
        },
        {
            "id": "4007010",
            "objective": "前往有风的山头",
            "dialogues": [
                {
                    "id": "400701001",
                    "speaker": "辛焱",
                    "text": "……"
                },
                {
                    "id": "400701002",
                    "speaker": "辛焱",
                    "text": "终于，到这个时候了。"
                },
                {
                    "id": "400701003",
                    "speaker": "辛焱",
                    "text": "各位，我曾许下一个愿望，要跟谁都想不到的人一起办演唱会。而今天，我在海岛上找到了答案。"
                },
                {
                    "id": "400701004",
                    "speaker": "辛焱",
                    "text": "许多年前将这座岛制成巨型乐器的人，没人知道他的名字和长相，但他绝对是提瓦特最伟大的音乐家之一。"
                },
                {
                    "id": "400701005",
                    "speaker": "辛焱",
                    "text": "我从没想过能见到这样一件乐器。更想不到，我们能趁着潮汐奏响它。"
                },
                {
                    "id": "400701006",
                    "speaker": "Player",
                    "text": "要演奏摇滚乐了吗？"
                },
                {
                    "id": "400701007",
                    "speaker": "辛焱",
                    "text": "不。"
                },
                {
                    "id": "400701008",
                    "speaker": "辛焱",
                    "text": "音乐是献给知己的礼物，所以…我会选择更适合这位原住民的方式与他合奏。"
                },
                {
                    "id": "400701009",
                    "speaker": "辛焱",
                    "text": "今天就不玩摇滚乐了，给大家看点新花样！"
                },
                {
                    "id": "400701010",
                    "speaker": "辛焱",
                    "text": "…呼。"
                },
                {
                    "id": "400701011",
                    "speaker": "辛焱",
                    "text": "怎么样？我的演奏还不错吧？"
                },
                {
                    "id": "400701012",
                    "speaker": "莫娜",
                    "text": "非常不错。"
                },
                {
                    "id": "400701013",
                    "speaker": "枫原万叶",
                    "text": "从未听过这样的合奏，很有意思。"
                },
                {
                    "id": "400701014",
                    "speaker": "派蒙",
                    "text": "而且很高雅！我不知道该怎么说…反正很不一样。",
                    "choices": [
                        {
                            "id": "400701015",
                            "text": "很有性格的演出。",
                            "response": [
                                {
                                    "id": "400701017",
                                    "speaker": "辛焱",
                                    "text": "嘿嘿，谢谢大家。"
                                },
                                {
                                    "id": "400701018",
                                    "speaker": "辛焱",
                                    "text": "这样一来，我的愿望也算是完成了。"
                                },
                                {
                                    "id": "400701019",
                                    "speaker": "莫娜",
                                    "text": "还有什么想做的吗？"
                                },
                                {
                                    "id": "400701020",
                                    "speaker": "辛焱",
                                    "text": "没有了。今晚应该能睡个好觉吧。"
                                },
                                {
                                    "id": "400701021",
                                    "speaker": "枫原万叶",
                                    "text": "接下来大家都闲着对吧？那我有个提议。"
                                },
                                {
                                    "id": "400701022",
                                    "speaker": "枫原万叶",
                                    "text": "我想再去一趟愚人众营地，确认那里的情况。"
                                },
                                {
                                    "id": "400701023",
                                    "speaker": "莫娜",
                                    "text": "嗯？原来你们也发现愚人众营地了。"
                                },
                                {
                                    "id": "400701024",
                                    "speaker": "枫原万叶",
                                    "text": "等等，你也知道？"
                                },
                                {
                                    "id": "400701025",
                                    "speaker": "莫娜",
                                    "text": "我可是天才占星术士，而且我不是说过？水占盘恢复一点了。我能通过占卜感觉到这里的情况。"
                                },
                                {
                                    "id": "400701026",
                                    "speaker": "辛焱",
                                    "text": "咦，这里都有愚人众？"
                                },
                                {
                                    "id": "400701027",
                                    "speaker": "莫娜",
                                    "text": "对。今天跟菲谢尔分开时，我也把这件事告诉她了。假如遇到愚人众，她会隐藏起来，不会有危险。"
                                },
                                {
                                    "id": "400701028",
                                    "speaker": "枫原万叶",
                                    "text": "原来如此，那我们也坦白吧。"
                                },
                                {
                                    "id": "400701029",
                                    "speaker": "Black Screen",
                                    "text": "将登岛那天遇到愚人众营地和奇怪装置的事仔细说给其他人听…"
                                },
                                {
                                    "id": "400701030",
                                    "speaker": "莫娜",
                                    "text": "奇怪的装置，神志不清的愚人众…你们的意思是，这些跟最近的幻境有关？"
                                },
                                {
                                    "id": "400701031",
                                    "speaker": "枫原万叶",
                                    "text": "不能保证。但我觉得，两者之间不应该完全没有关联。"
                                },
                                {
                                    "id": "400701032",
                                    "speaker": "辛焱",
                                    "text": "有道理，那赶快去营地看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "400701016",
                            "text": "很有韵味的演出。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007011",
            "objective": "确认愚人众装置的情况",
            "dialogues": []
        },
        {
            "id": "4007012",
            "objective": "击败敌人",
            "dialogues": []
        },
        {
            "id": "4007016",
            "objective": "回到愚人众堡垒附近",
            "dialogues": [
                {
                    "id": "400701601",
                    "speaker": "派蒙",
                    "text": "奇怪，一路过来只有岛上的本土怪物，没有愚人众了。"
                },
                {
                    "id": "400701602",
                    "speaker": "莫娜",
                    "text": "驻扎的痕迹和装置都还在，但人都不见了，好奇怪。"
                },
                {
                    "id": "400701603",
                    "speaker": "Player",
                    "text": "（我一直认为，这些幻境的诞生与这台愚人众装置关系很大。它看起来已经坏了，也许这就是问题的根源。）"
                },
                {
                    "id": "400701604",
                    "speaker": "Player",
                    "text": "（…假如装置能让人产生幻觉，那他们自己为什么消失了？还是说，另有隐情？）"
                },
                {
                    "id": "400701605",
                    "speaker": "Player",
                    "text": "（找不到人，是因为他们消失了，还是他们在躲避我们？）"
                },
                {
                    "id": "400701606",
                    "speaker": "莫娜",
                    "text": "算了，占卜一下看看。"
                },
                {
                    "id": "400701607",
                    "speaker": "莫娜",
                    "text": "……"
                },
                {
                    "id": "400701608",
                    "speaker": "莫娜",
                    "text": "嗯？这是…力量在流动？"
                },
                {
                    "id": "400701609",
                    "speaker": "莫娜",
                    "text": "各位，似乎没能占出愚人众的踪迹，水占盘又变得浑浊了，但这次我能感知到某种力量正在汇聚成型。"
                },
                {
                    "id": "400701610",
                    "speaker": "莫娜",
                    "text": "目的地是…那边的小岛。"
                },
                {
                    "id": "400701611",
                    "speaker": "辛焱",
                    "text": "这次会是跟谁有关的幻境呢？"
                },
                {
                    "id": "400701612",
                    "speaker": "莫娜",
                    "text": "唔…过去看看吧，说不定会有线索。"
                }
            ]
        },
        {
            "id": "4007017",
            "objective": "前往莫娜所说的岛屿",
            "dialogues": [
                {
                    "id": "400701701",
                    "speaker": "枫原万叶",
                    "text": "到了各位。"
                },
                {
                    "id": "400701702",
                    "speaker": "莫娜",
                    "text": "咦？菲谢尔？"
                },
                {
                    "id": "400701703",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400701704",
                    "speaker": "派蒙",
                    "text": "真的是她！菲谢尔——！"
                },
                {
                    "id": "400701705",
                    "speaker": "菲谢尔",
                    "text": "…哼，来了吗，诸位愚笨的家臣。"
                },
                {
                    "id": "400701706",
                    "speaker": "奥兹",
                    "text": "哦、哦呀，好久不见了！"
                },
                {
                    "id": "400701707",
                    "speaker": "辛焱",
                    "text": "也没那么久吧？"
                },
                {
                    "id": "400701708",
                    "speaker": "奥兹",
                    "text": "啊…小姐和我察觉到某种气息，特意提前赶往此处，等待与诸位会合。没想到，诸位…诸位来得比想象中更快。"
                },
                {
                    "id": "400701709",
                    "speaker": "派蒙",
                    "text": "奥兹看起来有点紧张？是我的错觉吗？"
                },
                {
                    "id": "400701710",
                    "speaker": "菲谢尔",
                    "text": "幽夜净土降临在即，本皇女还需要筹备祝圣仪典。"
                },
                {
                    "id": "400701711",
                    "speaker": "奥兹",
                    "text": "小姐，您又要…"
                },
                {
                    "id": "400701712",
                    "speaker": "菲谢尔",
                    "text": "我一人也可行动，奥兹，你若是厌烦了夤夜的侵袭，就退回到白日炽光中去。"
                },
                {
                    "id": "400701713",
                    "speaker": "奥兹",
                    "text": "小姐，如此话语可不像您该对我说的。我是您的扈从，您的眼睛，不可能丢下您。"
                },
                {
                    "id": "400701714",
                    "speaker": "菲谢尔",
                    "text": "…少在那里用打量的眼神看着我了！总、总之，现在还没到解释的时候。"
                },
                {
                    "id": "400701715",
                    "speaker": "奥兹",
                    "text": "哎呀，小姐！"
                },
                {
                    "id": "400701716",
                    "speaker": "奥兹",
                    "text": "诸位，万分抱歉，小姐心情不好，还请不要放在心上。也恕我先失陪了。"
                },
                {
                    "id": "400701717",
                    "speaker": "莫娜",
                    "text": "…哈，离队这么久，心情也没好起来嘛。"
                },
                {
                    "id": "400701718",
                    "speaker": "莫娜",
                    "text": "看到菲谢尔，我就觉得这一带即将成型的幻境应该跟她有关。"
                },
                {
                    "id": "400701719",
                    "speaker": "枫原万叶",
                    "text": "嗯。靠近与我有关的幻境时，我隐约能感觉到某种熟悉的气息。"
                },
                {
                    "id": "400701720",
                    "speaker": "辛焱",
                    "text": "我也是。虽然并无道理，只是觉得有什么有意思的东西要出现了。"
                },
                {
                    "id": "400701721",
                    "speaker": "莫娜",
                    "text": "嗯。菲谢尔和奥兹能有所感知，说明这份预感也会成真…菲谢尔应该就是不想面对她的幻境，才这么焦躁。"
                },
                {
                    "id": "400701722",
                    "speaker": "派蒙",
                    "text": "怎么会这样…"
                },
                {
                    "id": "400701723",
                    "speaker": "莫娜",
                    "text": "或许，她的幻境中隐藏着某些不希望被人知道的秘密吧。"
                },
                {
                    "id": "400701724",
                    "speaker": "莫娜",
                    "text": "各位，我们先在这里休息吧。等幻境出现，谜底自然就会揭开。"
                }
            ]
        },
        {
            "id": "4007014",
            "objective": "(test)(hide)进入梦境发送自由通知$HIDDEN",
            "dialogues": []
        }
    ]
}