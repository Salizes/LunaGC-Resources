    "talks": [
        {
            "id": "7350201",
            "objective": "（test）发现告示牌$HIDDEN",
            "dialogues": [
                {
                    "id": "735020101",
                    "speaker": "公告",
                    "text": "「与白昼交班的白昼，从桥上能看见灯塔匆匆下班的背影。」"
                },
                {
                    "id": "735020102",
                    "speaker": "派蒙",
                    "text": "这，这是什么啊…是谜语吗？还是什么谚语之类的…"
                },
                {
                    "id": "735020103",
                    "speaker": "派蒙",
                    "text": "与白昼交班的白昼？下，下班的背影…"
                },
                {
                    "id": "735020104",
                    "speaker": "卡玛尔",
                    "text": "这不是旅行者吗？你们也对德鲁苏先生的谜语感兴趣吗？",
                    "choices": [
                        {
                            "id": "735020105",
                            "text": "这真是谜语吗？",
                            "response": [
                                {
                                    "id": "735020107",
                                    "speaker": "卡玛尔",
                                    "text": "设置这段谜语的人是教令院的一位学者，德鲁苏先生。"
                                },
                                {
                                    "id": "735020108",
                                    "speaker": "卡玛尔",
                                    "text": "据我所知…那位先生在教令院里也算是一个怪人…"
                                },
                                {
                                    "id": "735020109",
                                    "speaker": "卡玛尔",
                                    "text": "他最喜欢的就是和人讨论各种各样的谜语，还有研究各种加密方式。"
                                },
                                {
                                    "id": "735020110",
                                    "speaker": "卡玛尔",
                                    "text": "但他的谜语有的实在是太晦涩难懂了，所以也没多少人愿意和他交流。"
                                },
                                {
                                    "id": "735020111",
                                    "speaker": "卡玛尔",
                                    "text": "所以，他就想出了这种「有奖解谜」的方式。"
                                },
                                {
                                    "id": "735020112",
                                    "speaker": "卡玛尔",
                                    "text": "简单来说，这段谜语实际上是在暗示着一个「藏宝地点」。"
                                },
                                {
                                    "id": "735020113",
                                    "speaker": "卡玛尔",
                                    "text": "只要在正确的时间，用正确的方式，到达正确的地点，就能够获得宝藏。"
                                },
                                {
                                    "id": "735020114",
                                    "speaker": "卡玛尔",
                                    "text": "德鲁苏先生也给了提示，说是这些「藏宝地点」都在须弥城内。"
                                },
                                {
                                    "id": "735020115",
                                    "speaker": "卡玛尔",
                                    "text": "但是如你们所见，目前依然还没有一个冒险家能够解开这道谜语。"
                                },
                                {
                                    "id": "735020116",
                                    "speaker": "卡玛尔",
                                    "text": "如果你们有兴趣的话，也可以试试看。"
                                },
                                {
                                    "id": "735020117",
                                    "speaker": "卡玛尔",
                                    "text": "但我从个人角度来说，我其实更建议你们去做点正事啦…"
                                }
                            ]
                        },
                        {
                            "id": "735020106",
                            "text": "你知道是谁设置的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350207",
            "objective": "",
            "dialogues": [
                {
                    "id": "735020701",
                    "speaker": "派蒙",
                    "text": "果然在这里啊，「通往知识的必经之路」说的就是这些桥了吧。"
                },
                {
                    "id": "735020702",
                    "speaker": "派蒙",
                    "text": "这箱子还有纸条…这个连环解谜还没结束吗？"
                },
                {
                    "id": "735020703",
                    "speaker": "派蒙",
                    "text": "我看看，上面写着…"
                },
                {
                    "id": "735020704",
                    "speaker": "派蒙",
                    "text": "「姹紫嫣红，盛水为珠。」"
                },
                {
                    "id": "735020705",
                    "speaker": "Player",
                    "text": "什，什么啊？！"
                },
                {
                    "id": "735020706",
                    "speaker": "派蒙",
                    "text": "总感觉是在形容某种花呢，但「盛水为珠」又是什么意思呢…"
                }
            ]
        },
        {
            "id": "7350208",
            "objective": "",
            "dialogues": [
                {
                    "id": "735020801",
                    "speaker": "派蒙",
                    "text": "原来还真说的是「莲花」啊，这么一想…它的叶子确实可以说是「盛水为珠」呢…"
                },
                {
                    "id": "735020802",
                    "speaker": "派蒙",
                    "text": "这箱子里还有一张纸条…"
                },
                {
                    "id": "735020803",
                    "speaker": "派蒙",
                    "text": "「请在正午之时，造访知识殿堂的正门。」"
                },
                {
                    "id": "735020804",
                    "speaker": "派蒙",
                    "text": "怎么写得这么直白，我还以为又会是谜语呢。"
                },
                {
                    "id": "735020805",
                    "speaker": "派蒙",
                    "text": "唔…不管了，我们就按照这上面说的，在正午的时候去「知识殿堂的正门」看看吧。"
                }
            ]
        },
        {
            "id": "7350209",
            "objective": "",
            "dialogues": [
                {
                    "id": "735020901",
                    "speaker": "公告栏上的谜语",
                    "text": "「与白昼交班的白昼，从桥上能看见灯塔匆匆下班的背影。」"
                }
            ]
        },
        {
            "id": "7350204",
            "objective": "(test)控制学院宝箱开启$HIDDEN",
            "dialogues": [
                {
                    "id": "735020401",
                    "speaker": "德鲁苏",
                    "text": "（test）时间不对，按照纸条的时间来！"
                }
            ]
        },
        {
            "id": "7350205",
            "objective": "(test)控制荷花宝箱开启$HIDDEN",
            "dialogues": [
                {
                    "id": "735020501",
                    "speaker": "派蒙",
                    "text": "「刚吃过早餐的正午，与白昼交班的白昼。」"
                },
                {
                    "id": "735020502",
                    "speaker": "派蒙",
                    "text": "原来…意思就是：在大中午的时候去灯塔顶上啊！"
                },
                {
                    "id": "735020503",
                    "speaker": "派蒙",
                    "text": "费了这么大的劲！原来就这么简单啊！"
                },
                {
                    "id": "735020504",
                    "speaker": "派蒙",
                    "text": "算了，能找到宝藏就好…快看看箱子里有什么吧。"
                },
                {
                    "id": "735020505",
                    "speaker": "Player",
                    "text": "这还有一张纸条…"
                },
                {
                    "id": "735020506",
                    "speaker": "派蒙",
                    "text": "欸？上面写着什么？给我看看。"
                },
                {
                    "id": "735020507",
                    "speaker": "派蒙",
                    "text": "「无镜之镜，照见诸戏。」"
                },
                {
                    "id": "735020508",
                    "speaker": "派蒙",
                    "text": "难道，这是在暗示下一个藏宝地吗？"
                },
                {
                    "id": "735020509",
                    "speaker": "派蒙",
                    "text": "这里面提到了「戏」，难道是说宝藏的所在地和「剧场」有关吗？"
                },
                {
                    "id": "735020510",
                    "speaker": "派蒙",
                    "text": "不明白…但感觉上，好像是在暗示一个很厉害的地方啊。"
                }
            ]
        },
        {
            "id": "7350202",
            "objective": "（test）获得全部小信物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7350206",
            "objective": "",
            "dialogues": [
                {
                    "id": "735020601",
                    "speaker": "派蒙",
                    "text": "「无镜之镜，照见诸戏。」"
                },
                {
                    "id": "735020602",
                    "speaker": "派蒙",
                    "text": "照见诸戏，原来指的是这个大剧场啊…"
                },
                {
                    "id": "735020603",
                    "speaker": "派蒙",
                    "text": "无镜之镜，指的是剧院后面那个池塘…"
                },
                {
                    "id": "735020604",
                    "speaker": "派蒙",
                    "text": "这地方一点都不厉害啊！为什么要用看上去那么厉害的谜语，形容这么一个普普通通的地方啦！"
                },
                {
                    "id": "735020605",
                    "speaker": "Player",
                    "text": "这箱子里还有纸条喔。"
                },
                {
                    "id": "735020606",
                    "speaker": "派蒙",
                    "text": "又是谜语吗？这是什么连环解谜啊…"
                },
                {
                    "id": "735020607",
                    "speaker": "派蒙",
                    "text": "「通往知识的必经之路。」"
                },
                {
                    "id": "735020608",
                    "speaker": "派蒙",
                    "text": "这个看上去…好像没什么难度…"
                },
                {
                    "id": "735020609",
                    "speaker": "派蒙",
                    "text": "毕竟，在须弥城里能够代表「知识」的地方，也只有那里了呢…"
                }
            ]
        },
        {
            "id": "7350203",
            "objective": "（test）跟最终NPC对话$HIDDEN",
            "dialogues": [
                {
                    "id": "735020301",
                    "speaker": "德鲁苏",
                    "text": "今天也没人来吗…"
                },
                {
                    "id": "735020302",
                    "speaker": "Player",
                    "text": "这就是「知识殿堂的正门」吗？"
                },
                {
                    "id": "735020303",
                    "speaker": "德鲁苏",
                    "text": "没错！这里就是「知识殿堂的正门」，您…看来是解开了我所有的谜语啊。"
                },
                {
                    "id": "735020304",
                    "speaker": "德鲁苏",
                    "text": "太好了！我还以为今天也没人能做到这件事呢！再等一会我可就要回去吃午饭了…"
                },
                {
                    "id": "735020305",
                    "speaker": "Player",
                    "text": "你为什么要写这些谜语？"
                },
                {
                    "id": "735020306",
                    "speaker": "德鲁苏",
                    "text": "当然是因为「有趣」啊。"
                },
                {
                    "id": "735020307",
                    "speaker": "派蒙",
                    "text": "回答得好快！"
                },
                {
                    "id": "735020308",
                    "speaker": "德鲁苏",
                    "text": "除了这个理由之外，你们觉得我又为什么会写下这些谜语呢？"
                },
                {
                    "id": "735020309",
                    "speaker": "德鲁苏",
                    "text": "难道你们以为，我就是单纯地在享受刁难人的感觉吗？",
                    "choices": [
                        {
                            "id": "735020310",
                            "text": "说不定呢…",
                            "response": [
                                {
                                    "id": "735020312",
                                    "speaker": "德鲁苏",
                                    "text": "哈哈哈，那你们就和教令院里的某些人一样误解我了。"
                                },
                                {
                                    "id": "735020313",
                                    "speaker": "德鲁苏",
                                    "text": "我之所以写下这些谜语，就是单纯地喜爱解读谜语时的那种思辨感。"
                                },
                                {
                                    "id": "735020314",
                                    "speaker": "德鲁苏",
                                    "text": "你们现在回过头来看我的谜语，里面总是有一个能够解开谜语的「关键词」。"
                                },
                                {
                                    "id": "735020315",
                                    "speaker": "德鲁苏",
                                    "text": "只要以这个关键词为突破口不断思考，就一定能解开谜语。"
                                },
                                {
                                    "id": "735020316",
                                    "speaker": "德鲁苏",
                                    "text": "如果我是单纯地想要刁难人，那我只要抹去一切线索，把这段谜语变成真正的「无解之题」就好了。"
                                },
                                {
                                    "id": "735020317",
                                    "speaker": "德鲁苏",
                                    "text": "先不说这些了，既然你们解开了我所有的谜语，那这些东西你们就拿着吧。"
                                },
                                {
                                    "id": "735020318",
                                    "speaker": "德鲁苏",
                                    "text": "这是你们用自己的「思辨」赢来的奖励，可要收好了啊。"
                                }
                            ]
                        },
                        {
                            "id": "735020311",
                            "text": "我说不好。"
                        }
                    ]
                }
            ]
        }
    ]
}