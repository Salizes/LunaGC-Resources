    "talks": [
        {
            "id": "7621801",
            "objective": "开车$HIDDEN",
            "dialogues": [
                {
                    "id": "762180101",
                    "speaker": "「木偶」",
                    "text": "嗯？你们来了。"
                },
                {
                    "id": "762180102",
                    "speaker": "派蒙",
                    "text": "你好呀！桑多涅。",
                    "choices": [
                        {
                            "id": "762180103",
                            "text": "谢谢你的邀请。",
                            "response": [
                                {
                                    "id": "762180105",
                                    "speaker": "派蒙",
                                    "text": "咦？你信里不是说要开茶会吗？怎么这里什么都没有，你该不会没准备好茶点吧？"
                                },
                                {
                                    "id": "762180106",
                                    "speaker": "「木偶」",
                                    "text": "哈，笑话。你还真是小看我了。"
                                },
                                {
                                    "id": "762180107",
                                    "speaker": "派蒙",
                                    "text": "哇！这…这桌子是怎么突然变出来的？！"
                                },
                                {
                                    "id": "762180108",
                                    "speaker": "「木偶」",
                                    "text": "哼哼，厉害吧？这是我新研制的便携式茶桌。"
                                },
                                {
                                    "id": "762180109",
                                    "speaker": "「木偶」",
                                    "text": "它不仅方便携带、易于收纳，甚至还加装了和法洁欧一样的悬浮装置。"
                                },
                                {
                                    "id": "762180110",
                                    "speaker": "「木偶」",
                                    "text": "更厉害的是…呃，算了，我就不自夸了，搞得像我在推销一样。你们自己感受吧。"
                                },
                                {
                                    "id": "762180111",
                                    "speaker": "「木偶」",
                                    "text": "来，这是我准备的茶和点心。"
                                },
                                {
                                    "id": "762180112",
                                    "speaker": "Player",
                                    "text": "那我不客气了。"
                                },
                                {
                                    "id": "762180113",
                                    "speaker": "派蒙",
                                    "text": "唔…！真好吃！你手艺果然很好！"
                                },
                                {
                                    "id": "762180114",
                                    "speaker": "「木偶」",
                                    "text": "那是当然。"
                                },
                                {
                                    "id": "762180115",
                                    "speaker": "派蒙",
                                    "text": "不过，你怎么会想到要做这么一个装置呀？"
                                },
                                {
                                    "id": "762180116",
                                    "speaker": "「木偶」",
                                    "text": "当然是为了和朋友们在任何地方都能度过一段愉快的茶会时光啊。"
                                },
                                {
                                    "id": "762180117",
                                    "speaker": "「木偶」",
                                    "text": "之前我也说过。留住珍贵之物的方法并不只有坚守你已有的东西。"
                                },
                                {
                                    "id": "762180118",
                                    "speaker": "「木偶」",
                                    "text": "现在的我，变得想多出去走，多去见见朋友们了。"
                                },
                                {
                                    "id": "762180119",
                                    "speaker": "「木偶」",
                                    "text": "但让收到邀请的人准备茶点收拾茶桌，未免太不符合淑女的礼仪。"
                                },
                                {
                                    "id": "762180120",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我倒是觉得朋友们不会在意啦。"
                                },
                                {
                                    "id": "762180121",
                                    "speaker": "「木偶」",
                                    "text": "我在意。而且这种简单的发明对我来说也不费力。"
                                },
                                {
                                    "id": "762180122",
                                    "speaker": "「木偶」",
                                    "text": "看你们这么喜欢，干脆就送你们一个好了。"
                                },
                                {
                                    "id": "762180123",
                                    "speaker": "派蒙",
                                    "text": "欸？！这怎么行？"
                                },
                                {
                                    "id": "762180124",
                                    "speaker": "「木偶」",
                                    "text": "没什么不行的。说了我很会做这些东西。"
                                },
                                {
                                    "id": "762180125",
                                    "speaker": "Player",
                                    "text": "那就谢谢了…"
                                },
                                {
                                    "id": "762180126",
                                    "speaker": "「木偶」",
                                    "text": "别客气，你们千灵节的时候也帮了我不少忙，就当是淑女的回礼吧。"
                                }
                            ]
                        },
                        {
                            "id": "762180104",
                            "text": "希望没让你等太久。"
                        }
                    ]
                }
            ]
        },
        {
