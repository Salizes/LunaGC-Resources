    "talks": [
        {
            "id": "7224701",
            "objective": "(test)领取任务,解锁5个封印$HIDDEN",
            "dialogues": [
                {
                    "id": "722470101",
                    "speaker": "阿倍良久",
                    "text": "旅者啊，汝准备好了吗？"
                }
            ]
        },
        {
            "id": "7224705",
            "objective": "与残魂对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722470301",
                    "speaker": "派蒙",
                    "text": "有、有什么东西出来了…"
                },
                {
                    "id": "722470302",
                    "speaker": "派蒙",
                    "text": "看上去好像也是一个残影。"
                },
                {
                    "id": "722470303",
                    "speaker": "阿倍良久",
                    "text": "吾乃…"
                },
                {
                    "id": "722470304",
                    "speaker": "阿倍良久",
                    "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
                },
                {
                    "id": "722470305",
                    "speaker": "派蒙",
                    "text": "这句话我听懂了。"
                },
                {
                    "id": "722470306",
                    "speaker": "派蒙",
                    "text": "这句话的意思就是——"
                },
                {
                    "id": "722470307",
                    "speaker": "派蒙",
                    "text": "他说自己的名字是赫利俄斯。",
                    "choices": [
                        {
                            "id": "722470308",
                            "text": "根本就没懂吧！",
                            "response": [
                                {
                                    "id": "722470310",
                                    "speaker": "派蒙",
                                    "text": "是这样吗……"
                                },
                                {
                                    "id": "722470311",
                                    "speaker": "派蒙",
                                    "text": "他的名字叫阿倍良久…真是奇怪的名字。"
                                },
                                {
                                    "id": "722470312",
                                    "speaker": "派蒙",
                                    "text": "不过，既然他的名字是阿倍良久，那赫利俄斯又是什么呢？"
                                },
                                {
                                    "id": "722470313",
                                    "speaker": "阿倍良久",
                                    "text": "赫利俄斯！赫利俄斯！！"
                                },
                                {
                                    "id": "722470314",
                                    "speaker": "阿倍良久",
                                    "text": "此乃吾亲手所造…赫利俄斯造成之日，万丈光芒自高天笼罩，如是众人不受龙兽侵扰。"
                                },
                                {
                                    "id": "722470315",
                                    "speaker": "阿倍良久",
                                    "text": "啊啊，正当时，诸民仰视，热泪盈眶，扬臂欢呼，难掩喜悦激动之情…可是现在怎么…"
                                },
                                {
                                    "id": "722470316",
                                    "speaker": "阿倍良久",
                                    "text": "不对，吾，吾为何在此…为何…为何吾魂迷梦土，不得安宁。"
                                },
                                {
                                    "id": "722470317",
                                    "speaker": "Player",
                                    "text": "派蒙听懂了吗？"
                                },
                                {
                                    "id": "722470318",
                                    "speaker": "派蒙",
                                    "text": "我懂了。"
                                },
                                {
                                    "id": "722470319",
                                    "speaker": "派蒙",
                                    "text": "这一定是个…精神不太正常的残魂。"
                                },
                                {
                                    "id": "722470320",
                                    "speaker": "阿倍良久",
                                    "text": "吾想起来了…吾魂魄不全，等吾魂归一处，即可重获安宁。"
                                },
                                {
                                    "id": "722470321",
                                    "speaker": "阿倍良久",
                                    "text": "转机就在汝身，吾且与汝言说…"
                                },
                                {
                                    "id": "722470322",
                                    "speaker": "派蒙",
                                    "text": "呃，我闻到了麻烦事的气息…"
                                },
                                {
                                    "id": "722470323",
                                    "speaker": "阿倍良久",
                                    "text": "此处本应供奉吾一部分骨殖，但是早已朽坏…算是吾托命于汝…"
                                },
                                {
                                    "id": "722470324",
                                    "speaker": "阿倍良久",
                                    "text": "将这些寄托吾念的供奉品拿去…不过，周围有困守吾魂的怪物，一旦吾魂魄寄寓之物离开…便会蜂拥而上。"
                                },
                                {
                                    "id": "722470325",
                                    "speaker": "阿倍良久",
                                    "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
                                }
                            ]
                        },
                        {
                            "id": "722470309",
                            "text": "他的名字叫阿倍良久。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224702",
            "objective": "开启残魂的试炼",
            "dialogues": [
                {
                    "id": "722470501",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "722470502",
                    "speaker": "阿倍良久",
                    "text": "那就祝汝……武运昌隆。"
                }
            ]
        },
        {
            "id": "7224703",
            "objective": "(test)开启了挑战,失败回滚上一环节$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7224704",
            "objective": "从残魂处取得供奉之物",
            "dialogues": [
                {
                    "id": "722470201",
                    "speaker": "阿倍良久",
                    "text": "看来汝等的实力完全足以…护送供奉之物…"
                },
                {
                    "id": "722470202",
                    "speaker": "阿倍良久",
                    "text": "这样，吾也能够放心了…一定要将之送到，如此才能…"
                },
                {
                    "id": "722470203",
                    "speaker": "派蒙",
                    "text": "如此才能什么呢？"
                },
                {
                    "id": "722470204",
                    "speaker": "阿倍良久",
                    "text": "如此才能…如此才能…"
                },
                {
                    "id": "722470205",
                    "speaker": "派蒙",
                    "text": "完了，完全是一副坏掉了的样子。"
                },
                {
                    "id": "722470206",
                    "speaker": "派蒙",
                    "text": "不过他说的供奉品，就是这个吧…看上去也有点破破烂烂了。"
                }
            ]
        },
        {
            "id": "7224706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722470601",
                    "speaker": "Player",
                    "text": "不，还需要准备一下。"
                },
                {
                    "id": "722470602",
                    "speaker": "阿倍良久",
                    "text": "那就静候汝之佳音了。"
                }
            ]
        }
    ]
}