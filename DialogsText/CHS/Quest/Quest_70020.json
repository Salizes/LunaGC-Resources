    "talks": [
        {
            "id": "7002001",
            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700200102",
                    "speaker": "落单的丘丘人",
                    "text": "Odomu! Ya dala?"
                },
                {
                    "id": "700200103",
                    "speaker": "艾拉·马斯克",
                    "text": "等等，让我来处理吧。"
                },
                {
                    "id": "700200104",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo, Odomu nye! Muhe mani?"
                },
                {
                    "id": "700200105",
                    "speaker": "落单的丘丘人",
                    "text": "Mani? Mani! Yoyo mani mi?"
                },
                {
                    "id": "700200106",
                    "speaker": "艾拉·马斯克",
                    "text": "Dada!"
                },
                {
                    "id": "700200107",
                    "speaker": "落单的丘丘人",
                    "text": "Dada!",
                    "choices": [
                        {
                            "id": "700200108",
                            "text": "好像很顺利呢。",
                            "response": [
                                {
                                    "id": "700200110",
                                    "speaker": "艾拉·马斯克",
                                    "text": "我在问它是否需要帮助，看样子它果然需要我们帮忙呢。"
                                },
                                {
                                    "id": "700200111",
                                    "speaker": "落单的丘丘人",
                                    "text": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!"
                                },
                                {
                                    "id": "700200112",
                                    "speaker": "艾拉·马斯克",
                                    "text": "呃…它的意思大概是，需要我们去帮助它打败…强大的敌人。"
                                },
                                {
                                    "id": "700200113",
                                    "speaker": "艾拉·马斯克",
                                    "text": "Ya zido? Ye? Mi?"
                                },
                                {
                                    "id": "700200114",
                                    "speaker": "落单的丘丘人",
                                    "text": "Mi! Mi!"
                                },
                                {
                                    "id": "700200115",
                                    "speaker": "艾拉·马斯克",
                                    "text": "好的，那家伙的位置已经标在地图上了，接下来看你的咯！"
                                },
                                {
                                    "id": "700200116",
                                    "speaker": "落单的丘丘人",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200109",
                            "text": "你们在说什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002002",
            "objective": "前往指定地点战斗",
            "dialogues": [
                {
                    "id": "700200201",
                    "speaker": "落单的丘丘人",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700200202",
                    "speaker": "落单的丘丘人",
                    "text": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>！"
                },
                {
                    "id": "700200203",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>Unta nunu</color>…好像和时间什么的有关系…别忘了查查手册吧？",
                    "choices": [
                        {
                            "id": "700200204",
                            "text": "呃…谢谢？",
                            "response": [
                                {
                                    "id": "700200206",
                                    "speaker": "落单的丘丘人",
                                    "text": "Valo, tomo!"
                                },
                                {
                                    "id": "700200207",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200205",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002003",
            "objective": "向丘丘人回复",
            "dialogues": []
        },
        {
            "id": "7002003",
