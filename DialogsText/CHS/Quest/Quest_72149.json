    "talks": [
        {
            "id": "7214901",
            "objective": "返回珊瑚宫与露子对话",
            "dialogues": [
                {
                    "id": "721490201",
                    "speaker": "露子",
                    "text": "#欢迎回来，{NICKNAME}。请问有什么事吗？"
                },
                {
                    "id": "721490202",
                    "speaker": "Player",
                    "text": "关于你的委托…"
                },
                {
                    "id": "721490203",
                    "speaker": "派蒙",
                    "text": "我们已经取得四颗「御灵珠」啦！"
                },
                {
                    "id": "721490204",
                    "speaker": "露子",
                    "text": "这样吗？真是太可靠了，非常感谢！那么接下来距离解开最后的「心」之封印就只有一步之遥了。"
                },
                {
                    "id": "721490205",
                    "speaker": "露子",
                    "text": "接下来还要辛苦两位随我一同前去，希望您不要介意。"
                },
                {
                    "id": "721490206",
                    "speaker": "派蒙",
                    "text": "#既然都到这里了，我们也不在乎多走两步路啦！对吧，{NICKNAME}？",
                    "choices": [
                        {
                            "id": "721490207",
                            "text": "好吧。",
                            "response": [
                                {
                                    "id": "721490209",
                                    "speaker": "露子",
                                    "text": "那么事不宜迟，我们现在就出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "721490208",
                            "text": "我没什么所谓。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7214902",
            "objective": "打开「海祇之心」的大门",
            "dialogues": []
        },
        {
            "id": "7214907",
            "objective": "(test)海神之心大门交付$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7214903",
            "objective": "进入「心」之所在",
            "dialogues": [
                {
                    "id": "721490301",
                    "speaker": "露子",
                    "text": "嗯…"
                },
                {
                    "id": "721490302",
                    "speaker": "Player",
                    "text": "露子小姐…？"
                },
                {
                    "id": "721490303",
                    "speaker": "露子",
                    "text": "啊，抱歉，刚刚太入神了。"
                },
                {
                    "id": "721490304",
                    "speaker": "露子",
                    "text": "多谢你们的帮助，终于取得「月浴渊之钥」了。"
                },
                {
                    "id": "721490305",
                    "speaker": "派蒙",
                    "text": "「余哕鱼圆只月」…好拗口…那是什么啊？"
                },
                {
                    "id": "721490306",
                    "speaker": "露子",
                    "text": "哈哈，简称「渊之钥」就好，我们不会强求外国人的读音准确与否的。"
                },
                {
                    "id": "721490307",
                    "speaker": "露子",
                    "text": "这是打开渊下宫入口的必备之物，由大御神大人身上流出的血铸结而成…"
                },
                {
                    "id": "721490308",
                    "speaker": "露子",
                    "text": "至少传说是这样的。"
                },
                {
                    "id": "721490309",
                    "speaker": "派蒙",
                    "text": "哦…"
                },
                {
                    "id": "721490310",
                    "speaker": "Player",
                    "text": "玄之又玄呢…"
                },
                {
                    "id": "721490311",
                    "speaker": "露子",
                    "text": "一点也不玄啦，恰恰相反…"
                },
                {
                    "id": "721490312",
                    "speaker": "露子",
                    "text": "接下来要上报现人神巫女大人，等她批准，再等灵脉的流动正确…"
                },
                {
                    "id": "721490313",
                    "speaker": "露子",
                    "text": "之后，就可以进入渊下宫了。"
                },
                {
                    "id": "721490314",
                    "speaker": "派蒙",
                    "text": "所以你在支使我们做什么啦！"
                },
                {
                    "id": "721490315",
                    "speaker": "露子",
                    "text": "你们这趟又不是全无收获！对吧？"
                },
                {
                    "id": "721490316",
                    "speaker": "露子",
                    "text": "比如…你们收获了珊瑚宫官方长久的友谊！海祇岛今后会一直欢迎你们的！"
                },
                {
                    "id": "721490317",
                    "speaker": "派蒙",
                    "text": "什么啦！说得像真的一样！"
                },
                {
                    "id": "721490318",
                    "speaker": "露子",
                    "text": "…"
                },
                {
                    "id": "721490319",
                    "speaker": "露子",
                    "text": "记载中有说，「御灵珠」只会应正直纯良之辈的召唤，「月浴渊之钥」也只会为心灵清澈如水之人凝聚。"
                },
                {
                    "id": "721490320",
                    "speaker": "露子",
                    "text": "虽然我不总是相信那些文书，但我相信您能给海祇岛带来转机。"
                },
                {
                    "id": "721490321",
                    "speaker": "露子",
                    "text": "那么，待下渊下宫之刻到来…",
                    "choices": [
                        {
                            "id": "721490322",
                            "text": "我们后会有期。",
                            "response": [
                                {
                                    "id": "721490325",
                                    "speaker": "露子",
                                    "text": "那么，再见啦。"
                                }
                            ]
                        },
                        {
                            "id": "721490323",
                            "text": "你会再求一次签？",
                            "response": [
                                {
                                    "id": "721490324",
                                    "speaker": "露子",
                                    "text": "呵呵，我签运很好的。我们一定还会再见面。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7214904",
            "objective": "解除最后的封印",
            "dialogues": [
