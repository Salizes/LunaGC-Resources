    "talks": [
        {
            "id": "7307602",
            "objective": "（test）击杀鳄鱼王$HIDDEN",
            "dialogues": [
                {
                    "id": "730760201",
                    "speaker": "？？？",
                    "text": "哎呀…果然在须弥，才能感受到更多自然的气息啊，哈哈，相较而言，枫丹简直就是乌烟瘴气…"
                },
                {
                    "id": "730760202",
                    "speaker": "？？？",
                    "text": "嗯？怎么了，有什么事吗？"
                },
                {
                    "id": "730760203",
                    "speaker": "Player",
                    "text": "只是有些好奇…"
                },
                {
                    "id": "730760204",
                    "speaker": "派蒙",
                    "text": "是啊，你就住在这个帐篷里吗？"
                },
                {
                    "id": "730760205",
                    "speaker": "？？？",
                    "text": "对，最近一段时间我都住在这里…哈哈我懂了，看到一个枫丹人住在须弥野外的帐篷，觉得很不可思议对吧。"
                },
                {
                    "id": "730760206",
                    "speaker": "？？？",
                    "text": "至于为什么这样，就让我好好解释一番吧…啊，首先，两位的名字是？"
                },
                {
                    "id": "730760207",
                    "speaker": "派蒙",
                    "text": "我叫派蒙。"
                },
                {
                    "id": "730760208",
                    "speaker": "Player",
                    "text": "#我叫{NICKNAME}。"
                },
                {
                    "id": "730760209",
                    "speaker": "？？？",
                    "text": "#原来如此，是{NICKNAME}和派蒙，我记住了。"
                },
                {
                    "id": "730760210",
                    "speaker": "桑顿",
                    "text": "我是桑顿，如你们所见，我是一个枫丹人…之所以来须弥的理由嘛，当然是因为喜欢森林！"
                },
                {
                    "id": "730760211",
                    "speaker": "桑顿",
                    "text": "总是生活在城市中，身体会因为缺少锻炼而衰弱，精神也会变得松懈和倦怠。"
                },
                {
                    "id": "730760212",
                    "speaker": "桑顿",
                    "text": "只有在广袤的自然中，才能重新得到那种与自然万物共存的深刻体会，而森林正是贴近自然最好的选择。"
                },
                {
                    "id": "730760213",
                    "speaker": "桑顿",
                    "text": "所以就来须弥了，毕竟这里的森林大概是全提瓦特最好的森林啦。"
                },
                {
                    "id": "730760214",
                    "speaker": "派蒙",
                    "text": "好像听懂了，但是又好像完全没有懂…"
                },
                {
                    "id": "730760215",
                    "speaker": "派蒙",
                    "text": "不过须弥的森林可是很危险的，有各种大大小小的魔物…"
                },
                {
                    "id": "730760216",
                    "speaker": "桑顿",
                    "text": "当然要危险才行啊！"
                },
                {
                    "id": "730760217",
                    "speaker": "派蒙",
                    "text": "啊？"
                },
                {
                    "id": "730760218",
                    "speaker": "桑顿",
                    "text": "要是不危险的话，就没有那种求生的感觉了！不用担心，我其实在枫丹也是有名的猎人…"
                },
                {
                    "id": "730760219",
                    "speaker": "派蒙",
                    "text": "什么呀，原来你说喜欢森林，是喜欢在森林里狩猎！"
                },
                {
                    "id": "730760220",
                    "speaker": "派蒙",
                    "text": "哼，根本就是个枫丹来的偷猎者！",
                    "choices": [
                        {
                            "id": "730760221",
                            "text": "偷猎会破坏生态…",
                            "response": [
                                {
                                    "id": "730760223",
                                    "speaker": "桑顿",
                                    "text": "等等等等，你们弄错了，我可不是偷猎者…偷猎可是相当严重的违法行为。"
                                },
                                {
                                    "id": "730760224",
                                    "speaker": "桑顿",
                                    "text": "在枫丹如果被抓到偷猎，那一辈子就完了，我可不敢。我们枫丹猎人所做的，其实大多只是「凶猛动物的防治」而已。"
                                },
                                {
                                    "id": "730760225",
                                    "speaker": "派蒙",
                                    "text": "凶猛动物的…防治？"
                                },
                                {
                                    "id": "730760226",
                                    "speaker": "桑顿",
                                    "text": "你想啊，太过靠近人类居住区的凶猛动物会导致双方都受到伤害吧…所以得把它们赶到居住区一定距离以外才行。"
                                },
                                {
                                    "id": "730760227",
                                    "speaker": "派蒙",
                                    "text": "是、是这样啊…"
                                },
                                {
                                    "id": "730760228",
                                    "speaker": "桑顿",
                                    "text": "这样，附近的居民就不用面临凶猛动物的侵扰，而对于那些动物来说，居民的活动也不会对它们正常生活产生困扰。"
                                },
                                {
                                    "id": "730760229",
                                    "speaker": "桑顿",
                                    "text": "实不相瞒，我也是听说了附近有类似的凶猛动物，接受了驱逐它们的委托，才住在这里的，身为猎人，怎么能坐视不管呢！"
                                },
                                {
                                    "id": "730760230",
                                    "speaker": "桑顿",
                                    "text": "…当然了，我个人也对这些凶猛动物有点兴趣。"
                                },
                                {
                                    "id": "730760231",
                                    "speaker": "桑顿",
                                    "text": "你看，这个就很让人在意，「生长过度的大型鳄鱼」，被孩子们称为「鳄鱼大王」，总觉得是在什么下水道传说里出现的角色。"
                                },
                                {
                                    "id": "730760232",
                                    "speaker": "派蒙",
                                    "text": "#啊，大型鳄鱼，{NICKNAME}，会不会说的就是我们遇到过的那条…"
                                },
                                {
                                    "id": "730760233",
                                    "speaker": "桑顿",
                                    "text": "什么，传说中的「鳄鱼大王」已经被你们驱逐掉了吗！"
                                },
                                {
                                    "id": "730760234",
                                    "speaker": "桑顿",
                                    "text": "据说「鳄鱼大王」在奔流之间浮出水面，就如突然升起、将河水阻断的巨大沙洲，怎么样，真的有那么夸张吗？",
                                    "choices": [
                                        {
                                            "id": "730760235",
                                            "text": "正是如此！",
                                            "response": [
                                                {
                                                    "id": "730760236",
                                                    "speaker": "桑顿",
                                                    "text": "真是了不起啊！"
                                                },
                                                {
                                                    "id": "730760240",
                                                    "speaker": "桑顿",
                                                    "text": "从刚才就觉得，你们身上有那种，就是那种，老练猎人一般的气息，看来我并没有看走眼！"
                                                },
                                                {
                                                    "id": "730760241",
                                                    "speaker": "派蒙",
                                                    "text": "那是当然啦，我们也经历过很多了不起的事呢。"
                                                },
                                                {
                                                    "id": "730760242",
                                                    "speaker": "桑顿",
                                                    "text": "除了「鳄鱼大王」，还有其他两只凶猛动物，「抓走孩童的长鬓虎罗阇」，「拦在通往璃月山路上的巨大驮兽」…"
                                                },
                                                {
                                                    "id": "730760243",
                                                    "speaker": "桑顿",
                                                    "text": "「长鬓虎罗阇」好像在西边的密林里。"
                                                },
                                                {
                                                    "id": "730760244",
                                                    "speaker": "桑顿",
                                                    "text": "「驮兽大王」据说是只巨大无比的驮兽。几个看到它后吓破胆子的目击者说，它在东边的某块区域徘徊，一见到行人就会攻击。"
                                                },
                                                {
                                                    "id": "730760245",
                                                    "speaker": "派蒙",
                                                    "text": "听上去都挺危险的呢…"
                                                },
                                                {
                                                    "id": "730760246",
                                                    "speaker": "桑顿",
                                                    "text": "是啊，要是你们遇到了，一定要小心…哈哈，不过对于能够解决「鳄鱼大王」的你们来说，我的担忧恐怕是多余的啦，哈哈。"
                                                },
                                                {
                                                    "id": "730760247",
                                                    "speaker": "桑顿",
                                                    "text": "如果路上遇到了，就帮忙驱逐一下这些凶猛动物吧！"
                                                },
                                                {
                                                    "id": "730760248",
                                                    "speaker": "桑顿",
                                                    "text": "这样周围的居民也不会遇到危险了！"
                                                },
                                                {
                                                    "id": "730760249",
                                                    "speaker": "Player",
                                                    "text": "嗯，如果遇到的话…"
                                                },
                                                {
                                                    "id": "730760250",
                                                    "speaker": "桑顿",
                                                    "text": "那真是太感谢了！"
                                                },
                                                {
                                                    "id": "730760251",
                                                    "speaker": "桑顿",
                                                    "text": "附近居民的安全，这些凶猛动物的安全，当然了，还有你们自己的安全，都要注意啊！"
                                                },
                                                {
                                                    "id": "730760252",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，知道啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730760237",
                                            "text": "传闻多少有点夸张…",
                                            "response": [
                                                {
                                                    "id": "730760238",
                                                    "speaker": "桑顿",
                                                    "text": "是、是嘛…不知为何感觉有点失望。"
                                                },
                                                {
                                                    "id": "730760239",
                                                    "speaker": "桑顿",
                                                    "text": "不过普通体型的鳄鱼已经很难对付了，应付生长时间更长更狡猾的「鳄鱼大王」想必更加凶险。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730760222",
                            "text": "那我们必须干预一下了…"
                        }
                    ]
                }
            ]
        },
