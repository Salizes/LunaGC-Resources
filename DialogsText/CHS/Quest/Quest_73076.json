                        {
                            "id": "730760122",
                            "text": "偷猎是会破坏生态的行为！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307603",
            "objective": "（test）布下陷阱$HIDDEN",
            "dialogues": [
                {
                    "id": "730760301",
                    "speaker": "桑顿",
                    "text": "怎么样，你遇到那些凶猛动物了吗？"
                },
                {
                    "id": "730760302",
                    "speaker": "桑顿",
                    "text": "遇到的话就请你帮忙驱逐掉那些凶猛动物吧…「凶猛动物防治」，可是件有利于居民和动物双方的有益之举。",
                    "choices": [
                        {
                            "id": "730760303",
                            "text": "关于「鳄鱼大王」…",
                            "response": [
                                {
                                    "id": "730760304",
                                    "speaker": "桑顿",
                                    "text": "据说「鳄鱼大王」就在城东边的水域附近…不过似乎很是狡猾，我去了好几次都没有见到啊…"
                                }
                            ]
                        },
                        {
                            "id": "730760305",
                            "text": "关于「长鬓虎罗阇」…",
                            "response": [
                                {
                                    "id": "730760306",
                                    "speaker": "桑顿",
                                    "text": "附近似乎都在传「长鬓虎罗阇」的故事，说在夜半时分，它会从西边的森林里跑出来，抓走那些不愿乖乖睡觉的顽皮鬼…"
                                },
                                {
                                    "id": "730760307",
                                    "speaker": "桑顿",
                                    "text": "虽然后面大概是父母吓唬孩子的说辞，不过据说「长鬓虎」在夜间确实会更活跃一些…"
                                },
                                {
                                    "id": "730760308",
                                    "speaker": "桑顿",
                                    "text": "听说有半夜赶路的旅人就曾经看到过那只巨大的「长鬓虎」，被追了好一段路，好在没有出什么事…"
                                }
                            ]
                        },
                        {
                            "id": "730760309",
                            "text": "关于「驮兽大王」…",
                            "response": [
                                {
                                    "id": "730760310",
                                    "speaker": "桑顿",
                                    "text": "听说一些野生驮兽有很强的领地概念，陌生人一旦进入领地就会受到它们的攻击，恐怕「驮兽大王」也一样。"
                                },
                                {
                                    "id": "730760311",
                                    "speaker": "桑顿",
                                    "text": "它的领地就在东边的某个区域…"
                                },
                                {
                                    "id": "730760312",
                                    "speaker": "桑顿",
                                    "text": "究竟多大的驮兽能够被人叫作「驮兽大王」，真是让人在意啊…"
                                }
                            ]
                        },
                        {
                            "id": "730760313",
                            "text": "还在调查…",
                            "response": [
                                {
                                    "id": "730760314",
                                    "speaker": "桑顿",
                                    "text": "是嘛，那就继续加油吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307604",
            "objective": "（test）晚上豹子刷新时间$HIDDEN",
            "dialogues": [
                {
                    "id": "730760401",
                    "speaker": "阿鸿",
                    "text": "「驮兽大王」，那是几天前的事啦，为了找一种特殊矿石，不知不觉就翻到山外去了…"
                },
                {
                    "id": "730760402",
                    "speaker": "阿鸿",
                    "text": "哎呀，就看到那只大驮兽，真的大啊，从没见过那么大的驮兽。"
                },
                {
                    "id": "730760403",
                    "speaker": "阿鸿",
                    "text": "一见到我就往我这边冲，幸好我跑得快…"
                },
                {
                    "id": "730760404",
                    "speaker": "阿鸿",
                    "text": "翻到哪边的山外？嗯，是西边那块的某座山吧，具体的…我也记不清楚了，但肯定是西边就对了。"
                }
            ]
        },
        {
            "id": "7307605",
            "objective": "（test）击杀豹子王$HIDDEN",
            "dialogues": [
                {
                    "id": "730760501",
                    "speaker": "纳吉布",
                    "text": "哦，「驮兽大王」？你们说的就是那个巨大的驮兽是吧…"
                },
                {
                    "id": "730760502",
                    "speaker": "纳吉布",
                    "text": "前两天我想要去璃月，途径层岩巨渊旁的时候，就看到了那个家伙…"
                },
                {
                    "id": "730760503",
                    "speaker": "纳吉布",
                    "text": "幸好那个时候它在睡觉。我小心翼翼地绕过去，逃了一劫啊。它睡觉的时候就跟个小山包似的…"
                },
                {
                    "id": "730760504",
                    "speaker": "纳吉布",
                    "text": "嗯？你说位置吗，从这里到璃月得向南走，应该是南边的某个地方吧…"
                },
                {
                    "id": "730760505",
                    "speaker": "派蒙",
                    "text": "…咦，可是一般从须弥到璃月应该走水路才对，为什么要往层岩巨渊那个方向去啊？"
                },
                {
                    "id": "730760506",
                    "speaker": "纳吉布",
                    "text": "这、这是个人隐私吧，和你们问的东西又没关系！"
                },
                {
                    "id": "730760507",
                    "speaker": "纳吉布",
                    "text": "好了，我知道的就这么多，我还有别的事要做…别来烦我了！"
                }
            ]
        },
        {
            "id": "7307606",
            "objective": "（test）击败驼兽$HIDDEN",
            "dialogues": [
                {
                    "id": "730760601",
                    "speaker": "安纳亚",
                    "text": "咦，关于「驮兽大王」…啊啊，那是我前几天晚上去森林里的时候看到的…"
                },
                {
                    "id": "730760602",
                    "speaker": "安纳亚",
                    "text": "本来就是个全是乌云的晚上，我走路走到一半，发现旁边有一个小山般的黑影伴随着地震般轰隆隆的响声向我冲来…"
                },
                {
                    "id": "730760603",
                    "speaker": "安纳亚",
                    "text": "当时我就被吓晕过去，恢复意识已经是第二天的事了。把我背回来的人说，我昏倒在了山脚下…幸好没受什么重伤…"
                },
                {
                    "id": "730760604",
                    "speaker": "安纳亚",
                    "text": "你说位置嘛…我也不太清楚，反正应该是在东边吧…"
                }
            ]
        },
        {
            "id": "7307608",
            "objective": "（test）和留言板的隐藏对话$HIDDEN",
            "dialogues": [
                {
                    "id": "730761001",
                    "speaker": "一张告示",
                    "text": "「关于近期出现在附近的大型长鬓虎一事：」"
                },
                {
                    "id": "730761002",
                    "speaker": "一张告示",
                    "text": "「请勿在入夜后于附近逗留，据调查，该长鬓虎经常在夜间出没。」"
                },
                {
                    "id": "730761003",
                    "speaker": "一张告示",
                    "text": "「请勿在附近投放肉食，投放肉食令长鬓虎饱足，并非正确的保持安全之法，反而会吸引长鬓虎长期在此活动。」"
                }
            ]
        },
        {
            "id": "7307609",
            "objective": "（test）和路人NPC们的隐藏对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7307607",
            "objective": "（test）和猎人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "730760701",
                    "speaker": "桑顿",
                    "text": "咦，什么，已经把凶猛动物驱赶走了？"
                },
                {
                    "id": "730760702",
                    "speaker": "桑顿",
                    "text": "我都还没见到呢…怎么样，那些凶猛动物是不是都挺强悍的。",
                    "choices": [
                        {
                            "id": "730760703",
                            "text": "也就那样吧…",
                            "response": [
                                {
                                    "id": "730760704",
                                    "speaker": "桑顿",
                                    "text": "哈哈，看上去真是游刃有余。"
                                },
                                {
                                    "id": "730760707",
                                    "speaker": "桑顿",
                                    "text": "虽然听说那些凶猛动物都被驱逐，打从心底松了口气，但是不知为何，没有亲手驱逐他们，也让人觉得不甘心。"
                                },
                                {
                                    "id": "730760708",
                                    "speaker": "桑顿",
                                    "text": "猎物被更强的对手抢走的画面，在自然中也是屡见不鲜啊…"
                                },
                                {
                                    "id": "730760709",
                                    "speaker": "桑顿",
                                    "text": "哈哈哈，如果还有下次，我是不会输的！"
                                },
                                {
                                    "id": "730760710",
                                    "speaker": "Player",
                                    "text": "我们也不会输的！"
                                },
                                {
                                    "id": "730760711",
                                    "speaker": "派蒙",
                                    "text": "是的！"
                                },
                                {
                                    "id": "730760712",
                                    "speaker": "派蒙",
                                    "text": "不过，之前就觉得，「凶猛动物的防治」，在须弥应该是巡林员的工作吧…"
                                },
                                {
                                    "id": "730760713",
                                    "speaker": "桑顿",
                                    "text": "哦，我不是之前也说了吗，我接受了委托…其实那个委托就是认识的巡林员给我的。"
                                },
                                {
                                    "id": "730760714",
                                    "speaker": "桑顿",
                                    "text": "由于最近「死域」的一些问题，具体我也不清楚，但是他们似乎花了很多人力负责调查那个…"
                                },
                                {
                                    "id": "730760715",
                                    "speaker": "桑顿",
                                    "text": "所以「凶猛动物的防治」这样的工作就委托给我了。"
                                },
                                {
                                    "id": "730760716",
                                    "speaker": "派蒙",
                                    "text": "原来是这样。"
                                },
                                {
                                    "id": "730760717",
                                    "speaker": "桑顿",
                                    "text": "这次就多谢你了！这是驱逐凶猛动物的报酬，还请拿好了。"
                                }
                            ]
                        },
                        {
                            "id": "730760705",
                            "text": "可厉害了！",
                            "response": [
                                {
                                    "id": "730760706",
                                    "speaker": "桑顿",
                                    "text": "是嘛，真想亲眼见一见…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}