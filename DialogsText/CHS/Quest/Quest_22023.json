{
    "quest": {
        "id": "22023",
        "title": "家乡之味",
        "description": "来自璃月的学者汤雯似乎饱受思乡之情的困扰…",
        "rewards": [
            {
                "itemId": 100061,
                "count": 5
            }
        ],
        "rewards_formatted": "兽肉 x5",
        "chapter": {
            "icon": "",
