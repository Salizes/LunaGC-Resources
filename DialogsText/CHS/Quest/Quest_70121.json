    "talks": [
        {
            "id": "7012101",
            "objective": "(test)(隐藏)获得任意一个信物碎片$HIDDEN",
            "dialogues": [
                {
                    "id": "701210101",
                    "speaker": "派蒙",
                    "text": "咦？这是什么？是一本…日志？"
                },
                {
                    "id": "701210102",
                    "speaker": "派蒙",
                    "text": "看起来，好像是以前在这里考察的人留下的记录…"
                },
                {
                    "id": "701210103",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，可能有人对这些…嗯，历史记录感兴趣，我们去问问吧。"
                }
            ]
        },
        {
            "id": "7012102",
            "objective": "(test)(隐藏)与派蒙对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012103",
            "objective": "回到大本营，向学者询问和日志有关的线索",
            "dialogues": [
                {
                    "id": "701210201",
                    "speaker": "Player",
                    "text": "我找到了这本日志…"
                },
                {
                    "id": "701210202",
                    "speaker": "史蒂文斯",
                    "text": "嗯？在雪山上找到的？让我看看…"
                },
                {
                    "id": "701210203",
                    "speaker": "史蒂文斯",
                    "text": "喔！这可真是了不得的宝藏。"
                },
                {
                    "id": "701210204",
                    "speaker": "Player",
                    "text": "宝藏？"
                },
                {
                    "id": "701210205",
                    "speaker": "派蒙",
                    "text": "宝藏！"
                },
                {
                    "id": "701210206",
                    "speaker": "史蒂文斯",
                    "text": "…学术意义上的宝藏。"
                },
                {
                    "id": "701210207",
                    "speaker": "史蒂文斯",
                    "text": "我以前游学的时候，曾经读过一些古老的年鉴。"
                },
                {
                    "id": "701210208",
                    "speaker": "史蒂文斯",
                    "text": "一本年鉴上有记载，在骑士团的时代前，蒙德曾经有一支贵族向雪山派出了考察队。"
                },
                {
                    "id": "701210209",
                    "speaker": "史蒂文斯",
                    "text": "但是不知道为什么，在那本年鉴里，关于那支考察团的事，并没有过多的细节记载…"
                },
                {
                    "id": "701210210",
                    "speaker": "史蒂文斯",
                    "text": "如果这些考察日志真是那支考察队留下的，一定能成为重要的历史研究参考。"
                },
                {
                    "id": "701210211",
                    "speaker": "史蒂文斯",
                    "text": "如果你愿意的话，能帮我再去雪山上搜索一下这些日志吗？",
                    "choices": [
                        {
                            "id": "701210212",
                            "text": "交给我吧！",
                            "response": [
                                {
                                    "id": "701210213",
                                    "speaker": "史蒂文斯",
                                    "text": "真的吗？太感谢了！"
                                },
                                {
                                    "id": "701210217",
                                    "speaker": "史蒂文斯",
                                    "text": "根据这篇日志…考察队为了考察，总共去了这座雪山里的三个地方…"
                                },
                                {
                                    "id": "701210218",
                                    "speaker": "史蒂文斯",
                                    "text": "排除你们拿到日志的那一个，应该还有两个…"
                                },
                                {
                                    "id": "701210219",
                                    "speaker": "史蒂文斯",
                                    "text": "我看看…这里…还有这里…嗯，我给你在地图上标记一下。"
                                },
                                {
                                    "id": "701210220",
                                    "speaker": "史蒂文斯",
                                    "text": "那就拜托你了。一定要注意安全。"
                                }
                            ]
                        },
                        {
                            "id": "701210214",
                            "text": "如果有宝藏的话…",
                            "response": [
                                {
                                    "id": "701210215",
                                    "speaker": "史蒂文斯",
                                    "text": "哈哈哈，物质意义上的宝藏不一定有。"
                                },
                                {
                                    "id": "701210216",
                                    "speaker": "史蒂文斯",
                                    "text": "不过，如果你们肯帮忙。我也会准备好合适的…物质上的报酬，犒劳你对学术研究的伟大贡献。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7012105",
            "objective": "前往「阳面的营地」寻找日志",
            "dialogues": []
        },
        {
            "id": "7012106",
            "objective": "前往「密室」寻找日志",
            "dialogues": []
        },
        {
            "id": "7012109",
            "objective": "前往「西南面的遗迹地窖」寻找日志",
            "dialogues": []
        },
        {
            "id": "7012104",
            "objective": "(test)(隐藏)碎片收集进度记录$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012107",
            "objective": "将收集到的日志交给史蒂文斯",
            "dialogues": [
                {
                    "id": "701210301",
                    "speaker": "Player",
                    "text": "关于日志…"
                },
                {
                    "id": "701210302",
                    "speaker": "史蒂文斯",
                    "text": "你把剩下的两份日志也找到了？真是太感谢了。让我看看…"
                },
                {
                    "id": "701210303",
                    "speaker": "史蒂文斯",
                    "text": "嗯…居然是这样…等等，这里的细节…"
                },
                {
                    "id": "701210304",
                    "speaker": "Player",
                    "text": "你发现什么了？"
                },
                {
                    "id": "701210305",
                    "speaker": "史蒂文斯",
                    "text": "啊…哦，不好意思，刚刚有些走神了。"
                },
                {
                    "id": "701210306",
                    "speaker": "史蒂文斯",
                    "text": "谢谢你，这些日志确实是相当宝贵的史料。在已有的资料里，对于那支神秘的贵族探险队一直语焉不详，所有细节都只是一笔带过…"
                },
                {
                    "id": "701210307",
                    "speaker": "史蒂文斯",
                    "text": "你带来的这些日志，补全了不少缺失的信息。"
                },
                {
                    "id": "701210308",
                    "speaker": "史蒂文斯",
                    "text": "这么一来，为什么关于这支考察队的消息如此匮乏，在所有史料中只提过考察队出发的事情，一切都说得通了。"
                },
                {
                    "id": "701210309",
                    "speaker": "Player",
                    "text": "确实，大体上能明白。"
                },
                {
                    "id": "701210310",
                    "speaker": "史蒂文斯",
                    "text": "是的，虽然一些细节还需要再考证一下…但大体的框架已经很清楚了。"
                },
                {
                    "id": "701210311",
                    "speaker": "派蒙",
                    "text": "派蒙不明白！"
                },
                {
                    "id": "701210312",
                    "speaker": "史蒂文斯",
                    "text": "从结果而言，考察队里似乎没有一个人回到蒙德。但从这些日志上来看，至少有一个叫厄伯哈特的人可能逃了回来…"
                },
                {
                    "id": "701210313",
                    "speaker": "史蒂文斯",
                    "text": "不过，蒙德城里却没有与之相关的资料记载，这个人到底去了哪呢，真是让人在意…"
                },
                {
                    "id": "701210314",
                    "speaker": "史蒂文斯",
                    "text": "还有很多细节需要考证…"
                },
                {
                    "id": "701210315",
                    "speaker": "史蒂文斯",
                    "text": "但无论如何，这都是非常宝贵的史料。"
                },
                {
                    "id": "701210316",
                    "speaker": "史蒂文斯",
                    "text": "真的很感谢你。请你收下这些，作为报酬。"
                },
                {
                    "id": "701210317",
                    "speaker": "史蒂文斯",
                    "text": "如果在雪山冒险时，发现了其他的书籍，还请你带到我这来。"
                },
                {
                    "id": "701210318",
                    "speaker": "史蒂文斯",
                    "text": "那个叫做厄伯哈特的人，到底去了哪呢…"
                }
            ]
        }
    ]
}