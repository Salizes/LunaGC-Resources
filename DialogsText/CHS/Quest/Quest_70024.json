    "talks": [
        {
            "id": "7002401",
            "objective": "前往冒险家协会",
            "dialogues": [
                {
                    "id": "700240101",
                    "speaker": "凯瑟琳",
                    "text": "旅行者，请您过来这边！"
                },
                {
                    "id": "700240102",
                    "speaker": "凯瑟琳",
                    "text": "抱歉占用您一些时间，请问您有兴趣接受一份新委托吗？",
                    "choices": [
                        {
                            "id": "700240103",
                            "text": "请讲无妨。",
                            "response": [
                                {
                                    "id": "700240105",
                                    "speaker": "凯瑟琳",
                                    "text": "是这样的。根据最近协会收到的报告，野外的丘丘人们又聚集了起来，侵扰商道。"
                                },
                                {
                                    "id": "700240106",
                                    "speaker": "凯瑟琳",
                                    "text": "为此我们也派出了不少冒险家…"
                                },
                                {
                                    "id": "700240107",
                                    "speaker": "凯瑟琳",
                                    "text": "但根据那些冒险家的说法，在集结起来的丘丘人里，他们总能发现一个奇怪的丘丘人…"
                                },
                                {
                                    "id": "700240108",
                                    "speaker": "凯瑟琳",
                                    "text": "我们猜测，那个奇怪的丘丘人，或许会和这次丘丘人骚乱有关…"
                                },
                                {
                                    "id": "700240114",
                                    "speaker": "凯瑟琳",
                                    "text": "所以，我们需要有人去捕获，或者至少驱赶那个奇怪的家伙。"
                                },
                                {
                                    "id": "700240109",
                                    "speaker": "凯瑟琳",
                                    "text": "旅行者，您有兴趣接受这份委托吗？",
                                    "choices": [
                                        {
                                            "id": "700240110",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "700240112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "谢谢您。我已经在您的地图上标注了几个地点！"
                                                },
                                                {
                                                    "id": "700240113",
                                                    "speaker": "凯瑟琳",
                                                    "text": "这些地方都有丘丘人出没，请您先从这些地方开始调查吧。"
                                                },
                                                {
                                                    "id": "700240115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "如果遇见了那个奇怪的丘丘人…请您务必小心。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240111",
                                            "text": "我会留意的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240104",
                            "text": "请问是什么委托？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002402",
            "objective": "前去野外调查",
            "dialogues": [
                {
                    "id": "700240201",
                    "speaker": "艾拉·马斯克",
                    "text": "呼…好险，幸好你们来了…",
                    "choices": [
                        {
                            "id": "700240202",
                            "text": "幸好我们来了…",
                            "response": [
                                {
                                    "id": "700240204",
                                    "speaker": "艾拉·马斯克",
                                    "text": "唉…"
                                },
                                {
                                    "id": "700240205",
                                    "speaker": "艾拉·马斯克",
                                    "text": "明明刚刚进展还很顺利的…究竟是哪句话说错了呢…"
                                },
                                {
                                    "id": "700240206",
                                    "speaker": "艾拉·马斯克",
                                    "text": "不管怎样…感谢你们及时搭救…"
                                },
                                {
                                    "id": "700240207",
                                    "speaker": "派蒙",
                                    "text": "她看上去很消沉呢。"
                                },
                                {
                                    "id": "700240208",
                                    "speaker": "艾拉·马斯克",
                                    "text": "毕竟刚刚发生的事你们也看到了。"
                                },
                                {
                                    "id": "700240223",
                                    "speaker": "艾拉·马斯克",
                                    "text": "自己跑出来和丘丘人沟通，果然还是风险太大了…"
                                },
                                {
                                    "id": "700240209",
                                    "speaker": "艾拉·马斯克",
                                    "text": "可是…与丘丘人正常交流的机会，就这样浪费的话还是很不甘心…",
                                    "choices": [
                                        {
                                            "id": "700240210",
                                            "text": "这样啊…",
                                            "response": [
                                                {
                                                    "id": "700240212",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "这样的话，词典的编纂工作又要继续拖延了…"
                                                },
                                                {
                                                    "id": "700240224",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "如果有人能替我验证书中内容的准确性就好了。"
                                                },
                                                {
                                                    "id": "700240213",
                                                    "speaker": "Player",
                                                    "text": "我可以帮忙。"
                                                },
                                                {
                                                    "id": "700240214",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "真、真的吗！太好了！那么请你们务必带上这本书！"
                                                },
                                                {
                                                    "id": "700240215",
                                                    "speaker": "派蒙",
                                                    "text": "哇啊…瞬间变成了使唤人的口气…"
                                                },
                                                {
                                                    "id": "700240216",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "如果在沟通中遇到什么困难，只需查阅词条就可以解决…至少理论是这样的。"
                                                },
                                                {
                                                    "id": "700240217",
                                                    "speaker": "Player",
                                                    "text": "理论…？"
                                                },
                                                {
                                                    "id": "700240218",
                                                    "speaker": "派蒙",
                                                    "text": "所以马斯克小姐自己也不知道自己写的是什么吗！"
                                                },
                                                {
                                                    "id": "700240219",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "外行才会提这样的问题！科学研究不导入现实中验证，怎么知道是否符合逻辑！"
                                                },
                                                {
                                                    "id": "700240225",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "哼…算了，反正再说下去你也未必听得懂。不管怎样，这次真的很感谢你们能来相救。"
                                                },
                                                {
                                                    "id": "700240220",
                                                    "speaker": "艾拉·马斯克",
                                                    "text": "接下来你们不介意的话，就让我和你们一同去与丘丘人交涉吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240211",
                                            "text": "有什么能帮上忙的吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240203",
                            "text": "你还好吗…？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002403",
            "objective": "解救艾拉·马斯克",
            "dialogues": []
        },
        {
            "id": "7002404",
            "objective": "与艾拉·马斯克对话",
            "dialogues": []
        },
        {
            "id": "7002499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700249901",
                    "speaker": "派蒙",
                    "text": "快看！那边有人被攻击了！"
                }
            ]
        }
    ]
}