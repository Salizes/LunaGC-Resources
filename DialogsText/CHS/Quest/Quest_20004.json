        }
    },
    "talks": [
        {
            "id": "2000401",
            "objective": "与歌德对话",
            "dialogues": [
                {
                    "id": "200040101",
                    "speaker": "歌德",
                    "text": "唉，看来我还是得自己跑一趟…"
                },
                {
                    "id": "200040102",
                    "speaker": "歌德",
                    "text": "我这把老骨头，非得散架不可…"
                },
                {
                    "id": "200040103",
                    "speaker": "Player",
                    "text": "有什么急事吗？"
                },
                {
                    "id": "200040104",
                    "speaker": "歌德",
                    "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…"
                },
                {
                    "id": "200040105",
                    "speaker": "歌德",
                    "text": "你也知道，那群愚人众把我的酒店给包下来了吧。"
                },
                {
                    "id": "200040106",
                    "speaker": "歌德",
                    "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。"
                },
                {
                    "id": "200040107",
                    "speaker": "歌德",
                    "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。"
                },
                {
                    "id": "200040108",
                    "speaker": "歌德",
                    "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。"
                },
                {
                    "id": "200040109",
                    "speaker": "歌德",
                    "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。"
                },
                {
                    "id": "200040110",
                    "speaker": "歌德",
                    "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…",
                    "choices": [
                        {
                            "id": "200040111",
                            "text": "我来帮您。",
                            "response": [
                                {
                                    "id": "200040113",
                                    "speaker": "歌德",
                                    "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…"
                                },
                                {
                                    "id": "200040114",
                                    "speaker": "歌德",
                                    "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
                                }
                            ]
                        },
                        {
                            "id": "200040112",
                            "text": "你先在这歇一会吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2000406",
            "objective": "将木材带给歌德",
            "dialogues": [
                {
                    "id": "200040601",
                    "speaker": "歌德",
                    "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
                }
            ]
        },
        {
            "id": "2000407",
            "objective": "与歌德对话",
            "dialogues": [
                {
                    "id": "200040701",
                    "speaker": "歌德",
                    "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…"
                },
                {
                    "id": "200040702",
                    "speaker": "歌德",
                    "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…"
                },
                {
                    "id": "200040703",
                    "speaker": "Player",
                    "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。"
                },
                {
                    "id": "200040704",
                    "speaker": "歌德",
                    "text": "对！就是这个名字，哎哟…我是真的记不住。"
                },
                {
                    "id": "200040705",
                    "speaker": "派蒙",
                    "text": "咦？莫娜还没交房租吗？"
                },
                {
                    "id": "200040706",
                    "speaker": "歌德",
                    "text": "可不是嘛，其他的租客都把房租交了，就剩她了。"
                },
                {
                    "id": "200040707",
                    "speaker": "歌德",
                    "text": "我跑了好几趟了，但她一直都不在家。"
                },
                {
                    "id": "200040708",
                    "speaker": "歌德",
                    "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
                }
            ]
        },
        {
            "id": "2000402",
            "objective": "拜访莫娜",
            "dialogues": []
        },
        {
            "id": "2000403",
            "objective": "与莫娜对话",
            "dialogues": [
                {
                    "id": "200040301",
                    "speaker": "莫娜",
                    "text": "是你啊，好久不见。"
                },
                {
                    "id": "200040302",
                    "speaker": "莫娜",
                    "text": "怎么一副急匆匆的样子，你找我有什么事吗？"
                },
                {
                    "id": "200040303",
                    "speaker": "派蒙",
                    "text": "莫娜，你这几天去哪里了呀？"
                },
                {
                    "id": "200040304",
                    "speaker": "Player",
                    "text": "找你好几天了。"
                },
                {
                    "id": "200040305",
                    "speaker": "莫娜",
                    "text": "那可真不巧…前几天《蒸汽鸟报》刚向我约了一份新稿件。"
                },
                {
                    "id": "200040306",
                    "speaker": "莫娜",
                    "text": "主题是「星相的运转变化和个人命运变迁的关系」。"
                },
                {
                    "id": "200040307",
                    "speaker": "莫娜",
                    "text": "为了写这篇稿件，我这几天基本上都在野外观测星象，很晚才回家。"
                },
                {
                    "id": "200040308",
                    "speaker": "派蒙",
                    "text": "为了赚钱，莫娜也真是努力呢…"
                },
                {
                    "id": "200040309",
                    "speaker": "莫娜",
                    "text": "毕竟枫丹廷那边的星象仪又推出了新版嘛，我都已经付了订货押金了。"
                },
                {
                    "id": "200040310",
                    "speaker": "莫娜",
                    "text": "等这篇稿件的稿酬到了，我就能结清尾款，正式拿到那台星象仪了。"
                },
                {
                    "id": "200040311",
                    "speaker": "Player",
                    "text": "你还有钱付歌德先生的房租吗…"
                },
                {
                    "id": "200040312",
                    "speaker": "莫娜",
                    "text": "房租？"
                },
                {
                    "id": "200040313",
                    "speaker": "莫娜",
                    "text": "喔…！我、我应该留了钱的…"
                },
                {
                    "id": "200040314",
                    "speaker": "莫娜",
                    "text": "你们等一会，我找找…"
                },
                {
                    "id": "200040315",
                    "speaker": "Black Screen",
                    "text": "（莫娜开始翻起了自己的钱包…）"
                },
                {
                    "id": "200040316",
                    "speaker": "莫娜",
                    "text": "这些…加上这些！应该够付房租了…"
                },
                {
                    "id": "200040317",
                    "speaker": "Player",
                    "text": "（莫娜是把身上的钱都掏光了吗…）"
                },
                {
                    "id": "200040318",
                    "speaker": "莫娜",
                    "text": "你们帮我把这些钱带给歌德先生吧。"
                }
            ]
        },
        {
            "id": "2000404",
            "objective": "将租金交给歌德",
            "dialogues": [
                {
                    "id": "200040401",
                    "speaker": "歌德",
                    "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？"
                },
                {
                    "id": "200040402",
                    "speaker": "Player",
                    "text": "这是租金。"
                },
                {
                    "id": "200040403",
                    "speaker": "歌德",
                    "text": "好，好，这些钱够了，谢谢你们啊。"
                },
                {
                    "id": "200040404",
                    "speaker": "歌德",
                    "text": "不过，你们的那位朋友究竟是做什么的？"
                },
                {
                    "id": "200040405",
                    "speaker": "歌德",
                    "text": "明明看着那么有本事，却总是这么穷…"
                }
            ]
        },
        {
            "id": "2000405",
            "objective": "回复莫娜",
            "dialogues": [
                {
                    "id": "200040501",
                    "speaker": "莫娜",
                    "text": "你们回来了，租金交给歌德了吗？"
                },
                {
                    "id": "200040502",
                    "speaker": "Player",
                    "text": "已经都交给他了。"
                },
                {
                    "id": "200040503",
                    "speaker": "莫娜",
                    "text": "那就好。幸好这间屋子的租金也不算太贵…勉强能把钱凑齐了。"
                },
                {
                    "id": "200040504",
                    "speaker": "莫娜",
                    "text": "不过，看来我又得多吃几天沙拉了…"
                }
            ]
        },
        {
            "id": "2000409",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200040901",
                    "speaker": "莫娜",
                    "text": "呜…没剩下多少钱吃饭了，还好昨天做了几份沙拉…"
                }
            ]
        },
        {
            "id": "2000410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200041001",
                    "speaker": "歌德",
                    "text": "阿斯…阿斯托洛…什么来着…"
                }
            ]
        },
        {
            "id": "2000411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200041101",
                    "speaker": "歌德",
                    "text": "租金也齐了，总算能休息一会了…"
                }
            ]
        }
    ]
}