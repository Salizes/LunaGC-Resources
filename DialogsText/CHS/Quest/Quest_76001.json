            "dialogues": [
                {
                    "id": "760010801",
                    "speaker": "苏霍维赫",
                    "text": "劳烦两位将遗物带去伦波岛东的战场遗址，带去他的墓前吧。愿他的灵魂得以安息的那一日尽早到来…"
                }
            ]
        },
        {
            "id": "7600199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760019901",
                    "speaker": "派蒙",
                    "text": "看起来是属于那个奇怪的人的东西…"
                },
                {
                    "id": "760019902",
                    "speaker": "派蒙",
                    "text": "这就是西格德的墓了吧，只有他一个在这里…"
                },
                {
                    "id": "760019903",
                    "speaker": "派蒙",
                    "text": "总之，我们先把这些装备交还给他吧。"
                }
