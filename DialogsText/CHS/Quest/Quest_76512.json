    },
    "talks": [
        {
            "id": "7651201",
            "objective": "与万叶对话",
            "dialogues": [
                {
                    "id": "765120101",
                    "speaker": "枫原万叶",
                    "text": "#比试进行到现在，{NICKNAME}应该已经心中有数了。"
                },
                {
                    "id": "765120102",
                    "speaker": "泽西切",
                    "text": "咳咳，让我回忆一下台词…"
                },
                {
                    "id": "765120103",
                    "speaker": "泽西切",
                    "text": "精妙绝伦的比赛总算落下了帷幕，现在，到了公布比赛结果的环节。"
                },
                {
                    "id": "765120104",
                    "speaker": "泽西切",
                    "text": "#有请我们的最终试炼者{NICKNAME}，选出你心目中的冠军。"
                },
                {
                    "id": "765120105",
                    "speaker": "派蒙",
                    "text": "#这次是由{NICKNAME}来决定冠军？喔…还真是头一回，{NICKNAME}成了最关键的评委！",
                    "choices": [
                        {
                            "id": "765120106",
                            "text": "我选帅狗狗「咕咕丸」。",
                            "response": [
                                {
                                    "id": "765120107",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，我也觉得「咕咕丸」最厉害，有着「太郎丸」的风范！"
                                },
                                {
                                    "id": "765120108",
                                    "speaker": "「咕咕丸」",
                                    "text": "呜嗷！嗷！"
                                },
                                {
                                    "id": "765120109",
                                    "speaker": "堇葵",
                                    "text": "太棒了，「咕咕丸」！你的努力开花结果，得到了最华丽的回应！"
                                },
                                {
                                    "id": "765120110",
                                    "speaker": "「缟玛瑙」",
                                    "text": "意料之中的结果，恭喜两位稻妻朋友。"
                                },
                                {
                                    "id": "765120111",
                                    "speaker": "「减七琶音」",
                                    "text": "飒爽的忍犬先生的确很强，我支持。"
                                },
                                {
                                    "id": "765120125",
                                    "speaker": "泽西切",
                                    "text": "虽说没有热闹的颁奖环节，但诸位注重实战，平日也低调行事。"
                                },
                                {
                                    "id": "765120126",
                                    "speaker": "泽西切",
                                    "text": "#来自{NICKNAME}的认可，是挪德卡莱最高一级的荣耀，远超普普通通的镀金奖杯与勋章。"
                                },
                                {
                                    "id": "765120127",
                                    "speaker": "派蒙",
                                    "text": "#哼哼~你们可能是全提瓦特头一回被{NICKNAME}这样颁奖的战士哦。"
                                },
                                {
                                    "id": "765120128",
                                    "speaker": "「缟玛瑙」",
                                    "text": "无需更多奖励点缀，我们已经尽兴了。"
                                },
                                {
                                    "id": "765120129",
                                    "speaker": "「缟玛瑙」",
                                    "text": "是吧，布达诺娃？"
                                },
                                {
                                    "id": "765120130",
                                    "speaker": "「减七琶音」",
                                    "text": "当然，下次不妨由我们役人部队出资，把比赛办得更热闹。"
                                },
                                {
                                    "id": "765120131",
                                    "speaker": "「减七琶音」",
                                    "text": "最好有着百人级别的初赛，这样，最后说不定会出现许多情报之外，且暂无归属的高人。"
                                },
                                {
                                    "id": "765120132",
                                    "speaker": "「缟玛瑙」",
                                    "text": "有道理。掷弹兵们也乐于赞助这种赛事，我会提前给瓦列里少校写好方案的。"
                                },
                                {
                                    "id": "765120133",
                                    "speaker": "堇葵",
                                    "text": "终末番也…呃…如果经费达到千万摩拉级，就不谈出钱的问题了，忍犬部队还会积极参与赛事的。"
                                },
                                {
                                    "id": "765120134",
                                    "speaker": "「咕咕丸」",
                                    "text": "呜…"
                                },
                                {
                                    "id": "765120135",
                                    "speaker": "枫原万叶",
                                    "text": "感谢各位的好意，我想，如果这类比拼有着个别强势的出资方，性质可能就变了。"
                                },
                                {
                                    "id": "765120136",
                                    "speaker": "枫原万叶",
                                    "text": "三位能否抵抗诱惑，不向名次靠前的强者抛出橄榄枝，招募那些自由之士？"
                                },
                                {
                                    "id": "765120137",
                                    "speaker": "派蒙",
                                    "text": "啊，万叶的意思难道是…"
                                },
                                {
                                    "id": "765120138",
                                    "speaker": "枫原万叶",
                                    "text": "正是因此，由相对中立的冒险家协会来承办，才是最佳的选择。",
                                    "choices": [
                                        {
                                            "id": "765120139",
                                            "text": "比赛的性质的确要纯粹。",
                                            "response": [
                                                {
                                                    "id": "765120141",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…我好像也明白了！那就由我派蒙来说难听的话——"
                                                },
                                                {
                                                    "id": "765120142",
                                                    "speaker": "派蒙",
                                                    "text": "虽然这次，两位愚人众的参赛选手都很礼貌，但你们有些同事特别凶，一见我们就直接开打。"
                                                },
                                                {
                                                    "id": "765120143",
                                                    "speaker": "派蒙",
                                                    "text": "要是愚人众来当比赛的股东，你们肯定会招募名次靠前的选手，那不就成了…我们帮你们物色高手，来揍我们自己了吗？"
                                                },
                                                {
                                                    "id": "765120144",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "哈哈，被看穿了…"
                                                },
                                                {
                                                    "id": "765120145",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "理解你们的说法，但我也不能替别人做承诺。"
                                                },
                                                {
                                                    "id": "765120146",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "不同的部队有不同的任务和做派，我这个小小的尉官的话，什么都不算。"
                                                },
                                                {
                                                    "id": "765120147",
                                                    "speaker": "「减七琶音」",
                                                    "text": "#枫原先生说得在理， {NICKNAME}和派蒙向导的担忧也很现实。"
                                                },
                                                {
                                                    "id": "765120148",
                                                    "speaker": "堇葵",
                                                    "text": "好了，你们两个就别打鬼主意了，只要像「咕咕丸」一样，享受纯粹的战斗就行！"
                                                },
                                                {
                                                    "id": "765120149",
                                                    "speaker": "「咕咕丸」",
                                                    "text": "嗷！呜嗷！"
                                                },
                                                {
                                                    "id": "765120150",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "说得也是，作为最基层的战士，没必要多想长官们才该操心的杂务，打得尽兴才是关键。"
                                                },
                                                {
                                                    "id": "765120151",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "下次再比拼时，我一定会拿出更强的技巧！"
                                                },
                                                {
                                                    "id": "765120152",
                                                    "speaker": "「减七琶音」",
                                                    "text": "而我…会为你们每位都带足蛋糕~"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765120140",
                                            "text": "确实不能加入其他目的哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765120112",
                            "text": "「缟玛瑙」的表现最突出。",
                            "response": [
                                {
                                    "id": "765120113",
                                    "speaker": "派蒙",
                                    "text": "个子高高，拿大剑的愚人众…确实很难对付呢…"
                                },
                                {
                                    "id": "765120114",
                                    "speaker": "「缟玛瑙」",
                                    "text": "我？感谢你的认可，这是对我最大的鼓舞。"
                                },
                                {
                                    "id": "765120115",
                                    "speaker": "「缟玛瑙」",
                                    "text": "#大家打得都不赖，可能我更走运，对上了{NICKNAME}的节奏。"
                                },
                                {
                                    "id": "765120116",
                                    "speaker": "「咕咕丸」",
                                    "text": "嗷！"
                                },
                                {
                                    "id": "765120117",
                                    "speaker": "堇葵",
                                    "text": "看到了吗，「咕咕丸」？要好好向「缟玛瑙」学习哦。"
                                },
                                {
                                    "id": "765120118",
                                    "speaker": "「减七琶音」",
                                    "text": "不愧是斯捷潘尼扬中尉，瓦列里少校也会为你骄傲的。"
                                }
                            ]
                        },
                        {
                            "id": "765120119",
                            "text": "我认为冠军是「减七琶音」",
                            "response": [
                                {
                                    "id": "765120120",
                                    "speaker": "派蒙",
                                    "text": "唔…说起来，和我们在枫丹较量过的礼帽愚人众，有一些就是这位小姐教导出来的？那确实厉害！"
                                },
                                {
                                    "id": "765120121",
                                    "speaker": "「减七琶音」",
                                    "text": "#啊呀，这可真是承蒙厚爱…以后得多为{NICKNAME}准备豪华甜点才行了。"
                                },
                                {
                                    "id": "765120122",
                                    "speaker": "「咕咕丸」",
                                    "text": "咕？"
                                },
                                {
                                    "id": "765120123",
                                    "speaker": "堇葵",
                                    "text": "如果你也想吃布达诺娃小姐的蛋糕，那可得加油变强哦。"
                                },
                                {
                                    "id": "765120124",
                                    "speaker": "「缟玛瑙」",
                                    "text": "哎呀，到底是役人部队的老教官，拼不过，拼不过。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}