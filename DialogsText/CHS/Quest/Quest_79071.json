    "talks": [
        {
            "id": "7907101",
            "objective": "与埃洛夫对话",
            "dialogues": [
                {
                    "id": "790710101",
                    "speaker": "埃洛夫",
                    "text": "#欢迎来到星轨王城，{NICKNAME}，派蒙小姐。"
                },
                {
                    "id": "790710102",
                    "speaker": "埃洛夫",
                    "text": "我已经从同僚那边听说过了你们的名字和事迹，二位的确是勇武之人。"
                },
                {
                    "id": "790710103",
                    "speaker": "埃洛夫",
                    "text": "如果我不是必须要负责守卫的训练事宜，也想着与二位切磋一番。"
                },
                {
                    "id": "790710104",
                    "speaker": "Player",
                    "text": "你是王城的守卫？"
                },
                {
                    "id": "790710105",
                    "speaker": "埃洛夫",
                    "text": "正是。我等奉城主大人之命，守卫星轨王城，维护其安宁和平。"
                },
                {
                    "id": "790710106",
                    "speaker": "埃洛夫",
                    "text": "而我的职责，则是锻炼守卫，使其武力配得上自己的职责。"
                },
                {
                    "id": "790710107",
                    "speaker": "Player",
                    "text": "所以，这后面的门就是训练场？"
                },
                {
                    "id": "790710108",
                    "speaker": "埃洛夫",
                    "text": "果然敏锐。这个入口通往一处秘境，前段时间我们方才改造完成。"
                },
                {
                    "id": "790710109",
                    "speaker": "埃洛夫",
                    "text": "在这个训练场中，受训者必须按照特定的节奏挥剑。战斗时，场地的照明环境也会不断变化。"
                },
                {
                    "id": "790710110",
                    "speaker": "Player",
                    "text": "好严格的训练…"
                },
                {
                    "id": "790710111",
                    "speaker": "派蒙",
                    "text": "听起来好复杂…战斗时还要按照特定的节奏吗？"
                },
                {
                    "id": "790710112",
                    "speaker": "埃洛夫",
                    "text": "这一环节，其实是来源于一篇名为《猫头鹰乐师》的故事。"
                },
                {
                    "id": "790710113",
                    "speaker": "埃洛夫",
                    "text": "前段时间，这篇故事在守卫之中颇为流行。不少人看得开心，就连训练也忘了参加，甚至还有人耽误了日常巡逻的时间。"
                },
                {
                    "id": "790710114",
                    "speaker": "埃洛夫",
                    "text": "既然大家都如此喜爱这本书，那我觉得，将这故事的元素加入训练之中，大家一定能更喜爱训练吧。"
                },
                {
                    "id": "790710115",
                    "speaker": "埃洛夫",
                    "text": "从结果上来说，训练效果的确显著。至少…没有人再因为个人原因耽误巡逻了。"
                },
                {
                    "id": "790710116",
                    "speaker": "埃洛夫",
                    "text": "呵呵…不知道二位对我们的训练有没有兴趣？"
                },
                {
                    "id": "790710117",
                    "speaker": "埃洛夫",
                    "text": "我想，以二位的勇武之能，训练场中的各类考验一定都不在话下。",
                    "choices": [
                        {
                            "id": "790710118",
                            "text": "想要试试看！",
                            "response": [
                                {
                                    "id": "790710119",
                                    "speaker": "埃洛夫",
                                    "text": "好，勇气可嘉，请您踏入秘境吧。"
                                }
                            ]
                        },
                        {
                            "id": "790710120",
                            "text": "还有别的事…",
                            "response": [
                                {
                                    "id": "790710121",
                                    "speaker": "埃洛夫",
                                    "text": "无妨。二位可以有空再来。我这段时间会一直守在这里。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}