            "dialogues": [
                {
                    "id": "220349901",
                    "speaker": "龙二",
                    "text": "这里果然待着不少盗宝团。"
                },
                {
                    "id": "220349902",
                    "speaker": "龙二",
                    "text": "上吧旅行者，我们稍微和他们…交流一下。"
                }
