    "talks": [
        {
            "id": "37101",
            "objective": "离开骑士团",
            "dialogues": [
                {
                    "id": "3710101",
                    "speaker": "派蒙",
                    "text": "刚才…有一件事你没说吧。"
                },
                {
                    "id": "3710102",
                    "speaker": "派蒙",
                    "text": "那时我们看到的东西，除了龙和结晶，明明还有一样…",
                    "choices": [
                        {
                            "id": "3710103",
                            "text": "我想自己先调查一下。",
                            "response": [
                                {
                                    "id": "3710105",
                                    "speaker": "派蒙",
                                    "text": "嗯，你果然还记得他，那个绿色的家伙！"
                                },
                                {
                                    "id": "3710106",
                                    "speaker": "派蒙",
                                    "text": "——就和楼下那个路人穿得一样绿呢。",
                                    "choices": [
                                        {
                                            "id": "3710107",
                                            "text": "真的是同一种色号呢，好巧啊。",
                                            "response": [
                                                {
                                                    "id": "3710108",
                                                    "speaker": "派蒙",
                                                    "text": "是吧？是吧？"
                                                },
                                                {
                                                    "id": "3710109",
                                                    "speaker": "派蒙",
                                                    "text": "不过…怎么总觉得那个人…越看越像…"
                                                },
                                                {
                                                    "id": "3710110",
                                                    "speaker": "派蒙",
                                                    "text": "同一个人——？！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3710111",
                                            "text": "那个…好像就是他本人啊…",
                                            "response": [
                                                {
                                                    "id": "3710112",
                                                    "speaker": "派蒙",
                                                    "text": "咿——？！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3710104",
                            "text": "我觉得他看上去不是坏人。"
                        }
                    ]
                }
            ]
        },
