    "talks": [
        {
            "id": "4134014",
            "objective": "",
            "dialogues": [
                {
                    "id": "413401401",
                    "speaker": "志华",
                    "text": "哎哟，我得再歇一会…"
                }
            ]
        },
        {
            "id": "4134001",
            "objective": "与阿桂对话",
            "dialogues": [
                {
                    "id": "413401101",
                    "speaker": "阿桂",
                    "text": "所以送药的事就只能拜托你帮忙了，旅行者。"
                },
                {
                    "id": "413401102",
                    "speaker": "Player",
                    "text": "我明白了。"
                },
                {
                    "id": "413401103",
                    "speaker": "阿桂",
                    "text": "谢谢你，这里是药，麻烦你们尽快送到观海和志华的手上吧。"
                }
            ]
        },
        {
            "id": "4134003",
            "objective": "给周围居民送药",
            "dialogues": [
                {
                    "id": "413400201",
                    "speaker": "志华",
                    "text": "是不是吃了什么不干净的东西…"
                },
                {
                    "id": "413400202",
                    "speaker": "Player",
                    "text": "关于阿桂的药…"
                },
                {
                    "id": "413400203",
                    "speaker": "志华",
                    "text": "哦！谢谢，这个就是我找阿桂开的胃药吧？我确实有些消化不良…这肚子难受得紧…"
                },
                {
                    "id": "413400204",
                    "speaker": "志华",
                    "text": "我其实就在市集里逛了一会，吃了一会，一不小心就吃多了…"
                },
                {
                    "id": "413400205",
                    "speaker": "Player",
                    "text": "你都吃了些什么…"
                },
                {
                    "id": "413400206",
                    "speaker": "志华",
                    "text": "唔…炒饭，鱼生，水果，好多好多虾，对了，还有很好喝的酒！",
                    "choices": [
                        {
                            "id": "413400207",
                            "text": "难怪会有胃病…",
                            "response": [
                                {
                                    "id": "413400209",
                                    "speaker": "志华",
                                    "text": "所以才需要吃药嘛。但是你想，要是过节都不能想吃什么就吃什么，日子过得是不是就太没意思了？"
                                },
                                {
                                    "id": "413400210",
                                    "speaker": "志华",
                                    "text": "总之，谢谢你们的药，我也趁这个机会，稍微歇一会儿吧。"
                                }
                            ]
                        },
                        {
                            "id": "413400208",
                            "text": "就算是过节也不能太放纵。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134004",
            "objective": "给周围居民送药",
            "dialogues": [
                {
                    "id": "413400301",
                    "speaker": "观海",
                    "text": "唔唔，哎哟…真难受…你、你有什么事吗？"
                },
                {
                    "id": "413400302",
                    "speaker": "Player",
                    "text": "关于阿桂的药…"
                },
                {
                    "id": "413400303",
                    "speaker": "观海",
                    "text": "哦哦，谢谢你们！是我订的…来得真及时。"
                },
                {
                    "id": "413400304",
                    "speaker": "观海",
                    "text": "哎呀，有药吃就好多了，我估计我是晚上吹海风引了风寒…"
                },
                {
                    "id": "413400305",
                    "speaker": "Player",
                    "text": "不是消化不良吗…"
                },
                {
                    "id": "413400306",
                    "speaker": "观海",
                    "text": "怎么可能？我的肠胃好得很，给你讲，我之前一顿饭能吃下三条烤鱼呢。"
                },
                {
                    "id": "413400307",
                    "speaker": "观海",
                    "text": "就算是现在，吃饭喝酒的时候，周围的朋友也没有谁是我的对手。"
                },
                {
                    "id": "413400308",
                    "speaker": "观海",
                    "text": "好了，不说了，我赶快吃药，接下来还有一场酒局呢。",
                    "choices": [
                        {
                            "id": "413400309",
                            "text": "总之要保重身体。",
                            "response": [
                                {
                                    "id": "413400311",
                                    "speaker": "观海",
                                    "text": "哈哈哈，没关系啦，又不是老头子。"
                                },
                                {
                                    "id": "413400312",
                                    "speaker": "观海",
                                    "text": "不过谢谢你的好意，我会注意的。"
                                }
                            ]
                        },
                        {
                            "id": "413400310",
                            "text": "身体垮掉再想修养就晚了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134005",
            "objective": "",
            "dialogues": [
                {
                    "id": "413400501",
                    "speaker": "阿桂",
                    "text": "你来了，霄灯已经做好了吗？"
                },
                {
                    "id": "413400502",
                    "speaker": "Player",
                    "text": "这是霄灯。"
                },
                {
                    "id": "413400503",
                    "speaker": "阿桂",
                    "text": "辛苦你了。"
                }
            ]
        },
        {
            "id": "4134006",
            "objective": "",
            "dialogues": [
                {
                    "id": "413400601",
                    "speaker": "阿桂",
                    "text": "这霄灯又规整又结实，呵呵，我的手艺可比这差远了。"
                },
                {
                    "id": "413400602",
                    "speaker": "阿桂",
                    "text": "那等到晚上，我们就去把这盏霄灯放起来吧，我知道一个不错的地方。"
                },
                {
                    "id": "413400603",
                    "speaker": "阿桂",
                    "text": "放灯之前的这段时间，我要好好想想，究竟许什么愿望…"
                }
            ]
        },
        {
            "id": "4134007",
            "objective": "向阿桂回报",
            "dialogues": [
                {
                    "id": "413400401",
                    "speaker": "阿桂",
                    "text": "辛苦你们了，药应该都送到了吧？",
                    "choices": [
                        {
                            "id": "413400402",
                            "text": "感觉他们还会接着犯病…",
                            "response": [
                                {
                                    "id": "413400404",
                                    "speaker": "阿桂",
                                    "text": "没办法，如果不注意生活习惯，肠胃病很难根治，只有再次生病的时候再对症下药。"
                                },
                                {
                                    "id": "413400405",
                                    "speaker": "阿桂",
                                    "text": "不过这下子，我也终于可以喘口气了…"
                                },
                                {
                                    "id": "413400406",
                                    "speaker": "Player",
                                    "text": "关于霄灯…"
                                },
                                {
                                    "id": "413400407",
                                    "speaker": "阿桂",
                                    "text": "放霄灯？我们…一般不会放啦，放霄灯是为了许愿的，「不卜庐」能许什么愿呢？"
                                },
                                {
                                    "id": "413400408",
                                    "speaker": "阿桂",
                                    "text": "别的商家都希望生意兴隆，但治病救人的药庐总不能期待这种事吧。",
                                    "choices": [
                                        {
                                            "id": "413400409",
                                            "text": "阿桂先生是善良的人。",
                                            "response": [
                                                {
                                                    "id": "413400411",
                                                    "speaker": "阿桂",
                                                    "text": "不过就我个人来说，我还是想放盏灯的，毕竟过节嘛…"
                                                },
                                                {
                                                    "id": "413400412",
                                                    "speaker": "阿桂",
                                                    "text": "但霄灯我做了几天了，因为太忙，现在也只开了个头。"
                                                },
                                                {
                                                    "id": "413400413",
                                                    "speaker": "阿桂",
                                                    "text": "趁现在短暂的休息时间，我也只能多编两下，等到霄灯做好，海灯节怕是都结束了。"
                                                },
                                                {
                                                    "id": "413400414",
                                                    "speaker": "Player",
                                                    "text": "我来帮忙。"
                                                },
                                                {
                                                    "id": "413400415",
                                                    "speaker": "阿桂",
                                                    "text": "真、真的吗？那就谢谢你了，感激不尽！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "413400410",
                                            "text": "阿桂先生很诚实啊。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "413400403",
                            "text": "感觉只能治一时…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134008",
            "objective": "帮阿桂制作霄灯",
            "dialogues": [
                {
                    "id": "413400801",
                    "speaker": "阿桂",
                    "text": "我的愿望，果然还是希望所有的璃月的居民，都能无病无灾。"
                },
                {
                    "id": "413400802",
                    "speaker": "Player",
                    "text": "那「不卜庐」的生意…"
                },
                {
                    "id": "413400803",
                    "speaker": "阿桂",
                    "text": "哈哈，所以说是我个人的愿望嘛。"
                },
                {
                    "id": "413400804",
                    "speaker": "阿桂",
                    "text": "我愿意为人抓药，是因为我不想看到有人因为病痛而受折磨。"
                },
                {
                    "id": "413400805",
                    "speaker": "阿桂",
                    "text": "老话说得好，「但愿世间人无病，何愁架上药生尘」。"
                },
                {
                    "id": "413400806",
                    "speaker": "阿桂",
                    "text": "哈哈，而且只要大家都健健康康的，我也不会那么忙了，应该也是件好事…"
                },
                {
                    "id": "413400807",
                    "speaker": "阿桂",
                    "text": "啊，糟了！我想起来，还有一家的药没有送到！"
                },
                {
                    "id": "413400808",
                    "speaker": "阿桂",
                    "text": "抱歉，我要先走了！祝你们海灯节快乐！"
                }
            ]
        },
        {
            "id": "4134009",
            "objective": "将霄灯带给阿桂",
            "dialogues": [
                {
                    "id": "413400901",
                    "speaker": "Player",
                    "text": "白术先生和七七呢？"
                },
                {
                    "id": "413400902",
                    "speaker": "阿桂",
                    "text": "七七出去采药了，现在还没有回来，可能因为记性不好，又在哪里迷路了吧…"
                },
                {
                    "id": "413400903",
                    "speaker": "阿桂",
                    "text": "至于白术先生，可能是在钻研医术，还是在做什么其他的事吧，总之也不是我应该过问的事。"
                }
            ]
        },
        {
            "id": "4134010",
            "objective": "向阿桂回报",
            "dialogues": []
        },
        {
            "id": "4134011",
            "objective": "等到第二天晚上（20点~24点）",
            "dialogues": []
        },
        {
            "id": "4134013",
            "objective": "前往约定地点寻找阿桂",
            "dialogues": [
                {
                    "id": "413400701",
                    "speaker": "阿桂",
                    "text": "你们来啦，愿望我已经写在霄灯上了。"
                },
                {
                    "id": "413400702",
                    "speaker": "阿桂",
                    "text": "现在时候也正好…我们马上放飞霄灯吧。"
                }
            ]
        },
        {
            "id": "4134012",
            "objective": "",
            "dialogues": [
                {
                    "id": "413401201",
                    "speaker": "阿桂",
                    "text": "唔…药还够不够啊…"
                }
            ]
        },
        {
            "id": "4134001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413400101",
                    "speaker": "阿桂",
                    "text": "不好意思，过节还要麻烦你，每年海灯节「不卜庐」的患者都会变多，实在是有点忙不过来。"
                },
                {
                    "id": "413400102",
                    "speaker": "Player",
                    "text": "为什么会这样…"
                },
                {
                    "id": "413400103",
                    "speaker": "阿桂",
                    "text": "海灯节的时候，大家都会放下工作陪伴家人，自然也少不了各种饭宴，香醇美酒，鸡鸭鱼肉…"
                },
                {
                    "id": "413400104",
                    "speaker": "阿桂",
                    "text": "这样一来，难免消化不良，或者闹出这样那样的病症…"
                },
                {
                    "id": "413400105",
                    "speaker": "阿桂",
                    "text": "虽然我总是劝人「切忌暴饮暴食」，但逢上了佳节良宵，这种劝告实在是没什么效用。"
                },
                {
                    "id": "413400106",
                    "speaker": "阿桂",
                    "text": "刚刚又有几家人联系我，让我去送治消化不良和胃病的药。可「不卜庐」的事也不能放下…"
                },
                {
                    "id": "413400107",
                    "speaker": "阿桂",
                    "text": "旅行者，如果你愿意的话，能帮忙去送几份药吗？"
                }
            ]
        },
        {
            "id": "4134010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413401001",
                    "speaker": "Player",
                    "text": "没有其他帮忙的人吗？"
                },
                {
                    "id": "413401002",
                    "speaker": "阿桂",
                    "text": "这个…现在店里暂时没人有空…"
                }
            ]
        },
        {
            "id": "4134013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413401301",
                    "speaker": "阿桂",
                    "text": "嗯…还有多少家要送药的来着…"
                }
            ]
        },
        {
            "id": "4134015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413401501",
                    "speaker": "观海",
                    "text": "哎呀，总算舒服了…等会吃点什么好呢…"
                }
            ]
        },
        {
            "id": "4134016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413401601",
                    "speaker": "阿桂",
                    "text": "到底许什么愿望好呢…"
                }
            ]
        }
    ]
}