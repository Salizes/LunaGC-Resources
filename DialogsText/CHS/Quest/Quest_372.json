    "talks": [
        {
            "id": "37201",
            "objective": "找到绿色的家伙",
            "dialogues": [
                {
                    "id": "3720101",
                    "speaker": "绿色的家伙",
                    "text": "啊，你们是…"
                },
                {
                    "id": "3720102",
                    "speaker": "绿色的家伙",
                    "text": "喔…呀！是那个时候，把特瓦林吓跑的人吧。"
                },
                {
                    "id": "3720103",
                    "speaker": "派蒙",
                    "text": "特瓦林？谁啊？",
                    "choices": [
                        {
                            "id": "3720104",
                            "text": "是风魔龙的真名。",
                            "response": [
                                {
                                    "id": "3720106",
                                    "speaker": "派蒙",
                                    "text": "唔…哦！我想起来了。可是一般人不都叫它「风魔龙」吗。"
                                },
                                {
                                    "id": "3720107",
                                    "speaker": "派蒙",
                                    "text": "为什么你要这样称呼它…难道你们很熟吗？"
                                },
                                {
                                    "id": "3720108",
                                    "speaker": "绿色的家伙",
                                    "text": "你猜~"
                                },
                                {
                                    "id": "3720109",
                                    "speaker": "派蒙",
                                    "text": "#喂，{NICKNAME}，我感觉这个人怪怪的…",
                                    "choices": [
                                        {
                                            "id": "3720110",
                                            "text": "你好，打扰了。",
                                            "response": [
                                                {
                                                    "id": "3720111",
                                                    "speaker": "绿色的家伙",
                                                    "text": "你好，一面之缘的异乡人。"
                                                },
                                                {
                                                    "id": "3720113",
                                                    "speaker": "温迪",
                                                    "text": "我是吟游诗人，温迪。"
                                                },
                                                {
                                                    "id": "3720114",
                                                    "speaker": "温迪",
                                                    "text": "准确地说，是连续三届「蒙德城最受喜爱吟游诗人」的蝉联冠军。"
                                                },
                                                {
                                                    "id": "3720115",
                                                    "speaker": "温迪",
                                                    "text": "你们找我有什么事吗？"
                                                },
                                                {
                                                    "id": "3720116",
                                                    "speaker": "派蒙",
                                                    "text": "既然你都认出我们了，那就不用多解释了吧？"
                                                },
                                                {
                                                    "id": "3720117",
                                                    "speaker": "派蒙",
                                                    "text": "当然是关于风魔龙的事。"
                                                },
                                                {
                                                    "id": "3720118",
                                                    "speaker": "温迪",
                                                    "text": "嗯~~？"
                                                },
                                                {
                                                    "id": "3720119",
                                                    "speaker": "派蒙",
                                                    "text": "喂！不用这样突然装失忆吧！"
                                                },
                                                {
                                                    "id": "3720120",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，可以把那个拿出来给他看看吗？"
                                                },
                                                {
                                                    "id": "3720121",
                                                    "speaker": "温迪",
                                                    "text": "喔！这是——"
                                                },
                                                {
                                                    "id": "3720122",
                                                    "speaker": "派蒙",
                                                    "text": "咦？结晶被净化了？什么时候的事情？",
                                                    "choices": [
                                                        {
                                                            "id": "3720123",
                                                            "text": "不知怎么就变成这样了。",
                                                            "response": [
                                                                {
                                                                    "id": "3720125",
                                                                    "speaker": "温迪",
                                                                    "text": "这是特瓦林它…"
                                                                },
                                                                {
                                                                    "id": "3720126",
                                                                    "speaker": "温迪",
                                                                    "text": "这是风魔龙因为痛苦流出的眼泪。"
                                                                },
                                                                {
                                                                    "id": "3720127",
                                                                    "speaker": "派蒙",
                                                                    "text": "眼…泪…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3720124",
                                                            "text": "上一次看还是充满杂质的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3720112",
                                            "text": "请问你是？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3720105",
                            "text": "你忘了吗？丽莎说的那些话…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37202",
            "objective": "聆听吟游诗人的弹奏",
            "dialogues": [
                {
                    "id": "3720201",
                    "speaker": "温迪",
                    "text": "它也曾经是一个温柔的孩子，现在却变得这样悲伤，充满愤怒…"
                },
                {
                    "id": "3720202",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "3720203",
                    "speaker": "温迪",
                    "text": "我这里也有一枚泪滴结晶。"
                },
                {
                    "id": "3720204",
                    "speaker": "温迪",
                    "text": "你能净化它吗？"
                },
                {
                    "id": "3720205",
                    "speaker": "Player",
                    "text": "……（点头）"
                }
            ]
        },
        {
            "id": "37203",
            "objective": "与神秘的诗人对话",
            "dialogues": []
        },
        {
            "id": "37205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3720501",
                    "speaker": "派蒙",
                    "text": "欸——"
                },
                {
                    "id": "3720502",
                    "speaker": "温迪",
                    "text": "你，真的拥有不可思议的力量…"
                },
                {
                    "id": "3720503",
                    "speaker": "温迪",
                    "text": "像你这样的人，注定要登上吟游诗人们传唱的诗篇。"
                },
                {
                    "id": "3720504",
                    "speaker": "温迪",
                    "text": "站在向阳处必能成就英雄，站在背阴处亦可引导灾祸…"
                },
                {
                    "id": "3720505",
                    "speaker": "温迪",
                    "text": "啊…但我现在没有时间为你谱写新曲。"
                },
                {
                    "id": "3720506",
                    "speaker": "温迪",
                    "text": "特瓦林就算不被讨伐，生命力也会飞速流逝…"
                },
                {
                    "id": "3720507",
                    "speaker": "温迪",
                    "text": "他会在愤怒中把自己燃尽…",
                    "choices": [
                        {
                            "id": "3720508",
                            "text": "我也同情特瓦林。",
                            "response": [
                                {
                                    "id": "3720509",
                                    "speaker": "温迪",
                                    "text": "谢谢你的心意，也谢谢你帮我净化泪滴结晶。"
                                },
                                {
                                    "id": "3720510",
                                    "speaker": "温迪",
                                    "text": "接下来就是我行动的时间了。"
                                },
                                {
                                    "id": "3720517",
                                    "speaker": "派蒙",
                                    "text": "嗯？你的计划是？"
                                },
                                {
                                    "id": "3720518",
                                    "speaker": "温迪",
                                    "text": "看到龙的泪滴，我想起了一位故人…"
                                },
                                {
                                    "id": "3720519",
                                    "speaker": "派蒙",
                                    "text": "故人？"
                                },
                                {
                                    "id": "3720520",
                                    "speaker": "温迪",
                                    "text": "嘿嘿，那我就先失陪了。"
                                },
                                {
                                    "id": "3720521",
                                    "speaker": "派蒙",
                                    "text": "喂，你要去哪里呀？"
                                },
                                {
                                    "id": "3720522",
                                    "speaker": "温迪",
                                    "text": "——去「蒙德英雄的象征」。再见啦。"
                                },
                                {
                                    "id": "3720523",
                                    "speaker": "派蒙",
                                    "text": "#唔…{NICKNAME}，你怎么看？"
                                },
                                {
                                    "id": "3720524",
                                    "speaker": "Player",
                                    "text": "是个奇怪的人，需要观察一下。"
                                },
                                {
                                    "id": "3720525",
                                    "speaker": "派蒙",
                                    "text": "对他来说，你也是奇怪的人呢。"
                                },
                                {
                                    "id": "3720526",
                                    "speaker": "Player",
                                    "text": "而且…"
                                },
                                {
                                    "id": "3720527",
                                    "speaker": "派蒙",
                                    "text": "而且？"
                                },
                                {
                                    "id": "3720528",
                                    "speaker": "Player",
                                    "text": "声音，有些熟悉…"
                                }
                            ]
                        },
                        {
                            "id": "3720511",
                            "text": "有什么我能帮忙的地方吗？",
                            "response": [
                                {
                                    "id": "3720512",
                                    "speaker": "温迪",
                                    "text": "净化泪滴结晶已经是帮忙了，我很感激。"
                                },
                                {
                                    "id": "3720513",
                                    "speaker": "温迪",
                                    "text": "但现在，我已经有了一个自己的计划。"
                                }
                            ]
                        },
                        {
                            "id": "3720514",
                            "text": "作为骑士，我劝你和龙一起自首。",
                            "response": [
                                {
                                    "id": "3720515",
                                    "speaker": "温迪",
                                    "text": "哇，不要这么绝情嘛。"
                                },
                                {
                                    "id": "3720516",
                                    "speaker": "温迪",
                                    "text": "自首就先不必了…我有另外的计划。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}