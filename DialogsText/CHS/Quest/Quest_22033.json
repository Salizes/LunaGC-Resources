{
    "quest": {
        "id": "22033",
        "title": "家乡之味",
        "description": "来自璃月的学者汤雯似乎饱受思乡之情的困扰…",
        "rewards": [
            {
                "itemId": 100092,
                "count": 10
            }
        ],
        "rewards_formatted": "稻米 x10",
        "chapter": {
            "icon": "",
