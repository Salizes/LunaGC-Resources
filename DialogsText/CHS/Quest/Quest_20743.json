            "objective": "与埃泽对话",
            "dialogues": [
                {
                    "id": "207432001",
                    "speaker": "埃泽",
                    "text": "您已经把商路清理完了吗？"
                },
                {
                    "id": "207432002",
                    "speaker": "Player",
                    "text": "已经清理完了。"
                },
                {
                    "id": "207432003",
                    "speaker": "埃泽",
                    "text": "太好了，这样酒庄的生意也能慢慢恢复了。"
                },
                {
                    "id": "207432004",
                    "speaker": "埃泽",
                    "text": "其实这件事，我应该先向迪卢克老爷报告的…"
                },
                {
                    "id": "207432005",
                    "speaker": "埃泽",
                    "text": "但是迪卢克老爷又不见了，我问遍了酒庄上下，没有一个人知道迪卢克老爷去哪了。"
                },
                {
                    "id": "207432006",
                    "speaker": "埃泽",
                    "text": "爱德琳还是说什么「迪卢克老爷去办自己的私事去了」，其余的一句也不肯说，一点也没有担心的样子。"
                },
                {
                    "id": "207432007",
                    "speaker": "埃泽",
                    "text": "唉，算了。等迪卢克老爷回来了，我一定要和他好好谈谈…"
                }
            ]
        },
        {
            "id": "2074307",
            "objective": "查看玩家是否询问细节$Hidden$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2074310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "207431001",
                    "speaker": "埃泽",
                    "text": "这酒庄的生意再这么停摆下去，我可怎么和迪卢克老爷交代…"
                },
                {
                    "id": "207431002",
                    "speaker": "埃泽",
                    "text": "旅行者，如果你看见迪卢克老爷了，能帮我给他说说吗？"
                },
                {
                    "id": "207431003",
                    "speaker": "埃泽",
                    "text": "他老这么不管酒庄的生意，也不是个事啊…"
                }
            ]
        }
    ]
