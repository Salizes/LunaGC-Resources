    "talks": [
        {
            "id": "7268402",
            "objective": "前往离岛",
            "dialogues": []
        },
        {
            "id": "7268403",
            "objective": "与天领奉行同心木村交谈",
            "dialogues": [
                {
                    "id": "726840301",
                    "speaker": "木村",
                    "text": "有什么需要帮忙的吗？"
                },
                {
                    "id": "726840302",
                    "speaker": "Player",
                    "text": "关于即将举办的祭典。"
                },
                {
                    "id": "726840303",
                    "speaker": "木村",
                    "text": "什么？祭典？最近没听说要举办祭典。"
                },
                {
                    "id": "726840304",
                    "speaker": "木村",
                    "text": "二位能说得更详细一些吗？比如名字之类的。"
                },
                {
                    "id": "726840305",
                    "speaker": "Player",
                    "text": "名字是荒泷极上…"
                },
                {
                    "id": "726840306",
                    "speaker": "木村",
                    "text": "荒泷极上？",
                    "choices": [
                        {
                            "id": "726840307",
                            "text": "荒泷极上盛世…",
                            "response": [
                                {
                                    "id": "726840309",
                                    "speaker": "派蒙",
                                    "text": "是荒泷派举办的荒泷极上盛世豪鼓大祭典！"
                                },
                                {
                                    "id": "726840310",
                                    "speaker": "木村",
                                    "text": "啊！是上次在容彩祭上捣乱的那个荒泷派吧？"
                                },
                                {
                                    "id": "726840311",
                                    "speaker": "木村",
                                    "text": "原来你们说的是那个三无活动…"
                                },
                                {
                                    "id": "726840312",
                                    "speaker": "派蒙",
                                    "text": "三无活动？不是不是，你搞错啦。是荒泷极上盛世豪鼓大祭典！"
                                },
                                {
                                    "id": "726840313",
                                    "speaker": "木村",
                                    "text": "好了，不用强调这个名字，我大概知道了，总之我来告诉你们吧。"
                                },
                                {
                                    "id": "726840314",
                                    "speaker": "木村",
                                    "text": "前几天我确实在这里看到了荒泷派的成员，他们在四处堆放一些毫无美感的东西。"
                                },
                                {
                                    "id": "726840315",
                                    "speaker": "木村",
                                    "text": "那个为首的家伙，还声称要在这里办一场超过容彩祭的大型祭典，应该就是你们说的那个。"
                                },
                                {
                                    "id": "726840316",
                                    "speaker": "木村",
                                    "text": "结果稍微查问了两句，发现他们既没有活动举办许可，也没有场地租用凭证，更不用说事先应该去奉行所准备好的报批记录了。"
                                },
                                {
                                    "id": "726840317",
                                    "speaker": "木村",
                                    "text": "这明显是板上钉钉的三无活动。按照规定，我们只好强制他们停止。"
                                },
                                {
                                    "id": "726840318",
                                    "speaker": "派蒙",
                                    "text": "欸？强制停止！难道他们已经被抓起来了？"
                                },
                                {
                                    "id": "726840319",
                                    "speaker": "木村",
                                    "text": "那倒没有，看在他们是没有经验，而且好歹准备了安全预案的份上。我们也只是对他们进行了简单的教育。"
                                },
                                {
                                    "id": "726840320",
                                    "speaker": "派蒙",
                                    "text": "安全预案，这帮家伙还是挺有安全意识的嘛..."
                                },
                                {
                                    "id": "726840321",
                                    "speaker": "木村",
                                    "text": "如果你们在找荒泷派，也许可以去甘金岛看看。"
                                },
                                {
                                    "id": "726840322",
                                    "speaker": "木村",
                                    "text": "甘金岛是社奉行给各种大小祭典常备的场地，初衷是为了培育各种来自民间的文化活动，手续和费用都是从简。"
                                },
                                {
                                    "id": "726840323",
                                    "speaker": "木村",
                                    "text": "我们把这个告知了荒泷派的那几位。"
                                },
                                {
                                    "id": "726840324",
                                    "speaker": "木村",
                                    "text": "如果他们仍然想要举办活动的话，那里是最合适的选择。"
                                },
                                {
                                    "id": "726840325",
                                    "speaker": "派蒙",
                                    "text": "#唔...{NICKNAME}，虽然已经感觉不太靠谱的样子…"
                                },
                                {
                                    "id": "726840326",
                                    "speaker": "派蒙",
                                    "text": "但是，来都来了...所以我们还是去甘金岛找找吧？"
                                }
                            ]
                        },
                        {
                            "id": "726840308",
                            "text": "荒泷极上盛世豪鼓…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268404",
            "objective": "前往甘金岛寻找荒泷派",
            "dialogues": [
                {
                    "id": "726840401",
                    "speaker": "木村",
                    "text": "两位还有什么问题吗？"
                },
                {
                    "id": "726840402",
                    "speaker": "木村",
                    "text": "如果想要找荒泷派，也许可以去甘金岛看看。"
                }
            ]
        },
        {
            "id": "7268405",
            "objective": "与社奉行代行博彦交谈",
            "dialogues": [
                {
                    "id": "726840501",
                    "speaker": "博彦",
                    "text": "二位有什么需要？"
                },
                {
                    "id": "726840502",
                    "speaker": "Player",
                    "text": "我们来找荒泷派。"
                },
                {
                    "id": "726840503",
                    "speaker": "博彦",
                    "text": "噢噢噢，我知道了，你们也是来参加那个荒泷极上什么什么大祭典的吧？"
                },
                {
                    "id": "726840504",
                    "speaker": "Player",
                    "text": "也是？"
                },
                {
                    "id": "726840505",
                    "speaker": "博彦",
                    "text": "嗯嗯，不久前，天领奉行的九条裟罗大人，还有长野原烟花店的宵宫小姐都来过。"
                },
                {
                    "id": "726840506",
                    "speaker": "博彦",
                    "text": "宵宫小姐是过来送烟花时，碰巧看见那伙人在张罗场地，可能是感兴趣吧，所以过去看了看。"
                },
                {
                    "id": "726840507",
                    "speaker": "博彦",
                    "text": "至于九条裟罗大人为什么过来，就不太清楚了。"
                },
                {
                    "id": "726840508",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，居然有人比我们先到了呢！嘿嘿嘿。"
                },
                {
                    "id": "726840509",
                    "speaker": "派蒙",
                    "text": "所以荒泷派他们现在在哪里呀？"
                },
                {
                    "id": "726840510",
                    "speaker": "博彦",
                    "text": "说来惭愧，因为最近岛上已经没有额外的空余场地了。"
                },
                {
                    "id": "726840511",
                    "speaker": "博彦",
                    "text": "我们只好把他们安排在了西北边的小滩涂上。"
                },
                {
                    "id": "726840512",
                    "speaker": "博彦",
                    "text": "如果他们能再早些申请，我可以为他们准备更好一些的位置。"
                },
                {
                    "id": "726840513",
                    "speaker": "博彦",
                    "text": "你们往西北边走一走应该就能看见。"
                }
            ]
        },
        {
            "id": "7268406",
            "objective": "前往甘金岛西北边的滩涂",
            "dialogues": [
                {
                    "id": "726840632",
                    "speaker": "Player",
                    "text": "祭典都有哪些内容？"
                },
                {
                    "id": "726840633",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈哈！内容丰富的很！"
                },
                {
                    "id": "726840634",
                    "speaker": "荒泷一斗",
                    "text": "看见那边的小山坡了吗？那是豪歌岭，你们可以站在上面，面对大海，自由歌唱。"
                },
                {
                    "id": "726840635",
                    "speaker": "荒泷一斗",
                    "text": "还有这团篝火，用来烤堇瓜绰绰有余。"
                },
                {
                    "id": "726840636",
                    "speaker": "荒泷一斗",
                    "text": "还有这堆箱子，不管是玩《七圣召唤》还是斗虫都不会感到拥挤。"
                },
                {
                    "id": "726840637",
                    "speaker": "派蒙",
                    "text": "听起来还真是「丰富」呢。"
                },
                {
                    "id": "726840638",
                    "speaker": "荒泷一斗",
                    "text": "当然，祭典的重头戏还是这个豪鼓祭演啦。来，你们看。"
                },
                {
                    "id": "726840639",
                    "speaker": "荒泷一斗",
                    "text": "偷偷告诉你们，这可是我从秘密渠道搞来的好东西，说是一位大阴阳师留下的宝具小鼓，本来要价800万摩拉！"
                },
                {
                    "id": "726840640",
                    "speaker": "荒泷一斗",
                    "text": "卖家说看我面目俊朗，与她有缘，于是给我打了个折，只要80万摩拉就卖给我了。"
                },
                {
                    "id": "726840641",
                    "speaker": "派蒙",
                    "text": "800万摩拉变成80万摩拉，怎么听也像是骗人的吧？"
                },
                {
                    "id": "726840642",
                    "speaker": "荒泷一斗",
                    "text": "当然！我怎么可能被这种低劣的手法骗到。"
                },
                {
                    "id": "726840643",
                    "speaker": "荒泷一斗",
                    "text": "我一眼就看出了这个小鼓的边缘有些破损，这是瑕疵品！还说什么与我有缘，可笑！"
                },
                {
                    "id": "726840644",
                    "speaker": "荒泷一斗",
                    "text": "于是本大爷又砍了她一刀，最后只要8万摩拉成交。哈哈哈哈哈！捡到大便宜了！"
                },
                {
                    "id": "726840645",
                    "speaker": "派蒙",
                    "text": "总觉得是人家捡到大便宜了…"
                },
                {
                    "id": "726840646",
                    "speaker": "派蒙",
                    "text": "话说回来，放牛的居然出得起8万摩拉，让人有点刮目相看啊。"
                },
                {
                    "id": "726840647",
                    "speaker": "荒泷一斗",
                    "text": "不过是8万摩拉而已，不要随便看轻本大爷啊！"
                },
                {
                    "id": "726840648",
                    "speaker": "元太",
                    "text": "我出了其中的2万..."
                },
                {
                    "id": "726840649",
                    "speaker": "阿守",
                    "text": "我也…"
                },
                {
                    "id": "726840650",
                    "speaker": "阿晃",
                    "text": "啊？老大，为什么我出的是3万？"
                },
                {
                    "id": "726840651",
                    "speaker": "派蒙",
                    "text": "2万加2万加3万等于…"
                },
                {
                    "id": "726840652",
                    "speaker": "派蒙",
                    "text": "好你个放牛的，居然自己不出一分钱，就从小弟那里搜刮了8万摩拉出来..."
                },
                {
                    "id": "726840653",
                    "speaker": "荒泷一斗",
                    "text": "咳咳，你是怎么算的，我我我也是出了最后1万摩拉的啊！"
                },
                {
                    "id": "726840665",
                    "speaker": "荒泷一斗",
                    "text": "好了，多的就不说了，看看时间，我也得回阿忍那里了。"
                },
                {
                    "id": "726840666",
                    "speaker": "荒泷一斗",
                    "text": "祭典才刚刚开始，我们还得再努力拉一些人过来才热闹！"
                },
                {
                    "id": "726840667",
                    "speaker": "荒泷一斗",
                    "text": "收好这个小鼓，如果准备好要开始豪鼓祭演，找元太就行。"
                },
                {
                    "id": "726840668",
                    "speaker": "荒泷一斗",
                    "text": "回见了！我的挚友！"
                }
            ]
        },
        {
            "id": "7268407",
            "objective": "在元太那里开始豪鼓祭演",
            "dialogues": [
                {
                    "id": "726840701",
                    "speaker": "元太",
                    "text": "我是荒泷豪鼓祭接引大使元太，准备好开始豪鼓祭演了吗？"
                },
                {
                    "id": "726840702",
                    "speaker": "元太",
                    "text": "哦对了，关于这个小鼓，之前老大有一点忘记交代了。"
                },
                {
                    "id": "726840703",
                    "speaker": "元太",
                    "text": "因为大家也不太懂乐器，所以您在开始之前，可以先调试一番。"
                },
                {
                    "id": "726840704",
                    "speaker": "元太",
                    "text": "这样可以让最后的音色更加准确动听。"
                },
                {
                    "id": "726840705",
                    "speaker": "元太",
                    "text": "来，请您试试吧。"
                }
            ]
        },
        {
            "id": "7268406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726840601",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈哈哈哈哈！我的挚友啊！你终于到了！"
                },
                {
                    "id": "726840602",
                    "speaker": "荒泷一斗",
                    "text": "刚刚还在想，什么时候才能见到你，果然你就到了，真是让本大爷高兴啊。"
                },
                {
                    "id": "726840603",
                    "speaker": "荒泷一斗",
                    "text": "看看本大爷这场子，怎么样？是不是上佳的选择？"
                },
                {
                    "id": "726840604",
                    "speaker": "阿守",
                    "text": "三面环海，空气清新，远离城市喧嚣，坐拥绝版景观资源。"
                },
                {
                    "id": "726840605",
                    "speaker": "阿晃",
                    "text": "背靠甘金岛，独享祭典文化中心的顶级配套。"
                },
                {
                    "id": "726840606",
                    "speaker": "元太",
                    "text": "水陆交通发达，无论是步行或是坐船都能便捷抵达。",
                    "choices": [
                        {
                            "id": "726840607",
                            "text": "确实，场子很不错。",
                            "response": [
                                {
                                    "id": "726840609",
                                    "speaker": "荒泷一斗",
                                    "text": "当初看到这个场子的瞬间，本大爷就决定，就是它了！"
                                },
                                {
                                    "id": "726840610",
                                    "speaker": "荒泷一斗",
                                    "text": "那一刻，世界大有不同。"
                                },
                                {
                                    "id": "726840611",
                                    "speaker": "荒泷派成员",
                                    "text": "老大英明！！！"
                                },
                                {
                                    "id": "726840612",
                                    "speaker": "派蒙",
                                    "text": "明明是被天领奉行的人赶过来的吧。"
                                },
                                {
                                    "id": "726840613",
                                    "speaker": "荒泷一斗",
                                    "text": "咳咳…我们还是先说正事吧。"
                                },
                                {
                                    "id": "726840614",
                                    "speaker": "荒泷一斗",
                                    "text": "这次请你们过来，是想请你们参加我荒泷极上盛世豪鼓大祭典！这个祭典意义重大。"
                                },
                                {
                                    "id": "726840615",
                                    "speaker": "元太",
                                    "text": "老大说，一来是为了宣传我荒泷派的名头，方便未来招新。"
                                },
                                {
                                    "id": "726840616",
                                    "speaker": "阿守",
                                    "text": "二来是为了忍姐毕业庆功！"
                                },
                                {
                                    "id": "726840617",
                                    "speaker": "阿晃",
                                    "text": "最后还能补上前几次因为欠缺经费而延期的团建。"
                                },
                                {
                                    "id": "726840618",
                                    "speaker": "派蒙",
                                    "text": "还真是一典多用呢。"
                                },
                                {
                                    "id": "726840619",
                                    "speaker": "荒泷一斗",
                                    "text": "阿晃...最后一条不必再提。"
                                },
                                {
                                    "id": "726840620",
                                    "speaker": "Player",
                                    "text": "怎么没有看见阿忍？"
                                },
                                {
                                    "id": "726840621",
                                    "speaker": "荒泷一斗",
                                    "text": "祭典这种事，多多宣传才有更多的人来参加，所以阿忍去发传单了。"
                                },
                                {
                                    "id": "726840622",
                                    "speaker": "派蒙",
                                    "text": "喂！明明阿忍是主角吧？"
                                },
                                {
                                    "id": "726840623",
                                    "speaker": "派蒙",
                                    "text": "居然她在外面干活，你们在这里游手好闲。"
                                },
                                {
                                    "id": "726840624",
                                    "speaker": "荒泷一斗",
                                    "text": "本大爷也有在认真…认真在这里接待你们啊！"
                                },
                                {
                                    "id": "726840625",
                                    "speaker": "元太",
                                    "text": "老大其实是刚刚回来啦。"
                                },
                                {
                                    "id": "726840626",
                                    "speaker": "阿守",
                                    "text": "说是估算着你们可能要到了，才特地回来迎接的。"
                                },
                                {
                                    "id": "726840627",
                                    "speaker": "阿晃",
                                    "text": "本来他和忍姐一起，也在外面努力拉人参加祭典呢。"
                                },
                                {
                                    "id": "726840628",
                                    "speaker": "荒泷一斗",
                                    "text": "不用夸我，不用夸我。"
                                },
                                {
                                    "id": "726840629",
                                    "speaker": "派蒙",
                                    "text": "哟，放牛的居然也在认真做事了。难得的靠谱了起来。"
                                },
                                {
                                    "id": "726840630",
                                    "speaker": "荒泷一斗",
                                    "text": "哼，不跟你这飞行矮堇瓜一般见识！"
                                },
                                {
                                    "id": "726840631",
                                    "speaker": "荒泷一斗",
                                    "text": "话说回来，我的挚友啊，关于这次祭典，你还有什么疑问吗？"
                                }
                            ]
                        },
                        {
                            "id": "726840608",
                            "text": "确实，你们很乐观。"
                        }
                    ]
                },
                {
                    "id": "726840654",
                    "speaker": "Player",
                    "text": "听说九条裟罗也来了？"
                },
                {
                    "id": "726840655",
                    "speaker": "荒泷一斗",
                    "text": "哦，你说那个臭天狗啊。"
                },
                {
                    "id": "726840656",
                    "speaker": "荒泷一斗",
                    "text": "我也勉强给她送了一封邀请函啦。"
                },
                {
                    "id": "726840657",
                    "speaker": "荒泷一斗",
                    "text": "不过这家伙居然不领情，还特地过来竖了一块告示板，留下了一些扯淡的话，美其名曰是对游客的警示。"
                },
                {
                    "id": "726840658",
                    "speaker": "荒泷一斗",
                    "text": "还警告我们不许涂改，这样针对我荒泷派，实在可恶…"
                },
                {
                    "id": "726840659",
                    "speaker": "荒泷一斗",
                    "text": "总有一天我要在大街上堂堂正正地击败这个臭天狗！好好惩罚她一下！"
                },
                {
                    "id": "726840660",
                    "speaker": "Player",
                    "text": "听说宵宫也来了？"
                },
                {
                    "id": "726840661",
                    "speaker": "荒泷一斗",
                    "text": "那位长野原烟花店的老板吗？"
                },
                {
                    "id": "726840662",
                    "speaker": "荒泷一斗",
                    "text": "真是一位热情健谈的女士啊，她是来甘金岛送货的路上，巧合才知道我们的祭典。"
                },
                {
                    "id": "726840663",
                    "speaker": "荒泷一斗",
                    "text": "她很喜欢我们的祭典，过来祝福了一番，还说下次会提前给我们准备烟花呢。"
                },
                {
                    "id": "726840664",
                    "speaker": "荒泷一斗",
                    "text": "看来以后我荒泷派，应该也要和长野原烟花店多多走动。"
                }
            ]
        },
        {
            "id": "7268471",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726847101",
                    "speaker": "阿晃",
                    "text": "我是荒泷豪鼓祭反馈大使阿晃，您有什么要反馈的吗？",
                    "choices": [
                        {
                            "id": "726847102",
                            "text": "我觉得还不错。",
                            "response": [
                                {
                                    "id": "726847105",
                                    "speaker": "阿晃",
                                    "text": "好的，您的反馈我收到了。"
                                },
                                {
                                    "id": "726847106",
                                    "speaker": "阿晃",
                                    "text": "欸？您问别的？我没有别的话要说了。"
                                },
                                {
                                    "id": "726847107",
                                    "speaker": "阿晃",
                                    "text": "啊…老大的意思是，我的工作只要说，「您有什么要反馈的吗？」，「您的反馈我们收到了」这两句话就可以了。"
                                },
                                {
                                    "id": "726847108",
                                    "speaker": "阿晃",
                                    "text": "如果客人还要追问什么时候反馈才有消息，那就再加一句，「请您耐心等待」。"
                                },
                                {
                                    "id": "726847109",
                                    "speaker": "阿晃",
                                    "text": "他说他在其他地方参加的活动都是这样的，想必是借鉴了一下优秀的经验吧？"
                                },
                                {
                                    "id": "726847110",
                                    "speaker": "阿晃",
                                    "text": "不过后来忍姐说这样实在太敷衍了啦，所以又给我准备了一个小本子。"
                                },
                                {
                                    "id": "726847111",
                                    "speaker": "阿晃",
                                    "text": "瞧，您的意见我已经记下来了，等忍姐回来了再给她看看。"
                                }
                            ]
                        },
                        {
                            "id": "726847103",
                            "text": "我觉得一般般。"
                        },
                        {
                            "id": "726847104",
                            "text": "我觉得不太行。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268472",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726847201",
                    "speaker": "阿守",
                    "text": "我是荒泷豪鼓祭氛围大使阿守，您有什么需要吗？"
                },
                {
                    "id": "726847202",
                    "speaker": "阿守",
                    "text": "您问我的工作？"
                },
                {
                    "id": "726847203",
                    "speaker": "阿守",
                    "text": "啊，氛围大使嘛，主要就是营造火热的氛围，让参加祭典的人们产生「我快要嗨到不行了」的感觉。"
                },
                {
                    "id": "726847204",
                    "speaker": "阿守",
                    "text": "您有那种感觉吗？",
                    "choices": [
                        {
                            "id": "726847205",
                            "text": "完全没有。",
                            "response": [
                                {
                                    "id": "726847207",
                                    "speaker": "阿守",
                                    "text": "请…请不要说这种话啊！"
                                },
                                {
                                    "id": "726847208",
                                    "speaker": "阿守",
                                    "text": "不要这样冷漠地打击我的积极性啊！这样我的工作不就失去了意义吗？"
                                },
                                {
                                    "id": "726847209",
                                    "speaker": "阿守",
                                    "text": "您是老大的挚友，请代替老大给我一些支持吧。拜托了，对我说那句话吧！"
                                },
                                {
                                    "id": "726847210",
                                    "speaker": "Player",
                                    "text": "哪句话？"
                                },
                                {
                                    "id": "726847211",
                                    "speaker": "阿守",
                                    "text": "「我快要嗨到不行了」那句话。",
                                    "choices": [
                                        {
                                            "id": "726847212",
                                            "text": "我快要嗨到不行了。",
                                            "response": [
                                                {
                                                    "id": "726847213",
                                                    "speaker": "阿守",
                                                    "text": "太棒了！太棒了！"
                                                },
                                                {
                                                    "id": "726847214",
                                                    "speaker": "阿守",
                                                    "text": "这是对我最好的认可！"
                                                },
                                                {
                                                    "id": "726847218",
                                                    "speaker": "阿守",
                                                    "text": "来吧，朋友们！接着奏乐！接着舞！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726847215",
                                            "text": "我快要…我快要…抱歉我说不出口。",
                                            "response": [
                                                {
                                                    "id": "726847216",
                                                    "speaker": "阿守",
                                                    "text": "唔…好吧。就算您这样说，但看着荒泷派的大家都在努力做好自己的工作，所以就算这样我也不能松懈…"
                                                },
                                                {
                                                    "id": "726847217",
                                                    "speaker": "阿守",
                                                    "text": "无论遭受什么打击也不放弃，这是老大的教导！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726847206",
                            "text": "根本不会有。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726849906",
                    "speaker": "派蒙",
                    "text": "还是和刚刚一样，没有看见荒泷派的人呢。"
                },
                {
                    "id": "726849907",
                    "speaker": "派蒙",
                    "text": "这里应该有社奉行的代行在管理，我们去问问他吧。"
                }
            ]
        }
    ]
}