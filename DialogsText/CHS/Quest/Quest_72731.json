    "talks": [
        {
            "id": "7273103",
            "objective": "返回「斗虫大试合」的场地",
            "dialogues": []
        },
        {
            "id": "7273101",
            "objective": "与荒泷一斗对话",
            "dialogues": [
                {
                    "id": "727310701",
                    "speaker": "「花角玉将」",
                    "text": "原来如此，原来如此啊…再打一场吧，我一定能看透你斗虫的门道。"
                },
                {
                    "id": "727310702",
                    "speaker": "「花角玉将」",
                    "text": "比试的胜负似乎已经没那么重要了，我们就斗个爽快，如何？"
                },
                {
                    "id": "727310703",
                    "speaker": "「花角玉将」",
                    "text": "难得有这么合拍的对手，短短几分钟就结束，未免也太不尽兴了？"
                },
                {
                    "id": "727310704",
                    "speaker": "荒泷一斗",
                    "text": "哈！来就来！"
                },
                {
                    "id": "727310705",
                    "speaker": "荒泷一斗",
                    "text": "不过…看穿本大爷斗虫的秘技？你可别痴心妄想啊！"
                },
                {
                    "id": "727310706",
                    "speaker": "荒泷一斗",
                    "text": "如果你肯承认，是我斗虫的本领更强，无论斗多少场，我都会奉陪到底！"
                },
                {
                    "id": "727310707",
                    "speaker": "派蒙",
                    "text": "唔，放牛的和「花角玉将」还是热血沸腾呢，就让他们继续斗虫吧，斗到他们完全满足！"
                }
            ]
        },
        {
            "id": "7273104",
            "objective": "等待至第二天",
            "dialogues": []
        },
        {
            "id": "7273102",
            "objective": "与荒泷一斗对话",
            "dialogues": [
                {
                    "id": "727310201",
                    "speaker": "「花角玉将」",
                    "text": "哈哈哈哈哈哈哈…"
                },
                {
                    "id": "727310202",
                    "speaker": "「花角玉将」",
                    "text": "尽兴！"
                },
                {
                    "id": "727310203",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈哈哈哈哈…"
                },
                {
                    "id": "727310204",
                    "speaker": "荒泷一斗",
                    "text": "痛快！"
                },
                {
                    "id": "727310205",
                    "speaker": "「花角玉将」",
                    "text": "尽管斗虫的风格与我不同，但你倾注在鬼兜虫身上的一腔热血，让我找到了强烈的共鸣。"
                },
                {
                    "id": "727310206",
                    "speaker": "「花角玉将」",
                    "text": "假以时日，你必定能成为斗虫界的佼佼者。"
                },
                {
                    "id": "727310207",
                    "speaker": "荒泷一斗",
                    "text": "你也不赖！整整一千一百四十一场较量，居然能勉强战胜本大爷五百七十场。"
                },
                {
                    "id": "727310208",
                    "speaker": "荒泷一斗",
                    "text": "和本大爷拉锯百场以上的对手里，你最有毅力，不得不说，你让本大爷刮目相看了！"
                },
                {
                    "id": "727310209",
                    "speaker": "「花角玉将」",
                    "text": "是五百七十一场，我赢的次数更多哦。考虑到客场作战的因素，本来应该是我占上风。"
                },
                {
                    "id": "727310210",
                    "speaker": "荒泷一斗",
                    "text": "嘿？怎么了你？这种时候还嘴硬？本大爷记得清清楚楚，阿守也可以作证！"
                },
                {
                    "id": "727310211",
                    "speaker": "荒泷一斗",
                    "text": "你说是吧，阿守？"
                },
                {
                    "id": "727310212",
                    "speaker": "阿守",
                    "text": "老大…我，我实在撑不住了…让我睡一会儿吧。"
                },
                {
                    "id": "727310213",
                    "speaker": "派蒙",
                    "text": "呜哇，难道这段时间，他们一直在这里斗虫，完全没有休息吗？"
                },
                {
                    "id": "727310214",
                    "speaker": "派蒙",
                    "text": "他们一直在这里斗虫，完全没有休息吗？",
                    "choices": [
                        {
                            "id": "727310215",
                            "text": "擂台都快被震裂了吧…",
                            "response": [
                                {
                                    "id": "727310217",
                                    "speaker": "荒泷一斗",
                                    "text": "行！本大爷宽宏大量，让你一局也无所谓，反正接下来，本大爷还会赢回来的！"
                                },
                                {
                                    "id": "727310218",
                                    "speaker": "荒泷一斗",
                                    "text": "看你不服气的样子，之后的较量，就去你的主场吧。本大爷要让你明白，场地没什么影响，关键还是斗虫的人！"
                                },
                                {
                                    "id": "727310219",
                                    "speaker": "「花角玉将」",
                                    "text": "正合我意，且随我来。"
                                },
                                {
                                    "id": "727310220",
                                    "speaker": "荒泷一斗",
                                    "text": "嗯？我的挚友和飞行矮堇瓜，你们可算来了！"
                                },
                                {
                                    "id": "727310221",
                                    "speaker": "派蒙",
                                    "text": "怎么又变回飞行矮堇瓜了，难道我不帮你斗虫的时候，你就只能想起难听的外号吗？"
                                },
                                {
                                    "id": "727310222",
                                    "speaker": "荒泷一斗",
                                    "text": "这个先放一边！说好要给你们的两月份免费拉面优惠券，拿着吧！"
                                },
                                {
                                    "id": "727310223",
                                    "speaker": "派蒙",
                                    "text": "拉面优惠券？对哦，拉面！"
                                },
                                {
                                    "id": "727310224",
                                    "speaker": "派蒙",
                                    "text": "这样才像话嘛，还算你识相！",
                                    "choices": [
                                        {
                                            "id": "727310225",
                                            "text": "撒花庆祝！",
                                            "response": [
                                                {
                                                    "id": "727310227",
                                                    "speaker": "荒泷一斗",
                                                    "text": "不对不对，这次只算是「荒泷极意堂堂斗虫大试合」的预演！"
                                                },
                                                {
                                                    "id": "727310228",
                                                    "speaker": "荒泷一斗",
                                                    "text": "毕竟完全没有任何观众，未免也太冷清了，不能就这样草草了事！"
                                                },
                                                {
                                                    "id": "727310229",
                                                    "speaker": "荒泷一斗",
                                                    "text": "走运的是，「花角玉将」总算放下了他的架子，承认本大爷是难得一遇的斗虫强者！"
                                                },
                                                {
                                                    "id": "727310230",
                                                    "speaker": "荒泷一斗",
                                                    "text": "我们的较量还没结束，之后，本大爷要孤军深入「花角玉将」的阵地，打他个心服口服！"
                                                },
                                                {
                                                    "id": "727310231",
                                                    "speaker": "荒泷一斗",
                                                    "text": "到时候，「花角玉将」也会听候本大爷的调遣，一起把「荒泷极意堂堂斗虫大试合」办得红红火火！"
                                                },
                                                {
                                                    "id": "727310232",
                                                    "speaker": "荒泷一斗",
                                                    "text": "这次就多谢你们了，等着本大爷的捷报吧！"
                                                },
                                                {
                                                    "id": "727310233",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，这回放牛的可算是玩了个爽快，我们也赚到了整整两个月的拉面！",
                                                    "choices": [
                                                        {
                                                            "id": "727310234",
                                                            "text": "全员大丰收！",
                                                            "response": [
                                                                {
                                                                    "id": "727310236",
                                                                    "speaker": "阿晃",
                                                                    "text": "老大，老大！忍姐来信了，你快看看…"
                                                                },
                                                                {
                                                                    "id": "727310237",
                                                                    "speaker": "阿晃",
                                                                    "text": "咦？老大跑哪儿去了？之前明明一直在这儿斗虫的啊？"
                                                                },
                                                                {
                                                                    "id": "727310238",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？有什么要紧的事吗？放牛的刚刚才跟着「花角玉将」走了，说是要继续去切磋…"
                                                                },
                                                                {
                                                                    "id": "727310239",
                                                                    "speaker": "阿晃",
                                                                    "text": "倒也不是什么要紧的事，就是有点意外…"
                                                                },
                                                                {
                                                                    "id": "727310240",
                                                                    "speaker": "阿晃",
                                                                    "text": "具体的内容，请你们看一下信吧。"
                                                                },
                                                                {
                                                                    "id": "727310241",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃啊，结果到头来，「花角玉将」也算是荒泷派的自己人吗？只不过「花角玉将」根本不好好说话，搞得放牛的如临大敌…"
                                                                },
                                                                {
                                                                    "id": "727310242",
                                                                    "speaker": "派蒙",
                                                                    "text": "和阿忍的预料一样，放牛的确实在废寝忘食地斗虫。"
                                                                },
                                                                {
                                                                    "id": "727310243",
                                                                    "speaker": "派蒙",
                                                                    "text": "不过找了我们来举办「荒泷极意堂堂斗虫大试合」…"
                                                                },
                                                                {
                                                                    "id": "727310244",
                                                                    "speaker": "Player",
                                                                    "text": "倒也算不上消停…"
                                                                },
                                                                {
                                                                    "id": "727310245",
                                                                    "speaker": "派蒙",
                                                                    "text": "这样看来，拉面的优惠券，更应该奖励给阿忍才对嘛！等到阿忍回来了，我们一起去吃吧！"
                                                                },
                                                                {
                                                                    "id": "727310246",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？等等…"
                                                                },
                                                                {
                                                                    "id": "727310247",
                                                                    "speaker": "派蒙",
                                                                    "text": "说起来，放牛的根本还没有告诉我们，这张优惠券究竟能被用在哪家拉面店呢..."
                                                                },
                                                                {
                                                                    "id": "727310248",
                                                                    "speaker": "派蒙",
                                                                    "text": "难不成，还得我们自己去找吗！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "727310235",
                                                            "text": "好啦，其实开心更重要…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727310226",
                                            "text": "「斗虫大试合」完满结束！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727310216",
                            "text": "鬼兜虫都要累趴了吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7273199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "727319902",
                    "speaker": "派蒙",
                    "text": "上次打败「花角玉将」后，放牛的好像说过，还要和他继续切磋几场来着？"
                }
            ]
        }
    ]
}