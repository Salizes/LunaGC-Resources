    "talks": [
        {
            "id": "7514917",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "751490902",
                    "speaker": "派蒙",
                    "text": "受龙所选者…啊，受龙所选者啊…"
                },
                {
                    "id": "751490903",
                    "speaker": "派蒙",
                    "text": "穿越亘古之城，前往圣山之心吧。"
                },
                {
                    "id": "751490904",
                    "speaker": "派蒙",
                    "text": "除却…阴影之大敌，点燃…将熄的冷灰…"
                },
                {
                    "id": "751490905",
                    "speaker": "派蒙",
                    "text": "咳咳…怎么、怎么样？你们有没有事。"
                },
                {
                    "id": "751490906",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "751490907",
                    "speaker": "派蒙",
                    "text": "怎么了，是头有点晕吗？毕竟从那么高的地方掉下来…"
                },
                {
                    "id": "751490908",
                    "speaker": "派蒙",
                    "text": "没有受伤吧？"
                },
                {
                    "id": "751490909",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "751490910",
                    "speaker": "派蒙",
                    "text": "#唔，看来没有受伤，{NICKNAME}你呢…没出什么问题吧！",
                    "choices": [
                        {
                            "id": "751490911",
                            "text": "看上去还挺完整的…",
                            "response": [
                                {
                                    "id": "751490912",
                                    "speaker": "派蒙",
                                    "text": "真是的，什么叫「看上去还挺完整」啦！唉…没有受伤就好。"
                                },
                                {
                                    "id": "751490915",
                                    "speaker": "派蒙",
                                    "text": "唔，没想到火山口下面真的有这么大的空间，不过周围怎么黑漆漆的…",
                                    "choices": [
                                        {
                                            "id": "751490916",
                                            "text": "发点光，派蒙！",
                                            "response": [
                                                {
                                                    "id": "751490917",
                                                    "speaker": "派蒙",
                                                    "text": "好哦，我努力发点…要是能发出来才奇怪！在这种什么都没有的地方，能发的只有火！"
                                                },
                                                {
                                                    "id": "751490920",
                                                    "speaker": "派蒙",
                                                    "text": "还是先稍微探索下周围吧…"
                                                },
                                                {
                                                    "id": "751490921",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751490918",
                                            "text": "火把，派蒙。",
                                            "response": [
                                                {
                                                    "id": "751490919",
                                                    "speaker": "派蒙",
                                                    "text": "就算你用这样理所当然的语气，没有的东西还是拿不出来的啦…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751490913",
                            "text": "稍微吓出来了一点…我是说灵魂。",
                            "response": [
                                {
                                    "id": "751490914",
                                    "speaker": "派蒙",
                                    "text": "好嘞！还有开玩笑的精神，看来很健康！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7514906",
            "objective": "跟随亮起的道路",
            "dialogues": [
                {
                    "id": "751490601",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔！"
                },
                {
                    "id": "751490602",
                    "speaker": "秘源龙仆",
                    "text": "喀喀…"
                },
                {
                    "id": "751490603",
                    "speaker": "秘源龙仆",
                    "text": "「看来你们终于让两个『象拟聚星』恢复运转…很快，这里的燃素浓度应该会提升到能够启动交流机关的程度…」"
                },
                {
                    "id": "751490604",
                    "speaker": "秘源龙仆",
                    "text": "「不过在那之前，还需等待一小会儿，作为人类，你们做得已经很不错了。」",
                    "choices": [
                        {
                            "id": "751490605",
                            "text": "突然又能对话了？",
                            "response": [
                                {
                                    "id": "751490607",
                                    "speaker": "秘源龙仆",
                                    "text": "「并不是，厄卡特尔的存在已经全部消亡了…就在不久之前。虽然名字在此地其实没什么意义，不过，这副身躯的名字…」"
                                },
                                {
                                    "id": "751490608",
                                    "speaker": "秘源龙仆",
                                    "text": "「『至高无上的阿玛鲁圣尊』，唉，这是留给这具身躯的名字，名字原本的主人是个愚蠢的家伙。」"
                                },
                                {
                                    "id": "751490609",
                                    "speaker": "「阿玛鲁」",
                                    "text": "「但你们可以直接叫『阿玛鲁』。」"
                                },
                                {
                                    "id": "751490610",
                                    "speaker": "派蒙",
                                    "text": "阿玛鲁？"
                                },
                                {
                                    "id": "751490611",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔嗯？"
                                },
                                {
                                    "id": "751490612",
                                    "speaker": "「阿玛鲁」",
                                    "text": "「他自大，说话无遮无拦，没有脑子，惹人生厌…但是在那场战争中，他守在受封绝的天轴前鏖战至死…」"
                                },
                                {
                                    "id": "751490613",
                                    "speaker": "「阿玛鲁」",
                                    "text": "「就在这里，所以我把他驱使的秘源龙仆也放在了这里…或许它很乐意代替它的主人在这里，看守天轴。」"
                                },
                                {
                                    "id": "751490614",
                                    "speaker": "「阿玛鲁」",
                                    "text": "检测燃素浓度抬升…回路检查完毕…喀喀…"
                                },
                                {
                                    "id": "751490615",
                                    "speaker": "「阿玛鲁」",
                                    "text": "升降井——天轴，已重新启动。"
                                },
                                {
                                    "id": "751490616",
                                    "speaker": "「阿玛鲁」",
                                    "text": "「看来差不多了，请往更深处前进吧。」"
                                }
                            ]
                        },
                        {
                            "id": "751490606",
                            "text": "…你是厄卡特尔?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7514901",
            "objective": "与奇怪的机关对话",
            "dialogues": [
                {
                    "id": "751491001",
                    "speaker": "派蒙",
                    "text": "#咦，{REALNAME[ID(2)|SHOWHOST(true)]}，怎么了，你发现什么东西了吗？"
                },
                {
                    "id": "751491002",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呼嗯！"
                },
                {
                    "id": "751491003",
                    "speaker": "派蒙",
                    "text": "啊，这个雕像，不就是之前被绒翼龙抓着的雕像嘛，居然也一起掉下来了…"
                },
                {
                    "id": "751491004",
                    "speaker": "派蒙",
                    "text": "#看上去就像是一个团起来的…大耳朵{REALNAME[ID(2)|SHOWHOST(true)]}。"
                },
                {
                    "id": "751491005",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯！"
                },
                {
                    "id": "751491006",
                    "speaker": "派蒙",
                    "text": "是嘛，你觉得不像啊，我觉得还是挺像的呢…"
                },
                {
                    "id": "751491007",
                    "speaker": "派蒙",
                    "text": "啊…它动起来了！"
                },
                {
                    "id": "751491008",
                    "speaker": "？？？",
                    "text": "喀…喀…"
                },
                {
                    "id": "751491009",
                    "speaker": "？？？",
                    "text": "自我检试运行中…关节处有些许积灰…存储介质激活，话语…远程提取…介入允许…喀喀…性格模块修正…"
                },
                {
                    "id": "751491010",
                    "speaker": "？？？",
                    "text": "……"
                },
                {
                    "id": "751491011",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "751491012",
                    "speaker": "派蒙",
                    "text": "原来不是雕像，而是什么机关吗…仔细一看，确实和秘源机关长得有点像，它身上飘着的奇怪的光，总觉得在哪看到过…"
                },
                {
                    "id": "751491013",
                    "speaker": "派蒙",
                    "text": "咦，怎么了，怎么不动了？"
                },
                {
                    "id": "751491014",
                    "speaker": "？？？",
                    "text": "「呜哇！」"
                },
                {
                    "id": "751491015",
                    "speaker": "派蒙",
                    "text": "呜哇！"
                },
                {
                    "id": "751491016",
                    "speaker": "？？？",
                    "text": "「发声模块看来没有问题，好了，尊贵的客人们，我已经在此等候你们许久…怎么了？」"
                },
                {
                    "id": "751491017",
                    "speaker": "派蒙",
                    "text": "怎么突然发出这么大的声音，真是吓人一跳…"
                },
                {
                    "id": "751491018",
                    "speaker": "？？？",
                    "text": "「那真是太好了，这样的登场才能留下点印象，不然我还担心你们会觉得自己受了冷落呢…」"
                },
                {
                    "id": "751491019",
                    "speaker": "派蒙",
                    "text": "咦，你是？"
                },
                {
                    "id": "751491020",
                    "speaker": "？？？",
                    "text": "「你问我是谁？嗯，这副身躯的名字叫厄卡特尔，你可以这样称呼，不过，名字在此地没有太多意义…」"
                },
                {
                    "id": "751491021",
                    "speaker": "？？？",
                    "text": "个体识别的称呼，变更请求是…通过记录…在那场战争后的一百五十年…变更名为，战亡名录——厄卡特尔…"
                },
                {
                    "id": "751491022",
                    "speaker": "「厄卡特尔」",
                    "text": "「没错，自那以后，就叫厄卡特尔…」"
                },
                {
                    "id": "751491023",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "751491024",
                    "speaker": "「厄卡特尔」",
                    "text": "「对，是我，我是『呼唤』你到来者，来吧，到圣山之心…在一切还为时未晚之前。」"
                },
                {
                    "id": "751491025",
                    "speaker": "「厄卡特尔」",
                    "text": "「不过还不用着急，先让厄卡特尔为你开辟眼前的一点点黑暗…我知道你们心中还有疑惑，但先随我来吧。」"
                }
            ]
        },
        {
            "id": "7514902",
            "objective": "向前探索",
            "dialogues": [
                {
                    "id": "751490201",
                    "speaker": "「厄卡特尔」",
                    "text": "「我得事先说明，这里原先没有那么暗…虽然，这里毫无疑问是火山的『内部』…」"
                },
                {
                    "id": "751490202",
                    "speaker": "「厄卡特尔」",
                    "text": "「只不过在那场战争结束之后，整座城市被毁灭殆尽，那之后，作为巨大机构的所有功能都不得不停摆…」"
                },
                {
                    "id": "751490203",
                    "speaker": "派蒙",
                    "text": "战争？"
                },
                {
                    "id": "751490204",
                    "speaker": "「厄卡特尔」",
                    "text": "「对，是残存的龙裔与人类的战争，也是令原初执掌火焰的主人死去的战争…」"
                },
                {
                    "id": "751490205",
                    "speaker": "「厄卡特尔」",
                    "text": "「这座城的主人已经死了，唯留这座城市依然苟活…不过也说不定，也许这座城市其实也早就死了。」"
                },
                {
                    "id": "751490206",
                    "speaker": "「厄卡特尔」",
                    "text": "「…又或者很多东西曾经存在，其实只不过是一种错觉。」"
                },
                {
                    "id": "751490207",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯？"
                },
                {
                    "id": "751490208",
                    "speaker": "「厄卡特尔」",
                    "text": "「我们各取所需，小家伙，你有来的需要，而我又希望依靠你的力量解决一些问题…」"
                },
                {
                    "id": "751490209",
                    "speaker": "「厄卡特尔」",
                    "text": "「你们必须得到圣山之心去…但可惜因为之前的战争，整座圣山的力量也在战争中被封绝。」"
                },
                {
                    "id": "751490210",
                    "speaker": "「厄卡特尔」",
                    "text": "「尽管那封绝之力在我看来犹如只困得住稚童的细索，但按照誓约，只有『人』才能够将它们开启…」"
                },
                {
                    "id": "751490211",
                    "speaker": "「厄卡特尔」",
                    "text": "「有趣的事是，用了这样的方法侵入圣山的可怜的孩子，最后可以说是毁于他人几乎相同的手段。」"
                },
                {
                    "id": "751490212",
                    "speaker": "「厄卡特尔」",
                    "text": "「呵呵，总是如此啊…就像暴君的追随者们被英雄驱逐，经历漫长的流浪，其后裔终结了另一个国度的暴君…」"
                },
                {
                    "id": "751490213",
                    "speaker": "「厄卡特尔」",
                    "text": "「世事如同被人安排的戏码那般，因果流转，恩仇覆反，在支离破碎的历史中轮番上演…」"
                },
                {
                    "id": "751490214",
                    "speaker": "「厄卡特尔」",
                    "text": "「说远了，来吧…启动它，让这座垂死的城再挣扎一番吧。现在，此世唯有你有这样的资格。」"
                }
            ]
        },
        {
            "id": "7514909",
            "objective": "与「厄卡特尔」对话",
            "dialogues": []
        },
        {
            "id": "7514910",
            "objective": "启动机关",
            "dialogues": []
        },
        {
            "id": "7514911",
            "objective": "启动机关",
            "dialogues": [
                {
                    "id": "751491101",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯…唔…"
                },
                {
                    "id": "751491102",
                    "speaker": "派蒙",
                    "text": "怎么了？看上去不是很舒服的样子。"
                },
                {
                    "id": "751491103",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呃呀！"
                },
                {
                    "id": "751491104",
                    "speaker": "派蒙",
                    "text": "那个难道是…深渊？"
                },
                {
                    "id": "751491105",
                    "speaker": "秘源龙仆",
                    "text": "「正是如此…深渊的魔物正如顽疾一般侵入圣城图兰。」"
                },
                {
                    "id": "751491106",
                    "speaker": "秘源龙仆",
                    "text": "「到了这种程度，说不定已经无法将之一点点驱逐，得将整座图兰圣山一同毁掉才能遏制它们的步伐呢…」"
                },
                {
                    "id": "751491107",
                    "speaker": "Player",
                    "text": "当你发现一只深渊魔物的时候…"
                },
                {
                    "id": "751491108",
                    "speaker": "秘源龙仆",
                    "text": "「说不定家里已经全都是这些漆黑又黏答答的敌人了…」"
                },
                {
                    "id": "751491109",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "751491110",
                    "speaker": "派蒙",
                    "text": "唔，你们在说什么恐怖的话呢。"
                },
                {
                    "id": "751491111",
                    "speaker": "Player",
                    "text": "砍掉腿就能遏制它们的步伐了！"
                },
                {
                    "id": "751491112",
                    "speaker": "派蒙",
                    "text": "真是让人豁然开朗，剩下的工作就是找到它们的腿在哪了…你以为我会这样说吗！"
                },
                {
                    "id": "751491113",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯？"
                },
                {
                    "id": "751491114",
                    "speaker": "秘源龙仆",
                    "text": "「哈哈，真可惜，小家伙，也许大部分的深渊魔物都不靠腿移动呢。」"
                },
                {
                    "id": "751491115",
                    "speaker": "秘源龙仆",
                    "text": "「…只有将这拦路的阴影之敌清除掉，你们才能通过此处，前往圣山之心。」"
                },
                {
                    "id": "751491116",
                    "speaker": "秘源龙仆",
                    "text": "「尽管已无法令这破碎的城市恢复原样，但至少也不应让它的残躯被漆黑的魔物占有。」"
                },
                {
                    "id": "751491117",
                    "speaker": "Player",
                    "text": "等等，不是有大火球吗…"
                },
                {
                    "id": "751491118",
                    "speaker": "派蒙",
                    "text": "是啊，大火球不就是用来对抗深渊的东西嘛…"
                },
                {
                    "id": "751491119",
                    "speaker": "秘源龙仆",
                    "text": "「大火球…你是说『象拟聚星』吗，它只有在初步接触深渊时与对方一同湮灭才能起到作用，否则反而会被深渊蚀化包裹…」"
                },
                {
                    "id": "751491120",
                    "speaker": "秘源龙仆",
                    "text": "「只可惜，这座城市被封绝太久…而为了维持稳定，『象拟聚星』不能被随意移动…」"
                },
                {
                    "id": "751491121",
                    "speaker": "秘源龙仆",
                    "text": "「受龙所选者啊…」"
                },
                {
                    "id": "751491122",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "751491123",
                    "speaker": "秘源龙仆",
                    "text": "「圣山之心是图兰建立以后，才重新开掘的区域…由最初的一尊秘源龙像看守。」"
                },
                {
                    "id": "751491124",
                    "speaker": "秘源龙仆",
                    "text": "「想要进入圣山之心，就必须获得许可…」"
                },
                {
                    "id": "751491125",
                    "speaker": "秘源龙仆",
                    "text": "「只不过，那只秘源龙像的能源亦受到侵蚀，也得想办法让它重新启动起来…」"
                },
                {
                    "id": "751491126",
                    "speaker": "秘源龙仆",
                    "text": "「它们…」警告，机能受损，即将关闭…「啊，看来这台机体…」"
                },
                {
                    "id": "751491127",
                    "speaker": "派蒙",
                    "text": "啊，阿玛鲁，那个什么许可，啊呀，你都什么都没说呢！"
                },
                {
                    "id": "751491128",
                    "speaker": "秘源龙仆",
                    "text": "「呵呵…继续前行吧，在那里，会有新的秘源龙仆为你们指引方向…」"
                },
                {
                    "id": "751491129",
                    "speaker": "秘源龙仆",
                    "text": "喀喀…"
                },
                {
                    "id": "751491130",
                    "speaker": "秘源龙仆",
                    "text": "「这是圣城核心的地图，我将在…恭候，你们的…」"
                },
                {
                    "id": "751491131",
                    "speaker": "派蒙",
                    "text": "啊，身上的光又消失了…"
                },
                {
                    "id": "751491132",
                    "speaker": "派蒙",
                    "text": "这下这个叫「阿玛鲁」的家伙应该也没有办法进行对话了吧。"
                },
                {
                    "id": "751491133",
                    "speaker": "秘源龙仆",
                    "text": "……"
                },
                {
                    "id": "751491134",
                    "speaker": "派蒙",
                    "text": "这家伙真是随心所欲，没办法，我们就往前找找看新的秘源龙仆吧…"
                }
            ]
        },
        {
            "id": "7514912",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "751490301",
                    "speaker": "「厄卡特尔」",
                    "text": "「我有向你们正式介绍它的名字吗？似乎没有…」"
                },
                {
                    "id": "751490302",
                    "speaker": "「厄卡特尔」",
                    "text": "「但没关系，欢迎，欢迎来到初始圣城{RUBY#[D]源火之地}图兰。」"
                },
                {
                    "id": "751490303",
                    "speaker": "派蒙",
                    "text": "哇，没想到火山里面，居然是这样的…"
                },
                {
                    "id": "751490304",
                    "speaker": "派蒙",
                    "text": "这真的是火山里吗？不会是我们在穿过火山口的时候，被人偷偷送到了别的地方吧？"
                },
                {
                    "id": "751490305",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…呀！"
                },
                {
                    "id": "751490306",
                    "speaker": "「厄卡特尔」",
                    "text": "「这里毫无疑问是圣山之内，不过即使是我…也不知道上一次看到如斯景象是什么时候了…」"
                },
                {
                    "id": "751490307",
                    "speaker": "「厄卡特尔」",
                    "text": "「啊啊…在光芒重新照亮你时，我竟才发现你已这样朽败啊…」"
                },
                {
                    "id": "751490308",
                    "speaker": "派蒙",
                    "text": "厄卡特尔？"
                },
                {
                    "id": "751490309",
                    "speaker": "「厄卡特尔」",
                    "text": "……"
                },
                {
                    "id": "751490310",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯？"
                },
                {
                    "id": "751490311",
                    "speaker": "「厄卡特尔」",
                    "text": "「哦，抱歉，只是陷入了一小会儿没有必要的感怀罢了…」"
                },
                {
                    "id": "751490312",
                    "speaker": "「厄卡特尔」",
                    "text": "介质储能低…即将休眠，请及时替换或连接…储能介质…"
                },
                {
                    "id": "751490313",
                    "speaker": "「厄卡特尔」",
                    "text": "「哈哈，看来长期『流亡在外』的厄卡特尔并不能撑更久了…」"
                },
                {
                    "id": "751490314",
                    "speaker": "派蒙",
                    "text": "啊，难道，厄卡特尔要、要死掉了吗？"
                },
                {
                    "id": "751490315",
                    "speaker": "「厄卡特尔」",
                    "text": "「厄卡特尔，拥有这个名字的家伙早就不在了…长话短说，重启图兰或许会消耗掉许多力量，不能白费，你们需要…」"
                },
                {
                    "id": "751490316",
                    "speaker": "「厄卡特尔」",
                    "text": "「其他两个『象拟{RUBY#[D]兹兹米特尔}聚星』，破坏其中一个的封印…和另一个」…「才能真正，开启中央的天轴」…"
                },
                {
                    "id": "751490317",
                    "speaker": "「厄卡特尔」",
                    "text": "「呃…」"
                },
                {
                    "id": "751490318",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "751490319",
                    "speaker": "「厄卡特尔」",
                    "text": "…「没事，我们还会…再见面的…」"
                },
                {
                    "id": "751490320",
                    "speaker": "「厄卡特尔」",
                    "text": "「唉…向前吧，受龙所选者…啊，躯体失去生机的痛苦，即使许多年，我也…无法那样适应…」"
                },
                {
                    "id": "751490321",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "751490322",
                    "speaker": "「厄卡特尔」",
                    "text": "……"
                },
                {
                    "id": "751490323",
                    "speaker": "派蒙",
                    "text": "围绕在它身边的光消失了…唔，厄卡特尔也变得一动不动的。"
                },
                {
                    "id": "751490324",
                    "speaker": "派蒙",
                    "text": "我还是有点没弄明白，那个说话的人到底是厄卡特尔，还是其实是别的人…？",
                    "choices": [
                        {
                            "id": "751490325",
                            "text": "以后总会知道的…",
                            "response": [
                                {
                                    "id": "751490327",
                                    "speaker": "派蒙",
                                    "text": "对哦，不过，刚才他说什么，「象拟聚星」，难道就是刚才的大火球？那天轴呢？不知道究竟是什么东西…"
                                },
                                {
                                    "id": "751490328",
                                    "speaker": "派蒙",
                                    "text": "唔，我们就先到处看看，找找他说的那些奇怪的东西吧！"
                                },
                                {
                                    "id": "751490329",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "751490326",
                            "text": "现在就先继续往前吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7514915",
            "objective": "继续探索",
            "dialogues": []
        },
        {
            "id": "7514903",
            "objective": "继续探索",
            "dialogues": []
        },
        {
            "id": "7514904",
            "objective": "继续探索",
            "dialogues": [
                {
                    "id": "751490401",
                    "speaker": "秘源龙仆",
                    "text": "检测…此处…天轴的道路已受封绝。核心「象拟聚星」已启动…"
                },
                {
                    "id": "751490402",
                    "speaker": "秘源龙仆",
                    "text": "仍需重新稳定其余「象拟聚星」，以获得重新启封的力量…"
                },
                {
                    "id": "751490403",
                    "speaker": "派蒙",
                    "text": "啊，厄卡特尔？"
                },
                {
                    "id": "751490404",
                    "speaker": "秘源龙仆",
                    "text": "检测…此处…天轴的道路已受封绝。核心「象拟聚星」已启动…"
                },
                {
                    "id": "751490405",
                    "speaker": "秘源龙仆",
                    "text": "仍需重新稳定其余「象拟聚星」，以获得重新启封的力量…"
                },
                {
                    "id": "751490406",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "751490407",
                    "speaker": "派蒙",
                    "text": "看上去虽然长得一样，但不是厄卡特尔呢…"
                },
                {
                    "id": "751490408",
                    "speaker": "派蒙",
                    "text": "不过，天轴…刚才厄卡特尔说过这个…所以这里就是需要被开启的「天轴」？"
                },
                {
                    "id": "751490409",
                    "speaker": "派蒙",
                    "text": "那看来得在周围找找那两个其他的「象拟聚星」了！"
                }
            ]
        },
        {
            "id": "7514905",
            "objective": "重新稳定「象拟聚星」",
            "dialogues": [
                {
                    "id": "751490501",
                    "speaker": "秘源龙仆",
                    "text": "检测…此处…天轴的道路已受封绝。核心「象拟聚星」已启动…"
                },
                {
                    "id": "751490502",
                    "speaker": "秘源龙仆",
                    "text": "重新稳定「象拟聚星」，以催动通往其下的道路…"
                }
            ]
        },
        {
            "id": "7514913",
            "objective": "前往「天轴」处",
            "dialogues": []
        },
        {
            "id": "7514907",
            "objective": "启动「天轴」",
            "dialogues": []
        },
        {
            "id": "7514908",
            "objective": "前往古城的深处",
            "dialogues": [
                {
                    "id": "751490801",
                    "speaker": "秘源龙仆",
                    "text": "检测燃素浓度抬升…回路检查完毕…喀喀…"
                },
                {
                    "id": "751490802",
                    "speaker": "秘源龙仆",
                    "text": "升降井——天柱，已重新启动。"
                }
            ]
        },
        {
            "id": "7514916",
            "objective": "前往古城的深处",
            "dialogues": []
        },
        {
            "id": "7514914",
            "objective": "与「阿玛鲁」对话",
            "dialogues": []
        },
        {
            "id": "7514999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751499901",
                    "speaker": "派蒙",
                    "text": "这么一来，那个古怪雕像说的两个「象拟聚星」都算是解决了。"
                },
                {
                    "id": "751499902",
                    "speaker": "派蒙",
                    "text": "我们去中间的那个「天轴」看看吧！"
                },
                {
                    "id": "751499903",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                }
            ]
        }
    ]
}