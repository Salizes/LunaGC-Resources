    "talks": [
        {
            "id": "2400701",
            "objective": "与洛薇对话",
            "dialogues": [
                {
                    "id": "240070101",
                    "speaker": "韦吕",
                    "text": "洛薇？你找到什么好东西了吗？"
                },
                {
                    "id": "240070102",
                    "speaker": "洛薇",
                    "text": "没有呀，这里什么也没有！"
                },
                {
                    "id": "240070103",
                    "speaker": "Player",
                    "text": "你们在做什么呢？"
                },
                {
                    "id": "240070104",
                    "speaker": "韦吕",
                    "text": "#{M#大哥哥}{F#大姐姐}，我们正在「寻宝」呢，嘿嘿…你要不要和我们一起呀？",
                    "choices": [
                        {
                            "id": "240070105",
                            "text": "寻宝？",
                            "response": [
                                {
                                    "id": "240070106",
                                    "speaker": "洛薇",
                                    "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。"
                                },
                                {
                                    "id": "240070107",
                                    "speaker": "韦吕",
                                    "text": "这些零件就是宝物…咦？这里应该有啊…"
                                },
                                {
                                    "id": "240070114",
                                    "speaker": "洛薇",
                                    "text": "唔…看来这里是找不到了，我换个地方吧？"
                                },
                                {
                                    "id": "240070115",
                                    "speaker": "韦吕",
                                    "text": "行！我们再往前面走走。",
                                    "choices": [
                                        {
                                            "id": "240070116",
                                            "text": "我和你们一起去吧。",
                                            "response": [
                                                {
                                                    "id": "240070118",
                                                    "speaker": "韦吕",
                                                    "text": "#呜哇，{M#大哥哥}{F#大姐姐}说话的语气好像哥哥…"
                                                },
                                                {
                                                    "id": "240070119",
                                                    "speaker": "韦吕",
                                                    "text": "那我们再往前走走，我记得这附近的水里有很多零件的啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240070117",
                                            "text": "可不要到处乱跑。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240070108",
                            "text": "怎么没看见奥雷勒？",
                            "response": [
                                {
                                    "id": "240070109",
                                    "speaker": "韦吕",
                                    "text": "哥哥去城里找德勒吕叔叔啦，他说有些问题想要请教。"
                                },
                                {
                                    "id": "240070110",
                                    "speaker": "韦吕",
                                    "text": "我们呢，就只能乖乖听话不乱跑…一直在这里「寻宝」啦。"
                                },
                                {
                                    "id": "240070111",
                                    "speaker": "韦吕",
                                    "text": "#嘿嘿…{M#大哥哥}{F#大姐姐}要不要和我们一起呀？"
                                },
                                {
                                    "id": "240070112",
                                    "speaker": "洛薇",
                                    "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。"
                                },
                                {
                                    "id": "240070113",
                                    "speaker": "韦吕",
                                    "text": "这些零件就是宝物…咦？这里应该有啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400702",
            "objective": "寻找「宝物」",
            "dialogues": [
                {
                    "id": "240070201",
                    "speaker": "洛薇",
                    "text": "只有一些烂纸板啊…没有零件。"
                },
                {
                    "id": "240070202",
                    "speaker": "韦吕",
                    "text": "奇怪，我昨天才在这里捞出来了好几枚齿轮的。"
                }
            ]
        },
        {
            "id": "2400703",
            "objective": "寻找「宝物」",
            "dialogues": [
                {
                    "id": "240070301",
                    "speaker": "韦吕",
                    "text": "找到啦！这枚齿轮很完整，你看，还有一整根轴承呢。"
                },
                {
                    "id": "240070302",
                    "speaker": "洛薇",
                    "text": "太好了，这些都能用上！"
                }
            ]
        },
        {
            "id": "2400704",
            "objective": "寻找「宝物」",
            "dialogues": [
                {
                    "id": "240070401",
                    "speaker": "洛薇",
                    "text": "这是…破衣服？都泡掉色了…"
                },
                {
                    "id": "240070402",
                    "speaker": "韦吕",
                    "text": "这里难道被人捞过了吗？怎么什么零件都没有…"
                }
            ]
        },
        {
            "id": "2400705",
            "objective": "",
            "dialogues": [
                {
                    "id": "240070501",
                    "speaker": "洛薇",
                    "text": "我看看…这枚齿轮可以用，这个轴承如果锯开的话…"
                },
                {
                    "id": "240070502",
                    "speaker": "Player",
                    "text": "你找这个做什么？"
                },
                {
                    "id": "240070503",
                    "speaker": "洛薇",
                    "text": "我想要自己做一个发条人偶。其实…我之前一直在悄悄地学习相关的知识啦。"
                },
                {
                    "id": "240070504",
                    "speaker": "洛薇",
                    "text": "等我学好了，就要做一个大大的发条机关，给爸爸一个惊喜！"
                },
                {
                    "id": "240070505",
                    "speaker": "洛薇",
                    "text": "我去爸爸房里看了好多书，也按照书上的方法做过一些简单的部件了。"
                },
                {
                    "id": "240070506",
                    "speaker": "洛薇",
                    "text": "只要再加把劲，我一定能完成我想做的那个发条机关！"
                },
                {
                    "id": "240070507",
                    "speaker": "洛薇",
                    "text": "但我可不能在城里研究发条和机械，否则马上就会被我爸爸发现，那样就给不了他惊喜了。"
                },
                {
                    "id": "240070508",
                    "speaker": "韦吕",
                    "text": "所以，这里就成了洛薇研究发条机械的秘密基地啦，而我嘛…就是她的助手。"
                },
                {
                    "id": "240070509",
                    "speaker": "洛薇",
                    "text": "多说无益，助手！开始研究吧！今天我们必须做出一个能动的机关胳膊！"
                },
                {
                    "id": "240070510",
                    "speaker": "韦吕",
                    "text": "是！开始研究吧！"
                }
            ]
        },
