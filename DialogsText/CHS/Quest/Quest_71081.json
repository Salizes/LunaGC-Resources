            "dialogues": [
                {
                    "id": "710451501",
                    "speaker": "克里托夫",
                    "text": "啊，你来了！欢迎来到层岩巨渊勘探队的爆破组与饮料供应处！"
                },
                {
                    "id": "710451502",
                    "speaker": "克里托夫",
                    "text": "全体成员——也就是我，克里托夫，向你致敬！"
                },
                {
                    "id": "710451503",
                    "speaker": "克里托夫",
                    "text": "哈哈，这杯算请你了！多谢你为我们做的一切。",
                    "choices": [
                        {
                            "id": "710451504",
                            "text": "接下来有什么打算？",
                            "response": [
                                {
                                    "id": "710451506",
                                    "speaker": "克里托夫",
                                    "text": "既然我已经正式成为勘探队的一员了，当然要跟随队伍留在这里。"
                                },
                                {
                                    "id": "710451507",
                                    "speaker": "克里托夫",
                                    "text": "哼…不过如果海迪夫和瑾武姐能帮我申请到更多帮手就好了…"
                                },
                                {
                                    "id": "710451508",
                                    "speaker": "克里托夫",
                                    "text": "虽说到那时候呀，恐怕我就当不成爆破组长兼唯一队员了。"
                                }
                            ]
                        },
                        {
                            "id": "710451505",
                            "text": "你要留在这里吗？"
                        }
                    ]
                }
            ]
        }
    ]
