    "talks": [
        {
            "id": "7565601",
            "objective": "",
            "dialogues": [
                {
                    "id": "756560201",
                    "speaker": "琳妮特",
                    "text": "…你过来了啊，我还在想你会不会发现我，看来这次隐蔽失败了。"
                },
                {
                    "id": "756560202",
                    "speaker": "琳妮特",
                    "text": "#尽管我确实没花力气隐蔽…总之稍等…「{NICKNAME}观察模式」关闭，「聊天模式」启动。"
                },
                {
                    "id": "756560203",
                    "speaker": "琳妮特",
                    "text": "按照之前的观察，你似乎在看风景，且不像是闲逛。在忙正事？",
                    "choices": [
                        {
                            "id": "756560204",
                            "text": "在观察什么地方适合留影。",
                            "response": [
                                {
                                    "id": "756560206",
                                    "speaker": "琳妮特",
                                    "text": "留影…你终于决定结束旅行，转头去给蒸汽鸟报社打工了吗？"
                                },
                                {
                                    "id": "756560207",
                                    "speaker": "琳妮特",
                                    "text": "可以理解，冒险家的收入不稳定，而你还要养活派蒙，很不容易。",
                                    "choices": [
                                        {
                                            "id": "756560208",
                                            "text": "可恶的蒸汽鸟报社做六休一。",
                                            "response": [
                                                {
                                                    "id": "756560209",
                                                    "speaker": "琳妮特",
                                                    "text": "竟然顺着我的玩笑说了下去，哇哦，是我低估你了。"
                                                },
                                                {
                                                    "id": "756560212",
                                                    "speaker": "琳妮特",
                                                    "text": "特地到这里留影，只能是来拍枫丹廷的吧。"
                                                },
                                                {
                                                    "id": "756560213",
                                                    "speaker": "Player",
                                                    "text": "琳妮特很敏锐。"
                                                },
                                                {
                                                    "id": "756560214",
                                                    "speaker": "琳妮特",
                                                    "text": "因为很多蒸汽鸟报社的记者都喜欢来这里拍枫丹廷远景，有时还会随口交流一些小道消息。"
                                                },
                                                {
                                                    "id": "756560215",
                                                    "speaker": "琳妮特",
                                                    "text": "我只要保持隐蔽，安安静静听着就好。"
                                                },
                                                {
                                                    "id": "756560216",
                                                    "speaker": "琳妮特",
                                                    "text": "不过来的次数多了，我也学到了一些留影技巧…怎么样，需要助手吗？",
                                                    "choices": [
                                                        {
                                                            "id": "756560217",
                                                            "text": "比起助手更需要模特。",
                                                            "response": [
                                                                {
                                                                    "id": "756560219",
                                                                    "speaker": "琳妮特",
                                                                    "text": "了解，这种不需要动嘴的事情更合我意。你觉得什么样的姿势比较好？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756560220",
                                                                            "text": "端正的姿势。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756560222",
                                                                                    "speaker": "琳妮特",
                                                                                    "text": "好，这样可以吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756560223",
                                                                                            "text": "很棒！我们开始留影吧！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560224",
                                                                                                    "speaker": "琳妮特",
                                                                                                    "text": "我准备好了。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756560225",
                                                                                            "text": "还是有趣的姿势合适。"
                                                                                        },
                                                                                        {
                                                                                            "id": "756560226",
                                                                                            "text": "还是放松的姿势合适。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560227",
                                                                                                    "speaker": "琳妮特",
                                                                                                    "text": "那就这样好了。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756560228",
                                                                                            "text": "还是端正的姿势合适。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560229",
                                                                                                    "speaker": "琳妮特",
                                                                                                    "text": "那就这样好了。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756560221",
                                                                            "text": "有趣的姿势。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756560218",
                                                            "text": "想请琳妮特帮忙入镜。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756560210",
                                            "text": "不是，没有，我忠于冒险家协会！",
                                            "response": [
                                                {
                                                    "id": "756560211",
                                                    "speaker": "琳妮特",
                                                    "text": "没想到你对冒险家协会的感情这么真挚，抱歉，这只是一个玩笑，我没想怀疑你的冒险家精神。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756560205",
                            "text": "在想找人留影的事。"
                        }
                    ]
                }
            ]
        },
