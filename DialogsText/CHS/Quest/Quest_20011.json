    "talks": [
        {
            "id": "2001101",
            "objective": "前去查看详请",
            "dialogues": [
                {
                    "id": "200110101",
                    "speaker": "安东尼",
                    "text": "快来救救我！"
                }
            ]
        },
        {
            "id": "2001102",
            "objective": "(test)击败附近怪物$HIDDEN",
            "dialogues": [
                {
                    "id": "200110201",
                    "speaker": "安东尼",
                    "text": "谢谢你，旅行者…"
                },
                {
                    "id": "200110202",
                    "speaker": "安东尼",
                    "text": "可是还有个路障在这，我还是过不去，"
                },
                {
                    "id": "200110203",
                    "speaker": "安东尼",
                    "text": "哈哈哈，本来我可以自己搞定…可我吃了丘丘人好几下，全身都在痛。"
                },
                {
                    "id": "200110204",
                    "speaker": "安东尼",
                    "text": "不过还好，我给安娜摘的这些草药都没坏…"
                },
                {
                    "id": "200110205",
                    "speaker": "安东尼",
                    "text": "抱歉，虽然已经很麻烦你了，但是你能再帮我把这路障给解决掉吗？",
                    "choices": [
                        {
                            "id": "200110206",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200110208",
                                    "speaker": "安东尼",
                                    "text": "谢谢，我要休息一下…"
                                }
                            ]
                        },
                        {
                            "id": "200110207",
                            "text": "我还有急事。",
                            "response": [
                                {
                                    "id": "200110209",
                                    "speaker": "安东尼",
                                    "text": "可安娜还在家等着我…请你再帮帮我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2001103",
            "objective": "消灭所有魔物并摧毁路障",
            "dialogues": [
                {
                    "id": "200110301",
                    "speaker": "安东尼",
                    "text": "这样子可以走过去了…谢谢，旅行者。"
                },
                {
                    "id": "200110302",
                    "speaker": "安东尼",
                    "text": "因为没多少钱，安娜的病又始终不见好，所以我经常来这采草药。"
                },
                {
                    "id": "200110303",
                    "speaker": "安东尼",
                    "text": "虽然草药采到了，但没想到今天会被这群家伙袭击，还好你赶过来了。"
                },
                {
                    "id": "200110304",
                    "speaker": "安东尼",
                    "text": "这个给你，我经常用这个给安娜泡茶喝，这样她的咳嗽才会好些。"
                },
                {
                    "id": "200110305",
                    "speaker": "安东尼",
                    "text": "你也经常在野外跑吧，自己要照顾好自己啊。"
                }
            ]
        },
        {
