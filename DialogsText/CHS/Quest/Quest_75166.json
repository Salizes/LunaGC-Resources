    "talks": [
        {
            "id": "7516601",
            "objective": "进入火山底的巨大空间",
            "dialogues": [
                {
                    "id": "751660101",
                    "speaker": "派蒙",
                    "text": "唔…没想到火山底下还有这么大的空间！"
                },
                {
                    "id": "751660102",
                    "speaker": "派蒙",
                    "text": "而且，根本全都是深渊嘛…仔细一想，上面原本遮住入口的深渊说不定就是从这里爬出来的…"
                },
                {
                    "id": "751660103",
                    "speaker": "（test）龙铭刻",
                    "text": "受龙所选者啊，流炎的力量已加诸你身——"
                },
                {
                    "id": "751660104",
                    "speaker": "（test）龙铭刻",
                    "text": "去清除，阴影之大敌吧！"
                },
                {
                    "id": "751660105",
                    "speaker": "派蒙",
                    "text": "噢噢，虽然不知道为什么，全身上下有暖洋洋的力量…"
                },
                {
                    "id": "751660106",
                    "speaker": "派蒙",
                    "text": "不过是个好机会，就在这里把入侵的深渊一网打尽吧！"
                },
                {
                    "id": "751660107",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                }
            ]
        },
