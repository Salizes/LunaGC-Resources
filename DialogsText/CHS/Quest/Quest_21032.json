    "talks": [
        {
            "id": "2103201",
            "objective": "与孙宇对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "210320201",
                    "speaker": "Player",
                    "text": "对抗魔物。$UNRELEASED"
                },
                {
                    "id": "210320202",
                    "speaker": "孙宇",
                    "text": "好！我早就想要把我学习的剑术用在实处了…$UNRELEASED"
                },
                {
                    "id": "210320203",
                    "speaker": "Player",
                    "text": "只怕你看不清我的动作。$UNRELEASED"
                },
                {
                    "id": "210320204",
                    "speaker": "孙宇",
                    "text": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。$UNRELEASED"
                },
                {
                    "id": "210320205",
                    "speaker": "孙宇",
                    "text": "我看看…上次我已经看准了一处魔物的聚集地，咱们就先去那里好了。$UNRELEASED"
                }
            ]
        },
        {
            "id": "2103202",
            "objective": "打倒所有魔物$UNRELEASED",
            "dialogues": []
        },
        {
            "id": "2103203",
            "objective": "在限时时间内抵达终点$UNRELEASED",
            "dialogues": [
                {
                    "id": "210320301",
                    "speaker": "Player",
                    "text": "越野训练。$UNRELEASED"
                },
                {
                    "id": "210320302",
                    "speaker": "孙宇",
                    "text": "那就太好了，我还请一位冒险家帮我规划了一条越野路线。$UNRELEASED"
                },
                {
                    "id": "210320303",
                    "speaker": "孙宇",
                    "text": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…$UNRELEASED"
                },
                {
                    "id": "210320304",
                    "speaker": "孙宇",
                    "text": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。$UNRELEASED",
                    "choices": [
                        {
                            "id": "210320305",
                            "text": "没问题。$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320308",
                                    "speaker": "孙宇",
                                    "text": "那就拜托你了，我们先去训练地点吧。$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "210320306",
                            "text": "你可别被我甩远了。$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320307",
                                    "speaker": "孙宇",
                                    "text": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103204",
            "objective": "与孙宇对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "210320401",
                    "speaker": "孙宇",
                    "text": "呼…呼…真是难以对付…$UNRELEASED"
                },
                {
                    "id": "210320402",
                    "speaker": "孙宇",
                    "text": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…$UNRELEASED"
                },
                {
                    "id": "210320403",
                    "speaker": "孙宇",
                    "text": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。$UNRELEASED"
                },
                {
                    "id": "210320404",
                    "speaker": "Player",
                    "text": "你真的要离开璃月？$UNRELEASED"
                },
                {
                    "id": "210320405",
                    "speaker": "孙宇",
                    "text": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。$UNRELEASED"
                }
            ]
        },
        {
            "id": "2103205",
            "objective": "与孙宇对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "210320501",
                    "speaker": "孙宇",
                    "text": "呼…呼…呼…你怎么…怎么能跑得这么快…$UNRELEASED",
                    "choices": [
                        {
                            "id": "210320502",
                            "text": "是你跑得太慢了。$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320503",
                                    "speaker": "孙宇",
                                    "text": "甘拜下风…甘拜下风…$UNRELEASED"
                                },
                                {
                                    "id": "210320506",
                                    "speaker": "孙宇",
                                    "text": "呼…总算是把气喘匀了。没想到「越野」居然这么累人…$UNRELEASED"
                                },
                                {
                                    "id": "210320507",
                                    "speaker": "孙宇",
                                    "text": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。$UNRELEASED",
                                    "choices": [
                                        {
                                            "id": "210320508",
                                            "text": "关于小雀儿…$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "210320509",
                                                    "speaker": "孙宇",
                                                    "text": "师妹她还是不愿意和我走，反倒是想要说服我留在璃月。$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320510",
                                                    "speaker": "孙宇",
                                                    "text": "我又…我又何尝不明白师妹的心思。但留在璃月，我又怎能找出复兴古华派的方法。$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320511",
                                                    "speaker": "孙宇",
                                                    "text": "唉…我看此事，是难以两全啊…$UNRELEASED"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210320512",
                                            "text": "你之前在这里锻炼过？$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "210320513",
                                                    "speaker": "孙宇",
                                                    "text": "我…呃…我听说此处地势颇险，魔物众多，觉得很适合作为锻炼的场所，所以…$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320514",
                                                    "speaker": "Player",
                                                    "text": "你之前是偷偷进来的？$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320515",
                                                    "speaker": "孙宇",
                                                    "text": "是…我是偷偷进来的…但我又怎么知道进层岩巨渊这么麻烦。$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320516",
                                                    "speaker": "孙宇",
                                                    "text": "我每次进来还都要和一位冒险家同行，以「一同执行协会委托」为理由进入层岩巨渊。$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320517",
                                                    "speaker": "孙宇",
                                                    "text": "咳，别提了，等会我还要去和她会合，帮她搜集花草呢…$UNRELEASED"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210320504",
                            "text": "你还得多多锻炼啊。$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320505",
                                    "speaker": "孙宇",
                                    "text": "你说得…说得对…$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210320101",
                    "speaker": "孙宇",
                    "text": "旅行者，我们又见面了。$UNRELEASED",
                    "choices": [
                        {
                            "id": "210320102",
                            "text": "你还在锻炼吗？$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320103",
                                    "speaker": "孙宇",
                                    "text": "是的，只不过…实在是有些辛苦。也不知道我是真的实力不济，还是用错了锻炼方法…$UNRELEASED"
                                },
                                {
                                    "id": "210320108",
                                    "speaker": "孙宇",
                                    "text": "先不说这些了。上次和你同行时，你的招式和动作都给了我很大启发。$UNRELEASED"
                                },
                                {
                                    "id": "210320109",
                                    "speaker": "孙宇",
                                    "text": "旅行者，请你今天再陪我出去锻炼一次吧。$UNRELEASED",
                                    "choices": [
                                        {
                                            "id": "210320110",
                                            "text": "没问题。$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "210320113",
                                                    "speaker": "孙宇",
                                                    "text": "是这样，我初步给自己拟定了一个训练的计划，其中包括了「对抗魔物」和「越野训练」两项。$UNRELEASED"
                                                },
                                                {
                                                    "id": "210320114",
                                                    "speaker": "孙宇",
                                                    "text": "旅行者，你看你方便陪我进行哪一项训练？$UNRELEASED"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210320111",
                                            "text": "你还要和我对打吗？行啊，我准备一下…$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "210320112",
                                                    "speaker": "孙宇",
                                                    "text": "欸？！等等，等等！我可打不过你啊！$UNRELEASED"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210320104",
                            "text": "你师妹还不理你？$UNRELEASED",
                            "response": [
                                {
                                    "id": "210320105",
                                    "speaker": "孙宇",
                                    "text": "咳…师妹她…最近总是说城里有事要处理，一直也没回来过…$UNRELEASED"
                                },
                                {
                                    "id": "210320106",
                                    "speaker": "孙宇",
                                    "text": "我去找她说过几次，但她都只是让芷若出来挡住我，始终也不肯见我。$UNRELEASED"
                                },
                                {
                                    "id": "210320107",
                                    "speaker": "孙宇",
                                    "text": "唉，我也不知道怎么劝好她…$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}