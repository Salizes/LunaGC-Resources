    "talks": [
        {
            "id": "45201",
            "objective": "询问安柏奔狼领男孩的事情",
            "dialogues": [
                {
                    "id": "4520101",
                    "speaker": "安柏",
                    "text": "#啊，派蒙和{NICKNAME}，找我有什么事情吗？"
                },
                {
                    "id": "4520102",
                    "speaker": "派蒙",
                    "text": "你好啊，安柏。",
                    "choices": [
                        {
                            "id": "4520103",
                            "text": "安柏，有件事情……",
                            "response": [
                                {
                                    "id": "4520104",
                                    "speaker": "派蒙",
                                    "text": "安柏，你认识奔狼领的男孩吗？"
                                },
                                {
                                    "id": "4520105",
                                    "speaker": "安柏",
                                    "text": "啊？"
                                },
                                {
                                    "id": "4520106",
                                    "speaker": "派蒙",
                                    "text": "就是和你关系很好的那位啊？"
                                },
                                {
                                    "id": "4520107",
                                    "speaker": "安柏",
                                    "text": "你在说什么啊？"
                                },
                                {
                                    "id": "4520108",
                                    "speaker": "派蒙",
                                    "text": "奇怪了，他说在老地方等你。难道你已经把他忘记了吗？"
                                },
                                {
                                    "id": "4520109",
                                    "speaker": "安柏",
                                    "text": "小派蒙你才是，该不会吃错了蘑菇产生幻觉了吧？"
                                },
                                {
                                    "id": "4520110",
                                    "speaker": "安柏",
                                    "text": "我完全不明白啊。"
                                },
                                {
                                    "id": "4520111",
                                    "speaker": "派蒙",
                                    "text": "呃……不能吃的蘑菇是什么颜色的？"
                                },
                                {
                                    "id": "4520112",
                                    "speaker": "安柏",
                                    "text": "紫色的。"
                                },
                                {
                                    "id": "4520113",
                                    "speaker": "派蒙",
                                    "text": "……好像前两天真的吃过。"
                                },
                                {
                                    "id": "4520114",
                                    "speaker": "派蒙",
                                    "text": "这不是重点！我现在没傻——！"
                                },
                                {
                                    "id": "4520115",
                                    "speaker": "派蒙",
                                    "text": "你不会真的不认识那个和狼群一起生活的男孩子吧？"
                                },
                                {
                                    "id": "4520116",
                                    "speaker": "安柏",
                                    "text": "你在说什么啊——不明白——"
                                },
                                {
                                    "id": "4520117",
                                    "speaker": "安柏",
                                    "text": "不过，说到狼。 我最近在调查一件事情。"
                                },
                                {
                                    "id": "4520118",
                                    "speaker": "安柏",
                                    "text": "本来只在「奔狼领」活动的狼群，最近胆子变大了。"
                                },
                                {
                                    "id": "4520119",
                                    "speaker": "安柏",
                                    "text": "据说，袭击了「醉汉峡」附近的车队…"
                                },
                                {
                                    "id": "4520120",
                                    "speaker": "安柏",
                                    "text": "如果有空的话，来协助我调查一下，可以吗？",
                                    "choices": [
                                        {
                                            "id": "4520121",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "4520123",
                                                    "speaker": "安柏",
                                                    "text": "哼哼，真可靠。 那我们出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4520122",
                                            "text": "还是正事要紧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4520124",
                            "text": "你好啊，最近怎么样？",
                            "response": [
                                {
                                    "id": "4520125",
                                    "speaker": "安柏",
                                    "text": "啊，你看起来挺闲的。"
                                },
                                {
                                    "id": "4520126",
                                    "speaker": "派蒙",
                                    "text": "呃，一般说了这句话之后——"
                                },
                                {
                                    "id": "4520127",
                                    "speaker": "安柏",
                                    "text": "我最近很忙哦。毕竟侦察骑士责任重大嘛——你要来帮忙吗？"
                                },
                                {
                                    "id": "4520129",
                                    "speaker": "派蒙",
                                    "text": "果然是这句话！",
                                    "choices": [
                                        {
                                            "id": "4520130",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "4520132",
                                                    "speaker": "安柏",
                                                    "text": "最近狼群开始袭击「醉汉峡」沿线的车队了。"
                                                },
                                                {
                                                    "id": "4520133",
                                                    "speaker": "安柏",
                                                    "text": "你知道吧？狼群虽然很危险，但是有自己原则的。"
                                                },
                                                {
                                                    "id": "4520134",
                                                    "speaker": "安柏",
                                                    "text": "蒙德的狼基本不会离开明冠山和奔狼领。"
                                                },
                                                {
                                                    "id": "4520135",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，听说虽然那里生态很原始，但也是有独特规则的。"
                                                },
                                                {
                                                    "id": "4520136",
                                                    "speaker": "安柏",
                                                    "text": "没错。所以狼群跑到醉汉峡袭击人，这就很奇怪了。"
                                                },
                                                {
                                                    "id": "4520137",
                                                    "speaker": "派蒙",
                                                    "text": "说到狼，安柏你认识奔狼领的男孩吗？"
                                                },
                                                {
                                                    "id": "4520138",
                                                    "speaker": "安柏",
                                                    "text": "不认识啊，蒙德还有这样的人？"
                                                },
                                                {
                                                    "id": "4520139",
                                                    "speaker": "派蒙",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "4520140",
                                                    "speaker": "派蒙",
                                                    "text": "「红色的，看起来很烫的女孩子」，难道不是安柏吗？"
                                                },
                                                {
                                                    "id": "4520141",
                                                    "speaker": "安柏",
                                                    "text": "你在说什么啊？那是什么？"
                                                },
                                                {
                                                    "id": "4520142",
                                                    "speaker": "安柏",
                                                    "text": "总之，我马上就要赶去醉汉峡调查了。"
                                                },
                                                {
                                                    "id": "4520143",
                                                    "speaker": "安柏",
                                                    "text": "你们也一起来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4520131",
                                            "text": "是什么事？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "45202",
            "objective": "前往醉汉峡",
            "dialogues": [
                {
                    "id": "4520201",
                    "speaker": "安柏",
                    "text": "前方有骚乱！"
                },
                {
                    "id": "4520202",
                    "speaker": "派蒙",
                    "text": "不是狼群，好像是丘丘人部落在袭击货车！"
                },
                {
                    "id": "4520203",
                    "speaker": "安柏",
                    "text": "唔…这倒不是什么罕见的情况呢。"
                },
                {
                    "id": "4520204",
                    "speaker": "安柏",
                    "text": "好啦，闲话少说，我们赶快去帮忙吧。"
                }
            ]
        },
        {
            "id": "45203",
            "objective": "向安柏了解前方的骚乱",
            "dialogues": []
        },
        {
            "id": "45206",
            "objective": "消灭丘丘人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "45204",
            "objective": "消灭丘丘人",
            "dialogues": [
                {
                    "id": "4520401",
                    "speaker": "安柏",
                    "text": "让我们赶快过去帮忙吧！"
                }
            ]
        },
        {
            "id": "45205",
            "objective": "与齐格芙丽雅对话",
            "dialogues": [
                {
                    "id": "4520301",
                    "speaker": "齐格芙丽雅",
                    "text": "谢，谢谢你们！"
                },
                {
                    "id": "4520302",
                    "speaker": "派蒙",
                    "text": "小事一桩啦。"
                },
                {
                    "id": "4520303",
                    "speaker": "安柏",
                    "text": "最近借着狼群的威风，丘丘人都嚣张跋扈了起来。"
                },
                {
                    "id": "4520304",
                    "speaker": "齐格芙丽雅",
                    "text": "是这样的。但是我觉得相比丘丘人，还是狼群更肆无忌惮一些。"
                },
                {
                    "id": "4520305",
                    "speaker": "齐格芙丽雅",
                    "text": "它们…上午刚袭击了清泉镇。"
                },
                {
                    "id": "4520306",
                    "speaker": "安柏",
                    "text": "什么？袭击镇上？！这也太嚣张了！"
                },
                {
                    "id": "4520307",
                    "speaker": "齐格芙丽雅",
                    "text": "是啊。"
                },
                {
                    "id": "4520308",
                    "speaker": "齐格芙丽雅",
                    "text": "我心想狼群闹够了，兴许可以上路，没想到就遇到了丘丘人…"
                },
                {
                    "id": "4520309",
                    "speaker": "安柏",
                    "text": "那我们现在赶过去，说不定还能看到残留的现场。"
                },
                {
                    "id": "4520310",
                    "speaker": "安柏",
                    "text": "先走一步了！你就赶快检查一下损失吧。货车还能动吗？"
                },
                {
                    "id": "4520311",
                    "speaker": "齐格芙丽雅",
                    "text": "啊，好…"
                }
            ]
        }
    ]
}