    "talks": [
        {
            "id": "7418501",
            "objective": "与埃斯特对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741850101",
                    "speaker": "派蒙",
                    "text": "埃斯特先生，我们回来啦！"
                },
                {
                    "id": "741850102",
                    "speaker": "埃斯特",
                    "text": "哦哦，原来是…等等，不对，你们是谁？"
                },
                {
                    "id": "741850103",
                    "speaker": "派蒙",
                    "text": "#欸？你该不会不认识我们了吧，我们是{NICKNAME}和派蒙啊！"
                },
                {
                    "id": "741850104",
                    "speaker": "埃斯特",
                    "text": "#{NICKNAME}和派蒙…我的确听过这两个名字，但那应该是在梦中才对啊！"
                },
                {
                    "id": "741850105",
                    "speaker": "派蒙",
                    "text": "唔，不过那个时候埃斯特先生明明是很清醒的啊，而且我们在下面不是还见到了…"
                },
                {
                    "id": "741850106",
                    "speaker": "埃斯特",
                    "text": "唉，我梦见镇上的大家都被变成了石像，只剩下我一个人待在镇上束手无策。"
                },
                {
                    "id": "741850107",
                    "speaker": "埃斯特",
                    "text": "直到两位勇士来到了镇上，才承担起了解救大家的重任…该不会，那其实不是梦？",
                    "choices": [
                        {
                            "id": "741850108",
                            "text": "可能是也可能不是吧。",
                            "response": [
                                {
                                    "id": "741850110",
                                    "speaker": "派蒙",
                                    "text": "嗯，反正现在大家都恢复正常了不是吗？"
                                },
                                {
                                    "id": "741850111",
                                    "speaker": "埃斯特",
                                    "text": "不过大家好像都做了些奇怪的梦。到底发生了什么，难道我们是被集体催眠了吗？"
                                },
                                {
                                    "id": "741850112",
                                    "speaker": "派蒙",
                                    "text": "要说清楚怕是一天一夜也说不完…还是先别提催眠的事情了吧！"
                                },
                                {
                                    "id": "741850113",
                                    "speaker": "埃斯特",
                                    "text": "哦？说到催眠，你们还带了一只猫过来呢，看上去很有灵性的样子啊。",
                                    "choices": [
                                        {
                                            "id": "741850114",
                                            "text": "确实很有灵性。",
                                            "response": [
                                                {
                                                    "id": "741850115",
                                                    "speaker": "派蒙",
                                                    "text": "它可是我们的伙伴呢，不过我们也没办法带着它一起旅行…"
                                                },
                                                {
                                                    "id": "741850118",
                                                    "speaker": "埃斯特",
                                                    "text": "那真是巧了，正好我们俱乐部里还有一间猫舍。自从某个研究催眠术的家伙带着他的猫一起去旅行之后，那里就一直空着。"
                                                },
                                                {
                                                    "id": "741850119",
                                                    "speaker": "埃斯特",
                                                    "text": "如果你们不嫌弃的话，就把它寄养在这里吧。"
                                                },
                                                {
                                                    "id": "741850120",
                                                    "speaker": "埃斯特",
                                                    "text": "虽然不知道为什么，但我们好像有着特殊的缘分，我会帮你们好好照顾它的。"
                                                },
                                                {
                                                    "id": "741850121",
                                                    "speaker": "埃斯特",
                                                    "text": "猫舍的话就在楼的另一边，你们过去就能看到了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741850116",
                                            "text": "它是我们的伙伴。",
                                            "response": [
                                                {
                                                    "id": "741850117",
                                                    "speaker": "派蒙",
                                                    "text": "虽然是这样啦，不过我们也没办法带着它一起旅行…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741850109",
                            "text": "这个不重要。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418502",
            "objective": "前往猫舍安置小呜斯",
            "dialogues": [
                {
                    "id": "741850201",
                    "speaker": "埃斯特",
                    "text": "猫舍的话就在楼的另一边，你们过去就能看到了。"
                }
            ]
        },
        {
            "id": "7418503",
            "objective": "前往猫舍安置小呜斯",
            "dialogues": [
                {
                    "id": "741850301",
                    "speaker": "派蒙",
                    "text": "嘿嘿，「小呜斯」，以后这里就是你的家啦！"
                },
                {
                    "id": "741850302",
                    "speaker": "小呜斯",
                    "text": "呜喵？"
                },
                {
                    "id": "741850303",
                    "speaker": "派蒙",
                    "text": "不过还是感觉有点奇怪呢，卡西奥多应该已经离开这里了没错吧，那现在的「小呜斯」又是谁呢？"
                },
                {
                    "id": "741850304",
                    "speaker": "派蒙",
                    "text": "是原来那只没被卡西奥多凭依的猫，还是和我们一起经历了冒险的呜斯先生呢…唔，脑子乱乱的。",
                    "choices": [
                        {
                            "id": "741850305",
                            "text": "派蒙不适合思考这种问题。",
                            "response": [
                                {
                                    "id": "741850306",
                                    "speaker": "派蒙",
                                    "text": "我是完全搞不明白啦…"
                                },
                                {
                                    "id": "741850309",
                                    "speaker": "派蒙",
                                    "text": "总之，也给小呜斯找到了新家。以后有时间的话，我们也可以经常来找小呜斯一起玩呢！"
                                },
                                {
                                    "id": "741850310",
                                    "speaker": "小呜斯",
                                    "text": "喵呜！"
                                }
                            ]
                        },
                        {
                            "id": "741850307",
                            "text": "「小呜斯」就是「小呜斯」。",
                            "response": [
                                {
                                    "id": "741850308",
                                    "speaker": "派蒙",
                                    "text": "虽然搞不懂，但是也很有道理呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}