    "talks": [
        {
            "id": "201501",
            "objective": "与珊瑚宫心海对话",
            "dialogues": [
                {
                    "id": "20150101",
                    "speaker": "珊瑚宫心海",
                    "text": "#{NICKNAME}，哲平的情况还好吗？",
                    "choices": [
                        {
                            "id": "20150102",
                            "text": "我们都没有注意到…",
                            "response": [
                                {
                                    "id": "20150104",
                                    "speaker": "珊瑚宫心海",
                                    "text": "…我已经下令，在军队中收缴所有邪眼。"
                                },
                                {
                                    "id": "20150105",
                                    "speaker": "珊瑚宫心海",
                                    "text": "绝大部分的人，虽然出现了生命力流失的现象，但情况还不严重。"
                                },
                                {
                                    "id": "20150106",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但也有少部分人…"
                                },
                                {
                                    "id": "20150107",
                                    "speaker": "五郎",
                                    "text": "珊瑚宫大人，我打算单独开一个伤兵营，观察他们的情况。"
                                },
                                {
                                    "id": "20150108",
                                    "speaker": "五郎",
                                    "text": "将士们闹得很厉害，明知是邪眼，他们也打算用下去。"
                                },
                                {
                                    "id": "20150109",
                                    "speaker": "珊瑚宫心海",
                                    "text": "此事交给你来负责，我必须要去一趟前线。"
                                },
                                {
                                    "id": "20150110",
                                    "speaker": "珊瑚宫心海",
                                    "text": "出了这么大的事情，军心一定会有所动摇。如果幕府军趁乱进攻，就功亏一篑了。"
                                },
                                {
                                    "id": "20150111",
                                    "speaker": "珊瑚宫心海",
                                    "text": "#{NICKNAME}，你有什么打算吗？"
                                },
                                {
                                    "id": "20150112",
                                    "speaker": "Player",
                                    "text": "去阻止愚人众的计划。"
                                },
                                {
                                    "id": "20150113",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不行，太危险了！"
                                },
                                {
                                    "id": "20150114",
                                    "speaker": "珊瑚宫心海",
                                    "text": "锁国令还在继续，他们的邪眼应该是在稻妻生产的。"
                                },
                                {
                                    "id": "20150115",
                                    "speaker": "珊瑚宫心海",
                                    "text": "能够调动如此庞大的人力物力，背后必有本土势力支持。"
                                },
                                {
                                    "id": "20150116",
                                    "speaker": "珊瑚宫心海",
                                    "text": "想要阻止他们，就只能捣毁他们生产邪眼的工厂。但那里一定有重兵把守…"
                                },
                                {
                                    "id": "20150117",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不能让你冒这样的风险，至少带着军队一起…"
                                },
                                {
                                    "id": "20150118",
                                    "speaker": "Player",
                                    "text": "没时间了。"
                                },
                                {
                                    "id": "20150119",
                                    "speaker": "五郎",
                                    "text": "珊瑚宫大人，我们收缴邪眼的时候很匆忙，应该瞒不过愚人众的眼线。"
                                },
                                {
                                    "id": "20150120",
                                    "speaker": "五郎",
                                    "text": "如果我们再花时间整顿军队，他们听到风声，一定会提前逃走。"
                                },
                                {
                                    "id": "20150121",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我知道…让我想想…"
                                },
                                {
                                    "id": "20150122",
                                    "speaker": "珊瑚宫心海",
                                    "text": "在收缴邪眼的时候，我确实想过。工厂既要庞大，又必须隐蔽，还要邻近交通要道，保证原材料供应…"
                                },
                                {
                                    "id": "20150123",
                                    "speaker": "珊瑚宫心海",
                                    "text": "符合这些条件的地方不多，再结合士兵们收到邪眼的地点推断，工厂很可能是在<color=#00E1FFFF>八酝岛</color>西南部的临海山崖。"
                                },
                                {
                                    "id": "20150124",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我不会阻止你，但你一定要小心。"
                                },
                                {
                                    "id": "20150125",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我们失去了很多曾并肩作战的人，不想再失去你了。"
                                },
                                {
                                    "id": "20150126",
                                    "speaker": "Player",
                                    "text": "我们也走吧。"
                                },
                                {
                                    "id": "20150127",
                                    "speaker": "派蒙",
                                    "text": "欸？要去那个<color=#00E1FFFF>邪眼工厂</color>吗？"
                                },
                                {
                                    "id": "20150128",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "20150129",
                                    "speaker": "派蒙",
                                    "text": "真的吗？真的不再考虑一下吗？好吧…"
                                }
                            ]
                        },
                        {
                            "id": "20150103",
                            "text": "情况是突然恶化的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201502",
            "objective": "寻找邪眼的制造地点",
            "dialogues": []
        },
        {
            "id": "201503",
            "objective": "进入邪眼生产工厂",
            "dialogues": []
        },
        {
            "id": "201504",
            "objective": "找出工厂内的幕后黑手",
            "dialogues": [
                {
                    "id": "20150401",
                    "speaker": "「散兵」",
                    "text": "没想到你们能找到这里来，做得不错嘛。"
                },
                {
                    "id": "20150402",
                    "speaker": "「散兵」",
                    "text": "有趣。才见面，就是一副要找我拼命的样子了。",
                    "choices": [
                        {
                            "id": "20150403",
                            "text": "你们制造邪眼…",
                            "response": [
                                {
                                    "id": "20150405",
                                    "speaker": "「散兵」",
                                    "text": "噢，原来是说这件事。"
                                },
                                {
                                    "id": "20150406",
                                    "speaker": "「散兵」",
                                    "text": "你们似乎搞错了一点。我虽然站在这里，但也只是代为执行计划而已。"
                                },
                                {
                                    "id": "20150407",
                                    "speaker": "「散兵」",
                                    "text": "主谋当然另有其人了。不是很能干吗？尽情去找吧！"
                                },
                                {
                                    "id": "20150408",
                                    "speaker": "「散兵」",
                                    "text": "才这点「小事」就被激怒了？你好像变了嘛…变得不堪一击。"
                                },
                                {
                                    "id": "20150409",
                                    "speaker": "派蒙",
                                    "text": "你竟然说这是小事…"
                                },
                                {
                                    "id": "20150410",
                                    "speaker": "「散兵」",
                                    "text": "难道不是吗？在这浮世之中，人命如同草芥一般。"
                                },
                                {
                                    "id": "20150411",
                                    "speaker": "「散兵」",
                                    "text": "没有邪眼，他们也一样会死。至少，邪眼还给了他们实现「愿望」的机会。"
                                },
                                {
                                    "id": "20150412",
                                    "speaker": "「散兵」",
                                    "text": "眼狩令的价值，你们真的了解吗？当初促成这件事花了不小的力气，自然是因为它有利于我们。"
                                },
                                {
                                    "id": "20150413",
                                    "speaker": "「散兵」",
                                    "text": "不过现在看来，一切都很值得。制造纷争，为推广邪眼铺路，让力量自行吸引追寻它的弱者…"
                                },
                                {
                                    "id": "20150414",
                                    "speaker": "「散兵」",
                                    "text": "只需要一点点代价，就能得到掌握世界的感觉。用性命换取无上之力，挺划算的不是吗？"
                                },
                                {
                                    "id": "20150415",
                                    "speaker": "派蒙",
                                    "text": "眼狩令是你们促成的？难道说，你们从一开始就…"
                                },
                                {
                                    "id": "20150416",
                                    "speaker": "「散兵」",
                                    "text": "稻妻的外侧看起来十分稳固，但内侧…充满了留给我们的机会。稍加力气，就能从内部攻破。"
                                },
                                {
                                    "id": "20150417",
                                    "speaker": "「散兵」",
                                    "text": "永恒可以把时间拉得很长，然而，其间每一个节点都会变得无比脆弱。"
                                },
                                {
                                    "id": "20150418",
                                    "speaker": "「散兵」",
                                    "text": "就像你在反抗军的朋友一样，无论怎么努力，都不过是徒劳。"
                                },
                                {
                                    "id": "20150419",
                                    "speaker": "「散兵」",
                                    "text": "如同水中泡影，绚烂的同时，便会迎来毁灭。"
                                },
                                {
                                    "id": "20150420",
                                    "speaker": "「散兵」",
                                    "text": "越是失去就越想得到，越是无能就越要挣扎！哈哈哈，这种闹剧真让人开心啊。",
                                    "choices": [
                                        {
                                            "id": "20150421",
                                            "text": "哲平他…",
                                            "response": [
                                                {
                                                    "id": "20150423",
                                                    "speaker": "派蒙",
                                                    "text": "#喂！{NICKNAME}，快冷静下来——"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20150422",
                                            "text": "他才不是无能之人！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20150404",
                            "text": "你们把邪眼分发给反抗军…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201505",
            "objective": "找出工厂内的幕后黑手",
            "dialogues": []
        },
        {
            "id": "201505",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20150502",
                    "speaker": "派蒙",
                    "text": "你是愚人众的执行官…跟「女士」「公子」他们一样吗？"
                },
                {
                    "id": "20150503",
                    "speaker": "「散兵」",
                    "text": "「女士」？「公子」？哦…没想到你已经见过我们最不可靠的两位同事了。"
                },
                {
                    "id": "20150504",
                    "speaker": "「散兵」",
                    "text": "愚人众执行官第六席，「散兵」。很高兴见到你，大名鼎鼎的旅行者。"
                },
                {
                    "id": "20150505",
