    "talks": [
        {
            "id": "7002301",
            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700230101",
                    "speaker": "勤劳的丘丘人",
                    "text": "Ya!"
                },
                {
                    "id": "700230102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi ika yaya nye! Mimi tomo, mimi mani ye."
                },
                {
                    "id": "700230103",
                    "speaker": "勤劳的丘丘人",
                    "text": "Mani. Mi muhe mani. Unu du mani! Hahahahaha."
                },
                {
                    "id": "700230104",
                    "speaker": "艾拉·马斯克",
                    "text": "这家伙讲了一个丘丘人语言的笑话，把自己乐到了。它们精神太贫瘠了，看着真可怜。"
                },
                {
                    "id": "700230105",
                    "speaker": "勤劳的丘丘人",
                    "text": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!"
                },
                {
                    "id": "700230106",
                    "speaker": "艾拉·马斯克",
                    "text": "它想要…唔…不管了，只要查看我的手册就能找到的！"
                }
            ]
        },
        {
            "id": "7002302",
            "objective": "向丘丘人交付物品",
            "dialogues": [
                {
                    "id": "700230301",
                    "speaker": "勤劳的丘丘人",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700230302",
                    "speaker": "勤劳的丘丘人",
                    "text": "Hahahaha, kucha gusha unu gusha. Unu kucha si!"
                },
                {
                    "id": "700230303",
                    "speaker": "勤劳的丘丘人",
                    "text": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>！"
                },
                {
                    "id": "700230304",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>Mosi aba nunu</color>…手册上有写这句话的含义吗…？",
                    "choices": [
                        {
                            "id": "700230305",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700230307",
                                    "speaker": "勤劳的丘丘人",
                                    "text": "Valo, mi tomo!"
                                }
                            ]
                        },
                        {
                            "id": "700230306",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002303",
            "objective": "（test）成功交付$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7002304",
            "objective": "（test）失败交付回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "700230401",
                    "speaker": "勤劳的丘丘人",
                    "text": "Nye nye nye. Kucha, gusha. Hahahaha. Kucha gusha, kucha, gusha. Hahaha."
                },
                {
                    "id": "700230402",
                    "speaker": "派蒙",
                    "text": "似乎不对。"
                },
                {
                    "id": "700230403",
                    "speaker": "Player",
                    "text": "（但它笑的好开心…）"
                }
            ]
        },
        {
            "id": "7002302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700230201",
                    "speaker": "勤劳的丘丘人",
                    "text": "Mi muhe unu boya gusha."
                },
                {
                    "id": "700230202",
                    "speaker": "Player",
                    "text": "（是这个吗？）"
                }
            ]
        },
        {
