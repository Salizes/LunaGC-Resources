    "talks": [
        {
            "id": "7303401",
            "objective": "前往柯莱在化城郭的居所$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7303402",
            "objective": "翻阅桌上的书$HIDDEN",
            "dialogues": [
                {
                    "id": "730340201",
                    "speaker": "派蒙",
                    "text": "唔？你在看什么呢？"
                },
                {
                    "id": "730340202",
                    "speaker": "Player",
                    "text": "这笔记本里写着照顾花的方法。"
                },
                {
                    "id": "730340203",
                    "speaker": "派蒙",
                    "text": "真的吗？我也看看…"
                },
                {
                    "id": "730340204",
                    "speaker": "派蒙",
                    "text": "「…需要安置于开阔地带，多接受日照…」"
                },
                {
                    "id": "730340205",
                    "speaker": "派蒙",
                    "text": "柯莱应该是没来得及把它给搬出去吧…"
                },
                {
                    "id": "730340206",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那我们来帮柯莱照顾一下这盆花吧。"
                },
                {
                    "id": "730340207",
                    "speaker": "派蒙",
                    "text": "唔…总之，先把这盆花搬出去，就放在屋子旁边吧。"
                },
                {
                    "id": "730340208",
                    "speaker": "派蒙",
                    "text": "也别放太远了，不然柯莱回来找不到的话该着急了。"
                }
            ]
        },
        {
            "id": "7303403",
            "objective": "搬运植物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7303404",
            "objective": "搬运植物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7303407",
            "objective": "等到第二天$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7303405",
            "objective": "前往柯莱住所$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7303406",
            "objective": "去四周看看$HIDDEN",
            "dialogues": [
                {
                    "id": "730340601",
                    "speaker": "派蒙",
                    "text": "咦？这封信…看起来好像是柯莱留下的，我们去看看吧。"
                },
                {
                    "id": "730340602",
                    "speaker": "Player",
                    "text": "但她人怎么还是不在…"
                },
                {
                    "id": "730340603",
                    "speaker": "派蒙",
                    "text": "也许又是和提纳里一起出去工作了吧，他们一直都很忙的样子。"
                },
                {
                    "id": "730340604",
                    "speaker": "派蒙",
                    "text": "还是快看看信吧。看这笔迹，柯莱下笔的时候可真用力呀…"
                },
                {
                    "id": "730340605",
                    "speaker": "派蒙",
                    "text": "#「{NICKNAME}和派蒙，谢谢你们帮我照料这盆花。」"
                },
                {
                    "id": "730340606",
                    "speaker": "派蒙",
                    "text": "「这段时间林子里有太多事要处理，我一忙起来就会忘记打理…」"
                },
                {
                    "id": "730340607",
                    "speaker": "派蒙",
                    "text": "「再次谢谢你们帮忙，等我有空了，我们一起去贾汉吉尔先生的店里吃『土豆船』吧！」"
                },
                {
                    "id": "730340608",
                    "speaker": "派蒙",
                    "text": "喔！你看，柯莱说要请我们吃好吃的！记下来记下来。"
                },
                {
                    "id": "730340609",
                    "speaker": "派蒙",
                    "text": "就是不知道柯莱到底在处理什么事，感觉她都要忙不过来了。"
                },
                {
                    "id": "730340610",
                    "speaker": "派蒙",
                    "text": "希望她能好好休息，别累坏了…"
                }
            ]
        },
        {
            "id": "7303499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730349904",
                    "speaker": "派蒙",
                    "text": "这样就好了，就让这盆花在这里好好地成长吧。"
                },
                {
                    "id": "730349905",
                    "speaker": "派蒙",
                    "text": "唔…我们再给柯莱留封信，告诉她是我们把这盆花搬出来的吧。"
                },
                {
                    "id": "730349906",
                    "speaker": "派蒙",
                    "text": "不然，说不定她会误会成有小偷闯空门了。"
                }
            ]
        }
    ]
}