    "talks": [
        {
            "id": "4014301",
            "objective": "查看望舒客栈外的告示",
            "dialogues": [
                {
                    "id": "401430101",
                    "speaker": "派蒙",
                    "text": "「招聘启事…望舒客栈现高薪急聘临时厨师一位，待遇从优，酬劳面议…」"
                },
                {
                    "id": "401430102",
                    "speaker": "派蒙",
                    "text": "#——{NICKNAME}！你看你看，高薪急聘！有赚钱的机会！"
                },
                {
                    "id": "401430103",
                    "speaker": "Player",
                    "text": "望舒客栈怎么会突然招厨师？"
                },
                {
                    "id": "401430104",
                    "speaker": "派蒙",
                    "text": "欸…你说的对哦，不会是言笑出什么事了吧？那家伙连别人随便进厨房都要训一顿…不像是会招人来帮工的啊？"
                },
                {
                    "id": "401430105",
                    "speaker": "派蒙",
                    "text": "告示后面好像还有…「有意者请移步楼上与掌柜淮安详谈…」要不我们也上去看看？",
                    "choices": [
                        {
                            "id": "401430106",
                            "text": "你是想去问问言笑的情况吗？",
                            "response": [
                                {
                                    "id": "401430107",
                                    "speaker": "派蒙",
                                    "text": "嗯——顺便也去问问酬劳有多少！"
                                }
                            ]
                        },
                        {
                            "id": "401430108",
                            "text": "你是想去问问酬劳有多少吧。",
                            "response": [
                                {
                                    "id": "401430109",
                                    "speaker": "派蒙",
                                    "text": "…顺、顺便也能关心一下言笑嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014302",
            "objective": "向望舒客栈掌柜淮安询问详情",
            "dialogues": [
                {
                    "id": "401430201",
                    "speaker": "言笑",
                    "text": "…掌柜的，真没必要。不过是烫着手而已，也不耽误我做菜呀。"
                },
                {
                    "id": "401430202",
                    "speaker": "淮安",
                    "text": "就算现在不耽误做菜，也耽误你痊愈啊。这几天你先歇着，我们来想办法…"
                },
                {
                    "id": "401430203",
                    "speaker": "派蒙",
                    "text": "嘿，掌柜的！还有言笑！"
                },
                {
                    "id": "401430204",
                    "speaker": "淮安",
                    "text": "#嗯？是{NICKNAME}和派蒙啊！什么风把你俩给吹来了？"
                },
                {
                    "id": "401430205",
                    "speaker": "Player",
                    "text": "我们在楼下看到了招聘启事…"
                },
                {
                    "id": "401430206",
                    "speaker": "派蒙",
                    "text": "然后就想上来…上来问问言笑怎么了！"
                },
                {
                    "id": "401430207",
                    "speaker": "言笑",
                    "text": "唉！我就说不该贴那张告示，居然连你们也开始担心了…多大点事啊…"
                },
                {
                    "id": "401430208",
                    "speaker": "淮安",
                    "text": "哈哈，两位能有这份心，我先替言笑谢过了。欸，你也别不好意思了，就跟他们说说呗？"
                },
                {
                    "id": "401430209",
                    "speaker": "言笑",
                    "text": "行吧…其实就是前阵子过海灯节，来的客人太多。起锅的时候有点心急，不小心烫着了手…"
                },
                {
                    "id": "401430210",
                    "speaker": "Player",
                    "text": "没想到言笑也会犯这种错…"
                },
                {
                    "id": "401430211",
                    "speaker": "言笑",
                    "text": "咳！常在河边走，哪能不湿鞋嘛。再好的厨子也总有失手的时候！况且这点小伤，根本不碍事…"
                },
                {
                    "id": "401430212",
                    "speaker": "淮安",
                    "text": "你可别逞强了，到时候伤势要是更重，就不是休养一天两天的事了！"
                },
                {
                    "id": "401430213",
                    "speaker": "言笑",
                    "text": "可这海灯节过去没多久，店里的客人那么多，还不是休息的时候吧。"
                },
                {
                    "id": "401430214",
                    "speaker": "言笑",
                    "text": "客人里头还有不少远道而来的外宾，这要是随便找个厨子应付，万一砸了我们客栈的招牌…我第一个不答应！"
                },
                {
                    "id": "401430215",
                    "speaker": "淮安",
                    "text": "瞧你这话说的，都不知道谁是掌柜了…"
                },
                {
                    "id": "401430216",
                    "speaker": "淮安",
                    "text": "不过他说的也在理，言笑怎么说也是当初「厨王争霸赛」的种子选手，随便找个厨师，还真不好代班。"
                },
                {
                    "id": "401430217",
                    "speaker": "言笑",
                    "text": "也不是我自夸，这种水平的厨师，应该都有自己的生意要照顾吧？能抽出空来客栈帮忙的，怕是不好找。"
                },
                {
                    "id": "401430218",
                    "speaker": "淮安",
                    "text": "唉，看来还得再提高一点报酬…"
                },
                {
                    "id": "401430219",
                    "speaker": "派蒙",
                    "text": "唔…厨艺很好、又有时间的人…",
                    "choices": [
                        {
                            "id": "401430220",
                            "text": "远在天边。",
                            "response": [
                                {
                                    "id": "401430222",
                                    "speaker": "派蒙",
                                    "text": "啊——不就是你吗！"
                                },
                                {
                                    "id": "401430223",
                                    "speaker": "淮安",
                                    "text": "对呀，仔细一想，之前是有听说过…当时只记着你身手了得，都忘了你还有这手厨艺了。"
                                },
                                {
                                    "id": "401430224",
                                    "speaker": "派蒙",
                                    "text": "不记得厨艺只记得身手…这是客栈掌柜该记的吗？"
                                },
                                {
                                    "id": "401430225",
                                    "speaker": "淮安",
                                    "text": "哈，不用在意细节。总之，你要是愿意来的话，言笑应该也能放心把厨房交给你吧？你说是吧？"
                                },
                                {
                                    "id": "401430226",
                                    "speaker": "言笑",
                                    "text": "#这…如果是{NICKNAME}的话…唉，确实，总比交给其他人要好。"
                                },
                                {
                                    "id": "401430227",
                                    "speaker": "派蒙",
                                    "text": "#那，{NICKNAME}，我们要接下这份工作吗？",
                                    "choices": [
                                        {
                                            "id": "401430228",
                                            "text": "掌柜刚才说提高报酬…",
                                            "response": [
                                                {
                                                    "id": "401430229",
                                                    "speaker": "淮安",
                                                    "text": "哈哈，说话算话，一言为定。这酬劳绝对少不了你的！"
                                                },
                                                {
                                                    "id": "401430231",
                                                    "speaker": "言笑",
                                                    "text": "不过我还是要提一句，在客栈里掌勺，跟自己做饭可不一样。这几天，我也会留在厨房里帮你熟悉工作的。"
                                                },
                                                {
                                                    "id": "401430232",
                                                    "speaker": "派蒙",
                                                    "text": "结果还是放心不下嘛。"
                                                },
                                                {
                                                    "id": "401430233",
                                                    "speaker": "言笑",
                                                    "text": "掌柜的，记得店里应该还有一些闲置的厨具，你看…"
                                                },
                                                {
                                                    "id": "401430234",
                                                    "speaker": "淮安",
                                                    "text": "哦，好说好说，我这就去准备！"
                                                },
                                                {
                                                    "id": "401430235",
                                                    "speaker": "Black Screen",
                                                    "text": ""
                                                },
                                                {
                                                    "id": "401430236",
                                                    "speaker": "淮安",
                                                    "text": "呼——完工了。快来看看，这可是为你量身打造的！"
                                                },
                                                {
                                                    "id": "401430237",
                                                    "speaker": "Player",
                                                    "text": "掌柜的，你这木工…"
                                                },
                                                {
                                                    "id": "401430238",
                                                    "speaker": "淮安",
                                                    "text": "哎呀，一点点小手艺，不值一提，不值一提。那言笑，这里就先交给你们了。"
                                                },
                                                {
                                                    "id": "401430239",
                                                    "speaker": "派蒙",
                                                    "text": "居然这么大动干戈…就不能直接用现成的灶台吗？你是有多不想让别人碰你的厨具啊…"
                                                },
                                                {
                                                    "id": "401430240",
                                                    "speaker": "言笑",
                                                    "text": "欸，哪有的事，老板说过，用人不疑，疑人不用。我只是觉得原先的灶台对你来说…呃…有点高了。",
                                                    "choices": [
                                                        {
                                                            "id": "401430241",
                                                            "text": "是你看谁都觉得矮吧…",
                                                            "response": [
                                                                {
                                                                    "id": "401430243",
                                                                    "speaker": "言笑",
                                                                    "text": "咳咳——之前不也说了吗，在客栈掌勺跟给自己做菜不同，既要讲究色、香、味，也要讲究快、准、稳！"
                                                                },
                                                                {
                                                                    "id": "401430244",
                                                                    "speaker": "言笑",
                                                                    "text": "用不合适的灶台做一天菜，累得手酸背疼不说，出菜的效率一慢，外头的客人也要不耐烦。"
                                                                },
                                                                {
                                                                    "id": "401430245",
                                                                    "speaker": "言笑",
                                                                    "text": "所以做菜的家伙事，一定要准备妥当——这就是「快」！"
                                                                },
                                                                {
                                                                    "id": "401430246",
                                                                    "speaker": "派蒙",
                                                                    "text": "那「准」跟「稳」又是什么啊？"
                                                                },
                                                                {
                                                                    "id": "401430247",
                                                                    "speaker": "言笑",
                                                                    "text": "嘿，所谓「准」，就是放亮眼睛，一块肉从哪里下刀、一勺油舀起多少、一锅菜要到什么时候起锅…"
                                                                },
                                                                {
                                                                    "id": "401430248",
                                                                    "speaker": "言笑",
                                                                    "text": "给自己做菜的时候，可以水多了加盐、盐多了加水，看情况调味，但客栈里可没那么多机会试错。"
                                                                },
                                                                {
                                                                    "id": "401430249",
                                                                    "speaker": "Player",
                                                                    "text": "这我还算有自信。"
                                                                },
                                                                {
                                                                    "id": "401430250",
                                                                    "speaker": "派蒙",
                                                                    "text": "万一真做糟了，就交给我来解决掉吧！嘿嘿！"
                                                                },
                                                                {
                                                                    "id": "401430251",
                                                                    "speaker": "言笑",
                                                                    "text": "最后的「稳」，是说不管多刁钻的要求，都要用最稳妥的手法实现。尤其是招待天南地北、口味迥异的客人…"
                                                                },
                                                                {
                                                                    "id": "401430252",
                                                                    "speaker": "言笑",
                                                                    "text": "既要照顾他们原本的饮食习惯，又要考虑到他们想尝试本地特色的心情…"
                                                                },
                                                                {
                                                                    "id": "401430253",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…这个倒是没那么好懂…"
                                                                },
                                                                {
                                                                    "id": "401430254",
                                                                    "speaker": "言笑",
                                                                    "text": "#不打紧，{NICKNAME}走南闯北见得多了，实际应付起来，估计只会比我更得心应手。"
                                                                },
                                                                {
                                                                    "id": "401430255",
                                                                    "speaker": "言笑",
                                                                    "text": "何况这几天，我也会留在后厨支援你们。一定能让每个客人，都觉着「宾至如归」！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401430242",
                                                            "text": "对我来说也不算碍事。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401430230",
                                            "text": "难得见言笑让出厨房…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401430221",
                            "text": "近在眼前。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014308",
            "objective": "【隐藏】用来切场景用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4014303",
            "objective": "与言笑对话开始工作",
            "dialogues": [
                {
                    "id": "401430301",
                    "speaker": "言笑",
                    "text": "事不宜迟，直接来试试吧。基本的烹饪应该不用我多嘴。要注意的无非就是每桌不同的需求，不要记混了。"
                },
                {
                    "id": "401430302",
                    "speaker": "派蒙",
                    "text": "嘿嘿，还有我帮着记呢！你就放一百个心吧！"
                },
                {
                    "id": "401430303",
                    "speaker": "Black Screen",
                    "text": "一天过去…"
                },
                {
                    "id": "401430304",
                    "speaker": "派蒙",
                    "text": "呃…到几号桌了…一号桌的客人要葱不要辣，二号桌的要辣不要葱…三号桌…三号桌要辣不要辣…",
                    "choices": [
                        {
                            "id": "401430305",
                            "text": "客人都吃完了…",
                            "response": [
                                {
                                    "id": "401430307",
                                    "speaker": "派蒙",
                                    "text": "…欸！我、我刚刚是在梦游吗？"
                                },
                                {
                                    "id": "401430308",
                                    "speaker": "Player",
                                    "text": "你从中途开始就在说胡话了。"
                                },
                                {
                                    "id": "401430309",
                                    "speaker": "派蒙",
                                    "text": "呜…中间连休息的时间都没有，我的脑子都快变成浆糊了。你们客栈平时有这么多人吗？"
                                },
                                {
                                    "id": "401430310",
                                    "speaker": "言笑",
                                    "text": "最近还在旺季嘛，你们这是头一次在店里掌勺吧，已经做得很不错了。"
                                },
                                {
                                    "id": "401430311",
                                    "speaker": "言笑",
                                    "text": "不过还好这次来的都是熟面孔，也没有提什么偏门的需求，不然怕是会更麻烦。"
                                },
                                {
                                    "id": "401430312",
                                    "speaker": "派蒙",
                                    "text": "这些需求还不算偏吗！杏仁豆腐上面居然要淋一勺酱油，连我都没这么吃过！"
                                },
                                {
                                    "id": "401430313",
                                    "speaker": "言笑",
                                    "text": "哈哈，天下那么大，每个人的口味都不一样，能包容一切，才是璃月菜的精髓嘛。"
                                },
                                {
                                    "id": "401430314",
                                    "speaker": "言笑",
                                    "text": "况且这些客人的要求都很明确，只要顺着思路去做就不会跑偏，真正麻烦的，还是那些让你看着办的客人…"
                                },
                                {
                                    "id": "401430315",
                                    "speaker": "？？？",
                                    "text": "请问…已经打烊了吗？"
                                },
                                {
                                    "id": "401430316",
                                    "speaker": "派蒙",
                                    "text": "咦？这个声音是…我去看看！"
                                },
                                {
                                    "id": "401430317",
                                    "speaker": "菲米尼",
                                    "text": "怎么办…好像真的没人…要是我能早点过来…"
                                },
                                {
                                    "id": "401430318",
                                    "speaker": "林尼",
                                    "text": "没事的，现在开始准备野炊，应该也还来得及。"
                                },
                                {
                                    "id": "401430319",
                                    "speaker": "琳妮特",
                                    "text": "是啊，而且要怪也只能怪哥哥一「采风」就忘了时间…"
                                },
                                {
                                    "id": "401430320",
                                    "speaker": "派蒙",
                                    "text": "啊！林尼、琳妮特、菲米尼，还真是你们！"
                                },
                                {
                                    "id": "401430321",
                                    "speaker": "菲米尼",
                                    "text": "#派蒙？那…难道{NICKNAME}也…"
                                },
                                {
                                    "id": "401430322",
                                    "speaker": "Player",
                                    "text": "你们好。"
                                },
                                {
                                    "id": "401430323",
                                    "speaker": "林尼",
                                    "text": "#{NICKNAME}，派蒙！真没想到会在这里看见你们！"
                                },
                                {
                                    "id": "401430324",
                                    "speaker": "派蒙",
                                    "text": "#我刚想说这句话呢，我跟{NICKNAME}是在这里帮忙啦…"
                                },
                                {
                                    "id": "401430325",
                                    "speaker": "Black Screen",
                                    "text": "你们向三人说明了原委…"
                                },
                                {
                                    "id": "401430326",
                                    "speaker": "派蒙",
                                    "text": "情况就是这样…倒是你们，怎么会来这里？你们的…呃…「父亲」不会又给你们派了什么任务吧？"
                                },
                                {
                                    "id": "401430327",
                                    "speaker": "林尼",
                                    "text": "恰恰相反，我们是来璃月度假的，嗯…顺便到处「采风」。"
                                },
                                {
                                    "id": "401430328",
                                    "speaker": "菲米尼",
                                    "text": "「父亲」说…前阵子我们忙了那么久，也是时候休息一下了，不然不利于下次任务…"
                                },
                                {
                                    "id": "401430329",
                                    "speaker": "琳妮特",
                                    "text": "机会难得，加上前阵子又是海灯节，哥哥就带着我们来璃月玩了。"
                                },
                                {
                                    "id": "401430330",
                                    "speaker": "Player",
                                    "text": "那林尼说的「采风」是？"
                                },
                                {
                                    "id": "401430331",
                                    "speaker": "林尼",
                                    "text": "我们在璃月港里看到了不少有趣的魔术…哦，在璃月，应该叫它们「戏法」？"
                                },
                                {
                                    "id": "401430332",
                                    "speaker": "菲米尼",
                                    "text": "还有人把「戏法」跟「璃月戏」、「舞兽戏」结合在一起…真的很精彩。"
                                },
                                {
                                    "id": "401430333",
                                    "speaker": "林尼",
                                    "text": "所以，我们就想在这儿多留几天，看看能不能多收集一些灵感。"
                                },
                                {
                                    "id": "401430334",
                                    "speaker": "林尼",
                                    "text": "之前还去轻策庄拜访了若心婆婆，今天也在附近采风…"
                                },
                                {
                                    "id": "401430335",
                                    "speaker": "琳妮特",
                                    "text": "结果忘了时间，到现在都没吃上饭。"
                                },
                                {
                                    "id": "401430336",
                                    "speaker": "林尼",
                                    "text": "哈哈…说起吃饭，你也知道，枫丹和璃月都有不少水产，但处理它们的手法各有各的特色。"
                                },
                                {
                                    "id": "401430337",
                                    "speaker": "林尼",
                                    "text": "这回难得过来一趟，不多尝试一下可不行，这也是我们逗留那么久的理由之一吧。"
                                },
                                {
                                    "id": "401430338",
                                    "speaker": "派蒙",
                                    "text": "哦哦！那你们都吃了什么？要不要听听我的推荐呀！"
                                },
                                {
                                    "id": "401430339",
                                    "speaker": "琳妮特",
                                    "text": "…听名字完全不觉得辣的那个鱼。"
                                },
                                {
                                    "id": "401430340",
                                    "speaker": "派蒙",
                                    "text": "你说的难道是…「水煮黑背鲈」？头一次听名字是会有这种误解啦…"
                                },
                                {
                                    "id": "401430341",
                                    "speaker": "林尼",
                                    "text": "呵，当时琳妮特看着是鱼、闻着也香，毫无准备地吃了一口，结果被呛得一整天都说不出话。"
                                },
                                {
                                    "id": "401430342",
                                    "speaker": "菲米尼",
                                    "text": "还好她本来也不喜欢说话…"
                                },
                                {
                                    "id": "401430343",
                                    "speaker": "琳妮特",
                                    "text": "咕——"
                                },
                                {
                                    "id": "401430344",
                                    "speaker": "Player",
                                    "text": "（琳妮特，突然发出了夸张的声音…）"
                                },
                                {
                                    "id": "401430345",
                                    "speaker": "琳妮特",
                                    "text": "哥哥，菲米尼，你们肚子不饿吗。"
                                },
                                {
                                    "id": "401430346",
                                    "speaker": "菲米尼",
                                    "text": "…是、是有点饿了。"
                                },
                                {
                                    "id": "401430347",
                                    "speaker": "林尼",
                                    "text": "#哈…哈哈，说的也是。那{NICKNAME}，就拜托你下厨了。"
                                },
                                {
                                    "id": "401430348",
                                    "speaker": "Player",
                                    "text": "要来点什么呢？"
                                },
                                {
                                    "id": "401430349",
                                    "speaker": "林尼",
                                    "text": "光看菜单上的名字，也看不出什么…既然凑巧有你在，不如就由你来推荐吧。你也清楚我们的口味，不是么？"
                                },
                                {
                                    "id": "401430350",
                                    "speaker": "Player",
                                    "text": "…那我回后厨商量商量。"
                                },
                                {
                                    "id": "401430351",
                                    "speaker": "琳妮特",
                                    "text": "还有…请不要放辣，拜托了。"
                                }
                            ]
                        },
                        {
                            "id": "401430306",
                            "text": "你快清醒一下…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014307",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "401430401",
                    "speaker": "言笑",
                    "text": "…原来如此，从枫丹来的客人吗，难怪吃不惯重辣。但做得太清淡，又跟他们平时吃的区别不大…"
                },
                {
                    "id": "401430402",
                    "speaker": "Player",
                    "text": "你有什么推荐的菜吗？"
                },
                {
                    "id": "401430403",
                    "speaker": "言笑",
                    "text": "我想想啊…有一道用蟹粉跟虾仁炒制的菜，虽然看起来浓油重酱，但实际上口味不重，吃着满口都是鲜味！"
                },
                {
                    "id": "401430404",
                    "speaker": "派蒙",
                    "text": "哦哦，听起来很合适嘛！这道菜的名字叫什么？"
                },
                {
                    "id": "401430405",
                    "speaker": "言笑",
                    "text": "嘿，你算是问到点上了，菜谱上说这「蟹黄胜金，虾仁如玉」，所以这道菜的名字，就叫做「金玉满堂」！"
                },
                {
                    "id": "401430406",
                    "speaker": "Player",
                    "text": "光看名字还真看不出名堂…"
                },
                {
                    "id": "401430407",
                    "speaker": "言笑",
                    "text": "来，这是菜谱，等你做好准备，就上手试试吧。"
                }
            ]
        },
        {
            "id": "4014304",
            "objective": "烹制「金玉满堂」",
            "dialogues": []
        },
        {
            "id": "4014305",
            "objective": "为等待已久的枫丹一行人上菜",
            "dialogues": [
                {
                    "id": "401430501",
                    "speaker": "派蒙",
                    "text": "久等啦！请用——「金玉满堂」！"
                },
                {
                    "id": "401430502",
                    "speaker": "琳妮特",
                    "text": "……"
                },
                {
                    "id": "401430503",
                    "speaker": "菲米尼",
                    "text": "欸…"
                },
                {
                    "id": "401430504",
                    "speaker": "林尼",
                    "text": "#…啊，说起来{NICKNAME}跟派蒙也忙了一天吧，不如一起吃吧？"
                },
                {
                    "id": "401430505",
                    "speaker": "派蒙",
                    "text": "被你这么一说，肚子还真有点饿…嘿嘿，那就「恭敬不如从命」了！"
                },
                {
                    "id": "401430506",
                    "speaker": "Player",
                    "text": "不过第一筷还是由客人先动吧。"
                },
                {
                    "id": "401430507",
                    "speaker": "派蒙",
                    "text": "对、对哦，毕竟这次你们才是客人…嗯？你们怎么都不吃啊？"
                },
                {
                    "id": "401430508",
                    "speaker": "琳妮特",
                    "text": "（酱汁…看起来有点重…）"
                },
                {
                    "id": "401430509",
                    "speaker": "菲米尼",
                    "text": "（按璃月的餐桌礼仪…我是不是该先让一让…）"
                },
                {
                    "id": "401430510",
                    "speaker": "林尼",
                    "text": "#…咳，那么，就让我先来尝尝{NICKNAME}的手艺吧！嗯…"
                },
                {
                    "id": "401430511",
                    "speaker": "琳妮特",
                    "text": "怎么样？要喝点水吗？"
                },
                {
                    "id": "401430512",
                    "speaker": "林尼",
                    "text": "不用…很鲜，非常纯粹的味道。明明裹了一层酱汁，却只有海洋本身的鲜味…你们也尝尝？"
                },
                {
                    "id": "401430513",
                    "speaker": "菲米尼",
                    "text": "好、好的…"
                },
                {
                    "id": "401430514",
                    "speaker": "琳妮特",
                    "text": "这味道…难道是蟹黄？"
                },
                {
                    "id": "401430515",
                    "speaker": "派蒙",
                    "text": "答对咯！不愧是琳妮特！"
                },
                {
                    "id": "401430516",
                    "speaker": "林尼",
                    "text": "难怪能跟虾仁的味道融合得这么好，居然还有这种做法。"
                },
                {
                    "id": "401430517",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这道菜讲究「虾上加蟹，鲜上加鲜…虾仁之嫩滑，佐以蟹粉之沙糯，鲜香美味，口感绝佳！」"
                },
                {
                    "id": "401430518",
                    "speaker": "派蒙",
                    "text": "「更有蟹黄灿烂胜金，虾仁晶莹如玉…」这才有了「金玉满堂」的美名！"
                },
                {
                    "id": "401430519",
                    "speaker": "林尼",
                    "text": "这名字原来还有这种说法，确实是挺贴切的。"
                },
                {
                    "id": "401430520",
                    "speaker": "菲米尼",
                    "text": "奇怪…派蒙什么时候这么有学问了？",
                    "choices": [
                        {
                            "id": "401430521",
                            "text": "菜谱背得挺熟。",
                            "response": [
                                {
                                    "id": "401430523",
                                    "speaker": "林尼",
                                    "text": "这道菜应该挺对你胃口吧，琳妮特…嗯？"
                                },
                                {
                                    "id": "401430524",
                                    "speaker": "派蒙",
                                    "text": "啊！「金玉满堂」只剩一半了？什么时候被吃的！"
                                },
                                {
                                    "id": "401430525",
                                    "speaker": "Player",
                                    "text": "就在你滔滔不绝的时候…"
                                },
                                {
                                    "id": "401430526",
                                    "speaker": "琳妮特",
                                    "text": "我听说在璃月，食客对厨师最好的致意，就是多吃一点。非常美味，谢谢。"
                                },
                                {
                                    "id": "401430527",
                                    "speaker": "派蒙",
                                    "text": "啊——你们怎么都开始抢了…喂，给我留点！"
                                }
                            ]
                        },
                        {
                            "id": "401430522",
                            "text": "现学现卖罢了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014306",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "401430601",
                    "speaker": "言笑",
                    "text": "你的朋友还算满意吧？干得不错啊，上手才一天就有这水平。"
                },
                {
                    "id": "401430602",
                    "speaker": "言笑",
                    "text": "#下次也要看你的了，{NICKNAME}。"
                }
            ]
        },
        {
            "id": "4014393",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439301",
                    "speaker": "淮安",
                    "text": "#哟，{NICKNAME}，今年算是开了个好头呀。"
                }
            ]
        },
        {
            "id": "4014394",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439401",
                    "speaker": "林尼",
                    "text": "…琳妮特很少这么直白地表现出自己的喜好，这次居然会先下手为强…难道她也因你改变了吗…"
                },
                {
                    "id": "401439402",
                    "speaker": "林尼",
                    "text": "——哈哈，说不定只是因为你做的菜，实在太好吃了呢？"
                },
                {
                    "id": "401439403",
                    "speaker": "林尼",
                    "text": "下次如果在枫丹遇上，能请你给其他弟弟妹妹露一手吗，大烹饪师？",
                    "choices": [
                        {
                            "id": "401439404",
                            "text": "听大魔术师的。",
                            "response": [
                                {
                                    "id": "401439406",
                                    "speaker": "林尼",
                                    "text": "哦？那我可得早点开始预约了。"
                                }
                            ]
                        },
                        {
                            "id": "401439405",
                            "text": "有空再约就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014395",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439501",
                    "speaker": "言笑",
                    "text": "「蟹黄胜金，虾仁如玉」…写这菜谱的厨子还真会起名字。"
                }
            ]
        },
        {
            "id": "4014396",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439601",
                    "speaker": "菲米尼",
                    "text": "其实我觉得「水煮黑背鲈」还挺好吃的…"
                },
                {
                    "id": "401439602",
                    "speaker": "林尼",
                    "text": "只要做好心理准备，就不会被呛着了吧？下次要不要再试试？"
                },
                {
                    "id": "401439603",
                    "speaker": "琳妮特",
                    "text": "…不必了。"
                }
            ]
        },
        {
            "id": "4014397",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439701",
                    "speaker": "菲米尼",
                    "text": "筷子…终于能正常用上了。"
                },
                {
                    "id": "401439702",
                    "speaker": "Player",
                    "text": "你在练习吗，菲米尼？"
                },
                {
                    "id": "401439703",
                    "speaker": "菲米尼",
                    "text": "嗯，林尼和琳妮特的手都很巧，几乎一来璃月就适应了，不像我，最近才开始熟练…"
                },
                {
                    "id": "401439704",
                    "speaker": "菲米尼",
                    "text": "说起来璃月还有用碗筷表演的「戏法」…想做好魔术助理，这些练习也不能落下。"
                }
            ]
        },
        {
            "id": "4014398",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401439801",
                    "speaker": "琳妮特",
                    "text": "能量补充过多…进入消化模式。"
                },
                {
                    "id": "401439802",
                    "speaker": "Player",
                    "text": "难得见到你胃口这么好呢。"
                },
                {
                    "id": "401439803",
                    "speaker": "琳妮特",
                    "text": "嗯…虽然平时为了保持身形，我跟哥哥都不会吃太多。出于礼仪考虑，在餐桌上也会节制些。"
                },
                {
                    "id": "401439804",
                    "speaker": "琳妮特",
                    "text": "不过偶尔在家人面前任性一点，也没什么不好。"
                },
                {
                    "id": "401439805",
                    "speaker": "琳妮特",
                    "text": "…如果真的等哥哥跟菲米尼互相谦让完，估计菜已经凉了。"
                }
            ]
        }
    ]
}