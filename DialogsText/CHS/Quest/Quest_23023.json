{
    "quest": {
        "id": "23023",
        "title": "生不出的花",
        "description": "种植草药的瓦尔坦与古尔根父子正为某件麻烦事苦恼不已…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 50,
        "total_speaker_counts": {
