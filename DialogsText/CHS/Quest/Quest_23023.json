        }
    },
    "talks": [
        {
            "id": "2302301",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230230101",
                    "speaker": "古尔根",
                    "text": "这样下去可不行啊，爸，蔷薇的长势实在不行。"
                },
                {
                    "id": "230230102",
                    "speaker": "瓦尔坦",
                    "text": "得赶快想想办法，不然今年我们就没法按时交付所有草药了！"
                },
                {
                    "id": "230230103",
                    "speaker": "古尔根",
                    "text": "土壤没问题，杂草和害虫也都除了，这到底是怎么回事…"
                },
                {
                    "id": "230230104",
                    "speaker": "Player",
                    "text": "你们在发什么愁呢？"
                },
                {
                    "id": "230230105",
                    "speaker": "瓦尔坦",
                    "text": "嗯？你是来购买草药的客人吗？"
                },
                {
                    "id": "230230106",
                    "speaker": "瓦尔坦",
                    "text": "事情是这样的，每隔一段时间，我们都会向「健康之家」提供一批草药。"
                },
                {
                    "id": "230230107",
                    "speaker": "瓦尔坦",
                    "text": "其中最重要的就是这株特别的「须弥蔷薇」。"
                },
                {
                    "id": "230230108",
                    "speaker": "Player",
                    "text": "原来蔷薇也可以入药吗？"
                },
                {
                    "id": "230230109",
                    "speaker": "瓦尔坦",
                    "text": "这就要问「健康之家」的医生们了。"
                },
                {
                    "id": "230230110",
                    "speaker": "瓦尔坦",
                    "text": "反正他们说，这种蔷薇和其他药物搭配后可以治疗中暑，对胃病也有缓解的效果，还有一些其他的功效…我也记不清了…",
                    "choices": [
                        {
                            "id": "230230111",
                            "text": "既然如此，我会帮忙的。",
                            "response": [
                                {
                                    "id": "230230112",
                                    "speaker": "瓦尔坦",
                                    "text": "真是太感谢了！"
                                }
                            ]
                        },
                        {
                            "id": "230230113",
                            "text": "这一株蔷薇怎么了？",
                            "response": [
                                {
                                    "id": "230230114",
                                    "speaker": "瓦尔坦",
                                    "text": "不知道怎么回事，这株蔷薇生长得很缓慢。"
                                },
                                {
                                    "id": "230230115",
                                    "speaker": "瓦尔坦",
                                    "text": "按照我们以往的经验，出现这种情况，要么是土壤出了问题，要么就是有虫害。"
                                },
                                {
                                    "id": "230230116",
                                    "speaker": "瓦尔坦",
                                    "text": "不过，我们之前刚用这种土壤种了一批草药，那批草药的长势可好了。"
                                },
                                {
                                    "id": "230230117",
                                    "speaker": "古尔根",
                                    "text": "我们每天都会除虫，虫害更是谈不上…"
                                },
                                {
                                    "id": "230230118",
                                    "speaker": "古尔根",
                                    "text": "唉，不过现在也不能纠结这种问题，再拖下去，这一株蔷薇就不能按时交给「健康之家」了。"
                                },
                                {
                                    "id": "230230119",
                                    "speaker": "瓦尔坦",
                                    "text": "所以我们计划，总之先用特制的肥料给土壤增肥…"
                                },
                                {
                                    "id": "230230120",
                                    "speaker": "瓦尔坦",
                                    "text": "但我们两个人还要去打理其他药田，根本没空再去搜集制作肥料所需的材料。"
                                },
                                {
                                    "id": "230230121",
                                    "speaker": "瓦尔坦",
                                    "text": "旅行者，就算是为了「健康之家」的病人们…可以请你帮我们这个忙吗？"
                                },
                                {
                                    "id": "230230122",
                                    "speaker": "Player",
                                    "text": "我会帮忙的。"
                                },
                                {
                                    "id": "230230123",
                                    "speaker": "瓦尔坦",
                                    "text": "真是太感谢了！"
                                },
                                {
                                    "id": "230230124",
                                    "speaker": "瓦尔坦",
                                    "text": "让我看看现在的情况…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302302",
            "objective": "将3份「香辛果」交付给瓦尔坦",
            "dialogues": [
                {
                    "id": "230230201",
                    "speaker": "瓦尔坦",
                    "text": "我们需要不少特制的肥料。"
                },
                {
                    "id": "230230202",
                    "speaker": "瓦尔坦",
                    "text": "这种特制肥料的其他原料我们还有一些储备，但「香辛果」已经用光了。"
                },
                {
                    "id": "230230203",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，能请你帮我们去拿一些「香辛果」回来吗？"
                }
            ]
        },
        {
            "id": "2302304",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230230401",
                    "speaker": "瓦尔坦",
                    "text": "除了土壤的肥力问题外，也许「水」也是问题之一…"
                },
                {
                    "id": "230230402",
                    "speaker": "瓦尔坦",
                    "text": "也许是因为我们把蔷薇埋得太深，导致它没能汲取到充足的水分？"
                },
                {
                    "id": "230230403",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，请你帮我们一把，和我们一起给这一株蔷薇浇浇水吧。"
                }
            ]
        },
        {
            "id": "2302303",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230230301",
                    "speaker": "瓦尔坦",
                    "text": "这些应该就足够了，实在感谢你，旅行者！"
                },
                {
                    "id": "230230302",
                    "speaker": "瓦尔坦",
                    "text": "有了这种特制肥料，土壤的肥力就不成问题了，这株蔷薇一定能生长得很好。"
                },
                {
                    "id": "230230303",
                    "speaker": "古尔根",
                    "text": "希望别和之前那些肥料一样，洒下去之后一点作用都没有…"
                },
                {
                    "id": "230230304",
                    "speaker": "Player",
                    "text": "你们之前用过肥料？"
                },
                {
                    "id": "230230305",
                    "speaker": "瓦尔坦",
                    "text": "用过一些很普通的，但效果并不好…不如说，是一点效果都没有。"
                },
                {
                    "id": "230230306",
                    "speaker": "古尔根",
                    "text": "但那些肥料用在另外几片地里效果就非常好，也不知道这里到底出了什么问题…"
                },
                {
                    "id": "230230307",
                    "speaker": "瓦尔坦",
                    "text": "先不说这些了，这是一些谢礼，请收下吧，旅行者。"
                }
            ]
        },
        {
            "id": "2302305",
            "objective": "为「蔷薇」浇水",
            "dialogues": []
        },
        {
            "id": "2302306",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230230601",
                    "speaker": "瓦尔坦",
                    "text": "呼…差不多了，土壤的水分暂时应该足够了。"
                },
                {
                    "id": "230230602",
                    "speaker": "古尔根",
                    "text": "谢谢你，旅行者。要是没你帮忙，我们非得累趴下不可。"
                },
                {
                    "id": "230230603",
                    "speaker": "瓦尔坦",
                    "text": "真奇怪，这次怎么浇了这么多水才把土壤给浇透了。"
                },
                {
                    "id": "230230604",
                    "speaker": "瓦尔坦",
                    "text": "我感觉，这次浇水的量至少是平时的两倍还多。"
                },
                {
                    "id": "230230605",
                    "speaker": "古尔根",
                    "text": "是你太累了，才出现了这种错觉。"
                },
                {
                    "id": "230230606",
                    "speaker": "古尔根",
                    "text": "要是浇两倍的水，那整片土壤都会泡在水里了，现在土壤的湿润程度还很正常啊。"
                },
                {
                    "id": "230230607",
                    "speaker": "瓦尔坦",
                    "text": "话是这么说…"
                },
                {
                    "id": "230230608",
                    "speaker": "Player",
                    "text": "希望蔷薇能好好生长。"
                },
                {
                    "id": "230230609",
                    "speaker": "瓦尔坦",
                    "text": "请放心吧，为了「健康之家」的病人和医生们，我们也一定会照顾好这一株蔷薇的。"
                },
                {
                    "id": "230230610",
                    "speaker": "瓦尔坦",
                    "text": "这是一些谢礼，请收下吧，旅行者。"
                },
                {
                    "id": "230230611",
                    "speaker": "瓦尔坦",
                    "text": "唉，可我真觉得这次浇的水格外多啊…"
                }
            ]
        },
        {
            "id": "2302307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230230701",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，请你帮我们一把，和我们一起给附近的蔷薇浇浇水吧。"
                },
                {
                    "id": "230230702",
                    "speaker": "古尔根",
                    "text": "只要吸取了足够的水分，蔷薇一定能恢复生长的！"
                }
            ]
        }
    ]
}