    "talks": [
        {
            "id": "1201901",
            "objective": "(test)隐藏任务用于播放八重神子闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "120190101",
                    "speaker": "八重神子",
                    "text": "怎么了，还想聊点什么吗？",
                    "choices": [
                        {
                            "id": "120190102",
                            "text": "关于「团子牛奶」…",
                            "response": [
                                {
                                    "id": "120190103",
                                    "speaker": "八重神子",
                                    "text": "她绝对特别喜欢那个饮料，心里估计都乐开花了。"
                                },
                                {
                                    "id": "120190104",
                                    "speaker": "八重神子",
                                    "text": "她的潜台词就是，「快，把这个铺子开到我的『一心净土』里去！」"
                                }
                            ]
                        },
                        {
                            "id": "120190105",
                            "text": "关于「雷电将军」…",
                            "response": [
                                {
                                    "id": "120190106",
                                    "speaker": "八重神子",
                                    "text": "那个人偶是吧，修改人偶的规则很困难，这个我也听说过。"
                                },
                                {
                                    "id": "120190107",
                                    "speaker": "八重神子",
                                    "text": "这种困难可能是史无前例的，你们可以想象一下，能让神武英明的影也感到困难的事…"
                                },
                                {
                                    "id": "120190108",
                                    "speaker": "八重神子",
                                    "text": "「无想的一刀」也不能解决的事。"
                                }
                            ]
                        },
                        {
                            "id": "120190109",
                            "text": "关于「轻小说」…",
                            "response": [
                                {
                                    "id": "120190110",
                                    "speaker": "八重神子",
                                    "text": "转生成为雷电将军，不是很有趣的想法吗？轻小说只要有趣就够了。"
                                },
                                {
                                    "id": "120190111",
                                    "speaker": "八重神子",
                                    "text": "但对她来说，嗯，有点太前卫了吧。"
                                },
                                {
                                    "id": "120190112",
                                    "speaker": "八重神子",
                                    "text": "唔，下次要不要以「转生为八重宫司」为题材征稿呢？"
                                }
                            ]
                        },
                        {
                            "id": "120190113",
                            "text": "没什么了。"
                        }
                    ]
                }
            ]
        }
    ]
}