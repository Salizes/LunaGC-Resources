    "talks": [
        {
            "id": "7565901",
            "objective": "与「战备联络人」对话",
            "dialogues": [
                {
                    "id": "756590101",
                    "speaker": "伊拉德",
                    "text": "您终于来了，英雄大人。"
                },
                {
                    "id": "756590102",
                    "speaker": "伊拉德",
                    "text": "卑职在此等候多时，见到您的身影，疲惫竟一扫而空！",
                    "choices": [
                        {
                            "id": "756590103",
                            "text": "没错，我来得真好。",
                            "response": [
                                {
                                    "id": "756590105",
                                    "speaker": "派蒙",
                                    "text": "气氛突然变得好正式！我，我也要用正经的语气说话么？"
                                },
                                {
                                    "id": "756590106",
                                    "speaker": "伊拉德",
                                    "text": "啊，请别紧张，英雄大人和尊贵的向导，我简单介绍一下情况。"
                                },
                                {
                                    "id": "756590107",
                                    "speaker": "伊拉德",
                                    "text": "卑职是话事处的员工，战备联络人伊拉德，负责协助火神大人处理各部族巡逻队的训练事务。"
                                },
                                {
                                    "id": "756590108",
                                    "speaker": "伊拉德",
                                    "text": "根据传统，每过一段时间，各部族都会从年轻人中选拔新的战士，加入巡逻队。"
                                },
                                {
                                    "id": "756590109",
                                    "speaker": "伊拉德",
                                    "text": "同时，还要为老成员们设计较高难度的考核，以便他们挑战自我，不断进步。"
                                },
                                {
                                    "id": "756590110",
                                    "speaker": "伊拉德",
                                    "text": "相关的选拔与考核关卡，就是由战备联络人联合各部族的优秀战士一同设计的…"
                                },
                                {
                                    "id": "756590111",
                                    "speaker": "派蒙",
                                    "text": "哦呀，我听懂了！"
                                },
                                {
                                    "id": "756590112",
                                    "speaker": "派蒙",
                                    "text": "#聊到战斗、竞速之类的挑战，{NICKNAME}的确是专家，应该能帮你设计很多有意思的关卡。",
                                    "choices": [
                                        {
                                            "id": "756590113",
                                            "text": "你要给我发需求吗？",
                                            "response": [
                                                {
                                                    "id": "756590115",
                                                    "speaker": "伊拉德",
                                                    "text": "不至于，不至于！卑职怎敢让英雄大人来做我份内的工作！那既是我的失职，又是对英雄大人的怠慢！"
                                                },
                                                {
                                                    "id": "756590116",
                                                    "speaker": "伊拉德",
                                                    "text": "所有的考核关卡已经设计完毕了，我只是想请求英雄大人对这些关卡予以「认证」，同时，也是为战士们树立一个榜样。"
                                                },
                                                {
                                                    "id": "756590117",
                                                    "speaker": "伊拉德",
                                                    "text": "就如书面考试需要满分，人们修习技艺也需要目标。强大的战士们率先通过这些考核关卡，会给后辈们无尽的动力。"
                                                },
                                                {
                                                    "id": "756590118",
                                                    "speaker": "伊拉德",
                                                    "text": "比如，「回声之子」相关的考核关卡，就由「巴莱卡」的希诺宁大师认证…"
                                                },
                                                {
                                                    "id": "756590119",
                                                    "speaker": "伊拉德",
                                                    "text": "「悬木人」和「花羽会」的关卡则分别请到了「马力卜」基尼奇大师和「武卡」恰斯卡大师，让许多战士满怀热情地挑战…"
                                                },
                                                {
                                                    "id": "756590120",
                                                    "speaker": "派蒙",
                                                    "text": "#原来是这个意思…那这次{NICKNAME}岂不是成了…那句话怎么说的来着？"
                                                },
                                                {
                                                    "id": "756590121",
                                                    "speaker": "派蒙",
                                                    "text": "「永远追不上的地平线」！"
                                                },
                                                {
                                                    "id": "756590122",
                                                    "speaker": "Player",
                                                    "text": "好，我来给大家当榜样。"
                                                },
                                                {
                                                    "id": "756590123",
                                                    "speaker": "伊拉德",
                                                    "text": "这气魄，不愧是英雄大人！"
                                                },
                                                {
                                                    "id": "756590124",
                                                    "speaker": "Player",
                                                    "text": "谦虚点，提瓦特遍地是高手。"
                                                },
                                                {
                                                    "id": "756590125",
                                                    "speaker": "伊拉德",
                                                    "text": "这气度，赞美英雄大人的品德！"
                                                },
                                                {
                                                    "id": "756590126",
                                                    "speaker": "伊拉德",
                                                    "text": "那么，请容卑职在地图上标出几个考核关卡的位置，英雄大人随时可以前去大展身手！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756590114",
                                            "text": "你想成为我的甲方吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756590104",
                            "text": "有…有什么事？"
                        }
                    ]
                }
            ]
        }
    ]
}