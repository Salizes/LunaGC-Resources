            "dialogues": []
        },
        {
            "id": "1202117",
            "objective": "（隐藏）完成心海策略-让怪物感电$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1202103",
            "objective": "击败营地内的愚人众",
            "dialogues": []
        },
        {
            "id": "1202104",
            "objective": "与心海交谈",
            "dialogues": [
                {
                    "id": "120211001",
                    "speaker": "珊瑚宫心海",
                    "text": "#干得漂亮，{NICKNAME}。"
                },
                {
                    "id": "120211002",
                    "speaker": "派蒙",
                    "text": "嘿嘿，多亏了心海制定的战术啦！"
                },
                {
                    "id": "120211003",
                    "speaker": "珊瑚宫心海",
                    "text": "无论什么样的战术，最终都需要有人去执行。"
                },
                {
                    "id": "120211004",
                    "speaker": "珊瑚宫心海",
                    "text": "任何一场战斗能够赢下来，靠的都是大家共同的努力，不是我一个人的功劳。"
                },
                {
                    "id": "120211005",
                    "speaker": "派蒙",
                    "text": "没错，我也做出了很大的贡献哦！"
                },
                {
                    "id": "120211006",
                    "speaker": "Player",
                    "text": "完全没感觉到。"
                },
                {
                    "id": "120211007",
                    "speaker": "派蒙",
                    "text": "喂！"
                },
                {
                    "id": "120211008",
                    "speaker": "珊瑚宫心海",
                    "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。"
                },
                {
                    "id": "120211009",
                    "speaker": "珊瑚宫心海",
                    "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…"
                },
                {
                    "id": "120211010",
                    "speaker": "珊瑚宫心海",
                    "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。"
                },
                {
                    "id": "120211011",
                    "speaker": "派蒙",
                    "text": "好！那我们先四处看看吧！"
                }
            ]
        },
        {
            "id": "1202105",
            "objective": "调查愚人众临时营地",
            "dialogues": []
        },
        {
            "id": "1202110",
            "objective": "和派蒙对话（废弃）",
            "dialogues": []
        },
        {
            "id": "1202106",
            "objective": "调查愚人众临时营地",
            "dialogues": []
        },
        {
            "id": "1202111",
            "objective": "和派蒙对话（废弃）",
            "dialogues": [
                {
                    "id": "120211101",
                    "speaker": "珊瑚宫心海",
                    "text": "感觉和我们刚刚制定的战术有些不一样呢…"
                },
                {
                    "id": "120211102",
                    "speaker": "珊瑚宫心海",
                    "text": "无妨，战场局势复杂多变，也不必拘泥于已经制定好的计划。"
                },
                {
                    "id": "120211103",
                    "speaker": "派蒙",
                    "text": "嘿嘿…打起来之后乱糟糟的，不小心把战术给忘掉了…"
                },
                {
                    "id": "120211104",
                    "speaker": "珊瑚宫心海",
                    "text": "从结果来看也不错，说明你们能够真正做到「随机应变」。"
                },
                {
                    "id": "120211105",
                    "speaker": "珊瑚宫心海",
                    "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。"
                },
                {
                    "id": "120211106",
                    "speaker": "珊瑚宫心海",
                    "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…"
                },
                {
                    "id": "120211107",
                    "speaker": "珊瑚宫心海",
                    "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。"
                },
                {
                    "id": "120211108",
                    "speaker": "派蒙",
                    "text": "好！那我们先四处看看吧！"
                }
            ]
        },
        {
            "id": "1202107",
            "objective": "调查愚人众临时营地",
            "dialogues": []
        },
        {
            "id": "1202112",
            "objective": "和派蒙对话（废弃）",
            "dialogues": []
        },
        {
            "id": "1202108",
            "objective": "回复心海",
            "dialogues": []
        },
        {
            "id": "1202109",
            "objective": "将货物交还给商人",
            "dialogues": [
                {
                    "id": "120210401",
                    "speaker": "成濑",
                    "text": "那些！那些是我的货物！"
                },
                {
                    "id": "120210402",
                    "speaker": "成濑",
                    "text": "多谢珊瑚宫大人！多谢这位队长！"
                },
                {
                    "id": "120210403",
                    "speaker": "成濑",
                    "text": "怎么样，我就说自己是被冤枉的吧？"
                },
                {
                    "id": "120210404",
                    "speaker": "松田",
                    "text": "哼…谁知道呢。说不定你早就跟愚人众商量好了…"
                },
                {
                    "id": "120210405",
                    "speaker": "珊瑚宫心海",
                    "text": "从愚人众营地中的信息来看，他和愚人众确实没什么来往。"
                },
                {
                    "id": "120210406",
                    "speaker": "珊瑚宫心海",
                    "text": "不然按照愚人众的行事风格，应该会留下一些证据才对。"
                },
                {
                    "id": "120210407",
                    "speaker": "内村",
                    "text": "可是…"
                },
                {
                    "id": "120210408",
                    "speaker": "珊瑚宫心海",
                    "text": "没有什么可是。既然找回了货物，按照之前的约定，我们就应该还他清白。"
                },
                {
                    "id": "120210409",
                    "speaker": "松田",
                    "text": "抱歉。"
                },
                {
                    "id": "120210410",
                    "speaker": "内村",
                    "text": "是我们鲁莽了。"
                },
                {
                    "id": "120210411",
                    "speaker": "成濑",
                    "text": "哼哼…我就说你们这些大头兵，平日里不干正事，还敢来找我的麻烦，这下知道错了吧？"
                },
                {
                    "id": "120210412",
                    "speaker": "珊瑚宫心海",
                    "text": "这位商人也请不要得意。虽然我们证明了你的清白，但根据最新的法令，恶意囤积必需品，将遭受惩罚。"
                },
                {
                    "id": "120210413",
                    "speaker": "珊瑚宫心海",
                    "text": "既然你承认了这些是你的货物，那我们也会采取必要的措施。除了强制平价销售外，还有一笔罚款，数额是…"
                },
                {
                    "id": "120210414",
                    "speaker": "成濑",
                    "text": "停、停！珊瑚宫大人，你不是站在我这边的吗？"
                },
                {
                    "id": "120210415",
                    "speaker": "珊瑚宫心海",
                    "text": "当然不是。我是海祇岛的「现人神巫女」，遵循的是「赏罚分明」的原则。"
                },
                {
                    "id": "120210416",
                    "speaker": "珊瑚宫心海",
                    "text": "有功当赏，有错该罚。清白已还，但你还是要为自己的所作所为付出代价。"
                },
                {
                    "id": "120210417",
                    "speaker": "成濑",
                    "text": "啊，这…"
                },
                {
                    "id": "120210418",
                    "speaker": "松田",
                    "text": "看什么看，带走带走！交罚款去吧！"
                },
                {
                    "id": "120210419",
                    "speaker": "内村",
                    "text": "珊瑚宫大人，虽然此人说这些都是他的货物，但我觉得有点奇怪。"
                },
                {
                    "id": "120210420",
                    "speaker": "内村",
                    "text": "这些印有天领奉行标记的应该确凿无误，但其他的货物似乎并不是。特别是这一些，明显是给神社用的。"
                },
                {
                    "id": "120210421",
                    "speaker": "珊瑚宫心海",
                    "text": "嗯…应该是愚人众将所有抢到的东西混到了一起。其他货物，辛苦你们去寻找一下失主，神社相关的交给我吧。"
                },
                {
                    "id": "120210422",
                    "speaker": "珊瑚宫心海",
                    "text": "辛苦你们了。"
                },
                {
                    "id": "120210423",
                    "speaker": "内村",
                    "text": "不辛苦，不辛苦。"
                },
                {
                    "id": "120210424",
                    "speaker": "内村",
                    "text": "不过珊瑚宫大人，虽然这次没有抓到他们的把柄，但天领奉行勾结愚人众，可是我们的人亲眼所见。"
                },
                {
                    "id": "120210425",
                    "speaker": "内村",
                    "text": "关于和谈…还请您务必三思啊。"
                },
                {
                    "id": "120210426",
                    "speaker": "珊瑚宫心海",
                    "text": "我知道了，我会再想想。"
                },
                {
                    "id": "120210427",
                    "speaker": "珊瑚宫心海",
                    "text": "#{NICKNAME}，我准备带着这些神社相关的东西回珊瑚宫，方便的话，不妨一起走走？"
                }
            ]
        },
        {
            "id": "1202120",
            "objective": "刷出车车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1202113",
            "objective": "和心海一起散步",
            "dialogues": []
        },
        {
            "id": "1202114",
            "objective": "与心海交谈",
            "dialogues": [
                {
                    "id": "120210804",
                    "speaker": "珊瑚宫心海",
                    "text": "其实最早的时候，海祇岛的神社并非在珊瑚宫，而是在别的地方。"
                },
                {
                    "id": "120210805",
                    "speaker": "珊瑚宫心海",
                    "text": "那里靠近海祇岛的七天神像，当时的海祇岛虽不像幕府那般尊崇将军，但也认可她的存在。"
                },
                {
                    "id": "120210806",
                    "speaker": "珊瑚宫心海",
                    "text": "但随着那一刀落下，守护我们海祇岛的魔神被斩断之后，当初的神社便废弃了。"
                },
                {
                    "id": "120210807",
                    "speaker": "珊瑚宫心海",
                    "text": "也从那时起，海祇岛和幕府的关系就变得有些微妙，彼此之间的成见越来越深。"
                },
                {
                    "id": "120210808",
                    "speaker": "珊瑚宫心海",
                    "text": "这次和谈，我本来也想好好跟天领奉行讨论一下这个问题。有些恩怨，总有一天要放下的…"
                },
                {
                    "id": "120210809",
                    "speaker": "用高",
                    "text": "珊瑚宫大人，今天怎么有空来这边看看了？"
                },
                {
                    "id": "120210810",
                    "speaker": "用高",
                    "text": "总觉得你的气色比上次差了，平时要照顾好自己，你可是我们最大的依靠…"
                },
                {
                    "id": "120210811",
                    "speaker": "珊瑚宫心海",
                    "text": "嗯嗯，请放心，没事的。"
                },
                {
                    "id": "120210812",
                    "speaker": "结菜",
                    "text": "珊瑚宫大人，听我一句劝。咱们跟幕府军打了那么久，可不能说谈就谈啊。"
                },
                {
                    "id": "120210813",
                    "speaker": "结菜",
                    "text": "要是与他们和解的话，当初守护我们的魔神不就白死了…"
                },
                {
                    "id": "120210814",
                    "speaker": "用高",
                    "text": "行了行了，都什么年代啦。这才刚打完仗呢，安安稳稳地过日子多好。"
                },
                {
                    "id": "120210815",
                    "speaker": "结菜",
                    "text": "我当然知道，只是…唉。至少态度要强硬一些，不能随便妥协。"
                },
                {
                    "id": "120210816",
                    "speaker": "珊瑚宫心海",
                    "text": "我明白的，此事我会再考虑一下，一定会妥善处理。"
                },
                {
                    "id": "120210817",
                    "speaker": "结菜",
                    "text": "太好了…那就麻烦珊瑚宫大人了。"
                },
                {
                    "id": "120210818",
                    "speaker": "志织",
                    "text": "珊瑚宫大人？哎呀呀，没想到能在这里见到您。"
                },
                {
                    "id": "120210819",
                    "speaker": "志织",
                    "text": "我的女儿，今年报名参加巫女选拔了。要是她能进珊瑚宫就好啦，珊瑚宫大人心善，一定不会亏待她。"
                },
                {
                    "id": "120210820",
                    "speaker": "志织",
                    "text": "唉，我常和我家女儿说，让她有机会的话跟珊瑚宫大人好好学学。"
                },
                {
                    "id": "120210821",
                    "speaker": "志织",
                    "text": "珊瑚宫大人这么年轻，就已经会待人处事，人又聪明伶俐…我家女儿，一直把珊瑚宫大人当做榜样。"
                },
                {
                    "id": "120210822",
                    "speaker": "珊瑚宫心海",
                    "text": "如果她能来珊瑚宫的话，我会关照一下…"
                },
                {
                    "id": "120210823",
                    "speaker": "岩田",
                    "text": "珊瑚宫大人！总算见到您了。关于今年农业减产的问题，我想跟您汇报一下…"
                },
                {
                    "id": "120210824",
                    "speaker": "亮子",
                    "text": "#珊瑚宫大人，这位不是剑鱼二番队的队长吗？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}以后会留在海祇岛吗？"
                },
                {
                    "id": "120210825",
                    "speaker": "幸也",
                    "text": "珊瑚宫大人…"
                },
                {
                    "id": "120210826",
                    "speaker": "珊瑚宫心海",
                    "text": "呼…大家稍微静一下，我都会听的。"
                },
                {
                    "id": "120210827",
                    "speaker": "珊瑚宫心海",
                    "text": "不过，比较长的问题还是建议写成报告，递到珊瑚宫。有时间我会慢慢批复。"
                },
                {
                    "id": "120210828",
                    "speaker": "珊瑚宫心海",
                    "text": "……"
                },
                {
                    "id": "120210829",
                    "speaker": "珊瑚宫心海",
                    "text": "#{NICKNAME}，你还好吗？",
                    "choices": [
                        {
                            "id": "120210830",
                            "text": "还好。",
                            "response": [
                                {
                                    "id": "120210831",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…看来你很擅长应对这样的场合。"
                                },
                                {
                                    "id": "120210834",
                                    "speaker": "和泉那希",
                                    "text": "珊瑚宫大人，原来您在这里。"
                                },
                                {
                                    "id": "120210835",
                                    "speaker": "和泉那希",
                                    "text": "有件事要向您汇报，我们有一批祭祀用具迟迟没有送到，我担心是被劫走了…"
                                },
                                {
                                    "id": "120210836",
                                    "speaker": "珊瑚宫心海",
                                    "text": "那些东西我已经找回来了，不必担心。"
                                },
                                {
                                    "id": "120210837",
                                    "speaker": "和泉那希",
                                    "text": "真的吗？不愧是珊瑚宫大人，太厉害了！"
                                },
                                {
                                    "id": "120210838",
                                    "speaker": "和泉那希",
                                    "text": "最近的公文我简单地整理了一下，已经放在您的桌子上了。"
                                },
                                {
                                    "id": "120210839",
                                    "speaker": "和泉那希",
                                    "text": "另外，按排程来看，今天还有一场关于发展纺织业的会议…"
                                },
                                {
                                    "id": "120210840",
                                    "speaker": "珊瑚宫心海",
                                    "text": "排程…现在？"
                                },
                                {
                                    "id": "120210841",
                                    "speaker": "和泉那希",
                                    "text": "是的，那两位远道而来的姑娘已经在等您了。"
                                },
                                {
                                    "id": "120210842",
                                    "speaker": "珊瑚宫心海",
                                    "text": "#好吧…{NICKNAME}，本来想带你好好逛一逛海祇岛，看来要忙完再一起散散心了。"
                                },
                                {
                                    "id": "120210843",
                                    "speaker": "珊瑚宫心海",
                                    "text": "明天我们在珊瑚宫门口碰面吧，然后一起去筹备庆功宴。"
                                },
                                {
                                    "id": "120210844",
                                    "speaker": "派蒙",
                                    "text": "庆功宴！会有很多好吃的吗？"
                                },
                                {
                                    "id": "120210845",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…当然有的。有些海祇岛的特色美食，也欢迎你们品尝一下。"
                                },
                                {
                                    "id": "120210846",
                                    "speaker": "派蒙",
                                    "text": "好耶！那我们明天不见不散啦！"
                                },
                                {
                                    "id": "120210847",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯…"
                                }
                            ]
                        },
                        {
                            "id": "120210832",
                            "text": "有点累。",
                            "response": [
                                {
                                    "id": "120210833",
                                    "speaker": "珊瑚宫心海",
                                    "text": "是吧，我也感觉有些头疼…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120210201",
                    "speaker": "珊瑚宫心海",
                    "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。"
                },
                {
                    "id": "120210202",
                    "speaker": "珊瑚宫心海",
                    "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…"
                },
                {
                    "id": "120210203",
                    "speaker": "珊瑚宫心海",
                    "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。"
                },
                {
                    "id": "120210204",
                    "speaker": "派蒙",
                    "text": "好！那我们先四处看看吧！"
                }
            ]
        },
        {
            "id": "1202118",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120211803",
                    "speaker": "松田",
                    "text": "老实点！"
                },
                {
                    "id": "120211804",
                    "speaker": "内村",
                    "text": "别东张西望的！"
                },
                {
                    "id": "120211805",
                    "speaker": "成濑",
                    "text": "哼，等珊瑚宫大人的调查结果出来了，我一定…"
                }
            ]
        },
        {
            "id": "1202199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120219901",
                    "speaker": "珊瑚宫心海",
                    "text": "顺利解决掉了对方首领，正是乘胜追击的好时候！"
                },
                {
                    "id": "120219902",
                    "speaker": "珊瑚宫心海",
                    "text": "爆炸规模和我预想中的差不多，愚人众应该也吓了一跳吧。"
                },
                {
                    "id": "120219903",
                    "speaker": "珊瑚宫心海",
                    "text": "它们的动作变得僵硬迟缓了，看来我们配合得很好呢！"
                },
                {
                    "id": "120219904",
                    "speaker": "珊瑚宫心海",
                    "text": "海祇岛的风土人情，与其他岛屿不太一样。不知道你是否习惯呢？"
                },
                {
                    "id": "120219905",
                    "speaker": "珊瑚宫心海",
                    "text": "这个村子，我也很长时间没有来了。最近要忙的事情越来越多…"
                },
                {
                    "id": "120219906",
                    "speaker": "珊瑚宫心海",
                    "text": "下次有机会，我带你去海祇岛曾经的神社看看吧。"
                }
            ]
        }
    ]
}