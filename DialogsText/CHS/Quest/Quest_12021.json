    "talks": [
        {
            "id": "1202101",
            "objective": "前往愚人众临时营地",
            "dialogues": [
                {
                    "id": "120210101",
                    "speaker": "珊瑚宫心海",
                    "text": "商人所说的愚人众营地，应该就是在这里了。"
                },
                {
                    "id": "120210102",
                    "speaker": "珊瑚宫心海",
                    "text": "从布设来看，这里应该曾经是一个丘丘人的营地，不知为何被愚人众占据了。"
                },
                {
                    "id": "120210103",
                    "speaker": "派蒙",
                    "text": "哇…感觉戒备很森严的样子。我们真的能进去吗？"
                },
                {
                    "id": "120210104",
                    "speaker": "珊瑚宫心海",
                    "text": "直接突破恐怕很难。不过没关系，此处地形对我们有利，而且我们的位置没有暴露。"
                },
                {
                    "id": "120210105",
                    "speaker": "珊瑚宫心海",
                    "text": "敌在明处，我们在暗处，正是使用计谋的好时机。"
                },
                {
                    "id": "120210106",
                    "speaker": "Player",
                    "text": "军师大人有何高见？"
                },
                {
                    "id": "120210107",
                    "speaker": "珊瑚宫心海",
                    "text": "以我之见，不外三种对策。"
                },
                {
                    "id": "120210108",
                    "speaker": "珊瑚宫心海",
                    "text": "第一种，擒贼擒王。愚人众在稻妻的势力暂时不成气候，剩下来的无非是残兵败将。"
                },
                {
                    "id": "120210109",
                    "speaker": "珊瑚宫心海",
                    "text": "若是能够自高处飞下，率先击溃其中的首领，那么杂兵便不攻自破。"
                },
                {
                    "id": "120210110",
                    "speaker": "珊瑚宫心海",
                    "text": "#第二种，借势而为。{NICKNAME}你看，那边堆积了一些火药桶。"
                },
                {
                    "id": "120210111",
                    "speaker": "珊瑚宫心海",
                    "text": "若是在他们没有发觉的情况下引爆火药，会给他们带来极大的冲击。"
                },
                {
                    "id": "120210112",
                    "speaker": "珊瑚宫心海",
                    "text": "猝不及防之下，对方必定会军心动摇，战斗力也大大下降。"
                },
                {
                    "id": "120210113",
                    "speaker": "珊瑚宫心海",
                    "text": "最后一种，则是善用地利。此处近海，水汽氤氲。我可以牵引周遭水汽，配合你的雷电将其麻痹。"
                },
                {
                    "id": "120210114",
                    "speaker": "派蒙",
                    "text": "不愧是心海，这么快就有办法了。可是我们要采取哪个方案呢？"
                },
                {
                    "id": "120210115",
                    "speaker": "珊瑚宫心海",
                    "text": "这三种方案的主要差别，在于实施者对自己能力的判断。"
                },
                {
                    "id": "120210116",
                    "speaker": "珊瑚宫心海",
                    "text": "从上方空降，奇袭大营，是最快的方法。但是对于武力有很高的要求。"
                },
                {
                    "id": "120210117",
                    "speaker": "珊瑚宫心海",
                    "text": "利用爆炸使对方瞬间减员，则不需要正面苦战。但是要隐匿声息，不能暴露位置。"
                },
                {
                    "id": "120210118",
                    "speaker": "珊瑚宫心海",
                    "text": "#而利用地利，则必须要稳扎稳打，可能会演变为持久战。{NICKNAME}，你比较喜欢哪一种战术？",
                    "choices": [
                        {
                            "id": "120210119",
                            "text": "奇袭营地。",
                            "response": [
                                {
                                    "id": "120210120",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…不愧是剑鱼二番队的队长，对自己的实力很有信心嘛。"
                                },
                                {
                                    "id": "120210121",
                                    "speaker": "珊瑚宫心海",
                                    "text": "既然选定了这个战术，那我们就并肩作战吧。我虽不是武斗派，但也能提供一些支援，不会让你孤军奋战。"
                                },
                                {
                                    "id": "120210122",
                                    "speaker": "珊瑚宫心海",
                                    "text": "尽快打倒他们，然后将商人的货物找回来吧。"
                                }
                            ]
                        },
                        {
                            "id": "120210123",
                            "text": "引爆炸药。",
                            "response": [
                                {
                                    "id": "120210124",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…看来你跟我一样，也对奇谋感兴趣呢。"
                                },
                                {
                                    "id": "120210125",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我也比较喜欢这个战术，毕竟这样的危险性是最低的。"
                                },
                                {
                                    "id": "120210126",
                                    "speaker": "珊瑚宫心海",
                                    "text": "就让我们好好配合，给他们一个「惊喜」吧。"
                                }
                            ]
                        },
                        {
                            "id": "120210127",
                            "text": "感电配合。",
                            "response": [
                                {
                                    "id": "120210128",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯，将他们从营地中引出来，可以最大程度地保证营地的完整。"
                                },
                                {
                                    "id": "120210129",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不过，以前我们没有太多并肩作战的机会，不知道我能不能跟上你的节奏…"
                                },
                                {
                                    "id": "120210130",
                                    "speaker": "珊瑚宫心海",
                                    "text": "放心，虽然我不敢自称武斗派，但长期与军队为伴，这样的场面应该也能够应付。"
                                },
                                {
                                    "id": "120210131",
                                    "speaker": "珊瑚宫心海",
                                    "text": "是时候把这个愚人众营地清理掉，到里面一探究竟了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202118",
            "objective": "商人和士兵闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "120210301",
                    "speaker": "派蒙",
                    "text": "心海——"
                },
                {
                    "id": "120210302",
                    "speaker": "派蒙",
                    "text": "心海，我们找到商人的货物啦。你看！"
                },
                {
                    "id": "120210303",
                    "speaker": "珊瑚宫心海",
                    "text": "唔…哦哦。",
                    "choices": [
                        {
                            "id": "120210304",
                            "text": "有什么心事吗？",
                            "response": [
                                {
                                    "id": "120210306",
                                    "speaker": "珊瑚宫心海",
                                    "text": "没事，只是稍稍有些走神而已。"
                                },
                                {
                                    "id": "120210307",
                                    "speaker": "珊瑚宫心海",
                                    "text": "让我看看…确实，这些应该就是商人先生丢的东西了。"
                                },
                                {
                                    "id": "120210308",
                                    "speaker": "珊瑚宫心海",
                                    "text": "粮食、药材、农耕用具…都是战后急需的东西。他囤着这些，估计是想卖个好价钱。"
                                },
                                {
                                    "id": "120210309",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不过，天领奉行应该不缺这些东西，他倒确实不至于把这些运回天领奉行。"
                                },
                                {
                                    "id": "120210310",
                                    "speaker": "珊瑚宫心海",
                                    "text": "多半只是个投机的商人而已，没有松田和内村说的那么夸张。"
                                },
                                {
                                    "id": "120210311",
                                    "speaker": "派蒙",
                                    "text": "唔…但是，故意囤积这些必需品，明显也是个坏家伙。"
                                },
                                {
                                    "id": "120210312",
                                    "speaker": "派蒙",
                                    "text": "我们就这样把货物还回去吗？总觉得有点不舒服…"
                                },
                                {
                                    "id": "120210313",
                                    "speaker": "珊瑚宫心海",
                                    "text": "放心吧，这种情况我已经考量过了。"
                                },
                                {
                                    "id": "120210314",
                                    "speaker": "珊瑚宫心海",
                                    "text": "在最新的「战后临时法令」中，我限制了必需品的价格上限。这些东西，最终还是会以合理的价格流入民众手里。"
                                },
                                {
                                    "id": "120210315",
                                    "speaker": "珊瑚宫心海",
                                    "text": "如果他能早一点读读法令，应该也不会遭此无妄之灾了。"
                                },
                                {
                                    "id": "120210316",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，总觉得心海什么事都能算到呢！"
                                },
                                {
                                    "id": "120210317",
                                    "speaker": "珊瑚宫心海",
                                    "text": "太夸张啦。就拿眼下来说，关于天领奉行勾结愚人众的传闻，我就没什么头绪。"
                                },
                                {
                                    "id": "120210318",
                                    "speaker": "珊瑚宫心海",
                                    "text": "正好还是在「能量」快不够的时候…"
                                },
                                {
                                    "id": "120210319",
                                    "speaker": "派蒙",
                                    "text": "嗯？心海，你刚刚说什么？"
                                },
                                {
                                    "id": "120210320",
                                    "speaker": "珊瑚宫心海",
                                    "text": "没什么，我们快点将这堆货物还回去吧。"
                                },
                                {
                                    "id": "120210321",
                                    "speaker": "珊瑚宫心海",
                                    "text": "庆功宴就快到了，这些麻烦事，必须早点做个了结。"
                                },
                                {
                                    "id": "120210322",
                                    "speaker": "派蒙",
                                    "text": "好欸！我们也想在一个和平的海祇岛上开庆功宴呢！"
                                }
                            ]
                        },
                        {
                            "id": "120210305",
                            "text": "心海在想什么？"
                        }
                    ]
                }
            ]
        },
