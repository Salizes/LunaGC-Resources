    "talks": [
        {
            "id": "7902601",
            "objective": "(test)和夜鸦团长对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790260101",
                    "speaker": "暮夜剧团团长",
                    "text": "欢迎！欢迎！"
                },
                {
                    "id": "790260102",
                    "speaker": "暮夜剧团团长",
                    "text": "欢迎！"
                },
                {
                    "id": "790260104",
                    "speaker": "暮夜剧团团长",
                    "text": "#您就是大名鼎鼎的{NICKNAME}！还有最好的伙伴——派蒙阁下！"
                },
                {
                    "id": "790260105",
                    "speaker": "派蒙",
                    "text": "哇！你怎么知道我们的名字？"
                },
                {
                    "id": "790260106",
                    "speaker": "暮夜剧团团长",
                    "text": "岛上的贵客，我当然知道，因为我！"
                },
                {
                    "id": "790260107",
                    "speaker": "派蒙",
                    "text": "你？"
                },
                {
                    "id": "790260108",
                    "speaker": "暮夜剧团团长",
                    "text": "我就是大名鼎鼎的暮夜剧团团长！"
                },
                {
                    "id": "790260109",
                    "speaker": "Player",
                    "text": "原来真的有人自称大名鼎鼎。"
                },
                {
                    "id": "790260110",
                    "speaker": "派蒙",
                    "text": "虽然你说自己大名鼎鼎，可是我们没听说过你呀。"
                },
                {
                    "id": "790260111",
                    "speaker": "暮夜剧团团长",
                    "text": "没关系！现在两位已经听说了！"
                },
                {
                    "id": "790260112",
                    "speaker": "暮夜剧团团长",
                    "text": "经过紧锣密鼓的筹备，我们的舞台剧「王女执剑记」就要首演了！"
                },
                {
                    "id": "790260113",
                    "speaker": "暮夜剧团团长",
                    "text": "演出一共五幕，每幕分为上下两场…"
                },
                {
                    "id": "790260114",
                    "speaker": "暮夜剧团团长",
                    "text": "贵宾们来得正是时候！马上序幕就要开演！请您就坐！"
                },
                {
                    "id": "790260115",
                    "speaker": "暮夜剧团团长",
                    "text": "后台还有些事情需要处理，且容我先行告退。"
                },
                {
                    "id": "790260116",
                    "speaker": "暮夜剧团团长",
                    "text": "暮夜剧团，倾力打造的舞台剧，马上开幕，请您欣赏！"
                }
            ]
        },
