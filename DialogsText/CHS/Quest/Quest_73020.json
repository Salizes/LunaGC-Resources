    "talks": [
        {
            "id": "7302001",
            "objective": "寻找烟柱升起之处",
            "dialogues": [
                {
                    "id": "730200101",
                    "speaker": "？？？",
                    "text": "呜噢？呜…"
                },
                {
                    "id": "730200102",
                    "speaker": "？？？",
                    "text": "啊。是那菈。"
                },
                {
                    "id": "730200103",
                    "speaker": "？？？",
                    "text": "咳咳。让那菈目睹我狼狈的模样，真是十分羞愧。"
                },
                {
                    "id": "730200104",
                    "speaker": "兰茶荼",
                    "text": "善良的那菈，我是兰茶荼。二位是？"
                },
                {
                    "id": "730200105",
                    "speaker": "Player",
                    "text": "#我叫{NICKNAME}。"
                },
                {
                    "id": "730200106",
                    "speaker": "派蒙",
                    "text": "我叫派蒙！"
                },
                {
                    "id": "730200107",
                    "speaker": "兰茶荼",
                    "text": "#那菈{NICKNAME}和派蒙，我明白了。真是十分感谢。倘若不是在这里与你们有缘相遇，要恢复还得花上一点时间。"
                },
                {
                    "id": "730200108",
                    "speaker": "派蒙",
                    "text": "一点时间是多久啊…"
                },
                {
                    "id": "730200109",
                    "speaker": "兰茶荼",
                    "text": "实在惭愧，以前也因为不好的蘑菇，遇到过类似的情况。后来，水中的月莲绽开又合上，重复了两次，我就恢复了。"
                },
                {
                    "id": "730200110",
                    "speaker": "派蒙",
                    "text": "绽开又合上…那不是要花两天时间吗！"
                },
                {
                    "id": "730200111",
                    "speaker": "兰茶荼",
                    "text": "啊，两天。原来如此，原来这就是「天」的意思。你们那菈真有意思。两天算是长还是短呢？"
                },
                {
                    "id": "730200112",
                    "speaker": "派蒙",
                    "text": "#嗯…{NICKNAME}，你觉得呢？两天算长还是短？",
                    "choices": [
                        {
                            "id": "730200113",
                            "text": "算是长吧。",
                            "response": [
                                {
                                    "id": "730200114",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯。很难想象兰茶荼「呜噢噢噢噢」整整两天呢。"
                                },
                                {
                                    "id": "730200115",
                                    "speaker": "兰茶荼",
                                    "text": "是吗？原来这样算很长时间啊，不得了。"
                                },
                                {
                                    "id": "730200126",
                                    "speaker": "派蒙",
                                    "text": "不过，这么说来，你叫兰茶荼的话…是兰帕卡提的亲人吗？"
                                },
                                {
                                    "id": "730200127",
                                    "speaker": "兰茶荼",
                                    "text": "不是。"
                                },
                                {
                                    "id": "730200128",
                                    "speaker": "派蒙",
                                    "text": "欸？但是…你是兰帕卡提的哥哥？"
                                },
                                {
                                    "id": "730200129",
                                    "speaker": "兰茶荼",
                                    "text": "咦，你们怎么知道？兰帕卡提是我的「妹妹」。"
                                },
                                {
                                    "id": "730200130",
                                    "speaker": "派蒙",
                                    "text": "到底是怎么回事啦…"
                                },
                                {
                                    "id": "730200131",
                                    "speaker": "Player",
                                    "text": "可能兰那罗的概念不同…"
                                },
                                {
                                    "id": "730200132",
                                    "speaker": "派蒙",
                                    "text": "总之，事情是这样的…"
                                },
                                {
                                    "id": "730200133",
                                    "speaker": "Black Screen",
                                    "text": "向兰茶荼述说事情的经过。"
                                },
                                {
                                    "id": "730200134",
                                    "speaker": "兰茶荼",
                                    "text": "无忧节又要举办了吗…该怎么办呢。"
                                },
                                {
                                    "id": "730200135",
                                    "speaker": "兰茶荼",
                                    "text": "我还没有准备好重要的「食材」，在无忧节向兰萨卡、兰阿帕斯、兰非拉证明，蘑菇菜肴才是最好的。"
                                },
                                {
                                    "id": "730200136",
                                    "speaker": "派蒙",
                                    "text": "这么说来，兰斯…斯帕…兰…"
                                },
                                {
                                    "id": "730200137",
                                    "speaker": "Player",
                                    "text": "兰萨卡、兰阿帕斯、兰非拉。"
                                },
                                {
                                    "id": "730200138",
                                    "speaker": "派蒙",
                                    "text": "啊啊啊！兰那罗的名字好难记喔！兰茶荼，你的兄弟到哪去了？"
                                },
                                {
                                    "id": "730200139",
                                    "speaker": "兰茶荼",
                                    "text": "我们在各自修行的道路上渐行渐远。就像河流变成溪流。"
                                },
                                {
                                    "id": "730200140",
                                    "speaker": "派蒙",
                                    "text": "也就是分散了，对吧？"
                                },
                                {
                                    "id": "730200141",
                                    "speaker": "兰茶荼",
                                    "text": "我们「烹饪修行」是为了做出「至上珍馐」，可是他们竟然不承认蘑菇菜肴。明明「一头菇」无可匹敌。"
                                },
                                {
                                    "id": "730200142",
                                    "speaker": "兰茶荼",
                                    "text": "总之，我们决定完成各自的菜肴，等完成后再比较。"
                                },
                                {
                                    "id": "730200143",
                                    "speaker": "派蒙",
                                    "text": "原来是这样。既然是对美食的追求，那就完全可以理解！"
                                },
                                {
                                    "id": "730200144",
                                    "speaker": "派蒙",
                                    "text": "那么，你的「一头菇」呢？"
                                },
                                {
                                    "id": "730200145",
                                    "speaker": "兰茶荼",
                                    "text": "近来「无留陀」的蔓生频繁，「一头菇」所生长的环境也被占据了。"
                                },
                                {
                                    "id": "730200146",
                                    "speaker": "派蒙",
                                    "text": "啊，也就是死域…希望拉娜一切安好。"
                                },
                                {
                                    "id": "730200147",
                                    "speaker": "兰茶荼",
                                    "text": "珍贵的蘑菇恐怕也被枯萎的爪牙刨走。想必二位也明白，「无留陀」之地凶险非常，非常凶险。"
                                },
                                {
                                    "id": "730200148",
                                    "speaker": "兰茶荼",
                                    "text": "没有「一头菇」，就尝试了不曾有兰那罗吃过的怪怪蘑菇。"
                                },
                                {
                                    "id": "730200149",
                                    "speaker": "派蒙",
                                    "text": "结果呢？",
                                    "choices": [
                                        {
                                            "id": "730200150",
                                            "text": "结果就是我们看到的样子吧。",
                                            "response": [
                                                {
                                                    "id": "730200152",
                                                    "speaker": "兰茶荼",
                                                    "text": "实在是不好意思。"
                                                },
                                                {
                                                    "id": "730200153",
                                                    "speaker": "派蒙",
                                                    "text": "不过这么说来，死域…也就是「无留陀」，我们之前也对付过吧？",
                                                    "choices": [
                                                        {
                                                            "id": "730200154",
                                                            "text": "轻轻松松。",
                                                            "response": [
                                                                {
                                                                    "id": "730200156",
                                                                    "speaker": "兰茶荼",
                                                                    "text": "喔，真是不可思议。你们居然有与「无留陀」抗衡的力量。"
                                                                },
                                                                {
                                                                    "id": "730200157",
                                                                    "speaker": "兰茶荼",
                                                                    "text": "#不过这样就说得通了。既然那菈{NICKNAME}能使用草王的力量治愈我，那消除「无留陀」的影响想来也不是问题。"
                                                                },
                                                                {
                                                                    "id": "730200158",
                                                                    "speaker": "兰茶荼",
                                                                    "text": "#那么，我想请求那菈{NICKNAME}随我一同，深入「一头菇」生长的地方。"
                                                                },
                                                                {
                                                                    "id": "730200159",
                                                                    "speaker": "派蒙",
                                                                    "text": "#是品尝美味无比的蘑菇菜肴的机会！{NICKNAME}，为了让他们兄妹团聚，我们就帮帮忙吧！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730200160",
                                                                            "text": "好。反正本来也答应了兰帕卡提。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730200163",
                                                                                    "speaker": "兰茶荼",
                                                                                    "text": "好。就在前方的洞窟里。请陪我一起去看看吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730200161",
                                                                            "text": "你只是想吃吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730200162",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "一举两得，有什么不对嘛！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730200155",
                                                            "text": "勉勉强强。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730200151",
                                            "text": "「呜噢噢噢噢——！」"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730200116",
                            "text": "算是短吧。",
                            "response": [
                                {
                                    "id": "730200117",
                                    "speaker": "派蒙",
                                    "text": "唔…确实，这么想来，我们已经认识了这么久。但感觉就像昨天一样。"
                                },
                                {
                                    "id": "730200118",
                                    "speaker": "兰茶荼",
                                    "text": "是吗？那我就放心了。在森林里失控两天原来也不算太长时间。"
                                },
                                {
                                    "id": "730200119",
                                    "speaker": "派蒙",
                                    "text": "倒不是这个意思啦！"
                                }
                            ]
                        },
                        {
                            "id": "730200120",
                            "text": "取决于这个时间用来干什么。",
                            "response": [
                                {
                                    "id": "730200121",
                                    "speaker": "派蒙",
                                    "text": "嗯，确实呢。如果「呜噢噢噢噢」整整两天，就是很长时间。如果是野林猪从小长大，就是很短时间。"
                                },
                                {
                                    "id": "730200122",
                                    "speaker": "兰茶荼",
                                    "text": "是吗？原来这样算很长时间啊，不得了。"
                                }
                            ]
                        },
                        {
                            "id": "730200123",
                            "text": "时间是主观概念，没有意义。",
                            "response": [
                                {
                                    "id": "730200124",
                                    "speaker": "兰茶荼",
                                    "text": "#嗯。那菈{NICKNAME}，你很明白森林的道理。对于森林来说，生命诞生、生命成长、生命回归土地，都不需要「天」。"
                                },
                                {
                                    "id": "730200125",
                                    "speaker": "派蒙",
                                    "text": "什么乱七八糟的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302002",
            "objective": "利用草元素使兰那罗恢复",
            "dialogues": [
                {
                    "id": "730200201",
                    "speaker": "兰茶荼",
                    "text": "啊啊，我朝思暮想的「一头菇」。"
                },
                {
                    "id": "730200202",
                    "speaker": "兰茶荼",
                    "text": "「一头菇」，倘若你失去了你的芬芳，你还会是「一头菇」吗？"
                },
                {
                    "id": "730200203",
                    "speaker": "派蒙",
                    "text": "嘿嘿，蘑菇。闻起来确实很不错。"
                },
                {
                    "id": "730200204",
                    "speaker": "派蒙",
                    "text": "不管怎么说，我们出去吧！"
                }
            ]
        },
        {
            "id": "7302006",
            "objective": "利用草元素使兰那罗恢复",
            "dialogues": []
        },
        {
            "id": "7302003",
            "objective": "前去寻找「一头菇」",
            "dialogues": [
                {
                    "id": "730200301",
                    "speaker": "兰茶荼",
                    "text": "能遇到你们，真是一件幸事。"
                },
                {
                    "id": "730200302",
                    "speaker": "兰茶荼",
                    "text": "这是完全成熟的「一头菇」的味道，比起上次我闻到的更醇厚了。"
                },
                {
                    "id": "730200303",
                    "speaker": "兰茶荼",
                    "text": "看来即使生长之处被「无留陀」占据，你也好好成长了，真是了不起。"
                },
                {
                    "id": "730200304",
                    "speaker": "派蒙",
                    "text": "嗯，那个，「一头菇」…能让我们尝尝吗？"
                },
                {
                    "id": "730200305",
                    "speaker": "兰茶荼",
                    "text": "自然。且不论二位有恩于我，再一次用最美味的蘑菇菜肴招待那菈本来就是我「烹饪修行」的目标。"
                },
                {
                    "id": "730200306",
                    "speaker": "派蒙",
                    "text": "好耶！一头菇！"
                },
                {
                    "id": "730200307",
                    "speaker": "Black Screen",
                    "text": "兰茶荼立刻进行了烹饪…\\n蘑菇鲜香的风味自锅中满溢而出。"
                },
                {
                    "id": "730200308",
                    "speaker": "Black Screen",
                    "text": "随后，兰茶荼将成品交给你与派蒙。\\n…应该说是令人失望还是符合预期呢，并没有什么滋味。\\n而且充满了强大的生命力，组织实在太过坚韧，难以嚼碎。"
                },
                {
                    "id": "730200309",
                    "speaker": "兰茶荼",
                    "text": "…完成了。我的「烹饪修行」，已经抵达了完满的终点。如何？对于那菈来说，想必是最好的美味吧。"
                },
                {
                    "id": "730200310",
                    "speaker": "派蒙",
                    "text": "嚼嚼…咕噜…唔…该怎么说呢…"
                },
                {
                    "id": "730200311",
                    "speaker": "Player",
                    "text": "（用力咀嚼）"
                },
                {
                    "id": "730200312",
                    "speaker": "Player",
                    "text": "（用力吞咽）",
                    "choices": [
                        {
                            "id": "730200313",
                            "text": "算是可以吃。够努力的话。",
                            "response": [
                                {
                                    "id": "730200316",
                                    "speaker": "派蒙",
                                    "text": "嗯…确实是很香的蘑菇呢，不过味道和口感不太适合我们。"
                                },
                                {
                                    "id": "730200317",
                                    "speaker": "兰茶荼",
                                    "text": "欸？"
                                },
                                {
                                    "id": "730200318",
                                    "speaker": "兰茶荼",
                                    "text": "#怎么会这样呢，之前同样做给那菈吃的时候，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}明明说好吃。"
                                },
                                {
                                    "id": "730200319",
                                    "speaker": "派蒙",
                                    "text": "之前？"
                                },
                                {
                                    "id": "730200320",
                                    "speaker": "兰茶荼",
                                    "text": "#以前，我也做过蘑菇菜肴给那菈吃。而且因为好吃，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}咽下去的时候还特别用力。"
                                },
                                {
                                    "id": "730200321",
                                    "speaker": "兰茶荼",
                                    "text": "应该没有问题才对。"
                                },
                                {
                                    "id": "730200322",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "730200323",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "730200324",
                                    "speaker": "兰茶荼",
                                    "text": "唉。就像不同的兰那罗，会长出不同的叶子。蘑菇的滋味，或许也不一定适合所有那菈。"
                                },
                                {
                                    "id": "730200325",
                                    "speaker": "派蒙",
                                    "text": "是啦，不过说起叶子…你们兰那罗难道不怕火吗，明明自己看上去也有很多叶子一样的成分…"
                                },
                                {
                                    "id": "730200326",
                                    "speaker": "兰茶荼",
                                    "text": "火当然是可怕的，有时森林中燃起的山火，会将一整座山头化为荒地…"
                                },
                                {
                                    "id": "730200327",
                                    "speaker": "兰茶荼",
                                    "text": "但是，毕竟是为了「烹饪修行」，忍住心中对于火的恐惧，控制火候的大小，也是修行的一环。"
                                },
                                {
                                    "id": "730200328",
                                    "speaker": "派蒙",
                                    "text": "原来如此…也是时候回去了，兰帕卡提还在等着你们呢！"
                                },
                                {
                                    "id": "730200329",
                                    "speaker": "兰茶荼",
                                    "text": "嗯。我马上就回桓那兰那。不然，让重要的「妹妹」担心，可不好。"
                                },
                                {
                                    "id": "730200330",
                                    "speaker": "兰茶荼",
                                    "text": "至于那几个家伙…兰萨卡、兰阿帕斯、兰非拉分别在<color=#00E1FFFF>化城郭附近</color>、<color=#00E1FFFF>水天丛林</color>和<color=#00E1FFFF>降诸魔山</color>。"
                                },
                                {
                                    "id": "730200331",
                                    "speaker": "兰茶荼",
                                    "text": "#谢谢你们。金灿灿的那菈{NICKNAME}，就如太阳般耀眼。派蒙，也有点了不起。妹妹的委托，就麻烦你们了。"
                                },
                                {
                                    "id": "730200332",
                                    "speaker": "派蒙",
                                    "text": "为什么到了我这里就变成了「有点了不起了呀」！"
                                },
                                {
                                    "id": "730200333",
                                    "speaker": "兰茶荼",
                                    "text": "哎呀，不要在意…总之，你们帮了我那么多，我都不知道该怎么报答你们…"
                                },
                                {
                                    "id": "730200334",
                                    "speaker": "兰茶荼",
                                    "text": "嗯，我决定将「至上珍馐」的做法教给二位。或许将来，长大以后，你们能明白个中滋味吧。"
                                },
                                {
                                    "id": "730200335",
                                    "speaker": "派蒙",
                                    "text": "#（{NICKNAME}，这个食谱，让我调整一下吧…应该有办法变成不错的原创菜式！）"
                                }
                            ]
                        },
                        {
                            "id": "730200314",
                            "text": "至少没有毒。"
                        },
                        {
                            "id": "730200315",
                            "text": "这种滋味对我来说或许有点太早了。"
                        }
                    ]
                }
