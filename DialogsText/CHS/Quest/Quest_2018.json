    "talks": [
        {
            "id": "201801",
            "objective": "(test)一天之后",
            "dialogues": []
        },
        {
            "id": "201802",
            "objective": "返回鸣神大社，找到八重神子",
            "dialogues": [
                {
                    "id": "20180201",
                    "speaker": "九条裟罗",
                    "text": "八重宫司大人，我如约来了。请放心，我没带随从来，这次行程也不会有人知道。"
                },
                {
                    "id": "20180202",
                    "speaker": "八重神子",
                    "text": "知道你会守约的，而且我猜…你这几天甚至会心烦意乱，夜不能寐吧？"
                },
                {
                    "id": "20180203",
                    "speaker": "九条裟罗",
                    "text": "我…我不会那样怀疑家主他们的，您过度揣测了。"
                },
                {
                    "id": "20180204",
                    "speaker": "九条裟罗",
                    "text": "那么，我要的证据在哪里？"
                },
                {
                    "id": "20180205",
                    "speaker": "Player",
                    "text": "在这里。"
                },
                {
                    "id": "20180206",
                    "speaker": "八重神子",
                    "text": "哦~另一个守约的人也来了。"
                },
                {
                    "id": "20180207",
                    "speaker": "派蒙",
                    "text": "为了拿到这些，可费了我们一番功夫呢。"
                },
                {
                    "id": "20180208",
                    "speaker": "八重神子",
                    "text": "交给裟罗看看吧，让她自己评判。"
                },
                {
                    "id": "20180209",
                    "speaker": "九条裟罗",
                    "text": "这是…"
                },
                {
                    "id": "20180210",
                    "speaker": "九条裟罗",
                    "text": "…这上面确实印有家主的官印，不像是造假…"
                },
                {
                    "id": "20180211",
                    "speaker": "九条裟罗",
                    "text": "反抗军，珊瑚宫，前线的事，居然只字未提…"
                },
                {
                    "id": "20180212",
                    "speaker": "九条裟罗",
                    "text": "前线那些阵亡的将士，人民在此间经受的困苦，全都不值一提吗！"
                },
                {
                    "id": "20180213",
                    "speaker": "九条裟罗",
                    "text": "也太小看人命了吧，究竟为何要如此隐瞒…"
                },
                {
                    "id": "20180214",
                    "speaker": "八重神子",
                    "text": "当然是为了让眼狩令顺利推行，不然把这些写进去的话，将军反悔了可怎么办呢？"
                },
                {
                    "id": "20180215",
                    "speaker": "九条裟罗",
                    "text": "天领奉行…果然在刻意蒙蔽将军吗？"
                },
                {
                    "id": "20180216",
                    "speaker": "八重神子",
                    "text": "是呢，再想想，眼狩令的推行…对谁更有利呢？"
                },
                {
                    "id": "20180217",
                    "speaker": "Player",
                    "text": "这里还有一封密信。"
                },
                {
                    "id": "20180218",
                    "speaker": "派蒙",
                    "text": "是天领奉行与愚人众的来往书信哦，还是被九条家的家主刻意藏起来的。"
                },
                {
                    "id": "20180219",
                    "speaker": "九条裟罗",
                    "text": "……"
                },
                {
                    "id": "20180220",
                    "speaker": "八重神子",
                    "text": "如何？你想看到的东西，你不想看到的东西，这样一来都摆在你面前了。"
                },
                {
                    "id": "20180221",
                    "speaker": "八重神子",
                    "text": "该不会…你还想要逃避吧？"
                },
                {
                    "id": "20180222",
                    "speaker": "九条裟罗",
                    "text": "我迄今为止所坚持的一切岂不是…居然…他们居然…可恶！"
                },
                {
                    "id": "20180223",
                    "speaker": "九条裟罗",
                    "text": "背叛的行为不可饶恕…我要去和家主当面对质！"
                },
                {
                    "id": "20180224",
                    "speaker": "派蒙",
                    "text": "九条裟罗真的很气愤呢，看样子策反成功了。",
                    "choices": [
                        {
                            "id": "20180225",
                            "text": "幕府军也会暂时群龙无首了。",
                            "response": [
                                {
                                    "id": "20180227",
                                    "speaker": "派蒙",
                                    "text": "嗯，我们去追她吧。"
                                },
                                {
                                    "id": "20180228",
                                    "speaker": "八重神子",
                                    "text": "等一下，旅行者，我还有话想要和你说。"
                                },
                                {
                                    "id": "20180229",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "20180230",
                                    "speaker": "八重神子",
                                    "text": "你第一次进入「一心净土」，是在千手百眼神像前吧？"
                                },
                                {
                                    "id": "20180231",
                                    "speaker": "Player",
                                    "text": "没错。"
                                },
                                {
                                    "id": "20180232",
                                    "speaker": "八重神子",
                                    "text": "你要想办法，重现那天的情景。"
                                },
                                {
                                    "id": "20180233",
                                    "speaker": "八重神子",
                                    "text": "在千手百眼神像前，再度让雷电将军「敞开心扉」的话，就一定有机会…"
                                },
                                {
                                    "id": "20180234",
                                    "speaker": "Player",
                                    "text": "我会尽力。"
                                },
                                {
                                    "id": "20180235",
                                    "speaker": "八重神子",
                                    "text": "把这个带在身上吧，作为饯别的礼物。"
                                },
                                {
                                    "id": "20180236",
                                    "speaker": "派蒙",
                                    "text": "这是…？"
                                },
                                {
                                    "id": "20180237",
                                    "speaker": "八重神子",
                                    "text": "鸣神大社的御守，可从来都是很灵验的，我特意给你留了一个。",
                                    "choices": [
                                        {
                                            "id": "20180238",
                                            "text": "谢谢…",
                                            "response": [
                                                {
                                                    "id": "20180240",
                                                    "speaker": "八重神子",
                                                    "text": "呵呵，遇到难解的危机的时候，就把它拿出来看看吧，危机或许就会迎刃而解。"
                                                },
                                                {
                                                    "id": "20180241",
                                                    "speaker": "八重神子",
                                                    "text": "当然，想我的时候也可以拿出来哦？说不定我会忽然蹦出来见你呢？"
                                                },
                                                {
                                                    "id": "20180242",
                                                    "speaker": "派蒙",
                                                    "text": "这种关头就别拿旅行者寻开心啦，狐狸小姐。"
                                                },
                                                {
                                                    "id": "20180243",
                                                    "speaker": "八重神子",
                                                    "text": "呵呵呵…不好意思，那么，我那位愚钝的朋友就拜托你们了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20180239",
                                            "text": "我会珍惜。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20180226",
                            "text": "跟上她，应该有机会见到雷电将军。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201803",
            "objective": "跟随九条裟罗前往天领奉行府",
            "dialogues": [
                {
                    "id": "20180301",
                    "speaker": "九条裟罗",
                    "text": "你们也跟来了么？胆量倒是不小。"
                },
                {
                    "id": "20180302",
                    "speaker": "九条裟罗",
                    "text": "你们作为证人，在我向家主求证之前，姑且可以先保你们不被就地逮捕。"
                },
                {
                    "id": "20180303",
                    "speaker": "九条裟罗",
                    "text": "不过…若证实你们之前的所言皆是诽谤，那你们不仅走不了，还会另有罪名加身，明白吧？",
                    "choices": [
                        {
                            "id": "20180304",
                            "text": "正合我意。",
                            "response": [
                                {
                                    "id": "20180306",
                                    "speaker": "九条裟罗",
                                    "text": "哼，很好。"
                                }
                            ]
                        },
                        {
                            "id": "20180305",
                            "text": "带路吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201805",
            "objective": "与九条裟罗对话",
            "dialogues": []
        },
        {
            "id": "201806",
            "objective": "跟随九条裟罗闯入天领奉行府",
            "dialogues": []
        },
        {
            "id": "201807",
            "objective": "击败天领奉行护卫",
            "dialogues": []
        },
        {
            "id": "201804",
            "objective": "与九条孝行对话",
            "dialogues": [
                {
                    "id": "20180403",
                    "speaker": "九条孝行",
                    "text": "住手！裟罗，你疯了吗！居然敢不顾我的禁令！"
                },
                {
                    "id": "20180404",
                    "speaker": "九条裟罗",
                    "text": "家主…"
                },
                {
                    "id": "20180405",
                    "speaker": "派蒙",
                    "text": "问啊，别被他的气势给压制了！"
                },
                {
                    "id": "20180406",
                    "speaker": "九条裟罗",
                    "text": "哼…孝行大人，我看过奉行府的上奏公文和写给愚人众的信件了，请您…给我一个交待！"
                },
                {
                    "id": "20180407",
                    "speaker": "九条孝行",
                    "text": "遗失的那些公文和信件，原来是被你拿走了么？哼…"
                },
                {
                    "id": "20180408",
                    "speaker": "九条裟罗",
                    "text": "您的这句话，我可以理解为…那些果真都是出自您的手笔，而并非伪造么？"
                },
                {
                    "id": "20180409",
                    "speaker": "九条裟罗",
                    "text": "请您告诉我，家主，告诉我天领奉行…真的背叛了幕府吗！"
                },
                {
                    "id": "20180410",
                    "speaker": "九条孝行",
                    "text": "哼…我的确与愚人众有所往来，你所见过的公文也的确出自我之手。"
                },
                {
                    "id": "20180411",
                    "speaker": "派蒙",
                    "text": "居然就这么承认了…"
                },
                {
                    "id": "20180412",
                    "speaker": "九条孝行",
                    "text": "只需要协助眼狩令的颁布和推行，就能拿到至冬使节承诺的那些好处…"
                },
                {
                    "id": "20180413",
                    "speaker": "九条孝行",
                    "text": "一直以来，觊觎九条家地位的人那么多，想把我们拉下马的家系也数不胜数。"
                },
                {
                    "id": "20180414",
                    "speaker": "九条孝行",
                    "text": "既能得到他国势力的大力支持，又可以借眼狩令削弱那些敌人的战力…"
                },
                {
                    "id": "20180415",
                    "speaker": "九条孝行",
                    "text": "我认为是一笔划算的买卖，只不过没必要知会你而已，裟罗。"
                },
                {
                    "id": "20180416",
                    "speaker": "九条裟罗",
                    "text": "你明明…明明一直都那么崇敬将军，为什么把背叛的事说得那么轻描淡写！"
                },
                {
                    "id": "20180417",
                    "speaker": "九条孝行",
                    "text": "背叛？这能算得上是背叛吗？"
                },
                {
                    "id": "20180418",
                    "speaker": "九条孝行",
                    "text": "那些愚人众不过是反过来被我利用罢了，他们又能成什么事？"
                },
                {
                    "id": "20180419",
                    "speaker": "九条孝行",
                    "text": "在稻妻的国土上，一旦天雷落下，他们不过是些只会瑟瑟发抖的蝼蚁罢了，绝不敢造次。"
                },
                {
                    "id": "20180420",
                    "speaker": "九条孝行",
                    "text": "毕竟——"
                },
                {
                    "id": "20180421",
                    "speaker": "九条孝行",
                    "text": "我们可拥有着天下无双的雷电将军，拥有着那「无想的一刀」啊！",
                    "choices": [
                        {
                            "id": "20180422",
                            "text": "并非蓄意背叛雷电将军…",
                            "response": [
                                {
                                    "id": "20180424",
                                    "speaker": "派蒙",
                                    "text": "嗯…他崇拜的与其说是雷电将军，倒不如说是雷电将军的武艺以及「无想的一刀」吧？而且，已经近乎狂热了…"
                                },
                                {
                                    "id": "20180425",
                                    "speaker": "九条裟罗",
                                    "text": "可是，你的忠义之心呢，家主…"
                                },
                                {
                                    "id": "20180426",
                                    "speaker": "九条裟罗",
                                    "text": "自从被九条家收养以来，是你一直在教导我身为臣下的忠义之道…"
                                },
                                {
                                    "id": "20180427",
                                    "speaker": "九条裟罗",
                                    "text": "如此看来，你们只是想我忠于九条家，担心我有朝一日会背叛而已吧？"
                                },
                                {
                                    "id": "20180428",
                                    "speaker": "九条裟罗",
                                    "text": "那些大道理，不过是你遮掩自己的丑恶与自私的工具！"
                                },
                                {
                                    "id": "20180429",
                                    "speaker": "九条孝行",
                                    "text": "自私？我也是在守护着属于九条家的永恒啊，我相信将军大人她会理解我的，前家主大人他…也一定会理解我的。"
                                },
                                {
                                    "id": "20180430",
                                    "speaker": "派蒙",
                                    "text": "虽然不想这么说，但九条家也太自大了，愚人众恐怕没那么好对付…",
                                    "choices": [
                                        {
                                            "id": "20180431",
                                            "text": "继续和他辩论也没有意义了…",
                                            "response": [
                                                {
                                                    "id": "20180433",
                                                    "speaker": "九条裟罗",
                                                    "text": "我也曾在内心怀疑过，执行眼狩令真的是正确的吗？哪怕违背我心中的道义也在所不惜吗？"
                                                },
                                                {
                                                    "id": "20180434",
                                                    "speaker": "九条裟罗",
                                                    "text": "可我还是下定决心，只要那是将军所指引的道路，在走到终点之前，又有谁可论对与错呢？"
                                                },
                                                {
                                                    "id": "20180435",
                                                    "speaker": "九条裟罗",
                                                    "text": "但直到现在我才知道，永恒之路本就没有终点，而且这条路…又早就因为你们的私心而沾满污秽了。"
                                                },
                                                {
                                                    "id": "20180436",
                                                    "speaker": "九条裟罗",
                                                    "text": "所以，我要去纠正圣听，至少给我迄今为止的决心一个交待！"
                                                },
                                                {
                                                    "id": "20180437",
                                                    "speaker": "九条孝行",
                                                    "text": "冥顽不灵，多此一举…"
                                                },
                                                {
                                                    "id": "20180438",
                                                    "speaker": "九条孝行",
                                                    "text": "你要去便去吧，如今谁也别想动摇九条家的地位，时局也不会因你而有什么改变的。"
                                                },
                                                {
                                                    "id": "20180439",
                                                    "speaker": "九条孝行",
                                                    "text": "将军此时正在<color=#00E1FFFF>天守阁</color>，接见来自至冬的使节——那位被称为「女士」的执行官。"
                                                },
                                                {
                                                    "id": "20180440",
                                                    "speaker": "Player",
                                                    "text": "「女士」！"
                                                },
                                                {
                                                    "id": "20180441",
                                                    "speaker": "派蒙",
                                                    "text": "稻妻幕后的始作俑者，又是「女士」吗！"
                                                },
                                                {
                                                    "id": "20180442",
                                                    "speaker": "派蒙",
                                                    "text": "早在离岛的时候，千里小姐似乎也提到过，勘定奉行跟一位趾高气昂的女士见过面…那时就应该猜到了…"
                                                },
                                                {
                                                    "id": "20180443",
                                                    "speaker": "九条裟罗",
                                                    "text": "至冬的使节…正巧，她别以为自己可以从稻妻全身而退！"
                                                },
                                                {
                                                    "id": "20180444",
                                                    "speaker": "派蒙",
                                                    "text": "裟罗冲出去了，是准备直接去闯天守阁吗？"
                                                },
                                                {
                                                    "id": "20180445",
                                                    "speaker": "Player",
                                                    "text": "我们也有很多账，要找「女士」清算。"
                                                },
                                                {
                                                    "id": "20180446",
                                                    "speaker": "派蒙",
                                                    "text": "没错！"
                                                },
                                                {
                                                    "id": "20180447",
                                                    "speaker": "派蒙",
                                                    "text": "那走吧，我们也过去！"
                                                },
                                                {
                                                    "id": "20180448",
                                                    "speaker": "九条裟罗",
                                                    "text": "我们去<color=#00E1FFFF>天守阁</color>！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20180432",
                                            "text": "还是要看九条裟罗的态度。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20180423",
                            "text": "而是过分相信雷电将军的武艺。"
                        }
                    ]
                }
            ]
        },
