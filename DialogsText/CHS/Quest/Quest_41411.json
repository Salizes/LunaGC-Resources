    "talks": [
        {
            "id": "4141115",
            "objective": "前往西风骑士团",
            "dialogues": [
                {
                    "id": "414111501",
                    "speaker": "派蒙",
                    "text": "温迪应该已经到了，进去看看吧！"
                },
                {
                    "id": "414111502",
                    "speaker": "阿托",
                    "text": "请留步！几位，有何贵干？"
                },
                {
                    "id": "414111503",
                    "speaker": "派蒙",
                    "text": "凯亚在吗？我们找他有事。"
                },
                {
                    "id": "414111504",
                    "speaker": "阿托",
                    "text": "找凯亚队长的话，他在琴团长办公室执勤。"
                },
                {
                    "id": "414111505",
                    "speaker": "派蒙",
                    "text": "咦，怎么在琴团长办公室里？"
                },
                {
                    "id": "414111506",
                    "speaker": "阿托",
                    "text": "风花节庆典一直是由我们西风骑士团主办，庆典期间，琴团长会亲自外出巡逻。"
                },
                {
                    "id": "414111507",
                    "speaker": "阿托",
                    "text": "积压的书案工作，就交由凯亚队长代理了。"
                },
                {
                    "id": "414111508",
                    "speaker": "派蒙",
                    "text": "原来如此。"
                }
            ]
        },
        {
            "id": "4141101",
            "objective": "收取凯亚的作业",
            "dialogues": [
                {
                    "id": "414110101",
                    "speaker": "派蒙",
                    "text": "哟哈！"
                },
                {
                    "id": "414110102",
                    "speaker": "温迪",
                    "text": "旅行者，派蒙，你们来了。"
                },
                {
                    "id": "414110103",
                    "speaker": "凯亚",
                    "text": "我才想到你们，你们就来了，真巧。"
                },
                {
                    "id": "414110104",
                    "speaker": "派蒙",
                    "text": "凯亚，你的作业写完了吗？"
                },
                {
                    "id": "414110105",
                    "speaker": "凯亚",
                    "text": "恐怕要让你失望了，我还没开始写。"
                },
                {
                    "id": "414110106",
                    "speaker": "温迪",
                    "text": "不交作业的学生可不是好学生。"
                },
                {
                    "id": "414110107",
                    "speaker": "派蒙",
                    "text": "凯亚不做作业是在忙什么呢？"
                },
                {
                    "id": "414110108",
                    "speaker": "凯亚",
                    "text": "嗯~如你所见，在帮琴团长处理各种事务。"
                },
                {
                    "id": "414110109",
                    "speaker": "凯亚",
                    "text": "庆典期间蒙德城里热闹得很，随之而来的杂事也多得可怕。我已经忙了好久啦。"
                },
                {
                    "id": "414110110",
                    "speaker": "凯亚",
                    "text": "旅行者，能请你帮个忙吗？"
                },
                {
                    "id": "414110111",
                    "speaker": "凯亚",
                    "text": "有位酒友托我办事，但我实在脱不开身…想请你代我跑一趟。"
                },
                {
                    "id": "414110112",
                    "speaker": "温迪",
                    "text": "酒友，是在酒馆认识的朋友？"
                },
                {
                    "id": "414110113",
                    "speaker": "凯亚",
                    "text": "是啊。下班偶尔去酒馆喝一杯，不知不觉结交了许多朋友呢。"
                },
                {
                    "id": "414110114",
                    "speaker": "凯亚",
                    "text": "他叫宁禄，一般会在酒馆附近出没。这个时间，我猜他应该闲着。"
                },
                {
                    "id": "414110115",
                    "speaker": "凯亚",
                    "text": "我得留下来写作业，宁禄的事就麻烦你了。",
                    "choices": [
                        {
                            "id": "414110116",
                            "text": "凯亚，作业加油哦。"
                        },
                        {
                            "id": "414110117",
                            "text": "好吧，也算是融入庆典。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4141114",
            "objective": "在酒馆外寻找宁禄",
            "dialogues": [
                {
                    "id": "414111401",
                    "speaker": "宁禄",
                    "text": "唉，怎么办才好…"
                },
                {
                    "id": "414111402",
                    "speaker": "派蒙",
                    "text": "你就是宁禄吗？凯亚说你找他有事，他现在走不开，让我们来帮你。"
                },
                {
                    "id": "414111403",
                    "speaker": "宁禄",
                    "text": "嗯？旅行者，没想到是你。"
                },
                {
                    "id": "414111404",
                    "speaker": "宁禄",
                    "text": "是这样的，我在为我太太准备风花节的礼物，想麻烦酒友凯亚出个主意。"
                },
                {
                    "id": "414111405",
                    "speaker": "宁禄",
                    "text": "呃…我、我这人，酒瘾有些重，三天两头泡在酒馆。我太太反对我喝酒，为此我们总是吵架。"
                },
                {
                    "id": "414111406",
                    "speaker": "派蒙",
                    "text": "原来你是个酒鬼呀…"
                },
                {
                    "id": "414111407",
                    "speaker": "温迪",
                    "text": "我明白，酒是好东西！不过你这样的喝法，嗯…"
                },
                {
                    "id": "414111408",
                    "speaker": "宁禄",
                    "text": "道理我都懂，所以才觉得，有些对不起她。"
                },
                {
                    "id": "414111409",
                    "speaker": "宁禄",
                    "text": "旅行者，能麻烦你们帮我搜集材料吗？我想亲手制作一份礼物送给我太太。"
                },
                {
                    "id": "414111410",
                    "speaker": "宁禄",
                    "text": "按理说我得自己准备，可最近酒喝多了，一不留神睡了过去。醒来时庆典已经开始啦！凭我自己，多半是来不及了…"
                },
                {
                    "id": "414111411",
                    "speaker": "派蒙",
                    "text": "这人也太乱来了吧。"
                },
                {
                    "id": "414111412",
                    "speaker": "温迪",
                    "text": "未婚的蒙德人可不敢在庆典期间托人办事，宁禄，还好你已经结婚了。"
                },
                {
                    "id": "414111413",
                    "speaker": "宁禄",
                    "text": "哎哎，是啊…真抱歉，让你们看笑话了。"
                },
                {
                    "id": "414111414",
                    "speaker": "派蒙",
                    "text": "真没办法。说吧，需要什么？"
                },
                {
                    "id": "414111415",
                    "speaker": "宁禄",
                    "text": "我会在城里搜索木材，用于填充的植物只能到野外采集，就拜托你们了。我需要2株小灯草。"
                },
                {
                    "id": "414111416",
                    "speaker": "派蒙",
                    "text": "小灯草和木板，能做出什么？"
                },
                {
                    "id": "414111417",
                    "speaker": "宁禄",
                    "text": "我想用木板搭一间小房子，配上发光的花朵和手工制作的小家具…送给她。"
                },
                {
                    "id": "414111418",
                    "speaker": "温迪",
                    "text": "很温情的礼物呢。"
                },
                {
                    "id": "414111419",
                    "speaker": "宁禄",
                    "text": "一点心意，哈哈。我刚认识她那会儿，经常给她做手工小礼物，她非常喜欢，还说…"
                },
                {
                    "id": "414111420",
                    "speaker": "宁禄",
                    "text": "啊！咳咳，抱歉，以前的事就不提了。总之，麻烦各位啦。"
                },
                {
                    "id": "414111421",
                    "speaker": "派蒙",
                    "text": "算你运气好，遇到我们这么好心的帮手。"
                },
                {
                    "id": "414111422",
                    "speaker": "派蒙",
                    "text": "走吧！去找他要的东西！"
                }
            ]
        },
        {
            "id": "4141102",
            "objective": "搜集两株小灯草",
            "dialogues": [
                {
                    "id": "414110201",
                    "speaker": "宁禄",
                    "text": "好久没做木工了，但愿一切顺利。"
                }
            ]
        },
        {
            "id": "4141103",
            "objective": "与宁禄对话",
            "dialogues": [
                {
                    "id": "414110301",
                    "speaker": "宁禄",
                    "text": "谢谢，谢谢你们！有了这个，我马上就能开工。"
                },
                {
                    "id": "414110302",
                    "speaker": "派蒙",
                    "text": "不要只是做礼物，以后也要好好对你太太呀！"
                },
                {
                    "id": "414110303",
                    "speaker": "宁禄",
                    "text": "一定，一定。"
                },
                {
                    "id": "414110304",
                    "speaker": "宁禄",
                    "text": "唉，要是我做的这些礼物能让她喜欢就好了。"
                },
                {
                    "id": "414110305",
                    "speaker": "温迪",
                    "text": "没人不喜欢饱含情意的礼物，放心吧。"
                },
                {
                    "id": "414110306",
                    "speaker": "派蒙",
                    "text": "好好做哦，不要浪费了我们辛辛苦苦找来的材料。"
                }
            ]
        },
        {
            "id": "4141105",
            "objective": "回骑士团向凯亚汇报",
            "dialogues": [
                {
                    "id": "414110501",
                    "speaker": "派蒙",
                    "text": "我们回来啦！凯亚，你写完了吗？"
                },
                {
                    "id": "414110502",
                    "speaker": "温迪",
                    "text": "老师要来收作业啦！"
                },
                {
                    "id": "414110503",
                    "speaker": "凯亚",
                    "text": "欢迎回来，我这边刚好也差不多了。"
                },
                {
                    "id": "414110504",
                    "speaker": "派蒙",
                    "text": "快快快，交作业交作业~"
                },
                {
                    "id": "414110505",
                    "speaker": "凯亚",
                    "text": "来了来了，别笑话我就行。"
                },
                {
                    "id": "414110506",
                    "speaker": "温迪",
                    "text": "嗯…嗯？唔唔。"
                },
                {
                    "id": "414110507",
                    "speaker": "派蒙",
                    "text": "卖唱的，点评一下？"
                },
                {
                    "id": "414110508",
                    "speaker": "温迪",
                    "text": "凯亚，我可以把这首诗读出来吗？"
                },
                {
                    "id": "414110509",
                    "speaker": "凯亚",
                    "text": "请吧。"
                },
                {
                    "id": "414110510",
                    "speaker": "温迪",
                    "text": "咳咳！"
                },
                {
                    "id": "414110511",
                    "speaker": "温迪",
                    "text": "「mi muhe ye\\n在丘丘人的语言里\\n是我爱你。」"
                },
                {
                    "id": "414110512",
                    "speaker": "派蒙",
                    "text": "嗯？嗯？？"
                },
                {
                    "id": "414110513",
                    "speaker": "温迪",
                    "text": "读完了。"
                },
                {
                    "id": "414110514",
                    "speaker": "派蒙",
                    "text": "没啦？"
                },
                {
                    "id": "414110515",
                    "speaker": "凯亚",
                    "text": "主旨清晰，表达到位，我认为这种长度足够了。"
                },
                {
                    "id": "414110516",
                    "speaker": "派蒙",
                    "text": "哎哎哎？！完全就是丘丘语教学啊！",
                    "choices": [
                        {
                            "id": "414110517",
                            "text": "太扯了，根本没有爱。",
                            "response": [
                                {
                                    "id": "414110519",
                                    "speaker": "凯亚",
                                    "text": "哈哈哈，不觉得是很有我风格的情诗吗？"
                                },
                                {
                                    "id": "414110520",
                                    "speaker": "温迪",
                                    "text": "更像是敷衍的情诗呢。"
                                },
                                {
                                    "id": "414110521",
                                    "speaker": "派蒙",
                                    "text": "凯亚居然会丘丘人语？好奇怪啊。"
                                },
                                {
                                    "id": "414110522",
                                    "speaker": "凯亚",
                                    "text": "哈哈，别小看西风骑士团骑兵队长的知识储备哦！"
                                },
                                {
                                    "id": "414110523",
                                    "speaker": "温迪",
                                    "text": "好了，是时候去收下一份…"
                                },
                                {
                                    "id": "414110524",
                                    "speaker": "凯亚",
                                    "text": "——！！"
                                },
                                {
                                    "id": "414110525",
                                    "speaker": "凯亚",
                                    "text": "刚刚似乎有道可疑的人影，我得去看一下。旅行者，还有件小事麻烦你。"
                                },
                                {
                                    "id": "414110526",
                                    "speaker": "凯亚",
                                    "text": "教会向我们申请了狩猎许可，得请你把这份许可文书送到大教堂。"
                                },
                                {
                                    "id": "414110527",
                                    "speaker": "派蒙",
                                    "text": "唉，我们又要跑腿啦。"
                                }
                            ]
                        },
                        {
                            "id": "414110518",
                            "text": "太棒了，学到许多。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4141106",
            "objective": "前往蒙德大教堂",
            "dialogues": []
        },
        {
            "id": "4141107",
            "objective": "与琴和丽莎对话",
            "dialogues": [
                {
                    "id": "414110701",
                    "speaker": "琴",
                    "text": "丽莎，我们约法三章，就算是阻止街头闹事的醉汉也不能用法术电他们，好吗？"
                },
                {
                    "id": "414110702",
                    "speaker": "丽莎",
                    "text": "琴误会了呢。上次你看到那一幕，是醉鬼主动恳求的哦。所以我想，也许有人就喜欢这样…"
                },
                {
                    "id": "414110703",
                    "speaker": "琴",
                    "text": "丽莎！"
                },
                {
                    "id": "414110704",
                    "speaker": "丽莎",
                    "text": "好吧，既然琴反对，那就算了。"
                },
                {
                    "id": "414110705",
                    "speaker": "派蒙",
                    "text": "琴团长，丽莎小姐！"
                },
                {
                    "id": "414110706",
                    "speaker": "温迪",
                    "text": "二位，好久不见了。"
                },
                {
                    "id": "414110707",
                    "speaker": "Player",
                    "text": "你们在这里做什么呢？"
                },
                {
                    "id": "414110708",
                    "speaker": "琴",
                    "text": "好久不见了。如各位所见，我和丽莎正在执勤。"
                },
                {
                    "id": "414110709",
                    "speaker": "丽莎",
                    "text": "#是小可爱和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的朋友们呀。来的路上有看到什么奇怪的人吗？发现怪人怪事可以向骑士团举报哦。"
                },
                {
                    "id": "414110710",
                    "speaker": "派蒙",
                    "text": "图书管理员也要巡逻的吗？"
                },
                {
                    "id": "414110711",
                    "speaker": "丽莎",
                    "text": "一般不用，但风花节期间人手紧缺，就连我这样的小人物，也被叫出来执勤了呢。"
                },
                {
                    "id": "414110712",
                    "speaker": "琴",
                    "text": "丽莎，小人物可不会具有你那样强大的雷元素力。"
                },
                {
                    "id": "414110713",
                    "speaker": "琴",
                    "text": "不过各位请放心，我会监督好丽莎的。就算她喜欢用电击的方式分开斗殴市民、把惹事醉汉电到求饶…"
                },
                {
                    "id": "414110714",
                    "speaker": "丽莎",
                    "text": "琴不喜欢的话，我就不这样好了。"
                },
                {
                    "id": "414110715",
                    "speaker": "琴",
                    "text": "是吗？那太好了，否则我真要考虑吊销图书管理员小姐与我一同巡逻的资格了。"
                },
                {
                    "id": "414110716",
                    "speaker": "派蒙",
                    "text": "原来巡逻是这么刺激的活动啊，长、长见识了。"
                }
            ]
        },
        {
            "id": "4141108",
            "objective": "与芭芭拉对话",
            "dialogues": [
                {
                    "id": "414110801",
                    "speaker": "派蒙",
                    "text": "芭芭拉，我们受凯亚委托来送…"
                },
                {
                    "id": "414110802",
                    "speaker": "班尼特",
                    "text": "太过分了，这是恐吓！"
                },
                {
                    "id": "414110803",
                    "speaker": "芭芭拉",
                    "text": "怎么会这样…"
                },
                {
                    "id": "414110804",
                    "speaker": "派蒙",
                    "text": "呜呃？！"
                },
                {
                    "id": "414110805",
                    "speaker": "温迪",
                    "text": "出什么事了吗？"
                },
                {
                    "id": "414110806",
                    "speaker": "芭芭拉",
                    "text": "我、我收到一封信，上面…上面…"
                },
                {
                    "id": "414110807",
                    "speaker": "班尼特",
                    "text": "我来说吧。我刚从野外回来，惯例来教堂请修女们帮忙包扎，却看到芭芭拉小姐脸色发白地跑出来，手里举着一封信。"
                },
                {
                    "id": "414110808",
                    "speaker": "芭芭拉",
                    "text": "我还是第一次收到这样的信件…"
                },
                {
                    "id": "414110809",
                    "speaker": "温迪",
                    "text": "可以给我看一下吗？"
                },
                {
                    "id": "414110810",
                    "speaker": "温迪",
                    "text": "「致敬爱的芭芭拉小姐：偷走你最重要的东西埋在土里」…啊呀，难道说，这是一封恐吓信？"
                },
                {
                    "id": "414110811",
                    "speaker": "班尼特",
                    "text": "可恶，是恶作剧吗？如果是恶作剧就算了，只怕、只怕…"
                },
                {
                    "id": "414110812",
                    "speaker": "芭芭拉",
                    "text": "只怕…万一是真的…"
                },
                {
                    "id": "414110813",
                    "speaker": "派蒙",
                    "text": "背面还画着地图，看起来像是在野外。"
                },
                {
                    "id": "414110814",
                    "speaker": "班尼特",
                    "text": "偷走你最重要的东西…"
                },
                {
                    "id": "414110815",
                    "speaker": "温迪",
                    "text": "埋在土里…"
                },
                {
                    "id": "414110816",
                    "speaker": "班尼特",
                    "text": "地图上这个地方，我一定去过，好眼熟。"
                },
                {
                    "id": "414110817",
                    "speaker": "Player",
                    "text": "最重要的东西是什么？"
                },
                {
                    "id": "414110818",
                    "speaker": "芭芭拉",
                    "text": "我现在脑子很乱，一下想不…啊！"
                },
                {
                    "id": "414110819",
                    "speaker": "班尼特",
                    "text": "我马上就能想起来…马上就能想起来…"
                },
                {
                    "id": "414110820",
                    "speaker": "芭芭拉",
                    "text": "最重要的东西，等等，难道说！"
                },
                {
                    "id": "414110821",
                    "speaker": "派蒙",
                    "text": "芭芭拉！哎，等等！"
                },
                {
                    "id": "414110822",
                    "speaker": "班尼特",
                    "text": "啊！我想起来了，是千风神殿！"
                },
                {
                    "id": "414110823",
                    "speaker": "温迪",
                    "text": "喂，班尼特！"
                },
                {
                    "id": "414110824",
                    "speaker": "派蒙",
                    "text": "怎么就跑了呀？我们也快跟上去！"
                }
            ]
        },
        {
            "id": "4141109",
            "objective": "追上芭芭拉",
            "dialogues": []
        },
        {
            "id": "4141110",
            "objective": "与芭芭拉和罗莎莉亚对话",
            "dialogues": [
                {
                    "id": "414111001",
                    "speaker": "芭芭拉",
                    "text": "姐姐！"
                },
                {
                    "id": "414111002",
                    "speaker": "罗莎莉亚",
                    "text": "站住。"
                },
                {
                    "id": "414111003",
                    "speaker": "芭芭拉",
                    "text": "罗莎莉亚！我刚才…"
                },
                {
                    "id": "414111004",
                    "speaker": "罗莎莉亚",
                    "text": "冷静下来！"
                },
                {
                    "id": "414111005",
                    "speaker": "罗莎莉亚",
                    "text": "刚才我在街上遇到琴团长了，丽莎小姐也在她身边，不会有事的。"
                },
                {
                    "id": "414111006",
                    "speaker": "芭芭拉",
                    "text": "啊！是、是这样吗？！"
                },
                {
                    "id": "414111007",
                    "speaker": "芭芭拉",
                    "text": "呼！"
                },
                {
                    "id": "414111008",
                    "speaker": "罗莎莉亚",
                    "text": "……"
                },
                {
                    "id": "414111009",
                    "speaker": "罗莎莉亚",
                    "text": "那封信，给我看看。"
                },
                {
                    "id": "414111010",
                    "speaker": "温迪",
                    "text": "好的~"
                },
                {
                    "id": "414111011",
                    "speaker": "芭芭拉",
                    "text": "如果不是琴团长…那这封信上说的究竟是什么呢？"
                },
                {
                    "id": "414111012",
                    "speaker": "派蒙",
                    "text": "你居然认为琴团长会被埋进土里，这个想法才吓人吧！"
                },
                {
                    "id": "414111013",
                    "speaker": "温迪",
                    "text": "修女小姐，有什么线索吗？"
                },
                {
                    "id": "414111014",
                    "speaker": "罗莎莉亚",
                    "text": "看这张地图，犯人画的应该是晨曦酒庄附近。"
                },
                {
                    "id": "414111015",
                    "speaker": "罗莎莉亚",
                    "text": "那里的地形相对开阔，把东西藏在那里…哼，会是什么呢？"
                },
                {
                    "id": "414111016",
                    "speaker": "派蒙",
                    "text": "好厉害，一眼就能看出来…"
                },
                {
                    "id": "414111017",
                    "speaker": "派蒙",
                    "text": "不过，晨曦酒庄？似乎和刚才听见的某个地名不太一样呢…"
                },
                {
                    "id": "414111018",
                    "speaker": "芭芭拉",
                    "text": "……"
                },
                {
                    "id": "414111019",
                    "speaker": "罗莎莉亚",
                    "text": "芭芭拉，与其在这里被想象折磨，不如直面问题。"
                },
                {
                    "id": "414111020",
                    "speaker": "芭芭拉",
                    "text": "嗯，你说得对，我只是…"
                },
                {
                    "id": "414111021",
                    "speaker": "温迪",
                    "text": "哈哈，是在害怕吧？那我们陪你一起去，如何？"
                },
                {
                    "id": "414111022",
                    "speaker": "芭芭拉",
                    "text": "哎？各位…"
                },
                {
                    "id": "414111023",
                    "speaker": "温迪",
                    "text": "这位修女小姐要同行吗？"
                },
                {
                    "id": "414111024",
                    "speaker": "罗莎莉亚",
                    "text": "我就不必了。一看就知道，不是什么大事。"
                },
                {
                    "id": "414111025",
                    "speaker": "派蒙",
                    "text": "嗯？她刚才说什么？"
                },
                {
                    "id": "414111026",
                    "speaker": "罗莎莉亚",
                    "text": "没什么。你们去吧。"
                },
                {
                    "id": "414111027",
                    "speaker": "温迪",
                    "text": "芭芭拉小姐，你好点了吗？"
                },
                {
                    "id": "414111028",
                    "speaker": "芭芭拉",
                    "text": "嗯！我、我没事的。"
                },
                {
                    "id": "414111029",
                    "speaker": "芭芭拉",
                    "text": "罗莎莉亚说得对，与其自己吓自己，不如直接去领教犯人的手段。"
                },
                {
                    "id": "414111030",
                    "speaker": "派蒙",
                    "text": "没错没错，我们几个一起去！"
                },
                {
                    "id": "414111031",
                    "speaker": "芭芭拉",
                    "text": "谢谢各位，那我们现在就去地图指向的地方看看吧。"
                },
                {
                    "id": "414111032",
                    "speaker": "派蒙",
                    "text": "好，芭芭拉冲呀——！"
                }
            ]
        },
        {
            "id": "4141111",
            "objective": "前往地图所示之处",
            "dialogues": []
        },
        {
            "id": "4141116",
            "objective": "击败盗宝团$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4141112",
            "objective": "击败盗宝团",
            "dialogues": []
        },
        {
            "id": "4141104",
            "objective": "挖出宝物",
            "dialogues": []
        },
        {
            "id": "4141113",
            "objective": "与芭芭拉对话",
            "dialogues": [
                {
                    "id": "414111302",
                    "speaker": "派蒙",
                    "text": "这是什么，快打开看看！"
                },
                {
                    "id": "414111303",
                    "speaker": "芭芭拉",
                    "text": "我、我…"
                },
                {
                    "id": "414111304",
                    "speaker": "温迪",
                    "text": "这么精致的礼盒，却出现在这种荒郊野岭，好有意思。"
                },
                {
                    "id": "414111305",
                    "speaker": "芭芭拉",
                    "text": "……咦？！"
                },
                {
                    "id": "414111306",
                    "speaker": "派蒙",
                    "text": "哇，好精致的风车菊花环，还有很多纸星星！",
                    "choices": [
                        {
                            "id": "414111307",
                            "text": "是恶作剧吗？",
                            "response": [
                                {
                                    "id": "414111309",
                                    "speaker": "温迪",
                                    "text": "所谓的「犯人」好像是芭芭拉小姐的粉丝呢。"
                                },
                                {
                                    "id": "414111310",
                                    "speaker": "派蒙",
                                    "text": "还有张字条，写了什么呢？我看看…唔…"
                                },
                                {
                                    "id": "414111311",
                                    "speaker": "派蒙",
                                    "text": "「很抱歉用这样的方式吸引您，为您的美德与可爱献上饱含诚意的风之花。」"
                                },
                                {
                                    "id": "414111312",
                                    "speaker": "派蒙",
                                    "text": "哈？以恐吓为手段的骗局？"
                                },
                                {
                                    "id": "414111313",
                                    "speaker": "温迪",
                                    "text": "无论是对神明还是对重要、挚爱之人，都要以最饱满的情感献上鲜花。这才是如今风花节的核心仪式。"
                                },
                                {
                                    "id": "414111314",
                                    "speaker": "温迪",
                                    "text": "为了在特殊的节日里向你送出爱与祝福之花，不惜选择引人瞩目的手段。"
                                },
                                {
                                    "id": "414111315",
                                    "speaker": "温迪",
                                    "text": "看似吓人，背后却是精心准备的礼物。"
                                },
                                {
                                    "id": "414111316",
                                    "speaker": "派蒙",
                                    "text": "呜，真离谱…怎么听都是个没分寸的家伙…"
                                },
                                {
                                    "id": "414111317",
                                    "speaker": "温迪",
                                    "text": "哈哈哈，确实。这样的人选，我心中似乎有一个哦？"
                                },
                                {
                                    "id": "414111318",
                                    "speaker": "派蒙",
                                    "text": "你说的是谁呀？"
                                },
                                {
                                    "id": "414111319",
                                    "speaker": "Player",
                                    "text": "（我好像也想到了呢。）"
                                },
                                {
                                    "id": "414111320",
                                    "speaker": "温迪",
                                    "text": "嘘…不要说出来，让小派蒙猜一会儿。"
                                },
                                {
                                    "id": "414111321",
                                    "speaker": "派蒙",
                                    "text": "啊！怎么这样啊——！"
                                }
                            ]
                        },
                        {
                            "id": "414111308",
                            "text": "是引起注意的手段吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4141199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414119901",
                    "speaker": "凯亚",
                    "text": "慢慢来，给我点时间酝酿诗意。"
                }
            ]
        }
    ]
}