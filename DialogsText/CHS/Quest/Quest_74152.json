    "talks": [
        {
            "id": "7415201",
            "objective": "(test)派蒙对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "741520101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你是不是想到什么了？$UNRELEASED",
                    "choices": [
                        {
                            "id": "741520102",
                            "text": "这对夫妇不对劲。$UNRELEASED",
                            "response": [
                                {
                                    "id": "741520103",
                                    "speaker": "派蒙",
                                    "text": "我也觉得有点奇怪，他们一个话特别多，一个话特别少。$UNRELEASED"
                                },
                                {
                                    "id": "741520104",
                                    "speaker": "Player",
                                    "text": "他们出现的时机太巧合了。$UNRELEASED",
                                    "choices": [
                                        {
                                            "id": "741520107",
                                            "text": "这对夫妇出现并成为了他的养女和女婿。$UNRELEASED"
                                        },
                                        {
                                            "id": "741520109",
                                            "text": "这对夫妇和伯努瓦的关系不对劲。$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "741520110",
                                                    "speaker": "派蒙",
                                                    "text": "前些天遇到的时候他们还和和睦睦的呢，今天看他们交谈的时候总觉得哪里有点便扭…$UNRELEASED",
                                                    "choices": [
                                                        {
                                                            "id": "741520111",
                                                            "text": "伯努瓦在被女婿胁迫。$UNRELEASED",
                                                            "response": [
                                                                {
                                                                    "id": "741520112",
                                                                    "speaker": "派蒙",
                                                                    "text": "是因为他才说了两句话，那个女婿就使眼色让他进去吗？$UNRELEASED"
                                                                },
                                                                {
                                                                    "id": "741520115",
                                                                    "speaker": "派蒙",
                                                                    "text": "听你这么分析，我有点明白心里那个困惑的感觉是怎么回事了。$UNRELEASED"
                                                                },
                                                                {
                                                                    "id": "741520123",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}，你说，伯努瓦他是不是陷入了什么危险？$UNRELEASED"
                                                                },
                                                                {
                                                                    "id": "741520124",
                                                                    "speaker": "Player",
                                                                    "text": "没错。$UNRELEASED"
                                                                },
                                                                {
                                                                    "id": "741520125",
                                                                    "speaker": "派蒙",
                                                                    "text": "我感觉很不好，我们要不要去报案啊？去和执律庭说一说吧。$UNRELEASED",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741520126",
                                                                            "text": "没有证据。$UNRELEASED",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741520129",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这样啊，你说的也有道理。总之，我们是要帮助伯努瓦的对吧？$UNRELEASED"
                                                                                },
                                                                                {
                                                                                    "id": "741520130",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "小茉莉拜托过我们，要告诉伯努瓦，他给的点心非常好吃，我们答应过她的。$UNRELEASED"
                                                                                },
                                                                                {
                                                                                    "id": "741520131",
                                                                                    "speaker": "Player",
                                                                                    "text": "我们会做到的。$UNRELEASED"
                                                                                },
                                                                                {
                                                                                    "id": "741520132",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我就知道你说到做到，而且脑子好使，那我们接下来怎么做？$UNRELEASED"
                                                                                },
                                                                                {
                                                                                    "id": "741520133",
                                                                                    "speaker": "Player",
                                                                                    "text": "去调查一番吧。$UNRELEASED"
                                                                                },
                                                                                {
                                                                                    "id": "741520134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "就由我们来弄清楚到底发生了什么吧！唔…具体来说，我们要调查些什么啊？$UNRELEASED",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "741520135",
                                                                                            "text": "这对夫妇的身份。$UNRELEASED",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "741520138",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#对对对，真相就由我们来揭穿吧！名侦探派蒙、{NICKNAME}出动！$UNRELEASED"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "741520136",
                                                                                            "text": "这对夫妇的目的。$UNRELEASED"
                                                                                        },
                                                                                        {
                                                                                            "id": "741520137",
                                                                                            "text": "伯努瓦对他们的态度。$UNRELEASED"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741520127",
                                                                            "text": "事情还不明朗。$UNRELEASED"
                                                                        },
                                                                        {
                                                                            "id": "741520128",
                                                                            "text": "不知道伯努瓦的态度。$UNRELEASED"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741520113",
                                                            "text": "伯努瓦在被女儿胁迫。$UNRELEASED",
                                                            "response": [
                                                                {
                                                                    "id": "741520114",
                                                                    "speaker": "派蒙",
                                                                    "text": "我是没你想得这么远啦，只是觉得那个女儿说话的时候，我有点起鸡皮疙瘩…$UNRELEASED"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741520116",
                                            "text": "这对夫妇对待外人的态度不对劲。$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "741520117",
                                                    "speaker": "派蒙",
                                                    "text": "就是就是，明明刚见面的时候他们都可亲切了，怎么没过多久就变成这副凶巴巴的样子了。$UNRELEASED"
                                                },
                                                {
                                                    "id": "741520118",
                                                    "speaker": "Player",
                                                    "text": "他们只在父亲面前对我们友善。$UNRELEASED"
                                                },
                                                {
                                                    "id": "741520119",
                                                    "speaker": "派蒙",
                                                    "text": "唔…我回忆一下。是哦，第一次见面的时候，伯努瓦刚进门，那个女婿就凶巴巴地让我们不要再来了。$UNRELEASED"
                                                },
                                                {
                                                    "id": "741520120",
                                                    "speaker": "Player",
                                                    "text": "他们在伪装。$UNRELEASED"
                                                },
                                                {
                                                    "id": "741520121",
                                                    "speaker": "派蒙",
                                                    "text": "他们为什么要在自己的父亲面前装出这副善良的样子呢？总得有个原因吧，为什么啊，想不明白。$UNRELEASED"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741520122",
                                            "text": "暂时能想到的就是这些。$UNRELEASED"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741520104",
                            "text": "他们出现的时机太巧合了。$UNRELEASED"
                        }
                    ]
                }
            ]
        },
        {
