    "talks": [
        {
            "id": "7509601",
            "objective": "",
            "dialogues": [
                {
                    "id": "750960101",
                    "speaker": "波卡",
                    "text": "你们回来啦，还去得挺久的呢，怎么样，有遇到什么事吗？"
                },
                {
                    "id": "750960102",
                    "speaker": "派蒙",
                    "text": "那我们在下面可做了很多事了呢…"
                },
                {
                    "id": "750960103",
                    "speaker": "Black Screen",
                    "text": "向波卡说了发生在火榴树根系的事…"
                },
                {
                    "id": "750960104",
                    "speaker": "波卡",
                    "text": "真的被这家伙解决了…好，这下能向瓦伊纳大哥报告，就不用拉下脸去找烟谜主或者沃陆之邦的人啦。"
                },
                {
                    "id": "750960105",
                    "speaker": "波卡",
                    "text": "我就说他能做到。"
                },
                {
                    "id": "750960106",
                    "speaker": "派蒙",
                    "text": "咦，原来你们的瓦伊纳大哥居然早就知道火榴树根系有问题…"
                },
                {
                    "id": "750960107",
                    "speaker": "波卡",
                    "text": "那是当然的，火榴大母树的状况大家当然都知道，只有提佐科这家伙觉得大家没有发觉，还死脑筋地想要自己解决问题…"
                },
                {
                    "id": "750960108",
                    "speaker": "波卡",
                    "text": "虽然脑子转不过弯来，不过我就觉得就是这家伙这点很讨人喜欢。"
                },
                {
                    "id": "750960109",
                    "speaker": "波卡",
                    "text": "#这次也多谢你们啦，哈哈，{NICKNAME}和派蒙，你们的名字我其实早就知道了，毕竟讯使是靠信息吃饭的嘛。"
                },
                {
                    "id": "750960110",
                    "speaker": "波卡",
                    "text": "所以就稍微顺水推舟了一把…在你们会出现在的地方放了通行证。"
                },
                {
                    "id": "750960111",
                    "speaker": "派蒙",
                    "text": "好啊，原来都是你安排的！"
                },
                {
                    "id": "750960112",
                    "speaker": "波卡",
                    "text": "哈哈，好，估计那个死脑筋也给了你们一份酬劳，我可不能给的比他少，来，这些给你们！"
                },
                {
                    "id": "750960113",
                    "speaker": "波卡",
                    "text": "就看在报酬的份上，两位，就大人不记小人过吧…"
                }
            ]
        },
        {
            "id": "7509602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750960201",
                    "speaker": "提佐科",
                    "text": "「山王火榴」终于成熟了，真是让人松了口气。"
                },
                {
                    "id": "750960202",
                    "speaker": "提佐科",
                    "text": "咦，是你啊，怎么了，如果要进去的话就速去速回，别被部族的人发现了！",
                    "choices": [
                        {
                            "id": "750960203",
                            "text": "关于「山王」…",
                            "response": [
                                {
                                    "id": "750960204",
                                    "speaker": "提佐科",
                                    "text": "哦，是想问关于「山王」的事吗…"
                                },
                                {
                                    "id": "750960205",
                                    "speaker": "提佐科",
                                    "text": "「山王」康加玛托，是从前与英杰一起对抗深渊的了不起的龙，部族里的所有人都很尊敬它。"
                                },
                                {
                                    "id": "750960206",
                                    "speaker": "提佐科",
                                    "text": "「山王火榴」其实也会有专人采摘献给它食用。不过也有说法，其他的匿叶龙也会偷偷给「山王」大人喂吃的…"
                                },
                                {
                                    "id": "750960207",
                                    "speaker": "提佐科",
                                    "text": "所以「山王」大人才会比别的匿叶龙…呃，健硕那么多？"
                                }
                            ]
                        },
                        {
                            "id": "750960208",
                            "text": "关于火榴果…",
                            "response": [
                                {
                                    "id": "750960209",
                                    "speaker": "提佐科",
                                    "text": "这你就问对人啦，火榴果是很了不起的燃素植物，哎，能够把自己的根系伸入液态燃素，对于植物来说很有勇气吧。"
                                },
                                {
                                    "id": "750960210",
                                    "speaker": "提佐科",
                                    "text": "而且，结出来的果子里也满含燃素，多吃吃对匿叶龙也有好处…只要它们别扔出去…"
                                },
                                {
                                    "id": "750960211",
                                    "speaker": "提佐科",
                                    "text": "毕竟剧烈碰撞，火榴果就会爆裂开来嘛…"
                                }
                            ]
                        },
                        {
                            "id": "750960212",
                            "text": "只是路过啦…",
                            "response": [
                                {
                                    "id": "750960213",
                                    "speaker": "提佐科",
                                    "text": "是嘛…真的不进去看一眼「山王火榴」吗？多看看「山王火榴」，就觉得心情也变好了…如果觉得烦恼，一定得来看看哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}