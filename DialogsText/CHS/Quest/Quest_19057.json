    "talks": [
        {
            "id": "1905701",
            "objective": "前往鸣神大社",
            "dialogues": []
        },
        {
            "id": "1905707",
            "objective": "与鹿野奈奈交谈",
            "dialogues": [
                {
                    "id": "190570701",
                    "speaker": "悦",
                    "text": "非常抱歉，刚才我对您失言了。"
                },
                {
                    "id": "190570702",
                    "speaker": "悦",
                    "text": "啊，您问平藏先生吗？他应该很痛恨我这种人吧？"
                },
                {
                    "id": "190570703",
                    "speaker": "悦",
                    "text": "虽然他很克制，言语也能保持礼貌友好，但其实我能看得出来，他对骗子和其他犯人的态度还是不一样的…他好像非常痛恨骗子…"
                },
                {
                    "id": "190570704",
                    "speaker": "悦",
                    "text": "难道他也曾被骗过吗？真不可思议，什么人能骗到平藏先生…"
                }
            ]
        },
        {
            "id": "1905702",
            "objective": "前往城中寻找下一个演员",
            "dialogues": []
        },
        {
            "id": "1905708",
            "objective": "在花见坂附近寻找一斗",
            "dialogues": [
                {
                    "id": "190570801",
                    "speaker": "鹿野奈奈",
                    "text": "旅行者，您好啊，舍弟给您添了不少麻烦吧？那孩子就是太有个性了些，其实没有坏心思的。"
                },
                {
                    "id": "190570802",
                    "speaker": "鹿野奈奈",
                    "text": "如果有不小心之处冒犯到您，请不要顾忌，狠狠地教训他吧，他敢反抗您就说是我同意的。"
                }
            ]
        },
        {
            "id": "1905703",
            "objective": "与一斗交谈",
            "dialogues": []
        },
        {
            "id": "1905704",
            "objective": "等到第二天（20点~24点）",
            "dialogues": []
        },
        {
            "id": "1905705",
            "objective": "前往活动场地",
            "dialogues": []
        },
        {
            "id": "1905709",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190570901",
                    "speaker": "伊庭",
                    "text": "这平藏小子真是不好惹啊。"
                },
                {
                    "id": "190570902",
                    "speaker": "伊庭",
                    "text": "欸？二位想知道老头子当初的事？其实没什么好说的，很简单的过程。"
                },
                {
                    "id": "190570903",
                    "speaker": "伊庭",
                    "text": "那时听说是平藏小子在调查，老头子就知道已经完了，没费什么功夫就全交代了，毕竟遇见的可是「风暴」啊。"
                },
                {
                    "id": "190570904",
                    "speaker": "Player",
                    "text": "「风暴」？"
                },
                {
                    "id": "190570905",
                    "speaker": "伊庭",
                    "text": "是平藏小子的别称，你们没听过吗？牢里的犯人都这样叫他。"
                },
                {
                    "id": "190570906",
                    "speaker": "伊庭",
                    "text": "逃跑是不可能的，藏也藏不住，对罪犯来说，平藏小子就是像风暴一样的天灾啊。"
                },
                {
                    "id": "190570907",
                    "speaker": "伊庭",
                    "text": "唉，早知如此，何必当初…"
                }
            ]
        }
    ]
}