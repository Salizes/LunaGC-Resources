    "talks": [
        {
            "id": "7050801",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705080101",
                    "speaker": "北斗",
                    "text": "#哦！这不是{NICKNAME}嘛，来得正好，坐下喝两杯？"
                },
                {
                    "id": "705080102",
                    "speaker": "凝光",
                    "text": "能在这里见到你，真叫人高兴。"
                },
                {
                    "id": "705080103",
                    "speaker": "Player",
                    "text": "两位怎么会来这里？"
                },
                {
                    "id": "705080104",
                    "speaker": "派蒙",
                    "text": "等等，你们俩该不会是结伴来的吧？"
                },
                {
                    "id": "705080105",
                    "speaker": "北斗",
                    "text": "这位大人心血来潮说要好好休个假，就决定来这一带旅游了。"
                },
                {
                    "id": "705080106",
                    "speaker": "北斗",
                    "text": "不过嘛，我俩对旅游的理解好像不太一样。山都没上几座，就到这里歇着了，真是富贵病啊。"
                },
                {
                    "id": "705080107",
                    "speaker": "凝光",
                    "text": "这话说的，真叫人难过。我可是投你所好，特意挑了能喝酒的地方。"
                },
                {
                    "id": "705080108",
                    "speaker": "凝光",
                    "text": "只可惜大船长见多识广，对这座小酒馆意见颇多呢。"
                },
                {
                    "id": "705080109",
                    "speaker": "北斗",
                    "text": "好吧，这顿我请，行了吧？"
                },
                {
                    "id": "705080110",
                    "speaker": "派蒙",
                    "text": "北斗要请客？那我们有份吗？"
                },
                {
                    "id": "705080111",
                    "speaker": "Player",
                    "text": "派蒙，我们是酒保啦。"
                },
                {
                    "id": "705080112",
                    "speaker": "派蒙",
                    "text": "对哦，习惯性蹭上了…"
                },
                {
                    "id": "705080113",
                    "speaker": "Player",
                    "text": "两位贵客，喝点什么？"
                },
                {
                    "id": "705080114",
                    "speaker": "凝光",
                    "text": "给我来一小杯桦树吧。最好能酸一些。"
                },
                {
                    "id": "705080115",
                    "speaker": "北斗",
                    "text": "大杯的暮色，谢啦。"
                },
                {
                    "id": "705080116",
                    "speaker": "Player",
                    "text": "明白了，请稍等片刻。"
                }
            ]
        },
        {
            "id": "7050806",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050805",
            "objective": "与凝光和北斗对话",
            "dialogues": []
        },
        {
            "id": "7050802",
            "objective": "为凝光调制指定饮品",
            "dialogues": [
                {
                    "id": "705080201",
                    "speaker": "凝光",
                    "text": "……"
                },
                {
                    "id": "705080202",
                    "speaker": "北斗",
                    "text": "……"
                },
                {
                    "id": "705080203",
                    "speaker": "派蒙",
                    "text": "怎、怎么样？你们别不说话呀，我好紧张！"
                },
                {
                    "id": "705080204",
                    "speaker": "凝光",
                    "text": "嗯…忆苦思甜的味道呢。"
                },
                {
                    "id": "705080205",
                    "speaker": "北斗",
                    "text": "白手起家的味道？得是什么味儿啊。"
                },
                {
                    "id": "705080206",
                    "speaker": "凝光",
                    "text": "呵呵…酸中带甜，余味很足。"
                },
                {
                    "id": "705080207",
                    "speaker": "北斗",
                    "text": "唔…做小本生意却发现卖水果赚不到钱的味道？"
                },
                {
                    "id": "705080208",
                    "speaker": "凝光",
                    "text": "何必说得那么明白呢。过去的事，就随它去吧。"
                },
                {
                    "id": "705080209",
                    "speaker": "北斗",
                    "text": "哈哈，谁能想到高高在上的天权星也有沿街兜售水果的岁月啊。"
                },
                {
                    "id": "705080210",
                    "speaker": "北斗",
                    "text": "就像我，看着也不像渔民出身对吧？"
                },
                {
                    "id": "705080211",
                    "speaker": "凝光",
                    "text": "怎么会呢。要我说的话…"
                },
                {
                    "id": "705080212",
                    "speaker": "凝光",
                    "text": "北斗船长这双一眼看透海水的眼睛，这副乘风破浪勇往直前的热心肠，向来是像极了依海而生的人。"
                },
                {
                    "id": "705080213",
                    "speaker": "北斗",
                    "text": "喂喂，这话可不是损我的吧？"
                },
                {
                    "id": "705080214",
                    "speaker": "凝光",
                    "text": "损你又没有什么好处。"
                },
                {
                    "id": "705080215",
                    "speaker": "北斗",
                    "text": "知道你嘴巴厉害了。今天我请客，你给我点到为止。"
                },
                {
                    "id": "705080216",
                    "speaker": "凝光",
                    "text": "嗯…那我想多喝几杯。",
                    "choices": [
                        {
                            "id": "705080217",
                            "text": "是要续杯吗？",
                            "response": [
                                {
                                    "id": "705080219",
                                    "speaker": "派蒙",
                                    "text": "酒保，安排起来！"
                                },
                                {
                                    "id": "705080220",
                                    "speaker": "北斗",
                                    "text": "气势不错嘛！那我也再来一杯！"
                                },
                                {
                                    "id": "705080221",
                                    "speaker": "凝光",
                                    "text": "蒙德的果汁真不错，要是每天都能喝到该多好。"
                                },
                                {
                                    "id": "705080222",
                                    "speaker": "北斗",
                                    "text": "嗯？开玩笑吗？别告诉我你想开通日落果贸易专线…"
                                },
                                {
                                    "id": "705080223",
                                    "speaker": "凝光",
                                    "text": "听着有趣得很呢。"
                                },
                                {
                                    "id": "705080224",
                                    "speaker": "北斗",
                                    "text": "当真？"
                                },
                                {
                                    "id": "705080225",
                                    "speaker": "凝光",
                                    "text": "玩笑而已。相关贸易早就有一定规模了，不用我出手。"
                                },
                                {
                                    "id": "705080226",
                                    "speaker": "凝光",
                                    "text": "#{NICKNAME}，今天多谢了。哪天你要是想找份闲差，不妨来我身边做专职酒保。"
                                },
                                {
                                    "id": "705080227",
                                    "speaker": "北斗",
                                    "text": "也可以来「死兆星」号上。我们大伙都爱喝酒，你要是过来，就能一起喝酒吃肉了，保证过瘾。"
                                },
                                {
                                    "id": "705080228",
                                    "speaker": "凝光",
                                    "text": "北斗船长这是在跟我竞争人才吗？你这又是何必，想喝旅行者亲自调制的饮品，来群玉阁上就行。"
                                },
                                {
                                    "id": "705080229",
                                    "speaker": "Player",
                                    "text": "（我真受欢迎！）"
                                },
                                {
                                    "id": "705080230",
                                    "speaker": "派蒙",
                                    "text": "她们好像偷偷把你卖了呢…",
                                    "choices": [
                                        {
                                            "id": "705080231",
                                            "text": "有机会的话…"
                                        },
                                        {
                                            "id": "705080232",
                                            "text": "一定都去，一定都去…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705080218",
                            "text": "竭诚为您服务！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050803",
            "objective": "为北斗调制指定饮品",
            "dialogues": []
        },
        {
            "id": "7050804",
            "objective": "将饮品交给凝光和北斗",
            "dialogues": []
        },
        {
            "id": "7050899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705089901",
                    "speaker": "派蒙",
                    "text": "好像不是对方想要的饮品…再重做一杯吧，这杯我来解决！"
                }
            ]
        }
    ]
}