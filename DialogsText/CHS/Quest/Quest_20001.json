            "objective": "消灭所有魔物并摧毁路障",
            "dialogues": []
        },
        {
            "id": "2000104",
            "objective": "与昆恩对话",
            "dialogues": [
                {
                    "id": "200011001",
                    "speaker": "昆恩",
                    "text": "太感谢了，旅行者。"
                },
                {
                    "id": "200011002",
                    "speaker": "昆恩",
                    "text": "我就是想来这摘点水果，带回城里卖。"
                },
                {
                    "id": "200011003",
                    "speaker": "昆恩",
                    "text": "没想到却被这个路障拦住，然后那群家伙就跳出来。"
                },
                {
                    "id": "200011004",
                    "speaker": "昆恩",
                    "text": "我这就回蒙德城去了，记得来城里光顾我的生意啊。"
                },
                {
                    "id": "200011005",
                    "speaker": "昆恩",
                    "text": "这些就当做谢礼吧，我的水果都是这么新鲜的…所以贝雅特丽奇那家伙，才会一直过来缠着我买。"
                }
            ]
        },
        {
            "id": "2000109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200010901",
                    "speaker": "昆恩",
                    "text": "旅行者，谢谢你赶走了这些家伙。"
                },
                {
                    "id": "200010902",
                    "speaker": "昆恩",
                    "text": "多亏你来了，呃…但路障竖在这，我还是走不了。"
                },
                {
                    "id": "200010903",
                    "speaker": "昆恩",
                    "text": "这么下去，我辛辛苦苦摘下来的水果都要烂掉了…"
                },
                {
                    "id": "200010904",
                    "speaker": "昆恩",
                    "text": "你能帮我把这个路障给处理掉吗？",
                    "choices": [
                        {
                            "id": "200010905",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200010907",
                                    "speaker": "昆恩",
                                    "text": "哈哈，那就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "200010906",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "200010908",
                                    "speaker": "昆恩",
                                    "text": "啊…啊？我说，帮人帮到底嘛，无论如何，我只能指望你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
