        }
    },
    "talks": [
        {
            "id": "4014401",
            "objective": "与丽莎对话",
            "dialogues": [
                {
                    "id": "401440101",
                    "speaker": "丽莎",
                    "text": "是你呀小可爱。今天怎么有空过来了。"
                },
                {
                    "id": "401440102",
                    "speaker": "丽莎",
                    "text": "是想看看书，还是看看姐姐我呀？",
                    "choices": [
                        {
                            "id": "401440103",
                            "text": "来看看丽莎。",
                            "response": [
                                {
                                    "id": "401440104",
                                    "speaker": "丽莎",
                                    "text": "呵呵，你还是这么贴心。"
                                },
                                {
                                    "id": "401440107",
                                    "speaker": "丽莎",
                                    "text": "不过今天有些不巧，我正好在处理一项工作，暂时没法招待你们喝下午茶了。"
                                },
                                {
                                    "id": "401440108",
                                    "speaker": "派蒙",
                                    "text": "哇，丽莎居然在认真工作，也太少见了吧？"
                                },
                                {
                                    "id": "401440109",
                                    "speaker": "丽莎",
                                    "text": "确实是呢，上次像这样埋头研究，好像还是在教令院的时候吧。"
                                },
                                {
                                    "id": "401440110",
                                    "speaker": "丽莎",
                                    "text": "久违地认真思考，还挺累人的呢。",
                                    "choices": [
                                        {
                                            "id": "401440111",
                                            "text": "难道是在写论文…",
                                            "response": [
                                                {
                                                    "id": "401440113",
                                                    "speaker": "丽莎",
                                                    "text": "呵呵，看你这么有兴趣，要考虑加入进来吗？"
                                                },
                                                {
                                                    "id": "401440114",
                                                    "speaker": "丽莎",
                                                    "text": "陪姐姐一起重温学生时代如何？"
                                                },
                                                {
                                                    "id": "401440115",
                                                    "speaker": "派蒙",
                                                    "text": "不要突然把工作塞给别人啊！"
                                                },
                                                {
                                                    "id": "401440116",
                                                    "speaker": "丽莎",
                                                    "text": "#{NICKNAME}不愿意吗？这可是难得的，跟姐姐一起携手攻克难关的机会呀。顺带一提，报酬也会相当丰厚哦？",
                                                    "choices": [
                                                        {
                                                            "id": "401440117",
                                                            "text": "愿闻其详。",
                                                            "response": [
                                                                {
                                                                    "id": "401440119",
                                                                    "speaker": "丽莎",
                                                                    "text": "你应该知道，骑士团一直在进行炼金术的相关研究。"
                                                                },
                                                                {
                                                                    "id": "401440120",
                                                                    "speaker": "丽莎",
                                                                    "text": "但是大多数的课题都在实验室里进行，民众对炼金术的了解程度不是很高。"
                                                                },
                                                                {
                                                                    "id": "401440121",
                                                                    "speaker": "丽莎",
                                                                    "text": "这样的结果就是，花了许多资金投入的研究课题，却没能产生更广泛的作用。"
                                                                },
                                                                {
                                                                    "id": "401440122",
                                                                    "speaker": "丽莎",
                                                                    "text": "于是，琴打算在普通民众间推广炼金术的成果…现阶段来说，就是炼金药剂哦。"
                                                                },
                                                                {
                                                                    "id": "401440123",
                                                                    "speaker": "丽莎",
                                                                    "text": "平时除了图书馆的事情，我也会帮忙管理骑士团的药剂供应。"
                                                                },
                                                                {
                                                                    "id": "401440124",
                                                                    "speaker": "丽莎",
                                                                    "text": "再加上药剂学是我以前的研究方向之一，在琴看来，我就成了这份工作最合适的人选。"
                                                                },
                                                                {
                                                                    "id": "401440125",
                                                                    "speaker": "丽莎",
                                                                    "text": "但要兼顾民众的日常需求，就得对炼制的材料做一些调整，炼制的方式也要做适当简化…"
                                                                },
                                                                {
                                                                    "id": "401440126",
                                                                    "speaker": "丽莎",
                                                                    "text": "一来二去，原以为简单的课题，逐渐变得越来越复杂呢。"
                                                                },
                                                                {
                                                                    "id": "401440127",
                                                                    "speaker": "派蒙",
                                                                    "text": "难道说，是要我们帮忙研究吗？可是炼金术的理论，我们了解得也不是很多呀。"
                                                                },
                                                                {
                                                                    "id": "401440128",
                                                                    "speaker": "丽莎",
                                                                    "text": "呵呵，不是的，姐姐已经想好了更适合你们的工作哦。"
                                                                },
                                                                {
                                                                    "id": "401440129",
                                                                    "speaker": "丽莎",
                                                                    "text": "虽然炼制技术的研究正在稳步推进，但如果不实际收集民众的使用反馈，就没办法知道能不能满足大家的需要。"
                                                                },
                                                                {
                                                                    "id": "401440130",
                                                                    "speaker": "丽莎",
                                                                    "text": "可如果要一边研发药剂，一边收集反馈，就需要效率更高的方式了。"
                                                                },
                                                                {
                                                                    "id": "401440131",
                                                                    "speaker": "丽莎",
                                                                    "text": "我想到的办法是，直接开一家售卖炼金药剂的商店。这样就能一边炼制药剂，一边了解大家的日常需求了。"
                                                                },
                                                                {
                                                                    "id": "401440132",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦！把两项工作合并成一项…不愧是丽莎能想出来的方法呢！"
                                                                },
                                                                {
                                                                    "id": "401440133",
                                                                    "speaker": "丽莎",
                                                                    "text": "#是呀，而最适合这份工作的，当然就是我们骑士团的精锐——{NICKNAME}了。"
                                                                },
                                                                {
                                                                    "id": "401440134",
                                                                    "speaker": "丽莎",
                                                                    "text": "在教令院的时候，同学之间也会互相给对方的课题帮忙呢。"
                                                                },
                                                                {
                                                                    "id": "401440135",
                                                                    "speaker": "丽莎",
                                                                    "text": "小可爱难道不想体会一下这种青春洋溢的生活吗？"
                                                                },
                                                                {
                                                                    "id": "401440136",
                                                                    "speaker": "派蒙",
                                                                    "text": "说的好听，其实还是想偷懒吧？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "401440137",
                                                                            "text": "就当是为了丽莎吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401440138",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "呵呵，我就知道你最可靠了。"
                                                                                },
                                                                                {
                                                                                    "id": "401440141",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "等工作告一段落，姐姐会亲自准备报酬的。"
                                                                                },
                                                                                {
                                                                                    "id": "401440142",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "店铺的前期准备已经完成了，接下来的事情，我们直接到那边再聊吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "401440139",
                                                                            "text": "就当是挑战一下自己。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401440140",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "嗯，你果然很有干劲呢。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401440118",
                                                            "text": "要先看看是什么事。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401440112",
                                            "text": "难道是在做课题…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401440105",
                            "text": "正好路过…",
                            "response": [
                                {
                                    "id": "401440106",
                                    "speaker": "丽莎",
                                    "text": "顺便来找我聊聊天吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014402",
            "objective": "前往店铺",
            "dialogues": [
                {
                    "id": "401440201",
                    "speaker": "丽莎",
                    "text": "这里就是我们要开店的地方了。"
                },
                {
                    "id": "401440202",
                    "speaker": "派蒙",
                    "text": "哇，这么多的准备，都是丽莎一个人做完的吗？"
                },
                {
                    "id": "401440203",
                    "speaker": "丽莎",
                    "text": "这是骑士团的大家一起努力的成果哦。"
                },
                {
                    "id": "401440204",
                    "speaker": "丽莎",
                    "text": "开店所需的启动资金，是琴特意筹备的。炼制药剂所需的药材和设备，得到了阿贝多和砂糖的支持。"
                },
                {
                    "id": "401440205",
                    "speaker": "丽莎",
                    "text": "至于后续的物资补充，则是由后勤小队来负责。"
                },
                {
                    "id": "401440206",
                    "speaker": "丽莎",
                    "text": "现在又有了你们的加入，姐姐身上的担子减轻了不少呢。"
                },
                {
                    "id": "401440207",
                    "speaker": "丽莎",
                    "text": "这些天，骑士团已经对店铺做了一系列宣传。等我们准备好了，就可以正式开业啦。"
                },
                {
                    "id": "401440208",
                    "speaker": "丽莎",
                    "text": "事不宜迟，接下来你就用这几种药材，试着炼制药剂吧。"
                }
            ]
        },
        {
            "id": "4014403",
            "objective": "尝试炼制药剂",
            "dialogues": [
                {
                    "id": "401440301",
                    "speaker": "丽莎",
                    "text": "只要把药材放进炼金釜，按照步骤操作，就能炼制出药剂了。"
                }
            ]
        },
        {
            "id": "4014404",
            "objective": "尝试上架售卖",
            "dialogues": [
                {
                    "id": "401440401",
                    "speaker": "丽莎",
                    "text": "嗯，你已经顺利卖出第一批药剂了呢，这是个好的开始。"
                },
                {
                    "id": "401440402",
                    "speaker": "丽莎",
                    "text": "至于之后要炼制什么样的药剂，就要参考市场消息了。"
                },
                {
                    "id": "401440403",
                    "speaker": "丽莎",
                    "text": "根据近期发生的一些新闻，来推测人们需要什么样的药剂，这是经营的必备技巧哦。"
                },
                {
                    "id": "401440404",
                    "speaker": "派蒙",
                    "text": "呃，听起来有点难度呢…"
                },
                {
                    "id": "401440405",
                    "speaker": "丽莎",
                    "text": "呵呵…别担心，姐姐已经贴心地帮你整理好了最近的市场消息。"
                },
                {
                    "id": "401440406",
                    "speaker": "丽莎",
                    "text": "怎么样，对接下来要出售的药剂有什么想法了吗？"
                },
                {
                    "id": "401440407",
                    "speaker": "丽莎",
                    "text": "那么就试试培育新的药材吧。这些药材经过了生物炼金技术的处理，带有不同的功效和特征。"
                },
                {
                    "id": "401440408",
                    "speaker": "丽莎",
                    "text": "根据加入药材的种类不同，最终炼制出的药剂也会发生变化。可以多尝试不同的组合哦。"
                },
                {
                    "id": "401440409",
                    "speaker": "丽莎",
                    "text": "好了，你去实际尝试一下吧。"
                }
            ]
        },
        {
            "id": "4014405",
            "objective": "结束当前经营周期",
            "dialogues": [
                {
                    "id": "401440501",
                    "speaker": "丽莎",
                    "text": "去试试培育新的药材吧。"
                }
            ]
        },
        {
            "id": "4014406",
            "objective": "与丽莎对话",
            "dialogues": []
        },
        {
            "id": "4014407",
            "objective": "尝试培育药材",
            "dialogues": [
                {
                    "id": "401440701",
                    "speaker": "芙里达",
                    "text": "#荣誉骑士{NICKNAME}，和{F#她}{M#他}的侍从派蒙，你们好呀！后勤小队骑士芙里达，向你们致以问候！"
                },
                {
                    "id": "401440702",
                    "speaker": "派蒙",
                    "text": "#哇，我的大名已经远近皆知了吗。不过侍从是什么啦，我是{F#她}{M#他}的伙伴才对！"
                },
                {
                    "id": "401440703",
                    "speaker": "芙里达",
                    "text": "哦，抱歉，不小心就沿用了流行小说的用法。"
                },
                {
                    "id": "401440704",
                    "speaker": "芙里达",
                    "text": "你们的事迹可以说是传说一般的存在，真是令人羡慕…"
                },
                {
                    "id": "401440705",
                    "speaker": "芙里达",
                    "text": "我也想成为四处冒险的游侠骑士，这样的生活一定很有趣吧。",
                    "choices": [
                        {
                            "id": "401440706",
                            "text": "说不定以后有机会呢。",
                            "response": [
                                {
                                    "id": "401440707",
                                    "speaker": "芙里达",
                                    "text": "是啊，我也是这么期待着的！"
                                },
                                {
                                    "id": "401440710",
                                    "speaker": "芙里达",
                                    "text": "无论如何，现在还是好好完成眼前的工作吧。"
                                },
                                {
                                    "id": "401440711",
                                    "speaker": "芙里达",
                                    "text": "我收到代理团长的指示，要全力支持你们的经营事业。"
                                },
                                {
                                    "id": "401440712",
                                    "speaker": "芙里达",
                                    "text": "你们有什么需要，都可以向我提出哦。",
                                    "choices": [
                                        {
                                            "id": "401440713",
                                            "text": "物资采购。",
                                            "response": [
                                                {
                                                    "id": "401440714",
                                                    "speaker": "芙里达",
                                                    "text": "最近新到了一批物资，请看看有什么需要哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401440715",
                                            "text": "再见。",
                                            "response": [
                                                {
                                                    "id": "401440716",
                                                    "speaker": "芙里达",
                                                    "text": "祝你们经营顺利！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401440708",
                            "text": "其实也没有这么轻松。",
                            "response": [
                                {
                                    "id": "401440709",
                                    "speaker": "芙里达",
                                    "text": "我想也是，小说里的游侠骑士都会经历很多危险…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014408",
            "objective": "与丽莎对话",
            "dialogues": [
                {
                    "id": "401440601",
                    "speaker": "丽莎",
                    "text": "看来你对培育流程也熟悉起来了吧？"
                },
                {
                    "id": "401440602",
                    "speaker": "丽莎",
                    "text": "啊，后勤小队的骑士已经到了呢，她会定期提供新的物资补给，你们待会去找她聊聊吧。"
                },
                {
                    "id": "401440603",
                    "speaker": "丽莎",
                    "text": "再之后就是你自由发挥的时间啦。"
                },
                {
                    "id": "401440604",
                    "speaker": "Player",
                    "text": "那丽莎负责什么呢？"
                },
                {
                    "id": "401440605",
                    "speaker": "派蒙",
                    "text": "对啊，怎么变成了只有我们在忙里忙外…丽莎你的工作呢！"
                },
                {
                    "id": "401440606",
                    "speaker": "丽莎",
                    "text": "我吗？当然是要确保小可爱能顺利掌握经营和炼金的技巧了。"
                },
                {
                    "id": "401440607",
                    "speaker": "丽莎",
                    "text": "姐姐会一直支持你的，加油哦。"
                },
                {
                    "id": "401440608",
                    "speaker": "派蒙",
                    "text": "我就知道会变成这样…"
                }
            ]
        },
        {
            "id": "4014409",
            "objective": "与芙里达对话",
            "dialogues": []
        },
        {
            "id": "4014410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401441001",
                    "speaker": "丽莎",
                    "text": "试着将炼好的药剂放到那边的货架上吧。"
                }
            ]
        },
        {
            "id": "4014411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401441101",
                    "speaker": "丽莎",
                    "text": "哎呀，已经准备妥当了吗？该让骑士团的各位把开业公告张贴起来了。"
                }
            ]
        },
        {
            "id": "4014499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401449901",
                    "speaker": "派蒙",
                    "text": "有段时间没回骑士团了，不知道琴团长和丽莎她们在忙些什么？不如回去看看吧！"
                },
                {
                    "id": "401449902",
                    "speaker": "丽莎",
                    "text": "看起来药剂已经完成了呢，接下来就可以上架售卖了。"
                },
                {
                    "id": "401449903",
                    "speaker": "派蒙",
                    "text": "这样开店的准备就算完成了吧！我们在那边休息一段时间，等待客人来吧。"
                }
            ]
        }
    ]
}