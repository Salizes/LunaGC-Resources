    "talks": [
        {
            "id": "1504201",
            "objective": "前往浪浪湾",
            "dialogues": [
                {
                    "id": "150420101",
                    "speaker": "玛拉妮",
                    "text": "呜呼——！！"
                },
                {
                    "id": "150420102",
                    "speaker": "玛拉妮",
                    "text": "阳光！海浪！鳍游龙！"
                },
                {
                    "id": "150420103",
                    "speaker": "派蒙",
                    "text": "她激动得好像忘了自己的古名是「沃摩{RUBY#[S]团结}延」…"
                },
                {
                    "id": "150420104",
                    "speaker": "玛拉妮",
                    "text": "快来呀，这边这边！哎呀，快一点嘛，用跑的！"
                },
                {
                    "id": "150420105",
                    "speaker": "班尼特",
                    "text": "我们来了！"
                },
                {
                    "id": "150420106",
                    "speaker": "玛拉妮",
                    "text": "看！这是什么？"
                },
                {
                    "id": "150420107",
                    "speaker": "派蒙",
                    "text": "木板。"
                },
                {
                    "id": "150420108",
                    "speaker": "玛拉妮",
                    "text": "看字！"
                },
                {
                    "id": "150420109",
                    "speaker": "派蒙",
                    "text": "噢噢噢是游览地图啊。"
                },
                {
                    "id": "150420110",
                    "speaker": "玛拉妮",
                    "text": "游览地图！其价值不亚于锁着巨大宝库的钥匙…"
                },
                {
                    "id": "150420111",
                    "speaker": "班尼特",
                    "text": "我明白，都象征着冒险的开始！"
                },
                {
                    "id": "150420112",
                    "speaker": "玛拉妮",
                    "text": "或者也能比喻成熊熊燃烧的燃素种？"
                },
                {
                    "id": "150420113",
                    "speaker": "班尼特",
                    "text": "燃素？呃…好像是一种能量对吧？你是想说…只要看一眼就会有…源源不断的动力？"
                },
                {
                    "id": "150420114",
                    "speaker": "玛拉妮",
                    "text": "没错！而且它也很重要。"
                },
                {
                    "id": "150420115",
                    "speaker": "玛拉妮",
                    "text": "拥有地图，时刻按需查看，每个人都能走出属于自己的自由冒险之路！"
                },
                {
                    "id": "150420116",
                    "speaker": "班尼特",
                    "text": "哇噢，自由！冒险！"
                },
                {
                    "id": "150420117",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150420118",
                    "speaker": "派蒙",
                    "text": "等等…别急着附和。我怎么听着玛拉妮话里有话…"
                },
                {
                    "id": "150420119",
                    "speaker": "玛拉妮",
                    "text": "现在，解散！"
                },
                {
                    "id": "150420120",
                    "speaker": "派蒙",
                    "text": "哪有你这种一到景点就原地解散的向导啊！",
                    "choices": [
                        {
                            "id": "150420121",
                            "text": "玛拉妮是不是自己想玩…",
                            "response": [
                                {
                                    "id": "150420123",
                                    "speaker": "玛拉妮",
                                    "text": "不愧是我的好伙伴，我会把你帮我说话这件事记在心上的！"
                                },
                                {
                                    "id": "150420124",
                                    "speaker": "玛拉妮",
                                    "text": "大家仔细看，这两个大型游乐项目旁都写着「待测试」的字样，估计是遇到了什么麻烦。"
                                },
                                {
                                    "id": "150420125",
                                    "speaker": "玛拉妮",
                                    "text": "我们不如分头去找自己感兴趣的项目，一边体验，一边帮忙测试，说不定还能让浪浪湾尽早投入运营。"
                                },
                                {
                                    "id": "150420126",
                                    "speaker": "派蒙",
                                    "text": "我还以为一接触到你心爱的水上项目，就不管我们了，原来你还是挺热心的嘛…"
                                },
                                {
                                    "id": "150420127",
                                    "speaker": "玛拉妮",
                                    "text": "嘿嘿，最后大家就在那个巨大的鳍游龙建筑附近集合吧？"
                                },
                                {
                                    "id": "150420128",
                                    "speaker": "玛拉妮",
                                    "text": "凭我多年向导经验，区域主要挑战的入口，肯定在那附近！"
                                },
                                {
                                    "id": "150420129",
                                    "speaker": "恰斯卡",
                                    "text": "行。"
                                },
                                {
                                    "id": "150420130",
                                    "speaker": "玛拉妮",
                                    "text": "那就解散啦，记得多看地图哦！"
                                }
                            ]
                        },
                        {
                            "id": "150420122",
                            "text": "懂了，今天「向导」也在度假…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504204",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1504213",
            "objective": "看看同伴们游玩的项目",
            "dialogues": [
                {
                    "id": "150421301",
                    "speaker": "恰斯卡",
                    "text": "哟，眼神不错，我站在这么高的地方居然都被你发现了。"
                },
                {
                    "id": "150421302",
                    "speaker": "恰斯卡",
                    "text": "看样子，你也对这里的设施感兴趣？",
                    "choices": [
                        {
                            "id": "150421303",
                            "text": "它好玩吗？",
                            "response": [
                                {
                                    "id": "150421304",
                                    "speaker": "恰斯卡",
                                    "text": "我觉得挺不错。但好玩与否是个主观的判断，我说了也不算，你得亲自上手试试。"
                                },
                                {
                                    "id": "150421307",
                                    "speaker": "恰斯卡",
                                    "text": "看到那条轨道了吗？"
                                },
                                {
                                    "id": "150421308",
                                    "speaker": "恰斯卡",
                                    "text": "用颜料子弹给轨道上的球体染色吧。只要涂上相同的颜色，那些球就会被「消除」了。"
                                },
                                {
                                    "id": "150421309",
                                    "speaker": "恰斯卡",
                                    "text": "至于是如何「消除」的…呵呵，也许另一个人也端着枪，等着把那些球打飞呢。",
                                    "choices": [
                                        {
                                            "id": "150421310",
                                            "text": "好厉害…",
                                            "response": [
                                                {
                                                    "id": "150421312",
                                                    "speaker": "恰斯卡",
                                                    "text": "那你就来一局试试？用那个就行。"
                                                },
                                                {
                                                    "id": "150421313",
                                                    "speaker": "恰斯卡",
                                                    "text": "这回我看你玩，加油。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150421311",
                                            "text": "说得我快信了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150421305",
                            "text": "它复杂吗？",
                            "response": [
                                {
                                    "id": "150421306",
                                    "speaker": "恰斯卡",
                                    "text": "放轻松，这里可是悠悠度假村，是与「复杂」、「困难」这些词汇距离最远的地方。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504214",
            "objective": "准备集合",
            "dialogues": [
                {
                    "id": "150421401",
                    "speaker": "恰斯卡",
                    "text": "现在感觉如何？",
                    "choices": [
                        {
                            "id": "150421402",
                            "text": "有点轻松。",
                            "response": [
                                {
                                    "id": "150421403",
                                    "speaker": "恰斯卡",
                                    "text": "口气还挺大，不过我看你确实表现得很好。"
                                },
                                {
                                    "id": "150421408",
                                    "speaker": "恰斯卡",
                                    "text": "说不定我也可以跟工作人员提提建议，让他们日后做些改进。"
                                },
                                {
                                    "id": "150421409",
                                    "speaker": "恰斯卡",
                                    "text": "再怎么说…至少也该让两位选手一决高下吧。"
                                }
                            ]
                        },
                        {
                            "id": "150421404",
                            "text": "眼睛看花了…",
                            "response": [
                                {
                                    "id": "150421405",
                                    "speaker": "恰斯卡",
                                    "text": "哈哈，保持专注的确是一件需要耗费体力的事。"
                                }
                            ]
                        },
                        {
                            "id": "150421406",
                            "text": "挺好玩的。",
                            "response": [
                                {
                                    "id": "150421407",
                                    "speaker": "恰斯卡",
                                    "text": "是吗？看来我们做出了相同的判断。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504215",
            "objective": "前往鳍游龙建筑附近集合",
            "dialogues": [
                {
                    "id": "150421501",
                    "speaker": "玛拉妮",
                    "text": "很好，清点人数…一二三四…"
                },
                {
                    "id": "150421502",
                    "speaker": "玛拉妮",
                    "text": "还多了一个？"
                },
                {
                    "id": "150421503",
                    "speaker": "图西娜",
                    "text": "各位是想要参与浪浪湾的主要挑战项目吗？但我们这边出了些状况…"
                },
                {
                    "id": "150421504",
                    "speaker": "图西娜",
                    "text": "如果需要完成纪念册任务，在景点拍摄合照的话，我现在可以直接帮大家拍摄…"
                },
                {
                    "id": "150421505",
                    "speaker": "玛拉妮",
                    "text": "不…这不对吧！"
                },
                {
                    "id": "150421506",
                    "speaker": "玛拉妮",
                    "text": "画片不过是留念的手段，以后翻看时还能回想起温暖的片段…但我们在意的还是整个游玩的体验啦！"
                },
                {
                    "id": "150421507",
                    "speaker": "派蒙",
                    "text": "你忘说画片可以兑奖的事了…好吧，但我也赞同，拍一张就走太敷衍了。"
                },
                {
                    "id": "150421508",
                    "speaker": "图西娜",
                    "text": "我明白了，真是抱歉…那可能需要大家保持耐心等待了，我们会尽快解决的…"
                },
                {
                    "id": "150421509",
                    "speaker": "派蒙",
                    "text": "要等多久呢？"
                },
                {
                    "id": "150421510",
                    "speaker": "图西娜",
                    "text": "这个不太好说…"
                },
                {
                    "id": "150421511",
                    "speaker": "派蒙",
                    "text": "欸？不太好说？"
                },
                {
                    "id": "150421512",
                    "speaker": "玛拉妮",
                    "text": "有我们来帮忙呢？"
                },
                {
                    "id": "150421513",
                    "speaker": "图西娜",
                    "text": "这个…"
                },
                {
                    "id": "150421514",
                    "speaker": "恰斯卡",
                    "text": "我看浪浪湾其他项目工作人员很少，龙员工的状态明显有些疲惫…"
                },
                {
                    "id": "150421515",
                    "speaker": "恰斯卡",
                    "text": "恐怕就是因为「主要挑战项目」遇到了难关，所有人手都被临时调度过来，共同参与起了修复工作？"
                },
                {
                    "id": "150421516",
                    "speaker": "恰斯卡",
                    "text": "别紧张，我理解有不便透露的内部情况，并不是要为难你的意思。"
                },
                {
                    "id": "150421517",
                    "speaker": "恰斯卡",
                    "text": "相反，我的同伴个个身手不凡，而且助人为乐，就在不久前完成了「暝导游船」和「阿夏快跑」两场测试。"
                },
                {
                    "id": "150421518",
                    "speaker": "恰斯卡",
                    "text": "要是你愿意把难题和我们分享，事态就很有可能得到更快解决。"
                },
                {
                    "id": "150421519",
                    "speaker": "派蒙",
                    "text": "哇，她说话有进有退的，这就是平日里深藏不露的「调停人」实力吗？"
                },
                {
                    "id": "150421520",
                    "speaker": "玛拉妮",
                    "text": "恰斯卡，提醒我一下，你是怎么观察的来着？你不会暗中坐在树梢上偷看我们吧？"
                },
                {
                    "id": "150421521",
                    "speaker": "恰斯卡",
                    "text": "这是重点吗？"
                },
                {
                    "id": "150421522",
                    "speaker": "班尼特",
                    "text": "噢，重点是…我们真的很擅长支援和协助！有问题当然要大家一起出力！"
                },
                {
                    "id": "150421523",
                    "speaker": "图西娜",
                    "text": "没想到这位客人连龙的状态都能说得那么准确…不好意思，是我不该隐瞒各位。"
                },
                {
                    "id": "150421524",
                    "speaker": "图西娜",
                    "text": "情况是这样的。"
                },
                {
                    "id": "150421525",
                    "speaker": "图西娜",
                    "text": "测试发现，「闪闪大滑行」仍有许多地方缺少正确涂色。由于需要在游隙灵道上进行喷绘，施工难度很大。"
                },
                {
                    "id": "150421526",
                    "speaker": "图西娜",
                    "text": "为了不影响度假村的正式开业时间，我们只能临时关停挑战项目，争分夺秒进行抢修…"
                },
                {
                    "id": "150421527",
                    "speaker": "玛拉妮",
                    "text": "哈哈…那好说啊。"
                },
                {
                    "id": "150421528",
                    "speaker": "玛拉妮",
                    "text": "告诉我颜料放在哪里？我来跑一次，一口气全都涂完！"
                },
                {
                    "id": "150421529",
                    "speaker": "图西娜",
                    "text": "啊？…她在说什么？"
                },
                {
                    "id": "150421530",
                    "speaker": "恰斯卡",
                    "text": "我猜你可能没和她见过面，这位是「沃摩{RUBY#[S]团结}延」的玛拉妮。"
                },
                {
                    "id": "150421531",
                    "speaker": "图西娜",
                    "text": "玛拉妮…等等，玛拉妮…？！"
                },
                {
                    "id": "150421532",
                    "speaker": "图西娜",
                    "text": "你是说…六英杰之一的那位玛拉妮？！"
                }
            ]
        },
        {
            "id": "1504202",
            "objective": "挑战「闪闪大滑行」",
            "dialogues": []
        },
        {
            "id": "1504216",
            "objective": "挑战「闪闪大滑行」",
            "dialogues": []
        },
        {
            "id": "1504203",
            "objective": "与众人对话",
            "dialogues": []
        },
        {
            "id": "1504217",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150421701",
                    "speaker": "派蒙",
                    "text": "辛苦啦，玛拉妮！"
                },
                {
                    "id": "150421702",
                    "speaker": "玛拉妮",
                    "text": "呼，这回总算玩爽啦…怎么样？各位，我做得很棒吧！"
                },
                {
                    "id": "150421703",
                    "speaker": "班尼特",
                    "text": "太漂亮了，不愧是纳塔的六英杰！"
                },
                {
                    "id": "150421704",
                    "speaker": "班尼特",
                    "text": "在冲浪板滑出去之后，派蒙和我说起了你的事迹，听得我叹为观止！全身都像燃烧起来一样激动！"
                },
                {
                    "id": "150421705",
                    "speaker": "玛拉妮",
                    "text": "哈哈，谢谢，听你夸的，我都想原地加开一场温泉派对了！"
                },
                {
                    "id": "150421706",
                    "speaker": "玛拉妮",
                    "text": "哇！你们看，浪浪湾工作人员都来了！努力了那么久，大家肯定都在等着音乐、派对和犒劳呢！"
                },
                {
                    "id": "150421707",
                    "speaker": "恰斯卡",
                    "text": "我觉得你理解错了。"
                },
                {
                    "id": "150421708",
                    "speaker": "玛拉妮",
                    "text": "哪里错了？"
                },
                {
                    "id": "150421709",
                    "speaker": "图西娜",
                    "text": "英雄玛拉妮小姐，能不能请您为我签个名？"
                },
                {
                    "id": "150421710",
                    "speaker": "高恩",
                    "text": "我也想要！"
                },
                {
                    "id": "150421711",
                    "speaker": "幼暝视龙",
                    "text": "！"
                },
                {
                    "id": "150421712",
                    "speaker": "Player",
                    "text": "明星已经藏不住了。"
                },
                {
                    "id": "150421713",
                    "speaker": "玛拉妮",
                    "text": "快快，趁现在其他人还没拥上来，我们抓紧时间把合照拍了！"
                },
                {
                    "id": "150421714",
                    "speaker": "玛拉妮",
                    "text": "要明亮的笑容，自信的表情！想想旁边的海景，还有自己的幸运色…"
                },
                {
                    "id": "150421715",
                    "speaker": "玛拉妮",
                    "text": "三、二、一——"
                },
                {
                    "id": "150421716",
                    "speaker": "派蒙",
                    "text": "鳍游龙！"
                },
                {
                    "id": "150421717",
                    "speaker": "？？？",
                    "text": "……"
                }
            ]
        },
        {
            "id": "1504299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150429901",
                    "speaker": "派蒙",
                    "text": "差不多该去集合啦，巨大的鳍游龙建筑…噢，在那里！"
                }
            ]
        }
    ]
}