            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700130101",
                    "speaker": "友好的丘丘人",
                    "text": "Olah! Odomu tomo?"
                },
                {
                    "id": "700130102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo! Mosi mita?"
                },
                {
                    "id": "700130103",
                    "speaker": "友好的丘丘人",
                    "text": "Tomo mosi mita! Tomo mani mimi?"
                },
                {
                    "id": "700130104",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi mani ye! Plata odomu?"
                },
                {
                    "id": "700130105",
                    "speaker": "友好的丘丘人",
                    "text": "Plata odomu! Zido mi! mi muhe yeye! Mi mita yeye!"
                },
                {
                    "id": "700130106",
                    "speaker": "派蒙",
                    "text": "他们两个聊得很开心的样子呢…",
                    "choices": [
                        {
                            "id": "700130107",
                            "text": "不愧是马斯克小姐。",
                            "response": [
                                {
                                    "id": "700130109",
                                    "speaker": "艾拉·马斯克",
                                    "text": "它需要我们帮它打倒敌人，还帮我们指出了位置。"
                                },
                                {
                                    "id": "700130110",
                                    "speaker": "艾拉·马斯克",
                                    "text": "接下来就交给你们啦！"
                                },
                                {
                                    "id": "700130111",
                                    "speaker": "友好的丘丘人",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700130108",
                            "text": "对话进行得很顺利呢。"
                        }
                    ]
                }
            ]
        },
        {
