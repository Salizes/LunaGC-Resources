    },
    "talks": [
        {
            "id": "2002001",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200200101",
                    "speaker": "安娜",
                    "text": "原来如此，原来如此…"
                },
                {
                    "id": "200200102",
                    "speaker": "安娜",
                    "text": "哥，你知道这些植物除了做菜之外的用途吗？"
                },
                {
                    "id": "200200103",
                    "speaker": "安东尼",
                    "text": "我怎么可能知道…"
                },
                {
                    "id": "200200104",
                    "speaker": "安东尼",
                    "text": "我只知道在哪可以采到它们，还有它们到底能不能吃。"
                },
                {
                    "id": "200200105",
                    "speaker": "安娜",
                    "text": "唔…那我就自己出去看看好了，放心啦哥，我只是去采集植物，绝对不会靠近魔物的。"
                },
                {
                    "id": "200200106",
                    "speaker": "安东尼",
                    "text": "唉，你自己心里有点数就好。"
                },
                {
                    "id": "200200107",
                    "speaker": "安娜",
                    "text": "我知道啦。那我今天可要晚点回来了。",
                    "choices": [
                        {
                            "id": "200200108",
                            "text": "你还在训练吗？",
                            "response": [
                                {
                                    "id": "200200110",
                                    "speaker": "安娜",
                                    "text": "旅行者！你来得正好，我正准备去野外观察植物呢。"
                                },
                                {
                                    "id": "200200111",
                                    "speaker": "安娜",
                                    "text": "塞琉斯叔叔和我说，冒险家会经常在野外露宿，寻找食物是一项很重要的能力。"
                                },
                                {
                                    "id": "200200112",
                                    "speaker": "安娜",
                                    "text": "所以，我打算先去观察一下野外的植物，把它们的分布点和特性都记录好，再慢慢背下来。"
                                },
                                {
                                    "id": "200200113",
                                    "speaker": "安娜",
                                    "text": "这样子，以后我在野外寻找食物的时候，至少知道哪些植物能吃，哪些植物不能吃了。"
                                },
                                {
                                    "id": "200200114",
                                    "speaker": "安娜",
                                    "text": "但是…光用文字描述的话，我觉得实在不够直观。"
                                },
                                {
                                    "id": "200200115",
                                    "speaker": "安娜",
                                    "text": "旅行者，我听说你有一种叫做「留影机」的东西，对吧？"
                                },
                                {
                                    "id": "200200116",
                                    "speaker": "安娜",
                                    "text": "能不能请你帮我用「留影机」记录一下几种植物的生长环境？"
                                },
                                {
                                    "id": "200200117",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "200200118",
                                    "speaker": "安娜",
                                    "text": "那就请你先帮我去记录一下嘟嘟莲，小灯草，还有塞西莉亚花的生长环境吧。"
                                },
                                {
                                    "id": "200200119",
                                    "speaker": "安娜",
                                    "text": "然后再把这三种植物采下来带给我，我要把它们做成标本保存下来。"
                                },
                                {
                                    "id": "200200120",
                                    "speaker": "安娜",
                                    "text": "植物生长环境的记录画片、真实的植物标本，还有详细的文字说明…"
                                },
                                {
                                    "id": "200200121",
                                    "speaker": "安娜",
                                    "text": "我的「冒险家植物笔记」读起来一定会很不错的！"
                                },
                                {
                                    "id": "200200122",
                                    "speaker": "安娜",
                                    "text": "那就拜托你啦，旅行者。"
                                },
                                {
                                    "id": "200200123",
                                    "speaker": "安娜",
                                    "text": "清泉镇的那潭泉水旁应该有很多嘟嘟莲，小灯草能在奔狼领里找到。"
                                },
                                {
                                    "id": "200200124",
                                    "speaker": "安娜",
                                    "text": "塞西莉亚花嘛…那当然要去摘星崖啦。"
                                },
                                {
                                    "id": "200200125",
                                    "speaker": "安娜",
                                    "text": "我得去其他的地方继续观察植物。"
                                },
                                {
                                    "id": "200200126",
                                    "speaker": "安娜",
                                    "text": "等你拍到了画片，我们还是在城里碰头。"
                                }
                            ]
                        },
                        {
                            "id": "200200109",
                            "text": "你训练得怎么样了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002003",
            "objective": "拍摄画片，记录嘟嘟莲的生长环境",
            "dialogues": []
        },
        {
            "id": "2002027",
            "objective": "采摘嘟嘟莲",
            "dialogues": []
        },
        {
            "id": "2002012",
            "objective": "拍摄画片，记录小灯草的生长环境",
            "dialogues": [
                {
                    "id": "200201201",
                    "speaker": "安娜",
                    "text": "怎么样，看起来还不错吧，要好好品尝啊。"
                },
                {
                    "id": "200201202",
                    "speaker": "安娜",
                    "text": "我回去接着写笔记去了。嗯…这些植物的话…"
                },
                {
                    "id": "200201203",
                    "speaker": "安娜",
                    "text": "我得去问问杰克，看他知不知道怎么做植物标本。"
                },
                {
                    "id": "200201204",
                    "speaker": "安娜",
                    "text": "塞西莉亚花就不做标本了，插在花瓶里好了…"
                }
            ]
        },
        {
            "id": "2002028",
            "objective": "采摘小灯草",
            "dialogues": []
        },
        {
            "id": "2002021",
            "objective": "拍摄画片，记录塞西莉亚花的生长环境",
            "dialogues": []
        },
        {
            "id": "2002024",
            "objective": "采摘塞西莉亚花",
            "dialogues": []
        },
        {
            "id": "2002025",
            "objective": "向安娜回报",
            "dialogues": [
                {
                    "id": "200201001",
                    "speaker": "安娜",
                    "text": "旅行者，你已经回来了啊，怎么样？你拍到画片了吗？"
                },
                {
                    "id": "200201002",
                    "speaker": "Player",
                    "text": "全部拍好了，还都采来了。"
                },
                {
                    "id": "200201003",
                    "speaker": "安娜",
                    "text": "哇！你怎么能这么快全部拍好的…这就是经验丰富的冒险家吗？真厉害啊…"
                },
                {
                    "id": "200201004",
                    "speaker": "安娜",
                    "text": "谢谢你，旅行者！嗯…这样吧，为了感谢你，我来亲手做一道好菜给你吧。"
                },
                {
                    "id": "200201005",
                    "speaker": "安娜",
                    "text": "怎么样，看起来还不错吧，要好好品尝啊。"
                },
                {
                    "id": "200201006",
                    "speaker": "安娜",
                    "text": "我回去接着写笔记去了。嗯…这些植物的话…"
                },
                {
                    "id": "200201007",
                    "speaker": "安娜",
                    "text": "我得去问问杰克，看他知不知道怎么做植物标本。"
                },
                {
                    "id": "200201008",
                    "speaker": "安娜",
                    "text": "塞西莉亚花就不做标本了，插在花瓶里好了…"
                }
            ]
        },
        {
            "id": "2002015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200201501",
                    "speaker": "安东尼",
                    "text": "唉，这孩子不会真要成冒险家了吧…"
                }
            ]
        }
    ]
