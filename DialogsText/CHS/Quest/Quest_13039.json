    "talks": [
        {
            "id": "1303910",
            "objective": "前往大殿",
            "dialogues": [
                {
                    "id": "130391001",
                    "speaker": "派蒙",
                    "text": "呼——！我现在总算有事情都结束了的感觉啦。"
                },
                {
                    "id": "130391002",
                    "speaker": "派蒙",
                    "text": "忙碌过后坐下来吃吃喝喝，休息聊天，才是人生呀。赛诺请的甜点真好吃，下次我还想来！"
                },
                {
                    "id": "130391003",
                    "speaker": "Player",
                    "text": "那我们下次再来。"
                },
                {
                    "id": "130391004",
                    "speaker": "赛诺",
                    "text": "#{NICKNAME}，派蒙，提纳里，你们接下来有什么安排吗？"
                },
                {
                    "id": "130391005",
                    "speaker": "赛诺",
                    "text": "如果没有，能不能陪我去一个地方？"
                },
                {
                    "id": "130391006",
                    "speaker": "Player",
                    "text": "好啊，是什么地方？"
                },
                {
                    "id": "130391007",
                    "speaker": "赛诺",
                    "text": "先保密，给你个惊喜。"
                },
                {
                    "id": "130391008",
                    "speaker": "提纳里",
                    "text": "大概能想到…确实是惊喜。"
                },
                {
                    "id": "130391009",
                    "speaker": "派蒙",
                    "text": "说得我都好奇了，走吧走吧，快点！"
                }
            ]
        },
        {
            "id": "1303901",
            "objective": "前往大殿",
            "dialogues": [
                {
                    "id": "130390101",
                    "speaker": "赛索斯",
                    "text": "…爷爷。"
                },
                {
                    "id": "130390102",
                    "speaker": "Black Screen",
                    "text": "你们陪同赛索斯，和缄默之殿的成员一起送别巴穆恩。"
                },
                {
                    "id": "130390103",
                    "speaker": "Black Screen",
                    "text": "棺木暂时停在大殿内，人们围绕着它，气氛凝重。"
                },
                {
                    "id": "130390104",
                    "speaker": "赛索斯",
                    "text": "……"
                },
                {
                    "id": "130390105",
                    "speaker": "派蒙",
                    "text": "赛索斯…别太伤心了。"
                },
                {
                    "id": "130390106",
                    "speaker": "赛索斯",
                    "text": "嗯。只是在怀念他。"
                },
                {
                    "id": "130390107",
                    "speaker": "Player",
                    "text": "请节哀。"
                },
                {
                    "id": "130390108",
                    "speaker": "提纳里",
                    "text": "你提前做过心理准备了，对吧。"
                },
                {
                    "id": "130390109",
                    "speaker": "赛索斯",
                    "text": "是啊。爷爷的身体早就不行了，他是硬撑才撑到了今天。"
                },
                {
                    "id": "130390110",
                    "speaker": "赛索斯",
                    "text": "…我们总算在他看得见的时候完成了这件事。"
                },
                {
                    "id": "130390111",
                    "speaker": "派蒙",
                    "text": "接下来你有什么打算吗？"
                },
                {
                    "id": "130390112",
                    "speaker": "赛索斯",
                    "text": "按照爷爷的遗愿，缄默之殿将归顺拥有最多赫曼努比斯之力的人统帅，赛诺，你应该成为新一任首领。"
                },
                {
                    "id": "130390113",
                    "speaker": "赛诺",
                    "text": "你也知道不可能吧，我是大风纪官，得留在须弥教令院。"
                },
                {
                    "id": "130390114",
                    "speaker": "赛诺",
                    "text": "不过也能想到会有这种事了。我对这里的环境、人员和书刊了解甚少，并不适合领导你们。"
                },
                {
                    "id": "130390115",
                    "speaker": "赛诺",
                    "text": "赛索斯，你才是最好的继承人。"
                },
                {
                    "id": "130390116",
                    "speaker": "赛诺",
                    "text": "如果我们没举行决斗，或者你还做了其他准备…那跋灵现在很可能都在你手上。巴穆恩肯定也是这么想的。"
                },
                {
                    "id": "130390117",
                    "speaker": "赛索斯",
                    "text": "你是这么看待爷爷的吗？"
                },
                {
                    "id": "130390118",
                    "speaker": "赛诺",
                    "text": "是啊。"
                },
                {
                    "id": "130390119",
                    "speaker": "提纳里",
                    "text": "但看巴穆恩的样子，并没对你们的行为表现出太多意外。或许他早就预见到这种结果了。"
                },
                {
                    "id": "130390120",
                    "speaker": "赛诺",
                    "text": "总之，既然跋灵在我这里，那么由我来决定也可以吧？"
                },
                {
                    "id": "130390121",
                    "speaker": "赛诺",
                    "text": "赛索斯，我希望你接任巴穆恩成为新首领。你比我合适，也一定能做好。就当是帮我这个忙吧。"
                },
                {
                    "id": "130390122",
                    "speaker": "赛索斯",
                    "text": "那之前发生的事岂不是没了意义。"
                },
                {
                    "id": "130390123",
                    "speaker": "赛诺",
                    "text": "还是有的。你我现在是友非敌，这就意味着教令院和缄默之殿将再次成为合作伙伴。"
                },
                {
                    "id": "130390124",
                    "speaker": "赛诺",
                    "text": "意义非凡，赛索斯。你要相信一切正在好转，你们也一样。"
                },
                {
                    "id": "130390125",
                    "speaker": "赛索斯",
                    "text": "…也好。这是最好的结果了。"
                },
                {
                    "id": "130390126",
                    "speaker": "赛诺",
                    "text": "其实我隐约感觉，巴穆恩从一开始就只是在制造压力逼我们赌上跋灵决一胜负。"
                },
                {
                    "id": "130390127",
                    "speaker": "赛诺",
                    "text": "这样一来，无论是取回跋灵还是让出跋灵，赫曼努比斯之力都会汇聚到一个人身上。"
                },
                {
                    "id": "130390128",
                    "speaker": "赛诺",
                    "text": "如果你赢，缄默之殿就会得到双倍的力量。"
                },
                {
                    "id": "130390129",
                    "speaker": "赛诺",
                    "text": "如果我赢，他也算准了我不会贸然出任缄默之殿的首领，更不会暴力吞并你们。"
                },
                {
                    "id": "130390130",
                    "speaker": "赛诺",
                    "text": "除了神明的指引，他也同样需要教令院支持。他揽下所有责任，就是要让后人接手一个相对没负担的缄默之殿。"
                },
                {
                    "id": "130390131",
                    "speaker": "赛诺",
                    "text": "不管继任者是谁，与教令院的交涉都会变得容易。用一封信引出老师…后面的事，无论如何都是正收益。"
                },
                {
                    "id": "130390132",
                    "speaker": "赛索斯",
                    "text": "…还以为大风纪官不关心这些小细节呢。"
                },
                {
                    "id": "130390133",
                    "speaker": "赛索斯",
                    "text": "确实如你所说，这些事我和爷爷都考虑到了。我们必须想方设法缓解与教令院的关系，多少算是利用了那场仪式。"
                },
                {
                    "id": "130390134",
                    "speaker": "赛索斯",
                    "text": "也谢谢你，赛诺。作为回报，你与小吉祥草王认可的人将获得前来缄默之殿汲取更多知识的荣耀。"
                },
                {
                    "id": "130390135",
                    "speaker": "赛索斯",
                    "text": "缄默之殿是现今世上搜集了最多赤王文明相关信息的组织，有能力在你们需要时提供更多情报。"
                },
                {
                    "id": "130390136",
                    "speaker": "赛索斯",
                    "text": "不过你们的甄选必须慎之又慎，避免误导人类重蹈覆辙。"
                },
                {
                    "id": "130390137",
                    "speaker": "赛索斯",
                    "text": "对了，提纳里，爷爷见到你非常高兴。你是巴螺迦修那的后人，而我们是继承了赫曼努比斯意志的人。"
                },
                {
                    "id": "130390138",
                    "speaker": "赛索斯",
                    "text": "在赫曼努比斯的故事中，他是赤王从提纳勒人里选出的贤者，以崇高之身晋为神的眷属。"
                },
                {
                    "id": "130390139",
                    "speaker": "赛索斯",
                    "text": "后来，他与他的提纳勒人伙伴一同为崇高的目的而战。从建立缄默之殿到图莱杜拉城覆灭，他们始终并肩。"
                },
                {
                    "id": "130390140",
                    "speaker": "赛索斯",
                    "text": "离开图莱杜拉的提纳勒人与普通人一同迁往雨林。几百年后，一部分人回归沙漠，不少提纳勒人则留下来，开枝散叶。"
                },
                {
                    "id": "130390141",
                    "speaker": "赛索斯",
                    "text": "那些人或许就是你的祖先。"
                },
                {
                    "id": "130390142",
                    "speaker": "提纳里",
                    "text": "原来是这样。父亲提过我的名字取自「提纳勒人」一词，没想到…原来我和缄默之殿也算有些渊源。"
                },
                {
                    "id": "130390143",
                    "speaker": "赛诺",
                    "text": "听起来真不错。"
                },
                {
                    "id": "130390144",
                    "speaker": "派蒙",
                    "text": "对了，你们见到居勒什了没？"
                },
                {
                    "id": "130390145",
                    "speaker": "赛索斯",
                    "text": "居勒什…应该在爷爷的卧室那边吧。他好像也很缅怀爷爷，但又不想当着我的面这样做。"
                },
                {
                    "id": "130390146",
                    "speaker": "提纳里",
                    "text": "假如一切都是你和巴穆恩的计划，那他对居勒什也许并没那么大恨意。"
                },
                {
                    "id": "130390147",
                    "speaker": "赛索斯",
                    "text": "哎，谁知道呢？说不定居勒什也好，你们也好，我也好，都只是爷爷用来摆正轨迹的把手。他可坏了。"
                },
                {
                    "id": "130390148",
                    "speaker": "赛诺",
                    "text": "历史的岔路上，总要有人做决定。"
                },
                {
                    "id": "130390149",
                    "speaker": "赛诺",
                    "text": "这些事我会详细报告给小吉祥草王，安排教令院代表赶来沙漠与你见面。"
                },
                {
                    "id": "130390150",
                    "speaker": "赛诺",
                    "text": "等你安顿好手上的事，可以来雨林一趟，住几天，进一步跟大家建立联络。"
                },
                {
                    "id": "130390151",
                    "speaker": "赛诺",
                    "text": "既然要合作，那双方都要更熟悉彼此。"
                },
                {
                    "id": "130390152",
                    "speaker": "赛索斯",
                    "text": "我会的。"
                },
                {
                    "id": "130390153",
                    "speaker": "赛索斯",
                    "text": "那…回头见了，各位。"
                },
                {
                    "id": "130390154",
                    "speaker": "派蒙",
                    "text": "回头见！要来找我们玩哦！"
                },
                {
                    "id": "130390155",
                    "speaker": "Player",
                    "text": "祝你一切顺利，赛索斯。"
                }
            ]
        },
        {
            "id": "1303902",
            "objective": "返回教令院",
            "dialogues": [
                {
                    "id": "130390201",
                    "speaker": "纳菲斯",
                    "text": "一把年纪还冒这么大的险！出了事谁负责！烂摊子谁收拾！"
                },
                {
                    "id": "130390202",
                    "speaker": "居勒什",
                    "text": "哎哟你吼什么！这不是没办法吗？"
                },
                {
                    "id": "130390203",
                    "speaker": "纳菲斯",
                    "text": "什么叫没办法，你一个大学者活了一辈子，头发都白了，还以为自己今年二十岁是逞英雄的岁数吗？"
                },
                {
                    "id": "130390204",
                    "speaker": "纳菲斯",
                    "text": "跑到沙漠里去送死，真不知道你怎么想的！也真亏巴穆恩没把你往死路上逼…"
                },
                {
                    "id": "130390205",
                    "speaker": "居勒什",
                    "text": "好了好了，你到底帮他还是帮我啊？我才是你的同学兼同事好不好。"
                },
                {
                    "id": "130390206",
                    "speaker": "纳菲斯",
                    "text": "呼…没什么好说的了，依我看你就是一把不堪一击的老骨头。"
                },
                {
                    "id": "130390207",
                    "speaker": "居勒什",
                    "text": "你说什么？我明明是老年英雄，以血肉之躯守护了须弥的风纪官之力啊！"
                },
                {
                    "id": "130390208",
                    "speaker": "居勒什",
                    "text": "…不过嘛，唉，好吧，这次我理亏，回院里给你打一个月工总行了吧？"
                },
                {
                    "id": "130390209",
                    "speaker": "纳菲斯",
                    "text": "一个月？三个月！"
                },
                {
                    "id": "130390210",
                    "speaker": "派蒙",
                    "text": "提纳里的老师骂居勒什骂得很高兴的样子…我们还是别过去了…"
                },
                {
                    "id": "130390211",
                    "speaker": "Player",
                    "text": "老爷子吵架，年轻人回避…"
                },
                {
                    "id": "130390212",
                    "speaker": "赛诺",
                    "text": "老师自找的，不用理他。"
                },
                {
                    "id": "130390213",
                    "speaker": "提纳里",
                    "text": "哇，好久没见过老师这么神采奕奕的样子了。"
                },
                {
                    "id": "130390214",
                    "speaker": "提纳里",
                    "text": "上回见他眉飞色舞地骂人还是我在校的时候…"
                },
                {
                    "id": "130390215",
                    "speaker": "赛诺",
                    "text": "我想去找大家依次报个信，告诉他们事情解决了。要一起吗？"
                },
                {
                    "id": "130390216",
                    "speaker": "赛诺",
                    "text": "通知完去吃饭，我请客，怎么样？"
                },
                {
                    "id": "130390217",
                    "speaker": "提纳里",
                    "text": "合理，我参加。",
                    "choices": [
                        {
                            "id": "130390218",
                            "text": "你都这么说了…",
                            "response": [
                                {
                                    "id": "130390220",
                                    "speaker": "派蒙",
                                    "text": "我也一起！走吧！"
                                }
                            ]
                        },
                        {
                            "id": "130390219",
                            "text": "还是要支持的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303903",
            "objective": "跟随赛诺",
            "dialogues": [
                {
                    "id": "130390301",
                    "speaker": "赛诺",
                    "text": "看到了。喂，柯莱！"
                },
                {
                    "id": "130390302",
                    "speaker": "柯莱",
                    "text": "啊，你们回来了！"
                },
                {
                    "id": "130390303",
                    "speaker": "珐露珊",
                    "text": "哈？来得正好，我倒要问问这是怎么回事！听说你们跑到沙漠里去，还遭遇了重大危机？"
                },
                {
                    "id": "130390304",
                    "speaker": "赛诺",
                    "text": "已经解决了。"
                },
                {
                    "id": "130390305",
                    "speaker": "珐露珊",
                    "text": "不是这个问题！你，还有你！啊还有你们两个！怎么这么不小心呢？"
                },
                {
                    "id": "130390306",
                    "speaker": "珐露珊",
                    "text": "遇到事情可以求助的嘛，前辈我不就是一个很好的帮手？再说，我还对沙漠非常有心得呢。"
                },
                {
                    "id": "130390307",
                    "speaker": "提纳里",
                    "text": "不要和现在的珐露珊对着干。"
                },
                {
                    "id": "130390308",
                    "speaker": "赛诺",
                    "text": "你说得对。"
                },
                {
                    "id": "130390309",
                    "speaker": "派蒙",
                    "text": "嗯！"
                },
                {
                    "id": "130390310",
                    "speaker": "珐露珊",
                    "text": "我不是第一次谈这个问题了，该依赖他人的时候就要学会依赖，明白吗？否则…"
                },
                {
                    "id": "130390311",
                    "speaker": "赛诺",
                    "text": "（柯莱，快想个办法帮帮我们啊！）"
                },
                {
                    "id": "130390312",
                    "speaker": "柯莱",
                    "text": "（！是给我的信号！好吧，只能使出绝技了…）"
                },
                {
                    "id": "130390313",
                    "speaker": "柯莱",
                    "text": "那个，珐露珊前辈，先别忙着生气啦，上次说的你要带我游览教令院的事…还作数吗？"
                },
                {
                    "id": "130390314",
                    "speaker": "珐露珊",
                    "text": "欸？"
                },
                {
                    "id": "130390315",
                    "speaker": "珐露珊",
                    "text": "噢？等等，真的吗？柯莱，原来你还记得那件事！太好了，前辈这就带你去看看以前我们上课的地方…"
                },
                {
                    "id": "130390316",
                    "speaker": "派蒙",
                    "text": "珐露珊拉着柯莱走了…她是什么教令院导游吗…"
                },
                {
                    "id": "130390317",
                    "speaker": "提纳里",
                    "text": "柯莱！杯子！"
                },
                {
                    "id": "130390318",
                    "speaker": "柯莱",
                    "text": "欸？啊？…啊、噢！"
                },
                {
                    "id": "130390319",
                    "speaker": "珐露珊",
                    "text": "唔？杯子是什么意思？"
                },
                {
                    "id": "130390320",
                    "speaker": "柯莱",
                    "text": "没什么，是提纳里师父提醒我出门在外别忘了多喝水，哈哈哈…"
                },
                {
                    "id": "130390321",
                    "speaker": "赛诺",
                    "text": "杯子的意思是在咖啡馆集合。上学时我和提纳里也用这个暗号，家传的，传给妹妹了。"
                },
                {
                    "id": "130390322",
                    "speaker": "派蒙",
                    "text": "噢，原来是这样！"
                },
                {
                    "id": "130390323",
                    "speaker": "赛诺",
                    "text": "嗯。"
                },
                {
                    "id": "130390324",
                    "speaker": "赛诺",
                    "text": "还有两个家伙，也叫上他们吧。"
                }
            ]
        },
        {
            "id": "1303904",
            "objective": "跟随赛诺",
            "dialogues": [
                {
                    "id": "130390601",
                    "speaker": "赛诺",
                    "text": "我没看错吧，你们在这里勤奋苦学？"
                },
                {
                    "id": "130390602",
                    "speaker": "卡维",
                    "text": "在整理用完的资料，太多了，你看看！"
                },
                {
                    "id": "130390603",
                    "speaker": "艾尔海森",
                    "text": "不用着急，反正这些书没人看。"
                },
                {
                    "id": "130390604",
                    "speaker": "提纳里",
                    "text": "这次多谢你们了。"
                },
                {
                    "id": "130390605",
                    "speaker": "赛诺",
                    "text": "嗯，托你们的福，事情解决得很顺利，结果也比想的好一些。"
                },
                {
                    "id": "130390606",
                    "speaker": "Black Screen",
                    "text": "赛诺将这次发生的事一五一十地转告给艾尔海森和卡维。"
                },
                {
                    "id": "130390607",
                    "speaker": "艾尔海森",
                    "text": "原来如此，缄默之殿用于自保的手段确实特殊，难怪能隐藏这么多年。"
                },
                {
                    "id": "130390608",
                    "speaker": "卡维",
                    "text": "而且还保存了那么多文献…有机会真想亲眼见识一下。"
                },
                {
                    "id": "130390609",
                    "speaker": "赛诺",
                    "text": "会有那一天的。不论如何，缄默之殿的意义都很重大。"
                },
                {
                    "id": "130390610",
                    "speaker": "赛诺",
                    "text": "作为答谢，我请客喝咖啡。"
                },
                {
                    "id": "130390611",
                    "speaker": "艾尔海森",
                    "text": "听起来还不错。"
                },
                {
                    "id": "130390612",
                    "speaker": "卡维",
                    "text": "好是好，就是这几天咖啡喝得有点超量了…我点些别的吧。"
                },
                {
                    "id": "130390613",
                    "speaker": "赛诺",
                    "text": "可以，走吧。"
                }
            ]
        },
        {
            "id": "1303905",
            "objective": "前往咖啡馆",
            "dialogues": [
                {
                    "id": "130390701",
                    "speaker": "派蒙",
                    "text": "…然后啊，这家伙突然扑上去给了对手一剑！"
                },
                {
                    "id": "130390702",
                    "speaker": "派蒙",
                    "text": "还有提纳里，他打起架来也很厉害呢！这次我们连胜三局！"
                },
                {
                    "id": "130390703",
                    "speaker": "柯莱",
                    "text": "呜哇…不知道该说想看现场还是担心你们…"
                },
                {
                    "id": "130390704",
                    "speaker": "艾尔海森",
                    "text": "转播得好，就算讲得含糊不清也让人精神振奋。"
                },
                {
                    "id": "130390705",
                    "speaker": "派蒙",
                    "text": "什么啊，我不是说了嘛，先扑上去，这样出剑！然后转身！格挡！"
                },
                {
                    "id": "130390706",
                    "speaker": "卡维",
                    "text": "连赢三局还把首领的位置让给了对方，赛诺表现得很有风度嘛。"
                },
                {
                    "id": "130390707",
                    "speaker": "赛诺",
                    "text": "这是当然的。强者有强者的风度。"
                },
                {
                    "id": "130390708",
                    "speaker": "提纳里",
                    "text": "这次我也当了强者呢，很少在沙漠里跟人打架，感觉还挺特别的。"
                },
                {
                    "id": "130390709",
                    "speaker": "Player",
                    "text": "战斗的场地也很有仪式感。"
                },
                {
                    "id": "130390710",
                    "speaker": "派蒙",
                    "text": "对对，气势非常恢弘，听我说，是这样的…"
                },
                {
                    "id": "130390711",
                    "speaker": "赛诺",
                    "text": "派蒙，别光顾着说话，甜点送来了。"
                },
                {
                    "id": "130390712",
                    "speaker": "Black Screen",
                    "text": "众人在大风纪官掏钱包下的咖啡馆里闲聊许久，就这样，心中因缄默之殿而起的波澜慢慢散去了。"
                },
                {
                    "id": "130390713",
                    "speaker": "艾尔海森",
                    "text": "今天就到这里吧。"
                },
                {
                    "id": "130390714",
                    "speaker": "卡维",
                    "text": "回家之前是不是应该先去智慧宫把没整理完的书收好？"
                },
                {
                    "id": "130390715",
                    "speaker": "艾尔海森",
                    "text": "我也这么想。那再见。"
                },
                {
                    "id": "130390716",
                    "speaker": "卡维",
                    "text": "先走啦，回头见。你们今晚一定要好好休息。"
                },
                {
                    "id": "130390717",
                    "speaker": "柯莱",
                    "text": "我得去一趟三十人团那里道谢，另外纳菲斯先生也说会带我了解教令院的一些工作流程，那我先过去啦。"
                },
                {
                    "id": "130390718",
                    "speaker": "赛诺",
                    "text": "柯莱与人相处融洽了很多呢。"
                },
                {
                    "id": "130390719",
                    "speaker": "派蒙",
                    "text": "大家都在慢慢成长嘛。"
                },
                {
                    "id": "130390720",
                    "speaker": "赛诺",
                    "text": "是啊。"
                }
            ]
        },
        {
            "id": "1303909",
            "objective": "与赛诺对话",
            "dialogues": []
        },
        {
            "id": "1303906",
            "objective": "前往赛诺所说的地点",
            "dialogues": [
                {
                    "id": "130390801",
                    "speaker": "提纳里",
                    "text": "好久没上来了。"
                },
                {
                    "id": "130390802",
                    "speaker": "派蒙",
                    "text": "原来是这样的地方，好高啊…"
                },
                {
                    "id": "130390803",
                    "speaker": "提纳里",
                    "text": "要帮忙吗？",
                    "choices": [
                        {
                            "id": "130390804",
                            "text": "提纳里别小看我！",
                            "response": [
                                {
                                    "id": "130390806",
                                    "speaker": "提纳里",
                                    "text": "哈哈，好吧。"
                                },
                                {
                                    "id": "130390807",
                                    "speaker": "赛诺",
                                    "text": "这里不错吧。"
                                },
                                {
                                    "id": "130390808",
                                    "speaker": "派蒙",
                                    "text": "很高呢，风景很好。"
                                },
                                {
                                    "id": "130390809",
                                    "speaker": "赛诺",
                                    "text": "#{NICKNAME}。"
                                },
                                {
                                    "id": "130390810",
                                    "speaker": "Player",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "130390811",
                                    "speaker": "赛诺",
                                    "text": "回头看。"
                                },
                                {
                                    "id": "130390812",
                                    "speaker": "Player",
                                    "text": "…好漂亮。"
                                },
                                {
                                    "id": "130390813",
                                    "speaker": "赛诺",
                                    "text": "这里是我的秘密基地，只带好朋友来。"
                                },
                                {
                                    "id": "130390814",
                                    "speaker": "赛诺",
                                    "text": "学生时代我经常溜上来发呆。那时还小，朋友没现在多。"
                                },
                                {
                                    "id": "130390815",
                                    "speaker": "赛诺",
                                    "text": "以前的我也有跟赛索斯一样的问题：我是谁？为什么拥有这种力量，又为什么而战？"
                                },
                                {
                                    "id": "130390816",
                                    "speaker": "赛诺",
                                    "text": "天赋赠予的东西会帮助我们在人群中找到位置。我是这么过来的，赛索斯也会。",
                                    "choices": [
                                        {
                                            "id": "130390832",
                                            "text": "只要赫曼努比斯之力存在…",
                                            "response": [
                                                {
                                                    "id": "130390817",
                                                    "speaker": "提纳里",
                                                    "text": "你们俩真的像兄弟一样。"
                                                },
                                                {
                                                    "id": "130390818",
                                                    "speaker": "赛诺",
                                                    "text": "我也觉得。",
                                                    "choices": [
                                                        {
                                                            "id": "130390819",
                                                            "text": "赛诺非常厉害。",
                                                            "response": [
                                                                {
                                                                    "id": "130390821",
                                                                    "speaker": "赛诺",
                                                                    "text": "这是当然。不该谦虚的地方我从不谦虚。"
                                                                },
                                                                {
                                                                    "id": "130390822",
                                                                    "speaker": "提纳里",
                                                                    "text": "我们以前来这里聊天做功课，赛诺还不小心把水果弄掉下去了，幸好他眼明手快一把捞住。"
                                                                },
                                                                {
                                                                    "id": "130390823",
                                                                    "speaker": "赛诺",
                                                                    "text": "也就那一次，现在不可能。如今的我不会手滑。"
                                                                },
                                                                {
                                                                    "id": "130390824",
                                                                    "speaker": "提纳里",
                                                                    "text": "真怀念啊，好久没当学生了。"
                                                                },
                                                                {
                                                                    "id": "130390825",
                                                                    "speaker": "派蒙",
                                                                    "text": "按理说我想象不出赛诺干这种事，但不知为什么，眼前有画面了…"
                                                                },
                                                                {
                                                                    "id": "130390826",
                                                                    "speaker": "赛诺",
                                                                    "text": "别想了。"
                                                                },
                                                                {
                                                                    "id": "130390827",
                                                                    "speaker": "赛诺",
                                                                    "text": "嗯？那边是…"
                                                                },
                                                                {
                                                                    "id": "130390828",
                                                                    "speaker": "赛诺",
                                                                    "text": "…老师。"
                                                                },
                                                                {
                                                                    "id": "130390829",
                                                                    "speaker": "赛诺",
                                                                    "text": "你们先聊，我离开一会儿。"
                                                                },
                                                                {
                                                                    "id": "130390830",
                                                                    "speaker": "提纳里",
                                                                    "text": "好。"
                                                                },
                                                                {
                                                                    "id": "130390831",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？喂！就跳下去啦！小心点呀！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "130390820",
                                                            "text": "成长为超级强者了哦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130390833",
                                            "text": "你就永远与缄默之殿息息相关。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130390805",
                            "text": "我可是很擅长爬树的！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303908",
            "objective": "前往居勒什所在处",
            "dialogues": []
        },
        {
            "id": "1303907",
            "objective": "与居勒什对话",
            "dialogues": [
                {
                    "id": "130390901",
                    "speaker": "居勒什",
                    "text": "我的天，这张也太傻了…"
                },
                {
                    "id": "130390902",
                    "speaker": "赛诺",
                    "text": "老师，一个人在这里嘀咕什么呢？"
                },
                {
                    "id": "130390903",
                    "speaker": "居勒什",
                    "text": "赛诺，来得正好！你看我在旧笔记里找到了什么？"
                },
                {
                    "id": "130390904",
                    "speaker": "赛诺",
                    "text": "以前的画片？"
                },
                {
                    "id": "130390905",
                    "speaker": "居勒什",
                    "text": "这本笔记在贤者办公室的杂物堆里，一直忘了拿走，也没人发现。"
                },
                {
                    "id": "130390906",
                    "speaker": "居勒什",
                    "text": "刚才跟纳菲斯商量着回院里帮他的忙，正好去了趟办公室，就翻到它了。"
                },
                {
                    "id": "130390907",
                    "speaker": "居勒什",
                    "text": "日子过得真快啊，画片上你个子才这么点，还是个小孩子呢。"
                },
                {
                    "id": "130390908",
                    "speaker": "赛诺",
                    "text": "画片上你也很年轻。"
                },
                {
                    "id": "130390909",
                    "speaker": "赛诺",
                    "text": "这张！我记得这张，是丽莎师姐抓拍的吧？"
                },
                {
                    "id": "130390910",
                    "speaker": "居勒什",
                    "text": "肯定是，这么刁钻的角度，除了她还有谁把我拍得这么丑…"
                },
                {
                    "id": "130390911",
                    "speaker": "赛诺",
                    "text": "还有这张，我们在打瞌睡。"
                },
                {
                    "id": "130390912",
                    "speaker": "居勒什",
                    "text": "背着我们俩偷偷照的吧，小丫头。"
                },
                {
                    "id": "130390913",
                    "speaker": "赛诺",
                    "text": "老师，你没有什么要对我说的吗？"
                },
                {
                    "id": "130390914",
                    "speaker": "居勒什",
                    "text": "说什么啊，说画片拍得好？"
                },
                {
                    "id": "130390915",
                    "speaker": "居勒什",
                    "text": "……"
                },
                {
                    "id": "130390916",
                    "speaker": "居勒什",
                    "text": "…唉，真到了这种时刻，反而不知道该说什么了。"
                },
                {
                    "id": "130390917",
                    "speaker": "居勒什",
                    "text": "…我不是个好人。巴穆恩恨我理所应当，如果你恨我，也是理所应当。"
                },
                {
                    "id": "130390918",
                    "speaker": "赛诺",
                    "text": "胡说什么呢，你这老头。"
                },
                {
                    "id": "130390919",
                    "speaker": "居勒什",
                    "text": "哎呀，不就是想听这句话嘛！"
                },
                {
                    "id": "130390920",
                    "speaker": "居勒什",
                    "text": "离开沙漠以后，我梦到过那里好几次，有时梦见在做研究，有时梦见刚被他们救起来。"
                },
                {
                    "id": "130390921",
                    "speaker": "居勒什",
                    "text": "那真是一段…非常愉快的时光。我们都从对方身上学到了很多东西。"
                },
                {
                    "id": "130390922",
                    "speaker": "居勒什",
                    "text": "这些年你长大了很多啊，赛诺。"
                },
                {
                    "id": "130390923",
                    "speaker": "赛诺",
                    "text": "考虑到你是我恩师，不方便揭穿你说废话的事实…要不然我就不回答了吧。"
                },
                {
                    "id": "130390924",
                    "speaker": "居勒什",
                    "text": "说着不回答不还是全说出来了吗！"
                },
                {
                    "id": "130390925",
                    "speaker": "居勒什",
                    "text": "真是的，耍嘴皮欺负我一个老头算什么英雄。"
                },
                {
                    "id": "130390926",
                    "speaker": "居勒什",
                    "text": "欸等等，这里怎么还有一张…"
                },
                {
                    "id": "130390927",
                    "speaker": "赛诺",
                    "text": "也是师姐拍的吧，她到底拍了多少？"
                },
                {
                    "id": "130390928",
                    "speaker": "居勒什",
                    "text": "这么看还是小时候可爱，还老实。"
                },
                {
                    "id": "130390929",
                    "speaker": "赛诺",
                    "text": "老师也是以前正经。"
                },
                {
                    "id": "130390930",
                    "speaker": "居勒什",
                    "text": "你啊，冷笑话说得比我好，顶嘴也赢过我了。"
                },
                {
                    "id": "130390931",
                    "speaker": "赛诺",
                    "text": "别这么说，我还是很尊敬你的。"
                },
                {
                    "id": "130390932",
                    "speaker": "居勒什",
                    "text": "哼，这还差不多。"
                },
                {
                    "id": "130390933",
                    "speaker": "居勒什",
                    "text": "…我说，咱们找个时间和你丽莎师姐聚聚吧？"
                },
                {
                    "id": "130390934",
                    "speaker": "赛诺",
                    "text": "好啊，找个时间去蒙德看她吧。"
                },
                {
                    "id": "130390935",
                    "speaker": "居勒什",
                    "text": "行，写进日程里，下周就出发。"
                },
                {
                    "id": "130390936",
                    "speaker": "居勒什",
                    "text": "噢不对！下周是番茄比赛，我得跟萨赫哈蒂决一死战！"
                },
                {
                    "id": "130390937",
                    "speaker": "赛诺",
                    "text": "找点别的兴趣吧，老师。"
                }
            ]
        },
        {
            "id": "1303951",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130395101",
                    "speaker": "赛索斯",
                    "text": "…爷爷，目标达成了，就像我们期待的那样。"
                },
                {
                    "id": "130395102",
                    "speaker": "赛索斯",
                    "text": "从今天开始，缄默之殿可能再次与教令院合作。改变和机遇…我们都已经得到了。"
                }
            ]
        },
        {
            "id": "1303952",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130395201",
                    "speaker": "纳菲斯",
                    "text": "收拾东西吧，明天开始来帮我工作。"
                },
                {
                    "id": "130395202",
                    "speaker": "居勒什",
                    "text": "补贴呢？还有午饭，包不包？晚饭呢？"
                },
                {
                    "id": "130395203",
                    "speaker": "纳菲斯",
                    "text": "你还计较起来了？这次的风险我都没跟你算呢。"
                },
                {
                    "id": "130395204",
                    "speaker": "居勒什",
                    "text": "嘿，那也要吃饭的嘛！午饭你替我想办法，嗯，就这么定了。"
                }
            ]
        },
        {
            "id": "1303953",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130395301",
                    "speaker": "居勒什",
                    "text": "…唉。"
                },
                {
                    "id": "130395302",
                    "speaker": "居勒什",
                    "text": "沙漠人的固执决定了他们将忠于传承，也注定了他们要承受坎坷。这话是你自己说的。"
                },
                {
                    "id": "130395303",
                    "speaker": "居勒什",
                    "text": "可为什么能执着到这种地步呢…你从来都不是可怕的人啊，巴穆恩。"
                },
                {
                    "id": "130395304",
                    "speaker": "居勒什",
                    "text": "……"
                },
                {
                    "id": "130395305",
                    "speaker": "居勒什",
                    "text": "顽冥不灵的人，难免要死在前头。哈哈…"
                }
            ]
        },
        {
            "id": "1303999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130399901",
                    "speaker": "赛索斯",
                    "text": "（爷爷，你知道吗？赛诺选择我代替他成为缄默之殿的新任首领了。）"
                },
                {
                    "id": "130399902",
                    "speaker": "赛索斯",
                    "text": "（不能说有多了解他。可经过那一战，我完全明白了为什么赛诺和他的同伴会一起前来。）"
                },
                {
                    "id": "130399903",
                    "speaker": "赛索斯",
                    "text": "（信赖他人也被人信赖，这才是同伴的意义。并肩作战，互相扶持，这点上，我们和他们没有区别。）"
                },
                {
                    "id": "130399904",
                    "speaker": "居勒什",
                    "text": "（这么多年，我经常觉得自己还年轻得很，还有很多事可以做。）"
                },
                {
                    "id": "130399905",
                    "speaker": "居勒什",
                    "text": "（…但现在，突然觉得…）"
                },
                {
                    "id": "130399906",
                    "speaker": "居勒什",
                    "text": "（我和你一样，都还是老了啊，巴穆恩。）"
                },
                {
                    "id": "130399907",
                    "speaker": "纳菲斯",
                    "text": "（早知道应该提前叫居勒什来院里干活的，这样说不定就能规避这次风险…）"
                },
                {
                    "id": "130399908",
                    "speaker": "居勒什",
                    "text": "（纳菲斯这老小子，我可不能让他占了便宜！）"
                }
            ]
        }
    ]
}