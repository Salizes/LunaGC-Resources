    "talks": [
        {
            "id": "7567101",
            "objective": "与学者对话",
            "dialogues": [
                {
                    "id": "756710101",
                    "speaker": "拜希麦·五世",
                    "text": "啾啾，咕咕，啾啾啾！"
                },
                {
                    "id": "756710102",
                    "speaker": "派蒙",
                    "text": "这是在…干什么呢？",
                    "choices": [
                        {
                            "id": "756710103",
                            "text": "密，密文？",
                            "response": [
                                {
                                    "id": "756710105",
                                    "speaker": "拜希麦·五世",
                                    "text": "是哦！是和可爱团雀沟通的技巧！"
                                },
                                {
                                    "id": "756710106",
                                    "speaker": "拜希麦·五世",
                                    "text": "哦，我好像忘了和你们打招呼了，还有那句必不可少的开场白。"
                                },
                                {
                                    "id": "756710107",
                                    "speaker": "拜希麦·五世",
                                    "text": "两位路过的好心人，生论派的学者、新星商人和可爱动物专家拜希麦五世向你们问好。"
                                },
                                {
                                    "id": "756710108",
                                    "speaker": "拜希麦·五世",
                                    "text": "请放松身体，放空思绪，听我说一件重要的事————"
                                },
                                {
                                    "id": "756710109",
                                    "speaker": "派蒙",
                                    "text": "团雀最可爱？"
                                },
                                {
                                    "id": "756710110",
                                    "speaker": "拜希麦·五世",
                                    "text": "完全正确！恭喜你被团雀的可爱感染，开始了抢答！"
                                },
                                {
                                    "id": "756710111",
                                    "speaker": "派蒙",
                                    "text": "奇怪，不知道为什么，好像看见桌上的游戏，脑袋里就冒出了这句话。"
                                },
                                {
                                    "id": "756710112",
                                    "speaker": "派蒙",
                                    "text": "#你有印象吗，{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "756710113",
                                            "text": "我们和这位女士以前见过吧？",
                                            "response": [
                                                {
                                                    "id": "756710114",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "没错！还不止一面之缘哦，看见你们还是如此活力满满，我感觉心里很温暖！"
                                                },
                                                {
                                                    "id": "756710117",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "总之，要不要来试试我身边这个游戏？第十七版，也就是第三世代的「哐哐当当雀雀球」！"
                                                },
                                                {
                                                    "id": "756710118",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "在轻松休闲的游玩之间，还可以了解大大的朱羽古团雀战胜贼鸥的故事！"
                                                },
                                                {
                                                    "id": "756710119",
                                                    "speaker": "派蒙",
                                                    "text": "好哦好哦，轻松休闲的游戏，我们一直都很喜欢！",
                                                    "choices": [
                                                        {
                                                            "id": "756710120",
                                                            "text": "现在就玩！",
                                                            "response": [
                                                                {
                                                                    "id": "756710122",
                                                                    "speaker": "拜希麦·五世",
                                                                    "text": "嗯！希望你们能找到最适合自己的玩法，发现独一无二的乐趣！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756710121",
                                                            "text": "开局开局！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756710115",
                                            "text": "现在开始「团雀最可爱」也行。",
                                            "response": [
                                                {
                                                    "id": "756710116",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "对的！就算暂时想不起以前的事，也没关系，重要的是享受现在…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756710104",
                            "text": "暗，暗号？"
                        }
                    ]
                }
            ]
        }
    ]
}