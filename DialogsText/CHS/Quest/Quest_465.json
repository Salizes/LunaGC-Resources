        {
            "id": "46504",
            "objective": "前往晨曦酒庄",
            "dialogues": [
                {
                    "id": "4650401",
                    "speaker": "深渊法师",
                    "text": "居然被你们找到这里来…可恶的骑士团…"
                },
                {
                    "id": "4650402",
                    "speaker": "迪卢克",
                    "text": "我可不是什么骑士。快老实交代吧，你们的详细计划！"
                },
                {
                    "id": "4650403",
                    "speaker": "深渊法师",
                    "text": "原来你们也读过那「信」了吗…这种秘密就别妄想我会告诉你们了，哼哼…"
                },
                {
                    "id": "4650404",
                    "speaker": "迪卢克",
                    "text": "你恐怕是没搞清楚自己的处境吧…"
                },
                {
                    "id": "4651001",
                    "speaker": "Player",
                    "text": "使用<color=#00E1FFFF>「逆焰之手」</color>！"
                },
                {
                    "id": "4651501",
                    "speaker": "深渊法师",
                    "text": "以手为媒介放出了神之眼的火焰？…好烫！！"
                },
                {
                    "id": "4650601",
                    "speaker": "迪卢克",
                    "text": "让我看看你可以嘴硬到什么时候…"
                },
                {
                    "id": "4650405",
                    "speaker": "Player",
                    "text": "再次使用<color=#00E1FFFF>「逆焰之手」</color>！"
                },
                {
                    "id": "4651502",
                    "speaker": "深渊法师",
                    "text": "住手啊！…求你快让这痛苦停下来啊！！！",
                    "choices": [
                        {
                            "id": "4650406",
                            "text": "再次使用<color=#00E1FFFF>「逆焰之手」</color>！",
                            "response": [
                                {
                                    "id": "4651402",
                                    "speaker": "深渊法师",
                                    "text": "咳咳……"
                                },
                                {
                                    "id": "4651403",
                                    "speaker": "迪卢克",
                                    "text": "别想装死，这种程度的火焰还不会…嗯？好像是<color=#00E1FFFF>晕过去了</color>…"
                                },
                                {
                                    "id": "4651404",
                                    "speaker": "迪卢克",
                                    "text": "…喂，还没到睡觉的时候！"
                                },
                                {
                                    "id": "4651405",
                                    "speaker": "深渊法师",
                                    "text": "啊啊——好烫！！"
                                },
                                {
                                    "id": "4650901",
                                    "speaker": "深渊法师",
                                    "text": "我说我说！咳咳咳…快停下来，我<color=#00E1FFFF>全都交待</color>！！"
                                },
                                {
                                    "id": "4650902",
                                    "speaker": "深渊法师",
                                    "text": "教团…教团集结了所有仇恨「暗夜英雄」的力量…"
                                },
                                {
                                    "id": "4650903",
                                    "speaker": "深渊法师",
                                    "text": "准备在明晚10点左右从<color=#00E1FFFF>正门</color>突袭蒙德城…"
                                },
                                {
                                    "id": "4650904",
                                    "speaker": "深渊法师",
                                    "text": "我知道的就是这些了…真的，那种火焰我…再也承受不了啦…"
                                },
                                {
                                    "id": "4650905",
                                    "speaker": "迪卢克",
                                    "text": "就这些么？嗯…算了，谅你也不敢再隐瞒什么。"
                                }
                            ]
                        },
                        {
                            "id": "4651201",
                            "text": "尝试<color=#00E1FFFF>质问</color>作战情报…"
                        }
                    ]
                }
            ]
        },
