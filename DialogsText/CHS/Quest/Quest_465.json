        {
            "id": "46513",
            "objective": "向霍夫曼了解骑士团的情况",
            "dialogues": [
                {
                    "id": "4650501",
                    "speaker": "霍夫曼",
                    "text": "再不找到「暗夜英雄」的话…"
                },
                {
                    "id": "4650502",
                    "speaker": "Player",
                    "text": "「战书」的事骑士团准备如何处理？"
                },
                {
                    "id": "4650503",
                    "speaker": "霍夫曼",
                    "text": "啊…是你们。不瞒你们说，还真是有点头疼。"
                },
                {
                    "id": "4650504",
                    "speaker": "霍夫曼",
                    "text": "刚才的会议上刚刚确定了这次事件的行动方针，你猜怎样？",
                    "choices": [
                        {
                            "id": "4650505",
                            "text": "放任不管？",
                            "response": [
                                {
                                    "id": "4650506",
                                    "speaker": "霍夫曼",
                                    "text": "你这就是在开玩笑了，骑士团不会对任何危及蒙德安全的事袖手旁观。"
                                },
                                {
                                    "id": "4650507",
                                    "speaker": "霍夫曼",
                                    "text": "否则更多的人会去选择依靠「暗夜英雄」，而非骑士团了。"
                                },
                                {
                                    "id": "4650511",
                                    "speaker": "派蒙",
                                    "text": "唔，那你们的计划是？"
                                },
                                {
                                    "id": "4650512",
                                    "speaker": "霍夫曼",
                                    "text": "查明「暗夜英雄」的真实身份，并将他「保护」起来。"
                                },
                                {
                                    "id": "4650513",
                                    "speaker": "派蒙",
                                    "text": "「保护」？以他的实力还需要骑士团的保护吗？"
                                },
                                {
                                    "id": "4650514",
                                    "speaker": "霍夫曼",
                                    "text": "嘘——"
                                },
                                {
                                    "id": "4650515",
                                    "speaker": "霍夫曼",
                                    "text": "好吧，看在你们也帮助过骑士团的份儿上…我就明说吧。"
                                },
                                {
                                    "id": "4650516",
                                    "speaker": "霍夫曼",
                                    "text": "其实「保护」只是名义上如此，而其用意在于——骑士团准备完全接手这件事。"
                                },
                                {
                                    "id": "4650517",
                                    "speaker": "派蒙",
                                    "text": "不让「暗夜英雄」出手吗？为什么要这样呢？"
                                },
                                {
                                    "id": "4650518",
                                    "speaker": "霍夫曼",
                                    "text": "首先是为了证明骑士团的实力，告诉民众没有「暗夜英雄」，骑士团也可以摆平一切。"
                                },
                                {
                                    "id": "4650519",
                                    "speaker": "霍夫曼",
                                    "text": "况且深渊教团此番来者不善，万一「暗夜英雄」有什么不测…"
                                },
                                {
                                    "id": "4650520",
                                    "speaker": "霍夫曼",
                                    "text": "…那就等于助长了敌人的气焰。"
                                },
                                {
                                    "id": "4650521",
                                    "speaker": "派蒙",
                                    "text": "唔…骑士团也有自己的苦衷啊。"
                                },
                                {
                                    "id": "4650522",
                                    "speaker": "霍夫曼",
                                    "text": "可话虽这么说，如果不知道「暗夜英雄」的身份，一切也无从谈起。"
                                },
                                {
                                    "id": "4650523",
                                    "speaker": "凯亚",
                                    "text": "没必要这么苦恼，霍夫曼，按我说的做就好了。"
                                },
                                {
                                    "id": "4650524",
                                    "speaker": "霍夫曼",
                                    "text": "凯亚队长？"
                                },
                                {
                                    "id": "4650525",
                                    "speaker": "凯亚",
                                    "text": "最近每晚，迪卢克老爷都在「天使的馈赠」代班酒保…"
                                },
                                {
                                    "id": "4650526",
                                    "speaker": "凯亚",
                                    "text": "你只要负责看住他就行。如何，是不是一份美差？"
                                },
                                {
                                    "id": "4650527",
                                    "speaker": "霍夫曼",
                                    "text": "这当然没问题。不过…凯亚队长的意思是…"
                                },
                                {
                                    "id": "4650528",
                                    "speaker": "霍夫曼",
                                    "text": "「暗夜英雄」就是迪卢克先生？"
                                },
                                {
                                    "id": "4650529",
                                    "speaker": "凯亚",
                                    "text": "嗯~？谁知道呢，可能只是我的感觉吧。"
                                }
                            ]
                        },
                        {
                            "id": "4650508",
                            "text": "联合「暗夜英雄」？",
                            "response": [
                                {
                                    "id": "4650509",
                                    "speaker": "霍夫曼",
                                    "text": "不对，他们说那样就等于支持了「暗夜英雄」的存在。"
                                },
                                {
                                    "id": "4650510",
                                    "speaker": "霍夫曼",
                                    "text": "鼓励这种个人英雄主义的做法，有失骑士团的权威。"
                                }
                            ]
                        }
                    ]
                }
            ]
