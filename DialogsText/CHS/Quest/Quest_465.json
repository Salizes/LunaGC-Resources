        {
            "id": "46520",
            "objective": "击败深渊法师",
            "dialogues": [
                {
                    "id": "4652001",
                    "speaker": "迪卢克",
                    "text": "既然情报到手，我就先去做些准备了。"
                },
                {
                    "id": "4652002",
                    "speaker": "迪卢克",
                    "text": "可以的话，希望你们能帮我留意一下骑士团对此事的动向。"
                },
                {
                    "id": "4652003",
                    "speaker": "派蒙",
                    "text": "好的！遵命！迪卢克老爷！"
                },
                {
                    "id": "4652004",
                    "speaker": "迪卢克",
                    "text": "…你这是突然怎么了？"
                },
                {
                    "id": "4652005",
                    "speaker": "派蒙",
                    "text": "从，从刚才开始…"
                },
                {
                    "id": "4652006",
