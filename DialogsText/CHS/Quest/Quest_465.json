    "talks": [
        {
            "id": "46501",
            "objective": "等到白天",
            "dialogues": [
                {
                    "id": "4650101",
                    "speaker": "派蒙",
                    "text": "霍夫曼！"
                },
                {
                    "id": "4650102",
                    "speaker": "霍夫曼",
                    "text": "哦，是你们。感谢你们二位的配合。"
                },
                {
                    "id": "4650103",
                    "speaker": "霍夫曼",
                    "text": "上次我们聊到「暗夜英雄」的事…请问还有其他情报可以提供吗？",
                    "choices": [
                        {
                            "id": "4650104",
                            "text": "我可以先问问发生什么事了吗？",
                            "response": [
                                {
                                    "id": "4650105",
                                    "speaker": "霍夫曼",
                                    "text": "说的也是，提问之前自己要先提供必要的情报，是我疏忽了骑士的礼节。"
                                },
                                {
                                    "id": "4650108",
                                    "speaker": "霍夫曼",
                                    "text": "其实事情是这样的…你们先看看这个。"
                                },
                                {
                                    "id": "4650109",
                                    "speaker": "派蒙",
                                    "text": "呜哇，好丑的字！"
                                },
                                {
                                    "id": "4650110",
                                    "speaker": "派蒙",
                                    "text": "唔，仔细看看…好像有很多地方看不太懂的样子。"
                                },
                                {
                                    "id": "4650111",
                                    "speaker": "霍夫曼",
                                    "text": "确实，虽然是「通用语」，但很多地方写成了「密文」的样子。"
                                },
                                {
                                    "id": "4650112",
                                    "speaker": "霍夫曼",
                                    "text": "只看可以读懂的部分倒是也能大致理解…"
                                },
                                {
                                    "id": "4650119",
                                    "speaker": "霍夫曼",
                                    "text": "这是，深渊教团对「暗夜英雄」下的战书。"
                                },
                                {
                                    "id": "4650113",
                                    "speaker": "派蒙",
                                    "text": "也就是说「暗夜英雄」彻底被坏蛋盯上咯？"
                                },
                                {
                                    "id": "4650114",
                                    "speaker": "霍夫曼",
                                    "text": "这么说没错。所以可能的话，我们希望尽早与他一同商议对策。"
                                },
                                {
                                    "id": "4650115",
                                    "speaker": "霍夫曼",
                                    "text": "毕竟这不仅是「暗夜英雄」一个人的事，也是整个蒙德城的事。",
                                    "choices": [
                                        {
                                            "id": "4650116",
                                            "text": "谢谢你分享情报。",
                                            "response": [
                                                {
                                                    "id": "4650118",
                                                    "speaker": "霍夫曼",
                                                    "text": "嗯，最近如果有什么发现，欢迎随时来找我。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4650117",
                                            "text": "我会留意的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4650106",
                            "text": "抱歉，真的没有别的情报了。",
                            "response": [
                                {
                                    "id": "4650107",
                                    "speaker": "霍夫曼",
                                    "text": "是吗…那可真是遗憾。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "46502",
            "objective": "到骑士团看看",
            "dialogues": [
                {
                    "id": "4650201",
                    "speaker": "派蒙",
                    "text": "迪卢克老爷！快听我说，刚刚我们在骑士团…"
                },
                {
                    "id": "4650202",
                    "speaker": "迪卢克",
                    "text": "是深渊教团下的战书吧？"
                },
                {
                    "id": "4650203",
                    "speaker": "迪卢克",
                    "text": "我已经知道了，谢谢你们特地跑一趟。"
                },
                {
                    "id": "4650204",
                    "speaker": "派蒙",
                    "text": "咦？"
                },
                {
                    "id": "4650205",
                    "speaker": "迪卢克",
                    "text": "晨曦酒庄的情报网可并不限于商业情报。"
                },
                {
                    "id": "4650206",
                    "speaker": "派蒙",
                    "text": "那么迪卢克老爷打算怎么办呢？"
                },
                {
                    "id": "4650207",
                    "speaker": "迪卢克",
                    "text": "你们的意见呢？",
                    "choices": [
                        {
                            "id": "4650208",
                            "text": "还是和骑士团联手吧…",
                            "response": [
                                {
                                    "id": "4650209",
                                    "speaker": "迪卢克",
                                    "text": "那样就正中深渊教团的下怀了。"
                                },
                                {
                                    "id": "4650210",
                                    "speaker": "迪卢克",
                                    "text": "他们看准我与骑士团合不来，想要逼我在他们面前现身。"
                                },
                                {
                                    "id": "4650211",
                                    "speaker": "迪卢克",
                                    "text": "一旦我的身份暴露，以后的行动就难免会受到骑士团的干预。"
                                },
                                {
                                    "id": "4650212",
                                    "speaker": "迪卢克",
                                    "text": "毕竟没有哪个掌控着权力的组织，甘愿由外人来「代行正义」。"
                                },
                                {
                                    "id": "4650217",
                                    "speaker": "派蒙",
                                    "text": "唔…深渊教团这下可真是出了个大难题呀，好狡猾的家伙们。"
                                },
                                {
                                    "id": "4650218",
                                    "speaker": "迪卢克",
                                    "text": "办法还是有的，只是需要先建立一些情报优势…"
                                },
                                {
                                    "id": "4650219",
                                    "speaker": "迪卢克",
                                    "text": "…战书里的那些被刻意掩盖的情报。"
                                },
                                {
                                    "id": "4650220",
                                    "speaker": "派蒙",
                                    "text": "刻意掩盖？你指的是看不懂的那些部分吗？"
                                },
                                {
                                    "id": "4650221",
                                    "speaker": "迪卢克",
                                    "text": "想必那是一种只有他们才懂的，在内部流传的「暗文」格式。",
                                    "choices": [
                                        {
                                            "id": "4650222",
                                            "text": "难道「战书」其实是给自己人看的？",
                                            "response": [
                                                {
                                                    "id": "4650224",
                                                    "speaker": "迪卢克",
                                                    "text": "所以那不仅仅是「战书」，更是他们自己的「行动通告」。"
                                                },
                                                {
                                                    "id": "4650225",
                                                    "speaker": "迪卢克",
                                                    "text": "当立场对立的时候，一方眼中的「英雄」，便必定是另一方眼中的「恶人」。"
                                                },
                                                {
                                                    "id": "4650226",
                                                    "speaker": "迪卢克",
                                                    "text": "既然我已经做了这么久「恶人」…"
                                                },
                                                {
                                                    "id": "4650227",
                                                    "speaker": "迪卢克",
                                                    "text": "深渊教团把我树立为行动目标，必然可以使内部力量更加团结。"
                                                },
                                                {
                                                    "id": "4650228",
                                                    "speaker": "派蒙",
                                                    "text": "…唔哇…是不是当英雄的都要有你这么厉害的头脑？"
                                                },
                                                {
                                                    "id": "4650229",
                                                    "speaker": "迪卢克",
                                                    "text": "我只是很了解他们而已，正如我说「英雄」也是另一视角上的「恶人」。"
                                                },
                                                {
                                                    "id": "4650230",
                                                    "speaker": "派蒙",
                                                    "text": "于是那些看不懂的情报，我们到底该怎么办呢…"
                                                },
                                                {
                                                    "id": "4650231",
                                                    "speaker": "迪卢克",
                                                    "text": "不懂就去问，这很简单。"
                                                },
                                                {
                                                    "id": "4650232",
                                                    "speaker": "迪卢克",
                                                    "text": "我已经查明一处他们的<color=#00E1FFFF>据点</color>…感兴趣的话就跟我来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4650223",
                                            "text": "既然我们不懂，为何还要写出来？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4650213",
                            "text": "先暂时在酒庄避避风头？",
                            "response": [
                                {
                                    "id": "4650214",
                                    "speaker": "迪卢克",
                                    "text": "那也就意味着要全部交由骑士团来处理。"
                                },
                                {
                                    "id": "4650215",
                                    "speaker": "迪卢克",
                                    "text": "如果他们值得托付，事情也不会走到这一步。"
                                },
                                {
                                    "id": "4650216",
                                    "speaker": "迪卢克",
                                    "text": "况且我迪卢克也还不至于沦落到自己躲起来，让骑士团为我善后的地步。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "46503",
            "objective": "与骑士团门口的霍夫曼对话",
