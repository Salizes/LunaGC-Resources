    "talks": [
        {
            "id": "7082401",
            "objective": "与爱德琳对话$HIDDEN",
            "dialogues": [
                {
                    "id": "708240201",
                    "speaker": "Player",
                    "text": "我来帮忙。"
                },
                {
                    "id": "708240202",
                    "speaker": "爱德琳",
                    "text": "您知道如何打扫吗？算了…现在正是缺人手的时候，您愿意帮忙再好不过了。"
                },
                {
                    "id": "708240203",
                    "speaker": "爱德琳",
                    "text": "请您跟我进屋里去吧，里面有很多需要打扫的地方。"
                }
            ]
        },
        {
            "id": "7082402",
            "objective": "随爱德琳进入晨曦酒庄",
            "dialogues": []
        },
        {
            "id": "7082403",
            "objective": "打扫所有污渍",
            "dialogues": [
                {
                    "id": "708240301",
                    "speaker": "Player",
                    "text": "我很擅长打扫。"
                },
                {
                    "id": "708240302",
                    "speaker": "爱德琳",
                    "text": "是吗？那正好，如果您愿意的话，就来帮一下忙吧。"
                },
                {
                    "id": "708240303",
                    "speaker": "爱德琳",
                    "text": "请您跟我进屋里去吧，里面有很多需要打扫的地方。"
                }
            ]
        },
        {
            "id": "7082404",
            "objective": "与爱德琳对话",
            "dialogues": [
                {
                    "id": "708240401",
                    "speaker": "爱德琳",
                    "text": "您打扫完了吗？"
                },
                {
                    "id": "708240402",
                    "speaker": "Player",
                    "text": "打扫干净了。"
                },
                {
                    "id": "708240403",
                    "speaker": "爱德琳",
                    "text": "太好了，实在是帮大忙了，如果就我一个人的话，不知道要扫到什么时候去。"
                },
                {
                    "id": "708240404",
                    "speaker": "爱德琳",
                    "text": "如果让摩可和海莉来打扫…那就不知道她们又要打翻多少东西了…"
                },
                {
                    "id": "708240405",
                    "speaker": "爱德琳",
                    "text": "谢谢您，这些请您收下吧，您本来是客人，让您帮忙打扫实在是不好意思。"
                },
                {
                    "id": "708240406",
                    "speaker": "爱德琳",
                    "text": "您下次光临酒庄的时候，这里一定会整洁如新的。"
                }
            ]
        },
        {
            "id": "7082401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708240101",
                    "speaker": "爱德琳",
                    "text": "打扫得细心一点！这可是客人们对酒庄的第一印象！"
                },
                {
                    "id": "708240102",
                    "speaker": "摩可",
                    "text": "对不起！"
                },
                {
                    "id": "708240103",
                    "speaker": "海莉",
                    "text": "我们会再细心点！"
                },
                {
                    "id": "708240104",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "708240105",
                    "speaker": "爱德琳",
                    "text": "是您啊，欢迎光临晨曦酒庄，暴风虽然平息了，但被暴风弄得乱七八糟的酒庄还要收拾。"
                },
                {
                    "id": "708240106",
                    "speaker": "爱德琳",
                    "text": "我正在安排打扫的事，但是摩可和海莉，实在是…"
                },
                {
                    "id": "708240107",
                    "speaker": "摩可",
                    "text": "对不起！"
                },
                {
                    "id": "708240108",
                    "speaker": "海莉",
                    "text": "我们会再细心点！"
                },
                {
                    "id": "708240109",
                    "speaker": "爱德琳",
                    "text": "你们已经说过一次了！有道歉的功夫，还不如去再细心打扫一遍，还不快去！"
                },
                {
                    "id": "708240110",
                    "speaker": "爱德琳",
                    "text": "唉，这两个孩子，怎么老是这么粗心，用这种工作效率，什么时候才能收拾完，屋子里面可还要打扫呢。"
                }
            ]
        },
        {
            "id": "7082406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708240601",
                    "speaker": "海莉",
                    "text": "唉，酒庄这么大，怎么打扫都打扫不完…"
                },
                {
                    "id": "708240602",
                    "speaker": "摩可",
                    "text": "扫完了屋子外面还有屋子里面，什么时候才能完全扫干净啊…"
                }
            ]
        },
        {
            "id": "7082407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708240701",
                    "speaker": "爱德琳",
                    "text": "您愿意帮忙真是太好了，摩可和海莉那两个孩子，真是…"
                }
            ]
        },
        {
            "id": "7082409",
            "objective": "Additional",
            "dialogues": [
                {
