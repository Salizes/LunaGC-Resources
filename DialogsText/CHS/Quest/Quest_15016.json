    "talks": [
        {
            "id": "1501602",
            "objective": "等到次日后，再去希诺宁的工坊拜访",
            "dialogues": []
        },
        {
            "id": "1501601",
            "objective": "前往希诺宁的工坊拜访",
            "dialogues": [
                {
                    "id": "150160101",
                    "speaker": "希诺宁",
                    "text": "噢，你们来了啊，事情都处理完了。我正打算去休息呢。"
                },
                {
                    "id": "150160102",
                    "speaker": "Player",
                    "text": "特拉佐莉会受到什么处罚？"
                },
                {
                    "id": "150160103",
                    "speaker": "希诺宁",
                    "text": "部族里还在商量着呢，用古名技术来犯罪的人，古往今来也没多少…帕加尔可要头疼一阵了。"
                },
                {
                    "id": "150160104",
                    "speaker": "希诺宁",
                    "text": "能够确定的是，特拉佐莉的工坊会被完全封闭，剩余那些未成型的「燃晶名刻」也会彻底销毁。"
                },
                {
                    "id": "150160105",
                    "speaker": "希诺宁",
                    "text": "至于那些已经成型的「燃晶名刻」，我会接手处理。唉，又是个麻烦的工作…"
                },
                {
                    "id": "150160106",
                    "speaker": "希诺宁",
                    "text": "无论如何，至少她的「古名」没出问题，不然乱子可就大了…"
                },
                {
                    "id": "150160107",
                    "speaker": "希诺宁",
                    "text": "噢，说到古名。倒是有个好消息。「燃晶名刻」所汲取的记忆是可恢复的。"
                },
                {
                    "id": "150160108",
                    "speaker": "希诺宁",
                    "text": "等到所有「燃晶名刻」都停止工作后，那些回忆应该就会顺着原路，物归原主了。",
                    "choices": [
                        {
                            "id": "150160109",
                            "text": "那大家关于妮赫佳的记忆…",
                            "response": [
                                {
                                    "id": "150160111",
                                    "speaker": "希诺宁",
                                    "text": "是啊。这么一想…婶婶想要妮赫佳回来，所以让整个部族的人都忘记了妮赫佳。"
                                },
                                {
                                    "id": "150160112",
                                    "speaker": "希诺宁",
                                    "text": "现在妮赫佳真的离开了，大家却又即将想起她…真是乱七八糟。"
                                },
                                {
                                    "id": "150160113",
                                    "speaker": "Player",
                                    "text": "妮佩卡现在的情况还好吗？"
                                },
                                {
                                    "id": "150160114",
                                    "speaker": "希诺宁",
                                    "text": "她正在我的工坊里休息呢，我已经联系了同族的人，准备正式查一查这孩子的身世。"
                                },
                                {
                                    "id": "150160115",
                                    "speaker": "希诺宁",
                                    "text": "现在族里还没给我回信，所以我就打算先照顾着她，顺便教她点手艺。"
                                },
                                {
                                    "id": "150160116",
                                    "speaker": "希诺宁",
                                    "text": "这都是后话了。现在就让妮佩卡好好睡一觉吧。"
                                },
                                {
                                    "id": "150160117",
                                    "speaker": "希诺宁",
                                    "text": "只有睡饱了，才有精力面对这么多麻烦。"
                                }
                            ]
                        },
                        {
                            "id": "150160110",
                            "text": "也会一起回来？"
                        }
                    ]
                }
            ]
        }
    ]
}