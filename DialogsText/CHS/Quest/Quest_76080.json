        {
            "id": "7608001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760800101",
                    "speaker": "菲林斯",
                    "text": "等等，裂隙的里面有什么东西在挣扎，那种气息…不是狂猎。"
                },
                {
                    "id": "760800102",
                    "speaker": "菲林斯",
                    "text": "解开狂猎的禁锢看看，或许是被狂猎抓住的无辜生灵。"
                }
            ]
        },
        {
            "id": "7608002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7608003",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760800301",
                    "speaker": "诡异的裂隙",
                    "text": "（即便魔物已经散去，黑暗依然未褪，要解决这里的问题，或许需要对狂猎有了解的专业人士协助。）"
                }
            ]
        },
        {
            "id": "7608004",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760800201",
                    "speaker": "菲林斯",
                    "text": "希汐岛上向来少有狂猎肆虐，狂猎似乎畏惧着月亮的力量，不敢靠近。"
                },
                {
                    "id": "760800202",
                    "speaker": "菲林斯",
                    "text": "好了，已经护送月灵回到了希汐岛，希望它下次不要再落入险境。"
                }
            ]
        },
        {
            "id": "7608004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760800401",
                    "speaker": "叶洛亚",
                    "text": "等等，有什么东西被困在裂隙里面了吗…"
                },
                {
                    "id": "760800402",
                    "speaker": "叶洛亚",
                    "text": "别害怕，我现在就救你出来。"
                }
            ]
        },
        {
            "id": "7608005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760800501",
                    "speaker": "叶洛亚",
                    "text": "到这里应该就安全了吧，月亮的力量守护着这里，连狂猎也不敢靠近。"
                },
                {
                    "id": "760800502",
                    "speaker": "叶洛亚",
                    "text": "好啦，小家伙。可别再被狂猎抓住了。"
                }
            ]
        }
    ]
}