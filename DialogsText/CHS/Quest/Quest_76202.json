{
    "quest": {
        "id": "76202",
        "title": "欢腾浮岛",
        "description": "某日，一个神秘的声音邀请你前往她的魔女小屋做客…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "UI_ChapterIcon_NodKrai",
