    "talks": [
        {
            "id": "7620201",
            "objective": "前往魔女的花园",
            "dialogues": [
                {
                    "id": "762020101",
                    "speaker": "Player",
                    "text": "推门进去。"
                }
            ]
        },
        {
            "id": "7620202",
            "objective": "进入小屋",
            "dialogues": [
                {
                    "id": "762020201",
                    "speaker": "尼可",
                    "text": "欢迎光临。",
                    "choices": [
                        {
                            "id": "762020202",
                            "text": "你好啊，尼可。",
                            "response": [
                                {
                                    "id": "762020204",
                                    "speaker": "派蒙",
                                    "text": "哇，好华丽气派的屋子，你装潢得很漂亮嘛！"
                                },
                                {
                                    "id": "762020205",
                                    "speaker": "尼可",
                                    "text": "哼哼，真有眼光，不枉费我这些日子里虽然是抽空但也很用心做的设计。"
                                },
                                {
                                    "id": "762020206",
                                    "speaker": "尼可",
                                    "text": "——具体就要从这座秘密小屋建成之日说起了。"
                                },
                                {
                                    "id": "762020207",
                                    "speaker": "尼可",
                                    "text": "我本来想趁手感不错，多去修建几座魔女小屋，但没人帮忙提供新的灵感，久了又觉得没劲。"
                                },
                                {
                                    "id": "762020208",
                                    "speaker": "尼可",
                                    "text": "「就没有既有趣又好玩，还能得到成就感的做法吗？」我的脑海中咻地闪过了答案。"
                                },
                                {
                                    "id": "762020209",
                                    "speaker": "派蒙",
                                    "text": "等下，直接到答案了吗？"
                                },
                                {
                                    "id": "762020210",
                                    "speaker": "尼可",
                                    "text": "话不等人啊。喏，它就在你们的眼前。"
                                },
                                {
                                    "id": "762020211",
                                    "speaker": "派蒙",
                                    "text": "这扇门后？"
                                },
                                {
                                    "id": "762020212",
                                    "speaker": "尼可",
                                    "text": "其实不止这扇门，但也不算错，总要有个先后顺序，那就从它开始吧，准备好了吗？"
                                },
                                {
                                    "id": "762020213",
                                    "speaker": "派蒙",
                                    "text": "等…等一下，你语速太快了，我有点跟不上来…你要我们准备什么？"
                                },
                                {
                                    "id": "762020214",
                                    "speaker": "尼可",
                                    "text": "噢，别紧张，什么都不用你们准备。我就象征性地问一声。"
                                },
                                {
                                    "id": "762020215",
                                    "speaker": "尼可",
                                    "text": "凭我的观察和对你们的了解…比起复杂的事先说明和解释，你们更喜欢在探索过程中挖掘乐趣吧？",
                                    "choices": [
                                        {
                                            "id": "762020216",
                                            "text": "倒是没说错…",
                                            "response": [
                                                {
                                                    "id": "762020218",
                                                    "speaker": "尼可",
                                                    "text": "哈哈，这话我爱听，那我就真的真的不客气喽！"
                                                },
                                                {
                                                    "id": "762020219",
                                                    "speaker": "尼可",
                                                    "text": "#{NICKNAME}，你是了解我们天使的，引导人寻找宝藏的那份满足感向来叫我们无法自拔。"
                                                },
                                                {
                                                    "id": "762020220",
                                                    "speaker": "尼可",
                                                    "text": "既然一样要与人为善，助人为乐，怎么能不先想想自己的朋友呢？"
                                                },
                                                {
                                                    "id": "762020221",
                                                    "speaker": "尼可",
                                                    "text": "于是我灵机一动，把小屋打造成了可供你们休闲玩耍的游乐屋，还把宝物分别藏进了每个房间里。"
                                                },
                                                {
                                                    "id": "762020222",
                                                    "speaker": "尼可",
                                                    "text": "实不相瞒，即使是在众多天使之中，我也是藏东西的好手噢！"
                                                },
                                                {
                                                    "id": "762020223",
                                                    "speaker": "尼可",
                                                    "text": "真要我去外面认认真真埋一个宝箱，还不给你们带路的话，只恐怕你们花上几个月都找不到。"
                                                },
                                                {
                                                    "id": "762020224",
                                                    "speaker": "尼可",
                                                    "text": "咳咳，说远了…"
                                                },
                                                {
                                                    "id": "762020225",
                                                    "speaker": "尼可",
                                                    "text": "总之，我不会故意为难你们，也不需要你们为了我的小小爱好在荒郊野岭东奔西跑…"
                                                },
                                                {
                                                    "id": "762020226",
                                                    "speaker": "尼可",
                                                    "text": "只要在房间里找到三片象征宝物的羽毛就可以过关了！到了那个时候，嘿嘿，请务必在我面前打开宝箱！"
                                                },
                                                {
                                                    "id": "762020227",
                                                    "speaker": "派蒙",
                                                    "text": "这下我全听懂了！宝藏，我等不及了！"
                                                },
                                                {
                                                    "id": "762020228",
                                                    "speaker": "尼可",
                                                    "text": "宝藏，我也等不及了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "762020217",
                                            "text": "但尼可的说明还是想听听的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "762020203",
                            "text": "很荣幸来这里做客。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7620203",
            "objective": "进入房间",
            "dialogues": []
        },
        {
            "id": "7620211",
            "objective": "探索房间内部",
            "dialogues": []
        },
        {
            "id": "7620204",
            "objective": "探索房间内部",
            "dialogues": [
                {
                    "id": "762020301",
                    "speaker": "Black Screen",
                    "text": "一阵风扑面而来。\\n真奇怪，它尝起来有双果卷、夏槲蛋糕、脆脆烤肉和花果草糖的味道。"
                },
                {
                    "id": "762020302",
                    "speaker": "派蒙",
                    "text": "呃！突然有一股好甜的风钻进喉咙里了，咳咳咳…咦？我们这是在哪里？茶壶和杯子看着好大…"
                },
                {
                    "id": "762020303",
                    "speaker": "派蒙",
                    "text": "还是说…是我们变小了？！"
                },
                {
                    "id": "762020304",
                    "speaker": "Player",
                    "text": "看起来像是尼可的魔法。"
                },
                {
                    "id": "762020305",
                    "speaker": "尼可",
                    "text": "很抱歉，我没能邀请对应的动物演员，我平时都是和石头演员打交道的…"
                },
                {
                    "id": "762020306",
                    "speaker": "派蒙",
                    "text": "欸？尼可你也是小小的样子嘛，我还以为你也会变大。"
                },
                {
                    "id": "762020307",
                    "speaker": "尼可",
                    "text": "蹲下身也能做到顶天立地的巨大魔女尼可？不了不了，我对我现在的形态已经足够满意了。"
                },
                {
                    "id": "762020308",
                    "speaker": "尼可",
                    "text": "总之，欢迎加入伟大魔女的茶会时光！现在，添茶吧！"
                }
            ]
        },
        {
            "id": "7620205",
            "objective": "运用火元素加热茶壶",
            "dialogues": [
                {
                    "id": "762020501",
                    "speaker": "查看房门",
                    "text": "（门后隐约传来茶勺敲击茶杯的声响…）"
                }
            ]
        },
        {
            "id": "7620206",
            "objective": "探索房间内部",
            "dialogues": [
                {
                    "id": "762020601",
                    "speaker": "派蒙",
                    "text": "突然往下滑了一段，吓我一跳。欸，是个巨大的…曼陀草雕塑？"
                },
                {
                    "id": "762020602",
                    "speaker": "曼陀草",
                    "text": "咯咯。"
                },
                {
                    "id": "762020603",
                    "speaker": "尼可",
                    "text": "稍等，不好意思，好像哪里出了点小差错。不应该啊…"
                },
                {
                    "id": "762020604",
                    "speaker": "曼陀草",
                    "text": "咯——咯——"
                },
                {
                    "id": "762020605",
                    "speaker": "派蒙",
                    "text": "它动起来了，好像是想要攻击我们！"
                },
                {
                    "id": "762020606",
                    "speaker": "尼可",
                    "text": "呼，这下对了…"
                }
            ]
        },
        {
            "id": "7620207",
            "objective": "击败巨大的曼陀草雕塑",
            "dialogues": []
        },
        {
            "id": "7620208",
            "objective": "触碰「羽毛」",
            "dialogues": []
        },
        {
            "id": "7620210",
            "objective": "开启宝箱",
            "dialogues": []
        },
        {
            "id": "7620209",
            "objective": "与尼可对话",
            "dialogues": [
                {
                    "id": "762020901",
                    "speaker": "派蒙",
                    "text": "话说回来，明明是送东西给我们，尼可为什么那么兴奋呢？"
                },
                {
                    "id": "762020902",
                    "speaker": "派蒙",
                    "text": "#我是说，我送礼物给{NICKNAME}的时候也会期待{M#他}{F#她}的反应啦，但和尼可的状态好像不太一样？"
                },
                {
                    "id": "762020903",
                    "speaker": "Player",
                    "text": "这是可以问的吗？"
                },
                {
                    "id": "762020904",
                    "speaker": "尼可",
                    "text": "这部分没关系啦，我是不介意的。顶多让你们对天使一族的好感有些许幻灭，从以为天使都是大好人到明白真相而已。"
                },
                {
                    "id": "762020905",
                    "speaker": "尼可",
                    "text": "派蒙提到的那点，实质上并不是因为我们能和受引导的对象共情，而是我们身负的任务与命令使然。"
                },
                {
                    "id": "762020906",
                    "speaker": "派蒙",
                    "text": "啊？"
                },
                {
                    "id": "762020907",
                    "speaker": "尼可",
                    "text": "——具体就要从天使的诞生之初说起了。"
                },
                {
                    "id": "762020908",
                    "speaker": "尼可",
                    "text": "天使被授予了爱这地上众生的使命，但不同于后来的魔神…"
                },
                {
                    "id": "762020909",
                    "speaker": "尼可",
                    "text": "我们对情感的感知并不丰富，更多时候是在机械地执行天空的命令。"
                },
                {
                    "id": "762020910",
                    "speaker": "尼可",
                    "text": "除了「教化」，「引导」是我们最主要的任务，它也成了昔日同僚失去智慧后为数不多保留的本能。"
                },
                {
                    "id": "762020911",
                    "speaker": "尼可",
                    "text": "当这项任务被达成的时候，我们能够从中获得某种释然的喜悦，这已经算是我们平时能找到的最强烈的情感体验了。"
                },
                {
                    "id": "762020912",
                    "speaker": "派蒙",
                    "text": "那岂不是…有点可怜？"
                },
                {
                    "id": "762020913",
                    "speaker": "尼可",
                    "text": "或许吧，但我不愿把它当成需要怜悯的事，毕竟，即使是高天的主宰也没法否定此刻我心中那份情感的真实性。"
                },
                {
                    "id": "762020914",
                    "speaker": "尼可",
                    "text": "无论如何，我们完成的都是一件好事，对吧？"
                }
            ]
        },
        {
            "id": "7620204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762020401",
                    "speaker": "尼可",
                    "text": "刚才没听明白？哎呀很简单的，总之就是发动脑筋，努力寻宝，最后拿到宝藏，完全是你们擅长的事！"
                }
            ]
        },
        {
            "id": "7620212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762021201",
                    "speaker": "Player",
                    "text": "再看看。"
                }
            ]
        },
        {
            "id": "7620214",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762021401",
                    "speaker": "派蒙",
                    "text": "尼可，你在说些什么啊？"
                },
                {
                    "id": "762021402",
                    "speaker": "尼可",
                    "text": "#嗯？这点攻击不是不痛不痒嘛？正是{NICKNAME}表现的时候。"
                },
                {
                    "id": "762021403",
                    "speaker": "派蒙",
                    "text": "哎，哎，尼可你也帮帮忙啦！"
                },
                {
                    "id": "762021404",
                    "speaker": "尼可",
                    "text": "好吧，那就…「吾以己心代天心」！"
                }
            ]
        },
        {
            "id": "7620216",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762021601",
                    "speaker": "尼可",
                    "text": "如果可以的话，过段时间再来看看吧。我也要多去检查一下其他房间的设计…"
                }
            ]
        },
        {
            "id": "7620298",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762029801",
                    "speaker": "Black Screen",
                    "text": ""
                },
                {
                    "id": "762029802",
                    "speaker": "<UNKNOWN>",
                    "text": "一阵风扑面而来。\\n真奇怪，它尝起来有双果卷、夏槲蛋糕、脆脆烤肉和花果草糖的味道。"
                },
                {
                    "id": "762029803",
                    "speaker": "（test）茶杯气泡01",
                    "text": "感觉不够甜啊…"
                },
                {
                    "id": "762029804",
                    "speaker": "<UNKNOWN>",
                    "text": "感觉不够甜啊…"
                },
                {
                    "id": "762029805",
                    "speaker": "<UNKNOWN>",
                    "text": "嗯！甜度正好！"
                },
                {
                    "id": "762029806",
                    "speaker": "（test）茶杯气泡01",
                    "text": "嗯！甜度正好！"
                },
                {
                    "id": "762029807",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        },
        {
            "id": "7620299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762029904",
                    "speaker": "派蒙",
                    "text": "噢！又是这个光球，我们跟上去。"
                },
                {
                    "id": "762029905",
                    "speaker": "派蒙",
                    "text": "光球消失在门后了！也就是说，这扇门已经可以打开了对吧？"
                },
                {
                    "id": "762029906",
                    "speaker": "尼可",
                    "text": "…茶还是温的呢。嗯，真美味。"
                },
                {
                    "id": "762029907",
                    "speaker": "派蒙",
                    "text": "你该不会是为了这个时刻才安排的这一出…"
                },
                {
                    "id": "762029908",
                    "speaker": "尼可",
                    "text": "呵呵…这是你们辛苦努力的报酬。来，快打开吧！"
                },
                {
                    "id": "762029909",
                    "speaker": "派蒙",
                    "text": "哎，哎，尼可你也帮帮忙啦！"
                },
                {
                    "id": "762029910",
                    "speaker": "尼可",
                    "text": "好吧，那就…「吾以己心代天心」！"
                }
            ]
        }
    ]
