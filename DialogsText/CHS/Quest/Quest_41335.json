    "talks": [
        {
            "id": "4133509",
            "objective": "（test）居民委托领取任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4133501",
            "objective": "与梵米尔对话",
            "dialogues": [
                {
                    "id": "413350101",
                    "speaker": "梵米尔",
                    "text": "不对，这样也不对…"
                },
                {
                    "id": "413350102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "413350103",
                    "speaker": "梵米尔",
                    "text": "啊，你好，我正在这附近取材呢。"
                },
                {
                    "id": "413350104",
                    "speaker": "梵米尔",
                    "text": "现在不是正在海灯节期间吗？我正在想，怎么才能用一幅画来描绘海灯节和璃月港呢。"
                },
                {
                    "id": "413350105",
                    "speaker": "梵米尔",
                    "text": "唉…不知道是我用的手法不对，还是什么原因…怎么画都感觉不对劲。"
                },
                {
                    "id": "413350106",
                    "speaker": "梵米尔",
                    "text": "我在想，也许换个取景地能有些灵感，但我又实在找不到好取景地…"
                },
                {
                    "id": "413350107",
                    "speaker": "梵米尔",
                    "text": "旅行者，你知道哪里有适合取景的地方吗？"
                },
                {
                    "id": "413350108",
                    "speaker": "Player",
                    "text": "那我们去周围找找吧。"
                },
                {
                    "id": "413350109",
                    "speaker": "梵米尔",
                    "text": "唔…也好，那我们一起去周围看看吧，说不定真能找到好取景地。"
                }
            ]
        },
        {
            "id": "4133502",
            "objective": "寻找合适的取景地",
            "dialogues": []
        },
        {
            "id": "4133503",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "413350301",
                    "speaker": "梵米尔",
                    "text": "这里的景色还不错。咦，这位是…"
                },
                {
                    "id": "413350302",
                    "speaker": "清昼",
                    "text": "在下清昼，自诩诗客。您是…"
                },
                {
                    "id": "413350303",
                    "speaker": "梵米尔",
                    "text": "哈哈，你是个诗人吗？我是个画家，正在这附近取材呢。"
                },
                {
                    "id": "413350304",
                    "speaker": "清昼",
                    "text": "取材？巧了，我也正在取材，敢问您是为何取材？"
                },
                {
                    "id": "413350305",
                    "speaker": "梵米尔",
                    "text": "唔，我想要画一幅画来描绘海灯节和璃月港，正在和这位旅行者一起找最佳取景点。"
                },
                {
                    "id": "413350306",
                    "speaker": "梵米尔",
                    "text": "对了，您又是为什么在这取材的？"
                },
                {
                    "id": "413350307",
                    "speaker": "清昼",
                    "text": "嗯…这确实是巧了，我也正好想要写一首诗来描述海灯节和璃月港，也正在这里取材。"
                },
                {
                    "id": "413350308",
                    "speaker": "梵米尔",
                    "text": "嗯…"
                },
                {
                    "id": "413350309",
                    "speaker": "清昼",
                    "text": "唔…"
                },
                {
                    "id": "413350310",
                    "speaker": "梵米尔",
                    "text": "一首诗…有点简单了吧，海灯节和璃月港用几行字怎么能描述得下来？"
                },
                {
                    "id": "413350311",
                    "speaker": "梵米尔",
                    "text": "哈哈，要我说，还是得画一幅大画，才能把这些事物全部给描绘下来。"
                },
                {
                    "id": "413350312",
                    "speaker": "清昼",
                    "text": "一幅大画？呵呵，我倒是觉得这样太费笔墨，反倒是把海灯节的神韵给遮盖了下来，也失了璃月之风。"
                },
                {
                    "id": "413350313",
                    "speaker": "清昼",
                    "text": "再说了，如此大的璃月，又怎么能是一幅画能画下来的？"
                },
                {
                    "id": "413350314",
                    "speaker": "梵米尔",
                    "text": "哈哈，我看，还是画好。"
                },
                {
                    "id": "413350315",
                    "speaker": "清昼",
                    "text": "呵呵，我想，还是诗好。"
                },
                {
                    "id": "413350316",
                    "speaker": "Player",
                    "text": "你们冷静点…"
                },
                {
                    "id": "413350317",
                    "speaker": "梵米尔",
                    "text": "这么争下去也没个头，不如这样，我们各自去创作一番。"
                },
                {
                    "id": "413350318",
                    "speaker": "梵米尔",
                    "text": "等创作完了，再把作品摆在一起，请个人来评判，怎么样？"
                },
                {
                    "id": "413350319",
                    "speaker": "清昼",
                    "text": "这样也好，那等你画好了画，就来望舒客栈找我吧。然后我们再去找人评判。"
                },
                {
                    "id": "413350320",
                    "speaker": "梵米尔",
                    "text": "好，那就一言为定。"
                },
                {
                    "id": "413350321",
                    "speaker": "清昼",
                    "text": "一言为定，在下就先告辞了。"
                },
                {
                    "id": "413350322",
                    "speaker": "梵米尔",
                    "text": "这个诗人真是大言不惭，凭几行字就想概括海灯节和璃月港…"
                },
                {
                    "id": "413350323",
                    "speaker": "梵米尔",
                    "text": "哼，等我把画画出来了，这诗人肯定得认输。"
                },
                {
                    "id": "413350324",
                    "speaker": "梵米尔",
                    "text": "这幅画我得好好画…画材也得特别准备一下才好。"
                },
                {
                    "id": "413350325",
                    "speaker": "梵米尔",
                    "text": "旅行者，能请你帮我去搜集一点特别的材料吗？",
                    "choices": [
                        {
                            "id": "413350326",
                            "text": "我知道了…",
                            "response": [
                                {
                                    "id": "413350327",
                                    "speaker": "梵米尔",
                                    "text": "那就拜托你了，我想想…"
                                },
                                {
                                    "id": "413350329",
                                    "speaker": "梵米尔",
                                    "text": "唔…请你帮我去从炽热骗骗花那里搜集一份骗骗花蜜吧。"
                                },
                                {
                                    "id": "413350330",
                                    "speaker": "梵米尔",
                                    "text": "有了它，我一定能做出一份特别的颜料…"
                                }
                            ]
                        },
                        {
                            "id": "413350328",
                            "text": "要什么材料？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133506",
            "objective": "搜集「炽热的骗骗花蜜」",
            "dialogues": []
        },
        {
            "id": "4133507",
            "objective": "向梵米尔回报",
            "dialogues": [
                {
                    "id": "413350701",
                    "speaker": "梵米尔",
                    "text": "怎么样，你拿到骗骗花蜜了吗？"
                },
                {
                    "id": "413350702",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "413350703",
                    "speaker": "梵米尔",
                    "text": "我看看，哎，就是这个，不错不错。"
                },
                {
                    "id": "413350704",
                    "speaker": "梵米尔",
                    "text": "等我把颜料调制好，再找个取景点，我就开始画画。"
                },
                {
                    "id": "413350705",
                    "speaker": "梵米尔",
                    "text": "哼，等那个诗人看到了我画的画，一定心服口服。"
                },
                {
                    "id": "413350706",
                    "speaker": "梵米尔",
                    "text": "啊…对了！我记得，璃月的海灯节是要放「霄灯」，还要在上面写愿望什么的…对吧？"
                },
                {
                    "id": "413350707",
                    "speaker": "梵米尔",
                    "text": "嘿嘿，我也把霄灯准备好了，愿望嘛…我就不告诉你了，不然说不定就不灵了。"
                },
                {
                    "id": "413350708",
                    "speaker": "梵米尔",
                    "text": "哦，差点忘了…这些东西给你，就当是报酬吧，谢谢你帮我的忙。"
                },
                {
                    "id": "413350709",
                    "speaker": "梵米尔",
                    "text": "我的这幅画，肯定会让那个诗人心服口服…"
                }
            ]
        },
        {
            "id": "4133508",
            "objective": "向梵米尔回报",
            "dialogues": []
        },
