    "talks": [
        {
            "id": "1502215",
            "objective": "前往回声之子搜集情报",
            "dialogues": []
        },
        {
            "id": "1502201",
            "objective": "前往回声之子搜集情报",
            "dialogues": [
                {
                    "id": "150220101",
                    "speaker": "派蒙",
                    "text": "按阿尔帕之前说的…特帕尔就是从回声之子来的吧？要怎么找到他呢？挨个找人问吗？"
                },
                {
                    "id": "150220102",
                    "speaker": "恰斯卡",
                    "text": "直接找回声之子里的熟人帮忙会快些。在这个时间这个地点，最容易找到的人选是…"
                },
                {
                    "id": "150220103",
                    "speaker": "恰斯卡",
                    "text": "——希诺宁，该起床了。"
                },
                {
                    "id": "150220104",
                    "speaker": "希诺宁",
                    "text": "哈…是你们啊…唔…你们等等…我先从树上下去。"
                },
                {
                    "id": "150220105",
                    "speaker": "希诺宁",
                    "text": "啊…呜…"
                },
                {
                    "id": "150220106",
                    "speaker": "Player",
                    "text": "你俩都很喜欢待在树上呢…"
                },
                {
                    "id": "150220107",
                    "speaker": "恰斯卡",
                    "text": "我上树是为了飞得更久看得更远，一般不会在树上休息。"
                },
                {
                    "id": "150220108",
                    "speaker": "希诺宁",
                    "text": "不是每个人都跟你一样，到处折腾一整天都不嫌累的…所以，这次是为什么事，来打扰我宝贵的休息时间？"
                },
                {
                    "id": "150220109",
                    "speaker": "恰斯卡",
                    "text": "抱歉了，希诺宁，但这件事很紧急——你认识一位名叫特帕尔的工匠吗？"
                },
                {
                    "id": "150220110",
                    "speaker": "希诺宁",
                    "text": "特帕尔？好像有点印象…应该是普玛家的孩子吧？"
                },
                {
                    "id": "150220111",
                    "speaker": "Player",
                    "text": "那他现在就在回声之子吗？"
                },
                {
                    "id": "150220112",
                    "speaker": "希诺宁",
                    "text": "不，起码好几年前就不在了…说起来，你们又为什么要找他？"
                },
                {
                    "id": "150220113",
                    "speaker": "Player",
                    "text": "说来话长…"
                },
                {
                    "id": "150220114",
                    "speaker": "Black Screen",
                    "text": "你们尽量简明扼要地说明了事情的经过…"
                },
                {
                    "id": "150220115",
                    "speaker": "希诺宁",
                    "text": "「燃素翼」？特帕尔这小子，居然真能鼓捣出这么不得了的东西…看来今天的休息时间是要没了。"
                },
                {
                    "id": "150220116",
                    "speaker": "派蒙",
                    "text": "「真能」？难道他以前就研究过类似的东西？"
                },
                {
                    "id": "150220117",
                    "speaker": "希诺宁",
                    "text": "是，差不多就是从花羽会回来之后，他开始研究用人造物飞向天空的方法…"
                },
                {
                    "id": "150220118",
                    "speaker": "恰斯卡",
                    "text": "是在成为「失翼者」之后…人造物…就跟你帮我造的那把枪一样吗？"
                },
                {
                    "id": "150220119",
                    "speaker": "希诺宁",
                    "text": "你的那把「枪」可比最高傲的绒翼龙还要难驯服——而他想要的，是让没有天赋的普通人也能自由飞行。"
                },
                {
                    "id": "150220120",
                    "speaker": "希诺宁",
                    "text": "不过他那时候总是失败，炸过好几回工坊，连自己的小命都差点丢了。至于后面的事，我没太关注过。"
                },
                {
                    "id": "150220121",
                    "speaker": "希诺宁",
                    "text": "特帕尔的父母早年曾在外游历，后来有了特帕尔才回到部族，但也选在了偏僻处定居，不怎么与人交流。"
                },
                {
                    "id": "150220122",
                    "speaker": "希诺宁",
                    "text": "部族里的人跟他们都不算很熟…要了解特帕尔的详细情况，还是去找他的家里人比较好。"
                },
                {
                    "id": "150220123",
                    "speaker": "希诺宁",
                    "text": "我现在去把普玛约出来，你们就先在我的工坊前面等一会吧。"
                }
            ]
        },
        {
            "id": "1502202",
            "objective": "前往希诺宁的工坊等待",
            "dialogues": [
                {
                    "id": "150220201",
                    "speaker": "Black Screen",
                    "text": "在希诺宁的工坊前稍等了一会…"
                },
                {
                    "id": "150220202",
                    "speaker": "希诺宁",
                    "text": "久等了，这位就是特帕尔的母亲，普玛。"
                },
                {
                    "id": "150220203",
                    "speaker": "派蒙",
                    "text": "您好，我们是…"
                },
                {
                    "id": "150220204",
                    "speaker": "普玛",
                    "text": "寒暄的话就免了吧，我不想多谈那个人的事。"
                },
                {
                    "id": "150220205",
                    "speaker": "派蒙",
                    "text": "欸…？"
                },
                {
                    "id": "150220206",
                    "speaker": "普玛",
                    "text": "他早就已经跟我们没关系了…我可没有那样的孩子！"
                },
                {
                    "id": "150220207",
                    "speaker": "普玛",
                    "text": "他心里就只有飞上天去的白日梦…不管我们怎么劝都执迷不悟。"
                },
                {
                    "id": "150220208",
                    "speaker": "普玛",
                    "text": "哼…最后一走了之的时候，还说什么要在天上造工坊，省得被地上的人指指点点…"
                },
                {
                    "id": "150220209",
                    "speaker": "普玛",
                    "text": "这是他留下没带走的手记，你们有什么问题，就自己翻吧。我不想再多说了。"
                },
                {
                    "id": "150220210",
                    "speaker": "普玛",
                    "text": "我从来就没有过这个儿子…反正他也从没认过我这个妈。"
                },
                {
                    "id": "150220211",
                    "speaker": "恰斯卡",
                    "text": "……"
                },
                {
                    "id": "150220212",
                    "speaker": "派蒙",
                    "text": "没…没想到他们的关系会这么差啊…"
                },
                {
                    "id": "150220213",
                    "speaker": "希诺宁",
                    "text": "她的丈夫…特帕尔的父亲不久前刚刚去世。但就算是在父亲的葬礼上，特帕尔也没有回来露面。"
                },
                {
                    "id": "150220214",
                    "speaker": "希诺宁",
                    "text": "或许就是因为这样，普玛才会对特帕尔彻底死心吧。"
                },
                {
                    "id": "150220215",
                    "speaker": "希诺宁",
                    "text": "我先去安抚她了，有事回头再聊。"
                },
                {
                    "id": "150220216",
                    "speaker": "恰斯卡",
                    "text": "麻烦你们了。"
                },
                {
                    "id": "150220217",
                    "speaker": "派蒙",
                    "text": "那现在的线索…就只剩下这本手记了？上面都写了什么？"
                },
                {
                    "id": "150220218",
                    "speaker": "恰斯卡",
                    "text": "嗯…「燃素翼」的早期构思…还有…「空中工坊」的设想。"
                },
                {
                    "id": "150220219",
                    "speaker": "恰斯卡",
                    "text": "「烬城」奥奇卡纳塔…看来「燃素翼」的技术原型，就是从那来的了。"
                },
                {
                    "id": "150220220",
                    "speaker": "派蒙",
                    "text": "他居然真想造出一个飞在天上的工坊？光凭他一个人…真的做得到吗？",
                    "choices": [
                        {
                            "id": "150220221",
                            "text": "话说图纸上的气球…",
                            "response": [
                                {
                                    "id": "150220223",
                                    "speaker": "派蒙",
                                    "text": "——啊！是试炼场地上面的那个！飞得特别高的气球！"
                                },
                                {
                                    "id": "150220224",
                                    "speaker": "恰斯卡",
                                    "text": "那个气球出现有一段时间了，谁都不知道是怎么飞上去的…但如果它不是被谁放「上去」…"
                                },
                                {
                                    "id": "150220225",
                                    "speaker": "恰斯卡",
                                    "text": "而是因为什么故障，从更高的云层之上…「降落」到现在的高度呢？"
                                },
                                {
                                    "id": "150220226",
                                    "speaker": "Player",
                                    "text": "难道说它是…"
                                },
                                {
                                    "id": "150220227",
                                    "speaker": "派蒙",
                                    "text": "——空中工坊的一部分？"
                                },
                                {
                                    "id": "150220228",
                                    "speaker": "恰斯卡",
                                    "text": "很有可能。难怪连伊西多尔都不知道特帕尔的据点在哪里…原来是藏在了云层之上。"
                                },
                                {
                                    "id": "150220229",
                                    "speaker": "派蒙",
                                    "text": "居然还真是藏在天上…那我们要怎么上去呢？恰斯卡你…能飞那么高吗？"
                                },
                                {
                                    "id": "150220230",
                                    "speaker": "恰斯卡",
                                    "text": "#很有难度，要是再带{NICKNAME}上去，就更不可能了。"
                                },
                                {
                                    "id": "150220231",
                                    "speaker": "恰斯卡",
                                    "text": "就算用了「燃素翼」应该也飞不了那么高…除非是用上手记里说的「遗物」。"
                                },
                                {
                                    "id": "150220232",
                                    "speaker": "派蒙",
                                    "text": "「遗物」应该还在特帕尔手里…估计是指望不上了吧。"
                                },
                                {
                                    "id": "150220233",
                                    "speaker": "Player",
                                    "text": "派蒙能飞那么高吗？"
                                },
                                {
                                    "id": "150220234",
                                    "speaker": "派蒙",
                                    "text": "飞不了！怎么想都飞不了吧！再说了你就忍心让我一个人上去打特帕尔吗！"
                                },
                                {
                                    "id": "150220235",
                                    "speaker": "恰斯卡",
                                    "text": "放心吧，我们没想出办法，不代表别人也想不出。花羽会里的「飞行高手」可不只有我。"
                                },
                                {
                                    "id": "150220236",
                                    "speaker": "派蒙",
                                    "text": "欸…对哦！还能去找阿尔帕长老呢！"
                                },
                                {
                                    "id": "150220237",
                                    "speaker": "恰斯卡",
                                    "text": "穆托塔当年也是飞行队的一把好手，回花羽会去咨询一下他们的建议吧。"
                                }
                            ]
                        },
                        {
                            "id": "150220222",
                            "text": "好像在哪里见过？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502203",
            "objective": "返回花羽会商讨方案",
            "dialogues": [
                {
                    "id": "150220301",
                    "speaker": "穆托塔",
                    "text": "恰斯卡，你们可算回来了，部族里的氛围越来越严峻了，调查有什么进展吗？"
                },
                {
                    "id": "150220302",
                    "speaker": "阿尔帕",
                    "text": "还有人怀疑我们控制住商队的人，是不是偏袒飞行队，想要打压「燃素翼」。",
                    "choices": [
                        {
                            "id": "150220303",
                            "text": "控制住了商队矛盾却还在扩大…",
                            "response": [
                                {
                                    "id": "150220305",
                                    "speaker": "恰斯卡",
                                    "text": "我们已经找到了一些线索。但要找到确凿的证据，还有一道难关…"
                                },
                                {
                                    "id": "150220306",
                                    "speaker": "Black Screen",
                                    "text": "恰斯卡说明了特帕尔的情况与空中工坊的猜想…"
                                },
                                {
                                    "id": "150220307",
                                    "speaker": "穆托塔",
                                    "text": "来自烬城的「遗物」？过去这么多年，奥奇坎的遗毒居然还在激起矛盾…"
                                },
                                {
                                    "id": "150220308",
                                    "speaker": "阿尔帕",
                                    "text": "空中工坊…试炼场地上空的热气球…这就是你们接下来的目的地吗？"
                                },
                                {
                                    "id": "150220309",
                                    "speaker": "Player",
                                    "text": "有办法上去吗？"
                                },
                                {
                                    "id": "150220310",
                                    "speaker": "阿尔帕",
                                    "text": "不管是靠绒翼龙还是用「燃素翼」都飞不了那么高…特帕尔真的会在那儿吗？"
                                },
                                {
                                    "id": "150220311",
                                    "speaker": "穆托塔",
                                    "text": "唔…方法…倒也不是没有。"
                                },
                                {
                                    "id": "150220312",
                                    "speaker": "派蒙",
                                    "text": "——还真有啊！"
                                },
                                {
                                    "id": "150220313",
                                    "speaker": "穆托塔",
                                    "text": "你们还记得试炼场地内的那些喷口吗？之前的地脉异常跟阻塞，导致了气态燃素匮乏。"
                                },
                                {
                                    "id": "150220314",
                                    "speaker": "穆托塔",
                                    "text": "但如果在气态燃素充盈的现在，反过来重新堵住它们的话…"
                                },
                                {
                                    "id": "150220315",
                                    "speaker": "恰斯卡",
                                    "text": "你的意思…是只留下最高处的喷口，把所有压力都集中到那里？"
                                },
                                {
                                    "id": "150220316",
                                    "speaker": "穆托塔",
                                    "text": "这么一来，聚集的气态燃素就会在最高处形成极强的风压…"
                                },
                                {
                                    "id": "150220317",
                                    "speaker": "派蒙",
                                    "text": "——然后我们就能乘着风飞上去了？"
                                },
                                {
                                    "id": "150220318",
                                    "speaker": "穆托塔",
                                    "text": "嗯，虽然会有些冒险，但以恰斯卡的技术，应该不成问题？"
                                },
                                {
                                    "id": "150220319",
                                    "speaker": "阿尔帕",
                                    "text": "真是有够冒险的…但确实有可行性。"
                                },
                                {
                                    "id": "150220320",
                                    "speaker": "穆托塔",
                                    "text": "封堵喷口的技术细节，可以去试炼场地找因卡纳克问问。"
                                },
                                {
                                    "id": "150220321",
                                    "speaker": "穆托塔",
                                    "text": "恰斯卡…能不能抓住飞在天上的证据，就看你们了。"
                                }
                            ]
                        },
                        {
                            "id": "150220304",
                            "text": "难道不只有商队的人在作乱…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502204",
            "objective": "前往试炼场地与因卡纳克对话",
            "dialogues": [
                {
                    "id": "150221101",
                    "speaker": "Black Screen",
                    "text": "你们匆匆赶到试炼场地，向因卡纳克说明情况…"
                },
                {
                    "id": "150221102",
                    "speaker": "因卡纳克",
                    "text": "原来如此…可真是大胆的构思…"
                },
                {
                    "id": "150221103",
                    "speaker": "恰斯卡",
                    "text": "因卡纳克，时间紧迫，有什么能尽快封堵喷口的方法吗？"
                },
                {
                    "id": "150221104",
                    "speaker": "因卡纳克",
                    "text": "从技术上来说，我建议还是好好测算和规划之后再出具体方案…不过我想你们肯定不乐意听这个。"
                },
                {
                    "id": "150221105",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "150221106",
                    "speaker": "因卡纳克",
                    "text": "…那就只剩下最简单粗暴的方案了——看到那些固态燃素了吗？"
                },
                {
                    "id": "150221107",
                    "speaker": "因卡纳克",
                    "text": "之前调查的时候，我们发现它们内部形成了某种稳定结构，不会轻易损坏…"
                },
                {
                    "id": "150221108",
                    "speaker": "因卡纳克",
                    "text": "但也形成了一些结构性弱点，虽然只要不同时受到打击，就不会有事…"
                },
                {
                    "id": "150221109",
                    "speaker": "派蒙",
                    "text": "那要是一齐攻击的话，会发生什么吗？"
                },
                {
                    "id": "150221110",
                    "speaker": "因卡纳克",
                    "text": "——会直接崩落哦。"
                },
                {
                    "id": "150221111",
                    "speaker": "恰斯卡",
                    "text": "…好吧，我大概猜到你的计划了。"
                },
                {
                    "id": "150221112",
                    "speaker": "因卡纳克",
                    "text": "不愧是你！只要对好角度、一齐攻击所有弱点，让它们往喷口的方向砸下来…就能封堵喷口啦。"
                },
                {
                    "id": "150221113",
                    "speaker": "恰斯卡",
                    "text": "确实是最简单粗暴的方案，挺适合我的。"
                }
            ]
        },
        {
            "id": "1502213",
            "objective": "封堵喷口",
            "dialogues": [
                {
                    "id": "150221301",
                    "speaker": "派蒙",
                    "text": "唔…呃…头一次飞得这么快…感觉要吐出来了…"
                },
                {
                    "id": "150221302",
                    "speaker": "Player",
                    "text": "顺利上来了就好…"
                },
                {
                    "id": "150221303",
                    "speaker": "恰斯卡",
                    "text": "嗯…果然，这个热气球看上去跟部族里的没区别，实际上已经被全面改造了。"
                },
                {
                    "id": "150221304",
                    "speaker": "恰斯卡",
                    "text": "是因为改造部分的故障，才从更高处下降到可见高度。"
                },
                {
                    "id": "150221305",
                    "speaker": "Player",
                    "text": "你能看出哪里有故障吗？"
                },
                {
                    "id": "150221306",
                    "speaker": "恰斯卡",
                    "text": "有特帕尔的手记在，问题不大。平时我的枪械出了故障，也是自己保养的。"
                },
                {
                    "id": "150221307",
                    "speaker": "恰斯卡",
                    "text": "嗯…感觉上差不多了——再往这里踢上一脚就行。"
                },
                {
                    "id": "150221308",
                    "speaker": "派蒙",
                    "text": "你平时都是这么保养你的枪的吗…"
                },
                {
                    "id": "150221309",
                    "speaker": "派蒙",
                    "text": "欸欸欸——还真动起来了！？"
                }
            ]
        },
        {
            "id": "1502207",
            "objective": "封堵喷口",
            "dialogues": [
                {
                    "id": "150220701",
                    "speaker": "希诺宁",
                    "text": "嗯？你们还有什么要调查的吗？"
                },
                {
                    "id": "150220702",
                    "speaker": "Player",
                    "text": "暂时没事了，普玛那边…"
                },
                {
                    "id": "150220703",
                    "speaker": "希诺宁",
                    "text": "还好，她的情绪已经安定下来了。我回头会再去看望一下。"
                },
                {
                    "id": "150220704",
                    "speaker": "希诺宁",
                    "text": "把那本手记交给你们后，她看起来就像是放下了什么…大概也不是坏事吧。"
                }
            ]
        },
        {
            "id": "1502208",
            "objective": "封堵喷口",
            "dialogues": [
                {
                    "id": "150220801",
                    "speaker": "瓦斯卡尔",
                    "text": "——要「燃素翼」！不要绒翼龙！"
                },
                {
                    "id": "150220802",
                    "speaker": "穆基",
                    "text": "开什么玩笑！绒翼龙是我们最好的伙伴！"
                }
            ]
        },
        {
            "id": "1502209",
            "objective": "封堵喷口",
            "dialogues": []
        },
        {
            "id": "1502210",
            "objective": "(test)堵住喷口$HIDDEN",
            "dialogues": [
                {
                    "id": "150221001",
                    "speaker": "穆托塔",
                    "text": "我们会继续处理部族里的矛盾，为你们争取时间。"
                },
                {
                    "id": "150221002",
                    "speaker": "阿尔帕",
                    "text": "首领，以防万一…我们先来安排一下防务吧。"
                }
            ]
        },
        {
            "id": "1502205",
            "objective": "前往山顶",
            "dialogues": [
                {
                    "id": "150220501",
                    "speaker": "派蒙",
                    "text": "#居然还真的成功了…话又说回来，我跟{NICKNAME}该怎么上去呢？"
                },
                {
                    "id": "150220502",
                    "speaker": "恰斯卡",
                    "text": "可以让姐姐借助风力带你们上去——她其实一直跟着我们呢。"
                },
                {
                    "id": "150220503",
                    "speaker": "柯娅",
                    "text": "……"
                },
                {
                    "id": "150220504",
                    "speaker": "派蒙",
                    "text": "欸…完全没发现…"
                },
                {
                    "id": "150220505",
                    "speaker": "Player",
                    "text": "为什么不直接飞过来…"
                },
                {
                    "id": "150220506",
                    "speaker": "恰斯卡",
                    "text": "估计是不想接近人类的部族…或者不想接近我吧。但现在…需要她的力量了。"
                },
                {
                    "id": "150220507",
                    "speaker": "柯娅",
                    "text": "啁——"
                },
                {
                    "id": "150220508",
                    "speaker": "派蒙",
                    "text": "哇！没、没召唤就直接过来了…"
                },
                {
                    "id": "150220509",
                    "speaker": "柯娅",
                    "text": "…啁。"
                },
                {
                    "id": "150220510",
                    "speaker": "恰斯卡",
                    "text": "是…你的孩子多半就在上面。"
                },
                {
                    "id": "150220511",
                    "speaker": "恰斯卡",
                    "text": "做好准备，去会一会那个特帕尔吧。"
                }
            ]
        },
        {
            "id": "1502214",
            "objective": "前往山顶",
            "dialogues": []
        },
        {
            "id": "1502211",
            "objective": "飞上热气球",
