            "dialogues": [
                {
                    "id": "150220401",
                    "speaker": "科优尔",
                    "text": "再怎么样…他们也不能这么说绒翼龙吧？"
                },
                {
                    "id": "150220402",
                    "speaker": "朱南",
                    "text": "但要是没有「燃素翼」…我…"
                }
            ]
        },
        {
            "id": "1502206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150220601",
                    "speaker": "因卡纳克",
                    "text": "只要对好角度、一齐攻击所有弱点，让它们往喷口的方向砸下来…就能封堵喷口啦。"
                }
            ]
        },
        {
            "id": "1502297",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150229701",
                    "speaker": "瓦斯卡尔",
                    "text": "——要「燃素翼」…"
                },
                {
                    "id": "150229702",
                    "speaker": "穆基",
                    "text": "开什么玩笑…"
                },
                {
                    "id": "150229703",
                    "speaker": "科优尔",
                    "text": "再怎么样…"
                },
                {
                    "id": "150229704",
                    "speaker": "朱南",
                    "text": "但要是没有…"
                }
            ]
        },
        {
            "id": "1502298",
