            "dialogues": [
                {
                    "id": "150229801",
                    "speaker": "Black Screen",
                    "text": "高空中的气流异常紊乱，恰斯卡带你安全地回到了地面。"
                }
            ]
        },
        {
            "id": "1502299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150229901",
                    "speaker": "派蒙",
                    "text": "快看！喷口上面刚好有块固态燃素！"
                },
                {
                    "id": "150229902",
                    "speaker": "恰斯卡",
                    "text": "嗯…目标被挡住了，先清理障碍吧。"
                }
