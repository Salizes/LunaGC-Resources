        },
        {
            "id": "800001",
            "objective": "接近协会公告板",
            "dialogues": [
                {
                    "id": "80000101",
                    "speaker": "岚姐",
                    "text": "是的，是的。我知道他们什么都敢碰。"
                },
                {
                    "id": "80000102",
                    "speaker": "岚姐",
                    "text": "七神、魔神、恶龙…就连带上这些背景的古物，他们也没有不敢下手的。"
                },
                {
                    "id": "80000103",
                    "speaker": "岚姐",
                    "text": "但这一次，是谁给他们的胆子，去动深渊教团的东西…"
                },
                {
                    "id": "80000104",
                    "speaker": "岚姐",
                    "text": "啊，旅行者，是你们。"
                },
                {
                    "id": "80000105",
                    "speaker": "派蒙",
                    "text": "咦？甘雨怎么在岚姐这里？是要发布什么委托吗？"
                },
                {
                    "id": "80000106",
                    "speaker": "甘雨",
                    "text": "#你好，{NICKNAME}。"
                },
                {
                    "id": "80000107",
                    "speaker": "甘雨",
                    "text": "我们刚才在聊盗宝团的事。"
                },
                {
                    "id": "80000108",
                    "speaker": "岚姐",
                    "text": "嗯，我们刚才谈到，即使是什么都敢碰的盗宝团，原本也都知道，最好别去接触「深渊」——因为那实在太邪门了。"
                },
                {
                    "id": "80000109",
                    "speaker": "甘雨",
                    "text": "但我最近从总务司接到情报，蒙德璃月一带的盗宝团南北两大巨头，正准备联合起来做一件大事。"
                },
                {
                    "id": "80000110",
                    "speaker": "派蒙",
                    "text": "盗宝团…南北两大巨头？"
                },
                {
                    "id": "80000111",
                    "speaker": "岚姐",
                    "text": "嗯，江湖人称「南长姊」，「北怪鸟」。"
                },
                {
                    "id": "80000112",
                    "speaker": "派蒙",
                    "text": "啊，「怪鸟」！我有印象，他在蒙德和安柏交过手…但「南长姊」是谁呢？",
                    "choices": [
                        {
                            "id": "80000113",
                            "text": "长姊的意思，是最大的姐姐吗？",
                            "response": [
                                {
                                    "id": "80000116",
                                    "speaker": "岚姐",
                                    "text": "没错，璃月一带的盗宝团首领，据我所知，那伙人都称她为「大姐头」。"
                                },
                                {
                                    "id": "80000117",
                                    "speaker": "岚姐",
                                    "text": "也有人说她的手艺得到过盗宝之神的恩赐，所以是「神之长姊」…但这大概只是以讹传讹。"
                                },
                                {
                                    "id": "80000118",
                                    "speaker": "甘雨",
                                    "text": "总而言之，盗宝团发现一座无人发掘过的遗迹，这座遗迹暗中被深渊教团严密守护着。"
                                },
                                {
                                    "id": "80000119",
                                    "speaker": "甘雨",
                                    "text": "虽然这是非常危险的征兆，但以盗宝团的思维，只会觉得有宝物…"
                                },
                                {
                                    "id": "80000120",
                                    "speaker": "甘雨",
                                    "text": "他们制定了计划，派一批炮灰引开深渊教团的兵力，然后只靠一位最精英的专家深入遗迹，取宝逃离。"
                                },
                                {
                                    "id": "80000121",
                                    "speaker": "岚姐",
                                    "text": "为此，据说「大姐头」和「怪鸟」从枫丹请来了一位「大盗宝家」…"
                                },
                                {
                                    "id": "80000122",
                                    "speaker": "派蒙",
                                    "text": "「大盗宝家」？是个听起来很有气势的称号呢。"
                                },
                                {
                                    "id": "80000123",
                                    "speaker": "岚姐",
                                    "text": "是的，那是一位非常传奇的人物。"
                                },
                                {
                                    "id": "80000124",
                                    "speaker": "岚姐",
                                    "text": "所谓「大盗宝家」，在盗宝团的地位，等同于我们冒险家心目中的「大冒险家」。",
                                    "choices": [
                                        {
                                            "id": "80000125",
                                            "text": "比如大冒险家艾莉丝女士？",
                                            "response": [
                                                {
                                                    "id": "80000126",
                                                    "speaker": "岚姐",
                                                    "text": "你们也知道那位《提瓦特游览指南》的作者吗？没错，「大盗宝家」的地位和她一样，就是如此崇高。"
                                                },
                                                {
                                                    "id": "80000129",
                                                    "speaker": "岚姐",
                                                    "text": "所以即使是附近一带的盗宝团南北两大巨头，也要千方百计把他请来，拜托他亲自坐镇整个盗宝计划。"
                                                },
                                                {
                                                    "id": "80000130",
                                                    "speaker": "甘雨",
                                                    "text": "最近璃月遭逢巨变，总务司和千岩军都过于忙碌，没空应对这种道听途说的盗宝团行动。"
                                                },
                                                {
                                                    "id": "80000131",
                                                    "speaker": "甘雨",
                                                    "text": "但，以我的直觉，与「深渊」相关的事物，都潜藏着未知的威胁…"
                                                },
                                                {
                                                    "id": "80000132",
                                                    "speaker": "甘雨",
                                                    "text": "所以，我就想来冒险家协会挂个委托。",
                                                    "choices": [
                                                        {
                                                            "id": "80000133",
                                                            "text": "既然刚好路过…",
                                                            "response": [
                                                                {
                                                                    "id": "80000135",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，那这个委托我们就接下啦！"
                                                                },
                                                                {
                                                                    "id": "80000136",
                                                                    "speaker": "甘雨",
                                                                    "text": "啊，非常感谢…"
                                                                },
                                                                {
                                                                    "id": "80000137",
                                                                    "speaker": "岚姐",
                                                                    "text": "不错，真是可靠的协会会员。那么，一路顺风，委托的细节就由协会来处理吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80000134",
                                                            "text": "我也明白「深渊」的危害。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80000127",
                                            "text": "比如大冒险家斯坦利先生？",
                                            "response": [
                                                {
                                                    "id": "80000128",
                                                    "speaker": "岚姐",
                                                    "text": "哦？你们难道在蒙德见过那位前辈高人吗？没错，「大盗宝家」的地位和他一样，就是如此崇高。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80000114",
                            "text": "是盗宝团口中的「大姐头」吗？",
                            "response": [
                                {
                                    "id": "80000115",
                                    "speaker": "岚姐",
                                    "text": "你知道得不少嘛，看来是和盗宝团打过很多交道。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "800002",
            "objective": "前往遗迹",
            "dialogues": [
                {
                    "id": "80000201",
                    "speaker": "派蒙",
                    "text": "这…好像是个人！"
                },
                {
                    "id": "80000202",
                    "speaker": "派蒙",
                    "text": "难道是…「大盗宝家」？"
                },
                {
                    "id": "80000203",
                    "speaker": "派蒙",
                    "text": "这个姿势…他在对什么东西「祈祷」吗？"
                },
                {
                    "id": "80000204",
                    "speaker": "派蒙",
                    "text": "？！"
                },
                {
                    "id": "80000205",
                    "speaker": "派蒙",
                    "text": "那…那是…",
                    "choices": [
                        {
                            "id": "80000206",
                            "text": "是…七天神像？",
                            "response": [
                                {
                                    "id": "80000208",
                                    "speaker": "派蒙",
                                    "text": "为，为什么七天神像…会被这样倒挂…"
                                },
                                {
                                    "id": "80000209",
                                    "speaker": "派蒙",
                                    "text": "而且，神像手里…我记得…本来应该捧着一颗宝珠吧？"
                                },
                                {
                                    "id": "80000210",
                                    "speaker": "派蒙",
                                    "text": "现在…神像手里捧着的…是什么…？"
                                },
                                {
                                    "id": "80000211",
                                    "speaker": "派蒙",
                                    "text": "呜…好压抑…感觉非常不妙…"
                                },
                                {
                                    "id": "80000212",
                                    "speaker": "派蒙",
                                    "text": "那个「大盗宝家」也是一动不动的样子，难，难道说，已经…"
                                },
                                {
                                    "id": "80000213",
                                    "speaker": "派蒙",
                                    "text": "喂，你还好吗？"
                                },
                                {
                                    "id": "80000214",
                                    "speaker": "观察「大盗宝家」",
                                    "text": "（没有一丝反应，也听不到呼吸声。）"
                                },
                                {
                                    "id": "80000215",
                                    "speaker": "派蒙",
                                    "text": "…他，他死了。"
                                },
                                {
                                    "id": "80000216",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我…感觉很不好。",
                                    "choices": [
                                        {
                                            "id": "80000217",
                                            "text": "非常凶恶的环境…",
                                            "response": [
                                                {
                                                    "id": "80000219",
                                                    "speaker": "派蒙",
                                                    "text": "我们还是赶快离开这里，把情况告诉甘雨和岚姐吧…"
                                                },
                                                {
                                                    "id": "80000220",
                                                    "speaker": "派蒙",
                                                    "text": "呀啊——又发生什么事了？！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80000218",
                                            "text": "未知的死因…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80000207",
                            "text": "从未见过的诡异景象…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800003",
            "objective": "追踪盗宝团",
            "dialogues": [
                {
                    "id": "80000301",
                    "speaker": "深渊使徒",
                    "text": "如此力量…似曾相识…"
                },
                {
                    "id": "80000302",
                    "speaker": "深渊使徒",
                    "text": "唔…！"
                },
                {
                    "id": "80000303",
                    "speaker": "深渊使徒",
                    "text": "我明白了，原来你就是…那位！"
                },
                {
                    "id": "80000304",
                    "speaker": "深渊使徒",
                    "text": "这样说来，我便不应久留了…"
                },
                {
                    "id": "80000305",
                    "speaker": "派蒙",
                    "text": "#呼…真是艰难的战斗。你还好吧，{NICKNAME}？"
                },
                {
                    "id": "80000306",
                    "speaker": "派蒙",
                    "text": "好强的敌人，原来深渊教团里面，还有这么厉害的魔物。"
                },
                {
                    "id": "80000307",
                    "speaker": "Player",
                    "text": "（它好像…认识我。）"
                },
                {
                    "id": "80000308",
                    "speaker": "派蒙",
                    "text": "嗯？怎么了，你在想什么？"
                },
                {
                    "id": "80000309",
                    "speaker": "Player",
                    "text": "没什么，我们赶快离开吧。"
                },
                {
                    "id": "80000310",
                    "speaker": "派蒙",
                    "text": "啊，对，我们已经接近遗迹的出口了，快出去吧。这么恐怖的地方，多待一秒都可能有新的危险！"
                }
            ]
        },
        {
            "id": "800004",
            "objective": "察看遗迹深处的情况",
            "dialogues": []
        },
        {
            "id": "800005",
            "objective": "逃离遗迹",
            "dialogues": []
        },
        {
            "id": "800009",
            "objective": "与深渊使徒交涉",
            "dialogues": [
                {
                    "id": "80000401",
                    "speaker": "？？？",
                    "text": "「深渊」的奥秘，不可窥探。"
                },
                {
                    "id": "80000402",
                    "speaker": "？？？",
                    "text": "汝等来此，汝等直视。那么，就应当承担与之对等的代价。"
                },
                {
                    "id": "80000403",
                    "speaker": "深渊使徒",
                    "text": "——谴罚，由「使徒」降下。"
                },
                {
                    "id": "80000404",
                    "speaker": "派蒙",
                    "text": "「深渊」…「使徒」？",
                    "choices": [
                        {
                            "id": "80000405",
                            "text": "是戴因提到过的…",
                            "response": [
                                {
                                    "id": "80000407",
                                    "speaker": "深渊使徒",
                                    "text": "戴因…戴因斯雷布？原来如此，本以为你们只是误闯的老鼠，却也与那纠缠不休之人有关…"
                                },
                                {
                                    "id": "80000408",
                                    "speaker": "深渊使徒",
                                    "text": "他派你们来送死？他对「深渊」的反抗早已陷入僵局，绝不会因为微不足道的波澜，产生新的变数…"
                                },
                                {
                                    "id": "80000409",
                                    "speaker": "深渊使徒",
                                    "text": "「深渊」…无可阻挡！"
                                }
                            ]
                        },
                        {
                            "id": "80000406",
                            "text": "是我们和戴因追查的邪物。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800006",
            "objective": "打倒深渊使徒",
            "dialogues": []
        },
        {
            "id": "800008",
            "objective": "与深渊使徒对话",
            "dialogues": []
        },
        {
            "id": "800007",
            "objective": "离开遗迹",
            "dialogues": []
        },
        {
            "id": "800000",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80000001",
                    "speaker": "派蒙",
                    "text": "这是什么力量…从来没有见过…"
                },
                {
                    "id": "80000002",
                    "speaker": "派蒙",
                    "text": "当心了！千万不要大意！"
                }
            ]
        }
    ]
