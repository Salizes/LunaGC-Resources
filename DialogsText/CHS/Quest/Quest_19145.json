            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191451601",
                    "speaker": "稻城萤美",
                    "text": "希望雷神大人保佑这位婆婆和她的孙女…"
                },
                {
                    "id": "191451602",
                    "speaker": "Player",
                    "text": "关于婆婆的眼睛…"
                },
                {
                    "id": "191451603",
                    "speaker": "稻城萤美",
                    "text": "你们也注意到了吗？是啊，婆婆看东西不太清楚，每次上山来我们都有些担心。"
                },
                {
                    "id": "191451604",
                    "speaker": "稻城萤美",
                    "text": "不过她总是不愿意多麻烦我们，说自己走了这么多年，一个人也能上下山…"
                },
                {
                    "id": "191451605",
                    "speaker": "稻城萤美",
                    "text": "还好山道上也有神社的巫女，多少也能照看着些。"
                },
                {
                    "id": "191451606",
                    "speaker": "稻城萤美",
                    "text": "雷神保佑，祝婆婆和她的孙女都能一路平安…"
                }
            ]
        },
