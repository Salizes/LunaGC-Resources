            "dialogues": [
                {
                    "id": "50071201",
                    "speaker": "玛拉妮",
                    "text": "之前的庆功宴，我都会在那边又唱又跳，但今天知道了太多，还没有消化掉…"
                },
                {
                    "id": "50071202",
                    "speaker": "派蒙",
                    "text": "这种兴致不高的感觉，很不像你啊。",
                    "choices": [
                        {
                            "id": "50071203",
                            "text": "结局还没注定，不是吗？",
                            "response": [
                                {
                                    "id": "50071205",
                                    "speaker": "玛拉妮",
                                    "text": "这也是你的冒险经验吗？"
                                },
                                {
                                    "id": "50071206",
                                    "speaker": "派蒙",
                                    "text": "我觉得也是，大家都在为卡齐娜庆祝，这种机会从来都没有过吧。"
                                },
                                {
                                    "id": "50071207",
                                    "speaker": "玛拉妮",
                                    "text": "有道理，呵呵，卡齐娜看上去挺开心的，现在我变成那个有点闷闷不乐的人了。"
                                },
                                {
                                    "id": "50071208",
                                    "speaker": "玛拉妮",
                                    "text": "这可不行，我也得把气氛带起来！"
                                }
                            ]
                        },
                        {
                            "id": "50071204",
                            "text": "该享受的时候就要享受。"
                        }
                    ]
                }
