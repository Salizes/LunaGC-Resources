            "dialogues": [
                {
                    "id": "708019401",
                    "speaker": "Player",
                    "text": "西风骑士团可真严格…"
                },
                {
                    "id": "708019402",
                    "speaker": "斯万",
                    "text": "唔…很遗憾，您没有全答对。"
                },
                {
                    "id": "708019403",
                    "speaker": "斯万",
                    "text": "但是对于您来说，已经很不错了，这些礼物请您收下。"
                }
            ]
        },
        {
            "id": "7080199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708019901",
