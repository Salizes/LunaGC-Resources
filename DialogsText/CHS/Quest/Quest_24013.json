    },
    "talks": [
        {
            "id": "2401301",
            "objective": "与艾尤恩对话",
            "dialogues": [
                {
                    "id": "240130101",
                    "speaker": "艾尤恩",
                    "text": "唉，我真是想不通，为什么会这样…",
                    "choices": [
                        {
                            "id": "240130102",
                            "text": "艾尤恩？",
                            "response": [
                                {
                                    "id": "240130104",
                                    "speaker": "艾尤恩",
                                    "text": "旅行者，真高兴见到你。你是来喝咖啡的吗？让我来请你一杯吧。"
                                },
                                {
                                    "id": "240130105",
                                    "speaker": "派蒙",
                                    "text": "你怎么啦？看起来脸色好难看，是又被谁逼着熬夜了吗？"
                                },
                                {
                                    "id": "240130106",
                                    "speaker": "艾尤恩",
                                    "text": "谢谢关心。这次是我自己的问题。"
                                },
                                {
                                    "id": "240130107",
                                    "speaker": "艾尤恩",
                                    "text": "我最近正在思考…我工作的意义究竟是什么。"
                                },
                                {
                                    "id": "240130108",
                                    "speaker": "艾尤恩",
                                    "text": "我一直认为复律庭是一个公正，高效，人人都愿意互帮互助的强力机构。"
                                },
                                {
                                    "id": "240130109",
                                    "speaker": "艾尤恩",
                                    "text": "在复律庭的管理下，整个枫丹廷都会朝着更好的方向发展。"
                                },
                                {
                                    "id": "240130110",
                                    "speaker": "艾尤恩",
                                    "text": "但现在看来，它就像是一个破破烂烂的机关屋子。齿轮，杠杆，旋臂乱七八糟地耷拉着…只有外壳却一直保持光鲜亮丽。"
                                },
                                {
                                    "id": "240130111",
                                    "speaker": "艾尤恩",
                                    "text": "它之所以能运转起来，只是因为一系列的巧合与教训，而不是精密地思考和设计。"
                                },
                                {
                                    "id": "240130112",
                                    "speaker": "艾尤恩",
                                    "text": "我…我想做些什么，但根本无从下手。我怕只要做错了一件事，就会让这间机关屋子整个垮塌掉。"
                                },
                                {
                                    "id": "240130113",
                                    "speaker": "艾尤恩",
                                    "text": "虽然洛耶茨先生时常和我说，让我放宽心，就算我再怎么犯错，状况也不可能比现在更糟…"
                                },
                                {
                                    "id": "240130114",
                                    "speaker": "派蒙",
                                    "text": "这，这算是安慰吗…"
                                },
                                {
                                    "id": "240130115",
                                    "speaker": "艾尤恩",
                                    "text": "唉，抱歉，我不该和你抱怨这些。我今天之所以出来散心，主要原因也是想暂时逃避这些事…"
                                },
                                {
                                    "id": "240130116",
                                    "speaker": "Player",
                                    "text": "我来给你调杯咖啡吧。"
                                },
                                {
                                    "id": "240130117",
                                    "speaker": "艾尤恩",
                                    "text": "真的？你会调咖啡吗？真是太厉害了，我之前也想学，但总是没时间。"
                                },
                                {
                                    "id": "240130118",
                                    "speaker": "艾尤恩",
                                    "text": "那就拜托你了，我会在这里等着的…希望工作别在咖啡厅里追上我。"
                                }
                            ]
                        },
                        {
                            "id": "240130103",
                            "text": "今天你休息吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401302",
            "objective": "与阿鲁埃对话",
            "dialogues": [
                {
                    "id": "240130201",
                    "speaker": "阿鲁埃",
                    "text": "旅行者，你是来店里帮忙的吗？非常欢迎！"
                },
                {
                    "id": "240130202",
                    "speaker": "派蒙",
                    "text": "不是啦，我们只是想给一个朋友调一杯咖啡，他现在好像…嗯…",
                    "choices": [
                        {
                            "id": "240130203",
                            "text": "他现在有点难过。",
                            "response": [
                                {
                                    "id": "240130205",
                                    "speaker": "阿鲁埃",
                                    "text": "你们说的那个朋友。是坐在那边的艾尤恩吗？"
                                },
                                {
                                    "id": "240130206",
                                    "speaker": "Player",
                                    "text": "你认识他？"
                                },
                                {
                                    "id": "240130207",
                                    "speaker": "阿鲁埃",
                                    "text": "我和洛耶茨是老朋友了。他和我提起过，说他们办公室里来了一位聪明又勤恳的小伙子，就是艾尤恩。"
                                },
                                {
                                    "id": "240130208",
                                    "speaker": "阿鲁埃",
                                    "text": "不用担心他。刚刚去复律庭里工作的年轻人，总是会沮丧一段时间的。"
                                },
                                {
                                    "id": "240130209",
                                    "speaker": "阿鲁埃",
                                    "text": "等他们找到一个只属于自己的位置后，心情就会放松下来了。"
                                },
                                {
                                    "id": "240130210",
                                    "speaker": "派蒙",
                                    "text": "老板，你怎么这么有经验呀？"
                                },
                                {
                                    "id": "240130211",
                                    "speaker": "阿鲁埃",
                                    "text": "因为我也曾经是复律庭里占着坑的一个萝卜。"
                                },
                                {
                                    "id": "240130212",
                                    "speaker": "阿鲁埃",
                                    "text": "但我不满意自己只做个萝卜，就离开了我的坑，然后…来开了这家咖啡厅。",
                                    "choices": [
                                        {
                                            "id": "240130213",
                                            "text": "听起来发生了很多事…",
                                            "response": [
                                                {
                                                    "id": "240130215",
                                                    "speaker": "阿鲁埃",
                                                    "text": "哈哈哈，也许吧。但现在我只不过是个咖啡厅的老板罢了。"
                                                },
                                                {
                                                    "id": "240130216",
                                                    "speaker": "阿鲁埃",
                                                    "text": "好了，你们不是还要给艾尤恩做一杯咖啡吗？我去调试一下仪器，你们准备好了就来找我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240130214",
                                            "text": "总感觉里面有很多故事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240130204",
                            "text": "他现在压力很大。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401305",
            "objective": "与阿鲁埃对话",
            "dialogues": [
                {
                    "id": "240135101",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "240135102",
                    "speaker": "阿鲁埃",
                    "text": "需要用的材料我都帮你准备好了，就放在那边，快点开始调制吧。"
                }
            ]
        },
        {
            "id": "2401303",
            "objective": "为艾尤恩调制咖啡",
            "dialogues": [
                {
                    "id": "240130301",
                    "speaker": "派蒙",
                    "text": "唔…这次要用什么材料来调制咖啡呢？"
                }
            ]
        },
        {
            "id": "2401306",
            "objective": "为艾尤恩调制咖啡",
            "dialogues": [
                {
                    "id": "240133101",
                    "speaker": "派蒙",
                    "text": "听起来不错呢，那就开始调制吧。"
                },
                {
                    "id": "240133102",
                    "speaker": "Black Screen",
                    "text": "开始调制咖啡…"
                },
                {
                    "id": "240133103",
                    "speaker": "派蒙",
                    "text": "唔…闻起来就很香！快把这杯咖啡端给艾尤恩，让他打起精神来吧！"
                }
            ]
        },
        {
            "id": "2401304",
            "objective": "将咖啡带给艾尤恩",
            "dialogues": [
                {
                    "id": "240130401",
                    "speaker": "艾尤恩",
                    "text": "旅行者，你…你还真给我调了杯咖啡吗？这怎么好意思，太麻烦你了…",
                    "choices": [
                        {
                            "id": "240130402",
                            "text": "不用客气。",
                            "response": [
                                {
                                    "id": "240130404",
                                    "speaker": "艾尤恩",
                                    "text": "…这咖啡！比复律庭里供应的那些咖啡好喝多了！不…不如说根本就不是一个层次的咖啡。"
                                },
                                {
                                    "id": "240130405",
                                    "speaker": "艾尤恩",
                                    "text": "要是能天天喝到这种咖啡，我也不会每天下午都昏昏欲睡了。"
                                },
                                {
                                    "id": "240130406",
                                    "speaker": "艾尤恩",
                                    "text": "谢谢你的咖啡，喝完这杯之后，我又得去工作了。",
                                    "choices": [
                                        {
                                            "id": "240130407",
                                            "text": "要加油。",
                                            "response": [
                                                {
                                                    "id": "240130409",
                                                    "speaker": "艾尤恩",
                                                    "text": "那当然了。我必须得快点成长，早日成为洛耶茨先生那样能独当一面的人才行。"
                                                },
                                                {
                                                    "id": "240130410",
                                                    "speaker": "艾尤恩",
                                                    "text": "唉，但在那之前，我还得做多少噩梦呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240130408",
                                            "text": "打起精神来。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240130403",
                            "text": "赶紧喝了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401350",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240135001",
                    "speaker": "阿鲁埃",
                    "text": "怎么样，你准备好给艾尤恩调一杯咖啡了吗？"
                }
            ]
        },
        {
            "id": "2401352",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240135201",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "240135202",
                    "speaker": "阿鲁埃",
                    "text": "你准备好了之后，来找我就行。"
                }
            ]
        },
        {
            "id": "2401380",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240138001",
                    "speaker": "艾尤恩",
                    "text": "机关屋子…唉，我迟早也会成为一枚破破烂烂的齿轮吗…"
                }
            ]
        },
        {
            "id": "2401399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240139901",
                    "speaker": "Black Screen",
                    "text": "加入配料后，完成了旅行者特调。"
                }
            ]
        }
    ]
}