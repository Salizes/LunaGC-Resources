        },
        {
            "id": "7452904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745290401",
                    "speaker": "茜特菈莉",
                    "text": "#哟，{NICKNAME}，你来啦。",
                    "choices": [
                        {
                            "id": "745290402",
                            "text": "茜特菈莉，好久不见。",
                            "response": [
                                {
                                    "id": "745290404",
                                    "speaker": "茜特菈莉",
                                    "text": "瞧你说的，奶奶我偶尔也是会出门散散步的啦。"
                                },
                                {
                                    "id": "745290405",
                                    "speaker": "茜特菈莉",
                                    "text": "而且，昨晚我卜算运势，预测今天如果出门，会遇到好事。"
                                },
                                {
                                    "id": "745290406",
                                    "speaker": "茜特菈莉",
                                    "text": "这不，刚走出家门，好事就送上门来了。",
                                    "choices": [
                                        {
                                            "id": "745290407",
                                            "text": "那就让好事成双吧！",
                                            "response": [
                                                {
                                                    "id": "745290409",
                                                    "speaker": "茜特菈莉",
                                                    "text": "也不是不行啦…不过，我前两天为了看完最新卷的轻小说，熬了个大夜！"
                                                },
                                                {
                                                    "id": "745290410",
                                                    "speaker": "茜特菈莉",
                                                    "text": "快帮我看看，我现在看起来怎么样？黑眼圈应该消下去了吧？",
                                                    "choices": [
                                                        {
                                                            "id": "745290411",
                                                            "text": "和平时一样精神。",
                                                            "response": [
                                                                {
                                                                    "id": "745290413",
                                                                    "speaker": "茜特菈莉",
                                                                    "text": "真的吗？你可不许骗我！"
                                                                },
                                                                {
                                                                    "id": "745290414",
                                                                    "speaker": "茜特菈莉",
                                                                    "text": "先说好，要是拍出来不好看，那画片可就归我了…要留的话，只许留给你最好看的那张。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745290412",
                                                            "text": "简直容光焕发！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745290408",
                                            "text": "请让我为你拍张画片！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745290403",
                            "text": "居然没在家里睡大觉，真难得。"
                        }
                    ]
                }
            ]
        }
    ]
