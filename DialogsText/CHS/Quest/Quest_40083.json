    "talks": [
        {
            "id": "4008301",
            "objective": "等待到第二天上午（8：00-10：00）",
            "dialogues": []
        },
        {
            "id": "4008303",
            "objective": "参加比赛",
            "dialogues": []
        },
        {
            "id": "4008320",
            "objective": "参加比赛$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4008322",
            "objective": "击败对手",
            "dialogues": []
        },
        {
            "id": "4008302",
            "objective": "击败对手",
            "dialogues": [
                {
                    "id": "400831501",
                    "speaker": "左右加",
                    "text": "两位，没想到这么早就要和你们对决了。"
                },
                {
                    "id": "400831502",
                    "speaker": "左右加",
                    "text": "对不起，为了我的小说生涯和八重大人的认可，我要打败你们！"
                },
                {
                    "id": "400831503",
                    "speaker": "Player",
                    "text": "拿出全力来吧！"
                },
                {
                    "id": "400831504",
                    "speaker": "派蒙",
                    "text": "别太自信哦，左右加小姐，我们也不会手下留情的！"
                }
            ]
        },
        {
            "id": "4008304",
            "objective": "击败对手",
            "dialogues": []
        },
        {
            "id": "4008316",
            "objective": "与对手对话",
            "dialogues": [
                {
                    "id": "400831701",
                    "speaker": "左右加",
                    "text": "为什么，完全赢不了啊，呜…"
                },
                {
                    "id": "400831702",
                    "speaker": "左右加",
                    "text": "果然，「天守阁的座上宾」所具备的天赋和实力，不是我这种凡人可以企及的。"
                },
                {
                    "id": "400831703",
                    "speaker": "派蒙",
                    "text": "怎么办，左右加小姐受到的打击不是一般的大呢…神子说得倒是轻松，看见她这个样子，还是会生气的吧。"
                },
                {
                    "id": "400831704",
                    "speaker": "派蒙",
                    "text": "我心里慌慌的，感觉很不安！我们还是先去向神子道歉吧。「咚咚小圆帽」也要拿出诚意来哦。"
                }
            ]
        },
        {
            "id": "4008314",
            "objective": "离开赛场",
            "dialogues": [
                {
                    "id": "400831401",
                    "speaker": "派蒙",
                    "text": "看起来都是很普通的「花花琼脂」而已，毕竟是能展示给所有人看的东西，就连配方都摆在桌上了。",
                    "choices": [
                        {
                            "id": "400831402",
                            "text": "就算它们的成分有蹊跷。",
                            "response": [
                                {
                                    "id": "400831404",
                                    "speaker": "派蒙",
                                    "text": "那我们也没法把它们拿去调查啊，这算是偷盗了吧，会让我们丢掉比赛资格的，搞不好还要被「三十人团」抓起来。"
                                },
                                {
                                    "id": "400831405",
                                    "speaker": "派蒙",
                                    "text": "对了，我们有留影机！不如给这些「花花琼脂」的实物和配方拍照，这样就能记录很多重要的信息了。"
                                }
                            ]
                        },
                        {
                            "id": "400831403",
                            "text": "普通选手也看不出问题。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008305",
            "objective": "与八重神子对话",
            "dialogues": [
                {
                    "id": "400830501",
                    "speaker": "派蒙",
                    "text": "神子！对不起！我们没想到「咚咚小圆帽」噼里啪啦一顿打，就把左右加小姐给淘汰了…",
                    "choices": [
                        {
                            "id": "400830502",
                            "text": "派蒙…驯兽师是我。",
                            "response": [
                                {
                                    "id": "400830504",
                                    "speaker": "八重神子",
                                    "text": "哦？左右加是不是非常气馁，念叨着「凡人没法企及」之类的夸张说辞？蹲在地上哀嚎？"
                                },
                                {
                                    "id": "400830505",
                                    "speaker": "派蒙",
                                    "text": "完全一致呢，你还真是了解她…"
                                },
                                {
                                    "id": "400830506",
                                    "speaker": "八重神子",
                                    "text": "这样反而更好，左右加会把这次打击当成宝贵的素材，生动地描写出主角成长过程中所受的挫折，牵动读者们的心。"
                                },
                                {
                                    "id": "400830507",
                                    "speaker": "八重神子",
                                    "text": "至于展现反派的压迫力，和精彩的夺冠过程，就要从你们身上取材啦。可别在我这个半吊子选手之前被淘汰哦。",
                                    "choices": [
                                        {
                                            "id": "400830508",
                                            "text": "坏了，我成反派了。",
                                            "response": [
                                                {
                                                    "id": "400830510",
                                                    "speaker": "派蒙",
                                                    "text": "蹭饭的事先别计较了啦！神子你千万要让左右加小姐笔下留情啊！"
                                                },
                                                {
                                                    "id": "400830511",
                                                    "speaker": "莱依拉",
                                                    "text": "#{NICKNAME}、派蒙、还有八重小姐…呃咳咳咳咳…"
                                                },
                                                {
                                                    "id": "400830512",
                                                    "speaker": "派蒙",
                                                    "text": "莱依拉，你悠着点啊，好怕你直接昏倒…"
                                                },
                                                {
                                                    "id": "400830513",
                                                    "speaker": "莱依拉",
                                                    "text": "我还好…之前我写信给生论派的学员了，没想到对方的反响很热烈，几个小时后就回了信，附上了我需要的资料。"
                                                },
                                                {
                                                    "id": "400830514",
                                                    "speaker": "莱依拉",
                                                    "text": "根据这些资料，我试着给「转转悠悠兽」做了不少吃的，可能是因为食材不准确的缘故，「转转悠悠兽」不是很喜欢的样子。"
                                                },
                                                {
                                                    "id": "400830515",
                                                    "speaker": "莱依拉",
                                                    "text": "之后我列出了一份改良版的清单，也包括了「咚咚小圆帽」可能喜欢的食材，结果搞到后半夜才睡，所以今天有点呼吸不畅…"
                                                },
                                                {
                                                    "id": "400830516",
                                                    "speaker": "派蒙",
                                                    "text": "这么快就有结果了？效率好高！"
                                                },
                                                {
                                                    "id": "400830517",
                                                    "speaker": "Player",
                                                    "text": "（只是没睡好…会呼吸不畅吗？）"
                                                },
                                                {
                                                    "id": "400830518",
                                                    "speaker": "八重神子",
                                                    "text": "小莱依拉那边的情况如何？有好好招待对手吗？"
                                                },
                                                {
                                                    "id": "400830519",
                                                    "speaker": "莱依拉",
                                                    "text": "嗯！多亏八重小姐带我们去修行，「转转悠悠兽」更听我的话了，反应快得让我都有些羡慕…"
                                                },
                                                {
                                                    "id": "400830520",
                                                    "speaker": "莱依拉",
                                                    "text": "但对手明显也变强了，我的压力有点大。为了打进八强赛，我想和「转转悠悠兽」再去训练一次。"
                                                },
                                                {
                                                    "id": "400830521",
                                                    "speaker": "莱依拉",
                                                    "text": "问题在于…我又想在明早七点去找「全能商人」，一次性买齐计划中的所有食材…"
                                                },
                                                {
                                                    "id": "400830522",
                                                    "speaker": "八重神子",
                                                    "text": "#这很好办，我陪你去闭关训练吧，至于买东西的工作，拜托小家伙们就好了，{M#他们}{F#她们}很擅长帮人跑腿。"
                                                },
                                                {
                                                    "id": "400830523",
                                                    "speaker": "莱依拉",
                                                    "text": "听起来，你们两位好像经常为八重小姐工作呢？",
                                                    "choices": [
                                                        {
                                                            "id": "400830524",
                                                            "text": "没错，我们很乐意！",
                                                            "response": [
                                                                {
                                                                    "id": "400830526",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊！对对对！请别把我们写成凶巴巴的坏人！"
                                                                },
                                                                {
                                                                    "id": "400830527",
                                                                    "speaker": "八重神子",
                                                                    "text": "不用担心，小莱依拉，他们刚刚还在为打败左右加的事向我道歉呢，你先去买杯饮品，喘口气吧。"
                                                                },
                                                                {
                                                                    "id": "400830528",
                                                                    "speaker": "莱依拉",
                                                                    "text": "有劳你们了！实在感激不尽！"
                                                                },
                                                                {
                                                                    "id": "400830529",
                                                                    "speaker": "莱依拉",
                                                                    "text": "这里是我和「全能商人」碰头的地址，食材清单也写在上面了，请收下。"
                                                                },
                                                                {
                                                                    "id": "400830530",
                                                                    "speaker": "派蒙",
                                                                    "text": "不用这么客气啦！你也调查了「咚咚小圆帽」的喜好，我们这是在互相帮忙，你就放心去吧！"
                                                                },
                                                                {
                                                                    "id": "400830531",
                                                                    "speaker": "八重神子",
                                                                    "text": "关于上次没能展开的讨论，这场比赛背后的「不安定因素」…或许有个不错的切入点——用来培养蕈兽的材料。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400830532",
                                                                            "text": "「花花琼脂」？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400830534",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "这可是小说里最精彩的桥段之一——秘密调查。小家伙一直很好奇吧？「意智宝珠」和「花花琼脂」的魔力究竟从何而来？"
                                                                                },
                                                                                {
                                                                                    "id": "400830535",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "而且，不搞清楚这场比赛的底细，让海妮耶只凭自己的意愿莽撞行事，或许会闹出更大乱子哦。"
                                                                                },
                                                                                {
                                                                                    "id": "400830536",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "呜…话题突然变得好复杂，我有点听不懂了…"
                                                                                },
                                                                                {
                                                                                    "id": "400830537",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "建议你们在临近天亮的时候行动，那段时间，人们通常都很疲惫。也许你们可以找到关键的线索哦。"
                                                                                },
                                                                                {
                                                                                    "id": "400830538",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "你真的要按神子说的做吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400830539",
                                                                                            "text": "这是最初参赛的理由。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400830541",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "这么一说也没错，那就等到明天凌晨，去培养蕈兽的地方看看吧…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400830542",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "我们只是在确认比赛的安全程度。我是不会怀疑「咚咚小圆帽」的，你放心好啦。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "400830540",
                                                                                            "text": "这是为了和同伴安心共处。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400830533",
                                                                            "text": "神子听说了什么吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400830525",
                                                            "text": "如果不答应，我们的形象就…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400830509",
                                            "text": "派蒙蹭反派的饭，派蒙更坏。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400830503",
                            "text": "应该负全责的是我…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008306",
            "objective": "等待到第二天凌晨（3:00-5:00）",
            "dialogues": []
        },
        {
            "id": "4008307",
            "objective": "前往「花花琼脂」摊位",
            "dialogues": []
        },
        {
            "id": "4008318",
            "objective": "拍摄摊位，留取证据",
            "dialogues": [
                {
                    "id": "400831801",
                    "speaker": "雪怪伯",
                    "text": "怎么可能…我竟如此不堪一击…"
                },
                {
                    "id": "400831802",
                    "speaker": "派蒙",
                    "text": "呼，赢得也不算轻松呢…辛苦你和伙伴们啦，「咚咚小圆帽」！"
                }
            ]
        },
        {
            "id": "4008319",
            "objective": "与海妮耶对话",
            "dialogues": [
                {
                    "id": "400831901",
                    "speaker": "Black Screen",
                    "text": "找出「花花琼脂」的配方笔记，并对笔记和实物拍照取证后，收好了线索…"
                },
                {
                    "id": "400831902",
                    "speaker": "派蒙",
                    "text": "完成了！接下来我们应该找个专业人士来分析这些东西…不过时间好像有点紧，还是先去帮莱依拉买东西吧？"
                },
                {
                    "id": "400831903",
                    "speaker": "派蒙",
                    "text": "海海海，海妮耶？"
                },
                {
                    "id": "400831904",
                    "speaker": "海妮耶",
                    "text": "你们对自己的要求倒也挺严苛的，这么早就来培养蕈兽。难怪能一路顺利晋级。"
                },
                {
                    "id": "400831905",
                    "speaker": "派蒙",
                    "text": "海妮耶，上次我们还没说完呢！你的想法太激进了…"
                },
                {
                    "id": "400831906",
                    "speaker": "海妮耶",
                    "text": "无需多言，如果你们认为我错了，就先击败我，再向我展示你们所谓正确的观点。"
                },
                {
                    "id": "400831907",
                    "speaker": "派蒙",
                    "text": "完全听不进我们的话…明明刚见面时的关系还不错的，怎么就变成了这个样子！",
                    "choices": [
                        {
                            "id": "400831908",
                            "text": "走吧，我们时间紧迫。",
                            "response": [
                                {
                                    "id": "400831910",
                                    "speaker": "派蒙",
                                    "text": "唔，好吧…「咚咚小圆帽」，我们也没工夫难过了。"
                                }
                            ]
                        },
                        {
                            "id": "400831909",
                            "text": "只能用她认可的方式说服她。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008309",
            "objective": "寻找「全能商人」",
            "dialogues": [
                {
                    "id": "400830901",
                    "speaker": "派蒙",
                    "text": "根据莱依拉的纸条，应该要在这里和「全能商人」碰头…"
                },
                {
                    "id": "400830902",
                    "speaker": "多莉",
                    "text": "看你们东张西望的神态，大概是在找「全能商人」吧？那就欢迎光临啦！"
                },
                {
                    "id": "400830903",
                    "speaker": "派蒙",
                    "text": "对啊对啊，你很懂嘛…"
                },
                {
                    "id": "400830904",
                    "speaker": "派蒙",
                    "text": "不对，怎么是多莉？莱依拉说的「全能商人」原来就是你！"
                },
                {
                    "id": "400830905",
                    "speaker": "多莉",
                    "text": "有什么好奇怪的？「桑歌玛哈巴依老爷的商品种类最多最神奇」，这是全大巴扎的老板和客人都知道的事哦。"
                },
                {
                    "id": "400830906",
                    "speaker": "多莉",
                    "text": "「万能」「全能」「大能」和不管什么能…都是我多莉的专属招牌。别的商人想用都免谈，除非先付几百万授权费！"
                },
                {
                    "id": "400830907",
                    "speaker": "派蒙",
                    "text": "呃，我们早该想到的…"
                },
                {
                    "id": "400830908",
                    "speaker": "多莉",
                    "text": "话说回来，莱依拉居然找你们跑腿了？看来她真的沉迷在驯兽师大赛里了啊。"
                },
                {
                    "id": "400830909",
                    "speaker": "派蒙",
                    "text": "原来你和莱依拉的关系还挺好的，对她的情况很了解嘛。"
                },
                {
                    "id": "400830910",
                    "speaker": "多莉",
                    "text": "嘿！这和关系好坏无关。莱依拉在我这里买过一些东西，虽然不算特别贵重，但对于一个学员来说，也算是出手阔绰了。"
                },
                {
                    "id": "400830911",
                    "speaker": "多莉",
                    "text": "我当然会留意她的动向，知道她参加了可疑的比赛！",
                    "choices": [
                        {
                            "id": "400830912",
                            "text": "你也知道些隐情。",
                            "response": [
                                {
                                    "id": "400830914",
                                    "speaker": "多莉",
                                    "text": "嗯哼，我只是隐隐觉得不对劲罢了。正好我这里有些卖不出去的烫手货，屯着也是生锈，不如交给你们。"
                                },
                                {
                                    "id": "400830915",
                                    "speaker": "派蒙",
                                    "text": "唔…看起来只是一些零件和残缺的笔记？"
                                },
                                {
                                    "id": "400830916",
                                    "speaker": "多莉",
                                    "text": "听说是大赛主办方试图销毁的仪器和文件。"
                                },
                                {
                                    "id": "400830917",
                                    "speaker": "多莉",
                                    "text": "他们太大意了，有些人拾荒发财的意愿可是很强的！这些东西都被打捞上来转手给了我。"
                                },
                                {
                                    "id": "400830918",
                                    "speaker": "派蒙",
                                    "text": "仔细看，这些文件上有些词汇跟「花花琼脂」的配方很像呢。仪器残骸也和「意智宝珠」的一些地方有相似之处。"
                                },
                                {
                                    "id": "400830919",
                                    "speaker": "派蒙",
                                    "text": "说不定是用来实验的产品。先收起来吧，到时候让神子看看，也许她能找到不对劲的地方？",
                                    "choices": [
                                        {
                                            "id": "400830920",
                                            "text": "总之可以先假设…",
                                            "response": [
                                                {
                                                    "id": "400830922",
                                                    "speaker": "派蒙",
                                                    "text": "结果我们一开始的担心好像快要应验了…我还想和「咚咚小圆帽」无忧无虑地一起玩呢！"
                                                },
                                                {
                                                    "id": "400830923",
                                                    "speaker": "多莉",
                                                    "text": "虽然不清楚你们在商量什么，但看起来这些东西对你们还挺有用的。就给你们打个折好啦，六千万摩拉，谢谢惠顾！"
                                                },
                                                {
                                                    "id": "400830924",
                                                    "speaker": "派蒙",
                                                    "text": "欸！太狡猾了吧！"
                                                },
                                                {
                                                    "id": "400830925",
                                                    "speaker": "多莉",
                                                    "text": "嘿嘿，开玩笑的，这种东西除了你们和风纪官也没人会关心了吧。就当是做了一单普通的生意，给你们的赠品。"
                                                },
                                                {
                                                    "id": "400830926",
                                                    "speaker": "多莉",
                                                    "text": "莱依拉的订货单交给我吧，我只需要知道莱依拉想要的究竟是什么，备货后就托专人送过去，不劳你们跑腿了。"
                                                },
                                                {
                                                    "id": "400830927",
                                                    "speaker": "派蒙",
                                                    "text": "吓死我了，我还以为我们要白干了，算上奖金都不一定能随便付这么多钱吧…"
                                                },
                                                {
                                                    "id": "400830928",
                                                    "speaker": "Player",
                                                    "text": "这是莱依拉的订货单。"
                                                },
                                                {
                                                    "id": "400830929",
                                                    "speaker": "多莉",
                                                    "text": "呃啊，掺了松茸末的面粉、陈年果酱和墩墩桃汁…蕈兽真的会吃这些东西吗？莱依拉究竟是怎么知道的…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400830921",
                                            "text": "考特里亚有问题…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400830913",
                            "text": "你手里有情报吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4008311",
            "objective": "参加比赛",
            "dialogues": []
        },
        {
            "id": "4008321",
            "objective": "参加比赛$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4008323",
            "objective": "击败对手",
            "dialogues": []
        },
        {
            "id": "4008310",
            "objective": "击败对手",
            "dialogues": [
                {
                    "id": "400831601",
                    "speaker": "雪怪伯",
                    "text": "眼神不错，值得我拿出「苦修」多年的全部实力。"
                },
                {
                    "id": "400831602",
                    "speaker": "雪怪伯",
                    "text": "来吧，就让你们见识一下，掌控冰霜之力的强大蕈兽队伍。"
                }
            ]
        },
        {
            "id": "4008312",
            "objective": "击败对手",
            "dialogues": []
        },
        {
            "id": "4008317",
            "objective": "与对手对话",
            "dialogues": []
        },
        {
            "id": "4008315",
            "objective": "离开赛场",
            "dialogues": []
        },
        {
            "id": "4008313",
            "objective": "与莱依拉对话",
            "dialogues": [
                {
                    "id": "400831301",
                    "speaker": "莱依拉",
                    "text": "#{NICKNAME}，派蒙。我在赛程上看见你们顺利晋级了，恭喜你们！"
                },
                {
                    "id": "400831302",
                    "speaker": "派蒙",
                    "text": "哦哦！莱依拉，今天你很有精神嘛，「转转悠悠兽」也开开心心，看来也打了个大胜仗！"
                },
                {
                    "id": "400831303",
                    "speaker": "莱依拉",
                    "text": "这次我赢得很惊险，只是勉强赢过对手一线，还好之前有和八重小姐一起去闭关训练。"
                },
                {
                    "id": "400831304",
                    "speaker": "莱依拉",
                    "text": "刚刚「全能商人」托人把我要的东西送过来了，由衷感谢你们！待会儿我就带着「转转悠悠兽」去调整状态…"
                },
                {
                    "id": "400831305",
                    "speaker": "莱依拉",
                    "text": "呃咳咳…力气不够了…我们还是压低音量吧。"
                },
                {
                    "id": "400831306",
                    "speaker": "派蒙",
                    "text": "说起来，怎么没有看见神子？"
                },
                {
                    "id": "400831307",
                    "speaker": "莱依拉",
                    "text": "八重小姐好像有什么急事，和左右加小姐他们先走了。好像还有一位「三十人团」的佣兵在给他们领路…"
                },
                {
                    "id": "400831308",
                    "speaker": "莱依拉",
                    "text": "我回到赛场的时候，他们已经走远了，追上去问话好像有点唐突…",
                    "choices": [
                        {
                            "id": "400831309",
                            "text": "也许她还有工作要忙？",
                            "response": [
                                {
                                    "id": "400831311",
                                    "speaker": "派蒙",
                                    "text": "也对哦，这段时间神子一直在比赛，偶尔去处理一下主编大人的工作也很正常吧。"
                                },
                                {
                                    "id": "400831312",
                                    "speaker": "派蒙",
                                    "text": "而且神子说过，她想一边度假一边取材，说不定那个佣兵就是他们的导游呢，我们也不用担心啦！"
                                },
                                {
                                    "id": "400831313",
                                    "speaker": "莱依拉",
                                    "text": "嗯，接下来就是八强赛了，最关键的一场比赛…虽然有点害怕，但我们还是一起努力吧！"
                                },
                                {
                                    "id": "400831314",
                                    "speaker": "派蒙",
                                    "text": "好！这样看下来，我们晋级还蛮顺利的嘛，莱依拉一定要加油！",
                                    "choices": [
                                        {
                                            "id": "400831315",
                                            "text": "我们也不能松懈。",
                                            "response": [
                                                {
                                                    "id": "400831317",
                                                    "speaker": "派蒙",
                                                    "text": "没错，我们要保持警惕！至于从多莉手里拿到的东西，我们也拍几张照，和今早的照片放在一起，等到下次见面时给神子看看吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400831316",
                                            "text": "要兼顾比赛和调查。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400831310",
                            "text": "毕竟「八重堂」的事务很多。"
                        }
                    ]
                }
            ]
        },
