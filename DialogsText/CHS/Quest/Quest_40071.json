    "talks": [
        {
            "id": "4007101",
            "objective": "休息到第二天(6点-24点）",
            "dialogues": []
        },
        {
            "id": "4007102",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400710201",
                    "speaker": "派蒙",
                    "text": "醒了吗？"
                },
                {
                    "id": "400710202",
                    "speaker": "Player",
                    "text": "唔…又是早上了…"
                },
                {
                    "id": "400710203",
                    "speaker": "Player",
                    "text": "怎么样？出现什么了吗？"
                },
                {
                    "id": "400710204",
                    "speaker": "派蒙",
                    "text": "说出来你可能不信，什么事都没发生。"
                },
                {
                    "id": "400710205",
                    "speaker": "辛焱",
                    "text": "你醒啦？那我们直接说结论，四周都找过了，没有可疑的东西。"
                },
                {
                    "id": "400710206",
                    "speaker": "枫原万叶",
                    "text": "按照之前两处幻境的规律，应该会有一件承担着「入口」职责的物品才对。"
                },
                {
                    "id": "400710207",
                    "speaker": "Player",
                    "text": "这就怪了。"
                },
                {
                    "id": "400710208",
                    "speaker": "莫娜",
                    "text": "会不会是没到时候？"
                },
                {
                    "id": "400710209",
                    "speaker": "辛焱",
                    "text": "你的意思是，再等等？"
                },
                {
                    "id": "400710210",
                    "speaker": "莫娜",
                    "text": "嗯。而且，菲谢尔不在这里。我想，她很可能比我们更急着找到入口。"
                },
                {
                    "id": "400710211",
                    "speaker": "莫娜",
                    "text": "我们等等吧。给幻境…不，给菲谢尔一点时间。"
                },
                {
                    "id": "400710212",
                    "speaker": "Black Screen",
                    "text": "大家赞同莫娜的说法，聚在一起喝茶休息。之后，又分为两队四处搜索。"
                },
                {
                    "id": "400710213",
                    "speaker": "Black Screen",
                    "text": "终于，在白白走了好几个来回后，海滩上突然多出了一些东西。"
                },
                {
                    "id": "400710214",
                    "speaker": "派蒙",
                    "text": "有什么东西掉在沙滩上了！"
                },
                {
                    "id": "400710215",
                    "speaker": "枫原万叶",
                    "text": "是一本书？旁边还有只…呃…乌鸦的雕像？"
                },
                {
                    "id": "400710216",
                    "speaker": "派蒙",
                    "text": "这尊雕像长得好像奥兹哦…"
                },
                {
                    "id": "400710217",
                    "speaker": "莫娜",
                    "text": "一起出现是什么意思？这本书，是它送来的吗？"
                },
                {
                    "id": "400710218",
                    "speaker": "辛焱",
                    "text": "这是什么？日记？"
                },
                {
                    "id": "400710219",
                    "speaker": "莫娜",
                    "text": "我看看…《圣国的咏唱》？我都没见过叫这个名字的书。"
                },
                {
                    "id": "400710220",
                    "speaker": "派蒙",
                    "text": "看封面，难道是…菲谢尔自己写的？"
                },
                {
                    "id": "400710221",
                    "speaker": "辛焱",
                    "text": "这么一说确实像她的风格。《圣国的咏唱》，书名不错，我喜欢。"
                },
                {
                    "id": "400710222",
                    "speaker": "枫原万叶",
                    "text": "这本书的名字，有种神圣感。"
                },
                {
                    "id": "400710223",
                    "speaker": "派蒙",
                    "text": "怎么样？要碰碰它吗？"
                },
                {
                    "id": "400710224",
                    "speaker": "莫娜",
                    "text": "…还没回来。"
                },
                {
                    "id": "400710225",
                    "speaker": "莫娜",
                    "text": "算了，我们先去看看吧。如果菲谢尔见到这本书，应该会来找我们。"
                },
                {
                    "id": "400710226",
                    "speaker": "派蒙",
                    "text": "我同意哦！就像被人偷看了日记一样，肯定要进来阻止我们的嘛。"
                }
            ]
        },
        {
            "id": "4007117",
            "objective": "(test)(hide)隐藏刷新雕像和书$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007103",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400710301",
                    "speaker": "旁白",
                    "text": "「如今的国民无从忆起，但学者知道，远在早于圣徒时代约六百年的混沌期间，皇女殿下便已君临世间。」"
                },
                {
                    "id": "400710302",
                    "speaker": "莫娜",
                    "text": "不会吧？旁白？"
                },
                {
                    "id": "400710303",
                    "speaker": "辛焱",
                    "text": "不愧是书里的世界，竟然还有旁白给我们讲故事。"
                },
                {
                    "id": "400710304",
                    "speaker": "派蒙",
                    "text": "路断了，走不过去。"
                },
                {
                    "id": "400710305",
                    "speaker": "莫娜",
                    "text": "那边有个装置，像是等着我们靠近一样。"
                },
                {
                    "id": "400710306",
                    "speaker": "派蒙",
                    "text": "我总觉得…这里的一切是不是太过刻意了？"
                },
                {
                    "id": "400710307",
                    "speaker": "莫娜",
                    "text": "是圣国嘛。体谅一下。"
                },
                {
                    "id": "400710308",
                    "speaker": "派蒙",
                    "text": "也是，这么明显，完全就是希望被人发现嘛。"
                },
                {
                    "id": "400710309",
                    "speaker": "辛焱",
                    "text": "不愧是菲谢尔，在这种地方坦率得可怕。"
                }
            ]
        },
        {
            "id": "4007104",
            "objective": "尝试使用奇怪的装置",
            "dialogues": []
        },
        {
            "id": "4007105",
            "objective": "跟随故事的指引进入城堡",
            "dialogues": []
        },
        {
            "id": "4007108",
            "objective": "修复桥梁",
            "dialogues": []
        },
        {
            "id": "4007109",
            "objective": "跟随故事的指引进入城堡",
            "dialogues": []
        },
        {
            "id": "4007110",
            "objective": "寻找声音的来源",
            "dialogues": [
                {
                    "id": "400711001",
                    "speaker": "？？？",
                    "text": "天哪，请救救我！"
                },
                {
                    "id": "400711002",
                    "speaker": "派蒙",
                    "text": "喂，这不是个雕像吗？"
                },
                {
                    "id": "400711003",
                    "speaker": "？？？",
                    "text": "请别这么说！我是幽夜净土的骑士，莱昂。"
                },
                {
                    "id": "400711004",
                    "speaker": "派蒙",
                    "text": "骑士？完全看不出来。"
                },
                {
                    "id": "400711005",
                    "speaker": "莱昂",
                    "text": "看不出吗？好吧。就算如此，也请各位不要怪罪为夜鸦骑士们设计配发盔甲的奥兹华尔多大人。"
                },
                {
                    "id": "400711006",
                    "speaker": "Player",
                    "text": "奥兹华尔多大人。"
                },
                {
                    "id": "400711007",
                    "speaker": "莫娜",
                    "text": "#{NICKNAME}应该听说过吧？奥兹的全名是奥兹华尔多·赫芙那梵茵斯。",
                    "choices": [
                        {
                            "id": "400711008",
                            "text": "我知道。",
                            "response": [
                                {
                                    "id": "400711010",
                                    "speaker": "辛焱",
                                    "text": "那还是梅姬斯图斯好念一点。"
                                },
                                {
                                    "id": "400711011",
                                    "speaker": "枫原万叶",
                                    "text": "嗯，我也这么想。"
                                },
                                {
                                    "id": "400711012",
                                    "speaker": "莫娜",
                                    "text": "啊哈哈，大家都这么说呢…"
                                },
                                {
                                    "id": "400711013",
                                    "speaker": "莱昂",
                                    "text": "各位朋友，打扰你们愉快的聊天时间实在非我所愿，只是，你们应该还不知道前面的大门上了锁。"
                                },
                                {
                                    "id": "400711014",
                                    "speaker": "派蒙",
                                    "text": "确实不知道呢。"
                                },
                                {
                                    "id": "400711015",
                                    "speaker": "莱昂",
                                    "text": "但愿好心的你们能动动手指将我救上去，作为报答，我非常愿意将打开大门的方法教给各位。"
                                },
                                {
                                    "id": "400711016",
                                    "speaker": "莫娜",
                                    "text": "你都这么说了…好吧。"
                                }
                            ]
                        },
                        {
                            "id": "400711009",
                            "text": "我现在知道了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007111",
            "objective": "帮助莱昂离开深井",
            "dialogues": []
        },
        {
            "id": "4007112",
            "objective": "与莱昂对话",
            "dialogues": [
                {
                    "id": "400711201",
                    "speaker": "莱昂",
                    "text": "英雄们，再多话语也无法诉说我此刻的激动。感谢你们。"
                },
                {
                    "id": "400711202",
                    "speaker": "莱昂",
                    "text": "请记住，这是打开大门的口令：「令我的子民自由，不囿于古老法则。」"
                }
            ]
        },
        {
            "id": "4007119",
            "objective": "(test)(hide)隐藏销毁洋葱哥$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007116",
            "objective": "修复通往高塔的道路",
            "dialogues": []
        },
        {
            "id": "4007113",
            "objective": "前往高塔顶部",
            "dialogues": [
                {
                    "id": "400711301",
                    "speaker": "派蒙",
                    "text": "前面好像没有路了，只有一本书。"
                },
                {
                    "id": "400711302",
                    "speaker": "辛焱",
                    "text": "我们刚才听到的，应该就是书里的故事吧？"
                },
                {
                    "id": "400711303",
                    "speaker": "莫娜",
                    "text": "所以，书名中的圣国，指的就是幽夜净土。这本书是在用国民的口吻歌颂皇女殿下。"
                },
                {
                    "id": "400711304",
                    "speaker": "Player",
                    "text": "也算是自传的一种吧…"
                },
                {
                    "id": "400711305",
                    "speaker": "枫原万叶",
                    "text": "书已经翻到最后一页了，但它们的故事听起来还没结束。"
                },
                {
                    "id": "400711306",
                    "speaker": "派蒙",
                    "text": "后续呢？我想听后续！"
                },
                {
                    "id": "400711307",
                    "speaker": "枫原万叶",
                    "text": "那就得继续探索了吧。比起这个，看完的书…还是先合上比较好。"
                }
            ]
        },
        {
            "id": "4007118",
            "objective": "合上《圣国的咏唱》",
            "dialogues": []
        },
        {
            "id": "4007106",
            "objective": "合上《圣国的咏唱》",
            "dialogues": []
        },
        {
            "id": "4007114",
            "objective": "聆听房间里的声音",
            "dialogues": [
                {
                    "id": "400711401",
                    "speaker": "莫娜",
                    "text": "欸？怎么换地方了，但又没回到海滩上？"
                },
                {
                    "id": "400711402",
                    "speaker": "派蒙",
                    "text": "这里似乎是蒙德的住宅呢。"
                },
                {
                    "id": "400711403",
                    "speaker": "菲谢尔",
                    "text": "贵安，尊贵的「断罪之皇后」。"
                },
                {
                    "id": "400711404",
                    "speaker": "？？？",
                    "text": "小艾咪亲爱的，妈妈做了煎肉排和渔人吐司，快来趁热吃。"
                },
                {
                    "id": "400711405",
                    "speaker": "菲谢尔",
                    "text": "咳咳！母后…"
                },
                {
                    "id": "400711406",
                    "speaker": "？？？",
                    "text": "噢噢，瞧我，都给忘了。咳！断罪之皇女，汝可知此刻正是午餐时分？"
                },
                {
                    "id": "400711407",
                    "speaker": "菲谢尔",
                    "text": "当然了母后。"
                },
                {
                    "id": "400711408",
                    "speaker": "？？？",
                    "text": "噢——！窗外景色如此迷人，皇女，皇后，二位可否赏光与我这「断罪之皇帝」一同外出野餐？看看风景，享受上天恩赐的美味。"
                },
                {
                    "id": "400711409",
                    "speaker": "菲谢尔",
                    "text": "是的，非常愿意！"
                },
                {
                    "id": "400711410",
                    "speaker": "莫娜",
                    "text": "……"
                },
                {
                    "id": "400711411",
                    "speaker": "枫原万叶",
                    "text": "……"
                },
                {
                    "id": "400711412",
                    "speaker": "辛焱",
                    "text": "呃…那个，大家是不是都有话想说…"
                },
                {
                    "id": "400711413",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "400711414",
                    "speaker": "辛焱",
                    "text": "我直接问了，小艾咪…是菲谢尔的真名？"
                },
                {
                    "id": "400711415",
                    "speaker": "派蒙",
                    "text": "应该是吧。刚才那两个声音，好像是她的爸爸妈妈。"
                },
                {
                    "id": "400711416",
                    "speaker": "莫娜",
                    "text": "…看我干什么？！"
                },
                {
                    "id": "400711417",
                    "speaker": "枫原万叶",
                    "text": "可能有点冒昧，但…你真的姓梅姬斯图斯吗？"
                },
                {
                    "id": "400711418",
                    "speaker": "莫娜",
                    "text": "哼，你在小看我？本占星术士的全名是：阿斯托洛吉斯·莫娜·梅姬斯图斯。"
                },
                {
                    "id": "400711419",
                    "speaker": "枫原万叶",
                    "text": "…对不起。"
                },
                {
                    "id": "400711420",
                    "speaker": "辛焱",
                    "text": "好长！"
                },
                {
                    "id": "400711421",
                    "speaker": "莫娜",
                    "text": "只有天才能拥有这个名字哦。"
                },
                {
                    "id": "400711422",
                    "speaker": "派蒙",
                    "text": "总觉得没有道理…"
                },
                {
                    "id": "400711423",
                    "speaker": "莫娜",
                    "text": "刚才那些，你们感觉如何？"
                },
                {
                    "id": "400711424",
                    "speaker": "枫原万叶",
                    "text": "我确定了一件事，「合上书本」也是一种引起幻境变化的手段。"
                },
                {
                    "id": "400711425",
                    "speaker": "辛焱",
                    "text": "菲谢尔的家人居然肯配合她，厉害啊。"
                },
                {
                    "id": "400711426",
                    "speaker": "莫娜",
                    "text": "但也不会一直如此。听声音，这是她小时候的回忆吧？长大可就不是这样了。"
                },
                {
                    "id": "400711427",
                    "speaker": "派蒙",
                    "text": "莫娜知道很多嘛！"
                },
                {
                    "id": "400711428",
                    "speaker": "莫娜",
                    "text": "身为朋友知道这些很正常吧。"
                },
                {
                    "id": "400711429",
                    "speaker": "莫娜",
                    "text": "…菲谢尔现在，会在哪里呢。"
                },
                {
                    "id": "400711430",
                    "speaker": "枫原万叶",
                    "text": "刚才那个声音说她要出门，我们不如也出去看看，应该会有线索。"
                }
            ]
        },
        {
            "id": "4007107",
            "objective": "离开房间",
            "dialogues": []
        },
        {
            "id": "4007115",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400711501",
                    "speaker": "派蒙",
                    "text": "哇，回来了。"
                },
                {
                    "id": "400711502",
                    "speaker": "派蒙",
                    "text": "不对不对，怎么回来了呀！故事还没听完呢！"
                },
                {
                    "id": "400711503",
                    "speaker": "莫娜",
                    "text": "这种感觉，糟透了，就像买到假冒伪劣占星教程，或是晚餐吃到一半发现忘带钱包…"
                },
                {
                    "id": "400711504",
                    "speaker": "派蒙",
                    "text": "啊——！"
                },
                {
                    "id": "400711505",
                    "speaker": "莫娜",
                    "text": "啊——！好难受啊！"
                },
                {
                    "id": "400711506",
                    "speaker": "辛焱",
                    "text": "她俩很受打击的样子。"
                },
                {
                    "id": "400711507",
                    "speaker": "枫原万叶",
                    "text": "实不相瞒，我也不喜欢看被腰斩的书。"
                },
                {
                    "id": "400711508",
                    "speaker": "辛焱",
                    "text": "哈哈，谁会喜欢啊。各位，我们再进一次幻境吧。"
                },
                {
                    "id": "400711509",
                    "speaker": "派蒙",
                    "text": "好主意！那我们现在就出发！"
                },
                {
                    "id": "400711510",
                    "speaker": "辛焱",
                    "text": "…嗯？"
                },
                {
                    "id": "400711511",
                    "speaker": "枫原万叶",
                    "text": "没反应，位置也没变。"
                },
                {
                    "id": "400711512",
                    "speaker": "辛焱",
                    "text": "奇怪，刚才还能进的，现在就把我们拒之门外了。"
                },
                {
                    "id": "400711513",
                    "speaker": "莫娜",
                    "text": "为什么！存心不让人看完这本书吗！太坏了吧！"
                },
                {
                    "id": "400711514",
                    "speaker": "枫原万叶",
                    "text": "唔…是因为，这本书已经「读到最后」了吧。"
                },
                {
                    "id": "400711515",
                    "speaker": "枫原万叶",
                    "text": "离开幻境前，我们见到的这本书被翻到了最后一页，我觉得，《圣国的咏唱》可能不止一本。"
                },
                {
                    "id": "400711516",
                    "speaker": "派蒙",
                    "text": "好像什么俗套轻小说的销售套路一样…欲知后事如何，请购买下卷，什么的。"
                },
                {
                    "id": "400711517",
                    "speaker": "莫娜",
                    "text": "可恶，我一定要看到结局。"
                },
                {
                    "id": "400711518",
                    "speaker": "？？？",
                    "text": "噢，噢是的结局，大家都爱看书的结局呢。"
                },
                {
                    "id": "400711519",
                    "speaker": "莫娜",
                    "text": "嗯？谁在那边？"
                },
                {
                    "id": "400711520",
                    "speaker": "？？？",
                    "text": "噢，噢天哪，她看见我了，立正立正。"
                },
                {
                    "id": "400711521",
                    "speaker": "莫娜",
                    "text": "你是…"
                },
                {
                    "id": "400711522",
                    "speaker": "？？？",
                    "text": "我是「渴望被问路的阿诺德」。"
                },
                {
                    "id": "400711523",
                    "speaker": "派蒙",
                    "text": "名字目的性太强了吧！"
                },
                {
                    "id": "400711524",
                    "speaker": "莫娜",
                    "text": "阿诺德，我问你…"
                },
                {
                    "id": "400711525",
                    "speaker": "阿诺德",
                    "text": "是「渴望被问路的阿诺德」，不是阿诺德！"
                },
                {
                    "id": "400711526",
                    "speaker": "莫娜",
                    "text": "渴望被问路的阿诺德，我问你！"
                },
                {
                    "id": "400711527",
                    "speaker": "阿诺德",
                    "text": "是的女士！"
                },
                {
                    "id": "400711528",
                    "speaker": "莫娜",
                    "text": "《圣国的咏唱》有后续吗？在哪里？"
                },
                {
                    "id": "400711529",
                    "speaker": "阿诺德",
                    "text": "噢，噢您可真是问对人了。《圣国的咏唱》是幽夜净土的圣典，共有三卷，其余两卷分别藏在王城的两处高地。"
                },
                {
                    "id": "400711530",
                    "speaker": "阿诺德",
                    "text": "如果你们想找第二卷，得去高塔顶楼。"
                },
                {
                    "id": "400711531",
                    "speaker": "莫娜",
                    "text": "高塔，是那边那座吗？"
                },
                {
                    "id": "400711532",
                    "speaker": "阿诺德",
                    "text": "没错，那就是存放着圣典的塔楼。有条密道能让各位迅速抵达那里，只要你们在那边的山洞里仔细找找。"
                },
                {
                    "id": "400711533",
                    "speaker": "莫娜",
                    "text": "好，谢谢你阿诺德。"
                },
                {
                    "id": "400711534",
                    "speaker": "阿诺德",
                    "text": "是「渴望被问路的阿诺德」，不是阿诺德！"
                },
                {
                    "id": "400711535",
                    "speaker": "阿诺德",
                    "text": "美丽的女士，您没有其他话要问我了吗？有没有女朋友、每月收入情况什么的…"
                },
                {
                    "id": "400711536",
                    "speaker": "莫娜",
                    "text": "没有，再见！"
                },
                {
                    "id": "400711537",
                    "speaker": "莫娜",
                    "text": "别理那只夜鸦了。前面山洞里有密道，能直达塔顶，我们走吧。"
                },
                {
                    "id": "400711538",
                    "speaker": "阿诺德",
                    "text": "噢，噢女士！您当真对我不感兴趣？我可是看您如此美丽才愿意告诉您幽夜净土的秘密！女士！…"
                }
            ]
        },
        {
            "id": "4007199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400719902",
                    "speaker": "旁白",
                    "text": "「臣民欢呼朝拜皇女殿下的威能，遵循她呼唤，纷纷迁至该片后被称作『幽夜净土』的神圣国度之中。」"
                },
                {
                    "id": "400719903",
                    "speaker": "派蒙",
                    "text": "还真是幽夜净土啊！"
                },
                {
                    "id": "400719904",
                    "speaker": "莫娜",
                    "text": "看起来有模有样的，不错呢。"
                },
                {
                    "id": "400719905",
                    "speaker": "旁白",
                    "text": "「我等建立圣国，奉皇女殿下为至高之人，又将诗歌、戏剧与冒险带入国度，使之成为幽夜净土之纲要。」"
                }
            ]
        }
    ]
}