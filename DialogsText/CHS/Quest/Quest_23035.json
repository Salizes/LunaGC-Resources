    "talks": [
        {
            "id": "2303501",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230350101",
                    "speaker": "福本",
                    "text": "唉，好想回稻妻…我怎么会遇见这种事…",
                    "choices": [
                        {
                            "id": "230350102",
                            "text": "你怎么了？",
                            "response": [
                                {
                                    "id": "230350104",
                                    "speaker": "福本",
                                    "text": "旅行者？唉，别提小说了，我觉得那群做「七圣召唤」的人都要撑不住了。"
                                },
                                {
                                    "id": "230350105",
                                    "speaker": "福本",
                                    "text": "据那个和我关系还可以的学者说，做「七圣召唤」的时候，他们遇见了各种各样堪称莫名其妙的问题…"
                                },
                                {
                                    "id": "230350106",
                                    "speaker": "福本",
                                    "text": "比如，一个室罗婆耽学院的学者有一天突然提出了一个问题。"
                                },
                                {
                                    "id": "230350107",
                                    "speaker": "福本",
                                    "text": "他说，卡面上的卡牌效果描述太长，也许会让不习惯阅读长文本的人不想玩「七圣召唤」。"
                                },
                                {
                                    "id": "230350108",
                                    "speaker": "福本",
                                    "text": "学者们都习惯阅读长文本，对这个问题不敏感。但也许会有玩家不喜欢读长文本，甚至因此不玩「七圣召唤」。"
                                },
                                {
                                    "id": "230350109",
                                    "speaker": "福本",
                                    "text": "所以他建议，能不能把部分卡牌上的文本字数缩减一半，以方便玩家阅读。",
                                    "choices": [
                                        {
                                            "id": "230350110",
                                            "text": "需，需要这么做吗？",
                                            "response": [
                                                {
                                                    "id": "230350112",
                                                    "speaker": "福本",
                                                    "text": "我是觉得这根本就不是问题…但学者们还在认真研究这个问题。毕竟事关玩家们的体验，他们是一点问题都不想出。"
                                                },
                                                {
                                                    "id": "230350113",
                                                    "speaker": "福本",
                                                    "text": "唉，不说这些了…现在更大的问题是，他们之前承诺帮我找模特这件事也出问题了。"
                                                },
                                                {
                                                    "id": "230350114",
                                                    "speaker": "福本",
                                                    "text": "之前我不是和你说过，有一位学者说，他们会帮我联系提纳里先生和赛诺先生，并且拜托这两位当模特吗？"
                                                },
                                                {
                                                    "id": "230350115",
                                                    "speaker": "福本",
                                                    "text": "但他们忙成这样，我觉得暂时不能指望他们了…",
                                                    "choices": [
                                                        {
                                                            "id": "230350116",
                                                            "text": "那怎么办？",
                                                            "response": [
                                                                {
                                                                    "id": "230350118",
                                                                    "speaker": "福本",
                                                                    "text": "接待我的那个学者虽然也没法帮我办这件事，但他给我出了一个主意。"
                                                                },
                                                                {
                                                                    "id": "230350119",
                                                                    "speaker": "福本",
                                                                    "text": "他说，赛诺先生有时候会去普斯帕咖啡馆打牌。"
                                                                },
                                                                {
                                                                    "id": "230350120",
                                                                    "speaker": "福本",
                                                                    "text": "如果我愿意的话…可以先去那家咖啡馆碰碰运气。或者，是等他们有空之后再帮我联系。"
                                                                },
                                                                {
                                                                    "id": "230350121",
                                                                    "speaker": "Player",
                                                                    "text": "那你…"
                                                                },
                                                                {
                                                                    "id": "230350122",
                                                                    "speaker": "福本",
                                                                    "text": "唉，等他们有空的时候，我小说正文都要写完了。"
                                                                },
                                                                {
                                                                    "id": "230350123",
                                                                    "speaker": "福本",
                                                                    "text": "所以，我还是自力更生，看能不能自己找到那位赛诺先生吧。"
                                                                },
                                                                {
                                                                    "id": "230350124",
                                                                    "speaker": "福本",
                                                                    "text": "但就算我运气好，在咖啡馆遇见了赛诺先生，又怎么才能和赛诺先生搭上话呢？真是头疼…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230350128",
                                                                            "text": "我能帮忙。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230350130",
                                                                                    "speaker": "福本",
                                                                                    "text": "真的？！太好了！但你是怎么…呃，算了，我就不问这些问题了。"
                                                                                },
                                                                                {
                                                                                    "id": "230350131",
                                                                                    "speaker": "福本",
                                                                                    "text": "那事不宜迟，咱们赶紧去普斯帕咖啡馆吧。希望能遇见赛诺先生…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230350129",
                                                                            "text": "我和赛诺很熟啦。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230350117",
                                                            "text": "那要怎么联系？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230350111",
                                            "text": "其实也长不到哪去吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230350103",
                            "text": "小说写得不顺利吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303502",
            "objective": "前往普斯帕咖啡馆",
            "dialogues": []
        },
        {
            "id": "2303503",
            "objective": "前往普斯帕咖啡馆与福本会合",
            "dialogues": [
                {
                    "id": "230350301",
                    "speaker": "福本",
                    "text": "嘘…那，那是不是赛诺先生？"
                },
                {
                    "id": "230350302",
                    "speaker": "福本",
                    "text": "看他的装扮，看他的发型，还有那个发色…简直是卡牌游戏小说的最佳主角啊！",
                    "choices": [
                        {
                            "id": "230350303",
                            "text": "完全没有道理…",
                            "response": [
                                {
                                    "id": "230350304",
                                    "speaker": "福本",
                                    "text": "哎呀，你就相信我在小说市场里的直觉吧。但现在不是说这个的时候…"
                                },
                                {
                                    "id": "230350309",
                                    "speaker": "福本",
                                    "text": "旅行者，请赛诺先生为我做模特的事…就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "230350305",
                            "text": "那我还认识蛮多这种主角的…",
                            "response": [
                                {
                                    "id": "230350306",
                                    "speaker": "福本",
                                    "text": "真的吗？那正好啊，我正在筹备《召唤王》的第三部小说，这次我不打算根据「七圣召唤」的玩法写了。"
                                },
                                {
                                    "id": "230350307",
                                    "speaker": "福本",
                                    "text": "我决定要完全原创一种对战方式，比如…所有卡牌都悬浮在场地里，牌手要一边对战一边不断搜集卡牌，同时还要阻止对手搜集卡牌…"
                                },
                                {
                                    "id": "230350308",
                                    "speaker": "福本",
                                    "text": "哈哈哈！光是想想就觉得很有意思！但现在不是说这个的时候…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303504",
            "objective": "与赛诺对话",
            "dialogues": [
                {
                    "id": "230350401",
                    "speaker": "赛诺",
                    "text": "…唔，这样的卡牌组合也许不错。"
                },
                {
                    "id": "230350402",
                    "speaker": "赛诺",
                    "text": "但这些卡牌，应对快速进攻的能力是不是太弱了…"
                },
                {
                    "id": "230350403",
                    "speaker": "Player",
                    "text": "赛诺，你在做什么呢？"
                },
                {
                    "id": "230350404",
                    "speaker": "赛诺",
                    "text": "#{NICKNAME}？没想到会在这里遇见你。"
                },
                {
                    "id": "230350405",
                    "speaker": "赛诺",
                    "text": "我正在试着构筑一套进攻速度偏慢的「七圣召唤」卡组呢。"
                },
                {
                    "id": "230350406",
                    "speaker": "赛诺",
                    "text": "在我的设想里，使用这套卡牌的牌手会拥有丰富的资源，和各类强大的卡牌…"
                },
                {
                    "id": "230350407",
                    "speaker": "赛诺",
                    "text": "但说实话，这样的卡组还挺难构筑的…"
                },
                {
                    "id": "230350408",
                    "speaker": "赛诺",
                    "text": "现在「七圣召唤」的玩家群体里，一部分玩家喜欢使用进攻速度偏快的卡组。"
                },
                {
                    "id": "230350409",
                    "speaker": "赛诺",
                    "text": "在游戏刚开始的时候，就一口气打出大量的卡牌发动攻击，用最快的速度击败对手。"
                },
                {
                    "id": "230350410",
                    "speaker": "赛诺",
                    "text": "不过我却不喜欢这种战术。我喜欢的对决战术，是不断用各种方式积蓄资源…"
                },
                {
                    "id": "230350411",
                    "speaker": "赛诺",
                    "text": "把握住每一个时机，不断累积优势，稳稳地取得最后的胜利…"
                },
                {
                    "id": "230350412",
                    "speaker": "福本",
                    "text": "没错！就是这样！太好了，太好了！您简直和我小说里的主角一模一样！"
                },
                {
                    "id": "230350413",
                    "speaker": "福本",
                    "text": "抱歉！呃…我是…",
                    "choices": [
                        {
                            "id": "230350414",
                            "text": "这位是福本。",
                            "response": [
                                {
                                    "id": "230350416",
                                    "speaker": "福本",
                                    "text": "您好，大风纪官，那个…我猜您应该没听说过我…"
                                },
                                {
                                    "id": "230350417",
                                    "speaker": "赛诺",
                                    "text": "我看过你写的小说，很不错。"
                                },
                                {
                                    "id": "230350418",
                                    "speaker": "福本",
                                    "text": "那真是荣幸！"
                                },
                                {
                                    "id": "230350419",
                                    "speaker": "赛诺",
                                    "text": "这部小说最让我印象深刻的是，小说主角每次陷入劣势的时候，总是会通过各种方式取得并不存在于卡组里的卡，然后再克敌制胜。"
                                },
                                {
                                    "id": "230350420",
                                    "speaker": "赛诺",
                                    "text": "我理解这是情节需要，但这种获胜方式无疑有些背离了「七圣召唤」的游戏本质。"
                                },
                                {
                                    "id": "230350421",
                                    "speaker": "福本",
                                    "text": "哎呀，这个…我虽然经常玩「七圣召唤」，但玩的水平也并不高…而且，如果真的用竞技思维来写小说里的卡牌对决，那写出来也不会太好看啊。"
                                },
                                {
                                    "id": "230350422",
                                    "speaker": "赛诺",
                                    "text": "唔，这样吗？那么正好，我刚刚组好了两套卡组，我们可以在这里打几盘「七圣召唤」，你说不定能找到一些灵感。",
                                    "choices": [
                                        {
                                            "id": "230350423",
                                            "text": "（突然就开始要打牌了…）",
                                            "response": [
                                                {
                                                    "id": "230350425",
                                                    "speaker": "福本",
                                                    "text": "欸？和，和您打牌？我十分乐意，但其实…",
                                                    "choices": [
                                                        {
                                                            "id": "230350426",
                                                            "text": "我来说吧。"
                                                        },
                                                        {
                                                            "id": "230350427",
                                                            "text": "关于福本的请求…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230350424",
                                            "text": "（这人不会就是单纯想打牌了吧…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230350415",
                            "text": "这位是小说《召唤王》的作者。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303505",
            "objective": "为赛诺拍摄画片",
            "dialogues": [
                {
                    "id": "230350501",
                    "speaker": "Black Screen",
                    "text": "飞快地给赛诺拍摄了数张画片…"
                }
            ]
        },
        {
            "id": "2303506",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230350601",
                    "speaker": "福本",
                    "text": "真是帮大忙了，这下朝雾小姐一定能画出一幅很棒的插画！"
                },
                {
                    "id": "230350602",
                    "speaker": "福本",
                    "text": "太感谢您了，赛诺先生，等这本小说出版了之后，我一定尽快给您送一本来。"
                },
                {
                    "id": "230350603",
                    "speaker": "福本",
                    "text": "呃，赛诺先生，您手里拿着的两副牌是…"
                },
                {
                    "id": "230350604",
                    "speaker": "赛诺",
                    "text": "之前你不是答应了，要和我打几盘「七圣召唤」吗？"
                },
                {
                    "id": "230350605",
                    "speaker": "福本",
                    "text": "啊？！我，我玩得不是非常好，那个…旅行者！你一定玩得比我好！",
                    "choices": [
                        {
                            "id": "230350606",
                            "text": "我没玩过。",
                            "response": [
                                {
                                    "id": "230350608",
                                    "speaker": "赛诺",
                                    "text": "那这件事就这么定了，来，这副偏向于快速攻击的卡组给你。"
                                },
                                {
                                    "id": "230350609",
                                    "speaker": "赛诺",
                                    "text": "而我就用这套进攻速度偏慢的牌，来看看怎么应对你的攻击。"
                                },
                                {
                                    "id": "230350610",
                                    "speaker": "福本",
                                    "text": "我一定尽最大的努力，赛诺先生…"
                                }
                            ]
                        },
                        {
                            "id": "230350607",
                            "text": "你比我强。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230350701",
                    "speaker": "福本",
                    "text": "赛诺先生，您打牌的风格可真是…稳扎稳打啊…"
                },
                {
                    "id": "230350702",
                    "speaker": "赛诺",
                    "text": "这只是一种临场的对决策略而已。"
                }
            ]
        }
    ]
}