    "talks": [
        {
            "id": "4003413",
            "objective": "等到第二天白天（6点到18点）",
            "dialogues": []
        },
        {
            "id": "4003401",
            "objective": "前往万端珊瑚侦探社",
            "dialogues": [
                {
                    "id": "400340102",
                    "speaker": "珊瑚",
                    "text": "嗯，你们果然来了。"
                },
                {
                    "id": "400340103",
                    "speaker": "珊瑚",
                    "text": "龙二的话，按照目前收集到的线索和我的推理，他已经去八酝岛调查了。"
                },
                {
                    "id": "400340104",
                    "speaker": "珊瑚",
                    "text": "我把方位标记在你的地图上，如果你赶紧动身，应该还可以和他会合。"
                },
                {
                    "id": "400340105",
                    "speaker": "派蒙",
                    "text": "怎么突然这么急急忙忙的，之前不还在侦探社等我们一起的吗？"
                },
                {
                    "id": "400340106",
                    "speaker": "珊瑚",
                    "text": "因为已经接近尾声了。你们也快点动身，一同见证真相的浮现吧。"
                },
                {
                    "id": "400340107",
                    "speaker": "派蒙",
                    "text": "#这么一说，我也有点迫不及待了。我们快走吧，{NICKNAME}。"
                }
            ]
        },
        {
            "id": "4003402",
            "objective": "寻找龙二并与龙二对话",
            "dialogues": [
                {
                    "id": "400340201",
                    "speaker": "派蒙",
                    "text": "龙二！我们来了！"
                },
                {
                    "id": "400340202",
                    "speaker": "龙二",
                    "text": "啊，是你们。珊瑚社长让我先过来调查，说你们晚点就会过来。果然如此。"
                },
                {
                    "id": "400340203",
                    "speaker": "派蒙",
                    "text": "还多亏了她告诉我们，你在这里呢！龙二调查得怎么样啦？"
                },
                {
                    "id": "400340204",
                    "speaker": "派蒙",
                    "text": "咦，这里怎么都是些关着小动物的笼子，没有人吗？"
                },
                {
                    "id": "400340205",
                    "speaker": "龙二",
                    "text": "刚刚走开了，是盗宝团。珊瑚社长告诉我，他们打算偷狗来训练成「寻宝犬」。",
                    "choices": [
                        {
                            "id": "400340206",
                            "text": "就像盗宝鼬？",
                            "response": [
                                {
                                    "id": "400340207",
                                    "speaker": "龙二",
                                    "text": "没错，就像盗宝鼬。只不过鼬因为太过调皮，不服管教，所以失败了。这次，他们就以更加忠心的「狗」为目标。"
                                },
                                {
                                    "id": "400340210",
                                    "speaker": "龙二",
                                    "text": "以前处理过不少盗宝团的相关委托。这么一想，珊瑚社长说得果然没错。"
                                },
                                {
                                    "id": "400340211",
                                    "speaker": "龙二",
                                    "text": "就像人有脚印，组织也会留下自己独有的痕迹。整个事件中，虽然有着其他迷失、被困的小动物，但痕迹最终还是指向了盗宝团。"
                                },
                                {
                                    "id": "400340212",
                                    "speaker": "龙二",
                                    "text": "参考了一下当时的解决办法，然后我就调查到了这里。"
                                },
                                {
                                    "id": "400340213",
                                    "speaker": "龙二",
                                    "text": "不过居然不派个人留守，比起之前的案件，这次的作案者们心也太大了。"
                                },
                                {
                                    "id": "400340214",
                                    "speaker": "派蒙",
                                    "text": "#嗯，真是一群心大的坏家伙！不过嘛，{NICKNAME}，你打了这么多天架也累了吧？",
                                    "choices": [
                                        {
                                            "id": "400340215",
                                            "text": "所以趁他们不在…",
                                            "response": [
                                                {
                                                    "id": "400340217",
                                                    "speaker": "派蒙",
                                                    "text": "没错，就这么办吧！嘿嘿，我们好默契哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400340216",
                                            "text": "我们偷偷把它们给救出来？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400340208",
                            "text": "就像派蒙？",
                            "response": [
                                {
                                    "id": "400340209",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4003403",
            "objective": "打开笼子",
            "dialogues": []
        },
        {
            "id": "4003404",
            "objective": "打开笼子以后",
            "dialogues": [
                {
                    "id": "400340401",
                    "speaker": "派蒙",
                    "text": "奇怪，这只狗狗怎么不走？"
                },
                {
                    "id": "400340402",
                    "speaker": "派蒙",
                    "text": "是病了吗？"
                }
            ]
        },
        {
            "id": "4003405",
            "objective": "击败盗宝团",
            "dialogues": []
        },
        {
            "id": "4003406",
            "objective": "奇怪的狗狗",
            "dialogues": [
                {
                    "id": "400340601",
                    "speaker": "？？？",
                    "text": "……"
                },
                {
                    "id": "400340602",
                    "speaker": "？？？",
                    "text": "汪呜！"
                },
                {
                    "id": "400340603",
                    "speaker": "派蒙",
                    "text": "这、这是…",
                    "choices": [
                        {
                            "id": "400340604",
                            "text": "帽子狗。",
                            "response": [
                                {
                                    "id": "400340605",
                                    "speaker": "派蒙",
                                    "text": "才不是啦！这算什么外号啦！"
                                },
                                {
                                    "id": "400340609",
                                    "speaker": "龙二",
                                    "text": "不管怎么说，好像没有攻击我们的意思…"
                                },
                                {
                                    "id": "400340610",
                                    "speaker": "？？？",
                                    "text": "汪汪——"
                                },
                                {
                                    "id": "400340611",
                                    "speaker": "派蒙",
                                    "text": "呜哇，它跑了。"
                                },
                                {
                                    "id": "400340612",
                                    "speaker": "龙二",
                                    "text": "边跑边回头看我们，或许是让我们跟上去的意思？"
                                },
                                {
                                    "id": "400340613",
                                    "speaker": "Player",
                                    "text": "我们快跟上吧。"
                                },
                                {
                                    "id": "400340614",
                                    "speaker": "龙二",
                                    "text": "嗯，说不定真相就在前面…或许就如同珊瑚社长预料的那样…"
                                }
                            ]
                        },
                        {
                            "id": "400340606",
                            "text": "刀子狗。",
                            "response": [
                                {
                                    "id": "400340607",
                                    "speaker": "龙二",
                                    "text": "是帽子狗才对！"
                                }
                            ]
                        },
                        {
                            "id": "400340608",
                            "text": "黑影。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4003407",
            "objective": "跟上跑开的狗狗",
            "dialogues": []
        },
        {
            "id": "4003411",
            "objective": "读信",
            "dialogues": [
                {
                    "id": "400341101",
                    "speaker": "派蒙",
                    "text": "呼——终于追上了。"
                },
                {
                    "id": "400341102",
                    "speaker": "龙二",
                    "text": "嗯？它面前的是…一封信？"
                },
                {
                    "id": "400341103",
                    "speaker": "龙二",
                    "text": "我们先看看吧，这是目前唯一的线索了。"
                },
                {
                    "id": "400341104",
                    "speaker": "派蒙",
                    "text": "嗯！让我看看，里面写的是什么……"
                },
                {
                    "id": "400341105",
                    "speaker": "派蒙",
                    "text": "「致有缘…」呃，太破了看不清楚。"
                },
                {
                    "id": "400341106",
                    "speaker": "龙二",
                    "text": "可能是「致有缘之人」吧。"
                },
                {
                    "id": "400341107",
                    "speaker": "派蒙",
                    "text": "哦哦，然后是…「我们家是专门训练忍犬的世家，为忍者们带来了许许多多可靠的伙伴。」"
                },
                {
                    "id": "400341108",
                    "speaker": "派蒙",
                    "text": "「……此番征兵令下来，怕是凶多吉少。我此生没什么遗憾，唯一放心不下的只有影狼丸。」"
                },
                {
                    "id": "400341109",
                    "speaker": "派蒙",
                    "text": "「小时候，它太弱了，所以忍者们来进行契约的时候，它被剩了下来。但是没关系，身为训练师，我不会放弃任何一只狗。」"
                },
                {
                    "id": "400341110",
                    "speaker": "派蒙",
                    "text": "「经过日复一日的努力，影狼丸真的变得越来越厉害了。只可惜，它完全不想和任何忍者契约。」"
                },
                {
                    "id": "400341111",
                    "speaker": "派蒙",
                    "text": "「虽然战争还未开始，但奉行所的催促越来越急，我已无暇顾及其他，现在到了不得不离开的时候了。」"
                },
                {
                    "id": "400341112",
                    "speaker": "派蒙",
                    "text": "「只好留下这一封信，若是日后有人能找到这里，请代替我照顾一下影狼丸。」"
                },
                {
                    "id": "400341113",
                    "speaker": "派蒙",
                    "text": "「它脸上有一道疤痕，是年幼时留下的，气场也与其他普通狗狗不同，很好辨认。」"
                },
                {
                    "id": "400341114",
                    "speaker": "龙二",
                    "text": "信里说的这只影狼丸应该就是…"
                },
                {
                    "id": "400341115",
                    "speaker": "Player",
                    "text": "带我们来的这只。"
                },
                {
                    "id": "400341116",
                    "speaker": "派蒙",
                    "text": "确实很好辨认呢！信上还有行内容，我看看…"
                },
                {
                    "id": "400341117",
                    "speaker": "派蒙",
                    "text": "「我知道这是不情之请，但也实在没有别的办法。还有，若是今后它愿意契约了，能带着自己中意的人来到这里的话，那么契约方法是…」"
                },
                {
                    "id": "400341118",
                    "speaker": "派蒙",
                    "text": "哎呀，最重要的地方怎么划掉了！"
                },
                {
                    "id": "400341119",
                    "speaker": "Player",
                    "text": "大概是觉得不可能吧。"
                },
                {
                    "id": "400341120",
                    "speaker": "龙二",
                    "text": "的确，毕竟一开始影狼丸完全不想和人契约。"
                },
                {
                    "id": "400341121",
                    "speaker": "影狼丸",
                    "text": "汪汪——"
                },
                {
                    "id": "400341122",
                    "speaker": "派蒙",
                    "text": "#欸，它怎么又突然跑掉了，还往屋子里跑了。{NICKNAME}，快跟上吧。"
                }
            ]
        },
        {
            "id": "4003408",
            "objective": "跟上再次跑开的影狼丸",
            "dialogues": []
        },
        {
            "id": "4003412",
            "objective": "击败影狼丸",
            "dialogues": []
        },
        {
            "id": "4003409",
            "objective": "与龙二对话",
            "dialogues": [
                {
                    "id": "400340901",
                    "speaker": "派蒙",
                    "text": "#呼，总算结束了。真是搞不懂，怎么突然就开始战斗了，明明影狼丸之前看起来还挺友好的，还好有{NICKNAME}在。"
                },
                {
                    "id": "400340902",
                    "speaker": "派蒙",
                    "text": "#咦，为什么影狼丸会跟着{NICKNAME}？"
                },
                {
                    "id": "400340903",
                    "speaker": "影狼丸",
                    "text": "汪呜汪呜！"
                },
                {
                    "id": "400340904",
                    "speaker": "Player",
                    "text": "这叫声好像听起来有点高兴？"
                },
                {
                    "id": "400340905",
                    "speaker": "派蒙",
                    "text": "你怎么听出来的！我还一头雾水呢！"
                },
                {
                    "id": "400340906",
                    "speaker": "龙二",
                    "text": "#如果我的猜想没错的话，影狼丸应该已经成为{NICKNAME}的忍犬了。"
                },
                {
                    "id": "400340907",
                    "speaker": "派蒙",
                    "text": "欸！"
                },
                {
                    "id": "400340908",
                    "speaker": "Player",
                    "text": "欸！"
                },
                {
                    "id": "400340909",
                    "speaker": "龙二",
                    "text": "关于忍犬的契约方法，我也只是略有耳闻罢了。据说忍者看中忍犬后，需要打败它，才能得到忍犬的认可。"
                },
                {
                    "id": "400340910",
                    "speaker": "龙二",
                    "text": "忍者渴望强大的伙伴，忍犬也是一样的，只有互相认可，才能完成契约。看来确实是这样子。"
                },
                {
                    "id": "400340911",
                    "speaker": "派蒙",
                    "text": "#可是{NICKNAME}又不是忍者…而且…"
                },
                {
                    "id": "400340912",
                    "speaker": "派蒙",
                    "text": "呜。"
                },
                {
                    "id": "400340913",
                    "speaker": "Player",
                    "text": "派蒙怎么了？"
                },
                {
                    "id": "400340914",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你先同意答应我一件事情！"
                },
                {
                    "id": "400340915",
                    "speaker": "Player",
                    "text": "什么事情？"
                },
                {
                    "id": "400340916",
                    "speaker": "派蒙",
                    "text": "你先说答应嘛！"
                },
                {
                    "id": "400340917",
                    "speaker": "Player",
                    "text": "好吧，我答应你。"
                },
                {
                    "id": "400340918",
                    "speaker": "派蒙",
                    "text": "就算你现在已经契约了影狼丸，你也不能忘记派蒙是你最最最好的伙伴哦！"
                },
                {
                    "id": "400340919",
                    "speaker": "Player",
                    "text": "嗯，派蒙是我最好的伙伴。"
                },
                {
                    "id": "400340920",
                    "speaker": "派蒙",
                    "text": "太好了！",
                    "choices": [
                        {
                            "id": "400340921",
                            "text": "比起猫和狗…",
                            "response": [
                                {
                                    "id": "400340923",
                                    "speaker": "派蒙",
                                    "text": "欸嘿嘿。我们永远都是最最最好的伙伴！"
                                },
                                {
                                    "id": "400340924",
                                    "speaker": "龙二",
                                    "text": "咳咳，两位关系真好…"
                                },
                                {
                                    "id": "400340925",
                                    "speaker": "龙二",
                                    "text": "不过话又说回来，既然影狼丸实力那么强，为什么之前那个人还要留信下来，让别人照顾它呢？"
                                },
                                {
                                    "id": "400340926",
                                    "speaker": "派蒙",
                                    "text": "#这个我知道哦！{NICKNAME}，很强对吧。"
                                },
                                {
                                    "id": "400340927",
                                    "speaker": "龙二",
                                    "text": "确实实力超群。"
                                },
                                {
                                    "id": "400340928",
                                    "speaker": "派蒙",
                                    "text": "#但是如果有一天，万一有什么意外，我不得不和{NICKNAME}分开，我也会很担心的。这和{NICKNAME}强不强，其实没什么关系啦。"
                                },
                                {
                                    "id": "400340929",
                                    "speaker": "派蒙",
                                    "text": "#呸呸，我在说什么不吉利的事情！总之只是打个比方！我和{NICKNAME}是最好的伙伴，我们是不会分开的！"
                                },
                                {
                                    "id": "400340930",
                                    "speaker": "Player",
                                    "text": "派蒙…"
                                },
                                {
                                    "id": "400340931",
                                    "speaker": "龙二",
                                    "text": "派蒙的推理很合理。那么接下来唯一的问题是，为什么这只狗狗会偷走村民们的小动物，并守着呢？"
                                },
                                {
                                    "id": "400340932",
                                    "speaker": "派蒙",
                                    "text": "呃…唔…这个机智的派蒙也想不出来了。"
                                },
                                {
                                    "id": "400340933",
                                    "speaker": "派蒙",
                                    "text": "#可惜，影狼丸也没办法说话，不然让{NICKNAME}去问问就知道了。"
                                },
                                {
                                    "id": "400340934",
                                    "speaker": "Player",
                                    "text": "我们去找找珊瑚吧。"
                                },
                                {
                                    "id": "400340935",
                                    "speaker": "派蒙",
                                    "text": "对哦，还有珊瑚！这个时候总该轮到头脑派出场了，我们去找她吧！"
                                },
                                {
                                    "id": "400340936",
                                    "speaker": "龙二",
                                    "text": "嗯，我先去把藏起来的小动物还回去，我们到时候侦探社汇合吧。"
                                }
                            ]
                        },
                        {
                            "id": "400340922",
                            "text": "还是派蒙更可靠。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4003410",
            "objective": "向珊瑚回报",
            "dialogues": [
                {
                    "id": "400341001",
                    "speaker": "龙二",
                    "text": "珊瑚社长，我们回来了，事情是这样子的……"
                },
                {
                    "id": "400341002",
                    "speaker": "珊瑚",
                    "text": "原来如此。我大概知道为什么影狼丸会守着小动物了。"
                },
                {
                    "id": "400341003",
                    "speaker": "珊瑚",
                    "text": "是想要带着其他小动物变强吧。"
                },
                {
                    "id": "400341004",
                    "speaker": "珊瑚",
                    "text": "它小的时候很弱，然后又变强了，对吧。所以它就想通过训练，也带着别的小动物变强。"
                },
                {
                    "id": "400341005",
                    "speaker": "珊瑚",
                    "text": "后来它看到愿意保护弱小的旅行者之后，又认可了旅行者作为主人。"
                },
                {
                    "id": "400341006",
                    "speaker": "珊瑚",
                    "text": "这也是出于它对弱小的同情心。"
                },
                {
                    "id": "400341007",
                    "speaker": "珊瑚",
                    "text": "不过这只是我通过线索进行的推理罢了。"
                },
                {
                    "id": "400341008",
                    "speaker": "珊瑚",
                    "text": "至于真实情况嘛，应该也八九不离十了。但由于影狼丸不会说话，我们也没办法得到一个肯定的回答了。"
                },
                {
                    "id": "400341009",
                    "speaker": "派蒙",
                    "text": "珊瑚说话也很有道理呢！不愧是头脑派。"
                },
                {
                    "id": "400341010",
                    "speaker": "影狼丸",
                    "text": "汪汪汪！"
                },
                {
                    "id": "400341011",
                    "speaker": "派蒙",
                    "text": "呜哇，你也是在肯定珊瑚说的话吗？"
                },
                {
                    "id": "400341012",
                    "speaker": "珊瑚",
                    "text": "不要以为奉承我，下次你们有委托的时候我就会打折哦。不过呢，这个案子算是办结了。"
                },
                {
                    "id": "400341013",
                    "speaker": "龙二",
                    "text": "#感谢{NICKNAME}和派蒙，多亏了你们才能办结这个案子。"
                },
                {
                    "id": "400341014",
                    "speaker": "珊瑚",
                    "text": "哦，差点忘了，「四方之网」你们用着感觉如何？",
                    "choices": [
                        {
                            "id": "400341015",
                            "text": "挺好用的。",
                            "response": [
                                {
                                    "id": "400341017",
                                    "speaker": "珊瑚",
                                    "text": "嗯，我记下来了。我会和我的那位朋友说的，谢啦。"
                                },
                                {
                                    "id": "400341018",
                                    "speaker": "派蒙",
                                    "text": "#不客气！以后有什么困难，随时来找我们哦！{NICKNAME}可厉害了！"
                                },
                                {
                                    "id": "400341019",
                                    "speaker": "珊瑚",
                                    "text": "旅行者确实实力不俗，但是不用和我说这些客套话，毕竟感情是真相的敌人。"
                                }
                            ]
                        },
                        {
                            "id": "400341016",
                            "text": "总担心它会破掉…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4003451",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400345101",
                    "speaker": "珊瑚",
                    "text": "这次的事件，已经快落下帷幕了…"
                },
                {
                    "id": "400345102",
                    "speaker": "珊瑚",
                    "text": "应该叫什么名字好呢…「幻影犬主」？还是「盗宝团十二面相」…"
                },
                {
                    "id": "400345103",
                    "speaker": "珊瑚",
                    "text": "给事件取名真难。下次去拜托八重堂的人好了。"
                }
