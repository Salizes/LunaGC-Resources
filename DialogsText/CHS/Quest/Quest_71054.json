    },
    "talks": [
        {
            "id": "7105401",
            "objective": "test隐藏-预先接取的任务$HIDDEN",
            "dialogues": [
                {
                    "id": "710540101",
                    "speaker": "？？？",
                    "text": "停手，停手！请听我们解释！！"
                },
                {
                    "id": "710540102",
                    "speaker": "派蒙",
                    "text": "你们不是盗宝团吗？乖乖去自首就好啦，有什么好解释的！"
                },
                {
                    "id": "710540103",
                    "speaker": "彦博",
                    "text": "#千岩军，层岩巨渊辖区，中队长彦博。很高兴见到你们，{NICKNAME}。"
                },
                {
                    "id": "710540104",
                    "speaker": "彦博",
                    "text": "呃…和…很有名的小飞侠。"
                },
                {
                    "id": "710540105",
                    "speaker": "派蒙",
                    "text": "喂，怎么到我这里就忘了名字啦！我是派蒙！"
                },
                {
                    "id": "710540106",
                    "speaker": "彦博",
                    "text": "哈哈…失礼、失礼。实在不好意思…但我们大概产生了一点小误会。",
                    "choices": [
                        {
                            "id": "710540107",
                            "text": "等等…你们不是盗宝团？",
                            "response": [
                                {
                                    "id": "710540108",
                                    "speaker": "彦博",
                                    "text": "当然不是，恰恰相反。"
                                },
                                {
                                    "id": "710540112",
                                    "speaker": "彦博",
                                    "text": "咳咳，这么说吧。这处作坊以前确实是盗宝团占据的据点没错。"
                                },
                                {
                                    "id": "710540113",
                                    "speaker": "彦博",
                                    "text": "工人撤走以后，那些见缝就钻的家伙就进来了…一开始还只是盗采矿石和琉璃晶砂搞走私，和我们的巡逻队玩捉迷藏。"
                                },
                                {
                                    "id": "710540114",
                                    "speaker": "彦博",
                                    "text": "后来他们贼胆越来越大，居然敢占据矿工留下的旧仓库，自己打造廉价的破烂首饰拿出去卖了！唉，真是…让人看了心疼呀。"
                                },
                                {
                                    "id": "710540115",
                                    "speaker": "Player",
                                    "text": "让人看了心疼？"
                                },
                                {
                                    "id": "710540116",
                                    "speaker": "彦博",
                                    "text": "这么粗糙的首饰只能骗骗第一次来璃月的游客，或者没见识的读书人吧…要想以低价打入璃月的市场？哼，恐怕是要砸牌子了。"
                                },
                                {
                                    "id": "710540117",
                                    "speaker": "派蒙",
                                    "text": "他们本来也没有牌子呀！"
                                },
                                {
                                    "id": "710540118",
                                    "speaker": "彦博",
                                    "text": "哈哈，你说的没错。拿这些东西牟利发财，也太没品位了…"
                                },
                                {
                                    "id": "710540119",
                                    "speaker": "彦博",
                                    "text": "所以我们来了，收拾了原来占据这里的盗宝团，装扮成他们的样子潜伏在了这里…嗯，已经是前段时间的事情了。"
                                },
                                {
                                    "id": "710540120",
                                    "speaker": "彦博",
                                    "text": "现在我们又摸清他们的头目们与「愚人众」的一支部队有联络，疑似在交易什么危险物资。",
                                    "choices": [
                                        {
                                            "id": "710540121",
                                            "text": "关于愚人众与盗宝团的联络…",
                                            "response": [
                                                {
                                                    "id": "710540122",
                                                    "speaker": "彦博",
                                                    "text": "尽管之前我们挫败了愚人众的图谋，但他们在璃月的野外仍存在一些残党活动…这些家伙的专业性和战斗力都不容小觑，对我们来说极其危险。"
                                                },
                                                {
                                                    "id": "710540123",
                                                    "speaker": "彦博",
                                                    "text": "假如盗宝团和他们沆瀣一气，勾结起来对抗我们的话…会是一个很让人头疼的安全问题。"
                                                },
                                                {
                                                    "id": "710540126",
                                                    "speaker": "彦博",
                                                    "text": "总之，我们万事俱备，只欠总攻。只需要把他们一锅端，就能搞清楚他们在捣什么鬼了。"
                                                },
                                                {
                                                    "id": "710540127",
                                                    "speaker": "派蒙",
                                                    "text": "结果没想到我们来了…"
                                                },
                                                {
                                                    "id": "710540128",
                                                    "speaker": "彦博",
                                                    "text": "唉…我们知道你们很厉害，但没想到这么能打…现在可好，你们把我的队伍打趴下了一大半…"
                                                },
                                                {
                                                    "id": "710540129",
                                                    "speaker": "彦博",
                                                    "text": "当然啦，我们驻扎在这里另有一个原因是…此处恰好坐落了一座「七星阵法」的「磐键」。我们可不能让它落在盗宝团这群心术不正的家伙手里。",
                                                    "choices": [
                                                        {
                                                            "id": "710540130",
                                                            "text": "唔…抱歉。",
                                                            "response": [
                                                                {
                                                                    "id": "710540131",
                                                                    "speaker": "彦博",
                                                                    "text": "哈哈哈，没关系！我们没看出是你们，是我们的过错…此前就有命令下来要我为你们让路，结果谁能想到你们这么快就来了！"
                                                                },
                                                                {
                                                                    "id": "710540134",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇…千岩军的大哥原来这么好说话的！那我们可以走了吧？"
                                                                },
                                                                {
                                                                    "id": "710540135",
                                                                    "speaker": "彦博",
                                                                    "text": "我不怪你们，不代表璃月的律法会放过你们。嘿嘿，实在抱歉。"
                                                                },
                                                                {
                                                                    "id": "710540136",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸——！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710540137",
                                                                            "text": "下次请把话说完！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710540139",
                                                                                    "speaker": "彦博",
                                                                                    "text": "嗯…让我看看：寻衅滋事；干扰千岩军公务；蓄意破坏「七星阵法」；再加上一个…破坏既有现场…"
                                                                                },
                                                                                {
                                                                                    "id": "710540140",
                                                                                    "speaker": "彦博",
                                                                                    "text": "再减去千岩军当事人的谅解…如果一切顺利的话呢，恭喜二位客人，可以在璃月港多住五到十年了！"
                                                                                },
                                                                                {
                                                                                    "id": "710540141",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸？？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "710540142",
                                                                                            "text": "我可以请律师吗？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710540143",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "唔…请给我们律师名单！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540146",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "咳咳…但是…！请听我把话说完！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540147",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "但是，合法市民或国外旅客可以运用任何合法手段协助千岩军办案，并且获得应得的奖励或补偿…这也是璃月律法的规定。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540148",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "所以两位英雄，刚才那一架可不是白打的哦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540149",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "帮助你们的话，我们会获得什么？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540150",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "查封的赃物是不能随便动的，但如果两位愿意帮忙的话，抓捕过程中偶遇的财物…唔，比如「盗宝团的秘密宝藏！」之类的，由你们处理就好。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540151",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "另外呢，我和同僚们也凑了些摩拉，希望两位不会嫌弃…唉，毕竟这种意外而来的「帮助」，事先并没有算进预算里…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540152",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "唔…也就是说，我们不用坐大牢，还有宝贝拿！对吧？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540153",
                                                                                                    "speaker": "彦博",
                                                                                                    "text": "是的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710540154",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好！那我们就勉为其难地答应啦！请你带路吧！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "710540155",
                                                                                                            "text": "等等…！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "710540157",
                                                                                                                    "speaker": "彦博",
                                                                                                                    "text": "好了，就请两位英雄不必客气啦…我先去集结点待命了，还望你们一定跟上来，不然我们可要提前行动咯。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "710540158",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "对呀，我们快跟上吧！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "710540159",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "喂…！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "710540160",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "快点啦，我们这是在协助千岩军办案呢！而且不是也有好多摩拉拿嘛！"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "710540156",
                                                                                                            "text": "我还没…！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "710540144",
                                                                                            "text": "早知道不如下手更重一点…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710540145",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "哼，我们只不过打了看起来很讨厌的人而已啦！谁让你们都穿着盗宝团的衣服！"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "710540138",
                                                                            "text": "分明是故意的吧！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710540132",
                                                            "text": "这么说，我们真的打错人了。",
                                                            "response": [
                                                                {
                                                                    "id": "710540133",
                                                                    "speaker": "彦博",
                                                                    "text": "嗯，不过我不怪你们的。我们有错在先啦。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710540124",
                                            "text": "关于危险物资…",
                                            "response": [
                                                {
                                                    "id": "710540125",
                                                    "speaker": "彦博",
                                                    "text": "我的线人说那些愚人众在用大批摩拉和军用物资，向盗宝团购买什么东西…但他只发现了食物和生活物品，或许是障眼法。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710540109",
                            "text": "你们是…千岩军？",
                            "response": [
                                {
                                    "id": "710540110",
                                    "speaker": "彦博",
                                    "text": "哈哈，抱歉事先没来得及解释…我们还以为你是来搞破坏的。"
                                },
                                {
                                    "id": "710540111",
                                    "speaker": "派蒙",
                                    "text": "唔…某种意义上也没错吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105402",
            "objective": "与投降的盗宝团成员对话",
            "dialogues": []
        },
        {
            "id": "7105403",
            "objective": "与走私营地前的千岩军彦博汇合",
            "dialogues": [
                {
                    "id": "710540601",
                    "speaker": "彦博",
                    "text": "准备好了吗？我们出发！"
                }
            ]
        },
        {
            "id": "7105404",
            "objective": "test隐藏-选择了炊事营地$HIDDEN",
            "dialogues": [
                {
                    "id": "710540401",
                    "speaker": "Player",
                    "text": "先清剿<color=#00E1FFFF>炼金营地</color>能够削弱他们。"
                },
                {
                    "id": "710540402",
                    "speaker": "彦博",
                    "text": "很好，我们这就去查封他们的炼金设备。"
                }
            ]
        },
        {
            "id": "7105405",
            "objective": "test隐藏-选择了炼金营地$HIDDEN",
            "dialogues": [
                {
                    "id": "710540501",
                    "speaker": "Player",
                    "text": "先清剿<color=#00E1FFFF>兵器营地</color>会更方便。"
                },
                {
                    "id": "710540502",
                    "speaker": "彦博",
                    "text": "好的，他们很快就会发现自己没有武器可用了。"
                }
            ]
        },
        {
            "id": "7105406",
            "objective": "test隐藏-选择了武器营地$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7105407",
            "objective": "清理盗宝团的后勤营地",
            "dialogues": [
                {
                    "id": "710540701",
                    "speaker": "彦博",
                    "text": "真是精彩！感谢你的帮助，对了，这里是说好的奖励。"
                },
                {
                    "id": "710540702",
                    "speaker": "派蒙",
                    "text": "好耶！好多摩拉！欸…你什么时候把衣服也换了…？"
                },
                {
                    "id": "710540723",
                    "speaker": "彦博",
                    "text": "你们打架的时候呀…咳咳，呃，我是说，那不重要…为了防止你们打得兴起，又把我们误伤一遍，把制服换回来还是有必要的啦。"
                },
                {
                    "id": "710540703",
                    "speaker": "彦博",
                    "text": "千岩军永远感谢你们的帮助。啊，遵照我们的约定，请四处看看有没有你需要的东西吧。"
                },
                {
                    "id": "710540704",
                    "speaker": "彦博",
                    "text": "呃…我是说，除了那些我们正在查封的赃物以外。",
                    "choices": [
                        {
                            "id": "710540705",
                            "text": "恭喜你啦，任务圆满完成。",
                            "response": [
                                {
                                    "id": "710540706",
                                    "speaker": "彦博",
                                    "text": "哈哈，当然，幸好有你们帮忙，我们才能这么顺利。"
                                },
                                {
                                    "id": "710540709",
                                    "speaker": "彦博",
                                    "text": "嗯，我的意思是…只要别像这些小贼一样，凡事妄图走捷径，我们就不会找你的麻烦。"
                                },
                                {
                                    "id": "710540710",
                                    "speaker": "派蒙",
                                    "text": "哼，我们才不是那样的家伙呢！"
                                },
                                {
                                    "id": "710540711",
                                    "speaker": "彦博",
                                    "text": "哈哈，说得也是呀…"
                                },
                                {
                                    "id": "710540712",
                                    "speaker": "彦博",
                                    "text": "唉，话说回来，像你这样会使用元素力的人，不论行善或是作恶，都是不容小觑的力量…"
                                },
                                {
                                    "id": "710540713",
                                    "speaker": "彦博",
                                    "text": "我们需要几个星期或者几个月才能完成的任务，对你们来说可能是轻而易举的事…而如果把元素力用来作恶的话，也会以很小的代价，造成恐怖的破坏。"
                                },
                                {
                                    "id": "710540714",
                                    "speaker": "彦博",
                                    "text": "所以呀，我也并不觉得没有「神之眼」是一件坏事。"
                                },
                                {
                                    "id": "710540715",
                                    "speaker": "彦博",
                                    "text": "我曾见过有些人，为强求非人的力量而不惜付出自身生命的代价，最终却只是做了别人的工具、傀儡，你说说，这值得吗？"
                                },
                                {
                                    "id": "710540716",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "710540717",
                                    "speaker": "彦博",
                                    "text": "这世上还是没有神之眼的无力之人占了多数，而真正能够理解他们、保护他们的也多是同样的普通人。"
                                },
                                {
                                    "id": "710540718",
                                    "speaker": "彦博",
                                    "text": "身为这样的普通人，能够为保护大多数人而履行职责，不得不说是我的荣幸。"
                                },
                                {
                                    "id": "710540719",
                                    "speaker": "彦博",
                                    "text": "如果哪天，不再有人获得神之眼，甚至守护璃月港的仙人也逝去了…我想我也不会放弃这份职责。"
                                },
                                {
                                    "id": "710540720",
                                    "speaker": "彦博",
                                    "text": "啊，抱歉…自言自语扯了很多没用的话，留你太久了吧？"
                                },
                                {
                                    "id": "710540721",
                                    "speaker": "彦博",
                                    "text": "好了，我们还需要查验和登记赃物，就不多闲聊了。"
                                },
                                {
                                    "id": "710540722",
                                    "speaker": "彦博",
                                    "text": "我代表同僚再次感谢你的帮助，愿你今后的旅途一路顺利。千岩牢固，重嶂不移。"
                                }
                            ]
                        },
                        {
                            "id": "710540707",
                            "text": "这下我们不用受牢狱之灾了吧？",
                            "response": [
                                {
                                    "id": "710540708",
                                    "speaker": "彦博",
                                    "text": "当然，你们是协助千岩军…唔，受千岩军协助破获走私大案的首功英雄，我们怎敢请你进大牢呢？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105408",
            "objective": "清理盗宝团的后勤营地",
            "dialogues": [
                {
                    "id": "710540801",
                    "speaker": "彦博",
                    "text": "请你放心吧，我们会尽快把这些食物运走的。"
                },
                {
                    "id": "710540802",
                    "speaker": "彦博",
                    "text": "现在就看你的了，祝你一切顺利。"
                }
            ]
        },
        {
            "id": "7105409",
            "objective": "清理盗宝团的后勤营地",
            "dialogues": [
                {
                    "id": "710540901",
                    "speaker": "彦博",
                    "text": "他们的炼金设备还挺业余的…哼，刚刚抓捕时不小心磕碰了一下，已经几乎不能使用了。"
                },
                {
                    "id": "710540902",
                    "speaker": "彦博",
                    "text": "我们这边会尽快查封这些赃物，下面就要多赖英雄帮忙了。"
                }
            ]
        },
        {
            "id": "7105410",
            "objective": "test隐藏-回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "710541001",
                    "speaker": "彦博",
                    "text": "他们的弩箭保养的不错，可惜现在是我们的了。让我看看光是这些武器能判他们多少年吧…"
                },
                {
                    "id": "710541002",
                    "speaker": "彦博",
                    "text": "我们这边已经搞定啦，接下来就要拜托你们了。"
                }
            ]
        },
        {
            "id": "7105411",
            "objective": "test隐藏-直接打大营地检测$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7105412",
            "objective": "解决大营里的盗宝团走私团伙",
            "dialogues": []
        },
        {
            "id": "7105413",
            "objective": "向彦博回报战果",
            "dialogues": []
        },
        {
            "id": "7105402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710540201",
                    "speaker": "彦博",
                    "text": "你来了，我就知道你会帮忙的。"
                },
                {
                    "id": "710540202",
                    "speaker": "彦博",
                    "text": "盗宝团的走私犯们应该会在东边的大营地里和愚人众进行交易，而在通往大营的道路上，他们还设立了三个小营地。"
                },
                {
                    "id": "710540203",
                    "speaker": "彦博",
                    "text": "根据线人的情报，它们分别是东南边的<color=#00E1FFFF>炊事营地</color>、更东边的<color=#00E1FFFF>兵器营地</color>，与东北边的<color=#00E1FFFF>炼金营地</color>。如果我们事先突袭这三个营地，大概能够截断他们的物资供应。"
                },
                {
                    "id": "710540204",
                    "speaker": "彦博",
                    "text": "恰好因为前阵子群玉阁的事情，在这里巡逻的千岩军人力不足，让这帮家伙猖狂了一段时间，他们现在戒备松懈了不少，正适合我们突袭。"
                },
                {
                    "id": "710540205",
                    "speaker": "彦博",
                    "text": "只不过…因为之前的误会，我现在能支援的人手应该只够巩固一个分支营地，但如果你有需要的话，我们一定会加以支援的。"
                }
            ]
        },
        {
            "id": "7105403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710540301",
                    "speaker": "Player",
                    "text": "我建议先处理<color=#00E1FFFF>炊事营地</color>。"
                },
                {
                    "id": "710540302",
                    "speaker": "彦博",
                    "text": "明白，我们会紧急把他们的伙食都运走的。"
                }
            ]
        }
    ]
}