    "talks": [
        {
            "id": "1201601",
            "objective": "和影一起去街上逛逛",
            "dialogues": []
        },
        {
            "id": "1201602",
            "objective": "与影交谈",
            "dialogues": [
                {
                    "id": "120160204",
                    "speaker": "影",
                    "text": "这里是现在的市集？和记忆中的模样相距甚远啊。"
                },
                {
                    "id": "120160205",
                    "speaker": "影",
                    "text": "街道上的店面，以及经商的人，嗯，当然也不是当初的样子了。"
                },
                {
                    "id": "120160206",
                    "speaker": "小仓澪",
                    "text": "将、将军大人？！"
                },
                {
                    "id": "120160207",
                    "speaker": "梨绘",
                    "text": "为什么将军大人会来这里？"
                },
                {
                    "id": "120160208",
                    "speaker": "御舆源一郎",
                    "text": "将军大人不是病了吗？怎么突然…"
                },
                {
                    "id": "120160209",
                    "speaker": "影",
                    "text": "看来，好像把这里的人吓到了。"
                },
                {
                    "id": "120160210",
                    "speaker": "派蒙",
                    "text": "毕竟是将军大人突然出现，大家肯定会慌张啦。",
                    "choices": [
                        {
                            "id": "120160211",
                            "text": "但没想到反应这么大。",
                            "response": [
                                {
                                    "id": "120160213",
                                    "speaker": "影",
                                    "text": "巡视街道是天领奉行的工作，将军需要处理的信息和下达的指令很多，不会有时间亲力亲为。"
                                },
                                {
                                    "id": "120160214",
                                    "speaker": "影",
                                    "text": "将军也是不用休息的，自然也没必要打发时间或者放松精神。"
                                },
                                {
                                    "id": "120160215",
                                    "speaker": "派蒙",
                                    "text": "那我们现在怎么办？要不要先离开，等会儿再回来，低调一点？"
                                },
                                {
                                    "id": "120160216",
                                    "speaker": "影",
                                    "text": "为什么？我又不是来找麻烦的，自在一点就好。"
                                },
                                {
                                    "id": "120160217",
                                    "speaker": "派蒙",
                                    "text": "担心的是这里的普通人…"
                                },
                                {
                                    "id": "120160218",
                                    "speaker": "派蒙",
                                    "text": "算了，没关系，很像是你的想法。"
                                }
                            ]
                        },
                        {
                            "id": "120160212",
                            "text": "将军平时不到这里巡视吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201603",
            "objective": "陪同影逛街",
            "dialogues": []
        },
        {
            "id": "1201604",
            "objective": "陪同影逛街",
            "dialogues": []
        },
        {
            "id": "1201605",
            "objective": "跟随影前往智树的摊位",
            "dialogues": []
        },
        {
            "id": "1201615",
            "objective": "(test)【隐藏】用于控制回滚创建圈$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1201606",
            "objective": "与智树交谈",
            "dialogues": [
                {
                    "id": "120160610",
                    "speaker": "智树",
                    "text": "将、将军大人，失礼了…"
                },
                {
                    "id": "120160611",
                    "speaker": "影",
                    "text": "没关系，不用多礼，今天我是来转换心情，随便看看而已。"
                },
                {
                    "id": "120160612",
                    "speaker": "影",
                    "text": "能为我介绍一下你卖的东西吗？"
                },
                {
                    "id": "120160613",
                    "speaker": "智树",
                    "text": "当然没问题！我这里贩卖各种各样的小吃，有章鱼丸，团子，还有…呃，牛奶什么的。"
                },
                {
                    "id": "120160614",
                    "speaker": "派蒙",
                    "text": "唔？牛奶，感觉有点奇怪…"
                },
                {
                    "id": "120160615",
                    "speaker": "智树",
                    "text": "你说的「奇怪」，其实是我这里的特色。"
                },
                {
                    "id": "120160616",
                    "speaker": "智树",
                    "text": "因为城里有很多历史悠久的店铺，我不管卖什么都没法和他们竞争。"
                },
                {
                    "id": "120160617",
                    "speaker": "智树",
                    "text": "所以我的做法就是创造一些新的组合，让顾客有新鲜的体验。"
                },
                {
                    "id": "120160618",
                    "speaker": "智树",
                    "text": "比如我最近开发出来的，就是这个「团子牛奶」，团子被做成了很粘稠的状态，和牛奶混合得很好。"
                },
                {
                    "id": "120160619",
                    "speaker": "智树",
                    "text": "主打的不只是味道，还有新奇的口感。"
                },
                {
                    "id": "120160620",
                    "speaker": "影",
                    "text": "团子加上牛奶，唔，闻所未闻…为什么会想到要这样做？"
                },
                {
                    "id": "120160621",
                    "speaker": "智树",
                    "text": "啊，抱歉，将军大人，我并不是对「永恒」有什么意见！"
                },
                {
                    "id": "120160622",
                    "speaker": "影",
                    "text": "说了不必多礼，也不用这么心惊胆战的。我想要的永恒，岂是会被团子和牛奶撼动之物？"
                },
                {
                    "id": "120160623",
                    "speaker": "智树",
                    "text": "（欸？怎么感觉…和传闻中的将军大人不太一样？）"
                },
                {
                    "id": "120160624",
                    "speaker": "智树",
                    "text": "其实，我也是偶然想到的。朋友有次招待客人的时候，团子做了太多，因为吃不完就送了我一些。"
                },
                {
                    "id": "120160625",
                    "speaker": "智树",
                    "text": "但对我来说那个数量太多了，那个时候我家的牛奶也卖得不好，团子和牛奶都不能久放…"
                },
                {
                    "id": "120160626",
                    "speaker": "智树",
                    "text": "抱着试试看的心情，我就把这两个东西混在一起了，没想到比例合适的情况下，还意外的好喝。"
                },
                {
                    "id": "120160627",
                    "speaker": "影",
                    "text": "出于巧合，嗯，挺有趣的。可以给我来一杯吗？"
                },
                {
                    "id": "120160628",
                    "speaker": "智树",
                    "text": "将军大人感兴趣吗？！好的，当然可以！你们也来一杯吧！"
                },
                {
                    "id": "120160629",
                    "speaker": "影",
                    "text": "甜甜的，好喝。还有类似点心的口感，喝起来很新奇。"
                },
                {
                    "id": "120160630",
                    "speaker": "派蒙",
                    "text": "是啊，明明是在喝饮料，却又像是在吃什么似的。"
                },
                {
                    "id": "120160631",
                    "speaker": "影",
                    "text": "像是…粥？但显然不能划等号…"
                },
                {
                    "id": "120160632",
                    "speaker": "影",
                    "text": "不管怎么样，我喜欢。"
                },
                {
                    "id": "120160633",
                    "speaker": "智树",
                    "text": "多谢将军大人肯定！"
                },
                {
                    "id": "120160634",
                    "speaker": "影",
                    "text": "这么好喝的「团子牛奶」，应该卖得很好吧？"
                },
                {
                    "id": "120160635",
                    "speaker": "智树",
                    "text": "呃，这个…不瞒您说，销量很普通。"
                },
                {
                    "id": "120160636",
                    "speaker": "影",
                    "text": "欸，卖得不好吗？为什么？"
                },
                {
                    "id": "120160637",
                    "speaker": "智树",
                    "text": "因为…很多人都不愿意尝试，觉得这种搭配很奇怪，虽然尝过的人评价都还不错…"
                },
                {
                    "id": "120160638",
                    "speaker": "智树",
                    "text": "我并不是在说将军大人的品味奇怪！还请不要怪罪！"
                },
                {
                    "id": "120160639",
                    "speaker": "影",
                    "text": "哦，这个简单，让社奉行的人买上几百杯，挨家挨户去送好了。"
                },
                {
                    "id": "120160640",
                    "speaker": "智树",
                    "text": "不不不，将军大人，这太夸张了！"
                },
                {
                    "id": "120160641",
                    "speaker": "影",
                    "text": "很夸张吗？只是想让他们试试看，没有喝过「团子牛奶」太遗憾了。"
                },
                {
                    "id": "120160642",
                    "speaker": "智树",
                    "text": "这…",
                    "choices": [
                        {
                            "id": "120160643",
                            "text": "原来你喜欢甜食？",
                            "response": [
                                {
                                    "id": "120160644",
                                    "speaker": "影",
                                    "text": "理所当然吧，我听说人类大都喜甜，我吃甜点心也并非什么奇怪的事，神子也是这么说的。"
                                },
                                {
                                    "id": "120160647",
                                    "speaker": "影",
                                    "text": "啊——甜品果然能让人心情放松，和一个人冥思苦想相比，快活多了。"
                                },
                                {
                                    "id": "120160648",
                                    "speaker": "影",
                                    "text": "对了，神子曾和我提过，她建了一间「八重堂」，卖什么…轻小说。"
                                },
                                {
                                    "id": "120160649",
                                    "speaker": "影",
                                    "text": "她总是和我炫耀，可我没什么概念。正好有这个机会，能带我去看看吗？"
                                },
                                {
                                    "id": "120160650",
                                    "speaker": "派蒙",
                                    "text": "好呀，去见识见识吧。"
                                }
                            ]
                        },
                        {
                            "id": "120160645",
                            "text": "还要再来一杯吗？",
                            "response": [
                                {
                                    "id": "120160646",
                                    "speaker": "影",
                                    "text": "要…算了，不要了吧，也没有痴迷到这种程度。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201607",
            "objective": "和影一起去八重堂",
            "dialogues": []
        },
        {
            "id": "1201608",
            "objective": "与黑田交谈",
            "dialogues": [
                {
                    "id": "120160803",
                    "speaker": "黑田",
                    "text": "将、将军大人？！"
                },
                {
                    "id": "120160804",
                    "speaker": "黑田",
                    "text": "将军大人亲临八重堂，请问是有什么指示吗？"
                },
                {
                    "id": "120160805",
                    "speaker": "影",
                    "text": "没什么，不用紧张，只是来看看而已。"
                },
                {
                    "id": "120160806",
                    "speaker": "黑田",
                    "text": "抱歉，没太能理解，请问是管理方面，还是出版规范，还是说…消防问题呢？"
                },
                {
                    "id": "120160807",
                    "speaker": "派蒙",
                    "text": "将军就只是想看看书啦。"
                },
                {
                    "id": "120160808",
                    "speaker": "黑田",
                    "text": "将军大人想要看…轻小说？"
                },
                {
                    "id": "120160809",
                    "speaker": "影",
                    "text": "对啊，有什么推荐的好书吗？"
                },
                {
                    "id": "120160810",
                    "speaker": "黑田",
                    "text": "「八重堂」的小说主要面向普通人，内容千奇百怪，可能很多都不符将军大人的口味…"
                },
                {
                    "id": "120160811",
                    "speaker": "影",
                    "text": "尝鲜而已，千篇一律那才是没趣味。放心吧，只要是用文字所写的故事，有什么不能理解的呢？"
                },
                {
                    "id": "120160812",
                    "speaker": "黑田",
                    "text": "虽然道理是这样…"
                },
                {
                    "id": "120160813",
                    "speaker": "派蒙",
                    "text": "没关系，就算有不理解的东西，我们也会给将军解释的！",
                    "choices": [
                        {
                            "id": "120160814",
                            "text": "你不用紧张。",
                            "response": [
                                {
                                    "id": "120160816",
                                    "speaker": "黑田",
                                    "text": "好吧，那请各位移步那边的书架，上面都是最近的热销书。"
                                },
                                {
                                    "id": "120160817",
                                    "speaker": "黑田",
                                    "text": "其中也有「这本小说真厉害！」的获奖作品，是刚刚才整理成册开始贩卖的。"
                                },
                                {
                                    "id": "120160818",
                                    "speaker": "黑田",
                                    "text": "不用太认真，就当看个乐子吧。"
                                },
                                {
                                    "id": "120160819",
                                    "speaker": "影",
                                    "text": "好的，那我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "120160815",
                            "text": "将军大人真的只是想看看。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201609",
            "objective": "前往书架试看轻小说",
            "dialogues": []
        },
        {
            "id": "1201610",
            "objective": "与影交谈",
            "dialogues": [
                {
                    "id": "120161001",
                    "speaker": "影",
                    "text": "唔…怎么会这样？是我轻敌了吗？"
                },
                {
                    "id": "120161002",
                    "speaker": "影",
                    "text": "明明这些书的名字都认识，为什么连在一起就变得读不懂了？"
                },
                {
                    "id": "120161003",
                    "speaker": "影",
                    "text": "比如，《转生成为丘丘人，只要吃日落果就可以一直变强》…"
                },
                {
                    "id": "120161004",
                    "speaker": "影",
                    "text": "好长啊…"
                },
                {
                    "id": "120161005",
                    "speaker": "影",
                    "text": "丘丘人真的可以靠吃日落果就变强吗？至少也该是吃肉吧。"
                },
                {
                    "id": "120161006",
                    "speaker": "派蒙",
                    "text": "这个是这本书的设定啦。"
                },
                {
                    "id": "120161007",
                    "speaker": "影",
                    "text": "「设定」？",
                    "choices": [
                        {
                            "id": "120161008",
                            "text": "就是假想的情况。",
                            "response": [
                                {
                                    "id": "120161010",
                                    "speaker": "影",
                                    "text": "「设定」要用来做什么？缺少了真实感，写出来的故事还会可信吗？"
                                },
                                {
                                    "id": "120161011",
                                    "speaker": "影",
                                    "text": "另外，丘丘人应该没有写故事的能力吧，是作者在记录丘丘人的生活吗？"
                                },
                                {
                                    "id": "120161012",
                                    "speaker": "派蒙",
                                    "text": "我明白为什么黑田说将军会费解了…",
                                    "choices": [
                                        {
                                            "id": "120161013",
                                            "text": "太时尚了吧。",
                                            "response": [
                                                {
                                                    "id": "120161015",
                                                    "speaker": "派蒙",
                                                    "text": "这样吧，我们两个先帮你选一下，挑出比较容易理解的小说，再讲给你听吧。"
                                                },
                                                {
                                                    "id": "120161016",
                                                    "speaker": "影",
                                                    "text": "好吧，我自认为我读过不少书，但读起这样的故事，我甚至都不知道应该关注什么…"
                                                },
                                                {
                                                    "id": "120161017",
                                                    "speaker": "影",
                                                    "text": "但我还是很期待的，感觉这很像神子的风格，一定很有趣。"
                                                },
                                                {
                                                    "id": "120161018",
                                                    "speaker": "派蒙",
                                                    "text": "那就交给我们吧，你稍等一下哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120161014",
                                            "text": "是「永恒」里没有的东西。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120161009",
                            "text": "就是作者说的算的东西。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201611",
            "objective": "挑选一本合适的轻小说",
            "dialogues": [
                {
                    "id": "120161102",
                    "speaker": "阅读璃月武侠故事…",
                    "text": "（书名《人在江湖，却只想好好写小说》）"
                },
                {
                    "id": "120161103",
                    "speaker": "阅读璃月武侠故事…",
                    "text": "（这本书讲的是发生在璃月的武侠故事，聚焦于各帮派之间的明争暗斗。）"
                },
                {
                    "id": "120161104",
                    "speaker": "阅读璃月武侠故事…",
                    "text": "（主角的理想是成为与世无争的普通轻小说家，却因为拥有独一无二的习武体质，被卷入了江湖争斗中。）"
                },
                {
                    "id": "120161105",
                    "speaker": "阅读璃月武侠故事…",
                    "text": "（故事的卖点在于主角始终没有加入任何一派，却总是被误认为是某一门派的隐世高手。）"
                },
                {
                    "id": "120161106",
                    "speaker": "阅读璃月武侠故事…",
                    "text": "（把主角视为假想敌的各路高手总是闹得啼笑皆非，而主角置身其中，却从未忘记成为小说家的初心…）"
                },
                {
                    "id": "120161107",
                    "speaker": "派蒙",
                    "text": "好奇怪的人啊，为什么非要当轻小说家不可呢？"
                },
                {
                    "id": "120161108",
                    "speaker": "派蒙",
                    "text": "这么厉害的话，应该轻轻松松就能成为武林第一吧。",
                    "choices": [
                        {
                            "id": "120161109",
                            "text": "重要的是过程。",
                            "response": [
                                {
                                    "id": "120161111",
                                    "speaker": "派蒙",
                                    "text": "也有道理，将愿望贯彻到底的人，应该能引起影的共鸣吧？"
                                }
                            ]
                        },
                        {
                            "id": "120161110",
                            "text": "主角的意志挺可贵的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201612",
            "objective": "挑选一本合适的轻小说",
            "dialogues": [
                {
                    "id": "120161201",
                    "speaker": "阅读日常恋爱故事…",
                    "text": "（书名《关于我的混乱系青春恋爱物语一事》）"
                },
                {
                    "id": "120161202",
                    "speaker": "阅读日常恋爱故事…",
                    "text": "（这本书讲的是平平无奇的男主角，和七位美少女之间的爱情故事。）"
                },
                {
                    "id": "120161203",
                    "speaker": "阅读日常恋爱故事…",
                    "text": "（作品以时间推进为顺序，记述了这位主角的日常生活，其中有相当多让人会心一笑的小桥段。）"
                },
                {
                    "id": "120161204",
                    "speaker": "阅读日常恋爱故事…",
                    "text": "（作者的笔力扎实，语句流畅，每位角色的魅力都呈现得淋漓尽致。）"
                },
                {
                    "id": "120161205",
                    "speaker": "阅读日常恋爱故事…",
                    "text": "（不过，故事断在了男主角的青梅竹马正准备表白爱意的关键时刻…）"
                },
                {
                    "id": "120161206",
                    "speaker": "派蒙",
                    "text": "好着急啊！"
                },
                {
                    "id": "120161207",
                    "speaker": "派蒙",
                    "text": "虽然只是草草地看了一下，但这个女孩子从小就很喜欢男主角，把一切都奉献出来了！",
                    "choices": [
                        {
                            "id": "120161208",
                            "text": "希望她能获得幸福。",
                            "response": [
                                {
                                    "id": "120161209",
                                    "speaker": "派蒙",
                                    "text": "没错！可不能让她的感情被辜负了！"
                                },
                                {
                                    "id": "120161212",
                                    "speaker": "派蒙",
                                    "text": "情节是挺吸引人的，但影能够理解这种…凡人之间的恋爱吗？"
                                }
                            ]
                        },
                        {
                            "id": "120161210",
                            "text": "希望作者能给她幸福。",
                            "response": [
                                {
                                    "id": "120161211",
                                    "speaker": "派蒙",
                                    "text": "对哦，毕竟还是小说。希望作者是个好人，希望作者是个好人，希望作者是个好人…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201613",
            "objective": "挑选一本合适的轻小说",
            "dialogues": [
                {
                    "id": "120161301",
                    "speaker": "阅读转生冒险故事…",
                    "text": "（书名《转生成为雷电将军，然后天下无敌》）"
                },
                {
                    "id": "120161302",
                    "speaker": "阅读转生冒险故事…",
                    "text": "（这本书讲的是主角在雷樱树下被闪电击中，睁开眼的时候居然变成了雷电将军的故事。）"
                },
                {
                    "id": "120161303",
                    "speaker": "阅读转生冒险故事…",
                    "text": "（原本的主角总是被欺负，什么事都做不好，但成为雷电将军之后，他就拥有了无穷的武力与权力。）"
                },
                {
                    "id": "120161304",
                    "speaker": "阅读转生冒险故事…",
                    "text": "（故事的看点，大概就是这种扬眉吐气的感觉，以及自卑的内在逐渐成长与蜕变的过程。）"
                },
                {
                    "id": "120161305",
                    "speaker": "阅读转生冒险故事…",
                    "text": "（但都已经成为了雷电将军，接下来的故事要怎么展开呢…）"
                },
                {
                    "id": "120161306",
                    "speaker": "派蒙",
                    "text": "怪不得黑田会害怕，原来还有这种题材啊。"
                },
                {
                    "id": "120161307",
                    "speaker": "派蒙",
                    "text": "我觉得还是不要把这个故事讲给影听，不然作者可能会被追究责任的。",
                    "choices": [
                        {
                            "id": "120161308",
                            "text": "倒也没有糟蹋将军的形象。",
                            "response": [
                                {
                                    "id": "120161310",
                                    "speaker": "派蒙",
                                    "text": "如果有人变成了派蒙，还做了很多派蒙根本就不会做的事，我会觉得很不自在！"
                                }
                            ]
                        },
                        {
                            "id": "120161309",
                            "text": "我觉得还挺新颖的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201614",
            "objective": "为影推荐并讲解书中内容",
            "dialogues": [
                {
                    "id": "120161402",
                    "speaker": "影",
                    "text": "看你们的表情，应该读到了不错的故事吧。",
                    "choices": [
                        {
                            "id": "120161403",
                            "text": "分享璃月武侠故事…",
                            "response": [
                                {
                                    "id": "120161404",
                                    "speaker": "影",
                                    "text": "如今璃月的人心，原来这么复杂吗？"
                                },
                                {
                                    "id": "120161405",
                                    "speaker": "影",
                                    "text": "相较之下，主角虽然一直不愿正视自身的天赋，却是位不可多得的正义之士。"
                                },
                                {
                                    "id": "120161406",
                                    "speaker": "影",
                                    "text": "他现在在哪里？有来稻妻的打算吗？我想让奉行众把他请来，和我打一场。"
                                },
                                {
                                    "id": "120161407",
                                    "speaker": "派蒙",
                                    "text": "那是虚构的角色，现实中不存在啦…"
                                },
                                {
                                    "id": "120161408",
                                    "speaker": "派蒙",
                                    "text": "更该关注的是反派吧，你对那些反派的作为没什么感想吗？"
                                },
                                {
                                    "id": "120161409",
                                    "speaker": "影",
                                    "text": "反派？那些愚蠢的人对吧。都是坏人，结果也就是罪有应得而已。"
                                },
                                {
                                    "id": "120161410",
                                    "speaker": "派蒙",
                                    "text": "看来影完全不关心配角啊。"
                                },
                                {
                                    "id": "120161426",
                                    "speaker": "派蒙",
                                    "text": "所以，影对「八重堂」的轻小说有什么看法呢？"
                                },
                                {
                                    "id": "120161427",
                                    "speaker": "派蒙",
                                    "text": "我们挑选的故事合你的口味吗？"
                                },
                                {
                                    "id": "120161428",
                                    "speaker": "影",
                                    "text": "相比具体的内容，我从故事里感受到的是，时间在稻妻留下的痕迹。"
                                },
                                {
                                    "id": "120161429",
                                    "speaker": "影",
                                    "text": "在我决定深居「一心净土」的时候，那时还没有什么「八重堂」，更没有像这样的故事存在。"
                                },
                                {
                                    "id": "120161430",
                                    "speaker": "影",
                                    "text": "将军依我之意，尽全力打造永恒的国度，这个国度本应没有任何变化。"
                                },
                                {
                                    "id": "120161431",
                                    "speaker": "影",
                                    "text": "可现在，无论是食物还是故事，都已经很不相同了…",
                                    "choices": [
                                        {
                                            "id": "120161432",
                                            "text": "人本来就会追求变化。",
                                            "response": [
                                                {
                                                    "id": "120161434",
                                                    "speaker": "影",
                                                    "text": "「我不认同你的说法」…如果我们还在「一心净土」之中，我一定会像这样回答。"
                                                },
                                                {
                                                    "id": "120161435",
                                                    "speaker": "影",
                                                    "text": "但事实就在我的眼前，我并不能反驳现状。"
                                                },
                                                {
                                                    "id": "120161436",
                                                    "speaker": "派蒙",
                                                    "text": "就是为了让你产生新的想法，才会邀请你出来看看啊。"
                                                },
                                                {
                                                    "id": "120161437",
                                                    "speaker": "派蒙",
                                                    "text": "虽然和记忆中不一样了，但大家都热爱现在的生活，这种热爱总不会错吧？"
                                                },
                                                {
                                                    "id": "120161438",
                                                    "speaker": "影",
                                                    "text": "嗯，如你所说。我对一切改变都很谨慎，但我想追求永恒，也绝非要阻止人类变得越来越好。"
                                                },
                                                {
                                                    "id": "120161439",
                                                    "speaker": "影",
                                                    "text": "幸好有你们的邀请，我这一趟出来，可是收获颇丰呢。",
                                                    "choices": [
                                                        {
                                                            "id": "120161440",
                                                            "text": "不用这么客气。",
                                                            "response": [
                                                                {
                                                                    "id": "120161442",
                                                                    "speaker": "影",
                                                                    "text": "是因为你习惯了吧。对我来说，这趟出行相当有纪念价值。"
                                                                },
                                                                {
                                                                    "id": "120161443",
                                                                    "speaker": "影",
                                                                    "text": "见识了很多，也想了很多…我再怎么褒奖，再怎么回味都不为过吧。"
                                                                },
                                                                {
                                                                    "id": "120161444",
                                                                    "speaker": "Player",
                                                                    "text": "那，留影纪念？"
                                                                },
                                                                {
                                                                    "id": "120161445",
                                                                    "speaker": "派蒙",
                                                                    "text": "对哦，既然影很喜欢的样子，那就少不了纪念品啊！"
                                                                },
                                                                {
                                                                    "id": "120161446",
                                                                    "speaker": "影",
                                                                    "text": "「留影」…怎么总是出现我没听说过的词。"
                                                                },
                                                                {
                                                                    "id": "120161447",
                                                                    "speaker": "派蒙",
                                                                    "text": "没关系啦，跟我们来，去个风景好的地方你就知道了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120161441",
                                                            "text": "只是出来玩而已。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120161433",
                                            "text": "完全静止是不可能的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120161411",
                            "text": "分享日常恋爱故事…",
                            "response": [
                                {
                                    "id": "120161412",
                                    "speaker": "影",
                                    "text": "为什么有七个人都执着于和男主角缔结关系，这也是「设定」吗？"
                                },
                                {
                                    "id": "120161413",
                                    "speaker": "派蒙",
                                    "text": "不是啦，就是很普通的恋爱，主角最后只能选择一个人嘛。"
                                },
                                {
                                    "id": "120161414",
                                    "speaker": "影",
                                    "text": "我明白了，因为他想要缔结重要的关系，所以必须好好选择，这也就是痛苦与矛盾的根源。"
                                },
                                {
                                    "id": "120161415",
                                    "speaker": "影",
                                    "text": "那只要作者加一个「设定」，让主角可以同时接受所有人的感情，不就解决问题了吗！"
                                },
                                {
                                    "id": "120161416",
                                    "speaker": "派蒙",
                                    "text": "那爱情故事的看点就没有了啊！"
                                },
                                {
                                    "id": "120161417",
                                    "speaker": "影",
                                    "text": "「爱情」…"
                                },
                                {
                                    "id": "120161418",
                                    "speaker": "影",
                                    "text": "嗯，「设定」还真是深奥啊。"
                                }
                            ]
                        },
                        {
                            "id": "120161419",
                            "text": "分享转生冒险故事…",
                            "response": [
                                {
                                    "id": "120161420",
                                    "speaker": "派蒙",
                                    "text": "喂，不是说好不讲这个的吗？"
                                },
                                {
                                    "id": "120161421",
                                    "speaker": "影",
                                    "text": "没事，还挺有意思的，没想到在普通民众的眼中，将军是这样的形象。"
                                },
                                {
                                    "id": "120161422",
                                    "speaker": "影",
                                    "text": "「无想的一刀」不会像书中那样随意使用，也不会用来宣泄情绪。出刀的理由，决定了武艺的格局与极限。"
                                },
                                {
                                    "id": "120161423",
                                    "speaker": "影",
                                    "text": "由于差别过大了，我并不会感觉到被冒犯，反倒觉得这种想象力很是可贵。"
                                },
                                {
                                    "id": "120161424",
                                    "speaker": "影",
                                    "text": "不过我听说，八重堂的小说，都会经过那个家伙的审稿吧。"
                                },
                                {
                                    "id": "120161425",
                                    "speaker": "影",
                                    "text": "也就是说，这本书的内容，也是得到了神子的默许…不，也可能就是她出的主意呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201651",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165101",
                    "speaker": "毅",
                    "text": "那是…将军大人？难道休养已经结束了？"
                },
                {
                    "id": "120165102",
                    "speaker": "毅",
                    "text": "不过没事就好。"
                }
            ]
        },
        {
            "id": "1201652",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165201",
                    "speaker": "小仓澪",
                    "text": "我、我还是第一次这么近看到将军大人…"
                },
                {
                    "id": "120165202",
                    "speaker": "小仓澪",
                    "text": "脑子里一片空白，都不知道该怎么办好了。"
                }
            ]
        },
        {
            "id": "1201653",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165301",
                    "speaker": "梨绘",
                    "text": "那个…居然真的是将军大人，我还以为我看错了。"
                },
                {
                    "id": "120165302",
                    "speaker": "梨绘",
                    "text": "我刚刚应该没说什么失礼的话吧…"
                }
            ]
        },
        {
            "id": "1201654",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165401",
                    "speaker": "御舆源一郎",
                    "text": "为什么将军大人会亲自到这里，是来巡视，还是抓人…总不可能是购物吧？"
                },
                {
                    "id": "120165402",
                    "speaker": "御舆源一郎",
                    "text": "我…我还是老老实实的，观察情况好了。"
                }
            ]
        },
        {
            "id": "1201655",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165501",
                    "speaker": "蓝川丞",
                    "text": "今天是什么日子啊，将军大人居然来了这里…"
                },
                {
                    "id": "120165502",
                    "speaker": "蓝川丞",
                    "text": "气都有点喘不上来了。",
                    "choices": [
                        {
                            "id": "120165503",
                            "text": "不用紧张，没事的。",
                            "response": [
                                {
                                    "id": "120165504",
                                    "speaker": "蓝川丞",
                                    "text": "说、说的也对…"
                                }
                            ]
                        },
                        {
                            "id": "120165505",
                            "text": "听说你想请将军泡温泉？",
                            "response": [
                                {
                                    "id": "120165506",
                                    "speaker": "蓝川丞",
                                    "text": "哎，话不能乱说，话不能乱说啊…我、我怎么敢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201656",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165601",
                    "speaker": "古谷升",
                    "text": "不愧是将军大人，站在这里都能感觉到她威严的气势。"
                },
                {
                    "id": "120165602",
                    "speaker": "古谷升",
                    "text": "我就说，英明神武的将军大人怎么会病倒呢。"
                }
            ]
        },
        {
            "id": "1201657",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165701",
                    "speaker": "松本",
                    "text": "将、将军大人！赶快用留影机拍下来！"
                },
                {
                    "id": "120165702",
                    "speaker": "松本",
                    "text": "但这算偷拍吧，对方还是将军，不行不行…"
                }
            ]
        },
        {
            "id": "1201658",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165801",
                    "speaker": "智树",
                    "text": "居然是将军大人…"
                },
                {
                    "id": "120165802",
                    "speaker": "智树",
                    "text": "怎么办，好紧张…"
                }
            ]
        },
        {
            "id": "1201659",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120165901",
                    "speaker": "黑田",
                    "text": "将军大人看轻小说…"
                },
                {
                    "id": "120165902",
                    "speaker": "黑田",
                    "text": "哎哟…这才像是发生在轻小说里的情节吧。"
                }
            ]
        },
        {
            "id": "1201660",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120166001",
                    "speaker": "影",
                    "text": "不用着急，好好挑选吧，我就在这里等着。"
                }
            ]
        },
        {
            "id": "1201661",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120166101",
                    "speaker": "智树",
                    "text": "将军大人…肯定了我的「团子牛奶」。"
                },
                {
                    "id": "120166102",
                    "speaker": "智树",
                    "text": "太好了，本来我还说以后就不做这个了，太好了…"
                }
            ]
        },
        {
            "id": "1201699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120169904",
                    "speaker": "影",
                    "text": "现在市民们的交易，应该仍然在使用摩拉吧？"
                },
                {
                    "id": "120169905",
                    "speaker": "派蒙",
                    "text": "嗯，这个和以前一样。还是很闪亮，很让人着迷！"
                },
                {
                    "id": "120169906",
                    "speaker": "派蒙",
                    "text": "等等，影你不会也没有摩拉吧？"
                },
                {
                    "id": "120169907",
                    "speaker": "影",
                    "text": "当然没有了，在「一心净土」中没有交易的需求。就算是需要某种物品，让奉行众送过来便是。"
                },
                {
                    "id": "120169908",
                    "speaker": "影",
                    "text": "…你为什么要说「也」？"
                },
                {
                    "id": "120169916",
                    "speaker": "派蒙",
                    "text": "总算是都看完了，想办法讲给影听好了。"
                }
            ]
        }
    ]
}