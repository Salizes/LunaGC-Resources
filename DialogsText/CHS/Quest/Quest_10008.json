        {
            "id": "1000805",
            "objective": "消灭黑色的狼群",
            "dialogues": []
        },
        {
            "id": "1000806",
            "objective": "与雷泽对话",
            "dialogues": [
                {
                    "id": "100080601",
                    "speaker": "派蒙",
                    "text": "成功了！"
                },
                {
                    "id": "100080602",
                    "speaker": "雷泽",
                    "text": "谢谢，谢谢你们…我一直以为，只要我保护「卢皮卡」就够了。"
                },
                {
                    "id": "100080603",
                    "speaker": "雷泽",
                    "text": "其实「卢皮卡」也…"
                },
                {
                    "id": "100080604",
                    "speaker": "派蒙",
                    "text": "正是因为心意相通，「卢皮卡」才是「卢皮卡」嘛！"
                },
                {
                    "id": "100080605",
                    "speaker": "雷泽",
                    "text": "派蒙说得对…这点，永远不会变。"
                },
                {
                    "id": "100080606",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这下奔狼领就不会出现「外来的狼群」了吧。"
                },
                {
                    "id": "100080607",
                    "speaker": "雷泽",
                    "text": "不…那些家伙，撕开空间…也许还会来。"
                },
                {
                    "id": "100080608",
                    "speaker": "雷泽",
                    "text": "不过，有我和「卢皮卡」们，我们会一起…"
                },
                {
                    "id": "100080609",
                    "speaker": "Player",
                    "text": "…还有我和派蒙。"
                },
                {
                    "id": "100080610",
                    "speaker": "派蒙",
                    "text": "对对，要是需要帮助，一定要告诉我们，我们也会帮忙的！"
                },
                {
                    "id": "100080611",
                    "speaker": "雷泽",
                    "text": "嗯，有你们，真好。"
                },
                {
                    "id": "100080612",
                    "speaker": "远处的狼嚎",
                    "text": "啊呜——"
                },
                {
                    "id": "100080613",
                    "speaker": "雷泽",
                    "text": "他们，在呼唤我。"
                },
                {
                    "id": "100080614",
                    "speaker": "派蒙",
                    "text": "嘿嘿，看来他们在担心着你的安危呢。"
                },
                {
                    "id": "100080615",
                    "speaker": "雷泽",
                    "text": "那我，要离开了，谢谢，你们。"
                },
                {
                    "id": "100080616",
                    "speaker": "Player",
                    "text": "不用谢，这是「卢皮卡」该做的。"
                },
                {
                    "id": "100080617",
                    "speaker": "Black Screen",
                    "text": "奔狼领获得了短暂但久违的平静，雷泽与你作了简单的告别，步入了奔狼领的丛林之中。"
                },
                {
                    "id": "100080618",
                    "speaker": "Black Screen",
                    "text": "你看到，树叶的薮影之中，那里有许多期待他的，温柔的眼眸。"
                }
            ]
        }
    ]
}