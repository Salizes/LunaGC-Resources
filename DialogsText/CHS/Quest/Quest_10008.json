    "talks": [
        {
            "id": "1000801",
            "objective": "前往奔狼领",
            "dialogues": [
                {
                    "id": "100080101",
                    "speaker": "派蒙",
                    "text": "雷泽——"
                },
                {
                    "id": "100080102",
                    "speaker": "雷泽",
                    "text": "闻到了，熟悉的气味，原来是你们。"
                },
                {
                    "id": "100080103",
                    "speaker": "雷泽",
                    "text": "最近，还好吗？"
                },
                {
                    "id": "100080104",
                    "speaker": "派蒙",
                    "text": "嘿嘿，一切都好，对了，雷泽，怎么王狼一见到我们就消失了，你们在讨论什么秘密呢？"
                },
                {
                    "id": "100080105",
                    "speaker": "雷泽",
                    "text": "要开始狩猎，我在说服…领主。"
                },
                {
                    "id": "100080106",
                    "speaker": "派蒙",
                    "text": "打猎？"
                },
                {
                    "id": "100080107",
                    "speaker": "派蒙",
                    "text": "#（对了，{NICKNAME}，难道这就是雷泽的「课题」吗？）"
                },
                {
                    "id": "100080108",
                    "speaker": "派蒙",
                    "text": "雷泽，难道是狼群又没有吃的东西，所以大家要开始打猎…",
                    "choices": [
                        {
                            "id": "100080109",
                            "text": "请给我捕兽夹…",
                            "response": [
                                {
                                    "id": "100080111",
                                    "speaker": "雷泽",
                                    "text": "不，不是…这次的打猎，不是为了填饱肚子。"
                                },
                                {
                                    "id": "100080112",
                                    "speaker": "雷泽",
                                    "text": "而是为了，杀死敌人。漆黑的狼群，侵占的领土…发出奇怪的臭味，越来越浓…"
                                },
                                {
                                    "id": "100080113",
                                    "speaker": "雷泽",
                                    "text": "要净化森林…狩猎敌人。"
                                },
                                {
                                    "id": "100080114",
                                    "speaker": "派蒙",
                                    "text": "所以，王狼答应了吗，我还记得那个时候，王狼还说…"
                                },
                                {
                                    "id": "100080115",
                                    "speaker": "派蒙",
                                    "text": "我想想，是怎么说的来着…咳咳，「雷泽，你不准参与讨伐。因为这是狼的问题。」"
                                },
                                {
                                    "id": "100080116",
                                    "speaker": "雷泽",
                                    "text": "……"
                                },
                                {
                                    "id": "100080117",
                                    "speaker": "派蒙",
                                    "text": "啊，我不是故意的…对不起，雷泽…"
                                },
                                {
                                    "id": "100080118",
                                    "speaker": "雷泽",
                                    "text": "没关系，因为我和「卢皮卡」在一起，而且，师父告诉了我，和领主说话的方法。"
                                },
                                {
                                    "id": "100080119",
                                    "speaker": "派蒙",
                                    "text": "丽莎说的…和领主说话的方法？"
                                },
                                {
                                    "id": "100080120",
                                    "speaker": "派蒙",
                                    "text": "啊，我明白了，是说服王狼的办法吧，所以你刚才已经说服王狼了吗！"
                                },
                                {
                                    "id": "100080121",
                                    "speaker": "雷泽",
                                    "text": "嗯，说话很累，可是，成功了。"
                                },
                                {
                                    "id": "100080122",
                                    "speaker": "派蒙",
                                    "text": "居然能够说服那个顽固的大家伙，了不起！"
                                },
                                {
                                    "id": "100080123",
                                    "speaker": "雷泽",
                                    "text": "漆黑的狼，是世界的敌人。师父说，这不是狼的问题，而是世界的问题…师父是对的，领主也承认了。"
                                },
                                {
                                    "id": "100080124",
                                    "speaker": "雷泽",
                                    "text": "不过，因此，狼群不会参与，是「我」与「漆黑狼群」的战争…"
                                },
                                {
                                    "id": "100080125",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，那就让我们也一起帮忙吧！那些奇怪的兽境猎犬，我们也早就看不顺眼啦！"
                                },
                                {
                                    "id": "100080126",
                                    "speaker": "雷泽",
                                    "text": "谢、谢谢…如果，有你们的帮助，一定能顺利。"
                                },
                                {
                                    "id": "100080127",
                                    "speaker": "派蒙",
                                    "text": "不过，要怎么开始狩猎呢？"
                                },
                                {
                                    "id": "100080128",
                                    "speaker": "雷泽",
                                    "text": "我们要，像把猎物赶到陷阱，把漆黑狼群，赶到这里…"
                                },
                                {
                                    "id": "100080129",
                                    "speaker": "雷泽",
                                    "text": "领主会，困住他们，我们来…把它们解决掉。"
                                },
                                {
                                    "id": "100080130",
                                    "speaker": "雷泽",
                                    "text": "…准备好，跟我说一声，就开始，狩猎。"
                                },
                                {
                                    "id": "100080401",
                                    "speaker": "Player",
                                    "text": "现在就出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "100080110",
                            "text": "林猪长得够大了。"
                        }
                    ]
                }
            ]
        },
