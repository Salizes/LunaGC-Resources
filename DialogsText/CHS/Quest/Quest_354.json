    "talks": [
        {
            "id": "35401",
            "objective": "继续前往蒙德城",
            "dialogues": []
        },
        {
            "id": "35402",
            "objective": "与轻盈的少女对话",
            "dialogues": [
                {
                    "id": "3540401",
                    "speaker": "？？？",
                    "text": "愿风神护佑你，陌生人！"
                },
                {
                    "id": "3540402",
                    "speaker": "安柏",
                    "text": "我是西风骑士团侦察骑士，安柏。"
                },
                {
                    "id": "3540403",
                    "speaker": "安柏",
                    "text": "你不是蒙德市民吧？那么，请说明自己的身份！"
                },
                {
                    "id": "3540404",
                    "speaker": "派蒙",
                    "text": "冷静一下，我们不是可疑人员——"
                },
                {
                    "id": "3540405",
                    "speaker": "安柏",
                    "text": "可疑人员都会这么说。"
                },
                {
                    "id": "3540406",
                    "speaker": "Player",
                    "text": "#你好，我是{NICKNAME}。"
                },
                {
                    "id": "3540407",
                    "speaker": "安柏",
                    "text": "…听着不像是本地人的名字。"
                },
                {
                    "id": "3540408",
                    "speaker": "安柏",
                    "text": "还有这只…吉祥物，又是怎么回事？",
                    "choices": [
                        {
                            "id": "3540409",
                            "text": "是朋友。",
                            "response": [
                                {
                                    "id": "3540410",
                                    "speaker": "派蒙",
                                    "text": "嗯，虽然是认识才两个月的旅伴…"
                                },
                                {
                                    "id": "3540411",
                                    "speaker": "派蒙",
                                    "text": "但已经是最好的朋友了！"
                                },
                                {
                                    "id": "3540414",
                                    "speaker": "安柏",
                                    "text": "总而言之，是旅行者对吧。"
                                },
                                {
                                    "id": "3540415",
                                    "speaker": "安柏",
                                    "text": "最近蒙德周围有巨龙出没，你们还是尽快进城比较好。"
                                },
                                {
                                    "id": "3540416",
                                    "speaker": "安柏",
                                    "text": "这里离蒙德不远，就由身为骑士的我来护送你们一程。"
                                },
                                {
                                    "id": "3540417",
                                    "speaker": "派蒙",
                                    "text": "欸？你出城没有什么别的任务吗？"
                                },
                                {
                                    "id": "3540418",
                                    "speaker": "安柏",
                                    "text": "当然有，不过放心，任务路上也会保证你们的安全。"
                                },
                                {
                                    "id": "3540419",
                                    "speaker": "安柏",
                                    "text": "而且…我也不能放着可疑人士不管！",
                                    "choices": [
                                        {
                                            "id": "3540420",
                                            "text": "看来你不是很信任我们。",
                                            "response": [
                                                {
                                                    "id": "3540422",
                                                    "speaker": "安柏",
                                                    "text": "呼…失礼了，这不是一位优秀的骑士应有的言辞。"
                                                },
                                                {
                                                    "id": "3540423",
                                                    "speaker": "安柏",
                                                    "text": "我向你们致歉，呃…陌生而可敬的旅人。"
                                                },
                                                {
                                                    "id": "3540424",
                                                    "speaker": "派蒙",
                                                    "text": "好生硬的发言！"
                                                },
                                                {
                                                    "id": "3540425",
                                                    "speaker": "安柏",
                                                    "text": "你是对我们《骑士团指导手册》里的规范用语有什么不满吗？！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3540421",
                                            "text": "这种称呼对客人不礼貌。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3540412",
                            "text": "是应急食品。",
                            "response": [
                                {
                                    "id": "3540413",
                                    "speaker": "派蒙",
                                    "text": "完全不对！怎么还不如吉祥物啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
