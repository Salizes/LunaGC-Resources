    "talks": [
        {
            "id": "7320507",
            "objective": "(test)73204与阿凡闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "732040701",
                    "speaker": "阿凡",
                    "text": "哎呀，我还没来得及做饭，没东西招待你们哟。",
                    "choices": [
                        {
                            "id": "732040702",
                            "text": "不用麻烦。",
                            "response": [
                                {
                                    "id": "732040704",
                                    "speaker": "阿凡",
                                    "text": "另外一个小娃娃是你的朋友吧，有点可爱。"
                                },
                                {
                                    "id": "732040705",
                                    "speaker": "阿凡",
                                    "text": "我种的花开了之后，你们两个要不要来看？"
                                },
                                {
                                    "id": "732040706",
                                    "speaker": "Player",
                                    "text": "好。"
                                },
                                {
                                    "id": "732040707",
                                    "speaker": "阿凡",
                                    "text": "再过阵子它们大概就能开了，你们以后还能来吧，来看看你们帮忙种出来的花嘛。"
                                },
                                {
                                    "id": "732040708",
                                    "speaker": "Player",
                                    "text": "可以。"
                                },
                                {
                                    "id": "732040709",
                                    "speaker": "阿凡",
                                    "text": "好好好，我知道了。"
                                },
                                {
                                    "id": "732040710",
                                    "speaker": "阿凡",
                                    "text": "♪…"
                                }
                            ]
                        },
                        {
                            "id": "732040703",
                            "text": "肚子不饿。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320508",
            "objective": "(test)计时$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320510",
            "objective": "（test）回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320501",
            "objective": "(test)与阿凡对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732050101",
                    "speaker": "阿凡",
                    "text": "来，来，看看这些种子。"
                },
                {
                    "id": "732050102",
                    "speaker": "Player",
                    "text": "好像没什么变化。"
                },
                {
                    "id": "732050103",
                    "speaker": "阿凡",
                    "text": "是啊，虽然我种地种了好多年，但种花跟种地还是不同。"
                },
                {
                    "id": "732050104",
                    "speaker": "阿凡",
                    "text": "要不然，为什么这么久它们都不长呢？"
                },
                {
                    "id": "732050105",
                    "speaker": "派蒙",
                    "text": "我看看，唔…"
                },
                {
                    "id": "732050106",
                    "speaker": "派蒙",
                    "text": "阿凡爷爷，我觉得你的苗圃太干燥了，阿如村附近土地的养分也可能不够。"
                },
                {
                    "id": "732050107",
                    "speaker": "派蒙",
                    "text": "我们之前在村子里帮人种过花，我们有经验。"
                },
                {
                    "id": "732050108",
                    "speaker": "阿凡",
                    "text": "哦，是这样吗…"
                },
                {
                    "id": "732050109",
                    "speaker": "阿凡",
                    "text": "有道理，这么稀有的花种是应该比普通花草娇贵点，我浇水施肥确实不够。"
                },
                {
                    "id": "732050110",
                    "speaker": "阿凡",
                    "text": "不过这块苗圃离水源有点远，取水不方便。"
                },
                {
                    "id": "732050111",
                    "speaker": "阿凡",
                    "text": "我自己储存的日常用水也不多，要常给苗圃里的种子浇水还有点麻烦。"
                },
                {
                    "id": "732050112",
                    "speaker": "Player",
                    "text": "我可以帮忙。"
                },
                {
                    "id": "732050113",
                    "speaker": "阿凡",
                    "text": "好啊，那就先请你们给这三颗种子都浇些水吧。"
                }
            ]
        },
        {
            "id": "7320502",
            "objective": "给花种浇水",
            "dialogues": []
        },
        {
            "id": "7320503",
            "objective": "和阿凡聊聊",
            "dialogues": [
                {
                    "id": "732050301",
                    "speaker": "阿凡",
                    "text": "挺好，挺好，你们两个很有办法啊。"
                },
                {
                    "id": "732050302",
                    "speaker": "阿凡",
                    "text": "我预感，有专业人士指导，这次应该能长好了。"
                },
                {
                    "id": "732050303",
                    "speaker": "阿凡",
                    "text": "之前的烤肉卷和米圆塔好吃不好吃？",
                    "choices": [
                        {
                            "id": "732050304",
                            "text": "好吃。",
                            "response": [
                                {
                                    "id": "732050305",
                                    "speaker": "阿凡",
                                    "text": "好吃我再给你们做点。"
                                },
                                {
                                    "id": "732050307",
                                    "speaker": "阿凡",
                                    "text": "我的手艺没有我家去世的老太婆好，你们不许嫌弃。拿着吧，这次少了点。"
                                },
                                {
                                    "id": "732050308",
                                    "speaker": "派蒙",
                                    "text": "是好吃的！阿凡爷爷，你真好，以后我们也会常来看你的。"
                                },
                                {
                                    "id": "732050309",
                                    "speaker": "阿凡",
                                    "text": "哈哈，你们之前不是想问我，这花是什么花吗？"
                                },
                                {
                                    "id": "732050310",
                                    "speaker": "阿凡",
                                    "text": "告诉你们也不碍事，我种的都是蔷薇。"
                                },
                                {
                                    "id": "732050311",
                                    "speaker": "Player",
                                    "text": "跟须弥蔷薇是同一种花吗？"
                                },
                                {
                                    "id": "732050312",
                                    "speaker": "阿凡",
                                    "text": "这种花叫作「金蔷薇」，哎呀，可比须弥蔷薇宝贝多了。"
                                },
                                {
                                    "id": "732050313",
                                    "speaker": "阿凡",
                                    "text": "我之前说这些花种都是一位朋友留给我的，你们还记得吗？"
                                },
                                {
                                    "id": "732050314",
                                    "speaker": "阿凡",
                                    "text": "其实啊，这些种子、我现在住的这间旧屋子都是死掉的鬼老头留给我的。"
                                },
                                {
                                    "id": "732050315",
                                    "speaker": "阿凡",
                                    "text": "欸，我给忘了，你们不是阿如村的人，肯定不熟悉这个名字。"
                                },
                                {
                                    "id": "732050316",
                                    "speaker": "阿凡",
                                    "text": "不熟悉也好，就把这家伙当成一个会种点花的老头记住，就好了…"
                                },
                                {
                                    "id": "732050317",
                                    "speaker": "阿凡",
                                    "text": "……"
                                },
                                {
                                    "id": "732050318",
                                    "speaker": "派蒙",
                                    "text": "阿凡爷爷突然发起呆来了呢，阿凡爷爷，阿凡爷爷？"
                                },
                                {
                                    "id": "732050319",
                                    "speaker": "阿凡",
                                    "text": "哎哟，我刚才是不是走神了？人年纪大了，注意力不容易集中，叫你们看笑话了。"
                                },
                                {
                                    "id": "732050320",
                                    "speaker": "阿凡",
                                    "text": "这次也谢谢你们两个小娃娃，你们要是还有什么想看的，就到处转转好了。"
                                },
                                {
                                    "id": "732050321",
                                    "speaker": "阿凡",
                                    "text": "我不会再赶人了，不过当心，别踩到苗圃上去。"
                                }
                            ]
                        },
                        {
                            "id": "732050306",
                            "text": "还没尝。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320504",
            "objective": "给花种浇水",
            "dialogues": [
                {
                    "id": "732050401",
                    "speaker": "阿凡",
                    "text": "先给这三颗种子浇点水吧，施肥的事情我再想办法。"
                },
                {
                    "id": "732050402",
                    "speaker": "阿凡",
                    "text": "过了几十年，简单的肥料该怎么做我还是懂的。"
                }
            ]
        },
        {
            "id": "7320505",
            "objective": "给花种浇水",
            "dialogues": [
                {
                    "id": "732050501",
                    "speaker": "阿凡",
                    "text": "♪蔷薇啊蔷薇，实现我的愿望…"
                },
                {
                    "id": "732050502",
                    "speaker": "阿凡",
                    "text": "嗯？你们还在啊。",
                    "choices": [
                        {
                            "id": "732050503",
                            "text": "为什么住在这里？",
                            "response": [
                                {
                                    "id": "732050504",
                                    "speaker": "阿凡",
                                    "text": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。"
                                },
                                {
                                    "id": "732050505",
                                    "speaker": "阿凡",
                                    "text": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。"
                                },
                                {
                                    "id": "732050506",
                                    "speaker": "阿凡",
                                    "text": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。"
                                },
                                {
                                    "id": "732050507",
                                    "speaker": "阿凡",
                                    "text": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。"
                                },
                                {
                                    "id": "732050508",
                                    "speaker": "阿凡",
                                    "text": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。"
                                },
                                {
                                    "id": "732050509",
                                    "speaker": "阿凡",
                                    "text": "拖拖拉拉混到今天，我错过的事情太多。"
                                },
                                {
                                    "id": "732050510",
                                    "speaker": "阿凡",
                                    "text": "回过头发现自己不属于这个村子，也不属于其他任何地方。"
                                },
                                {
                                    "id": "732050511",
                                    "speaker": "阿凡",
                                    "text": "最后结果么，就是我一个人搬到村子边上生活才舒服。"
                                },
                                {
                                    "id": "732050512",
                                    "speaker": "阿凡",
                                    "text": "几十年也就这么回事，算了。"
                                },
                                {
                                    "id": "732050525",
                                    "speaker": "阿凡",
                                    "text": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？"
                                },
                                {
                                    "id": "732050526",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "732050527",
                                    "speaker": "阿凡",
                                    "text": "好好好，我知道了…"
                                },
                                {
                                    "id": "732050528",
                                    "speaker": "阿凡",
                                    "text": "♪蔷薇啊蔷薇，实现我的愿望…"
                                }
                            ]
                        },
                        {
                            "id": "732050513",
                            "text": "关于鬼老头…",
                            "response": [
                                {
                                    "id": "732050514",
                                    "speaker": "阿凡",
                                    "text": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。"
                                },
                                {
                                    "id": "732050515",
                                    "speaker": "阿凡",
                                    "text": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。"
                                },
                                {
                                    "id": "732050516",
                                    "speaker": "阿凡",
                                    "text": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。"
                                },
                                {
                                    "id": "732050517",
                                    "speaker": "阿凡",
                                    "text": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。"
                                },
                                {
                                    "id": "732050518",
                                    "speaker": "阿凡",
                                    "text": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。"
                                },
                                {
                                    "id": "732050519",
                                    "speaker": "Player",
                                    "text": "你们不是朋友吗？"
                                },
                                {
                                    "id": "732050520",
                                    "speaker": "阿凡",
                                    "text": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。"
                                },
                                {
                                    "id": "732050521",
                                    "speaker": "阿凡",
                                    "text": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。"
                                },
                                {
                                    "id": "732050522",
                                    "speaker": "阿凡",
                                    "text": "虽然他不一定认识我，但我还是一直记得他和他的小花园。"
                                },
                                {
                                    "id": "732050523",
                                    "speaker": "阿凡",
                                    "text": "我说他是我的朋友，也不算错，不是吗？"
                                },
                                {
                                    "id": "732050524",
                                    "speaker": "阿凡",
                                    "text": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320506",
            "objective": "(test)73205与阿凡闲聊$HIDDEN",
            "dialogues": []
        }
    ]
}