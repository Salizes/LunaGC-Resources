            "objective": "霄灯-蓝砚$HIDDEN",
            "dialogues": [
                {
                    "id": "711580301",
                    "speaker": "蓝砚",
                    "text": "又编好了一盏，嗯，颜料也晾干了…"
                },
                {
                    "id": "711580302",
                    "speaker": "蓝砚",
                    "text": "#{NICKNAME}，节日好呀。你也是来找我编霄灯的么？",
                    "choices": [
                        {
                            "id": "711580303",
                            "text": "我也放好霄灯啦。",
                            "response": [
                                {
                                    "id": "711580305",
                                    "speaker": "蓝砚",
                                    "text": "你也放飞霄灯了？原来你自己准备了啊，我还说编一盏送给你呢。"
                                },
                                {
                                    "id": "711580306",
                                    "speaker": "蓝砚",
                                    "text": "但无论如何，希望我们写在霄灯上的心愿能全部实现。"
                                },
                                {
                                    "id": "711580304",
                                    "speaker": "Player",
                                    "text": "有很多人找你编霄灯么？"
                                },
                                {
                                    "id": "711580307",
                                    "speaker": "蓝砚",
                                    "text": "对呀，萍溪姐姐不是造出了一种可以随意改装的霄灯骨架么？"
                                },
                                {
                                    "id": "711580308",
                                    "speaker": "蓝砚",
                                    "text": "有好多人都去买了一架回家，琢磨着怎么改装呢。喔，嘉明也买了，我说我来帮他编，他还不让呢。"
                                },
                                {
                                    "id": "711580309",
                                    "speaker": "蓝砚",
                                    "text": "有些邻居虽然心里有想法，但却不知道怎么下手，所以就找我帮忙。"
                                },
                                {
                                    "id": "711580310",
                                    "speaker": "蓝砚",
                                    "text": "把大家的霄灯编好了之后，我也给自己编了一盏呢。"
                                },
                                {
                                    "id": "711580311",
                                    "speaker": "蓝砚",
                                    "text": "接下来就是放飞霄灯了，嗯…该写什么心愿呢…"
                                },
                                {
                                    "id": "711580312",
                                    "speaker": "Black Screen",
                                    "text": "与蓝砚一同放飞了霄灯…"
                                }
                            ]
                        },
                        {
                            "id": "711580304",
                            "text": "有很多人找你编霄灯么？"
                        }
