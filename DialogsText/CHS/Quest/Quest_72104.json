        {
            "id": "7210439",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721043901",
                    "speaker": "Player",
                    "text": "玄冬小姐今天有什么事吗？"
                },
                {
                    "id": "721043902",
                    "speaker": "玄冬林檎",
                    "text": "我…啊？欸？您问我吗？"
                },
                {
                    "id": "721043903",
                    "speaker": "玄冬林檎",
                    "text": "嗯嗯嗯…最近我比较忙！但如果您、您愿意的话，我看看安排…",
                    "choices": [
                        {
                            "id": "721043904",
                            "text": "你会错意了…",
                            "response": [
