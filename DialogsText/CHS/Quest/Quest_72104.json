            "dialogues": []
        },
        {
            "id": "7210423",
            "objective": "（test）判定说过特殊分支1$HIDDEN",
            "dialogues": [
                {
                    "id": "721043801",
                    "speaker": "Player",
                    "text": "玄冬小姐今天心情很好？"
                },
                {
                    "id": "721043802",
                    "speaker": "玄冬林檎",
                    "text": "嗯？有什么问题吗？"
                },
                {
                    "id": "721043803",
                    "speaker": "Player",
                    "text": "感觉和平时的气场不太一样…"
                },
                {
                    "id": "721043804",
                    "speaker": "玄冬林檎",
                    "text": "欸，是这样吗？我会注意的！"
                },
                {
                    "id": "721043805",
                    "speaker": "玄冬林檎",
                    "text": "可能是因为今天我抽到了「大吉」的签吧，感觉心情很好呢！也很想把这份心情跟您分享。"
                },
                {
                    "id": "721043806",
                    "speaker": "玄冬林檎",
                    "text": "不过，对于某些人来说的「大吉」，对另一些人来说却可能意味着「大凶」。"
                },
                {
                    "id": "721043807",
                    "speaker": "玄冬林檎",
                    "text": "那些抽到「大凶」的人…会有什么样的「御签挂」等着他们呢？"
                },
                {
                    "id": "721043808",
                    "speaker": "玄冬林檎",
                    "text": "运势真是很值得玩味呢！再见。"
                }
            ]
        },
        {
            "id": "7210416",
            "objective": "（test）特殊交付talk1$HIDDEN",
            "dialogues": [
                {
                    "id": "721041601",
                    "speaker": "Player",
                    "text": "（交付竹签）「胧夜正中」。"
                },
