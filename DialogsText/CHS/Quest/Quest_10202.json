    "talks": [
        {
            "id": "1020201",
            "objective": "回到西风骑士团向琴汇报",
            "dialogues": [
                {
                    "id": "102020101",
                    "speaker": "派蒙",
                    "text": "啊，可莉也在这里！"
                },
                {
                    "id": "102020102",
                    "speaker": "可莉",
                    "text": "我…呜呜呜，我自首。"
                },
                {
                    "id": "102020103",
                    "speaker": "派蒙",
                    "text": "欸？！"
                },
                {
                    "id": "102020104",
                    "speaker": "可莉",
                    "text": "我…我的炸弹…炸弹炸伤了人。"
                },
                {
                    "id": "102020105",
                    "speaker": "可莉",
                    "text": "呜呜…违反了生存守则，我肯定看不到明天的太阳了…"
                },
                {
                    "id": "102020106",
                    "speaker": "琴",
                    "text": "可莉，你先回答我。伤员呢，伤员人在哪里？"
                },
                {
                    "id": "102020107",
                    "speaker": "Player",
                    "text": "等等，这里有误会。"
                },
                {
                    "id": "102020108",
                    "speaker": "琴",
                    "text": "嗯？"
                },
                {
                    "id": "102020109",
                    "speaker": "Player",
                    "text": "可莉炸飞的，是深渊法师。"
                },
                {
                    "id": "102020110",
                    "speaker": "可莉",
                    "text": "但…但是毛茸茸只是偷了东西而已，我的炸弹却把他给…"
                },
                {
                    "id": "102020111",
                    "speaker": "派蒙",
                    "text": "啊…我之前说深渊法师是「坏人」，只是一种比喻啦…"
                },
                {
                    "id": "102020112",
                    "speaker": "派蒙",
                    "text": "深渊法师不是人类。它们是…唔，与人类为敌的坏家伙。"
                },
                {
                    "id": "102020113",
                    "speaker": "可莉",
                    "text": "毛茸茸…与人类为敌？是坏家伙？"
                },
                {
                    "id": "102020114",
                    "speaker": "可莉",
                    "text": "欸，欸？！脑…脑袋跟不上了…"
                },
                {
                    "id": "102020115",
                    "speaker": "琴",
                    "text": "嗯，这是我的疏忽。"
                },
                {
                    "id": "102020116",
                    "speaker": "琴",
                    "text": "因为你还太小，我之前从没有把这些告诉过你。"
                },
                {
                    "id": "102020117",
                    "speaker": "琴",
                    "text": "实际上，深渊教团的怪物们，是侵扰着蒙德的威胁，最近格外活跃。"
                },
                {
                    "id": "102020118",
                    "speaker": "Player",
                    "text": "难道是因为「最强的宝物」？"
                },
                {
                    "id": "102020119",
                    "speaker": "派蒙",
                    "text": "对哦，我明白了！"
                },
                {
                    "id": "102020120",
                    "speaker": "派蒙",
                    "text": "它们就是听到了宝物的流言，才盯上可莉的呀！"
                },
                {
                    "id": "102020121",
                    "speaker": "派蒙",
                    "text": "就像，就像我最初也会想得到…啊不，想知道这宝贝一样！"
                },
                {
                    "id": "102020122",
                    "speaker": "可莉",
                    "text": "所以…所以说！"
                },
                {
                    "id": "102020123",
                    "speaker": "琴",
                    "text": "看在你这次的功劳上，下次的羽球节，就允许你一起参加吧。"
                },
                {
                    "id": "102020124",
                    "speaker": "可莉",
                    "text": "羽球节！！哇！！",
                    "choices": [
                        {
                            "id": "102020125",
                            "text": "真是歪打正着。",
                            "response": [
                                {
                                    "id": "102020127",
                                    "speaker": "可莉",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}到时候也一定要来哦！"
                                },
                                {
                                    "id": "102020128",
                                    "speaker": "派蒙",
                                    "text": "欸嘿，圆满的结局！"
                                },
                                {
                                    "id": "102020129",
                                    "speaker": "琴",
                                    "text": "不过…"
                                },
                                {
                                    "id": "102020131",
                                    "speaker": "琴",
                                    "text": "可莉，你原先的「宝物」，藏在了哪里？"
                                },
                                {
                                    "id": "102020132",
                                    "speaker": "可莉",
                                    "text": "唔唔！"
                                },
                                {
                                    "id": "102020133",
                                    "speaker": "琴",
                                    "text": "是不是又想去炸星落湖的鱼了？"
                                },
                                {
                                    "id": "102020134",
                                    "speaker": "可莉",
                                    "text": "我，我不是！"
                                },
                                {
                                    "id": "102020135",
                                    "speaker": "派蒙",
                                    "text": "（她在拼命给我们使眼色呢…）"
                                },
                                {
                                    "id": "102020136",
                                    "speaker": "Player",
                                    "text": "（可是琴团长也看得见啊…）"
                                },
                                {
                                    "id": "102020137",
                                    "speaker": "琴",
                                    "text": "可——莉——？"
                                },
                                {
                                    "id": "102020138",
                                    "speaker": "可莉",
                                    "text": "呀！可莉这就去<color=#00E1FFFF>禁闭室</color>报到…呜呜…"
                                },
                                {
                                    "id": "102020139",
                                    "speaker": "派蒙",
                                    "text": "不知道可莉一个人关禁闭，会不会无聊…"
                                }
                            ]
                        },
                        {
                            "id": "102020126",
                            "text": "真为你高兴。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020202",
            "objective": "(test)前往骑士团$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1020203",
            "objective": "(test)与琴谈话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1020204",
            "objective": "寻找骑士团禁闭室的门",
            "dialogues": [
                {
                    "id": "102020401",
                    "speaker": "派蒙",
                    "text": "猜猜我是谁？"
                },
                {
                    "id": "102020402",
                    "speaker": "？？？",
                    "text": "啊，是小派蒙的声音！",
                    "choices": [
                        {
                            "id": "102020403",
                            "text": "要不要我们放你出去？",
                            "response": [
                                {
                                    "id": "102020405",
                                    "speaker": "可莉",
                                    "text": "好呀那就——不，不对，可莉是真心在反省的，不要诱惑我！"
                                },
                                {
                                    "id": "102020406",
                                    "speaker": "可莉",
                                    "text": "禁闭期间，我会留在这里，做羽球节特制版的「宝物」…"
                                },
                                {
                                    "id": "102020407",
                                    "speaker": "派蒙",
                                    "text": "「宝物」…"
                                },
                                {
                                    "id": "102020408",
                                    "speaker": "可莉",
                                    "text": "嘿嘿…我专门做成了羽球的形状呢！很可爱的。",
                                    "choices": [
                                        {
                                            "id": "102020409",
                                            "text": "羽球形状的…",
                                            "response": [
                                                {
                                                    "id": "102020411",
                                                    "speaker": "可莉",
                                                    "text": "等到了羽球节的时候，嗯！大家一定会喜欢的！"
                                                },
                                                {
                                                    "id": "102020412",
                                                    "speaker": "派蒙",
                                                    "text": "唉，要是这段话被琴团长听见了…"
                                                },
                                                {
                                                    "id": "102020413",
                                                    "speaker": "派蒙",
                                                    "text": "她的禁闭时间，估计又要加长了吧…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102020410",
                                            "text": "其实还是炸弹吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102020404",
                            "text": "要给你带点吃的吗？"
                        }
                    ]
                }
            ]
        }
    ]
}