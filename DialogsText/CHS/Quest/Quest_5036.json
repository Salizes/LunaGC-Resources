        }
    },
    "talks": [
        {
            "id": "503601",
            "objective": "(test)发放奖励环$HIDDEN",
            "dialogues": [
                {
                    "id": "50230901",
                    "speaker": "茜特菈莉",
                    "text": "哦，是你们？宴会已经结束了吗？"
                },
                {
                    "id": "50230902",
                    "speaker": "派蒙",
                    "text": "欸？你们也知道宴会的事啊？"
                },
                {
                    "id": "50230903",
                    "speaker": "茜特菈莉",
                    "text": "是哦，虽然我们人不在，但大家想要为你们加油打气的心情都是一样的。"
                },
                {
                    "id": "50230904",
                    "speaker": "茜特菈莉",
                    "text": "古名的话，还差最后一点，希诺宁正在全神贯注地收尾，我们最好不要打扰她。"
                },
                {
                    "id": "50230905",
                    "speaker": "茜特菈莉",
                    "text": "和以往的古名有很多区别，期间也遇到了一些让人头疼的问题，耽误了不少时间。"
                },
                {
                    "id": "50230906",
                    "speaker": "Player",
                    "text": "其实已经很快了。"
                },
                {
                    "id": "50230907",
                    "speaker": "茜特菈莉",
                    "text": "我和她开玩笑说，如果我们能快点的话，说不定能赶上烤肉盛宴最下面的几块骨头。"
                },
                {
                    "id": "50230908",
                    "speaker": "茜特菈莉",
                    "text": "本来我只是想逗逗她，没想到她居然很认真地沉思了一会儿，然后用力点头，开始奋力工作…就像是，被点燃了一样。"
                },
                {
                    "id": "50230909",
                    "speaker": "派蒙",
                    "text": "没想到肉对她的吸引力这么强。"
                },
                {
                    "id": "50230910",
                    "speaker": "茜特菈莉",
                    "text": "可能是他们一族人的特点吧，我估计她现在可能都没注意到时间，还不知道宴会已经结束了呢。"
                },
                {
                    "id": "50230911",
                    "speaker": "派蒙",
                    "text": "那、那我们应该去准备点烤肉？"
                },
                {
                    "id": "50230912",
                    "speaker": "Player",
                    "text": "不然她的期待就落空了。"
                },
                {
                    "id": "50230913",
                    "speaker": "希诺宁",
                    "text": "谢谢你们愿意照顾我的心情，但不必了，从外面的光线也能判断现在的时间。"
                },
                {
                    "id": "50230914",
                    "speaker": "希诺宁",
                    "text": "我要订正一下，我听出来了那是玩笑，只是因为之前我们都在很认真地讨论制作方式，所以我想用这种方法接她的话。"
                },
                {
                    "id": "50230915",
                    "speaker": "茜特菈莉",
                    "text": "……"
                },
                {
                    "id": "50230916",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "50230917",
                    "speaker": "希诺宁",
                    "text": "别、别管这些了，来看看成果吧。"
                },
                {
                    "id": "50230918",
                    "speaker": "派蒙",
                    "text": "哇，古名，你看，是你的古名！"
                },
                {
                    "id": "50230919",
                    "speaker": "希诺宁",
                    "text": "「杜{RUBY#[D]希望}麦尼」，这个音节逐渐从灵魂之河的最底部浮上，其含义为，希望。"
                },
                {
                    "id": "50230920",
                    "speaker": "茜特菈莉",
                    "text": "#很符合{M#他}{F#她}的气质，听上去就像是星星和月亮，为我们在夜晚点亮前路的光。"
                },
                {
                    "id": "50230921",
                    "speaker": "派蒙",
                    "text": "好帅！那那那，这个名字也会有像其他人的那样，很厉害的几句话吗？"
                },
                {
                    "id": "50230922",
                    "speaker": "希诺宁",
                    "text": "#当然会，但那几句话并不是自古名诞生便拥有的，作为初代古名的所有者，话语会在{M#他}{F#她}的冒险中自然而然地浮现。"
                },
                {
                    "id": "50230923",
                    "speaker": "希诺宁",
                    "text": "我想，在你凯旋归来之时，你一定已经领悟了夜神将「杜{RUBY#[D]希望}麦尼」之名赠予你的用意。",
                    "choices": [
                        {
                            "id": "50230924",
                            "text": "眼下万事俱备…",
                            "response": [
                                {
                                    "id": "50230926",
                                    "speaker": "派蒙",
                                    "text": "没想到古名获得还蛮顺利的嘛。"
                                },
                                {
                                    "id": "50230927",
                                    "speaker": "希诺宁",
                                    "text": "毕竟主要依靠的是夜神的力量，这是绝无仅有的特例，我想哪怕是以后的纳塔，也很难再遇到这样的机会。"
                                },
                                {
                                    "id": "50230928",
                                    "speaker": "茜特菈莉",
                                    "text": "要是夜神都帮到这份上了，我们最值得信赖的铸名师也打造不出这个古名，那人类的脸可是丢尽咯。"
                                },
                                {
                                    "id": "50230929",
                                    "speaker": "希诺宁",
                                    "text": "我从来都没怀疑过自己，只是你小说看太多，总想要一些戏剧感。"
                                },
                                {
                                    "id": "50230930",
                                    "speaker": "茜特菈莉",
                                    "text": "别说的我好像不希望你成功一样！我只是活的时间很长，各种事都见得多了！"
                                },
                                {
                                    "id": "50230931",
                                    "speaker": "派蒙",
                                    "text": "好了好了，结果很好嘛。"
                                },
                                {
                                    "id": "50230932",
                                    "speaker": "希诺宁",
                                    "text": "不过在庆祝之前，我们还有最后一步要做。虽然古名的打造已经完成，且通过了所有的测试…"
                                },
                                {
                                    "id": "50230933",
                                    "speaker": "希诺宁",
                                    "text": "但它是否已经归你所有，又是否能在你身上发挥出正常的作用，这还需要检查一下。"
                                },
                                {
                                    "id": "50230934",
                                    "speaker": "茜特菈莉",
                                    "text": "毕竟是前所未有的，属于异乡人的古名，我也会有点担心在两者匹配的时候，会不会发生一些我们从没见过的情况。"
                                },
                                {
                                    "id": "50230935",
                                    "speaker": "派蒙",
                                    "text": "呜哇，也就是说，还不能高兴得太早…"
                                },
                                {
                                    "id": "50230936",
                                    "speaker": "派蒙",
                                    "text": "那确实很有必要检查！这个东西事关重大，一点问题都不能有。"
                                },
                                {
                                    "id": "50230937",
                                    "speaker": "希诺宁",
                                    "text": "嗯，但也不必紧张，这个检查很简单，我们吃完晚饭之后，找个安静的地方试试就好了。"
                                },
                                {
                                    "id": "50230938",
                                    "speaker": "希诺宁",
                                    "text": "#主要是观察{NICKNAME}的灵魂是否能够和地脉连通，过程中会不会产生什么排斥的反应。"
                                },
                                {
                                    "id": "50230939",
                                    "speaker": "茜特菈莉",
                                    "text": "#之前进入夜神之国可以理解为一种「闯入」，而现在，我们需要的是夜神之国能真正地接纳{M#他}{F#她}。"
                                },
                                {
                                    "id": "50230940",
                                    "speaker": "茜特菈莉",
                                    "text": "届时交给我来确认就行了，我是专业的。"
                                },
                                {
                                    "id": "50230941",
                                    "speaker": "Player",
                                    "text": "好的。"
                                },
                                {
                                    "id": "50230942",
                                    "speaker": "希诺宁",
                                    "text": "另外，还有这个夜神赠予你的礼物，「圣夜旅织」，我也还给你。"
                                },
                                {
                                    "id": "50230943",
                                    "speaker": "派蒙",
                                    "text": "欸？没有被消耗掉吗？"
                                },
                                {
                                    "id": "50230944",
                                    "speaker": "希诺宁",
                                    "text": "古名的打造并不需要消耗记忆，不然大家不都会不记得初代的持有者做了什么事吗？"
                                },
                                {
                                    "id": "50230945",
                                    "speaker": "希诺宁",
                                    "text": "以后它仍然是你在纳塔的冒险经历最有力的佐证。"
                                },
                                {
                                    "id": "50230946",
                                    "speaker": "Player",
                                    "text": "谢谢了。"
                                },
                                {
                                    "id": "50230947",
                                    "speaker": "茜特菈莉",
                                    "text": "别说这些客气话了。走吧，先去吃饭，我肚子早就饿坏了。"
                                },
                                {
                                    "id": "50230948",
                                    "speaker": "希诺宁",
                                    "text": "那就去我平时最常去的店里吃烤肉吧。"
                                },
                                {
                                    "id": "50230949",
                                    "speaker": "茜特菈莉",
                                    "text": "你看，烤肉，果然还是馋了。"
                                },
                                {
                                    "id": "50230950",
                                    "speaker": "希诺宁",
                                    "text": "顺便一提，他们家的酒也味道一流。"
                                },
                                {
                                    "id": "50230951",
                                    "speaker": "茜特菈莉",
                                    "text": "那还磨蹭什么，快走吧，你们也来！"
                                },
                                {
                                    "id": "50230952",
                                    "speaker": "Black Screen",
                                    "text": "你们一同享用了美味的烤肉，大概是一整天没有吃饭的缘故，希诺宁和茜特菈莉看上去饿坏了。"
                                },
                                {
                                    "id": "50230953",
                                    "speaker": "Black Screen",
                                    "text": "虽说店家的酒水同样美味，但因为接下来有正事，茜特菈莉相当克制。"
                                },
                                {
                                    "id": "50230954",
                                    "speaker": "Black Screen",
                                    "text": "用餐完毕，希诺宁回家拿检查用的工具，你们和茜特菈莉在屋外等她。"
                                },
                                {
                                    "id": "50230955",
                                    "speaker": "派蒙",
                                    "text": "茜特菈莉，你怎么了，感觉你有心事，连酒都没怎么喝…"
                                },
                                {
                                    "id": "50230956",
                                    "speaker": "茜特菈莉",
                                    "text": "我也没想到，这么大年纪了，居然还有这么沉不住气的时候。"
                                },
                                {
                                    "id": "50230957",
                                    "speaker": "茜特菈莉",
                                    "text": "距离你们出发的日子越近，我就越担心…虽然「古名」已经完成，但「还魂诗」也是要在胜利之后才能生效…"
                                },
                                {
                                    "id": "50230958",
                                    "speaker": "茜特菈莉",
                                    "text": "更别说，火神大人的结局，已经指向了「死亡」。",
                                    "choices": [
                                        {
                                            "id": "50230959",
                                            "text": "我不相信命中注定。",
                                            "response": [
                                                {
                                                    "id": "50230961",
                                                    "speaker": "茜特菈莉",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "50230962",
                                                    "speaker": "茜特菈莉",
                                                    "text": "谢谢，我相信你们。你的话就是我最大的安慰。"
                                                },
                                                {
                                                    "id": "50230963",
                                                    "speaker": "希诺宁",
                                                    "text": "准备好了，走吧…嗯，你们在聊什么？"
                                                },
                                                {
                                                    "id": "50230964",
                                                    "speaker": "派蒙",
                                                    "text": "没什么没什么，茜特菈莉吃撑了，有点不消化。"
                                                },
                                                {
                                                    "id": "50230965",
                                                    "speaker": "茜特菈莉",
                                                    "text": "啊，对！散散步就好了。走吧，吃饱喝足，我们也该去检查古名了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "50230960",
                                            "text": "我会和她一起取得胜利。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "50230925",
                            "text": "只差时机来临了。"
                        }
                    ]
                }
            ]
        }
    ]
}