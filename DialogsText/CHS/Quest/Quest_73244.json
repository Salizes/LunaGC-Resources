        {
            "id": "7324421",
            "objective": "返回婕德的帐篷",
            "dialogues": [
                {
                    "id": "732442101",
                    "speaker": "婕德",
                    "text": "嗯，这里好像也没有什么有用的东西…"
                }
            ]
        },
        {
            "id": "7324408",
            "objective": "将「充能转化容器」交给婕德",
            "dialogues": [
                {
                    "id": "732440801",
                    "speaker": "派蒙",
                    "text": "婕德！"
                },
                {
                    "id": "732440803",
                    "speaker": "婕德",
                    "text": "怎么样，你们没出什么事吧？"
                },
                {
                    "id": "732440802",
                    "speaker": "派蒙",
                    "text": "没有没有，什么事都没有。对了，你看，这些就是「充能转化容器」！"
                }
            ]
        },
        {
            "id": "7324415",
            "objective": "修复奔奔",
            "dialogues": [
                {
                    "id": "732441504",
                    "speaker": "婕德",
                    "text": "原来「充能转化容器」长这样啊…可是，这东西应该怎么用呢…"
                },
                {
                    "id": "732441505",
                    "speaker": "奔奔",
                    "text": "哔…哔哔…"
                },
                {
                    "id": "732441506",
                    "speaker": "婕德",
                    "text": "奔奔？"
                },
                {
                    "id": "732441507",
                    "speaker": "Black Screen",
                    "text": "奔奔链接上了「充能转化容器」，以很快的速度汲取了其中的能量。"
                },
                {
                    "id": "732441508",
                    "speaker": "奔奔",
                    "text": "哔哔——哔哔——"
                },
                {
                    "id": "732441509",
                    "speaker": "派蒙",
                    "text": "哇，奔奔复活了！"
                },
                {
                    "id": "732441510",
                    "speaker": "婕德",
                    "text": "说什么傻话，奔奔之前都在睡觉，现在只是醒过来了而已啦！"
                },
                {
                    "id": "732441511",
                    "speaker": "奔奔",
                    "text": "哔哔…哔哔…"
                },
                {
                    "id": "732441512",
                    "speaker": "婕德",
                    "text": "没有，我才没有担心呢，我知道你总有一天能恢复过来的！"
                },
                {
                    "id": "732441513",
                    "speaker": "派蒙",
                    "text": "哼，「把它独自留在别处这种事，有一次就够了…」"
                },
                {
                    "id": "732441514",
                    "speaker": "婕德",
                    "text": "派蒙不许学我说话！"
                },
                {
                    "id": "732441515",
                    "speaker": "奔奔",
                    "text": "哔哔——"
                },
                {
                    "id": "732441516",
                    "speaker": "婕德",
                    "text": "#啊，对了，{NICKNAME}，奔奔说谢谢你。"
                },
                {
                    "id": "732441517",
                    "speaker": "婕德",
                    "text": "看来就算躺着不动，但是你们做的事奔奔也能知道。"
                },
                {
                    "id": "732441518",
                    "speaker": "Player",
                    "text": "不用谢，奔奔。"
                },
                {
                    "id": "732441519",
                    "speaker": "奔奔",
                    "text": "哔哔！"
                },
                {
                    "id": "732441520",
                    "speaker": "婕德",
                    "text": "唔…"
                },
                {
                    "id": "732441521",
                    "speaker": "派蒙",
                    "text": "怎么了，婕德？"
                },
                {
                    "id": "732441522",
                    "speaker": "婕德",
                    "text": "虽然醒了过来，不过看上去奔奔还是需要恢复一下…"
                },
                {
                    "id": "732441523",
                    "speaker": "派蒙",
                    "text": "嗯，要好好休息呀，奔奔！"
                },
                {
                    "id": "732441524",
                    "speaker": "奔奔",
                    "text": "哔哔…"
                }
            ]
        },
