            "dialogues": [
                {
                    "id": "732441901",
                    "speaker": "婕德",
                    "text": "「充能转化容器」，希望拿到那个东西以后，就能够让奔奔恢复过来…"
                },
                {
                    "id": "732441902",
                    "speaker": "婕德",
                    "text": "如果实在不安心的话，我也一起去吧。",
                    "choices": [
                        {
                            "id": "732441903",
                            "text": "你在这里陪奔奔吧。",
                            "response": [
                                {
                                    "id": "732441905",
                                    "speaker": "婕德",
                                    "text": "嗯，那我就在这里等你的好消息，一定要安全回来！"
                                }
                            ]
                        },
                        {
                            "id": "732441904",
                            "text": "我们马上就会回来的。"
                        }
                    ]
                }
            ]
        },
