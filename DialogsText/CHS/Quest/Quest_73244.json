    "talks": [
        {
            "id": "7324423",
            "objective": "(test)等待至次日$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7324401",
            "objective": "与婕德对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732440101",
                    "speaker": "婕德",
                    "text": "怎么会…我居然忘记了…"
                },
                {
                    "id": "732440102",
                    "speaker": "婕德",
                    "text": "希望还来得及，至少，得去他的帐篷里先找一找…"
                },
                {
                    "id": "732440103",
                    "speaker": "派蒙",
                    "text": "婕德！咦，怎么了，你现在正要去哪吗？"
                },
                {
                    "id": "732440104",
                    "speaker": "婕德",
                    "text": "#派蒙，还有{NICKNAME}…你们倒是来的正好，嗯，我现在得立刻去办件事情，我要去…阿德菲住的地方。"
                },
                {
                    "id": "732440105",
                    "speaker": "派蒙",
                    "text": "阿德菲？"
                },
                {
                    "id": "732440106",
                    "speaker": "派蒙",
                    "text": "那个家伙不是和愚人众勾搭在一起的叛徒吗…哦！我懂了，你是想去搜刮他的帐篷！"
                },
                {
                    "id": "732440107",
                    "speaker": "婕德",
                    "text": "不，我对那家伙留下来的东西毫无兴趣。"
                },
                {
                    "id": "732440108",
                    "speaker": "婕德",
                    "text": "部族对这些叛徒遗留的东西应当如何处置有特定的规矩，哼…要不是因为这个，我恨不得把那家伙留下的东西全部烧光。"
                },
                {
                    "id": "732440109",
                    "speaker": "婕德",
                    "text": "我要去他的帐篷是因为…"
                },
                {
                    "id": "732440110",
                    "speaker": "Player",
                    "text": "是因为奔奔吧…"
                },
                {
                    "id": "732440111",
                    "speaker": "派蒙",
                    "text": "啊，对哦！奔奔在阿德菲那里，这可怎么办！"
                },
                {
                    "id": "732440112",
                    "speaker": "派蒙",
                    "text": "呜，婕德，你怎么把奔奔交给了那样的家伙呀！"
                },
                {
                    "id": "732440113",
                    "speaker": "婕德",
                    "text": "唉，在、在那之前，我也不知道他是叛徒啊！"
                },
                {
                    "id": "732440114",
                    "speaker": "婕德",
                    "text": "总之，得快点去阿德菲那里看看才行…"
                },
                {
                    "id": "732440115",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们也一起去吧。",
                    "choices": [
                        {
                            "id": "732440116",
                            "text": "事不宜迟…",
                            "response": [
                                {
                                    "id": "732440118",
                                    "speaker": "派蒙",
                                    "text": "嗯，奔奔可千万别出事呀…"
                                }
                            ]
                        },
                        {
                            "id": "732440117",
                            "text": "现在就出发吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7324402",
            "objective": "到达阿德菲的帐篷寻找线索",
            "dialogues": []
        },
        {
            "id": "7324419",
            "objective": "查看状态失常的奔奔",
            "dialogues": [
                {
                    "id": "732441001",
                    "speaker": "派蒙",
                    "text": "啊，是奔奔！"
                },
                {
                    "id": "732441002",
                    "speaker": "婕德",
                    "text": "幸好阿德菲还没来得及把奔奔带走…"
                },
                {
                    "id": "732441003",
                    "speaker": "婕德",
                    "text": "不如说，这里的东西都跟之前一模一样，根本没有变化。"
                },
                {
                    "id": "732441004",
                    "speaker": "婕德",
                    "text": "这家伙不会以为自己能够成功推翻主母，然后安然无恙地回到自己的帐篷里吧…？真是自大的蠢货。"
                },
                {
                    "id": "732441005",
                    "speaker": "婕德",
                    "text": "不过也多亏了这份愚蠢，奔奔才没出什么事。"
                },
                {
                    "id": "732441006",
                    "speaker": "派蒙",
                    "text": "这也叫没出什么事吗…奔奔，奔奔…",
                    "choices": [
                        {
                            "id": "732441007",
                            "text": "怎么会变成这样…",
                            "response": [
                                {
                                    "id": "732441009",
                                    "speaker": "派蒙",
                                    "text": "对啊，它怎么躺在地上…"
                                },
                                {
                                    "id": "732441010",
                                    "speaker": "派蒙",
                                    "text": "奔奔到底出了什么事呀，上次见到的时候还好好的呢…"
                                },
                                {
                                    "id": "732441011",
                                    "speaker": "婕德",
                                    "text": "奔奔…在离开圣显厅之后，就逐渐变得虚弱起来了，看上去像是有什么地方出了故障，发出的声音也越来越小…"
                                },
                                {
                                    "id": "732441012",
                                    "speaker": "婕德",
                                    "text": "直到发不出声音，甚至也没法移动，就像是，拥有的生命力一点一点流失掉了一样。"
                                },
                                {
                                    "id": "732441013",
                                    "speaker": "婕德",
                                    "text": "那个时候，整个部族里，除了阿德菲，没人对奔奔身上发生什么有概念。"
                                },
                                {
                                    "id": "732441014",
                                    "speaker": "婕德",
                                    "text": "所以我就把奔奔放在了阿德菲这里…"
                                },
                                {
                                    "id": "732441015",
                                    "speaker": "派蒙",
                                    "text": "怎么会这样…奔奔，奔奔不会就这样再也醒不了了吧。"
                                },
                                {
                                    "id": "732441016",
                                    "speaker": "婕德",
                                    "text": "……"
                                },
                                {
                                    "id": "732441017",
                                    "speaker": "婕德",
                                    "text": "总之，奔奔既然还在，总有一天能找到让它恢复的办法…"
                                },
                                {
                                    "id": "732441018",
                                    "speaker": "派蒙",
                                    "text": "可像这样，一点头绪都没有…"
                                },
                                {
                                    "id": "732441019",
                                    "speaker": "婕德",
                                    "text": "我想想，我记得上次阿德菲还和我说，不是什么很严重的问题，这两天就能够出结果…"
                                },
                                {
                                    "id": "732441020",
                                    "speaker": "婕德",
                                    "text": "按这家伙的习惯，如果做了什么检查，肯定会留下什么记录才对。我们在周围先找找看吧！"
                                },
                                {
                                    "id": "732441021",
                                    "speaker": "婕德",
                                    "text": "如果不是什么「严重的问题」的话，说不定我们也能解决一下！"
                                }
                            ]
                        },
                        {
                            "id": "732441008",
                            "text": "奔奔…它怎么了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7324420",
            "objective": "在帐篷内进行调查",
            "dialogues": [
                {
                    "id": "732442001",
                    "speaker": "奔奔",
                    "text": "（奔奔，躺在地上…并没有发出熟悉的「哔哔」声。）"
                }
            ]
        },
        {
            "id": "7324403",
            "objective": "查看信件",
            "dialogues": [
                {
                    "id": "732440301",
                    "speaker": "派蒙",
                    "text": "快看，这里好像有点东西。"
                },
                {
                    "id": "732440302",
                    "speaker": "派蒙",
                    "text": "不过看上去不像是一份什么检查记录，而是一封信…"
                },
                {
                    "id": "732440303",
                    "speaker": "婕德",
                    "text": "什么信，快打开看看吧！"
                },
                {
                    "id": "732440304",
                    "speaker": "派蒙",
                    "text": "看这封信上的意思，奔奔原来只是没有能量了…"
                },
                {
                    "id": "732440305",
                    "speaker": "派蒙",
                    "text": "这么一想，不管是打开赤王陵的大门，还是为我们激活了权限，奔奔在一路上帮我们做了很多事…"
                },
                {
                    "id": "732440306",
                    "speaker": "婕德",
                    "text": "就算是奔奔，也会觉得累吧…可能就是因为为我们做了那么多事，所以它才失去了能量。"
                },
                {
                    "id": "732440307",
                    "speaker": "婕德",
                    "text": "上面提到有什么特殊的「充能转化容器」，可是帐篷里好像没有看到类似的东西。"
                },
                {
                    "id": "732440308",
                    "speaker": "婕德",
                    "text": "难道说…",
                    "choices": [
                        {
                            "id": "732440309",
                            "text": "藏在某个地方？",
                            "response": [
                                {
                                    "id": "732440310",
                                    "speaker": "婕德",
                                    "text": "不太像，只是用来维修奔奔的话，也不用特地藏起来，直接使用不就好了…"
                                },
                                {
                                    "id": "732440311",
                                    "speaker": "婕德",
                                    "text": "我明白了！一定是这场交易还没发生！"
                                },
                                {
                                    "id": "732440314",
                                    "speaker": "婕德",
                                    "text": "所以奔奔没被阿德菲带到交易现场，当然也没有「充能转化容器」…那剩下的问题只有一个了，阿德菲交易的对象是谁？"
                                },
                                {
                                    "id": "732440315",
                                    "speaker": "婕德",
                                    "text": "哈，真是问了个蠢问题，会和他在部落外做这种交易的恐怕只有一类人了…",
                                    "choices": [
                                        {
                                            "id": "732440316",
                                            "text": "是须弥的学者？",
                                            "response": [
                                                {
                                                    "id": "732440317",
                                                    "speaker": "婕德",
                                                    "text": "是愚人众啦！"
                                                },
                                                {
                                                    "id": "732440320",
                                                    "speaker": "派蒙",
                                                    "text": "那我们现在怎么办？"
                                                },
                                                {
                                                    "id": "732440321",
                                                    "speaker": "婕德",
                                                    "text": "还能怎么办，跟那群愚人众还有什么好话可说，当然是到了交易地点，把那些「充能转化容器」抢过来！"
                                                },
                                                {
                                                    "id": "732440322",
                                                    "speaker": "派蒙",
                                                    "text": "好欸，抢过来！"
                                                },
                                                {
                                                    "id": "732440323",
                                                    "speaker": "婕德",
                                                    "text": "可是奔奔…奔奔现在的状态，没法携带在身上，当然也不可能带去交易现场…"
                                                },
                                                {
                                                    "id": "732440324",
                                                    "speaker": "婕德",
                                                    "text": "如果放在别的地方，也并不安全。把它独自留在别处这种事…有一次就够了。"
                                                },
                                                {
                                                    "id": "732440325",
                                                    "speaker": "派蒙",
                                                    "text": "#那就这样好了，我和{NICKNAME}去抢愚人众，你和奔奔在这里等着！",
                                                    "choices": [
                                                        {
                                                            "id": "732440326",
                                                            "text": "好耶！",
                                                            "response": [
                                                                {
                                                                    "id": "732440327",
                                                                    "speaker": "派蒙",
                                                                    "text": "好耶！我们去抢愚人众！"
                                                                },
                                                                {
                                                                    "id": "732440330",
                                                                    "speaker": "婕德",
                                                                    "text": "#虽然很想自己去，但是…{NICKNAME}，派蒙，奔奔能不能恢复，就拜托你们了！"
                                                                },
                                                                {
                                                                    "id": "732440331",
                                                                    "speaker": "婕德",
                                                                    "text": "以及，虽然对方只是一些愚人众，但是也要注意安全…"
                                                                },
                                                                {
                                                                    "id": "732440332",
                                                                    "speaker": "派蒙",
                                                                    "text": "没事的！就放心交给我们吧！"
                                                                },
                                                                {
                                                                    "id": "732440333",
                                                                    "speaker": "婕德",
                                                                    "text": "嗯，我也…不能让奔奔留在阿德菲这个叛徒这里，我先把它带到我那边。"
                                                                },
                                                                {
                                                                    "id": "732440334",
                                                                    "speaker": "婕德",
                                                                    "text": "等拿到「充能转化容器」，就在我的帐篷那会合吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732440328",
                                                            "text": "抢愚人众！",
                                                            "response": [
                                                                {
                                                                    "id": "732440329",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯嗯，反正也不是第一次啦！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732440318",
                                            "text": "是愚人众！",
                                            "response": [
                                                {
                                                    "id": "732440319",
                                                    "speaker": "婕德",
                                                    "text": "想也知道，不会有别人了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732440312",
                            "text": "还没有拿到？",
                            "response": [
                                {
                                    "id": "732440313",
                                    "speaker": "婕德",
                                    "text": "啊，我明白你的意思了，这场交易还没有发生！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7324410",
            "objective": "前往信件中的密会地点",
            "dialogues": []
        },
        {
            "id": "7324414",
            "objective": "在密会地点进行等待",
            "dialogues": []
        },
        {
            "id": "7324406",
            "objective": "击败愚人众",
            "dialogues": []
        },
        {
            "id": "7324417",
            "objective": "与愚人众交易人员对话",
            "dialogues": [
                {
                    "id": "732441701",
                    "speaker": "愚人众交易人员",
                    "text": "别、别打了…"
                },
                {
                    "id": "732441702",
                    "speaker": "愚人众交易人员",
                    "text": "快停手吧，再打下去真的要出人命了…"
                },
                {
                    "id": "732441703",
                    "speaker": "派蒙",
                    "text": "被打的人说这话还真有说服力。"
                },
                {
                    "id": "732441704",
                    "speaker": "派蒙",
                    "text": "说！"
                },
                {
                    "id": "732441705",
                    "speaker": "Player",
                    "text": "快说！"
                },
                {
                    "id": "732441706",
                    "speaker": "愚人众交易人员",
                    "text": "我说我说，你们想知道什么我都说！"
                },
                {
                    "id": "732441707",
                    "speaker": "派蒙",
                    "text": "先说说你知道什么！"
                },
                {
                    "id": "732441708",
                    "speaker": "愚人众交易人员",
                    "text": "我、我们只是一直和阿德菲做一些交易而已…据说塔尼特的主母偏爱什么阿萨里格…还有那个新来的小姑娘…"
                },
                {
                    "id": "732441709",
                    "speaker": "愚人众交易人员",
                    "text": "哼，虽说不知怎么回事，阿萨里格似乎也失踪了…"
                },
                {
                    "id": "732441710",
                    "speaker": "愚人众交易人员",
                    "text": "那个女人心狠手辣，不会容留对部族失去价值的人…所以，阿德菲为了保证自己的地位联系了我们…"
                },
                {
                    "id": "732441711",
                    "speaker": "愚人众交易人员",
                    "text": "之前我们在沙漠里的工作开展一直不是很顺利，这下倒是、倒是有点一拍即合的意思。",
                    "choices": [
                        {
                            "id": "732441712",
                            "text": "失去价值…你是什么意思？",
                            "response": [
                                {
                                    "id": "732441713",
                                    "speaker": "愚人众交易人员",
                                    "text": "我不知道…我真的不知道！那是他们沙漠人内部的事务…不过要我猜的话，可能是因为那个女人认为我们不可信任了…"
                                },
                                {
                                    "id": "732441714",
                                    "speaker": "愚人众交易人员",
                                    "text": "…所以她才会疏远我们，而经常与我们联络的阿德菲也为此不安…"
                                },
                                {
                                    "id": "732441715",
                                    "speaker": "愚人众交易人员",
                                    "text": "毕竟我们还能撤离这个鬼地方，而他只能被榨干价值，然后任部落处置…"
                                },
                                {
                                    "id": "732441724",
                                    "speaker": "愚人众交易人员",
                                    "text": "只是阿德菲这个人异常狡猾，他要的东西我们给了不少，我们要的东西却一点眉目没有…"
                                },
                                {
                                    "id": "732441725",
                                    "speaker": "愚人众交易人员",
                                    "text": "不过听说他出事了…虽然不知道出了什么事，但我们想，这不正好是个好机会…"
                                },
                                {
                                    "id": "732441726",
                                    "speaker": "派蒙",
                                    "text": "好机会？什么好机会？"
                                },
                                {
                                    "id": "732441727",
                                    "speaker": "愚人众交易人员",
                                    "text": "我们估计之后也没有什么和阿德菲做交易的机会，所以就让他带上前几次信里说的什么特殊元能构装体…"
                                },
                                {
                                    "id": "732441728",
                                    "speaker": "愚人众交易人员",
                                    "text": "如果可以就夺过来，等过几天我们完全撤离了以后，也不算毫无所得…"
                                },
                                {
                                    "id": "732441729",
                                    "speaker": "派蒙",
                                    "text": "什么，原来你们也想来抢东西，怪不得，既没有货物也没看见那些「充能转化容器」。"
                                },
                                {
                                    "id": "732441730",
                                    "speaker": "愚人众交易人员",
                                    "text": "啊？「也」想来抢东西？",
                                    "choices": [
                                        {
                                            "id": "732441731",
                                            "text": "对，快把「充能转化容器」交出来。",
                                            "response": [
                                                {
                                                    "id": "732441733",
                                                    "speaker": "派蒙",
                                                    "text": "唔，不会那个什么「充能转化容器」也是你们编的吧！"
                                                },
                                                {
                                                    "id": "732441734",
                                                    "speaker": "愚人众交易人员",
                                                    "text": "不，「充能转化容器」倒是真的，不过因为也是古代的东西，有很多，但不知道其中有没有能用的…"
                                                },
                                                {
                                                    "id": "732441735",
                                                    "speaker": "派蒙",
                                                    "text": "那这些「充能转化容器」在什么地方？"
                                                },
                                                {
                                                    "id": "732441736",
                                                    "speaker": "Player",
                                                    "text": "派蒙的气势真不错。"
                                                },
                                                {
                                                    "id": "732441737",
                                                    "speaker": "派蒙",
                                                    "text": "#嘿嘿，是嘛…{NICKNAME}不要转移话题啦…"
                                                },
                                                {
                                                    "id": "732441738",
                                                    "speaker": "派蒙",
                                                    "text": "快，快把你们放东西的地点说出来。"
                                                },
                                                {
                                                    "id": "732441739",
                                                    "speaker": "愚人众交易人员",
                                                    "text": "…就在附近的一个据点，这个就是据点的钥匙…我知道的我全告诉你们了…",
                                                    "choices": [
                                                        {
                                                            "id": "732441740",
                                                            "text": "走吧！",
                                                            "response": [
                                                                {
                                                                    "id": "732441742",
                                                                    "speaker": "愚人众交易人员",
                                                                    "text": "好好好，我这就消失。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732441741",
                                                            "text": "别让我们再看见你！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732441732",
                                            "text": "遇上我们算你运气不好。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732441716",
                            "text": "你们在沙漠里的工作…？",
                            "response": [
                                {
                                    "id": "732441717",
                                    "speaker": "愚人众交易人员",
                                    "text": "…机密。"
                                },
                                {
                                    "id": "732441718",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "732441719",
                                    "speaker": "派蒙",
                                    "text": "#你瞧，你惹{NICKNAME}生气啦！{M#他}{F#她}生气的后果很严重哦！"
                                },
                                {
                                    "id": "732441720",
                                    "speaker": "愚人众交易人员",
                                    "text": "唔…！好吧，好吧！请别生气，我说就是了！虽然…虽然我知道的也不多…"
                                },
                                {
                                    "id": "732441721",
                                    "speaker": "愚人众交易人员",
                                    "text": "我们的任务是调查沙漠住民各部落现状，以贸易的方式拉拢和渗透他们，吸引贤者注意…为须弥城内的执行官大人提供方便。"
                                },
                                {
                                    "id": "732441722",
                                    "speaker": "愚人众交易人员",
                                    "text": "另外…佛罗德洛克教授也在沙漠里寻找活体样本，他一向不服从「博士」大人的领导…要我说，这就是嫉妒…"
                                },
                                {
                                    "id": "732441723",
                                    "speaker": "愚人众交易人员",
                                    "text": "咳咳，扯多了、扯多了…总之，阿德菲是我们的联络人，我们的物资交易一直由他负责。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
