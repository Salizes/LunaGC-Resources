    "talks": [
        {
            "id": "1200303",
            "objective": "前往「飞云商会」的仓库",
            "dialogues": []
        },
        {
            "id": "1200304",
            "objective": "和行秋交谈",
            "dialogues": [
                {
                    "id": "120030401",
                    "speaker": "行秋",
                    "text": "最后一出好戏，可不能缺了你们两位重要的看客。"
                },
                {
                    "id": "120030402",
                    "speaker": "派蒙",
                    "text": "说得轻松，我们在跑这儿跑那儿的时候，你又干了什么啊？"
                },
                {
                    "id": "120030403",
                    "speaker": "行秋",
                    "text": "这个嘛…当然是好好读完了《神霄折戟录》，度过了一段美妙的时光。"
                },
                {
                    "id": "120030404",
                    "speaker": "行秋",
                    "text": "神戟与邪剑，弥耳与未央…"
                },
                {
                    "id": "120030405",
                    "speaker": "行秋",
                    "text": "前五卷故事的展开，还可以说它「奇」，或是「妙」，但这第六卷，已经找不到合适的形容了。"
                },
                {
                    "id": "120030426",
                    "speaker": "行秋",
                    "text": "这世上，也就那位奇人，能写出这样的奇作吧。"
                },
                {
                    "id": "120030427",
                    "speaker": "派蒙",
                    "text": "但这和茂才公的事，有什么关系吗？"
                },
                {
                    "id": "120030406",
                    "speaker": "行秋",
                    "text": "我只是感叹一下。毕竟，「出乎意料」是特别少见的事。",
                    "choices": [
                        {
                            "id": "120030407",
                            "text": "事情都被你算到了。",
                            "response": [
                                {
                                    "id": "120030408",
                                    "speaker": "行秋",
                                    "text": "也多亏你的帮助，我的预想才会实现。"
                                },
                                {
                                    "id": "120030411",
                                    "speaker": "派蒙",
                                    "text": "什、什么？这…这种「只有我不明白」的气氛！"
                                },
                                {
                                    "id": "120030412",
                                    "speaker": "派蒙",
                                    "text": "那…那为什么你说要在仓库这里看好戏呢？"
                                },
                                {
                                    "id": "120030413",
                                    "speaker": "行秋",
                                    "text": "试想一下，茂才公跑遍整个璃月港，也买不到半个石珀。"
                                },
                                {
                                    "id": "120030414",
                                    "speaker": "行秋",
                                    "text": "他担惊受怕，没有材料就完成不了契约，完成不了契约，就会得罪「愚人众」。"
                                },
                                {
                                    "id": "120030415",
                                    "speaker": "行秋",
                                    "text": "惶恐之中他听到了「飞云商会」的名字，一下子变得气急败坏。"
                                },
                                {
                                    "id": "120030416",
                                    "speaker": "行秋",
                                    "text": "茂才公有权有势，什么时候被这样针对过？"
                                },
                                {
                                    "id": "120030417",
                                    "speaker": "行秋",
                                    "text": "不管是想出气，还是要解决问题，他都要…"
                                },
                                {
                                    "id": "120030418",
                                    "speaker": "茂才公",
                                    "text": "原来是你们，就是你们在帮常九爷出头吧！"
                                },
                                {
                                    "id": "120030419",
                                    "speaker": "行秋",
                                    "text": "你们看，说来就来了。"
                                },
                                {
                                    "id": "120030420",
                                    "speaker": "茂才公",
                                    "text": "我跑了一大圈，到哪里都买不到石珀，这才知道是「飞云商会」在大肆收购。"
                                },
                                {
                                    "id": "120030421",
                                    "speaker": "茂才公",
                                    "text": "这明明不是什么稀有矿物，却一下子断了货，你们这是存心针对我？"
                                },
                                {
                                    "id": "120030422",
                                    "speaker": "行秋",
                                    "text": "并非针对，只是报恩而已。路见不平拔刀相助，再正常不过了。"
                                },
                                {
                                    "id": "120030423",
                                    "speaker": "行秋",
                                    "text": "我记得是你们的人说的吧，这件事不会就这么完了。"
                                },
                                {
                                    "id": "120030424",
                                    "speaker": "茂才公",
                                    "text": "哼，真不知好歹，那我也不废话了。"
                                },
                                {
                                    "id": "120030425",
                                    "speaker": "茂才公",
                                    "text": "大人，靠你了，把这里的石珀全部抢走！"
                                }
                            ]
                        },
                        {
                            "id": "120030409",
                            "text": "书的结局好看吗？",
                            "response": [
                                {
                                    "id": "120030410",
                                    "speaker": "行秋",
                                    "text": "挺不错的…希望这边的结局也能合乎我的期待。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200305",
            "objective": "击退帮助茂才公的愚人众",
            "dialogues": []
        },
        {
            "id": "1200310",
            "objective": "(test)击退债务处理人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200307",
            "objective": "击退债务处理人",
            "dialogues": []
        },
        {
            "id": "1200311",
            "objective": "(test)击退债务处理人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200308",
            "objective": "击退债务处理人",
            "dialogues": [
                {
                    "id": "120030801",
                    "speaker": "债务处理人",
                    "text": "有两下子，不是泛泛之辈…这样打下去，损失就难以接受了。"
                },
                {
                    "id": "120030802",
                    "speaker": "茂才公",
                    "text": "他们快坚持不住了，继续上啊！把石珀都抢过来！"
                },
                {
                    "id": "120030803",
                    "speaker": "债务处理人",
                    "text": "愚人众和你本来就只有生意上的合作关系，我可没有让你带着我的人去寻衅滋事，惹下这种麻烦。"
                },
                {
                    "id": "120030804",
                    "speaker": "茂才公",
                    "text": "说…说什么呢？大人，我、我这也不是为了完成订单嘛！"
                },
                {
                    "id": "120030805",
                    "speaker": "债务处理人",
                    "text": "订单的事，自己想办法吧。"
                },
                {
                    "id": "120030806",
                    "speaker": "茂才公",
                    "text": "别、别走啊！喂！喂！大人！"
                },
                {
                    "id": "120030807",
                    "speaker": "阿旭",
                    "text": "少爷？！你怎么在这里？没有受伤吧？"
                },
                {
                    "id": "120030808",
                    "speaker": "行秋",
                    "text": "#有这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_XIABOY|INFO_FEMALE_PRONOUN_XIAGIRL]}相助，所幸无恙。"
                },
                {
                    "id": "120030809",
                    "speaker": "派蒙",
                    "text": "少爷？！",
                    "choices": [
                        {
                            "id": "120030810",
                            "text": "少爷？！",
                            "response": [
                                {
                                    "id": "120030812",
                                    "speaker": "茂才公",
                                    "text": "你、你就是「飞云商会」的少爷？"
                                },
                                {
                                    "id": "120030813",
                                    "speaker": "行秋",
                                    "text": "在下行不更名坐不改姓，古华派弟子，暨「飞云商会」掌柜次子，行秋。"
                                },
                                {
                                    "id": "120030814",
                                    "speaker": "茂才公",
                                    "text": "该死，居然被你算计了…"
                                },
                                {
                                    "id": "120030815",
                                    "speaker": "行秋",
                                    "text": "茂才公，强抢这种事对生意人来说太不体面了吧，不如还是用生意的办法解决。"
                                },
                                {
                                    "id": "120030816",
                                    "speaker": "行秋",
                                    "text": "没有这石珀，「愚人众」会把你怎么样，需要我帮你想象一下吗？"
                                },
                                {
                                    "id": "120030817",
                                    "speaker": "茂才公",
                                    "text": "可恶…说吧，你要怎么样才肯卖给我！"
                                },
                                {
                                    "id": "120030818",
                                    "speaker": "行秋",
                                    "text": "既然你和常九爷开的是三折，那一报还一报。"
                                },
                                {
                                    "id": "120030819",
                                    "speaker": "行秋",
                                    "text": "市场价的三倍，怎么样？"
                                },
                                {
                                    "id": "120030820",
                                    "speaker": "茂才公",
                                    "text": "你趁火打劫！欺人太甚！你…你…！"
                                },
                                {
                                    "id": "120030821",
                                    "speaker": "行秋",
                                    "text": "叫唤得这么厉害，买还是不买啊？"
                                },
                                {
                                    "id": "120030822",
                                    "speaker": "茂才公",
                                    "text": "我…唉，好好好，我答应你，我去筹钱，行了吧！"
                                },
                                {
                                    "id": "120030823",
                                    "speaker": "行秋",
                                    "text": "感谢贵客惠顾「飞云商会」，今后的生意也望多多关照了。"
                                },
                                {
                                    "id": "120030824",
                                    "speaker": "派蒙",
                                    "text": "你你你你你你居然是「飞云商会」的少爷？！"
                                },
                                {
                                    "id": "120030825",
                                    "speaker": "派蒙",
                                    "text": "我们用的那哗啦啦点都点不清楚的摩拉，都是从你的金库——"
                                },
                                {
                                    "id": "120030826",
                                    "speaker": "行秋",
                                    "text": "小事一桩。这是一笔稳赚不赔的生意，还能顺便教训茂才公，一举两得。",
                                    "choices": [
                                        {
                                            "id": "120030827",
                                            "text": "真是人不可貌相。",
                                            "response": [
                                                {
                                                    "id": "120030828",
                                                    "speaker": "行秋",
                                                    "text": "过奖过奖，你的侠义之心也令人钦佩。"
                                                },
                                                {
                                                    "id": "120030831",
                                                    "speaker": "派蒙",
                                                    "text": "啊——！之前我一直叫他书呆子！"
                                                },
                                                {
                                                    "id": "120030832",
                                                    "speaker": "派蒙",
                                                    "text": "我在武侠小说里看过，有钱的少爷如果生气了的话，会花钱买人手脚的！"
                                                },
                                                {
                                                    "id": "120030833",
                                                    "speaker": "派蒙",
                                                    "text": "怎么办？怎么办？对不起！对不起！真的很对不起！"
                                                },
                                                {
                                                    "id": "120030834",
                                                    "speaker": "行秋",
                                                    "text": "既然你能飞，脚也不是那么必要的东西吧。"
                                                },
                                                {
                                                    "id": "120030835",
                                                    "speaker": "派蒙",
                                                    "text": "#呜哇！{NICKNAME}，帮帮我啊！他的眼神是认真的！",
                                                    "choices": [
                                                        {
                                                            "id": "120030836",
                                                            "text": "明显是在捉弄你啊…",
                                                            "response": [
                                                                {
                                                                    "id": "120030838",
                                                                    "speaker": "行秋",
                                                                    "text": "玩笑到此为止，这次的事情真是谢谢二位了，帮了很大的忙。"
                                                                },
                                                                {
                                                                    "id": "120030839",
                                                                    "speaker": "行秋",
                                                                    "text": "这本《神霄折戟录》也让我非常尽兴，麻烦你们帮我还给常九爷吧。"
                                                                },
                                                                {
                                                                    "id": "120030840",
                                                                    "speaker": "Player",
                                                                    "text": "又让我们跑腿？"
                                                                },
                                                                {
                                                                    "id": "120030841",
                                                                    "speaker": "行秋",
                                                                    "text": "因为其实我并没有做什么，不应该去接受谢意。倒是两位本与此事毫无瓜葛，却帮到了最后。"
                                                                },
                                                                {
                                                                    "id": "120030842",
                                                                    "speaker": "行秋",
                                                                    "text": "能结识如此有侠义心肠的友人，在下已经心满意足。"
                                                                },
                                                                {
                                                                    "id": "120030843",
                                                                    "speaker": "阿旭",
                                                                    "text": "少爷，抱歉打断您，但老爷那边…"
                                                                },
                                                                {
                                                                    "id": "120030844",
                                                                    "speaker": "行秋",
                                                                    "text": "关于这个，请帮我给父亲带句话，我这次平息了事态，还赚了大钱。"
                                                                },
                                                                {
                                                                    "id": "120030845",
                                                                    "speaker": "行秋",
                                                                    "text": "不知可否将功补过，再换几日自由？《神霄折戟录》提到了一处秘境，我想去寻访一番…"
                                                                },
                                                                {
                                                                    "id": "120030846",
                                                                    "speaker": "派蒙",
                                                                    "text": "说得那么好听，其实还是你自己不想去啊！"
                                                                },
                                                                {
                                                                    "id": "120030847",
                                                                    "speaker": "行秋",
                                                                    "text": "哈哈哈，若是我说，常九爷那里不光有谢意，还会有谢礼呢？"
                                                                },
                                                                {
                                                                    "id": "120030848",
                                                                    "speaker": "派蒙",
                                                                    "text": "谢礼！那…那还说得过去…"
                                                                },
                                                                {
                                                                    "id": "120030849",
                                                                    "speaker": "阿旭",
                                                                    "text": "唉，看来不管我说什么，只怕也留不住少爷您吧…"
                                                                },
                                                                {
                                                                    "id": "120030850",
                                                                    "speaker": "Player",
                                                                    "text": "应该早说行秋是你家少爷…"
                                                                },
                                                                {
                                                                    "id": "120030851",
                                                                    "speaker": "阿旭",
                                                                    "text": "我、我也没想到你们会不知道啊…"
                                                                },
                                                                {
                                                                    "id": "120030852",
                                                                    "speaker": "行秋",
                                                                    "text": "那么还书一事就拜托二位。行秋告辞，有缘我们江湖再见。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120030837",
                                                            "text": "你看的真的是武侠小说吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120030829",
                                            "text": "富家少爷现在都不练字吗？",
                                            "response": [
                                                {
                                                    "id": "120030830",
                                                    "speaker": "行秋",
                                                    "text": "哈哈哈，别挖苦我了。看到我的字家里人就能认出我，这也算一种特征吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120030811",
                            "text": "…果然是这么一回事啊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200309",
            "objective": "将《神霄折戟录》物归原主",
            "dialogues": [
                {
                    "id": "120030901",
                    "speaker": "常九爷",
                    "text": "你们终于来了！今天早上当铺的人主动把我的藏书都还回来了！"
                },
                {
                    "id": "120030902",
                    "speaker": "常九爷",
                    "text": "这所有的事一定都是你们帮的忙吧，太谢谢了，真的太谢谢了！",
                    "choices": [
                        {
                            "id": "120030903",
                            "text": "不用客气，帮上忙就好。",
                            "response": [
                                {
                                    "id": "120030905",
                                    "speaker": "常九爷",
                                    "text": "哎呀，千万别这么说，这件事对我来说真的关系重大。"
                                },
                                {
                                    "id": "120030906",
                                    "speaker": "常九爷",
                                    "text": "常家原本也算璃月的大家族，可惜我做少当家时，生意上多次受挫，败了家里的财产…"
                                },
                                {
                                    "id": "120030907",
                                    "speaker": "常九爷",
                                    "text": "我积攒了多年财力，想要重振家族荣光…这批石珀的生意，就是我压上全部身家的希望。"
                                },
                                {
                                    "id": "120030908",
                                    "speaker": "常九爷",
                                    "text": "要不是你们，我估计得葬在这荒山野岭里了。"
                                },
                                {
                                    "id": "120030909",
                                    "speaker": "派蒙",
                                    "text": "没想到你也是个「少爷」啊…"
                                },
                                {
                                    "id": "120030910",
                                    "speaker": "常九爷",
                                    "text": "嗯？什么意思？"
                                },
                                {
                                    "id": "120030911",
                                    "speaker": "派蒙",
                                    "text": "啊没什么没什么！对了，我们是来还书的！"
                                },
                                {
                                    "id": "120030912",
                                    "speaker": "常九爷",
                                    "text": "哦哦，《神霄折戟录》！我就说那古华派的小子怎么突然没影了，还以为他是个小毛贼呢！"
                                },
                                {
                                    "id": "120030913",
                                    "speaker": "派蒙",
                                    "text": "古华派…有这么不被人待见吗？"
                                },
                                {
                                    "id": "120030914",
                                    "speaker": "常九爷",
                                    "text": "这个门派倒是有几百年的历史，也曾经辉煌过，但现在已经衰落到不成样子了。"
                                },
                                {
                                    "id": "120030915",
                                    "speaker": "常九爷",
                                    "text": "振兴山门要靠新鲜血液，但若是一直衰落下去，就永远吸引不来人才，这是个恶性循环。"
                                },
                                {
                                    "id": "120030916",
                                    "speaker": "常九爷",
                                    "text": "现在古华派的年轻人啊…就比如那小子吧，说要报恩，结果远不如你们有担当。",
                                    "choices": [
                                        {
                                            "id": "120030917",
                                            "text": "也不见得。",
                                            "response": [
                                                {
                                                    "id": "120030919",
                                                    "speaker": "常九爷",
                                                    "text": "唉，无所谓啦。对了对了，你们是来找《提瓦特游览指南》的璃月篇的吧！我已经帮你们备好了。"
                                                },
                                                {
                                                    "id": "120030920",
                                                    "speaker": "常九爷",
                                                    "text": "送给你们，不用还了。另外，大恩难以为报，还有一份微薄的谢礼…",
                                                    "choices": [
                                                        {
                                                            "id": "120030921",
                                                            "text": "谢谢，总算不是白跑一趟。",
                                                            "response": [
                                                                {
                                                                    "id": "120030923",
                                                                    "speaker": "常九爷",
                                                                    "text": "矿卖出去了，宝贝书也回来了，这真是…"
                                                                },
                                                                {
                                                                    "id": "120030924",
                                                                    "speaker": "常九爷",
                                                                    "text": "咦？"
                                                                },
                                                                {
                                                                    "id": "120030925",
                                                                    "speaker": "派蒙",
                                                                    "text": "怎么了？我看好像有什么东西掉出来了。"
                                                                },
                                                                {
                                                                    "id": "120030926",
                                                                    "speaker": "常九爷",
                                                                    "text": "没什么，没什么…"
                                                                },
                                                                {
                                                                    "id": "120030927",
                                                                    "speaker": "常九爷",
                                                                    "text": "（莫非…那个小毛贼…是…）"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120030922",
                                                            "text": "我差点都忘了这回事了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120030918",
                                            "text": "说不定古华派的转机就要来了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120030904",
                            "text": "其实我们也没做什么。"
                        }
                    ]
                }
            ]
        },
        {
