    "talks": [
        {
            "id": "2102801",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210280101",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你来得正好，我有事情想问你！",
                    "choices": [
                        {
                            "id": "210280102",
                            "text": "有什么事？",
                            "response": [
                                {
                                    "id": "210280105",
                                    "speaker": "小蒙",
                                    "text": "爸爸说，去须弥的路程很远，需要准备一些药物。"
                                },
                                {
                                    "id": "210280106",
                                    "speaker": "小蒙",
                                    "text": "治疗头痛的、防止腹泻的，防止中暑的…还有解酒的，消食的…好多好多。"
                                },
                                {
                                    "id": "210280107",
                                    "speaker": "派蒙",
                                    "text": "为什么还要准备解酒的药啦…"
                                },
                                {
                                    "id": "210280108",
                                    "speaker": "Player",
                                    "text": "谈生意的时候要用吧。"
                                },
                                {
                                    "id": "210280109",
                                    "speaker": "派蒙",
                                    "text": "欸？谈生意和解酒药有什么关系，难道喝酒喝得多，生意就会做得好吗？"
                                },
                                {
                                    "id": "210280110",
                                    "speaker": "小蒙",
                                    "text": "总之，爸爸要我去「不卜庐」问问，那些药物准备得怎么样了。"
                                },
                                {
                                    "id": "210280111",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能陪我去吗？有些事，我想要请你帮帮忙。",
                                    "choices": [
                                        {
                                            "id": "210280112",
                                            "text": "走吧。",
                                            "response": [
                                                {
                                                    "id": "210280115",
                                                    "speaker": "小蒙",
                                                    "text": "#我们走吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210280113",
                                            "text": "你…有什么事要我帮忙？",
                                            "response": [
                                                {
                                                    "id": "210280114",
                                                    "speaker": "小蒙",
                                                    "text": "到那边再说吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210280103",
                            "text": "旅行准备得怎么样了？",
                            "response": [
                                {
                                    "id": "210280104",
                                    "speaker": "小蒙",
                                    "text": "大部分都是我爸爸和那群叔叔在准备啦…但是爸爸也交给我了一些任务！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102802",
            "objective": "前往「不卜庐」",
            "dialogues": [
                {
                    "id": "210280201",
                    "speaker": "阿桂",
                    "text": "你好，请问是来抓药的吗？"
                },
                {
                    "id": "210280202",
                    "speaker": "阿桂",
                    "text": "咦？这不是小蒙吗？你怎么来了？"
                },
                {
                    "id": "210280203",
                    "speaker": "阿桂",
                    "text": "噢…我知道了，你是来问那些药物的事吧？"
                },
                {
                    "id": "210280204",
                    "speaker": "阿桂",
                    "text": "放心吧，那些药物我基本上都准备好了，会分批送去给你爸爸的。"
                },
                {
                    "id": "210280205",
                    "speaker": "阿桂",
                    "text": "不过你爸爸要的药物量太大，店里囤的一些药材都快用完了，可能有一些药会做得慢一些。"
                },
                {
                    "id": "210280206",
                    "speaker": "阿桂",
                    "text": "我看看啊，嗯…主要是薄荷没剩下多少，所以治疗中暑的药也没法做了。"
                },
                {
                    "id": "210280207",
                    "speaker": "阿桂",
                    "text": "毕竟，除了制作你爸爸的药物订单之外，我们也要给其他人看病啊。"
                },
                {
                    "id": "210280208",
                    "speaker": "小蒙",
                    "text": "那…",
                    "choices": [
                        {
                            "id": "210280209",
                            "text": "轮到我出场了。",
                            "response": [
                                {
                                    "id": "210280210",
                                    "speaker": "小蒙",
                                    "text": "#嘿嘿，谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                                },
                                {
                                    "id": "210280213",
                                    "speaker": "小蒙",
                                    "text": "那药材的事就拜托你啦，我要留在这里仔细核查一下药物。这是爸爸特意叮嘱我的！"
                                },
                                {
                                    "id": "210280214",
                                    "speaker": "阿桂",
                                    "text": "这孩子还挺认真的…"
                                },
                                {
                                    "id": "210280215",
                                    "speaker": "阿桂",
                                    "text": "那你和我进来吧，我把这一批的药物清单给你看看。"
                                },
                                {
                                    "id": "210280216",
                                    "speaker": "小蒙",
                                    "text": "呜啊…怎么这么多…"
                                },
                                {
                                    "id": "210280217",
                                    "speaker": "阿桂",
                                    "text": "你先看这些，我把另外一批拿过来。"
                                },
                                {
                                    "id": "210280218",
                                    "speaker": "小蒙",
                                    "text": "欸？还有吗？！"
                                }
                            ]
                        },
                        {
                            "id": "210280211",
                            "text": "我可要收取报酬喔。",
                            "response": [
                                {
                                    "id": "210280212",
                                    "speaker": "小蒙",
                                    "text": "#嘿嘿，没问题！谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102803",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2102804",
            "objective": "将薄荷交给小蒙",
            "dialogues": [
                {
                    "id": "210280401",
                    "speaker": "小蒙",
                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                },
                {
                    "id": "210280402",
                    "speaker": "阿桂",
                    "text": "嗯，这些应该够我做一些药了。"
                },
                {
                    "id": "210280403",
                    "speaker": "阿桂",
                    "text": "那些治疗中暑的药物，我会放在下批药物里一起送过去。"
                },
                {
                    "id": "210280404",
                    "speaker": "小蒙",
                    "text": "那就辛苦你啦，阿桂哥哥。"
                },
                {
                    "id": "210280405",
                    "speaker": "小蒙",
                    "text": "#这些东西给你，谢谢你帮忙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们回去吧。"
                },
                {
                    "id": "210280406",
                    "speaker": "小蒙",
                    "text": "嘿嘿，爸爸听到这个消息肯定会高兴…"
                },
                {
                    "id": "210280407",
                    "speaker": "阿桂",
                    "text": "小蒙，你等一会。"
                },
                {
                    "id": "210280408",
                    "speaker": "小蒙",
                    "text": "怎么了？"
                },
                {
                    "id": "210280409",
                    "speaker": "阿桂",
                    "text": "你不是要核查药物吗？后面的清单你还没看完呢。"
                },
                {
                    "id": "210280410",
                    "speaker": "小蒙",
                    "text": "欸…欸？我刚才不是核查了那么久…"
                },
                {
                    "id": "210280411",
                    "speaker": "阿桂",
                    "text": "那才核查了多少，来吧小蒙，我们继续核查。"
                },
                {
                    "id": "210280412",
                    "speaker": "小蒙",
                    "text": "呜…好…好吧…"
                }
            ]
        },
        {
            "id": "2102805",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2102803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210280301",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到薄荷了吗？"
                }
            ]
        },
        {
            "id": "2102805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210280501",
                    "speaker": "阿桂",
                    "text": "嗯…我也得核查一下这些清单…"
                }
            ]
        }
    ]
}