    "talks": [
        {
            "id": "4012907",
            "objective": "等待到两天后",
            "dialogues": []
        },
        {
            "id": "4012901",
            "objective": "前往菲米尼的营地",
            "dialogues": [
                {
                    "id": "401290101",
                    "speaker": "菲米尼",
                    "text": "您的孩子情况好点了吗？"
                },
                {
                    "id": "401290102",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "多谢关心，现在还比较稳定。我的家庭医生说，今天可以试试带他出门散心了。"
                },
                {
                    "id": "401290103",
                    "speaker": "派蒙",
                    "text": "祖莉亚夫人！菲米尼！我们来啦。"
                },
                {
                    "id": "401290104",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "呵呵，看来大家都到齐了呢。"
                },
                {
                    "id": "401290105",
                    "speaker": "派蒙",
                    "text": "其实还少一个人吧？嘿嘿，但我猜到他在哪了。"
                },
                {
                    "id": "401290106",
                    "speaker": "派蒙",
                    "text": "喂——「特尔克西」——"
                },
                {
                    "id": "401290107",
                    "speaker": "「特尔克西」",
                    "text": "-.. -... .-- -...？"
                },
                {
                    "id": "401290108",
                    "speaker": "派蒙",
                    "text": "哇！「特尔克西」多了一把剑和一面盾牌！好漂亮哦。"
                },
                {
                    "id": "401290109",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "有了武器的「特尔克西」，看起来格外有冲劲呢。菲米尼先生的手艺，真令人赞叹。"
                },
                {
                    "id": "401290110",
                    "speaker": "派蒙",
                    "text": "也有我们的功劳！"
                },
                {
                    "id": "401290111",
                    "speaker": "菲米尼",
                    "text": "#嗯，{NICKNAME}的眼光很好，找来的材料成色都很棒。"
                },
                {
                    "id": "401290112",
                    "speaker": "菲米尼",
                    "text": "#对了，祖莉亚夫人刚和我说，在历险的最后，希望能用一次加冕仪式当作结局。所以{NICKNAME}，王冠的材料…能不能也拜托你？"
                },
                {
                    "id": "401290113",
                    "speaker": "菲米尼",
                    "text": "等会过去的途中顺便找一找就好，本来我打算自己解决，但现在我觉得，你找来的也许会更精美。"
                },
                {
                    "id": "401290114",
                    "speaker": "Player",
                    "text": "包在我身上。"
                },
                {
                    "id": "401290115",
                    "speaker": "派蒙",
                    "text": "看来已经万事俱备啦，我们现在要出发了吗？"
                },
                {
                    "id": "401290116",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "请稍等，我在想，既然「特尔克西」已经是一副全新的面貌了，也许我们现在就可以更新一页绘本，大家觉得呢？"
                },
                {
                    "id": "401290117",
                    "speaker": "派蒙",
                    "text": "哇哦！一下就期待起来了！"
                },
                {
                    "id": "401290118",
                    "speaker": "Player",
                    "text": "要画什么内容呢？"
                },
                {
                    "id": "401290119",
                    "speaker": "菲米尼",
                    "text": "…就在原有的基础上调整怎么样？至少让画的内容不再那么悲伤…"
                },
                {
                    "id": "401290120",
                    "speaker": "派蒙",
                    "text": "把坏的部分去掉，画成好的吗？听起来好像很不错。"
                },
                {
                    "id": "401290121",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "那就由我来动手吧，虽然我不是特别擅长绘画，但工作上也有不少接触，至于具体内容，大家可以畅所欲言。"
                },
                {
                    "id": "401290122",
                    "speaker": "菲米尼",
                    "text": "我想…首先可以把武器画上，王子拿起了勇气的剑和坚毅的盾，证明他已经跨过沉沦，决心向黑暗开战。"
                },
                {
                    "id": "401290123",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "好，把武器画上…还有呢？"
                },
                {
                    "id": "401290124",
                    "speaker": "派蒙",
                    "text": "我觉得要加上伙伴！这一次「特尔克西」身边站着可靠的伙伴，他不是一个人在战斗。"
                },
                {
                    "id": "401290125",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "好，把伙伴画上…还有呢？"
                },
                {
                    "id": "401290126",
                    "speaker": "Player",
                    "text": "还有色彩。"
                },
                {
                    "id": "401290127",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "色彩…色彩…好！色彩很重要，前方的路不会再是灰败的，而是五颜六色的，充满希望的。"
                },
                {
                    "id": "401290128",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "没想到…居然变成了这种振奋人心的画面…太棒了，大家的想法太棒了。"
                },
                {
                    "id": "401290129",
                    "speaker": "派蒙",
                    "text": "真好呀，大家看起来都很有精神，「特尔克西」最有精神！"
                },
                {
                    "id": "401290130",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "我的孩子，你看到了吗？你一定也会被鼓舞吧？"
                },
                {
                    "id": "401290131",
                    "speaker": "「特尔克西」",
                    "text": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---"
                },
                {
                    "id": "401290132",
                    "speaker": "菲米尼",
                    "text": "一定会的，祖莉亚夫人，而且这只是第一页。"
                },
                {
                    "id": "401290133",
                    "speaker": "派蒙",
                    "text": "没错，我已经迫不及待地想要看到最后的绘本啦，我们要用最快的速度和最真诚的心意完成它！"
                },
                {
                    "id": "401290134",
                    "speaker": "祖莉亚·德斯特雷",
                    "text": "嗯！我也开始期待了，那就不再浪费时间，各位，我们现在就动身吧！"
                },
                {
                    "id": "401290135",
                    "speaker": "派蒙",
                    "text": "好耶！《特尔克西的奇幻历险》出发咯！"
                }
            ]
        },
        {
