    "talks": [
        {
            "id": "300101",
            "objective": "寻找柯莱",
            "dialogues": [
                {
                    "id": "30010101",
                    "speaker": "提纳里",
                    "text": "好，接下来是右手…情况似乎还可以。"
                },
                {
                    "id": "30010102",
                    "speaker": "提纳里",
                    "text": "不过还是小心行事，明白吗？"
                },
                {
                    "id": "30010103",
                    "speaker": "柯莱",
                    "text": "嗯，我知道了。对了师父，我还没拿到今天的巡林路线图。"
                },
                {
                    "id": "30010104",
                    "speaker": "提纳里",
                    "text": "今天的路程很远，你就不要跟我一起去了，而且还可能会有那些东西出现在这条路线上。"
                },
                {
                    "id": "30010105",
                    "speaker": "柯莱",
                    "text": "我明明也有神之眼，却没办法帮上什么忙…"
                },
                {
                    "id": "30010106",
                    "speaker": "提纳里",
                    "text": "别说这种话，这不是你现在应该考虑的事。"
                },
                {
                    "id": "30010107",
                    "speaker": "提纳里",
                    "text": "你们来了，身体感觉还好吗？"
                },
                {
                    "id": "30010108",
                    "speaker": "Player",
                    "text": "有什么需要帮忙的吗？"
                },
                {
                    "id": "30010109",
                    "speaker": "派蒙",
                    "text": "对，既然留在这里，我们也想稍微找点事情做。"
                },
                {
                    "id": "30010110",
                    "speaker": "提纳里",
                    "text": "你们是这种闲不下来的类型吗？好吧，既然这样，今天就让柯莱带你们去化城郭南边巡视吧。"
                },
                {
                    "id": "30010111",
                    "speaker": "提纳里",
                    "text": "如果你们对体力有信心，七天神像的清洁也交给你们了。"
                },
                {
                    "id": "30010112",
                    "speaker": "阿米尔",
                    "text": "提纳里先生，我们已经准备完毕了！"
                },
                {
                    "id": "30010113",
                    "speaker": "提纳里",
                    "text": "马上就来——我们先出发去林子里了，剩下的事就让柯莱跟你们说明吧。"
                },
                {
                    "id": "30010114",
                    "speaker": "柯莱",
                    "text": "是，交给我吧。"
                },
                {
                    "id": "30010115",
                    "speaker": "派蒙",
                    "text": "柯莱，我们今天都要做些什么？"
                },
                {
                    "id": "30010116",
                    "speaker": "派蒙",
                    "text": "刚才提纳里说要清洁七天神像，但我没想到，这也算巡林员的工作啊？"
                },
                {
                    "id": "30010117",
                    "speaker": "柯莱",
                    "text": "嗯，其实巡林员的工作内容很广。"
                },
                {
                    "id": "30010118",
                    "speaker": "柯莱",
                    "text": "检查道路状况、维护林间设施、排除火灾隐患、为旅客居民提供帮助…"
                },
                {
                    "id": "30010119",
                    "speaker": "柯莱",
                    "text": "如果是师父的话，还经常要去处理雨林中危险的区域。"
                },
                {
                    "id": "30010120",
                    "speaker": "柯莱",
                    "text": "在我们到达七天神像前，先检查一下沿途的路灯吧。"
                }
            ]
        },
        {
            "id": "300102",
            "objective": "检查沿途的路灯",
            "dialogues": []
        },
        {
            "id": "300108",
            "objective": "检查沿途的路灯",
            "dialogues": [
                {
                    "id": "30010801",
                    "speaker": "派蒙",
                    "text": "柯莱，我们回来啦。"
                },
                {
                    "id": "30010802",
                    "speaker": "柯莱",
                    "text": "辛苦了，你们爬上爬下，一定累了吧。我们就在这里休息一会吧。"
                },
                {
                    "id": "30010803",
                    "speaker": "派蒙",
                    "text": "柯莱，你有没有在附近见过一种小小的、有点像植物的生物？"
                },
                {
                    "id": "30010804",
                    "speaker": "柯莱",
                    "text": "像植物的生物？唔…如果是师父的话，一定会回答「植物也是生物」吧。"
                },
                {
                    "id": "30010805",
                    "speaker": "Black Screen",
                    "text": "对柯莱叙述了刚才看到的东西…"
                },
                {
                    "id": "30010806",
                    "speaker": "柯莱",
                    "text": "欸，好神奇啊，听起来就像是小朋友们经常说起的一种幻想生物。下次我帮你们打听一下。"
                },
                {
                    "id": "30010807",
                    "speaker": "柯莱",
                    "text": "哦，你们饿不饿？我带了水和食物来。"
                }
            ]
        },
        {
            "id": "300109",
            "objective": "检查沿途的路灯",
            "dialogues": [
                {
                    "id": "30010901",
                    "speaker": "派蒙",
                    "text": "柯莱，我们回来啦。"
                },
                {
                    "id": "30010902",
                    "speaker": "柯莱",
                    "text": "辛苦了，你们爬上爬下，一定累了吧。我们就在这里休息一会吧，我带了水和食物来。"
                }
            ]
        },
        {
            "id": "300103",
            "objective": "前往七天神像",
            "dialogues": [
                {
                    "id": "30010501",
                    "speaker": "柯莱",
                    "text": "七天神像就在那块巨大的岩石上面，你们之前从这条路过来的时候，应该已经看到它了。"
                },
                {
                    "id": "30010502",
                    "speaker": "柯莱",
                    "text": "位置是不是有点高？如果你觉得爬上去比较勉强，不打扫也没关系，师父不会介意的。",
                    "choices": [
                        {
                            "id": "30010503",
                            "text": "不要紧，我很擅长攀爬。",
                            "response": [
                                {
                                    "id": "30010505",
                                    "speaker": "柯莱",
                                    "text": "是吗，那就交给你了。神像附近的空间很小，你在上面要小心一点。"
                                },
                                {
                                    "id": "30010506",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我也和你一起上去吧，我可以帮你打扫比较高的地方。"
                                },
                                {
                                    "id": "30010507",
                                    "speaker": "派蒙",
                                    "text": "对了柯莱，你知道草神是位什么样的神吗？"
                                },
                                {
                                    "id": "30010508",
                                    "speaker": "柯莱",
                                    "text": "你是问「大慈树王」还是「小吉祥草王」？"
                                },
                                {
                                    "id": "30010509",
                                    "speaker": "派蒙",
                                    "text": "咦，「大慈树王」？"
                                },
                                {
                                    "id": "30010510",
                                    "speaker": "派蒙",
                                    "text": "啊，难道说这是前代草神的名字？"
                                },
                                {
                                    "id": "30010511",
                                    "speaker": "柯莱",
                                    "text": "对。「大慈树王」是须弥的初代草神大人。她创造了雨林，在沙漠边缘建起防沙壁，大家这才获得了安宁的生活。"
                                },
                                {
                                    "id": "30010512",
                                    "speaker": "柯莱",
                                    "text": "在须弥人眼里，她是智慧、仁慈与无所不能的象征，但她却在几百年前的灾难中消失了。",
                                    "choices": [
                                        {
                                            "id": "30010513",
                                            "text": "（就像雷电真那样吗…）",
                                            "response": [
                                                {
                                                    "id": "30010515",
                                                    "speaker": "柯莱",
                                                    "text": "我听师父说，后来贤者们找到了新生的草神大人，将她接回了须弥。"
                                                },
                                                {
                                                    "id": "30010516",
                                                    "speaker": "柯莱",
                                                    "text": "为了庆祝神明的失而复得，贤者们就以「小吉祥草王」称呼她，并让她居住在净善宫里。"
                                                },
                                                {
                                                    "id": "30010517",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，那然后呢？"
                                                },
                                                {
                                                    "id": "30010518",
                                                    "speaker": "柯莱",
                                                    "text": "然后，呃…我也不太清楚了。"
                                                },
                                                {
                                                    "id": "30010519",
                                                    "speaker": "派蒙",
                                                    "text": "咦，你也不清楚吗？难道说柯莱你并不是须弥人？"
                                                },
                                                {
                                                    "id": "30010520",
                                                    "speaker": "柯莱",
                                                    "text": "不，我是须弥人没错，不过…"
                                                },
                                                {
                                                    "id": "30010521",
                                                    "speaker": "派蒙",
                                                    "text": "是因为我们是陌生人，有些事情不方便说吗？如果真是这样也没关系，你不用在意。"
                                                },
                                                {
                                                    "id": "30010522",
                                                    "speaker": "柯莱",
                                                    "text": "不不，你们误会了，我不是在隐瞒什么。况且你们对我来说，也不算是陌生人。"
                                                },
                                                {
                                                    "id": "30010523",
                                                    "speaker": "柯莱",
                                                    "text": "那个…你、你们也认识安柏对吧？"
                                                },
                                                {
                                                    "id": "30010524",
                                                    "speaker": "派蒙",
                                                    "text": "等等，你说的难道是——",
                                                    "choices": [
                                                        {
                                                            "id": "30010525",
                                                            "text": "西风骑士团的侦察骑士？",
                                                            "response": [
                                                                {
                                                                    "id": "30010527",
                                                                    "speaker": "柯莱",
                                                                    "text": "对，就是她！我之前在蒙德待过一段时间，当时得到了安柏很多帮助，说是她改变了我也不为过。"
                                                                },
                                                                {
                                                                    "id": "30010528",
                                                                    "speaker": "柯莱",
                                                                    "text": "安柏她真的很厉害！热爱生活，有正义感，不仅充满行动力，也非常善解人意，总是能像一团火一样照亮别人。"
                                                                },
                                                                {
                                                                    "id": "30010529",
                                                                    "speaker": "柯莱",
                                                                    "text": "在我看来，她是最适合做侦察骑士的人。因为几乎每个踏入蒙德的人，都会先遇到她，然后被她的热情感染，爱上那片土地…"
                                                                },
                                                                {
                                                                    "id": "30010530",
                                                                    "speaker": "柯莱",
                                                                    "text": "啊…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "30010531",
                                                                            "text": "……",
                                                                            "response": [
                                                                                {
                                                                                    "id": "30010533",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "唔，虽然总觉得侦察骑士的工作目的并不是这样，不过我已经十分深刻地感觉到了，柯莱你真的很喜欢安柏。"
                                                                                },
                                                                                {
                                                                                    "id": "30010534",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "咳…不、不好意思，刚才我好像说了一些奇怪的话。"
                                                                                },
                                                                                {
                                                                                    "id": "30010535",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘻嘻，没关系啦，知道你是安柏的朋友后，感觉一下子和你亲近了不少呢。"
                                                                                },
                                                                                {
                                                                                    "id": "30010536",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过你是怎么知道我们也认识安柏的？"
                                                                                },
                                                                                {
                                                                                    "id": "30010537",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "啊，是这样的，我回到须弥之后，也一直和安柏保持着书信联系。"
                                                                                },
                                                                                {
                                                                                    "id": "30010538",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "她在信里讲过蒙德城遭到飞龙袭击的事，说有一个金发的旅行者和飘浮的伙伴帮忙化解了危机。"
                                                                                },
                                                                                {
                                                                                    "id": "30010539",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "所以昨天一见到你们，我就认出你们了。不过当时因为旅行者刚从昏迷中醒来，我就没好意思提起这件事…"
                                                                                },
                                                                                {
                                                                                    "id": "30010540",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "原来是这样呀。"
                                                                                },
                                                                                {
                                                                                    "id": "30010541",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "嗯！所以请你们放心，我绝对是信任你们的。"
                                                                                },
                                                                                {
                                                                                    "id": "30010542",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "我也想多告诉你们一些草神大人的事，但我很长时间都没在须弥生活，而且也没读过什么书…不好意思。"
                                                                                },
                                                                                {
                                                                                    "id": "30010543",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "没关系啦，你刚才告诉我们的情报也很有价值。毕竟我们之前，连「大慈树王」、「净善宫」什么的都没听说过呢。"
                                                                                },
                                                                                {
                                                                                    "id": "30010544",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "能帮上一点忙就好。不过你们为什么要打听草神的消息呀？"
                                                                                },
                                                                                {
                                                                                    "id": "30010545",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "向柯莱简单讲述了旅行的目的…"
                                                                                },
                                                                                {
                                                                                    "id": "30010546",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "原来如此。谢谢你们愿意告诉我这些。"
                                                                                },
                                                                                {
                                                                                    "id": "30010547",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不用客气，毕竟我们是朋友呀，对吧？"
                                                                                },
                                                                                {
                                                                                    "id": "30010548",
                                                                                    "speaker": "Player",
                                                                                    "text": "派蒙说得没错。"
                                                                                },
                                                                                {
                                                                                    "id": "30010549",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好，那我们现在就去上面清洁神像吧。"
                                                                                },
                                                                                {
                                                                                    "id": "30010550",
                                                                                    "speaker": "柯莱",
                                                                                    "text": "嗯，辛苦你们了。我去前面检查一下遮雨棚的情况，等会儿我们就在这附近会合吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "30010532",
                                                                            "text": "原来你是这样的柯莱…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "30010526",
                                                            "text": "蒙德城的狂热飞行爱好者？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30010514",
                                            "text": "（也是在坎瑞亚那时吗…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30010504",
                            "text": "这种程度小菜一碟。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "300104",
            "objective": "爬上岩石顶部",
            "dialogues": []
        },
        {
            "id": "300107",
            "objective": "与草神像共鸣",
            "dialogues": [
                {
                    "id": "3117801",
                    "speaker": "Player",
                    "text": "与草元素共鸣"
                }
            ]
        },
        {
            "id": "300105",
            "objective": "观察面前的草神像",
            "dialogues": [
                {
                    "id": "30010601",
                    "speaker": "派蒙",
                    "text": "仔细看的话，这座神像雕刻出的神明，身材很小巧的样子。"
                },
                {
                    "id": "30010602",
                    "speaker": "派蒙",
                    "text": "唔，你说她究竟是「大慈树王」，还是「小吉祥草王」？",
                    "choices": [
                        {
                            "id": "30010603",
                            "text": "「大慈树王」？",
                            "response": [
                                {
                                    "id": "30010604",
                                    "speaker": "派蒙",
                                    "text": "嗯，很有可能，毕竟这座神像看起来很古老了。"
                                },
                                {
                                    "id": "30010607",
                                    "speaker": "派蒙",
                                    "text": "算啦，关于她们的事情，我们以后总会打听到的。好，接下来我们就来擦…"
                                },
                                {
                                    "id": "30010608",
                                    "speaker": "？？？",
                                    "text": "……"
                                },
                                {
                                    "id": "30010609",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "30010610",
                                    "speaker": "派蒙",
                                    "text": "等一下，刚刚那是什么？是我的错觉吗？",
                                    "choices": [
                                        {
                                            "id": "30010611",
                                            "text": "果然你也看见了吗？",
                                            "response": [
                                                {
                                                    "id": "30010612",
                                                    "speaker": "派蒙",
                                                    "text": "对呀！就是那种小小的、圆圆的、看起来还有点像蔬菜的小东西…"
                                                },
                                                {
                                                    "id": "30010615",
                                                    "speaker": "派蒙",
                                                    "text": "刚才真是吓了我一大跳，我觉得我们有必要打听一下这种东西是什么。"
                                                },
                                                {
                                                    "id": "30010616",
                                                    "speaker": "派蒙",
                                                    "text": "不过现在，我们先开始工作吧。我飞到上面去，你就负责擦下面好了。"
                                                },
                                                {
                                                    "id": "30010617",
                                                    "speaker": "Black Screen",
                                                    "text": "和派蒙一起仔细擦拭了神像…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30010613",
                                            "text": "是卷心菜吗？",
                                            "response": [
                                                {
                                                    "id": "30010614",
                                                    "speaker": "派蒙",
                                                    "text": "对对！小小的、圆圆的，的确有点像卷心菜。不过明显是活的呀！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30010605",
                            "text": "「小吉祥草王」？",
                            "response": [
                                {
                                    "id": "30010606",
                                    "speaker": "派蒙",
                                    "text": "看这座神像的模样，倒是和这个名字挺相称呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "300106",
            "objective": "与柯莱汇合",
            "dialogues": [
                {
                    "id": "30011001",
                    "speaker": "派蒙",
                    "text": "好耶！是什么好吃的呀？"
                },
                {
                    "id": "30011002",
                    "speaker": "Player",
                    "text": "派蒙，矜持一点…"
                },
                {
                    "id": "30011003",
                    "speaker": "派蒙",
                    "text": "有什么关系嘛，柯莱又不是外人。再说了，食客的热情可是对厨师最好的赞美呢。"
                },
                {
                    "id": "30011004",
                    "speaker": "柯莱",
                    "text": "今天我带来的是一种巡林员常吃的便携食物，叫做「口袋饼」，不知道合不合你们的胃口。"
                },
                {
                    "id": "30011005",
                    "speaker": "柯莱",
                    "text": "哇啊…！"
                },
                {
                    "id": "30011006",
                    "speaker": "派蒙",
                    "text": "糟了，掉在地上了！"
                },
                {
                    "id": "30011007",
                    "speaker": "柯莱",
                    "text": "没事没事，我在食物外面包了好几层油纸，应该没有弄脏。"
                },
                {
                    "id": "30011008",
                    "speaker": "派蒙",
                    "text": "呼…刚才真是吓死我了。"
                },
                {
                    "id": "30011009",
                    "speaker": "Black Screen",
                    "text": "和柯莱一起分享了食物…"
                },
                {
                    "id": "30011010",
                    "speaker": "派蒙",
                    "text": "真是太好吃啦！柯莱，你的厨艺真好。"
                },
                {
                    "id": "30011011",
                    "speaker": "派蒙",
                    "text": "幸好你之前把每块饼都仔细包了起来，要不然我肯定会心疼得晚上连觉都睡不着了。"
                },
                {
                    "id": "30011012",
                    "speaker": "柯莱",
                    "text": "哈哈，这也太夸张了吧…"
                },
                {
                    "id": "30011013",
                    "speaker": "柯莱",
                    "text": "不过既然你们喜欢，下次我给你们抄一份食谱吧。放心，我会把烹饪要点写上，你们很快就能学会的。"
                },
                {
                    "id": "30011014",
                    "speaker": "派蒙",
                    "text": "谢谢你柯莱！嘻嘻，真难想象像你这么认真的人，竟然也会有毛手毛脚的时候。"
                },
                {
                    "id": "30011015",
                    "speaker": "柯莱",
                    "text": "哈哈，可能是有那么一点吧…"
                },
                {
                    "id": "30011016",
                    "speaker": "派蒙",
                    "text": "不过提纳里对你是不是管得太严了一点？东西都不让你碰…"
                },
                {
                    "id": "30011017",
                    "speaker": "派蒙",
                    "text": "#我也偶尔会在飞的时候碰倒桌上的东西，但{NICKNAME}从来不会怪我，毕竟谁都会有不小心的时候嘛。"
                },
                {
                    "id": "30011018",
                    "speaker": "柯莱",
                    "text": "不，不是这样的！如果你们和师父相处的时间更长一点，就会发现他其实是个很好的人。"
                },
                {
                    "id": "30011019",
                    "speaker": "柯莱",
                    "text": "我听前辈们说，师父来自一个很古老神秘的种族。他们一族都很聪明，大多有些孤僻，但师父却是个很热心肠的人。"
                },
                {
                    "id": "30011020",
                    "speaker": "柯莱",
                    "text": "对了，你们知道教令院吗，好像是叫做生…生什么派来着？"
                },
                {
                    "id": "30011021",
                    "speaker": "柯莱",
                    "text": "总之，因为师父对植物很有研究，那个学院的贤者还好几次写信来，让他到教令院去任职。"
                },
                {
                    "id": "30011022",
                    "speaker": "柯莱",
                    "text": "不过，却被师父以「须弥城太嘈杂对耳朵不好」为由拒绝了。",
                    "choices": [
                        {
                            "id": "30011023",
                            "text": "还真像提纳里会说的话…",
                            "response": [
                                {
                                    "id": "30011024",
                                    "speaker": "柯莱",
                                    "text": "哈哈，是啊。不过贤者大人看到信，估计会生气吧。"
                                },
                                {
                                    "id": "30011025",
                                    "speaker": "柯莱",
                                    "text": "明明可以去教令院，师父却选择了做巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。"
                                },
                                {
                                    "id": "30011029",
                                    "speaker": "柯莱",
                                    "text": "就连口袋饼的做法，也是师父教给我的。"
                                },
                                {
                                    "id": "30011030",
                                    "speaker": "派蒙",
                                    "text": "真的吗？这我倒是完全没想到。"
                                },
                                {
                                    "id": "30011031",
                                    "speaker": "派蒙",
                                    "text": "唔…不过这么说来，昨天提纳里发现你晕倒后，倒是二话不说就对你实施救治，也是他把你背回化城郭的。"
                                },
                                {
                                    "id": "30011032",
                                    "speaker": "派蒙",
                                    "text": "不过我还是觉得有点不爽，因为他整整一路上都在拼命数落我呀！"
                                },
                                {
                                    "id": "30011033",
                                    "speaker": "Player",
                                    "text": "你做了什么？"
                                },
                                {
                                    "id": "30011034",
                                    "speaker": "柯莱",
                                    "text": "啊，真不好意思，这件事可能是师父不太对…"
                                },
                                {
                                    "id": "30011035",
                                    "speaker": "柯莱",
                                    "text": "#因为派蒙当时不停在喊「怎么办，{M#他}{F#她}是不是要死了？」，怎么劝都没用，把师父给惹毛了。"
                                },
                                {
                                    "id": "30011036",
                                    "speaker": "派蒙",
                                    "text": "喂，可恶，你不要笑啊！我还不都是因为关心你！"
                                },
                                {
                                    "id": "30011037",
                                    "speaker": "柯莱",
                                    "text": "噗…呵呵呵呵…"
                                },
                                {
                                    "id": "30011038",
                                    "speaker": "派蒙",
                                    "text": "怎么回事，为什么连柯莱也——"
                                },
                                {
                                    "id": "30011039",
                                    "speaker": "派蒙",
                                    "text": "啊啊啊，气死我啦！我要报复你们！看我把你们的脑袋都揉成鸟窝！"
                                },
                                {
                                    "id": "30011040",
                                    "speaker": "柯莱",
                                    "text": "别碰我！！",
                                    "choices": [
                                        {
                                            "id": "30011041",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "30011043",
                                                    "speaker": "派蒙",
                                                    "text": "柯莱，对不起，那个，我不是故意的…"
                                                },
                                                {
                                                    "id": "30011044",
                                                    "speaker": "柯莱",
                                                    "text": "啊，我…刚才…不，不是这样的，不是的…"
                                                },
                                                {
                                                    "id": "30011045",
                                                    "speaker": "派蒙",
                                                    "text": "柯莱，你还好吗？你没事吧？"
                                                },
                                                {
                                                    "id": "30011046",
                                                    "speaker": "柯莱",
                                                    "text": "啊…嗯，我没事，我没事了…不好意思，刚才吓了你们一跳吧，哈哈…"
                                                },
                                                {
                                                    "id": "30011047",
                                                    "speaker": "柯莱",
                                                    "text": "对了，时间已经不早了，我们赶快回化城郭去吧，师父他们也该回来了。"
                                                },
                                                {
                                                    "id": "30011048",
                                                    "speaker": "派蒙",
                                                    "text": "刚才到底怎么了，柯莱她不要紧吧？她走得可真快，现在都已经看不见了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30011042",
                                            "text": "柯莱，你怎么了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30011026",
                            "text": "耳朵…耳朵好像很好摸！",
                            "response": [
                                {
                                    "id": "30011027",
                                    "speaker": "柯莱",
                                    "text": "对吧！我也是这么觉得…嗯，咳咳！"
                                },
                                {
                                    "id": "30011028",
                                    "speaker": "柯莱",
                                    "text": "总、总而言之，师父明明可以去教令院，却还是做了巡林官，每天都在为雨林的居民们提供帮助，也会教给下属们各种知识。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "300110",
            "objective": "返回化城郭",
            "dialogues": [
                {
                    "id": "30011101",
                    "speaker": "娜丝琳",
                    "text": "哦，旅行者，你们回来了啊。"
                },
                {
                    "id": "30011102",
                    "speaker": "派蒙",
                    "text": "你好，请问你看到柯莱了吗？"
                },
                {
                    "id": "30011103",
                    "speaker": "娜丝琳",
                    "text": "柯莱啊，刚才看见她回房间去了。"
                },
                {
                    "id": "30011104",
                    "speaker": "派蒙",
                    "text": "这样啊…看来我们只能明天再去找她了。"
                }
            ]
        },
        {
            "id": "300111",
            "objective": "等到第二天8点",
            "dialogues": []
        },
        {
            "id": "300107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30010701",
                    "speaker": "派蒙",
                    "text": "之前没怎么仔细观察，现在我才发现，这座神像雕刻出的神明，身材很小巧的样子。"
                },
                {
                    "id": "30010702",
                    "speaker": "派蒙",
                    "text": "唔，你说她究竟是「大慈树王」，还是「小吉祥草王」？",
                    "choices": [
                        {
                            "id": "30010703",
                            "text": "「大慈树王」？",
                            "response": [
                                {
                                    "id": "30010704",
                                    "speaker": "派蒙",
                                    "text": "嗯，很有可能，毕竟这座神像看起来很古老了。"
                                },
                                {
                                    "id": "30010707",
                                    "speaker": "派蒙",
                                    "text": "算啦，关于她们的事情，我们以后总会打听到的。"
                                },
                                {
                                    "id": "30010708",
                                    "speaker": "派蒙",
                                    "text": "我们来清洁神像吧，我飞到上面去，你就负责擦下面好了。"
                                },
                                {
                                    "id": "30010709",
                                    "speaker": "Black Screen",
                                    "text": "和派蒙一起仔细擦拭了神像…"
                                }
                            ]
                        },
                        {
                            "id": "30010705",
                            "text": "「小吉祥草王」？",
                            "response": [
                                {
                                    "id": "30010706",
                                    "speaker": "派蒙",
                                    "text": "看这座神像的模样，倒是和这个名字挺相称的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "300151",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30015101",
                    "speaker": "柯莱",
                    "text": "我不太擅长攀爬，神像的清洁就交给你们了。"
                },
                {
                    "id": "30015102",
                    "speaker": "柯莱",
                    "text": "我去检查一下前面的设施。完工之后，如果可以的话…能和我再多聊聊吗？"
                }
            ]
        },
        {
            "id": "300199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30019901",
                    "speaker": "派蒙",
                    "text": "天亮了。走，我们去找柯莱吧。"
                },
                {
                    "id": "30019906",
                    "speaker": "柯莱",
                    "text": "好，这盏灯也没有问题。"
                },
                {
                    "id": "30019907",
                    "speaker": "派蒙",
                    "text": "上面就是草神的七天神像，就像之前一样试着触摸一下神像吧。"
                },
                {
                    "id": "30019908",
                    "speaker": "派蒙",
                    "text": "这次你也一定能获得草神的回应。"
                },
                {
                    "id": "30019909",
                    "speaker": "派蒙",
                    "text": "神像已经清洁干净了，我们下去和柯莱会合吧。"
                }
            ]
        }
    ]
}