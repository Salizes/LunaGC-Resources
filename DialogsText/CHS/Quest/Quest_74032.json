    "talks": [
        {
            "id": "7403201",
            "objective": "(test)靠近犯人医生周围触发reminder$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7403205",
            "objective": "",
            "dialogues": [
                {
                    "id": "740320501",
                    "speaker": "勒克莱德",
                    "text": "我感觉好虚弱…都怪那些黄绿黄绿的石头…"
                }
            ]
        },
        {
            "id": "7403202",
            "objective": "与勒克莱德对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740320201",
                    "speaker": "勒克莱德",
                    "text": "那些黄绿黄绿的石头…肯定大有问题，我要命丧于此了…"
                },
                {
                    "id": "740320202",
                    "speaker": "派蒙",
                    "text": "呃…你没事吧？"
                },
                {
                    "id": "740320203",
                    "speaker": "勒克莱德",
                    "text": "我…从长远来看，我们都会没事的。只是我要先各位一步没事了。",
                    "choices": [
                        {
                            "id": "740320204",
                            "text": "没事就好，再见。",
                            "response": [
                                {
                                    "id": "740320205",
                                    "speaker": "派蒙",
                                    "text": "不不不，怎么听都不是真的没事的意思吧！"
                                },
                                {
                                    "id": "740320208",
                                    "speaker": "勒克莱德",
                                    "text": "不，我真的没事。如果有事，那一定也为时已晚了，呜…"
                                },
                                {
                                    "id": "740320209",
                                    "speaker": "Player",
                                    "text": "所以到底是有事还是没事？"
                                },
                                {
                                    "id": "740320210",
                                    "speaker": "派蒙",
                                    "text": "我都被绕晕了，能不能说明白点…"
                                },
                                {
                                    "id": "740320211",
                                    "speaker": "勒克莱德",
                                    "text": "明白点说，我这阵子一来生产区就头痛欲裂，手脚发凉，还不时有心悸的症状…"
                                },
                                {
                                    "id": "740320212",
                                    "speaker": "勒克莱德",
                                    "text": "我肯定是要完蛋了！你们懂吗，要完蛋了！"
                                },
                                {
                                    "id": "740320213",
                                    "speaker": "勒克莱德",
                                    "text": "一定是那些黄绿色石头…那是很邪恶的石头！你们肯定知道吧，枫丹科学院的中央实验室…"
                                },
                                {
                                    "id": "740320214",
                                    "speaker": "勒克莱德",
                                    "text": "都怪那些黄绿色石头，把一切都毁了！",
                                    "choices": [
                                        {
                                            "id": "740320215",
                                            "text": "去看看医生吧。",
                                            "response": [
                                                {
                                                    "id": "740320217",
                                                    "speaker": "勒克莱德",
                                                    "text": "我自己就是医生我当然知道！哦不，我现在已经不是医生了…我已经没资格了，不能下诊断了…"
                                                },
                                                {
                                                    "id": "740320218",
                                                    "speaker": "勒克莱德",
                                                    "text": "求求你们，去找真正的医生，有资格的医生，救救我吧！"
                                                },
                                                {
                                                    "id": "740320219",
                                                    "speaker": "派蒙",
                                                    "text": "#唔，感觉他真的病得不轻…{NICKNAME}，我们去找医生问问看吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740320216",
                                            "text": "要不去医务室休息一下？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740320206",
                            "text": "感觉你在用什么很新的修辞手法。",
                            "response": [
                                {
                                    "id": "740320207",
                                    "speaker": "派蒙",
                                    "text": "听着一点也不像没事的样子…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403203",
            "objective": "询问阿德纳的意见",
            "dialogues": [
                {
                    "id": "740320301",
                    "speaker": "阿德纳",
                    "text": "遇到麻烦了吗？还是其他人有麻烦？看你们俩都面色红润，应该是其他人有麻烦吧。"
                },
                {
                    "id": "740320302",
                    "speaker": "派蒙",
                    "text": "确实是…"
                },
                {
                    "id": "740320303",
                    "speaker": "Black Screen",
                    "text": "说明了勒克莱德的情况…"
                },
                {
                    "id": "740320304",
                    "speaker": "阿德纳",
                    "text": "又是他啊…老毛病了。"
                },
                {
                    "id": "740320305",
                    "speaker": "Player",
                    "text": "那还有得治吗？"
                },
                {
                    "id": "740320306",
                    "speaker": "阿德纳",
                    "text": "你是指头痛，还是妄想症？"
                },
                {
                    "id": "740320307",
                    "speaker": "派蒙",
                    "text": "欸？所以说，他是根本没什么大病？"
                },
                {
                    "id": "740320308",
                    "speaker": "阿德纳",
                    "text": "从之前检查的结果来看，多半是没有吧。"
                },
                {
                    "id": "740320309",
                    "speaker": "阿德纳",
                    "text": "听说他过去在外边的时候曾经误诊，忽略了早期征兆，导致患者…唉，总之，或许自那之后他就有些神经过敏。"
                },
                {
                    "id": "740320310",
                    "speaker": "阿德纳",
                    "text": "对别人是这样，对他自己更是。"
                },
                {
                    "id": "740320311",
                    "speaker": "Player",
                    "text": "那黄绿色石头没问题吗？"
                },
                {
                    "id": "740320312",
                    "speaker": "阿德纳",
                    "text": "你看除了他之外，其他人不都活蹦乱跳的么。"
                },
                {
                    "id": "740320313",
                    "speaker": "阿德纳",
                    "text": "话虽如此，也不能放着不管。你们把这个带给他吧。"
                },
                {
                    "id": "740320314",
                    "speaker": "派蒙",
                    "text": "这个…这不是「纯洁之水」吗？真的没问题吗？"
                },
                {
                    "id": "740320315",
                    "speaker": "阿德纳",
                    "text": "哦，你们也知道这个啊。没关系的，至少对身体没害处，还能让他打起精神来。",
                    "choices": [
                        {
                            "id": "740320316",
                            "text": "那他不知道吗？",
                            "response": [
                                {
                                    "id": "740320317",
                                    "speaker": "阿德纳",
                                    "text": "据我所知，他对这些饮料都是敬而远之，之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。"
                                },
                                {
                                    "id": "740320322",
                                    "speaker": "派蒙",
                                    "text": "好吧，那我们就先把这个带给他。如果还是不行的话…"
                                },
                                {
                                    "id": "740320323",
                                    "speaker": "阿德纳",
                                    "text": "那就让他去医务室躺下吧。就说是医嘱，他会听的。"
                                },
                                {
                                    "id": "740320324",
                                    "speaker": "派蒙",
                                    "text": "#好哦，那我们回去找他吧，{NICKNAME}。"
                                }
                            ]
                        },
                        {
                            "id": "740320318",
                            "text": "那不如喝枫达。",
                            "response": [
                                {
                                    "id": "740320319",
                                    "speaker": "阿德纳",
                                    "text": "这就是问题所在，这里没人不知道枫达的味道。"
                                },
                                {
                                    "id": "740320320",
                                    "speaker": "阿德纳",
                                    "text": "但据我所知，他没试过「纯洁之水」，毕竟流通的范围相当有限…"
                                },
                                {
                                    "id": "740320321",
                                    "speaker": "阿德纳",
                                    "text": "之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403204",
            "objective": "向勒克莱德回报",
            "dialogues": [
                {
                    "id": "740320401",
                    "speaker": "派蒙",
                    "text": "我们回来了，医生让我们把这个交给你…"
                },
                {
                    "id": "740320402",
                    "speaker": "Black Screen",
                    "text": "勒克莱德接过「纯洁之水」，一饮而尽。"
                },
                {
                    "id": "740320403",
                    "speaker": "勒克莱德",
                    "text": "我感觉好多了！活力重新回到了我的身体！",
                    "choices": [
                        {
                            "id": "740320404",
                            "text": "这就好了？",
                            "response": [
                                {
                                    "id": "740320405",
                                    "speaker": "派蒙",
                                    "text": "见效也太快了吧！"
                                },
                                {
                                    "id": "740320408",
                                    "speaker": "勒克莱德",
                                    "text": "阿德纳医生不愧是有资格的医生，药到病除。不像我…"
                                },
                                {
                                    "id": "740320409",
                                    "speaker": "派蒙",
                                    "text": "那黄绿色的石头…"
                                },
                                {
                                    "id": "740320410",
                                    "speaker": "勒克莱德",
                                    "text": "大有问题！"
                                },
                                {
                                    "id": "740320411",
                                    "speaker": "派蒙",
                                    "text": "呃…看来是头痛治好了，但是另一边的问题还是没解决呢。"
                                },
                                {
                                    "id": "740320412",
                                    "speaker": "勒克莱德",
                                    "text": "这下我可以继续工作了。谢谢你们，辛苦你们跑这么一趟，这些特许券你们就收下吧，一点小小心意。"
                                },
                                {
                                    "id": "740320413",
                                    "speaker": "勒克莱德",
                                    "text": "希望你们身体健康！"
                                }
                            ]
                        },
                        {
                            "id": "740320406",
                            "text": "我觉得你根本没病…",
                            "response": [
                                {
                                    "id": "740320407",
                                    "speaker": "勒克莱德",
                                    "text": "病是真的病，药也是真的药！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740320601",
                    "speaker": "阿德纳",
                    "text": "勒克莱德只是老毛病又犯了，你们也不用太过担心了。"
                }
            ]
        }
    ]
}