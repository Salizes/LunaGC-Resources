            "派蒙": 10
        }
    },
    "talks": [
        {
            "id": "7905301",
            "objective": "",
            "dialogues": [
                {
                    "id": "790530101",
                    "speaker": "伊迪娅",
                    "text": "「欢迎来到『琉形蜃境』，希望你们能够在这里稍微忘记旅途的疲惫，好好休息一番。」"
                },
                {
                    "id": "790530102",
                    "speaker": "伊迪娅",
                    "text": "本来应该在初次见面的时候说这种欢迎辞的，唉，没想到居然发生了那么多事。"
                },
                {
                    "id": "790530103",
                    "speaker": "伊迪娅",
                    "text": "既然一切恢复了，那就为你补上这句开场…怎么样，听上去还是挺正经的吧！",
                    "choices": [
                        {
                            "id": "790530104",
                            "text": "关于先成图…",
                            "response": [
                                {
                                    "id": "790530105",
                                    "speaker": "伊迪娅",
                                    "text": "欸，是要我解释原理吗，其实原理我也没有那么清楚啦。总之，先成图更像是一种想法…"
                                },
                                {
                                    "id": "790530106",
                                    "speaker": "伊迪娅",
                                    "text": "就像植物如何生长其实早就写入种子之中，就像鸟的翅膀如何展开早在卵中业已注定。"
                                },
                                {
                                    "id": "790530107",
                                    "speaker": "伊迪娅",
                                    "text": "事物符合道理地变成现在目及的一切，而在最开始的开始或许已经奠定了万物的蓝图。"
                                },
                                {
                                    "id": "790530108",
                                    "speaker": "伊迪娅",
                                    "text": "先成图就是那份蓝图，然后由瓶中的折光照射，展开变成了整个琉形蜃境。啊，只不过这是只能在这支魔瓶里才能实现的伎俩。"
                                }
                            ]
                        },
                        {
                            "id": "790530109",
                            "text": "关于纯水精灵…",
                            "response": [
                                {
                                    "id": "790530110",
                                    "speaker": "伊迪娅",
                                    "text": "啊，你是说为什么从枫丹逃离的事吗？回想起来就像是上辈子的事一样…"
                                },
                                {
                                    "id": "790530111",
                                    "speaker": "伊迪娅",
                                    "text": "要说逃出来的理由的话，是因为「水」，枫丹的水变了，对于纯水精灵来说，那里的水现在充满了…痛苦与仇恨？"
                                },
                                {
                                    "id": "790530112",
                                    "speaker": "伊迪娅",
                                    "text": "对我们来说，如果要活下去，最好从故土逃离。啊，就是在那个时候慌不择路，倒在了沙漠里…"
                                },
                                {
                                    "id": "790530113",
                                    "speaker": "伊迪娅",
                                    "text": "要我说，这片沙漠也太大了！"
                                }
                            ]
                        },
                        {
                            "id": "790530114",
                            "text": "关于洛蒂娅…",
                            "response": [
                                {
                                    "id": "790530115",
                                    "speaker": "伊迪娅",
                                    "text": "哦，你是说洛蒂娅姐姐吗，咦，你见过她吗？"
                                },
                                {
                                    "id": "790530116",
                                    "speaker": "伊迪娅",
                                    "text": "看来她也找到了属于自己的栖身之所…轻策庄，在璃月吗？那还真是，离开到了很远的地方啊，洛蒂娅姐姐…"
                                }
                            ]
                        },
                        {
                            "id": "790530117",
                            "text": "要好好加油哦！",
                            "response": [
                                {
                                    "id": "790530118",
                                    "speaker": "伊迪娅",
                                    "text": "嗯，我会…我会努力的！也请你好好享受这里湿润的环境吧，在沙漠里有这样的地方还挺难得的呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7905302",
            "objective": "",
            "dialogues": [
                {
                    "id": "790531301",
                    "speaker": "派蒙",
                    "text": "伊迪娅小姐，紧急情况，重大事件！"
                },
                {
                    "id": "790531302",
                    "speaker": "派蒙",
                    "text": "我们找到了一块怀表！你快看看，这是不是传说中的摩拉怀表！",
                    "choices": [
                        {
                            "id": "790531303",
                            "text": "外表确实金灿灿的！",
                            "response": [
                                {
                                    "id": "790531305",
                                    "speaker": "伊迪娅",
                                    "text": "哦？让我来瞧一瞧…"
                                },
                                {
                                    "id": "790531306",
                                    "speaker": "伊迪娅",
                                    "text": "居然，居然真被你们找到了！难道说，一切都有冥冥之中的旨意？"
                                },
                                {
                                    "id": "790531307",
                                    "speaker": "伊迪娅",
                                    "text": "神奇的冒险家留下了终极的彩蛋，结果被传奇的旅行者找到…"
                                },
                                {
                                    "id": "790531308",
                                    "speaker": "伊迪娅",
                                    "text": "我好像在这之中感受到了某种…精神的传承！"
                                },
                                {
                                    "id": "790531309",
                                    "speaker": "派蒙",
                                    "text": "你这么夸奖我们，我倒是很高兴啦，不过现在我更好奇，找到怀表后会发生什么事…",
                                    "choices": [
                                        {
                                            "id": "790531310",
                                            "text": "会有额外的奖励吗？",
                                            "response": [
                                                {
                                                    "id": "790531312",
                                                    "speaker": "伊迪娅",
                                                    "text": "都…都没有哦…"
                                                },
                                                {
                                                    "id": "790531313",
                                                    "speaker": "伊迪娅",
                                                    "text": "其实我完全没考虑过，会有人找到这个怀表…毕竟我自己都忘了它埋在哪。"
                                                },
                                                {
                                                    "id": "790531314",
                                                    "speaker": "伊迪娅",
                                                    "text": "但它本身就很有价值，对不对！不需要我这边再给你们额外的奖励了。"
                                                },
                                                {
                                                    "id": "790531315",
                                                    "speaker": "伊迪娅",
                                                    "text": "总之，我要把这件事记录下来，适当添加笔墨，描写成激动人心的故事，绘声绘色地向之后的客人描述。"
                                                },
                                                {
                                                    "id": "790531316",
                                                    "speaker": "伊迪娅",
                                                    "text": "接下来，你们埋藏的宝藏，就要完全取代这块摩拉怀表的地位了！"
                                                },
                                                {
                                                    "id": "790531317",
                                                    "speaker": "派蒙",
                                                    "text": "倒也是哦，最开始我们就聊到过，重点在于宝藏中蕴藏的故事…"
                                                },
                                                {
                                                    "id": "790531318",
                                                    "speaker": "派蒙",
                                                    "text": "#总之，我们再研究一下这块怀表吧，{NICKNAME}！"
                                                },
                                                {
                                                    "id": "790531319",
                                                    "speaker": "派蒙",
                                                    "text": "伊迪娅小姐，拜托你把我们的故事写得精彩一点了！"
                                                },
                                                {
                                                    "id": "790531320",
                                                    "speaker": "伊迪娅",
                                                    "text": "放心吧放心吧，包在我身上！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790531311",
                                            "text": "会触发隐藏事件吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790531304",
                            "text": "外壳画着摩拉花纹！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7905304",
            "objective": "",
            "dialogues": [
                {
                    "id": "790531401",
                    "speaker": "伊迪娅",
                    "text": "啊，是你们两位呀，怎么了，看上去有什么事需要咨询的样子。"
                },
                {
                    "id": "790531402",
                    "speaker": "伊迪娅",
                    "text": "不过如果有什么关于「琉形蜃境」的事要问，那问我就问对人啦，对我来说，「琉形蜃境」就跟我手掌上的水纹一样…",
                    "choices": [
                        {
                            "id": "790531403",
                            "text": "水、水形皱纹？",
                            "response": [
                                {
                                    "id": "790531404",
                                    "speaker": "伊迪娅",
                                    "text": "那只是一种比喻啦！我才不会长皱纹呢！"
                                },
                                {
                                    "id": "790531407",
                                    "speaker": "派蒙",
                                    "text": "总之，事情是这样的！我们在乐园里捡到了这样一张信纸！"
                                },
                                {
                                    "id": "790531408",
                                    "speaker": "派蒙",
                                    "text": "伊迪娅肯定知道这是怎么来的吧。"
                                },
                                {
                                    "id": "790531409",
                                    "speaker": "伊迪娅",
                                    "text": "那是当然，这封信一看就是…咦，还是第一次看到这样的信…"
                                },
                                {
                                    "id": "790531410",
                                    "speaker": "派蒙",
                                    "text": "手掌上的水纹看起来很模糊的样子呢…"
                                },
                                {
                                    "id": "790531411",
                                    "speaker": "伊迪娅",
                                    "text": "这、这显然是趁我不注意的时候，有人悄悄埋下的，第一次看到也很正常。"
                                },
                                {
                                    "id": "790531412",
                                    "speaker": "伊迪娅",
                                    "text": "而且，从内容上看，比起一封信，更像是留下的遗书和记录，到底是谁呢，信上这个说话的语调，总觉得有点熟悉…"
                                },
                                {
                                    "id": "790531413",
                                    "speaker": "Player",
                                    "text": "看上去和「蜃楼玉匣」有关？"
                                },
                                {
                                    "id": "790531414",
                                    "speaker": "伊迪娅",
                                    "text": "啊！这么一说我想起来了，这是把「蜃楼玉匣」带进来的那个老人留下来的…那还是，那还是我来瓶子里没有多久的事。"
                                },
                                {
                                    "id": "790531415",
                                    "speaker": "伊迪娅",
                                    "text": "老人是位稻妻人，一进来就问，这里是不是能够达成别人愿望的秘境，让我把他送回从前的战场…"
                                },
                                {
                                    "id": "790531416",
                                    "speaker": "伊迪娅",
                                    "text": "我设法向他解释，但是…他进入秘境的时候身体状况十分糟糕，看得出来由于长途跋涉，精神也到了有些油尽灯枯的程度…"
                                },
                                {
                                    "id": "790531417",
                                    "speaker": "伊迪娅",
                                    "text": "一个劲地说着「求你了，把我送回那一天…」或者「把我送回那场战争中吧…」这种话。"
                                },
                                {
                                    "id": "790531418",
                                    "speaker": "伊迪娅",
                                    "text": "所以我就用瓶中的蜃境…仿造了他想象中的战场。"
                                },
                                {
                                    "id": "790531419",
                                    "speaker": "派蒙",
                                    "text": "啊，所以信里的「终于回到此处」…"
                                },
                                {
                                    "id": "790531420",
                                    "speaker": "伊迪娅",
                                    "text": "大概是恍惚间醒来，发现周围的蜃境与化作记忆中战场类似的样子了吧。战场还挺可怕的，但是他却笑得很开心。"
                                },
                                {
                                    "id": "790531421",
                                    "speaker": "伊迪娅",
                                    "text": "怎么会有人在生命的最后想看到那样可怕的场景呢…",
                                    "choices": [
                                        {
                                            "id": "790531422",
                                            "text": "或许对他有别样的意义…",
                                            "response": [
                                                {
                                                    "id": "790531424",
                                                    "speaker": "伊迪娅",
                                                    "text": "这我就不是很懂啦，不过他最后看上去也挺满足的。"
                                                },
                                                {
                                                    "id": "790531425",
                                                    "speaker": "伊迪娅",
                                                    "text": "如果有一定要在那种场景里达成的愿望，背负那个愿望的岁月里，肯定也很辛苦吧。"
                                                },
                                                {
                                                    "id": "790531426",
                                                    "speaker": "伊迪娅",
                                                    "text": "在让核心轮縠重新转起来的时候，「蜃楼玉匣」也帮了不少忙，这么一说，还得谢谢这位秀家先生呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790531423",
                                            "text": "或许这样比较刺激吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790531405",
                            "text": "真的吗，让我看看！",
                            "response": [
                                {
                                    "id": "790531406",
                                    "speaker": "伊迪娅",
                                    "text": "只、只是一种比喻啦，就跟你的掌纹一样，没什么好看的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}