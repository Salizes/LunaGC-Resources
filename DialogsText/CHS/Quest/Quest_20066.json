{
    "quest": {
        "id": "20066",
        "title": "艾琳，未来的骑士——",
        "description": "为了成为一名骑士，艾琳正在努力练习，但却始终不得章法。艾琳希望有人能来指导她…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
