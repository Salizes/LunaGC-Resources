    "talks": [
        {
            "id": "7105301",
            "objective": "与海迪夫对话",
            "dialogues": [
                {
                    "id": "710501401",
                    "speaker": "海迪夫",
                    "text": "先不说其他的了。"
                },
                {
                    "id": "710501402",
                    "speaker": "海迪夫",
                    "text": "在层岩巨渊的这几天，你做了很多，我都不知道应该怎么感谢你了。"
                },
                {
                    "id": "710501403",
                    "speaker": "海迪夫",
                    "text": "如果再给你钱，也实在是太过生分了。"
                },
                {
                    "id": "710501404",
                    "speaker": "Player",
                    "text": "其实你一定要给的话…"
                },
                {
                    "id": "710501405",
                    "speaker": "海迪夫",
                    "text": "别开玩笑了，我怎么能做出给你一笔钱了事，这种不解风情的行为。"
                },
                {
                    "id": "710501406",
                    "speaker": "海迪夫",
                    "text": "那不是在污辱你吗！"
                },
                {
                    "id": "710501407",
                    "speaker": "海迪夫",
                    "text": "来，收好这封信吧，如果你以后有机会去须弥，遇到了什么麻烦，或有什么需要帮助的，那就拿着这封信找普尔比鲁尼一门的人！"
                },
                {
                    "id": "710501408",
                    "speaker": "海迪夫",
                    "text": "我们一定会尽全力帮助你的。"
                },
                {
                    "id": "710501409",
                    "speaker": "海迪夫",
                    "text": "「往来的人情，比黄金还宝贵。」"
                },
                {
                    "id": "710501410",
                    "speaker": "海迪夫",
                    "text": "这句须弥谚语，说的就是这样的情形吧。"
                }
            ]
        }
    ]
}