    "talks": [
        {
            "id": "1203901",
            "objective": "抵达试刀之所",
            "dialogues": []
        },
        {
            "id": "1203905",
            "objective": "深入其中，击败敌人",
            "dialogues": []
        },
        {
            "id": "1203906",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120390601",
                    "speaker": "派蒙",
                    "text": "感觉怎么样？没事吧？"
                },
                {
                    "id": "120390602",
                    "speaker": "枫原万叶",
                    "text": "我还好、这把刀和我预料得差不多，因为长期缺乏养护，使用起来已经很困难了。"
                },
                {
                    "id": "120390603",
                    "speaker": "枫原万叶",
                    "text": "虽然他还在咬牙支撑和嘴硬，但我想这也只是暂时的了。"
                },
                {
                    "id": "120390604",
                    "speaker": "枫原万叶",
                    "text": "嗯…"
                },
                {
                    "id": "120390605",
                    "speaker": "派蒙",
                    "text": "还有什么在意的事吗？"
                },
                {
                    "id": "120390606",
                    "speaker": "枫原万叶",
                    "text": "有点古怪，他并没有试图控制我，而是在尝试配合我的节奏。"
                },
                {
                    "id": "120390607",
                    "speaker": "枫原万叶",
                    "text": "我们继续往前吧。"
                }
            ]
        },
        {
            "id": "1203907",
            "objective": "继续深入，击败敌人",
            "dialogues": []
        },
        {
            "id": "1203908",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120390801",
                    "speaker": "派蒙",
                    "text": "哇，这把刀好像不太对劲了！",
                    "choices": [
                        {
                            "id": "120390802",
                            "text": "怎么回事？",
                            "response": [
                                {
                                    "id": "120390804",
                                    "speaker": "枫原万叶",
                                    "text": "我能感觉到他的力量在逐渐衰弱，我用起来也越来越吃力了。"
                                },
                                {
                                    "id": "120390805",
                                    "speaker": "枫原万叶",
                                    "text": "他应该撑不了太久了，如果继续坚持，或许随时都有可能断掉。"
                                },
                                {
                                    "id": "120390806",
                                    "speaker": "派蒙",
                                    "text": "那、那天目优也岂不是也会…"
                                },
                                {
                                    "id": "120390807",
                                    "speaker": "枫原万叶",
                                    "text": "我会小心使用，他说他也没有轻言放弃的打算。"
                                },
                                {
                                    "id": "120390808",
                                    "speaker": "枫原万叶",
                                    "text": "他还在努力…"
                                }
                            ]
                        },
                        {
                            "id": "120390803",
                            "text": "变暗了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203909",
            "objective": "继续深入，击败敌人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1203921",
            "objective": "继续深入，击败敌人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1203923",
            "objective": "继续深入，击败敌人",
            "dialogues": []
        },
        {
            "id": "1203910",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120391001",
                    "speaker": "派蒙",
                    "text": "没事吧？感觉你打得很吃力。"
                },
                {
                    "id": "120391002",
                    "speaker": "枫原万叶",
                    "text": "嗯…他也到极限了。"
                },
                {
                    "id": "120391003",
                    "speaker": "派蒙",
                    "text": "光芒好像又暗了一些，已经没有一开始那么威风了。"
                },
                {
                    "id": "120391004",
                    "speaker": "枫原万叶",
                    "text": "或许这次，我们终于有机会见到他的真面目。"
                },
                {
                    "id": "120391005",
                    "speaker": "派蒙",
                    "text": "真面目，你在说什么…欸？欸——？！"
                },
                {
                    "id": "120391006",
                    "speaker": "派蒙",
                    "text": "这和刚刚的是一把刀吗？！居然这么破破烂烂的！",
                    "choices": [
                        {
                            "id": "120391007",
                            "text": "损耗相当严重。",
                            "response": [
                                {
                                    "id": "120391009",
                                    "speaker": "枫原万叶",
                                    "text": "以你的状态，别说是挑战将军大人，继续下去的话，同样的武士与海乱鬼你都无法战胜了。"
                                },
                                {
                                    "id": "120391010",
                                    "speaker": "枫原万叶",
                                    "text": "就算你被锻造出来的时候确实拥有匹敌天光的能力，但从至冬国抵达稻妻的漫长旅途已经让你残破不堪。"
                                },
                                {
                                    "id": "120391011",
                                    "speaker": "枫原万叶",
                                    "text": "已经不必多说了吧——你的愿望只是一厢情愿。",
                                    "choices": [
                                        {
                                            "id": "120391012",
                                            "text": "他能听进去吗？",
                                            "response": [
                                                {
                                                    "id": "120391014",
                                                    "speaker": "枫原万叶",
                                                    "text": "我终于明白提出赌约那时候，你想知道的事是什么了。"
                                                },
                                                {
                                                    "id": "120391015",
                                                    "speaker": "枫原万叶",
                                                    "text": "你试图与我进入「一心」的状态，这样你或许还能发挥更强的力量。"
                                                },
                                                {
                                                    "id": "120391016",
                                                    "speaker": "枫原万叶",
                                                    "text": "但是很遗憾，我和你完全不一样。我理解不了你的偏执与残忍，也无法与锻刀人共鸣。"
                                                },
                                                {
                                                    "id": "120391017",
                                                    "speaker": "枫原万叶",
                                                    "text": "——唯一理解你的人，在你诞生之时就已经逝去了。"
                                                },
                                                {
                                                    "id": "120391018",
                                                    "speaker": "派蒙",
                                                    "text": "欸？这又是什么意思？"
                                                },
                                                {
                                                    "id": "120391019",
                                                    "speaker": "村山",
                                                    "text": "就是他们，把他们干掉！"
                                                },
                                                {
                                                    "id": "120391020",
                                                    "speaker": "派蒙",
                                                    "text": "哇，怎么还有！"
                                                },
                                                {
                                                    "id": "120391021",
                                                    "speaker": "Player",
                                                    "text": "这把刀应该不能用了吧。"
                                                },
                                                {
                                                    "id": "120391022",
                                                    "speaker": "派蒙",
                                                    "text": "对，这里就我们来帮忙！"
                                                },
                                                {
                                                    "id": "120391023",
                                                    "speaker": "枫原万叶",
                                                    "text": "没关系，我用我自己的刀。"
                                                },
                                                {
                                                    "id": "120391024",
                                                    "speaker": "枫原万叶",
                                                    "text": "不过是又一群敌人而已。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120391013",
                                            "text": "虽然事实就在眼前。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120391008",
                            "text": "确实快要断了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203922",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120392801",
                    "speaker": "派蒙",
                    "text": "好险好险…"
                },
                {
                    "id": "120392802",
                    "speaker": "枫原万叶",
                    "text": "抱歉，最后还要你们出手相助。"
                }
            ]
        },
        {
            "id": "1203911",
            "objective": "继续深入，击败敌人",
            "dialogues": []
        },
        {
            "id": "1203912",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120391201",
                    "speaker": "派蒙",
                    "text": "用上了顺手的武器果然好多了。"
                },
                {
                    "id": "120391202",
                    "speaker": "「一心传」名刀",
                    "text": "…你不愧是枫原家的后人，我们只是进行了一场简短的战斗，你就借由刀看穿了我的内心。"
                },
                {
                    "id": "120391203",
                    "speaker": "「一心传」名刀",
                    "text": "旅途中没有人了解我的故事，我也从来没有提过，你是第一个知道这些的人。"
                },
                {
                    "id": "120391204",
                    "speaker": "「一心传」名刀",
                    "text": "那时候我就在想，如果能借由你达成「一心」，那我就还有机会。"
                },
                {
                    "id": "120391205",
                    "speaker": "枫原万叶",
                    "text": "然而这样的尝试也失败了。"
                },
                {
                    "id": "120391206",
                    "speaker": "「一心传」名刀",
                    "text": "是啊，无论我再怎么努力，也达不到你和你的惯用刀那样的契合程度。"
                },
                {
                    "id": "120391207",
                    "speaker": "「一心传」名刀",
                    "text": "太长的时间过去，我刀身的状态很差，没有得到过很好的保养，只能用光芒掩饰我的真实样貌。"
                },
                {
                    "id": "120391208",
                    "speaker": "「一心传」名刀",
                    "text": "不愧是能接下「无想的一刀」的名刀，或许我真的无法触及这个高度了…"
                },
                {
                    "id": "120391209",
                    "speaker": "枫原万叶",
                    "text": "但其实，这只是我在游历璃月的时候随意挑选的一把刀而已。"
                },
                {
                    "id": "120391210",
                    "speaker": "「一心传」名刀",
                    "text": "什、什么…"
                },
                {
                    "id": "120391211",
                    "speaker": "枫原万叶",
                    "text": "刀的铸造和保养很重要，但肯定不是全部。"
                },
                {
                    "id": "120391212",
                    "speaker": "枫原万叶",
                    "text": "它跟随我行走多年，我们心意相通，再加上那时候形势所迫，我受到了来自另一股力量的加持。"
                },
                {
                    "id": "120391213",
                    "speaker": "枫原万叶",
                    "text": "——武技与刀，意念与心，缺一不可，「一心传」从来都是如此。"
                },
                {
                    "id": "120391214",
                    "speaker": "「一心传」名刀",
                    "text": "……"
                },
                {
                    "id": "120391215",
                    "speaker": "枫原万叶",
                    "text": "还要告诉你一件事，或许那位锻刀人不知道，使你拥有意识的是一种源自祟神的力量。"
                },
                {
                    "id": "120391216",
                    "speaker": "枫原万叶",
                    "text": "它是从远古遗留下来的邪恶残渣，也是你心中狂躁与暴戾的根源。"
                },
                {
                    "id": "120391217",
                    "speaker": "枫原万叶",
                    "text": "虽然一路上你都试图配合我，但祟神之力的部分一直都试图抢夺我的身体。"
                },
                {
                    "id": "120391218",
                    "speaker": "「一心传」名刀",
                    "text": "我有所察觉，但无法改变，这就是我意识的一部分。"
                },
                {
                    "id": "120391219",
                    "speaker": "枫原万叶",
                    "text": "我想要救天目优也，所以我抵抗了它的蛊惑。至于你，我不知道你有没有对抗它的想法。"
                },
                {
                    "id": "120391220",
                    "speaker": "枫原万叶",
                    "text": "我为你感到深深的遗憾，因为你走上了一段注定无法抵达终点的旅途。"
                },
                {
                    "id": "120391221",
                    "speaker": "枫原万叶",
                    "text": "启程之时，你就失去了唯一能发挥出你力量的人，但你没办法对那个人的愿望说「不」。"
                },
                {
                    "id": "120391222",
                    "speaker": "枫原万叶",
                    "text": "你早就意识到了这件事，这才是你一切绝望的根源。"
                },
                {
                    "id": "120391223",
                    "speaker": "「一心传」名刀",
                    "text": "我的生命，我的身体，我的一切都是他给的…"
                },
                {
                    "id": "120391224",
                    "speaker": "「一心传」名刀",
                    "text": "我怎么可能拒绝他…"
                },
                {
                    "id": "120391225",
                    "speaker": "「一心传」名刀",
                    "text": "我说，「放心吧，接下来的事交给我就好。」"
                },
                {
                    "id": "120391226",
                    "speaker": "「一心传」名刀",
                    "text": "这总不能是在说谎吧…"
                },
                {
                    "id": "120391227",
                    "speaker": "派蒙",
                    "text": "唔…"
                },
                {
                    "id": "120391228",
                    "speaker": "枫原万叶",
                    "text": "我相信我们的约定已经有了答案，我不会再多说什么了。"
                },
                {
                    "id": "120391229",
                    "speaker": "派蒙",
                    "text": "你去哪里啊，万叶？"
                },
                {
                    "id": "120391230",
                    "speaker": "枫原万叶",
                    "text": "他已经没有能力，也没有心思作乱了。留点时间，让他好好想想吧。"
                }
            ]
        },
        {
            "id": "1203913",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120391301",
                    "speaker": "枫原万叶",
                    "text": "初次接触刀柄的瞬间，我仿佛被送入了一个神秘的空间，是完全陌生的地方。"
                },
                {
                    "id": "120391302",
                    "speaker": "枫原万叶",
                    "text": "有一位刀匠静静地躺在床上，月光照亮他虚弱的脸庞，已经气若游丝，命不久矣。"
                },
                {
                    "id": "120391303",
                    "speaker": "枫原万叶",
                    "text": "刚锻好的这把刀就放在他的身边，倾听他的话语。"
                },
                {
                    "id": "120391304",
                    "speaker": "派蒙",
                    "text": "是…寄宿在刀里的回忆，对吧？"
                },
                {
                    "id": "120391305",
                    "speaker": "枫原万叶",
                    "text": "那位刀匠在至冬国知晓了事件的真相，「一心传」因他们的叛逃而遭受重创。"
                },
                {
                    "id": "120391306",
                    "speaker": "枫原万叶",
                    "text": "他穷尽一生，并非要宣泄愤恨，而是一种补偿。"
                },
                {
                    "id": "120391307",
                    "speaker": "枫原万叶",
                    "text": "他深深地为受到愚人众的蒙骗而忏悔，但他再也无法踏上家乡的故土。他的想法，就是把他最满意的作品送回去。"
                },
                {
                    "id": "120391308",
                    "speaker": "枫原万叶",
                    "text": "他嘱咐这把有意识的刀，无论如何要回到稻妻，但不是为了匹敌神明…"
                },
                {
                    "id": "120391309",
                    "speaker": "枫原万叶",
                    "text": "——只是为了证明，他们曾经辉煌过，他们也值得被信任。"
                },
                {
                    "id": "120391310",
                    "speaker": "派蒙",
                    "text": "原来是这样…"
                },
                {
                    "id": "120391311",
                    "speaker": "派蒙",
                    "text": "在这之后，刀匠的想法被祟神之力扭曲，才逐渐变成了今天的样子。"
                },
                {
                    "id": "120391312",
                    "speaker": "枫原万叶",
                    "text": "嗯。我想那位刀匠由始至终都不知道他提纯出的力量其实是祟神之力，那种恨意令这把刀走上了不归路。"
                },
                {
                    "id": "120391313",
                    "speaker": "枫原万叶",
                    "text": "这把刀已然罪无可恕，但也只是因为他失去了持刀者，没有人能在他走向歧途的时候指明他的错误。"
                },
                {
                    "id": "120391314",
                    "speaker": "派蒙",
                    "text": "唉，可是太晚了。"
                },
                {
                    "id": "120391315",
                    "speaker": "枫原万叶",
                    "text": "是啊，太晚了。"
                },
                {
                    "id": "120391316",
                    "speaker": "枫原万叶",
                    "text": "时间不会为他的执着驻足停留。他的愿望，还一厢情愿地停留在启程的时候。"
                },
                {
                    "id": "120391317",
                    "speaker": "枫原万叶",
                    "text": "他好像已经冷静下来了，我们回去看看吧。"
                }
            ]
        },
        {
            "id": "1203914",
            "objective": "聆听妖刀此时的想法",
            "dialogues": [
                {
                    "id": "120391401",
                    "speaker": "「一心传」名刀",
                    "text": "我回望过去，被锻造出来的日子仿佛就在昨天。"
                },
                {
                    "id": "120391402",
                    "speaker": "「一心传」名刀",
                    "text": "我曾对他说，为了他的夙愿我可以放弃一切，以报答他赐予我的意识。"
                },
                {
                    "id": "120391403",
                    "speaker": "「一心传」名刀",
                    "text": "然而黑暗与血腥会令人麻木，我逐渐无法分辨「报恩」与「仇恨」的区别。"
                },
                {
                    "id": "120391404",
                    "speaker": "「一心传」名刀",
                    "text": "我非但没能实现他的愿望，还弄脏了它…"
                },
                {
                    "id": "120391405",
                    "speaker": "枫原万叶",
                    "text": "你终于可以看清事实了。"
                },
                {
                    "id": "120391406",
                    "speaker": "「一心传」名刀",
                    "text": "既然我们有过约定，我会尊重眼前的结果，释放天目优也。"
                },
                {
                    "id": "120391407",
                    "speaker": "「一心传」名刀",
                    "text": "但我还是无法放弃他的夙愿，因为这是我存在的意义。"
                },
                {
                    "id": "120391408",
                    "speaker": "「一心传」名刀",
                    "text": "所以，能否请求你，帮助我完成属于我和他的心愿呢？"
                },
                {
                    "id": "120391409",
                    "speaker": "派蒙",
                    "text": "怎么还把你的心愿加进来了？可不要得寸进尺啊。"
                },
                {
                    "id": "120391410",
                    "speaker": "「一心传」名刀",
                    "text": "必须是这个顺序才行，总之请你们先听听看吧…不答应也好，我会按照约定释放天目优也。"
                },
                {
                    "id": "120391411",
                    "speaker": "「一心传」名刀",
                    "text": "我的刀身和知识，对你来说，仍然拥有价值。"
                },
                {
                    "id": "120391412",
                    "speaker": "派蒙",
                    "text": "他的态度柔和了很多呢…"
                },
                {
                    "id": "120391413",
                    "speaker": "派蒙",
                    "text": "万叶你觉得呢，要不要给他这个机会？"
                },
                {
                    "id": "120391414",
                    "speaker": "枫原万叶",
                    "text": "说说看吧。"
                },
                {
                    "id": "120391415",
                    "speaker": "「一心传」名刀",
                    "text": "感谢你们。在我被锻造出来的时候，他已经病入膏肓，他对我说，很想让我有一场威风凛凛的初阵。"
                },
                {
                    "id": "120391416",
                    "speaker": "「一心传」名刀",
                    "text": "然而他再也没能从病榻上站起来…"
                },
                {
                    "id": "120391417",
                    "speaker": "「一心传」名刀",
                    "text": "之后，我也从来没有经历过属于自己的战场。"
                },
                {
                    "id": "120391418",
                    "speaker": "「一心传」名刀",
                    "text": "我的战斗没有光辉的意义，我只是在不停地旅行，然后…不停地犯错。"
                },
                {
                    "id": "120391419",
                    "speaker": "「一心传」名刀",
                    "text": "你是很好的持刀人，我很想借你之手体会一番，何为武士之间的战斗。"
                },
                {
                    "id": "120391420",
                    "speaker": "枫原万叶",
                    "text": "那对手呢？"
                },
                {
                    "id": "120391421",
                    "speaker": "「一心传」名刀",
                    "text": "我会释放天目优也，让他恢复意识，然后能否请你们说服他，和你打一场。"
                },
                {
                    "id": "120391422",
                    "speaker": "「一心传」名刀",
                    "text": "他一定对我抱有恨意，也有充足的战斗理由。"
                },
                {
                    "id": "120391423",
                    "speaker": "枫原万叶",
                    "text": "我知道了，那就先让他醒过来，我们确认一下他是否有体力与意愿来战斗。"
                },
                {
                    "id": "120391424",
                    "speaker": "Black Screen",
                    "text": "天目优也终于清醒，向他说明了情况。"
                },
                {
                    "id": "120391425",
                    "speaker": "天目优也",
                    "text": "原来是这样，他用我的身体…伤了人。"
                },
                {
                    "id": "120391426",
                    "speaker": "天目优也",
                    "text": "我憎恨他的所作所为，但他遵守与你的诺言将我释放，说明他还残存了些许的荣辱感。"
                },
                {
                    "id": "120391427",
                    "speaker": "天目优也",
                    "text": "如果战斗之后就能解决这场混乱，那我愿意接受。"
                },
                {
                    "id": "120391428",
                    "speaker": "天目优也",
                    "text": "我不甘心只是成为一个受害者。"
                },
                {
                    "id": "120391429",
                    "speaker": "派蒙",
                    "text": "我们会向天领奉行说你是无辜的，你不用担心。"
                },
                {
                    "id": "120391430",
                    "speaker": "天目优也",
                    "text": "谢谢你们，要不是你们帮忙，这件事不知道该如何收场。"
                },
                {
                    "id": "120391431",
                    "speaker": "枫原万叶",
                    "text": "嗯，那就跟我走吧。"
                },
                {
                    "id": "120391432",
                    "speaker": "枫原万叶",
                    "text": "这里很可能还会有流浪武士杀过来，不宜久留。"
                },
                {
                    "id": "120391433",
                    "speaker": "枫原万叶",
                    "text": "况且我也觉得，最后的决斗应该要郑重一点。"
                }
            ]
        },
        {
            "id": "1203915",
            "objective": "实现妖刀的心愿",
            "dialogues": []
        },
        {
            "id": "1203916",
            "objective": "实现妖刀的心愿",
            "dialogues": [
                {
                    "id": "120391601",
                    "speaker": "派蒙",
                    "text": "有点「南十字武斗会」那时候的感觉了呢。"
                },
                {
                    "id": "120391602",
                    "speaker": "Player",
                    "text": "那时候要轻松得多。"
                },
                {
                    "id": "120391603",
                    "speaker": "派蒙",
                    "text": "嗯，就算现在也不能掉以轻心。总觉得那把刀还有什么话没有说…"
                },
                {
                    "id": "120391604",
                    "speaker": "派蒙",
                    "text": "算啦，虽然他罪无可恕，但也有可怜的地方嘛。"
                },
                {
                    "id": "120391605",
                    "speaker": "派蒙",
                    "text": "你们准备好了吗！"
                },
                {
                    "id": "120391606",
                    "speaker": "枫原万叶",
                    "text": "准备好了吗？"
                },
                {
                    "id": "120391607",
                    "speaker": "枫原万叶",
                    "text": "…嗯，我知道了。"
                },
                {
                    "id": "120391608",
                    "speaker": "枫原万叶",
                    "text": "「一心传」后继者，枫原万叶。"
                },
                {
                    "id": "120391609",
                    "speaker": "天目优也",
                    "text": "「天目流」后继者，天目优也。"
                },
                {
                    "id": "120391610",
                    "speaker": "枫原万叶",
                    "text": "请多指教。"
                },
                {
                    "id": "120391611",
                    "speaker": "天目优也",
                    "text": "请多指教。"
                }
            ]
        },
        {
            "id": "1203917",
            "objective": "与天目优也一较高下",
            "dialogues": []
        },
        {
            "id": "1203918",
            "objective": "与天目优也一较高下",
            "dialogues": [
                {
                    "id": "120391801",
                    "speaker": "天目优也",
                    "text": "…受教了。"
                },
                {
                    "id": "120391802",
                    "speaker": "天目优也",
                    "text": "虽然他看上去已经破损不堪，但在你的手上，他仿佛又恢复了一些光芒。"
                },
                {
                    "id": "120391803",
                    "speaker": "天目优也",
                    "text": "凶煞之感荡然无存，但那份执着丝毫未改。"
                },
                {
                    "id": "120391804",
                    "speaker": "枫原万叶",
                    "text": "你打得也很不错，我想他应该全情投入了。"
                },
                {
                    "id": "120391805",
                    "speaker": "枫原万叶",
                    "text": "还有一些话，由他来对你说吧。"
                },
                {
                    "id": "120391806",
                    "speaker": "「一心传」名刀",
                    "text": "之前发生的事，我必须向你表达我的歉意。"
                },
                {
                    "id": "120391807",
                    "speaker": "天目优也",
                    "text": "你不需要请求我的原谅，我也没有替所有受害者原谅你的资格。"
                },
                {
                    "id": "120391808",
                    "speaker": "天目优也",
                    "text": "这一切都太晚了。"
                },
                {
                    "id": "120391809",
                    "speaker": "「一心传」名刀",
                    "text": "我不奢求什么原谅，我只希望你们能将过错都归结在我的身上，不要连累「一心传」。"
                },
                {
                    "id": "120391810",
                    "speaker": "「一心传」名刀",
                    "text": "我走入了歧途，但「一心传」还有像枫原万叶这样，优秀的传承者。"
                },
                {
                    "id": "120391811",
                    "speaker": "「一心传」名刀",
                    "text": "请你…一定要理解。"
                },
                {
                    "id": "120391812",
                    "speaker": "天目优也",
                    "text": "嗯，我相信枫原万叶先生会妥善处理。"
                },
                {
                    "id": "120391813",
                    "speaker": "「一心传」名刀",
                    "text": "谢谢你，「天目流」的后人。"
                },
                {
                    "id": "120391814",
                    "speaker": "枫原万叶",
                    "text": "这把刀对我说，他还有另一个心愿，他想要去天目锻冶屋。"
                },
                {
                    "id": "120391815",
                    "speaker": "枫原万叶",
                    "text": "不如我们就一起回去吧。"
                },
                {
                    "id": "120391816",
                    "speaker": "派蒙",
                    "text": "他想去那里做什么？"
                },
                {
                    "id": "120391817",
                    "speaker": "枫原万叶",
                    "text": "我也不清楚，总之，应该马上就会结束了。"
                }
            ]
        },
        {
            "id": "1203902",
            "objective": "返回「天目锻冶屋」",
            "dialogues": [
                {
                    "id": "120390201",
                    "speaker": "一心传名刀",
                    "text": "……"
                }
            ]
        },
        {
            "id": "1203919",
            "objective": "返回「天目锻冶屋」",
            "dialogues": [
                {
                    "id": "120390301",
                    "speaker": "天目十五",
                    "text": "啊，是优也！你回来了！"
                },
                {
                    "id": "120390302",
                    "speaker": "天目优也",
                    "text": "抱歉，让您担心。多亏了他们，我才能顺利回来。"
                },
                {
                    "id": "120390303",
                    "speaker": "Black Screen",
                    "text": "你们将路上发生的事讲给了天目十五听。"
                },
                {
                    "id": "120390304",
                    "speaker": "天目十五",
                    "text": "「一心传」留下的名刀成为了能控制人类心灵的武器…"
                },
                {
                    "id": "120390305",
                    "speaker": "天目十五",
                    "text": "唉，从他们的锻刀理念上来说，确实有可能走到这一步，这可真是遗憾。"
                },
                {
                    "id": "120390306",
                    "speaker": "天目十五",
                    "text": "不过也有好消息，刚刚珊瑚侦探社的龙二告诉我，说失踪的长门已经找到了。"
                },
                {
                    "id": "120390307",
                    "speaker": "派蒙",
                    "text": "真的吗？他没事吗？"
                },
                {
                    "id": "120390308",
                    "speaker": "天目十五",
                    "text": "嗯，受了很重的伤，不过总算保住了一条命。"
                },
                {
                    "id": "120390309",
                    "speaker": "天目十五",
                    "text": "优也也回来了，看来这件事最后的结局还算圆满。"
                },
                {
                    "id": "120390310",
                    "speaker": "枫原万叶",
                    "text": "…我大概明白你想干什么了。"
                },
                {
                    "id": "120390311",
                    "speaker": "派蒙",
                    "text": "怎么了，万叶，刀又和你说悄悄话了吗？"
                },
                {
                    "id": "120390312",
                    "speaker": "枫原万叶",
                    "text": "嗯，他说，想要暂时控制我一段时间。"
                },
                {
                    "id": "120390313",
                    "speaker": "派蒙",
                    "text": "欸？不行不行，怎么又是这种要求？"
                },
                {
                    "id": "120390314",
                    "speaker": "枫原万叶",
                    "text": "他对我说，他想到了另一种实现锻刀人心愿的方式，并且还保证，不会利用我的身体去做坏事。"
                },
                {
                    "id": "120390315",
                    "speaker": "枫原万叶",
                    "text": "我决定…顺应他的想法。"
                },
                {
                    "id": "120390316",
                    "speaker": "派蒙",
                    "text": "这、这…唉，反正我说什么都没用对吧。",
                    "choices": [
                        {
                            "id": "120390317",
                            "text": "你来决定吧。",
                            "response": [
                                {
                                    "id": "120390319",
                                    "speaker": "枫原万叶",
                                    "text": "谢谢你，在这之后我会告诉你原因。"
                                },
                                {
                                    "id": "120390320",
                                    "speaker": "枫原万叶",
                                    "text": "好了，我准备好了。开始吧，请遵守你的诺言。"
                                }
                            ]
                        },
                        {
                            "id": "120390318",
                            "text": "这是你的判断。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203920",
            "objective": "与万叶交谈",
            "dialogues": []
        },
        {
            "id": "1203903",
            "objective": "与万叶交谈",
            "dialogues": [
                {
                    "id": "120391901",
                    "speaker": "Black Screen",
                    "text": "告别天目锻冶屋，从万叶那里得知了刀最后留下的话语。"
                },
                {
                    "id": "120391902",
                    "speaker": "派蒙",
                    "text": "原来「顺序」是这个意思…"
                },
                {
                    "id": "120391903",
                    "speaker": "派蒙",
                    "text": "实现了锻刀人的愿望之后，他的意识就会永远地消失。"
                },
                {
                    "id": "120391904",
                    "speaker": "枫原万叶",
                    "text": "「笼钓瓶一心」，这还是我第一次听到他的名字。"
                },
                {
                    "id": "120391905",
                    "speaker": "枫原万叶",
                    "text": "看来他内心深处也不认可自身的所作所为，所以一直把这个名字埋藏在心底。"
                },
                {
                    "id": "120391906",
                    "speaker": "枫原万叶",
                    "text": "在意识消散的最后一刻，他才愿意将此托付出去。"
                },
                {
                    "id": "120391907",
                    "speaker": "派蒙",
                    "text": "他是真的，想要完成锻刀人的愿望啊…"
                },
                {
                    "id": "120391908",
                    "speaker": "枫原万叶",
                    "text": "强烈的愿望是支撑他走下去的动机，但也正是因为过于执着的动机，而让他无法看清前路。"
                },
                {
                    "id": "120391909",
                    "speaker": "枫原万叶",
                    "text": "对我来说，比起惩戒罪人，更希望他能迷途知返。",
                    "choices": [
                        {
                            "id": "120391910",
                            "text": "但还是太冒险了。",
                            "response": [
                                {
                                    "id": "120391912",
                                    "speaker": "枫原万叶",
                                    "text": "我明白，或许这也是我性格中的弱点，我天生容易被强烈的愿望感召。"
                                },
                                {
                                    "id": "120391913",
                                    "speaker": "枫原万叶",
                                    "text": "听到他说想要迎接天光的时候是这样，看到人们想要废除「眼狩令」的时候也是这样…"
                                },
                                {
                                    "id": "120391914",
                                    "speaker": "枫原万叶",
                                    "text": "看到你坚定地想要面见诸神，寻找血亲的时候也是如此。"
                                },
                                {
                                    "id": "120391915",
                                    "speaker": "枫原万叶",
                                    "text": "见证了这么多，不知不觉就有些着迷了。"
                                },
                                {
                                    "id": "120391916",
                                    "speaker": "派蒙",
                                    "text": "万叶…"
                                },
                                {
                                    "id": "120391917",
                                    "speaker": "枫原万叶",
                                    "text": "从今以后我也会一直支持你们，只要你们需要我，我就一定会帮忙。",
                                    "choices": [
                                        {
                                            "id": "120391918",
                                            "text": "谢谢你。",
                                            "response": [
                                                {
                                                    "id": "120391920",
                                                    "speaker": "派蒙",
                                                    "text": "对了，是不是还要去和九条镰治说一声？"
                                                },
                                                {
                                                    "id": "120391921",
                                                    "speaker": "枫原万叶",
                                                    "text": "哦，没错，要通知他事情有了结果。"
                                                },
                                                {
                                                    "id": "120391922",
                                                    "speaker": "枫原万叶",
                                                    "text": "正好，关于我的事，也需要给他一个答复。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120391919",
                                            "text": "那一言为定了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120391911",
                            "text": "魔神残渣不是说着玩的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203904",
            "objective": "陪同万叶答复九条镰治",
            "dialogues": [
                {
                    "id": "120390401",
                    "speaker": "九条镰治",
                    "text": "是你们啊！我听说事件解决了，虽然过程十分危险，但最后没有人遇害，真是太好了。"
                },
                {
                    "id": "120390402",
                    "speaker": "九条镰治",
                    "text": "天领奉行众已经处理了那个危险的仓库，关于天目优也的调查也会在近期有结果，他应该不会被追责。"
                },
                {
                    "id": "120390403",
                    "speaker": "派蒙",
                    "text": "你的消息也挺灵通的嘛，嘿嘿。"
                },
                {
                    "id": "120390404",
                    "speaker": "枫原万叶",
                    "text": "那就不在事件上过多赘述了。之前的问题，我想给你一个答复。总之请你看这把刀吧。"
                },
                {
                    "id": "120390405",
                    "speaker": "九条镰治",
                    "text": "这是…？"
                },
                {
                    "id": "120390406",
                    "speaker": "枫原万叶",
                    "text": "「笼钓瓶一心」，是已经失传的枫原家锻刀术锻造出的武器。"
                },
                {
                    "id": "120390407",
                    "speaker": "枫原万叶",
                    "text": "机缘巧合之后，我回收并修好了他，并且我也与他约定，要将「一心传」继续传承下去。"
                },
                {
                    "id": "120390408",
                    "speaker": "枫原万叶",
                    "text": "所以接下来，我应该会继续四处游历，研究这把刀。"
                },
                {
                    "id": "120390409",
                    "speaker": "九条镰治",
                    "text": "这样啊…我明白了。"
                },
                {
                    "id": "120390410",
                    "speaker": "枫原万叶",
                    "text": "枫原家一直都是锻刀世家，今后也理应专注于此。"
                },
                {
                    "id": "120390411",
                    "speaker": "枫原万叶",
                    "text": "如果我接受了来自您的好意，可能还会陷入幕府与珊瑚宫的矛盾漩涡之中，这并不适合我。"
                },
                {
                    "id": "120390412",
                    "speaker": "九条镰治",
                    "text": "啊，你误会了，绝不是出于此番考虑…"
                },
                {
                    "id": "120390413",
                    "speaker": "枫原万叶",
                    "text": "我知道，但我只是想继续做我想做的事。"
                },
                {
                    "id": "120390414",
                    "speaker": "九条镰治",
                    "text": "好吧，我理解了，那这次邀请就当我没提过。"
                },
                {
                    "id": "120390415",
                    "speaker": "九条镰治",
                    "text": "不过，若是你改变了主意，或者之后需要幕府方面的帮助，请你随时和我讲。"
                },
                {
                    "id": "120390416",
                    "speaker": "枫原万叶",
                    "text": "嗯，感谢你的好意。"
                },
                {
                    "id": "120390417",
                    "speaker": "派蒙",
                    "text": "接下来你要去哪里旅行呢，万叶？"
                },
                {
                    "id": "120390418",
                    "speaker": "枫原万叶",
                    "text": "唔，暂且还是跟着大姐头在海上航行吧。"
                },
                {
                    "id": "120390419",
                    "speaker": "枫原万叶",
                    "text": "至于下一个目的地…"
                },
                {
                    "id": "120390420",
                    "speaker": "枫原万叶",
                    "text": "就看风往什么方向吹了。"
                }
            ]
        },
        {
            "id": "1203927",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120392701",
                    "speaker": "九条镰治",
                    "text": "长门先生还活着，算是不幸中的万幸了。"
                },
                {
                    "id": "120392702",
                    "speaker": "九条镰治",
                    "text": "他的身体状况我们会继续关注，希望他能早日康复。"
