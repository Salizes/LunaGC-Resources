            "dialogues": [
                {
                    "id": "120360101",
                    "speaker": "托马",
                    "text": "其实我想说，这盘棋不用继续了吧…我已经没什么翻盘的希望了。"
                },
                {
                    "id": "120360102",
                    "speaker": "神里绫人",
                    "text": "呵呵，几天时间过去，我也难免忘记一些细节。你不想趁机赢一次吗？"
                },
                {
                    "id": "120360103",
                    "speaker": "托马",
                    "text": "既然您这么说，嗯，我再试试看！"
                }
            ]
        },
        {
            "id": "1203602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120360201",
                    "speaker": "幕府通告",
                    "text": "此前通告九条镰治大人与柊千里大人成婚一事，乃勘定奉行内部的沟通失误。由此引起一系列混乱与误解，实在抱歉。"
                },
                {
                    "id": "120360202",
                    "speaker": "幕府通告",
                    "text": "涉事人员已被严肃问责，幕府内部也会再次强调交流与纪律的重要性。"
                },
                {
                    "id": "120360203",
                    "speaker": "幕府通告",
                    "text": "两位大人的婚事由此推后，具体安排请等待进一步通告。"
                }
            ]
        }
    ]
