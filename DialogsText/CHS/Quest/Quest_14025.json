    "talks": [
        {
            "id": "1402501",
            "objective": "继续执行作战方案",
            "dialogues": [
                {
                    "id": "140250102",
                    "speaker": "林尼",
                    "text": "人齐了，今天也按照计划行动。",
                    "choices": [
                        {
                            "id": "140250103",
                            "text": "稍等一下。",
                            "response": [
                                {
                                    "id": "140250105",
                                    "speaker": "菲米尼",
                                    "text": "什么？"
                                },
                                {
                                    "id": "140250106",
                                    "speaker": "Player",
                                    "text": "「仆人」跟「博士」合作过吗？"
                                },
                                {
                                    "id": "140250107",
                                    "speaker": "林尼",
                                    "text": "为什么这么问？"
                                },
                                {
                                    "id": "140250108",
                                    "speaker": "派蒙",
                                    "text": "其实，我们昨天晚上见到了克雷薇，这是她告诉我们的。"
                                },
                                {
                                    "id": "140250109",
                                    "speaker": "派蒙",
                                    "text": "我们在须弥见过「博士」。他不但很危险，而且做过很多坏事！"
                                },
                                {
                                    "id": "140250110",
                                    "speaker": "林尼",
                                    "text": "…我不敢保证「父亲」与「博士」没有来往，但我认为「父亲」不会跟他合作。"
                                },
                                {
                                    "id": "140250111",
                                    "speaker": "林尼",
                                    "text": "我们并非同一派系，相互也不信任，没有合作的基础。"
                                },
                                {
                                    "id": "140250112",
                                    "speaker": "林尼",
                                    "text": "不过，我听说「父亲」刚刚成为执行官的时候，「博士」确实有提过想要跟壁炉之家合作。"
                                },
                                {
                                    "id": "140250113",
                                    "speaker": "林尼",
                                    "text": "「父亲」拒绝了大部分提案，只保留了一个秘密实验。"
                                },
                                {
                                    "id": "140250114",
                                    "speaker": "派蒙",
                                    "text": "秘密实验？克雷薇说的该不会就是这个吧？"
                                },
                                {
                                    "id": "140250115",
                                    "speaker": "琳妮特",
                                    "text": "应该不是。"
                                },
                                {
                                    "id": "140250116",
                                    "speaker": "林尼",
                                    "text": "我不知道那个秘密实验是什么，但它是壁炉之家独立完成的，「博士」只提供了研究方向，算不上是合作。"
                                },
                                {
                                    "id": "140250117",
                                    "speaker": "林尼",
                                    "text": "而且只是实验内容保密而已，参与实验的人都有完整记录，跟克雷薇说的情况也对不上。"
                                },
                                {
                                    "id": "140250118",
                                    "speaker": "林尼",
                                    "text": "请相信我们。壁炉之家隶属于愚人众，难免会做一些你们无法接受的事情。但我们有自己的规矩，有自己的底线。"
                                },
                                {
                                    "id": "140250119",
                                    "speaker": "派蒙",
                                    "text": "呼。那我们就放心了。"
                                },
                                {
                                    "id": "140250120",
                                    "speaker": "派蒙",
                                    "text": "说实话，如果「仆人」真的和「博士」合作过，做了一些很过分的事情，我也不知道该怎么面对你们了。"
                                },
                                {
                                    "id": "140250121",
                                    "speaker": "派蒙",
                                    "text": "可是，难道克雷薇在说谎吗？总觉得也不太像…"
                                },
                                {
                                    "id": "140250122",
                                    "speaker": "派蒙",
                                    "text": "要是能直接问问「仆人」就好了，但她应该不会轻易告诉我们的吧。"
                                },
                                {
                                    "id": "140250123",
                                    "speaker": "Player",
                                    "text": "先开始今天的计划吧。"
                                },
                                {
                                    "id": "140250124",
                                    "speaker": "林尼",
                                    "text": "「父亲」昨天没有回来，应该还在海岸附近，拜托你们了。"
                                },
                                {
                                    "id": "140250125",
                                    "speaker": "林尼",
                                    "text": "琳妮特，你跟我走。菲米尼，你也要小心。"
                                },
                                {
                                    "id": "140250126",
                                    "speaker": "林尼",
                                    "text": "开始行动。"
                                }
                            ]
                        },
                        {
                            "id": "140250104",
                            "text": "我有个问题。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402502",
            "objective": "去附近的海边寻找「仆人」",
            "dialogues": [
                {
                    "id": "140250201",
                    "speaker": "「仆人」",
                    "text": "又见面了。看你们一脸憔悴，昨晚没休息好？"
                },
                {
                    "id": "140250202",
                    "speaker": "派蒙",
                    "text": "是有一点。"
                },
                {
                    "id": "140250203",
                    "speaker": "「仆人」",
                    "text": "少一点心事，说不定可以睡个好觉。"
                },
                {
                    "id": "140250204",
                    "speaker": "「仆人」",
                    "text": "接下来想做什么，睡个回笼觉，还是绞尽脑汁想些新的话题？"
                },
                {
                    "id": "140250205",
                    "speaker": "「仆人」",
                    "text": "我确实有点好奇，今天「公子」不在，你们要找什么理由把我留在这里呢？"
                },
                {
                    "id": "140250206",
                    "speaker": "Player",
                    "text": "（！！！）"
                },
                {
                    "id": "140250207",
                    "speaker": "派蒙",
                    "text": "你，你在说什么呀，我们只是来随便聊聊天！"
                },
                {
                    "id": "140250208",
                    "speaker": "「仆人」",
                    "text": "没想好的话，陪我去个地方如何？"
                },
                {
                    "id": "140250209",
                    "speaker": "「仆人」",
                    "text": "别紧张，我们会绕开那些鬼鬼祟祟的小家伙。"
                },
                {
                    "id": "140250210",
                    "speaker": "派蒙",
                    "text": "啊…今天的海风好舒服呀…"
                },
                {
                    "id": "140250211",
                    "speaker": "Player",
                    "text": "你都知道了？"
                },
                {
                    "id": "140250212",
                    "speaker": "「仆人」",
                    "text": "孩子们总是自认为能骗过大人的眼睛，可那些小算盘我看得一清二楚。让他们多折腾一段时间吧，我有足够的耐心。"
                },
                {
                    "id": "140250213",
                    "speaker": "「仆人」",
                    "text": "我先走了，想清楚就跟上来，我们在沫芒宫门口见面。"
                },
                {
                    "id": "140250214",
                    "speaker": "「仆人」",
                    "text": "乖乖听话，或许他们还有一线生机。"
                },
                {
                    "id": "140250215",
                    "speaker": "派蒙",
                    "text": "怎、怎么办啊！！！"
                },
                {
                    "id": "140250216",
                    "speaker": "派蒙",
                    "text": "她刚刚的语气，很明显是知道我们做的事了吧？而且她摆明了是在要挟我们。"
                },
                {
                    "id": "140250217",
                    "speaker": "Player",
                    "text": "先放飞林尼给我们的魔术鸽子。"
                },
                {
                    "id": "140250218",
                    "speaker": "派蒙",
                    "text": "嗯，希望林尼能及时收到我们的预警…"
                },
                {
                    "id": "140250219",
                    "speaker": "派蒙",
                    "text": "接下来，我们还是要去一趟沫芒宫吧。她都这么说了，感觉不去的后果很严重。",
                    "choices": [
                        {
                            "id": "140250220",
                            "text": "也没什么更好的办法了。",
                            "response": [
                                {
                                    "id": "140250222",
                                    "speaker": "派蒙",
                                    "text": "那我们快跟上去。如果她等急了，直接去找林尼，那就糟糕了！"
                                }
                            ]
                        },
                        {
                            "id": "140250221",
                            "text": "走一步看一步吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402503",
            "objective": "跟随「仆人」前往枫丹廷",
            "dialogues": [
                {
                    "id": "140250301",
                    "speaker": "「仆人」",
                    "text": "离接下来的谈判还有点时间，我们就在这聊聊吧。"
                },
                {
                    "id": "140250302",
                    "speaker": "「仆人」",
                    "text": "很高兴见到你们和我家的孩子相处融洽。孩子想要成长，良好的人际关系是必不可少的。"
                },
                {
                    "id": "140250303",
                    "speaker": "派蒙",
                    "text": "「仆人」…你会怎么处置他们？"
                },
                {
                    "id": "140250304",
                    "speaker": "「仆人」",
                    "text": "林尼、琳妮特、菲米尼…"
                },
                {
                    "id": "140250305",
                    "speaker": "「仆人」",
                    "text": "还有菲约尔、南特伊…人还真不少。"
                },
                {
                    "id": "140250306",
                    "speaker": "「仆人」",
                    "text": "我向来对背叛者一视同仁，没有任何特例。"
                },
                {
                    "id": "140250307",
                    "speaker": "派蒙",
                    "text": "你…你会「杀死」他们吗？"
                },
                {
                    "id": "140250308",
                    "speaker": "「仆人」",
                    "text": "想为他们求情吗？很遗憾，没有人能改变家的规矩。在这里，所有人都要为自己的言行举止负责。"
                },
                {
                    "id": "140250309",
                    "speaker": "派蒙",
                    "text": "你、你对他们没有任何感情吗？他们一直叫你「父亲」，而且发自内心地尊敬你！"
                },
                {
                    "id": "140250310",
                    "speaker": "「仆人」",
                    "text": "任何一个组织，若是人情大于规矩，就会迅速走向衰败。更何况是以严格著称的壁炉之家呢？"
                },
                {
                    "id": "140250311",
                    "speaker": "「仆人」",
                    "text": "唯一能安慰你们的是：作为客人，你们并不在清算范围之内。"
                },
                {
                    "id": "140250312",
                    "speaker": "Player",
                    "text": "没有别的解决办法吗？"
                },
                {
                    "id": "140250313",
                    "speaker": "「仆人」",
                    "text": "林尼他们大概能保住性命。"
                },
                {
                    "id": "140250314",
                    "speaker": "「仆人」",
                    "text": "菲约尔、南特伊为首的这些人，再加上克雷薇…他们想要叛逃，那就没有商量的余地了，没有人能带着秘密活着离开。"
                },
                {
                    "id": "140250315",
                    "speaker": "派蒙",
                    "text": "这…未免太残酷了…"
                },
                {
                    "id": "140250316",
                    "speaker": "「仆人」",
                    "text": "这样如何，看在客人的份上，我再多等一段时间。"
                },
                {
                    "id": "140250317",
                    "speaker": "「仆人」",
                    "text": "如果在这期间，林尼他们成功让克雷薇消失，那就销毁了证据，我不会再追究他们的过错。"
                },
                {
                    "id": "140250318",
                    "speaker": "「仆人」",
                    "text": "否则，我会抓住正在干坏事的他们，让所有人受到严酷的惩罚。",
                    "choices": [
                        {
                            "id": "140250319",
                            "text": "一言为定。",
                            "response": [
                                {
                                    "id": "140250321",
                                    "speaker": "「仆人」",
                                    "text": "放心。还有，这个你们收好，不要再搞丢了。"
                                },
                                {
                                    "id": "140250322",
                                    "speaker": "「仆人」",
                                    "text": "训练一只魔术飞鸟要花不少时间，死了有些可惜。"
                                },
                                {
                                    "id": "140250323",
                                    "speaker": "派蒙",
                                    "text": "你、你从哪抓到的——"
                                },
                                {
                                    "id": "140250324",
                                    "speaker": "「仆人」",
                                    "text": "好了。闲聊到此结束，该做正事了。"
                                },
                                {
                                    "id": "140250325",
                                    "speaker": "「仆人」",
                                    "text": "之所以约你们在这里见面，是因为我要去沫芒宫谈一件事情。跟你们无关，但请你们跟在我身边，不要想回去通风报信。"
                                },
                                {
                                    "id": "140250326",
                                    "speaker": "「仆人」",
                                    "text": "走吧。时间刚刚好。"
                                }
                            ]
                        },
                        {
                            "id": "140250320",
                            "text": "不许反悔。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402504",
            "objective": "陪同「仆人」完成谈判",
            "dialogues": [
                {
                    "id": "140250401",
                    "speaker": "「仆人」",
                    "text": "许久不见，那维莱特先生。"
                },
                {
                    "id": "140250402",
                    "speaker": "「仆人」",
                    "text": "没想到我的会见申请这么快就能被批准，沫芒宫的效率真是让人由衷赞叹。"
                },
                {
                    "id": "140250403",
                    "speaker": "那维莱特",
                    "text": "对一位声名在外的外交官，这是必要的尊重。"
                },
                {
                    "id": "140250404",
                    "speaker": "那维莱特",
                    "text": "但客观来说，我原以为「赠予神之心」会是我们最后一次见面。"
                },
                {
                    "id": "140250405",
                    "speaker": "那维莱特",
                    "text": "#…这次还带上了{NICKNAME}和派蒙，到底所为何事？"
                },
                {
                    "id": "140250406",
                    "speaker": "「仆人」",
                    "text": "我很快就要离开枫丹了，临走之前，还有一件放心不下的事情。"
                },
                {
                    "id": "140250407",
                    "speaker": "「仆人」",
                    "text": "几句话未必能说清楚，我写好了一份提案，请那维莱特先生过目。"
                },
                {
                    "id": "140250408",
                    "speaker": "Black Screen",
                    "text": "仆人递出一份文件，之后优雅地端起杯子，品尝着杯中的水。"
                },
                {
                    "id": "140250409",
                    "speaker": "那维莱特",
                    "text": "我明白你的请求了。恕我直言，我无法理解你这么做的原因。"
                },
                {
                    "id": "140250410",
                    "speaker": "「仆人」",
                    "text": "听闻那维莱特先生有品水的爱好，我就用水来做比喻吧。"
                },
                {
                    "id": "140250411",
                    "speaker": "「仆人」",
                    "text": "家就像一个巨大的湖泊，无数条河流汇聚而入，无数条河流奔涌而出。"
                },
                {
                    "id": "140250412",
                    "speaker": "「仆人」",
                    "text": "作为一个每天注视着湖泊的人，我希望每一条流出的河都能抵达大海。"
                },
                {
                    "id": "140250413",
                    "speaker": "「仆人」",
                    "text": "然而客观事实告诉我这是不可能的。绝大部分河流都会在半路干涸，渗入泥土中，再无声息。"
                },
                {
                    "id": "140250414",
                    "speaker": "「仆人」",
                    "text": "我想给那些「看不见海的水」，找一些存在的意义。比如灌溉两岸的田地，或是成为某个人杯中的甘泉。"
                },
                {
                    "id": "140250415",
                    "speaker": "派蒙",
                    "text": "喂，你听懂了吗？",
                    "choices": [
                        {
                            "id": "140250416",
                            "text": "不是很懂…",
                            "response": [
                                {
                                    "id": "140250418",
                                    "speaker": "那维莱特",
                                    "text": "我有必要提醒你，无论你如何美化它们，都没有人想要品尝「浑浊的水」。"
                                },
                                {
                                    "id": "140250419",
                                    "speaker": "「仆人」",
                                    "text": "是「曾经浑浊的水」。别担心，我会滤净水中的泥沙，让它们回到最纯净的样子。"
                                },
                                {
                                    "id": "140250420",
                                    "speaker": "那维莱特",
                                    "text": "……"
                                },
                                {
                                    "id": "140250421",
                                    "speaker": "那维莱特",
                                    "text": "既然你提到这是「交易」，那我们聊一聊细节吧。"
                                },
                                {
                                    "id": "140250422",
                                    "speaker": "「仆人」",
                                    "text": "如果那维莱特先生同意我的提案，我的势力会逐渐撤出枫丹。"
                                },
                                {
                                    "id": "140250423",
                                    "speaker": "「仆人」",
                                    "text": "今后非必要情况，我们不会在枫丹执行「特殊任务」。"
                                },
                                {
                                    "id": "140250424",
                                    "speaker": "那维莱特",
                                    "text": "你的意思是，今后不会发生「达尔杜弗遇刺」这种事情？"
                                },
                                {
                                    "id": "140250425",
                                    "speaker": "「仆人」",
                                    "text": "你说那个贪污善款的伪君子？我对他的遇害表示沉痛的悼念，不过目前好像并没有证据指向壁炉之家。"
                                },
                                {
                                    "id": "140250426",
                                    "speaker": "「仆人」",
                                    "text": "当然，如果那维莱特先生答应我的提案，我可以帮忙做一些事情，让类似的麻烦少一些。"
                                },
                                {
                                    "id": "140250427",
                                    "speaker": "那维莱特",
                                    "text": "真是滴水不漏的发言。好吧，我原则上同意你的提案。"
                                },
                                {
                                    "id": "140250428",
                                    "speaker": "「仆人」",
                                    "text": "感谢您的宽宏，那维莱特先生。"
                                },
                                {
                                    "id": "140250429",
                                    "speaker": "「仆人」",
                                    "text": "交易达成，我们也该告退了。我托人带了两瓶来自至冬的泉水，希望下次有机会听听您的感想。"
                                },
                                {
                                    "id": "140250430",
                                    "speaker": "那维莱特",
                                    "text": "下次再会。记得你的承诺。"
                                },
                                {
                                    "id": "140250431",
                                    "speaker": "「仆人」",
                                    "text": "#好了，{NICKNAME}、派蒙，我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "140250417",
                            "text": "半懂不懂…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402505",
            "objective": "离开沫芒宫",
            "dialogues": [
                {
                    "id": "140250501",
                    "speaker": "派蒙",
                    "text": "「仆人」，刚刚你和那维莱特在谈些什么呀？"
                },
                {
                    "id": "140250502",
                    "speaker": "派蒙",
                    "text": "又是湖泊又是河流的，难道说…你们在讨论什么跟水有关的工程吗？"
                },
                {
                    "id": "140250503",
                    "speaker": "「仆人」",
                    "text": "两位很好奇吗？现在似乎并不是关心这个的时候。"
                },
                {
                    "id": "140250504",
                    "speaker": "派蒙",
                    "text": "也是…不知道林尼那边怎么样了…"
                },
                {
                    "id": "140250505",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你在想办法吗？加油啊！"
                },
                {
                    "id": "140250506",
                    "speaker": "Player",
                    "text": "（「仆人」看起来很轻松，但她身上的杀意不是装出来的。她似乎真的想杀死那些涉嫌「背叛」的孩子们。）"
                },
                {
                    "id": "140250507",
                    "speaker": "Player",
                    "text": "（该怎么做才能阻止她？不，在那之前，还有另一个问题。）"
                },
                {
                    "id": "140250508",
                    "speaker": "Player",
                    "text": "（在沫芒宫门口，她提到了克雷薇的名字。这是否意味着她早就掌握了克雷薇的行踪？林尼他们的行动在「仆人」的预料内吗？）"
                },
                {
                    "id": "140250509",
                    "speaker": "？？？",
                    "text": "哇——"
                },
                {
                    "id": "140250510",
                    "speaker": "？？？",
                    "text": "疼疼…等下，你没事吧？"
                },
                {
                    "id": "140250511",
                    "speaker": "？？？",
                    "text": "都怪我，光想着卖报的事情，没看前面的路。",
                    "choices": [
                        {
                            "id": "140250512",
                            "text": "抱歉。",
                            "response": [
                                {
                                    "id": "140250514",
                                    "speaker": "？？？",
                                    "text": "啊，作为补偿，这份报纸你们收下吧。"
                                },
                                {
                                    "id": "140250515",
                                    "speaker": "Player",
                                    "text": "（这个人…总觉得有点眼熟？）"
                                },
                                {
                                    "id": "140250516",
                                    "speaker": "派蒙",
                                    "text": "不用啦，这多不好意思。"
                                },
                                {
                                    "id": "140250517",
                                    "speaker": "卖报青年",
                                    "text": "没事没事，反正我手上还有不少。报纸这东西，拖到明天送都送不出去。"
                                },
                                {
                                    "id": "140250518",
                                    "speaker": "卖报青年",
                                    "text": "都怪我，想着多赚点钱补贴家用，一口气进了太多货。结果今天看报纸的人少，现在还没卖完呢。"
                                },
                                {
                                    "id": "140250519",
                                    "speaker": "「仆人」",
                                    "text": "在聊什么？"
                                },
                                {
                                    "id": "140250520",
                                    "speaker": "卖报青年",
                                    "text": "没事没事，刚刚不小心撞到了这位朋友，我现在就走。"
                                },
                                {
                                    "id": "140250521",
                                    "speaker": "「仆人」",
                                    "text": "等一下。"
                                },
                                {
                                    "id": "140250522",
                                    "speaker": "卖报青年",
                                    "text": "这个…如果索要赔偿的话，我没有现钱…"
                                },
                                {
                                    "id": "140250523",
                                    "speaker": "「仆人」",
                                    "text": "拿三份报纸，这是摩拉。"
                                },
                                {
                                    "id": "140250524",
                                    "speaker": "卖报青年",
                                    "text": "啊？谢谢惠顾，神明保佑您发大财！"
                                },
                                {
                                    "id": "140250525",
                                    "speaker": "卖报青年",
                                    "text": "要是每天都能遇到像您这样慷慨的人就好了…开玩笑的，明天我还是少进点报纸，不能因为快结婚了就心急。再见各位！"
                                },
                                {
                                    "id": "140250526",
                                    "speaker": "「仆人」",
                                    "text": "事情办完了，坐船回白淞镇吧，路上还可以看报纸打发时间。"
                                },
                                {
                                    "id": "140250527",
                                    "speaker": "派蒙",
                                    "text": "等、等一下…再逛一会儿怎么样？"
                                },
                                {
                                    "id": "140250528",
                                    "speaker": "派蒙",
                                    "text": "对了，我肚子饿了——必须要吃饱了才能回去！"
                                },
                                {
                                    "id": "140250529",
                                    "speaker": "Player",
                                    "text": "（派蒙在努力寻找不回去的理由。时间还早，林尼那边几乎不可能有什么进展。现在该怎么办…）"
                                },
                                {
                                    "id": "140250530",
                                    "speaker": "「仆人」",
                                    "text": "看来你们似乎还怀有一些美好的幻想，认为再拖一段时间，情况或许会出现转机。在我看来这种挣扎毫无意义。"
                                },
                                {
                                    "id": "140250531",
                                    "speaker": "「仆人」",
                                    "text": "不过，如果你们愿意答应我一个条件，我可以再多给林尼一点时间。"
                                },
                                {
                                    "id": "140250532",
                                    "speaker": "「仆人」",
                                    "text": "另外，我也会解答你们心里的疑惑。比如克雷薇到底是谁，跟我是什么关系…"
                                },
                                {
                                    "id": "140250533",
                                    "speaker": "派蒙",
                                    "text": "你、你怎么突然这么大方了，不会是要我们做什么坏事吧？"
                                },
                                {
                                    "id": "140250534",
                                    "speaker": "「仆人」",
                                    "text": "不要太高估自己，你们并没有做坏事的天分。"
                                },
                                {
                                    "id": "140250535",
                                    "speaker": "派蒙",
                                    "text": "唔。那你为什么…"
                                },
                                {
                                    "id": "140250536",
                                    "speaker": "「仆人」",
                                    "text": "交涉最重要的是利益互换，一味地索取或威胁得不到想要的结果。"
                                },
                                {
                                    "id": "140250537",
                                    "speaker": "Player",
                                    "text": "我们可以听听你的条件。"
                                },
                                {
                                    "id": "140250538",
                                    "speaker": "「仆人」",
                                    "text": "很好。我的条件是——"
                                },
                                {
                                    "id": "140250539",
                                    "speaker": "「仆人」",
                                    "text": "「在必要的时候，做出你们认为最合适的选择，帮一次壁炉之家。」"
                                },
                                {
                                    "id": "140250540",
                                    "speaker": "派蒙",
                                    "text": "奇怪，怎么感觉很正常…不过「必要的时候」，指的是什么？"
                                },
                                {
                                    "id": "140250541",
                                    "speaker": "「仆人」",
                                    "text": "这个就交给你们判断了。"
                                },
                                {
                                    "id": "140250542",
                                    "speaker": "Player",
                                    "text": "可以答应你。"
                                },
                                {
                                    "id": "140250543",
                                    "speaker": "「仆人」",
                                    "text": "交涉成立。跟我来。"
                                }
                            ]
                        },
                        {
                            "id": "140250513",
                            "text": "我也没注意。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1402507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140250701",
                    "speaker": "克雷薇",
                    "text": "下雨了，得去把衣服收起来…"
                }
            ]
        },
        {
            "id": "1402508",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140250801",
                    "speaker": "琳妮特",
                    "text": "今天要去哪里？"
                },
                {
                    "id": "140250802",
                    "speaker": "林尼",
                    "text": "到远一些的地方试试吧。"
                }
            ]
        },
        {
            "id": "1402510",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140251001",
                    "speaker": "那维莱特",
                    "text": "之前提到过，我可以轻易地和他人的情感产生共鸣。"
                },
                {
                    "id": "140251002",
                    "speaker": "那维莱特",
                    "text": "然而在几次见面中，我几乎无法从这位执行官的身上感受到任何东西。她的内心就像平静的湖水，幽暗深邃，没有任何涟漪。"
                },
                {
                    "id": "140251003",
                    "speaker": "那维莱特",
                    "text": "我不清楚她是天生如此，还是已经能靠自我意志来掌控情感。无论是哪一种，都意味着她很危险。"
                },
                {
                    "id": "140251004",
                    "speaker": "那维莱特",
                    "text": "我不会过问你们跟随她行动的原因。但请你们务必要注意安全。"
                }
            ]
        }
    ]
}