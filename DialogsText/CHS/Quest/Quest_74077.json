    "talks": [
        {
            "id": "7407701",
            "objective": "解开此层的谜题",
            "dialogues": [
                {
                    "id": "740770101",
                    "speaker": "卡特皮拉",
                    "text": "我估计了一下塔的高度，也快到底层了。继续往下可能就要面对纳齐森科鲁兹了。"
                },
                {
                    "id": "740770102",
                    "speaker": "卡特皮拉",
                    "text": "世界也要迎来它自己的答案了。究竟是毁灭还是得救，亦或者以纳齐森科鲁兹的方式得救。"
                },
                {
                    "id": "740770103",
                    "speaker": "派蒙",
                    "text": "我才不要用他们设想的形式躲过大灾难呢！"
                },
                {
                    "id": "740770104",
                    "speaker": "派蒙",
                    "text": "#一定要走的话，我觉得让{NICKNAME}带我跑出提瓦特都更好。"
                },
                {
                    "id": "740770105",
                    "speaker": "Player",
                    "text": "要救所有人。"
                },
                {
                    "id": "740770106",
                    "speaker": "派蒙",
                    "text": "哎呀，我也不是说要对大家见死不救嘛！"
                },
                {
                    "id": "740770107",
                    "speaker": "卡特皮拉",
                    "text": "这里似乎没有什么谜题，也没有什么追兵了。不如在这里休整一下吧。"
                },
                {
                    "id": "740770108",
                    "speaker": "Player",
                    "text": "嗯，做好准备吧。"
                },
                {
                    "id": "740770109",
                    "speaker": "西摩尔",
                    "text": "各位，这扇去往下层的门似乎上锁了。"
                },
                {
                    "id": "740770110",
                    "speaker": "西摩尔",
                    "text": "需要我引擎超转加足马力进行暴力破门吗？"
                },
                {
                    "id": "740770111",
                    "speaker": "卡特皮拉",
                    "text": "不必了吧。本来我们就决定在这里休整一下，现在我们都稍微留点心，找找看钥匙就好。"
                },
                {
                    "id": "740770112",
                    "speaker": "卡特皮拉",
                    "text": "如果最后发现这是扇没有钥匙的门，我亲自把它劈开。"
                }
            ]
        },
        {
            "id": "7407702",
            "objective": "前往下层",
            "dialogues": [
                {
                    "id": "740770201",
                    "speaker": "卡特皮拉",
                    "text": "这些东西，阵仗怪吓人的…"
                },
                {
                    "id": "740770202",
                    "speaker": "派蒙",
                    "text": "卡特皮拉又变回来了！"
                },
                {
                    "id": "740770203",
                    "speaker": "卡特皮拉",
                    "text": "毕竟要做好战斗的准备。你看。"
                },
                {
                    "id": "740770204",
                    "speaker": "卡特皮拉",
                    "text": "这些是查封这座塔的时候，留下的安保设施。"
                },
                {
                    "id": "740770205",
                    "speaker": "卡特皮拉",
                    "text": "我们一旦试图前往最底层，恐怕就会触发它们的唤醒流程。"
                },
                {
                    "id": "740770206",
                    "speaker": "西摩尔",
                    "text": "你的猜测没错。刚才已经检验过了，这批发条机关仍有唤醒启动可能。"
                },
                {
                    "id": "740770207",
                    "speaker": "西摩尔",
                    "text": "换句话说，也有唤不醒的可能。"
                },
                {
                    "id": "740770208",
                    "speaker": "派蒙",
                    "text": "这么多年它们就都在这里吗？"
                },
                {
                    "id": "740770209",
                    "speaker": "卡特皮拉",
                    "text": "这么多年，水仙十字圣剑才第一次被修复啊。"
                },
                {
                    "id": "740770210",
                    "speaker": "卡特皮拉",
                    "text": "如果当年的设计无误，解除最终封印的钥匙就是圣剑本身了。"
                },
                {
                    "id": "740770211",
                    "speaker": "卡特皮拉",
                    "text": "准备好了的话，就动手吧。"
                }
            ]
        },
        {
            "id": "7407703",
            "objective": "前往下层",
            "dialogues": [
                {
                    "id": "740770301",
                    "speaker": "派蒙",
                    "text": "呜哇，感觉地板在动…"
                },
                {
                    "id": "740770302",
                    "speaker": "卡特皮拉",
                    "text": "这就是结束的开始了。"
                }
            ]
        },
        {
            "id": "7407707",
            "objective": "解开此层的谜题",
            "dialogues": [
                {
                    "id": "740770701",
                    "speaker": "卡特皮拉",
                    "text": "这里也有一些藏书和纳齐森科鲁兹的笔记。虽然很有趣，但是也全都是没有结局的东西。"
                },
                {
                    "id": "740770702",
                    "speaker": "Player",
                    "text": "卡特皮拉，我有个问题。"
                },
                {
                    "id": "740770703",
                    "speaker": "卡特皮拉",
                    "text": "请说吧。"
                },
                {
                    "id": "740770704",
                    "speaker": "Player",
                    "text": "结社的人明明很讨厌发条机关…"
                },
                {
                    "id": "740770705",
                    "speaker": "Player",
                    "text": "…这座塔为什么这么多齿轮。"
                },
                {
                    "id": "740770706",
                    "speaker": "卡特皮拉",
                    "text": "这个问题确实很有意思，但我只能说说我的推论。"
                },
                {
                    "id": "740770707",
                    "speaker": "卡特皮拉",
                    "text": "在我看来，这里的主题不是齿轮，而是钟。"
                },
                {
                    "id": "740770708",
                    "speaker": "卡特皮拉",
                    "text": "哪怕是对雅各布或者，纳齐森科鲁兹来说，钟声响起都有特别的意义吧。"
                },
                {
                    "id": "740770709",
                    "speaker": "Player",
                    "text": "特别的意义？"
                },
                {
                    "id": "740770710",
                    "speaker": "卡特皮拉",
                    "text": "钟响之时，世界终结、冒险结束，或者大梦初醒。谁知道呢？"
                }
            ]
        },
        {
            "id": "7407718",
            "objective": "前往下层",
            "dialogues": []
        },
        {
            "id": "7407708",
            "objective": "（废弃）前往下层",
            "dialogues": [
                {
                    "id": "740770801",
                    "speaker": "西摩尔",
                    "text": "你好，有什么能为你效劳的吗？"
                },
                {
                    "id": "740770802",
                    "speaker": "Player",
                    "text": "关于警卫发条机关…"
                },
                {
                    "id": "740770803",
                    "speaker": "西摩尔",
                    "text": "请不必担心。它们都处在非激活状态。"
                },
                {
                    "id": "740770804",
                    "speaker": "西摩尔",
                    "text": "而且年代久远，加上是初期型号，它们苏醒过来的概率并不是百分之百。"
                },
                {
                    "id": "740770805",
                    "speaker": "西摩尔",
                    "text": "根据我身边这几位的记录来看，开启下层的入口就会触发激活唤醒。"
                },
                {
                    "id": "740770806",
                    "speaker": "西摩尔",
                    "text": "到时候大概会有六成机关能成功启动。剩下四成，启动不了的概率也不是百分之百。"
                },
                {
                    "id": "740770807",
                    "speaker": "Player",
                    "text": "呃…"
                },
                {
                    "id": "740770808",
                    "speaker": "西摩尔",
                    "text": "至少漫长的时间有概率帮我们减轻备战压力。"
                },
                {
                    "id": "740770809",
                    "speaker": "Player",
                    "text": "这几句话逻辑好绕哦。"
                },
                {
                    "id": "740770810",
                    "speaker": "西摩尔",
                    "text": "#抱歉，{NICKNAME}{M#先生}{F#小姐}。"
                }
            ]
        },
        {
            "id": "7407709",
            "objective": "与大家对话",
            "dialogues": []
        },
        {
            "id": "7407722",
            "objective": "稍作休息，与大家聊聊",
            "dialogues": [
                {
                    "id": "740770601",
                    "speaker": "安",
                    "text": "#{NICKNAME}骑士，有什么事情吗？"
                },
                {
                    "id": "740770602",
                    "speaker": "安",
                    "text": "卡特皮拉和西摩尔都在帮忙，我似乎在这里就派不上什么用场了。"
                },
                {
                    "id": "740770603",
                    "speaker": "Player",
                    "text": "不必在意。"
                },
                {
                    "id": "740770604",
                    "speaker": "安",
                    "text": "嗯嗯，我明白的。明明可以一脚踹开的门，大家都很默契地在调查。"
                },
                {
                    "id": "740770605",
                    "speaker": "安",
                    "text": "大家都在做某种，心理准备吧。"
                }
            ]
        },
        {
            "id": "7407723",
            "objective": "稍作休息，与大家聊聊",
            "dialogues": []
        },
        {
            "id": "7407724",
            "objective": "稍作休息，与大家聊聊",
            "dialogues": []
        },
        {
            "id": "7407725",
            "objective": "稍作休息，与大家聊聊",
            "dialogues": [
                {
                    "id": "740771201",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，为什么人们都喜欢沉浸在梦里？"
                },
                {
                    "id": "740771202",
                    "speaker": "派蒙",
                    "text": "那个「玛丽安」编织着大家环绕的梦境，纳齐森科鲁兹活在拯救世界的梦想里。"
                },
                {
                    "id": "740771203",
                    "speaker": "Player",
                    "text": "明天的事情都是我在操心…"
                },
                {
                    "id": "740771204",
                    "speaker": "Player",
                    "text": "…派蒙不理解很正常。"
                },
                {
                    "id": "740771205",
                    "speaker": "派蒙",
                    "text": "因、因为我是一个活在当下的类型！"
                },
                {
                    "id": "740771206",
                    "speaker": "Player",
                    "text": "是梦总是会醒的。"
                },
                {
                    "id": "740771207",
                    "speaker": "派蒙",
                    "text": "梦醒来的话，就只有两个选择了。"
                },
                {
                    "id": "740771208",
                    "speaker": "派蒙",
                    "text": "赶紧接着睡，看能不能重新做那个梦。"
                },
                {
                    "id": "740771209",
                    "speaker": "派蒙",
                    "text": "或者，就在清醒的世界里，好好面对自己。"
                },
                {
                    "id": "740771210",
                    "speaker": "派蒙",
                    "text": "既然梦醒了，就该吃早餐了吧。那就吃个野菇鸡肉串犒劳自己吧。"
                },
                {
                    "id": "740771211",
                    "speaker": "派蒙",
                    "text": "又要清醒、勇敢地面对一天现实了呢。给自己加个油！"
                },
                {
                    "id": "740771212",
                    "speaker": "Player",
                    "text": "哇塞，真是伏笔！"
                },
                {
                    "id": "740771213",
                    "speaker": "派蒙",
                    "text": "伏笔？什么伏笔？"
                }
            ]
        },
        {
            "id": "7407726",
            "objective": "与卡特皮拉对话",
            "dialogues": [
                {
                    "id": "740772501",
                    "speaker": "卡特皮拉",
                    "text": "#{NICKNAME}， 看看书页中夹杂着什么？"
                },
                {
                    "id": "740772502",
                    "speaker": "派蒙",
                    "text": "哇，是钥匙！"
                },
                {
                    "id": "740772503",
                    "speaker": "卡特皮拉",
                    "text": "没错，西摩尔用声波成像模糊验证了一下，确实是那扇门的钥匙。"
                },
                {
                    "id": "740772504",
                    "speaker": "派蒙",
                    "text": "如果这里曾经被枫丹官方查抄过的话，为什么藏在书里的钥匙一直没有被发现呢？"
                },
                {
                    "id": "740772505",
                    "speaker": "卡特皮拉",
                    "text": "答案或许是，根本没有查抄。刚才翻了翻这里的笔记，大概能理解为什么…"
                },
                {
                    "id": "740772506",
                    "speaker": "卡特皮拉",
                    "text": "为什么他只是悄悄关上门就离开了。"
                },
                {
                    "id": "740772507",
                    "speaker": "派蒙",
                    "text": "嗯，你这句话是什么意思啊？"
                },
                {
                    "id": "740772508",
                    "speaker": "卡特皮拉",
                    "text": "没什么。或许做到这一步就足够了，下面还有随时可能启动的发条机关呢。"
                },
                {
                    "id": "740772509",
                    "speaker": "卡特皮拉",
                    "text": "该出发了。"
                }
            ]
        },
        {
            "id": "7407728",
            "objective": "解开门锁，前往下层",
            "dialogues": []
        },
        {
            "id": "7407710",
            "objective": "解开门锁，前往下层",
            "dialogues": [
                {
                    "id": "740771001",
                    "speaker": "安",
                    "text": "解开最后的一环吧。"
                }
            ]
        },
        {
            "id": "7407711",
            "objective": "与大家对话",
            "dialogues": []
        },
        {
            "id": "7407712",
            "objective": "解开胎海的封印",
            "dialogues": []
        },
        {
            "id": "7407714",
            "objective": "击败发条机关",
            "dialogues": []
        },
        {
            "id": "7407716",
            "objective": "与大家对话",
            "dialogues": [
                {
                    "id": "740770401",
                    "speaker": "安",
                    "text": "#{NICKNAME}骑士、派蒙、卡特皮拉，还有西摩尔…你们还好吗？"
                },
                {
                    "id": "740770402",
                    "speaker": "卡特皮拉",
                    "text": "嗯。看来通往更深处的入口就要开启了。"
                },
                {
                    "id": "740770403",
                    "speaker": "卡特皮拉",
                    "text": "去吧，抓住机会。"
                },
                {
                    "id": "740770404",
                    "speaker": "派蒙",
                    "text": "但是，这里还有好多发条机关…"
                },
                {
                    "id": "740770405",
                    "speaker": "卡特皮拉",
                    "text": "快去！这里就交给我和西摩尔。让我们在水仙十字结社再会。"
                },
                {
                    "id": "740770406",
                    "speaker": "Player",
                    "text": "拜托你们了。"
                },
                {
                    "id": "740770407",
                    "speaker": "西摩尔",
                    "text": "毋须担心。评估战力结果：生还概率百分之百。"
                },
                {
                    "id": "740770408",
                    "speaker": "Black Screen",
                    "text": "向卡特皮拉与西摩尔点头示意后，趁着封印开启的一瞬间跳了进去。\\n在另一头的是…"
                }
            ]
        },
        {
            "id": "7407717",
            "objective": "与安对话",
            "dialogues": [
                {
                    "id": "740770501",
                    "speaker": "派蒙",
                    "text": "看来是卡特皮拉他们，在另一边挡着…"
                },
                {
                    "id": "740770502",
                    "speaker": "安",
                    "text": "西摩尔，卡特皮拉…"
                },
                {
                    "id": "740770503",
                    "speaker": "派蒙",
                    "text": "安，别担心！他们都很厉害的。而且，我们不是约好了吗？等事情结束，我们就在水仙十字结社会合。"
                },
                {
                    "id": "740770504",
                    "speaker": "派蒙",
                    "text": "#况且，还有{NICKNAME}和我在呀！"
                },
                {
                    "id": "740770505",
                    "speaker": "安",
                    "text": "#…你说得对，派蒙。{NICKNAME}骑士和派蒙，是我见过的最厉害、最聪明、最善良的人。有你们在身边，没什么好怕的。"
                },
                {
                    "id": "740770506",
                    "speaker": "安",
                    "text": "没什么好怕的！嗯嗯！一点也不可怕！"
                },
                {
                    "id": "740770507",
                    "speaker": "派蒙",
                    "text": "（虽然我有点怕就是了…）",
                    "choices": [
                        {
                            "id": "740770508",
                            "text": "毋须担心。",
                            "response": [
                                {
                                    "id": "740770510",
                                    "speaker": "Player",
                                    "text": "必须朝着未来前进。"
                                },
                                {
                                    "id": "740770511",
                                    "speaker": "派蒙&安",
                                    "text": "嗯！"
                                },
                                {
                                    "id": "740770512",
                                    "speaker": "派蒙",
                                    "text": "接下来，不知道会遇到什么事情…谨慎前进吧！"
                                }
                            ]
                        },
                        {
                            "id": "740770509",
                            "text": "没有克服不了的困难。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7407721",
            "objective": "",
            "dialogues": [
                {
                    "id": "740772101",
                    "speaker": "安",
                    "text": "#{NICKNAME}骑士，还有什么事吗？"
                },
                {
                    "id": "740772102",
                    "speaker": "Player",
                    "text": "结束之后，有什么想做的吗？"
                },
                {
                    "id": "740772103",
                    "speaker": "安",
                    "text": "说实话，没有想那么多。感觉我已经无处可去了。"
                },
                {
                    "id": "740772104",
                    "speaker": "安",
                    "text": "知道真相之后，我再也回不到小卷心菜和阿尔身边了。"
                },
                {
                    "id": "740772105",
                    "speaker": "安",
                    "text": "我应该去哪里呢？"
                },
                {
                    "id": "740772106",
                    "speaker": "安",
                    "text": "算了，以后的事情以后再想吧！"
                }
            ]
        },
        {
            "id": "7407709",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740770901",
                    "speaker": "卡特皮拉",
                    "text": "去吧，最后关头了。"
                }
            ]
        },
        {
            "id": "7407711",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740771101",
                    "speaker": "西摩尔",
                    "text": "当二位先受到攻击时，我的许可就会激活。我就可以对官方武装出手了。"
                },
                {
                    "id": "740771102",
                    "speaker": "西摩尔",
                    "text": "所以不必担心。"
                }
            ]
        },
        {
            "id": "7407722",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740772201",
                    "speaker": "卡特皮拉",
                    "text": "还有什么事吗？"
                },
                {
                    "id": "740772202",
                    "speaker": "Player",
                    "text": "结束之后，你会去找莉诺尔吗？"
                },
                {
                    "id": "740772203",
                    "speaker": "卡特皮拉",
                    "text": "应该会去看看，不过我应该还是会继续流浪吧。我的内心有很多问题需要得到解答。"
                },
                {
                    "id": "740772204",
                    "speaker": "卡特皮拉",
                    "text": "在听了雅各布说的话以后，我倒想起有个「揭示之书」和他们早年的事情有关。或许有关于我的线索吧。"
                },
                {
                    "id": "740772205",
                    "speaker": "Player",
                    "text": "你还是很在意过去吗？"
                },
                {
                    "id": "740772206",
                    "speaker": "卡特皮拉",
                    "text": "嗯。但话说回来，比起这个，我更关心好多年前读过的小说是否有一个美满的结局。"
                },
                {
                    "id": "740772207",
                    "speaker": "卡特皮拉",
                    "text": "为此，我可以跋山涉水，不开玩笑。"
                },
                {
                    "id": "740772208",
                    "speaker": "Player",
                    "text": "你，又是在开玩笑吧？"
                },
                {
                    "id": "740772209",
                    "speaker": "卡特皮拉",
                    "text": "有那么一点。不过我对于一个很精彩的梦如何结束，是会报以真心的。"
                }
            ]
        },
        {
            "id": "7407723",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740772301",
                    "speaker": "西摩尔",
                    "text": "#还有什么事情吗，{NICKNAME}{M#先生}{F#小姐}？"
                },
                {
                    "id": "740772302",
                    "speaker": "Player",
                    "text": "你之后有什么打算吗？"
                },
                {
                    "id": "740772303",
                    "speaker": "西摩尔",
                    "text": "您是指一切结束之后吗？如果还能与玛丽安小姐再见的话，我希望…"
                },
                {
                    "id": "740772304",
                    "speaker": "西摩尔",
                    "text": "我希望她能同意和我回去见玛梅赫，然后我们三个一起去周游世界。"
                },
                {
                    "id": "740772305",
                    "speaker": "Player",
                    "text": "你真是条好狗狗。"
                },
                {
                    "id": "740772306",
                    "speaker": "西摩尔",
                    "text": "不太理解您的意思。"
                },
                {
                    "id": "740772307",
                    "speaker": "Player",
                    "text": "你可真是件可靠性高的原型机！"
                },
                {
                    "id": "740772308",
                    "speaker": "西摩尔",
                    "text": "谢谢您的夸奖。"
                }
            ]
        }
    ]
}