        {
            "id": "7165402",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "716540201",
                    "speaker": "派蒙",
                    "text": "哇…这壶里的空间，好像比萍姥姥那盏更大呢，中间还有一栋好大的房子！"
                },
                {
                    "id": "716540202",
                    "speaker": "派蒙",
                    "text": "不过，周围却没什么东西呢…",
                    "choices": [
                        {
                            "id": "716540203",
                            "text": "派蒙去开凿石头，再造一座屋子吧。",
                            "response": [
                                {
                                    "id": "716540204",
                                    "speaker": "派蒙",
                                    "text": "凿不动！你自己不是拿着剑吗？你自己去凿啦！"
                                },
                                {
                                    "id": "716540207",
                                    "speaker": "派蒙",
                                    "text": "唉，不过除了那个房子之外，这周围怎么空荡荡的…"
                                },
                                {
                                    "id": "716540208",
                                    "speaker": "派蒙",
                                    "text": "欸？等等，那是什么？"
                                }
                            ]
                        },
                        {
                            "id": "716540205",
                            "text": "派蒙去挖个地洞，暂时住进去吧。",
                            "response": [
                                {
                                    "id": "716540206",
                                    "speaker": "派蒙",
                                    "text": "明明有房子，为什么我还要挖地洞啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
