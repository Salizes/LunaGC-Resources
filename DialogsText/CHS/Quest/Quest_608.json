        {
            "id": "60801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "6080101",
                    "speaker": "丽莎",
                    "text": "呼，好久没在风花节期间尽情电什么人了呢。"
                },
                {
                    "id": "6080102",
                    "speaker": "雷泽",
                    "text": "老师，以前难道很多？"
                },
                {
                    "id": "6080103",
                    "speaker": "丽莎",
                    "text": "你说电人？当然不多了，啊哈哈，只是偶尔啦。不过还挺解压的呢。"
                },
                {
                    "id": "6080104",
                    "speaker": "丽莎",
                    "text": "啊对了，前些日子老师给我写信还问起这件事呢，我当时说的可是「温柔待人」。"
                },
                {
                    "id": "6080105",
                    "speaker": "丽莎",
                    "text": "学生继承老师的风格，很合理吧？我的老师也是一个温柔的素论派老爷子呢。"
                },
                {
                    "id": "6080106",
                    "speaker": "丽莎",
                    "text": "所以这次也只用了很温柔的电法哦？就算琴看到都不方便阻止我的那种。"
                },
                {
                    "id": "6080107",
                    "speaker": "雷泽",
                    "text": "原来，可以温柔地电人…"
                },
                {
                    "id": "6080108",
                    "speaker": "阿贝多",
                    "text": "看起来丽莎小姐状态很不错，真是太好了。"
                },
                {
                    "id": "6080109",
                    "speaker": "丽莎",
                    "text": "是啊，活动一下身体，对健康也很有益处呢。"
                }
            ]
        },
