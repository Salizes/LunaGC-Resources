            "dialogues": [
                {
                    "id": "730679904",
                    "speaker": "？？？",
                    "text": "…呜呜，救命，救命，谁能将兰沙恭从这可怕的山洞救出…"
                },
                {
                    "id": "730679905",
                    "speaker": "派蒙",
                    "text": "#咦，{NICKNAME}你有听到吗，好像是什么人的呼救声！"
