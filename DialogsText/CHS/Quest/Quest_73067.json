    "talks": [
        {
            "id": "7306701",
            "objective": "到达兰那罗小屋$HIDDEN",
            "dialogues": [
                {
                    "id": "730670101",
                    "speaker": "派蒙",
                    "text": "咦，这些丘丘人好像掉了一个奇怪的东西…"
                },
                {
                    "id": "730670102",
                    "speaker": "派蒙",
                    "text": "看上去好像是用花朵做的，奇怪，明明只是普通的花，已经摘下来很久了…却没有坏掉。"
                },
                {
                    "id": "730670103",
                    "speaker": "派蒙",
                    "text": "上面能感受到相当多的草元素…而且还丢在这里…",
                    "choices": [
                        {
                            "id": "730670104",
                            "text": "肯定是兰那罗的吧…",
                            "response": [
                                {
                                    "id": "730670105",
                                    "speaker": "派蒙",
                                    "text": "嗯，一定是这样。"
                                },
                                {
                                    "id": "730670108",
                                    "speaker": "派蒙",
                                    "text": "唔，这个花朵做的东西上有那么多的草元素，就连在丘丘人手里都没有枯萎…",
                                    "choices": [
                                        {
                                            "id": "730670109",
                                            "text": "也许是一直随身携带着…",
                                            "response": [
                                                {
                                                    "id": "730670111",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我们还是尽快把这个东西还给兰那罗吧。"
                                                },
                                                {
                                                    "id": "730670112",
                                                    "speaker": "派蒙",
                                                    "text": "#我们进屋子看看，{NICKNAME}，说不定那个丢了东西的冒失鬼正在房子里唉声叹气呢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730670110",
                                            "text": "也许是很宝贵的东西…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730670106",
                            "text": "是草元素丘丘人…",
                            "response": [
                                {
                                    "id": "730670107",
                                    "speaker": "派蒙",
                                    "text": "那是什么啦，怎么想都是住在这里的兰那罗掉的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7306702",
            "objective": "击败兰那罗小屋旁的丘丘人",
            "dialogues": [
                {
                    "id": "730670201",
                    "speaker": "字迹不一的笔记",
                    "text": "（前几页用着很小的字迹写着…）"
                },
                {
                    "id": "730670202",
                    "speaker": "字迹不一的笔记",
                    "text": "「…呜呜，居然有那菈愿意和兰沙恭做朋友，真是好那菈，好那菈不嫌弃胆小的兰沙恭，还教兰沙恭写那菈的文字…」"
                },
                {
                    "id": "730670203",
                    "speaker": "字迹不一的笔记",
                    "text": "「…好那菈在兰沙恭被落在头上的叶子吓到的时候安慰了兰沙恭，好那菈是兰沙恭永远的好朋友！」"
                },
                {
                    "id": "730670204",
                    "speaker": "字迹不一的笔记",
                    "text": "（后面的几页里，字迹变得又小又慌乱…）"
                },
                {
                    "id": "730670205",
                    "speaker": "字迹不一的笔记",
                    "text": "「…呜呜，那菈朋友被『毛毛脸面具魔王』捉走了，『毛毛脸面具魔王』，手长长，好可怕，好可怕…」"
                },
                {
                    "id": "730670206",
                    "speaker": "字迹不一的笔记",
                    "text": "「…可是，可是必须得救出那菈才行，呜呜…」"
                },
                {
                    "id": "730670207",
                    "speaker": "字迹不一的笔记",
                    "text": "（后面的几页里，用很大很用力的字写着…）"
                },
                {
                    "id": "730670208",
                    "speaker": "字迹不一的笔记",
                    "text": "「打倒了『毛毛脸面具魔王』，救出了那菈朋友，那菈朋友把『勇气』给了兰沙恭，兰沙恭再也不是从前的胆小鬼。」"
                },
                {
                    "id": "730670209",
                    "speaker": "字迹不一的笔记",
                    "text": "「…有了『勇气』的兰沙恭，勇敢地和『毛毛脸面具怪物』们作战，附近的那菈再不用担心被『毛毛脸面具怪物』骚扰！」"
                },
                {
                    "id": "730670210",
                    "speaker": "字迹不一的笔记",
                    "text": "（最新的几页里，又恢复成了很小的字迹…）"
                },
                {
                    "id": "730670211",
                    "speaker": "字迹不一的笔记",
                    "text": "「…呜呜，怎么会这样，兰沙恭的『勇气』不见了，那菈送给兰沙恭的『勇气』…一定是『毛毛脸面具魔王』偷走了。」"
                },
                {
                    "id": "730670212",
                    "speaker": "字迹不一的笔记",
                    "text": "「『毛毛脸面具魔王』，手长长，狡猾可怕。但兰沙恭失去『勇气』什么都做不了…呜，兰沙恭要去<color=#00E1FFFF>东边的洞窟</color>里找一找…」"
                }
            ]
        },
        {
            "id": "7306715",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "7306704",
            "objective": "进入兰那罗房子",
            "dialogues": [
                {
                    "id": "730670401",
                    "speaker": "派蒙",
                    "text": "你就是兰沙恭吗？"
                },
                {
                    "id": "730670402",
                    "speaker": "兰沙恭",
                    "text": "呜呜…兰沙恭确实是我的名字，呜哇，别突然靠那么近…"
                },
                {
                    "id": "730670403",
                    "speaker": "兰沙恭",
                    "text": "虽然很感谢两位将我救出险境，但、但是兰沙恭还是请求两位能保持一定的距离…呜呜…"
                },
                {
                    "id": "730670404",
                    "speaker": "兰沙恭",
                    "text": "这样能让兰沙恭，稍微安心一些…"
                },
                {
                    "id": "730670405",
                    "speaker": "派蒙",
                    "text": "什么呀，刚刚明明就是我们把你救出来的！"
                },
                {
                    "id": "730670406",
                    "speaker": "兰沙恭",
                    "text": "啊啊，对不起对不起，是兰沙恭提出的要求太过分了…才让你生气。"
                },
                {
                    "id": "730670407",
                    "speaker": "兰沙恭",
                    "text": "可是兰沙恭被围困在此，惊魂未定，呜呜，就算有失礼之处，还希望两位能够原谅…"
                },
                {
                    "id": "730670408",
                    "speaker": "派蒙",
                    "text": "没关系啦…"
                },
                {
                    "id": "730670409",
                    "speaker": "兰沙恭",
                    "text": "那就好那就好，不知兰沙恭能知道两位的名字吗？"
                },
                {
                    "id": "730670410",
                    "speaker": "派蒙",
                    "text": "我叫派蒙。"
                },
                {
                    "id": "730670411",
                    "speaker": "Player",
                    "text": "#我是{NICKNAME}…"
                },
                {
                    "id": "730670412",
                    "speaker": "兰沙恭",
                    "text": "#呜呜，金色的那菈{NICKNAME}和派蒙，那个…为何会知道兰沙恭的名字。"
                },
                {
                    "id": "730670413",
                    "speaker": "Player",
                    "text": "我们看了屋子里的笔记…"
                },
                {
                    "id": "730670414",
                    "speaker": "兰沙恭",
                    "text": "#金发的那菈{NICKNAME}，看到了笔记，便来寻找兰沙恭的踪迹，又帮兰沙恭解围，真是心善又厉害的好那菈。"
                },
                {
                    "id": "730670415",
                    "speaker": "兰沙恭",
                    "text": "呜呜…如果兰沙恭没有失去「勇气」，就不会像刚才那样被困住了…"
                },
                {
                    "id": "730670416",
                    "speaker": "派蒙",
                    "text": "对哦，之前在笔记里也看到了，兰沙恭，你说自己失去了「勇气」到底是怎么一回事啊？"
                },
                {
                    "id": "730670417",
                    "speaker": "兰沙恭",
                    "text": "这是很久以前的故事了…"
                },
                {
                    "id": "730670418",
                    "speaker": "兰沙恭",
                    "text": "在许多月亮之前，兰沙恭就像现在这样，是没有「勇气」的兰沙恭…那时，即使是树枝断裂的声音，也会让兰沙恭夜不能寐…"
                },
                {
                    "id": "730670419",
                    "speaker": "兰沙恭",
                    "text": "但是，即使是胆小的兰沙恭，也有一个愿意陪伴兰沙恭的那菈朋友，虽然那菈朋友不是伟大的那菈法留纳，但也是很好的那菈！"
                },
                {
                    "id": "730670420",
                    "speaker": "兰沙恭",
                    "text": "他从不会因为兰沙恭胆小而故意捉弄兰沙恭，在兰沙恭觉得害怕的时候，会主动握起兰沙恭的手…是兰沙恭永不会忘记的朋友。"
                },
                {
                    "id": "730670421",
                    "speaker": "兰沙恭",
                    "text": "可有一天，那个那菈被「毛毛脸面具魔王」抓走了…"
                },
                {
                    "id": "730670422",
                    "speaker": "派蒙",
                    "text": "等等，所以那个「毛毛脸面具魔王」是什么呀…"
                },
                {
                    "id": "730670423",
                    "speaker": "兰沙恭",
                    "text": "「毛毛脸面具魔王」，就是毛毛脸，戴着面具的，魔王呀？"
                },
                {
                    "id": "730670424",
                    "speaker": "派蒙",
                    "text": "…是、是哦。",
                    "choices": [
                        {
                            "id": "730670425",
                            "text": "派蒙知道是什么了吗？",
                            "response": [
                                {
                                    "id": "730670426",
                                    "speaker": "派蒙",
                                    "text": "能知道才奇怪啦…"
                                },
                                {
                                    "id": "730670429",
                                    "speaker": "派蒙",
                                    "text": "总之，就是那个「毛毛脸面具魔王」抓走了兰沙恭的朋友…"
                                },
                                {
                                    "id": "730670430",
                                    "speaker": "兰沙恭",
                                    "text": "…「毛毛脸面具魔王」，十分阴险狡猾，只是想想，兰沙恭全身就开始颤抖…"
                                },
                                {
                                    "id": "730670431",
                                    "speaker": "兰沙恭",
                                    "text": "…呜呜，那时兰沙恭的那菈朋友被抓走，十分害怕，兰沙恭虽然害怕被「毛毛脸面具魔王」打，但更害怕再也见不到那菈朋友…"
                                },
                                {
                                    "id": "730670432",
                                    "speaker": "兰沙恭",
                                    "text": "所以兰沙恭很努力的，闭着眼睛！咬着牙！用手拍拍！救出了兰沙恭的那菈朋友。"
                                },
                                {
                                    "id": "730670433",
                                    "speaker": "兰沙恭",
                                    "text": "那之后呀，那菈朋友就用花做了「勇气的护身符」，对兰沙恭说，「兰沙恭是有勇气的好兰那罗！不是胆小的兰那罗！」"
                                },
                                {
                                    "id": "730670434",
                                    "speaker": "兰沙恭",
                                    "text": "兰沙恭因此获得了「勇气」…"
                                },
                                {
                                    "id": "730670435",
                                    "speaker": "派蒙",
                                    "text": "咦，可是按这样来说，你的「闭着眼睛！咬着牙！用手拍拍！」不就是很有勇气的行为了吗？"
                                },
                                {
                                    "id": "730670436",
                                    "speaker": "兰沙恭",
                                    "text": "不是的不是的，兰沙恭是那之后才从那菈朋友那里，获得了「勇气」的呀？"
                                },
                                {
                                    "id": "730670437",
                                    "speaker": "派蒙",
                                    "text": "可是，你救你的朋友本身，就很勇敢了呀。"
                                },
                                {
                                    "id": "730670438",
                                    "speaker": "兰沙恭",
                                    "text": "没有没有，在救那菈朋友的时候，兰沙恭可害怕了，手软软脚软软，可是获得了「勇气」后，兰沙恭就再没有手软软脚软软了。"
                                },
                                {
                                    "id": "730670439",
                                    "speaker": "派蒙",
                                    "text": "唔…",
                                    "choices": [
                                        {
                                            "id": "730670440",
                                            "text": "护身符只是契机！",
                                            "response": [
                                                {
                                                    "id": "730670442",
                                                    "speaker": "兰沙恭",
                                                    "text": "#呜呜…那菈{NICKNAME}的话好复杂，兰沙恭只知道，「勇气护身符」在，兰沙恭就有「勇气」…"
                                                },
                                                {
                                                    "id": "730670443",
                                                    "speaker": "兰沙恭",
                                                    "text": "之前兰沙恭的「勇气」被偷走，所以就想来「毛毛脸面具魔王」的洞穴偷偷寻找，希望能寻到兰沙恭的「勇气」的踪迹…"
                                                },
                                                {
                                                    "id": "730670444",
                                                    "speaker": "派蒙",
                                                    "text": "结果就被几只史莱姆围困在了洞穴里呢…幸好没被那个什么「毛毛脸面具魔王」发现…"
                                                },
                                                {
                                                    "id": "730670445",
                                                    "speaker": "派蒙",
                                                    "text": "#啊，说到这个，{NICKNAME}，还记得我们之前从丘丘人那里捡到的…不会就是兰沙恭的护身符吧。"
                                                },
                                                {
                                                    "id": "730670446",
                                                    "speaker": "派蒙",
                                                    "text": "兰沙恭，我们说不定捡到你的「勇气」啦？"
                                                },
                                                {
                                                    "id": "730670447",
                                                    "speaker": "兰沙恭",
                                                    "text": "#真的吗！那菈{NICKNAME}和派蒙，真的捡到兰沙恭的「勇气」了吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730670441",
                                            "text": "勇气本就存在兰沙恭心中！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730670427",
                            "text": "是兰那罗风格的回答呢…",
                            "response": [
                                {
                                    "id": "730670428",
                                    "speaker": "派蒙",
                                    "text": "是啊，完全猜不到那个「毛毛脸面具魔王」是什么…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7306705",
            "objective": "调查兰那罗房子里的信息",
            "dialogues": []
        },
        {
            "id": "7306714",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "730670301",
                    "speaker": "派蒙",
                    "text": "嗯…兰沙恭，这个兰沙恭就是写下这个笔记的兰那罗吧…"
                },
                {
                    "id": "730670302",
                    "speaker": "派蒙",
                    "text": "笔记上的字怎么一会儿特别大一会儿特别小，大的也就算了…"
                },
                {
                    "id": "730670303",
                    "speaker": "派蒙",
                    "text": "小的字看的我眼睛都有点疼。"
                },
                {
                    "id": "730670304",
                    "speaker": "Player",
                    "text": "派蒙看小字也会不舒服吗？"
                },
                {
                    "id": "730670305",
                    "speaker": "派蒙",
                    "text": "平时看得都是正常的字，看小字总是会不习惯的啦！"
                },
                {
                    "id": "730670306",
                    "speaker": "派蒙",
                    "text": "唔，这个兰沙恭，难道留下笔记上最新的几页之后就没有再回来吗…"
                },
                {
                    "id": "730670307",
                    "speaker": "派蒙",
                    "text": "我们现在就去东边的洞窟找找看吧，笔记上写着「勇气」不见了…「勇气」也能不见吗，还真有点好奇…"
                }
            ]
        },
        {
            "id": "7306706",
            "objective": "前往洞窟寻找兰沙恭",
            "dialogues": [
                {
                    "id": "730670601",
                    "speaker": "兰沙恭",
                    "text": "就是这个！就是这个！"
                },
                {
                    "id": "730670602",
                    "speaker": "兰沙恭",
                    "text": "这就是兰沙恭的「勇气护身符」，离开了兰沙恭身边几天，花的颜色也有点黯淡了…"
                },
                {
                    "id": "730670603",
                    "speaker": "兰沙恭",
                    "text": "但是没有关系，兰沙恭以后会好好保护它！"
                },
                {
                    "id": "730670604",
                    "speaker": "兰沙恭",
                    "text": "「兰沙恭是有勇气的好兰那罗！不是胆小的兰那罗！」"
                },
                {
                    "id": "730670605",
                    "speaker": "兰沙恭",
                    "text": "#真是感谢你啊，那菈{NICKNAME}和派蒙！"
                },
                {
                    "id": "730670606",
                    "speaker": "兰沙恭",
                    "text": "现在的兰沙恭已经是寻回「勇气」的兰沙恭，再没有什么能够阻拦我。区区「毛毛脸面具魔王」，不过是兰沙恭的手下败将。"
                },
                {
                    "id": "730670607",
                    "speaker": "派蒙",
                    "text": "（呜哇，感觉说话的语气都和之前不一样了。）"
                },
                {
                    "id": "730670608",
                    "speaker": "兰沙恭",
                    "text": "#「毛毛脸面具魔王」作恶多端，那菈{NICKNAME}和派蒙，请随我来，有二位的帮助，一定能够解决掉它！"
                },
                {
                    "id": "730670609",
                    "speaker": "兰沙恭",
                    "text": "兰沙恭能感觉到，今天…就是去它的魔窟，了结它的日子了。"
                },
                {
                    "id": "730670610",
                    "speaker": "派蒙",
                    "text": "#哦哦，{NICKNAME}，我们也一起去吧…看看那个「毛毛脸面具魔王」到底是什么。"
                }
            ]
        },
        {
            "id": "7306707",
            "objective": "清理围困兰那罗的怪物",
            "dialogues": [
                {
                    "id": "730670701",
                    "speaker": "派蒙",
                    "text": "虽然隐约猜到了…不过「毛毛脸面具魔王」真的就是丘丘人。"
                },
                {
                    "id": "730670702",
                    "speaker": "兰沙恭",
                    "text": "丘丘人？"
                },
                {
                    "id": "730670703",
                    "speaker": "派蒙",
                    "text": "嗯，「毛毛脸面具魔王」是丘丘人…"
                },
                {
                    "id": "730670704",
                    "speaker": "兰沙恭",
                    "text": "「球球人」都是「毛毛脸面具魔王」？"
                },
                {
                    "id": "730670705",
                    "speaker": "派蒙",
                    "text": "不是不是…"
                },
                {
                    "id": "730670706",
                    "speaker": "Player",
                    "text": "兰沙恭这么理解就好了。"
                },
                {
                    "id": "730670707",
                    "speaker": "兰沙恭",
                    "text": "嗯，兰沙恭了解了。"
                },
                {
                    "id": "730670708",
                    "speaker": "兰沙恭",
                    "text": "#啊，有了那菈{NICKNAME}和派蒙的帮助，兰沙恭一兰当先，所向披靡。阴险狡猾的「毛毛脸面具魔王」亦不是对手。"
                },
                {
                    "id": "730670709",
                    "speaker": "兰沙恭",
                    "text": "今日兰沙恭一定要回去记上一大笔。"
                },
                {
                    "id": "730670710",
                    "speaker": "Player",
                    "text": "记上一大笔…"
                },
                {
                    "id": "730670711",
                    "speaker": "兰沙恭",
                    "text": "嗯，就是用很大的笔画，用很大的字留下记录！"
                },
                {
                    "id": "730670712",
                    "speaker": "派蒙",
                    "text": "感觉有了「勇气」的兰沙恭，和没有「勇气」的兰沙恭，就像两个不同的兰那罗呢…"
                },
                {
                    "id": "730670713",
                    "speaker": "兰沙恭",
                    "text": "没有「勇气」的兰沙恭，手软软脚软软，什么都做不好。有了「勇气」的兰沙恭，就能做到所有很厉害的事！"
                },
                {
                    "id": "730670714",
                    "speaker": "兰沙恭",
                    "text": "所以「勇气」不仅是那菈朋友送给兰沙恭的最好的礼物，也是兰沙恭很重要很重要的东西。"
                },
                {
                    "id": "730670715",
                    "speaker": "派蒙",
                    "text": "那就好好保存，别再被丘丘人偷走啦！"
                },
                {
                    "id": "730670716",
                    "speaker": "兰沙恭",
                    "text": "兰沙恭知道了，兰沙恭一定不会让「勇气」再离开自己了！"
                }
            ]
        },
