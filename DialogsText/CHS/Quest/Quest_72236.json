    "talks": [
        {
            "id": "7223601",
            "objective": "与禁区的残影对话",
            "dialogues": [
                {
                    "id": "722360101",
                    "speaker": "？？？",
                    "text": "哼，渊下宫最后一天，你们都来了三波人了。"
                },
                {
                    "id": "722360102",
                    "speaker": "？？？",
                    "text": "你要是想回收实验记录，那我无可奉告。你让厄伯斯派和珊瑚宫派先吵完架再说这事吧。"
                },
                {
                    "id": "722360103",
                    "speaker": "？？？",
                    "text": "我反正站珊瑚宫派。这些实验记录永远埋葬在黑暗里比较好。"
                },
                {
                    "id": "722360104",
                    "speaker": "派蒙",
                    "text": "实验记录…"
                },
                {
                    "id": "722360105",
                    "speaker": "？？？",
                    "text": "哦？你们不是来回收实验记录的啊。那快点离开吧。"
                },
                {
                    "id": "722360106",
                    "speaker": "？？？",
                    "text": "不过一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？"
                },
                {
                    "id": "722360107",
                    "speaker": "派蒙",
                    "text": "不是啦不是！我们只是…"
                },
                {
                    "id": "722360108",
                    "speaker": "Player",
                    "text": "你，觉悟不错啊。"
                },
                {
                    "id": "722360109",
                    "speaker": "？？？",
                    "text": "什么意思？"
                },
                {
                    "id": "722360110",
                    "speaker": "Player",
                    "text": "我们是来检视你工作的。"
                },
                {
                    "id": "722360111",
                    "speaker": "？？？",
                    "text": "哼…"
                },
                {
                    "id": "722360112",
                    "speaker": "Player",
                    "text": "我们前来检查记录的密保措施。"
                },
                {
                    "id": "722360113",
                    "speaker": "？？？",
                    "text": "…反正你们能来到此地，料想也不是泛泛之辈。但我不管你究竟是哪边的人，还是离这里远点比较好。"
                },
                {
                    "id": "722360114",
                    "speaker": "？？？",
                    "text": "记录被我放在了所内深处，打开通路需要激活元素方碑。换句话说，需要释放强大的元素力。"
                },
                {
                    "id": "722360115",
                    "speaker": "？？？",
                    "text": "所有人离开白夜国后，这里的深海龙蜥就会被放出来。而它们被培养成了对特定元素起反应的体质。"
                },
                {
                    "id": "722360116",
                    "speaker": "？？？",
                    "text": "这里的深海龙蜥可都是强化品种，而且特征遗传给子代的概率很高。数载之后，这里将常年盘踞强大的深海龙蜥族群。"
                },
                {
                    "id": "722360117",
                    "speaker": "？？？",
                    "text": "因此，实验记录安全得很。"
                },
                {
                    "id": "722360118",
                    "speaker": "Player",
                    "text": "把它烧了不是更加安全？"
                },
                {
                    "id": "722360119",
                    "speaker": "？？？",
                    "text": "我是赞成这么做的，但是研究人员里面也分派系。我也不是不能理解另一派人的想法。"
                },
                {
                    "id": "722360120",
                    "speaker": "？？？",
                    "text": "「我们是拯救海祇的英雄了！」、「我们这下变成混蛋了…」——确实都有道理。"
                },
                {
                    "id": "722360121",
                    "speaker": "？？？",
                    "text": "把真相留到一个可以原谅我们的时代，也是一个我可以接受的方案。"
                },
                {
                    "id": "722360122",
                    "speaker": "？？？",
                    "text": "看你也不是一般人，就算不是地走官也是什么珊瑚宫近臣了。"
                },
                {
                    "id": "722360123",
                    "speaker": "宫地",
                    "text": "帮我给大人物们带个话吧：宫地他会在禁区里待到离开的前一刻，确保再也没有人出现在附近。"
                },
                {
                    "id": "722360124",
                    "speaker": "派蒙",
                    "text": "所以你就是宫地对吧？"
                },
                {
                    "id": "722360125",
                    "speaker": "宫地",
                    "text": "嗯哼，不过到海面之上就要换个名字开始新生活了。不过，罪孽是没办法和老名字一样轻易抛弃的。"
                }
            ]
        },
        {
            "id": "7223602",
            "objective": "在实验区域寻找实验记录",
            "dialogues": []
        },
        {
            "id": "7223699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722369901",
                    "speaker": "派蒙",
                    "text": "你套话的本事又进步了啊。"
                },
                {
                    "id": "722369902",
                    "speaker": "派蒙",
                    "text": "他刚才说了什么来着？想要拿到记录需要激活方碑。"
                },
                {
                    "id": "722369903",
                    "speaker": "派蒙",
                    "text": "但是方碑会引来危险的深海龙蜥。要事先做好准备才行。"
                }
            ]
        }
    ]
}