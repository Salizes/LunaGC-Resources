    },
    "talks": [
        {
            "id": "7220101",
            "objective": "跟鬼魂对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722010101",
                    "speaker": "蛎罗",
                    "text": "唉…过路的人呀…可怜可怜我吧…",
                    "choices": [
                        {
                            "id": "722010102",
                            "text": "你怎么了？",
                            "response": [
                                {
                                    "id": "722010104",
                                    "speaker": "蛎罗",
                                    "text": "谢谢你还愿意听一个老人自倒苦水…唉…过来，过来，听我多聊几句吧…"
                                },
                                {
                                    "id": "722010105",
                                    "speaker": "蛎罗",
                                    "text": "我这辈子呀…就没有一天转运的时候…"
                                },
                                {
                                    "id": "722010106",
                                    "speaker": "蛎罗",
                                    "text": "我刚出生的时候，主持出生礼的祭司大人不小心碰翻了油灯，烧光了姑妈的一头长发…"
                                },
                                {
                                    "id": "722010107",
                                    "speaker": "Player",
                                    "text": "哎哟…"
                                },
                                {
                                    "id": "722010108",
                                    "speaker": "蛎罗",
                                    "text": "后来，我患上了奇怪的病，从此四肢不调；再后来有一天，我从摇篮中被甩飞出来，摔断了六根肋骨…"
                                },
                                {
                                    "id": "722010109",
                                    "speaker": "蛎罗",
                                    "text": "等我长大了一点，有一天表叔被蘑菇呛了个半死，我爸爸在抢救他的时候用铲子打中了我的头…"
                                },
                                {
                                    "id": "722010110",
                                    "speaker": "蛎罗",
                                    "text": "然后有一次，心爱的小团雀被家里养的鹈猿兽吃掉了，鹈猿兽被一头瞎野猪撞下了山崖…"
                                },
                                {
                                    "id": "722010111",
                                    "speaker": "蛎罗",
                                    "text": "然后，喜欢的女孩子不小心把祭司大人献祭给了雷鸟大人，被驱逐出岛…"
                                },
                                {
                                    "id": "722010112",
                                    "speaker": "蛎罗",
                                    "text": "等我长大成人，奶奶因为我长得太丑郁郁而终；后来爷爷也随她而去了…"
                                },
                                {
                                    "id": "722010113",
                                    "speaker": "蛎罗",
                                    "text": "再后来呀…"
                                },
                                {
                                    "id": "722010114",
                                    "speaker": "Player",
                                    "text": "家庭对你来说多少算是慰藉吧？"
                                },
                                {
                                    "id": "722010115",
                                    "speaker": "蛎罗",
                                    "text": "啊，说起家庭…我成人礼的时候，巫医大人说我可能不会有孩子了，因为我长了一个…等一下，我给你看…",
                                    "choices": [
                                        {
                                            "id": "722010116",
                                            "text": "不要！",
                                            "response": [
                                                {
                                                    "id": "722010118",
                                                    "speaker": "蛎罗",
                                                    "text": "唉…再听我说最后一句吧…也是我想拜托你帮一个可怜老人最后的忙…",
                                                    "choices": [
                                                        {
                                                            "id": "722010119",
                                                            "text": "请你直说。",
                                                            "response": [
                                                                {
                                                                    "id": "722010121",
                                                                    "speaker": "蛎罗",
                                                                    "text": "前些阵子，我埋葬妻子的时候不小心把自己的金戒指掉进了墓坑，也一并埋进去了…"
                                                                },
                                                                {
                                                                    "id": "722010122",
                                                                    "speaker": "蛎罗",
                                                                    "text": "那是我最后的财产了…可我不敢重新挖出来…因为那样会触怒她的灵…"
                                                                },
                                                                {
                                                                    "id": "722010123",
                                                                    "speaker": "Player",
                                                                    "text": "所以你要我偷坟掘墓？"
                                                                },
                                                                {
                                                                    "id": "722010124",
                                                                    "speaker": "蛎罗",
                                                                    "text": "你是外人嘛…外人做什么都不奇怪…"
                                                                },
                                                                {
                                                                    "id": "722010125",
                                                                    "speaker": "蛎罗",
                                                                    "text": "啊不是，不是…我的意思是，如果是外人的话，就可以避免触怒本地的灵了…"
                                                                },
                                                                {
                                                                    "id": "722010126",
                                                                    "speaker": "蛎罗",
                                                                    "text": "去千来神祠吧…她的坟墓就在神祠的旁边呀…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722010120",
                                                            "text": "不要再提奇怪的话题就好…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722010117",
                                            "text": "这个话题已经足够了！！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722010103",
                            "text": "需要帮忙吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220102",
            "objective": "寻找他爱人的遗物（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722010201",
                    "speaker": "蛎罗",
                    "text": "哎呀哈哈哈哈哈…哈哈…哈哈哈哈哈！！哦哟哟…岔气了岔气了…"
                },
                {
                    "id": "722010202",
                    "speaker": "蛎罗",
                    "text": "哈哈哈哈眼泪都笑出来了！！阿雀呀，要是你还在这里就好了！！",
                    "choices": [
                        {
                            "id": "722010203",
                            "text": "我有点生气了。",
                            "response": [
                                {
                                    "id": "722010205",
                                    "speaker": "蛎罗",
                                    "text": "哈哈哈哈对不起，对不起…别生气嘛。是这么回事啦…"
                                },
                                {
                                    "id": "722010206",
                                    "speaker": "蛎罗",
                                    "text": "我和妻子从前就一直喜欢捉弄别人，各种恶作剧从来没有重样的，大家也都乐在其中。"
                                },
                                {
                                    "id": "722010207",
                                    "speaker": "蛎罗",
                                    "text": "后来呀，她生了场大病，去得早…那时候吩咐我，一定要在她的坟前好好地整一个老实人，不然她的灵就没办法离开…"
                                },
                                {
                                    "id": "722010208",
                                    "speaker": "蛎罗",
                                    "text": "为了完成阿雀的愿望…怎么样，我做的还不错吧？",
                                    "choices": [
                                        {
                                            "id": "722010209",
                                            "text": "这个玩笑很无聊。",
                                            "response": [
                                                {
                                                    "id": "722010212",
                                                    "speaker": "蛎罗",
                                                    "text": "啧，啧。岛外的人呀，一点都不有趣！"
                                                },
                                                {
                                                    "id": "722010213",
                                                    "speaker": "蛎罗",
                                                    "text": "就连喷水痦子戏法你也不愿意看…真是无聊！"
                                                },
                                                {
                                                    "id": "722010214",
                                                    "speaker": "蛎罗",
                                                    "text": "再见，我走啦，我走啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722010210",
                                            "text": "会出人命的！"
                                        },
                                        {
                                            "id": "722010211",
                                            "text": "我不会再相信你的胡说了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722010204",
                            "text": "告诉我这是怎么回事？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220103",
            "objective": "（test）万皮小子说话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220103",
