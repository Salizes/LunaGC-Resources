    "talks": [
        {
            "id": "2002801",
            "objective": "前去查看详请",
            "dialogues": [
                {
                    "id": "200280101",
                    "speaker": "胆小的莫罗",
                    "text": "#谢，谢谢你，{NICKNAME}…"
                },
                {
                    "id": "200280102",
                    "speaker": "胆小的莫罗",
                    "text": "虽然是猎人…但是我也拿这些史莱姆没办法。"
                },
                {
                    "id": "200280103",
                    "speaker": "胆小的莫罗",
                    "text": "被这群家伙一搅合，这次狩猎我又什么都带不回去了。"
                },
                {
                    "id": "200280104",
                    "speaker": "胆小的莫罗",
                    "text": "只希望别的猎人不要和我一样倒霉…"
                },
                {
                    "id": "200280105",
                    "speaker": "胆小的莫罗",
                    "text": "对了，说起这个，能请你去周围看看吗？"
                },
                {
                    "id": "200280106",
                    "speaker": "胆小的莫罗",
                    "text": "不知道是不是我的错觉，在镇子周围…史莱姆好像越来越多了。"
                },
                {
                    "id": "200280107",
                    "speaker": "胆小的莫罗",
                    "text": "请你去前头看看吧。如果发现了史莱姆，就直接把它们消灭掉吧。",
                    "choices": [
                        {
                            "id": "200280108",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200280110",
                                    "speaker": "胆小的莫罗",
                                    "text": "那就拜托你了，我也会回去和杜拉夫先生报告的。"
                                },
                                {
                                    "id": "200280111",
                                    "speaker": "胆小的莫罗",
                                    "text": "希望他别喝太多了，能听进去我说的话…"
                                }
                            ]
                        },
                        {
                            "id": "200280109",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "200280112",
                                    "speaker": "胆小的莫罗",
                                    "text": "但有能力能解决这件事的人，只有你了。为了清泉镇，就拜托你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002802",
            "objective": "消灭史莱姆",
            "dialogues": [
                {
                    "id": "200280201",
                    "speaker": "派蒙",
                    "text": "咦，这是什么？看着像是「灰尘」…但是却有元素的痕迹。"
                }
