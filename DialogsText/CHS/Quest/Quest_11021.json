    "talks": [
        {
            "id": "1102101",
            "objective": "一同前往孤云阁",
            "dialogues": []
        },
        {
            "id": "1102102",
            "objective": "与众人交谈",
            "dialogues": [
                {
                    "id": "110210201",
                    "speaker": "克列门特",
                    "text": "唔，这地方，怎么看起来这么普通…真的能找到有价值的东西吗？"
                },
                {
                    "id": "110210202",
                    "speaker": "派蒙",
                    "text": "嗯？我觉得挺壮观的呀。"
                },
                {
                    "id": "110210203",
                    "speaker": "克列门特",
                    "text": "我不是说风景，而是…既然发生了一场大战，总该有些不同寻常的地方吧，但现在，唉，甚至不知道该从哪儿找起。"
                },
                {
                    "id": "110210204",
                    "speaker": "钟离",
                    "text": "此处名为孤云阁，如果想要研究魔神，或是魔神战争时期的历史，这里都是绝佳的场所。"
                },
                {
                    "id": "110210205",
                    "speaker": "钟离",
                    "text": "相传，岩王帝君以岩为枪，投入此片海域，将魔神刺穿并镇压。"
                },
                {
                    "id": "110210206",
                    "speaker": "钟离",
                    "text": "那些岩枪经历了长年的风化，最终形成了此番别致的景象。"
                },
                {
                    "id": "110210207",
                    "speaker": "派蒙",
                    "text": "这、这么大的山，居然是岩王爷的武器？"
                },
                {
                    "id": "110210208",
                    "speaker": "钟离",
                    "text": "如今残存于我们眼前的，不过冰山一角。当年帝君投下的岩枪，无论数量还是体积，都远超于此。"
                },
                {
                    "id": "110210209",
                    "speaker": "钟离",
                    "text": "只不过因为角度各异，柱体又过于巨大，受到海水侵蚀，或是重力影响，很多都整体沉入了海底。"
                },
                {
                    "id": "110210210",
                    "speaker": "钟离",
                    "text": "所以，除了后来的风化，起初的崩落也是孤云阁的重要成因之一。"
                },
                {
                    "id": "110210211",
                    "speaker": "克列门特",
                    "text": "那…能和这么夸张的力量对抗的魔神，应该也很强吧。"
                },
                {
                    "id": "110210212",
                    "speaker": "钟离",
                    "text": "是的，这就是孤云阁的研究价值所在。"
                },
                {
                    "id": "110210213",
                    "speaker": "钟离",
                    "text": "与那段历史有关的物件大多沉于深海，但「漩涡之魔神」掀起了滔天巨浪，也给了这些东西重见天日的机会。"
                },
                {
                    "id": "110210214",
                    "speaker": "克列门特",
                    "text": "也就是说，只要仔细找找，肯定就能赚得盆满钵满…"
                },
                {
                    "id": "110210215",
                    "speaker": "克列门特",
                    "text": "啊，我是说，肯定会收获颇丰，是吧？这我就安心了。"
                },
                {
                    "id": "110210216",
                    "speaker": "克列门特",
                    "text": "反正带了这么多人，我觉得分头寻找效率会更高。"
                },
                {
                    "id": "110210217",
                    "speaker": "钟离",
                    "text": "嗯，那么，我和我的这位朋友同行吧，虽然我略懂一些杂学，但在专业的考古学家面前，还是不班门弄斧了。"
                },
                {
                    "id": "110210218",
                    "speaker": "宛烟",
                    "text": "欸？我、我吗？"
                },
                {
                    "id": "110210219",
                    "speaker": "克列门特",
                    "text": "怎么啦？这不是你的本职工作，有必要这么惊讶吗？"
                },
                {
                    "id": "110210220",
                    "speaker": "宛烟",
                    "text": "我知道了…那、那我就为他带路了。"
                },
                {
                    "id": "110210221",
                    "speaker": "钟离",
                    "text": "嗯，如果收集到了什么珍贵或者稀奇的东西，我想想…就到对岸汇合吧。"
                }
            ]
        },
        {
            "id": "1102107",
            "objective": "使用「元素视野」寻找古物",
            "dialogues": [
                {
                    "id": "110210701",
                    "speaker": "钟离",
                    "text": "那古老的魔神，应该留下了不少元素痕迹，追踪痕迹应该会事半功倍。"
                }
            ]
        },
        {
            "id": "1102108",
            "objective": "击败周围的敌人，打开宝箱",
            "dialogues": []
        },
        {
            "id": "1102103",
            "objective": "(test)已废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1102104",
            "objective": "继续用「元素视野」寻找古物",
            "dialogues": []
        },
        {
            "id": "1102109",
            "objective": "继续用「元素视野」寻找古物",
            "dialogues": []
        },
        {
            "id": "1102105",
            "objective": "击败幻形兽，回收古物",
            "dialogues": []
        },
        {
            "id": "1102106",
            "objective": "与另一队汇合",
            "dialogues": [
                {
                    "id": "110210601",
                    "speaker": "克列门特",
                    "text": "…你这也叫考古学家？！这也看不出来，那也不认识，你到底行不行啊！"
                },
                {
                    "id": "110210602",
                    "speaker": "宛烟",
                    "text": "术、术业有专攻不是很正常的事吗！我已经很努力地讲解了！"
                },
                {
                    "id": "110210603",
                    "speaker": "派蒙",
                    "text": "别吵架别吵架，到底发生什么了啊？"
                },
                {
                    "id": "110210604",
                    "speaker": "克列门特",
                    "text": "这家伙，口口声声说自己是考古学家，却对这周围的遗迹一窍不通！还没有我懂得多！"
                },
                {
                    "id": "110210605",
                    "speaker": "克列门特",
                    "text": "我只能靠直觉…我是说，经验，带了点好像有价值的东西回来。唉，真是耽误时间！"
                },
                {
                    "id": "110210606",
                    "speaker": "宛烟",
                    "text": "我…我一直都在研究「盐之魔神」，对海里的东西不懂，也很正常吧！",
                    "choices": [
                        {
                            "id": "110210607",
                            "text": "（作为学者，确实有点奇怪…）",
                            "response": [
                                {
                                    "id": "110210609",
                                    "speaker": "宛烟",
                                    "text": "倒是你，一直在问我这个值多少摩拉、那个值多少摩拉！文物的价值难道就是摩拉吗！"
                                },
                                {
                                    "id": "110210610",
                                    "speaker": "克列门特",
                                    "text": "这、这…文物的价值，用摩拉来衡量，不是最直白吗！也很符合璃月的传统吧！"
                                },
                                {
                                    "id": "110210611",
                                    "speaker": "钟离",
                                    "text": "没关系，两位稍安勿躁，我们倒是带回来了一些不错的东西，可以一起看看。"
                                },
                                {
                                    "id": "110210612",
                                    "speaker": "钟离",
                                    "text": "唔…"
                                },
                                {
                                    "id": "110210613",
                                    "speaker": "钟离",
                                    "text": "很遗憾，你们带回来的这些东西，虽然确实是被「漩涡之魔神」带上岸的，可惜都与魔神无关，只是出自附近海域而已。"
                                },
                                {
                                    "id": "110210614",
                                    "speaker": "钟离",
                                    "text": "相比之下，还是我们找到的这块石板，表面有神秘的纹饰，且微存魔神之力，或许会对研究有所帮助。"
                                },
                                {
                                    "id": "110210615",
                                    "speaker": "克列门特",
                                    "text": "快、快把它给我！"
                                },
                                {
                                    "id": "110210616",
                                    "speaker": "克列门特",
                                    "text": "嘿嘿，有了这个，就不算毫无收获了。魔神的力量，哼哼，这个才是好东西啊…"
                                },
                                {
                                    "id": "110210617",
                                    "speaker": "克列门特",
                                    "text": "咳咳，但是，这其他的东西应该也还值几个钱，能收回雇佣顾问的成本——都归我了！"
                                },
                                {
                                    "id": "110210618",
                                    "speaker": "派蒙",
                                    "text": "一定要有魔神的力量残留在上面，才有研究的价值吗？"
                                },
                                {
                                    "id": "110210619",
                                    "speaker": "宛烟",
                                    "text": "不是的，我追寻「盐之魔神」的历史，是因为历史能讲述文化，还有信仰…"
                                },
                                {
                                    "id": "110210620",
                                    "speaker": "宛烟",
                                    "text": "至于你，就只是想借考古的名义发财吧！"
                                },
                                {
                                    "id": "110210621",
                                    "speaker": "克列门特",
                                    "text": "胡说！我是至冬国的专业考古研究员，如假包换！",
                                    "choices": [
                                        {
                                            "id": "110210622",
                                            "text": "（不，就是想借考古的名义发财吧…）",
                                            "response": [
                                                {
                                                    "id": "110210624",
                                                    "speaker": "钟离",
                                                    "text": "哦，对了，那个茶杯，最好别卖掉。"
                                                },
                                                {
                                                    "id": "110210625",
                                                    "speaker": "克列门特",
                                                    "text": "啊？为什么？"
                                                },
                                                {
                                                    "id": "110210626",
                                                    "speaker": "钟离",
                                                    "text": "那不是古代的东西，是凝光的收藏，跟着群玉阁一起掉下来的。如果你不想惹恼七星的话…"
                                                },
                                                {
                                                    "id": "110210627",
                                                    "speaker": "克列门特",
                                                    "text": "呃，我知道了…明明我看成色还不错。"
                                                },
                                                {
                                                    "id": "110210628",
                                                    "speaker": "宛烟",
                                                    "text": "你看，你就是想拿去卖钱！"
                                                },
                                                {
                                                    "id": "110210629",
                                                    "speaker": "克列门特",
                                                    "text": "那、那又怎么样！研究和卖钱，二者兼顾不好吗？脑筋这么死板干什么！"
                                                },
                                                {
                                                    "id": "110210630",
                                                    "speaker": "克列门特",
                                                    "text": "好！接下来就没必要待在这里了。对了，那个「盐之魔神」，我也挺感兴趣，下一站就去「地中之盐」吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110210623",
                                            "text": "（不，是想收集魔神残余的力量吧…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110210608",
                            "text": "（专注一个领域，也不该缺乏通识…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1102107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110210702",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，那就交给你啦，用「元素视野」看一看吧。"
                }
            ]
        }
    ]
}