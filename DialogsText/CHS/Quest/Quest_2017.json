            "dialogues": []
        },
        {
            "id": "201709",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "20170901",
                    "speaker": "神里绫华",
                    "text": "#怎么样{NICKNAME}，计划还顺利吗？",
                    "choices": [
                        {
                            "id": "20170902",
                            "text": "我也不知道…",
                            "response": [
                                {
                                    "id": "20170904",
                                    "speaker": "神里绫华",
                                    "text": "辛苦了，接下来就等早柚的消息吧。"
                                },
                                {
                                    "id": "20170905",
                                    "speaker": "黑屏",
                                    "text": "一段时间后…"
                                },
                                {
                                    "id": "20170906",
                                    "speaker": "早柚",
                                    "text": "呼…呼…"
                                },
                                {
                                    "id": "20170907",
                                    "speaker": "早柚",
                                    "text": "虽然运动有助于长高，但好像有些运动过头了…"
                                },
                                {
                                    "id": "20170908",
                                    "speaker": "早柚",
                                    "text": "晕乎乎的…大家…都在旋转…"
                                },
                                {
                                    "id": "20170909",
                                    "speaker": "早柚",
                                    "text": "不行，睡觉前，好像还有重要的事情…对了，我拿到了哦。"
                                },
                                {
                                    "id": "20170910",
                                    "speaker": "早柚",
                                    "text": "我也不知道你们说的「公文」到底长什么样子，就把所有可疑的东西都偷回来了。"
                                },
                                {
                                    "id": "20170911",
                                    "speaker": "早柚",
                                    "text": "给你们…我要去睡觉了…"
                                },
                                {
                                    "id": "20170912",
                                    "speaker": "托马",
                                    "text": "小姐，这些是…"
                                },
                                {
                                    "id": "20170913",
                                    "speaker": "神里绫华",
                                    "text": "这一卷密封的，应该是天领奉行要呈给将军的「上奏公文」。"
                                },
                                {
                                    "id": "20170914",
                                    "speaker": "神里绫华",
                                    "text": "除此之外，这是…他们与愚人众来往的信件。"
                                },
                                {
                                    "id": "20170915",
                                    "speaker": "神里绫华",
                                    "text": "看来那位八重宫司的判断是正确的。如今稻妻的纷争，确实是他们推波助澜的结果。"
                                },
                                {
                                    "id": "20170916",
                                    "speaker": "神里绫华",
                                    "text": "#{NICKNAME}，这些当证据应该足够了。接下来还请你将它们带给<color=#00E1FFFF>八重宫司</color>，相信她会有接下来的计划。"
                                },
                                {
                                    "id": "20170917",
                                    "speaker": "神里绫华",
                                    "text": "我也会召集人手，争取挖出更多潜伏在稻妻的愚人众。"
                                },
                                {
                                    "id": "20170918",
                                    "speaker": "托马",
                                    "text": "不过，还是要小心将军大人，一想到她之前出刀的样子，我就浑身鸡皮疙瘩。"
                                },
                                {
                                    "id": "20170919",
                                    "speaker": "神里绫华",
                                    "text": "也只能相信八重宫司了。她与将军关系密切，或许会有办法…"
                                },
                                {
                                    "id": "20170920",
                                    "speaker": "派蒙",
