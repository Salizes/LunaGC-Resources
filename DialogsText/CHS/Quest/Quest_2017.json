    "talks": [
        {
            "id": "201701",
            "objective": "前往镇守之森",
            "dialogues": []
        },
        {
            "id": "201702",
            "objective": "找到八重神子所说的帮手",
            "dialogues": [
                {
                    "id": "20170201",
                    "speaker": "派蒙",
                    "text": "狸、狸猫玩偶变成人类了！"
                },
                {
                    "id": "20170202",
                    "speaker": "派蒙",
                    "text": "这是什么，我还是第一次见到！"
                },
                {
                    "id": "20170203",
                    "speaker": "早柚",
                    "text": "不是狸猫…是貉…呼噜…"
                },
                {
                    "id": "20170204",
                    "speaker": "早柚",
                    "text": "好困…睡不饱的话…会长不高的…"
                },
                {
                    "id": "20170205",
                    "speaker": "派蒙",
                    "text": "难道说这位就是八重小姐所说的「专业人士」吗？"
                },
                {
                    "id": "20170206",
                    "speaker": "派蒙",
                    "text": "看上去完全不像呢。"
                },
                {
                    "id": "20170207",
                    "speaker": "八重神子",
                    "text": "呵呵…这位可是「终末番」的成员，是货真价实的「忍者」哦。"
                },
                {
                    "id": "20170208",
                    "speaker": "派蒙",
                    "text": "忍者！那刚刚的，难道就是传说中的替身术？"
                },
                {
                    "id": "20170209",
                    "speaker": "派蒙",
                    "text": "不过，「终末番」又是什么呢？"
                },
                {
                    "id": "20170210",
                    "speaker": "八重神子",
                    "text": "终末番隶属于社奉行，是神里绫人的秘密部队。"
                },
                {
                    "id": "20170211",
                    "speaker": "八重神子",
                    "text": "目前神里绫人和社奉行秉持中立态度，我也无法调动终末番。"
                },
                {
                    "id": "20170212",
                    "speaker": "八重神子",
                    "text": "不过，抓一个常年偷懒的终末番成员过来帮忙，还是可以做到的。"
                },
                {
                    "id": "20170213",
                    "speaker": "早柚",
                    "text": "咕…"
                },
                {
                    "id": "20170214",
                    "speaker": "八重神子",
                    "text": "就是这样，就拜托你们进城，去寻找天领奉行叛变的证据了。"
                },
                {
                    "id": "20170215",
                    "speaker": "八重神子",
                    "text": "毕竟在那样的场合，我不适合露面嘛。"
                },
                {
                    "id": "20170216",
                    "speaker": "派蒙",
                    "text": "就算你这么说…",
                    "choices": [
                        {
                            "id": "20170217",
                            "text": "感觉没什么头绪。",
                            "response": [
                                {
                                    "id": "20170219",
                                    "speaker": "八重神子",
                                    "text": "欸？我还以为你已经想到了呢。好吧，那我就再给你一点点提示。"
                                },
                                {
                                    "id": "20170220",
                                    "speaker": "八重神子",
                                    "text": "对外人来说，想要摸清楚天领奉行的底细确实很难。"
                                },
                                {
                                    "id": "20170221",
                                    "speaker": "八重神子",
                                    "text": "但三奉行共同辅佐将军，关系来往密切，想必其他奉行更容易察觉其中的蹊跷…"
                                },
                                {
                                    "id": "20170222",
                                    "speaker": "Player",
                                    "text": "社奉行！"
                                },
                                {
                                    "id": "20170223",
                                    "speaker": "八重神子",
                                    "text": "呵呵…看来你已经想到了。"
                                },
                                {
                                    "id": "20170224",
                                    "speaker": "八重神子",
                                    "text": "幕府军对你的搜捕，应该还没有结束。不过有这位终末番的忍者相助，相信你可以顺利与朋友再会。"
                                },
                                {
                                    "id": "20170225",
                                    "speaker": "八重神子",
                                    "text": "别忘了在约定的时间之前，把证据带回来哦。"
                                }
                            ]
                        },
                        {
                            "id": "20170218",
                            "text": "证据到底是什么呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201712",
            "objective": "(test)删掉达摩$HIDDEN",
            "dialogues": []
        },
        {
            "id": "201703",
            "objective": "前往木漏茶室",
            "dialogues": []
        },
        {
            "id": "201704",
            "objective": "与托马对话",
            "dialogues": [
                {
                    "id": "20170403",
                    "speaker": "托马",
                    "text": "#{NICKNAME}，你们怎么来了？"
                },
                {
                    "id": "20170404",
                    "speaker": "托马",
                    "text": "见到反抗军了吗？现在战场情况如何？我能从这出去了吗？"
                },
                {
                    "id": "20170405",
                    "speaker": "派蒙",
                    "text": "大概还不行…我们来的时候还看到附近有人在巡逻呢。"
                },
                {
                    "id": "20170406",
                    "speaker": "托马",
                    "text": "看来还没结束啊…这么说来，你们出现在这里，应该是有事要找我们商量吧。"
                },
                {
                    "id": "20170407",
                    "speaker": "托马",
                    "text": "我去找人叫小姐过来，稍等一下。"
                },
                {
                    "id": "20170408",
                    "speaker": "黑屏文字",
                    "text": "将现状告诉了绫华与托马…"
                },
                {
                    "id": "20170409",
                    "speaker": "神里绫华",
                    "text": "原来如此，你们也经历了许多事情呢。"
                },
                {
                    "id": "20170410",
                    "speaker": "神里绫华",
                    "text": "情况我已经了解了，总之是要找到天领奉行叛变的证据，让我想想…"
                },
                {
                    "id": "20170411",
                    "speaker": "神里绫华",
                    "text": "这么说来，确实有一点让我很在意。幕府军与反抗军交战已久，但将军却从未过问此事。"
                },
                {
                    "id": "20170412",
                    "speaker": "神里绫华",
                    "text": "我曾以为将军对此事并不在意，但现在来看，或许是天领奉行给将军的<color=#00E1FFFF>「上奏公文」</color>，从一开始就有问题。"
                },
                {
                    "id": "20170413",
                    "speaker": "派蒙",
                    "text": "绫华的意思是…"
                },
                {
                    "id": "20170414",
                    "speaker": "神里绫华",
                    "text": "天领奉行执掌国内军事事务，如果他们有瞒报的想法，我们也无从得知。"
                },
                {
                    "id": "20170415",
                    "speaker": "神里绫华",
                    "text": "其结果，是将军错估眼狩令的危害，继续一意孤行。如果能拿到天领奉行的上奏公文，一看便知。"
                },
                {
                    "id": "20170416",
                    "speaker": "托马",
                    "text": "可我记得，有权力碰触上奏公文的，只有九条孝行一个人。"
                },
                {
                    "id": "20170417",
                    "speaker": "托马",
                    "text": "而且那里有重兵把守，就算有早柚帮忙，想悄悄拿走公文也是一件难事。"
                },
                {
                    "id": "20170418",
                    "speaker": "神里绫华",
                    "text": "如果有什么东西，能够暂时引开那些守卫就好了。"
                },
                {
                    "id": "20170419",
                    "speaker": "神里绫华",
                    "text": "嗯…",
                    "choices": [
                        {
                            "id": "20170420",
                            "text": "要说吸引注意…",
                            "response": [
                                {
                                    "id": "20170422",
                                    "speaker": "托马",
                                    "text": "宵宫的烟花！"
                                },
                                {
                                    "id": "20170423",
                                    "speaker": "神里绫华",
                                    "text": "果然是托马会提出来的建议呢…"
                                },
                                {
                                    "id": "20170424",
                                    "speaker": "神里绫华",
                                    "text": "倒也不无道理。天领奉行旁边就是千手百眼神像，如果能在神像周围点燃烟花，天领奉行不会不管。"
                                },
                                {
                                    "id": "20170425",
                                    "speaker": "神里绫华",
                                    "text": "到时早柚就可以顺利潜入天领奉行，拿到公文和其他证据…"
                                },
                                {
                                    "id": "20170426",
                                    "speaker": "托马",
                                    "text": "好！我感觉我离自由的日子越来越近了。"
                                },
                                {
                                    "id": "20170427",
                                    "speaker": "托马",
                                    "text": "呼…像这样坐在一起聊天，总感觉已经是好久之前的事情了。"
                                },
                                {
                                    "id": "20170428",
                                    "speaker": "Player",
                                    "text": "好像也没有很久…"
                                },
                                {
                                    "id": "20170429",
                                    "speaker": "托马",
                                    "text": "对我来说已经很久了，我每天都在这里盼着你们啊！"
                                },
                                {
                                    "id": "20170430",
                                    "speaker": "托马",
                                    "text": "以前这里确实是我最喜欢的秘密场所，但这次进来之后，我已经不知道多久没有迈出茶室一步了。"
                                },
                                {
                                    "id": "20170431",
                                    "speaker": "托马",
                                    "text": "可恶，好想去泡温泉啊！"
                                },
                                {
                                    "id": "20170432",
                                    "speaker": "派蒙",
                                    "text": "托马，好可怜…"
                                },
                                {
                                    "id": "20170433",
                                    "speaker": "神里绫华",
                                    "text": "我们还是先解决眼下的问题吧。废除眼狩令之后，托马就自由了。"
                                },
                                {
                                    "id": "20170434",
                                    "speaker": "神里绫华",
                                    "text": "虽然是再度重逢，但没有多少叙旧的时间呢。等一切结束，我们再好好庆祝一番。"
                                },
                                {
                                    "id": "20170435",
                                    "speaker": "托马",
                                    "text": "到时候我们再一起玩火锅游戏好了！"
                                },
                                {
                                    "id": "20170436",
                                    "speaker": "派蒙",
                                    "text": "你还惦记着那个啊！"
                                },
                                {
                                    "id": "20170437",
                                    "speaker": "神里绫华",
                                    "text": "天领奉行附近的守卫很多，你们靠近的时候务必小心。之后我们再在这里碰面吧。"
                                },
                                {
                                    "id": "20170438",
                                    "speaker": "派蒙",
                                    "text": "#那{NICKNAME}，我们就先去<color=#00E1FFFF>花见坂</color>找<color=#00E1FFFF>宵宫</color>吧。"
                                }
                            ]
                        },
                        {
                            "id": "20170421",
                            "text": "好像之前也遇到过…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201710",
            "objective": "前往寻求宵宫的帮助",
            "dialogues": [
                {
                    "id": "20171000",
                    "speaker": "派蒙",
                    "text": "宵宫，我们想要一个特大号烟花！超级超级大的那种！"
                },
                {
                    "id": "20171001",
                    "speaker": "宵宫",
                    "text": "「特大号烟花」？"
                },
                {
                    "id": "20171002",
                    "speaker": "宵宫",
                    "text": "嘿嘿，这你们可就问对人了。"
                },
                {
                    "id": "20171003",
                    "speaker": "宵宫",
                    "text": "其实前两天啊，我正好做出来了一个特别厉害的好东西。"
                },
                {
                    "id": "20171004",
                    "speaker": "宵宫",
                    "text": "不过因为威力太大，一直找不到合适的地方做实验…正好送给你们，让你们帮我看看效果。"
                },
                {
                    "id": "20171005",
                    "speaker": "宵宫",
                    "text": "记住，点着了之后一定要快点跑，别把衣服烧了。还有最好把耳朵也捂住…"
                },
                {
                    "id": "20171006",
                    "speaker": "派蒙",
                    "text": "我，我怎么觉得有点可怕…"
                },
                {
                    "id": "20171007",
                    "speaker": "宵宫",
                    "text": "哈哈哈，没关系的，只是烟花啦，烟花而已。不会有什么问题的！"
                },
                {
                    "id": "20171008",
                    "speaker": "派蒙",
                    "text": "那我们就去试试好了…谢谢你啦，宵宫。"
                }
            ]
        },
        {
            "id": "201705",
            "objective": "等待至半夜（0~5时）",
            "dialogues": []
        },
        {
            "id": "201706",
            "objective": "前往天领奉行府附近指定地点",
            "dialogues": []
        },
        {
            "id": "201707",
            "objective": "与早柚对话",
            "dialogues": [
                {
                    "id": "20170701",
                    "speaker": "早柚",
                    "text": "嗯…和我想的一样…"
                },
                {
                    "id": "20170702",
                    "speaker": "早柚",
                    "text": "好多好多人…被盯上的话…会被发现…"
                },
                {
                    "id": "20170703",
                    "speaker": "早柚",
                    "text": "必须将他们引开，才能顺利潜入…"
                },
                {
                    "id": "20170704",
                    "speaker": "Player",
                    "text": "只能相信宵宫了。"
                },
                {
                    "id": "20170705",
                    "speaker": "早柚",
                    "text": "等我拿到公文，我们再在<color=#00E1FFFF>木漏茶室</color>会合，可以吗？"
                },
                {
                    "id": "20170706",
                    "speaker": "早柚",
                    "text": "还有，如果我被抓了的话…请来救我…"
                },
                {
                    "id": "20170707",
                    "speaker": "派蒙",
                    "text": "真的没问题吗…"
                },
                {
                    "id": "20170708",
                    "speaker": "派蒙",
                    "text": "总、总之我们还是先去<color=#00E1FFFF>千手百眼神像</color>那边吧！要小心不要被巡逻的人发现哦！"
                }
            ]
        },
        {
