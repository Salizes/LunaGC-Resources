            "dialogues": []
        },
        {
            "id": "2006118",
            "objective": "把信件送给莎拉",
            "dialogues": [
                {
                    "id": "200611201",
                    "speaker": "莎拉",
                    "text": "有你的信…"
                },
                {
                    "id": "200611202",
                    "speaker": "莎拉",
                    "text": "咦？怎么是你送来的？"
                },
                {
                    "id": "200611203",
                    "speaker": "莎拉",
                    "text": "我还以为和平时一样，是信鸽直接送到城里呢…"
                },
                {
                    "id": "200611204",
                    "speaker": "莎拉",
                    "text": "不过信送到了就好，谢谢你，麻烦了。"
                }
            ]
        },
        {
            "id": "2006119",
            "objective": "向杜拉夫回报",
            "dialogues": [
                {
                    "id": "200611301",
                    "speaker": "杜拉夫",
                    "text": "关于鸽子…"
                },
                {
                    "id": "200611302",
                    "speaker": "杜拉夫",
                    "text": "真是…没事给自己找事做。"
                },
                {
                    "id": "200611303",
                    "speaker": "杜拉夫",
                    "text": "好了好了，这次就原谅你了，赶紧走吧。"
                }
            ]
        },
        {
            "id": "2006110",
            "objective": "赶走鸽子",
            "dialogues": [
                {
                    "id": "200611001",
                    "speaker": "杜拉夫",
                    "text": "关于鸽子…"
                },
                {
                    "id": "200611002",
                    "speaker": "杜拉夫",
                    "text": "是吗？鸽子们都被丘丘人抓走了啊…"
                },
                {
                    "id": "200611003",
                    "speaker": "Player",
                    "text": "这封信…"
                },
                {
                    "id": "200611004",
                    "speaker": "杜拉夫",
                    "text": "信…谢谢你，这封信确实是我寄的，本来是要寄给蒙德城里的葛瑞丝修女…"
                },
                {
                    "id": "200611005",
                    "speaker": "杜拉夫",
                    "text": "你没看吧？没事，看了也没关系，只是一些陈年旧事而已。"
                },
                {
                    "id": "200611006",
                    "speaker": "杜拉夫",
                    "text": "有些事情，也不可能永远瞒住啊…"
                },
                {
                    "id": "200611007",
                    "speaker": "杜拉夫",
                    "text": "谢谢你把这封信带回来，我过段时间自己送过去吧。这是给你的酬劳，收下吧。"
                },
                {
                    "id": "200611008",
                    "speaker": "杜拉夫",
                    "text": "提米，唉…"
                }
            ]
        },
        {
            "id": "2006111",
            "objective": "调查前方",
            "dialogues": [
                {
                    "id": "200611101",
                    "speaker": "杜拉夫",
                    "text": "怎么感觉，这些鸽子越来越胖了。艾伦到底给它们喂了什么…"
                }
            ]
        },
