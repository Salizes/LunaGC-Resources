    "talks": [
        {
            "id": "2006101",
            "objective": "与杜拉夫对话",
            "dialogues": [
                {
                    "id": "200610101",
                    "speaker": "杜拉夫",
                    "text": "关于鸽子…"
                },
                {
                    "id": "200610102",
                    "speaker": "杜拉夫",
                    "text": "这些鸽子，还不如做下酒菜算了…"
                },
                {
                    "id": "200610103",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "200610104",
                    "speaker": "杜拉夫",
                    "text": "我本来在这里养了一群鸽子，用来给人们送信。"
                },
                {
                    "id": "200610105",
                    "speaker": "杜拉夫",
                    "text": "但是也不知道是为什么，最近这些鸽子们越来越不靠谱。"
                },
                {
                    "id": "200610106",
                    "speaker": "杜拉夫",
                    "text": "不是把信送丢，就是送半天也送不到，停在地上半天不动，非要人赶不可。"
                },
                {
                    "id": "200610111",
                    "speaker": "杜拉夫",
                    "text": "如果你有空的话，就帮我去看看刚放出去的那批鸽子吧。",
                    "choices": [
                        {
                            "id": "200610107",
                            "text": "我明白了。",
                            "response": [
                                {
                                    "id": "200610108",
                                    "speaker": "杜拉夫",
                                    "text": "那就拜托你了，如果看见鸽子们在偷懒，就赶赶它们吧。"
                                }
                            ]
                        },
                        {
                            "id": "200610109",
                            "text": "会被鸽子讨厌的…",
                            "response": [
                                {
                                    "id": "200610110",
                                    "speaker": "杜拉夫",
                                    "text": "没关系，鸽子的记忆很短，过一会就什么都忘记了。"
                                },
                                {
                                    "id": "200610112",
                                    "speaker": "杜拉夫",
                                    "text": "看不出来，你这么喜欢鸽子啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006120",
            "objective": "(test)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2006102",
            "objective": "去树林里找到鸽子群",
            "dialogues": [
                {
                    "id": "200610201",
                    "speaker": "派蒙",
                    "text": "好多鸽子在偷懒，快点去把它们赶起来，让它们乖乖去送信吧！"
                }
            ]
        },
        {
            "id": "2006103",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200610301",
                    "speaker": "派蒙",
                    "text": "这下，这些鸽子们应该就不会偷懒了。"
                }
            ]
        },
        {
            "id": "2006104",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200610401",
                    "speaker": "杜拉夫",
                    "text": "关于鸽子…"
                },
                {
                    "id": "200610402",
                    "speaker": "杜拉夫",
                    "text": "这样子，那些鸽子也许就会乖乖送信了吧…"
                },
                {
                    "id": "200610403",
                    "speaker": "杜拉夫",
                    "text": "但我也不能跟着看，不过总之先这样吧。"
                },
                {
                    "id": "200610404",
                    "speaker": "杜拉夫",
                    "text": "辛苦你了，这是答谢，以后要寄信的话就过来打个招呼吧。"
                }
            ]
        },
        {
            "id": "2006105",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200610501",
                    "speaker": "杜拉夫",
                    "text": "关于鸽子…"
                },
                {
                    "id": "200610502",
                    "speaker": "杜拉夫",
                    "text": "喂！你做了什么，这些鸽子都是用来寄信的！"
                },
                {
                    "id": "200610503",
                    "speaker": "杜拉夫",
                    "text": "真是的，你到底哪根脑筋不对了…我这里还有很多信要寄啊！",
                    "choices": [
                        {
                            "id": "200610504",
                            "text": "抱歉…",
                            "response": [
                                {
                                    "id": "200610505",
                                    "speaker": "杜拉夫",
                                    "text": "光道歉起作用的话，那要西风骑士团做什么？！"
                                },
                                {
                                    "id": "200610508",
                                    "speaker": "杜拉夫",
                                    "text": "犯错了就要有惩罚，你就代替鸽子们把信送过去吧。"
                                }
                            ]
                        },
                        {
                            "id": "200610506",
                            "text": "赶鸽子太用力了…",
                            "response": [
                                {
                                    "id": "200610507",
                                    "speaker": "杜拉夫",
                                    "text": "赶鸽子？你是拿着锅铲去赶的吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006106",
            "objective": "赶走鸽子",
            "dialogues": [
                {
                    "id": "200610601",
                    "speaker": "派蒙",
                    "text": "鸽子不见了，奇怪，刚才还看见的…"
                }
            ]
        },
        {
            "id": "2006107",
            "objective": "赶走鸽子",
            "dialogues": [
                {
                    "id": "200610701",
                    "speaker": "派蒙",
                    "text": "那群丘丘人围着的锅里好像煮着什么，旁边还堆着一堆肉…"
                }
            ]
        },
        {
            "id": "2006108",
            "objective": "赶走鸽子",
            "dialogues": [
                {
                    "id": "200610801",
                    "speaker": "派蒙",
                    "text": "咦？这是…一封信？"
                },
                {
                    "id": "200610802",
                    "speaker": "派蒙",
                    "text": "糟了，一定是哪只鸽子正在送出去的信。"
                },
                {
                    "id": "200610803",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，快点看看是谁寄的，说不定我们能帮帮忙呢。"
                }
            ]
        },
        {
            "id": "2006109",
            "objective": "向杜拉夫回报",
            "dialogues": []
        },
        {
