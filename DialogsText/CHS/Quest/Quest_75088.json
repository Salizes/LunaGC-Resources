    "talks": [
        {
            "id": "7508803",
            "objective": "test 初见$HIDDEN",
            "dialogues": [
                {
                    "id": "750880301",
                    "speaker": "秋纽奥",
                    "text": "嗯，如果有足够多的样本的话，说不定…"
                },
                {
                    "id": "750880302",
                    "speaker": "派蒙",
                    "text": "哦，这里有个奇怪的家伙在嘀嘀咕咕的…"
                },
                {
                    "id": "750880303",
                    "speaker": "秋纽奥",
                    "text": "像我这样的人在纳塔到处都是，奇怪的反而是你们哦…如果没什么事就不要打扰我做研究啦。"
                },
                {
                    "id": "750880304",
                    "speaker": "秋纽奥",
                    "text": "我这个月的支出超出了预计的额度，只能靠解决协会里悬赏的研究问题来补贴一番。"
                },
                {
                    "id": "750880305",
                    "speaker": "派蒙",
                    "text": "原来做研究还有钱拿呀…"
                },
                {
                    "id": "750880306",
                    "speaker": "秋纽奥",
                    "text": "是呀，「龙遗物研究协会」就是这样的组织，有奖赏，才能促进大伙研究各种课题嘛。"
                },
                {
                    "id": "750880307",
                    "speaker": "秋纽奥",
                    "text": "这次我就要挑战「镌光铭印」的破译…据说这是没有人完成的伟业，能得到的摩拉也有很多…"
                },
                {
                    "id": "750880308",
                    "speaker": "秋纽奥",
                    "text": "不过…"
                },
                {
                    "id": "750880309",
                    "speaker": "派蒙",
                    "text": "不过什么呀？"
                },
                {
                    "id": "750880310",
                    "speaker": "秋纽奥",
                    "text": "如果要破译「镌光铭印」，首先就得有足够多的「镌光铭印」碎片才行。"
                },
                {
                    "id": "750880311",
                    "speaker": "秋纽奥",
                    "text": "…嗯，这样吧，如果你们能够找来「镌光铭印」的碎片的话，我就给你们报酬，如何？"
                },
                {
                    "id": "750880312",
                    "speaker": "秋纽奥",
                    "text": "看上去你们是经验丰富的冒险家嘛，应该经常接到这样的委托吧。"
                },
                {
                    "id": "750880313",
                    "speaker": "派蒙",
                    "text": "倒也不是不行啦，不过你这个月的支出不是已经超额了嘛…"
                },
                {
                    "id": "750880314",
                    "speaker": "秋纽奥",
                    "text": "既然已经超额了，多超少超根本不是问题…只要拿到「镌光铭印」的碎片，破译其中的内容，多少摩拉都能有！",
                    "choices": [
                        {
                            "id": "750880315",
                            "text": "我们只负责找碎片…",
                            "response": [
                                {
                                    "id": "750880317",
                                    "speaker": "秋纽奥",
                                    "text": "你们只要保证能够拿到「真货」就好，说起来就来气，这个月有贩子卖给我的秘源遗迹物件根本就是伪造的。"
                                },
                                {
                                    "id": "750880318",
                                    "speaker": "秋纽奥",
                                    "text": "坑了我好大一笔摩拉…"
                                },
                                {
                                    "id": "750880319",
                                    "speaker": "派蒙",
                                    "text": "啊，原来是因为这样才超支的…"
                                },
                                {
                                    "id": "750880320",
                                    "speaker": "秋纽奥",
                                    "text": "所以，就要用「镌光铭印」的碎片打个翻身仗！"
                                },
                                {
                                    "id": "750880321",
                                    "speaker": "秋纽奥",
                                    "text": "拜托了，寻找碎片就拜托给你们了！如果找到了请一定要带到我这儿来！"
                                },
                                {
                                    "id": "750880322",
                                    "speaker": "秋纽奥",
                                    "text": "呃，倒也不用太多，就…三，不，四个吧！多的我就实在付不起酬劳了。"
                                }
                            ]
                        },
                        {
                            "id": "750880316",
                            "text": "不保证碎片一定有用哦…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508801",
            "objective": "test 收集碎片$HIDDEN",
            "dialogues": [
                {
                    "id": "750880101",
                    "speaker": "秋纽奥",
                    "text": "怎么样，你们找到「镌光铭印」的碎片了吗…"
                }
            ]
        },
        {
            "id": "7508802",
            "objective": "test 交付成功$HIDDEN",
            "dialogues": [
                {
                    "id": "750880201",
                    "speaker": "秋纽奥",
                    "text": "哈哈，了不起，这下我一定能够破译「镌光铭印」上的这些金纹…悬赏，悬赏一定是我的了！"
                },
                {
                    "id": "750880202",
                    "speaker": "秋纽奥",
                    "text": "不如说如果这次也失败，那就彻底没有经费了，生死成败在此一举！"
                },
                {
                    "id": "750880203",
                    "speaker": "秋纽奥",
                    "text": "啊，对了，这是给你们的酬劳。"
                }
            ]
        },
        {
            "id": "7508804",
            "objective": "test 闲置$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7508806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750880601",
                    "speaker": "秋纽奥",
                    "text": "哎呀，是你呀，多谢你带来的「镌光铭印」的碎片。"
                },
                {
                    "id": "750880602",
                    "speaker": "秋纽奥",
                    "text": "不过破译的进度有些堪忧，看上去跟燃素刻录差不多，但是果然比想象中复杂太多了…"
                },
                {
                    "id": "750880603",
                    "speaker": "秋纽奥",
                    "text": "已经没有退路了，我一定得破译成功才行啊，哈哈！"
                }
            ]
        }
    ]
