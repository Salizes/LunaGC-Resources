    },
    "talks": [
        {
            "id": "7217401",
            "objective": "与引渡人对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "721740101",
                    "speaker": "「船工」",
                    "text": "小河这边唉…银的柏树唉，银的艾草地哟，银的石头…",
                    "choices": [
                        {
                            "id": "721740102",
                            "text": "请问…",
                            "response": [
                                {
                                    "id": "721740104",
                                    "speaker": "「船工」",
                                    "text": "哟…是客人来了？要登船吗？"
                                },
                                {
                                    "id": "721740105",
                                    "speaker": "「船工」",
                                    "text": "唉呀呀，仔细一看却是外人…可不行呢，可不行哟…",
                                    "choices": [
                                        {
                                            "id": "721740106",
                                            "text": "不行…？",
                                            "response": [
                                                {
                                                    "id": "721740108",
                                                    "speaker": "「船工」",
                                                    "text": "往月亮去的银璨璨的船呀，不是为你预备的哟…不要把脚踏上来，不要弄脏我的帆…"
                                                },
                                                {
                                                    "id": "721740109",
                                                    "speaker": "「船工」",
                                                    "text": "唉呀呀…雾散久矣，雾散久矣…谁还没有上船呀…金色屋子的女主人会生气的呀…"
                                                },
                                                {
                                                    "id": "721740110",
                                                    "speaker": "Player",
                                                    "text": "船…？在哪里？"
                                                },
                                                {
                                                    "id": "721740111",
                                                    "speaker": "「船工」",
                                                    "text": "呵呵…银璨璨的船呀，太阳与山之子孙的船呀，大家要回家了，月亮上金灿灿大屋哟…"
                                                },
                                                {
                                                    "id": "721740112",
                                                    "speaker": "「船工」",
                                                    "text": "可是呀可是…有的孩子迷了路，到现在还没有上船…女主人会生气的，可了不得哟…",
                                                    "choices": [
                                                        {
                                                            "id": "721740113",
                                                            "text": "你需要帮助吗？",
                                                            "response": [
                                                                {
                                                                    "id": "721740115",
                                                                    "speaker": "「船工」",
                                                                    "text": "快来登船呀，快来登船…不要再迷途了呀，不要再留恋哟…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721740114",
                                                            "text": "你在听我说话吗…？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721740107",
                                            "text": "你在说什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721740103",
                            "text": "你是谁？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217402",
            "objective": "完成所有执念灵心愿（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "721740201",
                    "speaker": "「船工」",
                    "text": "呵呵…我看到了…一个老奶奶正惦记小孙孙呢，不放下心哟，上不了船唉…"
                }
            ]
        },
        {
            "id": "7217403",
            "objective": "与引渡人对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "721741001",
                    "speaker": "「船工」",
                    "text": "都来了呀…大家都来了哟…"
                },
                {
                    "id": "721741002",
                    "speaker": "「船工」",
                    "text": "谢谢你…岛外来的人哟…终于要起航了呀…"
                },
                {
                    "id": "721741003",
                    "speaker": "「船工」",
                    "text": "河的那边哟…金的橡树哟…金的艾草地哟…金的石头…"
                },
                {
                    "id": "721741004",
                    "speaker": "「船工」",
                    "text": "美好的风景哟…望不到头唉…"
                }
            ]
        },
        {
            "id": "7217404",
            "objective": "",
            "dialogues": [
                {
                    "id": "721740401",
                    "speaker": "「船工」",
                    "text": "哎哟哟…身体长得太快太快，却有个小孩子的魂灵儿…贪玩可笑哟，忘了登船…"
                }
            ]
        },
        {
            "id": "7217403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721740301",
                    "speaker": "「船工」",
                    "text": "我看到…乖乖的小娃娃哟，还在牵挂着老奶奶…惹人怜惜唉，登不上船…"
                }
            ]
        },
        {
            "id": "7217405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721740501",
                    "speaker": "「船工」",
                    "text": "银璨璨的月亮哟，银璨璨的心唉…看护迷雾之野的人呀，也该走出迷林了哟…该上船了，该上船了呀…"
                }
            ]
        },
        {
            "id": "7217406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721740601",
                    "speaker": "「船工」",
                    "text": "依然执迷大地上新奇事物的老人哟，我们归去吧，我们归去哟…金色屋子唉，在月亮上哟…"
                }
            ]
        },
        {
            "id": "7217407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721740701",
                    "speaker": "「船工」",
                    "text": "捡拾海螺的孩子哟…快来上船呀…兄长离弃了祖辈的灵，选择了海那边的归宿，快快忘记他呀…忘记分离的苦哟…"
                }
            ]
        },
        {
            "id": "7217408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721740801",
                    "speaker": "「船工」",
                    "text": "逡巡岸边的孩子呀…你又遗失了什么呢…快快上船来吧，莫要留恋哟…"
                }
            ]
        },
        {
            "id": "7217411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721741101",
                    "speaker": "「船工」",
                    "text": "孤零零的孩子哟…你在与谁玩耍呢？快快来登船吧…去往不再孤单的家园…"
                }
            ]
        }
    ]
}