            "韦吕": 11
        }
    },
    "talks": [
        {
            "id": "2400401",
            "objective": "询问地面上的两兄弟",
            "dialogues": [
                {
                    "id": "240040101",
                    "speaker": "韦吕",
                    "text": "哥哥！我们藏到那边去，肯定比她选的位置好！"
                },
                {
                    "id": "240040102",
                    "speaker": "奥雷勒",
                    "text": "别乱跑，韦吕！要是你跑丢了，我可没办法马上把你找回来！",
                    "choices": [
                        {
                            "id": "240040103",
                            "text": "你怎么在这？",
                            "response": [
                                {
                                    "id": "240040105",
                                    "speaker": "韦吕",
                                    "text": "#哇！{M#大哥哥}{F#大姐姐}！你有空吗？快和我们一起藏起来，洛薇估计早就藏好啦！"
                                },
                                {
                                    "id": "240040106",
                                    "speaker": "Player",
                                    "text": "关于洛薇…"
                                },
                                {
                                    "id": "240040107",
                                    "speaker": "韦吕",
                                    "text": "来不及说了，快点快点，她可熟悉这里了…我们得找个更好的地方藏起来！"
                                },
                                {
                                    "id": "240040108",
                                    "speaker": "Black Screen",
                                    "text": "韦吕飞快地离开了…"
                                },
                                {
                                    "id": "240040109",
                                    "speaker": "奥雷勒",
                                    "text": "唉，韦吕这家伙…什么时候能听点话…"
                                },
                                {
                                    "id": "240040110",
                                    "speaker": "奥雷勒",
                                    "text": "抱歉，只能麻烦您再陪我们玩一场了，韦吕不知道为什么，突然这么兴奋…",
                                    "choices": [
                                        {
                                            "id": "240040111",
                                            "text": "也许是因为找到新玩伴了。",
                                            "response": [
                                                {
                                                    "id": "240040112",
                                                    "speaker": "奥雷勒",
                                                    "text": "我也这么想。但无论如何，只要韦吕玩得开心就好。"
                                                },
                                                {
                                                    "id": "240040113",
                                                    "speaker": "奥雷勒",
                                                    "text": "不过…这家伙也太兴奋了，不会跟洛薇跑去什么奇怪的地方躲着吧…"
                                                },
                                                {
                                                    "id": "240040118",
                                                    "speaker": "奥雷勒",
                                                    "text": "#{M#大哥哥}{F#大姐姐}，那就只能拜托你再陪我们玩一次了，麻烦了。"
                                                },
                                                {
                                                    "id": "240040119",
                                                    "speaker": "奥雷勒",
                                                    "text": "那我也得快点去找个位置藏着，不然韦吕可要不高兴了，要是他当街哭起来，我可就彻底没办法了…"
                                                },
                                                {
                                                    "id": "240040120",
                                                    "speaker": "Black Screen",
                                                    "text": "奥雷勒离开了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240040114",
                                            "text": "关于洛薇…",
                                            "response": [
                                                {
                                                    "id": "240040115",
                                                    "speaker": "奥雷勒",
                                                    "text": "是我们刚认识的一个女生。看我们在玩捉迷藏，也吵着要来玩。"
                                                },
                                                {
                                                    "id": "240040116",
                                                    "speaker": "奥雷勒",
                                                    "text": "她的性格和韦吕差不多，所以这两个人很玩得来。"
                                                },
                                                {
                                                    "id": "240040117",
                                                    "speaker": "奥雷勒",
                                                    "text": "而且…她的父亲似乎也没什么时间陪她玩，这倒是和我们两个差不多。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240040104",
                            "text": "你们还在玩捉迷藏？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400402",
            "objective": "找到所有躲起来的孩子",
            "dialogues": [
                {
                    "id": "240040201",
                    "speaker": "奥雷勒",
                    "text": "…这一页我应该已经看过了。",
                    "choices": [
                        {
                            "id": "240040202",
                            "text": "你在…看书？",
                            "response": [
                                {
                                    "id": "240040204",
                                    "speaker": "奥雷勒",
                                    "text": "#没想到{M#大哥哥}{F#大姐姐}这么快就来了，我才刚翻开这本书呢。"
                                },
                                {
                                    "id": "240040205",
                                    "speaker": "奥雷勒",
                                    "text": "这本书是洛薇的爸爸特意让她带给我的，还说我有什么不懂的地方可以去问他。"
                                },
                                {
                                    "id": "240040206",
                                    "speaker": "奥雷勒",
                                    "text": "但是…呵呵，说实话这本书我几乎没有看得懂的地方啊…"
                                },
                                {
                                    "id": "240040207",
                                    "speaker": "奥雷勒",
                                    "text": "先不说这些，我先回去集合点了，毕竟我已经被你找到了，玩游戏就得遵守规则。"
                                }
                            ]
                        },
                        {
                            "id": "240040203",
                            "text": "你还真是时刻不忘学习…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400403",
            "objective": "找到所有躲起来的孩子",
            "dialogues": [
                {
                    "id": "240040301",
                    "speaker": "韦吕",
                    "text": "#呜哇！{M#大哥哥}{F#大姐姐}找得好快！我刚准备换个地方藏呢…"
                },
                {
                    "id": "240040302",
                    "speaker": "韦吕",
                    "text": "唉，这下我只能回集合点去了…"
                }
            ]
        },
        {
            "id": "2400404",
            "objective": "找到所有躲起来的孩子",
            "dialogues": [
                {
                    "id": "240040401",
                    "speaker": "洛薇",
                    "text": "#好吧…还是被你找…咦？{M#大哥哥}{F#大姐姐}，你是谁呀？"
                },
                {
                    "id": "240040402",
                    "speaker": "Player",
                    "text": "是奥雷勒和韦吕的朋友啦。"
                },
                {
                    "id": "240040403",
                    "speaker": "洛薇",
                    "text": "喔！我听他们提起过你，韦吕说你可擅长玩捉迷藏了。"
                },
                {
                    "id": "240040404",
                    "speaker": "洛薇",
                    "text": "#今天我可算是见识到啦，{M#大哥哥}{F#大姐姐}果然很厉害啊。"
                },
                {
                    "id": "240040405",
                    "speaker": "洛薇",
                    "text": "认输认输，我去集合点等着啦。"
                }
            ]
        },
        {
            "id": "2400405",
            "objective": "",
            "dialogues": [
                {
                    "id": "240040501",
                    "speaker": "奥雷勒",
                    "text": "你们两个…为什么这样看着我？"
                },
                {
                    "id": "240040502",
                    "speaker": "韦吕",
                    "text": "哥…你不会又是躲在哪里偷偷看书了吧？没有认真陪我们玩！"
                },
                {
                    "id": "240040503",
                    "speaker": "洛薇",
                    "text": "对啊，好不容易玩次游戏，认真点啦！"
                },
                {
                    "id": "240040504",
                    "speaker": "奥雷勒",
                    "text": "好位置都被你们占着了，我又不擅长捉迷藏…可不就只能看看书打发时间了吗…"
                },
                {
                    "id": "240040505",
                    "speaker": "韦吕",
                    "text": "嘁！哥哥骗人！"
                },
                {
                    "id": "240040506",
                    "speaker": "洛薇",
                    "text": "哼！就爱看书！"
                },
                {
                    "id": "240040507",
                    "speaker": "奥雷勒",
                    "text": "你们就饶了我吧…",
                    "choices": [
                        {
                            "id": "240040508",
                            "text": "你们就饶了他吧。",
                            "response": [
                                {
                                    "id": "240040510",
                                    "speaker": "韦吕",
                                    "text": "嘿嘿，洛薇可擅长玩捉迷藏了，还知道很多有趣的地方可以藏。"
                                },
                                {
                                    "id": "240040517",
                                    "speaker": "韦吕",
                                    "text": "嘿嘿嘿，有洛薇陪着玩，这里也挺有意思的嘛！"
                                },
                                {
                                    "id": "240040511",
                                    "speaker": "洛薇",
                                    "text": "韦吕的爬起墙来可快了，力气还很大，有好多地方都是他拉我上去的。"
                                },
                                {
                                    "id": "240040512",
                                    "speaker": "洛薇",
                                    "text": "#只要我们俩一起走，除了{M#大哥哥}{F#大姐姐}之外的一般人可找不到我们！"
                                },
                                {
                                    "id": "240040513",
                                    "speaker": "奥雷勒",
                                    "text": "好啦，你们玩得也差不多了。洛薇，我们先送你回家吧。"
                                },
                                {
                                    "id": "240040514",
                                    "speaker": "洛薇",
                                    "text": "然后…你还要再顺便去和我爸讨论问题，对吧？"
                                },
                                {
                                    "id": "240040515",
                                    "speaker": "奥雷勒",
                                    "text": "我，我确实有几个地方弄不明白，得向叔叔请教…"
                                },
                                {
                                    "id": "240040516",
                                    "speaker": "洛薇",
                                    "text": "好啦，我爸现在肯定在家，我们快回去吧。我妈妈上次还说要留你们吃晚饭呢…"
                                }
                            ]
                        },
                        {
                            "id": "240040509",
                            "text": "你们俩不是挺开心的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400406",
            "objective": "与洛薇对话",
            "dialogues": []
        },
        {
            "id": "2400406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240040601",
                    "speaker": "洛薇",
                    "text": "#又被{M#大哥哥}{F#大姐姐}找到了…"
                },
                {
                    "id": "240040602",
                    "speaker": "洛薇",
                    "text": "#韦吕说得没错，{M#大哥哥}{F#大姐姐}果然不是一般人啊…"
                },
                {
                    "id": "240040603",
                    "speaker": "洛薇",
                    "text": "认输认输，我去集合点等着啦。"
                }
            ]
        },
        {
            "id": "2400499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240049901",
                    "speaker": "奥雷勒",
                    "text": "这一页讲的是…"
                },
                {
                    "id": "240049902",
                    "speaker": "韦吕",
                    "text": "找不到我…"
                },
                {
                    "id": "240049903",
                    "speaker": "洛薇",
                    "text": "哼，肯定抓不住我。"
                },
                {
                    "id": "240049904",
                    "speaker": "韦吕",
                    "text": "嘿嘿，这里肯定不会被发现…"
                },
                {
                    "id": "240049905",
                    "speaker": "洛薇",
                    "text": "肯定没问题…"
                }
            ]
        }
    ]
}