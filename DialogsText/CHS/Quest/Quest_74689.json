    "talks": [
        {
            "id": "7468901",
            "objective": "与妮内特对话",
            "dialogues": [
                {
                    "id": "746890101",
                    "speaker": "妮内特",
                    "text": "#（…是{M#他们}{F#她们}吗…师父说的…金发的旅人和会飞的白色精灵…）"
                },
                {
                    "id": "746890102",
                    "speaker": "派蒙",
                    "text": "嗯？你一直盯着我们看，还嘀嘀咕咕的，难道我们脸上有什么奇怪的东西吗？"
                },
                {
                    "id": "746890103",
                    "speaker": "妮内特",
                    "text": "呀！对、对不起！我不是故意的！我只是…只是觉得…",
                    "choices": [
                        {
                            "id": "746890104",
                            "text": "别紧张，慢慢说。",
                            "response": [
                                {
                                    "id": "746890106",
                                    "speaker": "妮内特",
                                    "text": "#嗯…我叫妮内特，我的师父是乐平波琳。她、她提过您，说您是…传奇的冒险家{NICKNAME}，身边还有最好的伙伴派蒙！"
                                },
                                {
                                    "id": "746890107",
                                    "speaker": "妮内特",
                                    "text": "我、我没想到真的能见到你们…"
                                },
                                {
                                    "id": "746890108",
                                    "speaker": "派蒙",
                                    "text": "哦！原来是乐平波琳的徒弟啊！看来她最近事业发展得不错嘛。"
                                },
                                {
                                    "id": "746890109",
                                    "speaker": "妮内特",
                                    "text": "嗯！而且，多亏了师父，我才能从人生低谷里爬起来。"
                                },
                                {
                                    "id": "746890110",
                                    "speaker": "Player",
                                    "text": "发生什么事了？"
                                },
                                {
                                    "id": "746890111",
                                    "speaker": "妮内特",
                                    "text": "我原本是跟着另一位老师学习摄影的。"
                                },
                                {
                                    "id": "746890112",
                                    "speaker": "妮内特",
                                    "text": "为了能成为独当一面的摄影师，我把所有积蓄都投了进去，买了一整套当时最昂贵的留影设备。"
                                },
                                {
                                    "id": "746890113",
                                    "speaker": "妮内特",
                                    "text": "我的技术，老师也说还不错…我以为，只要拍出好画片，就一定能赚到钱的。"
                                },
                                {
                                    "id": "746890114",
                                    "speaker": "妮内特",
                                    "text": "可是…可是我一到街上，看到路人，就紧张得一个字都说不出来。"
                                },
                                {
                                    "id": "746890115",
                                    "speaker": "妮内特",
                                    "text": "想问一句「您好，需要留影吗？」，话就在嘴边打转，怎么也开不了口。"
                                },
                                {
                                    "id": "746890116",
                                    "speaker": "妮内特",
                                    "text": "结果，客人们全都跑去找那些能说会道、热情招揽的摄影师了。"
                                },
                                {
                                    "id": "746890117",
                                    "speaker": "妮内特",
                                    "text": "后来，我连摩拉都快花光了，甚至都准备把心爱的留影机卖掉换点生活费了…"
                                },
                                {
                                    "id": "746890118",
                                    "speaker": "Player",
                                    "text": "真是不容易啊。"
                                },
                                {
                                    "id": "746890119",
                                    "speaker": "妮内特",
                                    "text": "就在那个时候，我遇到了乐平波琳师父。"
                                },
                                {
                                    "id": "746890120",
                                    "speaker": "妮内特",
                                    "text": "她看到我的设备和画片之后，鼓励了我，还让我跟着她帮忙测试新镜头。"
                                },
                                {
                                    "id": "746890121",
                                    "speaker": "妮内特",
                                    "text": "她说…她说我拍出的画片里，有一种别人没有的安静和温柔。"
                                },
                                {
                                    "id": "746890122",
                                    "speaker": "妮内特",
                                    "text": "所以！当师父成功研发出这款「瞬影」镜头时，我比谁都高兴！"
                                },
                                {
                                    "id": "746890123",
                                    "speaker": "派蒙",
                                    "text": "「瞬影」镜头？这是做什么用的？"
                                },
                                {
                                    "id": "746890124",
                                    "speaker": "妮内特",
                                    "text": "它能清晰地捕捉到高速运动中的人物姿态和神韵！"
                                },
                                {
                                    "id": "746890125",
                                    "speaker": "妮内特",
                                    "text": "不过…它目前还处在最终测试阶段，需要大量的实际拍摄来收集数据，验证性能。"
                                },
                                {
                                    "id": "746890126",
                                    "speaker": "妮内特",
                                    "text": "师父最近分不开身，就把这个任务交给了我。我本来想着，可以去招募一些临时测试员来帮忙…"
                                },
                                {
                                    "id": "746890127",
                                    "speaker": "妮内特",
                                    "text": "可是…可是我又犯了老毛病。每次主动去跟陌生人搭话，我就会紧张得语无伦次…"
                                },
                                {
                                    "id": "746890128",
                                    "speaker": "妮内特",
                                    "text": "结果他们都用疑惑的眼神看着我，大概是把我当成什么可疑的人了…好几天过去了，还是没有一个人愿意帮我。"
                                },
                                {
                                    "id": "746890129",
                                    "speaker": "妮内特",
                                    "text": "呜…我连这么简单的事情都办不好，我真是太没用了…"
                                },
                                {
                                    "id": "746890130",
                                    "speaker": "派蒙",
                                    "text": "欸，别哭啊！这也不能怪你嘛！"
                                },
                                {
                                    "id": "746890131",
                                    "speaker": "派蒙",
                                    "text": "突然跑去拜托陌生人帮忙，对很多人来说都是个挑战啦。",
                                    "choices": [
                                        {
                                            "id": "746890132",
                                            "text": "别自责了，你已经很努力了。",
                                            "response": [
                                                {
                                                    "id": "746890134",
                                                    "speaker": "派蒙",
                                                    "text": "#对啊！{NICKNAME}的拍摄技术可好了，而且，{M#他}{F#她}的朋友遍布整个大陆，找人留影这事肯定没问题！"
                                                },
                                                {
                                                    "id": "746890135",
                                                    "speaker": "妮内特",
                                                    "text": "真、真的吗？您…您愿意帮我？"
                                                },
                                                {
                                                    "id": "746890136",
                                                    "speaker": "妮内特",
                                                    "text": "#呜哇——！真的、真的太感谢您了！{NICKNAME}大人！"
                                                },
                                                {
                                                    "id": "746890137",
                                                    "speaker": "妮内特",
                                                    "text": "这台搭载了「瞬影」镜头的特制留影机就拜托您了！"
                                                },
                                                {
                                                    "id": "746890138",
                                                    "speaker": "妮内特",
                                                    "text": "请用它记录下您那些朋友们最生动、最独特的瞬间吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746890133",
                                            "text": "这件事，或许我们可以帮忙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746890105",
                            "text": "我们认识吗？"
                        }
                    ]
                }
            ]
        }
    ]
}