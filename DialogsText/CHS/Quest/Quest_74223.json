            "dialogues": [
                {
                    "id": "742230401",
                    "speaker": "韦尼尔",
                    "text": "没想到…竟然是用这种方式解决吗？"
                },
                {
                    "id": "742230402",
                    "speaker": "韦尼尔",
                    "text": "实在是太厉害了，你该不会之前有在神王的军团里服役过吧？"
                },
                {
                    "id": "742230403",
                    "speaker": "无名的石像",
                    "text": "…………"
                },
                {
                    "id": "742230404",
                    "speaker": "韦尼尔",
                    "text": "长官对你的表现也赞赏有加呢，看来我还是得勤加练习啊！"
                }
