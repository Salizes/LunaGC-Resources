        },
        {
            "id": "7422302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "742230201",
                    "speaker": "韦尼尔",
                    "text": "一百三十六…好，再来十四次，就可以休息了！"
                },
                {
                    "id": "742230202",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "742230203",
                    "speaker": "韦尼尔",
                    "text": "帮忙？不不，不用，哪有锻炼还需要别人帮忙的道理。"
                },
                {
                    "id": "742230204",
                    "speaker": "韦尼尔",
                    "text": "只有锻炼出强悍的体魄，才能像这位长官一样，加入不朽军团成为一名荣耀的士兵啊！"
                },
                {
                    "id": "742230205",
                    "speaker": "无名的石像",
                    "text": "…………"
                },
                {
                    "id": "742230206",
                    "speaker": "韦尼尔",
                    "text": "忘了介绍了，这位是我的教官。只有经过了他的考核，才能有获得擢升的资格。",
                    "choices": [
                        {
                            "id": "742230207",
                            "text": "这不是个雕像？",
                            "response": [
                                {
                                    "id": "742230208",
                                    "speaker": "韦尼尔",
                                    "text": "你在说什么呢，公民？雷穆利亚人不都长成这个样子吗？"
                                },
                                {
                                    "id": "742230209",
                                    "speaker": "韦尼尔",
                                    "text": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。"
                                },
                                {
                                    "id": "742230213",
                                    "speaker": "韦尼尔",
                                    "text": "可别小看这些石柱，我锻炼了这么久也才勉强能一拳打碎一个呢。"
                                }
                            ]
                        },
                        {
                            "id": "742230210",
                            "text": "考核？什么考核？",
                            "response": [
                                {
                                    "id": "742230211",
                                    "speaker": "韦尼尔",
                                    "text": "当然是战斗的考核，就算擢升后能获得不朽的身躯，战斗的技能也是要通过自己的锻炼才能习得的。"
                                },
                                {
                                    "id": "742230212",
                                    "speaker": "韦尼尔",
                                    "text": "怎么样，你要试试吗，只要能同时打碎这些石柱，就算是通过初步的考核了。"
                                }
                            ]
                        }
                    ]
                }
            ]
