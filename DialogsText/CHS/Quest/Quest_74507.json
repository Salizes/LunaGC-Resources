    "talks": [
        {
            "id": "7450701",
            "objective": "前往蕈兽出没的位置调查",
            "dialogues": [
                {
                    "id": "745070101",
                    "speaker": "派蒙",
                    "text": "咦？难道是我眼花了吗？"
                },
                {
                    "id": "745070102",
                    "speaker": "派蒙",
                    "text": "刚才，前边飘过去的好像是…一只蕈兽？难道有蕈兽入侵枫丹了？"
                },
                {
                    "id": "745070103",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们快跟过去看看吧！"
                }
            ]
        },
        {
            "id": "7450702",
            "objective": "与摊位旁的两人对话",
            "dialogues": [
                {
                    "id": "745070201",
                    "speaker": "蒂蕾娜",
                    "text": "多谢配合，资质审查已完成，你的伙伴们也都很安全，不会对枫丹市民和生态环境造成任何威胁。"
                },
                {
                    "id": "745070202",
                    "speaker": "蒂蕾娜",
                    "text": "根据《枫丹外来物种管理法》与《利奥奈区商业行为规范》，你可以继续举办活动了。"
                },
                {
                    "id": "745070203",
                    "speaker": "？？？",
                    "text": "有劳你了，蒂蕾娜小姐。"
                },
                {
                    "id": "745070204",
                    "speaker": "？？？",
                    "text": "没想到在枫丹举办活动的流程居然这么复杂，比在奥摩斯港多出十来个环节，看来我之前做的准备还不够啊…"
                },
                {
                    "id": "745070205",
                    "speaker": "蒂蕾娜",
                    "text": "不用客气，更不必自责，你和你的蕈兽伙伴属于特别的来客。"
                },
                {
                    "id": "745070206",
                    "speaker": "蒂蕾娜",
                    "text": "执律庭很少接触蕈兽这一外来物种，有必要谨慎行事，所以花了不少时间来观察和评估。"
                },
                {
                    "id": "745070207",
                    "speaker": "蒂蕾娜",
                    "text": "接下来，我会将你的委托转达给其他警备队员。"
                },
                {
                    "id": "745070208",
                    "speaker": "蒂蕾娜",
                    "text": "#如果见到了传说中的「黄金流星」和「白银伴星」，队员们会通知{M#他们}{F#她们}，请两位贵客直接来这里找你的…"
                },
                {
                    "id": "745070209",
                    "speaker": "蒂蕾娜",
                    "text": "预祝你们的「小小灵蕈大幻戏」活动举办顺利，在枫丹廷玩得开心…如有需要，我随叫随到。"
                },
                {
                    "id": "745070210",
                    "speaker": "？？？",
                    "text": "#啊，看来不用麻烦你们了，{M#他们}{F#她们}已经找过来了。"
                },
                {
                    "id": "745070211",
                    "speaker": "蒂蕾娜",
                    "text": "慢着慢着！你说的「黄金流星」和「白银伴星」…居然是这两位…「超天顶领队级战力」？"
                },
                {
                    "id": "745070212",
                    "speaker": "派蒙",
                    "text": "哇啊！你们俩的话题怎么突然转向我们了？还有这奇奇怪怪的称号…"
                },
                {
                    "id": "745070213",
                    "speaker": "？？？",
                    "text": "你们两位还是一如既往啊——神采奕奕，容光焕发，一出现就令人安心。",
                    "choices": [
                        {
                            "id": "745070214",
                            "text": "谁？",
                            "response": [
                                {
                                    "id": "745070215",
                                    "speaker": "派蒙",
                                    "text": "你你你，你是哪位？我们之前见过吗？"
                                },
                                {
                                    "id": "745070216",
                                    "speaker": "？？？",
                                    "text": "嗯…你们两位没印象了，是我的失误，我应该尽力你们保持联络，多写几封信的。"
                                },
                                {
                                    "id": "745070217",
                                    "speaker": "？？？",
                                    "text": "很久以前，须弥举办了一场「月莲杯驯兽师大赛」。当时，我抱着偏执的想法参加了比赛，想要做些危险的事…"
                                },
                                {
                                    "id": "745070218",
                                    "speaker": "？？？",
                                    "text": "是你们打醒了我，让我改过自新，不再仇视善良的蕈兽伙伴，而是找到一条与它们共同生活的正确道路。"
                                },
                                {
                                    "id": "745070219",
                                    "speaker": "？？？",
                                    "text": "那次大赛最后，你成为了「月莲杯驯兽师大赛」的最终决定人，而我承诺，会为你献出全力，继续把大赛办好…"
                                },
                                {
                                    "id": "745070224",
                                    "speaker": "派蒙",
                                    "text": "难道说，你是…海妮耶？一直帮我们照顾着「咚咚小圆帽」和其他蕈兽伙伴的海妮耶？"
                                },
                                {
                                    "id": "745070225",
                                    "speaker": "海妮耶",
                                    "text": "没错，确实是我，好久不见了，「黄金流星」和「白银伴星」，两位老板！",
                                    "choices": [
                                        {
                                            "id": "745070226",
                                            "text": "新衣服很漂亮！",
                                            "response": [
                                                {
                                                    "id": "745070228",
                                                    "speaker": "派蒙",
                                                    "text": "你现在的样子，我们根本认不出来嘛！变化太太太…太大了，说话的方式也不一样了！"
                                                },
                                                {
                                                    "id": "745070229",
                                                    "speaker": "派蒙",
                                                    "text": "为什么会这样呢？难道说…是为了带着蕈兽伙伴们在枫丹旅游的…仪式感？"
                                                },
                                                {
                                                    "id": "745070230",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "咳咳，其实枫丹廷对游客没有着装要求，就算穿着朴素的猎户服装，也不会被人冷眼相待的…"
                                                },
                                                {
                                                    "id": "745070231",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "海妮耶小姐着装已经不止于满足仪式感了，而是太优雅了，优雅至极！"
                                                },
                                                {
                                                    "id": "745070232",
                                                    "speaker": "海妮耶",
                                                    "text": "实在感谢！得到了你们的肯定，我更有底气了。"
                                                },
                                                {
                                                    "id": "745070233",
                                                    "speaker": "海妮耶",
                                                    "text": "言归正传，这次我来枫丹，是为了给正式的蕈兽大赛寻找可靠的投资方，并用预热活动宣传蕈兽的可爱之处，提前吸引受众。"
                                                },
                                                {
                                                    "id": "745070234",
                                                    "speaker": "海妮耶",
                                                    "text": "左右加说，我们正在进行跨国的商业事务，枫丹人非常讲究穿衣打扮的细节，我们要入乡随俗才行。"
                                                },
                                                {
                                                    "id": "745070235",
                                                    "speaker": "海妮耶",
                                                    "text": "所以左右加为我准备了预热活动的方案，订制了这身服装，还对我进行了一番特训，改善了我的言行举止。"
                                                },
                                                {
                                                    "id": "745070236",
                                                    "speaker": "派蒙",
                                                    "text": "左右加？这个名字…好像是那位被我们打败后，一直跟着你取材，帮你照顾蕈兽伙伴的轻小说作家？"
                                                },
                                                {
                                                    "id": "745070237",
                                                    "speaker": "派蒙",
                                                    "text": "没想到左右加居然还懂这些…异国的礼节！她居然这么博学的吗！"
                                                },
                                                {
                                                    "id": "745070238",
                                                    "speaker": "海妮耶",
                                                    "text": "不止如此，如果你们对以前玩过的桌上游戏「灵蕈棋阵」还有印象，那也可以来试试全新的「小小灵蕈大幻戏」。"
                                                },
                                                {
                                                    "id": "745070239",
                                                    "speaker": "海妮耶",
                                                    "text": "之前，「灵蕈棋阵」的玩法是「指挥小小灵蕈们，战胜场地内的棋阵机关」。"
                                                },
                                                {
                                                    "id": "745070240",
                                                    "speaker": "海妮耶",
                                                    "text": "游戏刚刚推出时的反响还不错，但缺乏长久游玩的潜力，很快就没了热度…"
                                                },
                                                {
                                                    "id": "745070241",
                                                    "speaker": "海妮耶",
                                                    "text": "所以左右加结合各种文献和小说的描述，将棋阵机关换成了模拟强大对手的棋子，为游戏增添了各种多变性。"
                                                },
                                                {
                                                    "id": "745070242",
                                                    "speaker": "海妮耶",
                                                    "text": "现在，左右加正在《蒸汽鸟报》报社商量刊登广告，宣传游戏的事宜。"
                                                },
                                                {
                                                    "id": "745070243",
                                                    "speaker": "派蒙",
                                                    "text": "我好像明白了…你说的预热活动，「小小灵蕈大幻戏」，就是桌上的这款游戏吗？"
                                                },
                                                {
                                                    "id": "745070244",
                                                    "speaker": "派蒙",
                                                    "text": "强大的对手？也就是说，要指挥蕈兽伙伴们的棋子，去和其他的生物较量，双方都能移动吗？"
                                                },
                                                {
                                                    "id": "745070245",
                                                    "speaker": "派蒙",
                                                    "text": "听起来游戏整个变复杂了很多…不过，按照以往的经验，你是不是还要处理一些细节上的事，先完善这个游戏？",
                                                    "choices": [
                                                        {
                                                            "id": "745070246",
                                                            "text": "哈哈，是我们擅长的领域！",
                                                            "response": [
                                                                {
                                                                    "id": "745070248",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "咳咳，已经不劳两位担心了。需要解决的难题，我们都事先处理完了。"
                                                                },
                                                                {
                                                                    "id": "745070249",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "海妮耶小姐与她的「小小灵蕈大幻戏」得到了来自枫丹科学院的…那什么来着，枫达项目组的赞助，一切都准备停当了。"
                                                                },
                                                                {
                                                                    "id": "745070250",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "就算有还没处理完的杂活，本人…特巡队干活最勤快的蒂蕾娜，也不会允许你们两位贵客受累的！"
                                                                },
                                                                {
                                                                    "id": "745070251",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "毕竟你们可是「超天顶领队级战力」，而海妮耶小姐是重要的外国商客，杂活什么的大可以交给普通的警备队员！"
                                                                },
                                                                {
                                                                    "id": "745070252",
                                                                    "speaker": "派蒙",
                                                                    "text": "原，原来这位小姐是警备队员吗？我还以为是海妮耶雇来的帮手呢…真可靠！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745070253",
                                                                            "text": "失敬失敬！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745070255",
                                                                                    "speaker": "蒂蕾娜",
                                                                                    "text": "噫！「超天顶领队级战力」肯定我了…我得到了顶级战士的认可！"
                                                                                },
                                                                                {
                                                                                    "id": "745070256",
                                                                                    "speaker": "蒂蕾娜",
                                                                                    "text": "呃咳！现在不是在乎这个的时候…"
                                                                                },
                                                                                {
                                                                                    "id": "745070257",
                                                                                    "speaker": "蒂蕾娜",
                                                                                    "text": "作为特巡队的新人，我有义务监视外来生物，并为特别的客人提供最高级的帮助，搞定普通警备队员处理不了的麻烦。"
                                                                                },
                                                                                {
                                                                                    "id": "745070258",
                                                                                    "speaker": "蒂蕾娜",
                                                                                    "text": "要是蕈兽相关的活动能为枫丹廷带来可观的经济收益…我也算是积累了一些战斗之外的履历，能被队长更重视了…"
                                                                                },
                                                                                {
                                                                                    "id": "745070259",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "别这么严肃嘛，只是一个游戏而已，轻松一点！"
                                                                                },
                                                                                {
                                                                                    "id": "745070260",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "在我的印象里，和善良的蕈兽伙伴有关的事情，能让人把一切烦恼都忘掉，开开心心！"
                                                                                },
                                                                                {
                                                                                    "id": "745070261",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "正好，我有一个提议。"
                                                                                },
                                                                                {
                                                                                    "id": "745070262",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "之前我和左右加试玩过几百次「小小灵蕈大幻戏」，不过，我们只代表了两种游玩者，而客人们的思维各不相同。"
                                                                                },
                                                                                {
                                                                                    "id": "745070263",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "正好，「黄金流星」和「白银伴星」的性格和阅历都很特别，而蒂蕾娜小姐又很负责…"
                                                                                },
                                                                                {
                                                                                    "id": "745070264",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "如果你们两位进行几次对局，应该能探索出这个玩法的许多极限，有助于改进它的设计。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "745070265",
                                                                                            "text": "好耶！是新游戏！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "745070267",
                                                                                                    "speaker": "蒂蕾娜",
                                                                                                    "text": "既然是「超天顶领队级战力」都很感兴趣的游戏，又能为我的履历写下光彩的记录…我当然乐意奉陪！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "745070268",
                                                                                                    "speaker": "蒂蕾娜",
                                                                                                    "text": "不过，我明白，我在各方面的实力都远不如你，也请你不要太凶狠！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "745070266",
                                                                                            "text": "本来也想试试看！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745070254",
                                                                            "text": "有劳有劳！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745070247",
                                                            "text": "有我们能帮上忙的工作吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745070227",
                                            "text": "谈吐也好礼貌！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745070220",
                            "text": "我是不是在哪里见过你？",
                            "response": [
                                {
                                    "id": "745070221",
                                    "speaker": "派蒙",
                                    "text": "这个声音，总觉得有点耳熟，但我们以前认识这样的淑女吗？"
                                },
                                {
                                    "id": "745070222",
                                    "speaker": "派蒙",
                                    "text": "看你的样子，晒得有点黑的皮肤，似乎不是枫丹本地人？"
                                },
                                {
                                    "id": "745070223",
                                    "speaker": "派蒙",
                                    "text": "等等，我好像有点印象了，虽然有点不敢相信…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450703",
            "objective": "游玩「小小灵蕈大幻戏」",
            "dialogues": [
                {
                    "id": "745070301",
                    "speaker": "蒂蕾娜",
                    "text": "好强…太强了…就算是桌上游戏，也近乎无懈可击！"
                },
                {
                    "id": "745070302",
                    "speaker": "蒂蕾娜",
                    "text": "请，请再来两局，多多教导我！",
                    "choices": [
                        {
                            "id": "745070303",
                            "text": "我真有这么厉害？",
                            "response": [
                                {
                                    "id": "745070305",
                                    "speaker": "派蒙",
                                    "text": "你的说法未免也太夸张了啦，我们明明只是在玩一个游戏而已嘛。"
                                },
                                {
                                    "id": "745070306",
                                    "speaker": "蒂蕾娜",
                                    "text": "请别谦虚！这个桌上游戏可以反映游玩者的「小队指挥」思维——"
                                },
                                {
                                    "id": "745070307",
                                    "speaker": "蒂蕾娜",
                                    "text": "每只「小小灵蕈」的阵位，应对的目标，发动战技的节奏，互相支援的时机…都大有讲究！"
                                },
                                {
                                    "id": "745070308",
                                    "speaker": "蒂蕾娜",
                                    "text": "你没有接受过执律庭的小队指挥训练，就能如此娴熟地发动「联合作战」的攻势…"
                                },
                                {
                                    "id": "745070309",
                                    "speaker": "蒂蕾娜",
                                    "text": "你已经不是「超天顶领队级战力」了，而是名副其实的「超天顶领队」！"
                                },
                                {
                                    "id": "745070310",
                                    "speaker": "蒂蕾娜",
                                    "text": "有意向来执律庭任职吗？你一定很快就能坐上小队长的位置，然后进一步成长为关键的骨干…",
                                    "choices": [
                                        {
                                            "id": "745070311",
                                            "text": "好啊！工资开多少？",
                                            "response": [
                                                {
                                                    "id": "745070312",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "这个嘛…我不太确定，我记得几年前普通警备队员的月工资好像是30万摩拉吧…现在应该涨了一些？"
                                                },
                                                {
                                                    "id": "745070313",
                                                    "speaker": "派蒙",
                                                    "text": "每个月30万摩拉是多少来着？我总觉得这个数字有点熟悉…",
                                                    "choices": [
                                                        {
                                                            "id": "745070314",
                                                            "text": "还不够派蒙吃的呢！",
                                                            "response": [
                                                                {
                                                                    "id": "745070316",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "没…没办法！毕竟执律庭只是执行机构，大部分资金来源都是枫丹市民们的税款，工资当然不会特别高…"
                                                                },
                                                                {
                                                                    "id": "745070323",
                                                                    "speaker": "海妮耶",
                                                                    "text": "我理解你对「黄金流星」和「白银伴星」的敬重，蒂蕾娜小姐。"
                                                                },
                                                                {
                                                                    "id": "745070324",
                                                                    "speaker": "海妮耶",
                                                                    "text": "#可惜，根据我的消息，{M#他们}{F#她们}要在提瓦特四处游历，顺带帮各国的人解决难题，清剿魔物…"
                                                                },
                                                                {
                                                                    "id": "745070325",
                                                                    "speaker": "海妮耶",
                                                                    "text": "#作为{M#他们}{F#她们}善行的受益者，我也希望有更多人接受{M#他们}{F#她们}的帮助。"
                                                                },
                                                                {
                                                                    "id": "745070326",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "是这样吗…"
                                                                },
                                                                {
                                                                    "id": "745070327",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "把正义与和平的种子播撒到全提瓦特，的确比只照顾枫丹的治安要伟大得多！"
                                                                },
                                                                {
                                                                    "id": "745070328",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "那我就只有…再和你们多玩几局游戏，尽量领会你们两位的思想了！"
                                                                },
                                                                {
                                                                    "id": "745070329",
                                                                    "speaker": "派蒙",
                                                                    "text": "话说回来，可不能忘了，还有一件重要的事，海妮耶…"
                                                                },
                                                                {
                                                                    "id": "745070330",
                                                                    "speaker": "海妮耶",
                                                                    "text": "我猜，你是想问「咚咚小圆帽」没错吧？"
                                                                },
                                                                {
                                                                    "id": "745070331",
                                                                    "speaker": "海妮耶",
                                                                    "text": "「咚咚小圆帽」和「欢腾之火」就在旁边，蒂蕾娜小姐还特意给蕈兽伙伴们安排了一位照顾生活的朋友呢。"
                                                                },
                                                                {
                                                                    "id": "745070332",
                                                                    "speaker": "海妮耶",
                                                                    "text": "按照惯例，这回我也有准备特别的「妙妙琼脂」。"
                                                                },
                                                                {
                                                                    "id": "745070333",
                                                                    "speaker": "海妮耶",
                                                                    "text": "你们可以一边和蕈兽伙伴们玩，一边和伙伴们一起吃零食！"
                                                                },
                                                                {
                                                                    "id": "745070334",
                                                                    "speaker": "派蒙",
                                                                    "text": "好好好！海妮耶的准备越来越周到了！"
                                                                },
                                                                {
                                                                    "id": "745070335",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}，我们分别和蒂蕾娜再玩一局「小小灵蕈大幻戏」，就去看看「咚咚小圆帽」吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745070315",
                                                            "text": "我难道不值几千万？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745070317",
                                            "text": "哎吔！我不想上班！",
                                            "response": [
                                                {
                                                    "id": "745070318",
                                                    "speaker": "派蒙",
                                                    "text": "#要是在一个固定的地方停留下来，每天上班，{NICKNAME}就不能干自己的正事了。"
                                                },
                                                {
                                                    "id": "745070319",
                                                    "speaker": "派蒙",
                                                    "text": "我也不想每天早早就被叫起床去工作…还是自由自在比较好，想去哪里就去哪里。",
                                                    "choices": [
                                                        {
                                                            "id": "745070320",
                                                            "text": "而且日常饭菜有更多选择。",
                                                            "response": [
                                                                {
                                                                    "id": "745070322",
                                                                    "speaker": "派蒙",
                                                                    "text": "对哦，各种各样的美食也很重要！总是呆在同一个地方，饭菜也迟早会吃腻的，还是要时不时换着来！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745070321",
                                                            "text": "而且吃的东西有更多花样。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745070304",
                            "text": "奉承我也没用哦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450704",
            "objective": "与摊位旁的两人对话",
            "dialogues": []
        },
        {
            "id": "7450714",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745071401",
                    "speaker": "蒂蕾娜",
                    "text": "来吧，试着对局一次！"
                },
                {
                    "id": "745071402",
                    "speaker": "蒂蕾娜",
                    "text": "不过，我明白，我在各方面的实力都远不如你，也请你不要太凶狠！"
                }
            ]
        },
        {
            "id": "7450719",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745071901",
                    "speaker": "派蒙",
                    "text": "嘿嘿，原来我之前猜得没错，真的是…「咚咚小圆帽」和「欢腾之火」！"
                },
                {
                    "id": "745071902",
                    "speaker": "咚咚小圆帽",
                    "text": "♪~"
                },
                {
                    "id": "745071903",
                    "speaker": "欢腾之火",
                    "text": "♫~"
                },
                {
                    "id": "745071904",
                    "speaker": "派蒙",
                    "text": "请你们等一下哦！我们和海妮耶，还有蒂蕾娜小姐说完正事，马上就来陪你们玩！"
                }
            ]
        }
    ]
}