        },
        {
            "id": "7001504",
            "objective": "（test）失败交付回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "700150401",
                    "speaker": "思索的丘丘人",
                    "text": "Domu movo si, Eleka nini si, tomo tomo. Tomo dala si?"
                },
                {
                    "id": "700150402",
                    "speaker": "艾拉·马斯克",
                    "text": "家人会变化，部落会消失。朋友，朋友。究竟什么是朋友啊？"
                },
                {
                    "id": "700150403",
                    "speaker": "派蒙",
                    "text": "只是给错了东西，不用这么怀疑世界吧。"
                }
            ]
        },
        {
