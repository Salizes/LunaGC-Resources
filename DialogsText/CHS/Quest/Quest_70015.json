        {
            "id": "7001501",
            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700150101",
                    "speaker": "思索的丘丘人",
                    "text": "Emmm…Yoyo, ika? Tomo?"
                },
                {
                    "id": "700150102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo."
                },
                {
                    "id": "700150103",
                    "speaker": "思索的丘丘人",
                    "text": "Tomo tomo. Tomo dala si? domu nye, ika nye."
                },
                {
                    "id": "700150104",
                    "speaker": "艾拉·马斯克",
                    "text": "Ye muhe dala? Mimi mani ye."
                },
                {
                    "id": "700150105",
                    "speaker": "思索的丘丘人",
                    "text": "Ya tomo mani, mani yaya tome nye… Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si."
                },
                {
                    "id": "700150106",
                    "speaker": "艾拉·马斯克",
                    "text": "它应该是想要什么东西…唔，我的手册上应该有记录，不如查一查吧？"
                }
            ]
        },
        {
            "id": "7001502",
            "objective": "向丘丘人交付物品",
            "dialogues": [
                {
                    "id": "700150301",
                    "speaker": "思索的丘丘人",
                    "text": "Mosi mita, yoyo tomo, mimi tomo."
                },
                {
                    "id": "700150302",
                    "speaker": "思索的丘丘人",
                    "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>！"
                },
                {
                    "id": "700150303",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>Unta mosi dada</color>…好像之前听过这句话的样子…不如查查看吧？",
                    "choices": [
                        {
                            "id": "700150304",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700150306",
                                    "speaker": "思索的丘丘人",
                                    "text": "Valo, mi tomo!"
                                },
                                {
                                    "id": "700150307",
                                    "speaker": "派蒙",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700150305",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001503",
            "objective": "（test）成功交付$HIDDEN",
