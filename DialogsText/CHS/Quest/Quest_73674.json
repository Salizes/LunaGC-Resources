    "talks": [
        {
            "id": "7367402",
            "objective": "(test)【隐藏】判断是否完成过旧活动$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7367401",
            "objective": "与乌尔曼对话",
            "dialogues": [
                {
                    "id": "736740101",
                    "speaker": "乌尔曼",
                    "text": "小家伙，不是你带我来的吗？来点作用，再动一动啊。"
                },
                {
                    "id": "736740102",
                    "speaker": "乌尔曼",
                    "text": "唉，行吧，你就待着别动吧…",
                    "choices": [
                        {
                            "id": "736740103",
                            "text": "你在做什么呢？",
                            "response": [
                                {
                                    "id": "736740106",
                                    "speaker": "乌尔曼",
                                    "text": "唉，我这次算是又被这小家伙给坑了…我从头和你简单说说。"
                                },
                                {
                                    "id": "736740107",
                                    "speaker": "乌尔曼",
                                    "text": "说出来你可能不太相信，但是我这人不知道为什么，总是特别容易吸引仙灵。"
                                },
                                {
                                    "id": "736740108",
                                    "speaker": "乌尔曼",
                                    "text": "在那些过来跟着我不走的仙灵里，我发现了一种特别热衷于寻宝的仙灵。"
                                },
                                {
                                    "id": "736740109",
                                    "speaker": "乌尔曼",
                                    "text": "我也不会取名，就直接叫它们「寻宝仙灵」了。"
                                },
                                {
                                    "id": "736740110",
                                    "speaker": "乌尔曼",
                                    "text": "它们很擅长寻宝，在它们的帮助下，我也挖到了不少宝贝，小小地赚了一笔钱。"
                                },
                                {
                                    "id": "736740111",
                                    "speaker": "乌尔曼",
                                    "text": "但它们有时候会突然不搭理我，也不知道是寻宝累了，还是觉得我这个人没什么意思…"
                                },
                                {
                                    "id": "736740112",
                                    "speaker": "乌尔曼",
                                    "text": "这个时候，我一般就会找个能让仙灵看顺眼的帮手合作。"
                                },
                                {
                                    "id": "736740113",
                                    "speaker": "乌尔曼",
                                    "text": "他负责带着「寻宝仙灵」寻宝，而我嘛…就负责把这些宝贝变现。"
                                },
                                {
                                    "id": "736740114",
                                    "speaker": "乌尔曼",
                                    "text": "我之前听人说，须弥这里遍地遗迹，满地古玩，所以就想要过来捞一笔。"
                                },
                                {
                                    "id": "736740115",
                                    "speaker": "乌尔曼",
                                    "text": "来了之后，我果然又吸引来了一堆仙灵，其中的几个「寻宝仙灵」把我带到了这里。"
                                },
                                {
                                    "id": "736740116",
                                    "speaker": "乌尔曼",
                                    "text": "但我没挖几铲子，这些小家伙又不搭理我了…"
                                },
                                {
                                    "id": "736740117",
                                    "speaker": "乌尔曼",
                                    "text": "咦？它怎么突然动弹起来了？难道…"
                                },
                                {
                                    "id": "736740118",
                                    "speaker": "乌尔曼",
                                    "text": "旅行者，你对和仙灵一起寻宝这件事，有兴趣吗？",
                                    "choices": [
                                        {
                                            "id": "736740119",
                                            "text": "我？",
                                            "response": [
                                                {
                                                    "id": "736740121",
                                                    "speaker": "乌尔曼",
                                                    "text": "不用和它说话，只要跟着它走，看它停下了就往下挖，就这么简单。"
                                                },
                                                {
                                                    "id": "736740122",
                                                    "speaker": "乌尔曼",
                                                    "text": "怎么样？你就试试看吧，嗯…如果你真找到了宝藏，我只要里面的「古铁钱」，其他的东西全都归你！"
                                                },
                                                {
                                                    "id": "736740123",
                                                    "speaker": "乌尔曼",
                                                    "text": "而且，要是你真能帮我找到一些「古铁钱」，那我也会付给你相应的报酬。",
                                                    "choices": [
                                                        {
                                                            "id": "736740124",
                                                            "text": "我可以试试…",
                                                            "response": [
                                                                {
                                                                    "id": "736740125",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "爽快！我就喜欢你这种人！"
                                                                },
                                                                {
                                                                    "id": "736740130",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "总之，我们现在就是合作关系了！"
                                                                },
                                                                {
                                                                    "id": "736740131",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "这个笔记本你先拿好，这是我之前找到的一些藏宝地，还没来得及去挖呢。"
                                                                },
                                                                {
                                                                    "id": "736740132",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "那就拜托你了，旅行者。如果找到「古铁钱」的话，记得带回来给我啊。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740126",
                                                            "text": "「古铁钱」是什么？",
                                                            "response": [
                                                                {
                                                                    "id": "736740127",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "简单来说，就是一种另类的古董啦。"
                                                                },
                                                                {
                                                                    "id": "736740128",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "只要找到好门路，我就能用这些「古铁钱」换到不少好东西。"
                                                                },
                                                                {
                                                                    "id": "736740129",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "虽然…现在我还没有找到好门路…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740120",
                                            "text": "我不会和仙灵说话…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740104",
                            "text": "这是…仙灵？",
                            "response": [
                                {
                                    "id": "736740105",
                                    "speaker": "乌尔曼",
                                    "text": "你说这小家伙？呃…就算它是吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367403",
            "objective": "(test)【隐藏】对话中做仙灵移动表现1$HIDDEN",
            "dialogues": [
                {
                    "id": "736740301",
                    "speaker": "乌尔曼",
                    "text": "小家伙，不是你带我来的吗？来点作用，再动一动啊。"
                },
                {
                    "id": "736740302",
                    "speaker": "乌尔曼",
                    "text": "唉，行吧，你就待着别动吧…",
                    "choices": [
                        {
                            "id": "736740303",
                            "text": "乌尔曼？",
                            "response": [
                                {
                                    "id": "736740305",
                                    "speaker": "乌尔曼",
                                    "text": "旅行者？嘿哟，真是好久不见了。"
                                },
                                {
                                    "id": "736740306",
                                    "speaker": "乌尔曼",
                                    "text": "怎么？你还在满世界转悠吗？我可是听说了你的不少惊天事迹，你可真是身手不凡啊。"
                                },
                                {
                                    "id": "736740307",
                                    "speaker": "乌尔曼",
                                    "text": "嘿嘿，这次你来须弥，又是打算来解决什么问题？",
                                    "choices": [
                                        {
                                            "id": "736740308",
                                            "text": "你说点吉利的。",
                                            "response": [
                                                {
                                                    "id": "736740309",
                                                    "speaker": "乌尔曼",
                                                    "text": "行行，说正经的。旅行者，这次咱们再合作一下，怎么样？"
                                                },
                                                {
                                                    "id": "736740313",
                                                    "speaker": "乌尔曼",
                                                    "text": "你看，这片须弥大地，可是处处都是宝藏，哪里都有摩拉。"
                                                },
                                                {
                                                    "id": "736740314",
                                                    "speaker": "乌尔曼",
                                                    "text": "我的这个体质嘛…也正常发挥，吸引了不少仙灵过来，里面也有你我熟悉无比的「寻宝仙灵」。"
                                                },
                                                {
                                                    "id": "736740315",
                                                    "speaker": "乌尔曼",
                                                    "text": "还是和之前一样，你负责和仙灵去寻宝，我负责给你准备报酬。"
                                                },
                                                {
                                                    "id": "736740316",
                                                    "speaker": "乌尔曼",
                                                    "text": "只要我们联手，绝对能再大大地赚上一笔！",
                                                    "choices": [
                                                        {
                                                            "id": "736740317",
                                                            "text": "这次又要找「铁钱」？",
                                                            "response": [
                                                                {
                                                                    "id": "736740318",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "那不是，这次我要找的是比「铁钱」更值钱的「古铁钱」"
                                                                },
                                                                {
                                                                    "id": "736740319",
                                                                    "speaker": "Player",
                                                                    "text": "就多了一个字吧！"
                                                                },
                                                                {
                                                                    "id": "736740320",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "你别小看这一个字啊，多一个字，能多卖不少摩拉。"
                                                                },
                                                                {
                                                                    "id": "736740326",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "那这件事就这么定了，咱们和之前一样通力合作，狠狠地再大赚一笔！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740321",
                                                            "text": "除了我你就找不到别人吗？",
                                                            "response": [
                                                                {
                                                                    "id": "736740322",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "哎呀…挑合作伙伴，当然要挑自己最熟悉的人。"
                                                                },
                                                                {
                                                                    "id": "736740323",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "再说了，你我朋友一场，有这种好事，我怎么能让肥水流外人田呢。"
                                                                },
                                                                {
                                                                    "id": "736740324",
                                                                    "speaker": "Player",
                                                                    "text": "一段时间不见，嘴皮子变利索了嘛。"
                                                                },
                                                                {
                                                                    "id": "736740325",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "嘿嘿嘿，我拿着那些宝贝去找买主，必须要学会说话嘛。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740310",
                                            "text": "我先把你给解决了。",
                                            "response": [
                                                {
                                                    "id": "736740311",
                                                    "speaker": "乌尔曼",
                                                    "text": "哈哈哈，可别啊，我可经不起你几拳。"
                                                },
                                                {
                                                    "id": "736740312",
                                                    "speaker": "乌尔曼",
                                                    "text": "说正经的，旅行者，这次咱们再合作一下，怎么样？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740304",
                            "text": "你怎么在这？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367404",
            "objective": "(test)【隐藏】对话中做仙灵移动表现2$HIDDEN",
            "dialogues": []
        }
    ]
