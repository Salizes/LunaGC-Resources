    "talks": [
        {
            "id": "7566801",
            "objective": "与阿维苏菈对话",
            "dialogues": [
                {
                    "id": "756680101",
                    "speaker": "阿维苏菈",
                    "text": "加点蘑菇…再加点野菜根…"
                },
                {
                    "id": "756680102",
                    "speaker": "阿维苏菈",
                    "text": "#饮料调好了，{NICKNAME}，你要尝尝么？"
                },
                {
                    "id": "756680103",
                    "speaker": "Player",
                    "text": "你，你往里面加了什么？"
                },
                {
                    "id": "756680104",
                    "speaker": "阿维苏菈",
                    "text": "都是一些普通的香料和调味品，它们能让饮料变得更好喝。"
                },
                {
                    "id": "756680105",
                    "speaker": "阿维苏菈",
                    "text": "后面的乐台已经搭建完成，普通的饮料可配不上它奏出来的音乐。"
                },
                {
                    "id": "756680106",
                    "speaker": "Player",
                    "text": "话是这么说没错…"
                },
                {
                    "id": "756680107",
                    "speaker": "阿维苏菈",
                    "text": "放心吧，在你之前已经有不少人喝过了。"
                },
                {
                    "id": "756680108",
                    "speaker": "阿维苏菈",
                    "text": "喏，他们都已经拿着饮料去乐台旁边跳舞了。"
                },
                {
                    "id": "756680109",
                    "speaker": "阿维苏菈",
                    "text": "#来吧{NICKNAME}，拿上一杯，和我们一起跳舞！"
                },
                {
                    "id": "756680110",
                    "speaker": "阿维苏菈",
                    "text": "把糟心事都甩到一旁，尽情享受音乐吧！"
                },
                {
                    "id": "756680111",
                    "speaker": "阿维苏菈",
                    "text": "对了，你跳舞的时候，也记得稍微控制一下，别用力过头了啊。"
                },
                {
                    "id": "756680112",
                    "speaker": "阿维苏菈",
                    "text": "之前就有几个人因为跳太久差点晕过去了，被人扶下来的时候，还嘟嘟囔囔什么…"
                },
                {
                    "id": "756680113",
                    "speaker": "阿维苏菈",
                    "text": "「我…我真看见了！那个…丘丘人…和我一起跳舞…」"
                },
                {
                    "id": "756680114",
                    "speaker": "阿维苏菈",
                    "text": "咳，不说这些耽误你时间了，快去台上玩个痛快吧！"
                }
            ]
        }
    ]
}