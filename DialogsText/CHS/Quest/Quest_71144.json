    "talks": [
        {
            "id": "7114401",
            "objective": "(test)隐藏任务用来播开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7114402",
            "objective": "前往璃月港",
            "dialogues": []
        },
        {
            "id": "7114403",
            "objective": "询问情况",
            "dialogues": [
                {
                    "id": "711440301",
                    "speaker": "苏定",
                    "text": "#这磐石雕琢般的面相，还有卓尔不群的气场…你想必就是传闻中的将才{NICKNAME}吧？"
                },
                {
                    "id": "711440302",
                    "speaker": "苏定",
                    "text": "久仰大名。我正想委托冒险家协会致信你，请你参会，没想到你有所察觉，直接来到了现场。",
                    "choices": [
                        {
                            "id": "711440303",
                            "text": "将才？",
                            "response": [
                                {
                                    "id": "711440305",
                                    "speaker": "派蒙",
                                    "text": "#说得好正经！感觉像是把{NICKNAME}当成了…特别专业的战士？"
                                },
                                {
                                    "id": "711440306",
                                    "speaker": "苏定",
                                    "text": "不止是战士，你们游历五国期间，曾与不可计数的魔物和强者交手，相关情报被各国部队重点记录，反复分析。"
                                },
                                {
                                    "id": "711440307",
                                    "speaker": "苏定",
                                    "text": "无论西风骑士团，千岩军，幕府武士，三十人团和执律庭，每支作战部队都对你的战力和谋略给予了顶尖的评价——"
                                },
                                {
                                    "id": "711440308",
                                    "speaker": "苏定",
                                    "text": "#「{NICKNAME}的才能足以胜任前线作战到后方指挥的一切事务，如有可能，定要与其积极合作。」"
                                },
                                {
                                    "id": "711440309",
                                    "speaker": "苏定",
                                    "text": "因此，我苏定代表千岩军的参谋部门，正式邀请你参与我们的五方联合推演，出任高级顾问，不知你意下如何？"
                                },
                                {
                                    "id": "711440310",
                                    "speaker": "苏定",
                                    "text": "高级顾问的酬劳相当可观，参会期间的综合日薪将与千岩军教头平级。"
                                },
                                {
                                    "id": "711440311",
                                    "speaker": "派蒙",
                                    "text": "不愧是千岩军，说话真是直截了当…教头级别的报酬，听起来也很诱人…",
                                    "choices": [
                                        {
                                            "id": "711440312",
                                            "text": "但我们还没搞清状况呢！",
                                            "response": [
                                                {
                                                    "id": "711440314",
                                                    "speaker": "苏定",
                                                    "text": "不必担心，我这就为你们进行介绍。"
                                                },
                                                {
                                                    "id": "711440315",
                                                    "speaker": "苏定",
                                                    "text": "如你所见，提瓦特的荒野上依然有不少魔物在游荡，短时间内无法根除。"
                                                },
                                                {
                                                    "id": "711440316",
                                                    "speaker": "苏定",
                                                    "text": "为了高效应对魔物的威胁，友邻诸国的部队正总结常见魔物的情报，细致评估其威胁，并彼此共享一部分情报。"
                                                },
                                                {
                                                    "id": "711440317",
                                                    "speaker": "苏定",
                                                    "text": "为此，千岩军的参谋部将各种魔物制成桌上推演的兵棋，模拟魔物之间的对抗，从而极尽可能分析各种魔物的战力。"
                                                },
                                                {
                                                    "id": "711440318",
                                                    "speaker": "苏定",
                                                    "text": "本次「联合推演」邀请了不同作战单位的人员，以风格迥异的思路使用兵棋，探究克制魔物的最佳方法。"
                                                },
                                                {
                                                    "id": "711440319",
                                                    "speaker": "苏定",
                                                    "text": "#而{NICKNAME}不属于任何部队，又是难得的战术天才，能为我们新增一个宝贵的分析维度，大大提升推演的广度和效能。"
                                                },
                                                {
                                                    "id": "711440320",
                                                    "speaker": "派蒙",
                                                    "text": "好像听懂了，你们这是在开会讨论…用什么办法对付魔物才最方便，最安全？"
                                                },
                                                {
                                                    "id": "711440321",
                                                    "speaker": "派蒙",
                                                    "text": "总算聊到了我们熟悉的领域！毕竟我们见识过各种地方的危险家伙，之前也玩过不少下棋之类的桌上游戏！"
                                                },
                                                {
                                                    "id": "711440322",
                                                    "speaker": "派蒙",
                                                    "text": "像以前那样下下棋，就能帮好几个国家搞好治安，还能拿到不少报酬…可以说是一举多得吧？",
                                                    "choices": [
                                                        {
                                                            "id": "711440323",
                                                            "text": "轻轻松松玩推演，帮大忙！",
                                                            "response": [
                                                                {
                                                                    "id": "711440324",
                                                                    "speaker": "苏定",
                                                                    "text": "正是这种气势，从容应对挑战，如呼吸般自然地施展技艺，解决危机…"
                                                                },
                                                                {
                                                                    "id": "711440327",
                                                                    "speaker": "苏定",
                                                                    "text": "棋盘已经准备好了，随时可以进行推演。请让我们见识一下将才特有的作战策略吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711440325",
                                                            "text": "看来这次或许要严肃一点…",
                                                            "response": [
                                                                {
                                                                    "id": "711440326",
                                                                    "speaker": "苏定",
                                                                    "text": "请别紧张，拿出平时与魔物们交锋的心态就好。各方人士都表示，波澜不惊正是你的常态。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711440313",
                                            "text": "我们对推演还一无所知…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711440304",
                            "text": "参会？"
                        }
                    ]
                }
            ]
        }
    ]
}