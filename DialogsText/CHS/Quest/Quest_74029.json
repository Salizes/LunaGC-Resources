    "talks": [
        {
            "id": "7402901",
            "objective": "(test)(隐藏)与伊雅蕾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740290101",
                    "speaker": "派蒙",
                    "text": "为什么要在这种地方放钓竿？难道是在钓鱼吗？"
                },
                {
                    "id": "740290102",
                    "speaker": "伊雅蕾",
                    "text": "又有水，又有钓竿，当然是在钓鱼啦。明明是外边来的人，居然这么没见识，这就是所谓的「世风日下」吧。",
                    "choices": [
                        {
                            "id": "740290103",
                            "text": "跟世风日下应该没关系…",
                            "response": [
                                {
                                    "id": "740290104",
                                    "speaker": "派蒙",
                                    "text": "对啊！ 再说了，我们可不是对钓鱼一无所知的门外汉。"
                                },
                                {
                                    "id": "740290107",
                                    "speaker": "派蒙",
                                    "text": "我想说的是…我还以为美露莘不会用鱼竿钓鱼，而且…唔，感觉怪怪的。"
                                },
                                {
                                    "id": "740290108",
                                    "speaker": "伊雅蕾",
                                    "text": "哪、哪里奇怪了？我可是按外边的人教我的方法做的。德拉萝诗很好，不仅教我钓鱼，还送了我钓竿。"
                                },
                                {
                                    "id": "740290109",
                                    "speaker": "伊雅蕾",
                                    "text": "虽然她的钓竿看起来比较厉害，不过她是「专业人士」，我只是「爱好者」，所以有这个就够了。"
                                },
                                {
                                    "id": "740290110",
                                    "speaker": "伊雅蕾",
                                    "text": "唔…不过我都等了好久了，为什么还不上钩？"
                                },
                                {
                                    "id": "740290111",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，既然这样，不如就让{NICKNAME}老师和派蒙老师来帮你分析一下原因吧！"
                                },
                                {
                                    "id": "740290112",
                                    "speaker": "伊雅蕾",
                                    "text": "#{NICKNAME}老师和派蒙老师真的比她还厉害吗？她可是有着美丽钓竿的专业人士…"
                                },
                                {
                                    "id": "740290113",
                                    "speaker": "派蒙",
                                    "text": "哼，这种时候就该用实力证明自己，对吧？"
                                },
                                {
                                    "id": "740290114",
                                    "speaker": "Player",
                                    "text": "但是这里真的有鱼吗？"
                                },
                                {
                                    "id": "740290115",
                                    "speaker": "派蒙",
                                    "text": "哦！说起来的确是这样…一开始我会觉得奇怪也是因为这个！一点鱼的影子都看不到呢。"
                                },
                                {
                                    "id": "740290116",
                                    "speaker": "伊雅蕾",
                                    "text": "鱼…德拉萝诗说过，水里的不一定都是水产品。唔，「那个」可以算是鱼吗？"
                                },
                                {
                                    "id": "740290117",
                                    "speaker": "伊雅蕾",
                                    "text": "…难道是因为「那个」不是鱼，所以我用钓「鱼」的办法才钓不上来？"
                                },
                                {
                                    "id": "740290118",
                                    "speaker": "伊雅蕾",
                                    "text": "#{NICKNAME}老师…还有派蒙老师！请教教我，应该怎么做才能把「那个」钓上来呢？"
                                },
                                {
                                    "id": "740290119",
                                    "speaker": "派蒙",
                                    "text": "哦、哦！伊雅蕾真有礼貌啊…当然没问题了，不过你说的「那个」究竟是指…"
                                },
                                {
                                    "id": "740290120",
                                    "speaker": "伊雅蕾",
                                    "text": "它在水里游得好快，而且滑溜溜好难抓住。",
                                    "choices": [
                                        {
                                            "id": "740290121",
                                            "text": "听起来像鱼。",
                                            "response": [
                                                {
                                                    "id": "740290122",
                                                    "speaker": "派蒙",
                                                    "text": "其他的水下生物也是有可能的吧？"
                                                },
                                                {
                                                    "id": "740290125",
                                                    "speaker": "派蒙",
                                                    "text": "唔…总之，至少能确定应该是在水中生活的活物，既然从水面看不到影子，或许是藏在深水处了。"
                                                },
                                                {
                                                    "id": "740290126",
                                                    "speaker": "派蒙",
                                                    "text": "依我看，这种时候就应该用「散饵」，用食物把它从深水处吸引上来…"
                                                },
                                                {
                                                    "id": "740290127",
                                                    "speaker": "伊雅蕾",
                                                    "text": "可是它之前已经吃了很多…不知道换别的鱼饵会不会有用。"
                                                },
                                                {
                                                    "id": "740290128",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我们先往水里撒一些散饵，之后再准备好鱼竿，最后就只用等它上钩啦。虽然还不知道它是什么。"
                                                },
                                                {
                                                    "id": "740290129",
                                                    "speaker": "伊雅蕾",
                                                    "text": "#美丽的钓鱼技巧…我再试试。饵料交给{NICKNAME}老师和派蒙老师，我会看好钓竿做好准备，虽然不是专业人士的美丽钓竿…"
                                                },
                                                {
                                                    "id": "740290130",
                                                    "speaker": "派蒙",
                                                    "text": "没问题，撒散饵这点小事就交给我们好啦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740290123",
                                            "text": "听起来像美露莘。",
                                            "response": [
                                                {
                                                    "id": "740290124",
                                                    "speaker": "派蒙",
                                                    "text": "是伊雅蕾在和其他美露莘玩假装钓鱼的游戏…这也太奇怪了吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740290105",
                            "text": "派蒙当然知道钓鱼是怎么回事。",
                            "response": [
                                {
                                    "id": "740290106",
                                    "speaker": "派蒙",
                                    "text": "#对啊，毕竟我就是被{NICKNAME}用鱼竿钓起来的嘛…不对，问题不在这里吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402902",
            "objective": "到水边撒下散饵$HIDDEN",
            "dialogues": [
                {
                    "id": "740290201",
                    "speaker": "伊雅蕾",
                    "text": "…它还会被饵料吸引吗？"
                }
            ]
        },
        {
            "id": "7402905",
            "objective": "与伊雅蕾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740290301",
                    "speaker": "Black Screen",
                    "text": "伊雅蕾将虚弱的球球章鱼放入一旁的桶中…"
                },
                {
                    "id": "740290302",
                    "speaker": "伊雅蕾",
                    "text": "美丽的捕捞技巧…但是现在它变得不美丽了。怎么会这样呢？"
                },
                {
                    "id": "740290303",
                    "speaker": "派蒙",
                    "text": "抱歉…没想到伊雅蕾说的「那个」是指球球章鱼，一不小心就…",
                    "choices": [
                        {
                            "id": "740290304",
                            "text": "要怪就怪我吧。",
                            "response": [
                                {
                                    "id": "740290305",
                                    "speaker": "派蒙",
                                    "text": "#都怪{NICKNAME}太性急啦！虽然我没拦住你也不对…"
                                },
                                {
                                    "id": "740290308",
                                    "speaker": "伊雅蕾",
                                    "text": "#{NICKNAME}老师和派蒙老师不用这样道歉，它现在已经在桶里了，这样就足够了。"
                                },
                                {
                                    "id": "740290309",
                                    "speaker": "派蒙",
                                    "text": "好吧…不过为什么这里会有球球章鱼？是顺着水流意外掉到这里的吗？"
                                },
                                {
                                    "id": "740290310",
                                    "speaker": "伊雅蕾",
                                    "text": "是我从外边抓回来的。"
                                },
                                {
                                    "id": "740290311",
                                    "speaker": "派蒙",
                                    "text": "欸？"
                                },
                                {
                                    "id": "740290312",
                                    "speaker": "伊雅蕾",
                                    "text": "因为想要验证用鱼竿钓鱼的方法…所以去抓了「那个」，你们说的球球章鱼。"
                                },
                                {
                                    "id": "740290313",
                                    "speaker": "伊雅蕾",
                                    "text": "把它放在这里，就可以随时来钓鱼了。"
                                },
                                {
                                    "id": "740290314",
                                    "speaker": "伊雅蕾",
                                    "text": "原本以为是个很好的计划，可是等了很久它都不咬钩。"
                                },
                                {
                                    "id": "740290315",
                                    "speaker": "派蒙",
                                    "text": "虽然特意抓了球球章鱼放进水池里用来练习用钓竿钓鱼这点也很令人在意…"
                                },
                                {
                                    "id": "740290316",
                                    "speaker": "派蒙",
                                    "text": "不过刚才我们也只是往水里撒了一些散饵就把它吸引到水面了吧？伊雅蕾之前没有想过多撒一些饵料之类的办法吗？"
                                },
                                {
                                    "id": "740290317",
                                    "speaker": "伊雅蕾",
                                    "text": "之前试过很多饵料，比如肉糜、面包屑、蠕虫、薄荷、零件之类的…它吃过之后就再不出现啦，我还以为饵料对它没用了。"
                                },
                                {
                                    "id": "740290318",
                                    "speaker": "派蒙",
                                    "text": "零、零件？！这听起来可不像是饵料…",
                                    "choices": [
                                        {
                                            "id": "740290319",
                                            "text": "不要拿奇怪的东西喂水产品。",
                                            "response": [
                                                {
                                                    "id": "740290320",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！不过水产品这个叫法…"
                                                },
                                                {
                                                    "id": "740290323",
                                                    "speaker": "伊雅蕾",
                                                    "text": "嗯，而且零件是很重要的东西，既然不是给球球章鱼吃的饵料，得想个办法取出来。"
                                                },
                                                {
                                                    "id": "740290324",
                                                    "speaker": "伊雅蕾",
                                                    "text": "#对了，为了感谢{NICKNAME}老师和派蒙老师的帮助，这个零件给你们。"
                                                },
                                                {
                                                    "id": "740290325",
                                                    "speaker": "派蒙",
                                                    "text": "…不、不用了吧，我们也没帮上什么大忙…"
                                                },
                                                {
                                                    "id": "740290326",
                                                    "speaker": "伊雅蕾",
                                                    "text": "欸？可是德拉萝诗说过，需要别人帮忙的时候，叫对方「老师」，并且「付费咨询」的话，对方会很高兴。难道不是吗？"
                                                },
                                                {
                                                    "id": "740290327",
                                                    "speaker": "伊雅蕾",
                                                    "text": "这个干燥的零件给你们，在海沫村很有用。"
                                                },
                                                {
                                                    "id": "740290328",
                                                    "speaker": "派蒙",
                                                    "text": "既然伊雅蕾都这样说了…那就谢谢你啦！"
                                                },
                                                {
                                                    "id": "740290329",
                                                    "speaker": "伊雅蕾",
                                                    "text": "#嗯，希望之后还有机会向{NICKNAME}老师和派蒙老师学习美丽捕捞技巧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740290321",
                                            "text": "原来球球章鱼会吃零件啊…",
                                            "response": [
                                                {
                                                    "id": "740290322",
                                                    "speaker": "派蒙",
                                                    "text": "这种情况应该是误食才对吧…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740290306",
                            "text": "因为担心它会攻击我们…",
                            "response": [
                                {
                                    "id": "740290307",
                                    "speaker": "派蒙",
                                    "text": "遇到危险就该先下手为强！唔…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740299901",
                    "speaker": "Black Screen",
                    "text": "伊雅蕾将虚弱的球球章鱼放入一旁的桶中…"
                }
            ]
        }
    ]
}