    "talks": [
        {
            "id": "801901",
            "objective": "前往须弥冒险家协会，与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "80190101",
                    "speaker": "凯瑟琳",
                    "text": "哦？你们来了，我这里有份非你们不可的委托，正准备交给你们呢。"
                },
                {
                    "id": "80190102",
                    "speaker": "派蒙",
                    "text": "还有非我们不可的委托？唔…那怎么说也得是「魔神级」的委托了吧？",
                    "choices": [
                        {
                            "id": "80190103",
                            "text": "头一次听说这种委托分类。",
                            "response": [
                                {
                                    "id": "80190105",
                                    "speaker": "凯瑟琳",
                                    "text": "呵呵…冒险家协会的委托并没有这种分类，这次的委托也并不是你们想象的那种规模。"
                                },
                                {
                                    "id": "80190106",
                                    "speaker": "凯瑟琳",
                                    "text": "其实，只不过是一个「寻人」委托。"
                                },
                                {
                                    "id": "80190107",
                                    "speaker": "派蒙",
                                    "text": "嗯？那为什么说…是非我们不可呢？"
                                },
                                {
                                    "id": "80190108",
                                    "speaker": "凯瑟琳",
                                    "text": "前一阵子，我在清点所有积存委托的清单，偶然间注意到了它。"
                                },
                                {
                                    "id": "80190109",
                                    "speaker": "凯瑟琳",
                                    "text": "看似普普通通，却有着连续十几次委托失败的记录，其中还不乏一些很有名望的冒险家。"
                                },
                                {
                                    "id": "80190110",
                                    "speaker": "凯瑟琳",
                                    "text": "于是从冒险家协会信誉与须弥分会业绩的角度，我希望可以委托给近些年委托完成率最高的冒险家…"
                                },
                                {
                                    "id": "80190111",
                                    "speaker": "派蒙",
                                    "text": "…那当然就是我们啦！",
                                    "choices": [
                                        {
                                            "id": "80190112",
                                            "text": "派蒙最吃这一套了。",
                                            "response": [
                                                {
                                                    "id": "80190114",
                                                    "speaker": "凯瑟琳",
                                                    "text": "呵呵，希望二位可以再尽力尝试一下。"
                                                },
                                                {
                                                    "id": "80190115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "如果你们也做不到的话，我就准备联系委托人，协商取消委托的事宜了。"
                                                },
                                                {
                                                    "id": "80190116",
                                                    "speaker": "派蒙",
                                                    "text": "所以你快说说吧，这个委托究竟是要找谁，难点又在哪里？"
                                                },
                                                {
                                                    "id": "80190117",
                                                    "speaker": "凯瑟琳",
                                                    "text": "寻人委托是由维摩庄的村民们联合发布的，说有一位村民失踪了…"
                                                },
                                                {
                                                    "id": "80190118",
                                                    "speaker": "凯瑟琳",
                                                    "text": "不过…他们甚至连那个人叫什么都不知道，只记得他的大致特征和样貌。"
                                                },
                                                {
                                                    "id": "80190119",
                                                    "speaker": "派蒙",
                                                    "text": "啊？都是一个村子的人，连名字都不知道吗？"
                                                },
                                                {
                                                    "id": "80190120",
                                                    "speaker": "派蒙",
                                                    "text": "而且那么多冒险家最后都失败了，有没有可能根本就没有这个人？或者说是…恶作剧之类的？"
                                                },
                                                {
                                                    "id": "80190121",
                                                    "speaker": "凯瑟琳",
                                                    "text": "这种可能性不大，过来发布委托的村民有好几个，看他们的神情和语气都十分恳切，不像是在开玩笑。"
                                                },
                                                {
                                                    "id": "80190122",
                                                    "speaker": "凯瑟琳",
                                                    "text": "更何况发布委托也是需要支付摩拉作为手续费的，这种恶作剧对他们来说也没有任何好处。"
                                                },
                                                {
                                                    "id": "80190123",
                                                    "speaker": "Player",
                                                    "text": "确实有点蹊跷…"
                                                },
                                                {
                                                    "id": "80190124",
                                                    "speaker": "凯瑟琳",
                                                    "text": "总之，你们可以先到维摩庄问问看，虽然我这里也有一些资料，但还是直接从村民口中来获取信息更加稳妥，以防误导。"
                                                },
                                                {
                                                    "id": "80190125",
                                                    "speaker": "派蒙",
                                                    "text": "#嗯，那走吧，{NICKNAME}，我都开始有些好奇了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80190113",
                                            "text": "我也不保证能完成哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80190104",
                            "text": "交给我吧，是要对付哪个魔神？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801902",
            "objective": "前往维摩庄",
            "dialogues": [
                {
                    "id": "80190201",
                    "speaker": "巴兰",
                    "text": "只要他别出事就行，拜托你们再尽力找找了。"
                }
            ]
        },
        {
            "id": "801903",
            "objective": "与巴兰对话",
            "dialogues": [
                {
                    "id": "80190301",
                    "speaker": "巴兰",
                    "text": "哟，你好，是想买点什么东西吗，我在这一带做生意…"
                },
                {
                    "id": "80190302",
                    "speaker": "派蒙",
                    "text": "不是不是，我们是专程过来的冒险家，刚刚在凯瑟琳那里接到了维摩庄的委托…"
                },
                {
                    "id": "80190303",
                    "speaker": "巴兰",
                    "text": "那件事啊，唉…也算是劳烦你们这些冒险家一趟一趟往这里跑了。"
                },
                {
                    "id": "80190304",
                    "speaker": "巴兰",
                    "text": "老实说，我们大家都不怎么抱希望了，每次都是有人信誓旦旦来帮忙找人，结果很快就铩羽而归。"
                },
                {
                    "id": "80190305",
                    "speaker": "巴兰",
                    "text": "各种线索我们都被问烦了，维摩庄周边也快被掘地三尺了，就是没有任何新的进展…"
                },
                {
                    "id": "80190306",
                    "speaker": "派蒙",
                    "text": "那他到底叫什么？原本住在哪里？他的亲人们呢？"
                },
                {
                    "id": "80190307",
                    "speaker": "巴兰",
                    "text": "不知道，不知道，不知道。"
                },
                {
                    "id": "80190308",
                    "speaker": "派蒙",
                    "text": "呃…就这么不耐烦吗？"
                },
                {
                    "id": "80190309",
                    "speaker": "巴兰",
                    "text": "啊…不好意思，我那不是不耐烦，而是依次回答了你的三个问题。",
                    "choices": [
                        {
                            "id": "80190310",
                            "text": "三问三不知吗？",
                            "response": [
                                {
                                    "id": "80190312",
                                    "speaker": "巴兰",
                                    "text": "话虽这么说，但其实我们都对他印象很深的，都是在维摩庄过日子的人嘛，记忆里也一起做过很多事。"
                                },
                                {
                                    "id": "80190313",
                                    "speaker": "巴兰",
                                    "text": "只是并不了解他的这些具体情况罢了，也可能以前知道，但现在没人记得了…"
                                },
                                {
                                    "id": "80190314",
                                    "speaker": "巴兰",
                                    "text": "反正村里大家交换过情报，结论就是如此。"
                                },
                                {
                                    "id": "80190315",
                                    "speaker": "派蒙",
                                    "text": "好吧，就当是这样吧…那么他是一个怎样的人呢？"
                                },
                                {
                                    "id": "80190316",
                                    "speaker": "巴兰",
                                    "text": "他呀，印象里是个二十岁出头的小伙子，非常热心肠，人又和善…"
                                },
                                {
                                    "id": "80190317",
                                    "speaker": "巴兰",
                                    "text": "我这边没什么客人的时候，偶尔就和他聊聊天。有时候又看见他冒冒失失地给人家帮忙，哈哈…挺有意思的小伙子。"
                                },
                                {
                                    "id": "80190318",
                                    "speaker": "派蒙",
                                    "text": "看起来你对他的评价还不错嘛，一聊起他，表情都不像之前那么愁眉苦脸了。"
                                },
                                {
                                    "id": "80190319",
                                    "speaker": "巴兰",
                                    "text": "可不是嘛，大家应该都挺喜欢他的，不然也不会一起到冒险家协会发委托找他。"
                                },
                                {
                                    "id": "80190320",
                                    "speaker": "巴兰",
                                    "text": "像他这样单纯的年轻人不多见了，怎么就忽然消失了呢，但愿不是出了什么不好的事…"
                                },
                                {
                                    "id": "80190321",
                                    "speaker": "派蒙",
                                    "text": "或许…只是偷偷搬走了之类的？"
                                },
                                {
                                    "id": "80190322",
                                    "speaker": "巴兰",
                                    "text": "不会的，以他的性格不可能会不辞而别。就算如此，他搬家的事也不可能躲过我们维摩庄所有人的视线…"
                                },
                                {
                                    "id": "80190323",
                                    "speaker": "派蒙",
                                    "text": "唔…好吧，谢谢你的情报，我们再到别处问问。"
                                }
                            ]
                        },
                        {
                            "id": "80190311",
                            "text": "那你们究竟知道点什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801904",
            "objective": "与阿玛兹亚对话",
            "dialogues": [
                {
                    "id": "80190401",
                    "speaker": "阿玛兹亚",
                    "text": "是客人吗？"
                },
                {
                    "id": "80190402",
                    "speaker": "派蒙",
                    "text": "你好，阿玛兹亚爷爷，我们是接到维摩庄的委托才过来的。"
                },
                {
                    "id": "80190403",
                    "speaker": "阿玛兹亚",
                    "text": "哦，那可真是辛苦你们了，这么大老远过来，那孩子的事儿就拜托你们了。"
                },
                {
                    "id": "80190404",
                    "speaker": "派蒙",
                    "text": "能多给我们讲一些失踪者的事情吗？"
                },
                {
                    "id": "80190405",
                    "speaker": "阿玛兹亚",
                    "text": "当然可以，只要能对你们有帮助。"
                },
                {
                    "id": "80190406",
                    "speaker": "阿玛兹亚",
                    "text": "我虽然眼睛不太好，但过去总是能听到他的声音，现在听不到了就感觉心里空落落的。"
                },
                {
                    "id": "80190407",
                    "speaker": "阿玛兹亚",
                    "text": "他的父母好像都不在维摩庄，但那孩子看起来一点也不孤单，还总是愿意做那个陪伴他人的人。"
                },
                {
                    "id": "80190408",
                    "speaker": "阿玛兹亚",
                    "text": "他经常去孤寡老人家里做客，也喜欢带着村里的孤儿一起玩。"
                },
                {
                    "id": "80190409",
                    "speaker": "阿玛兹亚",
                    "text": "不管谁遇到了伤心的事，他都乐意听人家倾诉，又总是很会安慰人。"
                },
                {
                    "id": "80190410",
                    "speaker": "阿玛兹亚",
                    "text": "身为村长，我真的要好好感谢他。从精神上帮助那些身处困难的人，本应是我职责的一部分。"
                },
                {
                    "id": "80190411",
                    "speaker": "派蒙",
                    "text": "难怪他失踪了以后，你们那么着急，原来是这样一个温柔的好人呀。"
                },
                {
                    "id": "80190412",
                    "speaker": "派蒙",
                    "text": "可是…关于他的名字、住所、家庭情况之类的，村长你也完全没有线索是吗？"
                },
                {
                    "id": "80190413",
                    "speaker": "阿玛兹亚",
                    "text": "唉…这也是让我十分惭愧的事，无论如何我都应该记得的，或许是我真的年纪大了…这些我怎么也想不起来了。"
                },
                {
                    "id": "80190414",
                    "speaker": "派蒙",
                    "text": "啊…没关系的，不用强求，我们会想想办法…"
                },
                {
                    "id": "80190415",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你现在怎么看？",
                    "choices": [
                        {
                            "id": "80190416",
                            "text": "感觉…并不是一个简单的失踪案。",
                            "response": [
                                {
                                    "id": "80190418",
                                    "speaker": "派蒙",
                                    "text": "是呀，我也这么觉得…再怎么说，他的名字都没人记得了也太奇怪了…"
                                },
                                {
                                    "id": "80190419",
                                    "speaker": "派蒙",
                                    "text": "住所和家人也都没有相关线索，这个人简直就像从现实里被抹去了一样。",
                                    "choices": [
                                        {
                                            "id": "80190420",
                                            "text": "不，我倒觉得更像是…",
                                            "response": [
                                                {
                                                    "id": "80190422",
                                                    "speaker": "派蒙",
                                                    "text": "唔…你的意思是说，从现实的角度来看，不是「被抹去」，而是从来都「不存在」？"
                                                },
                                                {
                                                    "id": "80190423",
                                                    "speaker": "派蒙",
                                                    "text": "等等，这对我来说有点难理解…只存在于记忆里的人…"
                                                },
                                                {
                                                    "id": "80190424",
                                                    "speaker": "Player",
                                                    "text": "（会不会和大慈树王那时候一样，出现了群体性的记忆变动…？）"
                                                },
                                                {
                                                    "id": "80190425",
                                                    "speaker": "？？？",
                                                    "text": "你们是…刚到维摩庄的冒险家？是接到委托才来的吗？"
                                                },
                                                {
                                                    "id": "80190426",
                                                    "speaker": "派蒙",
                                                    "text": "啊，没错没错，我们正在调查失踪者的事…"
                                                },
                                                {
                                                    "id": "80190427",
                                                    "speaker": "？？？",
                                                    "text": "太好了，谢谢你们还没有放弃，我一直都担心冒险家协会要把我们的委托撤掉了…"
                                                },
                                                {
                                                    "id": "80190428",
                                                    "speaker": "阿托莎",
                                                    "text": "我叫阿托莎，也住在维摩庄。请你们一定要再努力试试看，拜托了…",
                                                    "choices": [
                                                        {
                                                            "id": "80190429",
                                                            "text": "一定会找到的。",
                                                            "response": [
                                                                {
                                                                    "id": "80190431",
                                                                    "speaker": "派蒙",
                                                                    "text": "这位小姐你不要着急，你和失踪者很熟吗？有没有可以提供给我们的线索呀？"
                                                                },
                                                                {
                                                                    "id": "80190432",
                                                                    "speaker": "阿托莎",
                                                                    "text": "线索…我也不知道能不能算是线索，你们跟我来，我带你们去一个地方。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80190430",
                                                            "text": "只能说尽力而为。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80190421",
                                            "text": "…只存在于记忆里的人。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80190417",
                            "text": "不协调的地方很多。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801905",
            "objective": "前往阿托莎所指引的地方",
            "dialogues": [
                {
                    "id": "80190501",
                    "speaker": "派蒙",
                    "text": "就是这里吗？这棵树下？"
                },
                {
                    "id": "80190502",
                    "speaker": "阿托莎",
                    "text": "嗯，看似平平无奇，但对我来说又充满回忆的地方…"
                },
                {
                    "id": "80190503",
                    "speaker": "阿托莎",
                    "text": "我们曾经会坐在这棵树下聊天，看着天空中的云朵，感受风的方向，一坐就是很久很久。"
                },
                {
                    "id": "80190504",
                    "speaker": "阿托莎",
                    "text": "我是在森林里被巡林员发现，后来被维摩庄收养的孩子。"
                },
                {
                    "id": "80190505",
                    "speaker": "阿托莎",
                    "text": "尽管大家对我很好，每天也过得很热闹，但曾经的我还是会感觉到孤独…"
                },
                {
                    "id": "80190506",
                    "speaker": "派蒙",
                    "text": "孤独？"
                },
                {
                    "id": "80190507",
                    "speaker": "阿托莎",
                    "text": "唔…怎么说呢，有些心事不管是开心也好，伤心也罢，总是不知道该向谁倾诉，或者说不知道该不该倾诉…"
                },
                {
                    "id": "80190508",
                    "speaker": "阿托莎",
                    "text": "大家都有自己的生活，有些时候敞开心扉或许只会给别人带来麻烦。",
                    "choices": [
                        {
                            "id": "80190509",
                            "text": "我大概能懂。",
                            "response": [
                                {
                                    "id": "80190511",
                                    "speaker": "阿托莎",
                                    "text": "欸，你也是这样的吗？",
                                    "choices": [
                                        {
                                            "id": "80190512",
                                            "text": "我曾经有一位亲人愿意听我倾诉…",
                                            "response": [
                                                {
                                                    "id": "80190514",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿。"
                                                },
                                                {
                                                    "id": "80190515",
                                                    "speaker": "阿托莎",
                                                    "text": "是吗，那可太好了，真是羡慕你…而对我来说，「他」应该又像是亲人，又像一位能理解我的朋友吧。"
                                                },
                                                {
                                                    "id": "80190516",
                                                    "speaker": "阿托莎",
                                                    "text": "不管我遇到了什么，都可以毫无顾忌地对他说…"
                                                },
                                                {
                                                    "id": "80190517",
                                                    "speaker": "阿托莎",
                                                    "text": "他的心思单纯又细腻，脸上的表情也总是充满了耐心与兴趣，就好像在听他自己的事情一样。"
                                                },
                                                {
                                                    "id": "80190518",
                                                    "speaker": "阿托莎",
                                                    "text": "…自从他消失以后，我真的有好多事情想要和他讲…"
                                                },
                                                {
                                                    "id": "80190519",
                                                    "speaker": "阿托莎",
                                                    "text": "不不，那些事情也都没那么重要了，只要能再见到他就好…"
                                                },
                                                {
                                                    "id": "80190520",
                                                    "speaker": "派蒙",
                                                    "text": "你们两个，关系真的很好呢…"
                                                },
                                                {
                                                    "id": "80190521",
                                                    "speaker": "派蒙",
                                                    "text": "那在你的印象里，他有说过什么关于自己的事情吗？"
                                                },
                                                {
                                                    "id": "80190522",
                                                    "speaker": "阿托莎",
                                                    "text": "唔…他讲的大概都是维摩庄里他见到的趣事，还有自己的很多天马行空的想法…"
                                                },
                                                {
                                                    "id": "80190523",
                                                    "speaker": "阿托莎",
                                                    "text": "哦对了，我有一次问过他，他的父母在哪里…但他只是回答说——「他们不在这里了」。"
                                                },
                                                {
                                                    "id": "80190524",
                                                    "speaker": "阿托莎",
                                                    "text": "我也不敢追问，那究竟只是离开了，还是不在人世了的意思…"
                                                },
                                                {
                                                    "id": "80190525",
                                                    "speaker": "派蒙",
                                                    "text": "还是没什么线索吗…"
                                                },
                                                {
                                                    "id": "80190526",
                                                    "speaker": "阿托莎",
                                                    "text": "聊了这么多，还是没能帮上忙，实在是抱歉…",
                                                    "choices": [
                                                        {
                                                            "id": "80190527",
                                                            "text": "别这么说。",
                                                            "response": [
                                                                {
                                                                    "id": "80190529",
                                                                    "speaker": "阿托莎",
                                                                    "text": "上次一口气说这么多话，还是和他一起的时候。"
                                                                },
                                                                {
                                                                    "id": "80190530",
                                                                    "speaker": "阿托莎",
                                                                    "text": "这么说来，好像每次和他聊天，也都是在这样的黄昏时分。"
                                                                },
                                                                {
                                                                    "id": "80190531",
                                                                    "speaker": "阿托莎",
                                                                    "text": "在记忆里，时间会变得很慢很慢，有时候感觉明明聊了很久很久，可是天却还没有暗下来…"
                                                                },
                                                                {
                                                                    "id": "80190532",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好像放松下来以后，时间就是会变慢呢…欸，你怎么了，{NICKNAME}？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80190533",
                                                                            "text": "每次都是同一时间…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80190535",
                                                                                    "speaker": "Player",
                                                                                    "text": "（情报收集到这里，感觉已经完全不能作为普通的寻人委托来处理了…）"
                                                                                },
                                                                                {
                                                                                    "id": "80190536",
                                                                                    "speaker": "Player",
                                                                                    "text": "（反倒是刚刚阿托莎所说的，关于时间的问题，或许才是解开谜团的契机…）"
                                                                                },
                                                                                {
                                                                                    "id": "80190537",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#…喂，{NICKNAME}，那边的几个丘丘人，是不是样子有些古怪？"
                                                                                },
                                                                                {
                                                                                    "id": "80190538",
                                                                                    "speaker": "Player",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "80190539",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸，深渊教团？难道是他们搞的鬼吗？"
                                                                                },
                                                                                {
                                                                                    "id": "80190540",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#发现我们了，{NICKNAME}，快迎战吧！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80190534",
                                                                            "text": "时间似乎不会流逝…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80190528",
                                                            "text": "至少我们更加了解他了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80190513",
                                            "text": "不过我现在拥有更多理解我的朋友。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80190510",
                            "text": "这就是「亲人」存在的意义吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801906",
            "objective": "击退深渊教团的魔物",
            "dialogues": [
                {
                    "id": "80190601",
                    "speaker": "阿玛兹亚",
                    "text": "你们找的时候，我也会再努力回想一下的…能想到什么的话就联系你们。"
                }
            ]
        },
        {
            "id": "801907",
            "objective": "与阿托莎对话",
            "dialogues": [
                {
                    "id": "80190701",
                    "speaker": "阿托莎",
                    "text": "谢谢你们，没想到这里也会有魔物出现，要不是你们在可就麻烦了…"
                },
                {
                    "id": "80190702",
                    "speaker": "派蒙",
                    "text": "举手之劳罢了！",
                    "choices": [
                        {
                            "id": "80190703",
                            "text": "问题的关键在于…",
                            "response": [
                                {
                                    "id": "80190705",
                                    "speaker": "阿托莎",
                                    "text": "这么说起来，最近维摩庄附近的丘丘人们确实比之前要活跃很多…"
                                },
                                {
                                    "id": "80190706",
                                    "speaker": "阿托莎",
                                    "text": "它们经常表现得躁动不安，有时还会进行无差别的攻击，村长已经不让孩子们在维摩庄周边玩了。"
                                },
                                {
                                    "id": "80190707",
                                    "speaker": "派蒙",
                                    "text": "唔…难道真的和深渊教团有关？"
                                },
                                {
                                    "id": "80190708",
                                    "speaker": "派蒙",
                                    "text": "以防万一，我们还是回维摩庄看看情况吧，但愿村民们不会遇上什么危险。"
                                }
                            ]
                        },
                        {
                            "id": "80190704",
                            "text": "这一带为何会有深渊教团在活动。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80199901",
                    "speaker": "派蒙",
                    "text": "到维摩庄了，先去找村民们问问关于失踪者的情报吧？"
                },
                {
                    "id": "80199902",
                    "speaker": "派蒙",
                    "text": "解决最困难的委托，要从最细致的调查开始！"
                }
            ]
        }
    ]
}