    },
    "talks": [
        {
            "id": "7224901",
            "objective": "(test)解锁5个封印$HIDDEN",
            "dialogues": [
                {
                    "id": "722490101",
                    "speaker": "阿倍良久",
                    "text": "旅者啊，汝准备好了吗？"
                }
            ]
        },
        {
            "id": "7224905",
            "objective": "与残魂对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722490301",
                    "speaker": "阿倍良久",
                    "text": "吾乃…"
                },
                {
                    "id": "722490302",
                    "speaker": "阿倍良久",
                    "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
                },
                {
                    "id": "722490303",
                    "speaker": "派蒙",
                    "text": "嗯，赫利俄斯？"
                },
                {
                    "id": "722490304",
                    "speaker": "派蒙",
                    "text": "赫利俄斯是什么很了不起的东西吗？"
                },
                {
                    "id": "722490305",
                    "speaker": "阿倍良久",
                    "text": "当然！吾当时主持建造赫利俄斯，举全国之力，以此抵御深海龙嗣。"
                },
                {
                    "id": "722490306",
                    "speaker": "阿倍良久",
                    "text": "是整个白夜国，除吾之外，再无第二人能完成的伟业！"
                },
                {
                    "id": "722490307",
                    "speaker": "派蒙",
                    "text": "啊，听上去真是了不起。"
                },
                {
                    "id": "722490308",
                    "speaker": "派蒙",
                    "text": "可是这么了不起的大人物，为什么会被封在这里呢？"
                },
                {
                    "id": "722490309",
                    "speaker": "阿倍良久",
                    "text": "吾…吾是被人背叛…"
                },
                {
                    "id": "722490310",
                    "speaker": "阿倍良久",
                    "text": "当初天国塌落于无底深渊之下，诸民受龙嗣所害，是吾，吾掌持建造赫利俄斯，以此救众生于倒悬。"
                },
                {
                    "id": "722490311",
                    "speaker": "阿倍良久",
                    "text": "可是那群贪鄙小人！一旦性命无虞，就行欺上瞒下之事…最后竟还，推举稚童作国首。可笑！"
                },
                {
                    "id": "722490312",
                    "speaker": "阿倍良久",
                    "text": "就连吾也被他们陷害，身死囹圄之中！"
                },
                {
                    "id": "722490313",
                    "speaker": "阿倍良久",
                    "text": "可恶！可恶！"
                },
                {
                    "id": "722490314",
                    "speaker": "阿倍良久",
                    "text": "对了，汝。",
                    "choices": [
                        {
                            "id": "722490315",
                            "text": "我？",
                            "response": [
                                {
                                    "id": "722490316",
                                    "speaker": "派蒙",
                                    "text": "是你。"
                                },
                                {
                                    "id": "722490320",
                                    "speaker": "阿倍良久",
                                    "text": "就是汝！"
                                },
                                {
                                    "id": "722490321",
                                    "speaker": "阿倍良久",
                                    "text": "原本吾之圣服被放置于此，只可惜年月之久，仅余残丝败缕，已难以作为凭依。"
                                },
                                {
                                    "id": "722490322",
                                    "speaker": "阿倍良久",
                                    "text": "只要汝能通过考验，吾就将寄托意念的供奉之物托付于汝。"
                                },
                                {
                                    "id": "722490323",
                                    "speaker": "阿倍良久",
                                    "text": "希望汝能…成功通过…"
                                },
                                {
                                    "id": "722490324",
                                    "speaker": "阿倍良久",
                                    "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
                                }
                            ]
                        },
                        {
                            "id": "722490317",
                            "text": "派蒙，在叫你！",
                            "response": [
                                {
                                    "id": "722490318",
                                    "speaker": "派蒙",
                                    "text": "欸，他明明就在看着你嘛。"
                                },
                                {
                                    "id": "722490319",
                                    "speaker": "派蒙",
                                    "text": "（而且眼神还相当热切的样子。）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224902",
            "objective": "开启残魂的试炼",
            "dialogues": [
                {
                    "id": "722490501",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "722490502",
                    "speaker": "阿倍良久",
                    "text": "那就祝汝……武运昌隆。"
                }
            ]
        },
        {
            "id": "7224903",
            "objective": "(test)挑战开启,失败回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7224904",
            "objective": "从残魂处取得供奉之物",
            "dialogues": [
                {
                    "id": "722490201",
                    "speaker": "阿倍良久",
                    "text": "好、好啊！如果是汝一定能做到…"
                },
                {
                    "id": "722490202",
                    "speaker": "阿倍良久",
                    "text": "吾委命于汝，将、将这些供奉之物…这些供奉之物…一定要…"
                },
                {
                    "id": "722490203",
                    "speaker": "阿倍良久",
                    "text": "一定要将之取走，拿到…"
                },
                {
                    "id": "722490204",
                    "speaker": "阿倍良久",
                    "text": "拿到…"
                },
                {
                    "id": "722490205",
                    "speaker": "派蒙",
                    "text": "怎么回事？"
                },
                {
                    "id": "722490206",
                    "speaker": "派蒙",
                    "text": "残魂先生的声音怎么越来越模糊了。"
                },
                {
                    "id": "722490207",
                    "speaker": "阿倍良久",
                    "text": "拿到…供奉之处…众魂归一，如此才能…"
                },
                {
                    "id": "722490208",
                    "speaker": "派蒙",
                    "text": "残魂先生？"
                },
                {
                    "id": "722490209",
                    "speaker": "阿倍良久",
                    "text": "如此才能…如此才能…"
                },
                {
                    "id": "722490210",
                    "speaker": "派蒙",
                    "text": "如此才能什么呀？"
                },
                {
                    "id": "722490211",
                    "speaker": "阿倍良久",
                    "text": "如此才能…"
                },
                {
                    "id": "722490212",
                    "speaker": "派蒙",
                    "text": "唔，不清不楚的，不过刚才听残魂先生的意思，好像是要把这些供奉品拿到什么地方去。"
                },
                {
                    "id": "722490213",
                    "speaker": "派蒙",
                    "text": "这供奉品放在这里这么久，不知道里面有没有吃的…"
                },
                {
                    "id": "722490214",
                    "speaker": "Player",
                    "text": "你别偷吃哦…"
                },
                {
                    "id": "722490215",
                    "speaker": "派蒙",
                    "text": "我、我也不是什么东西都吃的！"
                },
                {
                    "id": "722490216",
                    "speaker": "派蒙",
                    "text": "#好了，{NICKNAME}，收下供奉之物吧。"
                }
            ]
        },
        {
            "id": "7224906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722490601",
                    "speaker": "Player",
                    "text": "不，还需要准备一下。"
                },
                {
                    "id": "722490602",
                    "speaker": "阿倍良久",
                    "text": "那就静候汝之佳音了。"
                }
            ]
        }
    ]
}