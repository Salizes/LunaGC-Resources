    "talks": [
        {
            "id": "7224401",
            "objective": "(test)和NPC对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722440101",
                    "speaker": "？？？",
                    "text": "嗯？真是古怪，妾身已很久未见你们这样穿着之人了…"
                },
                {
                    "id": "722440102",
                    "speaker": "？？？",
                    "text": "言行举止，看上去也并非白夜国民。"
                },
                {
                    "id": "722440103",
                    "speaker": "？？？",
                    "text": "难不成，是自异邦落入此处的旅客么。"
                },
                {
                    "id": "722440104",
                    "speaker": "Player",
                    "text": "是的…"
                },
                {
                    "id": "722440105",
                    "speaker": "？？？",
                    "text": "没想到，白夜国竟然也有来自世外的通途吗…真是令人惊讶。"
                },
                {
                    "id": "722440106",
                    "speaker": "？？？",
                    "text": "说来，妾身从出生起就在白夜国，从未见过世外之人。"
                },
                {
                    "id": "722440107",
                    "speaker": "？？？",
                    "text": "从前，有人向妾身提及此事，说想要一窥天外风景，妾身都以为是他的玩笑话…"
                },
                {
                    "id": "722440108",
                    "speaker": "久利由卖",
                    "text": "唉…"
                },
                {
                    "id": "722440109",
                    "speaker": "？？？",
                    "text": "旅者啊，其实妾身有一事相求。"
                },
                {
                    "id": "722440110",
                    "speaker": "？？？",
                    "text": "在白夜之国各处，有七座压着「太阳{RUBY#[D]法厄同}之子」遗服的御陵墓石。"
                },
                {
                    "id": "722440111",
                    "speaker": "派蒙",
                    "text": "太阳之子…"
                },
                {
                    "id": "722440112",
                    "speaker": "？？？",
                    "text": "嗯，白夜国崇尚大日御舆。"
                },
                {
                    "id": "722440113",
                    "speaker": "？？？",
                    "text": "每隔数年，便有出世孩童被擢选为太阳之子，执掌国家。"
                },
                {
                    "id": "722440114",
                    "speaker": "？？？",
                    "text": "太阳之子…一共有七位。"
                },
                {
                    "id": "722440115",
                    "speaker": "？？？",
                    "text": "在白夜国很难遇到异乡的旅客，拜托了，请去他们墓冢之前凭吊一番吧。"
                },
                {
                    "id": "722440116",
                    "speaker": "派蒙",
                    "text": "咦，可是，为什么要让我们这些外来者去凭吊呢。"
                },
                {
                    "id": "722440117",
                    "speaker": "派蒙",
                    "text": "一般来说，不是熟人去凭吊比较好吗…"
                },
                {
                    "id": "722440118",
                    "speaker": "？？？",
                    "text": "按常理而言，确是如此。"
                },
                {
                    "id": "722440119",
                    "speaker": "？？？",
                    "text": "唉，只是，白夜之国的居民应该无人会想要凭吊他们吧。"
                },
                {
                    "id": "722440120",
                    "speaker": "？？？",
                    "text": "甚至，那些墓上的御陵墓石也久未祭拜了。"
                },
                {
                    "id": "722440121",
                    "speaker": "派蒙",
                    "text": "可是…这是为什么呀？"
                },
                {
                    "id": "722440122",
                    "speaker": "派蒙",
                    "text": "难道这个国家的国民，都不喜欢那些太阳之子吗？"
                },
                {
                    "id": "722440123",
                    "speaker": "？？？",
                    "text": "与其说是不喜欢…不如说是痛恨。"
                },
                {
                    "id": "722440124",
                    "speaker": "？？？",
                    "text": "刚才说过，太阳之子是刚出生就成为太阳之子的。"
                },
                {
                    "id": "722440125",
                    "speaker": "？？？",
                    "text": "这样的孩子又怎么会治理国家，真正把持国度的是太阳之子背后的大人们。"
                },
                {
                    "id": "722440126",
                    "speaker": "？？？",
                    "text": "太阳之子只是听凭他们摆布的傀儡。"
                },
                {
                    "id": "722440127",
                    "speaker": "？？？",
                    "text": "只不过…那些大人们贪得无厌，收刮民脂，操纵太阳之子做过许多残忍之事。"
                },
                {
                    "id": "722440128",
                    "speaker": "？？？",
                    "text": "由是，民怨愤起，将许多过错归咎于太阳之子…"
                },
                {
                    "id": "722440129",
                    "speaker": "派蒙",
                    "text": "怎么会这样…"
                },
                {
                    "id": "722440130",
                    "speaker": "派蒙",
                    "text": "明明太阳之子是无辜的。"
                },
                {
                    "id": "722440131",
                    "speaker": "？？？",
                    "text": "…不，他们并不无辜。"
                },
                {
                    "id": "722440132",
                    "speaker": "？？？",
                    "text": "对于白夜国民而言，他们、太阳之子的无知就是最大的过错。"
                },
                {
                    "id": "722440133",
                    "speaker": "？？？",
                    "text": "人因无知而犯下的罪，确实伤害到了他人，这人真的能被称为是无辜的吗…"
                },
                {
                    "id": "722440134",
                    "speaker": "？？？",
                    "text": "恐怕很难吧，皆因造成的伤害已无法挽回。",
                    "choices": [
                        {
                            "id": "722440135",
                            "text": "既然这样…",
                            "response": [
                                {
                                    "id": "722440137",
                                    "speaker": "？？？",
                                    "text": "这算是…妾身的私情之托。"
                                },
                                {
                                    "id": "722440138",
                                    "speaker": "久利由卖",
                                    "text": "妾身名为久利由卖，是大日御舆内，负责照顾太阳之子起居的女官。"
                                },
                                {
                                    "id": "722440139",
                                    "speaker": "久利由卖",
                                    "text": "虽然知道他们所行是错误的，知道他们处处被人操控…"
                                },
                                {
                                    "id": "722440140",
                                    "speaker": "久利由卖",
                                    "text": "可毕竟是妾身看着长大的孩子，妾身对他们，可怜有之，悲哀有之…"
                                },
                                {
                                    "id": "722440141",
                                    "speaker": "久利由卖",
                                    "text": "却唯独…无法恨他们。"
                                },
                                {
                                    "id": "722440142",
                                    "speaker": "久利由卖",
                                    "text": "况且，虽然由于妾身的职务，能日日与太阳之子接触，却囿于周围严苛的监视…"
                                },
                                {
                                    "id": "722440143",
                                    "speaker": "久利由卖",
                                    "text": "在他们身边时，不被允许开口说出任何一句言辞。"
                                },
                                {
                                    "id": "722440144",
                                    "speaker": "久利由卖",
                                    "text": "那些孩子，在四下无人，彷徨无助之时。他们向妾身说了那么多、那么多话语……"
                                },
                                {
                                    "id": "722440145",
                                    "speaker": "久利由卖",
                                    "text": "妾身却无法作出任何回应。"
                                },
                                {
                                    "id": "722440146",
                                    "speaker": "久利由卖",
                                    "text": "如果，如果妾身那时能够提起舍生的勇气，对他们说些什么的话…"
                                },
                                {
                                    "id": "722440147",
                                    "speaker": "久利由卖",
                                    "text": "或许…一切都会有所不同吧。"
                                },
                                {
                                    "id": "722440148",
                                    "speaker": "久利由卖",
                                    "text": "拜托了，时至今日，妾身已无颜面对他们，只得在此作些祭拜。"
                                },
                                {
                                    "id": "722440149",
                                    "speaker": "久利由卖",
                                    "text": "凭吊之事，还请旅者大人帮妾身一次吧。"
                                },
                                {
                                    "id": "722440150",
                                    "speaker": "久利由卖",
                                    "text": "只需要，在他们的墓前…放下一枚「珊瑚真珠」即可。"
                                },
                                {
                                    "id": "722440153",
                                    "speaker": "久利由卖",
                                    "text": "这样，就能点燃此处石龛上的魂灯，打开前往引魂之处的道路，为他们祈求安魂…"
                                },
                                {
                                    "id": "722440151",
                                    "speaker": "Player",
                                    "text": "好。"
                                },
                                {
                                    "id": "722440152",
                                    "speaker": "久利由卖",
                                    "text": "多谢，那就…麻烦你们了。"
                                }
                            ]
                        },
                        {
                            "id": "722440136",
                            "text": "为什么还要凭吊？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224402",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": [
                {
                    "id": "722440201",
                    "speaker": "久利由卖",
                    "text": "太阳之子…一共有七位。旅者啊，请在他们的御陵墓石前，替妾身凭吊一番吧。"
                }
            ]
        },
        {
            "id": "7224403",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": [
                {
                    "id": "722440301",
                    "speaker": "久利由卖",
                    "text": "如是，七盏魂灯既已亮起…"
                },
                {
                    "id": "722440302",
                    "speaker": "久利由卖",
                    "text": "看来你们已经完成凭吊了。你们的帮助，妾身铭感于心。"
                },
                {
                    "id": "722440303",
                    "speaker": "久利由卖",
                    "text": "那么，现在就由妾身为你们来打开…通往引魂之地的道路吧。"
                },
                {
                    "id": "722440304",
                    "speaker": "久利由卖",
                    "text": "异乡的旅者啊，因妾身私念为你造成了许多麻烦…不过妾身仍希望你能见证安魂之仪。"
                },
                {
                    "id": "722440305",
                    "speaker": "久利由卖",
                    "text": "请随着这条道路前进吧，妾身会在那里等你的。"
                }
            ]
        },
        {
            "id": "7224404",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": [
                {
                    "id": "722440401",
                    "speaker": "久利由卖",
                    "text": "旅者啊，你来了。"
                },
                {
                    "id": "722440402",
                    "speaker": "久利由卖",
                    "text": "此处是引魂之处，也是妾身最后的执念所在。"
                },
                {
                    "id": "722440403",
                    "speaker": "久利由卖",
                    "text": "太阳之子每到了一定岁数，就会按典仪，于生辰之日进入大日御舆。",
                    "choices": [
                        {
                            "id": "722440404",
                            "text": "进入大日御舆？",
                            "response": [
                                {
                                    "id": "722440406",
                                    "speaker": "久利由卖",
                                    "text": "是啊，所谓的进入大日御舆，即是「归日之祭」。"
                                },
                                {
                                    "id": "722440407",
                                    "speaker": "久利由卖",
                                    "text": "太阳之子从大日御舆而出，在被凡尘浊世侵染之前，回归太阳御座。"
                                },
                                {
                                    "id": "722440408",
                                    "speaker": "久利由卖",
                                    "text": "…大日御舆温度之高可炽照白夜之国。"
                                },
                                {
                                    "id": "722440409",
                                    "speaker": "久利由卖",
                                    "text": "太阳之子中，最后回到引魂之处的，都已经是残缺魂魄。"
                                },
                                {
                                    "id": "722440410",
                                    "speaker": "久利由卖",
                                    "text": "但是妾身还是觉得，或许…"
                                },
                                {
                                    "id": "722440411",
                                    "speaker": "Player",
                                    "text": "或许？"
                                },
                                {
                                    "id": "722440412",
                                    "speaker": "久利由卖",
                                    "text": "或许妾身打开引魂之地，就能够靠自己的记忆补足他们的残魂。"
                                },
                                {
                                    "id": "722440426",
                                    "speaker": "久利由卖",
                                    "text": "就让妾身一试吧。"
                                },
                                {
                                    "id": "722440427",
                                    "speaker": "久利由卖",
                                    "text": "比螺梦门…御琉部栖…妾身在这里，你们还不归来吗？"
                                },
                                {
                                    "id": "722440428",
                                    "speaker": "久利由卖",
                                    "text": "…"
                                },
                                {
                                    "id": "722440429",
                                    "speaker": "Player",
                                    "text": "怎么样？"
                                },
                                {
                                    "id": "722440430",
                                    "speaker": "久利由卖",
                                    "text": "唉，七任太阳之子中，比螺梦门与御琉部栖由妾身养大，若连他们都不愿回应…"
                                },
                                {
                                    "id": "722440413",
                                    "speaker": "久利由卖",
                                    "text": "看来只有妾身一人的记忆，还是不足够啊…"
                                },
                                {
                                    "id": "722440414",
                                    "speaker": "久利由卖",
                                    "text": "如果有什么作为媒介，若有象征太阳之子正身的御辔就好了。"
                                },
                                {
                                    "id": "722440415",
                                    "speaker": "久利由卖",
                                    "text": "只可惜那枚御辔早就佚失。"
                                },
                                {
                                    "id": "722440416",
                                    "speaker": "久利由卖",
                                    "text": "唉…这个国家，白夜之国，仍然在恨着这些孩子们啊。"
                                },
                                {
                                    "id": "722440417",
                                    "speaker": "久利由卖",
                                    "text": "看来，想要解放他们的残魂，终究只是妾身的痴心妄想罢了。"
                                },
                                {
                                    "id": "722440418",
                                    "speaker": "久利由卖",
                                    "text": "…旅者，算是妾身最后拜托你，能帮忙找寻「神舆之辔」所在吗？"
                                },
                                {
                                    "id": "722440419",
                                    "speaker": "久利由卖",
                                    "text": "虽然，找到的可能也并不大。你已经帮妾身许多，再提出要求也显得有些厚颜无耻。"
                                },
                                {
                                    "id": "722440420",
                                    "speaker": "久利由卖",
                                    "text": "不过…",
                                    "choices": [
                                        {
                                            "id": "722440421",
                                            "text": "我明白了。",
                                            "response": [
                                                {
                                                    "id": "722440423",
                                                    "speaker": "久利由卖",
                                                    "text": "那真是…那真是感谢了…"
                                                },
                                                {
                                                    "id": "722440424",
                                                    "speaker": "久利由卖",
                                                    "text": "不过，御辔丢失已久，也不急于一时。"
                                                },
                                                {
                                                    "id": "722440425",
                                                    "speaker": "久利由卖",
                                                    "text": "若是有消息，便来妾身这儿吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722440422",
                                            "text": "我会尽力。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722440405",
                            "text": "那不就是…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224405",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": [
                {
                    "id": "722440501",
                    "speaker": "久利由卖",
                    "text": "旅者，难道你找到了御辔了么。"
                },
                {
                    "id": "722440502",
                    "speaker": "久利由卖",
                    "text": "能…将御辔交予我一视吗？"
                }
            ]
        },
        {
            "id": "7224406",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": [
                {
                    "id": "722440601",
                    "speaker": "久利由卖",
                    "text": "啊啊，这果然就是，果然就是「神舆之辔」。"
                },
                {
                    "id": "722440602",
                    "speaker": "久利由卖",
                    "text": "没想到，时至今日居然还能够看到它，旅者啊，旅者你是从何处寻到？"
                },
                {
                    "id": "722440603",
                    "speaker": "Player",
                    "text": "阿倍良久…"
                },
                {
                    "id": "722440604",
                    "speaker": "久利由卖",
                    "text": "从阿倍良久命处得到吗？"
                },
                {
                    "id": "722440605",
                    "speaker": "久利由卖",
                    "text": "真是奇怪，妾身记得，那是…白夜国刚建立时的伟大人物。"
                },
                {
                    "id": "722440606",
                    "speaker": "久利由卖",
                    "text": "不过据说他之后想要篡夺白夜国王，也就是太阳之子之位，视为谋逆。"
                },
                {
                    "id": "722440607",
                    "speaker": "久利由卖",
                    "text": "啊…既然你们从他手中取回了这枚御辔，看来背后亦有隐情。"
                },
                {
                    "id": "722440608",
                    "speaker": "久利由卖",
                    "text": "御辔啊，在此重现天日，时也命也…妾身朝思暮想…那些孩子们的脸…"
                },
                {
                    "id": "722440609",
                    "speaker": "久利由卖",
                    "text": "这样一来，妾身也终于有赎罪的机会了。"
                },
                {
                    "id": "722440610",
                    "speaker": "久利由卖",
                    "text": "旅者，将这枚御辔投入引魂之处的池中，有此御辔在，必可复原残魂…"
                },
                {
                    "id": "722440611",
                    "speaker": "久利由卖",
                    "text": "呜…好让他们魂魄健全，魂魄健全地走上往生之路啊！"
                }
            ]
        },
        {
            "id": "7224407",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": []
        },
        {
            "id": "7224408",
            "objective": "在七座御陵墓石前献上珊瑚真珠",
            "dialogues": []
        },
        {
            "id": "7224410",
            "objective": "前往久利由卖处",
            "dialogues": []
        },
        {
            "id": "7224411",
            "objective": "到达引魂之地",
            "dialogues": [
                {
                    "id": "722441101",
                    "speaker": "派蒙",
                    "text": "#一二三……唔，{NICKNAME}，好像已经完成七座墓石的凭吊了！"
                },
                {
                    "id": "722441102",
                    "speaker": "派蒙",
                    "text": "我们回到石头神龛那边，告诉等待在石龛边上的那个残魂吧。"
                }
            ]
        },
        {
            "id": "7224412",
            "objective": "",
            "dialogues": [
                {
                    "id": "722441201",
                    "speaker": "久利由卖",
                    "text": "啊啊…比螺梦门，你喜欢读书，常言有天外之地，那时妾身并不相信…"
                },
                {
                    "id": "722441202",
                    "speaker": "久利由卖",
                    "text": "对你的绮言狂想，每每都只是笑着摇头。妾身该相信你的呀，该相信你的呀！"
                },
                {
                    "id": "722441203",
                    "speaker": "久利由卖",
                    "text": "你说，如有机会，一定要逃出大日御舆，去天外之地冒险…"
                },
                {
                    "id": "722441204",
                    "speaker": "久利由卖",
                    "text": "比螺梦门，现在已不再有人会束缚你了，去吧，去吧！"
                },
                {
                    "id": "722441205",
                    "speaker": "久利由卖",
                    "text": "还有，御琉部栖，御琉部栖，妾身好想再听你歌上一曲啊。"
                },
                {
                    "id": "722441206",
                    "speaker": "久利由卖",
                    "text": "听到你唱歌，听到你那样纯净清澈的歌喉，有谁不悄悄在内心里跟你一起唱呢？"
                },
                {
                    "id": "722441207",
                    "speaker": "久利由卖",
                    "text": "归日之祭前夜，你突然想听妾身的声音，无论如何都想让妾身开口唱给你听。"
                },
                {
                    "id": "722441208",
                    "speaker": "久利由卖",
                    "text": "说没有关系，不管唱多难听，你都不会笑的。"
                },
                {
                    "id": "722441209",
                    "speaker": "久利由卖",
                    "text": "你那个时候是不是已经知道…已经知道归日之祭其实正是自己的终期？"
                },
                {
                    "id": "722441210",
                    "speaker": "久利由卖",
                    "text": "呜…可是妾身到最后也…"
                },
                {
                    "id": "722441211",
                    "speaker": "Player",
                    "text": "久利由卖？"
                },
                {
                    "id": "722441212",
                    "speaker": "久利由卖",
                    "text": "啊啊，不好意思，旅者，妾身失态了。"
                },
                {
                    "id": "722441213",
                    "speaker": "久利由卖",
                    "text": "侍奉太阳之子的女官，为保自身的洁净无瑕…终生不可嫁予他人。"
                },
                {
                    "id": "722441214",
                    "speaker": "久利由卖",
                    "text": "所以妾身一生都没有自己的孩子。"
                },
                {
                    "id": "722441215",
                    "speaker": "久利由卖",
                    "text": "这些孩子，这些由妾身侍奉，看着长大的孩子，不知何时已变得比血脉还要亲近。"
                },
                {
                    "id": "722441216",
                    "speaker": "久利由卖",
                    "text": "多谢你，旅者，多谢你找回了御辔。"
                },
                {
                    "id": "722441217",
                    "speaker": "久利由卖",
                    "text": "这御辔经由每位太阳之子之手，其上承载的记忆足以补全残缺魂魄。"
                },
                {
                    "id": "722441218",
                    "speaker": "久利由卖",
                    "text": "即使，这些记忆也是双面的。",
                    "choices": [
                        {
                            "id": "722441219",
                            "text": "双面的？",
                            "response": [
                                {
                                    "id": "722441221",
                                    "speaker": "久利由卖",
                                    "text": "自然，记忆分为两类，一类是自身之记忆，一类是他人对自身的记忆。"
                                },
                                {
                                    "id": "722441222",
                                    "speaker": "久利由卖",
                                    "text": "补全他们存在的，既有御辔之上，太阳之子自身的记忆…"
                                },
                                {
                                    "id": "722441223",
                                    "speaker": "久利由卖",
                                    "text": "也有御辔作为被白夜国怪罪的孩童们的象征，承载的身为罪孽之子的记忆。"
                                },
                                {
                                    "id": "722441224",
                                    "speaker": "久利由卖",
                                    "text": "妾身的记忆，并不足以补全他们的魂魄，便只能靠白夜之国诸民的记忆了。"
                                },
                                {
                                    "id": "722441225",
                                    "speaker": "久利由卖",
                                    "text": "这些孩童们，应这些归咎于他们身上的罪孽，才重新被白夜国记起，留下残影。"
                                },
                                {
                                    "id": "722441226",
                                    "speaker": "久利由卖",
                                    "text": "多谢你了，旅者…妾身大愿已了。"
                                },
                                {
                                    "id": "722441227",
                                    "speaker": "久利由卖",
                                    "text": "也终于能…稍微…安心一下了。"
                                },
                                {
                                    "id": "722441228",
                                    "speaker": "久利由卖",
                                    "text": "终于能…再和那些孩子们一起…"
                                }
                            ]
                        },
                        {
                            "id": "722441220",
                            "text": "记忆也有面向吗？"
                        }
                    ]
                }
            ]
        },
