    "talks": [
        {
            "id": "7307501",
            "objective": "(test)计数$HIDDEN",
            "dialogues": [
                {
                    "id": "730750101",
                    "speaker": "兰那库拉",
                    "text": "#那菈{NICKNAME}和派蒙，谢谢你们，现在桓那兰那的苗圃生满了毗波耶。"
                },
                {
                    "id": "730750102",
                    "speaker": "兰伽卢",
                    "text": "这里的毗波耶都很高兴，所以，兰伽卢也高兴。"
                },
                {
                    "id": "730750103",
                    "speaker": "兰那库拉",
                    "text": "无忧节已经结束，在金色的那菈离开桓那以前…"
                },
                {
                    "id": "730750104",
                    "speaker": "Black Screen",
                    "text": "获得了一株毗波耶。"
                },
                {
                    "id": "730750105",
                    "speaker": "兰那库拉",
                    "text": "#高兴的毗波耶，送给金色的那菈，希望那菈{NICKNAME}和派蒙也能高兴。虽然这株毗波耶不会凋零，但是…"
                },
                {
                    "id": "730750106",
                    "speaker": "兰伽卢",
                    "text": "记得偶尔和它说话，最好能演奏乐曲给它听。"
                },
                {
                    "id": "730750107",
                    "speaker": "兰那库拉",
                    "text": "#大地不会忘记，兰那罗不会忘记，希望那菈{NICKNAME}和派蒙也不要忘记…"
                }
            ]
        },
        {
            "id": "7307503",
            "objective": "(test)无忧节完成NPC出现$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7307502",
            "objective": "(test)和兰纳罗对话获得奖励$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7307502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730750201",
                    "speaker": "兰那库拉",
                    "text": "#有那菈{NICKNAME}的无忧节，就像那菈法留纳和兰那罗一起度过的无忧节…很久没有这样高兴了，呜呜…"
                },
                {
                    "id": "730750202",
                    "speaker": "兰伽卢",
                    "text": "毗波耶见不得「眼泪」，无忧节是高兴的节日，兰那库拉要给毗波耶演奏高兴的乐曲！"
                }
            ]
        }
    ]
