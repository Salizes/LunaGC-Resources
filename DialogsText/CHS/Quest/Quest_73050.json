    "talks": [
        {
            "id": "7305001",
            "objective": "",
            "dialogues": [
                {
                    "id": "730500101",
                    "speaker": "兰般度",
                    "text": "#那菈{NICKNAME}还有派蒙！多亏你们帮忙，法留纳神机现在很好，善见地也很好…"
                },
                {
                    "id": "730500102",
                    "speaker": "兰贡迪",
                    "text": "兰那罗都回到桓那兰那，庆祝无忧节，像归巢的鸟。"
                },
                {
                    "id": "730500103",
                    "speaker": "兰那库拉",
                    "text": "生气的雨变回了温柔的雨，兰那库拉也可以安心照看苗圃，培育毗波耶，高兴的毗波耶…"
                },
                {
                    "id": "730500104",
                    "speaker": "兰伽卢",
                    "text": "高兴的毗波耶做高兴的灯，高兴的灯点缀高兴的无忧节…"
                },
                {
                    "id": "730500105",
                    "speaker": "兰伽卢",
                    "text": "#那菈{NICKNAME}和派蒙，苗圃现在很好，无忧节也很开心，谢谢你们帮忙，治好法留纳神机，让兰那库拉回来。"
                },
                {
                    "id": "730500106",
                    "speaker": "派蒙",
                    "text": "那就好！嘿嘿…"
                },
                {
                    "id": "730500107",
                    "speaker": "Player",
                    "text": "这么说来，有个事情还挺在意的…"
                },
                {
                    "id": "730500108",
                    "speaker": "Player",
                    "text": "那菈法留纳为什么叫那菈法留纳？"
                },
                {
                    "id": "730500109",
                    "speaker": "兰般度",
                    "text": "嗯嗯。因为那个那菈，是帮助我们治好法留纳神机的那菈。"
                },
                {
                    "id": "730500110",
                    "speaker": "Player",
                    "text": "#那{M#她}{F#他}的名字叫什么？"
                },
                {
                    "id": "730500111",
                    "speaker": "兰般度",
                    "text": "唔…不知道耶，那菈法留纳，一直都没说过名字。",
                    "choices": [
                        {
                            "id": "730500112",
                            "text": "……",
                            "response": [
                                {
                                    "id": "730500114",
                                    "speaker": "兰百梨迦",
                                    "text": "#那菈{NICKNAME}也帮了好多好多忙，是勇敢的那菈，战胜很多困难。我们一起在无忧节，很高兴。"
                                },
                                {
                                    "id": "730500115",
                                    "speaker": "兰贡迪",
                                    "text": "#我们有东西想交给那菈{NICKNAME}。"
                                },
                                {
                                    "id": "730500116",
                                    "speaker": "兰般度",
                                    "text": "是表达兰那罗的感谢的东西。"
                                },
                                {
                                    "id": "730500117",
                                    "speaker": "兰那库拉",
                                    "text": "#那菈{NICKNAME}一定会喜欢的，派蒙也是。"
                                },
                                {
                                    "id": "730500118",
                                    "speaker": "兰百梨迦",
                                    "text": "兰那罗的花，送给勇敢的那菈，还有派蒙。"
                                },
                                {
                                    "id": "730500119",
                                    "speaker": "兰伽卢",
                                    "text": "#兰伽卢也有小花，不是毗波耶，但是送给那菈{NICKNAME}和派蒙！"
                                },
                                {
                                    "id": "730500120",
                                    "speaker": "兰般度",
                                    "text": "#谢谢那菈{NICKNAME}和派蒙为桓那做过的一切，兰那罗不会忘记朋友！"
                                }
                            ]
                        },
                        {
                            "id": "730500113",
                            "text": "我明白了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7305002",
            "objective": "",
            "dialogues": [
                {
                    "id": "730500201",
                    "speaker": "兰利遮",
                    "text": "#那菈{NICKNAME}和派蒙！想让桓那「生病」的坏家伙没有再来了，现在放心。"
                },
                {
                    "id": "730500202",
                    "speaker": "兰利遮",
                    "text": "#谢谢那菈{NICKNAME}和派蒙帮忙，兰利遮才能保护桓那…所以，兰利遮给那菈{NICKNAME}还有派蒙花花！"
                },
                {
                    "id": "730500203",
                    "speaker": "兰利遮",
                    "text": "收下花花吧，兰利遮的好朋友！"
                }
            ]
        },
        {
            "id": "7305003",
            "objective": "",
            "dialogues": [
                {
                    "id": "730500301",
                    "speaker": "兰纳迦",
                    "text": "无忧节…怀念的感觉…唔？白蓬蓬飞飞…还有金色的那菈。"
                },
                {
                    "id": "730500302",
                    "speaker": "兰纳真",
                    "text": "是那菈朋友，和那菈朋友的朋友，希望在无忧节过得开心。"
                },
                {
                    "id": "730500303",
                    "speaker": "兰迦鲁",
                    "text": "朋友的朋友也是朋友！金色的那菈，还有飞飞白毛都是兰迦鲁的朋友！"
                }
            ]
        }
    ]
}