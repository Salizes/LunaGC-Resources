    "talks": [
        {
            "id": "7468701",
            "objective": "与警备队员们对话",
            "dialogues": [
                {
                    "id": "746870301",
                    "speaker": "玛因",
                    "text": "好呀，顶班的来了…"
                },
                {
                    "id": "746870302",
                    "speaker": "玛因",
                    "text": "咦？怎么是你们？",
                    "choices": [
                        {
                            "id": "746870303",
                            "text": "我…我们怎么了吗？",
                            "response": [
                                {
                                    "id": "746870304",
                                    "speaker": "派蒙",
                                    "text": "感觉你好像认识我们…"
                                },
                                {
                                    "id": "746870305",
                                    "speaker": "玛因",
                                    "text": "没有任何问题，很好很好，你们出了名的强！"
                                },
                                {
                                    "id": "746870306",
                                    "speaker": "玛因",
                                    "text": "在单位里的时候，回村里以后，大家都在说，什么事都能放心交给你们。"
                                },
                                {
                                    "id": "746870311",
                                    "speaker": "玛因",
                                    "text": "相比之下，那边的两位同事，虽然也都很可靠，但总感觉有点，说不上来的别扭？"
                                },
                                {
                                    "id": "746870312",
                                    "speaker": "玛因",
                                    "text": "人类的情感真复杂啊…要不要推他们一把呢？"
                                },
                                {
                                    "id": "746870313",
                                    "speaker": "主角",
                                    "text": "别扭？"
                                },
                                {
                                    "id": "746870314",
                                    "speaker": "玛因",
                                    "text": "算了，正事要紧。"
                                },
                                {
                                    "id": "746870315",
                                    "speaker": "玛因",
                                    "text": "总之加油吧，那部重炮的操纵并不难，期待你们三下五除二，把所有目标都轰得一个不留。"
                                }
                            ]
                        },
                        {
                            "id": "746870307",
                            "text": "我们之前好像见过？",
                            "response": [
                                {
                                    "id": "746870308",
                                    "speaker": "玛因",
                                    "text": "居然还记得我？之前「海薇玛映影欢乐城」招募员工的时候，我还给你投过简历呢。"
                                },
                                {
                                    "id": "746870309",
                                    "speaker": "派蒙",
                                    "text": "好像，确实有这么一回事来着？"
                                },
                                {
                                    "id": "746870310",
                                    "speaker": "玛因",
                                    "text": "我知道你们很强，什么事都能放心交给你们。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7468701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "746870101",
                    "speaker": "谢妮",
                    "text": "前辈，事态已经持续半天了，魔物还是没有减少的迹象…"
                },
                {
                    "id": "746870102",
                    "speaker": "谢妮",
                    "text": "要不然，我还是去呼叫增援吧？"
                },
                {
                    "id": "746870103",
                    "speaker": "弗雷瑞斯",
                    "text": "不用慌张，相信我的重炮和那位便衣同事！"
                },
                {
                    "id": "746870104",
                    "speaker": "弗雷瑞斯",
                    "text": "此外，对危机有着敏锐嗅觉的冒险家，甚至是某位长官…应该也会在第一时间赶来吧。",
                    "choices": [
                        {
                            "id": "746870105",
                            "text": "又有什么危机？",
                            "response": [
                                {
                                    "id": "746870107",
                                    "speaker": "谢妮",
                                    "text": "出现了…准领队居然真的带着小助手来了！"
                                },
                                {
                                    "id": "746870108",
                                    "speaker": "弗雷瑞斯",
                                    "text": "两位好，请让我简单说明事态…"
                                },
                                {
                                    "id": "746870109",
                                    "speaker": "谢妮",
                                    "text": "嘿嘿，前辈先休息一会儿吧，说明工作交给我就好。"
                                },
                                {
                                    "id": "746870110",
                                    "speaker": "谢妮",
                                    "text": "咳！想操纵重炮狂轰一番吗？海军舰队全灭后，这种机会可不多了，说是梦回几百年前也不为过！"
                                },
                                {
                                    "id": "746870111",
                                    "speaker": "谢妮",
                                    "text": "用特制的弹头成片成片击倒魔物，怎么想都很解压吧，还能拿到警备队的奖金呢！"
                                },
                                {
                                    "id": "746870112",
                                    "speaker": "派蒙",
                                    "text": "用大炮轰魔物…这个我们的确在行！",
                                    "choices": [
                                        {
                                            "id": "746870113",
                                            "text": "听起来确实不复杂。",
                                            "response": [
                                                {
                                                    "id": "746870115",
                                                    "speaker": "谢妮",
                                                    "text": "前辈，我理解你的喜悦之情。但现在应该紧张一点，还是让我来为准领队解释吧。"
                                                },
                                                {
                                                    "id": "746870116",
                                                    "speaker": "谢妮",
                                                    "text": "最近，工人们无意间在附近的地下挖出了一座遗迹，惊动了里边沉睡的魔物…"
                                                },
                                                {
                                                    "id": "746870117",
                                                    "speaker": "谢妮",
                                                    "text": "为了不让魔物外逃，警备队建立了防御阵地…"
                                                },
                                                {
                                                    "id": "746870118",
                                                    "speaker": "谢妮",
                                                    "text": "不过，说是阵地，目前只有我们两人和一位度假中的美露莘探员，还有我们改进过的一种炮台…"
                                                },
                                                {
                                                    "id": "746870119",
                                                    "speaker": "派蒙",
                                                    "text": "噫！感觉有点危险！那位美露莘探员没关系吗？"
                                                },
                                                {
                                                    "id": "746870120",
                                                    "speaker": "弗雷瑞斯",
                                                    "text": "放心，通过远程操纵遗迹出口的重炮，那位美露莘探员不必亲自上阵，也能将大部分魔物拦住。"
                                                },
                                                {
                                                    "id": "746870121",
                                                    "speaker": "谢妮",
                                                    "text": "她确实非常可靠，但长期高强度执勤，肯定也会累的。"
                                                },
                                                {
                                                    "id": "746870122",
                                                    "speaker": "谢妮",
                                                    "text": "准领队，你愿意帮帮我们吗？要是情况一直不妙，我会找来更多增援。"
                                                },
                                                {
                                                    "id": "746870123",
                                                    "speaker": "弗雷瑞斯",
                                                    "text": "#不不，谢妮，你也知道准领队的手腕，应该做最好的打算——{M#他}{F#她}用我的炮台直接消灭所有魔物！",
                                                    "choices": [
                                                        {
                                                            "id": "746870124",
                                                            "text": "你别说，还真有兴趣试试重炮…",
                                                            "response": [
                                                                {
                                                                    "id": "746870126",
                                                                    "speaker": "派蒙",
                                                                    "text": "放着眼前的事态不管，也不是我们的作风！"
                                                                },
                                                                {
                                                                    "id": "746870127",
                                                                    "speaker": "弗雷瑞斯",
                                                                    "text": "太好了，多谢你们愿意出手相帮。"
                                                                },
                                                                {
                                                                    "id": "746870128",
                                                                    "speaker": "弗雷瑞斯",
                                                                    "text": "上次实验之后，我又重新调整了自己的发明，希望你们用得顺手。"
                                                                },
                                                                {
                                                                    "id": "746870129",
                                                                    "speaker": "谢妮",
                                                                    "text": "哎，要是重炮能自己瞄准、自己发射就好了，前辈觉得呢？"
                                                                },
                                                                {
                                                                    "id": "746870130",
                                                                    "speaker": "弗雷瑞斯",
                                                                    "text": "对啊！下次我可以试着给重炮加上警卫机关的识别模块，让它们自行值岗！"
                                                                },
                                                                {
                                                                    "id": "746870131",
                                                                    "speaker": "谢妮",
                                                                    "text": "不愧是前辈，真聪明！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746870125",
                                                            "text": "无论事态好坏，我都想来帮忙。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746870114",
                                            "text": "但为什么突然轰魔物？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746870106",
                            "text": "我们来得正好？"
                        }
                    ]
                }
            ]
        }
    ]
}