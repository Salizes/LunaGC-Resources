    "talks": [
        {
            "id": "7302604",
            "objective": "打开「遗迹巨像」的封印",
            "dialogues": []
        },
        {
            "id": "7302605",
            "objective": "进入「遗迹巨像」",
            "dialogues": [
                {
                    "id": "730260501",
                    "speaker": "派蒙",
                    "text": "这里面出乎意料的大啊！"
                },
                {
                    "id": "730260502",
                    "speaker": "加扎里",
                    "text": "这是当然，等一下，现在终于有机会说出那句名台词了。"
                },
                {
                    "id": "730260503",
                    "speaker": "加扎里",
                    "text": "「诸位，古国坎瑞亚数千年的历史在看着我们！」"
                },
                {
                    "id": "730260504",
                    "speaker": "加扎里",
                    "text": "哎呀，有些得意忘形了。这可是因论派贤者伊斯坎德的名言，你们不会连他的传记也没有读过吧？",
                    "choices": [
                        {
                            "id": "730260505",
                            "text": "……",
                            "response": [
                                {
                                    "id": "730260508",
                                    "speaker": "加扎里",
                                    "text": "虽然在文献里早就读过无数遍了，不过第一次亲眼看到还是没办法抑制住激动的心情。"
                                },
                                {
                                    "id": "730260509",
                                    "speaker": "派蒙",
                                    "text": "好多藤蔓，看来是真的很久没有人来过了呢。"
                                },
                                {
                                    "id": "730260510",
                                    "speaker": "加扎里",
                                    "text": "根据《古国坎瑞亚遗迹巨像相关问题的研究综述》，上一个进入这台遗迹巨像进行过系统研究的学者还是迦毗鸠师呢。"
                                },
                                {
                                    "id": "730260511",
                                    "speaker": "加扎里",
                                    "text": "你们肯定不知道吧，迦毗鸠师可是我们妙论派历史上最伟大的学者之一，是个不到三十岁就被称为诃般荼的学术天才。"
                                },
                                {
                                    "id": "730260512",
                                    "speaker": "加扎里",
                                    "text": "本来按他的成就迟早是要成为贤者的，结果却在一次外出考察中发生了意外，重要的学术成果也不知所踪。"
                                },
                                {
                                    "id": "730260513",
                                    "speaker": "加扎里",
                                    "text": "从那之后，妙论派就一蹶不振了。如果他能活得久一点，或许我现在就不用天天考虑经费的事情了吧。"
                                },
                                {
                                    "id": "730260514",
                                    "speaker": "加扎里",
                                    "text": "顺带一提，继承迦毗鸠师的事业正是本人的学术理想。"
                                },
                                {
                                    "id": "730260515",
                                    "speaker": "派蒙",
                                    "text": "先不管什么学术理想，总之我们接下来要做的是…",
                                    "choices": [
                                        {
                                            "id": "730260516",
                                            "text": "砸开封住的入口。",
                                            "response": [
                                                {
                                                    "id": "730260517",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，这样的话首先要启动这个大家伙才行。"
                                                },
                                                {
                                                    "id": "730260520",
                                                    "speaker": "加扎里",
                                                    "text": "没错，启动这台遗迹巨像取得宝贵的实验数据也是我这次研究的突破点。"
                                                },
                                                {
                                                    "id": "730260521",
                                                    "speaker": "加扎里",
                                                    "text": "想要超越前人的话，不搞出点大动静可是做不到的。"
                                                },
                                                {
                                                    "id": "730260522",
                                                    "speaker": "派蒙",
                                                    "text": "那么快点启动这个大家伙吧，应该会有那种只要一按下去就会亮起来的机关什么的吧。"
                                                },
                                                {
                                                    "id": "730260523",
                                                    "speaker": "加扎里",
                                                    "text": "机关…虽然确实是有啦，根据文献记载，正常来说只要进入驾驶舱打开「解离阀」，就能启动遗迹巨像了。"
                                                },
                                                {
                                                    "id": "730260524",
                                                    "speaker": "加扎里",
                                                    "text": "但我之前不是说过吗，所有的遗迹机关都是依靠炉心里的漆黑力量驱动的。而这架遗迹巨像的炉心…已经被封印在下面了。"
                                                },
                                                {
                                                    "id": "730260525",
                                                    "speaker": "加扎里",
                                                    "text": "所以就算我们进入了驾驶舱，靠常规方法也是没办法启动的。"
                                                },
                                                {
                                                    "id": "730260526",
                                                    "speaker": "加扎里",
                                                    "text": "何况现在连眼前这个升降塔也启动不了，根本就没办法到达顶层的驾驶舱。"
                                                },
                                                {
                                                    "id": "730260527",
                                                    "speaker": "派蒙",
                                                    "text": "唔，那我们现在要怎么办？",
                                                    "choices": [
                                                        {
                                                            "id": "730260528",
                                                            "text": "打一下看看吧。",
                                                            "response": [
                                                                {
                                                                    "id": "730260529",
                                                                    "speaker": "加扎里",
                                                                    "text": "喂！虽然我是有教令院最高权限的研究许可，但是故意破坏可就是两码事了。"
                                                                },
                                                                {
                                                                    "id": "730260531",
                                                                    "speaker": "加扎里",
                                                                    "text": "俗话说「门关上了窗户就会打开」，坎瑞亚人也考虑过这种情况吧。"
                                                                },
                                                                {
                                                                    "id": "730260532",
                                                                    "speaker": "加扎里",
                                                                    "text": "或许是因为对于漆黑能量的掌握尚不成熟，根据教令院的研究，早期生产的遗迹机关还装载了一套备用的动力系统。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730260533",
                                                                            "text": "动力系统？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730260534",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "不同于可以提供近乎无限能量的炉心，这套动力系统是由一系列小型的能源中继装置组成的。"
                                                                                },
                                                                                {
                                                                                    "id": "730260535",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "而这些装置的动力来源则是许多储存了从地脉中提取的纯粹能量的能量块。"
                                                                                },
                                                                                {
                                                                                    "id": "730260536",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "根据一些因论派学者的推测这类动力系统早在古国坎瑞亚建造第一台遗迹机关之前就已经被广泛使用了。"
                                                                                },
                                                                                {
                                                                                    "id": "730260537",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "刚才我进来的时候已经观察过了，这台遗迹巨像也是早期生产的型号，所以肯定也搭载了备用的动力系统。"
                                                                                },
                                                                                {
                                                                                    "id": "730260538",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "核心动力室在底层，我们先想办法去到下面吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730260539",
                                                                            "text": "直接说要怎么做就行了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730260540",
                                                                                    "speaker": "加扎里",
                                                                                    "text": "唔，核心动力室在底层，我们先想办法去到下面吧。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730260530",
                                                            "text": "也就是说有非常规的方法。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730260518",
                                            "text": "开展学术研究。",
                                            "response": [
                                                {
                                                    "id": "730260519",
                                                    "speaker": "派蒙",
                                                    "text": "唔，你忘记我们是来调查地下遗迹的了吗？虽然学术研究也很重要啦，不过我们得先想办法启动这个大家伙才行。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730260506",
                            "text": "你不是妙论派的学者吗？",
                            "response": [
                                {
                                    "id": "730260507",
                                    "speaker": "加扎里",
                                    "text": "我可没打算被学派的藩篱限制住啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302606",
            "objective": "启动中继装置",
            "dialogues": [
                {
                    "id": "730260601",
                    "speaker": "派蒙",
                    "text": "哇！竟然真的启动了。"
                },
                {
                    "id": "730260616",
                    "speaker": "加扎里",
                    "text": "怎么样？这台巨像里的机械，不管是中继装置还是机关门，都可以靠这种能量块来供能。"
                },
                {
                    "id": "730260602",
                    "speaker": "派蒙",
                    "text": "但是怎么好像，什么也没发生的样子？"
                },
                {
                    "id": "730260603",
                    "speaker": "加扎里",
                    "text": "哎呀，这是因为这套备用动力系统是由一系列小型的能源中继装置组成的。"
                },
                {
                    "id": "730260604",
                    "speaker": "加扎里",
                    "text": "也就是说，必须从底层开始，一点点连通所有的能源中继装置，这套动力系统才能运行啊。"
                },
                {
                    "id": "730260605",
                    "speaker": "Player",
                    "text": "所有的…"
                },
                {
                    "id": "730260606",
                    "speaker": "加扎里",
                    "text": "虽然以这架遗迹巨像的受损情况而言，全功率运行确实有些困难。"
                },
                {
                    "id": "730260607",
                    "speaker": "加扎里",
                    "text": "不过就在你们刚才启动这个中继装置的时候，我在这个动力室里发现了这个。"
                },
                {
                    "id": "730260608",
                    "speaker": "加扎里",
                    "text": "看样子是这台遗迹巨像的结构蓝图，估计是负责维修的机组人员丢在这里的吧。"
                },
                {
                    "id": "730260609",
                    "speaker": "加扎里",
                    "text": "根据这个蓝图，看来我们只要把关键的几个中继装置连通了，就能启动这架机械了…"
                },
                {
                    "id": "730260610",
                    "speaker": "加扎里",
                    "text": "…至少也能启动这个升降塔去到驾驶舱那边。"
                },
                {
                    "id": "730260611",
                    "speaker": "派蒙",
                    "text": "听上去不是很靠谱的样子…"
                },
                {
                    "id": "730260612",
                    "speaker": "加扎里",
                    "text": "嘛，总之现在也没有其他办法，不如你们就先去把连通升降塔的装置启动看看吧。"
                },
                {
                    "id": "730260613",
                    "speaker": "派蒙",
                    "text": "欸？你不跟我们一起去吗？"
                },
                {
                    "id": "730260614",
                    "speaker": "加扎里",
                    "text": "我要留在这里拍…啊不对是研究这台遗迹巨像的内部构造，这也是很重要的工作啊。"
                },
                {
                    "id": "730260615",
                    "speaker": "加扎里",
                    "text": "况且作为学者的我也帮不上什么忙吧。如果遇到什么技术上的问题的话，你们就过来这边找我吧。"
                }
            ]
        },
        {
            "id": "7302603",
            "objective": "联动下层动力系统",
            "dialogues": []
        },
        {
            "id": "7302607",
            "objective": "联动下层动力系统",
            "dialogues": [
                {
                    "id": "730260701",
                    "speaker": "加扎里",
                    "text": "到处都是精妙的机械，真是人类文明的杰作。"
                },
                {
                    "id": "730260702",
                    "speaker": "加扎里",
                    "text": "这么珍贵的研究资料，得赶快记录下来才行。"
                }
            ]
        },
        {
            "id": "7302616",
            "objective": "与加扎里先生对话",
            "dialogues": []
        },
        {
            "id": "7302615",
            "objective": "与加扎里先生对话",
            "dialogues": [
                {
                    "id": "730260801",
                    "speaker": "加扎里",
                    "text": "这么快就回来了吗，我还在研究这部分机械骨架的受力结构呢。没想到你们竟然成功启动了这个升降塔。"
                },
                {
                    "id": "730260802",
                    "speaker": "Player",
                    "text": "你刚才该不会是瞎蒙的吧？"
                },
                {
                    "id": "730260803",
                    "speaker": "加扎里",
                    "text": "嘛…毕竟我之前也只是在文献里读过这个。"
                },
                {
                    "id": "730260804",
                    "speaker": "加扎里",
                    "text": "况且就算是在教令院，能看懂这个蓝图的也不会超过三个人，就算是蒙对了也是很厉害的。"
                },
                {
                    "id": "730260805",
                    "speaker": "加扎里",
                    "text": "总之既然这个升降塔可以正常使用，接下来只要启动中层的中继装置，应该就可以去到上面驾驶舱所在的空间了。"
                },
                {
                    "id": "730260806",
                    "speaker": "加扎里",
                    "text": "我看看…中层的装置应该都在动力室里，得把四个中继装置都启动才行。"
                },
                {
                    "id": "730260807",
                    "speaker": "加扎里",
                    "text": "如果找不到能用的能量块的话，把它们暂时从装置中取出也是可以的。反正只要最后都能连通就好了。"
                },
                {
                    "id": "730260808",
                    "speaker": "加扎里",
                    "text": "那么我就继续在这里等你们了。"
                }
            ]
        },
        {
            "id": "7302608",
            "objective": "连通中层四个中继装置",
            "dialogues": []
        },
        {
            "id": "7302609",
            "objective": "击败黑蛇骑士",
            "dialogues": [
                {
                    "id": "730260901",
                    "speaker": "加扎里",
                    "text": "嗯？刚才你们在上面干什么了？我在研究这个感应回路的时候好像听到了什么不得了的动静。"
                },
                {
                    "id": "730260902",
                    "speaker": "加扎里",
                    "text": "不管你们在干什么，麻烦稍微动作小一点。要是真搞出什么事情来，我在给教令院的报告里可不好交待。",
                    "choices": [
                        {
                            "id": "730260903",
                            "text": "我们遇到了驾驶员。",
                            "response": [
                                {
                                    "id": "730260904",
                                    "speaker": "加扎里",
                                    "text": "驾驶员？你们该不会当真了吧？"
                                },
                                {
                                    "id": "730260905",
                                    "speaker": "加扎里",
                                    "text": "就算是坎瑞亚人也是不可能活上几百年的。"
                                },
                                {
                                    "id": "730260909",
                                    "speaker": "加扎里",
                                    "text": "话说回来，总之你们应该已经把中层的中继装置全部连通了吧。"
                                },
                                {
                                    "id": "730260910",
                                    "speaker": "加扎里",
                                    "text": "我在这里的研究也进行的差不多了，接下来我们就一起去顶层的驾驶舱那里吧。"
                                },
                                {
                                    "id": "730260911",
                                    "speaker": "加扎里",
                                    "text": "和刚才一样，只要把动力系统连通到驾驶舱那边应该就能启动这架遗迹巨像的控制系统了。"
                                }
                            ]
                        },
                        {
                            "id": "730260906",
                            "text": "我们遇到了一位熟人。",
                            "response": [
                                {
                                    "id": "730260907",
                                    "speaker": "加扎里",
                                    "text": "呃，你该不会也和这个孩子一样…没关系，到时候给教令院的推荐信我会准备两份的，这样你们也能好好相处。"
                                },
                                {
                                    "id": "730260908",
                                    "speaker": "派蒙",
                                    "text": "不是这么回事吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302614",
            "objective": "与加扎里先生对话",
            "dialogues": []
        },
        {
            "id": "7302610",
            "objective": "连通驾驶舱的动力系统",
            "dialogues": []
        },
        {
            "id": "7302611",
            "objective": "进入驾驶舱",
            "dialogues": [
                {
                    "id": "730261101",
                    "speaker": "派蒙",
                    "text": "唔…除了这块黑漆漆的石板，好像没有什么看起来值钱的东西了。"
                },
                {
                    "id": "730261102",
                    "speaker": "加扎里",
                    "text": "什么石板，可别小看它啊。只要启动了控制系统，通过这个可是能直接看到外面的。"
                },
                {
                    "id": "730261103",
                    "speaker": "加扎里",
                    "text": "看上去这里的控制系统还能正常运行，古国坎瑞亚的造物真是令人惊叹。"
                },
                {
                    "id": "730261104",
                    "speaker": "加扎里",
                    "text": "本来以为这辈子已经没机会了，不过现在看来只要能完成这个项目报告，拿到「迦毗鸠师奖」也不过是时间问题。"
                },
                {
                    "id": "730261105",
                    "speaker": "派蒙",
                    "text": "既然这样的话，我们就快点试试启动这个机器人吧，我都已经迫不及待了。",
                    "choices": [
                        {
                            "id": "730261106",
                            "text": "正合我意。",
                            "response": [
                                {
                                    "id": "730261108",
                                    "speaker": "加扎里",
                                    "text": "你们别着急啊，要按照规范操作才行！"
                                }
                            ]
                        },
                        {
                            "id": "730261107",
                            "text": "事不宜迟。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302612",
            "objective": "启动「遗迹巨像」",
            "dialogues": [
                {
                    "id": "730261201",
                    "speaker": "加扎里",
                    "text": "让我看看，按照规范应该先按下…哪个按钮才对呢…"
                }
            ]
        },
        {
            "id": "7302613",
            "objective": "与加扎里先生对话",
            "dialogues": [
                {
                    "id": "730261301",
                    "speaker": "加扎里",
                    "text": "我都说了要按照规范来操作了…"
                },
                {
                    "id": "730261302",
                    "speaker": "Player",
                    "text": "我们好像也没操作…"
                },
                {
                    "id": "730261303",
                    "speaker": "派蒙",
                    "text": "整个手臂直接掉下去了欸，怎么看都是这个机器人自己的问题吧！"
                },
                {
                    "id": "730261304",
                    "speaker": "加扎里",
                    "text": "好吧，总之我会按照实验意外记录的，唉…希望不会对我的报告产生什么影响。"
                },
                {
                    "id": "730261305",
                    "speaker": "加扎里",
                    "text": "不管怎么样，看上去这个遗迹巨像已经没办法再次启动了，你们继续留在这里也没有意义了。"
                },
                {
                    "id": "730261306",
                    "speaker": "加扎里",
                    "text": "你们是为了调查地下遗迹的污染而来，虽然现在这个遗迹巨像是派不上什么用场了。"
                },
                {
                    "id": "730261307",
                    "speaker": "加扎里",
                    "text": "不过刚刚折腾了这么一下，说不定已经有了什么突破呢。"
                },
                {
                    "id": "730261308",
                    "speaker": "加扎里",
                    "text": "我就不去给你们添麻烦了，而且我还有研究需要完成。"
                },
                {
                    "id": "730261309",
                    "speaker": "加扎里",
                    "text": "你们的事情完成之后再回来找我吧…如果我没有因为损坏这个遗迹巨像而被处分的话。"
                },
                {
                    "id": "730261310",
                    "speaker": "加扎里",
                    "text": "到那个时候我也能正式帮你们申请针对混沌炉心的研究项目。"
                },
                {
                    "id": "730261311",
                    "speaker": "加扎里",
                    "text": "虽然项目负责人只能是我啦，不过经费我会分你们一半的。"
                },
                {
                    "id": "730261312",
                    "speaker": "加扎里",
                    "text": "只要抱持着求索之心，不管是什么人都是能走上学术道路的！以此为目标加油吧！"
                }
            ]
        },
        {
            "id": "7302602",
            "objective": "(test)回到秘密基地和老人们对话",
            "dialogues": []
        },
        {
            "id": "7302601",
            "objective": "(test)收集两个零件",
            "dialogues": [
                {
                    "id": "730260101",
                    "speaker": "派蒙",
                    "text": "这里面跟上次进去过的大机器人差不多嘛！"
                },
                {
                    "id": "730260102",
                    "speaker": "加扎里",
                    "text": "上次？你们之前也有进到过其他遗迹巨像里面吗？"
                },
                {
                    "id": "730260103",
                    "speaker": "派蒙",
                    "text": "嗯！之前在沙漠，有个叫阿弗拉图的家伙也拜托过我们调查类似的机器来着。"
                },
                {
                    "id": "730260104",
                    "speaker": "加扎里",
                    "text": "阿弗拉图？可恶啊，他该不会也盯上了「遗迹巨像研究权威」的名号吧。"
                },
                {
                    "id": "730260105",
                    "speaker": "Player",
                    "text": "我想应该不是这样…"
                },
                {
                    "id": "730260106",
                    "speaker": "加扎里",
                    "text": "我记得那个家伙明明是因论派的学者，应该不会对这个感兴趣才对。"
                },
                {
                    "id": "730260107",
                    "speaker": "加扎里",
                    "text": "不过想想似乎也不是没有可能。"
                },
                {
                    "id": "730260108",
                    "speaker": "加扎里",
                    "text": "毕竟是那位曾经说出，「诸位，古国坎瑞亚千年的历史在看着我们！」这番豪言的贤者伊斯坎德出身的学派。"
                },
                {
                    "id": "730260109",
                    "speaker": "派蒙",
                    "text": "先不管什么研究权威，和我们之前调查过的那台比起来，这里看上去感觉真的很久没有人来过了呢。"
                },
                {
                    "id": "730260110",
                    "speaker": "加扎里",
                    "text": "那是当然。"
                },
                {
                    "id": "730260111",
                    "speaker": "加扎里",
                    "text": "根据《古国坎瑞亚遗迹巨像相关问题的研究综述》，上一个进入这台遗迹巨像进行过系统研究的学者还是迦毗鸠师呢。"
                },
                {
                    "id": "730260112",
                    "speaker": "加扎里",
                    "text": "你们肯定不知道吧，迦毗鸠师可是我们妙论派历史上最伟大的学者之一，是个不到三十岁就被称为诃般荼的学术天才。"
                },
                {
                    "id": "730260113",
                    "speaker": "加扎里",
                    "text": "本来按他的成就迟早是要成为贤者的，结果却在一次外出考察中发生了意外，重要的学术成果也不知所踪。"
                },
                {
                    "id": "730260114",
                    "speaker": "加扎里",
                    "text": "从那之后，妙论派就一蹶不振了。如果他能活得久一点，或许我现在就不用天天考虑经费的事情了吧。"
                },
                {
                    "id": "730260115",
                    "speaker": "加扎里",
                    "text": "顺带一提，继承迦毗鸠师的事业正是本人的学术理想。"
                },
                {
                    "id": "730260116",
                    "speaker": "派蒙",
                    "text": "唔，总之我们接下来要做的是…",
                    "choices": [
                        {
                            "id": "730260117",
                            "text": "砸开封住的入口。",
                            "response": [
                                {
                                    "id": "730260118",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，这样的话首先要启动这个大家伙才行。"
                                },
                                {
                                    "id": "730260121",
                                    "speaker": "加扎里",
                                    "text": "没错，启动这台遗迹巨像取得宝贵的实验数据也是我这次研究的突破点。"
                                },
                                {
                                    "id": "730260122",
                                    "speaker": "加扎里",
                                    "text": "想要超越前人的话，不搞出点大动静可是做不到的。"
                                },
                                {
                                    "id": "730260123",
                                    "speaker": "派蒙",
                                    "text": "那么我们现在只要去驾驶舱启动这个大家伙就好了吧。"
                                },
                                {
                                    "id": "730260124",
                                    "speaker": "加扎里",
                                    "text": "这个嘛…虽然正常来说只要进入驾驶舱打开「解离阀」，就能启动遗迹巨像了。"
                                },
                                {
                                    "id": "730260125",
                                    "speaker": "加扎里",
                                    "text": "但我之前不是说过吗，所有的遗迹机关都是依靠炉心里的漆黑力量驱动的。而这架遗迹巨像的炉心…已经被封印在下面了。"
                                },
                                {
                                    "id": "730260126",
                                    "speaker": "加扎里",
                                    "text": "所以就算我们进入了驾驶舱，靠常规方法也是没办法启动的。"
                                },
                                {
                                    "id": "730260127",
                                    "speaker": "加扎里",
                                    "text": "何况现在连眼前这个升降塔也启动不了，根本就没办法到达顶层的驾驶舱。"
                                },
                                {
                                    "id": "730260128",
                                    "speaker": "派蒙",
                                    "text": "唔，那我们现在要怎么办？",
                                    "choices": [
                                        {
                                            "id": "730260129",
                                            "text": "打一下看看吧。",
                                            "response": [
                                                {
                                                    "id": "730260130",
                                                    "speaker": "加扎里",
                                                    "text": "喂！虽然我是有教令院最高权限的研究许可，但是故意破坏可就是两码事了。"
                                                },
                                                {
                                                    "id": "730260132",
                                                    "speaker": "加扎里",
                                                    "text": "俗话说「门关上了窗户就会打开」，坎瑞亚人也考虑过这种情况吧。"
                                                },
                                                {
                                                    "id": "730260133",
                                                    "speaker": "加扎里",
                                                    "text": "或许是因为对于漆黑能量的掌握尚不成熟，根据教令院的研究，早期生产的遗迹机关还装载了一套备用的动力系统。",
                                                    "choices": [
                                                        {
                                                            "id": "730260134",
                                                            "text": "动力系统？",
                                                            "response": [
                                                                {
                                                                    "id": "730260135",
                                                                    "speaker": "加扎里",
                                                                    "text": "不同于可以提供近乎无限能量的炉心，这套动力系统是由一系列小型的能源中继装置组成的。"
                                                                },
                                                                {
                                                                    "id": "730260136",
                                                                    "speaker": "加扎里",
                                                                    "text": "而这些装置的动力来源则是许多储存了从地脉中提取的纯粹能量的能量块。"
                                                                },
                                                                {
                                                                    "id": "730260137",
                                                                    "speaker": "加扎里",
                                                                    "text": "根据一些因论派学者的推测这类动力系统早在古国坎瑞亚建造第一台遗迹机关之前就已经被广泛使用了。"
                                                                },
                                                                {
                                                                    "id": "730260138",
                                                                    "speaker": "加扎里",
                                                                    "text": "刚才我进来的时候已经观察过了，这台遗迹巨像也是早期生产的型号，所以肯定也搭载了备用的动力系统。"
                                                                },
                                                                {
                                                                    "id": "730260139",
                                                                    "speaker": "加扎里",
                                                                    "text": "核心动力室在底层，我们先想办法去到下面吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730260140",
                                                            "text": "直接说要怎么做就行了。",
                                                            "response": [
                                                                {
                                                                    "id": "730260141",
                                                                    "speaker": "加扎里",
                                                                    "text": "唔，核心动力室在底层，我们先想办法去到下面吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730260131",
                                            "text": "也就是说有非常规的方法。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730260119",
                            "text": "开展学术研究。",
                            "response": [
                                {
                                    "id": "730260120",
                                    "speaker": "派蒙",
                                    "text": "唔，你忘记我们是来调查地下遗迹的了吗？虽然学术研究也很重要啦，不过我们得先想办法启动这个大家伙才行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}