    "talks": [
        {
            "id": "4020101",
            "objective": "等待到两天后的8-12点",
            "dialogues": [
                {
                    "id": "402010101",
                    "speaker": "夜兰",
                    "text": "不错，非常守时。",
                    "choices": [
                        {
                            "id": "402010102",
                            "text": "进展如何？",
                            "response": [
                                {
                                    "id": "402010104",
                                    "speaker": "夜兰",
                                    "text": "我们潜伏观察上次的据点一天后，犯人科德和多达马尼便开始转移其中的货品。"
                                },
                                {
                                    "id": "402010105",
                                    "speaker": "夜兰",
                                    "text": "看见那艘船了吗？那就是多达马尼调来转移货品的船只，还找了个客货联运的幌子，给自己打掩护。"
                                },
                                {
                                    "id": "402010106",
                                    "speaker": "派蒙",
                                    "text": "唔，好一艘大家伙！要装的货物都堆在栈桥上，好像还有不少外地人打算乘它去柔灯港…",
                                    "choices": [
                                        {
                                            "id": "402010107",
                                            "text": "为了确认对方没有假动作，",
                                            "response": [
                                                {
                                                    "id": "402010109",
                                                    "speaker": "夜兰",
                                                    "text": "漂亮，已经知道提防诱骗了，进步很快。"
                                                },
                                                {
                                                    "id": "402010110",
                                                    "speaker": "夜兰",
                                                    "text": "倘若科德和多达马尼足够谨慎，怀疑自己正被调查，的确可能放一艘「空船」去柔灯港，进而观察执法机关的动向。"
                                                },
                                                {
                                                    "id": "402010111",
                                                    "speaker": "夜兰",
                                                    "text": "但要小心，根据被捕犯人陆续供出的情报，被称为「诈狂」的盗宝团老手也在和「黑钱领主」合作。"
                                                },
                                                {
                                                    "id": "402010112",
                                                    "speaker": "夜兰",
                                                    "text": "「诈狂」是个亡命徒，最擅长暗中进行破坏，经过之前的调查，可以肯定，在小岛上观察千岩军灯语的眼哨就是他。"
                                                },
                                                {
                                                    "id": "402010113",
                                                    "speaker": "夜兰",
                                                    "text": "我会在附近走动，避免「诈狂」监视现场。趁此机会，你们便可以调查货物。"
                                                },
                                                {
                                                    "id": "402010114",
                                                    "speaker": "夜兰",
                                                    "text": "行动时，请保持低调。",
                                                    "choices": [
                                                        {
                                                            "id": "402010115",
                                                            "text": "明白，我会小心。",
                                                            "response": [
                                                                {
                                                                    "id": "402010117",
                                                                    "speaker": "派蒙",
                                                                    "text": "#唔！我也会尽量…飞低一点！不能超过{NICKNAME}的肩膀！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402010116",
                                                            "text": "我办事，你放心。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402010108",
                                            "text": "我们要提前调查货物吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402010103",
                            "text": "有动静了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020102",
            "objective": "前往遗珑埠港口",
            "dialogues": []
        },
        {
            "id": "4020109",
            "objective": "装备道具并与夜兰对话",
            "dialogues": [
                {
                    "id": "402010901",
                    "speaker": "Player",
                    "text": "开始行动吧。"
                },
                {
                    "id": "402010902",
                    "speaker": "夜兰",
                    "text": "好的，那完成调查后，我们再在附近会合。"
                }
            ]
        },
        {
            "id": "4020104",
            "objective": "调查栈桥上的货物",
            "dialogues": [
                {
                    "id": "402010401",
                    "speaker": "派蒙",
                    "text": "甲板上的炸弹搞定了，应该还有船舱里的…时间还够吗？"
                },
                {
                    "id": "402010402",
                    "speaker": "夜兰",
                    "text": "船舱里的炸弹，我都处理妥当了。"
                },
                {
                    "id": "402010403",
                    "speaker": "夜兰",
                    "text": "#辛苦你们，{NICKNAME}和派蒙。你们应对突发状况的果决和利落，无可挑剔。"
                },
                {
                    "id": "402010404",
                    "speaker": "派蒙",
                    "text": "夜兰！还好你察觉到不妙，要登船调查，给了我们对照表…"
                },
                {
                    "id": "402010405",
                    "speaker": "派蒙",
                    "text": "欸，不对！那两个家伙呢？"
                },
                {
                    "id": "402010406",
                    "speaker": "夜兰",
                    "text": "呵…"
                },
                {
                    "id": "402010407",
                    "speaker": "夜兰",
                    "text": "真惊险啊，科德和多达马尼先生，你们似乎被不得了的危险人物盯上了，他想让你们人财俱失呢…"
                },
                {
                    "id": "402010408",
                    "speaker": "科德",
                    "text": "……"
                },
                {
                    "id": "402010409",
                    "speaker": "科德",
                    "text": "的确，我不明白，世间怎会有如此歹毒之人。我也想不起来，我在哪得罪了这种恶人，结下了仇，以至于让他动了杀心…"
                },
                {
                    "id": "402010410",
                    "speaker": "夜兰",
                    "text": "现在无需担忧了，我会立即通知执律庭，请他们向柔灯港派遣接应人员，专门保护二位。"
                },
                {
                    "id": "402010411",
                    "speaker": "夜兰",
                    "text": "科德先生的货品也会交由执律庭检查一番，彻底排除安全隐患，再由警员协助护送至预定地点。"
                },
                {
                    "id": "402010412",
                    "speaker": "夜兰",
                    "text": "说起来，科德先生的货品，要送往什么地方来着？"
                },
                {
                    "id": "402010413",
                    "speaker": "科德",
                    "text": "…两天后，德波大饭店的拍卖会。"
                },
                {
                    "id": "402010414",
                    "speaker": "夜兰",
                    "text": "那请务必放心，执律庭的警员每个都恪尽职守，一定会保证你的货品——毫发无损地——参加拍卖。"
                },
                {
                    "id": "402010415",
                    "speaker": "科德",
                    "text": "无比感谢。"
                },
                {
                    "id": "402010416",
                    "speaker": "Black Screen",
                    "text": "一段时间后，船舶安然无恙地抵达了柔灯港。执律庭的警员很快接管了船舶，对船舶进行了安全排查，并将所有货物封存运走。"
                },
                {
                    "id": "402010417",
                    "speaker": "Black Screen",
                    "text": "你们则向夜兰补充描述了「诈狂」留给科德和多达马尼的信件内容。"
                }
            ]
        },
        {
            "id": "4020105",
            "objective": "总结调查结果",
            "dialogues": [
                {
                    "id": "402010501",
                    "speaker": "派蒙",
                    "text": "这下可以确认了，那两个坏家伙确实很急，要一次把大部分货物运到枫丹，没有耍什么骗人的花招…"
                },
                {
                    "id": "402010502",
                    "speaker": "派蒙",
                    "text": "不过，那些涂了奇怪标记的货物是怎么回事呢…我们去问问夜兰吧！"
                },
                {
                    "id": "402010503",
                    "speaker": "Black Screen",
                    "text": "找到夜兰后，将调查结果交给她过目…"
                },
                {
                    "id": "402010504",
                    "speaker": "夜兰",
                    "text": "对比埃德勒警官提供的拍卖会情报，可以推测，他们要参加的拍卖会，就是两天后在德波大饭店举办的那场。"
                },
                {
                    "id": "402010505",
                    "speaker": "夜兰",
                    "text": "不过，你们拍到的标记，采用了特殊的涂料，若不是「综像堪录仪」有备而来，还真的很难发现。"
                },
                {
                    "id": "402010506",
                    "speaker": "夜兰",
                    "text": "这是盗宝团鸦印的变体，被团体内的部分高手当作个人徽记，结合案情，必然就是「诈狂」的手笔了。",
                    "choices": [
                        {
                            "id": "402010507",
                            "text": "「诈狂」为什么要标记货物？",
                            "response": [
                                {
                                    "id": "402010509",
                                    "speaker": "夜兰",
                                    "text": "对比港口的清单，「诈狂」标记的货物都有…须弥的特色化肥，本地的烟花，皂角和香膏…"
                                },
                                {
                                    "id": "402010510",
                                    "speaker": "派蒙",
                                    "text": "听起来，都是些普通的农业和生活用品？"
                                },
                                {
                                    "id": "402010511",
                                    "speaker": "夜兰",
                                    "text": "化肥，皂角和香膏…有蹊跷。"
                                },
                                {
                                    "id": "402010512",
                                    "speaker": "夜兰",
                                    "text": "虽然略有风险，但我打算登船调查，随船出港。",
                                    "choices": [
                                        {
                                            "id": "402010513",
                                            "text": "都查到这个份上了…",
                                            "response": [
                                                {
                                                    "id": "402010515",
                                                    "speaker": "派蒙",
                                                    "text": "对对对，我很想知道，那些家伙到底在玩什么把戏！"
                                                },
                                                {
                                                    "id": "402010516",
                                                    "speaker": "夜兰",
                                                    "text": "以你们的实力，我完全不担心安全问题。不过，上船后，我们很可能正面接触科德和多达马尼。"
                                                },
                                                {
                                                    "id": "402010517",
                                                    "speaker": "夜兰",
                                                    "text": "做好心理准备，这次的调查可能有些特殊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402010514",
                                            "text": "我们跟你一起行动…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402010508",
                            "text": "「诈狂」要传递什么信息？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020111",
            "objective": "与夜兰对话",
            "dialogues": [
                {
                    "id": "402011101",
                    "speaker": "Player",
                    "text": "（趁着夜兰在吸引注意力，抓紧时间，找出所有炸弹吧…）"
                }
            ]
        },
        {
            "id": "4020103",
            "objective": "与夜兰对话",
            "dialogues": [
                {
                    "id": "402010201",
                    "speaker": "船员",
                    "text": "不好意思，各位乘客，由于货舱满载，不少货物只能堆放在甲板上，还请各位见谅。"
                },
                {
                    "id": "402010202",
                    "speaker": "热情的乘客",
                    "text": "没事没事！这说明最近生意景气，大家一起发财！"
                },
                {
                    "id": "402010203",
                    "speaker": "夜兰",
                    "text": "看来「诈狂」标记的货物，托运人一栏登记了科德的名字，多达马尼在船舱内活动，应该也在确认货品交付到位。"
                },
                {
                    "id": "402010204",
                    "speaker": "派蒙",
                    "text": "他们在…检查东西？还在箱子里翻来倒去？搞什么名堂…完全不理解！"
                },
                {
                    "id": "402010205",
                    "speaker": "夜兰",
                    "text": "#拿着这份暗语对照表，{NICKNAME}，利用这份道具，你就能读出他们沟通用的黑话。"
                },
                {
                    "id": "402010206",
                    "speaker": "夜兰",
                    "text": "待会儿，我会支开科德和多达马尼，你们趁机调查「诈狂」标记过的货箱，想必能找到什么线索。",
                    "choices": [
                        {
                            "id": "402010207",
                            "text": "如果有不妙的东西。",
                            "response": [
                                {
                                    "id": "402010209",
                                    "speaker": "夜兰",
                                    "text": "当然，我相信你的判断。"
                                },
                                {
                                    "id": "402010210",
                                    "speaker": "派蒙",
                                    "text": "欸？欸欸欸？夜兰你要直接去和那些家伙对话吗！"
                                },
                                {
                                    "id": "402010211",
                                    "speaker": "夜兰",
                                    "text": "嗯？两位先生…有些面善？"
                                },
                                {
                                    "id": "402010212",
                                    "speaker": "夜兰",
                                    "text": "我们是不是在遗珑埠的九略茶馆，有过一面之缘？利奥奈区有名的古董收藏家，科德先生，还有这位朋友？"
                                },
                                {
                                    "id": "402010213",
                                    "speaker": "多达马尼",
                                    "text": "啊？你…你？"
                                },
                                {
                                    "id": "402010214",
                                    "speaker": "科德",
                                    "text": "…「岩上茶室」的「灵骰传说」夜兰小姐，幸会。"
                                },
                                {
                                    "id": "402010215",
                                    "speaker": "夜兰",
                                    "text": "居然还认识我？"
                                },
                                {
                                    "id": "402010216",
                                    "speaker": "科德",
                                    "text": "我曾在「岩上茶室」喝过一盅绝品，席间，听说了您的传闻。现在看来，同为爱茶之人的我们，大概确实有些缘分。"
                                },
                                {
                                    "id": "402010217",
                                    "speaker": "夜兰",
                                    "text": "既然有如此精妙的巧合…正好，我打算前往枫丹享受假期，有什么推荐的去处吗？"
                                },
                                {
                                    "id": "402010218",
                                    "speaker": "夜兰",
                                    "text": "比如…精美茶具之类的艺术品展览…或是拍卖会？我听说枫丹的红茶别有一番风味，茶具想必也很有特色。"
                                },
                                {
                                    "id": "402010219",
                                    "speaker": "多达马尼",
                                    "text": "这！"
                                },
                                {
                                    "id": "402010220",
                                    "speaker": "夜兰",
                                    "text": "嗯？这位朋友，你似乎也对茶具很有兴趣？"
                                },
                                {
                                    "id": "402010221",
                                    "speaker": "多达马尼",
                                    "text": "我…咳咳…没错，我是这条船的船东，受科德的邀请去枫丹旅行，很荣幸能认识你…"
                                },
                                {
                                    "id": "402010222",
                                    "speaker": "派蒙",
                                    "text": "夜兰真的和他们聊起来了？没问题吗？",
                                    "choices": [
                                        {
                                            "id": "402010223",
                                            "text": "我们抓紧时间。",
                                            "response": [
                                                {
                                                    "id": "402010225",
                                                    "speaker": "派蒙",
                                                    "text": "那好！我们绕到那两个家伙看不见的地方，去调查他们的箱子！"
                                                },
                                                {
                                                    "id": "402010226",
                                                    "speaker": "派蒙",
                                                    "text": "咳咳，箱子里的味道有点刺鼻，好像把好几种东西都混合起来了…"
                                                },
                                                {
                                                    "id": "402010227",
                                                    "speaker": "派蒙",
                                                    "text": "还有个奇怪的纸条，写着什么看不懂的东西…",
                                                    "choices": [
                                                        {
                                                            "id": "402010228",
                                                            "text": "是「黑钱领主」的密文…",
                                                            "response": [
                                                                {
                                                                    "id": "402010230",
                                                                    "speaker": "派蒙",
                                                                    "text": "真不愧是夜兰，每个意外情况都预料到了！你你你，你应该知道怎么破译吧？"
                                                                },
                                                                {
                                                                    "id": "402010231",
                                                                    "speaker": "派蒙",
                                                                    "text": "怎么样怎么样？那帮家伙在偷偷说什么？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "402010232",
                                                                            "text": "没猜错的话，是炸弹。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "402010234",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "炸炸炸炸…炸船？"
                                                                                },
                                                                                {
                                                                                    "id": "402010235",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "他们疯了吗！他们不是想摆脱调查吗？这样反而把麻烦搞得更大了！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "402010236",
                                                                                            "text": "「诈狂」要保住幕后黑手…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "402010239",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "夜兰说得真没错，那家伙完全癫狂了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "402010240",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "船上还有好多无辜的人，我们得想办法把炸弹都揪出来，让它们都停下！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "402010237",
                                                                                            "text": "选择用更大的事态转移焦点…"
                                                                                        },
                                                                                        {
                                                                                            "id": "402010238",
                                                                                            "text": "同时斩断我们这边的线索…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "402010233",
                                                                            "text": "他们想要炸船销赃。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402010229",
                                                            "text": "我们有暗语对照表…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402010224",
                                            "text": "好好利用这个窗口。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402010208",
                            "text": "可以让我自行处置吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020110",
            "objective": "准备开始拆除炸弹",
            "dialogues": [
                {
                    "id": "402011301",
                    "speaker": "Player",
                    "text": "开始行动！"
                }
            ]
        },
        {
            "id": "4020106",
            "objective": "拆除炸弹",
            "dialogues": [
                {
                    "id": "402010601",
                    "speaker": "夜兰",
                    "text": "记得装备好<color=#00E1FFFF>「综像勘录仪」</color>，行动时，避免闹出太大动静。"
                }
            ]
        },
        {
            "id": "4020108",
            "objective": "与夜兰对话",
            "dialogues": []
        },
        {
            "id": "4020107",
            "objective": "与夜兰总结情况",
            "dialogues": [
                {
                    "id": "402010301",
                    "speaker": "派蒙",
                    "text": "吓死我了，夜兰！你直接去和那些犯人对峙，就不怕他们突然警惕，然后…然后胡来吗！"
                },
                {
                    "id": "402010302",
                    "speaker": "夜兰",
                    "text": "他们什么都知道，他们也必须硬着头皮面对。"
                },
                {
                    "id": "402010303",
                    "speaker": "夜兰",
                    "text": "现在看来，「黑钱领主」的确相当谨慎，他打算断尾求生。"
                },
                {
                    "id": "402010304",
                    "speaker": "夜兰",
                    "text": "让货品缺席拍卖会，将赃物沉海，除去一切可能导向他的物证，并让「诈狂」吸引所有火力…"
                },
                {
                    "id": "402010305",
                    "speaker": "夜兰",
                    "text": "但我们和执律庭的行动奏效，等于按着对方的头，强行让他们走完拍卖的流程。"
                },
                {
                    "id": "402010306",
                    "speaker": "夜兰",
                    "text": "如果「黑钱领主」放弃让代理人拍下这批货品，而是由其他不知情的买家拍下这些炒作包装的艺术品…"
                },
                {
                    "id": "402010307",
                    "speaker": "夜兰",
                    "text": "买家必将发现这些商品经过了虚假估值，报案上诉，科德就会被列为嫌疑人，甚至定罪。"
                },
                {
                    "id": "402010308",
                    "speaker": "夜兰",
                    "text": "轻则导致「黑钱领主」无法再用这种伎俩为摩拉除痕，重则让「黑钱领主」失去他在枫丹的最后一位得力部下。",
                    "choices": [
                        {
                            "id": "402010309",
                            "text": "反之，如果继续参加拍卖…",
                            "response": [
                                {
                                    "id": "402010311",
                                    "speaker": "夜兰",
                                    "text": "那么线索就不会中断，我们依然可以通过拍下这批货品的买家，找出「黑钱领主」的踪迹。"
                                },
                                {
                                    "id": "402010312",
                                    "speaker": "派蒙",
                                    "text": "唔？哎？啊？你？我？你们？怎么回事来着？"
                                },
                                {
                                    "id": "402010313",
                                    "speaker": "夜兰",
                                    "text": "#别心急，派蒙，{NICKNAME}会给你慢慢解释的哦。"
                                },
                                {
                                    "id": "402010314",
                                    "speaker": "夜兰",
                                    "text": "那么，最后也是最关键的一环，拍卖会上的垂钓…就让我们各自好好准备一番吧。"
                                },
                                {
                                    "id": "402010315",
                                    "speaker": "夜兰",
                                    "text": "埃德勒警官已经让线人安排好了，你们拿着这封邀请函。"
                                },
                                {
                                    "id": "402010316",
                                    "speaker": "夜兰",
                                    "text": "两天后，我们德波大饭店见。"
                                }
                            ]
                        },
                        {
                            "id": "402010310",
                            "text": "另一种情况也对我们有利…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402010701",
                    "speaker": "夜兰",
                    "text": "一切准备停当了吗？"
                }
            ]
        },
        {
            "id": "4020108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402010801",
                    "speaker": "Player",
                    "text": "稍等，容我再确认一下。"
                }
            ]
        },
        {
            "id": "4020110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402011001",
                    "speaker": "Player",
                    "text": "（赶紧装备好<color=#00E1FFFF>「综像勘录仪」</color>吧…）"
                }
            ]
        },
        {
            "id": "4020112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402011201",
                    "speaker": "Player",
                    "text": "再确认一下其他事项…"
                }
            ]
        },
        {
            "id": "4020114",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402011401",
                    "speaker": "<UNKNOWN>",
                    "text": "夜兰正向对方施加压力，眼下还是拆除炸弹要紧…"
                }
            ]
        },
        {
            "id": "4020115",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402011501",
                    "speaker": "夜兰",
                    "text": "我会注意周边情况，阻止「诈狂」接近…"
                },
                {
                    "id": "402011502",
                    "speaker": "夜兰",
                    "text": "当然，如果发现我在附近，对方必定不敢冒险。"
                },
                {
                    "id": "402011503",
                    "speaker": "夜兰",
                    "text": "你就趁此机会，好好取证，仔细调查一番货物吧。"
                }
            ]
        },
        {
            "id": "4020198",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402019801",
                    "speaker": "Black Screen",
                    "text": "来到了栈桥一带，开始调查。"
                },
                {
                    "id": "402019802",
                    "speaker": "Black Screen",
                    "text": "你们则向夜兰补充描述了「诈狂」留给科德和多达马尼的信件内容。"
                },
                {
                    "id": "402019803",
                    "speaker": "Black Screen",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "4020199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402019901",
                    "speaker": "派蒙",
                    "text": "时间差不多了，我们该去和夜兰碰头了！"
                },
                {
                    "id": "402019902",
                    "speaker": "派蒙",
                    "text": "呜，慢慢有点兴奋了，逐渐找到线索，抓住犯人…原来是这种感觉！"
                }
            ]
        }
    ]
}