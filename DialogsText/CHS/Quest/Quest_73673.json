        }
    },
    "talks": [
        {
            "id": "7367301",
            "objective": "与阿芬迪对话",
            "dialogues": [
                {
                    "id": "736730101",
                    "speaker": "阿芬迪",
                    "text": "你好，欢迎来到聚砂厅。"
                },
                {
                    "id": "736730102",
                    "speaker": "阿芬迪",
                    "text": "这里是「三十人团」彼此联络、协调事务的地方，看装束，你并不是他们的成员…"
                },
                {
                    "id": "736730103",
                    "speaker": "阿芬迪",
                    "text": "我明白了，你是听到招募消息，来应募的吗？",
                    "choices": [
                        {
                            "id": "736730106",
                            "text": "没错。",
                            "response": [
                                {
                                    "id": "736730107",
                                    "speaker": "阿芬迪",
                                    "text": "果然如此，很好。以防万一，我再次说明一下工作的情况与内容吧。"
                                },
                                {
                                    "id": "736730108",
                                    "speaker": "阿芬迪",
                                    "text": "我名叫阿芬迪，受教令院委派担任联络员一职，负责疏通协调教令院和「三十人团」之间的合作。"
                                },
                                {
                                    "id": "736730109",
                                    "speaker": "阿芬迪",
                                    "text": "你可能知道，「三十人团」受教令院雇佣，负有护卫整个须弥城的责任。"
                                },
                                {
                                    "id": "736730110",
                                    "speaker": "阿芬迪",
                                    "text": "除此之外，他们还负责处理居民们在生活中遇到的部分困难，这样一来，整体的工作量就很大了。"
                                },
                                {
                                    "id": "736730111",
                                    "speaker": "阿芬迪",
                                    "text": "为了分担压力，我和掌旗官商量之后，决定招募一位协助人员。"
                                },
                                {
                                    "id": "736730112",
                                    "speaker": "阿芬迪",
                                    "text": "当然，城内的关键防务工作并不需要你劳心，只要协助解决居民们的生活委托就好。"
                                },
                                {
                                    "id": "736730113",
                                    "speaker": "阿芬迪",
                                    "text": "至于生活委托的具体内容，大都比较细琐，为了理解方便我还是举几个例子吧。"
                                }
                            ]
                        },
                        {
                            "id": "736730104",
                            "text": "应募？",
                            "response": [
                                {
                                    "id": "736730105",
                                    "speaker": "阿芬迪",
                                    "text": "你还没细看招募内容就来了吗？算了，这也没关系，我来说明一下吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367302",
            "objective": "与阿芬迪对话",
            "dialogues": [
                {
                    "id": "736730201",
                    "speaker": "阿芬迪",
                    "text": "大体就是这样的委托工作，如果你有意愿也有空闲接手的话，那就太好了。"
                },
                {
                    "id": "736730202",
                    "speaker": "阿芬迪",
                    "text": "我和后勤官已经协商好，你接手后，每完成一项工作，都能获得充足的报酬。"
                },
                {
                    "id": "736730203",
                    "speaker": "阿芬迪",
                    "text": "虽然这些委托里小事居多，但我希望你不要小看这份工作的尊严。"
                },
                {
                    "id": "736730204",
                    "speaker": "阿芬迪",
                    "text": "能帮助大家解决生活中遇到的困难，所有人都会衷心感激你、尊重你。"
                },
                {
                    "id": "736730205",
                    "speaker": "阿芬迪",
                    "text": "只要坚持下去，你在居民中的声望想必也会提高，大家也会更愿意接纳你。"
                },
                {
                    "id": "736730206",
                    "speaker": "阿芬迪",
                    "text": "到那时，我也会把更复杂更重要的工作交给你处理。"
                },
                {
                    "id": "736730207",
                    "speaker": "阿芬迪",
                    "text": "好了，这份工作的大致情况就是这样，希望你能好好考虑一下。"
                },
                {
                    "id": "736730208",
                    "speaker": "阿芬迪",
                    "text": "如果你决定接手的话，随时欢迎前来登记领取委托。"
                }
            ]
        }
    ]
}