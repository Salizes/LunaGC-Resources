    "quest": {
        "id": "70689",
        "title": "游逸诸地，曾听旅闻",
        "description": "冒险家协会的凯瑟琳似乎有事找你…",
        "rewards": [
            {
                "itemId": 220124,
                "count": 1
            }
        ],
        "rewards_formatted": "游逸旅账 x1",
        "chapter": {
            "icon": "",
