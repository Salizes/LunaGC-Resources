        }
    },
    "talks": [
        {
            "id": "7068901",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "706890114",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么新鲜事吗？</color>"
                },
                {
                    "id": "706890101",
                    "speaker": "凯瑟琳",
                    "text": "#{NICKNAME}，您来得正好，请留步。我有一件东西需要交给您。",
                    "choices": [
                        {
                            "id": "706890102",
                            "text": "是求援信还是宝藏线索？",
                            "response": [
                                {
                                    "id": "706890104",
                                    "speaker": "凯瑟琳",
                                    "text": "…您确实已经对本协会的各项事务很熟悉了。但很遗憾，这件东西和以上委托皆无关系。"
                                },
                                {
                                    "id": "706890105",
                                    "speaker": "凯瑟琳",
                                    "text": "请拿好这本协会制作的新型笔记本。",
                                    "choices": [
                                        {
                                            "id": "706890106",
                                            "text": "不是有冒险手册了么？",
                                            "response": [
                                                {
                                                    "id": "706890108",
                                                    "speaker": "凯瑟琳",
                                                    "text": "冒险手册的主要作用，是记录各位冒险家完成委托的情况，和一些有关魔物的情报。"
                                                },
                                                {
                                                    "id": "706890109",
                                                    "speaker": "凯瑟琳",
                                                    "text": "而这一本笔记本的作用，则是方便各位冒险家记录自己所遇见的奇人异事。",
                                                    "choices": [
                                                        {
                                                            "id": "706890110",
                                                            "text": "这样啊…",
                                                            "response": [
                                                                {
                                                                    "id": "706890112",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "能帮上您的忙就最好了。那么，本次委托也已经完成了。"
                                                                },
                                                                {
                                                                    "id": "706890113",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "#请继续自由冒险吧，{NICKNAME}，向着星辰与深渊。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706890111",
                                                            "text": "确实能派上用场。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706890107",
                                            "text": "怎么又发我一本？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706890103",
                            "text": "是护送委托还是找人委托？"
                        }
                    ]
                }
            ]
        },
