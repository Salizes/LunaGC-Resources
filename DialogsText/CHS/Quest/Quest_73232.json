            "dialogues": []
        },
        {
            "id": "7323224",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "732322401",
                    "speaker": "派蒙",
                    "text": "这下所有的「慈心」都带回到莲花里来了，按照刚才斯露莎说的，应该已经可以唤醒神明的「神识」了吧。"
                },
                {
                    "id": "732322402",
                    "speaker": "斯露莎",
                    "text": "那么，真正的「祭水之仪」就要开始了。"
                },
                {
                    "id": "732322403",
                    "speaker": "斯露莎",
                    "text": "接下来我会借助灵光的力量，使「伽乌迦那」重新开出圣洁之花。"
                },
                {
                    "id": "732322404",
                    "speaker": "斯露莎",
                    "text": "不过这也会释放出圣莲所积攒的污秽，污秽将化为魔物阻碍我们。"
                },
                {
                    "id": "732322405",
                    "speaker": "斯露莎",
                    "text": "不过没关系，只要神明大人的「神识」被唤醒了，甘露的力量也会庇护我们。"
                },
                {
                    "id": "732322406",
                    "speaker": "斯露莎",
                    "text": "只要圣洁之花长成，它便能将甘露播散到整个大地，净化所有的污秽。"
                },
                {
                    "id": "732322407",
                    "speaker": "斯露莎",
                    "text": "这便是属于勇者的终末之战了！"
                }
            ]
        },
        {
            "id": "7323213",
            "objective": "守护圣洁之花",
            "dialogues": [
                {
                    "id": "732321301",
                    "speaker": "斯露莎",
                    "text": "「慈心」生长出来了…"
                }
            ]
        },
