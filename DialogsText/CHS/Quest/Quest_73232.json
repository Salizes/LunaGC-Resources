    "talks": [
        {
            "id": "7323201",
            "objective": "穿过渊底的通道",
            "dialogues": []
        },
        {
            "id": "7323202",
            "objective": "到达万种母树上方",
            "dialogues": []
        },
        {
            "id": "7323203",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "732320301",
                    "speaker": "派蒙",
                    "text": "这里是，那棵大树桩子的上面吗？"
                },
                {
                    "id": "732320302",
                    "speaker": "派蒙",
                    "text": "明明好不容易才穿过了大窟窿到达这里，怎么又被拦住了啦！"
                },
                {
                    "id": "732320303",
                    "speaker": "斯露莎",
                    "text": "按理来说我已经获得了「双角的花冠」，应该不会被母树拒绝的才对…呜呜…"
                },
                {
                    "id": "732320304",
                    "speaker": "派蒙",
                    "text": "唔，怎么了斯露莎，你看上去好像很难受的样子。"
                },
                {
                    "id": "732320305",
                    "speaker": "斯露莎",
                    "text": "呜呜…是「双角的花冠」…好像有什么东西在涌进来…"
                },
                {
                    "id": "732320306",
                    "speaker": "派蒙",
                    "text": "哇啊，斯露莎！"
                }
            ]
        },
        {
            "id": "7323204",
            "objective": "(test)播放cs（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7323205",
            "objective": "进入万种母树",
            "dialogues": []
        },
        {
            "id": "7323206",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "732320601",
                    "speaker": "派蒙",
                    "text": "喂喂！快醒醒，斯露莎。"
                },
                {
                    "id": "732320602",
                    "speaker": "斯露莎",
                    "text": "唔…"
                },
                {
                    "id": "732320603",
                    "speaker": "派蒙",
                    "text": "呼，你终于醒过来了，刚才在上面的时候你突然就晕过去了，吓死我了。"
                },
                {
                    "id": "732320604",
                    "speaker": "斯露莎",
                    "text": "嗯…我没事。"
                },
                {
                    "id": "732320605",
                    "speaker": "派蒙",
                    "text": "不过在那之后母树就打开了，然后我们就跟着来到了这里，这里该不会是…祖尔宛说的那个巨莲「伽乌迦那」吧！"
                },
                {
                    "id": "732320606",
                    "speaker": "派蒙",
                    "text": "所以斯露莎刚才到底是怎么了啊，是花冠出了什么问题吗？"
                },
                {
                    "id": "732320607",
                    "speaker": "斯露莎",
                    "text": "我刚才好像看到了大地回归母树的记忆。无数的花灵、荼诃的机关与人类的勇士，与魔物交战然后牺牲。"
                },
                {
                    "id": "732320608",
                    "speaker": "斯露莎",
                    "text": "蒙面的剑士、独臂的贤者与元祖的花灵降服了自渊底而出的魔物。"
                },
                {
                    "id": "732320609",
                    "speaker": "斯露莎",
                    "text": "而他们的意志最后都随着灵光回到了母树当中，化为从天而降的甘霖。"
                },
                {
                    "id": "732320610",
                    "speaker": "派蒙",
                    "text": "荼诃的机关…听上去该不会真的像那先朱那说的那样吧？"
                },
                {
                    "id": "732320611",
                    "speaker": "Player",
                    "text": "看来还是得问祖尔宛才行。"
                },
                {
                    "id": "732320612",
                    "speaker": "派蒙",
                    "text": "嗯，不过现在我们接下来该怎么办呢，我记得祖尔宛是说要清除什么污秽来着？"
                },
                {
                    "id": "732320613",
                    "speaker": "斯露莎",
                    "text": "只有进入神明大人的「神识」所依附的「染境」，将那些被污秽困在其中的「慈心」带出来，才能重新唤醒「神识」。"
                },
                {
                    "id": "732320614",
                    "speaker": "斯露莎",
                    "text": "在我所看到的记忆中，那是个无边虚无的空间。"
                },
                {
                    "id": "732320615",
                    "speaker": "派蒙",
                    "text": "既然这样，那我们要怎么样才能进去呢。"
                },
                {
                    "id": "732320616",
                    "speaker": "斯露莎",
                    "text": "跟着我来就行，只要沿着古代英雄们的「心迹」，就能到达那里了！"
                }
            ]
        },
