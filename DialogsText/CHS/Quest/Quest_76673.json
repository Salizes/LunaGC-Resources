    "talks": [
        {
            "id": "7667314",
            "objective": "抵达未知的洞窟$HIDDEN",
            "dialogues": [
                {
                    "id": "766731401",
                    "speaker": "尼可",
                    "text": "嗯…准备就绪，开工。"
                }
            ]
        },
        {
            "id": "7667301",
            "objective": "聆听神秘的声音",
            "dialogues": [
                {
                    "id": "766730801",
                    "speaker": "？？？",
                    "text": "#在很久很久以前，有一位离家出走的年轻人。{M#他}{F#她}用完了身上最后一枚摩拉，在寒冷的冬天穿着单薄的衣衫，瑟瑟发抖地走着…"
                },
                {
                    "id": "766730802",
                    "speaker": "？？？",
                    "text": "#就在这时，年轻人的脚下一空，随后坠入了一片奇特的地方。未等{M#他}{F#她}反应过来，一个声音便从远处传来——"
                },
                {
                    "id": "766730803",
                    "speaker": "？？？",
                    "text": "「此为永恒不灭之大魔女尼古拉·可可的秘密小屋。落魄的年轻人啊，为我讲述你内心的愿望，伟大的魔女会引导你实现它。」"
                },
                {
                    "id": "766730804",
                    "speaker": "派蒙",
                    "text": "呜哇…总觉得听到了奇怪的声音。"
                },
                {
                    "id": "766730805",
                    "speaker": "派蒙",
                    "text": "尼古拉·可可…是谁来着？我们认识这个人吗？"
                }
            ]
        },
        {
            "id": "7667302",
            "objective": "追寻缥缈的光点",
            "dialogues": [
                {
                    "id": "766730201",
                    "speaker": "？？？",
                    "text": "#年轻人惊叹于魔女的高贵与美丽，许久的沉默过后，{M#他}{F#她}郑重地对魔女开口——"
                },
                {
                    "id": "766730202",
                    "speaker": "？？？",
                    "text": "「悠远的魔女、昳丽的魔女、富有智慧的魔女！一见到您，我就忍不住心旌摇荡。我愿以您的愿望为我的愿望。」"
                },
                {
                    "id": "766730203",
                    "speaker": "？？？",
                    "text": "魔女的脸上露出不易察觉的笑容：「既然这样，那就替我完成一些力所能及的事情吧。指引已至，奖赏在未来等候你的到来。」"
                },
                {
                    "id": "766730204",
                    "speaker": "派蒙",
                    "text": "指引…是说这个光球吗？"
                }
            ]
        },
        {
            "id": "7667303",
            "objective": "追寻缥缈的光点",
            "dialogues": [
                {
                    "id": "766730301",
                    "speaker": "？？？",
                    "text": "「秘密小屋啊」，年轻人的眼中流露出疑惑，「小屋在哪呢？」"
                },
                {
                    "id": "766730302",
                    "speaker": "？？？",
                    "text": "听到年轻人的问题，魔女的声音少见地出现了些许慌乱…"
                },
                {
                    "id": "766730303",
                    "speaker": "？？？",
                    "text": "（等下她是这种娇羞的角色吗？算了先这样设定好了，九老师会帮忙润色的。）"
                },
                {
                    "id": "766730304",
                    "speaker": "？？？",
                    "text": "「咳咳，年轻人，不要问这么失礼的问题。魔女小屋正在修建当中，很快你就会被它的华丽惊掉下巴。」"
                },
                {
                    "id": "766730305",
                    "speaker": "？？？",
                    "text": "「这是给你的考验，为建设大魔女的领土贡献你的力量吧。」"
                }
            ]
        },
        {
            "id": "7667304",
            "objective": "寻找合适的拍摄对象",
            "dialogues": [
                {
                    "id": "766730401",
                    "speaker": "？？？",
                    "text": "「好了，年轻人。如今你已经知晓了魔女的烦恼，尼古拉·可可正在建设她神圣的领地，需要你的帮助。」"
                },
                {
                    "id": "766730402",
                    "speaker": "？？？",
                    "text": "魔女笑着为年轻人沏了一杯茶：「你的选择是什么？」",
                    "choices": [
                        {
                            "id": "766730403",
                            "text": "义不容辞！",
                            "response": [
                                {
                                    "id": "766730405",
                                    "speaker": "派蒙",
                                    "text": "等一下啦！像这样来路不明、自说自话的怪人，还是谨慎一些比较好吧？"
                                },
                                {
                                    "id": "766730406",
                                    "speaker": "派蒙",
                                    "text": "咦…不过这个茶杯，总感觉看上去有点眼熟…",
                                    "choices": [
                                        {
                                            "id": "766730407",
                                            "text": "终于意识到了吗？",
                                            "response": [
                                                {
                                                    "id": "766730409",
                                                    "speaker": "派蒙",
                                                    "text": "尼古拉·可可…啊！难道说是魔女N——尼可吗？"
                                                },
                                                {
                                                    "id": "766730410",
                                                    "speaker": "尼可",
                                                    "text": "答对了。刚刚的故事怎么样？"
                                                },
                                                {
                                                    "id": "766730411",
                                                    "speaker": "派蒙",
                                                    "text": "怎么样…根本没讲完吧？后来呢，年轻人和魔女怎么样了？"
                                                },
                                                {
                                                    "id": "766730412",
                                                    "speaker": "尼可",
                                                    "text": "没想好呢。剩下的等我的魔女小屋修好后再想吧，到时候也许会有新的灵感。"
                                                },
                                                {
                                                    "id": "766730413",
                                                    "speaker": "尼可",
                                                    "text": "既然你们听到了我的声音，就说明你们现在在挪德卡莱吧，能拜托你们帮我收集点东西吗？",
                                                    "choices": [
                                                        {
                                                            "id": "766730414",
                                                            "text": "什么东西？",
                                                            "response": [
                                                                {
                                                                    "id": "766730415",
                                                                    "speaker": "尼可",
                                                                    "text": "我打算在修建小屋的同时，做一些新的雕像。不过暂时没什么灵感，想委托你们帮忙拍些精彩的画片。"
                                                                },
                                                                {
                                                                    "id": "766730418",
                                                                    "speaker": "派蒙",
                                                                    "text": "真拿你没办法，那就包在我们身上好啦。"
                                                                },
                                                                {
                                                                    "id": "766730419",
                                                                    "speaker": "派蒙",
                                                                    "text": "你等着，我们这就出去看看有什么好东西。等雕塑完成后，记得把刚刚的故事讲完呀！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766730416",
                                                            "text": "跟雕塑有关吗？",
                                                            "response": [
                                                                {
                                                                    "id": "766730417",
                                                                    "speaker": "尼可",
                                                                    "text": "对，我打算在修建小屋的同时，做一些新的雕像。不过暂时没什么灵感，可以帮我拍点画片吗？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766730408",
                                            "text": "这家伙就是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766730404",
                            "text": "遵从伟大魔女尼古拉·可可的指引！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667305",
            "objective": "寻找合适的拍摄对象",
            "dialogues": [
                {
                    "id": "766730501",
                    "speaker": "尼可",
                    "text": "来得正好。"
                },
                {
                    "id": "766730502",
                    "speaker": "尼可",
                    "text": "你们拍的画片我很满意，都是我感兴趣的题材。雕刻工具我也准备好了，一起来试试？"
                },
                {
                    "id": "766730503",
                    "speaker": "派蒙",
                    "text": "雕刻工具…你是说这些方块吗？"
                },
                {
                    "id": "766730504",
                    "speaker": "尼可",
                    "text": "没错，雕像就在这些石材中，我们只需要把多余的部分去掉。"
                },
                {
                    "id": "766730505",
                    "speaker": "尼可",
                    "text": "为了方便你们理解，我将雕刻的方法也做了「引导」。"
                },
                {
                    "id": "766730506",
                    "speaker": "尼可",
                    "text": "让我来做个示范吧，首先是大刀阔斧地勾勒出基本的造型——"
                },
                {
                    "id": "766730507",
                    "speaker": "尼可",
                    "text": "石块上的数字就是同一列要保留的数量。像这样…然后这样…"
                },
                {
                    "id": "766730508",
                    "speaker": "派蒙",
                    "text": "哦！逐渐像那么回事了！"
                },
                {
                    "id": "766730509",
                    "speaker": "尼可",
                    "text": "明白了吧？雕刻成这样，就大概能看出来基本的形状了。"
                },
                {
                    "id": "766730510",
                    "speaker": "尼可",
                    "text": "之后只需要再加入一点修饰…嘿！"
                },
                {
                    "id": "766730511",
                    "speaker": "派蒙",
                    "text": "等、等一下！我只是眨了一下眼，怎么就变成这样了？"
                },
                {
                    "id": "766730512",
                    "speaker": "尼可",
                    "text": "这部分看看就好，伟大的魔女可不会随便公布术法的秘密。"
                },
                {
                    "id": "766730513",
                    "speaker": "尼可",
                    "text": "修饰的环节交给我，雕刻的手法你们应该看明白了吧？就拜托你们了。"
                },
                {
                    "id": "766730514",
                    "speaker": "派蒙",
                    "text": "好吧，我们试试看——"
                },
                {
                    "id": "766730515",
                    "speaker": "派蒙",
                    "text": "呜哇！这是什么，一上来就这么难吗？"
                },
                {
                    "id": "766730516",
                    "speaker": "尼可",
                    "text": "嗯？哦，抱歉抱歉，刚刚拿错了。"
                },
                {
                    "id": "766730517",
                    "speaker": "尼可",
                    "text": "这个是我要做的，你们的在这边。"
                },
                {
                    "id": "766730518",
                    "speaker": "派蒙",
                    "text": "吓，吓我一跳…"
                }
            ]
        },
        {
            "id": "7667306",
            "objective": "寻找合适的拍摄对象",
            "dialogues": [
                {
                    "id": "766730601",
                    "speaker": "观察",
                    "text": "嗯，魔女的故事已经初具雏形，这段可以交给九老师去写。"
                },
                {
                    "id": "766730602",
                    "speaker": "观察",
                    "text": "大魔女最重要的是美貌和气势，或许可以通过狂笑来增加她的感知度。"
                },
                {
                    "id": "766730603",
                    "speaker": "观察",
                    "text": "「哦呵呵呵呵，被妾身折服了吗，我可是永生之大魔女——」，笑起来会不会太吵了？算了反正写成文字也没人听得见。"
                },
                {
                    "id": "766730604",
                    "speaker": "观察",
                    "text": "装修的计划已经做好了。但是从哪里开始呢？众所周知房子不能凭空变出来，等下真的不能吗？"
                },
                {
                    "id": "766730605",
                    "speaker": "观察",
                    "text": "用炼金术应该也可以，毕竟原材料也只有砖石土木…嗯就这样做吧，比自己建省事多了。"
                },
                {
                    "id": "766730606",
                    "speaker": "观察",
                    "text": "魔女的小屋应该与普通的住宅不同，至于哪里不同我也没有想好。"
                },
                {
                    "id": "766730607",
                    "speaker": "观察",
                    "text": "只有一点是确定的，那就是这里应当是不变的古老的神秘的世外之地，再过几百年几千年也会维持原样。"
                },
                {
                    "id": "766730608",
                    "speaker": "观察",
                    "text": "这一点很好，符合大家对魔女的期待。但事实上，并非是我定格了这里的时间，而是时间定格了我，哈哈。"
                },
                {
                    "id": "766730609",
                    "speaker": "观察",
                    "text": "还愣着干什么？快点去完成魔女的委托吧。"
                },
                {
                    "id": "766730610",
                    "speaker": "观察",
                    "text": "记好，拍照的时候不要拍得死气沉沉，我需要的是富有生命力的画片，才能雕刻出模特的精、气、神。"
                },
                {
                    "id": "766730611",
                    "speaker": "观察",
                    "text": "不要觉得雕塑只要形似就可以了，最重要的是定格雕塑对象那一瞬间所展露的旺盛生命力，记住了吗？"
                }
            ]
        },
        {
            "id": "7667307",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "766730701",
                    "speaker": "Black Screen",
                    "text": "跟派蒙一起拍摄了许多画片…"
                },
                {
                    "id": "766730702",
                    "speaker": "派蒙",
                    "text": "感觉有几张拍得很不错呢，不过好像没拍到正面，等它转过来…"
                },
                {
                    "id": "766730703",
                    "speaker": "曼陀草",
                    "text": "吼——！"
                },
                {
                    "id": "766730704",
                    "speaker": "派蒙",
                    "text": "没错，就是这个感觉，很有气势呢！",
                    "choices": [
                        {
                            "id": "766730705",
                            "text": "派蒙…",
                            "response": [
                                {
                                    "id": "766730707",
                                    "speaker": "派蒙",
                                    "text": "呜哇啊啊——救命呀！！"
                                }
                            ]
                        },
                        {
                            "id": "766730706",
                            "text": "退后！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667308",
            "objective": "击退愤怒的曼陀草",
            "dialogues": []
        },
        {
            "id": "7667309",
            "objective": "将画片带回洞窟",
            "dialogues": [
                {
                    "id": "766730901",
                    "speaker": "派蒙",
                    "text": "尼可，我们回来啦！"
                },
                {
                    "id": "766730902",
                    "speaker": "尼可",
                    "text": "这么快！真不愧是你们。"
                },
                {
                    "id": "766730903",
                    "speaker": "派蒙",
                    "text": "过奖啦，不过画片要怎么给你呢？"
                },
                {
                    "id": "766730904",
                    "speaker": "尼可",
                    "text": "你们先带在身上吧。大概两天后我会到达那里，到时候我们可以一起聊聊有关雕塑的事情。"
                },
                {
                    "id": "766730905",
                    "speaker": "派蒙",
                    "text": "好呀，那我们不见不散！"
                }
            ]
        },
        {
            "id": "7667312",
            "objective": "等待到两天后（8-18点）",
            "dialogues": [
                {
                    "id": "766731201",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7667313",
            "objective": "与尼可对话",
            "dialogues": []
        },
        {
            "id": "7667315",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7667310",
            "objective": "尝试进行雕刻",
            "dialogues": [
                {
                    "id": "766731001",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7667311",
            "objective": "与尼可聊天",
            "dialogues": [
                {
                    "id": "766731132",
                    "speaker": "派蒙",
                    "text": "接下来，只要找尼可做一点修饰…"
                },
                {
                    "id": "766731133",
                    "speaker": "尼可",
                    "text": "敲掉多余的石块了？我看看。"
                },
                {
                    "id": "766731134",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这样就完成啦！"
                },
                {
                    "id": "766731101",
                    "speaker": "派蒙",
                    "text": "咦——魔女的小屋！什么时候出现的？"
                },
                {
                    "id": "766731102",
                    "speaker": "Player",
                    "text": "这就是魔女的力量吗？"
                },
                {
                    "id": "766731103",
                    "speaker": "尼可",
                    "text": "「这就是魔女的力量吗」，年轻人的表情充满了不可思议，「真是太了不起了。」"
                },
                {
                    "id": "766731104",
                    "speaker": "派蒙",
                    "text": "终于要讲之前的故事了吗？魔女和年轻人后来怎么样了呢？"
                },
                {
                    "id": "766731105",
                    "speaker": "尼可",
                    "text": "#{M#他们}{F#她们}开心地生活在了一起…"
                },
                {
                    "id": "766731106",
                    "speaker": "尼可",
                    "text": "…就是这样。"
                },
                {
                    "id": "766731107",
                    "speaker": "派蒙",
                    "text": "啊？",
                    "choices": [
                        {
                            "id": "766731108",
                            "text": "过程呢！",
                            "response": [
                                {
                                    "id": "766731110",
                                    "speaker": "尼可",
                                    "text": "真拿你们没办法，既然你们这么想听，那我就从头开始讲好了。"
                                },
                                {
                                    "id": "766731111",
                                    "speaker": "尼可",
                                    "text": "#自从年轻人许下「以你的愿望为我的愿望」后，{M#他}{F#她}就顺利地吸引了大魔女尼古拉·可可的注意。"
                                },
                                {
                                    "id": "766731112",
                                    "speaker": "尼可",
                                    "text": "然而就在两个人关系升温时，却突然闯入了一群不速之客，强行抓走了魔女！"
                                },
                                {
                                    "id": "766731113",
                                    "speaker": "尼可",
                                    "text": "年轻人大惊，这时候新的魔女艾莉娜丝出现，跟年轻人签订了契约，让年轻人也拥有了魔法。"
                                },
                                {
                                    "id": "766731114",
                                    "speaker": "尼可",
                                    "text": "在经历了艰苦卓绝的特训后，却发现这背后其实是另一个阴谋！"
                                },
                                {
                                    "id": "766731115",
                                    "speaker": "尼可",
                                    "text": "原来大魔女尼古拉·可可其实是外星生命，是猫星国王喵特拉斯三世的大女儿。"
                                },
                                {
                                    "id": "766731116",
                                    "speaker": "尼可",
                                    "text": "她们伪装成魔女，真实目的是为了让全世界都在不知不觉中信仰猫猫星！"
                                },
                                {
                                    "id": "766731117",
                                    "speaker": "尼可",
                                    "text": "「伟大的魔女啊，难道您一直在欺骗我吗？」年轻人只觉得自己心肝寸裂，声音不由得发颤。"
                                },
                                {
                                    "id": "766731118",
                                    "speaker": "尼可",
                                    "text": "「回去吧，我们猫猫星和你们注定会有一场战争，我们从一开始其实就是敌人。」"
                                },
                                {
                                    "id": "766731119",
                                    "speaker": "尼可",
                                    "text": "魔女背过身，不让人看到她眼中的泪花…"
                                },
                                {
                                    "id": "766731120",
                                    "speaker": "尼可",
                                    "text": "年轻人却勇敢向前抓住了魔女的手腕，发誓要和她永不分开。魔女被年轻人的执着打动，决定要掀起反旗！"
                                },
                                {
                                    "id": "766731121",
                                    "speaker": "尼可",
                                    "text": "就在这个时候，当初帮助年轻人的艾莉娜丝却站在了国王那边。"
                                },
                                {
                                    "id": "766731122",
                                    "speaker": "尼可",
                                    "text": "原来她是喵特拉斯三世的二女儿，帮助年轻人是为了促成姐姐的实质性背叛，从而争夺王位继承权——"
                                },
                                {
                                    "id": "766731123",
                                    "speaker": "Black Screen",
                                    "text": "尼可滔滔不绝地讲述了曲折的过程，其中充满了各种奇怪的情节，最后甚至连主角都脱离了人类的范畴…"
                                },
                                {
                                    "id": "766731124",
                                    "speaker": "尼可",
                                    "text": "总之就是这样啦，最后变成猫的年轻人和魔女一同粉碎了阴谋，回到了魔女小屋，过上了与世隔绝的平静生活。全剧终。"
                                },
                                {
                                    "id": "766731125",
                                    "speaker": "派蒙",
                                    "text": "呜呜…真好啊，充满爱与反抗的旅程…"
                                },
                                {
                                    "id": "766731126",
                                    "speaker": "Player",
                                    "text": "感觉和开头已经是两个故事了…"
                                },
                                {
                                    "id": "766731127",
                                    "speaker": "尼可",
                                    "text": "没办法，任何事物一旦被创造出来，终有一天都会脱离创造者的掌控。"
                                },
                                {
                                    "id": "766731128",
                                    "speaker": "尼可",
                                    "text": "就像我们「天使」，曾经被赋予引导人类的职责，却因为部分天使选择了「另一条路」，最终整个族群受到惩罚。"
                                },
                                {
                                    "id": "766731129",
                                    "speaker": "尼可",
                                    "text": "就算是天理，也无法完全掌控它创造的东西…何况我呢？"
                                },
                                {
                                    "id": "766731130",
                                    "speaker": "尼可",
                                    "text": "命运就是那么不可言说，不过嘛…我还是希望引导我所见到的人，获得一个美好的结局。哪怕是故事中的人也一样。"
                                },
                                {
                                    "id": "766731131",
                                    "speaker": "尼可",
                                    "text": "好了，这个故事讲完，我的热情也燃尽了。下次有好的故事，再分享给你们吧。"
                                },
                                {
                                    "id": "766731135",
                                    "speaker": "尼可",
                                    "text": "原来她是喵特拉斯三世的二女儿…"
                                },
                                {
                                    "id": "766731136",
                                    "speaker": "尼可",
                                    "text": "帮助年轻人是为了促成姐姐的实质性背叛…"
                                },
                                {
                                    "id": "766731137",
                                    "speaker": "尼可",
                                    "text": "从而争夺王位继承权——"
                                }
                            ]
                        },
                        {
                            "id": "766731109",
                            "text": "中间省略太多了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766730101",
                    "speaker": "？？？",
                    "text": "#年轻人继续走着，{M#他}{F#她}留意到魔女的领土上有许多巧夺天工的雕塑。「这是什么？」年轻人不解地询问。"
                },
                {
                    "id": "766730102",
                    "speaker": "？？？",
                    "text": "「这些都是魔女的反对者，它们觊觎魔女的力量，所以被变成了石头。」"
                },
                {
                    "id": "766730103",
                    "speaker": "？？？",
                    "text": "这个设定不错，虽然是我现想的。魔女就应该是既强大又危险的存在…危险带来神秘，没有神秘，世间的一切都会黯淡无光。"
                },
                {
                    "id": "766730104",
                    "speaker": "？？？",
                    "text": "（不过动辄把人变成石头会不会太过分了？没人愿意跟这样的怪人长期相处吧，还是把刚刚说的话当做警告好了。）"
                },
                {
                    "id": "766730105",
                    "speaker": "？？？",
                    "text": "听完之后，年轻人冷汗直流。就在这时，魔女的笑声再次响起：「呵呵，当真了吗？不过是以雕塑来定格时光而已。」"
                },
                {
                    "id": "766730106",
                    "speaker": "？？？",
                    "text": "「雕塑——这就是我需要你帮我完成的事情，魔女的小屋缺少更多可爱的小家伙。」"
                }
            ]
        },
        {
            "id": "7667306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766730613",
                    "speaker": "观察",
                    "text": "「哦呵呵呵呵，被妾身折服了吗，我可是永生之大魔女——」"
                },
                {
                    "id": "766730614",
                    "speaker": "观察",
                    "text": "笑起来会不会太吵了？"
                },
                {
                    "id": "766730615",
                    "speaker": "观察",
                    "text": "算了反正写成文字也没人听得见。"
                },
                {
                    "id": "766730616",
                    "speaker": "观察",
                    "text": "这一点很好，符合大家对魔女的期待。"
                },
                {
                    "id": "766730617",
                    "speaker": "观察",
                    "text": "但事实上，并非是我定格了这里的时间，而是时间定格了我，哈哈。"
                }
            ]
        },
        {
            "id": "7667313",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766731301",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7667399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766739906",
                    "speaker": "派蒙",
                    "text": "咦，快看那边，是团雀吗？"
                },
                {
                    "id": "766739907",
                    "speaker": "派蒙",
                    "text": "感觉它们很有活力呢。决定了，第一张画片就拍团雀吧！"
                },
                {
                    "id": "766739908",
                    "speaker": "派蒙",
                    "text": "让我想想，第二张拍什么比较好呢？"
                },
                {
                    "id": "766739909",
                    "speaker": "派蒙",
                    "text": "说起来，刚刚好像看到了关于松鼠的雕塑。难道说尼可喜欢松鼠？"
                },
                {
                    "id": "766739910",
                    "speaker": "派蒙",
                    "text": "拍几张画片带回去吧！"
                },
                {
                    "id": "766739911",
                    "speaker": "派蒙",
                    "text": "这家伙…是曼陀草吗？"
                },
                {
                    "id": "766739912",
                    "speaker": "派蒙",
                    "text": "把它做成雕塑，一定很有意思！"
                },
                {
                    "id": "766739913",
                    "speaker": "派蒙",
                    "text": "呼…吓我一跳，没想到它一下子就扑上来啦。"
                },
                {
                    "id": "766739914",
                    "speaker": "派蒙",
                    "text": "#靠你啦{NICKNAME}，加油！"
                },
                {
                    "id": "766739915",
                    "speaker": "派蒙",
                    "text": "呼，这样就搞定啦。"
                },
                {
                    "id": "766739916",
                    "speaker": "派蒙",
                    "text": "画片我都保护好啦，我们回去找尼可吧。"
                }
            ]
        }
    ]
}