    "talks": [
        {
            "id": "37501",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3750101",
                    "speaker": "温迪",
                    "text": "唉，果然你也不行吗…"
                },
                {
                    "id": "3750102",
                    "speaker": "派蒙",
                    "text": "果、果然？"
                },
                {
                    "id": "3750103",
                    "speaker": "温迪",
                    "text": "#只是想看看{NICKNAME}作为骑士团超级新人，究竟够不够分量啦。"
                },
                {
                    "id": "3750104",
                    "speaker": "温迪",
                    "text": "你看，勇者顺手就取走了村子里名贵的宝剑——"
                },
                {
                    "id": "3750105",
                    "speaker": "温迪",
                    "text": "这不是非常适合传唱的故事吗？"
                },
                {
                    "id": "3750106",
                    "speaker": "派蒙",
                    "text": "哼，感觉你的比喻很失礼啊，吟游诗人。"
                },
                {
                    "id": "3750107",
                    "speaker": "温迪",
                    "text": "哎呀，你误会我了。这是对蒙德的失望，面对勇者却还要吝啬宝剑。"
                },
                {
                    "id": "3750108",
                    "speaker": "温迪",
                    "text": "那么，看来明借是行不通的，只能巧取了。"
                },
                {
                    "id": "3750109",
                    "speaker": "温迪",
                    "text": "今天我们充分尊重自由意志，你们说说喜欢怎样巧取？"
                },
                {
                    "id": "3750110",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "3750111",
                    "speaker": "温迪",
                    "text": "说吧，不要拘束，自由意志就是要畅所欲言。"
                },
                {
                    "id": "3750112",
                    "speaker": "Player",
                    "text": "其实我不想偷东西！"
                },
                {
                    "id": "3750113",
                    "speaker": "温迪",
                    "text": "啊哈哈，你看你，一开口就跑题了。"
                },
                {
                    "id": "3750114",
                    "speaker": "温迪",
                    "text": "认真地说，这件事你比我更适合去做。"
                },
                {
                    "id": "3750115",
                    "speaker": "温迪",
                    "text": "因为我除了唱歌，就没什么值得自信的长处了。"
                },
                {
                    "id": "3750116",
                    "speaker": "温迪",
                    "text": "而且我在蒙德无依无靠，被抓住了无人申冤，一定会从重处罚。"
                },
                {
                    "id": "3750117",
                    "speaker": "派蒙",
                    "text": "偷东西被抓住了也没什么冤枉吧。"
                },
                {
                    "id": "3750118",
                    "speaker": "温迪",
                    "text": "#但{NICKNAME}不同。你是为蒙德城作过贡献的，骑士团的明日之星。"
                },
                {
                    "id": "3750119",
                    "speaker": "温迪",
                    "text": "失手了以后好好解释一下，或许就能蒙混过去了。"
                },
                {
                    "id": "3750120",
                    "speaker": "派蒙",
                    "text": "不要一直以失手为前提啊！"
                },
                {
                    "id": "3750121",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}…你觉得怎样？"
                },
                {
                    "id": "3750122",
                    "speaker": "Player",
                    "text": "你刚才说自己是巴巴托斯。"
                },
                {
                    "id": "3750123",
                    "speaker": "温迪",
                    "text": "啊呀，好像是这么说过——"
                },
                {
                    "id": "3750124",
                    "speaker": "温迪",
                    "text": "所以呢？"
                },
                {
                    "id": "3750125",
                    "speaker": "Player",
                    "text": "如果你真是神，就不能放着不管。"
                },
                {
                    "id": "3750126",
                    "speaker": "温迪",
                    "text": "哦？这是为什么？"
                },
                {
                    "id": "3750127",
                    "speaker": "派蒙",
                    "text": "#有关{NICKNAME}的过去，以后再慢慢跟你说吧…"
                },
                {
                    "id": "3750128",
                    "speaker": "Player",
                    "text": "如果你不是神，我也会救特瓦林。"
                },
                {
                    "id": "3750129",
                    "speaker": "温迪",
                    "text": "…咦？",
                    "choices": [
                        {
                            "id": "3750130",
                            "text": "我会为你带回「天空」。"
                        },
                        {
                            "id": "3750131",
                            "text": "因为我不想再见到「分离」。"
                        }
                    ]
                }
            ]
        },
