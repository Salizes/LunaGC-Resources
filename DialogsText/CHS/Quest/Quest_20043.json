            "米歇尔": 14
        }
    },
    "talks": [
        {
            "id": "2004301",
            "objective": "与米歇尔小姐对话",
            "dialogues": [
                {
                    "id": "200430101",
                    "speaker": "米歇尔",
                    "text": "腰怎么这么痛…"
                },
                {
                    "id": "200430102",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "200430103",
                    "speaker": "米歇尔",
                    "text": "我正准备去工作，但是突然腰很痛。"
                },
                {
                    "id": "200430104",
                    "speaker": "米歇尔",
                    "text": "我已经和昆恩约好去他的水果摊帮忙，现在只能休息一下再去了…"
                },
                {
                    "id": "200430105",
                    "speaker": "米歇尔",
                    "text": "唉，但是光待在这里也只是耽误事。"
                },
                {
                    "id": "200430106",
                    "speaker": "米歇尔",
                    "text": "你能帮我去问问昆恩，他需要我做什么工作吗？我也好做些准备。",
                    "choices": [
                        {
                            "id": "200430107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "200430108",
                                    "speaker": "米歇尔",
                                    "text": "那就拜托你了，我只要休息一会就好。"
                                }
                            ]
                        },
                        {
                            "id": "200430109",
                            "text": "这看着不远…",
                            "response": [
                                {
                                    "id": "200430110",
                                    "speaker": "派蒙",
                                    "text": "喂，这么点小事，帮个忙也没关系吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004306",
            "objective": "(test)触发和派蒙的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "200430601",
                    "speaker": "米歇尔",
                    "text": "你们问昆恩先生了吗？"
                },
                {
                    "id": "200430602",
                    "speaker": "Player",
                    "text": "昆恩先生请你回去休息。"
                },
                {
                    "id": "200430603",
                    "speaker": "派蒙",
                    "text": "昆恩先生的店里今天没有什么工作喔，请回去好好休息吧！"
                },
                {
                    "id": "200430604",
                    "speaker": "米歇尔",
                    "text": "是吗，呼…看来要去找别的事做了呢。"
                },
                {
                    "id": "200430605",
                    "speaker": "派蒙",
                    "text": "咦，咦？！你不去休息吗？好不容易不用工作了…"
                },
                {
                    "id": "200430606",
                    "speaker": "米歇尔",
                    "text": "你们感受一下四周，巴巴托斯大人的风还在勤劳地工作着。"
                },
                {
                    "id": "200430607",
                    "speaker": "米歇尔",
                    "text": "我们这些被他庇佑着的人，也没有偷懒的道理。"
                },
                {
                    "id": "200430608",
                    "speaker": "米歇尔",
                    "text": "不过，你是去做什么事了，怎么出了这么多汗？"
                },
                {
                    "id": "200430609",
                    "speaker": "米歇尔",
                    "text": "看来你也是个忙碌的人呢。不过这样也好，借助着辛勤的汗水，才能更清晰地感受到巴巴托斯大人的风。"
                },
                {
                    "id": "200430610",
                    "speaker": "米歇尔",
                    "text": "来，这瓶牛奶给你，快点喝掉，然后继续加油吧，工作可是永无止境的。"
                }
            ]
        },
        {
            "id": "2004307",
            "objective": "(test)和派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "200430801",
                    "speaker": "派蒙",
                    "text": "呜哇，这么忙，看起来工作就很辛苦。"
                },
                {
                    "id": "200430802",
                    "speaker": "派蒙",
                    "text": "米歇尔小姐已经很累了，我们先帮昆恩先生把工作做完吧。"
                },
                {
                    "id": "200430803",
                    "speaker": "派蒙",
                    "text": "然后再拜托他，给米歇尔小姐一个轻松的工作…"
                },
                {
                    "id": "200430804",
                    "speaker": "派蒙",
                    "text": "希望我们这样自作主张，不会让米歇尔小姐不高兴。"
                }
            ]
        },
        {
            "id": "2004302",
            "objective": "与昆恩对话",
            "dialogues": [
                {
                    "id": "200430301",
                    "speaker": "昆恩",
                    "text": "怎么还没送来，糟糕了…"
                },
                {
                    "id": "200430302",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "200430303",
                    "speaker": "昆恩",
                    "text": "啊…摊子里的日落果卖光了，我刚去订了几批日落果。"
                },
                {
                    "id": "200430304",
                    "speaker": "昆恩",
                    "text": "但是到现在也没送来…好多客人都在等着买呢。"
                },
                {
                    "id": "200430305",
                    "speaker": "昆恩",
                    "text": "光是优律小姐就来了三趟了，她就只要<color=#00E1FFFF>三颗日落果</color>，我可不想失去这个老顾客啊！"
                },
                {
                    "id": "200430306",
                    "speaker": "昆恩",
                    "text": "我还要看摊子…要是谁能帮我去城外找点日落果回来就好了。",
                    "choices": [
                        {
                            "id": "200430307",
                            "text": "很急的话，我能帮忙。",
                            "response": [
                                {
                                    "id": "200430308",
                                    "speaker": "昆恩",
                                    "text": "你愿意帮忙吗？那太好了，就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "200430309",
                            "text": "米歇尔小姐马上就来…",
                            "response": [
                                {
                                    "id": "200430310",
                                    "speaker": "派蒙",
                                    "text": "等一下！米歇尔小姐那个样子，怎么出去摘果子啊！"
                                },
                                {
                                    "id": "200430311",
                                    "speaker": "派蒙",
                                    "text": "我们来帮忙吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004303",
            "objective": "收集日落果",
            "dialogues": []
        },
        {
            "id": "2004304",
            "objective": "将日落果交给昆恩",
            "dialogues": [
                {
                    "id": "200430501",
                    "speaker": "昆恩",
                    "text": "你找到日落果了吗？"
                },
                {
                    "id": "200430502",
                    "speaker": "Player",
                    "text": "已经找好了。"
                },
                {
                    "id": "200430503",
                    "speaker": "昆恩",
                    "text": "谢谢，这些应该就够优律小姐买了。"
                },
                {
                    "id": "200430504",
                    "speaker": "昆恩",
                    "text": "唉，但是很多客人们还是走掉了，一个人果然还是忙不过来啊。"
                },
                {
                    "id": "200430505",
                    "speaker": "昆恩",
                    "text": "哦对了，谢谢你们帮忙，要给你们谢礼才行，稍等一下…"
                },
                {
                    "id": "200430506",
                    "speaker": "派蒙",
                    "text": "谢礼就不用了，我们有事情拜托你…"
                },
                {
                    "id": "200430507",
                    "speaker": "Player",
                    "text": "关于米歇尔小姐…"
                },
                {
                    "id": "200430508",
                    "speaker": "昆恩",
                    "text": "米歇尔小姐…你们遇见她了吗？"
                },
                {
                    "id": "200430509",
                    "speaker": "昆恩",
                    "text": "希望我交给她一点轻松的工作？"
                },
                {
                    "id": "200430510",
                    "speaker": "昆恩",
                    "text": "可我一开始就只准备让她帮忙看店啊。"
                },
                {
                    "id": "200430511",
                    "speaker": "派蒙",
                    "text": "是，是这样吗？"
                },
                {
                    "id": "200430512",
                    "speaker": "昆恩",
                    "text": "不过现在客人们都走了，看来是不用人看店了…"
                },
                {
                    "id": "200430513",
                    "speaker": "昆恩",
                    "text": "麻烦你们告诉米歇尔小姐，让她回去休息吧。"
                },
                {
                    "id": "200430514",
                    "speaker": "昆恩",
                    "text": "我等会准备去看看那批货到底怎么回事…"
                }
            ]
        },
        {
            "id": "2004305",
            "objective": "与米歇尔小姐对话",
            "dialogues": []
        },
        {
            "id": "2004302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200430201",
                    "speaker": "米歇尔",
                    "text": "腰好痛…应该休息一下就好了吧…"
                }
            ]
        },
        {
            "id": "2004304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200430401",
                    "speaker": "昆恩",
                    "text": "你找到<color=#00E1FFFF>日落果</color>了吗？"
                },
                {
                    "id": "200430402",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "200430403",
                    "speaker": "昆恩",
                    "text": "拜托你了，城外应该有很多<color=#00E1FFFF>日落果</color>，我要看着摊子，请快去快回啊！"
                }
            ]
        },
        {
            "id": "2004307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200430701",
                    "speaker": "昆恩",
                    "text": "糟糕了…"
                }
            ]
        },
        {
            "id": "2004309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200430901",
                    "speaker": "昆恩",
                    "text": "谢谢你们帮我忙。唉，下次我要多找点人帮忙…贝雅特丽奇…算了。"
                }
            ]
        },
        {
            "id": "2004310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200431001",
                    "speaker": "派蒙",
                    "text": "哈哈…哈…也是好事呀！算是锻炼身体吧…"
                }
            ]
        }
    ]
}