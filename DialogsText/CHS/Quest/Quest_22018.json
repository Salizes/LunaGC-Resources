        {
            "id": "2201808",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220180801",
                    "speaker": "珊瑚",
                    "text": "这个犯人的想法还真是有意思…"
                }
            ]
        },
        {
            "id": "2201809",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220180901",
                    "speaker": "弥生七月",
                    "text": "抱歉，我什么也没看见…被勘兵卫先生怒吼的声音吵醒之后，我才知道这件事…"
                }
            ]
        },
        {
            "id": "2201810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181001",
                    "speaker": "弥生七月",
                    "text": "您好…请问你们有什么事吗？"
                },
                {
                    "id": "220181002",
                    "speaker": "Player",
                    "text": "关于失窃的「志村屋」…"
                },
                {
                    "id": "220181003",
                    "speaker": "弥生七月",
                    "text": "嗯，我听说过。勘兵卫先生怒吼的声音，我想不听见都难…"
                },
                {
                    "id": "220181004",
                    "speaker": "弥生七月",
                    "text": "你们是想问我有没有看见什么吗？"
                },
                {
                    "id": "220181005",
                    "speaker": "弥生七月",
                    "text": "抱歉，我什么也没看见…被勘兵卫先生怒吼的声音吵醒之后，我才知道这件事…"
                },
                {
                    "id": "220181006",
                    "speaker": "Player",
                    "text": "周围有什么可疑的人吗？"
                },
                {
                    "id": "220181007",
                    "speaker": "弥生七月",
                    "text": "可疑的人？嗯…我也没发现什么可疑的人。"
                },
                {
                    "id": "220181008",
                    "speaker": "弥生七月",
                    "text": "而且，现在城里的气氛到处都很紧张，如果有可疑的人，应该也早就被同心带走讯问了吧…"
                }
            ]
        },
        {
            "id": "2201811",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181101",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做出这种事来…"
                }
            ]
        },
        {
            "id": "2201812",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181201",
                    "speaker": "弥生七月",
                    "text": "抱歉，我什么也没看见…被勘兵卫先生怒吼的声音吵醒之后，我才知道这件事…"
                }
            ]
        },
        {
            "id": "2201813",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181301",
                    "speaker": "古谷升",
                    "text": "勘兵卫先生的精神可真好啊…"
                }
            ]
        },
        {
            "id": "2201814",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181401",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做的这种事…"
                },
                {
                    "id": "220181402",
                    "speaker": "Player",
                    "text": "您就是志村勘兵卫吗？"
                },
                {
                    "id": "220181403",
                    "speaker": "志村勘兵卫",
                    "text": "啊，我就是，你是…哦！这不是龙二吗？"
                },
                {
                    "id": "220181404",
                    "speaker": "志村勘兵卫",
                    "text": "怎么样，珊瑚小姐查到那个混账到底是谁了吗？我非要好好教训一下那家伙不可…"
                },
                {
                    "id": "220181405",
                    "speaker": "龙二",
                    "text": "社长暂时还没有查到犯人。"
                },
                {
                    "id": "220181406",
                    "speaker": "Player",
                    "text": "关于失窃的情况…"
                },
                {
                    "id": "220181407",
                    "speaker": "志村勘兵卫",
                    "text": "我已经把我知道的都告诉珊瑚小姐了。当时我喝酒喝太多，直接就睡下了。"
                },
                {
                    "id": "220181408",
                    "speaker": "志村勘兵卫",
                    "text": "再醒过来的时候，店里的钱就已经都不见了！"
                },
                {
                    "id": "220181409",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做出这种事来…"
                }
            ]
        },
        {
            "id": "2201815",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181501",
                    "speaker": "石川八郎",
                    "text": "你…看见我的「神之眼」了吗…"
                },
                {
                    "id": "220181502",
                    "speaker": "Player",
                    "text": "你有「神之眼」？"
                },
                {
                    "id": "220181503",
                    "speaker": "石川八郎",
                    "text": "我有…我有…就、就放在这的，怎么就弄丢了呢…嗝…"
                },
                {
                    "id": "220181504",
                    "speaker": "石川八郎",
                    "text": "怎么就…弄丢了呢…呜呜呜…"
                },
                {
                    "id": "220181505",
                    "speaker": "石川八郎",
                    "text": "大哥…对、对不起，我的「神之眼」也…呜呜…"
                }
            ]
        },
        {
            "id": "2201816",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181601",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做出这种事来…"
                }
            ]
        },
        {
            "id": "2201817",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181701",
                    "speaker": "古谷升",
                    "text": "嗯？你们找我有什么事吗？"
                },
                {
                    "id": "220181702",
                    "speaker": "Player",
                    "text": "关于失窃的「志村屋」…"
                },
                {
                    "id": "220181703",
                    "speaker": "古谷升",
                    "text": "这件事啊，我也听说了。"
                },
                {
                    "id": "220181704",
                    "speaker": "古谷升",
                    "text": "如果你们是想问我有没有目击到什么的话，抱歉，我应该不知道什么有价值的线索。"
                },
                {
                    "id": "220181705",
                    "speaker": "古谷升",
                    "text": "在「志村屋」失窃的时候，我正在冒险家协会里处理一些事务。"
                },
                {
                    "id": "220181706",
                    "speaker": "古谷升",
                    "text": "如果你们需要我的不在场证明，可以去问问凯瑟琳。"
                },
                {
                    "id": "220181707",
                    "speaker": "Player",
                    "text": "周围有什么可疑的人吗？"
                },
                {
                    "id": "220181708",
                    "speaker": "古谷升",
                    "text": "可疑的人？"
                },
                {
                    "id": "220181709",
                    "speaker": "古谷升",
                    "text": "唔…就我来说的话，实在是无法分辨。"
                },
                {
                    "id": "220181710",
                    "speaker": "古谷升",
                    "text": "毕竟，在「眼狩令」这种法令下…从行为上能够称得上「可疑」的人实在是太多了。"
                }
            ]
        },
        {
            "id": "2201818",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181801",
                    "speaker": "古谷升",
                    "text": "如果你们需要我的不在场证明，可以去问问凯瑟琳。"
                }
            ]
        },
        {
            "id": "2201819",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220181901",
                    "speaker": "珊瑚",
                    "text": "你们回来了，怎么样？调查到什么了吗？"
                },
                {
                    "id": "220181902",
                    "speaker": "珊瑚",
                    "text": "唔…我知道了，辛苦你们了。"
                },
                {
                    "id": "220181903",
                    "speaker": "珊瑚",
                    "text": "这个犯人的作案手法还真是准确。除了勘兵卫先生之外，「根付之源」的店主御舆源一郎先生也是受害者。"
                },
                {
                    "id": "220181904",
                    "speaker": "珊瑚",
                    "text": "犯人似乎也「恰好」知道，他有隔一段时间就去拜访好友的习惯。选在这个时间，偷走了店里不少值钱的东西。"
                },
                {
                    "id": "220181905",
                    "speaker": "珊瑚",
                    "text": "哦对了，还有弥生小姐的漆器店。在弥生小姐出门给客人送漆器的时候，店里的不少珍贵漆器也失窃了。",
                    "choices": [
                        {
                            "id": "220181906",
                            "text": "犯人很熟悉这些行为…",
                            "response": [
                                {
                                    "id": "220181907",
                                    "speaker": "珊瑚",
                                    "text": "唔，没错。但你也看见了，这条街上的商家和居民本就不多，如果是熟人作案的话，很快就会露出马脚。"
                                },
                                {
                                    "id": "220181908",
                                    "speaker": "珊瑚",
                                    "text": "但如果不是熟人作案的话，又怎么能够这么精确地把握受害者出门的时间呢？"
                                },
                                {
                                    "id": "220181910",
                                    "speaker": "珊瑚",
                                    "text": "这个问题我也稍微想了想。在拜托了天野和安藤查了一遍周围住户和商家的行踪记录后，基本上排除了熟人作案的可能。"
                                },
                                {
                                    "id": "220181911",
                                    "speaker": "珊瑚",
                                    "text": "虽然犯罪的地点十分零散，粗看起来，很像是野外流窜的盗宝团一时兴起进城偷窃…"
                                },
                                {
                                    "id": "220181912",
                                    "speaker": "珊瑚",
                                    "text": "但这个犯人作案的手法十分精确，犯罪现场收拾地也很利落，完全不像是那些盗宝团干一票就走的风格。"
                                },
                                {
                                    "id": "220181913",
                                    "speaker": "珊瑚",
                                    "text": "我觉得…也许犯人真的是亲身在城内一一踩点，不断搜集着周围人的起居信息，给自己的犯罪做计划…"
                                },
                                {
                                    "id": "220181914",
                                    "speaker": "珊瑚",
                                    "text": "但就如同我之前所说，这里的居民数量并不多，大家都彼此相熟，要是真有什么陌生人的话，大家也一定会马上发现。",
                                    "choices": [
                                        {
                                            "id": "220181915",
                                            "text": "这不完全堵死了吗！",
                                            "response": [
                                                {
                                                    "id": "220181917",
                                                    "speaker": "珊瑚",
                                                    "text": "所以，这位犯人如果真的想要做到这件事，那么…他一定要有一个「合适的身份」。"
                                                },
                                                {
                                                    "id": "220181918",
                                                    "speaker": "珊瑚",
                                                    "text": "而这个身份要足够合理，合理到能够让他在任何时间，出现在任何地点，都不招人怀疑。"
                                                },
                                                {
                                                    "id": "220181919",
                                                    "speaker": "Player",
                                                    "text": "真的有这种身份吗…"
                                                },
                                                {
                                                    "id": "220181920",
                                                    "speaker": "珊瑚",
                                                    "text": "当然有了，而且…你应该也见过不少了。"
                                                },
                                                {
                                                    "id": "220181921",
                                                    "speaker": "珊瑚",
                                                    "text": "那就是…"
                                                },
                                                {
                                                    "id": "220181922",
                                                    "speaker": "珊瑚",
                                                    "text": "因为「眼狩令」失去了「神之眼」，然后性情大变的人。"
                                                },
                                                {
                                                    "id": "220181923",
                                                    "speaker": "珊瑚",
                                                    "text": "因为失去了「神之眼」而性情大变，成天昏昏沉沉，既不知道自己从哪里来，也不和其他人说话。"
                                                },
                                                {
                                                    "id": "220181924",
                                                    "speaker": "珊瑚",
                                                    "text": "只是念叨着一些难懂的话，不断地自言自语。如果还想再让人信服…或者说，再更容易博得同情一点…"
                                                },
                                                {
                                                    "id": "220181925",
                                                    "speaker": "珊瑚",
                                                    "text": "也许，他还会喝点酒，在路边双目无神地发着呆，只要有人和他搭话，除了「神之眼」之外，他什么也不会说。"
                                                },
                                                {
                                                    "id": "220181926",
                                                    "speaker": "珊瑚",
                                                    "text": "而对一个失去了「神之眼」的人，就算是外乡的陌生人，人们对他也大多是同情大于怀疑。"
                                                },
                                                {
                                                    "id": "220181927",
                                                    "speaker": "珊瑚",
                                                    "text": "如果，他再讲述点自己的过往…唔，说不定还能感动些人，反倒会给他点钱，让他有了启动自己犯罪行动的第一笔资金呢。"
                                                },
                                                {
                                                    "id": "220181928",
                                                    "speaker": "Player",
                                                    "text": "但是「眼狩令」已经结束了。"
                                                },
                                                {
                                                    "id": "220181929",
                                                    "speaker": "珊瑚",
                                                    "text": "没错，所以…那家伙应该也在不知所措呢。"
                                                },
                                                {
                                                    "id": "220181930",
                                                    "speaker": "珊瑚",
                                                    "text": "这次辛苦你了，距离找出那个家伙，应该只剩下最后几步了。"
                                                },
                                                {
                                                    "id": "220181931",
                                                    "speaker": "珊瑚",
                                                    "text": "等找到了足够的证据之后，还需要你再去大显身手，在那之前，你就好好休息吧。"
                                                },
                                                {
                                                    "id": "220181932",
                                                    "speaker": "珊瑚",
                                                    "text": "这些东西给你，就当做是报酬了，收下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220181916",
                                            "text": "这不就完全没思路了吗…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220181909",
                            "text": "犯人怎么能这么准确把握时间的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201820",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220182001",
                    "speaker": "石川八郎",
                    "text": "「眼狩令」结束了…我…这…"
                },
                {
                    "id": "220182002",
                    "speaker": "石川八郎",
                    "text": "怎、怎么突然就结束了…"
                },
                {
                    "id": "220182003",
                    "speaker": "石川八郎",
                    "text": "不行，我得想点其他的办法…"
                }
            ]
