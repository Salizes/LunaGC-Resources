            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 180,
        "total_speaker_counts": {
            "Player": 31,
            "古谷升": 26,
            "弥生七月": 14,
            "志村勘兵卫": 14,
            "珊瑚": 84,
            "石川八郎": 7,
            "龙二": 4
        }
    },
    "talks": [
        {
            "id": "2201801",
            "objective": "与珊瑚对话",
            "dialogues": [
                {
                    "id": "220180101",
                    "speaker": "珊瑚",
                    "text": "看来只有这一种可能了…"
                },
                {
                    "id": "220180102",
                    "speaker": "珊瑚",
                    "text": "唔…看来还得再找一点线索才行…"
                },
                {
                    "id": "220180103",
                    "speaker": "Player",
                    "text": "案子怎么样了？"
                },
                {
                    "id": "220180104",
                    "speaker": "珊瑚",
                    "text": "哦呀，这不是旅行者吗？你来得正好，案情的侦破工作刚好到了紧要关头。"
                },
                {
                    "id": "220180105",
                    "speaker": "珊瑚",
                    "text": "多亏了天野和安藤先生的行动，那位犯人似乎完全相信，同心们的侦察方向转向了野外的盗宝团。"
                },
                {
                    "id": "220180106",
                    "speaker": "珊瑚",
                    "text": "所以，那位犯人还在城里时不时地犯案，留下了不少痕迹。"
                },
                {
                    "id": "220180107",
                    "speaker": "珊瑚",
                    "text": "昨天那位犯人又犯案了，这回被偷的是「志村屋」的店主，勘兵卫先生。"
                },
                {
                    "id": "220180108",
                    "speaker": "珊瑚",
                    "text": "发现店里的钱被偷了之后，勘兵卫先生据说在店外怒吼了很长时间。"
                },
                {
                    "id": "220180109",
                    "speaker": "珊瑚",
                    "text": "要是再早几年，他说不定就会直接抄起家伙，亲自去城里搜捕犯人了吧。"
                },
                {
                    "id": "220180110",
                    "speaker": "龙二",
                    "text": "居然连勘兵卫先生的钱都敢偷，真是个胆大包天的人…"
                },
                {
                    "id": "220180111",
                    "speaker": "珊瑚",
                    "text": "不过，犯人选择的时机倒是也非常巧妙。"
                },
                {
                    "id": "220180112",
                    "speaker": "珊瑚",
                    "text": "他似乎早就打探到了，勘兵卫先生每隔几天都会闭店谢客，自己好好痛饮一番。"
                },
                {
                    "id": "220180113",
                    "speaker": "珊瑚",
                    "text": "而在勘兵卫先生痛饮大醉后，犯人悠悠然地取走了店里的钱，就这么轻松地走掉了…"
                },
                {
                    "id": "220180114",
                    "speaker": "珊瑚",
                    "text": "他已经连续几天过来拜托我找到犯人了，他那个嗓门，我可有点受不了了。"
                },
                {
                    "id": "220180115",
                    "speaker": "珊瑚",
                    "text": "所以，我想请你和龙二过去看看他的情况，听一听…嗯…他的抱怨。"
                },
                {
                    "id": "220180116",
                    "speaker": "珊瑚",
                    "text": "然后再顺便去调查，在「志村屋」失窃的那个时间段里，周围的人有没有看见…或者听见什么。"
                },
                {
                    "id": "220180117",
                    "speaker": "珊瑚",
                    "text": "调查完之后就回来告诉我吧，我会在这里等着你们的。"
                }
            ]
        },
        {
            "id": "2201802",
            "objective": "向弥生七月询问线索",
            "dialogues": [
                {
                    "id": "220180201",
                    "speaker": "弥生七月",
                    "text": "你好，请问你有什么事吗？"
                },
                {
                    "id": "220180202",
                    "speaker": "Player",
                    "text": "关于失窃的「志村屋」…"
                },
                {
                    "id": "220180203",
                    "speaker": "弥生七月",
                    "text": "嗯，我听说过。勘兵卫先生怒吼的声音，我想不听见都难…"
                },
                {
                    "id": "220180204",
                    "speaker": "弥生七月",
                    "text": "你们是想问我有没有看见什么吗？"
                },
                {
                    "id": "220180205",
                    "speaker": "弥生七月",
                    "text": "抱歉，我什么也没看见…被勘兵卫先生怒吼的声音吵醒之后，我才知道这件事…"
                },
                {
                    "id": "220180206",
                    "speaker": "Player",
                    "text": "周围有什么可疑的人吗？"
                },
                {
                    "id": "220180207",
                    "speaker": "弥生七月",
                    "text": "可疑的人？嗯…我也没发现什么可疑的人。"
                },
                {
                    "id": "220180208",
                    "speaker": "弥生七月",
                    "text": "唉，勘兵卫先生怒吼的声音真是够大的，周围的人应该都被他吼醒了吧…"
                }
            ]
        },
        {
            "id": "2201803",
            "objective": "向志村勘兵卫询问线索",
            "dialogues": [
                {
                    "id": "220180301",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做的这种事…"
                },
                {
                    "id": "220180302",
                    "speaker": "Player",
                    "text": "您就是志村勘兵卫吗？"
                },
                {
                    "id": "220180303",
                    "speaker": "志村勘兵卫",
                    "text": "啊，我就是，你是…哦！这不是龙二吗？"
                },
                {
                    "id": "220180304",
                    "speaker": "志村勘兵卫",
                    "text": "怎么样，珊瑚小姐查到那个混账到底是谁了吗？我非要好好教训一下那家伙不可…"
                },
                {
                    "id": "220180305",
                    "speaker": "龙二",
                    "text": "社长暂时还没有查到犯人。"
                },
                {
                    "id": "220180306",
                    "speaker": "Player",
                    "text": "关于失窃的情况…"
                },
                {
                    "id": "220180307",
                    "speaker": "志村勘兵卫",
                    "text": "我已经把我知道的都告诉珊瑚小姐了。当时我喝酒喝太多，直接就睡下了。"
                },
                {
                    "id": "220180308",
                    "speaker": "志村勘兵卫",
                    "text": "再醒过来的时候，店里的钱就已经都不见了！"
                },
                {
                    "id": "220180309",
                    "speaker": "志村勘兵卫",
                    "text": "可恶…到底是谁做出这种事来…"
                }
            ]
        },
        {
            "id": "2201804",
            "objective": "向古谷升询问线索",
            "dialogues": [
                {
                    "id": "220180401",
                    "speaker": "古谷升",
                    "text": "嗯？你找我有什么事吗？"
                },
                {
                    "id": "220180402",
                    "speaker": "Player",
                    "text": "关于失窃的「志村屋」…"
                },
                {
                    "id": "220180403",
                    "speaker": "古谷升",
                    "text": "这件事啊，我也听说了。"
                },
                {
                    "id": "220180404",
                    "speaker": "古谷升",
                    "text": "如果你是想问我有没有目击到什么的话，抱歉，我这里应该没什么有价值的线索。"
                },
                {
                    "id": "220180405",
                    "speaker": "古谷升",
                    "text": "我之前一直在冒险家协会里处理事务，没有出去过。"
                },
                {
                    "id": "220180406",
                    "speaker": "古谷升",
                    "text": "听见了勘兵卫先生的喊声之后，我出去看了看，然后才听说了这件事。"
                },
                {
                    "id": "220180407",
                    "speaker": "Player",
                    "text": "周围有什么可疑的人吗？"
                },
                {
                    "id": "220180408",
                    "speaker": "古谷升",
                    "text": "可疑的人？"
                },
                {
                    "id": "220180409",
                    "speaker": "古谷升",
                    "text": "唔…抱歉，我没注意过这方面的事。"
                },
                {
                    "id": "220180410",
                    "speaker": "古谷升",
                    "text": "不然…你们再去问问别人吧。"
                }
            ]
        },
        {
            "id": "2201805",
            "objective": "与珊瑚对话",
            "dialogues": [
                {
                    "id": "220180501",
                    "speaker": "珊瑚",
                    "text": "你们回来了，怎么样？调查到什么了吗？"
                },
                {
                    "id": "220180502",
                    "speaker": "珊瑚",
                    "text": "唔…我知道了，辛苦你们了。"
                },
                {
                    "id": "220180503",
                    "speaker": "珊瑚",
                    "text": "这个犯人的作案手法还真是准确。除了勘兵卫先生之外，「根付之源」的店主御舆源一郎先生也是受害者。"
                },
                {
                    "id": "220180504",
                    "speaker": "珊瑚",
                    "text": "在他离开店里，去拜访好友的时候，犯人从店里偷走了不少值钱的东西。"
                },
                {
                    "id": "220180505",
                    "speaker": "珊瑚",
                    "text": "哦对了，还有弥生小姐的漆器店。在弥生小姐出门给客人送漆器的时候，店里不少值钱的漆器也失窃了。",
                    "choices": [
                        {
                            "id": "220180506",
                            "text": "犯人很熟悉这些行为…",
                            "response": [
                                {
                                    "id": "220180507",
                                    "speaker": "珊瑚",
                                    "text": "唔，没错。但你也看见了，这条街上的商家和居民本就不多，如果是熟人作案的话，很快就会露出马脚。"
                                },
                                {
                                    "id": "220180508",
                                    "speaker": "珊瑚",
                                    "text": "但如果不是熟人作案的话，又怎么能够这么精确地把握受害者出门的时间呢？"
                                },
                                {
                                    "id": "220180510",
                                    "speaker": "珊瑚",
                                    "text": "这个问题我也稍微想了想。在拜托了天野和安藤查了一遍周围住户和商家的行踪后，基本上排除了熟人作案的可能。"
                                },
                                {
                                    "id": "220180511",
                                    "speaker": "珊瑚",
                                    "text": "虽然犯罪的地点十分零散，粗看起来，很像是野外流窜的盗宝团一时兴起进城偷窃…"
                                },
                                {
                                    "id": "220180512",
                                    "speaker": "珊瑚",
                                    "text": "但这个犯人作案的手法这么精确，完全不像是那些盗宝团干一票就走的风格。"
                                },
                                {
                                    "id": "220180513",
                                    "speaker": "珊瑚",
                                    "text": "我觉得…也许犯人真的是亲身在城内一一踩点，不断搜集着周围人的起居信息，给自己的犯罪做计划…"
                                },
                                {
                                    "id": "220180514",
                                    "speaker": "珊瑚",
                                    "text": "但就如同我之前所说，这里的居民数量并不多，大家都彼此相熟，要是真有什么陌生人的话，大家也一定会马上发现。",
                                    "choices": [
                                        {
                                            "id": "220180515",
                                            "text": "这不完全堵死了吗！",
                                            "response": [
                                                {
                                                    "id": "220180517",
                                                    "speaker": "珊瑚",
                                                    "text": "所以，这位犯人如果真的想要做到这件事，那么…他一定要有一个「合适的身份」。"
                                                },
                                                {
                                                    "id": "220180518",
                                                    "speaker": "珊瑚",
                                                    "text": "这个身份要足够合理，合理到…可以让他在任何时间，出现在任何地点，都不招人怀疑。"
                                                },
                                                {
                                                    "id": "220180519",
                                                    "speaker": "Player",
                                                    "text": "真的有这种身份吗…"
                                                },
                                                {
                                                    "id": "220180520",
                                                    "speaker": "珊瑚",
                                                    "text": "当然有了，而且…你说不定还见过有这种身份的人。"
                                                },
                                                {
                                                    "id": "220180521",
                                                    "speaker": "珊瑚",
                                                    "text": "那就是…"
                                                },
                                                {
                                                    "id": "220180522",
                                                    "speaker": "珊瑚",
                                                    "text": "因为「眼狩令」失去了「神之眼」，然后性情大变的人。"
                                                },
                                                {
                                                    "id": "220180523",
                                                    "speaker": "Player",
                                                    "text": "怎么可能…"
                                                },
                                                {
                                                    "id": "220180524",
                                                    "speaker": "珊瑚",
                                                    "text": "因为失去了「神之眼」而性情大变，成天昏昏沉沉，既不知道自己从哪里来，也不和其他人说话。"
                                                },
                                                {
                                                    "id": "220180525",
                                                    "speaker": "珊瑚",
                                                    "text": "只是念叨着一些难懂的话，不断地自言自语。如果还想再让人信服…或者说，再更容易博得同情一点…"
                                                },
                                                {
                                                    "id": "220180526",
                                                    "speaker": "珊瑚",
                                                    "text": "也许，他还会喝点酒，在路边双目无神地发着呆…"
                                                },
                                                {
                                                    "id": "220180527",
                                                    "speaker": "珊瑚",
                                                    "text": "面对着一个失去了「神之眼」的陌生人，一般来说…人们对他的情感，都应该是同情大于怀疑吧。"
                                                },
                                                {
                                                    "id": "220180528",
                                                    "speaker": "珊瑚",
                                                    "text": "如果，这位陌生人再讲述点自己的过往…唔，说不定还能感动些人，反倒会给他点钱，让他有了启动自己犯罪行动的第一笔资金呢。",
                                                    "choices": [
                                                        {
                                                            "id": "220180529",
                                                            "text": "…居然用这种身份做掩饰。",
                                                            "response": [
                                                                {
                                                                    "id": "220180531",
                                                                    "speaker": "珊瑚",
                                                                    "text": "冷静一点啦。在犯罪者的眼中，除了自己的犯罪目标之外，其余的一切都是可以被践踏的玩物。"
                                                                },
                                                                {
                                                                    "id": "220180532",
                                                                    "speaker": "珊瑚",
                                                                    "text": "这次辛苦你了，距离找出那个家伙，应该只剩下最后几步了。"
                                                                },
                                                                {
                                                                    "id": "220180533",
                                                                    "speaker": "珊瑚",
                                                                    "text": "等找到了足够的证据之后，还需要你再去大显身手，在那之前，你就好好休息吧。"
                                                                },
                                                                {
                                                                    "id": "220180534",
                                                                    "speaker": "珊瑚",
                                                                    "text": "这些东西给你，就当做是报酬了，收下吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220180530",
                                                            "text": "不可原谅…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220180516",
                                            "text": "这不就完全没思路了吗…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220180509",
                            "text": "犯人怎么能这么准确把握时间的？"
                        }
                    ]
                }
            ]
        },
