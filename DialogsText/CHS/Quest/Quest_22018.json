{
    "quest": {
        "id": "22018",
        "title": "万端珊瑚事件簿·合适的身份",
        "description": "万端珊瑚侦探社的珊瑚小姐，似乎对于手上的案件有了新的想法…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
