    "talks": [
        {
            "id": "7083301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "618010301",
                    "speaker": "洛恩",
                    "text": "呵…这下就天衣无缝了…"
                },
                {
                    "id": "618010302",
                    "speaker": "Player",
                    "text": "洛恩你这是在…写报告？"
                },
                {
                    "id": "618010303",
                    "speaker": "派蒙",
                    "text": "真意外，我还以为你会比法尔伽更讨厌这些文书工作…"
                },
                {
                    "id": "618010304",
                    "speaker": "洛恩",
                    "text": "怎么会呢，这也是一队之长应尽的责任啊，虽然我还只是副队长。"
                },
                {
                    "id": "618010305",
                    "speaker": "洛恩",
                    "text": "这份报告关系到远征军回归后的人事安排，还需要远征时主管行政的西蒙枢机卿过目。"
                },
                {
                    "id": "618010306",
                    "speaker": "洛恩",
                    "text": "对了，你要是刚好有空回蒙德城一趟，干脆顺手帮我捎过去？",
                    "choices": [
                        {
                            "id": "618010307",
                            "text": "可以倒是可以…",
                            "response": [
                                {
                                    "id": "618010309",
                                    "speaker": "洛恩",
                                    "text": "哈哈，就是因为很重要，所以才想托付给你嘛，「荣誉骑士」。"
                                }
                            ]
                        },
                        {
                            "id": "618010308",
                            "text": "但这不是很重要的文件吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7083302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "618010401",
                    "speaker": "西蒙·佩奇",
                    "text": "你好，荣誉骑士。今日造访，是为了什么事呢？"
                },
                {
                    "id": "618010402",
                    "speaker": "Player",
                    "text": "洛恩请我来送一份报告…"
                },
                {
                    "id": "618010403",
                    "speaker": "西蒙·佩奇",
                    "text": "洛恩？他居然会按时交报告？真是不可思议…我看一看…"
                },
                {
                    "id": "618010404",
                    "speaker": "西蒙·佩奇",
                    "text": "嗯…字迹很工整，措辞也很严谨…"
                },
                {
                    "id": "618010405",
                    "speaker": "Player",
                    "text": "那还有什么问题吗？"
                },
                {
                    "id": "618010406",
                    "speaker": "西蒙·佩奇",
                    "text": "没什么问题——除了一眼就知道不是洛恩自己写的。八成是找君特或者乌苏拉代笔的吧。"
                },
                {
                    "id": "618010407",
                    "speaker": "西蒙·佩奇",
                    "text": "不过这一次他好歹按时交了，看起来自己也检查过了…我就不多说什么了。"
                },
                {
                    "id": "618010408",
                    "speaker": "西蒙·佩奇",
                    "text": "希望法尔伽团长跟风神大人也都能宽恕他吧。"
                },
                {
                    "id": "618010409",
                    "speaker": "Player",
                    "text": "法尔伽跟风神啊…"
                },
                {
                    "id": "618010410",
                    "speaker": "派蒙",
                    "text": "…那多半是会宽恕的。"
                }
            ]
        }
    ]
}