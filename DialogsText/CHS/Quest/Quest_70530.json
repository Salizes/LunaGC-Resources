    "talks": [
        {
            "id": "7053001",
            "objective": "前往蒙德城侧门，寻找法斯宾",
            "dialogues": []
        },
        {
            "id": "7053002",
            "objective": "与法斯宾对话",
            "dialogues": [
                {
                    "id": "705300201",
                    "speaker": "法斯宾",
                    "text": "旅行者！旅行者，请留步！"
                },
                {
                    "id": "705300202",
                    "speaker": "Player",
                    "text": "你这里在举办什么活动？"
                },
                {
                    "id": "705300203",
                    "speaker": "法斯宾",
                    "text": "举办活动？不不不，我可没那个精力，也没那个能力。"
                },
                {
                    "id": "705300204",
                    "speaker": "法斯宾",
                    "text": "我就是对「留影」这件事很有兴趣，前段时间还托人弄了一台「留影机」回来，拍了好多画片。"
                },
                {
                    "id": "705300205",
                    "speaker": "法斯宾",
                    "text": "但协会里的人似乎还挺喜欢这种画片…塞琉斯先生说，可以把这些画片整理成册，以后当做纪念品送出去。"
                },
                {
                    "id": "705300206",
                    "speaker": "法斯宾",
                    "text": "最近正好是风花节，塞琉斯先生就让我去蒙德各处拍一些和风花节有关的画片回来。"
                },
                {
                    "id": "705300207",
                    "speaker": "法斯宾",
                    "text": "他想要整理一本风花节纪念画片集，送给协会里的各位冒险家。"
                },
                {
                    "id": "705300208",
                    "speaker": "法斯宾",
                    "text": "但是…蒙德虽然有很多可以拍的地方，但我只有一个人…"
                },
                {
                    "id": "705300209",
                    "speaker": "法斯宾",
                    "text": "协会里的冒险家们也都去忙自己的事了，没有空帮我。"
                },
                {
                    "id": "705300210",
                    "speaker": "法斯宾",
                    "text": "虽然在风花节期间拜托人帮忙很不应该啦…但是旅行者！我听说你很擅长摆弄「留影机」，请你帮帮我吧！",
                    "choices": [
                        {
                            "id": "705300211",
                            "text": "我确实略懂，略懂…",
                            "response": [
                                {
                                    "id": "705300212",
                                    "speaker": "法斯宾",
                                    "text": "呼…那就好那就好，还好我打听得没错…"
                                },
                                {
                                    "id": "705300216",
                                    "speaker": "法斯宾",
                                    "text": "咳，说正事…旅行者，那我就正式拜托你，帮我去蒙德各处用「留影机」拍画片了。"
                                },
                                {
                                    "id": "705300217",
                                    "speaker": "法斯宾",
                                    "text": "对了，你就用我的这台「留影机」去拍画片吧，我平时一直在维护它，用起来很顺手的。"
                                },
                                {
                                    "id": "705300218",
                                    "speaker": "法斯宾",
                                    "text": "想要拍出好画片，那首先就要有一台好「留影机」，你说对吧？"
                                },
                                {
                                    "id": "705300219",
                                    "speaker": "法斯宾",
                                    "text": "那就辛苦你了啊，只要和风花节有关，无论什么画片都行！"
                                },
                                {
                                    "id": "705300220",
                                    "speaker": "法斯宾",
                                    "text": "报酬什么的你也不用担心，我会按照协会里的规矩算给你，保证不让你白跑。"
                                },
                                {
                                    "id": "705300221",
                                    "speaker": "法斯宾",
                                    "text": "我得先在这里整理一下画片，先分个类…"
                                }
                            ]
                        },
                        {
                            "id": "705300213",
                            "text": "你是从哪听说的？",
                            "response": [
                                {
                                    "id": "705300214",
                                    "speaker": "法斯宾",
                                    "text": "我是听协会里的冒险家们说的。他们之中也有不少「留影机」爱好者。"
                                },
                                {
                                    "id": "705300215",
                                    "speaker": "法斯宾",
                                    "text": "我们还准备搞个「留影机」爱好协会呢，也不知道塞琉斯先生同不同意…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}