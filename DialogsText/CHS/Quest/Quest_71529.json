    "talks": [
        {
            "id": "7152901",
            "objective": "(test)斗虫二期-岚姐关卡$HIDDEN",
            "dialogues": [
                {
                    "id": "716665001",
                    "speaker": "荒泷一斗",
                    "text": "不讲道理…还有这种斗虫的方法？本大爷…本大爷的脸都被打肿了！"
                },
                {
                    "id": "716665002",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "受教了，感谢阁下。"
                },
                {
                    "id": "716665003",
                    "speaker": "荒泷一斗",
                    "text": "居然还这么客气！"
                },
                {
                    "id": "716665004",
                    "speaker": "派蒙",
                    "text": "嗯哼！放牛{RUBY#[D]「真剑斗虫大鬼王」}的！看来我们暂时不在的这段时间里，你还是输了嘛！"
                },
                {
                    "id": "716665005",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "并非如此，只要「真剑斗虫大鬼王」还没有放弃，他就不算输给了我。"
                },
                {
                    "id": "716665006",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "不论在战斗还是人生中，暂时落入下风的情况都很常见，只有连自己都放弃了，才算是真正的「败北」。"
                },
                {
                    "id": "716665007",
                    "speaker": "荒泷一斗",
                    "text": "这…说得好！本大爷确实还没有认输！"
                },
                {
                    "id": "716665008",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "但不必找各种各样的借口，花里胡哨的话也可以少说一点，有那个功夫，不如多给对方一刀。"
                },
                {
                    "id": "716665009",
                    "speaker": "荒泷一斗",
                    "text": "呃…"
                },
                {
                    "id": "716665010",
                    "speaker": "「花角玉将」",
                    "text": "鬼王，你似乎不擅长对付这类对手，不如换一位大将上阵，仔细观察双方角逐的细节。"
                },
                {
                    "id": "716665011",
                    "speaker": "「花角玉将」",
                    "text": "修行之中，用心观战也是必不可少的一环，同样能学习到新的技巧。"
                },
                {
                    "id": "716665012",
                    "speaker": "荒泷一斗",
                    "text": "有道理！正好我的挚友也来了！「鬼王的左膀右臂」，这次就由你出阵吧！"
                },
                {
                    "id": "716665013",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，终于到{NICKNAME}上场了，你可要好好表现一番!",
                    "choices": [
                        {
                            "id": "716665014",
                            "text": "哎吔！轻轻松松！",
                            "response": [
                                {
                                    "id": "716665016",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "#传奇冒险家{NICKNAME}居然也要参战吗？那我必须严阵以待了…"
                                }
                            ]
                        },
                        {
                            "id": "716665015",
                            "text": "呜哇！好怕好怕！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7152902",
            "objective": "(test)挑战岚姐$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7152903",
            "objective": "(test)成功挑战一次岚姐$HIDDEN",
            "dialogues": [
                {
                    "id": "716665101",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "漂亮，是我输了。"
                },
                {
                    "id": "716665102",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "#输给{NICKNAME}，未尝不是一种光荣。"
                },
                {
                    "id": "716665103",
                    "speaker": "荒泷一斗",
                    "text": "原来是用这种办法打赢的吗！"
                },
                {
                    "id": "716665104",
                    "speaker": "派蒙",
                    "text": "没错，面对灵活的敌人，还是要多多变通。"
                },
                {
                    "id": "716665105",
                    "speaker": "派蒙",
                    "text": "#一种战术行不通的时候，就要换个思路，我和{NICKNAME}在其他地方旅行的时候，常常灵活思考！"
                },
                {
                    "id": "716665106",
                    "speaker": "派蒙",
                    "text": "只盯着一种方法做事的话，再用力也解决不了问题！"
                },
                {
                    "id": "716665107",
                    "speaker": "荒泷一斗",
                    "text": "我记得，有时阿忍也说过差不多的话，这样看来还挺有道理的…"
                },
                {
                    "id": "716665108",
                    "speaker": "荒泷一斗",
                    "text": "不过还是以后再想吧，先考虑眼前的正事，斗虫要紧！"
                }
            ]
        }
    ]
}