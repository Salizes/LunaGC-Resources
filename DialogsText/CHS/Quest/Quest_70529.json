    "talks": [
        {
            "id": "7052901",
            "objective": "前往蒙德城侧门，寻找莉兹",
            "dialogues": []
        },
        {
            "id": "7052902",
            "objective": "与莉兹对话",
            "dialogues": [
                {
                    "id": "705290201",
                    "speaker": "莉兹",
                    "text": "您好！欢迎来到风花节，您来得可真是时候，我这里正在举办一项叫做「风物之歌」的小游戏。"
                },
                {
                    "id": "705290202",
                    "speaker": "莉兹",
                    "text": "在这项小游戏里，您能够像蒙德城里的吟游诗人一样，弹奏出动听的曲子…",
                    "choices": [
                        {
                            "id": "705290203",
                            "text": "能跟吟游诗人比吗…",
                            "response": [
                                {
                                    "id": "705290205",
                                    "speaker": "莉兹",
                                    "text": "放心吧！这项小游戏我可是…那个…找了很多人试玩过的！"
                                },
                                {
                                    "id": "705290206",
                                    "speaker": "莉兹",
                                    "text": "就算是最不会弹奏乐器的人，也至少能弹出一首…呃…至少不难听的曲子…"
                                },
                                {
                                    "id": "705290207",
                                    "speaker": "莉兹",
                                    "text": "相信我！相信西风骑士团！"
                                },
                                {
                                    "id": "705290208",
                                    "speaker": "莉兹",
                                    "text": "只要集中注意力跟上节拍和节奏，肯定能轻松弹奏出一首像样的旋律。"
                                },
                                {
                                    "id": "705290209",
                                    "speaker": "莉兹",
                                    "text": "在风中全神贯注地弹奏着优美动听的旋律…这样，您肯定能把烦心事都忘掉。"
                                },
                                {
                                    "id": "705290210",
                                    "speaker": "Player",
                                    "text": "那吟游诗人肯定最没烦心事。"
                                },
                                {
                                    "id": "705290211",
                                    "speaker": "莉兹",
                                    "text": "哈哈哈，那可不一定，毕竟他们会本能地担心，这首曲子是不是优美到让人愿意付钱呢。"
                                },
                                {
                                    "id": "705290212",
                                    "speaker": "莉兹",
                                    "text": "而您嘛…只需要弹得让自己开心就好。"
                                },
                                {
                                    "id": "705290213",
                                    "speaker": "莉兹",
                                    "text": "咳！我…我刚才啥都没说！您应该了解这个小游戏的玩法了吧？如果有兴趣的话，请您来试试看吧。"
                                },
                                {
                                    "id": "705290214",
                                    "speaker": "莉兹",
                                    "text": "您可以用自己的乐器来弹奏曲子，如果您没带乐器的话，我们这边也可以借您一些…"
                                },
                                {
                                    "id": "705290215",
                                    "speaker": "莉兹",
                                    "text": "嘿嘿…我们这里可是有很多乐器的，每一种乐器弹奏时的手感都不一样。"
                                },
                                {
                                    "id": "705290216",
                                    "speaker": "莉兹",
                                    "text": "您想先用哪一把乐器来弹奏呢？",
                                    "choices": [
                                        {
                                            "id": "705290217",
                                            "text": "风物之诗琴。",
                                            "response": [
                                                {
                                                    "id": "705290220",
                                                    "speaker": "莉兹",
                                                    "text": "用这把乐器啊，没问题！"
                                                },
                                                {
                                                    "id": "705290221",
                                                    "speaker": "莉兹",
                                                    "text": "对了！还有一件事，还有一件事！请您稍等一下，我看看笔记本…"
                                                },
                                                {
                                                    "id": "705290222",
                                                    "speaker": "莉兹",
                                                    "text": "嗯…那个…为了保证大家能顺利弹奏出好听的曲子，我们这次还特别设置了一个「调校乐器」的环节。"
                                                },
                                                {
                                                    "id": "705290223",
                                                    "speaker": "莉兹",
                                                    "text": "简单来说，就是帮您把乐器调整到最佳状态啦…很简单的，我看看啊，第一步是…"
                                                },
                                                {
                                                    "id": "705290224",
                                                    "speaker": "莉兹",
                                                    "text": "好！这样就可以了，乐器已经调整到最佳状态…乐谱也准备好了。"
                                                },
                                                {
                                                    "id": "705290225",
                                                    "speaker": "莉兹",
                                                    "text": "只要您愿意，随时都可以开始弹奏啦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705290218",
                                            "text": "镜花之琴。"
                                        },
                                        {
                                            "id": "705290219",
                                            "text": "绮筵之鼓。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705290204",
                            "text": "弹出来真的好听吗…"
                        }
                    ]
                }
            ]
        }
    ]
}