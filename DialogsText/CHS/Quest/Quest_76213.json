    "talks": [
        {
            "id": "7621302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762130101",
                    "speaker": "派蒙",
                    "text": "咦？这边的房间好像被书给堵住了…"
                },
                {
                    "id": "762130102",
                    "speaker": "丛沈",
                    "text": "寻书么？"
                },
                {
                    "id": "762130103",
                    "speaker": "派蒙",
                    "text": "嗯…倒也不是要找书啦，只是稍微有点好奇这里面是什么…"
                },
                {
                    "id": "762130104",
                    "speaker": "Player",
                    "text": "好像可以从旁边绕进去？"
                },
                {
                    "id": "762130105",
                    "speaker": "丛沈",
                    "text": "那便进不去了。"
                },
                {
                    "id": "762130106",
                    "speaker": "丛沈",
                    "text": "且移书，且移书。若不如是，则不曾到也。",
                    "choices": [
                        {
                            "id": "762130107",
                            "text": "听不懂…",
                            "response": [
                                {
                                    "id": "762130108",
                                    "speaker": "丛沈",
                                    "text": "且移书。"
                                }
                            ]
                        },
                        {
                            "id": "762130109",
                            "text": "如何是移书？",
                            "response": [
                                {
                                    "id": "762130110",
                                    "speaker": "丛沈",
                                    "text": "书不在便是移书。老僧只管看。"
                                },
                                {
                                    "id": "762130111",
                                    "speaker": "Player",
                                    "text": "那我用小右试试看。"
                                },
                                {
                                    "id": "762130112",
                                    "speaker": "丛沈",
                                    "text": "直去。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7621304",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7621302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762130201",
                    "speaker": "丛沈",
                    "text": "梦幻空花，何劳把捉？便是究理千年，一心不生，只是不会了。",
                    "choices": [
                        {
                            "id": "762130202",
                            "text": "所以…你是在找书吗？",
                            "response": [
                                {
                                    "id": "762130203",
                                    "speaker": "丛沈",
                                    "text": "你曾到过此地么？",
                                    "choices": [
                                        {
                                            "id": "762130204",
                                            "text": "啊？",
                                            "response": [
                                                {
                                                    "id": "762130207",
                                                    "speaker": "丛沈",
                                                    "text": "那你便会了。",
                                                    "choices": [
                                                        {
                                                            "id": "762130208",
                                                            "text": "会…会什么了？",
                                                            "response": [
                                                                {
                                                                    "id": "762130210",
                                                                    "speaker": "丛沈",
                                                                    "text": "要眠即眠，要会即会。"
                                                                },
                                                                {
                                                                    "id": "762130211",
                                                                    "speaker": "丛沈",
                                                                    "text": "你且归，世界坏时，归去就是。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "762130209",
                                                            "text": "如何是会？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "762130205",
                                            "text": "到过。"
                                        },
                                        {
                                            "id": "762130206",
                                            "text": "没到过。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "762130212",
                            "text": "完全听不懂，告辞。",
                            "response": [
                                {
                                    "id": "762130213",
                                    "speaker": "丛沈",
                                    "text": "直走。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}