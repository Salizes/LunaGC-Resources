        {
            "id": "7507609",
            "objective": "前往被涂鸦封印的中心",
            "dialogues": []
        },
        {
            "id": "7507610",
            "objective": "与深渊魔物化作的大灵显化身战斗",
            "dialogues": []
        },
        {
            "id": "7507612",
            "objective": "与大灵显化身对话",
            "dialogues": [
                {
                    "id": "750761201",
                    "speaker": "虚弱的大灵显化身",
                    "text": "啊，终于…异邦的勇士啊，若不是你相助，恐怕此处早已被漆黑的大敌占据…"
                },
                {
                    "id": "750761202",
                    "speaker": "虚弱的大灵显化身",
                    "text": "…许久之前，此处的部族住民受到漆黑大敌显化的造型的蛊惑，诸多夜魂亦被深渊纠缠。"
                },
                {
                    "id": "750761203",
                    "speaker": "虚弱的大灵显化身",
                    "text": "受封之处，即便是夜之化身的力量也被一点点蚕食…此处的封印隔绝了外界，也隔绝了部族之人信念的来源。"
                },
                {
                    "id": "750761204",
                    "speaker": "虚弱的大灵显化身",
                    "text": "唯有揭开封印，才有一战之力…"
                },
                {
                    "id": "750761205",
                    "speaker": "虚弱的大灵显化身",
                    "text": "多谢你啊，异邦的勇士…夜魂得以回归迷梦的故土，避免污秽的瘤瘿占据夜神的国度。"
                },
                {
                    "id": "750761206",
                    "speaker": "虚弱的大灵显化身",
                    "text": "啊，终于，可以回归夜的静谧之处了…"
                }
            ]
        },
