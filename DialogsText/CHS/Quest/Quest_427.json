    "talks": [
        {
            "id": "42709",
            "objective": "到达蒙德大教堂门前",
            "dialogues": []
        },
        {
            "id": "42701",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4270201",
                    "speaker": "安柏",
                    "text": "喂——我在这我在这。"
                },
                {
                    "id": "4270202",
                    "speaker": "安柏",
                    "text": "我已经布置好了，我们继续考试。"
                },
                {
                    "id": "4270203",
                    "speaker": "安柏",
                    "text": "还是和之前的考试形式一样，穿过标记，一口气飞到终点吧。"
                },
                {
                    "id": "4270204",
                    "speaker": "Player",
                    "text": "我准备好了。"
                }
            ]
        },
        {
            "id": "42702",
            "objective": "按指定路线限时飞抵终点",
            "dialogues": []
        },
        {
            "id": "42710",
            "objective": "(test)倒计时UI显示$HIDDEN",
            "dialogues": []
        },
        {
            "id": "42703",
            "objective": "在安柏的指导下重考",
            "dialogues": [
                {
                    "id": "4270303",
                    "speaker": "Player",
                    "text": "再来一次。"
                },
                {
                    "id": "4270304",
                    "speaker": "安柏",
                    "text": "嗯，控制住风之翼，让风带着你飞吧。"
                }
            ]
        },
        {
            "id": "42704",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4270401",
                    "speaker": "安柏",
                    "text": "看来你已经掌握了用风之翼飞行的诀窍，那么我们就开始最后一环吧。"
                },
                {
                    "id": "4270402",
                    "speaker": "派蒙",
                    "text": "毕竟这条路已经飞过一次了呢…"
                },
                {
                    "id": "4270403",
                    "speaker": "安柏",
                    "text": "那么，这是最后一项测试，通过了之后就可以等着飞行执照签发啦。"
                },
                {
                    "id": "4270404",
                    "speaker": "安柏",
                    "text": "朝着飞行执照，预备…"
                },
                {
                    "id": "4270405",
                    "speaker": "Player",
                    "text": "…开始！"
                }
            ]
        },
        {
            "id": "42705",
            "objective": "跟随标识，在规定时间内飞到终点",
            "dialogues": []
        },
        {
            "id": "42711",
            "objective": "(test)倒计时UI显示$HIDDEN",
            "dialogues": []
        },
        {
            "id": "42706",
            "objective": "按指定路线限时飞抵终点",
            "dialogues": [
                {
                    "id": "4270602",
                    "speaker": "Player",
                    "text": "我准备好了。"
                },
                {
                    "id": "4270603",
                    "speaker": "安柏",
                    "text": "加油，飞行执照近在眼前啦。"
                }
            ]
        },
        {
            "id": "42707",
            "objective": "到达冒险家协会门口",
            "dialogues": []
        },
        {
            "id": "42708",
            "objective": "接受西风骑士团检查",
            "dialogues": [
                {
                    "id": "4270801",
                    "speaker": "奥特",
                    "text": "您好，我是西风骑士团的骑士。"
                },
                {
                    "id": "4270802",
                    "speaker": "派蒙",
                    "text": "哇，发生什么了？！"
                },
                {
                    "id": "4270803",
                    "speaker": "奥特",
                    "text": "请出示一下您的飞行执照。",
                    "choices": [
                        {
                            "id": "4270804",
                            "text": "飞，飞行执照…",
                            "response": [
                                {
                                    "id": "4270806",
                                    "speaker": "奥特",
                                    "text": "无证非法飞行，依据蒙德城治安管理法第七条第十二款，请跟我走一趟！"
                                },
                                {
                                    "id": "4270807",
                                    "speaker": "奥特",
                                    "text": "你有权保持沉默，但是风会牢记你所说的每一句话。"
                                },
                                {
                                    "id": "4270808",
                                    "speaker": "安柏",
                                    "text": "等等！我们正在进行飞行执照考试。"
                                },
                                {
                                    "id": "4270809",
                                    "speaker": "奥特",
                                    "text": "啊，是这样吗…"
                                },
                                {
                                    "id": "4270810",
                                    "speaker": "奥特",
                                    "text": "但在这个时候进行飞行执照考试，真是不巧啊。"
                                },
                                {
                                    "id": "4270811",
                                    "speaker": "安柏",
                                    "text": "发生什么了吗？"
                                },
                                {
                                    "id": "4270812",
                                    "speaker": "奥特",
                                    "text": "骑士团刚收到教堂修女的报案，「怪鸟」又用风之翼逃走了，所以刚才我还以为你的考生是那家伙的同伙。"
                                },
                                {
                                    "id": "4270813",
                                    "speaker": "派蒙",
                                    "text": "怪鸟？那是什么？"
                                },
                                {
                                    "id": "4270814",
                                    "speaker": "奥特",
                                    "text": "是蒙德城里的一个惯犯。他总是用风之翼作案，所以得到了「怪鸟」这种外号。"
                                },
                                {
                                    "id": "4270815",
                                    "speaker": "安柏",
                                    "text": "唔，那家伙飞得很快吗？"
                                },
                                {
                                    "id": "4270816",
                                    "speaker": "奥特",
                                    "text": "目前…我们一次都没能追上过他，这一次本来是想用教堂里的文物做诱饵，把这家伙抓住的。"
                                },
                                {
                                    "id": "4270817",
                                    "speaker": "奥特",
                                    "text": "可是还是让他带着文物跑了。"
                                },
                                {
                                    "id": "4270818",
                                    "speaker": "奥特",
                                    "text": "不过，这次修女们已经提前用元素魔法在文物上做好标记了！"
                                },
                                {
                                    "id": "4270819",
                                    "speaker": "奥特",
                                    "text": "但那家伙飞行的速度太快了，跟着元素痕迹也追不上他。"
                                },
                                {
                                    "id": "4270820",
                                    "speaker": "安柏",
                                    "text": "居然是个飞行高手，那就摆明了非我安柏出马不可了——嗯，那家伙往哪边逃了？"
                                },
                                {
                                    "id": "4270821",
                                    "speaker": "奥特",
                                    "text": "据我所知，他最后出现的地点是清泉镇附近，但现在已经过去了这么长时间…"
                                },
                                {
                                    "id": "4270822",
                                    "speaker": "安柏",
                                    "text": "#就放心交给我吧，正好{NICKNAME}也在，我们一起追上去，把这只怪鸟抓捕归案吧。",
                                    "choices": [
                                        {
                                            "id": "4270823",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "4270825",
                                                    "speaker": "安柏",
                                                    "text": "别担心啦，等抓到怪鸟之后，我就直接…"
                                                },
                                                {
                                                    "id": "4270826",
                                                    "speaker": "安柏",
                                                    "text": "…去帮你向琴团长说明情况，咳。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4270824",
                                            "text": "那飞行执照的考试是不是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4270805",
                            "text": "被，被兔兔伯爵吃掉…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "42703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4270301",
                    "speaker": "安柏",
                    "text": "没有受伤吧！？"
                },
                {
                    "id": "4270302",
                    "speaker": "安柏",
                    "text": "好好准备之后，我们再来一次吧。"
                },
                {
                    "id": "4270305",
                    "speaker": "Player",
                    "text": "我再思考一下。"
                },
                {
                    "id": "4270306",
                    "speaker": "安柏",
                    "text": "嗯…起飞之前，一定要做好万全的准备。"
                }
            ]
        },
        {
            "id": "42706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4270601",
                    "speaker": "安柏",
                    "text": "不要心急啊，起飞的诀窍在于勇气，降落的要点却是冷静呢。"
                },
                {
                    "id": "4270604",
                    "speaker": "Player",
                    "text": "我再观察一下。"
                },
                {
                    "id": "4270605",
                    "speaker": "安柏",
                    "text": "要仔细观察喔，我就在这等你。"
                }
            ]
        }
    ]
}