    "talks": [
        {
            "id": "7213801",
            "objective": "与保本对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721380101",
                    "speaker": "保本",
                    "text": "哇啊！我…我不是什么可疑人士，只是本地的医师而已！"
                },
                {
                    "id": "721380102",
                    "speaker": "保本",
                    "text": "不信的话，我可以带你们去我的住处，你们缺什么直接拿走就好，请放过我！"
                },
                {
                    "id": "721380103",
                    "speaker": "保本",
                    "text": "或者带我去找你们的总大将九条大人！他认得我！",
                    "choices": [
                        {
                            "id": "721380104",
                            "text": "可能你误会了什么…",
                            "response": [
                                {
                                    "id": "721380106",
                                    "speaker": "保本",
                                    "text": "欸…？你们看起来不像是幕府军的人…也不像是珊瑚宫来的那群家伙。"
                                },
                                {
                                    "id": "721380107",
                                    "speaker": "保本",
                                    "text": "你们是…外国人？为什么会出现在这里？",
                                    "choices": [
                                        {
                                            "id": "721380108",
                                            "text": "这个嘛…",
                                            "response": [
                                                {
                                                    "id": "721380110",
                                                    "speaker": "保本",
                                                    "text": "唉…不管怎样，你们还是快点离开这里为妙。现在的八酝岛很危险。"
                                                },
                                                {
                                                    "id": "721380111",
                                                    "speaker": "保本",
                                                    "text": "到今天为止，「祟神」还没有消散的迹象，天领奉行也没有撤军的意思。"
                                                },
                                                {
                                                    "id": "721380112",
                                                    "speaker": "保本",
                                                    "text": "这座岛已经不再适宜居住了，更遑论观光。"
                                                },
                                                {
                                                    "id": "721380113",
                                                    "speaker": "保本",
                                                    "text": "如果你是为了逃避奉行方追捕而逃来的外国人，就再往西去吧。"
                                                },
                                                {
                                                    "id": "721380144",
                                                    "speaker": "保本",
                                                    "text": "天领奉行不欢迎来历不明的逃亡者，但海贼说不定会收留你。",
                                                    "choices": [
                                                        {
                                                            "id": "721380114",
                                                            "text": "岛上发生了什么？",
                                                            "response": [
                                                                {
                                                                    "id": "721380116",
                                                                    "speaker": "保本",
                                                                    "text": "哼…你自己看看吧。城里人和珊瑚宫的家伙们给我们带来了什么好事！"
                                                                },
                                                                {
                                                                    "id": "721380117",
                                                                    "speaker": "保本",
                                                                    "text": "先是踏鞴砂的爆炸，那天的夜空都被染上了奇怪的色彩…"
                                                                },
                                                                {
                                                                    "id": "721380140",
                                                                    "speaker": "保本",
                                                                    "text": "很多亲友没了工作、衣食无着，很多人回家时伤得很重、模样很悲惨。"
                                                                },
                                                                {
                                                                    "id": "721380141",
                                                                    "speaker": "保本",
                                                                    "text": "也有很多朋友…没能逃出来。"
                                                                },
                                                                {
                                                                    "id": "721380118",
                                                                    "speaker": "保本",
                                                                    "text": "然后，珊瑚宫的家伙破坏了镇压大蛇遗骨的镇物，「祟神」暴起，岛上人人死走逃亡。"
                                                                },
                                                                {
                                                                    "id": "721380119",
                                                                    "speaker": "保本",
                                                                    "text": "「祟神」带来的怪病也在不断蔓延，这里的居民大多病入膏肓。"
                                                                },
                                                                {
                                                                    "id": "721380142",
                                                                    "speaker": "保本",
                                                                    "text": "恐怕传入两军营地，也只不过是时间问题吧。"
                                                                },
                                                                {
                                                                    "id": "721380143",
                                                                    "speaker": "Player",
                                                                    "text": "这里是什么地方？"
                                                                },
                                                                {
                                                                    "id": "721380120",
                                                                    "speaker": "保本",
                                                                    "text": "这里原本是稻妻炼制「玉钢」所需的晶石的首要产地。只要矿石不枯竭，我们不必受城里的大人们太多制约，就能过得很好。"
                                                                },
                                                                {
                                                                    "id": "721380121",
                                                                    "speaker": "保本",
                                                                    "text": "现在呢？现在岛上已经没有几个活人了…我是说，像我这样，还能好好说话的「人」。"
                                                                },
                                                                {
                                                                    "id": "721380122",
                                                                    "speaker": "Player",
                                                                    "text": "为什么不离开？"
                                                                },
                                                                {
                                                                    "id": "721380123",
                                                                    "speaker": "保本",
                                                                    "text": "谁不愿意离开呢？天领奉行大人的公子也曾延请过我…他现在应该还在军中督战吧。"
                                                                },
                                                                {
                                                                    "id": "721380124",
                                                                    "speaker": "保本",
                                                                    "text": "「你有医术，与寻常百姓不同。留在岛上实是危险，不如来做我的军医。我可以直接将你保举给父亲大人。」"
                                                                },
                                                                {
                                                                    "id": "721380145",
                                                                    "speaker": "保本",
                                                                    "text": "他是这么说的。"
                                                                },
                                                                {
                                                                    "id": "721380125",
                                                                    "speaker": "保本",
                                                                    "text": "没打仗之前，给鸣神岛的奉行大人治病，是我这种乡村小医生想也不敢想的殊荣。"
                                                                },
                                                                {
                                                                    "id": "721380126",
                                                                    "speaker": "保本",
                                                                    "text": "但现在…你想想，奉行大人身边名医不会少，可八酝岛呢？这里的病人只有我一个医生可以依靠了。"
                                                                },
                                                                {
                                                                    "id": "721380127",
                                                                    "speaker": "保本",
                                                                    "text": "所以我不会离开，也不会专门给某一方的军士看病。我的敌人只有「祟神」。"
                                                                },
                                                                {
                                                                    "id": "721380128",
                                                                    "speaker": "Player",
                                                                    "text": "有什么可帮忙的吗？"
                                                                },
                                                                {
                                                                    "id": "721380129",
                                                                    "speaker": "保本",
                                                                    "text": "没什么…唔，算了，我确实需要帮助。"
                                                                },
                                                                {
                                                                    "id": "721380130",
                                                                    "speaker": "保本",
                                                                    "text": "我需要一些特殊的草药来调配药方，尝试治疗「祟神」引起的怪病。虽然不知道效果会如何…但试试总是好的。"
                                                                },
                                                                {
                                                                    "id": "721380131",
                                                                    "speaker": "保本",
                                                                    "text": "只不过…那些草药被「祟神」所沾染，又大多分布在危险的环境里。"
                                                                },
                                                                {
                                                                    "id": "721380146",
                                                                    "speaker": "保本",
                                                                    "text": "要么被天堑相隔、要么有怪物盘踞，而且这些地带「祟神」肆虐最严重…"
                                                                },
                                                                {
                                                                    "id": "721380132",
                                                                    "speaker": "保本",
                                                                    "text": "以我的胆量和能力，怕是很难应付得来。"
                                                                },
                                                                {
                                                                    "id": "721380133",
                                                                    "speaker": "保本",
                                                                    "text": "而且我作为医生，不敢冒着这么大的风险采集药材，便只能使用慢效的保守疗法…久久实验不出新的药方。"
                                                                },
                                                                {
                                                                    "id": "721380134",
                                                                    "speaker": "保本",
                                                                    "text": "外国人，我看你随身携带着「风之翼」，想必是经验丰富的旅行者了。这种程度的危险，应该很容易便能克服。"
                                                                },
                                                                {
                                                                    "id": "721380135",
                                                                    "speaker": "保本",
                                                                    "text": "所以，希望能辛苦你在这些地点帮我采到合适的药材。"
                                                                },
                                                                {
                                                                    "id": "721380136",
                                                                    "speaker": "保本",
                                                                    "text": "等采到之后，来这里与我会合。请不必担心报酬，我还有些积蓄。"
                                                                },
                                                                {
                                                                    "id": "721380137",
                                                                    "speaker": "保本",
                                                                    "text": "虽然只是素不相识之人的委托，希望您务必考虑一下。多谢了。"
                                                                },
                                                                {
                                                                    "id": "721380138",
                                                                    "speaker": "保本",
                                                                    "text": "顺便，希望你一路小心。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721380115",
                                                            "text": "你看起来很沮丧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721380109",
                                            "text": "说来话长。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721380105",
                            "text": "确实可疑…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7213802",
            "objective": "采集12支鸣草",
            "dialogues": [
                {
                    "id": "721380201",
                    "speaker": "保本",
                    "text": "啊，你来了。"
                },
                {
                    "id": "721380202",
                    "speaker": "保本",
                    "text": "请问你采到我所说的药材了吗？"
                }
            ]
        },
        {
            "id": "7213807",
            "objective": "和保本对话",
            "dialogues": [
                {
                    "id": "721380301",
                    "speaker": "保本",
                    "text": "没错，没错，茎叶没有损坏，而且还很新鲜…谢谢，非常感谢。"
                },
                {
                    "id": "721380302",
                    "speaker": "Player",
                    "text": "就是这些吧？"
                },
                {
                    "id": "721380303",
                    "speaker": "保本",
                    "text": "很好，这些足够了。新药方的研究可以开始进行了。"
                },
                {
                    "id": "721380304",
                    "speaker": "保本",
                    "text": "再次感谢你的努力，这里是之前答应你的报酬。希望不要嫌弃。"
                },
                {
                    "id": "721380305",
                    "speaker": "保本",
                    "text": "顺便，外国人…"
                },
                {
                    "id": "721380306",
                    "speaker": "保本",
                    "text": "啊，抱歉。麻烦了你这么多事，还不知怎么称呼？"
                },
                {
                    "id": "721380307",
                    "speaker": "Player",
                    "text": "#叫我{NICKNAME}就好。"
                },
                {
                    "id": "721380308",
                    "speaker": "保本",
                    "text": "#{NICKNAME}，如果你还有意帮忙的话，就请过一阵子再回来吧。"
                },
                {
                    "id": "721380309",
                    "speaker": "保本",
                    "text": "当然，报酬是不会少的，哈哈。"
                }
            ]
        },
        {
            "id": "7213803",
            "objective": "等待到翌日晚间18点—21点，与保本对话",
            "dialogues": []
        },
        {
            "id": "7213804",
            "objective": "和保本对话",
            "dialogues": [
                {
                    "id": "721380701",
                    "speaker": "保本",
                    "text": "唔呕…！咳咳…哈…哈…",
                    "choices": [
                        {
                            "id": "721380702",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "721380704",
                                    "speaker": "保本",
                                    "text": "唔…咳咳，口感偏苦发涩，舌头有点麻。局部的麻痹，应该是「祟神」的原因。"
                                },
                                {
                                    "id": "721380705",
                                    "speaker": "保本",
                                    "text": "很难喝。不过似乎无害。"
                                },
                                {
                                    "id": "721380706",
                                    "speaker": "保本",
                                    "text": "可能需要长期观察才能判断药物对身体的副作用影响，我不知道…欸？"
                                },
                                {
                                    "id": "721380707",
                                    "speaker": "保本",
                                    "text": "#它们…它们在往这边逼近！{NICKNAME}！快把它们赶走！"
                                }
                            ]
                        },
                        {
                            "id": "721380703",
                            "text": "看起来不太好喝…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7213805",
            "objective": "保护保本",
            "dialogues": [
                {
                    "id": "721380501",
                    "speaker": "保本",
                    "text": "呼…呼…心脏都要跳出来了，感谢你救了我一命，我是不会忘记的。"
                },
                {
                    "id": "721380502",
                    "speaker": "保本",
                    "text": "这种事情也算是正常现象，被「祟神」沾染的生物会不自觉地被散发着不祥气息的源头吸引。"
                },
                {
                    "id": "721380503",
                    "speaker": "保本",
                    "text": "因为药方中渗透了大量「祟神」的能量，把它们吸引来也是理所应当了。"
                },
                {
                    "id": "721380504",
                    "speaker": "保本",
                    "text": "唔…这样说，我大致明白应该如何改进调配方式了。"
                },
                {
                    "id": "721380505",
                    "speaker": "保本",
                    "text": "只不过上次的失败浪费了一部分新鲜药材，所以我还需要一些药材来继续进行制药试验。"
                },
                {
                    "id": "721380506",
                    "speaker": "保本",
                    "text": "#在接下来的旅途中，还望{NICKNAME}对岛上的药材多加注意，在早上放在屋子前的竹篮里就好。"
                },
                {
                    "id": "721380511",
                    "speaker": "保本",
                    "text": "报酬我会如数付清的，只不过恐怕要麻烦您稍等一阵。"
                },
                {
                    "id": "721380507",
                    "speaker": "保本",
                    "text": "#如果{NICKNAME}还有别的事要忙，也没有关系，或许我还能找到其他人帮忙采摘。",
                    "choices": [
                        {
                            "id": "721380508",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "721380510",
                                    "speaker": "保本",
                                    "text": "#那么再见了，旅行者{NICKNAME}。希望你在八酝岛的行程一路顺利。"
                                }
                            ]
                        },
                        {
                            "id": "721380509",
                            "text": "我会留意的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7213806",
            "objective": "和保本对话",
            "dialogues": []
        },
        {
            "id": "7213804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721380401",
                    "speaker": "保本",
                    "text": "#辛苦你了，{NICKNAME}。如果造成了困扰的话十分抱歉。",
                    "choices": [
                        {
                            "id": "721380402",
                            "text": "不会的。",
                            "response": [
                                {
                                    "id": "721380404",
                                    "speaker": "保本",
                                    "text": "我用你采到的药材调配了新的药方，只是没有试验药效的对象。"
                                },
                                {
                                    "id": "721380405",
                                    "speaker": "保本",
                                    "text": "#所以能否请{NICKNAME}…"
                                },
                                {
                                    "id": "721380406",
                                    "speaker": "Player",
                                    "text": "请直说。"
                                },
                                {
                                    "id": "721380407",
                                    "speaker": "保本",
                                    "text": "#能否请{NICKNAME}见证我服药的效果？"
                                },
                                {
                                    "id": "721380408",
                                    "speaker": "保本",
                                    "text": "新的药方性质还很不稳定，目前还没办法预测最坏的结果。"
                                },
                                {
                                    "id": "721380409",
                                    "speaker": "保本",
                                    "text": "所以我希望至少有人能够见证我的成功…或者替我处理失败的后果。"
                                },
                                {
                                    "id": "721380410",
                                    "speaker": "Player",
                                    "text": "好吧。"
                                }
                            ]
                        },
                        {
                            "id": "721380403",
                            "text": "哪里的话。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7213806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721380601",
                    "speaker": "保本",
                    "text": "非常感谢你的帮助，但在八酝岛请一定要小心…这里并非久留之地。"
                }
            ]
        }
    ]
}