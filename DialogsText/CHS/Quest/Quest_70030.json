        }
    },
    "talks": [
        {
            "id": "7003001",
            "objective": "前往璃月港口寻找大副重佐",
            "dialogues": [
                {
                    "id": "700300101",
                    "speaker": "重佐",
                    "text": "哟！旅行者，好久不见，别来无恙啊！"
                },
                {
                    "id": "700300102",
                    "speaker": "Player",
                    "text": "我们见过吗？"
                },
                {
                    "id": "700300103",
                    "speaker": "重佐",
                    "text": "啊…你…居然就这样把我忘了吗？"
                },
                {
                    "id": "700300104",
                    "speaker": "重佐",
                    "text": "我是「死兆星」号的大副重佐啊，你之前还搭我们「死兆星」号去的稻妻呢。"
                },
                {
                    "id": "700300105",
                    "speaker": "派蒙",
                    "text": "#没有没有，重佐大副，我们当然记得你啦，{NICKNAME}又在开玩笑了，哼哼。"
                },
                {
                    "id": "700300106",
                    "speaker": "重佐",
                    "text": "欸——我说呢！这才对嘛，毕竟我堂堂「死兆星」号的大副…"
                },
                {
                    "id": "700300107",
                    "speaker": "Player",
                    "text": "咳咳，有什么要帮忙吗？"
                },
                {
                    "id": "700300108",
                    "speaker": "重佐",
                    "text": "啊，其实不是我，是那位暂留在我们船队的万叶小兄弟。"
                },
                {
                    "id": "700300109",
                    "speaker": "重佐",
                    "text": "你应该有印象的吧？从稻妻返航的时候，他也跟着回来了。"
                },
                {
                    "id": "700300110",
                    "speaker": "重佐",
                    "text": "不知道怎么了，这一路上感觉他心情很不错，有事没事就拉着大家吟诗作歌。"
                },
                {
                    "id": "700300111",
                    "speaker": "重佐",
                    "text": "可惜我们船上，上到北斗大姐头、下到小月小丫头，哪找得出半个有这种…有这种…嗯…",
                    "choices": [
                        {
                            "id": "700300112",
                            "text": "雅兴！",
                            "response": [
                                {
                                    "id": "700300113",
                                    "speaker": "重佐",
                                    "text": "对！雅兴！哪找得出半个有这种雅兴的。"
                                },
                                {
                                    "id": "700300116",
                                    "speaker": "重佐",
                                    "text": "所以啊，刚到璃月，他就下船游山玩水去了，看来真是被我们这帮大老粗憋坏啰。"
                                },
                                {
                                    "id": "700300117",
                                    "speaker": "重佐",
                                    "text": "可他才走没多久，就传来讯息，拜托我们留意一下你的行踪。"
                                },
                                {
                                    "id": "700300118",
                                    "speaker": "Player",
                                    "text": "他遇到麻烦了吗？"
                                },
                                {
                                    "id": "700300119",
                                    "speaker": "重佐",
                                    "text": "具体什么情况倒没提，只说要是见到了你，就请你前去一叙。"
                                },
                                {
                                    "id": "700300120",
                                    "speaker": "重佐",
                                    "text": "听口气没那么要紧，但如果是小事，我想也用不着旅行者你出马吧？"
                                },
                                {
                                    "id": "700300121",
                                    "speaker": "派蒙",
                                    "text": "#其实我们也经常处理小事的，是吧，{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "700300122",
                                            "text": "嗯，经常喂鸽子什么的。",
                                            "response": [
                                                {
                                                    "id": "700300125",
                                                    "speaker": "重佐",
                                                    "text": "噢——真没想到，你还会帮大家做这些不起眼的活啊。"
                                                },
                                                {
                                                    "id": "700300126",
                                                    "speaker": "重佐",
                                                    "text": "怪不得大姐头那么欣赏你，看来你身上有着她所谓的「烟火气」吧？"
                                                },
                                                {
                                                    "id": "700300127",
                                                    "speaker": "重佐",
                                                    "text": "哎呀！闲话扯太多了，还是请你快去万叶小兄弟那里看看吧，他最近应该在璃月港北边那一带活动。"
                                                },
                                                {
                                                    "id": "700300128",
                                                    "speaker": "重佐",
                                                    "text": "我还要去忙船队的事，就不送你们了，路上多小心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700300123",
                                            "text": "嗯，经常替餐馆送餐什么的。"
                                        },
                                        {
                                            "id": "700300124",
                                            "text": "嗯，经常打扫卫生什么的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700300114",
                            "text": "怪癖！",
                            "response": [
                                {
                                    "id": "700300115",
                                    "speaker": "重佐",
                                    "text": "不不，应该叫雅兴！哪找得出半个有这种雅兴的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7003002",
            "objective": "与大副重佐对话",
            "dialogues": []
        },
        {
            "id": "7003003",
            "objective": "前往璃月港北侧一带寻找万叶",
            "dialogues": [
                {
                    "id": "700300301",
                    "speaker": "枫原万叶",
                    "text": "风儿都还没有带回你的消息，你就已经出现了。真是让我大开眼界，你是怎么做到的？"
                },
                {
                    "id": "700300302",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{NICKNAME}比你想象的还要厉害哦！"
                },
                {
                    "id": "700300303",
                    "speaker": "Player",
                    "text": "咳咳，这些够吗？"
                },
                {
                    "id": "700300304",
                    "speaker": "枫原万叶",
                    "text": "给我看看。"
                }
            ]
        },
        {
            "id": "7003004",
            "objective": "前往璃月港北侧一带寻找万叶",
            "dialogues": [
                {
                    "id": "700300201",
                    "speaker": "枫原万叶",
                    "text": "琴音嘒嘒，琴枕槁槁，独弦系世，独木终老…"
                },
                {
                    "id": "700300202",
                    "speaker": "派蒙",
                    "text": "哟！万叶小兄弟！你在这里呀？我们来帮忙啦！"
                },
                {
                    "id": "700300203",
                    "speaker": "枫原万叶",
                    "text": "哦？你们来了，好久不见。"
                },
                {
                    "id": "700300204",
                    "speaker": "枫原万叶",
                    "text": "「万叶小兄弟」这个称呼，从派蒙嘴里说出来，倒确实别有一番风味。"
                },
                {
                    "id": "700300205",
                    "speaker": "派蒙",
                    "text": "嘿嘿嘿，我和重佐大副学的。",
                    "choices": [
                        {
                            "id": "700300206",
                            "text": "你挺悠闲嘛。",
                            "response": [
                                {
                                    "id": "700300208",
                                    "speaker": "枫原万叶",
                                    "text": "哈哈，难道在你眼中，我是那种肩挑恶命、步履深沉之人吗？"
                                },
                                {
                                    "id": "700300209",
                                    "speaker": "派蒙",
                                    "text": "是重佐大副说你有事找我们啦，谁知道你这么悠哉，还在这看风景，还吟诗哦！"
                                },
                                {
                                    "id": "700300210",
                                    "speaker": "枫原万叶",
                                    "text": "稻妻事了，我已经心无他念。再访璃月，自然该广习此间诗赋，遍闻悬月妙音。"
                                },
                                {
                                    "id": "700300211",
                                    "speaker": "枫原万叶",
                                    "text": "至于请你们帮忙一事，原先是没有的，但可惜你们来迟了一步，所以现在有了。"
                                },
                                {
                                    "id": "700300212",
                                    "speaker": "派蒙",
                                    "text": "欸？好晕，「原先是没有的…所以现在又有了…」，什么嘛！"
                                },
                                {
                                    "id": "700300213",
                                    "speaker": "派蒙",
                                    "text": "你这家伙，是不是在山里吃了坏东西，怎么连话都说不明白了！"
                                },
                                {
                                    "id": "700300214",
                                    "speaker": "枫原万叶",
                                    "text": "嘘——二位请听。"
                                },
                                {
                                    "id": "700300215",
                                    "speaker": "枫原万叶",
                                    "text": "二位有什么感觉？"
                                },
                                {
                                    "id": "700300216",
                                    "speaker": "派蒙",
                                    "text": "呜哇，这琴声…要我说的话，好像跟卖唱的弹的差不多嘛。"
                                },
                                {
                                    "id": "700300217",
                                    "speaker": "枫原万叶",
                                    "text": "哦，卖唱的？希望有日能结识一番。旅行者，你觉得呢？",
                                    "choices": [
                                        {
                                            "id": "700300218",
                                            "text": "这琴坏了吧。",
                                            "response": [
                                                {
                                                    "id": "700300220",
                                                    "speaker": "枫原万叶",
                                                    "text": "不错，确实如此，不过更关键的是，它有一种奇妙的能力。"
                                                },
                                                {
                                                    "id": "700300221",
                                                    "speaker": "枫原万叶",
                                                    "text": "这把无名古琴，是我游览群山间，偶然在一座遗落洞府里得来的。"
                                                },
                                                {
                                                    "id": "700300222",
                                                    "speaker": "枫原万叶",
                                                    "text": "那时这琴虽老旧，但仍完好。我见猎心喜，不自觉便拨弄了一番。"
                                                },
                                                {
                                                    "id": "700300223",
                                                    "speaker": "枫原万叶",
                                                    "text": "没想到，琴声初起，我便一阵恍神，彷佛有人正与我合奏，那感觉，似曾相识..."
                                                },
                                                {
                                                    "id": "700300224",
                                                    "speaker": "派蒙",
                                                    "text": "让我想想，你真的没有吃到什么让人产生幻觉的东西吗?"
                                                },
                                                {
                                                    "id": "700300225",
                                                    "speaker": "枫原万叶",
                                                    "text": "大概是没有，因为一曲落下，我便醒过神来，这才仔细端看起那洞府，果然大有玄机。"
                                                },
                                                {
                                                    "id": "700300226",
                                                    "speaker": "枫原万叶",
                                                    "text": "那府内杂草横生，主人想必已经离去许久。可那一桌一椅皆纤毫不染，更有阵阵幽香扑鼻。"
                                                },
                                                {
                                                    "id": "700300227",
                                                    "speaker": "枫原万叶",
                                                    "text": "就连风中一直吵闹的杂音也在那偃息了。此等神异，我猜测，那就是璃月传说中的仙家宝地吧？"
                                                },
                                                {
                                                    "id": "700300228",
                                                    "speaker": "派蒙",
                                                    "text": "哇喔喔喔！所以这把琴是仙人留下来的宝物吗？！"
                                                },
                                                {
                                                    "id": "700300229",
                                                    "speaker": "枫原万叶",
                                                    "text": "哈哈，谁知道呢？那之后我又想，此等妙事，当然要跟朋友分享。"
                                                },
                                                {
                                                    "id": "700300230",
                                                    "speaker": "枫原万叶",
                                                    "text": "可我在璃月，除了大姐头外，就只有你一位朋友了。"
                                                },
                                                {
                                                    "id": "700300231",
                                                    "speaker": "枫原万叶",
                                                    "text": "大姐头对这种事情恐怕是毫无兴趣，我便想着，不如请你来体会一番。"
                                                },
                                                {
                                                    "id": "700300232",
                                                    "speaker": "枫原万叶",
                                                    "text": "于是便拜托了重佐大副，让他留意你的行踪。只可惜在你们来之前，这琴损坏了。"
                                                },
                                                {
                                                    "id": "700300233",
                                                    "speaker": "枫原万叶",
                                                    "text": "嗯，是我的过失，我拿着它游历各处，使用太频繁了。"
                                                },
                                                {
                                                    "id": "700300234",
                                                    "speaker": "派蒙",
                                                    "text": "啊，仙人的宝物也会坏吗？"
                                                },
                                                {
                                                    "id": "700300235",
                                                    "speaker": "枫原万叶",
                                                    "text": "连那位雷神大人都没办法握住永恒…就更别说其他事物了。"
                                                },
                                                {
                                                    "id": "700300236",
                                                    "speaker": "派蒙",
                                                    "text": "#呜呜，{NICKNAME}，你、你一定要保护好我们的尘歌壶！"
                                                },
                                                {
                                                    "id": "700300237",
                                                    "speaker": "枫原万叶",
                                                    "text": "不过好在，这种损坏是可以修复的，因为它更像是休眠，是琴中的能量随着时间流逝了。"
                                                },
                                                {
                                                    "id": "700300238",
                                                    "speaker": "枫原万叶",
                                                    "text": "所以只要找到正确的材料，就能唤醒它。"
                                                },
                                                {
                                                    "id": "700300239",
                                                    "speaker": "枫原万叶",
                                                    "text": "如果我没有听错的话，这种材料大概是...琉璃百合。"
                                                },
                                                {
                                                    "id": "700300240",
                                                    "speaker": "Player",
                                                    "text": "你怎么知道的？"
                                                },
                                                {
                                                    "id": "700300241",
                                                    "speaker": "枫原万叶",
                                                    "text": "我有说过吧，风会带着万物的呢喃在世间穿行，而我恰好能够听见其中几缕。"
                                                },
                                                {
                                                    "id": "700300242",
                                                    "speaker": "枫原万叶",
                                                    "text": "所以我知道了一些，关于这古琴往昔的只言片语。"
                                                },
                                                {
                                                    "id": "700300243",
                                                    "speaker": "枫原万叶",
                                                    "text": "去吧，我在这里等你。"
                                                },
                                                {
                                                    "id": "700300244",
                                                    "speaker": "枫原万叶",
                                                    "text": "你是璃月港的大英雄，这点小事应该不成问题吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700300219",
                                            "text": "这琴挺贵的吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700300207",
                            "text": "你挺不务正业嘛。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7003006",
            "objective": "寻找修复古琴所需的琉璃百合",
            "dialogues": []
        },
        {
            "id": "7003007",
            "objective": "将琉璃百合交给万叶",
            "dialogues": [
                {
                    "id": "700300401",
                    "speaker": "枫原万叶",
                    "text": "嗯，品质很好，这些就足够了，将它们捣成汁液，浸入琴身，应该就能让古琴回春了。"
                },
                {
                    "id": "700300402",
                    "speaker": "枫原万叶",
                    "text": "嗯——这熟悉的感觉。它醒了。"
                },
                {
                    "id": "700300403",
                    "speaker": "枫原万叶",
                    "text": "#来，{NICKNAME}，试试吧，它就交给你了。"
                },
                {
                    "id": "700300404",
                    "speaker": "Player",
                    "text": "交给我是什么意思？"
                },
                {
                    "id": "700300405",
                    "speaker": "枫原万叶",
                    "text": "哈哈，难道诗人不可以直抒胸臆吗？「交给你」的意思就是：这把琴，送你了。"
                },
                {
                    "id": "700300406",
                    "speaker": "枫原万叶",
                    "text": "再访璃月，我是来倾听这一方世界的。能在这片岩神守护的古老大地中，听见那些生生不息的低语，我很满足了。"
                },
                {
                    "id": "700300407",
                    "speaker": "枫原万叶",
                    "text": "当然，要是哪天这琴你不要了，我会来拿的。但...希望永远不要有那一天。"
                },
                {
                    "id": "700300408",
                    "speaker": "枫原万叶",
                    "text": "好了，我要继续上路了，这种时候璃月人会怎么说？啊，对了。"
                },
                {
                    "id": "700300409",
                    "speaker": "枫原万叶",
                    "text": "#{NICKNAME}，「后会有期」！"
                }
            ]
        },
        {
            "id": "7003008",
            "objective": "(test)【隐藏】对话刷破琴$HIDDEN",
            "dialogues": []
        },
