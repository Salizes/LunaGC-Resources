        }
    },
    "talks": [
        {
            "id": "7513101",
            "objective": "",
            "dialogues": [
                {
                    "id": "751310101",
                    "speaker": "马扎里",
                    "text": "生物火雨…难道，真如传说中那样，火山喷发会像活物一样肆意地进化和繁衍，把周边都同化成火山？完了完了，那可就危险了！",
                    "choices": [
                        {
                            "id": "751310102",
                            "text": "火山可不是那样形成的…",
                            "response": [
                                {
                                    "id": "751310104",
                                    "speaker": "马扎里",
                                    "text": "是了是了，没有熔岩哪里来的火山。火山是不可能随便出现的，要不然这里早就成了危险区域了…"
                                },
                                {
                                    "id": "751310105",
                                    "speaker": "马扎里",
                                    "text": "但、但要是万一传说是真的呢？嗯，要是那个能自动留影的留影机管用就好了…"
                                },
                                {
                                    "id": "751310106",
                                    "speaker": "马扎里",
                                    "text": "等等，万一留影机出了什么问题没拍到画片，岂不是糟糕了？不行不行，我得找个时间去看一眼才行…"
                                }
                            ]
                        },
                        {
                            "id": "751310103",
                            "text": "不好意思，打扰了。",
                            "response": [
                                {
                                    "id": "751310107",
                                    "speaker": "马扎里",
                                    "text": "再见…还是说，这其中另有隐情？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7513106",
            "objective": "",
            "dialogues": [
                {
                    "id": "751310301",
                    "speaker": "派蒙",
                    "text": "生、生物火雨！难道说火会像活物那样朝人的头顶飞过来吗？呜哇，纳塔的火山也太可怕了吧。"
                },
                {
                    "id": "751310302",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我有一点点好奇。嘿嘿，要不我们现在就去前面的区域探索一下吧？"
                }
            ]
        },
        {
            "id": "7513104",
            "objective": "",
            "dialogues": [
                {
                    "id": "751310601",
                    "speaker": "Black Screen",
                    "text": "你们将留影机检查了一番后发现，留影机内部不仅存有一组周边风景的画片，同时还装有一种特殊装置，这种装置似乎能使留影机在地面发生震动时自动进行留影。"
                }
            ]
        },
        {
            "id": "7513102",
            "objective": "",
            "dialogues": [
                {
                    "id": "751310401",
                    "speaker": "派蒙",
                    "text": "——唔，像是活物一样的火、诡异的残影、能自动留影的留影机…"
                },
                {
                    "id": "751310402",
                    "speaker": "派蒙",
                    "text": "我的直觉告诉我，这其中一定蕴含着某个复杂且难以解释的谜团的！说不定还跟宝藏相关！"
                },
                {
                    "id": "751310403",
                    "speaker": "Player",
                    "text": "派蒙看出什么了？"
                },
                {
                    "id": "751310404",
                    "speaker": "派蒙",
                    "text": "说实话…完全没有头绪！不过…留影机的主人把它放在这里，一定是为了拍到地面发生震动时的画片。"
                },
                {
                    "id": "751310405",
                    "speaker": "派蒙",
                    "text": "所以我们只需要把留影机复原，然后等待地面发生震动就好。"
                },
                {
                    "id": "751310406",
                    "speaker": "派蒙",
                    "text": "嘿嘿，我相信到那个时候，宝藏的线索就会像是那道残影一样，轰隆轰隆地钻出来啦！"
                }
            ]
        },
        {
            "id": "7513102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751310201",
                    "speaker": "马扎里",
                    "text": "原来生物火雨就是从天而降的浮燃鸟啊，怪不得范围比一般喷发要大呢…"
                },
                {
                    "id": "751310202",
                    "speaker": "马扎里",
                    "text": "糟了，假如它们哪天砸到了我家里怎么办？不行，必须得要想个办法。",
                    "choices": [
                        {
                            "id": "751310203",
                            "text": "只是特殊情况。",
                            "response": [
                                {
                                    "id": "751310204",
                                    "speaker": "马扎里",
                                    "text": "对啊，浮燃鸟只有靠着火山喷发才有可能飞到天上去，我家又不在火山喷发的范围里，应该不需要担心。"
                                },
                                {
                                    "id": "751310205",
                                    "speaker": "马扎里",
                                    "text": "但、但要是有一天，来一场史无前例的大喷发呢？那是不是就没有地方是安全的了？不行不行，还是要想个办法才是…"
                                }
                            ]
                        },
                        {
                            "id": "751310206",
                            "text": "不好意思，打扰了。",
                            "response": [
                                {
                                    "id": "751310207",
                                    "speaker": "马扎里",
                                    "text": "没事，不打扰…总而言之，先加固一下房顶吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}