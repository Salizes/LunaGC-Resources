    "talks": [
        {
            "id": "1080501",
            "objective": "",
            "dialogues": [
                {
                    "id": "698140101",
                    "speaker": "迪奥娜",
                    "text": "咻咻。",
                    "choices": [
                        {
                            "id": "698140102",
                            "text": "你在一个人打猎吗？",
                            "response": [
                                {
                                    "id": "698140104",
                                    "speaker": "迪奥娜",
                                    "text": "哼，「凯茨莱茵家族」的猎手，就算独自出行也能圆满完成狩猎任务。"
                                },
                                {
                                    "id": "698140105",
                                    "speaker": "Player",
                                    "text": "可「咻咻」地喊不会惊动猎物吗？"
                                },
                                {
                                    "id": "698140106",
                                    "speaker": "迪奥娜",
                                    "text": "不…才不会啦！你没看到我的箭飞得比声音更快吗？"
                                },
                                {
                                    "id": "698140107",
                                    "speaker": "Player",
                                    "text": "原来「咻咻」只是为了可爱啊…"
                                },
                                {
                                    "id": "698140108",
                                    "speaker": "迪奥娜",
                                    "text": "好过分，就算你说得那么小声我也听见了！不要小看「凯茨莱茵家族」的耳朵！"
                                },
                                {
                                    "id": "698140109",
                                    "speaker": "迪奥娜",
                                    "text": "算了，不跟你计较。喏，这些兽肉给你。我抓太多了，带回去也是要跟大家一起分享的。",
                                    "choices": [
                                        {
                                            "id": "698140110",
                                            "text": "那就多谢了。",
                                            "response": [
                                                {
                                                    "id": "698140112",
                                                    "speaker": "迪奥娜",
                                                    "text": "哼哼，知道就好。要是哪天镇上评选的话，你要记得投我一票噢？别投给我那笨蛋老爹啦。"
                                                },
                                                {
                                                    "id": "698140113",
                                                    "speaker": "不知何处传来的狼嚎",
                                                    "text": "嗷——"
                                                },
                                                {
                                                    "id": "698140114",
                                                    "speaker": "迪奥娜",
                                                    "text": "哎呀！",
                                                    "choices": [
                                                        {
                                                            "id": "698140115",
                                                            "text": "没想到凯茨莱茵家族的血统…",
                                                            "response": [
                                                                {
                                                                    "id": "698140117",
                                                                    "speaker": "迪奥娜",
                                                                    "text": "我，我才不是怕它们，你听见了吗？我根本不怕狼的。"
                                                                },
                                                                {
                                                                    "id": "698140118",
                                                                    "speaker": "迪奥娜",
                                                                    "text": "是因为起冲突的话解决起来会很麻烦！我不想分出自己好不容易抓到的猎物…"
                                                                },
                                                                {
                                                                    "id": "698140119",
                                                                    "speaker": "迪奥娜",
                                                                    "text": "喂，还愣着干吗啦？它们就快来了！总…总之，你也快点走呀！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698140116",
                                                            "text": "也会带来一小些麻烦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698140111",
                                            "text": "清泉镇最好的猎手。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698140103",
                            "text": "需要帮忙吗？"
                        }
                    ]
                }
            ]
        }
    ]
}