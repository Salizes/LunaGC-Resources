        {
            "id": "2503010",
            "objective": "为阿蕾梅示范「耐久力」训练",
            "dialogues": [
                {
                    "id": "250301001",
                    "speaker": "阿基约",
                    "text": "咳。咱们到了，这里是「耐久力」的训练场。"
                },
                {
                    "id": "250301002",
                    "speaker": "阿基约",
                    "text": "呃…这个场地还是咱们部族请「悬木人」那边的人过来，专门改造了一番。"
                },
                {
                    "id": "250301003",
                    "speaker": "阿基约",
                    "text": "简单来说，在这场训练中，无论你用什么方法，只要以尽可能快的速度到达终点就好！"
                },
                {
                    "id": "250301004",
                    "speaker": "阿基约",
                    "text": "#接下来！就请{NICKNAME}示范一下，如何快速到达终点吧。"
                }
            ]
        },
        {
            "id": "2503011",
            "objective": "迅速抵达目标点",
            "dialogues": [
                {
                    "id": "250301101",
                    "speaker": "Player",
                    "text": "今天训练一下「观察力」吧。"
                },
                {
                    "id": "250301102",
                    "speaker": "阿蕾梅",
                    "text": "我准备好啦！"
                },
                {
                    "id": "250301103",
                    "speaker": "阿基约",
                    "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
                }
            ]
        },
        {
            "id": "2503012",
            "objective": "向塔莫蕾回报",
            "dialogues": [
                {
                    "id": "250301201",
                    "speaker": "Black Screen",
                    "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…"
                },
                {
                    "id": "250301202",
                    "speaker": "阿基约",
                    "text": "你跑得也太快了，我们抄小路都没追上你。"
                },
                {
                    "id": "250301203",
                    "speaker": "塔莫蕾",
                    "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…"
                },
                {
                    "id": "250301204",
                    "speaker": "阿蕾梅",
                    "text": "我看明白了，可以开始跑了吗？我已经准备好了！"
                },
                {
                    "id": "250301205",
                    "speaker": "塔莫蕾",
                    "text": "等一下阿蕾梅，不要着急。等一下阿基约哥哥还要调整一下场地里的设施。让这个场地…更加适合你发挥。"
                },
                {
                    "id": "250301206",
                    "speaker": "阿基约",
                    "text": "在那之前，你就先在姐姐旁边，千万不要到处乱跑，也不要抢跑喔。"
                },
                {
                    "id": "250301207",
                    "speaker": "阿蕾梅",
                    "text": "我知道啦。我很听话的，绝对不抢跑。"
                },
                {
                    "id": "250301208",
                    "speaker": "塔莫蕾",
                    "text": "阿蕾梅真乖，来姐姐这边，姐姐给你把衣服整理一下，免得你跑到一半被衣服绊倒…"
                },
                {
                    "id": "250301209",
                    "speaker": "阿基约",
                    "text": "#呼…感谢你的协助，{NICKNAME}。要是没你帮忙，我们都不知道怎么办了…"
                },
                {
                    "id": "250301210",
                    "speaker": "Player",
                    "text": "你自己做示范就行了。"
                },
                {
                    "id": "250301211",
                    "speaker": "阿基约",
                    "text": "我？你就别开玩笑了。没了我的龙伙伴，就凭我的腿脚可跑不了多快。"
                },
                {
                    "id": "250301212",
                    "speaker": "阿基约",
                    "text": "唉，要是能再挖到点宝贝就好了。也不知道塔莫蕾小姐准备什么时候再次开展考古…"
                },
                {
                    "id": "250301213",
                    "speaker": "阿基约",
                    "text": "不对不对，要是考古完成，她就要回须弥了。这样的话…"
                },
                {
                    "id": "250301214",
                    "speaker": "阿基约",
                    "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。"
                },
                {
                    "id": "250301215",
                    "speaker": "阿基约",
                    "text": "好了，我得去布置场地了。呃…这次布什么好呢？"
                }
            ]
        },
        {
            "id": "2503001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250300101",
                    "speaker": "阿蕾梅",
                    "text": "塔莫蕾姐姐！我也想做考古学家！"
                },
                {
                    "id": "250300102",
                    "speaker": "塔莫蕾",
                    "text": "小阿蕾梅，考古学家可不是只用到处挖石头就行，要学习很多东西的喔。"
                },
                {
                    "id": "250300103",
                    "speaker": "阿蕾梅",
                    "text": "可是，考古学家可以和小龙一起玩！妈妈都不让我去找自己的龙！"
                },
                {
                    "id": "250300104",
                    "speaker": "阿基约",
                    "text": "阿蕾梅，你妈妈不是说过了吗？这件事要等你长大之后再说。"
                },
                {
                    "id": "250300105",
                    "speaker": "阿蕾梅",
                    "text": "我就在长大呀！塔莫蕾姐姐都说了，只有头脑的成长，才算是真正的成长。"
                },
                {
                    "id": "250300106",
                    "speaker": "阿蕾梅",
                    "text": "我找塔莫蕾姐姐学习知识，就是要快快长大。这是塔莫蕾姐姐亲口告诉我的！"
                },
                {
                    "id": "250300107",
                    "speaker": "塔莫蕾",
                    "text": "这确实…是我说的。哈哈哈…你这孩子还挺聪明的…"
                },
                {
                    "id": "250300108",
                    "speaker": "阿基约",
                    "text": "塔莫蕾小姐，这可怎么办…",
                    "choices": [
                        {
                            "id": "250300109",
                            "text": "你们在做什么呢？",
                            "response": [
                                {
                                    "id": "250300112",
                                    "speaker": "塔莫蕾",
                                    "text": "我们…咳，阿蕾梅，这确实是我亲口说的，而且姐姐也没有骗你。"
                                },
                                {
                                    "id": "250300113",
                                    "speaker": "塔莫蕾",
                                    "text": "但在你正式学习考古学家相关的课程之前，还要接受…那个…课前…课前培训。"
                                },
                                {
                                    "id": "250300114",
                                    "speaker": "塔莫蕾",
                                    "text": "#这位{M#大哥哥}{F#大姐姐}，就是我专门请来为你培训的…课程导师！"
                                },
                                {
                                    "id": "250300115",
                                    "speaker": "Player",
                                    "text": "#我是{NICKNAME}。"
                                },
                                {
                                    "id": "250300116",
                                    "speaker": "阿蕾梅",
                                    "text": "好欸！"
                                },
                                {
                                    "id": "250300117",
                                    "speaker": "塔莫蕾",
                                    "text": "…抱歉。总之拜托你先配合我一下，拜托拜托，我会给你准备好报酬的。",
                                    "choices": [
                                        {
                                            "id": "250300118",
                                            "text": "我可是很严厉的。",
                                            "response": [
                                                {
                                                    "id": "250300119",
                                                    "speaker": "阿蕾梅",
                                                    "text": "我不怕！我们「回声之子」都超坚强的！"
                                                },
                                                {
                                                    "id": "250300122",
                                                    "speaker": "塔莫蕾",
                                                    "text": "好，那咱们就先开始熟悉一下课程吧…阿基约，你先来介绍一下课程吧。"
                                                },
                                                {
                                                    "id": "250300123",
                                                    "speaker": "阿基约",
                                                    "text": "我，我来介绍？那个…阿蕾梅，你应该知道，部族里那些勇猛的战士们，都接受过有关「观察力」和「耐久力」的训练吧。"
                                                },
                                                {
                                                    "id": "250300124",
                                                    "speaker": "阿基约",
                                                    "text": "作为一名要时常涉足险地的考古学家，你也要具备这样的素质。"
                                                },
                                                {
                                                    "id": "250300125",
                                                    "speaker": "阿蕾梅",
                                                    "text": "我会努力的！"
                                                },
                                                {
                                                    "id": "250300126",
                                                    "speaker": "阿基约",
                                                    "text": "那么，就请你的课程导师判断一下，先进行什么课程的训练吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250300120",
                                            "text": "叫一声老师听听。",
                                            "response": [
                                                {
                                                    "id": "250300121",
                                                    "speaker": "阿蕾梅",
                                                    "text": "#{M#大哥哥}{F#大姐姐}老师好！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250300110",
                            "text": "我也想要成为考古学家！",
                            "response": [
                                {
                                    "id": "250300111",
                                    "speaker": "阿基约",
                                    "text": "这位朋友，你已经不用长大了。你看起来够成熟了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250300601",
                    "speaker": "阿基约",
                    "text": "大灵原谅，大灵原谅，我们也不是出于恶意…那些机关顶多是把人掀翻，绝对不会让人受到大伤…大灵原谅，大灵原谅…"
                }
            ]
        },
        {
            "id": "2503008",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250300801",
                    "speaker": "阿蕾梅",
                    "text": "我准备好了，阿基约哥哥！"
                },
                {
                    "id": "250300802",
                    "speaker": "阿基约",
                    "text": "你这丫头，还催起我来了…我马上就去调整场地，你别着急啊。"
                },
                {
                    "id": "250300803",
                    "speaker": "塔莫蕾",
                    "text": "你的身手还是那么高超啊…这么快就把埋着的那些机关挖出来了。"
                },
                {
                    "id": "250300804",
                    "speaker": "塔莫蕾",
                    "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。"
                },
                {
                    "id": "250300805",
                    "speaker": "塔莫蕾",
                    "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。",
                    "choices": [
                        {
                            "id": "250300806",
                            "text": "你不是都整理好资料了？",
                            "response": [
                                {
                                    "id": "250300807",
                                    "speaker": "塔莫蕾",
                                    "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。"
                                },
                                {
                                    "id": "250300808",
                                    "speaker": "塔莫蕾",
                                    "text": "我真没想到，阿蕾梅这孩子能看得下去。"
                                },
                                {
                                    "id": "250300812",
                                    "speaker": "塔莫蕾",
                                    "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。"
                                },
                                {
                                    "id": "250300813",
                                    "speaker": "塔莫蕾",
                                    "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。"
                                },
                                {
                                    "id": "250300814",
                                    "speaker": "塔莫蕾",
                                    "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
                                }
                            ]
                        },
                        {
                            "id": "250300809",
                            "text": "你要认真培养她吗？",
                            "response": [
                                {
                                    "id": "250300810",
                                    "speaker": "塔莫蕾",
                                    "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。"
                                },
                                {
                                    "id": "250300811",
                                    "speaker": "塔莫蕾",
                                    "text": "要是再往深了教，我肯定会误人子弟…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301301",
                    "speaker": "Player",
                    "text": "今天训练一下「耐久力」吧。"
                },
                {
                    "id": "250301302",
                    "speaker": "阿蕾梅",
                    "text": "我准备好啦！"
                },
                {
                    "id": "250301303",
                    "speaker": "阿基约",
                    "text": "状态很好嘛，阿蕾梅。那咱们现在就去训练场地吧。"
                }
            ]
        },
        {
            "id": "2503014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301401",
                    "speaker": "阿蕾梅",
                    "text": "塔莫蕾姐姐，我已经把上次你给我的那本书看完了，也做好了笔记，你看看。"
                },
                {
                    "id": "250301402",
                    "speaker": "塔莫蕾",
                    "text": "喔…哦，这笔记做得…真不错。"
                },
                {
                    "id": "250301403",
                    "speaker": "阿蕾梅",
                    "text": "嗯，因为塔莫蕾姐姐说，只有认真学习，才能做考古学家。"
                },
                {
                    "id": "250301404",
                    "speaker": "塔莫蕾",
                    "text": "…这样啊。"
                },
                {
                    "id": "250301405",
                    "speaker": "塔莫蕾",
                    "text": "阿蕾梅。姐姐相信，你肯定能成为最优秀的考古学家。"
                }
            ]
        },
        {
            "id": "2503015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301501",
                    "speaker": "阿基约",
                    "text": "和上次一样，这里的场地底下埋藏着不少机关。"
                },
                {
                    "id": "250301502",
                    "speaker": "阿基约",
                    "text": "考虑到阿蕾梅的实力已经很强了，所以…我稍微增加了一些难度，埋藏了更多的机关。"
                },
                {
                    "id": "250301503",
                    "speaker": "Player",
                    "text": "…你埋了新的机关？"
                },
                {
                    "id": "250301504",
                    "speaker": "阿基约",
                    "text": "…嘘，嘘！是上次的爆炸机关还没拆完啊…"
                },
                {
                    "id": "250301505",
                    "speaker": "阿基约",
                    "text": "#总之，{NICKNAME}，示范就交给你了。我相信那些机关肯定难不倒你。"
                }
            ]
        },
        {
            "id": "2503016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301601",
                    "speaker": "阿基约",
                    "text": "阿蕾梅这孩子…难道是认真的…"
                }
            ]
        },
        {
            "id": "2503017",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301701",
                    "speaker": "阿基约",
                    "text": "咱们到了，这里是「耐久力」的训练场。"
                },
                {
                    "id": "250301702",
                    "speaker": "阿基约",
                    "text": "和上次一样，无论你用什么方法，只要以尽可能快的速度到达终点就好！"
                },
                {
                    "id": "250301703",
                    "speaker": "阿基约",
                    "text": "#{NICKNAME}，示范就交给你了。让我们看看你的实力吧。"
                }
            ]
        },
        {
            "id": "2503018",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301801",
                    "speaker": "阿蕾梅",
                    "text": "跑步我最擅长了。我跑得可快了，有时候妈妈都追不上我呢。"
                },
                {
                    "id": "250301802",
                    "speaker": "塔莫蕾",
                    "text": "等一下，等一下阿蕾梅，我们还是先看完示范吧。做考古学家，耐心也是很重要的！"
                },
                {
                    "id": "250301803",
                    "speaker": "阿蕾梅",
                    "text": "喔…好吧，那等一下我要第一个开始跑！"
                }
            ]
        },
        {
            "id": "2503019",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250301901",
                    "speaker": "阿蕾梅",
                    "text": "塔莫蕾姐姐，你上次给我的那份笔记，我有些地方看不明白…"
                },
                {
                    "id": "250301902",
                    "speaker": "塔莫蕾",
                    "text": "我看看…欸？这，这里的问题…"
                },
                {
                    "id": "250301903",
                    "speaker": "阿蕾梅",
                    "text": "姐姐，你能详细讲给我听听吗？"
                },
                {
                    "id": "250301904",
                    "speaker": "塔莫蕾",
                    "text": "啊？哈哈哈…好啊，你稍等一下喔，我整理一下思路…"
                }
            ]
        },
        {
            "id": "2503020",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250302001",
                    "speaker": "阿基约",
                    "text": "大灵原谅，大灵原谅，我们也不是出于恶意…"
                }
            ]
        },
        {
            "id": "2503021",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250302101",
                    "speaker": "阿基约",
                    "text": "阿蕾梅这孩子…难道是认真的…"
                }
            ]
        },
        {
            "id": "2503022",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250302201",
                    "speaker": "Black Screen",
                    "text": "过了一会，塔莫蕾三人才从旁边的小路钻了出来…"
                },
                {
                    "id": "250302202",
                    "speaker": "阿蕾梅",
                    "text": "我觉得…可以直接跑，不用调整场地了，阿基约哥哥。"
                },
                {
                    "id": "250302203",
                    "speaker": "阿基约",
                    "text": "哎哟，你这丫头。别着急啊，路上那些枯枝石头都得收拾一下，你等一下被绊倒了怎么办？"
                },
                {
                    "id": "250302204",
                    "speaker": "塔莫蕾",
                    "text": "你的速度可真快，我看…无论怎么抄小路，我们都追不上你了。"
                },
                {
                    "id": "250302205",
                    "speaker": "塔莫蕾",
                    "text": "也许，就是因为有你这样厉害的榜样做示范，阿蕾梅才会这么有劲头训练吧。"
                },
                {
                    "id": "250302206",
                    "speaker": "塔莫蕾",
                    "text": "…看阿蕾梅这孩子的劲头。我也在想，也许她真的能做一个优秀的考古学家。",
                    "choices": [
                        {
                            "id": "250302207",
                            "text": "你不是都整理好资料了？",
                            "response": [
                                {
                                    "id": "250302208",
                                    "speaker": "塔莫蕾",
                                    "text": "那些啊。只是我的一些笔记和心得，还有一些乱七八糟的故事而已。"
                                },
                                {
                                    "id": "250302209",
                                    "speaker": "塔莫蕾",
                                    "text": "我真没想到，阿蕾梅这孩子能看得下去。"
                                },
                                {
                                    "id": "250302213",
                                    "speaker": "塔莫蕾",
                                    "text": "好了，这些报酬给你，请收下吧。等会我还要给阿蕾梅整理新一批资料。"
                                },
                                {
                                    "id": "250302214",
                                    "speaker": "塔莫蕾",
                                    "text": "在我离开纳塔前，会把一切能教的知识都教给阿蕾梅。"
                                },
                                {
                                    "id": "250302215",
                                    "speaker": "塔莫蕾",
                                    "text": "呵呵…希望未来的纳塔，真的会出现一颗考古学界的新星。"
                                }
                            ]
                        },
                        {
                            "id": "250302210",
                            "text": "你要认真培养她吗？",
                            "response": [
                                {
                                    "id": "250302211",
                                    "speaker": "塔莫蕾",
                                    "text": "「培养」这个词也太重了。就凭我的资质，最多给阿蕾梅做一个考古学启蒙。"
                                },
                                {
                                    "id": "250302212",
                                    "speaker": "塔莫蕾",
                                    "text": "要是再往深了教，我肯定会误人子弟…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
