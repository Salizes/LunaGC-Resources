    "talks": [
        {
            "id": "2503001",
            "objective": "听听阿蕾梅的话",
            "dialogues": [
                {
                    "id": "250300201",
                    "speaker": "Player",
                    "text": "先训练一下「观察力」。"
                },
                {
                    "id": "250300202",
                    "speaker": "阿基约",
                    "text": "没问题。那我们现在就出发去训练场地吧。"
                },
                {
                    "id": "250300203",
                    "speaker": "Player",
                    "text": "…真有训练场地？"
                },
                {
                    "id": "250300204",
                    "speaker": "阿基约",
                    "text": "…咳，你小声点，这可是我好不容易找到的地方。那个场地本来是我们部族用来训练的，这段时间正在维修。"
                },
                {
                    "id": "250300205",
                    "speaker": "阿基约",
                    "text": "虽然有些机关失去了作用…有些机关拆了一半…但那个场地作为训练场来说，绝对足够了…",
                    "choices": [
                        {
                            "id": "250300206",
                            "text": "真佩服你们的应变能力…",
                            "response": [
                                {
                                    "id": "250300208",
                                    "speaker": "阿基约",
                                    "text": "抱歉，抱歉…唉，这也是没办法的事啊。我好不容易才找到了这么一个相对安全的场地，但以我的实力，又没法做出漂亮的示范说服阿蕾梅…"
                                },
                                {
                                    "id": "250300209",
                                    "speaker": "阿基约",
                                    "text": "#我们就只能指望你了，{NICKNAME}！就算是为了阿蕾梅，也请你帮帮忙。"
                                },
                                {
                                    "id": "250300210",
                                    "speaker": "阿基约",
                                    "text": "要是不给这孩子一个准话，让她有点事情做，她说不定会一个人跑去部族外瞎鼓捣…"
                                },
                                {
                                    "id": "250300211",
                                    "speaker": "Player",
                                    "text": "行吧…"
                                },
                                {
                                    "id": "250300212",
                                    "speaker": "阿基约",
                                    "text": "谢谢你，呼…我总算是安心点了…"
                                },
                                {
                                    "id": "250300213",
                                    "speaker": "塔莫蕾",
                                    "text": "#好了！咱们快点出发吧。阿蕾梅，你等会可要好好看着{M#大哥哥}{F#大姐姐}的动作喔。"
                                },
                                {
                                    "id": "250300214",
                                    "speaker": "阿蕾梅",
                                    "text": "我知道了！"
                                },
                                {
                                    "id": "250300215",
                                    "speaker": "阿基约",
                                    "text": "…唉，居然对这么一个孩子撒谎。大灵可别怪罪我，我也是没办法啊…"
                                }
                            ]
                        },
                        {
                            "id": "250300207",
                            "text": "真亏你能想到这个主意…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503002",
            "objective": "(test)选择分支A$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2503003",
            "objective": "为阿蕾梅示范「观察力」训练",
            "dialogues": [
                {
                    "id": "250300301",
                    "speaker": "阿基约",
                    "text": "咳。咱们到了，这里是「观察力」训练场。"
                },
                {
                    "id": "250300302",
                    "speaker": "阿基约",
                    "text": "虽然看起来很平坦，但是地底下实际上埋藏着不少爆炸机关。"
                },
                {
                    "id": "250300303",
                    "speaker": "阿基约",
                    "text": "如果不经判断贸然前进，说不定就会踩爆机关，整个人都被掀倒在地。"
                },
                {
                    "id": "250300304",
                    "speaker": "阿基约",
                    "text": "一般来说，我们「回声之子」都会借助嵴锋龙伙伴的帮助，避开干扰机关，找到并挖掘出埋藏着的目标机关。"
                },
                {
                    "id": "250300305",
                    "speaker": "阿基约",
                    "text": "但是，作为一名考古学家，我们必须要考虑各种极端情况。"
                },
                {
                    "id": "250300306",
                    "speaker": "阿基约",
                    "text": "所以…在这次训练中，你只能依靠自己的观察力找到，并挖掘出埋藏着的目标机关。"
                },
                {
                    "id": "250300307",
                    "speaker": "阿基约",
                    "text": "#接下来！就请{NICKNAME}示范一下，如何以正确的方式挖掘出那些机关吧！"
                }
            ]
        },
        {
            "id": "2503004",
            "objective": "挖掘出埋藏着的目标机关",
            "dialogues": [
                {
                    "id": "250300401",
                    "speaker": "阿蕾梅",
                    "text": "塔莫蕾姐姐，你们考古学家，真的要学这么辛苦的课程吗？"
                },
                {
                    "id": "250300402",
                    "speaker": "塔莫蕾",
                    "text": "那是当然啦。这都不算什么，等你真正开始学习，才知道什么是真正辛苦的课程…"
                },
                {
                    "id": "250300403",
                    "speaker": "阿蕾梅",
                    "text": "喔…"
                }
            ]
        },
        {
            "id": "2503005",
            "objective": "向阿基约回报",
            "dialogues": [
                {
                    "id": "250300501",
                    "speaker": "塔莫蕾",
                    "text": "你的身手真不错啊…这么快就把埋着的那些机关挖出来了，而且…衣服看起来也很整洁，应该也没被爆炸机关掀翻多少次。"
                },
                {
                    "id": "250300502",
                    "speaker": "塔莫蕾",
                    "text": "谢天谢地，我们真是运气好，居然能遇见你这么厉害的人…"
                },
                {
                    "id": "250300503",
                    "speaker": "阿蕾梅",
                    "text": "好厉害！我也要试试，阿基约哥哥，也让我试试！"
                },
                {
                    "id": "250300504",
                    "speaker": "阿基约",
                    "text": "别急啊阿蕾梅，场地需要重新布置一下。等布置好了之后，我会陪着你一步步熟悉课程的。"
                },
                {
                    "id": "250300505",
                    "speaker": "阿基约",
                    "text": "但是，在布置好场地之前，你可要乖乖地留在塔莫蕾姐姐旁边，不能乱跑。"
                },
                {
                    "id": "250300506",
                    "speaker": "阿蕾梅",
                    "text": "我知道啦。我很听话的，绝对不乱跑。"
                },
                {
                    "id": "250300507",
                    "speaker": "塔莫蕾",
                    "text": "阿蕾梅真乖，来姐姐这边，姐姐给你先念一段和考古有关的文章，你可要听好了喔…"
                },
                {
                    "id": "250300508",
                    "speaker": "阿基约",
                    "text": "#呼…感谢你的协助，{NICKNAME}。要是没你帮忙，我们都不知道怎么办了…"
                },
                {
                    "id": "250300509",
                    "speaker": "Player",
                    "text": "你自己做示范就行了。"
                },
                {
                    "id": "250300510",
                    "speaker": "阿基约",
                    "text": "我？唉，你就别开玩笑了。要是我没能挖出来那些宝贝，只怕连塔莫蕾小姐的安全都没法保护好。"
                },
                {
                    "id": "250300511",
                    "speaker": "阿基约",
                    "text": "也不知道塔莫蕾小姐准备什么时候再次开展考古…不对不对，要是考古完成，她就要回须弥了，这样的话…"
                },
                {
                    "id": "250300512",
                    "speaker": "阿基约",
                    "text": "咳！我，我什么也没说啊。这些报酬是给你的，快收下快收下，别和我们客气。"
                },
                {
                    "id": "250300513",
                    "speaker": "阿基约",
                    "text": "好了，我得去布置场地了。呃…这次埋什么好呢？不然，埋点颗粒果好了…"
                }
            ]
        },
        {
            "id": "2503006",
            "objective": "为阿蕾梅示范「观察力」训练",
            "dialogues": []
        },
        {
            "id": "2503007",
            "objective": "挖掘出埋藏着的目标机关",
            "dialogues": [
                {
                    "id": "250300701",
                    "speaker": "阿蕾梅",
                    "text": "塔莫蕾姐姐，我训练得怎么样？可以做考古学家了吗？"
                },
                {
                    "id": "250300702",
                    "speaker": "塔莫蕾",
                    "text": "嗯，阿蕾梅训练得很好，只要再巩固一下，姐姐就可以开始教你正式的课程的。"
                },
                {
                    "id": "250300703",
                    "speaker": "阿基约",
                    "text": "你的塔莫蕾姐姐可是专门为你整理了一遍资料，等训练结束后，要好好学习喔。"
                },
                {
                    "id": "250300704",
                    "speaker": "塔莫蕾",
                    "text": "#{NICKNAME}，你来得正好。阿蕾梅，准备和{M#大哥哥}{F#大姐姐}去训练吧。"
                }
            ]
        },
        {
            "id": "2503008",
            "objective": "向阿基约回报",
