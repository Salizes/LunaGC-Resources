    },
    "talks": [
        {
            "id": "7267902",
            "objective": "",
            "dialogues": [
                {
                    "id": "726780501",
                    "speaker": "派蒙",
                    "text": "终于上来了！"
                },
                {
                    "id": "726780502",
                    "speaker": "派蒙",
                    "text": "这里的视线，比下面好多了。你看，那边就是我们来的地方。"
                },
                {
                    "id": "726780503",
                    "speaker": "「吉法师」",
                    "text": "派蒙很喜欢高的地方？",
                    "choices": [
                        {
                            "id": "726780504",
                            "text": "在高的地方视野很好，滑翔也方便。",
                            "response": [
                                {
                                    "id": "726780507",
                                    "speaker": "「吉法师」",
                                    "text": "风风龙睡在这个塔里面吗？"
                                },
                                {
                                    "id": "726780508",
                                    "speaker": "派蒙",
                                    "text": "嗯，在里面睡了好久好久。"
                                },
                                {
                                    "id": "726780509",
                                    "speaker": "派蒙",
                                    "text": "#虽然{NICKNAME}和「风魔龙」战斗，但是它不是坏龙。"
                                },
                                {
                                    "id": "726780510",
                                    "speaker": "派蒙",
                                    "text": "只是遇到了难过的事情，受了伤害，又被坏人骗了，所以以为，风神朋友不要它了。"
                                },
                                {
                                    "id": "726780511",
                                    "speaker": "「吉法师」",
                                    "text": "呶…后来呢？"
                                },
                                {
                                    "id": "726780512",
                                    "speaker": "派蒙",
                                    "text": "#后来呀…{NICKNAME}，你还记得吗？"
                                },
                                {
                                    "id": "726780513",
                                    "speaker": "Player",
                                    "text": "我们在战斗中，净化了「毒血」。"
                                },
                                {
                                    "id": "726780514",
                                    "speaker": "派蒙",
                                    "text": "但是，战斗的平台也坍塌了。本来，我们，还有风神都要掉到好深好深、好黑好黑的地方去…"
                                },
                                {
                                    "id": "726780515",
                                    "speaker": "「吉法师」",
                                    "text": "#呶！好可怕…那么，派蒙和{NICKNAME}怎么办？飞出来？",
                                    "choices": [
                                        {
                                            "id": "726780516",
                                            "text": "特瓦林救了我们。载着我们飞走了。",
                                            "response": [
                                                {
                                                    "id": "726780517",
                                                    "speaker": "「吉法师」",
                                                    "text": "特…？"
                                                },
                                                {
                                                    "id": "726780518",
                                                    "speaker": "派蒙",
                                                    "text": "就是「风魔龙」啦。"
                                                },
                                                {
                                                    "id": "726780520",
                                                    "speaker": "派蒙",
                                                    "text": "#「风魔龙」是有自己的名字的喔，就像吉法师、派蒙和{NICKNAME}一样。它叫特瓦林。"
                                                },
                                                {
                                                    "id": "726780521",
                                                    "speaker": "派蒙",
                                                    "text": "开始，特瓦林受了伤害、又被坏人骗了，非常非常生气，还到蒙德城去大闹了一场。大家都觉得它是坏龙，所以叫它「风魔龙」。"
                                                },
                                                {
                                                    "id": "726780522",
                                                    "speaker": "派蒙",
                                                    "text": "后来，我们打倒了坏人，又和风神一起净化了污染它的毒血，它才知道，风神其实没有抛弃它。"
                                                },
                                                {
                                                    "id": "726780523",
                                                    "speaker": "「吉法师」",
                                                    "text": "喔！特…风风龙就变好了。"
                                                },
                                                {
                                                    "id": "726780524",
                                                    "speaker": "派蒙",
                                                    "text": "没错！所以说呀…派蒙今天带吉法师到这里来修行，就是想告诉吉法师特瓦林的故事。"
                                                },
                                                {
                                                    "id": "726780525",
                                                    "speaker": "派蒙",
                                                    "text": "吉法师长大以后，也会遇到误解、遇到伤害、遇到难过的事情。"
                                                },
                                                {
                                                    "id": "726780526",
                                                    "speaker": "派蒙",
                                                    "text": "但是，也一定不能变成坏人。因为，「风向是会转变的」…"
                                                },
                                                {
                                                    "id": "726780527",
                                                    "speaker": "Player",
                                                    "text": "总有一天，会吹向更光明的方向。"
                                                },
                                                {
                                                    "id": "726780528",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶？"
                                                },
                                                {
                                                    "id": "726780529",
                                                    "speaker": "Player",
                                                    "text": "对吉法师来说，会不会太难懂？"
                                                },
                                                {
                                                    "id": "726780530",
                                                    "speaker": "「吉法师」",
                                                    "text": "好像懂了，但又不太懂呶…"
                                                },
                                                {
                                                    "id": "726780531",
                                                    "speaker": "「吉法师」",
                                                    "text": "#不过，吉法师知道是很重要的事情。派蒙和{NICKNAME}说的事情，不会忘记的。"
                                                },
                                                {
                                                    "id": "726780532",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！那就没辜负我花了好长好长时间想的故事！"
                                                },
                                                {
                                                    "id": "726780533",
                                                    "speaker": "派蒙",
                                                    "text": "不过，吉法师也不要太贪玩、太调皮，被人封印起来喔。",
                                                    "choices": [
                                                        {
                                                            "id": "726780534",
                                                            "text": "吉法师这次的修行也告一段落了。",
                                                            "response": [
                                                                {
                                                                    "id": "726780536",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "呜呶呶…"
                                                                },
                                                                {
                                                                    "id": "726780537",
                                                                    "speaker": "派蒙",
                                                                    "text": "别这么难过嘛！要笑着回去，这样五百藏才会高兴！"
                                                                },
                                                                {
                                                                    "id": "726780538",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好啦，派蒙和{NICKNAME}也要完成好向导最后的职责啦…"
                                                                },
                                                                {
                                                                    "id": "726780539",
                                                                    "speaker": "派蒙",
                                                                    "text": "那就是，把吉法师送回五百藏身边。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "726780540",
                                                                            "text": "我们走吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "726780542",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "呶。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "726780541",
                                                                            "text": "我们走吧，吉法师。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726780535",
                                                            "text": "五百藏的委托也算是完成了吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726780519",
                                            "text": "风魔龙救了我们。载着我们飞走了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726780505",
                            "text": "「笨蛋和烟…」",
                            "response": [
                                {
                                    "id": "726780506",
                                    "speaker": "派蒙",
                                    "text": "喂！才不是这么回事啦。在高的地方，视野很好，而且空气也比较清新。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267598",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726759801",
                    "speaker": "五百藏",
                    "text": "呶，是你啊。不得不说，你还挺有本领的，还有那种「楼影鸡」。可惜不是狸子，不然，应该能成为了不起的大妖狸。"
                },
                {
                    "id": "726759802",
                    "speaker": "五百藏",
                    "text": "不过，可能只有吾辈一半厉害吧。",
                    "choices": [
                        {
                            "id": "726759803",
                            "text": "关于气味…",
                            "response": [
                                {
                                    "id": "726759804",
                                    "speaker": "五百藏",
                                    "text": "你们第一次来的时候，也是吃了什么人给你们做的妖狸饭菜对吧。"
                                },
                                {
                                    "id": "726759805",
                                    "speaker": "五百藏",
                                    "text": "吾等妖狸一族擅长变化，什么都能变成。吾辈以前和那个臭狐狸斗法，曾经变成了整个花见坂。不过，最后还是被识破了就是。"
                                },
                                {
                                    "id": "726759806",
                                    "speaker": "五百藏",
                                    "text": "这件事，当时的人称为「伪花见坂事件」，还写成了叫《隐神大囃子》的话本，应该很有名才对…现在的人，都不知道了吗？"
                                },
                                {
                                    "id": "726759807",
                                    "speaker": "五百藏",
                                    "text": "总之，因为吾等太擅长变化，所以就要用「气息」来分辨同族。不然的话，可能就会弄错。"
                                },
                                {
                                    "id": "726759808",
                                    "speaker": "五百藏",
                                    "text": "所以，给你们这些小辈做饭的人，不是那个臭狐狸的话，到底是谁？这么熟悉吾等妖狸的气味，还会法术的，应该没几个才对…"
                                }
                            ]
                        },
                        {
                            "id": "726759809",
                            "text": "关于修行…",
                            "response": [
                                {
                                    "id": "726759810",
                                    "speaker": "五百藏",
                                    "text": "吾辈还在吉法师这个年纪的时候，曾经游历过去的大妖狸「九百九」的十八所名迹，也就是以前他曾经展现妖狸法力的地方。"
                                },
                                {
                                    "id": "726759811",
                                    "speaker": "五百藏",
                                    "text": "比如说，传说他曾经在影向参道上变成山鉾队伍，一路乘歌载舞地上山。还把自己变成了大御所大人，哎呀，真是精彩。"
                                },
                                {
                                    "id": "726759812",
                                    "speaker": "五百藏",
                                    "text": "其他的名所…在好远好远的海祇曚云神社，九百九曾经变成古代的大将恶王，说要让叫什么名字来着的巫女出来见他，到处大闹。"
                                },
                                {
                                    "id": "726759813",
                                    "speaker": "五百藏",
                                    "text": "总之，小狸子不能偏离狸道，要好好修行，才能成为独当一面的大妖狸。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}