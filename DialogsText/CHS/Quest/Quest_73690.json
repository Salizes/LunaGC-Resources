    },
    "talks": [
        {
            "id": "7369001",
            "objective": "与达雅对话",
            "dialogues": [
                {
                    "id": "736900101",
                    "speaker": "达雅",
                    "text": "你好，我是刹诃伐罗学院的达雅！你也是来参加学院游乐会的吗？"
                },
                {
                    "id": "736900102",
                    "speaker": "达雅",
                    "text": "这是我们学院推出的游玩项目：「通路计划」！"
                },
                {
                    "id": "736900103",
                    "speaker": "达雅",
                    "text": "怎么样？要不要试着玩一玩呀？"
                },
                {
                    "id": "736900104",
                    "speaker": "Player",
                    "text": "我记得刹诃伐罗学院是研究…"
                },
                {
                    "id": "736900105",
                    "speaker": "达雅",
                    "text": "我们学院的研究很多都与机关和建筑有关。"
                },
                {
                    "id": "736900107",
                    "speaker": "达雅",
                    "text": "咳，说远了…为了参与这次学院游乐会，我们学院里的很多学生群策群力…"
                },
                {
                    "id": "736900108",
                    "speaker": "达雅",
                    "text": "最终，研究出了「通路计划」这个游玩项目！"
                },
                {
                    "id": "736900109",
                    "speaker": "达雅",
                    "text": "简单来说，游玩者需要用我们已经准备好的各种物件搭建道路。"
                },
                {
                    "id": "736900110",
                    "speaker": "达雅",
                    "text": "无论是架桥啦，铺梯啦…最终的目标，就是搭建出一条可以供人通行，并且直达终点的道路。"
                },
                {
                    "id": "736900111",
                    "speaker": "达雅",
                    "text": "在搭建完毕后，我们还会进行一次最终检验…就像是验收搭建好的建筑一样。"
                },
                {
                    "id": "736900112",
                    "speaker": "达雅",
                    "text": "总之，只要能搭建出一条安全的道路，就算是获胜啦。",
                    "choices": [
                        {
                            "id": "736900113",
                            "text": "听上去很复杂…",
                            "response": [
                                {
                                    "id": "736900115",
                                    "speaker": "达雅",
                                    "text": "哈哈哈，不用担心，这又不是在现实里建设建筑。"
                                },
                                {
                                    "id": "736900116",
                                    "speaker": "达雅",
                                    "text": "就算是搭建失误，道路垮塌了也没关系，只要重新搭建就好，我们也不会限定尝试次数的。"
                                },
                                {
                                    "id": "736900117",
                                    "speaker": "达雅",
                                    "text": "只要发挥想象力，搭出一条漂亮的道路就好啦！",
                                    "choices": [
                                        {
                                            "id": "736900118",
                                            "text": "我想试试看。",
                                            "response": [
                                                {
                                                    "id": "736900119",
                                                    "speaker": "达雅",
                                                    "text": "没问题，那么就请看向这边…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736900120",
                                            "text": "还有别的事。",
                                            "response": [
                                                {
                                                    "id": "736900121",
                                                    "speaker": "达雅",
                                                    "text": "这样啊…没关系，我们的摊位在学院游乐会期间会一直开设。"
                                                },
                                                {
                                                    "id": "736900122",
                                                    "speaker": "达雅",
                                                    "text": "不管什么时候，只要你想试玩，直接过来就好。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736900114",
                            "text": "我没什么建筑天赋…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7369099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "736909901",
                    "speaker": "达雅",
                    "text": "（要是在现实里搞建筑也能这么轻松就好了，唉…）"
                }
            ]
        }
    ]
}