        {
            "id": "1907850",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190785001",
                    "speaker": "乌宰尔",
                    "text": "卡维老师看起来很生气。"
                },
                {
                    "id": "190785002",
                    "speaker": "瓦伊兹",
                    "text": "管他呢。说不定他是担心，我们将来会抢了他的饭碗！"
                },
                {
                    "id": "190785003",
                    "speaker": "塔尼莎",
                    "text": "这…应该不至于吧？卡维老师那么有名…"
                },
                {
                    "id": "190785004",
                    "speaker": "瓦伊兹",
                    "text": "谁知道呢？我爹说了，越有名的人越喜欢摆架子，像阿尔卡米老师那样的才是少数。"
                }
            ]
        },
        {
            "id": "1907851",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190785101",
                    "speaker": "纳比尔",
                    "text": "你好，这里已经被查封，正在对相关人员调查中。"
                },
                {
                    "id": "190785102",
                    "speaker": "纳比尔",
                    "text": "有什么事，请明天再来吧。"
                }
            ]
        },
        {
            "id": "1907852",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190785201",
                    "speaker": "公告牌",
                    "text": "经调查，培训机构负责人阿尔卡米教唆学生家长背负高利贷，以此谋取暴利。"
                },
                {
                    "id": "190785202",
                    "speaker": "公告牌",
                    "text": "培训机构已封禁，相关赃款会在核实后予以退回。"
                }
            ]
        },
