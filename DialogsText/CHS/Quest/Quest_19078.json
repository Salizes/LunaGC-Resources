        {
            "id": "1907803",
            "objective": "前往教育机构所在地",
            "dialogues": []
        },
        {
            "id": "1907804",
            "objective": "在附近打听阿尔卡米",
            "dialogues": [
                {
                    "id": "190780401",
                    "speaker": "阿丹",
                    "text": "你好，找我有什么事吗？",
                    "choices": [
                        {
                            "id": "190780402",
                            "text": "你认识阿尔卡米吗？",
                            "response": [
                                {
                                    "id": "190780404",
                                    "speaker": "阿丹",
                                    "text": "你说阿尔卡米？是最近很出名的那个有钱人吧？他之前找我定制家具，出手相当阔绰。"
                                },
                                {
                                    "id": "190780405",
                                    "speaker": "阿丹",
                                    "text": "听说他以前是知名建筑师，攒下了富裕的家产。现在开设了培训机构，向大家分享自己的致富之路。"
                                },
                                {
                                    "id": "190780406",
                                    "speaker": "阿丹",
                                    "text": "如果不是学费太贵，我也想给我的孩子报个名。做建筑师真赚钱啊…"
                                }
                            ]
                        },
                        {
                            "id": "190780403",
                            "text": "想打听一下阿尔卡米。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1907808",
            "objective": "在附近打听阿尔卡米",
            "dialogues": [
                {
                    "id": "190780801",
                    "speaker": "阿比德",
                    "text": "听说了吗？阿尔卡米找来了卡维当培训班的老师。"
                },
                {
                    "id": "190780802",
                    "speaker": "阿迪勒",
                    "text": "嘿，这下他的生意肯定更好了吧？"
                },
                {
                    "id": "190780803",
                    "speaker": "阿比德",
                    "text": "真让人眼红。阿尔卡米那小子，干建筑设计师的时候就得过且过，论能力他根本当不了老师。"
                },
                {
                    "id": "190780804",
                    "speaker": "阿迪勒",
                    "text": "他宣传得好呗…再加上教令院有入学考试，能进教令院学建筑的人毕竟还是少数。"
                },
                {
                    "id": "190780805",
                    "speaker": "阿迪勒",
                    "text": "上不了教令院的人，以及那些追求「速成」的人，自然会汇聚到他的培训机构里。"
                },
                {
                    "id": "190780806",
                    "speaker": "阿比德",
                    "text": "真是生财有道啊…"
                }
            ]
        },
