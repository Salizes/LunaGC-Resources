    "talks": [
        {
            "id": "7216438",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "721640101",
                    "speaker": "「寝子」",
                    "text": "唔喵…那个箱子果然很管用…"
                },
                {
                    "id": "721640102",
                    "speaker": "「寝子」",
                    "text": "是汝啊。那个「塞钱箱」，确实很管用呢。"
                },
                {
                    "id": "721640103",
                    "speaker": "「寝子」",
                    "text": "汝等修好之后不久，就有两个绿绿的人类过来神社了，喵喵。"
                },
                {
                    "id": "721640104",
                    "speaker": "「寝子」",
                    "text": "不仅往里面塞了钱，那个高高的，绿绿的人类听见奴家说话之后，还很激动。人类真是大惊小怪。"
                },
                {
                    "id": "721640105",
                    "speaker": "「寝子」",
                    "text": "「塞钱箱」真是好东西哪。如果再修一个，那就有更多人了吧？"
                },
                {
                    "id": "721640106",
                    "speaker": "Player",
                    "text": "事情不是这样的…"
                },
                {
                    "id": "721640107",
                    "speaker": "「寝子」",
                    "text": "是吗。人类的事情，还真是麻烦呢。"
                },
                {
                    "id": "721640108",
                    "speaker": "派蒙",
                    "text": "这个问题，应、应该和神社的环境有关吧…"
                },
                {
                    "id": "721640109",
                    "speaker": "「寝子」",
                    "text": "奴家的神社怎么了？",
                    "choices": [
                        {
                            "id": "721640110",
                            "text": "稍微有点乱…",
                            "response": [
                                {
                                    "id": "721640112",
                                    "speaker": "「寝子」",
                                    "text": "哎呀，是这样吗？不过，那些小家伙们都很喜欢在落叶堆里玩啊…"
                                },
                                {
                                    "id": "721640113",
                                    "speaker": "「寝子」",
                                    "text": "啊，不过仔细一想，阿响也经常用那个一头刺刺的长棍子，把树叶弄到一起。既然阿响会这么做，那一定是对的。",
                                    "choices": [
                                        {
                                            "id": "721640114",
                                            "text": "要打扫哪里？",
                                            "response": [
                                                {
                                                    "id": "721640116",
                                                    "speaker": "「寝子」",
                                                    "text": "奴家怎么会懂汝等人类的讲究嘛。唔…阿响的话…"
                                                },
                                                {
                                                    "id": "721640117",
                                                    "speaker": "「寝子」",
                                                    "text": "太阳还没出来的时候，阿响经常拿着那个长棍子在地上摆来摆去。奴家喜欢追着长棍子玩。"
                                                },
                                                {
                                                    "id": "721640118",
                                                    "speaker": "「寝子」",
                                                    "text": "但现在奴家可是「代宫司」，这种举动不合适。奴家可不是一般的小家伙。"
                                                },
                                                {
                                                    "id": "721640119",
                                                    "speaker": "「寝子」",
                                                    "text": "但是，阿响也会对地上用水。水可是坏东西。"
                                                },
                                                {
                                                    "id": "721640120",
                                                    "speaker": "「寝子」",
                                                    "text": "百目鬼有时候也会来，用交叉的铁片咔嚓咔嚓。然后树枝和树叶就会掉下来。",
                                                    "choices": [
                                                        {
                                                            "id": "721640121",
                                                            "text": "「百目鬼」？",
                                                            "response": [
                                                                {
                                                                    "id": "721640122",
                                                                    "speaker": "「寝子」",
                                                                    "text": "是一个好高好高，声音好大好大的人类。经常和阿响一起玩。"
                                                                },
                                                                {
                                                                    "id": "721640125",
                                                                    "speaker": "「寝子」",
                                                                    "text": "哼！每次他都会把奴家最喜欢的那几根树枝剪掉，是个讨厌的家伙。"
                                                                },
                                                                {
                                                                    "id": "721640126",
                                                                    "speaker": "派蒙",
                                                                    "text": "听起来…真的就是「打扫」，或者说「整理」呢。"
                                                                },
                                                                {
                                                                    "id": "721640127",
                                                                    "speaker": "派蒙",
                                                                    "text": "扫地，洒水，还有修剪树枝…"
                                                                },
                                                                {
                                                                    "id": "721640128",
                                                                    "speaker": "Player",
                                                                    "text": "都是很熟悉的工作啊…"
                                                                },
                                                                {
                                                                    "id": "721640129",
                                                                    "speaker": "「寝子」",
                                                                    "text": "这就是「打扫」吗？奴家明白了，那就拜托汝等了。"
                                                                },
                                                                {
                                                                    "id": "721640130",
                                                                    "speaker": "「寝子」",
                                                                    "text": "对了，咔嚓咔嚓就不必了。现在的树枝，奴家很喜欢。"
                                                                },
                                                                {
                                                                    "id": "721640131",
                                                                    "speaker": "「寝子」",
                                                                    "text": "长棍子落叶和水行了。汝等明白了吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "721640132",
                                                                            "text": "交给我们吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721640144",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "喵喵，这项工作可是阿响专门交付给奴家，只有奴家才能完成的重要工作呢。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "721640133",
                                                                            "text": "对了，「阿响」是…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721640134",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "阿响就是阿响，是浅濑神社的宫司。"
                                                                                },
                                                                                {
                                                                                    "id": "721640135",
                                                                                    "speaker": "Player",
                                                                                    "text": "那你的名字…"
                                                                                },
                                                                                {
                                                                                    "id": "721640136",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "奴家叫「寝子」，名字是阿响起的。"
                                                                                },
                                                                                {
                                                                                    "id": "721640137",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "平常都是由阿响出面招待来神社的人，不用奴家来照顾神社。"
                                                                                },
                                                                                {
                                                                                    "id": "721640138",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "奴家以前没有名字，也不用当「代宫司」，想睡就睡，想找谁玩就找谁玩。"
                                                                                },
                                                                                {
                                                                                    "id": "721640139",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "然后阿响说，因为奴家经常睡觉，所以就叫「寝子」吧。"
                                                                                },
                                                                                {
                                                                                    "id": "721640140",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "阿响现在不在，但神社不能没有「宫司」，所以奴家就当「代宫司」了。"
                                                                                },
                                                                                {
                                                                                    "id": "721640141",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "所以，在阿响回来前，奴家要把神社弄得又好又热闹。"
                                                                                },
                                                                                {
                                                                                    "id": "721640142",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "…对啊！这样的话，等她回来，奴家就可以在阿响怀里睡觉了，不用等她修「塞钱箱」，也不用等她用长棍子弄树叶了。"
                                                                                },
                                                                                {
                                                                                    "id": "721640143",
                                                                                    "speaker": "「寝子」",
                                                                                    "text": "总之，这件事就拜托汝等了，奴家去赶走那些偷偷爬进神社的虫子。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721640123",
                                                            "text": "咔嚓咔嚓？",
                                                            "response": [
                                                                {
                                                                    "id": "721640124",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊，是修剪枝条吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721640115",
                                            "text": "具体是要做什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721640111",
                            "text": "需要打扫一下…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7216439",
            "objective": "打扫神社屋子里的污渍",
            "dialogues": []
        },
        {
            "id": "7216443",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "721640201",
                    "speaker": "「寝子」",
                    "text": "「打扫」完了吗？"
                },
                {
                    "id": "721640202",
                    "speaker": "Player",
                    "text": "已经打扫干净了。"
                },
                {
                    "id": "721640203",
                    "speaker": "「寝子」",
                    "text": "喵喵，那就好，奴家也已经把那些小虫子都赶走了。"
                },
                {
                    "id": "721640204",
                    "speaker": "「寝子」",
                    "text": "神社真是越来越像样了，箱子也修好了，屋子也打扫干净了。喵喵…肯定会有很多人过来参拜的。"
                },
                {
                    "id": "721640205",
                    "speaker": "「寝子」",
                    "text": "喵喵…一定要在阿响回来之前，把神社重新变热闹…喵…"
                },
                {
                    "id": "721640206",
                    "speaker": "「寝子」",
                    "text": "今天就先到这里吧，谢谢汝等帮忙…喵喵…"
                },
                {
                    "id": "721640207",
                    "speaker": "「寝子」",
                    "text": "一直说人类的话…很累…"
                },
                {
                    "id": "721640208",
                    "speaker": "「寝子」",
                    "text": "奴家要休息一下了，过段时间，说不定还得请汝等帮忙…"
                },
                {
                    "id": "721640209",
                    "speaker": "「寝子」",
                    "text": "到时候，请汝等务必过来…喵喵…"
                }
            ]
        },
