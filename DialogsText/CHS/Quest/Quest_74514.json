    "talks": [
        {
            "id": "7451401",
            "objective": "与朝雾对话",
            "dialogues": [
                {
                    "id": "745140101",
                    "speaker": "朝雾",
                    "text": "好…好冷，果然不该随便吹风的…"
                },
                {
                    "id": "745140102",
                    "speaker": "朝雾",
                    "text": "#欸？{NICKNAME}！派蒙！你们…阿嚏！"
                },
                {
                    "id": "745140103",
                    "speaker": "Player",
                    "text": "朝雾？你怎么会在这里？"
                },
                {
                    "id": "745140104",
                    "speaker": "派蒙",
                    "text": "你的身体好了吗？居然能一个人来这么远的地方…"
                },
                {
                    "id": "745140105",
                    "speaker": "朝雾",
                    "text": "我…那个…好，好得差不多啦！你看，我都不咳嗽了。"
                },
                {
                    "id": "745140106",
                    "speaker": "朝雾",
                    "text": "哈哈…哈…",
                    "choices": [
                        {
                            "id": "745140107",
                            "text": "真的吗？",
                            "response": [
                                {
                                    "id": "745140109",
                                    "speaker": "朝雾",
                                    "text": "呜哇！别啊！我承认了，我是自己偷偷跑出来的啦！"
                                },
                                {
                                    "id": "745140110",
                                    "speaker": "朝雾",
                                    "text": "我…我也没办法啊，老是窝在稻妻，怎么可能画出好看的画。"
                                },
                                {
                                    "id": "745140111",
                                    "speaker": "朝雾",
                                    "text": "就算有你帮我到处去留影，但说到底，画片肯定比不过实景啊。"
                                },
                                {
                                    "id": "745140112",
                                    "speaker": "朝雾",
                                    "text": "所以，我就拜托之前合作过的一个老师帮忙联系了一支商队，悄悄地出来旅行。"
                                },
                                {
                                    "id": "745140113",
                                    "speaker": "Player",
                                    "text": "亏你还把画具都背过来了…"
                                },
                                {
                                    "id": "745140114",
                                    "speaker": "朝雾",
                                    "text": "那当然。画板可是我的灵魂，怎么能随便丢下它们呢。"
                                },
                                {
                                    "id": "745140115",
                                    "speaker": "朝雾",
                                    "text": "而且我的画在枫丹也卖得很好呀，还有几个枫丹的作家，请我给他们的小说画封面了。"
                                },
                                {
                                    "id": "745140116",
                                    "speaker": "朝雾",
                                    "text": "不过…他们居然没有在小说中间插入插画的习惯呢。真没想到…"
                                },
                                {
                                    "id": "745140117",
                                    "speaker": "朝雾",
                                    "text": "#对了，{NICKNAME}，刚巧你在这里…你愿意再帮我去取材吗？",
                                    "choices": [
                                        {
                                            "id": "745140118",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "745140119",
                                                    "speaker": "朝雾",
                                                    "text": "好欸！有你帮忙我就放心了。"
                                                },
                                                {
                                                    "id": "745140123",
                                                    "speaker": "朝雾",
                                                    "text": "好嘞…让我看看喔。正好我又接到了几个作家的约稿…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745140120",
                                            "text": "行吧。你可别乱跑。",
                                            "response": [
                                                {
                                                    "id": "745140121",
                                                    "speaker": "朝雾",
                                                    "text": "我知道啦。我可对付不了那些机关铁疙瘩。"
                                                },
                                                {
                                                    "id": "745140122",
                                                    "speaker": "朝雾",
                                                    "text": "论起对付各类奇奇怪怪的魔物，当然还是你最在行啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745140108",
                            "text": "我可要写信回去问了。"
                        }
                    ]
                }
            ]
        }
    ]
}