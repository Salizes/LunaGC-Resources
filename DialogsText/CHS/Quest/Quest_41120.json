    "talks": [
        {
            "id": "4112001",
            "objective": "与葛瑞丝修女对话",
            "dialogues": [
                {
                    "id": "411200101",
                    "speaker": "葛瑞丝",
                    "text": "希望所有人都平安无事…"
                },
                {
                    "id": "411200102",
                    "speaker": "Player",
                    "text": "您在担心什么吗？"
                },
                {
                    "id": "411200103",
                    "speaker": "葛瑞丝",
                    "text": "是旅行者啊。那些从天而降的陨石，您应该注意到了吧。"
                },
                {
                    "id": "411200104",
                    "speaker": "葛瑞丝",
                    "text": "虽然很幸运没有陨石砸到蒙德城里面来，但是野外已经乱成了一片。我很担心那些还逗留在野外的人…"
                },
                {
                    "id": "411200105",
                    "speaker": "葛瑞丝",
                    "text": "旅行者，能请你帮忙去警告一下那些还逗留在野外的人吗？"
                },
                {
                    "id": "411200106",
                    "speaker": "葛瑞丝",
                    "text": "如果他们愿意的话，就请他们到蒙德城里来避难吧。",
                    "choices": [
                        {
                            "id": "411200107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "411200108",
                                    "speaker": "葛瑞丝",
                                    "text": "那就拜托你了。"
                                },
                                {
                                    "id": "411200112",
                                    "speaker": "葛瑞丝",
                                    "text": "您可以先去找琳小姐，问问她知不知道还有哪些人逗留在野外。"
                                },
                                {
                                    "id": "411200113",
                                    "speaker": "葛瑞丝",
                                    "text": "然后，也请试着说服她进蒙德城避难。"
                                },
                                {
                                    "id": "411200114",
                                    "speaker": "葛瑞丝",
                                    "text": "现在可不是她接着挑战「野外生存」的时候了。"
                                }
                            ]
                        },
                        {
                            "id": "411200109",
                            "text": "为什么陨石没砸进蒙德城？",
                            "response": [
                                {
                                    "id": "411200110",
                                    "speaker": "葛瑞丝",
                                    "text": "也许只是运气好吧。但不管怎么说，蒙德城是目前来看比较安全的地方了。"
                                },
                                {
                                    "id": "411200111",
                                    "speaker": "葛瑞丝",
                                    "text": "至少…比呆在野外安全多了，您说对吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112002",
            "objective": "与琳对话",
            "dialogues": [
                {
                    "id": "411200201",
                    "speaker": "琳",
                    "text": "在这种情况下进行「野外生存」…好像还挺有挑战性的。"
                },
                {
                    "id": "411200202",
                    "speaker": "Player",
                    "text": "请进蒙德城避难。"
                },
                {
                    "id": "411200203",
                    "speaker": "琳",
                    "text": "避难？哎呀，不用担心我，我一直在留意着周围呢，不会有危险的。"
                },
                {
                    "id": "411200204",
                    "speaker": "琳",
                    "text": "不过，你怎么还在外面逛来逛去，还是快回蒙德城吧，要是被陨石砸到可就不好了。"
                },
                {
                    "id": "411200205",
                    "speaker": "Player",
                    "text": "关于在野外逗留的人…"
                },
                {
                    "id": "411200206",
                    "speaker": "琳",
                    "text": "在野外逗留的人？那可有很多啊，你问这个做什么？",
                    "choices": [
                        {
                            "id": "411200207",
                            "text": "去让他们避难。",
                            "response": [
                                {
                                    "id": "411200208",
                                    "speaker": "琳",
                                    "text": "是这样啊…这么一说，协会里好像也发布过相关的委托，我也去周围通知了不少人。"
                                },
                                {
                                    "id": "411200209",
                                    "speaker": "琳",
                                    "text": "离蒙德城比较近的人，应该都已经进城里避难了。"
                                },
                                {
                                    "id": "411200210",
                                    "speaker": "琳",
                                    "text": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。"
                                },
                                {
                                    "id": "411200215",
                                    "speaker": "琳",
                                    "text": "我想想啊，还逗留在野外的人…"
                                },
                                {
                                    "id": "411200216",
                                    "speaker": "琳",
                                    "text": "啊！对了，帕琪小姐和杜兰先生一直呆在千风神殿那边，我和他们说过了，但他们还是坚持在那里研究。"
                                },
                                {
                                    "id": "411200217",
                                    "speaker": "琳",
                                    "text": "还有芬德修女，之前她一直呆在望风角附近，协会里也让我去找过她几次，但我去了好几次都没找到她…"
                                },
                                {
                                    "id": "411200218",
                                    "speaker": "琳",
                                    "text": "我只记得这些了，你就先去告诉他们进蒙德城避难的事情吧。"
                                },
                                {
                                    "id": "411200219",
                                    "speaker": "琳",
                                    "text": "至于我嘛，再准备一点食物和必需品之后，我也会去周围转一圈，尽量通知更多人进城避难的。"
                                },
                                {
                                    "id": "411200220",
                                    "speaker": "琳",
                                    "text": "希望他们别跑到太偏远的地方去，不然就算找到了，回来也得大费一番周折吧…"
                                }
                            ]
                        },
                        {
                            "id": "411200211",
                            "text": "葛瑞丝修女很担心他们。",
                            "response": [
                                {
                                    "id": "411200212",
                                    "speaker": "琳",
                                    "text": "葛瑞丝修女？是她啊…其实协会里也发布过相关的委托，我也去周围通知了不少人。"
                                },
                                {
                                    "id": "411200213",
                                    "speaker": "琳",
                                    "text": "离蒙德城比较近的人，应该都已经进城里避难了。"
                                },
                                {
                                    "id": "411200214",
                                    "speaker": "琳",
                                    "text": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112003",
            "objective": "与杜兰对话",
            "dialogues": [
                {
                    "id": "411200301",
                    "speaker": "杜兰",
                    "text": "现在可不是研究的时候，我们得快点去避难才行。"
                },
                {
                    "id": "411200302",
                    "speaker": "好奇的帕琪",
                    "text": "我说过好几次了，我绝不会放过这次机会。"
                },
                {
                    "id": "411200303",
                    "speaker": "Player",
                    "text": "请进蒙德城去避难。"
                },
                {
                    "id": "411200304",
                    "speaker": "好奇的帕琪",
                    "text": "怎么又来了？现在可不是避难的时候，这些天降的陨石，说不定正是我们深入千风神殿的好机会。"
                },
                {
                    "id": "411200305",
                    "speaker": "Player",
                    "text": "深入千风神殿？"
                },
                {
                    "id": "411200306",
                    "speaker": "杜兰",
                    "text": "帕琪说，也许陨石会砸到千风神殿，如果底下有内殿…或者其他什么的话，我们就可以顺着陨石砸开的路深入了。"
                },
                {
                    "id": "411200307",
                    "speaker": "杜兰",
                    "text": "但是这也太异想天开了，如果陨石砸过来的话，我们俩逃都逃不开。"
                },
                {
                    "id": "411200308",
                    "speaker": "杜兰",
                    "text": "我们还是去避难吧，如果陨石真的砸进了千风神殿，还砸出了条路，那我们之后再来探索不也一样吗？"
                },
                {
                    "id": "411200309",
                    "speaker": "好奇的帕琪",
                    "text": "要是被人捷足先登了怎么办？要回去你自己回去，我要在这里等着。"
                },
                {
                    "id": "411200310",
                    "speaker": "杜兰",
                    "text": "这…好吧，旅行者，不好意思，我们俩还得在这呆一段时间。"
                },
                {
                    "id": "411200311",
                    "speaker": "杜兰",
                    "text": "别担心，如果真的有危险…我，我会处理好的。"
                },
                {
                    "id": "411200312",
                    "speaker": "杜兰",
                    "text": "对了，之前有个叫舒特的人路过了这里，一副很害怕的样子…"
                },
                {
                    "id": "411200313",
                    "speaker": "杜兰",
                    "text": "他找我要了点水喝之后，就说自己要回蒙德城，飞快地跑掉了。"
                },
                {
                    "id": "411200314",
                    "speaker": "杜兰",
                    "text": "但他跑的路却又不是往蒙德城，而是往望风角的…"
                },
                {
                    "id": "411200315",
                    "speaker": "杜兰",
                    "text": "我想…那家伙不会是因为太害怕，连路都记错了吧。"
                },
                {
                    "id": "411200316",
                    "speaker": "杜兰",
                    "text": "旅行者，你先去望风角附近找找他吧，如果他遇到魔物就糟糕了。"
                },
                {
                    "id": "411200317",
                    "speaker": "杜兰",
                    "text": "我会在这里陪着帕琪，如果真有什么事发生…呃，我会处理好的。"
                }
            ]
        },
        {
            "id": "4112008",
            "objective": "找到害怕的舒特",
            "dialogues": [
                {
                    "id": "411200801",
                    "speaker": "害怕的舒特",
                    "text": "呜哇！你…啊…不是魔物啊…"
                },
                {
                    "id": "411200802",
                    "speaker": "Player",
                    "text": "请进蒙德城去避难。"
                },
                {
                    "id": "411200803",
                    "speaker": "害怕的舒特",
                    "text": "我…我知道！我也是来通知其他人去避难的，只不过多走了点路而已。"
                },
                {
                    "id": "411200804",
                    "speaker": "Player",
                    "text": "你躲在这做什么…"
                },
                {
                    "id": "411200805",
                    "speaker": "害怕的舒特",
                    "text": "我…我在这休息，不行吗？你别说我了，赶紧回蒙德城避难去吧。"
                },
                {
                    "id": "411200806",
                    "speaker": "害怕的舒特",
                    "text": "又是陨石又是魔物…现在还呆在野外的人，肯定脑子不好使…"
                },
                {
                    "id": "411200807",
                    "speaker": "Player",
                    "text": "还有其他呆在野外的人吗？"
                },
                {
                    "id": "411200808",
                    "speaker": "害怕的舒特",
                    "text": "我本来是要去找芬德修女，通知她进蒙德城避难的…就是一直呆在望风角附近的那位修女。"
                },
                {
                    "id": "411200809",
                    "speaker": "害怕的舒特",
                    "text": "不过我找遍了望风角也没找到芬德修女，然后我就去别的地方跑了一圈，想要再找找…"
                },
                {
                    "id": "411200810",
                    "speaker": "害怕的舒特",
                    "text": "结果运气不好，反而被一群发了疯的魔物发现了，我好不容易才甩掉了它们。"
                },
                {
                    "id": "411200811",
                    "speaker": "害怕的舒特",
                    "text": "但我转来转去，又转回望风角了，而且还是没找到芬德修女。"
                },
                {
                    "id": "411200812",
                    "speaker": "害怕的舒特",
                    "text": "唉，希望那位修女真的是已经回蒙德城了…"
                },
                {
                    "id": "411200813",
                    "speaker": "害怕的舒特",
                    "text": "好了，我要先回蒙德城了，你也快点回去吧，现在可不是在野外乱逛的时候。"
                }
            ]
        },
        {
            "id": "4112004",
            "objective": "与芬德对话",
            "dialogues": [
                {
                    "id": "411200401",
                    "speaker": "芬德",
                    "text": "咦？旅行者，您来这里做什么？"
                },
                {
                    "id": "411200402",
                    "speaker": "Player",
                    "text": "您到底去哪了？"
                },
                {
                    "id": "411200403",
                    "speaker": "芬德",
                    "text": "抱歉，我一直在四处走动观察海面，确实有些难找…您找我有什么事吗？"
                },
                {
                    "id": "411200404",
                    "speaker": "Player",
                    "text": "请去蒙德城避难。"
                },
                {
                    "id": "411200405",
                    "speaker": "芬德",
                    "text": "避难？哦，您说的是那些陨石啊，我知道，但是…"
                },
                {
                    "id": "411200406",
                    "speaker": "派蒙",
                    "text": "小，小心！小心周围！有魔物围上来了！"
                }
            ]
        },
        {
            "id": "4112005",
            "objective": "打倒所有魔物",
            "dialogues": []
        },
        {
            "id": "4112006",
            "objective": "与芬德对话",
            "dialogues": [
                {
                    "id": "411200601",
                    "speaker": "芬德",
                    "text": "呼…谢谢您，刚才真是太危险了。"
                },
                {
                    "id": "411200602",
                    "speaker": "Player",
                    "text": "所以，请您进蒙德城去避难。"
                },
                {
                    "id": "411200603",
                    "speaker": "芬德",
                    "text": "抱歉，我暂时还不能回去。现在天降陨石，已经可以说是十分奇怪的天象了…"
                },
                {
                    "id": "411200604",
                    "speaker": "芬德",
                    "text": "在这种天象里，海上再产生风暴的话也不奇怪。"
                },
                {
                    "id": "411200605",
                    "speaker": "芬德",
                    "text": "我必须要在这里守着，如果真有风暴出现，我必须第一时间通知城里。"
                },
                {
                    "id": "411200606",
                    "speaker": "芬德",
                    "text": "谢谢您来通知我，辛苦您了，我会多加小心的。"
                }
            ]
        },
        {
            "id": "4112007",
            "objective": "向葛瑞丝修女回报",
            "dialogues": [
                {
                    "id": "411200701",
                    "speaker": "葛瑞丝",
                    "text": "您回来了，都通知到了吗？"
                },
                {
                    "id": "411200702",
                    "speaker": "Player",
                    "text": "都通知到了，但他们都暂时不肯回来…"
                },
                {
                    "id": "411200703",
                    "speaker": "葛瑞丝",
                    "text": "不肯回来？到底是有什么重要的事，让他们这个时候还要呆在野外。"
                },
                {
                    "id": "411200704",
                    "speaker": "Player",
                    "text": "不愧是自由的蒙德人…"
                },
                {
                    "id": "411200705",
                    "speaker": "葛瑞丝",
                    "text": "哈哈…哈…是啊，他们确实是自由的蒙德人，再自由不过了。"
                },
                {
                    "id": "411200706",
                    "speaker": "葛瑞丝",
                    "text": "但是在这个时候，我更希望他们能把这份自由给收敛起来。"
                },
                {
                    "id": "411200707",
                    "speaker": "葛瑞丝",
                    "text": "唉…西风骑士团想必也没空处理这件事吧。算了，我再想想其他办法，辛苦您了。"
                },
                {
                    "id": "411200708",
                    "speaker": "葛瑞丝",
                    "text": "希望所有人都能平安无事…"
                }
            ]
        },
        {
            "id": "4112051",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411205101",
                    "speaker": "葛瑞丝",
                    "text": "希望所有人都平安无事…"
                }
            ]
        },
        {
            "id": "4112052",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411205201",
                    "speaker": "琳",
                    "text": "野外寻人…嗯，应该也算是「野外生存」里的一环吧。"
                }
            ]
        },
        {
            "id": "4112053",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411205301",
                    "speaker": "杜兰",
                    "text": "不如我们还是先去避难吧，等安全一点再来研究。"
                },
                {
                    "id": "411205302",
                    "speaker": "好奇的帕琪",
                    "text": "我都说了，要回去你自己回去，我可不会让人家捷足先登。"
                }
            ]
        },
        {
            "id": "4112056",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411205601",
                    "speaker": "芬德",
                    "text": "希望不要出现风暴…"
                }
            ]
        }
    ]
}