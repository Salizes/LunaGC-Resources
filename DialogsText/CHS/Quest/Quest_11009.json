    "talks": [
        {
            "id": "1100901",
            "objective": "前往玉京台听凝光演讲",
            "dialogues": [
                {
                    "id": "110090101",
                    "speaker": "凝光",
                    "text": "今天召集诸位，是想宣布一件重要的事情。"
                },
                {
                    "id": "110090102",
                    "speaker": "凝光",
                    "text": "或许有人已听到过风声，最近我确实打算重修群玉阁。"
                },
                {
                    "id": "110090103",
                    "speaker": "宏飞",
                    "text": "重修群玉阁？这可是个大工程…"
                },
                {
                    "id": "110090104",
                    "speaker": "昌贵",
                    "text": "坊间传闻确有其事啊，难怪前段时间建材价格飞涨…"
                },
                {
                    "id": "110090105",
                    "speaker": "志成",
                    "text": "群玉阁对凝光大人意义非凡，如果能搭上这条线…"
                },
                {
                    "id": "110090106",
                    "speaker": "宏飞",
                    "text": "凝光大人，有什么需要我们帮忙的吗？"
                },
                {
                    "id": "110090107",
                    "speaker": "凝光",
                    "text": "不必心急。前些日子消息传开后，有不少人通过各种渠道联系我，想要加入到这个工程中。"
                },
                {
                    "id": "110090108",
                    "speaker": "凝光",
                    "text": "眼下我手里确实有几件事，想委托给诸位。"
                },
                {
                    "id": "110090109",
                    "speaker": "凝光",
                    "text": "如今工程已经完成选址，各式建材准备妥当，但尚有三件至关重要的物品没有着落。"
                },
                {
                    "id": "110090110",
                    "speaker": "凝光",
                    "text": "这三件物品，分别是「鸣霞浮生石」、「千奇核心」以及「仙家符箓」。"
                },
                {
                    "id": "110090111",
                    "speaker": "昌贵",
                    "text": "这…恕我冒昧，除了浮生石外，后面两样我从未听说过…"
                },
                {
                    "id": "110090112",
                    "speaker": "凝光",
                    "text": "规格够大的浮生石，才能冠以「鸣霞」之称，这是保证群玉阁能够升空的基础。千奇核心，则是群玉阁内机械结构的核心。"
                },
                {
                    "id": "110090113",
                    "speaker": "凝光",
                    "text": "至于仙家符箓，它的效用是将机械装置与仙家术法有效结合，同样不可或缺。"
                },
                {
                    "id": "110090114",
                    "speaker": "凝光",
                    "text": "虽是三样罕见之物，但以诸位的人脉和能力，找齐它们应该只是时间问题。"
                },
                {
                    "id": "110090115",
                    "speaker": "凝光",
                    "text": "兵贵神速，一切全看效率。我会以好价收购你们找来的材料。此外，前三位找齐材料的人，将得到一次向我提问的机会。"
                },
                {
                    "id": "110090116",
                    "speaker": "凝光",
                    "text": "无论是什么问题，我都会回答。我相信，以此为报酬，必不会令各位失望。"
                },
                {
                    "id": "110090117",
                    "speaker": "昌贵",
                    "text": "这东西虽然难找，但如果能问到璃月港明年的规划…"
                },
                {
                    "id": "110090118",
                    "speaker": "志成",
                    "text": "那就是天价的生意了。谁从凝光大人那里问到消息，谁就掌握了先机…"
                },
                {
                    "id": "110090119",
                    "speaker": "宏飞",
                    "text": "哈哈，真是巧了！不久前我刚听说过有关浮生石的传闻。各位，恕不奉陪了，我先行一步！"
                },
                {
                    "id": "110090120",
                    "speaker": "昌贵",
                    "text": "可恶…我们也赶紧出发，不能被别人抢先了！"
                },
                {
                    "id": "110090121",
                    "speaker": "派蒙",
                    "text": "重修群玉阁…这么重要的事情，我们也去看看吧！"
                },
                {
                    "id": "110090122",
                    "speaker": "凝光",
                    "text": "方才我说的话，你们都听到了吧。如何？可有兴趣参与此事？"
                },
                {
                    "id": "110090123",
                    "speaker": "Player",
                    "text": "真的什么都可以问吗？"
                },
                {
                    "id": "110090124",
                    "speaker": "凝光",
                    "text": "只要是我知道的事，均可如实相告。"
                },
                {
                    "id": "110090125",
                    "speaker": "Player",
                    "text": "#（说不定可以问到关于{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的事…）"
                },
                {
                    "id": "110090126",
                    "speaker": "派蒙",
                    "text": "真的吗？那我要问，凝光小姐是怎么经商的！"
                },
                {
                    "id": "110090127",
                    "speaker": "派蒙",
                    "text": "这样以后旅行，我们就再也不缺摩拉用啦！"
                },
                {
                    "id": "110090128",
                    "speaker": "凝光",
                    "text": "呵呵，当然可以。不过，传授多少心得，全看二位的表现了。"
                },
                {
                    "id": "110090129",
                    "speaker": "凝光",
                    "text": "群玉阁重建一事占地较大，我将地址安排在黄金屋外的废弃矿场。收集到的材料，都送去那边吧。"
                },
                {
                    "id": "110090130",
                    "speaker": "凝光",
                    "text": "我另有要事，不能陪你们前往现场。你们到了那里，联系我的秘书就好。"
                },
                {
                    "id": "110090131",
                    "speaker": "凝光",
                    "text": "千万注意时间。难得的机会，可别被别人抢先了。"
                },
                {
                    "id": "110090132",
                    "speaker": "派蒙",
                    "text": "凝光小姐真是个大忙人呢…我们也快点出发吧。"
                },
                {
                    "id": "110090133",
                    "speaker": "派蒙",
                    "text": "#首先得先从玉京台离开…咦？{NICKNAME}你看，那边气氛好像有些微妙？"
                },
                {
                    "id": "110090134",
                    "speaker": "刀疤刘",
                    "text": "小姐，我看你风度翩翩、气质不凡，一看就是在这次重修群玉阁中独占鳌头的料。"
                },
                {
                    "id": "110090135",
                    "speaker": "刀疤刘",
                    "text": "我们这里有关于那些材料的情报，来，咱们找个安静的地方说话…"
                },
                {
                    "id": "110090136",
                    "speaker": "？？？",
                    "text": "不需要。"
                },
                {
                    "id": "110090137",
                    "speaker": "刀疤刘",
                    "text": "别这么说嘛。哎，别走啊！"
                },
                {
                    "id": "110090138",
                    "speaker": "刀疤刘",
                    "text": "愣着干什么，还不快跟上！"
                },
                {
                    "id": "110090139",
                    "speaker": "阿强",
                    "text": "是…是！"
                }
            ]
        },
        {
            "id": "1100905",
            "objective": "跟随「情报商」打听消息",
            "dialogues": [
                {
                    "id": "110090501",
                    "speaker": "常丰",
                    "text": "重修群玉阁，这么重要的工作交给我们，我们也得上心才行。"
                }
            ]
        },
        {
            "id": "1100902",
            "objective": "暗中观察情报商与陌生女子的争吵",
            "dialogues": [
                {
                    "id": "110090201",
                    "speaker": "刀疤刘",
                    "text": "嘿嘿，小姐，这次你终于没地方跑了吧。"
                },
                {
                    "id": "110090202",
                    "speaker": "刀疤刘",
                    "text": "放心，我们也不是什么坏人。出点钱就能换到宝贵的情报，大家谁都不亏嘛。"
                },
                {
                    "id": "110090203",
                    "speaker": "阿强",
                    "text": "老大，我总有种不好的感觉。你看她身上的气质明显和别人不同，头发也是白的，不像是普通人…"
                },
                {
                    "id": "110090204",
                    "speaker": "刀疤刘",
                    "text": "那又如何？好不容易遇见一只肥羊，不宰她一刀，咱们的赌债怎么还？"
                },
                {
                    "id": "110090205",
                    "speaker": "？？？",
                    "text": "我说了，我不需要你们的情报。"
                },
                {
                    "id": "110090206",
                    "speaker": "？？？",
                    "text": "如果你们刚刚没有听到，那我再重复最后一次。"
                },
                {
                    "id": "110090207",
                    "speaker": "刀疤刘",
                    "text": "唉…小姐，你说你这么大一个人，怎么一点常识也没有啊。"
                },
                {
                    "id": "110090208",
                    "speaker": "刀疤刘",
                    "text": "这不是你需不需要的问题，你只要乖乖地把钱拿出来，交给我们就好。"
                },
                {
                    "id": "110090209",
                    "speaker": "？？？",
                    "text": "我…"
                },
                {
                    "id": "110090210",
                    "speaker": "刀疤刘",
                    "text": "别狡辩！你有钱，我看到了。"
                },
                {
                    "id": "110090211",
                    "speaker": "刀疤刘",
                    "text": "你先去琉璃亭，点了满满一桌子菜，却只是稍微尝了尝。"
                },
                {
                    "id": "110090212",
                    "speaker": "刀疤刘",
                    "text": "然后又去新月轩、万民堂，把招牌菜全点了一遍，又是每样只吃一口。"
                },
                {
                    "id": "110090213",
                    "speaker": "刀疤刘",
                    "text": "如果不是富家千金小姐，哪来如此奢侈的习惯？既然你这么有钱，分我们一点怎么了？"
                },
                {
                    "id": "110090214",
                    "speaker": "？？？",
                    "text": "虽然师父叮嘱过，不要在璃月港里动手…"
                },
                {
                    "id": "110090215",
                    "speaker": "？？？",
                    "text": "算了。或许…这也是命吧。"
                },
                {
                    "id": "110090216",
                    "speaker": "阿强",
                    "text": "老大，好像有点不太对劲…"
                },
                {
                    "id": "110090217",
                    "speaker": "刀疤刘",
                    "text": "怕什么，咱们卖情报又不犯法，她要是敢动手，咱们告她个倾家荡产！",
                    "choices": [
                        {
                            "id": "110090218",
                            "text": "就是他们。",
                            "response": [
                                {
                                    "id": "110090220",
                                    "speaker": "老郑",
                                    "text": "哦？又是你们几个。"
                                },
                                {
                                    "id": "110090221",
                                    "speaker": "刀疤刘",
                                    "text": "千岩军？千岩军怎么来了…是你干的？哼，多管闲事，信不信我…"
                                },
                                {
                                    "id": "110090222",
                                    "speaker": "老郑",
                                    "text": "住口！还敢威胁别人是吧，跟我们走一趟！"
                                },
                                {
                                    "id": "110090223",
                                    "speaker": "刀疤刘",
                                    "text": "呵呵…大人别生气，您听我慢慢跟您解释…"
                                },
                                {
                                    "id": "110090224",
                                    "speaker": "Black Screen",
                                    "text": "围住白发女子的流氓被千岩军带走了。"
                                },
                                {
                                    "id": "110090225",
                                    "speaker": "？？？",
                                    "text": "……",
                                    "choices": [
                                        {
                                            "id": "110090226",
                                            "text": "你没事吧？",
                                            "response": [
                                                {
                                                    "id": "110090228",
                                                    "speaker": "？？？",
                                                    "text": "…申鹤。"
                                                },
                                                {
                                                    "id": "110090229",
                                                    "speaker": "派蒙",
                                                    "text": "申鹤？"
                                                },
                                                {
                                                    "id": "110090230",
                                                    "speaker": "申鹤",
                                                    "text": "我的名字。"
                                                },
                                                {
                                                    "id": "110090231",
                                                    "speaker": "派蒙",
                                                    "text": "#哦哦，原来你叫申鹤呀！我的名字是派蒙，这位是{NICKNAME}！"
                                                },
                                                {
                                                    "id": "110090232",
                                                    "speaker": "申鹤",
                                                    "text": "我听说过你们。刚刚，谢谢你们帮我解围。"
                                                },
                                                {
                                                    "id": "110090233",
                                                    "speaker": "申鹤",
                                                    "text": "虽然我自己也能解决。据我判断，只要抓着那个人的脑袋敲三下地面，他应该就会服软。"
                                                },
                                                {
                                                    "id": "110090234",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇！不，不可以用那么暴力的办法啦！"
                                                },
                                                {
                                                    "id": "110090235",
                                                    "speaker": "派蒙",
                                                    "text": "这里可是璃月港，要遵守璃月港的律法！"
                                                },
                                                {
                                                    "id": "110090236",
                                                    "speaker": "申鹤",
                                                    "text": "律…法？"
                                                },
                                                {
                                                    "id": "110090237",
                                                    "speaker": "Player",
                                                    "text": "申鹤没有听说过律法吗？"
                                                },
                                                {
                                                    "id": "110090238",
                                                    "speaker": "申鹤",
                                                    "text": "我确实没有听过。"
                                                },
                                                {
                                                    "id": "110090239",
                                                    "speaker": "派蒙",
                                                    "text": "真的假的，那你以前——"
                                                },
                                                {
                                                    "id": "110090241",
                                                    "speaker": "Player",
                                                    "text": "好像有什么声音…"
                                                },
                                                {
                                                    "id": "110090242",
                                                    "speaker": "申鹤",
                                                    "text": "是我的肚子在响。因为没有吃饱。"
                                                },
                                                {
                                                    "id": "110090243",
                                                    "speaker": "派蒙",
                                                    "text": "居然这么坦率地承认了…"
                                                },
                                                {
                                                    "id": "110090244",
                                                    "speaker": "派蒙",
                                                    "text": "说起来，刚刚听那些人说，你到许多餐馆点菜，每样却只尝一口…"
                                                },
                                                {
                                                    "id": "110090245",
                                                    "speaker": "派蒙",
                                                    "text": "这样肯定是吃不饱的吧！你有什么想吃的吗？"
                                                },
                                                {
                                                    "id": "110090246",
                                                    "speaker": "申鹤",
                                                    "text": "清心、琉璃百合、琉璃袋…这些是我平时吃的。"
                                                },
                                                {
                                                    "id": "110090247",
                                                    "speaker": "Player",
                                                    "text": "这些都是药材…"
                                                },
                                                {
                                                    "id": "110090248",
                                                    "speaker": "申鹤",
                                                    "text": "药材？"
                                                },
                                                {
                                                    "id": "110090249",
                                                    "speaker": "派蒙",
                                                    "text": "好像解释不通…不卜庐就在这附近吧，我们不如带申鹤去饱餐一顿好了！"
                                                },
                                                {
                                                    "id": "110090250",
                                                    "speaker": "派蒙",
                                                    "text": "毕竟吃饱了才有力气干活嘛！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110090227",
                                            "text": "放心，这样就没问题了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110090219",
                            "text": "这几个人在强买强卖。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100903",
            "objective": "带申鹤前往不卜庐购买药材",
            "dialogues": [
                {
                    "id": "110090301",
                    "speaker": "阿桂",
                    "text": "两位是来抓药的吗？可还记得药方？"
                },
                {
                    "id": "110090302",
                    "speaker": "申鹤",
                    "text": "清心、琉璃百合、琉璃袋，各要半斤。"
                },
                {
                    "id": "110090303",
                    "speaker": "阿桂",
                    "text": "这是什么药方？简直是拿药当饭吃…给，这就是本店全部的存货了。"
                },
                {
                    "id": "110090304",
                    "speaker": "申鹤",
                    "text": "多谢。"
                },
                {
                    "id": "110090305",
                    "speaker": "派蒙",
                    "text": "真，真的在吃欸…"
                },
                {
                    "id": "110090306",
                    "speaker": "Black Screen",
                    "text": "在众人震惊的目光中，申鹤将眼前的药材扫荡一空。"
                },
                {
                    "id": "110090307",
                    "speaker": "申鹤",
                    "text": "不饿了，多谢款待。",
                    "choices": [
                        {
                            "id": "110090308",
                            "text": "味道如何…",
                            "response": [
                                {
                                    "id": "110090310",
                                    "speaker": "申鹤",
                                    "text": "不好吃。"
                                },
                                {
                                    "id": "110090311",
                                    "speaker": "申鹤",
                                    "text": "其味虽略带清香，但吃多了就只剩下苦、酸、涩。"
                                },
                                {
                                    "id": "110090312",
                                    "speaker": "派蒙",
                                    "text": "那申鹤为什么宁愿吃这些，也不吃饭馆里的菜呢？"
                                },
                                {
                                    "id": "110090313",
                                    "speaker": "派蒙",
                                    "text": "要是我有很多摩拉的话，我肯定要去最高档的餐馆，点好多好多好吃的，一口气全部吃掉！"
                                },
                                {
                                    "id": "110090314",
                                    "speaker": "申鹤",
                                    "text": "因为我也不确定，以后自己会不会留在这里。"
                                },
                                {
                                    "id": "110090315",
                                    "speaker": "申鹤",
                                    "text": "人间的饭菜固然美味，但若是我将来回归山野，对美食的回味反而会成为修炼的阻碍。"
                                },
                                {
                                    "id": "110090316",
                                    "speaker": "申鹤",
                                    "text": "所以浅尝辄止，明白个中滋味便好。"
                                },
                                {
                                    "id": "110090317",
                                    "speaker": "派蒙",
                                    "text": "#回归山野…{NICKNAME}，不会错，这个人绝对是仙人！"
                                },
                                {
                                    "id": "110090318",
                                    "speaker": "申鹤",
                                    "text": "我的事暂且不提，两位接下来有什么打算？"
                                },
                                {
                                    "id": "110090319",
                                    "speaker": "派蒙",
                                    "text": "对哦！差点忘了，我们可是来参加重修群玉阁比赛的！"
                                },
                                {
                                    "id": "110090320",
                                    "speaker": "派蒙",
                                    "text": "耽、耽误太多时间，事情可就做不完了…"
                                },
                                {
                                    "id": "110090321",
                                    "speaker": "申鹤",
                                    "text": "原来如此。那个比赛，我刚刚路过的时候也有所耳闻。"
                                },
                                {
                                    "id": "110090322",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿…毕竟赢了的话，不管什么事情都可以问呢！"
                                },
                                {
                                    "id": "110090323",
                                    "speaker": "派蒙",
                                    "text": "申鹤也是来参赛的吗？"
                                },
                                {
                                    "id": "110090324",
                                    "speaker": "申鹤",
                                    "text": "我确实是为重修群玉阁而来，不过此前并没有参赛的想法。"
                                },
                                {
                                    "id": "110090325",
                                    "speaker": "申鹤",
                                    "text": "如今承蒙你们照顾，我也想助你们一臂之力。放心，并不需要什么回报。"
                                },
                                {
                                    "id": "110090326",
                                    "speaker": "派蒙",
                                    "text": "哇…这怎么好意思…"
                                },
                                {
                                    "id": "110090327",
                                    "speaker": "派蒙",
                                    "text": "不过有仙人帮忙的话，事情应该会好办许多…",
                                    "choices": [
                                        {
                                            "id": "110090328",
                                            "text": "那我们就一起行动吧。",
                                            "response": [
                                                {
                                                    "id": "110090330",
                                                    "speaker": "申鹤",
                                                    "text": "那事不宜迟，眼下我有一个作战方案。"
                                                },
                                                {
                                                    "id": "110090331",
                                                    "speaker": "派蒙",
                                                    "text": "好欸！申鹤提出来的方案，一定很厉害！"
                                                },
                                                {
                                                    "id": "110090332",
                                                    "speaker": "申鹤",
                                                    "text": "厉不厉害我不太清楚，不过应该很有效。"
                                                },
                                                {
                                                    "id": "110090333",
                                                    "speaker": "申鹤",
                                                    "text": "只要把排名比我们靠前的人全部干掉，我们就会成为第一名。"
                                                },
                                                {
                                                    "id": "110090334",
                                                    "speaker": "派蒙",
                                                    "text": "…不可以！怎么想都不可以吧！"
                                                },
                                                {
                                                    "id": "110090335",
                                                    "speaker": "申鹤",
                                                    "text": "是吗？但我听说竞争本身就是相互倾轧、相互算计…"
                                                },
                                                {
                                                    "id": "110090336",
                                                    "speaker": "派蒙",
                                                    "text": "我们可是要堂堂正正地拿下第一名！"
                                                },
                                                {
                                                    "id": "110090337",
                                                    "speaker": "派蒙",
                                                    "text": "「鸣霞浮生石」、「千奇核心」，还有「仙家符箓」…我们就按顺序找好了，首先是浮生石…"
                                                },
                                                {
                                                    "id": "110090338",
                                                    "speaker": "白术",
                                                    "text": "我说怎么店外就能听到争论的声音，原来是你们来了。"
                                                },
                                                {
                                                    "id": "110090339",
                                                    "speaker": "派蒙",
                                                    "text": "白术！你怎么来了？"
                                                },
                                                {
                                                    "id": "110090340",
                                                    "speaker": "白术",
                                                    "text": "凝光小姐要采购一批伤药，店里的药材不一定够用，所以我亲自过来筹备。"
                                                },
                                                {
                                                    "id": "110090341",
                                                    "speaker": "派蒙",
                                                    "text": "咦，凝光小姐要这么多伤药做什么？"
                                                },
                                                {
                                                    "id": "110090342",
                                                    "speaker": "白术",
                                                    "text": "我也不清楚，听说她要重建群玉阁，可能是工地上要用吧？总之是客人的隐私，我不便多问。"
                                                },
                                                {
                                                    "id": "110090343",
                                                    "speaker": "白术",
                                                    "text": "她还从我这里借走了七七，不卜庐现在非常缺人，几位要不要留下来做份兼职？"
                                                },
                                                {
                                                    "id": "110090344",
                                                    "speaker": "派蒙",
                                                    "text": "不了不了，我们还有别的事情…说起来，白术见多识广，有没有听说过「鸣霞浮生石」？"
                                                },
                                                {
                                                    "id": "110090345",
                                                    "speaker": "白术",
                                                    "text": "是说群玉阁要用的那种吗？我记得《七臧山经》里提到过，鸣霞浮生石激活后可直上云霄，非常稀有。"
                                                },
                                                {
                                                    "id": "110090346",
                                                    "speaker": "白术",
                                                    "text": "有明文记载的鸣霞浮生石基本已经被开采完毕，皆是有主之物。比起我，飞云商会应该对此更为了解。"
                                                },
                                                {
                                                    "id": "110090347",
                                                    "speaker": "派蒙",
                                                    "text": "原来如此，那我们去飞云商会问问吧！"
                                                },
                                                {
                                                    "id": "110090348",
                                                    "speaker": "派蒙",
                                                    "text": "谢谢你啦，白术！"
                                                },
                                                {
                                                    "id": "110090349",
                                                    "speaker": "白术",
                                                    "text": "不客气，祝你们顺利。有什么需要的话，来不卜庐找我就好。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110090329",
                                            "text": "随时欢迎。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110090309",
                            "text": "真的好吃吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100907",
            "objective": "(test)对话第一次刷不卜庐药材$HIDDEN",
            "dialogues": [
                {
                    "id": "110090701",
                    "speaker": "乐明",
                    "text": "眼下第一步，是修建群玉阁的底座。等浮生石到了，就可以将浮生石安放在底座中…"
                }
            ]
        },
        {
            "id": "1100906",
            "objective": "(test)对话第二次刷不卜庐药材$HIDDEN",
            "dialogues": [
                {
                    "id": "110090601",
                    "speaker": "安顺",
                    "text": "按照惯例，应该是玉衡星刻晴大人监工，不过刻晴大人最近似乎在忙别的事情…"
                }
            ]
        },
        {
            "id": "1100904",
            "objective": "(test)【废弃】前往说书人处商议计划",
            "dialogues": [
                {
                    "id": "110090401",
                    "speaker": "白术",
                    "text": "凝光小姐需要的伤药，未免有点太多了。"
                },
                {
                    "id": "110090402",
                    "speaker": "白术",
                    "text": "重修群玉阁原来是这么危险的事情吗？奇怪…"
                }
            ]
        },
        {
            "id": "1100908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110090801",
                    "speaker": "理正",
                    "text": "嘘…别吵，没看见我在忙吗？每一块砖都很关键，万一砌歪了可就糟了。"
                }
            ]
        },
        {
            "id": "1100909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110090901",
                    "speaker": "思勤",
                    "text": "在下奉命保卫这里的安全，工期要紧，希望别出什么岔子。"
                }
            ]
        },
        {
            "id": "1100910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110091001",
                    "speaker": "阿亮",
                    "text": "最近千岩军调动频繁，也不知道发生了什么事…还是小心为好。"
                }
            ]
        },
        {
            "id": "1100911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110091101",
                    "speaker": "百闻",
                    "text": "兹事体大，我得对得起凝光大人的信任…"
                },
                {
                    "id": "110091102",
                    "speaker": "百闻",
                    "text": "嗯？你们是来交材料的吗？"
                }
            ]
        },
        {
            "id": "1100999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110099901",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你听见了吗？那些人好像有情报欸！"
                },
                {
                    "id": "110099902",
                    "speaker": "派蒙",
                    "text": "我们现在最需要的就是情报了，快跟上去看看吧！"
                },
                {
                    "id": "110099903",
                    "speaker": "派蒙",
                    "text": "咦…好像不在这里，我们往下面找找看吧。"
                },
                {
                    "id": "110099904",
                    "speaker": "派蒙",
                    "text": "#嘘…{NICKNAME}，你说申鹤她会不会是仙人呀？"
                },
                {
                    "id": "110099905",
                    "speaker": "派蒙",
                    "text": "她好像是第一次来璃月港，也缺乏很多该有的常识，如果是仙人的话，就能解释得通了。"
                },
                {
                    "id": "110099906",
                    "speaker": "派蒙",
                    "text": "到底是哪一位仙人呢？真让人好奇…"
                }
            ]
        }
    ]
}