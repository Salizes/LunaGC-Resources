    "talks": [
        {
            "id": "7065901",
            "objective": "与吉盖克斯对话",
            "dialogues": [
                {
                    "id": "706590101",
                    "speaker": "吉盖克斯",
                    "text": "你好，想试试「风行迷踪」吗？"
                },
                {
                    "id": "706590102",
                    "speaker": "Player",
                    "text": "「风行迷踪」是什么？"
                },
                {
                    "id": "706590103",
                    "speaker": "吉盖克斯",
                    "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！"
                },
                {
                    "id": "706590104",
                    "speaker": "吉盖克斯",
                    "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？"
                },
                {
                    "id": "706590105",
                    "speaker": "吉盖克斯",
                    "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…"
                },
                {
                    "id": "706590106",
                    "speaker": "吉盖克斯",
                    "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。"
                },
                {
                    "id": "706590107",
                    "speaker": "吉盖克斯",
                    "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。"
                },
                {
                    "id": "706590108",
                    "speaker": "吉盖克斯",
                    "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。"
                },
                {
                    "id": "706590109",
                    "speaker": "吉盖克斯",
                    "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。"
                },
                {
                    "id": "706590110",
                    "speaker": "吉盖克斯",
                    "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…"
                },
                {
                    "id": "706590111",
                    "speaker": "Player",
                    "text": "曾经？"
                },
                {
                    "id": "706590112",
                    "speaker": "吉盖克斯",
                    "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…"
                },
                {
                    "id": "706590113",
                    "speaker": "吉盖克斯",
                    "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。"
                },
                {
                    "id": "706590114",
                    "speaker": "吉盖克斯",
                    "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…"
                }
            ]
        },
        {
            "id": "7065902",
            "objective": "与吉盖克斯对话",
            "dialogues": []
        },
        {
            "id": "7065903",
            "objective": "与吉盖克斯对话",
            "dialogues": [
                {
                    "id": "706590301",
                    "speaker": "吉盖克斯",
                    "text": "咳，不说这么多了，不如你直接来试玩一下吧。",
                    "choices": [
                        {
                            "id": "706590302",
                            "text": "游玩「风行迷踪」。"
                        },
                        {
                            "id": "706590303",
                            "text": "离开。",
                            "response": [
                                {
                                    "id": "706590304",
                                    "speaker": "吉盖克斯",
                                    "text": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}