    "talks": [
        {
            "id": "7365201",
            "objective": "与哈贾娜德对话",
            "dialogues": [
                {
                    "id": "736520101",
                    "speaker": "哈贾娜德",
                    "text": "终于回来了？我等你们好久了！"
                },
                {
                    "id": "736520102",
                    "speaker": "哈贾娜德",
                    "text": "来，向我细说「重熔片剂」的效果吧。"
                },
                {
                    "id": "736520103",
                    "speaker": "Player",
                    "text": "哈贾娜德真兴奋啊。"
                },
                {
                    "id": "736520104",
                    "speaker": "派蒙",
                    "text": "那我们要先说缺点哦，不怕打击你！"
                },
                {
                    "id": "736520105",
                    "speaker": "Black Screen",
                    "text": "向哈贾娜德详细说明了「重熔片剂」的缺点与优点。"
                },
                {
                    "id": "736520106",
                    "speaker": "哈贾娜德",
                    "text": "原来如此…我明白了。"
                },
                {
                    "id": "736520107",
                    "speaker": "哈贾娜德",
                    "text": "现在的爆炸无法精确控制混合的药量，所以效果不太稳定。"
                },
                {
                    "id": "736520108",
                    "speaker": "哈贾娜德",
                    "text": "还需要给小型炸药装上药罩，收束爆轰波，并且优化预置片剂的排列…"
                },
                {
                    "id": "736520109",
                    "speaker": "哈贾娜德",
                    "text": "嗯，完成改进需要的时间不长，问题在于资金…"
                },
                {
                    "id": "736520110",
                    "speaker": "哈贾娜德",
                    "text": "好在之前还留下了救急预算。接下来每天只吃一顿饭，再卖掉老旧的器材，应该是够用的。"
                },
                {
                    "id": "736520111",
                    "speaker": "派蒙",
                    "text": "每天只吃一顿饭？"
                },
                {
                    "id": "736520112",
                    "speaker": "派蒙",
                    "text": "不行不行，这种事怎么想都不能忍吧！你的资金明明不太够用，为什么不早说啊？"
                },
                {
                    "id": "736520113",
                    "speaker": "哈贾娜德",
                    "text": "哦，你们放心，给你们的报酬当然是不会少的，这笔预算最早就规划好了。"
                },
                {
                    "id": "736520114",
                    "speaker": "哈贾娜德",
                    "text": "我以前也经常只吃一顿饭，有的时候每个星期只吃三顿，早就习惯了，没问题的。"
                },
                {
                    "id": "736520115",
                    "speaker": "Player",
                    "text": "不用这么拼吧…"
                },
                {
                    "id": "736520116",
                    "speaker": "派蒙",
                    "text": "我还是很在意，一定要问清楚——"
                },
                {
                    "id": "736520117",
                    "speaker": "派蒙",
                    "text": "哈贾娜德小姐，你这么想当知名的学者，是为了什么呢？"
                },
                {
                    "id": "736520118",
                    "speaker": "派蒙",
                    "text": "是真的很喜欢学术研究吗？是想证明自己的才能？还是用炼金术赚很多很多摩拉？"
                },
                {
                    "id": "736520119",
                    "speaker": "哈贾娜德",
                    "text": "呃…"
                },
                {
                    "id": "736520120",
                    "speaker": "哈贾娜德",
                    "text": "突然这么问我，我也说不清…可能只是因为以前受过欺负，不甘心吧。"
                },
                {
                    "id": "736520121",
                    "speaker": "哈贾娜德",
                    "text": "如果我能证明自己的能力，就可以生活得更有余裕了。"
                },
                {
                    "id": "736520122",
                    "speaker": "派蒙",
                    "text": "为了这种理由…"
                },
                {
                    "id": "736520123",
                    "speaker": "Player",
                    "text": "你就开始学术研究了？"
                },
                {
                    "id": "736520124",
                    "speaker": "哈贾娜德",
                    "text": "对啊，在这个知识就是一切的国家，当然要靠学术能力来往上爬了。"
                },
                {
                    "id": "736520125",
                    "speaker": "哈贾娜德",
                    "text": "我没什么天赋，智商很平庸，只能选择很少有人研究的冷门学科，来全力做出点成果。"
                },
                {
                    "id": "736520126",
                    "speaker": "哈贾娜德",
                    "text": "一个人埋头搞研究太长时间，也不知道该怎么和别人相处了，染上了怪脾气…",
                    "choices": [
                        {
                            "id": "736520127",
                            "text": "世间还是好人居多的。",
                            "response": [
                                {
                                    "id": "736520129",
                                    "speaker": "派蒙",
                                    "text": "对哦，现在的你也有更厉害的目标了，可以生活得更大气一点！"
                                },
                                {
                                    "id": "736520130",
                                    "speaker": "派蒙",
                                    "text": "如果你抱着平常心，好好和别人说话，肯定还有很多人愿意帮你，和你一起搞研究的！"
                                },
                                {
                                    "id": "736520131",
                                    "speaker": "哈贾娜德",
                                    "text": "谢谢啦，这些道理我还是明白的。"
                                },
                                {
                                    "id": "736520132",
                                    "speaker": "哈贾娜德",
                                    "text": "我已经发现了，研究炼金术挺有趣的，比考虑柴米油盐和人情世故要轻松多了。"
                                },
                                {
                                    "id": "736520133",
                                    "speaker": "哈贾娜德",
                                    "text": "遇见你们以后，我也反省过自己，我确实应该好好收拾一下情绪了。"
                                },
                                {
                                    "id": "736520134",
                                    "speaker": "哈贾娜德",
                                    "text": "总之，多谢你们帮我试验「重熔片剂」，我该回城里去写论文了。"
                                },
                                {
                                    "id": "736520135",
                                    "speaker": "哈贾娜德",
                                    "text": "除了说好的报酬，这个也送给你们。"
                                },
                                {
                                    "id": "736520136",
                                    "speaker": "Player",
                                    "text": "这个是？"
                                },
                                {
                                    "id": "736520137",
                                    "speaker": "哈贾娜德",
                                    "text": "我最好的炼金釜，以前花了不少积蓄买下来，结果一直没舍得用。"
                                },
                                {
                                    "id": "736520138",
                                    "speaker": "派蒙",
                                    "text": "喂！你怎么突然连自己最宝贵的工具都不要了？"
                                },
                                {
                                    "id": "736520139",
                                    "speaker": "哈贾娜德",
                                    "text": "「重熔片剂」和传统药剂不一样，需要用我全新设计的器材来制作，所以我也用不到这个炼金釜了。"
                                },
                                {
                                    "id": "736520140",
                                    "speaker": "哈贾娜德",
                                    "text": "毕竟，给你们的报酬里，还有一个承诺呢，就把这个炼金釜当成见证物好了。"
                                },
                                {
                                    "id": "736520141",
                                    "speaker": "哈贾娜德",
                                    "text": "你们也可以试试用它…煮茶或者熬汤？它有促进萃取的功能，煮出来的汤汁应该挺好喝的！"
                                },
                                {
                                    "id": "736520142",
                                    "speaker": "派蒙",
                                    "text": "既然你都这么说了…我们也不好拒绝。"
                                },
                                {
                                    "id": "736520143",
                                    "speaker": "Player",
                                    "text": "加油啊，哈贾娜德。"
                                },
                                {
                                    "id": "736520144",
                                    "speaker": "哈贾娜德",
                                    "text": "当然！等着我的好消息吧！"
                                },
                                {
                                    "id": "736520145",
                                    "speaker": "Black Screen",
                                    "text": "哈贾娜德离开了。"
                                },
                                {
                                    "id": "736520146",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你说…"
                                },
                                {
                                    "id": "736520147",
                                    "speaker": "派蒙",
                                    "text": "这次我们算是做了一件好事吧？",
                                    "choices": [
                                        {
                                            "id": "736520148",
                                            "text": "只是冒险的日常罢了。",
                                            "response": [
                                                {
                                                    "id": "736520150",
                                                    "speaker": "派蒙",
                                                    "text": "说得也是呢，现在还不急着下定论。"
                                                },
                                                {
                                                    "id": "736520151",
                                                    "speaker": "派蒙",
                                                    "text": "没准等到我们都忘了这件事的那天，突然听到消息，哈贾娜德当上了学者，邀请我们去看望她…"
                                                },
                                                {
                                                    "id": "736520152",
                                                    "speaker": "派蒙",
                                                    "text": "不瞎想了，走吧走吧。我要试试用这个炼金釜煮茶！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736520149",
                                            "text": "我们也要抱着平常心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736520128",
                            "text": "不必拘泥于过去的事。"
                        }
                    ]
                }
            ]
        }
    ]
}