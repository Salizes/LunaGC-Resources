    "talks": [
        {
            "id": "7616503",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7616501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761650101",
                    "speaker": "派蒙",
                    "text": "唔…看起来是执灯人的墓碑呢。难道是我们在峡谷里见到的那群执灯士们的？"
                },
                {
                    "id": "761650102",
                    "speaker": "派蒙",
                    "text": "他们忽闪忽闪的，突然出现又消失。"
                },
                {
                    "id": "761650103",
                    "speaker": "派蒙",
                    "text": "唔，真是搞不懂。下次去皮拉米达城问问吧！说不定那边有人知道这件事。"
                }
            ]
        },
        {
            "id": "7616502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761650201",
                    "speaker": "帕托利切夫",
                    "text": "哦，您好，我是帕托利切夫，执灯人物资事务官。您有何贵干？"
                },
                {
                    "id": "761650202",
                    "speaker": "Player",
                    "text": "「凛风之马」的帕托利切夫？"
                },
                {
                    "id": "761650203",
                    "speaker": "派蒙",
                    "text": "「凛风之马」…啊，就是之前我们看到那些奇怪的影子…"
                },
                {
                    "id": "761650204",
                    "speaker": "帕托利切夫",
                    "text": "#是的，{M#先生}{F#小姐}，那是我从前隶属的分队。「凛风之马」，真是让人怀念的名字，没想到居然会从您口中说出…您是怎么…",
                    "choices": [
                        {
                            "id": "761650205",
                            "text": "我们之前去过苦壑崖下。",
                            "response": [
                                {
                                    "id": "761650206",
                                    "speaker": "派蒙",
                                    "text": "没错没错，我们清理了那边出现的狂猎。"
                                },
                                {
                                    "id": "761650207",
                                    "speaker": "派蒙",
                                    "text": "而且我们还看到了「凛风之马」的执灯士，和狂猎战斗留下的影子…"
                                },
                                {
                                    "id": "761650210",
                                    "speaker": "帕托利切夫",
                                    "text": "没想到居然是真的…"
                                },
                                {
                                    "id": "761650211",
                                    "speaker": "派蒙",
                                    "text": "当然是真的，我们可是亲眼看到的！"
                                },
                                {
                                    "id": "761650212",
                                    "speaker": "帕托利切夫",
                                    "text": "啊…这些年，时不时有人告诉我，在苦壑崖看到过我已然牺牲的那些同僚的身影。所以直到现在，我也经常会到那去…顺便给他们扫扫墓。"
                                },
                                {
                                    "id": "761650213",
                                    "speaker": "帕托利切夫",
                                    "text": "但是我一次也没有…我一次也没有看到过他们，已经很久了，我以为那些不过是为了宽慰我而编造的谎话…"
                                },
                                {
                                    "id": "761650214",
                                    "speaker": "帕托利切夫",
                                    "text": "没想到你们真的见到了他们…可为什么我去的时候，他们都不愿意出来见我呢？",
                                    "choices": [
                                        {
                                            "id": "761650215",
                                            "text": "或许还未到相见的时刻…",
                                            "response": [
                                                {
                                                    "id": "761650216",
                                                    "speaker": "帕托利切夫",
                                                    "text": "也许吧…但我知道他们真的在那，哪怕只是一丝回忆，一抹虚影，对我来说也已经足够…"
                                                },
                                                {
                                                    "id": "761650219",
                                                    "speaker": "帕托利切夫",
                                                    "text": "#总之，感谢您，{M#先生}{F#小姐}，感谢您愿意告诉我，这对我来说真的很重要。"
                                                },
                                                {
                                                    "id": "761650220",
                                                    "speaker": "帕托利切夫",
                                                    "text": "托他们的福，我现在才能站在此处，但我无比希望我能再次跟他们一同站在苦壑崖下，并肩作战。"
                                                },
                                                {
                                                    "id": "761650221",
                                                    "speaker": "帕托利切夫",
                                                    "text": "…总有一日，总有一日我会与他们再会的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761650217",
                                            "text": "也许并不想让你回忆起痛苦…",
                                            "response": [
                                                {
                                                    "id": "761650218",
                                                    "speaker": "帕托利切夫",
                                                    "text": "唉…与他们并肩作战直到最后的那段时间，怎么会是痛苦的呢…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761650208",
                            "text": "我们看到了「凛风之马」的执灯士…",
                            "response": [
                                {
                                    "id": "761650209",
                                    "speaker": "派蒙",
                                    "text": "没错，虽然他们只留下了一些影子…不过那些影子也保留着他们和狂猎作战的样子…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}