    "talks": [
        {
            "id": "1104501",
            "objective": "前往智能实验的地点",
            "dialogues": [
                {
                    "id": "110450101",
                    "speaker": "阿贝多",
                    "text": "想必在旅行的过程中，你也遇到过很多的谜题。"
                },
                {
                    "id": "110450102",
                    "speaker": "阿贝多",
                    "text": "和体能测试类似，我想通过实验观察你的智能水平。",
                    "choices": [
                        {
                            "id": "110450103",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "110450105",
                                    "speaker": "阿贝多",
                                    "text": "我希望你能探索一番这里的遗迹，之后给我你所得到的答案。"
                                },
                                {
                                    "id": "110450106",
                                    "speaker": "阿贝多",
                                    "text": "在这遗迹的两侧，各有一处谜题，完成之后，应该就可以启动中央的机关了。"
                                },
                                {
                                    "id": "110450107",
                                    "speaker": "阿贝多",
                                    "text": "还是像体能测试那样，不限制方式，你所做的一切都是我想要观察的内容。",
                                    "choices": [
                                        {
                                            "id": "110450108",
                                            "text": "这种事很熟悉了。",
                                            "response": [
                                                {
                                                    "id": "110450109",
                                                    "speaker": "阿贝多",
                                                    "text": "不愧是经验老道的冒险家。"
                                                },
                                                {
                                                    "id": "110450112",
                                                    "speaker": "阿贝多",
                                                    "text": "那么，就看你表现了。先去哪一边，都由你来决定。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110450110",
                                            "text": "试试看总会有办法。",
                                            "response": [
                                                {
                                                    "id": "110450111",
                                                    "speaker": "阿贝多",
                                                    "text": "别忘了这是智能测试，运气并不在测试内容中哦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110450104",
                            "text": "这种说法是不是怪怪的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104502",
            "objective": "破解附近的机关",
            "dialogues": [
                {
                    "id": "110450201",
                    "speaker": "阿贝多",
                    "text": "看起来是和元素方碑关联的谜题。"
                }
            ]
        },
        {
            "id": "1104508",
            "objective": "(test)遗迹玩法-解谜部分2_1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104506",
            "objective": "(test)遗迹玩法-解谜部分2_2$HIDDEN",
            "dialogues": [
                {
                    "id": "110450601",
                    "speaker": "阿贝多",
                    "text": "这样的仙灵，在雪山上很常见。"
                }
            ]
        },
        {
            "id": "1104509",
            "objective": "破解附近的机关",
            "dialogues": []
        },
        {
            "id": "1104511",
            "objective": "(test)遗迹玩法-解谜总进度$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104510",
            "objective": "(test)回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104507",
            "objective": "回到中央，启动装置",
            "dialogues": []
        },
        {
            "id": "1104503",
            "objective": "击败来袭的怪物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104504",
            "objective": "调查排水之后的区域",
            "dialogues": [
                {
                    "id": "110450461",
                    "speaker": "阿贝多",
                    "text": "这是…",
                    "choices": [
                        {
                            "id": "110450462",
                            "text": "不认识的图案。",
                            "response": [
                                {
                                    "id": "110450401",
                                    "speaker": "阿贝多",
                                    "text": "据我所知，这个是一种文字，虽然遍布提瓦特大陆，但又谜团重重。"
                                },
                                {
                                    "id": "110450402",
                                    "speaker": "阿贝多",
                                    "text": "无法理解的地方还有很多，而且，为什么要将这几个符文留在这里，也很奇怪。"
                                },
                                {
                                    "id": "110450403",
                                    "speaker": "阿贝多",
                                    "text": "总之，我先将它抄录下来，等对你的研究结束之后，我会抽时间看看的。"
                                },
                                {
                                    "id": "110450404",
                                    "speaker": "派蒙",
                                    "text": "唉，又是看不懂的东西。我完全不知道这些很奇怪的问题和实验，能得到什么结果…"
                                },
                                {
                                    "id": "110450405",
                                    "speaker": "派蒙",
                                    "text": "但看来想要赚取报酬，都要付出与之对应的代价啊。"
                                },
                                {
                                    "id": "110450406",
                                    "speaker": "阿贝多",
                                    "text": "这次我实在是收获了很多很多，相较于此，提供微不足道的报酬，实在是不足挂齿的事。"
                                },
                                {
                                    "id": "110450407",
                                    "speaker": "阿贝多",
                                    "text": "我先回之前的营地去了，等你们回来的时候，我应该能让你们见证一个奇妙的瞬间。",
                                    "choices": [
                                        {
                                            "id": "110450408",
                                            "text": "那就待会儿见了。",
                                            "response": [
                                                {
                                                    "id": "110450410",
                                                    "speaker": "派蒙",
                                                    "text": "其实我还是挺期待这么折腾一番之后，能有什么样的结果…"
                                                },
                                                {
                                                    "id": "110450411",
                                                    "speaker": "派蒙",
                                                    "text": "如果没有什么事的话，我们也回营地去吧。"
                                                },
                                                {
                                                    "id": "110450412",
                                                    "speaker": "派蒙",
                                                    "text": "(test)阿贝多离场"
                                                },
                                                {
                                                    "id": "110450413",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "别着急离开，在我排除掉所有危险之前。"
                                                },
                                                {
                                                    "id": "110450414",
                                                    "speaker": "派蒙",
                                                    "text": "啊？是你！原来你没有离开雪山吗？"
                                                },
                                                {
                                                    "id": "110450415",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "当然，你们和阿贝多做的一切，我都看在眼里。"
                                                },
                                                {
                                                    "id": "110450416",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "该说你是没有戒备心好呢，还是被他独特的思维模式，还有友善的态度欺骗了呢？",
                                                    "choices": [
                                                        {
                                                            "id": "110450417",
                                                            "text": "出什么事了？",
                                                            "response": [
                                                                {
                                                                    "id": "110450419",
                                                                    "speaker": "罗莎莉亚",
                                                                    "text": "听从陌生人的指示行动，喝下完全来历不明的药水，参加了诸多结果不明的实验。"
                                                                },
                                                                {
                                                                    "id": "110450420",
                                                                    "speaker": "罗莎莉亚",
                                                                    "text": "比起单纯，我更愿意相信你是被欺骗，或者说…从一开始就串通好了。"
                                                                },
                                                                {
                                                                    "id": "110450421",
                                                                    "speaker": "派蒙",
                                                                    "text": "果然是戒备心很强的修女啊。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110450422",
                                                                            "text": "我只是在帮助他的研究。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110450424",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "无所谓，阿贝多的事怎么都好，我对他的了解，还是比你这样的外乡人要多一些。"
                                                                                },
                                                                                {
                                                                                    "id": "110450425",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "我关心的只有一件事，就是你是否已经被炼金术改造，变成了无法理解的怪物。"
                                                                                },
                                                                                {
                                                                                    "id": "110450426",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不会吧？！我完全没有察觉到！而且，一路上他好像就没有怎么用过炼金术…"
                                                                                },
                                                                                {
                                                                                    "id": "110450427",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "像他这种级别的炼金术士，想要动点手脚，你当然察觉不到。"
                                                                                },
                                                                                {
                                                                                    "id": "110450428",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "总之，我是不会把任何的威胁放回蒙德的。"
                                                                                },
                                                                                {
                                                                                    "id": "110450429",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那、那你想怎么办？"
                                                                                },
                                                                                {
                                                                                    "id": "110450430",
                                                                                    "speaker": "Player",
                                                                                    "text": "你是来确定的，你就有办法确定。"
                                                                                },
                                                                                {
                                                                                    "id": "110450431",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "这方面脑子倒是挺灵光的。只要能确定你们接触过的所有东西都没有危险，你们也就没有危险了。"
                                                                                },
                                                                                {
                                                                                    "id": "110450432",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "其他东西的调查我已经完成了，现在唯独没有确认的，就是这些符文。"
                                                                                },
                                                                                {
                                                                                    "id": "110450433",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这些符文，我们连看都看不懂。"
                                                                                },
                                                                                {
                                                                                    "id": "110450451",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "我知道，而且…嗯，似乎也只是符文，并不是机关。"
                                                                                },
                                                                                {
                                                                                    "id": "110450452",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "但保险起见，还是抄录下来…唔，还要把这里作为重要地点，定期巡视。"
                                                                                },
                                                                                {
                                                                                    "id": "110450434",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "行吧，既然这样，你们就应该没有危险了。"
                                                                                },
                                                                                {
                                                                                    "id": "110450435",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "这也是我希望的情况，要是因为你们让我加班，我就亏大了。"
                                                                                },
                                                                                {
                                                                                    "id": "110450436",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "加、加班？"
                                                                                },
                                                                                {
                                                                                    "id": "110450437",
                                                                                    "speaker": "罗莎莉亚",
                                                                                    "text": "再见之前，忠告你一句，外乡人。别太信任阿贝多了，至少别像这次一样，干这么多不经考虑的事。"
                                                                                },
                                                                                {
                                                                                    "id": "110450439",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "她走了，真我行我素啊。"
                                                                                },
                                                                                {
                                                                                    "id": "110450440",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "在蒙德，像她这样的人还真是少见。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110450441",
                                                                                            "text": "或许只是没有安全感吧。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110450443",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯，不管她了，我们回去见阿贝多吧！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110450442",
                                                                                            "text": "或许只是有点敏感吧。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110450423",
                                                                            "text": "我不认为他是坏人。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110450418",
                                                            "text": "他别有所图？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110450409",
                                            "text": "看来我的智能没出什么问题。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110450463",
                            "text": "总觉得在什么地方见过。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104505",
            "objective": "返回营地，获取阿贝多的结论",
            "dialogues": [
                {
                    "id": "110450501",
                    "speaker": "阿贝多",
                    "text": "你们回来了，正好这里差不多有结论了。"
                },
                {
                    "id": "110450502",
                    "speaker": "阿贝多",
                    "text": "不过你们好像花了挺多时间的，难道是路上发生了什么吗？",
                    "choices": [
                        {
                            "id": "110450503",
                            "text": "没什么。",
                            "response": [
                                {
                                    "id": "110450506",
                                    "speaker": "阿贝多",
                                    "text": "还是来说结论吧，今天获得了海量的数据，很难一次性将研究全部完成。"
                                },
                                {
                                    "id": "110450507",
                                    "speaker": "阿贝多",
                                    "text": "但可以给你一个整体性的初步结论，那就是——你非常像这个世界的人类。",
                                    "choices": [
                                        {
                                            "id": "110450508",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "110450510",
                                                    "speaker": "派蒙",
                                                    "text": "这一眼就能看出来的吧！"
                                                },
                                                {
                                                    "id": "110450511",
                                                    "speaker": "派蒙",
                                                    "text": "我们辛辛苦苦跟你做了这么多，结果换来的就是这个吗？"
                                                },
                                                {
                                                    "id": "110450512",
                                                    "speaker": "阿贝多",
                                                    "text": "别急，别急，可能对你们来说，觉得是理所当然，但其实这个世界上没有理所当然的事。"
                                                },
                                                {
                                                    "id": "110450513",
                                                    "speaker": "阿贝多",
                                                    "text": "你们有考虑过这种可能吗？提瓦特这个世界，对外来者持有天然的拒绝态度。",
                                                    "choices": [
                                                        {
                                                            "id": "110450514",
                                                            "text": "答案在神那里。",
                                                            "response": [
                                                                {
                                                                    "id": "110450516",
                                                                    "speaker": "阿贝多",
                                                                    "text": "我提起过这个世界的法则，你能安然无恙地在这里与我对话，看起来平常，但其实是奇迹也说不定。"
                                                                },
                                                                {
                                                                    "id": "110450517",
                                                                    "speaker": "阿贝多",
                                                                    "text": "因为，和你一样远道而来的生命，就是我之前提到过的种子，在提瓦特的法则作用下，甚至没办法正常地生长开花。"
                                                                },
                                                                {
                                                                    "id": "110450518",
                                                                    "speaker": "阿贝多",
                                                                    "text": "可是，在观察过你之后，我有了其他的想法。"
                                                                },
                                                                {
                                                                    "id": "110450519",
                                                                    "speaker": "阿贝多",
                                                                    "text": "模仿你的生命，为炼金术加入我的新灵感，然后——"
                                                                },
                                                                {
                                                                    "id": "110450520",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇，好像，好像有什么要出来了！"
                                                                },
                                                                {
                                                                    "id": "110450521",
                                                                    "speaker": "阿贝多",
                                                                    "text": "从无到有，从萌芽到繁盛，再到终结。"
                                                                },
                                                                {
                                                                    "id": "110450522",
                                                                    "speaker": "阿贝多",
                                                                    "text": "培育不属于这个世界的生命，难道不是在培育世界吗？"
                                                                },
                                                                {
                                                                    "id": "110450523",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110450524",
                                                                            "text": "好漂亮。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110450526",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "唉，看来这就是极限了。只能盛开一瞬却无比美丽的花朵，生命的极致也在于此。"
                                                                                },
                                                                                {
                                                                                    "id": "110450527",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我以为我们付出了那么多，它可以永远盛开下去。而且好像也没结出什么果子…"
                                                                                },
                                                                                {
                                                                                    "id": "110450528",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "生命是多种多样的自由之物，不应以长短定义优劣，哪怕只绽放一刹那…"
                                                                                },
                                                                                {
                                                                                    "id": "110450529",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "短暂的生命也未必是坏事。高效，完美，意味着不会被孤独所困扰。"
                                                                                },
                                                                                {
                                                                                    "id": "110450530",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "所以，你能明白吗？我刚刚说的，「我们的交谈说不定是奇迹」这件事。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110450531",
                                                                                            "text": "至少我现在还没有凋零。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110450533",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "欸？为什么突然气氛变成这样了？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450534",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#嘿嘿，别没精打采的了，{NICKNAME}，你还有我啊。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450535",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "还有阿贝多，我很愿意跟你当朋友啦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450536",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "…谢谢你们。虽然我不认为排解孤独是生命的必要之举…但，也不坏。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450537",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "#{NICKNAME}，是你提供的帮助让我找到了灵感，发现了让它开花的可能性。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450538",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "作为「实验品」的帮助吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450539",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "不，与你们在雪山上同行的时光，也是一段很有价值的旅途。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450540",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "以后…如果还有需要的话，我还能请你们帮忙吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450541",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "不需要帮忙的时候，也可以找我。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450542",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "那…就拜托你了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450543",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "(test)主角离开，镜头切回阿贝多"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450544",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "#虽然一直在告诉{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}，说实验结果是「平凡」的…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450545",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "但这不该出现在瓶底的沉淀，又是怎么一回事呢？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450546",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "呼吸黑土则污秽，呼吸白垩则无垢。你与我一样，都是未来尚未完全确定的「质料」吧…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450547",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "如果有一天，失控的我要把蒙德…把一切都毁灭的话——"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110450548",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "可以期待你来阻止我吗？"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110450532",
                                                                                            "text": "#（不知道{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}现在怎么样了…）"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110450525",
                                                                            "text": "好短暂。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110450515",
                                                            "text": "或许吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110450509",
                                            "text": "就只是这样吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110450504",
                            "text": "被修女拦住了。",
                            "response": [
                                {
                                    "id": "110450505",
                                    "speaker": "阿贝多",
                                    "text": "那没关系，她只是在完成工作。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
