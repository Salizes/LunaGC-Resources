        {
            "id": "1104503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110450311",
                    "speaker": "阿贝多",
                    "text": "嗯？好像水位突然下降了？"
                },
                {
                    "id": "110450312",
                    "speaker": "阿贝多",
                    "text": "这样的话，就可以仔细调查水里的东西了，我们过去看看吧。"
                }
            ]
        },
        {
            "id": "1104506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110450602",
                    "speaker": "阿贝多",
                    "text": "#怎么样可以引导仙灵归位，就看你的了，{NICKNAME}。"
                },
                {
                    "id": "110450621",
                    "speaker": "蒂玛乌斯",
                    "text": "不好意思，研究出了很多问题，我埋头整理出来的很多推论，都和实验数据矛盾了。"
                },
                {
                    "id": "110450622",
                    "speaker": "蒂玛乌斯",
                    "text": "反倒是阿贝多先生凭直觉做出的几段推演，都契合了后来的事实。"
                },
                {
                    "id": "110450623",
                    "speaker": "蒂玛乌斯",
                    "text": "实验能有进展我很高兴，所以…呃，也算不上垂头丧气吧！阿贝多先生鼓励过我了！"
                },
                {
                    "id": "110450624",
                    "speaker": "蒂玛乌斯",
                    "text": "详细的实验结果，你们去问他吧，我要继续工作了。"
                }
            ]
        }
    ]
