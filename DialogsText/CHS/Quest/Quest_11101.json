            "objective": "前往「万文集舍」",
            "dialogues": []
        },
        {
            "id": "1110108",
            "objective": "(test)大仙买书$HIDDEN",
            "dialogues": [
                {
                    "id": "111010201",
                    "speaker": "纪芳",
                    "text": "就要这一本吗，《护法仙众夜叉录》？"
                },
                {
                    "id": "111010202",
                    "speaker": "掇星攫辰天君",
                    "text": "嗯，这些给你，不用找了。"
                },
                {
                    "id": "111010203",
                    "speaker": "纪芳",
                    "text": "老板阔气，阔气…谢谢惠顾！"
                },
                {
                    "id": "111010204",
                    "speaker": "派蒙",
                    "text": "这不是那位「多星缺辰天君」吗？怎么又在这里碰到了。",
                    "choices": [
                        {
                            "id": "111010205",
                            "text": "是「掇星攫辰天君」…",
                            "response": [
                                {
                                    "id": "111010207",
                                    "speaker": "派蒙",
                                    "text": "我好像听到他刚才买的书叫…《护法仙众夜叉录》？"
                                },
                                {
                                    "id": "111010208",
                                    "speaker": "派蒙",
                                    "text": "记得好像是一本关于仙人的书来着，仙人为什么会买有关自己的书呢？",
                                    "choices": [
                                        {
                                            "id": "111010209",
                                            "text": "我早就觉得他有些可疑…",
                                            "response": [
                                                {
                                                    "id": "111010210",
                                                    "speaker": "派蒙",
                                                    "text": "欸，是这样吗？你觉得哪里可疑啦？",
                                                    "choices": [
                                                        {
                                                            "id": "111010214",
                                                            "text": "仙人要那么多钱做什么？",
                                                            "response": [
                                                                {
                                                                    "id": "111010215",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊…说得也是，一般的仙人好像都是一脸无欲无求的样子。"
                                                                },
                                                                {
                                                                    "id": "111010220",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔……"
                                                                },
                                                                {
                                                                    "id": "111010221",
                                                                    "speaker": "派蒙",
                                                                    "text": "看起来有必要确认一下书的内容了，说不定可以抓住什么把柄！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "111010216",
                                                            "text": "感觉像是江湖骗子的套路。",
                                                            "response": [
                                                                {
                                                                    "id": "111010217",
                                                                    "speaker": "派蒙",
                                                                    "text": "你的意思是…其实他没有实现愿望的能力吗？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "111010218",
                                                            "text": "他的面具太丑了。",
                                                            "response": [
                                                                {
                                                                    "id": "111010219",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊！确实很丑！太可疑了！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111010211",
                                            "text": "是自恋吧？",
                                            "response": [
                                                {
                                                    "id": "111010212",
                                                    "speaker": "派蒙",
                                                    "text": "这么说也有道理！"
                                                },
                                                {
                                                    "id": "111010213",
                                                    "speaker": "派蒙",
                                                    "text": "不过仔细想想，这个仙人总觉得有些不对劲…",
                                                    "choices": [
                                                        {
                                                            "id": "111010214",
                                                            "text": "仙人要那么多钱做什么？"
                                                        },
                                                        {
                                                            "id": "111010216",
                                                            "text": "感觉像是江湖骗子的套路。"
                                                        },
                                                        {
                                                            "id": "111010218",
                                                            "text": "他的面具太丑了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111010206",
                            "text": "这就是「仙缘」吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110102",
            "objective": "与纪芳对话，询问《护法仙众夜叉录》的情况",
            "dialogues": [
                {
                    "id": "111010222",
                    "speaker": "派蒙",
                    "text": "你好，我们想要一本《护法仙众夜叉录》！"
                },
                {
                    "id": "111010223",
                    "speaker": "纪芳",
                    "text": "嗯？这种老书什么时候翻身成了畅销书了？"
                },
                {
                    "id": "111010224",
                    "speaker": "纪芳",
                    "text": "难得有年轻人喜欢，去书架那边自己找找吧。"
                }
            ]
        },
        {
            "id": "1110103",
            "objective": "找到《护法仙众夜叉录》",
            "dialogues": [
                {
                    "id": "111010301",
                    "speaker": "派蒙",
                    "text": "就是这一本！赶快打开看看讲的是什么吧？"
                },
                {
                    "id": "111010302",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "111010401",
                    "speaker": "派蒙",
                    "text": "读完了吗？派蒙比你先读完的，嘿嘿。"
                },
                {
                    "id": "111010402",
                    "speaker": "派蒙",
                    "text": "这是一本有关守护着璃月的「仙众夜叉」们的书。"
                }
            ]
        },
        {
            "id": "1110104",
            "objective": "(test)与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "111011401",
                    "speaker": "Player",
                    "text": "没什么其他值得注意的了…"
                },
                {
                    "id": "111011402",
                    "speaker": "派蒙",
                    "text": "嗯，书里的关键点，刚才都已经总结出来啦。"
                },
                {
                    "id": "111011403",
                    "speaker": "派蒙",
                    "text": "这么看，满身邪气的丘丘人的来源，还有「天君」与夜叉的关系，是这次事件的疑点呢！"
                },
                {
                    "id": "111011404",
                    "speaker": "派蒙",
                    "text": "有必要再回去确认一下现场了！让我们拨开绝云间的迷雾，直达那闪耀的真相吧！",
                    "choices": [
                        {
                            "id": "111011405",
                            "text": "这是什么侦探游戏吗…",
                            "response": [
                                {
                                    "id": "111011407",
                                    "speaker": "派蒙",
                                    "text": "欸嘿嘿，其实我还挺希望他是真正的仙人呀，而且，他驱魔的手艺好像是货真价实的。"
                                },
                                {
                                    "id": "111011408",
                                    "speaker": "派蒙",
                                    "text": "但是希望越大就可能失望越大嘛，所以提前调查清楚还是有必要的吧？"
                                },
                                {
                                    "id": "111011409",
                                    "speaker": "派蒙",
                                    "text": "我们走吧，再到望舒客栈那边去看看！"
                                }
                            ]
                        },
                        {
                            "id": "111011406",
                            "text": "你是不是太入戏了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110105",
            "objective": "回到望舒客栈附近，寻找「掇星攫辰天君」",
            "dialogues": [
                {
                    "id": "111010501",
                    "speaker": "掇星攫辰天君",
                    "text": "如我敕令，恶鬼退散！"
                },
                {
                    "id": "111010502",
                    "speaker": "掇星攫辰天君",
                    "text": "退散——！"
                },
                {
                    "id": "111010503",
                    "speaker": "掇星攫辰天君",
                    "text": "快，快退散哪？！"
                },
                {
                    "id": "111010504",
                    "speaker": "丘丘人",
                    "text": "Beru nye！Beru nya！Beru nyaaaa！！！"
                },
                {
                    "id": "111010505",
                    "speaker": "派蒙",
                    "text": "糟了，「天君」好像不管用了！"
                },
                {
                    "id": "111010506",
                    "speaker": "派蒙",
                    "text": "附近还有普通民众在，不能放手不管了，我们快去帮忙吧！"
                }
            ]
        },
        {
            "id": "1110106",
            "objective": "消灭沾染「邪气」的丘丘人",
            "dialogues": []
        },
        {
            "id": "1110107",
            "objective": "与「掇星攫辰天君」对话，了解情况",
            "dialogues": [
                {
                    "id": "111010701",
                    "speaker": "掇星攫辰天君",
                    "text": "怎么会的…「百无禁忌箓」怎么会没有效果呢…"
                },
                {
                    "id": "111010702",
                    "speaker": "掇星攫辰天君",
                    "text": "这些丘丘人身上的邪气又变强了吗…"
                },
                {
                    "id": "111010703",
                    "speaker": "派蒙",
                    "text": "「百无禁忌箓」…好像有点耳熟？",
                    "choices": [
                        {
                            "id": "111010704",
                            "text": "可以自由出入「绝云间」的那个…",
                            "response": [
                                {
                                    "id": "111010706",
                                    "speaker": "派蒙",
                                    "text": "对了，是那个！仙人的「信物」，上面一定残留着仙人的力量！"
                                },
                                {
                                    "id": "111010707",
                                    "speaker": "派蒙",
                                    "text": "怪不得他上次能用这个把怪物吓跑…"
                                },
                                {
                                    "id": "111010708",
                                    "speaker": "掇星攫辰天君",
                                    "text": "你、你们在念叨什么呢，这不过是本仙昨晚没睡好…仙力未能通达六脉而已！"
                                },
                                {
                                    "id": "111010709",
                                    "speaker": "掇星攫辰天君",
                                    "text": "如果再给我一次机会的话…"
                                },
                                {
                                    "id": "111010710",
                                    "speaker": "派蒙",
                                    "text": "又有「邪恶丘丘人」往那边去了，那这次可以交给你么？"
                                },
                                {
                                    "id": "111010711",
                                    "speaker": "掇星攫辰天君",
                                    "text": "我…本、本仙忽然觉得身体有恙，定是方才仙力耗损太多所致，不然我必斩尽这些妖邪…"
                                },
                                {
                                    "id": "111010712",
                                    "speaker": "派蒙",
                                    "text": "唉…果然是吹牛大王，没有错怪你。"
                                },
                                {
                                    "id": "111010713",
                                    "speaker": "派蒙",
                                    "text": "旅行者，还是我们追上去看看吧，用「元素视野」可以方便追踪哦。"
                                }
                            ]
                        },
                        {
                            "id": "111010705",
                            "text": "原来他是在用它驱魔…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110020",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111002001",
                    "speaker": "男性信众",
                    "text": "家里还有些值钱物件，若「天君」不嫌弃，明天也给您拿来。"
                }
            ]
        },
        {
            "id": "1110021",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111002101",
                    "speaker": "女性信众",
                    "text": "有「星辰天君」在，当然放心…"
                }
            ]
        },
        {
            "id": "1110022",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111002201",
                    "speaker": "商人信众",
                    "text": "还望「天君」多多照顾…"
                }
            ]
        },
        {
            "id": "1110110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111011001",
                    "speaker": "派蒙",
                    "text": "感觉在璃月的史料里属于冷门的一派呢，有什么值得注意的地方吗？"
                }
            ]
        },
        {
            "id": "1110111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111011101",
                    "speaker": "Player",
                    "text": "关于「妖邪」…"
                },
                {
                    "id": "111011102",
                    "speaker": "派蒙",
                    "text": "书里讲的是，「魔神战争」时期战败魔神的怨念，可能会产生瘟疫、鬼怪与异变…"
                },
                {
                    "id": "111011103",
                    "speaker": "派蒙",
                    "text": "都是些不得了的灾难呢——咦？难道说…"
                },
                {
                    "id": "111011104",
                    "speaker": "派蒙",
                    "text": "之前看到的那些满身邪气的丘丘人，该不会就是这里所说的「异变」吧？"
                }
            ]
        },
        {
            "id": "1110112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111011201",
                    "speaker": "Player",
                    "text": "关于「业障」…"
                },
                {
                    "id": "111011202",
                    "speaker": "派蒙",
                    "text": "书中说，与魔神怨念斗争了千年的「夜叉」们，也会被「业障」所困。"
                },
                {
                    "id": "111011203",
                    "speaker": "派蒙",
                    "text": "被魔神怨念污染的夜叉，常常会陷入难以言喻的恐惧、狂怒和痛苦…"
                },
                {
                    "id": "111011204",
                    "speaker": "派蒙",
                    "text": "唉…辛苦守护璃月上千年，不仅没有回报，还要忍受这样的折磨，真是太可怜啦。"
                }
            ]
        },
        {
            "id": "1110113",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111011301",
                    "speaker": "Player",
                    "text": "关于「最后一位夜叉」…"
                },
                {
                    "id": "111011302",
                    "speaker": "派蒙",
                    "text": "嗯，据说一共有五位「夜叉」，如今仅剩一位存活。"
                },
                {
                    "id": "111011303",
                    "speaker": "派蒙",
                    "text": "该不会…跟那个「天君」有什么瓜葛吧？"
                },
                {
                    "id": "111011304",
                    "speaker": "派蒙",
                    "text": "但怎么想都不是他本人，毕竟他看起来一点也不像长期忍受折磨的样子…"
                }
            ]
        },
        {
            "id": "1110123",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111012301",
                    "speaker": "掇星攫辰天君",
                    "text": "各位也都是一样…只要意思到了，愿望定会实现，大可放心。"
                }
            ]
        }
    ]
}