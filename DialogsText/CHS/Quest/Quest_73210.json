    "talks": [
        {
            "id": "7321004",
            "objective": "(test)打开锁住的抽屉$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7321005",
            "objective": "(test)交付后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732100501",
                    "speaker": "派蒙",
                    "text": "嗯…不知道这里会有什么宝藏呢？"
                },
                {
                    "id": "732100502",
                    "speaker": "Black Screen",
                    "text": "柜子中放满了簿册，你们翻了翻，似乎是病历卡和账务记录之类的医院文件。\\n失望地关上了柜子。"
                },
                {
                    "id": "732100503",
                    "speaker": "派蒙",
                    "text": "哼，我还以为里头有什么特别的宝藏呢…还不如我们平时冒险的时候，见到的木桶木箱呢！里面起码还有卷心菜和禽肉…"
                },
                {
                    "id": "732100504",
                    "speaker": "派蒙",
                    "text": "欸，这是什么？好像从里头掉出来的…"
                },
                {
                    "id": "732100505",
                    "speaker": "派蒙",
                    "text": "我看看…说不定有宝藏的线索…"
                },
                {
                    "id": "732100507",
                    "speaker": "派蒙",
                    "text": "呜哇，「魔鳞病」看起来好可怕…"
                },
                {
                    "id": "732100508",
                    "speaker": "派蒙",
                    "text": "另一份文件上写了什么呢…？"
                },
                {
                    "id": "732100510",
                    "speaker": "派蒙",
                    "text": "嗯…完全没看懂！"
                },
                {
                    "id": "732100511",
                    "speaker": "派蒙",
                    "text": "我也没看懂…"
                },
                {
                    "id": "732100512",
                    "speaker": "派蒙",
                    "text": "我只看懂了什么「神的声音引导」…难道这里真的会出现奇特的声音，引导人吗？"
                },
                {
                    "id": "732100515",
                    "speaker": "Player",
                    "text": "可能是「地下水脉或生物活动」…"
                },
                {
                    "id": "732100516",
                    "speaker": "派蒙",
                    "text": "嗯！确实，说不定地下有什么遗迹呢！如果注意到什么声音，我们就去看看吧！"
                }
            ]
        },
