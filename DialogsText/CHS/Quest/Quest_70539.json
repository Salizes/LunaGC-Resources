    "talks": [
        {
            "id": "7053901",
            "objective": "前往猫尾酒馆门口",
            "dialogues": [
                {
                    "id": "705390101",
                    "speaker": "派蒙",
                    "text": "咦，玛格丽特老板好像在和那两个人说什么事？"
                },
                {
                    "id": "705390102",
                    "speaker": "派蒙",
                    "text": "等等，是罗莎莉亚？她身边有个不认识的冒险家？",
                    "choices": [
                        {
                            "id": "705390103",
                            "text": "罗莎莉亚也来和猫猫玩？",
                            "response": [
                                {
                                    "id": "705390105",
                                    "speaker": "罗莎莉亚",
                                    "text": "嗯，不用多说了，瓦乐瑞娜。我会按照维多利亚的要求，继续为你提供帮助的。"
                                },
                                {
                                    "id": "705390106",
                                    "speaker": "罗莎莉亚",
                                    "text": "给猫看个病，洗个澡，都是小事。"
                                },
                                {
                                    "id": "705390107",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "关键的问题还没解决吧，罗莎莉亚小姐！要是我们两个和猫猫再不拉近一点距离，让它们一直紧张兮兮…"
                                },
                                {
                                    "id": "705390108",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "猫猫们肯定会得病的，「猫茸茸城堡」开不了几天就要垮掉了！"
                                },
                                {
                                    "id": "705390109",
                                    "speaker": "罗莎莉亚",
                                    "text": "我劝你少担心，少慌张，都没用的。处不来是客观事实，我不能给你变出办法来。"
                                },
                                {
                                    "id": "705390110",
                                    "speaker": "派蒙",
                                    "text": "罗莎莉亚，还有这位冒险家小姐，你们好啊！"
                                },
                                {
                                    "id": "705390111",
                                    "speaker": "派蒙",
                                    "text": "听起来，你们好像在为什么事情烦恼？"
                                },
                                {
                                    "id": "705390112",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "猫猫救星！你们这么快就出现了！"
                                },
                                {
                                    "id": "705390113",
                                    "speaker": "派蒙",
                                    "text": "欸…一见面就叫我们救星，好突然！",
                                    "choices": [
                                        {
                                            "id": "705390114",
                                            "text": "有敬称，就有对应的责任！",
                                            "response": [
                                                {
                                                    "id": "705390116",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "长话短说！我叫瓦乐瑞娜，很喜欢小动物，最近正在全力建立专门的流浪猫收养所「猫茸茸城堡」。"
                                                },
                                                {
                                                    "id": "705390117",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "我认为，收养无家可归的小家伙们，既能将它们从不幸的命运中拯救出来，又能改善蒙德的生态和市容问题，一举两得！"
                                                },
                                                {
                                                    "id": "705390118",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "教会的修女们听说了我的咨询后，派出了好心的罗莎莉亚小姐支援我。"
                                                },
                                                {
                                                    "id": "705390119",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "不是好心，只是受维多利亚所托。谁让最近略懂医术、又有空闲的修女只剩我了呢。"
                                                },
                                                {
                                                    "id": "705390120",
                                                    "speaker": "派蒙",
                                                    "text": "好干练的冒险家，思路清晰，概括能力也很强！"
                                                },
                                                {
                                                    "id": "705390121",
                                                    "speaker": "派蒙",
                                                    "text": "那你们遇到的麻烦是…摩拉不够吗？还是缺什么东西？"
                                                },
                                                {
                                                    "id": "705390122",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "我很有钱！摩拉、场地、相关物资和规章流程的问题，统统都搞定了！"
                                                },
                                                {
                                                    "id": "705390123",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "现在的主要问题是…噫噫呃呃…猫猫总是打我。"
                                                },
                                                {
                                                    "id": "705390124",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "不管我用什么姿势接近它们，它们都会凶我…拿着好吃的都不行。"
                                                },
                                                {
                                                    "id": "705390125",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "猫也很怕我，我站在附近，它们就会逃走。"
                                                },
                                                {
                                                    "id": "705390126",
                                                    "speaker": "派蒙",
                                                    "text": "呃啊，好像听说过这样的传闻，有些人的体质生来就会让猫绕着走…"
                                                },
                                                {
                                                    "id": "705390127",
                                                    "speaker": "派蒙",
                                                    "text": "不过，收养猫猫的好心人，却和猫猫不合拍…别说管理收养所了，就算去猫尾酒馆，也会手忙脚乱吧…"
                                                },
                                                {
                                                    "id": "705390128",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "所以我们才咨询了这方面的专家，可是玛格丽特小姐自己也概括不了诀窍，她店里的人手又不多，帮不了我们…"
                                                },
                                                {
                                                    "id": "705390129",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "玛格丽特小姐说，「遇到这种难题，只要拜托荣誉骑士和白色小帮手，肯定没错！」"
                                                },
                                                {
                                                    "id": "705390130",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "结果我们刚刚聊完，你们就出现了，简直就像巴巴托斯大人派来的使者，正宗的救星！"
                                                },
                                                {
                                                    "id": "705390131",
                                                    "speaker": "派蒙",
                                                    "text": "先不说巴巴托斯懂不懂照顾猫啦，我们也没有管理收养所的经验，结果突然就变成救星了…",
                                                    "choices": [
                                                        {
                                                            "id": "705390132",
                                                            "text": "这个称号不是来得正好？",
                                                            "response": [
                                                                {
                                                                    "id": "705390134",
                                                                    "speaker": "派蒙",
                                                                    "text": "这倒没错！单论和猫猫搞好关系，我倒是很有信心！"
                                                                },
                                                                {
                                                                    "id": "705390135",
                                                                    "speaker": "派蒙",
                                                                    "text": "感觉这个问题并不难办嘛，只要向瓦乐瑞娜和罗莎莉亚演示怎么和猫猫搞好关系，就不用担心啦！"
                                                                },
                                                                {
                                                                    "id": "705390136",
                                                                    "speaker": "罗莎莉亚",
                                                                    "text": "我倒是没什么所谓，你们多教教瓦乐瑞娜吧，遇到需要救治小家伙的情况再叫我。"
                                                                },
                                                                {
                                                                    "id": "705390137",
                                                                    "speaker": "罗莎莉亚",
                                                                    "text": "总之，你们能让收养所稳定运营下去，不需要我费什么力的话…"
                                                                },
                                                                {
                                                                    "id": "705390138",
                                                                    "speaker": "罗莎莉亚",
                                                                    "text": "我不介意继续干这份清闲的差事，起码比教会的其他活动省心多了。"
                                                                },
                                                                {
                                                                    "id": "705390139",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸，原来只是想翘掉教会的班而已吗…"
                                                                },
                                                                {
                                                                    "id": "705390140",
                                                                    "speaker": "瓦乐瑞娜",
                                                                    "text": "那就先请两位这边走，我们现在就去「猫茸茸城堡」看看！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705390133",
                                                            "text": "我们本来就想和猫猫玩。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705390115",
                                            "text": "这种时候，肯定会有委托！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705390104",
                            "text": "罗莎莉亚也来酒馆打牌？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053902",
            "objective": "前往「猫茸茸城堡」",
            "dialogues": [
                {
                    "id": "705390201",
                    "speaker": "派蒙",
                    "text": "虽然名字叫「城堡」，但其实也只是一间普通的房子而已嘛。"
                },
                {
                    "id": "705390202",
                    "speaker": "瓦乐瑞娜",
                    "text": "这已经是近来城里最大的空房了。好在租金倒也不贵，半年租金加上猫尾酒馆风格的全套装潢，也只花了几百万摩拉。"
                },
                {
                    "id": "705390203",
                    "speaker": "瓦乐瑞娜",
                    "text": "按照计划，我们还会挑选健康状况良好的猫猫，开放领养认证。只要客人们证明自己会好好对待猫猫，就能将合拍的猫猫带回家。"
                },
                {
                    "id": "705390204",
                    "speaker": "瓦乐瑞娜",
                    "text": "这个场地肯定是够用的，说不定以后还能扩大经营范围，收养流浪狗，流浪狐狸和流浪松鼠！到时候就要改名「毛茸茸城堡」啦！"
                },
                {
                    "id": "705390205",
                    "speaker": "罗莎莉亚",
                    "text": "前提是你的计划顺利执行，客人们和流浪猫也足够合拍。"
                },
                {
                    "id": "705390206",
                    "speaker": "派蒙",
                    "text": "咦？快看快看，这只猫猫好像在等我们呢…"
                },
                {
                    "id": "705390207",
                    "speaker": "瓦乐瑞娜",
                    "text": "啊呀，是这只小白猫！它特别怕人，我们给它洗澡的时候，它还逃走了，花了半天才找回来。"
                },
                {
                    "id": "705390208",
                    "speaker": "派蒙",
                    "text": "现在它白白净净软软的，好像雪花捏起来的糕点，就叫它「雪糕」好啦！",
                    "choices": [
                        {
                            "id": "705390209",
                            "text": "「豆腐团子」也不错吧！",
                            "response": [
                                {
                                    "id": "705390211",
                                    "speaker": "「雪糕」",
                                    "text": "喵~喵~"
                                },
                                {
                                    "id": "705390212",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，{NICKNAME}起的名字也很好，不过它果然还是喜欢「雪糕」！"
                                },
                                {
                                    "id": "705390213",
                                    "speaker": "派蒙",
                                    "text": "「雪糕」好，「雪糕」乖~「雪糕」跳呀跳，「雪糕」快过来~"
                                },
                                {
                                    "id": "705390214",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "见…见面不到一分钟，就能让猫猫这么听话！罗莎莉亚小姐，白色小帮手是魔法师吗…是白猫魔法师！"
                                },
                                {
                                    "id": "705390215",
                                    "speaker": "派蒙",
                                    "text": "虽然都是捡来的猫猫，但只要取个好名字，亲切地呼唤它们，就肯定能慢慢拉近距离哦。"
                                },
                                {
                                    "id": "705390216",
                                    "speaker": "派蒙",
                                    "text": "当然，你们首先要控制好你们的…那什么来着？对，气息！"
                                },
                                {
                                    "id": "705390217",
                                    "speaker": "派蒙",
                                    "text": "比如瓦乐瑞娜，你不要战战兢兢，你害怕，猫猫也会跟着你害怕哦。至于罗莎莉亚，你的表情…"
                                },
                                {
                                    "id": "705390218",
                                    "speaker": "罗莎莉亚",
                                    "text": "捡来的孩子…亲切地呼唤它…命运也会这么温柔地对待流浪的生灵啊。"
                                },
                                {
                                    "id": "705390219",
                                    "speaker": "罗莎莉亚",
                                    "text": "幸福之城的节奏，其实很不错。"
                                },
                                {
                                    "id": "705390220",
                                    "speaker": "「雪糕」",
                                    "text": "喵！"
                                },
                                {
                                    "id": "705390221",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "「雪糕」贴近罗莎莉亚小姐了！好像不怕她了！"
                                },
                                {
                                    "id": "705390222",
                                    "speaker": "派蒙",
                                    "text": "（罗莎莉亚刚才…是不是笑了？）",
                                    "choices": [
                                        {
                                            "id": "705390223",
                                            "text": "（我好像也看到了！）",
                                            "response": [
                                                {
                                                    "id": "705390225",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "无所谓吧，这不是重点。"
                                                },
                                                {
                                                    "id": "705390226",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "收养所里有点闷，我出去透透气，有事再叫我吧。"
                                                },
                                                {
                                                    "id": "705390227",
                                                    "speaker": "派蒙",
                                                    "text": "咦，我以为罗莎莉亚也会很开心呢？"
                                                },
                                                {
                                                    "id": "705390228",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "请再向我多演示演示和猫猫亲近的技巧，荣誉骑士和白猫魔法师！"
                                                },
                                                {
                                                    "id": "705390229",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "以后肯定还会有更多流浪猫来到「猫茸茸城堡」，它们的性格不可能都像「雪糕」一样好，我根本不知道要怎么和它们相处…"
                                                },
                                                {
                                                    "id": "705390230",
                                                    "speaker": "派蒙",
                                                    "text": "没问题，你就在旁边看好吧！"
                                                },
                                                {
                                                    "id": "705390231",
                                                    "speaker": "派蒙",
                                                    "text": "#接下来，我和{NICKNAME}就要向你展示更进一步的技巧了，那就是让猫猫开心的魔法！"
                                                },
                                                {
                                                    "id": "705390232",
                                                    "speaker": "派蒙",
                                                    "text": "耐心地和猫猫相处，不断加深对猫猫的了解，一定能和它们成为好朋友！"
                                                },
                                                {
                                                    "id": "705390233",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "我完全明白了！现在就是「猫茸茸城堡」的试营业阶段，我会好好观察，认真学习！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705390224",
                                            "text": "（我们还是装傻吧！）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705390210",
                            "text": "也可以是「奶油布丁」！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705399901",
                    "speaker": "派蒙",
                    "text": "仔细想想…最近我们遇见了不少神奇的动物呢！"
                },
                {
                    "id": "705399902",
                    "speaker": "派蒙",
                    "text": "不过它们有的太大，有的湿漉漉，不方便一起玩…想到这里，我就想和又小巧又乖的猫猫们玩了。"
                },
                {
                    "id": "705399903",
                    "speaker": "派蒙",
                    "text": "#要不然，我们回蒙德的猫尾酒馆去看看吧，{NICKNAME}？"
                }
            ]
        }
    ]
}