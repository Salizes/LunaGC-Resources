    "talks": [
        {
            "id": "7403001",
            "objective": "与嘉维娅对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740300101",
                    "speaker": "嘉维娅",
                    "text": "你们好，有什么事吗？",
                    "choices": [
                        {
                            "id": "740300102",
                            "text": "好巫师姐姐，帮帮我们。",
                            "response": [
                                {
                                    "id": "740300103",
                                    "speaker": "嘉维娅",
                                    "text": "怎么连你也学起莉诺尔了？有什么话就直说吧。"
                                },
                                {
                                    "id": "740300104",
                                    "speaker": "派蒙",
                                    "text": "我们需要很多特许券！想问问有没有什么我们能做的工作…"
                                },
                                {
                                    "id": "740300107",
                                    "speaker": "嘉维娅",
                                    "text": "你们该不会是加入了艾蒂安的游戏吧？玩闹也要适可而止哦。"
                                },
                                {
                                    "id": "740300108",
                                    "speaker": "嘉维娅",
                                    "text": "…说起来，的确有件事想要拜托你们。"
                                },
                                {
                                    "id": "740300109",
                                    "speaker": "嘉维娅",
                                    "text": "克兰茨现在应该正在海蚀裂隙那边修理他的什么装置…你们去帮帮他吧。"
                                },
                                {
                                    "id": "740300110",
                                    "speaker": "嘉维娅",
                                    "text": "至于报酬，就直接找他索取好了。他不会有异议的。"
                                },
                                {
                                    "id": "740300111",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，交给我们吧！"
                                }
                            ]
                        },
                        {
                            "id": "740300105",
                            "text": "有我们可帮忙的事吗？",
                            "response": [
                                {
                                    "id": "740300106",
                                    "speaker": "派蒙",
                                    "text": "最好是有报酬的那种！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403002",
            "objective": "前往海蚀裂隙寻找克兰茨",
            "dialogues": [
                {
                    "id": "740300201",
                    "speaker": "克兰茨",
                    "text": "你们来得正好，来帮个忙。",
                    "choices": [
                        {
                            "id": "740300202",
                            "text": "读心术？好恐怖！",
                            "response": [
                                {
                                    "id": "740300203",
                                    "speaker": "派蒙",
                                    "text": "嘉维娅让我们来帮忙…你是怎么知道的！"
                                },
                                {
                                    "id": "740300204",
                                    "speaker": "克兰茨",
                                    "text": "啊？因为这里只有你们能帮忙啊。"
                                },
                                {
                                    "id": "740300205",
                                    "speaker": "派蒙",
                                    "text": "…也对哦！"
                                },
                                {
                                    "id": "740300210",
                                    "speaker": "克兰茨",
                                    "text": "反正不是什么难事，这儿的研察终端需要两个人同时操作。具体的指令我已经录入完毕了，你们过去拉下拉杆就好。"
                                },
                                {
                                    "id": "740300211",
                                    "speaker": "克兰茨",
                                    "text": "差点忘了…储能装置应该就在附近，麻烦你们先把储能装置安装上再开启吧。"
                                },
                                {
                                    "id": "740300212",
                                    "speaker": "克兰茨",
                                    "text": "以及…我先确认一下，你们不是什么机械杀手吧？",
                                    "choices": [
                                        {
                                            "id": "740300213",
                                            "text": "这取决于你对机械杀手的定义。",
                                            "response": [
                                                {
                                                    "id": "740300215",
                                                    "speaker": "派蒙",
                                                    "text": "为什么问这个呀？"
                                                },
                                                {
                                                    "id": "740300216",
                                                    "speaker": "克兰茨",
                                                    "text": "之前让嘉维娜帮忙，我刚把视线移开没一会儿，研察终端就报废了。问她怎么回事，她自己也说不清楚。"
                                                },
                                                {
                                                    "id": "740300217",
                                                    "speaker": "克兰茨",
                                                    "text": "后来从她妹妹那里得知，没有机械造物能在她手里撑过半天。我猜就算是阿兰·吉约丹本人见了她也得叹气吧。"
                                                },
                                                {
                                                    "id": "740300218",
                                                    "speaker": "克兰茨",
                                                    "text": "当时修理费用还是从我的报酬里扣的…如果你们也和她一样，那我辛勤劳动这么长时间，最后还得倒贴特许券…"
                                                },
                                                {
                                                    "id": "740300219",
                                                    "speaker": "派蒙",
                                                    "text": "居然还有这种事…我们肯定不会跟她一样，你就放心交给我们好了！"
                                                },
                                                {
                                                    "id": "740300220",
                                                    "speaker": "克兰茨",
                                                    "text": "那就拜托你们了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740300214",
                                            "text": "如果研察终端会攻击我，那我就是。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740300206",
                            "text": "这忙不能白帮。",
                            "response": [
                                {
                                    "id": "740300207",
                                    "speaker": "克兰茨",
                                    "text": "待会儿让嘉维娅给你们申请。"
                                },
                                {
                                    "id": "740300208",
                                    "speaker": "派蒙",
                                    "text": "欸？可是她让我们直接找你索取报酬…"
                                },
                                {
                                    "id": "740300209",
                                    "speaker": "克兰茨",
                                    "text": "她是这么说的？那好吧。在这儿申请一点经费比在枫丹科学院还难…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403003",
            "objective": "协助克兰茨操作终端",
            "dialogues": [
                {
                    "id": "740300301",
                    "speaker": "克兰茨",
                    "text": "怎么了，有哪里不明白吗？只需要配合我拉动拉杆就可以了，很简单的。"
                }
            ]
        },
        {
            "id": "7403004",
            "objective": "与克兰茨对话",
            "dialogues": [
                {
                    "id": "740300401",
                    "speaker": "克兰茨",
                    "text": "你们还挺熟练的。要不是在这种地方，我都想雇你们当助手了。"
                },
                {
                    "id": "740300402",
                    "speaker": "派蒙",
                    "text": "哼哼，这点小事怎么可能难倒我们。话说回来，这个装置到底是做什么用的？"
                },
                {
                    "id": "740300403",
                    "speaker": "克兰茨",
                    "text": "这里原本有条通往外部的裂隙需要看守看管，现在用闭锁装置把路封上就可以节省一些人力了。"
                },
                {
                    "id": "740300404",
                    "speaker": "克兰茨",
                    "text": "这技术在枫丹科学院也不是什么新鲜玩意儿，不过反正闲着也是闲着，我就稍微做了点改造。"
                },
                {
                    "id": "740300405",
                    "speaker": "克兰茨",
                    "text": "你们现在看到的还不是完全版，完全版被用在晶簇矿坑道…咳，好像说太多了。你们就当没听到吧。",
                    "choices": [
                        {
                            "id": "740300406",
                            "text": "晶簇矿坑道也有可以出去的路。",
                            "response": [
                                {
                                    "id": "740300407",
                                    "speaker": "克兰茨",
                                    "text": "唉，是啊，你可真是太聪明了，如果更聪明一点，就应该把这句话放在心里，而不是直接说出来。"
                                },
                                {
                                    "id": "740300411",
                                    "speaker": "克兰茨",
                                    "text": "好了，这下问题也算解决了，嘉维娜可以不用那么常来这里看守，我也可以歇会儿了。"
                                },
                                {
                                    "id": "740300412",
                                    "speaker": "克兰茨",
                                    "text": "…差点忘了，这些是给你们的报酬。谢啦。"
                                }
                            ]
                        },
                        {
                            "id": "740300408",
                            "text": "完全版更厉害吗？",
                            "response": [
                                {
                                    "id": "740300409",
                                    "speaker": "克兰茨",
                                    "text": "那当然了，完全版还加装了配件…你打听这么多干什么？"
                                },
                                {
                                    "id": "740300410",
                                    "speaker": "克兰茨",
                                    "text": "你要是想知道完全版的具体情况，可以自己去试试…被抓了别说是我怂恿你去的就行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}