    "talks": [
        {
            "id": "2002701",
            "objective": "前去查看详请",
            "dialogues": [
                {
                    "id": "200270101",
                    "speaker": "特纳",
                    "text": "#谢谢，谢谢你，{NICKNAME}…"
                },
                {
                    "id": "200270102",
                    "speaker": "特纳",
                    "text": "我本来是想去看看葡萄藤的情况，结果却撞上这倒霉事…"
                },
                {
                    "id": "200270103",
                    "speaker": "特纳",
                    "text": "唉，请你别告诉我儿子，他是城里的西风骑士。他平时工作肯定也很辛苦吧。"
                },
                {
                    "id": "200270104",
                    "speaker": "特纳",
                    "text": "我这个老头子的一点小麻烦，就不要让他再烦心了。"
                },
                {
                    "id": "200270105",
                    "speaker": "特纳",
                    "text": "但是最近，酒庄附近总是会出现史莱姆，我每天都在担心葡萄藤会被史莱姆给毁了，睡也睡不好。"
                },
                {
                    "id": "200270106",
                    "speaker": "特纳",
                    "text": "如果你们有空的话，就帮我老头子一个忙，再去周围看看，把史莱姆都赶走，别让它们再来破坏了。",
                    "choices": [
                        {
                            "id": "200270107",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200270109",
                                    "speaker": "特纳",
                                    "text": "太好了，我总算能休息一下了。"
                                }
                            ]
                        },
                        {
                            "id": "200270108",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "200270110",
                                    "speaker": "特纳",
                                    "text": "唉，本来说我自己来也行…但是老头子我真的动不了了，年轻人，你就帮帮我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
