    "talks": [
        {
            "id": "7065701",
            "objective": "与莉兹交谈",
            "dialogues": [
                {
                    "id": "706570101",
                    "speaker": "莉兹",
                    "text": "你好，我是西风骑士团的莉兹。相信你也听说了吧，风花节期间，蒙德会有各种各样的好玩活动！",
                    "choices": [
                        {
                            "id": "706570102",
                            "text": "有所耳闻…",
                            "response": [
                                {
                                    "id": "706570104",
                                    "speaker": "莉兹",
                                    "text": "我的工作，就是接待来到蒙德的客人，让每个人都能充分享受这个节日的乐趣！"
                                },
                                {
                                    "id": "706570105",
                                    "speaker": "莉兹",
                                    "text": "因为举办活动的地方不一定在城内，如果没人来介绍，有很多精彩游戏就会被错过了。"
                                },
                                {
                                    "id": "706570106",
                                    "speaker": "莉兹",
                                    "text": "现在要隆重向你推荐的就是这个——「百发百中」！"
                                },
                                {
                                    "id": "706570107",
                                    "speaker": "莉兹",
                                    "text": "顾名思义，就是射击天上的目标，如果又快又准，就可以获得高分！",
                                    "choices": [
                                        {
                                            "id": "706570108",
                                            "text": "感觉很有意思。",
                                            "response": [
                                                {
                                                    "id": "706570110",
                                                    "speaker": "莉兹",
                                                    "text": "没关系啦，我把位置帮你标记出来，你亲自去试一试就知道啦。"
                                                },
                                                {
                                                    "id": "706570111",
                                                    "speaker": "莉兹",
                                                    "text": "根据你获得的分数，还可以获得价值不等的奖品，无论是体验一下，还是追求极致，都很有乐趣！",
                                                    "choices": [
                                                        {
                                                            "id": "706570112",
                                                            "text": "有点兴趣了。",
                                                            "response": [
                                                                {
                                                                    "id": "706570114",
                                                                    "speaker": "莉兹",
                                                                    "text": "嗯嗯，先去试试看吧！如果还想了解其他有趣的活动，也可以来找我！"
                                                                },
                                                                {
                                                                    "id": "706570115",
                                                                    "speaker": "莉兹",
                                                                    "text": "祝你玩得愉快！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706570113",
                                                            "text": "谢谢你的介绍。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706570109",
                                            "text": "感觉有点难。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706570103",
                            "text": "第一次听说。"
                        }
                    ]
                }
            ]
        }
    ]
}