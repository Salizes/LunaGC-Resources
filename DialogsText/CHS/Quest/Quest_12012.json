    "talks": [
        {
            "id": "1201201",
            "objective": "拜访老夫妻，寻求帮助",
            "dialogues": [
                {
                    "id": "120120101",
                    "speaker": "今谷香里",
                    "text": "欸，这不是宵宫嘛，快来快来，进屋坐坐。"
                },
                {
                    "id": "120120102",
                    "speaker": "今谷香里",
                    "text": "这边的是你的朋友吗？"
                },
                {
                    "id": "120120103",
                    "speaker": "宵宫",
                    "text": "对啊，是远道而来的旅行者，现在有外人到稻妻来很不容易。"
                },
                {
                    "id": "120120104",
                    "speaker": "今谷三郎",
                    "text": "是啊，现在情况特殊，不过既然来了，我们作为本地人，就要好好招待。"
                },
                {
                    "id": "120120105",
                    "speaker": "宵宫",
                    "text": "嗯。对了，你们两位之前定的烟花，我也带过来了。"
                },
                {
                    "id": "120120106",
                    "speaker": "今谷三郎",
                    "text": "哦，谢谢啊，每年都要麻烦你们家，先是你的爸爸，现在轮到你了。"
                },
                {
                    "id": "120120107",
                    "speaker": "今谷三郎",
                    "text": "不知道有生之年，能不能等到「长野原烟花店」的下一任接班人啊。"
                },
                {
                    "id": "120120108",
                    "speaker": "宵宫",
                    "text": "没问题的，两位现在身子骨这么硬朗，就别说不吉利的话啦。"
                },
                {
                    "id": "120120109",
                    "speaker": "今谷香里",
                    "text": "唉，身子这东西，确实不如以前啦。"
                },
                {
                    "id": "120120110",
                    "speaker": "今谷香里",
                    "text": "以前种田挑水什么的一点都不费劲，现在稍微干点活就腰酸背痛的。"
                },
                {
                    "id": "120120111",
                    "speaker": "今谷香里",
                    "text": "昨天本来想把杂草除一下，结果弯下腰去，就有点直不起来了。"
                },
                {
                    "id": "120120112",
                    "speaker": "宵宫",
                    "text": "这样啊，没关系，交给我们吧！"
                },
                {
                    "id": "120120113",
                    "speaker": "今谷三郎",
                    "text": "哎，别别别，好不容易来一趟，怎么能让你们干活呢。"
                },
                {
                    "id": "120120114",
                    "speaker": "今谷三郎",
                    "text": "我去拿点心和茶，边吃边聊吧。"
                },
                {
                    "id": "120120115",
                    "speaker": "宵宫",
                    "text": "没关系啦，我不是总来帮你们做家务的嘛。最近是因为烟花会的事在忙，之后我还会经常来的。"
                },
                {
                    "id": "120120116",
                    "speaker": "派蒙",
                    "text": "对我们来说是小事情啦，不用客气。"
                },
                {
                    "id": "120120117",
                    "speaker": "今谷香里",
                    "text": "哎呀，你们就是懂事，不像我家那孩子，也老大不小的了，还是一个人，也总是不回家。"
                },
                {
                    "id": "120120118",
                    "speaker": "今谷香里",
                    "text": "既然你都这么说了，我这里还腌了点咸萝卜，你能顺便带给村那边的小聪嘛？"
                },
                {
                    "id": "120120119",
                    "speaker": "宵宫",
                    "text": "好啊，我们去去就来。"
                },
                {
                    "id": "120120120",
                    "speaker": "宵宫",
                    "text": "跟我来吧，爷爷奶奶腿脚不利索，我们帮帮忙吧，先<color=#00E1FFFF>除草</color>，再去<color=#00E1FFFF>送咸萝卜</color>。"
                }
            ]
        },
        {
            "id": "1201208",
            "objective": "",
            "dialogues": [
                {
                    "id": "120120801",
                    "speaker": "聪",
                    "text": "马上就是「长野原烟花会」了吧，我家孩子早就跑出去了。"
                },
                {
                    "id": "120120802",
                    "speaker": "聪",
                    "text": "特别迫不及待，心思全写在脸上，谁不知道她是惦记城里的那个臭小子…"
                },
                {
                    "id": "120120803",
                    "speaker": "聪",
                    "text": "…唉，她开心就好吧。"
                }
            ]
        },
        {
            "id": "1201209",
            "objective": "",
            "dialogues": [
                {
                    "id": "120120901",
                    "speaker": "今谷三郎",
                    "text": "对不起啊，没能帮上你们的忙。"
                },
                {
                    "id": "120120902",
                    "speaker": "今谷香里",
                    "text": "不过，那个孩子，总要学会面对他的心事。"
                },
                {
                    "id": "120120903",
                    "speaker": "今谷香里",
                    "text": "这是作父母的，没办法教他的东西啊。"
                }
            ]
        },
        {
            "id": "1201202",
            "objective": "帮助老夫妻清理庭院",
            "dialogues": []
        },
        {
            "id": "1201204",
            "objective": "将咸萝卜送给村里的聪",
            "dialogues": [
                {
                    "id": "120120401",
                    "speaker": "宵宫",
                    "text": "聪叔叔你好，最近身体怎么样？"
                },
                {
                    "id": "120120402",
                    "speaker": "聪",
                    "text": "还是老样子啊，没什么变化。你看起来也还是那么活泼啊。"
                },
                {
                    "id": "120120403",
                    "speaker": "宵宫",
                    "text": "托大家的福嘛，我家的生意越来越好了。"
                },
                {
                    "id": "120120404",
                    "speaker": "宵宫",
                    "text": "上次卖到璃月去的烟花，听说广受好评，估计之后的订单又要增加了。"
                },
                {
                    "id": "120120405",
                    "speaker": "聪",
                    "text": "那你不是更辛苦了，和龙之介先生还忙得过来嘛？"
                },
                {
                    "id": "120120406",
                    "speaker": "聪",
                    "text": "实在吃力的话，记得叫我帮忙哦。"
                },
                {
                    "id": "120120407",
                    "speaker": "宵宫",
                    "text": "没问题啦，烟花的事情，可以自己解决。"
                },
                {
                    "id": "120120408",
                    "speaker": "宵宫",
                    "text": "对了对了，这是香里奶奶托我给你送过来的咸萝卜。"
                },
                {
                    "id": "120120409",
                    "speaker": "聪",
                    "text": "哎呀，真是谢谢，本来我以前都吃不惯咸萝卜的。"
                },
                {
                    "id": "120120410",
                    "speaker": "聪",
                    "text": "尝了她的手艺可就忘不掉咯，现在都成我们家里人的习惯了。"
                },
                {
                    "id": "120120411",
                    "speaker": "宵宫",
                    "text": "家里现在都还好吗？"
                },
                {
                    "id": "120120412",
                    "speaker": "聪",
                    "text": "好啊，不过，偶尔也会闹闹脾气吧，家人不就是这样吗？"
                },
                {
                    "id": "120120413",
                    "speaker": "聪",
                    "text": "我觉得，有亲人一直陪在身边，就算有矛盾，也比一直见不到面要好。"
                },
                {
                    "id": "120120414",
                    "speaker": "聪",
                    "text": "虽然叔叔阿姨的感情很好，但孩子总是不回来，也挺孤单的吧。"
                },
                {
                    "id": "120120415",
                    "speaker": "宵宫",
                    "text": "看上去其实也不会，他们好像已经习惯这样的日子了。"
                },
                {
                    "id": "120120416",
                    "speaker": "宵宫",
                    "text": "不过你说得也很有道理，那我以后多来看看好了，至少有人能聊聊天什么的，就不会无聊了。"
                },
                {
                    "id": "120120417",
                    "speaker": "聪",
                    "text": "好啊，绀田村的大家都希望你能多来看看呢。"
                },
                {
                    "id": "120120418",
                    "speaker": "宵宫",
                    "text": "嘿嘿，谢谢啦。"
                }
            ]
        },
        {
            "id": "1201205",
            "objective": "回报老夫妻",
            "dialogues": [
                {
                    "id": "120120501",
                    "speaker": "今谷香里",
                    "text": "不愧是年轻人啊，干事情就是利索。"
                },
                {
                    "id": "120120502",
                    "speaker": "宵宫",
                    "text": "年轻人的精神用不完，老人见多识广经验丰富，各有各的厉害之处嘛。"
                },
                {
                    "id": "120120503",
                    "speaker": "今谷三郎",
                    "text": "说起来，今年就正好五十年了。"
                },
                {
                    "id": "120120504",
                    "speaker": "今谷香里",
                    "text": "是啊，一年一年这么过去，其实没什么明显的感觉，但一晃眼，就五十年了。"
                },
                {
                    "id": "120120505",
                    "speaker": "派蒙",
                    "text": "五十年？是什么重要的日子吗？"
                },
                {
                    "id": "120120506",
                    "speaker": "今谷三郎",
                    "text": "哈哈，那就要讲，五十年之前，这老婆子追我的时候…"
                },
                {
                    "id": "120120507",
                    "speaker": "今谷香里",
                    "text": "在外人面前乱讲什么，明明是你发了疯地追我好不好。"
                },
                {
                    "id": "120120508",
                    "speaker": "今谷三郎",
                    "text": "那这一段略过去，不讲。总之，就是在那年的「长野原烟花会」上，我向老婆子求了婚，然后就一起过日子了。",
                    "choices": [
                        {
                            "id": "120120509",
                            "text": "祝贺你们。",
                            "response": [
                                {
                                    "id": "120120511",
                                    "speaker": "今谷三郎",
                                    "text": "其实本来也没下定决心的，抱着有点犹豫的心态找长野原做了烟花。"
                                },
                                {
                                    "id": "120120512",
                                    "speaker": "今谷三郎",
                                    "text": "烟花升起来，就到那时候也不知道要怎么开口。"
                                },
                                {
                                    "id": "120120513",
                                    "speaker": "今谷三郎",
                                    "text": "结果声音砰砰砰的，烟花点亮了天空，再看她的侧脸，那眼睛啊，倒映出烟花的光，闪闪发亮…"
                                },
                                {
                                    "id": "120120514",
                                    "speaker": "今谷三郎",
                                    "text": "也不知道怎么回事，回过神来的时候，我好像已经开了口，她还答应了我。"
                                },
                                {
                                    "id": "120120515",
                                    "speaker": "今谷香里",
                                    "text": "五十年说长也长，说短也短，不是什么了不起的事。"
                                },
                                {
                                    "id": "120120516",
                                    "speaker": "今谷香里",
                                    "text": "但携手走过五十年，也值得纪念一下吧。"
                                },
                                {
                                    "id": "120120517",
                                    "speaker": "宵宫",
                                    "text": "我之前不知道是五十年这么特殊的日子，早知道，应该给你们做一个特殊的，豪华版的烟花。"
                                },
                                {
                                    "id": "120120518",
                                    "speaker": "今谷香里",
                                    "text": "不用不用，就是以前的那种就行，每次烟花会都看，看不到才会不习惯呢。"
                                },
                                {
                                    "id": "120120519",
                                    "speaker": "今谷香里",
                                    "text": "只要看了烟花，就能想起那段日子。哪怕是上了年纪，也不会觉得自己的过去有什么遗憾。"
                                },
                                {
                                    "id": "120120520",
                                    "speaker": "派蒙",
                                    "text": "他们的感情，真的很好呢…"
                                },
                                {
                                    "id": "120120521",
                                    "speaker": "今谷三郎",
                                    "text": "对了，我们的事先不提，宵宫你现在应该忙着办烟花会吧，到我们这里来，是有什么要紧事吗？"
                                },
                                {
                                    "id": "120120522",
                                    "speaker": "宵宫",
                                    "text": "哦，其实是个比较难以启齿的事，我先给你们讲讲吧。"
                                },
                                {
                                    "id": "120120523",
                                    "speaker": "今谷三郎",
                                    "text": "朔次郎，他…回来了啊。"
                                },
                                {
                                    "id": "120120524",
                                    "speaker": "宵宫",
                                    "text": "欸？你们认识他？"
                                },
                                {
                                    "id": "120120525",
                                    "speaker": "今谷香里",
                                    "text": "那是我家孩子，小时候最好的朋友啊。"
                                },
                                {
                                    "id": "120120526",
                                    "speaker": "今谷香里",
                                    "text": "唉，那时候他们一直一起玩，从小到大，无话不讲，到处跑，到处看。"
                                },
                                {
                                    "id": "120120527",
                                    "speaker": "今谷香里",
                                    "text": "结果呢，有一天突然吵了一架，吵得很厉害…"
                                },
                                {
                                    "id": "120120528",
                                    "speaker": "今谷三郎",
                                    "text": "我记得那时候的朔次郎，想要去外面的世界看看，他觉得稻妻太安稳了。"
                                },
                                {
                                    "id": "120120529",
                                    "speaker": "今谷三郎",
                                    "text": "可是我们家那孩子佳祐，从小就和我们一样，觉得安安稳稳的没什么不好。"
                                },
                                {
                                    "id": "120120530",
                                    "speaker": "今谷三郎",
                                    "text": "小孩子嘛，就是会因为对错而争论得很厉害，最后朔次郎就一气之下，独自离开了。"
                                },
                                {
                                    "id": "120120531",
                                    "speaker": "宵宫",
                                    "text": "原来是这样…"
                                },
                                {
                                    "id": "120120532",
                                    "speaker": "今谷三郎",
                                    "text": "那之后佳祐虽然什么都没跟我和老婆子说，但能看出来，他很伤心，但心里的想法，又不愿和我们讲。"
                                },
                                {
                                    "id": "120120533",
                                    "speaker": "今谷三郎",
                                    "text": "后来，不知道是赌气还是什么其他原因，他就去了天领奉行，很少回来了。"
                                },
                                {
                                    "id": "120120534",
                                    "speaker": "今谷香里",
                                    "text": "其他的忙，我们跟佳祐好好说说，他应该是会帮的。"
                                },
                                {
                                    "id": "120120535",
                                    "speaker": "今谷香里",
                                    "text": "但如果是朔次郎的事，我觉得…我们没有办法插手。"
                                },
                                {
                                    "id": "120120536",
                                    "speaker": "派蒙",
                                    "text": "没想到这么巧…"
                                },
                                {
                                    "id": "120120537",
                                    "speaker": "宵宫",
                                    "text": "我明白了。我问朔次郎他为什么回来的时候，他也不愿意细讲，只说是「以前犯了错」。"
                                },
                                {
                                    "id": "120120538",
                                    "speaker": "宵宫",
                                    "text": "我终于明白他为什么下不了决心了。"
                                },
                                {
                                    "id": "120120539",
                                    "speaker": "派蒙",
                                    "text": "明明是童年挚友，现在一个是天领奉行的人，一个在被天领奉行通缉…",
                                    "choices": [
                                        {
                                            "id": "120120540",
                                            "text": "这就是命运吧。",
                                            "response": [
                                                {
                                                    "id": "120120542",
                                                    "speaker": "宵宫",
                                                    "text": "没关系，既然这样的话，就不打扰你们了。"
                                                },
                                                {
                                                    "id": "120120543",
                                                    "speaker": "宵宫",
                                                    "text": "我们会帮朔次郎想想办法的，两位也不用勉强，这件事，还是留给朔次郎和佳祐自己去处理吧。"
                                                },
                                                {
                                                    "id": "120120544",
                                                    "speaker": "今谷香里",
                                                    "text": "嗯，要是他们的关系能和好如初就好了呢。"
                                                },
                                                {
                                                    "id": "120120545",
                                                    "speaker": "今谷三郎",
                                                    "text": "那么多年之前的争吵，现在也应该放下了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120120541",
                                            "text": "我也没想到。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120120510",
                            "text": "令人羡慕。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201206",
            "objective": "将消息告诉朔次郎",
            "dialogues": [
                {
                    "id": "120120601",
                    "speaker": "长野原龙之介",
                    "text": "丫头，不好了，刚刚天领奉行的人来过了。"
                },
                {
                    "id": "120120602",
                    "speaker": "宵宫",
                    "text": "欸？为什么，他们这就知道了？"
                },
                {
                    "id": "120120603",
                    "speaker": "宵宫",
                    "text": "老爹你没事吧？他们没对你做什么吧？"
                },
                {
                    "id": "120120604",
                    "speaker": "长野原龙之介",
                    "text": "我说，烟花会，房子里都是烟花，不要随便进去看，免得火灾。"
                },
                {
                    "id": "120120605",
                    "speaker": "长野原龙之介",
                    "text": "但他们不听，就觉得朔次郎那小子藏在里面。"
                },
                {
                    "id": "120120606",
                    "speaker": "长野原龙之介",
                    "text": "不过幸好，朔次郎提前听到了动静，翻窗子跑掉了，天领奉行的人没有在这里抓到他。"
                },
                {
                    "id": "120120607",
                    "speaker": "宵宫",
                    "text": "哎呀，这就麻烦了，朔次郎现在应该还在犹豫不决…"
                },
                {
                    "id": "120120608",
                    "speaker": "宵宫",
                    "text": "老爹，你看到他往哪儿跑了吗？"
                },
                {
                    "id": "120120609",
                    "speaker": "宵宫",
                    "text": "我觉得天领奉行的人一定会追上去的。"
                },
                {
                    "id": "120120610",
                    "speaker": "Player",
                    "text": "你听到那个人的名字了吗？"
                },
                {
                    "id": "120120611",
                    "speaker": "宵宫",
                    "text": "对对对，名字，名字！这么突然地就来抓人，很有可能就是那个佳祐！"
                },
                {
                    "id": "120120612",
                    "speaker": "宵宫",
                    "text": "不然只是因为偷渡，应该还不至于这么兴师动众。"
                },
                {
                    "id": "120120613",
                    "speaker": "长野原龙之介",
                    "text": "不行啊，我耳朵不好，也没看到。你们想问方向是吧，他们出城去了。"
                },
                {
                    "id": "120120614",
                    "speaker": "长野原龙之介",
                    "text": "名字我没听到，唉，真的没听到…"
                },
                {
                    "id": "120120615",
                    "speaker": "森彦",
                    "text": "名字的话，我好像听到了。"
                },
                {
                    "id": "120120616",
                    "speaker": "森彦",
                    "text": "我刚刚又从朋友那里拿了点矿石，送过来的时候，刚好撞上。"
                },
                {
                    "id": "120120617",
                    "speaker": "森彦",
                    "text": "领头的那个，好像就是你们说的，叫作佳祐。"
                },
                {
                    "id": "120120618",
                    "speaker": "宵宫",
                    "text": "果然是这样！谢谢你！"
                },
                {
                    "id": "120120619",
                    "speaker": "宵宫",
                    "text": "如果朔次郎还是没有下定决心，两个人见面不仅不能解决问题，还会让事情变得不可挽回。"
                },
                {
                    "id": "120120620",
                    "speaker": "宵宫",
                    "text": "#这样肯定不行。{NICKNAME}，跟我来，我们沿路打听线索吧！"
                }
            ]
        },
        {
            "id": "1201207",
            "objective": "",
            "dialogues": [
                {
                    "id": "120120701",
                    "speaker": "今谷香里",
                    "text": "谢谢你们能帮忙，唉，实在不好意思。"
                },
                {
                    "id": "120120702",
                    "speaker": "今谷三郎",
                    "text": "趁这个时间，我去泡个茶，准备点心吧。"
                }
            ]
        },
        {
            "id": "1201210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120121001",
                    "speaker": "松坂",
                    "text": "为什么刚刚走过去的叔叔，看起来好可怕？"
                },
                {
                    "id": "120121002",
                    "speaker": "彩香",
                    "text": "他们不会要抢我们的武器吧？"
                },
                {
                    "id": "120121003",
                    "speaker": "岩夫",
                    "text": "欸？没办法炸「大貉妖」了吗？"
                }
            ]
        },
        {
            "id": "1201211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120121101",
                    "speaker": "长野原龙之介",
                    "text": "今天的丫头也这么有精神啊。"
                },
                {
                    "id": "120121102",
                    "speaker": "长野原龙之介",
                    "text": "真好，真好…"
                }
            ]
        },
        {
            "id": "1201299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120129901",
                    "speaker": "派蒙",
                    "text": "这里的植物长得太茂盛了吧。"
                },
                {
                    "id": "120129902",
                    "speaker": "派蒙",
                    "text": "但，怎么说也是别人家的院子，全砍掉了是不是不太好…"
                },
                {
                    "id": "120129907",
                    "speaker": "宵宫",
                    "text": "事情都干完啦，那我们回去找他们聊正事吧。"
                },
                {
                    "id": "120129908",
                    "speaker": "宵宫",
                    "text": "唉，这样就没办法了。"
                },
                {
                    "id": "120129909",
                    "speaker": "宵宫",
                    "text": "回去把这个消息告诉朔次郎吧。"
                }
            ]
        }
    ]
}