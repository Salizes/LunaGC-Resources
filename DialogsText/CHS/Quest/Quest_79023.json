    "talks": [
        {
            "id": "7902314",
            "objective": "",
            "dialogues": [
                {
                    "id": "790231401",
                    "speaker": "派蒙",
                    "text": "#来吧，{NICKNAME}，不如把那枚徽记给他看看吧…"
                },
                {
                    "id": "790231402",
                    "speaker": "Player",
                    "text": "嗯，把徽记给他看…"
                }
            ]
        },
        {
            "id": "7902301",
            "objective": "与奇怪的愚人众对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790230101",
                    "speaker": "雷锤前锋军",
                    "text": "都是因为我…都是因为我他才会那样…"
                },
                {
                    "id": "790230102",
                    "speaker": "雷锤前锋军",
                    "text": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…"
                },
                {
                    "id": "790230103",
                    "speaker": "派蒙",
                    "text": "这个愚人众的家伙在念叨着什么呢？"
                },
                {
                    "id": "790230104",
                    "speaker": "派蒙",
                    "text": "喂，你在这里干什么呀！"
                },
                {
                    "id": "790230105",
                    "speaker": "雷锤前锋军",
                    "text": "徽记，徽记…",
                    "choices": [
                        {
                            "id": "790230106",
                            "text": "状态不太对…",
                            "response": [
                                {
                                    "id": "790230108",
                                    "speaker": "派蒙",
                                    "text": "唔，稍微有点在意呢，为什么一个雷锤前锋军会在这里，不会在做什么坏事吧…"
                                },
                                {
                                    "id": "790230109",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你觉得呢，这个雷锤前锋军…"
                                },
                                {
                                    "id": "790230110",
                                    "speaker": "Player",
                                    "text": "只有冲锋攻击需要注意…"
                                },
                                {
                                    "id": "790230111",
                                    "speaker": "派蒙",
                                    "text": "确实，雷锤前锋军冲刺的时候可让人害怕了…不对，我没在说这个啦！"
                                },
                                {
                                    "id": "790230112",
                                    "speaker": "派蒙",
                                    "text": "我是说，我们是不是应该让他清醒过来，问问他在这里干什么…"
                                },
                                {
                                    "id": "790230113",
                                    "speaker": "Player",
                                    "text": "确实有点好奇…"
                                },
                                {
                                    "id": "790230114",
                                    "speaker": "派蒙",
                                    "text": "对吧，一个愚人众在这里，说着什么「徽记，徽记…」之类的话，像是要找什么东西似的。"
                                },
                                {
                                    "id": "790230115",
                                    "speaker": "派蒙",
                                    "text": "这可不是平常走在路上能见到的事呢。"
                                },
                                {
                                    "id": "790230116",
                                    "speaker": "派蒙",
                                    "text": "可是，他到底为什么变成了现在这样…"
                                },
                                {
                                    "id": "790230117",
                                    "speaker": "Player",
                                    "text": "因为那个装置吧…"
                                },
                                {
                                    "id": "790230118",
                                    "speaker": "派蒙",
                                    "text": "是哦，愚人众也受到了那个装置的影响，不过到底有什么办法能够让他变得清醒过来呢？"
                                },
                                {
                                    "id": "790230119",
                                    "speaker": "雷锤前锋军",
                                    "text": "一定得找到那个徽记…一定得找到那个徽记才行啊…"
                                },
                                {
                                    "id": "790230120",
                                    "speaker": "派蒙",
                                    "text": "#看来他好像一直在找什么徽记的样子…{NICKNAME}，看来得把他在找的徽记给他呀…"
                                }
                            ]
                        },
                        {
                            "id": "790230107",
                            "text": "没法沟通呢…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902302",
            "objective": "寻找雷锤前锋军口中的徽记",
            "dialogues": []
        },
        {
            "id": "7902303",
            "objective": "将徽记交给雷锤前锋军",
            "dialogues": [
                {
                    "id": "790230301",
                    "speaker": "派蒙",
                    "text": "不过，他说的徽记不会就是我们之前在海边捡到的那个吧…就是那枚看上去有点破旧的那个！"
                },
                {
                    "id": "790230302",
                    "speaker": "派蒙",
                    "text": "不如把那枚徽记给他看看吧…"
                },
                {
                    "id": "790230303",
                    "speaker": "Player",
                    "text": "嗯，把徽记给他看…"
                }
            ]
        },
        {
            "id": "7902313",
            "objective": "与雷锤前锋军对话",
            "dialogues": [
                {
                    "id": "790231201",
                    "speaker": "雷锤前锋军",
                    "text": "这个…对，就是这个，这上面的划痕我记得一清二楚…嗯，这里怎么多了个缺口…"
                },
                {
                    "id": "790231202",
                    "speaker": "雷锤前锋军",
                    "text": "对了，那时候雅科夫把这个徽记往下扔…"
                },
                {
                    "id": "790231203",
                    "speaker": "派蒙",
                    "text": "是嘛，怪不得这个徽记在那么奇怪的地方…"
                },
                {
                    "id": "790231204",
                    "speaker": "雷锤前锋军",
                    "text": "原来是这样，哈哈哈，没想到在海边，终于找到了…真是谢谢你们啊，这世上这么好心的人可不多了…"
                },
                {
                    "id": "790231205",
                    "speaker": "雷锤前锋军",
                    "text": "#不对，你们是…你们是{NICKNAME}和派蒙！"
                },
                {
                    "id": "790231206",
                    "speaker": "Player",
                    "text": "#对，我就是{NICKNAME}！"
                },
                {
                    "id": "790231207",
                    "speaker": "派蒙",
                    "text": "对，我就是派蒙！"
                },
                {
                    "id": "790231208",
                    "speaker": "雷锤前锋军",
                    "text": "我明白了…既然落到了你们的手里，那也没有什么办法了。"
                },
                {
                    "id": "790231209",
                    "speaker": "雷锤前锋军",
                    "text": "我的父亲曾这样教导我，「如若落在敌手受辱，还不如慷慨就义，为家族赢得荣誉」。"
                },
                {
                    "id": "790231210",
                    "speaker": "派蒙",
                    "text": "呜哇，听上去有点可怕…",
                    "choices": [
                        {
                            "id": "790231211",
                            "text": "居然说这样的话…",
                            "response": [
                                {
                                    "id": "790231213",
                                    "speaker": "派蒙",
                                    "text": "不过我们只是好奇你出现在这里的目的而已啦…"
                                },
                                {
                                    "id": "790231214",
                                    "speaker": "雷锤前锋军",
                                    "text": "……"
                                },
                                {
                                    "id": "790231215",
                                    "speaker": "雷锤前锋军",
                                    "text": "我的父亲曾这样教导我，「向敌人说出情报，那就和背叛没什么两样，我们家族没有为了苟活而背叛的人！」"
                                },
                                {
                                    "id": "790231216",
                                    "speaker": "派蒙",
                                    "text": "严厉过头了吧。"
                                },
                                {
                                    "id": "790231217",
                                    "speaker": "Player",
                                    "text": "严厉过头了…"
                                },
                                {
                                    "id": "790231218",
                                    "speaker": "雷锤前锋军",
                                    "text": "所以按照父亲的教导，不仅落在你们手上，还接受了你们的帮助，实在是让人感到羞愧的一件事…"
                                },
                                {
                                    "id": "790231219",
                                    "speaker": "雷锤前锋军",
                                    "text": "实不相瞒，我现在，羞愧得想要大哭一场！"
                                },
                                {
                                    "id": "790231220",
                                    "speaker": "派蒙",
                                    "text": "知道了，这又不是什么值得自豪的事，没必要说那么大声啦。"
                                },
                                {
                                    "id": "790231221",
                                    "speaker": "雷锤前锋军",
                                    "text": "但是父亲也曾这样教导我，「受人恩惠，就该好好回报。」父亲的教导，在现在的情况里，产生了矛盾。"
                                },
                                {
                                    "id": "790231222",
                                    "speaker": "雷锤前锋军",
                                    "text": "所以我决定…"
                                },
                                {
                                    "id": "790231223",
                                    "speaker": "派蒙",
                                    "text": "你决定？"
                                },
                                {
                                    "id": "790231224",
                                    "speaker": "雷锤前锋军",
                                    "text": "就按照我的意思来吧，我会告诉你们的！"
                                },
                                {
                                    "id": "790231225",
                                    "speaker": "派蒙",
                                    "text": "突然就变得随意了！"
                                },
                                {
                                    "id": "790231226",
                                    "speaker": "叶夫卡",
                                    "text": "我的名字是叶夫卡，原本是在做装置信号的测试工作…唔，这段记忆有点不清楚，总之，我记得我们一路来到这座岛…"
                                },
                                {
                                    "id": "790231227",
                                    "speaker": "叶夫卡",
                                    "text": "哦，对了，雅科夫，我是和雅科夫一起行动的，这之间还和他大吵了一架，导致他扔掉了这枚徽记…"
                                },
                                {
                                    "id": "790231228",
                                    "speaker": "叶夫卡",
                                    "text": "后来我…眼睁睁地看着雅科夫走进一个奇怪的东西里，然后他就和那个东西一起消失了。我不会从此以后都见不到他了吧…"
                                },
                                {
                                    "id": "790231229",
                                    "speaker": "叶夫卡",
                                    "text": "所以我才在这里，找能重新见到他的方法…然后不知道为什么脑袋「嗡」了一下，就变成了刚才那样。"
                                },
                                {
                                    "id": "790231230",
                                    "speaker": "派蒙",
                                    "text": "走进去就会消失的奇怪的东西…是什么金苹果群岛的怪谈吗…",
                                    "choices": [
                                        {
                                            "id": "790231231",
                                            "text": "是恐怖的扭曲陷阱！",
                                            "response": [
                                                {
                                                    "id": "790231233",
                                                    "speaker": "派蒙",
                                                    "text": "应该不是那样的东西吧…说不定其实就跟我们以前见过的那些奇怪的机关道路一样…"
                                                },
                                                {
                                                    "id": "790231234",
                                                    "speaker": "派蒙",
                                                    "text": "说不定确实有重新打开的办法呢！"
                                                },
                                                {
                                                    "id": "790231235",
                                                    "speaker": "叶夫卡",
                                                    "text": "你们，你们能打开那个吗…"
                                                },
                                                {
                                                    "id": "790231236",
                                                    "speaker": "派蒙",
                                                    "text": "可以是可以啦，不过我们为什么要帮你呢…"
                                                },
                                                {
                                                    "id": "790231237",
                                                    "speaker": "Player",
                                                    "text": "明明是愚人众呢…"
                                                },
                                                {
                                                    "id": "790231238",
                                                    "speaker": "叶夫卡",
                                                    "text": "如果你们能打开，找到雅科夫，你们要我说什么我都会说的…啊，执行官大人们的坏话除外。"
                                                },
                                                {
                                                    "id": "790231239",
                                                    "speaker": "派蒙",
                                                    "text": "哇，答应得好快，弄得我都觉得自己是反派了…而且，这个时候就遗忘你父亲的教导了吗…"
                                                },
                                                {
                                                    "id": "790231240",
                                                    "speaker": "叶夫卡",
                                                    "text": "本来就是因为我的过错所以雅科夫才…有些事情，是比所谓的原则和教导更重要的…我是这么认为的。"
                                                },
                                                {
                                                    "id": "790231241",
                                                    "speaker": "派蒙",
                                                    "text": "#好吧！{NICKNAME}，我们就试试看看吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790231232",
                                            "text": "是无形的吃人魔物！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790231212",
                            "text": "不是合格的父亲会说的话！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902305",
            "objective": "寻找打开雅科夫穿行道路的办法",
            "dialogues": [
                {
                    "id": "790230501",
                    "speaker": "叶夫卡",
                    "text": "原来这里还有这样的一座岛…还真是奇怪…"
                },
                {
                    "id": "790230502",
                    "speaker": "叶夫卡",
                    "text": "之前，我们在进行调查的时候，不记得有这样一座岛啊…"
                },
                {
                    "id": "790230503",
                    "speaker": "派蒙",
                    "text": "叶夫卡…怎么了？"
                },
                {
                    "id": "790230504",
                    "speaker": "叶夫卡",
                    "text": "不，没什么事…"
                },
                {
                    "id": "790230505",
                    "speaker": "派蒙",
                    "text": "嗯，看来雅科夫肯定也来到了这个岛上！"
                },
                {
                    "id": "790230506",
                    "speaker": "叶夫卡",
                    "text": "对，雅科夫，得赶紧找到雅科夫才行。雅科夫——！"
                },
                {
                    "id": "790230507",
                    "speaker": "派蒙",
                    "text": "哇，都说了，别突然叫这么大声啦！"
                },
                {
                    "id": "790230508",
                    "speaker": "叶夫卡",
                    "text": "抱歉…"
                },
                {
                    "id": "790230509",
                    "speaker": "派蒙",
                    "text": "#没必要那么紧张，这里应该是很安全的地方，好，{NICKNAME}，我们就先去找找雅科夫在哪吧…"
                }
            ]
        },
        {
            "id": "7902306",
            "objective": "前去寻找雅科夫",
            "dialogues": [
                {
                    "id": "790230601",
                    "speaker": "留声机",
                    "text": "（留声机里播放着，让人能回想起温暖过去的话语……）"
                },
                {
                    "id": "790230602",
                    "speaker": "雅科夫",
                    "text": "啊…为什么…"
                },
                {
                    "id": "790230603",
                    "speaker": "叶夫卡",
                    "text": "雅科夫，雅科夫你醒醒啊！你怎么，怎么变成了这个样子…"
                },
                {
                    "id": "790230604",
                    "speaker": "派蒙",
                    "text": "你之前也是这个样子啦，而且还念叨着那个徽记呢！"
                },
                {
                    "id": "790230605",
                    "speaker": "叶夫卡",
                    "text": "哦，对哦，那个徽记…"
                },
                {
                    "id": "790230606",
                    "speaker": "叶夫卡",
                    "text": "雅科夫，你看，这是你的徽记。虽然你一气之下把它扔了，但是现在已经找到了…"
                },
                {
                    "id": "790230607",
                    "speaker": "叶夫卡",
                    "text": "这是你和你父亲一起获得的荣誉，现在已经重新回到你的手中了…怎么样，雅科夫，你醒过来了吗…"
                },
                {
                    "id": "790230608",
                    "speaker": "雅科夫",
                    "text": "为什么…为什么…为什么要抛下我一个人…"
                },
                {
                    "id": "790230609",
                    "speaker": "派蒙",
                    "text": "还是没有恢复呢…"
                },
                {
                    "id": "790230610",
                    "speaker": "叶夫卡",
                    "text": "难道这不是能唤醒他的东西吗…那他到底想要的是什么呀…"
                },
                {
                    "id": "790230611",
                    "speaker": "派蒙",
                    "text": "他想要的是什么，你居然不知道吗…你们不是队友嘛？"
                },
                {
                    "id": "790230612",
                    "speaker": "叶夫卡",
                    "text": "我…我一直以为他最重要的就是这份荣誉，不对，我错了，是「我以为」他觉得最重要的就是这个…"
                },
                {
                    "id": "790230613",
                    "speaker": "叶夫卡",
                    "text": "那是他和他父亲一起出一个紧急任务得来的，只不过他的父亲牺牲了，再也没有回来…"
                },
                {
                    "id": "790230614",
                    "speaker": "叶夫卡",
                    "text": "他的母亲在他出生的时候就去世了…失去父亲以后，他就变成了孤伶伶的一个人。"
                },
                {
                    "id": "790230615",
                    "speaker": "叶夫卡",
                    "text": "唉，他年纪比我小，得过的荣誉却比我多，说不定我只是一直在嫉妒他，也不知道如何和他相处，我唯一能够参照的就是…"
                },
                {
                    "id": "790230616",
                    "speaker": "派蒙",
                    "text": "不会是你父亲跟你相处的模式吧…"
                },
                {
                    "id": "790230617",
                    "speaker": "叶夫卡",
                    "text": "说来惭愧，但是确实如此…"
                },
                {
                    "id": "790230618",
                    "speaker": "派蒙",
                    "text": "那这样，不出问题才比较奇怪…"
                },
                {
                    "id": "790230619",
                    "speaker": "叶夫卡",
                    "text": "我们这支小队的休整处在海域中央的岛屿，现在雅科夫这个样子，我必须得先把他送到那边去才行。"
                },
                {
                    "id": "790230620",
                    "speaker": "叶夫卡",
                    "text": "哦，对了，我们…我们是受佩尔西科夫研究员指派，过来进行信号测试的成员。"
                },
                {
                    "id": "790230621",
                    "speaker": "叶夫卡",
                    "text": "据说是某位执行官大人在须弥得到了什么新的知识，可以通过一些技术，连接他人的意识，影响到一整片区域…"
                },
                {
                    "id": "790230622",
                    "speaker": "叶夫卡",
                    "text": "虽然不被看好，但是佩尔西科夫研究员还是强行开始了这次的实验，而我们则被指派前往海域各处进行装置的信号测试…"
                },
                {
                    "id": "790230623",
                    "speaker": "叶夫卡",
                    "text": "对了，不知道佩尔西科夫研究员的实验进行的如何了…"
                },
                {
                    "id": "790230624",
                    "speaker": "派蒙",
                    "text": "那还用问，我们出现在了这里，愚人众的实验…"
                },
                {
                    "id": "790230625",
                    "speaker": "Player",
                    "text": "当然是失败了！"
                },
                {
                    "id": "790230626",
                    "speaker": "叶夫卡",
                    "text": "是嘛，嘿嘿，这下那个佩尔西科夫研究员恐怕要吃苦头了。"
                },
                {
                    "id": "790230627",
                    "speaker": "叶夫卡",
                    "text": "我知道的也只有这么多了，我之前就跟<color=#00E1FFFF>别的队员</color>约好，完成测试任务，就要回海域中心岛屿的营地…"
                },
                {
                    "id": "790230628",
                    "speaker": "叶夫卡",
                    "text": "他们应该在<color=#00E1FFFF>北方的两个岛上</color>吧…按照任务的进度，应该在<color=#00E1FFFF>西北方的那个岛上</color>吧..."
                },
                {
                    "id": "790230629",
                    "speaker": "叶夫卡",
                    "text": "唉…要是让阿加霞看到雅科夫这个样子，非得生我的气不可…不过无论如何，我得赶紧把雅科夫带回去才行！"
                }
            ]
        },
        {
            "id": "7902307",
            "objective": "与叶夫卡对话",
            "dialogues": []
        },
        {
            "id": "7902308",
            "objective": "寻找雅科夫",
            "dialogues": [
                {
                    "id": "790230801",
                    "speaker": "雷锤前锋军",
                    "text": "都是因为我…都是因为我他才会那样…"
                },
                {
                    "id": "790230802",
                    "speaker": "雷锤前锋军",
                    "text": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…"
                },
                {
                    "id": "790230803",
                    "speaker": "派蒙",
                    "text": "喂，你在这里做什么呢！"
                },
                {
                    "id": "790230804",
                    "speaker": "雷锤前锋军",
                    "text": "徽记，徽记…"
                },
                {
                    "id": "790230805",
                    "speaker": "派蒙",
                    "text": "完全不理我们呢…"
                },
                {
                    "id": "790230806",
                    "speaker": "Player",
                    "text": "派蒙再叫大声一点吧！"
                },
                {
                    "id": "790230807",
                    "speaker": "派蒙",
                    "text": "这明显是听不到我们的话啦，喊再大声也没用…"
                },
                {
                    "id": "790230808",
                    "speaker": "派蒙",
                    "text": "根本就和阿加菲娅一开始的时候一模一样嘛，那个时候把带着合照的怀表给阿加菲娅以后，她就醒过来了。"
                },
                {
                    "id": "790230809",
                    "speaker": "派蒙",
                    "text": "这个雷锤前锋军，难道也有什么能让他从装置的影响里醒过来的东西吗？"
                },
                {
                    "id": "790230810",
                    "speaker": "派蒙",
                    "text": "#看来他好像一直在找什么徽记的样子…{NICKNAME}，看来得把他在找的徽记给他呀…"
                }
            ]
        },
        {
            "id": "7902309",
            "objective": "尝试唤醒雅科夫",
            "dialogues": [
                {
                    "id": "790232001",
                    "speaker": "留声机",
                    "text": "（留声机里播放着，让人能回想起温暖过去的话语……）"
                },
                {
                    "id": "790232002",
                    "speaker": "雅科夫",
                    "text": "啊…为什么…"
                },
                {
                    "id": "790232003",
                    "speaker": "叶夫卡",
                    "text": "雅科夫，雅科夫你醒醒啊！你怎么，怎么变成了这个样子…"
                },
                {
                    "id": "790232004",
                    "speaker": "派蒙",
                    "text": "你之前也是这个样子啦，而且还念叨着那个徽记呢！"
                },
                {
                    "id": "790232005",
                    "speaker": "叶夫卡",
                    "text": "哦，对哦，那个徽记…"
                },
                {
                    "id": "790232006",
                    "speaker": "叶夫卡",
                    "text": "雅科夫，你看，这是你的徽记。虽然你一气之下把它扔了，但是现在已经找到了…"
                },
                {
                    "id": "790232007",
                    "speaker": "叶夫卡",
                    "text": "这是你和你父亲一起获得的荣誉，现在已经重新回到你的手中了…怎么样，雅科夫，你醒过来了吗…"
                },
                {
                    "id": "790232030",
                    "speaker": "雅科夫",
                    "text": "为什么…为什么…为什么要抛下我一个人..."
                },
                {
                    "id": "790232008",
                    "speaker": "派蒙",
                    "text": "还是没有恢复呢…"
                },
                {
                    "id": "790232009",
                    "speaker": "叶夫卡",
                    "text": "难道这不是能唤醒他的东西吗…那他到底想要的是什么呀…"
                },
                {
                    "id": "790232010",
                    "speaker": "派蒙",
                    "text": "他想要的是什么，你居然不知道吗…你们不是队友嘛？"
                },
                {
                    "id": "790232011",
                    "speaker": "叶夫卡",
                    "text": "我…我一直以为他最重要的就是这份荣誉，不对，我错了，是「我以为」他觉得最重要的就是这个…"
                },
                {
                    "id": "790232012",
                    "speaker": "叶夫卡",
                    "text": "那是他和他父亲一起出一个紧急任务得来的，只不过他的父亲牺牲了，再也没有回来…"
                },
                {
                    "id": "790232013",
                    "speaker": "叶夫卡",
                    "text": "他的母亲在他出生的时候就去世了…失去父亲以后，他就变成了孤伶伶的一个人。"
                },
                {
                    "id": "790232014",
                    "speaker": "叶夫卡",
                    "text": "唉，他年纪比我小，得过的荣誉却比我多，说不定我只是一直在嫉妒他，也不知道如何和他相处，我唯一能够参照的就是…"
                },
                {
                    "id": "790232015",
                    "speaker": "派蒙",
                    "text": "不会是你父亲跟你相处的方式吧…"
                },
                {
                    "id": "790232016",
                    "speaker": "叶夫卡",
                    "text": "说来惭愧，但是确实如此…"
                },
                {
                    "id": "790232017",
                    "speaker": "派蒙",
                    "text": "这样不出问题才怪…"
                },
                {
                    "id": "790232018",
                    "speaker": "叶夫卡",
                    "text": "我们这支小队的休整处在海域中央的岛屿，现在雅科夫这个样子，我必须得先把他送到那边去才行。"
                },
                {
                    "id": "790232019",
                    "speaker": "叶夫卡",
                    "text": "哦，对了，我们…我们是受佩尔西科夫研究员指派，过来进行信号测试的成员。"
                },
                {
                    "id": "790232020",
                    "speaker": "叶夫卡",
                    "text": "据说是某位执行官大人在须弥得到了什么新的知识，可以通过一些技术，连接他人的意识，影响到一整片区域…"
                },
                {
                    "id": "790232021",
                    "speaker": "叶夫卡",
                    "text": "虽然不被看好，但是佩尔西科夫研究员还是强行开始了这次的实验，而我们则被指派前往海域各处进行装置的信号测试…"
                },
                {
                    "id": "790232022",
                    "speaker": "叶夫卡",
                    "text": "对了，不知道佩尔西科夫研究员的实验进行的如何了…"
                },
                {
                    "id": "790232023",
                    "speaker": "派蒙",
                    "text": "那还用问，我们出现在了这里，愚人众的实验…"
                },
                {
                    "id": "790232024",
                    "speaker": "Player",
                    "text": "当然是失败了！"
                },
                {
                    "id": "790232025",
                    "speaker": "叶夫卡",
                    "text": "是嘛，嘿嘿，这下那个佩尔西科夫研究员恐怕要吃苦头了。"
                },
                {
                    "id": "790232026",
                    "speaker": "叶夫卡",
                    "text": "我知道的也只有这么多了，我之前就跟别的队员约好，完成测试任务，就要回海域中心岛屿的营地…"
                },
                {
                    "id": "790232027",
                    "speaker": "派蒙",
                    "text": "啊，是之前碰到的愚人众！"
                },
                {
                    "id": "790232028",
                    "speaker": "叶夫卡",
                    "text": "是嘛，原来你们已经见过她们了呀…"
                },
                {
                    "id": "790232029",
                    "speaker": "叶夫卡",
                    "text": "唉…要是让阿加霞看到雅科夫这个样子，非得生我的气不可…不过无论如何，我得赶紧把雅科夫带回去才行！"
                }
            ]
        },
        {
            "id": "7902311",
            "objective": "",
            "dialogues": [
                {
                    "id": "790231101",
                    "speaker": "雷锤前锋军",
                    "text": "一定得找到那个徽记…一定得找到那个徽记才行啊…"
                },
                {
                    "id": "790231102",
                    "speaker": "Player",
                    "text": "（找到徽记再和他搭话吧…）"
                }
            ]
        },
        {
            "id": "7902312",
            "objective": "寻找另一个小队成员的线索",
            "dialogues": []
        },
        {
            "id": "7902315",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790231501",
                    "speaker": "叶夫卡",
                    "text": "还没有找到打开机关的办法吗…啊，不是在催你们的意思，怎么了，有什么事吗？",
                    "choices": [
                        {
                            "id": "790231502",
                            "text": "你们为什么会来群岛…",
                            "response": [
                                {
                                    "id": "790231503",
                                    "speaker": "叶夫卡",
                                    "text": "我们当然是为了完成光荣的使命，不过具体是什么…找到雅科夫之后，我再跟你说吧…"
                                }
                            ]
                        },
                        {
                            "id": "790231504",
                            "text": "那枚徽记…",
                            "response": [
                                {
                                    "id": "790231505",
                                    "speaker": "叶夫卡",
                                    "text": "你是说，那枚徽记明明不是我的，但是对它很熟悉，觉得很奇怪…"
                                },
                                {
                                    "id": "790231506",
                                    "speaker": "叶夫卡",
                                    "text": "那枚徽记是雅科夫的，他以前和自己的父亲一起去执行一项任务，但是回来的时候就只有他自己。"
                                },
                                {
                                    "id": "790231507",
                                    "speaker": "叶夫卡",
                                    "text": "那枚徽记就是那次任务之后得到的…我很羡慕他能够获得这样的荣誉，所以曾经借过来看过很多次。"
                                }
                            ]
                        },
                        {
                            "id": "790231508",
                            "text": "再见…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902321",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790232101",
                    "speaker": "叶夫卡",
                    "text": "#唉，雅科夫，雅科夫该怎么办啊…怎么了，{NICKNAME}，还有什么事吗…",
                    "choices": [
                        {
                            "id": "790232102",
                            "text": "你是怎么成为愚人众的…",
                            "response": [
                                {
                                    "id": "790232103",
                                    "speaker": "叶夫卡",
                                    "text": "怎么成为愚人众，你是说我吗…"
                                },
                                {
                                    "id": "790232104",
                                    "speaker": "叶夫卡",
                                    "text": "那当然是为了实现女皇大人的夙愿…以及为了我的家族能获得更多的荣誉，我从小就被教导要为女皇大人而战。"
                                }
                            ]
                        },
                        {
                            "id": "790232105",
                            "text": "关于雅科夫…",
                            "response": [
                                {
                                    "id": "790232106",
                                    "speaker": "叶夫卡",
                                    "text": "唉，雅科夫好像没有清醒过来的迹象…"
                                }
                            ]
                        },
                        {
                            "id": "790232107",
                            "text": "没什么事。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902322",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790232201",
                    "speaker": "雅科夫",
                    "text": "为什么…只留下我一个人…我的父亲啊…为什么…"
                },
                {
                    "id": "790232202",
                    "speaker": "Player",
                    "text": "（看来还是不太清醒的样子…）"
                }
            ]
        },
        {
            "id": "7902327",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790232701",
                    "speaker": "叶夫卡",
                    "text": "呼呼…刚才的究竟是什么呢，真是没有办法理解。"
                },
                {
                    "id": "790232702",
                    "speaker": "叶夫卡",
                    "text": "怎么样，你们找到雅科夫了吗…"
                }
            ]
        }
    ]
}