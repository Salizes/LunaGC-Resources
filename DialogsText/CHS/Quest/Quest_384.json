    "talks": [
        {
            "id": "38401",
            "objective": "(test)等待夜幕降临后（18~6点时前往摘星崖）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "38402",
            "objective": "前往摘星崖",
            "dialogues": [
                {
                    "id": "3840201",
                    "speaker": "迪卢克",
                    "text": "哦，这下人都到齐了。"
                },
                {
                    "id": "3840202",
                    "speaker": "派蒙",
                    "text": "这个地方，风景真漂亮啊。"
                },
                {
                    "id": "3840203",
                    "speaker": "温迪",
                    "text": "和「命运的再会」这个主题很配吧？"
                },
                {
                    "id": "3840204",
                    "speaker": "温迪",
                    "text": "那么，该准备开始了。"
                },
                {
                    "id": "3840205",
                    "speaker": "琴",
                    "text": "嗯，不论结果如何，至少已经看到了转机。"
                },
                {
                    "id": "3840206",
                    "speaker": "琴",
                    "text": "这段时间，整座蒙德城都背负了太多…"
                },
                {
                    "id": "3840207",
                    "speaker": "迪卢克",
                    "text": "只是到头来，解决问题的却是旅行者和一个歌手。"
                },
                {
                    "id": "3840208",
                    "speaker": "迪卢克",
                    "text": "呵。骑士团勉强算是有些苦劳吧。"
                },
                {
                    "id": "3840209",
                    "speaker": "温迪",
                    "text": "好啦好啦。大家都站开一些——"
                },
                {
                    "id": "3840210",
                    "speaker": "温迪",
                    "text": "尘世间最好的吟游诗人，要开始拨动他的琴弦了。"
                }
            ]
        },
        {
            "id": "38403",
            "objective": "与温迪对话",
            "dialogues": []
        },
        {
            "id": "38404",
            "objective": "(test)等待温迪召唤风魔龙$HIDDEN",
            "dialogues": [
                {
                    "id": "3840401",
                    "speaker": "琴",
                    "text": "巴——温迪阁下，请注意保护好自己。"
                },
                {
                    "id": "3840402",
                    "speaker": "温迪",
                    "text": "哈哈…其实你不是现在才猜出那个身份的吧，琴？"
                },
                {
                    "id": "3840403",
                    "speaker": "温迪",
                    "text": "不过，谢谢你继续用这个名字叫我。"
                },
                {
                    "id": "3840404",
                    "speaker": "迪卢克",
                    "text": "天空之琴怎么样了？"
                },
                {
                    "id": "3840405",
                    "speaker": "迪卢克",
                    "text": "还能弹奏吗？…或者，还能用龙的泪滴修复吗？"
                },
                {
                    "id": "3840406",
                    "speaker": "温迪",
                    "text": "唔…"
                },
                {
                    "id": "3840407",
                    "speaker": "温迪",
                    "text": "坏成这副样子的话…可能就没办法了呢。",
                    "choices": [
                        {
                            "id": "3840408",
                            "text": "不能就这样放过深渊法师。",
                            "response": [
                                {
                                    "id": "3840409",
                                    "speaker": "迪卢克",
                                    "text": "没错，如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。"
                                },
                                {
                                    "id": "3840413",
                                    "speaker": "琴",
                                    "text": "那么，我召集侦察骑士来追踪…"
                                },
                                {
                                    "id": "3840414",
                                    "speaker": "迪卢克",
                                    "text": "不必了。"
                                },
                                {
                                    "id": "3840415",
                                    "speaker": "琴",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "3840416",
                                    "speaker": "迪卢克",
                                    "text": "不久前我在四风守护的神庙遗迹，亲手斩杀过它的一只同类。"
                                },
                                {
                                    "id": "3840417",
                                    "speaker": "派蒙",
                                    "text": "咦？！是什么时候…"
                                },
                                {
                                    "id": "3840418",
                                    "speaker": "迪卢克",
                                    "text": "想要追踪那些怪物的话，可以借助我的情报网和手段。"
                                },
                                {
                                    "id": "3840419",
                                    "speaker": "派蒙",
                                    "text": "迪卢克…"
                                },
                                {
                                    "id": "3840420",
                                    "speaker": "派蒙",
                                    "text": "虽然讨厌骑士团，但会用自己的方式来守护蒙德呢。"
                                },
                                {
                                    "id": "3840421",
                                    "speaker": "温迪",
                                    "text": "小派蒙的语气，突然变得溺爱了起来…！"
                                },
                                {
                                    "id": "3840422",
                                    "speaker": "迪卢克",
                                    "text": "哼。"
                                },
                                {
                                    "id": "3840423",
                                    "speaker": "迪卢克",
                                    "text": "总之，等我消息吧。"
                                },
                                {
                                    "id": "3840424",
                                    "speaker": "迪卢克",
                                    "text": "我要让它们明白，不论深渊教团再怎么无法无天…"
                                },
                                {
                                    "id": "3840425",
                                    "speaker": "迪卢克",
                                    "text": "在蒙德，有些事也是不可以做的。"
                                }
                            ]
                        },
                        {
                            "id": "3840410",
                            "text": "特瓦林的情况很危险…",
                            "response": [
                                {
                                    "id": "3840411",
                                    "speaker": "迪卢克",
                                    "text": "但首先要让罪魁祸首付出代价。"
                                },
                                {
                                    "id": "3840412",
                                    "speaker": "迪卢克",
                                    "text": "如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "38405",
            "objective": "(test)突然出现的不速之客是…$HIDDEN",
            "dialogues": []
        },
        {
            "id": "38406",
            "objective": "(test)cutscene哥哥/妹妹登场$HIDDEN",
            "dialogues": [
                {
                    "id": "3840601",
                    "speaker": "温迪",
                    "text": "咦？这是什么…"
                },
                {
                    "id": "3840602",
                    "speaker": "温迪",
                    "text": "深渊法师被击败以后，散逸出了某种能量…"
                },
                {
                    "id": "3840603",
                    "speaker": "温迪",
                    "text": "这种能量原本的用途，似乎是隔绝我和特瓦林之间的联系。"
                },
                {
                    "id": "3840604",
                    "speaker": "温迪",
                    "text": "……"
                },
                {
                    "id": "3840605",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}，你知道「<color=#00E1FFFF>风龙废墟</color>」吗？",
                    "choices": [
                        {
                            "id": "3840606",
                            "text": "不知道。",
                            "response": [
                                {
                                    "id": "3840607",
                                    "speaker": "温迪",
                                    "text": "嗯，但琴团长和迪卢克老爷想必都是知道的。"
                                },
                                {
                                    "id": "3840612",
                                    "speaker": "温迪",
                                    "text": "没错。"
                                },
                                {
                                    "id": "3840613",
                                    "speaker": "温迪",
                                    "text": "现在的特瓦林，正居住在一片被它当作巢穴的废墟里。"
                                },
                                {
                                    "id": "3840614",
                                    "speaker": "温迪",
                                    "text": "与封锁蒙德四方的暴风一样，巢穴的入口也有很难通过的特殊障壁。"
                                },
                                {
                                    "id": "3840615",
                                    "speaker": "温迪",
                                    "text": "但现在，从深渊法师散逸的能量里，我能读出编织魔力的韵律。"
                                },
                                {
                                    "id": "3840616",
                                    "speaker": "温迪",
                                    "text": "虽然那种韵律比丘丘人的合唱还要难听，但…"
                                },
                                {
                                    "id": "3840617",
                                    "speaker": "温迪",
                                    "text": "也足够让我们破除暴风障壁、抵达特瓦林的「<color=#00E1FFFF>风龙废墟</color>」了。"
                                },
                                {
                                    "id": "3840618",
                                    "speaker": "迪卢克",
                                    "text": "那么，是要正面挑战特瓦林了么？"
                                },
                                {
                                    "id": "3840619",
                                    "speaker": "迪卢克",
                                    "text": "我倒是没有意见…话说回来，琴才是那个想要避免开战的人。"
                                },
                                {
                                    "id": "3840620",
                                    "speaker": "琴",
                                    "text": "不。在没有更好的选择时，就由我承担改变方针的责任。"
                                },
                                {
                                    "id": "3840621",
                                    "speaker": "琴",
                                    "text": "如果讨伐风龙是唯一的方案，那我就会成为冲锋在前的骑士。"
                                },
                                {
                                    "id": "3840622",
                                    "speaker": "温迪",
                                    "text": "现在还没到那一步喔。"
                                },
                                {
                                    "id": "3840623",
                                    "speaker": "迪卢克",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "3840624",
                                    "speaker": "琴",
                                    "text": "温迪阁下的意思是…"
                                },
                                {
                                    "id": "3840625",
                                    "speaker": "温迪",
                                    "text": "我的意思是，天空之琴不是我们的底牌。"
                                },
                                {
                                    "id": "3840626",
                                    "speaker": "温迪",
                                    "text": "#真正的底牌——是{NICKNAME}呀。"
                                },
                                {
                                    "id": "3840627",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "3840628",
                                            "text": "是因为我净化了泪滴结晶吗？"
                                        },
                                        {
                                            "id": "3840630",
                                            "text": "是因为我很能打吗？",
                                            "response": [
                                                {
                                                    "id": "3840631",
                                                    "speaker": "温迪",
                                                    "text": "#唔嗯…当然，{NICKNAME}的战力是很强的。"
                                                },
                                                {
                                                    "id": "3840632",
                                                    "speaker": "温迪",
                                                    "text": "但在你的身上，还有更珍贵的闪光点。"
                                                },
                                                {
                                                    "id": "3840633",
                                                    "speaker": "温迪",
                                                    "text": "刚才触碰深渊法师散逸的魔力时，我已经明白了。"
                                                },
                                                {
                                                    "id": "3840634",
                                                    "speaker": "温迪",
                                                    "text": "泪滴里的污秽杂质，和缠绕在特瓦林身上的诅咒，是同一种超凡力量。"
                                                },
                                                {
                                                    "id": "3840635",
                                                    "speaker": "温迪",
                                                    "text": "在对蒙德的进攻中，它体内远古的「风」之魔力已经枯竭。"
                                                },
                                                {
                                                    "id": "3840636",
                                                    "speaker": "温迪",
                                                    "text": "#现在的情况，已经与{NICKNAME}第一次见到它的时候完全不同了。"
                                                },
                                                {
                                                    "id": "3840637",
                                                    "speaker": "温迪",
                                                    "text": "特瓦林之所以还能行动，只是依靠诅咒力量作为燃料而已。"
                                                },
                                                {
                                                    "id": "3840638",
                                                    "speaker": "温迪",
                                                    "text": "所以——"
                                                },
                                                {
                                                    "id": "3840639",
                                                    "speaker": "派蒙",
                                                    "text": "不行不行！卖唱的，这太危险了！"
                                                },
                                                {
                                                    "id": "3840640",
                                                    "speaker": "派蒙",
                                                    "text": "#你看特瓦林发火的样子，{NICKNAME}动手之前就会被特瓦林一口吞掉吧！",
                                                    "choices": [
                                                        {
                                                            "id": "3840641",
                                                            "text": "都说了我很能打。",
                                                            "response": [
                                                                {
                                                                    "id": "3840643",
                                                                    "speaker": "迪卢克",
                                                                    "text": "…嘿。"
                                                                },
                                                                {
                                                                    "id": "3840644",
                                                                    "speaker": "迪卢克",
                                                                    "text": "有趣的计划，值得尝试。"
                                                                },
                                                                {
                                                                    "id": "3840645",
                                                                    "speaker": "琴",
                                                                    "text": "我也当然会与你同在，荣誉骑士。"
                                                                },
                                                                {
                                                                    "id": "3840646",
                                                                    "speaker": "派蒙",
                                                                    "text": "感觉会是一场非常惊人的战斗…"
                                                                },
                                                                {
                                                                    "id": "3840647",
                                                                    "speaker": "派蒙",
                                                                    "text": "敌人是…深渊的怪物，和龙！压迫感很强呢。"
                                                                },
                                                                {
                                                                    "id": "3840648",
                                                                    "speaker": "迪卢克",
                                                                    "text": "人类也有人类的底蕴。我们走吧。"
                                                                },
                                                                {
                                                                    "id": "3840649",
                                                                    "speaker": "温迪",
                                                                    "text": "那么——"
                                                                },
                                                                {
                                                                    "id": "3840650",
                                                                    "speaker": "温迪",
                                                                    "text": "英雄的诗篇，终于进入决战的篇章啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3840642",
                                                            "text": "这一战需要借助大家的力量。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3840608",
                            "text": "似乎在蒙德城里听人提起过。",
                            "response": [
                                {
                                    "id": "3840609",
                                    "speaker": "温迪",
                                    "text": "嗯，同样来自蒙德的各位，想必都是知道的。"
                                }
                            ]
                        },
                        {
                            "id": "3840610",
                            "text": "之前试着进入时，被…",
                            "response": [
                                {
                                    "id": "3840611",
                                    "speaker": "Player",
                                    "text": "之前试着进入时，被暴风的障壁挡住了前进的道路。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}