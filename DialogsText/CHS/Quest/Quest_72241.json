        "rewards_formatted": "冒险阅历 x250, 原石 x30, 大英雄的经验 x3, 摩拉 x30000",
        "chapter": {
            "icon": "UI_ChapterIcon_Common",
            "id": "10060",
            "num": "",
            "title": "许伯利翁哀歌"
        },
        "total_dialogue_lines": 118,
        "total_speaker_counts": {
