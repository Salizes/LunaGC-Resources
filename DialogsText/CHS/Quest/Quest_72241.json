    "talks": [
        {
            "id": "7224102",
            "objective": "",
            "dialogues": [
                {
                    "id": "722410201",
                    "speaker": "阿倍良久",
                    "text": "啊啊…异乡的旅者，是汝啊。"
                },
                {
                    "id": "722410202",
                    "speaker": "阿倍良久",
                    "text": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。"
                },
                {
                    "id": "722410203",
                    "speaker": "阿倍良久",
                    "text": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。"
                },
                {
                    "id": "722410204",
                    "speaker": "阿倍良久",
                    "text": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。"
                },
                {
                    "id": "722410205",
                    "speaker": "阿倍良久",
                    "text": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」"
                },
                {
                    "id": "722410206",
                    "speaker": "阿倍良久",
                    "text": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。"
                },
                {
                    "id": "722410207",
                    "speaker": "阿倍良久",
                    "text": "可悲啊，那本来应是吾铭记于心之景。"
                },
                {
                    "id": "722410208",
                    "speaker": "阿倍良久",
                    "text": "只可惜…"
                },
                {
                    "id": "722410209",
                    "speaker": "派蒙",
                    "text": "可惜？"
                },
                {
                    "id": "722410210",
                    "speaker": "阿倍良久",
                    "text": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。"
                },
                {
                    "id": "722410211",
                    "speaker": "阿倍良久",
                    "text": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。"
                },
                {
                    "id": "722410212",
                    "speaker": "阿倍良久",
                    "text": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！"
                },
                {
                    "id": "722410213",
                    "speaker": "阿倍良久",
                    "text": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。"
                },
                {
                    "id": "722410214",
                    "speaker": "阿倍良久",
                    "text": "到了最后…甚至推举「太阳{RUBY#[D]法厄同}之子」以统治白夜之国。"
                },
                {
                    "id": "722410215",
                    "speaker": "Player",
                    "text": "太阳之子？"
                },
                {
                    "id": "722410216",
                    "speaker": "阿倍良久",
                    "text": "正是，每一任，都会有一位稚童被选作太阳之子。"
                },
                {
                    "id": "722410217",
                    "speaker": "阿倍良久",
                    "text": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。"
                },
                {
                    "id": "722410218",
                    "speaker": "阿倍良久",
                    "text": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…"
                },
                {
                    "id": "722410219",
                    "speaker": "派蒙",
                    "text": "啊，太阳之子…"
                },
                {
                    "id": "722410220",
                    "speaker": "派蒙",
                    "text": "那岂不是总有一天，他会知道自己被人摆布…"
                },
                {
                    "id": "722410221",
                    "speaker": "阿倍良久",
                    "text": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。"
                },
                {
                    "id": "722410222",
                    "speaker": "阿倍良久",
                    "text": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」",
                    "choices": [
                        {
                            "id": "722410223",
                            "text": "难道说…",
                            "response": [
                                {
                                    "id": "722410225",
                                    "speaker": "阿倍良久",
                                    "text": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…"
                                },
                                {
                                    "id": "722410226",
                                    "speaker": "阿倍良久",
                                    "text": "…藏于此处的物件，就与他们有关。"
                                },
                                {
                                    "id": "722410227",
                                    "speaker": "阿倍良久",
                                    "text": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。"
                                },
                                {
                                    "id": "722410228",
                                    "speaker": "阿倍良久",
                                    "text": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。"
                                },
                                {
                                    "id": "722410229",
                                    "speaker": "阿倍良久",
                                    "text": "吾乃…"
                                },
                                {
                                    "id": "722410230",
                                    "speaker": "阿倍良久",
                                    "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
                                },
                                {
                                    "id": "722410231",
                                    "speaker": "阿倍良久",
                                    "text": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。"
                                },
                                {
                                    "id": "722410232",
                                    "speaker": "阿倍良久",
                                    "text": "吾有如此才能，如此才能啊！"
                                },
                                {
                                    "id": "722410233",
                                    "speaker": "阿倍良久",
                                    "text": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。"
                                },
                                {
                                    "id": "722410234",
                                    "speaker": "阿倍良久",
                                    "text": "异乡的旅客，吾现在将此御辔交至汝之手中。"
                                },
                                {
                                    "id": "722410235",
                                    "speaker": "阿倍良久",
                                    "text": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…"
                                },
                                {
                                    "id": "722410236",
                                    "speaker": "阿倍良久",
                                    "text": "请务必好好留存…不，就随汝喜好处置吧。"
                                },
                                {
                                    "id": "722410237",
                                    "speaker": "Player",
                                    "text": "过于贵重了…"
                                },
                                {
                                    "id": "722410238",
                                    "speaker": "阿倍良久",
                                    "text": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。"
                                },
                                {
                                    "id": "722410239",
                                    "speaker": "阿倍良久",
                                    "text": "如此才能…如此才能啊…"
                                }
                            ]
                        },
                        {
                            "id": "722410224",
                            "text": "在某个生日…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224103",
            "objective": "",
            "dialogues": [
                {
                    "id": "722410301",
                    "speaker": "阿倍良久",
                    "text": "啊…烦请汝取回位于狭间之街，灵庙之前与蛇心之地三处的供奉。这样，吾魂魄归一，即可打开大日御舆之上的道路…"
                }
            ]
        },
        {
            "id": "7224104",
            "objective": "",
            "dialogues": [
                {
                    "id": "722410401",
                    "speaker": "派蒙",
                    "text": "供奉完成了…"
                },
                {
                    "id": "722410402",
                    "speaker": "派蒙",
                    "text": "之前听残魂先生的说法，献祭能够打开大日御舆之上的道路…"
                },
                {
                    "id": "722410403",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，不如我们快上去看一下吧！"
                }
            ]
        },
        {
            "id": "7224105",
            "objective": "",
            "dialogues": [
                {
                    "id": "722410501",
                    "speaker": "派蒙",
                    "text": "供奉完成了…"
                },
                {
                    "id": "722410502",
                    "speaker": "派蒙",
                    "text": "之前听残魂先生的说法，献祭能够打开大日御舆之上的道路…"
                },
                {
                    "id": "722410503",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，不如我们快上去看一下吧！"
                }
            ]
        },
        {
            "id": "7224106",
            "objective": "",
            "dialogues": [
                {
                    "id": "722410601",
                    "speaker": "阿倍良久",
                    "text": "吾乃…"
                },
                {
                    "id": "722410602",
                    "speaker": "阿倍良久",
                    "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
                },
                {
                    "id": "722410603",
                    "speaker": "派蒙",
                    "text": "我、我是派蒙。",
                    "choices": [
                        {
                            "id": "722410604",
                            "text": "在这里自我介绍？",
                            "response": [
                                {
                                    "id": "722410605",
                                    "speaker": "派蒙",
                                    "text": "在对方报上名字的时候，你也要报上名字……"
                                },
                                {
                                    "id": "722410606",
                                    "speaker": "派蒙",
                                    "text": "据说是有这样的礼节的。"
                                },
                                {
                                    "id": "722410607",
                                    "speaker": "阿倍良久",
                                    "text": "无妨。汝等远道而来，吾以此狼狈姿态，亦无法进行接待，也是失礼之至。"
                                },
                                {
                                    "id": "722410608",
                                    "speaker": "派蒙",
                                    "text": "#没有关系，{NICKNAME}和我也不会介意的。"
                                },
                                {
                                    "id": "722410613",
                                    "speaker": "派蒙",
                                    "text": "不过，这位残魂先生为什么会留在这里呢？"
                                },
                                {
                                    "id": "722410614",
                                    "speaker": "阿倍良久",
                                    "text": "吾…吾乃赫利俄斯的建造者，此处为…吾殒命之处。"
                                },
                                {
                                    "id": "722410615",
                                    "speaker": "阿倍良久",
                                    "text": "在黑暗冰冷之所，昏昏睡去便再无法醒来…吾怎可这样死去，吾可是，赫利俄斯之建造者！"
                                },
                                {
                                    "id": "722410616",
                                    "speaker": "派蒙",
                                    "text": "赫利俄斯的建造者？"
                                },
                                {
                                    "id": "722410617",
                                    "speaker": "派蒙",
                                    "text": "赫利俄斯是什么呀？"
                                },
                                {
                                    "id": "722410618",
                                    "speaker": "阿倍良久",
                                    "text": "啊…是了，赫利俄斯只是建造时吾私下的称谓。"
                                },
                                {
                                    "id": "722410619",
                                    "speaker": "阿倍良久",
                                    "text": "虽然不知汝等是否知晓，不过，白夜国民所熟知的名字是…"
                                },
                                {
                                    "id": "722410620",
                                    "speaker": "阿倍良久",
                                    "text": "大日御舆。"
                                },
                                {
                                    "id": "722410621",
                                    "speaker": "阿倍良久",
                                    "text": "赫利俄斯即大日御舆，运载「许伯{RUBY#[D]白夜之光}利翁」的太阳之车。",
                                    "choices": [
                                        {
                                            "id": "722410622",
                                            "text": "大日御舆的建造者？",
                                            "response": [
                                                {
                                                    "id": "722410624",
                                                    "speaker": "阿倍良久",
                                                    "text": "正是吾。"
                                                },
                                                {
                                                    "id": "722410625",
                                                    "speaker": "阿倍良久",
                                                    "text": "异乡的旅者啊…吾虽建造大日御舆，却被人幽禁，幽禁在了大日御舆之上。"
                                                },
                                                {
                                                    "id": "722410626",
                                                    "speaker": "阿倍良久",
                                                    "text": "死去之后，魂魄离散于白夜国各地，甚至记忆也有所散佚。"
                                                },
                                                {
                                                    "id": "722410627",
                                                    "speaker": "阿倍良久",
                                                    "text": "吾记得有很重要的东西…有很重要的东西在大日御舆之上…"
                                                },
                                                {
                                                    "id": "722410628",
                                                    "speaker": "阿倍良久",
                                                    "text": "但吾忘记了，异乡的旅者啊，拜托汝…取回我被供奉于三处的衣、冠与骸骨。"
                                                },
                                                {
                                                    "id": "722410629",
                                                    "speaker": "阿倍良久",
                                                    "text": "分别在狭间之街、灵庙之前与蛇心之地。"
                                                },
                                                {
                                                    "id": "722410630",
                                                    "speaker": "阿倍良久",
                                                    "text": "将之供奉于三座祭台之上…这样，吾魂魄归一，即可打开通向大日御舆之上的道路…"
                                                },
                                                {
                                                    "id": "722410631",
                                                    "speaker": "阿倍良久",
                                                    "text": "通往大日御舆之上，被隐藏于常夜帷幕的幽闭之间…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722410623",
                                            "text": "就是你？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722410609",
                            "text": "吾乃…",
                            "response": [
                                {
                                    "id": "722410610",
                                    "speaker": "阿倍良久",
                                    "text": "……是么，竟是来自异乡的旅客啊。"
                                },
                                {
                                    "id": "722410611",
                                    "speaker": "阿倍良久",
                                    "text": "汝远道而来，吾以此狼狈姿态，亦无法进行接待。"
                                },
                                {
                                    "id": "722410612",
                                    "speaker": "派蒙",
                                    "text": "没关系的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
