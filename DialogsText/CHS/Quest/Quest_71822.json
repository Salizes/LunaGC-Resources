    "talks": [
        {
            "id": "7182201",
            "objective": "与索拉雅对话",
            "dialogues": [
                {
                    "id": "718220101",
                    "speaker": "索拉雅",
                    "text": "天衡山…移霄导天真君…嗯…"
                },
                {
                    "id": "718220102",
                    "speaker": "Player",
                    "text": "你在想什么呢？"
                },
                {
                    "id": "718220103",
                    "speaker": "索拉雅",
                    "text": "啊，我正在研究璃月海灯节的历史和传说呢。"
                },
                {
                    "id": "718220104",
                    "speaker": "索拉雅",
                    "text": "我听说这次的「明霄灯」的造型，会是一位名叫「移霄导天真君」的仙人。"
                },
                {
                    "id": "718220105",
                    "speaker": "索拉雅",
                    "text": "根据我搜集到的传说，那位仙人似乎也在某段时间里跟随「岩王帝君」征战…"
                },
                {
                    "id": "718220106",
                    "speaker": "索拉雅",
                    "text": "虽然具体时间和面对的敌人在各种文献中有各种不同的说法…"
                },
                {
                    "id": "718220107",
                    "speaker": "索拉雅",
                    "text": "但在各类记载和在坊间流传的说法中，都一致指出这位仙人已经牺牲了。而且这位仙人还以自己的角支撑起了天衡山。"
                },
                {
                    "id": "718220108",
                    "speaker": "索拉雅",
                    "text": "所以，我来天衡山，想要实地考察一下，想着如果运气够好，说不定能够找到些什么…"
                },
                {
                    "id": "718220109",
                    "speaker": "索拉雅",
                    "text": "但天衡山里的魔物众多，我确定了考察地点之后，却发现通往那里的路上都是魔物，压根过不去…"
                },
                {
                    "id": "718220110",
                    "speaker": "索拉雅",
                    "text": "旅行者，如果你愿意的话，能不能请你帮我去那边搜索一下，帮我带些「土质样本」回来？"
                },
                {
                    "id": "718220111",
                    "speaker": "Player",
                    "text": "土质…样本？"
                },
                {
                    "id": "718220112",
                    "speaker": "索拉雅",
                    "text": "嗯…这是教令院里的说法，其实就是那片区域里的土壤啦。"
                },
                {
                    "id": "718220113",
                    "speaker": "索拉雅",
                    "text": "既然在璃月的传说中，那位「移霄导天真君」用自己的角支撑起了天衡山…"
                },
                {
                    "id": "718220114",
                    "speaker": "索拉雅",
                    "text": "那么从学术角度来说，我认为地质成分中也许会存在一些不同寻常的成分。"
                },
                {
                    "id": "718220115",
                    "speaker": "索拉雅",
                    "text": "所以，请你帮我去那里，取一份土壤回来吧。"
                }
            ]
        },
        {
            "id": "7182202",
            "objective": "取回「土质样本」",
            "dialogues": [
                {
                    "id": "718220201",
                    "speaker": "索拉雅",
                    "text": "鹿角…天衡山…唔，如果是真的话…"
                }
            ]
        },
        {
            "id": "7182203",
            "objective": "向索拉雅回报",
            "dialogues": [
                {
                    "id": "718220301",
                    "speaker": "索拉雅",
                    "text": "你把样本带回来了吗？"
                },
                {
                    "id": "718220302",
                    "speaker": "Player",
                    "text": "已经带回来了。"
                },
                {
                    "id": "718220303",
                    "speaker": "索拉雅",
                    "text": "辛苦你了，请给我看一下。"
                },
                {
                    "id": "718220304",
                    "speaker": "索拉雅",
                    "text": "…唔，这份土壤好像也没什么特别的。"
                },
                {
                    "id": "718220305",
                    "speaker": "Player",
                    "text": "你想发现什么吗…"
                },
                {
                    "id": "718220306",
                    "speaker": "索拉雅",
                    "text": "根据传说，「移霄导天真君」是为了保护璃月港，用自己强壮的头角支起了即将倾颓的天衡山。"
                },
                {
                    "id": "718220307",
                    "speaker": "索拉雅",
                    "text": "我还以为，会至少发现一些「角」的碎片…"
                },
                {
                    "id": "718220308",
                    "speaker": "索拉雅",
                    "text": "果然传说也只是传说而已吗…或者说，那场大战距离现在的时间太远，痕迹也基本上消失了？"
                },
                {
                    "id": "718220309",
                    "speaker": "索拉雅",
                    "text": "但能够搜集到天衡山的土壤样本倒也不错…"
                },
                {
                    "id": "718220310",
                    "speaker": "索拉雅",
                    "text": "旅行者，你能再陪我一段路程吗？我想要再往上走走，倒也不会太远。",
                    "choices": [
                        {
                            "id": "718220311",
                            "text": "交给我了。",
                            "response": [
                                {
                                    "id": "718220313",
                                    "speaker": "索拉雅",
                                    "text": "这次…我想要去高处俯视一下天衡山，观察一下这里的地形。"
                                },
                                {
                                    "id": "718220314",
                                    "speaker": "索拉雅",
                                    "text": "在传说中，「岩王帝君」和许多仙人们都参与了那次大战，还险些导致天衡山倒塌。"
                                },
                                {
                                    "id": "718220315",
                                    "speaker": "索拉雅",
                                    "text": "如果战况激烈到那种程度…那我也许能从地形里观察出一些东西来。"
                                }
                            ]
                        },
                        {
                            "id": "718220312",
                            "text": "你又想去找什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182204",
            "objective": "沿着山路前行",
            "dialogues": []
        },
        {
            "id": "7182207",
            "objective": "打倒丘丘人（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7182205",
            "objective": "打倒丘丘人",
            "dialogues": []
        },
        {
            "id": "7182206",
            "objective": "与索拉雅对话",
            "dialogues": [
                {
                    "id": "718220601",
                    "speaker": "索拉雅",
                    "text": "总算到这里了…这路可真难走，还有这么多魔物…"
                },
                {
                    "id": "718220602",
                    "speaker": "索拉雅",
                    "text": "这周围的地形…好像也没什么特别的…"
                },
                {
                    "id": "718220603",
                    "speaker": "索拉雅",
                    "text": "咦？这棵树上是什么，一盏霄灯…"
                },
                {
                    "id": "718220604",
                    "speaker": "索拉雅",
                    "text": "这里怎么会有霄灯？难道有人来这里拜祭那位仙人了吗？"
                },
                {
                    "id": "718220605",
                    "speaker": "索拉雅",
                    "text": "我看看这盏霄灯里写了什么…"
                },
                {
                    "id": "718220606",
                    "speaker": "索拉雅",
                    "text": "「万世安泰，天下太平。」",
                    "choices": [
                        {
                            "id": "718220607",
                            "text": "是个很宏伟的愿望。",
                            "response": [
                                {
                                    "id": "718220609",
                                    "speaker": "索拉雅",
                                    "text": "确实。但这个愿望…怎么说呢，有点太过宏伟了？不像是拜祭，也不像是「愿望」。"
                                },
                                {
                                    "id": "718220610",
                                    "speaker": "索拉雅",
                                    "text": "反而像是那种…在璃月传说里的仙人们才会许的愿望。"
                                },
                                {
                                    "id": "718220611",
                                    "speaker": "索拉雅",
                                    "text": "到底是谁会在霄灯上许这种愿望呢？真奇怪…"
                                },
                                {
                                    "id": "718220612",
                                    "speaker": "索拉雅",
                                    "text": "唔，不管怎么说，至少有人还记得来这里放霄灯，那位仙人应该也会很高兴吧。"
                                },
                                {
                                    "id": "718220613",
                                    "speaker": "索拉雅",
                                    "text": "谢谢你陪我走了这么远的路，我还想在这里再研究一下…"
                                },
                                {
                                    "id": "718220614",
                                    "speaker": "索拉雅",
                                    "text": "对了，这些东西请你收下，就当做是报酬吧。"
                                },
                                {
                                    "id": "718220615",
                                    "speaker": "索拉雅",
                                    "text": "唉，璃月有这么多传说，但我的研究怎么就一点进展都没有呢…"
                                }
                            ]
                        },
                        {
                            "id": "718220608",
                            "text": "看起来不像是来拜祭的…"
                        }
                    ]
                }
            ]
        }
    ]
}