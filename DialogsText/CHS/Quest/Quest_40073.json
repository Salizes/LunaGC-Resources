    "talks": [
        {
            "id": "4007302",
            "objective": "寻找《圣国的咏唱》第三卷",
            "dialogues": [
                {
                    "id": "400730201",
                    "speaker": "神情严肃的夜鸦",
                    "text": "站住！又是你们！"
                },
                {
                    "id": "400730202",
                    "speaker": "派蒙",
                    "text": "干什么？我们可是皇女殿下的家臣。"
                },
                {
                    "id": "400730203",
                    "speaker": "眼神凛冽的夜鸦",
                    "text": "不不，胡言乱语！皇女殿下可不认得你们这种小人物。"
                },
                {
                    "id": "400730204",
                    "speaker": "莫娜",
                    "text": "哈？你能为自己说的话负责吗？"
                },
                {
                    "id": "400730205",
                    "speaker": "眼神凛冽的夜鸦",
                    "text": "我再说一次，皇女殿下可不认得你们这种…"
                },
                {
                    "id": "400730206",
                    "speaker": "？？？",
                    "text": "汝刚才说，谁是小人物？"
                },
                {
                    "id": "400730207",
                    "speaker": "神情严肃的夜鸦",
                    "text": "皇女殿下和奥兹大人？！"
                },
                {
                    "id": "400730208",
                    "speaker": "奥兹",
                    "text": "对幽夜净土的诸位臣子说出这种话，守卫先生们未免太冒犯了些。"
                },
                {
                    "id": "400730209",
                    "speaker": "菲谢尔",
                    "text": "哼。本皇女精心挑选的臣子，岂容汝等看轻？还不速速退下。"
                },
                {
                    "id": "400730210",
                    "speaker": "神情严肃的夜鸦",
                    "text": "可是…"
                },
                {
                    "id": "400730211",
                    "speaker": "菲谢尔",
                    "text": "没有可是！"
                },
                {
                    "id": "400730212",
                    "speaker": "眼神凛冽的夜鸦",
                    "text": "是、是！"
                },
                {
                    "id": "400730213",
                    "speaker": "派蒙",
                    "text": "菲谢尔，奥兹，你们归队啦！"
                },
                {
                    "id": "400730214",
                    "speaker": "菲谢尔",
                    "text": "嗯哼，汝暂且这样认为罢。"
                },
                {
                    "id": "400730215",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，我们花了不少时间才找到这里。虽说不愿面对这处幻境，但也不能抛下各位。"
                },
                {
                    "id": "400730216",
                    "speaker": "辛焱",
                    "text": "莫娜说对了呢，「不愿面对」。"
                },
                {
                    "id": "400730217",
                    "speaker": "派蒙",
                    "text": "有种日记本被人偷看的感觉对吧？"
                },
                {
                    "id": "400730218",
                    "speaker": "菲谢尔",
                    "text": "…肤浅。本皇女若真是轻易就能动摇之人，世上可不会有如此壮丽的幽夜净土。"
                },
                {
                    "id": "400730219",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，这里还有别的麻烦。"
                },
                {
                    "id": "400730220",
                    "speaker": "枫原万叶",
                    "text": "麻烦？你们遇到什么事了吗？"
                },
                {
                    "id": "400730221",
                    "speaker": "菲谢尔",
                    "text": "…呜…这件事稍后再议，先办正事。"
                },
                {
                    "id": "400730222",
                    "speaker": "辛焱",
                    "text": "动起来动起来，书就在眼前，可不能傻站着。"
                }
            ]
        },
        {
            "id": "4007321",
            "objective": "(test)(hide)销毁夜鸦雕像$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007303",
            "objective": "翻开《圣国的咏唱》第三卷",
            "dialogues": []
        },
        {
            "id": "4007322",
            "objective": "翻开《圣国的咏唱》第三卷",
            "dialogues": []
        },
        {
            "id": "4007304",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400730401",
                    "speaker": "菲谢尔",
                    "text": "呵…壮丽又脆弱，庞大又胆怯…令我赞叹，也让我作呕！"
                },
                {
                    "id": "400730402",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，从没见过这么夸张的幻境，即使是她本人也叹为观止。"
                }
            ]
        },
        {
            "id": "4007305",
            "objective": "修复桥梁",
            "dialogues": []
        },
        {
            "id": "4007306",
            "objective": "进入花园",
            "dialogues": [
                {
                    "id": "400730601",
                    "speaker": "派蒙",
                    "text": "这里有个城堡，但不完整。菲谢尔，这是你的东西吗？"
                },
                {
                    "id": "400730602",
                    "speaker": "菲谢尔",
                    "text": "唔…待本皇女思量片刻。"
                },
                {
                    "id": "400730603",
                    "speaker": "奥兹",
                    "text": "不必想了小姐，这正是您从前因悲伤过度不慎手滑打碎的城堡玩具。"
                },
                {
                    "id": "400730604",
                    "speaker": "菲谢尔",
                    "text": "奥兹！不要说出来！！"
                },
                {
                    "id": "400730605",
                    "speaker": "菲谢尔",
                    "text": "本皇女刚刚想起，有关我之皇城，可是缺失了两部分。"
                },
                {
                    "id": "400730606",
                    "speaker": "派蒙",
                    "text": "所以是要找两个碎片对吧？"
                }
            ]
        },
        {
            "id": "4007307",
            "objective": "寻找城堡模型的碎片",
            "dialogues": []
        },
        {
            "id": "4007308",
            "objective": "寻找城堡模型的碎片",
