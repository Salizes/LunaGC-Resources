        {
            "id": "4007311",
            "objective": "合上《圣国的咏唱》",
            "dialogues": []
        },
        {
            "id": "4007301",
            "objective": "合上《圣国的咏唱》",
            "dialogues": []
        },
        {
            "id": "4007315",
            "objective": "与「菲谢尔」对话",
            "dialogues": [
                {
                    "id": "400731501",
                    "speaker": "莫娜",
                    "text": "图书馆？我们在图书馆里？"
                },
                {
                    "id": "400731502",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731503",
                    "speaker": "菲谢尔",
                    "text": "…呵，我苦苦搜寻的宿敌，无为又懦弱的所谓皇女，就是你吗？"
                },
                {
                    "id": "400731504",
                    "speaker": "幽夜菲谢尔",
                    "text": "可笑。你又为什么觉得自己能够战胜我呢？要知道，你先前表现出的恐惧和犹豫，我可是看得一清二楚。"
                },
                {
                    "id": "400731505",
                    "speaker": "派蒙",
                    "text": "怎么还有一个你啊，是影子吗？"
                },
                {
                    "id": "400731506",
                    "speaker": "幽夜菲谢尔",
                    "text": "影子？对…我们之间确实如此。你是来向我投降的吗？小艾咪。"
                },
                {
                    "id": "400731507",
                    "speaker": "菲谢尔",
                    "text": "呜…你…"
                },
                {
                    "id": "400731508",
                    "speaker": "幽夜菲谢尔",
                    "text": "那边那位夜鸦，你是奥兹？很好，我也等待了许久。"
                },
                {
                    "id": "400731509",
                    "speaker": "幽夜菲谢尔",
                    "text": "听说，有位名叫奥兹的大书记官把《圣国的咏唱》带入幽夜净土。想必，就是你吧。"
                },
                {
                    "id": "400731510",
                    "speaker": "奥兹",
                    "text": "…诚惶诚恐，小姐。"
                },
                {
                    "id": "400731511",
                    "speaker": "辛焱",
                    "text": "你怎么叫她小姐？"
                },
                {
                    "id": "400731512",
                    "speaker": "奥兹",
                    "text": "如各位所见，那边的也是小姐。既是小姐，就是我奥兹的主人，不是吗？"
                },
                {
                    "id": "400731513",
                    "speaker": "枫原万叶",
                    "text": "…不无道理。"
                },
                {
                    "id": "400731514",
                    "speaker": "幽夜菲谢尔",
                    "text": "不妨告诉各位，幽夜净土是有来无回的地方。你们来到这里，就要被我征服，成为我的奴隶。"
                },
                {
                    "id": "400731515",
                    "speaker": "幽夜菲谢尔",
                    "text": "至于奥兹，虽然你带来令我不快的预言之书，还令愚蠢的臣民们疯狂朝拜那言之无物的东西，但…"
                },
                {
                    "id": "400731516",
                    "speaker": "幽夜菲谢尔",
                    "text": "你可是奥兹啊，那不如到我身边来。毕竟，「菲谢尔就是要与奥兹搭档的呢」。"
                },
                {
                    "id": "400731517",
                    "speaker": "奥兹",
                    "text": "感谢小姐的赏识，那我就恭敬不如从命了。"
                },
                {
                    "id": "400731518",
                    "speaker": "菲谢尔",
                    "text": "奥兹？！你去哪里？！"
                },
                {
                    "id": "400731519",
                    "speaker": "莫娜",
                    "text": "他居然去对面了，菲谢尔，这就是你养的好乌鸦？"
                },
                {
                    "id": "400731520",
                    "speaker": "菲谢尔",
                    "text": "呜啊啊啊现在不是数落我的时候吧！"
                },
                {
                    "id": "400731521",
                    "speaker": "菲谢尔",
                    "text": "奥兹，你被蛊惑了吗？为什么相信她说的话，幽夜净土不该是自由与戏剧的圣土吗？"
                },
                {
                    "id": "400731522",
                    "speaker": "幽夜菲谢尔",
                    "text": "大错特错。幽夜净土才不是那种儿童游乐园一样的地方。"
                },
                {
                    "id": "400731523",
                    "speaker": "幽夜菲谢尔",
                    "text": "听好了…它是为无法面对现实之人准备的坟墓。你会葬身此地，我则带着我们幻想出来的奥兹，永居王城。"
                },
                {
                    "id": "400731524",
                    "speaker": "菲谢尔",
                    "text": "…坟墓…"
                },
                {
                    "id": "400731525",
                    "speaker": "幽夜菲谢尔",
                    "text": "你应该最清楚才是。为什么幽夜净土下着雨？为什么这片乐土上没有真正的歌声？"
                },
                {
                    "id": "400731526",
                    "speaker": "菲谢尔",
                    "text": "…是因为你，就是你！"
                },
                {
                    "id": "400731527",
                    "speaker": "幽夜菲谢尔",
                    "text": "哦呵呵，太可笑了，你才是罪魁祸首吧！小艾咪！"
                },
                {
                    "id": "400731528",
                    "speaker": "菲谢尔",
                    "text": "呃…！"
                },
                {
                    "id": "400731529",
                    "speaker": "幽夜菲谢尔",
                    "text": "幻想出如此庞大的国度，却不能承受。对自身创造的事物感到动摇，就算再怎么逃避，也无法改变你自己。"
                },
                {
                    "id": "400731530",
                    "speaker": "幽夜菲谢尔",
                    "text": "是因为你无法真正抵达这里，我才降临于此，代行职责。幽夜净土现今是我的东西，轮不到你来指手画脚！"
                },
                {
                    "id": "400731531",
                    "speaker": "菲谢尔",
                    "text": "我…我…"
                },
                {
                    "id": "400731532",
                    "speaker": "幽夜菲谢尔",
                    "text": "小艾咪，你是一个软弱的傻瓜，不配拥有这个世界。滚出去吧。"
                },
                {
                    "id": "400731533",
                    "speaker": "辛焱",
                    "text": "喂，说够了没有！"
                },
                {
                    "id": "400731534",
                    "speaker": "莫娜",
                    "text": "自己骂自己还能骂得这么精彩，看来这件事困扰你很久了呢。"
                },
                {
                    "id": "400731535",
                    "speaker": "菲谢尔",
                    "text": "莫娜…呜呜…"
                },
                {
                    "id": "400731536",
                    "speaker": "莫娜",
                    "text": "你这是什么表情？"
                },
                {
                    "id": "400731537",
                    "speaker": "菲谢尔",
                    "text": "我…我…"
                },
                {
                    "id": "400731538",
                    "speaker": "莫娜",
                    "text": "哼。你该不会要认输吧？"
                },
                {
                    "id": "400731539",
                    "speaker": "菲谢尔",
                    "text": "…我不想承认，可是…她说的，也许没错…"
                },
                {
                    "id": "400731540",
                    "speaker": "枫原万叶",
                    "text": "不，请别这么想。皇女殿下，还记得我们为何来到这里吗？"
                },
                {
                    "id": "400731541",
                    "speaker": "菲谢尔",
                    "text": "万叶…"
                },
                {
                    "id": "400731542",
                    "speaker": "枫原万叶",
                    "text": "我是来自稻妻的剑客，负责守护你的安全。至于这几位，也都应你呼唤而来。"
                },
                {
                    "id": "400731543",
                    "speaker": "辛焱",
                    "text": "有自己的坟墓，听起来也挺酷的。但很可惜，幽夜净土不是坟墓。"
                },
                {
                    "id": "400731544",
                    "speaker": "菲谢尔",
                    "text": "辛焱…"
                },
                {
                    "id": "400731545",
                    "speaker": "幽夜菲谢尔",
                    "text": "…哦，交到朋友了呢。但你以为这样就能赢过我？"
                },
                {
                    "id": "400731546",
                    "speaker": "幽夜菲谢尔",
                    "text": "我可是你的恐惧与黑暗，是你这么多年来始终无法逃避的噩梦，在我面前，你一无是处。"
                },
                {
                    "id": "400731547",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731548",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731549",
                    "speaker": "菲谢尔",
                    "text": "…不对。我不能…我…还不能输。"
                },
                {
                    "id": "400731550",
                    "speaker": "菲谢尔",
                    "text": "我才是赢家！给我等着，你会后悔的！"
                }
            ]
        },
        {
            "id": "4007316",
            "objective": "前往高台处",
            "dialogues": []
        },
        {
            "id": "4007317",
            "objective": "与「幽夜菲谢尔」对话",
            "dialogues": [
                {
                    "id": "400731701",
                    "speaker": "幽夜菲谢尔",
                    "text": "不可能，你竟然能通过那个噩梦般的图书馆…给我退下！"
                },
                {
                    "id": "400731702",
                    "speaker": "菲谢尔",
                    "text": "…现在，你还觉得我会输吗？"
                },
                {
                    "id": "400731703",
                    "speaker": "幽夜菲谢尔",
                    "text": "你…！"
                },
                {
                    "id": "400731704",
                    "speaker": "菲谢尔",
                    "text": "你看不起我，觉得我懦弱，渺小。"
                },
                {
                    "id": "400731705",
                    "speaker": "菲谢尔",
                    "text": "我是有过那样的日子，因为…我是一个不能面对现实，成天做白日梦还不堪一击的人。"
                },
                {
                    "id": "400731706",
                    "speaker": "菲谢尔",
                    "text": "可现在我明白了，在看到这片幻境的一瞬间，我就想明白了。"
                },
                {
                    "id": "400731707",
                    "speaker": "菲谢尔",
                    "text": "看到外面那么惊人的幻象了吗？无比庞大，无比美丽…这就是我的想象力，我力量的根源。"
                },
                {
                    "id": "400731708",
                    "speaker": "菲谢尔",
                    "text": "你似乎很自大，黑暗的东西总是很狂妄。但不应该是这样的。"
                },
                {
                    "id": "400731709",
                    "speaker": "菲谢尔",
                    "text": "你根本不是一个完整的皇女，只是钻在我影子里沾沾自喜的灰尘！你才是失败者，那个拖我后腿的人！"
                },
                {
                    "id": "400731710",
                    "speaker": "幽夜菲谢尔",
                    "text": "呜！"
                },
                {
                    "id": "400731711",
                    "speaker": "菲谢尔",
                    "text": "懦弱，所以浑身尖刺，胆小，所以靠自暴自弃来伪装。这样的你…比我更弱小。"
                },
                {
                    "id": "400731712",
                    "speaker": "菲谢尔",
                    "text": "还给我！"
                },
                {
                    "id": "400731713",
                    "speaker": "幽夜菲谢尔",
                    "text": "什、什么？"
                },
                {
                    "id": "400731714",
                    "speaker": "菲谢尔",
                    "text": "把属于我的东西还给我！幽夜净土、王城、子民…还有还有最重要的，我的伙伴，奥兹！"
                },
                {
                    "id": "400731715",
                    "speaker": "奥兹",
                    "text": "哎呀，小姐竟然能说出如此流利又极富气魄的话语，您当真成长为皇女了呢。"
                },
                {
                    "id": "400731716",
                    "speaker": "菲谢尔",
                    "text": "还敢说话，你这个叛徒！"
                },
                {
                    "id": "400731717",
                    "speaker": "奥兹",
                    "text": "不，小姐，我之所以在这里，是为了向各位证明一件事。"
                },
                {
                    "id": "400731718",
                    "speaker": "奥兹",
                    "text": "众所周知，奥兹会跟随断罪之皇女菲谢尔。二位既然都是菲谢尔，我出现在谁的身边都不要紧才对。"
                },
                {
                    "id": "400731719",
                    "speaker": "奥兹",
                    "text": "可是您看，当我站在这一边的时候，您也没有失去自己的身份不是吗？"
                },
                {
                    "id": "400731720",
                    "speaker": "枫原万叶",
                    "text": "原来如此，高明的劝诫。"
                },
                {
                    "id": "400731721",
                    "speaker": "菲谢尔",
                    "text": "我的身份？"
                },
                {
                    "id": "400731722",
                    "speaker": "奥兹",
                    "text": "您认为，「菲谢尔」究竟是什么？"
                },
                {
                    "id": "400731723",
                    "speaker": "菲谢尔",
                    "text": "欸？"
                },
                {
                    "id": "400731724",
                    "speaker": "奥兹",
                    "text": "这是我给小姐您的问题。"
                },
                {
                    "id": "400731725",
                    "speaker": "菲谢尔",
                    "text": "菲谢尔…是…"
                },
                {
                    "id": "400731726",
                    "speaker": "幽夜菲谢尔",
                    "text": "是生活的失败者，一个心怀恐惧的胆小鬼，无法面对幻想之外缺乏谎言的自己。"
                },
                {
                    "id": "400731727",
                    "speaker": "奥兹",
                    "text": "不，您说得不对。"
                },
                {
                    "id": "400731728",
                    "speaker": "菲谢尔",
                    "text": "菲谢尔…是…我？"
                },
                {
                    "id": "400731729",
                    "speaker": "奥兹",
                    "text": "噢，反应很快。"
                },
                {
                    "id": "400731730",
                    "speaker": "菲谢尔",
                    "text": "欸？就这么简单？"
                },
                {
                    "id": "400731731",
                    "speaker": "奥兹",
                    "text": "这才对，小姐。菲谢尔，或许是断罪之皇女，却不总是。或许勇敢高傲，却也胆小懦弱。"
                },
                {
                    "id": "400731732",
                    "speaker": "奥兹",
                    "text": "菲谢尔是您自己。既高贵又平凡，是水平一流可总也交不到太多朋友的冒险家，是不可思议之国的皇女殿下。"
                },
                {
                    "id": "400731733",
                    "speaker": "奥兹",
                    "text": "菲谢尔，既胆小又强大，惧怕他人的闲言碎语，也渴望得到他人的崇敬。"
                },
                {
                    "id": "400731734",
                    "speaker": "奥兹",
                    "text": "更重要的是…菲谢尔，是一个常在心中自我批判，被自己打败无数次，又无数次站起的进取者。"
                },
                {
                    "id": "400731735",
                    "speaker": "奥兹",
                    "text": "小姐，除了您，没有人当得起菲谢尔这个名字。它是复杂而单纯的符号，指向梦想与自由之美。"
                },
                {
                    "id": "400731736",
                    "speaker": "奥兹",
                    "text": "无论是否受人追随，小艾咪就是菲谢尔。菲谢尔是您——在心中无意识写下那句箴言的贤明之人。"
                },
                {
                    "id": "400731737",
                    "speaker": "菲谢尔",
                    "text": "…「令我的子民自由，不囿于古老法则。」"
                },
                {
                    "id": "400731738",
                    "speaker": "奥兹",
                    "text": "感谢您创造幽夜净土，为我等搭建家园，又于潜意识中写下《圣国的咏唱》，使我等永远坚信光明将到来。"
                },
                {
                    "id": "400731739",
                    "speaker": "奥兹",
                    "text": "现在，殿下，请接受您的黑暗，恢复成原本的姿态吧。"
                },
                {
                    "id": "400731740",
                    "speaker": "幽夜菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731741",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731742",
                    "speaker": "派蒙",
                    "text": "呜哇，穿礼服的那个消失了！欸等等…又冒出来了？"
                },
                {
                    "id": "400731743",
                    "speaker": "莫娜",
                    "text": "看来，影子回到了她本来的位置，也就是菲谢尔心里。"
                },
                {
                    "id": "400731744",
                    "speaker": "菲谢尔",
                    "text": "…哦呵呵呵，来了吗，诸位。"
                },
                {
                    "id": "400731745",
                    "speaker": "辛焱",
                    "text": "哦？这种感觉是…"
                },
                {
                    "id": "400731746",
                    "speaker": "菲谢尔",
                    "text": "啊哈哈哈，我之臣民们！听见了吗，本皇女的召唤！"
                },
                {
                    "id": "400731747",
                    "speaker": "枫原万叶",
                    "text": "听到了。"
                },
                {
                    "id": "400731748",
                    "speaker": "莫娜",
                    "text": "一恢复精神就吵吵嚷嚷的，受不了。"
                },
                {
                    "id": "400731749",
                    "speaker": "菲谢尔",
                    "text": "奥兹所言甚是，今日正是本皇女取回真心，再度君临幽夜净土的伟大时刻。现在，我宣布——"
                },
                {
                    "id": "400731750",
                    "speaker": "菲谢尔",
                    "text": "——欢迎来到幽夜净土！"
                },
                {
                    "id": "400731751",
                    "speaker": "派蒙&辛焱&莫娜",
                    "text": "太好了太好了！"
                }
            ]
        },
        {
            "id": "4007318",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400731801",
                    "speaker": "菲谢尔",
                    "text": "（真是令人高兴的日子。我找回自己，成为了真正的皇女。）"
                },
                {
                    "id": "400731802",
                    "speaker": "菲谢尔",
                    "text": "（幽夜净土真的降临了。尽管如此，我也明白，隐藏在我心中的负面情感并不会就此消逝。）"
                },
                {
                    "id": "400731803",
                    "speaker": "菲谢尔",
                    "text": "（没关系，我会带着这些弱点继续战斗。因为我已经明白，我所拥有的东西独一无二，如此美妙。）"
                },
                {
                    "id": "400731804",
                    "speaker": "派蒙",
                    "text": "菲谢尔，听说外面剧场已经搭起来了，你不去看看吗？"
                },
                {
                    "id": "400731805",
                    "speaker": "奥兹",
                    "text": "派蒙卿，注意言辞。"
                },
                {
                    "id": "400731806",
                    "speaker": "派蒙",
                    "text": "哦哦！好吧，皇女殿下，您不愿赏光外出看看吗？"
                },
                {
                    "id": "400731807",
                    "speaker": "Player",
                    "text": "噗…"
                },
                {
                    "id": "400731808",
                    "speaker": "菲谢尔",
                    "text": "咳！身为臣子，竟敢嘲笑光彩荣耀伟大的皇女。",
                    "choices": [
                        {
                            "id": "400731809",
                            "text": "不是嘲笑。",
                            "response": [
                                {
                                    "id": "400731811",
                                    "speaker": "菲谢尔",
                                    "text": "…嘿嘿，嗯！"
                                },
                                {
                                    "id": "400731812",
                                    "speaker": "菲谢尔",
                                    "text": "尽情狂欢吧，今天可是幽夜净土的大日子。"
                                },
                                {
                                    "id": "400731813",
                                    "speaker": "奥兹",
                                    "text": "噢，小姐的意思是，诚心邀请诸位奉上最大的热忱，尽情庆贺这至夜圣土降临于世的…"
                                },
                                {
                                    "id": "400731814",
                                    "speaker": "派蒙",
                                    "text": "好啦好啦，别再翻回菲谢尔语了…"
                                },
                                {
                                    "id": "400731815",
                                    "speaker": "莫娜",
                                    "text": "…噗…"
                                },
                                {
                                    "id": "400731816",
                                    "speaker": "莫娜",
                                    "text": "假如是这样的国度…当地的戏剧表演，一定很好看吧。"
                                },
                                {
                                    "id": "400731817",
                                    "speaker": "莫娜",
                                    "text": "至于我关注的谜题，应该也快有答案了。"
                                },
                                {
                                    "id": "400731818",
                                    "speaker": "派蒙",
                                    "text": "对了，好像还有件事没做。皇女殿下，奥兹，我们失陪一会儿。"
                                },
                                {
                                    "id": "400731819",
                                    "speaker": "奥兹",
                                    "text": "好的，二位一会儿见。"
                                },
                                {
                                    "id": "400731820",
                                    "speaker": "派蒙",
                                    "text": "再试试，看能不能联系上温迪。"
                                },
                                {
                                    "id": "400731821",
                                    "speaker": "Player",
                                    "text": "嗯。"
                                },
                                {
                                    "id": "400731822",
                                    "speaker": "嘟嘟通讯仪",
                                    "text": "嘟嘟可——"
                                },
                                {
                                    "id": "400731823",
                                    "speaker": "嘟嘟通讯仪",
                                    "text": "嘟嘟可——嘟嘟可——"
                                },
                                {
                                    "id": "400731824",
                                    "speaker": "？？？",
                                    "text": "咦，是你呀。"
                                },
                                {
                                    "id": "400731825",
                                    "speaker": "Player",
                                    "text": "这个声音…"
                                },
                                {
                                    "id": "400731826",
                                    "speaker": "Player",
                                    "text": "我从来没听过？"
                                },
                                {
                                    "id": "400731827",
                                    "speaker": "派蒙",
                                    "text": "欸？不是卖唱的吗？"
                                },
                                {
                                    "id": "400731828",
                                    "speaker": "Player",
                                    "text": "对不起，你是哪位？"
                                },
                                {
                                    "id": "400731829",
                                    "speaker": "？？？",
                                    "text": "嗯，我们确实素不相识。"
                                },
                                {
                                    "id": "400731830",
                                    "speaker": "？？？",
                                    "text": "我知道你想联络海岛之外的人，但现在还不行哦。所以，我截断了你的通讯。"
                                },
                                {
                                    "id": "400731831",
                                    "speaker": "派蒙",
                                    "text": "咦？！"
                                },
                                {
                                    "id": "400731832",
                                    "speaker": "？？？",
                                    "text": "比起询问，你不想自己找出答案吗？不可思议的幻境，它代表「深梦」，正是人心最本质的映射。"
                                },
                                {
                                    "id": "400731833",
                                    "speaker": "？？？",
                                    "text": "去看吧。亲眼看清这一切，待故事落幕，再告诉我你的感受。"
                                },
                                {
                                    "id": "400731834",
                                    "speaker": "Player",
                                    "text": "…联络断开了。"
                                },
                                {
                                    "id": "400731835",
                                    "speaker": "派蒙",
                                    "text": "#喂{NICKNAME}，刚才那是谁啊？！"
                                },
                                {
                                    "id": "400731836",
                                    "speaker": "派蒙",
                                    "text": "好奇怪，为什么这个人能截断我们跟温迪的联络…她又为什么要问你的感受呢？"
                                },
                                {
                                    "id": "400731837",
                                    "speaker": "派蒙",
                                    "text": "唔…不行，我想不明白！"
                                },
                                {
                                    "id": "400731838",
                                    "speaker": "Player",
                                    "text": "我也还不明白。"
                                },
                                {
                                    "id": "400731839",
                                    "speaker": "派蒙",
                                    "text": "有点害怕，但…但我会保护你的，不论发生什么事，我都陪着你。"
                                },
                                {
                                    "id": "400731840",
                                    "speaker": "Player",
                                    "text": "嗯。我们先保密。"
                                },
                                {
                                    "id": "400731841",
                                    "speaker": "Player",
                                    "text": "（那个人的话语中没有半点恶意，反倒带着强烈的试探。）"
                                },
                                {
                                    "id": "400731842",
                                    "speaker": "Player",
                                    "text": "（不知她想从我这里得到什么答案，但在那之前…我会看完所有的故事。）"
                                }
                            ]
                        },
                        {
                            "id": "400731810",
                            "text": "看到你打起精神来就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400739907",
                    "speaker": "旁白",
                    "text": "「臣民朝拜她，她回答：『为本皇女献上庆典，到旷野中演出戏剧。』」"
                },
                {
                    "id": "400739908",
                    "speaker": "旁白",
                    "text": "「『向我叩拜，向我献上纯净之幻梦以换取永夜荣光。』」"
                },
                {
                    "id": "400739909",
                    "speaker": "派蒙",
                    "text": "听起来是个好结局呢！"
                },
                {
                    "id": "400739911",
                    "speaker": "派蒙",
                    "text": "我就知道他会出现在这里的！"
                },
                {
                    "id": "400739912",
                    "speaker": "莱昂",
                    "text": "请别这么说，即使不成熟如我也能感觉到这绝对是最后一次了！"
                }
            ]
        }
    ]
}