        {
            "id": "4007319",
            "objective": "进入城堡藏书阁",
            "dialogues": []
        },
        {
            "id": "4007312",
            "objective": "解救莱昂",
            "dialogues": []
        },
        {
            "id": "4007313",
            "objective": "与莱昂对话",
            "dialogues": [
                {
                    "id": "400731301",
                    "speaker": "辛焱",
                    "text": "小哥，你这个样子，以后怎么出门啊。"
                },
                {
                    "id": "400731302",
                    "speaker": "枫原万叶",
                    "text": "旅行需要耐力、勇气和危机意识。你有了耐力和勇气，之后还请注意增强危机意识。"
                },
                {
                    "id": "400731303",
                    "speaker": "莱昂",
                    "text": "各位的话，我会牢牢记在心中。但这一次，我们真的该告别了。"
                },
                {
                    "id": "400731304",
                    "speaker": "莱昂",
                    "text": "您或许还没有察觉，但我知道，天气变得晴朗，海面平静又美丽…为了这一天，我们等待许久。"
                },
                {
                    "id": "400731305",
                    "speaker": "莱昂",
                    "text": "各位一定为我这样冒失的人都能当上演员感到奇怪，但请相信我，这不是偶然。"
                },
                {
                    "id": "400731306",
                    "speaker": "莱昂",
                    "text": "每一只夜鸦都在寻找工作。工作，等同于我们的命运。我们生来便要找到自己命中注定该扮演的角色。"
                },
                {
                    "id": "400731307",
                    "speaker": "莱昂",
                    "text": "各位或许还没听说，《圣国的咏唱》，是一本预言书。"
                },
                {
                    "id": "400731308",
                    "speaker": "派蒙",
                    "text": "预言书？可它不是你们的圣典吗？"
                },
                {
                    "id": "400731309",
                    "speaker": "莱昂",
                    "text": "是的。数百年前，幽夜净土被不祥之气覆盖，我们的主人却像失去了治国的兴趣一般，未采取任何行动。"
                },
                {
                    "id": "400731310",
                    "speaker": "莱昂",
                    "text": "随后有一天，大书记官奥兹出现在我们之中。它带来圣典与一则振奋人心的预言。"
                },
                {
                    "id": "400731311",
                    "speaker": "莱昂",
                    "text": "那预言正如书中所写，昭示着幽夜净土真正的幸福。为此，我们坚信满天阴霾必会散去，我们衷心期待。"
                },
                {
                    "id": "400731312",
                    "speaker": "莱昂",
                    "text": "救世的主宰者…皇女殿下。她一定会想起这里本是怎样的乐土，为了她，我们要仿照预言，献上戏剧。"
                },
                {
                    "id": "400731313",
                    "speaker": "莱昂",
                    "text": "所以我站出来，扮演勇士。我愿走过千难万险，踏过刀山火海…去向她献上我的真心。"
                },
                {
                    "id": "400731314",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400731315",
                    "speaker": "莱昂",
                    "text": "您…您是皇女殿下？！"
                },
                {
                    "id": "400731316",
                    "speaker": "派蒙",
                    "text": "对哦，刚才救援的时候她不知为什么躲在后面…"
                },
                {
                    "id": "400731317",
                    "speaker": "菲谢尔",
                    "text": "我之臣民，汝的意志足以斫断邪龙的手足。现在，我会收下汝的祝福。"
                },
                {
                    "id": "400731318",
                    "speaker": "莱昂",
                    "text": "我倍感荣幸！"
                },
                {
                    "id": "400731319",
                    "speaker": "菲谢尔",
                    "text": "汝做得很好。骑士的美德，汝也已然具备。去吧，就位，等待演出开幕。"
                },
                {
                    "id": "400731320",
                    "speaker": "奥兹",
                    "text": "赞美您对皇女殿下的虔诚之心。覆盖幽夜净土全境的阴霾，将由皇女殿下率领我等扈从击溃。"
                },
                {
                    "id": "400731321",
                    "speaker": "莱昂",
                    "text": "…感谢殿下，也感谢各位英雄！那么，我就先告辞了。"
                },
                {
                    "id": "400731322",
                    "speaker": "莱昂",
                    "text": "对了，如果各位需要…请务必记得，前方大门的口令是「永夜的序曲」。"
                },
                {
                    "id": "400731323",
                    "speaker": "派蒙",
                    "text": "我都糊涂了，你们刚才在演哪出？"
                },
                {
                    "id": "400731324",
                    "speaker": "菲谢尔",
                    "text": "难道在场诸卿就没有一人能听懂我之箴言么？愚笨。"
                },
                {
                    "id": "400731325",
                    "speaker": "奥兹",
                    "text": "小姐的意思是各位很笨。"
                },
                {
                    "id": "400731326",
                    "speaker": "莫娜",
                    "text": "这种话就不用翻译了！你说谁笨，我已经完全明白了。"
                },
                {
                    "id": "400731327",
                    "speaker": "枫原万叶",
                    "text": "嗯，皇女殿下先前说的「正事」，就是这个吧。"
                },
                {
                    "id": "400731328",
                    "speaker": "辛焱",
                    "text": "速战速决，走！"
                },
                {
                    "id": "400731329",
                    "speaker": "派蒙",
                    "text": "欸？等等，怎么了，究竟怎么了…"
                }
            ]
        },
        {
            "id": "4007320",
