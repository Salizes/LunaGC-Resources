                    "choices": [
                        {
                            "id": "710570413",
                            "text": "如果是蘑菇…",
                            "response": [
                                {
                                    "id": "710570415",
                                    "speaker": "瑾武",
                                    "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。"
                                },
                                {
                                    "id": "710570416",
                                    "speaker": "Player",
                                    "text": "关于海迪夫…"
                                },
                                {
                                    "id": "710570417",
                                    "speaker": "瑾武",
                                    "text": "这家伙还在上面的营地，说是要把一些研究资料整理好带下来…"
                                },
                                {
                                    "id": "710570418",
                                    "speaker": "瑾武",
                                    "text": "只能等他下来以后再问问情况了。"
                                },
                                {
                                    "id": "710570419",
                                    "speaker": "派蒙",
                                    "text": "希望老何能够恢复。"
                                },
                                {
                                    "id": "710570420",
                                    "speaker": "瑾武",
                                    "text": "唉，老何可是老前辈了，身手敏捷，对新来的小伙子们都多有照顾。"
                                },
                                {
                                    "id": "710570421",
                                    "speaker": "瑾武",
                                    "text": "他当年失踪之后…大家都觉得岩王爷没开眼啊，怎么好人没好报呢。"
                                },
                                {
                                    "id": "710570422",
                                    "speaker": "瑾武",
                                    "text": "如果他能够恢复、平安回去，大伙肯定会很高兴吧。"
                                },
                                {
                                    "id": "710570423",
                                    "speaker": "瑾武",
                                    "text": "#多谢你了，{NICKNAME}，等海迪夫看完老何的情况，无论如何，我都会把他带到上面去。"
                                },
                                {
                                    "id": "710570424",
                                    "speaker": "瑾武",
                                    "text": "这次真是辛苦你了，我都不知道该怎么感谢你啊。"
                                }
                            ]
                        },
                        {
                            "id": "710570414",
                            "text": "有研究蘑菇的人在吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105705",
            "objective": "与老何对话黑屏特效",
            "dialogues": []
        },
        {
            "id": "7105706",
            "objective": "与老何对话",
            "dialogues": [
                {
                    "id": "710570201",
                    "speaker": "派蒙",
                    "text": "一下子就全部解决了？"
                },
                {
                    "id": "710570202",
                    "speaker": "派蒙",
                    "text": "老何…好强！"
                },
                {
                    "id": "710570203",
                    "speaker": "老何",
                    "text": "嘿嘿嘿…蘑菇肉，蘑菇肉…"
                },
                {
                    "id": "710570204",
                    "speaker": "老何",
                    "text": "自从吃了蘑菇肉，我腰也不疼了，手上也有劲了，嘿嘿嘿，感觉自己年轻了好几岁啊！"
                },
                {
                    "id": "710570205",
                    "speaker": "老何",
                    "text": "蘑菇肉怪比蘑菇肉好吃，蘑菇肉，越大越好吃…嘿嘿嘿…"
                },
                {
                    "id": "710570206",
                    "speaker": "派蒙",
                    "text": "难道，老何是吃了这些蘑菇肉之后才变得那么厉害的吗？"
                },
                {
                    "id": "710570207",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，只要吃就能变强，我们也吃几个吧！",
                    "choices": [
                        {
                            "id": "710570208",
                            "text": "你只是想吃蘑菇肉吧！",
                            "response": [
                                {
                                    "id": "710570209",
                                    "speaker": "派蒙",
                                    "text": "我只是好奇是什么味道的嘛。"
                                },
                                {
                                    "id": "710570212",
                                    "speaker": "派蒙",
                                    "text": "不过这下老何应该愿意跟我们一起回去了吧！"
                                },
                                {
                                    "id": "710570213",
                                    "speaker": "老何",
                                    "text": "蘑菇肉…嘿嘿，好吃！"
                                },
                                {
                                    "id": "710570214",
                                    "speaker": "派蒙",
                                    "text": "老何！我们一起回营地吧！"
                                },
                                {
                                    "id": "710570215",
                                    "speaker": "老何",
                                    "text": "啊？一起？好啊，你们也来一起吃啊，这些蘑菇肉，嘿嘿嘿，风干之后可以吃很久…很久…"
                                },
                                {
                                    "id": "710570216",
                                    "speaker": "派蒙",
                                    "text": "是一起回营地啦！"
                                },
                                {
                                    "id": "710570217",
                                    "speaker": "老何",
                                    "text": "回阴地？阴地是什么地方，不过好呀…嘿嘿嘿…吃了蘑菇肉，我哪都能去。"
                                },
                                {
                                    "id": "710570218",
                                    "speaker": "派蒙",
                                    "text": "唉…"
                                },
                                {
                                    "id": "710570219",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们还是快点把老何带回去见瑾武姐吧。"
                                }
                            ]
                        },
                        {
                            "id": "710570210",
                            "text": "不许乱吃！",
                            "response": [
                                {
                                    "id": "710570211",
                                    "speaker": "派蒙",
                                    "text": "我、我知道啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105707",
            "objective": "将老何带回营地见瑾武",
            "dialogues": []
        },
        {
            "id": "7105708",
            "objective": "将老何带回营地见瑾武",
            "dialogues": []
        },
        {
            "id": "7105709",
            "objective": "将老何带回营地见瑾武",
            "dialogues": [
                {
                    "id": "710570601",
                    "speaker": "老何",
                    "text": "蘑菇肉…嘿嘿…好好吃了一顿蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…"
                },
                {
                    "id": "710570602",
                    "speaker": "瑾武",
                    "text": "老何？你脸色怎么这么怪啊！"
                },
                {
                    "id": "710570603",
                    "speaker": "瑾武",
                    "text": "唉…我就知道你这家伙肯定还活着！你们家里人还请我吃席，我那个时候就说，没见到遗体，吃什么席！"
                },
                {
                    "id": "710570604",
                    "speaker": "瑾武",
                    "text": "脸色看上去那么差，肯定在矿里吃了不少苦，不过、不过活着就好呀！"
                },
                {
                    "id": "710570605",
                    "speaker": "老何",
                    "text": "活得好！活的蘑菇好吃…嘿嘿…"
                },
                {
                    "id": "710570606",
                    "speaker": "瑾武",
                    "text": "老何？"
                },
                {
                    "id": "710570607",
                    "speaker": "派蒙",
                    "text": "我们发现他的时候就已经是这样了。"
                },
                {
                    "id": "710570608",
                    "speaker": "派蒙",
                    "text": "有点疯疯癫癫的…总是嚷嚷着要吃蘑菇。"
                },
                {
                    "id": "710570609",
                    "speaker": "瑾武",
                    "text": "蘑菇…"
                },
                {
                    "id": "710570610",
                    "speaker": "瑾武",
                    "text": "层岩巨渊下面的环境对于普通人来说很是凶险，生长的菌类和植物说不定也对人有害，所以辉山厅是严禁矿工进食那些东西的。"
                },
                {
                    "id": "710570611",
                    "speaker": "瑾武",
                    "text": "但这几年老何一直在矿里，这样也是迫于无奈。"
                },
                {
                    "id": "710570612",
                    "speaker": "瑾武",
                    "text": "变成这种模样，我该怎么和他的家里人交待呀。",
                    "choices": [
                        {
                            "id": "710570613",
                            "text": "如果是蘑菇…",
                            "response": [
                                {
                                    "id": "710570615",
                                    "speaker": "瑾武",
                                    "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。"
                                },
                                {
                                    "id": "710570616",
                                    "speaker": "瑾武",
                                    "text": "你们在这稍等下，我去把海迪夫叫来看看老何的情况。"
                                },
                                {
                                    "id": "710570617",
                                    "speaker": "老何",
                                    "text": "蘑菇肉…蘑菇肉…"
                                },
                                {
                                    "id": "710570618",
                                    "speaker": "派蒙",
                                    "text": "唉，真不知道老何这样还能不能恢复。"
                                },
                                {
                                    "id": "710570619",
                                    "speaker": "派蒙",
                                    "text": "要是一直这样，就算回去了，他家人也不会高兴吧。"
                                },
                                {
                                    "id": "710570620",
                                    "speaker": "海迪夫",
                                    "text": "写报告写到一半就被强行拉过来，瑾武啊，就算你是勘探队的安全负责人，但是耽误我的研究进度…"
                                },
                                {
                                    "id": "710570621",
                                    "speaker": "海迪夫",
                                    "text": "我会认真考虑减少你们部分报酬的提案的。"
                                },
                                {
                                    "id": "710570622",
                                    "speaker": "瑾武",
                                    "text": "报酬的问题怎么样都好。"
                                },
                                {
                                    "id": "710570623",
                                    "speaker": "瑾武",
                                    "text": "你先看下这个人的情况…"
                                },
                                {
                                    "id": "710570624",
                                    "speaker": "老何",
                                    "text": "耳朵好痒…嘿嘿…"
                                },
                                {
                                    "id": "710570625",
                                    "speaker": "海迪夫",
                                    "text": "嗯？这是什么人！他脸色怎么那么奇怪啊！"
                                },
                                {
                                    "id": "710570626",
                                    "speaker": "海迪夫",
                                    "text": "#{NICKNAME}，这人是你找回来的？你怎么总能碰到神奇的事啊…"
                                },
                                {
                                    "id": "710570627",
                                    "speaker": "海迪夫",
                                    "text": "那么…发现他的时候是什么情况呢？"
                                },
                                {
                                    "id": "710570628",
                                    "speaker": "Black Screen",
                                    "text": "向海迪夫说明了与老何有关的事…\\n海迪夫仔细检查了老何。"
                                },
                                {
                                    "id": "710570629",
                                    "speaker": "海迪夫",
                                    "text": "还好还好，没什么大碍。"
                                },
                                {
                                    "id": "710570630",
                                    "speaker": "海迪夫",
                                    "text": "你看，他不是一直说自己的耳朵痒吗，那是因为这种菌类的孢子进入了耳道导致的。"
                                },
                                {
                                    "id": "710570631",
                                    "speaker": "海迪夫",
                                    "text": "而这种真菌…啊，也就是这种蘑菇虽然长期食用确实会让人精神失常，不过对于人体来说的损害没有那么大。"
                                },
                                {
                                    "id": "710570632",
                                    "speaker": "瑾武",
                                    "text": "也就是说，他能够恢复？"
                                },
                                {
                                    "id": "710570633",
                                    "speaker": "海迪夫",
                                    "text": "我已经帮他清理了身上的真菌，也做了能让紊乱的神经恢复下来的药。"
                                },
                                {
                                    "id": "710570634",
                                    "speaker": "海迪夫",
                                    "text": "只要好好休息，恢复的可能性还是很大的。"
                                },
                                {
                                    "id": "710570635",
                                    "speaker": "瑾武",
                                    "text": "那这样，做药的钱…"
                                },
                                {
                                    "id": "710570636",
                                    "speaker": "海迪夫",
                                    "text": "药的原材料还是很便宜的，只够在新月轩连吃一个月，算不上什么大钱。"
                                },
                                {
                                    "id": "710570637",
                                    "speaker": "瑾武",
                                    "text": "呃…我会想办法筹给你的…"
                                },
                                {
                                    "id": "710570638",
                                    "speaker": "海迪夫",
                                    "text": "这点钱就不用给了，倒是我的报告又可以添一笔了。"
                                },
                                {
                                    "id": "710570639",
                                    "speaker": "海迪夫",
                                    "text": "来层岩巨渊发现特殊蘑菇的时候，就想研究长期食用这种蘑菇会有什么后果…但是找不到愿意协助我进行实验的助手。",
                                    "choices": [
                                        {
                                            "id": "710570640",
                                            "text": "助手？",
                                            "response": [
                                                {
                                                    "id": "710570641",
                                                    "speaker": "海迪夫",
                                                    "text": "就是负责吃蘑菇的人，大家都对这种蘑菇敬而远之，虽然知道不会有太大损害，但也不敢轻易尝试。"
                                                },
                                                {
                                                    "id": "710570644",
                                                    "speaker": "海迪夫",
                                                    "text": "不过…层岩巨渊环境特殊，说不定也有环境的影响，总之，只要用了这个药，然后再好好休息，恢复的可能还是很大的。"
                                                },
                                                {
                                                    "id": "710570645",
                                                    "speaker": "瑾武",
                                                    "text": "那就行，那就行…待会儿我就把老何送到上面去。"
                                                },
                                                {
                                                    "id": "710570646",
                                                    "speaker": "瑾武",
                                                    "text": "等他恢复了，就带他回家，还得告诉那些跟他关系好的兄弟们。"
                                                },
                                                {
                                                    "id": "710570647",
                                                    "speaker": "瑾武",
                                                    "text": "老何可是老前辈了，身手敏捷，对新来的小伙子们都多有照顾。"
                                                },
                                                {
                                                    "id": "710570648",
                                                    "speaker": "瑾武",
                                                    "text": "他当年失踪之后…大家都觉得岩王爷没开眼啊，怎么好人没好报呢。"
                                                },
                                                {
                                                    "id": "710570649",
                                                    "speaker": "瑾武",
                                                    "text": "这次他回去，大伙肯定很高兴吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710570642",
                                            "text": "是实验对象吧？",
                                            "response": [
                                                {
                                                    "id": "710570643",
                                                    "speaker": "海迪夫",
                                                    "text": "也可以这么说，不过这种蘑菇之前就已经被分析过，不会对人体或精神造成不可逆损伤。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710570614",
                            "text": "有研究蘑菇的人在吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710571201",
                    "speaker": "老何",
                    "text": "耳朵倒是不痒了…但是…"
                },
                {
                    "id": "710571202",
                    "speaker": "老何",
                    "text": "蘑菇肉，唉，哪里能再找到蘑菇肉吃呢？"
                }
            ]
        }
    ]
}