    "talks": [
        {
            "id": "7105701",
            "objective": "阅读「工作手册」$HIDDEN",
            "dialogues": [
                {
                    "id": "710570701",
                    "speaker": "工作手册",
                    "text": "（一本工作手册，封面上写着「老何」，大概是手册主人的名字。）"
                },
                {
                    "id": "710570706",
                    "speaker": "工作手册",
                    "text": "（手册的前几页上写着：）"
                },
                {
                    "id": "710570702",
                    "speaker": "工作手册",
                    "text": "「…戚定找那个以前送闺女的玩具找了半天，哪都没有，明天只能到矿深处帮他找找了…」"
                },
                {
                    "id": "710570703",
                    "speaker": "工作手册",
                    "text": "「…耳朵好痒…」"
                },
                {
                    "id": "710570704",
                    "speaker": "工作手册",
                    "text": "「…耳朵好痒，痒死了，痒死了，耳朵…真是烦啊，快没东西吃了，那个声音说…但是，这个蘑菇到底能不能吃……」"
                },
                {
                    "id": "710570705",
                    "speaker": "工作手册",
                    "text": "后几页里写着：「…能听见，能听见，嘿嘿，蘑菇肉…嘿嘿嘿…蘑菇肉，好吃…嘿嘿嘿，蘑菇肉…」"
                }
            ]
        },
        {
            "id": "7105702",
            "objective": "与出现的老何对话",
            "dialogues": [
                {
                    "id": "710570133",
                    "speaker": "Black Screen",
                    "text": "背后突然传来话语声：\\n「嘿嘿嘿…蘑菇肉…嘿嘿嘿…」"
                },
                {
                    "id": "710570101",
                    "speaker": "？？？",
                    "text": "你们，嘿嘿嘿，怎么会出现在这里呀？"
                },
                {
                    "id": "710570102",
                    "speaker": "派蒙",
                    "text": "呜哇！这人的脸色好奇怪啊！"
                },
                {
                    "id": "710570103",
                    "speaker": "派蒙",
                    "text": "#而且，{NICKNAME}，这个人从背后靠近的时候没发出一点声音…"
                },
                {
                    "id": "710570104",
                    "speaker": "派蒙",
                    "text": "不会是…"
                },
                {
                    "id": "710570105",
                    "speaker": "Player",
                    "text": "应该不是吧。"
                },
                {
                    "id": "710570106",
                    "speaker": "？？？",
                    "text": "嘿嘿嘿…你们怎么…在这里。"
                },
                {
                    "id": "710570107",
                    "speaker": "？？？",
                    "text": "你们的吃的，也吃光了吗？"
                },
                {
                    "id": "710570108",
                    "speaker": "Player",
                    "text": "难道你就是老何？"
                },
                {
                    "id": "710570109",
                    "speaker": "？？？",
                    "text": "啊…什么呀？年轻人，你们说的啥呀，听不清。"
                },
                {
                    "id": "710570110",
                    "speaker": "派蒙",
                    "text": "我们在问！你是老何吗！"
                },
                {
                    "id": "710570111",
                    "speaker": "老何",
                    "text": "哦哦，是啊，嘿嘿嘿，我就是老何。"
                },
                {
                    "id": "710570112",
                    "speaker": "老何",
                    "text": "你们…不会是和我一样被困在下面，把吃的吃光了吧…欸呀，你的运气也不太好啊…"
                },
                {
                    "id": "710570113",
                    "speaker": "老何",
                    "text": "嘿嘿嘿，不过没关系，我这里有吃的…饿了很久了吧…嘿嘿嘿…"
                },
                {
                    "id": "710570114",
                    "speaker": "派蒙",
                    "text": "这么说来确实有点饿了。",
                    "choices": [
                        {
                            "id": "710570115",
                            "text": "蘑菇肉可不能乱吃！",
                            "response": [
                                {
                                    "id": "710570117",
                                    "speaker": "派蒙",
                                    "text": "对、对哦，他看上去精神恍惚，脸色还…那么奇怪，不会就是因为吃蘑菇肉导致的吧！"
                                },
                                {
                                    "id": "710570118",
                                    "speaker": "老何",
                                    "text": "蘑菇肉？嘿嘿嘿，蘑菇肉可好吃了。"
                                },
                                {
                                    "id": "710570119",
                                    "speaker": "老何",
                                    "text": "来，老何给你们一些蘑菇肉…"
                                },
                                {
                                    "id": "710570120",
                                    "speaker": "老何",
                                    "text": "嘿嘿嘿蘑菇肉…咦，怎么…"
                                },
                                {
                                    "id": "710570121",
                                    "speaker": "派蒙",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "710570122",
                                    "speaker": "老何",
                                    "text": "蘑菇肉，没了！"
                                },
                                {
                                    "id": "710570123",
                                    "speaker": "派蒙",
                                    "text": "那就不要管什么蘑菇肉了，我们先一起回营地吧！"
                                },
                                {
                                    "id": "710570124",
                                    "speaker": "老何",
                                    "text": "不行，没有蘑菇肉了！"
                                },
                                {
                                    "id": "710570125",
                                    "speaker": "老何",
                                    "text": "没有蘑菇肉，就没力气走路，我哪也不去…没了蘑菇肉…这里其他地方都没有吃的。"
                                },
                                {
                                    "id": "710570126",
                                    "speaker": "老何",
                                    "text": "有了蘑菇肉，哪都能去！"
                                },
                                {
                                    "id": "710570127",
                                    "speaker": "派蒙",
                                    "text": "那…哪里有这种蘑菇肉呢？"
                                },
                                {
                                    "id": "710570128",
                                    "speaker": "老何",
                                    "text": "蘑菇肉…嘿嘿嘿…我知道哪里有蘑菇肉，我们来弄些蘑菇肉吃，这样就有力气做事了。"
                                },
                                {
                                    "id": "710570129",
                                    "speaker": "老何",
                                    "text": "就在这附近…"
                                },
                                {
                                    "id": "710570130",
                                    "speaker": "派蒙",
                                    "text": "#没办法了，{NICKNAME}，我们先找些蘑菇肉给他吃吧！"
                                },
                                {
                                    "id": "710570131",
                                    "speaker": "Player",
                                    "text": "看来只能如此了。"
                                },
                                {
                                    "id": "710570132",
                                    "speaker": "老何",
                                    "text": "蘑菇肉…嘿嘿嘿…大蘑菇肉…"
                                }
                            ]
                        },
                        {
                            "id": "710570116",
                            "text": "别乱吃危险的东西啦！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105703",
            "objective": "与老何一起前往收集「蘑菇肉」",
            "dialogues": [
                {
                    "id": "710570301",
                    "speaker": "老何",
                    "text": "蘑菇肉…嘿嘿…好好吃了一顿蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…"
                },
                {
                    "id": "710570302",
                    "speaker": "瑾武",
                    "text": "老何？你脸色怎么这么怪啊！"
                },
                {
                    "id": "710570303",
                    "speaker": "瑾武",
                    "text": "唉…我就知道你这家伙肯定还活着！你们家里人还请我吃席，我那个时候就说，没见到遗体，吃什么席！"
                },
                {
                    "id": "710570304",
                    "speaker": "瑾武",
                    "text": "脸色看上去那么差，肯定在矿里吃了不少苦，不过、不过活着就好呀！"
                },
                {
                    "id": "710570305",
                    "speaker": "老何",
                    "text": "活得好！活的蘑菇好吃…嘿嘿…"
                },
                {
                    "id": "710570306",
                    "speaker": "瑾武",
                    "text": "老何？"
                },
                {
                    "id": "710570307",
                    "speaker": "派蒙",
                    "text": "我们发现他的时候就已经是这样了。"
                },
                {
                    "id": "710570308",
                    "speaker": "派蒙",
                    "text": "有点疯疯癫癫的…总是嚷嚷着要吃蘑菇。"
                },
                {
                    "id": "710570309",
                    "speaker": "瑾武",
                    "text": "蘑菇…"
                },
                {
                    "id": "710570310",
                    "speaker": "瑾武",
                    "text": "层岩巨渊下面的环境对于普通人来说很是凶险，生长的菌类和植物说不定也对人有害，所以辉山厅是严禁矿工进食那些东西的。"
                },
                {
                    "id": "710570311",
                    "speaker": "瑾武",
                    "text": "但这几年老何一直在矿里，这样也是迫于无奈。"
                },
                {
                    "id": "710570312",
                    "speaker": "瑾武",
                    "text": "变成这种模样，我该怎么和他的家里人交待呀。",
                    "choices": [
                        {
                            "id": "710570313",
                            "text": "如果是蘑菇…",
                            "response": [
                                {
                                    "id": "710570315",
                                    "speaker": "瑾武",
                                    "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。"
                                },
                                {
                                    "id": "710570316",
                                    "speaker": "瑾武",
                                    "text": "你们在这稍等下，我去把海迪夫叫来看看老何的情况。"
                                },
                                {
                                    "id": "710570317",
                                    "speaker": "老何",
                                    "text": "蘑菇肉…蘑菇肉…"
                                },
                                {
                                    "id": "710570318",
                                    "speaker": "派蒙",
                                    "text": "唉，真不知道老何这样还能不能恢复。"
                                },
                                {
                                    "id": "710570319",
                                    "speaker": "派蒙",
                                    "text": "要是一直这样，就算回去了，他家人也不会高兴吧。"
                                },
                                {
                                    "id": "710570320",
                                    "speaker": "海迪夫",
                                    "text": "写报告写到一半就被强行拉过来，瑾武啊，就算你是勘探队的安全负责人，但是耽误我的研究进度…"
                                },
                                {
                                    "id": "710570321",
                                    "speaker": "海迪夫",
                                    "text": "我会认真考虑减少你们部分报酬的提案的。"
                                },
                                {
                                    "id": "710570322",
                                    "speaker": "瑾武",
                                    "text": "报酬的问题怎么样都好。"
                                },
                                {
                                    "id": "710570323",
                                    "speaker": "瑾武",
                                    "text": "你先看下这个人的情况…"
                                },
                                {
                                    "id": "710570324",
                                    "speaker": "老何",
                                    "text": "耳朵好痒…嘿嘿…"
                                },
                                {
                                    "id": "710570325",
                                    "speaker": "海迪夫",
                                    "text": "嗯？这是什么人！他脸色怎么那么奇怪啊！"
                                },
                                {
                                    "id": "710570326",
                                    "speaker": "海迪夫",
                                    "text": "#{NICKNAME}，这人是你找回来的？你怎么总能碰到神奇的事啊…"
                                },
                                {
                                    "id": "710570327",
                                    "speaker": "海迪夫",
                                    "text": "那么…发现他的时候是什么情况呢？"
                                },
                                {
                                    "id": "710570328",
                                    "speaker": "Black Screen",
                                    "text": "向海迪夫说明了与老何有关的事…\\n海迪夫仔细检查了老何。"
                                },
                                {
                                    "id": "710570329",
                                    "speaker": "海迪夫",
                                    "text": "还好还好，没什么大碍。"
                                },
                                {
                                    "id": "710570330",
                                    "speaker": "海迪夫",
                                    "text": "你看，他不是一直说自己的耳朵痒吗，那是因为这种菌类的孢子进入了耳道导致的。"
                                },
                                {
                                    "id": "710570331",
                                    "speaker": "海迪夫",
                                    "text": "而这种真菌…啊，也就是这种蘑菇虽然长期食用确实会让人精神失常，不过对于人体来说的损害没有那么大。"
                                },
                                {
                                    "id": "710570332",
                                    "speaker": "瑾武",
                                    "text": "也就是说，他能够恢复？"
                                },
                                {
                                    "id": "710570333",
                                    "speaker": "海迪夫",
                                    "text": "我已经帮他清理了身上的真菌，也做了能让紊乱的神经恢复下来的药。"
                                },
                                {
                                    "id": "710570334",
                                    "speaker": "海迪夫",
                                    "text": "只要好好休息，恢复的可能性还是很大的。"
                                },
                                {
                                    "id": "710570335",
                                    "speaker": "瑾武",
                                    "text": "那这样，做药的钱…"
                                },
                                {
                                    "id": "710570336",
                                    "speaker": "海迪夫",
                                    "text": "药的原材料还是很便宜的，只够在新月轩连吃一个月，算不上什么大钱。"
                                },
                                {
                                    "id": "710570337",
                                    "speaker": "瑾武",
                                    "text": "呃…我会想办法筹给你的…"
                                },
                                {
                                    "id": "710570338",
                                    "speaker": "海迪夫",
                                    "text": "这点钱就不用给了，倒是我的报告又可以添一笔了。"
                                },
                                {
                                    "id": "710570339",
                                    "speaker": "海迪夫",
                                    "text": "来层岩巨渊发现特殊蘑菇的时候，就想研究长期食用这种蘑菇会有什么后果…但是找不到愿意协助我进行实验的助手。",
                                    "choices": [
                                        {
                                            "id": "710570340",
                                            "text": "助手？",
                                            "response": [
                                                {
                                                    "id": "710570341",
                                                    "speaker": "海迪夫",
                                                    "text": "就是负责吃蘑菇的人，大家都对这种蘑菇敬而远之，虽然知道不会有太大损害，但也不敢轻易尝试。"
                                                },
                                                {
                                                    "id": "710570344",
                                                    "speaker": "海迪夫",
                                                    "text": "不过…层岩巨渊环境特殊，说不定也有环境的影响，总之，只要用了这个药，然后再好好休息，恢复的可能还是很大的。"
                                                },
                                                {
                                                    "id": "710570345",
                                                    "speaker": "瑾武",
                                                    "text": "那就行，那就行…待会儿我就把老何送到上面去。"
                                                },
                                                {
                                                    "id": "710570346",
                                                    "speaker": "瑾武",
                                                    "text": "等他恢复了，就带他回家，还得告诉那些跟他关系好的兄弟们。"
                                                },
                                                {
                                                    "id": "710570347",
                                                    "speaker": "瑾武",
                                                    "text": "老何可是老前辈了，身手敏捷，对新来的小伙子们都多有照顾。"
                                                },
                                                {
                                                    "id": "710570348",
                                                    "speaker": "瑾武",
                                                    "text": "他当年失踪之后…大家都觉得岩王爷没开眼啊，怎么好人没好报呢。"
                                                },
                                                {
                                                    "id": "710570349",
                                                    "speaker": "瑾武",
                                                    "text": "这次他回去，大伙肯定很高兴吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710570342",
                                            "text": "是实验对象吧？",
                                            "response": [
                                                {
                                                    "id": "710570343",
                                                    "speaker": "海迪夫",
                                                    "text": "也可以这么说，不过这种蘑菇之前就已经被分析过，不会对人体或精神造成不可逆损伤。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710570314",
                            "text": "有研究蘑菇的人在吗？"
                        }
                    ]
                }
            ]
        },
