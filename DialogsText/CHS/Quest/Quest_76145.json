    },
    "talks": [
        {
            "id": "7614502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7614503",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761450301",
                    "speaker": "库济米奇",
                    "text": "哎呀呀，没想到真的卖完了，看来我还是有一些商业眼光的嘛。"
                },
                {
                    "id": "761450302",
                    "speaker": "库济米奇",
                    "text": "接下来我会拜托执灯人送我穿过噩影泽地，之后再往北应该就是通途了。"
                },
                {
                    "id": "761450303",
                    "speaker": "库济米奇",
                    "text": "说不定回去的路上还能碰到什么商机呢…那么就此别过吧，我们有缘再见。"
                }
            ]
        },
        {
            "id": "7614504",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761450401",
                    "speaker": "库济米奇",
                    "text": "这么巧，我们又见面了。您要买点什么吗？新货滞销，帮帮我。",
                    "choices": [
                        {
                            "id": "761450407",
                            "text": "让我看看有什么好货。",
                            "response": [
                                {
                                    "id": "761450408",
                                    "speaker": "库济米奇",
                                    "text": "都是些本地的特产，放心，一定给您最优惠的价格。"
                                }
                            ]
                        },
                        {
                            "id": "761450402",
                            "text": "你怎么又进货了？",
                            "response": [
                                {
                                    "id": "761450403",
                                    "speaker": "库济米奇",
                                    "text": "哎，怎么说呢。商业嘛，正所谓该出手时就出手…我在皮拉米达城碰到了个好机会，一批急着出手的货物，给了我优惠价。"
                                },
                                {
                                    "id": "761450404",
                                    "speaker": "库济米奇",
                                    "text": "我当时一激动，就忘了我这次是要回家了，全给买了下来。结果就…"
                                },
                                {
                                    "id": "761450405",
                                    "speaker": "Player",
                                    "text": "你猜他为什么急着出手。"
                                },
                                {
                                    "id": "761450406",
                                    "speaker": "库济米奇",
                                    "text": "哎，您就别挖苦我了，要不您看看有什么用得上的东西？"
                                }
                            ]
                        },
                        {
                            "id": "761450409",
                            "text": "抱歉，我先走了。",
                            "response": [
                                {
                                    "id": "761450410",
                                    "speaker": "库济米奇",
                                    "text": "不再看看吗，一定有您需要的东西！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7614506",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761450601",
                    "speaker": "库济米奇",
                    "text": "太好了，终于把货都卖完了，果然薄利多销的策略是正确的。"
                },
                {
                    "id": "761450602",
                    "speaker": "库济米奇",
                    "text": "按理来说我也该启程回至冬了，只是现在顶多也就赚回了路费…我光脚出来，可不想再光脚回去啊。"
                },
                {
                    "id": "761450603",
                    "speaker": "库济米奇",
                    "text": "哎，总之多谢你照顾生意了。"
                }
            ]
        },
        {
            "id": "7614507",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761450701",
                    "speaker": "库济米奇",
                    "text": "哎哟，缘分真是奇妙，居然在这又碰上了。怎么样，要看看吗？这次有不少好东西哦。",
                    "choices": [
                        {
                            "id": "761450709",
                            "text": "看看有什么好东西。",
                            "response": [
                                {
                                    "id": "761450710",
                                    "speaker": "库济米奇",
                                    "text": "嘿，都是愚人众淘汰下来的老旧装备，在别处可买不到，有想要的就一起拿走吧！"
                                }
                            ]
                        },
                        {
                            "id": "761450702",
                            "text": "你不是回至冬了吗？",
                            "response": [
                                {
                                    "id": "761450703",
                                    "speaker": "库济米奇",
                                    "text": "不瞒您说，我的家在新基捷城，全家都是采矿工人。他们啊，一个个比矮灵还顽固，我说要出门经商，他们坚决不同意。"
                                },
                                {
                                    "id": "761450704",
                                    "speaker": "库济米奇",
                                    "text": "于是出门前我夸下海口，要赚一大笔钱回去…结果没想到，到头来会差点连路费都凑不上。"
                                },
                                {
                                    "id": "761450705",
                                    "speaker": "库济米奇",
                                    "text": "现在赚大钱是没戏了，至少最后让我能赚点小钱吧，起码回去也有个交待。"
                                }
                            ]
                        },
                        {
                            "id": "761450706",
                            "text": "你怎么在愚人众的地盘？",
                            "response": [
                                {
                                    "id": "761450707",
                                    "speaker": "库济米奇",
                                    "text": "瞧您说的，我可是遵纪守法的至冬公民，看到愚人众就跟回家了一样。"
                                },
                                {
                                    "id": "761450708",
                                    "speaker": "库济米奇",
                                    "text": "现在我这里的货都是愚人众淘汰下来的老旧装备，是他们特别托我处理的。你在别处可买不到，独此一家。"
                                }
                            ]
                        },
                        {
                            "id": "761450711",
                            "text": "不用了，我先走了。",
                            "response": [
                                {
                                    "id": "761450712",
                                    "speaker": "库济米奇",
                                    "text": "那可真是遗憾…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7614509",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761450901",
                    "speaker": "库济米奇",
                    "text": "真是太感谢了，多亏了你，我可以不用那么灰头土脸地回去了。"
                },
                {
                    "id": "761450902",
                    "speaker": "库济米奇",
                    "text": "这次真的要告别了。你买了我这么多东西，我们怎么说也算是朋友了吧。"
                },
                {
                    "id": "761450903",
                    "speaker": "库济米奇",
                    "text": "你若是有机会来至冬的话，就到新基捷城来找我吧。"
                }
            ]
        },
        {
            "id": "7614501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761450101",
                    "speaker": "库济米奇",
                    "text": "行情还真是差啊…要不我还是再凑笔钱，想办法去那夏镇租个摊位吧…",
                    "choices": [
                        {
                            "id": "761450113",
                            "text": "有什么好货吗？",
                            "response": [
                                {
                                    "id": "761450114",
                                    "speaker": "库济米奇",
                                    "text": "都是些从纳塔淘来的小玩意，有什么感兴趣的您尽管挑。"
                                }
                            ]
                        },
                        {
                            "id": "761450102",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "761450103",
                                    "speaker": "库济米奇",
                                    "text": "哎呀，有顾客来了！您好，我叫库济米奇，是来自至冬的旅行商人。"
                                },
                                {
                                    "id": "761450104",
                                    "speaker": "库济米奇",
                                    "text": "话是这么说，其实只是在旅行的路上顺便做些小本生意，赚点路费罢了。"
                                },
                                {
                                    "id": "761450105",
                                    "speaker": "库济米奇",
                                    "text": "结果路过纳塔的时候，那里的人实在太热情了，我一时脑热就…现在我要是不把这些货卖光，连回去的车票钱都要没有啦。",
                                    "choices": [
                                        {
                                            "id": "761450106",
                                            "text": "你要回至冬吗？",
                                            "response": [
                                                {
                                                    "id": "761450107",
                                                    "speaker": "库济米奇",
                                                    "text": "是的，等卖掉这批货，我就要买票坐列车回去了。"
                                                },
                                                {
                                                    "id": "761450108",
                                                    "speaker": "库济米奇",
                                                    "text": "虽说那里一年到头都在下雪，到处冰天雪地的，每天就只能窝在城里。"
                                                },
                                                {
                                                    "id": "761450109",
                                                    "speaker": "库济米奇",
                                                    "text": "但在外面的时间长了，也有点怀念能在家里睡上一整天的日子了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761450110",
                                            "text": "这里看着就没什么生意。",
                                            "response": [
                                                {
                                                    "id": "761450111",
                                                    "speaker": "库济米奇",
                                                    "text": "但如果想在镇上租个摊位，我就只能去北国银行借钱了，听说那夏镇的那家风评也不是很好…"
                                                },
                                                {
                                                    "id": "761450112",
                                                    "speaker": "库济米奇",
                                                    "text": "算啦，至少这里的人流比较多。货嘛，只要来的人多总能卖出去的，您说是不是？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761450115",
                            "text": "不好意思，我先走了。",
                            "response": [
                                {
                                    "id": "761450116",
                                    "speaker": "库济米奇",
                                    "text": "哎，你怎么就走了，不看看吗…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}