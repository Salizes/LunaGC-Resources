    "talks": [
        {
            "id": "7612404",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761240401",
                    "speaker": "派蒙",
                    "text": "咦？这边好像还有一幅画…"
                },
                {
                    "id": "761240402",
                    "speaker": "妌癸",
                    "text": "啊哈，好眼色。"
                },
                {
                    "id": "761240403",
                    "speaker": "妌癸",
                    "text": "这是那些个自称古华传人的小娃娃先前委托卡斯蒂廖内画出来的玩意儿，说是他们引以为傲的「演武场」。"
                },
                {
                    "id": "761240404",
                    "speaker": "妌癸",
                    "text": "不过嘛，他们心气都高傲得很。觉着自个儿已经是绝顶高手，早就不需要这般基础的修习了，就把画送给我咯。"
                },
                {
                    "id": "761240405",
                    "speaker": "派蒙",
                    "text": "欸？你不是古华派的人吗？"
                },
                {
                    "id": "761240406",
                    "speaker": "妌癸",
                    "text": "哈哈哈，我倒想说自己是。可惜呀可惜，古华小子怕是没胆子收我。"
                },
                {
                    "id": "761240407",
                    "speaker": "妌癸",
                    "text": "当初他跟我在归离原剿灭贼匪的时候，那小子还险些因为学艺不精、丢了性命，叫我不得不…"
                },
                {
                    "id": "761240408",
                    "speaker": "妌癸",
                    "text": "罢了罢了，都是些没意思的事儿，不过这画倒是还有些意思。"
                },
                {
                    "id": "761240409",
                    "speaker": "妌癸",
                    "text": "你要是有兴趣，不妨展开看看？撕坏了也没事儿，反正卡斯蒂廖内一天到晚也闲得无事可做，叫他再画一幅便是。"
                }
            ]
        },
        {
            "id": "7612409",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7612401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761240101",
                    "speaker": "妌癸",
                    "text": "哎呀，不管看几次都觉得莫名其妙…我就没听说过有人靠着砍竹子练剑的，古华小子大约的确是有些奇思妙想在的。"
                },
                {
                    "id": "761240102",
                    "speaker": "妌癸",
                    "text": "竹者，为筥、为笘、为篪、为筭、为篰，唯独不见为杙为橛。总不会是因为买不起木材吧？"
                },
                {
                    "id": "761240103",
                    "speaker": "妌癸",
                    "text": "好嘞，两位！既然已经展开了画，那便由我代那些古华派的小娃娃们说说规矩吧。"
                },
                {
                    "id": "761240104",
                    "speaker": "妌癸",
                    "text": "这些竹人中，有些穿着<color=#00E1FFFF>蓝色的衣服</color>，有些穿着<color=#FF5E41FF>红色的衣服</color>。"
                },
                {
                    "id": "761240105",
                    "speaker": "妌癸",
                    "text": "这演武的第一环，便是照着<color=#00E1FFFF>蓝色</color>的竹人去打，但是不能打中<color=#FF5E41FF>红色</color>的竹人。"
                },
                {
                    "id": "761240106",
                    "speaker": "妌癸",
                    "text": "要是准备妥当，就可以随时开始了。来，让我见识一下你的剑术吧！"
                }
            ]
        },
        {
            "id": "7612402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7612405",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7612403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761240301",
                    "speaker": "妌癸",
                    "text": "好嘞，结束！"
                },
                {
                    "id": "761240302",
                    "speaker": "妌癸",
                    "text": "#多谢两位，让我开心得很。尤其是这位金发的{M#小哥}{F#小妹}，身手着实不凡，怕是比我知道的古华小子强多了。",
                    "choices": [
                        {
                            "id": "761240303",
                            "text": "不愧是我！",
                            "response": [
                                {
                                    "id": "761240306",
                                    "speaker": "妌癸",
                                    "text": "拜两位所赐，我也久违地有了些感悟。鱼酱果然还是得加点剁碎的新鲜兽肉提味，否则放久了以后，腥气还是遮不住。"
                                },
                                {
                                    "id": "761240307",
                                    "speaker": "派蒙",
                                    "text": "哦哦，原来如此原来如…咦？好像完全不挨着啊？"
                                },
                                {
                                    "id": "761240308",
                                    "speaker": "妌癸",
                                    "text": "哈哈，这种小事就别放在心上啦！等我下回让卡斯蒂廖内给我多画些鱼，我再请你们吃鱼酱吧。"
                                }
                            ]
                        },
                        {
                            "id": "761240304",
                            "text": "过誉了。",
                            "response": [
                                {
                                    "id": "761240305",
                                    "speaker": "妌癸",
                                    "text": "哈，不必谦虚。你的剑技很强，这我还是看得出来的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7612402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761240201",
                    "speaker": "妌癸",
                    "text": "哎呀，不管看几次都觉得莫名其妙…我就没听说过有人靠着砍竹子练剑的，古华小子大约的确是有些奇思妙想在的。"
                },
                {
                    "id": "761240202",
                    "speaker": "妌癸",
                    "text": "竹者，为筥、为笘、为篪、为筭、为篰，唯独不见为杙为橛。总不会是因为买不起木材吧？"
                },
                {
                    "id": "761240203",
                    "speaker": "妌癸",
                    "text": "好嘞，两位！既然已经展开了画，那便由我代那些古华派的小娃娃们说说规矩吧。"
                },
                {
                    "id": "761240204",
                    "speaker": "妌癸",
                    "text": "这些竹人中，有些穿着<color=#00E1FFFF>蓝色的衣服</color>，有些穿着<color=#FF5E41FF>红色的衣服</color>…",
                    "choices": [
                        {
                            "id": "761240205",
                            "text": "哦哦，是王山厅当时的…",
                            "response": [
                                {
                                    "id": "761240207",
                                    "speaker": "派蒙",
                                    "text": "我也想起来了！是要我们精准打中所有穿着<color=#00E1FFFF>蓝色衣服</color>的竹人，但是不能打中穿着<color=#FF5E41FF>红色衣服</color>的竹人，对吧？"
                                },
                                {
                                    "id": "761240208",
                                    "speaker": "妌癸",
                                    "text": "哈哈，一点儿没错！既是如此，那我也不必多费口舌了。让我见识一下你的剑术吧！"
                                }
                            ]
                        },
                        {
                            "id": "761240206",
                            "text": "我知道规矩。"
                        }
                    ]
                }
            ]
        }
    ]
}