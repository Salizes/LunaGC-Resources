                    "choices": [
                        {
                            "id": "761390208",
                            "text": "这种投资的回报真的高吗…",
                            "response": [
                                {
                                    "id": "761390210",
                                    "speaker": "奈芙尔",
                                    "text": "毕竟是投资，无论盈亏都算正常。"
                                },
                                {
                                    "id": "761390211",
                                    "speaker": "奈芙尔",
                                    "text": "不过…呵，你倒是不用太担心了。"
                                },
                                {
                                    "id": "761390212",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特老板可是位优秀的生意人，跟着他投资，不会亏的。"
                                },
                                {
                                    "id": "761390213",
                                    "speaker": "萨维特",
                                    "text": "咳…！是、是…奈芙尔老板说的是。"
                                },
                                {
                                    "id": "761390214",
