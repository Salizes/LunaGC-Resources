    "talks": [
        {
            "id": "7613901",
            "objective": "与萨维特对话",
            "dialogues": [
                {
                    "id": "761390101",
                    "speaker": "萨维特",
                    "text": "出版业也不挣钱哪，要不干脆只做投资算了…"
                },
                {
                    "id": "761390102",
                    "speaker": "Player",
                    "text": "想看看投资券…"
                },
                {
                    "id": "761390103",
                    "speaker": "萨维特",
                    "text": "好嘞，投资券2000摩拉一张，每周结算一次，嘿嘿，这小袋子里…"
                },
                {
                    "id": "761390104",
                    "speaker": "萨维特",
                    "text": "…呃！"
                },
                {
                    "id": "761390105",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "761390106",
                    "speaker": "萨维特",
                    "text": "没、没什么，就是不知道奈芙尔老板也大驾光临，您…您也想买张投资券吗？"
                },
                {
                    "id": "761390107",
                    "speaker": "奈芙尔",
                    "text": "我就不了，只是陪我这位朋友过来看看而已。"
                },
                {
                    "id": "761390108",
                    "speaker": "奈芙尔",
                    "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。"
                },
                {
                    "id": "761390109",
                    "speaker": "萨维特",
                    "text": "一般！一般，哈哈哈…小本生意，糊口罢了。"
                },
                {
                    "id": "761390110",
                    "speaker": "Player",
                    "text": "这真的能赚钱吗？"
                },
                {
                    "id": "761390111",
                    "speaker": "奈芙尔",
                    "text": "那是当然，萨维特老板可是位优秀的生意人，跟着他投资，不会亏的。"
                },
                {
                    "id": "761390112",
                    "speaker": "萨维特",
                    "text": "是…是…哈哈哈…"
                },
                {
                    "id": "761390113",
                    "speaker": "Player",
                    "text": "看看我今天运气怎么样…"
                },
                {
                    "id": "761390114",
                    "speaker": "萨维特",
                    "text": "今天！就在今天，您刚才买的是我们刚刚推出的…短线投资券！盈亏立即结算！"
                },
                {
                    "id": "761390115",
                    "speaker": "派蒙",
                    "text": "怎么感觉这些话都是你刚刚才编出来的…"
                },
                {
                    "id": "761390116",
                    "speaker": "萨维特",
                    "text": "呃…总、总之，感谢您购买短线投资券！"
                },
                {
                    "id": "761390117",
                    "speaker": "萨维特",
                    "text": "这是您的投资回报，祝您拥有美好的一天！",
                    "choices": [
                        {
                            "id": "761390118",
                            "text": "总之赚钱是好事啦…",
                            "response": [
                                {
                                    "id": "761390120",
                                    "speaker": "派蒙",
                                    "text": "真的？嘿嘿嘿，那你给我买一个小鸟形状的，我就喜欢那样的！"
                                },
                                {
                                    "id": "761390121",
                                    "speaker": "奈芙尔",
                                    "text": "那我也告辞了，萨维特老板果然是个有信誉的好商人，祝您生意兴隆。"
                                },
                                {
                                    "id": "761390122",
                                    "speaker": "萨维特",
                                    "text": "借奈芙尔老板吉言…"
                                },
                                {
                                    "id": "761390123",
                                    "speaker": "萨维特",
                                    "text": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…"
                                },
                                {
                                    "id": "761390124",
                                    "speaker": "奈芙尔",
                                    "text": "东西是已经找到了，但…"
                                },
                                {
                                    "id": "761390125",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特先生，不要心急。事情，要一步一步地做才稳当。"
                                },
                                {
                                    "id": "761390126",
                                    "speaker": "萨维特",
                                    "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
                                }
                            ]
                        },
                        {
                            "id": "761390119",
                            "text": "走，派蒙，我们去买糖雕吃。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7613902",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761390201",
                    "speaker": "萨维特",
                    "text": "哟，这不是老主顾吗，今天也来买投资券？"
                },
                {
                    "id": "761390202",
                    "speaker": "Player",
                    "text": "给我来张投资券。"
                },
                {
                    "id": "761390203",
                    "speaker": "萨维特",
                    "text": "好嘞，2000摩拉一张，每周结算一次，相信我，这一定是…一笔…"
                },
                {
                    "id": "761390204",
                    "speaker": "萨维特",
                    "text": "奈、奈芙尔老板，没想到您居然大驾光临…您…您也想买张投资券吗？"
                },
                {
                    "id": "761390205",
