    "talks": [
        {
            "id": "7501105",
            "objective": "前往浮土静界",
            "dialogues": [
                {
                    "id": "750110501",
                    "speaker": "奇科娅",
                    "text": "水面上涨了一些…而且泉水之中充盈着燃素。"
                },
                {
                    "id": "750110503",
                    "speaker": "奇科娅",
                    "text": "没过小腿的水很温暖，也能感受到暖意顺着肢体向内流涌，这都是很好的东西。"
                },
                {
                    "id": "750110504",
                    "speaker": "派蒙",
                    "text": "所以「盗火贤者」的馈赠，根本就不是「治疗一切创伤的秘药」，而是这里的温泉？"
                },
                {
                    "id": "750110505",
                    "speaker": "派蒙",
                    "text": "不愧是在流泉之众周围，到头来还是和温泉有关呢…"
                },
                {
                    "id": "750110506",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀…"
                },
                {
                    "id": "750110507",
                    "speaker": "奇科娅",
                    "text": "#哼哼，{REALNAME[ID(2)|SHOWHOST(true)]}倒是看上去很舒服的样子嘛。"
                },
                {
                    "id": "750110508",
                    "speaker": "奇科娅",
                    "text": "这可不是普通的温泉呢，小浮浮人派蒙，如果是被选中的勇士，在泡完温泉以后，就能得到「使用燃素」的力量。"
                },
                {
                    "id": "750110509",
                    "speaker": "派蒙",
                    "text": "咦，这样吗，那如果我泡进去会怎么样？"
                },
                {
                    "id": "750110510",
                    "speaker": "奇科娅",
                    "text": "嗯…我想想，嗯，会变成湿乎乎的派蒙。"
                },
                {
                    "id": "750110511",
                    "speaker": "派蒙",
                    "text": "什么呀，我还以为我也能够使用燃素，变成超级厉害的火焰派蒙了呢！"
                },
                {
                    "id": "750110512",
                    "speaker": "奇科娅",
                    "text": "大概不行吧，因为没有被选中啦…"
                },
                {
                    "id": "750110513",
                    "speaker": "派蒙",
                    "text": "啊，不对，奇科娅你明明就知道最终的馈赠是这样的温泉，你还说找秘药，要把「治疗一切创伤的秘药」分给我们呢！"
                },
                {
                    "id": "750110514",
                    "speaker": "奇科娅",
                    "text": "嘿嘿，世上的创伤那么多，怎么可能只靠一种秘药就能全部治好呢！"
                },
                {
                    "id": "750110515",
                    "speaker": "奇科娅",
                    "text": "但是智慧可以解决一切的烦恼，小派蒙这次被姐姐我骗了，吃一堑长一智，就离解决所有烦恼又近一点，不也挺好？"
                },
                {
                    "id": "750110516",
                    "speaker": "派蒙",
                    "text": "是这样吗，唔…好像也有点道理…",
                    "choices": [
                        {
                            "id": "750110517",
                            "text": "那你的创伤被解决了吗…",
                            "response": [
                                {
                                    "id": "750110518",
                                    "speaker": "奇科娅",
                                    "text": "没有哦，我的各种创伤还在心底隐隐作痛，这点上来说，我也被骗了，被自己骗得可惨啦。"
                                },
                                {
                                    "id": "750110520",
                                    "speaker": "奇科娅",
                                    "text": "就算泡在充盈燃素的温泉里，我还是没法使用燃素。古卷上说以前不会用燃素的部族人就是经过试炼学会燃素的…"
                                },
                                {
                                    "id": "750110521",
                                    "speaker": "奇科娅",
                                    "text": "这不是一点效果都没有嘛！"
                                },
                                {
                                    "id": "750110522",
                                    "speaker": "派蒙",
                                    "text": "…咦，奇科娅明明是纳塔人，却没有办法使用燃素吗。"
                                },
                                {
                                    "id": "750110523",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "750110524",
                                    "speaker": "奇科娅",
                                    "text": "小派蒙的这份迟钝在关键时刻还挺伤人的嘛！是啦，在人人都会使用燃素的纳塔，也存在少部分无法使用燃素的人。"
                                },
                                {
                                    "id": "750110525",
                                    "speaker": "奇科娅",
                                    "text": "我很小的时候受过一次重伤，跟深渊有关…"
                                },
                                {
                                    "id": "750110526",
                                    "speaker": "奇科娅",
                                    "text": "能活着就已经是奇迹啦，身体一点都不好，说能背着暝视龙跳远也是骗你们的，因为暝视龙会轻轻飘起来所以没有重量。"
                                },
                                {
                                    "id": "750110527",
                                    "speaker": "奇科娅",
                                    "text": "可能也是因为这个伤，所以没有办法使用燃素，无论如何都没有办法使用燃素，费尽了心思，看各种织物…"
                                },
                                {
                                    "id": "750110528",
                                    "speaker": "奇科娅",
                                    "text": "现在的人已经放弃了的，通过图案分析「燃素刻录」的方法我也了然于胸，我很努力地在背那些语义，所以记忆力变得很好哦。"
                                },
                                {
                                    "id": "750110529",
                                    "speaker": "奇科娅",
                                    "text": "去教部族的孩子燃素的启蒙，也是希望可以趁机近距离观察那些觉醒燃素使用方法的孩子，说起来，我还挺受孩子们欢迎的呢！"
                                },
                                {
                                    "id": "750110530",
                                    "speaker": "奇科娅",
                                    "text": "跟燃素相关的一切我都知道，越是了解越觉得燃素很了不起，可是越觉得了不起就越为自己无法使用燃素而感到遗憾。"
                                },
                                {
                                    "id": "750110531",
                                    "speaker": "奇科娅",
                                    "text": "#唉，一路上的试炼其实根本就是{NICKNAME}{M#少年}{F#少女}在努力，我也知道要像先人那样学会技能就要付出牺牲…"
                                },
                                {
                                    "id": "750110532",
                                    "speaker": "奇科娅",
                                    "text": "可是我也没有那样的勇气，也许这就是我无法使用燃素的原因吧，哈哈…"
                                },
                                {
                                    "id": "750110533",
                                    "speaker": "派蒙",
                                    "text": "奇科娅…"
                                },
                                {
                                    "id": "750110534",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750110535",
                                    "speaker": "奇科娅",
                                    "text": "没关系的，我早就看开了。这次不行，还有下次，总能找到办法的！"
                                },
                                {
                                    "id": "750110536",
                                    "speaker": "奇科娅",
                                    "text": "#嗯，我很感谢你哦…真的很感谢你，{NICKNAME}，前途无量的{M#少年}{F#少女}，你真的很强，也很温柔。"
                                },
                                {
                                    "id": "750110537",
                                    "speaker": "奇科娅",
                                    "text": "#不像姐姐我，感觉人生都已经快要定格了…{M#少年}{F#少女}你以后一定还会经历了不起的冒险吧。"
                                },
                                {
                                    "id": "750110538",
                                    "speaker": "奇科娅",
                                    "text": "真好呀，有点羡慕。"
                                },
                                {
                                    "id": "750110539",
                                    "speaker": "奇科娅",
                                    "text": "#{NICKNAME}，前途无量的{M#少年}{F#少女}，以后的旅途也一定要顺利啊。"
                                },
                                {
                                    "id": "750110540",
                                    "speaker": "Player",
                                    "text": "你也一样…"
                                },
                                {
                                    "id": "750110541",
                                    "speaker": "Player",
                                    "text": "一定能达成自己的愿望的！"
                                },
                                {
                                    "id": "750110542",
                                    "speaker": "派蒙",
                                    "text": "「治疗一切创伤的秘药」也许没有，治疗「你的创伤的秘药」，一定能找得到！"
                                },
                                {
                                    "id": "750110543",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750110544",
                                    "speaker": "奇科娅",
                                    "text": "#哈哈，谢谢小派蒙，{NICKNAME}…还有{REALNAME[ID(2)|SHOWHOST(true)]}。"
                                },
                                {
                                    "id": "750110545",
                                    "speaker": "奇科娅",
                                    "text": "#…嗯，{NICKNAME}{M#少年}{F#少女}说了很让人动心的话，这次姐姐我呀，是真的有点动心哦，因为{M#少年}{F#少女}很可靠嘛。"
                                },
                                {
                                    "id": "750110546",
                                    "speaker": "奇科娅",
                                    "text": "好了，就让姐姐我在这里再休息一会儿吧，毕竟温泉也很舒服，再泡会儿温泉，再想想怎么从古卷中找别的方法吧…"
                                },
                                {
                                    "id": "750110547",
                                    "speaker": "奇科娅",
                                    "text": "唉，说不定会因为离家出走被臭骂一顿…"
                                },
                                {
                                    "id": "750110548",
                                    "speaker": "奇科娅",
                                    "text": "#不过，就像{NICKNAME}{M#少年}{F#少女}说的，要努力达成自己的愿望！"
                                }
                            ]
                        },
                        {
                            "id": "750110519",
                            "text": "你学会如何使用燃素了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501101",
            "objective": "前往浮土静界",
            "dialogues": [
                {
                    "id": "750110101",
                    "speaker": "派蒙",
                    "text": "原来这里就是「浮土静界」，从下面往上看的时候，还以为上面会是灰扑扑的，什么都没有…"
                },
                {
                    "id": "750110102",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750110103",
                    "speaker": "派蒙",
                    "text": "没想到是这个样子的。"
                },
                {
                    "id": "750110104",
                    "speaker": "奇科娅",
                    "text": "嗯，据说这里的浮土本身都是用燃素的力量聚合在一起的，燃素本身也是一种生命力特别旺盛的能源…能源有点怪，先这么理解吧。"
                },
                {
                    "id": "750110105",
                    "speaker": "奇科娅",
                    "text": "所以上面也能够长出草与花，能够让冷却的土地重新温热，能够在黑暗之中炽燃灵魂点亮火光。"
                },
                {
                    "id": "750110106",
                    "speaker": "奇科娅",
                    "text": "这就是「燃素」…是由「盗火贤者」从巨龙的手中抢夺至我们手中的东西。"
                },
                {
                    "id": "750110107",
                    "speaker": "奇科娅",
                    "text": "说到这个，想到有点生气的事情，哼，部族里的有些人啊，看到「浮土静界」…"
                },
                {
                    "id": "750110108",
                    "speaker": "奇科娅",
                    "text": "就说人类使用燃素绝对达不到能够造出浮岛的程度，所谓的「盗火贤者」其实也是巨龙之类的。"
                },
                {
                    "id": "750110109",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯？",
                    "choices": [
                        {
                            "id": "750110110",
                            "text": "还有这种观点？",
                            "response": [
                                {
                                    "id": "750110113",
                                    "speaker": "奇科娅",
                                    "text": "自己做不到就说能够做到的人「其实不是人哦」，真是没有志气的家伙，我才不要和他们做朋友呢。"
                                },
                                {
                                    "id": "750110114",
                                    "speaker": "派蒙",
                                    "text": "啊，说起来，宝藏，秘药呢？"
                                },
                                {
                                    "id": "750110115",
                                    "speaker": "派蒙",
                                    "text": "从这个意义上来说，这里看上去什么都没有！"
                                },
                                {
                                    "id": "750110116",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750110117",
                                    "speaker": "奇科娅",
                                    "text": "嘿嘿，这可是那个被称为疯子的「盗火贤者」的试炼，怎么会这么简单。"
                                },
                                {
                                    "id": "750110118",
                                    "speaker": "奇科娅",
                                    "text": "按照古织卷里的说法，现在我们要启动一些机关，完成最后的试炼，就可以达到「浮土静界」的中心…"
                                },
                                {
                                    "id": "750110119",
                                    "speaker": "奇科娅",
                                    "text": "不过我也不知道所谓「浮土静界」的中心是什么样的。总觉得记忆中看到的浮岛的图，和现在看到的有点差距…"
                                },
                                {
                                    "id": "750110120",
                                    "speaker": "奇科娅",
                                    "text": "不过有可能是年纪到了以后连原本引以为傲的记忆都变得不可靠了。不过没关系…都已经到这儿了，就靠着直觉来吧！"
                                },
                                {
                                    "id": "750110121",
                                    "speaker": "Player",
                                    "text": "那么，机关如何开启…"
                                },
                                {
                                    "id": "750110122",
                                    "speaker": "奇科娅",
                                    "text": "嗯，应该也和「燃素刻录」一样，使用燃素的话就能打开了？"
                                },
                                {
                                    "id": "750110123",
                                    "speaker": "奇科娅",
                                    "text": "至少古卷上是这样画的，据说遍布纳塔的「燃素刻印碑」其实就是以这里的机关为原型制作的…机关也是了不得的古物呢。"
                                },
                                {
                                    "id": "750110124",
                                    "speaker": "奇科娅",
                                    "text": "#前途无量的{M#少年}{F#少女}，哼哼，快去试试看吧。"
                                }
                            ]
                        },
                        {
                            "id": "750110111",
                            "text": "观点是自由的…",
                            "response": [
                                {
                                    "id": "750110112",
                                    "speaker": "奇科娅",
                                    "text": "我知道，别人认为世界是什么样的想法，其实都是很难撼动的，不过还是很火大。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501103",
            "objective": "与奇科娅对话",
            "dialogues": []
        },
        {
            "id": "7501107",
            "objective": "前往下一座浮岛",
            "dialogues": []
        },
        {
            "id": "7501118",
            "objective": "调查「镌光铭印」",
            "dialogues": []
        },
        {
            "id": "7501109",
            "objective": "前往最后一座浮岛",
            "dialogues": []
        },
        {
            "id": "7501120",
            "objective": "调查「镌光铭印」",
            "dialogues": []
        },
        {
            "id": "7501102",
            "objective": "探索浮岛",
            "dialogues": [
                {
                    "id": "750110201",
                    "speaker": "派蒙",
                    "text": "唔，这已经是最后一个机关了吧…"
                },
                {
                    "id": "750110202",
                    "speaker": "派蒙",
                    "text": "看上去和其他的机关也没什么区别嘛，奇科娅，你不会是被骗了吧？"
                },
                {
                    "id": "750110203",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "750110204",
                    "speaker": "奇科娅",
                    "text": "怎么会呢，对于古卷织物的解读啊，姐姐我可是很有信心…一些信心…呃，可是很有一点点信心的！"
                },
                {
                    "id": "750110205",
                    "speaker": "派蒙",
                    "text": "信心被越说越小了！救救信心啊！"
                },
                {
                    "id": "750110206",
                    "speaker": "奇科娅",
                    "text": "不过，这个应该不是最后一个机关，在我的印象里，机关的形状应该更大，也…更完整一点？"
                },
                {
                    "id": "750110207",
                    "speaker": "Player",
                    "text": "「中空之岛」…"
                },
                {
                    "id": "750110208",
                    "speaker": "奇科娅",
                    "text": "#听不懂啦，前途无量的{M#少年}{F#少女}，只是说出一个专有名词来，别人可是没法理解的。"
                },
                {
                    "id": "750110209",
                    "speaker": "奇科娅",
                    "text": "…到底有宝藏还是没有宝藏，有秘药还是没有秘药，其实，试试看不就知道了。"
                },
                {
                    "id": "750110210",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750110211",
                    "speaker": "奇科娅",
                    "text": "这次不行还有下次，这里不行还有其他的地方，只要试下去就会出现奇迹！",
                    "choices": [
                        {
                            "id": "750110212",
                            "text": "真是了不起的乐观。",
                            "response": [
                                {
                                    "id": "750110213",
                                    "speaker": "奇科娅",
                                    "text": "我就当你是夸我咯！"
                                },
                                {
                                    "id": "750110216",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750110217",
                                    "speaker": "奇科娅",
                                    "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也很兴奋嘛，来，{NICKNAME}，用燃素启动机关吧！"
                                }
                            ]
                        },
                        {
                            "id": "750110214",
                            "text": "能一直试下去才是最大的奇迹吧…",
                            "response": [
                                {
                                    "id": "750110215",
                                    "speaker": "奇科娅",
                                    "text": "不许在这里泼冷水啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501104",
            "objective": "调查巨大的石碑",
            "dialogues": []
        },
        {
            "id": "7501106",
            "objective": "与奇科娅对话",
            "dialogues": []
        },
        {
            "id": "7501110",
            "objective": "完成试炼",
            "dialogues": []
        },
        {
            "id": "7501113",
            "objective": "前往浮土静界的中心",
            "dialogues": []
        },
        {
            "id": "7501114",
            "objective": "前往中央的石碑",
            "dialogues": []
        },
        {
            "id": "7501112",
            "objective": "与奇科娅对话",
            "dialogues": [
                {
                    "id": "750110301",
                    "speaker": "奇科娅",
                    "text": "没想到「浮土静界」的中心是一座被藏起来了的岛，哎，我就说为什么「浮土静界」和我在图里看到的不一样。"
                },
                {
                    "id": "750110302",
                    "speaker": "奇科娅",
                    "text": "这说明我的记忆还是可靠的，毕竟平时有在担当整理古代织物的工作嘛。"
                },
                {
                    "id": "750110303",
                    "speaker": "派蒙",
                    "text": "不过，这里除了中间有个更大的石头以外，就没有其他的东西了…难道这个大石头就是「盗火贤者」的馈赠了吗？"
                },
                {
                    "id": "750110304",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯？"
                },
                {
                    "id": "750110305",
                    "speaker": "奇科娅",
                    "text": "…到这里，就，姐姐我也不知道啦。因为所有的织卷里都画着，勇士们经过试炼达到这里，就能够感受到「盗火贤者」的精神。"
                },
                {
                    "id": "750110306",
                    "speaker": "奇科娅",
                    "text": "只要是通过试炼来到此处的人，就能够感受到一种召唤。"
                },
                {
                    "id": "750110307",
                    "speaker": "奇科娅",
                    "text": "但是具体是什么形式，我也不知道。本来我以为到了这里以后我就能知道，就能够…可是现在看来并不行呢…"
                },
                {
                    "id": "750110308",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯…呀？"
                },
                {
                    "id": "750110309",
                    "speaker": "Player",
                    "text": "#咦，{REALNAME[ID(2)|SHOWHOST(true)]}你能看到吗？"
                },
                {
                    "id": "750110310",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750110311",
                    "speaker": "Player",
                    "text": "那，你能看懂吗？"
                },
                {
                    "id": "750110312",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "750110313",
                    "speaker": "奇科娅",
                    "text": "#你…看到了？你有看到什么吗？没有想到，原来有资格得到馈赠的人是{NICKNAME}{M#少年}{F#少女}吗？"
                },
                {
                    "id": "750110314",
                    "speaker": "派蒙",
                    "text": "咦，我也什么都没有看到…真奇怪。"
                },
                {
                    "id": "750110315",
                    "speaker": "Player",
                    "text": "我看到了金色的花纹…"
                },
                {
                    "id": "750110316",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "750110317",
                    "speaker": "派蒙",
                    "text": "#金色的花纹？你是说，在初次遇见{REALNAME[ID(2)|SHOWHOST(true)]}的地方看到过的那个吗？"
                },
                {
                    "id": "750110318",
                    "speaker": "派蒙",
                    "text": "欸，那个不是你的幻觉吗？"
                },
                {
                    "id": "750110319",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "750110320",
                    "speaker": "派蒙",
                    "text": "#就算{REALNAME[ID(2)|SHOWHOST(true)]}你示意我抬头也没用啦，我看不到，可是既然{REALNAME[ID(2)|SHOWHOST(true)]}这样说了…",
                    "choices": [
                        {
                            "id": "750110321",
                            "text": "语气也很熟悉…",
                            "response": [
                                {
                                    "id": "750110323",
                                    "speaker": "派蒙",
                                    "text": "所以当时留下金色花纹的，或许就是「盗火贤者」？"
                                },
                                {
                                    "id": "750110324",
                                    "speaker": "奇科娅",
                                    "text": "什么呀，原来你们之前就已经得到过「盗火贤者」的启示了啊…"
                                },
                                {
                                    "id": "750110325",
                                    "speaker": "奇科娅",
                                    "text": "#那前途无量的{M#少年}{F#少女}，哼，果然前途无量，毕竟能够被我看中嘛，那么{M#少年}{F#少女}有找到馈赠的方法吗？"
                                },
                                {
                                    "id": "750110326",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！",
                                    "choices": [
                                        {
                                            "id": "750110327",
                                            "text": "嗯，只要…",
                                            "response": [
                                                {
                                                    "id": "750110329",
                                                    "speaker": "Black Screen",
                                                    "text": "石碑发出了巨大的嗡鸣声。\\n随着地面的颤动，地上的巨石显露出了真形…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750110328",
                                            "text": "(向着巨大石碑伸出手去…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750110322",
                            "text": "和当时留下金色花纹的是一个人…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501116",
            "objective": "击败醒来的怪物",
            "dialogues": []
        },
        {
            "id": "7501117",
            "objective": "与奇科娅对话",
            "dialogues": []
        },
        {
            "id": "7501115",
            "objective": "(test)与历史学家对话",
            "dialogues": []
        },
        {
            "id": "7501119",
            "objective": "(test)与历史学家对话",
            "dialogues": []
        },
        {
            "id": "7501199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750119901",
                    "speaker": "奇科娅",
                    "text": "有点愉快呢，不如说，十分高兴…嘿嘿，没想到真的能够上到「浮土静界」。"
                },
                {
                    "id": "750119902",
                    "speaker": "奇科娅",
                    "text": "本来以为自己能到下面的门前看看就差不多了…"
                },
                {
                    "id": "750119903",
                    "speaker": "奇科娅",
                    "text": "#多亏了{NICKNAME}{M#少年}{F#少女}啊，不然偷偷跑出来一趟什么都没看到就太亏了。"
                },
                {
                    "id": "750119904",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "750119905",
                    "speaker": "派蒙",
                    "text": "欸…什么叫偷偷跑出来一趟？"
                },
                {
                    "id": "750119906",
                    "speaker": "奇科娅",
                    "text": "是这样啦，我没有告诉部族里的朋友和亲人就出来了…"
                },
                {
                    "id": "750119907",
                    "speaker": "奇科娅",
                    "text": "咦，我之前没跟你们说过吗？"
                },
                {
                    "id": "750119908",
                    "speaker": "派蒙",
                    "text": "等等，这不就是离家出走嘛！"
                },
                {
                    "id": "750119909",
                    "speaker": "奇科娅",
                    "text": "小孩才会离家出走，大人只是会突然消失啦。"
                },
                {
                    "id": "750119910",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀…嗯？"
                },
                {
                    "id": "750119911",
                    "speaker": "派蒙",
                    "text": "#咦，{NICKNAME}，是我看错了吗，怎么感觉中间的部分，多出了一座浮岛？"
                },
                {
                    "id": "750119912",
                    "speaker": "奇科娅",
                    "text": "没有看错，派蒙，那就是…「浮土静界」的中心。"
                },
                {
                    "id": "750119913",
                    "speaker": "奇科娅",
                    "text": "啊，难道之前的镌光铭印，其实都是为了…"
                },
                {
                    "id": "750119915",
                    "speaker": "奇科娅",
                    "text": "啊，小心！结果最终试炼果然还是战斗吗…"
                },
                {
                    "id": "750119916",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜呜…"
                },
                {
                    "id": "750119917",
                    "speaker": "奇科娅",
                    "text": "#{NICKNAME}，要注意它们的拳头哦！"
                }
            ]
        }
    ]
}