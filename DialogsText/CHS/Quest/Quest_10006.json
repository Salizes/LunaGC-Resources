            ]
        },
        {
            "id": "1000605",
            "objective": "击败出现的魔物",
            "dialogues": []
        },
        {
            "id": "1000610",
            "objective": "与赛巴斯对话",
            "dialogues": []
        },
        {
            "id": "1000606",
            "objective": "与赛巴斯对话",
            "dialogues": []
        },
        {
            "id": "1000602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100060201",
                    "speaker": "派蒙",
                    "text": "呜啊，这是哪里啦？这本辞典又把我们带到什么奇怪的地方来了！"
                },
                {
                    "id": "100060202",
                    "speaker": "杜林",
                    "text": "这里好像有…妈妈的味道。"
                },
                {
                    "id": "100060203",
                    "speaker": "派蒙",
                    "text": "哇，有一只奇怪的猫出现了。"
                }
            ]
        },
        {
            "id": "1000606",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100060601",
                    "speaker": "「莱茵多特」",
                    "text": "「嗯，看来这次阿贝多没有搞错嘛。」"
                },
                {
                    "id": "100060602",
                    "speaker": "派蒙",
                    "text": "喂，下次能不能不要再搞这种突然袭击了啊！"
                },
                {
                    "id": "100060603",
                    "speaker": "杜林",
                    "text": "不过感觉击败它们之后，我好像能更自如地控制身体里的力量了。"
                },
                {
                    "id": "100060604",
                    "speaker": "「莱茵多特」",
                    "text": "「其实，听说了你的事情后，我原本准备了能够封印住你血液中那些黑暗力量的术式，打算趁此机会交给你。」"
                },
                {
                    "id": "100060605",
                    "speaker": "「莱茵多特」",
                    "text": "「当然，使用那个术式会付出相应的代价，它虽然能维持你在提瓦特的存在，但却会削弱你与世界的联系。」"
                },
                {
                    "id": "100060606",
                    "speaker": "「莱茵多特」",
                    "text": "「毕竟你可是M的孩子，要是因为那些没有处理好的力量，而使你步上和那孩子同样的命运，可就太对不起她了。」"
                },
                {
                    "id": "100060607",
                    "speaker": "「莱茵多特」",
                    "text": "「不过现在看来我的担心是多余的。M是个了不起的母亲呢，比我要称职多了。」"
                },
                {
                    "id": "100060608",
                    "speaker": "「莱茵多特」",
                    "text": "「现在，我很期待你能成长到什么样的地步。一个真正融入这个世界的炼金生命，要如何在人类社会找到属于自己的位置。」"
                },
                {
                    "id": "100060609",
                    "speaker": "「莱茵多特」",
                    "text": "「这样的实验我还从没做过，或许从你的身上，我能得到意料之外的『答案』。」"
                },
                {
                    "id": "100060610",
                    "speaker": "派蒙",
                    "text": "唔，不过杜林可不是什么实验，他是我们重要的朋友。"
                },
                {
                    "id": "100060611",
                    "speaker": "杜林",
                    "text": "虽然不是很明白，不过谢谢你的好意，莱茵多特阿姨。"
                }
            ]
        },
        {
            "id": "1000699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100069901",
                    "speaker": "派蒙",
                    "text": "呜哇，怎么突然冒出来这么多魔物！"
                },
                {
                    "id": "100069902",
                    "speaker": "杜林",
                    "text": "这就是您所需要的证明吗？莱茵多特阿姨，就请好好看着吧。"
                },
                {
                    "id": "100069903",
                    "speaker": "杜林",
                    "text": "身体里的力量似乎正在逐渐释放出来…"
                },
                {
                    "id": "100069904",
                    "speaker": "杜林",
                    "text": "感觉越来越轻松了呢！"
                }
            ]
        }
    ]
