    "talks": [
        {
            "id": "1000601",
            "objective": "前往西风骑士团总部",
            "dialogues": [
                {
                    "id": "100060101",
                    "speaker": "派蒙",
                    "text": "你好呀，杜林，原来你在这里。"
                },
                {
                    "id": "100060102",
                    "speaker": "杜林",
                    "text": "#是{NICKNAME}和派蒙，你们怎么来了？"
                },
                {
                    "id": "100060103",
                    "speaker": "派蒙",
                    "text": "嘿嘿，外面天气这么好，你怎么一个人在这里看书啊？"
                },
                {
                    "id": "100060104",
                    "speaker": "杜林",
                    "text": "是这样的，自从在蒙德和大家「社交」的机会变多了之后，我就经常会把大家说的玩笑话当真。"
                },
                {
                    "id": "100060105",
                    "speaker": "杜林",
                    "text": "比如上次我在花店看到了一束非常美丽的花，告诉店主之后，她说："
                },
                {
                    "id": "100060106",
                    "speaker": "杜林",
                    "text": "「呼呼，你要是看上了这些杂草，那不如拿薄荷和甜甜花跟它一起插个花束好了。」"
                },
                {
                    "id": "100060107",
                    "speaker": "杜林",
                    "text": "结果，等我按照她的说法，把做好的花束拿去给她看的时候，她却露出了非常可怕的表情…",
                    "choices": [
                        {
                            "id": "100060108",
                            "text": "杜林的眼光很独特呢。",
                            "response": [
                                {
                                    "id": "100060110",
                                    "speaker": "杜林",
                                    "text": "后来阿贝多说，这是因为我还没办法听懂大家话语中的「言外之意」。"
                                },
                                {
                                    "id": "100060111",
                                    "speaker": "杜林",
                                    "text": "在学会蒙德的文字后，他就跟我说可以多看看这里的书。"
                                },
                                {
                                    "id": "100060112",
                                    "speaker": "杜林",
                                    "text": "因为我是从故事书里诞生的，所以应该也能从这些书中学到这个世界的「规则」。"
                                },
                                {
                                    "id": "100060113",
                                    "speaker": "杜林",
                                    "text": "结果我不知不觉就看到了现在…对了，还没问你们找我有什么事情呢？",
                                    "choices": [
                                        {
                                            "id": "100060114",
                                            "text": "朋友之间应该经常互相拜访。",
                                            "response": [
                                                {
                                                    "id": "100060115",
                                                    "speaker": "杜林",
                                                    "text": "原来是这样，这也是「规则」的一部分吧，又学到了。"
                                                },
                                                {
                                                    "id": "100060116",
                                                    "speaker": "派蒙",
                                                    "text": "虽然是这样没错，不过我们还有正事要说吧。"
                                                },
                                                {
                                                    "id": "100060118",
                                                    "speaker": "派蒙",
                                                    "text": "是这样的，其实我们带来了莱茵多特要交给你的「口信」。"
                                                },
                                                {
                                                    "id": "100060119",
                                                    "speaker": "杜林",
                                                    "text": "居然是…莱茵多特阿姨吗…",
                                                    "choices": [
                                                        {
                                                            "id": "100060120",
                                                            "text": "怎么了？",
                                                            "response": [
                                                                {
                                                                    "id": "100060122",
                                                                    "speaker": "杜林",
                                                                    "text": "嗯，我只是有些意外…莱茵多特是妈妈的朋友，也是曾经存在于这个世界的「魔龙」的母亲。"
                                                                },
                                                                {
                                                                    "id": "100060123",
                                                                    "speaker": "杜林",
                                                                    "text": "而我取代了原本属于它的命运。"
                                                                },
                                                                {
                                                                    "id": "100060124",
                                                                    "speaker": "杜林",
                                                                    "text": "所以如果她讨厌我的话…我也不知道该怎么办才好了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "100060125",
                                                                            "text": "她应该没那么小气。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "100060127",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯嗯，杜林你别担心，一定不会是什么坏事的。而且还有我们在呢！"
                                                                                },
                                                                                {
                                                                                    "id": "100060128",
                                                                                    "speaker": "杜林",
                                                                                    "text": "听到你们这样说，我就安心多了。"
                                                                                },
                                                                                {
                                                                                    "id": "100060129",
                                                                                    "speaker": "杜林",
                                                                                    "text": "既然如此，那我就拆开来看看…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "100060126",
                                                                            "text": "有我们在呢。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "100060121",
                                                            "text": "别紧张。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "100060117",
                                            "text": "我们是为了魔女…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "100060109",
                            "text": "总感觉是她的问题。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1000607",
            "objective": "与杜林对话",
            "dialogues": [
                {
                    "id": "100060701",
                    "speaker": "赛巴斯",
                    "text": "咳…以上，莱茵多特主人就说了这些，咳咳。"
                },
                {
                    "id": "100060702",
                    "speaker": "Player",
                    "text": "真是辛苦你了。"
                },
                {
                    "id": "100060703",
                    "speaker": "派蒙",
                    "text": "虽然已经不是第一次见了，不过能模仿别人说话的猫感觉还挺稀奇的。"
                },
                {
                    "id": "100060704",
                    "speaker": "赛巴斯",
                    "text": "可不要把我和普通的猫相提并论啊。"
                }
            ]
        },
        {
            "id": "1000609",
            "objective": "与杜林对话",
            "dialogues": [
                {
                    "id": "100060901",
                    "speaker": "赛巴斯",
                    "text": "况且从生物学上看，我作为炼金生物也不能算是「猫」，就像你和那些飞来飞去的飘浮灵也不能算是同类，不是吗？"
                },
                {
                    "id": "100060902",
                    "speaker": "派蒙",
                    "text": "嗯？什么飘浮灵？总感觉这家伙话里有话…"
                },
                {
                    "id": "100060903",
                    "speaker": "杜林",
                    "text": "我知道，这就是「言外之意」对吧？所以赛巴斯应该是想说…"
                },
                {
                    "id": "100060904",
                    "speaker": "Player",
                    "text": "别说出来啊，杜林。"
                },
                {
                    "id": "100060905",
                    "speaker": "派蒙",
                    "text": "喂，你们什么意思啦！"
                },
                {
                    "id": "100060906",
                    "speaker": "赛巴斯",
                    "text": "哦对，既然莱茵多特主人这样说了，那么这个已经没有用的术式我就销毁了。"
                },
                {
                    "id": "100060907",
                    "speaker": "赛巴斯",
                    "text": "能让莱茵多特主人多虑的机会可不多，小哥我很看好你啊。"
                },
                {
                    "id": "100060908",
                    "speaker": "赛巴斯",
                    "text": "好了，现在我得走了。我还有别的口信要送，说不定我们还会再见面的。"
                }
            ]
        },
        {
            "id": "1000602",
            "objective": "与杜林对话",
            "dialogues": [
                {
                    "id": "100060501",
                    "speaker": "「莱茵多特」",
                    "text": "「初次见面，我还不知道应该怎么称呼你呢。既然是M的孩子，就姑且继续叫你小杜林了。」"
                },
                {
                    "id": "100060502",
                    "speaker": "「莱茵多特」",
                    "text": "「虽然看上去身体是小得多了，不过你的血液中所残留的，那孩子留下来的力量可是一点也不小。」"
                },
                {
                    "id": "100060503",
                    "speaker": "「莱茵多特」",
                    "text": "「那孩子是『腐殖层』的不完全造物，因此缺乏能够支配自身力量的『意志』。」"
                },
                {
                    "id": "100060504",
                    "speaker": "「莱茵多特」",
                    "text": "「缺乏『意志』的孩子，却得到了超过自身承受能力的力量，于是便被那力量所扭曲、吞噬，走向命定的结局。」"
                },
                {
                    "id": "100060505",
                    "speaker": "「莱茵多特」",
                    "text": "「阿贝多说，你是超越了腐殖之血，与他相近的同类。但这是他个人意见，还没能得到我的认可。」"
                },
                {
                    "id": "100060506",
                    "speaker": "「莱茵多特」",
                    "text": "「我只会被绝对的事实说服。我需要『看见』。趁着这次机会，M的孩子，就在这里证明给我看吧。」"
                }
            ]
        },
        {
            "id": "1000608",
            "objective": "击败出现的魔物",
            "dialogues": [
                {
                    "id": "100060801",
                    "speaker": "？？？",
                    "text": "咳…以上，莱茵多特主人就说了这些，咳咳。"
                },
                {
                    "id": "100060802",
                    "speaker": "Player",
                    "text": "你还没自我介绍呢。"
                },
                {
                    "id": "100060803",
                    "speaker": "派蒙",
                    "text": "对哦，虽然猫会说话这种事已经习惯了，不过能模仿别人说话的猫还是第一次见。"
                },
                {
                    "id": "100060804",
                    "speaker": "赛巴斯",
                    "text": "我吗？这不重要。我叫赛巴斯，只是一位管家罢了。"
                },
                {
                    "id": "100060805",
                    "speaker": "赛巴斯",
                    "text": "你们是阿贝多的朋友，对吧。严格来说，我可是他的「长辈」呢，所以不要把我和普通的猫相提并论。"
                }
            ]
        },
        {
            "id": "1000603",
            "objective": "击败出现的魔物",
            "dialogues": [
                {
                    "id": "100060301",
                    "speaker": "Player",
                    "text": "又见面了赛巴斯。"
                },
                {
                    "id": "100060302",
                    "speaker": "赛巴斯",
                    "text": "咳，受莱茵多特主人所命，我带来了要传达的口信。"
                },
                {
                    "id": "100060303",
                    "speaker": "赛巴斯",
                    "text": "咳咳…"
                }
            ]
        },
        {
            "id": "1000604",
            "objective": "击败出现的魔物",
            "dialogues": [
                {
