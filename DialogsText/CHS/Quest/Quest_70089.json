    "talks": [
        {
            "id": "7008901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "700890101",
                    "speaker": "派蒙",
                    "text": "咦，这里怎么有个人？"
                },
                {
                    "id": "700890102",
                    "speaker": "？？？",
                    "text": "也不是这个风神像…"
                },
                {
                    "id": "700890103",
                    "speaker": "派蒙",
                    "text": "喂，你在干什么啊？"
                },
                {
                    "id": "700890104",
                    "speaker": "？？？",
                    "text": "我在找回去的路。我只记得要找风神像。"
                },
                {
                    "id": "700890105",
                    "speaker": "？？？",
                    "text": "其他的我也什么都不记得了。"
                },
                {
                    "id": "700890106",
                    "speaker": "派蒙",
                    "text": "回去的路？"
                },
                {
                    "id": "700890107",
                    "speaker": "？？？",
                    "text": "隐隐约约的一种乡愁，但是我什么都不记得。"
                },
                {
                    "id": "700890108",
                    "speaker": "？？？",
                    "text": "我醒来的时候，手里只有一张写了「你是『莫基』」的纸条。"
                },
                {
                    "id": "700890109",
                    "speaker": "「莫基」",
                    "text": "所以我想我名字应该就是「莫基」。"
                },
                {
                    "id": "700890110",
                    "speaker": "「莫基」",
                    "text": "不打扰你们了。再见。"
                },
                {
                    "id": "700890111",
                    "speaker": "派蒙",
                    "text": "好奇怪的人。不过应该不是坏人吧。"
                },
                {
                    "id": "700890112",
                    "speaker": "派蒙",
                    "text": "你怎么了？"
                },
                {
                    "id": "700890113",
                    "speaker": "Player",
                    "text": "看到了奇怪的景象。"
                },
                {
                    "id": "700890114",
                    "speaker": "派蒙",
                    "text": "奇怪的景象？难道是因为刚才那个人碰了神像吗？"
                }
            ]
        },
        {
