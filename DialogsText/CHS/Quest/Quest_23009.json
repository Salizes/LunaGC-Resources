            "dialogues": []
        },
        {
            "id": "2300902",
            "objective": "与阿金对话",
            "dialogues": [
                {
                    "id": "230090201",
                    "speaker": "阿金",
                    "text": "还得再去买些材料回来…"
                },
                {
                    "id": "230090202",
                    "speaker": "Player",
                    "text": "你的「凝成泥土」怎么样了？"
                },
                {
                    "id": "230090203",
                    "speaker": "阿金",
                    "text": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。"
                },
                {
                    "id": "230090204",
                    "speaker": "阿金",
                    "text": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。"
                },
                {
                    "id": "230090205",
                    "speaker": "阿金",
                    "text": "只要调整一下各种泥土的混合比例，直接用来搭建房屋也没有问题。"
                },
                {
                    "id": "230090206",
                    "speaker": "阿金",
                    "text": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。"
                },
                {
                    "id": "230090207",
                    "speaker": "阿金",
                    "text": "而且最关键的史莱姆凝液也用光了，旅行者，能请你再去帮我拿三份史莱姆凝液回来吗？",
                    "choices": [
                        {
                            "id": "230090208",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230090212",
                                    "speaker": "阿金",
                                    "text": "拜托你了，旅行者，请你帮我拿三份史莱姆凝液回来吧。"
                                }
                            ]
                        },
                        {
                            "id": "230090209",
                            "text": "其他材料呢？",
                            "response": [
                                {
                                    "id": "230090210",
                                    "speaker": "阿金",
                                    "text": "其他的材料我都已经从各种渠道订购，或者托人去找了。"
                                },
                                {
                                    "id": "230090211",
                                    "speaker": "阿金",
                                    "text": "但史莱姆凝液消耗得实在太快，出乎我的预料…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300903",
            "objective": "将三个史莱姆凝液交给阿金",
            "dialogues": [
                {
                    "id": "230090301",
                    "speaker": "阿金",
                    "text": "旅行者，你拿到史莱姆凝液了吗？"
                }
            ]
        },
        {
            "id": "2300917",
            "objective": "继续与阿金对话",
            "dialogues": [
                {
                    "id": "230091701",
                    "speaker": "阿金",
                    "text": "谢谢你，这样材料就暂时齐全了。"
                },
                {
                    "id": "230091702",
                    "speaker": "阿金",
                    "text": "请你稍等一下，我现在就调配一下凝成泥土…"
                },
                {
                    "id": "230091703",
                    "speaker": "Black Screen",
                    "text": "阿金开始调配泥土…"
                },
                {
                    "id": "230091704",
                    "speaker": "阿金",
                    "text": "这样就可以了，旅行者，请你帮我把这份泥土带给尼姆吧。"
                },
                {
                    "id": "230091705",
                    "speaker": "阿金",
                    "text": "他可是等着这泥土好久了，想必都等急了。"
                },
                {
                    "id": "230091706",
                    "speaker": "阿金",
                    "text": "这孩子可是有着…嗯…非比寻常的想象力。"
                },
                {
                    "id": "230091707",
                    "speaker": "阿金",
                    "text": "尼姆和我说，他想要做一群「泥罐战士」，这群战士们都是一个个会说话的泥罐，能够滚动着身子打倒敌人，还有各种神奇的能力。"
                },
                {
                    "id": "230091708",
                    "speaker": "阿金",
                    "text": "而这群「泥罐战士」的能力，则根据他们塞进自己「罐体」里的材料而各不相同。"
                },
                {
                    "id": "230091709",
                    "speaker": "阿金",
                    "text": "他还给「泥罐战士」取了名字呢，好像叫亚什么来着…"
                },
                {
                    "id": "230091710",
                    "speaker": "阿金",
                    "text": "哈哈哈，虽然实现不了，但他的想法真的很有趣。"
                },
                {
                    "id": "230091711",
                    "speaker": "阿金",
                    "text": "我就想，既然他有这么新奇的点子，不如就把这泥土当做玩具送给他。"
                },
                {
                    "id": "230091712",
                    "speaker": "阿金",
                    "text": "这样，他就可以亲手铸造出他的「泥罐战士」们，正式当上「泥罐将军」了。"
                },
                {
                    "id": "230091713",
                    "speaker": "阿金",
                    "text": "咳，先不说了，总之请你把这罐泥土送给尼姆吧。"
                },
                {
                    "id": "230091714",
                    "speaker": "阿金",
                    "text": "等到他的「泥罐战士」正式出炉，说不定他也会封你和我一个「泥罐大将」的称号呢。"
                }
            ]
        },
        {
            "id": "2300904",
            "objective": "将泥土交给尼姆",
            "dialogues": [
                {
                    "id": "230090401",
                    "speaker": "尼姆",
                    "text": "#你好，{M#大哥哥}{F#大姐姐}，请问有什么事吗？"
                }
            ]
        },
        {
            "id": "2300918",
            "objective": "继续与尼姆对话",
            "dialogues": [
                {
                    "id": "230091801",
                    "speaker": "尼姆",
                    "text": "哇，这就是阿金叔叔说的，什么都能做的泥土吧！"
                },
                {
                    "id": "230091802",
                    "speaker": "尼姆",
                    "text": "#太好了，谢谢你，{M#大哥哥}{F#大姐姐}！"
                },
                {
                    "id": "230091803",
                    "speaker": "尼姆",
                    "text": "这下，我就可以把「亚德里」做出来了！"
                },
                {
                    "id": "230091804",
                    "speaker": "Player",
                    "text": "「亚德里」是…"
                },
                {
                    "id": "230091805",
                    "speaker": "尼姆",
                    "text": "#{M#大哥哥}{F#大姐姐}没听阿金叔叔说吗？"
                },
                {
                    "id": "230091806",
                    "speaker": "尼姆",
                    "text": "我正在做「泥罐战士」呢。「亚德里」就是最初，也是最强的「泥罐战士」！"
                },
                {
                    "id": "230091807",
                    "speaker": "尼姆",
                    "text": "他脾气很好，也很善良。作为「泥罐战士」苏醒的时候，第一件事就是向被他压在身子下面的草地道歉。"
                },
                {
                    "id": "230091808",
                    "speaker": "尼姆",
                    "text": "他的能力是…能力是…"
                },
                {
                    "id": "230091809",
                    "speaker": "尼姆",
                    "text": "我，我还没想好…等我想好了，第一个告诉你！"
                },
                {
                    "id": "230091810",
                    "speaker": "尼姆",
                    "text": "做完了「亚德里」之后，我还要做他的副官「伊瓦尔」和徒弟「拉松」。"
                },
                {
                    "id": "230091811",
                    "speaker": "尼姆",
                    "text": "他们三个人…不对，三个「泥罐战士」，会开始一场很长很长的旅行…"
                }
            ]
        },
        {
