            "dialogues": [
                {
                    "id": "230092101",
                    "speaker": "阿金",
                    "text": "谢谢你，我会分析这一批泥土的情况。"
                },
                {
                    "id": "230092102",
                    "speaker": "阿金",
                    "text": "怎么会发生这种事…难道我还要接着调整比例吗…"
                },
                {
                    "id": "230092103",
                    "speaker": "阿金",
                    "text": "唉，做泥土怎么这么难…"
                }
            ]
        },
        {
