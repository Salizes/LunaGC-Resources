    "talks": [
        {
            "id": "2303201",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "230320101",
                    "speaker": "维克多",
                    "text": "旅行者，你来得正好。"
                },
                {
                    "id": "230320102",
                    "speaker": "Player",
                    "text": "你的木雕怎么样了？"
                },
                {
                    "id": "230320103",
                    "speaker": "维克多",
                    "text": "呃…我偷偷做木雕的事被弗谢沃洛德先生给发现了…"
                },
                {
                    "id": "230320104",
                    "speaker": "维克多",
                    "text": "不过，他倒是也没怎么发脾气，就是让我工作的时候别做闲事…还找我要了个小兔子的木雕。",
                    "choices": [
                        {
                            "id": "230320105",
                            "text": "他不会也有孩子要哄吧…",
                            "response": [
                                {
                                    "id": "230320107",
                                    "speaker": "维克多",
                                    "text": "弗谢沃洛德先生说，我做的木雕很有至冬的风格，他很喜欢。"
                                },
                                {
                                    "id": "230320108",
                                    "speaker": "维克多",
                                    "text": "我听人说，弗谢沃洛德先生一直因为命令在外奔波，已经很久没有回过至冬陪过家人了。"
                                },
                                {
                                    "id": "230320109",
                                    "speaker": "维克多",
                                    "text": "我觉得，也许他和我不一样，是真的想家了吧…"
                                },
                                {
                                    "id": "230320110",
                                    "speaker": "维克多",
                                    "text": "唉，闲话就说到这，旅行者，我又找哈马维订了一批木头，请你帮我去看看吧。",
                                    "choices": [
                                        {
                                            "id": "230320111",
                                            "text": "报酬准备好。",
                                            "response": [
                                                {
                                                    "id": "230320112",
                                                    "speaker": "维克多",
                                                    "text": "你就放心吧，这次都是真金白银的报酬。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230320113",
                                            "text": "你不想回至冬吗？",
                                            "response": [
                                                {
                                                    "id": "230320114",
                                                    "speaker": "维克多",
                                                    "text": "我倒是还好…我在至冬又没什么亲人，也习惯一个人到处跑了。而且在须弥我过得还挺舒服的…"
                                                },
                                                {
                                                    "id": "230320115",
                                                    "speaker": "维克多",
                                                    "text": "我之前说想回至冬，只不过是因为蒙德太无聊啦…咳！"
                                                },
                                                {
                                                    "id": "230320116",
                                                    "speaker": "维克多",
                                                    "text": "总之这件事就拜托你了，报酬我会准备好的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230320106",
                            "text": "你们愚人众真有童心…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303202",
            "objective": "与哈马维对话",
            "dialogues": [
                {
                    "id": "230320201",
                    "speaker": "哈马维",
                    "text": "真是倒霉…"
                },
                {
                    "id": "230320202",
                    "speaker": "Player",
                    "text": "关于维克多的木头…"
                },
                {
                    "id": "230320203",
                    "speaker": "哈马维",
                    "text": "你是说那个愚人众找我订的木头吧。"
                },
                {
                    "id": "230320204",
                    "speaker": "哈马维",
                    "text": "唉，别提了，我就说和愚人众做生意不会有好运气。"
                },
                {
                    "id": "230320205",
                    "speaker": "哈马维",
                    "text": "那批木头运到一半就被魔物袭击了，人是全跑回来了，但车毁了，木头都丢在了半路上。"
                },
                {
                    "id": "230320206",
                    "speaker": "哈马维",
                    "text": "唉，现在这情况，我是不敢过去了，一时半会也找不到人去赶走那些魔物…"
                },
                {
                    "id": "230320208",
                    "speaker": "Player",
                    "text": "我不是愚人众…"
                },
                {
                    "id": "230320209",
                    "speaker": "哈马维",
                    "text": "你不是愚人众吗？那你怎么帮他做事？奇怪…"
                },
                {
                    "id": "230320210",
                    "speaker": "哈马维",
                    "text": "无论如何，那辆车我暂时是拉不回来了，我只能等到能雇到人之后再想办法。"
                },
                {
                    "id": "230320211",
                    "speaker": "哈马维",
                    "text": "如果你着急要木头的话，我把那辆车大概的地方给你标在地图上，你自己过去看看吧。"
                },
                {
                    "id": "230320212",
                    "speaker": "哈马维",
                    "text": "唉，只要和愚人众沾边果然就遇不上好事…"
                }
            ]
        },
        {
            "id": "2303218",
            "objective": "打倒所有蕈兽$HIDDEN",
            "dialogues": [
                {
                    "id": "230321801",
                    "speaker": "维克多",
                    "text": "旅行者，事情怎么样了？"
                },
                {
                    "id": "230321802",
                    "speaker": "Black Screen",
                    "text": "向维克多叙述了事情的经过…"
                },
                {
                    "id": "230321803",
                    "speaker": "维克多",
                    "text": "太好了，多谢你帮忙，旅行者。"
                },
                {
                    "id": "230321804",
                    "speaker": "维克多",
                    "text": "这些报酬是给你的，收下吧，我要继续去给莉莉写信了。"
                },
                {
                    "id": "230321805",
                    "speaker": "维克多",
                    "text": "唉，我给这丫头写信的时候，简直比向弗谢沃洛德先生做报告还紧张…"
                }
            ]
        },
        {
            "id": "2303203",
            "objective": "前往货车所在地点",
            "dialogues": [
                {
                    "id": "230320301",
                    "speaker": "维克多",
                    "text": "没想到，我还能把木雕手艺重新捡起来…"
                }
            ]
        },
        {
            "id": "2303204",
            "objective": "打倒所有蕈兽，并拿回木板",
            "dialogues": [
                {
                    "id": "230320401",
                    "speaker": "哈马维",
                    "text": "唉，只要和愚人众沾边果然就遇不上好事…"
                }
            ]
        },
        {
            "id": "2303205",
            "objective": "向哈马维回报",
            "dialogues": [
                {
                    "id": "230320501",
                    "speaker": "哈马维",
                    "text": "唉，只要和愚人众沾边果然就遇不上好事…"
                },
                {
                    "id": "230320502",
                    "speaker": "Player",
                    "text": "关于维克多的木头…"
                },
                {
                    "id": "230320503",
                    "speaker": "哈马维",
                    "text": "这木头是…你已经把魔物都赶走了？看不出来，你还挺能打的…"
                },
                {
                    "id": "230320504",
                    "speaker": "哈马维",
                    "text": "多谢你了，我等会就找人和我一起过去，把木头给弄回来。"
                },
                {
                    "id": "230320505",
                    "speaker": "哈马维",
                    "text": "唉，只要和愚人众沾边果然就遇不上好事…"
                }
            ]
        },
        {
            "id": "2303206",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "230320601",
                    "speaker": "维克多",
                    "text": "怎么样，我买的木头已经到了吗？"
                },
                {
                    "id": "230320602",
                    "speaker": "Black Screen",
                    "text": "向维克多叙述了事情的过程…"
                },
                {
                    "id": "230320603",
                    "speaker": "维克多",
                    "text": "又是魔物？我怎么感觉全世界的货车都很容易被魔物袭击…"
                },
                {
                    "id": "230320604",
                    "speaker": "维克多",
                    "text": "算了，反正木头能送回来就行。"
                },
                {
                    "id": "230320605",
                    "speaker": "维克多",
                    "text": "喏，这是说好的报酬，好好数一数吧。"
                },
                {
                    "id": "230320606",
                    "speaker": "维克多",
                    "text": "还有…那个，莉莉还好吗？"
                },
                {
                    "id": "230320607",
                    "speaker": "维克多",
                    "text": "我走的时候也没和那丫头当面道别，她没生气吧？",
                    "choices": [
                        {
                            "id": "230320608",
                            "text": "她很好。",
                            "response": [
                                {
                                    "id": "230320609",
                                    "speaker": "维克多",
                                    "text": "那就行，咳…你别这么看着我，我就是关心一下啊！"
                                },
                                {
                                    "id": "230320614",
                                    "speaker": "维克多",
                                    "text": "不说这些了，再数数报酬吧，旅行者，我可是一分都没少你的。"
                                }
                            ]
                        },
                        {
                            "id": "230320610",
                            "text": "你自己回去看看她呗。",
                            "response": [
                                {
                                    "id": "230320611",
                                    "speaker": "维克多",
                                    "text": "那弗谢沃洛德先生非得踢我不可，算了吧。"
                                },
                                {
                                    "id": "230320612",
                                    "speaker": "维克多",
                                    "text": "我也不太敢直接寄信过去。"
                                },
                                {
                                    "id": "230320613",
                                    "speaker": "维克多",
                                    "text": "收到一封来自愚人众的信，听起来就不像什么好事，哈哈哈…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303207",
            "objective": "与兰巴德对话",
            "dialogues": [
                {
                    "id": "230320901",
                    "speaker": "兰巴德",
                    "text": "你好，请问有什么事吗？"
                },
                {
                    "id": "230320902",
                    "speaker": "Player",
                    "text": "关于维克多的委托…"
                },
                {
                    "id": "230320903",
                    "speaker": "兰巴德",
                    "text": "噢，你是说他拜托我采购的香料吧，都已经采购好了，过会我就把东西送过去。"
                },
                {
                    "id": "230320904",
                    "speaker": "兰巴德",
                    "text": "午饭嘛…哎呀，今天的客人有点多，食材都用得差不多了…"
                },
                {
                    "id": "230320905",
                    "speaker": "兰巴德",
                    "text": "这样好了，旅行者，请你帮我去拿两个土豆回来吧。"
                },
                {
                    "id": "230320906",
                    "speaker": "兰巴德",
                    "text": "作为回报…我也会给你做一道「绿汁脆球」的，拜托你了。"
                }
            ]
        },
        {
            "id": "2303216",
            "objective": "与兰巴德对话",
            "dialogues": [
                {
                    "id": "230321601",
                    "speaker": "朱特",
                    "text": "你拿到风车菊了吗？"
                }
            ]
        },
        {
            "id": "2303211",
            "objective": "与兰巴德对话",
            "dialogues": [
                {
                    "id": "230321101",
                    "speaker": "兰巴德",
                    "text": "太好了，这些就足够了，请你稍等一下…"
                },
                {
                    "id": "230321102",
                    "speaker": "Black Screen",
                    "text": "兰巴德开始了烹饪…"
                },
                {
                    "id": "230321103",
                    "speaker": "兰巴德",
                    "text": "完成了，这份「绿汁脆球」是给你的，其余两份「绿汁脆球」你就带回去给那两个人吧。"
                }
            ]
        },
        {
            "id": "2303208",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "230321201",
                    "speaker": "维克多",
                    "text": "怎么样，兰巴德怎么说？"
                },
                {
                    "id": "230321202",
                    "speaker": "Black Screen",
                    "text": "向维克多叙述了事情的过程…"
                },
                {
                    "id": "230321203",
                    "speaker": "维克多",
                    "text": "兰巴德果然是个靠谱的老板啊，人也很好。"
                },
                {
                    "id": "230321204",
                    "speaker": "维克多",
                    "text": "不像其他人，一看见我们是愚人众，本能地就开始提防我们。",
                    "choices": [
                        {
                            "id": "230321205",
                            "text": "这怪你们自己好吗？",
                            "response": [
                                {
                                    "id": "230321207",
                                    "speaker": "维克多",
                                    "text": "哎，这道菜闻着真不错啊，弗谢沃洛德先生应该也会很喜欢的。"
                                },
                                {
                                    "id": "230321208",
                                    "speaker": "Player",
                                    "text": "你这家伙…"
                                },
                                {
                                    "id": "230321209",
                                    "speaker": "维克多",
                                    "text": "这是说好的报酬，数一数吧旅行者，好好数一数。"
                                }
                            ]
                        },
                        {
                            "id": "230321206",
                            "text": "这纯粹是愚人众的错…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303209",
            "objective": "与朱特对话",
            "dialogues": [
                {
                    "id": "230321501",
                    "speaker": "朱特",
                    "text": "风车菊会是什么气味呢…"
                },
                {
                    "id": "230321502",
                    "speaker": "Player",
                    "text": "关于维克多的委托…"
                },
                {
                    "id": "230321503",
                    "speaker": "朱特",
                    "text": "没错，我确实和他约定好了，他帮我去找各种稀奇的植物，我则帮他想办法做香包。"
                },
                {
                    "id": "230321504",
                    "speaker": "朱特",
                    "text": "你是他请来帮忙的人吧，如果拿到风车菊的话，直接给我就行了。"
                }
            ]
        },
        {
            "id": "2303217",
            "objective": "与朱特对话",
            "dialogues": [
                {
                    "id": "230321701",
                    "speaker": "朱特",
                    "text": "这就是风车菊吗？唔，确实是一种有趣的植物…"
                },
                {
                    "id": "230321702",
                    "speaker": "朱特",
                    "text": "这株风车菊我就收下了，香包的事我会继续想办法的。"
                }
            ]
        },
