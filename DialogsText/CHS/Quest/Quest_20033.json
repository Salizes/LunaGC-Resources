{
    "quest": {
        "id": "20033",
        "title": "冒险家，安娜！",
        "description": "蒙德城的安娜，似乎已经成功地成为了一位冒险家。",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 34,
        "total_speaker_counts": {
            "Player": 8,
            "安东尼": 9,
