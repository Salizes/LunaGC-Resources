        }
    },
    "talks": [
        {
            "id": "2003301",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200330101",
                    "speaker": "安娜",
                    "text": "旅行者！快看快看，我这身衣服怎么样？好不好看？"
                },
                {
                    "id": "200330102",
                    "speaker": "Player",
                    "text": "这身衣服…难道？！"
                },
                {
                    "id": "200330103",
                    "speaker": "安娜",
                    "text": "没错！我已经通过冒险家协会的考试了，正式成为一名冒险家啦！",
                    "choices": [
                        {
                            "id": "200330104",
                            "text": "很帅气！",
                            "response": [
                                {
                                    "id": "200330106",
                                    "speaker": "安娜",
                                    "text": "嘿嘿，谢谢你。我还想让哥哥也试试看呢，结果他怎么样都不肯去…"
                                },
                                {
                                    "id": "200330107",
                                    "speaker": "安东尼",
                                    "text": "我对冒险没什么兴趣…再说了，我们俩都做了冒险家，谁来照顾爸妈啊？"
                                },
                                {
                                    "id": "200330108",
                                    "speaker": "安娜",
                                    "text": "那我们就把爸妈都带上，一起去世界各地旅行啊！"
                                },
                                {
                                    "id": "200330109",
                                    "speaker": "安东尼",
                                    "text": "你啊…行了，既然当上了冒险家，那就好好干，家里的事我来打理就好。"
                                },
                                {
                                    "id": "200330110",
                                    "speaker": "安东尼",
                                    "text": "但是！一定要注意安全，不要把自己弄伤了，也不要太累…"
                                },
                                {
                                    "id": "200330111",
                                    "speaker": "安娜",
                                    "text": "知道啦知道啦！我要出去执行委托了！"
                                },
                                {
                                    "id": "200330112",
                                    "speaker": "安娜",
                                    "text": "旅行者，你要和我一起去吗？我还想请教你许多有关冒险家的问题呢。",
                                    "choices": [
                                        {
                                            "id": "200330113",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "200330115",
                                                    "speaker": "安娜",
                                                    "text": "好，我看看啊…这次的委托是…"
                                                },
                                                {
                                                    "id": "200330116",
                                                    "speaker": "安娜",
                                                    "text": "护送货运热气球！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200330114",
                                            "text": "出发吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200330105",
                            "text": "恭喜你！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003302",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200330201",
                    "speaker": "安娜",
                    "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。"
                },
                {
                    "id": "200330202",
                    "speaker": "安娜",
                    "text": "不过，冒险家平时去执行的委托，都是这种事情吗？",
                    "choices": [
                        {
                            "id": "200330203",
                            "text": "会有其他委托的。",
                            "response": [
                                {
                                    "id": "200330204",
                                    "speaker": "派蒙",
                                    "text": "你的语气也太无奈了…"
                                },
                                {
                                    "id": "200330207",
                                    "speaker": "安娜",
                                    "text": "是这样吗…好嘞！那我要继续努力了！"
                                },
                                {
                                    "id": "200330208",
                                    "speaker": "安娜",
                                    "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！"
                                },
                                {
                                    "id": "200330209",
                                    "speaker": "安娜",
                                    "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。"
                                },
                                {
                                    "id": "200330210",
                                    "speaker": "安娜",
                                    "text": "现在我的病已经好了，也成为了冒险家。"
                                },
                                {
                                    "id": "200330211",
                                    "speaker": "安娜",
                                    "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
                                }
                            ]
                        },
                        {
                            "id": "200330205",
                            "text": "你慢慢就会知道了…",
                            "response": [
                                {
                                    "id": "200330206",
                                    "speaker": "安娜",
                                    "text": "喂，你的表情不要这么疲惫啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003303",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200330301",
                    "speaker": "安东尼",
                    "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
                },
                {
                    "id": "200330302",
                    "speaker": "Player",
                    "text": "你不希望她做冒险家吗？"
                },
                {
                    "id": "200330303",
                    "speaker": "安东尼",
                    "text": "……"
                },
                {
                    "id": "200330304",
                    "speaker": "安东尼",
                    "text": "我尊重我妹妹的梦想。"
                },
                {
                    "id": "200330305",
                    "speaker": "安东尼",
                    "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
                },
                {
                    "id": "200330306",
                    "speaker": "安东尼",
                    "text": "作为她的哥哥，我…会全力支持她。"
                },
                {
                    "id": "200330307",
                    "speaker": "安东尼",
                    "text": "就这样。"
                }
            ]
        },
        {
            "id": "2003304",
            "objective": "与安娜对话",
            "dialogues": []
        }
    ]
}