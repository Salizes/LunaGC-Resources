        {
            "id": "48104",
            "objective": "(test)与派蒙对话",
            "dialogues": [
                {
                    "id": "4810401",
                    "speaker": "派蒙",
                    "text": "西风骑士团的飞行指南，听起来就很难读…"
                },
                {
                    "id": "4810402",
                    "speaker": "Player",
                    "text": "总之先读读看吧。"
                }
            ]
        },
        {
            "id": "48105",
            "objective": "(test)播片-寓言",
            "dialogues": []
        },
        {
            "id": "48106",
            "objective": "(test)派蒙的疑问",
            "dialogues": [
                {
                    "id": "4810601",
                    "speaker": "派蒙",
                    "text": "是个很好的故事呢…但是骑士团的飞行指南…是这种风格的么？",
                    "choices": [
                        {
                            "id": "4810602",
                            "text": "完全是一本寓言。",
                            "response": [
                                {
                                    "id": "4810604",
                                    "speaker": "派蒙",
                                    "text": "不管了，我们还是快去找安柏吧。"
                                }
                            ]
                        },
                        {
                            "id": "4810603",
                            "text": "蒙德人学习飞行的方式真浪漫…"
                        }
                    ]
                }
            ]
        }
    ]
