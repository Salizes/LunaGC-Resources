    "talks": [
        {
            "id": "48101",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4810101",
                    "speaker": "安柏",
                    "text": "#{NICKNAME}！找你好久了，上次给你的风之翼，用起来怎么样？",
                    "choices": [
                        {
                            "id": "4810102",
                            "text": "感觉还不错。",
                            "response": [
                                {
                                    "id": "4810104",
                                    "speaker": "安柏",
                                    "text": "看来你用风之翼玩得很开心的样子。"
                                },
                                {
                                    "id": "4810105",
                                    "speaker": "安柏",
                                    "text": "不过话说回来，你现在肯定还没有飞行执照吧。"
                                },
                                {
                                    "id": "4810106",
                                    "speaker": "派蒙",
                                    "text": "飞行执照？那是什么东西？"
                                },
                                {
                                    "id": "4810107",
                                    "speaker": "安柏",
                                    "text": "从名字看也已经很明显了吧？只有拿到飞行执照，才能在蒙德城合法飞行。"
                                },
                                {
                                    "id": "4810108",
                                    "speaker": "派蒙",
                                    "text": "#唔…{NICKNAME}都飞了这么久了，之前都没有听说这种东西…"
                                },
                                {
                                    "id": "4810109",
                                    "speaker": "安柏",
                                    "text": "就是因为你们成天在城里飞来飞去，弄得大家都注意到了！"
                                },
                                {
                                    "id": "4810110",
                                    "speaker": "派蒙",
                                    "text": "欸嘿。"
                                },
                                {
                                    "id": "4810111",
                                    "speaker": "派蒙",
                                    "text": "所以，你今天是特意来把飞行执照送来的吗？"
                                },
                                {
                                    "id": "4810112",
                                    "speaker": "安柏",
                                    "text": "怎么可能！骑士是很有原则的。"
                                },
                                {
                                    "id": "4810113",
                                    "speaker": "安柏",
                                    "text": "飞行执照先要考试合格，然后再由骑士团统一签发。"
                                },
                                {
                                    "id": "4810114",
                                    "speaker": "安柏",
                                    "text": "#我今天是专门来做你的考官，监督{NICKNAME}进行飞行执照考试的！"
                                },
                                {
                                    "id": "4810115",
                                    "speaker": "安柏",
                                    "text": "毕竟是我把风之翼给你的嘛，要负起责任来——琴团长一定会这么说吧。"
                                },
                                {
                                    "id": "4810116",
                                    "speaker": "派蒙",
                                    "text": "考试…听起来就很麻烦。但既然是安柏监考，那么…",
                                    "choices": [
                                        {
                                            "id": "4810117",
                                            "text": "能不能稍微通融…",
                                            "response": [
                                                {
                                                    "id": "4810118",
                                                    "speaker": "安柏",
                                                    "text": "别这么看着人家，绝·对·不·行。"
                                                },
                                                {
                                                    "id": "4810121",
                                                    "speaker": "安柏",
                                                    "text": "只是一点小小的测验，你击退风魔龙时的飞行能力全蒙德有目共睹，肯定没问题的。"
                                                },
                                                {
                                                    "id": "4810122",
                                                    "speaker": "安柏",
                                                    "text": "不过，规章制度和飞行标准还是需要遵守的。"
                                                },
                                                {
                                                    "id": "4810123",
                                                    "speaker": "安柏",
                                                    "text": "这本飞行指南给你，虽然不用背下来，但还是要熟悉一遍才行。"
                                                },
                                                {
                                                    "id": "4810124",
                                                    "speaker": "安柏",
                                                    "text": "比如不允许双人共用一架风之翼，不允许携带超规格重物起飞，不允许使用风史莱姆起飞什么什么的…"
                                                },
                                                {
                                                    "id": "4810125",
                                                    "speaker": "安柏",
                                                    "text": "总之，你就好好读一下吧，丽莎姐姐教我魔法的时候，也是要我先看很多厚厚的书的…"
                                                },
                                                {
                                                    "id": "4810126",
                                                    "speaker": "派蒙",
                                                    "text": "看起来好厚…没办法了，总之先读读看吧。"
                                                },
                                                {
                                                    "id": "4810127",
                                                    "speaker": "安柏",
                                                    "text": "嗯！读完以后就来风起地找我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4810119",
                                            "text": "我靠自己考就好了。",
                                            "response": [
                                                {
                                                    "id": "4810120",
                                                    "speaker": "安柏",
                                                    "text": "#{NICKNAME}肯定能顺利通过啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4810103",
                            "text": "总是不自觉飞太高。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "48102",
            "objective": "(test)阅读安柏的飞行课本（隐）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "48103",
