    "talks": [
        {
            "id": "7280201",
            "objective": "与竺子对话",
            "dialogues": [
                {
                    "id": "728020101",
                    "speaker": "竺子",
                    "text": "不知道妈妈的身体怎么样了，还有爸爸…"
                },
                {
                    "id": "728020102",
                    "speaker": "竺子",
                    "text": "咦？旅行者？你怎么来了，我记得上次你来问我前往稻妻的方法…"
                },
                {
                    "id": "728020103",
                    "speaker": "Player",
                    "text": "已经去过稻妻了。"
                },
                {
                    "id": "728020104",
                    "speaker": "竺子",
                    "text": "居、居然真的过去了，而且还能回来…"
                },
                {
                    "id": "728020105",
                    "speaker": "竺子",
                    "text": "不愧是名扬四方的勇士，各方面的本领都不是我这种普通人能企及的。"
                },
                {
                    "id": "728020106",
                    "speaker": "竺子",
                    "text": "对、对了！如果可以的话，能不能请你帮我一个忙？",
                    "choices": [
                        {
                            "id": "728020107",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "728020109",
                                    "speaker": "竺子",
                                    "text": "说起来，当初我离开稻妻的时候，是不辞而别。"
                                },
                                {
                                    "id": "728020110",
                                    "speaker": "竺子",
                                    "text": "我从小就向往稻妻之外的广阔世界，喜欢到处游历，不喜欢受父母管束。"
                                },
                                {
                                    "id": "728020111",
                                    "speaker": "竺子",
                                    "text": "眼狩令颁布后，稻妻的气氛变得越来越压抑，我这才临时起意，离开了家乡。"
                                },
                                {
                                    "id": "728020112",
                                    "speaker": "竺子",
                                    "text": "虽然来了璃月之后，我勉强找到了维生的办法，但却找不到可靠的人帮着给家里捎信报平安。"
                                },
                                {
                                    "id": "728020113",
                                    "speaker": "竺子",
                                    "text": "如果你愿意的话，我能请你帮忙把家书带给父母吗？",
                                    "choices": [
                                        {
                                            "id": "728020114",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "728020115",
                                                    "speaker": "竺子",
                                                    "text": "谢谢你！那么，送信的事就拜托你啦。"
                                                },
                                                {
                                                    "id": "728020120",
                                                    "speaker": "竺子",
                                                    "text": "对了，我的父亲叫做「曜」，我的母亲叫做「满」，至于住址，我帮你标记在地图上吧。"
                                                },
                                                {
                                                    "id": "728020121",
                                                    "speaker": "竺子",
                                                    "text": "离开家乡之后，我经历了许多，如今的我深知，想要成长为独立坚强的女性，总像以前那样依赖父母是不行的。"
                                                },
                                                {
                                                    "id": "728020122",
                                                    "speaker": "竺子",
                                                    "text": "我已经决定了，短期内不会归乡。如果在外遇到困难的话，我会靠自己勇敢面对。"
                                                },
                                                {
                                                    "id": "728020123",
                                                    "speaker": "竺子",
                                                    "text": "做到这一点的话，远方的爸爸妈妈，也会以我为傲吧。"
                                                },
                                                {
                                                    "id": "728020124",
                                                    "speaker": "竺子",
                                                    "text": "我把这份决心也写在了家书里，就麻烦你把它带回我父母身边了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728020116",
                                            "text": "你想回去看看吗？",
                                            "response": [
                                                {
                                                    "id": "728020117",
                                                    "speaker": "竺子",
                                                    "text": "虽然我惦念父母，但如今我一旦回去，恐怕就再也没办法离开了。"
                                                },
                                                {
                                                    "id": "728020118",
                                                    "speaker": "竺子",
                                                    "text": "我可没有像你这样来去自由的本事，所以无论如何我都不敢回去。"
                                                },
                                                {
                                                    "id": "728020119",
                                                    "speaker": "竺子",
                                                    "text": "只要你能帮我把这封信捎去稻妻，我就满足了，至于其他…我实在不敢奢求。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728020108",
                            "text": "有什么烦恼的事吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280202",
            "objective": "将家书交给满与曜",
            "dialogues": [
                {
                    "id": "728020201",
                    "speaker": "满",
                    "text": "明天午饭做几道菜好呢？"
                },
                {
                    "id": "728020202",
                    "speaker": "曜",
                    "text": "咱家孩子是越来越能吃了，多做点总归没错。"
                },
                {
                    "id": "728020203",
                    "speaker": "曜",
                    "text": "咦？请问您是…",
                    "choices": [
                        {
                            "id": "728020204",
                            "text": "请问这是竺子家吗？",
                            "response": [
                                {
                                    "id": "728020206",
                                    "speaker": "曜",
                                    "text": "是的，请问您有什么事吗？"
                                },
                                {
                                    "id": "728020207",
                                    "speaker": "Player",
                                    "text": "这是竺子让我带给你们的信。"
                                },
                                {
                                    "id": "728020208",
                                    "speaker": "满",
                                    "text": "信，这孩子为什么突然要写信？"
                                },
                                {
                                    "id": "728020209",
                                    "speaker": "满",
                                    "text": "还写这么长…明明都已经回家了，有什么话直接对我们说不就好了嘛。",
                                    "choices": [
                                        {
                                            "id": "728020210",
                                            "text": "…什么？",
                                            "response": [
                                                {
                                                    "id": "728020212",
                                                    "speaker": "满",
                                                    "text": "这位…旅行者，你听起来好像很意外？虽然我们家竺子确实外出游历过一阵子，但她现在已经回家了。"
                                                },
                                                {
                                                    "id": "728020213",
                                                    "speaker": "满",
                                                    "text": "既然回家了，又有什么必要请人送家书呢，你们是找错人了吧。"
                                                },
                                                {
                                                    "id": "728020214",
                                                    "speaker": "曜",
                                                    "text": "等一下，孩子她妈，我扫了一眼这封家书，这笔迹、这口吻的确是我们的女儿竺子。"
                                                },
                                                {
                                                    "id": "728020215",
                                                    "speaker": "曜",
                                                    "text": "信中也确实说到，她短期内不打算回来，让我们保重身体。"
                                                },
                                                {
                                                    "id": "728020216",
                                                    "speaker": "满",
                                                    "text": "这到底是怎么回事？不会是这孩子一边托这位旅行者带信回来，一边自己回来了吧？"
                                                },
                                                {
                                                    "id": "728020217",
                                                    "speaker": "曜",
                                                    "text": "我觉得这其中可能有点误会，等孩子回来了，我们问一问吧。"
                                                },
                                                {
                                                    "id": "728020218",
                                                    "speaker": "曜",
                                                    "text": "旅行者，不巧我家竺子今天有事外出了，等她回来我们夫妻俩会去问清楚。"
                                                },
                                                {
                                                    "id": "728020219",
                                                    "speaker": "曜",
                                                    "text": "如果你愿意的话，就明天晚上再过来找我们吧，让那孩子当面给你解释清楚。",
                                                    "choices": [
                                                        {
                                                            "id": "728020220",
                                                            "text": "现在她在哪？",
                                                            "response": [
                                                                {
                                                                    "id": "728020221",
                                                                    "speaker": "曜",
                                                                    "text": "这孩子说自己要忙工作的事，吃了饭之后就急匆匆地离开了。"
                                                                },
                                                                {
                                                                    "id": "728020224",
                                                                    "speaker": "满",
                                                                    "text": "是啊，每天都早出晚归的，只有晚上我们才能见着她，真不知道这孩子到底在忙什么。"
                                                                },
                                                                {
                                                                    "id": "728020225",
                                                                    "speaker": "曜",
                                                                    "text": "总之，请你明天晚上过来吧，要真是那孩子弄错了，一定让她给你当面道歉。"
                                                                },
                                                                {
                                                                    "id": "728020226",
                                                                    "speaker": "满",
                                                                    "text": "还麻烦你跑了这么长一段路，真是不好意思啊。"
                                                                },
                                                                {
                                                                    "id": "728020227",
                                                                    "speaker": "曜",
                                                                    "text": "竺子这孩子，真是不让人省心…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "728020222",
                                                            "text": "为什么是晚上？",
                                                            "response": [
                                                                {
                                                                    "id": "728020223",
                                                                    "speaker": "曜",
                                                                    "text": "这孩子说自己要忙工作的事，每天白天吃了饭之后都会离开。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728020211",
                                            "text": "竺子…回家了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728020205",
                            "text": "请问是竺子的父母吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280203",
            "objective": "等到第二天晚上（18点~6点）",
            "dialogues": [
                {
                    "id": "728020301",
                    "speaker": "曜",
                    "text": "女儿回家的日期…怎么比这家书上落款的日期还早？"
                },
                {
                    "id": "728020302",
                    "speaker": "满",
                    "text": "别胡思乱想了，大概只是误会，还是好好帮我想想明天午饭做什么吧。"
                }
            ]
        },
        {
            "id": "7280204",
            "objective": "等到晚上（18点~6点）",
            "dialogues": [
                {
                    "id": "728020401",
                    "speaker": "曜",
                    "text": "我们家竺子现在不在，请你等到晚上再来吧。"
                },
                {
                    "id": "728020402",
                    "speaker": "满",
                    "text": "等到了晚上，竺子应该就会回来了。"
                }
            ]
        },
        {
            "id": "7280205",
            "objective": "前往竺子家",
            "dialogues": [
                {
                    "id": "728020501",
                    "speaker": "派蒙",
                    "text": "竺子一家应该都在屋子里了，我们敲敲门吧。"
                },
                {
                    "id": "728020502",
                    "speaker": "Player",
                    "text": "他们好像在聊些什么。"
                },
                {
                    "id": "728020503",
                    "speaker": "满",
                    "text": "说起来，不知道我们之前救下的那只狸猫怎么样了。"
                },
                {
                    "id": "728020504",
                    "speaker": "曜",
                    "text": "你呀，太善良了，那只狸猫不过是腿上受了点小伤，其实把它留在草丛里，让它自己修养也能好。"
                },
                {
                    "id": "728020505",
                    "speaker": "满",
                    "text": "我舍不得嘛，它当时都看着我流眼泪了，可怜巴巴的，我怎么能不把它带回家照顾呢？"
                },
                {
                    "id": "728020506",
                    "speaker": "曜",
                    "text": "算啦，行善总是好事，就是它吃的实在有点多，快赶上我了…"
                },
                {
                    "id": "728020507",
                    "speaker": "Player",
                    "text": "敲门"
                },
                {
                    "id": "728020508",
                    "speaker": "曜",
                    "text": "是谁啊？"
                },
                {
                    "id": "728020509",
                    "speaker": "Player",
                    "text": "是之前来过的旅行者。"
                },
                {
                    "id": "728020510",
                    "speaker": "曜",
                    "text": "哦，是那位旅行者吧，稍等。"
                },
                {
                    "id": "728020511",
                    "speaker": "竺子",
                    "text": "你、你好！我是竺子，初次…不…又见面了！"
                },
                {
                    "id": "728020512",
                    "speaker": "竺子",
                    "text": "不好意思，因为实在太想家，所以我在把信交给你们之后又变了主意，坐船回了家。"
                },
                {
                    "id": "728020513",
                    "speaker": "竺子",
                    "text": "啊哈哈…之前都是误会，抱歉啦，让你跑这么一趟。"
                },
                {
                    "id": "728020514",
                    "speaker": "Player",
                    "text": "你有办法回到稻妻？"
                },
                {
                    "id": "728020515",
                    "speaker": "竺子",
                    "text": "…啊，我有自己的途径哈哈，这个你就不用管了。"
                },
                {
                    "id": "728020516",
                    "speaker": "竺子",
                    "text": "那个，报酬我已经准备好了，请收下吧，多谢你们帮忙。快点…呃，快点忙你们的事去吧。"
                },
                {
                    "id": "728020517",
                    "speaker": "派蒙",
                    "text": "竺子小姐的话怎么前后不一？要是往返稻妻有这么容易的话，当初干嘛还要拜托我们。",
                    "choices": [
                        {
                            "id": "728020518",
                            "text": "你在璃月的产业呢？",
                            "response": [
                                {
                                    "id": "728020519",
                                    "speaker": "竺子",
                                    "text": "产业？什么产业，我在璃月还有产业的吗！"
                                },
                                {
                                    "id": "728020522",
                                    "speaker": "竺子",
                                    "text": "…啊，这种东西都是身外之物，和家人相比完全不重要，我早就托付给别人啦，啊…哈哈。"
                                },
                                {
                                    "id": "728020523",
                                    "speaker": "派蒙",
                                    "text": "喂喂，真正的竺子在璃月找工作都成问题，怎么会摇身一变成有钱人？"
                                },
                                {
                                    "id": "728020524",
                                    "speaker": "Player",
                                    "text": "你到底是谁？"
                                },
                                {
                                    "id": "728020525",
                                    "speaker": "竺子",
                                    "text": "我…我当然是竺子了！长得是竺子，声音是竺子，这有什么好怀疑的呢？"
                                },
                                {
                                    "id": "728020526",
                                    "speaker": "竺子",
                                    "text": "我说你啊！真是纠缠不休…算了，我不和你说了，明天我还要工作，先走了。"
                                },
                                {
                                    "id": "728020527",
                                    "speaker": "满",
                                    "text": "欸，竺子！这孩子…怎么突然火气这么大…"
                                },
                                {
                                    "id": "728020528",
                                    "speaker": "曜",
                                    "text": "抱歉啊，旅行者，这孩子肯定是工作太累了。"
                                },
                                {
                                    "id": "728020529",
                                    "speaker": "曜",
                                    "text": "但你也看到了，这确实是我们的女儿，你带来的那封信…说不定真是这孩子忘记了。"
                                },
                                {
                                    "id": "728020530",
                                    "speaker": "曜",
                                    "text": "不过无论如何，还是谢谢你帮忙跑这一趟，报酬的话…还请你再稍等一下。",
                                    "choices": [
                                        {
                                            "id": "728020531",
                                            "text": "发生什么了吗？",
                                            "response": [
                                                {
                                                    "id": "728020533",
                                                    "speaker": "曜",
                                                    "text": "那倒没有，报酬我们还是拿得出来。"
                                                },
                                                {
                                                    "id": "728020534",
                                                    "speaker": "曜",
                                                    "text": "竺子这孩子，白天不是去工作吗？但她每天拿回来的工钱总是有点奇怪。"
                                                },
                                                {
                                                    "id": "728020535",
                                                    "speaker": "曜",
                                                    "text": "有的是一些奇怪的种子，有的是一些野果子，就是不直接拿摩拉回来。"
                                                },
                                                {
                                                    "id": "728020536",
                                                    "speaker": "曜",
                                                    "text": "虽然这些东西也值些钱，但我们还得把它们拿出去卖掉才行。"
                                                },
                                                {
                                                    "id": "728020537",
                                                    "speaker": "曜",
                                                    "text": "对你这样的旅行者来说，报酬肯定也是直接拿摩拉比较方便吧。"
                                                },
                                                {
                                                    "id": "728020538",
                                                    "speaker": "曜",
                                                    "text": "请你明天再过来一趟吧，到那时候，我会直接把摩拉给你的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728020532",
                                            "text": "如果有困难的话…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728020520",
                            "text": "你在璃月的豪宅呢？",
                            "response": [
                                {
                                    "id": "728020521",
                                    "speaker": "竺子",
                                    "text": "豪宅？什么豪宅，我在璃月还有豪宅的吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280206",
            "objective": "等到第二天",
            "dialogues": [
                {
                    "id": "728020601",
                    "speaker": "满",
                    "text": "女儿又跑哪儿去了…",
                    "choices": [
                        {
                            "id": "728020602",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "728020604",
                                    "speaker": "满",
                                    "text": "就算是工作，她走之前也会给我们说一声，但今天这孩子怎么不声不响地就走了。"
                                },
                                {
                                    "id": "728020605",
                                    "speaker": "满",
                                    "text": "昨天晚上你离开之后，竺子说觉得很累，直接就回房睡下了。"
                                },
                                {
                                    "id": "728020606",
                                    "speaker": "满",
                                    "text": "等到天亮之后，我们夫妻俩起床一看，她就已经不在自己的床上了。"
                                },
                                {
                                    "id": "728020607",
                                    "speaker": "满",
                                    "text": "我们到处找也没有找到女儿，我丈夫就直接到更远的地方去找了。"
                                },
                                {
                                    "id": "728020608",
                                    "speaker": "曜",
                                    "text": "但我在这一带找了半天，完全没找见女儿的踪迹。"
                                },
                                {
                                    "id": "728020609",
                                    "speaker": "满",
                                    "text": "啊，这孩子不会又出去旅行了吧？真是叫人怎么办才好…"
                                },
                                {
                                    "id": "728020610",
                                    "speaker": "曜",
                                    "text": "孩子他妈，别着急，我待会儿再去找找，你先在家把竺子的房间扫一扫吧。"
                                },
                                {
                                    "id": "728020611",
                                    "speaker": "曜",
                                    "text": "那孩子走的时候也不关好窗户，搞得房间里被吹进了一大堆树叶。"
                                },
                                {
                                    "id": "728020612",
                                    "speaker": "曜",
                                    "text": "对了，旅行者，这些是说好的报酬，请你拿好了。"
                                },
                                {
                                    "id": "728020613",
                                    "speaker": "满",
                                    "text": "唉，竺子这孩子到底又去做什么了…"
                                }
                            ]
                        },
                        {
                            "id": "728020603",
                            "text": "竺子又工作去了吗？"
                        }
                    ]
                }
            ]
