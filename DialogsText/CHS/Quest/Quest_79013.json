    "talks": [
        {
            "id": "7901301",
            "objective": "(test)阅读笔记$HIDDEN",
            "dialogues": [
                {
                    "id": "790130101",
                    "speaker": "陈旧的笔记",
                    "text": "（test)翻开了一本笔记"
                }
            ]
        },
        {
            "id": "7901302",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790130201",
                    "speaker": "派蒙",
                    "text": "嗯，甜甜花酿鸡真的很好吃。"
                },
                {
                    "id": "790130202",
                    "speaker": "派蒙",
                    "text": "确实能理解为什么这个叫「沃尔夫冈」的冒险家会念念不忘呢！"
                },
                {
                    "id": "790130203",
                    "speaker": "派蒙",
                    "text": "不过被关在这里，最后连甜甜花酿鸡都吃不到，真是可怜…",
                    "choices": [
                        {
                            "id": "790130204",
                            "text": "这本笔记很旧了…",
                            "response": [
                                {
                                    "id": "790130206",
                                    "speaker": "派蒙",
                                    "text": "#是哦…但是这么说来…{NICKNAME}，还记得我们从岛上的水池那样的东西进入另一边的岛吗…"
                                },
                                {
                                    "id": "790130217",
                                    "speaker": "派蒙",
                                    "text": "水池里岛上的建筑比起水池外的岛，看上去要完整很多。"
                                },
                                {
                                    "id": "790130218",
                                    "speaker": "派蒙",
                                    "text": "现在岛上的建筑跟那里的建筑比起来，就像遗迹一样…",
                                    "choices": [
                                        {
                                            "id": "790130219",
                                            "text": "会不会水池里的建筑…",
                                            "response": [
                                                {
                                                    "id": "790130221",
                                                    "speaker": "派蒙",
                                                    "text": "很有可能！说不定水池里岛上的建筑，就是水池外岛上遗迹很久以前的样子！"
                                                },
                                                {
                                                    "id": "790130222",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你说会不会…"
                                                },
                                                {
                                                    "id": "790130223",
                                                    "speaker": "Player",
                                                    "text": "水池里的岛，是以前的岛？"
                                                },
                                                {
                                                    "id": "790130224",
                                                    "speaker": "派蒙",
                                                    "text": "对！"
                                                },
                                                {
                                                    "id": "790130207",
                                                    "speaker": "派蒙",
                                                    "text": "而且，你看…我们要是找到了以前的这个密室在哪，不就能够救到这个冒险家了吗！",
                                                    "choices": [
                                                        {
                                                            "id": "790130208",
                                                            "text": "只是发生在幻境的影响里…",
                                                            "response": [
                                                                {
                                                                    "id": "790130210",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是…就算一切都是假的，这个冒险家说不定也不存在，但看到他说的那么可怜，也是想帮一下的嘛…"
                                                                },
                                                                {
                                                                    "id": "790130211",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "790130212",
                                                                            "text": "确实，派蒙说得对。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "790130213",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#嗯！我就知道{NICKNAME}也会这样觉得的！"
                                                                                },
                                                                                {
                                                                                    "id": "790130216",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们这就去水池里的岛那儿看看吧！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "790130214",
                                                                            "text": "那就去看看…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "790130215",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，要是能帮到这个叫「沃尔夫冈」的冒险家就好了！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "790130209",
                                                            "text": "是改变不了现实的…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790130220",
                                            "text": "水池里的建筑就是原本的样子…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790130205",
                            "text": "应该是很久之前的事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901303",
            "objective": "前往水池中的岛查看过去的遗迹",
            "dialogues": []
        },
        {
            "id": "7901304",
            "objective": "前往水池中的岛查看过去的遗迹",
            "dialogues": []
        },
        {
            "id": "7901305",
            "objective": "前往水池中岛上的笔记遗留之处",
            "dialogues": []
        },
        {
            "id": "7901306",
            "objective": "找到打开密室的办法",
            "dialogues": [
                {
                    "id": "790130601",
                    "speaker": "派蒙",
                    "text": "嗯！就在这里留言吧，这下他应该能看得见了！"
                },
                {
                    "id": "790130602",
                    "speaker": "派蒙",
                    "text": "我们现在回到水池外的岛上吧…说不定就没有那本笔记了！"
                }
            ]
        },
        {
            "id": "7901329",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790131101",
                    "speaker": "派蒙",
                    "text": "门打开了！真是有点麻烦的机关…"
                },
                {
                    "id": "790131102",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，这里好像还没有沃尔夫冈的笔记…"
                },
                {
                    "id": "790131103",
                    "speaker": "Player",
                    "text": "说明他还没来过…"
                },
                {
                    "id": "790131104",
                    "speaker": "派蒙",
                    "text": "那我们就算提前帮他解开密室了…这下他就不会被关起来了吧！",
                    "choices": [
                        {
                            "id": "790131105",
                            "text": "若是反复触发的机关…",
                            "response": [
                                {
                                    "id": "790131107",
                                    "speaker": "派蒙",
                                    "text": "那怎么办呀…唔，不如我们给他留言！"
                                },
                                {
                                    "id": "790131108",
                                    "speaker": "派蒙",
                                    "text": "我们用刻痕，把留言留在比较显眼的地方，告诉他解开机关的方法吧！"
                                }
                            ]
                        },
                        {
                            "id": "790131106",
                            "text": "就算这次解开了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901307",
            "objective": "为沃尔夫冈留下提示的刻痕",
            "dialogues": []
        },
        {
            "id": "7901308",
            "objective": "返回水池之外查看沃尔夫冈的笔记",
            "dialogues": [
                {
