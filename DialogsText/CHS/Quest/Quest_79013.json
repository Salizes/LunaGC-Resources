                }
            ]
        },
        {
            "id": "7901309",
            "objective": "返回水池之外查看沃尔夫冈的笔记",
            "dialogues": [
                {
                    "id": "790130901",
                    "speaker": "陈旧的笔记",
                    "text": "（test)找到一本笔记"
                }
            ]
        },
        {
            "id": "7901310",
            "objective": "前去查看沃尔夫冈的笔记",
            "dialogues": []
        },
        {
            "id": "7901323",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790132401",
                    "speaker": "派蒙",
                    "text": "他居然真的从那个密室里逃出来了诶！居然还夸自己细心…留言的刻痕明明就是我们特意留在显眼处的！"
                },
                {
                    "id": "790132410",
                    "speaker": "派蒙",
                    "text": "还有，这个人到底随身带着多少本笔记本啊…"
                },
                {
                    "id": "790132402",
                    "speaker": "派蒙",
                    "text": "唉…没想到他被关密室，居然没有回去，还敢继续冒险…",
                    "choices": [
                        {
                            "id": "790132403",
                            "text": "因为他解决了危机…",
                            "response": [
                                {
                                    "id": "790132405",
                                    "speaker": "派蒙",
                                    "text": "是哦，原本将他一直困着的密室，现在就变成了他轻易克服的困难之一啦…"
                                },
                                {
                                    "id": "790132406",
                                    "speaker": "派蒙",
                                    "text": "不过，他说的山上的遗迹，在水池外的岛上就看不见了。"
                                },
                                {
                                    "id": "790132407",
                                    "speaker": "Player",
                                    "text": "毕竟过了很久嘛…"
                                },
                                {
                                    "id": "790132408",
                                    "speaker": "派蒙",
                                    "text": "不会是崩塌了，然后落到海里去了吧…总觉得好像在外面的海面上看到过类似的建筑…"
                                },
                                {
                                    "id": "790132409",
                                    "speaker": "派蒙",
                                    "text": "我们有空的时候就到附近的海上看看吧！"
                                }
                            ]
                        },
                        {
                            "id": "790132404",
                            "text": "因为他逃脱了密室…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901311",
            "objective": "前往海面遗迹寻找沃尔夫冈的踪迹",
            "dialogues": []
        },
        {
            "id": "7901324",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790132501",
                    "speaker": "派蒙",
                    "text": "这个笔记…啊，是「沃尔夫冈」。",
                    "choices": [
                        {
                            "id": "790132502",
                            "text": "又困在密室里了…",
                            "response": [
                                {
                                    "id": "790132504",
                                    "speaker": "派蒙",
                                    "text": "只有吃到苦头的人才能吸取到教训呢…"
                                },
                                {
                                    "id": "790132505",
                                    "speaker": "派蒙",
                                    "text": "#这个海底的建筑…应该就是水池那一边岛上，山上的遗迹…{NICKNAME}，我们去水池里的岛上看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "790132503",
                            "text": "没有吸取到教训呢…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901312",
            "objective": "前往水池中岛上的笔记遗留之处",
            "dialogues": [
                {
                    "id": "790131201",
                    "speaker": "派蒙",
                    "text": "留在这里应该够显眼了吧！"
                },
                {
                    "id": "790131202",
                    "speaker": "派蒙",
                    "text": "希望沃尔夫冈能够看到，不要再跑到这个遗迹的密室里来了…"
                },
                {
                    "id": "790131203",
                    "speaker": "派蒙",
                    "text": "我们回去看看吧，说不定这次笔记也会有变化啦。"
                }
            ]
        },
        {
            "id": "7901313",
            "objective": "前往水池中岛上的笔记遗留之处",
            "dialogues": []
        },
        {
            "id": "7901314",
            "objective": "找到从密室逃脱的办法",
            "dialogues": [
                {
                    "id": "790131401",
                    "speaker": "陈旧的笔记",
                    "text": "（test）查看笔记"
                }
            ]
        },
        {
            "id": "7901330",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790133501",
                    "speaker": "派蒙",
                    "text": "这次也是一样，沃尔夫冈还没留下笔记，他还没有到这里来。"
                },
                {
                    "id": "790133502",
                    "speaker": "派蒙",
                    "text": "我们这次也留下如何解开密室的提示吧！",
                    "choices": [
                        {
                            "id": "790133503",
                            "text": "这次解开密室的方法…",
                            "response": [
                                {
                                    "id": "790133505",
                                    "speaker": "派蒙",
                                    "text": "对啊，如果沃尔夫冈没法使用元素力量的话…"
                                },
                                {
                                    "id": "790133506",
                                    "speaker": "派蒙",
                                    "text": "就算知道解法也没有用。那该怎么办呀…",
                                    "choices": [
                                        {
                                            "id": "790133507",
                                            "text": "只要不让他进来…",
                                            "response": [
                                                {
                                                    "id": "790133509",
                                                    "speaker": "派蒙",
                                                    "text": "哦！原来如此，只要在门外给提示，说这里有密室！"
                                                },
                                                {
                                                    "id": "790133510",
                                                    "speaker": "派蒙",
                                                    "text": "他就不会进来，也不会被困在遗迹里了！"
                                                },
                                                {
                                                    "id": "790133511",
                                                    "speaker": "派蒙",
                                                    "text": "我们快点给他留言吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790133508",
                                            "text": "在门外留言吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790133504",
                            "text": "如果不使用元素力量…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901315",
            "objective": "选择合适地点留下提示刻痕",
            "dialogues": []
        },
        {
            "id": "7901316",
            "objective": "返回水池之外查看沃尔夫冈的笔记",
            "dialogues": [
                {
                    "id": "790131601",
                    "speaker": "派蒙",
                    "text": "什么呀，这家伙只顾着说一些帅气的话…"
                },
                {
                    "id": "790131602",
                    "speaker": "派蒙",
                    "text": "不行，我们得去雪山…",
                    "choices": [
                        {
                            "id": "790131603",
                            "text": "幻境中的改变，改变不了过去…",
                            "response": [
                                {
                                    "id": "790131605",
                                    "speaker": "派蒙",
                                    "text": "…啊…对哦，金苹果群岛整个都被那个装置影响，沃尔夫冈才…"
                                },
                                {
                                    "id": "790131606",
                                    "speaker": "派蒙",
                                    "text": "所以我才以为沃尔夫冈已经被救出密室了…其实到最后，他都在最初的密室里没有出来吧…"
                                },
                                {
                                    "id": "790131607",
                                    "speaker": "派蒙",
                                    "text": "不过！不过这个「沃尔夫冈」还是让人生气…我们都那么帮助他了，他还觉得「帮别人踩坑」就不错…"
                                },
                                {
                                    "id": "790131608",
                                    "speaker": "派蒙",
                                    "text": "他就不能，更珍惜自己的生命一点吗？",
                                    "choices": [
                                        {
                                            "id": "790131609",
                                            "text": "每个人都有追求之物…",
                                            "response": [
                                                {
                                                    "id": "790131611",
                                                    "speaker": "派蒙",
                                                    "text": "我明白啦，我知道…"
                                                },
                                                {
                                                    "id": "790131612",
                                                    "speaker": "派蒙",
                                                    "text": "但是我还是觉得他们应该有更好的结局嘛，比如回到蒙德，成为大冒险家…然后还能去餐馆逗猫，尽情地吃甜甜花酿鸡…"
                                                },
                                                {
                                                    "id": "790131613",
                                                    "speaker": "派蒙",
                                                    "text": "为什么他们就不能有个好结局呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790131610",
                                            "text": "正是因为有他们…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790131604",
                            "text": "「沃尔夫冈」是到不了雪山的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901317",
            "objective": "前去查看沃尔夫冈的笔记",
            "dialogues": []
        },
        {
            "id": "7901325",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790132601",
                    "speaker": "派蒙",
                    "text": "好歹他没有再进去啦，真是松了口气…"
                },
                {
                    "id": "790132602",
                    "speaker": "派蒙",
                    "text": "但是不知道为什么看他洋洋得意的样子，总觉得有点生气呢！"
                },
                {
                    "id": "790132603",
                    "speaker": "Player",
                    "text": "总觉得更得意了一点…"
                },
                {
                    "id": "790132604",
                    "speaker": "派蒙",
                    "text": "不过他说高处的遗迹，应该就在上次掉落在海里的遗迹旁边…"
                },
                {
                    "id": "790132605",
                    "speaker": "派蒙",
                    "text": "我们去看看吧…真不知道他能不能安全爬到那么高的地方…"
                }
            ]
        },
        {
            "id": "7901318",
            "objective": "前往已沉于海中的高处遗迹",
            "dialogues": [
                {
                    "id": "790131801",
                    "speaker": "刻痕",
                    "text": "（老旧的刻痕，留下刻痕的人写着…）"
                },
                {
                    "id": "790131802",
                    "speaker": "刻痕",
                    "text": "「风很大，就不用笔记本了。」"
                },
                {
                    "id": "790131803",
                    "speaker": "刻痕",
                    "text": "「这里日出很美，历经艰险来到此处，心中十分满足。」"
                },
                {
                    "id": "790131804",
                    "speaker": "刻痕",
                    "text": "「不知在我之后，是否有人能来这儿看到同样的景色呢。」"
                },
                {
                    "id": "790131805",
                    "speaker": "刻痕",
                    "text": "「…如此险境我也来过了，下次，就去龙脊雪山吧！」"
                },
                {
                    "id": "790131806",
                    "speaker": "刻痕",
                    "text": "「此处甚好，可惜没有甜甜花酿鸡…」"
                },
                {
                    "id": "790131807",
                    "speaker": "刻痕",
                    "text": "「沃尔夫冈留。」"
                }
            ]
        },
        {
            "id": "7901327",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790131901",
                    "speaker": "派蒙",
                    "text": "就说怎么没有笔记本，原来是把留言刻在柱子上…这家伙成功到这儿啦。"
                },
                {
                    "id": "790131902",
                    "speaker": "派蒙",
                    "text": "不过，他到底哪来的信心…要是没有我们帮他，他早就困在遗迹的密室里了。"
                },
                {
                    "id": "790131903",
                    "speaker": "派蒙",
                    "text": "他去雪山，一定会被冻成「冷鲜肉」的！",
                    "choices": [
                        {
                            "id": "790131904",
                            "text": "「冷鲜肉」有点过分了…",
                            "response": [
                                {
                                    "id": "790131905",
                                    "speaker": "派蒙",
                                    "text": "我、我是说，他去雪山，肯定会遭遇危险的啦。"
                                },
                                {
                                    "id": "790131908",
                                    "speaker": "派蒙",
                                    "text": "我们得告诉他，不能去雪山呀！"
                                },
                                {
                                    "id": "790131909",
                                    "speaker": "Player",
                                    "text": "那就再给他留一次言吧…"
                                },
                                {
                                    "id": "790131910",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，我也是这么想的…对了，这一次，再准备一份甜甜花酿鸡！"
                                },
                                {
                                    "id": "790131911",
                                    "speaker": "派蒙",
                                    "text": "说不定他吃了甜甜花酿鸡，就会想起蒙德的温暖，不会去雪山了！"
                                },
                                {
                                    "id": "790131912",
                                    "speaker": "Player",
                                    "text": "甜甜花酿鸡会坏掉的吧…"
                                },
                                {
                                    "id": "790131913",
                                    "speaker": "派蒙",
                                    "text": "嗯…只是一份心意啦！"
                                }
                            ]
                        },
                        {
                            "id": "790131906",
                            "text": "肯定会遇到危险吧…",
                            "response": [
                                {
                                    "id": "790131907",
                                    "speaker": "派蒙",
                                    "text": "对啊，雪山上那么冷，还有那么多丘丘人，还有…大雪猪王！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7901328",
            "objective": "前往水池中的岛上的高处遗迹",
            "dialogues": []
        },
        {
            "id": "7901319",
            "objective": "留下提示刻痕与甜甜花酿鸡",
            "dialogues": []
        },
        {
            "id": "7901331",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790132701",
                    "speaker": "派蒙",
                    "text": "希望沃尔夫冈能够打消去雪山的念头…"
                },
                {
                    "id": "790132702",
                    "speaker": "派蒙",
                    "text": "我们通过水池出去以后，就去刚才的遗迹看看吧…说不定就能读到他回心转意的刻痕了！"
                }
            ]
        },
        {
            "id": "7901321",
            "objective": "返回水池之外查看沃尔夫冈的刻痕",
            "dialogues": [
                {
                    "id": "790132101",
                    "speaker": "派蒙",
                    "text": "留在这里真的有用吗…不如再找找，应该在门口附近留言才对。"
                }
            ]
        },
        {
            "id": "7901322",
            "objective": "前去查看沃尔夫冈留下的刻痕",
            "dialogues": [
                {
                    "id": "790132901",
                    "speaker": "老旧的刻痕",
                    "text": "（老旧的刻痕，留下刻痕的人写着…）"
                },
                {
                    "id": "790132902",
                    "speaker": "老旧的刻痕",
                    "text": "「风很大，就不用笔记本了。」"
                },
                {
                    "id": "790132910",
                    "speaker": "刻痕",
                    "text": "「上来发现尚有余温的甜甜花酿鸡，简直就是奇迹！」"
                },
                {
                    "id": "790132903",
                    "speaker": "老旧的刻痕",
                    "text": "「先不提谁留的，竟然知道我想吃甜甜花酿鸡，虽觉得奇怪，但更多的仍是感谢之情。」"
                },
                {
                    "id": "790132904",
                    "speaker": "老旧的刻痕",
                    "text": "「感谢留下刻痕的人，你的甜甜花酿鸡是我吃过的最好吃的甜甜花酿鸡。」"
                },
                {
                    "id": "790132905",
                    "speaker": "老旧的刻痕",
                    "text": "「谢谢，我知道雪山危险，也有自知之明…但我还是想去雪山。」"
                },
                {
                    "id": "790132906",
                    "speaker": "老旧的刻痕",
                    "text": "「我去雪山，耗尽生命，也许只能留下『此处有陷阱』的提示。」"
                },
                {
                    "id": "790132907",
                    "speaker": "老旧的刻痕",
                    "text": "「可是若有人因此绕过危险，较之我所达到之处，再向前一步。于我而言，就是比吃甜甜花酿鸡还幸福之事了。」"
                },
                {
                    "id": "790132908",
                    "speaker": "老旧的刻痕",
                    "text": "「谢谢你，留下刻痕之人，正是因为雪山危险，所以才有冒险家嘛。」"
                },
                {
                    "id": "790132909",
                    "speaker": "老旧的刻痕",
                    "text": "「爱你的，沃尔夫冈留。」"
                }
            ]
        },
        {
            "id": "7901326",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "7901320",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790132001",
                    "speaker": "派蒙",
                    "text": "看到这条留言的时候，他已经到密室里了吧…留言不就没有作用了嘛…"
                }
            ]
        },
        {
            "id": "7901346",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790134601",
                    "speaker": "派蒙",
                    "text": "就在这里留言，然后在这里留下一份甜甜花酿鸡！"
                }
            ]
        }
    ]
}