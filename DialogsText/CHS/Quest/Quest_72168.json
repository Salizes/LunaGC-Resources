    "talks": [
        {
            "id": "7216801",
            "objective": "（test）接取料理王一阶段$HIDDEN",
            "dialogues": [
                {
                    "id": "721680101",
                    "speaker": "旭东",
                    "text": "芭尔瓦涅，这周围真的有那种枝条吗…"
                },
                {
                    "id": "721680102",
                    "speaker": "芭尔瓦涅",
                    "text": "应、应该有的，书上确实是这么记载的…"
                },
                {
                    "id": "721680103",
                    "speaker": "朱莉",
                    "text": "呜…肚子饿了…"
                },
                {
                    "id": "721680104",
                    "speaker": "旭东",
                    "text": "喂，芭尔瓦涅，快点再从你的字典里找点其他的办法出来啊。"
                },
                {
                    "id": "721680105",
                    "speaker": "芭尔瓦涅",
                    "text": "你当我是万能的吗！？还有，这不是字典，这是教令院的游记简编！"
                },
                {
                    "id": "721680106",
                    "speaker": "旭东",
                    "text": "哎呀，总之你快点再想想办法啦，再这么下去，我们又要接着吃烤鱼了。"
                },
                {
                    "id": "721680107",
                    "speaker": "芭尔瓦涅",
                    "text": "烤、烤鱼…我们干脆回去城里，找个冒险家帮帮忙，或者挂个委托好了。"
                },
                {
                    "id": "721680108",
                    "speaker": "芭尔瓦涅",
                    "text": "之前在璃月的时候，你遇见问题不都这么做吗？"
                },
                {
                    "id": "721680109",
                    "speaker": "旭东",
                    "text": "那是在璃月嘛…现在可是稻妻，人生地不熟的…"
                },
                {
                    "id": "721680110",
                    "speaker": "Player",
                    "text": "你们在做什么？"
                },
                {
                    "id": "721680111",
                    "speaker": "旭东",
                    "text": "你是…冒险家？旅行者？或者两者皆是…"
                },
                {
                    "id": "721680112",
                    "speaker": "旭东",
                    "text": "算了，不管这些了，能在这里遇见就是缘分。"
                },
                {
                    "id": "721680113",
                    "speaker": "旭东",
                    "text": "我们是「全能美食队」，为了精进厨艺，正在世界各地旅行。"
                },
                {
                    "id": "721680114",
                    "speaker": "芭尔瓦涅",
                    "text": "拜托你，不要这么大声地说出这个名字…"
                },
                {
                    "id": "721680115",
                    "speaker": "旭东",
                    "text": "哈哈哈，别在意啦。话说回来，旅行者，你不会也是想要进去拿那些「绯樱绣球」吧？"
                },
                {
                    "id": "721680116",
                    "speaker": "旭东",
                    "text": "如果是的话，那你可能要失望了，这个地方被这个鬼东西挡住了，怎么也进不去。",
                    "choices": [
                        {
                            "id": "721680117",
                            "text": "我只是路过。",
                            "response": [
                                {
                                    "id": "721680118",
                                    "speaker": "旭东",
                                    "text": "这样吗？好吧…不过，如果你有兴趣的话，倒是也可以琢磨琢磨这个「屏障」。"
                                },
                                {
                                    "id": "721680119",
                                    "speaker": "旭东",
                                    "text": "芭尔瓦涅从她的那本书里找到过一种方法。"
                                },
                                {
                                    "id": "721680120",
                                    "speaker": "旭东",
                                    "text": "说是，要先触摸一种「雷樱枝条」，然后才能顺利通过这种屏障。"
                                },
                                {
                                    "id": "721680121",
                                    "speaker": "旭东",
                                    "text": "但是那种「雷樱枝条」…哈哈哈…我们都不知道具体长什么样…"
                                },
                                {
                                    "id": "721680122",
                                    "speaker": "旭东",
                                    "text": "总之，现在情况就是这样，我们也正在琢磨进去的方法呢。"
                                },
                                {
                                    "id": "721680123",
                                    "speaker": "Player",
                                    "text": "你们为什么要进去？"
                                },
                                {
                                    "id": "721680124",
                                    "speaker": "旭东",
                                    "text": "当然是为了拿里面的那些「绯樱绣球」啦。"
                                },
                                {
                                    "id": "721680125",
                                    "speaker": "旭东",
                                    "text": "我听说，这附近的「绯樱绣球」口感最好，也最适合做菜了。"
                                },
                                {
                                    "id": "721680126",
                                    "speaker": "旭东",
                                    "text": "唉，我们接着在这琢磨吧。旅行者，如果你找到了什么头绪的话，就请快点来告诉我们吧。"
                                },
                                {
                                    "id": "721680127",
                                    "speaker": "芭尔瓦涅",
                                    "text": "…旭东先生。我请问你，这是拜托人的口气吗？"
                                },
                                {
                                    "id": "721680128",
                                    "speaker": "旭东",
                                    "text": "啊？咳…咳！对，旅行者，要是你能帮忙把里面的「绯樱绣球」带出来的话…"
                                },
                                {
                                    "id": "721680129",
                                    "speaker": "朱莉",
                                    "text": "要是这样的话，除了报酬之外，旭东还会做很好吃的菜给你！"
                                },
                                {
                                    "id": "721680130",
                                    "speaker": "旭东",
                                    "text": "朱莉啊，你对这种事还真是熟练…"
                                },
                                {
                                    "id": "721680131",
                                    "speaker": "旭东",
                                    "text": "咳，但总之就是这样，旅行者，如果你愿意的话，就帮帮我们吧。"
                                }
                            ]
                        },
                        {
                            "id": "721680132",
                            "text": "你刚才说的方法…",
                            "response": [
                                {
                                    "id": "721680133",
                                    "speaker": "旭东",
                                    "text": "咦？你是真的想进去吗？"
                                },
                                {
                                    "id": "721680134",
                                    "speaker": "旭东",
                                    "text": "那个方法是芭尔瓦涅从她的那本字典里…"
                                },
                                {
                                    "id": "721680135",
                                    "speaker": "芭尔瓦涅",
                                    "text": "我都说了！这不是什么字典，是教令院的游记简编！"
                                },
                                {
                                    "id": "721680136",
                                    "speaker": "旭东",
                                    "text": "呃，不管是什么，总之她之前找到了一个方法。"
                                },
                                {
                                    "id": "721680137",
                                    "speaker": "旭东",
                                    "text": "说是，要先触摸一种「雷樱枝条」，然后才能顺利通过这种屏障。"
                                },
                                {
                                    "id": "721680138",
                                    "speaker": "旭东",
                                    "text": "但是那种「雷樱枝条」…哈哈哈…我们都不知道具体长什么样…"
                                },
                                {
                                    "id": "721680139",
                                    "speaker": "芭尔瓦涅",
                                    "text": "唉，我手上的这本书里也没有附图。"
                                },
                                {
                                    "id": "721680140",
                                    "speaker": "旭东",
                                    "text": "我可不想再吃烤鱼了，要是能拿到里面的「绯樱绣球」，我肯定能做出一道好菜…"
                                },
                                {
                                    "id": "721680141",
                                    "speaker": "旭东",
                                    "text": "我听说这附近的「绯樱绣球」口感最好，也最适合做菜了，怎么就有这么个鬼屏障挡着呢…"
                                },
                                {
                                    "id": "721680142",
                                    "speaker": "旭东",
                                    "text": "唉，我接着在这琢磨吧，旅行者，如果你找到了什么头绪的话，就请快点来告诉我们吧。"
                                },
                                {
                                    "id": "721680143",
                                    "speaker": "芭尔瓦涅",
                                    "text": "…旭东先生。我请问你，这是拜托人的口气吗？"
                                },
                                {
                                    "id": "721680144",
                                    "speaker": "旭东",
                                    "text": "啊？咳…咳！对，旅行者，要是你能帮忙把里面的「绯樱绣球」带出来的话…"
                                },
                                {
                                    "id": "721680145",
                                    "speaker": "朱莉",
                                    "text": "要是这样的话，除了报酬之外，旭东还会做很好吃的菜给你！"
                                },
                                {
                                    "id": "721680146",
                                    "speaker": "旭东",
                                    "text": "朱莉啊，你对这种事还真是熟练…"
                                },
                                {
                                    "id": "721680147",
                                    "speaker": "旭东",
                                    "text": "咳，但总之就是这样，旅行者，如果你愿意的话，就帮帮我们吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7216802",
            "objective": "取得「特殊的绯樱绣球」",
            "dialogues": [
                {
                    "id": "721680201",
                    "speaker": "旭东",
                    "text": "芭尔瓦涅，真的没有别的方法了吗？"
                },
                {
                    "id": "721680202",
                    "speaker": "芭尔瓦涅",
                    "text": "我手上的这本书里就只记载了那一种方法。"
                },
                {
                    "id": "721680203",
                    "speaker": "朱莉",
                    "text": "呜…如果只是有魔物拦路的话…"
                },
                {
                    "id": "721680204",
                    "speaker": "Player",
                    "text": "这是你们要的「绯樱绣球」吗？"
                },
                {
                    "id": "721680205",
                    "speaker": "旭东",
                    "text": "喔！没错，这就是我们要的那种「绯樱绣球」，这种色泽…"
                },
                {
                    "id": "721680206",
                    "speaker": "朱莉",
                    "text": "太好啦！终于可以做好吃的啦！"
                },
                {
                    "id": "721680207",
                    "speaker": "芭尔瓦涅",
                    "text": "等一下，你已经进去那个屏障里面了？用的是我们告诉你的那种方法吗？"
                },
                {
                    "id": "721680208",
                    "speaker": "Player",
                    "text": "是的。"
                },
                {
                    "id": "721680209",
                    "speaker": "芭尔瓦涅",
                    "text": "能告诉我你找到的那个「雷樱枝条」在哪吗？"
                },
                {
                    "id": "721680210",
                    "speaker": "芭尔瓦涅",
                    "text": "你触摸了「雷樱枝条」之后，那个「雷种子」是怎么附着在你身上的？"
                },
                {
                    "id": "721680211",
                    "speaker": "芭尔瓦涅",
                    "text": "抱歉，我先把笔记本拿出来…好了，你被「雷种子」附着之后，有什么感觉吗？还有…"
                },
                {
                    "id": "721680212",
                    "speaker": "旭东",
                    "text": "芭尔瓦涅，你先稍等一下，这位旅行者刚帮了我们的忙，你这个研究先缓缓吧。"
                },
                {
                    "id": "721680213",
                    "speaker": "旭东",
                    "text": "旅行者，多谢你帮忙，之前说好的报酬不会少你的。"
                },
                {
                    "id": "721680214",
                    "speaker": "旭东",
                    "text": "但在那之前，请你再稍等一下吧。有了你拿来的「绯樱绣球」，我也可以开始做菜了。"
                },
                {
                    "id": "721680215",
                    "speaker": "旭东",
                    "text": "我之前就听说，稻妻有一种很有特色的菜叫「绯樱天妇罗」，现在总算有机会试试看制作了…"
                },
                {
                    "id": "721680216",
                    "speaker": "旭东",
                    "text": "我先准备一下，应该很快就能做好了，你等一下再来找我吧。"
                }
            ]
        },
        {
            "id": "7216803",
            "objective": "将「特殊的绯樱绣球」交给旭东",
            "dialogues": []
        },
        {
            "id": "7216804",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "721680301",
                    "speaker": "旭东",
                    "text": "这样…再这样…"
                },
                {
                    "id": "721680302",
                    "speaker": "Player",
                    "text": "你做好了吗？"
                },
                {
                    "id": "721680303",
                    "speaker": "旭东",
                    "text": "还差最后一点…我得先把这个给裹上面衣，然后放进去炸…"
                },
                {
                    "id": "721680304",
                    "speaker": "旭东",
                    "text": "完成了！「绯樱天妇罗」，赶紧尝尝看吧。"
                },
                {
                    "id": "721680305",
                    "speaker": "朱莉",
                    "text": "好、好吃，就是有点…有点烫…呼呼呼…"
                },
                {
                    "id": "721680306",
                    "speaker": "芭尔瓦涅",
                    "text": "旭东，书上说这种叫做「天妇罗」的东西，应该还要搭配蘸汁来着…"
                },
                {
                    "id": "721680307",
                    "speaker": "旭东",
                    "text": "蘸汁？这我倒是真没准备，下次有机会我再研究看看。"
                },
                {
                    "id": "721680308",
                    "speaker": "旭东",
                    "text": "这份「绯樱天妇罗」是给你的，收下吧旅行者，谢谢你帮我们这个忙。"
                },
                {
                    "id": "721680309",
                    "speaker": "旭东",
                    "text": "还有这个「绯樱天妇罗」的制作方法，我也给你抄了一份，你就拿上吧。"
                },
                {
                    "id": "721680310",
                    "speaker": "旭东",
                    "text": "以后有机会，你也自己试试制作一下吧，做菜这件事，还是挺有趣的。",
                    "choices": [
                        {
                            "id": "721680311",
                            "text": "谢谢。",
                            "response": [
                                {
                                    "id": "721680312",
                                    "speaker": "旭东",
                                    "text": "别客气，别客气。"
                                },
                                {
                                    "id": "721680314",
                                    "speaker": "旭东",
                                    "text": "我们还会待在稻妻一段时间，过段时间，说不定会去<color=#00E1FFFF>神无冢</color>附近转转。"
                                },
                                {
                                    "id": "721680316",
                                    "speaker": "旭东",
                                    "text": "而且朱莉说，她还想要去看看那棵在「鸣神大社」里的神樱树。"
                                },
                                {
                                    "id": "721680317",
                                    "speaker": "旭东",
                                    "text": "据说，这岛上所有的「绯樱绣球」，都是从那棵大树上飘落的。"
                                },
                                {
                                    "id": "721680318",
                                    "speaker": "旭东",
                                    "text": "到底是多大的树，才能飘出那么多花瓣呢…"
                                },
                                {
                                    "id": "721680319",
                                    "speaker": "旭东",
                                    "text": "如果你有兴趣的话，也过去那边看看吧。"
                                },
                                {
                                    "id": "721680320",
                                    "speaker": "旭东",
                                    "text": "再次谢谢你帮忙，旅行者。我也得去吃点东西了，饿坏我了…"
                                }
                            ]
                        },
                        {
                            "id": "721680313",
                            "text": "你们接下来要去哪？"
                        }
                    ]
                }
            ]
        },
