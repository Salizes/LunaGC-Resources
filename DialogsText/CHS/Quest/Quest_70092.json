            "num": "",
            "title": "魔女的课业·辩驳之题"
        },
        "total_dialogue_lines": 102,
        "total_speaker_counts": {
            "Player": 13,
            "不明真相的路人": 1,
            "布伦妮": 37,
            "派蒙": 14,
            "派蒙＆布伦妮": 1,
