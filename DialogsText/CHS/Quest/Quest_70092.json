    "talks": [
        {
            "id": "7009201",
            "objective": "前往蒙德广场",
            "dialogues": [
                {
                    "id": "700920101",
                    "speaker": "派蒙",
                    "text": "给布伦妮的…与其说是课题，不如说是一封战书…"
                },
                {
                    "id": "700920102",
                    "speaker": "派蒙",
                    "text": "「哼哼，小小魔女猎人，想好打败我的方法了吗？大声喊出你酷酷的挑战宣言，准备好败给大魔王吧！」"
                },
                {
                    "id": "700920103",
                    "speaker": "派蒙",
                    "text": "这个口吻…是艾莉丝吧。要不是写了「魔女猎人」，我还以为这是给可莉写的呢。"
                },
                {
                    "id": "700920104",
                    "speaker": "派蒙",
                    "text": "布伦妮一直对艾莉丝敌意很大，收到这种挑衅会不会被激怒呀…"
                },
                {
                    "id": "700920105",
                    "speaker": "Player",
                    "text": "很明显，艾莉丝是故意的。"
                },
                {
                    "id": "700920106",
                    "speaker": "派蒙",
                    "text": "我们要不要换个委婉点的方式告诉布伦妮？"
                },
                {
                    "id": "700920107",
                    "speaker": "布伦妮",
                    "text": "要告诉我什么？我看看。"
                },
                {
                    "id": "700920108",
                    "speaker": "派蒙",
                    "text": "吓我一跳！你先不要激动，听我说…"
                },
                {
                    "id": "700920109",
                    "speaker": "布伦妮",
                    "text": "…无聊。"
                },
                {
                    "id": "700920110",
                    "speaker": "派蒙",
                    "text": "欸？意外地淡定！"
                },
                {
                    "id": "700920111",
                    "speaker": "布伦妮",
                    "text": "哈。她这种幼稚的把戏我见多了，故作神秘，本质上就是场耍小孩的恶作剧。"
                },
                {
                    "id": "700920112",
                    "speaker": "布伦妮",
                    "text": "谁会在路上「大声喊宣言」啊，不明真相的路人只会觉得莫名其妙吧，我才不上当。"
                },
                {
                    "id": "700920113",
                    "speaker": "布伦妮",
                    "text": "简直等于在街上喊：我就是大笨蛋！"
                },
                {
                    "id": "700920114",
                    "speaker": "留声机",
                    "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！"
                },
                {
                    "id": "700920115",
                    "speaker": "布伦妮",
                    "text": "什、什么啊？！为什么我的声音会从那里冒出来啊？"
                },
                {
                    "id": "700920116",
                    "speaker": "不明真相的路人",
                    "text": "谁？谁在说话？哈哈，谁是大笨蛋？"
                },
                {
                    "id": "700920117",
                    "speaker": "爱凑热闹的路人",
                    "text": "竟然会有人说自己是大笨蛋，哈哈哈，是不是玩游戏输了呀。"
                },
                {
                    "id": "700920118",
                    "speaker": "理智的路人",
                    "text": "绝对是小孩的恶作剧，看来有个笨小孩上当受骗了。"
                },
                {
                    "id": "700920119",
                    "speaker": "布伦妮",
                    "text": "可恶…快停下，不准叫！"
                },
                {
                    "id": "700920120",
                    "speaker": "留声机",
                    "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！"
                },
                {
                    "id": "700920121",
                    "speaker": "布伦妮",
                    "text": "……"
                },
                {
                    "id": "700920122",
                    "speaker": "派蒙",
                    "text": "冷静一下布伦妮！先不要砸了…",
                    "choices": [
                        {
                            "id": "700920123",
                            "text": "收手吧，布伦妮…",
                            "response": [
                                {
                                    "id": "700920125",
                                    "speaker": "布伦妮",
                                    "text": "啊…艾——莉——丝！"
                                },
                                {
                                    "id": "700920126",
                                    "speaker": "艾莉丝",
                                    "text": "嗨嗨各位。哎呀~没想到是这样的宣言呢，非常有意思。恭喜你成功开启魔女的课题挑战！"
                                },
                                {
                                    "id": "700920127",
                                    "speaker": "艾莉丝",
                                    "text": "我为这次的挑战准备了一个很有仪式感的魔法空间，但魔法加载需要点时间…"
                                },
                                {
                                    "id": "700920128",
                                    "speaker": "艾莉丝",
                                    "text": "所以我早早就想好了，把挑战宣言做成加载音效，循环播放给你鼓舞士气，怎么样，喜欢吗！"
                                },
                                {
                                    "id": "700920129",
                                    "speaker": "留声机",
                                    "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！"
                                },
                                {
                                    "id": "700920130",
                                    "speaker": "布伦妮",
                                    "text": "不，这不是什么宣言，快撤回这个破音效啊！"
                                },
                                {
                                    "id": "700920131",
                                    "speaker": "艾莉丝",
                                    "text": "看来闹乌龙了。可是音效跟挑战魔法是一个整体，撤回就等于放弃挑战哦？"
                                },
                                {
                                    "id": "700920132",
                                    "speaker": "艾莉丝",
                                    "text": "真的吗？确定吗？那只好有缘再见了…"
                                },
                                {
                                    "id": "700920133",
                                    "speaker": "布伦妮",
                                    "text": "不…不准走！好不容易才逮住你。啊啊啊…你那破魔法到底还要加载多久啊！"
                                },
                                {
                                    "id": "700920134",
                                    "speaker": "艾莉丝",
                                    "text": "早就好了。"
                                }
                            ]
                        },
                        {
                            "id": "700920124",
                            "text": "周围全是留声机！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7009204",
            "objective": "前往魔法拟造空间",
            "dialogues": []
        },
        {
            "id": "7009202",
            "objective": "前往魔法拟造空间",
            "dialogues": [
                {
                    "id": "700920201",
                    "speaker": "艾莉丝",
                    "text": "欢迎来到提瓦特最具戏剧张力的地方——欧庇克莱歌剧院…的魔法拟造空间！"
                },
                {
                    "id": "700920202",
                    "speaker": "艾莉丝",
                    "text": "这次的课题是「辩论」，为此我专门打造了这样的魔法空间。还不错吧？诚意多多仪式感满满。"
                },
                {
                    "id": "700920203",
                    "speaker": "布伦妮",
                    "text": "辩论？上次你已经彻底输给我了吧，还想来自取其辱吗？"
                },
                {
                    "id": "700920204",
                    "speaker": "艾莉丝",
                    "text": "呵呵…你在12岁的辩题里展现了高达16岁的智慧，不可思议！"
                },
                {
                    "id": "700920205",
                    "speaker": "艾莉丝",
                    "text": "考虑到你是反驳型人格…所以这次我准备了一个你无法反驳的绝妙论题！",
                    "choices": [
                        {
                            "id": "700920206",
                            "text": "不好意思打扰一下…",
                            "response": [
                                {
                                    "id": "700920208",
                                    "speaker": "艾莉丝",
                                    "text": "一场精彩绝伦的辩论少不了一位公平公正的评委，我们几个中你是最佳的人选，我想没有人会反对。"
                                },
                                {
                                    "id": "700920209",
                                    "speaker": "Player",
                                    "text": "那…派蒙在那个位置合适吗？"
                                },
                                {
                                    "id": "700920210",
                                    "speaker": "布伦妮",
                                    "text": "其实我早就想说了，派蒙那家伙已经在高处的贵宾席位上摆了很久的姿势了…",
                                    "choices": [
                                        {
                                            "id": "700920211",
                                            "text": "这句话似曾相识…",
                                            "response": [
                                                {
                                                    "id": "700920213",
                                                    "speaker": "派蒙",
                                                    "text": "嘻嘻…居然被传送到这个位置上，我就突发奇想模仿一下我们的朋友，她可是枫丹的大明星噢！"
                                                },
                                                {
                                                    "id": "700920214",
                                                    "speaker": "艾莉丝",
                                                    "text": "我记得派蒙喜欢看热闹，这个观看席位视野最好，还满意吗？"
                                                },
                                                {
                                                    "id": "700920215",
                                                    "speaker": "派蒙",
                                                    "text": "原来这里看出去的视角是这样的啊…呃，可是我真的可以坐在这看吗？会不会太僭越了…"
                                                },
                                                {
                                                    "id": "700920216",
                                                    "speaker": "艾莉丝",
                                                    "text": "放心，这里是用魔法拟造的空间，魔女说了算。不会有警卫闯进来把你们抓走的。"
                                                },
                                                {
                                                    "id": "700920217",
                                                    "speaker": "艾莉丝",
                                                    "text": "还有坐在山顶的朋友派蒙，对这个贵宾观看席还满意吗？"
                                                },
                                                {
                                                    "id": "700920218",
                                                    "speaker": "派蒙",
                                                    "text": "非、非常震撼！好气派呀…第一次坐在这种地方，我都有点说不出话来了。"
                                                },
                                                {
                                                    "id": "700920219",
                                                    "speaker": "艾莉丝",
                                                    "text": "那请你快快适应哦，接下来的精彩瞬间很需要你的欢呼喝彩呢。"
                                                },
                                                {
                                                    "id": "700920220",
                                                    "speaker": "布伦妮",
                                                    "text": "好了别闹了，速战速决吧，说出你的题目。"
                                                },
                                                {
                                                    "id": "700920221",
                                                    "speaker": "艾莉丝",
                                                    "text": "可莉是个坏孩子！"
                                                },
                                                {
                                                    "id": "700920222",
                                                    "speaker": "派蒙＆布伦妮",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "700920224",
                                                    "speaker": "Player",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "700920225",
                                                    "speaker": "艾莉丝",
                                                    "text": "这就是你要反驳的辩题。如果你能证明「可莉不是坏孩子」，我就送你一份小礼物。"
                                                },
                                                {
                                                    "id": "700920226",
                                                    "speaker": "布伦妮",
                                                    "text": "谁稀罕你的小礼物啊！可莉是你的亲生女儿，你怎么能出这样的题。"
                                                },
                                                {
                                                    "id": "700920227",
                                                    "speaker": "布伦妮",
                                                    "text": "你…坏到极致的坏女人！"
                                                },
                                                {
                                                    "id": "700920228",
                                                    "speaker": "艾莉丝",
                                                    "text": "哼哼。正所谓「有其母必有其女」，既然你咬定我是坏人，那坏人的孩子就是坏孩子，没有错吧。"
                                                },
                                                {
                                                    "id": "700920229",
                                                    "speaker": "布伦妮",
                                                    "text": "反对！简直愚昧，你坏的是人品和作风，没有科学依据证明这种东西会遗传。"
                                                },
                                                {
                                                    "id": "700920230",
                                                    "speaker": "布伦妮",
                                                    "text": "再说了，比起遗传，成长环境更重要，蒙德那群人比你靠谱多了，可莉有他们陪着根本坏不了。"
                                                },
                                                {
                                                    "id": "700920231",
                                                    "speaker": "艾莉丝",
                                                    "text": "但事实是，可莉很喜欢炸鱼，这就是坏孩子的有力证明。"
                                                },
                                                {
                                                    "id": "700920232",
                                                    "speaker": "布伦妮",
                                                    "text": "这…这只是儿童善恶不明的天性！"
                                                },
                                                {
                                                    "id": "700920233",
                                                    "speaker": "布伦妮",
                                                    "text": "港口的船也经常会捕鱼回来，对可莉来说她哪里分得清为什么捕鱼可以但炸鱼就不行嘛…"
                                                },
                                                {
                                                    "id": "700920234",
                                                    "speaker": "艾莉丝",
                                                    "text": "那我就要说了，可莉每次关完禁闭还是屡教不改哦。"
                                                },
                                                {
                                                    "id": "700920235",
                                                    "speaker": "布伦妮",
                                                    "text": "就凭可莉每次都能乖乖配合关禁闭，说明她从来都是认罚的，没有逃避过责任哦。"
                                                },
                                                {
                                                    "id": "700920236",
                                                    "speaker": "布伦妮",
                                                    "text": "不应该在可莉承担完后果后，再给她扣上坏孩子的帽子。"
                                                },
                                                {
                                                    "id": "700920237",
                                                    "speaker": "布伦妮",
                                                    "text": "而且，上一次关完禁闭后，可莉虽然嘴上说着想要炸鱼，却没有「擅自」去做这件事，一次都没有。"
                                                },
                                                {
                                                    "id": "700920238",
                                                    "speaker": "布伦妮",
                                                    "text": "最近的一次行动，全因受了信任之人的「唆使」和「纵容」。而这个人，是一位「混沌」的母亲！"
                                                },
                                                {
                                                    "id": "700920239",
                                                    "speaker": "艾莉丝",
                                                    "text": "嗯哼。"
                                                },
                                                {
                                                    "id": "700920240",
                                                    "speaker": "布伦妮",
                                                    "text": "归根到底，你才是那个最该被扣上坏孩子帽子的人！不对，坏大人！也不对，哪有这么幼稚的大人，坏大孩！"
                                                },
                                                {
                                                    "id": "700920241",
                                                    "speaker": "Player",
                                                    "text": "形势反转了！"
                                                },
                                                {
                                                    "id": "700920242",
                                                    "speaker": "派蒙",
                                                    "text": "听上去好有气势…是很漂亮的一击！对方辩手又该如何应对呢？"
                                                },
                                                {
                                                    "id": "700920243",
                                                    "speaker": "艾莉丝",
                                                    "text": "就算如此，也只能说明可莉主观上没有坏心思。恐怕这不能成为大家眼里可莉不是坏孩子的理由哦。"
                                                },
                                                {
                                                    "id": "700920244",
                                                    "speaker": "布伦妮",
                                                    "text": "还想硬撑么…"
                                                },
                                                {
                                                    "id": "700920245",
                                                    "speaker": "布伦妮",
                                                    "text": "那你听好了，这点你永远无法反驳——"
                                                },
                                                {
                                                    "id": "700920246",
                                                    "speaker": "布伦妮",
                                                    "text": "因为可莉很可爱，所以大家都会原谅她。"
                                                },
                                                {
                                                    "id": "700920247",
                                                    "speaker": "Player",
                                                    "text": "对！"
                                                },
                                                {
                                                    "id": "700920248",
                                                    "speaker": "派蒙",
                                                    "text": "没错！可莉这么可爱，犯点小错怎么了，反正她在我眼里不是坏孩子！"
                                                },
                                                {
                                                    "id": "700920249",
                                                    "speaker": "布伦妮",
                                                    "text": "比起你说的那些，明明她身上的优点更多：会把玩具分享给别人，想去玩的时候发现大家在忙就在一边乖乖等待…"
                                                },
                                                {
                                                    "id": "700920250",
                                                    "speaker": "布伦妮",
                                                    "text": "最重要的是，对每个人都充满善意，所有人在她眼里都是好人，包括将她妈妈视为敌人的我…"
                                                },
                                                {
                                                    "id": "700920251",
                                                    "speaker": "布伦妮",
                                                    "text": "总之，这么可爱的孩子，我不许你说她是坏孩子！"
                                                },
                                                {
                                                    "id": "700920252",
                                                    "speaker": "艾莉丝",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "700920253",
                                                    "speaker": "艾莉丝",
                                                    "text": "我投降啦！身为妈妈不可能不认同这句话。"
                                                },
                                                {
                                                    "id": "700920254",
                                                    "speaker": "艾莉丝",
                                                    "text": "而且终于从你嘴里听到这句话了，看来你是真心把可莉当成好朋友的。"
                                                },
                                                {
                                                    "id": "700920255",
                                                    "speaker": "艾莉丝",
                                                    "text": "我的女儿非常可爱对不对？我早就说过了，去找到她，你也会变得快乐的。"
                                                },
                                                {
                                                    "id": "700920256",
                                                    "speaker": "布伦妮",
                                                    "text": "你还得意上了？我之所以千里迢迢跑到蒙德来不就是因为你的恶作剧吗！"
                                                },
                                                {
                                                    "id": "700920257",
                                                    "speaker": "艾莉丝",
                                                    "text": "嘻嘻。可莉有你这位好朋友的陪伴，我就更加放心了。"
                                                },
                                                {
                                                    "id": "700920258",
                                                    "speaker": "艾莉丝",
                                                    "text": "真期待你们的成长啊，你也想象不到可莉到我这个年纪还炸鱼吧。"
                                                },
                                                {
                                                    "id": "700920259",
                                                    "speaker": "布伦妮",
                                                    "text": "等等，你该不会说「这个课题真正要考验的是你对可莉的真心」这种超土的话吧？"
                                                },
                                                {
                                                    "id": "700920260",
                                                    "speaker": "艾莉丝",
                                                    "text": "真聪明。那就快进到宣布挑战结果的环节吧。有请评委老师——"
                                                },
                                                {
                                                    "id": "700920261",
                                                    "speaker": "Player",
                                                    "text": "咳咳，「布伦妮小朋友的魔女挑战课题，合格！现送出魔女的祝福」…"
                                                },
                                                {
                                                    "id": "700920262",
                                                    "speaker": "Player",
                                                    "text": "「祝你和可莉一样，身体好好吃饭饱饱烦恼少少，当个快乐的小孩」。"
                                                },
                                                {
                                                    "id": "700920263",
                                                    "speaker": "艾莉丝",
                                                    "text": "你和可莉都是好孩子，即便偶尔犯错或闹脾气，也是可以被允许的哦。"
                                                },
                                                {
                                                    "id": "700920264",
                                                    "speaker": "布伦妮",
                                                    "text": "谢…谢谢？但一码归一码，说了多少次别把我当小孩。"
                                                },
                                                {
                                                    "id": "700920265",
                                                    "speaker": "布伦妮",
                                                    "text": "别忘了我是魔女猎人，不会跟你和解的，想都不要想！你输了，老实出来，别用这个大玩偶糊弄我。"
                                                },
                                                {
                                                    "id": "700920266",
                                                    "speaker": "艾莉丝",
                                                    "text": "今天玩得很开心，下次有空再来逗你玩。拜拜~"
                                                },
                                                {
                                                    "id": "700920267",
                                                    "speaker": "布伦妮",
                                                    "text": "跟你说话呢没听见吗？别跑——"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700920212",
                                            "text": "这个场面也是！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700920207",
                            "text": "我在这个位置合适吗？"
                        }
                    ]
                }
            ]
        },
        {
