                {
                    "id": "730850201",
                    "speaker": "Player",
                    "text": "好啊，我们玩什么？"
                },
                {
                    "id": "730850202",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什知道，那菈擅长找东西，很快很快，就能找到兰陀尼什想要的那个。"
                },
                {
                    "id": "730850203",
                    "speaker": "兰陀尼什",
                    "text": "这次，兰陀尼什想要的东西…是<color=#00E1FFFF>干草，很多干草，挤在一起</color>。「时间很紧」，那菈要很快，很快才行。"
                }
            ]
        },
        {
            "id": "7308503",
            "objective": "",
            "dialogues": [
                {
                    "id": "730850301",
                    "speaker": "Player",
                    "text": "现在没空。"
                },
                {
                    "id": "730850302",
                    "speaker": "兰陀尼什",
                    "text": "那兰陀尼什等，等到那菈「有空」。"
                }
            ]
        },
        {
            "id": "7308504",
            "objective": "",
            "dialogues": [
                {
                    "id": "730850401",
                    "speaker": "兰陀尼什",
                    "text": "金色的那菈，果然像传闻里提到的那样「眼疾手快」！"
                },
                {
                    "id": "730850402",
                    "speaker": "兰陀尼什",
                    "text": "陪兰陀尼什玩游戏，是好那菈，这个送给那菈朋友！"
                }
            ]
        },
        {
            "id": "7308505",
            "objective": "",
            "dialogues": [
                {
                    "id": "730850601",
                    "speaker": "兰陀尼什",
                    "text": "哈哈，不对不对，兰陀尼什不想要这个。那菈要再想想。"
                },
                {
                    "id": "730850602",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什一直在，那菈还想玩游戏的话，随时都可以哦。"
                }
            ]
        },
