    "talks": [
        {
            "id": "37601",
            "objective": "逃出大教堂",
            "dialogues": []
        },
        {
            "id": "37602",
            "objective": "通过风场，远离大教堂",
            "dialogues": []
        },
        {
            "id": "37603",
            "objective": "(test)失败回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "3760301",
                    "speaker": "温迪",
                    "text": "我觉得冲进酒馆是个好主意"
                },
                {
                    "id": "3760302",
                    "speaker": "派蒙",
                    "text": "何以见得？"
                },
                {
                    "id": "3760303",
                    "speaker": "温迪",
                    "text": "可以混进喝酒的人群之中"
                },
                {
                    "id": "3760304",
                    "speaker": "温迪",
                    "text": "说不定还能趁乱摸点东西"
                },
                {
                    "id": "3760305",
                    "speaker": "派蒙",
                    "text": "这满肚子坏水的诗人…等我们逃过这关，我一定要好好教育你！"
                }
            ]
        },
        {
            "id": "37604",
            "objective": "躲进酒馆",
            "dialogues": [
                {
                    "id": "3760401",
                    "speaker": "查尔斯",
                    "text": "迪卢克老爷，这周的账面就是这样了。"
                },
                {
                    "id": "3760402",
                    "speaker": "迪卢克",
                    "text": "这次风灾，对生意的影响果然很大。"
                },
                {
                    "id": "3760403",
                    "speaker": "查尔斯",
                    "text": "希望这段时间早点过去吧。"
                },
                {
                    "id": "3760404",
                    "speaker": "温迪",
                    "text": "老板，我们…想要一个，稍微隐蔽点的地方。"
                },
                {
                    "id": "3760405",
                    "speaker": "迪卢克",
                    "text": "要说隐蔽的话，二楼人少。"
                },
                {
                    "id": "3760406",
                    "speaker": "迪卢克",
                    "text": "但你不是吟游诗人吗？不如选个热闹的位置吧。"
                },
                {
                    "id": "3760407",
                    "speaker": "温迪",
                    "text": "啊哈哈，收费演出就等下次吧。我们先上去了，一会见~！"
                },
                {
                    "id": "3760408",
                    "speaker": "迪卢克",
                    "text": "看好他们。那个诗人很可疑，我要去问问情况。"
                },
                {
                    "id": "3760409",
                    "speaker": "查尔斯",
                    "text": "呃…问谁？"
                },
                {
                    "id": "3760410",
                    "speaker": "迪卢克",
                    "text": "蒙德城的「保安」们。"
                }
            ]
        },
        {
            "id": "37605",
            "objective": "回答迪卢克的质问",
            "dialogues": []
        },
        {
            "id": "37606",
            "objective": "躲到酒馆的楼上",
            "dialogues": [
                {
                    "id": "3760601",
                    "speaker": "奥特",
                    "text": "啊，迪卢克老爷，你看见那两个小偷了吗？"
                },
                {
                    "id": "3760602",
                    "speaker": "迪卢克",
                    "text": "发生了什么，怎么出动了这么多人？"
                },
                {
                    "id": "3760603",
                    "speaker": "麦尔斯",
                    "text": "迪卢克老爷没听说吗？有两个小偷，居然打起了天空之琴的主意！"
                },
                {
                    "id": "3760604",
                    "speaker": "迪卢克",
                    "text": "哦？真是奇了。"
                },
                {
                    "id": "3760605",
                    "speaker": "麦尔斯",
                    "text": "是吧。天空之琴可是风神他老人家亲手弹过的宝物，这样珍贵的文化财产——"
                },
                {
                    "id": "3760606",
                    "speaker": "迪卢克",
                    "text": "居然有人会傻到偷一件卖不出去的东西，还不如偷我家酒窖划算。"
                },
                {
                    "id": "3760607",
                    "speaker": "奥特",
                    "text": "…"
                },
                {
                    "id": "3760608",
                    "speaker": "迪卢克",
                    "text": "啊，抱歉离题了。那一黄一绿的两个人，好像往那边去了。"
                },
                {
                    "id": "3760609",
                    "speaker": "麦尔斯",
                    "text": "好的好的。谢谢迪卢克老爷！"
                }
            ]
        },
        {
            "id": "37607",
            "objective": "(test)等待卫兵离去$HIDDEN",
            "dialogues": []
        },
        {
            "id": "37608",
            "objective": "与迪卢克对话",
            "dialogues": [
                {
                    "id": "3760701",
                    "speaker": "温迪",
                    "text": "今天想喝…"
                },
                {
                    "id": "3760702",
                    "speaker": "迪卢克",
                    "text": "把从柜子后面摸来的酒给我放下。"
                },
                {
                    "id": "3760703",
                    "speaker": "温迪",
                    "text": "…想喝冰一点的。"
                },
                {
                    "id": "3760704",
                    "speaker": "迪卢克",
                    "text": "好了，你们该好好回答一下我的问题了。"
                },
                {
                    "id": "3760705",
                    "speaker": "温迪",
                    "text": "先让我喝完，我会付账的啦…嗯，用表演抵债。"
                },
                {
                    "id": "3760706",
                    "speaker": "迪卢克",
                    "text": "不是钱的问题，你看起来还没到能买酒的年纪。"
                },
                {
                    "id": "3760707",
                    "speaker": "温迪",
                    "text": "这你可以放心，我喝酒的时候你还在——",
                    "choices": [
                        {
                            "id": "3760708",
                            "text": "不如先回答我的问题。",
                            "response": [
                                {
                                    "id": "3760709",
                                    "speaker": "温迪",
                                    "text": "你想问「这是哪位」，对吗？"
                                },
                                {
                                    "id": "3760711",
                                    "speaker": "温迪",
                                    "text": "想必这位就是<color=#00E1FFFF>迪卢克</color>老爷，酒馆老板背后的…大老板。"
                                },
                                {
                                    "id": "3760712",
                                    "speaker": "温迪",
                                    "text": "是很有名的人呢。顺带一提，我很喜欢他家出品的蒲公英酒。"
                                },
                                {
                                    "id": "3760713",
                                    "speaker": "温迪",
                                    "text": "虽然大部分时间我只买得起散装的…"
                                },
                                {
                                    "id": "3760714",
                                    "speaker": "迪卢克",
                                    "text": "我刚从卫兵那里听说小偷的事。"
                                },
                                {
                                    "id": "3760715",
                                    "speaker": "迪卢克",
                                    "text": "先说明一下，你们居然敢去偷天空之琴，我很欣赏。"
                                },
                                {
                                    "id": "3760716",
                                    "speaker": "迪卢克",
                                    "text": "就算你们是傻子，那也是千年少见的傻子了。"
                                },
                                {
                                    "id": "3760717",
                                    "speaker": "派蒙",
                                    "text": "不是我们偷的啦！真犯人另有其人——"
                                },
                                {
                                    "id": "3760718",
                                    "speaker": "温迪",
                                    "text": "这位可是骑士团的当红新人，怎么会去偷蒙德的圣物呢？"
                                },
                                {
                                    "id": "3760719",
                                    "speaker": "迪卢克",
                                    "text": "当红新人…？啊，原来就是你啊。"
                                },
                                {
                                    "id": "3760720",
                                    "speaker": "迪卢克",
                                    "text": "怎么，你和那个吟游诗人是熟人吗？",
                                    "choices": [
                                        {
                                            "id": "3760721",
                                            "text": "其实也没那么熟。",
                                            "response": [
                                                {
                                                    "id": "3760723",
                                                    "speaker": "迪卢克",
                                                    "text": "嗯…身为旅行者，却愿意对危难中的蒙德伸出援手。"
                                                },
                                                {
                                                    "id": "3760724",
                                                    "speaker": "迪卢克",
                                                    "text": "这样的人，加入骑士团太可惜了。"
                                                },
                                                {
                                                    "id": "3760725",
                                                    "speaker": "迪卢克",
                                                    "text": "西风骑士团…在风魔龙问题上一直畏首畏尾，效率低下。"
                                                },
                                                {
                                                    "id": "3760726",
                                                    "speaker": "迪卢克",
                                                    "text": "外交上对<color=#00E1FFFF>「愚人众」</color>也是弱势又保守。"
                                                },
                                                {
                                                    "id": "3760727",
                                                    "speaker": "迪卢克",
                                                    "text": "啧…算了，我也不想多提这个话题。"
                                                },
                                                {
                                                    "id": "3760728",
                                                    "speaker": "温迪",
                                                    "text": "看来迪卢克老爷非常不喜欢西风骑士团呢。"
                                                },
                                                {
                                                    "id": "3760729",
                                                    "speaker": "迪卢克",
                                                    "text": "道路不同罢了。"
                                                },
                                                {
                                                    "id": "3760730",
                                                    "speaker": "迪卢克",
                                                    "text": "我对蒙德这座城市，有我自己的期许…"
                                                },
                                                {
                                                    "id": "3760731",
                                                    "speaker": "迪卢克",
                                                    "text": "那么回答我的问题吧。你们为什么要偷走天空之琴？"
                                                },
                                                {
                                                    "id": "3760732",
                                                    "speaker": "温迪",
                                                    "text": "你真的想知道吗？可能会卷入与骑士团有关的麻烦哦？"
                                                },
                                                {
                                                    "id": "3760733",
                                                    "speaker": "迪卢克",
                                                    "text": "…呵。我不怕麻烦，我本人就是骑士团的麻烦。"
                                                },
                                                {
                                                    "id": "3760734",
                                                    "speaker": "温迪",
                                                    "text": "那么，如果我来演奏真实的故事，你会相信我吗？"
                                                },
                                                {
                                                    "id": "3760735",
                                                    "speaker": "迪卢克",
                                                    "text": "视情况而定，我会作出判断。"
                                                },
                                                {
                                                    "id": "3760736",
                                                    "speaker": "温迪",
                                                    "text": "那么——你会付我演出的赏额吗？"
                                                },
                                                {
                                                    "id": "3760737",
                                                    "speaker": "迪卢克",
                                                    "text": "报酬从5摩拉到天空之琴，视你的故事而定。"
                                                },
                                                {
                                                    "id": "3760738",
                                                    "speaker": "温迪",
                                                    "text": "很好。我就再追加一场吧——"
                                                },
                                                {
                                                    "id": "3760739",
                                                    "speaker": "迪卢克",
                                                    "text": "刚才的叙事诗，究竟是…"
                                                },
                                                {
                                                    "id": "3760740",
                                                    "speaker": "迪卢克",
                                                    "text": "这是重要的秘密。为什么让我知道这些？"
                                                },
                                                {
                                                    "id": "3760741",
                                                    "speaker": "温迪",
                                                    "text": "为什么呢？嗯，也许是因为风的流向正在变化吧。"
                                                },
                                                {
                                                    "id": "3760742",
                                                    "speaker": "温迪",
                                                    "text": "——怎么样，迪卢克老爷？"
                                                },
                                                {
                                                    "id": "3760743",
                                                    "speaker": "迪卢克",
                                                    "text": "有趣。"
                                                },
                                                {
                                                    "id": "3760744",
                                                    "speaker": "迪卢克",
                                                    "text": "给我一些时间，我可以想办法牵线搭桥…"
                                                },
                                                {
                                                    "id": "3760745",
                                                    "speaker": "迪卢克",
                                                    "text": "异乡人，你似乎是因为骑士团的身份，没有遭到怀疑。"
                                                },
                                                {
                                                    "id": "3760746",
                                                    "speaker": "迪卢克",
                                                    "text": "通缉令上写的特征只是金发，卫兵应该不会找上你。"
                                                },
                                                {
                                                    "id": "3760747",
                                                    "speaker": "迪卢克",
                                                    "text": "但吟游诗人，你最好还是不要离开酒馆了。"
                                                },
                                                {
                                                    "id": "3760748",
                                                    "speaker": "温迪",
                                                    "text": "没问题！我喜欢酒馆。"
                                                },
                                                {
                                                    "id": "3760749",
                                                    "speaker": "迪卢克",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "3760750",
                                                    "speaker": "迪卢克",
                                                    "text": "那么，晚上酒馆打烊以后，我们在这里再会。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3760722",
                                            "text": "只是听过一场演奏的关系。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3760710",
                            "text": "这是哪位？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "48202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4820221",
                    "speaker": "安柏",
                    "text": "按照我给你<color=#00E1FFFF>标记好的路线</color>，一路平稳地飞到终点吧。"
                }
            ]
        }
    ]
}