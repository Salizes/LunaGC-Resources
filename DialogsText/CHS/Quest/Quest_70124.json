    "talks": [
        {
            "id": "7012401",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240101",
                    "speaker": "古老的铭文",
                    "text": "「…以为魂，星银以为骨。但能挥舞它，斩开冰雪的异邦人，伊蒙洛…」"
                }
            ]
        },
        {
            "id": "7012402",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240201",
                    "speaker": "古老的铭文",
                    "text": "「…以此尝试愈疗地脉，但树已枯死。将公主薄葬后…」"
                }
            ]
        },
        {
            "id": "7012403",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240301",
                    "speaker": "古老的铭文",
                    "text": "「…无果，不得回应。法鲁希前往峰顶…」"
                }
            ]
        },
        {
            "id": "7012404",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240401",
                    "speaker": "古老的铭文",
                    "text": "「…风雪遍天。天降之柱崩裂为三…」"
                }
            ]
        },
        {
            "id": "7012405",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240501",
                    "speaker": "古老的铭文",
                    "text": "「…远离冰雪与纷争，抵达此间苍绿的乐土。遂立此碑，并定都于此，名之为沙尔·芬…」"
                }
            ]
        },
        {
            "id": "7012406",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240601",
                    "speaker": "古老的铭文",
                    "text": "「…梦见了蔽日的漆黑之龙。是为凶异之兆。同月，异邦人…」"
                }
            ]
        },
        {
            "id": "7012407",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240701",
                    "speaker": "古老的铭文",
                    "text": "「…的引导下前往山中苍白之树之所在。同月，地下水路…」"
                }
            ]
        },
        {
            "id": "7012408",
            "objective": "(test)(隐藏)古代正文对话1-8$HIDDEN",
            "dialogues": [
                {
                    "id": "701240801",
                    "speaker": "古老的铭文",
                    "text": "「…已殁。再没有书记的必要了。最大的憾事，莫过于无法目睹她完成大殿中的壁画吧…」"
                }
            ]
        },
        {
            "id": "7012409",
            "objective": "(test)(隐藏)控制古代正文父任务完成的子任务$HIDDEN",
            "dialogues": [
