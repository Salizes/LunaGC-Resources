        {
            "id": "7620606",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7620601",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762060101",
                    "speaker": "卡斯蒂廖内",
                    "text": "狩野啊，你屏风还没画完就别到处乱窜了，先想想你的瀑布怎么画吧。看在厄歌莉娅的份上，哪有人用散点透视画瀑布的…"
                },
                {
                    "id": "762060102",
                    "speaker": "卡斯蒂廖内",
                    "text": "…嗯？啊，抱歉，原来是陌生的朋友啊。听脚步声我还以为是狩野呢。"
                },
                {
                    "id": "762060103",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "762060104",
                    "speaker": "卡斯蒂廖内",
                    "text": "如您所见，我在作画。"
                },
                {
                    "id": "762060105",
                    "speaker": "卡斯蒂廖内",
                    "text": "为了避免您误会，请让我先和您说清楚。虽然我擅长画动物，但我画的动物不是用来吃的。"
                },
                {
                    "id": "762060106",
                    "speaker": "派蒙",
                    "text": "欸，原来能吃吗？！"
                },
                {
                    "id": "762060107",
                    "speaker": "卡斯蒂廖内",
                    "text": "画中人是眼前人，画中兽自然也能是盘中兽…唉，虽说如此，还是希望您不要像璃月的那位妌癸女士一样，只缠着我画鱼肉。"
                },
                {
                    "id": "762060108",
                    "speaker": "卡斯蒂廖内",
                    "text": "艺术——可敬的艺术！无论时代，其主旨应当是人类灵魂的救赎、情操的陶冶，以真、善、美指引我等，通往更高的精神境界。"
                },
                {
                    "id": "762060109",
                    "speaker": "卡斯蒂廖内",
                    "text": "举例来说，登临山峰的最高处，所见的风景自然真实无阻。我所追求的艺术也是如此。"
                },
                {
                    "id": "762060110",
                    "speaker": "卡斯蒂廖内",
                    "text": "嗯…只是像这样说的话，您也许没有办法直观理解。这样吧，我给您画个浮台，您上去体验一番便是。"
                }
            ]
        },
        {
            "id": "7620602",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        }
    ]
