    "talks": [
        {
            "id": "7051608",
            "objective": "",
            "dialogues": [
                {
                    "id": "705160801",
                    "speaker": "派蒙",
                    "text": "这里也有几封信呢。"
                },
                {
                    "id": "705160802",
                    "speaker": "派蒙",
                    "text": "#来，{NICKNAME}，选出你想读的信件吧。",
                    "choices": [
                        {
                            "id": "705160803",
                            "text": "字迹华丽的信·其七",
                            "response": [
                                {
                                    "id": "705160804",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160805",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "例行公务，骑士团需要对相关人士取证。"
                                },
                                {
                                    "id": "705160806",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "最近骑士团收到几例目击报告，称「暗夜英雄」曾在晨曦酒庄一带出没。"
                                },
                                {
                                    "id": "705160807",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "大团长指定骑兵小队执行本次任务。因此，我将在三天后登门拜访。"
                                },
                                {
                                    "id": "705160808",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "他似乎觉得，强迫我们面对面交流就能改善我们的关系。"
                                },
                                {
                                    "id": "705160809",
                                    "speaker": "字迹华丽的信·其七",
                                    "text": "当然了，我不会多说半个字，只是走个流程。提前三天通知你，算是给足了准备时间吧？"
                                }
                            ]
                        },
                        {
                            "id": "705160810",
                            "text": "字迹华丽的信·其八",
                            "response": [
                                {
                                    "id": "705160811",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160812",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "上次深渊教团来袭，「暗夜英雄」的出现的确为骑士团争取到了一定时间。"
                                },
                                {
                                    "id": "705160813",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "这也让琴有了服众的理由，骑士团不会再重点防备「暗夜英雄」。"
                                },
                                {
                                    "id": "705160814",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "「暗夜英雄」受到的限制将会减少，但处境未必会变好。"
                                },
                                {
                                    "id": "705160815",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "锋芒太过锐利的事物，势必容易遭到折损。独自行动意味着怎样巨大的风险，你应该很清楚。"
                                },
                                {
                                    "id": "705160823",
                                    "speaker": "字迹华丽的信·其八",
                                    "text": "我不推荐这样做。"
                                }
                            ]
                        },
                        {
                            "id": "705160816",
                            "text": "字迹华丽的信·其九",
                            "response": [
                                {
                                    "id": "705160817",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160818",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "听说晨曦酒庄幸未遭受任何损失。骑士团也只有几人轻伤，短时间内就能恢复。"
                                },
                                {
                                    "id": "705160819",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "只是，有位商铺员工失踪了。失联地点与深渊教团的行动路线巧妙地重合。"
                                },
                                {
                                    "id": "705160820",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "骑士团已经派人前去搜救。"
                                },
                                {
                                    "id": "705160821",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "你必须意识到，深渊教团已经变得越来越危险，甚至开始组织多线攻势。"
                                },
                                {
                                    "id": "705160822",
                                    "speaker": "字迹华丽的信·其九",
                                    "text": "「暗夜英雄」或许该考虑与骑士团合作，那样才能万无一失。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051601",
            "objective": "",
            "dialogues": [
                {
                    "id": "705160101",
                    "speaker": "派蒙",
                    "text": "咦，这里放着另一组信？好像不久前也被迪卢克读过…"
                },
                {
                    "id": "705160102",
                    "speaker": "派蒙",
                    "text": "我们要先读哪些呢？",
                    "choices": [
                        {
                            "id": "705160103",
                            "text": "字迹华丽的信·其一",
                            "response": [
                                {
                                    "id": "705160104",
                                    "speaker": "字迹华丽的信·其一",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160105",
                                    "speaker": "字迹华丽的信·其一",
                                    "text": "骑士团内部刮起了一场风暴。法尔伽的心腹预备彻查伊洛克和他的党羽，他很快就会落马了。"
                                },
                                {
                                    "id": "705160106",
                                    "speaker": "字迹华丽的信·其一",
                                    "text": "或许你不那么想看到我的来信，但我的本意是希望这件事能尽快传到你耳朵里。"
                                },
                                {
                                    "id": "705160107",
                                    "speaker": "字迹华丽的信·其一",
                                    "text": "不用回信也没关系。"
                                }
                            ]
                        },
                        {
                            "id": "705160108",
                            "text": "字迹华丽的信·其二",
                            "response": [
                                {
                                    "id": "705160109",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160110",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "听说你决定出门远游，即便是我也感到有些意外。"
                                },
                                {
                                    "id": "705160111",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "琴想写信劝你，我建议她不要。"
                                },
                                {
                                    "id": "705160112",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "至于法尔伽那边，应该是还不清楚这件事。否则以他的个性，多半会约你去酒馆面谈。"
                                },
                                {
                                    "id": "705160113",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "你想走就趁最近。知道的人越少，告别仪式就越少。最好选在夜晚出发，以免感伤。"
                                },
                                {
                                    "id": "705160114",
                                    "speaker": "字迹华丽的信·其二",
                                    "text": "一路顺风。"
                                }
                            ]
                        },
                        {
                            "id": "705160115",
                            "text": "字迹华丽的信·其三",
                            "response": [
                                {
                                    "id": "705160116",
                                    "speaker": "字迹华丽的信·其三",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160117",
                                    "speaker": "字迹华丽的信·其三",
                                    "text": "半条坏消息。伊洛克没那么容易被扳倒。"
                                },
                                {
                                    "id": "705160118",
                                    "speaker": "字迹华丽的信·其三",
                                    "text": "大团长下令调查的确给了他很大打击，但相关势力仍未被连根拔除。"
                                },
                                {
                                    "id": "705160119",
                                    "speaker": "字迹华丽的信·其三",
                                    "text": "目前这件事由琴跟进。她应该会尽到职责，伊洛克本来也是她执权路上绕不过的坎。"
                                },
                                {
                                    "id": "705160120",
                                    "speaker": "字迹华丽的信·其三",
                                    "text": "你只需要静候佳音。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051602",
            "objective": "",
            "dialogues": [
                {
                    "id": "705130901",
                    "speaker": "迪卢克",
                    "text": "到此为止了。"
                },
                {
                    "id": "705130902",
                    "speaker": "迪卢克",
                    "text": "再过一段时间，这个异常的地脉淤积点就会消失。",
                    "choices": [
                        {
                            "id": "705130903",
                            "text": "这次的战斗很顺利。",
                            "response": [
                                {
                                    "id": "705130905",
                                    "speaker": "派蒙",
                                    "text": "毕竟是大家一起努力的结果！"
                                },
                                {
                                    "id": "705130906",
                                    "speaker": "派蒙",
                                    "text": "看来，「正义人」也需要伙伴嘛。不能总是让迪卢克老爷一个人奔波，帮手多多益善！"
                                },
                                {
                                    "id": "705130907",
                                    "speaker": "迪卢克",
                                    "text": "伙伴…"
                                },
                                {
                                    "id": "705130908",
                                    "speaker": "迪卢克",
                                    "text": "很久没跟别人一起行动了，这种感觉也不坏。"
                                },
                                {
                                    "id": "705130909",
                                    "speaker": "迪卢克",
                                    "text": "有机会的话，下次可以继续合作。"
                                }
                            ]
                        },
                        {
                            "id": "705130904",
                            "text": "这次的战斗很酣畅。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051607",
            "objective": "",
            "dialogues": [
                {
                    "id": "705160701",
                    "speaker": "派蒙",
                    "text": "还有一组信？"
                },
                {
                    "id": "705160702",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你觉得我们要先看哪一封呢？",
                    "choices": [
                        {
                            "id": "705160703",
                            "text": "字迹华丽的信·其四",
                            "response": [
                                {
                                    "id": "705160704",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160705",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "近期有批商人回到了蒙德城，说是在外经营不利，退回蒙德发展。"
                                },
                                {
                                    "id": "705160706",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "经我观察，他们的员工常往「天使的馈赠」跑。也正是这批人，多次出没在野外危险地带。"
                                },
                                {
                                    "id": "705160707",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "其中有几位不够谨慎，居然把笔记的残页落在地上。好心如我，就先替他们送回「天使的馈赠」了。"
                                },
                                {
                                    "id": "705160708",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "会去那里，应该是与你有关。我看他们的笔记都用了暗语，情报贩子？还是秘密组织？"
                                },
                                {
                                    "id": "705160720",
                                    "speaker": "字迹华丽的信·其四",
                                    "text": "总之，虽然只凭单眼很难看清那些模糊的字，我也还是认真看了。这件事我会帮忙保密的。"
                                }
                            ]
                        },
                        {
                            "id": "705160709",
                            "text": "字迹华丽的信·其五",
                            "response": [
                                {
                                    "id": "705160710",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160711",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "我可没有故意瞒着你，不过，倒也没想到你已经发现了。"
                                },
                                {
                                    "id": "705160712",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "似乎没人规定过瞎了才能戴眼罩吧。右眼有疤痕，戴个眼罩遮一下不也是天经地义吗？"
                                },
                                {
                                    "id": "705160713",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "等候已久的好消息来了。"
                                },
                                {
                                    "id": "705160721",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "在伊洛克离职当天端着酒杯茶杯赶去看热闹，目送他收拾东西滚蛋，应该挺有趣的吧？"
                                },
                                {
                                    "id": "705160722",
                                    "speaker": "字迹华丽的信·其五",
                                    "text": "以你的性格多半不会这么做。但我喜欢，我可以代劳。"
                                }
                            ]
                        },
                        {
                            "id": "705160714",
                            "text": "字迹华丽的信·其六",
                            "response": [
                                {
                                    "id": "705160715",
                                    "speaker": "字迹华丽的信·其六",
                                    "text": "给D："
                                },
                                {
                                    "id": "705160716",
                                    "speaker": "字迹华丽的信·其六",
                                    "text": "真不巧！你才回蒙德没多久，城里就出现了一个神秘人物。"
                                },
                                {
                                    "id": "705160717",
                                    "speaker": "字迹华丽的信·其六",
                                    "text": "听说他被称为「暗夜英雄」。此人曾多次打击蒙德周边的盗宝团和魔物，甚至主动进攻深渊教团据点。"
                                },
                                {
                                    "id": "705160718",
                                    "speaker": "字迹华丽的信·其六",
                                    "text": "目前看来，他的行动对蒙德尚算有利。但骑士团不可能允许独立的武装势力存在。"
                                },
                                {
                                    "id": "705160719",
                                    "speaker": "字迹华丽的信·其六",
                                    "text": "我总觉得你们会很合得来，你快找个机会认识一下这位，最好能再劝劝他。可别被骑士团抓了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051605",
            "objective": "",
            "dialogues": [
                {
                    "id": "705160501",
                    "speaker": "派蒙",
                    "text": "这里有两篇笔记，我们先读哪一篇比较好呢？",
                    "choices": [
                        {
                            "id": "705160502",
                            "text": "阅读第一篇笔记。",
                            "response": [
                                {
                                    "id": "705160503",
                                    "speaker": "第一篇笔记",
                                    "text": "上次地脉发生异常，主动放出侵略性很强的魔物，已经是好几年前的事了。"
                                },
                                {
                                    "id": "705160504",
                                    "speaker": "第一篇笔记",
                                    "text": "「暗夜英雄」准确控制时间，将所有魔物分批引导到开阔地带，逐一击败…的确是一种策略。"
                                },
                                {
                                    "id": "705160505",
                                    "speaker": "第一篇笔记",
                                    "text": "事后伪装成受重伤的模样，引诱幕后的深渊教团主队现身，再给对方迎头痛击，更是精彩绝伦的反击。"
                                },
                                {
                                    "id": "705160506",
                                    "speaker": "第一篇笔记",
                                    "text": "但这中间存在太多不确定因素了。「暗夜英雄」本人也表示不能每次都像这样冒险。"
                                },
                                {
                                    "id": "705160507",
                                    "speaker": "第一篇笔记",
                                    "text": "查明原理，提早预防这种地脉异常现象，才是最稳妥的做法。"
                                },
                                {
                                    "id": "705160508",
                                    "speaker": "派蒙",
                                    "text": "虽然不太明白，但好像提到了迪卢克以前的战果？"
                                }
                            ]
                        },
                        {
                            "id": "705160509",
                            "text": "阅读第二篇笔记。",
                            "response": [
                                {
                                    "id": "705160510",
                                    "speaker": "第二篇笔记",
                                    "text": "地脉还有很多秘密，我们这些普通人没必要搞得太清楚。"
                                },
                                {
                                    "id": "705160511",
                                    "speaker": "第二篇笔记",
                                    "text": "不过「暗夜英雄」要长期对抗深渊教团，还是深入了解一下为妙。"
                                },
                                {
                                    "id": "705160512",
                                    "speaker": "第二篇笔记",
                                    "text": "听说西风骑士团调查小队的队长有着很高的学术造诣。他不像丽莎，和代理团长走得很近。"
                                },
                                {
                                    "id": "705160513",
                                    "speaker": "第二篇笔记",
                                    "text": "向他请教一些问题，不太可能被骑士团的人知道。"
                                },
                                {
                                    "id": "705160514",
                                    "speaker": "第二篇笔记",
                                    "text": "应当建议「暗夜英雄」向他咨询地脉的技术难题，由我来将信件送到他在雪山的营地。"
                                },
                                {
                                    "id": "705160515",
                                    "speaker": "派蒙",
                                    "text": "咦？这篇笔记好像提到了阿贝多呢。难道迪卢克给阿贝多寄过信吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051320",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132001",
                    "speaker": "Player",
                    "text": "字迹隽秀的信"
                },
                {
                    "id": "705132002",
                    "speaker": "字迹隽秀的信",
                    "text": "迪卢克前辈——"
                },
                {
                    "id": "705132003",
                    "speaker": "字迹隽秀的信",
                    "text": "欢迎回到蒙德。"
                },
                {
                    "id": "705132004",
                    "speaker": "字迹隽秀的信",
                    "text": "那件事已经过去一段时日了，我们查明是伊洛克从中作梗，他已被严厉惩办。"
                },
                {
                    "id": "705132005",
                    "speaker": "字迹隽秀的信",
                    "text": "希望听见这个消息，你的心境能稍微平复。"
                },
                {
                    "id": "705132006",
                    "speaker": "字迹隽秀的信",
                    "text": "此外，我们的人发现，最近深渊教团在奔狼领到石门一带活动愈发频繁。"
                },
                {
                    "id": "705132007",
                    "speaker": "字迹隽秀的信",
                    "text": "还有一名被称作「暗夜英雄」的神秘人，最近他常在午夜时分出没，活跃于蒙德城四周。行动目的尚不明朗。"
                },
                {
                    "id": "705132008",
                    "speaker": "字迹隽秀的信",
                    "text": "请务必注意安全，发现异常尽早通知骑士团。我们将是你的助力。"
                },
                {
                    "id": "705132009",
                    "speaker": "字迹隽秀的信",
                    "text": "不论是否任职于骑士团，你对骑士团的贡献仍会被每位信念坚定的骑士铭记在心。"
                },
                {
                    "id": "705132010",
                    "speaker": "字迹隽秀的信",
                    "text": "祝你健康。"
                }
            ]
        },
        {
            "id": "7051321",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132101",
                    "speaker": "Player",
                    "text": "字迹工整的信"
                },
                {
                    "id": "705132102",
                    "speaker": "字迹工整的信",
                    "text": "迪卢克先生亲启："
                },
                {
                    "id": "705132103",
                    "speaker": "字迹工整的信",
                    "text": "很高兴能与你一同探讨有关地脉的问题。"
                },
                {
                    "id": "705132104",
                    "speaker": "字迹工整的信",
                    "text": "如你所知，我的主要研究领域是炼金术，对地脉了解不深，只能简单谈谈个人理解。"
                },
                {
                    "id": "705132105",
                    "speaker": "字迹工整的信",
                    "text": "据各种已有文献表明，地脉可以被视为一种信息载体，其会在特定状态下开始记录周边事象。"
                },
                {
                    "id": "705132106",
                    "speaker": "字迹工整的信",
                    "text": "所有信息都将经历被记录到被沉淀的过程。经过一定时间后，亦可能被地脉再次释出。"
                },
                {
                    "id": "705132107",
                    "speaker": "字迹工整的信",
                    "text": "我大胆猜想，世上应该存在刺激地脉运作的办法。掌握相关手法，就可能掌控地脉记录与放出信息的时机。"
                },
                {
                    "id": "705132108",
                    "speaker": "字迹工整的信",
                    "text": "从符文及其他方面推测，一些特殊的深渊教团成员确实有极小概率能做到这种事。"
                },
                {
                    "id": "705132109",
                    "speaker": "字迹工整的信",
                    "text": "假如你认为有必要深究，这些个体也许会成为你的突破口。"
                },
                {
                    "id": "705132110",
                    "speaker": "字迹工整的信",
                    "text": "几年前我在我的一篇论文中研判过地脉流动及相关问题。论文副本已随信附上。"
                },
                {
                    "id": "705132111",
                    "speaker": "字迹工整的信",
                    "text": "希望它能解答你的疑惑。"
                }
            ]
        },
        {
            "id": "7051322",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132201",
                    "speaker": "Player",
                    "text": "字迹粗犷的信"
                },
                {
                    "id": "705132202",
                    "speaker": "字迹粗犷的信",
                    "text": "迪卢克 收："
                },
                {
                    "id": "705132203",
                    "speaker": "字迹粗犷的信",
                    "text": "最近琴给我写信了，我非常震惊，如果我没猜错，她也给你写了吧。她的问候代表骑士团全体。"
                },
                {
                    "id": "705132204",
                    "speaker": "字迹粗犷的信",
                    "text": "克利普斯老爷是个非常好的人，我个人相当认可他。听闻他遭遇这种事，我实在痛心，也深表遗憾。"
                },
                {
                    "id": "705132205",
                    "speaker": "字迹粗犷的信",
                    "text": "另外，击退魔龙一事，功劳理应属于你父亲。他付出所有换取的战果被伊洛克夺走，我无法认可。"
                },
                {
                    "id": "705132206",
                    "speaker": "字迹粗犷的信",
                    "text": "靠欺骗获取名望，于情于理我都不允许这种事发生在西风骑士团内部。"
                },
                {
                    "id": "705132207",
                    "speaker": "字迹粗犷的信",
                    "text": "我已通知琴，伊洛克需要被从严处理。等有结果，骑士团将第一时间通知你。"
                },
                {
                    "id": "705132208",
                    "speaker": "字迹粗犷的信",
                    "text": "听说你最近在外散心，很难联系。我不敢指望这封信一定能送到你手上，所以就先写到这里吧。"
                },
                {
                    "id": "705132209",
                    "speaker": "字迹粗犷的信",
                    "text": "如果送到了，那祝你身体健康，旅行途中注意安全。有什么需要尽管联系我们。"
                },
                {
                    "id": "705132210",
                    "speaker": "字迹粗犷的信",
                    "text": "希望你的鹰足够争气，让你有机会看到这封信。我亲笔所写，很难得。"
                },
                {
                    "id": "705132211",
                    "speaker": "字迹粗犷的信",
                    "text": "或许在现在的你看来，以下这句是风凉话，但希望你记得：再大的灾难也总会过去。"
                },
                {
                    "id": "705132212",
                    "speaker": "字迹粗犷的信",
                    "text": "我们在蒙德等你回来。若你愿意，随时可以回骑士团报道。（若你不愿意，当我没说。）"
                }
            ]
        },
        {
            "id": "7051323",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132301",
                    "speaker": "Player",
                    "text": "字迹灵动的信"
                },
                {
                    "id": "705132302",
                    "speaker": "字迹灵动的信",
                    "text": "莱艮芬德家的贵公子收："
                },
                {
                    "id": "705132303",
                    "speaker": "字迹灵动的信",
                    "text": "冒昧来信，你或许不记得我是谁了，但我们确实见过几次。"
                },
                {
                    "id": "705132304",
                    "speaker": "字迹灵动的信",
                    "text": "有时是在广场附近，有时是在「猎鹿人」坐邻桌，有时是在你的酒馆里…"
                },
                {
                    "id": "705132305",
                    "speaker": "字迹灵动的信",
                    "text": "你总是忙于各种事务，甚至更早些时候，你显得比后来健谈许多，常与你的兄弟朋友们相谈甚欢。"
                },
                {
                    "id": "705132306",
                    "speaker": "字迹灵动的信",
                    "text": "对那时的你来说，注意不到我也很正常。不过，我可是一直记着你这位小朋友。"
                },
                {
                    "id": "705132307",
                    "speaker": "字迹灵动的信",
                    "text": "我记得很清楚，有一回可莉跑到你家葡萄园里抓晶蝶，把整齐的葡萄架弄得一团糟…"
                },
                {
                    "id": "705132308",
                    "speaker": "字迹灵动的信",
                    "text": "你没有生气，亲自送可莉回来，还给了她几瓶新榨的葡萄汁。"
                },
                {
                    "id": "705132309",
                    "speaker": "字迹灵动的信",
                    "text": "也许你开始有一点印象了，对吗？"
                },
                {
                    "id": "705132310",
                    "speaker": "字迹灵动的信",
                    "text": "最近听可莉说，「红头发的奇怪大人好久没出现」，我十分好奇，忍不住打听了一番。"
                },
                {
                    "id": "705132311",
                    "speaker": "字迹灵动的信",
                    "text": "对于你父亲的遭遇，我深表遗憾。请节哀。"
                },
                {
                    "id": "705132312",
                    "speaker": "字迹灵动的信",
                    "text": "在我听到的故事里，人们总说你是完美高傲，锐气满满的名门骑士。"
                },
                {
                    "id": "705132313",
                    "speaker": "字迹灵动的信",
                    "text": "但我知道你比外表亲切。若非如此，你不会那样对待可莉。"
                },
                {
                    "id": "705132314",
                    "speaker": "字迹灵动的信",
                    "text": "你帮助了我的小朋友，我也想将你当作我的小朋友来对待。"
                },
                {
                    "id": "705132315",
                    "speaker": "字迹灵动的信",
                    "text": "因此我由衷祝愿，你能尽早走出阴霾，不必长久地浸泡在悲伤和懊悔中。"
                },
                {
                    "id": "705132316",
                    "speaker": "字迹灵动的信",
                    "text": "分别最令人痛苦，却也促使人成长。失去了遮雨屋檐的飞鸟，会比其他同类飞得更高远。"
                },
                {
                    "id": "705132317",
                    "speaker": "字迹灵动的信",
                    "text": "外出走走吧，游历是再合适不过的选择了。对此刻的你而言，唯有感受、观察和聆听能治愈你的心。"
                },
                {
                    "id": "705132318",
                    "speaker": "字迹灵动的信",
                    "text": "父母总期盼自己能长久地陪伴子女。天空、海洋与群星将会见证这一誓言。"
                },
                {
                    "id": "705132319",
                    "speaker": "字迹灵动的信",
                    "text": "你父亲的一切都在你身上延续。你在世间感受到的，或许也正是你父亲曾感受过的。"
                },
                {
                    "id": "705132320",
                    "speaker": "字迹灵动的信",
                    "text": "愿你能在前行的风中品味到好的事物。"
                },
                {
                    "id": "705132321",
                    "speaker": "字迹灵动的信",
                    "text": "振作起来，年轻的朋友。"
                }
            ]
        },
        {
            "id": "7051324",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132401",
                    "speaker": "Player",
                    "text": "字迹疏朗的信"
                },
                {
                    "id": "705132402",
                    "speaker": "字迹疏朗的信",
                    "text": "老爷亲启："
                },
                {
                    "id": "705132403",
                    "speaker": "字迹疏朗的信",
                    "text": "凯亚少爷请假回晨曦酒庄小住了几天。"
                },
                {
                    "id": "705132404",
                    "speaker": "字迹疏朗的信",
                    "text": "非常难得，他就住在原来那间卧室。闲暇时四处散步，还请爱德琳做了他喜欢吃的菜肴。"
                },
                {
                    "id": "705132405",
                    "speaker": "字迹疏朗的信",
                    "text": "那种感觉，让我像是回到了从前。"
                },
                {
                    "id": "705132406",
                    "speaker": "字迹疏朗的信",
                    "text": "不瞒您说，凯亚少爷出现在我们面前说要住几天时，我深感惊讶。"
                },
                {
                    "id": "705132407",
                    "speaker": "字迹疏朗的信",
                    "text": "但我们没有拒绝。我们觉得，即便您在，也不会明着反对他住下。"
                },
                {
                    "id": "705132408",
                    "speaker": "字迹疏朗的信",
                    "text": "晨曦酒庄向来算得上清净，或许是因为住在此地的人都较为安分。"
                },
                {
                    "id": "705132409",
                    "speaker": "字迹疏朗的信",
                    "text": "…房屋，总是跟着人的氛围走。凯亚少爷难得来一回，倒是让这里热闹了几分。"
                },
                {
                    "id": "705132410",
                    "speaker": "字迹疏朗的信",
                    "text": "愿您旅行在外也能过得好。酒庄所有人都很想念您。"
                },
                {
                    "id": "705132411",
                    "speaker": "字迹疏朗的信",
                    "text": "请务必平安健康。"
                }
            ]
        },
        {
            "id": "7051325",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705132501",
                    "speaker": "Player",
                    "text": "方才的来信"
                },
                {
                    "id": "705132502",
                    "speaker": "方才的来信",
                    "text": "诰告「暗夜英雄」，骑士团已在蒙德各地加强警戒，而且没有明显的调动，不会引发深渊教团的警觉。"
                },
                {
                    "id": "705132503",
                    "speaker": "方才的来信",
                    "text": "我正在龙脊雪山一带侦察，这里的魔物较为零散，并没有被深渊教团集结。"
                },
                {
                    "id": "705132504",
                    "speaker": "方才的来信",
                    "text": "蒙德南部也没有敌人活动的迹象。"
                },
                {
                    "id": "705132505",
                    "speaker": "方才的来信",
                    "text": "如果你确认其他方向也没有魔物，那就可以确认了，这次的地脉异常与深渊教团无关。"
                }
            ]
        },
        {
            "id": "7051610",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161001",
                    "speaker": "「致代理团长」的信",
                    "text": "琴亲启："
                },
                {
                    "id": "705161002",
                    "speaker": "「致代理团长」的信",
                    "text": "衷心感谢代理团长的关心。你说得不错，我或将不再对那件事耿耿于怀。"
                },
                {
                    "id": "705161003",
                    "speaker": "「致代理团长」的信",
                    "text": "惩办渎职的伊洛克，其本质是纠正骑士团过去的错误。对骑士团本身意义重大。"
                },
                {
                    "id": "705161004",
                    "speaker": "「致代理团长」的信",
                    "text": "至于我的个人安全，暂时还无需骑士团操心。骑士团应当将人力用在刀刃上，照顾那些需要帮助的人。"
                },
                {
                    "id": "705161005",
                    "speaker": "「致代理团长」的信",
                    "text": "也祝你身体健康。"
                }
            ]
        },
        {
            "id": "7051611",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161101",
                    "speaker": "「致阿贝多先生」的信",
                    "text": "阿贝多亲启："
                },
                {
                    "id": "705161102",
                    "speaker": "「致阿贝多先生」的信",
                    "text": "感谢你详尽的说明。我已拜读你的论文，内容详实易懂，是不可多得的优秀文献。"
                },
                {
                    "id": "705161103",
                    "speaker": "「致阿贝多先生」的信",
                    "text": "相关信息我都记录下了，但愿日后能用到。"
                },
                {
                    "id": "705161104",
                    "speaker": "「致阿贝多先生」的信",
                    "text": "预防危机是项相当重要的技术。我会继续留意深渊教团，必要时动用武力。"
                }
            ]
        },
        {
            "id": "7051612",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161201",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "法尔伽团长亲启："
                },
                {
                    "id": "705161202",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "我由衷地感谢您能关心并慰问这些事。父亲如能知道，一定也会为您的赞许感到光荣。"
                },
                {
                    "id": "705161203",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "没有什么比受到北风骑士的认可更值得他高兴了。"
                },
                {
                    "id": "705161204",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "我正在旅途中，非常幸运，顺利收到了您的来信。"
                },
                {
                    "id": "705161205",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "不出意外的话，我应该不会回骑士团。但过去的经历我不会忘记。骑士团教会我的事，我也谨记在心。"
                },
                {
                    "id": "705161206",
                    "speaker": "「致法尔伽团长」的信",
                    "text": "祝您身体健康。"
                }
            ]
        },
        {
            "id": "7051613",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161301",
                    "speaker": "Player",
                    "text": "（这块砖…似乎有点奇怪？）"
                },
                {
                    "id": "705161302",
                    "speaker": "Player",
                    "text": "取下墙砖"
                },
                {
                    "id": "705161303",
                    "speaker": "Player",
                    "text": "（这是…暗格？里面有个匣子…）"
                },
                {
                    "id": "705161304",
                    "speaker": "Player",
                    "text": "打开匣子"
                },
                {
                    "id": "705161305",
                    "speaker": "暗格中的神秘匣子",
                    "text": "匣中的物品似乎都有些年头了。其中有张纸片十分显眼。"
                },
                {
                    "id": "705161306",
                    "speaker": "暗格中的神秘匣子",
                    "text": "它被烧掉了一块，剩余部分看起来就像是从火堆里抢救出来的残渣。"
                },
                {
                    "id": "705161307",
                    "speaker": "暗格中的神秘匣子",
                    "text": "纸上，每两行内容都完全相同。看笔迹似乎是有个孩子先写了一遍，某位大人又握着孩子的手再教了一遍。"
                },
                {
                    "id": "705161308",
                    "speaker": "暗格中的神秘匣子",
                    "text": "所写内容如下：「…务必记得，独眼的王者伊尔明失能之后，是不流有王血的亚尔伯里奇一族挺身而出，暂任摄政。」"
                },
                {
                    "id": "705161309",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「虽无法使坎瑞亚起死回生，可我亚尔伯里奇一族的生命应是瞬息辉煌的烈焰，而非黯淡苟活的余烬。」"
                },
                {
                    "id": "705161310",
                    "speaker": "暗格中的神秘匣子",
                    "text": "将纸张翻过来，背面还有别的字，应该是批注之类的东西。"
                },
                {
                    "id": "705161311",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「趁『父亲』不注意从火堆中抢回的唯一纪念。我违背了原则，有关家族的事本不该被记录下来。」"
                },
                {
                    "id": "705161312",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「于我，这张纸不能成为任何身份证明，无法支撑我去往任何地方。」"
                },
                {
                    "id": "705161313",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「如今看来，他的笔迹也如行将燃尽的火焰一般悲戚。生活在蒙德的我，是无法写出那种笔迹的。」"
                },
                {
                    "id": "705161314",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "705161315",
                    "speaker": "暗格中的神秘匣子",
                    "text": "拿开纸张，底下还有只布袋，里面是一只陈旧的眼罩。旁边附有标签纸，其上的文字是："
                },
                {
                    "id": "705161316",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「没想到从前假装独眼海盗骗人，终有一日自己也伤了一只眼。」"
                },
                {
                    "id": "705161317",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「我从没有责怪迪卢克的意思。选在义父去世那日吐露实情，发生纠纷也很正常。这都是我自找的。」"
                },
                {
                    "id": "705161318",
                    "speaker": "暗格中的神秘匣子",
                    "text": "「他好像当真了。不过我没有真瞎，骗了他好一阵子…也好，就这样继续下去吧。」"
                },
                {
                    "id": "705161319",
                    "speaker": "暗格中的神秘匣子",
                    "text": "布袋下方摆着两封信，署名都是「D」。信件被保存得非常好，背面标有时间，应该是收信的日子。"
                },
                {
                    "id": "705161320",
                    "speaker": "暗格中的神秘匣子",
                    "text": "信上的字迹潇洒有力又不失华美。",
                    "choices": [
                        {
                            "id": "705161321",
                            "text": "阅读第一封来信。",
                            "response": [
                                {
                                    "id": "705161322",
                                    "speaker": "「致『K』」的信·其一",
                                    "text": "给K："
                                },
                                {
                                    "id": "705161323",
                                    "speaker": "「致『K』」的信·其一",
                                    "text": "知道了，感谢你的来信。"
                                },
                                {
                                    "id": "705161324",
                                    "speaker": "「致『K』」的信·其一",
                                    "text": "另外，不建议你在写给我的信里提什么眼睛。别以为我不知道你右眼没瞎。"
                                },
                                {
                                    "id": "705161330",
                                    "speaker": "暗格中的神秘匣子",
                                    "text": "在这两封信的旁边，还有一个小小的纸包。打开后是几只贝壳。"
                                },
                                {
                                    "id": "705161331",
                                    "speaker": "暗格中的神秘匣子",
                                    "text": "贝壳表面光泽并不明显，也不知是经过了多久的时光。"
                                },
                                {
                                    "id": "705161332",
                                    "speaker": "Player",
                                    "text": "（……）"
                                },
                                {
                                    "id": "705161333",
                                    "speaker": "Player",
                                    "text": "（还是收好这个匣子，把一切恢复原样吧。）"
                                }
                            ]
                        },
                        {
                            "id": "705161325",
                            "text": "阅读第二封来信。",
                            "response": [
                                {
                                    "id": "705161326",
                                    "speaker": "「致『K』」的信·其二",
                                    "text": "给K："
                                },
                                {
                                    "id": "705161327",
                                    "speaker": "「致『K』」的信·其二",
                                    "text": "感谢你的来信。"
                                },
                                {
                                    "id": "705161328",
                                    "speaker": "「致『K』」的信·其二",
                                    "text": "与骑士团合作一事客观有利，自然也会有弊，就像硬币的正反面。相信你比我更明白这一点。"
                                },
                                {
                                    "id": "705161329",
                                    "speaker": "「致『K』」的信·其二",
                                    "text": "安全问题无需担忧。自保不难，难的永远是向外推进目标。还是照顾好你自己吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051614",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161401",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "艾莉丝女士亲启："
                },
                {
                    "id": "705161402",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "必须承认，我在阅读信件开头时，没有想到这封信出自您之手。"
                },
                {
                    "id": "705161403",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "或许有许多次您就近在我身旁，只是我没能注意到。我为我的疏忽向您致歉。"
                },
                {
                    "id": "705161404",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "曾有耳闻，您是非常厉害的魔女，即使没有我，可莉也一定能安全返回家中。"
                },
                {
                    "id": "705161405",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "即便如此，您却依然为我寄来这封信。对此我唯有感谢。"
                },
                {
                    "id": "705161406",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "如您所说，旅行是眼下最好的选择。我会依照您所说，去感受世间的一切。"
                },
                {
                    "id": "705161407",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "父亲那份意志，将在我的生活中延续下去。"
                },
                {
                    "id": "705161408",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "我不在的这段时间，也欢迎可莉到晨曦酒庄做客。爱德琳会准备足够多的点心和葡萄汁，期待小客人光临。若您不嫌弃，也请一起。"
                },
                {
                    "id": "705161409",
                    "speaker": "「致艾莉丝女士」的信",
                    "text": "祝您和可莉身体健康。"
                }
            ]
        },
        {
            "id": "7051615",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705161501",
                    "speaker": "派蒙",
                    "text": "这些信件里谈论的事情好像不止一件，原来以前发生过这么多复杂的事啊…"
                },
                {
                    "id": "705161502",
                    "speaker": "派蒙",
                    "text": "想要搞清楚事情的来龙去脉，的确要仔细推敲细节呢。"
                },
                {
                    "id": "705161503",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你还要读哪一封信呢？"
                }
            ]
        }
    ]
}