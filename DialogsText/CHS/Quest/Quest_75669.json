    "talks": [
        {
            "id": "7566901",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "756690101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你来你来，有些好东西要给你看。"
                },
                {
                    "id": "756690102",
                    "speaker": "派蒙",
                    "text": "你看，这些都是我在旅行路上拍的哦。"
                },
                {
                    "id": "756690103",
                    "speaker": "派蒙",
                    "text": "我们又走过了好多地方，在你四处探路的时候，我也没有闲着。"
                },
                {
                    "id": "756690104",
                    "speaker": "派蒙",
                    "text": "喏，这些都是我拿自己的留影机拍下的画片。"
                },
                {
                    "id": "756690105",
                    "speaker": "派蒙",
                    "text": "对了，你还记得我们在达莫维百货买过两本留影册吗？",
                    "choices": [
                        {
                            "id": "756690106",
                            "text": "记得。",
                            "response": [
                                {
                                    "id": "756690107",
                                    "speaker": "派蒙",
                                    "text": "我就知道你还记得，当时我可是提前好久、拿出攒了好久的零钱才预订到那两本留影册。"
                                },
                                {
                                    "id": "756690111",
                                    "speaker": "派蒙",
                                    "text": "那两本留影册咱们两个人一人一本，款式一样。"
                                },
                                {
                                    "id": "756690112",
                                    "speaker": "派蒙",
                                    "text": "我的那本里已经攒了好厚好厚的一摞画片，不知道你的那本有没有拍满。"
                                },
                                {
                                    "id": "756690113",
                                    "speaker": "派蒙",
                                    "text": "我刚买了一本新的留影册，本来打算留作备用的，但如果你的留影册已经拍满了，就拿去用吧。",
                                    "choices": [
                                        {
                                            "id": "756690114",
                                            "text": "派蒙喜欢留影吗？",
                                            "response": [
                                                {
                                                    "id": "756690115",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，你想，我们一起走过了那么多地方，看过了那么多普通人想都不敢想的风景。"
                                                },
                                                {
                                                    "id": "756690116",
                                                    "speaker": "派蒙",
                                                    "text": "如果不留一些纪念下来，就太可惜了吧。"
                                                },
                                                {
                                                    "id": "756690121",
                                                    "speaker": "派蒙",
                                                    "text": "而且，更重要的是，这是我们两个人的重要回忆。"
                                                },
                                                {
                                                    "id": "756690122",
                                                    "speaker": "派蒙",
                                                    "text": "过去的回忆和未来的经历都要好好珍惜，这句话是嵴锋龙部落的帕加尔大叔跟我说的，很有道理吧。"
                                                },
                                                {
                                                    "id": "756690123",
                                                    "speaker": "派蒙",
                                                    "text": "这次，我就再把自己的留影机借给你，再多留下一些画片好了。"
                                                },
                                                {
                                                    "id": "756690124",
                                                    "speaker": "派蒙",
                                                    "text": "马上就要踏上至冬的领土了，我总有种预感，下一段旅程可能不会很轻松。"
                                                },
                                                {
                                                    "id": "756690125",
                                                    "speaker": "派蒙",
                                                    "text": "在那之前，好好地整理一下我们一路旅行感受到的东西吧。"
                                                },
                                                {
                                                    "id": "756690126",
                                                    "speaker": "派蒙",
                                                    "text": "这样不管碰到什么困难，只要想起我们共同经历的点点滴滴，一定会充满勇气的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756690117",
                                            "text": "派蒙真大度！",
                                            "response": [
                                                {
                                                    "id": "756690118",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，那还用说，全提瓦特最好的向导派蒙身上可不只有大度这一种优秀品质。"
                                                },
                                                {
                                                    "id": "756690119",
                                                    "speaker": "派蒙",
                                                    "text": "特意多买一本留影册其实也是因为我喜欢留影嘛。"
                                                },
                                                {
                                                    "id": "756690120",
                                                    "speaker": "派蒙",
                                                    "text": "我们一起旅行的路上见过了那么多特别的风景，不留下点纪念实在太可惜了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756690108",
                            "text": "不记得了。",
                            "response": [
                                {
                                    "id": "756690109",
                                    "speaker": "派蒙",
                                    "text": "欸，居然不记得了吗？当时我可是提前好久、拿出攒了好久的零钱才预订到。"
                                },
                                {
                                    "id": "756690110",
                                    "speaker": "派蒙",
                                    "text": "算啦，你每天要操心的事也挺多的，宽容大度的向导派蒙我不会介意。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}