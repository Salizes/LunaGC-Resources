        {
            "id": "7006803",
            "objective": "(test)和幸存者B对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "700671001",
                    "speaker": "维特鲁威",
                    "text": "维尼皮！你还活着，太好了！"
                },
                {
                    "id": "700671002",
                    "speaker": "维特鲁威",
                    "text": "当然我知道这里死不掉。我意思是你没有变成沙子，这实在太好了。"
                },
                {
                    "id": "700671003",
                    "speaker": "维特鲁威",
                    "text": "总之，你懂我意思就好。"
                },
                {
                    "id": "700671004",
                    "speaker": "维尼皮",
                    "text": "我懂。"
                },
                {
                    "id": "700671005",
                    "speaker": "维特鲁威",
                    "text": "还有你们几位和小右，十分感谢。"
                },
                {
                    "id": "700671006",
                    "speaker": "彩特琳德",
                    "text": "我什么都没做。"
                },
                {
                    "id": "700671007",
                    "speaker": "Black Screen",
                    "text": "维尼皮和维特鲁威介绍了一下你们，并且说了刚才发生的事情…"
                },
                {
                    "id": "700671008",
                    "speaker": "维特鲁威",
                    "text": "竟然是标准首席百夫长以上的实力！"
                },
                {
                    "id": "700671009",
                    "speaker": "派蒙",
                    "text": "连我也开始对你战斗力的定级最终会是什么结果感兴趣了。"
                },
                {
                    "id": "700671010",
                    "speaker": "Player",
                    "text": "是吧是吧。"
                },
                {
                    "id": "700671011",
                    "speaker": "维特鲁威",
                    "text": "那既然这样，我来带你们去找其他人吧。"
                },
                {
                    "id": "700671012",
                    "speaker": "维特鲁威",
                    "text": "毕竟维尼皮只提供了赤王时代的建筑的纹样与装饰风格。这附近的大结构和路线是我负责的。"
                },
                {
                    "id": "700671013",
                    "speaker": "维尼皮",
                    "text": "没错，虽然看起来像是镀金时代的建筑，其实它集结了所有人的知识。"
                }
            ]
        },
