    "talks": [
        {
            "id": "7418601",
            "objective": "(test)到达竞技场外围$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418602",
            "objective": "(test)石像怪战斗$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418603",
            "objective": "(test)与石像对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741860301",
                    "speaker": "无名的魔像",
                    "text": "卡西奥多大人，卡西奥多大人…是您吗？"
                },
                {
                    "id": "741860302",
                    "speaker": "小呜斯",
                    "text": "……"
                },
                {
                    "id": "741860303",
                    "speaker": "无名的魔像",
                    "text": "没错了，果然是您，您终于回来了…"
                },
                {
                    "id": "741860304",
                    "speaker": "无名的魔像",
                    "text": "我奉命把守这座要塞，但是那些残虐的龙蜥与蛮族的攻势实在太猛，我才只能一退再退来到了这里。"
                },
                {
                    "id": "741860305",
                    "speaker": "无名的魔像",
                    "text": "从那以后似乎过去了很多很多年…外面的情况怎么样了，我们胜利了吗？"
                },
                {
                    "id": "741860306",
                    "speaker": "小呜斯",
                    "text": "……"
                },
                {
                    "id": "741860307",
                    "speaker": "无名的魔像",
                    "text": "…是吗，那么是我们输了。"
                },
                {
                    "id": "741860308",
                    "speaker": "小呜斯",
                    "text": "我很抱歉…"
                },
                {
                    "id": "741860309",
                    "speaker": "无名的魔像",
                    "text": "您别这样说，尊贵的大人。在我加入至尊的军团之时，便曾想过会有这样一天。"
                },
                {
                    "id": "741860310",
                    "speaker": "无名的魔像",
                    "text": "至尊曾说，要带领我们砸碎「法图纳」的镣铐。但事情又怎会这样容易呢？"
                },
                {
                    "id": "741860311",
                    "speaker": "无名的魔像",
                    "text": "毕竟我们对抗的可是命运，而命运是连伟大的神明都无法违抗的。"
                },
                {
                    "id": "741860312",
                    "speaker": "小呜斯",
                    "text": "最后，一切的努力都是徒劳…"
                },
                {
                    "id": "741860313",
                    "speaker": "无名的魔像",
                    "text": "不，大人。我们曾向天命举起刀剑，我们创造的事业挑战了高天的律法。面对那个预言，我们奋起反抗…"
                },
                {
                    "id": "741860314",
                    "speaker": "无名的魔像",
                    "text": "虽然我们还是失败了…一定是有人背叛了我们，才使我们走上了歧途…"
                },
                {
                    "id": "741860315",
                    "speaker": "无名的魔像",
                    "text": "但结果已经不重要了，无论如何，我们都会铭刻在世界的「历史」之上…"
                },
                {
                    "id": "741860316",
                    "speaker": "派蒙",
                    "text": "喂，他怎么倒下了，石头人也会像这样突然失去意识吗？"
                },
                {
                    "id": "741860317",
                    "speaker": "小呜斯",
                    "text": "我还不知道他的名字…看上去，他的「历史」已经终结了。"
                },
                {
                    "id": "741860318",
                    "speaker": "派蒙",
                    "text": "也太可怜了，他就这样在这里战斗了数千年吗？"
                },
                {
                    "id": "741860319",
                    "speaker": "小呜斯",
                    "text": "但现在，他终于能得享安宁了，我们继续前进吧。"
                }
            ]
        },
