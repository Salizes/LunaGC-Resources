            "dialogues": []
        },
        {
            "id": "7106003",
            "objective": "隐藏计时天数$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7105911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710591101",
                    "speaker": "卡塔琳娜",
                    "text": "怎么？专门来打扰我休息吗？"
                },
                {
                    "id": "710591102",
                    "speaker": "派蒙",
                    "text": "没有啦，我们就是看你一个人在这里怪孤单的，想跟你聊聊天而已！",
                    "choices": [
                        {
                            "id": "710591103",
                            "text": "一个人喝酒很无聊吧？",
                            "response": [
                                {
                                    "id": "710591105",
                                    "speaker": "卡塔琳娜",
                                    "text": "…这样吗？谢谢你们。你们这副样子呀…让我想起柳达希卡那家伙。"
                                },
                                {
                                    "id": "710591106",
                                    "speaker": "卡塔琳娜",
                                    "text": "她也是个热心人…那时候总是缠在我身边，什么话都愿意和我说…很多时候只愿意和我说。"
                                },
                                {
                                    "id": "710591107",
                                    "speaker": "卡塔琳娜",
                                    "text": "唉，如果柳达希卡也在就好咯…她是个很有趣的人，你一定会喜欢她的。",
                                    "choices": [
                                        {
                                            "id": "710591108",
                                            "text": "柳达希卡？那是谁？",
                                            "response": [
                                                {
                                                    "id": "710591109",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "她呀…我的一个朋友，看起来很严肃的样子，其实是个有趣的笨蛋。"
                                                },
                                                {
                                                    "id": "710591110",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "曾经在「壁炉之家」的时候我们就像姐妹一样要好…可能更胜姐妹吧。她很喜欢我的捉弄…我也很受她照顾。"
                                                },
                                                {
                                                    "id": "710591111",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "哈哈，总之，我预感她在外面过得还不错。每每想到这点，我在这个鬼地方受的伤就都不算什么啦。"
                                                },
                                                {
                                                    "id": "710591112",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "希望她也有在好好执行任务吧…希望她不要想起我。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710591113",
                                            "text": "柳达希卡…你是说稻妻的那个…",
                                            "response": [
                                                {
                                                    "id": "710591114",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "710591115",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "这么说，她暴露了啊…"
                                                },
                                                {
                                                    "id": "710591116",
                                                    "speaker": "派蒙",
                                                    "text": "欸…你怎么知道…",
                                                    "choices": [
                                                        {
                                                            "id": "710591117",
                                                            "text": "她…设法逃出生天了。",
                                                            "response": [
                                                                {
                                                                    "id": "710591119",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "是吗？"
                                                                },
                                                                {
                                                                    "id": "710591120",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "哈哈…那就好，希望她也在好好执行任务吧。"
                                                                },
                                                                {
                                                                    "id": "710591121",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "但假如她为了苟且偷生，违背了女皇陛下的意志…"
                                                                },
                                                                {
                                                                    "id": "710591122",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "…希望她不要想起我。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710591118",
                                                            "text": "她还活着，过得很好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710591104",
                            "text": "我们特地来陪你说说话。"
                        }
                    ]
                }
            ]
        },
