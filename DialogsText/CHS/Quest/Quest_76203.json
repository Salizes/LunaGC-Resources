    "talks": [
        {
            "id": "7620308",
            "objective": "前往魔女的小屋",
            "dialogues": []
        },
        {
            "id": "7620301",
            "objective": "与尼可对话",
            "dialogues": [
                {
                    "id": "762030101",
                    "speaker": "尼可",
                    "text": "噢，你们来了！我还想着需不需要给你们什么更明显的指引呢…"
                },
                {
                    "id": "762030102",
                    "speaker": "尼可",
                    "text": "但又想到提示太显眼，反而容易打断你们的旅行计划…"
                },
                {
                    "id": "762030103",
                    "speaker": "尼可",
                    "text": "就在我这么犹豫的时候，你们像及时雨般出现了，可以说是皆大欢喜！"
                },
                {
                    "id": "762030104",
                    "speaker": "派蒙",
                    "text": "你好呀，尼可，你看起来精神真好！而且…今天也很健谈呢。"
                },
                {
                    "id": "762030105",
                    "speaker": "尼可",
                    "text": "那我就当作赞美收下了。好了，来下一个房间看看吧。"
                }
            ]
        },
        {
            "id": "7620309",
            "objective": "进入房间",
            "dialogues": []
        },
        {
            "id": "7620302",
            "objective": "查看画框",
            "dialogues": [
                {
                    "id": "762030201",
                    "speaker": "派蒙",
                    "text": "呃啊，吓我一跳！突然就被吸进画里了。等等，这场景好眼熟…是魔女们聚会的长桌！"
                },
                {
                    "id": "762030202",
                    "speaker": "尼可",
                    "text": "——具体就要从我第一次被艾莉丝邀请参加茶会的时候说起了。"
                },
                {
                    "id": "762030203",
                    "speaker": "尼可",
                    "text": "不过，当天我并没有亲自出席，因为那时的我都没有想好要不要正式加入魔女会。"
                },
                {
                    "id": "762030204",
                    "speaker": "尼可",
                    "text": "在场众人只有艾莉丝知道我的真实身份，她事先提醒我不要说话，不要暴露马脚，默默观察大家就行。"
                },
                {
                    "id": "762030205",
                    "speaker": "派蒙",
                    "text": "后来呢？"
                },
                {
                    "id": "762030206",
                    "speaker": "尼可",
                    "text": "…后来我认定那是对我的犹豫的报复。"
                },
                {
                    "id": "762030207",
                    "speaker": "尼可",
                    "text": "大家的聊天内容那么有趣，怎么能忍住不插话呢？"
                },
                {
                    "id": "762030208",
                    "speaker": "尼可",
                    "text": "聊着聊着有人抛出了一个你明确知道答案的问题，又怎么能忍住不分享呢？"
                },
                {
                    "id": "762030209",
                    "speaker": "尼可",
                    "text": "这就要说起艾莉丝和芭比洛斯的赌局，莱茵多特禁忌的创造，伊万诺夫娜的政治手腕…"
                },
                {
                    "id": "762030210",
                    "speaker": "尼可",
                    "text": "简直是一幕幕浓缩在茶杯之中的美妙戏剧，光凭言语就触动了我想要揭示真相的本能。"
                },
                {
                    "id": "762030211",
                    "speaker": "派蒙",
                    "text": "那你在大家脑袋里说话了吗？"
                },
                {
                    "id": "762030212",
                    "speaker": "尼可",
                    "text": "怎么会呢，就算憋闷到呼吸困难，我也仍然是一名负责任的天使，知道「想说」和「能说」之间的区别。"
                },
                {
                    "id": "762030213",
                    "speaker": "尼可",
                    "text": "所以到了最后，我也只是私底下找艾莉丝一口气说了个痛快，顺便答应了加入魔女会的事。"
                },
                {
                    "id": "762030214",
                    "speaker": "尼可",
                    "text": "她对后者接受得很快，但前者嘛…她说她那几天脑袋疼到去璃月找大夫了，可这也不能全怪我呀！"
                }
            ]
        },
        {
            "id": "7620311",
            "objective": "查看画框",
            "dialogues": []
        },
        {
            "id": "7620303",
            "objective": "查看画框",
            "dialogues": [
                {
                    "id": "762030301",
                    "speaker": "派蒙",
                    "text": "银白古树？"
                },
                {
                    "id": "762030302",
                    "speaker": "尼可",
                    "text": "噢，是这幅画，你们对白树已经不算陌生了，不过你们是否知道，最初天使的背叛就是在白树下？",
                    "choices": [
                        {
                            "id": "762030303",
                            "text": "不太了解。",
                            "response": [
                                {
                                    "id": "762030305",
                                    "speaker": "派蒙",
                                    "text": "我有点好奇。"
                                },
                                {
                                    "id": "762030306",
                                    "speaker": "尼可",
                                    "text": "嗯，那就久违地讲一个恐怖爱情故事好了。让我保留一下当事人隐私…有了！"
                                },
                                {
                                    "id": "762030307",
                                    "speaker": "尼可",
                                    "text": "#很久很久以前，有一位漫行于星间的旅者——和{NICKNAME}很不一样，说来话长。"
                                },
                                {
                                    "id": "762030308",
                                    "speaker": "尼可",
                                    "text": "一天，他前往银树之下拜访晨星的公主，不出片刻就向她询问起了王国最为禁忌的机密。"
                                },
                                {
                                    "id": "762030309",
                                    "speaker": "尼可",
                                    "text": "他的言语令公主疑惑：他怎么会知道那些不被神明许可之事呢？"
                                },
                                {
                                    "id": "762030310",
                                    "speaker": "尼可",
                                    "text": "少年袒露了他的来历，同时展现的还有公主从未见过的，自由意志与崇高的精神之爱。"
                                },
                                {
                                    "id": "762030311",
                                    "speaker": "尼可",
                                    "text": "他的话语点醒了公主被神明禁锢的自我，她的心飞扬起来，越过了从未跨越的藩篱…"
                                },
                                {
                                    "id": "762030312",
                                    "speaker": "尼可",
                                    "text": "晨星公主向少年倾吐了王国的秘密，二人之间不仅萌生爱意，更萌生了反抗神明的决心。"
                                },
                                {
                                    "id": "762030313",
                                    "speaker": "派蒙",
                                    "text": "到这里为止，还算是个标准的爱情故事吧？"
                                },
                                {
                                    "id": "762030314",
                                    "speaker": "尼可",
                                    "text": "恐怖的部分马上就到。他们渴望帮助民众获得不被束缚的自由生命，但这种背叛不被神明容赦。"
                                },
                                {
                                    "id": "762030315",
                                    "speaker": "尼可",
                                    "text": "神明降下雷霆与怒火，毁灭了他们的居所。而当大战平息后，公主永远地失去了她的力量与智慧…"
                                },
                                {
                                    "id": "762030316",
                                    "speaker": "尼可",
                                    "text": "甚至就连那些曾与她亲近的朋友，也被一并烙下了诅咒…"
                                },
                                {
                                    "id": "762030317",
                                    "speaker": "派蒙",
                                    "text": "呃…结尾的部分好吓人啊…"
                                },
                                {
                                    "id": "762030318",
                                    "speaker": "派蒙",
                                    "text": "但我们先前是从最初的天使聊到这个故事的？你说的该不会是真事吧…"
                                },
                                {
                                    "id": "762030319",
                                    "speaker": "尼可",
                                    "text": "嗯哼，没错，那才是最吓人的部分。"
                                },
                                {
                                    "id": "762030320",
                                    "speaker": "尼可",
                                    "text": "嗯，那就久违地讲一个恐怖爱情故事好了。"
                                },
                                {
                                    "id": "762030321",
                                    "speaker": "尼可",
                                    "text": "让我保留一下当事人隐私…"
                                },
                                {
                                    "id": "762030322",
                                    "speaker": "尼可",
                                    "text": "有了！"
                                }
                            ]
                        },
                        {
                            "id": "762030304",
                            "text": "好像听说过…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7620312",
            "objective": "查看画框",
            "dialogues": []
        },
        {
            "id": "7620304",
            "objective": "查看画框",
            "dialogues": [
                {
                    "id": "762030401",
                    "speaker": "派蒙",
                    "text": "噢！是希穆兰卡！呃…地上怎么还有八重堂的轻小说？"
                },
                {
                    "id": "762030402",
                    "speaker": "尼可",
                    "text": "说到我写作的启蒙，自然是我敬爱的安雅女士。"
                },
                {
                    "id": "762030403",
                    "speaker": "尼可",
                    "text": "她是最晚加入魔女会的一位，却也是离开最早的那个…"
                },
                {
                    "id": "762030404",
                    "speaker": "尼可",
                    "text": "我喜欢她的每一个故事。无论那是一个点子，还是一篇成稿，安雅都是那么擅长为读者带来惊喜。"
                },
                {
                    "id": "762030405",
                    "speaker": "尼可",
                    "text": "魔女会离不开谈论魔法，我想安雅掌握着一种独特的魔法，能将爱与关怀编织成感染他人的文字，或是精彩的情节。"
                },
                {
                    "id": "762030406",
                    "speaker": "尼可",
                    "text": "我向她请教过，怎么写好一个故事之类的，技巧学了不少，但到头来我最大的敌人还是我自己。"
                },
                {
                    "id": "762030407",
                    "speaker": "Player",
                    "text": "懒得动笔吗？"
                },
                {
                    "id": "762030408",
                    "speaker": "尼可",
                    "text": "是啦，就是这个意思。直接沟通思想实在太方便了，即使是天使也会有惰性的啊。"
                },
                {
                    "id": "762030409",
                    "speaker": "尼可",
                    "text": "不过，最近我决定稍微努力一下，省得我的某位仙灵故交见面时总爱抱怨我。"
                },
                {
                    "id": "762030410",
                    "speaker": "派蒙",
                    "text": "噢噢！终于要看到尼可亲笔写的小说了吗？"
                },
                {
                    "id": "762030411",
                    "speaker": "尼可",
                    "text": "谁说要动笔了。只是买来最近几百年热门的作品随便读一读而已。"
                },
                {
                    "id": "762030412",
                    "speaker": "尼可",
                    "text": "是啦，就是这个意思。"
                },
                {
                    "id": "762030413",
                    "speaker": "尼可",
                    "text": "直接沟通思想实在太方便了。"
                },
                {
                    "id": "762030414",
                    "speaker": "尼可",
                    "text": "即使是天使也会有惰性的啊。"
                }
            ]
        },
        {
            "id": "7620310",
            "objective": "与尼可对话",
            "dialogues": []
        },
        {
            "id": "7620307",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
            "id": "7620305",
            "objective": "与尼可对话",
            "dialogues": [
                {
                    "id": "762030501",
                    "speaker": "尼可",
                    "text": "这些画作纪念着我心中的意义非凡之地，这样一来，画室就全部复原了。"
                },
                {
                    "id": "762030502",
                    "speaker": "尼可",
                    "text": "领取我们的报酬吧，怎么？看我干什么？当然是「我们」的。"
                },
                {
                    "id": "762030503",
                    "speaker": "尼可",
                    "text": "你不会放着宝箱不开吧？那我可不能让你出去了。再说，我说了那么多故事，总该奖励我一下吧？"
                }
            ]
        },
        {
            "id": "7620306",
            "objective": "开启宝箱",
            "dialogues": [
                {
                    "id": "762030601",
                    "speaker": "尼可",
                    "text": "喔噢，还有东西没拿哦！"
                }
            ]
        },
        {
            "id": "7620314",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762031401",
                    "speaker": "尼可",
                    "text": "仔细想想…这座魔女小屋对我来说也很有特殊意义。屋中画，画中屋…嵌套结构？有点意思…"
                }
            ]
        },
        {
            "id": "7620399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762039901",
                    "speaker": "派蒙",
                    "text": "这是尼可的画室吗？但怎么四周只有白墙和画框？我们走近点多观察一下吧。"
                },
                {
                    "id": "762039902",
                    "speaker": "派蒙",
                    "text": "我们去看看别的画框吧，让我也缓缓…"
                },
                {
                    "id": "762039903",
                    "speaker": "尼可",
                    "text": "喔噢，还有东西没拿哦！"
                },
                {
                    "id": "762039904",
                    "speaker": "尼可",
                    "text": "好啦，有始有终的皆大欢喜！我们下次再见。"
                }
            ]
        }
    ]
}