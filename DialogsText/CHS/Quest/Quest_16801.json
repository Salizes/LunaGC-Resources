    "talks": [
        {
            "id": "1680102",
            "objective": "医生$HIDDEN",
            "dialogues": [
                {
                    "id": "698571001",
                    "speaker": "雅珂达",
                    "text": "叶洛亚，你真的不能和我一起偷偷摸摸到怪物背后偷袭，把它们全部打倒吗？"
                },
                {
                    "id": "698571002",
                    "speaker": "雅珂达",
                    "text": "我一轮可以行动三次欸，总共就四个怪物，我打倒三个，你打倒一个就行。"
                },
                {
                    "id": "698571003",
                    "speaker": "叶洛亚",
                    "text": "我可以正面吸引怪物的注意力，但偷袭…"
                },
                {
                    "id": "698571004",
                    "speaker": "娜维娅",
                    "text": "唉，这也是没办法的事。毕竟叶洛亚是选了「公正之杯」的「纯水骑士」嘛。"
                },
                {
                    "id": "698571005",
                    "speaker": "「主持人」",
                    "text": "是的。如果叶洛亚选择从背后偷袭，那么就会被迫转为「弃誓骑士」，在进行所有行动时，都会附加一个巨大的减值。"
                },
                {
                    "id": "698571006",
                    "speaker": "娜维娅",
                    "text": "这下糟糕了，要是不一口气打倒所有怪物，那我们所有人都要被炸药炸飞了啊！"
                },
                {
                    "id": "698571007",
                    "speaker": "叶洛亚",
                    "text": "还有一个办法。我可以用「狂澜波」一口气冲到最深处，然后引爆炸药…"
                },
                {
                    "id": "698571008",
                    "speaker": "娜维娅",
                    "text": "不行不行，那样你的角色不就要被「除名」了嘛！大家好不容易聚起来玩得这么开心，你一个人被「除名」也太可惜了啦。"
                },
                {
                    "id": "698571009",
                    "speaker": "叶洛亚",
                    "text": "但是，如果不这样做，娜维娅小姐玩了这么久的「角色」恐怕也要被「除名」，这样不更可惜了吗？"
                },
                {
                    "id": "698571010",
                    "speaker": "雅珂达",
                    "text": "我才刚玩没多久，不要啊——"
                },
                {
                    "id": "698571011",
                    "speaker": "娜维娅",
                    "text": "呜——没关系，我还有一招。"
                },
                {
                    "id": "698571012",
                    "speaker": "克洛琳德",
                    "text": "娜维娅，把蛋卷收回去。"
                },
                {
                    "id": "698571013",
                    "speaker": "雅珂达",
                    "text": "呜哇！这一招也被防住了啊！",
                    "choices": [
                        {
                            "id": "698571014",
                            "text": "娜维娅？",
                            "response": [
                                {
                                    "id": "698571016",
                                    "speaker": "派蒙",
                                    "text": "这桌上的摆件，还有你们刚才说的话，你们这是在玩…"
                                },
                                {
                                    "id": "698571017",
                                    "speaker": "娜维娅",
                                    "text": "#救星来啦！{NICKNAME}，你来得正好！快快快，快加入我们！"
                                },
                                {
                                    "id": "698571018",
                                    "speaker": "娜维娅",
                                    "text": "克洛琳德，这样应该不算违反规则吧？"
                                },
                                {
                                    "id": "698571103",
                                    "speaker": "克洛琳德",
                                    "text": "#如果{NICKNAME}同意的话。顺便一提，为了照顾新人，我们现在玩的难度是「轻松体验」。"
                                },
                                {
                                    "id": "698571104",
                                    "speaker": "娜维娅",
                                    "text": "#{NICKNAME}，你愿意和我们继续冒险吗？肯定愿意的，对吧？",
                                    "choices": [
                                        {
                                            "id": "698571105",
                                            "text": "咦？怎么突然就——",
                                            "response": [
                                                {
                                                    "id": "698571107",
                                                    "speaker": "雅珂达",
                                                    "text": "别问啦，再问我们就要被炸药全部炸飞了啊——",
                                                    "choices": [
                                                        {
                                                            "id": "698571108",
                                                            "text": "愿、愿意！",
                                                            "response": [
                                                                {
                                                                    "id": "698571110",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "#好。但{NICKNAME}毕竟这么长时间没有游玩剧本了，可以拥有一次重新选择技能的机会。"
                                                                },
                                                                {
                                                                    "id": "698571111",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "可以修改的技能是「厨艺」和「医术」，怎么样，要修改吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698571112",
                                                                            "text": "学习「厨艺」…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698571113",
                                                                                    "speaker": "克洛琳德",
                                                                                    "text": "可以，你确定想要学习的技能是「厨艺」，对吧？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698571116",
                                                                                            "text": "确定。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698571117",
                                                                                            "text": "我再想想…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698571114",
                                                                            "text": "学习「医术」…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698571115",
                                                                                    "speaker": "克洛琳德",
                                                                                    "text": "可以，你确定想要学习的技能是「医术」，对吧？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698571116",
                                                                                            "text": "确定。"
                                                                                        },
                                                                                        {
                                                                                            "id": "698571117",
                                                                                            "text": "我再想想…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698571109",
                                                            "text": "我加入，我加入——"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698571106",
                                            "text": "继续冒险？难道是顺着上次的…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698571015",
                            "text": "还有克洛琳德？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1680103",
            "objective": "厨师$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1680105",
            "objective": "",
            "dialogues": [
                {
                    "id": "698571301",
                    "speaker": "克洛琳德",
                    "text": "好。那么游戏继续。"
                },
                {
                    "id": "698571302",
                    "speaker": "「主持人」",
                    "text": "「…就在所有人束手无策之时，一个熟悉的声音却从众人的背后响起。」",
                    "choices": [
                        {
                            "id": "698571401",
                            "text": "好久不见，各位。看来你们需要我的帮助？",
                            "response": [
                                {
                                    "id": "698571402",
                                    "speaker": "娜维娅",
                                    "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？"
                                },
                                {
                                    "id": "698571403",
                                    "speaker": "派蒙",
                                    "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）"
                                },
                                {
                                    "id": "698571404",
                                    "speaker": "Player",
                                    "text": "是、是啊…我听见了呼唤，我必须回应！"
                                },
                                {
                                    "id": "698571405",
                                    "speaker": "雅珂达",
                                    "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）"
                                },
                                {
                                    "id": "698571701",
                                    "speaker": "叶洛亚",
                                    "text": "#（不愧是{NICKNAME}，好强的代入感啊…）"
                                },
                                {
                                    "id": "698571801",
                                    "speaker": "「主持人」",
                                    "text": "「虽然逐影猎人们彼此之间还有许多话想要倾诉，但此时此刻，久别重逢的喜悦必须要让位于迫在眉睫的危机。」"
                                },
                                {
                                    "id": "698571802",
                                    "speaker": "「主持人」",
                                    "text": "那么，战斗轮继续。第一轮由你们行动。"
                                },
                                {
                                    "id": "698571803",
                                    "speaker": "「主持人」",
                                    "text": "另外。因为临时加入了新成员，所以我要为敌人的各项能力加上数张「暗卡」。"
                                },
                                {
                                    "id": "698571804",
                                    "speaker": "娜维娅",
                                    "text": "#{NICKNAME}才不是突然加入的，{M#他}{F#她}一直和我们旅行啊。"
                                },
                                {
                                    "id": "698571805",
                                    "speaker": "娜维娅",
                                    "text": "只不过…呃…突然离开了一小段时间而已…"
                                },
                                {
                                    "id": "698571806",
                                    "speaker": "「主持人」",
                                    "text": "我已经算好「暗卡」数量了。你们该商量战术了。"
                                },
                                {
                                    "id": "698571807",
                                    "speaker": "娜维娅",
                                    "text": "欸——克洛琳德好严格哦…"
                                },
                                {
                                    "id": "698571808",
                                    "speaker": "娜维娅",
                                    "text": "#那么就按照原本的战术来吧，既然有了{NICKNAME}的加入，我们的人手就足够了。"
                                },
                                {
                                    "id": "698571809",
                                    "speaker": "娜维娅",
                                    "text": "我和叶洛亚待在正面，抵挡住怪物的攻势。"
                                },
                                {
                                    "id": "698571810",
                                    "speaker": "娜维娅",
                                    "text": "#雅珂达和{NICKNAME}就绕到背后，把怪物从背后一口气全部打倒。"
                                },
                                {
                                    "id": "698571811",
                                    "speaker": "雅珂达",
                                    "text": "好嘞，交给我吧。嘿嘿，从背后攻击的时候，「炼气士」可是有着很高的伤害增强呢。"
                                },
                                {
                                    "id": "698571901",
                                    "speaker": "雅珂达",
                                    "text": "#不过…{NICKNAME}，你为什么是厨师啊。厨师要怎么…偷袭呢？",
                                    "choices": [
                                        {
                                            "id": "698571902",
                                            "text": "我可以用平底锅重击。",
                                            "response": [
                                                {
                                                    "id": "698571903",
                                                    "speaker": "「主持人」",
                                                    "text": "#没错。{NICKNAME}的平底锅是一种钝器，如果抽到好卡的话，可以让敌人陷入长时间眩晕。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698571904",
                                            "text": "我可以用食物劝降对手。",
                                            "response": [
                                                {
                                                    "id": "698571905",
                                                    "speaker": "「主持人」",
                                                    "text": "可以。如果你真的能抽到好卡的话。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698571501",
                            "text": "好久不见，各位。看来你们需要我的帮助？",
                            "response": [
                                {
                                    "id": "698571502",
                                    "speaker": "娜维娅",
                                    "text": "#{NICKNAME}，你怎么会在这里？难、难道是听到了我们的呼唤？"
                                },
                                {
                                    "id": "698571503",
                                    "speaker": "派蒙",
                                    "text": "#（怎么把{NICKNAME}说得和召唤灵一样…啊，这么一想，确实很像呢，嘿嘿嘿…）"
                                },
                                {
                                    "id": "698571504",
                                    "speaker": "Player",
                                    "text": "是、是啊…我听见了呼唤，我必须回应！"
                                },
                                {
                                    "id": "698571505",
                                    "speaker": "雅珂达",
                                    "text": "（这意思就是：「我是被突然莫名其妙拉进来玩游戏的啊！」吧…）"
                                },
                                {
                                    "id": "698571601",
                                    "speaker": "叶洛亚",
                                    "text": "（不愧是娜维娅小姐之前提过的老玩家，一下子就代入了啊…）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1680107",
            "objective": "",
            "dialogues": [
                {
                    "id": "698572101",
                    "speaker": "雅珂达",
                    "text": "是这样啊…「桌上剧团」的这种游戏还真是复杂啊，真需要想象力…"
                },
                {
                    "id": "698572102",
                    "speaker": "娜维娅",
                    "text": "#不愧是{NICKNAME}，一下子就想出来战斗方法了。但我还要多说一句，叶洛亚，你这次可不能一个人冲出去了。"
                },
                {
                    "id": "698572103",
                    "speaker": "叶洛亚",
                    "text": "我明白。「纯水骑士」的职责是保护队友，成为他们的盾牌…抱歉，我总是忍不住…"
                },
                {
                    "id": "698572104",
                    "speaker": "雅珂达",
                    "text": "哎呀，没关系的。我现在可以一轮行动三次，我肯定追得上你，放开了玩吧。"
                },
                {
                    "id": "698572105",
                    "speaker": "娜维娅",
                    "text": "那就交给你了，叶洛亚！"
                },
                {
                    "id": "698572106",
                    "speaker": "叶洛亚",
                    "text": "那我…使用这面纯水骑士盾牌上附带的技能「破邪号令」！"
                },
                {
                    "id": "698572107",
                    "speaker": "「主持人」",
                    "text": "「纯水骑士举起手中的盾牌，高声颂唱着骑士的箴言。怪物们完全被公正的光辉——还有光辉下那位无畏的骑士——吸引住了注意力。」"
                },
                {
                    "id": "698572108",
                    "speaker": "「主持人」",
                    "text": "「而埋伏在后方的两位同伴，也抓住了这个机会。准备发动攻势。」"
                },
                {
                    "id": "698572109",
                    "speaker": "雅珂达",
                    "text": "那你先出手，我随后攻击。",
                    "choices": [
                        {
                            "id": "698572201",
                            "text": "（用平底锅重击…）",
                            "response": [
                                {
                                    "id": "698572202",
                                    "speaker": "「主持人」",
                                    "text": "#「逐影猎人的身手不减往日，{M#他}{F#她}敏捷地跃出草丛，用平底锅重重地轰击了敌人的后脑。」"
                                },
                                {
                                    "id": "698572203",
                                    "speaker": "「主持人」",
                                    "text": "「即使平底锅只是普通的平底锅，但逐影猎人却不是普通的厨师。敌人哼了一声，就彻底倒下了。」"
                                },
                                {
                                    "id": "698573001",
                                    "speaker": "雅珂达",
                                    "text": "成…成功了！太好了，接下来我要…对，我要先用「疾行如风」拉近距离，然后用「四象击」从背后…"
                                },
                                {
                                    "id": "698573101",
                                    "speaker": "雅珂达",
                                    "text": "果然没有成功啊！不管了，反正怪物都冲上来了，就在原地用「四象击」炸飞它们…"
                                },
                                {
                                    "id": "698573201",
                                    "speaker": "雅珂达",
                                    "text": "哎哟！好痛，什么东西咬我的腿…咦，阿舍鲁，你怎么来了？"
                                },
                                {
                                    "id": "698573202",
                                    "speaker": "阿舍鲁",
                                    "text": "喵，喵——"
                                },
                                {
                                    "id": "698573203",
                                    "speaker": "雅珂达",
                                    "text": "啊…！都这个点了？！完蛋了完蛋了，老板交代的事我完全忘记了啊！"
                                },
                                {
                                    "id": "698573204",
                                    "speaker": "雅珂达",
                                    "text": "对不起对不起，我我我我我暂时不能玩了——"
                                },
                                {
                                    "id": "698573205",
                                    "speaker": "阿舍鲁",
                                    "text": "喵，喵喵喵~"
                                },
                                {
                                    "id": "698573206",
                                    "speaker": "雅珂达",
                                    "text": "阿舍鲁，等等我啊！喂，跑那么快干什么啊！"
                                },
                                {
                                    "id": "698573207",
                                    "speaker": "克洛琳德",
                                    "text": "…看来，我们今天只能玩到这里了。"
                                },
                                {
                                    "id": "698573208",
                                    "speaker": "克洛琳德",
                                    "text": "娜维娅，把怪物指示牌放回原处，我看见了。",
                                    "choices": [
                                        {
                                            "id": "698573209",
                                            "text": "不过，娜维娅和克洛琳德…",
                                            "response": [
                                                {
                                                    "id": "698573211",
                                                    "speaker": "克洛琳德",
                                                    "text": "这就是一个…呵呵，说来非常长的故事了。"
                                                },
                                                {
                                                    "id": "698573212",
                                                    "speaker": "克洛琳德",
                                                    "text": "有机会的话，我们可以坐下来详细聊一聊。"
                                                },
                                                {
                                                    "id": "698573213",
                                                    "speaker": "娜维娅",
                                                    "text": "不过，叶洛亚之前是不是说，想要去邀请一位同事，和我们一起玩剧本来着？"
                                                },
                                                {
                                                    "id": "698573214",
                                                    "speaker": "娜维娅",
                                                    "text": "反正现在游戏暂停了，趁着这个机会，我们干脆直接去找他吧，玩剧本嘛，当然是人越多越好玩啦。"
                                                },
                                                {
                                                    "id": "698573215",
                                                    "speaker": "叶洛亚",
                                                    "text": "菲林斯先生？他…呃…如果我们去找他，他肯定会和我们玩就是了…"
                                                },
                                                {
                                                    "id": "698573216",
                                                    "speaker": "娜维娅",
                                                    "text": "那太好了，走，我们先去买点见面礼，然后当面去拜访一下吧。"
                                                },
                                                {
                                                    "id": "698573217",
                                                    "speaker": "克洛琳德",
                                                    "text": "#{NICKNAME}，等我们准备好之后，也会告诉你的。"
                                                },
                                                {
                                                    "id": "698573218",
                                                    "speaker": "娜维娅",
                                                    "text": "到时候，你可一定要继续和我们冒险啊。"
                                                },
                                                {
                                                    "id": "698573219",
                                                    "speaker": "Player",
                                                    "text": "听到呼唤，我就会回应。"
                                                },
                                                {
                                                    "id": "698573220",
                                                    "speaker": "娜维娅",
                                                    "text": "不愧是我的好伙伴！那我们就先去拜访那位菲林斯先生，买些什么礼物好呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698573210",
                                            "text": "为什么会来这里玩剧本？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698572301",
                            "text": "（用平底锅重击…）",
                            "response": [
                                {
                                    "id": "698572302",
                                    "speaker": "「主持人」",
                                    "text": "「逐影猎人猛地跃出了草丛，猛地将平底锅砸向了敌人。」"
                                },
                                {
                                    "id": "698572303",
                                    "speaker": "「主持人」",
                                    "text": "「不过，虽然逐影猎人并不是普通的厨师，但平底锅却只是普通的平底锅。」"
                                },
                                {
                                    "id": "698572304",
                                    "speaker": "「主持人」",
                                    "text": "「在轰上敌人后脑的瞬间，平底锅四分五裂，在短暂的眩晕后，敌人转过头，怒视着手无寸铁的逐影猎人。」"
                                }
                            ]
                        },
                        {
                            "id": "698572401",
                            "text": "（开始烹饪…）",
                            "response": [
                                {
                                    "id": "698572402",
                                    "speaker": "「主持人」",
                                    "text": "「逐影猎人熟练地掏出厨具开始烹饪，很快便做出了一道美味至极的餐食。」"
                                },
                                {
                                    "id": "698572403",
                                    "speaker": "「主持人」",
                                    "text": "#「被香味引诱而来的敌人，完全将注意力放在了美味的餐食上，却忽视了逐影猎人和{M#他}{F#她}的同伴」"
                                }
                            ]
                        },
                        {
                            "id": "698572501",
                            "text": "（开始烹饪…）",
                            "response": [
                                {
                                    "id": "698572502",
                                    "speaker": "「主持人」",
                                    "text": "「逐影猎人熟练地掏出厨具开始烹饪，很快便做出了一道餐食。」"
                                },
                                {
                                    "id": "698572503",
                                    "speaker": "「主持人」",
                                    "text": "「被烹饪声响引诱而来的敌人，不解地看着正在做饭的逐影猎人，旁边的餐食似乎也无法吸引它们的注意力。」"
                                }
                            ]
                        },
                        {
                            "id": "698572601",
                            "text": "（用药物攻击…）",
                            "response": [
                                {
                                    "id": "698572602",
                                    "speaker": "「主持人」",
                                    "text": "「逐影猎人掏出了自己药箱中的药物，熟练地配置出了一罐麻醉用药剂。」"
                                },
                                {
                                    "id": "698572603",
                                    "speaker": "「主持人」",
                                    "text": "#「{M#他}{F#她}将这瓶药剂悄悄地滚到了敌人的脚下，顷刻后，毫无防备的敌人全部昏迷了。」"
                                }
                            ]
                        },
                        {
                            "id": "698572701",
                            "text": "（用药物攻击…）",
                            "response": [
                                {
                                    "id": "698572702",
                                    "speaker": "「主持人」",
                                    "text": "#「逐影猎人掏出了自己药箱中的药物，正准备配置药剂，但{M#他}{F#她}却不小心打翻了一味原料。」"
                                },
                                {
                                    "id": "698572703",
                                    "speaker": "「主持人」",
                                    "text": "#「泄露的原料污染了其他药物，各类药物互相发生作用，腾起了剧毒的烟雾，让逐影猎人和{M#他}{F#她}的同伴咳嗽连连，头晕目眩。」"
                                }
                            ]
                        },
                        {
                            "id": "698572801",
                            "text": "（把整个药箱丢出去…）",
                            "response": [
                                {
                                    "id": "698572802",
                                    "speaker": "「主持人」",
                                    "text": "#「逐影猎人猛地将整个药箱掷向了敌人。就和{M#他}{F#她}预想的一般，药箱碎裂后，里面的药物也彼此混合了起来。」"
                                },
                                {
                                    "id": "698572803",
                                    "speaker": "「主持人」",
                                    "text": "「在剧毒的烟雾里，已经被药箱重击过一次后脑的敌人头晕目眩，昏倒在地。」"
                                }
                            ]
                        },
                        {
                            "id": "698572901",
                            "text": "（把整个药箱丢出去…）",
                            "response": [
                                {
                                    "id": "698572902",
                                    "speaker": "「主持人」",
                                    "text": "#「逐影猎人猛地将整个药箱掷向了敌人。虽然精确命中了敌人的后脑，但这个药箱的坚固程度远超{M#他}{F#她}的想象。」"
                                },
                                {
                                    "id": "698572903",
                                    "speaker": "「主持人」",
                                    "text": "「药箱并没有碎裂，虽然内部的药物确实已经混合产生了剧毒的烟雾，但这股烟雾，却被药箱牢牢封堵，一丝也没漏出来。」"
                                }
                            ]
