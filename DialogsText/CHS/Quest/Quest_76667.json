    "talks": [
        {
            "id": "7666701",
            "objective": "和莉莉希对话",
            "dialogues": [
                {
                    "id": "766670301",
                    "speaker": "Player",
                    "text": "我去帮你准备一些。"
                },
                {
                    "id": "766670302",
                    "speaker": "莉莉希",
                    "text": "您、您愿意帮我？太感谢了，太感谢了——那…就请您帮我拿<color=#00E1FFFF>五颗白灵果</color>来吧，这些就够用了！"
                },
                {
                    "id": "766670303",
                    "speaker": "莉莉希",
                    "text": "等您拿来了之后，我一定会给您做一份最好吃的「飨月餐」！"
                }
            ]
        },
        {
            "id": "7666704",
            "objective": "",
            "dialogues": [
                {
                    "id": "766670401",
                    "speaker": "莉莉希",
                    "text": "够用了！太感谢了，太感谢了！请您稍等，我去给您做一份最好吃的「飨月餐」！"
                },
                {
                    "id": "766670402",
                    "speaker": "Black Screen",
                    "text": "莉莉希奔向后厨，开始热火朝天地做起了「飨月餐」…"
                },
                {
                    "id": "766670403",
                    "speaker": "莉莉希",
                    "text": "做好啦，请您品尝吧。"
                },
                {
                    "id": "766670404",
                    "speaker": "莉莉希",
                    "text": "再次感谢您的帮助，下次如果您肚子饿了，请尽管过来吧，我会为您专门准备一份的。"
                }
            ]
        },
