    "talks": [
        {
            "id": "402701",
            "objective": "（test）水龙问答$HIDDEN",
            "dialogues": []
        },
        {
            "id": "402513",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "40251323",
                    "speaker": "那维莱特",
                    "text": "#另外，{NICKNAME}，看你的表情应该是还有其他事想问。"
                },
                {
                    "id": "40251324",
                    "speaker": "那维莱特",
                    "text": "请发问吧，我都会如实相告。",
                    "choices": [
                        {
                            "id": "40251325",
                            "text": "关于当初对「公子」的判决…",
                            "response": [
                                {
                                    "id": "40251326",
                                    "speaker": "那维莱特",
                                    "text": "有关「公子」一案，我多方追溯，得知他年幼时曾坠入未知的深渊，机缘巧合下唤醒了吞星之鲸。"
                                },
                                {
                                    "id": "40251327",
                                    "speaker": "那维莱特",
                                    "text": "但于情于理，并不应该因为这种原因，就将「公子」认定为灾难的根源，只能算作是连带责任。"
                                },
                                {
                                    "id": "40251328",
                                    "speaker": "那维莱特",
                                    "text": "至于谕示机在那场庭审中的判决…"
                                },
                                {
                                    "id": "40251329",
                                    "speaker": "那维莱特",
                                    "text": "是基于连带责任，还是因为芙卡洛斯猜到他能与吞星之鲸互相牵制，故意让他替枫丹拖延时间…就不得而知了。"
                                },
                                {
                                    "id": "40251330",
                                    "speaker": "派蒙",
                                    "text": "芙卡洛斯果然还是在为枫丹人着想吧，甚至最后枫丹人真正成为人类也是托她的福…"
                                },
                                {
                                    "id": "40251331",
                                    "speaker": "派蒙",
                                    "text": "欸，这么说起来，我忽然想到一个问题…"
                                },
                                {
                                    "id": "40251332",
                                    "speaker": "派蒙",
                                    "text": "枫丹人还没有成为真正的人类之前，他们生出来的孩子难道也是纯水精灵变的吗？"
                                },
                                {
                                    "id": "40251333",
                                    "speaker": "那维莱特",
                                    "text": "生命本来就如水流般循环不息，你还记得枫丹人经常会来到露景泉这里求子的事吧？"
                                },
                                {
                                    "id": "40251334",
                                    "speaker": "派蒙",
                                    "text": "嗯，琳妮特说过，这里是枫丹所有水流的交汇处…"
                                },
                                {
                                    "id": "40251335",
                                    "speaker": "那维莱特",
                                    "text": "其实就连那些夫妻自己都不知道，这种求子其实并非只是一种风俗，而是一种仪式…"
                                },
                                {
                                    "id": "40251336",
                                    "speaker": "那维莱特",
                                    "text": "泉水中那些受到祝福的纯水精灵，真的会在数月以后作为新的枫丹人降生。"
                                },
                                {
                                    "id": "40251337",
                                    "speaker": "派蒙",
                                    "text": "我…我大概明白了，看来这种仪式如今已经用不到了呢，但估计还是会作为习俗来延续下去吧。"
                                },
                                {
                                    "id": "40251380",
                                    "speaker": "派蒙",
                                    "text": "啊，等等，关于神之心的事，我还有一点问题…"
                                },
                                {
                                    "id": "40251381",
                                    "speaker": "派蒙",
                                    "text": "之前和林尼聊天的时候，林尼说你对送出神之心这件事的态度有过一次明显的变化…"
                                },
                                {
                                    "id": "40251382",
                                    "speaker": "派蒙",
                                    "text": "我们都猜测可能还存在什么只有你知道的理由…"
                                },
                                {
                                    "id": "40251383",
                                    "speaker": "那维莱特",
                                    "text": "难怪壁炉之家可以作为愚人众的情报机构，竟然这样敏感。"
                                },
                                {
                                    "id": "40251384",
                                    "speaker": "那维莱特",
                                    "text": "关于这个问题，我正巧也有件事准备和你们分享…"
                                },
                                {
                                    "id": "40251385",
                                    "speaker": "派蒙",
                                    "text": "嗯？还有什么事情？"
                                },
                                {
                                    "id": "40251386",
                                    "speaker": "那维莱特",
                                    "text": "其实那天我将你们从原始胎海送回陆地上以后，我和那位名叫丝柯克的小姐之间还有过这样的对话…"
                                }
                            ]
                        },
                        {
                            "id": "40251338",
                            "text": "关于枫丹的未来…",
                            "response": [
                                {
                                    "id": "40251339",
                                    "speaker": "派蒙",
                                    "text": "说起来，听莱欧斯利说芙宁娜已经离开了，那是怎么回事？"
                                },
                                {
                                    "id": "40251340",
                                    "speaker": "那维莱特",
                                    "text": "芙宁娜女士…民众只知道她的死刑并未真正执行。她卸任了水神一职，将名义上的事务交付于我，离开了歌剧院。"
                                },
                                {
                                    "id": "40251341",
                                    "speaker": "那维莱特",
                                    "text": "我忠实而全面地转述了芙卡洛斯最后的话。她听完以后，没有表现出悲伤，也没有表示欣慰…"
                                },
                                {
                                    "id": "40251342",
                                    "speaker": "那维莱特",
                                    "text": "只是说…她累了，需要休息。"
                                },
                                {
                                    "id": "40251343",
                                    "speaker": "那维莱特",
                                    "text": "…说完这些，她就收拾东西，像普通人搬家那样搬出了歌剧院。"
                                },
                                {
                                    "id": "40251344",
                                    "speaker": "派蒙",
                                    "text": "芙宁娜…那她现在有地方住吧？"
                                },
                                {
                                    "id": "40251345",
                                    "speaker": "那维莱特",
                                    "text": "请放心，我自然会安排妥当，她的衣食住行都不成问题。"
                                },
                                {
                                    "id": "40251346",
                                    "speaker": "那维莱特",
                                    "text": "其实我…隐约为她感到高兴。尽管她精神上累积的创伤需要时间来慢慢修复…"
                                },
                                {
                                    "id": "40251347",
                                    "speaker": "那维莱特",
                                    "text": "但不再需要扮演「水神芙卡洛斯」以后，她终于可以放下所有，去过普通的生活了。"
                                },
                                {
                                    "id": "40251348",
                                    "speaker": "派蒙",
                                    "text": "那你自己呢，得到水龙全部的力量以后，你有什么打算吗？"
                                },
                                {
                                    "id": "40251349",
                                    "speaker": "那维莱特",
                                    "text": "芙卡洛斯逝去后，谕示裁定枢机也停止了运转。"
                                },
                                {
                                    "id": "40251350",
                                    "speaker": "那维莱特",
                                    "text": "这件事会直接影响审判，我慎重考虑后，决定取代它在庭审中的作用。今后我会自行审判，并将结果传达出来。"
                                },
                                {
                                    "id": "40251351",
                                    "speaker": "派蒙",
                                    "text": "看来你还是完全在以最高审判官的立场考虑事情呢。"
                                },
                                {
                                    "id": "40251352",
                                    "speaker": "那维莱特",
                                    "text": "身为元素龙，我仍有许多未竟之事。可这份力量…这种责任，某种意义上都是被赋予的。"
                                },
                                {
                                    "id": "40251353",
                                    "speaker": "那维莱特",
                                    "text": "所以在履行其他责任之前，我首先要作为最高审判官继续为枫丹效力。二者将在我的生活中并存。"
                                },
                                {
                                    "id": "40251354",
                                    "speaker": "那维莱特",
                                    "text": "此外，水神的离开还会带来另一个问题…歌剧院将不再产出「律偿混能」。"
                                },
                                {
                                    "id": "40251355",
                                    "speaker": "派蒙",
                                    "text": "是啊，那种能量来自于民众对水神的信仰吧。"
                                },
                                {
                                    "id": "40251356",
                                    "speaker": "派蒙",
                                    "text": "可现在城里的机械都在正常运转啊，能量究竟是怎么来的呢？"
                                },
                                {
                                    "id": "40251357",
                                    "speaker": "那维莱特",
                                    "text": "如今的我已经可以完全掌控「芒荒能量」了，它完全可以用作替代能源，这也是我暂时离不开枫丹的原因之一。"
                                },
                                {
                                    "id": "40251358",
                                    "speaker": "派蒙",
                                    "text": "唔哇，古龙的权能真是好用…"
                                }
                            ]
                        },
                        {
                            "id": "40251359",
                            "text": "关于枫丹的神之心…",
                            "response": [
                                {
                                    "id": "40251360",
                                    "speaker": "派蒙",
                                    "text": "噢噢对，听说你把神之心「外交赠予」了「仆人」？"
                                },
                                {
                                    "id": "40251361",
                                    "speaker": "那维莱特",
                                    "text": "那两位执行官在这场灾难中的确做出了诸多贡献，暂且不谈他们完全出于自愿的部分…"
                                },
                                {
                                    "id": "40251362",
                                    "speaker": "那维莱特",
                                    "text": "单论现阶段愚人众在枫丹的目的，表面上看只有一个，那便是神之心。"
                                },
                                {
                                    "id": "40251363",
                                    "speaker": "那维莱特",
                                    "text": "如今谕示裁定枢机停摆，甚至水神之神座都不复存在，我也并不需要神之心的力量…"
                                },
                                {
                                    "id": "40251364",
                                    "speaker": "那维莱特",
                                    "text": "…神之心在枫丹已经彻底失去意义。"
                                },
                                {
                                    "id": "40251365",
                                    "speaker": "那维莱特",
                                    "text": "假如愚人众的目的并不单纯，那不如就趁此机会满足愚人众的要求…免去更多不必要的周旋。"
                                },
                                {
                                    "id": "40251366",
                                    "speaker": "派蒙",
                                    "text": "还真是复杂的考量啊…我还以为你只是为了感谢「仆人」以及给「公子」道歉呢。"
                                }
                            ]
                        },
                        {
                            "id": "40251367",
                            "text": "关于旅行的下一站…",
                            "response": [
                                {
                                    "id": "40251368",
                                    "speaker": "那维莱特",
                                    "text": "过一段时间，你们准备要去纳塔了吗？"
                                },
                                {
                                    "id": "40251369",
                                    "speaker": "那维莱特",
                                    "text": "我在做向导方面可没有什么天赋，只能尽可能把我所知道的情报告诉你们。"
                                },
                                {
                                    "id": "40251370",
                                    "speaker": "那维莱特",
                                    "text": "据我所知，纳塔可以说是「龙的国度」。"
                                },
                                {
                                    "id": "40251371",
                                    "speaker": "派蒙",
                                    "text": "龙的国度？像你这样的龙吗？"
                                },
                                {
                                    "id": "40251372",
                                    "speaker": "那维莱特",
                                    "text": "不，我想我在纳塔应该并不会受到欢迎。"
                                },
                                {
                                    "id": "40251373",
                                    "speaker": "那维莱特",
                                    "text": "和像我这样的古龙不同，纳塔的龙类应该经历过漫长的发展和演化，如今正大量与人类共存着。"
                                },
                                {
                                    "id": "40251374",
                                    "speaker": "那维莱特",
                                    "text": "那里也是「战争」的国度，大地上延续着无休止的战火。"
                                },
                                {
                                    "id": "40251375",
                                    "speaker": "那维莱特",
                                    "text": "还有一个于你们来说可能会有用的情报，那是我之前与「仆人」谈判时，不经意间获知的…"
                                },
                                {
                                    "id": "40251376",
                                    "speaker": "那维莱特",
                                    "text": "…名为「队长」的执行官，也已经入局了这场无休止的战争之中。"
                                },
                                {
                                    "id": "40251377",
                                    "speaker": "派蒙",
                                    "text": "「队长」…听起来很强的样子，真是到哪里都有这些愚人众执行官在活跃啊…"
                                },
                                {
                                    "id": "40251378",
                                    "speaker": "那维莱特",
                                    "text": "建议你们先做好万全的准备，再前往纳塔。在此之前，枫丹你们想要驻留多久都欢迎。"
                                }
                            ]
                        },
                        {
                            "id": "40251379",
                            "text": "没什么了。"
                        }
                    ]
                }
            ]
        }
    ]
}