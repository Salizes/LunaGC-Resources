    "talks": [
        {
            "id": "2001201",
            "objective": "前去查看详请",
            "dialogues": [
                {
                    "id": "200120101",
                    "speaker": "惊慌的米拉娜",
                    "text": "快来救救我！"
                }
            ]
        },
        {
            "id": "2001202",
            "objective": "(test)击败附近怪物$HIDDEN",
            "dialogues": [
                {
                    "id": "200120201",
                    "speaker": "惊慌的米拉娜",
                    "text": "谢谢你，旅行者。"
                },
                {
                    "id": "200120202",
                    "speaker": "惊慌的米拉娜",
                    "text": "唉，怪物和路障…平时在家里就忙个不停，散个步也能遇见这种倒霉事。"
                },
                {
                    "id": "200120203",
                    "speaker": "惊慌的米拉娜",
                    "text": "抱歉，能请您帮我把这个路障也一并清理了吗？",
                    "choices": [
                        {
                            "id": "200120204",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "200120206",
                                    "speaker": "惊慌的米拉娜",
                                    "text": "谢谢您，希望我的两个孩子能和您一样，有个好品德。"
                                }
                            ]
                        },
                        {
                            "id": "200120205",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "200120207",
                                    "speaker": "惊慌的米拉娜",
                                    "text": "哎呀，只是一点举手之劳，不会花您太长时间的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2001203",
            "objective": "消灭所有魔物并摧毁路障",
            "dialogues": [
                {
                    "id": "200120301",
                    "speaker": "惊慌的米拉娜",
                    "text": "太感谢你了，旅行者。"
                },
                {
                    "id": "200120302",
                    "speaker": "惊慌的米拉娜",
                    "text": "但请你别和人说我在这遇见麻烦了。不然我肯定又要被我丈夫念叨个不停了。"
                },
                {
                    "id": "200120303",
                    "speaker": "惊慌的米拉娜",
                    "text": "别用这种眼神看着我，等你结了婚就知道，连独自散步都是奢侈的娱乐，所以必须抓紧每分每秒。"
                },
                {
                    "id": "200120304",
                    "speaker": "惊慌的米拉娜",
                    "text": "喏，这个给你，我在路上采了一些，自己做饭可比叫猎鹿人的餐便宜多了。过日子就要这样精打细算。"
                }
            ]
        },
        {
            "id": "2001204",
            "objective": "与米拉娜对话",
