        {
            "id": "2302403",
            "objective": "等待到第二天（6点到8点）",
            "dialogues": []
        },
        {
            "id": "2302404",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230240401",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，你们来得正好，这株蔷薇总算盛开了！"
                },
                {
                    "id": "230240402",
                    "speaker": "古尔根",
                    "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。"
                },
                {
                    "id": "230240403",
                    "speaker": "瓦尔坦",
                    "text": "实在太感谢你们了，还请你收下这点谢礼！"
                },
                {
                    "id": "230240404",
                    "speaker": "Player",
                    "text": "可喜可贺！"
                },
                {
                    "id": "230240405",
                    "speaker": "派蒙",
                    "text": "蔷薇开花了，我们也很开心哦！"
                },
                {
                    "id": "230240406",
                    "speaker": "瓦尔坦",
                    "text": "呼…这下子总算可以按时向「健康之家」那边交货了。"
                },
                {
                    "id": "230240407",
                    "speaker": "瓦尔坦",
                    "text": "希望这株蔷薇能帮上他们的忙…"
                }
            ]
        },
        {
            "id": "2302406",
            "objective": "等待到第二天（6点到8点）",
            "dialogues": []
        },
        {
            "id": "2302407",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230240701",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，你来得正好，蔷薇终于盛开了！"
                },
                {
                    "id": "230240702",
                    "speaker": "瓦尔坦",
                    "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。"
                },
                {
                    "id": "230240703",
                    "speaker": "古尔根",
                    "text": "「健康之家」的医生们应该也会惊叹吧！"
                },
                {
                    "id": "230240704",
                    "speaker": "瓦尔坦",
                    "text": "事不宜迟，我这就去把这株花给移出来…"
                },
                {
                    "id": "230240705",
                    "speaker": "古尔根",
                    "text": "等等，这是…什么动静？"
                },
                {
                    "id": "230240706",
                    "speaker": "Black Screen",
                    "text": "花田中爆发出了异样的躁动…"
                },
                {
                    "id": "230240707",
                    "speaker": "派蒙",
                    "text": "呜哇！是骗骗花！怎么会出现在这里？！"
                },
                {
                    "id": "230240708",
                    "speaker": "古尔根",
                    "text": "糟了！花田！它要把花田毁掉了！",
                    "choices": [
                        {
                            "id": "230240709",
                            "text": "我来解决它！",
                            "response": [
                                {
                                    "id": "230240711",
                                    "speaker": "派蒙",
                                    "text": "欸…欸？那只骗骗花…怎么逃跑了？"
                                },
                                {
                                    "id": "230240712",
                                    "speaker": "古尔根",
                                    "text": "怎么会…怎么会这样！"
                                },
                                {
                                    "id": "230240713",
                                    "speaker": "古尔根",
                                    "text": "我们的蔷薇，最重要的草药…居然变成魔物逃走了！",
                                    "choices": [
                                        {
                                            "id": "230240714",
                                            "text": "并不是「变成」…",
                                            "response": [
                                                {
                                                    "id": "230240716",
                                                    "speaker": "瓦尔坦",
                                                    "text": "你的意思是…这株蔷薇之所以生长缓慢，就是因为这只骗骗花在捣乱？"
                                                },
                                                {
                                                    "id": "230240717",
                                                    "speaker": "古尔根",
                                                    "text": "这么一说！完全没有作用的肥料…两倍的浇水量…"
                                                },
                                                {
                                                    "id": "230240718",
                                                    "speaker": "古尔根",
                                                    "text": "我，我们原来一直在照顾这只骗骗花吗？！"
                                                },
                                                {
                                                    "id": "230240719",
                                                    "speaker": "瓦尔坦",
                                                    "text": "可恶…它到底是怎么混进花里面的，完全没发现啊！"
                                                },
                                                {
                                                    "id": "230240720",
                                                    "speaker": "Player",
                                                    "text": "我们有时也会被骗。"
                                                },
                                                {
                                                    "id": "230240721",
                                                    "speaker": "瓦尔坦",
                                                    "text": "唉，这次可真的糟糕了，周围的药田也全都被糟蹋了…"
                                                },
                                                {
                                                    "id": "230240722",
                                                    "speaker": "古尔根",
                                                    "text": "只能去向「健康之家」的医生们说明情况，然后尽快再种一批了啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230240715",
                                            "text": "也许一开始就…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230240710",
                            "text": "你们都退开！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302408",
