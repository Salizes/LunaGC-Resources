    },
    "talks": [
        {
            "id": "2302401",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230240101",
                    "speaker": "瓦尔坦",
                    "text": "二位，你们终于来了。"
                },
                {
                    "id": "230240102",
                    "speaker": "古尔根",
                    "text": "时间正好，万事齐全了！"
                },
                {
                    "id": "230240103",
                    "speaker": "Player",
                    "text": "为什么这么兴奋？"
                },
                {
                    "id": "230240104",
                    "speaker": "派蒙",
                    "text": "难道说，之前的蔷薇要开花了？"
                },
                {
                    "id": "230240105",
                    "speaker": "瓦尔坦",
                    "text": "没错，哈哈哈！这都是多亏了你帮忙啊，旅行者。"
                },
                {
                    "id": "230240106",
                    "speaker": "古尔根",
                    "text": "虽然这株蔷薇还没有盛开，但根据整个植株的形态可以判断，它的生命力极其旺盛！"
                },
                {
                    "id": "230240107",
                    "speaker": "瓦尔坦",
                    "text": "旅行者，如果你有兴趣的话，就来近距离观察一下吧。"
                },
                {
                    "id": "230240108",
                    "speaker": "瓦尔坦",
                    "text": "哈哈哈，说不定，它会在你们面前盛开呢。"
                },
                {
                    "id": "230240109",
                    "speaker": "Player",
                    "text": "那我可要好好看看…"
                },
                {
                    "id": "230240110",
                    "speaker": "派蒙",
                    "text": "真，真的吗？在这么短的时间里开花？"
                },
                {
                    "id": "230240111",
                    "speaker": "派蒙",
                    "text": "好期待！"
                }
            ]
        },
        {
            "id": "2302402",
            "objective": "与瓦尔坦和古尔根对话",
            "dialogues": [
                {
                    "id": "230240201",
                    "speaker": "古尔根",
                    "text": "两位，请俯身贴近点看吧，这样就能把所有细节看得一清二楚。"
                },
                {
                    "id": "230240202",
                    "speaker": "Black Screen",
                    "text": "和两位药农一同细致观察了尚未盛开的蔷薇…"
                },
                {
                    "id": "230240203",
                    "speaker": "派蒙",
                    "text": "没有动静啊…",
                    "choices": [
                        {
                            "id": "230240204",
                            "text": "看不出什么迹象…",
                            "response": [
                                {
                                    "id": "230240206",
                                    "speaker": "古尔根",
                                    "text": "哎呀…也许是这株蔷薇有些不好意思在你们面前盛开吧…"
                                },
                                {
                                    "id": "230240207",
                                    "speaker": "瓦尔坦",
                                    "text": "不过，根据蔷薇的生长规律，最迟明天，肯定会开花的。"
                                },
                                {
                                    "id": "230240208",
                                    "speaker": "瓦尔坦",
                                    "text": "旅行者，请你明天再过来吧！"
                                }
                            ]
                        },
                        {
                            "id": "230240205",
                            "text": "腿都站麻了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302405",
