    "talks": [
        {
            "id": "7112701",
            "objective": "（test）一游戏日后触发隐藏环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7112702",
            "objective": "前往来歆山顶",
            "dialogues": []
        },
        {
            "id": "7112705",
            "objective": "与灵渊对话",
            "dialogues": [
                {
                    "id": "711270401",
                    "speaker": "灵渊",
                    "text": "#{NICKNAME}，还有派蒙。你们来了。"
                },
                {
                    "id": "711270402",
                    "speaker": "派蒙",
                    "text": "欸，灵渊？为什么你会在这里？"
                },
                {
                    "id": "711270403",
                    "speaker": "灵渊",
                    "text": "因为我进不去。"
                },
                {
                    "id": "711270404",
                    "speaker": "派蒙",
                    "text": "进不去？是说进不去什么地方呀？"
                },
                {
                    "id": "711270405",
                    "speaker": "灵渊",
                    "text": "锦落庭。浮锦现在休息的地方。"
                },
                {
                    "id": "711270406",
                    "speaker": "派蒙",
                    "text": "锦落庭…唔，就是浮锦一开始把我们拉进去的那个地方吗？"
                },
                {
                    "id": "711270407",
                    "speaker": "灵渊",
                    "text": "那里是她用仙力封锁的居所。我没有她的仙力，去不到她的身边。"
                },
                {
                    "id": "711270408",
                    "speaker": "派蒙",
                    "text": "啊？可是她之前回去休息的时候，你也没提这件事…"
                },
                {
                    "id": "711270409",
                    "speaker": "灵渊",
                    "text": "我没想起来。",
                    "choices": [
                        {
                            "id": "711270410",
                            "text": "需要帮忙吗？",
                            "response": [
                                {
                                    "id": "711270411",
                                    "speaker": "灵渊",
                                    "text": "你们拥有她的仙力，能够开启锦落庭的大门。是的，希望你们帮助我。"
                                },
                                {
                                    "id": "711270416",
                                    "speaker": "派蒙",
                                    "text": "欸？等一下，所以你是一直在这里等我们吗？"
                                },
                                {
                                    "id": "711270417",
                                    "speaker": "灵渊",
                                    "text": "我不是在等你们。我是在寻找进入锦落庭的办法。"
                                },
                                {
                                    "id": "711270418",
                                    "speaker": "派蒙",
                                    "text": "好像没什么区别…总、总之，我们也有些在意浮锦的身体状况，那灵渊，我们一起去探望她吧？"
                                },
                                {
                                    "id": "711270419",
                                    "speaker": "灵渊",
                                    "text": "好。谢谢你们。"
                                },
                                {
                                    "id": "711270420",
                                    "speaker": "灵渊",
                                    "text": "跟我来。"
                                }
                            ]
                        },
                        {
                            "id": "711270412",
                            "text": "阿蓝，好笨。",
                            "response": [
                                {
                                    "id": "711270413",
                                    "speaker": "派蒙",
                                    "text": "就是就是！为什么连这么重要的事情都能忘啦！真是的！"
                                },
                                {
                                    "id": "711270414",
                                    "speaker": "灵渊",
                                    "text": "因为我只是愚钝的野兽。见到她，想了很多事情，忘了很多事情。是我的错。"
                                },
                                {
                                    "id": "711270415",
                                    "speaker": "灵渊",
                                    "text": "你们拥有她的仙力，能够开启锦落庭的大门。希望你们帮助我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112703",
            "objective": "前往锦落庭",
            "dialogues": [
                {
                    "id": "711270301",
                    "speaker": "派蒙",
                    "text": "话说回来，这里就是浮锦的洞天吧？总觉得和我们见过的其他洞天不太一样，怎么说呢，好像更…有现实感？"
                },
                {
                    "id": "711270302",
                    "speaker": "派蒙",
                    "text": "既没有什么奇奇怪怪的机关，也没有什么透明的浮空桥…"
                },
                {
                    "id": "711270303",
                    "speaker": "浮锦",
                    "text": "实在是对不起…之前觉得太丢人了，一直没能解释清楚。"
                },
                {
                    "id": "711270304",
                    "speaker": "浮锦",
                    "text": "我没办法像南方众仙那样，创造出新的空间来。「锦落庭」不是什么「洞天」，充其量也就只是个「洞穴」而已…"
                },
                {
                    "id": "711270305",
                    "speaker": "派蒙",
                    "text": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不过，也不知道浮锦什么时候才能变回人形呢…"
                },
                {
                    "id": "711270306",
                    "speaker": "灵渊",
                    "text": "她积攒的力量已经全部逸散到了这片土地上。短时间内应该没办法再恢复人形了。"
                },
                {
                    "id": "711270307",
                    "speaker": "灵渊",
                    "text": "我耗尽力量的时候也是一样。主人死去后，从雪落到雪融，再从雪融到雪落，如此反复不知多少次，我才能再度化为人的模样。"
                },
                {
                    "id": "711270308",
                    "speaker": "派蒙",
                    "text": "原来是这样…欸？等一下，原来灵渊也能化成人形吗？！"
                },
                {
                    "id": "711270309",
                    "speaker": "浮锦",
                    "text": "哼哼，那是当然！二位有所不知，想当初，在药君山的时候，灵渊的姿容可是——"
                },
                {
                    "id": "711270310",
                    "speaker": "灵渊",
                    "text": "浮锦。没必要说下去。这和现在的话题没有任何关系。"
                },
                {
                    "id": "711270311",
                    "speaker": "浮锦",
                    "text": "欸？那化为人形以后，因为在庙会上吃了太多茶糕，哭着跑去求药君帮自己调配减肥茶的事情…"
                },
                {
                    "id": "711270312",
                    "speaker": "浮锦",
                    "text": "或者不小心把庆典上的酒当作茶水喝了下去，拽着山间的林猪，问「药君和我谁更美」的事情，果然还是没必要说下去了吧？"
                },
                {
                    "id": "711270313",
                    "speaker": "灵渊",
                    "text": "…浮锦！"
                },
                {
                    "id": "711270314",
                    "speaker": "派蒙",
                    "text": "呜啊，你这么一说，我开始好奇灵渊化成的人形到底是什么样的了！会是像现在一样蓝蓝的吗？还是会…呃，更白一点？",
                    "choices": [
                        {
                            "id": "711270315",
                            "text": "我也很好奇！",
                            "response": [
                                {
                                    "id": "711270316",
                                    "speaker": "灵渊",
                                    "text": "我不理解你好奇的原因。你也是人。对人的形态感兴趣，看看自己就好。"
                                },
                                {
                                    "id": "711270321",
                                    "speaker": "浮锦",
                                    "text": "#呵呵…总之，谢谢你们，{NICKNAME}和派蒙。我也没有想到，有朝一日，还能像这样和其他人交流…"
                                },
                                {
                                    "id": "711270322",
                                    "speaker": "浮锦",
                                    "text": "咳咳——既然小仙我心情大悦，不妨就护佑二位，接下来的旅途能够一帆风顺，时通运泰…"
                                },
                                {
                                    "id": "711270323",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "711270324",
                                    "speaker": "浮锦",
                                    "text": "…对不起是我得意忘形了。我刚才想要像仙人那样，说一下这句话试试看…"
                                },
                                {
                                    "id": "711270325",
                                    "speaker": "浮锦",
                                    "text": "无论如何，我都会在这里祈愿，愿你们接下来的旅途一帆风顺。"
                                }
                            ]
                        },
                        {
                            "id": "711270317",
                            "text": "灵渊，可以变一下看看吗？",
                            "response": [
                                {
                                    "id": "711270318",
                                    "speaker": "灵渊",
                                    "text": "我拒绝。人类的身躯过于羸弱。没有撕碎猎物的尖牙，没有逐狩仇敌的利爪。除非浮锦命令，我不会做那种事。"
                                },
                                {
                                    "id": "711270319",
                                    "speaker": "浮锦",
                                    "text": "…欸？这、这个，我觉得还是应该尊重灵渊的想法吧…？"
                                },
                                {
                                    "id": "711270320",
                                    "speaker": "灵渊",
                                    "text": "我没有什么想法。你要是有想法的话，可以直接告诉我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112707",
            "objective": "进入锦落庭",
            "dialogues": []
        },
        {
            "id": "7112706",
            "objective": "进入锦落庭",
            "dialogues": []
        },
        {
            "id": "7112704",
            "objective": "寻找浮锦",
            "dialogues": [
                {
                    "id": "711270501",
                    "speaker": "浮锦的声音",
                    "text": "#欸？{NICKNAME}和派蒙，还有灵渊…为什么会到这里来呀？"
                },
                {
                    "id": "711270502",
                    "speaker": "派蒙",
                    "text": "哇啊，是浮锦的声音！好像是…从这下面传上来的？",
                    "choices": [
                        {
                            "id": "711270503",
                            "text": "我有些担心你。",
                            "response": [
                                {
                                    "id": "711270504",
                                    "speaker": "派蒙",
                                    "text": "是呀，我们都很担心你的身体状况，所以没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！"
                                },
                                {
                                    "id": "711270509",
                                    "speaker": "浮锦的声音",
                                    "text": "欸？啊！抱歉！我回锦落庭休息的时候，好像忘了解除门口的封锁了…！对不起，你们明明是来探望我的，却给你们添了那么多麻烦…"
                                },
                                {
                                    "id": "711270510",
                                    "speaker": "派蒙",
                                    "text": "也算不上是添麻烦啦。不过，为什么你要躲在这个…呃，水坑里呀？"
                                },
                                {
                                    "id": "711270511",
                                    "speaker": "浮锦的声音",
                                    "text": "怎么说呢…因为我现在还没能恢复我最喜欢的形态，总是让你们看到鲤鱼的样子，稍微觉得有些…不好意思…",
                                    "choices": [
                                        {
                                            "id": "711270512",
                                            "text": "明明之前已经见过好多次了…",
                                            "response": [
                                                {
                                                    "id": "711270514",
                                                    "speaker": "浮锦的声音",
                                                    "text": "啊哈哈…因为之前能随时变回人的样子，所以觉得用鲤鱼的形态行动起来会更方便；现在只剩下滑溜溜的样子了，反而觉得有点…"
                                                },
                                                {
                                                    "id": "711270515",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇，还真是奇怪的执着…总之，浮锦你没事就好！"
                                                },
                                                {
                                                    "id": "711270516",
                                                    "speaker": "派蒙",
                                                    "text": "不过，按照灵渊之前的说法，浮锦的力量其实不是直接消耗掉了，而是逸散到了沉玉谷的山林河川之间，所以才会变得虚弱…"
                                                },
                                                {
                                                    "id": "711270517",
                                                    "speaker": "派蒙",
                                                    "text": "那要是像我们在药蝶谷找金色的鲤鱼一样，把逸散的仙力收集起来，浮锦就能恢复了吧？"
                                                },
                                                {
                                                    "id": "711270518",
                                                    "speaker": "浮锦的声音",
                                                    "text": "嗯…理论上来说是这样没错啦，不过…"
                                                },
                                                {
                                                    "id": "711270519",
                                                    "speaker": "派蒙",
                                                    "text": "对吧对吧？那我们之后要是发现了类似的鲤鱼，就把它带回这里来吧！这样一来，浮锦也能早日恢复啦！"
                                                },
                                                {
                                                    "id": "711270520",
                                                    "speaker": "浮锦的声音",
                                                    "text": "这、这种事情也太麻烦你们了！小仙我的力量还没有耗尽到那种程度，只要在这里稍稍静养一段时间，就可以…"
                                                },
                                                {
                                                    "id": "711270521",
                                                    "speaker": "Player",
                                                    "text": "倒也不算是麻烦…"
                                                },
                                                {
                                                    "id": "711270522",
                                                    "speaker": "Player",
                                                    "text": "…只是遇到的话会留神一下。"
                                                },
                                                {
                                                    "id": "711270523",
                                                    "speaker": "浮锦的声音",
                                                    "text": "谢谢你们。不过，我真的不想因为自己的事情再给你们添麻烦了，你们为我做过的已经太多了。"
                                                },
                                                {
                                                    "id": "711270524",
                                                    "speaker": "浮锦的声音",
                                                    "text": "要是二位在旅途中寻到了更多逸散的仙力，就将它们直接汇入这里的祀珑吧。"
                                                },
                                                {
                                                    "id": "711270525",
                                                    "speaker": "浮锦的声音",
                                                    "text": "虽然水土的调理已经完成，但若是能向祀珑中注入更多力量，就能保证沉玉谷风调雨顺、年登岁稔。"
                                                },
                                                {
                                                    "id": "711270526",
                                                    "speaker": "灵渊",
                                                    "text": "…那你呢？"
                                                },
                                                {
                                                    "id": "711270527",
                                                    "speaker": "浮锦的声音",
                                                    "text": "真是的，我都说了，我只要在这里休养一段时间就好啦！"
                                                },
                                                {
                                                    "id": "711270528",
                                                    "speaker": "浮锦的声音",
                                                    "text": "#{NICKNAME}和派蒙，真的非常感谢你们能来探望我。我真的真的好开心。自从药君离开，还是第一次有人到这里来呢。"
                                                },
                                                {
                                                    "id": "711270529",
                                                    "speaker": "浮锦的声音",
                                                    "text": "也谢谢你，灵渊。"
                                                },
                                                {
                                                    "id": "711270530",
                                                    "speaker": "灵渊",
                                                    "text": "我没做什么值得你感谢的事情。"
                                                },
                                                {
                                                    "id": "711270531",
                                                    "speaker": "浮锦的声音",
                                                    "text": "#哎呀，好啦！就当我是在感谢你把{NICKNAME}和派蒙带到这里吧，真是的！"
                                                },
                                                {
                                                    "id": "711270532",
                                                    "speaker": "浮锦的声音",
                                                    "text": "#最后…让我再说一次谢谢吧，{NICKNAME}和派蒙。谢谢你们做过的一切。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711270513",
                                            "text": "那也没必要躲起来吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711270505",
                            "text": "灵渊有些担心你。",
                            "response": [
                                {
                                    "id": "711270506",
                                    "speaker": "灵渊",
                                    "text": "我没有。我只是…"
                                },
                                {
                                    "id": "711270507",
                                    "speaker": "灵渊",
                                    "text": "……"
                                },
                                {
                                    "id": "711270508",
                                    "speaker": "派蒙",
                                    "text": "你看，灵渊这都担心得说不出话了，所以我们没打招呼就来了——不过，浮锦一开始不也没打招呼就把我们拉过来了嘛，这样我们就算是扯平啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112708",
            "objective": "（test）对话随机环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7112709",
            "objective": "（test）灵渊和小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711270901",
                    "speaker": "小茂",
                    "text": "阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！"
                },
                {
                    "id": "711270902",
                    "speaker": "灵渊",
                    "text": "嗯。我记得。不过，我改变主意了。"
                },
                {
                    "id": "711270903",
                    "speaker": "小茂",
                    "text": "「改变主意」是什么意思呀？"
                },
                {
                    "id": "711270904",
                    "speaker": "灵渊",
                    "text": "这个故事的结尾，就交给你来讲吧。"
                },
                {
                    "id": "711270905",
                    "speaker": "小茂",
                    "text": "欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！"
                },
                {
                    "id": "711270906",
                    "speaker": "灵渊",
                    "text": "我只是愚钝的野兽。想不出好的结局。"
                },
                {
                    "id": "711270907",
                    "speaker": "灵渊",
                    "text": "我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。"
                },
                {
                    "id": "711270908",
                    "speaker": "小茂",
                    "text": "可这还是在耍赖嘛！"
                },
                {
                    "id": "711270909",
                    "speaker": "灵渊",
                    "text": "我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。"
                },
                {
                    "id": "711270910",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711270911",
                    "speaker": "灵渊",
                    "text": "不要露出那种表情。我特别允许你…坐在我背上，五分钟左右。十分钟也可以。"
                },
                {
                    "id": "711270912",
                    "speaker": "小茂",
                    "text": "那…那就这样说好了，我想想这个故事该怎么结尾…"
                }
            ]
        },
        {
            "id": "7112710",
            "objective": "（test）灵渊$HIDDEN",
            "dialogues": [
                {
                    "id": "711271001",
                    "speaker": "派蒙",
                    "text": "欸，这不是灵渊吗？"
                },
                {
                    "id": "711271002",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711271003",
                    "speaker": "派蒙",
                    "text": "啊，对不起！难道说你是在狩猎，我们不小心打扰了你…"
                },
                {
                    "id": "711271004",
                    "speaker": "灵渊",
                    "text": "我没有在狩猎。你们也没有打扰我。"
                },
                {
                    "id": "711271005",
                    "speaker": "派蒙",
                    "text": "呃，那你这是在…发呆？比方说，在想好吃的？"
                },
                {
                    "id": "711271006",
                    "speaker": "灵渊",
                    "text": "我也没在想你的事情。我在思考。"
                },
                {
                    "id": "711271007",
                    "speaker": "派蒙",
                    "text": "思考…不对，你前半句话是什么意思啦！"
                },
                {
                    "id": "711271008",
                    "speaker": "灵渊",
                    "text": "#我在思考{NICKNAME}之前的问题。"
                },
                {
                    "id": "711271009",
                    "speaker": "灵渊",
                    "text": "「如果人类活动也是自然法则的一部分，该如何看待人类。」"
                },
                {
                    "id": "711271010",
                    "speaker": "灵渊",
                    "text": "浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。"
                },
                {
                    "id": "711271011",
                    "speaker": "派蒙",
                    "text": "你这话说的，小茂不也是人类嘛！"
                },
                {
                    "id": "711271012",
                    "speaker": "灵渊",
                    "text": "#小茂是属于聚落的人类，而不是组成聚落的人类。你和{NICKNAME}「组成」了旅行的同伴，而不「属于」{NICKNAME}。这就是区别。",
                    "choices": [
                        {
                            "id": "711271013",
                            "text": "你认为小茂不是社会秩序的一部分？",
                            "response": [
                                {
                                    "id": "711271014",
                                    "speaker": "灵渊",
                                    "text": "还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。"
                                },
                                {
                                    "id": "711271017",
                                    "speaker": "灵渊",
                                    "text": "我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。",
                                    "choices": [
                                        {
                                            "id": "711271018",
                                            "text": "因为他们侵占了属于自然的土地？",
                                            "response": [
                                                {
                                                    "id": "711271020",
                                                    "speaker": "灵渊",
                                                    "text": "我不知道。"
                                                },
                                                {
                                                    "id": "711271021",
                                                    "speaker": "灵渊",
                                                    "text": "也许不存在明显的区别，划分「我们」和「他们」，但我无法确定。"
                                                },
                                                {
                                                    "id": "711271022",
                                                    "speaker": "灵渊",
                                                    "text": "人类的幼崽会与我同行，我也有年幼的同族，出于好奇选择与人类同行。"
                                                },
                                                {
                                                    "id": "711271023",
                                                    "speaker": "派蒙",
                                                    "text": "欸？年幼的同族？"
                                                },
                                                {
                                                    "id": "711271024",
                                                    "speaker": "灵渊",
                                                    "text": "那孩子在山中遇到了烟火气的人类，"
                                                },
                                                {
                                                    "id": "711271025",
                                                    "speaker": "灵渊",
                                                    "text": "所以，我现在依然没办法回答你的问题。我需要继续观察人类。"
                                                },
                                                {
                                                    "id": "711271026",
                                                    "speaker": "灵渊",
                                                    "text": "许多事情，我不理解。我会试着理解，直到我能够按照约定，回答你的问题。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711271019",
                                            "text": "因为浮锦为了他们选择牺牲自己？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711271015",
                            "text": "这可不好说…",
                            "response": [
                                {
                                    "id": "711271016",
                                    "speaker": "派蒙",
                                    "text": "喂！不要说这么奇怪的话啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112711",
            "objective": "（test）大山和小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711271101",
                    "speaker": "小茂",
                    "text": "听大山这么讲，我感觉枫丹的「歌剧」和我们这边的戏好像也差不多呢！"
                },
                {
                    "id": "711271102",
                    "speaker": "小茂",
                    "text": "骑士呀，巫师呀，勇士呀，恶龙呀，你杀我，我杀你的，最后大家都死了！"
                },
                {
                    "id": "711271103",
                    "speaker": "沃特蒙泰涅",
                    "text": "重要的不是结局啦，而是过程，过程！不是所有悲剧都能当武打戏那么看的！"
                },
                {
                    "id": "711271104",
                    "speaker": "小茂",
                    "text": "还有还有，大山刚才说的「累牡蛎牙魔像」，听上去好像很有趣！不知道和阿蓝比起来哪个更大呢？"
                },
                {
                    "id": "711271105",
                    "speaker": "沃特蒙泰涅",
                    "text": "欸？阿兰？"
                },
                {
                    "id": "711271106",
                    "speaker": "小茂",
                    "text": "对喔，我好像还没给大山讲过阿蓝的事情…这样吧，你再给我讲一讲「累牡蛎牙」的魔像，我就给你讲阿蓝的故事好啦！"
                }
            ]
        },
        {
            "id": "7112712",
            "objective": "（test）浮锦和灵渊$HIDDEN",
            "dialogues": [
                {
                    "id": "711271201",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711271202",
                    "speaker": "浮锦",
                    "text": "怎么了，灵渊？一直盯着我看，我身上有什么奇怪的东西吗？"
                },
                {
                    "id": "711271203",
                    "speaker": "灵渊",
                    "text": "我只是在想…不，没什么。"
                },
                {
                    "id": "711271204",
                    "speaker": "灵渊",
                    "text": "就算你和蛇一起要求，我也不会再化成人形了。"
                },
                {
                    "id": "711271205",
                    "speaker": "浮锦",
                    "text": "呵呵，我也没要求过你呀？"
                },
                {
                    "id": "711271206",
                    "speaker": "灵渊",
                    "text": "…算了。走吧。你不是还要去看现在的茶园吗。"
                }
            ]
        },
        {
            "id": "7112713",
            "objective": "（test）浮锦和小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711271301",
                    "speaker": "小茂",
                    "text": "浮锦姐姐！祝贺你重新变回来！"
                },
                {
                    "id": "711271302",
                    "speaker": "小茂",
                    "text": "我已经听阿蓝说过啦！浮锦姐姐好像很喜欢喝茶的样子，我就专门拜托了陆爷爷，为浮锦姐姐准备了超级美味的茶糕！"
                },
                {
                    "id": "711271303",
                    "speaker": "浮锦",
                    "text": "嗯，我已经完全变回来啦！小茂，谢谢你专门为我准备茶糕，我好开心！"
                },
                {
                    "id": "711271304",
                    "speaker": "小茂",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我也准备了你们的份喔！大家一起吃茶糕，庆祝浮锦姐姐恢复精神吧！",
                    "choices": [
                        {
                            "id": "711271305",
                            "text": "（拿一块茶糕。）",
                            "response": [
                                {
                                    "id": "711271306",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，谢谢小茂！既然如此，那我也拿两块吧！"
                                }
                            ]
                        },
                        {
                            "id": "711271307",
                            "text": "（拿两块茶糕。）",
                            "response": [
                                {
                                    "id": "711271308",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，谢谢小茂！既然如此，那我也…呜啊，只剩下一块啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}