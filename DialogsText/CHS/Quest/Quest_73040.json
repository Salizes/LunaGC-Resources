        },
        {
            "id": "7304002",
            "objective": "挑战兰伊舍的谜语",
            "dialogues": [
                {
                    "id": "730400501",
                    "speaker": "兰伊舍",
                    "text": "这个简单，还有好吃谜语，再来。"
                }
            ]
        },
        {
            "id": "7304003",
            "objective": "挑战兰伊舍的下一个谜语",
            "dialogues": [
                {
                    "id": "730400701",
                    "speaker": "兰伊舍",
                    "text": "这个也简单，兰那罗，都知道。好那菈是兰那罗的朋友，自然也知道。再来。"
                }
            ]
        },
        {
            "id": "7304004",
            "objective": "挑战兰伊舍的第三个谜语",
            "dialogues": [
                {
                    "id": "730400901",
                    "speaker": "兰伊舍",
                    "text": "好那菈，全都答对！好那菈是聪明那菈。"
                }
            ]
        },
        {
            "id": "7304005",
            "objective": "",
            "dialogues": [
                {
                    "id": "730401101",
                    "speaker": "兰伊舍",
                    "text": "那菈聪明，比兰拉迦还聪明！那菈愿意当兰伊舍的朋友吗？"
                },
                {
                    "id": "730401102",
                    "speaker": "Player",
                    "text": "好呀。"
                },
                {
                    "id": "730401103",
                    "speaker": "兰伊舍",
                    "text": "嗯！给你花花。兰伊舍会想更多好吃谜语，还要来和兰伊舍玩呀！朋友！"
                }
            ]
        },
        {
            "id": "7304001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730400101",
                    "speaker": "兰伊舍",
                    "text": "那菈朋友！兰罗摩说了很多你的故事，你是充满了勇气和智慧的那菈。来挑战兰伊舍的谜语吧！"
                }
            ]
        },
        {
            "id": "7304003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730400301",
                    "speaker": "Player",
                    "text": "待会儿再说吧。"
                },
                {
                    "id": "730400302",
                    "speaker": "兰伊舍",
                    "text": "唔唔…那菈朋友不要忘记，兰伊舍会一直等。"
                }
            ]
        },
        {
            "id": "7304004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730400401",
                    "speaker": "兰伊舍",
                    "text": "红又圆，挂树上，水嫩嫩，甜滋滋。"
                }
            ]
        },
        {
            "id": "7304006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730400601",
                    "speaker": "兰伊舍",
                    "text": "梦里有，他处无，无忧节里少不了。"
                }
            ]
        },
        {
            "id": "7304008",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730400801",
                    "speaker": "兰伊舍",
                    "text": "这个很难，兰拉迦都想不到！天上有星星，地上有它，星星不见太阳，它也不爱阳光。"
                }
            ]
        },
        {
            "id": "7304010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730401001",
                    "speaker": "兰伊舍",
                    "text": "唔唔，不对，好那菈，再想想。"
                }
            ]
        }
    ]
}