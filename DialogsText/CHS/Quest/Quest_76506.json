    "talks": [
        {
            "id": "7650601",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765060101",
                    "speaker": "多莉",
                    "text": "#哎呀，这不是{NICKNAME}和派蒙嘛！想不到在这里也能和两位相遇，这一定是能带来好运的奇妙缘分啊。"
                },
                {
                    "id": "765060102",
                    "speaker": "派蒙",
                    "text": "多莉！你怎么一个人在这里呀？难道是摆摊卖东西吗？欸，不过我怎么没看到你的商品…"
                },
                {
                    "id": "765060103",
                    "speaker": "多莉",
                    "text": "真是不好意思，今天大名鼎鼎的旅行商人多莉暂时歇业哦。"
                },
                {
                    "id": "765060104",
                    "speaker": "多莉",
                    "text": "我现在啊，正学着那些挪德卡莱的本地人，在这座「乐园」里度过普普通通又自由自在的一天呢！"
                },
                {
                    "id": "765060105",
                    "speaker": "派蒙",
                    "text": "哇，真的假的？没在忙着做买卖、赚摩拉的多莉，真是比沙漠里下雨还要少见啊！"
                },
                {
                    "id": "765060106",
                    "speaker": "多莉",
                    "text": "哼哼，就算我本人在享受难得的假期，我那些店铺和勤劳能干的员工们，也依然在不停地为我赚取源源不断的摩拉呢！"
                },
                {
                    "id": "765060107",
                    "speaker": "多莉",
                    "text": "只要我账户上的数字还在蹭蹭地往上涨，那就没什么可担心的啦。"
                },
                {
                    "id": "765060108",
                    "speaker": "多莉",
                    "text": "这么说来，两位难道是遇到了什么难题吗？虽然我还在休假，但是对于送上门来的生意，我可是从来都不会拒绝的哦！",
                    "choices": [
                        {
                            "id": "765060109",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765060111",
                                    "speaker": "多莉",
                                    "text": "哦哦，原来是想记录下挪德卡莱的独特风光啊！那你们可算是问对人了。"
                                },
                                {
                                    "id": "765060112",
                                    "speaker": "多莉",
                                    "text": "我对这里的熟悉程度，虽然可能还比不上那些土生土长的地头蛇，但是说到风景独特的拍摄点，我还是能给你们推荐不少的！"
                                },
                                {
                                    "id": "765060113",
                                    "speaker": "多莉",
                                    "text": "看在咱们这么熟的份上，我亲自给你们当导游，费用就给你们打个骨折友情价，一天只收你们区区五十万摩拉！怎么样？"
                                },
                                {
                                    "id": "765060114",
                                    "speaker": "派蒙",
                                    "text": "呜哇…不愧是多莉，还是三句话离不开从我们的口袋里掏摩拉的事情呢。"
                                },
                                {
                                    "id": "765060115",
                                    "speaker": "多莉",
                                    "text": "哎呀呀，我这可都是为了让我最重要的客户，能在挪德卡莱留下一段最开心、最难忘的美好回忆嘛！",
                                    "choices": [
                                        {
                                            "id": "765060116",
                                            "text": "既然你如此盛情…",
                                            "response": [
                                                {
                                                    "id": "765060118",
                                                    "speaker": "多莉",
                                                    "text": "哎？为我拍照？这个提议听起来倒是有趣。不过嘛，这些画片可不能用于商业宣传哦，我的肖像权可是价值连城的！"
                                                },
                                                {
                                                    "id": "765060119",
                                                    "speaker": "派蒙",
                                                    "text": "放心好了，我们只是单纯想给老熟人拍个照，留作纪念而已啦！"
                                                },
                                                {
                                                    "id": "765060120",
                                                    "speaker": "多莉",
                                                    "text": "#好好好，既然是{NICKNAME}亲自开口，我就破例给你们当一回模特。请务必把我拍得雍容华贵、气质非凡！"
                                                },
                                                {
                                                    "id": "765060121",
                                                    "speaker": "多莉",
                                                    "text": "我想想啊…画片的题目嘛，就叫「多莉·桑歌玛哈巴依老爷的乐园假日」。是不是很棒？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765060117",
                                            "text": "能否为你拍摄画片呢？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765060110",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
