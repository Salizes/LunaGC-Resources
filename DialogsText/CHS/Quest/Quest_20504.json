{
    "quest": {
        "id": "20504",
        "title": "收集风之印的少女",
        "description": "派蒙注意到了一个很别致的商店…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 29,
        "total_speaker_counts": {
            "Player": 8,
            "派蒙": 4,
            "玛乔丽": 17
        }
    },
    "talks": [
        {
            "id": "2050401",
            "objective": "与店主玛乔丽对话",
            "dialogues": [
                {
                    "id": "205040101",
                    "speaker": "玛乔丽",
                    "text": "欢迎光临，这里的宝物保证独一无二。"
                },
                {
                    "id": "205040102",
                    "speaker": "派蒙",
                    "text": "好多都是没见过的东西…"
                },
                {
                    "id": "205040103",
                    "speaker": "玛乔丽",
                    "text": "哈哈，当然了，这些都是冒险家从世界各地找到的稀奇宝贝。"
                },
                {
                    "id": "205040104",
                    "speaker": "玛乔丽",
                    "text": "怎么样，有一眼就相中的吗？",
                    "choices": [
                        {
                            "id": "205040105",
                            "text": "感觉都很奢侈…",
                            "response": [
                                {
                                    "id": "205040107",
                                    "speaker": "玛乔丽",
                                    "text": "不会不会，忘记和你介绍了，我这里都是以物易物，不收取摩拉。"
                                },
                                {
                                    "id": "205040108",
                                    "speaker": "玛乔丽",
                                    "text": "我最近想做一个特殊的工艺品，需要大量的<color=#00E1FFFF>「风之印」</color>来装饰。"
                                },
                                {
                                    "id": "205040109",
                                    "speaker": "玛乔丽",
                                    "text": "你们身上有<color=#00E1FFFF>「风之印」</color>吗？",
                                    "choices": [
                                        {
                                            "id": "205040110",
                                            "text": "找到了几个。",
                                            "response": [
                                                {
                                                    "id": "205040111",
                                                    "speaker": "玛乔丽",
                                                    "text": "哈哈，那看起来你的冒险已经得到风神的认可了。"
                                                },
                                                {
                                                    "id": "205040114",
                                                    "speaker": "玛乔丽",
                                                    "text": "总之，只要你有<color=#00E1FFFF>「风之印」</color>，就可以和我交换商店里所有的商品。"
                                                },
                                                {
                                                    "id": "205040115",
                                                    "speaker": "Player",
                                                    "text": "挑选商品"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205040112",
                                            "text": "那是什么？",
                                            "response": [
                                                {
                                                    "id": "205040113",
                                                    "speaker": "玛乔丽",
                                                    "text": "那是一种印记，风神会将它送给受到认可的冒险者。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205040106",
                            "text": "我根本不敢看价格。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050402",
            "objective": "(test)触发开车和镜头注视（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "205040201",
                    "speaker": "派蒙",
                    "text": "快看，那边有个看起来很不一样的商店。"
                }
            ]
        },
        {
            "id": "2050403",
            "objective": "(test)关闭商店后得对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "205040301",
                    "speaker": "玛乔丽",
                    "text": "<color=#00E1FFFF>「风之印」</color>有可能出现在蒙德的任何地方，如果不够用的话就去多找找吧。"
                },
                {
                    "id": "205040302",
                    "speaker": "Player",
                    "text": "真的只是用来装饰吗？"
                },
                {
                    "id": "205040303",
                    "speaker": "派蒙",
                    "text": "是啊，怎么说都是风神的赠礼。"
                },
                {
                    "id": "205040304",
                    "speaker": "玛乔丽",
                    "text": "哈哈，你们还挺敏锐的。"
                },
                {
                    "id": "205040305",
                    "speaker": "玛乔丽",
                    "text": "解释起来挺复杂，用装饰品的说法大家都容易理解。"
                },
                {
                    "id": "205040306",
                    "speaker": "玛乔丽",
                    "text": "我会选择用<color=#00E1FFFF>「风之印」</color>，自然是有非它不可的理由。",
                    "choices": [
                        {
                            "id": "205040307",
                            "text": "做好了记得让我看看。",
                            "response": [
                                {
                                    "id": "205040308",
                                    "speaker": "玛乔丽",
                                    "text": "哈哈，肯定的，保证让你大吃一惊。"
                                },
                                {
                                    "id": "205040312",
                                    "speaker": "玛乔丽",
                                    "text": "欢迎再来哦，希望你下次能带来很多很多的<color=#00E1FFFF>「风之印」</color>。"
                                },
                                {
                                    "id": "205040313",
                                    "speaker": "玛乔丽",
                                    "text": "找到什么稀奇宝物的话也记得要带到我这里来！"
                                }
                            ]
                        },
                        {
                            "id": "205040309",
                            "text": "故弄玄虚。",
                            "response": [
                                {
                                    "id": "205040310",
                                    "speaker": "派蒙",
                                    "text": "但我真的有点好奇了…"
                                },
                                {
                                    "id": "205040311",
                                    "speaker": "玛乔丽",
                                    "text": "哈哈，就是要保持未知才会有惊喜啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}