    "talks": [
        {
            "id": "7611906",
            "objective": "同哥伦比娅见面",
            "dialogues": []
        },
        {
            "id": "7611901",
            "objective": "同哥伦比娅见面",
            "dialogues": [
                {
                    "id": "761190101",
                    "speaker": "哥伦比娅",
                    "text": "…这里吗？"
                },
                {
                    "id": "761190102",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "761190103",
                    "speaker": "哥伦比娅",
                    "text": "…哈。"
                },
                {
                    "id": "761190104",
                    "speaker": "派蒙",
                    "text": "她们好像玩得很开心。"
                },
                {
                    "id": "761190105",
                    "speaker": "哥伦比娅",
                    "text": "你们好。"
                },
                {
                    "id": "761190106",
                    "speaker": "努昂诺塔",
                    "text": "！！"
                },
                {
                    "id": "761190107",
                    "speaker": "哥伦比娅",
                    "text": "你也好，努昂诺塔。"
                },
                {
                    "id": "761190108",
                    "speaker": "Player",
                    "text": "是在玩新游戏吗？"
                },
                {
                    "id": "761190109",
                    "speaker": "哥伦比娅",
                    "text": "嗯，我在「旗舰」见到有人用杯子和朋友这样玩，就学来了。"
                },
                {
                    "id": "761190110",
                    "speaker": "哥伦比娅",
                    "text": "他们把宝石扣进杯子里，在桌面上快速转动杯子。"
                },
                {
                    "id": "761190111",
                    "speaker": "哥伦比娅",
                    "text": "等停下后，让对方猜测宝石究竟停留在哪个杯子里。"
                },
                {
                    "id": "761190112",
                    "speaker": "哥伦比娅",
                    "text": "月灵们喜欢钻在布里转来转去的感觉，所以我以魔女小姐的帽子为原型，做了些改良。"
                },
                {
                    "id": "761190113",
                    "speaker": "Player",
                    "text": "很可爱。"
                },
                {
                    "id": "761190114",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "761190115",
                    "speaker": "派蒙",
                    "text": "但话说回来你都去过「旗舰」了呀，有被人认出来吗？"
                },
                {
                    "id": "761190116",
                    "speaker": "哥伦比娅",
                    "text": "有人问起。我就说「我在扮演月神大人，很像吧？」。"
                },
                {
                    "id": "761190117",
                    "speaker": "派蒙",
                    "text": "祈月之夜时的那招还真给你学会了…"
                },
                {
                    "id": "761190118",
                    "speaker": "Player",
                    "text": "那些人会信吗？"
                },
                {
                    "id": "761190119",
                    "speaker": "哥伦比娅",
                    "text": "唔…好像半信半疑。但也没再多和我搭话了。"
                },
                {
                    "id": "761190120",
                    "speaker": "哥伦比娅",
                    "text": "是我表演得不自然吗？下次再去其他地方多试几次。"
                },
                {
                    "id": "761190121",
                    "speaker": "派蒙",
                    "text": "怎么听着是学坏了…"
                },
                {
                    "id": "761190122",
                    "speaker": "努昂诺塔",
                    "text": "！！"
                },
                {
                    "id": "761190123",
                    "speaker": "哥伦比娅",
                    "text": "努昂诺塔想邀请你来猜它躲在哪里，要和它玩一局吗？"
                },
                {
                    "id": "761190124",
                    "speaker": "Player",
                    "text": "好呀。"
                },
                {
                    "id": "761190125",
                    "speaker": "哥伦比娅",
                    "text": "请按「旗舰」的规矩，付十万摩拉作为押金。"
                },
                {
                    "id": "761190126",
                    "speaker": "派蒙",
                    "text": "这部分就不用学了吧！"
                }
            ]
        },
        {
            "id": "7611905",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761190501",
                    "speaker": "哥伦比娅",
                    "text": "努昂诺塔说它很开心，下次再一起玩吧。"
                }
            ]
        },
        {
            "id": "7611904",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7611902",
            "objective": "同努昂诺塔玩耍，猜猜它藏在哪里",
            "dialogues": [
                {
                    "id": "761190201",
                    "speaker": "努昂诺塔",
                    "text": "……！"
                },
                {
                    "id": "761190202",
                    "speaker": "哥伦比娅",
                    "text": "对你来说，是不是太简单了？"
                },
                {
                    "id": "761190203",
                    "speaker": "哥伦比娅",
                    "text": "如果下次再玩的话，我会试着让帽子们转得更快一点。"
                },
                {
                    "id": "761190204",
                    "speaker": "派蒙",
                    "text": "我有一个疑问！所以哥伦比娅刚才是怎么跟它们玩的呢？"
                },
                {
                    "id": "761190205",
                    "speaker": "派蒙",
                    "text": "不用月矩力的话就什么都看不见，用了的话未免又看得太清楚…"
                },
                {
                    "id": "761190206",
                    "speaker": "哥伦比娅",
                    "text": "我可以睁开眼睛呀。"
                },
                {
                    "id": "761190207",
                    "speaker": "派蒙",
                    "text": "呃，这是我的盲点…"
                }
            ]
        },
        {
            "id": "7611903",
            "objective": "同哥伦比娅对话",
            "dialogues": []
        },
        {
