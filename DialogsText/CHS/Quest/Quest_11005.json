    "talks": [
        {
            "id": "1100501",
            "objective": "回到清泉镇，参加料理对决",
            "dialogues": [
                {
                    "id": "110050101",
                    "speaker": "奥拉夫",
                    "text": "这里…真的是清泉镇没错吧？"
                },
                {
                    "id": "110050102",
                    "speaker": "杜拉夫",
                    "text": "是的啊，我都回答了很多次了，但是你要找的人我一个都不认识。"
                },
                {
                    "id": "110050103",
                    "speaker": "奥拉夫",
                    "text": "不可能啊，他们都住在清泉镇，都是我的邻居和朋友。"
                },
                {
                    "id": "110050104",
                    "speaker": "杜拉夫",
                    "text": "这就奇怪了，到底是怎么回事啊？",
                    "choices": [
                        {
                            "id": "110050105",
                            "text": "难道说？",
                            "response": [
                                {
                                    "id": "110050107",
                                    "speaker": "派蒙",
                                    "text": "你想到什么了？",
                                    "choices": [
                                        {
                                            "id": "110050108",
                                            "text": "这位猎人也是三百多年前幸存下来的。",
                                            "response": [
                                                {
                                                    "id": "110050109",
                                                    "speaker": "派蒙",
                                                    "text": "欸欸——！人类可以活这么长时间吗？"
                                                },
                                                {
                                                    "id": "110050112",
                                                    "speaker": "香菱",
                                                    "text": "这这这…这真的说得通吗？",
                                                    "choices": [
                                                        {
                                                            "id": "110050113",
                                                            "text": "他和野猪都被冻僵了。",
                                                            "response": [
                                                                {
                                                                    "id": "110050114",
                                                                    "speaker": "香菱",
                                                                    "text": "哦哦，是不是和食材保鲜的道理一样啊！"
                                                                },
                                                                {
                                                                    "id": "110050117",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "但就算这么说，还是难以置信。"
                                                                },
                                                                {
                                                                    "id": "110050118",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是…不是这样的话，也没有更合理的说法了。"
                                                                },
                                                                {
                                                                    "id": "110050119",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "那…你叫什么名字？"
                                                                },
                                                                {
                                                                    "id": "110050120",
                                                                    "speaker": "奥拉夫",
                                                                    "text": "我叫奥拉夫。"
                                                                },
                                                                {
                                                                    "id": "110050121",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "啊？这个名字，我在族谱上见过！"
                                                                },
                                                                {
                                                                    "id": "110050122",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "虽然记不得辈分，但确实是有这个名字的！"
                                                                },
                                                                {
                                                                    "id": "110050123",
                                                                    "speaker": "香菱",
                                                                    "text": "也就说，是曾曾曾曾…好多个曾的祖父了！"
                                                                },
                                                                {
                                                                    "id": "110050124",
                                                                    "speaker": "Player",
                                                                    "text": "其实也没隔得那么远。"
                                                                },
                                                                {
                                                                    "id": "110050125",
                                                                    "speaker": "派蒙",
                                                                    "text": "居然还有这么神奇的事啊。"
                                                                },
                                                                {
                                                                    "id": "110050126",
                                                                    "speaker": "香菱",
                                                                    "text": "嘿嘿，虽然时间晚了这么久，还是团圆了，皆大欢喜皆大欢喜！"
                                                                },
                                                                {
                                                                    "id": "110050127",
                                                                    "speaker": "香菱",
                                                                    "text": "奥拉夫先生有没有兴趣来看我们的料理对决啊？"
                                                                },
                                                                {
                                                                    "id": "110050128",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "哦哦，对了，对决的事情我听布洛克说了，我已经把场地布置好了。"
                                                                },
                                                                {
                                                                    "id": "110050129",
                                                                    "speaker": "杜拉夫",
                                                                    "text": "都跟我来吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110050115",
                                                            "text": "冰冻可以保鲜，这么说你更容易理解吧。",
                                                            "response": [
                                                                {
                                                                    "id": "110050116",
                                                                    "speaker": "香菱",
                                                                    "text": "嘿嘿，你这么解释我一下子就明白啦。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110050110",
                                            "text": "他说的是很久以前的清泉镇。",
                                            "response": [
                                                {
                                                    "id": "110050111",
                                                    "speaker": "派蒙",
                                                    "text": "很久以前…难道是几百年前？！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110050106",
                            "text": "我大概明白了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100502",
            "objective": "在料理对决现场与香菱交谈",
            "dialogues": [
                {
                    "id": "110050201",
                    "speaker": "香菱",
                    "text": "我们的食材已经都准备好了，你呢？"
                },
                {
                    "id": "110050202",
                    "speaker": "布洛克",
                    "text": "当然准备好了。对决的时候，齐格芙丽雅会担任我的副手。"
                },
                {
                    "id": "110050203",
                    "speaker": "杜拉夫",
                    "text": "那现在开始比赛，我就来当这个评委了。"
                },
                {
                    "id": "110050204",
                    "speaker": "杜拉夫",
                    "text": "放心，虽然我认识布洛克时间更长，但我会公正评判的。"
                },
                {
                    "id": "110050205",
                    "speaker": "香菱",
                    "text": "#那就拜托你了。{NICKNAME}，派蒙，我们快去做准备吧！"
                },
                {
                    "id": "110050206",
                    "speaker": "派蒙",
                    "text": "我们还要参加吗？"
                },
                {
                    "id": "110050207",
                    "speaker": "香菱",
                    "text": "当然了，布洛克都找了副手，你们就当我的副手吧！关键时候都靠你们了！"
                },
                {
                    "id": "110050208",
                    "speaker": "派蒙",
                    "text": "什么时候变成副手了…",
                    "choices": [
                        {
                            "id": "110050209",
                            "text": "奉陪到底吧。",
                            "response": [
                                {
                                    "id": "110050211",
                                    "speaker": "派蒙",
                                    "text": "好吧，为了好吃的我也会努力的！"
                                }
                            ]
                        },
                        {
                            "id": "110050210",
                            "text": "拿她没办法…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100503",
            "objective": "在料理对决中协助香菱",
            "dialogues": [
                {
                    "id": "110050301",
                    "speaker": "香菱",
                    "text": "首先是食材的问题，肉排需要点缀，但食材里我没找到很合适的。嗯，我想想…"
                },
                {
                    "id": "110050302",
                    "speaker": "香菱",
                    "text": "啊，我想到了，用白萝卜吧！白萝卜削成泥，或者切成丝都很爽口。"
                },
                {
                    "id": "110050303",
                    "speaker": "香菱",
                    "text": "还能雕成花来装饰！一举两得！"
                },
                {
                    "id": "110050304",
                    "speaker": "香菱",
                    "text": "麻烦你去找一下白萝卜吧，这附近应该就有。对了对了，要洗干净！因为是直接入菜的！"
                }
            ]
        },
        {
            "id": "1100505",
            "objective": "寻找白萝卜",
            "dialogues": []
        },
        {
            "id": "1100506",
            "objective": "前往湖边清洗白萝卜",
            "dialogues": []
        },
        {
            "id": "1100507",
            "objective": "清理史莱姆（加分点）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1100508",
            "objective": "将洗干净的白萝卜交给香菱",
            "dialogues": [
                {
                    "id": "110050801",
                    "speaker": "香菱",
                    "text": "哇，又大又水灵，太完美了，谢谢你们！"
                },
                {
                    "id": "110050802",
                    "speaker": "香菱",
                    "text": "嗯，我想想看，要不然…"
                },
                {
                    "id": "110050803",
                    "speaker": "派蒙",
                    "text": "呜哇！你看，香菱，锅都烧起来了！"
                },
                {
                    "id": "110050804",
                    "speaker": "香菱",
                    "text": "啊啊啊！不好！这样会烧焦的！"
                },
                {
                    "id": "110050805",
                    "speaker": "香菱",
                    "text": "#{NICKNAME}，快帮我把锅的火控制下来！记得别用水去浇啊，不然也白做了！"
                }
            ]
        },
        {
            "id": "1100509",
            "objective": "控制三口锅的火势",
            "dialogues": []
        },
        {
            "id": "1100510",
            "objective": "继续帮助香菱",
            "dialogues": [
                {
                    "id": "110051002",
                    "speaker": "香菱",
                    "text": "啊啊…全都烧焦了，呜呜呜，只好再做一些了。"
                },
                {
                    "id": "110051003",
                    "speaker": "香菱",
                    "text": "对了，我在考虑主菜是不是单薄了一些，想要有一些变化。"
                },
                {
                    "id": "110051004",
                    "speaker": "香菱",
                    "text": "帮我做一份野菇鸡肉串吧！外面咔嚓咔嚓，里面滴答滴答的那种！",
                    "choices": [
                        {
                            "id": "110051005",
                            "text": "听不懂…",
                            "response": [
                                {
                                    "id": "110051007",
                                    "speaker": "派蒙",
                                    "text": "就是要<color=#00E1FFFF>美味的，最美味的那种</color>！"
                                }
                            ]
                        },
                        {
                            "id": "110051006",
                            "text": "派蒙帮我翻译一下！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100511",
            "objective": "烹饪「美味的野菇鸡肉串」",
            "dialogues": []
        },
        {
            "id": "1100512",
            "objective": "将「美味的野菇鸡肉串」交给香菱",
            "dialogues": [
                {
                    "id": "110051201",
                    "speaker": "香菱",
                    "text": "#好香啊，{NICKNAME}，你真是有做菜的天赋！"
                },
                {
                    "id": "110051202",
                    "speaker": "香菱",
                    "text": "现在主菜的制作很顺利，但距离完美…可能还差点特别的感觉。"
                },
                {
                    "id": "110051203",
                    "speaker": "派蒙",
                    "text": "感觉？"
                },
                {
                    "id": "110051204",
                    "speaker": "香菱",
                    "text": "就是那种「噼咔」的感觉！"
                },
                {
                    "id": "110051205",
                    "speaker": "派蒙",
                    "text": "啊啊，原来是「噼咔」的感觉！",
                    "choices": [
                        {
                            "id": "110051206",
                            "text": "为什么你又理解了！",
                            "response": [
                                {
                                    "id": "110051208",
                                    "speaker": "香菱",
                                    "text": "如果只是这样端上去，太浪费这么好的材料了。"
                                },
                                {
                                    "id": "110051209",
                                    "speaker": "香菱",
                                    "text": "我想想看…啊啊，如果能有什么能增添风味的东西就好了。"
                                },
                                {
                                    "id": "110051210",
                                    "speaker": "派蒙",
                                    "text": "风味？"
                                },
                                {
                                    "id": "110051211",
                                    "speaker": "香菱",
                                    "text": "对，最好是就在这附近有的，很少用来入菜的生物。"
                                },
                                {
                                    "id": "110051212",
                                    "speaker": "香菱",
                                    "text": "天上飞的，地上爬的都行，可以是昆虫，或者…蹦蹦跳跳的？"
                                },
                                {
                                    "id": "110051213",
                                    "speaker": "派蒙",
                                    "text": "真的要加听起来这么恐怖的东西进去吗？"
                                },
                                {
                                    "id": "110051214",
                                    "speaker": "香菱",
                                    "text": "没事啦，相信我的直觉！"
                                },
                                {
                                    "id": "110051215",
                                    "speaker": "派蒙",
                                    "text": "好吧…"
                                }
                            ]
                        },
                        {
                            "id": "110051207",
                            "text": "所以这到底是外语还是方言啊！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100513",
            "objective": "找到符合描述的食材",
            "dialogues": [
                {
                    "id": "110051301",
                    "speaker": "香菱",
                    "text": "辛苦了辛苦了！快让我看看你找到了什么？",
                    "choices": [
                        {
                            "id": "110051302",
                            "text": "将食材交给香菱。"
                        },
                        {
                            "id": "110051303",
                            "text": "我还得再去找找…",
                            "response": [
                                {
                                    "id": "110051304",
                                    "speaker": "香菱",
                                    "text": "不好意思要麻烦你再跑一趟。"
                                },
                                {
                                    "id": "110051305",
                                    "speaker": "香菱",
                                    "text": "我想要的是一种很少入菜的生物。"
                                },
                                {
                                    "id": "110051306",
                                    "speaker": "香菱",
                                    "text": "天上飞的，地上爬的，跳的，都可以！也可以是昆虫！"
                                },
                                {
                                    "id": "110051399",
                                    "speaker": "香菱",
                                    "text": "可能有点难找，但我相信你绝对没问题的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100514",
            "objective": "询问香菱对食材是否满意",
            "dialogues": [
                {
                    "id": "110051401",
                    "speaker": "派蒙",
                    "text": "真的要加这种东西进去吗…"
                },
                {
                    "id": "110051402",
                    "speaker": "派蒙",
                    "text": "总感觉会怪怪的。"
                },
                {
                    "id": "110051403",
                    "speaker": "香菱",
                    "text": "放心放心，谢谢你们找来这么好的东西，我现在要专心料理了。"
                },
                {
                    "id": "110051404",
                    "speaker": "香菱",
                    "text": "如果还有需要帮忙的事，还要再麻烦你们了，嘿嘿！"
                }
            ]
        },
        {
            "id": "1100504",
            "objective": "比赛倒计时、计分判断用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1100515",
            "objective": "询问香菱是否还需帮忙",
            "dialogues": [
                {
                    "id": "110051501",
                    "speaker": "香菱",
                    "text": "对了对了，配菜。还需要一道配菜！",
                    "choices": [
                        {
                            "id": "110051502",
                            "text": "我来做吧。",
                            "response": [
                                {
                                    "id": "110051503",
                                    "speaker": "香菱",
                                    "text": "欸？没问题吗？"
                                },
                                {
                                    "id": "110051506",
                                    "speaker": "香菱",
                                    "text": "那么这个就交给你了，这是我临时写的！"
                                },
                                {
                                    "id": "110051507",
                                    "speaker": "香菱",
                                    "text": "里面提到的材料也全都给你们。"
                                },
                                {
                                    "id": "110051508",
                                    "speaker": "派蒙",
                                    "text": "这就是你之前给我们吃的那个菜的<color=#00E1FFFF>食谱</color>吗？！"
                                },
                                {
                                    "id": "110051509",
                                    "speaker": "香菱",
                                    "text": "是的，我又改良了一下，把多出来的璃月食材用上了。"
                                },
                                {
                                    "id": "110051510",
                                    "speaker": "派蒙",
                                    "text": "这么难的料理，真的能做好吗…"
                                },
                                {
                                    "id": "110051511",
                                    "speaker": "香菱",
                                    "text": "料理技术不重要，重要的是热爱！这是爸爸告诉我的。"
                                },
                                {
                                    "id": "110051512",
                                    "speaker": "香菱",
                                    "text": "你们帮了我这么多忙，一定也非常热爱料理吧。"
                                },
                                {
                                    "id": "110051513",
                                    "speaker": "香菱",
                                    "text": "我相信你们，绝对能做出最美味的配菜的！",
                                    "choices": [
                                        {
                                            "id": "110051514",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "110051515",
                                                    "speaker": "香菱",
                                                    "text": "我喜欢这么有自信的回答！"
                                                },
                                                {
                                                    "id": "110051518",
                                                    "speaker": "香菱",
                                                    "text": "准备好，最后冲刺啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110051516",
                                            "text": "希望不会拖后腿。",
                                            "response": [
                                                {
                                                    "id": "110051517",
                                                    "speaker": "香菱",
                                                    "text": "别这么想，烹饪是件很快乐的事，放轻松放轻松！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110051504",
                            "text": "就算我不说也会让我来做吧。",
                            "response": [
                                {
                                    "id": "110051505",
                                    "speaker": "香菱",
                                    "text": "谢谢！你很了解我嘛，嘿嘿。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100599",
            "objective": "火腿$HIDDEN",
            "dialogues": [
                {
                    "id": "110059901",
                    "speaker": "杜拉夫",
                    "text": "蒙德与璃月的料理碰撞，想想就让人觉得兴奋。"
                }
            ]
        },
        {
            "id": "1100516",
            "objective": "烹饪「美味的翡玉什锦袋」",
            "dialogues": [
                {
                    "id": "110051601",
                    "speaker": "香菱",
                    "text": "「翡玉什锦袋」做好了吗？"
                },
                {
                    "id": "110051602",
                    "speaker": "香菱",
                    "text": "味道最重要，但也别耽误太长的时间。等你做好拿过来，我就出菜！"
                }
            ]
        },
        {
            "id": "1100517",
            "objective": "将「美味的翡玉什锦袋」交给香菱",
            "dialogues": [
                {
                    "id": "110051701",
                    "speaker": "香菱",
                    "text": "哇，香味在很远的地方就已经飘过来了！"
                },
                {
                    "id": "110051702",
                    "speaker": "香菱",
                    "text": "一切就绪，准备出菜！我们一定会赢的！"
                }
            ]
        },
        {
            "id": "1100518",
            "objective": "与杜拉夫交谈，等待结果",
            "dialogues": [
                {
                    "id": "110051801",
                    "speaker": "杜拉夫",
                    "text": "真是美味的大餐，居然能吃到这么好吃的东西。"
                },
                {
                    "id": "110051802",
                    "speaker": "杜拉夫",
                    "text": "两位大厨的手艺我都尝过了，实在是难分高下。"
                },
                {
                    "id": "110051803",
                    "speaker": "杜拉夫",
                    "text": "不过既然是比赛就要有胜负，在这里我宣布——"
                },
                {
                    "id": "110051804",
                    "speaker": "杜拉夫",
                    "text": "香菱的料理更胜一筹。"
                },
                {
                    "id": "110051805",
                    "speaker": "香菱",
                    "text": "耶！赢啦！太好了！"
                },
                {
                    "id": "110051806",
                    "speaker": "布洛克",
                    "text": "唉，本来以为我的「野猪王在争夺地盘的决斗后负伤的胜者刚刚长好的那块新鲜嫩肉」是不会输的啊。"
                },
                {
                    "id": "110051807",
                    "speaker": "布洛克",
                    "text": "果然还是敌不过已经灭绝的野猪肉的味道。"
                },
                {
                    "id": "110051808",
                    "speaker": "杜拉夫",
                    "text": "什么？这居然是用已经灭绝的猪肉做的？"
                },
                {
                    "id": "110051809",
                    "speaker": "香菱",
                    "text": "对啊，全都做成料理了。"
                },
                {
                    "id": "110051810",
                    "speaker": "杜拉夫",
                    "text": "那我岂不是一口吃掉了几十万摩拉！"
                },
                {
                    "id": "110051811",
                    "speaker": "杜拉夫",
                    "text": "要是拿去卖的话，能顶得上镇子几年狩猎的收入了吧！"
                },
                {
                    "id": "110051812",
                    "speaker": "香菱",
                    "text": "哈哈，好吃就可以了，摩拉什么的不重要啦。"
                },
                {
                    "id": "110051813",
                    "speaker": "香菱",
                    "text": "对了，既然评审已经结束了，大家都来尝尝吧！我做了很多的！"
                },
                {
                    "id": "110051814",
                    "speaker": "香菱",
                    "text": "我也尝尝布洛克的手艺。"
                },
                {
                    "id": "110051815",
                    "speaker": "布洛克",
                    "text": "这种美味…唉，输得心服口服呢。"
                },
                {
                    "id": "110051816",
                    "speaker": "齐格芙丽雅",
                    "text": "输是输了，但能吃到这么好吃的菜，我也满足了！麻烦再来一份！"
                },
                {
                    "id": "110051817",
                    "speaker": "香菱",
                    "text": "原来这个也这么美味，这层次分明的口感…"
                },
                {
                    "id": "110051818",
                    "speaker": "香菱",
                    "text": "#要是我没有这块美味的肉，还有{NICKNAME}做得这么棒的配菜，胜负真不好说啊。"
                },
                {
                    "id": "110051819",
                    "speaker": "派蒙",
                    "text": "轮到我来吃了！"
                },
                {
                    "id": "110051820",
                    "speaker": "奥拉夫",
                    "text": "我也尝一点吧。"
                },
                {
                    "id": "110051821",
                    "speaker": "奥拉夫",
                    "text": "这…这味道？！"
                },
                {
                    "id": "110051822",
                    "speaker": "奥拉夫",
                    "text": "是清泉镇…不，应该说是以前的清泉镇的味道。"
                },
                {
                    "id": "110051823",
                    "speaker": "Player",
                    "text": "好吃到哭了…"
                },
                {
                    "id": "110051824",
                    "speaker": "奥拉夫",
                    "text": "呜呜，这是…这是，最后几口那个时代的味道了…"
                },
                {
                    "id": "110051825",
                    "speaker": "香菱",
                    "text": "啊啊，别伤心，别伤心，你想要这种味道的话，我还可以做的！"
                },
                {
                    "id": "110051826",
                    "speaker": "奥拉夫",
                    "text": "真、真的吗？但是那种古代野猪已经灭绝了…"
                },
                {
                    "id": "110051827",
                    "speaker": "香菱",
                    "text": "是这样没错，但是味道没有灭绝啊，用其他的材料还可以做出来的。"
                },
                {
                    "id": "110051828",
                    "speaker": "香菱",
                    "text": "给食客带来笑容，这就是厨师的使命啊！"
                },
                {
                    "id": "110051829",
                    "speaker": "奥拉夫",
                    "text": "谢谢你，呜…呜呜呜呜…"
                }
            ]
        },
        {
            "id": "1100519",
            "objective": "接受香菱的感谢",
            "dialogues": [
                {
                    "id": "110051901",
                    "speaker": "香菱",
                    "text": "非常感谢你，没有你的帮忙，还不知道会怎么样呢。"
                },
                {
                    "id": "110051902",
                    "speaker": "派蒙",
                    "text": "也多亏你，我尝到了好多好多好吃的东西。"
                },
                {
                    "id": "110051903",
                    "speaker": "派蒙",
                    "text": "好饱好饱。"
                },
                {
                    "id": "110051904",
                    "speaker": "Player",
                    "text": "接下来打算去哪里？"
                },
                {
                    "id": "110051905",
                    "speaker": "香菱",
                    "text": "不知道，打算回一趟璃月港，但可能中途就改变了计划。"
                },
                {
                    "id": "110051906",
                    "speaker": "香菱",
                    "text": "因为我不喜欢计划这种东西嘛。"
                },
                {
                    "id": "110051907",
                    "speaker": "香菱",
                    "text": "说不定你又会在野外的某个地方遇到我。"
                },
                {
                    "id": "110051908",
                    "speaker": "派蒙",
                    "text": "真是洒脱啊。"
                },
                {
                    "id": "110051909",
                    "speaker": "香菱",
                    "text": "#我觉得你很有料理的天赋，{NICKNAME}，翡玉什锦袋完成得很好。"
                },
                {
                    "id": "110051910",
                    "speaker": "香菱",
                    "text": "有空来「万民堂」吧！说好了请你们吃好吃的！"
                },
                {
                    "id": "110051911",
                    "speaker": "香菱",
                    "text": "如果想学的话，还能教你几道创新菜！",
                    "choices": [
                        {
                            "id": "110051912",
                            "text": "一言为定。",
                            "response": [
                                {
                                    "id": "110051913",
                                    "speaker": "香菱",
                                    "text": "一言为定！"
                                },
                                {
                                    "id": "110051916",
                                    "speaker": "香菱",
                                    "text": "#嘿嘿，那我们有机会再见啦，{NICKNAME}！"
                                }
                            ]
                        },
                        {
                            "id": "110051914",
                            "text": "史莱姆滑野蘑菇就免了…",
                            "response": [
                                {
                                    "id": "110051915",
                                    "speaker": "香菱",
                                    "text": "啊？为什么你会知道我在想什么？！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100595",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110059501",
                    "speaker": "香菱",
                    "text": "咔嚓咔嚓，滴答滴答~咔嚓咔嚓，滴答滴答~"
                }
            ]
        },
        {
            "id": "1100596",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110059601",
                    "speaker": "香菱",
                    "text": "快把火压下去，要烧焦了！"
                }
            ]
        },
        {
            "id": "1100597",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110059701",
                    "speaker": "香菱",
                    "text": "麻烦找些白萝卜回来，记得要去湖边洗干净哦？"
                }
            ]
        },
        {
            "id": "1100598",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110059801",
                    "speaker": "布洛克",
                    "text": "怎么？来打探敌情？"
                },
                {
                    "id": "110059802",
                    "speaker": "布洛克",
                    "text": "哼哼，我已经拿到了必胜的材料，你们不可能赢的。"
                },
                {
                    "id": "110059803",
                    "speaker": "齐格芙丽雅",
                    "text": "好香啊…偷吃一点点应该没关系吧？"
                },
                {
                    "id": "110059804",
                    "speaker": "齐格芙丽雅",
                    "text": "不行不行，我是来帮忙的…比赛要紧，比赛要紧！"
                },
                {
                    "id": "110059805",
                    "speaker": "奥拉夫",
                    "text": "我们原来都是烤一烤就直接吃，现在居然有这么多花样了…"
                }
            ]
        }
    ]
}