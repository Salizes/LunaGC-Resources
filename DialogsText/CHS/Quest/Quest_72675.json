        {
            "id": "7267501",
            "objective": "前往孤云阁",
            "dialogues": [
                {
                    "id": "726750101",
                    "speaker": "「吉法师」",
                    "text": "和雪山不同，不冷。也没有雪。"
                },
                {
                    "id": "726750102",
                    "speaker": "派蒙",
                    "text": "这里是孤云阁！传说是当年岩王帝君击败那个…那个…很多头的大水蛇，叫什么来着？",
                    "choices": [
                        {
                            "id": "726750103",
                            "text": "漩涡之魔神？",
                            "response": [
                                {
                                    "id": "726750105",
                                    "speaker": "派蒙",
                                    "text": "啊，对！漩涡之魔神奥赛尔！当年就是在这里，被石枪打败、镇压的。"
                                },
                                {
                                    "id": "726750106",
                                    "speaker": "「吉法师」",
                                    "text": "哇！"
                                },
                                {
                                    "id": "726750107",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，厉害吧？不过我们也和它战斗过！我们在凝光小姐的群玉阁上…"
                                },
                                {
                                    "id": "726750108",
                                    "speaker": "「吉法师」",
                                    "text": "金色的晶蝶！"
                                },
                                {
                                    "id": "726750109",
                                    "speaker": "派蒙",
                                    "text": "原来是在感叹这个喔！好好听人说话啦！"
                                },
                                {
                                    "id": "726750110",
                                    "speaker": "Player",
                                    "text": "毕竟和稻妻的晶蝶不同…"
                                },
                                {
                                    "id": "726750111",
                                    "speaker": "Player",
                                    "text": "他应该没见过不是紫色的晶蝶…"
                                },
                                {
                                    "id": "726750112",
                                    "speaker": "派蒙",
                                    "text": "#嗯…也是啦。真拿吉法师没办法。{NICKNAME}，抓个晶蝶给他看看吧！",
                                    "choices": [
                                        {
                                            "id": "726750113",
                                            "text": "为什么不是你去抓？",
                                            "response": [
                                                {
                                                    "id": "726750114",
                                                    "speaker": "派蒙",
                                                    "text": "但是，明明是你比较熟练嘛。"
                                                },
                                                {
                                                    "id": "726750118",
                                                    "speaker": "Player",
                                                    "text": "可以是可以，不过只能抓到晶核。"
                                                },
                                                {
                                                    "id": "726750119",
                                                    "speaker": "「吉法师」",
                                                    "text": "好棒！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726750115",
                                            "text": "会飞的明明是你。",
                                            "response": [
                                                {
                                                    "id": "726750116",
                                                    "speaker": "派蒙",
                                                    "text": "但是，抓晶蝶还是你比较熟练嘛。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726750117",
                                            "text": "好吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726750104",
                            "text": "奥赛尔？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267502",
            "objective": "将1枚晶核交给吉法师",
            "dialogues": [
                {
                    "id": "726750201",
                    "speaker": "「吉法师」",
                    "text": "砰砰~晶蝶~金色的晶蝶~"
                }
            ]
        },
        {
            "id": "7267503",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "726750301",
                    "speaker": "「吉法师」",
                    "text": "…"
                },
                {
                    "id": "726750302",
                    "speaker": "「吉法师」",
                    "text": "不是金色。"
                },
                {
                    "id": "726750303",
                    "speaker": "派蒙",
                    "text": "欸！震惊！居然不是金色的！",
                    "choices": [
                        {
                            "id": "726750304",
                            "text": "就算你们这么说…",
                            "response": [
                                {
                                    "id": "726750306",
                                    "speaker": "派蒙",
                                    "text": "这么一想，虽然和你旅行的时候抓过很多晶蝶，但从来没注意过…"
                                },
                                {
                                    "id": "726750307",
                                    "speaker": "派蒙",
                                    "text": "有种…我有种自己突然长大了，有些幻想破灭了的感觉…？"
                                },
                                {
                                    "id": "726750308",
                                    "speaker": "Player",
                                    "text": "看来派蒙也需要修行。"
                                },
                                {
                                    "id": "726750309",
                                    "speaker": "「吉法师」",
                                    "text": "白毛加油。"
                                },
                                {
                                    "id": "726750310",
                                    "speaker": "派蒙",
                                    "text": "真是的，别给我加油啦！明明是吉法师要修行。"
                                },
                                {
                                    "id": "726750311",
                                    "speaker": "派蒙",
                                    "text": "不过，还是有点失望喔…为什么岩晶蝶的晶核不是金色的呢？"
                                },
                                {
                                    "id": "726750312",
                                    "speaker": "「吉法师」",
                                    "text": "对。晶蝶是金色，为什么不是金色。",
                                    "choices": [
                                        {
                                            "id": "726750313",
                                            "text": "可能晶蝶就是这样的物种。",
                                            "response": [
                                                {
                                                    "id": "726750315",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…没办法了。总之，按原计划行动吧。我们带吉法师看看死兆星号！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726750314",
                                            "text": "就算你们问我我也不知道…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726750305",
                            "text": "这个我也没办法。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267504",
            "objective": "前往能看见死兆星号的地方",
            "dialogues": [
                {
                    "id": "726750401",
                    "speaker": "派蒙",
                    "text": "看，死兆星号！"
                },
                {
                    "id": "726750402",
                    "speaker": "「吉法师」",
                    "text": "好厉害！好多水！"
                },
                {
                    "id": "726750403",
                    "speaker": "「吉法师」",
                    "text": "而且，好大！好大而且在水上！"
                },
                {
                    "id": "726750404",
                    "speaker": "「吉法师」",
                    "text": "这么大，一定很重。为什么不会沉下去？"
                },
                {
                    "id": "726750405",
                    "speaker": "派蒙",
                    "text": "因为死兆星号是船呀。"
                },
                {
                    "id": "726750406",
                    "speaker": "「吉法师」",
                    "text": "但是，泥巴船就会沉。五百藏说过。兔子、妖狸、泥巴船的故事。"
                },
                {
                    "id": "726750407",
                    "speaker": "派蒙",
                    "text": "嗯…不过，北斗的死兆星号不是泥巴做的，所以不会沉。"
                },
                {
                    "id": "726750408",
                    "speaker": "「吉法师」",
                    "text": "为什么不是泥巴，就不会沉？"
                },
                {
                    "id": "726750409",
                    "speaker": "派蒙",
                    "text": "吉法师说话倒是越来越流利了…不过应该怎么说呢…对了…"
                },
                {
                    "id": "726750410",
                    "speaker": "派蒙",
                    "text": "#哼哼，{NICKNAME}，让我考考你。为什么船能浮在水面上？",
                    "choices": [
                        {
                            "id": "726750411",
                            "text": "船是木头做的，草元素厉害。",
                            "response": [
                                {
                                    "id": "726750412",
                                    "speaker": "派蒙",
                                    "text": "欸？草元素有这样的作用吗？"
                                },
                                {
                                    "id": "726750413",
                                    "speaker": "派蒙",
                                    "text": "唔…不过，为什么拿盾牌的丘丘人不能浮在水面上呢？"
                                },
                                {
                                    "id": "726750416",
                                    "speaker": "「吉法师」",
                                    "text": "呜呶呶，听不懂。"
                                },
                                {
                                    "id": "726750417",
                                    "speaker": "派蒙",
                                    "text": "没关系，等吉法师长大以后，变得像派蒙一样聪明，就能明白了。为什么船能浮起来，为什么雪山会下雪，都能明白。",
                                    "choices": [
                                        {
                                            "id": "726750418",
                                            "text": "我看你也不懂吧。",
                                            "response": [
                                                {
                                                    "id": "726750419",
                                                    "speaker": "派蒙",
                                                    "text": "喂！"
                                                },
                                                {
                                                    "id": "726750422",
                                                    "speaker": "派蒙",
                                                    "text": "不管怎么说，这里正好可以看到死兆星号，给吉法师留影吧！"
                                                },
                                                {
                                                    "id": "726750423",
                                                    "speaker": "「吉法师」",
                                                    "text": "留影！画像！"
                                                },
                                                {
                                                    "id": "726750424",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，没错！吉法师站好别乱跑喔！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726750420",
                                            "text": "现在不用明白也行的。"
                                        },
                                        {
                                            "id": "726750421",
                                            "text": "有些事情不明白也行的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726750414",
                            "text": "浮力大于重力，船就能浮起来。",
                            "response": [
                                {
                                    "id": "726750415",
                                    "speaker": "派蒙",
                                    "text": "原来是这样吗！嗯嗯我明白了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267505",
            "objective": "为吉法师拍照",
            "dialogues": []
        },
        {
            "id": "7267506",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "726750601",
                    "speaker": "派蒙",
                    "text": "接下来，带吉法师我们去死兆星上看看吧！"
                },
                {
                    "id": "726750602",
                    "speaker": "「吉法师」",
                    "text": "不好。船要是沉呶…"
                },
                {
                    "id": "726750603",
                    "speaker": "Player",
                    "text": "这艘船不会沉的。"
                },
                {
                    "id": "726750604",
                    "speaker": "Player",
                    "text": "我们就是坐这个船，去的稻妻。"
                },
                {
                    "id": "726750605",
                    "speaker": "派蒙",
                    "text": "对呀！然后，我们才认识了五百藏和吉法师。不用担心！"
                },
                {
                    "id": "726750606",
                    "speaker": "「吉法师」",
                    "text": "喔！原来是这样。"
                },
                {
                    "id": "726750607",
                    "speaker": "派蒙",
                    "text": "而且北斗大姐头很可靠，南十字星的人也很可靠。所以呀，这艘船就是海上最安全的地方。"
                },
                {
                    "id": "726750608",
                    "speaker": "「吉法师」",
                    "text": "呶！好！"
                }
            ]
        },
        {
            "id": "7267507",
            "objective": "前往死兆星号",
            "dialogues": []
        },
        {
            "id": "7267508",
            "objective": "登上桅杆",
            "dialogues": [
                {
                    "id": "726750801",
                    "speaker": "派蒙",
                    "text": "你看！视线很好吧？"
                },
                {
                    "id": "726750802",
                    "speaker": "「吉法师」",
                    "text": "呶，好厉害。"
                },
                {
                    "id": "726750803",
                    "speaker": "「吉法师」",
                    "text": "那边好多山。是什么地方？"
                },
                {
                    "id": "726750804",
                    "speaker": "派蒙",
                    "text": "嗯？那边的话…",
                    "choices": [
                        {
                            "id": "726750805",
                            "text": "是稻妻。",
                            "response": [
                                {
                                    "id": "726750807",
                                    "speaker": "派蒙",
                                    "text": "没错！那边应该就是影向山。影向山下面，就是镇守之森。"
                                },
                                {
                                    "id": "726750808",
                                    "speaker": "「吉法师」",
                                    "text": "好远。五百藏在海的那边。"
                                },
                                {
                                    "id": "726750809",
                                    "speaker": "派蒙",
                                    "text": "嗯。不过，我们会陪你一起修行的！"
                                },
                                {
                                    "id": "726750810",
                                    "speaker": "「吉法师」",
                                    "text": "嗯！"
                                },
                                {
                                    "id": "726750811",
                                    "speaker": "派蒙",
                                    "text": "接下来，去什么地方好呢…"
                                },
                                {
                                    "id": "726750812",
                                    "speaker": "派蒙",
                                    "text": "唔，有没有什么对我们来说很熟悉，又有好吃的东西的地方呢…",
                                    "choices": [
                                        {
                                            "id": "726750813",
                                            "text": "派蒙就想着吃。",
                                            "response": [
                                                {
                                                    "id": "726750814",
                                                    "speaker": "「吉法师」",
                                                    "text": "好吃的东西，好。"
                                                },
                                                {
                                                    "id": "726750815",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}你看，吉法师就比较懂。吃遍世界上好吃的东西，也是很重要的修行。"
                                                },
                                                {
                                                    "id": "726750816",
                                                    "speaker": "派蒙",
                                                    "text": "如果不能理解这样的道理，吉法师很快就会超越你啦！"
                                                },
                                                {
                                                    "id": "726750818",
                                                    "speaker": "派蒙",
                                                    "text": "哎呀，不管怎么说，爬桅杆真累人呢。"
                                                },
                                                {
                                                    "id": "726750819",
                                                    "speaker": "「吉法师」",
                                                    "text": "白毛要爬？明明会飞。"
                                                },
                                                {
                                                    "id": "726750820",
                                                    "speaker": "派蒙",
                                                    "text": "别在意这种细节！"
                                                },
                                                {
                                                    "id": "726750821",
                                                    "speaker": "派蒙",
                                                    "text": "总之，今天就到这里吧。接下来去什么地方，让我好好考虑一下。"
                                                },
                                                {
                                                    "id": "726750822",
                                                    "speaker": "「吉法师」",
                                                    "text": "呶！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726750817",
                                            "text": "这么说来，我也饿了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726750806",
                            "text": "是你住的地方。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722640801",
                    "speaker": "五百藏",
                    "text": "让这孩子多看看外面的世界吧。吾辈做不到的事情，就交给你了。"
                }
            ]
        },
        {
            "id": "7226414",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722641401",
                    "speaker": "「吉法师」",
                    "text": "呶！修行开心。",
                    "choices": [
                        {
                            "id": "722641402",
                            "text": "开心就好。",
                            "response": [
                                {
                                    "id": "722641403",
                                    "speaker": "「吉法师」",
                                    "text": "黄毛好强。砰砰，好大好圆就没了。"
                                },
                                {
                                    "id": "722641404",
                                    "speaker": "Player",
                                    "text": "因为平时有在锻炼。"
                                },
                                {
                                    "id": "722641405",
                                    "speaker": "「吉法师」",
                                    "text": "呶！想和黄毛一样强。"
                                },
                                {
                                    "id": "722641406",
                                    "speaker": "「吉法师」",
                                    "text": "所以修行。修行修行，变强变强。"
                                },
                                {
                                    "id": "722641407",
                                    "speaker": "Player",
                                    "text": "吉法师变强了以后，想干什么？"
                                },
                                {
                                    "id": "722641408",
                                    "speaker": "「吉法师」",
                                    "text": "报复刑部小判，呶哈哈。"
                                },
                                {
                                    "id": "722641409",
                                    "speaker": "「吉法师」",
                                    "text": "把五百藏变成不是石头。"
                                },
                                {
                                    "id": "722641410",
                                    "speaker": "Player",
                                    "text": "加油。修行的路线就交给我们吧。"
                                },
                                {
                                    "id": "722641411",
                                    "speaker": "「吉法师」",
                                    "text": "呶！"
                                }
                            ]
                        },
                        {
                            "id": "722641412",
                            "text": "开心就好。回头见。",
                            "response": [
                                {
                                    "id": "722641413",
                                    "speaker": "「吉法师」",
                                    "text": "耶！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}