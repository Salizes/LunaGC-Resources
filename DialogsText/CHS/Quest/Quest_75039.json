    "talks": [
        {
            "id": "7503921",
            "objective": "（test）判断是否见过马尼飞科$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503901",
            "objective": "(test)隐藏踩圈$HIDDEN",
            "dialogues": [
                {
                    "id": "750390101",
                    "speaker": "？？？",
                    "text": "你好，黑暗，我的老朋友…"
                },
                {
                    "id": "750390102",
                    "speaker": "派蒙",
                    "text": "呜哇…是一个…说话像大人的小孩子，好奇怪！"
                },
                {
                    "id": "750390103",
                    "speaker": "派蒙",
                    "text": "欸？等等，这不是「了不起的马尼菲科」吗！",
                    "choices": [
                        {
                            "id": "750390104",
                            "text": "马…马什么了？",
                            "response": [
                                {
                                    "id": "750390105",
                                    "speaker": "马尼菲科",
                                    "text": "马…马尼菲科，了不起的马尼菲科！"
                                },
                                {
                                    "id": "750390106",
                                    "speaker": "马尼菲科",
                                    "text": "呃…我知道我现在的样子有那么一点点落魄，但请给我点水，救救我。"
                                },
                                {
                                    "id": "750390119",
                                    "speaker": "马尼菲科",
                                    "text": "水…请给我水…谢谢…"
                                },
                                {
                                    "id": "750390120",
                                    "speaker": "派蒙",
                                    "text": "哇…这家伙又变回半死不活的样子了…我们救救他吧？"
                                }
                            ]
                        },
                        {
                            "id": "750390107",
                            "text": "一点也不像是「了不起」的样子呢…",
                            "response": [
                                {
                                    "id": "750390108",
                                    "speaker": "派蒙",
                                    "text": "变得像小鱼干一样了，真可怜。"
                                },
                                {
                                    "id": "750390109",
                                    "speaker": "马尼菲科",
                                    "text": "喂！有点身为人类的同理心好吗！"
                                }
                            ]
                        },
                        {
                            "id": "750390110",
                            "text": "你好，我是黑暗，你的老朋友。",
                            "response": [
                                {
                                    "id": "750390111",
                                    "speaker": "派蒙",
                                    "text": "什么…？"
                                },
                                {
                                    "id": "750390112",
                                    "speaker": "马尼菲科",
                                    "text": "哈！对，就是那首歌！我也喜欢那个！"
                                },
                                {
                                    "id": "750390113",
                                    "speaker": "马尼菲科",
                                    "text": "啊…西梅翁和卡本克尔兄弟，怎么也听不倦…说起来，我上一个工作还是因为他们丢的。所以我才会到这里来，冒这该死的险…"
                                },
                                {
                                    "id": "750390114",
                                    "speaker": "马尼菲科",
                                    "text": "呃…不过那就是后话啦，嘿嘿。现在要紧的是，给我整点水喝，好吗？"
                                },
                                {
                                    "id": "750390115",
                                    "speaker": "马尼菲科",
                                    "text": "毕竟，嗯，嘿嘿…就是，呵呵，真不好意思，我要渴死了，嘿嘿…"
                                },
                                {
                                    "id": "750390116",
                                    "speaker": "派蒙",
                                    "text": "性命关天的事，你傻笑个什么劲啦！"
                                },
                                {
                                    "id": "750390117",
                                    "speaker": "马尼菲科",
                                    "text": "不知道，回光返照吧。"
                                },
                                {
                                    "id": "750390118",
                                    "speaker": "派蒙",
                                    "text": "哦…啊？！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503902",
            "objective": "(test)与晕倒的画家对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750390201",
                    "speaker": "？？？",
                    "text": "你好，黑暗，我的老朋友…"
                },
                {
                    "id": "750390202",
                    "speaker": "派蒙",
                    "text": "呜哇…是一个…说话像大人的小孩子，好奇怪！"
                },
                {
                    "id": "750390203",
                    "speaker": "？？？",
                    "text": "喂，你的父母没有教过你尊重我这样的人吗？要知道，小小的人也能做出大大的事来！"
                },
                {
                    "id": "750390204",
                    "speaker": "？？？",
                    "text": "事实上，许多大大的事，正是由像我这样小小的人所成就的…"
                },
                {
                    "id": "750390205",
                    "speaker": "派蒙",
                    "text": "他还有胡子！噫…看起来有点恶心…"
                },
                {
                    "id": "750390206",
                    "speaker": "？？？",
                    "text": "至少不要拿胡子羞辱我！",
                    "choices": [
                        {
                            "id": "750390207",
                            "text": "你好，我是黑暗，你的老朋友。",
                            "response": [
                                {
                                    "id": "750390208",
                                    "speaker": "？？？",
                                    "text": "呃…不，你不用这样配合我，我的意思是我…我快死了。",
                                    "choices": [
                                        {
                                            "id": "750390209",
                                            "text": "哦。",
                                            "response": [
                                                {
                                                    "id": "750390210",
                                                    "speaker": "派蒙",
                                                    "text": "变得像小鱼干一样了呢…真可怜。"
                                                },
                                                {
                                                    "id": "750390211",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜呜…"
                                                },
                                                {
                                                    "id": "750390212",
                                                    "speaker": "？？？",
                                                    "text": "喂，你们身为人类的同理心哪里去了！"
                                                },
                                                {
                                                    "id": "750390213",
                                                    "speaker": "？？？",
                                                    "text": "给我水！我要渴死了，难道你们看不出来吗！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750390214",
                                            "text": "你需要什么？",
                                            "response": [
                                                {
                                                    "id": "750390215",
                                                    "speaker": "？？？",
                                                    "text": "啊，太好了…我在这里困了三天，终于听到了一句人话…！"
                                                },
                                                {
                                                    "id": "750390216",
                                                    "speaker": "？？？",
                                                    "text": "我要两份九号餐，一份大九号，一份六号餐多加酱，一份七号餐，两份四十五号，其中一份加芝士，再来一杯大枫达。"
                                                },
                                                {
                                                    "id": "750390217",
                                                    "speaker": "派蒙",
                                                    "text": "好的，你还需要什么吗？"
                                                },
                                                {
                                                    "id": "750390218",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "唔，嗷？"
                                                },
                                                {
                                                    "id": "750390219",
                                                    "speaker": "？？？",
                                                    "text": "还需要什么？还需要什么！我需要水！我要渴死了，你们难道第一眼看不出来吗！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750390220",
                            "text": "请你振作点，我们该怎么帮助你？",
                            "response": [
                                {
                                    "id": "750390221",
                                    "speaker": "？？？",
                                    "text": "水…请给我水…谢谢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503919",
            "objective": "(test)隐藏控制reminder1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503920",
            "objective": "(test)隐藏控制reminder2$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503915",
            "objective": "(test)尝试把画家弄醒$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503916",
            "objective": "(test)尝试把画家弄醒-水琥珀$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7503917",
            "objective": "(test)尝试把画家弄醒-水元素攻击$HIDDEN",
            "dialogues": [
                {
                    "id": "750391701",
                    "speaker": "Black Screen",
                    "text": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。"
                },
                {
                    "id": "750391702",
                    "speaker": "马尼菲科",
                    "text": "呼…咳咳！咳咳！谢谢你们…但是，咳咳…救人的方式可以少点攻击性啦…我可不会游泳…"
                },
                {
                    "id": "750391703",
                    "speaker": "派蒙",
                    "text": "没关系，到时候我们再想办法把你捞回来！"
                },
                {
                    "id": "750391704",
                    "speaker": "马尼菲科",
                    "text": "我宁愿你们不要到时候再想办法…不过不管怎么样，谢谢你们救了我一命！"
                },
                {
                    "id": "750391705",
                    "speaker": "马尼菲科",
                    "text": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。"
                },
                {
                    "id": "750391706",
                    "speaker": "马尼菲科",
                    "text": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。"
                },
                {
                    "id": "750391707",
                    "speaker": "派蒙",
                    "text": "哇…好奇怪的家伙…"
                },
                {
                    "id": "750391708",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "哼…",
                    "choices": [
                        {
                            "id": "750391709",
                            "text": "「警探」…？",
                            "response": [
                                {
                                    "id": "750391710",
                                    "speaker": "马尼菲科",
                                    "text": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。"
                                },
                                {
                                    "id": "750391711",
                                    "speaker": "马尼菲科",
                                    "text": "那可真是让人难忘的时光…"
                                },
                                {
                                    "id": "750391712",
                                    "speaker": "马尼菲科",
                                    "text": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…"
                                },
                                {
                                    "id": "750391713",
                                    "speaker": "派蒙",
                                    "text": "那种乱七八糟的时光还是不要回顾啦…"
                                },
                                {
                                    "id": "750391732",
                                    "speaker": "马尼菲科",
                                    "text": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…"
                                },
                                {
                                    "id": "750391733",
                                    "speaker": "马尼菲科",
                                    "text": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！"
                                },
                                {
                                    "id": "750391734",
                                    "speaker": "派蒙",
                                    "text": "是挺惊心啦…你差点就干死在这里了。"
                                },
                                {
                                    "id": "750391735",
                                    "speaker": "马尼菲科",
                                    "text": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。"
                                },
                                {
                                    "id": "750391736",
                                    "speaker": "马尼菲科",
                                    "text": "这样，我接下来要去的地方…让我在你的地图上标记出来…嗯，在这里。"
                                },
                                {
                                    "id": "750391737",
                                    "speaker": "马尼菲科",
                                    "text": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？"
                                },
                                {
                                    "id": "750391738",
                                    "speaker": "Player",
                                    "text": "#我是{NICKNAME}。"
                                },
                                {
                                    "id": "750391739",
                                    "speaker": "派蒙",
                                    "text": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！"
                                },
                                {
                                    "id": "750391740",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯唔！"
                                },
                                {
                                    "id": "750391741",
                                    "speaker": "马尼菲科",
                                    "text": "#很好，{NICKNAME}和派蒙，我记住了！"
                                },
                                {
                                    "id": "750391742",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？唔？吓——！"
                                },
                                {
                                    "id": "750391743",
                                    "speaker": "马尼菲科",
                                    "text": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！"
                                },
                                {
                                    "id": "750391744",
                                    "speaker": "马尼菲科",
                                    "text": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！"
                                },
                                {
                                    "id": "750391745",
                                    "speaker": "派蒙",
                                    "text": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！"
                                },
                                {
                                    "id": "750391746",
                                    "speaker": "马尼菲科",
                                    "text": "哈哈，不会的！我们有机会再见咯！"
                                },
                                {
                                    "id": "750391747",
                                    "speaker": "Black Screen",
                                    "text": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。"
                                }
                            ]
                        },
                        {
                            "id": "750391714",
                            "text": "「布鲁图斯」…？",
                            "response": [
                                {
                                    "id": "750391715",
                                    "speaker": "马尼菲科",
                                    "text": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。"
                                },
                                {
                                    "id": "750391716",
                                    "speaker": "马尼菲科",
                                    "text": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」"
                                },
                                {
                                    "id": "750391717",
                                    "speaker": "马尼菲科",
                                    "text": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！"
                                },
                                {
                                    "id": "750391718",
                                    "speaker": "派蒙",
                                    "text": "哇……"
                                },
                                {
                                    "id": "750391719",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "哇……"
                                },
                                {
                                    "id": "750391720",
                                    "speaker": "马尼菲科",
                                    "text": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。"
                                },
                                {
                                    "id": "750391721",
                                    "speaker": "派蒙",
                                    "text": "欸？！"
                                },
                                {
                                    "id": "750391722",
                                    "speaker": "马尼菲科",
                                    "text": "所以，「布鲁图斯」！"
                                },
                                {
                                    "id": "750391723",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜嗷？！"
                                },
                                {
                                    "id": "750391724",
                                    "speaker": "马尼菲科",
                                    "text": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。"
                                }
                            ]
                        },
                        {
                            "id": "750391725",
                            "text": "「磁先生」…？",
                            "response": [
                                {
                                    "id": "750391726",
                                    "speaker": "马尼菲科",
                                    "text": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！"
                                },
                                {
                                    "id": "750391727",
                                    "speaker": "派蒙",
                                    "text": "噫……！"
                                },
                                {
                                    "id": "750391728",
                                    "speaker": "马尼菲科",
                                    "text": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！"
                                },
                                {
                                    "id": "750391729",
                                    "speaker": "派蒙",
                                    "text": "那应该叫「盗窃癖」！"
                                },
                                {
                                    "id": "750391730",
                                    "speaker": "马尼菲科",
                                    "text": "没错，那正是我们家族的美德之一！"
                                },
                                {
                                    "id": "750391731",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "咿——！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7503918",
            "objective": "(test)尝试把画家弄醒-灵视龙创生$HIDDEN",
            "dialogues": [
                {
                    "id": "750391801",
                    "speaker": "Black Screen",
                    "text": "设法帮助了干渴的路人，你们注意到，浸水之后他的体型仿佛大了一圈。"
                },
                {
                    "id": "750391802",
                    "speaker": "？？？",
                    "text": "咳咳…呼…呼…哈哈，原来是暝视龙的小招数…这也是我来这里的原因之一。"
                },
                {
                    "id": "750391803",
                    "speaker": "派蒙",
                    "text": "你先顺顺气，多喝点水再说话啦！"
                },
                {
                    "id": "750391804",
                    "speaker": "？？？",
                    "text": "咳咳…！我没事的，谢谢你们救了我一命！"
                },
                {
                    "id": "750391805",
                    "speaker": "马尼菲科",
                    "text": "马尼菲科·德·拉·马尼菲桑斯，叫我马尼菲科就好。正如你们所见，我出身枫丹贵胄。"
                },
                {
                    "id": "750391806",
                    "speaker": "马尼菲科",
                    "text": "我的老朋友们有时叫我「警探」，有时叫我「布鲁图斯」，有时叫我「磁先生」…但你们的话，随便什么称呼都行。"
                },
                {
                    "id": "750391807",
                    "speaker": "派蒙",
                    "text": "唔…这么多乱七八糟的名字，听起来好可疑！"
                },
                {
                    "id": "750391808",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "哼…",
                    "choices": [
                        {
                            "id": "750391809",
                            "text": "「警探」…？",
                            "response": [
                                {
                                    "id": "750391810",
                                    "speaker": "马尼菲科",
                                    "text": "我曾经在逐影庭做过几年警探，跟随法兰克·德雷宾警督办过几件大案，后来他升任警司，而我退役了。"
                                },
                                {
                                    "id": "750391811",
                                    "speaker": "马尼菲科",
                                    "text": "那可真是让人难忘的时光…"
                                },
                                {
                                    "id": "750391812",
                                    "speaker": "马尼菲科",
                                    "text": "是啊…男孩遇见女孩，男孩失去女孩，女孩寻找男孩，男孩忘记女孩，男孩记起女孩，女孩被千灵节的映影花车碾压了三遍…"
                                },
                                {
                                    "id": "750391813",
                                    "speaker": "派蒙",
                                    "text": "那种乱七八糟的时光还是不要回顾啦…"
                                },
                                {
                                    "id": "750391832",
                                    "speaker": "马尼菲科",
                                    "text": "咳咳，总之，从逐影庭退役以后，我无所事事了一段时间，最终决定还是做个摄影家，描摹人与物所固有的生命力…"
                                },
                                {
                                    "id": "750391833",
                                    "speaker": "马尼菲科",
                                    "text": "所以我来到了这里，纳塔！诸元素生命力最为璀璨惊心的国度！"
                                },
                                {
                                    "id": "750391834",
                                    "speaker": "派蒙",
                                    "text": "是挺惊心啦…你差点就干死在这里了。"
                                },
                                {
                                    "id": "750391835",
                                    "speaker": "马尼菲科",
                                    "text": "嘿嘿，实在是不好意思。我是不会忘记你们救我一命的。"
                                },
                                {
                                    "id": "750391836",
                                    "speaker": "马尼菲科",
                                    "text": "唔…对了，借你们的地图看一下。嗯…我看看接下来我的目的地在哪里来着？"
                                },
                                {
                                    "id": "750391837",
                                    "speaker": "马尼菲科",
                                    "text": "啊！对了…我的礼貌哪里去了！还不知道你们的名字？"
                                },
                                {
                                    "id": "750391838",
                                    "speaker": "Player",
                                    "text": "#我是{NICKNAME}。"
                                },
                                {
                                    "id": "750391839",
                                    "speaker": "派蒙",
                                    "text": "#叫我派蒙就好！还有它，它叫{REALNAME[ID(2)|SHOWHOST(true)]}！"
                                },
                                {
                                    "id": "750391840",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯唔！"
                                },
                                {
                                    "id": "750391841",
                                    "speaker": "马尼菲科",
                                    "text": "#很好，{NICKNAME}和派蒙，我记住了！"
                                },
                                {
                                    "id": "750391842",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？唔？吓——！"
                                },
                                {
                                    "id": "750391843",
                                    "speaker": "马尼菲科",
                                    "text": "#哈哈，别急别急！还有{REALNAME[ID(2)|SHOWHOST(true)]}！"
                                },
                                {
                                    "id": "750391844",
                                    "speaker": "马尼菲科",
                                    "text": "希望不久后我们能在旅途中再次相见，说不定下次我又要拜托你们帮忙，又说不定我能帮上你们的忙呢！"
                                },
                                {
                                    "id": "750391845",
                                    "speaker": "派蒙",
                                    "text": "哇…你要去这么远的地方呀…那小心不要再把自己渴瘪了！"
                                },
                                {
                                    "id": "750391846",
                                    "speaker": "马尼菲科",
                                    "text": "哈哈，不会的！我们有机会再见咯！"
                                },
                                {
                                    "id": "750391847",
                                    "speaker": "Black Screen",
                                    "text": "马尼菲科飞快地打包好行李与饮水，向你们摆手告别。\\n不一会儿，他矮小的身影便从你们的视野中消失了。"
                                }
                            ]
                        },
                        {
                            "id": "750391814",
                            "text": "「布鲁图斯」…？",
                            "response": [
                                {
                                    "id": "750391815",
                                    "speaker": "马尼菲科",
                                    "text": "啊，你可能不知道，我曾在逐影庭做过几年警探，那时候是法兰克·德雷宾警督的部下。"
                                },
                                {
                                    "id": "750391816",
                                    "speaker": "马尼菲科",
                                    "text": "当时我们在公园里看到五个穿托加长袍的家伙在一百多人面前用刀袭击一个老头，于是「砰、砰、砰、砰、砰！」"
                                },
                                {
                                    "id": "750391817",
                                    "speaker": "马尼菲科",
                                    "text": "我们把他们全放倒了，地上没有一个喘气的。哈，你觉得自己很幸运吗，小贼！"
                                },
                                {
                                    "id": "750391818",
                                    "speaker": "派蒙",
                                    "text": "哇……"
                                },
                                {
                                    "id": "750391819",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "哇……"
                                },
                                {
                                    "id": "750391820",
                                    "speaker": "马尼菲科",
                                    "text": "后来警长告诉我，那是一帮科学院的行政科员，正在排练《雷穆利亚》。"
                                },
                                {
                                    "id": "750391821",
                                    "speaker": "派蒙",
                                    "text": "欸？！"
                                },
                                {
                                    "id": "750391822",
                                    "speaker": "马尼菲科",
                                    "text": "所以，「布鲁图斯」！"
                                },
                                {
                                    "id": "750391823",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜嗷？！"
                                },
                                {
                                    "id": "750391824",
                                    "speaker": "马尼菲科",
                                    "text": "不过反正没什么关系，当时科学院正在裁撤冗员，他们早晚得下岗。"
                                }
                            ]
                        },
                        {
                            "id": "750391825",
                            "text": "「磁先生」…？",
                            "response": [
                                {
                                    "id": "750391826",
                                    "speaker": "马尼菲科",
                                    "text": "当然是说我超凡的人格魅力，每个认识我的人都会不可避免地被我所吸引！"
                                },
                                {
                                    "id": "750391827",
                                    "speaker": "派蒙",
                                    "text": "噫……！"
                                },
                                {
                                    "id": "750391828",
                                    "speaker": "马尼菲科",
                                    "text": "以及…所有不起眼的金属小物件、零散摩拉、细小首饰什么的，都会莫名其妙被吸引到我的裤兜里！"
                                },
                                {
                                    "id": "750391829",
                                    "speaker": "派蒙",
                                    "text": "那应该叫「盗窃癖」！"
                                },
                                {
                                    "id": "750391830",
                                    "speaker": "马尼菲科",
                                    "text": "没错，那正是我们家族的美德之一！"
                                },
                                {
                                    "id": "750391831",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "咿——！"
                                }
                            ]
                        }
                    ]
                }
            ]
