    "talks": [
        {
            "id": "7002201",
            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700220101",
                    "speaker": "好奇的丘丘人",
                    "text": "Odomu tomo? Kundala? Mosi mita?"
                },
                {
                    "id": "700220102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo! Mosi mita!"
                },
                {
                    "id": "700220103",
                    "speaker": "好奇的丘丘人",
                    "text": "Tomo mosi mita! Tomo mani mimi?"
                },
                {
                    "id": "700220104",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi mani ye! Plata yaya ika?"
                },
                {
                    "id": "700220105",
                    "speaker": "好奇的丘丘人",
                    "text": "Plata ika odomu! Zido mi! mi muhe yeye! Mi mita yeye!"
                },
                {
                    "id": "700220106",
                    "speaker": "派蒙",
                    "text": "不知怎么的，感觉他们很谈得来的样子。",
                    "choices": [
                        {
                            "id": "700220107",
                            "text": "这就是丘丘人学家吗…",
                            "response": [
                                {
                                    "id": "700220109",
                                    "speaker": "艾拉·马斯克",
                                    "text": "哼哼，它很愿意和我们交朋友，只要我们帮一个小忙…"
                                },
                                {
                                    "id": "700220110",
                                    "speaker": "艾拉·马斯克",
                                    "text": "我们需要帮它们打倒难对付的敌人，具体位置我标记下来啦。"
                                },
                                {
                                    "id": "700220111",
                                    "speaker": "好奇的丘丘人",
                                    "text": "Dada, Valo!"
                                },
                                {
                                    "id": "700220112",
                                    "speaker": "艾拉·马斯克",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700220108",
                            "text": "氛围变得热闹了起来…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002202",
            "objective": "前往指定地点战斗",
            "dialogues": [
                {
                    "id": "700220201",
                    "speaker": "好奇的丘丘人",
                    "text": "Mosi mita! Yeye mimi dada tomo!"
