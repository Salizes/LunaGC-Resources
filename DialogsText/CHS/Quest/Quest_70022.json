                },
                {
                    "id": "700220203",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF> Unta mosi dada</color>…我记得是…唔…欸…？",
                    "choices": [
                        {
                            "id": "700220204",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700220206",
