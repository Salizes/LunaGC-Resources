    "talks": [
        {
            "id": "7900010",
            "objective": "家族迁徙首位隐藏任务$HIDDEN",
            "dialogues": [
                {
                    "id": "680020501",
                    "speaker": "回声海螺",
                    "text": "「这几年，每一次海潮都比过去更高。水位上涨，我们已经快要没有生存空间…」"
                },
                {
                    "id": "680020502",
                    "speaker": "回声海螺",
                    "text": "「我只能动员家族成员们打包物资，一同迁往高处。」"
                },
                {
                    "id": "680020503",
                    "speaker": "回声海螺",
                    "text": "「妈妈！」"
                },
                {
                    "id": "680020504",
                    "speaker": "回声海螺",
                    "text": "「怎么了？」"
                },
                {
                    "id": "680020505",
                    "speaker": "回声海螺",
                    "text": "「刚刚水淹上来，我让大家先撤离去高处了！至于传家宝…抱歉，我认为家人比宝物更重要，所以…没来得及带走。」"
                },
                {
                    "id": "680020506",
                    "speaker": "回声海螺",
                    "text": "「传家宝留在了<color=#37FFFF>岛屿中央</color>，如果以后水能褪去，或是有人能从外面进来，就让他们去找吧。」"
                }
            ]
        },
