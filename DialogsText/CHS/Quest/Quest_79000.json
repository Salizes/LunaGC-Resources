        {
            "id": "7900002",
            "objective": "寻找宝藏",
            "dialogues": [
                {
                    "id": "790000201",
                    "speaker": "派蒙",
                    "text": "打开了！快看看里面有什么东西吧。"
                }
            ]
        },
        {
            "id": "7900006",
            "objective": "",
            "dialogues": [
                {
                    "id": "790000401",
                    "speaker": "派蒙",
                    "text": "找到啦！宝藏，宝藏，里面会有什么呢…"
                },
                {
                    "id": "790000402",
                    "speaker": "派蒙",
                    "text": "咦？上面怎么有锁。还、还是密码锁…需要密码才能打开吗…",
                    "choices": [
                        {
                            "id": "790000403",
                            "text": "这锁应该能直接砸开…",
                            "response": [
                                {
                                    "id": "790000405",
                                    "speaker": "派蒙",
                                    "text": "等一下！直接砸的话，要是里面的东西也被砸坏了怎么办？"
                                },
                                {
                                    "id": "790000406",
                                    "speaker": "派蒙",
                                    "text": "我们还是想想打开锁的方法吧。"
                                },
                                {
                                    "id": "790000410",
                                    "speaker": "派蒙",
                                    "text": "但既然这个箱子装着的东西是「传家宝」，而且这箱子还是用「密码」的形式锁住的…"
                                },
                                {
                                    "id": "790000411",
                                    "speaker": "派蒙",
                                    "text": "那就是说，锁住这个箱子的人认为，自己所留下的「密码」能很容易就被记住…"
                                },
                                {
                                    "id": "790000412",
                                    "speaker": "派蒙",
                                    "text": "看来我们唯一的希望，就只有那些保存着声音的海螺了。"
                                },
                                {
                                    "id": "790000413",
                                    "speaker": "派蒙",
                                    "text": "再好好听一下那些海螺里的声音吧，希望那些声音里真的有「密码」的线索…"
                                }
                            ]
                        },
                        {
                            "id": "790000404",
                            "text": "要想想开锁的方法。",
                            "response": [
                                {
                                    "id": "790000407",
                                    "speaker": "派蒙",
                                    "text": "不过，周围也没有石碑、壁画、纸条、刻字和笔记本的样子…"
                                },
                                {
                                    "id": "790000408",
                                    "speaker": "Player",
                                    "text": "而且也没有学者、盗宝团或者冒险家。"
                                },
                                {
                                    "id": "790000409",
                                    "speaker": "派蒙",
                                    "text": "是呢，唔唔，真是前所未有的大考验。"
                                }
                            ]
                        }
                    ]
                }
            ]
