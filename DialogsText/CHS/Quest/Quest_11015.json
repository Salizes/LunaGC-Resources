    "talks": [
        {
            "id": "1101501",
            "objective": "将千奇核心与仙家符箓交给秘书",
            "dialogues": [
                {
                    "id": "110150101",
                    "speaker": "派蒙",
                    "text": "凝光小姐的小秘书，我们把材料找齐啦！"
                },
                {
                    "id": "110150102",
                    "speaker": "百闻",
                    "text": "哦？这么快？"
                },
                {
                    "id": "110150103",
                    "speaker": "百闻",
                    "text": "而且三位是一起找齐的吗…原来如此，我懂了。"
                },
                {
                    "id": "110150104",
                    "speaker": "百闻",
                    "text": "千奇核心和仙家符箓都没什么问题。看来这场比赛，要分出胜负了呢。"
                },
                {
                    "id": "110150105",
                    "speaker": "百闻",
                    "text": "#我宣布，这次材料筹备竞赛的三位优胜者，分别是{NICKNAME}、云堇和北斗！"
                },
                {
                    "id": "110150106",
                    "speaker": "宏飞",
                    "text": "不是，这就结束了？我浮生石还没找到呢！"
                },
                {
                    "id": "110150107",
                    "speaker": "昌贵",
                    "text": "我不能接受…"
                },
                {
                    "id": "110150108",
                    "speaker": "志成",
                    "text": "唉，紧赶慢赶，还是慢人一步…"
                },
                {
                    "id": "110150109",
                    "speaker": "百闻",
                    "text": "那就有请三位优胜者，先移步到群玉阁，凝光大人已经在上面等着了。"
                },
                {
                    "id": "110150110",
                    "speaker": "派蒙",
                    "text": "咦？北斗哪去了，刚刚还看见她在这里的。"
                },
                {
                    "id": "110150111",
                    "speaker": "百闻",
                    "text": "北斗小姐有些事情，可能会晚一点到。几位先随我来吧。"
                },
                {
                    "id": "110150112",
                    "speaker": "派蒙",
                    "text": "好吧，那我们先到群玉阁上看看吧。"
                },
                {
                    "id": "110150113",
                    "speaker": "派蒙",
                    "text": "上次登上群玉阁，好像还是很久之前呢！"
                }
            ]
        },
        {
            "id": "1101506",
            "objective": "在群玉阁上与凝光对话",
            "dialogues": [
                {
                    "id": "110150201",
                    "speaker": "凝光",
                    "text": "将仙家符箓与千奇核心相结合，放入群玉阁控制仓内。"
                },
                {
                    "id": "110150202",
                    "speaker": "凝光",
                    "text": "如此一来，群玉阁就算正式重建完毕。之后收起铁索，它便会升入高空。"
                },
                {
                    "id": "110150203",
                    "speaker": "凝光",
                    "text": "辛苦几位。现在该由我兑现承诺，给你们奖励了。"
                },
                {
                    "id": "110150204",
                    "speaker": "派蒙",
                    "text": "好耶！"
                },
                {
                    "id": "110150205",
                    "speaker": "凝光",
                    "text": "云先生的来意，我稍有耳闻。你正在为新的戏曲寻找合适的舞台，对吗？"
                },
                {
                    "id": "110150206",
                    "speaker": "云堇",
                    "text": "正是。不知道凝光小姐有什么建议吗？"
                },
                {
                    "id": "110150207",
                    "speaker": "凝光",
                    "text": "既然是云先生隆重准备的新戏，想必极有分量，初演不如就选在这新建成的群玉阁上，如何？"
                },
                {
                    "id": "110150208",
                    "speaker": "凝光",
                    "text": "群玉阁地势极高，由此向外，能一览众山小。高处知风劲，又可观人间众相，我想，天下怕是没有比这里更适合先生的戏台了。"
                },
                {
                    "id": "110150209",
                    "speaker": "云堇",
                    "text": "多谢凝光小姐。稍后我会备好戏曲道具，劳烦凝光小姐一并带上群玉阁。"
                },
                {
                    "id": "110150210",
                    "speaker": "凝光",
                    "text": "名戏佳曲，值得如此。不必客气。"
                },
                {
                    "id": "110150211",
                    "speaker": "云堇",
                    "text": "#{NICKNAME}、申鹤，还有小派蒙，我先告辞了。记得来听我的戏哦。"
                },
                {
                    "id": "110150212",
                    "speaker": "凝光",
                    "text": "#你呢？{NICKNAME}，你想问我什么呢？"
                },
                {
                    "id": "110150213",
                    "speaker": "凝光",
                    "text": "#事先说明，你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的行踪我也不清楚，就不要浪费这个问题了。"
                },
                {
                    "id": "110150214",
                    "speaker": "派蒙",
                    "text": "唔…凝光小姐总是未卜先知的样子呢…既然这样，就轮到派蒙来问了！"
                },
                {
                    "id": "110150215",
                    "speaker": "凝光",
                    "text": "…经商可没有你们想的那么容易。资金、人脉、对风向的感知、对机遇的嗅觉…凡此种种，缺一不可。"
                },
                {
                    "id": "110150216",
                    "speaker": "凝光",
                    "text": "你们若是想问怎么赚钱，我自会按照约定回答。但对现在的你们来说，未必有效。"
                },
                {
                    "id": "110150217",
                    "speaker": "派蒙",
                    "text": "哇——明明我还什么都没有问呢！"
                },
                {
                    "id": "110150218",
                    "speaker": "凝光",
                    "text": "心思都写在脸上了，一看便知。当然，你们帮我重建群玉阁，恩情重大，我绝不会亏待你们。"
                },
                {
                    "id": "110150219",
                    "speaker": "凝光",
                    "text": "我可以许诺，若有一天你们急需接济，可以来我这里寻个差使。至于薪水待遇，我当然会按最高规格来给。"
                },
                {
                    "id": "110150220",
                    "speaker": "派蒙",
                    "text": "太好啦！下次摩拉用完的时候，我们来找凝光小姐就行！"
                },
                {
                    "id": "110150221",
                    "speaker": "派蒙",
                    "text": "那我们俩都没有问题了，申鹤有什么想问的吗？"
                },
                {
                    "id": "110150222",
                    "speaker": "申鹤",
                    "text": "我？"
                },
                {
                    "id": "110150223",
                    "speaker": "派蒙",
                    "text": "是呀！因为材料是大家一起找齐的呢！"
                },
                {
                    "id": "110150224",
                    "speaker": "申鹤",
                    "text": "多谢…但我实在没有什么问题。"
                },
                {
                    "id": "110150225",
                    "speaker": "凝光",
                    "text": "是吗？那这个千载难逢的提问机会，怕是要浪费了。"
                },
                {
                    "id": "110150226",
                    "speaker": "派蒙",
                    "text": "怎么可以这样，不可以浪费！唔，让我们再想想…"
                },
                {
                    "id": "110150227",
                    "speaker": "申鹤",
                    "text": "…凝光小姐，你觉得我能融入璃月港吗？"
                },
                {
                    "id": "110150228",
                    "speaker": "凝光",
                    "text": "这倒是一个有趣的问题。"
                },
                {
                    "id": "110150229",
                    "speaker": "凝光",
                    "text": "璃月港是一座包容的城市，只要你遵守这里的规章制度，它就不会拒绝你。"
                },
                {
                    "id": "110150230",
                    "speaker": "凝光",
                    "text": "所以，重要的是，你能否对璃月港产生「归属感」。"
                },
                {
                    "id": "110150231",
                    "speaker": "申鹤",
                    "text": "归属感？"
                },
                {
                    "id": "110150232",
                    "speaker": "凝光",
                    "text": "是啊。喜欢一个地方，融入一个地方…总是要有理由的。"
                },
                {
                    "id": "110150233",
                    "speaker": "凝光",
                    "text": "或许是在这里遇见过什么人、经历过什么事，也或许只是享受璃月的氛围，习惯了这样去生活。"
                },
                {
                    "id": "110150234",
                    "speaker": "凝光",
                    "text": "总之，每个人都需要一个留下来的理由，希望你也能早日找到。"
                },
                {
                    "id": "110150235",
                    "speaker": "申鹤",
                    "text": "…我明白了。"
                },
                {
                    "id": "110150236",
                    "speaker": "北斗",
                    "text": "哟，几位正聊着呢？刚刚去了趟船队，来晚了。"
                },
                {
                    "id": "110150237",
                    "speaker": "派蒙",
                    "text": "快来快来，正好轮到北斗啦！北斗有什么想问的问题吗？"
                },
                {
                    "id": "110150238",
                    "speaker": "北斗",
                    "text": "我？我没什么想问的。本来就是被她强拉来帮忙，顺便参赛而已。"
                },
                {
                    "id": "110150239",
                    "speaker": "北斗",
                    "text": "凝光，上次跟你说的事，你可别忘了。"
                },
                {
                    "id": "110150240",
                    "speaker": "北斗",
                    "text": "那东西不好对付，光靠我的船队，很难摆平。"
                },
                {
                    "id": "110150241",
                    "speaker": "凝光",
                    "text": "放心吧，我准备好了。伤药准备妥当，千岩军也提前赶过去埋伏了。"
                },
                {
                    "id": "110150242",
                    "speaker": "北斗",
                    "text": "那就好。你自己当心点，不要掉以轻心。"
                },
                {
                    "id": "110150243",
                    "speaker": "派蒙",
                    "text": "北斗，凝光小姐，你们在聊什么呀？"
                },
                {
                    "id": "110150244",
                    "speaker": "凝光",
                    "text": "等群玉阁升空，你们自会明白。但…不是什么愉快的事，不知道或许更好。"
                },
                {
                    "id": "110150245",
                    "speaker": "凝光",
                    "text": "第一次登上群玉阁的时候，我站在高台边缘，从空中遥望着璃月港。"
                },
                {
                    "id": "110150246",
                    "speaker": "凝光",
                    "text": "那时我想，终有一日我会让群玉阁的影子覆盖七国。"
                },
                {
                    "id": "110150247",
                    "speaker": "凝光",
                    "text": "时至今日，我的愿望依然未变。不过，这次重修群玉阁，却不只是为了我自己。"
                },
                {
                    "id": "110150248",
                    "speaker": "凝光",
                    "text": "我希望，无论何时群玉阁都能一直浮在璃月港上空，见证人间的繁荣安宁。"
                },
                {
                    "id": "110150249",
                    "speaker": "凝光",
                    "text": "…也希望各位，与我一同见证。"
                },
                {
                    "id": "110150250",
                    "speaker": "凝光",
                    "text": "升空仪式，开始！"
                }
            ]
        },
        {
            "id": "1101507",
            "objective": "(test)切换千奇核心状态$HIDDEN",
            "dialogues": [
                {
                    "id": "110150701",
                    "speaker": "云堇",
                    "text": "「唱戏须先入戏」…"
                },
                {
                    "id": "110150702",
                    "speaker": "云堇",
                    "text": "和你们一起到天衡山走了一遭，今天唱戏时，我明显入戏更深。"
                },
                {
                    "id": "110150703",
                    "speaker": "云堇",
                    "text": "下次有了新戏，再一起参悟一番，如何？"
                }
            ]
        },
        {
            "id": "1101510",
            "objective": "(test)播片换时间$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101509",
            "objective": "击败「漩涡的余威」跋掣",
            "dialogues": []
        },
        {
            "id": "1101502",
            "objective": "击败「漩涡的余威」跋掣",
            "dialogues": []
        },
        {
            "id": "1101508",
            "objective": "与凝光对话",
            "dialogues": [
                {
                    "id": "110150801",
                    "speaker": "刻晴",
                    "text": "千岩军的损伤在预想范围之内。"
                },
                {
                    "id": "110150802",
                    "speaker": "刻晴",
                    "text": "不过回看整个计划，还是有些瑕疵。"
                },
                {
                    "id": "110150803",
                    "speaker": "刻晴",
                    "text": "如果时间更充裕一些，就能在这里提前布置结界，防备海浪冲击。"
                },
                {
                    "id": "110150804",
                    "speaker": "刻晴",
                    "text": "这些都是教训，下次不可再犯…这次幸好有你们帮忙，多谢了。"
                }
            ]
        },
        {
            "id": "1101503",
            "objective": "与凝光对话",
            "dialogues": [
                {
                    "id": "110150301",
                    "speaker": "申鹤",
                    "text": "……",
                    "choices": [
                        {
                            "id": "110150302",
                            "text": "没事吧？",
                            "response": [
                                {
                                    "id": "110150304",
                                    "speaker": "申鹤",
                                    "text": "只是力量有些消耗过度，没关系的。"
                                },
                                {
                                    "id": "110150305",
                                    "speaker": "申鹤",
                                    "text": "本来想一个人把那家伙处理掉，没想到你还是追下来了。"
                                },
                                {
                                    "id": "110150306",
                                    "speaker": "申鹤",
                                    "text": "放心，她暂时不敢来了。受了那么严重的伤，应该已经遁逃到别处了。"
                                },
                                {
                                    "id": "110150307",
                                    "speaker": "凝光",
                                    "text": "方才在水下，情况如何？"
                                },
                                {
                                    "id": "110150308",
                                    "speaker": "申鹤",
                                    "text": "解决掉了。她在潜入水下前就受了伤，我们没费太大力气。"
                                },
                                {
                                    "id": "110150309",
                                    "speaker": "凝光",
                                    "text": "那就好。无论如何，总算是平安度过本次危机了。之后请到群玉阁来，我会好好招待你们。"
                                },
                                {
                                    "id": "110150310",
                                    "speaker": "正茂",
                                    "text": "凝光大人，船队传来消息，那只水怪已经离开了孤云阁附近，周围海域恢复正常！"
                                },
                                {
                                    "id": "110150311",
                                    "speaker": "凝光",
                                    "text": "辛苦你们了，千岩军情况如何？"
                                },
                                {
                                    "id": "110150312",
                                    "speaker": "正茂",
                                    "text": "多亏了凝光大人准备的伤药，以及刻晴大人的临阵指挥，我们尽可能将损伤控制到了最低。"
                                },
                                {
                                    "id": "110150313",
                                    "speaker": "正茂",
                                    "text": "当然，也要感谢这位小姐出手相助。"
                                },
                                {
                                    "id": "110150314",
                                    "speaker": "正茂",
                                    "text": "我替千岩军所有的兄弟们，向你表示感谢。"
                                },
                                {
                                    "id": "110150315",
                                    "speaker": "申鹤",
                                    "text": "我…",
                                    "choices": [
                                        {
                                            "id": "110150316",
                                            "text": "申鹤主动保护了我们。",
                                            "response": [
                                                {
                                                    "id": "110150318",
                                                    "speaker": "申鹤",
                                                    "text": "太好了。下次听云先生唱戏，我应该可以对那些赞美感到坦然了。"
                                                },
                                                {
                                                    "id": "110150319",
                                                    "speaker": "申鹤",
                                                    "text": "虽然我并未想做英雄，只是想保护你而已。"
                                                },
                                                {
                                                    "id": "110150320",
                                                    "speaker": "凝光",
                                                    "text": "让士兵们好好休养。但不可过于懈怠，严防她卷土重来。"
                                                },
                                                {
                                                    "id": "110150321",
                                                    "speaker": "正茂",
                                                    "text": "是！"
                                                },
                                                {
                                                    "id": "110150322",
                                                    "speaker": "凝光",
                                                    "text": "暗中观察这么久，可有结论？"
                                                },
                                                {
                                                    "id": "110150323",
                                                    "speaker": "留云借风真君",
                                                    "text": "哼，你问本仙的意见？若非申鹤出手，绝不会如此顺利。"
                                                },
                                                {
                                                    "id": "110150324",
                                                    "speaker": "凝光",
                                                    "text": "这一点我不否认。不过，无非是过程艰辛一些罢了，最终的胜利仍属于我们。"
                                                },
                                                {
                                                    "id": "110150325",
                                                    "speaker": "凝光",
                                                    "text": "大不了，我可以再砸一个群玉阁。"
                                                },
                                                {
                                                    "id": "110150326",
                                                    "speaker": "留云借风真君",
                                                    "text": "…本仙看过了你们仿制和改造的归终机，你们确实有一些新奇的想法。"
                                                },
                                                {
                                                    "id": "110150327",
                                                    "speaker": "留云借风真君",
                                                    "text": "从失败中吸取经验，提前布局应对危机，相比上次有了长足的进步。"
                                                },
                                                {
                                                    "id": "110150328",
                                                    "speaker": "留云借风真君",
                                                    "text": "姑且算你们勉强过关吧，今后想必还有更多考验，本仙会一直看着你们的。"
                                                },
                                                {
                                                    "id": "110150329",
                                                    "speaker": "凝光",
                                                    "text": "只要我还身居天权之位，我就会守护好璃月的安全。"
                                                },
                                                {
                                                    "id": "110150330",
                                                    "speaker": "留云借风真君",
                                                    "text": "申鹤，几年前我看着你偷溜下山，又面色难过地悄悄回来。"
                                                },
                                                {
                                                    "id": "110150331",
                                                    "speaker": "留云借风真君",
                                                    "text": "这次来璃月港，你的心境可有所不同？"
                                                },
                                                {
                                                    "id": "110150332",
                                                    "speaker": "申鹤",
                                                    "text": "有。虽然说不清楚…"
                                                },
                                                {
                                                    "id": "110150333",
                                                    "speaker": "申鹤",
                                                    "text": "不过，比想象的开心。"
                                                },
                                                {
                                                    "id": "110150334",
                                                    "speaker": "留云借风真君",
                                                    "text": "那就好。旅行者，申鹤这孩子，就有劳你了。"
                                                },
                                                {
                                                    "id": "110150335",
                                                    "speaker": "留云借风真君",
                                                    "text": "说来，本仙记得许多她小时候的趣事…"
                                                },
                                                {
                                                    "id": "110150336",
                                                    "speaker": "申鹤",
                                                    "text": "这个就不必了。"
                                                },
                                                {
                                                    "id": "110150337",
                                                    "speaker": "留云借风真君",
                                                    "text": "是吗？哼，一个两个都这样。"
                                                },
                                                {
                                                    "id": "110150338",
                                                    "speaker": "留云借风真君",
                                                    "text": "不爱听也罢，本仙不说就是。本仙回去了！"
                                                },
                                                {
                                                    "id": "110150339",
                                                    "speaker": "凝光",
                                                    "text": "两位先好好休息一番。等疲惫消失，就到群玉阁上来吧。"
                                                },
                                                {
                                                    "id": "110150340",
                                                    "speaker": "凝光",
                                                    "text": "既要庆祝群玉阁建成，也要庆祝璃月顺利度过危机。这次的宴会，一定空前热闹。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110150317",
                                            "text": "就像戏曲中的英雄一样。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110150303",
                            "text": "你还好吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1101504",
            "objective": "前往群玉阁参加庆功宴",
            "dialogues": [
                {
                    "id": "110150401",
                    "speaker": "派蒙",
                    "text": "哇哦…大家都落座了呢！"
                },
                {
                    "id": "110150402",
                    "speaker": "派蒙",
                    "text": "我还是第一次在群玉阁上参加凝光小姐的宴会呢！感觉有好多好吃的！"
                },
                {
                    "id": "110150403",
                    "speaker": "凝光",
                    "text": "诸位都是我凝光的贵客。今日来此，可要尽兴而归。"
                },
                {
                    "id": "110150404",
                    "speaker": "凝光",
                    "text": "不能喝酒的客人，请以饮品代替。美酒宜人，宜人的却不只是美酒。相信群玉阁上的美景也能醉人心脾。"
                },
                {
                    "id": "110150405",
                    "speaker": "永业",
                    "text": "听说了吗？今天好像有云先生登台。"
                },
                {
                    "id": "110150406",
                    "speaker": "朱陶",
                    "text": "呵，实不相瞒，我就是冲着这个来的！云先生的戏，我可是一场不落。"
                },
                {
                    "id": "110150407",
                    "speaker": "朱陶",
                    "text": "这次据说唱的是《神女劈观》，云先生的父亲写的戏。我期待得两三个晚上没睡好了。"
                },
                {
                    "id": "110150408",
                    "speaker": "诗羽",
                    "text": "哎，你们看，云先生上台了！"
                },
                {
                    "id": "110150409",
                    "speaker": "云堇",
                    "text": "怎么样，我唱得还不错吧？"
                },
                {
                    "id": "110150410",
                    "speaker": "派蒙",
                    "text": "太好听了！有机会的话，派蒙也想学！"
                },
                {
                    "id": "110150411",
                    "speaker": "申鹤",
                    "text": "很好听。而且…谢谢你。"
                },
                {
                    "id": "110150412",
                    "speaker": "云堇",
                    "text": "不客气，多亏有你，《神女劈观》才能变得更加完整。"
                },
                {
                    "id": "110150413",
                    "speaker": "云堇",
                    "text": "戏会落幕，人生却不会。相信今后，你一定可以顺利融入璃月港。"
                },
                {
                    "id": "110150414",
                    "speaker": "申鹤",
                    "text": "谢谢。我想，我已经找到改变的「契机」了。"
                },
                {
                    "id": "110150415",
                    "speaker": "朱陶",
                    "text": "云先生…嗝…原来你在这里。"
                },
                {
                    "id": "110150416",
                    "speaker": "朱陶",
                    "text": "嗯？这位白、白发姑娘看着好特别，简直就像是仙人一样。"
                },
                {
                    "id": "110150417",
                    "speaker": "朱陶",
                    "text": "#莫非你就是那位神女？还有这位，这位不是大名鼎鼎的{NICKNAME}吗？嘿嘿嘿，看来这次我真是不虚此行…"
                },
                {
                    "id": "110150418",
                    "speaker": "朱陶",
                    "text": "不介意加张椅子吧，来，咱们一起聊聊天…"
                },
                {
                    "id": "110150419",
                    "speaker": "申鹤",
                    "text": "……"
                },
                {
                    "id": "110150420",
                    "speaker": "申鹤",
                    "text": "如果你不想用鼻子或者眼睛把剩下的酒喝完，就快点离开比较好。"
                },
                {
                    "id": "110150421",
                    "speaker": "派蒙",
                    "text": "这熟悉的感觉…好像又回到第一次和申鹤见面的时候了…"
                },
                {
                    "id": "110150422",
                    "speaker": "Player",
                    "text": "看来还有很长的路要走呢。"
                },
                {
                    "id": "110150423",
                    "speaker": "朱陶",
                    "text": "噫！你想干什么！"
                },
                {
                    "id": "110150424",
                    "speaker": "派蒙",
                    "text": "冷静，申鹤。冷静呀——"
                }
            ]
        },
        {
            "id": "1101511",
            "objective": "(test)最终换时间$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101505",
            "objective": "享受宴会时光",
            "dialogues": []
        },
        {
            "id": "1101330",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110133001",
                    "speaker": "刻晴",
                    "text": "旅行者，派蒙，没想到你们居然找到孤云阁来了。"
                },
                {
                    "id": "110133002",
                    "speaker": "刻晴",
                    "text": "有什么事吗？我现在很忙，恐怕聊不了太久。",
                    "choices": [
                        {
                            "id": "110133003",
                            "text": "刻晴怎么在这里？",
                            "response": [
                                {
                                    "id": "110133004",
                                    "speaker": "刻晴",
                                    "text": "如你所见，这里有些工程。"
                                },
                                {
                                    "id": "110133005",
                                    "speaker": "刻晴",
                                    "text": "我认为，比起群玉阁，此处的工事更加重要，所以特意过来监督。"
                                },
                                {
                                    "id": "110133006",
                                    "speaker": "刻晴",
                                    "text": "希望能赶得上…"
                                }
                            ]
                        },
                        {
                            "id": "110133007",
                            "text": "这个是？",
                            "response": [
                                {
                                    "id": "110133008",
                                    "speaker": "刻晴",
                                    "text": "这是新式归终机。"
                                },
                                {
                                    "id": "110133009",
                                    "speaker": "刻晴",
                                    "text": "凝光命专人拆解研究归终机，以此为蓝本设计出了改良图纸。"
                                },
                                {
                                    "id": "110133010",
                                    "speaker": "刻晴",
                                    "text": "相比仙人制造的原版归终机，这一款的射速与威力都稍逊一筹，但胜在可以量产。"
                                },
                                {
                                    "id": "110133011",
                                    "speaker": "刻晴",
                                    "text": "而且拆卸和组装都十分方便，可以灵活部署到各个地方。"
                                },
                                {
                                    "id": "110133012",
                                    "speaker": "刻晴",
                                    "text": "相信它会是应对危机的良策。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1101424",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142401",
                    "speaker": "常丰",
                    "text": "群玉阁，真漂亮啊——"
                }
            ]
        },
        {
            "id": "1101425",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142501",
                    "speaker": "安顺",
                    "text": "能在工期内完工，是大家的功劳。"
                }
            ]
        },
        {
            "id": "1101426",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142601",
                    "speaker": "乐明",
                    "text": "群玉阁已经修建完毕，等千奇核心和仙家符箓安好之后，就可以升空了。"
                }
            ]
        },
        {
            "id": "1101427",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142701",
                    "speaker": "理正",
                    "text": "能够参与修建群玉阁，对我也是一场考验…等放工之后，去喝一杯吧。"
                }
            ]
        },
        {
            "id": "1101428",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142801",
                    "speaker": "思勤",
                    "text": "我已经迫不及待，想看到群玉阁升空了！"
                }
            ]
        },
        {
            "id": "1101429",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110142901",
                    "speaker": "阿亮",
                    "text": "终于可以松一口气了，这段时间，各式各样的人来来往往，我们的压力也很大。"
                },
                {
                    "id": "110142902",
                    "speaker": "阿亮",
                    "text": "好在平安完工，希望孤云阁的兄弟们也一切顺利。"
                }
            ]
        },
        {
            "id": "1101430",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110143001",
                    "speaker": "七七",
                    "text": "啊，是你们。"
                },
                {
                    "id": "110143002",
                    "speaker": "Player",
                    "text": "七七怎么在这里？"
                },
                {
                    "id": "110143003",
                    "speaker": "七七",
                    "text": "海边，很危险。"
                },
                {
                    "id": "110143004",
                    "speaker": "七七",
                    "text": "七七正在，帮忙，疏散人群。",
                    "choices": [
                        {
                            "id": "110143005",
                            "text": "「危险」？",
                            "response": [
                                {
                                    "id": "110143007",
                                    "speaker": "七七",
                                    "text": "嗯。凝光说，海里有不好的东西。"
                                },
                                {
                                    "id": "110143008",
                                    "speaker": "七七",
                                    "text": "所以，派七七来，疏散人群。"
                                },
                                {
                                    "id": "110143009",
                                    "speaker": "七七",
                                    "text": "不过，没有人听七七说话，七七只能守在这里。"
                                },
                                {
                                    "id": "110143010",
                                    "speaker": "七七",
                                    "text": "万一有危险，七七就站出来，保护大家。"
                                },
                                {
                                    "id": "110143011",
                                    "speaker": "七七",
                                    "text": "你们，也不要靠近海边，会遇到危险。"
                                }
                            ]
                        },
                        {
                            "id": "110143006",
                            "text": "「疏散人群」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1101505",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110150501",
                    "speaker": "申鹤",
                    "text": "现在想想，多亏师父让我来送符箓，我才能与你相遇。"
                },
                {
                    "id": "110150502",
                    "speaker": "申鹤",
                    "text": "今后，也请多关照了。"
                }
            ]
        },
        {
            "id": "1101506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110150601",
                    "speaker": "凝光",
                    "text": "这次重修群玉阁，你出力颇多。"
                },
                {
                    "id": "110150602",
                    "speaker": "凝光",
                    "text": "此事我牢记在心。这个人情，我会择日还你。"
                }
            ]
        },
        {
            "id": "1101515",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110151501",
                    "speaker": "朱陶",
                    "text": "再喝，再喝！"
                }
            ]
        },
        {
            "id": "1101516",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110151601",
                    "speaker": "永业",
                    "text": "能来群玉阁上听戏喝酒，真是一种享受。"
                }
            ]
        },
        {
            "id": "1101517",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110151701",
                    "speaker": "诗羽",
                    "text": "什么时候我也能修一座群玉阁…唉，眼下我的财力还远远不够。"
                },
                {
                    "id": "110151702",
                    "speaker": "诗羽",
                    "text": "不过怀着这样的梦想去努力，或许有一天…"
                }
            ]
        },
        {
            "id": "1101599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110159901",
                    "speaker": "申鹤",
                    "text": "你们怎么也来了？"
                },
                {
                    "id": "110159902",
                    "speaker": "派蒙",
                    "text": "我们也不能让申鹤一个人冒险！"
                },
                {
                    "id": "110159903",
                    "speaker": "申鹤",
                    "text": "冒险谈不上。璃月港的人早有准备，眼下她已经受了重伤，只是靠执念支撑着而已。"
                },
                {
                    "id": "110159904",
                    "speaker": "申鹤",
                    "text": "虽然我的体力也所剩无几，不过像这样以命相搏…我大概比她要擅长。"
                },
                {
                    "id": "110159905",
                    "speaker": "派蒙",
                    "text": "我们也来帮忙！"
                },
                {
                    "id": "110159906",
                    "speaker": "派蒙",
                    "text": "她逃走了！我们要追过去吗？\\n"
                },
                {
                    "id": "110159907",
                    "speaker": "申鹤",
                    "text": "此处并不稳固，继续追下去风险太大。\\n"
                },
                {
                    "id": "110159908",
                    "speaker": "申鹤",
                    "text": "一旦坍塌，后果不堪设想…还是先回去吧。"
                }
            ]
        }
    ]
}