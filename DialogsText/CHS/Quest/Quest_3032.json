    "talks": [
        {
            "id": "303201",
            "objective": "与纳西妲对话",
            "dialogues": [
                {
                    "id": "30320101",
                    "speaker": "纳西妲",
                    "text": "#欢迎回来，{NICKNAME}，派蒙，散兵。"
                },
                {
                    "id": "30320102",
                    "speaker": "派蒙",
                    "text": "呼！感觉经历了很长的旅途…累死我了。"
                },
                {
                    "id": "30320103",
                    "speaker": "流浪者",
                    "text": "……"
                },
                {
                    "id": "30320104",
                    "speaker": "纳西妲",
                    "text": "莫非你是对这个名字感到不满？"
                },
                {
                    "id": "30320105",
                    "speaker": "流浪者",
                    "text": "没什么。只是在想，我也该换个名字了。"
                },
                {
                    "id": "30320106",
                    "speaker": "Player",
                    "text": "你不打算叫「散兵」了？"
                },
                {
                    "id": "30320107",
                    "speaker": "流浪者",
                    "text": "明知「博士」做了那么多事，我怎么可能继续采用跟他有关的称号。"
                },
                {
                    "id": "30320108",
                    "speaker": "流浪者",
                    "text": "我不打算也不可能回到愚人众那边。一定有许多人被这次的事影响，未必还能记得第六席是谁。"
                },
                {
                    "id": "30320109",
                    "speaker": "派蒙",
                    "text": "意思是你要脱离组织了？"
                },
                {
                    "id": "30320110",
                    "speaker": "Player",
                    "text": "也算是变相逃亡吧…"
                },
                {
                    "id": "30320111",
                    "speaker": "流浪者",
                    "text": "……"
                },
                {
                    "id": "30320112",
                    "speaker": "流浪者",
                    "text": "正如你所说，小吉祥草王。一切看似徒劳，但并非没有意义，至少能让不少人忘记我。"
                },
                {
                    "id": "30320113",
                    "speaker": "纳西妲",
                    "text": "可那也不意味着你身上的往事就此消失。"
                },
                {
                    "id": "30320114",
                    "speaker": "流浪者",
                    "text": "这是自然。"
                },
                {
                    "id": "30320115",
                    "speaker": "纳西妲",
                    "text": "另外，你倾尽全力去追求的事，它最核心的目的…并没能达成，这一点还请你明白。"
                },
                {
                    "id": "30320116",
                    "speaker": "纳西妲",
                    "text": "改变世界、改变过去…改变他人命运，并不是那么容易的。"
                },
                {
                    "id": "30320117",
                    "speaker": "纳西妲",
                    "text": "你所渴望的答案是极致的毁灭…它本质是虚妄。即便世上再没有「散兵」，世界也不会遵循你的意志而动。"
                },
                {
                    "id": "30320118",
                    "speaker": "流浪者",
                    "text": "…是啊。哈哈，真可笑。"
                },
                {
                    "id": "30320119",
                    "speaker": "派蒙",
                    "text": "为这样的结果做到这种地步…不会后悔吗？"
                },
                {
                    "id": "30320120",
                    "speaker": "流浪者",
                    "text": "哪怕我一文不值，世上也从来没有值得后悔的事。"
                },
                {
                    "id": "30320121",
                    "speaker": "流浪者",
                    "text": "小吉祥草王，世界树里的信息，是你故意留在那里的吧。"
                },
                {
                    "id": "30320122",
                    "speaker": "纳西妲",
                    "text": "为了让你尽可能自然地收获信息，我也费了不少心思呢。"
                },
                {
                    "id": "30320123",
                    "speaker": "流浪者",
                    "text": "为什么不惜做到这一步？你也想拉拢我吗？"
                },
                {
                    "id": "30320124",
                    "speaker": "纳西妲",
                    "text": "必须诚实地说，过去的经历使你成为了一个对我和须弥有用的个体。拉拢你的确是我计划的一部分。"
                },
                {
                    "id": "30320125",
                    "speaker": "纳西妲",
                    "text": "但在那之前，我想把过去的真相告诉你。如果只是利用，我就与「博士」毫无分别了。"
                },
                {
                    "id": "30320126",
                    "speaker": "流浪者",
                    "text": "…你很聪明。"
                },
                {
                    "id": "30320127",
                    "speaker": "纳西妲",
                    "text": "这大概是我应具有的美德吧。"
                },
                {
                    "id": "30320128",
                    "speaker": "流浪者",
                    "text": "对他人有用就是价值。所以即使身为罪人，我也重新拥有了被利用的理由。"
                },
                {
                    "id": "30320129",
                    "speaker": "Player",
                    "text": "纳西妲并不是那么想的。"
                },
                {
                    "id": "30320130",
                    "speaker": "流浪者",
                    "text": "噢对，差点忘了…你们是「正义」的一方，与我不同。"
                },
                {
                    "id": "30320131",
                    "speaker": "流浪者",
                    "text": "不好意思，我看待事物的角度略有不同。但我不会称这一切为算计，你的智慧注定了你会拥有更好的帮手。"
                },
                {
                    "id": "30320132",
                    "speaker": "纳西妲",
                    "text": "你能这么想就太好了。"
                },
                {
                    "id": "30320133",
                    "speaker": "纳西妲",
                    "text": "#{NICKNAME}，未来我还会进一步研究并挖掘世界树里深藏的秘密。"
                },
                {
                    "id": "30320134",
                    "speaker": "纳西妲",
                    "text": "包括你血亲被记录在世界树中的旅程之始。前后究竟还有什么？我也想知道呢。"
                },
                {
                    "id": "30320135",
                    "speaker": "Player",
                    "text": "那就拜托你为我寻找了。"
                },
                {
                    "id": "30320136",
                    "speaker": "纳西妲",
                    "text": "嗯。"
                },
                {
                    "id": "30320137",
                    "speaker": "流浪者",
                    "text": "#{NICKNAME}。"
                },
                {
                    "id": "30320138",
                    "speaker": "Player",
                    "text": "什么事？"
                },
                {
                    "id": "30320139",
                    "speaker": "流浪者",
                    "text": "为什么在我跳进世界树的信息洪流之后，你就去了稻妻？"
                },
                {
                    "id": "30320140",
                    "speaker": "Player",
                    "text": "因为我想知道你改变了什么。"
                },
                {
                    "id": "30320141",
                    "speaker": "流浪者",
                    "text": "…所以才打听到了那些人被改变后的命运吗。"
                },
                {
                    "id": "30320142",
                    "speaker": "流浪者",
                    "text": "不管怎么说，你帮了我的忙，这份恩情我都会尽力偿还。",
                    "choices": [
                        {
                            "id": "30320143",
                            "text": "…我做这些不是想要回报。",
                            "response": [
                                {
                                    "id": "30320145",
                                    "speaker": "流浪者",
                                    "text": "个体与个体之间只存在「借」和「还」的关系。我们迟早会两清，你不需要在意。"
                                },
                                {
                                    "id": "30320146",
                                    "speaker": "纳西妲",
                                    "text": "不是这样的哦。人与人的关系，绝不是轻易就能抚回原状的白纸。"
                                },
                                {
                                    "id": "30320147",
                                    "speaker": "纳西妲",
                                    "text": "你一定感受过。生命中出现过的人不会像水滴蒸发一样消失，世上不存在真正的「两清」。"
                                },
                                {
                                    "id": "30320148",
                                    "speaker": "纳西妲",
                                    "text": "正因为有些事不能挽回也不能改变，人间才会有情感。"
                                },
                                {
                                    "id": "30320149",
                                    "speaker": "纳西妲",
                                    "text": "你感受的所有东西都是真实，你欠下的事物也不会被弥补。"
                                },
                                {
                                    "id": "30320150",
                                    "speaker": "纳西妲",
                                    "text": "背负裂痕生活下去是人的行为。你可以选择是否成为人。"
                                },
                                {
                                    "id": "30320151",
                                    "speaker": "流浪者",
                                    "text": "……"
                                },
                                {
                                    "id": "30320152",
                                    "speaker": "流浪者",
                                    "text": "没有缺失心脏的人类，不是吗？再说，我早就不想成为人类了。"
                                },
                                {
                                    "id": "30320153",
                                    "speaker": "纳西妲",
                                    "text": "没有心脏的你依然能理解痛苦。你只是封闭了感情。"
                                },
                                {
                                    "id": "30320154",
                                    "speaker": "纳西妲",
                                    "text": "过去不会被撼动，但你可以继续走。只要未来的线够长，总有一天「过去」会变成比例尺上很短小的一段。"
                                },
                                {
                                    "id": "30320155",
                                    "speaker": "流浪者",
                                    "text": "听起来，你已经想好怎么安排我了。"
                                },
                                {
                                    "id": "30320156",
                                    "speaker": "Player",
                                    "text": "希望你能配合纳西妲。"
                                },
                                {
                                    "id": "30320157",
                                    "speaker": "派蒙",
                                    "text": "很多事情混在一起，都说不清楚了，反正最重要的是，你最好跟随纳西妲，否则我们为什么要做这么多嘛！"
                                },
                                {
                                    "id": "30320158",
                                    "speaker": "流浪者",
                                    "text": "…那就让我作为黑暗中的助力与你们同在吧。"
                                },
                                {
                                    "id": "30320159",
                                    "speaker": "纳西妲",
                                    "text": "很高兴你能接受我们的提议。为表庆祝，不如给自己起个新名字吧？"
                                },
                                {
                                    "id": "30320160",
                                    "speaker": "派蒙",
                                    "text": "快快快，我也要给你起个难听的绰号！"
                                },
                                {
                                    "id": "30320161",
                                    "speaker": "流浪者",
                                    "text": "为什么？"
                                },
                                {
                                    "id": "30320162",
                                    "speaker": "派蒙",
                                    "text": "因为…因为我还是不怎么喜欢你呀！"
                                },
                                {
                                    "id": "30320163",
                                    "speaker": "流浪者",
                                    "text": "哼。那以后我们最好不要经常见面。"
                                },
                                {
                                    "id": "30320164",
                                    "speaker": "纳西妲",
                                    "text": "「名字是人生第一份馈赠」——虽然你没明说，但我知道你是这么想的。"
                                },
                                {
                                    "id": "30320165",
                                    "speaker": "流浪者",
                                    "text": "……"
                                },
                                {
                                    "id": "30320166",
                                    "speaker": "纳西妲",
                                    "text": "#这次{NICKNAME}和派蒙帮了你不少忙，假如你无法决定要叫什么名字，可以问问他们的意见。"
                                },
                                {
                                    "id": "30320167",
                                    "speaker": "Player",
                                    "text": "欸？要我们来决定吗？"
                                },
                                {
                                    "id": "30320168",
                                    "speaker": "派蒙",
                                    "text": "不行，我只会起绰号，不会起正经名字…交给你了！"
                                }
                            ]
                        },
                        {
                            "id": "30320144",
                            "text": "请不要说得像是我在勒索你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "303202",
            "objective": "为流浪者取名",
            "dialogues": []
        },
        {
            "id": "303204",
            "objective": "与纳西妲对话",
            "dialogues": [
                {
                    "id": "30320401",
                    "speaker": "纳西妲",
                    "text": "这么一来，你也是有名字的人了哦。"
                },
                {
                    "id": "30320402",
                    "speaker": "Wanderer",
                    "text": "绰号呢？想好了吗？"
                },
                {
                    "id": "30320403",
                    "speaker": "派蒙",
                    "text": "呃…呃，还在想…别催呀…"
                },
                {
                    "id": "30320404",
                    "speaker": "Wanderer",
                    "text": "慢慢想。在你想好之前，我们暂时不必见面。"
                },
                {
                    "id": "30320405",
                    "speaker": "Player",
                    "text": "你打算做什么？"
                },
                {
                    "id": "30320406",
                    "speaker": "Wanderer",
                    "text": "那些构陷我令我陷入不幸的人，迟早都会付出代价。"
                },
                {
                    "id": "30320407",
                    "speaker": "派蒙",
                    "text": "是说愚人众吗？"
                },
                {
                    "id": "30320408",
                    "speaker": "Wanderer",
                    "text": "至少是「博士」。"
                },
                {
                    "id": "30320409",
                    "speaker": "纳西妲",
                    "text": "立场变化了呢，相信未来你的道路也会因此改变。但不是现在…你还需要一些时间来整理自己。"
                },
                {
                    "id": "30320410",
                    "speaker": "Wanderer",
                    "text": "……"
                },
                {
                    "id": "30320411",
                    "speaker": "Wanderer",
                    "text": "还有一件事。"
                },
                {
                    "id": "30320412",
                    "speaker": "Wanderer",
                    "text": "如今稻妻还有一些雷电五传的后人。他们中有人知道…或者说，本该知道我与雷电五传的关系。"
                },
                {
                    "id": "30320413",
                    "speaker": "Wanderer",
                    "text": "我暂时不打算离开须弥，假如你在稻妻遇见他们，大可以告诉他们，我就是令雷电五传陨落的凶手。"
                },
                {
                    "id": "30320414",
                    "speaker": "Wanderer",
                    "text": "…哪怕这件事已经从世界上抹除，他们也应该得到真相。"
                },
                {
                    "id": "30320415",
                    "speaker": "纳西妲",
                    "text": "原来如此…这是你的选择。"
                },
                {
                    "id": "30320416",
                    "speaker": "派蒙",
                    "text": "欸？可是这样一来…"
                },
                {
                    "id": "30320417",
                    "speaker": "Wanderer",
                    "text": "没什么，只要他们愿意，大可以用刀子捅进我的胸膛。…说不定本来就该是那样。",
                    "choices": [
                        {
                            "id": "30320418",
                            "text": "……",
                            "response": [
                                {
                                    "id": "30320419",
                                    "speaker": "Wanderer",
                                    "text": "你那是什么眼神？不用露出这种表情，我知道自己在做什么。"
                                },
                                {
                                    "id": "30320420",
                                    "speaker": "Wanderer",
                                    "text": "…会有那么一天的。"
                                },
                                {
                                    "id": "30320421",
                                    "speaker": "Wanderer",
                                    "text": "好了。"
                                },
                                {
                                    "id": "30320425",
                                    "speaker": "Wanderer",
                                    "text": "再会了，贤明的神，还有你们。"
                                },
                                {
                                    "id": "30320426",
                                    "speaker": "派蒙",
                                    "text": "走掉了呢…"
                                },
                                {
                                    "id": "30320427",
                                    "speaker": "纳西妲",
                                    "text": "最近发生的事对他而言，简直像是突然过完了一生。任何人都需要时间来平复心情吧。"
                                },
                                {
                                    "id": "30320428",
                                    "speaker": "派蒙",
                                    "text": "唔，也是。虽然他还是那样，但语气变得不那么激烈了呢。"
                                },
                                {
                                    "id": "30320429",
                                    "speaker": "Player",
                                    "text": "不管怎么说，都结束了。"
                                },
                                {
                                    "id": "30320430",
                                    "speaker": "派蒙",
                                    "text": "这下我们总算可以去吃饭了吧？我都快饿死了！"
                                },
                                {
                                    "id": "30320431",
                                    "speaker": "纳西妲",
                                    "text": "辛苦你们了，请找一个令人放松的地方尽情休息一会儿。"
                                }
                            ]
                        },
                        {
                            "id": "30320422",
                            "text": "我明白了。",
                            "response": [
                                {
                                    "id": "30320423",
                                    "speaker": "Wanderer",
                                    "text": "你很爽快，不错。"
                                },
                                {
                                    "id": "30320424",
                                    "speaker": "Wanderer",
                                    "text": "…好了，就聊到这里吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "303203",
            "objective": "聆听两位学者的对话",
            "dialogues": [
                {
                    "id": "30320301",
                    "speaker": "泽田",
                    "text": "我想好了！小说的结尾可以放在御舆长正身上。"
                },
                {
                    "id": "30320302",
                    "speaker": "亚卡巴",
                    "text": "意思是，故事里的其他人都不在了？"
                },
                {
                    "id": "30320303",
                    "speaker": "泽田",
                    "text": "是啊，听说御舆长正一直活到了寿终正寝呢，很适合当小说结尾的叙事者。"
                },
                {
                    "id": "30320304",
                    "speaker": "泽田",
                    "text": "「怪异的氛围散去了，可未来几十年里，这件事仍如阴云缭绕在御舆长正心头。」"
                },
                {
                    "id": "30320305",
                    "speaker": "泽田",
                    "text": "「年迈的他做了一个梦。名为『大踏鞴长正』之宝刀锻成那夜，众人欢呼雀跃，作画、起舞、饮酒。」"
                },
                {
                    "id": "30320306",
                    "speaker": "泽田",
                    "text": "「…万般欢喜都熔在了炉火中，化作红云，围抱着御舆长正一生最后所见的那片朝阳。」"
                },
                {
                    "id": "30320307",
                    "speaker": "泽田",
                    "text": "「此生路遥远，欲行已忘言。」"
                },
                {
                    "id": "30320308",
                    "speaker": "Wanderer",
                    "text": "…哼。"
                }
            ]
        },
        {
            "id": "303205",
            "objective": "返回休息处",
            "dialogues": [
                {
                    "id": "30320501",
                    "speaker": "派蒙",
                    "text": "呼——！终于到休息时间啦！"
                },
                {
                    "id": "30320502",
                    "speaker": "派蒙",
                    "text": "一旦放松下来，突然觉得好饿好累哦…",
                    "choices": [
                        {
                            "id": "30320503",
                            "text": "派蒙好好休息吧。",
                            "response": [
                                {
                                    "id": "30320505",
                                    "speaker": "派蒙",
                                    "text": "哇！太好了！"
                                },
                                {
                                    "id": "30320506",
                                    "speaker": "派蒙",
                                    "text": "…咦？那个瓶子…"
                                },
                                {
                                    "id": "30320507",
                                    "speaker": "Player",
                                    "text": "…嗯？"
                                },
                                {
                                    "id": "30320508",
                                    "speaker": "派蒙",
                                    "text": "是谁来打扫的时候碰碎了吗？可是，没听说有人来收拾过房间呀…"
                                },
                                {
                                    "id": "30320509",
                                    "speaker": "Player",
                                    "text": "（那天晚上在住宿处，派蒙被散兵的事吓到，一不小心撞到桌子，导致这只瓶子被打碎。）"
                                },
                                {
                                    "id": "30320510",
                                    "speaker": "Player",
                                    "text": "（可是紧接着散兵就抹去了自己存在过的事，他是改变了世界吧？那这只瓶子…为什么还是碎的…）"
                                },
                                {
                                    "id": "30320511",
                                    "speaker": "？？？",
                                    "text": "听起来，你很迷茫呢。"
                                },
                                {
                                    "id": "30320512",
                                    "speaker": "Player",
                                    "text": "…是谁？"
                                },
                                {
                                    "id": "30320513",
                                    "speaker": "？？？",
                                    "text": "我明白你的苦恼。任何人知道这些，都会觉得头晕脑胀。"
                                },
                                {
                                    "id": "30320514",
                                    "speaker": "派蒙",
                                    "text": "咦？有人在我们耳边说话？"
                                },
                                {
                                    "id": "30320515",
                                    "speaker": "？？？",
                                    "text": "不过很可惜，提瓦特的命运轻易无法撼动。神明尚且有微小的可能，非神之身…就难说了。"
                                },
                                {
                                    "id": "30320516",
                                    "speaker": "？？？",
                                    "text": "小小的动物撞在树干上会令它摇摆，可歪斜不等于位移，命运也是如此。"
                                },
                                {
                                    "id": "30320517",
                                    "speaker": "？？？",
                                    "text": "就像瓶子落到地上，小猫打碎的也好，飞鸟打碎的也好。结果它都碎成这样了，对吧？"
                                },
                                {
                                    "id": "30320518",
                                    "speaker": "派蒙",
                                    "text": "你、你是谁啊！为什么你会知道这些…"
                                },
                                {
                                    "id": "30320519",
                                    "speaker": "？？？",
                                    "text": "历史不会轻易被改变，但人们的心会。相信自己的眼睛，你所见才是真实，未见则为虚幻。"
                                },
                                {
                                    "id": "30320520",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "30320521",
                                    "speaker": "派蒙",
                                    "text": "声音消失了…？"
                                },
                                {
                                    "id": "30320522",
                                    "speaker": "派蒙",
                                    "text": "刚才那个人到底是谁啊！突然冒出来说些让人害怕的话，什么意思嘛…"
                                },
                                {
                                    "id": "30320523",
                                    "speaker": "Player",
                                    "text": "（相信眼睛？她所说的…是要我坚守住自己的记忆吗？）"
                                },
                                {
                                    "id": "30320524",
                                    "speaker": "派蒙",
                                    "text": "倒是那个瓶子，还碎在地上呢。我去找人来收拾一下吧？"
                                },
                                {
                                    "id": "30320525",
                                    "speaker": "派蒙",
                                    "text": "…总觉得就这么放着不管，心里有些怪怪的。那我去去就来！"
                                },
                                {
                                    "id": "30320526",
                                    "speaker": "Player",
                                    "text": "（……）"
                                },
                                {
                                    "id": "30320527",
                                    "speaker": "Player",
                                    "text": "（未来，还会有什么等着我呢？）"
                                }
                            ]
                        },
                        {
                            "id": "30320504",
                            "text": "买些好吃的东西奖励你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "303207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30320701",
                    "speaker": "流浪者",
                    "text": "想好了吗？"
                },
                {
                    "id": "30320702",
                    "speaker": "Wanderer",
                    "text": "（界面）"
                }
            ]
        },
        {
            "id": "303208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30320801",
                    "speaker": "流浪者",
                    "text": "你不是认真的吧。"
                },
                {
                    "id": "30321201",
                    "speaker": "Player",
                    "text": "我要再考虑一下。"
                },
                {
                    "id": "30321202",
                    "speaker": "流浪者",
                    "text": "好吧。"
                }
            ]
        },
        {
            "id": "303209",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30320901",
                    "speaker": "流浪者",
                    "text": "难道你觉得这个玩笑很幽默吗？"
                }
            ]
        },
        {
            "id": "303210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321001",
                    "speaker": "流浪者",
                    "text": "…哼。没必要再用这些名字了。"
                }
            ]
        },
        {
            "id": "303211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321101",
                    "speaker": "Player",
                    "text": "是的，我觉得这样就好。"
                },
                {
                    "id": "30321102",
                    "speaker": "Wanderer",
                    "text": "…就按你说的办吧。"
                }
            ]
        },
        {
            "id": "303213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321301",
                    "speaker": "流浪者",
                    "text": "不合适吧。"
                }
            ]
        },
        {
            "id": "303214",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321401",
                    "speaker": "流浪者",
                    "text": "…你不应该提这种建议。"
                }
            ]
        },
        {
            "id": "303215",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321501",
                    "speaker": "Wanderer",
                    "text": "想跟我分享你的名字？或许是个不错的选择。"
                }
            ]
        },
        {
            "id": "303216",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30321601",
                    "speaker": "Wanderer",
                    "text": "确定了？"
                }
            ]
        },
        {
            "id": "303220",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30322001",
                    "speaker": "泽田",
                    "text": "亚卡巴先生，谢谢你邀请我一起研究！"
                },
                {
                    "id": "30322002",
                    "speaker": "亚卡巴",
                    "text": "客气了泽田先生，还是多亏你的创意啊。没有你，我可能到现在还在咬笔杆吧。"
                }
            ]
        },
        {
            "id": "303221",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30322101",
                    "speaker": "纳西妲",
                    "text": "这次太感谢你们了，请好好休息。累了可以去洗个澡上个厕所转换心情哦。"
                }
            ]
        },
        {
            "id": "303298",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30329801",
                    "speaker": "泽田",
                    "text": "（御舆长正最后忆起的刀名叫「大踏鞴长正」而非「桂木斩长正」，是因为他还留有美好的回忆吧。）"
                },
                {
                    "id": "30329802",
                    "speaker": "亚卡巴",
                    "text": "（大受启发，我的论文有救啦！哈哈！）"
                },
                {
                    "id": "30329803",
                    "speaker": "Wanderer",
                    "text": "（这种感觉…就像是活了两次一样。）"
                },
                {
                    "id": "30329804",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        }
    ]
}