    "talks": [
        {
            "id": "7004601",
            "objective": "与奇怪的捕鱼人对话",
            "dialogues": [
                {
                    "id": "700460101",
                    "speaker": "哲俩阿",
                    "text": "完美，准备工作全都搞定了…"
                },
                {
                    "id": "700460102",
                    "speaker": "哲俩阿",
                    "text": "加把劲，哲俩阿，争取几天之内把它们全抓起来！",
                    "choices": [
                        {
                            "id": "700460103",
                            "text": "抓，抓什么？",
                            "response": [
                                {
                                    "id": "700460105",
                                    "speaker": "派蒙",
                                    "text": "噫！怎么枫丹也冒出盗猎者了…最近倒卖动物很赚钱吗？"
                                },
                                {
                                    "id": "700460106",
                                    "speaker": "派蒙",
                                    "text": "不行不行，我们要先把你抓起来，押送执律庭！"
                                },
                                {
                                    "id": "700460107",
                                    "speaker": "哲俩阿",
                                    "text": "…是你们？"
                                },
                                {
                                    "id": "700460108",
                                    "speaker": "哲俩阿",
                                    "text": "好啊好啊，我刚从执律庭过来，要不要我给你们带路？"
                                },
                                {
                                    "id": "700460109",
                                    "speaker": "派蒙",
                                    "text": "？",
                                    "choices": [
                                        {
                                            "id": "700460110",
                                            "text": "棒欸，我喜欢爽快人！",
                                            "response": [
                                                {
                                                    "id": "700460111",
                                                    "speaker": "派蒙",
                                                    "text": "等等，有点不对劲…听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…"
                                                },
                                                {
                                                    "id": "700460114",
                                                    "speaker": "哲俩阿",
                                                    "text": "就是站在正义这边的好人哦。"
                                                },
                                                {
                                                    "id": "700460115",
                                                    "speaker": "哲俩阿",
                                                    "text": "准确地说，是为了环境去战斗的执律庭特聘顾问——「放生徒追猎者」。"
                                                },
                                                {
                                                    "id": "700460116",
                                                    "speaker": "哲俩阿",
                                                    "text": "因为我要抓的，可是入侵枫丹水域的外来物种鱼。"
                                                },
                                                {
                                                    "id": "700460117",
                                                    "speaker": "派蒙",
                                                    "text": "外来…物种？",
                                                    "choices": [
                                                        {
                                                            "id": "700460118",
                                                            "text": "好像有点耳熟。",
                                                            "response": [
                                                                {
                                                                    "id": "700460119",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊，确实有印象，以前在蒙德听说过类似的事…"
                                                                },
                                                                {
                                                                    "id": "700460122",
                                                                    "speaker": "哲俩阿",
                                                                    "text": "过去的事先不提啦，现在的情况更重要。"
                                                                },
                                                                {
                                                                    "id": "700460123",
                                                                    "speaker": "哲俩阿",
                                                                    "text": "这些外来物种鱼啊，是被奇怪信仰的商人们特意放生的。"
                                                                },
                                                                {
                                                                    "id": "700460124",
                                                                    "speaker": "哲俩阿",
                                                                    "text": "它们有的特别凶猛，有的繁殖能力特别强，有的还被特殊的饲料喂养过，对于本地水生生物来说，全都是大麻烦。"
                                                                },
                                                                {
                                                                    "id": "700460125",
                                                                    "speaker": "哲俩阿",
                                                                    "text": "要是被它们鸠占鹊巢，改变了水下生物的结构，枫丹的水质有可能受到影响…"
                                                                },
                                                                {
                                                                    "id": "700460126",
                                                                    "speaker": "哲俩阿",
                                                                    "text": "不说枫丹人的健康这种长远问题，枫达这类饮料的口感第一时间就会变样吧，到时候枫丹的经济也会受到牵连，事情就大条了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700460127",
                                                                            "text": "枫达，你还不能倒下！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700460129",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "越是轻描淡写，越觉得问题很严重，我们不能坐视不理！"
                                                                                },
                                                                                {
                                                                                    "id": "700460130",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "抓鱼这种事，我们也挺在行的，不如就让我们来帮你一把？"
                                                                                },
                                                                                {
                                                                                    "id": "700460131",
                                                                                    "speaker": "哲俩阿",
                                                                                    "text": "太对了，我就等着这句话呢，这才是你们的作风！"
                                                                                },
                                                                                {
                                                                                    "id": "700460132",
                                                                                    "speaker": "哲俩阿",
                                                                                    "text": "我已经搭好了一个围捕区，其中的诱饵会将入侵鱼类统统吸引过来…"
                                                                                },
                                                                                {
                                                                                    "id": "700460133",
                                                                                    "speaker": "哲俩阿",
                                                                                    "text": "拿出你们执行正义的气势吧，荣誉骑士和白色小帮手，我会尽全力支持你们的！"
                                                                                },
                                                                                {
                                                                                    "id": "700460134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不知为什么，感觉这位小姐很了解我们…是我的错觉吗？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700460128",
                                                                            "text": "虽然不怎么喝，但枫达很重要…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700460120",
                                                            "text": "什么东西？",
                                                            "response": [
                                                                {
                                                                    "id": "700460121",
                                                                    "speaker": "派蒙",
                                                                    "text": "好像有点印象，应该是很久以前，我们在蒙德听说过类似的事…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700460112",
                                            "text": "等等…我们好像误会了什么？",
                                            "response": [
                                                {
                                                    "id": "700460113",
                                                    "speaker": "派蒙",
                                                    "text": "确实，听说要被抓起来还一副完全不怕的模样，要么是惯犯，要么就是…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700460104",
                            "text": "盗，盗猎？"
                        }
                    ]
                }
            ]
        }
    ]
}