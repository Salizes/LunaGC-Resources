            "dialogues": [
                {
                    "id": "130120201",
                    "speaker": "赛诺",
                    "text": "说起来，这几天还发生了一件怪事。"
                },
                {
                    "id": "130120202",
                    "speaker": "赛诺",
                    "text": "有个商人来找我讨要什么沙漠旅行包的钱，开口就是一百二十五万摩拉。"
                },
                {
                    "id": "130120203",
                    "speaker": "赛诺",
                    "text": "我对欠钱的事情毫无印象，这个数字又远超市场价，于是我就以「寻衅滋事」为由把对方关起来了。"
                },
                {
                    "id": "130120204",
                    "speaker": "赛诺",
                    "text": "这事你们有什么头绪吗？"
                },
                {
                    "id": "130120205",
                    "speaker": "派蒙",
                    "text": "没，没有。派蒙不知道哦。"
                }
            ]
        }
