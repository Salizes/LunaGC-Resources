    "talks": [
        {
            "id": "7329401",
            "objective": "与倒在地上的人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732940101",
                    "speaker": "于连",
                    "text": "唔唔…"
                },
                {
                    "id": "732940102",
                    "speaker": "派蒙",
                    "text": "#他看起来不怎么好的样子…肯定是饿坏了！{NICKNAME}，要不要分给他一些食物？",
                    "choices": [
                        {
                            "id": "732940103",
                            "text": "希望美食能给他力量。",
                            "response": [
                                {
                                    "id": "732940104",
                                    "speaker": "派蒙",
                                    "text": "#可不是因为我偏心才这么说，{NICKNAME}做的料理是真的很美味！"
                                },
                                {
                                    "id": "732940107",
                                    "speaker": "Black Screen",
                                    "text": "让倒地者吃下了提瓦特煎蛋。"
                                },
                                {
                                    "id": "732940108",
                                    "speaker": "于连",
                                    "text": "重！重获新生啦！"
                                },
                                {
                                    "id": "732940109",
                                    "speaker": "派蒙",
                                    "text": "哇…看来他是真的饿得不行了，只是一个煎蛋而已嘛…"
                                },
                                {
                                    "id": "732940110",
                                    "speaker": "于连",
                                    "text": "真是让人复活的美味呀…唉，早知道煎蛋这样美味，就该从那个家伙手里买下那枚神奇鸟蛋。"
                                },
                                {
                                    "id": "732940111",
                                    "speaker": "派蒙",
                                    "text": "什么神奇鸟蛋？"
                                },
                                {
                                    "id": "732940112",
                                    "speaker": "于连",
                                    "text": "据说只要吃下它就能抵消掉一天的厄运，要是当时就买下那枚神奇鸟蛋…不，要是能买十二枚…"
                                },
                                {
                                    "id": "732940113",
                                    "speaker": "派蒙",
                                    "text": "唔…听起来好可疑，像是什么骗人的买卖。不过，你怎么一个人到这种地方来呀？"
                                },
                                {
                                    "id": "732940114",
                                    "speaker": "于连",
                                    "text": "我是…呃…我是来须弥采风的枫丹知名画家。你们可以叫我于连。",
                                    "choices": [
                                        {
                                            "id": "732940115",
                                            "text": "到这种地方采风？",
                                            "response": [
                                                {
                                                    "id": "732940116",
                                                    "speaker": "派蒙",
                                                    "text": "应该有其他更适合采风的地方吧？比如说，风景更好，也更安全的地方。"
                                                },
                                                {
                                                    "id": "732940119",
                                                    "speaker": "派蒙",
                                                    "text": "而且，如果真的是从枫丹来的画家，那怎么两手空空？啊…该不会你其实是愚人众的卧底吧！"
                                                },
                                                {
                                                    "id": "732940120",
                                                    "speaker": "于连",
                                                    "text": "好激进的推理！很难想象是怎样的经历让你做出这样激进的推理。但是，我的确是画家，只是个画家，其他的什么也不是。"
                                                },
                                                {
                                                    "id": "732940121",
                                                    "speaker": "于连",
                                                    "text": "我只是，呃，其实我已经在这里得到了足够多的灵感，准备结束采风返回枫丹了。"
                                                },
                                                {
                                                    "id": "732940122",
                                                    "speaker": "于连",
                                                    "text": "没想到须弥的气候这么干燥，来时经过的沉玉谷还比较湿润，进入须弥地界之后风沙就多了起来…"
                                                },
                                                {
                                                    "id": "732940123",
                                                    "speaker": "于连",
                                                    "text": "说来惭愧，我还是比较习惯湿润气候，所以本想回程走水路体验一下不同的风景，结果筏子给冲散了，再加上我又不会游泳…"
                                                },
                                                {
                                                    "id": "732940124",
                                                    "speaker": "Player",
                                                    "text": "那你在枫丹生活应该很不容易吧。"
                                                },
                                                {
                                                    "id": "732940125",
                                                    "speaker": "于连",
                                                    "text": "确实是这样，不光是会不会水的问题，唉，算了。我在水边找了块能休息的地方，应该还有些没被泡烂的茶叶，为了表示感谢…"
                                                },
                                                {
                                                    "id": "732940126",
                                                    "speaker": "派蒙",
                                                    "text": "你要请我们喝茶吗？"
                                                },
                                                {
                                                    "id": "732940127",
                                                    "speaker": "于连",
                                                    "text": "呃，当然…当然！为了报答煎蛋的恩情，请两位…不知两位该怎么称呼？"
                                                },
                                                {
                                                    "id": "732940128",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，差点忘了自我介绍。",
                                                    "choices": [
                                                        {
                                                            "id": "732940129",
                                                            "text": "#{NICKNAME}和派蒙。",
                                                            "response": [
                                                                {
                                                                    "id": "732940134",
                                                                    "speaker": "于连",
                                                                    "text": "嗯，响亮的名字。总之，请你们喝茶。营地就在附近，很快就到了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732940130",
                                                            "text": "#正义的使者和{M#他的}{F#她的}扈从。",
                                                            "response": [
                                                                {
                                                                    "id": "732940131",
                                                                    "speaker": "派蒙",
                                                                    "text": "#是{NICKNAME}和最好的伙伴——派蒙！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732940132",
                                                            "text": "金灿灿和银闪闪。",
                                                            "response": [
                                                                {
                                                                    "id": "732940133",
                                                                    "speaker": "派蒙",
                                                                    "text": "#是金灿灿的{NICKNAME}和银闪闪的派蒙哦。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732940117",
                                            "text": "怎么会有人自称「知名」啊？",
                                            "response": [
                                                {
                                                    "id": "732940118",
                                                    "speaker": "派蒙",
                                                    "text": "就是就是！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732940105",
                            "text": "哈哈，他又不是派蒙。",
                            "response": [
                                {
                                    "id": "732940106",
                                    "speaker": "派蒙",
                                    "text": "什么嘛！不管是谁，总会有那么一两次因为饿昏而两眼一黑倒在地上的经历吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329404",
            "objective": "跟随于连前往营地",
            "dialogues": [
                {
                    "id": "732940401",
                    "speaker": "于连",
                    "text": "行李就拜托两位了…"
                }
            ]
        },
        {
            "id": "7329405",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732940501",
                    "speaker": "派蒙",
                    "text": "好简陋的营地！这还能算是营地吗…"
                },
                {
                    "id": "732940502",
                    "speaker": "于连",
                    "text": "可是这里风景还不错，走到沙滩边会感觉很开阔，比在枫丹的时候舒畅很多。"
                },
                {
                    "id": "732940503",
                    "speaker": "派蒙",
                    "text": "你在枫丹究竟过着怎样的生活啊…和想象中的知名画家会过的生活很不一样呢。"
                },
                {
                    "id": "732940504",
                    "speaker": "于连",
                    "text": "其实我在枫丹的住处很小，呃，因为我不是个贪图虚名的人。"
                },
                {
                    "id": "732940505",
                    "speaker": "派蒙",
                    "text": "野外的冒险家营地都比这里豪华多了呢。欸？这是…你的动物同伴呢？"
                },
                {
                    "id": "732940506",
                    "speaker": "于连",
                    "text": "呃…我可没有什么动物同伴，这大概是之前来这里的冒险家之类的留下的吧。话说回来…"
                },
                {
                    "id": "732940507",
                    "speaker": "于连",
                    "text": "我是很想拿出点好东西招待和报答两位的，但是不巧大部分行李都在筏子散架的时候掉进水里了，我又不会游泳…"
                },
                {
                    "id": "732940508",
                    "speaker": "于连",
                    "text": "如果两位能帮我把遗失在水上的行李找回来…"
                },
                {
                    "id": "732940509",
                    "speaker": "Player",
                    "text": "都泡水了这行李还能要吗…"
                },
                {
                    "id": "732940510",
                    "speaker": "于连",
                    "text": "我姑且都小心打包好了，但是里边有些东西…唉，没了就没了吧，没关系，我还能再画…还能…再画…"
                },
                {
                    "id": "732940511",
                    "speaker": "派蒙",
                    "text": "#唔…感觉有点可怜…{NICKNAME}，我们就帮帮他吧！"
                },
                {
                    "id": "732940512",
                    "speaker": "于连",
                    "text": "在这种地方实在无人可以依靠了…只能拜托两位，我在这儿泡好茶等你们。"
                }
            ]
        },
        {
            "id": "7329408",
            "objective": "在水上寻找于连的行李$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7329406",
            "objective": "在水上寻找于连的行李",
            "dialogues": []
        },
        {
            "id": "7329407",
            "objective": "在水上寻找于连的行李",
            "dialogues": []
        },
        {
            "id": "7329409",
            "objective": "在沙滩寻找于连的行李",
            "dialogues": []
        },
        {
            "id": "7329410",
            "objective": "调查沙滩上的狗",
            "dialogues": [
                {
                    "id": "732941001",
                    "speaker": "派蒙",
                    "text": "奇怪，这种地方怎么会有狗？而且像是看守着什么…"
                },
                {
                    "id": "732941002",
                    "speaker": "狗",
                    "text": "（警戒地看着你。）",
                    "choices": [
                        {
                            "id": "732941003",
                            "text": "看着挺聪明的。",
                            "response": [
                                {
                                    "id": "732941004",
                                    "speaker": "狗",
                                    "text": "（短吠了一声。）"
                                },
                                {
                                    "id": "732941007",
                                    "speaker": "派蒙",
                                    "text": "对了，之前不是在于连的营地看到过食盆吗？该不会是它的吧！奇怪，为什么于连说自己没有动物同伴呢…"
                                },
                                {
                                    "id": "732941008",
                                    "speaker": "狗",
                                    "text": "呜…"
                                },
                                {
                                    "id": "732941009",
                                    "speaker": "Black Screen",
                                    "text": "狗往营地的方向跑去了…"
                                },
                                {
                                    "id": "732941010",
                                    "speaker": "派蒙",
                                    "text": "它跑掉了…我们待会儿问问于连吧。不过现在…不知道这个沙堆下埋了什么，我们检查看看？"
                                }
                            ]
                        },
                        {
                            "id": "732941005",
                            "text": "哪来的野狗…",
                            "response": [
                                {
                                    "id": "732941006",
                                    "speaker": "狗",
                                    "text": "（发出狺狺的低吼。）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329411",
            "objective": "调查沙堆",
            "dialogues": []
        },
        {
            "id": "7329413",
            "objective": "击退敌人",
            "dialogues": []
        },
        {
            "id": "7329412",
            "objective": "前往营地，与于连对话",
            "dialogues": [
                {
                    "id": "732941201",
                    "speaker": "派蒙",
                    "text": "我们回来啦…哦！果然是于连的动物同伴！"
                },
                {
                    "id": "732941202",
                    "speaker": "狗",
                    "text": "（发出威胁的声音。）"
                },
                {
                    "id": "732941203",
                    "speaker": "于连",
                    "text": "…好哇，「胡椒」你这家伙…还吼我，你也不想想是谁在养这个家！"
                },
                {
                    "id": "732941204",
                    "speaker": "派蒙",
                    "text": "（原来它也有名字啊！不过这人没事吧？怎么在跟狗吵架…）",
                    "choices": [
                        {
                            "id": "732941205",
                            "text": "（看来感情很好。）",
                            "response": [
                                {
                                    "id": "732941206",
                                    "speaker": "派蒙",
                                    "text": "（这样能算是感情好吗？）"
                                },
                                {
                                    "id": "732941244",
                                    "speaker": "派蒙",
                                    "text": "那个…于连！你丢的东西我们都找回来了，话说「胡椒」应该就是你的动物同伴吧？为什么刚才骗我们说没有呢？"
                                },
                                {
                                    "id": "732941209",
                                    "speaker": "于连",
                                    "text": "跟这种恩将仇报的家伙？我宁可跟兽境猎犬当同伴。"
                                },
                                {
                                    "id": "732941210",
                                    "speaker": "Player",
                                    "text": "那你们可能当不了多久同伴…"
                                },
                                {
                                    "id": "732941211",
                                    "speaker": "派蒙",
                                    "text": "对呀，像于连这样光是肚饿都会昏倒的普通人，遇到兽境猎犬就不是一个提瓦特煎蛋能解决的问题了。"
                                },
                                {
                                    "id": "732941212",
                                    "speaker": "派蒙",
                                    "text": "说起来，它刚才在沙滩边上好像守着画板呢。",
                                    "choices": [
                                        {
                                            "id": "732941213",
                                            "text": "可能是想把画板藏起来…",
                                            "response": [
                                                {
                                                    "id": "732941214",
                                                    "speaker": "派蒙",
                                                    "text": "哇，坏狗狗！"
                                                },
                                                {
                                                    "id": "732941217",
                                                    "speaker": "「胡椒」",
                                                    "text": "（发出抗议的吠叫。）"
                                                },
                                                {
                                                    "id": "732941218",
                                                    "speaker": "于连",
                                                    "text": "你这家伙还有脸叫唤呢？要不是因为跟着你到了这条绝路，起码我还能原路回枫丹…"
                                                },
                                                {
                                                    "id": "732941219",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？你之前不是说是因为想看水路的风景才选水路回去的吗？"
                                                },
                                                {
                                                    "id": "732941220",
                                                    "speaker": "于连",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "732941221",
                                                    "speaker": "于连",
                                                    "text": "好吧，其实是根本没看到什么须弥的风景，就被这家伙给引路引到这里了。这附近的路弯弯绕绕，想不迷路都难呐。"
                                                },
                                                {
                                                    "id": "732941222",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样。那完全可以一开始就跟我们讲实话嘛。"
                                                },
                                                {
                                                    "id": "732941223",
                                                    "speaker": "于连",
                                                    "text": "呃…为了…为了身为知名画家的面子？"
                                                },
                                                {
                                                    "id": "732941224",
                                                    "speaker": "派蒙",
                                                    "text": "怎么感觉你每次吞吞吐吐的时候都是在编瞎话糊弄我们…"
                                                },
                                                {
                                                    "id": "732941225",
                                                    "speaker": "派蒙",
                                                    "text": "#不过说到须弥的风景，我跟{NICKNAME}倒是知道一些风景很不错的地方呢，我们可以带你去呀。"
                                                },
                                                {
                                                    "id": "732941226",
                                                    "speaker": "于连",
                                                    "text": "不、不用了吧，我是说，感谢你们的好意，不过，呃…我怎么说也是知名画家，我相信真正值得画的风景应该自己去发现…"
                                                },
                                                {
                                                    "id": "732941227",
                                                    "speaker": "于连",
                                                    "text": "对了，茶已经泡好了，还是来喝茶吧。顺便，如果还有煎蛋的话，可以再来点吗？就当配茶的点心…",
                                                    "choices": [
                                                        {
                                                            "id": "732941228",
                                                            "text": "为什么是煎蛋配茶…",
                                                            "response": [
                                                                {
                                                                    "id": "732941229",
                                                                    "speaker": "派蒙",
                                                                    "text": "#对呀，{NICKNAME}拿手的料理可多了！咱们可以吃点别的，嘿嘿。"
                                                                },
                                                                {
                                                                    "id": "732941232",
                                                                    "speaker": "Black Screen",
                                                                    "text": "和点心一道，享用了于连泡好的茶。\\n有种难以言喻的味道…"
                                                                },
                                                                {
                                                                    "id": "732941233",
                                                                    "speaker": "派蒙",
                                                                    "text": "这茶…唔…"
                                                                },
                                                                {
                                                                    "id": "732941234",
                                                                    "speaker": "于连",
                                                                    "text": "嗯，是朋友卖给我的，据说有激发潜在智慧的效果。我觉得还挺好喝的。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "732941235",
                                                                            "text": "幸好我没有这样的朋友。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "732941236",
                                                                                    "speaker": "于连",
                                                                                    "text": "为什么这样说？有朋友是好事，我这次来须弥也是受了朋友的指点。"
                                                                                },
                                                                                {
                                                                                    "id": "732941240",
                                                                                    "speaker": "于连",
                                                                                    "text": "今天的事真是多谢两位了，虽然不知道我能够提供的这点报酬是否能令两位满意…"
                                                                                },
                                                                                {
                                                                                    "id": "732941241",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "没关系啦，倒是采风景点…真的不需要我们帮忙吗？感觉你会迷路欸。"
                                                                                },
                                                                                {
                                                                                    "id": "732941242",
                                                                                    "speaker": "于连",
                                                                                    "text": "朝圣之路…咳，我是说，旅途的意义在于自己走过…这件事就不用再劳两位费心了，我能应付得来。"
                                                                                },
                                                                                {
                                                                                    "id": "732941243",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "既然你都这样说了…那好吧。记得不要再饿昏在路上了哦！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "732941237",
                                                                            "text": "能再给我一杯吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "732941238",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#{NICKNAME}，你的舌头没事吧？"
                                                                                },
                                                                                {
                                                                                    "id": "732941239",
                                                                                    "speaker": "于连",
                                                                                    "text": "哈哈，倒不是我吝啬，不过我还得在须弥待一阵子，多少得给自己留一点。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732941230",
                                                            "text": "你想得美哦。",
                                                            "response": [
                                                                {
                                                                    "id": "732941231",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…不过光喝茶好像少了点什么，还是做点好吃的吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732941215",
                                            "text": "可能是保护画板不被抢走。",
                                            "response": [
                                                {
                                                    "id": "732941216",
                                                    "speaker": "派蒙",
                                                    "text": "不过被我们找到之后它很快就跑走了呢！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732941207",
                            "text": "（也没闻到酒味啊…？）",
                            "response": [
                                {
                                    "id": "732941208",
                                    "speaker": "派蒙",
                                    "text": "（难道他平时就这样吗？唔…想想都觉得麻烦。）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329402",
            "objective": "(test)提供一些食物",
            "dialogues": []
        },
        {
            "id": "7329403",
            "objective": "(test)和于连对话",
            "dialogues": []
        },
        {
            "id": "7329499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732949901",
                    "speaker": "于连",
                    "text": "话说回来，两位又是为什么到这里来？应该…应该不会是和我一样吧…"
                },
                {
                    "id": "732949902",
                    "speaker": "派蒙",
                    "text": "和你一样…你是说为了画画专程到这里来吗？那当然不是啦。"
                },
                {
                    "id": "732949903",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}可是在册的冒险家呢，出现在提瓦特的任何角落都不奇怪！"
                },
                {
                    "id": "732949906",
                    "speaker": "派蒙",
                    "text": "是画板！肯定也是于连的，和其他东西一起带回去吧。我猜茶已经好了！快点快点！"
                }
            ]
        }
    ]
}