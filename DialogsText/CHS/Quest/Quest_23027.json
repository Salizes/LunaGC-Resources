        },
        {
            "id": "2302711",
            "objective": "向雅丝敏回报",
            "dialogues": [
                {
                    "id": "230271101",
                    "speaker": "雅丝敏",
                    "text": "你们回来了，圣树根系的情况怎么样？"
                },
                {
                    "id": "230271102",
                    "speaker": "Black Screen",
                    "text": "向雅丝敏叙述了根系的情况…"
                },
                {
                    "id": "230271103",
                    "speaker": "雅丝敏",
                    "text": "…喔，既然有生物聚集在那里，那就说明那块土地还有着很强的活力。"
                },
                {
                    "id": "230271104",
                    "speaker": "雅丝敏",
                    "text": "圣树的根系一定也能安稳地生长，暂时不会出太大的问题。"
                },
                {
                    "id": "230271105",
                    "speaker": "雅丝敏",
                    "text": "唯一要担心的问题…就是周围的水体会不会过营养化，从而滋生更多的蕈兽…"
                },
                {
                    "id": "230271106",
                    "speaker": "雅丝敏",
                    "text": "喔，这是你们的报酬，谢谢你们帮忙。"
                },
                {
                    "id": "230271107",
                    "speaker": "雅丝敏",
                    "text": "还是要让拉德普和法尔希监控一下周围的元素浓度才行…"
                }
            ]
        }
    ]
