        }
    },
    "talks": [
        {
            "id": "2302701",
            "objective": "与雅丝敏对话",
            "dialogues": [
                {
                    "id": "230270101",
                    "speaker": "雅丝敏",
                    "text": "果然还是得好好照看一下啊…"
                },
                {
                    "id": "230270102",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "230270103",
                    "speaker": "雅丝敏",
                    "text": "你是…喔，看样子是位旅行者，对吧？"
                },
                {
                    "id": "230270104",
                    "speaker": "雅丝敏",
                    "text": "我是阿弥利多学院的学生，雅丝敏，正在这里研究这棵「圣树」。"
                },
                {
                    "id": "230270105",
                    "speaker": "雅丝敏",
                    "text": "这棵「圣树」历经的岁月，比奥摩斯港里所有手抓饭的饭粒数量加起来都多。"
                },
                {
                    "id": "230270106",
                    "speaker": "雅丝敏",
                    "text": "同时它又托举着教令院…重要性堪比唐杜尔烤鸡底下垫着的蔬菜。",
                    "choices": [
                        {
                            "id": "230270107",
                            "text": "这都是些什么比喻…",
                            "response": [
                                {
                                    "id": "230270110",
                                    "speaker": "雅丝敏",
                                    "text": "但如果它出了问题，那须弥城也会面临巨大的灾难。"
                                },
                                {
                                    "id": "230270111",
                                    "speaker": "雅丝敏",
                                    "text": "比如，它遭到了虫害，比屋顶还大的蝗虫从树的内部冲出…"
                                },
                                {
                                    "id": "230270112",
                                    "speaker": "雅丝敏",
                                    "text": "或者是它的枝干生长失去控制，庞大的根系宛如洪水般从地底涌出，摧毁了所有房屋。"
                                },
                                {
                                    "id": "230270113",
                                    "speaker": "雅丝敏",
                                    "text": "又或者，这棵「圣树」飞速枯萎，倒下的树身压垮了半个须弥城…"
                                },
                                {
                                    "id": "230270114",
                                    "speaker": "Player",
                                    "text": "应，应该不会这样吧？！"
                                },
                                {
                                    "id": "230270115",
                                    "speaker": "雅丝敏",
                                    "text": "喔，那当然，到目前为止，它的情况一切正常。"
                                },
                                {
                                    "id": "230270116",
                                    "speaker": "雅丝敏",
                                    "text": "但话也说回来，在你去树林摘蘑菇的时候，袭击你的蕈兽也不会提前告知你它们的到来。"
                                },
                                {
                                    "id": "230270117",
                                    "speaker": "雅丝敏",
                                    "text": "我之所以在此研究，也是在观察这棵大树的情况，为各种可能发生的意外做准备。"
                                },
                                {
                                    "id": "230270118",
                                    "speaker": "雅丝敏",
                                    "text": "不过如你所见，就算我的思维如同暝彩鸟一般敏捷，但我的体力也如同星蕈一般孱弱…"
                                },
                                {
                                    "id": "230270119",
                                    "speaker": "雅丝敏",
                                    "text": "所以旅行者，你能帮我去记录几处「圣树」根系的状况吗？"
                                },
                                {
                                    "id": "230270120",
                                    "speaker": "雅丝敏",
                                    "text": "平时我都会雇佣冒险家和我同行，但现在他们似乎都没空…",
                                    "choices": [
                                        {
                                            "id": "230270121",
                                            "text": "交给我吧。"
                                        },
                                        {
                                            "id": "230270122",
                                            "text": "你们学者都是这么说话的吗…",
                                            "response": [
                                                {
                                                    "id": "230270123",
                                                    "speaker": "雅丝敏",
                                                    "text": "欸？你是说这些比喻吗？抱歉呀，我的说话方式一直是这样的…"
                                                },
                                                {
                                                    "id": "230270124",
                                                    "speaker": "雅丝敏",
                                                    "text": "学院里也有很多人和我说过这个问题，但我一时半会是改不回来了。"
                                                },
                                                {
                                                    "id": "230270125",
                                                    "speaker": "雅丝敏",
                                                    "text": "那这件事就拜托你了，我就在这里等着你。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230270108",
                            "text": "派蒙肯定能听懂吧。",
                            "response": [
                                {
                                    "id": "230270109",
                                    "speaker": "派蒙",
                                    "text": "真是一棵很伟大的树啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302702",
            "objective": "前往圣树根系所在的位置",
            "dialogues": [
                {
                    "id": "230270201",
                    "speaker": "雅丝敏",
                    "text": "旅行者，真巧，又见到你了。"
                },
                {
                    "id": "230270202",
                    "speaker": "Player",
                    "text": "你还在研究吗？"
                },
                {
                    "id": "230270203",
                    "speaker": "雅丝敏",
                    "text": "嗯，拉德普和法尔希说还需要搜集更多数据，我就只能继续我的工作啦。"
                },
                {
                    "id": "230270204",
                    "speaker": "雅丝敏",
                    "text": "不过，也不知道那些根系现在是什么情况…"
                },
                {
                    "id": "230270205",
                    "speaker": "雅丝敏",
                    "text": "旅行者，如果你有空的话，就请再帮我去记录一下那些根系的情况吧。"
                }
            ]
        },
        {
            "id": "2302703",
            "objective": "打倒所有魔物",
            "dialogues": [
                {
                    "id": "230270301",
                    "speaker": "雅丝敏",
                    "text": "那这件事就拜托你了，我就在这里等着你。"
                }
            ]
        },
