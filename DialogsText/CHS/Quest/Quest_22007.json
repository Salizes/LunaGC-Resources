    "talks": [
        {
            "id": "2200701",
            "objective": "与宝儿交谈",
            "dialogues": [
                {
                    "id": "220070101",
                    "speaker": "宝儿",
                    "text": "到底掉哪去了…"
                },
                {
                    "id": "220070102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "220070103",
                    "speaker": "宝儿",
                    "text": "哎呀，是这样…我在一处遗迹考察的时候，突然被怪物袭击…"
                },
                {
                    "id": "220070104",
                    "speaker": "宝儿",
                    "text": "我慌里慌张地逃跑，结果，把刚刚挖出来的文物忘在了原地。"
                },
                {
                    "id": "220070105",
                    "speaker": "宝儿",
                    "text": "那群怪物离开之后，我又折返回去，但是文物已经不见了…"
                },
                {
                    "id": "220070106",
                    "speaker": "宝儿",
                    "text": "我在周围找了半天也没找到，不知道是不是被怪物拿走了…"
                },
                {
                    "id": "220070107",
                    "speaker": "宝儿",
                    "text": "你能帮我去找找吗？如果找到文物的话，就用这个盒子装好吧。"
                }
            ]
        },
        {
            "id": "2200702",
            "objective": "寻找宝儿丢失的东西",
            "dialogues": [
                {
                    "id": "220070201",
                    "speaker": "宝儿",
                    "text": "到底掉哪去了…"
                },
                {
                    "id": "220070202",
                    "speaker": "Player",
                    "text": "只用这个盒子…"
                },
                {
                    "id": "220070203",
                    "speaker": "宝儿",
                    "text": "喂，你仔细看看啊，我可是用衣服在里面垫了好几层的。"
                },
                {
                    "id": "220070204",
                    "speaker": "宝儿",
                    "text": "我可是专业的学者，怎么可能犯低级错误。"
                },
                {
                    "id": "220070205",
                    "speaker": "宝儿",
                    "text": "好了，文物就拜托你了，我可拿那些怪物没办法…"
                }
            ]
        },
        {
            "id": "2200706",
            "objective": "寻找宝儿丢失的东西",
            "dialogues": []
        },
        {
            "id": "2200703",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "220070301",
                    "speaker": "派蒙",
                    "text": "唔，能找的地方好像都找遍了…还是没找到呢。"
                },
                {
                    "id": "220070302",
                    "speaker": "派蒙",
                    "text": "要接着找吗？还是回去再问问宝儿？",
                    "choices": [
                        {
                            "id": "220070303",
                            "text": "再找找吧。",
                            "response": [
                                {
                                    "id": "220070305",
                                    "speaker": "派蒙",
                                    "text": "好吧，那我们再仔细找找。"
                                }
                            ]
                        },
                        {
                            "id": "220070304",
                            "text": "回去吧。",
                            "response": [
                                {
                                    "id": "220070306",
                                    "speaker": "派蒙",
                                    "text": "嗯，回去再仔细问问吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200704",
            "objective": "从魔物手里拿回宝儿的东西",
            "dialogues": [
                {
                    "id": "220070401",
                    "speaker": "宝儿",
                    "text": "你找到文物了吗？"
                },
                {
                    "id": "220070402",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "220070403",
                    "speaker": "宝儿",
                    "text": "我来看看，哇…居然真的是文物…"
                },
                {
                    "id": "220070404",
                    "speaker": "宝儿",
                    "text": "咳，看起来…这个也不是我丢的文物，但是，也很有价值！"
                },
                {
                    "id": "220070405",
                    "speaker": "宝儿",
                    "text": "这个文物就交给我这个专业人士来保管，你们就放心吧，嘿嘿…辛苦你们啦。"
                }
            ]
        },
