            "dialogues": [
                {
                    "id": "411480401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411480402",
                    "speaker": "卯师傅",
                    "text": "好吧，那你先忙你的去，我去找其他人帮忙…"
                }
            ]
        },
        {
            "id": "4114801",
            "objective": "与卯师傅对话",
            "dialogues": [
                {
                    "id": "411480101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411480102",
                    "speaker": "卯师傅",
                    "text": "那就拜托你了。"
                },
                {
                    "id": "411480103",
                    "speaker": "卯师傅",
                    "text": "记得送的时候小心着点，<color=#00E1FFFF>不要沾了奇怪的东西。还有千万别用风之翼</color>。"
                },
                {
                    "id": "411480104",
                    "speaker": "卯师傅",
                    "text": "不然这摩拉肉里的肉，非全被颠出来不可…"
                }
            ]
        },
        {
            "id": "4114802",
            "objective": "将餐品送给好奇的子瑞",
            "dialogues": [
                {
                    "id": "411480201",
                    "speaker": "好奇的子瑞",
                    "text": "怎么还没送来，这都过了多长时间了…"
                }
            ]
        },
        {
            "id": "4114803",
            "objective": "与好奇的子瑞对话",
            "dialogues": [
                {
                    "id": "411480601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411480602",
                    "speaker": "好奇的子瑞",
                    "text": "总算送到了，谢谢，谢谢。"
                },
                {
                    "id": "411480603",
                    "speaker": "好奇的子瑞",
                    "text": "吃饱了之后我还得去周围逛逛。"
                },
                {
                    "id": "411480604",
                    "speaker": "好奇的子瑞",
                    "text": "唉，这周围也没几块能入眼的石头…"
                }
            ]
        },
        {
            "id": "4114803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411480301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411480302",
                    "speaker": "卯师傅",
                    "text": "对，一位叫子瑞的小伙子在我们这订了一份摩拉肉，钱已经付好了。"
                },
                {
                    "id": "411480303",
                    "speaker": "卯师傅",
                    "text": "然后…他让我们晚些时候送到渌华池附近的一个地方。"
                },
                {
                    "id": "411480304",
                    "speaker": "卯师傅",
                    "text": "我还要在这看着店，你愿意帮我去跑一趟吗？"
                }
            ]
        },
        {
            "id": "4114805",
