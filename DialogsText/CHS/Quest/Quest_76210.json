    "talks": [
        {
            "id": "7621001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762100101",
                    "speaker": "长孙继璟",
                    "text": "#{M#郎君}{F#女侠}果然好身法。"
                },
                {
                    "id": "762100102",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，那是当然！{NICKNAME}可是很强的！"
                },
                {
                    "id": "762100103",
                    "speaker": "长孙继璟",
                    "text": "#接下来，不知{M#郎君}{F#女侠}可否向在下展现<color=#00E1FFFF>纵跃法</color>的精髓？"
                },
                {
                    "id": "762100104",
                    "speaker": "长孙继璟",
                    "text": "据书中记载，我古华先师跳墙越城，如登平地，真有飞檐走壁之能，是为纵跃之法——",
                    "choices": [
                        {
                            "id": "762100105",
                            "text": "好厉害！",
                            "response": [
                                {
                                    "id": "762100108",
                                    "speaker": "派蒙",
                                    "text": "#嗯…要不然试试看？毕竟{NICKNAME}平时到处翻宝箱，也爬过很多地方了…"
                                }
                            ]
                        },
                        {
                            "id": "762100106",
                            "text": "听着像飞贼…",
                            "response": [
                                {
                                    "id": "762100107",
                                    "speaker": "长孙继璟",
                                    "text": "#呵呵，{M#郎君}{F#女侠}请想，若是飞贼能逾墙而走，我等锄恶扶正之人却不能，岂不是要被那奸邪之徒轻易走脱？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621009",
            "objective": "和画中人对话",
            "dialogues": [
                {
                    "id": "762100617",
                    "speaker": "Black Screen",
                    "text": "画中人纵身一跃，来到了你们面前…"
                },
                {
                    "id": "762100601",
                    "speaker": "长孙继璟",
                    "text": "#在下长孙继璟，见过{M#郎君}{F#女侠}当面。不知{M#郎君}{F#女侠}唤住在下，有何要事相商？"
                },
                {
                    "id": "762100602",
                    "speaker": "派蒙",
                    "text": "呃，也没什么要事啦。只是看你在画里跳来跳去的，稍微有点好奇…"
                },
                {
                    "id": "762100603",
                    "speaker": "长孙继璟",
                    "text": "原是这般。在下方才正苦砺轻身之法，只是技法愚拙，让二位见笑了。"
                },
                {
                    "id": "762100604",
                    "speaker": "派蒙",
                    "text": "轻身之法？"
                },
                {
                    "id": "762100605",
                    "speaker": "长孙继璟",
                    "text": "不错。此地从未有雨点落下，在下难以修习恩师所传「裁雨」之法，然窃思不可荒废武技，故而只得这般修习。"
                },
                {
                    "id": "762100606",
                    "speaker": "长孙继璟",
                    "text": "遥想当年，先师古华正是在石桩上修习身法，终臻大成。我等晚生无能，却仍愿拟仿先师皮毛，只求些微寸进。"
                },
                {
                    "id": "762100607",
                    "speaker": "长孙继璟",
                    "text": "#既然今日有缘相会，我观{M#郎君}{F#女侠}又同为习武之人，可否请{M#郎君}{F#女侠}不吝赐教一二？",
                    "choices": [
                        {
                            "id": "762100609",
                            "text": "哼，正合我意。汝可要看好了！",
                            "response": [
                                {
                                    "id": "762100610",
                                    "speaker": "派蒙",
                                    "text": "呜哇，语气突然变得好奇怪！呃，所以我们要做什么？"
                                },
                                {
                                    "id": "762100614",
                                    "speaker": "长孙继璟",
                                    "text": "多谢。那么，还请二位观瞧。"
                                }
                            ]
                        },
                        {
                            "id": "762100611",
                            "text": "派蒙是我派蒙派掌门，派派蒙去吧。",
                            "response": [
                                {
                                    "id": "762100612",
                                    "speaker": "长孙继璟",
                                    "text": "原来是派蒙派派蒙派掌门。晚生失敬。"
                                },
                                {
                                    "id": "762100613",
                                    "speaker": "派蒙",
                                    "text": "已经完全听不懂你在说什么了！而且就算是行秋的武侠小说里也没有让掌门先上的道理吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621011",
            "objective": "和长孙对话",
            "dialogues": [
                {
                    "id": "762100301",
                    "speaker": "长孙继璟",
                    "text": "二位请看。这便是我古华堂的「望梅之阵」。"
                },
                {
                    "id": "762100302",
                    "speaker": "长孙继璟",
                    "text": "#可否请{M#郎君}{F#女侠}在规定时间内依次踏过由在下指出的石桩，向在下展示身法？",
                    "choices": [
                        {
                            "id": "762100303",
                            "text": "小事一桩。",
                            "response": [
                                {
                                    "id": "762100304",
                                    "speaker": "派蒙",
                                    "text": "虽然其实有好多好多桩就是了…呃，没什么。"
                                },
                                {
                                    "id": "762100307",
                                    "speaker": "长孙继璟",
                                    "text": "#那么，便请{M#郎君}{F#女侠}一展身手吧。"
                                }
                            ]
                        },
                        {
                            "id": "762100305",
                            "text": "其实派蒙派掌门派蒙也能做到…",
                            "response": [
                                {
                                    "id": "762100306",
                                    "speaker": "派蒙",
                                    "text": "做不到！不管怎么想都——咦？仔细想想好像还真能做到…不过，用飞的应该算犯规吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621010",
            "objective": "在「望梅之阵」上大展身手",
            "dialogues": []
        },
        {
            "id": "7621002",
            "objective": "和长孙对话",
            "dialogues": []
        },
        {
            "id": "7621007",
            "objective": "前往下一处地点",
            "dialogues": []
        },
        {
            "id": "7621008",
            "objective": "和长孙对话",
            "dialogues": [
                {
                    "id": "762100401",
                    "speaker": "长孙继璟",
                    "text": "#{M#郎君}{F#女侠}，可曾准备好？",
                    "choices": [
                        {
                            "id": "762100402",
                            "text": "开始吧。"
                        },
                        {
                            "id": "762100403",
                            "text": "稍候。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621003",
            "objective": "以纵跃之法，在屋檐上大展身手",
            "dialogues": []
        },
        {
            "id": "7621005",
            "objective": "和长孙对话",
            "dialogues": [
                {
                    "id": "762100201",
                    "speaker": "长孙继璟",
                    "text": "令人仰止。晚生叹服。"
                },
                {
                    "id": "762100202",
                    "speaker": "长孙继璟",
                    "text": "#既是如此…在下还有一个不情之请。不知{M#郎君}{F#女侠}可曾听说过<color=#00E1FFFF>纵云之法</color>？"
                },
                {
                    "id": "762100203",
                    "speaker": "长孙继璟",
                    "text": "传闻我等先师古华，曾在华光紫气中登临高天，踏空而行，如履平地，正是靠这传说中的秘法…",
                    "choices": [
                        {
                            "id": "762100204",
                            "text": "听着有点离谱…",
                            "response": [
                                {
                                    "id": "762100205",
                                    "speaker": "派蒙",
                                    "text": "是啊，听着就像是假的…不过这么说来，要是能用风之翼的话，说不定也可以做到类似的效果？"
                                },
                                {
                                    "id": "762100207",
                                    "speaker": "长孙继璟",
                                    "text": "#哦？那便请{M#郎君}{F#女侠}示范一二了！"
                                }
                            ]
                        },
                        {
                            "id": "762100206",
                            "text": "如果能用风之翼的话…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621006",
            "objective": "总之就是想办法在半空中大展身手",
            "dialogues": []
        },
        {
            "id": "7621004",
            "objective": "和长孙对话",
            "dialogues": [
                {
                    "id": "762100501",
                    "speaker": "长孙继璟",
                    "text": "原来如此…"
                },
                {
                    "id": "762100502",
                    "speaker": "长孙继璟",
                    "text": "#虽说不算是踏空而行，但亦对在下颇有启发。多谢{M#郎君}{F#女侠}提点。"
                }
            ]
        }
    ]
}