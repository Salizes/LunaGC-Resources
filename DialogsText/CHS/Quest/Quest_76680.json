    "talks": [
        {
            "id": "7668001",
            "objective": "与青霆对话",
            "dialogues": [
                {
                    "id": "766800101",
                    "speaker": "青霆",
                    "text": "#哦呦，{NICKNAME}和派蒙，你们好啊！"
                },
                {
                    "id": "766800102",
                    "speaker": "青霆",
                    "text": "既然巧遇了，要不要来看看我青霆的鼬鼬？它叫洋葱尾巴，很可爱的！"
                },
                {
                    "id": "766800103",
                    "speaker": "洋葱尾巴",
                    "text": "…喵？"
                },
                {
                    "id": "766800104",
                    "speaker": "青霆",
                    "text": "喂喂，洋葱尾巴，你不是这样叫的！这两位应该不懂阿舍鲁老师的语言。"
                },
                {
                    "id": "766800105",
                    "speaker": "洋葱尾巴",
                    "text": "…咕？"
                },
                {
                    "id": "766800106",
                    "speaker": "青霆",
                    "text": "也不能用团雀语哦，拜希麦小姐已经回须弥去休养了。"
                },
                {
                    "id": "766800107",
                    "speaker": "青霆",
                    "text": "对不起啊，我家洋葱尾巴和别的动物交流太多，一时错乱了，暂时找不回自己的频道，哈哈…"
                },
                {
                    "id": "766800108",
                    "speaker": "青霆",
                    "text": "先让它休息一下好了。",
                    "choices": [
                        {
                            "id": "766800109",
                            "text": "你也是动物专家？",
                            "response": [
                                {
                                    "id": "766800111",
                                    "speaker": "派蒙",
                                    "text": "唔，怎么感觉你和我们很熟，说话很自然的样子…难道以前调查过我们吗？"
                                },
                                {
                                    "id": "766800112",
                                    "speaker": "青霆",
                                    "text": "放松，放松，我是你们的自己人——"
                                },
                                {
                                    "id": "766800113",
                                    "speaker": "青霆",
                                    "text": "我为夜兰老板工作，而你们是夜兰老板最最重要的宾客，咱们关系有多铁，不用多说了吧？",
                                    "choices": [
                                        {
                                            "id": "766800114",
                                            "text": "那确实是自己人。",
                                            "response": [
                                                {
                                                    "id": "766800116",
                                                    "speaker": "派蒙",
                                                    "text": "哎呀，早说嘛！害我紧张了一小下…"
                                                },
                                                {
                                                    "id": "766800117",
                                                    "speaker": "派蒙",
                                                    "text": "话说回来，你和洋葱尾巴在这荒郊野岭呆站着，是在忙什么呢？"
                                                },
                                                {
                                                    "id": "766800118",
                                                    "speaker": "青霆",
                                                    "text": "忙着看大门…或者说，检验我的「看大门军团」能不能好好上工。",
                                                    "choices": [
                                                        {
                                                            "id": "766800119",
                                                            "text": "看大门？",
                                                            "response": [
                                                                {
                                                                    "id": "766800121",
                                                                    "speaker": "青霆",
                                                                    "text": "都是自己人，我悄悄告诉你们——"
                                                                },
                                                                {
                                                                    "id": "766800122",
                                                                    "speaker": "青霆",
                                                                    "text": "这附近的地下藏着我的一座物资据点，但最近，据点老是被各种魔物撬开大门。"
                                                                },
                                                                {
                                                                    "id": "766800123",
                                                                    "speaker": "青霆",
                                                                    "text": "于是我花费重金，请叮铃哐啷蛋卷工坊的天才机械师为我打造了看门的机关军团。"
                                                                },
                                                                {
                                                                    "id": "766800124",
                                                                    "speaker": "青霆",
                                                                    "text": "咳咳，准确描述，应该是安防系统。能够自行选择部署地点，多种功能组合搭配的防御体系。"
                                                                },
                                                                {
                                                                    "id": "766800125",
                                                                    "speaker": "青霆",
                                                                    "text": "我运气不错，再过不久，那位大师就要带着她的作品参加展会，卖给我的这套，就当成前期验证的款式了。"
                                                                },
                                                                {
                                                                    "id": "766800126",
                                                                    "speaker": "青霆",
                                                                    "text": "所以我在据点前方打造了一条复合防线，请君…不对，是请魔物入瓮。"
                                                                },
                                                                {
                                                                    "id": "766800127",
                                                                    "speaker": "青霆",
                                                                    "text": "这样，不仅能试出多个保护据点的方案，还能给大师提供许多数据，一举两得。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "766800128",
                                                                            "text": "原来你买到了爱诺的杰作。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "766800130",
                                                                                    "speaker": "青霆",
                                                                                    "text": "要来试试看吗？我已经借助它们搞定许多魔物了，感觉非常解压。"
                                                                                },
                                                                                {
                                                                                    "id": "766800131",
                                                                                    "speaker": "青霆",
                                                                                    "text": "你们也来解压一下，顺带，让我参考参考你们的思路！"
                                                                                },
                                                                                {
                                                                                    "id": "766800132",
                                                                                    "speaker": "青霆",
                                                                                    "text": "当然，酬劳好说。都是自己人，开价得是一般顾问的两倍才行。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "766800133",
                                                                                            "text": "的确，都自己人，多给点！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "766800135",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯…嗯嗯！考虑到帮你也是变相帮了夜兰，这事对大家都有好处…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766800136",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "就让经验丰富的我们露两手好了！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "766800134",
                                                                                            "text": "哎呀，这怎么好意思呢…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "766800129",
                                                                            "text": "听起来还挺有意思的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766800120",
                                                            "text": "军团？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766800115",
                                            "text": "夜兰的朋友也是我们的朋友。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766800110",
                            "text": "你也是动物朋友？"
                        }
                    ]
                }
            ]
        }
    ]
}