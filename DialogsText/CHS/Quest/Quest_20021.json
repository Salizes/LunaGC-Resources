    "talks": [
        {
            "id": "2002101",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200211301",
                    "speaker": "安娜",
                    "text": "喔…我差不多了解了！不过光听理论也不行…"
                },
                {
                    "id": "200211302",
                    "speaker": "安娜",
                    "text": "旅行者，能请你为我演示一下风之翼的操纵方式吗？",
                    "choices": [
                        {
                            "id": "200211303",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200211305",
                                    "speaker": "安娜",
                                    "text": "那就拜托你啦，我们赶紧出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "200211304",
                            "text": "你可要看好了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002102",
            "objective": "为安娜演示操纵风之翼的方法",
            "dialogues": [
                {
                    "id": "200210201",
                    "speaker": "Player",
                    "text": "一架风之翼只可由一人使用。"
                },
                {
                    "id": "200210202",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2002103",
            "objective": "为安娜演示操纵风之翼的方法",
            "dialogues": [
                {
                    "id": "200210301",
                    "speaker": "Player",
                    "text": "这取决于风之翼操纵者的水平。"
                },
                {
                    "id": "200210302",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2002104",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200211401",
                    "speaker": "安娜",
                    "text": "你操纵风之翼的手法可真是太厉害了，怪不得安柏小姐要我来请教你呢。"
                },
                {
                    "id": "200211402",
                    "speaker": "安娜",
                    "text": "嘿嘿，有你给我辅导，我肯定能通过飞行执照的考试。"
                },
                {
                    "id": "200211403",
                    "speaker": "安娜",
                    "text": "谢谢你啦，这些东西请你收下，我先回去复习了。"
                },
                {
                    "id": "200211404",
                    "speaker": "安娜",
                    "text": "唔…我的风之翼用什么颜色比较好呢…"
                },
                {
                    "id": "200211405",
                    "speaker": "安娜",
                    "text": "蓝色？绿色？不然都要一点好了…"
                }
            ]
        },
        {
            "id": "2002105",
            "objective": "",
            "dialogues": [
                {
                    "id": "200210501",
                    "speaker": "安娜",
                    "text": "第二个问题是，使用风之翼起飞时，需要注意什么？"
                }
            ]
        },
        {
            "id": "2002106",
            "objective": "",
            "dialogues": [
                {
                    "id": "200210601",
                    "speaker": "Player",
                    "text": "需采取合理的起飞动作与起飞地点。"
                },
                {
                    "id": "200210602",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2002101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200210101",
                    "speaker": "安娜",
                    "text": "为什么使用风之翼还要考飞行执照这种东西啦…"
                },
                {
                    "id": "200210102",
                    "speaker": "安娜",
                    "text": "哥，你考过飞行执照吗？"
                },
                {
                    "id": "200210103",
                    "speaker": "安东尼",
                    "text": "我不用风之翼，从来没考过…"
                },
                {
                    "id": "200210104",
                    "speaker": "Player",
                    "text": "你要考飞行执照？"
                },
                {
                    "id": "200210105",
                    "speaker": "安娜",
                    "text": "因为风之翼是冒险的必备道具嘛，所以我就想练习一下风之翼的使用方法。"
                },
                {
                    "id": "200210106",
                    "speaker": "安娜",
                    "text": "但我没想到…居然还有飞行执照这种东西…"
                },
                {
                    "id": "200210107",
                    "speaker": "安娜",
                    "text": "虽然我已经报名考试了…但一些知识点我还是没完全背熟…"
                },
                {
                    "id": "200210108",
                    "speaker": "安娜",
                    "text": "旅行者，我听安柏小姐说，你已经有飞行执照了，能请你辅导我一下吗？",
                    "choices": [
                        {
                            "id": "200210109",
                            "text": "是安柏为你监考吗？",
                            "response": [
                                {
                                    "id": "200210110",
                                    "speaker": "安娜",
                                    "text": "那倒不是，我只是在报名的时候遇见了安柏小姐。"
                                },
                                {
                                    "id": "200210111",
                                    "speaker": "安娜",
                                    "text": "她为我介绍飞行执照考试情况的时候提到了你，她说你考得可好了。"
                                },
                                {
                                    "id": "200210112",
                                    "speaker": "安娜",
                                    "text": "所以，我就想来请教一下你有关飞行执照考试的问题…"
                                },
                                {
                                    "id": "200210115",
                                    "speaker": "安娜",
                                    "text": "那…我有三个问题想要问你。"
                                },
                                {
                                    "id": "200210116",
                                    "speaker": "安娜",
                                    "text": "唔…第一个问题是，在飞行时，最多可以同时几人共用一架风之翼？"
                                }
                            ]
                        },
                        {
                            "id": "200210113",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200210114",
                                    "speaker": "安娜",
                                    "text": "太好了！那就拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200210401",
                    "speaker": "Player",
                    "text": "这取决于风之翼操纵者的体重。"
                },
                {
                    "id": "200210402",
                    "speaker": "安娜",
                    "text": "原来如此…"
                }
            ]
        },
        {
            "id": "2002107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200210701",
                    "speaker": "Player",
                    "text": "用风史莱姆起飞很有趣。"
                },
                {
                    "id": "200210702",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2002108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200210801",
                    "speaker": "Player",
                    "text": "要保证自己处于风之翼下方。"
                },
                {
                    "id": "200210802",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2002109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200210901",
                    "speaker": "安娜",
                    "text": "第三个问题是，在使用风之翼降落时，需要注意什么？"
                }
            ]
        },
        {
            "id": "2002110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200211001",
                    "speaker": "Player",
                    "text": "需合理挑选降落地点，不可直接收起风之翼。"
                },
                {
                    "id": "200211002",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2002111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200211101",
                    "speaker": "Player",
                    "text": "最重要的是降落时的姿势。"
                },
                {
                    "id": "200211102",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        },
        {
            "id": "2002112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200211201",
                    "speaker": "Player",
                    "text": "尽可能落在地上。"
                },
                {
                    "id": "200211202",
                    "speaker": "安娜",
                    "text": "是这样吗…"
                }
            ]
        }
    ]
}