    "talks": [
        {
            "id": "7419301",
            "objective": "(test)找到美露辛$HIDDEN",
            "dialogues": [
                {
                    "id": "741930101",
                    "speaker": "珀西芙",
                    "text": "#派蒙！{NICKNAME}！"
                },
                {
                    "id": "741930102",
                    "speaker": "派蒙",
                    "text": "哇！居然是珀西芙！又见到你了，真高兴！你在这里做什么呀？"
                },
                {
                    "id": "741930103",
                    "speaker": "珀西芙",
                    "text": "珀西芙…干活！珀西芙…累累！珀西芙…躺！"
                },
                {
                    "id": "741930104",
                    "speaker": "派蒙",
                    "text": "呃…？你在干活？"
                },
                {
                    "id": "741930105",
                    "speaker": "珀西芙",
                    "text": "幽林枝…幽林枝…十分很丢！"
                },
                {
                    "id": "741930106",
                    "speaker": "派蒙",
                    "text": "幽林枝？那是什么？"
                },
                {
                    "id": "741930107",
                    "speaker": "珀西芙",
                    "text": "幽林枝…信息！"
                },
                {
                    "id": "741930108",
                    "speaker": "珀西芙",
                    "text": "垂柳，收集。雾道，处理。泉眼，发送。"
                },
                {
                    "id": "741930109",
                    "speaker": "珀西芙",
                    "text": "幽林枝，雾道信息！"
                },
                {
                    "id": "741930110",
                    "speaker": "Player",
                    "text": "那是幽林雾道的信息？"
                },
                {
                    "id": "741930111",
                    "speaker": "珀西芙",
                    "text": "珀西芙！"
                },
                {
                    "id": "741930112",
                    "speaker": "珀西芙",
                    "text": "幽林枝…十分很丢！十分很多地方！"
                },
                {
                    "id": "741930113",
                    "speaker": "珀西芙",
                    "text": "珀西芙…找！珀西芙…累累！珀西芙…吃！珀西芙…躺！"
                },
                {
                    "id": "741930114",
                    "speaker": "珀西芙",
                    "text": "幽林枝…十分很不多！但是箱子，十分很多！"
                },
                {
                    "id": "741930115",
                    "speaker": "珀西芙",
                    "text": "#啊…谢谢派蒙，谢谢{NICKNAME}，给！"
                },
                {
                    "id": "741930116",
                    "speaker": "Player",
                    "text": "你又给我们找到了宝箱吗？"
                },
                {
                    "id": "741930117",
                    "speaker": "珀西芙",
                    "text": "珀西芙！箱子，宝贝，花花，闪闪，甜甜，十分很多！"
                },
                {
                    "id": "741930118",
                    "speaker": "派蒙",
                    "text": "哇，还有别的东西吗？珀西芙，你真好，但如果白拿你的东西就太不好意思了，不如我们来交换吧！"
                },
                {
                    "id": "741930119",
                    "speaker": "珀西芙",
                    "text": "交…换？"
                },
                {
                    "id": "741930120",
                    "speaker": "派蒙",
                    "text": "因为我们是朋友，朋友就是用真心交换真心的那种！"
                },
                {
                    "id": "741930121",
                    "speaker": "派蒙",
                    "text": "所以我们去帮你找那个幽林枝，然后来换你的东西，你觉得好不好呀？"
                },
                {
                    "id": "741930122",
                    "speaker": "Player",
                    "text": "还可以给你找点吃的。"
                },
                {
                    "id": "741930123",
                    "speaker": "派蒙",
                    "text": "对哦，珀西芙一个人在外面应该很辛苦，我们可以帮她找吃的。"
                },
                {
                    "id": "741930124",
                    "speaker": "珀西芙",
                    "text": "吃的！汐藻！珀西芙！"
                },
                {
                    "id": "741930125",
                    "speaker": "Player",
                    "text": "你喜欢吃汐藻？"
                },
                {
                    "id": "741930126",
                    "speaker": "珀西芙",
                    "text": "汐藻！汐藻！汐藻汐藻汐藻！"
                },
                {
                    "id": "741930127",
                    "speaker": "派蒙",
                    "text": "一天吃五顿？还是一顿吃五个？呜哇…感觉比我还能吃！"
                },
                {
                    "id": "741930128",
                    "speaker": "派蒙",
                    "text": "那幽林枝呢？珀西芙，是不是去幽林雾道就可以找到啦？"
                },
                {
                    "id": "741930129",
                    "speaker": "珀西芙",
                    "text": "美露莘…"
                },
                {
                    "id": "741930130",
                    "speaker": "珀西芙",
                    "text": "幽林枝…十分很丢！十分很多地方！十分伊黎耶！"
                },
                {
                    "id": "741930131",
                    "speaker": "Player",
                    "text": "幽林枝在整个伊黎耶？"
                },
                {
                    "id": "741930132",
                    "speaker": "珀西芙",
                    "text": "#聪明{NICKNAME}！珀西芙！"
                },
                {
                    "id": "741930133",
                    "speaker": "珀西芙",
                    "text": "雾道，有花花，幽林枝，也花花！"
                },
                {
                    "id": "741930134",
                    "speaker": "珀西芙",
                    "text": "幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…数量！"
                },
                {
                    "id": "741930135",
                    "speaker": "派蒙",
                    "text": "啊…这次我一下就听懂了！幽林枝在的地方，长着和幽林雾道一样的花，一共有六个地方，是这样吧？"
                },
                {
                    "id": "741930136",
                    "speaker": "珀西芙",
                    "text": "聪明派蒙！珀西芙！"
                },
                {
                    "id": "741930137",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这下我们就都清楚了。珀西芙，那你就先好好休息，这件事包在我们身上！"
                },
                {
                    "id": "741930138",
                    "speaker": "珀西芙",
                    "text": "#派蒙，{NICKNAME}，好东西！所以，慢慢…慢慢！珀西芙！"
                }
            ]
        },
