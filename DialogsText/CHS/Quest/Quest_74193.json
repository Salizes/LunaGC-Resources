                }
            ]
        },
        {
            "id": "7419305",
            "objective": "(test)告别对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741930501",
                    "speaker": "珀西芙",
                    "text": "…箱子…宝贝…美露莘…"
                },
                {
                    "id": "741930502",
                    "speaker": "派蒙",
                    "text": "哎呀！珀西芙，我们是不是把你的东西换完了？"
                },
                {
                    "id": "741930503",
                    "speaker": "珀西芙",
                    "text": "珀西芙…出门！珀西芙…找！"
                },
                {
                    "id": "741930504",
                    "speaker": "Player",
                    "text": "没有了也没关系的。"
                },
                {
                    "id": "741930505",
                    "speaker": "派蒙",
                    "text": "没错，我们可以直接把汐藻给你啦！"
                },
                {
                    "id": "741930506",
                    "speaker": "珀西芙",
                    "text": "美露莘！"
                },
                {
                    "id": "741930507",
                    "speaker": "珀西芙",
                    "text": "#派蒙，朋友…真心！{NICKNAME}，朋友…真心！所以…交换！"
                },
                {
                    "id": "741930508",
                    "speaker": "派蒙",
                    "text": "那…好吧，珀西芙，你要出门多久呢？我们还会再见吗？"
                },
                {
                    "id": "741930509",
                    "speaker": "珀西芙",
                    "text": "再…见？"
                },
                {
                    "id": "741930510",
                    "speaker": "派蒙",
                    "text": "再见就是希望再次见面的意思哦。"
                },
                {
                    "id": "741930511",
                    "speaker": "Player",
                    "text": "再见是用来道别的话。"
                },
                {
                    "id": "741930512",
                    "speaker": "派蒙",
                    "text": "没错没错！上次就说过了，我们要好好教你道别。所以珀西芙，你也来试试说一句吧？"
                },
                {
                    "id": "741930513",
                    "speaker": "珀西芙",
                    "text": "道…别？"
                },
                {
                    "id": "741930514",
                    "speaker": "派蒙",
                    "text": "唔…你是不是不懂什么是道别？"
                },
                {
                    "id": "741930515",
                    "speaker": "派蒙",
                    "text": "让我想想…那差不多也算是一种交换吧，用明天交换明天…"
                },
                {
                    "id": "741930516",
                    "speaker": "派蒙",
                    "text": "把你的明天给一点给我们，我们的也给一点给你，这样我们就能再见啦！怎么样？这样说你理解吗？"
                },
                {
                    "id": "741930517",
                    "speaker": "珀西芙",
                    "text": "明天…交换…明天…！珀西芙！"
                },
                {
                    "id": "741930518",
                    "speaker": "派蒙",
                    "text": "哇，看来你听懂了！那我们来道别吧，好好说再见就一定会再见！"
                },
                {
                    "id": "741930519",
                    "speaker": "派蒙",
                    "text": "再见啦！珀西芙！"
                },
                {
                    "id": "741930520",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "741930521",
                    "speaker": "珀西芙",
                    "text": "#再见！{NICKNAME}！再见！派蒙！"
                }
            ]
        }
    ]
