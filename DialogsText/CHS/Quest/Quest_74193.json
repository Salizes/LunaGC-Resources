        {
            "id": "7419303",
            "objective": "(test)与珀西芙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741930301",
                    "speaker": "派蒙",
                    "text": "珀西芙看起来很高兴呢，不知道这个有什么用…"
                },
                {
                    "id": "741930302",
                    "speaker": "珀西芙",
                    "text": "幽林枝，十分很有用！那位来客，十分很有用！"
                },
                {
                    "id": "741930303",
