    },
    "talks": [
        {
            "id": "7215001",
            "objective": "(test)和NPC对话，获取特殊容器$HIDDEN",
            "dialogues": [
                {
                    "id": "721500101",
                    "speaker": "小卷",
                    "text": "你好，年轻人。看样子你是从岛外来的吧？",
                    "choices": [
                        {
                            "id": "721500102",
                            "text": "是的。",
                            "response": [
                                {
                                    "id": "721500104",
                                    "speaker": "小卷",
                                    "text": "想必你是游历四方的旅人吧？那么…不知是否有兴趣稍事停留，顺便占卜一下前路呢？"
                                },
                                {
                                    "id": "721500105",
                                    "speaker": "派蒙",
                                    "text": "欸，占卜前路…？",
                                    "choices": [
                                        {
                                            "id": "721500106",
                                            "text": "占卜前路…？",
                                            "response": [
                                                {
                                                    "id": "721500108",
                                                    "speaker": "小卷",
                                                    "text": "哈哈，二位不必如此忧心忡忡。抱歉呀，是我唐突了…"
                                                },
                                                {
                                                    "id": "721500109",
                                                    "speaker": "小卷",
                                                    "text": "我的意思是，我们望泷村的海祇神龛十分灵验，所以才要邀请你们占卜一番。"
                                                },
                                                {
                                                    "id": "721500110",
                                                    "speaker": "小卷",
                                                    "text": "自然没有说二位前路险峻的意思。"
                                                },
                                                {
                                                    "id": "721500111",
                                                    "speaker": "小卷",
                                                    "text": "啊…当然了，你我各自前路将会如何，又怎能靠只言片语预料呢…呵呵。"
                                                },
                                                {
                                                    "id": "721500112",
                                                    "speaker": "派蒙",
                                                    "text": "原来只是要占卜呀…那我就放心啦！"
                                                },
                                                {
                                                    "id": "721500113",
                                                    "speaker": "Player",
                                                    "text": "需要收费吗？"
                                                },
                                                {
                                                    "id": "721500114",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，不需要的。我们不会就这种事情收取奉纳钱…"
                                                },
                                                {
                                                    "id": "721500115",
                                                    "speaker": "小卷",
                                                    "text": "维护神龛的人，若是为了「愿望」而向过路的旅人收费，是会招致大御神灵魂不安的。"
                                                },
                                                {
                                                    "id": "721500116",
                                                    "speaker": "小卷",
                                                    "text": "毕竟同样身为凡人，我们有何资格利用别人的「愿望」，为自己牟取利益呢？"
                                                },
                                                {
                                                    "id": "721500117",
                                                    "speaker": "派蒙",
                                                    "text": "唔…是这个道理呢。"
                                                },
                                                {
                                                    "id": "721500118",
                                                    "speaker": "小卷",
                                                    "text": "所以二位，是否有兴趣赏光占卜前路呢？"
                                                },
                                                {
                                                    "id": "721500119",
                                                    "speaker": "Player",
                                                    "text": "可以一试。"
                                                },
                                                {
                                                    "id": "721500120",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，多谢。"
                                                },
                                                {
                                                    "id": "721500121",
                                                    "speaker": "小卷",
                                                    "text": "这阵子到处都不太平，村里的年轻人大多还在外面忙活计。能看到有年轻人来，我这老婆子还是挺开心的。"
                                                },
                                                {
                                                    "id": "721500122",
                                                    "speaker": "小卷",
                                                    "text": "更难得的是，作为外国人，对于海祇岛的传统仍怀着尊敬之心，真是了不起，哈哈…"
                                                },
                                                {
                                                    "id": "721500123",
                                                    "speaker": "小卷",
                                                    "text": "好了，不唠叨了。说起占卜呀…"
                                                },
                                                {
                                                    "id": "721500124",
                                                    "speaker": "小卷",
                                                    "text": "在占卜之前，二位如果不介意的话，可否先帮我一个小忙？"
                                                },
                                                {
                                                    "id": "721500125",
                                                    "speaker": "派蒙",
                                                    "text": "什么嘛，还是要钱啦！"
                                                },
                                                {
                                                    "id": "721500126",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，不是要钱…且听我说。"
                                                },
                                                {
                                                    "id": "721500127",
                                                    "speaker": "小卷",
                                                    "text": "望泷村的神龛之所以灵验，乃是有赖于其中供养的「海渊灵草」。"
                                                },
                                                {
                                                    "id": "721500128",
                                                    "speaker": "小卷",
                                                    "text": "顾名思义，这种植物最初产于深深的海渊之下…也就是我们的祖先所发源之处。"
                                                },
                                                {
                                                    "id": "721500129",
                                                    "speaker": "小卷",
                                                    "text": "数千年前，我们村庄的先民将其遗株从深海带到陆地，加以仔细抚养。"
                                                },
                                                {
                                                    "id": "721500130",
                                                    "speaker": "小卷",
                                                    "text": "在一代代村人的照料下…不论是战乱或是天灾，抑或大御神殉难的悲怆…都未曾摧折这长寿的「灵草」。"
                                                },
                                                {
                                                    "id": "721500131",
                                                    "speaker": "小卷",
                                                    "text": "因为是生长在水底的植物，所以需要频繁供应水源才能成活；"
                                                },
                                                {
                                                    "id": "721500132",
                                                    "speaker": "小卷",
                                                    "text": "因为是曾生活在漆黑环境中的生物，所以永远会泛着磷色的微光…"
                                                },
                                                {
                                                    "id": "721500133",
                                                    "speaker": "小卷",
                                                    "text": "于是，我们通过光彩闪烁的规律来判断愿望是否可能得以实现，至于其中奥秘，就在于水源。"
                                                },
                                                {
                                                    "id": "721500134",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，年轻些的巫女总会质疑占卜仪式的可信性，觉得这样的民间仪式不够正式，是在散播迷信…之类的。"
                                                },
                                                {
                                                    "id": "721500135",
                                                    "speaker": "小卷",
                                                    "text": "她们更喜欢明确易懂的理论，不喜欢老一辈口口相传，慢慢衰变的传说。"
                                                },
                                                {
                                                    "id": "721500136",
                                                    "speaker": "小卷",
                                                    "text": "但是呢…老人的智慧，代代相传的智慧…"
                                                },
                                                {
                                                    "id": "721500137",
                                                    "speaker": "小卷",
                                                    "text": "或许一时间无法归纳成条目分明的理论，却总是或多或少蕴含着不容忽视的真理。"
                                                },
                                                {
                                                    "id": "721500138",
                                                    "speaker": "Player",
                                                    "text": "关于水源…"
                                                },
                                                {
                                                    "id": "721500139",
                                                    "speaker": "小卷",
                                                    "text": "水源…？哦！呵呵…抱歉，上了年纪，说话总是啰里啰嗦的…"
                                                },
                                                {
                                                    "id": "721500140",
                                                    "speaker": "小卷",
                                                    "text": "想要供养「灵草」，需要取自岛上神社奉纳池中的水才行。因为那里的水饱含着「愿望」。"
                                                },
                                                {
                                                    "id": "721500141",
                                                    "speaker": "派蒙",
                                                    "text": "「愿望」…水中也会含有那种东西吗？"
                                                },
                                                {
                                                    "id": "721500142",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，是啊。每一个人托付的「愿望」会沉积在奉纳池中，消融在水里。就像蜜糖。"
                                                },
                                                {
                                                    "id": "721500143",
                                                    "speaker": "小卷",
                                                    "text": "没人能亲眼看到它…却能通过水的浓淡与甜味感受到它。"
                                                },
                                                {
                                                    "id": "721500144",
                                                    "speaker": "小卷",
                                                    "text": "记忆也好，信仰也好…都是这样的道理。"
                                                },
                                                {
                                                    "id": "721500145",
                                                    "speaker": "小卷",
                                                    "text": "另外，要去取水的话，一定要小心…「愿望」的效力，离了奉纳池便很容易就会在空气中逸散…"
                                                },
                                                {
                                                    "id": "721500146",
                                                    "speaker": "小卷",
                                                    "text": "就像随着年月流逝而不断消散的梦。"
                                                },
                                                {
                                                    "id": "721500147",
                                                    "speaker": "小卷",
                                                    "text": "通过触感与分量感的变化，很容易感知这种「愿望」的衰减。"
                                                },
                                                {
                                                    "id": "721500148",
                                                    "speaker": "派蒙",
                                                    "text": "哇…"
                                                },
                                                {
                                                    "id": "721500149",
                                                    "speaker": "Player",
                                                    "text": "哦…"
                                                },
                                                {
                                                    "id": "721500150",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，抱歉抱歉，话题又跑了…"
                                                },
                                                {
                                                    "id": "721500151",
                                                    "speaker": "小卷",
                                                    "text": "总之，取到水之后，请不要耽搁太长时间，尽快回来。"
                                                },
                                                {
                                                    "id": "721500152",
                                                    "speaker": "小卷",
                                                    "text": "否则「愿望」的效力会逸散殆尽，「灵草」也难以汲取足够的养分了…"
                                                },
                                                {
                                                    "id": "721500153",
                                                    "speaker": "小卷",
                                                    "text": "在那之后，还请麻烦再提醒我一下…还有一个步骤滋养「灵草」，占卜才会灵验。"
                                                },
                                                {
                                                    "id": "721500154",
                                                    "speaker": "派蒙",
                                                    "text": "好麻烦！就没有巫女帮你吗？"
                                                },
                                                {
                                                    "id": "721500155",
                                                    "speaker": "小卷",
                                                    "text": "唉…现在的年轻巫女要么嫌麻烦，要么对这种古老的传统嗤之以鼻，很少有愿意帮忙的…"
                                                },
                                                {
                                                    "id": "721500156",
                                                    "speaker": "小卷",
                                                    "text": "看着「灵草」的光泽一日更比一日暗淡…老婆子我啊，比谁都要失落…"
                                                },
                                                {
                                                    "id": "721500157",
                                                    "speaker": "派蒙",
                                                    "text": "可还是感觉好麻烦…"
                                                },
                                                {
                                                    "id": "721500158",
                                                    "speaker": "Player",
                                                    "text": "有点理解巫女们的意见了…"
                                                },
                                                {
                                                    "id": "721500159",
                                                    "speaker": "小卷",
                                                    "text": "所以，不知两位有没有兴趣帮忙取些水回来？"
                                                },
                                                {
                                                    "id": "721500160",
                                                    "speaker": "Player",
                                                    "text": "我们会帮忙的。"
                                                },
                                                {
                                                    "id": "721500161",
                                                    "speaker": "小卷",
                                                    "text": "那么就拜托你们了，非常感谢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721500107",
                                            "text": "前方很危险吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721500103",
                            "text": "你好，老人家。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215002",
            "objective": "前往海祇岛的神社",
            "dialogues": [
                {
                    "id": "721500201",
                    "speaker": "小卷",
                    "text": "你们回来了。"
                },
                {
                    "id": "721500202",
                    "speaker": "Player",
                    "text": "你要的东西我们取回来了。"
                },
                {
                    "id": "721500203",
                    "speaker": "派蒙",
                    "text": "是奉纳池的净水，还新鲜哦！"
                },
                {
                    "id": "721500204",
                    "speaker": "小卷",
                    "text": "真是太感谢你们了，我这就把水给「灵草」续上。"
                },
                {
                    "id": "721500205",
                    "speaker": "小卷",
                    "text": "之前说到哪里了来着…对，还需要一个步骤，「灵草」才能更加焕发光泽。"
                },
                {
                    "id": "721500206",
                    "speaker": "小卷",
                    "text": "只有在与深海水元素富集的环境中，「灵草」的茎叶才能足够舒展，其光彩才更能展现「愿望」的颜色。"
                },
                {
                    "id": "721500207",
                    "speaker": "小卷",
                    "text": "简而言之…在北方的一处洞窟里，存在着与其生存环境的水质最为近似的水元素。"
                },
                {
                    "id": "721500208",
                    "speaker": "小卷",
                    "text": "而在洞内不同的区域，其浓度也有所不同…其中呢，浓度最为理想的水元素是最为晶莹透明的。"
                },
                {
                    "id": "721500209",
                    "speaker": "小卷",
                    "text": "但假如变得浑浊了…比如被其他生物搅扰了，也是会很难办的…"
                },
                {
                    "id": "721500210",
                    "speaker": "小卷",
                    "text": "唉，我老了，不太好解释其中道理。"
                },
                {
                    "id": "721500211",
                    "speaker": "小卷",
                    "text": "到时候你们亲眼看到就会明白了，呵呵。"
                },
                {
                    "id": "721500212",
                    "speaker": "小卷",
                    "text": "那处洞窟同我们望泷村先祖的秘密息息相关…只可惜由于近来的战争，已罕有年轻人去那边取水滋养「灵草」了。"
                },
                {
                    "id": "721500213",
                    "speaker": "小卷",
                    "text": "唉…说起年轻人们，希望他们都能安全归来吧…"
                },
                {
                    "id": "721500214",
                    "speaker": "小卷",
                    "text": "话说回来，年轻人。如果你们要去那里取水的话，请一定注意安全。"
                },
                {
                    "id": "721500215",
                    "speaker": "派蒙",
                    "text": "嗯，小卷婆婆请放心啦！",
                    "choices": [
                        {
                            "id": "721500216",
                            "text": "我们会注意的。",
                            "response": [
                                {
                                    "id": "721500218",
                                    "speaker": "小卷",
                                    "text": "那就好，那就好…十分感谢你们。"
                                }
                            ]
                        },
                        {
                            "id": "721500217",
                            "text": "请您放心吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215009",
            "objective": "(test)隐藏任务发瓶子$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7215003",
            "objective": "获取「饱含心愿的水」",
            "dialogues": [
                {
                    "id": "721500301",
                    "speaker": "小卷",
                    "text": "哦哦，是你们呀，快来休息一下吧。"
                },
                {
                    "id": "721500302",
                    "speaker": "派蒙",
                    "text": "小卷婆婆，我们把您说的水带回来啦！"
                },
                {
                    "id": "721500303",
                    "speaker": "Player",
                    "text": "这是您说的「最理想的水」吧。"
                },
                {
                    "id": "721500304",
                    "speaker": "小卷",
                    "text": "没错，这些就足够了。真是辛苦你们了…"
                },
                {
                    "id": "721500305",
                    "speaker": "小卷",
                    "text": "呵呵，精神了很多嘛…"
                },
                {
                    "id": "721500306",
                    "speaker": "小卷",
                    "text": "从「灵草」的光彩来看…来年一定是个和平富足的好年景。"
                },
                {
                    "id": "721500307",
                    "speaker": "派蒙",
                    "text": "欸…这是怎么看出来的呀？"
                },
                {
                    "id": "721500308",
                    "speaker": "小卷",
                    "text": "「灵草」的光彩在于水的润泽，与众人「愿望」的滋养。"
                },
                {
                    "id": "721500309",
                    "speaker": "小卷",
                    "text": "这灵光正是大家愿望的宣示。愿望美好，光彩也就更鲜活，未来也就更有希望。"
                },
                {
                    "id": "721500310",
                    "speaker": "小卷",
                    "text": "毕竟…大家的愿望总是向着更好的明天吧。"
                },
                {
                    "id": "721500311",
                    "speaker": "小卷",
                    "text": "只要大家都有着为改善当前的生活而做点什么的愿望…"
                },
                {
                    "id": "721500312",
                    "speaker": "小卷",
                    "text": "或许相比而言，战争造成的种种困窘就算不得什么了。"
                },
                {
                    "id": "721500313",
                    "speaker": "派蒙",
                    "text": "唔…所以这和它灵验与否有什么关系吗？"
                },
                {
                    "id": "721500314",
                    "speaker": "小卷",
                    "text": "当然…这就是我们老人的智慧。"
                },
                {
                    "id": "721500315",
                    "speaker": "小卷",
                    "text": "「愿望」驱使和鼓励人行动，而行动的成果反过来验证了人的「愿望」。"
                },
                {
                    "id": "721500316",
                    "speaker": "小卷",
                    "text": "只要我们又一次维护了生活的平和，只要从灰暗的日子里保护生活的希望…"
                },
                {
                    "id": "721500317",
                    "speaker": "小卷",
                    "text": "「灵草」的占卜就永远是灵验的。",
                    "choices": [
                        {
                            "id": "721500318",
                            "text": "像是在用敷衍解释迷信…",
                            "response": [
                                {
                                    "id": "721500320",
                                    "speaker": "小卷",
                                    "text": "呵呵，年轻人总会理解的…"
                                },
                                {
                                    "id": "721500321",
                                    "speaker": "小卷",
                                    "text": "顺便一提，水中「愿望」的效力应该还能坚持些时日，两位愿意的话，可以随时来找我占卜哟。"
                                }
                            ]
                        },
                        {
                            "id": "721500319",
                            "text": "但也不是没有道理…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215008",
            "objective": "及时返回村庄",
            "dialogues": []
        },
        {
            "id": "7215004",
            "objective": "与小卷对话",
            "dialogues": []
        },
        {
            "id": "7215005",
            "objective": "前往小卷所说的洞窟",
            "dialogues": [
                {
                    "id": "721500501",
                    "speaker": "小卷",
                    "text": "不知道今年的占卜结果如何…"
                }
            ]
        },
        {
            "id": "7215006",
            "objective": "获取「澄亮之水」",
            "dialogues": []
        },
        {
            "id": "7215007",
            "objective": "与小卷对话",
            "dialogues": []
        },
        {
            "id": "7215004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721500401",
                    "speaker": "小卷",
                    "text": "你好，年轻人。看样子你是从岛外来的吧？",
                    "choices": [
                        {
                            "id": "721500402",
                            "text": "是的。",
                            "response": [
                                {
                                    "id": "721500404",
                                    "speaker": "小卷",
                                    "text": "想必你是游历四方的旅人吧？那么…不知是否有兴趣稍事停留，顺便占卜一下前路呢？"
                                },
                                {
                                    "id": "721500405",
                                    "speaker": "派蒙",
                                    "text": "欸，占卜前路…？",
                                    "choices": [
                                        {
                                            "id": "721500406",
                                            "text": "占卜前路…？",
                                            "response": [
                                                {
                                                    "id": "721500408",
                                                    "speaker": "小卷",
                                                    "text": "哈哈，二位不必如此忧心忡忡。抱歉呀，是我唐突了…"
                                                },
                                                {
                                                    "id": "721500409",
                                                    "speaker": "小卷",
                                                    "text": "我的意思是，我们望泷村的海祇神龛十分灵验，所以才要邀请你们占卜一番。"
                                                },
                                                {
                                                    "id": "721500410",
                                                    "speaker": "小卷",
                                                    "text": "自然没有说二位前路险峻的意思。"
                                                },
                                                {
                                                    "id": "721500411",
                                                    "speaker": "小卷",
                                                    "text": "啊…当然了，你我各自前路将会如何，又怎能靠只言片语预料呢…呵呵。"
                                                },
                                                {
                                                    "id": "721500412",
                                                    "speaker": "派蒙",
                                                    "text": "原来只是要占卜呀…那我就放心啦！"
                                                },
                                                {
                                                    "id": "721500413",
                                                    "speaker": "Player",
                                                    "text": "需要收费吗？"
                                                },
                                                {
                                                    "id": "721500414",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，不需要的。我们不会就这种事情收取奉纳钱…"
                                                },
                                                {
                                                    "id": "721500415",
                                                    "speaker": "小卷",
                                                    "text": "维护神龛的人，若是为了「愿望」而向过路的旅人收费，是会招致大御神灵魂不安的。"
                                                },
                                                {
                                                    "id": "721500416",
                                                    "speaker": "小卷",
                                                    "text": "毕竟同样身为凡人，我们有何资格利用别人的「愿望」，为自己牟取利益呢？"
                                                },
                                                {
                                                    "id": "721500417",
                                                    "speaker": "派蒙",
                                                    "text": "唔…是这个道理呢。"
                                                },
                                                {
                                                    "id": "721500418",
                                                    "speaker": "小卷",
                                                    "text": "所以二位，是否有兴趣赏光占卜前路呢？"
                                                },
                                                {
                                                    "id": "721500419",
                                                    "speaker": "Player",
                                                    "text": "可以一试。"
                                                },
                                                {
                                                    "id": "721500420",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，多谢。"
                                                },
                                                {
                                                    "id": "721500421",
                                                    "speaker": "小卷",
                                                    "text": "这阵子到处都不太平，村里的年轻人大多还在外面忙活计。能看到有年轻人来，我这老婆子还是挺开心的。"
                                                },
                                                {
                                                    "id": "721500422",
                                                    "speaker": "小卷",
                                                    "text": "更难得的是，作为外国人，对于海祇岛的传统仍怀着尊敬之心，真是了不起，哈哈…"
                                                },
                                                {
                                                    "id": "721500423",
                                                    "speaker": "小卷",
                                                    "text": "好了，不唠叨了。说起占卜呀…"
                                                },
                                                {
                                                    "id": "721500424",
                                                    "speaker": "小卷",
                                                    "text": "在占卜之前，二位如果不介意的话，可否先帮我一个小忙？"
                                                },
                                                {
                                                    "id": "721500425",
                                                    "speaker": "派蒙",
                                                    "text": "什么嘛，还是要钱啦！"
                                                },
                                                {
                                                    "id": "721500426",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，不是要钱…且听我说。"
                                                },
                                                {
                                                    "id": "721500427",
                                                    "speaker": "小卷",
                                                    "text": "望泷村的神龛之所以灵验，乃是有赖于其中供养的「海渊灵草」。"
                                                },
                                                {
                                                    "id": "721500428",
                                                    "speaker": "小卷",
                                                    "text": "顾名思义，这种植物最初产于深深的海渊之下…也就是我们的祖先所发源之处。"
                                                },
                                                {
                                                    "id": "721500429",
                                                    "speaker": "小卷",
                                                    "text": "数千年前，我们村庄的先民将其遗株从深海带到陆地，加以仔细抚养。"
                                                },
                                                {
                                                    "id": "721500430",
                                                    "speaker": "小卷",
                                                    "text": "在一代代村人的照料下…不论是战乱或是天灾，抑或大御神殉难的悲怆…都未曾摧折这长寿的「灵草」。"
                                                },
                                                {
                                                    "id": "721500431",
                                                    "speaker": "小卷",
                                                    "text": "因为是生长在水底的植物，所以需要频繁供应水源才能成活；"
                                                },
                                                {
                                                    "id": "721500432",
                                                    "speaker": "小卷",
                                                    "text": "因为是曾生活在漆黑环境中的生物，所以永远会泛着磷色的微光…"
                                                },
                                                {
                                                    "id": "721500433",
                                                    "speaker": "小卷",
                                                    "text": "于是，我们通过光彩闪烁的规律来判断愿望是否可能得以实现，至于其中奥秘，就在于水源。"
                                                },
                                                {
                                                    "id": "721500434",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，年轻些的巫女总会质疑占卜仪式的可信性，觉得这样的民间仪式不够正式，是在散播迷信…之类的。"
                                                },
                                                {
                                                    "id": "721500435",
                                                    "speaker": "小卷",
                                                    "text": "她们更喜欢明确易懂的理论，不喜欢老一辈口口相传，慢慢衰变的传说。"
                                                },
                                                {
                                                    "id": "721500436",
                                                    "speaker": "小卷",
                                                    "text": "但是呢…老人的智慧，代代相传的智慧…"
                                                },
                                                {
                                                    "id": "721500437",
                                                    "speaker": "小卷",
                                                    "text": "或许一时间无法归纳成条目分明的理论，却总是或多或少蕴含着不容忽视的真理。"
                                                },
                                                {
                                                    "id": "721500438",
                                                    "speaker": "Player",
                                                    "text": "关于水源…"
                                                },
                                                {
                                                    "id": "721500439",
                                                    "speaker": "小卷",
                                                    "text": "水源…？哦！呵呵…抱歉，上了年纪，说话总是啰里啰嗦的…"
                                                },
                                                {
                                                    "id": "721500440",
                                                    "speaker": "小卷",
                                                    "text": "想要供养「灵草」，需要取自岛上神社奉纳池中的水才行。因为那里的水饱含着「愿望」。"
                                                },
                                                {
                                                    "id": "721500441",
                                                    "speaker": "派蒙",
                                                    "text": "「愿望」…水中也会含有那种东西吗？"
                                                },
                                                {
                                                    "id": "721500442",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，是啊。每一个人托付的「愿望」会沉积在奉纳池中，消融在水里。就像蜜糖。"
                                                },
                                                {
                                                    "id": "721500443",
                                                    "speaker": "小卷",
                                                    "text": "没人能亲眼看到它…却能通过水的浓淡与甜味感受到它。"
                                                },
                                                {
                                                    "id": "721500444",
                                                    "speaker": "小卷",
                                                    "text": "记忆也好，信仰也好…都是这样的道理。"
                                                },
                                                {
                                                    "id": "721500445",
                                                    "speaker": "小卷",
                                                    "text": "另外，要去取水的话，一定要小心…「愿望」的效力，离了奉纳池便很容易就会在空气中逸散…"
                                                },
                                                {
                                                    "id": "721500446",
                                                    "speaker": "小卷",
                                                    "text": "就像随着年月流逝而不断消散的梦。"
                                                },
                                                {
                                                    "id": "721500447",
                                                    "speaker": "小卷",
                                                    "text": "通过触感与分量感的变化，很容易感知这种「愿望」的衰减。"
                                                },
                                                {
                                                    "id": "721500448",
                                                    "speaker": "派蒙",
                                                    "text": "哇…"
                                                },
                                                {
                                                    "id": "721500449",
                                                    "speaker": "Player",
                                                    "text": "哦…"
                                                },
                                                {
                                                    "id": "721500450",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，抱歉抱歉，话题又跑了…"
                                                },
                                                {
                                                    "id": "721500451",
                                                    "speaker": "小卷",
                                                    "text": "总之，取到水之后，请不要耽搁太长时间，尽快回来。"
                                                },
                                                {
                                                    "id": "721500452",
                                                    "speaker": "小卷",
                                                    "text": "否则「愿望」的效力会逸散殆尽，「灵草」也难以汲取足够的养分了…"
                                                },
                                                {
                                                    "id": "721500453",
                                                    "speaker": "小卷",
                                                    "text": "在那之后，还请麻烦再提醒我一下…还有一个步骤滋养「灵草」，占卜才会灵验。"
                                                },
                                                {
                                                    "id": "721500454",
                                                    "speaker": "派蒙",
                                                    "text": "好麻烦！就没有巫女帮你吗？"
                                                },
                                                {
                                                    "id": "721500455",
                                                    "speaker": "小卷",
                                                    "text": "唉…现在的年轻巫女要么嫌麻烦，要么对这种古老的传统嗤之以鼻，很少有愿意帮忙的…"
                                                },
                                                {
                                                    "id": "721500456",
                                                    "speaker": "Player",
                                                    "text": "您说的是露子吗？"
                                                },
                                                {
                                                    "id": "721500457",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，珊瑚宫边的那个巫女小姐，总是一副看不起老人家的样子！"
                                                },
                                                {
                                                    "id": "721500458",
                                                    "speaker": "小卷",
                                                    "text": "哦哦，你们见过她呀？"
                                                },
                                                {
                                                    "id": "721500459",
                                                    "speaker": "小卷",
                                                    "text": "呵呵，她呀…挺能干的，不过就是呀…"
                                                },
                                                {
                                                    "id": "721500460",
                                                    "speaker": "小卷",
                                                    "text": "呵呵…不多说了，年轻人嘛，总有一天能学会尊重故事传说的意义。"
                                                },
                                                {
                                                    "id": "721500461",
                                                    "speaker": "派蒙",
                                                    "text": "唔…什么呀…听不明白。"
                                                },
                                                {
                                                    "id": "721500462",
                                                    "speaker": "小卷",
                                                    "text": "看着「灵草」的光泽一日更比一日暗淡…老婆子我啊，比谁都要失落…"
                                                },
                                                {
                                                    "id": "721500463",
                                                    "speaker": "派蒙",
                                                    "text": "可还是感觉好麻烦…"
                                                },
                                                {
                                                    "id": "721500464",
                                                    "speaker": "Player",
                                                    "text": "有点理解巫女们的意见了…"
                                                },
                                                {
                                                    "id": "721500465",
                                                    "speaker": "小卷",
                                                    "text": "所以，不知两位有没有兴趣帮忙取些水回来？"
                                                },
                                                {
                                                    "id": "721500466",
                                                    "speaker": "Player",
                                                    "text": "我们会帮忙的。"
                                                },
                                                {
                                                    "id": "721500467",
                                                    "speaker": "小卷",
                                                    "text": "那么就拜托你们了，非常感谢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721500407",
                                            "text": "前方很危险吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721500403",
                            "text": "你好，老人家。"
                        }
                    ]
                }
            ]
        }
    ]
}