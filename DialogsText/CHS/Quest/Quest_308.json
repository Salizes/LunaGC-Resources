        {
            "id": "30801",
            "objective": "与丽莎对话",
            "dialogues": [
                {
                    "id": "3081101",
                    "speaker": "丽莎",
                    "text": "呀，小可爱。"
                },
                {
                    "id": "3081102",
                    "speaker": "丽莎",
                    "text": "这么危险的事你也来帮忙，真令人感动。"
                },
                {
                    "id": "3081103",
                    "speaker": "丽莎",
                    "text": "这段时间里有什么不明白的，都可以来问姐姐喔。",
                    "choices": [
                        {
                            "id": "3081104",
                            "text": "图书管理员主要负责做什么？",
                            "response": [
                                {
                                    "id": "3081105",
                                    "speaker": "丽莎",
                                    "text": "嗯，这个问题问得不错。"
                                },
                                {
                                    "id": "3081106",
                                    "speaker": "丽莎",
                                    "text": "基本上，就是体力活和脑力活之外的事吧。"
                                },
                                {
                                    "id": "3081107",
                                    "speaker": "派蒙",
                                    "text": "那究竟是还剩哪一种事啊！"
                                },
                                {
                                    "id": "3081111",
                                    "speaker": "丽莎",
                                    "text": "所以，你们也可以多信任我一些喔。"
                                }
                            ]
                        },
                        {
                            "id": "3081108",
                            "text": "为什么图书管理员会来遗迹…",
                            "response": [
                                {
                                    "id": "3081109",
                                    "speaker": "丽莎",
                                    "text": "嗯，这个问题问得不错。"
                                },
                                {
                                    "id": "3081110",
                                    "speaker": "丽莎",
                                    "text": "答案嘛，当然是因为琴信任我啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
