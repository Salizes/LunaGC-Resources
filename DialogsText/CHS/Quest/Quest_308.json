            "dialogues": []
        },
        {
            "id": "30803",
            "objective": "探索庙宇深处",
            "dialogues": []
        },
        {
            "id": "30814",
            "objective": "(test)与丽莎对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3081401",
                    "speaker": "丽莎",
                    "text": "东风之龙，南风之狮，北风之狼，西风之鹰…"
                },
                {
                    "id": "3081402",
                    "speaker": "丽莎",
                    "text": "它们是蒙德四方之风的守护者，也是风神「巴巴托斯」的眷属。"
                },
                {
                    "id": "3081403",
                    "speaker": "丽莎",
                    "text": "特瓦林——这就是风魔龙的名字。"
                },
                {
                    "id": "3081404",
                    "speaker": "丽莎",
                    "text": "在被人们称作魔龙以前，它曾是「四风守护」中的「东风之龙」。"
                },
                {
                    "id": "3081405",
                    "speaker": "丽莎",
                    "text": "这就是，四方之风的力量中，特瓦林只能借用三方的原因了。"
                },
                {
                    "id": "3081406",
                    "speaker": "丽莎",
                    "text": "从一开始，它就已经在燃尽「自己」了呀。",
                    "choices": [
                        {
                            "id": "3081407",
                            "text": "它为什么要这样做？",
                            "response": [
                                {
                                    "id": "3081409",
                                    "speaker": "丽莎",
                                    "text": "我想…是因为「恨」吧。"
                                },
                                {
                                    "id": "3081410",
                                    "speaker": "派蒙",
                                    "text": "恨…？"
                                },
                                {
                                    "id": "3081411",
                                    "speaker": "丽莎",
                                    "text": "是对蒙德的憎恨啊。"
                                },
                                {
                                    "id": "3081412",
                                    "speaker": "丽莎",
                                    "text": "以恨意为驱动、将恨意作为比风更强的力量，化作魔龙…"
                                },
                                {
                                    "id": "3081413",
                                    "speaker": "派蒙",
                                    "text": "可是，「四风守护」之一，为什么反而会…"
                                },
                                {
                                    "id": "3081414",
                                    "speaker": "派蒙",
                                    "text": "憎恨它本该守护的那座城市呢？"
                                },
                                {
                                    "id": "3081415",
                                    "speaker": "丽莎",
                                    "text": "……"
                                },
                                {
                                    "id": "3081416",
                                    "speaker": "丽莎",
                                    "text": "身为蒙德人，真难自己说出口呀。"
                                },
                                {
                                    "id": "3081417",
                                    "speaker": "丽莎",
                                    "text": "拿去看吧…这是百年前发生的故事了。"
                                }
                            ]
                        },
                        {
                            "id": "3081408",
                            "text": "它为什么要做到这种地步？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30804",
            "objective": "退出秘境",
            "dialogues": []
        },
        {
            "id": "30813",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3081301",
                    "speaker": "丽莎",
                    "text": "只是在门外，就能感受到元素力乱流所带来的烦躁感…"
                },
                {
                    "id": "3081302",
                    "speaker": "丽莎",
                    "text": "抓紧夺回这座庙宇，好让身体舒畅一下吧。"
                }
            ]
        }
    ]
