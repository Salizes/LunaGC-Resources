    "talks": [
        {
            "id": "4016602",
            "objective": "前往奥摩斯港",
            "dialogues": [
                {
                    "id": "401660201",
                    "speaker": "派蒙",
                    "text": "咦？那边不是提纳里和柯莱吗？还有迪希雅和坎蒂丝！"
                },
                {
                    "id": "401660202",
                    "speaker": "派蒙",
                    "text": "我们过去和他们打个招呼吧！"
                },
                {
                    "id": "401660203",
                    "speaker": "提纳里",
                    "text": "…分工都清楚了吧？接下来就是分头行动了。"
                },
                {
                    "id": "401660204",
                    "speaker": "提纳里",
                    "text": "另外我还是再提醒一次，大家多留个心眼，千万别被她发现了。"
                },
                {
                    "id": "401660205",
                    "speaker": "迪希雅",
                    "text": "哎呀这你就放心吧，对我们佣兵来说，秘密可是比生命还重要的东西！"
                },
                {
                    "id": "401660206",
                    "speaker": "坎蒂丝",
                    "text": "我认为，应该还不至于发生这类情况。"
                },
                {
                    "id": "401660207",
                    "speaker": "迪希雅",
                    "text": "打比方啦打比方，你懂我的意思。"
                },
                {
                    "id": "401660208",
                    "speaker": "柯莱",
                    "text": "唔…我还是有些担心。倒不是怕自己说漏嘴，是怕她如果冷不丁出现在身后，而我又没来得及发现…"
                },
                {
                    "id": "401660209",
                    "speaker": "派蒙",
                    "text": "大家好呀！你们在这里聊什么呢？"
                },
                {
                    "id": "401660210",
                    "speaker": "柯莱",
                    "text": "唔啊啊！我不是我不知道什么都没聊，我绝对没藏什么秘密！",
                    "choices": [
                        {
                            "id": "401660211",
                            "text": "绝对藏了什么秘密…",
                            "response": [
                                {
                                    "id": "401660213",
                                    "speaker": "提纳里",
                                    "text": "…冷静点，柯莱，至少也先看清是谁来了吧。"
                                },
                                {
                                    "id": "401660214",
                                    "speaker": "迪希雅",
                                    "text": "#{NICKNAME}和派蒙！没想到会在这里见到你们！"
                                },
                                {
                                    "id": "401660215",
                                    "speaker": "Player",
                                    "text": "我也很高兴见到大家。"
                                },
                                {
                                    "id": "401660216",
                                    "speaker": "柯莱",
                                    "text": "欸？是你们？啊…吓死我了，简直比上课开小差发现提纳里师父站在我身后还吓人…"
                                },
                                {
                                    "id": "401660217",
                                    "speaker": "坎蒂丝",
                                    "text": "二位是回须弥来参加花神诞祭的吗？"
                                },
                                {
                                    "id": "401660218",
                                    "speaker": "派蒙",
                                    "text": "嗯！一想到节日期间会很热闹，就回来找朋友们一起玩玩啦！"
                                },
                                {
                                    "id": "401660219",
                                    "speaker": "提纳里",
                                    "text": "的确，听老师说，教令院今年也做了许多筹备，打算给草神大人过一个空前盛大的生日。"
                                },
                                {
                                    "id": "401660220",
                                    "speaker": "提纳里",
                                    "text": "也算是对曾经教令院种种过错的一个微不足道的补偿吧。"
                                },
                                {
                                    "id": "401660221",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，那我们算来对了呢，这下好玩好吃的肯定少不了！"
                                },
                                {
                                    "id": "401660222",
                                    "speaker": "派蒙",
                                    "text": "不过话说回来，你们刚才在偷偷摸摸说什么呀？什么秘密不秘密的？"
                                },
                                {
                                    "id": "401660223",
                                    "speaker": "提纳里",
                                    "text": "来，你俩过来，我悄悄跟你们说。"
                                },
                                {
                                    "id": "401660224",
                                    "speaker": "提纳里",
                                    "text": "我们打算为草神大人准备一个惊喜。"
                                },
                                {
                                    "id": "401660225",
                                    "speaker": "派蒙",
                                    "text": "哇！生日惊喜！"
                                },
                                {
                                    "id": "401660226",
                                    "speaker": "坎蒂丝",
                                    "text": "这还是迪希雅提出来的呢。"
                                },
                                {
                                    "id": "401660227",
                                    "speaker": "迪希雅",
                                    "text": "欸？我也是和迪娜泽黛聊天时偶然想到的。每一届花神诞祭的活动都比较类似，总觉得该来些不一样的东西。"
                                },
                                {
                                    "id": "401660228",
                                    "speaker": "迪希雅",
                                    "text": "迪娜泽黛听完觉得这主意很棒，我就找上其他人，大家一拍即合，立刻组织起来了。"
                                },
                                {
                                    "id": "401660229",
                                    "speaker": "提纳里",
                                    "text": "既然是惊喜，知道的人自然越少越好。更何况对方是那位智慧之神，稍不注意，恐怕就会被她发现端倪。"
                                },
                                {
                                    "id": "401660230",
                                    "speaker": "派蒙",
                                    "text": "哦！有道理。所以我们要一直这么小声地说话吗？"
                                },
                                {
                                    "id": "401660231",
                                    "speaker": "柯莱",
                                    "text": "噗…"
                                },
                                {
                                    "id": "401660232",
                                    "speaker": "提纳里",
                                    "text": "咳咳！总之，我们只通知了近期恰有空闲的几位朋友来准备这事。"
                                },
                                {
                                    "id": "401660233",
                                    "speaker": "派蒙",
                                    "text": "具体要做些什么呀？"
                                },
                                {
                                    "id": "401660234",
                                    "speaker": "柯莱",
                                    "text": "听说草神大人喜欢糖果，我们打算从这里入手。"
                                },
                                {
                                    "id": "401660235",
                                    "speaker": "迪希雅",
                                    "text": "还准备在花车巡游之后请她吃顿生日晚宴呢！所以七鲜桌什么的肯定也少不了。"
                                },
                                {
                                    "id": "401660236",
                                    "speaker": "提纳里",
                                    "text": "具体的设计交给卡维了，现阶段我们只需要购置些食材和装饰就行。"
                                },
                                {
                                    "id": "401660237",
                                    "speaker": "Player",
                                    "text": "有什么我们能帮忙的吗？"
                                },
                                {
                                    "id": "401660238",
                                    "speaker": "派蒙",
                                    "text": "对呀对呀，听都听到了，我们也想为这份生日惊喜出一份力呢！"
                                },
                                {
                                    "id": "401660239",
                                    "speaker": "迪希雅",
                                    "text": "咦？我记得坎蒂丝你刚才说想要个人帮忙一起采购，这不正好吗？"
                                },
                                {
                                    "id": "401660240",
                                    "speaker": "坎蒂丝",
                                    "text": "嗯，我担心自己在沙漠待久了，对这边商品的价格和品相会有些生疏。"
                                },
                                {
                                    "id": "401660241",
                                    "speaker": "Player",
                                    "text": "我们可以和你一起。"
                                },
                                {
                                    "id": "401660242",
                                    "speaker": "坎蒂丝",
                                    "text": "若是不麻烦你们的话…"
                                },
                                {
                                    "id": "401660243",
                                    "speaker": "派蒙",
                                    "text": "不麻烦不麻烦！不如说恰好能帮上大家的忙，对我们来说才是惊喜呢。"
                                },
                                {
                                    "id": "401660244",
                                    "speaker": "迪希雅",
                                    "text": "哟，派蒙真是越来越会说话了。"
                                },
                                {
                                    "id": "401660245",
                                    "speaker": "坎蒂丝",
                                    "text": "那我就承蒙二位的好意了。"
                                },
                                {
                                    "id": "401660246",
                                    "speaker": "迪希雅",
                                    "text": "那就这么定了！装饰交给我和迪娜泽黛就行，宴会场地拜托提纳里操办。"
                                },
                                {
                                    "id": "401660247",
                                    "speaker": "派蒙",
                                    "text": "听得我都激动起来了，快开始吧！一起为纳西妲准备份了不得的生日惊…"
                                },
                                {
                                    "id": "401660248",
                                    "speaker": "众人",
                                    "text": "嘘…！"
                                },
                                {
                                    "id": "401660249",
                                    "speaker": "派蒙",
                                    "text": "哦…对，兴奋得差点忘了…保密要紧，保密要紧…"
                                }
                            ]
                        },
                        {
                            "id": "401660212",
                            "text": "老实交代吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016603",
            "objective": "与坎蒂丝一同采购商品",
            "dialogues": [
                {
                    "id": "401660301",
                    "speaker": "派蒙",
                    "text": "哇，今天的奥摩斯港闻上去香喷喷的，连海风的味道都要被压下去了呢！"
                },
                {
                    "id": "401660302",
                    "speaker": "坎蒂丝",
                    "text": "听说，这里是花车巡游的终点，很多商家提前布置摊位，自然会比平时更热闹些。"
                },
                {
                    "id": "401660303",
                    "speaker": "坎蒂丝",
                    "text": "阿如村最近也来了不少商人，大家都在准备过一个难忘的花神诞祭呢。"
                },
                {
                    "id": "401660304",
                    "speaker": "派蒙",
                    "text": "嘿嘿，看来不愁买不到东西了！砍价这事就交给我们吧！"
                },
                {
                    "id": "401660305",
                    "speaker": "坎蒂丝",
                    "text": "好，那就…唔…！呃…",
                    "choices": [
                        {
                            "id": "401660306",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "401660308",
                                    "speaker": "坎蒂丝",
                                    "text": "我没事…"
                                },
                                {
                                    "id": "401660309",
                                    "speaker": "坎蒂丝",
                                    "text": "……"
                                },
                                {
                                    "id": "401660310",
                                    "speaker": "坎蒂丝",
                                    "text": "抱歉，让你们担心了。我们先去那家店订些东西吧。"
                                },
                                {
                                    "id": "401660311",
                                    "speaker": "贾汉吉尔",
                                    "text": "哟，欢迎光临，客人想吃些什么？"
                                },
                                {
                                    "id": "401660312",
                                    "speaker": "坎蒂丝",
                                    "text": "想订一些花神诞祭当日的小吃，大概在花车巡游结束后来取，到时候能帮我提前做好吗？"
                                },
                                {
                                    "id": "401660313",
                                    "speaker": "贾汉吉尔",
                                    "text": "外带的预定单是吧？没问题，您到时候要吃些什么？"
                                },
                                {
                                    "id": "401660314",
                                    "speaker": "坎蒂丝",
                                    "text": "马萨拉芝士球和土豆船各三份，绿汁脆球十人份，咖喱虾也要三份。"
                                },
                                {
                                    "id": "401660315",
                                    "speaker": "贾汉吉尔",
                                    "text": "稍等我记一下…土豆船…绿汁脆球…嗯，没问题，这些食材都管够，客人还真是大手笔。"
                                },
                                {
                                    "id": "401660316",
                                    "speaker": "坎蒂丝",
                                    "text": "买这么多的话，请问能便宜一些吗？"
                                },
                                {
                                    "id": "401660317",
                                    "speaker": "贾汉吉尔",
                                    "text": "当然可以！我算算啊…一共两万九千摩拉，打个折算您两万六怎么样？"
                                },
                                {
                                    "id": "401660318",
                                    "speaker": "坎蒂丝",
                                    "text": "两万摩拉可以吗？"
                                },
                                {
                                    "id": "401660319",
                                    "speaker": "派蒙",
                                    "text": "欸…？"
                                },
                                {
                                    "id": "401660320",
                                    "speaker": "Player",
                                    "text": "（坎蒂丝…砍价好凶…）"
                                },
                                {
                                    "id": "401660321",
                                    "speaker": "贾汉吉尔",
                                    "text": "呃…这，这多少有点为难我了。花车巡游当天我这儿的客人也不少，食材也得专门为您留一留…"
                                },
                                {
                                    "id": "401660322",
                                    "speaker": "坎蒂丝",
                                    "text": "这样吗…那我再加五份萨巴桑炸角怎么样？能再便宜一些吗？"
                                },
                                {
                                    "id": "401660323",
                                    "speaker": "贾汉吉尔",
                                    "text": "啊，这样的话…我最多给客人您打到八折…"
                                },
                                {
                                    "id": "401660324",
                                    "speaker": "坎蒂丝",
                                    "text": "好吧，那就八折，辛苦您了。"
                                },
                                {
                                    "id": "401660325",
                                    "speaker": "贾汉吉尔",
                                    "text": "应该的应该的。"
                                },
                                {
                                    "id": "401660326",
                                    "speaker": "派蒙",
                                    "text": "总感觉坎蒂丝比我们还会砍价呢…"
                                },
                                {
                                    "id": "401660327",
                                    "speaker": "坎蒂丝",
                                    "text": "另外…"
                                },
                                {
                                    "id": "401660328",
                                    "speaker": "贾汉吉尔",
                                    "text": "客人还有什么想要的？"
                                },
                                {
                                    "id": "401660329",
                                    "speaker": "坎蒂丝",
                                    "text": "没有了。只是想提醒您检查一下炉火，用得久了，可能会存有安全隐患。"
                                },
                                {
                                    "id": "401660330",
                                    "speaker": "贾汉吉尔",
                                    "text": "哦，谢谢客人关心。不过这是我今天刚换的一批炭料，绝对不会…"
                                },
                                {
                                    "id": "401660331",
                                    "speaker": "巨大的声响",
                                    "text": "（嘭——！）"
                                },
                                {
                                    "id": "401660332",
                                    "speaker": "派蒙",
                                    "text": "呜啊！咳咳…好大的烟！"
                                },
                                {
                                    "id": "401660333",
                                    "speaker": "贾汉吉尔",
                                    "text": "唔咳咳…"
                                },
                                {
                                    "id": "401660334",
                                    "speaker": "坎蒂丝",
                                    "text": "您没事吧？"
                                },
                                {
                                    "id": "401660335",
                                    "speaker": "贾汉吉尔",
                                    "text": "没事…没事…谢谢您。咦？真是奇怪…"
                                },
                                {
                                    "id": "401660336",
                                    "speaker": "坎蒂丝",
                                    "text": "是不是鼓风装置出了故障？"
                                },
                                {
                                    "id": "401660337",
                                    "speaker": "贾汉吉尔",
                                    "text": "咳咳…的确有可能，前阵子也出过类似的事，我才换的鼓风…"
                                },
                                {
                                    "id": "401660338",
                                    "speaker": "坎蒂丝",
                                    "text": "炉子的问题可以晚些再排查，您人没事才是最重要的。要喝些水吗？我身上有带。"
                                },
                                {
                                    "id": "401660339",
                                    "speaker": "贾汉吉尔",
                                    "text": "不要紧不要紧，也是客人您眼睛好，要是您今天早些到我店里提醒我，说不定就不会这样了。"
                                },
                                {
                                    "id": "401660340",
                                    "speaker": "贾汉吉尔",
                                    "text": "总之，我今天就赶紧修修这炉子，不会耽搁您花神诞祭当天的订单。"
                                },
                                {
                                    "id": "401660341",
                                    "speaker": "坎蒂丝",
                                    "text": "还是身体和安全要紧，您慢慢来。订金我就放这儿了。"
                                },
                                {
                                    "id": "401660342",
                                    "speaker": "贾汉吉尔",
                                    "text": "好，客人您慢走。"
                                },
                                {
                                    "id": "401660343",
                                    "speaker": "派蒙",
                                    "text": "刚才真是危险呢！还好坎蒂丝你反应快。"
                                },
                                {
                                    "id": "401660344",
                                    "speaker": "Player",
                                    "text": "你怎么知道炉火有问题？"
                                },
                                {
                                    "id": "401660345",
                                    "speaker": "坎蒂丝",
                                    "text": "唔…或许是冥冥之中的感觉吧？我说不清…"
                                },
                                {
                                    "id": "401660346",
                                    "speaker": "派蒙",
                                    "text": "呼…接下来去哪里？希望是个没有炉子的地方，我真被吓得不轻。"
                                },
                                {
                                    "id": "401660347",
                                    "speaker": "坎蒂丝",
                                    "text": "去买些水果吧，在制作糖果时会用到。"
                                },
                                {
                                    "id": "401660348",
                                    "speaker": "派蒙",
                                    "text": "好！我们也好久没逛奥摩斯港了呢，顺带买点其他东西吧！"
                                }
                            ]
                        },
                        {
                            "id": "401660307",
                            "text": "身体不舒服吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016604",
            "objective": "继续购物",
            "dialogues": [
                {
                    "id": "401660401",
                    "speaker": "派蒙",
                    "text": "我记得水果摊就在那边…"
                },
                {
                    "id": "401660402",
                    "speaker": "坎蒂丝",
                    "text": "呃…！"
                },
                {
                    "id": "401660403",
                    "speaker": "派蒙",
                    "text": "咦？坎蒂丝你没事吧…？"
                },
                {
                    "id": "401660404",
                    "speaker": "坎蒂丝",
                    "text": "…！危险！"
                },
                {
                    "id": "401660405",
                    "speaker": "哈蒂丝",
                    "text": "…欸？"
                },
                {
                    "id": "401660406",
                    "speaker": "Black Screen",
                    "text": "坎蒂丝飞身一跃，救下了差点被箱子砸到的孩子…"
                },
                {
                    "id": "401660407",
                    "speaker": "坎蒂丝",
                    "text": "没受伤吧孩子？"
                },
                {
                    "id": "401660408",
                    "speaker": "哈蒂丝",
                    "text": "没…没事…谢谢大姐姐…"
                },
                {
                    "id": "401660409",
                    "speaker": "夏姆",
                    "text": "发生什么了？"
                },
                {
                    "id": "401660410",
                    "speaker": "派蒙",
                    "text": "那边的箱子突然倒了下来，还好坎蒂丝护住了这孩子。"
                },
                {
                    "id": "401660411",
                    "speaker": "夏姆",
                    "text": "你父母呢？"
                },
                {
                    "id": "401660412",
                    "speaker": "哈蒂丝",
                    "text": "我…他们在港口的酒馆，我一个人无聊，才…"
                },
                {
                    "id": "401660413",
                    "speaker": "坎蒂丝",
                    "text": "已经没事了，亲爱的孩子，下次玩耍时注意安全就好。"
                },
                {
                    "id": "401660414",
                    "speaker": "夏姆",
                    "text": "…快回去吧。"
                },
                {
                    "id": "401660415",
                    "speaker": "哈蒂丝",
                    "text": "好的…"
                },
                {
                    "id": "401660416",
                    "speaker": "夏姆",
                    "text": "这是谁家的箱子？"
                },
                {
                    "id": "401660417",
                    "speaker": "库特比",
                    "text": "是…是我的…"
                },
                {
                    "id": "401660418",
                    "speaker": "夏姆",
                    "text": "都说了不要在道路周围堆放重物！怎么还在犯这种错误？"
                },
                {
                    "id": "401660419",
                    "speaker": "库特比",
                    "text": "抱歉！最近…最近货物稍微多了些，仓库不够放…"
                },
                {
                    "id": "401660420",
                    "speaker": "夏姆",
                    "text": "嗯？！"
                },
                {
                    "id": "401660421",
                    "speaker": "库特比",
                    "text": "我这就处理！下次再也不放了！"
                },
                {
                    "id": "401660422",
                    "speaker": "夏姆",
                    "text": "哎…"
                },
                {
                    "id": "401660423",
                    "speaker": "夏姆",
                    "text": "谢谢你们，都怪我监督不周。要不是坎蒂丝小姐，还真不知道事情会变成什么样。"
                },
                {
                    "id": "401660424",
                    "speaker": "坎蒂丝",
                    "text": "举手之劳罢了，夏姆先生也不必过于自责，我很能理解守护一片区域的不易。只是节日在即，各处还需要您多多留神。"
                },
                {
                    "id": "401660425",
                    "speaker": "夏姆",
                    "text": "唉，这花神诞祭期间，还真是有几只眼睛都看不过来。哦，请别误会，坎蒂丝小姐的提醒我已经记下了，一定注意。"
                },
                {
                    "id": "401660426",
                    "speaker": "夏姆",
                    "text": "几位是来采购的吗？那我也不再叨扰了。祝你们节日愉快。"
                },
                {
                    "id": "401660427",
                    "speaker": "派蒙",
                    "text": "坎蒂丝你动作也太快了吧！总感觉那箱子还没掉下来的时候你就冲过去了呢！"
                },
                {
                    "id": "401660428",
                    "speaker": "Player",
                    "text": "简直像知道箱子会掉一样…"
                },
                {
                    "id": "401660429",
                    "speaker": "坎蒂丝",
                    "text": "……"
                },
                {
                    "id": "401660430",
                    "speaker": "坎蒂丝",
                    "text": "其实…我当时的确看到了那箱子掉下的「未来」。"
                },
                {
                    "id": "401660431",
                    "speaker": "派蒙",
                    "text": "欸？你的意思是，你预知了未来？！"
                },
                {
                    "id": "401660432",
                    "speaker": "坎蒂丝",
                    "text": "嗯…包括刚才炉火的意外也是，我看到了将要发生的事…",
                    "choices": [
                        {
                            "id": "401660433",
                            "text": "「预示之眼」…",
                            "response": [
                                {
                                    "id": "401660435",
                                    "speaker": "坎蒂丝",
                                    "text": "我不觉得我的琥珀色左眼有何特殊之处，以前，它从未让我看到过什么奇怪的异象…"
                                },
                                {
                                    "id": "401660436",
                                    "speaker": "坎蒂丝",
                                    "text": "但从今早开始，我时常看见某些画面，它们与现实不符，却在几秒后真真切切地发生了…"
                                },
                                {
                                    "id": "401660437",
                                    "speaker": "派蒙",
                                    "text": "你有告诉其他人吗？"
                                },
                                {
                                    "id": "401660438",
                                    "speaker": "坎蒂丝",
                                    "text": "还没有…我尚且无法确定这是否真是「预示」，也不想让大家担心。",
                                    "choices": [
                                        {
                                            "id": "401660439",
                                            "text": "为什么是今早开始？",
                                            "response": [
                                                {
                                                    "id": "401660441",
                                                    "speaker": "坎蒂丝",
                                                    "text": "回忆起来…并没有太过特殊的。我同往常一样安排好一日事务，向神明做完祷告，就来见朋友了。"
                                                },
                                                {
                                                    "id": "401660442",
                                                    "speaker": "坎蒂丝",
                                                    "text": "实在要挑出些不寻常的话，大概就是我在路上买了一块好看的宝石吧…"
                                                },
                                                {
                                                    "id": "401660443",
                                                    "speaker": "派蒙",
                                                    "text": "的确挺好看的！"
                                                },
                                                {
                                                    "id": "401660444",
                                                    "speaker": "Player",
                                                    "text": "但总感觉…"
                                                },
                                                {
                                                    "id": "401660445",
                                                    "speaker": "坎蒂丝",
                                                    "text": "你也察觉到了？这宝石中似乎蕴藏着些微特殊的元素痕迹，我也是对此感到好奇才买下的。"
                                                },
                                                {
                                                    "id": "401660446",
                                                    "speaker": "派蒙",
                                                    "text": "难道说这些「预示」，是宝石的作用？"
                                                },
                                                {
                                                    "id": "401660447",
                                                    "speaker": "坎蒂丝",
                                                    "text": "#有这种可能。来，{NICKNAME}，你拿这宝石试试，看看能不能感觉到什么…"
                                                },
                                                {
                                                    "id": "401660448",
                                                    "speaker": "Player",
                                                    "text": "（……）"
                                                },
                                                {
                                                    "id": "401660449",
                                                    "speaker": "Player",
                                                    "text": "好像没什么感觉。"
                                                },
                                                {
                                                    "id": "401660450",
                                                    "speaker": "坎蒂丝",
                                                    "text": "嗯…看来也不是对每个人都有效果。"
                                                },
                                                {
                                                    "id": "401660451",
                                                    "speaker": "坎蒂丝",
                                                    "text": "难道需要某种条件来触发吗…还是说，与我身为阿赫玛尔大人的子民有关…"
                                                },
                                                {
                                                    "id": "401660452",
                                                    "speaker": "派蒙",
                                                    "text": "要不要去找其他人问问？"
                                                },
                                                {
                                                    "id": "401660453",
                                                    "speaker": "坎蒂丝",
                                                    "text": "最近大家都忙于置办花神诞祭，不到万不得已，我可不能因为这种小事打扰朋友们。"
                                                },
                                                {
                                                    "id": "401660454",
                                                    "speaker": "坎蒂丝",
                                                    "text": "刚好这两天分配给我的任务不多，我自行调查就好。这也是一位「守护者」该做的。"
                                                },
                                                {
                                                    "id": "401660455",
                                                    "speaker": "Player",
                                                    "text": "我们也可以帮忙。"
                                                },
                                                {
                                                    "id": "401660456",
                                                    "speaker": "坎蒂丝",
                                                    "text": "那就再好不过了，有你在身边，总能让人感到安心，就像夜晚的篝火旁有人陪伴一样。"
                                                },
                                                {
                                                    "id": "401660457",
                                                    "speaker": "坎蒂丝",
                                                    "text": "先将采购的工作做完吧，再之后就去打听打听关于这块石头的情报。至少得从商人口中知道它的来源。"
                                                },
                                                {
                                                    "id": "401660458",
                                                    "speaker": "派蒙",
                                                    "text": "说到「商人」的话，我们不是正好认识一位消息灵通的大商人吗？虽然从她嘴里要情报，可能会花掉包里不少摩拉…"
                                                },
                                                {
                                                    "id": "401660459",
                                                    "speaker": "坎蒂丝",
                                                    "text": "是说那位「多莉」大商人吧？我在阿如村也早有耳闻。"
                                                },
                                                {
                                                    "id": "401660460",
                                                    "speaker": "派蒙",
                                                    "text": "没错，就是她！呃，不过多莉那家伙对摩拉可是很敏感的哦！坎蒂丝你和她谈价格时，最好下手轻点…"
                                                },
                                                {
                                                    "id": "401660461",
                                                    "speaker": "Black Screen",
                                                    "text": "与坎蒂丝一起购置了清单上的水果…"
                                                },
                                                {
                                                    "id": "401660462",
                                                    "speaker": "Black Screen",
                                                    "text": "同时还从商贩们那里打听到了多莉的下落…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401660440",
                                            "text": "今早发生了什么吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401660434",
                            "text": "真的应验了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4016605",
            "objective": "寻找多莉",
            "dialogues": [
                {
                    "id": "401660501",
                    "speaker": "多莉",
                    "text": "…来，你要的货，放心吧，都是好东西，嘿嘿嘿，要不要再顺手带一份桑歌玛哈巴依老爷我新进的好货呀？"
                },
                {
                    "id": "401660502",
                    "speaker": "多莉",
                    "text": "啊？不要吗？慢走不送。"
                },
                {
                    "id": "401660503",
                    "speaker": "派蒙",
                    "text": "多莉！"
                },
                {
                    "id": "401660504",
                    "speaker": "多莉",
                    "text": "哎呀呀！瞧瞧谁来啦！是我的两位大客户！还有…噢？你是阿如村的守护者坎蒂丝小姐…唔唔唔，有趣！"
                },
                {
                    "id": "401660505",
                    "speaker": "多莉",
                    "text": "有何贵干呀？我可没在沙漠进行任何不合时宜的买卖呢。"
                },
                {
                    "id": "401660506",
                    "speaker": "坎蒂丝",
                    "text": "您误会了，亲爱的多莉大商人。我们此行是想来向您打听一个消息。"
                },
                {
                    "id": "401660507",
                    "speaker": "多莉",
                    "text": "哦！是要买情报啊！欢迎欢迎！我最喜欢做情报生意了，带在身上不累，卖给别人翻倍！啊不…是…免税，免税。"
                },
                {
                    "id": "401660508",
                    "speaker": "坎蒂丝",
                    "text": "我今早购入了一块有些奇特的宝石，商人的名字我写在纸上了。"
                },
                {
                    "id": "401660509",
                    "speaker": "坎蒂丝",
                    "text": "我想向那位商人打听一下，制作这块宝石的工匠，是从哪里得到的原石。"
                },
                {
                    "id": "401660510",
                    "speaker": "多莉",
                    "text": "是找人的工作呀？这可有些麻烦呢，总觉得要花掉不少摩拉。"
                },
                {
                    "id": "401660511",
                    "speaker": "坎蒂丝",
                    "text": "当然，也可以省去找人的环节，如果万能的多莉大商人能够直接打听到来源的话，我也愿意支付这笔情报费。"
                },
                {
                    "id": "401660512",
                    "speaker": "多莉",
                    "text": "（找人倒是一点不麻烦，就是赚得少些…刚巧我有几个熟人平时也加工宝石，随口问他们一句应该就能搞定。）"
                },
                {
                    "id": "401660513",
                    "speaker": "多莉",
                    "text": "嗨呀，瞧您说的，可不就是为难桑歌玛哈巴依老爷我吗？这类消息源都是商业机密，打听起来费劲得很呢！"
                },
                {
                    "id": "401660514",
                    "speaker": "坎蒂丝",
                    "text": "请您开个价。"
                },
                {
                    "id": "401660515",
                    "speaker": "多莉",
                    "text": "哟！痛快！那等我算算啊，跑路的车马费，加上给别人送礼的费用…"
                },
                {
                    "id": "401660516",
                    "speaker": "多莉",
                    "text": "二十万摩拉，怎么样？"
                },
                {
                    "id": "401660517",
                    "speaker": "派蒙",
                    "text": "唔…好贵！"
                },
                {
                    "id": "401660518",
                    "speaker": "坎蒂丝",
                    "text": "实在不好意思，这价格稍微有些超出我们的预算了，能便宜一些吗？"
                },
                {
                    "id": "401660519",
                    "speaker": "多莉",
                    "text": "…好吧！阿如村是个有人情味的地方，这个面子我可以卖。你开个价。"
                },
                {
                    "id": "401660520",
                    "speaker": "坎蒂丝",
                    "text": "五万摩拉吧。"
                },
                {
                    "id": "401660521",
                    "speaker": "多莉",
                    "text": "什么？！"
                },
                {
                    "id": "401660522",
                    "speaker": "Player",
                    "text": "（这…比刚才砍的还狠…）"
                },
                {
                    "id": "401660523",
                    "speaker": "坎蒂丝",
                    "text": "怎么了？这类型的情报在沙漠一般就卖这个价。"
                },
                {
                    "id": "401660524",
                    "speaker": "多莉",
                    "text": "不卖不卖！这简直…简直亏得我身上的眼镜片都剩不下来啦！绝对不卖！"
                },
                {
                    "id": "401660525",
                    "speaker": "坎蒂丝",
                    "text": "这样吗…真是可惜。那三万摩拉怎么样？"
                },
                {
                    "id": "401660526",
                    "speaker": "多莉",
                    "text": "怎么还往下砍的呀！"
                },
                {
                    "id": "401660527",
                    "speaker": "坎蒂丝",
                    "text": "三万摩拉，外加您的商队到阿如村拜访时的食宿安全保障，还有一些杂税的减免，如何？"
                },
                {
                    "id": "401660528",
                    "speaker": "多莉",
                    "text": "什…！"
                },
                {
                    "id": "401660529",
                    "speaker": "多莉",
                    "text": "（等等…阿如村最近的确充满商机，如果借此得到守护者的庇护还能行些方便的话…倒是一笔不错的交易…）"
                },
                {
                    "id": "401660530",
                    "speaker": "多莉",
                    "text": "（嘁…坎蒂丝这家伙，该不会是想顺带为村里招揽些贸易吧…真是可怕的女人…）"
                },
                {
                    "id": "401660531",
                    "speaker": "多莉",
                    "text": "呃…嘿嘿…好吧！桑歌玛哈巴依老爷考虑了一下，这次的生意就不计成本了！三…啧…三万就三万！"
                },
                {
                    "id": "401660532",
                    "speaker": "坎蒂丝",
                    "text": "真的吗？不愧是须弥第一的大商人，您的眼界和气度非比常人。"
                },
                {
                    "id": "401660533",
                    "speaker": "多莉",
                    "text": "那…那是当然，谁叫客户是阿如村的守护者嘛，重在结交朋友，这买卖就是亏本我也得做！"
                },
                {
                    "id": "401660534",
                    "speaker": "坎蒂丝",
                    "text": "那不如…"
                },
                {
                    "id": "401660535",
                    "speaker": "多莉",
                    "text": "啊停停停！三万！说好三万了！"
                },
                {
                    "id": "401660536",
                    "speaker": "多莉",
                    "text": "（哎…到时候随便请那宝石商人吃点五百摩拉的路边摊吧…）"
                },
                {
                    "id": "401660537",
                    "speaker": "多莉",
                    "text": "收集情报也要些时间，你们…明天再来找我吧！跑这么一趟可不是什么轻松活。"
                },
                {
                    "id": "401660538",
                    "speaker": "坎蒂丝",
                    "text": "谢谢多莉大商人，真是帮大忙了。"
                },
                {
                    "id": "401660539",
                    "speaker": "坎蒂丝",
                    "text": "#{NICKNAME}，你们刚回须弥，接下来不妨就在奥摩斯港多逛逛吧，购置的物资交给我来安置就好。"
                },
                {
                    "id": "401660540",
                    "speaker": "派蒙",
                    "text": "真的吗？总觉得有些不好意思呢，我们也没帮上太多忙。"
                },
                {
                    "id": "401660541",
                    "speaker": "坎蒂丝",
                    "text": "请别这么说，倒是我还要麻烦你们随我一起调查，这才过意不去呢。"
                },
                {
                    "id": "401660542",
                    "speaker": "Player",
                    "text": "小事小事。"
                },
                {
                    "id": "401660543",
                    "speaker": "坎蒂丝",
                    "text": "#哈哈，你还是一如既往的崇高。愿神明保佑你，亲爱的{NICKNAME}。"
                },
                {
                    "id": "401660544",
                    "speaker": "坎蒂丝",
                    "text": "多莉大商人也是，愿您此行顺利。我们明日再见。"
                },
                {
                    "id": "401660545",
                    "speaker": "多莉",
                    "text": "哎…再见再见，慢走不送了啊…"
                }
            ]
        }
    ]
}