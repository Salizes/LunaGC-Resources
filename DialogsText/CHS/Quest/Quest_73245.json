            "dialogues": [
                {
                    "id": "732450501",
                    "speaker": "Player",
                    "text": "2个。"
                },
                {
                    "id": "732450502",
                    "speaker": "兰钵答",
                    "text": "金色的那菈，果然不会忘记！"
                },
                {
                    "id": "732450503",
                    "speaker": "兰钵答",
                    "text": "金色的那菈厉害，兰钵答有好东西送给厉害的那菈！"
                }
            ]
        },
        {
            "id": "7324501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732450101",
                    "speaker": "兰钵答",
                    "text": "是那菈！兰钵答想和那菈玩游戏，好那菈，要不要和兰钵答玩？"
                }
            ]
        },
        {
            "id": "7324504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732450401",
                    "speaker": "兰钵答",
                    "text": "那菈朋友，兰钵答所想的是<color=#00E1FFFF>木箱…但不是大的那种</color>！刚才的一小会儿，那菈所见的有几个呢？"
                }
            ]
        },
        {
            "id": "7324506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732450601",
                    "speaker": "Player",
                    "text": "3个。"
                },
                {
                    "id": "732450602",
                    "speaker": "兰钵答",
                    "text": "糊涂那菈，记得不对。"
                },
                {
