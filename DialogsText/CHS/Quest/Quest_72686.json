    "talks": [
        {
            "id": "7268601",
            "objective": "与安彦太郎对话",
            "dialogues": [
                {
                    "id": "726860101",
                    "speaker": "安彦太郎",
                    "text": "请问阁下的名字是？"
                },
                {
                    "id": "726860102",
                    "speaker": "Player",
                    "text": "#我是{NICKNAME}。"
                },
                {
                    "id": "726860103",
                    "speaker": "安彦太郎",
                    "text": "好，我记下了，请问阁下可有赌上武者荣誉的觉悟？",
                    "choices": [
                        {
                            "id": "726860104",
                            "text": "什么？好突然！",
                            "response": [
                                {
                                    "id": "726860106",
                                    "speaker": "安彦太郎",
                                    "text": "嗯？难道阁下不是慕名前来参与这场决斗的武者？"
                                },
                                {
                                    "id": "726860107",
                                    "speaker": "Player",
                                    "text": "完全没听说过这回事。"
                                },
                                {
                                    "id": "726860108",
                                    "speaker": "安彦太郎",
                                    "text": "阁下难道没有听说过「孤剑争逐」吗？"
                                },
                                {
                                    "id": "726860109",
                                    "speaker": "安彦太郎",
                                    "text": "这不应当，我明明已经张贴过公告了。"
                                },
                                {
                                    "id": "726860110",
                                    "speaker": "派蒙",
                                    "text": "你贴在哪里了呢？"
                                },
                                {
                                    "id": "726860111",
                                    "speaker": "安彦太郎",
                                    "text": "就在这里。"
                                },
                                {
                                    "id": "726860112",
                                    "speaker": "派蒙",
                                    "text": "贴在这里没有用啦，这样的宣传方式怎么会有人来！"
                                },
                                {
                                    "id": "726860113",
                                    "speaker": "安彦太郎",
                                    "text": "哼，还不是因为社奉行说「容彩祭不宜舞刀弄枪」，拒绝了我在离岛举办决斗，也禁止我张贴传单。"
                                },
                                {
                                    "id": "726860114",
                                    "speaker": "安彦太郎",
                                    "text": "因此，我只能把决斗场选在这里，把公告也贴在旁边。"
                                },
                                {
                                    "id": "726860115",
                                    "speaker": "安彦太郎",
                                    "text": "不过，实际上已经有四名武者前来参与比试了，如果连同阁下在内，那就有五人。"
                                },
                                {
                                    "id": "726860116",
                                    "speaker": "派蒙",
                                    "text": "#这样还能有人来参加，真是神奇。话说{NICKNAME}来这里是为了什么来着，完全没有印象了…"
                                },
                                {
                                    "id": "726860117",
                                    "speaker": "安彦太郎",
                                    "text": "我看阁下能在不知此事的前提下，来到这小岛上，一定是位有着强烈武道精神的勇者。"
                                },
                                {
                                    "id": "726860118",
                                    "speaker": "安彦太郎",
                                    "text": "痴迷于武道的人是会相互吸引的，这是常识，两位不必感到奇怪。"
                                },
                                {
                                    "id": "726860119",
                                    "speaker": "派蒙",
                                    "text": "这是哪个世界的常识啦。"
                                },
                                {
                                    "id": "726860120",
                                    "speaker": "安彦太郎",
                                    "text": "呵呵，如何？阁下是否愿意前来比试？"
                                },
                                {
                                    "id": "726860121",
                                    "speaker": "安彦太郎",
                                    "text": "如果阁下能一一胜过那四位参赛者，届时自有礼金奉上。"
                                },
                                {
                                    "id": "726860122",
                                    "speaker": "Player",
                                    "text": "让我考虑考虑。"
                                },
                                {
                                    "id": "726860123",
                                    "speaker": "安彦太郎",
                                    "text": "好，那么就请阁下好好考虑一番。"
                                }
                            ]
                        },
                        {
                            "id": "726860105",
                            "text": "没有没有，打扰了。"
                        }
                    ]
                }
            ]
        }
    ]
}