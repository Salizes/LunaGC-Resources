        {
            "id": "7603308",
            "objective": "与执着于食物的幽影对话",
            "dialogues": [
                {
                    "id": "760330401",
                    "speaker": "执着于食物的幽影",
                    "text": "鸡肉足够入味，配菜量也放得够多，你这样我很难挑毛病啊。"
                },
                {
                    "id": "760330402",
                    "speaker": "执着于食物的幽影",
                    "text": "算了，本来就不是为了难为人才盯着你们这些新人的。"
                },
                {
                    "id": "760330403",
                    "speaker": "执着于食物的幽影",
                    "text": "我只是个厨子，做好厨子该做的事就行。"
                },
                {
                    "id": "760330404",
                    "speaker": "执着于食物的幽影",
                    "text": "就算狂猎真的来了，我也做好了准备。"
                },
                {
                    "id": "760330405",
                    "speaker": "执着于食物的幽影",
                    "text": "只是可惜，来不及把做好的菜送给他们了…饭菜都洒了…洒了…"
                }
            ]
        },
        {
