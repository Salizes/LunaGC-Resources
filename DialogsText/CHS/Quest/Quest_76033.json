            "dialogues": []
        },
        {
            "id": "7603303",
            "objective": "用灯塔附近的奇特烹饪锅制作挪德卡莱热狗",
            "dialogues": [
                {
                    "id": "760330301",
                    "speaker": "执着于食物的幽影",
                    "text": "肉切得足够厚，厚切的同时煎得又很熟，不错。"
                },
                {
                    "id": "760330302",
                    "speaker": "执着于食物的幽影",
                    "text": "但是我要提醒你一点，做煎肉要注意配菜。"
                },
                {
                    "id": "760330303",
                    "speaker": "执着于食物的幽影",
                    "text": "本来肉吃多了就容易腻，所以才会放浆果。"
                },
                {
                    "id": "760330304",
                    "speaker": "执着于食物的幽影",
                    "text": "在岛上，我们负责管理所有人的饮食健康，一定要注意蔬菜和肉食的平衡搭配。"
                },
                {
                    "id": "760330305",
                    "speaker": "执着于食物的幽影",
                    "text": "这盘煎肉里的配菜放得太少了，这点很不好，不够周全。"
                },
                {
                    "id": "760330306",
                    "speaker": "执着于食物的幽影",
                    "text": "你还得练，下次再来做白灵果酿鸡试试吧。"
                }
            ]
        },
        {
            "id": "7603304",
            "objective": "与执着于食物的幽影对话",
            "dialogues": [
                {
                    "id": "760330201",
                    "speaker": "执着于食物的幽影",
                    "text": "嗯，热狗里的香肠烤得不错。"
                },
                {
                    "id": "760330202",
                    "speaker": "执着于食物的幽影",
                    "text": "如果你是在外面的餐厅工作，这个水平够你做帮厨了。"
                },
                {
                    "id": "760330203",
                    "speaker": "执着于食物的幽影",
                    "text": "但是！我们是要为岛上的所有执灯士供餐，重要的不是菜有多精致，重要的是够吃。"
                },
                {
                    "id": "760330204",
                    "speaker": "执着于食物的幽影",
                    "text": "面包做厚一点，现在的蔬菜种类太少，除了香肠之外，还可以放点别的肉类。"
                },
                {
                    "id": "760330205",
                    "speaker": "执着于食物的幽影",
                    "text": "你还得练，下次再来做浆果煎肉试试吧。"
                }
            ]
        },
        {
            "id": "7603309",
            "objective": "过一段时间再前来寻找幽影",
