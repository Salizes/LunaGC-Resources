    "talks": [
        {
            "id": "7603301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760330101",
                    "speaker": "执着于食物的幽影",
                    "text": "喂，新来的，菜不能这么做。"
                },
                {
                    "id": "760330102",
                    "speaker": "执着于食物的幽影",
                    "text": "我们做出来的食物要供给岛上执灯士，得以他们的口味为准。"
                },
                {
                    "id": "760330103",
                    "speaker": "执着于食物的幽影",
                    "text": "这些菜完全不行，一欠火候，二不符合我们的伙食标准，得改。"
                },
                {
                    "id": "760330104",
                    "speaker": "执着于食物的幽影",
                    "text": "你还得练，从我们挪德卡莱的本土菜做起吧，比如挪德卡莱热狗，做好了再拿给我看。"
                }
            ]
        },
        {
