    "talks": [
        {
            "id": "7511101",
            "objective": "(test)判定彩蛋的接取，加载group们$HIDDEN",
            "dialogues": [
                {
                    "id": "751110101",
                    "speaker": "Player",
                    "text": "我之前捡到了这个…"
                },
                {
                    "id": "751110102",
                    "speaker": "米齐卡",
                    "text": "啊？难道又是哪个笨蛋弄丢的，快给我看看。"
                }
            ]
        },
        {
            "id": "7511110",
            "objective": "",
            "dialogues": [
                {
                    "id": "751111401",
                    "speaker": "爱雅",
                    "text": "确实是我的快件。「回声之子」那边有个人想要买颜料，但无论如何都说不清自己要什么颜色。"
                },
                {
                    "id": "751111402",
                    "speaker": "爱雅",
                    "text": "所以我才寄了一份包着几支小份颜料的快件过去，让他下次带着更加清楚的颜色参考过来买颜料。"
                },
                {
                    "id": "751111403",
                    "speaker": "爱雅",
                    "text": "我得快点再寄一份过去，免得那家伙又带着莫名其妙的参考过来…"
                },
                {
                    "id": "751111404",
                    "speaker": "爱雅",
                    "text": "对了，这些报酬给你，谢谢你帮我把快件带回来。"
                }
            ]
        },
        {
            "id": "7511111",
            "objective": "",
            "dialogues": [
                {
                    "id": "751111501",
                    "speaker": "夏安卡",
                    "text": "咦？确实是我寄出去的订货单。没想到呀，它居然运气这么不好…"
                },
                {
                    "id": "751111502",
                    "speaker": "夏安卡",
                    "text": "稍后我再写一封订货单吧。这件事倒也不急。"
                },
                {
                    "id": "751111503",
                    "speaker": "夏安卡",
                    "text": "谢谢你帮我把信带回来。看你这一身汗，来，喝点东西吧。"
                }
            ]
        },
        {
            "id": "7511112",
            "objective": "",
            "dialogues": [
                {
                    "id": "751111601",
                    "speaker": "伊蜜",
                    "text": "呜哇！是我的，这份快件是我寄出去的！"
                },
                {
                    "id": "751111602",
                    "speaker": "伊蜜",
                    "text": "还好还好，我还以为我寄错地址了…要是那样的话，我就完蛋了…"
                },
                {
                    "id": "751111603",
                    "speaker": "伊蜜",
                    "text": "谢谢你，真的很谢谢你。这些报酬请收下吧。"
                },
                {
                    "id": "751111604",
                    "speaker": "伊蜜",
                    "text": "…还有，那个…请千万不要告诉夏温小姐！拜托了！"
                }
            ]
        },
        {
            "id": "7511113",
            "objective": "",
            "dialogues": [
                {
                    "id": "751111701",
                    "speaker": "蒂尔妲",
                    "text": "…嗯，这是我的信。谢谢你。"
                },
                {
                    "id": "751111702",
                    "speaker": "蒂尔妲",
                    "text": "稍后我会再写一封。托人带回「花羽会」的。"
                },
                {
                    "id": "751111703",
                    "speaker": "蒂尔妲",
                    "text": "…希望这封信，能够顺利寄到。"
                },
                {
                    "id": "751111704",
                    "speaker": "蒂尔妲",
                    "text": "这些报酬是给你的，请收下吧。"
                }
            ]
        },
        {
            "id": "7511102",
            "objective": "(test)等待交付完成-爱雅$HIDDEN",
            "dialogues": [
                {
                    "id": "751110201",
                    "speaker": "米齐卡",
                    "text": "这看起来…像是寄给爱雅的快件。"
                },
                {
                    "id": "751110202",
                    "speaker": "米齐卡",
                    "text": "…外包装都破了，再寄出去的话，说不定整个快件都会坏掉。"
                },
                {
                    "id": "751110203",
                    "speaker": "米齐卡",
                    "text": "我还要整理店里的快件，可以请你帮我把这份快件送给爱雅吗？"
                },
                {
                    "id": "751110204",
                    "speaker": "米齐卡",
                    "text": "她是圣火竞技场里「弗里达的色盘」的店主。她的店牌可显眼了。"
                }
            ]
        },
        {
            "id": "7511103",
            "objective": "(test)等待交付完成-夏安卡$HIDDEN",
            "dialogues": [
                {
                    "id": "751110301",
                    "speaker": "米齐卡",
                    "text": "这封信…像是夏安卡的笔迹。"
                },
                {
                    "id": "751110302",
                    "speaker": "米齐卡",
                    "text": "…肯定又是寄出去订货的货单。外面的包装已经破了，这封信可不能继续送，必须原件退回才行。"
                },
                {
                    "id": "751110303",
                    "speaker": "米齐卡",
                    "text": "我还要整理店里的快件，能请你帮我把这封信送回给夏安卡吗？"
                },
                {
                    "id": "751110304",
                    "speaker": "米齐卡",
                    "text": "她是圣火竞技场里「倦意之屋」的店主，她的商店很好找的。"
                }
            ]
        },
        {
            "id": "7511104",
            "objective": "(test)等待交付完成-伊蜜$HIDDEN",
            "dialogues": [
                {
                    "id": "751110401",
                    "speaker": "米齐卡",
                    "text": "「穆胡鲁宝石铺」…伊蜜？糟糕，不会是寄出去的货单吧。"
                },
                {
                    "id": "751110402",
                    "speaker": "米齐卡",
                    "text": "要是这份快件弄丢了，那孩子只怕要被夏温小姐念叨。"
                },
                {
                    "id": "751110403",
                    "speaker": "米齐卡",
                    "text": "我还要整理店里的快件，可以请你帮我把这份快件送回给伊蜜吗？"
                },
                {
                    "id": "751110404",
                    "speaker": "米齐卡",
                    "text": "她们的「穆胡鲁宝石铺」在「回声之子」那边，很容易就能找到。"
                }
            ]
        },
        {
            "id": "7511105",
            "objective": "(test)等待交付完成-蒂尔妲$HIDDEN",
            "dialogues": [
                {
                    "id": "751110501",
                    "speaker": "米齐卡",
                    "text": "…这封信，好像是蒂尔妲小姐寄出去的。"
                },
                {
                    "id": "751110502",
                    "speaker": "米齐卡",
                    "text": "她难道是想要寄回自己的部族吗？不过…这封信的外面已经破成这样，还是得送还回去啊。"
                },
                {
                    "id": "751110503",
                    "speaker": "米齐卡",
                    "text": "我还要整理店里的快件，可以请你帮我把这封信送回给蒂尔妲小姐吗？"
                },
                {
                    "id": "751110504",
                    "speaker": "米齐卡",
                    "text": "她在「黄金傍晚」里驻唱，很容易就能找到。"
                }
            ]
        },
        {
            "id": "7511107",
            "objective": "(test)对话挂载$HIDDEN",
            "dialogues": []
        },
        {
