    "talks": [
        {
            "id": "4134208",
            "objective": "(test)居民委托领取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "413420801",
                    "speaker": "王扳子",
                    "text": "(test)思妤啊 呜呜"
                },
                {
                    "id": "413420802",
                    "speaker": "王扳子",
                    "text": "(test)算了，别管我了，你走吧"
                },
                {
                    "id": "413420803",
                    "speaker": "王扳子",
                    "text": "(test)让我自己静静"
                }
            ]
        },
        {
            "id": "4134201",
            "objective": "与思妤对话",
            "dialogues": [
                {
                    "id": "413420101",
                    "speaker": "思妤",
                    "text": "果然，还是送盏霄灯过去吧…"
                },
                {
                    "id": "413420102",
                    "speaker": "Player",
                    "text": "送霄灯？"
                },
                {
                    "id": "413420103",
                    "speaker": "思妤",
                    "text": "是旅行者啊，是这样。从小扳子哥就一直很照顾我，平时也帮了我很多忙，他就和我亲哥哥一样。"
                },
                {
                    "id": "413420104",
                    "speaker": "思妤",
                    "text": "但是大过节的，他似乎还在工作个不停…"
                },
                {
                    "id": "413420105",
                    "speaker": "思妤",
                    "text": "我就想给他送一盏霄灯，嘿嘿，我们俩是从小玩到大的，小时候他最喜欢看霄灯了。"
                },
                {
                    "id": "413420106",
                    "speaker": "思妤",
                    "text": "现在送一盏霄灯过去，他肯定会高兴的。旅行者，能拜托你帮我把这盏霄灯送给他吗？",
                    "choices": [
                        {
                            "id": "413420107",
                            "text": "你自己不去送吗？",
                            "response": [
                                {
                                    "id": "413420109",
                                    "speaker": "思妤",
                                    "text": "我也想自己去送啦，但家里还有很多事要做…"
                                },
                                {
                                    "id": "413420110",
                                    "speaker": "思妤",
                                    "text": "我现在出来买东西，家里的事都是我老公一个人在忙，我得赶紧回去帮帮他才行。"
                                },
                                {
                                    "id": "413420111",
                                    "speaker": "思妤",
                                    "text": "所以霄灯的事就拜托你啦，等稍微有空了，我会和我老公一起去看扳子哥的。"
                                },
                                {
                                    "id": "413420112",
                                    "speaker": "思妤",
                                    "text": "希望那时候扳子哥也能稍微闲一些…"
                                }
                            ]
                        },
                        {
                            "id": "413420108",
                            "text": "你去送会好一点…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134204",
            "objective": "将霄灯交给王扳子",
            "dialogues": [
                {
                    "id": "413420401",
                    "speaker": "王扳子",
                    "text": "嗯？旅行者，你找我有事吗？我现在正忙着呢。"
                },
                {
                    "id": "413420402",
                    "speaker": "Player",
                    "text": "关于思妤送你的霄灯…"
                }
            ]
        },
        {
            "id": "4134205",
            "objective": "与王扳子对话",
            "dialogues": [
                {
                    "id": "413420501",
                    "speaker": "王扳子",
                    "text": "思妤？她…她送我的霄灯？我…我看看！"
                },
                {
                    "id": "413420502",
                    "speaker": "王扳子",
                    "text": "哈哈哈，这愿望是她帮我写的吧，我小时候确实最想实现这个愿望…"
                },
                {
                    "id": "413420503",
                    "speaker": "王扳子",
                    "text": "一转眼都过去了这么多年了，时间过得可真快啊…"
                },
                {
                    "id": "413420504",
                    "speaker": "王扳子",
                    "text": "不过，她怎么让你把这盏霄灯送来？",
                    "choices": [
                        {
                            "id": "413420505",
                            "text": "她家里还有事要忙…",
                            "response": [
                                {
                                    "id": "413420507",
                                    "speaker": "王扳子",
                                    "text": "是吗，是这样…也好，也好，很不错啊。"
                                },
                                {
                                    "id": "413420508",
                                    "speaker": "王扳子",
                                    "text": "思妤现在过得肯定很不错吧，这样就好了…哈哈…哈。"
                                },
                                {
                                    "id": "413420509",
                                    "speaker": "王扳子",
                                    "text": "这样挺好的…不好意思…我还有很多工作要做，先走了…"
                                }
                            ]
                        },
                        {
                            "id": "413420506",
                            "text": "她说要回家帮老公…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134206",
            "objective": "与李锤子对话",
            "dialogues": [
                {
                    "id": "413420602",
                    "speaker": "李锤子",
                    "text": "那个霄灯是思妤送给他的，对吧？",
                    "choices": [
                        {
                            "id": "413420603",
                            "text": "你刚才听见了？",
                            "response": [
                                {
                                    "id": "413420605",
                                    "speaker": "李锤子",
                                    "text": "他那么点事，我猜都不用猜。"
                                },
                                {
                                    "id": "413420606",
                                    "speaker": "李锤子",
                                    "text": "去年他也是这样，出去了一趟之后，回来一个人杵在船边上敲了一晚上的钉子。"
                                },
                                {
                                    "id": "413420607",
                                    "speaker": "李锤子",
                                    "text": "我知道他这么做的意思，但是，唉…"
                                },
                                {
                                    "id": "413420608",
                                    "speaker": "李锤子",
                                    "text": "旅行者，能不能请你去帮他一下？大过节的，这么折腾自己也不是个事…"
                                },
                                {
                                    "id": "413420609",
                                    "speaker": "Player",
                                    "text": "好的…"
                                },
                                {
                                    "id": "413420610",
                                    "speaker": "李锤子",
                                    "text": "唉…麻烦你了。"
                                },
                                {
                                    "id": "413420611",
                                    "speaker": "李锤子",
                                    "text": "估计他这会儿就去船上干活了…你赶紧去吧。"
                                },
                                {
                                    "id": "413420612",
                                    "speaker": "李锤子",
                                    "text": "我等会去置办点吃食，你们弄完了之后就过来吧，我们一起吃点。"
                                }
                            ]
                        },
                        {
                            "id": "413420604",
                            "text": "你怎么知道的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134210",
            "objective": "与王扳子对话",
            "dialogues": [
                {
                    "id": "413421001",
                    "speaker": "王扳子",
                    "text": "耽搁了这么久，落下了不少活，得加把劲干活才行。"
                },
                {
                    "id": "413421002",
                    "speaker": "Player",
                    "text": "你、你还好吧…"
                },
                {
                    "id": "413421003",
                    "speaker": "王扳子",
                    "text": "嗨！我能有啥事啊，没事没事。"
                },
                {
                    "id": "413421004",
                    "speaker": "王扳子",
                    "text": "我还得赶紧干完这些活儿，干完了之后…嗨，干完了活再说吧。"
                },
                {
                    "id": "413421005",
                    "speaker": "Player",
                    "text": "我也来帮忙吧。"
                },
                {
                    "id": "413421006",
                    "speaker": "王扳子",
                    "text": "哦？那敢情好，那就麻烦你先帮我拿些木板来吧。"
                }
            ]
        },
        {
            "id": "4134211",
            "objective": "取得木板",
            "dialogues": []
        },
        {
            "id": "4134212",
            "objective": "向王扳子回报",
            "dialogues": [
                {
                    "id": "413421201",
                    "speaker": "王扳子",
                    "text": "木板拿来了吗？"
                }
            ]
        },
        {
            "id": "4134202",
            "objective": "向王扳子回报",
            "dialogues": [
                {
                    "id": "413421202",
                    "speaker": "王扳子",
                    "text": "哦，这样就可以了，多谢。"
                },
                {
                    "id": "413421203",
                    "speaker": "王扳子",
                    "text": "还有点零碎工作…能不能请你帮我去港口清点一下新到的物资？"
                },
                {
                    "id": "413421204",
                    "speaker": "王扳子",
                    "text": "应该就是三个箱子，就堆在港口上了。"
                },
                {
                    "id": "413421205",
                    "speaker": "Player",
                    "text": "交给我了。"
                },
                {
                    "id": "413421206",
                    "speaker": "王扳子",
                    "text": "那就拜托你了，我得赶紧把这些活给收尾…"
                }
            ]
        },
        {
            "id": "4134207",
            "objective": "清点货物",
            "dialogues": []
        },
        {
            "id": "4134213",
            "objective": "与王扳子对话",
            "dialogues": [
                {
                    "id": "413421301",
                    "speaker": "王扳子",
                    "text": "数量都对上了吗。"
                },
                {
                    "id": "413421302",
                    "speaker": "Player",
                    "text": "都对上了。"
                },
                {
                    "id": "413421303",
                    "speaker": "王扳子",
                    "text": "真是多谢你了！"
                },
                {
                    "id": "413421304",
                    "speaker": "王扳子",
                    "text": "呼——这样子，今天的急活应该就算是干完了。"
                },
                {
                    "id": "413421305",
                    "speaker": "Player",
                    "text": "李锤子说给你准备了些吃的。"
                },
                {
                    "id": "413421306",
                    "speaker": "王扳子",
                    "text": "咦？他…费这个劲，他这人就是瞎操心。"
                },
                {
                    "id": "413421307",
                    "speaker": "王扳子",
                    "text": "算了，既然都准备好了，我们还是去找他吧。"
                },
                {
                    "id": "413421308",
                    "speaker": "王扳子",
                    "text": "而且你帮了我这么多忙，也多少要给你点东西做报酬。"
                }
            ]
        },
        {
            "id": "4134209",
            "objective": "与李锤子对话",
            "dialogues": [
                {
                    "id": "413420901",
                    "speaker": "王扳子",
                    "text": "久等了吧，我都搞定了。"
                },
                {
                    "id": "413420902",
                    "speaker": "李锤子",
                    "text": "怎么，事情全都弄完了？"
                },
                {
                    "id": "413420903",
                    "speaker": "王扳子",
                    "text": "弄完了，那么点小事，还有这个旅行者帮忙，轻轻松松就都解决了。"
                },
                {
                    "id": "413420904",
                    "speaker": "李锤子",
                    "text": "你这个人啊…唉…"
                },
                {
                    "id": "413420905",
                    "speaker": "王扳子",
                    "text": "行了行了，大过节的，别这副表情嘛。"
                },
                {
                    "id": "413420906",
                    "speaker": "李锤子",
                    "text": "行，你说什么就是什么，霄灯你准备好了没有？"
                },
                {
                    "id": "413420907",
                    "speaker": "王扳子",
                    "text": "霄灯…哎哟！我给忘了，你说我这记性…"
                },
                {
                    "id": "413420908",
                    "speaker": "王扳子",
                    "text": "没事没事，不就是个霄灯嘛，不放也没什么…"
                },
                {
                    "id": "413420909",
                    "speaker": "李锤子",
                    "text": "你少来这套，大过节的，不放霄灯像话吗？"
                },
                {
                    "id": "413420910",
                    "speaker": "李锤子",
                    "text": "旅行者，能拜托你再帮我兄弟弄个霄灯？"
                },
                {
                    "id": "413420911",
                    "speaker": "Player",
                    "text": "交给我了。"
                },
                {
                    "id": "413420912",
                    "speaker": "李锤子",
                    "text": "谢谢，我们就在这等着你。"
                }
            ]
        },
        {
            "id": "4134215",
            "objective": "与李锤子对话",
            "dialogues": [
                {
                    "id": "413421501",
                    "speaker": "李锤子",
                    "text": "你把霄灯拿来了吗？"
                },
                {
                    "id": "413421502",
                    "speaker": "Player",
                    "text": "拿来了。"
                }
            ]
        },
        {
            "id": "4134214",
            "objective": "与王扳子对话",
            "dialogues": [
                {
                    "id": "413421401",
                    "speaker": "李锤子",
                    "text": "行了，谢谢你了。"
                },
                {
                    "id": "413421402",
                    "speaker": "王扳子",
                    "text": "你看你还这么麻烦…谢谢你了啊，旅行者，大过节的还要你跑东跑西的…"
                },
                {
                    "id": "413421403",
                    "speaker": "王扳子",
                    "text": "我想想我要写什么愿望…"
                },
                {
                    "id": "413421404",
                    "speaker": "王扳子",
                    "text": "嗯…就写「新年新气象」吧。",
                    "choices": [
                        {
                            "id": "413421405",
                            "text": "听起来不错。",
                            "response": [
                                {
                                    "id": "413421407",
                                    "speaker": "王扳子",
                                    "text": "是吗？哈哈哈，那就好，哎呀…希望我这愿望，真的能实现…"
                                },
                                {
                                    "id": "413421408",
                                    "speaker": "李锤子",
                                    "text": "唉…"
                                },
                                {
                                    "id": "413421409",
                                    "speaker": "Player",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "413421410",
                                    "speaker": "李锤子",
                                    "text": "他去年，也是许的这个愿望…"
                                }
                            ]
                        },
                        {
                            "id": "413421406",
                            "text": "挺好的愿望。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134203",
            "objective": "(test)与思妤对话",
            "dialogues": [
                {
                    "id": "413420301",
                    "speaker": "思妤",
                    "text": "(test)霄灯最重要的就是人的祝福和心意"
                },
                {
                    "id": "413420302",
                    "speaker": "思妤",
                    "text": "(test)就是这个啦！麻烦帮我送给王扳子吧！"
                },
                {
                    "id": "413420303",
                    "speaker": "思妤",
                    "text": "(test)海灯节还真是热闹啊，我先去忙去了"
                }
            ]
        },
        {
            "id": "4134251",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413425101",
                    "speaker": "思妤",
                    "text": "希望扳子哥能喜欢这盏霄灯…"
                }
            ]
        },
        {
            "id": "4134252",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413425201",
                    "speaker": "李锤子",
                    "text": "唉，这是何苦…"
                }
            ]
        },
        {
            "id": "4134253",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413425301",
                    "speaker": "王扳子",
                    "text": "我真不用霄灯，你说你…"
                },
                {
                    "id": "413425302",
                    "speaker": "李锤子",
                    "text": "你行了，大过节的，放个霄灯，多少也沾点喜气。"
                }
            ]
        }
    ]
}