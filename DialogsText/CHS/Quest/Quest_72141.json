        },
        {
            "id": "7214102",
            "objective": "（test）开始对话1$HIDDEN",
            "dialogues": [
                {
                    "id": "721410601",
                    "speaker": "鹫津",
                    "text": "如何？「他」的教诲，你是否有幸听到？",
                    "choices": [
                        {
                            "id": "721410602",
                            "text": "什么也没听到。",
                            "response": [
                                {
                                    "id": "721410604",
                                    "speaker": "鹫津",
                                    "text": "无妨，无妨，「他」在看着，「他」在听着。"
                                },
                                {
                                    "id": "721410605",
                                    "speaker": "鹫津",
                                    "text": "「他」很欣慰，而喜悦「他」的人，必获得奖赏。"
                                },
                                {
                                    "id": "721410606",
                                    "speaker": "鹫津",
                                    "text": "「他」的奖赏不在彼岸，就在明天。",
                                    "choices": [
                                        {
                                            "id": "721410607",
                                            "text": "你知道自己在说什么吗？",
                                            "response": [
                                                {
                                                    "id": "721410609",
                                                    "speaker": "鹫津",
                                                    "text": "下次再来此处，自见分晓。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721410608",
                                            "text": "恕我浅薄，道理尚有不明。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721410603",
                            "text": "福分浅薄，无缘一听。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7214103",
            "objective": "（test）第二天再来$HIDDEN",
