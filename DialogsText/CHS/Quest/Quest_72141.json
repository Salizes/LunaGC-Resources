        {
            "id": "7214110",
            "objective": "击败发狂的武士",
            "dialogues": []
        },
        {
            "id": "7214111",
            "objective": "在绯木村找到鹫津的财物",
            "dialogues": []
        },
        {
            "id": "7214101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721410101",
                    "speaker": "鹫津",
                    "text": "…？",
                    "choices": [
                        {
                            "id": "721410102",
                            "text": "你好？",
                            "response": [
                                {
                                    "id": "721410105",
                                    "speaker": "鹫津",
                                    "text": "..."
                                },
                                {
                                    "id": "721410106",
                                    "speaker": "Player",
                                    "text": "你在听我讲话吗？"
                                },
                                {
                                    "id": "721410107",
                                    "speaker": "鹫津",
                                    "text": "…",
                                    "choices": [
                                        {
                                            "id": "721410108",
                                            "text": "你好…？",
                                            "response": [
                                                {
                                                    "id": "721410110",
                                                    "speaker": "鹫津",
                                                    "text": "…请你不要打扰我了。"
                                                },
                                                {
                                                    "id": "721410111",
                                                    "speaker": "鹫津",
                                                    "text": "「他」很不悦，不悦于口舌之语的扰乱，遮蔽了「心之语」的智慧。"
                                                },
                                                {
                                                    "id": "721410112",
                                                    "speaker": "Player",
                                                    "text": "口舌之语…？"
                                                },
                                                {
                                                    "id": "721410113",
                                                    "speaker": "鹫津",
                                                    "text": "口舌之语就像骤雨，敲振耳膜，搅扰心智。"
                                                },
                                                {
                                                    "id": "721410114",
                                                    "speaker": "鹫津",
                                                    "text": "而「心之语」则像雾气，自然而来，氤氲而入…"
                                                },
                                                {
                                                    "id": "721410116",
                                                    "speaker": "鹫津",
                                                    "text": "嘘…！「他」在听着，「他」在说话。"
                                                },
                                                {
                                                    "id": "721410117",
                                                    "speaker": "鹫津",
                                                    "text": "不要用口舌，不要用耳朵，用心来听…"
                                                },
                                                {
                                                    "id": "721410118",
                                                    "speaker": "鹫津",
                                                    "text": "来这里，拜祭，祈祷，然后倾听。"
                                                },
                                                {
                                                    "id": "721410119",
                                                    "speaker": "鹫津",
                                                    "text": "要拜祭三番，记住，三番。",
                                                    "choices": [
                                                        {
                                                            "id": "721410120",
                                                            "text": "（试试好了。）"
                                                        },
                                                        {
                                                            "id": "721410121",
                                                            "text": "还是不了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721410109",
                                            "text": "如果能说话就点点头吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721410103",
                            "text": "你在做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7214102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721410201",
                    "speaker": "鹫津",
                    "text": "拜祭，祈祷，倾听…切记，切记。"
                }
            ]
        },
        {
            "id": "7214107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721410701",
                    "speaker": "鹫津",
                    "text": "与「他」的莫大福泽相比，这只不过是一点小小赏赐。"
                },
                {
                    "id": "721410702",
                    "speaker": "鹫津",
                    "text": "祈祷吧，拜祭吧，倾听「他」，并且让「他」倾听你！"
                },
                {
                    "id": "721410703",
                    "speaker": "鹫津",
                    "text": "然后，你将同我一样，听到「他」的话语，从你的心内传出。"
                },
                {
                    "id": "721410704",
                    "speaker": "鹫津",
                    "text": "然后，「他」将引你脱离苦痛，得大恩赏。",
                    "choices": [
                        {
                            "id": "721410705",
                            "text": "唔…",
                            "response": [
                                {
                                    "id": "721410707",
                                    "speaker": "鹫津",
                                    "text": "记住，每日拜祭三番，必有回赐。"
                                },
                                {
                                    "id": "721410708",
                                    "speaker": "鹫津",
                                    "text": "切记，切记。"
                                }
                            ]
                        },
                        {
                            "id": "721410706",
                            "text": "随便你怎么说吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7214112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721411201",
                    "speaker": "鹫津",
                    "text": "「他」要来了！不要停止拜祭！不能停止拜祭！！",
                    "choices": [
                        {
                            "id": "721411202",
                            "text": "你还好吗…？",
                            "response": [
                                {
                                    "id": "721411204",
                                    "speaker": "鹫津",
                                    "text": "「他」在愠怒，「他」要发怒了！",
                                    "choices": [
                                        {
                                            "id": "721411205",
                                            "text": "什么…？",
                                            "response": [
                                                {
                                                    "id": "721411207",
                                                    "speaker": "鹫津",
                                                    "text": "因为什么！因为那个女人！那个拒绝恩赏的邪佞之人！邪佞之人！",
                                                    "choices": [
                                                        {
                                                            "id": "721411208",
                                                            "text": "女人…？",
                                                            "response": [
                                                                {
                                                                    "id": "721411210",
                                                                    "speaker": "鹫津",
                                                                    "text": "她在逃跑，但她怎么逃得过「他」！十八双血色的眼睛！千千万万锋利的毒牙！永远渴求鲜血的、数不清的口与舌！！"
                                                                },
                                                                {
                                                                    "id": "721411211",
                                                                    "speaker": "鹫津",
                                                                    "text": "她躲不过的，躲不过的！"
                                                                },
                                                                {
                                                                    "id": "721411212",
                                                                    "speaker": "鹫津",
                                                                    "text": "啊，沙的寡情的国度，龟缩雨林自称智慧的愚昧乞丐，你们统统庇护不了她！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "721411213",
                                                                            "text": "请你冷静一点！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721411215",
                                                                                    "speaker": "鹫津",
                                                                                    "text": "你拿到了恩赏，速去拜祭！速去拜祭！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "721411214",
                                                                            "text": "哦哦，说得好！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721411209",
                                                            "text": "哦哦，真该死！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721411206",
                                            "text": "哦哦，要发怒了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721411203",
                            "text": "哦哦，「他」要来了！"
                        }
                    ]
                }
            ]
        },
