        },
        {
            "id": "7214108",
            "objective": "（test）开始对话3$HIDDEN",
            "dialogues": [
                {
                    "id": "721411701",
                    "speaker": "鹫津",
                    "text": "必须平息「他」的怒火，必须安抚「他」的愤怒…"
                },
                {
                    "id": "721411702",
                    "speaker": "鹫津",
                    "text": "你做的很好，你做的很好！"
                },
                {
                    "id": "721411703",
                    "speaker": "鹫津",
                    "text": "切记，有的人会戴着面具，欺骗你，但「他」会帮助你，「他」永远襄助你。",
                    "choices": [
                        {
                            "id": "721411704",
                            "text": "呃…",
                            "response": [
                                {
                                    "id": "721411706",
                                    "speaker": "鹫津",
                                    "text": "那个女人就像传说中的狐狸妖怪，我放跑了她，「他」很生气。"
                                },
                                {
                                    "id": "721411707",
                                    "speaker": "鹫津",
                                    "text": "「他」现在又生气了…这是我的罪。"
                                },
                                {
                                    "id": "721411708",
                                    "speaker": "鹫津",
                                    "text": "请原谅我…我会再次献祭，我会为您寻找下一个「回归」的祭品…"
                                },
                                {
                                    "id": "721411709",
                                    "speaker": "鹫津",
                                    "text": "请原谅我，请原谅我…"
                                },
                                {
                                    "id": "721411710",
                                    "speaker": "鹫津",
                                    "text": "请原谅我，请原谅我…"
                                }
                            ]
                        },
                        {
                            "id": "721411705",
                            "text": "好吧…？"
                        }
                    ]
                }
            ]
        },
        {
