        }
    },
    "talks": [
        {
            "id": "7301901",
            "objective": "寻找兰萨卡",
            "dialogues": [
                {
                    "id": "730190101",
                    "speaker": "？？？",
                    "text": "要好好地吸食雨露，快快长大才好…"
                },
                {
                    "id": "730190102",
                    "speaker": "派蒙",
                    "text": "你好！你是兰…兰什么来着？",
                    "choices": [
                        {
                            "id": "730190103",
                            "text": "你是兰帕卡提的哥哥吗？",
                            "response": [
                                {
                                    "id": "730190104",
                                    "speaker": "派蒙",
                                    "text": "哦哦，这招不错。"
                                },
                                {
                                    "id": "730190107",
                                    "speaker": "？？？",
                                    "text": "…长大、长大，变成美味的菜肴…"
                                },
                                {
                                    "id": "730190108",
                                    "speaker": "派蒙",
                                    "text": "完全听不进去呢…"
                                }
                            ]
                        },
                        {
                            "id": "730190105",
                            "text": "兰萨卡。",
                            "response": [
                                {
                                    "id": "730190106",
                                    "speaker": "派蒙",
                                    "text": "兰萨卡！你是兰萨卡吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301902",
            "objective": "接触墩墩桃边的兰那罗",
            "dialogues": [
                {
                    "id": "730190201",
                    "speaker": "？？？",
                    "text": "噫！是那菈…好高、好可怕…"
                },
                {
                    "id": "730190202",
                    "speaker": "？？？",
                    "text": "求求你了…不要摘…"
                },
                {
                    "id": "730190203",
                    "speaker": "派蒙",
                    "text": "好啦，我们不会摘的。"
                },
                {
                    "id": "730190204",
                    "speaker": "？？？",
                    "text": "那就好，呼呼…这些墩墩桃都是我，一点一点种出来的，从它们还是种子开始…"
                },
                {
                    "id": "730190205",
                    "speaker": "？？？",
                    "text": "不、不对，你们这些那菈，坏！怎么能随便向别人种的墩墩桃下手！"
                },
                {
                    "id": "730190206",
                    "speaker": "？？？",
                    "text": "那菈为什么会、会有这么可怕的习惯…"
                },
                {
                    "id": "730190207",
                    "speaker": "派蒙",
                    "text": "我们什么都没做，还没来得及摘啦！"
                },
                {
                    "id": "730190208",
                    "speaker": "？？？",
                    "text": "什么都没做，都已经那么可怕了，你们要是真做点什么，那岂不是要吓死我！"
                },
                {
                    "id": "730190209",
                    "speaker": "派蒙",
                    "text": "喂！"
                },
                {
                    "id": "730190210",
                    "speaker": "兰萨卡",
                    "text": "不行，兰萨卡…想想呀，为了你辛苦种出的墩墩桃，为了「烹饪修行」…不能在这里退缩，一定不能害怕…"
                },
                {
                    "id": "730190211",
                    "speaker": "派蒙",
                    "text": "果然，你就是兰萨卡呀。"
                },
                {
                    "id": "730190212",
                    "speaker": "兰萨卡",
                    "text": "呜哇，你、你们怎么知道我名字的…你们是从哪里来的那菈…居、居然一见面就知道了我的名字…",
                    "choices": [
                        {
                            "id": "730190213",
                            "text": "你自己说的…",
                            "response": [
                                {
                                    "id": "730190214",
                                    "speaker": "兰萨卡",
                                    "text": "真是祸从口出，完蛋了，我的名字将被用于可怕的诅咒…求求你们，饶了我吧…"
                                },
                                {
                                    "id": "730190215",
                                    "speaker": "兰萨卡",
                                    "text": "除了把墩墩桃给你们，我什么都愿意做…"
                                },
                                {
                                    "id": "730190219",
                                    "speaker": "派蒙",
                                    "text": "没必要那么紧张啦，我们其实是受兰帕卡提委托来找你的。"
                                },
                                {
                                    "id": "730190220",
                                    "speaker": "兰萨卡",
                                    "text": "兰、兰帕卡提？啊，我亲爱的「妹妹」，密林中的阳光…"
                                },
                                {
                                    "id": "730190221",
                                    "speaker": "Black Screen",
                                    "text": "向兰萨卡述说事情的经过。"
                                },
                                {
                                    "id": "730190222",
                                    "speaker": "兰萨卡",
                                    "text": "呜哇，无忧节、无忧节怎么会那么快…欸，你们就是来参加这次无忧节的那菈吗？"
                                },
                                {
                                    "id": "730190223",
                                    "speaker": "兰萨卡",
                                    "text": "对不起，刚刚说你们是坏那菈。你们一定是好那菈，因为只有好那菈才能进入桓那兰那，参加无忧节。"
                                },
                                {
                                    "id": "730190224",
                                    "speaker": "兰萨卡",
                                    "text": "无忧节要到了，要是没有完成「烹饪修行」就回桓那兰那…不行…但是无忧节可不能不参加…"
                                },
                                {
                                    "id": "730190225",
                                    "speaker": "派蒙",
                                    "text": "怎么反而变得更紧张了…你不是还有你种的墩墩桃吗？"
                                },
                                {
                                    "id": "730190226",
                                    "speaker": "兰萨卡",
                                    "text": "…只、只有我种的墩墩桃是不够的！"
                                },
                                {
                                    "id": "730190227",
                                    "speaker": "兰萨卡",
                                    "text": "一定要拿到「开心的味道」。没有「开心的味道」，墩墩桃也只不过是墩墩桃而已…"
                                },
                                {
                                    "id": "730190228",
                                    "speaker": "兰萨卡",
                                    "text": "兰茶荼、兰阿帕斯和兰非拉，都不相信世界上存在「开心的味道」。我要做出来给他们看。也要给那菈品尝。",
                                    "choices": [
                                        {
                                            "id": "730190229",
                                            "text": "「开心的味道」？",
                                            "response": [
                                                {
                                                    "id": "730190231",
                                                    "speaker": "兰萨卡",
                                                    "text": "嘿嘿，「开心的味道」，我以前曾经尝到过一次。"
                                                },
                                                {
                                                    "id": "730190232",
                                                    "speaker": "兰萨卡",
                                                    "text": "「开心的味道」。白白的，揉揉就碎…变成白色的巴螺迦，但是不像巴螺迦那样，又硬又痛。装在硬硬气泡里。",
                                                    "choices": [
                                                        {
                                                            "id": "730190233",
                                                            "text": "…白色的巴螺迦？",
                                                            "response": [
                                                                {
                                                                    "id": "730190235",
                                                                    "speaker": "派蒙",
                                                                    "text": "白色的巴螺迦，就是白色的沙子…吧？不过，硬硬气泡是什么啊…"
                                                                },
                                                                {
                                                                    "id": "730190236",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔，搞不懂。那种「开心的味道」在什么地方呢？"
                                                                },
                                                                {
                                                                    "id": "730190237",
                                                                    "speaker": "兰萨卡",
                                                                    "text": "你、你问这个干什么，难道你想要在我之前，夺走「开心的味道」吗？好可怕…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730190238",
                                                                            "text": "我们是想帮你…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730190241",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "帮我？帮我什么？我、我自己也能拿到…"
                                                                                },
                                                                                {
                                                                                    "id": "730190242",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "只不过，那里有很多那菈走来走去。而且，其中有一个，还有那菈巴螺迦的味道。唔…我害怕…要是那菈少一点，我也可以的…"
                                                                                },
                                                                                {
                                                                                    "id": "730190243",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "…唉。好吧，我就是拿不到，我…不敢进化城郭，那里那菈太多了。而且，都是死去的树，我好怕。"
                                                                                },
                                                                                {
                                                                                    "id": "730190244",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "我有一个那菈朋友住在里面。但是，过去了很久很久。现在，他变了，听不到我的声音。"
                                                                                },
                                                                                {
                                                                                    "id": "730190245",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这样啊，所以你说的「开心的味道」，其实在化城郭里就有。"
                                                                                },
                                                                                {
                                                                                    "id": "730190246",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "「开心的味道」，不是从土地里长出来的，而是那菈做出来的。"
                                                                                },
                                                                                {
                                                                                    "id": "730190247",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "我真的好想再尝一次呀，我还记得第一次品尝那个味道的时候，心里多么高兴。那是好厉害、好厉害的味道。"
                                                                                },
                                                                                {
                                                                                    "id": "730190248",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "和那菈朋友一起在森林里，数从树叶间落下来的，像金箔一样的阳光有多少片。"
                                                                                },
                                                                                {
                                                                                    "id": "730190249",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "一起唱歌，一起品尝「开心的味道」。每次看见树叶间的阳光，我就会想到他。每次想到他，我就想起「开心的味道」。"
                                                                                },
                                                                                {
                                                                                    "id": "730190250",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "所以，我想让兰帕卡提尝尝这样的味道。而且，等无忧节开始了，让那菈也尝尝这样的味道。"
                                                                                },
                                                                                {
                                                                                    "id": "730190251",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#我明白了，就交给我和{NICKNAME}吧！对吧，{NICKNAME}！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "730190252",
                                                                                            "text": "我也想要开心。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "730190254",
                                                                                                    "speaker": "兰萨卡",
                                                                                                    "text": "真的？你们没有在骗我吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190255",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "没有啦！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190256",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "不过化城郭那么多人，到底要去谁那里找啊！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190257",
                                                                                                    "speaker": "兰萨卡",
                                                                                                    "text": "我知道。不久之前，看到一个那菈，从这里路过，<color=#00E1FFFF>去了化城郭</color>。他就带着。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190258",
                                                                                                    "speaker": "兰萨卡",
                                                                                                    "text": "他背上有一个鼓鼓的东西。是那菈用来装东西的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190259",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "背上有鼓鼓的东西…嗯，<color=#00E1FFFF>应该是行囊或者背篓</color>吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730190260",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "知道了，我们这就去帮你找「开心的味道」！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "730190253",
                                                                                            "text": "既然已经答应了兰帕卡提…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730190239",
                                                                            "text": "哇！派蒙，你好可怕！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730190240",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂！我只是想帮兰萨卡啦！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730190234",
                                                            "text": "…硬硬气泡？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730190230",
                                            "text": "你说的「开心的味道」是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730190216",
                            "text": "我们早就知道了。",
                            "response": [
                                {
                                    "id": "730190217",
                                    "speaker": "兰萨卡",
                                    "text": "什么！早就知道？原来你们在很早之前就盯上了我…难、难道你们想从我这里得到什么…"
                                },
                                {
                                    "id": "730190218",
                                    "speaker": "兰萨卡",
                                    "text": "难道是墩墩桃？不、不行，要是其他的东西我一定给…但，但是墩墩桃不行，无论如何都不行！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301903",
            "objective": "前往化城郭，寻找「背上鼓鼓的人」",
            "dialogues": [
                {
                    "id": "730190301",
                    "speaker": "兰萨卡",
                    "text": "怎、怎么样，你们找到，「开心的味道」了吗…就在化城郭里…"
                },
                {
                    "id": "730190302",
                    "speaker": "兰萨卡",
                    "text": "有个那菈，背上有一个鼓鼓的东西。「开心的味道」一定装在里面…"
                }
            ]
        },
        {
            "id": "7301904",
            "objective": "与「背上鼓鼓的人」对话",
            "dialogues": [
                {
                    "id": "730190401",
                    "speaker": "派蒙",
                    "text": "你好！"
                },
                {
                    "id": "730190402",
                    "speaker": "杨尼斯",
                    "text": "唔，你们好…怎么，有什么想要的吗？"
                },
                {
                    "id": "730190403",
                    "speaker": "派蒙",
                    "text": "是的，其实我们是想要一样东西…"
                },
                {
                    "id": "730190404",
                    "speaker": "杨尼斯",
                    "text": "呵呵，当然啦，所有人过来都是想要「一样东西」的。不过只说「一样东西」，我可不知道你们要的是「什么东西」哦。"
                },
                {
                    "id": "730190405",
                    "speaker": "派蒙",
                    "text": "嗯…我知道啦。怎么说呢，我们想要的是…"
                },
                {
                    "id": "730190406",
                    "speaker": "Player",
                    "text": "白白方方的…"
                },
                {
                    "id": "730190407",
                    "speaker": "杨尼斯",
                    "text": "白白方方的？"
                },
                {
                    "id": "730190408",
                    "speaker": "派蒙",
                    "text": "对，而且还要一揉就碎成沙，还要装在硬硬的气泡里！"
                },
                {
                    "id": "730190409",
                    "speaker": "杨尼斯",
                    "text": "还真是奇怪的描述…"
                },
                {
                    "id": "730190410",
                    "speaker": "杨尼斯",
                    "text": "光听你们这么说，还真不清楚到底是什么，不过，你们说的这种白白的方方的东西啊，它是干什么用的呢？"
                },
                {
                    "id": "730190411",
                    "speaker": "杨尼斯",
                    "text": "用途，用途总归是知道的吧。",
                    "choices": [
                        {
                            "id": "730190412",
                            "text": "是可以吃的…",
                            "response": [
                                {
                                    "id": "730190413",
                                    "speaker": "杨尼斯",
                                    "text": "可以吃的，白白方方的东西…？"
                                },
                                {
                                    "id": "730190416",
                                    "speaker": "杨尼斯",
                                    "text": "啊！我知道了，我知道你们要什么了…哈哈哈哈…"
                                },
                                {
                                    "id": "730190417",
                                    "speaker": "派蒙",
                                    "text": "有这么好笑嘛！"
                                },
                                {
                                    "id": "730190418",
                                    "speaker": "杨尼斯",
                                    "text": "哎呦，哈哈哈哈哈，我说啊，白白方方的，一揉就碎，变成沙…还能吃…"
                                },
                                {
                                    "id": "730190419",
                                    "speaker": "杨尼斯",
                                    "text": "那不就是「糖」吗！"
                                },
                                {
                                    "id": "730190420",
                                    "speaker": "杨尼斯",
                                    "text": "硬硬气泡，不会说的是装糖的玻璃瓶吧，我的天哪，硬硬气泡，哈哈哈哈…"
                                },
                                {
                                    "id": "730190421",
                                    "speaker": "派蒙",
                                    "text": "什么呀，原来是糖啊…",
                                    "choices": [
                                        {
                                            "id": "730190422",
                                            "text": "有些难堪…",
                                            "response": [
                                                {
                                                    "id": "730190424",
                                                    "speaker": "杨尼斯",
                                                    "text": "哎呀，笑得眼泪都快出来了。这些年为了生意奔波，都不知道上一次笑成这样是什么时候的事了…"
                                                },
                                                {
                                                    "id": "730190425",
                                                    "speaker": "杨尼斯",
                                                    "text": "这么说来，真是怀念，我记得很久以前…啊，我还是小孩的时候，曾经有个朋友第一次吃糖，也说过类似的话。"
                                                },
                                                {
                                                    "id": "730190426",
                                                    "speaker": "杨尼斯",
                                                    "text": "「这个白白方方的东西真好吃！好厉害！开心的味道。」可惊讶了。"
                                                },
                                                {
                                                    "id": "730190427",
                                                    "speaker": "杨尼斯",
                                                    "text": "哈哈…都是多少年前的事了，现在回想，却连他长什么样子都记不得了。"
                                                },
                                                {
                                                    "id": "730190428",
                                                    "speaker": "杨尼斯",
                                                    "text": "哎呀，作为笑得这么开心的回礼，这瓶糖就送给你们吧。"
                                                },
                                                {
                                                    "id": "730190429",
                                                    "speaker": "Player",
                                                    "text": "谢谢。"
                                                },
                                                {
                                                    "id": "730190430",
                                                    "speaker": "杨尼斯",
                                                    "text": "要注意，小心拿好哦，硬硬气泡虽然硬，一下摔在地上可还是会碎的。「硬硬气泡」，哈哈哈哈哈！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730190423",
                                            "text": "有些尴尬…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730190414",
                            "text": "是烹饪用的…",
                            "response": [
                                {
                                    "id": "730190415",
                                    "speaker": "杨尼斯",
                                    "text": "烹饪用的，白白方方的，难道是调味料？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301905",
            "objective": "将糖交给兰萨卡",
            "dialogues": [
                {
                    "id": "730190501",
                    "speaker": "杨尼斯",
                    "text": "我家一直是在这条道上跑商的，从层岩巨渊到须弥。从璃月进口宝石原矿，再把香料送过去。"
                },
                {
                    "id": "730190502",
                    "speaker": "杨尼斯",
                    "text": "有一次，因为有什么事情来着…记不清了，反正老爹把我留在了化城郭，好长一段时间。"
                },
                {
                    "id": "730190503",
                    "speaker": "杨尼斯",
                    "text": "我记得当时在林子里，认识了一个朋友。我们一起到处跑，后来…"
                },
                {
                    "id": "730190504",
                    "speaker": "杨尼斯",
                    "text": "后来的事情，我都不记得了。他叫什么名字，长什么样子，也不记得了…"
                },
                {
                    "id": "730190505",
                    "speaker": "杨尼斯",
                    "text": "我只记得那时候好像很开心。后来老爹终于回来了，把我接走了。我也想过，要回去找他，但一直没有机会，后来就忘了。"
                },
                {
                    "id": "730190506",
                    "speaker": "杨尼斯",
                    "text": "如果不是因为你问我要糖，这些事情，我应该早就全忘了才对。为什么会这样呢…"
                }
            ]
        },
        {
            "id": "7301906",
            "objective": "",
            "dialogues": [
                {
                    "id": "730190601",
                    "speaker": "兰萨卡",
                    "text": "就是这个！没想到你们这么快就拿回来了…是真的吗？"
                },
                {
                    "id": "730190602",
                    "speaker": "兰萨卡",
                    "text": "不会是你们为了骗我，所、所以仿造出来的…"
                },
                {
                    "id": "730190603",
                    "speaker": "派蒙",
                    "text": "就靠你那些描述，能仿造出来才怪…"
                },
                {
                    "id": "730190604",
                    "speaker": "派蒙",
                    "text": "你要是不放心，就自己尝尝看嘛。"
                },
                {
                    "id": "730190605",
                    "speaker": "兰萨卡",
                    "text": "…你们不会往里面放了奇怪的东西吧。"
                },
                {
                    "id": "730190606",
                    "speaker": "派蒙",
                    "text": "当然不会啦，哼，你到底试不试，不试的话我们就拿走啦。"
                },
                {
                    "id": "730190607",
                    "speaker": "兰萨卡",
                    "text": "不、不行…你们不要拿走，让我、让我尝尝看嘛…"
                },
                {
                    "id": "730190608",
                    "speaker": "兰萨卡",
                    "text": "不要拿走啦，我现在就尝，现在就尝…唔…"
                },
                {
                    "id": "730190609",
                    "speaker": "兰萨卡",
                    "text": "啊，是真的…是「开心的味道」，就是这个味道…嘿嘿…再一次尝到，还是觉得开心。"
                },
                {
                    "id": "730190610",
                    "speaker": "兰萨卡",
                    "text": "没想到又能尝到这样的味道…呀，但是…",
                    "choices": [
                        {
                            "id": "730190611",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "730190613",
                                    "speaker": "兰萨卡",
                                    "text": "唔…怎么说呢…「开心的味道」还是和以前一样，但是不知道为什么，感觉吃起来没有第一次吃那样开心了…"
                                },
                                {
                                    "id": "730190614",
                                    "speaker": "派蒙",
                                    "text": "难道他给我们的糖不甜吗？"
                                },
                                {
                                    "id": "730190615",
                                    "speaker": "兰萨卡",
                                    "text": "不是的，不是味道有差别…但是明明以前和朋友一起吃的时候…那是我第一次品尝「开心的味道」…"
                                },
                                {
                                    "id": "730190616",
                                    "speaker": "兰萨卡",
                                    "text": "总觉得那个时候要比现在开心许多，到底是为什么呢？"
                                },
                                {
                                    "id": "730190617",
                                    "speaker": "派蒙",
                                    "text": "#那不是挺正常的嘛，就算是同一道菜，每次{NICKNAME}做出来的味道都不一样…"
                                },
                                {
                                    "id": "730190618",
                                    "speaker": "派蒙",
                                    "text": "我吃的时候心情也不一样呢。",
                                    "choices": [
                                        {
                                            "id": "730190619",
                                            "text": "确实。",
                                            "response": [
                                                {
                                                    "id": "730190621",
                                                    "speaker": "兰萨卡",
                                                    "text": "…不、不会的，一定有一种方法，让我像第一次品尝「开心的味道」时那样开心…"
                                                },
                                                {
                                                    "id": "730190622",
                                                    "speaker": "兰萨卡",
                                                    "text": "我知道了，那个时候我是和朋友一起吃的。所以，「开心的味道」要和朋友一起，才会变得好吃。"
                                                },
                                                {
                                                    "id": "730190623",
                                                    "speaker": "兰萨卡",
                                                    "text": "一定是这样的。你们是好那菈，而且，找到了「开心的味道」。你们，是朋友。我要做给你们吃。"
                                                },
                                                {
                                                    "id": "730190624",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我们是朋友！"
                                                },
                                                {
                                                    "id": "730190625",
                                                    "speaker": "Black Screen",
                                                    "text": "兰萨卡立刻进行了烹饪，将墩墩桃与糖加入锅中…"
                                                },
                                                {
                                                    "id": "730190626",
                                                    "speaker": "Black Screen",
                                                    "text": "随后，兰萨卡将成品交给你与派蒙。\\n果不其然，除了压倒性的「甜」以外，并没有什么味道。\\n可能这就是「开心的味道」吧。"
                                                },
                                                {
                                                    "id": "730190627",
                                                    "speaker": "兰萨卡",
                                                    "text": "啊，真是开心的味道。太美味了。"
                                                },
                                                {
                                                    "id": "730190628",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，这道菜还挺…"
                                                },
                                                {
                                                    "id": "730190629",
                                                    "speaker": "派蒙",
                                                    "text": "还挺「开心」的。",
                                                    "choices": [
                                                        {
                                                            "id": "730190630",
                                                            "text": "太甜了…",
                                                            "response": [
                                                                {
                                                                    "id": "730190632",
                                                                    "speaker": "派蒙",
                                                                    "text": "我也觉得，实在是太甜了…"
                                                                },
                                                                {
                                                                    "id": "730190633",
                                                                    "speaker": "兰萨卡",
                                                                    "text": "是、是嘛，欸呀，我好像一口气放得太多了。"
                                                                },
                                                                {
                                                                    "id": "730190634",
                                                                    "speaker": "兰萨卡",
                                                                    "text": "但是…嘿嘿，果然，果然要和朋友一起分享，「开心的味道」才会更开心。"
                                                                },
                                                                {
                                                                    "id": "730190635",
                                                                    "speaker": "兰萨卡",
                                                                    "text": "虽然和第一次吃到「开心的味道」的时候感受到的开心也有区别，但是和你们一起吃…我感到了另外一种开心。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730190636",
                                                                            "text": "开心就好。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730190638",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "一开始的时候我还怀疑你们心怀不轨，但是你们不计前嫌，还、还帮我找到了「开心的味道」…"
                                                                                },
                                                                                {
                                                                                    "id": "730190639",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "有你们的帮助，我才能做完我的「至上珍馐」，完成「烹饪修行」…"
                                                                                },
                                                                                {
                                                                                    "id": "730190640",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这都不算什么啦…"
                                                                                },
                                                                                {
                                                                                    "id": "730190641",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "那、那怎么可以，你们帮了我那么多…"
                                                                                },
                                                                                {
                                                                                    "id": "730190642",
                                                                                    "speaker": "兰萨卡",
                                                                                    "text": "对了。我教你们，这个菜肴的做法。这样的话，以后你们就能和朋友，分享「开心的味道」。"
                                                                                },
                                                                                {
                                                                                    "id": "730190643",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "(嗯…如果改一下原料的配比，再加点别的，应该可以做成不错的点心…)"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730190637",
                                                                            "text": "我想喝水…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730190631",
                                                            "text": "我想喝水。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730190620",
                                            "text": "还能有这回事？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730190612",
                            "text": "有什么问题吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730190701",
                    "speaker": "兰萨卡",
                    "text": "只、只要回去把这道「至上珍馐」给他们品尝，他们就会明白什么是「开心的味道」了。"
                },
                {
                    "id": "730190702",
                    "speaker": "兰萨卡",
                    "text": "兰帕卡提，一定也会喜欢的…"
                }
            ]
        },
        {
            "id": "7301908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730190801",
                    "speaker": "兰萨卡",
                    "text": "那菈，坏！不许…不许摘我种的墩墩桃！"
                }
            ]
        },
        {
            "id": "7301909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730190901",
                    "speaker": "兰萨卡",
                    "text": "都说了不许摘，那、那可是为了「开心的味道」准备的！"
                }
            ]
        },
        {
            "id": "7301910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730191001",
                    "speaker": "派蒙",
                    "text": "兰萨卡，这个就是你要的「开心的味道」吧。"
                },
                {
                    "id": "730191002",
                    "speaker": "派蒙",
                    "text": "我们帮你从化城郭拿回来啦。"
                }
            ]
        }
    ]
}