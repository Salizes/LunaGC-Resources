    "talks": [
        {
            "id": "7526301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752630201",
                    "speaker": "Player",
                    "text": "我也要报名。"
                },
                {
                    "id": "752630202",
                    "speaker": "基努",
                    "text": "出人意料的转折，一位英勇的挑战者出现了！"
                },
                {
                    "id": "752630203",
                    "speaker": "「疾风娜娜丝」",
                    "text": "哦？不自量力的小鬼。"
                },
                {
                    "id": "752630204",
                    "speaker": "基努",
                    "text": "真是百转千回的进展…最后的赢家到底是谁？那就让我们拭目以待吧！"
                },
                {
                    "id": "752630205",
                    "speaker": "Black Screen",
                    "text": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…"
                }
            ]
        },
        {
            "id": "7526302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7526303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752630301",
                    "speaker": "基努",
                    "text": "太不可思议了！真的有人击败了「疾风娜娜丝」！！"
                },
                {
                    "id": "752630302",
                    "speaker": "基努",
                    "text": "#这位挑战者用来去如风的步伐夺得了今天的冠军，让我们恭喜{M#他}{F#她}！"
                },
                {
                    "id": "752630303",
                    "speaker": "「疾风娜娜丝」",
                    "text": "我居然输了…这不可能！"
                },
                {
                    "id": "752630304",
                    "speaker": "兴奋的游客",
                    "text": "#{M#他}{F#她}好厉害！"
                },
                {
                    "id": "752630305",
                    "speaker": "基努",
                    "text": "但是——！老观众们应该都知道，「疾风娜娜丝」并不是悠悠极速赛场上出现过的最强选手！"
                },
                {
                    "id": "752630306",
                    "speaker": "基努",
                    "text": "在「疾风娜娜丝」之前，还有两位堪称恐怖统治级的本土选手，它们今天也来到了赛场！"
                },
                {
                    "id": "752630307",
                    "speaker": "基努",
                    "text": "让我们欢迎来无影——！"
                },
                {
                    "id": "752630308",
                    "speaker": "「来无影」",
                    "text": "♪、♩~~"
                },
                {
                    "id": "752630309",
                    "speaker": "基努",
                    "text": "去无踪——！"
                },
                {
                    "id": "752630310",
                    "speaker": "「去无踪」",
                    "text": "♫ 、♩~~"
                },
                {
                    "id": "752630311",
                    "speaker": "基努",
                    "text": "挑战者，这两位可是真正可怕的对手，以你刚才表现的实力，要战胜它们恐怕难于登天。"
                },
                {
                    "id": "752630312",
                    "speaker": "基努",
                    "text": "你准备好了吗？"
                },
                {
                    "id": "752630313",
                    "speaker": "Player",
                    "text": "准备好了！"
                },
                {
                    "id": "752630314",
                    "speaker": "Black Screen",
                    "text": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…"
                }
            ]
        },
        {
            "id": "7526304",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752630401",
                    "speaker": "Player",
                    "text": "再见。"
                }
            ]
        },
        {
            "id": "7526305",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752630501",
                    "speaker": "基努",
                    "text": "比赛结束！比赛结束！令人震惊的结果出现了！"
                },
                {
                    "id": "752630502",
                    "speaker": "基努",
                    "text": "#我宣布，本场比赛最终的胜者是——{NICKNAME}！"
                },
                {
                    "id": "752630503",
                    "speaker": "兴奋的游客",
                    "text": "#哇！{M#他}{F#她}也太强了吧！居然能打败「来无影」和「去无踪」！"
                },
                {
                    "id": "752630504",
                    "speaker": "激动的游客",
                    "text": "#{M#他}{F#她}的身影就像一道金色闪电！"
                },
                {
                    "id": "752630505",
                    "speaker": "派蒙",
                    "text": "喂喂，没有银色闪电吗？你们都没看见银色闪电吗？"
                },
                {
                    "id": "752630506",
                    "speaker": "「疾风娜娜丝」",
                    "text": "我输得好彻底…这大概是我永远抵达不了的速度吧…"
                },
                {
                    "id": "752630507",
                    "speaker": "Player",
                    "text": "不要放弃。"
                },
                {
                    "id": "752630508",
                    "speaker": "「疾风娜娜丝」",
                    "text": "我…我会以你为目标的…"
                },
                {
                    "id": "752630509",
                    "speaker": "「来无影」",
                    "text": "♪、♩~~"
                },
                {
                    "id": "752630510",
                    "speaker": "「去无踪」",
                    "text": "♫ 、♩~~"
                },
                {
                    "id": "752630511",
                    "speaker": "基努",
                    "text": "请收下我们为本届冠军准备的奖品，这是你应得的！"
                },
                {
                    "id": "752630512",
                    "speaker": "基努",
                    "text": "你的名字将会被悠悠极速大赛的赛史永远铭记！"
                }
            ]
        },
        {
            "id": "7526306",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752630901",
                    "speaker": "Player",
                    "text": "准备好了！"
                },
                {
                    "id": "752630902",
                    "speaker": "Black Screen",
                    "text": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…"
                }
            ]
        },
        {
            "id": "7526301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752630101",
                    "speaker": "基努",
                    "text": "各位游客，悠悠极速大赛马上就要开始了！"
                },
                {
                    "id": "752630102",
                    "speaker": "基努",
                    "text": "谁能击败昨天、前天和大前天的卫冕冠军「疾风娜娜丝」，谁就能得到我们今天的惊喜大奖！请还没有报名的游客抓紧最后的时间！"
                },
                {
                    "id": "752630103",
                    "speaker": "「疾风娜娜丝」",
                    "text": "哼，面对我「疾风娜娜丝」，已经没有人敢再报名了吗？"
                },
                {
                    "id": "752630104",
                    "speaker": "沮丧的游客",
                    "text": "唉，「疾风娜娜丝」太强了，已经连续三天拿走奖品了，没有人能赢的。"
                },
                {
                    "id": "752630105",
                    "speaker": "跃跃欲试的匿叶龙",
                    "text": "嗷！！"
                },
                {
                    "id": "752630106",
                    "speaker": "沮丧的游客",
                    "text": "欸？你想试试吗？"
                },
                {
                    "id": "752630107",
                    "speaker": "「疾风娜娜丝」",
                    "text": "哼，已经沦落到只敢让龙出场了吗？胆小鬼们，把你们各自的龙都派上来吧，我「疾风娜娜丝」会告诉你们什么才是速度。"
                },
                {
                    "id": "752630108",
                    "speaker": "基努",
                    "text": "真是一场别开生面的悠悠极速大赛！让我们看看强壮的龙伙伴们能否击败三连冠的「疾风娜娜丝」吧！"
                }
            ]
        },
        {
            "id": "7526308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752630801",
                    "speaker": "基努",
                    "text": "挑战者，你准备好挑战「来无影」和「去无踪」了吗？"
                }
            ]
        },
        {
            "id": "7526310",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752631001",
                    "speaker": "Player",
                    "text": "再见。"
                }
            ]
        }
    ]
