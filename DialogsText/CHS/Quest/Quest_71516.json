    "talks": [
        {
            "id": "7151601",
            "objective": "和应公聊聊",
            "dialogues": [
                {
                    "id": "715160101",
                    "speaker": "应公",
                    "text": "这出戏算是完美落幕了，年轻人，你做得不错。感觉怎么样，演纸映剧难不难？",
                    "choices": [
                        {
                            "id": "715160102",
                            "text": "轻轻松松。",
                            "response": [
                                {
                                    "id": "715160103",
                                    "speaker": "应公",
                                    "text": "纸映剧和璃月戏不同，一个人也能演，的确是轻松不少。"
                                },
                                {
                                    "id": "715160106",
                                    "speaker": "派蒙",
                                    "text": "#我觉得{NICKNAME}做得够好啦，纸映剧本身也很有意思，我还想看新的故事，应公大叔，你什么时候再演？"
                                },
                                {
                                    "id": "715160107",
                                    "speaker": "应公",
                                    "text": "哈哈，有人喜欢就好。至于什么时候再演，我还真说不好。"
                                },
                                {
                                    "id": "715160108",
                                    "speaker": "应公",
                                    "text": "本来嘛，演纸映剧给孩子们看算是我的业余爱好。这一出演完了，我就回云翰社去管行头了。"
                                },
                                {
                                    "id": "715160109",
                                    "speaker": "派蒙",
                                    "text": "欸？大叔你是云翰社的人吗？那你一定也会唱璃月戏吧。"
                                },
                                {
                                    "id": "715160110",
                                    "speaker": "应公",
                                    "text": "唱是会唱，常年泡在云翰社里，谁不会哼几句？但要跟我们云老板比还是差远咯。"
                                },
                                {
                                    "id": "715160111",
                                    "speaker": "应公",
                                    "text": "我啊，属于幕后忙活的那拨人。戏台上用的枪杆子、大旗、各式各样的戏服、配饰、道具…都归我管。"
                                },
                                {
                                    "id": "715160112",
                                    "speaker": "应公",
                                    "text": "云翰社现在用的行头，一部分是以前留下来的，一部分是我去购置的，还有的是我亲手做的。"
                                },
                                {
                                    "id": "715160113",
                                    "speaker": "应公",
                                    "text": "要唱一出全本璃月戏，台上台下忙活的人有一大堆，只有几个演员那肯定不行。"
                                },
                                {
                                    "id": "715160114",
                                    "speaker": "应公",
                                    "text": "今年海灯节，云老板给我们几个幕后干活的人放了假，我那几个老朋友又都回老家过节去了。"
                                },
                                {
                                    "id": "715160115",
                                    "speaker": "应公",
                                    "text": "我一个人没什么事干，就干脆带着家伙物事给大家演纸映剧来了。"
                                },
                                {
                                    "id": "715160116",
                                    "speaker": "Player",
                                    "text": "不回家吗？"
                                },
                                {
                                    "id": "715160117",
                                    "speaker": "应公",
                                    "text": "哦，我没成家，前年我家老爷子和老娘走了，就剩我一个人。",
                                    "choices": [
                                        {
                                            "id": "715160118",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "715160120",
                                                    "speaker": "应公",
                                                    "text": "哎呀，这有什么好对不起的，我不介意。"
                                                },
                                                {
                                                    "id": "715160121",
                                                    "speaker": "应公",
                                                    "text": "我一个人过海灯节也挺快活，你看到了吧，那几个孩子很喜欢我演的纸映剧。"
                                                },
                                                {
                                                    "id": "715160122",
                                                    "speaker": "派蒙",
                                                    "text": "我们也很喜欢！"
                                                },
                                                {
                                                    "id": "715160123",
                                                    "speaker": "应公",
                                                    "text": "别说你们喜欢，我自己也喜欢，否则就不会费那么多功夫做这些纸人纸布景咯。"
                                                },
                                                {
                                                    "id": "715160124",
                                                    "speaker": "Player",
                                                    "text": "故事是大叔自己编写的吗？"
                                                },
                                                {
                                                    "id": "715160125",
                                                    "speaker": "应公",
                                                    "text": "倒不能这样说，璃月戏也好，纸映剧也好，甚至是茶博士的说书，都提到过「虬髯公」的故事。"
                                                },
                                                {
                                                    "id": "715160126",
                                                    "speaker": "应公",
                                                    "text": "只要人们需要，只要大家发出呼唤，就会有这样的英雄诞生，去拯救处在危难中的人。"
                                                },
                                                {
                                                    "id": "715160127",
                                                    "speaker": "应公",
                                                    "text": "璃月一直都不缺少这种英雄，只要把他们的故事稍加演绎一番，就有了大家喜闻乐见的戏。"
                                                },
                                                {
                                                    "id": "715160128",
                                                    "speaker": "派蒙",
                                                    "text": "以前也听过很多这样的事情，这算是璃月传统文化的一部分吗？"
                                                },
                                                {
                                                    "id": "715160129",
                                                    "speaker": "应公",
                                                    "text": "哈哈，这样说也算没错。"
                                                },
                                                {
                                                    "id": "715160130",
                                                    "speaker": "应公",
                                                    "text": "不过呢，虽说总会有英雄在危难的时候出手相助，但平时还是不能总依赖别人，得自己照顾好自己。"
                                                },
                                                {
                                                    "id": "715160131",
                                                    "speaker": "应公",
                                                    "text": "#{M#小伙子}{F#小姑娘}，要照顾好自己，海灯节快乐！"
                                                },
                                                {
                                                    "id": "715160132",
                                                    "speaker": "Player",
                                                    "text": "我会的，海灯节快乐！"
                                                },
                                                {
                                                    "id": "715160133",
                                                    "speaker": "派蒙",
                                                    "text": "海灯节快乐！"
                                                },
                                                {
                                                    "id": "715160134",
                                                    "speaker": "应公",
                                                    "text": "有空多来云翰社听戏啊，说不定以后咱们还能见得着。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715160119",
                                            "text": "对、对不起！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715160104",
                            "text": "不太容易。",
                            "response": [
                                {
                                    "id": "715160105",
                                    "speaker": "应公",
                                    "text": "你不是行内人，第一次尝试当然会犯些错误，这是在所难免的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}