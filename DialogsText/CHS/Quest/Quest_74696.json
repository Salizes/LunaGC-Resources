    "talks": [
        {
            "id": "7469601",
            "objective": "与七七对话",
            "dialogues": [
                {
                    "id": "746960101",
                    "speaker": "布蕾莘",
                    "text": "想起来了吗？七七。"
                },
                {
                    "id": "746960102",
                    "speaker": "七七",
                    "text": "唔…抱歉…"
                },
                {
                    "id": "746960103",
                    "speaker": "布蕾莘",
                    "text": "不用道歉啦，没事的。距离沫芒宫还有一段路，我们再走走，说不定就能想起来你家在哪里了。"
                },
                {
                    "id": "746960104",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}快看，是七七！还有一位美露莘。是没见过的组合呢！"
                },
                {
                    "id": "746960105",
                    "speaker": "七七",
                    "text": "#啊！{NICKNAME}，还有…派…派蒙…"
                },
                {
                    "id": "746960106",
                    "speaker": "Player",
                    "text": "你们好。"
                },
                {
                    "id": "746960107",
                    "speaker": "布蕾莘",
                    "text": "是七七的熟人吗？太好了，我在柔灯港附近查案的时候遇到了这个走失的孩子…是孩子吧？按照体型来看，应该是人类的孩子。"
                },
                {
                    "id": "746960108",
                    "speaker": "七七",
                    "text": "七七是…是…"
                },
                {
                    "id": "746960109",
                    "speaker": "Player",
                    "text": "我们的好朋友！"
                },
                {
                    "id": "746960110",
                    "speaker": "派蒙",
                    "text": "对、对！我们很久以前就认识啦，是要好的朋友！"
                },
                {
                    "id": "746960111",
                    "speaker": "派蒙",
                    "text": "哦哦！你反应可真快，万一七七说自己是僵尸的话，会吓坏她的吧。"
                },
                {
                    "id": "746960112",
                    "speaker": "七七",
                    "text": "嗯…好朋友…没错。"
                },
                {
                    "id": "746960113",
                    "speaker": "布蕾莘",
                    "text": "看来总算有点眉目了。说实话，我也是第一次遇上这种束手无策的情况…"
                },
                {
                    "id": "746960114",
                    "speaker": "布蕾莘",
                    "text": "那你们应该也知道，她似乎记忆出现了点问题，除了名字以外其他都很难想起来。"
                },
                {
                    "id": "746960115",
                    "speaker": "派蒙",
                    "text": "有时候七七是会这样子的。"
                },
                {
                    "id": "746960116",
                    "speaker": "布蕾莘",
                    "text": "真是个可怜的孩子。我原本打算带她去逐影庭先安置一下，顺便去的路上也看看七七能不能恢复一些记忆。"
                },
                {
                    "id": "746960117",
                    "speaker": "布蕾莘",
                    "text": "既然你们是好朋友的话，你们知道她的家在哪里吗？我可以直接送她回去，这样也能省掉很多麻烦。"
                },
                {
                    "id": "746960118",
                    "speaker": "派蒙",
                    "text": "知道是知道…呃，但距离这里也太远了吧…"
                },
                {
                    "id": "746960119",
                    "speaker": "七七",
                    "text": "太…远…？七七跟着仙灵走了远远的一段路，到了柔灯港…"
                },
                {
                    "id": "746960120",
                    "speaker": "布蕾莘",
                    "text": "欸？你想起来啦？那再之前的事情呢？"
                },
                {
                    "id": "746960121",
                    "speaker": "七七",
                    "text": "之前…白先生带着七七出诊，在遗…唔，遗什么来着？七七去采药，然后…"
                },
                {
                    "id": "746960122",
                    "speaker": "派蒙",
                    "text": "喔！遗珑埠是吧！大侦探派蒙已经知道是怎么一回事了。"
                },
                {
                    "id": "746960123",
                    "speaker": "派蒙",
                    "text": "白术带着七七一起在遗珑埠出诊，七七在那一带采药的时候迷路了，偶遇了仙灵就跟着来到了柔灯港。"
                },
                {
                    "id": "746960124",
                    "speaker": "派蒙",
                    "text": "#哼哼，还好我和{NICKNAME}一起看过《怪盗与名侦探》，这种简单的推理还难不倒我。"
                },
                {
                    "id": "746960125",
                    "speaker": "Player",
                    "text": "其实那个故事完全是虚构的吧…"
                },
                {
                    "id": "746960126",
                    "speaker": "布蕾莘",
                    "text": "噢噢！确实非常合理，那我立刻动身把七七送回遗珑埠去。白术先生是七七的监护人是吧？他肯定急坏了！",
                    "choices": [
                        {
                            "id": "746960127",
                            "text": "等等，芭比洛斯女士在等的人里面…",
                            "response": [
                                {
                                    "id": "746960129",
                                    "speaker": "派蒙",
                                    "text": "对哦！差点就把这件事情给忘记了。芭比洛斯女士——你在吗？听得到吗？"
                                },
                                {
                                    "id": "746960130",
                                    "speaker": "芭比洛斯",
                                    "text": "不用喊那么大声。我一直都在，只是不想打断你们的对话而已。倾听是优秀占卜师的本能。"
                                },
                                {
                                    "id": "746960131",
                                    "speaker": "芭比洛斯",
                                    "text": "所谓的仙灵引路，亦可算是一种命运的指引。呵呵呵…既然来到了这里，不妨「占卜」看看吧…"
                                },
                                {
                                    "id": "746960132",
                                    "speaker": "七七",
                                    "text": "占…卜？"
                                },
                                {
                                    "id": "746960133",
                                    "speaker": "艾莉丝",
                                    "text": "哎呀，打扰一下。芭比，你这种公事公办的态度会吓坏小朋友哦？"
                                },
                                {
                                    "id": "746960134",
                                    "speaker": "艾莉丝",
                                    "text": "你先让一让。看好了，要像我这样，把这份惊喜小礼物给送出去才对。"
                                },
                                {
                                    "id": "746960135",
                                    "speaker": "艾莉丝",
                                    "text": "咳咳，小魔女会成员七七小朋友，我是你的盟友可莉的妈妈，这个世界上最棒的大魔女艾莉丝阿姨。"
                                },
                                {
                                    "id": "746960136",
                                    "speaker": "七七",
                                    "text": "艾莉丝阿姨好…"
                                },
                                {
                                    "id": "746960137",
                                    "speaker": "艾莉丝",
                                    "text": "真是个有礼貌的可爱好孩子。来吧，让大魔女来给小魔女主持一场惊喜预言仪式。"
                                },
                                {
                                    "id": "746960138",
                                    "speaker": "七七",
                                    "text": "预言…仪式？"
                                },
                                {
                                    "id": "746960139",
                                    "speaker": "艾莉丝",
                                    "text": "没错！看看你眼前的牌，好不好看？喜不喜欢？"
                                },
                                {
                                    "id": "746960140",
                                    "speaker": "七七",
                                    "text": "喜欢…"
                                },
                                {
                                    "id": "746960141",
                                    "speaker": "艾莉丝",
                                    "text": "喜欢就好，那就抽一张牌吧！"
                                },
                                {
                                    "id": "746960142",
                                    "speaker": "七七",
                                    "text": "唔…这张，可以吗？"
                                },
                                {
                                    "id": "746960143",
                                    "speaker": "艾莉丝",
                                    "text": "当然可以。作为好好配合的奖励，你手上的牌就归你了！"
                                },
                                {
                                    "id": "746960144",
                                    "speaker": "七七",
                                    "text": "…谢谢？"
                                },
                                {
                                    "id": "746960145",
                                    "speaker": "艾莉丝",
                                    "text": "好了，芭比，你的休息时间已经结束咯，该来帮七七小朋友解读了。"
                                },
                                {
                                    "id": "746960146",
                                    "speaker": "芭比洛斯",
                                    "text": "不用晃我的肩膀…我在看着呢，哦，是「倒吊人」，正位。"
                                },
                                {
                                    "id": "746960147",
                                    "speaker": "芭比洛斯",
                                    "text": "能抽出它来的人可不多。"
                                },
                                {
                                    "id": "746960148",
                                    "speaker": "艾莉丝",
                                    "text": "也就是说你非常特别哟，七七小朋友。"
                                },
                                {
                                    "id": "746960149",
                                    "speaker": "芭比洛斯",
                                    "text": "它象征着超越与等待，也意味着超脱于世俗之外。"
                                },
                                {
                                    "id": "746960150",
                                    "speaker": "芭比洛斯",
                                    "text": "你处在一定的限制之内，但你自身并不会想要主动挣脱这种限制。"
                                },
                                {
                                    "id": "746960151",
                                    "speaker": "七七",
                                    "text": "限制…是指敕令吗？"
                                },
                                {
                                    "id": "746960152",
                                    "speaker": "芭比洛斯",
                                    "text": "从表面上来说，你这么理解也没有错。"
                                },
                                {
                                    "id": "746960153",
                                    "speaker": "芭比洛斯",
                                    "text": "关于未来，你只需要等待即可。当然，对你来说，最不缺的应该就是时间。但是…哦呀，怪了，怪了…"
                                },
                                {
                                    "id": "746960154",
                                    "speaker": "艾莉丝",
                                    "text": "好了好了，打住！一口气说太多，会加重小朋友的负担哦！"
                                },
                                {
                                    "id": "746960155",
                                    "speaker": "艾莉丝",
                                    "text": "先让七七小朋友好好感受一下手头的这份礼物吧，对小朋友要耐心一点，多给一点时间。"
                                },
                                {
                                    "id": "746960156",
                                    "speaker": "艾莉丝",
                                    "text": "怎么样，七七小朋友，喜欢这份小小惊喜吗？"
                                },
                                {
                                    "id": "746960157",
                                    "speaker": "七七",
                                    "text": "卡牌，好看…谢谢艾莉丝阿姨。"
                                },
                                {
                                    "id": "746960158",
                                    "speaker": "艾莉丝",
                                    "text": "哎呀，真乖，努力记住了阿姨的名字呢。虽然阿姨还想和你多聊聊天。但时间差不多了，好孩子该回家了。"
                                },
                                {
                                    "id": "746960159",
                                    "speaker": "艾莉丝",
                                    "text": "芭比要是还有话想说，那等下次小魔女会成员再次相聚的时候，再给每一位小魔女都做一次预言吧！大家一定都会很开心的！"
                                },
                                {
                                    "id": "746960160",
                                    "speaker": "芭比洛斯",
                                    "text": "…可以不要擅自增加我的工作量吗？"
                                },
                                {
                                    "id": "746960161",
                                    "speaker": "艾莉丝",
                                    "text": "就这么说定了！我们下次再见啦，七七小朋友和各位见证者们。"
                                },
                                {
                                    "id": "746960162",
                                    "speaker": "七七",
                                    "text": "再见…艾莉丝阿姨和艾莉丝阿姨的…好朋友。"
                                },
                                {
                                    "id": "746960163",
                                    "speaker": "布蕾莘",
                                    "text": "呼…这算是结束了吗？刚刚那两位的声音是从这个玩偶里传来的吗？这是什么新型玩具，好可爱，在哪能…"
                                },
                                {
                                    "id": "746960164",
                                    "speaker": "布蕾莘",
                                    "text": "呃！不对不对，现在不应该想这些。七七，我们先去找那位叫白术的先生吧。"
                                },
                                {
                                    "id": "746960165",
                                    "speaker": "七七",
                                    "text": "#…嗯，时间到了，七七该回去了。下次…再见，{NICKNAME}，派蒙。",
                                    "choices": [
                                        {
                                            "id": "746960166",
                                            "text": "路上小心。",
                                            "response": [
                                                {
                                                    "id": "746960168",
                                                    "speaker": "七七",
                                                    "text": "卡牌…礼物，嗯…好看…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746960167",
                                            "text": "注意安全喔。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746960128",
                            "text": "也有七七吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7469602",
            "objective": "聆听七七的故事…",
            "dialogues": []
        },
        {
            "id": "7469605",
            "objective": "聆听七七的故事…",
            "dialogues": []
        },
        {
            "id": "7469603",
            "objective": "完成七七的故事",
            "dialogues": [
                {
                    "id": "746960301",
                    "speaker": "白术",
                    "text": "这次的看诊差不多了，只是七七采药怎么还没回来？"
                },
                {
                    "id": "746960302",
                    "speaker": "长生",
                    "text": "你是不是应该给自己开个治疗思虑过重的方子？距离她敕令规定好的时间还有一时辰呢。"
                }
            ]
        },
        {
            "id": "7469604",
