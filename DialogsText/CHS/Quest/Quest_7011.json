        {
            "id": "701132",
            "objective": "前往派蒙可能在的屋子",
            "dialogues": [
                {
                    "id": "70113201",
                    "speaker": "Black Screen",
                    "text": "在屋中与派蒙顺利会合…"
                }
            ]
        },
        {
            "id": "701131",
            "objective": "前往屋外",
            "dialogues": []
        },
        {
            "id": "701129",
            "objective": "启用「灰眸」",
            "dialogues": []
        },
        {
            "id": "701130",
            "objective": "通过「灰眸」驱动列车",
            "dialogues": []
        },
        {
            "id": "701137",
            "objective": "前往列车轨道旁",
            "dialogues": []
        },
        {
            "id": "701126",
            "objective": "驱车驶出暴风雪",
            "dialogues": [
                {
                    "id": "70112601",
                    "speaker": "「灰眸」",
                    "text": "从这里向北，我们很快就会抵达…"
                },
                {
                    "id": "70112602",
                    "speaker": "「灰眸」",
                    "text": "稍等，有报错提示…无法检测到通畅的铁轨？"
                },
                {
                    "id": "70112603",
                    "speaker": "派蒙",
                    "text": "嗯，什么叫通畅的…"
                },
                {
                    "id": "70112604",
                    "speaker": "「灰眸」",
                    "text": "朋友们，做好防冲击准备！即将进入预期外的飞行模式——"
                }
            ]
        },
        {
            "id": "701128",
            "objective": "与派蒙和「灰眸」交谈",
            "dialogues": []
        },
        {
            "id": "701127",
            "objective": "与派蒙和「灰眸」交谈",
            "dialogues": [
                {
                    "id": "70112701",
                    "speaker": "「灰眸」",
                    "text": "真是奇怪，不仅是车站情况和记录有很大差距，就连铁路与地形都发生了改变…"
                },
                {
                    "id": "70112702",
                    "speaker": "Player",
                    "text": "派蒙，没事吧？"
                },
                {
                    "id": "70112703",
                    "speaker": "派蒙",
                    "text": "嗯，多亏你反应快…"
                },
                {
                    "id": "70112704",
                    "speaker": "「灰眸」",
                    "text": "抱歉，把您卷入危险中，我也对现状一头雾水…",
                    "choices": [
                        {
                            "id": "70112705",
                            "text": "该找机会更新数据了。",
                            "response": [
                                {
                                    "id": "70112707",
                                    "speaker": "「灰眸」",
                                    "text": "你说得对，应该是铁路数据信息过期所致。只是和老旧数据相比，变化比我想象中要更大…"
                                },
                                {
                                    "id": "70112708",
                                    "speaker": "「灰眸」",
                                    "text": "不过幸运的是，按照数据，我们的坠落地就在小镇附近。"
                                },
                                {
                                    "id": "70112709",
                                    "speaker": "派蒙",
                                    "text": "又是「按照数据」…"
                                },
                                {
                                    "id": "70112710",
                                    "speaker": "「灰眸」",
                                    "text": "这次肯定不会错，请您看向这个方向，那就是克什尼克之炬！"
                                },
                                {
                                    "id": "70112711",
                                    "speaker": "「灰眸」",
                                    "text": "从结果来说，我们因祸得福，走了一条最近的路。"
                                },
                                {
                                    "id": "70112712",
                                    "speaker": "Player",
                                    "text": "只是这条路实在不算平稳。"
                                },
                                {
                                    "id": "70112713",
                                    "speaker": "「灰眸」",
                                    "text": "请您放心，下次我会考虑到用户偏好的，下次一定——"
                                }
                            ]
                        },
                        {
                            "id": "70112706",
                            "text": "可惜了这辆列车。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "701199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "70119901",
                    "speaker": "派蒙",
                    "text": "你看，有鹿！和挪德卡莱见过的有点像，只是没有月矩力留下的影响了。"
                },
                {
                    "id": "70119902",
                    "speaker": "派蒙",
                    "text": "这说明我们真的已经到至冬了啊。"
                },
                {
                    "id": "70119903",
                    "speaker": "派蒙",
                    "text": "宝箱，宝箱，冒险怎么能少了宝箱呢…"
                },
                {
                    "id": "70119910",
                    "speaker": "派蒙",
                    "text": "怎么啦，快走吧。"
                },
                {
                    "id": "70119911",
                    "speaker": "派蒙",
                    "text": "感觉风雪是不是越变越大了…有、有点飞不动了…"
                },
                {
                    "id": "70119912",
                    "speaker": "派蒙",
                    "text": "#唔，{NICKNAME}，你看那边有个小屋，呜，我们去休息一阵吧！"
                },
                {
                    "id": "70119915",
                    "speaker": "Player",
                    "text": "派蒙——派蒙——"
                },
                {
                    "id": "70119925",
                    "speaker": "「灰眸」",
                    "text": "储备的能量较低…请及时采集「克什尼克晶矿」以补充能量…"
                }
            ]
        }
    ]
}