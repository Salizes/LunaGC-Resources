        {
            "id": "701117",
            "objective": "寻找出去的道路",
            "dialogues": [
                {
                    "id": "70111701",
                    "speaker": "「灰眸」",
                    "text": "检测到周围环境…必要出口已被冰封绝…"
                },
                {
                    "id": "70111702",
                    "speaker": "Player",
                    "text": "或许可以用火…"
                },
                {
                    "id": "70111703",
                    "speaker": "「灰眸」",
                    "text": "那并不是具备效率的做法，稍等…附近检测到可用「造物蓝图」…"
                },
                {
                    "id": "70111704",
                    "speaker": "「灰眸」",
                    "text": "可以利用那个更快地清理眼前的坚冰。"
                }
            ]
        },
        {
            "id": "701118",
            "objective": "利用「臻冰造物」取得「造物蓝图」",
            "dialogues": []
        },
        {
            "id": "701134",
            "objective": "寻找出去的道路",
            "dialogues": []
        },
        {
            "id": "701120",
            "objective": "寻找出去的道路",
            "dialogues": []
        },
        {
            "id": "701121",
            "objective": "寻找出去的道路",
            "dialogues": [
                {
                    "id": "70112101",
                    "speaker": "「灰眸」",
                    "text": "检索到「克什尼克晶矿」，建议进行采集…"
                },
                {
                    "id": "70112102",
                    "speaker": "「灰眸」",
                    "text": "刚才的造物就是利用了「克什尼克晶矿」的性质，才能如此高效地进行供暖。"
                },
                {
                    "id": "70112103",
                    "speaker": "「灰眸」",
                    "text": "只可惜临时的「臻冰造物」维持时间太短，无法在开拓时期保持稳定，正因为这个，才开放了「克什尼克晶矿」的使用权。"
                },
                {
                    "id": "70112104",
                    "speaker": "「灰眸」",
                    "text": "…不过我已经忘了，「暖和」是什么感觉了。"
                },
                {
                    "id": "70112105",
                    "speaker": "Player",
                    "text": "或许等拿回身体…"
                },
                {
                    "id": "70112106",
                    "speaker": "「灰眸」",
                    "text": "是的，说不定到时候就能和您一起在炉边烤火了。"
                },
                {
                    "id": "70112107",
                    "speaker": "「灰眸」",
                    "text": "……"
                },
                {
                    "id": "70112108",
                    "speaker": "「灰眸」",
                    "text": "总之，收集克什尼克晶矿，我就可以提取其中的能量，维持您体表的温度，现在，记住这个就好。"
                }
            ]
        },
