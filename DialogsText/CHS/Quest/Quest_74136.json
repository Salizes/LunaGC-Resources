    "talks": [
        {
            "id": "7413612",
            "objective": "前往纳克的藏身之处",
            "dialogues": []
        },
        {
            "id": "7413601",
            "objective": "前往纳克的藏身之处",
            "dialogues": []
        },
        {
            "id": "7413602",
            "objective": "打开密闭门",
            "dialogues": []
        },
        {
            "id": "7413603",
            "objective": "继续寻找纳克",
            "dialogues": []
        },
        {
            "id": "7413604",
            "objective": "与肖西韦尔对话",
            "dialogues": [
                {
                    "id": "741360401",
                    "speaker": "派蒙",
                    "text": "原来他之前一直重复着「五」，是为了告诉我们解谜的方式啊…"
                },
                {
                    "id": "741360402",
                    "speaker": "派蒙",
                    "text": "明明直接告诉我们就好了，为什么要这么别扭呢？"
                },
                {
                    "id": "741360403",
                    "speaker": "肖西韦尔",
                    "text": "哼，谁知道这家伙在打什么鬼主意…不过，他好像一直在引着我们去找纳克。"
                },
                {
                    "id": "741360404",
                    "speaker": "肖西韦尔",
                    "text": "这些潜水服，就放在那间屋子旁边，简直就像是专门为我们准备的。",
                    "choices": [
                        {
                            "id": "741360405",
                            "text": "看来，是他找到了我们。",
                            "response": [
                                {
                                    "id": "741360407",
                                    "speaker": "菲希里耶",
                                    "text": "没有研究价值…我…我花了那么多心思…"
                                },
                                {
                                    "id": "741360408",
                                    "speaker": "派蒙",
                                    "text": "菲希里耶小姐…碎碎念了一路呢…"
                                },
                                {
                                    "id": "741360409",
                                    "speaker": "派蒙",
                                    "text": "#不过…{NICKNAME}，你有没有一种被人盯着的感觉？我、我总觉得背后毛毛的…"
                                },
                                {
                                    "id": "741360410",
                                    "speaker": "肖西韦尔",
                                    "text": "…我走第一个，继续往里面探一探吧。"
                                }
                            ]
                        },
                        {
                            "id": "741360406",
                            "text": "无论如何，先处理纳克。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413605",
            "objective": "继续寻找纳克",
            "dialogues": []
        },
        {
            "id": "7413606",
            "objective": "与肖西韦尔对话",
            "dialogues": [
                {
                    "id": "741360601",
                    "speaker": "派蒙",
                    "text": "好大一片空地，里面…什么也没有。我们不会扑了个空吧？"
                },
                {
                    "id": "741360602",
                    "speaker": "肖西韦尔",
                    "text": "这周围的植物被特意清理过，修剪的痕迹还很新。"
                },
                {
                    "id": "741360603",
                    "speaker": "菲希里耶",
                    "text": "…亏我还专门为他趟这摊浑水…"
                },
                {
                    "id": "741360604",
                    "speaker": "肖西韦尔",
                    "text": "总之，我先一个人下去看看，你们陪着科学院小姐，如果情势太坏…就赶紧带她走。"
                },
                {
                    "id": "741360605",
                    "speaker": "肖西韦尔",
                    "text": "但这里什么东西也没有，情势再坏应该也坏不到哪里…"
                },
                {
                    "id": "741360606",
                    "speaker": "？？？",
                    "text": "吱——嘎嘎——"
                },
                {
                    "id": "741360607",
                    "speaker": "派蒙",
                    "text": "呜哇！小心那边！有东西冲过来了！"
                }
            ]
        },
        {
            "id": "7413607",
            "objective": "打倒来袭的机关",
            "dialogues": []
        },
        {
            "id": "7413608",
            "objective": "击败纳克",
            "dialogues": []
        },
        {
            "id": "7413609",
            "objective": "与纳克对话",
            "dialogues": [
                {
                    "id": "741360901",
                    "speaker": "纳克",
                    "text": "科学院的走狗！舒瓦瑟尔和雷蒙多给了你们多少钱！",
                    "choices": [
                        {
                            "id": "741360902",
                            "text": "就给了一个头衔。",
                            "response": [
                                {
                                    "id": "741360904",
                                    "speaker": "纳克",
                                    "text": "你…你…听我的，放开我，我的这台「场力发生装置」已经快完成了。"
                                },
                                {
                                    "id": "741360905",
                                    "speaker": "纳克",
                                    "text": "只要我能把始基动能核心和它联调成功，那…那我就是最伟大的动能工程师！"
                                },
                                {
                                    "id": "741360906",
                                    "speaker": "菲希里耶",
                                    "text": "…拿着别人的成果，还要成为最伟大的工程师。真是够无耻的。"
                                },
                                {
                                    "id": "741360907",
                                    "speaker": "菲希里耶",
                                    "text": "我总算知道，为什么当初艾德温前…先生，一直不愿意让你参与核心研究了。"
                                },
                                {
                                    "id": "741360908",
                                    "speaker": "纳克",
                                    "text": "艾德温根本不明白这东西的用处！你也是科学院的人…你知道这东西的价值。"
                                },
                                {
                                    "id": "741360909",
                                    "speaker": "纳克",
                                    "text": "帮帮我，我可以…可以和你一起开发，到时候，没有人能比我们的名气更高！"
                                },
                                {
                                    "id": "741360910",
                                    "speaker": "纳克",
                                    "text": "什么艾德温、雷蒙多、舒瓦瑟尔…没人能再压我们一头！",
                                    "choices": [
                                        {
                                            "id": "741360911",
                                            "text": "看来，雷蒙多的话是真的。",
                                            "response": [
                                                {
                                                    "id": "741360913",
                                                    "speaker": "菲希里耶",
                                                    "text": "艾德温…先生的成果，属于科学院。我只是前来回收，其余的事…我没兴趣。"
                                                },
                                                {
                                                    "id": "741360914",
                                                    "speaker": "派蒙",
                                                    "text": "菲希里耶小姐…对艾德温的称呼突然变了…"
                                                },
                                                {
                                                    "id": "741360915",
                                                    "speaker": "纳克",
                                                    "text": "别犯蠢了！小姑娘，你不知道孔锡尼先生能给我们多大的好处！"
                                                },
                                                {
                                                    "id": "741360916",
                                                    "speaker": "纳克",
                                                    "text": "这些好处，就算给艾德温跑腿一万年也拿不到！艾德温和科学院只是想利用我们…我们必须要为自己想想！"
                                                },
                                                {
                                                    "id": "741360917",
                                                    "speaker": "菲希里耶",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "741360918",
                                                    "speaker": "肖西韦尔",
                                                    "text": "好，废话结束。你，闭上嘴。"
                                                },
                                                {
                                                    "id": "741360919",
                                                    "speaker": "纳克",
                                                    "text": "你又是谁！"
                                                },
                                                {
                                                    "id": "741360920",
                                                    "speaker": "肖西韦尔",
                                                    "text": "罩着柔灯港这块的人的，你再多说一句，就要吃拳头了。"
                                                },
                                                {
                                                    "id": "741360921",
                                                    "speaker": "肖西韦尔",
                                                    "text": "#{NICKNAME}，帮我捆上他，带上这什么心，我们该回去交差了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741360912",
                                            "text": "之前忍得很辛苦吧，纳克先生。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741360903",
                            "text": "一分钱也没给，我义务劳动。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413610",
            "objective": "回去与勒马克汇合",
            "dialogues": [
                {
                    "id": "741361001",
                    "speaker": "纳克",
                    "text": "艾德温…我就知道！是你把他们引过去…你嫉妒我！担心我的研究成果超越你！"
                },
                {
                    "id": "741361002",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "是啊，我真嫉妒你这副无知又不自知的样子，怪不得你之前在科学院里活得那么好。"
                },
                {
                    "id": "741361003",
                    "speaker": "派蒙",
                    "text": "要是舒瓦瑟尔看见这个场景，一定会昏过去吧…",
                    "choices": [
                        {
                            "id": "741361004",
                            "text": "他最好别醒过来。",
                            "response": [
                                {
                                    "id": "741361006",
                                    "speaker": "艾德温·伊斯丁豪斯",
                                    "text": "你就跟着他们回科学院认错吧，我要继续去研究了…你没弄坏我的研究设备吧？",
                                    "choices": [
                                        {
                                            "id": "741361007",
                                            "text": "谁让你回去研究了？！",
                                            "response": [
                                                {
                                                    "id": "741361009",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "你们还要做什么？难道要把我抓回科学院，那样我还怎么进行研究？"
                                                },
                                                {
                                                    "id": "741361010",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "雷蒙多那个蠢货一定把科学院里变得一团糟，还有舒瓦瑟尔那个白痴，哎哟…想想都头疼。"
                                                },
                                                {
                                                    "id": "741361011",
                                                    "speaker": "派蒙",
                                                    "text": "把科学院变得一团糟的人就是你啊！别推卸责任！"
                                                },
                                                {
                                                    "id": "741361012",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "我？好吧，现在科学院把中央实验室爆炸的责任全甩在我头上了，对吧？我当时都不在科学院里！"
                                                },
                                                {
                                                    "id": "741361013",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "科学院里的蠢货太多了，就连倒杯咖啡都可能让研究设备停机，弄出一场爆炸也不奇怪。"
                                                },
                                                {
                                                    "id": "741361014",
                                                    "speaker": "Player",
                                                    "text": "那你为什么不解释清楚？"
                                                },
                                                {
                                                    "id": "741361015",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "解释？我才不给他们做替罪羊呢。我还有很多研究要做，绝不能浪费时间。"
                                                },
                                                {
                                                    "id": "741361016",
                                                    "speaker": "肖西韦尔",
                                                    "text": "所以，你就和那个叫做孔锡尼的人搅在一起了？"
                                                },
                                                {
                                                    "id": "741361017",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "喔，孔锡尼也好不到哪去…他连一台精密装置都买不到，全都要我自己亲手做。好在他愿意出钱，我的研究还算顺利…"
                                                },
                                                {
                                                    "id": "741361018",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "但没想到，亲爱的纳克先生抱着那台连功能都不完整的核心原型机来了。"
                                                },
                                                {
                                                    "id": "741361019",
                                                    "speaker": "纳克",
                                                    "text": "我已经改造过它了！我用的技术，你绝对开发不出来！"
                                                },
                                                {
                                                    "id": "741361020",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "哈、哈、哈。纳克先生，现在没有孔锡尼需要你讨好，别骗自己了。你连一点研究员的自尊也没有吗？"
                                                },
                                                {
                                                    "id": "741361021",
                                                    "speaker": "纳克",
                                                    "text": "你…！那些不完整的功能，只是因为你不知道如何弥补！我知道，我能做到！"
                                                },
                                                {
                                                    "id": "741361022",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "是啊，现在你就拿着这台垃圾回科学院继续刨食吧，我有更重要的事要忙。那个叫菲什么的…这件事交给你了。"
                                                },
                                                {
                                                    "id": "741361023",
                                                    "speaker": "派蒙",
                                                    "text": "这两个人怎么自顾自地吵个不停…"
                                                },
                                                {
                                                    "id": "741361024",
                                                    "speaker": "菲希里耶",
                                                    "text": "…够了。"
                                                },
                                                {
                                                    "id": "741361025",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "干什么，能不能别浪费我的时间了，我还要继续工作！"
                                                },
                                                {
                                                    "id": "741361026",
                                                    "speaker": "菲希里耶",
                                                    "text": "我说…够了！"
                                                },
                                                {
                                                    "id": "741361027",
                                                    "speaker": "菲希里耶",
                                                    "text": "艾德温·伊斯丁豪斯！你，是科学院爆炸的元凶！"
                                                },
                                                {
                                                    "id": "741361028",
                                                    "speaker": "菲希里耶",
                                                    "text": "纳克！你，盗窃了科学院资产！"
                                                },
                                                {
                                                    "id": "741361029",
                                                    "speaker": "Player",
                                                    "text": "还让科学院又爆炸了一次。"
                                                },
                                                {
                                                    "id": "741361030",
                                                    "speaker": "菲希里耶",
                                                    "text": "你们伤害了科学院的利益…作为枫丹科学院特别调查员，我将把你们全部带回科学院，等待进一步处置！"
                                                },
                                                {
                                                    "id": "741361031",
                                                    "speaker": "纳克",
                                                    "text": "可恶…"
                                                },
                                                {
                                                    "id": "741361032",
                                                    "speaker": "艾德温·伊斯丁豪斯",
                                                    "text": "喔，拜托…"
                                                },
                                                {
                                                    "id": "741361033",
                                                    "speaker": "肖西韦尔",
                                                    "text": "我和勒马克会帮忙押送这两个人的。忙前忙后了这么久…科学院总该给我们点报酬吧。"
                                                },
                                                {
                                                    "id": "741361034",
                                                    "speaker": "肖西韦尔",
                                                    "text": "记住，在路上的时候把嘴闭紧点。不然你们就要提前到达终点了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741361008",
                                            "text": "你给我站住，站好了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741361005",
                            "text": "我也快要昏过去了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413611",
            "objective": "向枫丹科学院回报",
            "dialogues": [
                {
                    "id": "741361101",
                    "speaker": "舒瓦瑟尔",
                    "text": "#菲希里耶小姐！{NICKNAME}，你们回来了！事情一定都办妥…"
                },
                {
                    "id": "741361102",
                    "speaker": "舒瓦瑟尔",
                    "text": "喔，不…"
                },
                {
                    "id": "741361103",
                    "speaker": "派蒙",
                    "text": "呜哇！舒瓦瑟尔先生真的要昏过去啦！"
                },
                {
                    "id": "741361104",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "没想到你又回科学院了，舒瓦瑟尔。我还以为你这辈子就只能和公章打交道了。"
                },
                {
                    "id": "741361105",
                    "speaker": "舒瓦瑟尔",
                    "text": "这…这不可能！天哪！"
                },
                {
                    "id": "741361106",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "雷蒙多，接任我工作的感觉如何，有什么值得向我汇报的工作吗？"
                },
                {
                    "id": "741361107",
                    "speaker": "雷蒙多",
                    "text": "…真是一场美妙的再会啊，艾德温先生。"
                },
                {
                    "id": "741361108",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "哈！瞧瞧这周围，你确实很适合做打扫工作。"
                },
                {
                    "id": "741361109",
                    "speaker": "纳克",
                    "text": "…哼。他打扫得也不干净。"
                },
                {
                    "id": "741361110",
                    "speaker": "Player",
                    "text": "主要是没把你打扫出去。"
                },
                {
                    "id": "741361111",
                    "speaker": "雷蒙多",
                    "text": "#非常感谢你们将这两个人带回来，荣誉高级研究员{NICKNAME}，还有菲希里耶小姐。"
                },
                {
                    "id": "741361112",
                    "speaker": "雷蒙多",
                    "text": "枫丹科学院的霉运和动乱，将在今天彻底画上休止符。"
                },
                {
                    "id": "741361113",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "哈哈哈，好啊，枫丹科学院将陷入一片死气沉沉的寂静，从此再无灵感跃动。"
                },
                {
                    "id": "741361114",
                    "speaker": "雷蒙多",
                    "text": "你已经带着枫丹科学院内所有的灵感跃动得够精彩了，也该让一切平静下来了。"
                },
                {
                    "id": "741361115",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "雷蒙多·哈文博特，你根本就不懂研究，领导不了枫丹动能工程科学院。"
                },
                {
                    "id": "741361116",
                    "speaker": "雷蒙多",
                    "text": "但我懂如何在枫丹动能工程科学院里正确且正常地工作，艾德温·伊斯丁豪斯。"
                },
                {
                    "id": "741361117",
                    "speaker": "雷蒙多",
                    "text": "你现在要做的，就是离研究和始基矿远一些，这样对所有人都好。"
                },
                {
                    "id": "741361118",
                    "speaker": "Black Screen",
                    "text": "在一段时间后，执律庭的人赶到并带走了纳克与艾德温。谢天谢地，他们总算彻底离开枫丹科学院了…"
                },
                {
                    "id": "741361119",
                    "speaker": "舒瓦瑟尔",
                    "text": "谢天谢地，我的噩梦总算彻彻底底地醒了…"
                },
                {
                    "id": "741361120",
                    "speaker": "舒瓦瑟尔",
                    "text": "肖西韦尔先生和勒马克先生，对吧？我已经听人提起过你们对我院工作的协助。相应的谢礼正在安排，请你们在这里稍作休憩。"
                },
                {
                    "id": "741361121",
                    "speaker": "肖西韦尔",
                    "text": "哈哈哈，我还真没想到，我这种人也能和科学院搭上关系。"
                },
                {
                    "id": "741361122",
                    "speaker": "舒瓦瑟尔",
                    "text": "别这么说自己！亲爱的先生，您既真诚，又有热心肠，绝对是个好人！说不定以后我们还会请您来帮忙啊。"
                },
                {
                    "id": "741361123",
                    "speaker": "舒瓦瑟尔",
                    "text": "而您…荣誉高级研究员，您又帮了科学院一个大忙，到底该如何感谢您呢？",
                    "choices": [
                        {
                            "id": "741361124",
                            "text": "别再弄出爆炸就行。",
                            "response": [
                                {
                                    "id": "741361128",
                                    "speaker": "派蒙",
                                    "text": "欸，说起来…菲希里耶小姐呢？"
                                },
                                {
                                    "id": "741361129",
                                    "speaker": "雷蒙多",
                                    "text": "…先让这位小姐自己冷静一下吧。看来，她幻想中的艾德温·伊斯丁豪斯，总算破灭了。"
                                },
                                {
                                    "id": "741361130",
                                    "speaker": "雷蒙多",
                                    "text": "艾德温和纳克也需要冷静一下…希望他们早日认清自己。"
                                },
                                {
                                    "id": "741361131",
                                    "speaker": "Player",
                                    "text": "他们会在梅洛彼得堡待一辈子吗？"
                                },
                                {
                                    "id": "741361132",
                                    "speaker": "雷蒙多",
                                    "text": "就他们的危险性来说，我希望他们永远也不要离开那里。"
                                },
                                {
                                    "id": "741361133",
                                    "speaker": "雷蒙多",
                                    "text": "但就枫丹科学院如今的情况来说…唉，希望我不要遇见那种非启用他们不可的事务…"
                                },
                                {
                                    "id": "741361134",
                                    "speaker": "雷蒙多",
                                    "text": "再次代表枫丹科学院感谢您，荣誉高级研究员。如果你还有什么想问的…我愿意再和您聊聊。"
                                }
                            ]
                        },
                        {
                            "id": "741361125",
                            "text": "能不能给我再升级一下头衔？",
                            "response": [
                                {
                                    "id": "741361126",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "唔，理论上您的这个头衔就已经是顶级了…但我可以尝试为您申请一下特别头衔。"
                                },
                                {
                                    "id": "741361127",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "比如，首席荣誉高级研究员？哈哈哈哈！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413634",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741363401",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "你怎么…你果然回来了，瞧瞧，我就知道你们找五圈也找不到。"
                },
                {
                    "id": "741363402",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "实在不行，坐下来喝杯茶吧，我刚好买了五个茶杯…和几个碗。"
                },
                {
                    "id": "741363403",
                    "speaker": "勒马克",
                    "text": "您真的很喜欢五这个数字，艾德温先生。"
                },
                {
                    "id": "741363404",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "喔，这可是一个具有神奇魔力的数字，只要使用恰当，就能打开灵感的大门啊。"
                },
                {
                    "id": "741363405",
                    "speaker": "艾德温·伊斯丁豪斯",
                    "text": "顺便一提，灵感的大门一共有五扇，你至少要拧五次门把手…五！知道吗？五次！"
                },
                {
                    "id": "741363406",
                    "speaker": "勒马克",
                    "text": "抱歉，我现在真的很想给您五拳，请您捂紧自己的嘴，好吗？"
                }
            ]
        },
        {
            "id": "7413699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741369917",
                    "speaker": "肖西韦尔",
                    "text": "那混账就在上面！逮住他！"
                },
                {
                    "id": "741369918",
                    "speaker": "纳克",
                    "text": "可恶！可恶！滚开！就差最后一步…差最后一步！"
                },
                {
                    "id": "741369919",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！快上呀！抓住这个大骗子！坏蛋！谎话精！科学院里最…"
                },
                {
                    "id": "741369920",
                    "speaker": "派蒙",
                    "text": "嗯…第…第三招人嫌的人！"
                }
            ]
        }
    ]
}