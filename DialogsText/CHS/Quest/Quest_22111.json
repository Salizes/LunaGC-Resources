    "talks": [
        {
            "id": "2211101",
            "objective": "在蒙德城与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "221110101",
                    "speaker": "凯瑟琳",
                    "text": "关于新的委托…"
                },
                {
                    "id": "221110102",
                    "speaker": "凯瑟琳",
                    "text": "你好，冒险家。你的冒险事迹，已经在蒙德广为人知了。"
                },
                {
                    "id": "221110103",
                    "speaker": "凯瑟琳",
                    "text": "以这样的势头接着努力，你一定会成为一个伟大的冒险家。",
                    "choices": [
                        {
                            "id": "221110104",
                            "text": "有什么事吗？",
                            "response": [
                                {
                                    "id": "221110105",
                                    "speaker": "凯瑟琳",
                                    "text": "如果想要成为一个伟大的冒险家，那你可不能只在熟悉的地方冒险。"
                                },
                                {
                                    "id": "221110106",
                                    "speaker": "凯瑟琳",
                                    "text": "既然你已经有了如此充足的冒险经验，要不要试试去别的地方探索一番？"
                                },
                                {
                                    "id": "221110110",
                                    "speaker": "凯瑟琳",
                                    "text": "请拿好这封信，把它带给璃月港的凯瑟琳小姐吧。",
                                    "choices": [
                                        {
                                            "id": "221110111",
                                            "text": "璃月港的…凯瑟琳？",
                                            "response": [
                                                {
                                                    "id": "221110112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "是的，您会很容易就找到她的。"
                                                },
                                                {
                                                    "id": "221110115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "有了这封信，她也会像我一样，为您的各种冒险活动提供最专业的服务。"
                                                },
                                                {
                                                    "id": "221110116",
                                                    "speaker": "凯瑟琳",
                                                    "text": "如果您再回到蒙德城，我也会继续为您提供服务，请尽管放心。"
                                                },
                                                {
                                                    "id": "221110117",
                                                    "speaker": "凯瑟琳",
                                                    "text": "对了，还请您不要随意拆开这封信，不然说不定会遗落掉什么东西，造成不必要的麻烦。"
                                                },
                                                {
                                                    "id": "221110118",
                                                    "speaker": "凯瑟琳",
                                                    "text": "向着星辰与深渊，请您大步向前吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "221110113",
                                            "text": "那以后要叫你「蒙德城的凯瑟琳」了？",
                                            "response": [
                                                {
                                                    "id": "221110114",
                                                    "speaker": "凯瑟琳",
                                                    "text": "您大可选择一个便于您开展冒险活动的称呼。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "221110107",
                            "text": "只是在蒙德…",
                            "response": [
                                {
                                    "id": "221110108",
                                    "speaker": "凯瑟琳",
                                    "text": "因为到目前为止，你也只是在蒙德周围展开冒险呢。"
                                },
                                {
                                    "id": "221110109",
                                    "speaker": "凯瑟琳",
                                    "text": "不过，你很快就能向更外面的世界迈进了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2211102",
            "objective": "在璃月港与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "221110201",
                    "speaker": "凯瑟琳",
                    "text": "有一封信给你。"
                },
                {
                    "id": "221110202",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                },
                {
                    "id": "221110203",
                    "speaker": "Player",
                    "text": "这封信应该是给你的…"
                },
                {
                    "id": "221110204",
                    "speaker": "凯瑟琳",
                    "text": "信？让我看看，唔…您是从蒙德来的冒险家啊。"
                },
                {
                    "id": "221110205",
                    "speaker": "凯瑟琳",
                    "text": "咦？这是…蒲公英？信里为什么会夹这种东西。"
                },
                {
                    "id": "221110206",
                    "speaker": "凯瑟琳",
                    "text": ""
                },
                {
                    "id": "221110207",
                    "speaker": "凯瑟琳",
                    "text": "您多虑了，这封信里的信息已经足够证明您的身份和来历了。",
                    "choices": [
                        {
                            "id": "221110208",
                            "text": "不是我。",
                            "response": [
                                {
                                    "id": "221110209",
                                    "speaker": "凯瑟琳",
                                    "text": "不过，这并不是什么重要的事，不用在意。"
                                },
                                {
                                    "id": "221110214",
                                    "speaker": "凯瑟琳",
                                    "text": "从蒙德冒险家协会的信上看，您已经是个经验丰富的冒险家了。"
                                },
                                {
                                    "id": "221110215",
                                    "speaker": "凯瑟琳",
                                    "text": "那么想必您也准备好，面对璃月冒险家协会的各类委托了。"
                                },
                                {
                                    "id": "221110216",
                                    "speaker": "凯瑟琳",
                                    "text": "向着星辰与深渊，崭新的伟大冒险正在等着您！"
                                }
                            ]
                        },
                        {
                            "id": "221110210",
                            "text": "难道是凯瑟琳…",
                            "response": [
                                {
                                    "id": "221110211",
                                    "speaker": "凯瑟琳",
                                    "text": "凯瑟琳？喔，您说的是「蒙德城的凯瑟琳」吧。"
                                },
                                {
                                    "id": "221110212",
                                    "speaker": "凯瑟琳",
                                    "text": "她为什么要在里面夹蒲公英呢？真奇怪…蒲公英对冒险可没什么帮助。"
                                },
                                {
                                    "id": "221110213",
                                    "speaker": "凯瑟琳",
                                    "text": "不过，这并不是什么重要的事，不用在意。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}