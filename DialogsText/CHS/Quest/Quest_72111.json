    "talks": [
        {
            "id": "7211104",
            "objective": "",
            "dialogues": [
                {
                    "id": "721110101",
                    "speaker": "绀田传助",
                    "text": "有什么事吗？这位年轻人。"
                },
                {
                    "id": "721110102",
                    "speaker": "Player",
                    "text": "我们找到证据了。"
                },
                {
                    "id": "721110103",
                    "speaker": "绀田传助",
                    "text": "「证据」？什么证据，属实不知所谓。"
                },
                {
                    "id": "721110104",
                    "speaker": "派蒙",
                    "text": "关于村里的怪事，爷爷不要狡辩了。"
                },
                {
                    "id": "721110105",
                    "speaker": "绀田传助",
                    "text": "笑话，我们村哪能有什么怪事。好啊，有什么证据就拿出来吧。"
                },
                {
                    "id": "721110106",
                    "speaker": "派蒙",
                    "text": "#（喂，{NICKNAME}，就从井边找到的东西开始吧。交给你啦！）"
                },
                {
                    "id": "721110107",
                    "speaker": "Player",
                    "text": "这是从后院枯井捡到的。"
                }
            ]
        },
        {
            "id": "7211105",
            "objective": "",
            "dialogues": [
                {
                    "id": "721110201",
                    "speaker": "绀田传助",
                    "text": "装摩拉的袋子？"
                },
                {
                    "id": "721110202",
                    "speaker": "绀田传助",
                    "text": "这…"
                },
                {
                    "id": "721110203",
                    "speaker": "绀田传助",
                    "text": "…这就是我们家的东西。没有什么可疑的。没错，很正常。"
                },
                {
                    "id": "721110204",
                    "speaker": "派蒙",
                    "text": "好可疑！绝对有问题！",
                    "choices": [
                        {
                            "id": "721110205",
                            "text": "请你画出上面的标记。",
                            "response": [
                                {
                                    "id": "721110210",
                                    "speaker": "绀田传助",
                                    "text": "……"
                                },
                                {
                                    "id": "721110211",
                                    "speaker": "绀田传助",
                                    "text": "好吧。这的确不是我的钱袋。"
                                },
                                {
                                    "id": "721110212",
                                    "speaker": "绀田传助",
                                    "text": "我家后院人来人往的，有谁落下了什么东西也很正常。"
                                },
                                {
                                    "id": "721110213",
                                    "speaker": "绀田传助",
                                    "text": "这是…"
                                },
                                {
                                    "id": "721110214",
                                    "speaker": "Player",
                                    "text": "这是怎么回事？"
                                },
                                {
                                    "id": "721110215",
                                    "speaker": "绀田传助",
                                    "text": "唉！还是你们机灵，本来我鬼迷心窍，想私吞你们手里的钱袋！"
                                },
                                {
                                    "id": "721110216",
                                    "speaker": "绀田传助",
                                    "text": "一把年纪了，传助啊传助，怎么能动这种歪脑筋呢！",
                                    "choices": [
                                        {
                                            "id": "721110217",
                                            "text": "不对。",
                                            "response": [
                                                {
                                                    "id": "721110219",
                                                    "speaker": "绀田传助",
                                                    "text": "我、我都承认自己想私吞这笔钱了，还能有什么问题？"
                                                },
                                                {
                                                    "id": "721110220",
                                                    "speaker": "绀田传助",
                                                    "text": "我这就把钱袋交给官府。"
                                                },
                                                {
                                                    "id": "721110221",
                                                    "speaker": "派蒙",
                                                    "text": "感觉不太对劲…",
                                                    "choices": [
                                                        {
                                                            "id": "721110222",
                                                            "text": "钱袋是被人刻意遗弃的。",
                                                            "response": [
                                                                {
                                                                    "id": "721110227",
                                                                    "speaker": "绀田传助",
                                                                    "text": "你、你这样说，可有什么证据吗？"
                                                                },
                                                                {
                                                                    "id": "721110228",
                                                                    "speaker": "派蒙",
                                                                    "text": "钱袋只是其中的一部分。我们还找到了…"
                                                                },
                                                                {
                                                                    "id": "721110229",
                                                                    "speaker": "派蒙",
                                                                    "text": "#…找到了什么来着？唔嗯，交给你了，{NICKNAME}！"
                                                                },
                                                                {
                                                                    "id": "721110230",
                                                                    "speaker": "派蒙",
                                                                    "text": "#（{NICKNAME}，我们之前在水渠里发现了什么来着…？）"
                                                                },
                                                                {
                                                                    "id": "721110231",
                                                                    "speaker": "Player",
                                                                    "text": "这就是想趁着雨夜丢掉的…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721110223",
                                                            "text": "没什么，是派蒙想多了。",
                                                            "response": [
                                                                {
                                                                    "id": "721110224",
                                                                    "speaker": "派蒙",
                                                                    "text": "#（不对吧！{NICKNAME}，传助爷爷真的只是想要这笔摩拉吗？）"
                                                                },
                                                                {
                                                                    "id": "721110225",
                                                                    "speaker": "派蒙",
                                                                    "text": "（他是在隐瞒什么别的事情吧？）"
                                                                },
                                                                {
                                                                    "id": "721110226",
                                                                    "speaker": "Player",
                                                                    "text": "钱袋是被人刻意遗弃的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721110218",
                                            "text": "你在隐瞒别的事情…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721110206",
                            "text": "请你说出里面的摩拉数量。",
                            "response": [
                                {
                                    "id": "721110207",
                                    "speaker": "绀田传助",
                                    "text": "哈哈哈，你这叫什么问题。"
                                },
                                {
                                    "id": "721110208",
                                    "speaker": "绀田传助",
                                    "text": "不打开行囊确认，你也不知道现在自己的包里有多少摩拉吧？"
                                },
                                {
                                    "id": "721110209",
                                    "speaker": "Player",
                                    "text": "请你画出上面的标记。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211106",
            "objective": "",
            "dialogues": [
                {
                    "id": "721110301",
                    "speaker": "绀田传助",
                    "text": "这个是…咳，你又是从哪里捡到的？",
                    "choices": [
                        {
                            "id": "721110302",
                            "text": "沟渠的下游。",
                            "response": [
                                {
                                    "id": "721110303",
                                    "speaker": "绀田传助",
                                    "text": "……"
                                },
                                {
                                    "id": "721110306",
                                    "speaker": "绀田传助",
                                    "text": "总之，你也没有证据证明 ，这两件东西之间有什么关联。"
                                },
                                {
                                    "id": "721110307",
                                    "speaker": "派蒙",
                                    "text": "关联是有的。"
                                },
                                {
                                    "id": "721110308",
                                    "speaker": "绀田传助",
                                    "text": "莫名其妙，这能有什么关联？"
                                },
                                {
                                    "id": "721110309",
                                    "speaker": "绀田传助",
                                    "text": "摩拉上，难不成还能有什么暗号？"
                                },
                                {
                                    "id": "721110310",
                                    "speaker": "派蒙",
                                    "text": "摩拉上确实没有，但别的地方有。"
                                },
                                {
                                    "id": "721110311",
                                    "speaker": "Player",
                                    "text": "那就是我们在货车残骸附近找到的…"
                                }
                            ]
                        },
                        {
                            "id": "721110304",
                            "text": "在村口的树梢上捡到的。",
                            "response": [
                                {
                                    "id": "721110305",
                                    "speaker": "绀田传助",
                                    "text": "这怎么可能…你这样试探我是没用的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211108",
            "objective": "",
            "dialogues": [
                {
                    "id": "721110801",
                    "speaker": "Player",
                    "text": "这是从后院枯井捡到的。"
                }
            ]
        },
        {
            "id": "7211107",
            "objective": "",
            "dialogues": [
                {
                    "id": "721110701",
                    "speaker": "绀田传助",
                    "text": "这是…这是…"
                },
                {
                    "id": "721110702",
                    "speaker": "绀田传助",
                    "text": "居然疏忽了，破坏货车的时候…"
                },
                {
                    "id": "721110703",
                    "speaker": "派蒙",
                    "text": "哇，承认了！"
                },
                {
                    "id": "721110704",
                    "speaker": "绀田传助",
                    "text": "没办法了，你都调查到这个份上了，我再瞒也瞒不下去。"
                },
                {
                    "id": "721110705",
                    "speaker": "绀田传助",
                    "text": "事情你差不多也清楚了吧。"
                },
                {
                    "id": "721110706",
                    "speaker": "派蒙",
                    "text": "非常清楚了！传助爷爷，你竟然…"
                },
                {
                    "id": "721110707",
                    "speaker": "派蒙",
                    "text": "抢劫了官府的镖车。在争抢中，你一拳把货车打碎，结果货物袋飞走了，掉进了水渠里。"
                },
                {
                    "id": "721110708",
                    "speaker": "派蒙",
                    "text": "幕府的人为了保住性命，把钱袋往水井里丢，吸引你的注意力！为了防止钱被人捡走，你把井口锁起来了！"
                },
                {
                    "id": "721110709",
                    "speaker": "派蒙",
                    "text": "是这样对吧？"
                },
                {
                    "id": "721110710",
                    "speaker": "绀田传助",
                    "text": "啊？不对，不是这样的！"
                },
                {
                    "id": "721110711",
                    "speaker": "派蒙",
                    "text": "居然不是吗！我还想跟你拿来钥匙，去把井底的摩拉…"
                },
                {
                    "id": "721110712",
                    "speaker": "派蒙",
                    "text": "…交还给幕府的大人们！没错！当然是还给官府！"
                },
                {
                    "id": "721110713",
                    "speaker": "绀田传助",
                    "text": "唉，事情是这样的…"
                },
                {
                    "id": "721110714",
                    "speaker": "绀田传助",
                    "text": "村里本来有一群年轻人，酒后胆子大，竟然劫了幕府的运车。这货物和袋子，都是幕府的东西。"
                },
                {
                    "id": "721110715",
                    "speaker": "绀田传助",
                    "text": "我想着村丑不可外扬，才出力帮他们隐瞒下来。"
                },
                {
                    "id": "721110716",
                    "speaker": "派蒙",
                    "text": "那承认自己私吞钱袋的事情…"
                },
                {
                    "id": "721110717",
                    "speaker": "Player",
                    "text": "是为了隐瞒事情的真相吧。"
                },
                {
                    "id": "721110718",
                    "speaker": "绀田传助",
                    "text": "没错。本来我寻思，只要我这么做，你们就会不追究下去…"
                },
                {
                    "id": "721110719",
                    "speaker": "绀田传助",
                    "text": "如果只有我一个人的话…只要不波及别人…"
                },
                {
                    "id": "721110720",
                    "speaker": "绀田传助",
                    "text": "拜托了，请你不要向幕府告发。这不是我面子的问题。我是怕我们整个村子，都会因此受到牵连。",
                    "choices": [
                        {
                            "id": "721110721",
                            "text": "我没有告发的兴趣…",
                            "response": [
                                {
                                    "id": "721110722",
                                    "speaker": "派蒙",
                                    "text": "是呀，我们不是为了这件事来的。"
                                },
                                {
                                    "id": "721110723",
                                    "speaker": "绀田传助",
                                    "text": "那就好，那就好。"
                                },
                                {
                                    "id": "721110727",
                                    "speaker": "绀田传助",
                                    "text": "因为做这样的事情，让我良心实在不安，所以我把事情记下来了。"
                                },
                                {
                                    "id": "721110728",
                                    "speaker": "绀田传助",
                                    "text": "笔记我扔房顶上了。如果你真想读，就自己去找吧，年轻人。不过，可别把我最近才新修的房顶踩坏喽。"
                                },
                                {
                                    "id": "721110729",
                                    "speaker": "Player",
                                    "text": "关于井口的锁…"
                                },
                                {
                                    "id": "721110730",
                                    "speaker": "绀田传助",
                                    "text": "是的，是我把井口锁上了。藏钥匙的地方，我也记在笔记里了，自己去看吧。"
                                },
                                {
                                    "id": "721110731",
                                    "speaker": "派蒙",
                                    "text": "关于绀田村的「结界」，传助爷爷知道什么吗？"
                                },
                                {
                                    "id": "721110732",
                                    "speaker": "绀田传助",
                                    "text": "「结界」？哎呀，这么久远的传说，现在还有人知道吗…"
                                },
                                {
                                    "id": "721110733",
                                    "speaker": "绀田传助",
                                    "text": "据说在古时，我们脚下的地底有雷樱的根，是守护鸣神岛平安的五段树根之一。"
                                },
                                {
                                    "id": "721110734",
                                    "speaker": "绀田传助",
                                    "text": "而守护它与它的结界，就是「狐斋宫大人」交给我们绀田一族的职责。"
                                },
                                {
                                    "id": "721110735",
                                    "speaker": "绀田传助",
                                    "text": "但这事已经太久远了，详情我已经不清楚啦。"
                                }
                            ]
                        },
                        {
                            "id": "721110724",
                            "text": "我只是想调查真相…",
                            "response": [
                                {
                                    "id": "721110725",
                                    "speaker": "派蒙",
                                    "text": "是呀，我们不是为了这件事来的。"
                                },
                                {
                                    "id": "721110726",
                                    "speaker": "绀田传助",
                                    "text": "调查真相？呵呵…现在的年轻人，倒也挺有趣的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721110401",
                    "speaker": "绀田传助",
                    "text": "这是什么？我可看不明白。"
                },
                {
                    "id": "721110402",
                    "speaker": "绀田传助",
                    "text": "年轻人，不要随便拿些东西，就来糊弄我这个老头子啊。"
                },
