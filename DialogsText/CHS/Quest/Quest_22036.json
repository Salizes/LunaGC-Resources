        {
            "id": "2203605",
            "objective": "与绀田传助对话",
            "dialogues": [
                {
                    "id": "220360501",
                    "speaker": "绀田传助",
                    "text": "年轻人，我们又见面了，这回又是来打听什么的？",
                    "choices": [
                        {
                            "id": "220360502",
                            "text": "不是来打听的。",
                            "response": [
                                {
                                    "id": "220360504",
                                    "speaker": "绀田传助",
                                    "text": "哦哦，是瓦希德让你来的吧。"
                                },
                                {
                                    "id": "220360505",
                                    "speaker": "绀田传助",
                                    "text": "我听说离岛有一家新奇的肥料店，所以就跟店主瓦希德先生打了招呼，想试一试他家的肥料。"
                                },
                                {
                                    "id": "220360506",
                                    "speaker": "绀田传助",
                                    "text": "有用的话，庄稼也能增产不少，振兴绀田村就有希望了。"
                                },
                                {
                                    "id": "220360507",
                                    "speaker": "绀田传助",
                                    "text": "呵，振兴村子还得靠我这把老骨头，村里那些年轻人…哼！不能指望啊。"
                                },
                                {
                                    "id": "220360508",
                                    "speaker": "绀田传助",
                                    "text": "好了，你快跟我说说，这肥料该怎么用啊？",
                                    "choices": [
                                        {
                                            "id": "220360509",
                                            "text": "先加清水，再加碎叶，最后搅拌。",
                                            "response": [
                                                {
                                                    "id": "220360512",
                                                    "speaker": "绀田传助",
                                                    "text": "这肥料怎么这么多讲究…好，我记住了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220360510",
                                            "text": "先加碎叶，再搅拌，最后加清水。"
                                        },
                                        {
                                            "id": "220360511",
                                            "text": "先加碎叶，再加清水，最后搅拌。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220360503",
                            "text": "是来讲解肥料施用方法的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203606",
            "objective": "（test)配方选择结果判断-正确$HIDDEN",
            "dialogues": [
                {
                    "id": "220360601",
                    "speaker": "绀田传助",
                    "text": "不过上次瓦希德也是这么说的，应该没错，我就等着庄稼长起来了。"
                }
            ]
        },
        {
            "id": "2203607",
            "objective": "（test)配方选择结果判断-错误$HIDDEN",
            "dialogues": [
                {
                    "id": "220360701",
                    "speaker": "绀田传助",
                    "text": "不过总感觉不大对劲啊，瓦希德上次好像不是这么说的，不会出问题吧…"
                }
            ]
        }
