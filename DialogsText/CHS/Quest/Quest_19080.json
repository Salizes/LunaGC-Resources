            "dialogues": [
                {
                    "id": "190730902",
                    "speaker": "「卡布斯」",
                    "text": "你怎么擅自回来了？"
                },
                {
                    "id": "190730901",
                    "speaker": "「贡达法」",
                    "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"
                }
            ]
        },
        {
            "id": "1908021",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190802157",
                    "speaker": "「白老先生」",
                    "text": "反面。"
                }
            ]
        },
        {
            "id": "1908025",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190802501",
                    "speaker": "凯亚",
                    "text": "喂喂，你不会信了吧，我像是会把人情记在本上的人吗？"
                }
            ]
        },
        {
            "id": "1908027",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190802701",
                    "speaker": "茶博士刘苏",
                    "text": "可怜英雄寿短，可叹儿女情长。欲知这虬髯公的妹妹命运究竟如何…咱们啊，下回再表。"
                }
            ]
        },
        {
            "id": "1908035",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803501",
                    "speaker": "张大姐",
                    "text": "这骗子真不是东西！"
                },
                {
                    "id": "190803502",
                    "speaker": "光之",
                    "text": "老吴别慌，你要报案我们陪你一块儿去。"
                },
                {
                    "id": "190803503",
                    "speaker": "吴船长",
                    "text": "这钱应该能拿回来吧…应该…"
                }
            ]
        },
        {
            "id": "1908036",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803601",
                    "speaker": "光之",
                    "text": "放心，我有数。"
                },
                {
                    "id": "190803602",
                    "speaker": "张大姐",
                    "text": "是啊，都是街坊邻居，老吴的忙我们肯定帮。"
                }
            ]
        },
        {
            "id": "1908037",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803701",
                    "speaker": "楚仪",
                    "text": "只要规规矩矩喝茶，来即是客，您请。"
                }
            ]
        },
        {
            "id": "1908038",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803801",
                    "speaker": "吴船长",
                    "text": "我老老实实待在这儿是没问题，但…算了，我不打退堂鼓，相信你们两位！"
                }
            ]
        },
        {
            "id": "1908045",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190804501",
                    "speaker": "光之",
                    "text": "这儿有人了。"
                }
            ]
        },
        {
            "id": "1908046",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190804601",
                    "speaker": "张大姐",
                    "text": "这儿有人了。"
                }
            ]
        },
