        },
        {
            "id": "2301812",
            "objective": "与阿兹拉对话",
            "dialogues": [
                {
                    "id": "230181201",
                    "speaker": "阿兹拉",
                    "text": "咦？这是给我的吗？谢谢你…"
                },
                {
                    "id": "230181202",
                    "speaker": "阿兹拉",
                    "text": "好！我要再试一次…这一次要一口气把药吃掉！"
                }
            ]
        },
        {
            "id": "2301813",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230181301",
                    "speaker": "扎卡里亚",
                    "text": "你回来了，一切顺利么？"
                },
                {
                    "id": "230181302",
                    "speaker": "Player",
                    "text": "我给她送了点糖。"
                },
                {
                    "id": "230181303",
                    "speaker": "扎卡里亚",
                    "text": "糖？但是那副药和糖一起吃会降低药效啊。"
                },
                {
                    "id": "230181304",
                    "speaker": "扎卡里亚",
                    "text": "算了，药效低一点就低一点吧，至少她能把药吃完了。"
                },
                {
                    "id": "230181305",
                    "speaker": "扎卡里亚",
                    "text": "真是太感谢你了，这些报酬还请务必收下。"
                }
            ]
        },
        {
            "id": "2301814",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230181401",
                    "speaker": "扎卡里亚",
                    "text": "这次的药是要送给农舍的阿夫塔。"
                },
                {
                    "id": "230181402",
                    "speaker": "扎卡里亚",
                    "text": "这家伙平时吃东西总是大鱼大肉，弄的肠胃很不好。"
                },
                {
                    "id": "230181403",
                    "speaker": "扎卡里亚",
                    "text": "你就把这副药带给他吧，顺便告诉他…呃…"
                },
                {
                    "id": "230181404",
                    "speaker": "扎卡里亚",
                    "text": "饮食清淡，少食酒肉，才能更好地承接草神大人的恩泽。",
                    "choices": [
                        {
                            "id": "230181405",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "230181408",
                                    "speaker": "扎卡里亚",
                                    "text": "送完药就回来找我吧，我会准备好报酬的。"
                                }
                            ]
                        },
                        {
                            "id": "230181406",
                            "text": "你都是从哪听到的这些…",
                            "response": [
                                {
                                    "id": "230181407",
                                    "speaker": "扎卡里亚",
                                    "text": "我听说教令院里确实有学者这么做，我也不知道为什么…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301822",
            "objective": "将药带给阿夫塔",
            "dialogues": [
                {
                    "id": "230182201",
                    "speaker": "阿夫塔",
                    "text": "再坚持几天就好…"
                }
