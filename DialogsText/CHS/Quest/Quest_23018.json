    "talks": [
        {
            "id": "2301801",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230180101",
                    "speaker": "扎卡里亚",
                    "text": "唉，真不让人省心…",
                    "choices": [
                        {
                            "id": "230180102",
                            "text": "有什么要帮忙的吗？",
                            "response": [
                                {
                                    "id": "230180119",
                                    "speaker": "扎卡里亚",
                                    "text": "最近我们的人手实在是不够，我已经连续几天没休息了。"
                                },
                                {
                                    "id": "230180120",
                                    "speaker": "扎卡里亚",
                                    "text": "旅行者，你如果有空的话，可以帮我送药给附近的病人吗？也请一并看看他们的状况。",
                                    "choices": [
                                        {
                                            "id": "230180121",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "230180122",
                                                    "speaker": "扎卡里亚",
                                                    "text": "那就拜托你了，看在草神的份上，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。"
                                                },
                                                {
                                                    "id": "230180123",
                                                    "speaker": "扎卡里亚",
                                                    "text": "哈，看在草神的份上…我念得真熟练。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230180124",
                                            "text": "你还是休息一下吧。",
                                            "response": [
                                                {
                                                    "id": "230180125",
                                                    "speaker": "扎卡里亚",
                                                    "text": "我可休息不得，还有一些更重的病人被我安置在别处了，我还得为他们配药。"
                                                },
                                                {
                                                    "id": "230180126",
                                                    "speaker": "扎卡里亚",
                                                    "text": "唉，那些病人肯定又要问我，他们该用什么方法承接草神的恩泽了。"
                                                },
                                                {
                                                    "id": "230180127",
                                                    "speaker": "扎卡里亚",
                                                    "text": "拜托你了，旅行者，我真的很需要一个不会整天念叨草神保佑的人给我帮忙。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230180103",
                            "text": "这里发生什么事了？",
                            "response": [
                                {
                                    "id": "230180104",
                                    "speaker": "扎卡里亚",
                                    "text": "你是旅行者吧，这里是「健康之家」，是一家为普罗大众…嗯…广布草神恩泽的医院。"
                                },
                                {
                                    "id": "230180105",
                                    "speaker": "扎卡里亚",
                                    "text": "无论贫富，我们都会为需要的人提供医疗帮助。"
                                },
                                {
                                    "id": "230180106",
                                    "speaker": "扎卡里亚",
                                    "text": "不过也拜此所赐…最近来就诊的病人太多，实在有些忙不过来了。"
                                },
                                {
                                    "id": "230180107",
                                    "speaker": "扎卡里亚",
                                    "text": "唉，就算草神对我们的仁慈是无限的…但医院的预算和人力却是有限的啊。"
                                },
                                {
                                    "id": "230180108",
                                    "speaker": "扎卡里亚",
                                    "text": "有一些病人压根不听医嘱，只是一个劲地问我，他该怎么样才能更好地承接草神恩泽。"
                                },
                                {
                                    "id": "230180109",
                                    "speaker": "扎卡里亚",
                                    "text": "哈哈，草神恩泽…看在老天的份上！"
                                },
                                {
                                    "id": "230180110",
                                    "speaker": "扎卡里亚",
                                    "text": "要是草神真的能直接降下恩泽，他们压根就不会得病了！"
                                },
                                {
                                    "id": "230180111",
                                    "speaker": "扎卡里亚",
                                    "text": "…呼，抱歉，我不该说这样的话，你可别告诉戈尔珊，不然她又要开始唠叨了。",
                                    "choices": [
                                        {
                                            "id": "230180112",
                                            "text": "你不是一个虔诚的草神信徒吗？",
                                            "response": [
                                                {
                                                    "id": "230180113",
                                                    "speaker": "扎卡里亚",
                                                    "text": "我确实是，这须弥城里还有谁不是吗？"
                                                },
                                                {
                                                    "id": "230180114",
                                                    "speaker": "扎卡里亚",
                                                    "text": "但你可以把虔诚这两个字换掉，我是一个…相对理性的草神信徒，哈哈。"
                                                },
                                                {
                                                    "id": "230180118",
                                                    "speaker": "扎卡里亚",
                                                    "text": "呃…抱歉，我一定是太累了，这是我个人的一点情绪，你别当真。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230180115",
                                            "text": "有人说治疗本身就是草神恩泽…",
                                            "response": [
                                                {
                                                    "id": "230180116",
                                                    "speaker": "扎卡里亚",
                                                    "text": "唉，这些话你听听就行了，别和那些病人一样把这件事当真。"
                                                },
                                                {
                                                    "id": "230180117",
                                                    "speaker": "扎卡里亚",
                                                    "text": "如果草神真有这么全能，那我就直接给病人吃点蘑菇，他们就能痊愈了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301802",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230180201",
                    "speaker": "扎卡里亚",
                    "text": "这次的药是要送给药田的古尔根。"
                },
                {
                    "id": "230180202",
                    "speaker": "扎卡里亚",
                    "text": "这位老兄前几天工作得太用力，把自己的胳膊给拉伤了。"
                },
                {
                    "id": "230180203",
                    "speaker": "扎卡里亚",
                    "text": "你就把这副药送给他，顺便告诉他，今天在家里向草神大人默祷吧，不要下地干活了。",
                    "choices": [
                        {
                            "id": "230180204",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "230180207",
                                    "speaker": "扎卡里亚",
                                    "text": "送完药就回来找我吧，我会准备好报酬的。"
                                }
                            ]
                        },
                        {
                            "id": "230180205",
                            "text": "向草神大人默祷？",
                            "response": [
                                {
                                    "id": "230180206",
                                    "speaker": "扎卡里亚",
                                    "text": "我不这么说，他怎么可能会听？好了，你就按我说的来做吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301820",
            "objective": "将药带给古尔根",
            "dialogues": [
                {
                    "id": "230182001",
                    "speaker": "扎卡里亚",
                    "text": "送药的事情就拜托了，切记药和医嘱都要送到。"
                }
            ]
        },
        {
            "id": "2301803",
            "objective": "与古尔根对话",
            "dialogues": [
                {
                    "id": "230180301",
                    "speaker": "古尔根",
                    "text": "咦？这个是…"
                },
                {
                    "id": "230180302",
                    "speaker": "Player",
                    "text": "这是你的药，记得在家里向草神大人默祷。"
                },
                {
                    "id": "230180303",
                    "speaker": "古尔根",
                    "text": "欸，多谢你了。向草神大人默祷啊…这确实必须要做…"
                },
                {
                    "id": "230180304",
                    "speaker": "古尔根",
                    "text": "但<color=#00E1FFFF>田里的杂草</color>这么多，再不收拾一下，就要影响收成了。"
                },
                {
                    "id": "230180305",
                    "speaker": "古尔根",
                    "text": "唔…我就先去<color=#00E1FFFF>把杂草处理</color>了，再回去向草神大人默祷吧。"
                }
            ]
        },
        {
            "id": "2301804",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230180401",
                    "speaker": "扎卡里亚",
                    "text": "你回来了，一切顺利么？"
                },
                {
                    "id": "230180402",
                    "speaker": "Player",
                    "text": "他要先去处理杂草…"
                },
                {
                    "id": "230180403",
                    "speaker": "扎卡里亚",
                    "text": "唉，这种说法也不行吗…下次还得换个说法…"
                },
                {
                    "id": "230180404",
                    "speaker": "扎卡里亚",
                    "text": "你也辛苦了，这些报酬就请收下吧。"
                }
            ]
        },
        {
            "id": "2301805",
            "objective": "(test)隐藏清理杂草$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2301806",
            "objective": "与古尔根对话",
            "dialogues": [
                {
                    "id": "230180601",
                    "speaker": "古尔根",
                    "text": "杂草…全都被你清理了？这，这怎么好意思？"
                },
                {
                    "id": "230180602",
                    "speaker": "Player",
                    "text": "你回去好好休息就行。"
                },
                {
                    "id": "230180603",
                    "speaker": "古尔根",
                    "text": "我会的，谢谢，愿草神大人护佑你！"
                },
                {
                    "id": "230180604",
                    "speaker": "古尔根",
                    "text": "我也得快点回去向草神大人默祷了…"
                }
            ]
        },
        {
            "id": "2301807",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230180701",
                    "speaker": "扎卡里亚",
                    "text": "你回来了，一切顺利么？"
                },
                {
                    "id": "230180702",
                    "speaker": "Player",
                    "text": "关于清理杂草…"
                },
                {
                    "id": "230180703",
                    "speaker": "扎卡里亚",
                    "text": "啊，那可真不错。这下古尔根他总能好好休息一下了，病情恢复得也会更快一点吧。"
                },
                {
                    "id": "230180704",
                    "speaker": "扎卡里亚",
                    "text": "真是太感谢你了，这些报酬还请务必收下。"
                }
            ]
        },
        {
            "id": "2301808",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230180801",
                    "speaker": "扎卡里亚",
                    "text": "这次的药是要送给剧场门口的阿兹拉。"
                },
                {
                    "id": "230180802",
                    "speaker": "扎卡里亚",
                    "text": "她最近一直在咳嗽，我给她开了药，但她总说太苦不愿意吃。"
                },
                {
                    "id": "230180803",
                    "speaker": "扎卡里亚",
                    "text": "你帮我把这副药送给她吧，顺便告诉她…呃…"
                },
                {
                    "id": "230180804",
                    "speaker": "扎卡里亚",
                    "text": "这个…苦涩的药物，是草神对她的…那个…考验，对，考验。",
                    "choices": [
                        {
                            "id": "230180805",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "230180808",
                                    "speaker": "扎卡里亚",
                                    "text": "送完药就回来找我吧，我会准备好报酬的。"
                                }
                            ]
                        },
                        {
                            "id": "230180806",
                            "text": "你这话术是向谁学的？",
                            "response": [
                                {
                                    "id": "230180807",
                                    "speaker": "扎卡里亚",
                                    "text": "谈不上学，只能说是耳濡目染吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301821",
            "objective": "将药带给阿兹拉",
            "dialogues": [
                {
                    "id": "230182101",
                    "speaker": "古尔根",
                    "text": "唉，身体果然没以前好使唤了…不行，得再坚持一会儿。"
                }
            ]
        },
        {
            "id": "2301809",
            "objective": "与阿兹拉对话",
            "dialogues": [
                {
                    "id": "230180901",
                    "speaker": "阿兹拉",
                    "text": "呃…好熟悉的气味…"
                },
                {
                    "id": "230180902",
                    "speaker": "Player",
                    "text": "这是你的药，记得要全部吃完…"
                },
                {
                    "id": "230180903",
                    "speaker": "阿兹拉",
                    "text": "唔，又是这种<color=#00E1FFFF>超苦的药</color>，我不想吃…"
                },
                {
                    "id": "230180904",
                    "speaker": "Player",
                    "text": "药的苦涩是草神对你的考验喔。"
                },
                {
                    "id": "230180905",
                    "speaker": "阿兹拉",
                    "text": "欸？是这样吗？但<color=#00E1FFFF>这药也太苦了</color>，草神大人就不能温柔一些吗…"
                },
                {
                    "id": "230180906",
                    "speaker": "阿兹拉",
                    "text": "先把药给我吧，我，我等一会再吃…"
                }
            ]
        },
        {
            "id": "2301810",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230181001",
                    "speaker": "扎卡里亚",
                    "text": "你回来了，一切顺利么？"
                },
                {
                    "id": "230181002",
                    "speaker": "Player",
                    "text": "病人说药的味道太苦了…"
                },
                {
                    "id": "230181003",
                    "speaker": "扎卡里亚",
                    "text": "这也没什么办法，毕竟草药的成分和性质…咳，有些恩惠就是要吃点苦才能受用的。"
                },
                {
                    "id": "230181004",
                    "speaker": "扎卡里亚",
                    "text": "希望她真的能把药给全吃掉，上次我就发现她只吃了一点…"
                },
                {
                    "id": "230181005",
                    "speaker": "扎卡里亚",
                    "text": "你也辛苦了，这些报酬就请收下吧。"
                }
            ]
        },
        {
            "id": "2301811",
