        },
        {
            "id": "2301815",
            "objective": "与阿夫塔对话",
            "dialogues": [
                {
                    "id": "230181501",
                    "speaker": "阿夫塔",
                    "text": "嗯？这个药是？"
                },
                {
                    "id": "230181502",
                    "speaker": "Player",
                    "text": "这是你的药。注意保持饮食清淡。"
                },
                {
                    "id": "230181503",
                    "speaker": "阿夫塔",
                    "text": "唉，好，放心吧。我已经好些天<color=#00E1FFFF>没碰过肉</color>了，这样一定能更好地承接草神大人的恩惠…"
                },
                {
                    "id": "230181504",
                    "speaker": "阿夫塔",
                    "text": "不过怎么感觉身体还不如以前了呢？唉，一定是时间还不够久…"
                }
            ]
        },
        {
            "id": "2301816",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230181601",
                    "speaker": "扎卡里亚",
                    "text": "你回来了，一切顺利么？"
                },
                {
                    "id": "230181602",
                    "speaker": "Player",
                    "text": "他已经有好几天没吃肉了…"
                },
                {
                    "id": "230181603",
                    "speaker": "扎卡里亚",
                    "text": "什么？我就是叮嘱他吃得相对清淡一点，也没让他完全不吃肉啊！"
                },
                {
                    "id": "230181604",
                    "speaker": "扎卡里亚",
                    "text": "为了更好地承接草神大人的恩惠？"
                },
                {
                    "id": "230181605",
                    "speaker": "扎卡里亚",
                    "text": "好吧…我回头得把说法再变一变…"
                },
                {
                    "id": "230181606",
                    "speaker": "扎卡里亚",
                    "text": "你也辛苦了，这些报酬就请收下吧。"
                }
            ]
        },
