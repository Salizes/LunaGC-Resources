    "talks": [
        {
            "id": "7380201",
            "objective": "对话凯瑟琳",
            "dialogues": [
                {
                    "id": "738020101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                },
                {
                    "id": "738020102",
                    "speaker": "派蒙",
                    "text": "你好呀，凯瑟琳小姐。"
                },
                {
                    "id": "738020103",
                    "speaker": "Player",
                    "text": "你好，凯瑟琳…"
                },
                {
                    "id": "738020104",
                    "speaker": "凯瑟琳",
                    "text": "你们好，看起来两位今天的状态很不错啊。请问您是来接取委托的吗？还是来处理其他事务的呢？"
                },
                {
                    "id": "738020105",
                    "speaker": "凯瑟琳",
                    "text": "嗯…两位为什么一直盯着我？是…有什么事要问我吗？",
                    "choices": [
                        {
                            "id": "738020106",
                            "text": "没有！",
                            "response": [
                                {
                                    "id": "738020108",
                                    "speaker": "凯瑟琳",
                                    "text": "这样啊…看您的样子，冒险的经验应该很丰富了吧？"
                                },
                                {
                                    "id": "738020109",
                                    "speaker": "Player",
                                    "text": "算是吧。"
                                },
                                {
                                    "id": "738020110",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，想必你也已经很熟悉冒险家协会的运作模式了，我就不多赘述，以免耽误您的时间。"
                                },
                                {
                                    "id": "738020111",
                                    "speaker": "凯瑟琳",
                                    "text": "如果您对协会内的事务有任何疑问，都欢迎来找我。"
                                },
                                {
                                    "id": "738020112",
                                    "speaker": "凯瑟琳",
                                    "text": "在须弥城里，也请您多多完成委托吧。像您这样实力强大的冒险家，一定能帮上人们不少忙。"
                                },
                                {
                                    "id": "738020113",
                                    "speaker": "凯瑟琳",
                                    "text": "请继续勇敢冒险吧，向着星辰与深渊！"
                                }
                            ]
                        },
                        {
                            "id": "738020107",
                            "text": "只，只是想要接点委托…"
                        }
                    ]
                }
            ]
        }
    ]
