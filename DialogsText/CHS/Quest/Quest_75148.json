    "talks": [
        {
            "id": "7514809",
            "objective": "(test)接取任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7514801",
            "objective": "前往「天火之冠」",
            "dialogues": [
                {
                    "id": "751480101",
                    "speaker": "（test）神秘的声音",
                    "text": "受龙所选者，啊，受龙所选者啊…"
                },
                {
                    "id": "751480102",
                    "speaker": "（test）神秘的声音",
                    "text": "登上冠冕之顶，跃入圣山之火吧！"
                },
                {
                    "id": "751480103",
                    "speaker": "（test）神秘的声音",
                    "text": "去揭开吧，去揭开金印，揭开亿万余火的焰光！"
                },
                {
                    "id": "751480104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯…"
                },
                {
                    "id": "751480105",
                    "speaker": "派蒙",
                    "text": "怎么了，难道又看到什么奇怪的话？",
                    "choices": [
                        {
                            "id": "751480106",
                            "text": "感觉…更加清晰了…",
                            "response": [
                                {
                                    "id": "751480108",
                                    "speaker": "派蒙",
                                    "text": "咦，是因为靠近了火山的关系吗？"
                                },
                                {
                                    "id": "751480109",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751480110",
                                    "speaker": "派蒙",
                                    "text": "…看起来就像是，那个一直跟你们说话的人就在火山里一样呢。"
                                },
                                {
                                    "id": "751480111",
                                    "speaker": "派蒙",
                                    "text": "不过既然靠近火山的时候又能看到那些东西，就说明我们没有走错路。"
                                },
                                {
                                    "id": "751480112",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "751480107",
                            "text": "感觉…距离更近了一些…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7514805",
            "objective": "前往「天火之冠」$HIDDEN",
            "dialogues": [
                {
                    "id": "751480501",
                    "speaker": "派蒙",
                    "text": "咦，刚才那是，绒、绒翼龙？"
                },
                {
                    "id": "751480502",
                    "speaker": "派蒙",
                    "text": "它是不是直接抓着那个雕像跳下去了，跳进了，火山口里？"
                },
                {
                    "id": "751480503",
                    "speaker": "派蒙",
                    "text": "那里就是火山口…还挺壮观的呢。"
                },
                {
                    "id": "751480504",
                    "speaker": "派蒙",
                    "text": "唔，之前问路的时候，不是说火山口聚集了海量的气态燃素…"
                },
                {
                    "id": "751480505",
                    "speaker": "派蒙",
                    "text": "对哦！<color=#00E1FFFF>穿越气态燃素的办法</color>，就像…刚才的绒翼龙那样！"
                },
                {
                    "id": "751480506",
                    "speaker": "派蒙",
                    "text": "不过，呜，这么高！",
                    "choices": [
                        {
                            "id": "751480507",
                            "text": "没关系，我会抱住派蒙。",
                            "response": [
                                {
                                    "id": "751480508",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751480509",
                                    "speaker": "派蒙",
                                    "text": "咦，你也愿意吗？真的吗…好、好吧，既然这样好像也没有那么害怕了。"
                                },
                                {
                                    "id": "751480514",
                                    "speaker": "派蒙",
                                    "text": "而且，不仅仅是高，别忘了那些气态燃素呢！"
                                },
                                {
                                    "id": "751480515",
                                    "speaker": "派蒙",
                                    "text": "唔，等、等准备好，我们就出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "751480510",
                            "text": "只要落地瞬间派蒙能拉住…",
                            "response": [
                                {
                                    "id": "751480511",
                                    "speaker": "派蒙",
                                    "text": "拉不住啦，先不说我有没有那么大的力气，什么叫落地的瞬间嘛，这个时机的把握也太难了！"
                                },
                                {
                                    "id": "751480512",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751480513",
                                    "speaker": "派蒙",
                                    "text": "你也是，不许跟着瞎起哄。唉…被你们这么一闹，一点紧张感都没有了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
