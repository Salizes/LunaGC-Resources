        {
            "id": "7514808",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "751480601",
                    "speaker": "派蒙",
                    "text": "啊，终于爬上来了，没想到这里这么高，不过倒是没有想象中那么冷呢…"
                },
                {
                    "id": "751480602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "波嗯，唔…呀！"
                },
                {
                    "id": "751480603",
                    "speaker": "派蒙",
                    "text": "你皮糙肉厚，当然不怕冷啦！"
                },
                {
                    "id": "751480604",
                    "speaker": "派蒙",
                    "text": "那里就是火山口…还挺壮观的呢。"
