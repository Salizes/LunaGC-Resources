    "talks": [
        {
            "id": "2102701",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210270101",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你来得正好，我正想去找你呢！"
                },
                {
                    "id": "210270102",
                    "speaker": "派蒙",
                    "text": "欸？小蒙，你有什么事吗？"
                },
                {
                    "id": "210270103",
                    "speaker": "小蒙",
                    "text": "我上次不是拜托你，陪我去放出了一个装着我烦恼的漂流瓶吗？"
                },
                {
                    "id": "210270104",
                    "speaker": "小蒙",
                    "text": "本来我都不抱希望了…"
                },
                {
                    "id": "210270105",
                    "speaker": "小蒙",
                    "text": "但是，前几天我爸爸说，他的一个生意伙伴突然找到了他。"
                },
                {
                    "id": "210270106",
                    "speaker": "小蒙",
                    "text": "那个叔叔说，他们正在筹划一桩和蘑菇有关的生意，过段时间要去须弥考察。"
                },
                {
                    "id": "210270107",
                    "speaker": "小蒙",
                    "text": "他们问我爸爸，要不要跟他们一起去看看那边的情况。"
                },
                {
                    "id": "210270108",
                    "speaker": "小蒙",
                    "text": "还说…可以把我一起带上！"
                },
                {
                    "id": "210270109",
                    "speaker": "小蒙",
                    "text": "爸爸最开始还不同意，但是…有个叔叔突然拿出了一封信，说要和我爸爸出去单独谈谈。"
                },
                {
                    "id": "210270110",
                    "speaker": "小蒙",
                    "text": "他们谈完了之后，爸爸就同意带我去须弥了…"
                },
                {
                    "id": "210270111",
                    "speaker": "小蒙",
                    "text": "唔，虽然不知道为什么爸爸突然改变了主意…但是…"
                },
                {
                    "id": "210270112",
                    "speaker": "小蒙",
                    "text": "#我可以去须弥旅行了！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！我可以去须弥旅行啦！太好了！",
                    "choices": [
                        {
                            "id": "210270113",
                            "text": "恭喜你！",
                            "response": [
                                {
                                    "id": "210270114",
                                    "speaker": "小蒙",
                                    "text": "#一定是那个漂流瓶起作用了，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                                },
                                {
                                    "id": "210270117",
                                    "speaker": "小蒙",
                                    "text": "爸爸说，他们去了须弥之后，还要去一个叫做「翘英庄」的地方。"
                                },
                                {
                                    "id": "210270118",
                                    "speaker": "Player",
                                    "text": "翘英庄？"
                                },
                                {
                                    "id": "210270119",
                                    "speaker": "小蒙",
                                    "text": "嗯，爸爸说那是一个茶村，种着很多茶树，茶叶的品质也特别好。不过，这个名字可真难记…"
                                },
                                {
                                    "id": "210270120",
                                    "speaker": "小蒙",
                                    "text": "先不说这些了！在去那边之前，我们还是要先去须弥的。"
                                },
                                {
                                    "id": "210270121",
                                    "speaker": "小蒙",
                                    "text": "须弥离这里也很远，过去肯定要花很长时间。"
                                },
                                {
                                    "id": "210270122",
                                    "speaker": "小蒙",
                                    "text": "不过，我听人家说外出旅行要做很多准备，因为只要旅行的时间一长，就会遇见各种情况。"
                                },
                                {
                                    "id": "210270123",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你经常在外面旅行，能不能请你教我一些在外旅行的诀窍呀？"
                                },
                                {
                                    "id": "210270124",
                                    "speaker": "小蒙",
                                    "text": "比如…嗯…"
                                },
                                {
                                    "id": "210270125",
                                    "speaker": "小蒙",
                                    "text": "在外面旅行的时候，一般会吃什么东西呀？"
                                },
                                {
                                    "id": "210270126",
                                    "speaker": "小蒙",
                                    "text": "爸爸和我说，他们都是自己做东西吃。可我只会几道简单的菜，也不知道做的好不好…"
                                },
                                {
                                    "id": "210270127",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，烹饪可是我们的拿手好戏，对吧？{NICKNAME}。",
                                    "choices": [
                                        {
                                            "id": "210270128",
                                            "text": "我来教你。",
                                            "response": [
                                                {
                                                    "id": "210270130",
                                                    "speaker": "派蒙",
                                                    "text": "那我们得先去找个灶台…"
                                                },
                                                {
                                                    "id": "210270131",
                                                    "speaker": "派蒙",
                                                    "text": "我想想…不如，我们再去找卯师傅借一下厨房吧。"
                                                },
                                                {
                                                    "id": "210270132",
                                                    "speaker": "小蒙",
                                                    "text": "卯师傅？呜哇，那个大叔平时好吓人的…"
                                                },
                                                {
                                                    "id": "210270133",
                                                    "speaker": "派蒙",
                                                    "text": "卯师傅哪里吓人啦？他人很好的。"
                                                },
                                                {
                                                    "id": "210270134",
                                                    "speaker": "小蒙",
                                                    "text": "是、是吗？可我每次和爸爸在那边吃饭的时候，只要我把清心挑出去不吃，他的眉头就皱起来了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210270129",
                                            "text": "交给我吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210270115",
                            "text": "我说不定也会去须弥。",
                            "response": [
                                {
                                    "id": "210270116",
                                    "speaker": "小蒙",
                                    "text": "真的吗？那我们就须弥见吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102702",
            "objective": "指导小蒙进行烹饪",
            "dialogues": [
                {
                    "id": "210270201",
                    "speaker": "卯师傅",
                    "text": "旅行者，还有小蒙？你们有什么事吗？"
                },
                {
                    "id": "210270202",
                    "speaker": "小蒙",
                    "text": "#啊？呃…那个…那个…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…"
                },
                {
                    "id": "210270203",
                    "speaker": "Player",
                    "text": "我们想要借用一下厨房。"
                },
                {
                    "id": "210270204",
                    "speaker": "卯师傅",
                    "text": "借用厨房倒是没问题，可你们为什么突然…"
                },
                {
                    "id": "210270205",
                    "speaker": "卯师傅",
                    "text": "原来是这样…好，你们就去用吧。"
                },
                {
                    "id": "210270206",
                    "speaker": "卯师傅",
                    "text": "小蒙，去外面旅行的时候，你可不能挑食了。"
                },
                {
                    "id": "210270207",
                    "speaker": "小蒙",
                    "text": "我、我知道了…"
                },
                {
                    "id": "210270208",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，那就拜托你了，教我做一道好菜吧。"
                },
                {
                    "id": "210270209",
                    "speaker": "小蒙",
                    "text": "等我和爸爸去旅行的时候，我一定要给他一个惊喜。"
                },
                {
                    "id": "210270210",
                    "speaker": "派蒙",
                    "text": "交给我们吧！"
                },
                {
                    "id": "210270211",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们做什么菜好呢？"
                }
            ]
        },
        {
            "id": "2102703",
            "objective": "指导小蒙进行烹饪",
            "dialogues": [
                {
                    "id": "210271001",
                    "speaker": "小蒙",
                    "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}了，我先仔细看看这食谱…"
                },
                {
                    "id": "210271002",
                    "speaker": "小蒙",
                    "text": "呜…字好多…这个字怎么念的来着…"
                }
            ]
        },
        {
            "id": "2102704",
            "objective": "将绝云椒椒交给小蒙",
            "dialogues": [
                {
                    "id": "210270401",
                    "speaker": "Player",
                    "text": "满足沙拉。"
                },
                {
                    "id": "210270402",
                    "speaker": "派蒙",
                    "text": "这道菜确实很简单呢，味道也很不错。"
                }
            ]
        },
        {
            "id": "2102705",
            "objective": "将甜甜花交给小蒙",
            "dialogues": [
                {
                    "id": "210270501",
                    "speaker": "Player",
                    "text": "甜甜花酿鸡。"
                },
                {
                    "id": "210270502",
                    "speaker": "派蒙",
                    "text": "这个好吃！嘿嘿，不过难度会不会有点高呢…"
                }
            ]
        },
        {
            "id": "2102706",
            "objective": "将史莱姆凝液交给小蒙",
            "dialogues": [
                {
                    "id": "210270601",
                    "speaker": "小蒙",
                    "text": "喔…这道食谱好详细啊，字好多…"
                },
                {
                    "id": "210270602",
                    "speaker": "派蒙",
                    "text": "唔，不过就这么简单做出来的话，感觉不太能给人惊喜感呢。"
                },
                {
                    "id": "210270603",
                    "speaker": "小蒙",
                    "text": "欸？那要怎么办？"
                },
                {
                    "id": "210270604",
                    "speaker": "派蒙",
                    "text": "不如…我们再往里面加入一点新奇的食材吧。"
                },
                {
                    "id": "210270605",
                    "speaker": "派蒙",
                    "text": "但是，要加入什么呢…"
                }
            ]
        },
        {
            "id": "2102707",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210271201",
                    "speaker": "小蒙",
                    "text": "#这样材料就齐了，那…就麻烦{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}指导一下我啦。"
                },
                {
                    "id": "210271202",
                    "speaker": "小蒙",
                    "text": "完成了！"
                }
            ]
        },
        {
            "id": "2102708",
            "objective": "与小蒙对话",
            "dialogues": [
                {
                    "id": "210271501",
                    "speaker": "派蒙",
                    "text": "总之，只要学会了基本的做菜方法，接下来只要不断练习就好啦。"
                },
                {
                    "id": "210271502",
                    "speaker": "小蒙",
                    "text": "#嗯！我会练习的，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                },
                {
                    "id": "210271503",
                    "speaker": "小蒙",
                    "text": "须弥，须弥…嘿嘿，我都要等不及啦。"
                }
            ]
        },
        {
            "id": "2102709",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2102703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210270301",
                    "speaker": "Player",
                    "text": "野菇鸡肉串。"
                },
                {
                    "id": "210270302",
                    "speaker": "派蒙",
                    "text": "喔，很经典的冒险家食物呢。"
                }
            ]
        },
        {
            "id": "2102707",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210270701",
                    "speaker": "Player",
                    "text": "绝云椒椒。"
                },
                {
                    "id": "210270702",
                    "speaker": "派蒙",
                    "text": "要让这道菜带上辣味吗？感觉还不错呢。"
                },
                {
                    "id": "210270703",
                    "speaker": "派蒙",
                    "text": "长途旅行肯定很让人疲惫，辣味说不定能让大家打起精神来呢。"
                },
                {
                    "id": "210270704",
                    "speaker": "派蒙",
                    "text": "好嘞，那我们就去找一些绝云椒椒来吧。"
                }
            ]
        },
        {
            "id": "2102708",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210270801",
                    "speaker": "Player",
                    "text": "甜甜花。"
                },
                {
                    "id": "210270802",
                    "speaker": "派蒙",
                    "text": "要让这道菜再甜一点吗？"
                },
                {
                    "id": "210270803",
                    "speaker": "派蒙",
                    "text": "吃到甜甜的东西，确实能让人感觉很愉快。"
                },
                {
                    "id": "210270804",
                    "speaker": "派蒙",
                    "text": "那我们就去找几朵甜甜花来吧。"
                }
            ]
        },
        {
            "id": "2102709",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210270901",
                    "speaker": "Player",
                    "text": "史莱姆凝液！"
                },
                {
                    "id": "210270902",
                    "speaker": "派蒙",
                    "text": "这个好！我最喜欢吃了！"
                },
                {
                    "id": "210270903",
                    "speaker": "小蒙",
                    "text": "史莱姆凝液，也可以用来做菜吗…"
                },
                {
                    "id": "210270904",
                    "speaker": "派蒙",
                    "text": "当然可以啦，而且我们认识的一位大厨师，也用过史莱姆凝液做菜呢。"
                },
                {
                    "id": "210270905",
                    "speaker": "派蒙",
                    "text": "好，那我们就去找几份史莱姆凝液来吧。"
                },
                {
                    "id": "210270906",
                    "speaker": "派蒙",
                    "text": "嘿嘿…这道菜的味道肯定会很不错的！"
                }
            ]
        },
        {
            "id": "2102711",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210271101",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你们找到新食材了吗？"
                }
            ]
        },
        {
            "id": "2102713",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210271301",
                    "speaker": "派蒙",
                    "text": "唔唔，是哪里出错了吗？"
                },
                {
                    "id": "210271302",
                    "speaker": "派蒙",
                    "text": "难道，是史莱姆凝液放太多了…"
                }
            ]
        },
        {
            "id": "2102714",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210271401",
                    "speaker": "派蒙",
                    "text": "这道菜看着还不错，小蒙已经很有天赋啦！"
                }
            ]
        }
    ]
}