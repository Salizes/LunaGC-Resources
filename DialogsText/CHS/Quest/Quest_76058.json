    "talks": [
        {
            "id": "7605801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760580101",
                    "speaker": "玫熙",
                    "text": "我还从来没见过这么白的盗宝鼬呢，它不会是生病了吧…"
                },
                {
                    "id": "760580102",
                    "speaker": "米科",
                    "text": "看它活蹦乱跳的，刚才还想从尤尔瓦哥哥那儿抢吃的，哪里像生病的样子呀。"
                },
                {
                    "id": "760580103",
                    "speaker": "尤尔瓦",
                    "text": "可能是很稀罕的品种？莉奈娅说不定知道。"
                },
                {
                    "id": "760580104",
                    "speaker": "派蒙",
                    "text": "哇！是把我的小金库洗劫一空的摩拉小偷！"
                },
                {
                    "id": "760580105",
                    "speaker": "Black Screen",
                    "text": "盗宝鼬试图逃跑，但被三个孩子眼疾手快按了下来，挣扎了一会儿就放弃了，趁这时间向孩子们讲述了此前的遭遇…"
                },
                {
                    "id": "760580106",
                    "speaker": "米科",
                    "text": "原来是惯犯，那得让它吃点教训才行，犯了错就得受惩罚，这样才对吧。"
                },
                {
                    "id": "760580107",
                    "speaker": "玫熙",
                    "text": "可是…可是它只是个小动物，它又不懂这些…",
                    "choices": [
                        {
                            "id": "760580108",
                            "text": "只要把派蒙的摩拉还回来就行。",
                            "response": [
                                {
                                    "id": "760580110",
                                    "speaker": "尤尔瓦",
                                    "text": "不管怎么说，先把它身上带的摩拉还给派蒙吧，它也没处花这些摩拉，所以全都在呢。"
                                },
                                {
                                    "id": "760580111",
                                    "speaker": "派蒙",
                                    "text": "太好啦！嘿嘿，这下我的小金库又充实起来了。"
                                },
                                {
                                    "id": "760580112",
                                    "speaker": "玫熙",
                                    "text": "如果能把它养起来就好了，那样的话，等赫卡回来了也可以让她看看稀罕的盗宝鼬。"
                                },
                                {
                                    "id": "760580113",
                                    "speaker": "米科",
                                    "text": "欸？可是它都不会工作…偷东西可不算工作，不工作，凭什么白吃白喝。"
                                },
                                {
                                    "id": "760580114",
                                    "speaker": "尤尔瓦",
                                    "text": "好啦好啦，该拿它怎么办…我们之后和卡嘉商量一下再定吧。"
                                }
                            ]
                        },
                        {
                            "id": "760580109",
                            "text": "小动物也该知道知道世界的残酷…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7605802",
            "objective": "回那夏镇看看",
            "dialogues": []
        }
    ]
}