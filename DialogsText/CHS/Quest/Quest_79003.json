    "talks": [
        {
            "id": "7900301",
            "objective": "",
            "dialogues": [
                {
                    "id": "790030101",
                    "speaker": "派蒙",
                    "text": "这是…一艘，呃不，是半艘船？"
                },
                {
                    "id": "790030102",
                    "speaker": "派蒙",
                    "text": "为什么这种地方会有半艘船？咦，这船身上面还刻着字呢，我看看…"
                },
                {
                    "id": "790030103",
                    "speaker": "派蒙",
                    "text": "「…居然前半截没了，剩下后半截还能飘这么远，真不愧是我的船，哈哈哈…不过，船上的东西大概都已经沉进海里了…」"
                },
                {
                    "id": "790030104",
                    "speaker": "派蒙",
                    "text": "「…好像，是顺着东南方漂流的来着？算了，不管这些，剩下要解决的问题，就是怎么离开这里…」"
                },
                {
                    "id": "790030105",
                    "speaker": "派蒙",
                    "text": "好像是一群遇到海难的人了呢，这上面说「前面半截」…"
                },
                {
                    "id": "790030106",
                    "speaker": "派蒙",
                    "text": "呜哇…难道这里就是「后面半截」吗？整艘船都断成两截了，他们到底遇见了什么啊…"
                },
                {
                    "id": "790030107",
                    "speaker": "派蒙",
                    "text": "唔，这上面说，他们顺着「东南方」漂流来着。"
                },
                {
                    "id": "790030108",
                    "speaker": "派蒙",
                    "text": "那我们也顺着他们漂流的方向，去找找这艘船的「前面半截」吧，说不定会有什么发现呢。"
                },
                {
                    "id": "790030109",
                    "speaker": "Player",
                    "text": "把这段刻着字的木板也带上吧。"
                },
                {
                    "id": "790030110",
                    "speaker": "派蒙",
                    "text": "你是觉得，这上面刻的字也会是线索吧？"
                },
                {
                    "id": "790030111",
                    "speaker": "派蒙",
                    "text": "好吧，反正这船上的木板看着都快坏掉了，应该很简单就能掰下来。"
                },
                {
                    "id": "790030112",
                    "speaker": "派蒙",
                    "text": "拿下来之后，我们就快点去找另外半截船吧。"
                }
            ]
        },
        {
            "id": "7900302",
            "objective": "",
            "dialogues": [
                {
                    "id": "790030201",
                    "speaker": "派蒙",
                    "text": "这是…一艘，呃不，是半艘船？"
                },
                {
                    "id": "790030202",
                    "speaker": "派蒙",
                    "text": "为什么这种地方会有半艘船？咦，这船身上面还刻着字呢，我看看…"
                },
                {
                    "id": "790030203",
                    "speaker": "派蒙",
                    "text": "「虽然不知道在哪，但看来已经远离稻妻了，幕府的那群家伙，应该也知道我们的厉害了！」"
                },
                {
                    "id": "790030204",
                    "speaker": "派蒙",
                    "text": "「不过，这周围还是一点陆地都看不见，再这么下去，怕是船都要撑不住了…必须想个办法才行…」"
                },
                {
                    "id": "790030205",
                    "speaker": "派蒙",
                    "text": "好像是一群人…从稻妻离开，然后船突然出了问题，只能顺水漂流了呢。"
                },
                {
                    "id": "790030206",
                    "speaker": "派蒙",
                    "text": "这时候他们的船应该还是完好的…我们在这附近找找看吧，说不定会有什么发现呢。"
                },
                {
                    "id": "790030207",
                    "speaker": "Player",
                    "text": "把这段刻着字的木板也带上吧。"
                },
                {
                    "id": "790030208",
                    "speaker": "派蒙",
                    "text": "你是觉得，这上面刻的字也会是线索吧？"
                },
                {
                    "id": "790030209",
                    "speaker": "派蒙",
                    "text": "好吧，反正这船上的木板看着都快坏掉了，应该很简单就能掰下来。"
                },
                {
                    "id": "790030210",
                    "speaker": "派蒙",
                    "text": "拿下来之后，我们就快点去找另外半截船吧。"
                }
            ]
        },
        {
            "id": "7900310",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "7900311",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "7900303",
            "objective": "寻找另外「半截船」",
            "dialogues": [
                {
                    "id": "790030301",
                    "speaker": "派蒙",
                    "text": "这应该就是那艘断船的另一截了。我看看…这上面也有刻字呢。"
                },
                {
                    "id": "790030302",
                    "speaker": "派蒙",
                    "text": "「虽然不知道在哪，但看来已经远离稻妻了，幕府的那群家伙，应该也知道我们的厉害了！」"
                },
                {
                    "id": "790030303",
                    "speaker": "派蒙",
                    "text": "「不过，这周围还是一点陆地都看不见，再这么下去，怕是船都要撑不住了…必须想个办法才行…」"
                },
                {
                    "id": "790030305",
                    "speaker": "Player",
                    "text": "两截船上的刻字好像是连着的…"
                },
                {
                    "id": "790030306",
                    "speaker": "派蒙",
                    "text": "连起来的话，应该是…"
                },
                {
                    "id": "790030307",
                    "speaker": "派蒙",
                    "text": "「虽然不知道在哪，但看来已经远离稻妻了，幕府的那群家伙，应该也知道我们的厉害了！」"
                },
                {
                    "id": "790030308",
                    "speaker": "派蒙",
                    "text": "「不过，这周围还是一点陆地都看不见，再这么下去，怕是船都要撑不住了…必须想个办法才行…」"
                },
                {
                    "id": "790030309",
                    "speaker": "派蒙",
                    "text": "「…居然前半截没了，剩下后半截还能飘这么远，真不愧是我的船，哈哈哈…不过，船上的东西大概都已经沉进海里了…」"
                },
                {
                    "id": "790030310",
                    "speaker": "派蒙",
                    "text": "「…好像，是顺着东南方漂流的来着？算了，不管这些，剩下要解决的问题，就是怎么离开这里…」"
                },
                {
                    "id": "790030311",
                    "speaker": "派蒙",
                    "text": "看来这群人，是运送着什么东西的时候突然遭遇了海难，一直漂流到了这里。",
                    "choices": [
                        {
                            "id": "790030312",
                            "text": "看来凶多吉少了。",
                            "response": [
                                {
                                    "id": "790030313",
                                    "speaker": "派蒙",
                                    "text": "感觉上…应该是这样呢。毕竟连船都断成了两截…"
                                },
                                {
                                    "id": "790030316",
                                    "speaker": "派蒙",
                                    "text": "但是，他们的船上会不会运着什么东西呢？真是让人在意…"
                                },
                                {
                                    "id": "790030317",
                                    "speaker": "派蒙",
                                    "text": "不然，我们在周围找找看吧，说不定有宝藏…",
                                    "choices": [
                                        {
                                            "id": "790030318",
                                            "text": "泡在海里这么久，肯定都坏掉了。",
                                            "response": [
                                                {
                                                    "id": "790030319",
                                                    "speaker": "派蒙",
                                                    "text": "不要说这种丧气话啦！寻宝的时候，就是要坚信宝藏完好无损！"
                                                },
                                                {
                                                    "id": "790030322",
                                                    "speaker": "派蒙",
                                                    "text": "好了，我们出发吧，这么大的海面，我们说不定要找好一阵了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790030320",
                                            "text": "说不定又会遇见魔物…",
                                            "response": [
                                                {
                                                    "id": "790030321",
                                                    "speaker": "派蒙",
                                                    "text": "这可是在海上，怎么可能啦，最多是遇见几只大鱼而已。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790030314",
                            "text": "也许他们幸免于难了。",
                            "response": [
                                {
                                    "id": "790030315",
                                    "speaker": "派蒙",
                                    "text": "希望如此…但船都断成了两截，感觉很难幸免于难了呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
