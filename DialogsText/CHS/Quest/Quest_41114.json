        }
    },
    "talks": [
        {
            "id": "4111401",
            "objective": "向莫娜打听占卜的进度",
            "dialogues": [
                {
                    "id": "411140101",
                    "speaker": "派蒙",
                    "text": "咦，菲谢尔在等我们吗？"
                },
                {
                    "id": "411140102",
                    "speaker": "奥兹",
                    "text": "来得可真是时候。虽然不舍，也必须和各位说出这番话了。"
                },
                {
                    "id": "411140103",
                    "speaker": "菲谢尔",
                    "text": "暂且与本皇女辞别吧，同行者。一路上你展现了非凡的勇气，这股嘉奖的风正是为你而起。"
                },
                {
                    "id": "411140104",
                    "speaker": "派蒙",
                    "text": "哎哎哎？怎么突然道别呀？"
                },
                {
                    "id": "411140105",
                    "speaker": "Player",
                    "text": "菲谢尔，你要走了吗？"
                },
                {
                    "id": "411140106",
                    "speaker": "奥兹",
                    "text": "大陨石加剧了昏睡现象，连身强体壮的士兵也支撑不住。现在到处都缺乏人手。"
                },
                {
                    "id": "411140107",
                    "speaker": "奥兹",
                    "text": "皇女与我要代替士兵看护那些患者，剩下的事就交给你们了。"
                },
                {
                    "id": "411140108",
                    "speaker": "菲谢尔",
                    "text": "#{NICKNAME}…再见了。"
                },
                {
                    "id": "411140109",
                    "speaker": "菲谢尔",
                    "text": "你是很好的聆听者，愿意陪我聊天。"
                },
                {
                    "id": "411140110",
                    "speaker": "菲谢尔",
                    "text": "平时，即使在协会里，许多冒险家愿意跟我搭档，也只是为了从我的话里听出奥兹侦察的结果而已…"
                },
                {
                    "id": "411140111",
                    "speaker": "菲谢尔",
                    "text": "这次的一小段旅途，是一场很好的冒险。突然说要走，我也…"
                },
                {
                    "id": "411140112",
                    "speaker": "派蒙",
                    "text": "咦？菲谢尔的说话方式，是不是有点不像平常的那种…？"
                },
                {
                    "id": "411140113",
                    "speaker": "菲谢尔",
                    "text": "！！！"
                },
                {
                    "id": "411140114",
                    "speaker": "菲谢尔",
                    "text": "（啊——啊啊啊刚才不小心出神了…！）"
                },
                {
                    "id": "411140115",
                    "speaker": "奥兹",
                    "text": "小，小姐的意思是…你们是如此勇敢，又有常人难及的智慧，任何谜题在你们面前都会化为乌有！"
                },
                {
                    "id": "411140116",
                    "speaker": "派蒙",
                    "text": "怎么这次奥兹「翻译」的方向完全反过来了。"
                },
                {
                    "id": "411140117",
                    "speaker": "奥兹",
                    "text": "咳，咳咳…小姐想说，如果是你们几位，一定可以抵达幻象背后的真相。"
                },
                {
                    "id": "411140118",
                    "speaker": "菲谢尔",
                    "text": "咳咳…唔，没错。你们是皇女的扈从。断罪的骑士，你要带领他们走出黑暗，回归光明之地。"
                },
                {
                    "id": "411140119",
                    "speaker": "莫娜",
                    "text": "谁是你的扈从啊…"
                },
                {
                    "id": "411140120",
                    "speaker": "Player",
                    "text": "奥兹，菲谢尔，谢谢你们。"
                },
                {
                    "id": "411140121",
                    "speaker": "奥兹",
                    "text": "还会再见的，等一切结束，再约着喝杯酒吧。"
                },
                {
                    "id": "411140122",
                    "speaker": "莫娜",
                    "text": "哎，可惜了两个好帮手。"
                },
                {
                    "id": "411140123",
                    "speaker": "莫娜",
                    "text": "别愁眉苦脸的，说个好消息吧，我有新发现了。"
                },
                {
                    "id": "411140124",
                    "speaker": "莫娜",
                    "text": "我从大陨石上刮来一些粉末帮助占卜，卓有成效哦！"
                },
                {
                    "id": "411140125",
                    "speaker": "莫娜",
                    "text": "这些坠落的石头已经存在成百上千年，莱纳德应该是很久之前的人了。"
                },
                {
                    "id": "411140126",
                    "speaker": "莫娜",
                    "text": "陨石传递着他的意志，也就是说，千百年来他的愿望一直没有减弱。"
                },
                {
                    "id": "411140127",
                    "speaker": "莫娜",
                    "text": "一个热切渴望登上山顶的古人…我敢断定，他和你一样，也是冒险家。"
                },
                {
                    "id": "411140128",
                    "speaker": "派蒙",
                    "text": "冒险家？难怪这么想爬上雪山！"
                },
                {
                    "id": "411140129",
                    "speaker": "莫娜",
                    "text": "目前的办法几乎是跟时间赛跑，我们很被动。必须转换思路，从根本上解决问题。"
                },
                {
                    "id": "411140130",
                    "speaker": "派蒙",
                    "text": "我支持！我认为现在应该把重心放在莱纳德身上！"
                },
                {
                    "id": "411140131",
                    "speaker": "莫娜",
                    "text": "嗯…如果陨石承载了某种愿望，那这些石头就正如菲谢尔所说，算是某种形式的「诅咒」…"
                },
                {
                    "id": "411140132",
                    "speaker": "莫娜",
                    "text": "真难得，她蒙对了…咳咳，算了，优雅的占星术士不该这样评价别人。"
                },
                {
                    "id": "411140133",
                    "speaker": "莫娜",
                    "text": "总之，我们只要去解开诅咒就好。"
                },
                {
                    "id": "411140134",
                    "speaker": "Player",
                    "text": "现在就出发吧，派蒙。"
                },
                {
                    "id": "411140135",
                    "speaker": "派蒙",
                    "text": "好！"
                },
                {
                    "id": "411140136",
                    "speaker": "派蒙",
                    "text": "既然要调查从前的冒险家，就该从<color=#00E1FFFF>冒险家协会</color>入手！"
                }
            ]
        },
        {
            "id": "4111407",
            "objective": "询问蒙德的凯瑟琳",
            "dialogues": [
                {
                    "id": "411140701",
                    "speaker": "凯瑟琳",
                    "text": "叫这个名字的冒险家有好几个，我也不敢断论。"
                },
                {
                    "id": "411140702",
                    "speaker": "凯瑟琳",
                    "text": "但我有印象看过叫这个名字的人写的书，不如去图书馆看看吧？"
                },
                {
                    "id": "411140703",
                    "speaker": "凯瑟琳",
                    "text": "但我记得，有一本作者名叫莱纳德的书，你们不如去<color=#00E1FFFF>图书馆</color>看看吧？"
                }
            ]
        },
        {
            "id": "4111408",
            "objective": "前往蒙德图书馆寻找线索",
            "dialogues": [
                {
                    "id": "411140801",
                    "speaker": "派蒙",
                    "text": "作者，莱纳德…莱纳德…有了！"
                },
                {
                    "id": "411140802",
                    "speaker": "派蒙",
                    "text": "索引上说，莱纳德的冒险家手册在图书馆<color=#00E1FFFF>一楼</color>的<color=#00E1FFFF>西北角</color>。"
                },
                {
                    "id": "411140803",
                    "speaker": "派蒙",
                    "text": "西北角…应该就是那边吧！"
                }
            ]
        },
        {
            "id": "4111403",
            "objective": "查看丽莎桌前的索引目录",
            "dialogues": []
        },
        {
            "id": "4111414",
            "objective": "(test)与派蒙对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4111404",
            "objective": "搜寻莱纳德的著作",
            "dialogues": []
        },
        {
            "id": "4111405",
            "objective": "(test)与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "411141401",
                    "speaker": "派蒙",
                    "text": "找到了！冒险家手册《山与海之书》，作者莱纳德！"
                },
                {
                    "id": "411141402",
                    "speaker": "派蒙",
                    "text": "可是，这本书居然缺字少页，根本看不懂！"
                },
                {
                    "id": "411141403",
                    "speaker": "派蒙",
                    "text": "怎么这样，呜…该不会白来了吧…"
                },
                {
                    "id": "411141404",
                    "speaker": "Player",
                    "text": "别放弃，拿给莫娜看看。"
                },
                {
                    "id": "411141405",
                    "speaker": "派蒙",
                    "text": "啊，对哦，说不定她有办法。"
                }
            ]
        },
        {
            "id": "4111409",
            "objective": "将莱纳德的著作带给莫娜",
            "dialogues": [
                {
                    "id": "411140901",
                    "speaker": "派蒙",
                    "text": "找到他的书了！"
                },
                {
                    "id": "411140902",
                    "speaker": "莫娜",
                    "text": "快给我看看！"
                },
                {
                    "id": "411140903",
                    "speaker": "Player",
                    "text": "内容有缺损，完全不连贯。"
                },
                {
                    "id": "411140904",
                    "speaker": "莫娜",
                    "text": "哼哼，我就知道会这样。"
                },
                {
                    "id": "411140905",
                    "speaker": "莫娜",
                    "text": "如果是一般的占星术士，多半已经投降了！"
                },
                {
                    "id": "411140906",
                    "speaker": "莫娜",
                    "text": "但我莫娜可是未来的占星术第一人，没有什么东西能难倒我。"
                },
                {
                    "id": "411140907",
                    "speaker": "莫娜",
                    "text": "用星盘推算缺漏的部分填入其中，再进行解读…"
                },
                {
                    "id": "411140908",
                    "speaker": "莫娜",
                    "text": "呼——！终于看完了…"
                },
                {
                    "id": "411140909",
                    "speaker": "派蒙",
                    "text": "说了什么呀！"
                },
                {
                    "id": "411140910",
                    "speaker": "莫娜",
                    "text": "和我想的一样，莱纳德是一名两千年前的冒险家。"
                },
                {
                    "id": "411140911",
                    "speaker": "莫娜",
                    "text": "他毕生的梦想就是登上一座名叫「尖帽子峰」的雪山。"
                },
                {
                    "id": "411140912",
                    "speaker": "派蒙",
                    "text": "两千年？这些陨石是…古代人的「命之座」？！"
                },
                {
                    "id": "411140913",
                    "speaker": "莫娜",
                    "text": "他的命之座由于某种原因被召唤到大地上。关于这点，我认为和愚人众有关。"
                },
                {
                    "id": "411140914",
                    "speaker": "派蒙",
                    "text": "同意，稀奇古怪的事情就数他们干得最多。"
                },
                {
                    "id": "411140915",
                    "speaker": "莫娜",
                    "text": "这些陨石内含元素力，以一种精神暗示的方式辐射了周围居民，使他们陷入梦境。"
                },
                {
                    "id": "411140916",
                    "speaker": "莫娜",
                    "text": "另外如果我猜得没错，这批陨石中应该有一颗类似核心的存在，是莱纳德精神的结晶。"
                },
                {
                    "id": "411140917",
                    "speaker": "Player",
                    "text": "它会在哪里呢？"
                },
                {
                    "id": "411140918",
                    "speaker": "莫娜",
                    "text": "如果我是莱纳德，这颗核心一定会按我所想，从空中抵达生前没能登上的山顶。"
                },
                {
                    "id": "411140919",
                    "speaker": "派蒙",
                    "text": "核心会在尖帽子峰吗？可是…尖帽子峰在哪里呀？我都没听说过这个地方。"
                },
                {
                    "id": "411140920",
                    "speaker": "莫娜",
                    "text": "我也是第一次知道。对比书中地图与现在的蒙德地形，我发现，尖帽子峰已经不存在了。"
                },
                {
                    "id": "411140921",
                    "speaker": "派蒙",
                    "text": "那么大一座雪山也会消失吗？！"
                },
                {
                    "id": "411140922",
                    "speaker": "莫娜",
                    "text": "我在书上读到过，风神巴巴托斯为了他的人民，曾经动用神力吹散冰雪，也改变了蒙德的地貌。"
                },
                {
                    "id": "411140923",
                    "speaker": "莫娜",
                    "text": "过去的山峰被一望无垠的大海取代了。但若将那座山放入海中，以它曾经的高度，还是会留下一些痕迹的。"
                },
                {
                    "id": "411140924",
                    "speaker": "莫娜",
                    "text": "——峰顶露出水面的部分，如今叫做…"
                },
                {
                    "id": "411140925",
                    "speaker": "莫娜",
                    "text": "<color=#00E1FFFF>「马斯克礁」</color>。"
                }
            ]
        },
        {
            "id": "4111410",
            "objective": "根据书中提示，前往马斯克礁",
            "dialogues": []
        },
        {
            "id": "4111411",
            "objective": "(test)与散兵对话$HIDDEN",
            "dialogues": [
                {
                    "id": "411141101",
                    "speaker": "莫娜",
                    "text": "哦？这就是从前的尖帽子峰吗？变得好小呢。"
                },
                {
                    "id": "411141102",
                    "speaker": "派蒙",
                    "text": "哎，有人先到了？这里是什么观光景点吗？"
                },
                {
                    "id": "411141103",
                    "speaker": "派蒙",
                    "text": "啊！是你！"
                },
                {
                    "id": "411141104",
                    "speaker": "「散兵」",
                    "text": "唔…嗯？是你们？",
                    "choices": [
                        {
                            "id": "411141105",
                            "text": "你是怎么找到这里的？",
                            "response": [
                                {
                                    "id": "411141107",
                                    "speaker": "派蒙",
                                    "text": "他这个样子，难道是刚从梦境里出来？"
                                },
                                {
                                    "id": "411141108",
                                    "speaker": "莫娜",
                                    "text": "竟然有人能凭自己的力量苏醒过来…怎么可能？"
                                },
                                {
                                    "id": "411141109",
                                    "speaker": "「散兵」",
                                    "text": "哼，你们做不到，不代表我也做不到。"
                                },
                                {
                                    "id": "411141110",
                                    "speaker": "「散兵」",
                                    "text": "你们来晚了一步，我的「研究」已经完成了。"
                                },
                                {
                                    "id": "411141111",
                                    "speaker": "派蒙",
                                    "text": "果然这一切都是你们愚人众搞的花样吗？！"
                                },
                                {
                                    "id": "411141112",
                                    "speaker": "「散兵」",
                                    "text": "别那么紧张，我今天没时间陪你们玩。下回再找你的麻烦也不迟。"
                                },
                                {
                                    "id": "411141113",
                                    "speaker": "Player",
                                    "text": "等等！你到底有什么目的！"
                                },
                                {
                                    "id": "411141114",
                                    "speaker": "莫娜",
                                    "text": "你刚才进入了那个众人共通的雪山梦境吧？你对莱纳德的事知道多少？"
                                },
                                {
                                    "id": "411141115",
                                    "speaker": "「散兵」",
                                    "text": "莱纳德？什么莱纳德…哼，不管了，现在可不是关心杂鱼的时候。"
                                },
                                {
                                    "id": "411141116",
                                    "speaker": "「散兵」",
                                    "text": "我发现了…更可怕、更重要的事呀。"
                                },
                                {
                                    "id": "411141117",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "411141118",
                                    "speaker": "Player",
                                    "text": "是什么？"
                                },
                                {
                                    "id": "411141119",
                                    "speaker": "「散兵」",
                                    "text": "星空本身，就是个巨大的谎言。"
                                },
                                {
                                    "id": "411141120",
                                    "speaker": "莫娜",
                                    "text": "星空…谎言？这是什么意思？"
                                },
                                {
                                    "id": "411141121",
                                    "speaker": "派蒙",
                                    "text": "是想反驳莫娜的什么占星术理论吗？那也不用说「星空本身是谎言」吧。"
                                },
                                {
                                    "id": "411141122",
                                    "speaker": "派蒙",
                                    "text": "在夜里，抬头往天上看，不就能直接看到星星吗？这种常识…"
                                },
                                {
                                    "id": "411141123",
                                    "speaker": "「散兵」",
                                    "text": "哈…哈哈哈哈哈哈！还在说这种天真的话！"
                                },
                                {
                                    "id": "411141124",
                                    "speaker": "「散兵」",
                                    "text": "不过，这也不是你的错，因为直到不久之前，我也是这样相信的…"
                                },
                                {
                                    "id": "411141125",
                                    "speaker": "莫娜",
                                    "text": "直到刚才？你是指…"
                                },
                                {
                                    "id": "411141126",
                                    "speaker": "「散兵」",
                                    "text": "哼，我可没空再陪你们探讨这些了。"
                                },
                                {
                                    "id": "411141127",
                                    "speaker": "「散兵」",
                                    "text": "「丑角」那家伙…把这种任务交给我，居然不事先预警可能的「发现」…是想故意吓我一跳吗？！"
                                },
                                {
                                    "id": "411141128",
                                    "speaker": "「散兵」",
                                    "text": "我现在必须去确认「真相」。那么，再见了，菜鸟们！"
                                }
                            ]
                        },
                        {
                            "id": "411141106",
                            "text": "你是刚睡醒吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4111412",
            "objective": "击败散兵的手下",
            "dialogues": []
        },
        {
            "id": "4111415",
            "objective": "(test)战斗后的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "411141501",
                    "speaker": "派蒙",
                    "text": "真是一场恶战啊！"
                },
                {
                    "id": "411141502",
                    "speaker": "莫娜",
                    "text": "这就是惹恼我的下场！"
                },
                {
                    "id": "411141503",
                    "speaker": "Player",
                    "text": "莫娜真厉害。"
                },
                {
                    "id": "411141504",
                    "speaker": "莫娜",
                    "text": "当然了！派蒙，你也觉得我很厉害对吧？对吧对吧？"
                },
                {
                    "id": "411141505",
                    "speaker": "派蒙",
                    "text": "是啊是啊，没有莫娜，我们恐怕会陷入更大的麻烦。"
                },
                {
                    "id": "411141506",
                    "speaker": "莫娜",
                    "text": "哼，听见没有！愚人众执行官！坏男人！"
                },
                {
                    "id": "411141507",
                    "speaker": "莫娜",
                    "text": "不过看他刚才那么震惊的样子，也不像在撒谎。难道师父教导我占星术时所说的「虚假之天」还有其他含义？"
                },
                {
                    "id": "411141508",
                    "speaker": "莫娜",
                    "text": "啊…咳咳，我走神了。那么，去完成我们最重要的工作吧。"
                },
                {
                    "id": "411141509",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>陨石的核心</color>，一定就在这里附近！"
                }
            ]
        },
        {
            "id": "4111413",
            "objective": "销毁陨石核心",
            "dialogues": []
        },
        {
            "id": "4111416",
            "objective": "(test)摧毁陨石后的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "411141601",
                    "speaker": "派蒙",
                    "text": "哇，这就是核心吗，和其他陨石不太一样呢！有种…明亮的感觉？"
                },
                {
                    "id": "411141602",
                    "speaker": "莫娜",
                    "text": "这块石头上有着惊人的元素力和意念。确实是核心没错。"
                },
                {
                    "id": "411141603",
                    "speaker": "Player",
                    "text": "我们…应该破坏它吗？"
                },
                {
                    "id": "411141604",
                    "speaker": "莫娜",
                    "text": "嗯，不把它清理掉，人们就不会醒来……这块核心就是一切事件的根源。"
                },
                {
                    "id": "411141605",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，加油啊！"
                },
                {
                    "id": "411141606",
                    "speaker": "莫娜",
                    "text": "没想到，原来是这么一回事…",
                    "choices": [
                        {
                            "id": "411141607",
                            "text": "攀爬的人，试图抵达未知的高峰。",
                            "response": [
                                {
                                    "id": "411141609",
                                    "speaker": "莫娜",
                                    "text": "人类的信念，竟然可以在天空中留存千年…"
                                },
                                {
                                    "id": "411141610",
                                    "speaker": "莫娜",
                                    "text": "哎，果然占星学是个厉害的东西呀！"
                                },
                                {
                                    "id": "411141611",
                                    "speaker": "派蒙",
                                    "text": "为什么突然说到这上面去了？"
                                },
                                {
                                    "id": "411141612",
                                    "speaker": "莫娜",
                                    "text": "能和星星交流，就能掌握从古到今所有秘密，当然啦，能做到这种事的占星术士除了我也没有几个。"
                                },
                                {
                                    "id": "411141613",
                                    "speaker": "Player",
                                    "text": "莫娜，这次太谢谢你了。"
                                },
                                {
                                    "id": "411141614",
                                    "speaker": "莫娜",
                                    "text": "干、干嘛啊，突然这么认真…"
                                },
                                {
                                    "id": "411141615",
                                    "speaker": "莫娜",
                                    "text": "话说回来，那个叫菲谢尔的女孩子，还真是神奇。"
                                },
                                {
                                    "id": "411141616",
                                    "speaker": "派蒙",
                                    "text": "我也觉得！她明明…呃…怎么说呢…",
                                    "choices": [
                                        {
                                            "id": "411141617",
                                            "text": "是个充满奇思妙想的人。",
                                            "response": [
                                                {
                                                    "id": "411141619",
                                                    "speaker": "派蒙",
                                                    "text": "虽然是这样啦，但你回忆一下…她说的好像也没错呢。"
                                                },
                                                {
                                                    "id": "411141620",
                                                    "speaker": "派蒙",
                                                    "text": "难道说，她就是那种用错误过程得出正确结果的人？"
                                                },
                                                {
                                                    "id": "411141621",
                                                    "speaker": "莫娜",
                                                    "text": "说不定真是这样。"
                                                },
                                                {
                                                    "id": "411141622",
                                                    "speaker": "派蒙",
                                                    "text": "我最没想到的是，尖帽子峰居然变成了一座小岛！"
                                                },
                                                {
                                                    "id": "411141623",
                                                    "speaker": "莫娜",
                                                    "text": "过去的高山成了海中一块小小的陆地。现在的蒙德人只要坐上船，几乎都能到那里吧？"
                                                },
                                                {
                                                    "id": "411141624",
                                                    "speaker": "派蒙",
                                                    "text": "那岂不是人人都能登上尖帽子峰了？"
                                                },
                                                {
                                                    "id": "411141625",
                                                    "speaker": "Player",
                                                    "text": "人人都能抵达山顶了呢。"
                                                },
                                                {
                                                    "id": "411141626",
                                                    "speaker": "派蒙",
                                                    "text": "莱纳德会高兴吗？虽然尖帽子峰是个意外，但现在的蒙德人在风神帮助下已经能够飞翔了。"
                                                },
                                                {
                                                    "id": "411141627",
                                                    "speaker": "派蒙",
                                                    "text": "有了翅膀，人就能去到更高更远的地方，探索更多未知的角落。"
                                                },
                                                {
                                                    "id": "411141628",
                                                    "speaker": "Player",
                                                    "text": "（莱纳德，你的心愿实现了吗？）"
                                                },
                                                {
                                                    "id": "411141629",
                                                    "speaker": "派蒙",
                                                    "text": "好了，处理完陨石核心，睡着的人一定会慢慢醒来。"
                                                },
                                                {
                                                    "id": "411141630",
                                                    "speaker": "派蒙",
                                                    "text": "我们也算是顺利完成了冒险家协会的委托吧！"
                                                },
                                                {
                                                    "id": "411141631",
                                                    "speaker": "Player",
                                                    "text": "嗯，希望大家…早日恢复。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "411141618",
                                            "text": "是个异想天开的怪人。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "411141608",
                            "text": "执着的人，愿将意志传递给未来。"
                        }
                    ]
                }
            ]
        },
        {
