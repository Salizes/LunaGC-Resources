        "rewards_formatted": "脆弱树脂 x1, 原石 x60, 摩拉 x30000",
        "chapter": {
            "icon": "UI_ChapterIcon_Aster",
            "id": "10009",
            "num": "未归的熄星 其四",
            "title": "古星命定之地"
        },
        "total_dialogue_lines": 140,
        "total_speaker_counts": {
            "Player": 20,
            "「散兵」": 12,
