            "dialogues": [
                {
                    "id": "411460401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411460402",
                    "speaker": "莎拉",
                    "text": "欸？但…好吧，我去找其他人帮忙…"
                }
            ]
        },
        {
            "id": "4114601",
            "objective": "与莎拉对话",
            "dialogues": [
                {
                    "id": "411460101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411460102",
                    "speaker": "莎拉",
                    "text": "那就拜托你啦，那地方太远了，我们实在是分不出人手来了。"
                },
                {
                    "id": "411460103",
                    "speaker": "莎拉",
                    "text": "对了，送的时候千万小心，<color=#00E1FFFF>不要跑得太快，也不要用风之翼，更不要去爬山什么的…</color>"
                },
                {
                    "id": "411460104",
                    "speaker": "莎拉",
                    "text": "要是路上被撞了一下，肉酱和面说不定就会完全分开了…那样的话，客人肯定不会收下这份餐的。"
                }
            ]
        },
        {
            "id": "4114602",
            "objective": "将餐品送给偷懒的安杰洛",
            "dialogues": [
                {
                    "id": "411460201",
                    "speaker": "偷懒的安杰洛",
                    "text": "好不容易找到了这么个舒服的地方…我订的餐怎么还没送来…"
                }
            ]
        },
        {
            "id": "4114603",
            "objective": "与偷懒的安杰洛对话",
            "dialogues": [
                {
                    "id": "411460601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411460602",
                    "speaker": "偷懒的安杰洛",
                    "text": "总算送到了，再等一会我就要睡着了。"
                },
                {
                    "id": "411460603",
                    "speaker": "偷懒的安杰洛",
                    "text": "谢谢你啊，这道菜我就收下了。"
                }
            ]
        },
        {
            "id": "4114603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411460301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411460302",
                    "speaker": "莎拉",
                    "text": "对，那个…安杰洛先生在我们这订了一份火火肉酱面，钱已经付好了。"
                },
                {
                    "id": "411460303",
                    "speaker": "莎拉",
                    "text": "然后他让我们晚些时候送去明冠峡附近的一个地方，那个地方还挺远的，我正愁没人有空能送过去…"
                },
                {
                    "id": "411460304",
                    "speaker": "莎拉",
                    "text": "如果你愿意帮忙的话，就把这份餐给送过去吧。"
                }
            ]
        },
        {
            "id": "4114605",
