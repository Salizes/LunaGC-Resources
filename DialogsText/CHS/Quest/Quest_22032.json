    },
    "talks": [
        {
            "id": "2203201",
            "objective": "与汤雯对话",
            "dialogues": [
                {
                    "id": "220320101",
                    "speaker": "汤雯",
                    "text": "唔…要是能吃到璃月菜就好了…"
                },
                {
                    "id": "220320102",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "220320103",
                    "speaker": "汤雯",
                    "text": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
                    "choices": [
                        {
                            "id": "220320104",
                            "text": "你刚刚说想吃璃月菜？",
                            "response": [
                                {
                                    "id": "220320118",
                                    "speaker": "汤雯",
                                    "text": "欸？莫非...你会做璃月菜吗？那太好了！"
                                },
                                {
                                    "id": "220320119",
                                    "speaker": "汤雯",
                                    "text": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！"
                                },
                                {
                                    "id": "220320120",
                                    "speaker": "汤雯",
                                    "text": "让我想想...我现在的最想吃的就是…"
                                },
                                {
                                    "id": "220320121",
                                    "speaker": "汤雯",
                                    "text": "嗯…我想要吃鱼！想起小时候妈妈做的鱼…"
                                },
                                {
                                    "id": "220320122",
                                    "speaker": "汤雯",
                                    "text": "鱼身洗净，两边打上花刀，塞入香料和老酒稍加腌制，入锅煎至两面金黄…"
                                },
                                {
                                    "id": "220320123",
                                    "speaker": "汤雯",
                                    "text": "再加热水和酱料炖煮，最后大火调味收汁，勾芡装盘…啊！那可是真真正正的色香味俱全！"
                                },
                                {
                                    "id": "220320124",
                                    "speaker": "汤雯",
                                    "text": "还小的弟弟在旁边闻着，都拍手跳着直叫：「正好！正好！」"
                                },
                                {
                                    "id": "220320125",
                                    "speaker": "汤雯",
                                    "text": "呜…我妈妈可会烧鱼了，但我什么时候才能回去吃呢？"
                                }
                            ]
                        },
                        {
                            "id": "220320105",
                            "text": "遇到什么麻烦了吗？",
                            "response": [
                                {
                                    "id": "220320106",
                                    "speaker": "汤雯",
                                    "text": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。"
                                },
                                {
                                    "id": "220320107",
                                    "speaker": "汤雯",
                                    "text": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为稻妻的锁国令结被迫滞留在这里，已经有一段时间了…"
                                },
                                {
                                    "id": "220320108",
                                    "speaker": "汤雯",
                                    "text": "其实，我觉得这对我来说也算是好事。因为我感觉，此刻的稻妻正处于一个历史性的时刻！"
                                },
                                {
                                    "id": "220320109",
                                    "speaker": "汤雯",
                                    "text": "我很确信，这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。"
                                },
                                {
                                    "id": "220320110",
                                    "speaker": "汤雯",
                                    "text": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。"
                                },
                                {
                                    "id": "220320111",
                                    "speaker": "汤雯",
                                    "text": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…"
                                },
                                {
                                    "id": "220320112",
                                    "speaker": "Player",
                                    "text": "你是饿了吗？"
                                },
                                {
                                    "id": "220320113",
                                    "speaker": "汤雯",
                                    "text": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。"
                                },
                                {
                                    "id": "220320114",
                                    "speaker": "汤雯",
                                    "text": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…"
                                },
                                {
                                    "id": "220320115",
                                    "speaker": "汤雯",
                                    "text": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。"
                                },
                                {
                                    "id": "220320116",
                                    "speaker": "汤雯",
                                    "text": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…"
                                },
                                {
                                    "id": "220320117",
                                    "speaker": "Player",
                                    "text": "我可以试试吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203207",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "220320701",
                    "speaker": "派蒙",
                    "text": "所以说，要准备哪一道由鱼烧制的菜呢？不如我们替她挑选一下。"
                },
                {
                    "id": "220320702",
                    "speaker": "派蒙",
                    "text": "我想想...我最近喜欢的鱼有..."
                },
                {
                    "id": "220320703",
                    "speaker": "派蒙",
                    "text": "麻辣口的水煮黑背鲈！"
                },
                {
                    "id": "220320704",
                    "speaker": "派蒙",
                    "text": "酸甜口的松鼠鱼！"
                },
                {
                    "id": "220320705",
                    "speaker": "派蒙",
                    "text": "还有万能的蒙德烤鱼！"
                },
                {
                    "id": "220320706",
                    "speaker": "Player",
                    "text": "这都是你爱吃的吧？"
                },
                {
                    "id": "220320707",
                    "speaker": "派蒙",
                    "text": "嘿嘿，没问题的，你就相信我的品味吧，快来选一样~",
                    "choices": [
                        {
                            "id": "220320708",
                            "text": "那就水煮黑背鲈吧。",
                            "response": [
                                {
                                    "id": "220320709",
                                    "speaker": "派蒙",
                                    "text": "听起来很棒！我们就赶紧做一份水煮黑背鲈给汤雯小姐吧！"
                                }
                            ]
                        },
                        {
                            "id": "220320710",
                            "text": "那就松鼠鱼吧。",
                            "response": [
                                {
                                    "id": "220320711",
                                    "speaker": "派蒙",
                                    "text": "好耶！我们就赶紧做一份松鼠鱼给汤雯小姐吧！"
                                }
                            ]
                        },
                        {
                            "id": "220320712",
                            "text": "那就蒙德烤鱼吧。",
                            "response": [
                                {
                                    "id": "220320713",
                                    "speaker": "派蒙",
                                    "text": "真不错！我们就赶紧做一份蒙德烤鱼给汤雯小姐吧！"
                                }
                            ]
                        },
                        {
                            "id": "220320714",
                            "text": "我再想想…",
                            "response": [
                                {
                                    "id": "220320715",
                                    "speaker": "派蒙",
                                    "text": "嗯~想好了就赶紧做给汤雯小姐吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203202",
            "objective": "将准备好的菜品带给汤雯",
            "dialogues": [
                {
                    "id": "220320201",
                    "speaker": "汤雯",
                    "text": "这么快就回来了？你不会是个隐藏身份的大厨吧？"
                },
                {
                    "id": "220320202",
                    "speaker": "汤雯",
                    "text": "嗯...我都快要等不及了，请让我尝一尝！",
                    "choices": [
                        {
                            "id": "220320203",
                            "text": "请享用。"
                        },
                        {
                            "id": "220320204",
                            "text": "我想想...刚刚讨论了哪些菜？",
                            "response": [
                                {
                                    "id": "220320205",
                                    "speaker": "派蒙",
                                    "text": "唔…是松鼠鱼，水煮黑背鲈，还有蒙德烤鱼！"
                                },
                                {
                                    "id": "220320206",
                                    "speaker": "派蒙",
                                    "text": "决定好就交给汤雯小姐吧!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203203",
            "objective": "将准备好的菜品带给汤雯",
            "dialogues": [
                {
                    "id": "220320301",
                    "speaker": "汤雯",
                    "text": "啊！没错！这、这就是我梦寐以求的家乡味道啊…真是…呜呜…真是令人感动…"
                },
                {
                    "id": "220320302",
                    "speaker": "汤雯",
                    "text": "谢谢你！有了这些好吃的，我也能提起劲了。"
                },
                {
                    "id": "220320303",
                    "speaker": "汤雯",
                    "text": "这些送给你，祝你往后的旅程顺遂无忧！"
                }
            ]
        },
        {
            "id": "2203204",
            "objective": "将准备好的菜品带给汤雯",
            "dialogues": [
                {
                    "id": "220320401",
                    "speaker": "汤雯",
                    "text": "唔，这种味道…好、好像不是璃月的菜，也不是稻妻的菜，味道还真是新鲜…"
                },
                {
                    "id": "220320402",
                    "speaker": "汤雯",
                    "text": "虽然不是我想要吃的那一道，但能够尝到这种新鲜的菜品，我也已经很满足了。"
                },
                {
                    "id": "220320403",
                    "speaker": "汤雯",
                    "text": "谢谢啦，旅行者，这些东西给你，请收下吧。"
                }
            ]
        },
        {
            "id": "2203205",
            "objective": "将准备好的菜品带给汤雯",
            "dialogues": [
                {
                    "id": "220320501",
                    "speaker": "汤雯",
                    "text": "欸？这、这应该还是稻妻的菜吧…"
                },
                {
                    "id": "220320502",
                    "speaker": "汤雯",
                    "text": "我记得我要的好像不是这道菜来着…唔，算了，这道菜也能填饱肚子就是了…"
                },
                {
                    "id": "220320503",
                    "speaker": "汤雯",
                    "text": "还是谢谢你了，旅行者，这些东西请收下吧。"
                }
            ]
        },
        {
            "id": "2203206",
            "objective": "将准备好的菜品带给汤雯",
            "dialogues": [
                {
                    "id": "220320601",
                    "speaker": "汤雯",
                    "text": "咦？这、这道菜的味道怎么…这么…这么微妙。"
                },
                {
                    "id": "220320602",
                    "speaker": "汤雯",
                    "text": "也不能说是微妙…应该是说…奇异，还是什么的…"
                },
                {
                    "id": "220320603",
                    "speaker": "汤雯",
                    "text": "居然能做出这样的菜，你的厨艺还真是…另辟蹊径呢…"
                },
                {
                    "id": "220320604",
                    "speaker": "汤雯",
                    "text": "辛苦你了！旅行者，这些东西请收下吧，这道菜我稍后…稍后再细细品尝…"
                }
            ]
        },
