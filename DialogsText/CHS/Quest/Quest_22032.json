{
    "quest": {
        "id": "22032",
        "title": "家乡之味",
        "description": "来自璃月的学者汤雯似乎饱受思乡之情的困扰…",
        "rewards": [
            {
                "itemId": 100084,
                "count": 5
            }
        ],
        "rewards_formatted": "鱼肉 x5",
        "chapter": {
