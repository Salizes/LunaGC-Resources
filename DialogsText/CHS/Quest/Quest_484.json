    "talks": [
        {
            "id": "48401",
            "objective": "追踪「怪鸟」",
            "dialogues": []
        },
        {
            "id": "48402",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4840201",
                    "speaker": "安柏",
                    "text": "前面就是清泉镇了，周围一定有关于「怪鸟」的线索。"
                },
                {
                    "id": "4840202",
                    "speaker": "安柏",
                    "text": "他带着的文物上，有修女们偷偷标记的风元素痕迹…"
                },
                {
                    "id": "4840203",
                    "speaker": "派蒙",
                    "text": "那就<color=#00E1FFFF>开启元素视野</color>，仔细留意周围吧。"
                }
            ]
        },
        {
            "id": "48403",
            "objective": "搜集线索，追踪「怪鸟」",
            "dialogues": []
        },
        {
            "id": "48404",
            "objective": "(test)可疑的痕迹（已改为开车）$HIDDEN",
            "dialogues": [
                {
                    "id": "4840401",
                    "speaker": "派蒙",
                    "text": "这痕迹，会是怪鸟还是风史莱姆呢…"
                },
                {
                    "id": "4840402",
                    "speaker": "安柏",
                    "text": "风史莱姆是漂浮的。除非有人在这里踩着它起飞，不然不可能啦。"
                },
                {
                    "id": "4840403",
                    "speaker": "派蒙",
                    "text": "…有人用风史莱姆做过这种事吗？！"
                },
                {
                    "id": "4840404",
                    "speaker": "安柏",
                    "text": "总之，很清晰的痕迹，把这里先记下来吧。"
                }
            ]
        },
        {
            "id": "48405",
            "objective": "搜集线索，追踪「怪鸟」",
            "dialogues": []
        },
        {
            "id": "48406",
            "objective": "(test)奇怪的标记（已改为开车）$HIDDEN",
            "dialogues": [
                {
                    "id": "4840601",
                    "speaker": "安柏",
                    "text": "这是…碎掉的布片，有风元素的痕迹。"
                },
                {
                    "id": "4840602",
                    "speaker": "安柏",
                    "text": "看图案和编织方式，可能是风之翼的碎片。"
                },
                {
                    "id": "4840603",
                    "speaker": "派蒙",
                    "text": "这样就能看出来是风之翼了吗？不愧是侦察骑士。"
                },
                {
                    "id": "4840604",
                    "speaker": "安柏",
                    "text": "嗯，如果真是怪鸟，那他的风之翼应该已经坏掉了。"
                }
            ]
        },
