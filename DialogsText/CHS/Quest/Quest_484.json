        {
            "id": "48421",
            "objective": "寻找怪鸟遗留的痕迹",
            "dialogues": []
        },
        {
            "id": "48422",
            "objective": "寻找怪鸟遗留的痕迹",
            "dialogues": [
                {
                    "id": "4842201",
                    "speaker": "派蒙",
                    "text": "居然跑到这里来了…"
                },
                {
                    "id": "4842202",
                    "speaker": "Player",
                    "text": "前面已经没有元素痕迹了。"
                },
                {
                    "id": "4842203",
                    "speaker": "安柏",
                    "text": "文物上面的元素力要耗尽了。"
                },
                {
                    "id": "4842204",
                    "speaker": "安柏",
                    "text": "原来是这样，怪鸟一伙知道自己没法处理元素的痕迹，才让手下拖住我们。"
                },
                {
                    "id": "4842205",
                    "speaker": "安柏",
                    "text": "是想等元素的痕迹自然消失吧。"
                },
                {
                    "id": "4842206",
                    "speaker": "安柏",
                    "text": "他不会得逞的，我们赶紧追上去。"
                }
            ]
        },
        {
            "id": "48423",
            "objective": "怪鸟的去向",
            "dialogues": []
        },
        {
            "id": "48411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4841101",
                    "speaker": "安柏",
                    "text": "元素的痕迹一直指向了前面。"
                },
                {
                    "id": "4841102",
                    "speaker": "派蒙",
                    "text": "难道怪鸟一直往前方逃走了？"
                },
                {
                    "id": "4841103",
                    "speaker": "安柏",
                    "text": "光是这么猜不会得出结论。"
                },
                {
                    "id": "4841104",
                    "speaker": "安柏",
                    "text": "#{NICKNAME}，我们顺着痕迹追下去吧。"
                },
                {
                    "id": "4841105",
                    "speaker": "派蒙",
                    "text": "咦，前面好像有什么动静…"
                },
                {
                    "id": "4841106",
                    "speaker": "安柏",
                    "text": "好像是战斗的声音，难道是怪鸟？！"
                },
                {
                    "id": "4841107",
                    "speaker": "安柏",
                    "text": "快，我们赶紧过去吧。"
                }
            ]
        },
        {
            "id": "48431",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4843121",
                    "speaker": "法拉",
                    "text": "你们赶紧向前追去，说不定还能遇到那些奇怪的家伙。"
                }
            ]
        }
    ]
