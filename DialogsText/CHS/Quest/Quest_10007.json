        "rewards_formatted": "大英雄的经验 x3, 「诗文」的指引 x3, 摩拉 x30000",
        "chapter": {
            "icon": "UI_ChapterIcon_Hexenzirkel",
            "id": "2080",
            "num": "",
            "title": "魔女的课业·风起之题"
        },
        "total_dialogue_lines": 105,
        "total_speaker_counts": {
