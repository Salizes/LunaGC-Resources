    "talks": [
        {
            "id": "1000701",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "100070101",
                    "speaker": "温迪",
                    "text": "…那么我就当做您默认了。"
                },
                {
                    "id": "100070102",
                    "speaker": "Player",
                    "text": "温迪？"
                },
                {
                    "id": "100070103",
                    "speaker": "温迪",
                    "text": "#哎呀，{NICKNAME}，你终于来了，是有人捎给我口信么？",
                    "choices": [
                        {
                            "id": "100070104",
                            "text": "口信？",
                            "response": [
                                {
                                    "id": "100070106",
                                    "speaker": "温迪",
                                    "text": "「并没有从那本辞典里看见任何有关于你的预言。」"
                                },
                                {
                                    "id": "100070107",
                                    "speaker": "温迪",
                                    "text": "对么？",
                                    "choices": [
                                        {
                                            "id": "100070108",
                                            "text": "是的。",
                                            "response": [
                                                {
                                                    "id": "100070110",
                                                    "speaker": "温迪",
                                                    "text": "#哎呀？{NICKNAME}，稍等一下。"
                                                },
                                                {
                                                    "id": "100070111",
                                                    "speaker": "温迪",
                                                    "text": "嗯…看来芭比洛斯女士的求知欲还是这么强。可惜，我的「未来」恐怕无法记载进她的辞典里。"
                                                },
                                                {
                                                    "id": "100070112",
                                                    "speaker": "温迪",
                                                    "text": "毕竟，风虽然乐意被蒲公英描出形状，再任由诗人颂唱，但却并不愿真正地居留于某人之手。"
                                                },
                                                {
                                                    "id": "100070113",
                                                    "speaker": "温迪",
                                                    "text": "所以，尊敬的芭比洛斯女士，请你放下手中的笔吧。风中所传诵的那些辞藻，并不适合直接落笔成文。"
                                                },
                                                {
                                                    "id": "100070114",
                                                    "speaker": "温迪",
                                                    "text": "如果您真的对这一则神话感兴趣，那容我对这篇诗文做些润色，待到下次茶会时，再为各位女士吟诵。"
                                                },
                                                {
                                                    "id": "100070115",
                                                    "speaker": "Player",
                                                    "text": "芭比洛斯？她…"
                                                },
                                                {
                                                    "id": "100070116",
                                                    "speaker": "温迪",
                                                    "text": "哈哈哈，芭比洛斯女士向来通情达理，看来她已经听到了我的请求。"
                                                },
                                                {
                                                    "id": "100070117",
                                                    "speaker": "温迪",
                                                    "text": "现在，不会有人打扰我们的谈话了。"
                                                },
                                                {
                                                    "id": "100070118",
                                                    "speaker": "派蒙",
                                                    "text": "刚才芭比洛斯小姐在偷听？可，可我们什么也没发现呀…"
                                                },
                                                {
                                                    "id": "100070119",
                                                    "speaker": "温迪",
                                                    "text": "毕竟是魔女会的一员嘛，芭比洛斯小姐可是很厉害的。"
                                                },
                                                {
                                                    "id": "100070120",
                                                    "speaker": "派蒙",
                                                    "text": "可是你一下子就发现了，还把她请走了。卖唱的，那你不是比芭比洛斯小姐还厉害？"
                                                },
                                                {
                                                    "id": "100070121",
                                                    "speaker": "温迪",
                                                    "text": "嗯…考虑到各种现实因素，我应该也只能算是厉害得有限吧。"
                                                },
                                                {
                                                    "id": "100070122",
                                                    "speaker": "派蒙",
                                                    "text": "又是这副神神秘秘的样子。先说好喔，我们在魔女的那本辞典里，根本没发现和你有关的事。",
                                                    "choices": [
                                                        {
                                                            "id": "100070123",
                                                            "text": "她只是…",
                                                            "response": [
                                                                {
                                                                    "id": "100070125",
                                                                    "speaker": "温迪",
                                                                    "text": "这就足够了。不得不说，芭比洛斯女士对我的「预言」虽然并不完整，但也谈不上「错误」。"
                                                                },
                                                                {
                                                                    "id": "100070126",
                                                                    "speaker": "温迪",
                                                                    "text": "#我所要做的那件事，确实需要{NICKNAME}的协助。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "100070127",
                                                                            "text": "有什么事尽管说。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "100070129",
                                                                                    "speaker": "温迪",
                                                                                    "text": "喔，真是可靠，那么…"
                                                                                },
                                                                                {
                                                                                    "id": "100070130",
                                                                                    "speaker": "温迪",
                                                                                    "text": "#{NICKNAME}，稍后可以和我一起弹奏一首曲子么？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "100070131",
                                                                                            "text": "欸？可以是可以…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "100070133",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "是的，仅此而已。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070134",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "放心，这次的共奏邀请并不是出于命运的重压，或者是什么遥远的因果…而纯粹是出于我们之间的友谊。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070135",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "上次我亲手弹这首曲子时，唯一的听众是呼啸的狂风，它们把曲声席卷而去，只留下了零星的尾声。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070136",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "如今，既然我已经有了你这位友人，那又何必只让风独坐观众席呢？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070137",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "再说了，有你这位朋友在身边，我弹奏乐器的手，或许会更平稳一些。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070138",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "我会认真弹的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "100070139",
                                                                                                    "speaker": "温迪",
                                                                                                    "text": "好，那么我们先去演奏场吧。我们跟着风走，马上就能到。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "100070132",
                                                                                            "text": "但你只需要我做这件事么？"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "100070128",
                                                                            "text": "包在我身上。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "100070124",
                                                            "text": "让我来这里等待。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "100070109",
                                            "text": "但魔女依然要我来找你…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "100070105",
                            "text": "但我其实…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1000704",
            "objective": "与温迪一同循风前进",
            "dialogues": [
                {
                    "id": "100070401",
                    "speaker": "Player",
                    "text": "这座岛…"
                },
                {
                    "id": "100070402",
                    "speaker": "Player",
                    "text": "有什么特别的吗？"
                },
                {
                    "id": "100070403",
                    "speaker": "温迪",
                    "text": "这座岛屿本身并无特殊之处，它和大部分岛屿一样，都只是普通砂石的聚合。"
                },
                {
                    "id": "100070404",
                    "speaker": "温迪",
                    "text": "直到，风带来了故事的种子，时间使它在这座岛上生根发芽。"
                },
                {
                    "id": "100070405",
                    "speaker": "温迪",
                    "text": "尔后，风带来了新的故事，时间使它在这座岛外成为神话。"
                },
                {
                    "id": "100070406",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}，欢迎你「真正」登上这座被「时间」所青睐的小岛。"
                },
                {
                    "id": "100070407",
                    "speaker": "温迪",
                    "text": "在久远的过去，时与风曾在此交汇。"
                },
                {
                    "id": "100070408",
                    "speaker": "派蒙",
                    "text": "等一下等一下，卖唱的…你突然好严肃，说的话也好难懂喔…"
                },
                {
                    "id": "100070409",
                    "speaker": "温迪",
                    "text": "哎呀，别急嘛小派蒙，一篇好故事的开头总是要起点高调，留点悬念。"
                }
            ]
        },
        {
            "id": "1000702",
            "objective": "与温迪一同循风前进",
            "dialogues": [
                {
                    "id": "100070201",
                    "speaker": "派蒙",
                    "text": "欸？这座岛怎么看着有点眼熟…"
                }
            ]
        },
        {
            "id": "1000703",
            "objective": "与温迪合奏",
            "dialogues": [
                {
                    "id": "100071201",
                    "speaker": "温迪",
                    "text": "不过，猛烈的狂风只适合扫清屋子，却不适合吹拂万物生长。"
                },
                {
                    "id": "100071202",
                    "speaker": "温迪",
                    "text": "在为蒙德城处理了几场危机后，我就把风变得温和了一些，让它既足以为蒙德人鼓起勇气，又不至于让他们在风中踉跄。",
                    "choices": [
                        {
                            "id": "100071203",
                            "text": "那你这次来…",
                            "response": [
                                {
                                    "id": "100071205",
                                    "speaker": "温迪",
                                    "text": "……"
                                },
                                {
                                    "id": "100071206",
                                    "speaker": "温迪",
                                    "text": "#阴影正在远方聚集。你应该也已经感受到了，{NICKNAME}。"
                                },
                                {
                                    "id": "100071207",
                                    "speaker": "温迪",
                                    "text": "火之神与「死之执政」若娜瓦正面对峙…还有愚人众执行官「队长」的事，我都已经听见了风声。"
                                },
                                {
                                    "id": "100071208",
                                    "speaker": "温迪",
                                    "text": "而且，深渊的活动范围已经逼近了蒙德。"
                                },
                                {
                                    "id": "100071209",
                                    "speaker": "温迪",
                                    "text": "即将到来的这场危机，可能并非人力可以独挡…我也要提前做些准备了。"
                                },
                                {
                                    "id": "100071210",
                                    "speaker": "温迪",
                                    "text": "在必要的时候，我作为蒙德城的风之神「巴巴托斯」，会为蒙德扬起足以吹散任何阴霾的风。"
                                },
                                {
                                    "id": "100071211",
                                    "speaker": "温迪",
                                    "text": "不过，如果我贸然在蒙德城里扬起狂风，只怕会吹翻大家的衣服、帽子，还有放在阳台上的花。"
                                },
                                {
                                    "id": "100071212",
                                    "speaker": "温迪",
                                    "text": "所以，我将这一次的「风起之地」选在了这座岛上。我曾经在这里，为「时间」献上过颂歌。"
                                },
                                {
                                    "id": "100071213",
                                    "speaker": "温迪",
                                    "text": "也许是我弹的曲子太好听了吧，所以这座小岛似乎格外被「时间」所青睐。"
                                },
                                {
                                    "id": "100071214",
                                    "speaker": "派蒙",
                                    "text": "真的？这座岛有这么特别吗…可是我们之前看它的时候，好像没发现什么特别之处啊…"
                                },
                                {
                                    "id": "100071215",
                                    "speaker": "派蒙",
                                    "text": "有时候被涨起来的潮水淹没，有时候落着很多鸟…怎么看都很普通啊。"
                                },
                                {
                                    "id": "100071216",
                                    "speaker": "温迪",
                                    "text": "「时间」对事物的影响并不流于表面。嗯…就像是一枚熟透了的日落果。"
                                },
                                {
                                    "id": "100071217",
                                    "speaker": "温迪",
                                    "text": "它的外皮毫无破损时，如果不是专业人士，几乎没办法发觉它内部的果肉已经熟透了。"
                                },
                                {
                                    "id": "100071218",
                                    "speaker": "温迪",
                                    "text": "不过，如果你在它的表皮上扎一个孔，这枚本就熟透了的日落果就会顺着孔洞开始飞速朽烂…"
                                },
                                {
                                    "id": "100071219",
                                    "speaker": "温迪",
                                    "text": "在「时间」的手下，这座岛屿的「外皮」没有任何孔洞，任何人都无法察觉到「时间」对于它本质的影响。"
                                },
                                {
                                    "id": "100071220",
                                    "speaker": "温迪",
                                    "text": "但从本质上来说，任何不为「时间」所喜的痕迹，都会被磨洗殆尽。"
                                },
                                {
                                    "id": "100071221",
                                    "speaker": "温迪",
                                    "text": "所以，我正好借助一下存留于此地的力量，以「时间」为「风」划定界限。"
                                },
                                {
                                    "id": "100071222",
                                    "speaker": "温迪",
                                    "text": "这样的话，即使我在这座岛上扬起再大的风声，外界也不会察觉到半点。"
                                },
                                {
                                    "id": "100071223",
                                    "speaker": "温迪",
                                    "text": "#当然啦，拜托人帮忙当然要准备好谢礼。{NICKNAME}，我们一起合奏一曲，为「时间」献上一首颂歌吧。"
                                },
                                {
                                    "id": "100071224",
                                    "speaker": "温迪",
                                    "text": "#{NICKNAME}，准备好合奏了就告诉我，没有乐器的话，我也可以借你一把。"
                                }
                            ]
                        },
                        {
                            "id": "100071204",
                            "text": "是想要重新让风…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1000710",
            "objective": "与温迪合奏",
            "dialogues": [
                {
                    "id": "100071001",
                    "speaker": "温迪",
                    "text": "在之前，我曾为蒙德鼓起了最初的自由之风。在那股风的协力下，所有应得自由之人，都重获自由。"
                }
            ]
        },
        {
            "id": "1000708",
            "objective": "与温迪合奏",
            "dialogues": [
                {
                    "id": "100072001",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "1000705",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "100070501",
                    "speaker": "温迪",
                    "text": "看来，我们演奏的乐曲太过动听，有不少观众想要临时入场了。"
                },
                {
                    "id": "100070502",
                    "speaker": "温迪",
                    "text": "这可不太符合规矩，我们一起将它们请出去吧。"
                }
            ]
        },
        {
            "id": "1000709",
            "objective": "击败出现的魔物",
            "dialogues": []
        },
        {
            "id": "1000712",
            "objective": "击败出现的魔物",
            "dialogues": []
        },
        {
            "id": "1000706",
            "objective": "击败出现的魔物",
            "dialogues": []
        },
        {
            "id": "1000711",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "100071101",
                    "speaker": "温迪",
                    "text": "之前我不是说过，我曾在「千风神殿」偶遇了「时间」，并且得到了助力么？"
                },
                {
                    "id": "100071102",
                    "speaker": "温迪",
                    "text": "正是因为有了「时间」的协力，最初的那股自由之风，才能鼓动得如此强劲。"
                }
            ]
        },
        {
            "id": "1000707",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "100070701",
                    "speaker": "温迪",
                    "text": "#好了，到此为止。真是一场优美的合奏，多谢啦，{NICKNAME}。"
                },
                {
                    "id": "100070702",
                    "speaker": "Player",
                    "text": "你刚才使出的力量…"
                },
                {
                    "id": "100070703",
                    "speaker": "温迪",
                    "text": "不用担心，刚才你所看见的力量，纯粹出自我自身，并非来自外人，也没有借助任何外物。"
                },
                {
                    "id": "100070704",
                    "speaker": "温迪",
                    "text": "要打个比方的话，就像是…给一架乐器调了调音，让它能够演奏出更动听的乐曲吧。"
                },
                {
                    "id": "100070705",
                    "speaker": "派蒙",
                    "text": "哇，你果然藏着一手！等一下，你不会还藏着更多手吧？"
                },
                {
                    "id": "100070706",
                    "speaker": "温迪",
                    "text": "唉，小派蒙，我真的只有两只手，不信你看。"
                },
                {
                    "id": "100070707",
                    "speaker": "派蒙",
                    "text": "卖！唱！的！"
                },
                {
                    "id": "100070708",
                    "speaker": "温迪",
                    "text": "哈哈哈哈哈，今天的风也许会很大，我们还是赶紧回蒙德城，提醒大家收收衣服吧。"
                }
            ]
        },
        {
            "id": "1000703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100070301",
                    "speaker": "派蒙",
                    "text": "我还以为要飞很远，原来就在蒙德城旁边啊…"
                }
            ]
        },
        {
            "id": "1000713",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100071301",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "100071302",
                    "speaker": "温迪",
                    "text": "嗯。那我们就开始合奏吧。"
                }
            ]
        },
        {
            "id": "1000714",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "100071401",
                    "speaker": "Player",
                    "text": "还有事要处理…"
                },
                {
                    "id": "100071402",
