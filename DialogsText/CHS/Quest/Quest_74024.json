    "talks": [
        {
            "id": "7402408",
            "objective": "提瓦特过一天$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7402409",
            "objective": "",
            "dialogues": [
                {
                    "id": "740240901",
                    "speaker": "希露艾",
                    "text": "那么，您所说的「接近太阳色彩的东西」是…"
                }
            ]
        },
        {
            "id": "7402410",
            "objective": "",
            "dialogues": [
                {
                    "id": "740241001",
                    "speaker": "希露艾",
                    "text": "原来如此…这就是被称作「石珀」的材料吗。"
                },
                {
                    "id": "740241002",
                    "speaker": "希露艾",
                    "text": "很温暖…又香又软，简直就像是太阳一般温柔。这应该就是人类用来烹饪的食材吧。非常感谢，我会铭记于心的。"
                },
                {
                    "id": "740241003",
                    "speaker": "派蒙",
                    "text": "你到底是怎么看出来的啊？"
                }
            ]
        },
        {
            "id": "7402401",
            "objective": "（test）找希露艾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740240101",
                    "speaker": "派蒙",
                    "text": "咦，你一个人在这里做什么呢？"
                },
                {
                    "id": "740240102",
                    "speaker": "希露艾",
                    "text": "哇啊！不要突然从别人背后搭话呀，差一点就把磨好的粉末给弄撒了…"
                },
                {
                    "id": "740240103",
                    "speaker": "派蒙",
                    "text": "粉末？唔，这些东西是…"
                },
                {
                    "id": "740240104",
                    "speaker": "希露艾",
                    "text": "是宝石喔。"
                },
                {
                    "id": "740240105",
                    "speaker": "派蒙",
                    "text": "宝、宝石？为什么这里会有宝石啊？"
                },
                {
                    "id": "740240106",
                    "speaker": "希露艾",
                    "text": "没有宝石才比较奇怪吧？毕竟，这里是我用来处理宝石的工坊嘛，虽然还没有正式名字。"
                },
                {
                    "id": "740240107",
                    "speaker": "希露艾",
                    "text": "之前也想过，干脆直接叫「希露艾工坊」之类的，但用自己的名字命名，果然还是不太合适吧。"
                },
                {
                    "id": "740240108",
                    "speaker": "Player",
                    "text": "处理宝石？"
                },
                {
                    "id": "740240109",
                    "speaker": "希露艾",
                    "text": "就是把宝石变成各种各样漂亮的饰品…之类的？"
                },
                {
                    "id": "740240110",
                    "speaker": "希露艾",
                    "text": "不过，最近一段时间，我应该也没办法再接受新的委托了，因为需要全心全意制作颜料…虽然也是用宝石。"
                },
                {
                    "id": "740240111",
                    "speaker": "派蒙",
                    "text": "用、用宝石来制作颜料？！"
                },
                {
                    "id": "740240112",
                    "speaker": "希露艾",
                    "text": "嗯？怎么了吗？"
                },
                {
                    "id": "740240113",
                    "speaker": "派蒙",
                    "text": "唔，总觉得好浪费…不需要宝石的话，其实可以直接给我的…"
                },
                {
                    "id": "740240114",
                    "speaker": "派蒙",
                    "text": "不过，为什么要制作颜料呢？用宝石打造饰品的过程中，应该不需要这样的步骤才对…"
                },
                {
                    "id": "740240115",
                    "speaker": "希露艾",
                    "text": "之前，有个喜欢画画的孩子来问过我，能不能做出像宝石一样闪耀，像太阳一样璀璨的颜料。"
                },
                {
                    "id": "740240116",
                    "speaker": "希露艾",
                    "text": "而就在前段时间，村子晃得很厉害的时候，她救下了我的妹妹。"
                },
                {
                    "id": "740240117",
                    "speaker": "希露艾",
                    "text": "所以，我希望能实现她的心愿，做出「像太阳一样璀璨的颜料」，作为答谢她的礼物。"
                },
                {
                    "id": "740240118",
                    "speaker": "Player",
                    "text": "你说的难道是…"
                },
                {
                    "id": "740240119",
                    "speaker": "派蒙",
                    "text": "…喂，你说的那个「喜欢画画的孩子」，该不会是叫玛梅赫吧？"
                },
                {
                    "id": "740240120",
                    "speaker": "希露艾",
                    "text": "…？是的…二位认识她吗？"
                },
                {
                    "id": "740240121",
                    "speaker": "Black Screen",
                    "text": "向希露艾讲述了此前与玛梅赫一同经历的事情…"
                },
                {
                    "id": "740240122",
                    "speaker": "希露艾",
                    "text": "#难、难道说，二位就是与玛梅赫一起救了芙佳的{NICKNAME}大人和派蒙大人吗？"
                },
                {
                    "id": "740240123",
                    "speaker": "派蒙",
                    "text": "大、大人…？",
                    "choices": [
                        {
                            "id": "740240124",
                            "text": "是我。",
                            "response": [
                                {
                                    "id": "740240126",
                                    "speaker": "希露艾",
                                    "text": "真的非常感谢二位…！要不是二位的话，芙佳可能就会…"
                                },
                                {
                                    "id": "740240127",
                                    "speaker": "希露艾",
                                    "text": "如果不介意的话，请一定要收下这些…！",
                                    "choices": [
                                        {
                                            "id": "740240128",
                                            "text": "（漂亮的宝石…）",
                                            "response": [
                                                {
                                                    "id": "740240129",
                                                    "speaker": "派蒙",
                                                    "text": "#可以收下吗，{NICKNAME}？看上去好像很贵…"
                                                },
                                                {
                                                    "id": "740240131",
                                                    "speaker": "派蒙",
                                                    "text": "不过，没想到那个玛梅赫居然还会主动委托别人…"
                                                },
                                                {
                                                    "id": "740240132",
                                                    "speaker": "希露艾",
                                                    "text": "倒也不能算是委托吧？毕竟，她只是问我能不能做出来，我还没回答完，她就直接跑掉了…"
                                                },
                                                {
                                                    "id": "740240133",
                                                    "speaker": "派蒙",
                                                    "text": "这个，确实很像是玛梅赫会做出来的事…"
                                                },
                                                {
                                                    "id": "740240134",
                                                    "speaker": "希露艾",
                                                    "text": "#说起来，{NICKNAME}大人、派蒙大人…"
                                                },
                                                {
                                                    "id": "740240135",
                                                    "speaker": "希露艾",
                                                    "text": "在二位看来，「最接近太阳色彩的东西」是什么呢？"
                                                },
                                                {
                                                    "id": "740240136",
                                                    "speaker": "希露艾",
                                                    "text": "虽然我也试着观察过太阳的模样，但我不太清楚，究竟要用什么样的材料，才能重现出那样的色彩…"
                                                },
                                                {
                                                    "id": "740240137",
                                                    "speaker": "派蒙",
                                                    "text": "唔，「接近太阳色彩的东西」…",
                                                    "choices": [
                                                        {
                                                            "id": "740240138",
                                                            "text": "…黄金？",
                                                            "response": [
                                                                {
                                                                    "id": "740240139",
                                                                    "speaker": "希露艾",
                                                                    "text": "嗯，夏诺蒂拉之前也说过，「黄金是太阳滴落的泪水」什么的…"
                                                                },
                                                                {
                                                                    "id": "740240140",
                                                                    "speaker": "派蒙",
                                                                    "text": "不过，用黄金做颜料，未免也有点太奢侈了吧？应该还有更普通的替代品…"
                                                                },
                                                                {
                                                                    "id": "740240148",
                                                                    "speaker": "派蒙",
                                                                    "text": "总之，说到「接近太阳色彩的东西」，我们应该见过才对，而且应该是很常见的东西…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740240141",
                                                            "text": "…太阳？",
                                                            "response": [
                                                                {
                                                                    "id": "740240142",
                                                                    "speaker": "希露艾",
                                                                    "text": "…原来如此。不愧是您。最接近太阳色彩的东西，确实是太阳本身。"
                                                                },
                                                                {
                                                                    "id": "740240143",
                                                                    "speaker": "希露艾",
                                                                    "text": "但是，要怎么才能把太阳磨成粉末呢…"
                                                                },
                                                                {
                                                                    "id": "740240144",
                                                                    "speaker": "派蒙",
                                                                    "text": "不，别一本正经地说出这种莫名其妙的话啊！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740240145",
                                                            "text": "既然如此，就用我的头发…",
                                                            "response": [
                                                                {
                                                                    "id": "740240146",
                                                                    "speaker": "希露艾",
                                                                    "text": "…嗯？"
                                                                },
                                                                {
                                                                    "id": "740240147",
                                                                    "speaker": "派蒙",
                                                                    "text": "不，再怎么说头发也没法用来做颜料吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740240130",
                                            "text": "谢谢。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740240125",
                            "text": "虽然称不上是「大人」…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402402",
            "objective": "（test）提交黄色材料$HIDDEN",
            "dialogues": [
                {
                    "id": "740240201",
                    "speaker": "希露艾",
                    "text": "那么，您所说的「<color=#00E1FFFF>接近太阳色彩</color>的东西」是…"
                }
            ]
        },
        {
            "id": "7402403",
            "objective": "（test）与希露艾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740240315",
                    "speaker": "Black Screen",
                    "text": "希露艾仔细观察了材料的样子，随后将它交还给了你们…"
                },
                {
                    "id": "740240301",
                    "speaker": "希露艾",
                    "text": "总之，非常感谢二位的帮助。"
                },
                {
                    "id": "740240302",
                    "speaker": "希露艾",
                    "text": "#但是，{NICKNAME}大人，我不能随便拿走您的东西。所以，只要知道材料的名字就好了，我之后会自己想办法找来的。"
                },
                {
                    "id": "740240303",
                    "speaker": "希露艾",
                    "text": "只不过，这样的色彩会不会有些太浓了呢？"
                },
                {
                    "id": "740240304",
                    "speaker": "希露艾",
                    "text": "「太阳的色彩」，应该比这个更淡一些…"
                },
                {
                    "id": "740240305",
                    "speaker": "派蒙",
                    "text": "更淡一些，是说偏白吗？"
                },
                {
                    "id": "740240306",
                    "speaker": "派蒙",
                    "text": "这么一说，比起「金色」，「太阳」好像确实更接近「白色」…"
                },
                {
                    "id": "740240307",
                    "speaker": "希露艾",
                    "text": "「白色」…是吗？不过，我不清楚，究竟要用什么样的材料，才能制作出那种更淡的色彩…",
                    "choices": [
                        {
                            "id": "740240308",
                            "text": "不能直接掺水吗？",
                            "response": [
                                {
                                    "id": "740240309",
                                    "speaker": "希露艾",
                                    "text": "掺水的话…之前也尝试过，但效果并不是太好。用这种方法做出来的颜料，总是灰蒙蒙的，没有太阳那种明亮的感觉…"
                                },
                                {
                                    "id": "740240310",
                                    "speaker": "希露艾",
                                    "text": "所以，如果可以的话，还是希望用其他材料作为辅助…"
                                },
                                {
                                    "id": "740240314",
                                    "speaker": "派蒙",
                                    "text": "不过，明亮的、白色的东西，我们应该也经常能见到…"
                                }
                            ]
                        },
                        {
                            "id": "740240311",
                            "text": "既然如此，就用派蒙的头发…",
                            "response": [
                                {
                                    "id": "740240312",
                                    "speaker": "派蒙",
                                    "text": "头发是没有办法做颜料的啦！"
                                },
                                {
                                    "id": "740240313",
                                    "speaker": "派蒙",
                                    "text": "不对，就算真的能做，也不能随便拔我的头发吧？！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402404",
            "objective": "（test）提交白色材料$HIDDEN",
            "dialogues": [
                {
                    "id": "740240401",
                    "speaker": "希露艾",
                    "text": "「<color=#00E1FFFF>白色的</color>东西」…是什么呢？"
                }
            ]
        },
        {
            "id": "7402405",
            "objective": "（test）与希露艾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740240516",
                    "speaker": "Black Screen",
                    "text": "希露艾仔细观察了材料的样子，随后将它交还给了你们…"
                },
                {
                    "id": "740240501",
                    "speaker": "希露艾",
                    "text": "原来如此，这种颜色，就是您所说的「白色」吗？"
                },
                {
                    "id": "740240502",
                    "speaker": "希露艾",
                    "text": "总觉得和「太阳的色彩」完全相反呢…要是使用「与之相反的颜色」，会不会更合适呢？"
                },
                {
                    "id": "740240503",
                    "speaker": "派蒙",
                    "text": "「相反的颜色」…是说黑色吗？"
                },
                {
                    "id": "740240504",
                    "speaker": "希露艾",
                    "text": "「黑色」…没错，应该是「黑色」。不愧是派蒙大人。太阳的颜色，应该就是「黑色」才对。",
                    "choices": [
                        {
                            "id": "740240505",
                            "text": "总觉得有哪里不太对…",
                            "response": [
                                {
                                    "id": "740240508",
                                    "speaker": "派蒙",
                                    "text": "说到底，为什么会想到黑色啊？",
                                    "choices": [
                                        {
                                            "id": "740240509",
                                            "text": "太阳是金色的。",
                                            "response": [
                                                {
                                                    "id": "740240512",
                                                    "speaker": "希露艾",
                                                    "text": "能拜托二位最后一件事吗？"
                                                },
                                                {
                                                    "id": "740240513",
                                                    "speaker": "希露艾",
                                                    "text": "希望二位能带给我一件「黑色」的东西。如此一来，我就知道应该用什么材料来制作出「像太阳一样璀璨的色彩」了。"
                                                },
                                                {
                                                    "id": "740240514",
                                                    "speaker": "派蒙",
                                                    "text": "真的要找吗？我觉得这个东西已经和太阳没有什么关系了…"
                                                },
                                                {
                                                    "id": "740240515",
                                                    "speaker": "派蒙",
                                                    "text": "#不过，既然她都这么要求了…{NICKNAME}，就找一件「黑色的东西」给她看看吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740240510",
                                            "text": "如果是晚上的太阳…",
                                            "response": [
                                                {
                                                    "id": "740240511",
                                                    "speaker": "派蒙",
                                                    "text": "就算在晚上也不会变成黑色啦！倒不如说，晚上哪来的太阳啊！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740240506",
                            "text": "不愧是派蒙大人！",
                            "response": [
                                {
                                    "id": "740240507",
                                    "speaker": "派蒙",
                                    "text": "你就别跟着起哄啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402406",
            "objective": "（test）提交黑色材料$HIDDEN",
            "dialogues": [
                {
                    "id": "740240601",
                    "speaker": "希露艾",
                    "text": "有了「<color=#00E1FFFF>黑色的</color>东西」，就可以调配出「像太阳一样璀璨的色彩」了…"
                }
            ]
        },
        {
            "id": "7402407",
            "objective": "（test）与希露艾对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740240712",
                    "speaker": "Black Screen",
                    "text": "希露艾仔细观察了材料的样子，随后将它交还给了你们…"
                },
                {
                    "id": "740240701",
                    "speaker": "希露艾",
                    "text": "非常感谢。这样一来，我就能顺利制作出拥有「如同太阳一般璀璨」的颜料，作为礼物送给她了。"
                },
                {
                    "id": "740240702",
                    "speaker": "派蒙",
                    "text": "真的能顺利吗…？"
                },
                {
                    "id": "740240703",
                    "speaker": "派蒙",
                    "text": "倒不如说…用这种原料，真的能调配出「璀璨的色彩」吗…",
                    "choices": [
                        {
                            "id": "740240704",
                            "text": "应该不行吧…",
                            "response": [
                                {
                                    "id": "740240705",
                                    "speaker": "派蒙",
                                    "text": "不过，希露艾看上去倒是挺开心的样子…"
                                },
                                {
                                    "id": "740240708",
                                    "speaker": "希露艾",
                                    "text": "无论如何，非常感谢二位。"
                                },
                                {
                                    "id": "740240709",
                                    "speaker": "希露艾",
                                    "text": "作为谢礼，请务必收下这些…"
                                },
                                {
                                    "id": "740240710",
                                    "speaker": "派蒙",
                                    "text": "是、是亮闪闪的宝石！还有零件！"
                                },
                                {
                                    "id": "740240711",
                                    "speaker": "希露艾",
                                    "text": "呵呵…您能喜欢真是太好了。之后，如果有什么想要的饰品，也可以随时过来找我哦。"
                                }
                            ]
                        },
                        {
                            "id": "740240706",
                            "text": "也不是没有这种可能…",
                            "response": [
                                {
                                    "id": "740240707",
                                    "speaker": "派蒙",
