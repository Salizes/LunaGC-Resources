    "talks": [
        {
            "id": "7502201",
            "objective": "(test)发现宝箱与龙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750221001",
                    "speaker": "奇怪的匿叶龙",
                    "text": "……"
                },
                {
                    "id": "750221002",
                    "speaker": "派蒙",
                    "text": "呜哇，虽然洞穴内有宝藏，但是这家伙把洞穴的入口堵得严严实实，完全不肯让开…"
                },
                {
                    "id": "750221003",
                    "speaker": "奇怪的匿叶龙",
                    "text": "昂呜？"
                },
                {
                    "id": "750221004",
                    "speaker": "派蒙",
                    "text": "嗯，怎么了？"
                },
                {
                    "id": "750221005",
                    "speaker": "奇怪的匿叶龙",
                    "text": "昂呜…"
                },
                {
                    "id": "750221006",
                    "speaker": "派蒙",
                    "text": "#它是在说什么？唔，完全听不懂啦，{REALNAME[ID(2)|SHOWHOST(true)]}你能听懂这只匿叶龙想说什么吗？"
                },
                {
                    "id": "750221007",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯唔？"
                },
                {
                    "id": "750221008",
                    "speaker": "奇怪的匿叶龙",
                    "text": "？"
                },
                {
                    "id": "750221009",
                    "speaker": "派蒙",
                    "text": "#看上去好像不行呢…哎，不过就算它们互相理解，我们也没办法和{REALNAME[ID(2)|SHOWHOST(true)]}说话。"
                },
                {
                    "id": "750221010",
                    "speaker": "派蒙",
                    "text": "要是能知道匿叶龙想要什么就好了，说不定给它想要的东西，它就能把路让开了。"
                }
            ]
        },
        {
            "id": "7502206",
            "objective": "寻找与匿叶龙沟通的方法",
            "dialogues": [
                {
                    "id": "750220606",
                    "speaker": "派蒙",
                    "text": "你们刚才叽里咕噜的说什么呀？"
                },
                {
                    "id": "750220607",
                    "speaker": "奇怪的匿叶龙",
                    "text": "（咕——）"
                },
                {
                    "id": "750220608",
                    "speaker": "派蒙",
                    "text": "咦，难道是肚子饿了？"
                },
                {
                    "id": "750220609",
                    "speaker": "派蒙",
                    "text": "它一只龙孤零零地在这里，主人也不见了，估计也没有办法自己去觅食…"
                },
                {
                    "id": "750220610",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们找点吃的喂给它吧！"
                },
                {
                    "id": "750220611",
                    "speaker": "派蒙",
                    "text": "等它吃饱了乖乖让开，宝藏就是我们的啦，嘿嘿…"
                },
                {
                    "id": "750220612",
                    "speaker": "Player",
                    "text": "喂它点什么好呢？"
                },
                {
                    "id": "750220613",
                    "speaker": "派蒙",
                    "text": "让我想想，纳塔这边的龙好像什么都会吃一点，也不知道匿叶龙都喜欢吃什么，看它的颜色，总觉得会喜欢吃什么草啊，叶子什么的…"
                },
                {
                    "id": "750220614",
                    "speaker": "派蒙",
                    "text": "先简单找一样试试看好了，饿了的家伙，大概不会挑食吧！"
                }
            ]
        },
        {
            "id": "7502202",
            "objective": "给匿叶龙投喂食物",
            "dialogues": [
                {
                    "id": "750220701",
                    "speaker": "派蒙",
                    "text": "嗯！嘿嘿，看上去就不错，这个它一定会喜欢吧！"
                },
                {
                    "id": "750220702",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750220703",
                    "speaker": "Black Screen",
                    "text": "眼前的匿叶龙一骨碌咽下了眼前的食物。\\n你甚至没看清它是怎么吃下去的…"
                }
            ]
        },
        {
            "id": "7502203",
            "objective": "与匿叶龙对话",
            "dialogues": [
                {
                    "id": "750220304",
                    "speaker": "派蒙",
                    "text": "它它它…好能吃！",
                    "choices": [
                        {
                            "id": "750220305",
                            "text": "派蒙这下有对手了。",
                            "response": [
                                {
                                    "id": "750220306",
                                    "speaker": "派蒙",
                                    "text": "什么呀！我对美食可是很讲究的，才不会这样狼吞虎咽、囫囵吞枣…根本连味道都吃不出来吧！"
                                },
                                {
                                    "id": "750220309",
                                    "speaker": "派蒙",
                                    "text": "不过，它是真的饿坏了吧！好可怜，不然再给它一份好了。"
                                },
                                {
                                    "id": "750220310",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "啊呜…"
                                },
                                {
                                    "id": "750220311",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想吃吗？我们先把这只龙龙喂饱，就给你吃好吃的！"
                                },
                                {
                                    "id": "750220312",
                                    "speaker": "Black Screen",
                                    "text": "很饿的龙一骨碌咽下了眼前的食物。\\n你眨眨眼睛，还以为是同样的画面出现了两次…"
                                },
                                {
                                    "id": "750220313",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，这下总应该吃饱了——"
                                },
                                {
                                    "id": "750220314",
                                    "speaker": "派蒙",
                                    "text": "喂！等等，你怎么又坐下来了！难道两份也不够吗？"
                                },
                                {
                                    "id": "750220315",
                                    "speaker": "派蒙",
                                    "text": "哇，吃饱了就趴下去睡，一点都不想让开这个洞穴的样子嘛！"
                                },
                                {
                                    "id": "750220316",
                                    "speaker": "派蒙",
                                    "text": "#怎么办呀{NICKNAME}，这家伙的行为我已经看不懂了…就算吃饱了要睡觉，也不要堵在洞口睡嘛！",
                                    "choices": [
                                        {
                                            "id": "750220317",
                                            "text": "它好像也没答应我们会让开。",
                                            "response": [
                                                {
                                                    "id": "750220319",
                                                    "speaker": "派蒙",
                                                    "text": "好生气，吃了我们那么多东西…"
                                                },
                                                {
                                                    "id": "750220320",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750220321",
                                                    "speaker": "派蒙",
                                                    "text": "#连{REALNAME[ID(2)|SHOWHOST(true)]}都看不过去了，{NICKNAME}，我们试试能不能把它叫醒吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750220318",
                                            "text": "总感觉被骗了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750220307",
                            "text": "一份食物…好像不够？",
                            "response": [
                                {
                                    "id": "750220308",
                                    "speaker": "派蒙",
                                    "text": "#是…是喔！没看出来，这家伙原来是只「大胃龙」，还好{REALNAME[ID(2)|SHOWHOST(true)]}没有这么能吃…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502204",
            "objective": "尝试与匿叶龙对话",
            "dialogues": [
                {
                    "id": "750220404",
                    "speaker": "派蒙",
                    "text": "唔…没办法把它叫醒吗，真是，气死人了！它不会是在故意装睡吧！"
                },
                {
                    "id": "750220405",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯唔？",
                    "choices": [
                        {
                            "id": "750220406",
                            "text": "睡倒是真的睡了…",
                            "response": [
                                {
                                    "id": "750220408",
                                    "speaker": "Player",
                                    "text": "（将梦话的内容说了出来…）"
                                },
                                {
                                    "id": "750220409",
                                    "speaker": "派蒙",
                                    "text": "你是说，它是故意堵在洞口要吃的？完全就是骗吃骗喝嘛…有种上当了的感觉…"
                                },
                                {
                                    "id": "750220410",
                                    "speaker": "派蒙",
                                    "text": "哼哼！不过既然这样，就别怪我们不客气了！"
                                },
                                {
                                    "id": "750220411",
                                    "speaker": "派蒙",
                                    "text": "#不如就让{REALNAME[ID(2)|SHOWHOST(true)]}钻进去，把那个宝箱取出来吧！"
                                },
                                {
                                    "id": "750220412",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750220413",
                                    "speaker": "派蒙",
                                    "text": "它不仁，也不能怪我们不义啦！"
                                }
                            ]
                        },
                        {
                            "id": "750220407",
                            "text": "说着梦话呢，不过…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502205",
            "objective": "让龙伙伴取走宝箱",
            "dialogues": []
        },
        {
            "id": "7502208",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "750220801",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "750220802",
                    "speaker": "派蒙",
                    "text": "嘿嘿，干得好！让我们看看宝箱里都有什么宝贝吧！"
                },
                {
                    "id": "750220803",
                    "speaker": "派蒙",
                    "text": "啊，什么都没有，怎么只有一张纸条？"
                },
                {
                    "id": "750220804",
                    "speaker": "派蒙",
                    "text": "原来留下纸条的才是它真正的主人？那，我们不是被这条龙骗了，是被它的主人骗了？",
                    "choices": [
                        {
                            "id": "750220805",
                            "text": "真是不负责任。",
                            "response": [
                                {
                                    "id": "750220806",
                                    "speaker": "派蒙",
                                    "text": "是啊，虽然他重病缠身，也不能把匿叶龙扔在这种地方！"
                                },
                                {
                                    "id": "750220807",
                                    "speaker": "派蒙",
                                    "text": "居然这样利用别人的贪心…不对，是利用对龙的同情心…"
                                },
                                {
                                    "id": "750220810",
                                    "speaker": "派蒙",
                                    "text": "唉，总而言之，总不能继续让它骗吃骗喝，不如去找悬木人的首领，告诉他这件事吧。"
                                },
                                {
                                    "id": "750220811",
                                    "speaker": "Black Screen",
                                    "text": "向「悬木人」的首领瓦伊纳述说此事，并将他带了过来。"
                                },
                                {
                                    "id": "750220812",
                                    "speaker": "瓦伊纳",
                                    "text": "哎呀呀，你们找我的时候我就有所预感…"
                                },
                                {
                                    "id": "750220813",
                                    "speaker": "瓦伊纳",
                                    "text": "没想到是「那个家伙」留下的龙。"
                                },
                                {
                                    "id": "750220814",
                                    "speaker": "Player",
                                    "text": "「那个家伙」？"
                                },
                                {
                                    "id": "750220815",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔嗯？"
                                },
                                {
                                    "id": "750220816",
                                    "speaker": "瓦伊纳",
                                    "text": "是个做了错事的人，因为害怕被惩罚，主动离开了部族。"
                                },
                                {
                                    "id": "750220817",
                                    "speaker": "瓦伊纳",
                                    "text": "不过，罪人的名字这里就不作赘述了。可能他也觉得不是什么好事吧，你看，他自己也未在这样的信件后留下名字。"
                                },
                                {
                                    "id": "750220818",
                                    "speaker": "Player",
                                    "text": "原来他的龙选择了和他一起…"
                                },
                                {
                                    "id": "750220819",
                                    "speaker": "瓦伊纳",
                                    "text": "不，不能说是选择，龙是单纯的生灵，不擅长衡量对错，大多数时候依照情感，信任着自己的伙伴。"
                                },
                                {
                                    "id": "750220820",
                                    "speaker": "瓦伊纳",
                                    "text": "…果然，他还是本性难移，有点小聪明都用在欺骗的伎俩上，用这种手段骗别人，也骗自己的龙。"
                                },
                                {
                                    "id": "750220821",
                                    "speaker": "瓦伊纳",
                                    "text": "我们会派人定期给这只匿叶龙喂点吃的，毕竟是部族的孩子…"
                                },
                                {
                                    "id": "750220822",
                                    "speaker": "瓦伊纳",
                                    "text": "至于「那个家伙」…哎呀呀，这还真是个悲惨的结局，不过我也不会同情他，人应该对自己的所作所为负责。"
                                }
                            ]
                        },
                        {
                            "id": "750220808",
                            "text": "所以吃得太多会被抛弃的…",
                            "response": [
                                {
                                    "id": "750220809",
                                    "speaker": "派蒙",
                                    "text": "哇！不要开这种玩笑啦！它也有点无辜呢，说不定还在原地呆呆地等着主人回来，这才不肯挪开的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502207",
            "objective": "(test)击败头套人",
            "dialogues": []
        },
        {
            "id": "7502209",
