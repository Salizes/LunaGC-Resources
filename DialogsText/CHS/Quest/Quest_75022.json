            "dialogues": [
                {
                    "id": "750220901",
                    "speaker": "派蒙",
                    "text": "欸…不喜欢吗？它不肯吃呢…"
                },
                {
                    "id": "750220902",
                    "speaker": "派蒙",
                    "text": "什么呀，都饿成这样了还挑食…唔，它到底想要吃什么样的东西呀？"
                }
            ]
        },
        {
            "id": "7502201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750220101",
                    "speaker": "奇怪的匿叶龙",
                    "text": "昂呜？"
                },
                {
                    "id": "750220102",
                    "speaker": "派蒙",
                    "text": "唔，你是有什么想要的东西吗…如果能知道它想要什么就好了。"
                }
            ]
        },
        {
            "id": "7502202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750220201",
                    "speaker": "奇怪的匿叶龙",
                    "text": "昂呜昂呜…咕咕…"
                }
            ]
        },
        {
            "id": "7502211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750221101",
                    "speaker": "奇怪的匿叶龙",
                    "text": "呼噜——呼噜——"
                },
                {
                    "id": "750221102",
                    "speaker": "派蒙",
                    "text": "好不讲道理的龙！居然睡得这么熟…啊啊，不光是只「大胃龙」，还是一只「赖皮龙」。"
                }
            ]
        },
        {
            "id": "7502212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750221201",
                    "speaker": "奇怪的匿叶龙",
                    "text": "想起来了，咕呜…想吃…有肉的那种…"
                }
            ]
        },
        {
            "id": "7502213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750221301",
                    "speaker": "奇怪的匿叶龙",
                    "text": "想吃…"
                },
                {
                    "id": "750221302",
                    "speaker": "Player",
                    "text": "想吃？"
                },
                {
                    "id": "750221303",
                    "speaker": "奇怪的匿叶龙",
                    "text": "肚子扁扁，肚子，热热…"
                },
                {
                    "id": "750221304",
                    "speaker": "奇怪的匿叶龙",
                    "text": "想吃——"
                }
            ]
        },
        {
            "id": "7502214",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750221401",
                    "speaker": "奇怪的匿叶龙",
                    "text": "呼呼…他说得对，只要堵在洞口…呼呼…就可以吃有肉的东西…"
                },
                {
                    "id": "750221402",
                    "speaker": "奇怪的匿叶龙",
                    "text": "（匿叶龙沉沉睡去，看来无法将它唤醒。）"
                }
            ]
        },
        {
