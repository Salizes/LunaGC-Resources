    "talks": [
        {
            "id": "7111001",
            "objective": "与合辙驿的方矩交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "711100101",
                    "speaker": "方矩",
                    "text": "两位是来参加「沉玉之旅」风光留影赛的吧？"
                },
                {
                    "id": "711100102",
                    "speaker": "派蒙",
                    "text": "风光留影赛？那是什么？"
                },
                {
                    "id": "711100103",
                    "speaker": "方矩",
                    "text": "顾名思义，是一个为了宣传沉玉谷美丽风光的留影比赛。"
                },
                {
                    "id": "711100104",
                    "speaker": "方矩",
                    "text": "早先我们发出了问卷，向广大居民收集沉玉谷最有魅力的风光点。而参赛者则需要前往被挑选出的地点，用留影机拍下对应的画片。"
                },
                {
                    "id": "711100105",
                    "speaker": "方矩",
                    "text": "最后我们会评选出一些优秀的画片，作为宣传示例，放在合辙驿外的大街公开展出。怎么样，两位有兴趣吗？",
                    "choices": [
                        {
                            "id": "711100106",
                            "text": "我是个俗人，有什么奖励吗？",
                            "response": [
                                {
                                    "id": "711100107",
                                    "speaker": "方矩",
                                    "text": "若您提交的作品成功入选，当然有一份专属于您的惊喜。"
                                },
                                {
                                    "id": "711100110",
                                    "speaker": "派蒙",
                                    "text": "哇！有惊喜！那我们一定要努力把惊喜拿到手！"
                                },
                                {
                                    "id": "711100111",
                                    "speaker": "方矩",
                                    "text": "呵呵，即便最后遗憾落选，我们也准备了一份小小的报酬，为两位所付出的时间与心力。希望能让两位满意。"
                                },
                                {
                                    "id": "711100112",
                                    "speaker": "Player",
                                    "text": "那要怎么开始？"
                                },
                                {
                                    "id": "711100113",
                                    "speaker": "方矩",
                                    "text": "请看看这份指南，里面是由沉玉谷居民们推荐的魅力风光点。"
                                },
                                {
                                    "id": "711100115",
                                    "speaker": "派蒙",
                                    "text": "咦？怎么还有些被划掉的地方呀？"
                                },
                                {
                                    "id": "711100116",
                                    "speaker": "方矩",
                                    "text": "呵呵，因为那些地点的报名人数已经满了，我们希望能更加全面地展示沉玉谷美景。"
                                },
                                {
                                    "id": "711100117",
                                    "speaker": "方矩",
                                    "text": "剩下这四处是仍然可以报名的地点，您可以从中任选一处或几处。"
                                },
                                {
                                    "id": "711100118",
                                    "speaker": "派蒙",
                                    "text": "#原来是这样…{NICKNAME}，不如我们把剩下的地方都包了吧！"
                                },
                                {
                                    "id": "711100119",
                                    "speaker": "派蒙",
                                    "text": "假如拍一张画片的获奖概率是四分之一，那我们拍四张，这样就是四分之四了！也就是一定能拿到获奖的惊喜！",
                                    "choices": [
                                        {
                                            "id": "711100120",
                                            "text": "不是这么算的吧。",
                                            "response": [
                                                {
                                                    "id": "711100121",
                                                    "speaker": "派蒙",
                                                    "text": "不是吗？可四分之一乘以四不就等于四分之四吗？"
                                                },
                                                {
                                                    "id": "711100122",
                                                    "speaker": "Player",
                                                    "text": "这倒是没错，但…"
                                                },
                                                {
                                                    "id": "711100124",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，那还说什么，我们现在就出发吧！为了最后的惊喜！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711100123",
                                            "text": "算的不错。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711100108",
                            "text": "很好，没人比我更擅长留影。",
                            "response": [
                                {
                                    "id": "711100109",
                                    "speaker": "方矩",
                                    "text": "看来您已经干劲满满了。请容我补充，若您提交的作品成功入选，我们还有一份专属于您的惊喜。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111003",
            "objective": "完成沉玉谷风光留影赛",
            "dialogues": [
                {
                    "id": "711100301",
                    "speaker": "渚春",
                    "text": "小友，你走南闯北，一定欣赏过不少奇景吧？"
                },
                {
                    "id": "711100302",
                    "speaker": "渚春",
                    "text": "不知道这次留影赛里的沉玉谷风光，能否更胜一筹呢？"
                }
            ]
        },
        {
            "id": "7111013",
            "objective": "(test)完成拍摄B$HIDDEN",
            "dialogues": [
                {
                    "id": "711101101",
                    "speaker": "派蒙",
                    "text": "小朋友，这只鹈鹕是你家的吗？我们能不能给它和翘英庄一起留个影？"
                },
                {
                    "id": "711101102",
                    "speaker": "明镜",
                    "text": "哼哼！哼哼唵唵哼哼！"
                },
                {
                    "id": "711101103",
                    "speaker": "派蒙",
                    "text": "咦？你在说什么？"
                },
                {
                    "id": "711101104",
                    "speaker": "明镜",
                    "text": "这是鹈鹕话啦，就是「好哦好哦！」的意思。"
                },
                {
                    "id": "711101105",
                    "speaker": "Player",
                    "text": "你会说鹈鹕话？"
                },
                {
                    "id": "711101106",
                    "speaker": "明镜",
                    "text": "只会一点点而已…因为我发现它们吃饭的时候，就会不停地「哼哼！哼哼唵唵哼哼！」"
                },
                {
                    "id": "711101107",
                    "speaker": "明镜",
                    "text": "一定就是在开心地说「好哦好哦」！"
                },
                {
                    "id": "711101108",
                    "speaker": "明镜",
                    "text": "所以后来我也学着这么叫，它们听见就会过来，大概是以为有东西可以吃了。"
                },
                {
                    "id": "711101109",
                    "speaker": "明镜",
                    "text": "你们想留影的话，也可以试试呼唤一下它们！可惜我也要回家了，不然还能多教教你们！"
                },
                {
                    "id": "711101110",
                    "speaker": "派蒙",
                    "text": "没关系啦，小朋友，我们自己试试就好啦，谢谢你哦~路上要注意安全！"
                },
                {
                    "id": "711101111",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们去那边试试吧，如果能引来鹈鹕，一定会为我们的作品添加胜算！"
                }
            ]
        },
        {
            "id": "7111004",
            "objective": "完成沉玉谷风光留影赛",
            "dialogues": []
        },
        {
            "id": "7111005",
            "objective": "完成沉玉谷风光留影赛",
            "dialogues": []
        },
        {
            "id": "7111011",
            "objective": "(test)完成拍摄D1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7111012",
            "objective": "(test)完成拍摄D2$HIDDEN",
            "dialogues": [
                {
                    "id": "711101301",
                    "speaker": "赤井",
                    "text": "等等！别过来！你们…你们是好人吗？"
                },
                {
                    "id": "711101302",
                    "speaker": "派蒙",
                    "text": "喂喂，刚刚可是我们救的你啊！你是不是脑袋撞到哪里了…"
                },
                {
                    "id": "711101303",
                    "speaker": "赤井",
                    "text": "啊！说的也是…实在不好意思，我这趟沉玉之旅太倒霉了，搞得我有点晕头转向…那，谢谢你们…"
                },
                {
                    "id": "711101304",
                    "speaker": "Player",
                    "text": "你也是来参加留影比赛的？"
                },
                {
                    "id": "711101305",
                    "speaker": "赤井",
                    "text": "你们也是吗？真巧，不过我只是个普通游客…拿那些丘丘人完全没办法。"
                },
                {
                    "id": "711101306",
                    "speaker": "赤井",
                    "text": "真是可恶，在路上碰上了它们，不由分说就把我掳了回来，难道丘丘人也会收过路费吗？真是岂有此理…还好遇上了你们。"
                },
                {
                    "id": "711101307",
                    "speaker": "派蒙",
                    "text": "啊…那你今天确实挺倒霉的。"
                },
                {
                    "id": "711101308",
                    "speaker": "赤井",
                    "text": "不仅是今天！昨天我也很倒霉，我在一个枫丹商人那里买了一台特别贵的留影机，结果没用几次就坏了，回去找他，他又不见了…"
                },
                {
                    "id": "711101309",
                    "speaker": "赤井",
                    "text": "真是无良商家…你们出门在外，也千万要捂好自己的钱包啊。"
                },
                {
                    "id": "711101310",
                    "speaker": "赤井",
                    "text": "对了，有些扯远了，既然你们也参加了沉玉之旅，那来这应该是为了给悬练山留影的吧？"
                },
                {
                    "id": "711101311",
                    "speaker": "赤井",
                    "text": "总之为了表示感谢，我把我研究过的最佳留影点位告诉你们吧，来，我来标注在你们的地图上。"
                },
                {
                    "id": "711101312",
                    "speaker": "赤井",
                    "text": "看，这里就能看到，就是那！"
                },
                {
                    "id": "711101313",
                    "speaker": "派蒙",
                    "text": "欸？那你自己呢？你不也是来参赛的吗？"
                },
                {
                    "id": "711101314",
                    "speaker": "赤井",
                    "text": "我觉得这附近还是很危险，最好还是换个地方，我记得指南上还有其它地点…我有点想去「仙人品茗」那里看看…"
                },
                {
                    "id": "711101315",
                    "speaker": "赤井",
                    "text": "嗯！那就这样吧，再会了两位，希望遇见你们是我转运的开始！"
                }
            ]
        },
        {
            "id": "7111006",
            "objective": "完成沉玉谷风光留影赛",
            "dialogues": []
        },
        {
            "id": "7111002",
            "objective": "(test)完成拍摄（完成3456）$HIDDEN",
            "dialogues": [
                {
                    "id": "711100201",
                    "speaker": "马里",
                    "text": "我亲爱的朋友，你也是来参加留影风光赛的吗？"
                },
                {
                    "id": "711100202",
                    "speaker": "马里",
                    "text": "作为一名从留影机的发源地走出的枫丹摄影师，让我给你们一个忠告：所谓留影，精髓中的精髓其实就在于留影机。"
                },
                {
                    "id": "711100203",
                    "speaker": "马里",
                    "text": "所以，我给你们介绍一个人吧，在我的家乡，他制作的留影机没有人不喜欢，价格也实惠，我手里就有购买渠道…"
                },
                {
                    "id": "711100204",
                    "speaker": "马里",
                    "text": "欸欸…别露出那种不感兴趣的表情啊，我再多给你们申请点折扣！"
                },
                {
                    "id": "711100205",
                    "speaker": "马里",
                    "text": "欸欸…别走啊！"
                }
            ]
        },
        {
            "id": "7111014",
            "objective": "(test)完成拍摄（保护）$HIDDEN",
            "dialogues": [
                {
                    "id": "711101401",
                    "speaker": "赤井",
                    "text": "让我想想，接下来应该去哪个地方呢。"
                }
            ]
        },
        {
            "id": "7111007",
            "objective": "返回合辙驿",
            "dialogues": [
                {
                    "id": "711100701",
                    "speaker": "方矩",
                    "text": "看到您这副悠然的神情，想必是来提交参赛画片的吧。请交给我就好。"
                },
                {
                    "id": "711100702",
                    "speaker": "方矩",
                    "text": "嗯，真不错，为了拍到这些特殊时刻的美景，一定等待了不少时间吧。辛苦了。"
                }
            ]
        },
        {
            "id": "7111008",
            "objective": "与方矩交谈",
            "dialogues": [
                {
                    "id": "711100801",
                    "speaker": "方矩",
                    "text": "唔…这些画片…"
                },
                {
                    "id": "711100802",
                    "speaker": "派蒙",
                    "text": "怎么了？我们的画片不够好吗？"
                },
                {
                    "id": "711100803",
                    "speaker": "方矩",
                    "text": "恰恰相反…虽说这几天我已经看到过很多佳作，但两位的作品依然让我耳目一新。"
                },
                {
                    "id": "711100805",
                    "speaker": "方矩",
                    "text": "比如这张翘英庄的画片，鹈鹕的加入为宁静的村庄增加了一丝活泼，一静一动的对比…真是别出心裁的想法。"
                },
                {
                    "id": "711100806",
                    "speaker": "方矩",
                    "text": "如果按照我的眼光，两位一定能够成功入选。"
                },
                {
                    "id": "711100807",
                    "speaker": "派蒙",
                    "text": "哇！居然是这么好的评价，说得我都有点不好意思了。",
                    "choices": [
                        {
                            "id": "711100808",
                            "text": "又不是你拍的，你不好意思什么。",
                            "response": [
                                {
                                    "id": "711100809",
                                    "speaker": "派蒙",
                                    "text": "我是替你不好意思一下嘛，我知道你谦虚着呢。"
                                },
                                {
                                    "id": "711100811",
                                    "speaker": "方矩",
                                    "text": "言归正传，我们的评选工作会在明早前完成。"
                                },
                                {
                                    "id": "711100812",
                                    "speaker": "方矩",
                                    "text": "明早八点至下午六点，我们会将入选作品公开展示，地点就在合辙驿外的大街。"
                                },
                                {
                                    "id": "711100813",
                                    "speaker": "方矩",
                                    "text": "感谢两位对本次「沉玉之旅」风光留影赛的支持。请不要忘记，明天要再来一趟哦。"
                                },
                                {
                                    "id": "711100814",
                                    "speaker": "派蒙",
                                    "text": "嗯！我们不会错过最后的惊喜的！"
                                }
                            ]
                        },
                        {
                            "id": "711100810",
                            "text": "说得我也有点不好意思了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111009",
            "objective": "等到第二天8-18点",
            "dialogues": [
                {
                    "id": "711100901",
                    "speaker": "方矩",
                    "text": "明早八点至下午六点，我们会将入选作品公开展示，地点就在合辙驿外的大街。两位不要忘记，明天要再来一趟哦。"
                }
            ]
        },
        {
            "id": "7111010",
            "objective": "去合辙驿外参观入选作品展",
            "dialogues": [
                {
                    "id": "711101001",
                    "speaker": "方矩",
                    "text": "两位，你们来了。"
                },
                {
                    "id": "711101002",
                    "speaker": "方矩",
                    "text": "看见这些展出的画片了吗？这次的「沉玉之旅」一共有八幅入选作品，你们包揽了其中一半。"
                },
                {
                    "id": "711101003",
                    "speaker": "方矩",
                    "text": "恭喜你们！"
                },
                {
                    "id": "711101004",
                    "speaker": "派蒙",
                    "text": "哇！这也太棒了吧？"
                },
                {
                    "id": "711101005",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！我就说吧，最后的结果是四分之四呢！我的算数真是越来越厉害了！",
                    "choices": [
                        {
                            "id": "711101006",
                            "text": "明明是八分之四吧。",
                            "response": [
                                {
                                    "id": "711101008",
                                    "speaker": "方矩",
                                    "text": "呵呵，就和我昨天的看法类似，评委们对你们另外两幅作品也赞赏有加。"
                                },
                                {
                                    "id": "711101009",
                                    "speaker": "方矩",
                                    "text": "所以，请收好这份限量版「沉玉之旅」留影纪念册，里面收录了这次的全部入选作品。这是你们应得的。"
                                },
                                {
                                    "id": "711101010",
                                    "speaker": "派蒙",
                                    "text": "这就是惊喜吗？看起来很漂亮呢！"
                                },
                                {
                                    "id": "711101011",
                                    "speaker": "方矩",
                                    "text": "如果不嫌弃的话，我这里还有一些摩拉，请收下吧。我要再次感谢你们的支持，这次是以私人的身份。"
                                },
                                {
                                    "id": "711101012",
                                    "speaker": "方矩",
                                    "text": "因为这里是我的家乡，你们把她美丽动人的地方永远地记录了下来，这些画片一定会让更多人喜欢上这里吧。"
                                },
                                {
                                    "id": "711101013",
                                    "speaker": "方矩",
                                    "text": "谢谢你们。"
                                }
                            ]
                        },
                        {
                            "id": "711101007",
                            "text": "哇！派蒙真是太会算数了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711101201",
                    "speaker": "派蒙",
                    "text": "来试试呼唤鹈鹕们吧。",
                    "choices": [
                        {
                            "id": "711101202",
                            "text": "「唵唵！哼哼唵唵哼哼！」"
                        },
                        {
                            "id": "711101203",
                            "text": "「哼哼！哼哼唵唵哼哼！」"
                        },
                        {
                            "id": "711101204",
                            "text": "「嘎嘎，派蒙，嘎嘎。」"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711101501",
                    "speaker": "马里",
                    "text": "哎呀！那个稻妻冤大头怎么也在，我得假装没看见他才行…还好有个璃月人挡在中间，他应该没看见我吧。"
                },
                {
                    "id": "711101502",
                    "speaker": "马里",
                    "text": "可恶，这些风景画片怎么就这么赏心悦目呢？害得我都不舍得立刻走掉…"
