    "talks": [
        {
            "id": "2302901",
            "objective": "与雅丝敏对话",
            "dialogues": [
                {
                    "id": "230290101",
                    "speaker": "雅丝敏",
                    "text": "也差不多是时候了…"
                },
                {
                    "id": "230290102",
                    "speaker": "Player",
                    "text": "你还在研究圣树根系吗？"
                },
                {
                    "id": "230290103",
                    "speaker": "雅丝敏",
                    "text": "旅行者，每次你都来得这么巧。"
                },
                {
                    "id": "230290104",
                    "speaker": "雅丝敏",
                    "text": "非常感谢你之前的帮助，圣树的情况非常好。"
                },
                {
                    "id": "230290105",
                    "speaker": "雅丝敏",
                    "text": "我和拉德普讨论过后，认为这种好情况还会保持很长一段时间。"
                },
                {
                    "id": "230290106",
                    "speaker": "雅丝敏",
                    "text": "这下我们终于可以腾出手来，为我们的论文做一些准备工作了。"
                },
                {
                    "id": "230290107",
                    "speaker": "雅丝敏",
                    "text": "瞧，我从法尔希那边借来了一部「留影机」，正准备去记录一下圣树的情况。"
                },
                {
                    "id": "230290108",
                    "speaker": "雅丝敏",
                    "text": "旅行者，你也帮我去一个地方记录一下圣树的全貌吧，我把地点给你标在地图上。",
                    "choices": [
                        {
                            "id": "230290109",
                            "text": "交给我吧。"
                        },
                        {
                            "id": "230290110",
                            "text": "你怎么不自己去？",
                            "response": [
                                {
                                    "id": "230290111",
                                    "speaker": "雅丝敏",
                                    "text": "呃，那边…那边…太高了…"
                                },
                                {
                                    "id": "230290112",
                                    "speaker": "雅丝敏",
                                    "text": "我每次一个人去到很高的地方都会很害怕…总觉得会有一股风把我…或者我的文稿给吹走…"
                                },
                                {
                                    "id": "230290113",
                                    "speaker": "雅丝敏",
                                    "text": "平时都是法尔希去那边记录，但今天他似乎有别的事要忙，所以就只能拜托你了，旅行者。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302902",
            "objective": "在指定地点，记录圣树全貌",
            "dialogues": [
                {
                    "id": "230290201",
                    "speaker": "雅丝敏",
                    "text": "记录圣树全貌的事就拜托你了，旅行者。"
                }
            ]
        },
        {
            "id": "2302903",
            "objective": "记录圣树全貌",
            "dialogues": []
        },
        {
            "id": "2302904",
            "objective": "向雅丝敏回报",
            "dialogues": [
                {
                    "id": "230290401",
                    "speaker": "雅丝敏",
                    "text": "怎么样，你们记录到圣树的全貌了吗？"
                },
                {
                    "id": "230290402",
                    "speaker": "Player",
                    "text": "已经记录到了。"
                },
                {
                    "id": "230290403",
                    "speaker": "雅丝敏",
                    "text": "喔！让我看看…"
                },
                {
                    "id": "230290404",
                    "speaker": "雅丝敏",
                    "text": "真不错，角度很好，记录得也很清晰。"
                },
                {
                    "id": "230290405",
                    "speaker": "雅丝敏",
                    "text": "这些报酬给你，谢谢你帮忙，旅行者。"
                },
                {
                    "id": "230290406",
                    "speaker": "雅丝敏",
                    "text": "主干没有问题…周围的枝干轮廓也没有变…"
                },
                {
                    "id": "230290407",
                    "speaker": "雅丝敏",
                    "text": "剩下的就等拉德普和法尔希搜集好数据，我们就可以继续下一个课题了…"
                }
            ]
        }
    ]
}