    "talks": [
        {
            "id": "7712508",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250801",
                    "speaker": "霜精「村长」",
                    "text": "(test)要是有办法兼顾两边，那就不怕他们了"
                }
            ]
        },
        {
            "id": "7712503",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250301",
                    "speaker": "有点大的霜精",
                    "text": "呀吼——呀吼——"
                },
                {
                    "id": "771250302",
                    "speaker": "派蒙",
                    "text": "呃，看上去是在感谢我们吗？"
                },
                {
                    "id": "771250303",
                    "speaker": "派蒙",
                    "text": "虽然听不懂你们具体在说什么，不过不用谢？"
                },
                {
                    "id": "771250304",
                    "speaker": "有点大的霜精",
                    "text": "唔嗯…"
                },
                {
                    "id": "771250305",
                    "speaker": "Black Screen",
                    "text": "有点大的霜精似乎思考了一小会儿，然后… \\n从身后拿出了一块木板，随即用手在上面抹动起来。"
                },
                {
                    "id": "771250306",
                    "speaker": "派蒙",
                    "text": "咦…这是，哇，你居然还会写字…"
                },
                {
                    "id": "771250307",
                    "speaker": "有点大的霜精",
                    "text": "呀吼——"
                },
                {
                    "id": "771250308",
                    "speaker": "派蒙",
                    "text": "我看看，上面写着…「谢谢，好人。我是村长。」"
                },
                {
                    "id": "771250309",
                    "speaker": "派蒙",
                    "text": "哦哦，村长！不用谢。"
                },
                {
                    "id": "771250310",
                    "speaker": "有点大的霜精",
                    "text": "呀吼——"
                },
                {
                    "id": "771250311",
                    "speaker": "派蒙",
                    "text": "但是村长是职务，你的名字是什么呢？"
                },
                {
                    "id": "771250312",
                    "speaker": "有点大的霜精",
                    "text": "？"
                },
                {
                    "id": "771250313",
                    "speaker": "有点大的霜精",
                    "text": "「村长。」"
                },
                {
                    "id": "771250314",
                    "speaker": "派蒙",
                    "text": "呜哇，感觉要有点说不清了，那就直接叫你「村长」吧！"
                },
                {
                    "id": "771250315",
                    "speaker": "霜精「村长」",
                    "text": "呀吼——"
                },
                {
                    "id": "771250316",
                    "speaker": "派蒙",
                    "text": "不过，「村长」，这里到底发生了什么？"
                },
                {
                    "id": "771250317",
                    "speaker": "霜精「村长」",
                    "text": "「兽怪，跑进来，欺负…」"
                },
                {
                    "id": "771250318",
                    "speaker": "派蒙",
                    "text": "哦…是兽怪打进了村子里，然后欺负你们的意思吗？"
                },
                {
                    "id": "771250319",
                    "speaker": "霜精「村长」",
                    "text": "「兽怪硬，霜精软…」"
                },
                {
                    "id": "771250320",
                    "speaker": "派蒙",
                    "text": "呃，兽怪的爪子确实看上去会比霜精们硬多了…但那要怎么办？"
                },
                {
                    "id": "771250321",
                    "speaker": "霜精「村长」",
                    "text": "「大雪球，发射，挡住！」"
                },
                {
                    "id": "771250322",
                    "speaker": "派蒙",
                    "text": "只靠雪球的话真的挡得住吗？"
                },
                {
                    "id": "771250323",
                    "speaker": "Player",
                    "text": "只要在雪球里包上石头的话…"
                },
                {
                    "id": "771250324",
                    "speaker": "派蒙",
                    "text": "你在说什么可怕的话…"
                },
                {
                    "id": "771250325",
                    "speaker": "霜精「村长」",
                    "text": "！"
                },
                {
                    "id": "771250326",
                    "speaker": "派蒙",
                    "text": "你别一副受到启发的样子！用石头还是太危险了啦。"
                },
                {
                    "id": "771250327",
                    "speaker": "派蒙",
                    "text": "但是仔细想想，雪球真的有用吗…如果有用的话，兽怪也不会闯进来了吧。"
                },
                {
                    "id": "771250328",
                    "speaker": "霜精「村长」",
                    "text": "「臻冰，难，发射，大炮，少…」"
                },
                {
                    "id": "771250329",
                    "speaker": "派蒙",
                    "text": "哦，原来是臻冰什么大炮把雪球发射出去，然后那些机关来不及做出来？"
                },
                {
                    "id": "771250330",
                    "speaker": "派蒙",
                    "text": "#要是这样的话，{NICKNAME}…"
                },
                {
                    "id": "771250331",
                    "speaker": "Player",
                    "text": "我们倒也不是不能帮忙？"
                },
                {
                    "id": "771250332",
                    "speaker": "派蒙",
                    "text": "毕竟我们做了很多奇怪的臻冰玩意儿了呢…"
                },
                {
                    "id": "771250333",
                    "speaker": "霜精「村长」",
                    "text": "！"
                },
                {
                    "id": "771250334",
                    "speaker": "霜精「村长」",
                    "text": "「金毛，大好人！白毛，又软又硬！」"
                },
                {
                    "id": "771250335",
                    "speaker": "派蒙",
                    "text": "又软又硬听上去根本没在夸人！"
                },
                {
                    "id": "771250336",
                    "speaker": "霜精「村长」",
                    "text": "「来！」"
                },
                {
                    "id": "771250337",
                    "speaker": "派蒙",
                    "text": "他的意思应该是…要我们跟上去的意思吧。那就去看看吧？"
                }
            ]
        },
        {
            "id": "7712510",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771251001",
                    "speaker": "霜精「村长」",
                    "text": "「帮帮大炮？」",
                    "choices": [
                        {
                            "id": "771251002",
                            "text": "来「帮帮大炮！」",
                            "response": [
                                {
                                    "id": "771251003",
                                    "speaker": "派蒙",
                                    "text": "唔，那就看看还有哪里需要放臻冰机关吧！"
                                },
                                {
                                    "id": "771251004",
                                    "speaker": "霜精「村长」",
                                    "text": "「兽怪，进入，路，其他。」"
                                },
                                {
                                    "id": "771251005",
                                    "speaker": "派蒙",
                                    "text": "呃…「还有其他兽怪会来的路」的意思吧，我明白了！"
                                },
                                {
                                    "id": "771251006",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们看看那些路线两边，有没有放臻冰机关的地方吧！"
                                },
                                {
                                    "id": "771251007",
                                    "speaker": "霜精「村长」",
                                    "text": "「准备好了，村长，告诉！」"
                                },
                                {
                                    "id": "771251008",
                                    "speaker": "派蒙",
                                    "text": "嗯，就跟之前一样，我们准备好了会和你说的！"
                                }
                            ]
                        },
                        {
                            "id": "771251009",
                            "text": "稍后来帮你们哦…",
                            "response": [
                                {
                                    "id": "771251010",
                                    "speaker": "霜精「村长」",
                                    "text": "呀吼！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250101",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "呀吼、呀吼…"
                },
                {
                    "id": "771250102",
                    "speaker": "派蒙",
                    "text": "哎呀，真可怜，好了，我们已经把那两个欺负人的兽怪赶跑了！"
                },
                {
                    "id": "771250103",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "呀吼——！"
                },
                {
                    "id": "771250104",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "呀吼…呀吼…"
                },
                {
                    "id": "771250105",
                    "speaker": "派蒙",
                    "text": "咦，怎么了，为什么感觉还是不开心，难道是因为摩拉被抢走了？"
                },
                {
                    "id": "771250106",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "？"
                },
                {
                    "id": "771250107",
                    "speaker": "Player",
                    "text": "看上去不像呢…"
                },
                {
                    "id": "771250108",
                    "speaker": "派蒙",
                    "text": "摩拉？"
                },
                {
                    "id": "771250109",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "唔—唔—"
                },
                {
                    "id": "771250110",
                    "speaker": "派蒙",
                    "text": "被欺负！"
                },
                {
                    "id": "771250111",
                    "speaker": "拿着铃鼓的霜精",
                    "text": "呀吼！呀吼！"
                },
                {
                    "id": "771250112",
                    "speaker": "派蒙",
                    "text": "还是在担心被欺负的事吗？可是兽怪已经被我们赶跑了…"
                },
                {
                    "id": "771250113",
                    "speaker": "派蒙",
                    "text": "那就说明——",
                    "choices": [
                        {
                            "id": "771250114",
                            "text": "它其实很喜欢被兽怪欺负？",
                            "response": [
                                {
                                    "id": "771250115",
                                    "speaker": "派蒙",
                                    "text": "你从哪里能看出这一点啊！"
                                },
                                {
                                    "id": "771250118",
                                    "speaker": "派蒙",
                                    "text": "是不是你还有其他的被欺负的同伴啊！"
                                },
                                {
                                    "id": "771250119",
                                    "speaker": "拿着铃鼓的霜精",
                                    "text": "呀吼…"
                                },
                                {
                                    "id": "771250120",
                                    "speaker": "Black Screen",
                                    "text": "拿着铃鼓的霜精挥动雪团般的手，跟你们说了它家乡的同伴被兽怪欺负的事…"
                                },
                                {
                                    "id": "771250121",
                                    "speaker": "派蒙",
                                    "text": "唔，那些兽怪真是太坏了。"
                                },
                                {
                                    "id": "771250122",
                                    "speaker": "派蒙",
                                    "text": "如果我们经过你的家乡，一定帮你狠狠教训那些兽怪。"
                                },
                                {
                                    "id": "771250123",
                                    "speaker": "拿着铃鼓的霜精",
                                    "text": "呀吼！呀吼——"
                                }
                            ]
                        },
                        {
                            "id": "771250116",
                            "text": "有别的霜精被兽怪欺负？",
                            "response": [
                                {
                                    "id": "771250117",
                                    "speaker": "派蒙",
                                    "text": "哦哦，很有可能呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250201",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)这就是吟游霜精的家乡了吧"
                }
            ]
        },
        {
            "id": "7712504",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250401",
                    "speaker": "霜精「村长」",
                    "text": "「兽怪，进入，路。」"
                },
                {
                    "id": "771250402",
                    "speaker": "派蒙",
                    "text": "也就是说，兽灵是从这里进来的…？"
                },
                {
                    "id": "771250403",
                    "speaker": "Black Screen",
                    "text": "霜精「村长」用木板上断断续续的话语，手忙脚乱的比划… 向你们说着过去经常发生的事…"
                },
                {
                    "id": "771250404",
                    "speaker": "派蒙",
                    "text": "你们是说，那些坏蛋兽怪，每隔一段时间都要跑进来欺负你们…"
                },
                {
                    "id": "771250405",
                    "speaker": "派蒙",
                    "text": "就这样大摇大摆从那边顺着路走过来。"
                },
                {
                    "id": "771250406",
                    "speaker": "派蒙",
                    "text": "抢你们的东西，还把村子弄得一团乱。"
                },
                {
                    "id": "771250407",
                    "speaker": "派蒙",
                    "text": "哇，好可怜，那些兽怪也有够坏的！"
                },
                {
                    "id": "771250408",
                    "speaker": "派蒙",
                    "text": "我懂了，所以你们要在这条路上布置那些发射大雪球的大炮…"
                },
                {
                    "id": "771250409",
                    "speaker": "派蒙",
                    "text": "用大雪球把兽怪赶跑！"
                },
                {
                    "id": "771250410",
                    "speaker": "霜精「村长」",
                    "text": "呀吼！"
                },
                {
                    "id": "771250411",
                    "speaker": "霜精「村长」",
                    "text": "「帮帮大炮！」"
                },
                {
                    "id": "771250412",
                    "speaker": "派蒙",
                    "text": "好的，好的，我们就来帮帮大炮吧！"
                },
                {
                    "id": "771250413",
                    "speaker": "霜精「村长」",
                    "text": "呀吼——"
                },
                {
                    "id": "771250414",
                    "speaker": "霜精「村长」",
                    "text": "「准备好了，村长，告诉！」"
                },
                {
                    "id": "771250415",
                    "speaker": "派蒙",
                    "text": "好的好的，我们准备好了会和你说的！"
                },
                {
                    "id": "771250416",
                    "speaker": "霜精「村长」",
                    "text": "呀吼，呀吼~"
                }
            ]
        },
        {
            "id": "7712517",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771251701",
                    "speaker": "入侵的兽怪",
                    "text": "呃，再这样下去有点得不偿失…"
                },
                {
                    "id": "771251702",
                    "speaker": "入侵的兽怪",
                    "text": "可恶，本来想这样赚回来的…这下叫人来帮忙的钱都打了水花了…"
                },
                {
                    "id": "771251703",
                    "speaker": "入侵的兽怪",
                    "text": "看来得找到其他路子，哼，算、算你们这些霜精运气好！"
                },
                {
                    "id": "771251704",
                    "speaker": "派蒙",
                    "text": "这下他们应该再也不会来了吧…"
                },
                {
                    "id": "771251705",
                    "speaker": "派蒙",
                    "text": "毕竟能够进入这里的路都已经全部摆满臻冰的机关和陷阱了。"
                },
                {
                    "id": "771251706",
                    "speaker": "霜精「村长」",
                    "text": "呀吼，呜呜，呀吼——"
                },
                {
                    "id": "771251707",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这次我能听懂了，这一定是谢谢的意思。"
                },
                {
                    "id": "771251708",
                    "speaker": "派蒙",
                    "text": "不用谢啦！"
                },
                {
                    "id": "771251709",
                    "speaker": "霜精「村长」",
                    "text": "「最后，完全！」"
                },
                {
                    "id": "771251710",
                    "speaker": "派蒙",
                    "text": "嗯？这又是要干什么…"
                },
                {
                    "id": "771251711",
                    "speaker": "霜精「村长」",
                    "text": "「来！」"
                },
                {
                    "id": "771251712",
                    "speaker": "派蒙",
                    "text": "啊，又跑走了…我们跟上去看看吧？"
                }
            ]
        },
        {
            "id": "7712519",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771252201",
                    "speaker": "曾被压住的霜精",
                    "text": "呀吼…"
                },
                {
                    "id": "771252202",
                    "speaker": "派蒙",
                    "text": "哦！看来终于脱困了。"
                },
                {
                    "id": "771252203",
                    "speaker": "派蒙",
                    "text": "不过霜精到底是什么做的呢，雪吗？被压了很久但是看上去形状也没有变化呢…"
                },
                {
                    "id": "771252204",
                    "speaker": "曾被压住的霜精",
                    "text": "呀吼？"
                },
                {
                    "id": "771252205",
                    "speaker": "派蒙",
                    "text": "不、不是什么关键的事啦。"
                }
            ]
        },
        {
            "id": "7712518",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771251801",
                    "speaker": "派蒙",
                    "text": "咦，是「村长」，还有一群霜精，他们围着的那个是…"
                },
                {
                    "id": "771251802",
                    "speaker": "霜精「村长」",
                    "text": "「最后，完全！」"
                },
                {
                    "id": "771251803",
                    "speaker": "派蒙",
                    "text": "什么叫最后完全啦，不是很能明白。"
                },
                {
                    "id": "771251804",
                    "speaker": "霜精「村长」",
                    "text": "呀吼…"
                },
                {
                    "id": "771251805",
                    "speaker": "霜精「村长」",
                    "text": "「门，牌子，雪球！」"
                },
                {
                    "id": "771251806",
                    "speaker": "霜精「村长」",
                    "text": "「发射，发射，发射！」"
                },
                {
                    "id": "771251807",
                    "speaker": "派蒙",
                    "text": "向着…门上的牌子…发射雪球？"
                },
                {
                    "id": "771251808",
                    "speaker": "霜精「村长」",
                    "text": "「白毛，硬！」"
                },
                {
                    "id": "771251809",
                    "speaker": "派蒙",
                    "text": "我是理解了，硬就是在说厉害的意思吧…"
                },
                {
                    "id": "771251810",
                    "speaker": "派蒙",
                    "text": "哦，「最后，完全」，意思就是「最后」做完这件事，村子就能「完全」恢复成以前的样子了…是吧？"
                },
                {
                    "id": "771251811",
                    "speaker": "霜精「村长」",
                    "text": "呀吼！",
                    "choices": [
                        {
                            "id": "771251812",
                            "text": "呀吼！",
                            "response": [
                                {
                                    "id": "771251813",
                                    "speaker": "派蒙",
                                    "text": "早就知道你要这么干一回。"
                                },
                                {
                                    "id": "771251816",
                                    "speaker": "派蒙",
                                    "text": "嗯，那我们这就帮你们修好那个门上的牌子！"
                                }
                            ]
                        },
                        {
                            "id": "771251814",
                            "text": "派蒙，硬！",
                            "response": [
                                {
                                    "id": "771251815",
                                    "speaker": "派蒙",
                                    "text": "好好好，我硬我硬。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712522",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771252101",
                    "speaker": "晕晕的霜精",
                    "text": "呀、呀呕吼…呕呕…"
                },
                {
                    "id": "771252102",
                    "speaker": "派蒙",
                    "text": "你没事吧，哇，发出了奇怪的声音。"
                },
                {
                    "id": "771252103",
                    "speaker": "晕晕的霜精",
                    "text": "唔…"
                },
                {
                    "id": "771252104",
                    "speaker": "派蒙",
                    "text": "虽然感觉看上去还是不太舒服，但应该没什么大碍了吧…"
                }
            ]
        },
        {
            "id": "7712505",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771250501",
                    "speaker": "派蒙",
                    "text": "这下兽怪破坏的地方就全部修好了吧，那些兽怪也太坏了。"
                },
                {
                    "id": "771250502",
                    "speaker": "派蒙",
                    "text": "不过这下总算是恢复原样了。"
                },
                {
                    "id": "771250503",
                    "speaker": "霜精「村长」",
                    "text": "「谢谢！」"
                },
                {
                    "id": "771250504",
                    "speaker": "派蒙",
                    "text": "嘿嘿，不用谢，看到村子恢复原样，我们也很开心。"
                },
                {
                    "id": "771250505",
                    "speaker": "派蒙",
                    "text": "不过，那些兽怪为什么会来呢，听他们话里，这里似乎有很多很值钱的东西？"
                },
                {
                    "id": "771250506",
                    "speaker": "霜精「村长」",
                    "text": "呀吼…"
                },
                {
                    "id": "771250507",
                    "speaker": "霜精「村长」",
                    "text": "「好，东西，商店！」"
                },
                {
                    "id": "771250508",
                    "speaker": "派蒙",
                    "text": "有厉害的东西在你们的商店里，哇，不知道为什么总觉得能够很流畅理解「村长」你想说的话了。"
                },
                {
                    "id": "771250509",
                    "speaker": "派蒙",
                    "text": "而且，这里居然是商店，欸，这是你的商店吗？"
                },
                {
                    "id": "771250510",
                    "speaker": "霜精「村长」",
                    "text": "「抢，不好…换，好！」"
                },
                {
                    "id": "771250511",
                    "speaker": "派蒙",
                    "text": "也就是说，兽怪想要抢你们的东西，但是毕竟是商店，所以还是得交换来。"
                },
                {
                    "id": "771250512",
                    "speaker": "派蒙",
                    "text": "哦哦，原来你们也用摩拉吗？"
                },
                {
                    "id": "771250513",
                    "speaker": "霜精「村长」",
                    "text": "？"
                },
                {
                    "id": "771250514",
                    "speaker": "派蒙",
                    "text": "不是摩拉？"
                },
                {
                    "id": "771250515",
                    "speaker": "霜精「村长」",
                    "text": "「牛口」。"
                },
                {
                    "id": "771250516",
                    "speaker": "派蒙",
                    "text": "什么东西？"
                },
                {
                    "id": "771250517",
                    "speaker": "霜精「村长」",
                    "text": "「金毛白毛，好，送送」。"
                },
                {
                    "id": "771250518",
                    "speaker": "Black Screen",
                    "text": "稍大一些的霜精，它的双手从背后掏出了一些琳琅作响的东西，递到了你们的手中。 \\n你们认出来，那其实是…"
                },
                {
                    "id": "771250519",
                    "speaker": "派蒙",
                    "text": "原来「牛口」就是这个！"
                },
                {
                    "id": "771250520",
                    "speaker": "Player",
                    "text": "啊，是纽扣！"
                },
                {
                    "id": "771250521",
                    "speaker": "霜精「村长」",
                    "text": "「摩拉，重，坏。」"
                },
                {
                    "id": "771250522",
                    "speaker": "霜精「村长」",
                    "text": "「牛口，轻，在身上，好看！」"
                },
                {
                    "id": "771250523",
                    "speaker": "派蒙",
                    "text": "对哦，霜精也没什么要用得到摩拉的地方…"
                },
                {
                    "id": "771250524",
                    "speaker": "派蒙",
                    "text": "只要找到这样的牛口…啊不对，只要找到这样的纽扣，就能够到你的商店换东西，是这样的意思吗？"
                },
                {
                    "id": "771250525",
                    "speaker": "霜精「村长」",
                    "text": "呀吼！"
                },
                {
                    "id": "771250526",
                    "speaker": "派蒙",
                    "text": "好，如果我们找到这样的纽扣，一定会来这里找你的！"
                },
                {
                    "id": "771250527",
                    "speaker": "霜精「村长」",
                    "text": "「牛口，牛口，好！」"
                },
                {
                    "id": "771250528",
                    "speaker": "霜精「村长」",
                    "text": "呀吼呀吼！"
                }
            ]
        },
