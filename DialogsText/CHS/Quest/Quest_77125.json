            "dialogues": []
        },
        {
            "id": "7712514",
            "objective": "准备好防御措施",
            "dialogues": [
                {
                    "id": "771250601",
                    "speaker": "霜精「村长」",
                    "text": "「准备好了，村长，告诉！」",
                    "choices": [
                        {
                            "id": "771250602",
                            "text": "是的，已经准备好了！",
                            "response": [
                                {
                                    "id": "771250603",
                                    "speaker": "霜精「村长」",
                                    "text": "呀吼！"
                                },
                                {
                                    "id": "771250604",
                                    "speaker": "Black Screen",
                                    "text": "于是，你们在兽怪到来之前，和共同搭建「防御工事」的霜精们一起，完成了准备。"
                                },
                                {
                                    "id": "771250605",
                                    "speaker": "Black Screen",
                                    "text": "果不其然，没过多久，成群结队的兽怪就从道路的那头出现了！"
                                },
                                {
                                    "id": "771250606",
                                    "speaker": "派蒙",
                                    "text": "好，现在，就看看那些臻冰机关到底有没有用吧！"
                                }
                            ]
                        },
                        {
                            "id": "771250607",
                            "text": "再等等…",
                            "response": [
                                {
                                    "id": "771250608",
                                    "speaker": "霜精「村长」",
                                    "text": "呀、呀吼…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712509",
            "objective": "抵御兽怪的进攻",
            "dialogues": [
                {
                    "id": "771250901",
                    "speaker": "霜精「村长」",
                    "text": "「准备好了，村长，告诉！」",
                    "choices": [
                        {
                            "id": "771250902",
                            "text": "是的，已经准备好了！",
                            "response": [
                                {
                                    "id": "771250903",
                                    "speaker": "霜精「村长」",
                                    "text": "呀吼！"
                                },
                                {
                                    "id": "771250904",
                                    "speaker": "Black Screen",
                                    "text": "于是，你们在兽怪第二次到来之前，和共同搭建「防御工事」的霜精们一起，完成了准备。"
                                },
                                {
                                    "id": "771250905",
                                    "speaker": "Black Screen",
                                    "text": "没过多久，成群结队的兽怪又从道路的那头出现了！ 从某种意义上来说还挺顽强的…"
                                },
                                {
                                    "id": "771250906",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，现在他们来的每条路上都放满了机关！"
                                }
                            ]
                        },
                        {
                            "id": "771250907",
                            "text": "再等等…",
                            "response": [
                                {
                                    "id": "771250908",
                                    "speaker": "霜精「村长」",
                                    "text": "呀、呀吼…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712520",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771251101",
                    "speaker": "入侵的兽怪",
                    "text": "可、可恶，这些愚蠢的霜精这次怎么变得这么难缠。"
                },
                {
                    "id": "771251102",
                    "speaker": "入侵的兽怪",
                    "text": "给我、给我等着，我们要喊来所有人，到时候把你们滚成雪球踢！"
                },
                {
                    "id": "771251103",
                    "speaker": "派蒙",
                    "text": "赶跑了！这些大炮还是蛮厉害的嘛！"
                },
                {
                    "id": "771251104",
                    "speaker": "霜精「村长」",
                    "text": "呀吼，呜呜，呀吼——"
                },
                {
                    "id": "771251105",
                    "speaker": "派蒙",
                    "text": "啊，不过现在还不是能够放松的时候。"
                },
                {
                    "id": "771251106",
                    "speaker": "派蒙",
                    "text": "刚才那些逃跑的兽灵说，还会叫更多的同伙过来…"
                },
                {
                    "id": "771251107",
                    "speaker": "霜精「村长」",
                    "text": "？！"
                },
                {
                    "id": "771251108",
                    "speaker": "派蒙",
                    "text": "刚才他们说的话你是一点都没听啊。"
                },
                {
                    "id": "771251109",
                    "speaker": "霜精「村长」",
                    "text": "呜呜…"
                },
                {
                    "id": "771251110",
                    "speaker": "霜精「村长」",
                    "text": "「金毛，白毛，逃！」"
                },
                {
                    "id": "771251111",
                    "speaker": "派蒙",
                    "text": "#…我们倒不是很害怕啦，是吧，{NICKNAME}？",
                    "choices": [
                        {
                            "id": "771251112",
                            "text": "好害怕，快逃啊，派蒙！",
                            "response": [
                                {
                                    "id": "771251113",
                                    "speaker": "派蒙",
                                    "text": "你这家伙，一有机会就开始演…"
                                },
                                {
                                    "id": "771251116",
                                    "speaker": "派蒙",
                                    "text": "啊，总之，我们才不会抛下你们不管啦。"
                                },
                                {
                                    "id": "771251117",
                                    "speaker": "霜精「村长」",
                                    "text": "呀吼！"
                                },
                                {
                                    "id": "771251118",
                                    "speaker": "霜精「村长」",
                                    "text": "「休息？继续？」"
                                },
                                {
                                    "id": "771251119",
                                    "speaker": "派蒙",
                                    "text": "是问我们要休息一会儿，还是继续帮忙做准备的意思吗？"
                                },
                                {
                                    "id": "771251120",
                                    "speaker": "霜精「村长」",
                                    "text": "呀吼！呀吼！",
                                    "choices": [
                                        {
                                            "id": "771251121",
                                            "text": "可以继续帮忙。",
                                            "response": [
                                                {
                                                    "id": "771251122",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，那就看看还有哪里需要放臻冰机关吧！"
                                                },
                                                {
                                                    "id": "771251123",
                                                    "speaker": "霜精「村长」",
                                                    "text": "「兽怪，进入，路，其他。」"
                                                },
                                                {
                                                    "id": "771251124",
                                                    "speaker": "派蒙",
                                                    "text": "也就是说，还有其他的有可能入侵的路线，我明白了！"
                                                },
                                                {
                                                    "id": "771251125",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，我们看看那些路线两边，有没有放臻冰机关的地方吧！"
                                                },
                                                {
                                                    "id": "771251126",
                                                    "speaker": "霜精「村长」",
                                                    "text": "「准备好了，村长，告诉！」"
                                                },
                                                {
                                                    "id": "771251127",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，就跟之前一样，我们准备好了会和你说的！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "771251128",
                                            "text": "那就先休息一下吧。",
                                            "response": [
                                                {
                                                    "id": "771251129",
                                                    "speaker": "霜精「村长」",
                                                    "text": "呀吼！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "771251114",
                            "text": "再来十倍都不怕。",
                            "response": [
                                {
                                    "id": "771251115",
                                    "speaker": "派蒙",
                                    "text": "唔，如果真的来十倍的话也会有点累的吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
