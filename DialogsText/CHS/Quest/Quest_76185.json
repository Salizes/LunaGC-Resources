    "talks": [
        {
            "id": "7618501",
            "objective": "前往秘闻馆开启茶会",
            "dialogues": [
                {
                    "id": "761850101",
                    "speaker": "奈芙尔",
                    "text": "嗯，美味的茶水点心。多谢桑多涅小姐的招待。"
                },
                {
                    "id": "761850102",
                    "speaker": "「木偶」",
                    "text": "没什么，你中意就好。我还带了些阿舍鲁喜欢的零食。对不对？阿舍鲁？过来，乖。"
                },
                {
                    "id": "761850103",
                    "speaker": "阿舍鲁",
                    "text": "喵~"
                },
                {
                    "id": "761850104",
                    "speaker": "奈芙尔",
                    "text": "希望你同挪德卡莱，以及同「秘闻馆」的这份情谊，能够对未来我们之间的合作有所益处。"
                },
                {
                    "id": "761850105",
                    "speaker": "「木偶」",
                    "text": "嗯，我也希望如此。来，阿舍鲁，尝尝这个。"
                },
                {
                    "id": "761850106",
                    "speaker": "奈芙尔",
                    "text": "另外，关于之前向桑多涅小姐打听的…"
                },
                {
                    "id": "761850107",
                    "speaker": "「木偶」",
                    "text": "哈哈，你这小肉垫真软。"
                },
                {
                    "id": "761850108",
                    "speaker": "奈芙尔",
                    "text": "……"
                },
                {
                    "id": "761850109",
                    "speaker": "奈芙尔",
                    "text": "桑多涅小姐…你该不会是借茶会的名义来我这里揉猫的吧？"
                },
                {
                    "id": "761850110",
                    "speaker": "「木偶」",
                    "text": "欸…？有，有吗？没有的事！和「秘闻馆」的往来我也放在心上的！"
                },
                {
                    "id": "761850111",
                    "speaker": "奈芙尔",
                    "text": "过来，阿舍鲁。"
                },
                {
                    "id": "761850112",
                    "speaker": "阿舍鲁",
                    "text": "喵~"
                },
                {
                    "id": "761850113",
                    "speaker": "「木偶」",
                    "text": "啊…"
                },
                {
                    "id": "761850114",
                    "speaker": "奈芙尔",
                    "text": "那我们具体聊聊「往来」相关的事吧。"
                },
                {
                    "id": "761850115",
                    "speaker": "「木偶」",
                    "text": "…啧。有…就算有一点点是想揉猫又怎样啦！"
                },
                {
                    "id": "761850116",
                    "speaker": "「木偶」",
                    "text": "平时很多小动物都不喜欢机械，好不容易前段时间在这里研究「数秘阵列」和阿舍鲁混熟了，揉一下又怎样啦！"
                },
                {
                    "id": "761850117",
                    "speaker": "奈芙尔",
                    "text": "哈…好吧好吧。"
                },
                {
                    "id": "761850118",
                    "speaker": "奈芙尔",
                    "text": "去吧，阿舍鲁。反正我也管不了你喜欢蹭谁。"
                },
                {
                    "id": "761850119",
                    "speaker": "阿舍鲁",
                    "text": "喵~"
                },
                {
                    "id": "761850120",
                    "speaker": "奈芙尔",
                    "text": "揉个痛快之后别忘了聊正事啊…"
                },
                {
                    "id": "761850121",
                    "speaker": "「木偶」",
                    "text": "说了我有放在心上的！"
                }
            ]
        },
        {
            "id": "7618502",
            "objective": "前往秘闻馆开启茶会",
            "dialogues": [
                {
                    "id": "761850201",
                    "speaker": "奈芙尔",
                    "text": "搭配着「情报」喝下的茶，味道就是不一样。"
                },
                {
                    "id": "761850202",
                    "speaker": "「木偶」",
                    "text": "（再这么坐一会儿吧。）"
                },
                {
                    "id": "761850204",
                    "speaker": "奈芙尔",
                    "text": "哦，慢走。有空常来。"
                }
            ]
        },
        {
            "id": "7618503",
            "objective": "享受茶会时光",
            "dialogues": []
        },
