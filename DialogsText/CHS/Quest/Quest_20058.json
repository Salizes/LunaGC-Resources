    "talks": [
        {
            "id": "2005801",
            "objective": "与诺拉对话",
            "dialogues": [
                {
                    "id": "200580101",
                    "speaker": "诺拉",
                    "text": "呜…怎么办呢…"
                },
                {
                    "id": "200580102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "200580103",
                    "speaker": "诺拉",
                    "text": "你看见风神像了吗？往上看，很高很高的地方…就是风神大人手的那个地方。"
                },
                {
                    "id": "200580104",
                    "speaker": "诺拉",
                    "text": "我想要上去玩…但是，葛瑞丝阿姨一定不会让我爬上去的…"
                },
                {
                    "id": "200580105",
                    "speaker": "诺拉",
                    "text": "拜托拜托，拜托你去和葛瑞丝阿姨说话吧，别让她看过来，我爬得很快，一下子就能爬上去…",
                    "choices": [
                        {
                            "id": "200580106",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "200580107",
                                    "speaker": "诺拉",
                                    "text": "那就拜托你啦！"
                                },
                                {
                                    "id": "200580110",
                                    "speaker": "诺拉",
                                    "text": "总之，就拜托你去吸引住葛瑞丝阿姨了，我这就去…"
                                },
                                {
                                    "id": "200580111",
                                    "speaker": "葛瑞丝",
                                    "text": "诺拉，不准去！"
                                },
                                {
                                    "id": "200580112",
                                    "speaker": "葛瑞丝",
                                    "text": "呼…稍微走神了一会，她居然来麻烦您了，抱歉。"
                                },
                                {
                                    "id": "200580113",
                                    "speaker": "诺拉",
                                    "text": "怎么这样！就是上去玩一玩…"
                                },
                                {
                                    "id": "200580114",
                                    "speaker": "葛瑞丝",
                                    "text": "不行就是不行，你父亲也不会允许的。"
                                },
                                {
                                    "id": "200580115",
                                    "speaker": "葛瑞丝",
                                    "text": "还有您，请您也别迁就她。要是您做这种危险的事情，肯定也有人会担心的吧。"
                                }
                            ]
                        },
                        {
                            "id": "200580108",
                            "text": "太危险了。",
                            "response": [
                                {
                                    "id": "200580109",
                                    "speaker": "诺拉",
                                    "text": "没关系啦，我可是很厉害的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005813",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200580501",
                    "speaker": "Player",
                    "text": "这次就这样吧…"
                },
                {
                    "id": "200580502",
                    "speaker": "诺拉",
                    "text": "好吧…好好休息。"
                }
            ]
        },
        {
            "id": "2005802",
            "objective": "与诺拉对话",
            "dialogues": [
                {
                    "id": "200580201",
                    "speaker": "诺拉",
                    "text": "呜…"
                },
                {
                    "id": "200580202",
                    "speaker": "Player",
                    "text": "要上去做什么？"
                },
                {
                    "id": "200580203",
                    "speaker": "诺拉",
                    "text": "葛瑞丝阿姨说，如果想要向谁说悄悄话，只要告诉蒲公英，然后撒出去，风神大人就会把蒲公英和悄悄话一起带给那个人。"
                },
                {
                    "id": "200580204",
                    "speaker": "诺拉",
                    "text": "而且撒的地方越高，心愿就能传达地越快…"
                },
                {
                    "id": "200580205",
                    "speaker": "诺拉",
                    "text": "葛罗丽姐姐就拜托过冒险家，帮自己去风神像上撒过蒲公英…结果隔了几天，古德温哥哥就回信了！"
                },
                {
                    "id": "200580206",
                    "speaker": "诺拉",
                    "text": "诺拉也有悄悄话告诉爸爸，而且也找好蒲公英了！"
                },
                {
                    "id": "200580207",
                    "speaker": "诺拉",
                    "text": "但是…葛瑞丝阿姨一直不许，一直说等我长大之后，才能回去和爸爸一起住。"
                },
                {
                    "id": "200580208",
                    "speaker": "诺拉",
                    "text": "到底怎么样才能长大得更快呢，我也在很努力地锻炼了，但还是这么矮…"
                },
                {
                    "id": "200580209",
                    "speaker": "诺拉",
                    "text": "嗯…我经常看见你在城里飞来飞去，你能教教我，平时你都是怎么飞的吗？",
                    "choices": [
                        {
                            "id": "200580210",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200580211",
                                    "speaker": "诺拉",
                                    "text": "嘻嘻，那我就在旁边看啦。这次，总是在葛瑞丝阿姨的允许范围内了吧。"
                                }
                            ]
                        },
                        {
                            "id": "200580212",
                            "text": "要一起飞吗？",
                            "response": [
                                {
                                    "id": "200580213",
                                    "speaker": "诺拉",
                                    "text": "不行不行，葛瑞丝阿姨看见了，又要训我了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005808",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200580801",
                    "speaker": "Player",
                    "text": "我去稍微休息一下…"
                },
                {
                    "id": "200580802",
                    "speaker": "诺拉",
                    "text": "那要快点喔。"
                }
            ]
        },
        {
            "id": "2005809",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200580901",
                    "speaker": "葛瑞丝",
                    "text": "唉，诺拉…",
                    "choices": [
                        {
                            "id": "200580902",
                            "text": "你在照顾她吗？",
                            "response": [
                                {
                                    "id": "200580903",
                                    "speaker": "葛瑞丝",
                                    "text": "哦，因为一些原因，她的母亲…暂时不在家里，目前是由我来照顾。"
                                },
                                {
                                    "id": "200580904",
                                    "speaker": "葛瑞丝",
                                    "text": "还有其他几个需要照顾的孩子，都是由我来负责，这也是修女的责任之一呢。"
                                },
                                {
                                    "id": "200580905",
                                    "speaker": "葛瑞丝",
                                    "text": "我就好像突然多了很多孩子一样，他们都是好孩子，和葛罗丽也都很处得来。"
                                },
                                {
                                    "id": "200580906",
                                    "speaker": "葛瑞丝",
                                    "text": "唔…我照顾时间最长的提米，都开始叫我葛瑞丝妈妈了呢。"
                                }
                            ]
                        },
                        {
                            "id": "200580907",
                            "text": "诺拉的爸爸…",
                            "response": [
                                {
                                    "id": "200580908",
                                    "speaker": "葛瑞丝",
                                    "text": "是巴顿先生，他之前因为太喜欢喝酒，家里出了很大的问题。"
                                },
                                {
                                    "id": "200580909",
                                    "speaker": "葛瑞丝",
                                    "text": "教会和西风骑士团都警告过他几次，但他一直没有悔改的意思，最后还是迪卢克老爷帮的忙。"
                                },
                                {
                                    "id": "200580910",
                                    "speaker": "葛瑞丝",
                                    "text": "维多利亚修女的意思是，现在的巴顿不适合照顾诺拉，所以干脆把诺拉交给教会照顾，让巴顿先生一个人反省一段时间。"
                                },
                                {
                                    "id": "200580911",
                                    "speaker": "葛瑞丝",
                                    "text": "但是，诺拉也在长大，「爸爸在努力工作，不能去打扰」的借口也不能用了吧…"
                                },
                                {
                                    "id": "200580912",
                                    "speaker": "葛瑞丝",
                                    "text": "风神大人的蒲公英，也不是哪都能到的啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005803",
            "objective": "到达目标",
            "dialogues": [
                {
                    "id": "200580301",
                    "speaker": "诺拉",
                    "text": "用了{ChallengeCurrValue10}分钟就飞到了，真厉害。"
                },
                {
                    "id": "200580302",
                    "speaker": "诺拉",
                    "text": "你还能再试试吗？如果能飞得再快一点…"
                },
                {
                    "id": "200580303",
                    "speaker": "诺拉",
                    "text": "我就…就送你很好的宝物。"
                }
            ]
        },
        {
            "id": "2005804",
            "objective": "与诺拉对话",
            "dialogues": []
        },
        {
            "id": "2005805",
            "objective": "与诺拉对话",
            "dialogues": [
                {
                    "id": "200580601",
                    "speaker": "Player",
                    "text": "再来一次。"
                },
                {
                    "id": "200580602",
                    "speaker": "诺拉",
                    "text": "好嘞！我会在旁边好好看着的。"
                }
            ]
        },
        {
            "id": "2005810",
            "objective": "(test)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2005811",
            "objective": "(test)$HIDDEN",
            "dialogues": [
                {
                    "id": "200581101",
                    "speaker": "诺拉",
                    "text": "好厉害！我长大了之后，也能这样飞吗…",
                    "choices": [
                        {
                            "id": "200581102",
                            "text": "可以的。",
                            "response": [
                                {
                                    "id": "200581103",
                                    "speaker": "诺拉",
                                    "text": "那我要快点长大，等爸爸工作完了，我就要和他一起去玩！"
                                },
                                {
                                    "id": "200581106",
                                    "speaker": "诺拉",
                                    "text": "不过，长大之后应该就不难了吧。"
                                },
                                {
                                    "id": "200581107",
                                    "speaker": "诺拉",
                                    "text": "谢谢你啦，这些给你，是我悄悄搜集的宝物，就给你做礼物吧。"
                                },
                                {
                                    "id": "200581108",
                                    "speaker": "诺拉",
                                    "text": "快点收好…还有，别和葛瑞丝阿姨说啊！"
                                }
                            ]
                        },
                        {
                            "id": "200581104",
                            "text": "还要考飞行执照呢。",
                            "response": [
                                {
                                    "id": "200581105",
                                    "speaker": "诺拉",
                                    "text": "飞行执照…那是什么？听着好像就挺难的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005812",
            "objective": "(test)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2005804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200580401",
                    "speaker": "诺拉",
                    "text": "唔…上次你是这么飞的吗？我记得会更帅气一点呢。"
                }
            ]
        }
    ]
}