                }
            ]
        },
        {
            "id": "7414212",
            "objective": "战斗",
            "dialogues": [
                {
                    "id": "741421201",
                    "speaker": "夏诺蒂拉",
                    "text": "(test)你好"
                },
                {
                    "id": "741421202",
