    "talks": [
        {
            "id": "1011200",
            "objective": "(test)触发开车和注目镜头用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1011201",
            "objective": "寻找辉煌勇气之剑",
            "dialogues": [
                {
                    "id": "101120101",
                    "speaker": "派蒙",
                    "text": "那边的丘丘人该不会是在举行仪式吧？"
                }
            ]
        },
        {
            "id": "1011202",
            "objective": "击败举行仪式的丘丘人",
            "dialogues": []
        },
        {
            "id": "1011203",
            "objective": "拾取辉煌勇气之剑",
            "dialogues": []
        },
        {
            "id": "1011204",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "101120401",
                    "speaker": "温迪",
                    "text": "看，<color=#00E1FFFF>「辉煌勇气之剑」</color>！"
                },
                {
                    "id": "101120402",
                    "speaker": "派蒙",
                    "text": "不会吧？就是一把超普通的旧剑而已啊！"
                },
                {
                    "id": "101120403",
                    "speaker": "派蒙",
                    "text": "丘丘人为什么要围着这种东西膜拜呢？"
                },
                {
                    "id": "101120404",
                    "speaker": "温迪",
                    "text": "（恐怕只是，有人把剑扔进了丘丘人本来就在膜拜的战利品堆里吧…）"
                },
                {
                    "id": "101120405",
                    "speaker": "杰克",
                    "text": "这、这也太旧了！而且…该怎么说呢，普通到让人说不出话…"
                },
                {
                    "id": "101120406",
                    "speaker": "温迪",
                    "text": "不，杰克，你有没有见过蒙德城外飞舞的风晶蝶？"
                },
                {
                    "id": "101120407",
                    "speaker": "温迪",
                    "text": "这种蝴蝶在白天毫不起眼，到了漆黑的夜晚却会光彩夺目，简直就像是会飞的宝石。"
                },
                {
                    "id": "101120408",
                    "speaker": "温迪",
                    "text": "勇气不也是这样吗？一帆风顺的人不会明白它的可贵，可当你身处绝境，勇气就是令你奋起抗争、走出绝境的唯一之光。",
                    "choices": [
                        {
                            "id": "101120409",
                            "text": "巧舌如簧。",
                            "response": [
                                {
                                    "id": "101120412",
                                    "speaker": "杰克",
                                    "text": "你、你说得太对了！没错就是这样，这一定就是「辉煌勇气之剑」啊！"
                                },
                                {
                                    "id": "101120413",
                                    "speaker": "温迪",
                                    "text": "嗯，那么，剑已经找到，只差盾了。"
                                },
                                {
                                    "id": "101120414",
                                    "speaker": "温迪",
                                    "text": "在附近转转吧！东西一定就在<color=#00E1FFFF>达达乌帕谷</color>里——嗯？"
                                },
                                {
                                    "id": "101120415",
                                    "speaker": "派蒙",
                                    "text": "哎呀？那边好像有个人！"
                                },
                                {
                                    "id": "101120416",
                                    "speaker": "温迪",
                                    "text": "斯坦利？他怎么在这儿？"
                                },
                                {
                                    "id": "101120417",
                                    "speaker": "派蒙",
                                    "text": "他的样子有点奇怪…"
                                },
                                {
                                    "id": "101120418",
                                    "speaker": "杰克",
                                    "text": "出什么事了吗？为什么突然停下？"
                                },
                                {
                                    "id": "101120419",
                                    "speaker": "温迪",
                                    "text": "没什么，刚才有只会撒金币的「盗宝鼬」跑过去了。"
                                },
                                {
                                    "id": "101120420",
                                    "speaker": "杰克",
                                    "text": "什么？在哪儿！我也要看！"
                                },
                                {
                                    "id": "101120421",
                                    "speaker": "温迪",
                                    "text": "你不是来找神器的吗？就别看啦。"
                                }
                            ]
                        },
                        {
                            "id": "101120410",
                            "text": "令人震撼。"
                        },
                        {
                            "id": "101120411",
                            "text": "我都快信了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011212",
            "objective": "(test)撤掉剑$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1011205",
            "objective": "寻找光耀意志之盾",
            "dialogues": []
        },
        {
            "id": "1011206",
            "objective": "与丘丘人交涉",
            "dialogues": [
                {
                    "id": "101120601",
                    "speaker": "温迪",
                    "text": "看，<color=#00E1FFFF>「光耀意志之盾」</color>！"
                },
                {
                    "id": "101120602",
                    "speaker": "派蒙",
                    "text": "骗人！那根本就是块普通木板吧！"
                },
                {
                    "id": "101120603",
                    "speaker": "派蒙",
                    "text": "破破烂烂的，还带着桶箍！谁会把这种东西当成盾牌啊？"
                },
                {
                    "id": "101120604",
                    "speaker": "杰克",
                    "text": "而且上面还有酒渍…像是从酒桶上随便拆下来的…"
                },
                {
                    "id": "101120605",
                    "speaker": "温迪",
                    "text": "可按我吟游诗人的直觉，这就是「光耀意志之盾」。"
                },
                {
                    "id": "101120606",
                    "speaker": "温迪",
                    "text": "战士以身上的疤痕为荣，盾牌也是一样。"
                },
                {
                    "id": "101120607",
                    "speaker": "温迪",
                    "text": "一面盾牌越是完整，越说明它远离战场。盾牌的破旧，不正是它身经百战的证明吗？"
                },
                {
                    "id": "101120608",
                    "speaker": "温迪",
                    "text": "即使身躯残破，也要在战场上拼杀到最后一刻，要战斗到流干最后一滴血为止。这样的意志，难道不珍贵吗？",
                    "choices": [
                        {
                            "id": "101120609",
                            "text": "温迪说得对！",
                            "response": [
                                {
                                    "id": "101120612",
                                    "speaker": "派蒙",
                                    "text": "说得也是…哪有干干净净的盾牌啊…"
                                },
                                {
                                    "id": "101120613",
                                    "speaker": "派蒙",
                                    "text": "那我们…想办法问问它，能不能把「光耀意志之盾」转让给我们？"
                                },
                                {
                                    "id": "101120614",
                                    "speaker": "派蒙",
                                    "text": "你好，丘丘人先生？"
                                },
                                {
                                    "id": "101120615",
                                    "speaker": "丘丘人",
                                    "text": "Dala？"
                                },
                                {
                                    "id": "101120616",
                                    "speaker": "派蒙",
                                    "text": "#哇，{NICKNAME}还是你来吧。试试平时听过的那些丘丘语音节？或者用肢体语言交流吧…",
                                    "choices": [
                                        {
                                            "id": "101120617",
                                            "text": "我用摩拉和你换盾牌。",
                                            "response": [
                                                {
                                                    "id": "101120622",
                                                    "speaker": "丘丘人",
                                                    "text": "Biadam！"
                                                },
                                                {
                                                    "id": "101120623",
                                                    "speaker": "派蒙",
                                                    "text": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。",
                                                    "choices": [
                                                        {
                                                            "id": "101120624",
                                                            "text": "这朵甜甜花，送给你。",
                                                            "response": [
                                                                {
                                                                    "id": "101120627",
                                                                    "speaker": "丘丘人",
                                                                    "text": "Mosi mita！"
                                                                },
                                                                {
                                                                    "id": "101120628",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "101120631",
                                                                            "text": "温迪，唱歌。盾牌，给我。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101120632",
                                                                                    "speaker": "温迪",
                                                                                    "text": "嗯？好吧，那我就稍微弹一段…"
                                                                                },
                                                                                {
                                                                                    "id": "101120634",
                                                                                    "speaker": "丘丘人",
                                                                                    "text": "Mosi mita！"
                                                                                },
                                                                                {
                                                                                    "id": "101120635",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "101120633",
                                                                            "text": "mani nini Biaodomu.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "101120636",
                                                                                    "speaker": "丘丘人",
                                                                                    "text": "Biadam！"
                                                                                },
                                                                                {
                                                                                    "id": "101120637",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101120625",
                                                            "text": "我收缴的丘丘面具，送给你。",
                                                            "response": [
                                                                {
                                                                    "id": "101120629",
                                                                    "speaker": "丘丘人",
                                                                    "text": "Biadam！"
                                                                },
                                                                {
                                                                    "id": "101120630",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…它好像<color=#00E1FFFF>不太开心</color>的样子。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "101120631",
                                                                            "text": "温迪，唱歌。盾牌，给我。"
                                                                        },
                                                                        {
                                                                            "id": "101120633",
                                                                            "text": "mani nini Biaodomu."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101120626",
                                                            "text": "Kucha pupu gusha ye!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101120618",
                                            "text": "请把盾牌送给我们。"
                                        },
                                        {
                                            "id": "101120619",
                                            "text": "Vin plata dada！",
                                            "response": [
                                                {
                                                    "id": "101120620",
                                                    "speaker": "丘丘人",
                                                    "text": "Mosi mita！"
                                                },
                                                {
                                                    "id": "101120621",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，看起来它的情绪还挺<color=#00E1FFFF>稳定</color>，也许可以继续谈…",
                                                    "choices": [
                                                        {
                                                            "id": "101120624",
                                                            "text": "这朵甜甜花，送给你。"
                                                        },
                                                        {
                                                            "id": "101120625",
                                                            "text": "我收缴的丘丘面具，送给你。"
                                                        },
                                                        {
                                                            "id": "101120626",
                                                            "text": "Kucha pupu gusha ye!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101120610",
                            "text": "我也觉得这就是那面盾牌。"
                        },
                        {
                            "id": "101120611",
                            "text": "不愧是你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011207",
            "objective": "(test)谈判成功$HIDDEN",
            "dialogues": [
                {
                    "id": "101120701",
                    "speaker": "丘丘人",
                    "text": "Muhe vin plata? Mani ye! Mani dada!"
                },
                {
                    "id": "101120702",
                    "speaker": "派蒙",
                    "text": "好耶！它把「光耀意志之盾」递过来了！"
                }
            ]
        },
        {
            "id": "1011208",
            "objective": "(test)谈判失败$HIDDEN",
            "dialogues": [
                {
                    "id": "101120801",
                    "speaker": "丘丘人",
                    "text": "Yaya ika! Kundala ye plata!"
                },
                {
                    "id": "101120802",
                    "speaker": "派蒙",
                    "text": "不好！我们彻底惹恼它了！"
                }
            ]
        },
        {
            "id": "1011213",
            "objective": "(test)谈判失败后的对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1011209",
            "objective": "击败来袭的丘丘人",
            "dialogues": []
        },
        {
            "id": "1011210",
            "objective": "与丘丘人对话",
            "dialogues": [
                {
                    "id": "101121101",
                    "speaker": "丘丘人",
                    "text": "Biadam！"
                },
                {
                    "id": "101121102",
                    "speaker": "丘丘人",
                    "text": "Yaya ika! Mani ye!"
                },
                {
                    "id": "101121103",
                    "speaker": "派蒙",
                    "text": "啊，它丢下<color=#00E1FFFF>「光耀意志之盾」</color>跑了。"
                }
            ]
        },
        {
            "id": "1011211",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "101121001",
                    "speaker": "杰克",
                    "text": "谢谢你们，谢谢你们！我找到我要的东西了！"
                },
                {
                    "id": "101121002",
                    "speaker": "杰克",
                    "text": "爸爸妈妈！看看我找到的神器吧！"
                },
                {
                    "id": "101121003",
                    "speaker": "温迪",
                    "text": "哎？等等！"
                },
                {
                    "id": "101121004",
                    "speaker": "温迪",
                    "text": "说好的酒呢！我帮这么多忙也是很累的吧——"
                },
                {
                    "id": "101121005",
                    "speaker": "温迪",
                    "text": "嗯？这不是斯坦利么，你到这里来散步吗。"
                },
                {
                    "id": "101121006",
                    "speaker": "斯坦利",
                    "text": "啊、啊哈哈哈哈，这不是吟游诗人吗！真巧，你也来这里散步？"
                },
                {
                    "id": "101121007",
                    "speaker": "温迪",
                    "text": "是啊，吃完饭出来走走，陪朋友找点东西。"
                },
                {
                    "id": "101121008",
                    "speaker": "派蒙",
                    "text": "（我越来越觉得，斯坦利先生可能是骗子了…）",
                    "choices": [
                        {
                            "id": "101121009",
                            "text": "（我也这么想…）",
                            "response": [
                                {
                                    "id": "101121011",
                                    "speaker": "派蒙",
                                    "text": "（所以斯坦利是为了不伤害杰克的感情，才故意提前一步，到这里布置剑和盾吗？）"
                                },
                                {
                                    "id": "101121012",
                                    "speaker": "温迪",
                                    "text": "大冒险家一定很熟悉达达乌帕谷吧？毕竟，这里是你战斗过的地方。"
                                },
                                {
                                    "id": "101121013",
                                    "speaker": "斯坦利",
                                    "text": "当然，当然，我闭着眼睛都能把这里走遍！"
                                },
                                {
                                    "id": "101121014",
                                    "speaker": "温迪",
                                    "text": "原来如此，真佩服你的记性和毅力。"
                                },
                                {
                                    "id": "101121015",
                                    "speaker": "斯坦利",
                                    "text": "我是大冒险家嘛，应该的！倒是你们，这里有很多丘丘人，可别掉以轻心啊！"
                                },
                                {
                                    "id": "101121016",
                                    "speaker": "斯坦利",
                                    "text": "那、那就再见了，年轻人们。"
                                },
                                {
                                    "id": "101121017",
                                    "speaker": "派蒙",
                                    "text": "他果然非常心虚啊。"
                                },
                                {
                                    "id": "101121018",
                                    "speaker": "温迪",
                                    "text": "没办法，谁让他对杰克夸下海口了呢。"
                                },
                                {
                                    "id": "101121019",
                                    "speaker": "温迪",
                                    "text": "不过…再看一次，果然有意思。"
                                },
                                {
                                    "id": "101121020",
                                    "speaker": "温迪",
                                    "text": "不愿遗忘「过去」，而抛弃「现在」的人…"
                                },
                                {
                                    "id": "101121021",
                                    "speaker": "温迪",
                                    "text": "如果他被迫迈出「向未来」的第一步，又会踏在什么方向呢？"
                                },
                                {
                                    "id": "101121022",
                                    "speaker": "派蒙",
                                    "text": "嗯？什么意思？"
                                },
                                {
                                    "id": "101121023",
                                    "speaker": "温迪",
                                    "text": "哈哈，自言自语而已。"
                                },
                                {
                                    "id": "101121024",
                                    "speaker": "温迪",
                                    "text": "#对了，{NICKNAME}。今晚，我们去<color=#00E1FFFF>「天使的馈赠」</color>看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "101121010",
                            "text": "（不是可能，是一定。）"
                        }
                    ]
                }
            ]
        }
    ]
}