    "talks": [
        {
            "id": "7513207",
            "objective": "(test)摸假观景点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7513201",
            "objective": "(test)（test）在部落涂鸦前冥想$HIDDEN",
            "dialogues": [
                {
                    "id": "751320101",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "…啊…自遥远处而来的，异邦的勇士啊…"
                },
                {
                    "id": "751320102",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "请您听取我的话语吧，啊，我是引路的夜鸦，亦是真夜主人揣摩诗句的忆绪…或也只不过是月光中千万念头中的一个。"
                },
                {
                    "id": "751320103",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "请您听取我的话语吧，因地下流淌的灵河破碎不堪，我也只能借这形象与您述说，以求您提防那些漆黑的敌雠。"
                },
                {
                    "id": "751320104",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "在此地，那破碎的镜子曾映照，而如今黑烟逐渐弥漫之处有三，请您记住："
                },
                {
                    "id": "751320105",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "其一是东侧，那过往英雄传说壁画中潜藏的阴影逐渐浮现。"
                },
                {
                    "id": "751320106",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "其二是西侧，迷海之上，漆黑的化身如恼人的鹦鹉一般模仿夤夜之主的口舌。"
                },
                {
                    "id": "751320107",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "其三是群崖之下，原本应已绝迹的失色之雾，在烬城又开始蠢动后弥漫…"
                },
                {
                    "id": "751320108",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "异邦的勇士啊，请务必小心…小心那漆黑之敌漫行之处，小心侵蚀一切的敌雠。"
                }
            ]
        },
        {
            "id": "7513202",
            "objective": "(test)解决部落难题$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7513204",
            "objective": "(test)解决部落难题$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7513203",
            "objective": "(test)解决部落难题$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7513205",
            "objective": "(test)闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751320501",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "小心那漆黑之敌漫行之处，小心侵蚀一切的敌雠。"
                },
                {
                    "id": "751320502",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "异邦的勇士啊…有什么想要得知之事吗…",
                    "choices": [
                        {
                            "id": "751320503",
                            "text": "关于英雄的壁画…",
                            "response": [
                                {
                                    "id": "751320504",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "东侧，诸多流光荧树摇曳的洞窟之中，正如手持织卷的叙事人所说，过往故事之中亦有被潜藏其中的恐怖。"
                                },
                                {
                                    "id": "751320505",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "或许其中的阴影正借由过往的故事本身，寻求逃脱之法…"
                                }
                            ]
                        },
                        {
                            "id": "751320506",
                            "text": "关于迷海之上…",
                            "response": [
                                {
                                    "id": "751320507",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "西侧被迷雾深藏的岛屿，那里原本是祭祀的圣所，亦是许久之前与暝视的龙众签立契约者的居留之地。"
                                },
                                {
                                    "id": "751320508",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "只是淤泥从中涌现，圣所变作了漆黑的孔窍，那里亦被封印与遗忘…啊，可是那狡猾的敌人不会如此轻易放弃…"
                                }
                            ]
                        },
                        {
                            "id": "751320509",
                            "text": "关于失色之雾…",
                            "response": [
                                {
                                    "id": "751320510",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "那原本是名为奥奇卡纳塔的古城毁灭之时产生的污秽之雾，原本已遭封绝…可岁月与遗忘亦是大敌…"
                                },
                                {
                                    "id": "751320511",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "若是…啊…若是有人能够重新驱散那些失色之雾就好了…"
                                }
                            ]
                        },
                        {
                            "id": "751320512",
                            "text": "不，没有什么想知道的。",
                            "response": [
                                {
                                    "id": "751320513",
                                    "speaker": "谜画涂鸦中的意志",
                                    "text": "啊…还请切记，务必…务必小心…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7513206",
            "objective": "(test)回到冥想处$HIDDEN",
            "dialogues": [
                {
                    "id": "751320601",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "啊，异邦的勇士啊…我能感受到…你所做出的一切。"
                },
                {
                    "id": "751320602",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "真是了不起啊，勇士，被侵蚀的力量也回归了夜神的国度，我能感受到夜魂们的欢悦。"
                },
                {
                    "id": "751320603",
                    "speaker": "谜画涂鸦中的意志",
                    "text": "那么…就将这些作为报酬吧，勇士，达成伟业者，应当有所奖赏，请收下这些吧。"
                }
            ]
        }
    ]
}