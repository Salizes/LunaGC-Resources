    "talks": [
        {
            "id": "1080601",
            "objective": "",
            "dialogues": [
                {
                    "id": "698220101",
                    "speaker": "迪卢克",
                    "text": "…嗯，最大的问题是定价。"
                },
                {
                    "id": "698220102",
                    "speaker": "迪卢克",
                    "text": "哦，你来了，坐吧。",
                    "choices": [
                        {
                            "id": "698220103",
                            "text": "迪卢克在忙什么？",
                            "response": [
                                {
                                    "id": "698220105",
                                    "speaker": "迪卢克",
                                    "text": "我在看酒庄这阵子的产量和销售汇报，没事，我刚看完。"
                                },
                                {
                                    "id": "698220106",
                                    "speaker": "Player",
                                    "text": "遇到麻烦了吗？"
                                },
                                {
                                    "id": "698220107",
                                    "speaker": "迪卢克",
                                    "text": "也不能说是什么大麻烦，只是上一批葡萄受气候影响，产量有所下降。"
                                },
                                {
                                    "id": "698220108",
                                    "speaker": "迪卢克",
                                    "text": "埃泽应对得很及时，那一批葡萄酿出的酒品质没有瑕疵，唯一需要我出面解决的是定价问题。"
                                },
                                {
                                    "id": "698220109",
                                    "speaker": "迪卢克",
                                    "text": "我们的供应量降低了，但来自蒙德和外部的需求没有变化，这种时候的定价需要慎重一点考虑。"
                                },
                                {
                                    "id": "698220110",
                                    "speaker": "Player",
                                    "text": "物以稀为贵…"
                                },
                                {
                                    "id": "698220111",
                                    "speaker": "迪卢克",
                                    "text": "正是。需求大于供给的时候，总会有人想为自己争取更多的利润，经销商们也都有这个意思。"
                                },
                                {
                                    "id": "698220112",
                                    "speaker": "迪卢克",
                                    "text": "但晨曦酒庄无意提价。酒庄的生意做了很久，购买晨曦酒庄出品的酒水已经是蒙德人生活的一部分。"
                                },
                                {
                                    "id": "698220113",
                                    "speaker": "迪卢克",
                                    "text": "为了短期利润破坏所有人对晨曦酒庄的回忆，没有必要。"
                                },
                                {
                                    "id": "698220114",
                                    "speaker": "迪卢克",
                                    "text": "我不缺那点钱。"
                                },
                                {
                                    "id": "698220115",
                                    "speaker": "Player",
                                    "text": "这就是酒庄老板的魄力吗！"
                                },
                                {
                                    "id": "698220116",
                                    "speaker": "迪卢克",
                                    "text": "…很意外吗？埃泽倒是很快接受了这个理由，立刻去找经销商了。"
                                },
                                {
                                    "id": "698220117",
                                    "speaker": "迪卢克",
                                    "text": "对了，你有阵子没来酒庄，要给你开一瓶喝的吗？",
                                    "choices": [
                                        {
                                            "id": "698220118",
                                            "text": "主要是来探望迪卢克的…",
                                            "response": [
                                                {
                                                    "id": "698220120",
                                                    "speaker": "迪卢克",
                                                    "text": "不用和我客气。我今天恰好想喝点苹果酿，一起喝一杯？"
                                                },
                                                {
                                                    "id": "698220121",
                                                    "speaker": "迪卢克",
                                                    "text": "苹果酿开瓶后，倒出来的第一杯香气最足。这杯给你。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698220119",
                                            "text": "倒是有点口渴了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698220104",
                            "text": "我打扰到你了吗？"
                        }
                    ]
                }
            ]
        }
    ]
}