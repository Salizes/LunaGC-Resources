        },
        {
            "id": "1104401",
            "objective": "与返回的阿贝多交谈",
            "dialogues": [
                {
                    "id": "110440141",
                    "speaker": "阿贝多",
                    "text": "我回来了，你们看到什么有意思的东西了吗？",
                    "choices": [
                        {
                            "id": "110440142",
                            "text": "都看不懂。",
                            "response": [
                                {
                                    "id": "110440143",
                                    "speaker": "阿贝多",
                                    "text": "没关系，只是一些炼金术的常用物件而已，生活中不太会用到。"
                                },
                                {
                                    "id": "110440146",
                                    "speaker": "阿贝多",
                                    "text": "总之，抓紧时间进行下一项研究吧。"
                                },
                                {
                                    "id": "110440101",
                                    "speaker": "阿贝多",
                                    "text": "不同的世界之间，可能存在非常大的差异。"
                                },
                                {
                                    "id": "110440102",
                                    "speaker": "阿贝多",
                                    "text": "打个比方来说，在提瓦特，拥有神之眼的人就可以使用元素力。"
                                },
                                {
                                    "id": "110440103",
                                    "speaker": "阿贝多",
                                    "text": "但也可能存在「只有一人可以使用元素力的世界」，又或者「每个人都能使用元素力的世界」。"
                                },
                                {
                                    "id": "110440104",
                                    "speaker": "阿贝多",
                                    "text": "#所以，{NICKNAME}，除了元素之外…你是否还掌握一些，这个世界没有的特殊力量呢？"
                                },
                                {
                                    "id": "110440105",
                                    "speaker": "阿贝多",
                                    "text": "还是只能用之前的办法，用实验来测定了。",
                                    "choices": [
                                        {
                                            "id": "110440106",
                                            "text": "又要打史莱姆吗？",
                                            "response": [
                                                {
                                                    "id": "110440108",
                                                    "speaker": "阿贝多",
                                                    "text": "不不不，这次就不费什么周折了。"
                                                },
                                                {
                                                    "id": "110440109",
                                                    "speaker": "阿贝多",
                                                    "text": "这边有根柱子，你试试看用意志力将它折断吧。",
                                                    "choices": [
                                                        {
                                                            "id": "110440110",
                                                            "text": "抱歉，我做不到。",
                                                            "response": [
                                                                {
                                                                    "id": "110440111",
                                                                    "speaker": "阿贝多",
                                                                    "text": "已经认真地尝试过了吗？是吗…唔，没关系。"
                                                                },
                                                                {
                                                                    "id": "110440112",
                                                                    "speaker": "派蒙",
                                                                    "text": "这才是正常的吧，怎么觉得你有点失望的样子。"
                                                                },
                                                                {
                                                                    "id": "110440116",
                                                                    "speaker": "阿贝多",
                                                                    "text": "对了，你有尝试过用元素力做菜吗？不是说烹饪，而是把元素力放进菜里。"
                                                                },
                                                                {
                                                                    "id": "110440117",
                                                                    "speaker": "阿贝多",
                                                                    "text": "我很好奇菜会不会因此变得更好吃，或者改变口感，甚至是…增殖？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110440118",
                                                                            "text": "炼金术士的想法真是独特。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110440120",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "哈哈，好奇心放在平时别人不会注意的地方，更容易发现惊喜。"
                                                                                },
                                                                                {
                                                                                    "id": "110440121",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "那么，拜托你们去做一道「黄油煎鱼」吧，这里是我刚刚准备的食谱。"
                                                                                },
                                                                                {
                                                                                    "id": "110440151",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "还以为你是去准备奇奇怪怪的东西，原来是食谱啊？"
                                                                                },
                                                                                {
                                                                                    "id": "110440122",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "因为平时我也经常吃这个，无论是做实验还是品尝，它都是很好的选择。"
                                                                                },
                                                                                {
                                                                                    "id": "110440123",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "你肯定是饿了吧！"
                                                                                },
                                                                                {
                                                                                    "id": "110440124",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过如果要做好吃的，我是不会反对的。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110440125",
                                                                                            "text": "好好好，明白了。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110440127",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯嗯，这就是好伙伴的默契！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110440128",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "那就交给你们了，我很期待实验结果。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110440130",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "如果真的出现我们吃不完的情况，还可以请蒂玛乌斯一起来分享。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110440131",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "有我在，不用担心这种事啦！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110440126",
                                                                                            "text": "不会忘记你的那一份的。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110440119",
                                                                            "text": "你不会只是因为饿了吧？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110440113",
                                                            "text": "折断它吧，派蒙。",
                                                            "response": [
                                                                {
                                                                    "id": "110440114",
                                                                    "speaker": "派蒙",
                                                                    "text": "无论是你还是我都做不到啊！"
                                                                },
                                                                {
                                                                    "id": "110440115",
                                                                    "speaker": "阿贝多",
                                                                    "text": "已经认真地尝试过了吗？是吗…唔，没关系。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110440107",
                                            "text": "又要喝药吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110440144",
                            "text": "有点乱。",
                            "response": [
                                {
                                    "id": "110440145",
                                    "speaker": "阿贝多",
                                    "text": "嗯，同感，我也正想找个时间收拾一下，不过实验一个接一个…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104404",
            "objective": "(test)获得料理$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104414",
            "objective": "(test)交付料理$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104415",
            "objective": "(test)交付美味之后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "110440500",
                    "speaker": "阿贝多",
                    "text": "唔，实验上看非常普通，但滋味实在美妙。你很有烹饪的天赋。"
                },
                {
                    "id": "110440502",
                    "speaker": "阿贝多",
                    "text": "我最期待的增殖现象并没有出现，看来就算是你的世界也无法摆脱食物的困扰。"
                },
                {
                    "id": "110440503",
                    "speaker": "阿贝多",
                    "text": "不对，可能是这个世界的法则限制了你的特殊能力？"
                },
                {
                    "id": "110440504",
                    "speaker": "派蒙",
                    "text": "首先是不知道要怎么样把元素力，像调味品一样放进料理吧。"
                },
                {
                    "id": "110440505",
                    "speaker": "阿贝多",
                    "text": "没关系，至少没有浪费可口的食物，你们也不必感到沮丧。"
                },
                {
                    "id": "110440506",
                    "speaker": "阿贝多",
                    "text": "这里是答应要分享给你的那一份，慢慢享用吧，带走也没问题。"
                },
                {
                    "id": "110440507",
                    "speaker": "派蒙",
                    "text": "谢谢你，居然好好地记得这件事！",
                    "choices": [
                        {
                            "id": "110440508",
                            "text": "你对派蒙真好。",
                            "response": [
                                {
                                    "id": "110440510",
                                    "speaker": "阿贝多",
                                    "text": "因为我能看出她是你很好的朋友，实验过程中她一直在提醒你，也在担心你的安危。"
                                },
                                {
                                    "id": "110440511",
                                    "speaker": "阿贝多",
                                    "text": "虽然这些提醒和担心有没有起到作用，是需要另外讨论的…"
                                },
                                {
                                    "id": "110440512",
                                    "speaker": "派蒙",
                                    "text": "喂，不要突然说我坏话啊。"
                                },
                                {
                                    "id": "110440513",
                                    "speaker": "派蒙",
                                    "text": "不过你请我吃了好吃的，我愿意原谅你。"
                                },
                                {
                                    "id": "110440514",
                                    "speaker": "派蒙",
                                    "text": "也不用羡慕我们关系这么好啦。你不是也有朋友，还有学生吗？"
                                },
                                {
                                    "id": "110440515",
                                    "speaker": "阿贝多",
                                    "text": "…嗯，是啊，我也算幸运的吧。不说这些了，我们进行下一项实验吧。"
                                },
                                {
                                    "id": "110440516",
                                    "speaker": "阿贝多",
                                    "text": "炼金术用品种类繁杂，如何收纳存放是个令人头疼的问题。前不久因为意外，我的收藏品散落了一地。"
                                },
                                {
                                    "id": "110440517",
                                    "speaker": "阿贝多",
                                    "text": "虽然大部分都找了回来，但有一瓶风晶蝶的元素萃取物，还有一瓶无相之雷的粉末，怎么都找不到了。"
                                },
                                {
                                    "id": "110440518",
                                    "speaker": "派蒙",
                                    "text": "做饭之后，接下来又是找东西？"
                                },
                                {
                                    "id": "110440519",
                                    "speaker": "阿贝多",
                                    "text": "没关系，本来就打算重新制备了，只是如果能找到，就可以省去很多麻烦。"
                                },
                                {
                                    "id": "110440520",
                                    "speaker": "阿贝多",
                                    "text": "假如你拥有「夜视」，或者「震动感知」之类的超能力，要找到遗失的小物件就是轻而易举了。"
                                },
                                {
                                    "id": "110440521",
                                    "speaker": "阿贝多",
                                    "text": "东西应该就掉在之前你们参观过的地方的某个角落里。"
                                },
                                {
                                    "id": "110440522",
                                    "speaker": "派蒙",
                                    "text": "那…就只能试试看了？"
                                },
                                {
                                    "id": "110440523",
                                    "speaker": "Player",
                                    "text": "丢的东西好像都有元素力。"
                                },
                                {
                                    "id": "110440524",
                                    "speaker": "派蒙",
                                    "text": "对哦！可以用元素视野！"
                                }
                            ]
                        },
                        {
                            "id": "110440509",
                            "text": "很少有人对派蒙这么好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104416",
            "objective": "(test)交付普通之后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "110440501",
                    "speaker": "阿贝多",
                    "text": "唔，是非常普通的好吃料理呢。"
                }
            ]
        },
        {
            "id": "1104405",
            "objective": "烹饪「黄油煎鱼」并交给阿贝多",
            "dialogues": []
        },
        {
            "id": "1104402",
            "objective": "(test)完成元素视野解谜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104411",
            "objective": "(test)完成元素视野解谜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104412",
            "objective": "使用「元素视野」寻找失物",
            "dialogues": []
        },
        {
            "id": "1104413",
            "objective": "(test)回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "110441301",
                    "speaker": "阿贝多",
                    "text": "听到了一个很有意思的词，嗯，真是有趣。"
                },
                {
                    "id": "110441302",
                    "speaker": "阿贝多",
                    "text": "去找找看吧，我在这里等你。"
                }
            ]
        },
        {
            "id": "1104403",
            "objective": "与阿贝多交谈，获取结论",
            "dialogues": [
                {
                    "id": "110440320",
                    "speaker": "阿贝多",
                    "text": "没想到你们真的全都找到了，非常感谢。"
                },
                {
                    "id": "110440321",
                    "speaker": "阿贝多",
                    "text": "寻找物品，还有之前来雪山找我的时候，用到的都是「元素视野」，对吧？"
                },
                {
                    "id": "110440322",
                    "speaker": "派蒙",
                    "text": "是的，这个应该算是超能力吧？"
                },
                {
                    "id": "110440323",
                    "speaker": "阿贝多",
                    "text": "有点遗憾，虽然「元素视野」比较罕见，但是总归是提瓦特大陆存在的能力。"
                },
                {
                    "id": "110440324",
                    "speaker": "阿贝多",
                    "text": "只有完全没有听说过的异世界超能力，才能为我的研究提供帮助。"
                },
                {
                    "id": "110440325",
                    "speaker": "派蒙",
                    "text": "也就是说，又白忙一场…"
                },
                {
                    "id": "110440326",
                    "speaker": "阿贝多",
                    "text": "不用太沮丧，这也在预料之中，而且能回收失物，这次实验已经非常有价值了。"
                },
                {
                    "id": "110440301",
                    "speaker": "阿贝多",
                    "text": "你们能够想到失物都具有元素力这一点，也值得称赞。"
                },
                {
                    "id": "110440302",
                    "speaker": "阿贝多",
                    "text": "好了，之前都是在研究异世界可能存在的与众不同之处，但是对于你人类的身份的研究，现在才要开始。",
                    "choices": [
                        {
                            "id": "110440303",
                            "text": "做好奉陪到底的准备了。",
                            "response": [
                                {
                                    "id": "110440305",
                                    "speaker": "阿贝多",
                                    "text": "人类的个体差异，集中体现在智能和身体机能的水平上，我们就从身体机能方面开始吧。"
                                },
                                {
                                    "id": "110440306",
                                    "speaker": "阿贝多",
                                    "text": "从这里望出去，你可以看见砂糖她现在在做什么吗？"
                                },
                                {
                                    "id": "110440307",
                                    "speaker": "Player",
                                    "text": "不能。"
                                },
                                {
                                    "id": "110440308",
                                    "speaker": "阿贝多",
                                    "text": "那如果你平地起跳，跳到那边的山崖上，能看到吗？"
                                },
                                {
                                    "id": "110440309",
                                    "speaker": "Player",
                                    "text": "不能。"
                                },
                                {
                                    "id": "110440310",
                                    "speaker": "阿贝多",
                                    "text": "那如果你一拳打碎面前的山体，能看到吗？",
                                    "choices": [
                                        {
                                            "id": "110440311",
                                            "text": "不能。",
                                            "response": [
                                                {
                                                    "id": "110440313",
                                                    "speaker": "阿贝多",
                                                    "text": "既然是这样，可能还要下调一点期待。比起提问，还是做实验更直观。"
                                                },
                                                {
                                                    "id": "110440314",
                                                    "speaker": "阿贝多",
                                                    "text": "我知道一个地方非常适合进行体能实验，跟我过来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110440312",
                                            "text": "我觉得这个还是超能力测试。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110440304",
                            "text": "这就叫「上了贼船」吧。"
                        }
                    ]
                }
            ]
        }
    ]
}