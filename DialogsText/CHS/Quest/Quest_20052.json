    },
    "talks": [
        {
            "id": "2005201",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200520101",
                    "speaker": "安娜",
                    "text": "好…今天也要努力完成委托！",
                    "choices": [
                        {
                            "id": "200520102",
                            "text": "真是有干劲啊。",
                            "response": [
                                {
                                    "id": "200520103",
                                    "speaker": "安娜",
                                    "text": "那是当然了，做冒险家可是很有趣的。"
                                },
                                {
                                    "id": "200520104",
                                    "speaker": "安娜",
                                    "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。"
                                },
                                {
                                    "id": "200520105",
                                    "speaker": "安娜",
                                    "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。"
                                },
                                {
                                    "id": "200520108",
                                    "speaker": "安娜",
                                    "text": "那我们就快出发吧，今天的委托是…"
                                },
                                {
                                    "id": "200520109",
                                    "speaker": "安娜",
                                    "text": "嗯…又是护送货运热气球…"
                                }
                            ]
                        },
                        {
                            "id": "200520106",
                            "text": "要我陪你去吗？",
                            "response": [
                                {
                                    "id": "200520107",
                                    "speaker": "安娜",
                                    "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005202",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200520201",
                    "speaker": "安娜",
                    "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。"
                },
                {
                    "id": "200520202",
                    "speaker": "安娜",
                    "text": "不过，冒险家平时去执行的委托，都是这种事情吗？",
                    "choices": [
                        {
                            "id": "200520203",
                            "text": "会有其他委托的。",
                            "response": [
                                {
                                    "id": "200520204",
                                    "speaker": "安娜",
                                    "text": "你的语气也太无奈了…"
                                },
                                {
                                    "id": "200520207",
                                    "speaker": "安娜",
                                    "text": "是这样吗…好嘞！那我要继续努力了！"
                                },
                                {
                                    "id": "200520208",
                                    "speaker": "安娜",
                                    "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！"
                                },
                                {
                                    "id": "200520209",
                                    "speaker": "安娜",
                                    "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。"
                                },
                                {
                                    "id": "200520210",
                                    "speaker": "安娜",
                                    "text": "现在我的病已经好了，也成为了冒险家。"
                                },
                                {
                                    "id": "200520211",
                                    "speaker": "安娜",
                                    "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
                                }
                            ]
                        },
                        {
                            "id": "200520205",
                            "text": "你慢慢就会知道了…",
                            "response": [
                                {
                                    "id": "200520206",
                                    "speaker": "安娜",
                                    "text": "喂，你的表情不要这么疲惫啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005203",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200520301",
                    "speaker": "安东尼",
                    "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
                },
                {
                    "id": "200520302",
                    "speaker": "Player",
                    "text": "你不希望她做冒险家吗？"
                },
                {
                    "id": "200520303",
                    "speaker": "安东尼",
                    "text": "……"
                },
                {
                    "id": "200520304",
                    "speaker": "安东尼",
                    "text": "我尊重我妹妹的梦想。"
                },
                {
                    "id": "200520305",
                    "speaker": "安东尼",
                    "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
                },
                {
                    "id": "200520306",
                    "speaker": "安东尼",
                    "text": "作为她的哥哥，我…会全力支持她。"
                },
                {
                    "id": "200520307",
                    "speaker": "安东尼",
                    "text": "就这样。"
                }
            ]
        },
        {
            "id": "2005204",
            "objective": "与安娜对话",
            "dialogues": []
        }
    ]
}