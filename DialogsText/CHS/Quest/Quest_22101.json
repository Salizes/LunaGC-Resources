{
    "quest": {
        "id": "22101",
        "title": "花洲有客栈",
        "description": "因为望舒客栈周围时常有魔物侵扰，淮安正在为此发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 25,
        "total_speaker_counts": {
            "Player": 5,
            "淮安": 20
        }
    },
    "talks": [
        {
            "id": "2210101",
            "objective": "与淮安对话",
            "dialogues": [
                {
                    "id": "221010101",
                    "speaker": "淮安",
                    "text": "没完没了…"
                },
                {
                    "id": "221010102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221010103",
                    "speaker": "淮安",
                    "text": "唉，在这里开个客栈可不容易…"
                },
                {
                    "id": "221010104",
                    "speaker": "淮安",
                    "text": "不知道是不是我的错觉…总觉得周围的那些怪物，是越来越多了。"
                },
                {
                    "id": "221010105",
                    "speaker": "淮安",
                    "text": "虽然它们也不会靠近客栈，但是客人总要进出，来往道路上的千岩军也不可能时刻把守。"
                },
                {
                    "id": "221010106",
                    "speaker": "淮安",
                    "text": "如果有空的话，你能帮我去周围看看，把客栈旁边的怪物给清一清吗？",
                    "choices": [
                        {
                            "id": "221010107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221010109",
                                    "speaker": "淮安",
                                    "text": "哈哈，您说话做事真是爽利。"
                                },
                                {
                                    "id": "221010113",
                                    "speaker": "淮安",
                                    "text": "让您受累，实在是有些不好意思。"
                                },
                                {
                                    "id": "221010114",
                                    "speaker": "淮安",
                                    "text": "事结之后，报酬我绝不会少您一分的，请您放心。"
                                },
                                {
                                    "id": "221010115",
                                    "speaker": "淮安",
                                    "text": "那么，就万事拜托了。"
                                }
                            ]
                        },
                        {
                            "id": "221010108",
                            "text": "这家客栈…",
                            "response": [
                                {
                                    "id": "221010110",
                                    "speaker": "淮安",
                                    "text": "在这种地方开客栈，这种问题也免不了。"
                                },
                                {
                                    "id": "221010111",
                                    "speaker": "淮安",
                                    "text": "不过，要是没了我们这家客栈，那野外的行人去哪落脚呢？"
                                },
                                {
                                    "id": "221010112",
                                    "speaker": "淮安",
                                    "text": "虽然累，不过开着也是好事吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210102",
            "objective": "清剿附近的魔物",
            "dialogues": [
                {
                    "id": "221010201",
                    "speaker": "淮安",
                    "text": "怎么样？周围的怪物都清干净了吗？"
                },
                {
                    "id": "221010202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "221010203",
                    "speaker": "淮安",
                    "text": "倒也不用太着急，那些个怪物也顶多敢骚扰骚扰来往进出的人，不敢进客栈来。"
                },
                {
                    "id": "221010204",
                    "speaker": "淮安",
                    "text": "就算是有三五只胆子大的进来了，唔…我倒也能赶出去，客人不用担心。"
                },
                {
                    "id": "221010205",
                    "speaker": "淮安",
                    "text": "哈哈哈，在这郊外开客栈，会点拳脚防防身，也是很正常的嘛。"
                }
            ]
        },
        {
            "id": "2210103",
            "objective": "向淮安回报",
            "dialogues": [
                {
                    "id": "221010301",
                    "speaker": "淮安",
                    "text": "怎么样？周围的怪物都清干净了吗？"
                },
                {
                    "id": "221010302",
                    "speaker": "Player",
                    "text": "已经清干净了。"
                },
                {
                    "id": "221010303",
                    "speaker": "淮安",
                    "text": "那就好，辛苦您了。"
                },
                {
                    "id": "221010304",
                    "speaker": "淮安",
                    "text": "这是报酬，您收好了。"
                },
                {
                    "id": "221010305",
                    "speaker": "淮安",
                    "text": "这年头真是…开个客栈，不会功夫都不行。"
                }
            ]
        }
    ]
}