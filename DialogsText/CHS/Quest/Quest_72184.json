    "talks": [
        {
            "id": "7218401",
            "objective": "与木南杏奈对话",
            "dialogues": []
        },
        {
            "id": "7218402",
            "objective": "与梨绘对话",
            "dialogues": [
                {
                    "id": "721840201",
                    "speaker": "梨绘",
                    "text": "你好呀，有什么事找我吗？"
                },
                {
                    "id": "721840202",
                    "speaker": "Player",
                    "text": "关于「木南料亭」的披萨…"
                },
                {
                    "id": "721840203",
                    "speaker": "梨绘",
                    "text": "哦，你说那个披萨啊，味道确实很不错。"
                },
                {
                    "id": "721840204",
                    "speaker": "梨绘",
                    "text": "但是…怎么说呢，总感觉不太吃得惯呢。"
                },
                {
                    "id": "721840205",
                    "speaker": "梨绘",
                    "text": "我个人是觉得，要是能在那种披萨里融入一些稻妻本地食材的话，比如堇瓜之类的…"
                },
                {
                    "id": "721840206",
                    "speaker": "梨绘",
                    "text": "说不定，这种披萨会更受大家欢迎呢。"
                }
            ]
        },
        {
            "id": "7218403",
            "objective": "向木南杏奈回报",
            "dialogues": [
                {
                    "id": "721840301",
                    "speaker": "木南杏奈",
                    "text": "旅行者，你回来了。"
                },
                {
                    "id": "721840302",
                    "speaker": "木南杏奈",
                    "text": "怎么样，你有问到什么吗？"
                },
                {
                    "id": "721840303",
                    "speaker": "Player",
                    "text": "关于客人们的反馈…"
                },
                {
                    "id": "721840304",
                    "speaker": "木南杏奈",
                    "text": "用堇瓜做的披萨…倒也不会太复杂…"
                },
                {
                    "id": "721840305",
                    "speaker": "木南杏奈",
                    "text": "其余的材料就照常准备好了，唔，既然都说要「融入一些稻妻本地食材」了，那我就再加一点其他的材料好了…"
                },
                {
                    "id": "721840306",
                    "speaker": "木南杏奈",
                    "text": "唔，海灵芝？鸣草？嗯…幽灯蕈怎么样…"
                },
                {
                    "id": "721840307",
                    "speaker": "Player",
                    "text": "那个，要我帮忙吗？"
                },
                {
                    "id": "721840308",
                    "speaker": "木南杏奈",
                    "text": "喔！抱歉，我光顾着想放什么食材好了！我看看，店里的堇瓜好像没多少了…"
                },
                {
                    "id": "721840309",
                    "speaker": "木南杏奈",
                    "text": "旅行者，请你去帮我拿一个堇瓜来吧，材料的话…应该就只差这个了。",
                    "choices": [
                        {
                            "id": "721840310",
                            "text": "交给我了。",
                            "response": [
                                {
                                    "id": "721840311",
                                    "speaker": "木南杏奈",
                                    "text": "嗯，那就拜托你了，只要一个堇瓜就好。"
                                }
                            ]
                        },
                        {
                            "id": "721840312",
                            "text": "还要找其他的食材吗？",
                            "response": [
                                {
                                    "id": "721840313",
                                    "speaker": "木南杏奈",
                                    "text": "其他的食材店里还有些存货，你带一个堇瓜回来就好，拜托你啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7218404",
            "objective": "将堇瓜带回给木南杏奈",
            "dialogues": [
                {
                    "id": "721840401",
                    "speaker": "木南杏奈",
                    "text": "你把食材带回来了吗？"
                }
            ]
        },
        {
            "id": "7218405",
            "objective": "与木南杏奈对话",
            "dialogues": [
                {
                    "id": "721840501",
                    "speaker": "木南杏奈",
                    "text": "谢谢你，有这些食材就够了。"
                },
                {
                    "id": "721840502",
                    "speaker": "木南杏奈",
                    "text": "加入了稻妻本地食材的披萨，不知道做出来会是什么味道…"
                },
                {
                    "id": "721840503",
                    "speaker": "木南杏奈",
                    "text": "完成了！"
                },
                {
                    "id": "721840504",
                    "speaker": "木南杏奈",
                    "text": "这披萨…看上去还不错…"
                },
                {
                    "id": "721840505",
                    "speaker": "木南杏奈",
                    "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。"
                },
                {
                    "id": "721840506",
                    "speaker": "木南杏奈",
                    "text": "我等会就去仔细品尝一下这份披萨的味道…"
                },
                {
                    "id": "721840507",
                    "speaker": "木南杏奈",
                    "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
                }
            ]
        },
        {
            "id": "7218406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721840601",
                    "speaker": "木南杏奈",
                    "text": "唉，也许我真的不太会做「披萨」这种菜吧…"
                }
            ]
        },
        {
            "id": "7218407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721840701",
                    "speaker": "梨绘",
                    "text": "用堇瓜制作的披萨…不知道吃起来味道怎么样…"
                }
            ]
        }
    ]
}