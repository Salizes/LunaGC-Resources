        }
    },
    "talks": [
        {
            "id": "7907501",
            "objective": "",
            "dialogues": [
                {
                    "id": "790750101",
                    "speaker": "帕纽尔",
                    "text": "肖维涅到底在想什么呢？唉，他就是不愿意和我说话。"
                },
                {
                    "id": "790750102",
                    "speaker": "Player",
                    "text": "关于肖维涅…"
                },
                {
                    "id": "790750103",
                    "speaker": "帕纽尔",
                    "text": "您好，两位。很抱歉…肖维涅准是还在生我的气，不肯出来和我说话。"
                },
                {
                    "id": "790750104",
                    "speaker": "帕纽尔",
                    "text": "唉，可是那底下既吹不到风，也照不到太阳，要是他枯萎了可怎么办呀？"
                },
                {
                    "id": "790750105",
                    "speaker": "派蒙",
                    "text": "那个…既然是一盆花的话…"
                },
                {
                    "id": "790750106",
                    "speaker": "Player",
                    "text": "我们可以直接把他捧出来。"
                },
                {
                    "id": "790750107",
                    "speaker": "帕纽尔",
                    "text": "我试过了。但肖维涅一直在生闷气，我根本没办法靠近他…"
                },
                {
                    "id": "790750108",
                    "speaker": "帕纽尔",
                    "text": "他的气太大，我都差点被吹走了！"
                },
                {
                    "id": "790750109",
                    "speaker": "派蒙",
                    "text": "等一下，为什么生气会把人吹跑啊？",
                    "choices": [
                        {
                            "id": "790750110",
                            "text": "这气也太大了。",
                            "response": [
                                {
                                    "id": "790750112",
                                    "speaker": "帕纽尔",
                                    "text": "也许是我之前拒绝和肖维涅一起远行，让他不高兴了…"
                                },
                                {
                                    "id": "790750113",
                                    "speaker": "帕纽尔",
                                    "text": "两位客人，能请你们去看看肖维涅吗？说不定，你们能劝得动他。"
                                },
                                {
                                    "id": "790750114",
                                    "speaker": "Player",
                                    "text": "没问题，我们去试试。"
                                },
                                {
                                    "id": "790750115",
                                    "speaker": "派蒙",
                                    "text": "嗯，我们去过好多地方旅行，也见了好多人，一定…说不定真能劝得动他呢。"
                                },
                                {
                                    "id": "790750116",
                                    "speaker": "帕纽尔",
                                    "text": "那就太好了！肖维涅就在这座岛下面的洞窟里，请你们去那边找他吧。"
                                },
                                {
                                    "id": "790750117",
                                    "speaker": "帕纽尔",
                                    "text": "我…我要打扫打扫这里，给肖维涅找一个最适合晒太阳的地方。"
                                }
                            ]
                        },
                        {
                            "id": "790750111",
                            "text": "确实很不想让人靠近呢…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7907502",
            "objective": "",
            "dialogues": [
                {
                    "id": "790750201",
                    "speaker": "帕纽尔",
                    "text": "我…我要打扫打扫这里，给肖维涅找一个最适合晒太阳的地方。"
                },
                {
                    "id": "790750202",
                    "speaker": "帕纽尔",
                    "text": "说服肖维涅的事就拜托你们了，两位客人。"
                },
                {
                    "id": "790750203",
                    "speaker": "帕纽尔",
                    "text": "要是我去见肖维涅，说不定他又会嫌我唠叨，开始生闷气…"
                }
            ]
        },
        {
            "id": "7907503",
            "objective": "",
            "dialogues": [
                {
                    "id": "790750301",
                    "speaker": "派蒙",
                    "text": "呼…风总算停下来了…",
                    "choices": [
                        {
                            "id": "790750302",
                            "text": "请听我们说。",
                            "response": [
                                {
                                    "id": "790750304",
                                    "speaker": "肖维涅",
                                    "text": "好吧。我会听你们说的。但在那之前…"
                                },
                                {
                                    "id": "790750305",
                                    "speaker": "肖维涅",
                                    "text": "瞧瞧二位震惊的样。想必也是想要问我「为什么一盆花会说话」。"
                                },
                                {
                                    "id": "790750306",
                                    "speaker": "肖维涅",
                                    "text": "或者是，「为什么你会变成一盆花。」"
                                },
                                {
                                    "id": "790750307",
                                    "speaker": "Player",
                                    "text": "有很多人问过你吗？"
                                },
                                {
                                    "id": "790750308",
                                    "speaker": "肖维涅",
                                    "text": "在外面的时候，有很多人这么问。回家了之后…倒是没有人问了。"
                                },
                                {
                                    "id": "790750309",
                                    "speaker": "派蒙",
                                    "text": "你说的「外面」，是指这个世界外吗？"
                                },
                                {
                                    "id": "790750310",
                                    "speaker": "Player",
                                    "text": "我听说，你是远游后才变成这样的。"
                                },
                                {
                                    "id": "790750311",
                                    "speaker": "肖维涅",
                                    "text": "你倒是消息齐全。应该是帕纽尔告诉你的吧？"
                                },
                                {
                                    "id": "790750312",
                                    "speaker": "肖维涅",
                                    "text": "没错。在远游的途中，我变成了这样。呵呵，用罗泽尔那家伙的话说…这就是我自愿做出的「改变」。"
                                },
                                {
                                    "id": "790750313",
                                    "speaker": "派蒙",
                                    "text": "改变倒是能够理解啦。但你为什么要变成一盆花呢？",
                                    "choices": [
                                        {
                                            "id": "790750314",
                                            "text": "该不会是太喜欢植物了吧？",
                                            "response": [
                                                {
                                                    "id": "790750316",
                                                    "speaker": "肖维涅",
                                                    "text": "不是。我只是…想要找到自己的「位置」。"
                                                },
                                                {
                                                    "id": "790750317",
                                                    "speaker": "肖维涅",
                                                    "text": "我在这个世界外，见到了许多人。他们有的是厨师，有的是花匠，有的是教师。"
                                                },
                                                {
                                                    "id": "790750318",
                                                    "speaker": "肖维涅",
                                                    "text": "几乎每个人都找到了一个足以让自己安心的「位置」。如此，才能在生活中立足。"
                                                },
                                                {
                                                    "id": "790750319",
                                                    "speaker": "肖维涅",
                                                    "text": "而我呢？我只擅长远游，也从未想过，要给自己寻找到一个稳定的「位置」。"
                                                },
                                                {
                                                    "id": "790750320",
                                                    "speaker": "Player",
                                                    "text": "这个「花盆」就是你的「位置」。"
                                                },
                                                {
                                                    "id": "790750321",
                                                    "speaker": "肖维涅",
                                                    "text": "没错。你理解得很快。"
                                                },
                                                {
                                                    "id": "790750322",
                                                    "speaker": "肖维涅",
                                                    "text": "做一棵在花盆里的花，就可以让我时刻拥有一个让自己安心的「位置」。"
                                                },
                                                {
                                                    "id": "790750323",
                                                    "speaker": "肖维涅",
                                                    "text": "但是…唉，我既然有了一个盆，也有了属于我的「位置」，那我又为什么要出去远游呢？"
                                                },
                                                {
                                                    "id": "790750324",
                                                    "speaker": "肖维涅",
                                                    "text": "可我又是一个冒险客，没了远游，我又能做什么有价值的事？"
                                                },
                                                {
                                                    "id": "790750325",
                                                    "speaker": "肖维涅",
                                                    "text": "我不明白。越是见识了外面世界的事物，我就越是不明白…「位置」和「远游」，究竟谁更重要？"
                                                },
                                                {
                                                    "id": "790750326",
                                                    "speaker": "肖维涅",
                                                    "text": "我越是思考，就越是头痛…帕纽尔和我聊天时，我也总是答非所问。"
                                                },
                                                {
                                                    "id": "790750327",
                                                    "speaker": "肖维涅",
                                                    "text": "我害怕误导帕纽尔。如果他原本就喜爱远游，看见了我这副模样后，会不会厌弃远游？"
                                                },
                                                {
                                                    "id": "790750328",
                                                    "speaker": "肖维涅",
                                                    "text": "可帕纽尔是我的朋友，永远都是。我得对他诚实，他问我的所有问题， 我都回答了个遍。"
                                                },
                                                {
                                                    "id": "790750329",
                                                    "speaker": "肖维涅",
                                                    "text": "包括…我之所以会成为花，是想要一个能让自己安心的「位置」。"
                                                },
                                                {
                                                    "id": "790750330",
                                                    "speaker": "肖维涅",
                                                    "text": "或许是我的回答让帕纽尔难过了…又或者，是他不喜欢我的这副模样。"
                                                },
                                                {
                                                    "id": "790750331",
                                                    "speaker": "肖维涅",
                                                    "text": "我们逐渐分开，而我这么一盆花，又没办法自己上去。"
                                                },
                                                {
                                                    "id": "790750332",
                                                    "speaker": "肖维涅",
                                                    "text": "但这样也好，帕纽尔想必也不想见我，他肯定在生我的气。"
                                                },
                                                {
                                                    "id": "790750333",
                                                    "speaker": "派蒙",
                                                    "text": "喔…原来是这样。你们两个，都分别认为「对方在生自己的气」。"
                                                },
                                                {
                                                    "id": "790750334",
                                                    "speaker": "Player",
                                                    "text": "所以才不愿意见对方。"
                                                },
                                                {
                                                    "id": "790750335",
                                                    "speaker": "肖维涅",
                                                    "text": "什么？你，你是说，帕纽尔并没有生我的气？",
                                                    "choices": [
                                                        {
                                                            "id": "790750336",
                                                            "text": "你们俩的想法一模一样。",
                                                            "response": [
                                                                {
                                                                    "id": "790750338",
                                                                    "speaker": "Black Screen",
                                                                    "text": "将帕纽尔的想法全部告诉了肖维涅…"
                                                                },
                                                                {
                                                                    "id": "790750339",
                                                                    "speaker": "肖维涅",
                                                                    "text": "天哪，我怎会这么想，我从来不愿见到他难过，哪怕他的嘴角垂下去一点，我的心也是要碎的。"
                                                                },
                                                                {
                                                                    "id": "790750340",
                                                                    "speaker": "肖维涅",
                                                                    "text": "两位客人！请你们将我带上去，求你们，我得快点见到帕纽尔！一分一秒也等不了！"
                                                                },
                                                                {
                                                                    "id": "790750341",
                                                                    "speaker": "Player",
                                                                    "text": "就等你这句话呢，老兄。"
                                                                },
                                                                {
                                                                    "id": "790750342",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嘿嘿，就等你这句话呢。我们出发吧！{NICKNAME}！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "790750337",
                                                            "text": "他倒是以为你生他气了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790750315",
                                            "text": "你梦想成为一个植物学家？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790750303",
                            "text": "帕纽尔有话对你说。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7907504",
            "objective": "",
            "dialogues": [
                {
                    "id": "790750401",
                    "speaker": "帕纽尔",
                    "text": "肖维涅！你…你来了。听我说，我从来没有对你生过气，也不想离开你。"
                },
                {
                    "id": "790750402",
                    "speaker": "帕纽尔",
                    "text": "我只是担心，你不愿和我继续做朋友…有些冒险客会改变，我担心你也会一样。"
                },
                {
                    "id": "790750403",
                    "speaker": "帕纽尔",
                    "text": "我向女神许过愿，但是…但是我没找到好礼物，她准是没有搭理我…"
                },
                {
                    "id": "790750404",
                    "speaker": "肖维涅",
                    "text": "不！帕纽尔，只有这件事绝不会发生。我永远都会是你的朋友。"
                },
                {
                    "id": "790750405",
                    "speaker": "肖维涅",
                    "text": "我要向你道歉。是我光想着自己的心思，却忘了听你所说的话。"
                },
                {
                    "id": "790750406",
                    "speaker": "肖维涅",
                    "text": "我以为…我以为你不想再看见我这副模样。"
                },
                {
                    "id": "790750407",
                    "speaker": "Player",
                    "text": "那现在误会总算解开了。"
                },
                {
                    "id": "790750408",
                    "speaker": "派蒙",
                    "text": "对呀。我还以为你们有超大的心结，超级生气，根本不想搭理对方呢。",
                    "choices": [
                        {
                            "id": "790750409",
                            "text": "虽然这样的心结也不小…",
                            "response": [
                                {
                                    "id": "790750411",
                                    "speaker": "肖维涅",
                                    "text": "谢谢你们，两位客人。要是没有你们，我准还窝着不愿出来呢。"
                                },
                                {
                                    "id": "790750412",
                                    "speaker": "肖维涅",
                                    "text": "现在，我总算能把我的心里话告诉帕纽尔了。"
                                },
                                {
                                    "id": "790750413",
                                    "speaker": "帕纽尔",
                                    "text": "我时刻都愿意听你说话，肖维涅。无论是远游，还是花盆…什么都行。"
                                },
                                {
                                    "id": "790750414",
                                    "speaker": "帕纽尔",
                                    "text": "对了，两位客人。这些东西还请你们收下吧，这都是我特意搜集的。"
                                },
                                {
                                    "id": "790750415",
                                    "speaker": "帕纽尔",
                                    "text": "愿女神保佑你们，永远不和自己的朋友吵架，永远有人愿意听你们说心里话。"
                                }
                            ]
                        },
                        {
                            "id": "790750410",
                            "text": "但能够解开心结就好。"
                        }
                    ]
                }
            ]
        }
    ]
}