        {
            "id": "7280902",
            "objective": "(test)从居民区地道进入$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7280903",
            "objective": "调查奇怪的营地",
            "dialogues": []
        },
        {
            "id": "7280904",
            "objective": "在营地旁躲藏",
            "dialogues": []
        },
        {
            "id": "7280905",
            "objective": "观察哈里森",
            "dialogues": [
                {
                    "id": "728090108",
                    "speaker": "哈里森",
                    "text": "这些东西总算是送到了…"
                },
                {
                    "id": "728090109",
                    "speaker": "哈里森",
                    "text": "拖了这么长时间，真是…"
                },
                {
                    "id": "728090110",
                    "speaker": "哈里森",
                    "text": "这箱怎么还破了个角，哎哟！"
                },
                {
                    "id": "728090111",
                    "speaker": "哈里森",
                    "text": "叫他小心点！不会把里面的东西给碰碎了吧…"
                },
                {
                    "id": "728090112",
                    "speaker": "哈里森",
                    "text": "还好，没有瓶子碰碎…"
                },
                {
                    "id": "728090113",
                    "speaker": "哈里森",
                    "text": "咦？这瓶的盖子怎么松了…得先拧下来，再装上去才行…"
                },
                {
                    "id": "728090114",
                    "speaker": "哈里森",
                    "text": "咳！咳…这调酒材料的味道可真是…太激烈了，还是快点搬走…"
                },
                {
                    "id": "728090115",
                    "speaker": "哈里森",
                    "text": "欸，什么，怎么这么多史莱姆？！"
                }
            ]
        },
        {
            "id": "7280906",
            "objective": "打倒所有史莱姆",
            "dialogues": []
        },
        {
            "id": "7280907",
            "objective": "与哈里森对话",
            "dialogues": [
                {
                    "id": "728090204",
                    "speaker": "哈里森",
                    "text": "谢谢，谢谢，太谢谢你了，旅行者…"
                },
                {
                    "id": "728090205",
                    "speaker": "哈里森",
                    "text": "要是没你帮忙，我今天非折在这里不可。",
                    "choices": [
                        {
                            "id": "728090206",
                            "text": "这营地是你建的？",
                            "response": [
                                {
                                    "id": "728090207",
                                    "speaker": "哈里森",
                                    "text": "呃…算是吧。"
                                },
                                {
                                    "id": "728090210",
                                    "speaker": "哈里森",
                                    "text": "你们也知道，在离岛做生意可不容易，这个营地…算是我做生意的一点小诀窍。"
                                },
                                {
                                    "id": "728090211",
                                    "speaker": "哈里森",
                                    "text": "前些日子，我托一位…朋友，从蒙德那边给我带一批酿酒材料过来。"
                                },
                                {
                                    "id": "728090212",
                                    "speaker": "哈里森",
                                    "text": "他前不久拜托一个朋友从「晨曦酒庄」那里拿到了一批试做的新货，这几天刚运过来。"
                                },
                                {
                                    "id": "728090213",
                                    "speaker": "哈里森",
                                    "text": "可是那家伙手脚没轻没重，把箱子碰坏了，里面装着的一瓶酿酒材料的盖子也松了。"
                                },
                                {
                                    "id": "728090214",
                                    "speaker": "哈里森",
                                    "text": "我就想去把盖子先拧下来，然后再重新装上去。"
                                },
                                {
                                    "id": "728090215",
                                    "speaker": "哈里森",
                                    "text": "没想到，我刚拧开盖子，一堆史莱姆就冲了过来，真是莫名其妙…"
                                },
                                {
                                    "id": "728090216",
                                    "speaker": "Player",
                                    "text": "「晨曦酒庄」的酿酒材料吗…"
                                },
                                {
                                    "id": "728090217",
                                    "speaker": "哈里森",
                                    "text": "算了，先不管了，酿酒材料的事，等那家伙下次过来的时候，我再和他算账。"
                                },
                                {
                                    "id": "728090218",
                                    "speaker": "哈里森",
                                    "text": "你们救了我，我得给你们点谢礼才行…这些东西你们先收下。"
                                },
                                {
                                    "id": "728090219",
                                    "speaker": "哈里森",
                                    "text": "除了这些之外，你们看见旁边的那艘小船了吗？那是我的另外一个…小诀窍。"
                                },
                                {
                                    "id": "728090220",
                                    "speaker": "哈里森",
                                    "text": "用那艘船，你们就可以从这里悄悄地前往鸣神岛了，嘿嘿，是不是非常方便？"
                                },
                                {
                                    "id": "728090221",
                                    "speaker": "Player",
                                    "text": "我为什么要「悄悄的」…"
                                },
                                {
                                    "id": "728090222",
                                    "speaker": "哈里森",
                                    "text": "哎呀，总之…以备不时之需嘛。"
                                },
                                {
                                    "id": "728090223",
                                    "speaker": "哈里森",
                                    "text": "好了，我还得回去清点货物，就先不在这里多待了，再次谢谢你了，旅行者。"
                                },
                                {
                                    "id": "728090224",
                                    "speaker": "哈里森",
                                    "text": "看来我得再换个接货的地方了…"
                                }
                            ]
                        },
                        {
                            "id": "728090208",
                            "text": "你在这做什么？",
                            "response": [
                                {
                                    "id": "728090209",
                                    "speaker": "哈里森",
                                    "text": "我…在这搬货呢，哈哈哈，搬货呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}