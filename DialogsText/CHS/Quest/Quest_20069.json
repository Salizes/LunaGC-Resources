        {
            "id": "2006904",
            "objective": "在山洞附近放置包裹",
            "dialogues": [
                {
                    "id": "200690401",
                    "speaker": "芙萝拉",
                    "text": "花怎么样啦？"
                },
                {
                    "id": "200690402",
                    "speaker": "Player",
                    "text": "对不起…"
                },
                {
                    "id": "200690403",
                    "speaker": "芙萝拉",
                    "text": "嗯？怎么了？"
                },
                {
                    "id": "200690404",
                    "speaker": "Player",
                    "text": "我不小心把盒子和花弄坏了…"
                },
                {
                    "id": "200690405",
                    "speaker": "芙萝拉",
                    "text": "弄、弄坏了？！"
                },
                {
                    "id": "200690406",
                    "speaker": "芙萝拉",
                    "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…"
                },
                {
                    "id": "200690407",
                    "speaker": "芙萝拉",
                    "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…"
                },
                {
                    "id": "200690408",
                    "speaker": "芙萝拉",
                    "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。"
                },
                {
                    "id": "200690409",
                    "speaker": "芙萝拉",
                    "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
                }
            ]
        },
