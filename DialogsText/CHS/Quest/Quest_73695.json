    "talks": [
        {
            "id": "7369501",
            "objective": "与丹纳对话",
            "dialogues": []
        },
        {
            "id": "7369502",
            "objective": "与丹纳对话",
            "dialogues": [
                {
                    "id": "736950201",
                    "speaker": "丹纳",
                    "text": "喔？你已经把所有「文物模型」都找到了吗？"
                },
                {
                    "id": "736950202",
                    "speaker": "丹纳",
                    "text": "了不起！你很有考古方面的天赋嘛。"
                },
                {
                    "id": "736950203",
                    "speaker": "丹纳",
                    "text": "那么，这份礼物就送给你了，感谢你来参加我们学院举办的活动。"
                },
                {
                    "id": "736950204",
                    "speaker": "丹纳",
                    "text": "希望你从这次的活动里感受到了一些考古的乐趣啊，旅行者。"
                },
                {
                    "id": "736950205",
                    "speaker": "丹纳",
                    "text": "虽然在真实的考古工作里，大部分时候都枯燥乏味又辛苦…"
                },
                {
                    "id": "736950206",
                    "speaker": "丹纳",
                    "text": "但在挖掘到关键性文物的那一刹那，又会感觉到一切的辛苦都是值得的。",
                    "choices": [
                        {
                            "id": "736950207",
                            "text": "那要是没挖出来呢？",
                            "response": [
                                {
                                    "id": "736950209",
                                    "speaker": "丹纳",
                                    "text": "没挖出来的话…那就和俗话说的一样，这一趟「白忙活」了。"
                                },
                                {
                                    "id": "736950210",
                                    "speaker": "丹纳",
                                    "text": "而且这种白忙活的情况才是常态，能顺利挖到关键性文物的次数少之又少。"
                                },
                                {
                                    "id": "736950211",
                                    "speaker": "丹纳",
                                    "text": "不过做考古工作嘛，就是要习惯这种情况，时刻保持着乐观的心态，不然工作不了多长时间，就要撑不住喽。"
                                }
                            ]
                        },
                        {
                            "id": "736950208",
                            "text": "也有没挖出来的情况吧。"
                        }
                    ]
                }
            ]
        }
    ]
}