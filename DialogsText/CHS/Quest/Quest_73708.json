    "talks": [
        {
            "id": "7370801",
            "objective": "前往拜达港",
            "dialogues": [
                {
                    "id": "737080101",
                    "speaker": "派蒙",
                    "text": "咦，那边有只蕈兽飘过去了欸，没问题吗？"
                },
                {
                    "id": "737080102",
                    "speaker": "派蒙",
                    "text": "一般来说，蕈兽在城区活动，还是有点危险的吧！除非是特别听话，受过训练的特例…"
                },
                {
                    "id": "737080103",
                    "speaker": "派蒙",
                    "text": "不对呀，怎么好像有点熟悉，以前我们是不是经历过类似的情景。",
                    "choices": [
                        {
                            "id": "737080104",
                            "text": "等等，是「咚咚小圆帽」吗？",
                            "response": [
                                {
                                    "id": "737080105",
                                    "speaker": "派蒙",
                                    "text": "对！「咚咚小圆帽」！我们在须弥结识的蕈兽伙伴！"
                                },
                                {
                                    "id": "737080106",
                                    "speaker": "派蒙",
                                    "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
                                }
                            ]
                        },
                        {
                            "id": "737080107",
                            "text": "是什么特例来着？",
                            "response": [
                                {
                                    "id": "737080108",
                                    "speaker": "派蒙",
                                    "text": "好像是…「咚咚小圆帽」？我们在须弥结识的蕈兽伙伴！"
                                },
                                {
                                    "id": "737080109",
                                    "speaker": "派蒙",
                                    "text": "呜啊啊啊啊啊，上次见面都好久好久了！我们快过去看看吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7370802",
            "objective": "与海妮耶对话",
            "dialogues": [
                {
                    "id": "737080201",
                    "speaker": "海妮耶",
                    "text": "看来留言转达得很顺利。"
                },
                {
                    "id": "737080202",
                    "speaker": "海妮耶",
                    "text": "终于又见面了，「黄金流星」和「白银伴星」。"
                },
                {
                    "id": "737080203",
                    "speaker": "海妮耶",
                    "text": "你们容光焕发的模样，让我有种时间停滞的美好感觉。",
                    "choices": [
                        {
                            "id": "737080204",
                            "text": "久违了，海妮耶！",
                            "response": [
                                {
                                    "id": "737080205",
                                    "speaker": "派蒙",
                                    "text": "真的是你们啊，海妮耶和「咚咚小圆帽」！"
                                },
                                {
                                    "id": "737080206",
                                    "speaker": "派蒙",
                                    "text": "难怪看过留言，我就有种奇妙的熟悉感…说明我和「咚咚小圆帽」的默契还在！"
                                },
                                {
                                    "id": "737080207",
                                    "speaker": "咚咚小圆帽",
                                    "text": "♪~"
                                },
                                {
                                    "id": "737080212",
                                    "speaker": "海妮耶",
                                    "text": "我设想过许多重逢的情景，比如举办丰盛的宴会，或是富有创意的欢迎仪式，给你们个巨大的惊喜。"
                                },
                                {
                                    "id": "737080213",
                                    "speaker": "海妮耶",
                                    "text": "但感觉都有些见外，考虑到你们一直很忙，说不定占用太长时间，反而会让你们觉得麻烦。"
                                },
                                {
                                    "id": "737080214",
                                    "speaker": "海妮耶",
                                    "text": "而且，现在的蕈兽伙伴们也喜欢宁静的环境，所以，就让我们以松弛自然的方式重逢吧。"
                                },
                                {
                                    "id": "737080215",
                                    "speaker": "左右加",
                                    "text": "没错没错，海妮耶读的散文派上用场啦，平静的心态对生活有益！"
                                },
                                {
                                    "id": "737080216",
                                    "speaker": "左右加",
                                    "text": "还是像这样，轻轻松松聊天最开心。"
                                },
                                {
                                    "id": "737080217",
                                    "speaker": "欢腾之火",
                                    "text": "♫~"
                                },
                                {
                                    "id": "737080218",
                                    "speaker": "派蒙",
                                    "text": "左右加小姐也在，还有「欢腾之火」和…这位是？"
                                },
                                {
                                    "id": "737080219",
                                    "speaker": "左右加",
                                    "text": "是我自己的蕈兽伙伴「信风舞姬」哦，当时在三十二强赛上，被你们和「咚咚小圆帽」一下就打败了！"
                                },
                                {
                                    "id": "737080220",
                                    "speaker": "派蒙",
                                    "text": "哎呀，还是你记得清楚！",
                                    "choices": [
                                        {
                                            "id": "737080221",
                                            "text": "熟悉的感觉逐渐回来了…",
                                            "response": [
                                                {
                                                    "id": "737080223",
                                                    "speaker": "左右加",
                                                    "text": "总之，两位大老板，就像你看到的这样，我们再也不用约定什么下次见面的时间和地点啦——"
                                                },
                                                {
                                                    "id": "737080224",
                                                    "speaker": "左右加",
                                                    "text": "海妮耶和我已经买下了这片商区，将它改造成一直开设的「小小灵蕈乐园」！"
                                                },
                                                {
                                                    "id": "737080225",
                                                    "speaker": "派蒙",
                                                    "text": "等等，你的意思是，现在这里的设施，不是为了新的桌上游戏租用的，而是…"
                                                },
                                                {
                                                    "id": "737080226",
                                                    "speaker": "海妮耶",
                                                    "text": "没错，以后我们就会一直生活在拜达港，向人们推广蕈兽的桌上游戏，以及和动物们交流的理论。"
                                                },
                                                {
                                                    "id": "737080227",
                                                    "speaker": "海妮耶",
                                                    "text": "只要你们有空，随时可以来这里找蕈兽伙伴们玩。"
                                                },
                                                {
                                                    "id": "737080228",
                                                    "speaker": "咚咚小圆帽",
                                                    "text": "♪~",
                                                    "choices": [
                                                        {
                                                            "id": "737080229",
                                                            "text": "好耶！蕈兽伙伴！",
                                                            "response": [
                                                                {
                                                                    "id": "737080231",
                                                                    "speaker": "派蒙",
                                                                    "text": "这这这，这是我今天听过最好的消息之一！"
                                                                },
                                                                {
                                                                    "id": "737080232",
                                                                    "speaker": "派蒙",
                                                                    "text": "第一次蕈兽大赛后，我就想过好多好多…和「咚咚小圆帽」一起玩的点子，这下可以慢慢做到啦！"
                                                                },
                                                                {
                                                                    "id": "737080233",
                                                                    "speaker": "Player",
                                                                    "text": "说起来，这里的花销不低吧？"
                                                                },
                                                                {
                                                                    "id": "737080234",
                                                                    "speaker": "左右加",
                                                                    "text": "放心啦，摩拉目前不是问题！"
                                                                },
                                                                {
                                                                    "id": "737080235",
                                                                    "speaker": "海妮耶",
                                                                    "text": "这段时间，除了在贝尔福先生的帮助下运营「灵蕈棋阵」和「小小灵蕈大幻戏」这款桌上游戏，挣取资金…"
                                                                },
                                                                {
                                                                    "id": "737080236",
                                                                    "speaker": "海妮耶",
                                                                    "text": "我们还总结了以往的经验，将驯兽和蕈兽的许多知识总结成系统的理论，试着刊印了一些书籍。"
                                                                },
                                                                {
                                                                    "id": "737080237",
                                                                    "speaker": "海妮耶",
                                                                    "text": "甚至，有些学者也因此给了我资金资助。"
                                                                },
                                                                {
                                                                    "id": "737080238",
                                                                    "speaker": "海妮耶",
                                                                    "text": "用我积累的学问为更多人提供便捷，换取摩拉，让蕈兽伙伴们过得更好，一切都进入了正向的循环。"
                                                                },
                                                                {
                                                                    "id": "737080239",
                                                                    "speaker": "派蒙",
                                                                    "text": "有，有点厉害！"
                                                                },
                                                                {
                                                                    "id": "737080240",
                                                                    "speaker": "派蒙",
                                                                    "text": "感觉海妮耶已经变成了稳重的…「驯兽理论专家」，能把一切问题统统搞定！"
                                                                },
                                                                {
                                                                    "id": "737080241",
                                                                    "speaker": "海妮耶",
                                                                    "text": "多亏左右加引导得好，她让我按学生们的方法，挑战了自己应该学会的技能。"
                                                                },
                                                                {
                                                                    "id": "737080242",
                                                                    "speaker": "左右加",
                                                                    "text": "喂喂！这种谦虚倒是别学啊，我可不是什么超级老师，夸你就好好接着！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737080243",
                                                                            "text": "说得轻松，其实有过困难吧？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737080245",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "确实也遇上过许多难题，但过去的、不好的事情，就让它们随时间走远吧。"
                                                                                },
                                                                                {
                                                                                    "id": "737080246",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "我最大的遗憾是——这一年来，没怎么带蕈兽伙伴们好好在外游玩，"
                                                                                },
                                                                                {
                                                                                    "id": "737080247",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "从我开始归纳自己的驯兽理论开始，大多时间，我们都在洞窟和树屋里，过着昼夜混乱的写稿生活。"
                                                                                },
                                                                                {
                                                                                    "id": "737080248",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "商务生活太累人，赶稿的日子也真是难熬，我更理解左右加的一些想法了。"
                                                                                },
                                                                                {
                                                                                    "id": "737080249",
                                                                                    "speaker": "左右加",
                                                                                    "text": "倒也不全是负面反馈嘛！写完稿子的一瞬间，还是非常有满足感的！"
                                                                                },
                                                                                {
                                                                                    "id": "737080250",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "嗯，我同意，每次完稿都值得吃一顿放纵餐来庆祝。"
                                                                                },
                                                                                {
                                                                                    "id": "737080251",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "可是，蕈兽伙伴们也享受不了我们的食物，或许在它们看来，生活变得越来越枯燥了。"
                                                                                },
                                                                                {
                                                                                    "id": "737080252",
                                                                                    "speaker": "海妮耶",
                                                                                    "text": "长期如此，伙伴们的精神状况也会变差，很不妙。"
                                                                                },
                                                                                {
                                                                                    "id": "737080253",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那，既然现在你们的状况稳定下来了，也有了固定的住所…"
                                                                                },
                                                                                {
                                                                                    "id": "737080254",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "其实可以由我们两个带着蕈兽伙伴们出去玩玩，玩到尽兴就送它们回来。"
                                                                                },
                                                                                {
                                                                                    "id": "737080255",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这样，你们就可以忙手头的工作，蕈兽伙伴们也能好好玩乐！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "737080256",
                                                                                            "text": "派蒙这个主意好！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "737080258",
                                                                                                    "speaker": "左右加",
                                                                                                    "text": "我支持！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "737080259",
                                                                                                    "speaker": "左右加",
                                                                                                    "text": "谈到赏玩的地点，我是纯粹的理论派，只能从书上找去处。第一次到枫丹的时候，其实还闹过迷路的笑话…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "737080260",
                                                                                                    "speaker": "左右加",
                                                                                                    "text": "海妮耶更是个呆瓜，连须弥有哪些好玩的地方都不知道，以前光顾着工作去了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "737080261",
                                                                                                    "speaker": "左右加",
                                                                                                    "text": "上次在枫丹待了那么久，行程规划也不到位，最后连想去的甜品店都没去成，错过了好奇好久的马卡龙…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "737080262",
                                                                                                    "speaker": "海妮耶",
                                                                                                    "text": "咳咳…换成「黄金流星」和「白银伴星」的话，肯定可以找到各种好地方，让蕈兽伙伴们大开眼界，畅玩一番。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "737080263",
                                                                                                            "text": "那我确实要好好物色地点！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "737080265",
                                                                                                                    "speaker": "海妮耶",
                                                                                                                    "text": "稍等啊，请带上这个小留影机…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080266",
                                                                                                                    "speaker": "Black Screen",
                                                                                                                    "text": "海妮耶取出一部平平无奇的留影机，将其放在了「咚咚小圆帽」的头上，「咚咚小圆帽」居然能稳稳顶着留影机，似乎已经习惯了托举这种东西飞行…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080267",
                                                                                                                    "speaker": "海妮耶",
                                                                                                                    "text": "虽然外观很普通，但这是一件特别的纪念品——"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080268",
                                                                                                                    "speaker": "海妮耶",
                                                                                                                    "text": "「咚咚小圆帽」曾在水天丛林南部救下一位迷路商人的孩子，商人送了「咚咚小圆帽」许多谢礼，其中一件就是这部留影机。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080269",
                                                                                                                    "speaker": "海妮耶",
                                                                                                                    "text": "「咚咚小圆帽」很喜欢这个留影机拍摄的画片，这次去玩时，也可以用它来留念。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080270",
                                                                                                                    "speaker": "海妮耶",
                                                                                                                    "text": "我找到了器材专家伊莲小姐，密封了留影机的外壳，使得它能在「咚咚小圆帽」喜欢的潮湿环境…甚至是水下工作。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "737080271",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "也就是说，这个留影机也是「咚咚小圆帽」的荣誉象征之一了！",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "737080272",
                                                                                                                            "text": "咚咚小圆帽，棒！",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "737080274",
                                                                                                                                    "speaker": "咚咚小圆帽",
                                                                                                                                    "text": "♪~"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080275",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "#至于留影的问题，放心放心，我和{NICKNAME}也是专家！设备的外观不要紧，拍得好就行！"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080276",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "#{NICKNAME}，我们准备准备，然后就出发吧？"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080277",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "除了行李，还有蕈兽伙伴们特别的食物…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080278",
                                                                                                                                    "speaker": "海妮耶",
                                                                                                                                    "text": "没错，这一点派蒙也记得很清楚，请带上足够的「妙妙琼脂」。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080279",
                                                                                                                                    "speaker": "海妮耶",
                                                                                                                                    "text": "最新改良版的版本有着更美味的口感，还很耐储存，无论在多炎热的环境下，都不用担心变质。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080280",
                                                                                                                                    "speaker": "左右加",
                                                                                                                                    "text": "小心，不要一次给伙伴们吃太多哦，暴饮暴食可不好！"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080281",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "嘿嘿，都记住啦，琼脂要收进小背包…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "737080282",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "就等我们开开心心带着游玩的纪念品回来吧！"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "737080273",
                                                                                                                            "text": "干得漂亮，小圆帽！"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "737080264",
                                                                                                            "text": "我会选出好玩又好看的地方！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "737080257",
                                                                                            "text": "我也想带蕈兽伙伴去玩！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737080244",
                                                                            "text": "感觉略过了很多吃苦的部分…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737080230",
                                                            "text": "以后可以经常见面啦！"
                                                        }
                                                    ]
