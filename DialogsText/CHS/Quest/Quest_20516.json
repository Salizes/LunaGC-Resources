        }
    },
    "talks": [
        {
            "id": "2051601",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205160101",
                    "speaker": "安东尼",
                    "text": "这丫头，又跑到哪去了…"
                },
                {
                    "id": "205160102",
                    "speaker": "Player",
                    "text": "安娜又出去玩了？"
                },
                {
                    "id": "205160103",
                    "speaker": "安东尼",
                    "text": "我说啊，你怎么一副习以为常的表情。"
                },
                {
                    "id": "205160104",
                    "speaker": "安东尼",
                    "text": "安娜是越来越不听话了，我一个不留神，她又溜出去了。"
                },
                {
                    "id": "205160105",
                    "speaker": "安东尼",
                    "text": "她的病还没有好全呢，你快点帮我找找安娜吧。",
                    "choices": [
                        {
                            "id": "205160106",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "205160107",
                                    "speaker": "安东尼",
                                    "text": "那就拜托你了。"
                                },
                                {
                                    "id": "205160115",
                                    "speaker": "安东尼",
                                    "text": "对了，之前安娜一直和我说，想要去看看风神像。"
                                },
                                {
                                    "id": "205160116",
                                    "speaker": "安东尼",
                                    "text": "我记得，葛瑞丝修女经常呆在那。"
                                },
                                {
                                    "id": "205160117",
                                    "speaker": "安东尼",
                                    "text": "你可以先去问问她，说不定她会注意到什么…"
                                }
                            ]
                        },
                        {
                            "id": "205160108",
                            "text": "你找过了吗？",
                            "response": [
                                {
                                    "id": "205160109",
                                    "speaker": "安东尼",
                                    "text": "我当然找过了，连城外都去过了。"
                                },
                                {
                                    "id": "205160110",
                                    "speaker": "安东尼",
                                    "text": "就是找不到，才只能拜托你啊。"
                                }
                            ]
                        },
                        {
                            "id": "205160111",
                            "text": "安娜喜欢吃什么？",
                            "response": [
                                {
                                    "id": "205160112",
                                    "speaker": "安东尼",
                                    "text": "哦，她喜欢吃…喂！都说了不要把我妹妹当成猫！"
                                },
                                {
                                    "id": "205160113",
                                    "speaker": "安东尼",
                                    "text": "再说了，她喜欢吃的东西多了去了，我数得过来吗？"
                                },
                                {
                                    "id": "205160114",
                                    "speaker": "安东尼",
                                    "text": "好了，拜托你快去找找吧，我就在这等你。找了一圈，我都快累死了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051602",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205160201",
                    "speaker": "安娜",
                    "text": "原来从这里可以看到整个蒙德城…"
                },
                {
                    "id": "205160202",
                    "speaker": "Player",
                    "text": "别着凉了。"
                },
                {
                    "id": "205160203",
                    "speaker": "安娜",
                    "text": "哇！吓我一跳，你是从哪冒出来的？"
                },
                {
                    "id": "205160204",
                    "speaker": "安娜",
                    "text": "准是哥哥又在找我了吧，哼哼，这地方他果然找不到。"
                },
                {
                    "id": "205160205",
                    "speaker": "安娜",
                    "text": "好啦，好啦，我知道了，等会我就会回去啦。不会让哥哥担心的。"
                }
            ]
        },
        {
            "id": "2051603",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205160301",
                    "speaker": "安东尼",
                    "text": "你找到安娜了吗？"
                },
                {
                    "id": "205160302",
                    "speaker": "Player",
                    "text": "在风神像的手上呢。"
                },
                {
                    "id": "205160303",
                    "speaker": "安东尼",
                    "text": "风，风神像的手上？！她到底是怎么爬上去的…"
                },
                {
                    "id": "205160304",
                    "speaker": "安东尼",
                    "text": "我马上去那边，把她给叫下来好好教训一下。"
                },
                {
                    "id": "205160305",
                    "speaker": "安东尼",
                    "text": "辛苦你了，这些就收下吧。"
                }
            ]
        },
        {
            "id": "2051604",
            "objective": "与葛瑞丝对话$HIDDEN",
            "dialogues": [
                {
                    "id": "205160401",
                    "speaker": "葛瑞丝",
                    "text": "这孩子，不是一直在生病吗？怎么…"
                },
                {
                    "id": "205160402",
                    "speaker": "Player",
                    "text": "请问您看见过一个女孩…"
                },
                {
                    "id": "205160403",
                    "speaker": "葛瑞丝",
                    "text": "呼…您是在找安娜吧，您往上看，她就在风神像的手上呢。"
                },
                {
                    "id": "205160404",
                    "speaker": "葛瑞丝",
                    "text": "她跑过来的时候，我还在奇怪，这孩子不还是在生病吗？怎么突然这么有活力。"
                },
                {
                    "id": "205160405",
                    "speaker": "葛瑞丝",
                    "text": "我就是一个愣神，这孩子就爬到风神像手上去了。"
                },
                {
                    "id": "205160406",
                    "speaker": "Player",
                    "text": "您…为什么不生气？"
                },
                {
                    "id": "205160407",
                    "speaker": "葛瑞丝",
                    "text": "生气？啊…当然是有一些的，不过，那孩子之前一直被病痛折磨…"
                },
                {
                    "id": "205160408",
                    "speaker": "葛瑞丝",
                    "text": "现在看见她这么健康的样子，怎么说呢，我反而生气不起来了。"
                },
                {
                    "id": "205160409",
                    "speaker": "葛瑞丝",
                    "text": "不过，上面风很大，这孩子别着凉了…"
                }
            ]
        },
        {
            "id": "2051605",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205160501",
                    "speaker": "安娜",
                    "text": "原来从这里可以看到整个蒙德城…"
                },
                {
                    "id": "205160502",
                    "speaker": "Player",
                    "text": "别着凉了。"
                },
                {
                    "id": "205160503",
                    "speaker": "安娜",
                    "text": "哇！吓我一跳，你是从哪冒出来的，怎么找到我的？"
                },
                {
                    "id": "205160504",
                    "speaker": "安娜",
                    "text": "我还以为，没人能找到这个地方呢…"
                },
                {
                    "id": "205160505",
                    "speaker": "安娜",
                    "text": "啊，对了，一定是葛瑞丝修女告诉你的吧，她一直在这附近。"
                },
                {
                    "id": "205160506",
                    "speaker": "安娜",
                    "text": "之前我吃的药，也有很多是她送过来的。"
                },
                {
                    "id": "205160507",
                    "speaker": "安娜",
                    "text": "葛瑞丝修女真是个好人哪，不过我可不想一直呆在蒙德城…"
                },
                {
                    "id": "205160508",
                    "speaker": "安娜",
                    "text": "好啦，我知道哥哥在找我，等会我就会回去啦。不会让哥哥担心的。"
                }
            ]
        },
        {
