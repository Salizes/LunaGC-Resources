            "dialogues": [
                {
                    "id": "711510802",
                    "speaker": "莱欧斯利",
                    "text": "我瞧瞧，不错，拍得挺标准的，只看脖子以上的话，都能拿来当登记照了。"
                },
                {
                    "id": "711510803",
                    "speaker": "莱欧斯利",
                    "text": "#画片我就收下了，多谢你帮忙了啊，{NICKNAME}。",
                    "choices": [
                        {
                            "id": "711510801",
                            "text": "关于我刚放的霄灯…",
                            "response": [
                                {
                                    "id": "711510804",
                                    "speaker": "莱欧斯利",
                                    "text": "不错啊，你放的这盏灯又高又亮，弄得我都想买几盏带回梅洛彼得堡了。"
                                },
                                {
                                    "id": "711510805",
                                    "speaker": "莱欧斯利",
                                    "text": "还是算了，在梅洛彼得堡里放的霄灯，既飞不上天，也实现不了什么心愿，只会白白增加清洁成本。"
                                }
                            ]
                        },
                        {
                            "id": "711510806",
                            "text": "再见，海灯节快乐。",
                            "response": [
                                {
                                    "id": "711510807",
                                    "speaker": "莱欧斯利",
                                    "text": "喔，也祝你节日快乐。等会我还要去买点礼物，呃…除了茶之外的礼物。"
