    "talks": [
        {
            "id": "7215401",
            "objective": "（test）和泽维尔对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721540101",
                    "speaker": "泽维尔",
                    "text": "等等！士兵先生，您刚才念的词情绪不太对。"
                },
                {
                    "id": "721540102",
                    "speaker": "泽维尔",
                    "text": "「武士，如同席卷大地的清风。」"
                },
                {
                    "id": "721540103",
                    "speaker": "泽维尔",
                    "text": "你还记得我之前和你讲的戏吧，要有一种洒脱感，沧桑感，洒脱，洒脱明白吗？"
                },
                {
                    "id": "721540104",
                    "speaker": "泽维尔",
                    "text": "这句话是整部戏的关键，您一定要完整地，饱满地，完美地把情绪表达出来！"
                },
                {
                    "id": "721540105",
                    "speaker": "虎之助",
                    "text": "唔…"
                },
                {
                    "id": "721540106",
                    "speaker": "泽维尔",
                    "text": "而且挥剑的时候，不要那么快，一定要保证自己在镜头里面，不然「映影机」都要拍不到了。"
                },
                {
                    "id": "721540107",
                    "speaker": "泽维尔",
                    "text": "先摆出架势，然后停顿，明白吗？停顿一下，然后猛地斩下去。"
                },
                {
                    "id": "721540108",
                    "speaker": "虎之助",
                    "text": "但与人对决的时候，可不能这么挥剑…"
                },
                {
                    "id": "721540109",
                    "speaker": "泽维尔",
                    "text": "这不是剧情和制作需要嘛…"
                },
                {
                    "id": "721540110",
                    "speaker": "泽维尔",
                    "text": "再准备准备，我们再来一次…",
                    "choices": [
                        {
                            "id": "721540111",
                            "text": "你们在干什么呢？",
                            "response": [
                                {
                                    "id": "721540114",
                                    "speaker": "泽维尔",
                                    "text": "#哎哟，是您呐！我亲爱的好{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，准是一阵好风送您过来的。"
                                },
                                {
                                    "id": "721540115",
                                    "speaker": "泽维尔",
                                    "text": "如您所见，我正在和这位士兵先生拍摄一部「剑阵映影」，名字叫做《第七个武士》。"
                                },
                                {
                                    "id": "721540116",
                                    "speaker": "泽维尔",
                                    "text": "哦，「剑阵映影」是我为这一类的「映影」取的总称。"
                                },
                                {
                                    "id": "721540117",
                                    "speaker": "泽维尔",
                                    "text": "记录着刀剑搏击的画面，让观看者感觉自己如同在剑阵之中穿梭一般的「映影」…差不多就是这个意思。",
                                    "choices": [
                                        {
                                            "id": "721540118",
                                            "text": "虎之助先生居然有空…",
                                            "response": [
                                                {
                                                    "id": "721540119",
                                                    "speaker": "虎之助",
                                                    "text": "这也是上面的大人们准许过的行为，据大人说，这也有助于为幕府武士扬威。"
                                                },
                                                {
                                                    "id": "721540120",
                                                    "speaker": "虎之助",
                                                    "text": "虽然，我不知道泽维尔先生是如何说服上面的大人们的。"
                                                },
                                                {
                                                    "id": "721540123",
                                                    "speaker": "泽维尔",
                                                    "text": "但说真的，这位源次郎大人真是一位…非常严肃认真，但同时也非常善解人意的先生。"
                                                },
                                                {
                                                    "id": "721540124",
                                                    "speaker": "泽维尔",
                                                    "text": "在我和他恳切地谈过之后，他十分愉快地答应了我的请求。"
                                                },
                                                {
                                                    "id": "721540125",
                                                    "speaker": "泽维尔",
                                                    "text": "不过嘛…作为交换，我必须先制作一部和幕府有关的「映影」，最好是以武士为主角。"
                                                },
                                                {
                                                    "id": "721540126",
                                                    "speaker": "泽维尔",
                                                    "text": "我对这种题材本来就感兴趣，当然就答应了下来，那位源次郎大人也很高兴。"
                                                },
                                                {
                                                    "id": "721540127",
                                                    "speaker": "泽维尔",
                                                    "text": "在亲自委派士兵先生和我同行之外，还额外指派了几位身手不错的士兵给我，然后他说…"
                                                },
                                                {
                                                    "id": "721540128",
                                                    "speaker": "泽维尔",
                                                    "text": "「以刀剑搏击的场面，展示武士和幕府的威严。」"
                                                },
                                                {
                                                    "id": "721540129",
                                                    "speaker": "泽维尔",
                                                    "text": "不得不说，这位源次郎大人的眼光真是颇为长远，居然想到用「映影」来做宣传…"
                                                },
                                                {
                                                    "id": "721540130",
                                                    "speaker": "泽维尔",
                                                    "text": "但对我来说，一切对我制作「映影」有帮助的事，我都不会拒绝。",
                                                    "choices": [
                                                        {
                                                            "id": "721540131",
                                                            "text": "你制作得还顺利吗？",
                                                            "response": [
                                                                {
                                                                    "id": "721540132",
                                                                    "speaker": "泽维尔",
                                                                    "text": "老实说…不太顺利…"
                                                                },
                                                                {
                                                                    "id": "721540133",
                                                                    "speaker": "泽维尔",
                                                                    "text": "虽然这几位士兵先生的武艺都很高强，但却不习惯这种「演艺式」的战斗。"
                                                                },
                                                                {
                                                                    "id": "721540134",
                                                                    "speaker": "泽维尔",
                                                                    "text": "不仅挥剑快到「映影机」没法记录，而且有时候演着演着，就跑到了镜头外面…"
                                                                },
                                                                {
                                                                    "id": "721540140",
                                                                    "speaker": "泽维尔",
                                                                    "text": "旅行者，如果您有空的话，能按照我写的台本，上镜演一遍让士兵先生们看看吗？"
                                                                },
                                                                {
                                                                    "id": "721540141",
                                                                    "speaker": "泽维尔",
                                                                    "text": "我相信，以您的实力和理解力，演艺时一定能在镜头前收放自如。"
                                                                },
                                                                {
                                                                    "id": "721540142",
                                                                    "speaker": "泽维尔",
                                                                    "text": "从旁观者的角度看过演出后，他们一定能更好地理解这个剧情。"
                                                                },
                                                                {
                                                                    "id": "721540143",
                                                                    "speaker": "泽维尔",
                                                                    "text": "来来来，你先看看台本，台词看看就好，这一段主要是打戏…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "721540144",
                                                                            "text": "「这场仗，也算是输了。」",
                                                                            "response": [
                                                                                {
                                                                                    "id": "721540147",
                                                                                    "speaker": "泽维尔",
                                                                                    "text": "啊，这些是另外场次的台词了…这一场戏主要是打戏，没什么台词。"
                                                                                },
                                                                                {
                                                                                    "id": "721540148",
                                                                                    "speaker": "Player",
                                                                                    "text": "我来看看台本…"
                                                                                },
                                                                                {
                                                                                    "id": "721540149",
                                                                                    "speaker": "泽维尔",
                                                                                    "text": "哦对了，您扮演的这个角色叫做「十三郎」，他和几名同伴一起，被一个村的村民们雇佣来保护村落…"
                                                                                },
                                                                                {
                                                                                    "id": "721540150",
                                                                                    "speaker": "泽维尔",
                                                                                    "text": "呃，这一场还有一位叫做「久藏」的同伴有台词…这台词就由我说好了，先走一遍流程。"
                                                                                },
                                                                                {
                                                                                    "id": "721540151",
                                                                                    "speaker": "泽维尔",
                                                                                    "text": "您一定要代入这个角色，理解这个角色！就把自己当做「十三郎」，明白了吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "721540152",
                                                                                            "text": "明、明白了。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "721540154",
                                                                                                    "speaker": "泽维尔",
                                                                                                    "text": "很好，非常好，好极了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "721540155",
                                                                                                    "speaker": "泽维尔",
                                                                                                    "text": "您准备好了之后就告诉我，我还得去把「映影机」的机位调整一下…"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "721540153",
                                                                                            "text": "我就是十三郎。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "721540145",
                                                                            "text": "「就算落难了，武士还是武士。」"
                                                                        },
                                                                        {
                                                                            "id": "721540146",
                                                                            "text": "「你们都是合格的稻草人…」"
                                                                        },
                                                                        {
                                                                            "id": "721540156",
                                                                            "text": "「…但敌人可不是团雀。」"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721540135",
                                                            "text": "我能演个角色吗？",
                                                            "response": [
                                                                {
                                                                    "id": "721540136",
                                                                    "speaker": "泽维尔",
                                                                    "text": "#当然！当然！您可是我心中永远的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！"
                                                                },
                                                                {
                                                                    "id": "721540137",
                                                                    "speaker": "泽维尔",
                                                                    "text": "那部《踏鞴物语》我可一直记着呢。"
                                                                },
                                                                {
                                                                    "id": "721540138",
                                                                    "speaker": "泽维尔",
                                                                    "text": "而且…虽然这几位士兵先生的武艺都很高强，但却不太习惯这种「演艺式」的战斗。"
                                                                },
                                                                {
                                                                    "id": "721540139",
                                                                    "speaker": "泽维尔",
                                                                    "text": "不仅挥剑快到「映影机」没法记录，而且有时候演着演着，就跑到了镜头外面…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721540121",
                                            "text": "你是怎么说服他的？",
                                            "response": [
                                                {
                                                    "id": "721540122",
                                                    "speaker": "泽维尔",
                                                    "text": "士兵先生早就理解了我，我主要的工作，还是说服那位御舆源次郎大人，请求他允许我在稻妻制作「映影」。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721540112",
                            "text": "「武士，如同席卷大地的清风。」",
                            "response": [
                                {
                                    "id": "721540113",
                                    "speaker": "泽维尔",
                                    "text": "您这句话的情绪太激昂了，应该是…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215405",
            "objective": "和泽维尔对话",
            "dialogues": [
                {
                    "id": "721540601",
                    "speaker": "Player",
                    "text": "我准备好了。"
                },
                {
                    "id": "721540602",
                    "speaker": "泽维尔",
                    "text": "太好了，非常好，那就准备开始吧！"
                },
                {
                    "id": "721540603",
                    "speaker": "泽维尔",
                    "text": "我这就去调整「映影机」，还有…把其他去热身的士兵先生们都叫回来…"
                }
            ]
        },
        {
            "id": "7215402",
            "objective": "帮助泽维尔制作「映影」",
            "dialogues": [
                {
                    "id": "721540201",
                    "speaker": "泽维尔",
                    "text": "哎呀，这样拍出来的「映影」可不太对。"
                },
                {
                    "id": "721540202",
                    "speaker": "泽维尔",
                    "text": "您再准备准备，我们再来一次吧。"
                }
            ]
        },
        {
            "id": "7215404",
            "objective": "和泽维尔对话",
            "dialogues": [
                {
                    "id": "721540901",
                    "speaker": "Player",
                    "text": "我准备好了。"
                },
                {
                    "id": "721540902",
                    "speaker": "泽维尔",
                    "text": "太好了，非常好，那就准备开始吧！"
                },
                {
                    "id": "721540903",
                    "speaker": "泽维尔",
                    "text": "我这就去调整「映影机」，还有…把其他去热身的士兵先生们都叫回来…"
                }
            ]
        },
        {
            "id": "7215403",
            "objective": "和泽维尔对话",
            "dialogues": [
                {
                    "id": "721540301",
                    "speaker": "泽维尔",
                    "text": "#完美！不愧是我心中永远的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！完美的示范！",
                    "choices": [
                        {
                            "id": "721540302",
                            "text": "什么…什么一号？",
                            "response": [
                                {
                                    "id": "721540303",
                                    "speaker": "泽维尔",
                                    "text": "一号演员，就是「映影」里最重要的演员。"
                                },
                                {
                                    "id": "721540306",
                                    "speaker": "泽维尔",
                                    "text": "士兵先生，您看清楚刚才旅行者的示范了吗？"
                                },
                                {
                                    "id": "721540307",
                                    "speaker": "虎之助",
                                    "text": "大致了解了。在挥剑的时候，我需要强调的其实并不是挥剑的「动作」，而是挥剑的「架势」，对吧？"
                                },
                                {
                                    "id": "721540308",
                                    "speaker": "虎之助",
                                    "text": "如果只是「架势」的话…我倒是有些主意。"
                                },
                                {
                                    "id": "721540309",
                                    "speaker": "泽维尔",
                                    "text": "哦？那太好了，请您去和其余的士兵先生们讲讲，稍后我们再来一次。"
                                },
                                {
                                    "id": "721540310",
                                    "speaker": "泽维尔",
                                    "text": "旅行者，太谢谢你了，这些东西请你收下吧。"
                                },
                                {
                                    "id": "721540311",
                                    "speaker": "Player",
                                    "text": "下一部「映影」的题材是？"
                                },
                                {
                                    "id": "721540312",
                                    "speaker": "泽维尔",
                                    "text": "下一部「映影」的题材啊…唔…其实我也非常犹豫，有很多题材我都想要试一试。"
                                },
                                {
                                    "id": "721540313",
                                    "speaker": "泽维尔",
                                    "text": "比如鸣神大社里的各种传统啦，稻妻所流传的狸猫和狐狸的传说啦。"
                                },
                                {
                                    "id": "721540314",
                                    "speaker": "泽维尔",
                                    "text": "稻妻有这么多岛屿，可以制作的故事实在是太多了。"
                                },
                                {
                                    "id": "721540315",
                                    "speaker": "泽维尔",
                                    "text": "但无论如何，我都得先把这部《第七个武士》制作好。"
                                },
                                {
                                    "id": "721540316",
                                    "speaker": "泽维尔",
                                    "text": "如果能让大人们满意的话，我之后在稻妻制作「映影」的时候，想必也会方便很多吧…"
                                }
                            ]
                        },
                        {
                            "id": "721540304",
                            "text": "下次想换个新角色。",
                            "response": [
                                {
                                    "id": "721540305",
                                    "speaker": "泽维尔",
                                    "text": "没问题！等拍完了这一部「映影」之后，我就该筹划下一部全新「映影」了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721540401",
                    "speaker": "虎之助",
                    "text": "「剑阵映影」…泽维尔先生起的名字真是独特。",
                    "choices": [
                        {
                            "id": "721540402",
                            "text": "你觉得这部「映影」怎么样？",
                            "response": [
                                {
                                    "id": "721540403",
                                    "speaker": "虎之助",
                                    "text": "大人们认为，这「映影」有助于传扬幕府武士的威名。"
                                },
                                {
                                    "id": "721540404",
                                    "speaker": "虎之助",
                                    "text": "也许是我在这方面有些愚钝吧…我真的没有这方面的感觉。"
                                },
                                {
                                    "id": "721540405",
                                    "speaker": "虎之助",
                                    "text": "而且，这台本里的武士们尽说些丧气话，全然没有武士的威严。"
                                },
                                {
                                    "id": "721540406",
                                    "speaker": "虎之助",
                                    "text": "不知道上面的大人们为什么会答应下来…"
                                }
                            ]
                        },
                        {
                            "id": "721540407",
                            "text": "「御影炉心」还好吗？",
                            "response": [
                                {
                                    "id": "721540408",
                                    "speaker": "虎之助",
                                    "text": "自从范兵卫大人「升迁」后，现在那边的负责人已经换成了阳介。"
                                },
                                {
                                    "id": "721540409",
                                    "speaker": "虎之助",
                                    "text": "他是工匠出身，十分踏实可靠，也很会处理实务。"
                                },
                                {
                                    "id": "721540410",
                                    "speaker": "虎之助",
                                    "text": "「御影炉心」由他负责，应该不会再出什么问题了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7215405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721540501",
                    "speaker": "泽维尔",
                    "text": "怎么样，您准备好了吗？"
                }
            ]
        },
        {
            "id": "7215407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721540701",
                    "speaker": "Player",
                    "text": "还没准备好…"
                },
                {
                    "id": "721540702",
