    "talks": [
        {
            "id": "1301501",
            "objective": "向「品梦一刻」的人告知现状",
            "dialogues": [
                {
                    "id": "130150101",
                    "speaker": "皮特",
                    "text": "太好了，你们也醒过来了。"
                },
                {
                    "id": "130150102",
                    "speaker": "皮特",
                    "text": "大家都陆续醒来，城里也好消息不断。"
                },
                {
                    "id": "130150103",
                    "speaker": "皮特",
                    "text": "看来事情已经顺利解决了对吧？"
                },
                {
                    "id": "130150104",
                    "speaker": "纳西妲",
                    "text": "嗯，虽然费了一些周折。"
                },
                {
                    "id": "130150105",
                    "speaker": "纳西妲",
                    "text": "应该等会儿会有很多人聚过来，麻烦你组织一下现场的秩序。"
                },
                {
                    "id": "130150106",
                    "speaker": "纳西妲",
                    "text": "#我和{M#他}{F#她}们去一趟教令院，马上就回来。"
                }
            ]
        },
        {
            "id": "1301502",
            "objective": "将装有意识的容器交给教令院",
            "dialogues": [
                {
                    "id": "130150201",
                    "speaker": "希忒",
                    "text": "是草神大人，请问有什么事呢？"
                },
                {
                    "id": "130150202",
                    "speaker": "纳西妲",
                    "text": "我想查询一下学籍资料，是否有一位刹诃伐罗学院的学者，现在处于昏迷不醒的状态。"
                },
                {
                    "id": "130150203",
                    "speaker": "希忒",
                    "text": "好的，请稍等。"
                },
                {
                    "id": "130150204",
                    "speaker": "Black Screen",
                    "text": "过了一段时间。"
                },
                {
                    "id": "130150205",
                    "speaker": "希忒",
                    "text": "久等了，草神大人，的确是有这样一位学者，名叫贝诺尼，因为违规操作虚空而陷入昏迷。"
                },
                {
                    "id": "130150206",
                    "speaker": "希忒",
                    "text": "直到现在他还没有恢复意识，仍在接受「健康之家」的治疗。"
                },
                {
                    "id": "130150207",
                    "speaker": "派蒙",
                    "text": "欸？他不是叫莫塞伊思吗？"
                },
                {
                    "id": "130150208",
                    "speaker": "纳西妲",
                    "text": "估计是不想被认出来吧，他不愿意被任何人打扰。"
                },
                {
                    "id": "130150209",
                    "speaker": "纳西妲",
                    "text": "这里面储存的知识，麻烦转交给风纪官，请他们导入到贝诺尼的大脑中。"
                },
                {
                    "id": "130150210",
                    "speaker": "希忒",
                    "text": "好的，不过出于安全性考虑，我还需要了解一下理由。"
                },
                {
                    "id": "130150211",
                    "speaker": "纳西妲",
                    "text": "很简单，这里面是他的意识，之前被困在某个梦境里了。"
                },
                {
                    "id": "130150212",
                    "speaker": "纳西妲",
                    "text": "他在梦境中做了一些影响须弥治安的事，在他醒来之后，我会和大风纪官概述情况。"
                },
                {
                    "id": "130150213",
                    "speaker": "希忒",
                    "text": "明白了，我这就去做，感谢草神大人。"
                },
                {
                    "id": "130150214",
                    "speaker": "纳西妲",
                    "text": "嗯，没关系。"
                },
                {
                    "id": "130150215",
                    "speaker": "纳西妲",
                    "text": "估计「品梦一刻」那边的人也聚集起来了，我们回去吧。"
                }
            ]
        },
        {
            "id": "1301503",
            "objective": "返回「品梦一刻」",
            "dialogues": [
                {
                    "id": "130150301",
                    "speaker": "派蒙",
                    "text": "我们就安静当听众就好了吧。"
                },
                {
                    "id": "130150302",
                    "speaker": "派蒙",
                    "text": "不知道她打算说什么呢。"
                },
                {
                    "id": "130150303",
                    "speaker": "纳西妲",
                    "text": "各位刚刚苏醒的人们，你们好。"
                },
                {
                    "id": "130150304",
                    "speaker": "纳西妲",
                    "text": "打扰到你们的美梦，我非常抱歉，在梦境中的处理或许有些冰冷，我也表达我的歉意。"
                },
                {
                    "id": "130150305",
                    "speaker": "纳西妲",
                    "text": "梦境拥有非常奇妙的力量，对心志坚定之人，它能鼓舞人心，为理想插上翅膀。"
                },
                {
                    "id": "130150306",
                    "speaker": "纳西妲",
                    "text": "但它也有可能乘虚而入，混淆认知，颠倒是非——很不幸，你们被选作了猎物。"
                },
                {
                    "id": "130150307",
                    "speaker": "纳西妲",
                    "text": "就像我之前所说，我还在不断学习，不敢说能感同身受那些离别之苦。"
                },
                {
                    "id": "130150308",
                    "speaker": "纳西妲",
                    "text": "但看看四周就知道，有过类似遭遇的人并不少见。"
                },
                {
                    "id": "130150309",
                    "speaker": "纳西妲",
                    "text": "你们能相聚并站在这里，一同望向远方，你们应该为此自豪。"
                },
                {
                    "id": "130150310",
                    "speaker": "纳西妲",
                    "text": "生命的道路非常漫长，我们都很难看到终点。由此我们可能会产生很多问题——"
                },
                {
                    "id": "130150311",
                    "speaker": "纳西妲",
                    "text": "「我活着的意义是什么？我的目标是什么？我为什么要不断经历痛苦？」"
                },
                {
                    "id": "130150312",
                    "speaker": "纳西妲",
                    "text": "诚然，停下脚步，放弃思考，重复熟悉的做法，这是最轻松的选择。"
                },
                {
                    "id": "130150313",
                    "speaker": "纳西妲",
                    "text": "每当产生这样的念头的时候，就看看身边存在的人和事吧。"
                },
                {
                    "id": "130150314",
                    "speaker": "纳西妲",
                    "text": "有人终日辛勤劳作，为的是一家人能在夜晚吃上热腾腾的饭菜。"
                },
                {
                    "id": "130150315",
                    "speaker": "纳西妲",
                    "text": "有人走遍大江南北，为的是创作出让整个提瓦特都能产生共鸣的艺术品。"
                },
                {
                    "id": "130150316",
                    "speaker": "纳西妲",
                    "text": "有人探寻世界的秘密，为的是预防逐渐逼近而又不可名状的灾难。"
                },
                {
                    "id": "130150317",
                    "speaker": "纳西妲",
                    "text": "——自我并非生命意义的全部，每一次行动都是对自我与世界的塑造。"
                },
                {
                    "id": "130150318",
                    "speaker": "纳西妲",
                    "text": "亲朋好友会铭记你们的所作所为，陌生人也可能因为你们的行动而受惠。"
                },
                {
                    "id": "130150319",
                    "speaker": "纳西妲",
                    "text": "为此，有许多人哪怕承受痛苦，也要开拓全新道路。"
                },
                {
                    "id": "130150320",
                    "speaker": "纳西妲",
                    "text": "而当你们走上同样的道路，那些终极问题的答案就会慢慢浮现，也变得不再重要。"
                },
                {
                    "id": "130150321",
                    "speaker": "纳西妲",
                    "text": "但如果你们觉得生命就是虚无，那它就会逐渐走向虚无。"
                },
                {
                    "id": "130150322",
                    "speaker": "纳西妲",
                    "text": "你们有选择生存方式的自由，但作为神，我需要先叫醒你们。"
                },
                {
                    "id": "130150323",
                    "speaker": "纳西妲",
                    "text": "还要不要以放弃现实为代价拥抱美梦，取决于你们自己。"
                }
            ]
        },
        {
            "id": "1301504",
            "objective": "与纳西妲在广场见面",
            "dialogues": [
                {
                    "id": "130150401",
                    "speaker": "派蒙",
                    "text": "你好厉害，在梦境里，我都觉得有点说不过那个学者了。"
                },
                {
                    "id": "130150402",
                    "speaker": "纳西妲",
                    "text": "他利用人性弱点的方式确实很巧妙，或许他自己也早就深陷其中了。"
                },
                {
                    "id": "130150403",
                    "speaker": "纳西妲",
                    "text": "那个梦境有难以言喻的诱惑力，甜蜜得让人上瘾，而普通人很难有清晰的判断。"
                },
                {
                    "id": "130150404",
                    "speaker": "纳西妲",
                    "text": "但只要能醒过来，什么时候都不算晚。"
                },
                {
                    "id": "130150405",
                    "speaker": "Player",
                    "text": "你也长进了很多啊。"
                },
                {
                    "id": "130150406",
                    "speaker": "纳西妲",
                    "text": "欸？怎么突然这么说？"
                },
                {
                    "id": "130150407",
                    "speaker": "Player",
                    "text": "你其实挺能共情的。"
                },
                {
                    "id": "130150408",
                    "speaker": "派蒙",
                    "text": "就是，虽然你说你不太懂人类的感情，但你的犹豫我们都看在眼里。"
                },
                {
                    "id": "130150409",
                    "speaker": "派蒙",
                    "text": "刚刚那段演讲，也是站在他们的立场上说的，这不是做得很好嘛！"
                },
                {
                    "id": "130150410",
                    "speaker": "纳西妲",
                    "text": "谢谢你们，这一路上我听到了很多悲伤的故事，内心不止一次受到触动。"
                },
                {
                    "id": "130150411",
                    "speaker": "纳西妲",
                    "text": "受害者们的行为并不算错，他们想要的东西也不过分…"
                },
                {
                    "id": "130150412",
                    "speaker": "纳西妲",
                    "text": "所以在他们试图对抗我们，保护梦境的时候，我可以理解他们的选择。"
                },
                {
                    "id": "130150413",
                    "speaker": "纳西妲",
                    "text": "但我的理解与触动，和他们真实经历的痛苦相比，可能连百分之一都不到。"
                },
                {
                    "id": "130150414",
                    "speaker": "纳西妲",
                    "text": "这「百分之一」，我不敢认为它是所谓的共情。"
                },
                {
                    "id": "130150415",
                    "speaker": "派蒙",
                    "text": "你要求真高，当然是啦。",
                    "choices": [
                        {
                            "id": "130150416",
                            "text": "做不到绝对的共情。",
                            "response": [
                                {
                                    "id": "130150418",
                                    "speaker": "纳西妲",
                                    "text": "嘿嘿，好的，果然出来转转才会成长呢。"
                                },
                                {
                                    "id": "130150419",
                                    "speaker": "纳西妲",
                                    "text": "感情和知识完全不同，我很难用清晰的言语描述它。"
                                },
                                {
                                    "id": "130150420",
                                    "speaker": "纳西妲",
                                    "text": "贝诺尼…或者「莫塞伊思」说我没有经历过生离死别，可我有种特别模糊的感觉，告诉我并不是这样。"
                                },
                                {
                                    "id": "130150421",
                                    "speaker": "纳西妲",
                                    "text": "我刚进入梦境，就感觉我被一股特别温暖的热流包裹。"
                                },
                                {
                                    "id": "130150422",
                                    "speaker": "纳西妲",
                                    "text": "温暖到感觉自己回到了生命的原初状态，再也不愿意醒来。"
                                },
                                {
                                    "id": "130150423",
                                    "speaker": "Player",
                                    "text": "（难道说她也看到了什么？）"
                                },
                                {
                                    "id": "130150424",
                                    "speaker": "纳西妲",
                                    "text": "可是我睁开眼睛之后，那种感觉就消失了，一点痕迹都没留下。"
                                },
                                {
                                    "id": "130150425",
                                    "speaker": "纳西妲",
                                    "text": "打比方的话，就像是一张白纸擦除了上面的笔迹，我看不见文字，但是能看到浅浅的凹痕。"
                                },
                                {
                                    "id": "130150426",
                                    "speaker": "纳西妲",
                                    "text": "但经历了这场梦境之后，我想得很清楚了，无论那股暖流意味着什么，都不重要。"
                                },
                                {
                                    "id": "130150427",
                                    "speaker": "纳西妲",
                                    "text": "我能确定的是，我曾经被那股很温暖的力量支撑，才能一路走到今天。"
                                },
                                {
                                    "id": "130150428",
                                    "speaker": "纳西妲",
                                    "text": "要是过分在意温暖来自于哪里，那就本末倒置了。"
                                },
                                {
                                    "id": "130150429",
                                    "speaker": "纳西妲",
                                    "text": "刚刚和人民讲了那么多理想的话，到头来自己却做不到，那是不是太丢人了，嘿嘿。"
                                },
                                {
                                    "id": "130150430",
                                    "speaker": "Player",
                                    "text": "（大慈树王已经用她的行动塑造了纳西妲。）"
                                },
                                {
                                    "id": "130150431",
                                    "speaker": "Player",
                                    "text": "（哪怕世界遗忘了她，纳西妲的思想与意志也是她「存在过」的证明。）"
                                },
                                {
                                    "id": "130150432",
                                    "speaker": "Player",
                                    "text": "（比起诉说真相，我更应该尊重她们的想法。）"
                                },
                                {
                                    "id": "130150433",
                                    "speaker": "派蒙",
                                    "text": "怎么了？突然一脸沉重的样子。"
                                },
                                {
                                    "id": "130150434",
                                    "speaker": "纳西妲",
                                    "text": "看你好几次欲言又止了，是有什么话想告诉我吗？",
                                    "choices": [
                                        {
                                            "id": "130150435",
                                            "text": "我忘了要说什么了。",
                                            "response": [
                                                {
                                                    "id": "130150437",
                                                    "speaker": "纳西妲",
                                                    "text": "呵呵，这样啊。"
                                                },
                                                {
                                                    "id": "130150438",
                                                    "speaker": "纳西妲",
                                                    "text": "那么睡醒之后，不如伸个懒腰吧。"
                                                },
                                                {
                                                    "id": "130150439",
                                                    "speaker": "纳西妲",
                                                    "text": "新的一天要开始了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130150436",
                                            "text": "不重要吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130150417",
                            "text": "你大可自信一点。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1301505",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130150501",
                    "speaker": "埃勒曼",
                    "text": "谢谢你们救了我，实在对不起，幸好海达没有因为我犯糊涂而受伤…"
                },
                {
                    "id": "130150502",
                    "speaker": "海达",
                    "text": "爸爸说，你们很厉害，是救命恩人，谢谢你们！"
                }
            ]
        },
        {
            "id": "1301506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130150601",
                    "speaker": "凯西娅",
                    "text": "我准备去冒险了，和这盆植物一起。"
                },
                {
                    "id": "130150602",
                    "speaker": "凯西娅",
                    "text": "我不该只是等待的，既然是艾莎老师无论如何都要去探寻的秘密，我也要去看一看。"
                },
                {
                    "id": "130150603",
                    "speaker": "凯西娅",
                    "text": "谢谢你们，未来我们有缘再见。"
                }
            ]
        },
        {
            "id": "1301507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130150701",
                    "speaker": "黛比",
                    "text": "我发现我和纳赛尔挺聊得来的，都是很直爽的性格。"
                },
                {
                    "id": "130150702",
                    "speaker": "纳赛尔",
                    "text": "而且我们都和草神大人唱了反调呢，一个在现实，一个在梦里，哈哈哈。"
                }
            ]
        },
        {
            "id": "1301508",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130150801",
                    "speaker": "奇恩",
                    "text": "睡太久了，我还有点晕…先别管我了…"
                }
            ]
        },
        {
            "id": "1301509",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130150901",
                    "speaker": "伊娜丝",
                    "text": "你说，既然在梦里都是邻居，要不要干脆一起合租吧。"
                },
                {
                    "id": "130150902",
                    "speaker": "塞娜",
                    "text": "好啊好啊，我估计也付不起一栋房子的租金了…不过总会好起来的吧。"
                }
            ]
        },
        {
            "id": "1301510",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130151001",
                    "speaker": "黛比",
                    "text": "我感觉到梦的深处出现了剧烈的震动，然后我就醒了。"
                },
                {
                    "id": "130151002",
                    "speaker": "黛比",
                    "text": "梦，总是会有醒来的时候…"
                }
            ]
        },
        {
            "id": "1301512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130151201",
                    "speaker": "纳赛尔",
                    "text": "全都一下子醒过来，看起来挺壮观的啊。"
                }
            ]
        },
        {
            "id": "1301514",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130151401",
                    "speaker": "希忒",
                    "text": "我会尽快去办，请放心。"
                }
            ]
        },
        {
            "id": "1301516",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130151601",
                    "speaker": "皮特",
                    "text": "幸好当时叫住了你们，不然只凭我们，肯定应对不了这种状况。"
                },
                {
                    "id": "130151602",
                    "speaker": "派蒙",
                    "text": "你也做得很好啦。"
                }
            ]
        },
        {
            "id": "1301599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130159901",
                    "speaker": "派蒙",
                    "text": "我们这是要去问问那个学者的状况吧？"
                },
                {
                    "id": "130159902",
                    "speaker": "纳西妲",
                    "text": "嗯，不过意识回归身体之后，可能还需要一段时间才能醒过来。"
                },
                {
                    "id": "130159903",
                    "speaker": "纳西妲",
                    "text": "接下来的事情就交给风纪官了。"
                },
                {
                    "id": "130159904",
                    "speaker": "黛比",
                    "text": "（应该是旅行者和草神大人在深处做了什么吧。）"
                },
                {
                    "id": "130159905",
                    "speaker": "纳赛尔",
                    "text": "（不愧是草神大人，不得不服气啊。）"
                },
                {
                    "id": "130159906",
                    "speaker": "希忒",
                    "text": "（越是在大人物面前，越是要把工作做好，可不能渎职。）"
                },
                {
                    "id": "130159907",
                    "speaker": "皮特",
                    "text": "（终于结束了…很完美，就是太累了，唉…）"
                },
                {
                    "id": "130159908",
                    "speaker": "埃勒曼",
                    "text": "（我的运气真是太好了…）"
                },
                {
                    "id": "130159909",
                    "speaker": "海达",
                    "text": "（爸爸最好了！）"
                },
                {
                    "id": "130159910",
                    "speaker": "凯西娅",
                    "text": "（原来这才是艾莎老师对我的期待，我醒悟得太晚了。）"
                },
                {
                    "id": "130159911",
                    "speaker": "黛比",
                    "text": "（是不是值得庆祝一下，去吃点好的？）"
                },
                {
                    "id": "130159912",
                    "speaker": "纳赛尔",
                    "text": "（等会儿约她去喝杯酒吧。）"
                },
                {
                    "id": "130159913",
                    "speaker": "奇恩",
                    "text": "（晕乎乎的，还有点想吐。）"
                },
                {
                    "id": "130159914",
                    "speaker": "伊娜丝",
                    "text": "（新生活估计还需要适应一段时间，不过也无所谓了。）"
                },
                {
                    "id": "130159915",
                    "speaker": "塞娜",
                    "text": "（太好了，接下来的日子有着落了。）"
                },
                {
                    "id": "130159916",
                    "speaker": "派蒙",
                    "text": "纳西妲说还有些话想单独说一说。"
                },
                {
                    "id": "130159917",
                    "speaker": "派蒙",
                    "text": "她好像去教令院前面的广场了。"
                }
            ]
        }
    ]
}