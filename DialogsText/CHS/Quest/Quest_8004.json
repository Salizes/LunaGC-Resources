    "talks": [
        {
            "id": "800401",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "80040101",
                    "speaker": "凯瑟琳",
                    "text": "啊旅行者，可真是巧啊，呵呵。"
                },
                {
                    "id": "80040102",
                    "speaker": "派蒙",
                    "text": "凯瑟琳小姐，今天有什么委托吗？还有…你今天见到我们怎么好像格外开心的样子？"
                },
                {
                    "id": "80040103",
                    "speaker": "凯瑟琳",
                    "text": "因为今天早些时候我去神社求签，巫女告诉我说，最近适合「意料之外的再会」哦？"
                },
                {
                    "id": "80040104",
                    "speaker": "派蒙",
                    "text": "凯瑟琳小姐会去神社求签？怎么感觉是非常非常稀奇的景象！"
                },
                {
                    "id": "80040105",
                    "speaker": "派蒙",
                    "text": "不对，重点是你一天之内去稻妻跑了个来回吗？这里可是璃月欸！"
                },
                {
                    "id": "80040106",
                    "speaker": "凯瑟琳",
                    "text": "呵呵，哪怕是我，也偶尔会有些私生活的嘛。"
                },
                {
                    "id": "80040107",
                    "speaker": "派蒙",
                    "text": "所以你说「意料之外的再会」，指的是和我们吗？"
                },
                {
                    "id": "80040108",
                    "speaker": "凯瑟琳",
                    "text": "谁知道呢，至少有了这份期待，就感觉见到谁都会很开心了。"
                },
                {
                    "id": "80040109",
                    "speaker": "派蒙",
                    "text": "好吧…明明我们几乎每天都要见面的，凯瑟琳小姐开心就好。",
                    "choices": [
                        {
                            "id": "80040110",
                            "text": "意料之外的再会…",
                            "response": [
                                {
                                    "id": "80040112",
                                    "speaker": "派蒙",
                                    "text": "#你是说…嗯，我理解你的心情，{NICKNAME}，如果巫女所说的真能灵验就好了…"
                                },
                                {
                                    "id": "80040113",
                                    "speaker": "派蒙",
                                    "text": "#你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}…"
                                },
                                {
                                    "id": "80040114",
                                    "speaker": "凯瑟琳",
                                    "text": "我是不是…说了什么不该说的话呢？看到你们好像有些沮丧。"
                                },
                                {
                                    "id": "80040115",
                                    "speaker": "派蒙",
                                    "text": "没事没事，凯瑟琳小姐，我们还是回到委托的话题吧，有没有什么适合我们的委托呢？"
                                },
                                {
                                    "id": "80040116",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，正巧有一位矿工大哥的委托，似乎是关于层岩巨渊的调查。"
                                },
                                {
                                    "id": "80040117",
                                    "speaker": "派蒙",
                                    "text": "欸，那边难道已经解除封锁了吗？"
                                },
                                {
                                    "id": "80040118",
                                    "speaker": "凯瑟琳",
                                    "text": "那么具体情况就让委托人再详细与你们沟通吧，他叫玥辉，现在应该就在层岩巨渊的附近。"
                                },
                                {
                                    "id": "80040119",
                                    "speaker": "派蒙",
                                    "text": "好的，凯瑟琳小姐，那我们就动身啦！"
                                },
                                {
                                    "id": "80040120",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，向着星辰与深渊…唔，这次好像真的是向着「深渊」呢，祝两位好运。"
                                }
                            ]
                        },
                        {
                            "id": "80040111",
                            "text": "或许…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800402",
            "objective": "在层岩巨渊附近找到发布委托的矿工",
            "dialogues": [
                {
                    "id": "80040201",
                    "speaker": "派蒙",
                    "text": "你好！是那个…那个玥辉吗？我们是冒险家协会派来的。"
                },
                {
                    "id": "80040202",
                    "speaker": "玥辉",
                    "text": "哦，幸会幸会，确实是我发布的委托。"
                },
                {
                    "id": "80040203",
                    "speaker": "玥辉",
                    "text": "嗯？这位看起来好像有点眼熟…是很有名的冒险家么？",
                    "choices": [
                        {
                            "id": "80040204",
                            "text": "我的来历比较复杂。",
                            "response": [
                                {
                                    "id": "80040206",
                                    "speaker": "玥辉",
                                    "text": "这样啊，好吧。先自我介绍一下，我是前不久才拿到层岩巨渊开采许可的矿工，手下有一些跟着我的兄弟。"
                                },
                                {
                                    "id": "80040207",
                                    "speaker": "派蒙",
                                    "text": "居然可以拿到层岩巨渊的开采许可？"
                                },
                                {
                                    "id": "80040208",
                                    "speaker": "玥辉",
                                    "text": "嗯，玉京台那边终于也开窍了，在千岩军的保护下，开始准许一些仅限于浅表范围的矿物开采，我们还是第一批。"
                                },
                                {
                                    "id": "80040209",
                                    "speaker": "玥辉",
                                    "text": "可最近发生了一些事情，矿工兄弟们都有些人心惶惶。"
                                },
                                {
                                    "id": "80040210",
                                    "speaker": "派蒙",
                                    "text": "发生了什么事？我们好像没听说过。"
                                },
                                {
                                    "id": "80040211",
                                    "speaker": "玥辉",
                                    "text": "嗯…这件事说大不大，说小不小，只是有些诡异…"
                                },
                                {
                                    "id": "80040212",
                                    "speaker": "玥辉",
                                    "text": "有个兄弟在休息的时候，忽然注意到几个丘丘人神情恍惚地路过。"
                                },
                                {
                                    "id": "80040213",
                                    "speaker": "玥辉",
                                    "text": "而且这些丘丘人看都没看他一眼，只是径直朝着层岩巨渊深处去了。"
                                },
                                {
                                    "id": "80040214",
                                    "speaker": "玥辉",
                                    "text": "于是那个兄弟刻意留心观察了一段时日，发现时不时便会有类似的情况发生。"
                                },
                                {
                                    "id": "80040215",
                                    "speaker": "派蒙",
                                    "text": "丘丘人难道也有好奇心吗？会不会只是来这边转转…"
                                },
                                {
                                    "id": "80040216",
                                    "speaker": "玥辉",
                                    "text": "不，诡异的地方在于，他发现来到层岩巨渊的丘丘人们…"
                                },
                                {
                                    "id": "80040217",
                                    "speaker": "玥辉",
                                    "text": "…从来都是「只进不出」的。"
                                },
                                {
                                    "id": "80040218",
                                    "speaker": "玥辉",
                                    "text": "那些丘丘人的行迹永远都是单向的，进去之后就再也没有出来。"
                                },
                                {
                                    "id": "80040219",
                                    "speaker": "玥辉",
                                    "text": "这段时间，类似的情况愈发频繁。"
                                },
                                {
                                    "id": "80040220",
                                    "speaker": "玥辉",
                                    "text": "「那些丘丘人的目标究竟是什么」，「它们后来怎么样了」，「会不会是在酝酿什么灾厄」…"
                                },
                                {
                                    "id": "80040221",
                                    "speaker": "玥辉",
                                    "text": "这些念头在矿工兄弟们的脑海中不断出现，很多人都要把自己吓得发疯了。"
                                },
                                {
                                    "id": "80040222",
                                    "speaker": "派蒙",
                                    "text": "唔呃，我好像能理解…光是听上去就觉得有些头皮发麻…",
                                    "choices": [
                                        {
                                            "id": "80040223",
                                            "text": "不敢想象层岩巨渊内部的画面…",
                                            "response": [
                                                {
                                                    "id": "80040225",
                                                    "speaker": "玥辉",
                                                    "text": "是啊，可能源于未知的恐惧才是最深的恐惧吧。只有查明了真相，兄弟们才能安心干活啊。"
                                                },
                                                {
                                                    "id": "80040226",
                                                    "speaker": "派蒙",
                                                    "text": "我们…我们真的要接这个委托吗？那个，矿工大哥，让我们再考虑一下…"
                                                },
                                                {
                                                    "id": "80040227",
                                                    "speaker": "Player",
                                                    "text": "交给我们吧。"
                                                },
                                                {
                                                    "id": "80040228",
                                                    "speaker": "派蒙",
                                                    "text": "喂！你也照顾一下我的意见呀！",
                                                    "choices": [
                                                        {
                                                            "id": "80040229",
                                                            "text": "类似这样的诡异情况…",
                                                            "response": [
                                                                {
                                                                    "id": "80040231",
                                                                    "speaker": "派蒙",
                                                                    "text": "原来你是这样考虑的，唔…那、那好吧，或许真的藏着什么关于你血亲的线索呢。"
                                                                },
                                                                {
                                                                    "id": "80040232",
                                                                    "speaker": "派蒙",
                                                                    "text": "不去的话，你会一直很在意的吧？"
                                                                },
                                                                {
                                                                    "id": "80040233",
                                                                    "speaker": "玥辉",
                                                                    "text": "二位决定要接下这个委托了吗？我可不想我的开采许可证就这么白费了。"
                                                                },
                                                                {
                                                                    "id": "80040234",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，就当是我们也想满足一下好奇心吧。"
                                                                },
                                                                {
                                                                    "id": "80040235",
                                                                    "speaker": "玥辉",
                                                                    "text": "那可真是帮了大忙了，我这就告诉你们那些丘丘人去往的大致位置…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80040230",
                                                            "text": "我怀疑和「深渊教团」有所关联。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80040224",
                                            "text": "确实是非常诡异的事件…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80040205",
                            "text": "还是直接说正事吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800407",
            "objective": "进入层岩巨渊·地下矿区",
            "dialogues": []
        },
        {
            "id": "800403",
            "objective": "前往指定区域进行调查",
            "dialogues": [
                {
                    "id": "80040301",
                    "speaker": "派蒙",
                    "text": "这里是…一座城市！"
                },
                {
                    "id": "80040302",
                    "speaker": "派蒙",
                    "text": "在空中的，倒立的，一整座城市？",
                    "choices": [
                        {
                            "id": "80040303",
                            "text": "令人震撼的景象…",
                            "response": [
                                {
                                    "id": "80040402",
                                    "speaker": "派蒙",
                                    "text": "#看着这座城市，{NICKNAME}，你会不会想起些什么…"
                                },
                                {
                                    "id": "80040403",
                                    "speaker": "派蒙",
                                    "text": "唔，是什么来着…"
                                },
                                {
                                    "id": "80040404",
                                    "speaker": "Player",
                                    "text": "「污秽逆位神像」。"
                                },
                                {
                                    "id": "80040405",
                                    "speaker": "派蒙",
                                    "text": "对的对的！就是这个，又诡异，又是倒立的，还有一些震撼的感觉。"
                                },
                                {
                                    "id": "80040406",
                                    "speaker": "派蒙",
                                    "text": "这样说的话，难道层岩巨渊的下面真的会跟深渊教团有关吗？"
                                },
                                {
                                    "id": "80040407",
                                    "speaker": "派蒙",
                                    "text": "我们要想办法去调查一下…"
                                },
                                {
                                    "id": "80040408",
                                    "speaker": "派蒙",
                                    "text": "…啊…"
                                },
                                {
                                    "id": "80040409",
                                    "speaker": "戴因斯雷布",
                                    "text": "……",
                                    "choices": [
                                        {
                                            "id": "80040410",
                                            "text": "戴因斯雷布？",
                                            "response": [
                                                {
                                                    "id": "80040412",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我也没料到会在这里遇上你们。"
                                                },
                                                {
                                                    "id": "80040413",
                                                    "speaker": "派蒙",
                                                    "text": "好久不见，戴因…不对，你为什么会突然出现在层岩巨渊？"
                                                },
                                                {
                                                    "id": "80040414",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "层岩巨渊…这里是层岩巨渊之下么，连我也未曾涉足过的地方…原来是这样。"
                                                },
                                                {
                                                    "id": "80040415",
                                                    "speaker": "Player",
                                                    "text": "我有很多事情要问你。"
                                                },
                                                {
                                                    "id": "80040416",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "那次的「相见」与「分别」都有些仓促，我能理解你的心情。"
                                                },
                                                {
                                                    "id": "80040417",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "而从眼前的这份巧合来看，命运确实欠你一个解答。",
                                                    "choices": [
                                                        {
                                                            "id": "80040418",
                                                            "text": "先解释一下你是怎么出现在这里的。",
                                                            "response": [
                                                                {
                                                                    "id": "80040420",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "应该不难猜才对。我之前又捕捉到一名深渊使徒的动向，并开始了追迹。"
                                                                },
                                                                {
                                                                    "id": "80040421",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "只可惜，那家伙被我逼入绝路后，又玩起了老把戏…"
                                                                },
                                                                {
                                                                    "id": "80040422",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "我紧随其后穿过了传送门，果不其然，还是错误的地点。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80040423",
                                                                            "text": "这么说来，之前那次你穿过传送门…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80040425",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "嗯，透过近期的一些经历，我只能推断…深渊操控着的传送能力，似乎不只是点对点，而是一个完整的网状结构。"
                                                                                },
                                                                                {
                                                                                    "id": "80040426",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "传送门的对面可能是传送网络中的任何一个节点，这由他们来决定。"
                                                                                },
                                                                                {
                                                                                    "id": "80040427",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "听起来和传送锚点也有些相似呢？"
                                                                                },
                                                                                {
                                                                                    "id": "80040428",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "总之，尽管那次我紧随着你的血亲进入了传送门，可当我认清四周的时候…"
                                                                                },
                                                                                {
                                                                                    "id": "80040429",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "…却发现自己已经独自一人，身处那条风魔龙的巢穴之中。"
                                                                                },
                                                                                {
                                                                                    "id": "80040430",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "哦，说起来，那颗第一台「耕地机」的眼睛怎么样了？"
                                                                                },
                                                                                {
                                                                                    "id": "80040431",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "我已经安顿好了，在搞清楚那所谓「命运的织机」计划的真面目之前，无需担忧它落入深渊之手。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80040432",
                                                                                            "text": "请你重新自我介绍一下吧。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80040434",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "哼，你记住了这个名号么。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80040435",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "并非我有意隐瞒。这个名号曾沐浴着坎瑞亚的荣光，可如今…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80040436",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "…更像一种讽刺，一种诅咒罢了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80040437",
                                                                                                    "speaker": "戴因斯雷布",
                                                                                                    "text": "作为见证了自己国度覆灭的宫廷卫队队长，我想我有理由不愿再提起这个名号。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "80040438",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#看来你的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}说的都是真的…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "80040439",
                                                                                                            "text": "#关于我{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}的往事…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "80040441",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "我们曾是「旅伴」。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040442",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "那是一段怀抱着苦痛不断搜寻命运的旅途，只不过…我们未能共同抵达「终点」。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040443",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "「旅途的终点」…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040444",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "在你继续没完没了地发问之前，我有必要提示你…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040445",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "假如我对「传送网络」的猜测是正确的，刚刚我又恰巧被传送至此，那就证明在深渊教团眼里，此处存在着设立传送节点的价值。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040446",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "你是说深渊教团准备在这里进行什么行动吗？这倒是跟我和旅行者的预感一样。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040447",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "那么，此时此刻的我们…很有可能正在被「深渊」窥伺着。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80040448",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "别、别这么说，我好像有些毛骨悚然了！",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "80040449",
                                                                                                                            "text": "先进行调查吧。",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "80040451",
                                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                                    "text": "呵，明智。那边的岩壁附近似乎有火光，我们过去看看。"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "80040450",
                                                                                                                            "text": "我暂且相信你。"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "80040440",
                                                                                                            "text": "你们之间究竟发生过什么？"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "80040433",
                                                                                            "text": "「末光之剑」。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80040424",
                                                                            "text": "#也没能追上我的{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SISTER|INFO_MALE_PRONOUN_BROTHER]}？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80040419",
                                                            "text": "刚才的传送门是怎么回事？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80040411",
                                            "text": "真是别样的出场方式。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80040304",
                            "text": "完全超乎了想象…"
                        }
                    ]
                }
            ]
        },
