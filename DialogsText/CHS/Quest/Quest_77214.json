    "talks": [
        {
            "id": "7721401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772140101",
                    "speaker": "派蒙",
                    "text": "奇怪，这是什么…是一封…邀请函？"
                },
                {
                    "id": "772140102",
                    "speaker": "「灰眸」",
                    "text": "这是一封请柬…"
                },
                {
                    "id": "772140103",
                    "speaker": "派蒙",
                    "text": "请柬，我看看…唔，好像是，名叫帕芙琳娜的雪孃大公，邀请…得到这封请柬的人参加婚礼…"
                },
                {
                    "id": "772140104",
                    "speaker": "派蒙",
                    "text": "「欲参加典仪的者，手持请柬，即为受到邀请的证明…」"
                },
                {
                    "id": "772140105",
                    "speaker": "派蒙",
                    "text": "嗯，那么这个婚礼举办的地方是…雪山之上的赫斯什么玻璃…"
                },
                {
                    "id": "772140106",
                    "speaker": "「灰眸」",
                    "text": "赫斯珀利德斯之馆…那确实是，昔日执掌雪精的王公居住之处，而帕芙琳娜…"
                },
                {
                    "id": "772140107",
                    "speaker": "「灰眸」",
                    "text": "这个名字的主人，我有模糊的印象…"
                },
                {
                    "id": "772140108",
                    "speaker": "派蒙",
                    "text": "难道说，这个叫帕芙琳娜的雪孃王公，也和「眼镜」的过去有关系？"
                },
                {
                    "id": "772140109",
                    "speaker": "「灰眸」",
                    "text": "十有八九。"
                },
                {
                    "id": "772140110",
                    "speaker": "派蒙",
                    "text": "哦…那我们不如就去看看这个雪孃王公的婚礼吧！"
                }
            ]
        },
