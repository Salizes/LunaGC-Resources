    "talks": [
        {
            "id": "7303901",
            "objective": "",
            "dialogues": [
                {
                    "id": "730390601",
                    "speaker": "Player",
                    "text": "好啊。"
                },
                {
                    "id": "730390602",
                    "speaker": "兰帕卡提",
                    "text": "哥哥们都准备好了，现在就可以开始。"
                }
            ]
        },
        {
            "id": "7303902",
            "objective": "和「哥哥们」交谈",
            "dialogues": [
                {
                    "id": "730390301",
                    "speaker": "兰非拉",
                    "text": "#「鲜嫩无朋之果」…为了无忧节，兰非拉已经准备好了，不用那菈{NICKNAME}担心！"
                },
                {
                    "id": "730390302",
                    "speaker": "派蒙",
                    "text": "兰非拉动作好快！我们去看看其他地方吧。"
                }
            ]
        },
        {
            "id": "7303905",
            "objective": "和「哥哥们」交谈",
            "dialogues": [
                {
                    "id": "730390701",
                    "speaker": "兰萨卡",
                    "text": "多加一点「开心的味道」…"
                },
                {
                    "id": "730390702",
                    "speaker": "派蒙",
                    "text": "哇！可以不用加那么多的！"
                },
                {
                    "id": "730390703",
                    "speaker": "兰萨卡",
                    "text": "哦…兰帕卡提说了，菜肴要让那菈高兴，派蒙说得对，那就、那就少加一点…"
                },
                {
                    "id": "730390704",
                    "speaker": "派蒙",
                    "text": "嗯！这样应该没问题了。"
                }
            ]
        },
        {
            "id": "7303904",
            "objective": "和「哥哥们」交谈",
            "dialogues": [
                {
                    "id": "730390801",
                    "speaker": "兰茶荼",
                    "text": "「一头菇」，早就准备好了！嘿嘿，芬芳的「一头菇」…"
                },
                {
                    "id": "730390802",
                    "speaker": "兰茶荼",
                    "text": "#不过火候…兰茶荼不擅长，那菈{NICKNAME}，来看看…"
                },
                {
                    "id": "730390803",
                    "speaker": "派蒙",
                    "text": "火对于兰那罗来说还是有点危险呢…我们来帮忙调整火候吧。"
                }
            ]
        },
        {
            "id": "7303911",
            "objective": "帮助兰茶荼调整火候",
            "dialogues": [
                {
                    "id": "730390901",
                    "speaker": "派蒙",
                    "text": "这样应该可以吧？"
                },
                {
                    "id": "730390902",
                    "speaker": "兰茶荼",
                    "text": "啊！成了，这样一定能做出完美无缺的「至上珍馐」！"
                }
            ]
        },
        {
            "id": "7303903",
            "objective": "和「哥哥们」交谈",
            "dialogues": [
                {
                    "id": "730390401",
                    "speaker": "兰阿帕斯",
                    "text": "#「最好喝的水」！练习的时候用完了…那菈{NICKNAME}，可不可以…可不可以帮兰阿帕斯去桓那兰那南边取水…"
                },
                {
                    "id": "730390402",
                    "speaker": "派蒙",
                    "text": "#唔…{NICKNAME}，那我们就帮帮他吧？"
                }
            ]
        },
        {
            "id": "7303909",
            "objective": "为兰阿帕斯取水",
            "dialogues": []
        },
        {
            "id": "7303910",
            "objective": "将取到的水交给兰阿帕斯",
            "dialogues": [
                {
                    "id": "730390501",
                    "speaker": "派蒙",
                    "text": "兰阿帕斯，我们回来啦！这就是「最好喝的水」！"
                },
                {
                    "id": "730390502",
                    "speaker": "兰阿帕斯",
                    "text": "#太好了！有了「最好喝的水」，一定能烧出「最好喝的汤」，那菈{NICKNAME}一定会喜欢！"
                }
            ]
        },
        {
            "id": "7303912",
            "objective": "",
            "dialogues": [
                {
                    "id": "730391201",
                    "speaker": "Black Screen",
                    "text": "依照之前派蒙想到的改善方式，指导兰那罗将菜肴完成了。\\n随后，和兰那罗一起享用…"
                },
                {
                    "id": "730391202",
                    "speaker": "派蒙",
                    "text": "怎么样？正宗的那菈美食！"
                },
                {
                    "id": "730391203",
                    "speaker": "兰帕卡提",
                    "text": "#唔…虽然是兰帕卡提提议，让那菈{NICKNAME}来指导哥哥们…"
                },
                {
                    "id": "730391204",
                    "speaker": "兰茶荼",
                    "text": "那菈的菜…这、这就是那菈的「快乐的味道」吗？"
                },
                {
                    "id": "730391205",
                    "speaker": "兰萨卡",
                    "text": "快乐都要逃走了…"
                },
                {
                    "id": "730391206",
                    "speaker": "兰阿帕斯",
                    "text": "桓那兰那的水…明明是「最好喝的水」…怎么会煮出这种东西…"
                },
                {
                    "id": "730391207",
                    "speaker": "兰非拉",
                    "text": "但是「鲜嫩无朋之果」还是一样好吃…嗯。"
                },
                {
                    "id": "730391208",
                    "speaker": "派蒙",
                    "text": "欸？怎么会这样？兰那罗都觉得难吃吗？我觉得很美味啊…"
                },
                {
                    "id": "730391209",
                    "speaker": "兰帕卡提",
                    "text": "虽然不知道什么是「难吃」…唔…很有「冲击力」的味道，像跑得太快撞到树干上一样…"
                },
                {
                    "id": "730391210",
                    "speaker": "派蒙",
                    "text": "哇…这…这一定是那菈文化和兰那罗文化的碰撞！"
                },
                {
                    "id": "730391211",
                    "speaker": "兰帕卡提",
                    "text": "#不过，哥哥们，真不好。你们要谢谢那菈{NICKNAME}才对，怎么能说这些话！"
                },
                {
                    "id": "730391212",
                    "speaker": "兰茶荼",
                    "text": "呜呜…对不起…"
                },
                {
                    "id": "730391213",
                    "speaker": "兰帕卡提",
                    "text": "不是啦！要说谢谢！"
                },
                {
                    "id": "730391214",
                    "speaker": "「哥哥们」",
                    "text": "#谢谢那菈{NICKNAME}…"
                },
                {
                    "id": "730391215",
                    "speaker": "兰帕卡提",
                    "text": "#不过…那菈{NICKNAME}和派蒙吃得开心，就好！不管那些笨蛋哥哥。只要那菈朋友开心，我们就很开心。"
                },
                {
                    "id": "730391216",
                    "speaker": "兰帕卡提",
                    "text": "#不过，那菈{NICKNAME}和那菈法留纳，一点也不一样。那菈法留纳，那时候说了好多「{M#哥哥}{F#妹妹}」的事情。"
                },
                {
                    "id": "730391217",
                    "speaker": "兰帕卡提",
                    "text": "#但是，那菈{NICKNAME}说话很少。不舒服？"
                },
                {
                    "id": "730391218",
                    "speaker": "派蒙",
                    "text": "#唔…{NICKNAME}，说点什么吧？",
                    "choices": [
                        {
                            "id": "730391219",
                            "text": "谢谢关心。",
                            "response": [
                                {
                                    "id": "730391222",
                                    "speaker": "兰帕卡提",
                                    "text": "#是这样吗？既然那菈{NICKNAME}没事就好。嗯，谢谢你们。这些小花，是兰帕卡提和哥哥们，送给那菈{NICKNAME}还有派蒙的。"
                                },
                                {
                                    "id": "730391223",
                                    "speaker": "兰帕卡提",
                                    "text": "#希望那菈{NICKNAME}和派蒙，在桓那兰那得到更多「快乐的味道」！"
                                }
                            ]
                        },
                        {
                            "id": "730391220",
                            "text": "（保持沉默）",
                            "response": [
                                {
                                    "id": "730391221",
                                    "speaker": "派蒙",
                                    "text": "#…总之，兰帕卡提不用担心！{NICKNAME}没问题的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303906",
            "objective": "",
            "dialogues": [
                {
                    "id": "730391001",
                    "speaker": "派蒙",
                    "text": "对了，这么高兴的日子，兰那罗他们都在热心为我们做吃的，「礼尚往来」，我们也做点什么吧！"
                },
                {
                    "id": "730391002",
                    "speaker": "派蒙",
                    "text": "嗯…兰那罗可能会喜欢的…那就做萝卜时蔬汤吧！嘿嘿，让兰那罗也品尝一下那菈的手艺！"
                }
            ]
        },
        {
            "id": "7303907",
            "objective": "将一份「美味的萝卜时蔬汤」交给兰帕卡提",
            "dialogues": []
        },
        {
            "id": "7303908",
            "objective": "与兰那罗一起享用大餐$HIDDEN",
            "dialogues": [
                {
                    "id": "730391224",
                    "speaker": "派蒙",
                    "text": "#嗯，还是得{NICKNAME}帮帮忙才行，不然又会做出和之前一样的菜肴呢…"
                }
            ]
        },
        {
            "id": "7303901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730390101",
                    "speaker": "兰帕卡提",
                    "text": "哥哥们已经好好反省过了，无忧节是快乐的日子，兰帕卡提不应该再生气。"
                },
                {
                    "id": "730390102",
                    "speaker": "兰萨卡",
                    "text": "对，兰帕卡提不要再生气了，快乐的日子，应该拿出「快乐的味道」来庆祝！"
                },
                {
                    "id": "730390103",
                    "speaker": "兰茶荼",
                    "text": "是时候展示「烹饪修行」的成果了。"
                },
                {
                    "id": "730390104",
                    "speaker": "兰非拉",
                    "text": "早就准备好了。"
                },
                {
                    "id": "730390105",
                    "speaker": "派蒙",
                    "text": "嗯嗯！是无忧节大餐！我期待好久了…",
                    "choices": [
                        {
                            "id": "730390106",
                            "text": "好耶！无忧节大餐！",
                            "response": [
                                {
                                    "id": "730390108",
                                    "speaker": "兰阿帕斯",
                                    "text": "有桓那兰那的水，最好的水，能做出最好的汤，那菈喝了一定满意。"
                                },
                                {
                                    "id": "730390109",
                                    "speaker": "兰帕卡提",
                                    "text": "#要把「快乐的味道」送给那菈{NICKNAME}和派蒙，应该让那菈{NICKNAME}和派蒙来「指导」哥哥们。"
                                },
                                {
                                    "id": "730390110",
                                    "speaker": "兰帕卡提",
                                    "text": "只有这样，才能做出让那菈满意的菜肴，这才是招待「客人」的「礼节」。"
                                },
                                {
                                    "id": "730390111",
                                    "speaker": "兰帕卡提",
                                    "text": "#那菈{NICKNAME}，愿意「指导」哥哥们的烹饪吗？"
                                }
                            ]
                        },
                        {
                            "id": "730390107",
                            "text": "最好不要太过期待…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303902",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730390201",
                    "speaker": "兰帕卡提",
                    "text": "#那菈{NICKNAME}，愿意「指导」哥哥们的烹饪吗？"
                }
            ]
        },
        {
            "id": "7303911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730391101",
                    "speaker": "派蒙",
                    "text": "热腾腾的萝卜时蔬汤做好咯！兰那罗他们应该也做好了吧！"
                }
            ]
        },
        {
            "id": "7303913",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730391301",
                    "speaker": "Player",
                    "text": "待会儿再说吧。"
                },
                {
                    "id": "730391302",
                    "speaker": "兰帕卡提",
                    "text": "#那菈{NICKNAME}一定要来哦。"
                }
            ]
        }
    ]
}