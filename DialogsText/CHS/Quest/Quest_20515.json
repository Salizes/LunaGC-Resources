    "talks": [
        {
            "id": "2051501",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205150101",
                    "speaker": "安东尼",
                    "text": "安娜又跑到哪去了…"
                },
                {
                    "id": "205150102",
                    "speaker": "Player",
                    "text": "又找不到安娜了？"
                },
                {
                    "id": "205150103",
                    "speaker": "安东尼",
                    "text": "对啊，我都要把全城找遍了，就是找不到。"
                },
                {
                    "id": "205150104",
                    "speaker": "安东尼",
                    "text": "你也帮我找找吧，我已经累得走不动了…",
                    "choices": [
                        {
                            "id": "205150105",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "205150106",
                                    "speaker": "安东尼",
                                    "text": "那就拜托你了，这丫头，她的病是快好了，再这么折腾下去，我就要得病了…"
                                },
                                {
                                    "id": "205150111",
                                    "speaker": "安东尼",
                                    "text": "对了…之前安娜说，她一直想去教堂感谢修女们。"
                                },
                                {
                                    "id": "205150112",
                                    "speaker": "安东尼",
                                    "text": "你不如先去教堂附近看看，还有，你可以去问问艾伯特先生…"
                                },
                                {
                                    "id": "205150113",
                                    "speaker": "安东尼",
                                    "text": "他是经常在教堂附近…呃，逗留的，说不定注意到了什么…"
                                }
                            ]
                        },
                        {
                            "id": "205150107",
                            "text": "说不定已经成了冒险家了。",
                            "response": [
                                {
                                    "id": "205150108",
                                    "speaker": "安东尼",
                                    "text": "不可能啦，不可能，怎么可能…"
                                },
                                {
                                    "id": "205150109",
                                    "speaker": "安东尼",
                                    "text": "你，你怎么突然不说话了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051502",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205150201",
                    "speaker": "安娜",
                    "text": "哎呀，修女们可真警觉，差点就被发现了。"
                },
                {
                    "id": "205150202",
                    "speaker": "Player",
                    "text": "你的身手可真好…"
                },
                {
                    "id": "205150203",
                    "speaker": "安娜",
                    "text": "哇！你怎么知道我在这的，连修女们都没发现我。"
                },
                {
                    "id": "205150204",
                    "speaker": "安娜",
                    "text": "好啦，既然被你找到了，我马上就回去了。"
                },
                {
                    "id": "205150205",
                    "speaker": "安娜",
                    "text": "我就是来这里看看风景而已啦，别担心我。"
                }
            ]
        },
        {
            "id": "2051503",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205150301",
                    "speaker": "安东尼",
                    "text": "你找到安娜了吗？"
                },
                {
                    "id": "205150302",
                    "speaker": "Player",
                    "text": "她在教堂顶上。"
                },
                {
                    "id": "205150303",
                    "speaker": "安东尼",
                    "text": "教堂顶上？那么多修女，全都没发现她吗？"
                },
                {
                    "id": "205150304",
                    "speaker": "安东尼",
                    "text": "这孩子到底是怎么办到的，难道她还真有冒险家的天赋不成…"
                },
                {
                    "id": "205150305",
                    "speaker": "安东尼",
                    "text": "我这就去把她叫下来，可不能打扰了修女们。"
                },
                {
                    "id": "205150306",
                    "speaker": "安东尼",
                    "text": "辛苦你了，这些谢礼你就收下吧。"
                }
            ]
        },
        {
            "id": "2051504",
            "objective": "与艾伯特对话$HIDDEN",
            "dialogues": [
                {
                    "id": "205150401",
                    "speaker": "艾伯特",
                    "text": "这孩子的身手可真好…"
                },
                {
                    "id": "205150402",
                    "speaker": "Player",
                    "text": "请问您见过一个女孩…"
                },
                {
                    "id": "205150403",
                    "speaker": "艾伯特",
                    "text": "你是说安娜吧，见过，她刚从我面前跑过，转了个弯就不见了。"
                },
                {
                    "id": "205150404",
                    "speaker": "艾伯特",
                    "text": "不过，我记得安娜不是一直在生病吗，偶尔还会到教堂来接受治疗。"
                },
                {
                    "id": "205150405",
                    "speaker": "艾伯特",
                    "text": "但是她这幅样子，哪里像是生病的，简直比我还有活力。到底发生了什么…"
                }
            ]
        },
        {
            "id": "2051505",
            "objective": "寻找安娜",
            "dialogues": [
                {
                    "id": "205150501",
                    "speaker": "安娜",
                    "text": "哎呀，修女们可真警觉，差点就被发现了。"
                },
