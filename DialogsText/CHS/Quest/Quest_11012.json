    "talks": [
        {
            "id": "1101201",
            "objective": "前往璃月的「玩具研究所」",
            "dialogues": [
                {
                    "id": "110120101",
                    "speaker": "「公子」",
                    "text": "就是这里了，璃月的「玩具研究所」。"
                },
                {
                    "id": "110120102",
                    "speaker": "托克",
                    "text": "到了到了！我已经听到里面机器的声音了，好酷！"
                },
                {
                    "id": "110120103",
                    "speaker": "派蒙",
                    "text": "这里究竟是什么地方，你为什么会知道这里？"
                },
                {
                    "id": "110120104",
                    "speaker": "「公子」",
                    "text": "我之前略有了解，这里应该算是「博士」的「玩具研究所」吧。"
                },
                {
                    "id": "110120105",
                    "speaker": "「公子」",
                    "text": "「博士」是愚人众的另一位「执行官」，平时偶尔有些鼓捣旧东西的…癖好。这处遗迹是被他改造了，用来研究遗迹守卫。"
                },
                {
                    "id": "110120106",
                    "speaker": "派蒙",
                    "text": "欸？遗迹守卫难道是你们愚人众制造的吗？"
                },
                {
                    "id": "110120107",
                    "speaker": "「公子」",
                    "text": "不，那种怪物和「深渊」的关系更近些，严格来说也算我们的敌人…我们只是单纯地做研究而已。"
                },
                {
                    "id": "110120108",
                    "speaker": "「公子」",
                    "text": "至于最近为什么会有遗迹守卫跑出来…大概只是因为他玩腻了，对这里失去兴趣了吧。"
                },
                {
                    "id": "110120109",
                    "speaker": "派蒙",
                    "text": "又是一个性格恶劣的执行官呢！"
                },
                {
                    "id": "110120110",
                    "speaker": "派蒙",
                    "text": "这么说，怪不得你敢带托克来这里，原来是早就做过功课了呀。"
                },
                {
                    "id": "110120111",
                    "speaker": "「公子」",
                    "text": "其实…也不算做过功课吧，这座「研究所」的内部究竟是什么样，我还完全不了解。"
                },
                {
                    "id": "110120112",
                    "speaker": "派蒙",
                    "text": "那、那你难道不在乎弟弟的安危吗？"
                },
                {
                    "id": "110120113",
                    "speaker": "「公子」",
                    "text": "怎么会…不论有什么危险，我都会替他全部接下——「哥哥」不就是这样的角色么。"
                },
                {
                    "id": "110120114",
                    "speaker": "「公子」",
                    "text": "而且连托克也能理解战斗的意义，再怎么说，这意义也在我心里沉淀了这么多年…"
                },
                {
                    "id": "110120115",
                    "speaker": "托克",
                    "text": "哥哥，你们还在聊什么？快带路呀！"
                },
                {
                    "id": "110120116",
                    "speaker": "「公子」",
                    "text": "哈哈，好，交给我吧。"
                }
            ]
        },
        {
            "id": "1101202",
            "objective": "与公子对话",
            "dialogues": []
        },
        {
            "id": "1101211",
            "objective": "进入璃月「玩具研究所」",
            "dialogues": [
                {
                    "id": "110121101",
                    "speaker": "「公子」",
                    "text": "哟。"
                },
                {
                    "id": "110121102",
                    "speaker": "派蒙",
                    "text": "「公子」？原来你在啊。刚才为什么不出来呀，非要躲在那里。"
                },
                {
                    "id": "110121103",
                    "speaker": "「公子」",
                    "text": "临别的场面，是很重要的。我现在的状态…这么虚弱的模样，要是留在了托克的记忆里，可就不好了。"
                },
                {
                    "id": "110121104",
                    "speaker": "「公子」",
                    "text": "虽然，不能亲口跟弟弟道别，确实有些可惜…"
                },
                {
                    "id": "110121105",
                    "speaker": "「公子」",
                    "text": "唉…本来应该由我亲自护送他到家里的。虽说有手下跟着，但还是有些惴惴不安啊。"
                },
                {
                    "id": "110121106",
                    "speaker": "派蒙",
                    "text": "你到底有多宠着他啊？"
                },
                {
                    "id": "110121107",
                    "speaker": "「公子」",
                    "text": "哈哈…但不知为何，把托克交给你们的时候，我都感觉很放心，明明不久之前我们还…"
                },
                {
                    "id": "110121108",
                    "speaker": "「公子」",
                    "text": "哦对了，谢礼谢礼，我差点忘了。这次的事真是多亏你们一直帮忙打圆场。"
                },
                {
                    "id": "110121109",
                    "speaker": "派蒙",
                    "text": "哇，你还算有点良心嘛！"
                },
                {
                    "id": "110121110",
                    "speaker": "「公子」",
                    "text": "还有，别忘记我们的约定，有机会一定要再好好较量一次。"
                },
                {
                    "id": "110121111",
                    "speaker": "「公子」",
                    "text": "——赌上执行官的荣誉。",
                    "choices": [
                        {
                            "id": "110121112",
                            "text": "我很期待。",
                            "response": [
                                {
                                    "id": "110121114",
                                    "speaker": "派蒙",
                                    "text": "你先养好自己的身体吧！到时候别说我们欺负你！"
                                },
                                {
                                    "id": "110121115",
                                    "speaker": "「公子」",
                                    "text": "哈哈哈…下次较量之后，不论输赢，都请你们来我家做客吧。"
                                },
                                {
                                    "id": "110121116",
                                    "speaker": "「公子」",
                                    "text": "我会把冬妮娅和安东也介绍给你们，都是我引以为豪的弟弟妹妹。"
                                },
                                {
                                    "id": "110121117",
                                    "speaker": "派蒙",
                                    "text": "好吧，就当兑现和托克的约定！"
                                },
                                {
                                    "id": "110121118",
                                    "speaker": "「公子」",
                                    "text": "哈哈，托克也一定很期待再见到你们吧，那就这么定了。我很期待…"
                                },
                                {
                                    "id": "110121119",
                                    "speaker": "「公子」",
                                    "text": "期待与你们在至冬见面的那一天。"
                                }
                            ]
                        },
                        {
                            "id": "110121113",
                            "text": "不会输给你的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1101221",
            "objective": "(test)(隐藏)关闭大门$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101212",
            "objective": "(test)(隐藏)与公子交谈I$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101203",
            "objective": "保护托克，想办法与托克汇合",
            "dialogues": [
                {
                    "id": "110121001",
                    "speaker": "「公子」",
                    "text": "呼…终于汇合了，托克，你没有哪里受伤吧？"
                },
                {
                    "id": "110121002",
                    "speaker": "托克",
                    "text": "受伤？没有呀，托克觉得可好玩了！"
                },
                {
                    "id": "110121003",
                    "speaker": "派蒙",
                    "text": "只有你一个人觉得好玩，我们都快吓死了…"
                },
                {
                    "id": "110121004",
                    "speaker": "托克",
                    "text": "前面是…好大的房间！是「独眼小宝」们的会客厅吗？"
                },
                {
                    "id": "110121005",
                    "speaker": "「公子」",
                    "text": "是啊，很宽阔的场地，不如我们来玩捉迷藏吧？"
                },
                {
                    "id": "110121006",
                    "speaker": "托克",
                    "text": "欸…现在吗？可是…"
                },
                {
                    "id": "110121007",
                    "speaker": "「公子」",
                    "text": "哥哥要给你准备一些…嗯，惊喜。"
                },
                {
                    "id": "110121008",
                    "speaker": "托克",
                    "text": "惊喜！什么惊喜？"
                },
                {
                    "id": "110121009",
                    "speaker": "「公子」",
                    "text": "等会儿托克自己去找吧？不过在这之前，你要乖乖闭上眼睛，转过身去倒数六十个数。"
                },
                {
                    "id": "110121010",
                    "speaker": "托克",
                    "text": "好吧…六十个数好长呀。"
                }
            ]
        },
        {
            "id": "1101216",
            "objective": "(test)(隐藏)刷隐形NPCI$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101213",
            "objective": "(test)(隐藏)与托克交谈I$HIDDEN",
            "dialogues": [
                {
                    "id": "110120901",
                    "speaker": "托克",
                    "text": "欸，门开了！是哥哥帮的忙吗？"
                },
                {
                    "id": "110120902",
                    "speaker": "「公子」",
                    "text": "没错，但是托克你先等等，让我确认下前面是否安全…"
                },
                {
                    "id": "110120903",
                    "speaker": "「公子」",
                    "text": "唉…要是以前没那么惯着他就好了。"
                }
            ]
        },
        {
            "id": "1101217",
            "objective": "(test)(隐藏)进入区域$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1101210",
            "objective": "(test)(隐藏)与托克交谈II$HIDDEN",
            "dialogues": [
                {
                    "id": "110120601",
                    "speaker": "「公子」",
                    "text": "托克，看到面前的大方块了吗？我需要你的帮忙。"
                },
                {
                    "id": "110120602",
                    "speaker": "托克",
                    "text": "欸~！托克能帮得上哥哥的忙了吗？"
                },
                {
                    "id": "110120603",
                    "speaker": "「公子」",
                    "text": "当然，倒数三二一，我们一起碰它。三…二…一…"
                }
            ]
        },
        {
            "id": "1101218",
