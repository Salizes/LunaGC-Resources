            "dialogues": []
        },
        {
            "id": "7501909",
            "objective": "前往圣火竞技场附近",
            "dialogues": [
                {
                    "id": "750190901",
                    "speaker": "Player",
                    "text": "让我再准备一下吧。"
                },
                {
                    "id": "750190902",
                    "speaker": "曼科",
                    "text": "嗯，准备好，我就和他说…"
                }
            ]
        },
        {
            "id": "7501902",
            "objective": "前往「回声之子」部族",
            "dialogues": []
        },
        {
            "id": "7501903",
            "objective": "与曼科对话",
            "dialogues": [
                {
                    "id": "750190301",
                    "speaker": "曼科",
                    "text": "…这件事没有商讨的余地吗？"
                },
                {
                    "id": "750190302",
                    "speaker": "帕加尔",
                    "text": "我说，曼科老兄啊，你没有听蒂图兄弟说过吗，这事情已经快五百多年没人干过啦。"
                },
                {
                    "id": "750190303",
                    "speaker": "帕加尔",
                    "text": "就算你说，找到了可能的入口…"
                },
                {
                    "id": "750190304",
                    "speaker": "帕加尔",
                    "text": "那又如何，历史中，踏上这条路的人和他们的伙伴，全都没有回来，听好了，是「一个」都没有。"
                },
                {
                    "id": "750190305",
                    "speaker": "曼科",
                    "text": "呃，恕我直言…"
                },
                {
                    "id": "750190306",
                    "speaker": "派蒙",
                    "text": "那个龙遗物研究协会的家伙在那里，旁边的那一位，好像是「回声之子」的首领？"
                },
                {
                    "id": "750190307",
                    "speaker": "派蒙",
                    "text": "喂…龙遗物研究协会的！"
                },
                {
                    "id": "750190308",
                    "speaker": "曼科",
                    "text": "#是{NICKNAME}…派蒙，还有{REALNAME[ID(2)|SHOWHOST(true)]}。"
                },
                {
                    "id": "750190309",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750190310",
                    "speaker": "帕加尔",
                    "text": "喔哦，尾巴上绑红丝巾的小嵴锋龙！好有精神的小家伙，看上去就感觉不太一样呢，来，再来一下！"
                },
                {
                    "id": "750190311",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750190312",
                    "speaker": "帕加尔",
                    "text": "#真不错，你就是{REALNAME[ID(2)|SHOWHOST(true)]}，那么，你们两个就是{REALNAME[ID(2)|SHOWHOST(true)]}选择的勇者了吧…"
                },
                {
                    "id": "750190313",
                    "speaker": "帕加尔",
                    "text": "#{NICKNAME}和派蒙，你们的名字最近出现的很频繁啊…不仅曼科老兄一直在念叨，蒂图那家伙回部族的时候也提到过。"
                },
                {
                    "id": "750190314",
                    "speaker": "帕加尔",
                    "text": "你们的最近的事迹，都已经可以算是「传说故事」啦，而且，回声之子的小家伙们也受到你很多的照顾。",
                    "choices": [
                        {
                            "id": "750190315",
                            "text": "不用太感激我。",
                            "response": [
                                {
                                    "id": "750190317",
                                    "speaker": "帕加尔",
                                    "text": "哈哈，了不起的年轻人。"
                                },
                                {
                                    "id": "750190318",
                                    "speaker": "帕加尔",
                                    "text": "曼科老兄，为了验证你的想法，就要把他们推进火坑，这可不是回声之子的待客之道。"
                                },
                                {
                                    "id": "750190319",
                                    "speaker": "帕加尔",
                                    "text": "至少这不是「我的」待客之道，我可干不出这样的事。"
                                },
                                {
                                    "id": "750190320",
                                    "speaker": "曼科",
                                    "text": "唉…"
                                },
                                {
                                    "id": "750190321",
                                    "speaker": "派蒙",
                                    "text": "你们在说什么啊，什么危险啊，火坑的？"
                                },
                                {
                                    "id": "750190322",
                                    "speaker": "曼科",
                                    "text": "抱歉，这就请让我来进行说明吧…"
                                },
                                {
                                    "id": "750190323",
                                    "speaker": "曼科",
                                    "text": "还记得之前说的吗，为了解除「焰主之祝」的标记，需要带着必须的两种信物前往火山。"
                                },
                                {
                                    "id": "750190324",
                                    "speaker": "曼科",
                                    "text": "其中一个信物就在回声之子外的遗迹…"
                                },
                                {
                                    "id": "750190325",
                                    "speaker": "帕加尔",
                                    "text": "只不过想要进入那里也有条件。"
                                },
                                {
                                    "id": "750190326",
                                    "speaker": "帕加尔",
                                    "text": "根据过往的惯例…当然了，这个惯例还是我刚刚翻织物找到的，毕竟很长时间没有人还想做这样的事。"
                                },
                                {
                                    "id": "750190327",
                                    "speaker": "帕加尔",
                                    "text": "（test）弄得我头发上全是灰尘，走在路上的时候还被搭话，「老大，你今天怎么看上去还老了十岁…」，咳咳，这个不说了…（废弃）"
                                },
                                {
                                    "id": "750190328",
                                    "speaker": "帕加尔",
                                    "text": "如果想要带自己的龙伙伴前往火山，进行洗礼，洗去「焰主之祝」，就得从各自部族首领那里取得认可…"
                                },
                                {
                                    "id": "750190329",
                                    "speaker": "帕加尔",
                                    "text": "(test)方能踏上取得信物之一的朝圣之道。（废弃）"
                                },
                                {
                                    "id": "750190330",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "(test)嗯？（废弃）"
                                },
                                {
                                    "id": "750190331",
                                    "speaker": "派蒙",
                                    "text": "(test)欸，什么叫从各自部族首领那里取得证明啊…（废弃）"
                                },
                                {
                                    "id": "750190332",
                                    "speaker": "曼科",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}是只小嵴锋龙，所以就要取得「回声之子」首领的承认。"
                                },
                                {
                                    "id": "750190333",
                                    "speaker": "派蒙",
                                    "text": "#(test)原来是这样，我们家的{REALNAME[ID(2)|SHOWHOST(true)]}是只小嵴锋龙，所以就要取得「回声之子」首领的认可…（废弃）"
                                },
                                {
                                    "id": "750190334",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190335",
                                    "speaker": "派蒙",
                                    "text": "那不就是帕加尔先生的认可嘛。"
                                },
                                {
                                    "id": "750190336",
                                    "speaker": "帕加尔",
                                    "text": "#是啊，不过说实话，这个规矩到底能不能对不是部族人的异邦人有效，我也不知道…但是，{NICKNAME}…"
                                },
                                {
                                    "id": "750190337",
                                    "speaker": "帕加尔",
                                    "text": "这几百年内，为了让自己的龙伙伴从这个血脉中的…比起祝福更像是诅咒一样的东西逃脱的勇士有很多。"
                                },
                                {
                                    "id": "750190338",
                                    "speaker": "帕加尔",
                                    "text": "但是没有一个人成功…这也是后来部族里逐渐荒弃了这一传统的缘由…"
                                },
                                {
                                    "id": "750190339",
                                    "speaker": "派蒙",
                                    "text": "欸，居然没有一个人能成功吗？"
                                },
                                {
                                    "id": "750190340",
                                    "speaker": "帕加尔",
                                    "text": "对，就是这么危险的事，而且，据说在取得信物前的试炼里，不仅是决定前往的勇士，就连龙伙伴本身都会受到考验…"
                                },
                                {
                                    "id": "750190341",
                                    "speaker": "帕加尔",
                                    "text": "虽然你们并不是部族人，但我还是不希望你们白白送死。"
                                },
                                {
                                    "id": "750190342",
                                    "speaker": "帕加尔",
                                    "text": "#所以，{NICKNAME}，我还是提议，把{REALNAME[ID(2)|SHOWHOST(true)]}留在回声之子吧。"
                                },
                                {
                                    "id": "750190343",
                                    "speaker": "帕加尔",
                                    "text": "至少我可以保证，在它进入夜神的国度之前，我会好好照顾好它。"
                                },
                                {
                                    "id": "750190344",
                                    "speaker": "派蒙",
                                    "text": "可是，可是这样的话…"
                                },
                                {
                                    "id": "750190345",
                                    "speaker": "曼科",
                                    "text": "#…就像我之前说的，{REALNAME[ID(2)|SHOWHOST(true)]}就没法长大了。"
                                },
                                {
                                    "id": "750190346",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…"
                                },
                                {
                                    "id": "750190347",
                                    "speaker": "Player",
                                    "text": "看来它不是很希望这样呢…"
                                },
                                {
                                    "id": "750190348",
                                    "speaker": "Player",
                                    "text": "我想试试看。"
                                },
                                {
                                    "id": "750190349",
                                    "speaker": "帕加尔",
                                    "text": "即使很危险，也想要试试看吗？"
                                },
                                {
                                    "id": "750190350",
                                    "speaker": "Player",
                                    "text": "嗯。"
                                },
                                {
                                    "id": "750190351",
                                    "speaker": "帕加尔",
                                    "text": "小家伙，你呢？"
                                },
                                {
                                    "id": "750190352",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190353",
                                    "speaker": "帕加尔",
                                    "text": "哈哈哈，真好，无比坚定的眼神，坚硬，却能够感受到内心的火热，真是犹如燃素岩一般的好家伙们。"
                                },
                                {
                                    "id": "750190354",
                                    "speaker": "帕加尔",
                                    "text": "好啊，那我就承认你们有前往火山朝圣的资格吧！"
                                },
                                {
                                    "id": "750190355",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190356",
                                    "speaker": "派蒙",
                                    "text": "好耶，现在我们是不是就可以去找第一个信物了。"
                                },
                                {
                                    "id": "750190357",
                                    "speaker": "曼科",
                                    "text": "不，还不行。既然已经取得资格，就要进行见证人的试炼…"
                                },
                                {
                                    "id": "750190358",
                                    "speaker": "曼科",
                                    "text": "按照古老的传统，勇者与龙，必须一起取得树林深处绿咬鹃的羽毛，献上一打兽皮…"
                                },
                                {
                                    "id": "750190359",
                                    "speaker": "曼科",
                                    "text": "必须一同为部族赢得五十场对外战斗的胜利，献上九十六颗品质上等的宝石…",
                                    "choices": [
                                        {
                                            "id": "750190360",
                                            "text": "我没有资格…",
                                            "response": [
                                                {
                                                    "id": "750190362",
                                                    "speaker": "帕加尔",
                                                    "text": "算了，曼科老兄，你说的都是哪一年的老石历了。"
                                                },
                                                {
                                                    "id": "750190363",
                                                    "speaker": "帕加尔",
                                                    "text": "那些本来就是为了培养龙和人的默契，增强他们的实力，才必须遵守的繁文缛节——我已经受够那些啦。"
                                                },
                                                {
                                                    "id": "750190364",
                                                    "speaker": "帕加尔",
                                                    "text": "#更何况，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}，看上去可并不需要用那些东西进行证明。"
                                                },
                                                {
                                                    "id": "750190365",
                                                    "speaker": "帕加尔",
                                                    "text": "#换种简单点的方法吧…{NICKNAME}，在纳塔，人们在遇到这种情况的时候有一种最方便快捷的办法——"
                                                },
                                                {
                                                    "id": "750190366",
                                                    "speaker": "帕加尔",
                                                    "text": "来和我打一场，向我证明你和你伙伴的实力吧！"
                                                },
                                                {
                                                    "id": "750190367",
                                                    "speaker": "Player",
                                                    "text": "正合我意！"
                                                },
                                                {
                                                    "id": "750190368",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750190369",
                                                    "speaker": "派蒙",
                                                    "text": "咦，要在这里开打吗…啊，难道要去舞台上打？"
                                                },
                                                {
                                                    "id": "750190370",
                                                    "speaker": "帕加尔",
                                                    "text": "当然不是，哈哈，舞台可没办法钻来钻去的…回声之子的决斗场地在后山上。"
                                                },
                                                {
                                                    "id": "750190371",
                                                    "speaker": "帕加尔",
                                                    "text": "来吧，我们去后山上痛痛快快地打一场吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750190361",
                                            "text": "能折成摩拉吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750190316",
                            "text": "（test）只是举手之劳罢了。（废弃）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501905",
            "objective": "前往决斗场地",
            "dialogues": []
        },
        {
            "id": "7501906",
            "objective": "击败帕加尔",
            "dialogues": [
                {
                    "id": "750190601",
                    "speaker": "曼科",
                    "text": "#恕我直言…虽然我明白{NICKNAME}的实力，但是还请注意。"
                },
                {
                    "id": "750190602",
                    "speaker": "曼科",
                    "text": "虽然没能够获得「古名」，不过帕加尔的实力也是不容小觑的…如果他这几年没有荒废锻炼的话。"
                },
                {
                    "id": "750190603",
                    "speaker": "曼科",
                    "text": "如果准备好与他的战斗的话，那就开始吧。"
                }
            ]
        },
        {
            "id": "7501908",
            "objective": "挑战帕加尔",
            "dialogues": [
                {
                    "id": "750190801",
                    "speaker": "Player",
                    "text": "准备好了！"
                },
                {
                    "id": "750190802",
                    "speaker": "曼科",
                    "text": "那么，请稍等，战斗即将开始。"
                }
            ]
        },
        {
            "id": "7501907",
            "objective": "与曼科对话",
            "dialogues": [
                {
                    "id": "750190701",
                    "speaker": "派蒙",
                    "text": "赢了，好耶！了不起！"
                },
                {
                    "id": "750190702",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750190703",
                    "speaker": "帕加尔",
                    "text": "哈…即使是现在部族里最强的战士，恐怕也打不赢你吧…这次还真是输得心服口服。"
                },
                {
                    "id": "750190704",
                    "speaker": "帕加尔",
                    "text": "被一只小家伙打败的感觉怎么样，老兄，看来我们还要多多锻炼啊。"
                },
                {
                    "id": "750190705",
                    "speaker": "乌丘",
                    "text": "呼呼…"
                },
                {
                    "id": "750190706",
                    "speaker": "曼科",
                    "text": "真是见证了一场精彩的决斗…"
                },
                {
                    "id": "750190707",
                    "speaker": "帕加尔",
                    "text": "曼科老兄啊，你这家伙总是在旁边说这种漂亮话，很没意思的。怎么样，要不要你也下来打一场。"
                },
                {
                    "id": "750190708",
                    "speaker": "曼科",
                    "text": "不，我就对此敬谢不敏了。"
                },
                {
                    "id": "750190709",
                    "speaker": "帕加尔",
                    "text": "#嗐。无聊的家伙。啊，真是一场爽快的战斗，你…{NICKNAME}，你的实力不是盖的。",
                    "choices": [
                        {
                            "id": "750190710",
                            "text": "我还没热身呢…",
                            "response": [
                                {
                                    "id": "750190711",
                                    "speaker": "帕加尔",
                                    "text": "哈哈哈，真是嚣张的家伙，不过，我很欣赏这种态度。强者就应该飞扬跋扈一点，不然变强又有什么意义。"
                                },
                                {
                                    "id": "750190714",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190715",
                                    "speaker": "帕加尔",
                                    "text": "#哈哈，{REALNAME[ID(2)|SHOWHOST(true)]}，看得出来你有被他们好好照顾着呢…"
                                },
                                {
                                    "id": "750190716",
                                    "speaker": "派蒙",
                                    "text": "#那是当然了，{REALNAME[ID(2)|SHOWHOST(true)]}可是我们的了不起的伙伴！"
                                },
                                {
                                    "id": "750190717",
                                    "speaker": "帕加尔",
                                    "text": "既然如此，我就放心了。"
                                },
                                {
                                    "id": "750190718",
                                    "speaker": "帕加尔",
                                    "text": "好了，说好的，部族首领的证明你们就拿去吧，就是这个。"
                                },
                                {
                                    "id": "750190719",
                                    "speaker": "帕加尔",
                                    "text": "学名叫什么来着，曼科老兄，这可是你该发言的时候了…"
                                },
                                {
                                    "id": "750190720",
                                    "speaker": "曼科",
                                    "text": "瓦萨克拉胡巴肯的护符…「盗火贤者」的护符。"
                                },
                                {
                                    "id": "750190721",
                                    "speaker": "帕加尔",
                                    "text": "嗯，这个名字我始终记不住，不过我记得，是在火龙王死去，而最初的火之神从烈焰中苏生之后…"
                                },
                                {
                                    "id": "750190722",
                                    "speaker": "帕加尔",
                                    "text": "「盗火贤者」与最初的火神，各自从火山中带走了一枚信物。取得两枚信物之人，就能进入火山内的净火，除却一切诅咒与灾厄。"
                                },
                                {
                                    "id": "750190723",
                                    "speaker": "帕加尔",
                                    "text": "不过，这个「盗火贤者」到底活了多久啊，曼科老兄，感觉从「部落」时代到奥奇卡纳塔那会儿…"
                                },
                                {
                                    "id": "750190724",
                                    "speaker": "帕加尔",
                                    "text": "就连「缝影针」那里都有他的传说。"
                                },
                                {
                                    "id": "750190725",
                                    "speaker": "曼科",
                                    "text": "毕竟是第一个会使用燃素的人类…出现在传说中的人物，不管变成什么样都有可能吧。"
                                },
                                {
                                    "id": "750190726",
                                    "speaker": "曼科",
                                    "text": "有人说他已经把身体与灵魂都燃素化了，和纳塔的风、大地与花融为了一体，能够倾听部族人向他祈求帮助的声音。"
                                },
                                {
                                    "id": "750190727",
                                    "speaker": "曼科",
                                    "text": "也有人说，其实每个时代都有不同的人继承「盗火贤者」之名，一代一代，甚至传言今日也依然有「盗火贤者」的传承者。"
                                },
                                {
                                    "id": "750190728",
                                    "speaker": "曼科",
                                    "text": "不过，恕我直言…其中大部分都是叙事人的臆测罢了。"
                                },
                                {
                                    "id": "750190729",
                                    "speaker": "帕加尔",
                                    "text": "哈哈，听到你这么说，蒂图兄弟又得生气了。"
                                },
                                {
                                    "id": "750190730",
                                    "speaker": "帕加尔",
                                    "text": "好了，我该做的已经做完了…哦不对，按照传统和惯例还得有这样的一件事…"
                                },
                                {
                                    "id": "750190731",
                                    "speaker": "帕加尔",
                                    "text": "那就是为踏上旅程的勇者，和他的伙伴献上祝福。"
                                },
                                {
                                    "id": "750190732",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "750190733",
                                    "speaker": "派蒙",
                                    "text": "哦哦，居然还有这样的仪式吗？"
                                },
                                {
                                    "id": "750190734",
                                    "speaker": "帕加尔",
                                    "text": "其实就是一些便宜讨彩头的话。"
                                },
                                {
                                    "id": "750190735",
                                    "speaker": "帕加尔",
                                    "text": "#那么，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}…"
                                },
                                {
                                    "id": "750190736",
                                    "speaker": "Player",
                                    "text": "嗯，我在这里。"
                                },
                                {
                                    "id": "750190737",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190738",
                                    "speaker": "帕加尔",
                                    "text": "祝你们能够像翎翅最硬的鸟儿那样飞过一切山巅；\\n祝你们能够像最坚强的顽石那样抵挡恶浪的奔流。"
                                },
                                {
                                    "id": "750190739",
                                    "speaker": "帕加尔",
                                    "text": "祝你们不畏艰险，因为世上注定有诸多艰险。\\n祝你们不忘彼此，因为命运之中终有离别。"
                                },
                                {
                                    "id": "750190740",
                                    "speaker": "帕加尔",
                                    "text": "祝你们能到达想要到达之处，能够得偿所愿…然后，最重要的一点，也是我最希望的一点，祝你们能够平安归来。"
                                },
                                {
                                    "id": "750190741",
                                    "speaker": "Player",
                                    "text": "我会的。"
                                },
                                {
                                    "id": "750190742",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750190743",
                                    "speaker": "派蒙",
                                    "text": "啊，那我呢，我就没有祝福吗？"
                                },
                                {
                                    "id": "750190744",
                                    "speaker": "帕加尔",
                                    "text": "对哦，小派蒙…那就祝小派蒙吃好喝好，睡觉饱饱，健康长大吧！",
                                    "choices": [
                                        {
                                            "id": "750190745",
                                            "text": "也不错呢！",
                                            "response": [
                                                {
                                                    "id": "750190748",
                                                    "speaker": "派蒙",
                                                    "text": "哼，那我就勉强接受这份祝福吧！"
                                                },
                                                {
                                                    "id": "750190749",
                                                    "speaker": "帕加尔",
                                                    "text": "好，那见证人的仪式就结束了，在你们出发之前，我还是得说：一定要小心啊。"
                                                },
                                                {
                                                    "id": "750190750",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我们知道啦，再见，帕加尔…还有乌丘。"
                                                },
                                                {
                                                    "id": "750190751",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜嗯！"
                                                },
                                                {
                                                    "id": "750190752",
                                                    "speaker": "乌丘",
                                                    "text": "唔…"
                                                },
                                                {
                                                    "id": "750190753",
                                                    "speaker": "帕加尔",
                                                    "text": "再见，祝你们一切顺利。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750190746",
                                            "text": "派蒙还能长大吗？",
                                            "response": [
                                                {
                                                    "id": "750190747",
                                                    "speaker": "派蒙",
                                                    "text": "当然能，等到以后，我一定要长成「三座山大小」的派蒙给你看！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750190712",
                            "text": "你也不赖！",
                            "response": [
                                {
                                    "id": "750190713",
                                    "speaker": "帕加尔",
                                    "text": "这种可怜人的夸奖就免了吧，不过要是我再年轻一点…谁胜谁负还不知道呢，真可惜，如果年轻时能和你打一场就好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750190103",
                    "speaker": "曼科",
                    "text": "嗯，既然已经得到了证明，那就可以去取得「盗火贤者」留下的信物了。"
                },
                {
                    "id": "750190104",
                    "speaker": "曼科",
                    "text": "那座遗迹入口离这里不远，恕我冒昧，请前往回声之子外的遗迹…"
                },
                {
                    "id": "750190105",
                    "speaker": "帕加尔",
                    "text": "这样的实力，就想前往火山，实在是有点勉强了啊。"
                }
            ]
        }
    ]
}