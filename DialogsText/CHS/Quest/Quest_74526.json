            "dialogues": [
                {
                    "id": "745260401",
                    "speaker": "妮露",
                    "text": "#啊，是{NICKNAME}，你来啦。",
                    "choices": [
                        {
                            "id": "745260402",
                            "text": "妮露，你在练习吗？",
                            "response": [
                                {
                                    "id": "745260404",
                                    "speaker": "妮露",
                                    "text": "没有没有。我正在构思一支新的舞蹈，灵感来源于雨后初晴的帕蒂沙兰，花瓣上还挂着露珠的样子。"
                                },
                                {
                                    "id": "745260405",
                                    "speaker": "妮露",
                                    "text": "不过现在还只有雏形，很多动作都还不够优美，总觉得还差了点什么…",
                                    "choices": [
                                        {
                                            "id": "745260406",
                                            "text": "听描述就已经很美了…",
                                            "response": [
                                                {
                                                    "id": "745260408",
                                                    "speaker": "妮露",
                                                    "text": "为我留影吗？可是，就像我刚才说的，这个舞步我还不是很熟练…",
                                                    "choices": [
                                                        {
                                                            "id": "745260409",
                                                            "text": "舞蹈成型前的练习…",
                                                            "response": [
                                                                {
                                                                    "id": "745260411",
                                                                    "speaker": "妮露",
                                                                    "text": "嗯，我明白了！那我就将心意融入舞步中…请用你的镜头，捕捉花朵绽放的刹那吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745260410",
                                                            "text": "也是艺术的一部分。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745260407",
                                            "text": "能让我为你拍张画片吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745260403",
                            "text": "我没有打扰到你吧？"
