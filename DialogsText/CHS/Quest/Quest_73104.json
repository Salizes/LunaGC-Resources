    "talks": [
        {
            "id": "7310416",
            "objective": "",
            "dialogues": [
                {
                    "id": "731041601",
                    "speaker": "凯万",
                    "text": "唉，请你们快去解决掉那些史莱姆吧…"
                }
            ]
        },
        {
            "id": "7310417",
            "objective": "",
            "dialogues": [
                {
                    "id": "731041701",
                    "speaker": "荷贝特",
                    "text": "这是最后一件文物了。辛苦你们找找材料，帮凯万先生完成这一钓吧。"
                }
            ]
        },
        {
            "id": "7310401",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "731040101",
                    "speaker": "荷贝特",
                    "text": "你就通融一下嘛，我是真心来求你办事的！"
                },
                {
                    "id": "731040102",
                    "speaker": "凯万",
                    "text": "没什么好说的，我不能让步，请回吧。"
                },
                {
                    "id": "731040103",
                    "speaker": "派蒙",
                    "text": "哇啊，这两人怎么吵起来了？"
                },
                {
                    "id": "731040104",
                    "speaker": "凯万",
                    "text": "哟，异乡人，能帮我说服这位小姐吗？"
                },
                {
                    "id": "731040105",
                    "speaker": "凯万",
                    "text": "今天她突然找过来，一直缠着我，说是想让我帮忙钓一批古董。"
                },
                {
                    "id": "731040106",
                    "speaker": "凯万",
                    "text": "吓跑了我的鱼不说，还想占用我接下来的时间。"
                },
                {
                    "id": "731040107",
                    "speaker": "凯万",
                    "text": "我说啊小姐，你这么心急，难道是想借这批古董发财？"
                },
                {
                    "id": "731040108",
                    "speaker": "荷贝特",
                    "text": "不是的，凯万先生，我是教令院合作方的雇员荷贝特。"
                },
                {
                    "id": "731040109",
                    "speaker": "荷贝特",
                    "text": "那些古董都是教令院搜集来用做研究的，我负责管理它们。"
                },
                {
                    "id": "731040110",
                    "speaker": "荷贝特",
                    "text": "但就在昨天，运输文物的小船出了点意外，有几件文物掉进了河里，被水流冲到了下游来。"
                },
                {
                    "id": "731040111",
                    "speaker": "凯万",
                    "text": "那你去找专业的捕捞队啊！你找我一个钓鱼的人干嘛？"
                },
                {
                    "id": "731040112",
                    "speaker": "荷贝特",
                    "text": "找捕捞队就太慢了，我之前听人介绍说，「鱼钩上的绝景」凯万先生几乎每天都能钓到失物…"
                },
                {
                    "id": "731040113",
                    "speaker": "荷贝特",
                    "text": "而且你也经常在这片流域钓鱼，所以我想要请你下杆，看看能不能把文物给…",
                    "choices": [
                        {
                            "id": "731040114",
                            "text": "完全是病急乱投医啊…",
                            "response": [
                                {
                                    "id": "731040117",
                                    "speaker": "凯万",
                                    "text": "咳咳，荷贝特小姐，我对你的遭遇表示同情，但我只是一个钓鱼的人。"
                                },
                                {
                                    "id": "731040118",
                                    "speaker": "凯万",
                                    "text": "我下杆只为了钓鱼，也只可能钓上来鱼…"
                                },
                                {
                                    "id": "731040119",
                                    "speaker": "派蒙",
                                    "text": "明明一条鱼都没钓上来过…"
                                },
                                {
                                    "id": "731040120",
                                    "speaker": "凯万",
                                    "text": "咳！我一直抱着这样的想法练习钓鱼的技巧，从没想过用这门本领干别的事。"
                                },
                                {
                                    "id": "731040121",
                                    "speaker": "凯万",
                                    "text": "所以你还是去请其他人比较好。"
                                },
                                {
                                    "id": "731040122",
                                    "speaker": "荷贝特",
                                    "text": "欸…欸？"
                                },
                                {
                                    "id": "731040123",
                                    "speaker": "荷贝特",
                                    "text": "那不然…这样好了，我不求你帮我钓到失物，只需要你换个地方钓鱼，可以吗？"
                                },
                                {
                                    "id": "731040124",
                                    "speaker": "荷贝特",
                                    "text": "你就当…就当是我付钱请你钓鱼啦！拜托你了，拜托你了！"
                                },
                                {
                                    "id": "731040125",
                                    "speaker": "凯万",
                                    "text": "我说你们啊，我可是一个渔夫啊！渔夫！",
                                    "choices": [
                                        {
                                            "id": "731040126",
                                            "text": "换一个地方钓鱼也不错。",
                                            "response": [
                                                {
                                                    "id": "731040128",
                                                    "speaker": "荷贝特",
                                                    "text": "拜托拜托，你看，我报酬都准备好了，你就帮帮我吧。"
                                                },
                                                {
                                                    "id": "731040129",
                                                    "speaker": "凯万",
                                                    "text": "真是受不了你们…行吧，就当是换个心情了。你要我在哪里钓鱼？"
                                                },
                                                {
                                                    "id": "731040130",
                                                    "speaker": "荷贝特",
                                                    "text": "太谢谢你了，跟我来就好！"
                                                },
                                                {
                                                    "id": "731040131",
                                                    "speaker": "凯万",
                                                    "text": "和之前一样，旅行者，麻烦你们帮我找找鱼饵的材料了。"
                                                },
                                                {
                                                    "id": "731040132",
                                                    "speaker": "凯万",
                                                    "text": "我想想…这次的特别材料是薄荷，不过需要从我常去的地方采集。"
                                                },
                                                {
                                                    "id": "731040133",
                                                    "speaker": "凯万",
                                                    "text": "我把大概的位置给你标注在地图上，那就拜托你了啊。等你把东西拿过来，我会给你详细算清楚报酬的。"
                                                },
                                                {
                                                    "id": "731040134",
                                                    "speaker": "凯万",
                                                    "text": "我先跟着荷贝特小姐去钓鱼点了，待会儿在那边碰头吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731040127",
                                            "text": "渔夫也会钓到各种东西啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731040115",
                            "text": "如果是凯万下杆的话，确实…",
                            "response": [
                                {
                                    "id": "731040116",
                                    "speaker": "凯万",
                                    "text": "我下杆只是为了钓到大鱼好吗！？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310402",
            "objective": "寻找凯万需要的材料",
            "dialogues": []
        },
        {
            "id": "7310403",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": [
                {
                    "id": "731040301",
                    "speaker": "凯万",
                    "text": "找到特别材料了吗？"
                }
            ]
        },
        {
            "id": "7310404",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "731040401",
                    "speaker": "凯万",
                    "text": "动作挺麻利嘛，辛苦了！"
                },
                {
                    "id": "731040402",
                    "speaker": "荷贝特",
                    "text": "请赶快开始吧，不然那些文物…呃…那些鱼都…"
                },
                {
                    "id": "731040403",
                    "speaker": "凯万",
                    "text": "别心急，要感受水流的韵律，下杆时的心态要平和。"
                },
                {
                    "id": "731040404",
                    "speaker": "凯万",
                    "text": "让我试试看吧，在这里能钓上什么大鱼…"
                },
                {
                    "id": "731040405",
                    "speaker": "Black Screen",
                    "text": "凯万制作了鱼饵，开始了垂钓"
                },
                {
                    "id": "731040406",
                    "speaker": "Black Screen",
                    "text": "漫长的等待后，凯万钓到了一个湿漉漉的包裹"
                },
                {
                    "id": "731040407",
                    "speaker": "凯万",
                    "text": "这是什么东西…"
                },
                {
                    "id": "731040408",
                    "speaker": "荷贝特",
                    "text": "这是…我，我来看看！"
                },
                {
                    "id": "731040409",
                    "speaker": "荷贝特",
                    "text": "就是这个！这是落水的文物之一！结构完好，也没有水生生物钻进去…"
                },
                {
                    "id": "731040410",
                    "speaker": "荷贝特",
                    "text": "居然能钓上来文物！您真不愧是「鱼钩上的绝景」！"
                },
                {
                    "id": "731040411",
                    "speaker": "凯万",
                    "text": "你这是夸我吗？我可是一点都高兴不起来…"
                },
                {
                    "id": "731040412",
                    "speaker": "荷贝特",
                    "text": "好，第一个地点的文物打捞完成了，接下来的…钓鱼点，就在西边不远。"
                },
                {
                    "id": "731040413",
                    "speaker": "凯万",
                    "text": "唉，快点出发吧，我还想快点回去清清静静地钓鱼呢。"
                },
                {
                    "id": "731040414",
                    "speaker": "荷贝特",
                    "text": "没问题，请跟我来吧！"
                },
                {
                    "id": "731040415",
                    "speaker": "凯万",
                    "text": "旅行者，这次的特别材料就改成香辛果吧，我的直觉告诉我，这种材料最合适。"
                },
                {
                    "id": "731040416",
                    "speaker": "凯万",
                    "text": "有个地方的香辛果特别好，我给你标注一下位置…"
                },
                {
                    "id": "731040417",
                    "speaker": "凯万",
                    "text": "我们就先动身了，在下一个钓鱼点会合吧。"
                }
            ]
        },
        {
            "id": "7310405",
            "objective": "寻找凯万需要的材料",
            "dialogues": []
        },
        {
            "id": "7310406",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": [
                {
                    "id": "731040601",
                    "speaker": "凯万",
                    "text": "你们回来了。找到特别材料了吗？"
                }
            ]
        },
        {
            "id": "7310407",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "731040701",
                    "speaker": "凯万",
                    "text": "好了，今天的第二钓开始了。"
                },
                {
                    "id": "731040702",
                    "speaker": "凯万",
                    "text": "我要集中精力，请你们别发出声音…"
                },
                {
                    "id": "731040703",
                    "speaker": "Black Screen",
                    "text": "凯万凝神开始了垂钓…"
                },
                {
                    "id": "731040704",
                    "speaker": "荷贝特",
                    "text": "呜啊！看，看那边！好多史莱姆！"
                },
                {
                    "id": "731040705",
                    "speaker": "凯万",
                    "text": "哈？！我之前可没遇见过这种情况啊！",
                    "choices": [
                        {
                            "id": "731040706",
                            "text": "交给我。",
                            "response": [
                                {
                                    "id": "731040708",
                                    "speaker": "派蒙",
                                    "text": "为什么凯万先生的钓鱼历程，会遇见这么多麻烦啊…"
                                }
                            ]
                        },
                        {
                            "id": "731040707",
                            "text": "你继续钓鱼。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310408",
            "objective": "击退突然出现的魔物",
            "dialogues": []
        },
        {
            "id": "7310409",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "731040901",
                    "speaker": "荷贝特",
                    "text": "你们可真厉害，幸亏有你们！"
                },
                {
                    "id": "731040902",
                    "speaker": "荷贝特",
                    "text": "等到找回了所有的文物，我会再申请一笔酬金，用来感谢你们。"
                },
                {
                    "id": "731040903",
                    "speaker": "凯万",
                    "text": "你真以为我钓不上真正的大鱼…"
                },
                {
                    "id": "731040904",
                    "speaker": "凯万",
                    "text": "等等，有大鱼上钩了！"
                },
                {
                    "id": "731040905",
                    "speaker": "Black Screen",
                    "text": "凯万用力提起了钓竿…"
                },
                {
                    "id": "731040906",
                    "speaker": "凯万",
                    "text": "这又是…什么东西…"
                },
                {
                    "id": "731040907",
                    "speaker": "荷贝特",
                    "text": "啊，这是另外一个文物的包裹！太好了！"
                },
                {
                    "id": "731040908",
                    "speaker": "荷贝特",
                    "text": "没想到会这么顺利，一下子就找回了两件文物！不愧是你呀，凯万先生！"
                },
                {
                    "id": "731040909",
                    "speaker": "凯万",
                    "text": "…我就不该说那句话。"
                },
                {
                    "id": "731040910",
                    "speaker": "Player",
                    "text": "鱼常有而文物不常有。"
                },
                {
                    "id": "731040911",
                    "speaker": "凯万",
                    "text": "但是我也没钓上过几条大鱼啊！"
                },
                {
                    "id": "731040912",
                    "speaker": "派蒙",
                    "text": "别垂头丧气啦，我们都成功捞起文物了，这都是好事呀。"
                },
                {
                    "id": "731040913",
                    "speaker": "荷贝特",
                    "text": "最后一个…垂钓点就在维摩庄附近，那边比较安全，我们赶紧过去吧。"
                },
                {
                    "id": "731040914",
                    "speaker": "凯万",
                    "text": "好好好，服了你了…"
                },
                {
                    "id": "731040915",
                    "speaker": "凯万",
                    "text": "真是奇了怪了，是我钓鱼的方法有问题，还是我的鱼饵有问题…"
                },
                {
                    "id": "731040916",
                    "speaker": "凯万",
                    "text": "算了，不想这些了…旅行者，这次请你去摘一些新鲜的墩墩桃吧。"
                },
                {
                    "id": "731040917",
                    "speaker": "凯万",
                    "text": "既然是最后一个地点，那我就要用出我的特制鱼饵了。"
                },
                {
                    "id": "731040918",
                    "speaker": "凯万",
                    "text": "旅行者，就麻烦你跑这一趟了。"
                }
            ]
        },
        {
            "id": "7310410",
            "objective": "寻找凯万需要的材料$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7310413",
            "objective": "寻找凯万需要的材料",
            "dialogues": [
                {
                    "id": "731041301",
                    "speaker": "荷贝特",
                    "text": "麻烦你们了。如果找到了材料，就交给凯万先生吧，好让他尽快开工。"
                }
            ]
        },
        {
            "id": "7310414",
            "objective": "寻找凯万需要的材料",
            "dialogues": [
                {
                    "id": "731041401",
                    "speaker": "荷贝特",
                    "text": "麻烦你们了。如果找到了材料，就交给凯万先生吧。我们要抓紧时间！"
                }
            ]
        },
        {
            "id": "7310415",
            "objective": "寻找凯万需要的材料",
            "dialogues": [
                {
                    "id": "731041501",
                    "speaker": "荷贝特",
                    "text": "请你们想想办法，赶走这些史莱姆吧！不然的话，打捞文物的工作就全完了！"
                }
            ]
        },
        {
            "id": "7310411",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": [
                {
                    "id": "731041101",
                    "speaker": "凯万",
                    "text": "动作挺快！找到特别材料了吗？"
                }
            ]
        },
        {
            "id": "7310412",
            "objective": "与荷贝特和凯万对话",
            "dialogues": [
                {
                    "id": "731041201",
                    "speaker": "凯万",
                    "text": "看样子一切顺利，是时候完成这最后一钓了。"
                },
                {
                    "id": "731041202",
                    "speaker": "凯万",
                    "text": "呼…这都三次了，哪怕拇指大的鱼也行，至少来条鱼咬一次我的钩吧！"
                },
                {
                    "id": "731041203",
                    "speaker": "Black Screen",
                    "text": "凯万制作了鱼饵，开始钓鱼…"
                },
                {
                    "id": "731041204",
                    "speaker": "Black Screen",
                    "text": "一段时间后，第三个湿漉漉的包裹被鱼线拉出了水面。"
                },
                {
                    "id": "731041205",
                    "speaker": "凯万",
                    "text": "你自己看吧，我不想看了…"
                },
                {
                    "id": "731041206",
                    "speaker": "荷贝特",
                    "text": "好嘞！我来看看…状态很好，没有任何破损。"
                },
                {
                    "id": "731041207",
                    "speaker": "荷贝特",
                    "text": "简直完美！凯万先生，不愧是「鱼钩上的绝景」！"
                },
                {
                    "id": "731041208",
                    "speaker": "凯万",
                    "text": "啊哈，哈哈…你能交差就好，你能交差就好…"
                },
                {
                    "id": "731041209",
                    "speaker": "派蒙",
                    "text": "居然还真的三竿把三包文物全都钓上来了，而且一次都没有鱼来咬钩…",
                    "choices": [
                        {
                            "id": "731041210",
                            "text": "这就是凯万先生厉害的地方了。",
                            "response": [
                                {
                                    "id": "731041212",
                                    "speaker": "凯万",
                                    "text": "喂！我一直可都是完全认真地想要钓上一条大鱼，完全不想钓出什么文物啊！"
                                },
                                {
                                    "id": "731041213",
                                    "speaker": "凯万",
                                    "text": "而且就算我钓技不精，甩竿无力…什么乱七八糟的…"
                                },
                                {
                                    "id": "731041214",
                                    "speaker": "凯万",
                                    "text": "我都下了这么多次竿了，就算是撞运气，也多少该钓上来几条鱼了吧？"
                                },
                                {
                                    "id": "731041215",
                                    "speaker": "凯万",
                                    "text": "到现在为止，我可是一条鱼都没有钓上来啊！"
                                },
                                {
                                    "id": "731041216",
                                    "speaker": "派蒙",
                                    "text": "唔…这么一说，确实也有些奇怪…"
                                },
                                {
                                    "id": "731041217",
                                    "speaker": "荷贝特",
                                    "text": "那个…凯万先生，如果你有兴趣的话，我可以帮你介绍一位研究钓鱼的学者喔。"
                                },
                                {
                                    "id": "731041218",
                                    "speaker": "荷贝特",
                                    "text": "现在市面上所流行的各类鱼饵和鱼竿，他都有参与过设计。"
                                },
                                {
                                    "id": "731041219",
                                    "speaker": "荷贝特",
                                    "text": "虽然不知道你钓不上来鱼到底是什么原因，但是…去找人问问总没错。"
                                },
                                {
                                    "id": "731041220",
                                    "speaker": "荷贝特",
                                    "text": "说不定，那位学者对你也会很有兴趣的。"
                                },
                                {
                                    "id": "731041221",
                                    "speaker": "凯万",
                                    "text": "对我感兴趣？你是说，对我这种「绝对不会空竿，也绝对钓不起鱼」的特质感兴趣吗？"
                                },
                                {
                                    "id": "731041222",
                                    "speaker": "凯万",
                                    "text": "不过你说得也没错，我正好借着这个机会，看看我的钓技到底是哪里出了问题。"
                                },
                                {
                                    "id": "731041223",
                                    "speaker": "荷贝特",
                                    "text": "没问题，引荐的事就交给我吧！"
                                },
                                {
                                    "id": "731041224",
                                    "speaker": "凯万",
                                    "text": "不过啊，钓鱼这种事，那种只会坐在屋子里翻书的学者们真的会懂吗？"
                                },
                                {
                                    "id": "731041225",
                                    "speaker": "凯万",
                                    "text": "喔…对了！还要谢谢你帮忙啊，旅行者，这是给你的报酬，请你收下吧。"
                                }
                            ]
                        },
                        {
                            "id": "731041211",
                            "text": "也许这是钓鱼绝技里的一种吧…"
                        }
                    ]
                }
            ]
        }
    ]
}