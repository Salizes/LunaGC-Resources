            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "3550701",
                    "speaker": "派蒙",
                    "text": "好险，差点被吹飞啦！"
                },
                {
                    "id": "3550702",
                    "speaker": "派蒙",
                    "text": "还好抓紧了你的头发，谢啦。",
                    "choices": [
                        {
                            "id": "3550703",
                            "text": "还好头发没掉。",
                            "response": [
                                {
                                    "id": "3550705",
                                    "speaker": "派蒙",
                                    "text": "刚才发生了什么？还以为要被吃掉了。"
                                },
                                {
                                    "id": "3550706",
                                    "speaker": "派蒙",
                                    "text": "肯定和那个跟龙说话的怪人有关系…",
                                    "choices": [
                                        {
                                            "id": "3550707",
                                            "text": "这个世界，居然有龙…",
                                            "response": [
                                                {
                                                    "id": "3550708",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，我明白你的担心…"
                                                },
                                                {
                                                    "id": "3550711",
                                                    "speaker": "派蒙",
                                                    "text": "欸？那是什么？"
                                                },
                                                {
                                                    "id": "3550712",
                                                    "speaker": "派蒙",
                                                    "text": "那块大石头上，闪着红光的…？"
                                                },
                                                {
                                                    "id": "3550713",
                                                    "speaker": "派蒙",
                                                    "text": "我们靠近一点看看。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3550709",
                                            "text": "跟龙说话是正常的吗？",
                                            "response": [
                                                {
                                                    "id": "3550710",
                                                    "speaker": "派蒙",
                                                    "text": "当然不正常…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3550704",
                            "text": "还好没被那条龙盯上。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "35504",
            "objective": "调查派蒙发现的东西",
            "dialogues": []
        },
        {
            "id": "35505",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "3550601",
                    "speaker": "派蒙",
                    "text": "从没见过这样的石头…没法确定它是什么。"
                },
                {
                    "id": "3550602",
                    "speaker": "派蒙",
                    "text": "只能知道它很危险。先保管起来吧。"
                },
                {
                    "id": "3550603",
                    "speaker": "派蒙",
                    "text": "嗯，回收完毕！我们赶紧离开这里。"
                }
            ]
