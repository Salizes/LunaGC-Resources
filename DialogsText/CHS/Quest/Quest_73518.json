    "talks": [
        {
            "id": "7351802",
            "objective": "回到学者身边",
            "dialogues": []
        },
        {
            "id": "7351801",
            "objective": "与两位学者对话",
            "dialogues": [
                {
                    "id": "735180101",
                    "speaker": "维纳亚克",
                    "text": "充能装置的运转果然变得更顺畅了…就像你说的，这片区域的元素环境，正在恢复正常。"
                },
                {
                    "id": "735180102",
                    "speaker": "维纳亚克",
                    "text": "…受到影响的沙虫，过段时间，应该也会平息下来吧。"
                },
                {
                    "id": "735180103",
                    "speaker": "施芮娅",
                    "text": "是是是，多亏了你的宝贝「对沙虫用杀虫炮」，现在我们可以回去交差，然后各回各家啦。"
                },
                {
                    "id": "735180104",
                    "speaker": "维纳亚克",
                    "text": "——是我们的「对沙虫用杀虫炮」，施芮娅，我从没忘记这是我们的共同作业。"
                },
                {
                    "id": "735180105",
                    "speaker": "维纳亚克",
                    "text": "…虽然当年是闹过不少矛盾，不过没有你的话，我也见不到它落地的一天。"
                },
                {
                    "id": "735180106",
                    "speaker": "施芮娅",
                    "text": "这…这种时候突然说这些干什么？想让我在报告里给你说好话吗？"
                },
                {
                    "id": "735180107",
                    "speaker": "维纳亚克",
                    "text": "唔，就是突然觉得，这几天的经历和当年还挺像的吧，吵吵闹闹又磕磕碰碰的，不过好歹也还是把问题解决了。"
                },
                {
                    "id": "735180108",
                    "speaker": "维纳亚克",
                    "text": "——而且不得不承认，最后还是你的解决方案更有效率。"
                },
                {
                    "id": "735180109",
                    "speaker": "施芮娅",
                    "text": "我…这…我也没那么厉害啦…"
                },
                {
                    "id": "735180110",
                    "speaker": "施芮娅",
                    "text": "…其实你之前说的也有道理，如果没有实际测试过「对沙虫用杀虫炮」，我也拿不到这些数据…"
                },
                {
                    "id": "735180111",
                    "speaker": "维纳亚克",
                    "text": "「修好一台机械或许只需要更换一个齿轮，但难的却是如何找到这枚齿轮…」我开始理解导师当初的评语了。"
                },
                {
                    "id": "735180112",
                    "speaker": "维纳亚克",
                    "text": "有你在真是太好了，施芮娅。"
                },
                {
                    "id": "735180113",
                    "speaker": "施芮娅",
                    "text": "唔…你也是…"
                },
                {
                    "id": "735180114",
                    "speaker": "派蒙",
                    "text": "#怎么回事？{NICKNAME}，这两个人的气氛突然变得好奇怪？",
                    "choices": [
                        {
                            "id": "735180115",
                            "text": "派蒙…",
                            "response": [
                                {
                                    "id": "735180117",
                                    "speaker": "施芮娅",
                                    "text": "咳咳！当初为了毕业设计把关系弄得那么僵，是我们都太不成熟了啊。"
                                },
                                {
                                    "id": "735180118",
                                    "speaker": "维纳亚克",
                                    "text": "是啊，回过头来想想，明明也没有什么特别严重的事…"
                                },
                                {
                                    "id": "735180119",
                                    "speaker": "施芮娅",
                                    "text": "那个——下次一块去咖啡馆喝一杯怎么样？我们可以商量一下，这次的报告要怎么写。"
                                }
                            ]
                        },
                        {
                            "id": "735180116",
                            "text": "别问了。"
                        }
                    ]
                }
            ]
        }
    ]
}