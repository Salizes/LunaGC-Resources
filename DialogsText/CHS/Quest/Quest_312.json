    "talks": [
        {
            "id": "31201",
            "objective": "(test)丽莎阅读物奖励$HIDDEN",
            "dialogues": [
                {
                    "id": "3081401",
                    "speaker": "丽莎",
                    "text": "东风之龙，南风之狮，北风之狼，西风之鹰…"
                },
                {
                    "id": "3081402",
                    "speaker": "丽莎",
                    "text": "它们是蒙德四方之风的守护者，也是风神「巴巴托斯」的眷属。"
                },
                {
                    "id": "3081403",
                    "speaker": "丽莎",
                    "text": "特瓦林——这就是风魔龙的名字。"
                },
                {
                    "id": "3081404",
                    "speaker": "丽莎",
                    "text": "在被人们称作魔龙以前，它曾是「四风守护」中的「东风之龙」。"
                },
                {
                    "id": "3081405",
                    "speaker": "丽莎",
                    "text": "这就是，四方之风的力量中，特瓦林只能借用三方的原因了。"
                },
                {
                    "id": "3081406",
                    "speaker": "丽莎",
                    "text": "从一开始，它就已经在燃尽「自己」了呀。",
                    "choices": [
                        {
                            "id": "3081407",
                            "text": "它为什么要这样做？",
                            "response": [
                                {
                                    "id": "3081409",
                                    "speaker": "丽莎",
                                    "text": "我想…是因为「恨」吧。"
                                },
                                {
                                    "id": "3081410",
                                    "speaker": "派蒙",
                                    "text": "恨…？"
                                },
                                {
                                    "id": "3081411",
                                    "speaker": "丽莎",
                                    "text": "是对蒙德的憎恨啊。"
                                },
                                {
                                    "id": "3081412",
                                    "speaker": "丽莎",
                                    "text": "以恨意为驱动、将恨意作为比风更强的力量，化作魔龙…"
                                },
                                {
                                    "id": "3081413",
                                    "speaker": "派蒙",
                                    "text": "可是，「四风守护」之一，为什么反而会…"
                                },
                                {
                                    "id": "3081414",
                                    "speaker": "派蒙",
                                    "text": "憎恨它本该守护的那座城市呢？"
                                },
                                {
                                    "id": "3081415",
                                    "speaker": "丽莎",
                                    "text": "……"
                                },
                                {
                                    "id": "3081416",
                                    "speaker": "丽莎",
                                    "text": "身为蒙德人，真难自己说出口呀。"
                                },
                                {
                                    "id": "3081417",
                                    "speaker": "丽莎",
                                    "text": "拿去看吧…这是百年前发生的故事了。"
                                }
                            ]
                        },
                        {
                            "id": "3081408",
                            "text": "它为什么要做到这种地步？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "31234",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3123402",
                    "speaker": "(test)困扰的寻宝者$UNRELEASED",
                    "text": "我终于发现了这座远古魔神遗留下来的藏宝库，但是我进不去，刚才正想起曾帮助我探索其他传说之地的勇敢冒险家，正是你！$UNRELEASED"
                },
                {
                    "id": "3123403",
                    "speaker": "(test)困扰的寻宝者$UNRELEASED",
                    "text": "藏宝库就在这条路的尽头正对着的大门背后，但是这里不知道因为什么缘故，被下了诅咒，只有携带神之眼的人才能进入，怎么样，你有兴趣帮我进去探索下么？$UNRELEASED"
                }
            ]
        }
    ]
}