            "dialogues": [
                {
                    "id": "1906203302",
                    "speaker": "阿洛瓦",
                    "text": "先！先不谈这个了！这喝完酒，才发现肚子空空呢…"
                },
                {
                    "id": "1906203303",
                    "speaker": "诺艾尔",
                    "text": "原来先生您还饿着肚子。"
                },
                {
                    "id": "1906203304",
                    "speaker": "诺艾尔",
                    "text": "这是我的失职。如果早知道这一点的话，在遇见您的时候。就应该分您一点松饼…"
                },
                {
                    "id": "1906203305",
                    "speaker": "Player",
                    "text": "别太在意了，我们去「猎鹿人」餐馆吧。"
                },
                {
                    "id": "1906203306",
                    "speaker": "阿洛瓦",
                    "text": "好，好！我们就去那儿了！"
                }
            ]
        },
