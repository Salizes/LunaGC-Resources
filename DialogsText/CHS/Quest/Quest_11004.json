        {
            "id": "1100402",
            "objective": "深入遗迹，寻找食材",
            "dialogues": []
        },
        {
            "id": "1100403",
            "objective": "与香菱交谈",
            "dialogues": [
                {
                    "id": "110040301",
                    "speaker": "香菱",
                    "text": "急冻树，急冻树，好吃的~急冻树~"
                },
                {
                    "id": "110040302",
                    "speaker": "派蒙",
                    "text": "急冻树~",
                    "choices": [
                        {
                            "id": "110040303",
                            "text": "你太捧场了吧。",
                            "response": [
                                {
                                    "id": "110040304",
                                    "speaker": "香菱",
                                    "text": "那是你太拘谨了！拿到珍稀的食材，这世界上还会有比这更开心的事吗？"
                                },
                                {
                                    "id": "110040307",
                                    "speaker": "香菱",
                                    "text": "啊，这边好像还有什么东西！"
                                },
                                {
                                    "id": "110040308",
                                    "speaker": "派蒙",
                                    "text": "这就是猎人先生说的他在追的野猪吧。"
                                },
                                {
                                    "id": "110040309",
                                    "speaker": "派蒙",
                                    "text": "但这种花纹从来没有见过…"
                                },
                                {
                                    "id": "110040310",
                                    "speaker": "香菱",
                                    "text": "我好像见过这个纹路！我想想，我想想…啊对了，是《璃月风物志》！"
                                },
                                {
                                    "id": "110040311",
                                    "speaker": "香菱",
                                    "text": "这种花纹…嗯，不会错的！这是已经灭绝了三百多年的野猪！"
                                },
                                {
                                    "id": "110040312",
                                    "speaker": "派蒙",
                                    "text": "欸？！这么长时间，但为什么会还活着？",
                                    "choices": [
                                        {
                                            "id": "110040313",
                                            "text": "因为被冻住了吧。",
                                            "response": [
                                                {
                                                    "id": "110040314",
                                                    "speaker": "派蒙",
                                                    "text": "有道理。"
                                                },
                                                {
                                                    "id": "110040317",
                                                    "speaker": "香菱",
                                                    "text": "书里讲过，这种野猪就是因为肉质太鲜美，所以被捕杀灭绝了。"
                                                },
                                                {
                                                    "id": "110040318",
                                                    "speaker": "香菱",
                                                    "text": "急冻树和野猪，捡到两个宝贝了！"
                                                },
                                                {
                                                    "id": "110040319",
                                                    "speaker": "Player",
                                                    "text": "这下胜券在握了。"
                                                },
                                                {
                                                    "id": "110040320",
                                                    "speaker": "香菱",
                                                    "text": "嗯，我们这就回清泉镇吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110040315",
                                            "text": "因为比较长寿？",
                                            "response": [
                                                {
                                                    "id": "110040316",
                                                    "speaker": "派蒙",
                                                    "text": "那也太长寿了吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110040305",
                            "text": "急冻树~",
                            "response": [
                                {
                                    "id": "110040306",
                                    "speaker": "香菱",
                                    "text": "哈哈哈，为什么你们唱出来就怪怪的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
