    "talks": [
        {
            "id": "4004001",
            "objective": "与元蓉对话",
            "dialogues": [
                {
                    "id": "400400101",
                    "speaker": "元蓉",
                    "text": "各位，走过路过来开开眼呀！欢迎试看「藏影灯」！"
                },
                {
                    "id": "400400102",
                    "speaker": "派蒙",
                    "text": "「藏影灯」？是没听过的东西呢！"
                },
                {
                    "id": "400400103",
                    "speaker": "元蓉",
                    "text": "那边两位，对我的新发明「藏影灯」有兴趣吗？是个很有趣的装置哦！"
                },
                {
                    "id": "400400104",
                    "speaker": "元蓉",
                    "text": "只要用正确的方式转动「藏影灯」内的物件，让它们的影子彼此拼合，就能看到不可思议的影像。"
                },
                {
                    "id": "400400106",
                    "speaker": "元蓉",
                    "text": "你要是感兴趣的话，不妨亲自尝试一次。装置就在这里，请试着使用吧。"
                },
                {
                    "id": "400400107",
                    "speaker": "元蓉",
                    "text": "希望「藏影灯」也能让你看到奇妙的影像。"
                },
                {
                    "id": "400400108",
                    "speaker": "派蒙",
                    "text": "听起来很有意思呀，我们也玩玩看吧！"
                }
            ]
        }
    ]
