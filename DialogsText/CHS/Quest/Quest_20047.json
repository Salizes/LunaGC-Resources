    "talks": [
        {
            "id": "2004701",
            "objective": "与杜兰对话",
            "dialogues": [
                {
                    "id": "200470101",
                    "speaker": "好奇的帕琪",
                    "text": "冒险不可能有完美的方案！这么拖下去，什么时候才能有进展？"
                },
                {
                    "id": "200470102",
                    "speaker": "杜兰",
                    "text": "就算没有完美的方案，也要做好万全的准备！"
                },
                {
                    "id": "200470103",
                    "speaker": "Player",
                    "text": "你们在吵什么呢？"
                },
                {
                    "id": "200470104",
                    "speaker": "杜兰",
                    "text": "哦，我们打算去<color=#00E1FFFF>千风神殿</color>内部探险，但帕琪小姐实在是没有冒险经验…"
                },
                {
                    "id": "200470105",
                    "speaker": "杜兰",
                    "text": "现在千风神殿里魔物横行，还有那个恐怖的遗迹守卫…贸然闯进去，只会让自己的生命安全受到威胁。"
                },
                {
                    "id": "200470106",
                    "speaker": "杜兰",
                    "text": "为了和帕琪…不是，为了保障我们的人身安全。"
                },
                {
                    "id": "200470107",
                    "speaker": "杜兰",
                    "text": "我正在说服她，制订一份万无一失的冒险计划。"
                },
                {
                    "id": "200470108",
                    "speaker": "杜兰",
                    "text": "但假如我去周围调查，说不定帕琪就会直接冲进神殿里去了。"
                },
                {
                    "id": "200470109",
                    "speaker": "杜兰",
                    "text": "我得在这看着她，请你帮我去周围调查一下吧。",
                    "choices": [
                        {
                            "id": "200470110",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "200470111",
                                    "speaker": "杜兰",
                                    "text": "太好了，要看得仔细一些啊，任何细节都会影响冒险的成败。"
                                },
                                {
                                    "id": "200470112",
                                    "speaker": "杜兰",
                                    "text": "无论发现了什么，都带回来给我吧。"
                                }
                            ]
                        },
                        {
                            "id": "200470113",
                            "text": "那我来看着帕琪小姐…",
                            "response": [
                                {
                                    "id": "200470114",
                                    "speaker": "杜兰",
                                    "text": "不，不行！旧计划里有很多细节，我要和她重新讨论…"
                                },
                                {
                                    "id": "200470115",
                                    "speaker": "杜兰",
                                    "text": "你快点去调查新线索吧，拜托了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004702",
            "objective": "前往调查遗迹",
            "dialogues": [
                {
                    "id": "200470201",
                    "speaker": "杜兰",
                    "text": "你们调查到新线索了吗？"
                },
                {
                    "id": "200470202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "200470203",
                    "speaker": "杜兰",
                    "text": "这可是关乎到我们冒险的成败，一切就拜托你了！"
                }
            ]
        },
        {
            "id": "2004703",
            "objective": "前往调查遗迹",
            "dialogues": [
                {
                    "id": "200470301",
                    "speaker": "杜兰",
                    "text": "调查到新线索了吗？"
                },
                {
                    "id": "200470302",
                    "speaker": "Player",
                    "text": "有这些发现…"
                },
                {
                    "id": "200470303",
                    "speaker": "杜兰",
                    "text": "…原来如此，原来如此。"
                },
                {
                    "id": "200470304",
                    "speaker": "Player",
                    "text": "基本上就是这样。"
                },
                {
                    "id": "200470305",
                    "speaker": "杜兰",
                    "text": "都是很有价值的线索，辛苦你了，这些就给你做谢礼吧。"
                },
                {
                    "id": "200470306",
                    "speaker": "杜兰",
                    "text": "帕琪！冒险计划又可以更新了——"
                }
            ]
        },
