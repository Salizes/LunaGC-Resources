        {
            "id": "7422501",
            "objective": "(test)福斯卡里被困$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7422502",
            "objective": "(test)和福斯卡里对话$HIDDEN",
            "dialogues": [
                {
                    "id": "742250201",
                    "speaker": "福斯卡里",
                    "text": "谢谢你，恩人。神王在上，我终于得救了！"
                },
                {
                    "id": "742250202",
                    "speaker": "福斯卡里",
                    "text": "你是守备这座城市的军团士兵吗，还是路过的正义之士？"
                },
                {
                    "id": "742250203",
                    "speaker": "福斯卡里",
                    "text": "总之自我介绍一下，我是法乌斯图斯，神王委任的边境商人。"
                },
                {
                    "id": "742250204",
                    "speaker": "福斯卡里",
                    "text": "这次是为了运送南国的香料才来到这里的，没想到刚一上岸就被这些可恶的龙蜥所围困…"
                },
                {
                    "id": "742250205",
                    "speaker": "Player",
                    "text": "龙蜥？哪有龙蜥？"
                },
                {
                    "id": "742250206",
                    "speaker": "福斯卡里",
                    "text": "嗯？丝毫不将刚刚打倒的敌人放在眼里吗，你果然是位了不起的勇士！"
                },
                {
                    "id": "742250207",
                    "speaker": "福斯卡里",
                    "text": "请收下这个吧。感谢的话就不多说了，我还得赶紧把货物运进城里呢，说不定在城里我们还会再见的。"
                }
            ]
        }
    ]
}