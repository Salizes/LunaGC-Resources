            "dialogues": []
        },
        {
            "id": "7103602",
            "objective": "与志琼对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710360201",
                    "speaker": "志琼",
                    "text": "#你好！{NICKNAME}前辈，最近过得怎样！",
                    "choices": [
                        {
                            "id": "710360202",
                            "text": "还好吧，你好些了吗？",
                            "response": [
                                {
                                    "id": "710360203",
                                    "speaker": "志琼",
                                    "text": "谢谢关心，我已经没什么问题了。实在抱歉之前让大家费心。"
                                },
                                {
                                    "id": "710360206",
                                    "speaker": "派蒙",
                                    "text": "哼，志琼你就不要到处乱跑啦！免得又像上次一样…"
                                },
                                {
                                    "id": "710360207",
                                    "speaker": "志琼",
                                    "text": "不会的，不会的。多亏了前辈的努力，层岩巨渊已经安全了许多。地质特征也变得…唔，稳定了许多。"
                                },
                                {
                                    "id": "710360208",
                                    "speaker": "志琼",
                                    "text": "不过瑾武姐和海迪夫还需要进一步分析那块神秘晶体的…那个…"
                                },
                                {
                                    "id": "710360209",
                                    "speaker": "志琼",
                                    "text": "唔，波长？海迪夫是这么说的，大概又是须弥的奇怪术语吧…总之，首先需要安置信标才能取得数据。"
                                },
                                {
                                    "id": "710360210",
                                    "speaker": "志琼",
                                    "text": "瑾武姐最近终于腾出空来把信标组装齐全了，我需要把它们安置在几个特定地点来读取读数。"
                                },
                                {
                                    "id": "710360211",
                                    "speaker": "志琼",
                                    "text": "隔一段时间后再前去回收，回收的数据就可以留给海迪夫去运算了。"
                                },
                                {
                                    "id": "710360212",
                                    "speaker": "志琼",
                                    "text": "之前由于很多区域都不安全，我们只能局限在营地内进行读数测算…"
                                },
                                {
                                    "id": "710360213",
                                    "speaker": "志琼",
                                    "text": "但现在既然通路被前辈打开了，用信标进行实地测量也就能得到更准确的数据了。"
                                },
                                {
                                    "id": "710360214",
                                    "speaker": "志琼",
                                    "text": "呼…有点事情做还是比闲着好。对了，前辈如果没有其他事情的话也请跟我一起来吧！",
                                    "choices": [
                                        {
                                            "id": "710360215",
                                            "text": "那么，我们出发吧。",
                                            "response": [
                                                {
                                                    "id": "710360216",
                                                    "speaker": "志琼",
                                                    "text": "好的，那么我们出发！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710360217",
                                            "text": "有我们什么好处吗？",
                                            "response": [
                                                {
                                                    "id": "710360218",
                                                    "speaker": "派蒙",
                                                    "text": "你这也太直接了吧！虽然我也想知道就是啦…"
                                                },
                                                {
                                                    "id": "710360219",
                                                    "speaker": "志琼",
                                                    "text": "哈哈，咱们这次只是简单的一趟来回而已，不过瑾武姐应该会感谢你的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710360204",
                            "text": "不怎么样，至少还活着。你呢？",
                            "response": [
                                {
                                    "id": "710360205",
                                    "speaker": "志琼",
                                    "text": "我还好啦…唔，也不怎么样就是了，冒险的风头都让前辈你出尽了，哈哈。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
