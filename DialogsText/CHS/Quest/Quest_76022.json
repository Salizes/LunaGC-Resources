    "talks": [
        {
            "id": "7602201",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760220101",
                    "speaker": "愤怒的武士",
                    "text": "无用的挣扎只会流血…把你的摩拉留下！"
                },
                {
                    "id": "760220102",
                    "speaker": "佩科",
                    "text": "救命！救命啊！"
                },
                {
                    "id": "760220103",
                    "speaker": "派蒙",
                    "text": "呜哇…我们得去救救他！"
                }
            ]
        },
        {
            "id": "7602204",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760220201",
                    "speaker": "派蒙",
                    "text": "喂！大块头！你在做什么！快停下！"
                },
                {
                    "id": "760220202",
                    "speaker": "愤怒的武士",
                    "text": "摩拉…不对，不对！害死阿紫的家伙…受死吧！"
                },
                {
                    "id": "760220203",
                    "speaker": "派蒙",
                    "text": "#哇啊啊！{NICKNAME}，小心！"
                }
            ]
        },
        {
            "id": "7602202",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7602203",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760220301",
                    "speaker": "佩科",
                    "text": "哎呀呀，感谢两位的救命之恩，我是游商佩科，之后两位若有机会关照我的生意，一定给两位最实惠的折扣！"
                },
                {
                    "id": "760220302",
                    "speaker": "佩科",
                    "text": "说起来今天真是倒霉，竟让我碰见这传说中的人物。"
                },
                {
                    "id": "760220303",
                    "speaker": "派蒙",
                    "text": "传说中的人物？那家伙很有名吗？"
                },
                {
                    "id": "760220304",
                    "speaker": "佩科",
                    "text": "恶名的话是有的。我也是听别的同行说的…当时他们也被吓得不行，说是再也不走这条路线了，我也是不信邪…"
                },
                {
                    "id": "760220305",
                    "speaker": "派蒙",
                    "text": "那你还真是胆大。"
                },
                {
                    "id": "760220306",
                    "speaker": "佩科",
                    "text": "我们做游商的，什么没碰见过？而且，我们有时候坐在一起，讲讲自己的故事的时候，也总容易「夸大事实」…"
                },
                {
                    "id": "760220307",
                    "speaker": "佩科",
                    "text": "说偏了…他叫「权八」，听说是在稻妻犯了什么事，逃亡来了偏乡，对了，还带着他的相好。"
                },
                {
                    "id": "760220308",
                    "speaker": "Player",
                    "text": "所以刚刚他提到的「阿紫」就是…？"
                },
                {
                    "id": "760220309",
                    "speaker": "派蒙",
                    "text": "#对哦！刚刚那个怪人和{NICKNAME}打架的时候就念叨着这个名字呢，奇奇怪怪的。"
                },
                {
                    "id": "760220310",
                    "speaker": "佩科",
                    "text": "从前就不走正路的人，哪怕到了新的地方，想要金盆洗手也没那么容易吧。没个正经营生，最后只有重蹈覆辙。"
                },
                {
                    "id": "760220311",
                    "speaker": "佩科",
                    "text": "如果他就自己一个人的话，这么个活法倒也无所谓，但刀口舔血，谁知道会得罪什么人。"
                },
                {
                    "id": "760220312",
                    "speaker": "佩科",
                    "text": "听说他那相好也是因此才丧命…反正，自从那之后，他就疯疯癫癫的啦！"
                },
                {
                    "id": "760220313",
                    "speaker": "派蒙",
                    "text": "唉…大块头抢劫摩拉是可恶，但一想到他变成现在的样子，又觉得有那么一点点可怜啦…",
                    "choices": [
                        {
                            "id": "760220314",
                            "text": "所以派蒙千万不要为了摩拉…",
                            "response": [
                                {
                                    "id": "760220315",
                                    "speaker": "派蒙",
                                    "text": "喂！重点根本不是这个啦！"
                                },
                                {
                                    "id": "760220318",
                                    "speaker": "佩科",
                                    "text": "好啦，我就不继续耽误两位的时间了，这份谢礼先请两位收下吧。"
                                }
                            ]
                        },
                        {
                            "id": "760220316",
                            "text": "如果有一天派蒙被抢劫了…",
                            "response": [
                                {
                                    "id": "760220317",
                                    "speaker": "派蒙",
                                    "text": "#哼哼，那我身边不是还有你嘛！我的摩拉，{NICKNAME}守护！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7602299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760229903",
                    "speaker": "愤怒的武士",
                    "text": "紫…紫…"
                }
            ]
        }
    ]
}