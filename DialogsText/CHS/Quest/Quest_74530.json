            "dialogues": [
                {
                    "id": "745300301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7453004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745300401",
                    "speaker": "卡齐娜",
                    "text": "啊，师父！你回来啦！",
                    "choices": [
                        {
                            "id": "745300402",
                            "text": "卡齐娜看起来很开心。",
                            "response": [
                                {
                                    "id": "745300404",
                                    "speaker": "卡齐娜",
                                    "text": "嘿嘿，我这次挖掘，找到了很不错的原矿哦！"
                                },
                                {
                                    "id": "745300405",
                                    "speaker": "卡齐娜",
                                    "text": "如果能好好打磨的话，说不定能变成闪闪发光的大宝石呢！"
                                },
                                {
                                    "id": "745300406",
                                    "speaker": "Player",
                                    "text": "太好了！"
                                },
                                {
                                    "id": "745300407",
                                    "speaker": "卡齐娜",
                                    "text": "嗯！本来前面都没什么收获，我差点就要空手而归了。"
                                },
                                {
                                    "id": "745300408",
                                    "speaker": "卡齐娜",
                                    "text": "但是我想着，要再坚持一下…所以就告诉自己，再往下挖一点，就再挖一点点…"
                                },
                                {
                                    "id": "745300409",
                                    "speaker": "卡齐娜",
                                    "text": "不知道到底重复了多少次，终于找到了这个！"
                                },
                                {
                                    "id": "745300410",
                                    "speaker": "卡齐娜",
                                    "text": "等我出来的时候，才发现太阳都快下山了…好像不小心就挖了一整天。",
                                    "choices": [
                                        {
                                            "id": "745300411",
                                            "text": "不愧是卡齐娜，真有毅力。",
                                            "response": [
                                                {
                                                    "id": "745300413",
                                                    "speaker": "卡齐娜",
                                                    "text": "呜哇，真的吗？我、我面对镜头会容易害羞…不一定能拍得好哦。"
                                                },
                                                {
                                                    "id": "745300414",
                                                    "speaker": "卡齐娜",
                                                    "text": "不过…如果是师父的请求，我会努力的！",
                                                    "choices": [
                                                        {
                                                            "id": "745300415",
                                                            "text": "你已经很努力了。",
                                                            "response": [
                                                                {
                                                                    "id": "745300417",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "嗯！我明白了。那就交给你了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745300416",
                                                            "text": "卡齐娜现在这样就很好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745300412",
                                            "text": "可以拍下闪闪发光的你吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745300403",
                            "text": "发生什么好事了吗？"
                        }
                    ]
                }
            ]
        }
    ]
}