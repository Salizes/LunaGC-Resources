            "dialogues": [
                {
                    "id": "721280801",
                    "speaker": "Player",
                    "text": "想要开宝箱。"
                },
                {
                    "id": "721280802",
                    "speaker": "阿敬",
                    "text": "只要你拿来了那种海螺就没问题。"
