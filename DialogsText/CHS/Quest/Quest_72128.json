        },
        {
            "id": "7212810",
            "objective": "",
            "dialogues": [
                {
                    "id": "721280201",
                    "speaker": "阿敬",
                    "text": "嗯？你是旅行者吗？哈哈哈，来得正好，我有一件好事告诉你。"
