            "dialogues": [
                {
                    "id": "721280501",
                    "speaker": "阿敬",
                    "text": "你已经打开宝箱了吧，哈哈哈，希望你的手气够好。"
                },
                {
                    "id": "721280502",
                    "speaker": "Player",
                    "text": "你是在搜集那种海螺吗？"
                },
                {
