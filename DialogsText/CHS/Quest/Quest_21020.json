    "talks": [
        {
            "id": "2102000",
            "objective": "阅读奇怪的信$HIDDEN",
            "dialogues": [
                {
                    "id": "210200001",
                    "speaker": "一封残破的信",
                    "text": "「…这就是所谓的『贪心不足』吧，如果只是把这个地下室里的宝藏拿走，没再想去找那个什么鬼篝火许愿，我也不会触动机关，被那个大家伙堵在这里…我是出不去了」"
                },
                {
                    "id": "210200002",
                    "speaker": "一封残破的信",
                    "text": "「如果谁有本事干掉那个大家伙进来的话，就去找那个篝火随便许个什么愿吧，嘿嘿，我会好好…祝福你的！」"
                }
            ]
        },
        {
            "id": "2102010",
            "objective": "点燃篝火",
            "dialogues": []
        },
        {
            "id": "2102020",
            "objective": "击败来敌",
            "dialogues": [
                {
                    "id": "210202001",
                    "speaker": "笔迹潦草的笔记",
                    "text": "「…什么能实现心愿的篝火，都是扯淡！但是在篝火底下，埋着的那些宝贝可是实打实的…不过大姐头说，把那纸条原样留在原地，我们就在这篝火旁等着，自然有人来自投罗网，只要篝火一燃，嘿嘿嘿，又是一笔好买卖…」"
                },
                {
                    "id": "210202002",
                    "speaker": "笔迹潦草的笔记",
                    "text": "「…不过，这么多宝贝一口气也带不走，按大姐头的意思，就先埋在<color=#00E1FFFF>翠玦坡里最高的山头上</color>，那山头上还有棵枯了的大树，大姐头应该很容易看见…」"
                }
            ]
        },
        {
            "id": "2102021",
            "objective": "阅读笔记",
            "dialogues": []
        },
        {
            "id": "2102022",
            "objective": "寻找藏宝处",
            "dialogues": [
                {
                    "id": "210202201",
                    "speaker": "Player",
                    "text": "「我想再聪明一点…」"
                },
                {
                    "id": "210202202",
                    "speaker": "祈愿的篝火",
                    "text": "「篝火突然燃烧地更加猛烈了，腾起的火焰似乎正隐隐指向着<color=#00E1FFFF>西边</color>的高山…」"
                }
            ]
        }
    ]
