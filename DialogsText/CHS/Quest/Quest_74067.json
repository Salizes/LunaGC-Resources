    "talks": [
        {
            "id": "7406701",
            "objective": "(test)靠近加油打气机组合$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7406702",
            "objective": "分别调查三个扩音机",
            "dialogues": []
        },
        {
            "id": "7406703",
            "objective": "前往扩音机提到的地点",
            "dialogues": []
        },
        {
            "id": "7406704",
            "objective": "与克兰茨对话",
            "dialogues": [
                {
                    "id": "740670401",
                    "speaker": "克兰茨",
                    "text": "又见面了。我之前和自己打赌，赌来的会不会是你们。",
                    "choices": [
                        {
                            "id": "740670402",
                            "text": "那你赢了还是输了。",
                            "response": [
                                {
                                    "id": "740670403",
                                    "speaker": "克兰茨",
                                    "text": "哈哈，赢也是我，输也是我。"
                                },
                                {
                                    "id": "740670406",
                                    "speaker": "派蒙",
                                    "text": "你为什么要用扩音机做这种事呀，被嘉维娅抓到的话，不是很麻烦吗？你很怕她，对吧？"
                                },
                                {
                                    "id": "740670407",
                                    "speaker": "克兰茨",
                                    "text": "怕她？怎么会，只是被她抓到的确很麻烦。但她大部分时间都在管理区，生产区的麻烦如果没有特别的原因，她是不想插手的。"
                                },
                                {
                                    "id": "740670408",
                                    "speaker": "克兰茨",
                                    "text": "至于为什么要用扩音机做这种事，那当然是因为这里的生活太无聊了。"
                                },
                                {
                                    "id": "740670409",
                                    "speaker": "克兰茨",
                                    "text": "我现在能理解蒂亚尔的想法了，他一定也是觉得生活太无聊了，所以总是在找乐子。说起来，我只是有样学样吧。"
                                },
                                {
                                    "id": "740670410",
                                    "speaker": "克兰茨",
                                    "text": "你们应该也有这样的朋友吧？脑子里装满了奇思妙想，偶尔也会惹出些让人啼笑皆非的乱子来的朋友。",
                                    "choices": [
                                        {
                                            "id": "740670411",
                                            "text": "有啊。",
                                            "response": [
                                                {
                                                    "id": "740670413",
                                                    "speaker": "派蒙",
                                                    "text": "我真搞不懂你，既然你觉得这里的生活无聊，又有这样的朋友，为什么不尽快离开梅洛彼得堡呢？难不成你其实是重刑犯…"
                                                },
                                                {
                                                    "id": "740670414",
                                                    "speaker": "克兰茨",
                                                    "text": "想离开的话我随时都能离开，我是自愿留在这里的。"
                                                },
                                                {
                                                    "id": "740670415",
                                                    "speaker": "克兰茨",
                                                    "text": "这里的生活比外面好多啦，风雨无忧，生活规律，也不需要思考复杂的问题。"
                                                },
                                                {
                                                    "id": "740670416",
                                                    "speaker": "克兰茨",
                                                    "text": "那个叫莉诺尔的小女孩，我真羡慕她，如果能和她换换，我一定选择不要离开这里。我宁愿不知道外面的世界。",
                                                    "choices": [
                                                        {
                                                            "id": "740670417",
                                                            "text": "那是因为你已经见过外面的世界。",
                                                            "response": [
                                                                {
                                                                    "id": "740670418",
                                                                    "speaker": "克兰茨",
                                                                    "text": "要做判断也需要材料，你说得对。"
                                                                },
                                                                {
                                                                    "id": "740670421",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是留在这里的话，不就见不到朋友了吗？除非你的朋友们也下来…"
                                                                },
                                                                {
                                                                    "id": "740670422",
                                                                    "speaker": "克兰茨",
                                                                    "text": "好消息，这对我来说不是问题。坏消息，不是问题的原因是，朋友已经不在了。"
                                                                },
                                                                {
                                                                    "id": "740670423",
                                                                    "speaker": "克兰茨",
                                                                    "text": "唉，我真不擅长这方面的话题。"
                                                                },
                                                                {
                                                                    "id": "740670424",
                                                                    "speaker": "克兰茨",
                                                                    "text": "他们还在的时候，虽然我们的研究方向不是什么热门，申请经费也很困难，但日子也谈不上难过。"
                                                                },
                                                                {
                                                                    "id": "740670425",
                                                                    "speaker": "克兰茨",
                                                                    "text": "但是后来意外和事故接踵而至，布托尔先生因病去世，中央实验室爆炸，蒂亚尔也因为这场事故丧生。"
                                                                },
                                                                {
                                                                    "id": "740670426",
                                                                    "speaker": "克兰茨",
                                                                    "text": "还有被开除的…算了，就不提他了。"
                                                                },
                                                                {
                                                                    "id": "740670427",
                                                                    "speaker": "克兰茨",
                                                                    "text": "总之尽是些我无能为力的事。但是在梅洛彼得堡，生活很简单，也没什么我应付不来的问题。"
                                                                },
                                                                {
                                                                    "id": "740670428",
                                                                    "speaker": "克兰茨",
                                                                    "text": "就算有，那也轮不到我操心，哈哈。所以，我对现在的生活没什么不满，只是偶尔想找人叙叙旧。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740670429",
                                                                            "text": "可以理解。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740670431",
                                                                                    "speaker": "克兰茨",
                                                                                    "text": "不过今天能和你们聊天也挺不错的，谢谢你们。这些特许券就送给你们了，就当是我请你们在破烂骨头商店喝了一杯。"
                                                                                },
                                                                                {
                                                                                    "id": "740670432",
                                                                                    "speaker": "克兰茨",
                                                                                    "text": "#干杯，{M#先生}{F#小姐}，还有小小的女士，笑一个吧。愿你们度过美好的一天。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740670430",
                                                                            "text": "尊重你的选择。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740670419",
                                                            "text": "不应该以轻率的态度评价他者。",
                                                            "response": [
                                                                {
                                                                    "id": "740670420",
                                                                    "speaker": "克兰茨",
                                                                    "text": "是啊，说起来，我和她也并没有多熟络，谁知道她自己是怎么想的呢。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740670412",
                                            "text": "并没有。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740670404",
                            "text": "为什么和自己打赌？",
                            "response": [
                                {
                                    "id": "740670405",
                                    "speaker": "克兰茨",
                                    "text": "好问题。不过很容易回答，因为这里没人愿意和我打这种无聊的赌。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}