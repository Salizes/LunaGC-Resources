    },
    "talks": [
        {
            "id": "2204201",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "220420101",
                    "speaker": "「寝子」",
                    "text": "真是群不听话的孩子…"
                },
                {
                    "id": "220420102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "220420103",
                    "speaker": "「寝子」",
                    "text": "是汝等啊，那群小家伙们又跑出去玩了，真是越来越不听话了…",
                    "choices": [
                        {
                            "id": "220420104",
                            "text": "要我帮什么忙？",
                            "response": [
                                {
                                    "id": "220420106",
                                    "speaker": "「寝子」",
                                    "text": "有了挂在神社外面的那些铁球，那群小家伙们应该知道怎么回来。"
                                },
                                {
                                    "id": "220420107",
                                    "speaker": "「寝子」",
                                    "text": "那群小家伙们，在外面疯一疯也好，免得到时候神社里来了人类，它们在人类面前疯玩，掉了神社的风度。"
                                },
                                {
                                    "id": "220420108",
                                    "speaker": "「寝子」",
                                    "text": "但它们要是玩得太过头…从太阳还在天上，一直饿到月亮到了天上就不好了。"
                                },
                                {
                                    "id": "220420109",
                                    "speaker": "「寝子」",
                                    "text": "汝等，帮奴家拿些鱼过去，给那群小家伙们吃吧。",
                                    "choices": [
                                        {
                                            "id": "220420110",
                                            "text": "我知道了。",
                                            "response": [
                                                {
                                                    "id": "220420111",
                                                    "speaker": "派蒙",
                                                    "text": "接下来就把地图给寝子吧。"
                                                },
                                                {
                                                    "id": "220420112",
                                                    "speaker": "「寝子」",
                                                    "text": "唔，汝还算是有点悟性…"
                                                },
                                                {
                                                    "id": "220420115",
                                                    "speaker": "「寝子」",
                                                    "text": "好了，汝等快点去吧，奴家还得在这打理神社呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220420113",
                                            "text": "这是地图…",
                                            "response": [
                                                {
                                                    "id": "220420114",
                                                    "speaker": "「寝子」",
                                                    "text": "唔，汝还算是有点悟性…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220420105",
                            "text": "我去找它们回来吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204202",
            "objective": "将鱼肉喂给小猫们",
            "dialogues": [
                {
                    "id": "220420201",
                    "speaker": "「寝子」",
                    "text": "好了，汝等快拿些鱼给那群小家伙们吃吧，奴家还得在这打理神社呢。"
                }
            ]
        },
        {
            "id": "2204203",
            "objective": "(test)检测玩家是否打猫$HIDDEN",
            "dialogues": [
                {
                    "id": "220420301",
                    "speaker": "「寝子」",
                    "text": "汝等回来了，喂过那群小家伙了吗？"
                },
                {
                    "id": "220420302",
                    "speaker": "Player",
                    "text": "喂过了。"
                },
                {
                    "id": "220420303",
                    "speaker": "「寝子」",
                    "text": "这样就好了，谢谢汝等了，要不然这群小家伙肯定又会一直疯玩，然后在野外挨饿了，谢谢汝等帮忙。"
                },
                {
                    "id": "220420304",
                    "speaker": "「寝子」",
                    "text": "唉，真是一群不听话的小家伙啊，这样子怎么能接待来神社的人类呢…"
                }
            ]
        },
        {
            "id": "2204204",
            "objective": "向寝子回报",
            "dialogues": []
        },
        {
            "id": "2204204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220420401",
                    "speaker": "「寝子」",
                    "text": "汝等回来了啊。真奇怪，那群小家伙突然都跑回来了，还一副很害怕的样子。"
                },
                {
                    "id": "220420402",
                    "speaker": "「寝子」",
                    "text": "难道，是在野外遇见了那种拿着棒子的毛茸茸人？"
                },
                {
                    "id": "220420403",
                    "speaker": "「寝子」",
                    "text": "不过，这群小家伙回来了也好…汝怎么了？"
                },
                {
                    "id": "220420404",
                    "speaker": "Player",
                    "text": "其、其实是我…"
                },
                {
                    "id": "220420405",
                    "speaker": "「寝子」",
                    "text": "…真是难捉摸的人类啊！为什么会想做这件事呢？"
                },
                {
                    "id": "220420406",
                    "speaker": "「寝子」",
                    "text": "想要和这群小家伙玩的话，就用普通的方式好了。"
                },
                {
                    "id": "220420407",
                    "speaker": "「寝子」",
                    "text": "喵！怪不得那群小家伙被吓成这样…奴家还要去安慰一下它们才好。"
                },
                {
                    "id": "220420408",
                    "speaker": "「寝子」",
                    "text": "真是的，果然不能期望所有的人类都和阿响一样…"
                }
            ]
        }
    ]
}