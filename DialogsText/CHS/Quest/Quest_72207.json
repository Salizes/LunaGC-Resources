    "talks": [
        {
            "id": "7220701",
            "objective": "在海边捡到一个带有藏宝图的海螺（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722070101",
                    "speaker": "岻伽",
                    "text": "还不够呢…还不够哟…"
                },
                {
                    "id": "722070102",
                    "speaker": "岻伽",
                    "text": "哥哥留给我的宝藏，都在海螺里哟…"
                },
                {
                    "id": "722070103",
                    "speaker": "岻伽",
                    "text": "海螺呀海螺，散落得到处都是呢…到处都是呢…"
                },
                {
                    "id": "722070104",
                    "speaker": "岻伽",
                    "text": "是哥哥的宝藏哟…我还不能离开呢…",
                    "choices": [
                        {
                            "id": "722070105",
                            "text": "宝藏…？",
                            "response": [
                                {
                                    "id": "722070107",
                                    "speaker": "岻伽",
                                    "text": "哥哥去了雾海以外的地方，祭司大人很生气…他说哥哥的灵再也回不来了…"
                                },
                                {
                                    "id": "722070108",
                                    "speaker": "岻伽",
                                    "text": "但哥哥说：「那里有好看的花，有珍珠的海…爸爸也在那里划着船，带着小妹妹招手呢…」"
                                },
                                {
                                    "id": "722070109",
                                    "speaker": "岻伽",
                                    "text": "哥哥留下了他的宝藏，就没有再回来…"
                                }
                            ]
                        },
                        {
                            "id": "722070106",
                            "text": "关于你的哥哥…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220702",
            "objective": "跟鬼魂对话（test）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220703",
            "objective": "找到所有藏宝图碎片（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722070301",
                    "speaker": "岻伽",
                    "text": "哈哈…原来哥哥的宝藏在这里呀…谢谢你。"
                },
                {
                    "id": "722070302",
                    "speaker": "岻伽",
                    "text": "虽然没办法一起去梦的土地了…但我一定会化成点点的光，回来寻找你的…"
                },
                {
                    "id": "722070303",
                    "speaker": "岻伽",
                    "text": "在陌生的地方游荡的灵，也会做梦吗…"
                }
            ]
        },
        {
            "id": "7220704",
            "objective": "找到npc对话（test）$HIDDEN",
            "dialogues": []
        },
        {
