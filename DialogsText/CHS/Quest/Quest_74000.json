            "dialogues": []
        },
        {
            "id": "7400004",
            "objective": "(test)总控环-检测3只狗成功$HIDDEN",
            "dialogues": [
                {
                    "id": "740000401",
                    "speaker": "恩肖",
                    "text": "好孩子，就靠你们把那三个不听话的坏东西带回家了。"
                }
            ]
        },
        {
            "id": "7400012",
            "objective": "（test）隐藏小女孩$HIDDEN",
            "dialogues": [
                {
                    "id": "740001201",
                    "speaker": "莉诺尔",
                    "text": "原来这就是卡特哥哥说的，我不知道的我的家。"
                },
                {
                    "id": "740001202",
                    "speaker": "恩肖",
                    "text": "欢迎回家，孩子，不管怎么说，回来就好…"
                }
            ]
        },
        {
            "id": "7400015",
            "objective": "与恩肖对话",
            "dialogues": [
                {
                    "id": "740000601",
                    "speaker": "派蒙",
                    "text": "本以为是更轻松的任务，没想到它们这么任性…"
                },
                {
                    "id": "740000602",
                    "speaker": "恩肖",
                    "text": "好孩子，现在你应该知道了，越是任性就越得让它们知道规矩。",
                    "choices": [
                        {
                            "id": "740000603",
                            "text": "不能踩花的规矩倒是记住了…",
                            "response": [
                                {
                                    "id": "740000604",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}要是也能飞就好了，脚踏实地可真辛苦呀。"
                                },
                                {
                                    "id": "740000607",
                                    "speaker": "恩肖",
                                    "text": "既然累了，就休息一会儿再走。正好做了塔塞斯杂烩，你们也来尝尝吧。"
                                },
                                {
                                    "id": "740000608",
                                    "speaker": "派蒙",
                                    "text": "有好吃的吗！啊…可、可是这样不好吧…要不还是算了。"
                                },
                                {
                                    "id": "740000609",
                                    "speaker": "恩肖",
                                    "text": "怎么，难道是信不过我的手艺？不说别的，塔塞斯杂烩可是我的拿手菜。"
                                },
                                {
                                    "id": "740000610",
                                    "speaker": "派蒙",
                                    "text": "我的意思是，这样会不会也算是不守规矩…"
                                },
                                {
                                    "id": "740000611",
                                    "speaker": "恩肖",
                                    "text": "你们付出了劳动，这是你们应得的。吃饱了才有力气继续劳动。对了，你们是冒险家…那更应该多吃点。"
                                },
                                {
                                    "id": "740000612",
                                    "speaker": "恩肖",
                                    "text": "还有正式委托的报酬，之后会支付给你们。这是合乎委托的规矩的吧。"
                                },
                                {
                                    "id": "740000613",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，既然是这样，那我们就不客气啦！"
                                },
                                {
                                    "id": "740000614",
                                    "speaker": "Black Screen",
                                    "text": "被老人邀请至屋内，享用了并不精致的塔塞斯杂烩。炖菜的暖意沁入心脾，感觉疲惫也被一扫而空…"
                                },
                                {
                                    "id": "740000615",
                                    "speaker": "派蒙",
                                    "text": "劳动之后的料理总是格外美味呢！而且塔塞斯杂烩该怎么说呢，很有家庭的味道？"
                                },
                                {
                                    "id": "740000616",
                                    "speaker": "Player",
                                    "text": "因为食材和料理方法都很普通吧。"
                                },
                                {
                                    "id": "740000617",
                                    "speaker": "派蒙",
                                    "text": "普通但是好吃！"
                                },
                                {
                                    "id": "740000618",
                                    "speaker": "恩肖",
                                    "text": "那当然了，我们家的倔丫头也对这道菜赞不绝口。就算是闹别扭，只要闻到炖菜的香气，一定乖乖到餐厅坐下。"
                                },
                                {
                                    "id": "740000619",
                                    "speaker": "恩肖",
                                    "text": "现在嘛，她走得太远了，闻不到了。多半是连回家的路该怎么走也忘得一干二净了。"
                                },
                                {
                                    "id": "740000620",
                                    "speaker": "派蒙",
                                    "text": "这…对了，我们也可以帮忙找人的，恩肖爷爷要是愿意给我们讲讲她的特征，说不定我们能帮你找到她呢。"
                                },
                                {
                                    "id": "740000621",
                                    "speaker": "Player",
                                    "text": "如果在旅途中遇到的话。"
                                },
                                {
                                    "id": "740000622",
                                    "speaker": "恩肖",
                                    "text": "好心的孩子，谢谢你们。我要找她倒不是难事，毕竟之前她也托人送了几封信回来。"
                                },
                                {
                                    "id": "740000623",
                                    "speaker": "恩肖",
                                    "text": "不过我看她是完全不觉得自己有错，不然怎么会只寄信，而不是自己回家？"
                                },
                                {
                                    "id": "740000624",
                                    "speaker": "恩肖",
                                    "text": "所以她的信我是一个字也没看，拆也没拆。动物不懂事便罢了，她可是个大姑娘了，她也不懂吗？"
                                },
                                {
                                    "id": "740000625",
                                    "speaker": "恩肖",
                                    "text": "说起来，最近也没再收到她的信…大概是知道自讨没趣了吧。"
                                },
                                {
                                    "id": "740000626",
                                    "speaker": "恩肖",
                                    "text": "总之，我可不会专门雇人找到她再带她回家。要么她自己回家认错，要么就再也别回来了。"
                                },
                                {
                                    "id": "740000627",
                                    "speaker": "派蒙",
                                    "text": "好、好吧…既然你这样说…"
                                },
                                {
                                    "id": "740000628",
                                    "speaker": "恩肖",
                                    "text": "不管怎么说，谢谢你们帮忙把勇士它们几个带回来。虽然报酬不多…这里还有些塔塞斯杂烩，给你们带上。"
                                },
                                {
                                    "id": "740000629",
                                    "speaker": "恩肖",
                                    "text": "冒险家经常要在野外露宿吧？记得吃饱穿暖，别饿着冻着了。"
                                },
                                {
                                    "id": "740000630",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯！恩肖爷爷也要快些把腿伤养好呀。"
                                },
                                {
                                    "id": "740000631",
                                    "speaker": "恩肖",
                                    "text": "注意安全，照顾好自己！"
                                }
                            ]
                        },
                        {
                            "id": "740000605",
                            "text": "看来应该给派蒙也立一些规矩。",
                            "response": [
                                {
                                    "id": "740000606",
                                    "speaker": "派蒙",
                                    "text": "我哪有很任性…不对！我可不是什么不听话的宠物狗啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7400016",
            "objective": "与恩肖对话",
            "dialogues": [
                {
                    "id": "740000701",
                    "speaker": "派蒙",
                    "text": "这任务…比想象中麻烦欸。"
                },
                {
                    "id": "740000702",
                    "speaker": "莉诺尔",
                    "text": "因为花园里的巨人真的很爱那些紫色的小花，而且总是有很多规矩嘛。"
                },
                {
                    "id": "740000703",
                    "speaker": "恩肖",
                    "text": "不听话的孩子就该早点学会守规矩，免得长大了更难管教。",
                    "choices": [
                        {
                            "id": "740000704",
                            "text": "派蒙，听到了吗？",
                            "response": [
                                {
                                    "id": "740000705",
                                    "speaker": "派蒙",
                                    "text": "欸？关我什么事呀，我可不是不听话的小孩，哼。"
                                },
                                {
                                    "id": "740000708",
                                    "speaker": "恩肖",
                                    "text": "你们都玩累了吧？正好今天也做了塔塞斯杂烩，一起坐下吃点吧。"
                                },
                                {
                                    "id": "740000709",
                                    "speaker": "莉诺尔",
                                    "text": "#是呀是呀！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们一起吃吧！"
                                },
                                {
                                    "id": "740000710",
                                    "speaker": "派蒙",
                                    "text": "#好欸！既然莉诺尔都这么说了，{NICKNAME}，我们就不要推辞了吧，嘿嘿。"
                                },
                                {
                                    "id": "740000711",
                                    "speaker": "Player",
                                    "text": "那就感谢招待了。"
                                },
                                {
                                    "id": "740000712",
                                    "speaker": "恩肖",
                                    "text": "你们是莉诺尔的朋友， 客气什么。"
                                },
                                {
                                    "id": "740000713",
                                    "speaker": "Black Screen",
                                    "text": "被邀请到室内，享用了并不精致但十分美味的塔塞斯杂烩。\\n席间，分享了一些旅途的见闻，引得老人啧啧称奇，少女咯咯发笑。\\n在谈笑声中度过了一段欢乐的时光…"
                                },
                                {
                                    "id": "740000714",
                                    "speaker": "莉诺尔",
                                    "text": "怎么样？外公的手艺是不是胜过韦尔赛叔叔？",
                                    "choices": [
                                        {
                                            "id": "740000715",
                                            "text": "确实。",
                                            "response": [
                                                {
                                                    "id": "740000718",
                                                    "speaker": "莉诺尔",
                                                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，你们知道吗？我也有帮忙喔！"
                                                },
                                                {
                                                    "id": "740000719",
                                                    "speaker": "莉诺尔",
                                                    "text": "虽然现在还只是帮一点点小忙，但是外公说了，只要多练，总有一天我也可以做出那么美味的塔塞斯杂烩的。"
                                                },
                                                {
                                                    "id": "740000720",
                                                    "speaker": "莉诺尔",
                                                    "text": "#哼哼，到时一定让{M#哥哥姐姐}{F#姐姐们}也尝尝我的手艺！"
                                                },
                                                {
                                                    "id": "740000721",
                                                    "speaker": "派蒙",
                                                    "text": "那我们约好了！真让人期待呀。"
                                                },
                                                {
                                                    "id": "740000722",
                                                    "speaker": "派蒙",
                                                    "text": "话说回来，我们叨扰了这么久，也该告辞了。"
                                                },
                                                {
                                                    "id": "740000723",
                                                    "speaker": "莉诺尔",
                                                    "text": "欸——这就走吗？"
                                                },
                                                {
                                                    "id": "740000724",
                                                    "speaker": "恩肖",
                                                    "text": "#莉诺尔，听话，{M#他们}{F#她们}也有自己的事要做，不可能一直陪你玩的。"
                                                },
                                                {
                                                    "id": "740000725",
                                                    "speaker": "莉诺尔",
                                                    "text": "唔…好吧。"
                                                },
                                                {
                                                    "id": "740000726",
                                                    "speaker": "派蒙",
                                                    "text": "别这么难过嘛，以后有机会的话，一定还会再见面的！"
                                                },
                                                {
                                                    "id": "740000727",
                                                    "speaker": "莉诺尔",
                                                    "text": "真的吗？那下次见面的时候，卡特哥哥也会一起吗？"
                                                },
                                                {
                                                    "id": "740000728",
                                                    "speaker": "派蒙",
                                                    "text": "这个嘛…应该也不是完全没可能吧！"
                                                },
                                                {
                                                    "id": "740000729",
                                                    "speaker": "莉诺尔",
                                                    "text": "好喔，那在下次见面之前，我会准备很多很多精彩的故事，到时讲给你们听。"
                                                },
                                                {
                                                    "id": "740000730",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，他肯定也很期待莉诺尔的故事。"
                                                },
                                                {
                                                    "id": "740000731",
                                                    "speaker": "恩肖",
                                                    "text": "好孩子，谢谢你们来看莉诺尔，还陪她玩闹。这里还有些塔塞斯杂烩，你们带在路上吃吧。"
                                                },
                                                {
                                                    "id": "740000732",
                                                    "speaker": "恩肖",
                                                    "text": "冒险家经常要在野外露宿吧？记得吃饱穿暖，别饿着冻着了。"
                                                },
                                                {
                                                    "id": "740000733",
                                                    "speaker": "派蒙",
                                                    "text": "知道啦！恩肖爷爷和莉诺尔也要照顾好自己哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740000716",
                                            "text": "感觉都差不多…",
                                            "response": [
                                                {
                                                    "id": "740000717",
                                                    "speaker": "派蒙",
                                                    "text": "我觉得还是恩肖爷爷做的塔塞斯杂烩比较美味欸，该怎么说呢，很有家庭的味道？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740000706",
                            "text": "把不听话的小孩都关进花园。",
                            "response": [
                                {
                                    "id": "740000707",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，可是我根本不会踩到花，而且不需要女巫帮忙就可以飞过高墙哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7400018",
            "objective": "（test）回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
