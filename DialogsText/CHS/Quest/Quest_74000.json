    "talks": [
        {
            "id": "7400001",
            "objective": "（test）和老头对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740000101",
                    "speaker": "？？？",
                    "text": "坏东西…你们这些不听话的坏东西！最好是再跑远点，跑去山的那一边，跑进城里的小巷，跑到我看不见的地方去！"
                },
                {
                    "id": "740000102",
                    "speaker": "派蒙",
                    "text": "发、发生什么事了？"
                },
                {
                    "id": "740000103",
                    "speaker": "？？？",
                    "text": "哼…没什么大不了的，勇士又逃跑了，常有的事。上次也是一听到「检查」两个字就往外跑…"
                },
                {
                    "id": "740000104",
                    "speaker": "？？？",
                    "text": "这次是王子和公主也跟着跑了，要不是前阵子照顾花田时被绊了脚，腿伤还没好，要治它们三个根本不费工夫。"
                },
                {
                    "id": "740000105",
                    "speaker": "？？？",
                    "text": "你们是登山客吗？如果要找地方歇脚，可以先去屋里坐会儿。等我把那三个不听话的坏东西抓回来再来招呼你们。",
                    "choices": [
                        {
                            "id": "740000106",
                            "text": "是，我们立志征服提瓦特每座高山。",
                            "response": [
                                {
                                    "id": "740000107",
                                    "speaker": "派蒙",
                                    "text": "这是什么时候立下的志向，我怎么完全没听说过？"
                                },
                                {
                                    "id": "740000110",
                                    "speaker": "派蒙",
                                    "text": "#还是正经介绍一下吧！我是派蒙，{M#他}{F#她}是{NICKNAME}。我们是冒险家，要论找人的经验还是很丰富的。"
                                },
                                {
                                    "id": "740000111",
                                    "speaker": "派蒙",
                                    "text": "老爷爷要是腿脚不方便的话，找人的工作就交给我们吧。"
                                },
                                {
                                    "id": "740000112",
                                    "speaker": "？？？",
                                    "text": "冒险家…你们怎么不穿那套绿色制服？"
                                },
                                {
                                    "id": "740000113",
                                    "speaker": "派蒙",
                                    "text": "也不是所有人都必须穿那套衣服啦，应该说…我们是经验丰富的冒险家，所以可以自己决定穿什么。"
                                },
                                {
                                    "id": "740000114",
                                    "speaker": "？？？",
                                    "text": "唔。原来是这样。经验丰富的冒险家，报酬也应该给得更多一些才合道理。"
                                },
                                {
                                    "id": "740000115",
                                    "speaker": "恩肖",
                                    "text": "好孩子，两个好孩子，叫我恩肖吧。你们愿意帮忙，那就再好不过了。"
                                },
                                {
                                    "id": "740000116",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，是要找人吗？我记得是勇士、王子和公主？听起来不像是普通名字…难道是小孩子的昵称什么的？"
                                },
                                {
                                    "id": "740000117",
                                    "speaker": "恩肖",
                                    "text": "是狗。"
                                },
                                {
                                    "id": "740000118",
                                    "speaker": "派蒙",
                                    "text": "哦，是狗啊。"
                                },
                                {
                                    "id": "740000119",
                                    "speaker": "派蒙",
                                    "text": "…欸？原来是狗的名字吗？该、该怎么说呢，真是充满童趣的名字…"
                                },
                                {
                                    "id": "740000120",
                                    "speaker": "恩肖",
                                    "text": "是女儿起的名字。当初要不是她又哭又闹，我可不会养这么娇贵的动物。"
                                },
                                {
                                    "id": "740000121",
                                    "speaker": "恩肖",
                                    "text": "还是狗崽的时候倒是傻乎乎的有几分可爱，长大了就变成不听话的坏东西。只是加点管束，马上就反抗、逃跑。"
                                },
                                {
                                    "id": "740000122",
                                    "speaker": "恩肖",
                                    "text": "虽然没跑多远，但不管怎么说，得把它们找回来。堂堂勇士，居然害怕检查牙齿…真是笑话。",
                                    "choices": [
                                        {
                                            "id": "740000123",
                                            "text": "肚子饿了自然就会回来了吧？",
                                            "response": [
                                                {
                                                    "id": "740000124",
                                                    "speaker": "派蒙",
                                                    "text": "也有可能从此觉醒了血脉中的野性，回归山林之后成为顶级的捕食者！感觉会是很精彩的故事呢。"
                                                },
                                                {
                                                    "id": "740000127",
                                                    "speaker": "恩肖",
                                                    "text": "不行，规矩就是规矩。放任一次就会有两次三次，一旦学坏，再想改好就难了。"
                                                },
                                                {
                                                    "id": "740000128",
                                                    "speaker": "派蒙",
                                                    "text": "可、可是它们只是小狗对吧？真的有必要对它们这么严格吗…"
                                                },
                                                {
                                                    "id": "740000129",
                                                    "speaker": "恩肖",
                                                    "text": "毕竟有个坏榜样。蠢丫头几年前离开家就再也没回来，勇士它们几个要是有样学样，我倒是省事了！"
                                                },
                                                {
                                                    "id": "740000130",
                                                    "speaker": "恩肖",
                                                    "text": "不过等傻姑娘哪天回家，发现以前哭着闹着要养的狗全跑了，肯定又得哭哭啼啼好一阵。虽然都是她自找的。",
                                                    "choices": [
                                                        {
                                                            "id": "740000131",
                                                            "text": "（听起来像是家庭矛盾。）",
                                                            "response": [
                                                                {
                                                                    "id": "740000133",
                                                                    "speaker": "派蒙",
                                                                    "text": "好吧…总之，只要把它们带回来就好？让它们都回窝。"
                                                                },
                                                                {
                                                                    "id": "740000134",
                                                                    "speaker": "恩肖",
                                                                    "text": "…对，山林很危险。到了夜里就更危险。它们自己不懂，它们是娇贵的动物，就算不喜欢，家里总归是安全的。"
                                                                },
                                                                {
                                                                    "id": "740000135",
                                                                    "speaker": "恩肖",
                                                                    "text": "勇士跑远了，往北边去了。已经是条老狗了，还是这么贪玩。"
                                                                },
                                                                {
                                                                    "id": "740000136",
                                                                    "speaker": "恩肖",
                                                                    "text": "而且看到路边有吃的就走不动路，千万不要可怜它，否则吃坏了最后可有它受的。"
                                                                },
                                                                {
                                                                    "id": "740000137",
                                                                    "speaker": "恩肖",
                                                                    "text": "它要是耍性子不肯动，你们要狠心一点，<color=#00E1FFFF>把来路不明的吃食拿走</color>，这样它就知道要回家了。"
                                                                },
                                                                {
                                                                    "id": "740000138",
                                                                    "speaker": "恩肖",
                                                                    "text": "另外两个坏东西倒是没跑远，在花园里胡闹，只要让它们回窝就好了。"
                                                                },
                                                                {
                                                                    "id": "740000139",
                                                                    "speaker": "派蒙",
                                                                    "text": "#委托内容听起来很简单嘛，就交给我和{NICKNAME}好了。恩肖爷爷就在这儿稍等一会儿吧，我们去去就回！"
                                                                },
                                                                {
                                                                    "id": "740000140",
                                                                    "speaker": "恩肖",
                                                                    "text": "<color=#00E1FFFF>围墙里边的花，可要注意点，不要踩坏了。</color>"
                                                                },
                                                                {
                                                                    "id": "740000141",
                                                                    "speaker": "派蒙",
                                                                    "text": "#知道啦！我们会小心的。<color=#00E1FFFF>不要踩到花</color>，对吧？我就不用说了，{NICKNAME}也是很灵巧的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740000132",
                                                            "text": "（还是别多问了吧。）"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740000125",
                                            "text": "可能在外边玩到天黑就会回来了。",
                                            "response": [
                                                {
                                                    "id": "740000126",
                                                    "speaker": "派蒙",
                                                    "text": "毕竟金窝银窝都不如自己的狗窝嘛。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740000108",
                            "text": "只是路过而已。",
                            "response": [
                                {
                                    "id": "740000109",
                                    "speaker": "派蒙",
                                    "text": "绝对不会因为「山就在那里」这样的理由就改变原本的目标！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7400002",
            "objective": "（test）计时$HIDDEN",
            "dialogues": [
                {
                    "id": "740000201",
                    "speaker": "莉诺尔",
                    "text": "#哇！是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐！"
                },
                {
                    "id": "740000202",
                    "speaker": "派蒙",
                    "text": "莉诺尔，还有恩肖爷爷，你们好呀。"
                },
                {
                    "id": "740000203",
                    "speaker": "Player",
                    "text": "在新家过得还习惯吗？"
                },
                {
                    "id": "740000204",
                    "speaker": "莉诺尔",
                    "text": "#不对，不对，{NICKNAME}{M#哥哥}{F#姐姐}真糊涂，这里不是新家，是老家。卡特哥哥也是这么说的，不是吗？"
                },
                {
                    "id": "740000205",
                    "speaker": "莉诺尔",
                    "text": "外公做的塔塞斯杂烩可好吃了！我也在跟外公学怎么做，但是要学会还要花些时间…"
                },
                {
                    "id": "740000206",
                    "speaker": "恩肖",
                    "text": "时间还多得是，你慢慢学就好。"
                },
                {
                    "id": "740000207",
                    "speaker": "恩肖",
                    "text": "对了，好孩子，「卡特哥哥」没和你们一起吗？之前没能向他本人道谢…"
                },
                {
                    "id": "740000208",
                    "speaker": "派蒙",
                    "text": "他还有别的事要忙，我们就暂时分开了。"
                },
                {
                    "id": "740000209",
                    "speaker": "恩肖",
                    "text": "这样啊，真遗憾。"
                },
                {
                    "id": "740000210",
                    "speaker": "莉诺尔",
                    "text": "派蒙姐姐，你说他是不是已经把我给忘记了…"
                },
                {
                    "id": "740000211",
                    "speaker": "派蒙",
                    "text": "怎么会！他只是现在暂时抽不开身…"
                },
                {
                    "id": "740000212",
                    "speaker": "派蒙",
                    "text": "唔…你们不是约好了吗？下次见面的时候，他会讲完上次没讲完的故事，你也会准备很多精彩的故事和他分享吧？"
                },
                {
                    "id": "740000213",
                    "speaker": "莉诺尔",
                    "text": "嗯…可是…"
                },
                {
                    "id": "740000214",
                    "speaker": "恩肖",
                    "text": "咳，说起来勇士那家伙又不知道跑到哪里去了。莉诺尔，听话，帮外公一个忙，把勇士带回家吧。"
                },
                {
                    "id": "740000215",
                    "speaker": "恩肖",
                    "text": "它肯定在外边玩得脏兮兮的，把它带回来给它洗个澡。"
                },
                {
                    "id": "740000216",
                    "speaker": "莉诺尔",
                    "text": "欸——就让它在外面玩嘛，老是待在窝里多没意思呀。"
                },
                {
                    "id": "740000217",
                    "speaker": "恩肖",
                    "text": "万一它跑远了不回来了，或者被森林里的怪物给抓走了回不来了，到时你可别哭哭啼啼的。"
                },
                {
                    "id": "740000218",
                    "speaker": "莉诺尔",
                    "text": "呜…那、那还是带它回来洗澡吧！"
                },
                {
                    "id": "740000219",
                    "speaker": "恩肖",
                    "text": "正好，王子和公主这会儿正在花园里玩闹，让它们也回窝吧。它俩肯定也是一身泥，待会儿我给它们好好洗洗。"
                },
                {
                    "id": "740000220",
                    "speaker": "莉诺尔",
                    "text": "#好喔。那{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐先休息一下，等我回来！"
                },
                {
                    "id": "740000221",
                    "speaker": "派蒙",
                    "text": "不如我们一起去吧，就像在梅洛彼得堡时我们一起探险那样。"
                },
                {
                    "id": "740000222",
                    "speaker": "莉诺尔",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐要和我一起探险吗？那太好啦！"
                },
                {
                    "id": "740000223",
                    "speaker": "莉诺尔",
                    "text": "我想想…那就叫这次的探险「勇士营救计划」好了！",
                    "choices": [
                        {
                            "id": "740000224",
                            "text": "既然是勇士，就该自己想办法脱困。",
                            "response": [
                                {
                                    "id": "740000225",
                                    "speaker": "莉诺尔",
                                    "text": "可它只是狗狗嘛，而且年纪很大了，所以就让我们这些年轻勇者去把它从灰尘泥土里拯救出来吧！"
                                },
                                {
                                    "id": "740000228",
                                    "speaker": "恩肖",
                                    "text": "你们一起去也好，记得别让勇士乱吃东西。它多半又跑去北边的小屋玩了，往北走一会儿应该就能看见它。"
                                },
                                {
                                    "id": "740000229",
                                    "speaker": "莉诺尔",
                                    "text": "知道啦，<color=#00E1FFFF>要是它耍性子不肯走，把吃食拿走</color>，它肯定就会乖乖回家了。"
                                },
                                {
                                    "id": "740000230",
                                    "speaker": "恩肖",
                                    "text": "知道就好。还有，<color=#00E1FFFF>可别把围墙里的花踩坏了</color>！"
                                },
                                {
                                    "id": "740000231",
                                    "speaker": "莉诺尔",
                                    "text": "#派蒙姐姐的话，根本不用担心嘛！我和{NICKNAME}{M#哥哥}{F#姐姐}都会小心的，外公就放心好啦。"
                                },
                                {
                                    "id": "740000232",
                                    "speaker": "莉诺尔",
                                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们走吧！"
                                }
                            ]
                        },
                        {
                            "id": "740000226",
                            "text": "那王子和公主不管了吗？",
                            "response": [
                                {
                                    "id": "740000227",
                                    "speaker": "莉诺尔",
                                    "text": "对哦…可是全都放进标题里的话，标题就太长啦。就当是营救勇士，顺便也带王子和公主回窝好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7400005",
            "objective": "等待一段时间",
            "dialogues": [
                {
                    "id": "740000501",
                    "speaker": "恩肖",
                    "text": "好孩子，你们陪莉诺尔玩一会儿吧。"
                }
            ]
        },
        {
            "id": "7400020",
            "objective": "等待一段时间",
            "dialogues": []
        },
