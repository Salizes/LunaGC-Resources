        }
    },
    "talks": [
        {
            "id": "2003801",
            "objective": "与吉丽安娜对话",
            "dialogues": [
                {
                    "id": "200380101",
                    "speaker": "吉丽安娜",
                    "text": "唉，不知道那些七天神像怎么样了…"
                },
                {
                    "id": "200380102",
                    "speaker": "Player",
                    "text": "七天神像怎么了？"
                },
                {
                    "id": "200380103",
                    "speaker": "吉丽安娜",
                    "text": "是这样的…我以往每周都会去七天神像前祈祷，顺便为神像扫除尘埃。"
                },
                {
                    "id": "200380104",
                    "speaker": "吉丽安娜",
                    "text": "多亏了神明，我才有了现在的幸福生活，这么做，也是我报答神明的一种方式…"
                },
                {
                    "id": "200380105",
                    "speaker": "吉丽安娜",
                    "text": "可是自从我有了莉莉以后，出行的机会越来越少了。"
                },
                {
                    "id": "200380106",
                    "speaker": "吉丽安娜",
                    "text": "那些七天神像，肯定因为没人清洗而蒙尘了。"
                },
                {
                    "id": "200380107",
                    "speaker": "吉丽安娜",
                    "text": "虽然这么说，有点像是推卸责任。但能不能请您替我去清除一下七天神像上的灰尘？",
                    "choices": [
                        {
                            "id": "200380109",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200380111",
                                    "speaker": "吉丽安娜",
                                    "text": "太感谢您了，愿风神保佑您。"
                                },
                                {
                                    "id": "200380115",
                                    "speaker": "吉丽安娜",
                                    "text": "对了，七天神像有着神明的力量。"
                                },
                                {
                                    "id": "200380116",
                                    "speaker": "吉丽安娜",
                                    "text": "上面的「尘埃」并不能用普通的方法清理掉…"
                                },
                                {
                                    "id": "200380117",
                                    "speaker": "吉丽安娜",
                                    "text": "不过您有着「元素」的力量，应该能轻松解决吧。"
                                },
                                {
                                    "id": "200380118",
                                    "speaker": "吉丽安娜",
                                    "text": "不像我，一尊神像就要清理整整一天…"
                                }
                            ]
                        },
                        {
                            "id": "200380110",
                            "text": "就让风把灰尘给吹干净…",
                            "response": [
                                {
                                    "id": "200380112",
                                    "speaker": "吉丽安娜",
                                    "text": "巴巴托斯大人和他的风，肯定每天都很繁忙，"
                                },
                                {
                                    "id": "200380113",
                                    "speaker": "吉丽安娜",
                                    "text": "而且，也不能事事指望神明，自己却偷着懒呀。"
                                },
                                {
                                    "id": "200380114",
                                    "speaker": "吉丽安娜",
                                    "text": "就请您和我一起，为巴巴托斯大人分忧吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003802",
            "objective": "(test)清扫位于星落湖的七天神像$HIDDEN",
            "dialogues": [
                {
                    "id": "200380201",
                    "speaker": "吉丽安娜",
                    "text": "您清理完七天神像了吗？"
                },
                {
                    "id": "200380202",
                    "speaker": "Player",
                    "text": "暂时还没清理完。"
                },
                {
                    "id": "200380203",
                    "speaker": "吉丽安娜",
                    "text": "这样啊，不用着急，请您慢慢来吧…"
                }
            ]
        },
        {
            "id": "2003803",
            "objective": "(test)清扫位于风起地的七天神像$HIDDEN",
            "dialogues": [
                {
                    "id": "200380301",
                    "speaker": "吉丽安娜",
                    "text": "您清理完七天神像了吗？"
                },
                {
                    "id": "200380302",
                    "speaker": "Player",
                    "text": "都清理完了。"
                },
                {
                    "id": "200380303",
                    "speaker": "吉丽安娜",
                    "text": "真是太感谢了，愿巴巴托斯保佑您。"
                },
                {
                    "id": "200380304",
                    "speaker": "吉丽安娜",
                    "text": "请收下这些谢礼吧，以后可能也要麻烦你了呢。"
                }
            ]
