{
    "quest": {
        "id": "20038",
        "title": "报答神明的方式",
        "description": "吉丽安娜小姐正在寻找一个人，替她去清扫久未打理过的七天神像…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 24,
        "total_speaker_counts": {
            "Player": 5,
