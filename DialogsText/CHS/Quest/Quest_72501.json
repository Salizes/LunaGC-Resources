    "talks": [
        {
            "id": "7250101",
            "objective": "与朝雾对话",
            "dialogues": []
        },
        {
            "id": "7250102",
            "objective": "与朝雾对话",
            "dialogues": [
                {
                    "id": "725010201",
                    "speaker": "朝雾",
                    "text": "森子小姐怎么总是分给我这种奇怪的稿件啊…",
                    "choices": [
                        {
                            "id": "725010202",
                            "text": "你还在画插画吗？",
                            "response": [
                                {
                                    "id": "725010204",
                                    "speaker": "朝雾",
                                    "text": "呀！旅行者，你怎么来了，好久没看到你，我还以为你已经去别的地方旅行了呢。"
                                },
                                {
                                    "id": "725010205",
                                    "speaker": "朝雾",
                                    "text": "唉…要是我身体能好点，我也想和你一样出去旅行。"
                                },
                                {
                                    "id": "725010206",
                                    "speaker": "朝雾",
                                    "text": "这样的话，就不用每天都被森子小姐当面催稿了…"
                                },
                                {
                                    "id": "725010207",
                                    "speaker": "朝雾",
                                    "text": "上次我画的那些稿件似乎很受好评，好多老师都专门要我给他们画插画。"
                                },
                                {
                                    "id": "725010230",
                                    "speaker": "朝雾",
                                    "text": "虽然森子小姐已经帮我推掉了很多约稿，但留下来的那一部分也还是太多了…"
                                },
                                {
                                    "id": "725010209",
                                    "speaker": "朝雾",
                                    "text": "我最开始以为他们除了稻妻之外，最多就写一写蒙德啦，璃月啦…"
                                },
                                {
                                    "id": "725010210",
                                    "speaker": "朝雾",
                                    "text": "但老师们笔下小说的题材…已经立足须弥，放眼枫丹啦。"
                                },
                                {
                                    "id": "725010216",
                                    "speaker": "朝雾",
                                    "text": "嗯…说回正事，旅行者啊，你手上的那台「留影机」还好吧…",
                                    "choices": [
                                        {
                                            "id": "725010217",
                                            "text": "我觉得它应该还挺好的…",
                                            "response": [
                                                {
                                                    "id": "725010219",
                                                    "speaker": "朝雾",
                                                    "text": "你看，上次我给你开的报酬还不错吧？"
                                                },
                                                {
                                                    "id": "725010220",
                                                    "speaker": "朝雾",
                                                    "text": "旅行者，就请你再帮我去世界各地拍一拍画片吧！",
                                                    "choices": [
                                                        {
                                                            "id": "725010221",
                                                            "text": "唉，交给我吧…",
                                                            "response": [
                                                                {
                                                                    "id": "725010222",
                                                                    "speaker": "朝雾",
                                                                    "text": "那就拜托你了！嘿嘿，我早就把笔记本准备好了。"
                                                                },
                                                                {
                                                                    "id": "725010223",
                                                                    "speaker": "朝雾",
                                                                    "text": "要是你不来找我呀，我可都要拜托森子小姐去找你了…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "725010224",
                                                            "text": "你去冒险家协会挂个委托吧…",
                                                            "response": [
                                                                {
                                                                    "id": "725010225",
                                                                    "speaker": "朝雾",
                                                                    "text": "呜哇！别呀！拜托你了，拜托你了嘛！我去冒险家协会挂过委托，但就是找不到会熟练使用留影机的冒险家啊！"
                                                                },
                                                                {
                                                                    "id": "725010226",
                                                                    "speaker": "朝雾",
                                                                    "text": "你就帮帮我吧旅行者，我要是交不出稿，森子小姐又要跑来和我一起住了！"
                                                                },
                                                                {
                                                                    "id": "725010227",
                                                                    "speaker": "朝雾",
                                                                    "text": "我可受不了她做的那种绯樱泡饭啊，旅行者！你就帮帮我吧！"
                                                                },
                                                                {
                                                                    "id": "725010228",
                                                                    "speaker": "Player",
                                                                    "text": "我知道了，我知道了…"
                                                                },
                                                                {
                                                                    "id": "725010229",
                                                                    "speaker": "朝雾",
                                                                    "text": "呼…那就好，稍等一下啊，我找一下笔记本…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "725010218",
                                            "text": "你又要我帮你拍画片吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "725010203",
                            "text": "你又没灵感了？"
                        }
                    ]
                }
            ]
        }
    ]
}