    "talks": [
        {
            "id": "7109701",
            "objective": "test隐藏-将三枚老石交给沐宁$HIDDEN",
            "dialogues": [
                {
                    "id": "710970101",
                    "speaker": "沐宁",
                    "text": "请问两位找到「老石」了吗？"
                },
                {
                    "id": "710970102",
                    "speaker": "Player",
                    "text": "在这里了。"
                }
            ]
        },
        {
            "id": "7109702",
            "objective": "test隐藏-与沐宁对话$HIDDEN",
            "dialogues": [
                {
                    "id": "710970201",
                    "speaker": "沐宁",
                    "text": "算上这次的，一共是九枚「老石」，这下应该够了。"
                },
                {
                    "id": "710970202",
                    "speaker": "沐宁",
                    "text": "这么快就满足了辉山厅的需求…真不愧是你们！"
                },
                {
                    "id": "710970203",
                    "speaker": "派蒙",
                    "text": "只不过是巨兽之劳啦！"
                },
                {
                    "id": "710970204",
                    "speaker": "Player",
                    "text": "是「举手之劳」…"
                },
                {
                    "id": "710970205",
                    "speaker": "派蒙",
                    "text": "哇！我是说…嗯…这种东西和打倒巨兽一样，都是小意思而已！"
                },
                {
                    "id": "710970206",
                    "speaker": "Player",
                    "text": "派蒙学会强词夺理了，可喜可贺。"
                },
                {
                    "id": "710970207",
                    "speaker": "沐宁",
                    "text": "哈哈…派蒙说的没错啦，两位力搏海魔的功绩，我们都看在眼里的。相信此等壮举对你们来说确实并不困难。",
                    "choices": [
                        {
                            "id": "710970208",
                            "text": "确实如此。",
                            "response": [
                                {
                                    "id": "710970210",
                                    "speaker": "沐宁",
                                    "text": "说来，没想到进了总务司，还要负责「在层岩巨渊找老石」这种工作…"
                                },
                                {
                                    "id": "710970211",
                                    "speaker": "派蒙",
                                    "text": "对哦，你那个时候不是还天天和自己父亲吵架。"
                                },
                                {
                                    "id": "710970212",
                                    "speaker": "派蒙",
                                    "text": "怎么后来去了总务司的呢？"
                                },
                                {
                                    "id": "710970213",
                                    "speaker": "沐宁",
                                    "text": "之前我不是欠了一大笔钱，走投无路，更不愿回家。"
                                },
                                {
                                    "id": "710970214",
                                    "speaker": "沐宁",
                                    "text": "结果讨债的人直接去盛露厅找上了我爸…我听到这件事时心想，我爸非得把我腿打断不可。"
                                },
                                {
                                    "id": "710970215",
                                    "speaker": "派蒙",
                                    "text": "可是你的腿看上去还挺完整的嘛。"
                                },
                                {
                                    "id": "710970216",
                                    "speaker": "沐宁",
                                    "text": "是…说来惭愧，我爸帮我把钱还了，在街上找到了落魄的我，说，「你所有欠条都在我手里，所以现在你欠我钱了」。"
                                },
                                {
                                    "id": "710970217",
                                    "speaker": "沐宁",
                                    "text": "以此要挟我找工作…以偿还欠款。"
                                },
                                {
                                    "id": "710970218",
                                    "speaker": "派蒙",
                                    "text": "原来你现在欠的是你爸的钱啊。"
                                },
                                {
                                    "id": "710970219",
                                    "speaker": "沐宁",
                                    "text": "是这样没错…"
                                },
                                {
                                    "id": "710970220",
                                    "speaker": "沐宁",
                                    "text": "当然，那个时候我每日逃债，惶惶不可终日，早就决定，如果有机会就一定洗心革面。"
                                },
                                {
                                    "id": "710970221",
                                    "speaker": "沐宁",
                                    "text": "但是我没想到这个机会竟然是那个时常跟我吵架的老爸给我的…"
                                },
                                {
                                    "id": "710970222",
                                    "speaker": "沐宁",
                                    "text": "我爸也破天荒没有和我吵架，反而开诚布公地谈了谈，这种谈话要是能早些开始就好了。"
                                },
                                {
                                    "id": "710970223",
                                    "speaker": "沐宁",
                                    "text": "不过就算之前他有心跟我谈，那个时候我也没心情听吧。"
                                },
                                {
                                    "id": "710970224",
                                    "speaker": "派蒙",
                                    "text": "看来你家老爷子对你还蛮好的嘛。"
                                },
                                {
                                    "id": "710970225",
                                    "speaker": "沐宁",
                                    "text": "是啊。"
                                },
                                {
                                    "id": "710970226",
                                    "speaker": "沐宁",
                                    "text": "所以无论如何，都得做好手上的工作。"
                                },
                                {
                                    "id": "710970227",
                                    "speaker": "沐宁",
                                    "text": "无论是这次层岩巨渊的事，还是帮辉山厅打杂找「老石」的活…"
                                },
                                {
                                    "id": "710970228",
                                    "speaker": "Player",
                                    "text": "这次活明明是我帮你做的吧。"
                                },
                                {
                                    "id": "710970229",
                                    "speaker": "沐宁",
                                    "text": "找人帮忙完成工作，也是完成工作的一种方式。"
                                },
                                {
                                    "id": "710970230",
                                    "speaker": "沐宁",
                                    "text": "不过这次也真是多亏了二位，能这么快完成这件工作，出乎了我的意料。"
                                },
                                {
                                    "id": "710970231",
                                    "speaker": "派蒙",
                                    "text": "知道就好。"
                                }
                            ]
                        },
                        {
                            "id": "710970209",
                            "text": "要说困难还是有一点啦…"
                        }
                    ]
                }
            ]
        }
    ]
}