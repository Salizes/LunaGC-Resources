{
    "quest": {
        "id": "21035",
        "title": "剑去之日",
        "description": "古华派弟子孙宇，似乎正在思考着某事…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 31,
        "total_speaker_counts": {
            "Player": 9,
            "孙宇": 22
        }
    },
    "talks": [
        {
            "id": "2103501",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210350101",
                    "speaker": "孙宇",
                    "text": "唉，师妹…",
                    "choices": [
                        {
                            "id": "210350102",
                            "text": "咦？孙宇？",
                            "response": [
                                {
                                    "id": "210350104",
                                    "speaker": "孙宇",
                                    "text": "旅行者？真是巧了，居然能在这里遇见你…"
                                },
                                {
                                    "id": "210350105",
                                    "speaker": "孙宇",
                                    "text": "我…正在这里做些锻炼，准备过段时间就离开璃月，外出游历。",
                                    "choices": [
                                        {
                                            "id": "210350106",
                                            "text": "你怎么突然要离开璃月？",
                                            "response": [
                                                {
                                                    "id": "210350108",
                                                    "speaker": "孙宇",
                                                    "text": "咳，说来惭愧。之前我虽然一直说着要复兴古华派，但平日里的行动…说是访仙，其实也就是在绝云间里闲逛罢了…"
                                                },
                                                {
                                                    "id": "210350109",
                                                    "speaker": "孙宇",
                                                    "text": "虽然承蒙师妹不弃，但我内心深知，如此行为，对复兴古华派实无意义…"
                                                },
                                                {
                                                    "id": "210350110",
                                                    "speaker": "孙宇",
                                                    "text": "前段时间，当我回城里采买物资的时候，偶然和一个枫丹来的客商聊了两句。"
                                                },
                                                {
                                                    "id": "210350111",
                                                    "speaker": "孙宇",
                                                    "text": "这位枫丹人和我说：「你不可能在出现问题的地方找到解决问题的方案。」"
                                                },
                                                {
                                                    "id": "210350112",
                                                    "speaker": "孙宇",
                                                    "text": "我想了好久…也许这位枫丹客商，是在建议我去璃月之外的地方游历一下吧。",
                                                    "choices": [
                                                        {
                                                            "id": "210350113",
                                                            "text": "出去看看也好。",
                                                            "response": [
                                                                {
                                                                    "id": "210350115",
                                                                    "speaker": "孙宇",
                                                                    "text": "我也是这么想，但…但师妹她却不愿意离开璃月。"
                                                                },
                                                                {
                                                                    "id": "210350116",
                                                                    "speaker": "孙宇",
                                                                    "text": "平日里她耍小脾气的时候，我知道她是在和我逗乐，哄哄就好了。"
                                                                },
                                                                {
                                                                    "id": "210350117",
                                                                    "speaker": "孙宇",
                                                                    "text": "但这次她却像是真生气了，无论如何都不愿听我说话，还独自跑回了城里，唉…"
                                                                },
                                                                {
                                                                    "id": "210350118",
                                                                    "speaker": "孙宇",
                                                                    "text": "先不说这些了，这些闲杂事情你听了也烦…旅行者，我能拜托你一件事吗？"
                                                                },
                                                                {
                                                                    "id": "210350119",
                                                                    "speaker": "孙宇",
                                                                    "text": "虽然我会一些防身的武术，但平日里几乎没怎么真的动过手。以后要外出游历，免不了要正经实战…"
                                                                },
                                                                {
                                                                    "id": "210350120",
                                                                    "speaker": "孙宇",
                                                                    "text": "旅行者，我听说过许多你在外冒险的事迹，你一定知道不少应对魔物的方法。"
                                                                },
                                                                {
                                                                    "id": "210350121",
                                                                    "speaker": "孙宇",
                                                                    "text": "你能陪我一起去周围找些魔物练练手，顺便再指导指导我吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "210350122",
                                                                            "text": "没问题。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350125",
                                                                                    "speaker": "孙宇",
                                                                                    "text": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "210350123",
                                                                            "text": "哼，就怕你看不清我的动作。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350124",
                                                                                    "speaker": "孙宇",
                                                                                    "text": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "210350114",
                                                            "text": "就当做是散心也好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210350107",
                                            "text": "你不是要复兴古华派吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210350103",
                            "text": "你在做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103502",
            "objective": "打倒所有魔物",
            "dialogues": [
                {
                    "id": "210350201",
                    "speaker": "孙宇",
                    "text": "呼…呼…真是难以对付…"
                },
                {
                    "id": "210350202",
                    "speaker": "孙宇",
                    "text": "抱歉，让你见笑了。没想到正式对敌时，我会这么紧张…"
                },
                {
                    "id": "210350203",
                    "speaker": "孙宇",
                    "text": "总之我…我还是需要多多锻炼。多谢了旅行者，这些报酬给你，请收下吧。"
                },
                {
                    "id": "210350204",
                    "speaker": "Player",
                    "text": "你真的要离开璃月？"
                },
                {
                    "id": "210350205",
                    "speaker": "孙宇",
                    "text": "我还没有完全想好，我还得再想想，顺便…再尝试说服一下师妹。"
                }
            ]
        },
        {
            "id": "2103503",
            "objective": "与孙宇对话",
            "dialogues": []
        },
        {
            "id": "2103599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210359907",
                    "speaker": "孙宇",
                    "text": "就是这里了，我们上吧。"
                }
            ]
        }
    ]
}