        {
            "id": "7608702",
            "objective": "找到「阿德娜」的安眠处",
            "dialogues": [
                {
                    "id": "686252701",
                    "speaker": "克霍讷之墓",
                    "text": "<color=#00E1FFFF>愿小阿德娜的睡梦中永远有鲜花与糖果。</color>"
                },
                {
                    "id": "686252702",
                    "speaker": "克霍讷之墓",
                    "text": "<color=#00E1FFFF>赞美达诺妲与哈马莱宁的勇气，愿他们与女儿一道进入无忧的梦。</color>"
                }
            ]
        },
        {
            "id": "7608703",
            "objective": "与哭泣的幽影对话",
            "dialogues": [
                {
                    "id": "760870201",
                    "speaker": "阿德娜",
                    "text": "找不到了…呜呜…找不到了…"
                },
                {
                    "id": "760870202",
                    "speaker": "菲林斯",
                    "text": "我找到达诺妲与哈马莱宁了。"
                },
                {
                    "id": "760870203",
                    "speaker": "阿德娜",
                    "text": "爸爸妈妈！爸爸妈妈在家里等我，我要去见他们！"
                }
            ]
        },
        {
            "id": "7608704",
            "objective": "见证「阿德娜」归家",
            "dialogues": [
                {
                    "id": "760870301",
                    "speaker": "阿德娜",
                    "text": "是家，我找到回家的路了！"
                },
                {
                    "id": "760870302",
                    "speaker": "哭泣的幽影",
                    "text": "灯还亮着，妈妈做了热乎乎的派，太好了。"
                },
                {
                    "id": "760870303",
                    "speaker": "阿德娜",
                    "text": "爸爸也在等我，我回来啦！"
                }
            ]
        },
