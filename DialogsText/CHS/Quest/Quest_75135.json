    "talks": [
        {
            "id": "7513501",
            "objective": "跟随绿宝的指引寻找源火祭坛",
            "dialogues": [
                {
                    "id": "751350101",
                    "speaker": "派蒙",
                    "text": "那就是源火祭坛了吗…呃，感觉想要过去的话还有点困难。"
                },
                {
                    "id": "751350102",
                    "speaker": "派蒙",
                    "text": "#怎么办，我们是能用飞的啦，但是{REALNAME[ID(2)|SHOWHOST(true)]}和玻娜要怎么办啦。"
                },
                {
                    "id": "751350103",
                    "speaker": "玻娜",
                    "text": "派蒙不会是在小看我吧，我可是花羽会的冒险家，飞行经验可是很丰富的。"
                },
                {
                    "id": "751350104",
                    "speaker": "玻娜",
                    "text": "#就算是带上{REALNAME[ID(2)|SHOWHOST(true)]}，飞到那边也是轻轻松松。"
                },
                {
                    "id": "751350105",
                    "speaker": "Player",
                    "text": "我也有飞行执照。"
                },
                {
                    "id": "751350106",
                    "speaker": "玻娜",
                    "text": "那就好，我会在前面给你们引路，你们只要跟上我就好了。"
                },
                {
                    "id": "751350107",
                    "speaker": "Player",
                    "text": "接下来是飞行竞速挑战吗？"
                },
                {
                    "id": "751350108",
                    "speaker": "玻娜",
                    "text": "哇，这种时候就不要有这种好胜之心啦，我会在前面给你们引路，你们只要跟上我就好了。"
                },
                {
                    "id": "751350109",
                    "speaker": "派蒙",
                    "text": "#总感觉很危险的样子，也不知道会发生什么，{REALNAME[ID(2)|SHOWHOST(true)]}你可要抓紧我们啦。"
                },
                {
                    "id": "751350110",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                }
            ]
        },
        {
            "id": "7513502",
            "objective": "跟随绿宝的指引寻找源火祭坛",
            "dialogues": []
        },
        {
            "id": "7513503",
            "objective": "前往源火祭坛附近",
            "dialogues": []
        },
        {
            "id": "7513506",
            "objective": "前往源火祭坛附近",
            "dialogues": [
                {
                    "id": "751350201",
                    "speaker": "派蒙",
                    "text": "哇，玻娜你飞得也太快了，我们差点就要跟不上了啦！"
                },
                {
                    "id": "751350202",
                    "speaker": "玻娜",
                    "text": "嘿嘿，抱歉抱歉，看到源火祭坛在前面，不知不觉就…"
                },
                {
                    "id": "751350203",
                    "speaker": "派蒙",
                    "text": "只要用这个祭坛就能去到天蛇船了吗？不过就算一会出现了什么超级大的风场把我们吹起来，也不知道要飞多久…"
                },
                {
                    "id": "751350204",
                    "speaker": "派蒙",
                    "text": "哇，想想就开始担心了。",
                    "choices": [
                        {
                            "id": "751350205",
                            "text": "别害怕，派蒙。",
                            "response": [
                                {
                                    "id": "751350206",
                                    "speaker": "派蒙",
                                    "text": "好吧，既然你都这样说了，一会你可不要和我离得太远哦。"
                                },
                                {
                                    "id": "751350209",
                                    "speaker": "玻娜",
                                    "text": "总之现在是要把火磷石供奉到那个上面，不过我们手上有两枚火磷石，呃…保险起见就把它们一起放上去吧。"
                                }
                            ]
                        },
                        {
                            "id": "751350207",
                            "text": "哇，好刺激。",
                            "response": [
                                {
                                    "id": "751350208",
                                    "speaker": "玻娜",
                                    "text": "对吧对吧，我也开始兴奋起来了呢，作为冒险家可不能错过这样的挑战！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
