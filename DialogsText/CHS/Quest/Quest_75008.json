    "talks": [
        {
            "id": "7500803",
            "objective": "（test）隐藏-大木闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "750080301",
                    "speaker": "曼科",
                    "text": "恕我冒昧，但是，我相信你们一定能平安通过最终的试炼，取得信物的。"
                }
            ]
        },
        {
            "id": "7500802",
            "objective": "(test)隐藏 -- 回报大木前$HIDDEN",
            "dialogues": [
                {
                    "id": "750080201",
                    "speaker": "派蒙",
                    "text": "曼科，我们回来啦。"
                },
                {
                    "id": "750080202",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750080203",
                    "speaker": "曼科",
                    "text": "嗯，这可真是一阵苦等啊，等待的时间越久，实不相瞒，我的心情就越焦虑。"
                },
                {
                    "id": "750080204",
                    "speaker": "曼科",
                    "text": "虽然…提出建议的人是我，但是若是你们进入遗迹而无法归来，我也实在是良心难安…"
                },
                {
                    "id": "750080205",
                    "speaker": "曼科",
                    "text": "不过，恕我直言，你们应该找到「盗火贤者」留在遗迹里的信物了吧。",
                    "choices": [
                        {
                            "id": "750080206",
                            "text": "费了番功夫…",
                            "response": [
                                {
                                    "id": "750080208",
                                    "speaker": "曼科",
                                    "text": "我就相信你们一定可以成功的。"
                                },
                                {
                                    "id": "750080209",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750080210",
                                    "speaker": "派蒙",
                                    "text": "你看，就是这个圆盘一样的东西！我们已经把两个信物全都拿到了！"
                                },
                                {
                                    "id": "750080211",
                                    "speaker": "曼科",
                                    "text": "啊…两枚「通牒金盘」，传说中的「通牒金盘」居然是真的，太好了，我一定要将它记录在我研究的成果里。"
                                },
                                {
                                    "id": "750080212",
                                    "speaker": "派蒙",
                                    "text": "原来这东西叫做「通牒金盘」啊。"
                                },
                                {
                                    "id": "750080213",
                                    "speaker": "曼科",
                                    "text": "是、是的。唉恕我冒昧，我真是太激动了，据说这可是「盗火贤者」与初代的火神，两位传说中的人物亲自经手的东西…"
                                },
                                {
                                    "id": "750080214",
                                    "speaker": "曼科",
                                    "text": "刚才有一瞬间，我想要将之占为己有，作为传家宝之类的…"
                                },
                                {
                                    "id": "750080215",
                                    "speaker": "派蒙",
                                    "text": "#那可不行，我们是要用来救{REALNAME[ID(2)|SHOWHOST(true)]}的！"
                                },
                                {
                                    "id": "750080216",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750080217",
                                    "speaker": "曼科",
                                    "text": "我知道…接下来你们就要前往图兰大火山了吧。"
                                },
                                {
                                    "id": "750080218",
                                    "speaker": "曼科",
                                    "text": "传说从前，在希巴拉克尚未成为火神之时，与执掌光与热的焰主在其中战斗…"
                                },
                                {
                                    "id": "750080219",
                                    "speaker": "曼科",
                                    "text": "最后，成功活着回来的勇士希巴拉克，成为了最初的火神。"
                                },
                                {
                                    "id": "750080220",
                                    "speaker": "曼科",
                                    "text": "不过火山里面有什么就没人知道了，有人说里面藏着休眠中的未死的古龙，也有人说里面被希巴拉克的火焰焚烧，空空如也。"
                                },
                                {
                                    "id": "750080221",
                                    "speaker": "曼科",
                                    "text": "要我说，大概都是些叙事人的臆测…"
                                },
                                {
                                    "id": "750080222",
                                    "speaker": "曼科",
                                    "text": "虽然很想一起去，不过，那对我这副身躯来说，还是太勉强了…"
                                },
                                {
                                    "id": "750080223",
                                    "speaker": "派蒙",
                                    "text": "没关系，知道这些已经很足够啦！"
                                },
                                {
                                    "id": "750080224",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750080225",
                                    "speaker": "曼科",
                                    "text": "嗯，我要再度感谢你们，能够看到「通牒金盘」，对我真的十分重要，不行，我得快点回去将这些记录下来…"
                                },
                                {
                                    "id": "750080226",
                                    "speaker": "曼科",
                                    "text": "#再度感谢你们，{NICKNAME}，派蒙，祝你们的旅途顺利…"
                                },
                                {
                                    "id": "750080227",
                                    "speaker": "曼科",
                                    "text": "#然后，也祝愿{REALNAME[ID(2)|SHOWHOST(true)]}，祝愿你能去除「焰主之祝」的印记。"
                                },
                                {
                                    "id": "750080228",
                                    "speaker": "Player",
                                    "text": "再见！"
                                },
                                {
                                    "id": "750080229",
                                    "speaker": "曼科",
                                    "text": "嗯…在旅途的终点，在所有灵魂的归处，我们一定能够再见的！"
                                }
                            ]
                        },
                        {
                            "id": "750080207",
                            "text": "轻轻松松啦。"
                        }
                    ]
                }
            ]
        },
