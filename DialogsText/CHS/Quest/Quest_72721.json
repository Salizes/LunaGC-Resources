    "talks": [
        {
            "id": "7272101",
            "objective": "与太郎丸对话",
            "dialogues": [
                {
                    "id": "727210101",
                    "speaker": "太郎丸",
                    "text": "呜汪？汪汪！汪！",
                    "choices": [
                        {
                            "id": "727210102",
                            "text": "怎么是太郎丸？",
                            "response": [
                                {
                                    "id": "727210104",
                                    "speaker": "派蒙",
                                    "text": "之前听安彦太郎说，第四位武者是因为手头有点紧才来参加比试的，看来太郎丸的目标也是获胜者的礼金。"
                                },
                                {
                                    "id": "727210105",
                                    "speaker": "派蒙",
                                    "text": "虽然有点不好意思，可在钱这件事上，我是不会让步的！"
                                },
                                {
                                    "id": "727210106",
                                    "speaker": "太郎丸",
                                    "text": "呜汪？"
                                },
                                {
                                    "id": "727210107",
                                    "speaker": "太郎丸",
                                    "text": "汪汪，汪汪汪汪！汪汪汪！！",
                                    "choices": [
                                        {
                                            "id": "727210108",
                                            "text": "太郎丸的叫声变大了。",
                                            "response": [
                                                {
                                                    "id": "727210110",
                                                    "speaker": "派蒙",
                                                    "text": "#太郎丸，这可是堂堂正正的比试，礼金应该属于你和{NICKNAME}之中武艺更强的那个。"
                                                },
                                                {
                                                    "id": "727210111",
                                                    "speaker": "派蒙",
                                                    "text": "不过如果我们赢了的话，也可以给你买点好吃的。"
                                                },
                                                {
                                                    "id": "727210112",
                                                    "speaker": "太郎丸",
                                                    "text": "汪，汪汪汪汪汪，汪汪汪！",
                                                    "choices": [
                                                        {
                                                            "id": "727210115",
                                                            "text": "虽然听不懂，但是来吧。",
                                                            "response": [
                                                                {
                                                                    "id": "727210116",
                                                                    "speaker": "太郎丸",
                                                                    "text": "汪！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "727210113",
                                                            "text": "虽然听不懂，但我还需要准备一下。",
                                                            "response": [
                                                                {
                                                                    "id": "727210114",
                                                                    "speaker": "太郎丸",
                                                                    "text": "汪汪汪。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "727210109",
                                            "text": "该不是激怒它了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "727210103",
                            "text": "「最强武者」是太郎丸！"
                        }
                    ]
                }
            ]
        }
    ]
}