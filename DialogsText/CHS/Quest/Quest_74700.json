        }
    },
    "talks": [
        {
            "id": "7470001",
            "objective": "前往下层水族馆附近…",
            "dialogues": [
                {
                    "id": "747000101",
                    "speaker": "派蒙",
                    "text": "嘿嘿，我觉得装点水族箱明明还是很有趣的嘛！"
                },
                {
                    "id": "747000102",
                    "speaker": "派蒙",
                    "text": "既然桑多涅不介意，我们以后不如也多下去捞点，让这里变得漂漂亮亮的！"
                },
                {
                    "id": "747000103",
                    "speaker": "「木偶」",
                    "text": "喂，你们两个，过来一下。"
                },
                {
                    "id": "747000104",
                    "speaker": "派蒙",
                    "text": "嗯？怎么了吗？"
                },
                {
                    "id": "747000105",
                    "speaker": "「木偶」",
                    "text": "喏，这个给你们。"
                },
                {
                    "id": "747000106",
                    "speaker": "派蒙",
                    "text": "这是…？"
                },
                {
                    "id": "747000107",
                    "speaker": "「木偶」",
                    "text": "我帮你们改良的水下行动装置。"
                },
                {
                    "id": "747000108",
                    "speaker": "派蒙",
                    "text": "欸？！真的吗？谢谢你桑多涅！你人真好！"
                },
                {
                    "id": "747000109",
                    "speaker": "「木偶」",
                    "text": "小机械装置而已，举手之劳。主要还是你们上次捕鱼，怎么说呢…很…原始…真让人有些看不下去…"
                },
                {
                    "id": "747000110",
                    "speaker": "派蒙",
                    "text": "有…有这么不堪吗…"
                },
                {
                    "id": "747000111",
                    "speaker": "「木偶」",
                    "text": "效率低下，毫无技巧可言，而且一点都不优雅。"
                },
                {
                    "id": "747000112",
                    "speaker": "Player",
                    "text": "让你见笑了…"
                },
                {
                    "id": "747000113",
                    "speaker": "「木偶」",
                    "text": "算了，你们有你们的习惯，我不多说什么。但既然你们想继续装饰这水族馆，最好带上我给的东西。"
                },
                {
                    "id": "747000114",
                    "speaker": "「木偶」",
                    "text": "枫丹水下不只有温和好看的小鱼，还有很多具有攻击性的危险大鱼。这既是为你们的成功率着想，也是为了安全着想。",
                    "choices": [
                        {
                            "id": "747000115",
                            "text": "非常感谢。",
                            "response": [
                                {
                                    "id": "747000117",
                                    "speaker": "「木偶」",
                                    "text": "哼，行了，要下水就快去吧。回来后记得告诉我装置的使用感受，我可以根据你们的反馈进行调试。"
                                }
                            ]
                        },
                        {
                            "id": "747000116",
                            "text": "我会带上它的。"
                        }
                    ]
                }
            ]
        }
    ]
}