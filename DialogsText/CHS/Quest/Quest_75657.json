            "dialogues": [
                {
                    "id": "756570401",
                    "speaker": "派蒙",
                    "text": "画片效果怎么样？",
                    "choices": [
                        {
                            "id": "756570402",
                            "text": "效果很好，谢谢你。",
                            "response": [
                                {
                                    "id": "756570404",
                                    "speaker": "派蒙",
                                    "text": "我是没问题，不过你的留影机没有拿在手上哦，这样不方便留影吧。"
                                }
                            ]
