    "talks": [
        {
            "id": "7565701",
            "objective": "",
            "dialogues": [
                {
                    "id": "756570201",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，这里这里！"
                },
                {
                    "id": "756570202",
                    "speaker": "派蒙",
                    "text": "记得吗？这是我们旅程的起点。"
                },
                {
                    "id": "756570203",
                    "speaker": "派蒙",
                    "text": "不知不觉中居然已经走过了那么多地方，派蒙我心生感慨，想要赋诗一首！",
                    "choices": [
                        {
                            "id": "756570204",
                            "text": "请，派大诗人——",
                            "response": [
                                {
                                    "id": "756570207",
                                    "speaker": "派蒙",
                                    "text": "啊！好大一个提瓦特！"
                                },
                                {
                                    "id": "756570208",
                                    "speaker": "派蒙",
                                    "text": "啊！走了那么远还是没有把你走遍！",
                                    "choices": [
                                        {
                                            "id": "756570209",
                                            "text": "（保持沉默）",
                                            "response": [
                                                {
                                                    "id": "756570211",
                                                    "speaker": "派蒙",
                                                    "text": "啊！啊…啊不出来了…",
                                                    "choices": [
                                                        {
                                                            "id": "756570212",
                                                            "text": "哈哈哈哈哈。",
                                                            "response": [
                                                                {
                                                                    "id": "756570213",
                                                                    "speaker": "派蒙",
                                                                    "text": "哼，你就笑吧，跟你旅行了这么久我已经习惯了。"
                                                                },
                                                                {
                                                                    "id": "756570216",
                                                                    "speaker": "派蒙",
                                                                    "text": "说正经的，旅行得太久，很容易忘记最开始的事情。"
                                                                },
                                                                {
                                                                    "id": "756570217",
                                                                    "speaker": "派蒙",
                                                                    "text": "比方说现在，我就有点记不起来甜甜花酿鸡的味道了，明明以前那么喜欢吃…"
                                                                },
                                                                {
                                                                    "id": "756570218",
                                                                    "speaker": "派蒙",
                                                                    "text": "所以我才会想到买这份留影册，一起给走过的路和遇到的人留影。"
                                                                },
                                                                {
                                                                    "id": "756570219",
                                                                    "speaker": "派蒙",
                                                                    "text": "轻小说和映影里不是经常有这种桥段嘛，一旦回到最初的起点，就离大结局不远了。"
                                                                },
                                                                {
                                                                    "id": "756570220",
                                                                    "speaker": "派蒙",
                                                                    "text": "之所以选这里留影，不是为了感伤，而是希望我们都能记得来时的路，旅途走得更从容…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756570221",
                                                                            "text": "你偷听我和万叶说话了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570224",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "真是的，我好不容易创造出的氛围，这下都没有了。"
                                                                                },
                                                                                {
                                                                                    "id": "756570225",
                                                                                    "speaker": "Player",
                                                                                    "text": "我明白派蒙的意思。"
                                                                                },
                                                                                {
                                                                                    "id": "756570226",
                                                                                    "speaker": "Player",
                                                                                    "text": "我们还要一起走下去。"
                                                                                },
                                                                                {
                                                                                    "id": "756570227",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘿嘿，你明白我的意思就好。"
                                                                                },
                                                                                {
                                                                                    "id": "756570228",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好啦，这张画片就由提瓦特最好的向导来给你当模特。你觉得什么样的姿势好？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756570229",
                                                                                            "text": "有趣的姿势。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756570232",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好呀，这样可以吗？",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "756570233",
                                                                                                            "text": "很棒！我们开始留影吧！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570234",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "我准备好了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570239",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "还是有趣的姿势合适。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570240",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "那就这样好了。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570235",
                                                                                                            "text": "还是端正的姿势合适。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570236",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "那就这样好了。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570237",
                                                                                                            "text": "还是放松的姿势合适。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570238",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "那就这样好了。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756570230",
                                                                                            "text": "端正的姿势。"
                                                                                        },
                                                                                        {
                                                                                            "id": "756570231",
                                                                                            "text": "放松的姿势。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756570222",
                                                                            "text": "派蒙进化了！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570223",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "唔…我承认你和万叶说话的时候，我在旁边偷听来着。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756570214",
                                                            "text": "派蒙在感叹这一路的艰难？",
                                                            "response": [
                                                                {
                                                                    "id": "756570215",
                                                                    "speaker": "派蒙",
                                                                    "text": "没错，这就是我想表达的中心思想，哎呀还是你懂我。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756570210",
                                            "text": "根本没有押韵啊。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756570205",
                            "text": "噗嗤。",
                            "response": [
                                {
                                    "id": "756570206",
                                    "speaker": "派蒙",
                                    "text": "你不要打岔呀，让我酝酿一下…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7565701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "756570101",
                    "speaker": "派蒙",
                    "text": "欸，等一下，我借给你的留影机呢？不会丢了吧，快找找有没有带在身上。"
                }
            ]
        },
