    "talks": [
        {
            "id": "7269601",
            "objective": "前往离岛，寻找伯特兰",
            "dialogues": [
                {
                    "id": "726960101",
                    "speaker": "伯特兰",
                    "text": "哈啊，真是好险…"
                },
                {
                    "id": "726960102",
                    "speaker": "伯特兰",
                    "text": "差一点，就差那么一点…"
                },
                {
                    "id": "726960103",
                    "speaker": "派蒙",
                    "text": "伯特兰，你怎么满脸是汗，好像全身都要虚脱了一样啊。"
                },
                {
                    "id": "726960104",
                    "speaker": "伯特兰",
                    "text": "不是「好像要虚脱」，我就是「虚脱」了。",
                    "choices": [
                        {
                            "id": "726960105",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "726960107",
                                    "speaker": "伯特兰",
                                    "text": "嘿嘿，险些失败了，好在我眼疾手快进行了一些紧急的调整，终于稳定下来了。"
                                },
                                {
                                    "id": "726960108",
                                    "speaker": "伯特兰",
                                    "text": "现在那些元素正一点点和之前收集的原材结合。"
                                },
                                {
                                    "id": "726960109",
                                    "speaker": "伯特兰",
                                    "text": "哎呀，还真是命悬一线啊，要是元素力没控制住，我就可以和长野原家的烟花比比谁在天上更璀璨了。"
                                },
                                {
                                    "id": "726960110",
                                    "speaker": "Player",
                                    "text": "之前还说不会爆炸…"
                                },
                                {
                                    "id": "726960111",
                                    "speaker": "伯特兰",
                                    "text": "我说的是玩具不会爆炸，我可没保证过制造玩具的机器一定不会爆炸。"
                                },
                                {
                                    "id": "726960112",
                                    "speaker": "伯特兰",
                                    "text": "不过这次也正是多亏了有你们帮忙实验，要是直接投产，一个玩具都造不出来不说，连立身之本的「大工机」都得没了。"
                                },
                                {
                                    "id": "726960113",
                                    "speaker": "伯特兰",
                                    "text": "好了，现在就是最后的环节，这最后的环节就是「核心激活」了。"
                                },
                                {
                                    "id": "726960114",
                                    "speaker": "派蒙",
                                    "text": "核心激活，听你之前的话，是和元素生物有关对吧？"
                                },
                                {
                                    "id": "726960115",
                                    "speaker": "伯特兰",
                                    "text": "对，元素生物身上有令元素力不断流动的动力。将这种动力加入机器，就是最后的工序了。"
                                },
                                {
                                    "id": "726960116",
                                    "speaker": "伯特兰",
                                    "text": "如果能成功产出玩具，就可以持续不断地生产，用玩具还上欠债，大赚一笔，在稻妻逍遥快活…"
                                },
                                {
                                    "id": "726960117",
                                    "speaker": "派蒙",
                                    "text": "嗯？你不回枫丹吗？"
                                },
                                {
                                    "id": "726960118",
                                    "speaker": "伯特兰",
                                    "text": "枫丹…呵，枫丹啊。"
                                },
                                {
                                    "id": "726960119",
                                    "speaker": "伯特兰",
                                    "text": "#{NICKNAME}，派蒙，你们还没有去过枫丹吧，如果你们去过就知道了…"
                                },
                                {
                                    "id": "726960120",
                                    "speaker": "伯特兰",
                                    "text": "对于一些人来说，那里是能够便利生活的国度，但对另一些人来说，那里不过是一块失意的伤心地。"
                                },
                                {
                                    "id": "726960121",
                                    "speaker": "伯特兰",
                                    "text": "那里的能源体系比较特殊，谁都不知道还能维持多久。在真的崩溃之前，找到替代的能源方案是必须的。"
                                },
                                {
                                    "id": "726960122",
                                    "speaker": "伯特兰",
                                    "text": "但是改变总是比想象中困难，结果就是…我现在不得不一个人在枫丹之外研究其他的能量来源。"
                                },
                                {
                                    "id": "726960123",
                                    "speaker": "伯特兰",
                                    "text": "其实「大工机」也是我研究新能源的产物，所以还不是很稳定，一个不注意可能就会产生爆炸…"
                                },
                                {
                                    "id": "726960124",
                                    "speaker": "伯特兰",
                                    "text": "不过总有一天我一定会找到一个好的能源方案。"
                                },
                                {
                                    "id": "726960125",
                                    "speaker": "伯特兰",
                                    "text": "那时候我就会启程返回枫丹了。"
                                },
                                {
                                    "id": "726960126",
                                    "speaker": "派蒙",
                                    "text": "伯特兰…"
                                },
                                {
                                    "id": "726960127",
                                    "speaker": "伯特兰",
                                    "text": "不说这些了，开始最后的工序吧。"
                                },
                                {
                                    "id": "726960128",
                                    "speaker": "伯特兰",
                                    "text": "#返回枫丹之前，我能在稻妻能过上什么样的生活，可都看你的了，{NICKNAME}！"
                                }
                            ]
                        },
                        {
                            "id": "726960106",
                            "text": "元素反应失败了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7269602",
            "objective": "击败3个史莱姆获得3份核心动力",
            "dialogues": [
                {
                    "id": "726960201",
                    "speaker": "伯特兰",
                    "text": "最后一道工序进度如何了？击败元素生物，这对你这种经验丰富的冒险家来说应该不在话下吧？"
                }
            ]
        },
        {
            "id": "7269606",
            "objective": "击败2个飘浮灵获得4份核心动力",
            "dialogues": []
        },
        {
            "id": "7269607",
            "objective": "击败无相元素获得4份核心动力",
            "dialogues": []
        },
        {
            "id": "7269603",
            "objective": "将收集器交给伯特兰",
            "dialogues": [
                {
                    "id": "726960301",
                    "speaker": "伯特兰",
                    "text": "这下所有工序都将就绪了。"
                },
                {
                    "id": "726960302",
                    "speaker": "伯特兰",
                    "text": "#这样吧，{NICKNAME}，就由你来亲手将「素材收集器」放在机器上。"
                },
                {
                    "id": "726960303",
                    "speaker": "伯特兰",
                    "text": "真不知道能造出什么样的玩具，还真有点兴奋。"
                },
                {
                    "id": "726960304",
                    "speaker": "派蒙",
                    "text": "你居然也不知道会造出什么样的玩具？"
                },
                {
                    "id": "726960305",
                    "speaker": "伯特兰",
                    "text": "这就是「大工机」的有趣之处啊，哈哈哈，因为它是应对不同的材料相对做出不同的处理。"
                },
                {
                    "id": "726960306",
                    "speaker": "伯特兰",
                    "text": "做出来的东西取决于你带来了什么，来，快点试试看吧！"
                }
            ]
        },
        {
            "id": "7269604",
            "objective": "进行一次玩具制造",
            "dialogues": [
                {
                    "id": "726960401",
                    "speaker": "派蒙",
                    "text": "这真的是枫丹机器造出的玩具吗？"
                },
                {
                    "id": "726960402",
                    "speaker": "Player",
                    "text": "…总觉得和枫丹印象不符。"
                },
                {
                    "id": "726960403",
                    "speaker": "伯特兰",
                    "text": "只是做出枫丹风格的玩具机器人，当然是没法获得商业化的成功的。"
                },
                {
                    "id": "726960404",
                    "speaker": "伯特兰",
                    "text": "实不相瞒，这加入了我对本地流行文化的理解，只有贴近本地居民的心，才会受到本地居民的欢迎。"
                },
                {
                    "id": "726960405",
                    "speaker": "派蒙",
                    "text": "真的会受欢迎吗？"
                },
                {
                    "id": "726960406",
                    "speaker": "伯特兰",
                    "text": "咳咳…一开始肯定会遭到误解，但是只要持之以恒，改进产品，肯定能打动他们的！"
                },
                {
                    "id": "726960407",
                    "speaker": "伯特兰",
                    "text": "总而言之，这样就完成一次制造了。"
                },
                {
                    "id": "726960408",
                    "speaker": "伯特兰",
                    "text": "怎么样，很有趣吧。"
                },
                {
                    "id": "726960409",
                    "speaker": "Player",
                    "text": "一般有趣吧。"
                },
                {
                    "id": "726960410",
                    "speaker": "伯特兰",
                    "text": "哼哼，明白了，这样的材料比例能够做出来的玩具是这样的，那我就先把这个收进我的库存里，另外，这张券给你。"
                },
                {
                    "id": "726960417",
                    "speaker": "伯特兰",
                    "text": "这张券可以免费兑换与这个机器人相同造型的机器人，如果你喜欢这个造型的，稳定生产完成后就用这张券来换就好！"
                },
                {
                    "id": "726960418",
                    "speaker": "伯特兰",
                    "text": "嗯嗯…毕竟是第一个造出来的玩具机器人，我得进行一些检查，总是做出会爆炸的玩意儿可不行啊。"
                },
                {
                    "id": "726960411",
                    "speaker": "伯特兰",
                    "text": "试运行产生的问题记录…我看看，要提高效率还要做出一些调整。"
                },
                {
                    "id": "726960412",
                    "speaker": "派蒙",
                    "text": "没想到一涉及这些工作，还挺认真的嘛。"
                },
                {
                    "id": "726960413",
                    "speaker": "伯特兰",
                    "text": "那是当然了，我孤身在外，能够依靠的就只有这个机器和制造工艺了。"
                },
                {
                    "id": "726960414",
                    "speaker": "伯特兰",
                    "text": "虽然这些都被之前抓捕我的同心怒斥为「奇技淫巧」，哼，可别小看了认真的「奇技淫巧」啊。"
                },
                {
                    "id": "726960415",
                    "speaker": "伯特兰",
                    "text": "我先做些调整，这样一来，等过段时间能够正式开始我的制造大业了。"
                },
                {
                    "id": "726960416",
                    "speaker": "伯特兰",
                    "text": "#到时候你也一定要来帮忙啊，{NICKNAME}！"
                }
            ]
        },
        {
            "id": "7269605",
            "objective": "和伯特兰对话",
            "dialogues": []
        },
        {
            "id": "7269605",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726960501",
                    "speaker": "伯特兰",
                    "text": "好了，快去「大工机」那儿试试看，你能造出什么样的玩具吧。"
                }
            ]
        }
    ]
}