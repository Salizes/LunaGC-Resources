    "talks": [
        {
            "id": "2502501",
            "objective": "与佩蕾·努伊对话",
            "dialogues": [
                {
                    "id": "250250201",
                    "speaker": "Player",
                    "text": "我来试试把它哄出来吧。"
                },
                {
                    "id": "250250202",
                    "speaker": "佩蕾·努伊",
                    "text": "唔…行啊。换个人去哄也是一种方法。那就拜托你了。"
                },
                {
                    "id": "250250203",
                    "speaker": "佩蕾·努伊",
                    "text": "这孩子也不知道是怎么了。明明之前我只要摸摸它的<color=#00E1FFFF>头</color>或者<color=#00E1FFFF>肚子</color>，就能乖乖听话…"
                }
            ]
        },
        {
            "id": "2502502",
            "objective": "(test)隐藏任务：选择了哄恐龙$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2502504",
            "objective": "尝试和懒懒的小鳍游龙交流",
            "dialogues": [
                {
                    "id": "250250401",
                    "speaker": "懒懒的鳍游龙",
                    "text": "呜…？呜呜，呜…",
                    "choices": [
                        {
                            "id": "250250402",
                            "text": "（摸摸它的头…）",
                            "response": [
                                {
                                    "id": "250250403",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "呜？呜！呜呜——"
                                },
                                {
                                    "id": "250250404",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）"
                                },
                                {
                                    "id": "250250412",
                                    "speaker": "Black Screen",
                                    "text": "小鳍游龙总算安静了下来。你小心翼翼地把它抱上了岸…"
                                }
                            ]
                        },
                        {
                            "id": "250250405",
                            "text": "（摸摸它的肚子…）",
                            "response": [
                                {
                                    "id": "250250406",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "呜呜？呜呜——"
                                },
                                {
                                    "id": "250250407",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）"
                                }
                            ]
                        },
                        {
                            "id": "250250408",
                            "text": "（尝试直接抱起来…）",
                            "response": [
                                {
                                    "id": "250250409",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "呜！呜，呜呜！"
                                },
                                {
                                    "id": "250250410",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "（小鳍游龙似乎不太高兴，泼得你满脸是水。）"
                                },
                                {
                                    "id": "250250411",
                                    "speaker": "懒懒的鳍游龙",
                                    "text": "（小鳍游龙期待地看着你。最好换一个方法再哄哄它…）"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502511",
            "objective": "(test)隐藏任务：人形交互$HIDDEN",
            "dialogues": [
                {
                    "id": "250251101",
                    "speaker": "佩蕾·努伊",
                    "text": "你是玩开心了，我可得回去换一身衣服了…"
                },
                {
                    "id": "250251102",
                    "speaker": "懒懒的鳍游龙",
                    "text": "呜呜！呜——"
                },
                {
                    "id": "250251103",
                    "speaker": "Player",
                    "text": "你怎么全身都湿透了…"
                },
                {
                    "id": "250251104",
                    "speaker": "佩蕾·努伊",
                    "text": "咳，陪着这孩子好好玩了一场，它总算是肯听话上来了。"
                },
                {
                    "id": "250251105",
                    "speaker": "佩蕾·努伊",
                    "text": "你已经收拾好那边的温泉了吧？真是多谢你了，这些东西给你，就当做是报酬吧。"
                },
                {
                    "id": "250251106",
                    "speaker": "佩蕾·努伊",
                    "text": "等我收拾好其他温泉，可得回去换一身…咦？那孩子去哪了？"
                },
                {
                    "id": "250251107",
                    "speaker": "懒懒的鳍游龙",
                    "text": "呜！呜——"
                },
                {
                    "id": "250251108",
                    "speaker": "佩蕾·努伊",
                    "text": "喂！回来！那边的温泉还没收拾好啊！"
                },
                {
                    "id": "250251109",
                    "speaker": "Black Screen",
                    "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
                }
            ]
        },
        {
            "id": "2502512",
            "objective": "(test)隐藏任务：龙形交互$HIDDEN",
            "dialogues": [
                {
                    "id": "250251201",
                    "speaker": "佩蕾·努伊",
                    "text": "咦？那孩子怎么自己爬上岸了？难道是…玩累了？"
                },
                {
                    "id": "250251202",
                    "speaker": "佩蕾·努伊",
                    "text": "…无论如何，还是多谢你帮忙，这些报酬收下吧。我也要去给那孩子准备点好吃的…"
                },
                {
                    "id": "250251203",
                    "speaker": "佩蕾·努伊",
                    "text": "咦？它在哪呢？不，不会又跑去温泉里去了吧！"
                },
                {
                    "id": "250251204",
                    "speaker": "懒懒的鳍游龙",
                    "text": "呜！呜——"
                },
                {
                    "id": "250251205",
                    "speaker": "佩蕾·努伊",
                    "text": "喂！回来！那边的温泉还没收拾好啊！"
                },
                {
                    "id": "250251206",
                    "speaker": "Black Screen",
                    "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
                }
            ]
        },
        {
