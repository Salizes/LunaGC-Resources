    "talks": [
        {
            "id": "1200201",
            "objective": "带信给「飞云商会」的家丁",
            "dialogues": []
        },
        {
            "id": "1200203",
            "objective": "与「飞云商会」的家丁对话",
            "dialogues": [
                {
                    "id": "120020301",
                    "speaker": "派蒙",
                    "text": "打扰了，我们有一事相求。请先读一下这封信吧。"
                },
                {
                    "id": "120020302",
                    "speaker": "Player",
                    "text": "你说话也有他的味道了。"
                },
                {
                    "id": "120020303",
                    "speaker": "阿旭",
                    "text": "信？哦哦，原来又是这么一回事啊…",
                    "choices": [
                        {
                            "id": "120020304",
                            "text": "又是？",
                            "response": [
                                {
                                    "id": "120020306",
                                    "speaker": "阿旭",
                                    "text": "没事没事，只是我的凭空猜测，待我读一下信中的内容。"
                                },
                                {
                                    "id": "120020307",
                                    "speaker": "派蒙",
                                    "text": "他读得懂吗…话说这个真的是提瓦特通用语吗…"
                                },
                                {
                                    "id": "120020308",
                                    "speaker": "阿旭",
                                    "text": "嗯…没错，这字确实不是别人能模仿的。"
                                },
                                {
                                    "id": "120020309",
                                    "speaker": "阿旭",
                                    "text": "两位贵客旅途劳顿，实在辛苦，就由我们「飞云商会」为你们接风洗尘。",
                                    "choices": [
                                        {
                                            "id": "120020310",
                                            "text": "等等，接风洗尘？",
                                            "response": [
                                                {
                                                    "id": "120020312",
                                                    "speaker": "阿旭",
                                                    "text": "不用着急，信中的事我已经了解，只是我们需要一点时间来准备。"
                                                },
                                                {
                                                    "id": "120020313",
                                                    "speaker": "阿旭",
                                                    "text": "请二位到琉璃亭小坐片刻，品尝点心看看海景，算是我们一点不成敬意的招待。"
                                                },
                                                {
                                                    "id": "120020314",
                                                    "speaker": "派蒙",
                                                    "text": "哇啊，有好吃的！居然对我们这么客气！"
                                                },
                                                {
                                                    "id": "120020315",
                                                    "speaker": "阿旭",
                                                    "text": "待客之道是「飞云商会」的必修课，贵客上门，自然不能怠慢。"
                                                },
                                                {
                                                    "id": "120020316",
                                                    "speaker": "阿旭",
                                                    "text": "二位这边请，我来带路。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120020311",
                                            "text": "我们不是来做客的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120020305",
                            "text": "你知道什么吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200202",
            "objective": "进入琉璃亭",
            "dialogues": [
                {
                    "id": "120020201",
                    "speaker": "派蒙",
                    "text": "这里就是「飞云商会」，璃月港阔绰的地方真是不少啊。"
                },
                {
                    "id": "120020202",
                    "speaker": "派蒙",
                    "text": "我们快把信送进去吧。"
                }
            ]
        },
        {
            "id": "1200221",
            "objective": "与家丁对话",
            "dialogues": [
                {
                    "id": "120020317",
                    "speaker": "派蒙",
                    "text": "还以为会被粗暴对待或者直接被轰走呢…"
                },
                {
                    "id": "120020318",
                    "speaker": "派蒙",
                    "text": "想不到书呆子的面子这么大。"
                },
                {
                    "id": "120020319",
                    "speaker": "阿旭",
                    "text": "二位久等了，「飞云商会」已经安排妥当。"
                },
                {
                    "id": "120020320",
                    "speaker": "阿旭",
                    "text": "茂才公有钱有势，普通的教训对他来说不疼不痒。"
                },
                {
                    "id": "120020321",
                    "speaker": "阿旭",
                    "text": "要让他不再做同样的事，只能让他切身感受到和常九爷同样的痛苦。"
                },
                {
                    "id": "120020322",
                    "speaker": "阿旭",
                    "text": "茂才公的生意和石珀有关，那只要能买下整个璃月的石珀，就能让茂才公陷入绝境。"
                },
                {
                    "id": "120020323",
                    "speaker": "阿旭",
                    "text": "要是没有原料，再厉害的工匠也做不出商品吧。"
                },
                {
                    "id": "120020324",
                    "speaker": "派蒙",
                    "text": "原来如此！这样他就没法给「愚人众」交差了！"
                },
                {
                    "id": "120020325",
                    "speaker": "派蒙",
                    "text": "不过，璃月这么大，要买下所有的石珀也很麻烦吧？"
                },
                {
                    "id": "120020326",
                    "speaker": "阿旭",
                    "text": "嗯，一时间确实难以全部收购，所以按照信中安排，还要劳烦二位客人帮帮忙。"
                },
                {
                    "id": "120020327",
                    "speaker": "阿旭",
                    "text": "首先是璃月城中的几家店铺，我会在地图上为你们标出位置。"
                },
                {
                    "id": "120020328",
                    "speaker": "阿旭",
                    "text": "然后在层岩巨渊还有一些暂时没被收购的石珀，也需要买下来。"
                },
                {
                    "id": "120020329",
                    "speaker": "阿旭",
                    "text": "最后，就是常九爷手上的那一批了。"
                },
                {
                    "id": "120020330",
                    "speaker": "派蒙",
                    "text": "嗯嗯，城里三家店，层岩巨渊，常九爷，我记住了！"
                },
                {
                    "id": "120020331",
                    "speaker": "阿旭",
                    "text": "当然，采购的开销请完全不用担心。"
                },
                {
                    "id": "120020332",
                    "speaker": "派蒙",
                    "text": "哇，这么多摩拉？！都、都能把琉璃亭包下来吃一个月了吧！"
                },
                {
                    "id": "120020333",
                    "speaker": "Player",
                    "text": "「飞云商会」还真是舍得。"
                },
                {
                    "id": "120020334",
                    "speaker": "阿旭",
                    "text": "呵呵，这样的事以前也有过几次，已经习惯了。"
                },
                {
                    "id": "120020335",
                    "speaker": "阿旭",
                    "text": "两位只需要谈成交易即可，余下运输之类的琐事都交给「飞云商会」来打点。"
                },
                {
                    "id": "120020336",
                    "speaker": "阿旭",
                    "text": "等两位全部收购完成之后，就可以去「飞云商会」的仓库看好戏了。"
                }
            ]
        },
        {
            "id": "1200204",
            "objective": "前往商铺购买石珀",
            "dialogues": [
                {
                    "id": "120020401",
                    "speaker": "Player",
                    "text": "想买下你所有的石珀。"
                },
                {
                    "id": "120020402",
                    "speaker": "博来",
                    "text": "所有？我先说啊，别看我的铺子不大，货源可是有明有暗，加起来广得很。"
                },
                {
                    "id": "120020403",
                    "speaker": "博来",
                    "text": "你就告诉我个数吧，真把所有货都调来了，怕你吃不下。",
                    "choices": [
                        {
                            "id": "120020404",
                            "text": "这是「飞云商会」的生意。",
                            "response": [
                                {
                                    "id": "120020405",
                                    "speaker": "博来",
                                    "text": "飞…「飞云商会」！那…那早说啊。"
                                },
                                {
                                    "id": "120020408",
                                    "speaker": "博来",
                                    "text": "既然是「飞云商会」那就没问题了，来签契约吧，我马上帮你调货！"
                                }
                            ]
                        },
                        {
                            "id": "120020406",
                            "text": "「飞云商会」只做合法生意。",
                            "response": [
                                {
                                    "id": "120020407",
                                    "speaker": "博来",
                                    "text": "说什么呢，我的货当然都是合法的。不过，「飞云商会」啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200205",
            "objective": "前往商铺购买石珀",
            "dialogues": [
                {
                    "id": "120020501",
                    "speaker": "Player",
                    "text": "想买下你所有的石珀。"
                },
                {
                    "id": "120020502",
                    "speaker": "长顺",
                    "text": "所有的石珀？唔，其实我已经接了好几单石珀的生意了。"
                },
                {
                    "id": "120020503",
                    "speaker": "长顺",
                    "text": "不过都是口头约定，暂时还没签契约…买家感觉很精明，一直没有决定下来。"
                },
                {
                    "id": "120020504",
                    "speaker": "Player",
                    "text": "「飞云商会」全包了。"
                },
                {
                    "id": "120020505",
                    "speaker": "长顺",
                    "text": "原来是「飞云商会」！嗯，原来如此，看来璃月的商界又有动向了…"
                },
                {
                    "id": "120020506",
                    "speaker": "长顺",
                    "text": "啊，没事，不用在意！我只是在自言自语，我们来签契约吧。"
                },
                {
                    "id": "120020507",
                    "speaker": "长顺",
                    "text": "不用担心约定的事，对方也没付定金，这在生意场上是很正常的事。"
                },
                {
                    "id": "120020508",
                    "speaker": "长顺",
                    "text": "谢谢您的惠顾，还望「飞云商会」多来照顾我家生意啊！"
                }
            ]
        },
        {
            "id": "1200206",
            "objective": "前往商铺购买石珀",
            "dialogues": [
                {
                    "id": "120020601",
                    "speaker": "Player",
                    "text": "石珀也没有了吗？"
                },
                {
                    "id": "120020602",
                    "speaker": "伊凡诺维奇",
                    "text": "哦哦，我还以为是来买至冬国的商品的。"
                },
                {
                    "id": "120020603",
                    "speaker": "伊凡诺维奇",
                    "text": "石珀倒是有…只不过我的石珀都是发给至冬国工厂的，不做零星的生意。"
                },
                {
                    "id": "120020604",
                    "speaker": "伊凡诺维奇",
                    "text": "需求少，管理起来又麻烦，所以，抱歉啦。",
                    "choices": [
                        {
                            "id": "120020605",
                            "text": "「全部」这个量不小了吧？",
                            "response": [
                                {
                                    "id": "120020607",
                                    "speaker": "伊凡诺维奇",
                                    "text": "原、原来是这样…那我考虑一下，稍等。"
                                },
                                {
                                    "id": "120020608",
                                    "speaker": "伊凡诺维奇",
                                    "text": "好吧，那只需要在契约上签个字就行了。"
                                },
                                {
                                    "id": "120020609",
                                    "speaker": "伊凡诺维奇",
                                    "text": "（唉，璃月人可真是有钱啊…）"
                                }
                            ]
                        },
                        {
                            "id": "120020606",
                            "text": "「飞云商会」的生意不算零星吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200215",
            "objective": "(test)完成购买$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200222",
            "objective": "(test)任务隔离，防止回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200207",
            "objective": "前往层岩巨渊购买石珀",
            "dialogues": []
        },
        {
            "id": "1200208",
            "objective": "与石壮对话",
            "dialogues": [
                {
                    "id": "120020801",
                    "speaker": "派蒙",
                    "text": "请问，你就是开采石珀的负责人吗？"
                },
                {
                    "id": "120020802",
                    "speaker": "石壮",
                    "text": "哦哦，终于来了。听说「飞云商会」在璃月港大批购买石珀，我就想你们会来的。"
                },
                {
                    "id": "120020803",
                    "speaker": "石壮",
                    "text": "我这里确实还有一批暂时还没有被运走的石珀，只要你们开价够高就可以卖给你们。",
                    "choices": [
                        {
                            "id": "120020804",
                            "text": "我有不好的预感…",
                            "response": [
                                {
                                    "id": "120020806",
                                    "speaker": "石壮",
                                    "text": "因为对方的开价也高，现在这一批…要七百万摩拉才行。"
                                },
                                {
                                    "id": "120020807",
                                    "speaker": "派蒙",
                                    "text": "啊？！明明在璃月港一共才花掉了不到两百万摩拉！"
                                },
                                {
                                    "id": "120020808",
                                    "speaker": "石壮",
                                    "text": "没办法，价高者得，我卖给你们其实也是毁约了，价格不高可不行。",
                                    "choices": [
                                        {
                                            "id": "120020809",
                                            "text": "价格翻了四倍多，太黑了。",
                                            "response": [
                                                {
                                                    "id": "120020811",
                                                    "speaker": "石壮",
                                                    "text": "你们有你们的难处，我也有我的难处。想买就买，不想买，就请回吧。"
                                                },
                                                {
                                                    "id": "120020812",
                                                    "speaker": "派蒙",
                                                    "text": "好吧好吧，贵了就贵了，我们买！"
                                                },
                                                {
                                                    "id": "120020813",
                                                    "speaker": "派蒙",
                                                    "text": "回去和老爷说，以后跟这位负责人先生做生意，卖东西也翻四倍！"
                                                },
                                                {
                                                    "id": "120020814",
                                                    "speaker": "石壮",
                                                    "text": "欸？！这、这个没必要吧？",
                                                    "choices": [
                                                        {
                                                            "id": "120020815",
                                                            "text": "谁让你得罪「飞云商会」。",
                                                            "response": [
                                                                {
                                                                    "id": "120020817",
                                                                    "speaker": "石壮",
                                                                    "text": "不不不，别这样，这又不是你们自己的钱，这么较真干什么呢？"
                                                                },
                                                                {
                                                                    "id": "120020818",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然是商会的钱，但钱花多了也没办法和老爷交代啊。"
                                                                },
                                                                {
                                                                    "id": "120020819",
                                                                    "speaker": "派蒙",
                                                                    "text": "到时候就只能报出你的名字，说你对我们百般刁难，坐地起价。"
                                                                },
                                                                {
                                                                    "id": "120020820",
                                                                    "speaker": "石壮",
                                                                    "text": "我、我知道啦…对不起，还请「飞云商会」不要计较。"
                                                                },
                                                                {
                                                                    "id": "120020821",
                                                                    "speaker": "石壮",
                                                                    "text": "不过…其实这批矿石在运送的时候遇到了点麻烦，有几车被丘丘人袭击了。"
                                                                },
                                                                {
                                                                    "id": "120020822",
                                                                    "speaker": "石壮",
                                                                    "text": "我也不知道具体是在什么地方，但是不回收的话，我也没办法卖给你…"
                                                                },
                                                                {
                                                                    "id": "120020823",
                                                                    "speaker": "石壮",
                                                                    "text": "能拜托你去找一找吗？我记得一共有五车，全都能找到的话，我当场就能和你签契约。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "120020824",
                                                                            "text": "一言为定！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "120020825",
                                                                                    "speaker": "石壮",
                                                                                    "text": "谢谢，不好意思让你做这种事。"
                                                                                },
                                                                                {
                                                                                    "id": "120020828",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#没办法，那我们走吧，{NICKNAME}。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "120020826",
                                                                            "text": "是正常价格吧？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "120020827",
                                                                                    "speaker": "石壮",
                                                                                    "text": "那、那当然了…我还想继续在璃月做生意呢。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120020816",
                                                            "text": "拿钱，交货。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120020810",
                                            "text": "坐地起价不太好吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120020805",
                            "text": "具体是多少钱？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200209",
