    "talks": [
        {
            "id": "2302201",
            "objective": "与拉菲克对话",
            "dialogues": [
                {
                    "id": "230220101",
                    "speaker": "拉菲克",
                    "text": "这里的强度要是再增加的话，就必须把这里…"
                },
                {
                    "id": "230220102",
                    "speaker": "绮珊",
                    "text": "如果你采用这种设计，就和之前没什么本质区别了。"
                },
                {
                    "id": "230220103",
                    "speaker": "Player",
                    "text": "你们还在设计船吗？"
                },
                {
                    "id": "230220104",
                    "speaker": "拉菲克",
                    "text": "是你啊，旅行者。没错，在上次试航结束之后，我和绮珊又讨论了一些…嗯…关键节点上的设计。"
                },
                {
                    "id": "230220105",
                    "speaker": "拉菲克",
                    "text": "在我们…充分地交流后，正准备尝试一种新的设计方案。"
                },
                {
                    "id": "230220106",
                    "speaker": "拉菲克",
                    "text": "但是在材料使用上，我们又产生了一些分歧。"
                },
                {
                    "id": "230220107",
                    "speaker": "拉菲克",
                    "text": "不过这一次！我可是听了绮珊的意见，花大价钱买了一批好材料。"
                },
                {
                    "id": "230220108",
                    "speaker": "拉菲克",
                    "text": "旅行者，你看，我一个人搬不完，绮珊的力气也不大，你就…",
                    "choices": [
                        {
                            "id": "230220109",
                            "text": "我们一起去搬。",
                            "response": [
                                {
                                    "id": "230220111",
                                    "speaker": "拉菲克",
                                    "text": "真是可靠，那我们赶紧出发吧。"
                                },
                                {
                                    "id": "230220112",
                                    "speaker": "拉菲克",
                                    "text": "这次的材料可是绮珊亲自选的，应该不会出什么问题了…"
                                },
                                {
                                    "id": "230220113",
                                    "speaker": "拉菲克",
                                    "text": "而且这次，我还给你准备了更多的报酬，真是谢谢你帮忙了…"
                                }
                            ]
                        },
                        {
                            "id": "230220110",
                            "text": "别说了，走吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302202",
            "objective": "前去拿取修船物资",
            "dialogues": [
                {
                    "id": "230220201",
                    "speaker": "绮珊",
                    "text": "…说服拉菲克多花点钱，比说服老板给我涨工资还困难。"
                }
            ]
        },
        {
            "id": "2302203",
            "objective": "前去拿取修船物资",
            "dialogues": []
        },
        {
            "id": "2302204",
            "objective": "回去向拉菲克说明情况",
            "dialogues": [
                {
                    "id": "230220401",
                    "speaker": "拉菲克",
                    "text": "怎么样，你把那些材料搬过来了吗？"
                }
            ]
        },
        {
            "id": "2302205",
            "objective": "回去向拉菲克说明情况",
            "dialogues": [
                {
                    "id": "230220501",
                    "speaker": "拉菲克",
                    "text": "好…嘞！这些材料应该就够用了。这是你的报酬。"
                },
                {
                    "id": "230220502",
                    "speaker": "拉菲克",
                    "text": "不过，这些材料还真是轻啊…绮珊选的这些材料真的可靠吗…"
                },
                {
                    "id": "230220503",
                    "speaker": "绮珊",
                    "text": "相信我，这些材料比你之前选的那些都好。"
                },
                {
                    "id": "230220504",
                    "speaker": "拉菲克",
                    "text": "那这次，你要帮我准备好救生用具。"
                },
                {
                    "id": "230220505",
                    "speaker": "绮珊",
                    "text": "…没问题的，你就相信我吧。"
                }
            ]
        },
        {
            "id": "2302206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230220601",
                    "speaker": "拉菲克",
                    "text": "这下子，我的预算就真的全都花光了…"
                }
            ]
        }
    ]
}