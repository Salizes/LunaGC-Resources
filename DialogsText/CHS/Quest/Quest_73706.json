        }
    },
    "talks": [
        {
            "id": "7370601",
            "objective": "与柯莱对话",
            "dialogues": [
                {
                    "id": "737060101",
                    "speaker": "柯莱",
                    "text": "各位，好消息来了！"
                },
                {
                    "id": "737060102",
                    "speaker": "柯莱",
                    "text": "我们为「稳健知行」机构打下的基础，已经得到了各学院权威学者们的高度认可…"
                },
                {
                    "id": "737060103",
                    "speaker": "柯莱",
                    "text": "接下来，教令院派出的专门职工会正式入场，按照我们制定的标准和规则，继续将这个机构运转下去。"
                },
                {
                    "id": "737060104",
                    "speaker": "柯莱",
                    "text": "这段时间实在有劳各位了，万分感谢各位的支持！"
                },
                {
                    "id": "737060105",
                    "speaker": "安柏",
                    "text": "好耶！努力工作的成果得到了认可，柯莱大成功！"
                },
                {
                    "id": "737060106",
                    "speaker": "珐露珊",
                    "text": "这次的交接工作也都让柯莱包圆了，真不错啊真不错…"
                },
                {
                    "id": "737060107",
                    "speaker": "珐露珊",
                    "text": "希望新入学的年轻人们都能学学你的作风，踏踏实实，把每件小事都干得无可挑剔…"
                },
                {
                    "id": "737060108",
                    "speaker": "珐露珊",
                    "text": "而不能只想着论文里的宏大目标，离开了书面推论就两眼一黑，两手一摊！"
                },
                {
                    "id": "737060109",
                    "speaker": "柯莱",
                    "text": "我，我还是非常紧张的！在各个学院的代表之间跑来跑去，沟通协调，也有点晕头转向…"
                },
                {
                    "id": "737060110",
                    "speaker": "柯莱",
                    "text": "#当然，特别需要感谢{NICKNAME}和派蒙，{M#他们}{F#她们}帮我们完善了最关键的规则，提供了最宝贵的指导意见…",
                    "choices": [
                        {
                            "id": "737060111",
                            "text": "还行还行！",
                            "response": [
                                {
                                    "id": "737060113",
                                    "speaker": "派蒙",
                                    "text": "我们对这些工作都已经习以为常了，就像是…和大家一起来了场特别的野营！"
                                },
                                {
                                    "id": "737060114",
                                    "speaker": "派蒙",
                                    "text": "期间偶尔穿插一些解谜锻炼和健身活动，还挺有意思的！又有趣味又消食…"
                                },
                                {
                                    "id": "737060115",
                                    "speaker": "派蒙",
                                    "text": "消食…欸…饿了…"
                                },
                                {
                                    "id": "737060116",
                                    "speaker": "派蒙",
                                    "text": "既然工作万事大吉了，要不要一起吃顿饭，就当是庆祝了？"
                                },
                                {
                                    "id": "737060117",
                                    "speaker": "迪希雅",
                                    "text": "派蒙还真说到了点子上了——犒劳大家的大餐，我和坎蒂丝已经准备好了！"
                                },
                                {
                                    "id": "737060118",
                                    "speaker": "坎蒂丝",
                                    "text": "几位，这边请。"
                                },
                                {
                                    "id": "737060119",
                                    "speaker": "派蒙",
                                    "text": "是大餐！庆功宴！"
                                },
                                {
                                    "id": "737060120",
                                    "speaker": "安柏",
                                    "text": "来得正好！"
                                },
                                {
                                    "id": "737060121",
                                    "speaker": "派蒙",
                                    "text": "呜，好久没吃这么丰盛的须弥菜了，怎么感觉我…口味一换，肚量翻倍？",
                                    "choices": [
                                        {
                                            "id": "737060122",
                                            "text": "那我们多来回走走。",
                                            "response": [
                                                {
                                                    "id": "737060124",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，可别小瞧了我！"
                                                },
                                                {
                                                    "id": "737060125",
                                                    "speaker": "派蒙",
                                                    "text": "当然，我也不会那么任性，还是要考虑你的钱包的。"
                                                },
                                                {
                                                    "id": "737060126",
                                                    "speaker": "珐露珊",
                                                    "text": "嗯…嗯！好久没仔细品尝过沙漠地带的料理了…"
                                                },
                                                {
                                                    "id": "737060127",
                                                    "speaker": "珐露珊",
                                                    "text": "记忆里的印象，居然被打破了？"
                                                },
                                                {
                                                    "id": "737060128",
                                                    "speaker": "珐露珊",
                                                    "text": "原来我以前在沙漠里尝到的那些菜式…都是应付了事！"
                                                },
                                                {
                                                    "id": "737060129",
                                                    "speaker": "坎蒂丝",
                                                    "text": "多谢您的认可，珐露珊女士。"
                                                },
                                                {
                                                    "id": "737060130",
                                                    "speaker": "坎蒂丝",
                                                    "text": "如果来访阿如村的学者们都像您这样彬彬有礼，我们每次都会拿出最丰盛的餐食，尽力招待他们。"
                                                },
                                                {
                                                    "id": "737060131",
                                                    "speaker": "迪希雅",
                                                    "text": "说起来，安柏小姐更是从遥远的蒙德来的…你有什么想参观的地方吗？"
                                                },
                                                {
                                                    "id": "737060132",
                                                    "speaker": "安柏",
                                                    "text": "嘿，我都想好了！"
                                                },
                                                {
                                                    "id": "737060133",
                                                    "speaker": "安柏",
                                                    "text": "听说在奥摩斯港西北，有一片长满参天大树的森林，每颗大树的树干，都比「猎鹿人」那栋房子的地基还宽…"
                                                },
                                                {
                                                    "id": "737060134",
                                                    "speaker": "安柏",
                                                    "text": "我很好奇！那里的景色看起来究竟怎么样？"
                                                },
                                                {
                                                    "id": "737060135",
                                                    "speaker": "安柏",
                                                    "text": "如果爬到树顶，从上边往下跳，再用风之翼滑翔，在巨树间穿梭，一定很有意思！"
                                                },
                                                {
                                                    "id": "737060136",
                                                    "speaker": "柯莱",
                                                    "text": "那，我准备一些湿润的糕点、团子之类的零食。"
                                                },
                                                {
                                                    "id": "737060137",
                                                    "speaker": "柯莱",
                                                    "text": "高处风大，不适合碎屑太多的食物。水袋也要选加厚款，防止一摔就坏…"
                                                },
                                                {
                                                    "id": "737060138",
                                                    "speaker": "派蒙",
                                                    "text": "哦！软软糯糯的团子确实不错，柯莱很细心嘛！"
                                                },
                                                {
                                                    "id": "737060139",
                                                    "speaker": "安柏",
                                                    "text": "沙漠这边的话，我对巨大的遗迹非常感兴趣，比如那座超厉害的，沙漏型的巨大建筑！"
                                                },
                                                {
                                                    "id": "737060140",
                                                    "speaker": "安柏",
                                                    "text": "当然，说不定须弥这边有保护遗迹的规则，我不会贸然闯进去，远远观察一番就好了。"
                                                },
                                                {
                                                    "id": "737060141",
                                                    "speaker": "安柏",
                                                    "text": "如果打扰到沉睡在里面的主人，也有点不讲礼貌，哈哈。"
                                                },
                                                {
                                                    "id": "737060142",
                                                    "speaker": "坎蒂丝",
                                                    "text": "真是宝贵的守矩意识，安柏小姐，实在令我欣慰…"
                                                },
                                                {
                                                    "id": "737060143",
                                                    "speaker": "柯莱",
                                                    "text": "嗯，以安柏平时习惯的环境，在列柱沙原长期旅行的话，肯定会觉得干燥难耐。"
                                                },
                                                {
                                                    "id": "737060144",
                                                    "speaker": "柯莱",
                                                    "text": "所以必须准备一些保湿的药膏，还有滋润皮肤的植物精油…",
                                                    "choices": [
                                                        {
                                                            "id": "737060145",
                                                            "text": "连面部护理都考虑到了吗…",
                                                            "response": [
                                                                {
                                                                    "id": "737060147",
                                                                    "speaker": "安柏",
                                                                    "text": "相比早有预期的旅行计划，这次参与「稳健知行」机构的建设，更让我惊喜！"
                                                                },
                                                                {
                                                                    "id": "737060148",
                                                                    "speaker": "安柏",
                                                                    "text": "托柯莱的福，认识了各位新朋友，我特别开心！"
                                                                },
                                                                {
                                                                    "id": "737060149",
                                                                    "speaker": "安柏",
                                                                    "text": "等到你们有空，也请来蒙德玩玩哦，我保证带你们吃个痛快，玩个尽兴！"
                                                                },
                                                                {
                                                                    "id": "737060150",
                                                                    "speaker": "迪希雅",
                                                                    "text": "那我可太期待了！"
                                                                },
                                                                {
                                                                    "id": "737060151",
                                                                    "speaker": "迪希雅",
                                                                    "text": "去枫丹的时候，我就尝到了进口的蒲公英酒，那种芳香和清甜实在让人沉醉，完全感受不到一点苦涩！"
                                                                },
                                                                {
                                                                    "id": "737060152",
                                                                    "speaker": "迪希雅",
                                                                    "text": "不过，毕竟被封在容器里，漂洋过海，口感还是受了点影响。"
                                                                },
                                                                {
                                                                    "id": "737060153",
                                                                    "speaker": "迪希雅",
                                                                    "text": "到了蒙德，就能喝到最正宗，最纯正的蒲公英酒了，我要畅饮好几桶！"
                                                                },
                                                                {
                                                                    "id": "737060154",
                                                                    "speaker": "坎蒂丝",
                                                                    "text": "偶尔也喝点酒以外的东西吧？比如，孩子们送你的赤念果荆棘粉冲泡的茶…"
                                                                },
                                                                {
                                                                    "id": "737060155",
                                                                    "speaker": "迪希雅",
                                                                    "text": "啊哈…啊哈哈，坎蒂丝…酌情，酌情尝一点而已，桶也可以是…三五个杯子那么大的小木桶嘛…"
                                                                },
                                                                {
                                                                    "id": "737060156",
                                                                    "speaker": "迪希雅",
                                                                    "text": "如果真去蒙德玩了，我一定会给你带纪念品回来的！"
                                                                },
                                                                {
                                                                    "id": "737060157",
                                                                    "speaker": "珐露珊",
                                                                    "text": "我倒是听说，西风骑士团图书馆的藏书有上万卷。"
                                                                },
                                                                {
                                                                    "id": "737060158",
                                                                    "speaker": "珐露珊",
                                                                    "text": "没准，有些机关相关的典籍，会从不同的角度分析工程问题，值得一看。"
                                                                },
                                                                {
                                                                    "id": "737060159",
                                                                    "speaker": "安柏",
                                                                    "text": "具体的数字我也不清楚啦，不过图书馆确实很大很大！"
                                                                },
                                                                {
                                                                    "id": "737060160",
                                                                    "speaker": "安柏",
                                                                    "text": "珐露珊女士对哪些书感兴趣？我现在就记一下，提前和丽莎小姐打个招呼，准备得妥妥当当。"
                                                                },
                                                                {
                                                                    "id": "737060161",
                                                                    "speaker": "安柏",
                                                                    "text": "总之，大家的旅行安排，都包在我身上！"
                                                                },
                                                                {
                                                                    "id": "737060162",
                                                                    "speaker": "珐露珊",
                                                                    "text": "丽莎…丽莎·敏兹？那个居勒什老和我炫耀的学生…居然在这儿埋伏着我？"
                                                                },
                                                                {
                                                                    "id": "737060163",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，这种感觉真棒！"
                                                                },
                                                                {
                                                                    "id": "737060164",
                                                                    "speaker": "派蒙",
                                                                    "text": "原本没想过会有关联的朋友，通过我们也认识的中间人，建立起新的友谊…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737060165",
                                                                            "text": "世界是在动态发展的嘛。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737060167",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯！以后也可以由我们来牵线搭桥，让性格一看上去就合拍的伙伴们互相认识！"
                                                                                },
                                                                                {
                                                                                    "id": "737060168",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "感觉会有聊不完的、异想天开的话题，一起能做的事情也乐趣多多！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737060166",
                                                                            "text": "朋友遍大陆多好呀！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737060146",
                                                            "text": "柯莱的体贴全方位进化了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737060123",
                                            "text": "看你哪天一口一家饭店。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737060112",
                            "text": "功劳大家平分！"
                        }
                    ]
                }
            ]
        }
    ]
}