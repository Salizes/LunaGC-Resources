    "talks": [
        {
            "id": "7216501",
            "objective": "(test)第一日$HIDDEN",
            "dialogues": [
                {
                    "id": "721650101",
                    "speaker": "小卷",
                    "text": "你们回来了，请问有什么事吗？"
                },
                {
                    "id": "721650102",
                    "speaker": "Player",
                    "text": "请为我占卜一下吧！"
                },
                {
                    "id": "721650103",
                    "speaker": "派蒙",
                    "text": "#我也想知道{NICKNAME}今天会有怎样的好运气！"
                },
                {
                    "id": "721650104",
                    "speaker": "小卷",
                    "text": "嗯…从「灵草」叶片的纹理来看…是好运哟。"
                },
                {
                    "id": "721650105",
                    "speaker": "小卷",
                    "text": "两位会在海祇岛的最高处，供奉神的旧地，与好运相遇。"
                },
                {
                    "id": "721650106",
                    "speaker": "派蒙",
                    "text": "唔…怎么我看不出来这么多信息呢…"
                },
                {
                    "id": "721650107",
                    "speaker": "小卷",
                    "text": "呵呵，这是本地老人的智慧哟。"
                },
                {
                    "id": "721650108",
                    "speaker": "派蒙",
                    "text": "这种敷衍的回答…好可疑！"
                }
            ]
        },
        {
            "id": "7216502",
            "objective": "(test)第一日刷group$HIDDEN",
            "dialogues": [
                {
                    "id": "721650201",
                    "speaker": "小卷",
                    "text": "你们好呀，年轻人。今天有什么事吗？"
                },
                {
                    "id": "721650202",
                    "speaker": "Player",
                    "text": "请为我占卜一下吧！"
                },
                {
                    "id": "721650203",
                    "speaker": "派蒙",
                    "text": "哼哼，今天又有怎样的运势呢~"
                },
                {
                    "id": "721650204",
                    "speaker": "小卷",
                    "text": "嗯…根据「灵草」的预言…会有厄运啊…"
                },
                {
                    "id": "721650205",
                    "speaker": "小卷",
                    "text": "两位在海祇岛的南方的洞窟，贼匪的巢穴，会遭遇不期而至的厄运…"
                },
                {
                    "id": "721650206",
                    "speaker": "派蒙",
                    "text": "欸，是厄运！那我们避开那种地方好了…"
                },
                {
                    "id": "721650207",
                    "speaker": "小卷",
                    "text": "呵呵，但是呢…"
                },
                {
                    "id": "721650208",
                    "speaker": "小卷",
                    "text": "若克服厄运的话，说不定会有意外的收获。"
                },
                {
                    "id": "721650209",
                    "speaker": "派蒙",
                    "text": "收获…？是宝藏吗？是宝藏吗！"
                },
                {
                    "id": "721650210",
                    "speaker": "小卷",
                    "text": "我没说是哟…"
                },
                {
                    "id": "721650211",
                    "speaker": "派蒙",
                    "text": "哦…"
                },
                {
                    "id": "721650212",
                    "speaker": "小卷",
                    "text": "但我也没说不是。"
                },
                {
                    "id": "721650213",
                    "speaker": "派蒙",
                    "text": "哇！这个老婆婆怎么这样！"
                }
            ]
        },
        {
            "id": "7216511",
            "objective": "",
            "dialogues": [
                {
                    "id": "721651101",
                    "speaker": "小卷",
                    "text": "呵呵，好运是急不来的…况且，「灵草」也需要休息呀。"
                },
                {
                    "id": "721651102",
                    "speaker": "小卷",
                    "text": "不过呀，还是很感谢你们来和我一个老人家打招呼，祝你们一路平安。"
                }
            ]
        },
        {
            "id": "7216503",
            "objective": "(test)第二日$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7216504",
            "objective": "(test)第二日刷group$HIDDEN",
            "dialogues": [
                {
                    "id": "721650401",
                    "speaker": "小卷",
                    "text": "你们好呀，年轻人。今天有什么事吗？"
                },
                {
                    "id": "721650402",
                    "speaker": "Player",
                    "text": "请为我占卜一下吧！"
                },
                {
                    "id": "721650403",
                    "speaker": "派蒙",
                    "text": "我也想知道今天的运势！"
                },
                {
                    "id": "721650404",
                    "speaker": "小卷",
                    "text": "唔…根据「灵草」的意见…是厄运。"
                },
                {
                    "id": "721650405",
                    "speaker": "小卷",
                    "text": "东方毁弃的神龛，缠绕着厄运的气息…"
                },
                {
                    "id": "721650406",
                    "speaker": "派蒙",
                    "text": "哇…听起来好可怕…"
                },
                {
                    "id": "721650407",
                    "speaker": "小卷",
                    "text": "但是呢…"
                },
                {
                    "id": "721650408",
                    "speaker": "小卷",
                    "text": "只要挺身而出，战胜厄运，便会赢得理所应得的奖励。"
                },
                {
                    "id": "721650409",
                    "speaker": "Player",
                    "text": "和上次的说法差不多呢…"
                },
                {
                    "id": "721650410",
                    "speaker": "小卷",
                    "text": "呵呵，生活就是这样…新鲜的经历，总是藏在似曾相识的日子里。"
                }
            ]
        },
        {
            "id": "7216505",
            "objective": "(test)第三日$HIDDEN",
            "dialogues": [
                {
                    "id": "721650301",
                    "speaker": "小卷",
                    "text": "你们好呀，年轻人。今天有什么事吗？"
