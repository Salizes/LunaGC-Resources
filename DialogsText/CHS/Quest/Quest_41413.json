        {
            "id": "4141304",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "414130401",
                    "speaker": "琴",
                    "text": "感谢你，风花节之星。我们已向风神巴巴托斯献上饱含敬爱的「风之花」，愿风护佑蒙德。"
                },
                {
                    "id": "414130402",
                    "speaker": "温迪",
                    "text": "不错的选择哦。"
                },
                {
                    "id": "414130403",
                    "speaker": "Player",
                    "text": "你喜欢吗？"
                },
                {
                    "id": "414130404",
                    "speaker": "温迪",
                    "text": "嗯——你猜？"
                },
                {
                    "id": "414130405",
                    "speaker": "派蒙",
                    "text": "又让人猜，这个坏家伙！"
                },
                {
                    "id": "414130406",
                    "speaker": "温迪",
                    "text": "啊哈哈哈哈！会告诉你的啦，不过不是在这里。"
                },
                {
                    "id": "414130407",
                    "speaker": "温迪",
                    "text": "人来人往的广场不方便聊这些，换个地方吧。"
                },
                {
                    "id": "414130408",
                    "speaker": "派蒙",
                    "text": "去哪儿好呢？"
                },
                {
                    "id": "414130409",
                    "speaker": "温迪",
                    "text": "我想邀请你和我一起到「风龙废墟」去。"
                }
            ]
        },
        {
            "id": "4141305",
            "objective": "前往风龙废墟",
            "dialogues": []
        },
        {
            "id": "4141306",
            "objective": "解决废墟内风场紊乱的问题",
            "dialogues": []
        },
        {
            "id": "4141307",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "414130701",
                    "speaker": "温迪",
                    "text": "嗯！还是这里的景色最好。",
                    "choices": [
                        {
                            "id": "414130702",
                            "text": "好漂亮的风景。",
                            "response": [
                                {
                                    "id": "414130704",
                                    "speaker": "温迪",
                                    "text": "是啊，我很喜欢这个地方，闲暇时总会过来坐一会儿，看看风景。"
                                },
                                {
                                    "id": "414130705",
                                    "speaker": "派蒙",
                                    "text": "是来偷懒的吧？"
                                },
                                {
                                    "id": "414130706",
                                    "speaker": "温迪",
                                    "text": "哈哈哈，被你发现了！"
                                },
                                {
                                    "id": "414130707",
                                    "speaker": "温迪",
                                    "text": "如此美景，手里要是有杯苹果酒该多好。"
                                },
                                {
                                    "id": "414130708",
                                    "speaker": "温迪",
                                    "text": "旅行者，蒙德的风花节，你喜欢吗？",
                                    "choices": [
                                        {
                                            "id": "414130709",
                                            "text": "充满人情味，又很热闹。",
                                            "response": [
                                                {
                                                    "id": "414130711",
                                                    "speaker": "温迪",
                                                    "text": "但还是有所疑问，对不对？"
                                                },
                                                {
                                                    "id": "414130712",
                                                    "speaker": "Player",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "414130713",
                                                    "speaker": "温迪",
                                                    "text": "我知道你想问什么。究竟什么是「风之花」？风神巴巴托斯眼中的「风之花」与「风花节」又意味着什么？"
                                                },
                                                {
                                                    "id": "414130714",
                                                    "speaker": "温迪",
                                                    "text": "如你所见，蒙德人民各有选择。有人从千万种花朵里选择了蒲公英，有人则挑选了风车菊。"
                                                },
                                                {
                                                    "id": "414130715",
                                                    "speaker": "派蒙",
                                                    "text": "每个人心中的「风之花」，好像都不一样。"
                                                },
                                                {
                                                    "id": "414130716",
                                                    "speaker": "温迪",
                                                    "text": "是啊，本该如此。没有唯一的答案，也没有真实存在过的「风之花」。"
                                                },
                                                {
                                                    "id": "414130717",
                                                    "speaker": "派蒙",
                                                    "text": "咦…不存在吗？"
                                                },
                                                {
                                                    "id": "414130718",
                                                    "speaker": "温迪",
                                                    "text": "「风之花」这个词语，最初只是旧蒙德时代，人民之间相互联络、共约反抗的暗语罢了。"
                                                },
                                                {
                                                    "id": "414130719",
                                                    "speaker": "温迪",
                                                    "text": "那时人们常说，风越大，「风之花」的根基就越稳固，花朵也绽放得越鲜艳。"
                                                },
                                                {
                                                    "id": "414130720",
                                                    "speaker": "温迪",
                                                    "text": "要我说的话，它并不存在，也无处不在。"
                                                },
                                                {
                                                    "id": "414130721",
                                                    "speaker": "温迪",
                                                    "text": "它是向往自由的灵魂、是追逐风向的勇气…一切美好、值得被祝福的事物，都可以是「风之花」。"
                                                },
                                                {
                                                    "id": "414130722",
                                                    "speaker": "派蒙",
                                                    "text": "看似不存在，却又无处不在的东西，就像风一样！"
                                                },
                                                {
                                                    "id": "414130723",
                                                    "speaker": "温迪",
                                                    "text": "哈哈，你说得没错。"
                                                },
                                                {
                                                    "id": "414130724",
                                                    "speaker": "温迪",
                                                    "text": "所以，风神巴巴托斯不会定义何为「风之花」。"
                                                },
                                                {
                                                    "id": "414130725",
                                                    "speaker": "温迪",
                                                    "text": "祝福之花、敬爱之花、深爱之花。每个人都会有属于自己的「风之花」，每个人都有自由定义它的权利。"
                                                },
                                                {
                                                    "id": "414130726",
                                                    "speaker": "派蒙",
                                                    "text": "自由之都蒙德献给风神的花，果然非常自由呢。"
                                                },
                                                {
                                                    "id": "414130727",
                                                    "speaker": "Player",
                                                    "text": "我也喜欢自由的感觉。"
                                                },
                                                {
                                                    "id": "414130728",
                                                    "speaker": "温迪",
                                                    "text": "我知道。"
                                                },
                                                {
                                                    "id": "414130729",
                                                    "speaker": "温迪",
                                                    "text": "人们会因为共同的意志走到一起，牵引你我相遇的，想必是自由之风。"
                                                },
                                                {
                                                    "id": "414130730",
                                                    "speaker": "温迪",
                                                    "text": "它来自旅途的尽头、世界的边缘。来自你我心中，永不停歇。"
                                                },
                                                {
                                                    "id": "414130731",
                                                    "speaker": "温迪",
                                                    "text": "「是谁轻抚你带伤却坚毅的面容\\n在小溪边\\n在巨岩旁」"
                                                },
                                                {
                                                    "id": "414130732",
                                                    "speaker": "温迪",
                                                    "text": "「是谁紧拥你疲惫而高贵的灵魂\\n在深梦里\\n在高天之上」"
                                                },
                                                {
                                                    "id": "414130733",
                                                    "speaker": "温迪",
                                                    "text": "「亲爱的朋友\\n我牵着你的手\\n带你走进夜晚华灯」"
                                                },
                                                {
                                                    "id": "414130734",
                                                    "speaker": "温迪",
                                                    "text": "「为你从头讲述\\n节日里那自由与梦的乐章」"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "414130710",
                                            "text": "跟大家在一起，非常开心。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "414130703",
                            "text": "气氛真不错。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4141397",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414139701",
                    "speaker": "琴",
                    "text": "愿风送去我们的祝福与赞美。"
                }
            ]
        },
        {
            "id": "4141398",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414139801",
                    "speaker": "温迪",
                    "text": "今年的「风之花」会是什么花呢？好期待啊。"
                }
            ]
        },
        {
            "id": "4141399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414139901",
                    "speaker": "琴",
                    "text": "遵循心意，选择你所认可的「风之花」吧。"
                }
            ]
        }
    ]
}