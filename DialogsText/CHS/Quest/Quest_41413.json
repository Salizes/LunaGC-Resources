        }
    },
    "talks": [
        {
            "id": "4141301",
            "objective": "等到约定的时间，前往蒙德广场",
            "dialogues": []
        },
        {
            "id": "4141302",
            "objective": "与琴对话",
            "dialogues": [
                {
                    "id": "414130201",
                    "speaker": "派蒙",
                    "text": "琴团长，我们来啦。"
                },
                {
                    "id": "414130202",
                    "speaker": "琴",
                    "text": "旅行者！啊，不，这里或许该称呼你为荣誉骑士。"
                },
                {
                    "id": "414130203",
                    "speaker": "琴",
                    "text": "想必你已经听说了，你是本届的「风花节之星」，将代表全蒙德人向风神巴巴托斯献上「风之花」。"
                },
                {
                    "id": "414130204",
                    "speaker": "琴",
                    "text": "不过…这次似乎略有不同呢。"
                },
                {
                    "id": "414130205",
                    "speaker": "派蒙",
                    "text": "有我们，还有卖唱的，这次风花节是不是格外热闹呀！"
                },
                {
                    "id": "414130206",
                    "speaker": "琴",
                    "text": "是的。感谢你们常驻蒙德，也希望你们今后继续享受在蒙德的生活。"
                },
                {
                    "id": "414130207",
                    "speaker": "琴",
                    "text": "风花典礼快要开始了。风花节之星，选好属于你的「风之花」了吗？"
                },
                {
                    "id": "414130208",
                    "speaker": "派蒙",
                    "text": "我们必须选出一种花，把它献给风神，对吗？"
                },
                {
                    "id": "414130209",
                    "speaker": "琴",
                    "text": "没错，请你慎重考虑之后做出选择。别忘了，你的选择代表着全蒙德。"
                },
                {
                    "id": "414130210",
                    "speaker": "Player",
                    "text": "温迪，你喜欢什么花？"
                },
                {
                    "id": "414130211",
                    "speaker": "温迪",
                    "text": "嗯？好狡猾呀，居然直接问我。"
                },
                {
                    "id": "414130212",
                    "speaker": "琴",
                    "text": "咳咳…"
                },
                {
                    "id": "414130213",
                    "speaker": "派蒙",
                    "text": "不要在这种场合说悄悄话啦你们两个！"
                },
                {
                    "id": "414130214",
                    "speaker": "温迪",
                    "text": "哈哈，被训了呢！"
                },
                {
                    "id": "414130215",
                    "speaker": "温迪",
                    "text": "不用在意我，选喜欢的就好。我相信你的品味。"
                },
                {
                    "id": "414130216",
                    "speaker": "琴",
                    "text": "那么，荣誉骑士，你的选择是…",
                    "choices": [
                        {
                            "id": "414130217",
                            "text": "蒲公英",
                            "response": [
                                {
                                    "id": "414130218",
                                    "speaker": "派蒙",
                                    "text": "哦！支持者众多的热门选择，「风之花」一定就是蒲公英啦！"
                                },
                                {
                                    "id": "414130229",
                                    "speaker": "琴",
                                    "text": "请代表蒙德人，向神像献上你的「风之花」。"
                                }
                            ]
                        },
                        {
                            "id": "414130219",
                            "text": "风车菊",
                            "response": [
                                {
                                    "id": "414130220",
                                    "speaker": "派蒙",
                                    "text": "哦！是支持者众多的热门选择，「风之花」一定就是风车菊啦！"
                                }
                            ]
                        },
                        {
                            "id": "414130221",
                            "text": "塞西莉亚花",
                            "response": [
                                {
                                    "id": "414130222",
                                    "speaker": "派蒙",
                                    "text": "哦！与贝雅特丽奇意见一致，「风之花」是较为冷门却有着坚定拥护者的塞西莉亚花！"
                                }
                            ]
                        },
                        {
                            "id": "414130223",
                            "text": "小灯草",
                            "response": [
                                {
                                    "id": "414130224",
                                    "speaker": "派蒙",
                                    "text": "哦！与宁禄意见一致，「风之花」是能照亮黑暗的小灯草！"
                                }
                            ]
                        },
                        {
                            "id": "414130225",
                            "text": "甜甜花",
                            "response": [
                                {
                                    "id": "414130226",
                                    "speaker": "派蒙",
                                    "text": "哦！与砂糖意见一致，「风之花」是从古到今生生不息的甜甜花！"
                                }
                            ]
                        },
                        {
                            "id": "414130227",
                            "text": "钩钩果",
                            "response": [
                                {
                                    "id": "414130228",
                                    "speaker": "派蒙",
                                    "text": "哦！与雷泽意见一致，「风之花」是刺刺的麻麻的钩钩果！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
