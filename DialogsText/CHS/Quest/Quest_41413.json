        "rewards_formatted": "原石 x60, 大英雄的经验 x3, 摩拉 x30000",
        "chapter": {
            "icon": "UI_ChapterIcon_FleurFair",
            "id": "10024",
            "num": "风花节 其四",
            "title": "风与花之梦"
        },
        "total_dialogue_lines": 75,
        "total_speaker_counts": {
