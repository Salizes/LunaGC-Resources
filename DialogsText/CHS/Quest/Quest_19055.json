    "talks": [
        {
            "id": "1905516",
            "objective": "等到晚上（20点~24点）",
            "dialogues": [
                {
                    "id": "190551601",
                    "speaker": "五郎",
                    "text": "#{NICKNAME}，再次向你道歉，我没有对你说实话，真的很过意不去，但我…不得不这么做。"
                },
                {
                    "id": "190551602",
                    "speaker": "Player",
                    "text": "我理解。"
                },
                {
                    "id": "190551603",
                    "speaker": "Player",
                    "text": "对了，心海知道这事吗？"
                },
                {
                    "id": "190551604",
                    "speaker": "五郎",
                    "text": "珊瑚宫大人么…只能说，战争带来了很多糟糕的东西，也让我们成长了很多。"
                },
                {
                    "id": "190551605",
                    "speaker": "派蒙",
                    "text": "那到底是知道还是不知道啊？"
                },
                {
                    "id": "190551606",
                    "speaker": "五郎",
                    "text": "这…你们不好奇，是谁推动的新商品法案吗？不可能是勘定奉行，这对他们没有直接好处，我们也没有熟人在那边。"
                },
                {
                    "id": "190551607",
                    "speaker": "派蒙",
                    "text": "是哦，这样说起来，就好像是神明的援手一样，突然帮了你们一把。"
                },
                {
                    "id": "190551608",
                    "speaker": "五郎",
                    "text": "哈哈，神明吗…"
                },
                {
                    "id": "190551609",
                    "speaker": "五郎",
                    "text": "前一阵子鸣神岛那边举办了容彩祭，我和珊瑚宫大人也应邀前去参加了。"
                },
                {
                    "id": "190551610",
                    "speaker": "五郎",
                    "text": "那时我在集市等待，而珊瑚宫大人去了…"
                }
            ]
        },
        {
            "id": "1905501",
            "objective": "前往望泷村",
            "dialogues": [
                {
                    "id": "190550901",
                    "speaker": "德田",
                    "text": "轰大叔，货已经到了，请来清点一下。"
                },
                {
                    "id": "190550902",
                    "speaker": "轰大叔",
                    "text": "嗯，走吧。"
                },
                {
                    "id": "190550903",
                    "speaker": "派蒙",
                    "text": "轰…唔!"
                },
                {
                    "id": "190550904",
                    "speaker": "鹿野院平藏",
                    "text": "嘘！别出声，我们偷偷跟上去。"
                }
            ]
        },
        {
            "id": "1905503",
            "objective": "跟踪轰大叔与德田",
            "dialogues": []
        },
        {
            "id": "1905504",
            "objective": "偷听轰大叔与德田的谈话",
            "dialogues": [
                {
                    "id": "190551001",
                    "speaker": "德田",
                    "text": "大叔的情报很准确啊，我们到的时候，那伙野伏众居然还在睡大觉，哈哈。"
                },
                {
                    "id": "190551002",
                    "speaker": "德田",
                    "text": "被我们一网打尽，货物也全部收缴回来了，都在这了。"
                },
                {
                    "id": "190551003",
                    "speaker": "轰大叔",
                    "text": "我来清点…嗯…都没问题，辛苦了。"
                },
                {
                    "id": "190551004",
                    "speaker": "德田",
                    "text": "哪里的话，多亏了轰大叔的商队去努力贸易，村里粮食的价格才能降下来。"
                },
                {
                    "id": "190551005",
                    "speaker": "将司",
                    "text": "就是就是，还有我们这些老伤号，谁会想到打仗留下的后遗症这么厉害啊，幸好有轰大叔带回来的救命药。"
                },
                {
                    "id": "190551006",
                    "speaker": "轰大叔",
                    "text": "要多谢上面的支持，所以情况才会变好。村里的库存情况怎么样？"
                },
                {
                    "id": "190551007",
                    "speaker": "轰大叔",
                    "text": "今晚就要确认，明天一早，我去珊瑚宫请示五郎大人后，就得出发了。"
                },
                {
                    "id": "190551008",
                    "speaker": "将司",
                    "text": "放心，轰大叔，我们把清单都整理好了，跟我们来吧。"
                }
            ]
        },
        {
            "id": "1905514",
            "objective": "",
            "dialogues": [
                {
                    "id": "190551401",
                    "speaker": "派蒙",
                    "text": "这个箱子装得好紧，让我看看里面有什么…"
                },
                {
                    "id": "190551402",
                    "speaker": "派蒙",
                    "text": "咦？这些花花草草是什么呀？不认识…哦，还有一张小纸条。"
                },
                {
                    "id": "190551403",
                    "speaker": "破损的账单",
                    "text": "（一张破损的账单，字迹已经被水渍晕开，很难辨识，只能依稀看见落款处的「外行商会」几字。）"
                }
            ]
        },
        {
            "id": "1905505",
            "objective": "调查货物",
            "dialogues": [
                {
                    "id": "190551201",
                    "speaker": "派蒙",
                    "text": "呜哇！这些是清心欸！我还以为会是珊瑚真珠…"
                }
            ]
        },
        {
            "id": "1905512",
            "objective": "调查货物",
            "dialogues": [
                {
                    "id": "190551301",
                    "speaker": "派蒙",
                    "text": "琉璃百合！这是用来干什么的，不应该是晶化骨髓什么的嘛…"
                }
            ]
        },
        {
            "id": "1905513",
            "objective": "调查货物",
            "dialogues": []
        },
        {
            "id": "1905515",
            "objective": "",
            "dialogues": [
                {
                    "id": "190551501",
                    "speaker": "七尾",
                    "text": "小爷，您看咱这么配合，别忘了给咱美言几句啊！"
                }
            ]
        },
        {
            "id": "1905506",
            "objective": "与平藏交谈",
            "dialogues": []
        },
        {
            "id": "1905507",
            "objective": "跟随平藏前往关押犯人的地点",
            "dialogues": []
        },
        {
            "id": "1905508",
            "objective": "与犯人交谈",
            "dialogues": []
        },
        {
            "id": "1905510",
            "objective": "等到第二天早上（次日8点~12点）",
            "dialogues": []
        },
        {
            "id": "1905509",
            "objective": "与轰大叔对质",
            "dialogues": []
        },
        {
            "id": "1905511",
            "objective": "去附近跟平藏聊聊",
            "dialogues": [
                {
                    "id": "190551101",
                    "speaker": "鹿野院平藏",
                    "text": "让我看看有什么好东西。"
                }
            ]
        },
        {
            "id": "1905517",
            "objective": "",
            "dialogues": [
                {
                    "id": "190551701",
                    "speaker": "Player",
                    "text": "她去见了那位神子大人。"
                },
                {
                    "id": "190551702",
                    "speaker": "五郎",
                    "text": "没错。"
                },
                {
                    "id": "190551802",
                    "speaker": "五郎",
                    "text": "她去勘定奉行府见了那位神子大人，名义上是轻小说的鉴赏会，但会晤还有其他内容，虽然没有公开…"
                },
                {
                    "id": "190551803",
                    "speaker": "五郎",
                    "text": "在她回来以后，我们就开始了提振商贸的措施，而鸣神岛那边，很快也有了新商品法案的推动…"
                },
                {
                    "id": "190551804",
                    "speaker": "五郎",
                    "text": "所以，你们觉得珊瑚宫大人知道这件事吗？"
                }
            ]
        },
        {
            "id": "1905518",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190551801",
                    "speaker": "Player",
                    "text": "我不记得了。"
                }
            ]
        }
    ]
}