    "talks": [
        {
            "id": "1202301",
            "objective": "前往篝火晚会现场",
            "dialogues": [
                {
                    "id": "120230101",
                    "speaker": "珊瑚宫心海",
                    "text": "看来庆功宴准备得差不多了，不过在酒宴开始之前，我还得简单地演讲一下。"
                },
                {
                    "id": "120230102",
                    "speaker": "派蒙",
                    "text": "唔…心海的能量还够用吗？"
                },
                {
                    "id": "120230103",
                    "speaker": "珊瑚宫心海",
                    "text": "放心，完全够用。有你们的帮助，我的能量回复得很快。"
                },
                {
                    "id": "120230104",
                    "speaker": "派蒙",
                    "text": "太好了。我们也会帮你加油助威的！"
                },
                {
                    "id": "120230105",
                    "speaker": "珊瑚宫心海",
                    "text": "大家辛苦了，今天是属于我们的庆功会。"
                },
                {
                    "id": "120230106",
                    "speaker": "珊瑚宫心海",
                    "text": "在过去的一段时间里，我们与幕府军的战争告一段落，也见证了眼狩令的废除。"
                },
                {
                    "id": "120230107",
                    "speaker": "珊瑚宫心海",
                    "text": "稻妻的未来会变成什么样，我也无法预料。但明天我将与天领奉行展开和谈，为海祇岛争取和平。"
                },
                {
                    "id": "120230108",
                    "speaker": "珊瑚宫心海",
                    "text": "感谢各位一直以来的努力，正因为你们的努力，我们才能打赢这一场艰难的战役。"
                },
                {
                    "id": "120230109",
                    "speaker": "珊瑚宫心海",
                    "text": "这场庆功会是为在场的每个人准备的，希望大家好好享受这来之不易的胜利。"
                },
                {
                    "id": "120230110",
                    "speaker": "海祇岛众人",
                    "text": "喔——！！"
                },
                {
                    "id": "120230111",
                    "speaker": "珊瑚宫心海",
                    "text": "看来晚会进行的很顺利，没出什么问题真的太好了。"
                },
                {
                    "id": "120230112",
                    "speaker": "珊瑚宫心海",
                    "text": "#人在开心的时候，往往倾诉欲也会提高。{NICKNAME}，可以拜托你再帮我收集一些情报吗？"
                },
                {
                    "id": "120230113",
                    "speaker": "珊瑚宫心海",
                    "text": "关于「天领奉行勾结愚人众」这件事，到现在还没有进一步的线索。"
                },
                {
                    "id": "120230114",
                    "speaker": "珊瑚宫心海",
                    "text": "我很担心明天的和谈，会不会出什么事…"
                },
                {
                    "id": "120230115",
                    "speaker": "派蒙",
                    "text": "好吧，那我们再去问问。"
                }
            ]
        },
        {
            "id": "1202310",
            "objective": "等待到晚上（18点-6点）",
            "dialogues": [
                {
                    "id": "120231001",
                    "speaker": "有泽",
                    "text": "以前我有一个朋友，特别期待宴会，还跟我约好在庆功宴上唱歌。要是他还在就好了…"
                }
            ]
        },
        {
            "id": "1202311",
            "objective": "刷出第一波人群$HIDDEN",
            "dialogues": [
                {
                    "id": "120231101",
                    "speaker": "松田",
                    "text": "有我在，不会有人敢在庆功宴上闹事！"
                }
            ]
        },
        {
            "id": "1202302",
            "objective": "听心海发表演说",
            "dialogues": []
        },
        {
            "id": "1202312",
            "objective": "心海闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "120230301",
                    "speaker": "高善",
                    "text": "好强…不愧是珊瑚宫大人选中的人。"
                },
                {
                    "id": "120230302",
                    "speaker": "高善",
                    "text": "你的身上还有战斗的意志…也许，你可以理解我们。"
                },
                {
                    "id": "120230303",
                    "speaker": "高善",
                    "text": "剑鱼二番队的队长…你会成为我们的同伴吗？"
                },
                {
                    "id": "120230304",
                    "speaker": "Player",
                    "text": "先告诉我发生了什么。"
                },
                {
                    "id": "120230305",
                    "speaker": "高善",
                    "text": "……"
                },
                {
                    "id": "120230306",
                    "speaker": "高善",
                    "text": "「天领奉行勾结愚人众」这件事，其实是我们编造的。"
                },
                {
                    "id": "120230307",
                    "speaker": "派蒙",
                    "text": "怎、怎么这样！心海一直在担心的问题，居然是你们编的？"
                },
                {
                    "id": "120230308",
                    "speaker": "派蒙",
                    "text": "你们为什么要这么做呢？这可能会导致你们和天领奉行继续打下去呀！"
                },
                {
                    "id": "120230309",
                    "speaker": "高善",
                    "text": "我们要的，就是这样的结果。"
                },
                {
                    "id": "120230310",
                    "speaker": "高善",
                    "text": "和谈？哼，就是因为每个人都这么想，海祇岛才没有未来可言。"
                },
                {
                    "id": "120230311",
                    "speaker": "高善",
                    "text": "谁能保证天领奉行不会半路变卦？谁能保证雷电将军不会颁布下一次眼狩令？"
                },
                {
                    "id": "120230312",
                    "speaker": "高善",
                    "text": "我们反抗军，最重要的就是战斗的意志！"
                },
                {
                    "id": "120230313",
                    "speaker": "高善",
                    "text": "天领奉行和雷电将军都不可信，能够相信的只有我们自己！"
                },
                {
                    "id": "120230314",
                    "speaker": "高善",
                    "text": "你也是这么认为的吧？"
                },
                {
                    "id": "120230315",
                    "speaker": "派蒙",
                    "text": "他说的好像很有道理，但我总觉得哪里怪怪的…"
                },
                {
                    "id": "120230316",
                    "speaker": "Player",
                    "text": "只是你们想打而已吧。"
                },
                {
                    "id": "120230317",
                    "speaker": "派蒙",
                    "text": "对哦。你说了半天，都是自己的猜测不是吗？"
                },
                {
                    "id": "120230318",
                    "speaker": "派蒙",
                    "text": "为了这个猜测，你们就编造了这样的传闻，打算毁掉很多人辛苦盼来的和平吗？"
                },
                {
                    "id": "120230319",
                    "speaker": "高善",
                    "text": "别一副事不关己的样子对我说教！你们又明白什么？"
                },
                {
                    "id": "120230320",
                    "speaker": "高善",
                    "text": "为了赢下来，我们将战斗的意志贯彻到了极致，但现在你们突然告诉我，这些都没用了…"
                },
                {
                    "id": "120230321",
                    "speaker": "高善",
                    "text": "要我们放下武器，像普通人一样地生活，怎么可能呢？我闭上眼睛，总会想起那些在战场上牺牲的同伴。"
                },
                {
                    "id": "120230322",
                    "speaker": "高善",
                    "text": "每当他们的身影出现在我的脑海，我就绝对无法原谅天领奉行，无法原谅眼狩令！"
                },
                {
                    "id": "120230323",
                    "speaker": "高善",
                    "text": "看来你和我们不是一路人…你可以把这些话告诉珊瑚宫大人。但是，现在想阻止我们已经来不及了…"
                },
                {
                    "id": "120230324",
                    "speaker": "派蒙",
                    "text": "来不及了？那是什么意思？"
                },
                {
                    "id": "120230325",
                    "speaker": "高善",
                    "text": "……"
                },
                {
                    "id": "120230326",
                    "speaker": "派蒙",
                    "text": "唔…他似乎不打算回答了。"
                },
                {
                    "id": "120230327",
                    "speaker": "派蒙",
                    "text": "#怎么办{NICKNAME}，事情紧急，我们还是先去告诉心海吧！"
                }
            ]
        },
        {
            "id": "1202308",
            "objective": "与附近民众对话",
            "dialogues": [
                {
                    "id": "120230501",
                    "speaker": "平井",
                    "text": "多亏了珊瑚宫大人，海祇岛才有现在的和平…"
                },
                {
                    "id": "120230502",
                    "speaker": "Player",
                    "text": "最近有发生什么事吗？"
                },
                {
                    "id": "120230503",
                    "speaker": "平井",
                    "text": "最近？我想想啊…"
                },
                {
                    "id": "120230504",
                    "speaker": "平井",
                    "text": "对我们来说，最近的大事就是终于可以出海捕鱼了。"
                },
                {
                    "id": "120230505",
                    "speaker": "平井",
                    "text": "之前打仗的时候，海上有好多战船，我们只能在附近捞捞小鱼小虾。"
                },
                {
                    "id": "120230506",
                    "speaker": "平井",
                    "text": "有的时候收获不佳，大家都吃不饱。小孩子没日没夜地哭闹，我却一点办法都没有。"
                },
                {
                    "id": "120230507",
                    "speaker": "平井",
                    "text": "每天晚上肚子咕噜噜地叫个不停，翻来覆去睡不着觉，好不容易才能熬到天亮。现在终于好一些了…"
                },
                {
                    "id": "120230508",
                    "speaker": "平井",
                    "text": "我听说了，你是剑鱼二番队的队长吧，谢谢你帮我们打赢了这场仗。这条鱼给你，刚捞上来的，别嫌弃哈。"
                },
                {
                    "id": "120230509",
                    "speaker": "派蒙",
                    "text": "不不不，这怎么好意思…"
                },
                {
                    "id": "120230510",
                    "speaker": "平井",
                    "text": "哈哈，收着吧。没有你，说不定我们现在还在饿肚子呢。珊瑚宫大人教导我们，人要知恩图报。"
                },
                {
                    "id": "120230511",
                    "speaker": "派蒙",
                    "text": "#好吧，谢谢你。{NICKNAME}，我们再去问问别人吧。"
                }
            ]
        },
        {
            "id": "1202309",
            "objective": "与附近民众对话",
            "dialogues": [
                {
                    "id": "120230601",
                    "speaker": "蒲泽",
                    "text": "瞧一瞧看一看，新鲜的瓜果蔬菜，烧烤解腻必备之选！"
                },
                {
                    "id": "120230602",
                    "speaker": "Player",
                    "text": "最近有发生什么事吗？"
                },
                {
                    "id": "120230603",
                    "speaker": "蒲泽",
                    "text": "你说天领奉行勾结愚人众的事情？我也听到了这样的消息，但没有更多的情报。"
                },
                {
                    "id": "120230604",
                    "speaker": "蒲泽",
                    "text": "不过你说士兵比较亢奋，我倒是也有同感。看到那边那个士兵了吗？"
                },
                {
                    "id": "120230605",
                    "speaker": "蒲泽",
                    "text": "最近他就有些不太正常。嗓门特别大，没事就拿着长枪空挥几下，可吓人了。"
                },
                {
                    "id": "120230606",
                    "speaker": "蒲泽",
                    "text": "唉…好不容易打完了仗，真不希望再有什么幺蛾子。"
                },
                {
                    "id": "120230607",
                    "speaker": "蒲泽",
                    "text": "我知道的就这么多，你要是感兴趣，不妨去问问他吧。"
                },
                {
                    "id": "120230608",
                    "speaker": "派蒙",
                    "text": "#总算有线索了，{NICKNAME}，我们赶快过去看看吧！"
                }
            ]
        },
        {
            "id": "1202303",
            "objective": "调查可疑的士兵",
            "dialogues": [
                {
                    "id": "120230201",
                    "speaker": "派蒙",
                    "text": "呜哇…这个人身上好重的酒气…"
                },
                {
                    "id": "120230202",
                    "speaker": "高善",
                    "text": "嗯？我记得你是…「剑鱼二番队」的队长！没错吧？"
                },
                {
                    "id": "120230203",
                    "speaker": "高善",
                    "text": "你回海祇岛了啊，我还以为你抛下小队不管，一个人跑路了。"
                },
                {
                    "id": "120230204",
                    "speaker": "派蒙",
                    "text": "我们才不会跑路呢！"
                },
                {
                    "id": "120230205",
                    "speaker": "高善",
                    "text": "哼，那可难说。和平啊，安定啊…每个人都在讨论着相似的东西。"
                },
                {
                    "id": "120230206",
                    "speaker": "高善",
                    "text": "反抗军最重要的是什么，你还记得吗？"
                },
                {
                    "id": "120230207",
                    "speaker": "Player",
                    "text": "是「战斗的意志」。"
                },
                {
                    "id": "120230208",
                    "speaker": "高善",
                    "text": "没错。就让我测试一下，你到底还是不是一个合格的反抗军战士吧。"
                },
                {
                    "id": "120230209",
                    "speaker": "高善",
                    "text": "不管你想问什么，打赢了我再告诉你。"
                },
                {
                    "id": "120230210",
                    "speaker": "派蒙",
                    "text": "唔…感觉和这个人的沟通好困难。"
                },
                {
                    "id": "120230211",
                    "speaker": "派蒙",
                    "text": "#怎么办，{NICKNAME}，要上吗？",
                    "choices": [
                        {
                            "id": "120230212",
                            "text": "嗯，我们不会输。",
                            "response": [
                                {
                                    "id": "120230214",
                                    "speaker": "高善",
                                    "text": "哼…等你们赢了再说吧！"
                                }
                            ]
                        },
                        {
                            "id": "120230213",
                            "text": "让他把知道的消息吐出来！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202304",
            "objective": "以理服人",
            "dialogues": [
                {
                    "id": "120230401",
                    "speaker": "派蒙",
                    "text": "…总之，就是这个样子。"
                },
                {
                    "id": "120230402",
                    "speaker": "派蒙",
                    "text": "天领奉行勾结愚人众这件事，其实是他们编造的。"
                },
                {
                    "id": "120230403",
                    "speaker": "派蒙",
                    "text": "他们的目标是破坏和谈，让战争继续下去。他们还说，不管我们想做什么，都已经来不及了。"
                },
                {
                    "id": "120230404",
                    "speaker": "珊瑚宫心海",
                    "text": "原来是这样。",
                    "choices": [
                        {
                            "id": "120230405",
                            "text": "心海…",
                            "response": [
                                {
                                    "id": "120230407",
                                    "speaker": "珊瑚宫心海",
                                    "text": "没事，让你担心了。"
                                },
                                {
                                    "id": "120230408",
                                    "speaker": "珊瑚宫心海",
                                    "text": "是我的错。如果我能更早地察觉到他们的心情，就不会发生这样的事了。"
                                },
                                {
                                    "id": "120230409",
                                    "speaker": "珊瑚宫心海",
                                    "text": "高善所说的「来不及了」，我大概知道指的是什么。"
                                },
                                {
                                    "id": "120230410",
                                    "speaker": "珊瑚宫心海",
                                    "text": "和谈虽然明天才开始，但双方的侍卫已经提前抵达了谈判地点，负责确认附近的安全。"
                                },
                                {
                                    "id": "120230411",
                                    "speaker": "珊瑚宫心海",
                                    "text": "像高善这样的主战派，很可能已经混进了侍卫队伍，准备在明天的谈判中暴起发难。"
                                },
                                {
                                    "id": "120230412",
                                    "speaker": "派蒙",
                                    "text": "这可怎么办呀。要不我们现在出发，去把他们换掉？"
                                },
                                {
                                    "id": "120230413",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不妥。首先我们带着新的卫队前往中立地带，势必会引起各方警惕。"
                                },
                                {
                                    "id": "120230414",
                                    "speaker": "珊瑚宫心海",
                                    "text": "主战派的士兵们很可能也会提前发动计划，进攻天领奉行的侍卫，一样有可能引发战争。"
                                },
                                {
                                    "id": "120230415",
                                    "speaker": "珊瑚宫心海",
                                    "text": "更何况，我们不知道有多少海祇岛的士兵参与其中，临阵换人，难免会出现无人可信的情况。"
                                },
                                {
                                    "id": "120230416",
                                    "speaker": "派蒙",
                                    "text": "听上去好复杂…难道真的没有什么办法了吗？"
                                },
                                {
                                    "id": "120230417",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不必担心。此事既然已经发生，就由我来思考对策。"
                                },
                                {
                                    "id": "120230418",
                                    "speaker": "珊瑚宫心海",
                                    "text": "那些士兵们固然有错，但过错不全在他们。无论如何，我会想办法保住他们的命…"
                                },
                                {
                                    "id": "120230419",
                                    "speaker": "珊瑚宫心海",
                                    "text": "明天，我们再在这里会合吧。"
                                }
                            ]
                        },
                        {
                            "id": "120230406",
                            "text": "没事吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202305",
            "objective": "与士兵交谈",
            "dialogues": []
        },
        {
            "id": "1202307",
            "objective": "刷出会场第二波人群$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1202306",
            "objective": "将真相回报给心海",
            "dialogues": []
        },
        {
            "id": "1202308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120230801",
                    "speaker": "珊瑚宫心海",
                    "text": "有什么消息了吗？"
                }
            ]
        },
        {
            "id": "1202309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120230901",
                    "speaker": "高善",
                    "text": "我还没醉…再喝点也没关系！"
                }
            ]
        },
        {
            "id": "1202312",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120231201",
                    "speaker": "用高",
                    "text": "珊瑚宫大人的气色比之前好了不少，我也可以放心了…大家平平安安的，比什么都重要。"
                }
            ]
        },
        {
            "id": "1202313",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120231301",
                    "speaker": "岩田",
                    "text": "希望未来能少一点天灾人祸，每天都能像现在这么开心。"
                }
            ]
        },
        {
            "id": "1202314",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120231401",
                    "speaker": "亮子",
                    "text": "有时间的话，多来海祇岛转转吧。你可是我们大家的英雄呀。"
                }
            ]
        },
        {
            "id": "1202316",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120231601",
                    "speaker": "平井",
                    "text": "要是和谈能够顺利就好了，真希望不要再有战争了…"
                }
            ]
        },
        {
            "id": "1202318",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120231801",
                    "speaker": "蒲泽",
                    "text": "打了那么久，也该消停些了。要买点瓜果吗？今天可是限时优惠。"
                }
            ]
        },
        {
            "id": "1202320",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120232001",
                    "speaker": "高善",
                    "text": "就这点能耐？果然剑鱼二番队的人就是虚有其表。"
                },
                {
                    "id": "120232002",
                    "speaker": "高善",
                    "text": "来！再来！"
                }
            ]
        }
    ]
