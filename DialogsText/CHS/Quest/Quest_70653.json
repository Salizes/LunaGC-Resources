    "talks": [
        {
            "id": "7065301",
            "objective": "与璃月港的凯瑟琳交谈",
            "dialogues": [
                {
                    "id": "706530101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎你，冒险家，我一直在等待你的到来。",
                    "choices": [
                        {
                            "id": "706530102",
                            "text": "最近过得还好吗？",
                            "response": [
                                {
                                    "id": "706530103",
                                    "speaker": "凯瑟琳",
                                    "text": "谢谢关心，我一切都好。不过协会这边，又遇到了紧急的突发事件…"
                                },
                                {
                                    "id": "706530106",
                                    "speaker": "凯瑟琳",
                                    "text": "近些日子，冒险家协会收到了很多「岩龙蜥」的目击情报。"
                                },
                                {
                                    "id": "706530107",
                                    "speaker": "凯瑟琳",
                                    "text": "「岩龙蜥」原本只出现在古书的记载中，不知为什么会突然出现。"
                                },
                                {
                                    "id": "706530108",
                                    "speaker": "凯瑟琳",
                                    "text": "它们虽与幼岩龙蜥形态相似，但性情凶暴，破坏力也高了好几个档次。"
                                },
                                {
                                    "id": "706530109",
                                    "speaker": "凯瑟琳",
                                    "text": "最近不少人喜欢去僻静的野外观景和放灯，如果正巧遇上了「岩龙蜥」，那后果不堪设想。"
                                },
                                {
                                    "id": "706530110",
                                    "speaker": "凯瑟琳",
                                    "text": "然而不巧的是，有很多冒险家都去走亲访友了，璃月协会正处于人手严重不足的情况…",
                                    "choices": [
                                        {
                                            "id": "706530111",
                                            "text": "拜托千岩军怎么样？",
                                            "response": [
                                                {
                                                    "id": "706530112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "缺人手的情况，千岩军也是一样，维护治安也是同等重要的事。"
                                                },
                                                {
                                                    "id": "706530115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "想到你近期在协会中的活跃表现，我觉得能够圆满解决这件事的人，只有你了。",
                                                    "choices": [
                                                        {
                                                            "id": "706530116",
                                                            "text": "好吧，既然是要紧事。",
                                                            "response": [
                                                                {
                                                                    "id": "706530118",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "谢谢你能答应，首先需要做的，是调查「岩龙蜥」的痕迹，追踪它们的位置。"
                                                                },
                                                                {
                                                                    "id": "706530119",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "想必你已经尝试过协会的「探索派遣」委托，我已经将「岩龙蜥」的线索整理成相似的形式了。"
                                                                },
                                                                {
                                                                    "id": "706530120",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "事不宜迟，我们先来看一看吧。"
                                                                },
                                                                {
                                                                    "id": "706530121",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "和一般的「探索派遣」不同的是，这次协会已经进行了一些初期调查，如果根据已有的情报进行准备，就能获得事半功倍的效果。"
                                                                },
                                                                {
                                                                    "id": "706530122",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "根据需要花费的时间和可能存在的风险，协会将这些探索派遣分为了不同的等级，等级越高，奖励也会越丰厚。"
                                                                },
                                                                {
                                                                    "id": "706530123",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "将收获的线索整理起来，相信就可以找到「岩龙蜥」的出没位置了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706530124",
                                                                            "text": "然后解决掉它就行了吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706530126",
                                                                                    "speaker": "凯瑟琳",
                                                                                    "text": "对了，协会的情报每天都会更新。在你和你的伙伴调查的时候，我会尽力做好支援工作的。"
                                                                                },
                                                                                {
                                                                                    "id": "706530127",
                                                                                    "speaker": "凯瑟琳",
                                                                                    "text": "那么，调查「岩龙蜥」一事就拜托你了。加油，向着星辰与深渊！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706530125",
                                                                            "text": "战斗的事，我最擅长。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706530117",
                                                            "text": "我应该怎么做？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706530113",
                                            "text": "从其他地区的协会请求支援？",
                                            "response": [
                                                {
                                                    "id": "706530114",
                                                    "speaker": "凯瑟琳",
                                                    "text": "其他地区的情况…也比较复杂，虽然获得了一些支援，但还是完全不够。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706530104",
                            "text": "又出什么事了吗？",
                            "response": [
                                {
                                    "id": "706530105",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，是紧急的突发事件。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}