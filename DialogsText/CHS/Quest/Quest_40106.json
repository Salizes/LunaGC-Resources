    "talks": [
        {
            "id": "4010603",
            "objective": "",
            "dialogues": [
                {
                    "id": "401060301",
                    "speaker": "多莉",
                    "text": "怎么样，在桑歌玛哈巴依老爷的协助下，你们应该也察觉到什么了吧？"
                },
                {
                    "id": "401060302",
                    "speaker": "派蒙",
                    "text": "你是说…"
                },
                {
                    "id": "401060303",
                    "speaker": "多莉",
                    "text": "萨齐因可不是什么好人。还有那所谓的「才识之冠」，绝对有问题！",
                    "choices": [
                        {
                            "id": "401060304",
                            "text": "确实。",
                            "response": [
                                {
                                    "id": "401060306",
                                    "speaker": "多莉",
                                    "text": "哎呀呀，既然这样，你们是不是也该做些什么呢？"
                                },
                                {
                                    "id": "401060307",
                                    "speaker": "多莉",
                                    "text": "比如把这个消息告诉教令院，让他们早点放弃才识之冠——"
                                },
                                {
                                    "id": "401060308",
                                    "speaker": "派蒙",
                                    "text": "我们已经把这件事告诉教令院了。但是…"
                                },
                                {
                                    "id": "401060309",
                                    "speaker": "多莉",
                                    "text": "但是什么？"
                                },
                                {
                                    "id": "401060310",
                                    "speaker": "派蒙",
                                    "text": "但是那个冠冕，已经被卡维摔碎了。"
                                },
                                {
                                    "id": "401060311",
                                    "speaker": "多莉",
                                    "text": "什么——？？？？"
                                },
                                {
                                    "id": "401060312",
                                    "speaker": "派蒙",
                                    "text": "冷静呀，多莉，你那么激动干什么？"
                                },
                                {
                                    "id": "401060313",
                                    "speaker": "多莉",
                                    "text": "……"
                                },
                                {
                                    "id": "401060314",
                                    "speaker": "多莉",
                                    "text": "冠冕…我的冠冕…"
                                },
                                {
                                    "id": "401060315",
                                    "speaker": "多莉",
                                    "text": "本来那是多么完美的一个计划！给你们提供情报，引导你们发现冠冕有问题，接下来只要等教令院出售冠冕时低价收购过来…"
                                },
                                {
                                    "id": "401060316",
                                    "speaker": "多莉",
                                    "text": "这下全完了…可恶，卡维！！我要上调他欠款的利息！！"
                                },
                                {
                                    "id": "401060317",
                                    "speaker": "派蒙",
                                    "text": "原来你是为了这个理由才告诉我们情报的。我说你怎么这么好心…"
                                },
                                {
                                    "id": "401060318",
                                    "speaker": "多莉",
                                    "text": "我的冠冕！！可恶，我真的生气了！！这个月的欠款他别想以任何理由延期！！"
                                }
                            ]
                        },
                        {
                            "id": "401060305",
                            "text": "我们也发现了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4010299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401029905",
                    "speaker": "卡维",
                    "text": "（笔记是他故意留下的，还是纯属巧合？不…可如果不是巧合…）"
                }
            ]
        },
        {
            "id": "4010604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401060401",
                    "speaker": "卡维",
                    "text": "「微小的选择」？真搞不懂那家伙在想些什么…"
                }
            ]
        }
    ]
}