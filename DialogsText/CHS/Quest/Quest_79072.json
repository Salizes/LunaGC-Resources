    "talks": [
        {
            "id": "7907201",
            "objective": "与德维特对话",
            "dialogues": [
                {
                    "id": "790720101",
                    "speaker": "德维特",
                    "text": "#哎呀，真是荣幸。您就是那位{NICKNAME}吧，旁边这位一定是您的同伴派蒙小姐。"
                },
                {
                    "id": "790720102",
                    "speaker": "派蒙",
                    "text": "嘿嘿，没错，就是我们啦！"
                },
                {
                    "id": "790720103",
                    "speaker": "Player",
                    "text": "我们有这么出名？"
                },
                {
                    "id": "790720104",
                    "speaker": "德维特",
                    "text": "星轨王城里的消息，总是比其他地方更灵通一些。"
                },
                {
                    "id": "790720105",
                    "speaker": "德维特",
                    "text": "不得不说，您来得正好，我正好做完了这副名为「飞帽」的游戏。"
                },
                {
                    "id": "790720106",
                    "speaker": "德维特",
                    "text": "虽然我不能像那篇《飞帽匠》里的帽子匠一样，让所有人都拥有一顶漂亮的帽子。"
                },
                {
                    "id": "790720107",
                    "speaker": "德维特",
                    "text": "但我相信，这副「飞帽」游戏，一定能将欢乐带给所有游玩它的人。"
                },
                {
                    "id": "790720108",
                    "speaker": "德维特",
                    "text": "我还为这款游戏设计了三种完全不同的玩法…呃，当然！规则也绝不复杂。"
                },
                {
                    "id": "790720109",
                    "speaker": "德维特",
                    "text": "我相信，您只要玩上一局，就能完全理解了。",
                    "choices": [
                        {
                            "id": "790720110",
                            "text": "想要试试！",
                            "response": [
                                {
                                    "id": "790720111",
                                    "speaker": "德维特",
                                    "text": "没问题，请到这边来。"
                                }
                            ]
                        },
                        {
                            "id": "790720112",
                            "text": "暂时没空…",
                            "response": [
                                {
                                    "id": "790720113",
                                    "speaker": "德维特",
                                    "text": "别担心，等您有空了再来找我吧，我这段时间会一直待在这里。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}