    "talks": [
        {
            "id": "7218501",
            "objective": "与木南杏奈对话",
            "dialogues": [
                {
                    "id": "721850101",
                    "speaker": "木南杏奈",
                    "text": "唉，这可怎么办呢…"
                },
                {
                    "id": "721850102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "721850103",
                    "speaker": "木南杏奈",
                    "text": "旅行者？太好了，你来得正好！"
                },
                {
                    "id": "721850104",
                    "speaker": "木南杏奈",
                    "text": "你还记得上次，你和神里小姐来我店里的时候，你写给我的那道食谱吗？"
                },
                {
                    "id": "721850105",
                    "speaker": "木南杏奈",
                    "text": "哎呀，那道披萨可受欢迎了，好多客人都专门来店里点那道披萨吃呢。"
                },
                {
                    "id": "721850106",
                    "speaker": "木南杏奈",
                    "text": "但是…有些客人也说，总是吃这一种披萨感觉有点腻了，问我有没有其他味道的披萨。"
                },
                {
                    "id": "721850107",
                    "speaker": "木南杏奈",
                    "text": "虽然我自己也根据客人们的反馈尝试过几种新做法…"
                },
                {
                    "id": "721850108",
                    "speaker": "木南杏奈",
                    "text": "但总觉得…差那么点味道，客人们的反响也不太好。"
                },
                {
                    "id": "721850109",
                    "speaker": "木南杏奈",
                    "text": "唉，也许我真的不太会做「披萨」这种菜吧…"
                },
                {
                    "id": "721850110",
                    "speaker": "木南杏奈",
                    "text": "旅行者，你应该很懂这种菜吧？你能帮我再拿拿主意吗？",
                    "choices": [
                        {
                            "id": "721850111",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "721850112",
                                    "speaker": "木南杏奈",
                                    "text": "太好了！对了，我也搜集了客人们的反馈，我找一下，你稍等。"
                                },
                                {
                                    "id": "721850116",
                                    "speaker": "木南杏奈",
                                    "text": "这位松本小姐说，虽然我店里的这道披萨融合了很多稻妻的食材，但她听说，蒙德的披萨不是这么做的。"
                                },
                                {
                                    "id": "721850117",
                                    "speaker": "木南杏奈",
                                    "text": "她说，这种异国的食物，最好还是保持着异国的特色比较好…"
                                },
                                {
                                    "id": "721850118",
                                    "speaker": "木南杏奈",
                                    "text": "唉，但我怎么知道蒙德的披萨做法呢…旅行者，你就先去问问她吧。"
                                }
                            ]
                        },
                        {
                            "id": "721850113",
                            "text": "关于客人的反馈…",
                            "response": [
                                {
                                    "id": "721850114",
                                    "speaker": "木南杏奈",
                                    "text": "你想看看客人们的反馈吗？"
                                },
                                {
                                    "id": "721850115",
                                    "speaker": "木南杏奈",
                                    "text": "我找一下，你稍等。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7218502",
            "objective": "与松本对话",
            "dialogues": [
                {
                    "id": "721850201",
                    "speaker": "松本",
                    "text": "唉，这个世界上还有能满足我味蕾的新奇菜肴吗？"
                },
                {
                    "id": "721850202",
                    "speaker": "Player",
                    "text": "关于「木南料亭」的披萨…"
                },
                {
                    "id": "721850203",
                    "speaker": "松本",
                    "text": "你说那个披萨啊，味道确实不错，还融合了不少本地的食材。"
                },
                {
                    "id": "721850204",
                    "speaker": "松本",
                    "text": "不过，我之前也尝过正宗的「烤蘑菇披萨」。"
                },
                {
                    "id": "721850205",
                    "speaker": "松本",
                    "text": "我记得，那种披萨是由奶酪，卷心菜和蘑菇做成的来着…"
                },
                {
                    "id": "721850206",
                    "speaker": "松本",
                    "text": "哈哈哈，我个人是觉得，这种异国的食物，最好还是保持着异国的特色比较好啦。"
                }
            ]
        },
        {
            "id": "7218503",
            "objective": "向木南杏奈回报",
            "dialogues": [
                {
                    "id": "721850301",
                    "speaker": "木南杏奈",
                    "text": "旅行者，你回来了。"
                },
                {
                    "id": "721850302",
                    "speaker": "木南杏奈",
                    "text": "怎么样，你有问到什么吗？"
                },
                {
                    "id": "721850303",
                    "speaker": "Player",
                    "text": "关于客人们的反馈…"
                },
                {
                    "id": "721850304",
                    "speaker": "木南杏奈",
                    "text": "原汁原味的「烤蘑菇披萨」啊…嗯，倒是可以试试看。"
                },
                {
                    "id": "721850305",
                    "speaker": "木南杏奈",
                    "text": "要准备的材料是奶酪、卷心菜和蘑菇…"
                },
                {
                    "id": "721850306",
                    "speaker": "木南杏奈",
                    "text": "其余的材料店里倒是有，可是这个奶酪，店里平时也没储备多少…"
                },
                {
                    "id": "721850307",
                    "speaker": "木南杏奈",
                    "text": "旅行者，能请你帮我去拿一份奶酪来吗？",
                    "choices": [
                        {
                            "id": "721850308",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "721850309",
                                    "speaker": "木南杏奈",
                                    "text": "那就拜托你了，只要一份奶酪就好。"
                                }
                            ]
                        },
                        {
                            "id": "721850310",
                            "text": "店里平时都不用奶酪的吗？",
                            "response": [
                                {
                                    "id": "721850311",
                                    "speaker": "木南杏奈",
                                    "text": "也不能说完全不用，只能说用得很少。"
                                },
                                {
                                    "id": "721850312",
                                    "speaker": "木南杏奈",
                                    "text": "毕竟，店里的这些菜，也没几道要用到奶酪的，所以储备得很少…"
                                },
                                {
                                    "id": "721850313",
                                    "speaker": "木南杏奈",
                                    "text": "总之，就拜托你了旅行者，请帮我带一份奶酪回来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7218504",
            "objective": "将奶酪带回给木南杏奈",
            "dialogues": [
                {
                    "id": "721850401",
                    "speaker": "木南杏奈",
                    "text": "你把食材带回来了吗？"
                }
            ]
        },
        {
            "id": "7218505",
            "objective": "与木南杏奈对话",
            "dialogues": [
                {
                    "id": "721850501",
                    "speaker": "木南杏奈",
                    "text": "谢谢你，有这些食材就够了。"
                },
                {
                    "id": "721850502",
                    "speaker": "木南杏奈",
                    "text": "原汁原味的蒙德「烤蘑菇披萨」，不知道能不能顺利做出来…"
                },
                {
                    "id": "721850503",
                    "speaker": "木南杏奈",
                    "text": "完成了！"
                },
                {
                    "id": "721850504",
                    "speaker": "木南杏奈",
                    "text": "这披萨…看上去还不错…"
                },
                {
                    "id": "721850505",
                    "speaker": "木南杏奈",
                    "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。"
                },
                {
                    "id": "721850506",
                    "speaker": "木南杏奈",
                    "text": "我等会就去仔细品尝一下这份披萨的味道…"
                },
                {
                    "id": "721850507",
                    "speaker": "木南杏奈",
                    "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
                }
            ]
        },
        {
            "id": "7218506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721850601",
                    "speaker": "木南杏奈",
                    "text": "唉，也许我真的不太会做「披萨」这种菜吧…"
                }
            ]
        },
        {
            "id": "7218507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721850701",
                    "speaker": "松本",
                    "text": "那种「烤蘑菇披萨」味道可是很不错的，有机会的话你一定要去尝尝看。"
                }
            ]
        }
    ]
}