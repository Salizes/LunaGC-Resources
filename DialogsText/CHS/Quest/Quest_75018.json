        {
            "id": "7501811",
            "objective": "(test)隐藏，几天后回到小屋$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7501805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750180501",
                    "speaker": "派蒙",
                    "text": "#嗯，就算疗效没那么好，但只要它愿意吃药，也是很大的进步了！那就交给你啦，{REALNAME[ID(2)|SHOWHOST(true)]}！"
                },
                {
                    "id": "750180510",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750180511",
