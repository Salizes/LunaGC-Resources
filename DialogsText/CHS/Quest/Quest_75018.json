    "talks": [
        {
            "id": "7501801",
            "objective": "(test)隐藏：靠近后流转到驱赶龙$HIDDEN",
            "dialogues": [
                {
                    "id": "750180101",
                    "speaker": "愤怒的绒翼龙",
                    "text": "——嘎嘎嘎嘎嘎嘎！"
                },
                {
                    "id": "750180102",
                    "speaker": "？？？",
                    "text": "好孩子，别闹啦，不吃药的话身体怎么恢复…哎呀！"
                },
                {
                    "id": "750180103",
                    "speaker": "派蒙",
                    "text": "#危险！{NICKNAME}，我们得去帮帮她！"
                }
            ]
        },
        {
            "id": "7501802",
            "objective": "制服暴躁的绒翼龙",
            "dialogues": []
        },
        {
            "id": "7501803",
            "objective": "制服暴躁的绒翼龙",
            "dialogues": [
                {
                    "id": "750180301",
                    "speaker": "Black Screen",
                    "text": "「嘎——！」\\n像是知道自己不是敌手，绒翼龙啸叫着飞向远方…"
                },
                {
                    "id": "750180302",
                    "speaker": "派蒙",
                    "text": "哇！！飞、飞得好快！一眨眼就跑了那么远！",
                    "choices": [
                        {
                            "id": "750180303",
                            "text": "派蒙，快追！",
                            "response": [
                                {
                                    "id": "750180304",
                                    "speaker": "派蒙",
                                    "text": "欸，我去追？我么？"
                                },
                                {
                                    "id": "750180307",
                                    "speaker": "？？？",
                                    "text": "——嗯，飞得这么快，看来至少体力已经恢复得差不多了，接下来就是…"
                                },
                                {
                                    "id": "750180308",
                                    "speaker": "派蒙",
                                    "text": "话说回来，那头绒翼龙为什么会这么生气啊？"
                                },
                                {
                                    "id": "750180309",
                                    "speaker": "派蒙",
                                    "text": "…啊，我知道了！该不会是你偷吃了它的点心吧？因为食物而结下的仇怨可是很重的哦。"
                                },
                                {
                                    "id": "750180310",
                                    "speaker": "？？？",
                                    "text": "点心？吃倒是吃过，不过咕噜噜是不拘小节的绒翼龙，所以不会在意这种小事啦。"
                                },
                                {
                                    "id": "750180311",
                                    "speaker": "派蒙",
                                    "text": "「咕噜噜」？原来它也是有名字的龙啊…不过看起来脾气很坏呢，刚才还乱打人。"
                                },
                                {
                                    "id": "750180312",
                                    "speaker": "？？？",
                                    "text": "嗯…这也不怪它，都是为了治疗。"
                                },
                                {
                                    "id": "750180313",
                                    "speaker": "Player",
                                    "text": "原来挨打也是治疗啊，长见识了。"
                                },
                                {
                                    "id": "750180314",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750180315",
                                    "speaker": "派蒙",
                                    "text": "#怎么可能会有这种疗法啊！你看，都怪你乱说，{REALNAME[ID(2)|SHOWHOST(true)]}都当真了！"
                                },
                                {
                                    "id": "750180316",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？呜？"
                                },
                                {
                                    "id": "750180317",
                                    "speaker": "？？？",
                                    "text": "哈哈，要是真的有这种疗法而且有效，那我也想试试看呢！不过龙和人不一样，就算跟它们说都是为了快些痊愈，它们也不懂嘛。"
                                },
                                {
                                    "id": "750180318",
                                    "speaker": "玛兹嘉",
                                    "text": "对了，还没自我介绍呢，我是玛兹嘉，平时都在这附近照看受伤或者生病的龙，不是我自夸，我配的药风评还不错哦。"
                                },
                                {
                                    "id": "750180319",
                                    "speaker": "玛兹嘉",
                                    "text": "嗯，你们的小小伙伴看起来很健康的样子，看来是不需要我的关照了。"
                                },
                                {
                                    "id": "750180320",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750180321",
                                    "speaker": "派蒙",
                                    "text": "原来你是给龙看病的医生啊。呃，看咕噜噜的样子，应该是很辛苦的工作吧…"
                                },
                                {
                                    "id": "750180322",
                                    "speaker": "玛兹嘉",
                                    "text": "我觉得也没有那么辛苦啦，只是咕噜噜的情况比较特殊…它现在极度地不信任人类，对于治疗和吃药也很抗拒。"
                                },
                                {
                                    "id": "750180323",
                                    "speaker": "玛兹嘉",
                                    "text": "唉，要是我也是龙就好了。之前观察下来，它和其他龙相处得还不错，如果是龙劝它吃药，说不定它就会愿意了。"
                                },
                                {
                                    "id": "750180324",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜？"
                                },
                                {
                                    "id": "750180325",
                                    "speaker": "派蒙",
                                    "text": "如果是这样的话，说不定我们能帮上忙呢！"
                                },
                                {
                                    "id": "750180326",
                                    "speaker": "玛兹嘉",
                                    "text": "欸？难、难道你们虽然外表是这样，但其实是龙？"
                                },
                                {
                                    "id": "750180327",
                                    "speaker": "派蒙",
                                    "text": "你的想法也太跳跃了吧！呃…"
                                },
                                {
                                    "id": "750180328",
                                    "speaker": "派蒙",
                                    "text": "#对、对了！其实是因为{REALNAME[ID(2)|SHOWHOST(true)]}是特别聪明的小龙！这件事可以让它来帮忙！"
                                },
                                {
                                    "id": "750180329",
                                    "speaker": "玛兹嘉",
                                    "text": "欸？原来它这么厉害吗？",
                                    "choices": [
                                        {
                                            "id": "750180330",
                                            "text": "能选中我，至少很有眼光。",
                                            "response": [
                                                {
                                                    "id": "750180331",
                                                    "speaker": "派蒙",
                                                    "text": "话是没错…但现在重点不是这个吧？"
                                                },
                                                {
                                                    "id": "750180333",
                                                    "speaker": "派蒙",
                                                    "text": "#总之这点小事交给{REALNAME[ID(2)|SHOWHOST(true)]}，肯定没问题的！"
                                                },
                                                {
                                                    "id": "750180334",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！呀！"
                                                },
                                                {
                                                    "id": "750180335",
                                                    "speaker": "玛兹嘉",
                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}，那我就先替咕噜噜谢谢你啦！"
                                                },
                                                {
                                                    "id": "750180336",
                                                    "speaker": "玛兹嘉",
                                                    "text": "原本真的很担心它再这样闹下去，不仅旧伤不能痊愈，还会添新伤…有你们帮忙就放心了！"
                                                },
                                                {
                                                    "id": "750180337",
                                                    "speaker": "玛兹嘉",
                                                    "text": "我为咕噜噜准备了两种药剂，虽然很想兼顾疗效和适口性，但是现在我还拿不出这样完美的配方…"
                                                },
                                                {
                                                    "id": "750180338",
                                                    "speaker": "玛兹嘉",
                                                    "text": "所以现在两种药剂，疗效好的那种大概是龙不太喜欢的口味，而口味它们喜欢的，疗效可能又没那么好。"
                                                },
                                                {
                                                    "id": "750180339",
                                                    "speaker": "玛兹嘉",
                                                    "text": "#唔…与其我来解释，不如让{REALNAME[ID(2)|SHOWHOST(true)]}闻闻看，你们看看它的反应，应该会更明白吧。"
                                                },
                                                {
                                                    "id": "750180340",
                                                    "speaker": "玛兹嘉",
                                                    "text": "这个是疗效更好的。"
                                                },
                                                {
                                                    "id": "750180341",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜…呜呜…"
                                                },
                                                {
                                                    "id": "750180342",
                                                    "speaker": "玛兹嘉",
                                                    "text": "这个是疗效没那么好的，但是颜色看起来让人觉得很有食欲呢。"
                                                },
                                                {
                                                    "id": "750180343",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！呀呀！"
                                                },
                                                {
                                                    "id": "750180344",
                                                    "speaker": "派蒙",
                                                    "text": "哇，真的一目了然！"
                                                },
                                                {
                                                    "id": "750180345",
                                                    "speaker": "玛兹嘉",
                                                    "text": "不管是哪种，只要咕噜噜愿意吃，总归是对它恢复有帮助的。所以两种药剂都交给你们，具体用哪一种就看你们的判断啦！"
                                                },
                                                {
                                                    "id": "750180346",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750180347",
                                                    "speaker": "玛兹嘉",
                                                    "text": "嘿嘿，真可靠！那我先回营地做一些准备工作，咕噜噜就拜托你们啦！"
                                                },
                                                {
                                                    "id": "750180348",
                                                    "speaker": "派蒙",
                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}可是很可靠的伙伴，这次就交给它吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750180332",
                                            "text": "足以在人和龙之间架起友谊的桥梁。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750180305",
                            "text": "这就逃了，有本事回来啊。",
                            "response": [
                                {
                                    "id": "750180306",
                                    "speaker": "派蒙",
                                    "text": "龙才听不懂这些吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501804",
            "objective": "追上「咕噜噜」",
            "dialogues": []
        },
        {
            "id": "7501806",
            "objective": "追上「咕噜噜」",
            "dialogues": [
                {
                    "id": "750180601",
                    "speaker": "Player",
                    "text": "试试看吧。"
                },
                {
                    "id": "750180602",
                    "speaker": "派蒙",
                    "text": "#那就拜托{REALNAME[ID(2)|SHOWHOST(true)]}再跑一趟了。"
                },
                {
                    "id": "750180603",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750180604",
                    "speaker": "派蒙",
                    "text": "它吃下去了！但是…"
                },
                {
                    "id": "750180605",
                    "speaker": "派蒙",
                    "text": "不好！它怎么比之前更暴躁了？总之得让它先冷静下来…"
                }
            ]
        },
        {
            "id": "7501807",
            "objective": "喂「咕噜噜」吃药",
            "dialogues": [
                {
                    "id": "750180701",
                    "speaker": "「咕噜噜」",
                    "text": "嘎…"
                },
                {
                    "id": "750180702",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，咕噜噜的伤势没痊愈，我有点担心…要不，我们也跟上去看一看吧。"
                },
                {
                    "id": "750180706",
                    "speaker": "Black Screen",
                    "text": "#赶到了{REALNAME[ID(2)|SHOWHOST(true)]}与咕噜噜的身边。"
                },
                {
                    "id": "750180703",
                    "speaker": "派蒙",
                    "text": "它在这儿呢！呼…还好还好，看起来没有什么大碍——对了，我们现在就把药剂喂给它吧！"
                },
                {
                    "id": "750180704",
                    "speaker": "派蒙",
                    "text": "两种药剂，该给它哪种呢？"
                }
            ]
        },
        {
            "id": "7501805",
            "objective": "喂「咕噜噜」吃药",
            "dialogues": [
                {
                    "id": "750180403",
                    "speaker": "派蒙",
                    "text": "#要是它愿意吃的话，应该对恢复更有帮助吧？那就交给你啦，{REALNAME[ID(2)|SHOWHOST(true)]}！"
                },
                {
                    "id": "750180405",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750180406",
                    "speaker": "派蒙",
                    "text": "#看起来好像有希望？真不愧是{REALNAME[ID(2)|SHOWHOST(true)]}！欸？等一下…"
                },
                {
                    "id": "750180407",
                    "speaker": "「咕噜噜」",
                    "text": "——嘎嘎嘎嘎嘎嘎！"
                },
                {
                    "id": "750180408",
                    "speaker": "派蒙",
                    "text": "欸欸？！难、难道是药效太好了吗？它怎么比之前还要暴躁？总之得让它先冷静下来…"
                }
            ]
        },
        {
            "id": "7501813",
            "objective": "喂「咕噜噜」吃药",
            "dialogues": []
        },
        {
            "id": "7501808",
            "objective": "制服「咕噜噜」",
            "dialogues": []
        },
        {
            "id": "7501809",
            "objective": "制服「咕噜噜」",
            "dialogues": [
                {
                    "id": "750180903",
                    "speaker": "「咕噜噜」",
                    "text": "呜…"
                },
                {
                    "id": "750180901",
                    "speaker": "Player",
                    "text": "这真的是受伤还没痊愈的龙吗？"
                },
                {
                    "id": "750180904",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呀！呀呀！"
                },
                {
                    "id": "750180902",
                    "speaker": "派蒙",
                    "text": "等它痊愈了，应该会是相当强劲的对手呢…不过现在还是趁它没那么闹腾了，赶紧带它回去找玛兹嘉小姐吧！"
                }
            ]
        },
        {
            "id": "7501810",
            "objective": "与玛兹嘉对话",
            "dialogues": [
                {
                    "id": "750181001",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750181002",
                    "speaker": "玛兹嘉",
                    "text": "你们回来了！怎么样？咕噜噜愿意吃药了吗？"
                },
                {
                    "id": "750181003",
                    "speaker": "派蒙",
                    "text": "吃是吃了，但是…"
                },
                {
                    "id": "750181004",
                    "speaker": "Black Screen",
                    "text": "简要说明了刚才的情况…"
                },
                {
                    "id": "750181017",
                    "speaker": "玛兹嘉",
                    "text": "原来是这样…那我检查一下吧！唔——没事，应该没有什么大碍。"
                },
                {
                    "id": "750181005",
                    "speaker": "玛兹嘉",
                    "text": "不管怎么说，它愿意吃药了就是好事！而且也知道了它的反应，之后可以更有针对性地调整配方了。"
                },
                {
                    "id": "750181006",
                    "speaker": "玛兹嘉",
                    "text": "#嗯，肯定没问题的。真是多谢你们了，特别是{REALNAME[ID(2)|SHOWHOST(true)]}，真是了不起的小嵴锋龙！"
                },
                {
                    "id": "750181007",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀呀！"
                },
                {
                    "id": "750181008",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，听别人夸{REALNAME[ID(2)|SHOWHOST(true)]}，感觉比自己被夸更高兴呢！"
                },
                {
                    "id": "750181009",
                    "speaker": "玛兹嘉",
                    "text": "能和小嵴锋龙这样默契的两位也很了不起！我也得向你们学习才行呀。",
                    "choices": [
                        {
                            "id": "750181010",
                            "text": "真不愧是我！",
                            "response": [
                                {
                                    "id": "750181012",
                                    "speaker": "玛兹嘉",
                                    "text": "虽然想说有什么我能帮到你们或者为你们做的…"
                                },
                                {
                                    "id": "750181013",
                                    "speaker": "玛兹嘉",
                                    "text": "但还是祝你们健健康康，最好永远也不需要找我帮忙吧！"
                                },
                                {
                                    "id": "750181014",
                                    "speaker": "玛兹嘉",
                                    "text": "啊，不过如果你们只是想来和我聊聊天，随时欢迎你们。"
                                },
                                {
                                    "id": "750181015",
                                    "speaker": "派蒙",
                                    "text": "好哦，也祝咕噜噜能早点恢复，至少别再不由分说就乱打人了…"
                                },
                                {
                                    "id": "750181016",
                                    "speaker": "玛兹嘉",
                                    "text": "这个嘛…就相信我吧，之后我也会想想办法的。伤养好了，说不定脾气自然也就变好了呢！"
                                }
                            ]
                        },
                        {
                            "id": "750181011",
                            "text": "#哪里，还是{REALNAME[ID(2)|SHOWHOST(true)]}更了不起。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501812",
