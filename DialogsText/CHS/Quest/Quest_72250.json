    "talks": [
        {
            "id": "7225001",
            "objective": "",
            "dialogues": [
                {
                    "id": "722500101",
                    "speaker": "贺摩",
                    "text": "啊！救、救命…"
                },
                {
                    "id": "722500102",
                    "speaker": "贺摩",
                    "text": "小人听说最近大人们疲于应付须婆达之彦领导的反叛，大日御舆防卫空虚，才动了不该动的歪念头…"
                },
                {
                    "id": "722500103",
                    "speaker": "贺摩",
                    "text": "看在小人上有重疾老母需要赡养，下有十二个出于爱心拉扯大的孤儿的份上！还请守备大人高抬一手，把小人当个屁，就放了吧！"
                },
                {
                    "id": "722500104",
                    "speaker": "Player",
                    "text": "咳咳…"
                },
                {
                    "id": "722500105",
                    "speaker": "贺摩",
                    "text": "咦，嗐，什么呀，原来不是大日御舆的守卫啊。"
                },
                {
                    "id": "722500106",
                    "speaker": "贺摩",
                    "text": "看你这奇装异服的…不会是从什么奇怪地方来的同行吧。"
                },
                {
                    "id": "722500107",
                    "speaker": "派蒙",
                    "text": "什么同行不同行的！"
                },
                {
                    "id": "722500108",
                    "speaker": "贺摩",
                    "text": "都到这儿了还装什么呀，唉，真是出师不利，好不容易进入大日御舆，大肆搜刮了一把，却被机关困住。"
                },
                {
                    "id": "722500109",
                    "speaker": "贺摩",
                    "text": "看来今日不宜…不宜行劫富济贫的义举之事。"
                },
                {
                    "id": "722500110",
                    "speaker": "派蒙",
                    "text": "哼，小偷就小偷，还说成是劫富济贫。"
                },
                {
                    "id": "722500111",
                    "speaker": "贺摩",
                    "text": "你懂什么，大人们每日听着靡靡之音，饮酒作乐，我们这些底层人就得累死累活，给他们倒尿盆子，热草鞋，哪有这种道理！"
                },
                {
                    "id": "722500112",
                    "speaker": "贺摩",
                    "text": "哎对了，我跟你说个秘密，就当你们救我的回报。我之前收买了维修大日御舆的工匠，像这样藏有财宝的房间，还有两个！"
                },
                {
                    "id": "722500113",
                    "speaker": "派蒙",
                    "text": "还有两个！"
                },
                {
                    "id": "722500114",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我觉得我们也有必要，行、行一些劫富济贫的义举之事。"
                },
                {
                    "id": "722500115",
                    "speaker": "贺摩",
                    "text": "不过这两个房间的位置我也不是很清楚了，毕竟那工匠也不敢再说其他。"
                },
                {
                    "id": "722500116",
                    "speaker": "贺摩",
                    "text": "这情报就当是贺礼吧！"
                },
                {
                    "id": "722500117",
                    "speaker": "派蒙",
                    "text": "反正现在的渊下宫也没有人在，说不定那里有很多以前的古董呢！"
                },
                {
                    "id": "722500118",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，待会儿我们就悄悄在周围找找吧！"
                }
            ]
        }
    ]
}