    "talks": [
        {
            "id": "7182901",
            "objective": "与言笑对话$HIDDEN",
            "dialogues": [
                {
                    "id": "718290101",
                    "speaker": "言笑",
                    "text": "唉，我以后做什么好呢…"
                },
                {
                    "id": "718290102",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "718290103",
                    "speaker": "言笑",
                    "text": "是你啊。没什么，就是我快要被掌柜的扫地出门了。"
                },
                {
                    "id": "718290104",
                    "speaker": "言笑",
                    "text": "前几天掌柜的找我，说让我想点新菜色来招揽客人。"
                },
                {
                    "id": "718290105",
                    "speaker": "言笑",
                    "text": "这新菜，要卖相足、味道好、够大气、显手艺，还要有格调…"
                },
                {
                    "id": "718290106",
                    "speaker": "言笑",
                    "text": "我是在厨房里足足寻思七八天了，做出来的菜掌柜的都不满意。"
                },
                {
                    "id": "718290107",
                    "speaker": "Player",
                    "text": "你都做了什么菜？"
                },
                {
                    "id": "718290108",
                    "speaker": "言笑",
                    "text": "我可都是使出浑身解数，把当年在山上当…大厨的功夫全都使出来了。"
                },
                {
                    "id": "718290109",
                    "speaker": "言笑",
                    "text": "什么糖渍霓裳花，清心莲子炖老鸭，清炖蟹膏狮子头…"
                },
                {
                    "id": "718290110",
                    "speaker": "言笑",
                    "text": "但掌柜的怎么样都觉得不满意，一个劲地让我再好好想想。"
                },
                {
                    "id": "718290111",
                    "speaker": "言笑",
                    "text": "但我真的已经折腾不动了，唉…"
                },
                {
                    "id": "718290112",
                    "speaker": "言笑",
                    "text": "哦，不对，我还得给那吃白食的做点菜，这个点，他也要来吃饭了…"
                },
                {
                    "id": "718290113",
                    "speaker": "Player",
                    "text": "你是说江雪？"
                },
                {
                    "id": "718290114",
                    "speaker": "言笑",
                    "text": "除了他还有谁，天下就他一个人腆着脸天天在我这蹭饭…"
                },
                {
                    "id": "718290117",
                    "speaker": "言笑",
                    "text": "你既然也在这，就一起吃点吧。先去那边坐着，我做好菜了就端过来。"
                }
            ]
        },
        {
            "id": "7182902",
            "objective": "在桌边坐下",
            "dialogues": [
                {
                    "id": "718290201",
                    "speaker": "言笑",
                    "text": "去桌子那边坐着吧，我做好菜了就端过来。"
                }
            ]
        },
        {
            "id": "7182903",
            "objective": "和江雪对话",
            "dialogues": [
                {
                    "id": "718290401",
                    "speaker": "江雪",
                    "text": "这狮子头的味道果然不错，这肉入口即化，汤汁也醇厚香浓…"
                },
                {
                    "id": "718290402",
                    "speaker": "江雪",
                    "text": "唔？竟在肉中加入了蟹膏，怪不得尝之鲜美异常。"
                },
                {
                    "id": "718290403",
                    "speaker": "江雪",
                    "text": "来，旅行者，你也再尝一个。我教你，先用筷子拨开狮子头，再蘸以汤汁，随米饭同嚼…",
                    "choices": [
                        {
                            "id": "718290404",
                            "text": "客气客气…",
                            "response": [
                                {
                                    "id": "718290409",
                                    "speaker": "言笑",
                                    "text": "你们俩吃好喝好啊，反正我马上就不在这里干活了，你想吃也吃不到了…"
                                },
                                {
                                    "id": "718290410",
                                    "speaker": "江雪",
                                    "text": "不在这里干活…这又是从何说起？"
                                },
                                {
                                    "id": "718290411",
                                    "speaker": "江雪",
                                    "text": "呀，难不成真是我在你这吃喝太多，惹你被掌柜的嫌弃了？"
                                },
                                {
                                    "id": "718290412",
                                    "speaker": "江雪",
                                    "text": "也不该啊，我也颇钓了好几尾好鱼送进了客栈里，应该能抵了饭钱，而且掌柜的也不是这种小气之人…"
                                },
                                {
                                    "id": "718290413",
                                    "speaker": "言笑",
                                    "text": "你趁早给我歇了吧，你那几条鱼够谁吃的，最后还不是都进了你的肚子。"
                                },
                                {
                                    "id": "718290414",
                                    "speaker": "江雪",
                                    "text": "那究竟是…"
                                },
                                {
                                    "id": "718290415",
                                    "speaker": "言笑",
                                    "text": "唉…算了，我还是和你说吧…"
                                },
                                {
                                    "id": "718290416",
                                    "speaker": "江雪",
                                    "text": "卖相足、味道好、够大气、显手艺，还要有格调…"
                                },
                                {
                                    "id": "718290417",
                                    "speaker": "江雪",
                                    "text": "哈哈哈，掌柜的这是要你做一道世间不应有的奇菜啊。"
                                },
                                {
                                    "id": "718290418",
                                    "speaker": "言笑",
                                    "text": "你给我笑，你接着笑。我看我走了之后，你还找谁蹭吃蹭喝！"
                                },
                                {
                                    "id": "718290419",
                                    "speaker": "江雪",
                                    "text": "笑罢了，笑罢了。我说你这个厨子为什么今天愁眉苦脸的，原来是遇见这桩事了。"
                                },
                                {
                                    "id": "718290420",
                                    "speaker": "言笑",
                                    "text": "那可不，也不知道掌柜的怎么就突然异想天开，给我折腾的…"
                                },
                                {
                                    "id": "718290421",
                                    "speaker": "江雪",
                                    "text": "唔，你也莫急。虽然我不会做菜，但还真知道一份奇菜的菜谱。"
                                },
                                {
                                    "id": "718290422",
                                    "speaker": "江雪",
                                    "text": "这是我当年在外游历时，偶然在一家大户人家吃到的奇菜，叫做「鸡豆花」。"
                                },
                                {
                                    "id": "718290423",
                                    "speaker": "江雪",
                                    "text": "此菜「食肉不见肉」，食之嫩如豆花，却又荤香醇厚，极尽鲜美，实为「以荤托素」的奇菜。"
                                },
                                {
                                    "id": "718290424",
                                    "speaker": "江雪",
                                    "text": "我吃过后十分好奇，便去请教了菜谱过来，不过…我却不擅长做菜，于是这菜谱也只能久压箱底…",
                                    "choices": [
                                        {
                                            "id": "718290425",
                                            "text": "这种菜谱，你是怎么请教到的？",
                                            "response": [
                                                {
                                                    "id": "718290426",
                                                    "speaker": "江雪",
                                                    "text": "嗯…简单来说，当时我帮了那户人家一个忙，他们当时也是设宴请的我。"
                                                },
                                                {
                                                    "id": "718290427",
                                                    "speaker": "江雪",
                                                    "text": "研究出这菜谱的厨子倒也自信，说天下能做出这菜的人屈指可数，所以菜谱抄了给我也没关系。"
                                                },
                                                {
                                                    "id": "718290429",
                                                    "speaker": "江雪",
                                                    "text": "这道菜确实很难做。按那厨子的说法，做这道的厨师不仅得精通厨艺，更要通晓剑术。"
                                                },
                                                {
                                                    "id": "718290430",
                                                    "speaker": "言笑",
                                                    "text": "啧，什么菜还要晓得剑术。假若是要剁肉的话，我这刀法就够了。"
                                                },
                                                {
                                                    "id": "718290431",
                                                    "speaker": "江雪",
                                                    "text": "要是你真用你那刀法来锤茸，只怕是肉茸未锤得，案板先被你锤做了两段。"
                                                },
                                                {
                                                    "id": "718290432",
                                                    "speaker": "江雪",
                                                    "text": "据那厨子所说，这道菜的精彩之处，皆在肉茸之上。"
                                                },
                                                {
                                                    "id": "718290433",
                                                    "speaker": "江雪",
                                                    "text": "须以精妙剑术驭刀，先以刃挑去筋络，剁肉成泥，再以刀背捶打成茸，尔后再…"
                                                },
                                                {
                                                    "id": "718290434",
                                                    "speaker": "言笑",
                                                    "text": "停，你给我停一下…那你这菜谱，说了不等于白说，我是个惯常使刀的，你是个从来不下厨的。"
                                                },
                                                {
                                                    "id": "718290435",
                                                    "speaker": "言笑",
                                                    "text": "哪里去找个又会下厨，又善使剑的人？"
                                                },
                                                {
                                                    "id": "718290436",
                                                    "speaker": "江雪",
                                                    "text": "这个嘛…远在天边，近在眼前。",
                                                    "choices": [
                                                        {
                                                            "id": "718290437",
                                                            "text": "我…我？",
                                                            "response": [
                                                                {
                                                                    "id": "718290438",
                                                                    "speaker": "江雪",
                                                                    "text": "正是。这位旅行者不恰巧既会下厨，也善使剑吗？"
                                                                },
                                                                {
                                                                    "id": "718290441",
                                                                    "speaker": "江雪",
                                                                    "text": "#不如，就让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}来试试做这道奇菜。"
                                                                },
                                                                {
                                                                    "id": "718290442",
                                                                    "speaker": "Player",
                                                                    "text": "但掌柜的是让言笑…"
                                                                },
                                                                {
                                                                    "id": "718290443",
                                                                    "speaker": "江雪",
                                                                    "text": "欸，掌柜的是让这厨子琢磨新菜，只要新菜琢磨出来了，那找谁来做，再商议便可。"
                                                                },
                                                                {
                                                                    "id": "718290444",
                                                                    "speaker": "江雪",
                                                                    "text": "厨子，你说是不是这个道理？"
                                                                },
                                                                {
                                                                    "id": "718290445",
                                                                    "speaker": "言笑",
                                                                    "text": "啊…对！是这个理，是这个理！"
                                                                },
                                                                {
                                                                    "id": "718290446",
                                                                    "speaker": "言笑",
                                                                    "text": "但是这鸡豆花，究竟要用什么食材呢？"
                                                                },
                                                                {
                                                                    "id": "718290447",
                                                                    "speaker": "江雪",
                                                                    "text": "食材倒都是寻常的食材，只需禽肉、火腿、鸟蛋和金鱼草便可。"
                                                                },
                                                                {
                                                                    "id": "718290448",
                                                                    "speaker": "言笑",
                                                                    "text": "禽肉和火腿厨房里还有备货，但鸟蛋和金鱼草…好像已经被我用光了…"
                                                                },
                                                                {
                                                                    "id": "718290449",
                                                                    "speaker": "言笑",
                                                                    "text": "唉，早知道就不做那道松茸滑蛋了…"
                                                                },
                                                                {
                                                                    "id": "718290450",
                                                                    "speaker": "言笑",
                                                                    "text": "旅行者，请你帮我找一份鸟蛋，一份金鱼草来吧。"
                                                                },
                                                                {
                                                                    "id": "718290451",
                                                                    "speaker": "言笑",
                                                                    "text": "找到之后，我们就一起来琢磨琢磨这道鸡豆花。"
                                                                },
                                                                {
                                                                    "id": "718290452",
                                                                    "speaker": "言笑",
                                                                    "text": "呃…当然，报酬不会少你的…这件事就拜托你了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "718290439",
                                                            "text": "我确实会点厨艺…",
                                                            "response": [
                                                                {
                                                                    "id": "718290440",
                                                                    "speaker": "江雪",
                                                                    "text": "也很擅长使剑，对吧？我平日里也观察过。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718290428",
                                            "text": "这道菜肯定很难做吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718290405",
                            "text": "你还挺有心得…",
                            "response": [
                                {
                                    "id": "718290406",
                                    "speaker": "江雪",
                                    "text": "哈哈哈，常吃如此美味，就算是我再笨也能吃出心得来，我再教你如何品这道炖鱼…"
                                }
                            ]
                        },
                        {
                            "id": "718290407",
                            "text": "你不坐着一起吃吗？",
                            "response": [
                                {
                                    "id": "718290408",
                                    "speaker": "言笑",
                                    "text": "我？我可吃不下，我早就被掌柜的训饱了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182904",
            "objective": "将食材交给言笑",
            "dialogues": []
        },
        {
            "id": "7182905",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "718290701",
                    "speaker": "言笑",
                    "text": "这样材料就齐了，那咱们就开始吧。",
                    "choices": [
                        {
                            "id": "718290702",
                            "text": "我要怎么开始…",
                            "response": [
                                {
                                    "id": "718290704",
                                    "speaker": "言笑",
                                    "text": "那什么…吃白食的，你在旁边指导指导？"
                                },
                                {
                                    "id": "718290705",
                                    "speaker": "江雪",
                                    "text": "嗯，首先，你先用剑把桌上的肉挑去筋络，细细切碎，再敲打肉末，制成肉茸…"
                                }
                            ]
                        },
                        {
                            "id": "718290703",
                            "text": "那我…要先做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182906",
            "objective": "切肉",
            "dialogues": [
                {
                    "id": "718290601",
                    "speaker": "江雪",
                    "text": "没想到，这道菜谱如今还能派上用场…"
                }
            ]
        },
        {
            "id": "7182907",
            "objective": "向锅中注入清水",
            "dialogues": []
        },
        {
            "id": "7182908",
            "objective": "为炉灶鼓火",
            "dialogues": [
                {
                    "id": "718290801",
                    "speaker": "江雪",
                    "text": "首先，要先用剑把桌上的肉挑去筋络，细细切碎，再敲打肉末，制成肉茸…"
                }
            ]
        },
        {
            "id": "7182909",
            "objective": "与江雪对话",
            "dialogues": [
                {
                    "id": "718291401",
                    "speaker": "言笑",
                    "text": "我尝尝…"
                },
                {
                    "id": "718291402",
                    "speaker": "言笑",
                    "text": "咦，这味道…鲜美得很，但是吃着又像是豆花一样…"
                },
                {
                    "id": "718291403",
                    "speaker": "言笑",
                    "text": "看着卖相也不错，制作的手艺很考究，这「以荤托素」的名号也很是唬人…"
                },
                {
                    "id": "718291404",
                    "speaker": "言笑",
                    "text": "不错！不错！掌柜的肯定会喜欢这道菜！"
                },
                {
                    "id": "718291405",
                    "speaker": "言笑",
                    "text": "没想到啊，吃白食的，你还是有点本事的嘛，居然能把这菜谱记得这么牢。"
                },
                {
                    "id": "718291406",
                    "speaker": "江雪",
                    "text": "呵呵，说出来不怕你笑话。当时我本来是以为，这本菜谱里暗含着什么剑法，就去讨了这本菜谱来日夜钻研…"
                },
                {
                    "id": "718291407",
                    "speaker": "江雪",
                    "text": "如今想来，当时我练剑实在是练得疯了，只是一本菜谱而已，哪里会有什么剑法呢？"
                },
                {
                    "id": "718291408",
                    "speaker": "Player",
                    "text": "你当时练剑到底是为了…"
                },
                {
                    "id": "718291409",
                    "speaker": "江雪",
                    "text": "去找一个人，讨一个公道而已。"
                },
                {
                    "id": "718291410",
                    "speaker": "言笑",
                    "text": "明明是件大气魄的事，你这人怎么说得如此软绵绵的。"
                },
                {
                    "id": "718291411",
                    "speaker": "江雪",
                    "text": "呵呵，讨到公道之后，我就来了这里。所幸掌柜的收留了我，让我在这做个闲人。"
                },
                {
                    "id": "718291412",
                    "speaker": "江雪",
                    "text": "如今我已经别无他求，既不会再挥剑，也没有其他的长处…哈哈哈，就在这了却余生，倒也不错。"
                },
                {
                    "id": "718291413",
                    "speaker": "江雪",
                    "text": "喏，这份食谱我也抄给你一份，你有空的话，也可以自己做来吃一吃，虽然麻烦了些，但味道还是不错的。",
                    "choices": [
                        {
                            "id": "718291414",
                            "text": "谢谢。",
                            "response": [
                                {
                                    "id": "718291417",
                                    "speaker": "言笑",
                                    "text": "唔…这道菜先放在旁边，等掌柜的来了我给他看看…"
                                },
                                {
                                    "id": "718291418",
                                    "speaker": "言笑",
                                    "text": "然后…来来来，吃白食的，你别走了，过来这里。"
                                },
                                {
                                    "id": "718291419",
                                    "speaker": "江雪",
                                    "text": "你要做什么？我可没其他的食谱告诉你了。"
                                },
                                {
                                    "id": "718291420",
                                    "speaker": "言笑",
                                    "text": "你不是说，你除了耍剑没什么长处吗？来，把剑拔出来，我教你剁肉。"
                                },
                                {
                                    "id": "718291421",
                                    "speaker": "江雪",
                                    "text": "剁肉？这…我只怕…"
                                },
                                {
                                    "id": "718291422",
                                    "speaker": "言笑",
                                    "text": "赶紧上手。先学剁肉再学做菜，学几道好菜，多少也是个手艺。"
                                },
                                {
                                    "id": "718291423",
                                    "speaker": "江雪",
                                    "text": "你这是…"
                                },
                                {
                                    "id": "718291424",
                                    "speaker": "言笑",
                                    "text": "哼，赶紧教会你做菜，免得你以后再在我这里蹭饭…"
                                },
                                {
                                    "id": "718291425",
                                    "speaker": "言笑",
                                    "text": "快点！婆婆妈妈的，再磨蹭你明天甭想吃狮子头！"
                                },
                                {
                                    "id": "718291426",
                                    "speaker": "江雪",
                                    "text": "你这厨子！怎得这样威胁我，我剁就是，我剁就是了。"
                                }
                            ]
                        },
                        {
                            "id": "718291415",
                            "text": "你还会继续待在这吗？",
                            "response": [
                                {
                                    "id": "718291416",
                                    "speaker": "江雪",
                                    "text": "那是当然，这厨子做的美食，我可吃不腻。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718290301",
                    "speaker": "江雪",
                    "text": "咦？您可是位稀客。平日里只有我和那厨子相对无言，今天多了您，说不定也会热闹一些。"
                },
                {
                    "id": "718290302",
                    "speaker": "江雪",
                    "text": "但我今天看那厨子愁眉苦脸的，也不知道是不是遇见什么烦心事了…"
                }
            ]
        },
        {
            "id": "7182905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718290501",
                    "speaker": "言笑",
                    "text": "你找到鸟蛋和金鱼草了吗？"
                }
            ]
        },
        {
            "id": "7182909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718290901",
                    "speaker": "言笑",
                    "text": "不知道这菜做出来究竟是什么味道…"
                }
            ]
        },
        {
            "id": "7182910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718291001",
                    "speaker": "江雪",
                    "text": "先这样，你再给这锅加点清水…"
                },
                {
                    "id": "718291002",
                    "speaker": "江雪",
                    "text": "厨子，你再去弄弄火腿和金鱼草，炖一锅高汤，记得要细细滤好。"
                },
                {
                    "id": "718291003",
                    "speaker": "言笑",
                    "text": "行，行，你说什么就是什么…"
                }
            ]
        },
