    "talks": [
        {
            "id": "7221001",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722100101",
                    "speaker": "「寝子」",
                    "text": "哎呀…喵喵，跑到哪里去了…"
                },
                {
                    "id": "722100102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "722100103",
                    "speaker": "「寝子」",
                    "text": "是汝等啊。有些小家伙不知道跑到哪里玩了，真是令人担心哪。"
                },
                {
                    "id": "722100104",
                    "speaker": "「寝子」",
                    "text": "外面可是很危险的。虽然奴家教过它们很多次了。外面又有拿棒子的毛茸茸人，又有…圆形的水和火的东西，可是相当危险哪。"
                },
                {
                    "id": "722100105",
                    "speaker": "「寝子」",
                    "text": "如果跑到酥酥麻麻里面去，还会弄得全身的毛都竖起来。这种滋味，奴家可不希望小家伙们也体会到。"
                },
                {
                    "id": "722100106",
                    "speaker": "「寝子」",
                    "text": "但总有几个不听话的小家伙到处乱跑，奴家每次都要费很大劲把它们找回来…"
                },
                {
                    "id": "722100107",
                    "speaker": "「寝子」",
                    "text": "今天又有几个不知道跑到哪去了。好担心。"
                },
                {
                    "id": "722100108",
                    "speaker": "「寝子」",
                    "text": "汝也帮奴家。找到「昆布丸」和「八宝」。"
                },
                {
                    "id": "722100109",
                    "speaker": "Player",
                    "text": "「昆布丸」是…"
                },
                {
                    "id": "722100110",
                    "speaker": "「寝子」",
                    "text": "是个好孩子。这一代昆布丸很聪明。"
                },
                {
                    "id": "722100111",
                    "speaker": "Player",
                    "text": "「这一代」？"
                },
                {
                    "id": "722100112",
                    "speaker": "「寝子」",
                    "text": "阿响有时候会说到的东西。奴家也不知道是什么，但看她说的时候的表情，那应该是好东西吧。"
                },
                {
                    "id": "722100113",
                    "speaker": "「寝子」",
                    "text": "奴家会用好东西给小家伙取名字。等小家伙长大了、走了以后，奴家就会用这些名字，给更小更小的小家伙取名字。"
                },
                {
                    "id": "722100114",
                    "speaker": "「寝子」",
                    "text": "「昆布丸」喜欢在高的地方睡觉。去好高好高的地方找。"
                },
                {
                    "id": "722100115",
                    "speaker": "Player",
                    "text": "那，「八宝」是…"
                },
                {
                    "id": "722100116",
                    "speaker": "「寝子」",
                    "text": "非常机灵的小家伙。很喜欢吃鱼。所以，有时候会在海边找被冲到岸上的鱼。"
                },
                {
                    "id": "722100117",
                    "speaker": "「寝子」",
                    "text": "但是，很危险。水可是可怕的东西。好久好久以前，有个叫「吾辈」的小家伙就掉到水里去，差点就回不来了。"
                },
                {
                    "id": "722100118",
                    "speaker": "「寝子」",
                    "text": "「八宝」应该在海边看，有没有小鱼和螃蟹。去有咸水的地方找。"
                },
                {
                    "id": "722100119",
                    "speaker": "Player",
                    "text": "太宽泛了…"
                },
                {
                    "id": "722100120",
                    "speaker": "「寝子」",
                    "text": "总之，就是，好高好高，还有咸水。"
                },
                {
                    "id": "722100121",
                    "speaker": "派蒙",
                    "text": "总、总之，把地图拿出来让寝子看看…"
                },
                {
                    "id": "722100122",
                    "speaker": "「寝子」",
                    "text": "汝啊，悟性不行哪。你看，这里就是好高好高。这里就是咸水。它们一定在这两个地方。",
                    "choices": [
                        {
                            "id": "722100123",
                            "text": "交给我们吧。",
                            "response": [
                                {
                                    "id": "722100124",
                                    "speaker": "「寝子」",
                                    "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
                                }
                            ]
                        },
                        {
                            "id": "722100125",
                            "text": "我不擅长抓猫…",
                            "response": [
                                {
                                    "id": "722100126",
                                    "speaker": "「寝子」",
                                    "text": "喵喵，没关系，那些孩子都不怕人的…不如说，正是因为没人陪它们玩，它们才会到处乱跑呢。"
                                },
                                {
                                    "id": "722100127",
                                    "speaker": "「寝子」",
                                    "text": "那就拜托汝等了，喵喵，这些孩子可真是的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221002",
            "objective": "前往海边，将小猫带回神社",
            "dialogues": [
                {
                    "id": "722100201",
                    "speaker": "「八宝」",
                    "text": "喵，喵喵？"
                },
                {
                    "id": "722100202",
                    "speaker": "派蒙",
                    "text": "啊，它应该就是寝子说的「八宝」了…",
                    "choices": [
                        {
                            "id": "722100203",
                            "text": "听话，过来吧…",
                            "response": [
                                {
                                    "id": "722100204",
                                    "speaker": "「八宝」",
                                    "text": "喵喵。"
                                },
                                {
                                    "id": "722100207",
                                    "speaker": "派蒙",
                                    "text": "呜哇，好听话的小猫…"
                                }
                            ]
                        },
                        {
                            "id": "722100205",
                            "text": "喵，喵…",
                            "response": [
                                {
                                    "id": "722100206",
                                    "speaker": "「八宝」",
                                    "text": "喵…喵喵喵？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221006",
            "objective": "前往海边，将小猫带回神社",
            "dialogues": []
        },
        {
            "id": "7221003",
            "objective": "前往高处，将小猫带回神社",
            "dialogues": [
                {
                    "id": "722100301",
                    "speaker": "「昆布丸」",
                    "text": "喵！喵喵，喵！"
                },
                {
                    "id": "722100302",
                    "speaker": "派蒙",
                    "text": "呜啊！好、好凶的小猫，小心点…",
                    "choices": [
                        {
                            "id": "722100303",
                            "text": "喵，喵…",
                            "response": [
                                {
                                    "id": "722100304",
                                    "speaker": "「昆布丸」",
                                    "text": "喵喵？喵…"
                                },
                                {
                                    "id": "722100307",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，虽然很凶，但还是乖乖让你抱着了呢。"
                                }
                            ]
                        },
                        {
                            "id": "722100305",
                            "text": "我是带你回家的。",
                            "response": [
                                {
                                    "id": "722100306",
                                    "speaker": "「昆布丸」",
                                    "text": "喵！喵…喵。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221007",
            "objective": "前往高处，将小猫带回神社",
            "dialogues": []
        },
        {
            "id": "7221005",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "722100501",
                    "speaker": "「寝子」",
                    "text": "汝等，找到那两个孩子了吗？"
                },
                {
                    "id": "722100502",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "722100503",
                    "speaker": "「寝子」",
                    "text": "唔…这样吗？那汝等可要快点啊，不然，那两个孩子也许又会跑到更远的地方去了。"
                }
            ]
        },
        {
            "id": "7221004",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "722100401",
                    "speaker": "「寝子」",
                    "text": "汝等找到他们了吗？"
                },
                {
                    "id": "722100402",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "722100403",
                    "speaker": "「寝子」",
                    "text": "汝等，为什么总是不听奴家的话呢？为什么不能像「阿饭」那样听话呢？"
                },
                {
                    "id": "722100404",
                    "speaker": "Player",
                    "text": "「阿饭」…"
                },
                {
                    "id": "722100405",
                    "speaker": "派蒙",
                    "text": "确实是用好东西当名字呢…"
                },
                {
                    "id": "722100406",
                    "speaker": "「八宝」",
                    "text": "喵，喵喵喵…喵…"
                },
                {
                    "id": "722100407",
                    "speaker": "「昆布丸」",
                    "text": "喵！喵喵！"
                },
                {
                    "id": "722100408",
                    "speaker": "「寝子」",
                    "text": "不许和奴家顶嘴！不然以后奴家可不去找汝等了，就给奴家从…从太阳还在天上，饿到月亮到天上，再饿到太阳跑到天上，然后再自己想办法回来吧！"
                },
                {
                    "id": "722100409",
                    "speaker": "「昆布丸」",
                    "text": "喵…"
                },
                {
                    "id": "722100410",
                    "speaker": "「寝子」",
                    "text": "呵呵，这才是好孩子，好了，回来就好。"
                },
                {
                    "id": "722100411",
                    "speaker": "「寝子」",
                    "text": "多亏汝等了，要是没有汝等帮忙，这小家伙们又要在野外挨饿了。"
                },
                {
                    "id": "722100412",
                    "speaker": "Player",
                    "text": "它们应该能自己回来…"
                },
                {
                    "id": "722100413",
                    "speaker": "「寝子」",
                    "text": "总之，奴家很感谢。"
                },
                {
                    "id": "722100414",
                    "speaker": "「寝子」",
                    "text": "有空的话，记得常来这边看看，奴家说不定还会有事要请汝等搭把手。"
                }
            ]
        }
    ]
