            "dialogues": [
                {
                    "id": "790080101",
                    "speaker": "派蒙",
                    "text": "应该就是这个了吧！"
                },
                {
                    "id": "790080102",
                    "speaker": "派蒙",
                    "text": "嗯？旁边还有一封信…"
                },
                {
                    "id": "790080103",
                    "speaker": "芭芭拉的信",
                    "text": "致有缘来到这里的朋友，"
                },
                {
                    "id": "790080104",
                    "speaker": "芭芭拉的信",
                    "text": "你好呀，远方的人。如果你能看到这封信，应该是找到了我留下的羽球。"
                },
                {
                    "id": "790080105",
                    "speaker": "芭芭拉的信",
                    "text": "金苹果群岛上有不少跟羽球有关的游戏，我和我的朋友们在这里度过了一个非常快乐的夏天。"
                },
                {
                    "id": "790080106",
                    "speaker": "芭芭拉的信",
                    "text": "所以我在这里留下我制作的羽球，但愿偶然发现这个羽球的你也能体验到与我相同的快乐。"
                },
                {
                    "id": "790080107",
                    "speaker": "芭芭拉的信",
                    "text": "请尽情享受阳光、海风与夏日游戏吧。"
                },
                {
                    "id": "790080108",
                    "speaker": "芭芭拉的信",
                    "text": "——芭芭拉"
                },
                {
                    "id": "790080109",
                    "speaker": "派蒙",
                    "text": "不愧是芭芭拉，托她的福，我们也有羽球啦！走吧，让我们玩个痛快！"
                }
            ]
        },
        {
            "id": "7900802",
