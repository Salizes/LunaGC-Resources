    "talks": [
        {
            "id": "2302801",
            "objective": "与雅丝敏对话",
            "dialogues": [
                {
                    "id": "230280101",
                    "speaker": "雅丝敏",
                    "text": "旅行者，你们来得正好，我正在找人帮忙呢。"
                },
                {
                    "id": "230280102",
                    "speaker": "Player",
                    "text": "是圣树根系出问题了吗？"
                },
                {
                    "id": "230280103",
                    "speaker": "雅丝敏",
                    "text": "圣树现在的情况一切正常。"
                },
                {
                    "id": "230280104",
                    "speaker": "雅丝敏",
                    "text": "而我所要做的工作，就是让它继续正常下去。"
                },
                {
                    "id": "230280105",
                    "speaker": "雅丝敏",
                    "text": "具体来说，我所要做的就是把这些药水播撒到圣树根系的周围。"
                },
                {
                    "id": "230280106",
                    "speaker": "雅丝敏",
                    "text": "但这么多药水，我一个人搬不动，拉德普和法尔希也被工作缠住不能来帮忙。"
                },
                {
                    "id": "230280107",
                    "speaker": "雅丝敏",
                    "text": "所以，我就想要请你帮我搬运一下这些药水。",
                    "choices": [
                        {
                            "id": "230280108",
                            "text": "拉德普和法尔希是…",
                            "response": [
                                {
                                    "id": "230280109",
                                    "speaker": "雅丝敏",
                                    "text": "他们和我一样是学生，不过拉德普属于悉般多摩学院，而法尔希属于刹诃伐罗学院。"
                                },
                                {
                                    "id": "230280110",
                                    "speaker": "雅丝敏",
                                    "text": "我们有一个共同的课题，虽然我们之间的理念不同，但目前正在合作。"
                                },
                                {
                                    "id": "230280111",
                                    "speaker": "雅丝敏",
                                    "text": "这些药水，就是我们合作的成果。"
                                },
                                {
                                    "id": "230280113",
                                    "speaker": "雅丝敏",
                                    "text": "嗯，我搬着这一罐，其余的就拜托你帮忙了。"
                                },
                                {
                                    "id": "230280114",
                                    "speaker": "雅丝敏",
                                    "text": "搬运的时候可要小心了，拉德普说，为了防止人误食这种药水，他特意把药水做得很难闻。"
                                },
                                {
                                    "id": "230280115",
                                    "speaker": "雅丝敏",
                                    "text": "要是让药水沾在衣服上，那个难闻的气味可是很久都洗不掉的。"
                                }
                            ]
                        },
                        {
                            "id": "230280112",
                            "text": "那我们就出发吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302802",
            "objective": "与雅丝敏同行",
            "dialogues": []
        },
        {
            "id": "2302805",
            "objective": "和雅丝敏一起播撒药水",
            "dialogues": [
                {
                    "id": "230280501",
                    "speaker": "惊慌的学生",
                    "text": "雅丝敏姐姐！呜哇！"
                },
                {
                    "id": "230280502",
                    "speaker": "惊慌的学生",
                    "text": "我，我要呼吸不过来了，我们快离开这里！"
                },
                {
                    "id": "230280503",
                    "speaker": "派蒙",
                    "text": "这是什么…咳，咳咳！什么气味…"
                },
                {
                    "id": "230280504",
                    "speaker": "雅丝敏",
                    "text": "看来拉德普的工作做得不错嘛。"
                },
                {
                    "id": "230280505",
                    "speaker": "雅丝敏",
                    "text": "这里已经播撒完了，我们去下一个地方吧。就在附近，不用走多远。"
                }
            ]
        },
        {
            "id": "2302806",
            "objective": "和雅丝敏一起播撒药水",
            "dialogues": []
        },
        {
            "id": "2302803",
            "objective": "继续与雅丝敏同行",
            "dialogues": []
        },
        {
            "id": "2302804",
            "objective": "前往播撒药水",
            "dialogues": [
                {
                    "id": "230280401",
                    "speaker": "阿万",
                    "text": "雅丝敏？你怎么在这，呃…你是不是又要来撒你那个药水了？"
                },
                {
                    "id": "230280402",
                    "speaker": "阿万",
                    "text": "那段根系看着一切正常，没有什么问题啊，不需要再撒那种药水了。"
                },
                {
                    "id": "230280403",
                    "speaker": "雅丝敏",
                    "text": "就算是这样，也应该细心照料。"
                },
                {
                    "id": "230280404",
                    "speaker": "雅丝敏",
                    "text": "如果等到问题出现后才想办法，那就像是做鱼卷时，明明卷好了饼，却发现鱼肉没有煮熟。"
                },
                {
                    "id": "230280405",
                    "speaker": "雅丝敏",
                    "text": "无论是重新做，还是拆开卷好的饼，都是一件很麻烦的事。"
                },
                {
                    "id": "230280406",
                    "speaker": "阿万",
                    "text": "我真是说不过你…但我上次也和你提到过那个药水的味道。"
                },
                {
                    "id": "230280407",
                    "speaker": "阿万",
                    "text": "我就住在这附近，可不想闻着那股怪味入睡。"
                },
                {
                    "id": "230280408",
                    "speaker": "雅丝敏",
                    "text": "放心吧，我已经让拉德普修改过药水的配方了，味道不会很刺激的。"
                },
                {
                    "id": "230280409",
                    "speaker": "阿万",
                    "text": "唉，好吧。我先走了啊，你可别来我家院子里撒那种药水，我可受不了…"
                },
                {
                    "id": "230280410",
                    "speaker": "雅丝敏",
                    "text": "好啦，我知道了。旅行者，把那个箱子里的药水递给我吧。"
                },
                {
                    "id": "230280411",
                    "speaker": "Black Screen",
                    "text": "和雅丝敏一起播撒了药水…"
                },
                {
                    "id": "230280412",
                    "speaker": "派蒙",
                    "text": "这药水的味道可真是难闻…"
                },
                {
                    "id": "230280413",
                    "speaker": "Player",
                    "text": "你好像没什么感觉？"
                },
                {
                    "id": "230280414",
                    "speaker": "雅丝敏",
                    "text": "如果你说的是气味方面的话…我接触过很多比这药水还难闻的东西。"
                },
                {
                    "id": "230280415",
                    "speaker": "雅丝敏",
                    "text": "这样就可以了，我也记录了很多数据，法尔希一定会很高兴的。"
                },
                {
                    "id": "230280416",
                    "speaker": "雅丝敏",
                    "text": "这些报酬给你，旅行者，谢谢你一路帮忙。"
                },
                {
                    "id": "230280417",
                    "speaker": "雅丝敏",
                    "text": "也不知道拉德普和法尔希工作得怎么样了…"
                }
            ]
        },
        {
