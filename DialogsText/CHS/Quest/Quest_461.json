    "talks": [
        {
            "id": "46101",
            "objective": "与凯亚对话",
            "dialogues": [
                {
                    "id": "4610101",
                    "speaker": "凯亚",
                    "text": "啊啊糟了…伤脑筋…这可怎么办呢……",
                    "choices": [
                        {
                            "id": "4610102",
                            "text": "怎么了，凯亚？",
                            "response": [
                                {
                                    "id": "4610104",
                                    "speaker": "凯亚",
                                    "text": "#哦，感谢千风。{NICKNAME}，你的出现一定是神对我的恩赐。"
                                },
                                {
                                    "id": "4610105",
                                    "speaker": "凯亚",
                                    "text": "风神派来拯救凡人的使者哟，请问你现在有空吗？"
                                },
                                {
                                    "id": "4610106",
                                    "speaker": "派蒙",
                                    "text": "唔哇，好肉麻。",
                                    "choices": [
                                        {
                                            "id": "4610107",
                                            "text": "也不能说没空…",
                                            "response": [
                                                {
                                                    "id": "4610108",
                                                    "speaker": "凯亚",
                                                    "text": "那可太好了！"
                                                },
                                                {
                                                    "id": "4610110",
                                                    "speaker": "凯亚",
                                                    "text": "其实有件事不方便让骑士团的同事知道，非你帮忙不可。"
                                                },
                                                {
                                                    "id": "4610111",
                                                    "speaker": "凯亚",
                                                    "text": "我想借一步说话…"
                                                },
                                                {
                                                    "id": "4610112",
                                                    "speaker": "凯亚",
                                                    "text": "不如咱们就到骑士团旁边的庭院去吧，随我来。"
                                                },
                                                {
                                                    "id": "4610113",
                                                    "speaker": "派蒙",
                                                    "text": "怎么搞得这么神神秘秘的…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4610109",
                                            "text": "先说说究竟发生了什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4610103",
                            "text": "你好像不是会这么慌张的人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46110",
            "objective": "",
            "dialogues": [
                {
                    "id": "4611001",
                    "speaker": "派蒙",
                    "text": "救。。。救命啊！！"
                }
            ]
        },
        {
            "id": "46102",
            "objective": "在约定地点与凯亚对话",
            "dialogues": [
                {
                    "id": "4610201",
                    "speaker": "凯亚",
                    "text": "好了，就在这里吧。"
                },
                {
                    "id": "4610202",
                    "speaker": "派蒙",
                    "text": "别吊胃口啦，到底有什么事？"
                },
                {
                    "id": "4610203",
                    "speaker": "凯亚",
                    "text": "该从何说起呢…对了。先告诉你们一个秘密吧。"
                },
                {
                    "id": "4610204",
                    "speaker": "凯亚",
                    "text": "那是有关我个人过往的秘密，请千万不要对别人提起。"
                },
                {
                    "id": "4610205",
                    "speaker": "派蒙",
                    "text": "放心，我的口风可是很紧的。"
                },
                {
                    "id": "4610206",
                    "speaker": "凯亚",
                    "text": "其实啊…我的爷爷…是个海盗！"
                },
                {
                    "id": "4610207",
                    "speaker": "派蒙",
                    "text": "哦。"
                },
                {
                    "id": "4610208",
                    "speaker": "凯亚",
                    "text": "…不不。这反应也太冷淡了。难道你不相信我吗？"
                },
                {
                    "id": "4610209",
                    "speaker": "凯亚",
                    "text": "看！我的眼罩就是海盗爷爷的遗传，这就是血亲的证明！",
                    "choices": [
                        {
                            "id": "4610210",
                            "text": "眼罩原来还能遗传的吗？",
                            "response": [
                                {
                                    "id": "4610211",
                                    "speaker": "凯亚",
                                    "text": "#啊哈哈，{NICKNAME}，你还真是没有常识呀。"
                                },
                                {
                                    "id": "4610212",
                                    "speaker": "凯亚",
                                    "text": "这就像许多孩子头上的辫子也遗传自妈妈，是一样的道理啊。"
                                },
                                {
                                    "id": "4610214",
                                    "speaker": "凯亚",
                                    "text": "昨晚我翻阅爷爷留下来的手记，偶然发现了爷爷留下的<color=#00E1FFFF>宝藏</color>信息…"
                                },
                                {
                                    "id": "4610215",
                                    "speaker": "派蒙",
                                    "text": "…宝藏？！"
                                },
                                {
                                    "id": "4610216",
                                    "speaker": "凯亚",
                                    "text": "根据手记上的情报，似乎宝藏被埋藏在「失落的阿卡狄亚遗迹」。"
                                },
                                {
                                    "id": "4610217",
                                    "speaker": "派蒙",
                                    "text": "宝藏…"
                                },
                                {
                                    "id": "4610218",
                                    "speaker": "凯亚",
                                    "text": "但这遗迹的位置具体在哪里，目前还没有线索…"
                                },
                                {
                                    "id": "4610219",
                                    "speaker": "派蒙",
                                    "text": "宝藏！"
                                },
                                {
                                    "id": "4610220",
                                    "speaker": "派蒙",
                                    "text": "凯亚！那究竟是什么宝藏！黄金吗？还是宝石？"
                                },
                                {
                                    "id": "4610221",
                                    "speaker": "凯亚",
                                    "text": "哼哼，只有财宝的宝藏，不过都是三流货色而已…"
                                },
                                {
                                    "id": "4610222",
                                    "speaker": "凯亚",
                                    "text": "我爷爷的宝藏，是「剑」啊。"
                                },
                                {
                                    "id": "4610223",
                                    "speaker": "凯亚",
                                    "text": "据说是一柄只要握住，就可以获得无敌力量的神剑！"
                                },
                                {
                                    "id": "4610224",
                                    "speaker": "派蒙",
                                    "text": "哇——"
                                },
                                {
                                    "id": "4610225",
                                    "speaker": "凯亚",
                                    "text": "那剑是天空岛上的神明失手落入海中的，被爷爷他们碰巧打捞起来。"
                                },
                                {
                                    "id": "4610226",
                                    "speaker": "凯亚",
                                    "text": "他握住剑柄的瞬间，电闪雷鸣，巨浪翻腾，原本晴空万里的海上忽然卷起风暴…"
                                },
                                {
                                    "id": "4610227",
                                    "speaker": "凯亚",
                                    "text": "依靠神剑的力量，爷爷一路击败了八头海蛇、银发女妖、深渊邪龙…"
                                },
                                {
                                    "id": "4610228",
                                    "speaker": "凯亚",
                                    "text": "但这力量过于强大，令其他海盗觊觎不已。"
                                },
                                {
                                    "id": "4610229",
                                    "speaker": "凯亚",
                                    "text": "为了避免争端，爷爷只能把神剑藏了起来。",
                                    "choices": [
                                        {
                                            "id": "4610230",
                                            "text": "八头海蛇、银发女妖…真的存在吗？",
                                            "response": [
                                                {
                                                    "id": "4610231",
                                                    "speaker": "凯亚",
                                                    "text": "这世界就是因为充满了未知，所以才会有趣的嘛。"
                                                },
                                                {
                                                    "id": "4610233",
                                                    "speaker": "凯亚",
                                                    "text": "精彩到令人难以置信的冒险，只属于海盗的浪漫，不是吗？"
                                                },
                                                {
                                                    "id": "4610234",
                                                    "speaker": "派蒙",
                                                    "text": "呜~~~~~~哇！！简直太厉害了！"
                                                },
                                                {
                                                    "id": "4610235",
                                                    "speaker": "凯亚",
                                                    "text": "最近有一伙<color=#00E1FFFF>盗宝团</color>非常活跃，好几处遗迹已经发生文物失窃。"
                                                },
                                                {
                                                    "id": "4610236",
                                                    "speaker": "凯亚",
                                                    "text": "我担心「阿卡狄亚遗迹」也很快会被他们发现，那柄神剑…"
                                                },
                                                {
                                                    "id": "4610237",
                                                    "speaker": "派蒙",
                                                    "text": "那可不行！与其落在坏人手里，还不如我们来…"
                                                },
                                                {
                                                    "id": "4610238",
                                                    "speaker": "派蒙",
                                                    "text": "#…总之，你放心吧！我和{NICKNAME}会帮忙的！"
                                                },
                                                {
                                                    "id": "4610239",
                                                    "speaker": "凯亚",
                                                    "text": "哦~？"
                                                },
                                                {
                                                    "id": "4610240",
                                                    "speaker": "凯亚",
                                                    "text": "那可真是太棒了，还请记得保守秘密，我会等你们的消息。"
                                                },
                                                {
                                                    "id": "4610241",
                                                    "speaker": "派蒙",
                                                    "text": "#喂，怎么样，{NICKNAME}？不觉得很激动吗？那可是超——级厉害的神剑呀。",
                                                    "choices": [
                                                        {
                                                            "id": "4610242",
                                                            "text": "那是真的吗？",
                                                            "response": [
                                                                {
                                                                    "id": "4610244",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯…不如先去<color=#00E1FFFF>冒险家协会</color>附近打探一下情报？"
                                                                },
                                                                {
                                                                    "id": "4610245",
                                                                    "speaker": "派蒙",
                                                                    "text": "关于遗迹的情报，冒险家们会比较清楚吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "4610243",
                                                            "text": "那真的是真的吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4610232",
                                            "text": "……"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4610213",
                            "text": "真令人惊讶。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46109",
            "objective": "(test)到达目标地点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "46103",
            "objective": "前往冒险家协会打听情报",
            "dialogues": [
                {
                    "id": "4610404",
                    "speaker": "派蒙",
                    "text": "哼，我们才不是为了那么无聊的事来的。"
                },
                {
                    "id": "4610405",
                    "speaker": "派蒙",
                    "text": "我们是在找一柄从天空岛上掉下来的，斩杀过八头女妖，银发海蛇的…"
                },
                {
                    "id": "4610406",
                    "speaker": "派蒙",
                    "text": "超级超级厉害的神剑！",
                    "choices": [
                        {
                            "id": "4610407",
                            "text": "是八头海蛇，银发女妖…",
                            "response": [
                                {
                                    "id": "4610408",
                                    "speaker": "派蒙",
                                    "text": "欸，都差不多啦，反正就是…很厉害。"
                                },
                                {
                                    "id": "4610409",
                                    "speaker": "派蒙",
                                    "text": "总而言之，只要不把藏宝地点说出去就好。"
                                },
                                {
                                    "id": "4610413",
                                    "speaker": "Player",
                                    "text": "（就这么说出去了…）"
                                },
                                {
                                    "id": "4610414",
                                    "speaker": "塞琉斯",
                                    "text": "「阿卡狄亚遗迹」…没听说过这名字。"
                                },
                                {
                                    "id": "4610415",
                                    "speaker": "塞琉斯",
                                    "text": "不过还是谢谢你们分享的情报。如果找到的话，记得拿来让我见识见识。"
                                },
                                {
                                    "id": "4610416",
                                    "speaker": "派蒙",
                                    "text": "嗯？分享…情报…？"
                                }
                            ]
                        },
                        {
                            "id": "4610410",
                            "text": "你透露太多情报了。",
                            "response": [
                                {
                                    "id": "4610411",
                                    "speaker": "派蒙",
                                    "text": "没关系啦，只要不把藏宝地点说出去就好。"
                                },
                                {
                                    "id": "4610412",
                                    "speaker": "派蒙",
                                    "text": "那么，塞琉斯先生，你知道「失落的阿卡狄亚遗迹」在哪里吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "46104",
            "objective": "(test)与冒险家对话，打听情报$HIDDEN",
            "dialogues": []
        },
        {
            "id": "46105",
            "objective": "(test)与冒险家对话，打听情报$HIDDEN",
            "dialogues": [
                {
                    "id": "4610513",
                    "speaker": "Player",
                    "text": "不，我们是来…"
                },
                {
                    "id": "4610502",
                    "speaker": "派蒙",
                    "text": "抱歉哦，我们只是想问你知不知道「阿卡狄亚遗迹」在哪里。"
                },
                {
                    "id": "4610503",
                    "speaker": "斯坦利",
                    "text": "…「阿卡狄亚遗迹」？居然还有我斯坦利没去过的地方…"
                },
                {
                    "id": "4610504",
                    "speaker": "派蒙",
                    "text": "斯坦利先生也不知道吗？"
                },
                {
                    "id": "4610505",
                    "speaker": "斯坦利",
                    "text": "唔…先别管什么阿卡狄亚了，不如听我讲讲我在烬寂海、泉之境发生的事…"
                },
                {
                    "id": "4610506",
                    "speaker": "派蒙",
                    "text": "我们没时间听故事啦，再帮忙好好想想有没有什么线索嘛。"
                },
                {
                    "id": "4610507",
                    "speaker": "斯坦利",
                    "text": "当初，我在烬寂海，那可是一片死亡之地…"
                },
                {
                    "id": "4610508",
                    "speaker": "派蒙",
                    "text": "呜——"
                },
                {
                    "id": "4610509",
                    "speaker": "派蒙",
                    "text": "等我们找到<color=#00E1FFFF>宝藏</color>，「阿卡狄亚寻宝记」的故事一定比你的要精彩得多！"
                },
                {
                    "id": "4610510",
                    "speaker": "Player",
                    "text": "（就这么说出去了…）"
                },
                {
                    "id": "4610511",
                    "speaker": "斯坦利",
                    "text": "宝藏？还有…寻宝记？"
                },
                {
                    "id": "4610512",
                    "speaker": "派蒙",
                    "text": "唉，算了。看来他这边问不出什么，我们走吧。"
                }
            ]
        },
        {
            "id": "46106",
            "objective": "(test)与冒险家对话，打听情报$HIDDEN",
            "dialogues": [
                {
                    "id": "4610612",
                    "speaker": "Player",
                    "text": "想请教一下…"
                },
                {
                    "id": "4610602",
                    "speaker": "派蒙",
                    "text": "你好！请问有没有什么关于「阿卡狄亚遗迹」的消息？"
                },
                {
                    "id": "4610603",
                    "speaker": "杰克",
                    "text": "阿卡狄亚…好像没听说过。对不起，我还是协会的新人，了解的情报比较少。"
                },
                {
                    "id": "4610604",
                    "speaker": "派蒙",
                    "text": "这样啊…"
                },
                {
                    "id": "4610605",
                    "speaker": "杰克",
                    "text": "不如试着去协会里挂个委托看看？有实力的老手们也是很活跃的。"
                },
                {
                    "id": "4610606",
                    "speaker": "派蒙",
                    "text": "不行不行不行，这可不行。"
                },
                {
                    "id": "4610607",
                    "speaker": "派蒙",
                    "text": "万一被那些冒险家们捷足先登，把宝藏拿走就完了。"
                },
                {
                    "id": "4610608",
                    "speaker": "Player",
                    "text": "（就这么说出去了…）"
                },
                {
                    "id": "4610609",
                    "speaker": "杰克",
                    "text": "哦~↑↓"
                },
                {
                    "id": "4610610",
                    "speaker": "杰克",
                    "text": "那就没办法了。宝藏的事我会替你们留意的，呃，不，是遗迹的事…"
                },
                {
                    "id": "4610611",
                    "speaker": "派蒙",
                    "text": "好呀，非常感谢！"
                }
            ]
        },
        {
            "id": "46107",
            "objective": "向凯亚报告",
            "dialogues": [
                {
                    "id": "4610801",
                    "speaker": "凯亚",
                    "text": "哦，你们回来了。有带来什么好消息吗？"
                },
                {
                    "id": "4610802",
                    "speaker": "派蒙",
                    "text": "唔嗯…我们在冒险家协会打听了一圈，但还是没找到什么线索。"
                },
                {
                    "id": "4610803",
                    "speaker": "凯亚",
                    "text": "呼呼，那是当然的。"
                },
                {
                    "id": "4610804",
                    "speaker": "派蒙",
                    "text": "嗯？"
                },
                {
                    "id": "4610805",
                    "speaker": "凯亚",
                    "text": "没什么。我是说，不经历一些挫折，又怎么会有得到宝藏时的喜悦呢？"
                },
                {
                    "id": "4610806",
                    "speaker": "凯亚",
                    "text": "对了，正巧我这边倒是有一些消息。"
                },
                {
                    "id": "4610807",
                    "speaker": "凯亚",
                    "text": "我刚托人去了趟地下情报交易所…似乎有人知道「阿卡狄亚遗迹」的相关情报。"
                },
                {
                    "id": "4610808",
                    "speaker": "派蒙",
                    "text": "真的吗？那人在哪里？"
                },
                {
                    "id": "4610809",
                    "speaker": "凯亚",
                    "text": "别急，按照交易所的规矩，他们会安排线人来和我们接头，防止情报泄露。"
                },
                {
                    "id": "4610810",
                    "speaker": "凯亚",
                    "text": "那个线人，我已经约她在低语森林见面了。"
                },
                {
                    "id": "4610811",
                    "speaker": "派蒙",
                    "text": "那我们还在等什么呀，不去找她吗？",
                    "choices": [
                        {
                            "id": "4610812",
                            "text": "这件事凯亚自己不方便出面吧。",
                            "response": [
