    "talks": [
        {
            "id": "7607101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760710101",
                    "speaker": "别蕾娜",
                    "text": "要是能做出美味的面包，就能让大家打起精神来吧。但是现在这状况，有点难办…",
                    "choices": [
                        {
                            "id": "760710102",
                            "text": "遇到什么麻烦了吗？",
                            "response": [
                                {
                                    "id": "760710105",
                                    "speaker": "别蕾娜",
                                    "text": "是这样的，我正打算做一种新的面包，那是小时候妈妈给我做过的像是蘑菇一样的面包。"
                                },
                                {
                                    "id": "760710106",
                                    "speaker": "别蕾娜",
                                    "text": "在我的记忆里，这种面包要先用蘑菇和浆果做成酱馅，然后把酱馅填进揉好的面团，放进烤炉里一起烤。"
                                },
                                {
                                    "id": "760710107",
                                    "speaker": "别蕾娜",
                                    "text": "而其中最重要的，就是一定要用新鲜麦子磨成的面粉，这样做出来的面包才会散发着温暖的味道。"
                                },
                                {
                                    "id": "760710108",
                                    "speaker": "别蕾娜",
                                    "text": "本来我只是想来采一些麦子，但不知道是不是最近同僚们没空照看这里的麦田，附近多了许多奇奇怪怪的小家伙。"
                                },
                                {
                                    "id": "760710109",
                                    "speaker": "别蕾娜",
                                    "text": "要是瓦蒂什先生在的话应该就能处理了吧，但我实在不擅长这些…"
                                },
                                {
                                    "id": "760710110",
                                    "speaker": "别蕾娜",
                                    "text": "所以如果可以的话，能帮我采一点麦子来吗？只要一点点就好。作为回报，我可以教你做温暖的蘑菇面包，拜托啦。"
                                }
                            ]
                        },
                        {
                            "id": "760710103",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "760710104",
                                    "speaker": "别蕾娜",
                                    "text": "哎呀，你别走嘛，能帮我个忙吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7607102",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760710201",
                    "speaker": "别蕾娜",
                    "text": "麦田里有许多奇奇怪怪的小家伙，要小心哦。"
                }
            ]
        },
        {
            "id": "7607103",
            "objective": "(test)废弃",
            "dialogues": [
                {
                    "id": "760710301",
                    "speaker": "别蕾娜",
                    "text": "太好了，谢谢你。有了这些新鲜的麦子，就能做出温暖的面包了。"
                },
                {
                    "id": "760710302",
                    "speaker": "别蕾娜",
                    "text": "那么作为回报，我就把烤制「蘑幻之菇」的方法教给你吧，要记住哦…"
                }
            ]
        },
        {
            "id": "7607104",
