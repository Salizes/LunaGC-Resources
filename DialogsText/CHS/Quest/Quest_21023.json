    "talks": [
        {
            "id": "2102301",
            "objective": "与甄强对话$HIDDEN",
            "dialogues": [
                {
                    "id": "210230101",
                    "speaker": "甄强",
                    "text": "这样就差不多了，真是费劲…"
                },
                {
                    "id": "210230102",
                    "speaker": "Player",
                    "text": "旁边的楼梯…"
                },
                {
                    "id": "210230103",
                    "speaker": "甄强",
                    "text": "楼梯？哦，你是要去客栈上面去吗？"
                },
                {
                    "id": "210230104",
                    "speaker": "甄强",
                    "text": "你来得不巧，上去的楼梯断了两个口子。为了防止有人失足，所以老板干脆把楼梯给封住了。"
                },
                {
                    "id": "210230105",
                    "speaker": "甄强",
                    "text": "虽然修理的事已经在筹备了，但一时半会也走不了人。"
                },
                {
                    "id": "210230106",
                    "speaker": "甄强",
                    "text": "你也别着急，虽然楼梯不能走人了，但这架升降机没问题。"
                },
                {
                    "id": "210230107",
                    "speaker": "甄强",
                    "text": "能运货，运个人自然也不成问题，如果你急着上去，不如就用升降机上去吧。"
                },
                {
                    "id": "210230108",
                    "speaker": "甄强",
                    "text": "然后，顺便帮我把这个东西给老板，是一个客商送给他的礼物。",
                    "choices": [
                        {
                            "id": "210230109",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "210230110",
                                    "speaker": "甄强",
                                    "text": "行，那就你上去吧，记得站稳了啊，这客栈挺高的，升到一半摔下来可不是开玩笑的。"
                                }
                            ]
                        },
                        {
                            "id": "210230111",
                            "text": "你怎么不自己去？",
                            "response": [
                                {
                                    "id": "210230112",
                                    "speaker": "甄强",
                                    "text": "我还得在下面接货呢，还有很多货要接，可不敢耽误。"
                                },
                                {
                                    "id": "210230113",
                                    "speaker": "甄强",
                                    "text": "好了，你快点上去吧，记得站稳了啊，这客栈挺高的，升到一半摔下来可不是开玩笑的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2102302",
            "objective": "乘坐升降机",
            "dialogues": [
                {
                    "id": "210230201",
                    "speaker": "淮安",
                    "text": "楼梯还是得赶紧修了啊…"
                },
                {
                    "id": "210230202",
                    "speaker": "Player",
                    "text": "你是掌柜的吗？"
                },
                {
                    "id": "210230203",
                    "speaker": "淮安",
                    "text": "我是，您有什么事吗？"
                },
                {
                    "id": "210230204",
                    "speaker": "派蒙",
                    "text": "有一份给你的包裹，是楼下的一个人要我们送给你的。"
                },
                {
                    "id": "210230205",
                    "speaker": "淮安",
                    "text": "哦…这应该是客商给我的包裹…甄强怎么自己不来送？"
                },
                {
                    "id": "210230206",
                    "speaker": "淮安",
                    "text": "他还有货要接？嗨，他准是嫌上上下下麻烦，懒得上来又下去…"
                },
                {
                    "id": "210230207",
                    "speaker": "淮安",
                    "text": "您是客人吧，实在对不住，这楼梯坏得太不是时候了，我正寻思着怎么修呢。"
                },
                {
                    "id": "210230208",
                    "speaker": "淮安",
                    "text": "真是麻烦了，还让您来送这个包裹给我，这样，这份报酬给您，您收好。"
                },
                {
                    "id": "210230209",
                    "speaker": "淮安",
                    "text": "这本来是给甄强准备的，但既然他让您来送了这个包裹，那这份报酬当然该您收下。"
                },
                {
                    "id": "210230210",
                    "speaker": "淮安",
                    "text": "好了，我接着去筹备修楼梯的事了，您随意在客栈里逛逛，有什么事您随时找我。"
                }
            ]
        },
        {
            "id": "2102303",
            "objective": "与淮安对话",
            "dialogues": []
        }
    ]
}