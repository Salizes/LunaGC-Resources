                                                                                                                    "text": "#呀哈，真不错，{NICKNAME}独门烤鱼，以后说不定能卖给路人了！"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "751080221",
                                                                                            "text": "枫丹生物有可能怕辣…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "751080222",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "可是，完全没有辣椒的话，好像缺了一点什么，我们就少放一点吧？",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "751080223",
                                                                                                            "text": "猛火强烤，外酥里嫩！"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "751080225",
                                                                                                            "text": "文火慢烤，香软多汁！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "751080217",
                                                                            "text": "水里的膨膨兽怕薄荷清凉吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "751080218",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好像不是这个逻辑喔，水里的膨膨兽上岸应该会很干很热，加一点薄荷酱反而能让它降温吧？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "751080219",
                                                                                            "text": "辣椒，必不可少。"
                                                                                        },
                                                                                        {
                                                                                            "id": "751080221",
                                                                                            "text": "枫丹生物有可能怕辣…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "751080213",
                                                            "text": "味够足，就无需多盐。",
                                                            "response": [
                                                                {
                                                                    "id": "751080214",
                                                                    "speaker": "派蒙",
                                                                    "text": "没错，后边还有其他调料，不一定要放很多盐。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "751080215",
                                                                            "text": "薄荷酱，多多益善。"
                                                                        },
                                                                        {
                                                                            "id": "751080217",
                                                                            "text": "水里的膨膨兽怕薄荷清凉吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751080209",
                                            "text": "花刀打浅一点。",
                                            "response": [
                                                {
                                                    "id": "751080210",
                                                    "speaker": "派蒙",
                                                    "text": "也不错，说不定稍微淡一点，里边保留一部分鱼肉的原味，膨膨兽更习惯。",
                                                    "choices": [
                                                        {
                                                            "id": "751080211",
                                                            "text": "咸一点，吃得更开心。"
                                                        },
                                                        {
                                                            "id": "751080213",
                                                            "text": "味够足，就无需多盐。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751080205",
                            "text": "不是很熟练，但没问题。"
                        }
                    ]
                }
