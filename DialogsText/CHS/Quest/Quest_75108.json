        }
    },
    "talks": [
        {
            "id": "7510801",
            "objective": "(test)到达营地附近$HIDDEN",
            "dialogues": [
                {
                    "id": "751080101",
                    "speaker": "派蒙",
                    "text": "说是要做料理，不过，选哪种料理才好呢？"
                },
                {
                    "id": "751080102",
                    "speaker": "派蒙",
                    "text": "我记得，以前我们给膨膨兽「呜呜葡萄」喂过鱼肉，那鱼料理应该很不错！"
                },
                {
                    "id": "751080103",
                    "speaker": "派蒙",
                    "text": "#要让膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}吃得开心…感觉纳塔特色的「薄荷酱烤鱼」很不错呢。",
                    "choices": [
                        {
                            "id": "751080104",
                            "text": "这个我拿手。",
                            "response": [
                                {
                                    "id": "751080106",
                                    "speaker": "派蒙",
                                    "text": "好，那就开工吧，我也会在一边给你出主意的！",
                                    "choices": [
                                        {
                                            "id": "751080107",
                                            "text": "花刀打深一点。",
                                            "response": [
                                                {
                                                    "id": "751080108",
                                                    "speaker": "派蒙",
                                                    "text": "支持哦，深一点更容易入味。",
                                                    "choices": [
                                                        {
                                                            "id": "751080111",
                                                            "text": "咸一点，吃得更开心。",
                                                            "response": [
                                                                {
                                                                    "id": "751080112",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯，刚刚进嘴那一下的厚实味道，膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}应该都喜欢！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "751080115",
                                                                            "text": "薄荷酱，多多益善。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "751080116",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "清清凉凉的口感，肯定很不错！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "751080119",
                                                                                            "text": "辣椒，必不可少。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "751080120",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "适当的辣味，一点点就开胃！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "751080123",
                                                                                                            "text": "猛火强烤，外酥里嫩！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "751080124",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "嘿嘿，听起来太香了，我都要流口水了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "751080127",
                                                                                                                    "speaker": "Black Screen",
                                                                                                                    "text": "#经过一段精彩的烹饪过程，为膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}特制的烤鱼完成了…"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "751080125",
                                                                                                            "text": "文火慢烤，香软多汁！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "751080126",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "#呀哈，真不错，{NICKNAME}独门秘技之烤鱼…以后说不定能当成拿手料理，做给其他朋友吃！"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "751080121",
                                                                                            "text": "枫丹生物有可能怕辣…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "751080122",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "可是，完全没有辣椒的话，好像缺了一点什么，我们就少放一点吧？",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "751080123",
                                                                                                            "text": "猛火强烤，外酥里嫩！"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "751080125",
                                                                                                            "text": "文火慢烤，香软多汁！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "751080117",
                                                                            "text": "水里的膨膨兽怕薄荷清凉吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "751080118",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好像不是这个逻辑喔，水里的膨膨兽上岸应该会很干很热，加一点薄荷酱反而能让它降温吧？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "751080119",
                                                                                            "text": "辣椒，必不可少。"
                                                                                        },
                                                                                        {
                                                                                            "id": "751080121",
                                                                                            "text": "枫丹生物有可能怕辣…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "751080113",
                                                            "text": "味够足，就无需多盐。",
                                                            "response": [
                                                                {
                                                                    "id": "751080114",
                                                                    "speaker": "派蒙",
                                                                    "text": "没错，后边还有其他调料，不一定要放很多盐。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "751080115",
                                                                            "text": "薄荷酱，多多益善。"
                                                                        },
                                                                        {
                                                                            "id": "751080117",
                                                                            "text": "水里的膨膨兽怕薄荷清凉吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751080109",
                                            "text": "花刀打浅一点。",
                                            "response": [
                                                {
                                                    "id": "751080110",
                                                    "speaker": "派蒙",
                                                    "text": "也不错，说不定稍微淡一点，里边保留一部分鱼肉的原味，膨膨兽更习惯。",
                                                    "choices": [
                                                        {
                                                            "id": "751080111",
                                                            "text": "咸一点，吃得更开心。"
                                                        },
                                                        {
                                                            "id": "751080113",
                                                            "text": "味够足，就无需多盐。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751080105",
                            "text": "不是很熟练，但没问题。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7510803",
            "objective": "(test)清理走私者营地$HIDDEN",
            "dialogues": [
                {
                    "id": "751080301",
                    "speaker": "派蒙",
                    "text": "果然还有一些龙被关着…"
                },
                {
                    "id": "751080302",
                    "speaker": "派蒙",
                    "text": "没想到，之前捣毁了那个据点，他们还是死性不改，继续干着这些伤害龙的坏事。"
                },
                {
                    "id": "751080303",
                    "speaker": "派蒙",
                    "text": "早知道，我们应该当时就追击，把他们全灭的。",
                    "choices": [
                        {
                            "id": "751080304",
                            "text": "没事，现在这群贩子全完了。",
                            "response": [
                                {
                                    "id": "751080305",
                                    "speaker": "派蒙",
                                    "text": "说的也是，我们这就救出被抓的龙吧！"
                                },
                                {
                                    "id": "751080308",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "751080306",
                            "text": "对喔，当时我应该冷酷残忍！",
                            "response": [
                                {
                                    "id": "751080307",
                                    "speaker": "派蒙",
                                    "text": "#冷酷残忍的{NICKNAME}…想象不出来…还是先帮帮它们吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7510808",
            "objective": "(test)清理走私者营地后对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7510804",
            "objective": "(test)释放被关押的动物$HIDDEN",
            "dialogues": [
                {
                    "id": "751080401",
                    "speaker": "派蒙",
                    "text": "欸？这些笼子里怎么关着一些龙？"
                },
                {
                    "id": "751080402",
                    "speaker": "派蒙",
                    "text": "不对劲…难道说，它们都是被那群人强行抓起来的？"
                },
                {
                    "id": "751080403",
                    "speaker": "派蒙",
                    "text": "我们好像在不知不觉中打败了一群…捕捉龙的贩子？",
                    "choices": [
                        {
                            "id": "751080404",
                            "text": "好耶，随手挫败了坏人。",
                            "response": [
                                {
                                    "id": "751080405",
                                    "speaker": "派蒙",
                                    "text": "好耶！我们这就救出被抓的龙吧！"
                                },
                                {
                                    "id": "751080408",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "751080406",
                            "text": "无所谓，顺手干掉坏人而已。",
                            "response": [
                                {
                                    "id": "751080407",
                                    "speaker": "派蒙",
                                    "text": "有所谓啦，被抓的龙重获自由很重要，我们赶快帮帮它们！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7510805",
            "objective": "解救动物们",
            "dialogues": [
                {
                    "id": "751080501",
                    "speaker": "派蒙",
                    "text": "这里居然还有一只…膨膨兽？坏家伙们真是什么动物都倒卖啊…"
                },
                {
                    "id": "751080502",
                    "speaker": "受害的膨膨兽",
                    "text": "嗷…呜呜！"
                },
                {
                    "id": "751080503",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯…嗯！"
                },
                {
                    "id": "751080504",
                    "speaker": "派蒙",
                    "text": "#咦？{REALNAME[ID(2)|SHOWHOST(true)]}怎么好像对膨膨兽很感兴趣？"
                },
                {
                    "id": "751080505",
                    "speaker": "Black Screen",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}认真听了听膨膨兽的叫声，似乎明白了什么，提着膨膨兽的尾巴，将它带到了水边的浅滩上，一起玩耍了起来。"
                },
                {
                    "id": "751080512",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！",
                    "choices": [
                        {
                            "id": "751080506",
                            "text": "膨膨兽好像很热情。",
                            "response": [
                                {
                                    "id": "751080508",
                                    "speaker": "派蒙",
                                    "text": "确实喔，说不定它们两个能交上朋友呢！"
                                },
                                {
                                    "id": "751080509",
                                    "speaker": "派蒙",
                                    "text": "不过，那只膨膨兽好像一点力气都没有，两只…大爪子…都不怎么扑腾了。"
                                },
                                {
                                    "id": "751080510",
                                    "speaker": "派蒙",
                                    "text": "附近连装饭的盘子都没看见…可能它们被关得太久，一直在挨饿。"
                                },
                                {
                                    "id": "751080511",
                                    "speaker": "派蒙",
                                    "text": "#既然如此，我们就给膨膨兽和{REALNAME[ID(2)|SHOWHOST(true)]}做点吃的吧！"
                                }
                            ]
                        },
                        {
                            "id": "751080507",
                            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也很开心。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7510802",
            "objective": "为动物朋友们烹饪料理",
            "dialogues": []
        },
        {
            "id": "7510806",
            "objective": "为动物朋友们送上料理",
            "dialogues": []
        },
        {
            "id": "7510807",
            "objective": "为动物朋友们送上料理",
            "dialogues": [
                {
                    "id": "751080701",
                    "speaker": "派蒙",
                    "text": "好吃的来啦！别光顾着玩哦，该补充一下体力了。"
                },
                {
                    "id": "751080702",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "751080703",
                    "speaker": "虚弱的膨膨兽",
                    "text": "嗷…嗷嗷！"
                },
                {
                    "id": "751080704",
                    "speaker": "派蒙",
                    "text": "吃得真香！就是不知道这样倒过来吃饭，会不会噎着…"
                },
                {
                    "id": "751080705",
                    "speaker": "Player",
                    "text": "别学膨膨兽哦，要注意安全。"
                },
                {
                    "id": "751080706",
                    "speaker": "派蒙",
                    "text": "怎么感觉你这个提醒显得我呆呆的…我又不是膨膨兽，当然不会这样吃东西了。"
                },
                {
                    "id": "751080707",
                    "speaker": "Player",
                    "text": "你也试试不就知道了。"
                },
                {
                    "id": "751080708",
                    "speaker": "派蒙",
                    "text": "喂！我又不是膨膨兽，才不会这样吃东西呢！"
                },
                {
                    "id": "751080709",
                    "speaker": "Black Screen",
                    "text": "膨膨兽似乎恢复了元气，扑腾着跳入海中…"
                },
                {
                    "id": "751080719",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯…嗷！"
                },
                {
                    "id": "751080710",
                    "speaker": "恢复元气的膨膨兽",
                    "text": "嗷，呜…呀！"
                },
                {
                    "id": "751080712",
                    "speaker": "派蒙",
                    "text": "啊，膨膨兽走掉了…"
                },
                {
                    "id": "751080713",
                    "speaker": "Player",
                    "text": "没办法，毕竟不是纳塔的生物。"
                },
                {
                    "id": "751080715",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…"
                },
                {
                    "id": "751080716",
                    "speaker": "派蒙",
                    "text": "#别难过哦，{REALNAME[ID(2)|SHOWHOST(true)]}，你们刚才玩得那么开心，已经成为好朋友了！"
                },
                {
                    "id": "751080717",
                    "speaker": "派蒙",
                    "text": "我有种预感，我们和那只膨膨兽以后还会再见面的！"
                },
                {
                    "id": "751080718",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                }
            ]
        },
        {
