                "count": 35000
            }
        ],
        "rewards_formatted": "冒险阅历 x200, 原石 x30, 摩拉 x35000",
        "chapter": {
            "icon": "UI_ChapterIcon_LittleDrillhead",
            "id": "10204",
            "num": "",
            "title": "龙选者的旅迹"
        },
        "total_dialogue_lines": 127,
        "total_speaker_counts": {
            "#{REALNAME[ID(2)|SHOWHOST(true)]}": 11,
            "Black Screen": 4,
            "Player": 51,
            "受害的膨膨兽": 1,
