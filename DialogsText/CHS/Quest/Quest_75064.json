    "talks": [
        {
            "id": "7506404",
            "objective": "前往马尼菲科的拍摄地点",
            "dialogues": [
                {
                    "id": "750641501",
                    "speaker": "马尼菲科",
                    "text": "我刚刚仿佛听到有人提起我，没想到是你们！哈哈，真是太巧了！"
                },
                {
                    "id": "750641502",
                    "speaker": "派蒙",
                    "text": "哇！我们怎么忘了你还有热气球呢！你也不载我们一程，真是小气！"
                },
                {
                    "id": "750641503",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜嗷！呜嗷！"
                },
                {
                    "id": "750641504",
                    "speaker": "马尼菲科",
                    "text": "你们也没问过呀？"
                },
                {
                    "id": "750641505",
                    "speaker": "派蒙",
                    "text": "我们怎么…唔，你也没有早点跟我们说呀！"
                },
                {
                    "id": "750641507",
                    "speaker": "马尼菲科",
                    "text": "#真高兴再次见到你们！{NICKNAME}{M#先生}{F#小姐}，还有小派蒙！"
                },
                {
                    "id": "750641508",
                    "speaker": "马尼菲科",
                    "text": "哈！我就说我们会再次相见的！正好有一件事需要拜托你们帮忙。"
                },
                {
                    "id": "750641509",
                    "speaker": "派蒙",
                    "text": "在这里吗？是很麻烦的事情吗？"
                },
                {
                    "id": "750641510",
                    "speaker": "马尼菲科",
                    "text": "其实也不麻烦，一会你们就知道了！"
                },
                {
                    "id": "750641511",
                    "speaker": "Black Screen",
                    "text": "马尼菲科灵巧地从热气球上跳下来，从行李中解下映影机与支架，然后在空地组装了起来。\\n很快他便完成了手头的活计，自豪地站在你们面前。"
                },
                {
                    "id": "750641506",
                    "speaker": "马尼菲科",
                    "text": "嘿嘿，请你们让一让，我要降落了！"
                }
            ]
        },
        {
            "id": "7506412",
            "objective": "前往马尼菲科的拍摄地点",
            "dialogues": [
                {
                    "id": "750640412",
                    "speaker": "马尼菲科",
                    "text": "嗒哒！看吧，光与影的奇迹！枫丹的最新工业成果！"
                },
                {
                    "id": "750640413",
                    "speaker": "派蒙",
                    "text": "这东西对我们来说已经不新鲜啦！你还没说要我们帮什么忙呢？",
                    "choices": [
                        {
                            "id": "750640414",
                            "text": "请直说需要我们帮什么忙吧。",
                            "response": [
                                {
                                    "id": "750640415",
                                    "speaker": "派蒙",
                                    "text": "看样子，一定是要我们帮忙拍照吧？"
                                },
                                {
                                    "id": "750640418",
                                    "speaker": "马尼菲科",
                                    "text": "哦哦…好吧，好的！这里是你们的定金，请先拿好。"
                                },
                                {
                                    "id": "750640419",
                                    "speaker": "派蒙",
                                    "text": "这么多钱！！"
                                },
                                {
                                    "id": "750640420",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "哇！！"
                                },
                                {
                                    "id": "750640421",
                                    "speaker": "马尼菲科",
                                    "text": "正如你们所见，我需要给本土的龙类拍几张画片，不是那种动物图鉴上的三视图…不，我要的是那种更有生命力的画片！"
                                },
                                {
                                    "id": "750640422",
                                    "speaker": "派蒙",
                                    "text": "嗯、嗯！"
                                },
                                {
                                    "id": "750640423",
                                    "speaker": "马尼菲科",
                                    "text": "只是…唉，有生命力的东西未必愿意听我指挥。假如方便的话，或许身为冒险家的你们可以帮我拍出足够理想的画片吧？"
                                },
                                {
                                    "id": "750640424",
                                    "speaker": "派蒙",
                                    "text": "嗯、嗯！"
                                },
                                {
                                    "id": "750640425",
                                    "speaker": "马尼菲科",
                                    "text": "当然，假如超出你们能力范围的话也不必勉强啦，不过我想你们至少能保护我不被这附近的生物攻击。"
                                },
                                {
                                    "id": "750640426",
                                    "speaker": "马尼菲科",
                                    "text": "所以，定金请尽管留着吧。帮不帮忙就全看你们咯！"
                                },
                                {
                                    "id": "750640427",
                                    "speaker": "派蒙",
                                    "text": "哇啊…这么多钱，沉甸甸的…真的可以给我们留着吗？"
                                },
                                {
                                    "id": "750640428",
                                    "speaker": "马尼菲科",
                                    "text": "那还有假！这点钱还需要我多加确认吗？"
                                },
                                {
                                    "id": "750640429",
                                    "speaker": "派蒙",
                                    "text": "哈！哈！那你算是找对人啦！我派蒙就是闻名全——纳塔的驯龙大师！"
                                },
                                {
                                    "id": "750640430",
                                    "speaker": "派蒙",
                                    "text": "#没问题，没问题！只要有我和{NICKNAME}在，你想要什么龙，我们都能帮你驯服！"
                                },
                                {
                                    "id": "750640431",
                                    "speaker": "派蒙",
                                    "text": "嵴锋龙？小意思！绒翼龙？太容易！暝视龙？明明白白！还有…呃，鳍游龙、匿叶龙、秃角龙…",
                                    "choices": [
                                        {
                                            "id": "750640432",
                                            "text": "秃角龙？",
                                            "response": [
                                                {
                                                    "id": "750640434",
                                                    "speaker": "派蒙",
                                                    "text": "…大头龙、小手龙、大眼龙、可怕龙、超可怕龙、不那么可怕龙、奇奇怪怪龙、平平常常龙、干干瘦瘦龙、鼓鼓囊囊龙…"
                                                },
                                                {
                                                    "id": "750640435",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "哼哼！",
                                                    "choices": [
                                                        {
                                                            "id": "750640436",
                                                            "text": "那都是些什么啦！",
                                                            "response": [
                                                                {
                                                                    "id": "750640438",
                                                                    "speaker": "派蒙",
                                                                    "text": "还有…嗷呜嗷呜龙！"
                                                                },
                                                                {
                                                                    "id": "750640439",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "嗷呜，嗷呜！"
                                                                },
                                                                {
                                                                    "id": "750640440",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇呀哇呀龙！"
                                                                },
                                                                {
                                                                    "id": "750640441",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "哇！呀！"
                                                                },
                                                                {
                                                                    "id": "750640442",
                                                                    "speaker": "派蒙",
                                                                    "text": "反正、反正我们全都能搞定！相信我，我们可是驯龙大师哦！"
                                                                },
                                                                {
                                                                    "id": "750640443",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "嗯、嗯！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750640444",
                                                                            "text": "唉…我们会帮忙的。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750640445",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#这么多定金都拿了，我们会帮忙的啦！对不对，{REALNAME[ID(2)|SHOWHOST(true)]}？"
                                                                                },
                                                                                {
                                                                                    "id": "750640446",
                                                                                    "speaker": "马尼菲科",
                                                                                    "text": "好耶！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750640447",
                                                                            "text": "抱歉，我现在没空。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750640448",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "可是已经收了定金…"
                                                                                },
                                                                                {
                                                                                    "id": "750640449",
                                                                                    "speaker": "马尼菲科",
                                                                                    "text": "哈，没关系的，等你们下次有时间吧！我也不是非需要帮手不可就是了！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750640437",
                                                            "text": "停一下，听听你自己在说什么！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750640433",
                                            "text": "等等……"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750640416",
                            "text": "请给我钱，我会帮忙。",
                            "response": [
                                {
                                    "id": "750640417",
                                    "speaker": "派蒙",
                                    "text": "我们很酷，请先给钱。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7506409",
            "objective": "（test）隐藏任务第一次同意$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7506411",
            "objective": "(test)隐藏任务第一次不同意$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7506408",
            "objective": "再次与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750640801",
                    "speaker": "马尼菲科",
                    "text": "「路易，路易！」…噢，你们吓了我一跳！"
                },
                {
                    "id": "750640802",
                    "speaker": "马尼菲科",
                    "text": "怎么样，改变主意了？还是说，只是来打个招呼？",
                    "choices": [
                        {
                            "id": "750640803",
                            "text": "打个招呼，顺便帮个忙。",
                            "response": [
                                {
                                    "id": "750640804",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "哼哼~"
                                },
                                {
                                    "id": "750640805",
                                    "speaker": "马尼菲科",
                                    "text": "哈哈，太好了。我们这就开始吧！"
                                }
                            ]
                        },
                        {
                            "id": "750640806",
                            "text": "只是路过而已。",
                            "response": [
                                {
                                    "id": "750640807",
                                    "speaker": "马尼菲科",
                                    "text": "好吧，祝你好运！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7506410",
            "objective": "听取摄影师的需求",
            "dialogues": [
                {
                    "id": "750641101",
                    "speaker": "马尼菲科",
                    "text": "唔…接下来是，月光中的暝视龙…嗯！这个倒是不难。只是，为了找到理想的光源位置还是得费一番功夫。"
                },
                {
                    "id": "750641102",
                    "speaker": "马尼菲科",
                    "text": "#啊…哈！就你来吧！{REALNAME[ID(2)|SHOWHOST(true)]}小朋友！"
                },
                {
                    "id": "750641103",
                    "speaker": "派蒙",
                    "text": "噗，人家的个头明明比你还大点呢！"
                },
                {
                    "id": "750641104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔？嗯？"
                },
                {
                    "id": "750641105",
                    "speaker": "马尼菲科",
                    "text": "很好，很好…现在这个时候正合适…哈哈，我的名作就要完成咯…"
                },
                {
                    "id": "750641106",
                    "speaker": "派蒙",
                    "text": "那你可一定要好好拍哦，就像你拍那些枫丹女孩子一样！嘿嘿，那部映影的台词是这样说的吧？"
                },
                {
                    "id": "750641107",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔，嗯嗯！"
                },
                {
                    "id": "750641108",
                    "speaker": "马尼菲科",
                    "text": "哈哈，你们就放心吧！"
                },
                {
                    "id": "750641109",
                    "speaker": "马尼菲科",
                    "text": "啊！这个角度！太完美了！就是这个月光！"
                },
                {
                    "id": "750641110",
                    "speaker": "马尼菲科",
                    "text": "等等…让我看看，我还需要另外两个光源…一个需要照亮暝视龙的侧脸，用暖光和背景的夜光形成对照…才能呈现出神秘感。"
                },
                {
                    "id": "750641111",
                    "speaker": "马尼菲科",
                    "text": "另一个光源则是要照亮暝视龙的后背轮廓…虽然没什么特别的说法，但很必要。"
                },
                {
                    "id": "750641112",
                    "speaker": "马尼菲科",
                    "text": "嗯…对，就这样…哈！没错！就像梦一样…"
                },
                {
                    "id": "750641113",
                    "speaker": "马尼菲科",
                    "text": "嗯？！可恶！"
                },
                {
                    "id": "750641114",
                    "speaker": "马尼菲科",
                    "text": "不好意思，这里空气中的元素浓度不同于枫丹，机械一定是出了什么问题…各位不用着急，让我检查一下…"
                },
                {
                    "id": "750641115",
                    "speaker": "马尼菲科",
                    "text": "哼哼…嗯…哼哼~呃…不是这里…也不是这里…"
                },
                {
                    "id": "750641116",
                    "speaker": "马尼菲科",
                    "text": "可恶！可恨！该死！啊啊啊！气死我了！你这个娇气的臭混蛋！你这个被惯坏了的蠢东西！啊啊啊！"
                },
                {
                    "id": "750641117",
                    "speaker": "马尼菲科",
                    "text": "你这个…你这个…！"
                },
                {
                    "id": "750641118",
                    "speaker": "派蒙",
                    "text": "呜哇！你冷静一下啦！",
                    "choices": [
                        {
                            "id": "750641119",
                            "text": "它都冒烟了！",
                            "response": [
                                {
                                    "id": "750641122",
                                    "speaker": "马尼菲科",
                                    "text": "呼…它现在…嗯，彻底坏了。"
                                },
                                {
                                    "id": "750641123",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "750641124",
                                    "speaker": "马尼菲科",
                                    "text": "嘿，别那样看着我，至少现在我的心情好多了！"
                                },
                                {
                                    "id": "750641125",
                                    "speaker": "马尼菲科",
                                    "text": "唉…如你所见，我们的人工光源坏掉了…我可在它身上花了不少摩拉，太让人失望了，就像我的前妻…"
                                },
                                {
                                    "id": "750641126",
                                    "speaker": "派蒙",
                                    "text": "好啦，你先打住！不要着急啦，我们来帮忙就好啦！"
                                },
                                {
                                    "id": "750641127",
                                    "speaker": "马尼菲科",
                                    "text": "唉…真不好意思…呼，我需要什么来着？对，需要一个打在暝视龙<color=#00E1FFFF>左侧脸部上</color>的暖光光源，还有一个照亮暝视龙<color=#00E1FFFF>后背轮廓</color>的光源。"
                                },
                                {
                                    "id": "750641128",
                                    "speaker": "派蒙",
                                    "text": "没问题，我们开始吧！"
                                },
                                {
                                    "id": "750641129",
                                    "speaker": "Black Screen",
                                    "text": "于是，马尼菲科又开始摆弄起留影机，留你们自己考虑如何制造合适的光源…"
                                }
                            ]
                        },
                        {
                            "id": "750641120",
                            "text": "清醒点！你们是在闹离婚吗！",
                            "response": [
                                {
                                    "id": "750641121",
                                    "speaker": "派蒙",
                                    "text": "嗯？！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7506405",
            "objective": "完成摄影布光",
            "dialogues": []
        },
        {
            "id": "7506407",
            "objective": "(test)演员请登场",
            "dialogues": [
                {
                    "id": "750640701",
                    "speaker": "马尼菲科",
                    "text": "去打光吧，我这里没什么需要你帮忙的。"
                },
                {
                    "id": "750640702",
                    "speaker": "马尼菲科",
                    "text": "<color=#00E1FFFF>照亮它的左侧脸部和后背轮廓！</color>"
                }
            ]
        },
        {
            "id": "7506406",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750640601",
                    "speaker": "马尼菲科",
                    "text": "哈哈，很好！请我们的小模特不要动…真聪明。三、二、一，咔嚓！"
                },
                {
                    "id": "750640602",
                    "speaker": "马尼菲科",
                    "text": "快看，真是杰作！是谁拍的？是我拍的！是谁拍的？是马尼菲科·德·拉·马尼菲桑斯！"
                },
                {
                    "id": "750640603",
                    "speaker": "马尼菲科",
                    "text": "谢谢你们，真是太感谢了！哈哈！这里是答应你们的尾款！啊…还有这个，你看。"
                },
                {
                    "id": "750640604",
                    "speaker": "派蒙",
                    "text": "哇…尾款！"
                },
                {
                    "id": "750640605",
                    "speaker": "派蒙",
                    "text": "欸？只有一摩拉？"
                },
                {
                    "id": "750640606",
                    "speaker": "马尼菲科",
                    "text": "太好了…接下来，我们真正的主角要登场了！别害羞！像明星一样登场吧！"
                },
                {
                    "id": "750640607",
                    "speaker": "马尼菲科",
                    "text": "呼…完事了！这份副本送给你们做礼物，你们比枫丹的任何画廊都要更早得到这份杰作！",
                    "choices": [
                        {
                            "id": "750640608",
                            "text": "谢谢，我们会珍惜的。",
