    "talks": [
        {
            "id": "7470701",
            "objective": "前往水族箱附近…",
            "dialogues": [
                {
                    "id": "747070101",
                    "speaker": "芙宁娜",
                    "text": "…好，没问题！再来一条——"
                },
                {
                    "id": "747070102",
                    "speaker": "芙宁娜",
                    "text": "好。停——！"
                },
                {
                    "id": "747070103",
                    "speaker": "派蒙",
                    "text": "芙宁娜！还有哥伦比娅和千织，又见面了！"
                },
                {
                    "id": "747070104",
                    "speaker": "芙宁娜",
                    "text": "嗯，我们刚好拍完上次说的氛围镜头。"
                },
                {
                    "id": "747070105",
                    "speaker": "派蒙",
                    "text": "哦！就是让鱼儿来当演员的那个吧，怎么样怎么样？"
                },
                {
                    "id": "747070106",
                    "speaker": "芙宁娜",
                    "text": "多亏你们的帮助，我们找到了一位合适的「演员」。拍摄很顺利！"
                },
                {
                    "id": "747070107",
                    "speaker": "千织",
                    "text": "你们布置水族箱也很有一套。芙宁娜导演刚才还说看得她想去拍部水下纪录片了。",
                    "choices": [
                        {
                            "id": "747070108",
                            "text": "多谢夸奖。",
                            "response": [
                                {
                                    "id": "747070110",
                                    "speaker": "哥伦比娅",
                                    "text": "嗯，我也很喜欢。我能感觉到鱼儿们游得很惬意，很满足，你们照料得很好。"
                                },
                                {
                                    "id": "747070111",
                                    "speaker": "芙宁娜",
                                    "text": "真希望这水族馆一直留在这里呢，这样就能时不时来看看这些鱼了。"
                                },
                                {
                                    "id": "747070112",
                                    "speaker": "千织",
                                    "text": "真舍不得的话，就多剪几个镜头到映影里呗。"
                                },
                                {
                                    "id": "747070113",
                                    "speaker": "芙宁娜",
                                    "text": "你说得对。那干脆再补几条吧！"
                                },
                                {
                                    "id": "747070114",
                                    "speaker": "「少女」",
                                    "text": "补几条鱼？"
                                },
                                {
                                    "id": "747070115",
                                    "speaker": "芙宁娜",
                                    "text": "补镜头啦…灯光师，摄影师，还有场记就位！"
                                },
                                {
                                    "id": "747070116",
                                    "speaker": "派蒙",
                                    "text": "来啦！不过为鱼儿们打板还真是头一回呢…"
                                }
                            ]
                        },
                        {
                            "id": "747070109",
                            "text": "你们喜欢就好。"
                        }
                    ]
                }
            ]
        }
    ]
}