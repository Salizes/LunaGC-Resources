    "talks": [
        {
            "id": "2051301",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205130101",
                    "speaker": "安东尼",
                    "text": "这次的还挺正常…"
                },
                {
                    "id": "205130102",
                    "speaker": "Player",
                    "text": "你这不是挺好的吗？"
                },
                {
                    "id": "205130103",
                    "speaker": "安东尼",
                    "text": "是啊，哎呀，果然是我自己吓自己…"
                },
                {
                    "id": "205130104",
                    "speaker": "安东尼",
                    "text": "安娜的身子也逐渐有起色了，那位神医真是有本事啊。"
                },
                {
                    "id": "205130105",
                    "speaker": "安东尼",
                    "text": "你愿意的话，能接着帮我找药吗？这次是「被风史莱姆吹拂过的风车菊」。",
                    "choices": [
                        {
                            "id": "205130106",
                            "text": "听着不像药。",
                            "response": [
                                {
                                    "id": "205130107",
                                    "speaker": "安东尼",
                                    "text": "嗯…风车菊倒是偶尔会被做成药，不过都是治疗一些轻症…"
                                },
                                {
                                    "id": "205130108",
                                    "speaker": "安东尼",
                                    "text": "难道风史莱姆才是关键，但风车菊和风史莱姆可不会经常凑在一起。"
                                },
                                {
                                    "id": "205130109",
                                    "speaker": "安东尼",
                                    "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方标在你的地图上吧。"
                                },
                                {
                                    "id": "205130110",
                                    "speaker": "安东尼",
                                    "text": "我可不会对付风史莱姆，它们会飞的…所以，只能拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "205130111",
                            "text": "还挺…适合蒙德城的。",
                            "response": [
                                {
                                    "id": "205130112",
                                    "speaker": "安东尼",
                                    "text": "谁说不是呢。但风车菊和风史莱姆可不会经常凑在一起。"
                                },
                                {
                                    "id": "205130113",
                                    "speaker": "安东尼",
                                    "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。"
                                },
                                {
                                    "id": "205130114",
                                    "speaker": "安东尼",
                                    "text": "我实在是不会对付风史莱姆，它们会飞的。所以，就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "205130115",
                            "text": "我再给你抓个风史莱姆回来。",
                            "response": [
                                {
                                    "id": "205130116",
                                    "speaker": "安东尼",
                                    "text": "我说啊，你纯粹就是想看热闹吧。"
                                },
                                {
                                    "id": "205130117",
                                    "speaker": "安东尼",
                                    "text": "不过，风车菊和风史莱姆确实不会经常凑在一起。"
                                },
                                {
                                    "id": "205130118",
                                    "speaker": "安东尼",
                                    "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。"
                                },
                                {
                                    "id": "205130119",
                                    "speaker": "安东尼",
                                    "text": "如果实在找不到。那你就抓个风史莱姆回来吧！为了安娜，我什么都会做…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051302",
            "objective": "取得「被风史莱姆吹拂过的风车菊」",
            "dialogues": [
                {
                    "id": "205130201",
                    "speaker": "安东尼",
                    "text": "你找到东西了吗？"
                },
                {
                    "id": "205130202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "205130203",
                    "speaker": "安东尼",
                    "text": "毕竟还是要战斗，请做好准备再去吧。"
                }
            ]
        },
        {
            "id": "2051303",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205130301",
                    "speaker": "安东尼",
                    "text": "你找到东西了吗？"
                },
                {
                    "id": "205130302",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "205130303",
                    "speaker": "安东尼",
                    "text": "咦？这株风车菊，总感觉和普通的风车菊不一样…"
                },
                {
                    "id": "205130304",
                    "speaker": "安东尼",
                    "text": "哈哈哈，不知道为什么，我有一种这副药吃下去，安娜的病就会好起来的感觉…"
                },
                {
                    "id": "205130305",
                    "speaker": "安东尼",
                    "text": "也许是因为安娜的身体突然有了起色，我乐观过头了吧。"
                },
                {
                    "id": "205130306",
                    "speaker": "安东尼",
                    "text": "总之，辛苦你了，这些是给你的。"
                },
                {
                    "id": "205130307",
                    "speaker": "Player",
                    "text": "希望安娜能好起来。"
                },
                {
                    "id": "205130308",
                    "speaker": "安东尼",
                    "text": "谢谢你，她一定会好起来的。"
                },
                {
                    "id": "205130309",
                    "speaker": "安东尼",
                    "text": "我一直这么相信。"
                }
            ]
        }
