    "talks": [
        {
            "id": "7502401",
            "objective": "",
            "dialogues": [
                {
                    "id": "750240101",
                    "speaker": "？？？",
                    "text": "亲爱的，你们的热情…真叫我招架不住，呼——先吃点冰，冷静一下头脑，之后我们慢慢聊，好吗？"
                },
                {
                    "id": "750240102",
                    "speaker": "嵴锋龙",
                    "text": "嘎呜——！"
                },
                {
                    "id": "750240103",
                    "speaker": "Black Screen",
                    "text": "起初听到「哎哟」一声惨叫，接着就是重物摔到地上的闷响，再之后只剩龙的呜呜声…"
                },
                {
                    "id": "750240104",
                    "speaker": "派蒙",
                    "text": "欸？！那人没事吧…"
                },
                {
                    "id": "750240105",
                    "speaker": "派蒙",
                    "text": "唔…它们围得死死的，不知道里面的人到底怎么样了…"
                },
                {
                    "id": "750240106",
                    "speaker": "Player",
                    "text": "派蒙从上边看看？"
                },
                {
                    "id": "750240107",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750240108",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}好像在说让它试试呢，那就交给它吧！"
                },
                {
                    "id": "750240109",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "750240110",
                    "speaker": "派蒙",
                    "text": "呃，看起来情况不太妙的样子？那人该不会死…呸呸，说不定只是昏过去了，但不管怎么说，我们可不能见死不救呀！"
                },
                {
                    "id": "750240111",
                    "speaker": "派蒙",
                    "text": "唔…麻烦三位借过一下！"
                },
                {
                    "id": "750240112",
                    "speaker": "嵴锋龙",
                    "text": "嘎！呜！"
                },
                {
                    "id": "750240113",
                    "speaker": "鳍游龙",
                    "text": "呜…呜呜？"
                },
                {
                    "id": "750240114",
                    "speaker": "匿叶龙",
                    "text": "呀！"
                },
                {
                    "id": "750240115",
                    "speaker": "派蒙",
                    "text": "呜哇，它们完全不肯让开…到底怎么回事呀？听那人之前的话，应该也不是完全不认识的龙…"
                },
                {
                    "id": "750240116",
                    "speaker": "派蒙",
                    "text": "要是有更多线索就好了…"
                },
                {
                    "id": "750240117",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "…呀！"
                },
                {
                    "id": "750240118",
                    "speaker": "派蒙",
                    "text": "#欸？{REALNAME[ID(2)|SHOWHOST(true)]}！是发现什么了吗？我们快跟上吧。"
                }
            ]
        },
        {
            "id": "7502402",
            "objective": "和龙伙伴一起寻找引开龙的办法",
            "dialogues": [
                {
                    "id": "750240201",
                    "speaker": "谁人的日志",
                    "text": "「…今天是雨天。为小波准备了它最爱的<color=#00E1FFFF>酸汁腌鱼</color>，看到它心满意足的样子，一切也都值得了…」"
                },
                {
                    "id": "750240202",
                    "speaker": "谁人的日志",
                    "text": "「…哪怕它原本在纵情畅游，但只要端出<color=#00E1FFFF>酸汁腌鱼</color>，它就会从水中跃出，那弧线堪称完美！…」"
                },
                {
                    "id": "750240203",
                    "speaker": "谁人的日志",
                    "text": "「…我是不会怀疑它对我的爱的，只是担心，会不会其实它爱<color=#00E1FFFF>酸汁腌鱼</color>更甚于我…」"
                },
                {
                    "id": "750240204",
                    "speaker": "派蒙",
                    "text": "小波…指的应该是鳍游龙吧，营地的锅里煮着的也是酸汁腌鱼，肯定是为它准备的。"
                },
                {
                    "id": "750240205",
                    "speaker": "谁人的日志",
                    "text": "「…圆溜溜的眼睛，卷卷的尾巴，神气快活的叫声…翡翠啊翡翠，这世上还会有比你更可爱的小龙吗？…」"
                },
                {
                    "id": "750240206",
                    "speaker": "谁人的日志",
                    "text": "「…从没受过欺骗，也不懂得怀疑，好像和这世上所有的生灵都能成为朋友，共享玩耍的乐趣…」"
                },
                {
                    "id": "750240207",
                    "speaker": "谁人的日志",
                    "text": "「…要不是太忙，我真想整日整夜陪你玩耍，看你在阳光斑驳的林间穿梭，好像风的孩子，无忧无虑的精灵！…」"
                },
                {
                    "id": "750240208",
                    "speaker": "派蒙",
                    "text": "#唔，看来那只小匿叶龙叫做翡翠，还是只贪玩的小龙。说不定{REALNAME[ID(2)|SHOWHOST(true)]}也能跟它交上朋友呢。"
                },
                {
                    "id": "750240209",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750240210",
                    "speaker": "谁人的日志",
                    "text": "「…我遍踏丘陵与山谷，只为了寻得你的踪迹。如果你真的不待见我，大可以一走了之…」"
                },
                {
                    "id": "750240211",
                    "speaker": "谁人的日志",
                    "text": "「…但你却照顾我的脚程，走走停停，甚至为我收集许多颗粒果，还有那些亮晶晶的石块…」"
                },
                {
                    "id": "750240212",
                    "speaker": "谁人的日志",
                    "text": "「…我心爱的金盏花，只有我知道，硬壳包裹下是柔软体贴的心，好勇斗狠绝非你的本意…」"
                },
                {
                    "id": "750240213",
                    "speaker": "派蒙",
                    "text": "呃…金盏花该不会是说那只脾气暴躁的嵴锋龙吧？那副气势汹汹把人击倒的样子，哪有一丝温柔体贴的影子啊！"
                },
                {
                    "id": "750240214",
                    "speaker": "派蒙",
                    "text": "不过话说回来，原来这三只龙都是他的…朋友？到底为什么会把他撞昏还团团围住呢…"
                },
                {
                    "id": "750240215",
                    "speaker": "Player",
                    "text": "先把人救出来再问吧。"
                },
                {
                    "id": "750240216",
                    "speaker": "派蒙",
                    "text": "说的也是，要是有办法让龙让开就好了…对了，日志里不是说小波喜欢吃酸汁腌鱼吗？正好营地里也有，说不定能把它引开。",
                    "choices": [
                        {
                            "id": "750240217",
                            "text": "#让{REALNAME[ID(2)|SHOWHOST(true)]}和翡翠交朋友呢？",
                            "response": [
                                {
                                    "id": "750240218",
                                    "speaker": "派蒙",
                                    "text": "#嗯！翡翠很贪玩，{REALNAME[ID(2)|SHOWHOST(true)]}只要带它去旁边玩就好啦。"
                                },
                                {
                                    "id": "750240221",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750240222",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也很有干劲呢！不过我们还是先试试最简单的方法吧，酸汁腌鱼不吃不就浪费了吗？"
                                }
                            ]
                        },
                        {
                            "id": "750240219",
                            "text": "和金盏花决斗吧。",
                            "response": [
                                {
                                    "id": "750240220",
                                    "speaker": "派蒙",
                                    "text": "#还是先试试和平的手段吧！比如让{REALNAME[ID(2)|SHOWHOST(true)]}把贪玩的翡翠引开…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502403",
            "objective": "带上营地的酸汁腌鱼",
            "dialogues": []
        },
        {
            "id": "7502404",
            "objective": "在合适的地方摆上酸汁腌鱼",
            "dialogues": []
        },
        {
            "id": "7502409",
            "objective": "等一会儿…",
            "dialogues": [
                {
                    "id": "750240901",
                    "speaker": "派蒙",
                    "text": "哦，果然被料理的香气吸引过去了呢。"
                },
                {
                    "id": "750240902",
                    "speaker": "派蒙",
                    "text": "#唔…但是空隙感觉还不够，{REALNAME[ID(2)|SHOWHOST(true)]}可以去把翡翠引开吗？"
                },
                {
                    "id": "750240903",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750240904",
                    "speaker": "派蒙",
                    "text": "好喔，那就交给你啦！"
                },
                {
                    "id": "750240905",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，等{REALNAME[ID(2)|SHOWHOST(true)]}引开翡翠，我们就去看看那人要不要紧吧！"
                }
            ]
        },
        {
            "id": "7502405",
            "objective": "等龙伙伴引走匿叶龙",
            "dialogues": []
        },
        {
            "id": "7502406",
            "objective": "与嵴锋龙交涉",
            "dialogues": [
                {
                    "id": "750240601",
                    "speaker": "「金盏花」",
                    "text": "嘎呜——！"
                },
                {
                    "id": "750240602",
                    "speaker": "派蒙",
                    "text": "你不要激动，我们只是担心那个人有没有受伤…",
                    "choices": [
                        {
                            "id": "750240603",
                            "text": "看来只能决斗了。",
                            "response": [
                                {
                                    "id": "750240604",
                                    "speaker": "派蒙",
                                    "text": "不要这么快就放弃嘛！小金盏花，我们没有恶意的，我们也知道，呃，好勇斗狠绝对不是你的本意…"
                                },
                                {
                                    "id": "750240606",
                                    "speaker": "「金盏花」",
                                    "text": "嘎！呜！"
                                },
                                {
                                    "id": "750240607",
                                    "speaker": "派蒙",
                                    "text": "哇…它怎么更生气了！"
                                }
                            ]
                        },
                        {
                            "id": "750240605",
                            "text": "「我心爱的金盏花」…"
                        }
                    ]
                }
            ]
        },
