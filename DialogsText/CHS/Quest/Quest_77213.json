    "talks": [
        {
            "id": "7721301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130101",
                    "speaker": "？？？",
                    "text": "热身准备已经做好了！看看今天能够坚持多久…"
                },
                {
                    "id": "772130102",
                    "speaker": "派蒙",
                    "text": "咦，纳塔人，你在这里做什么？"
                },
                {
                    "id": "772130103",
                    "speaker": "赛路吉",
                    "text": "嗯？我叫赛路吉，是在…锤炼自己的身躯，通过将身躯浸透入极寒的水中。"
                },
                {
                    "id": "772130104",
                    "speaker": "派蒙",
                    "text": "这、这样不会被冻伤吗？"
                },
                {
                    "id": "772130105",
                    "speaker": "赛路吉",
                    "text": "嘿嘿，像小家伙你这样瘦胳膊瘦腿当然还是会被冻伤的。"
                },
                {
                    "id": "772130106",
                    "speaker": "赛路吉",
                    "text": "不过经过修炼的战士，即便是如此冰冷的水，也可用体内的热血将之变成温泉，甚至是灼烫之河！",
                    "choices": [
                        {
                            "id": "772130107",
                            "text": "好厉害！",
                            "response": [
                                {
                                    "id": "772130109",
                                    "speaker": "赛路吉",
                                    "text": "呵呵，此等修炼方法所带来的功效，只要一试便知。有天赋的人只要如此锻炼过一次，很快就能掌握「烈泉之道」！"
                                },
                                {
                                    "id": "772130110",
                                    "speaker": "赛路吉",
                                    "text": "据说「烈泉之道」上甚至还有「熔岩之道」，到了那时，对手甚至在靠近出手之前，就会因体内血液的蒸发而倒下…"
                                },
                                {
                                    "id": "772130111",
                                    "speaker": "派蒙",
                                    "text": "喔，听上去确实好厉害！"
                                },
                                {
                                    "id": "772130112",
                                    "speaker": "赛路吉",
                                    "text": "不过修炼毕竟枯燥…我们不如，让我想想…"
                                },
                                {
                                    "id": "772130113",
                                    "speaker": "赛路吉",
                                    "text": "不如这样，我们就比较一下谁能在冰河之中忍耐更久的时间吧！这就是所谓的「耐寒比赛」！"
                                },
                                {
                                    "id": "772130114",
                                    "speaker": "赛路吉",
                                    "text": "规则很简单，你我都坐在河中的椅子上，谁先忍受不住起身，谁就输了。"
                                },
                                {
                                    "id": "772130115",
                                    "speaker": "赛路吉",
                                    "text": "一想到能在此处与人比试，内心的一角也不禁沸腾了起来啊。",
                                    "choices": [
                                        {
                                            "id": "772130116",
                                            "text": "恭敬不如从命…",
                                            "response": [
                                                {
                                                    "id": "772130117",
                                                    "speaker": "派蒙",
                                                    "text": "真、真的要和她比吗？"
                                                },
                                                {
                                                    "id": "772130118",
                                                    "speaker": "赛路吉",
                                                    "text": "哈哈，那就开始吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "772130119",
                                            "text": "还是算了…",
                                            "response": [
                                                {
                                                    "id": "772130120",
                                                    "speaker": "赛路吉",
                                                    "text": "可惜，我能感受到你身上有如太阳一般耀眼的力量，希望下次见面，有能够与你切磋的机会。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "772130108",
                            "text": "听上去很不靠谱…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7721308",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130801",
                    "speaker": "赛路吉",
                    "text": "如果要开始的话…就在冰河中的椅子上坐下吧！"
                }
            ]
        },
        {
            "id": "7721302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7721303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130301",
                    "speaker": "赛路吉",
                    "text": "唔啊…真是了不起，我冻得感觉脚趾都被水流冲走了，你居然还如浴春风，面不改色。"
                },
                {
                    "id": "772130302",
                    "speaker": "赛路吉",
                    "text": "真是可怕，难道你们有什么特殊的御寒秘籍吗…"
                },
                {
                    "id": "772130303",
                    "speaker": "派蒙",
                    "text": "这倒是没有啦…不过我们有「眼镜」，呃…就是能够保持体表温度的道具。"
                },
                {
                    "id": "772130304",
                    "speaker": "赛路吉",
                    "text": "…什、什么呀，居然是靠道具。"
                },
                {
                    "id": "772130305",
                    "speaker": "赛路吉",
                    "text": "倒也没有说靠道具不好的意思啦，我有的时候也会在下水前喝热的甜菜汤，暖呼呼的也能稍微御寒。"
                },
                {
                    "id": "772130306",
                    "speaker": "赛路吉",
                    "text": "但是用那种特别厉害的道具总觉得不是自己真实实力…呜，我承认自己有不甘心的成分啦…"
                },
                {
                    "id": "772130307",
                    "speaker": "赛路吉",
                    "text": "待会儿卸掉那个什么「眼镜」，再来和我比试一场吧…"
                }
            ]
        },
        {
            "id": "7721304",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130401",
                    "speaker": "赛路吉",
                    "text": "再来和我比试一场吧，只要坐在椅子上，比赛就开始！不要用那什么「眼镜」！"
                }
            ]
        },
        {
            "id": "7721305",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130501",
                    "speaker": "赛路吉",
                    "text": "想要再比试一场吗？只要坐在椅子上，比赛就开始…不许用那什么「眼镜」哦！"
                }
            ]
        },
        {
            "id": "7721309",
            "objective": "(test)第二轮失败后对话",
            "dialogues": [
                {
                    "id": "772131001",
                    "speaker": "<UNKNOWN>",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7721306",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772130701",
                    "speaker": "赛路吉",
                    "text": "了不起，看来你天赋异禀，继续修炼下去，总有一天一定能够成为「烈泉道」大师的。"
                },
                {
                    "id": "772130702",
                    "speaker": "赛路吉",
                    "text": "嗯嗯…对了，赢得了比赛就得有奖励，好，这些给你们吧！"
                },
                {
                    "id": "772130703",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那我们就收下啦。"
                },
                {
                    "id": "772130704",
                    "speaker": "赛路吉",
                    "text": "你们如今越过了「温水不冷」和「凉水不冷」的境界…说不定马上就能到「冰水不冷」的位阶了。"
                },
                {
                    "id": "772130705",
                    "speaker": "派蒙",
                    "text": "这个「冰水不冷」听上去也没什么了不起的嘛…"
                },
                {
                    "id": "772130706",
                    "speaker": "赛路吉",
                    "text": "怎么能这样说，这可是故事的主角修炼到轻小说第八卷才达到的境界，很了不起呢。"
                },
                {
                    "id": "772130707",
                    "speaker": "派蒙",
                    "text": "原来是轻小说啊！"
                }
            ]
        },
        {
            "id": "7721307",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7721309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772130901",
                    "speaker": "赛路吉",
                    "text": "呼呼…刚从冰水里上岸还是有点冷…"
                },
                {
                    "id": "772130902",
                    "speaker": "赛路吉",
                    "text": "呃，甜菜汤，再煮点甜菜汤喝好了！"
                }
            ]
        }
    ]
}