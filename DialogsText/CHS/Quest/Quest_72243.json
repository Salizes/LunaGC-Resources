    "talks": [
        {
            "id": "7224301",
            "objective": "(test)找玛乔丽对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722430101",
                    "speaker": "玛乔丽",
                    "text": "欢迎光临，旅行者。需要些什么吗？"
                },
                {
                    "id": "722430102",
                    "speaker": "Player",
                    "text": "我有宝物想要出售。"
                },
                {
                    "id": "722430103",
                    "speaker": "玛乔丽",
                    "text": "出售宝物？真是令人意外。"
                },
                {
                    "id": "722430104",
                    "speaker": "玛乔丽",
                    "text": "像您这样强大的冒险家，想要出售的东西一定很罕见吧？"
                },
                {
                    "id": "722430105",
                    "speaker": "玛乔丽",
                    "text": "快请让我看看。"
                },
                {
                    "id": "722430106",
                    "speaker": "Black Screen",
                    "text": "将龙骨花凝珠的故事告诉了玛乔丽。"
                },
                {
                    "id": "722430107",
                    "speaker": "玛乔丽",
                    "text": "啊，这不是就像是吟游诗人的故事里说的忘忧果吗？"
                },
                {
                    "id": "722430108",
                    "speaker": "玛乔丽",
                    "text": "居然真的有这种东西存在吗…原来它叫龙骨花凝珠。"
                },
                {
                    "id": "722430109",
                    "speaker": "玛乔丽",
                    "text": "如果它的效果真的和您所说的一样，我愿意花80000摩拉加一些特色料理买下它。"
                },
                {
                    "id": "722430110",
                    "speaker": "玛乔丽",
                    "text": "嗯…80000摩拉加上5个月亮派，您觉得怎么样？",
                    "choices": [
                        {
                            "id": "722430111",
                            "text": "你会拿它做什么？",
                            "response": [
                                {
                                    "id": "722430112",
                                    "speaker": "玛乔丽",
                                    "text": "嘻嘻，多么独特的宝物呀。"
                                },
                                {
                                    "id": "722430113",
                                    "speaker": "玛乔丽",
                                    "text": "童话一般的神奇功效，我相信那些炼金术士们不会吝惜自己的钱包。"
                                }
                            ]
                        },
                        {
                            "id": "722430114",
                            "text": "公道的价格，成交。",
                            "response": [
                                {
                                    "id": "722430115",
                                    "speaker": "玛乔丽",
                                    "text": "那我就收下这件宝物了，多谢惠顾。"
                                },
                                {
                                    "id": "722430116",
                                    "speaker": "玛乔丽",
                                    "text": "对了，通常来说，这种凝珠类的物品会在风中缓慢挥发。"
                                },
                                {
                                    "id": "722430117",
                                    "speaker": "玛乔丽",
                                    "text": "所以，最好将它覆上隔膜或者放进容器密封起来，这样成色会更好。"
                                },
                                {
                                    "id": "722430118",
                                    "speaker": "玛乔丽",
                                    "text": "这是一点附送您的小技巧，希望对您的冒险有帮助。"
                                },
                                {
                                    "id": "722430119",
                                    "speaker": "玛乔丽",
                                    "text": "如果今后您又找到了类似的宝物，别忘了，这儿有您忠实的买家。"
                                }
                            ]
                        },
                        {
                            "id": "722430120",
                            "text": "我再考虑一下。",
                            "response": [
                                {
                                    "id": "722430121",
                                    "speaker": "玛乔丽",
                                    "text": "哈哈，没问题，但是我相信我的价格是最合适的。"
                                },
                                {
                                    "id": "722430122",
                                    "speaker": "玛乔丽",
                                    "text": "如果您考虑好了，可以再来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
