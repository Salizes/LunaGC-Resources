    "talks": [
        {
            "id": "7517915",
            "objective": "",
            "dialogues": [
                {
                    "id": "751790401",
                    "speaker": "蒂兹洛",
                    "text": "喂！你，对就是你，外面危险，快进来！"
                },
                {
                    "id": "751790402",
                    "speaker": "蒂兹洛",
                    "text": "哎呀，你没看见这一路的惨相吗？这又是火山喷发，又是有怪物拦路的，可不敢再往前走了。"
                },
                {
                    "id": "751790403",
                    "speaker": "蒂兹洛",
                    "text": "你呀，听我一句劝。先在这里等等，等一下跟我们商队的人一起走，这样也有个照应。要不然一个人走多危险啊？",
                    "choices": [
                        {
                            "id": "751790404",
                            "text": "怪物？",
                            "response": [
                                {
                                    "id": "751790405",
                                    "speaker": "蒂兹洛",
                                    "text": "是一群紫色的嵴锋龙！一看就是被深渊污染了！破坏力特别强，说实话我从来没见过这么吓人的嵴锋龙！"
                                },
                                {
                                    "id": "751790406",
                                    "speaker": "蒂兹洛",
                                    "text": "我跟你说，那几个家伙随便扫了一下尾巴就把我们的大车给打坏了，力气比突角龙还大，这肯定不是一般人能处理的对手。"
                                },
                                {
                                    "id": "751790407",
                                    "speaker": "蒂兹洛",
                                    "text": "你听我一句，你可千万不要头脑一热跑去跟它们打架啊，见到它们还是绕开一点为好。"
                                }
                            ]
                        },
                        {
                            "id": "751790408",
                            "text": "没事，我能行。",
                            "response": [
                                {
                                    "id": "751790409",
                                    "speaker": "蒂兹洛",
                                    "text": "你，唉…好吧，那你路上小心…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517916",
            "objective": "",
            "dialogues": [
                {
                    "id": "751791001",
                    "speaker": "Player",
                    "text": "分享燃素。"
                },
                {
                    "id": "751791002",
                    "speaker": "Player",
                    "text": "（它眨了眨眼，似乎是在道谢。）"
                }
            ]
        },
        {
            "id": "7517903",
            "objective": "",
            "dialogues": [
                {
                    "id": "751790201",
                    "speaker": "扎什",
                    "text": "吁吁——",
                    "choices": [
                        {
                            "id": "751790202",
                            "text": "还好吗？",
                            "response": [
                                {
                                    "id": "751790203",
                                    "speaker": "扎什",
                                    "text": "还、还好，就是刚刚跑得有点急，心、心慌得厉害，缓一缓就好了。"
                                }
                            ]
                        },
                        {
                            "id": "751790204",
                            "text": "好好休息。",
                            "response": [
                                {
                                    "id": "751790205",
                                    "speaker": "扎什",
                                    "text": "嗯，谢、谢谢关心…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517901",
            "objective": "(test)异色脊峰龙和沃陆商队$HIDDEN",
            "dialogues": [
                {
                    "id": "751790101",
                    "speaker": "马索瑟",
                    "text": "那边的，住、住手！这些都是我们的！不许动！告诉你，我、我可是能参加「巡夜者战争」的！"
                },
                {
                    "id": "751790102",
                    "speaker": "马索瑟",
                    "text": "你、你要是敢抢我们的东西，我一定让你吃不了兜着走！"
                },
                {
                    "id": "751790103",
                    "speaker": "伊察霍",
                    "text": "唉…今天怎么回事儿啊？又是火山喷发，又是紫色嵴锋龙的…现在又冒出一堆劫道的来，真是倒霉…"
                },
                {
                    "id": "751790104",
                    "speaker": "伊察霍",
                    "text": "#马索瑟，{M#他}{F#她}看起来蛮厉害的，打不过的，还是算了吧…而且，我们只是看比赛的，应该不算是参加了吧…"
                },
                {
                    "id": "751790105",
                    "speaker": "马索瑟",
                    "text": "#伊察霍，你、你这家伙！你怎么能这样，这可是大家的东西！再、再说了，我、我们两个打{M#他}{F#她}一个，未必打不过。"
                },
                {
                    "id": "751790106",
                    "speaker": "伊察霍",
                    "text": "谁说是两个人？要挨打你上，可别算上我…"
                },
                {
                    "id": "751790107",
                    "speaker": "伊察霍",
                    "text": "#这位{M#大哥}{F#大姐}，东西我们不要了，你想要你就拿去。只要别动手就行…",
                    "choices": [
                        {
                            "id": "751790108",
                            "text": "这肯定是有点误会…",
                            "response": [
                                {
                                    "id": "751790111",
                                    "speaker": "派蒙",
                                    "text": "你们都误会啦！我们可是乐于助人的好冒险家，才不是那种不明不白的坏人呢！"
                                },
                                {
                                    "id": "751790112",
                                    "speaker": "马索瑟",
                                    "text": "我、我凭什么相信你们！啊！好痛，伊察霍你为什么打我？"
                                },
                                {
                                    "id": "751790113",
                                    "speaker": "伊察霍",
                                    "text": "人家要不怀好意，早就揍你了，还用得着跟你在这里浪费口舌。"
                                },
                                {
                                    "id": "751790114",
                                    "speaker": "伊察霍",
                                    "text": "两位，实不相瞒，我们商队刚刚被打散了，既然你们是冒险家的话，不知道能不能帮我们通知一下老大，就说我们在这里等她。"
                                },
                                {
                                    "id": "751790115",
                                    "speaker": "伊察霍",
                                    "text": "箱子里的东西，就当是我们给的谢礼了。"
                                },
                                {
                                    "id": "751790116",
                                    "speaker": "派蒙",
                                    "text": "这个简单，就交给我们吧！"
                                }
                            ]
                        },
                        {
                            "id": "751790109",
                            "text": "你倒是挺上道的…",
                            "response": [
                                {
                                    "id": "751790110",
                                    "speaker": "派蒙",
                                    "text": "喂！你这说法！别搞得我们像是那种坏人一样啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517902",
            "objective": "(test)分支1: 异色脊峰龙作乱传闻$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7517912",
            "objective": "(test)7517902保底-与NPC对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7517914",
            "objective": "(test)对话后前往队长位置防回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7517908",
            "objective": "(test)分支2: 帮助商队开路$HIDDEN",
            "dialogues": [
                {
                    "id": "751791101",
                    "speaker": "戈奇胡",
                    "text": "这可怎么办啊？这可怎么办啊？等回去，老大她非得打我一顿不可…",
                    "choices": [
                        {
                            "id": "751791102",
                            "text": "发生什么事儿了？",
                            "response": [
                                {
                                    "id": "751791103",
                                    "speaker": "戈奇胡",
                                    "text": "唉…我们商队原本在路上走得好好的，结果突然遇上了火山喷发，地里还钻出了好几头紫色的嵴锋龙。"
                                },
                                {
                                    "id": "751791104",
                                    "speaker": "戈奇胡",
                                    "text": "我一个不小心，让我的龙伙伴受了惊脱离了队伍。结果现在回头一看，发现路被堵了，跟大家没办法汇合了…"
                                },
                                {
                                    "id": "751791105",
                                    "speaker": "戈奇胡",
                                    "text": "唉…也不知道大家都怎么样了。我这样擅自脱队，老大现在一定很生气，完了完了，这下我可完蛋了…"
                                }
                            ]
                        },
                        {
                            "id": "751791106",
                            "text": "换我我就跑…",
                            "response": [
                                {
                                    "id": "751791107",
                                    "speaker": "戈奇胡",
                                    "text": "跑？不行不行，老大那人跟夜神之国一样，无处不在的。我跑到哪都会被她抓回来…"
                                },
                                {
                                    "id": "751791108",
                                    "speaker": "戈奇胡",
                                    "text": "我还是得跑回去道歉才行。可，怎么办啊…这路都堵上了…唉，我这次肯定是死定了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7517909",
            "objective": "清理拦路的冲撞岩",
            "dialogues": [
                {
                    "id": "751790901",
                    "speaker": "马索瑟",
                    "text": "伊、伊察霍，清、清单上还差好多东西，你、你来帮忙找找！"
                },
                {
                    "id": "751790902",
                    "speaker": "伊察霍",
                    "text": "唉…别费那个劲了，我都看过了。基本都是一些易损的东西，就之前又是火山又是翻车的，你觉得还能有得剩吗？"
                },
                {
                    "id": "751790903",
                    "speaker": "伊察霍",
                    "text": "省点力气，好好歇一会。等大姐她们回来，还有好长的路要走呢！"
                },
                {
                    "id": "751790904",
                    "speaker": "马索瑟",
                    "text": "不、不行！算、算了，你不去我去…"
                }
            ]
        },
        {
            "id": "7517911",
            "objective": "继续沿路前进",
            "dialogues": []
        },
        {
            "id": "7517904",
            "objective": "继续沿路前进$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7517905",
            "objective": "击败出现的怪物",
            "dialogues": [
                {
                    "id": "751790501",
                    "speaker": "Player",
                    "text": "离开。"
                }
            ]
        },
        {
            "id": "7517906",
            "objective": "和伊扎娅交谈",
            "dialogues": [
                {
                    "id": "751790601",
                    "speaker": "伊扎娅",
                    "text": "呼——这点子真扎手。可恶！我竟然差点被几头嵴锋龙打翻在地上，真是火大。"
                },
                {
                    "id": "751790602",
                    "speaker": "派蒙",
                    "text": "你们都搞错啦，这明明是深渊变成的怪物啦！它们可比嵴锋龙凶多了，你把它们当成嵴锋龙，难怪会吃亏呢！"
                },
                {
                    "id": "751790603",
                    "speaker": "伊扎娅",
                    "text": "哈哈，原来是这样？怪不得呢。这次我可得好好谢谢你们，要不是有你们，我这次肯定是栽了。"
                },
                {
                    "id": "751790604",
                    "speaker": "伊扎娅",
                    "text": "说是这么说，但你得在这儿先等一下，我得先把那几个不成器的家伙都捞回来，等确认他们都没事了再跟你道谢。"
                },
                {
                    "id": "751790605",
                    "speaker": "Black Screen",
                    "text": "在你的帮助下，商队的人们都陆陆续续地集中了过来。"
                }
            ]
        },
        {
            "id": "7517907",
            "objective": "和伊扎娅交谈",
            "dialogues": [
                {
                    "id": "751790701",
                    "speaker": "蒂兹洛",
                    "text": "这么说来，全靠这三位的帮助，大姐你才安然无恙？"
                },
                {
                    "id": "751790702",
                    "speaker": "伊扎娅",
                    "text": "哈哈，没错没错！你是没看到这些家伙有多厉害，两三下就把那几个怪物给放倒了！"
                },
                {
                    "id": "751790703",
                    "speaker": "蒂兹洛",
                    "text": "你们救了队长，我无以回报。小小礼物，不成敬意，还请你们收下。"
                },
                {
                    "id": "751790704",
                    "speaker": "伊扎娅",
                    "text": "小气，蒂兹洛你这家伙一直都这么小气？对救命恩人怎么能只给这么一点谢礼呢？"
                }
            ]
        },
        {
            "id": "7517913",
            "objective": "和伊扎娅交谈",
            "dialogues": [
                {
                    "id": "751791301",
                    "speaker": "伊扎娅",
                    "text": "喂！胖子！保证商队的前路安全是你的职责对吧？结果你的事儿都让别人给代劳了，你有什么要说的吗？"
                },
                {
                    "id": "751791302",
                    "speaker": "戈奇胡",
                    "text": "我…"
                },
                {
                    "id": "751791303",
                    "speaker": "伊扎娅",
                    "text": "别婆婆妈妈的，要不是你乱了阵脚，区区几只怪物，怎么可能奈何得了我？这次你的报酬，自己乖乖交一部分当谢礼吧！"
                },
                {
                    "id": "751791304",
                    "speaker": "戈奇胡",
                    "text": "我、我，我听老大的…"
                }
            ]
        },
        {
            "id": "7517910",
            "objective": "和伊扎娅交谈",
            "dialogues": [
                {
                    "id": "751790301",
                    "speaker": "伊扎娅",
                    "text": "当然了，这点东西作为救命的谢礼，肯定还是太小家子气了，对不对？",
                    "choices": [
                        {
                            "id": "751790302",
                            "text": "确实，欠点意思。",
                            "response": [
                                {
                                    "id": "751790304",
                                    "speaker": "伊扎娅",
                                    "text": "哈哈哈，说得对！我就喜欢你这样的人，够直接！"
                                },
                                {
                                    "id": "751790306",
                                    "speaker": "伊扎娅",
                                    "text": "咳，总而言之。这是我个人给你们的谢礼，你就一并收下吧！就当是给小嵴锋龙多买点吃的吧，可千万别跟我客气啊！"
                                },
                                {
                                    "id": "751790307",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751790308",
                                    "speaker": "伊扎娅",
                                    "text": "好啦，我们还要去把这一路上丢的东西都捡回来，就先走一步啦！有缘再见！"
                                }
                            ]
                        },
                        {
                            "id": "751790303",
                            "text": "没有，这就足够了。",
                            "response": [
                                {
                                    "id": "751790305",
                                    "speaker": "伊扎娅",
                                    "text": "啧，你这个人，这也太不直爽了，没劲。给你你就收下，要不然传出去了，别人还要给我扣个小气鬼的帽子。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
