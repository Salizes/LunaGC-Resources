{
    "quest": {
        "id": "75179",
        "title": "紫色嵴锋龙，来袭？",
        "description": "火山的道路中，似乎有一队商队遇到了麻烦…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 71,
        "total_speaker_counts": {
            "#{REALNAME[ID(2)|SHOWHOST(true)]}": 1,
            "Black Screen": 1,
            "Player": 16,
            "伊察霍": 9,
            "伊扎娅": 12,
            "戈奇胡": 8,
