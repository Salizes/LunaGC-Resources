            "宝儿": 20,
            "索拉雅": 31
        }
    },
    "talks": [
        {
            "id": "2200601",
            "objective": "与宝儿交谈",
            "dialogues": [
                {
                    "id": "220060101",
                    "speaker": "宝儿",
                    "text": "到底在哪呢…"
                },
                {
                    "id": "220060102",
                    "speaker": "Player",
                    "text": "你又丢了什么…"
                },
                {
                    "id": "220060103",
                    "speaker": "宝儿",
                    "text": "这次没有「丢」，是刚开始找啦！但是——无论如何都找不到啊！"
                },
                {
                    "id": "220060104",
                    "speaker": "宝儿",
                    "text": "到底在哪里，好不容易锁定了位置…"
                },
                {
                    "id": "220060105",
                    "speaker": "宝儿",
                    "text": "你也来和我一起找找吧，这种贵重的文物，绝不能流落在外！",
                    "choices": [
                        {
                            "id": "220060106",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "220060108",
                                    "speaker": "宝儿",
                                    "text": "那你去那边，我继续搜索这里。"
                                },
                                {
                                    "id": "220060109",
                                    "speaker": "宝儿",
                                    "text": "一定要把它找出来！"
                                }
                            ]
                        },
                        {
                            "id": "220060107",
                            "text": "这次又是什么文物…",
                            "response": [
                                {
                                    "id": "220060110",
                                    "speaker": "宝儿",
                                    "text": "是一件…一件…呃，年代很久远！可以追溯到…一千，啊不，魔神战争时期。"
                                },
                                {
                                    "id": "220060111",
                                    "speaker": "宝儿",
                                    "text": "总之，是件很贵重的文物，绝不能让它流落在外！你也帮我找找吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200602",
            "objective": "寻找宝儿丢失的东西",
            "dialogues": [
                {
                    "id": "220060201",
                    "speaker": "宝儿",
                    "text": "到底在哪呢…"
                },
                {
                    "id": "220060202",
                    "speaker": "Player",
                    "text": "这次又是什么文物…"
                },
                {
                    "id": "220060203",
                    "speaker": "宝儿",
                    "text": "是一件…一件…呃，年代很久远！可以追溯到…一千，啊不，魔神战争时期。"
                },
                {
                    "id": "220060204",
                    "speaker": "宝儿",
                    "text": "总之，是件很贵重的文物，绝不能让它流落在外！你也帮我找找吧！"
                }
            ]
        },
        {
            "id": "2200603",
            "objective": "解救索拉雅",
            "dialogues": [
                {
                    "id": "220060301",
                    "speaker": "索拉雅",
                    "text": "谢谢你，旅行者，呼…刚才吓死我了，盗宝团真是越来越猖狂了。"
                },
                {
                    "id": "220060302",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "220060303",
                    "speaker": "索拉雅",
                    "text": "我叫索拉雅，是一名游学者，正在这里做研究。"
                },
                {
                    "id": "220060304",
                    "speaker": "索拉雅",
                    "text": "几天前，我循着线索找到了一处遗迹，在里面找到了一枚记载着魔神战争时期历史的玉盘。"
                },
                {
                    "id": "220060305",
                    "speaker": "索拉雅",
                    "text": "但是我取出玉盘之后，刚刚走出遗迹，就被盗宝团袭击了，我跑了一段，还是被他们追上了…"
                },
                {
                    "id": "220060306",
                    "speaker": "索拉雅",
                    "text": "要是没有你们，我和玉盘可能都会有危险，再次感谢你。"
                },
                {
                    "id": "220060307",
                    "speaker": "Player",
                    "text": "你也是学者？"
                },
                {
                    "id": "220060308",
                    "speaker": "索拉雅",
                    "text": "…也？还有学者在这里研究吗，那这位的名字是…"
                },
                {
                    "id": "220060309",
                    "speaker": "索拉雅",
                    "text": "宝儿…等一下，在刚才袭击我的盗宝团里，我听见有人说「怎么能让宝儿独吞宝物」。"
                },
                {
                    "id": "220060310",
                    "speaker": "索拉雅",
                    "text": "居然有这么巧的事情…抱歉，能详细和我说说你遇见的那个「宝儿」吗？"
                },
                {
                    "id": "220060311",
                    "speaker": "Player",
                    "text": "事情是这样的…"
                },
                {
                    "id": "220060312",
                    "speaker": "索拉雅",
                    "text": "…那位「宝儿」给你指定的地点，恰好都是我选定过的。这样的「巧合」，实在是太巧了。"
                },
                {
                    "id": "220060313",
                    "speaker": "索拉雅",
                    "text": "如果她真是盗宝团的成员，那么按照我的推测，也许我早就被盗宝团跟踪了，他们想跟着我…「捡现成的」。"
                },
                {
                    "id": "220060314",
                    "speaker": "索拉雅",
                    "text": "那个「宝儿」想要独吞财物，于是自己一个人抢先行事，但凭她一个人，实在是搜索不了这么大的范围，所以…"
                },
                {
                    "id": "220060315",
                    "speaker": "索拉雅",
                    "text": "看来…你也许被利用了呢，旅行者。恐怕这次的位置，也是她早就瞄好的，只不过她的同伙和我，都比你早来了一步。"
                },
                {
                    "id": "220060316",
                    "speaker": "索拉雅",
                    "text": "不用紧张，这些暂时只是猜测，但是「宝儿」这个名字…听着就十分可疑，像是个假名，或者代号。"
                },
                {
                    "id": "220060317",
                    "speaker": "索拉雅",
                    "text": "旅行者，你能帮我敷衍一下她吗？无论怎样，也不能把这枚玉盘交给可疑的人。",
                    "choices": [
                        {
                            "id": "220060318",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "220060320",
                                    "speaker": "索拉雅",
                                    "text": "谢谢你，不过你这么空手回去，她说不定会起疑。"
                                },
                                {
                                    "id": "220060321",
                                    "speaker": "索拉雅",
                                    "text": "这样，我这里有一个不那么贵重的小玩意，你带回去给她。"
                                },
                                {
                                    "id": "220060322",
                                    "speaker": "索拉雅",
                                    "text": "虽然只是蝇头小利，但也足够让她消停一会的了。"
                                },
                                {
                                    "id": "220060325",
                                    "speaker": "索拉雅",
                                    "text": "好了，你快点回去吧，虽然你刚才把她的同伙打跑了，但是她既然一个人单独行动，那她的同伙肯定也没法把你的事马上告诉她。"
                                },
                                {
                                    "id": "220060326",
                                    "speaker": "索拉雅",
                                    "text": "对了，如果下次她再支使你去找什么，而且你真有发现的话，可以带来给我。我平时一般会待在望舒客栈里。"
                                },
                                {
                                    "id": "220060327",
                                    "speaker": "索拉雅",
                                    "text": "呼，虽然我能做的事也很有限…但是能保护一件文物是一件吧。"
                                }
                            ]
                        },
                        {
                            "id": "220060319",
                            "text": "空手回去会让她怀疑…",
                            "response": [
                                {
                                    "id": "220060323",
                                    "speaker": "索拉雅",
                                    "text": "嗯…有道理，那这样，我这里有一个不那么贵重的小玩意，你带回去给她。"
                                },
                                {
                                    "id": "220060324",
                                    "speaker": "索拉雅",
                                    "text": "虽然只是点蝇头小利，但也足够让她消停一会的了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200604",
            "objective": "询问索拉雅",
            "dialogues": []
        },
        {
            "id": "2200605",
            "objective": "与宝儿交谈",
            "dialogues": [
                {
                    "id": "220060501",
                    "speaker": "宝儿",
                    "text": "05宝儿对话测试（给宝儿）"
                }
            ]
        },
        {
            "id": "2200606",
            "objective": "与宝儿交谈",
            "dialogues": [
                {
                    "id": "220060601",
                    "speaker": "宝儿",
                    "text": "怎么去了这么久，你有什么发现？",
                    "choices": [
                        {
                            "id": "220060602",
                            "text": "找到了这个。",
                            "response": [
                                {
                                    "id": "220060604",
                                    "speaker": "宝儿",
                                    "text": "哈…虽然看着品相不错，但和我要找的那个东西，差别还是有点大啊…"
                                },
                                {
                                    "id": "220060605",
                                    "speaker": "宝儿",
                                    "text": "不过，这个也是文物，就交给我保管吧。放心，我一定会让它充分发挥价值的。"
                                },
                                {
                                    "id": "220060609",
                                    "speaker": "宝儿",
                                    "text": "辛苦你了，这些东西是给你的，收下吧。"
                                },
                                {
                                    "id": "220060610",
                                    "speaker": "宝儿",
                                    "text": "唉，可是那个文物还流落在外，真让人担心…"
                                }
                            ]
                        },
                        {
                            "id": "220060603",
                            "text": "这个是你要找的东西吗？",
                            "response": [
                                {
                                    "id": "220060606",
                                    "speaker": "宝儿",
                                    "text": "虽然品相不错，但这个不是我要找的东西。"
                                },
                                {
                                    "id": "220060607",
                                    "speaker": "宝儿",
                                    "text": "哦对了，你不知道怎么保存文物，说不定会损坏它。"
                                },
                                {
                                    "id": "220060608",
                                    "speaker": "宝儿",
                                    "text": "这个东西就由我来保管吧，我会让它充分发挥价值的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220060401",
                    "speaker": "索拉雅",
                    "text": "05索拉雅闲置对话测试（给宝儿）"
                }
            ]
        },
        {
            "id": "2200607",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220060701",
                    "speaker": "索拉雅",
                    "text": "还好玉盘没有损坏。",
                    "choices": [
                        {
                            "id": "220060702",
                            "text": "被袭击时，为什么不把这个给他们？",
                            "response": [
                                {
                                    "id": "220060703",
                                    "speaker": "索拉雅",
                                    "text": "一件文物，可以让学者研究，可以供艺术家取材，可以展览给人们观看…"
                                },
                                {
                                    "id": "220060704",
                                    "speaker": "索拉雅",
                                    "text": "但是，绝对不能让小偷们拿去换钱，因为这样不仅是在侮辱文物，更是在践踏历史。"
                                },
                                {
                                    "id": "220060705",
                                    "speaker": "索拉雅",
                                    "text": "侮辱文物和践踏历史的人，我绝不会退让一步。"
                                }
                            ]
                        },
                        {
                            "id": "220060706",
                            "text": "这枚玉盘…",
                            "response": [
                                {
                                    "id": "220060707",
                                    "speaker": "索拉雅",
                                    "text": "嗯？你对这枚玉盘感兴趣吗？你感兴趣的是它的价值，还是它的价钱？"
                                },
                                {
                                    "id": "220060708",
                                    "speaker": "索拉雅",
                                    "text": "开个玩笑，这枚玉盘上记载着一小段魔神战争时期的历史，唔，好像是一场两个部族之间的战争…"
                                },
                                {
                                    "id": "220060709",
                                    "speaker": "索拉雅",
                                    "text": "如果能解读出来，也许能填补一些教令院典籍里的空白之处。"
                                },
                                {
                                    "id": "220060710",
                                    "speaker": "索拉雅",
                                    "text": "不过话说回来，也许那些「空白之处」早就被填补了，只不过我不能看罢了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}