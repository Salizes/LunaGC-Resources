{
    "quest": {
        "id": "22006",
        "title": "「遗落」的文物",
        "description": "宝儿自称弄丢了一件贵重的文物，正在焦急地搜索。看起来，她似乎很需要有人来帮忙…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 64,
        "total_speaker_counts": {
