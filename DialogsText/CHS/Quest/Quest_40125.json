    "talks": [
        {
            "id": "4012511",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401251101",
                    "speaker": "凯亚",
                    "text": "珊瑚宫小姐不打算把那个贝壳带回去吗？"
                },
                {
                    "id": "401251102",
                    "speaker": "珊瑚宫心海",
                    "text": "我反倒觉得，保存在伊迪娅小姐这里会更合适一些。"
                },
                {
                    "id": "401251103",
                    "speaker": "珊瑚宫心海",
                    "text": "如今的海祇岛已经有了新的「宝物」，人们的愿望也正慢慢被实现。"
                },
                {
                    "id": "401251104",
                    "speaker": "珊瑚宫心海",
                    "text": "不如就让它守护着这瓶中的蜃境，陪伴着路过旅人们的梦想吧。"
                }
            ]
        },
        {
            "id": "4012512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401251201",
                    "speaker": "柯莱",
                    "text": "如果从阿如村走的话…就能够途经喀万驿，禅那园…绕道去须弥城…"
                },
                {
                    "id": "401251202",
                    "speaker": "优菈",
                    "text": "原来如此…"
                },
                {
                    "id": "401251203",
                    "speaker": "莱斯格",
                    "text": "要顺路买什么东西吗？你们只管选礼物，我来负责提！"
                },
                {
                    "id": "401251204",
                    "speaker": "莱斯格",
                    "text": "只要手里拿得下，多重都没问题！"
                },
                {
                    "id": "401251205",
                    "speaker": "优菈",
                    "text": "哪有那么多人要送…"
                },
                {
                    "id": "401251206",
                    "speaker": "可莉",
                    "text": "妈妈，阿贝多哥哥，琴团长，雷泽…还有迪奥娜姐姐，莫娜姐姐，菲谢尔姐姐…"
                },
                {
                    "id": "401251207",
                    "speaker": "优菈",
                    "text": "看我干嘛？"
                },
                {
                    "id": "401251208",
                    "speaker": "柯莱",
                    "text": "没什么，没什么。"
                },
                {
                    "id": "401251209",
                    "speaker": "柯莱",
                    "text": "可莉想给大家选什么样的礼物呢？"
                },
                {
                    "id": "401251210",
                    "speaker": "可莉",
                    "text": "要…要日落果味道的糖！还有蕈兽那样的大帽子，还有还有…"
                },
                {
                    "id": "401251211",
                    "speaker": "可莉",
                    "text": "可莉要买很多很多故事书送给大家！"
                },
                {
                    "id": "401251212",
                    "speaker": "可莉",
                    "text": "但送给妈妈的礼物，可莉还没想好…"
                },
                {
                    "id": "401251213",
                    "speaker": "优菈",
                    "text": "没关系，边走边看，姐姐们也会帮忙的。"
                },
                {
                    "id": "401251214",
                    "speaker": "可莉",
                    "text": "嗯！谢谢姐姐！"
                }
            ]
        }
    ]
}