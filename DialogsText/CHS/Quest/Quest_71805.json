    "talks": [
        {
            "id": "7180501",
            "objective": "与纪芳对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7180502",
            "objective": "帮纪芳送书",
            "dialogues": [
                {
                    "id": "718050401",
                    "speaker": "德安公",
                    "text": "年轻人，你有什么事吗？"
                },
                {
                    "id": "718050402",
                    "speaker": "Player",
                    "text": "这是纪芳给你的书。"
                },
                {
                    "id": "718050403",
                    "speaker": "德安公",
                    "text": "这是《帝君尘游记·四》？我记得我早就订了这本书，怎么拖了这么久？"
                },
                {
                    "id": "718050404",
                    "speaker": "德安公",
                    "text": "让我看看…咦？居然是初版，难怪现在才送来…"
                },
                {
                    "id": "718050405",
                    "speaker": "德安公",
                    "text": "我还以为是因为客人太多，纪芳把这本书的事给忘了呢。"
                },
                {
                    "id": "718050406",
                    "speaker": "德安公",
                    "text": "这本书我就收下了，谢谢你，年轻人。"
                }
            ]
        },
        {
            "id": "7180503",
            "objective": "帮纪芳送书",
            "dialogues": [
                {
                    "id": "718050501",
                    "speaker": "天叔",
                    "text": "年轻人，你有什么事吗？"
                },
                {
                    "id": "718050502",
                    "speaker": "Player",
                    "text": "这是纪芳给你的书。"
                },
                {
                    "id": "718050503",
                    "speaker": "天叔",
                    "text": "我想起来了，之前我跟「万文集舍」订了一本《玑衡经》。"
                },
                {
                    "id": "718050504",
                    "speaker": "天叔",
                    "text": "没错没错，这就是我要的书，总算送来了。呵呵，我还以为客人太多，纪芳把这本书的事给忘了呢。"
                },
                {
                    "id": "718050505",
                    "speaker": "天叔",
                    "text": "送来就好，送来就好…哦唷，这装帧还不错，纪芳有心了。"
                },
                {
                    "id": "718050506",
                    "speaker": "天叔",
                    "text": "谢谢你年轻人，这本书我就收下了。"
                }
            ]
        },
        {
            "id": "7180504",
            "objective": "增加任务进度$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7180505",
            "objective": "回滚保护$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7180506",
            "objective": "向纪芳回报",
            "dialogues": [
                {
                    "id": "718050601",
                    "speaker": "Player",
                    "text": "关于那两本书…"
                },
                {
                    "id": "718050602",
                    "speaker": "纪芳",
                    "text": "书都送到了吗？"
                },
                {
                    "id": "718050603",
                    "speaker": "Player",
                    "text": "都送到了。"
                },
                {
                    "id": "718050604",
                    "speaker": "纪芳",
                    "text": "谢谢你。「万文集舍」能开到现在，都是多亏了这些老客人的支持。"
                },
                {
                    "id": "718050605",
                    "speaker": "纪芳",
                    "text": "而且，这些老客人也都是真正爱书的人。能拿到好书，他们应该也会很开心的。"
                },
                {
                    "id": "718050606",
                    "speaker": "纪芳",
                    "text": "旅行者，谢谢你帮我这个忙，这些报酬请你收下吧。"
                },
                {
                    "id": "718050607",
                    "speaker": "纪芳",
                    "text": "如果你以后想买书的话，尽管来找我。"
                }
            ]
        },
        {
            "id": "7180507",
            "objective": "",
            "dialogues": [
                {
                    "id": "718050701",
                    "speaker": "纪芳",
                    "text": "关于那两本书…"
                },
                {
                    "id": "718050702",
                    "speaker": "纪芳",
                    "text": "这两位是老客人了，他们订的书我一般都会早点准备。"
                },
                {
                    "id": "718050703",
                    "speaker": "纪芳",
                    "text": "但突然来了那么多客人，我一下子应付不过来，把这两本书拖了这么久。"
                },
                {
                    "id": "718050704",
                    "speaker": "纪芳",
                    "text": "他们一定都等得不耐烦了…"
                }
            ]
        },
        {
            "id": "7180508",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718050801",
                    "speaker": "德安公",
                    "text": "帝君…唉…"
                }
            ]
        },
        {
