    "talks": [
        {
            "id": "7470901",
            "objective": "与希格雯对话",
            "dialogues": [
                {
                    "id": "747090101",
                    "speaker": "希格雯",
                    "text": "#辛苦你们啦，{NICKNAME}和派蒙。"
                },
                {
                    "id": "747090102",
                    "speaker": "希格雯",
                    "text": "我已经基本了解了病患鱼儿们的病情，还调制了一些美露莘的秘方草药…"
                },
                {
                    "id": "747090103",
                    "speaker": "希格雯",
                    "text": "将这种特别的草药调和在水箱里，就能帮它们冷静下来~"
                },
                {
                    "id": "747090104",
                    "speaker": "派蒙",
                    "text": "等于是把水箱整个改成了治疗场所？"
                },
                {
                    "id": "747090105",
                    "speaker": "派蒙",
                    "text": "仔细想想…可真是只有希格雯才能办到的事！",
                    "choices": [
                        {
                            "id": "747090106",
                            "text": "不过，这只能暂时缓解病情？",
                            "response": [
                                {
                                    "id": "747090108",
                                    "speaker": "希格雯",
                                    "text": "没错，这需要请不同特性的鱼儿们来我这里做「体检」，才能准确归纳病因…"
                                },
                                {
                                    "id": "747090109",
                                    "speaker": "希格雯",
                                    "text": "接下来，我会根据鱼儿们的特性，更有针对性地列出一些病患。"
                                },
                                {
                                    "id": "747090110",
                                    "speaker": "希格雯",
                                    "text": "就麻烦你们多多留意这样的鱼儿了。"
                                }
                            ]
                        },
                        {
                            "id": "747090107",
                            "text": "要解决问题，还得找到原因…"
                        }
                    ]
                }
            ]
        }
    ]
