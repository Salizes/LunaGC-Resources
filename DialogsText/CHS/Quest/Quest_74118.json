    "talks": [
        {
            "id": "7411801",
            "objective": "与加尔恰对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741180101",
                    "speaker": "路通",
                    "text": "…先生，也许我们应该先去佩特莉可镇。"
                },
                {
                    "id": "741180102",
                    "speaker": "路通",
                    "text": "虽然泽维尔先生和菲利斯先生都不在，但梅康顿和巴比斯先生应该还在镇里。"
                },
                {
                    "id": "741180103",
                    "speaker": "路通",
                    "text": "也许他们能给您一些建议或启发，就算是最坏的情况下，您也有了两位可以倒苦水的对象。"
                },
                {
                    "id": "741180104",
                    "speaker": "加尔恰",
                    "text": "不，亲爱的路通，不…梅康顿和巴比斯的研究现在正如火如荼啊。"
                },
                {
                    "id": "741180105",
                    "speaker": "加尔恰",
                    "text": "他们上次写信告诉我，佩特莉可镇里来了一位从枫丹科学院来的聪明人。"
                },
                {
                    "id": "741180106",
                    "speaker": "加尔恰",
                    "text": "这位叫博絮埃的先生颇有学识和见解，帮他们解决了很多问题…"
                },
                {
                    "id": "741180107",
                    "speaker": "加尔恰",
                    "text": "而我…唉…",
                    "choices": [
                        {
                            "id": "741180108",
                            "text": "加尔恰？",
                            "response": [
                                {
                                    "id": "741180110",
                                    "speaker": "路通",
                                    "text": "#{NICKNAME}，真是幸会。没想到能在枫丹遇见你。"
                                },
                                {
                                    "id": "741180111",
                                    "speaker": "路通",
                                    "text": "虽然…您来的时机实在太凑巧…"
                                },
                                {
                                    "id": "741180112",
                                    "speaker": "加尔恰",
                                    "text": "#没错，非常凑巧…但还是很高兴能遇见你，{NICKNAME}。"
                                },
                                {
                                    "id": "741180113",
                                    "speaker": "派蒙",
                                    "text": "呜哇，他看上去好像很疲惫，黑眼圈也好重…整个人都无精打采的。"
                                },
                                {
                                    "id": "741180114",
                                    "speaker": "Player",
                                    "text": "加尔恰怎么了？"
                                },
                                {
                                    "id": "741180115",
                                    "speaker": "路通",
                                    "text": "我们…呃，先生的研究遇见了一些，前所未有的问题。"
                                },
                                {
                                    "id": "741180116",
                                    "speaker": "路通",
                                    "text": "但此事说来话长…我们现在正打算去欧庇克莱歌剧院为他们清算账目呢。"
                                },
                                {
                                    "id": "741180117",
                                    "speaker": "路通",
                                    "text": "在结束工作之后，我们可以找个安静的地方好好聊一聊。"
                                },
                                {
                                    "id": "741180118",
                                    "speaker": "Player",
                                    "text": "你们有其他工作了？"
                                },
                                {
                                    "id": "741180119",
                                    "speaker": "路通",
                                    "text": "谈不上工作。只是到处被人雇去帮忙运算罢了。"
                                },
                                {
                                    "id": "741180120",
                                    "speaker": "路通",
                                    "text": "最近欧庇克莱歌剧院里接待了不少剧团，急需进行一次整体的账目清算。"
                                },
                                {
                                    "id": "741180121",
                                    "speaker": "路通",
                                    "text": "所以，为了筹集回佩特莉可镇的费用，我们…我，代加尔恰先生接下了这份委托。"
                                },
                                {
                                    "id": "741180122",
                                    "speaker": "加尔恰",
                                    "text": "真是大材小用！那些运算简单至极，我就算不用推数机，一个下午也全都能算清。"
                                },
                                {
                                    "id": "741180123",
                                    "speaker": "路通",
                                    "text": "所以这也正是我们筹集经费的好方法，咱们快点出发吧，先生。"
                                },
                                {
                                    "id": "741180124",
                                    "speaker": "路通",
                                    "text": "#对了，{NICKNAME}，我能请您和我们同行吗？"
                                },
                                {
                                    "id": "741180125",
                                    "speaker": "路通",
                                    "text": "有您这位名声不凡的朋友同行，我们也许就不用遭遇一些不必要的麻烦。"
                                },
                                {
                                    "id": "741180126",
                                    "speaker": "路通",
                                    "text": "相应的报酬我们也会付给您的，请放心。",
                                    "choices": [
                                        {
                                            "id": "741180127",
                                            "text": "好吧。",
                                            "response": [
                                                {
                                                    "id": "741180129",
                                                    "speaker": "路通",
                                                    "text": "这我可不好说…呵呵，总之，咱们快点出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741180128",
                                            "text": "城里应该不会出什么事。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741180109",
                            "text": "你回枫丹了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411802",
            "objective": "前往欧庇克莱歌剧院",
            "dialogues": [
                {
                    "id": "741180201",
                    "speaker": "路通",
                    "text": "不得不说。这剧院的确气派，赚的钱也一定不少。"
                },
                {
                    "id": "741180202",
                    "speaker": "加尔恰",
                    "text": "剧院…唉，咱们还是快点去工作吧，等了结了这份工作，我们就回佩特莉可镇。"
                },
                {
                    "id": "741180203",
                    "speaker": "加尔恰",
                    "text": "然后，我就会在镇子里开一家面包房，从此不再搭理什么推数机了。"
                },
                {
                    "id": "741180204",
                    "speaker": "路通",
                    "text": "呃…先生…"
                },
                {
                    "id": "741180205",
                    "speaker": "加尔恰",
                    "text": "路通，你怎么了？你这副表情…难不成见鬼了吗？"
                },
                {
                    "id": "741180206",
                    "speaker": "加尔恰",
                    "text": "真是…见鬼…"
                },
                {
                    "id": "741180207",
                    "speaker": "迦雅",
                    "text": "加尔恰…？"
                },
                {
                    "id": "741180208",
                    "speaker": "派蒙",
                    "text": "迦雅小姐？！她为什么会在这里？"
                },
                {
                    "id": "741180209",
                    "speaker": "Player",
                    "text": "这可真是太巧了…"
                },
                {
                    "id": "741180210",
                    "speaker": "路通",
                    "text": "先生，您刚才的发言可真是不太得体。"
                },
                {
                    "id": "741180211",
                    "speaker": "加尔恰",
                    "text": "哦，闭嘴，路通。"
                },
                {
                    "id": "741180212",
                    "speaker": "迦雅",
                    "text": "#加尔恰，真高兴能在这遇见你，还有{NICKNAME}。我猜，你是来帮歌剧院清算账目的？"
                },
                {
                    "id": "741180213",
                    "speaker": "Player",
                    "text": "难道他要清算的账目就是…"
                },
                {
                    "id": "741180214",
                    "speaker": "迦雅",
                    "text": "那可不是。我们剧团可没有在这个歌剧院里演出。"
                },
                {
                    "id": "741180215",
                    "speaker": "迦雅",
                    "text": "只不过，以我对加尔恰的了解，他从来不是那种会在闲暇时间看歌剧的人。"
                },
                {
                    "id": "741180216",
                    "speaker": "迦雅",
                    "text": "之所以会来歌剧院…也只可能是被人雇来工作，对吧？"
                },
                {
                    "id": "741180217",
                    "speaker": "路通",
                    "text": "我发自内心地觉得，您更适合代替我待在先生身边，迦雅小姐。"
                },
                {
                    "id": "741180218",
                    "speaker": "迦雅",
                    "text": "我们每个人都是无可取代的，亲爱的路通。"
                },
                {
                    "id": "741180219",
                    "speaker": "加尔恰",
                    "text": "我…呃…迦雅，很高兴见到你，我…"
                },
                {
                    "id": "741180220",
                    "speaker": "迦雅",
                    "text": "…但你看起来可不太高兴，你的研究似乎不太顺利？"
                },
                {
                    "id": "741180221",
                    "speaker": "Player",
                    "text": "这你也猜出来了？"
                },
                {
                    "id": "741180222",
                    "speaker": "迦雅",
                    "text": "唔，至少他不会因为看见我而感到不高兴，也不会因为你或者路通而感到不愉快…"
                },
                {
                    "id": "741180223",
                    "speaker": "迦雅",
                    "text": "在加尔恰的生活里，能让他这么不开心的，也只有那台「推数机」了。"
                },
                {
                    "id": "741180224",
                    "speaker": "派蒙",
                    "text": "迦雅小姐为什么这么了解加尔恰呀？明明分开了那么久…",
                    "choices": [
                        {
                            "id": "741180225",
                            "text": "也许是她的直觉吧。",
                            "response": [
                                {
                                    "id": "741180227",
                                    "speaker": "路通",
                                    "text": "您也许应该去咖啡馆，坐下来慢慢谈，这可不是三言两语就能说清的事。"
                                },
                                {
                                    "id": "741180228",
                                    "speaker": "加尔恰",
                                    "text": "我还要…呃，不，我很高兴…但我们…"
                                },
                                {
                                    "id": "741180229",
                                    "speaker": "路通",
                                    "text": "放心吧，先生。那些运算简单至极，我一个人就能搞定所有工作。"
                                },
                                {
                                    "id": "741180230",
                                    "speaker": "路通",
                                    "text": "…您总不能把迦雅小姐晾在一边，直到我们的工作结束吧？"
                                },
                                {
                                    "id": "741180231",
                                    "speaker": "迦雅",
                                    "text": "你真贴心，路通。我们会带一杯咖啡回来给你的。"
                                },
                                {
                                    "id": "741180232",
                                    "speaker": "路通",
                                    "text": "谢谢您，小姐。祝您和先生喝得愉快。"
                                },
                                {
                                    "id": "741180233",
                                    "speaker": "Black Screen",
                                    "text": "加尔恰和迦雅一起离开了…"
                                },
                                {
                                    "id": "741180234",
                                    "speaker": "派蒙",
                                    "text": "他们就这么去喝咖啡了…好像从头到尾都没我们什么事呢。",
                                    "choices": [
                                        {
                                            "id": "741180235",
                                            "text": "完全无关。",
                                            "response": [
                                                {
                                                    "id": "741180237",
                                                    "speaker": "路通",
                                                    "text": "#不，{NICKNAME}。接下来才是正式的委托内容。",
                                                    "choices": [
                                                        {
                                                            "id": "741180238",
                                                            "text": "要找什么食材？",
                                                            "response": [
                                                                {
                                                                    "id": "741180241",
                                                                    "speaker": "路通",
                                                                    "text": "您真幽默。但我绝没有任何浪费您时间的意思。"
                                                                },
                                                                {
                                                                    "id": "741180242",
                                                                    "speaker": "路通",
                                                                    "text": "加尔恰先生和我，现在的确处于危险之中。"
                                                                },
                                                                {
                                                                    "id": "741180243",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸…欸？"
                                                                },
                                                                {
                                                                    "id": "741180244",
                                                                    "speaker": "路通",
                                                                    "text": "我们去旁边说吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741180239",
                                                            "text": "要找什么零件？"
                                                        },
                                                        {
                                                            "id": "741180240",
                                                            "text": "不然我去给他们留个影？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741180236",
                                            "text": "我在这里干什么…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741180226",
                            "text": "也许是加尔恰比较好懂吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411803",
            "objective": "与路通一同前往僻静处",
            "dialogues": [
                {
                    "id": "741180301",
                    "speaker": "路通",
                    "text": "…这里应该没问题了。"
                },
                {
                    "id": "741180302",
                    "speaker": "路通",
                    "text": "让我从头说起吧。自从您在须弥帮我们改造了推数机后，这台机器的性能产生了一个飞跃。"
                },
                {
                    "id": "741180303",
                    "speaker": "路通",
                    "text": "先生十分振奋，想要继续改进。但就像他说的，传统的机关传动结构有所局限…"
                },
                {
                    "id": "741180304",
                    "speaker": "路通",
                    "text": "这台推数机的性能已经无法突破，所以，我们就想要回到枫丹，寻求其他的研究思路。"
                },
                {
                    "id": "741180305",
                    "speaker": "路通",
                    "text": "但是，当我们回到枫丹。有一个奇怪的人突然找到了加尔恰先生。"
                },
                {
                    "id": "741180306",
                    "speaker": "路通",
                    "text": "这个人表示，自己可以为加尔恰先生提供研究的资金，甚至是帮他寻找其他合作者。"
                },
                {
                    "id": "741180307",
                    "speaker": "路通",
                    "text": "但与之相对的，加尔恰先生必须将推数机的所有设计思路和数据，都与他共享。",
                    "choices": [
                        {
                            "id": "741180308",
                            "text": "加尔恰一定不会接受。",
                            "response": [
                                {
                                    "id": "741180310",
                                    "speaker": "派蒙",
                                    "text": "对啊！开口就想要人家的研究成果，这是在抢劫吗？"
                                },
                                {
                                    "id": "741180311",
                                    "speaker": "路通",
                                    "text": "没错。所以加尔恰先生果断地拒绝了这个人。"
                                },
                                {
                                    "id": "741180312",
                                    "speaker": "路通",
                                    "text": "但在那之后，似乎有人一直在尾随着我和加尔恰先生。"
                                },
                                {
                                    "id": "741180313",
                                    "speaker": "路通",
                                    "text": "而且，也有人趁我们离开时进入了我们的房间，并且翻找过什么东西。"
                                },
                                {
                                    "id": "741180314",
                                    "speaker": "路通",
                                    "text": "虽然那个人将所有东西都复原了，但还是被加尔恰先生发现了痕迹。"
                                },
                                {
                                    "id": "741180315",
                                    "speaker": "派蒙",
                                    "text": "好、好可怕…人家不愿意把东西给他，他就直接过来抢吗！？"
                                },
                                {
                                    "id": "741180316",
                                    "speaker": "路通",
                                    "text": "事实上，在发现房间被翻过之后，我们就决定尽快筹钱离开这里，回到佩特莉可镇。"
                                },
                                {
                                    "id": "741180317",
                                    "speaker": "路通",
                                    "text": "等到了那里之后，我们会联系空想俱乐部的其他几位先生，一同解决这个问题。"
                                },
                                {
                                    "id": "741180318",
                                    "speaker": "路通",
                                    "text": "而且佩特莉可镇算是…呵呵，算是加尔恰先生的大本营。"
                                },
                                {
                                    "id": "741180319",
                                    "speaker": "路通",
                                    "text": "对他来说，没有任何地方比佩特莉可镇更安全了。"
                                },
                                {
                                    "id": "741180320",
                                    "speaker": "路通",
                                    "text": "本来今天就是出发日，我们正准备出发去佩特莉可镇，所以才想请您为我们做护卫。"
                                },
                                {
                                    "id": "741180321",
                                    "speaker": "路通",
                                    "text": "没想到，居然在这里遇见了迦雅小姐…为了安全起见，我只能让加尔恰先生带着迦雅小姐先回城里。",
                                    "choices": [
                                        {
                                            "id": "741180322",
                                            "text": "我能做什么？",
                                            "response": [
                                                {
                                                    "id": "741180324",
                                                    "speaker": "路通",
                                                    "text": "看来，我们的出发日期必须要延迟了。现在请您快赶去加尔恰先生身边。就像我之前说的一样…"
                                                },
                                                {
                                                    "id": "741180325",
                                                    "speaker": "路通",
                                                    "text": "有您这位名声不凡的朋友同行，我们也许就不用遭遇一些不必要的麻烦。",
                                                    "choices": [
                                                        {
                                                            "id": "741180326",
                                                            "text": "我会马上赶过去。",
                                                            "response": [
                                                                {
                                                                    "id": "741180330",
                                                                    "speaker": "路通",
                                                                    "text": "加尔恰先生会把事情全部告诉迦雅小姐的。至于后面的事…就让迦雅小姐自己决定吧。"
                                                                },
                                                                {
                                                                    "id": "741180331",
                                                                    "speaker": "路通",
                                                                    "text": "总之，我们快点赶回城里去吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741180327",
                                                            "text": "他们不会真遇见什么危险吧…",
                                                            "response": [
                                                                {
                                                                    "id": "741180328",
                                                                    "speaker": "路通",
                                                                    "text": "不会的。加尔恰先生目前还在枫丹廷的城内，那里有不少警卫机关巡逻。"
                                                                },
                                                                {
                                                                    "id": "741180329",
                                                                    "speaker": "路通",
                                                                    "text": "如果他们想要使用暴力手段，那么执律庭会代替我们解决大部分问题。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741180323",
                                            "text": "我能帮上什么忙？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741180309",
                            "text": "听起来这个人就不像好人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411804",
            "objective": "与路通一起前往咖啡馆",
            "dialogues": [
                {
                    "id": "741180401",
                    "speaker": "路通",
                    "text": "…果然，那群人还一直盯着加尔恰先生不放。"
                },
                {
                    "id": "741180402",
                    "speaker": "路通",
                    "text": "看靠近柜台的桌旁，面前放着一个帽子的那个男人。"
                },
                {
                    "id": "741180403",
                    "speaker": "路通",
                    "text": "我很确定，他在前几天刚刚尾随过我们。",
                    "choices": [
                        {
                            "id": "741180404",
                            "text": "我去叫警官。",
                            "response": [
                                {
                                    "id": "741180406",
                                    "speaker": "路通",
                                    "text": "报警是个不错的选择…旁边刚巧有一位警官。"
                                },
                                {
                                    "id": "741180407",
                                    "speaker": "路通",
                                    "text": "我们之前就向这位梅莘警官报过案，她也清楚我们如今的处境。"
                                },
                                {
                                    "id": "741180408",
                                    "speaker": "路通",
                                    "text": "我相信，她会愿意帮助我们的。有一位警官在旁边，那群人应该也不敢做出什么过激的举动。"
                                },
                                {
                                    "id": "741180409",
                                    "speaker": "路通",
                                    "text": "#{NICKNAME}，请您去向梅莘警官说明情况，我去找加尔恰先生。"
                                },
                                {
                                    "id": "741180410",
                                    "speaker": "路通",
                                    "text": "好了，快点出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "741180405",
                            "text": "直接报警吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411805",
            "objective": "寻找梅莘",
            "dialogues": [
                {
                    "id": "741180501",
                    "speaker": "梅莘",
                    "text": "您好。请问有什么事吗？"
                },
                {
                    "id": "741180502",
                    "speaker": "Player",
                    "text": "事情是这样的…"
                },
                {
                    "id": "741180503",
                    "speaker": "Black Screen",
                    "text": "向梅莘警官叙述了事情的经过…"
                },
                {
                    "id": "741180504",
                    "speaker": "梅莘",
                    "text": "原来是那位加尔恰先生的事啊，我明白了，我们一起去他那边吧。"
                },
                {
                    "id": "741180505",
                    "speaker": "梅莘",
                    "text": "至少，先得把那个可疑的人给赶走。"
                }
            ]
        },
        {
            "id": "7411806",
            "objective": "与加尔恰一行人会合",
            "dialogues": [
                {
                    "id": "741180601",
                    "speaker": "加尔恰",
                    "text": "…谢谢您，梅莘警官。您一过来，那个家伙就起身离开了。"
                },
                {
                    "id": "741180602",
                    "speaker": "梅莘",
                    "text": "没事，只是我份内的事。"
                },
                {
                    "id": "741180603",
                    "speaker": "路通",
                    "text": "先生，看来我们还是得迅速离开这里，回到佩特莉可镇。"
                },
                {
                    "id": "741180604",
                    "speaker": "路通",
                    "text": "我认为那群家伙已经逐渐失去耐心了，说不定…会做出什么过激的举动。"
                },
                {
                    "id": "741180605",
                    "speaker": "梅莘",
                    "text": "我过会就将此事上报，过几天就会有结果。"
                },
                {
                    "id": "741180606",
                    "speaker": "梅莘",
                    "text": "最好的情况，我们可以派遣几名同事护送你们。"
                },
                {
                    "id": "741180607",
                    "speaker": "梅莘",
                    "text": "但我们的人手有限，还要顾及城里的事务，只能护送你们一段路，不能直接送到佩特莉可镇…"
                },
                {
                    "id": "741180608",
                    "speaker": "梅莘",
                    "text": "而且在那之前，你们最好要搬到一个安全的地方住着，关于此事的讨论可能会持续…一段时间。",
                    "choices": [
                        {
                            "id": "741180609",
                            "text": "护送就交给我了。",
                            "response": [
                                {
                                    "id": "741180611",
                                    "speaker": "路通",
                                    "text": "感谢您。有您同行，那群人一定更加不敢乱来了。"
                                },
                                {
                                    "id": "741180612",
                                    "speaker": "派蒙",
                                    "text": "但迦雅小姐不是在剧团工作吗？你们去佩特莉可镇，那她…"
                                },
                                {
                                    "id": "741180613",
                                    "speaker": "迦雅",
                                    "text": "唔，我会和他们一起去的。"
                                },
                                {
                                    "id": "741180614",
                                    "speaker": "加尔恰",
                                    "text": "什么？！"
                                },
                                {
                                    "id": "741180615",
                                    "speaker": "路通",
                                    "text": "小姐，我发自内心地请求您。请务必…"
                                },
                                {
                                    "id": "741180616",
                                    "speaker": "迦雅",
                                    "text": "亲爱的路通，别试图说服我。我和你的老板一样，无法被他人说服。"
                                },
                                {
                                    "id": "741180617",
                                    "speaker": "加尔恰",
                                    "text": "但、但我们都不知道会遇见什么危险…"
                                },
                                {
                                    "id": "741180618",
                                    "speaker": "迦雅",
                                    "text": "那我更应该和你们一起走了。难道你想让我和上次一样，拿着一篇没头没尾的乐谱离开吗？"
                                },
                                {
                                    "id": "741180619",
                                    "speaker": "迦雅",
                                    "text": "况且，我们剧团的团长对这种「算」出来的乐谱也很感兴趣。"
                                },
                                {
                                    "id": "741180620",
                                    "speaker": "迦雅",
                                    "text": "我相信，他应该也很支持我和你们同行…好，我说完了，接下来我们去哪？"
                                },
                                {
                                    "id": "741180621",
                                    "speaker": "派蒙",
                                    "text": "和、和在须弥一样，迦雅小姐在气势上完全把加尔恰先生给制服了呢…"
                                },
                                {
                                    "id": "741180622",
                                    "speaker": "Player",
                                    "text": "加尔恰是永远赢不了了…"
                                },
                                {
                                    "id": "741180623",
                                    "speaker": "路通",
                                    "text": "也有可能，是加尔恰先生压根就没想赢…"
                                },
                                {
                                    "id": "741180624",
                                    "speaker": "加尔恰",
                                    "text": "咳！路通，我们得赶紧去找个合适的地方住下了！最好是人多点的地方。"
                                },
                                {
                                    "id": "741180625",
                                    "speaker": "路通",
                                    "text": "人多的地方…我们也许可以去…"
                                },
                                {
                                    "id": "741180626",
                                    "speaker": "迦雅",
                                    "text": "不如，去我们的剧团所在的旅馆？那里有很多人，而且大家都彼此认识。"
                                },
                                {
                                    "id": "741180627",
                                    "speaker": "迦雅",
                                    "text": "如果有陌生人想要混进来，马上就会被发现。而且，我们团长肯定也很想了解推数机。"
                                },
                                {
                                    "id": "741180628",
                                    "speaker": "加尔恰",
                                    "text": "呃…"
                                },
                                {
                                    "id": "741180629",
                                    "speaker": "路通",
                                    "text": "就这么办！太棒了，一切问题都得到了解决。"
                                },
                                {
                                    "id": "741180630",
                                    "speaker": "加尔恰",
                                    "text": "一切问题？！"
                                },
                                {
                                    "id": "741180631",
                                    "speaker": "路通",
                                    "text": "#那就这么定了。{NICKNAME}，这些钱请您收下，就当做是预付的护送费吧。"
                                },
                                {
                                    "id": "741180632",
                                    "speaker": "路通",
                                    "text": "虽然不知道什么时候才能出发…但到时候，就万事拜托您了。"
                                },
                                {
                                    "id": "741180633",
                                    "speaker": "加尔恰",
                                    "text": "但我怎么觉得，现在的问题越来越多了啊？！"
                                }
                            ]
                        },
                        {
                            "id": "741180610",
                            "text": "我可以护送你们。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411850",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741185001",
                    "speaker": "路通",
                    "text": "#为您效劳，亲爱的{NICKNAME}。",
                    "choices": [
                        {
                            "id": "741185002",
                            "text": "你们后面怎么打算？",
                            "response": [
                                {
                                    "id": "741185003",
                                    "speaker": "路通",
                                    "text": "目前来看，我们还没有弄清楚那群人的身份。"
                                },
                                {
                                    "id": "741185004",
                                    "speaker": "路通",
                                    "text": "虽然我们已经报了案，但现在没有任何线索，警官们也无从查起。"
                                },
                                {
                                    "id": "741185005",
                                    "speaker": "路通",
                                    "text": "而且，枫丹廷这么大，警官们也无法在所有地方都照看到我们。"
                                },
                                {
                                    "id": "741185006",
                                    "speaker": "路通",
                                    "text": "现在…迦雅小姐居然也卷了进来，这下事情变得更复杂了。"
                                },
                                {
                                    "id": "741185007",
                                    "speaker": "路通",
                                    "text": "希望加尔恰先生能说服迦雅小姐迅速离开枫丹吧。这样的话，我们还能依照原计划行事。"
                                }
                            ]
                        },
                        {
                            "id": "741185008",
                            "text": "加尔恰的研究不是没前景了吗？",
                            "response": [
                                {
                                    "id": "741185009",
                                    "speaker": "路通",
                                    "text": "这个「没前景」是指无法再进一步地提升其性能。"
                                },
                                {
                                    "id": "741185010",
                                    "speaker": "路通",
                                    "text": "但在应用领域，这台「推数机」可是大有可为。"
                                },
                                {
                                    "id": "741185011",
                                    "speaker": "路通",
                                    "text": "只不过，加尔恰先生从来都不怎么在意应用领域的事…"
                                },
                                {
                                    "id": "741185012",
                                    "speaker": "路通",
                                    "text": "我想这也是他经常陷入痛苦的原因之一。"
                                },
                                {
                                    "id": "741185013",
                                    "speaker": "路通",
                                    "text": "不过，也正因如此，他将一位失意研究者的形象扮演得非常出色。"
                                }
                            ]
                        },
                        {
                            "id": "741185014",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "741185015",
                                    "speaker": "路通",
                                    "text": "那就拜托您了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7411851",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741185101",
                    "speaker": "迦雅",
                    "text": "…你怎么了？脸色突然这么难看？"
                },
                {
                    "id": "741185102",
                    "speaker": "加尔恰",
                    "text": "我、我只是…没什么，也许是这杯咖啡太浓了…"
                }
            ]
        },
        {
            "id": "7411852",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741185201",
                    "speaker": "可疑的男人",
                    "text": "…怎么？你有什么事吗？"
                }
            ]
        }
    ]
}