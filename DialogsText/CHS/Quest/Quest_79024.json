    "talks": [
        {
            "id": "7902401",
            "objective": "与营地中的愚人众对话",
            "dialogues": [
                {
                    "id": "790240101",
                    "speaker": "阿加菲娅",
                    "text": "雅科夫，雅科夫，刚才的就是你平时最喜欢听的曲子…"
                },
                {
                    "id": "790240102",
                    "speaker": "阿加菲娅",
                    "text": "怎么样，雅科夫醒过来了吗？"
                },
                {
                    "id": "790240103",
                    "speaker": "扎哈尔",
                    "text": "不行，阿加霞，还是什么反应都没有。"
                },
                {
                    "id": "790240104",
                    "speaker": "阿加菲娅",
                    "text": "每次我唱这首歌的时候，尤其是唱到「仲夏已逝，万花凋谢。你必将远行，而我却习惯等待。」这句的时候…"
                },
                {
                    "id": "790240105",
                    "speaker": "阿加菲娅",
                    "text": "每次我唱到这里，他总是会眼睛变得湿润地看着我呀…怎么会一点反应都没有呢？"
                },
                {
                    "id": "790240106",
                    "speaker": "阿加菲娅",
                    "text": "唉…"
                },
                {
                    "id": "790240107",
                    "speaker": "扎哈尔",
                    "text": "我给他做了他最喜欢喝的汤，味道香得我自己口水都要流出来了，可是他还是没醒。"
                },
                {
                    "id": "790240108",
                    "speaker": "叶夫卡",
                    "text": "阿加霞，我明白了！其实雅科夫最想要的就是他父亲能够回来，要不我就假扮成他的父亲…"
                },
                {
                    "id": "790240109",
                    "speaker": "阿加菲娅",
                    "text": "闭嘴，我现在不想跟你说话！我当时就不该让雅科夫和你一队的！"
                },
                {
                    "id": "790240110",
                    "speaker": "叶夫卡",
                    "text": "阿加霞，这不是因为我，你知道的，都是因为那个实验…"
                },
                {
                    "id": "790240111",
                    "speaker": "阿加菲娅",
                    "text": "雅科夫，可怜的雅科夫啊…"
                },
                {
                    "id": "790240112",
                    "speaker": "派蒙",
                    "text": "怎么了，雅科夫还是什么反应都没有吗？"
                },
                {
                    "id": "790240113",
                    "speaker": "阿加菲娅",
                    "text": "是你们啊…唉，正如你们所见，雅科夫还是一点反应都没有。"
                },
                {
                    "id": "790240114",
                    "speaker": "阿加菲娅",
                    "text": "这该如何是好啊，如果他这样浑浑噩噩的，就算回到了至冬，恐怕也会被愚人众除名…",
                    "choices": [
                        {
                            "id": "790240115",
                            "text": "被愚人众除名不好吗…",
                            "response": [
                                {
                                    "id": "790240117",
                                    "speaker": "阿加菲娅",
                                    "text": "可是，可是雅科夫现在孤身一人…我们都时常外出执行任务，没人能够照顾他…如果被愚人众除名，他这样还怎么活下去呀…"
                                },
                                {
                                    "id": "790240118",
                                    "speaker": "阿加菲娅",
                                    "text": "#对了，{NICKNAME}，你…你肯定解决过很多这样的事了吧！"
                                },
                                {
                                    "id": "790240119",
                                    "speaker": "阿加菲娅",
                                    "text": "拜托了，拜托了，找到让雅科夫恢复的办法吧！"
                                },
                                {
                                    "id": "790240120",
                                    "speaker": "派蒙",
                                    "text": "可是…"
                                },
                                {
                                    "id": "790240121",
                                    "speaker": "阿加菲娅",
                                    "text": "你们不是想要情报吗，我们会拿机密的情报跟你们交换的，比如…"
                                },
                                {
                                    "id": "790240122",
                                    "speaker": "扎哈尔",
                                    "text": "对，比如「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」！"
                                },
                                {
                                    "id": "790240123",
                                    "speaker": "阿加菲娅",
                                    "text": "扎哈尔…"
                                },
                                {
                                    "id": "790240124",
                                    "speaker": "扎哈尔",
                                    "text": "对不起…我只记得这个了…"
                                },
                                {
                                    "id": "790240125",
                                    "speaker": "叶夫卡",
                                    "text": "我们只是些负责跑腿的，哪有什么机密情报…"
                                },
                                {
                                    "id": "790240126",
                                    "speaker": "阿加菲娅",
                                    "text": "叶夫卡，你不说话没人把你当哑巴。"
                                },
                                {
                                    "id": "790240127",
                                    "speaker": "派蒙",
                                    "text": "#唉…{NICKNAME}，你怎么看呢，「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」这条情报。",
                                    "choices": [
                                        {
                                            "id": "790240128",
                                            "text": "多少也是情报…",
                                            "response": [
                                                {
                                                    "id": "790240130",
                                                    "speaker": "派蒙",
                                                    "text": "好吧，就看在这条情报的价值上，就帮你们这个忙吧。"
                                                },
                                                {
                                                    "id": "790240131",
                                                    "speaker": "阿加菲娅",
                                                    "text": "那真是感激不尽！"
                                                },
                                                {
                                                    "id": "790240132",
                                                    "speaker": "派蒙",
                                                    "text": "不过说是这么说…到底怎么样才能唤醒雅科夫呢…"
                                                },
                                                {
                                                    "id": "790240133",
                                                    "speaker": "派蒙",
                                                    "text": "#他们之前好像一直在这个营地里…{NICKNAME}，不如我们先一起去营地里找找线索吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790240129",
                                            "text": "勉勉强强吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790240116",
                            "text": "听上去倒是件好事。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902402",
            "objective": "在营地进行调查",
            "dialogues": [
                {
                    "id": "790240201",
                    "speaker": "阿加菲娅",
                    "text": "怎么样，有什么发现了吗？"
                },
                {
                    "id": "790240202",
                    "speaker": "派蒙",
                    "text": "虽然也说不上是有线索，不过也是一种可能呢…"
                },
                {
                    "id": "790240203",
                    "speaker": "Black Screen",
                    "text": "向三位愚人众小队成员说明了海螺的作用…"
                },
                {
                    "id": "790240204",
                    "speaker": "阿加菲娅",
                    "text": "啊，没想到被那个奇怪装置影响到的海螺还会有这样的效果啊…"
                },
                {
                    "id": "790240205",
                    "speaker": "阿加菲娅",
                    "text": "你说的那个画面，应该是我带着害怕被训斥的雅科夫，找叶夫卡的画面吧…"
                },
                {
                    "id": "790240206",
                    "speaker": "叶夫卡",
                    "text": "对，你这么一说，我也有点印象。"
                },
                {
                    "id": "790240207",
                    "speaker": "阿加菲娅",
                    "text": "不过，那也是很长一段时间之前，更何况，受到了那台巨大装置的影响，呜…在营地里时的记忆也变得很模糊…"
                },
                {
                    "id": "790240208",
                    "speaker": "阿加菲娅",
                    "text": "但是，这里的海螺本来应该有四个，应该<color=#00E1FFFF>还有其他三个</color>的！"
                },
                {
                    "id": "790240209",
                    "speaker": "派蒙",
                    "text": "其他的记忆很模糊，但是海螺有四个却记得很清楚？"
                },
                {
                    "id": "790240210",
                    "speaker": "阿加菲娅",
                    "text": "在营地休整的时候，我们发现忘带盛汤的容器了，所以就临时用了那个海螺装做好的汤。所以，那个海螺是我们一人一个的…"
                },
                {
                    "id": "790240211",
                    "speaker": "扎哈尔",
                    "text": "嗯，不过出发之前，雅科夫就把汤喝完，留在箱子上了…"
                },
                {
                    "id": "790240212",
                    "speaker": "扎哈尔",
                    "text": "其他的我们一人一个，全都带走啦！",
                    "choices": [
                        {
                            "id": "790240213",
                            "text": "那，海螺呢？",
                            "response": [
                                {
                                    "id": "790240215",
                                    "speaker": "阿加菲娅",
                                    "text": "唔…当时只觉得是一些普通的海螺，所以喝完汤之后就扔掉了…"
                                },
                                {
                                    "id": "790240216",
                                    "speaker": "阿加菲娅",
                                    "text": "我想想，那个时候才刚上<color=#00E1FFFF>西北方向的大岛</color>，就把汤喝完，海螺，海螺被我顺手丢在岛上一个全是水的山洞里了。"
                                },
                                {
                                    "id": "790240217",
                                    "speaker": "叶夫卡",
                                    "text": "我，我好像扔在<color=#00E1FFFF>南方的大岛</color>遗迹边的山上了…"
                                },
                                {
                                    "id": "790240218",
                                    "speaker": "扎哈尔",
                                    "text": "嘿嘿，我的扔进了<color=#00E1FFFF>东北方向大岛</color>的井里…"
                                },
                                {
                                    "id": "790240219",
                                    "speaker": "派蒙",
                                    "text": "哇，根本就丢得到处都是…"
                                },
                                {
                                    "id": "790240220",
                                    "speaker": "派蒙",
                                    "text": "西北方向的岛，应该是辛焱的幻境所在的岛，也就是破破岛…"
                                },
                                {
                                    "id": "790240221",
                                    "speaker": "派蒙",
                                    "text": "南方向的大岛，就应该是危危岛…东北方向的话…"
                                },
                                {
                                    "id": "790240222",
                                    "speaker": "Player",
                                    "text": "就是双双岛吧…"
                                },
                                {
                                    "id": "790240223",
                                    "speaker": "派蒙",
                                    "text": "丢在了这三个岛上呀…"
                                },
                                {
                                    "id": "790240224",
                                    "speaker": "Player",
                                    "text": "看来得找到这三个海螺…"
                                },
                                {
                                    "id": "790240225",
                                    "speaker": "派蒙",
                                    "text": "嗯，如果找到了这三个海螺，说不定就能找到能让雅科夫醒过来的线索了！"
                                }
                            ]
                        },
                        {
                            "id": "790240214",
                            "text": "海螺现在在哪？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902415",
            "objective": "在营地进行调查",
            "dialogues": [
                {
                    "id": "790240501",
                    "speaker": "派蒙",
                    "text": "#嗯？{NICKNAME}，你看箱子上放的海螺…"
                },
                {
                    "id": "790240502",
                    "speaker": "派蒙",
                    "text": "总觉得在什么地方看到过类似的海螺，我们调查看看吧…"
                }
            ]
        },
        {
            "id": "7902417",
            "objective": "在营地进行调查",
            "dialogues": [
                {
                    "id": "790241701",
                    "speaker": "派蒙",
                    "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？"
                },
                {
                    "id": "790241702",
                    "speaker": "派蒙",
                    "text": "总觉得是有点奇怪的影像呢…"
                },
                {
                    "id": "790241703",
                    "speaker": "扎哈尔的影像",
                    "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。"
                },
                {
                    "id": "790241704",
                    "speaker": "雅科夫的影像",
                    "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…"
                },
                {
                    "id": "790241705",
                    "speaker": "雅科夫的影像",
                    "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…"
                },
                {
                    "id": "790241706",
                    "speaker": "扎哈尔的影像",
                    "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！"
                },
                {
                    "id": "790241707",
                    "speaker": "派蒙",
                    "text": "他们指着那么高的地方，是想要吃什么啊…"
                },
                {
                    "id": "790241708",
                    "speaker": "派蒙",
                    "text": "难道这个海螺…放歪了？"
                }
            ]
        },
        {
            "id": "7902416",
            "objective": "在营地进行调查",
            "dialogues": [
                {
                    "id": "790243101",
                    "speaker": "叶夫卡的影像",
                    "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…"
                },
                {
                    "id": "790243102",
                    "speaker": "雅科夫的影像",
                    "text": "但是…"
                },
                {
                    "id": "790243103",
                    "speaker": "叶夫卡的影像",
                    "text": "去做信号接收测试而已，累活又不是没干过…"
                },
                {
                    "id": "790243104",
                    "speaker": "阿加菲娅的影像",
                    "text": "你看，叶夫卡也觉得不是什么大事吧。"
                },
                {
                    "id": "790243105",
                    "speaker": "雅科夫的影像",
                    "text": "那…那我先去做准备，待会儿我们就出发！"
                },
                {
                    "id": "790243106",
                    "speaker": "派蒙",
                    "text": "原来是能够记录下影像的海螺啊…"
                },
                {
                    "id": "790243107",
                    "speaker": "派蒙",
                    "text": "唔…总觉得这段对话有些没头没尾的…像是缺了什么东西一样…"
                },
                {
                    "id": "790243108",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们去问问那些愚人众吧。"
                }
            ]
        },
        {
            "id": "7902403",
            "objective": "与营地中的愚人众对话收集线索",
            "dialogues": []
        },
        {
            "id": "7902410",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "790240301",
                    "speaker": "派蒙",
                    "text": "#对了，{NICKNAME}，就在他们说的那些地方…我们不都看到过奇怪的海螺影像嘛…"
                },
                {
                    "id": "790240302",
                    "speaker": "派蒙",
                    "text": "那个时候我们捡到的那三个有点怪怪的海螺，说不定就是用在这里的，赶紧放箱子上试试吧！"
                }
            ]
        },
        {
            "id": "7902404",
            "objective": "前去寻找丢失的海螺",
            "dialogues": []
        },
        {
            "id": "7902405",
            "objective": "前去寻找丢失的海螺",
            "dialogues": []
        },
        {
            "id": "7902406",
            "objective": "前去寻找丢失的海螺",
            "dialogues": []
        },
        {
            "id": "7902413",
            "objective": "",
            "dialogues": [
                {
                    "id": "790241501",
                    "speaker": "派蒙",
                    "text": "唔，影像居然正好放在舞台的中间…"
                },
                {
                    "id": "790241502",
                    "speaker": "派蒙",
                    "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…"
                },
                {
                    "id": "790241503",
                    "speaker": "派蒙",
                    "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…"
                },
                {
                    "id": "790241504",
                    "speaker": "Player",
                    "text": "愚人众也要听睡前故事吗…"
                },
                {
                    "id": "790241505",
                    "speaker": "派蒙",
                    "text": "说不定愚人众里也有人有这种需要的嘛。"
                },
                {
                    "id": "790241506",
                    "speaker": "雅科夫的影像",
                    "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…"
                },
                {
                    "id": "790241507",
                    "speaker": "阿加菲娅的影像",
                    "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…"
                },
                {
                    "id": "790241508",
                    "speaker": "阿加菲娅的影像",
                    "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。"
                },
                {
                    "id": "790241509",
                    "speaker": "派蒙",
                    "text": "什么嘛，原来不是在讲故事呀…"
                },
                {
                    "id": "790241510",
                    "speaker": "派蒙",
                    "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
                }
            ]
        },
        {
            "id": "7902414",
            "objective": "",
            "dialogues": [
                {
                    "id": "790241601",
                    "speaker": "派蒙",
                    "text": "海螺居然能够从井中浮起来…",
                    "choices": [
                        {
                            "id": "790241602",
                            "text": "毕竟是被幻境影响的海螺…",
                            "response": [
                                {
                                    "id": "790241604",
                                    "speaker": "派蒙",
                                    "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！"
                                },
                                {
                                    "id": "790241605",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你不要动，你的身后…",
                                    "choices": [
                                        {
                                            "id": "790241606",
                                            "text": "是、是什么可怕的东西吗…",
                                            "response": [
                                                {
                                                    "id": "790241608",
                                                    "speaker": "派蒙",
                                                    "text": "啊，仔细一看只是海螺产生的影像，突然出现在背后，真是吓了人一大跳呢！"
                                                },
                                                {
                                                    "id": "790241609",
                                                    "speaker": "雅科夫的影像",
                                                    "text": "信号测试器…两组…"
                                                },
                                                {
                                                    "id": "790241610",
                                                    "speaker": "叶夫卡的影像",
                                                    "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。"
                                                },
                                                {
                                                    "id": "790241611",
                                                    "speaker": "阿加菲娅的影像",
                                                    "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…"
                                                },
                                                {
                                                    "id": "790241612",
                                                    "speaker": "阿加菲娅的影像",
                                                    "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…"
                                                },
                                                {
                                                    "id": "790241613",
                                                    "speaker": "叶夫卡的影像",
                                                    "text": "家人吗…"
                                                },
                                                {
                                                    "id": "790241614",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…总有种偷听到了不该偷听到的话的感觉…"
                                                },
                                                {
                                                    "id": "790241615",
                                                    "speaker": "派蒙",
                                                    "text": "影像里这几个人好像不是…「那么坏」的愚人众嘛…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790241607",
                                            "text": "不许故意吓人哦！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790241603",
                            "text": "大概壳中有空气…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902407",
            "objective": "将错位的海螺放回原位",
            "dialogues": [
                {
                    "id": "790240701",
                    "speaker": "派蒙",
                    "text": "#嗯？{NICKNAME}，你看箱子上放的海螺，看上去有点眼熟…"
                },
                {
                    "id": "790240702",
                    "speaker": "派蒙",
                    "text": "这不是其他岛上看到过的那种，能够记录影像的海螺嘛！"
                },
                {
                    "id": "790240703",
                    "speaker": "派蒙",
                    "text": "说不定有唤醒雅科夫的线索呢！"
                }
            ]
        },
        {
            "id": "7902411",
            "objective": "唤醒雅科夫",
            "dialogues": [
                {
                    "id": "790242201",
                    "speaker": "扎哈尔",
                    "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。"
                },
                {
                    "id": "790242202",
                    "speaker": "雅科夫",
                    "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…"
                },
                {
                    "id": "790242203",
                    "speaker": "雅科夫",
                    "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…"
                },
                {
                    "id": "790242204",
                    "speaker": "扎哈尔",
                    "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！"
                },
                {
                    "id": "790242205",
                    "speaker": "雅科夫",
                    "text": "阿加霞，佩尔西科夫研究员让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，非得气个爆炸不可…"
                },
                {
                    "id": "790242206",
                    "speaker": "阿加菲娅",
                    "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…"
                },
                {
                    "id": "790242207",
                    "speaker": "阿加菲娅",
                    "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。"
                },
                {
                    "id": "790242208",
                    "speaker": "叶夫卡",
                    "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…"
                },
                {
                    "id": "790242209",
                    "speaker": "雅科夫",
                    "text": "但是…"
                },
                {
                    "id": "790242210",
                    "speaker": "叶夫卡",
                    "text": "去做信号接收测试而已，累活又不是没干过…"
                },
                {
                    "id": "790242211",
                    "speaker": "阿加菲娅",
                    "text": "你看，叶夫卡也觉得不是什么大事吧。"
                },
                {
                    "id": "790242212",
                    "speaker": "雅科夫",
                    "text": "那…那我先去做准备，待会儿我们就出发！"
                },
                {
                    "id": "790242213",
                    "speaker": "雅科夫",
                    "text": "信号测试器…两组…"
                },
                {
                    "id": "790242214",
                    "speaker": "叶夫卡",
                    "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。"
                },
                {
                    "id": "790242215",
                    "speaker": "阿加菲娅",
                    "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…"
                },
                {
                    "id": "790242216",
                    "speaker": "阿加菲娅",
                    "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…"
                },
                {
                    "id": "790242217",
                    "speaker": "叶夫卡",
                    "text": "家人吗…"
                },
                {
                    "id": "790242218",
                    "speaker": "雅科夫",
                    "text": "家人…我已经没有家人了…"
                },
                {
                    "id": "790242219",
                    "speaker": "雅科夫",
                    "text": "…父亲让自己留在了危险的地方，让我得以脱身返回至冬。确认父亲无法归还后，他们送来了那枚徽记…"
                },
                {
                    "id": "790242220",
                    "speaker": "雅科夫",
                    "text": "可是我不想要那些奖赏和荣誉…我，我只想要我的家人…啊，父亲啊，为什么你独自把我留在这个世上呢…"
                },
                {
                    "id": "790242221",
                    "speaker": "阿加菲娅",
                    "text": "雅科夫。"
                },
                {
                    "id": "790242240",
                    "speaker": "雅科夫",
                    "text": "唔...头好痛，怎么了，阿加霞姐姐，你怎么在这...我们不是在不同的组吗..."
                },
                {
                    "id": "790242222",
                    "speaker": "阿加菲娅",
                    "text": "实验和任务都已经结束啦，雅科夫。"
                },
                {
                    "id": "790242223",
                    "speaker": "叶夫卡",
                    "text": "没想到居然是「家人」啊…那我的推论也对了一半嘛！"
                },
                {
                    "id": "790242224",
                    "speaker": "雅科夫",
                    "text": "怎么、怎么都这样看着我，我是说了什么奇怪的话吗…"
                },
                {
                    "id": "790242225",
                    "speaker": "阿加菲娅",
                    "text": "没有，只是不小心听到了一些你的心里话而已。雅科夫，所谓的家人有的时候并不仅仅指血脉相连的人哦…"
                },
                {
                    "id": "790242226",
                    "speaker": "扎哈尔",
                    "text": "嘿嘿，我觉得家人就是能一直在一起吃饭的人。"
                },
                {
                    "id": "790242227",
                    "speaker": "雅科夫",
                    "text": "…我，我知道啦。"
                },
                {
                    "id": "790242228",
                    "speaker": "叶夫卡",
                    "text": "如果你愿意的话，你也可以将我视作你的父亲…"
                },
                {
                    "id": "790242229",
                    "speaker": "雅科夫",
                    "text": "不，这就有点恶心了…"
                },
                {
                    "id": "790242230",
                    "speaker": "派蒙",
                    "text": "啊，雅科夫恢复了！"
                },
                {
                    "id": "790242231",
                    "speaker": "Player",
                    "text": "真是可喜可贺…"
                },
                {
                    "id": "790242232",
                    "speaker": "雅科夫",
                    "text": "咦，这两位，不是在内部文件里看到过的…"
                },
                {
                    "id": "790242233",
                    "speaker": "派蒙",
                    "text": "其实之前就想问了…",
                    "choices": [
                        {
                            "id": "790242234",
                            "text": "内部文件？",
                            "response": [
                                {
                                    "id": "790242236",
                                    "speaker": "阿加菲娅",
                                    "text": "哎呀，没什么，上面都没什么重要的东西…"
                                },
                                {
                                    "id": "790242237",
                                    "speaker": "阿加菲娅",
                                    "text": "对了雅科夫，如果没有他们帮忙，你说不定就没法恢复理智了！"
                                },
                                {
                                    "id": "790242238",
                                    "speaker": "雅科夫",
                                    "text": "唔，虽然不知道发生了什么，但这次就谢谢你们了！"
                                },
                                {
                                    "id": "790242239",
                                    "speaker": "派蒙",
                                    "text": "嗯…还是有点在意，不过就算了，我们也算成功完成了「情报与委托的交易啦」。"
                                }
                            ]
                        },
                        {
                            "id": "790242235",
                            "text": "什么内部文件？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790241001",
                    "speaker": "阿加菲娅",
                    "text": "怎么了，找不到海螺？我记得没错的话，我带着的那个海螺应该在<color=#00E1FFFF>西北方向的大岛</color>一个全是水的山洞里了。"
                }
            ]
        },
        {
            "id": "7902411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790241101",
                    "speaker": "扎哈尔",
                    "text": "我的海螺？我的海螺被扔进<color=#00E1FFFF>东北方向大岛</color>的井里啦，那井还蛮深的嘞…"
                }
            ]
        },
        {
            "id": "7902412",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790241201",
                    "speaker": "叶夫卡",
                    "text": "我的那个海螺被我扔在<color=#00E1FFFF>南方大岛</color>遗迹边的山上了…"
                },
                {
                    "id": "790241202",
                    "speaker": "叶夫卡",
                    "text": "真是羞愧啊，要是早知道海螺有那样的作用，就不带出营地了。"
                }
            ]
        },
        {
            "id": "7902413",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790241301",
                    "speaker": "雅科夫",
                    "text": "为什么…只留下我一个人…我的父亲啊…为什么…"
                },
                {
                    "id": "790241302",
                    "speaker": "Player",
                    "text": "（看来还是不太清醒的样子…）"
                }
            ]
        },
        {
            "id": "7902445",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790244501",
                    "speaker": "阿加菲娅",
                    "text": "怎么样，我们知道的都告诉你了，有找到什么让雅科夫清醒过来的办法吗？",
                    "choices": [
                        {
                            "id": "790244502",
                            "text": "关于信号测试…",
                            "response": [
                                {
                                    "id": "790244503",
                                    "speaker": "阿加菲娅",
                                    "text": "不是都说了，我也不是很清楚嘛…可能只是一些简单的测试工作吧，只不过需要跑到各个岛上去，还挺累人的。"
                                }
                            ]
                        },
                        {
                            "id": "790244504",
                            "text": "关于扎哈尔…",
                            "response": [
                                {
                                    "id": "790244505",
                                    "speaker": "阿加菲娅",
                                    "text": "扎哈尔是孤儿，很久以前父母就生病去世啦，据说过了很长一段苦日子，听说愚人众管伙食就加入愚人众了…"
                                }
                            ]
                        },
                        {
                            "id": "790244506",
                            "text": "关于合照…",
                            "response": [
                                {
                                    "id": "790244507",
                                    "speaker": "阿加菲娅",
                                    "text": "好吧，合照里的是我的两个哥哥，他们都曾经为至冬国做出过贡献…我一直，以他们为荣。"
                                }
                            ]
                        },
                        {
                            "id": "790244508",
                            "text": "还在调查…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902446",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790244601",
                    "speaker": "叶夫卡",
                    "text": "#唉，雅科夫，雅科夫该怎么办啊…{NICKNAME}，有什么头绪了吗？",
                    "choices": [
                        {
                            "id": "790244602",
                            "text": "你是怎么成为愚人众的…",
                            "response": [
                                {
                                    "id": "790244603",
                                    "speaker": "叶夫卡",
                                    "text": "怎么成为愚人众，你是说我吗…"
                                },
                                {
                                    "id": "790244604",
                                    "speaker": "叶夫卡",
                                    "text": "那当然是为了实现女皇大人的夙愿…以及为了我的家族能获得更多的荣誉，我从小就被教导要为女皇大人而战。"
                                }
                            ]
                        },
                        {
                            "id": "790244605",
                            "text": "关于雅科夫…",
                            "response": [
                                {
                                    "id": "790244606",
                                    "speaker": "叶夫卡",
                                    "text": "唉，雅科夫好像没有清醒过来的迹象…"
                                }
                            ]
                        },
                        {
                            "id": "790244607",
                            "text": "还没什么头绪…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902447",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790244701",
                    "speaker": "雅科夫",
                    "text": "为什么…只留下我一个人…我的父亲啊…为什么…"
                },
                {
                    "id": "790244702",
                    "speaker": "Player",
                    "text": "（看来还是不太清醒的样子…）"
                }
            ]
        },
        {
            "id": "7902448",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790244801",
                    "speaker": "扎哈尔",
                    "text": "啊，雅科夫…如果雅科夫能快点恢复就好了…"
                },
                {
                    "id": "790244802",
                    "speaker": "扎哈尔",
                    "text": "虽然教官教导我们，愚人众都是至冬的士兵，为伟大的事业而献身，不应该产生多余的情感…"
                },
                {
                    "id": "790244803",
                    "speaker": "扎哈尔",
                    "text": "可是，大家一起朝夕相处那么久…我脑子不好，不清楚，但真的有人对同伴一点感情都没有吗…"
                }
            ]
        },
        {
            "id": "7903301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790330101",
                    "speaker": "派蒙",
                    "text": "唔，影像居然正好放在舞台的中间…"
                },
                {
                    "id": "790330102",
                    "speaker": "派蒙",
                    "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…"
                },
                {
                    "id": "790330103",
                    "speaker": "派蒙",
                    "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…"
                },
                {
                    "id": "790330104",
                    "speaker": "Player",
                    "text": "愚人众也要听睡前故事吗…"
                },
                {
                    "id": "790330105",
                    "speaker": "派蒙",
                    "text": "说不定愚人众里也有人有这种需要的嘛。"
                },
                {
                    "id": "790330106",
                    "speaker": "岩使游击兵的影像",
                    "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…"
                },
                {
                    "id": "790330107",
                    "speaker": "藏镜仕女的影像",
                    "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…"
                },
                {
                    "id": "790330108",
                    "speaker": "藏镜仕女的影像",
                    "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。"
                },
                {
                    "id": "790330109",
                    "speaker": "派蒙",
                    "text": "什么嘛，原来不是在讲故事呀…"
                },
                {
                    "id": "790330110",
                    "speaker": "派蒙",
                    "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
                }
            ]
        },
        {
            "id": "7903302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790330201",
                    "speaker": "派蒙",
                    "text": "海螺居然能够从井中浮起来…",
                    "choices": [
                        {
                            "id": "790330202",
                            "text": "毕竟是被幻境影响的海螺…",
                            "response": [
                                {
                                    "id": "790330204",
                                    "speaker": "派蒙",
                                    "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！"
                                },
                                {
                                    "id": "790330205",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你不要动，你的身后…",
                                    "choices": [
                                        {
                                            "id": "790330206",
                                            "text": "是、是什么可怕的东西吗…",
                                            "response": [
                                                {
                                                    "id": "790330208",
                                                    "speaker": "派蒙",
                                                    "text": "啊，仔细一看只是海螺产生的影像，突然出现在背后，真是吓了人一大跳呢！"
                                                },
                                                {
                                                    "id": "790330209",
                                                    "speaker": "岩使游击兵的影像",
                                                    "text": "信号测试器…两组…"
                                                },
                                                {
                                                    "id": "790330210",
                                                    "speaker": "雷锤前锋军的影像",
                                                    "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。"
                                                },
                                                {
                                                    "id": "790330211",
                                                    "speaker": "藏镜仕女的影像",
                                                    "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…"
                                                },
                                                {
                                                    "id": "790330212",
                                                    "speaker": "藏镜仕女的影像",
                                                    "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…"
                                                },
                                                {
                                                    "id": "790330213",
                                                    "speaker": "雷锤前锋军的影像",
                                                    "text": "家人吗…"
                                                },
                                                {
                                                    "id": "790330214",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…总有种偷听到了不该偷听到的话的感觉…"
                                                },
                                                {
                                                    "id": "790330215",
                                                    "speaker": "派蒙",
                                                    "text": "影像里这几个人好像不是…「那么坏」的愚人众嘛…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790330207",
                                            "text": "不许故意吓人哦！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790330203",
                            "text": "大概壳中有空气…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7903303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790330301",
                    "speaker": "派蒙",
                    "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？"
                },
                {
                    "id": "790330302",
                    "speaker": "派蒙",
                    "text": "总觉得是有点奇怪的影像呢…"
                },
                {
                    "id": "790330303",
                    "speaker": "水铳重卫士的影像",
                    "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。"
                },
                {
                    "id": "790330304",
                    "speaker": "岩使游击兵的影像",
                    "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…"
                },
                {
                    "id": "790330305",
                    "speaker": "岩使游击兵的影像",
                    "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…"
                },
                {
                    "id": "790330306",
                    "speaker": "水铳重卫士的影像",
                    "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！"
                },
                {
                    "id": "790330307",
                    "speaker": "派蒙",
                    "text": "他们指着那么高的地方，是想要吃什么啊…"
                },
                {
                    "id": "790330308",
                    "speaker": "派蒙",
                    "text": "难道这个海螺…放歪了？"
                }
            ]
        }
    ]
