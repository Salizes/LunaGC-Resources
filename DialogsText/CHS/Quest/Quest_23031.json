    "quest": {
        "id": "23031",
        "title": "鱼钩上的绝景？",
        "description": "渔师凯万似乎正在为某个目标不懈努力…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
