    "talks": [
        {
            "id": "2303101",
            "objective": "与凯万对话",
            "dialogues": [
                {
                    "id": "230310201",
                    "speaker": "Player",
                    "text": "那你需要什么材料？"
                },
                {
                    "id": "230310202",
                    "speaker": "凯万",
                    "text": "根据今天的直觉…就用墩墩桃好了。"
                },
                {
                    "id": "230310203",
                    "speaker": "凯万",
                    "text": "虽然平时很常见，但很少有人把它当成鱼饵的材料。"
                },
                {
                    "id": "230310204",
                    "speaker": "凯万",
                    "text": "麻烦你们帮我找找这种材料了。"
                }
            ]
        },
        {
            "id": "2303102",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": []
        },
        {
            "id": "2303103",
            "objective": "与凯万对话",
            "dialogues": [
                {
                    "id": "230310601",
                    "speaker": "凯万",
                    "text": "好极了，材料齐全了，看我制作独一无二的鱼饵。"
                },
                {
                    "id": "230310602",
                    "speaker": "Black Screen",
                    "text": "凯万熟练地制作了鱼饵"
                },
                {
                    "id": "230310603",
                    "speaker": "凯万",
                    "text": "好，开始钓鱼了。"
                },
                {
                    "id": "230310604",
                    "speaker": "凯万",
                    "text": "鱼钩入水深度合格…水流速度适中…"
                },
                {
                    "id": "230310605",
                    "speaker": "凯万",
                    "text": "你们要保持安静，水里的鱼可是很敏感的。"
                },
                {
                    "id": "230310606",
                    "speaker": "凯万",
                    "text": "岸边的脚步声也有可能惊动到它们。",
                    "choices": [
                        {
                            "id": "230310607",
                            "text": "我站着不动。",
                            "response": [
                                {
                                    "id": "230310609",
                                    "speaker": "凯万",
                                    "text": "那你们就沉住气，安心等待吧…"
                                },
                                {
                                    "id": "230310610",
                                    "speaker": "Black Screen",
                                    "text": "凯万钓到了一袋湿漉漉的东西"
                                },
                                {
                                    "id": "230310611",
                                    "speaker": "派蒙",
                                    "text": "这是什么嘛，根本不是鱼！"
                                },
                                {
                                    "id": "230310612",
                                    "speaker": "Player",
                                    "text": "确实没见过这种「鱼」。"
                                },
                                {
                                    "id": "230310613",
                                    "speaker": "凯万",
                                    "text": "果然还是这样啊，完全不意外。"
                                },
                                {
                                    "id": "230310614",
                                    "speaker": "凯万",
                                    "text": "咳咳，异乡人，心态放宽点，别太计较细节问题。"
                                },
                                {
                                    "id": "230310615",
                                    "speaker": "凯万",
                                    "text": "鱼钩带出水面的东西，都可以被看成是钓上来的「鱼」。"
                                },
                                {
                                    "id": "230310616",
                                    "speaker": "凯万",
                                    "text": "不瞒你说，我这最厉害的渔师可不是自封的。"
                                },
                                {
                                    "id": "230310617",
                                    "speaker": "凯万",
                                    "text": "毕竟每次都钓上这种不会咬钩的，不算活物的东西，也算是一种本事吧…"
                                },
                                {
                                    "id": "230310618",
                                    "speaker": "凯万",
                                    "text": "其他渔师也都赞叹过我，说我有着独一无二的才能。",
                                    "choices": [
                                        {
                                            "id": "230310619",
                                            "text": "他们可能是在安慰你…",
                                            "response": [
                                                {
                                                    "id": "230310621",
                                                    "speaker": "派蒙",
                                                    "text": "简单来说，就是除了鱼之外什么都钓的上来吧…"
                                                },
                                                {
                                                    "id": "230310622",
                                                    "speaker": "凯万",
                                                    "text": "咳！不管他们怎么想都没关系！至，至少我钓鱼永不走空车！"
                                                },
                                                {
                                                    "id": "230310623",
                                                    "speaker": "凯万",
                                                    "text": "今天不成就明天再来，总有一天，我肯定能钓上来鱼！"
                                                },
                                                {
                                                    "id": "230310624",
                                                    "speaker": "凯万",
                                                    "text": "谢谢你们帮我去找材料，这些报酬给你，我要换个地方继续钓鱼了。"
                                                },
                                                {
                                                    "id": "230310625",
                                                    "speaker": "凯万",
                                                    "text": "下次…下次我一定能钓到一条大鱼！一定！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230310620",
                                            "text": "他们可能是在揶揄你…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230310608",
                            "text": "派蒙脚不着地。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303104",
            "objective": "寻找凯万需要的材料",
            "dialogues": [
                {
                    "id": "230310401",
                    "speaker": "Player",
                    "text": "那你需要什么材料？"
                },
                {
                    "id": "230310402",
                    "speaker": "凯万",
                    "text": "根据今天的直觉…就用我常采摘的一种蘑菇好了。"
                },
                {
                    "id": "230310403",
                    "speaker": "凯万",
                    "text": "我经常使用的蘑菇生长在一片特别的地区，我给你们说明一下方位。"
                },
                {
                    "id": "230310404",
                    "speaker": "凯万",
                    "text": "麻烦你们帮我找找这种材料了。"
                }
            ]
        },
        {
            "id": "2303105",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": [
                {
                    "id": "230310501",
                    "speaker": "凯万",
                    "text": "这次的鱼饵需要日落果，小麦和墩墩桃，你准备好了吗？"
                }
            ]
        },
        {
            "id": "2303106",
            "objective": "与凯万对话",
            "dialogues": []
        },
        {
            "id": "2303107",
            "objective": "寻找鱼饵材料",
            "dialogues": [
                {
                    "id": "230310701",
                    "speaker": "凯万",
                    "text": "这次的鱼饵需要日落果，小麦和特别的鸟蛋，你准备好了吗？"
                }
            ]
        },
        {
            "id": "2303108",
            "objective": "将鱼饵的材料交给凯万",
            "dialogues": []
        },
        {
            "id": "2303109",
            "objective": "与凯万对话",
            "dialogues": []
        },
        {
            "id": "2303101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230310101",
                    "speaker": "凯万",
                    "text": "哟，看你的样子…是旅行者吧？居然会来这种地方闲逛，很有闲情雅致啊。"
                },
                {
                    "id": "230310102",
                    "speaker": "凯万",
                    "text": "还是说，你也是钓鱼客，相中了这片水域？"
                },
                {
                    "id": "230310103",
                    "speaker": "凯万",
                    "text": "眼光不错！这里是附近最好的钓鱼点了。"
                },
                {
                    "id": "230310104",
                    "speaker": "派蒙",
                    "text": "可这附近好像没有其他人在钓鱼啊？你怎么这么肯定？"
                },
                {
                    "id": "230310105",
                    "speaker": "凯万",
                    "text": "那当然是因为我眼光独到了。"
                },
                {
                    "id": "230310106",
                    "speaker": "凯万",
                    "text": "身为这一带最厉害的渔师，选择钓鱼点的方法当然也有讲究。"
                },
                {
                    "id": "230310107",
                    "speaker": "Player",
                    "text": "真…真的吗？"
                },
                {
                    "id": "230310108",
                    "speaker": "派蒙",
                    "text": "你好像没什么收获欸？"
                },
                {
                    "id": "230310109",
                    "speaker": "凯万",
                    "text": "话都说到这份上了，就让你们见识一下「鱼钩上的绝景」吧。",
                    "choices": [
                        {
                            "id": "230310110",
                            "text": "鱼钩上的…",
                            "response": [
                                {
                                    "id": "230310112",
                                    "speaker": "凯万",
                                    "text": "你给我特别的材料，我手制鱼饵，钓出你从没见过的「鱼」。"
                                },
                                {
                                    "id": "230310113",
                                    "speaker": "派蒙",
                                    "text": "怎么感觉有点可疑？手制鱼饵真的靠谱吗？"
                                },
                                {
                                    "id": "230310114",
                                    "speaker": "Player",
                                    "text": "试试也无妨。"
                                },
                                {
                                    "id": "230310115",
                                    "speaker": "凯万",
                                    "text": "爽快，我就喜欢和这样的人打交道！"
                                },
                                {
                                    "id": "230310116",
                                    "speaker": "凯万",
                                    "text": "我的手制鱼饵除了作为基底的日落果和小麦以外，还有一种赋予其灵性的材料。"
                                }
                            ]
                        },
                        {
                            "id": "230310111",
                            "text": "绝景？"
                        }
                    ]
                }
            ]
        },
        {
