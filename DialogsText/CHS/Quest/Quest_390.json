                {
                    "id": "3902201",
                    "speaker": "温迪",
                    "text": "好啦！你就先去试试吧！"
                },
                {
                    "id": "3902202",
                    "speaker": "温迪",
                    "text": "不试一试的话，谁知道会发生什么呢？"
