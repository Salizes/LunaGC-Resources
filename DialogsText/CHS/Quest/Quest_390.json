                {
                    "id": "3902501",
                    "speaker": "温迪",
                    "text": "「导光机关」连向了其他的「导光机关」啊…"
                },
                {
                    "id": "3902502",
                    "speaker": "温迪",
                    "text": "真是麻烦的历史遗留呢…"
