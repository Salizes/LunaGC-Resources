        "chapter": {
            "icon": "UI_ChapterIcon_Mengde",
            "id": "1003",
            "num": "序章 第三幕",
            "title": "巨龙与自由之歌"
        },
        "total_dialogue_lines": 64,
        "total_speaker_counts": {
