    "talks": [
        {
            "id": "39701",
            "objective": "去酒庄找迪卢克",
            "dialogues": []
        },
        {
            "id": "39702",
            "objective": "与迪卢克对话",
            "dialogues": [
                {
                    "id": "3970201",
                    "speaker": "迪卢克",
                    "text": "深渊教团…这些与人类为敌的怪物，地下情报网也很少出现它们的消息。"
                },
                {
                    "id": "3970202",
                    "speaker": "迪卢克",
                    "text": "但虽然麻烦，终归也还是被我找出一些线索了。"
                },
                {
                    "id": "3970203",
                    "speaker": "温迪",
                    "text": "这么快就有线索了吗？不愧是消息灵通的迪卢克老爷。"
                },
                {
                    "id": "3970204",
                    "speaker": "派蒙",
                    "text": "不过说起来，风神巴巴托斯大人，为什么要借助人类的力量…"
                },
                {
                    "id": "3970205",
                    "speaker": "温迪",
                    "text": "哈哈，怎么说呢？"
                },
                {
                    "id": "3970206",
                    "speaker": "温迪",
                    "text": "人们所说的七神，更本源的称谓是「尘世七执政」。"
                },
                {
                    "id": "3970207",
                    "speaker": "温迪",
                    "text": "划分尘世、各自统治七分之一，这是我们作为神明的责任。"
                },
                {
                    "id": "3970208",
                    "speaker": "温迪",
                    "text": "履行神职，才能积累神力。但我不喜欢统治…我觉得蒙德也不会喜欢的。"
                },
                {
                    "id": "3970209",
                    "speaker": "琴",
                    "text": "「你们建立无人称王的自由城邦罢」——巴巴托斯大人的理念，我们牢记于心。"
                },
                {
                    "id": "3970210",
                    "speaker": "派蒙",
                    "text": "真虔诚啊，琴团长！"
                },
                {
                    "id": "3970211",
                    "speaker": "派蒙",
                    "text": "完全没有想过可能是某人太过自由散漫、不想管事的原因呢。"
                },
                {
                    "id": "3970212",
                    "speaker": "温迪",
                    "text": "咳咳。总之你们看，我都这么久没有回过蒙德了…"
                },
                {
                    "id": "3970213",
                    "speaker": "温迪",
                    "text": "所以现在的我，毫无疑问，正是七神中最弱的一个！",
                    "choices": [
                        {
                            "id": "3970214",
                            "text": "这话说得真是掷地有声啊…",
                            "response": [
                                {
                                    "id": "3970216",
                                    "speaker": "温迪",
                                    "text": "过奖过奖。"
                                },
                                {
                                    "id": "3970217",
                                    "speaker": "迪卢克",
                                    "text": "呵…我们有这样一位风神大人，该说是好还是坏呢。"
                                },
                                {
                                    "id": "3970218",
                                    "speaker": "迪卢克",
                                    "text": "不过现在就先抛开七国与七神的话题，重新关注一下人类共同的敌人吧。"
                                },
                                {
                                    "id": "3970219",
                                    "speaker": "迪卢克",
                                    "text": "这一次查出的<color=#00E1FFFF>深渊法师踪迹</color>，就在<color=#00E1FFFF>酒庄</color>附近。"
                                },
                                {
                                    "id": "3970220",
                                    "speaker": "琴",
                                    "text": "不能让它全身而退。"
                                },
                                {
                                    "id": "3970221",
                                    "speaker": "Player",
                                    "text": "开始追猎吧。"
                                }
                            ]
                        },
                        {
                            "id": "3970215",
                            "text": "不愧是「自由之都」的神。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "39705",
            "objective": "(test)显示章节ui用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39703",
            "objective": "击败来袭的敌人",
            "dialogues": [
                {
                    "id": "3970301",
                    "speaker": "派蒙",
                    "text": "在那里了！"
                }
            ]
        },
        {
            "id": "39704",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3970401",
                    "speaker": "温迪",
                    "text": "咦？这是什么…"
                },
                {
                    "id": "3970402",
                    "speaker": "温迪",
                    "text": "深渊法师被击败以后，散逸出了某种能量…"
                },
                {
                    "id": "3970403",
                    "speaker": "温迪",
                    "text": "它原本的用途，似乎是隔绝我和特瓦林之间的联系。"
                },
                {
                    "id": "3970404",
                    "speaker": "温迪",
                    "text": "……"
                },
                {
                    "id": "3970405",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}，你知道<color=#00E1FFFF>「风龙废墟」</color>吗？",
                    "choices": [
                        {
                            "id": "3970406",
                            "text": "不知道。",
                            "response": [
                                {
                                    "id": "3970407",
                                    "speaker": "温迪",
                                    "text": "嗯，但琴团长和迪卢克老爷想必都是知道的。"
                                },
                                {
                                    "id": "3970410",
                                    "speaker": "温迪",
                                    "text": "特瓦林苏醒以后，把一片远古的废墟当作了它的巢穴。"
                                },
                                {
                                    "id": "3970411",
                                    "speaker": "温迪",
                                    "text": "与先前封锁蒙德四方的暴风一样，废墟的入口也有特殊的障壁。"
                                },
                                {
                                    "id": "3970412",
                                    "speaker": "温迪",
                                    "text": "但现在，从深渊法师散逸的能量里，我能读出编织魔力的韵律。"
                                },
                                {
                                    "id": "3970413",
                                    "speaker": "温迪",
                                    "text": "虽然那种韵律比丘丘人的合唱还要难听，但…"
                                },
                                {
                                    "id": "3970414",
                                    "speaker": "温迪",
                                    "text": "也足够让我们破除暴风障壁、抵达<color=#00E1FFFF>「风龙废墟」</color>内部了。"
                                },
                                {
                                    "id": "3970415",
                                    "speaker": "迪卢克",
                                    "text": "那，就是要正面挑战风龙了么？"
                                },
                                {
                                    "id": "3970416",
                                    "speaker": "迪卢克",
                                    "text": "我倒是没有意见…话说回来，琴才是那个想要避免开战的人。"
                                },
                                {
                                    "id": "3970417",
                                    "speaker": "琴",
                                    "text": "不。在没有更好的选择时，就由我承担改变方针的责任。"
                                },
                                {
                                    "id": "3970418",
                                    "speaker": "琴",
                                    "text": "如果讨伐风龙是唯一的方案，那我就会成为冲锋在前的骑士。"
                                },
                                {
                                    "id": "3970419",
                                    "speaker": "温迪",
                                    "text": "——现在还没到那一步喔。"
                                },
                                {
                                    "id": "3970420",
                                    "speaker": "迪卢克",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "3970421",
                                    "speaker": "琴",
                                    "text": "温迪阁下的意思是…"
                                },
                                {
                                    "id": "3970422",
                                    "speaker": "温迪",
                                    "text": "我的意思是，天空之琴不是我们的底牌。"
                                },
                                {
                                    "id": "3970423",
                                    "speaker": "温迪",
                                    "text": "#真正的底牌——是{NICKNAME}呀。"
                                },
                                {
                                    "id": "3970424",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "3970425",
                                            "text": "是因为我净化了泪滴结晶吗？",
                                            "response": [
                                                {
                                                    "id": "3970426",
                                                    "speaker": "温迪",
                                                    "text": "没错。"
                                                },
                                                {
                                                    "id": "3970430",
                                                    "speaker": "温迪",
                                                    "text": "泪滴里的污秽杂质，和缠绕在特瓦林身上的诅咒，是同一种邪力。"
                                                },
                                                {
                                                    "id": "3970431",
                                                    "speaker": "温迪",
                                                    "text": "所以——"
                                                },
                                                {
                                                    "id": "3970432",
                                                    "speaker": "派蒙",
                                                    "text": "卖唱的，这太危险了！"
                                                },
                                                {
                                                    "id": "3970433",
                                                    "speaker": "派蒙",
                                                    "text": "你看特瓦林发火的样子，动手前就会被特瓦林一口吞掉吧！",
                                                    "choices": [
                                                        {
                                                            "id": "3970434",
                                                            "text": "都说了我很能打。",
                                                            "response": [
                                                                {
                                                                    "id": "3970436",
                                                                    "speaker": "迪卢克",
                                                                    "text": "…嘿。"
                                                                },
                                                                {
                                                                    "id": "3970437",
                                                                    "speaker": "迪卢克",
                                                                    "text": "有趣的计划，值得尝试。"
                                                                },
                                                                {
                                                                    "id": "3970438",
                                                                    "speaker": "琴",
                                                                    "text": "我也当然会与你同在，荣誉骑士。"
                                                                },
                                                                {
                                                                    "id": "3970439",
                                                                    "speaker": "派蒙",
                                                                    "text": "敌人是…深渊的怪物，和龙！压迫感很强呢。"
                                                                },
                                                                {
                                                                    "id": "3970440",
                                                                    "speaker": "迪卢克",
                                                                    "text": "人类也有人类的底蕴。我们走吧。"
                                                                },
                                                                {
                                                                    "id": "3970441",
                                                                    "speaker": "温迪",
                                                                    "text": "那么——"
                                                                },
                                                                {
                                                                    "id": "3970442",
                                                                    "speaker": "温迪",
                                                                    "text": "英雄的诗篇，终于进入决战的篇章啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3970435",
                                                            "text": "这一战需要借助大家的力量。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3970427",
                                            "text": "是因为我很能打吗？",
                                            "response": [
                                                {
                                                    "id": "3970428",
                                                    "speaker": "温迪",
                                                    "text": "#唔嗯…当然，{NICKNAME}的战力是很强的。"
                                                },
                                                {
                                                    "id": "3970429",
                                                    "speaker": "温迪",
                                                    "text": "但在你的身上，还有更珍贵的闪光点。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3970408",
                            "text": "似乎在蒙德城里听人提起过。",
                            "response": [
                                {
                                    "id": "3970409",
                                    "speaker": "温迪",
                                    "text": "嗯，同样来自蒙德的各位，想必都是知道的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}