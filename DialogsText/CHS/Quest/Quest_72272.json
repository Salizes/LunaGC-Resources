    "talks": [
        {
            "id": "7227201",
            "objective": "（test）跟荣一郎说话$HIDDEN",
            "dialogues": [
                {
                    "id": "722720101",
                    "speaker": "御舆源一郎",
                    "text": "你好，看上什么工艺品了吗？如果在店里找不到现成的，我可以定做。"
                },
                {
                    "id": "722720102",
                    "speaker": "Player",
                    "text": "我有宝物想要出售。"
                },
                {
                    "id": "722720103",
                    "speaker": "御舆源一郎",
                    "text": "欸？其实小店已经有了固定的进货渠道，平时也没有收购散货的业务..."
                },
                {
                    "id": "722720104",
                    "speaker": "御舆源一郎",
                    "text": "不过看你的样子…似乎是个了不起的东西？"
                },
                {
                    "id": "722720105",
                    "speaker": "御舆源一郎",
                    "text": "既然如此…不如先给我看看吧？"
                },
                {
                    "id": "722720106",
                    "speaker": "Black Screen",
                    "text": "将龙骨花凝珠的故事告诉了御舆源一郎。"
                },
                {
                    "id": "722720107",
                    "speaker": "御舆源一郎",
                    "text": "唔…"
                },
                {
                    "id": "722720108",
                    "speaker": "御舆源一郎",
                    "text": "坦白说…虽然这个故事很神奇…但是好像也稍微神奇过头了些…"
                },
                {
                    "id": "722720109",
                    "speaker": "御舆源一郎",
                    "text": "这种东西，已经有些超出我的理解能力了。"
                },
                {
                    "id": "722720110",
                    "speaker": "御舆源一郎",
                    "text": "请别见笑，毕竟我也只是会做些手工艺品的家伙…"
                },
                {
                    "id": "722720120",
                    "speaker": "御舆源一郎",
                    "text": "这样吧，80000摩拉，最多再加5份刺身拼盘，这种料理可不便宜。"
                },
                {
                    "id": "722720111",
                    "speaker": "御舆源一郎",
                    "text": "这个价格你接受的话，我就买下这件宝物。",
                    "choices": [
                        {
                            "id": "722720112",
                            "text": "你会拿它做什么？",
                            "response": [
                                {
                                    "id": "722720113",
                                    "speaker": "御舆源一郎",
                                    "text": "我还说不清楚，得再仔细琢磨一下这个东西。"
                                },
                                {
                                    "id": "722720114",
                                    "speaker": "御舆源一郎",
                                    "text": "如果情况好的话，说不定可以加工成一种特别的根付，这样应该能多卖点价钱。"
                                }
                            ]
                        },
                        {
                            "id": "722720115",
                            "text": "公道的价格，成交。",
                            "response": [
                                {
                                    "id": "722720116",
                                    "speaker": "御舆源一郎",
                                    "text": "那么这些摩拉请收好。我得去好好研究研究这个。"
                                }
                            ]
                        },
                        {
                            "id": "722720117",
                            "text": "我再考虑一下。",
                            "response": [
                                {
                                    "id": "722720118",
                                    "speaker": "御舆源一郎",
                                    "text": "嗯…刚好我也可以再想想。"
                                },
                                {
                                    "id": "722720119",
                                    "speaker": "御舆源一郎",
                                    "text": "如果你考虑好了，可以再来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7227202",
            "objective": "Additional",
            "dialogues": [
                {
