        {
            "id": "4135901",
            "objective": "与小千对话",
            "dialogues": [
                {
                    "id": "413590101",
                    "speaker": "小千",
                    "text": "欢迎试玩「玲珑霄灯图」…"
                },
                {
                    "id": "413590102",
                    "speaker": "Player",
                    "text": "这次也准备了不一样的图案吗？"
                },
                {
                    "id": "413590103",
                    "speaker": "小千",
                    "text": "当然啦，毕竟被你连续解开了两次，这次我可是真的去换了难度最高的几盏灯。"
                },
                {
                    "id": "413590104",
                    "speaker": "小千",
                    "text": "不过，图当然还是三个拼成一个完整的，难度还是在<color=#00E1FFFF>「连轴」</color>上。"
                },
                {
                    "id": "413590105",
                    "speaker": "小千",
                    "text": "嘿嘿，你就自己去体会一下吧，这次的图案是<color=#00E1FFFF>「仙鹤」</color>哦。"
                },
                {
                    "id": "413590106",
                    "speaker": "小千",
                    "text": "拼好了图之后，你就可以去找宝藏去啦。"
                }
            ]
        },
        {
            "id": "4135902",
            "objective": "完成「玲珑霄灯图·鹤」",
            "dialogues": [
                {
                    "id": "413590201",
                    "speaker": "小千",
                    "text": "怎么样，寻宝之旅还顺利吗？"
                },
                {
                    "id": "413590202",
                    "speaker": "Player",
                    "text": "已经找到全部宝藏了。"
                },
                {
                    "id": "413590203",
                    "speaker": "小千",
                    "text": "你居然真的把三张图都解完了…你还挺厉害的…"
                },
                {
                    "id": "413590204",
                    "speaker": "小千",
                    "text": "咳，对于你这种实力高超的冒险家，我们协会也特别准备了一份大礼。"
                },
                {
                    "id": "413590205",
                    "speaker": "小千",
                    "text": "看到对面那些宝箱了吗？打开吧，里面的东西都归你了。"
                },
                {
                    "id": "413590206",
                    "speaker": "Player",
                    "text": "我拿了之后…"
                },
                {
                    "id": "413590207",
                    "speaker": "小千",
                    "text": "后面的人当然就没了，冒险就是这样，战利品谁先拿到就归谁。"
                },
                {
                    "id": "413590208",
                    "speaker": "小千",
                    "text": "好了，祝你在海灯节玩得开心。"
                }
            ]
        },
        {
            "id": "4135915",
            "objective": "观察「玲珑霄灯图·鹤」",
            "dialogues": []
        },
        {
            "id": "4135903",
            "objective": "(test)第三天大世界解谜$HIDDEN",
            "dialogues": [
                {
                    "id": "413590301",
                    "speaker": "小千",
                    "text": "居、居然又拼好了…"
                },
                {
                    "id": "413590302",
                    "speaker": "小千",
                    "text": "这也难不倒你吗…你果然是个很厉害的冒险家啊…"
                },
                {
                    "id": "413590303",
                    "speaker": "小千",
                    "text": "快去看看屏风吧，宝藏的线索都隐藏在里面了。"
                }
            ]
        },
