    "talks": [
        {
            "id": "400901",
            "objective": "前往「公爵」办公室",
            "dialogues": [
                {
                    "id": "40090101",
                    "speaker": "菲米尼",
                    "text": "林尼…呃，对不起…"
                },
                {
                    "id": "40090102",
                    "speaker": "琳妮特",
                    "text": "我也很抱歉，哥哥。我应该更谨慎一些。"
                },
                {
                    "id": "40090103",
                    "speaker": "林尼",
                    "text": "别说这种话。都是我的错…该谨慎的人是我。你们差点就…"
                },
                {
                    "id": "40090104",
                    "speaker": "菲米尼",
                    "text": "如果我实力更强一点，也许现在已经找到「公子」大人了…"
                },
                {
                    "id": "40090105",
                    "speaker": "林尼",
                    "text": "不对，你怎么能这么说？"
                },
                {
                    "id": "40090106",
                    "speaker": "菲米尼",
                    "text": "欸？"
                },
                {
                    "id": "40090107",
                    "speaker": "林尼",
                    "text": "…抱歉…"
                },
                {
                    "id": "40090108",
                    "speaker": "琳妮特",
                    "text": "也就是说，我们都不够谨慎，对吗？共同责任。"
                },
                {
                    "id": "40090109",
                    "speaker": "菲米尼",
                    "text": "啊，对！共同责任！"
                },
                {
                    "id": "40090110",
                    "speaker": "林尼",
                    "text": "……"
                },
                {
                    "id": "40090111",
                    "speaker": "琳妮特",
                    "text": "哥哥，你担心我们，我们也担心现在的你。不要露出这种表情…请你打起精神来。"
                },
                {
                    "id": "40090112",
                    "speaker": "林尼",
                    "text": "…嗯。"
                }
            ]
        },
        {
            "id": "400902",
            "objective": "与莱欧斯利对话",
            "dialogues": [
                {
                    "id": "40090201",
                    "speaker": "希格雯",
                    "text": "打扰了哟。"
                },
                {
                    "id": "40090202",
                    "speaker": "莱欧斯利",
                    "text": "看来菲米尼先生情况稳定下来了。"
                },
                {
                    "id": "40090203",
                    "speaker": "希格雯",
                    "text": "当然，否则我不会离开医务室的。"
                },
                {
                    "id": "40090204",
                    "speaker": "莱欧斯利",
                    "text": "那两位过来很正常，但护士长是有何贵干？"
                },
                {
                    "id": "40090205",
                    "speaker": "希格雯",
                    "text": "我来看看克洛琳德小姐。你感觉还好吗？"
                },
                {
                    "id": "40090206",
                    "speaker": "克洛琳德",
                    "text": "嗯，没什么问题。"
                },
                {
                    "id": "40090207",
                    "speaker": "希格雯",
                    "text": "可以的话，我想帮你再做个检查，很快的，请给我几分钟。"
                },
                {
                    "id": "40090208",
                    "speaker": "克洛琳德",
                    "text": "好吧，谢谢。那我就先告辞了。"
                },
                {
                    "id": "40090209",
                    "speaker": "派蒙",
                    "text": "该向我们解释了吧？"
                },
                {
                    "id": "40090210",
                    "speaker": "莱欧斯利",
                    "text": "哈哈，解释，我不太喜欢这个说法。「说明」如何？"
                },
                {
                    "id": "40090211",
                    "speaker": "Player",
                    "text": "愿闻其详。"
                },
                {
                    "id": "40090212",
                    "speaker": "莱欧斯利",
                    "text": "不过要从哪里说起呢？烦请你们提问吧，从最想知道答案的问题开始好了。"
                },
                {
                    "id": "40090213",
                    "speaker": "派蒙",
                    "text": "唔…那我问了哦，你从一开始就知道林尼他们的目的吗？"
                },
                {
                    "id": "40090214",
                    "speaker": "莱欧斯利",
                    "text": "不，我只知道他们隶属愚人众，受「仆人」命令进入梅洛彼得堡，具体目的嘛，随着你们行动推进才查清。"
                },
                {
                    "id": "40090215",
                    "speaker": "派蒙",
                    "text": "都不知道目的，却能仔细地防着他们？"
                },
                {
                    "id": "40090216",
                    "speaker": "莱欧斯利",
                    "text": "他们来意不善，我很擅长分辨这类信号。"
                },
                {
                    "id": "40090217",
                    "speaker": "Player",
                    "text": "为什么不阻止他们的行动？"
                },
                {
                    "id": "40090218",
                    "speaker": "莱欧斯利",
                    "text": "一开始，我认为他们的目的是查清「公子」为什么失踪。"
                },
                {
                    "id": "40090219",
                    "speaker": "莱欧斯利",
                    "text": "林尼猜测是我故意放走他，实际上，我们并没有特意阻拦或是纵容他的行为。他只是就那样自然地找到帮手，自然地离开了。"
                },
                {
                    "id": "40090220",
                    "speaker": "莱欧斯利",
                    "text": "至冬执行官在枫丹境内失踪，这件事肯定会被「仆人」拿来大做文章。"
                },
                {
                    "id": "40090221",
                    "speaker": "莱欧斯利",
                    "text": "我也有点好奇这位执行官去了哪里，反正一样要查，就让愚人众自己的人来查吧。我只等结果。"
                },
                {
                    "id": "40090222",
                    "speaker": "派蒙",
                    "text": "你想坐收渔翁之利啊…"
                },
                {
                    "id": "40090223",
                    "speaker": "莱欧斯利",
                    "text": "有什么不可以的呢？可惜，后来情况有变，菲米尼应该告诉你了，梅洛彼得堡周围的海水正在变化。"
                },
                {
                    "id": "40090224",
                    "speaker": "莱欧斯利",
                    "text": "「禁区」一直是林尼的调查目标，你来了之后也被牵扯其中。为了你们的安全，也为了不让梅洛彼得堡摊上更多麻烦事，我开始着手干涉你们。"
                },
                {
                    "id": "40090225",
                    "speaker": "派蒙",
                    "text": "传闻是真的吗？你以前真的是罪犯？"
                },
                {
                    "id": "40090226",
                    "speaker": "莱欧斯利",
                    "text": "什么话？都当梅洛彼得堡的管理者了，天天待在这里，不就是变相坐牢吗？只是这里的人比较服我。"
                },
                {
                    "id": "40090227",
                    "speaker": "派蒙",
                    "text": "对了，谁找克洛琳德来的？"
                },
                {
                    "id": "40090228",
                    "speaker": "莱欧斯利",
                    "text": "当然是我。我花钱请她来梅洛彼得堡出外勤。"
                },
                {
                    "id": "40090229",
                    "speaker": "莱欧斯利",
                    "text": "克洛琳德小姐是决斗代理人，相当于第三方势力。我需要请一个实力超群的帮手应对接下来的危机。"
                },
                {
                    "id": "40090230",
                    "speaker": "派蒙",
                    "text": "比如救起菲米尼？"
                },
                {
                    "id": "40090231",
                    "speaker": "莱欧斯利",
                    "text": "你就这么理解好了。那位先生确实是个好手，要是条件不那么苛刻，他可能已经追上失踪的人了。",
                    "choices": [
                        {
                            "id": "40090232",
                            "text": "「禁区」真实存在？",
                            "response": [
                                {
                                    "id": "40090234",
                                    "speaker": "莱欧斯利",
                                    "text": "这不是你该打听的事，那维莱特委托你的工作也只是探查「公子」的去向。"
                                },
                                {
                                    "id": "40090235",
                                    "speaker": "莱欧斯利",
                                    "text": "我只需向你证明「禁区」与公子的失踪无关，这一点上菲米尼就是人证。"
                                },
                                {
                                    "id": "40090236",
                                    "speaker": "派蒙",
                                    "text": "可是，我们都查到医务室了，你刚才也问了一堆事…反而是我们问的最后一个问题你还没回答呢！"
                                },
                                {
                                    "id": "40090237",
                                    "speaker": "莱欧斯利",
                                    "text": "噢，说得我都不好意思了。你们真那么想知道答案啊。"
                                },
                                {
                                    "id": "40090238",
                                    "speaker": "派蒙",
                                    "text": "对！"
                                },
                                {
                                    "id": "40090239",
                                    "speaker": "莱欧斯利",
                                    "text": "哪怕说出真相也未必能让你高兴？"
                                },
                                {
                                    "id": "40090240",
                                    "speaker": "Player",
                                    "text": "…是的。"
                                },
                                {
                                    "id": "40090241",
                                    "speaker": "莱欧斯利",
                                    "text": "跟我来。"
                                }
                            ]
                        },
                        {
                            "id": "40090233",
                            "text": "里面有什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "400903",
            "objective": "跟随莱欧斯利",
            "dialogues": [
                {
                    "id": "40090301",
                    "speaker": "派蒙",
                    "text": "这种地方居然有扇暗门？里面还有个地下室！你可真能藏。"
                },
                {
                    "id": "40090302",
                    "speaker": "莱欧斯利",
                    "text": "别忘了梅洛彼得堡是什么地方。"
                }
            ]
        },
        {
            "id": "400904",
            "objective": "跟随莱欧斯利",
            "dialogues": [
                {
                    "id": "40090401",
                    "speaker": "莱欧斯利",
                    "text": "站在中间的圆盘上。"
                },
                {
                    "id": "40090402",
                    "speaker": "派蒙",
                    "text": "难道有什么秘密机关？…哇！"
                },
                {
                    "id": "40090403",
                    "speaker": "Black Screen",
                    "text": "众人站稳之后，圆盘开始缓缓向下移动…"
                }
            ]
        },
        {
            "id": "400906",
            "objective": "与莱欧斯利对话",
            "dialogues": [
                {
                    "id": "40090601",
                    "speaker": "派蒙",
                    "text": "这里就是「禁区」？藏得那么隐蔽，进来一看倒没什么特别的嘛。"
                },
                {
                    "id": "40090602",
                    "speaker": "Player",
                    "text": "那是…"
                },
                {
                    "id": "40090603",
                    "speaker": "派蒙",
                    "text": "门好大啊！"
                },
                {
                    "id": "40090604",
                    "speaker": "莱欧斯利",
                    "text": "类似的隔离门总共有三道，一般来说没人能进入门内，除了我。顾名思义，「禁区」。"
                },
                {
                    "id": "40090605",
                    "speaker": "莱欧斯利",
                    "text": "不过你们肯定会把信息共享给愚人众那几位对吧。"
                },
                {
                    "id": "40090606",
                    "speaker": "派蒙",
                    "text": "确实没想过要瞒着他们…"
                },
                {
                    "id": "40090607",
                    "speaker": "莱欧斯利",
                    "text": "哈哈，该不该这么做，还是等你们看完再决定吧。"
                }
            ]
        },
        {
            "id": "400907",
            "objective": "继续探索",
            "dialogues": [
                {
                    "id": "40090701",
                    "speaker": "派蒙",
                    "text": "旁边还有开关呢。"
                },
                {
                    "id": "40090702",
                    "speaker": "莱欧斯利",
                    "text": "往后站。"
                },
                {
                    "id": "40090703",
                    "speaker": "派蒙",
                    "text": "呜哇…一道接一道升上去了…"
                },
                {
                    "id": "40090704",
                    "speaker": "Player",
                    "text": "房间中央那是什么？"
                },
                {
                    "id": "40090705",
                    "speaker": "莱欧斯利",
                    "text": "走近点。"
                }
            ]
        },
        {
            "id": "400908",
            "objective": "跟随莱欧斯利向前探索",
            "dialogues": [
                {
                    "id": "40090801",
                    "speaker": "Player",
                    "text": "（这间房间十分空旷，什么都没放，本身就已经很奇怪了。房间正中还有一个装置，像一道巨大的闸门。）"
                },
                {
                    "id": "40090802",
                    "speaker": "莱欧斯利",
                    "text": "接管梅洛彼得堡后我一直很在意这道门后面是什么。贸然开启很不明智，但不探查它背后究竟有什么，也是在放任隐患。"
                },
                {
                    "id": "40090803",
                    "speaker": "莱欧斯利",
                    "text": "我接手梅洛彼得堡至今，闸门上那道仪表盘就没有变化过，但最近一年，它的指针悄然转动，恐怕是某个数据变化了一丁点。"
                },
                {
                    "id": "40090804",
                    "speaker": "莱欧斯利",
                    "text": "放在平时应该会被忽视，不过那段时间我比较闲，就花了点时间调查。你们觉得它会是什么？",
                    "choices": [
                        {
                            "id": "40090805",
                            "text": "水压？",
                            "response": [
                                {
                                    "id": "40090807",
                                    "speaker": "莱欧斯利",
                                    "text": "很合理的猜想，我也考虑过。它不是那么常规。"
                                },
                                {
                                    "id": "40090808",
                                    "speaker": "莱欧斯利",
                                    "text": "温度会根据气候变化，相比温度，水压的可能性更高。我们从外部做了些测试，尝试增加压力，可它不受影响。"
                                },
                                {
                                    "id": "40090809",
                                    "speaker": "莱欧斯利",
                                    "text": "后来，我想到另一些可能，与原始胎海有关。基于这种猜想，我开始做准备。"
                                },
                                {
                                    "id": "40090810",
                                    "speaker": "莱欧斯利",
                                    "text": "这两天指针又转了，加上那位潜水员回来时的症状，如今我已经完全确定，这个指数代表的是原始胎海水浓度。"
                                },
                                {
                                    "id": "40090811",
                                    "speaker": "派蒙",
                                    "text": "浓度？！可这里是海底…"
                                },
                                {
                                    "id": "40090812",
                                    "speaker": "莱欧斯利",
                                    "text": "问题就在这里。我们在海底，而海水悄悄变质了，胎海水混杂其中，浓度还在不断升高。"
                                },
                                {
                                    "id": "40090813",
                                    "speaker": "Player",
                                    "text": "…胎海水在不断混入海水？"
                                },
                                {
                                    "id": "40090814",
                                    "speaker": "莱欧斯利",
                                    "text": "嗯，可能性很大。"
                                },
                                {
                                    "id": "40090815",
                                    "speaker": "派蒙",
                                    "text": "可是，别说我们俩了，就连那维莱特他们都不知道原始胎海在哪，胎海水又是从哪里…"
                                },
                                {
                                    "id": "40090816",
                                    "speaker": "派蒙",
                                    "text": "啊！"
                                },
                                {
                                    "id": "40090817",
                                    "speaker": "莱欧斯利",
                                    "text": "你们似乎明白了。"
                                },
                                {
                                    "id": "40090818",
                                    "speaker": "莱欧斯利",
                                    "text": "没错，我认为，这道闸门下方就是原始胎海。出于某些原因，闸门后的胎海水开始大幅上涨，已经很接近我们了。"
                                },
                                {
                                    "id": "40090819",
                                    "speaker": "莱欧斯利",
                                    "text": "仪表盘现在是红色。闸门虽然还在，胎海水已经透过部分海底泄漏出来，混入大海。"
                                },
                                {
                                    "id": "40090820",
                                    "speaker": "莱欧斯利",
                                    "text": "…这样下去它很快就没法阻挡底下的水了。",
                                    "choices": [
                                        {
                                            "id": "40090821",
                                            "text": "假如原始胎海在泄漏…",
                                            "response": [
                                                {
                                                    "id": "40090823",
                                                    "speaker": "莱欧斯利",
                                                    "text": "是啊，胎海水来自原始胎海，这是枫丹的传说。如果这里彻底失守，整个枫丹的人一夜之间都会化成水。"
                                                },
                                                {
                                                    "id": "40090824",
                                                    "speaker": "派蒙",
                                                    "text": "太奇怪了吧，为什么梅洛彼得堡会建在原始胎海闸门的正上方？这里是谁造的…？"
                                                },
                                                {
                                                    "id": "40090825",
                                                    "speaker": "莱欧斯利",
                                                    "text": "你的表情像在猜这件事有多复杂。说真的，它可能比你想的还单一。"
                                                },
                                                {
                                                    "id": "40090826",
                                                    "speaker": "莱欧斯利",
                                                    "text": "只不过是因为，在我重新发觉这个秘密之前，枫丹早就没人知道禁区的秘密了。"
                                                },
                                                {
                                                    "id": "40090827",
                                                    "speaker": "莱欧斯利",
                                                    "text": "梅洛彼得堡没有传统意义上的设立者。这些传闻也都是从前聚集在这里的人留下的。"
                                                },
                                                {
                                                    "id": "40090828",
                                                    "speaker": "莱欧斯利",
                                                    "text": "前代水神厄歌莉娅在任时，犯了罪的枫丹人会被流放。人们像狼群驱逐某一匹狼那样赶走犯罪者。"
                                                },
                                                {
                                                    "id": "40090829",
                                                    "speaker": "莱欧斯利",
                                                    "text": "罪犯通常不会得到任何形式的同情，他们被流放到荒芜的海边，经历磨难、寒冷和痛苦。"
                                                },
                                                {
                                                    "id": "40090830",
                                                    "speaker": "莱欧斯利",
                                                    "text": "一些人开始改过，向天祈祷，询问水神还有没有自己能做的事。水神怜悯他们的渴求，便说：去海底看守我的秘密吧。"
                                                },
                                                {
                                                    "id": "40090831",
                                                    "speaker": "莱欧斯利",
                                                    "text": "于是，借由水神的力量，他们聚集到海底，开始建造一座多人共筑的堡垒。他们居住在此，渐渐又吸纳更多人。"
                                                },
                                                {
                                                    "id": "40090832",
                                                    "speaker": "莱欧斯利",
                                                    "text": "随着被流放者增加，更多人走上他们的老路。最初一批成员去世前，将当时还不完善的梅洛彼得堡留给其他被流放者。"
                                                },
                                                {
                                                    "id": "40090833",
                                                    "speaker": "莱欧斯利",
                                                    "text": "前代水神从远方送来助力，帮助被流放者的堡垒不断壮大。位于海底，远离阳光的梅洛彼得堡成为了罪人唯一的栖息地。"
                                                },
                                                {
                                                    "id": "40090834",
                                                    "speaker": "莱欧斯利",
                                                    "text": "所以这里的人不把梅洛彼得堡称为监狱，他们相信自己正在赎罪，而罪孽终有一日偿还完，他们就能重获自由。"
                                                },
                                                {
                                                    "id": "40090835",
                                                    "speaker": "莱欧斯利",
                                                    "text": "可后来的人渐渐发觉，梅洛彼得堡是孤独之地。他们习惯了这里的生活，变得渐渐不再适应水上世界。"
                                                },
                                                {
                                                    "id": "40090836",
                                                    "speaker": "莱欧斯利",
                                                    "text": "刑满后，有人离开，有人依然留下，在这里混个闲职，放任自己枯萎的灵魂与古老秘密一同逝去。"
                                                },
                                                {
                                                    "id": "40090837",
                                                    "speaker": "莱欧斯利",
                                                    "text": "…几百年过去，没多少人还记得梅洛彼得堡为何出现。他们只会觉得这里自古就存在，是犯罪者应去的地方。"
                                                },
                                                {
                                                    "id": "40090838",
                                                    "speaker": "莱欧斯利",
                                                    "text": "偶尔会有老研究员，犯了事，在这里终老。我从一个老历史学家那知道这些，其他人总觉得这些全是他幻想出来的。"
                                                },
                                                {
                                                    "id": "40090839",
                                                    "speaker": "派蒙",
                                                    "text": "但现在你知道，这些都是真的…"
                                                },
                                                {
                                                    "id": "40090840",
                                                    "speaker": "莱欧斯利",
                                                    "text": "没错。就像那则预言，如果有一天闸门被冲破，所有人都将溶进水里。"
                                                },
                                                {
                                                    "id": "40090841",
                                                    "speaker": "Player",
                                                    "text": "你相信预言吗？"
                                                },
                                                {
                                                    "id": "40090842",
                                                    "speaker": "莱欧斯利",
                                                    "text": "非要说的话，我不太信。但很可惜，一切正在与预言重合。"
                                                },
                                                {
                                                    "id": "40090843",
                                                    "speaker": "莱欧斯利",
                                                    "text": "预言是种麻烦东西。光是听说就会带来第一次恐慌，发现征兆是第二次，应验是第三次。"
                                                },
                                                {
                                                    "id": "40090844",
                                                    "speaker": "Player",
                                                    "text": "那作为这里的老大，你怎么办？"
                                                },
                                                {
                                                    "id": "40090845",
                                                    "speaker": "莱欧斯利",
                                                    "text": "换个地方，我带你看一件东西。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "40090822",
                                            "text": "一旦闸门失守，枫丹就完了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "40090806",
                            "text": "温度？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "400909",
            "objective": "返回办公室",
            "dialogues": [
                {
                    "id": "40090901",
                    "speaker": "莱欧斯利",
                    "text": "到了。"
                },
                {
                    "id": "40090902",
                    "speaker": "朱里厄",
                    "text": "公爵！您来得正好，最新一次试做的数据已经…"
                },
                {
                    "id": "40090903",
                    "speaker": "露尔薇",
                    "text": "等等朱里厄，有别的人！"
                },
                {
                    "id": "40090904",
                    "speaker": "派蒙",
                    "text": "咦？朱里厄和露尔薇？"
                },
                {
                    "id": "40090905",
                    "speaker": "莱欧斯利",
                    "text": "不用紧张，这两位已经知道我们的计划了。"
                },
                {
                    "id": "40090906",
                    "speaker": "露尔薇",
                    "text": "什么？亏您还说不能向任何人透露我们的计划！"
                },
                {
                    "id": "40090907",
                    "speaker": "朱里厄",
                    "text": "我也抱有同样的疑问。您确定他们可信吗？"
                },
                {
                    "id": "40090908",
                    "speaker": "莱欧斯利",
                    "text": "你已经看到结果了不是吗？这两位知道的事可能比你们想的还多。"
                },
                {
                    "id": "40090909",
                    "speaker": "朱里厄",
                    "text": "…好吧，如果您坚持的话。"
                },
                {
                    "id": "40090910",
                    "speaker": "露尔薇",
                    "text": "我从他们身上感觉不到恶意…应该是可信的吧。"
                },
                {
                    "id": "40090911",
                    "speaker": "莱欧斯利",
                    "text": "重新介绍一下，这位是朱里厄，枫丹科学院最高级研究人才之一，曾在艾德温手下工作。你们知道艾德温吧？",
                    "choices": [
                        {
                            "id": "40090912",
                            "text": "知道。",
                            "response": [
                                {
                                    "id": "40090913",
                                    "speaker": "莱欧斯利",
                                    "text": "很好，省去了解释的功夫。"
                                },
                                {
                                    "id": "40090916",
                                    "speaker": "莱欧斯利",
                                    "text": "艾德温主攻研究方向是始基矿和重力仪，朱里厄作为助手，也了解相关技术。我聘请他担任我的技术顾问。"
                                },
                                {
                                    "id": "40090917",
                                    "speaker": "派蒙",
                                    "text": "你…你要把梅洛彼得堡炸上天？"
                                },
                                {
                                    "id": "40090918",
                                    "speaker": "莱欧斯利",
                                    "text": "啊，这句话很美妙。我开始想象了。"
                                },
                                {
                                    "id": "40090919",
                                    "speaker": "朱里厄",
                                    "text": "我也有些心动…"
                                },
                                {
                                    "id": "40090920",
                                    "speaker": "露尔薇",
                                    "text": "先生们，注意分寸！"
                                },
                                {
                                    "id": "40090921",
                                    "speaker": "莱欧斯利",
                                    "text": "正直的露尔薇小姐同样是我请来的技术顾问，很巧，朱里厄以前是艾德温的助手，而她以前是朱里厄的助手。"
                                },
                                {
                                    "id": "40090922",
                                    "speaker": "派蒙",
                                    "text": "还能这样？"
                                },
                                {
                                    "id": "40090923",
                                    "speaker": "Player",
                                    "text": "有什么必要？"
                                },
                                {
                                    "id": "40090924",
                                    "speaker": "莱欧斯利",
                                    "text": "你看，大家都这么问。你们其实是借职务之便谈恋爱吧？"
                                },
                                {
                                    "id": "40090925",
                                    "speaker": "露尔薇",
                                    "text": "什…公爵，我们没在谈恋爱！"
                                },
                                {
                                    "id": "40090926",
                                    "speaker": "朱里厄",
                                    "text": "除非我疯了！"
                                },
                                {
                                    "id": "40090927",
                                    "speaker": "莱欧斯利",
                                    "text": "噢，当我没说。"
                                },
                                {
                                    "id": "40090928",
                                    "speaker": "莱欧斯利",
                                    "text": "跟我来。"
                                },
                                {
                                    "id": "40090929",
                                    "speaker": "派蒙",
                                    "text": "哇，又是一扇会升起来的门！"
                                },
                                {
                                    "id": "40090930",
                                    "speaker": "莱欧斯利",
                                    "text": "你这样称赞会让我对梅洛彼得堡产生不必要的自信。"
                                },
                                {
                                    "id": "40090931",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿…我是真的觉得很厉害嘛。"
                                },
                                {
                                    "id": "40090932",
                                    "speaker": "Player",
                                    "text": "普通的房间？"
                                },
                                {
                                    "id": "40090933",
                                    "speaker": "莱欧斯利",
                                    "text": "再来一些小把戏。"
                                },
                                {
                                    "id": "40090934",
                                    "speaker": "莱欧斯利",
                                    "text": "请看。"
                                },
                                {
                                    "id": "40090935",
                                    "speaker": "Player",
                                    "text": "这是…？！"
                                },
                                {
                                    "id": "40090936",
                                    "speaker": "派蒙",
                                    "text": "这么大的…船？"
                                },
                                {
                                    "id": "40090937",
                                    "speaker": "派蒙",
                                    "text": "而且这里是没见过的工厂区…这是怎么回事？"
                                },
                                {
                                    "id": "40090938",
                                    "speaker": "莱欧斯利",
                                    "text": "不知道你们对枫丹历史了解多少？"
                                },
                                {
                                    "id": "40090939",
                                    "speaker": "派蒙",
                                    "text": "呃…了解得很少…"
                                },
                                {
                                    "id": "40090940",
                                    "speaker": "莱欧斯利",
                                    "text": "那你们或许还不知道雷穆利亚的故事。简单来说，古代枫丹受雷穆利亚王朝统治。"
                                },
                                {
                                    "id": "40090941",
                                    "speaker": "莱欧斯利",
                                    "text": "传说雷穆利亚的帝王雷穆斯受天启感召而来，寻到化身为金蜂的先知西比尔。带着金蜂与大船法图纳号，在海上建立自己的国家。"
                                },
                                {
                                    "id": "40090942",
                                    "speaker": "莱欧斯利",
                                    "text": "他以雷穆利亚称呼这个国家，并靠法图纳号继续不断寻找新的岛屿和部落，号召他们归入帝国统治。"
                                },
                                {
                                    "id": "40090943",
                                    "speaker": "派蒙",
                                    "text": "这个故事里也有船…？"
                                },
                                {
                                    "id": "40090944",
                                    "speaker": "莱欧斯利",
                                    "text": "与水有关的地方总会有船。人们相信船能带领大家找到希望。"
                                },
                                {
                                    "id": "40090945",
                                    "speaker": "派蒙",
                                    "text": "你也信吗？"
                                },
                                {
                                    "id": "40090946",
                                    "speaker": "莱欧斯利",
                                    "text": "我的话，半信半疑。但你也看到了，我拥有一整座工厂的材料、技术和人力，试一试没什么不好。"
                                },
                                {
                                    "id": "40090947",
                                    "speaker": "莱欧斯利",
                                    "text": "所以，第一次猜想那扇闸门下可能是胎海时，我就想到要做这件事了。"
                                },
                                {
                                    "id": "40090948",
                                    "speaker": "派蒙",
                                    "text": "是传说中的法图纳号启发了你吗？"
                                },
                                {
                                    "id": "40090949",
                                    "speaker": "莱欧斯利",
                                    "text": "天灾在即，枫丹人需要这样的手段。",
                                    "choices": [
                                        {
                                            "id": "40090950",
                                            "text": "这是一个伟大的计划…",
                                            "response": [
                                                {
                                                    "id": "40090952",
                                                    "speaker": "莱欧斯利",
                                                    "text": "如果让这里的犯人知道大船背后我们要面临的灾难，那在真正的灾难到来前，暴乱会先毁掉梅洛彼得堡。"
                                                },
                                                {
                                                    "id": "40090953",
                                                    "speaker": "莱欧斯利",
                                                    "text": "身为管理者，我不能认可这种莽撞。"
                                                },
                                                {
                                                    "id": "40090954",
                                                    "speaker": "莱欧斯利",
                                                    "text": "好了，我说得足够多，需要再喝三杯茶。你们还有什么疑问？"
                                                },
                                                {
                                                    "id": "40090955",
                                                    "speaker": "莱欧斯利",
                                                    "text": "看来没有了。那请吧，我送你们回去。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "40090951",
                                            "text": "为什么要偷偷进行？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "40090914",
                            "text": "不知道。",
                            "response": [
                                {
                                    "id": "40090915",
                                    "speaker": "朱里厄",
                                    "text": "艾德温，就是炸飞了整个枫丹科学院的家伙。他是公认的脑袋有问题，不过你不是本地人，不知道也没什么奇怪的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "400912",
            "objective": "与莱欧斯利对话",
            "dialogues": [
                {
                    "id": "40091201",
                    "speaker": "莱欧斯利",
                    "text": "就送你们到这里。"
                },
                {
                    "id": "40091202",
                    "speaker": "派蒙",
                    "text": "噢！呃…谢谢。"
                },
                {
                    "id": "40091203",
                    "speaker": "莱欧斯利",
                    "text": "别客气。不过记住了，要不要将信息分享出去取决于你。你的举动很可能影响那几个人。"
                },
                {
                    "id": "40091204",
                    "speaker": "Player",
                    "text": "（他的意思是，我说不说出梅洛彼得堡的秘密，将直接决定林尼他们的下一步行动。）"
                },
                {
                    "id": "40091205",
                    "speaker": "Player",
                    "text": "（…也就是说，如果我要将真相告诉林尼，就必须让他明白现在不能有太多纷争。）"
                },
                {
                    "id": "40091206",
                    "speaker": "派蒙",
                    "text": "我们会认真考虑的，嗯！"
                },
                {
                    "id": "40091207",
                    "speaker": "Player",
                    "text": "嗯，会的。"
                },
                {
                    "id": "40091208",
                    "speaker": "莱欧斯利",
                    "text": "好，容我期待之后的事。"
                }
            ]
        },
        {
            "id": "400999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "40099901",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        }
    ]
}