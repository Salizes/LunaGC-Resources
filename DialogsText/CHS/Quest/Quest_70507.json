        }
    },
    "talks": [
        {
            "id": "7050701",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705070101",
                    "speaker": "派蒙",
                    "text": "钟…钟离！"
                },
                {
                    "id": "705070102",
                    "speaker": "钟离",
                    "text": "许久不见，近来可好？"
                },
                {
                    "id": "705070103",
                    "speaker": "派蒙",
                    "text": "不不不对…钟离，你怎么会在这里啊！"
                },
                {
                    "id": "705070104",
                    "speaker": "钟离",
                    "text": "既是闲游，就不该局限于眼前。风之国土自由丰饶，是一大好去处。"
                },
                {
                    "id": "705070105",
                    "speaker": "钟离",
                    "text": "能在这里遇见你们，实属意外之喜。",
                    "choices": [
                        {
                            "id": "705070106",
                            "text": "要来一杯什么吗？",
                            "response": [
                                {
                                    "id": "705070108",
                                    "speaker": "钟离",
                                    "text": "一杯烟霞蔽芾。茶浓些更好，有劳你了。"
                                }
                            ]
                        },
                        {
                            "id": "705070107",
                            "text": "可以边喝茶边聊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050705",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050704",
            "objective": "与钟离对话",
            "dialogues": []
        },
        {
            "id": "7050702",
            "objective": "为钟离调制指定饮品",
            "dialogues": [
                {
                    "id": "705070201",
                    "speaker": "派蒙",
                    "text": "久等啦！"
                },
                {
                    "id": "705070202",
                    "speaker": "Player",
                    "text": "请慢用。"
                },
                {
                    "id": "705070203",
                    "speaker": "钟离",
                    "text": "茶汤透亮，色泽宜人，入口甘醇，更伴有花果香。嗯，相当难得。"
                },
                {
                    "id": "705070204",
                    "speaker": "派蒙",
                    "text": "哇，钟离在喝茶方面也是行家呀。"
                },
                {
                    "id": "705070205",
                    "speaker": "派蒙",
                    "text": "像我「咕嘟」一口就喝下去了，只能说出好喝两个字。"
                },
                {
                    "id": "705070206",
                    "speaker": "钟离",
                    "text": "用心品尝，是对沏茶者的敬意。"
                },
                {
                    "id": "705070207",
                    "speaker": "钟离",
                    "text": "好茶十分难得，能将好茶泡得怡景怡情的沏茶者，更是难得。",
                    "choices": [
                        {
                            "id": "705070208",
                            "text": "谬赞了…",
                            "response": [
                                {
                                    "id": "705070210",
                                    "speaker": "派蒙",
                                    "text": "好吧，我明白了。"
                                },
                                {
                                    "id": "705070211",
                                    "speaker": "派蒙",
                                    "text": "那…教教我你是怎么品茶的吧。我看是先闻再喝，对吗？"
                                },
                                {
                                    "id": "705070212",
                                    "speaker": "钟离",
                                    "text": "不错。"
                                },
                                {
                                    "id": "705070213",
                                    "speaker": "钟离",
                                    "text": "茶叶各有特征，喝得多了，自然有些心得。茶品好坏，闻香味便可略知一二了。"
                                },
                                {
                                    "id": "705070214",
                                    "speaker": "钟离",
                                    "text": "有些茶闻起来湿腻，焦香过重，应是次品。另有一些，闻起来甘醇典雅，幽香扑面，这类茶多为上品。"
                                },
                                {
                                    "id": "705070215",
                                    "speaker": "钟离",
                                    "text": "若想再讲究些，按璃月古时传统，还应备上「品香盏」。这件器皿能盛放茶汤，专用于品香。"
                                },
                                {
                                    "id": "705070216",
                                    "speaker": "派蒙",
                                    "text": "怎么办，感觉我之前都亏了…"
                                },
                                {
                                    "id": "705070217",
                                    "speaker": "钟离",
                                    "text": "无妨。学问甚多，何时开始都不算迟。"
                                },
                                {
                                    "id": "705070218",
                                    "speaker": "钟离",
                                    "text": "初学者可以试着这样品鉴：先观察水色，再轻嗅茶香，最后才是品茗。"
                                },
                                {
                                    "id": "705070219",
                                    "speaker": "钟离",
                                    "text": "「由浅入深」，对万事万物的掌握皆是如此。",
                                    "choices": [
                                        {
                                            "id": "705070220",
                                            "text": "收获不小…",
                                            "response": [
                                                {
                                                    "id": "705070222",
                                                    "speaker": "钟离",
                                                    "text": "璃月西北的「翘英庄」，以茶业闻名。日后若有机会，不妨前去看看。"
                                                },
                                                {
                                                    "id": "705070223",
                                                    "speaker": "钟离",
                                                    "text": "今日所说种种，大多是我这个老派璃月人的习惯。"
                                                },
                                                {
                                                    "id": "705070224",
                                                    "speaker": "钟离",
                                                    "text": "各地饮茶习惯与茶文化均有不同。身处不同国度，理应尊重当地风俗。"
                                                },
                                                {
                                                    "id": "705070225",
                                                    "speaker": "派蒙",
                                                    "text": "我完全理解了！但能不能记住就…"
                                                },
                                                {
                                                    "id": "705070226",
                                                    "speaker": "Player",
                                                    "text": "意料之中…"
                                                },
                                                {
                                                    "id": "705070227",
                                                    "speaker": "钟离",
                                                    "text": "#{NICKNAME}，今日多谢你了。有幸喝到这等好茶，不虚此行。"
                                                },
                                                {
                                                    "id": "705070228",
                                                    "speaker": "钟离",
                                                    "text": "他日你若坐镇茶馆，我定来捧场。"
                                                },
                                                {
                                                    "id": "705070229",
                                                    "speaker": "派蒙",
                                                    "text": "但我们很忙，大概没有时间去茶馆打零工吧…"
                                                },
                                                {
                                                    "id": "705070230",
                                                    "speaker": "Player",
                                                    "text": "谁知道呢。"
                                                },
                                                {
                                                    "id": "705070231",
                                                    "speaker": "钟离",
                                                    "text": "总之，如有机会，我一定支持。"
                                                },
                                                {
                                                    "id": "705070232",
                                                    "speaker": "钟离",
                                                    "text": "今天就到这里吧。不多叨扰了，祝你工作顺利。",
                                                    "choices": [
                                                        {
                                                            "id": "705070233",
                                                            "text": "嗯，慢走。",
                                                            "response": [
                                                                {
                                                                    "id": "705070235",
                                                                    "speaker": "钟离",
                                                                    "text": "嗯，开销就按习惯，记在往生堂账上吧。"
                                                                },
                                                                {
                                                                    "id": "705070236",
                                                                    "speaker": "派蒙",
                                                                    "text": "慢走慢走，代我们跟堂主问好！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705070234",
                                                            "text": "那个，结账的事…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705070221",
                                            "text": "还想学更多…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705070209",
                            "text": "有些不好意思…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050703",
            "objective": "将饮品交给钟离",
            "dialogues": []
        },
        {
            "id": "7050799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705079901",
                    "speaker": "派蒙",
                    "text": "好像不是对方想要的饮品…再重做一杯吧，这杯我来解决！"
                }
            ]
        }
    ]
}