    "talks": [
        {
            "id": "7152701",
            "objective": "(test)斗虫二期-烟绯关卡$HIDDEN",
            "dialogues": [
                {
                    "id": "716664001",
                    "speaker": "「装备碾压型选手」",
                    "text": "嘿呀！我来啦！让我看看，「荒泷甲光烈烈斗虫大修行」进行到什么程度了…"
                },
                {
                    "id": "716664002",
                    "speaker": "派蒙",
                    "text": "你来得正好，烟绯！"
                },
                {
                    "id": "716664003",
                    "speaker": "荒泷一斗",
                    "text": "大恩人！感谢你帮忙搞定申办活动的事，还有那幅超帅的宣传画！"
                },
                {
                    "id": "716664004",
                    "speaker": "荒泷一斗",
                    "text": "不过，看你这架势…难不成，是要亲自来斗上两局？"
                },
                {
                    "id": "716664005",
                    "speaker": "「装备碾压型选手」",
                    "text": "咦？不可以吗？"
                },
                {
                    "id": "716664006",
                    "speaker": "「装备碾压型选手」",
                    "text": "我有个经常跑海外贸易的大客户，有次我帮她打赢了一场大官司，她送了我好多好多礼物，其中就有特别的鬼兜虫。"
                },
                {
                    "id": "716664007",
                    "speaker": "「装备碾压型选手」",
                    "text": "当时我不知道怎么饲养这种动物，就拜托姥姥帮我照看了一段时间，现在看来，这只鬼兜虫还挺健壮的…"
                },
                {
                    "id": "716664008",
                    "speaker": "「装备碾压型选手」",
                    "text": "参加斗虫比赛的话，应该不会让大家扫兴吧？"
                },
                {
                    "id": "716664009",
                    "speaker": "「花角玉将」",
                    "text": "切勿轻视了恩人姐姐，鬼王，她没有斗虫的经验，但她将派出最令人惊异、最健壮的鬼兜虫。"
                },
                {
                    "id": "716664010",
                    "speaker": "荒泷一斗",
                    "text": "居然是这样！"
                },
                {
                    "id": "716664011",
                    "speaker": "荒泷一斗",
                    "text": "那还是让「鬼王的左膀右臂」指挥「赤红一杵」上阵好了，我的挚友无论遇上什么对手，都无比镇定！",
                    "choices": [
                        {
                            "id": "716664012",
                            "text": "没错没错！",
                            "response": [
                                {
                                    "id": "716664014",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "#要由{NICKNAME}来和我玩一局吗？好呀！"
                                },
                                {
                                    "id": "716664015",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "我还没有找到这种游戏的诀窍，如果我指挥得不好，还请见谅啦~"
                                }
                            ]
                        },
                        {
                            "id": "716664013",
                            "text": "谢谢夸奖！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7152702",
            "objective": "(test)挑战烟绯$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7152703",
            "objective": "(test)成功挑战一次烟绯$HIDDEN",
            "dialogues": [
                {
                    "id": "716664101",
                    "speaker": "派蒙",
                    "text": "烟绯的鬼兜虫好强！该说不愧是萍姥姥照料过的特别鬼兜虫吗…"
                },
                {
                    "id": "716664102",
                    "speaker": "「花角玉将」",
                    "text": "你看，恩人姐姐的鬼兜虫不好惹吧？"
                },
                {
                    "id": "716664103",
                    "speaker": "「花角玉将」",
                    "text": "就像之前，我的一些部将也给你造成了不少困扰，有时「装备」和「伙伴」的性能差距，很难用指挥弥补。"
                },
                {
                    "id": "716664104",
                    "speaker": "荒泷一斗",
                    "text": "确确确确…确实…嗯呃咳…还好我的挚友顶住了！"
                },
                {
                    "id": "716664105",
                    "speaker": "「装备碾压型选手」",
                    "text": "原来如此，原来如此！我好像找到斗虫的乐趣了…"
                },
                {
                    "id": "716664106",
                    "speaker": "「装备碾压型选手」",
                    "text": "#我很开心！{NICKNAME}，一斗先生，还有「花角玉将」！接下来，我还想在这里继续玩玩这个游戏！"
                }
            ]
        }
    ]
}