    "talks": [
        {
            "id": "7212001",
            "objective": "（test）隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "721200101",
                    "speaker": "泽维尔",
                    "text": "很好！上次的试验很顺利，「鬼兜虫」上的「祟神」被干净利落地净化了。"
                },
                {
                    "id": "721200102",
                    "speaker": "Player",
                    "text": "那我们现在…"
                },
                {
                    "id": "721200103",
                    "speaker": "泽维尔",
                    "text": "我们现在只需要规划好前进路线，就可以正式开工了。但这条路线必须得绕开那些愚人众才行…看来得绕点远路了…"
                },
                {
                    "id": "721200104",
                    "speaker": "泽维尔",
                    "text": "毕竟这家伙…还挺大的，我们两个人想要把它搬进去的话，可先得保证运送道路的通畅才行。"
                },
                {
                    "id": "721200105",
                    "speaker": "泽维尔",
                    "text": "所以，我想拜托您再去「御影炉心」附近调查一下，如果遇见坏掉的道路，最好能稍微维修一下。"
                },
                {
                    "id": "721200106",
                    "speaker": "泽维尔",
                    "text": "虽然我还没规划好路线…但我们最好能保证大部分道路都是通畅的。"
                },
                {
                    "id": "721200107",
                    "speaker": "Player",
                    "text": "我可不会修路。"
                },
                {
                    "id": "721200108",
                    "speaker": "泽维尔",
                    "text": "不用修得特别…可靠，只需要在上面铺一层木板，让我们能搬着这伙计过去就行。"
                },
                {
                    "id": "721200109",
                    "speaker": "泽维尔",
                    "text": "啊，您可以先去旁边拿点木板。我在这里继续摆弄这家伙，尽量让它更可靠点。"
                }
            ]
        },
        {
            "id": "7212002",
            "objective": "与泽维尔对话",
            "dialogues": []
        },
        {
            "id": "7212003",
            "objective": "取得木板",
            "dialogues": [
                {
                    "id": "721200301",
                    "speaker": "泽维尔",
                    "text": "怎么样？您把道路都检查过了吗？"
                },
                {
                    "id": "721200302",
                    "speaker": "Player",
                    "text": "道路已经很通畅了。"
                },
                {
                    "id": "721200303",
                    "speaker": "泽维尔",
                    "text": "好。那、那我们过段时间就出发…"
                },
                {
                    "id": "721200304",
                    "speaker": "Player",
                    "text": "你是在…"
                },
                {
                    "id": "721200305",
                    "speaker": "泽维尔",
                    "text": "我是在…思考！思考可能发生的各种情况，您明白吗？"
                },
                {
                    "id": "721200306",
                    "speaker": "泽维尔",
                    "text": "比如进去的时候，发现核心已经被那群疯子掏出来。"
                },
                {
                    "id": "721200307",
                    "speaker": "泽维尔",
                    "text": "然后那群疯子还把核心塞进了遗迹守卫里，然后这个遗迹守卫失去控制，把我们全都打飞。"
                },
                {
                    "id": "721200308",
                    "speaker": "泽维尔",
                    "text": "或者是我们在净化「御影炉心」的时候，突然蹦出来一个什么元素生物，一口气把核心吃下去。"
                },
                {
                    "id": "721200309",
                    "speaker": "泽维尔",
                    "text": "最、最糟糕的就是，要是那个传说中的大蛇借此复活，那我们可就彻底完蛋了！",
                    "choices": [
                        {
                            "id": "721200310",
                            "text": "你冷静一点…",
                            "response": [
                                {
                                    "id": "721200312",
                                    "speaker": "泽维尔",
                                    "text": "呃…唔，抱歉，我老毛病又犯了，每次都会不由自主地把事情往最坏的那方面想…"
                                },
                                {
                                    "id": "721200313",
                                    "speaker": "泽维尔",
                                    "text": "我会好好做一份计划，等时候到了，我们就正式出发去搞定这件事。"
                                },
                                {
                                    "id": "721200314",
                                    "speaker": "泽维尔",
                                    "text": "希望一切顺利，希望一切顺利，希望一切顺利…"
                                }
                            ]
                        },
                        {
                            "id": "721200311",
                            "text": "应该不会那么夸张…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212004",
            "objective": "调查并修复道路",
            "dialogues": [
                {
                    "id": "721200401",
                    "speaker": "泽维尔",
                    "text": "这些「鬼兜虫」应该就够用了，谢谢您，我等会就开始试验。"
                }
            ]
        },
        {
            "id": "7212005",
            "objective": "调查并修复道路",
            "dialogues": []
        },
        {
            "id": "7212006",
            "objective": "调查并修复道路",
            "dialogues": []
        },
        {
            "id": "7212009",
            "objective": "向泽维尔回报",
            "dialogues": []
        },
        {
            "id": "7212002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721200201",
                    "speaker": "泽维尔",
                    "text": "希望一切顺利，让这档子事快点结束吧，再拖下去指不定会变成什么样…"
                }
            ]
        }
    ]
