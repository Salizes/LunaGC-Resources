    "talks": [
        {
            "id": "7105106",
            "objective": "隐藏判断钓鱼是否进包$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7105101",
            "objective": "将钓起的奇怪物件交给海迪夫鉴定$HIDDEN",
            "dialogues": [
                {
                    "id": "710500501",
                    "speaker": "Player",
                    "text": "关于奇怪的物件…"
                },
                {
                    "id": "710500502",
                    "speaker": "海迪夫",
                    "text": "嗯？这是你钓鱼钓到的，钓鱼？唔…这东西粗看起来倒像是我们钓鱼用的鱼饵。"
                },
                {
                    "id": "710500503",
                    "speaker": "海迪夫",
                    "text": "钓鱼是能钓出这种东西的活动吗…？阿妮萨学姐在海祇岛也天天钓鱼，没见到她钓出什么成果来啊。"
                },
                {
                    "id": "710500504",
                    "speaker": "海迪夫",
                    "text": "该说不愧是你吗？"
                },
                {
                    "id": "710500505",
                    "speaker": "海迪夫",
                    "text": "我看看，这个东西…能够感受到它有很可怕的水元素含量。"
                },
                {
                    "id": "710500506",
                    "speaker": "海迪夫",
                    "text": "层岩巨渊的地下水中，富含的元素量之多，确实有点不太正常…难道是因为有这些东西在地下水里生长的缘故吗？"
                },
                {
                    "id": "710500507",
                    "speaker": "海迪夫",
                    "text": "不过这个东西从水里拿出来以后，元素就在不断流失，说不定必须得放在水边才会有产生效果。"
                },
                {
                    "id": "710500508",
                    "speaker": "Player",
                    "text": "放在水边？"
                },
                {
                    "id": "710500509",
                    "speaker": "海迪夫",
                    "text": "放到水边，用水元素激活，大概就能知道这东西是什么作用了。"
                },
                {
                    "id": "710500510",
                    "speaker": "海迪夫",
                    "text": "这样吧，你去激活它，反正东西也是你钓上来的，发生什么事就告诉我吧。"
                },
                {
                    "id": "710500511",
                    "speaker": "海迪夫",
                    "text": "要是有什么研究价值的话，我会支付你报酬的。"
                }
            ]
        },
        {
            "id": "7105102",
            "objective": "将奇怪物件放至水边",
            "dialogues": []
        },
        {
            "id": "7105105",
            "objective": "利用水元素反应激活奇怪物件",
            "dialogues": []
        },
        {
            "id": "7105103",
            "objective": "击败出现的水岩龙蜥",
            "dialogues": []
        },
        {
            "id": "7105104",
            "objective": "告诉海迪夫在水边发生的事",
            "dialogues": [
                {
                    "id": "710500801",
                    "speaker": "Player",
                    "text": "关于放在水边的奇怪物件…"
                },
                {
                    "id": "710500802",
                    "speaker": "海迪夫",
                    "text": "嗯？你把那个东西放在水边了…"
                },
                {
                    "id": "710500803",
                    "speaker": "海迪夫",
                    "text": "怎么样，有发生什么特殊反应之类的吗？"
                },
                {
                    "id": "710500804",
                    "speaker": "Player",
                    "text": "出现了岩龙蜥…"
                },
                {
                    "id": "710500805",
                    "speaker": "海迪夫",
                    "text": "岩龙蜥？那个东西放到水里变成了岩龙蜥？"
                },
                {
                    "id": "710500806",
                    "speaker": "海迪夫",
                    "text": "哦，不是那个东西变成的，而是岩龙蜥看到那个东西之后就游出来了…"
                },
                {
                    "id": "710500807",
                    "speaker": "海迪夫",
                    "text": "吓了我一跳，要是这个东西入水直接变成岩龙蜥，那我的世界观的立柱都要崩塌了。"
                },
                {
                    "id": "710500808",
                    "speaker": "Player",
                    "text": "那个东西到底是…"
                },
                {
                    "id": "710500809",
                    "speaker": "海迪夫",
                    "text": "说来也简单，该怎么说明好呢，这样吧，让我先猜一猜，那只岩龙蜥，有没有什么特别之处…"
                },
                {
                    "id": "710500810",
                    "speaker": "海迪夫",
                    "text": "比如说，元素附着属性是水之类的？",
                    "choices": [
                        {
                            "id": "710500811",
                            "text": "好像是这样的…",
                            "response": [
                                {
                                    "id": "710500812",
                                    "speaker": "海迪夫",
                                    "text": "那就对了。"
                                },
                                {
                                    "id": "710500816",
                                    "speaker": "海迪夫",
                                    "text": "那只岩龙蜥应该可以调用水元素。"
                                },
                                {
                                    "id": "710500817",
                                    "speaker": "海迪夫",
                                    "text": "层岩巨渊的地下水，水元素含量很高，特殊的聚集点就会养出类似你钓上来的水草一样的事物。"
                                },
                                {
                                    "id": "710500818",
                                    "speaker": "海迪夫",
                                    "text": "岩龙蜥，当然了，其他生长在层岩巨渊的亲水生物也一样，靠食用这种富含水元素的水草来提升自己的力量。"
                                },
                                {
                                    "id": "710500819",
                                    "speaker": "海迪夫",
                                    "text": "所以那个东西其实就是…富含水元素的水草！"
                                },
                                {
                                    "id": "710500820",
                                    "speaker": "Player",
                                    "text": "只是水草吗…"
                                },
                                {
                                    "id": "710500821",
                                    "speaker": "海迪夫",
                                    "text": "嗯，就是水草，不过富有如此元素量的水草…"
                                },
                                {
                                    "id": "710500822",
                                    "speaker": "海迪夫",
                                    "text": "正常环境可长不出来，除非有什么非常纯净又巨大的能量影响了水源…不说这个了，这些水草…"
                                },
                                {
                                    "id": "710500823",
                                    "speaker": "海迪夫",
                                    "text": "说不定有一天也会生出意识变成元素生物，真是值得好好研究一番啊。"
                                }
                            ]
                        },
                        {
                            "id": "710500813",
                            "text": "没看见…",
                            "response": [
                                {
                                    "id": "710500814",
                                    "speaker": "海迪夫",
                                    "text": "#难道是因为解决得太快了所以根本没在意到吗…真是厉害啊，不愧是传说中的{NICKNAME}。"
                                },
                                {
                                    "id": "710500815",
                                    "speaker": "海迪夫",
                                    "text": "不过根据我的推测…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}