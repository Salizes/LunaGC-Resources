    "talks": [
        {
            "id": "1303501",
            "objective": "返回须弥看看",
            "dialogues": [
                {
                    "id": "130350101",
                    "speaker": "赛诺",
                    "text": "看到了吗，那个手舞足蹈的老爷子。"
                },
                {
                    "id": "130350102",
                    "speaker": "派蒙",
                    "text": "哦！那就是案件的当事人吗？"
                },
                {
                    "id": "130350103",
                    "speaker": "赛诺",
                    "text": "嗯。是我和丽莎师姐的老师，前任素论派贤者居勒什。"
                },
                {
                    "id": "130350104",
                    "speaker": "派蒙",
                    "text": "欸？！居然是赛诺的老师遇到麻烦？"
                },
                {
                    "id": "130350105",
                    "speaker": "居勒什",
                    "text": "真是的，我一个老头子除了照顾照顾花园就是喝喝酒逛逛街，怎么会有人想找我的麻烦！"
                },
                {
                    "id": "130350106",
                    "speaker": "赛诺",
                    "text": "老师，我带朋友来了。"
                },
                {
                    "id": "130350107",
                    "speaker": "居勒什",
                    "text": "噢赛诺，这两位是…"
                },
                {
                    "id": "130350108",
                    "speaker": "居勒什",
                    "text": "嗯？等一下，我想想…会飞的白色精灵，还有这位，看打扮是异乡人。"
                },
                {
                    "id": "130350109",
                    "speaker": "居勒什",
                    "text": "是传说中的旅行者和派蒙吧，久仰了，听说你们帮了须弥很多。"
                },
                {
                    "id": "130350110",
                    "speaker": "派蒙",
                    "text": "我们这么有名呀？"
                },
                {
                    "id": "130350111",
                    "speaker": "赛诺",
                    "text": "跟老师介绍朋友，很正常吧。"
                },
                {
                    "id": "130350112",
                    "speaker": "Player",
                    "text": "您好，我们是来帮赛诺忙的。"
                },
                {
                    "id": "130350113",
                    "speaker": "赛诺",
                    "text": "是的。我简单说一下案件情况。"
                },
                {
                    "id": "130350114",
                    "speaker": "赛诺",
                    "text": "大概是两天前，老师突然收到了一封恐吓信。"
                },
                {
                    "id": "130350115",
                    "speaker": "派蒙",
                    "text": "恐吓信？！"
                },
                {
                    "id": "130350116",
                    "speaker": "居勒什",
                    "text": "对啊，怎么会有人给老头子寄恐吓信呢？"
                },
                {
                    "id": "130350117",
                    "speaker": "赛诺",
                    "text": "这就是当时的那封信。"
                },
                {
                    "id": "130350118",
                    "speaker": "派蒙",
                    "text": "「居勒什，我已经掌握了你的秘密，如果不想被揭发就准备一千万摩拉放到咖啡馆后门。」"
                },
                {
                    "id": "130350119",
                    "speaker": "派蒙",
                    "text": "「另外，别想找到我，你不可能知道我在哪里，而我监视着你和你所有的秘密。敢报告风纪官就等着瞧吧。」"
                },
                {
                    "id": "130350120",
                    "speaker": "派蒙",
                    "text": "好直白的恐吓信啊…"
                },
                {
                    "id": "130350121",
                    "speaker": "赛诺",
                    "text": "看得出太想要钱了。"
                },
                {
                    "id": "130350122",
                    "speaker": "居勒什",
                    "text": "一千万摩拉！开什么玩笑！"
                },
                {
                    "id": "130350123",
                    "speaker": "居勒什",
                    "text": "我一个单身老头，每天就跟番茄一起生活，问我要一千万，我跟谁要去！番茄吗？"
                },
                {
                    "id": "130350124",
                    "speaker": "赛诺",
                    "text": "#目前的线索就只有这封信，没有目击证人。所以，{NICKNAME}，派蒙，一起来想想吧。"
                },
                {
                    "id": "130350125",
                    "speaker": "Player",
                    "text": "随时可以开始！"
                },
                {
                    "id": "130350126",
                    "speaker": "派蒙",
                    "text": "我也准备好了！"
                },
                {
                    "id": "130350127",
                    "speaker": "赛诺",
                    "text": "你们先看看，哪里可疑？"
                },
                {
                    "id": "130350128",
                    "speaker": "Player",
                    "text": "（唔…）"
                },
                {
                    "id": "130350129",
                    "speaker": "Player",
                    "text": "（从刚才的描述来看，恐吓信没有信封，犯人把恐吓信息写在质地有些粗糙的纸上，将它摆到居勒什所在处。）",
                    "choices": [
                        {
                            "id": "130350130",
                            "text": "纸张？",
                            "response": [
                                {
                                    "id": "130350131",
                                    "speaker": "赛诺",
                                    "text": "非常敏锐。这种纸摸上去比较粗糙，并不是常见的书本用纸张。"
                                },
                                {
                                    "id": "130350132",
                                    "speaker": "派蒙",
                                    "text": "还有你看，这些笔画都有点洇开了…是墨水的问题吗？"
                                },
                                {
                                    "id": "130350133",
                                    "speaker": "赛诺",
                                    "text": "有墨水的因素，也有纸张本身的原因。"
                                },
                                {
                                    "id": "130350138",
                                    "speaker": "居勒什",
                                    "text": "附近能找到的纸大部分比这种来得平整，墨水沾上去也不会化得这么开。纸的纹理很不细腻…难道制作时放了草料？"
                                },
                                {
                                    "id": "130350139",
                                    "speaker": "赛诺",
                                    "text": "这不是教令院里的纸。墨水反而没那么稀奇，就是城里随处可见的那种。黑墨写在纸上会有一点泛蓝。"
                                },
                                {
                                    "id": "130350140",
                                    "speaker": "派蒙",
                                    "text": "那犯人到底跟教令院有没有关系呢？"
                                },
                                {
                                    "id": "130350141",
                                    "speaker": "派蒙",
                                    "text": "啊！你们看这里，是沾到什么液体了吧？"
                                },
                                {
                                    "id": "130350142",
                                    "speaker": "赛诺",
                                    "text": "比起水，更像是沾到了有色液体，又用湿布清理过。"
                                },
                                {
                                    "id": "130350143",
                                    "speaker": "派蒙",
                                    "text": "有颜色的液体…茶？酒？"
                                },
                                {
                                    "id": "130350144",
                                    "speaker": "赛诺",
                                    "text": "看来你们也联想到了。现在我们得找到阿拉夫，有些事需要他去办。"
                                }
                            ]
                        },
                        {
                            "id": "130350134",
                            "text": "墨水？",
                            "response": [
                                {
                                    "id": "130350135",
                                    "speaker": "赛诺",
                                    "text": "没错。一部分笔迹洇开了。"
                                },
                                {
                                    "id": "130350136",
                                    "speaker": "派蒙",
                                    "text": "是墨水质量不好吗？"
                                },
                                {
                                    "id": "130350137",
                                    "speaker": "赛诺",
                                    "text": "有墨水的因素，也有纸张本身的原因。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303506",
            "objective": "前往教令院",
            "dialogues": [
                {
                    "id": "130350501",
                    "speaker": "派蒙",
                    "text": "大白天教令院可热闹了！"
                },
                {
                    "id": "130350502",
                    "speaker": "派蒙",
                    "text": "唔…不过大家分别都在哪里呢…"
                },
                {
                    "id": "130350503",
                    "speaker": "赛诺",
                    "text": "#{NICKNAME}和派蒙？"
                },
                {
                    "id": "130350504",
                    "speaker": "派蒙",
                    "text": "赛诺？好久不见！",
                    "choices": [
                        {
                            "id": "130350505",
                            "text": "真的是好久不见了。",
                            "response": [
                                {
                                    "id": "130350506",
                                    "speaker": "赛诺",
                                    "text": "很高兴能在须弥城里遇到你们。"
                                },
                                {
                                    "id": "130350509",
                                    "speaker": "赛诺",
                                    "text": "什么风把你们吹回来了？"
                                },
                                {
                                    "id": "130350510",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，也没有啦。其实是我走在路上看见一颗大蘑菇，突然想起来很久没见须弥的朋友，就过来啦。"
                                },
                                {
                                    "id": "130350511",
                                    "speaker": "赛诺",
                                    "text": "最近聚餐大家也说起你们了。一见面我就知道，你们又在旅途中收获了不少。"
                                },
                                {
                                    "id": "130350512",
                                    "speaker": "派蒙",
                                    "text": "真的？想我们了吗？"
                                },
                                {
                                    "id": "130350513",
                                    "speaker": "赛诺",
                                    "text": "嗯，真是巧合。"
                                },
                                {
                                    "id": "130350514",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "130350515",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "130350516",
                                    "speaker": "赛诺",
                                    "text": "难道你们认为我会说出禁忌的后半句吗？哈，「就像桥的底下总有河」。"
                                },
                                {
                                    "id": "130350517",
                                    "speaker": "派蒙",
                                    "text": "啊他还是说出来了呀！"
                                },
                                {
                                    "id": "130350518",
                                    "speaker": "Player",
                                    "text": "派蒙赌输了，拿钱来！"
                                },
                                {
                                    "id": "130350519",
                                    "speaker": "赛诺",
                                    "text": "老笑话记得这么牢，看来你们很喜欢。承认吧！其实早就屈服在我优秀的笑话之下了。"
                                },
                                {
                                    "id": "130350520",
                                    "speaker": "派蒙",
                                    "text": "好啦好啦，这是五百摩拉，拿去…",
                                    "choices": [
                                        {
                                            "id": "130350521",
                                            "text": "谢啦赛诺。赚大了。",
                                            "response": [
                                                {
                                                    "id": "130350522",
                                                    "speaker": "赛诺",
                                                    "text": "瞧你这话说的，才五百摩拉。"
                                                },
                                                {
                                                    "id": "130350523",
                                                    "speaker": "派蒙",
                                                    "text": "我输五百摩拉还不够吗！"
                                                },
                                                {
                                                    "id": "130350524",
                                                    "speaker": "赛诺",
                                                    "text": "好吧，回头请你吃甜食。"
                                                },
                                                {
                                                    "id": "130350528",
                                                    "speaker": "赛诺",
                                                    "text": "言归正传，其实我现在正在去工作的路上。有事在身不方便进入休假模式，所以才没把刚才那个笑话说完。"
                                                },
                                                {
                                                    "id": "130350529",
                                                    "speaker": "派蒙",
                                                    "text": "唔？发生什么事了吗？"
                                                },
                                                {
                                                    "id": "130350530",
                                                    "speaker": "赛诺",
                                                    "text": "一件小案子，不过当事人身份比较特殊，我再三考虑还是决定自己来负责。"
                                                },
                                                {
                                                    "id": "130350531",
                                                    "speaker": "派蒙",
                                                    "text": "要帮忙吗？你看我们特地回来，也挺闲的，不如带上我们，结束以后正好一起…诶嘿嘿。"
                                                },
                                                {
                                                    "id": "130350532",
                                                    "speaker": "赛诺",
                                                    "text": "这么积极，难道是担心我爽约不请你吃好吃的？"
                                                },
                                                {
                                                    "id": "130350533",
                                                    "speaker": "派蒙",
                                                    "text": "呃啊不是啦！…好吧，很明显吗？"
                                                },
                                                {
                                                    "id": "130350534",
                                                    "speaker": "赛诺",
                                                    "text": "还行吧。主意倒是不错，跟你们这两位须弥的英雄一起工作也没问题。"
                                                },
                                                {
                                                    "id": "130350535",
                                                    "speaker": "赛诺",
                                                    "text": "跟我来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130350525",
                                            "text": "谢啦派蒙。赚大了。",
                                            "response": [
                                                {
                                                    "id": "130350526",
                                                    "speaker": "派蒙",
                                                    "text": "下次不打赌了…还以为赛诺能忍住的…都说水会流，人会变，我看这话也不准。"
                                                },
                                                {
                                                    "id": "130350527",
                                                    "speaker": "赛诺",
                                                    "text": "这算我的责任？那好吧，我请你们吃甜食。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130350507",
                            "text": "你看起来精神不错呢。",
                            "response": [
                                {
                                    "id": "130350508",
                                    "speaker": "赛诺",
                                    "text": "你也是。旅行没有让你疲惫，而是变得更顽强了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303502",
            "objective": "跟随赛诺",
            "dialogues": []
        },
        {
            "id": "1303503",
            "objective": "寻找风纪官阿拉夫",
            "dialogues": [
                {
                    "id": "130350201",
                    "speaker": "居勒什",
                    "text": "阿拉夫，阿拉夫…噢，在那里。"
                },
                {
                    "id": "130350202",
                    "speaker": "阿拉夫",
                    "text": "#赛诺大人，居勒什大人。还有许久不见的{NICKNAME}和派蒙。"
                },
                {
                    "id": "130350203",
                    "speaker": "Black Screen",
                    "text": "赛诺将先前的情况告知阿拉夫…"
                },
                {
                    "id": "130350204",
                    "speaker": "赛诺",
                    "text": "关于老师的案子，我想犯人可能是来自教令院，年龄不会太大，手头拮据。"
                },
                {
                    "id": "130350205",
                    "speaker": "赛诺",
                    "text": "另外，还可以往须弥城的咖啡馆里查。"
                },
                {
                    "id": "130350206",
                    "speaker": "派蒙",
                    "text": "噢！原来是喝咖啡的时候把纸摊在旁边才弄脏的。"
                },
                {
                    "id": "130350207",
                    "speaker": "赛诺",
                    "text": "嗯，那种痕迹很像咖啡渍。"
                },
                {
                    "id": "130350208",
                    "speaker": "赛诺",
                    "text": "而且据我所知，酒馆和咖啡馆里都有这种纸，制作时混入香料，叠成一叠放在室内供客人书写用。"
                },
                {
                    "id": "130350209",
                    "speaker": "居勒什",
                    "text": "你这么一说，确实是礼品店里会卖的那种特殊纸张…萨赫哈蒂还买过一些，说是要拿来包装她买的花瓶什么的。"
                },
                {
                    "id": "130350210",
                    "speaker": "阿拉夫",
                    "text": "明白了，我马上带人去城里相关地区进行盘查。"
                },
                {
                    "id": "130350211",
                    "speaker": "居勒什",
                    "text": "辛苦你们了。"
                },
                {
                    "id": "130350212",
                    "speaker": "赛诺",
                    "text": "还有，调人把守住须弥城的出入口。你也换身便衣，避免打草惊蛇。"
                },
                {
                    "id": "130350213",
                    "speaker": "阿拉夫",
                    "text": "好。"
                },
                {
                    "id": "130350214",
                    "speaker": "派蒙",
                    "text": "还是赛诺周到呀！不过，犯人现在会在哪里呢？"
                },
                {
                    "id": "130350215",
                    "speaker": "Player",
                    "text": "应该不会一直留在咖啡馆里了吧。"
                },
                {
                    "id": "130350216",
                    "speaker": "派蒙",
                    "text": "对啊，说不定早就溜回家了，等居勒什有所行动，他再出来盯着…"
                },
                {
                    "id": "130350217",
                    "speaker": "赛诺",
                    "text": "你说对了，派蒙。"
                },
                {
                    "id": "130350218",
                    "speaker": "派蒙",
                    "text": "欸？什么对了？"
                },
                {
                    "id": "130350219",
                    "speaker": "赛诺",
                    "text": "犯人的态度。"
                },
                {
                    "id": "130350220",
                    "speaker": "赛诺",
                    "text": "像你说的，犯人写恐吓信的目的是钱，就算他写了不要告诉风纪官，老师也一定会有所行动。"
                },
                {
                    "id": "130350221",
                    "speaker": "赛诺",
                    "text": "他说他监视着老师和老师所有的秘密。"
                },
                {
                    "id": "130350222",
                    "speaker": "派蒙",
                    "text": "咦…可这样岂不是…"
                },
                {
                    "id": "130350223",
                    "speaker": "派蒙",
                    "text": "呜哇？！"
                },
                {
                    "id": "130350224",
                    "speaker": "赛诺",
                    "text": "找到了。"
                },
                {
                    "id": "130350225",
                    "speaker": "？？？",
                    "text": "呃啊！！你、你想干什么！！"
                },
                {
                    "id": "130350226",
                    "speaker": "赛诺",
                    "text": "写恐吓信的犯人就是你。"
                },
                {
                    "id": "130350227",
                    "speaker": "？？？",
                    "text": "我不知道你在说什么，什么恐吓信？"
                },
                {
                    "id": "130350228",
                    "speaker": "赛诺",
                    "text": "从我们进入智慧宫开始，我就感觉到有人暗中跟着。你虽然莽撞到给老师写这种信，却也小心地隐藏着自己。"
                },
                {
                    "id": "130350229",
                    "speaker": "赛诺",
                    "text": "这里人很多，所以我们来找阿拉夫。从里面到大门口，跟着移动的人里一定有监视老师的人。"
                },
                {
                    "id": "130350230",
                    "speaker": "？？？",
                    "text": "我、我只是听听你们在聊什么…大风纪官赛诺，你出现的地方一定有大事，我就想听听消息怎么了？"
                },
                {
                    "id": "130350231",
                    "speaker": "赛诺",
                    "text": "阿拉夫离开的时候你笑了，我看得很清楚。"
                },
                {
                    "id": "130350232",
                    "speaker": "？？？",
                    "text": "笑笑也犯法？！"
                },
                {
                    "id": "130350233",
                    "speaker": "赛诺",
                    "text": "纸上的脏污是咖啡渍，你用咖啡兑水轻轻沾在纸上，再用湿布把它擦掉，假装这封信写于咖啡馆。"
                },
                {
                    "id": "130350234",
                    "speaker": "赛诺",
                    "text": "封城对你毫无影响，你本就住在城里，锁定咖啡馆的话，风纪官就怀疑不到你头上。"
                },
                {
                    "id": "130350235",
                    "speaker": "赛诺",
                    "text": "从头到尾，咖啡馆就只是一个幌子，你一定在看得见老师的地方。"
                },
                {
                    "id": "130350236",
                    "speaker": "？？？",
                    "text": "这是栽赃，我什么都没做！"
                },
                {
                    "id": "130350237",
                    "speaker": "赛诺",
                    "text": "是吗？那你为什么浑身发抖？"
                },
                {
                    "id": "130350238",
                    "speaker": "赛诺",
                    "text": "没有犯下罪行的人，不必畏惧我们风纪官。而你…"
                },
                {
                    "id": "130350239",
                    "speaker": "赛诺",
                    "text": "心跳加速，眼皮抽动。你根本不擅长撒谎。"
                },
                {
                    "id": "130350240",
                    "speaker": "？？？",
                    "text": "…可恶！我才没…"
                },
                {
                    "id": "130350241",
                    "speaker": "赛诺",
                    "text": "别动，否则你会为自己的作为付出代价。现在，跟我走一趟。"
                },
                {
                    "id": "130350242",
                    "speaker": "派蒙",
                    "text": "结果那个名叫乌拉卡的人，就这么被抓到了呢…"
                },
                {
                    "id": "130350243",
                    "speaker": "居勒什",
                    "text": "是啊，我刚刚出去抽了口烟，看到阿拉夫也回来了，正往赛诺那边去呢。"
                },
                {
                    "id": "130350244",
                    "speaker": "居勒什",
                    "text": "唉…不过看那个人的样子，也就三十来岁。做出这种事，前途恐怕是毁了。"
                },
                {
                    "id": "130350245",
                    "speaker": "赛诺",
                    "text": "各位，已经有结果了。"
                },
                {
                    "id": "130350246",
                    "speaker": "派蒙",
                    "text": "这么快？！"
                },
                {
                    "id": "130350247",
                    "speaker": "赛诺",
                    "text": "犯人叫乌拉卡，是梨多梵谛学院的学生，现年十六岁。"
                },
                {
                    "id": "130350248",
                    "speaker": "居勒什",
                    "text": "啊？"
                },
                {
                    "id": "130350249",
                    "speaker": "派蒙",
                    "text": "十六岁？！居勒什刚才说他三十多…"
                },
                {
                    "id": "130350250",
                    "speaker": "赛诺",
                    "text": "已经查清了，确实是十六岁，入学才三年。"
                },
                {
                    "id": "130350251",
                    "speaker": "居勒什",
                    "text": "他长得也太着急了吧！"
                },
                {
                    "id": "130350252",
                    "speaker": "派蒙",
                    "text": "就是啊！"
                },
                {
                    "id": "130350253",
                    "speaker": "居勒什",
                    "text": "哎，这小子…小小年纪就做这种事，从哪学来的…"
                },
                {
                    "id": "130350254",
                    "speaker": "阿拉夫",
                    "text": "关于犯人的动机，我们也已经审问过。呃…"
                },
                {
                    "id": "130350255",
                    "speaker": "居勒什",
                    "text": "说吧，就算有什么事我也能承受。"
                },
                {
                    "id": "130350256",
                    "speaker": "阿拉夫",
                    "text": "好。我们了解到乌拉卡资质平平，成绩堪忧，最近这段时间他报名参加了补习班，又染上赌牌的恶癖，挥霍了许多钱。"
                },
                {
                    "id": "130350257",
                    "speaker": "阿拉夫",
                    "text": "乌拉卡到酒馆喝酒，听酒桌上的人聊到居勒什大人退休以来衣食无忧，成天为几株番茄与街头的老太太吵个不停…"
                },
                {
                    "id": "130350258",
                    "speaker": "居勒什",
                    "text": "街头的老太太？那是妙论派讲师萨赫哈蒂女士！他有没有上过学啊，连萨赫哈蒂都不知道？"
                },
                {
                    "id": "130350259",
                    "speaker": "赛诺",
                    "text": "这是重点吗？"
                },
                {
                    "id": "130350260",
                    "speaker": "居勒什",
                    "text": "哦对！什么叫为了几株番茄…再说，种点菜怎么就衣食无忧了呢？"
                },
                {
                    "id": "130350261",
                    "speaker": "赛诺",
                    "text": "可能老师看起来很闲吧。"
                },
                {
                    "id": "130350262",
                    "speaker": "阿拉夫",
                    "text": "乌拉卡提到，他听说居勒什大人退休前从沙漠里非法获得了一笔巨款，居勒什大人没有上报院里，而是私吞了。"
                },
                {
                    "id": "130350263",
                    "speaker": "阿拉夫",
                    "text": "乌拉卡认为居勒什大人这两年既没有跟新课题，也没有别的作为…既然居勒什大人老了，那他应该可以敲你一笔。"
                },
                {
                    "id": "130350264",
                    "speaker": "居勒什",
                    "text": "…这个乌拉卡，要气死我了。啊，我都不知道该从哪开始生气。"
                },
                {
                    "id": "130350265",
                    "speaker": "赛诺",
                    "text": "谣言这种东西谁都能编，我可以确定老师从没有任何贪污钱款的行径。"
                },
                {
                    "id": "130350266",
                    "speaker": "居勒什",
                    "text": "阿拉夫，一会儿你找个理由审乌拉卡几句，帮我揍他两拳。"
                },
                {
                    "id": "130350267",
                    "speaker": "阿拉夫",
                    "text": "非常理解您的心情，居勒什大人，不过您说的这种行为与风纪官原则相悖。"
                },
                {
                    "id": "130350268",
                    "speaker": "赛诺",
                    "text": "老师，别像小孩一样。"
                },
                {
                    "id": "130350269",
                    "speaker": "居勒什",
                    "text": "哎，我这不是开玩笑嘛。"
                },
                {
                    "id": "130350270",
                    "speaker": "派蒙",
                    "text": "所以这件事要怎么处理啊？"
                },
                {
                    "id": "130350271",
                    "speaker": "赛诺",
                    "text": "院里将对这名学生予以相应的处分。至于散播谣言污蔑老师沉迷番茄和街头老太太的人，风纪官会继续追查。"
                },
                {
                    "id": "130350272",
                    "speaker": "居勒什",
                    "text": "没有街头老太太！别胡说八道。"
                },
                {
                    "id": "130350273",
                    "speaker": "居勒什",
                    "text": "看你一脸不理解的样子，哈哈，还没想明白吗？"
                },
                {
                    "id": "130350274",
                    "speaker": "居勒什",
                    "text": "乌拉卡年纪小，听信谣言一时冲动犯下错误，再说我也没真拿出一千万给他，事态并不严重。"
                },
                {
                    "id": "130350275",
                    "speaker": "居勒什",
                    "text": "要说损害了什么，大概也就是老头子我的名誉吧。"
                },
                {
                    "id": "130350276",
                    "speaker": "赛诺",
                    "text": "老师，院里一定会给出公正合理的处分，请放心。"
                },
                {
                    "id": "130350277",
                    "speaker": "居勒什",
                    "text": "嗯，我相信院里。"
                },
                {
                    "id": "130350278",
                    "speaker": "居勒什",
                    "text": "不过我一个当过老师的人，还是想找他父母谈谈。这小子家在须弥城内吧？"
                },
                {
                    "id": "130350279",
                    "speaker": "赛诺",
                    "text": "在。"
                },
                {
                    "id": "130350280",
                    "speaker": "阿拉夫",
                    "text": "我们也调查了乌拉卡家的情况，他父母都是商人，从他小时候就很繁忙，对子女疏于管教。"
                },
                {
                    "id": "130350281",
                    "speaker": "居勒什",
                    "text": "哎，都是什么事啊…"
                },
                {
                    "id": "130350282",
                    "speaker": "居勒什",
                    "text": "还不到封存证据的时候对吧？那封信原件借我一下，晚上我拿着物证去找他家人好好聊聊。"
                },
                {
                    "id": "130350283",
                    "speaker": "居勒什",
                    "text": "必须得让他们意识到问题的严重性！"
                },
                {
                    "id": "130350284",
                    "speaker": "阿拉夫",
                    "text": "相关部门的人看过证据了，对乌拉卡的处分也已经开始商讨。这封信先给您，两天内归还即可。"
                },
                {
                    "id": "130350285",
                    "speaker": "居勒什",
                    "text": "噢！意思是两天就能结案啦？"
                },
                {
                    "id": "130350286",
                    "speaker": "赛诺",
                    "text": "差不多。这种事情处理起来还是很快的。"
                },
                {
                    "id": "130350287",
                    "speaker": "居勒什",
                    "text": "好。那各位，为了感谢你们，我们去吃个饭吧，我请客。"
                },
                {
                    "id": "130350288",
                    "speaker": "阿拉夫",
                    "text": "抱歉，我稍后还有事。各位请好好享受。"
                },
                {
                    "id": "130350289",
                    "speaker": "居勒什",
                    "text": "这样啊，好吧。但赛诺得来，这次多亏了你才能飞快抓到犯人。"
                },
                {
                    "id": "130350290",
                    "speaker": "居勒什",
                    "text": "哦对，提纳里也在教令院吧？带上带上。"
                },
                {
                    "id": "130350291",
                    "speaker": "派蒙",
                    "text": "提纳里也在呀？"
                },
                {
                    "id": "130350292",
                    "speaker": "赛诺",
                    "text": "最近提纳里的导师纳菲斯先生喊他和柯莱到院里帮忙，这个时间他们俩应该在贤者办公室。"
                },
                {
                    "id": "130350293",
                    "speaker": "赛诺",
                    "text": "老师居然要请提纳里一起吃饭，该不会是得罪了纳菲斯先生吧？"
                },
                {
                    "id": "130350294",
                    "speaker": "居勒什",
                    "text": "什么话，只有纳菲斯得罪我的份，不可能反过来。"
                },
                {
                    "id": "130350295",
                    "speaker": "居勒什",
                    "text": "#行了，赶紧去喊人，我和{NICKNAME}，派蒙一起到店里等你。"
                },
                {
                    "id": "130350296",
                    "speaker": "居勒什",
                    "text": "别让大家等太久了。"
                }
            ]
        },
        {
            "id": "1303504",
            "objective": "前往兰巴德酒馆二楼",
            "dialogues": [
                {
                    "id": "130350301",
                    "speaker": "居勒什",
                    "text": "不是自吹自擂，我在任的时候梨多梵谛学院可没出过这种事，不信你问他们。"
                },
                {
                    "id": "130350302",
                    "speaker": "居勒什",
                    "text": "当年在读的教令院学生都可以作证，对吧？"
                },
                {
                    "id": "130350303",
                    "speaker": "提纳里",
                    "text": "那几年老师布置给我的任务可多了，一周至少四天钻在树林里，尾巴毛都乱得不行了…就没怎么关心那些。"
                },
                {
                    "id": "130350304",
                    "speaker": "提纳里",
                    "text": "很多事都是后来听赛诺说的。"
                },
                {
                    "id": "130350305",
                    "speaker": "赛诺",
                    "text": "老师退休以后变得随和了很多，以前较真，体现在工作上就是刚正不阿。"
                },
                {
                    "id": "130350306",
                    "speaker": "柯莱",
                    "text": "哇…能坚持做一个正直的人已经很厉害了，还是贤者…"
                },
                {
                    "id": "130350307",
                    "speaker": "居勒什",
                    "text": "可惜那会儿柯莱没来念书，不然也可以当我的学生喽。"
                },
                {
                    "id": "130350308",
                    "speaker": "赛诺",
                    "text": "那柯莱也要叫丽莎师姐了…"
                },
                {
                    "id": "130350309",
                    "speaker": "派蒙",
                    "text": "直接叫丽莎姐姐也不错吧？丽莎很喜欢别人叫她姐姐的呢。"
                },
                {
                    "id": "130350310",
                    "speaker": "居勒什",
                    "text": "丽莎那孩子，学生时代听到别人叫她学姐就开心得很。"
                },
                {
                    "id": "130350311",
                    "speaker": "派蒙",
                    "text": "啊！又有菜送来了！点这么多真的没关系吗？"
                },
                {
                    "id": "130350312",
                    "speaker": "居勒什",
                    "text": "哈哈哈，客气什么，想吃就点，不够再加！今天的事，实在是多谢各位喽。"
                },
                {
                    "id": "130350313",
                    "speaker": "卡维",
                    "text": "果然是你们几位。啊，居勒什先生也在。"
                },
                {
                    "id": "130350314",
                    "speaker": "居勒什",
                    "text": "噢，卡维！好久不见，上个月还听萨赫哈蒂提起过你呢，最近还好吧？"
                },
                {
                    "id": "130350315",
                    "speaker": "卡维",
                    "text": "还不错，您看着也很有精神，真是太好了。"
                },
                {
                    "id": "130350316",
                    "speaker": "居勒什",
                    "text": "吃过饭了吗？要不要一起？"
                },
                {
                    "id": "130350317",
                    "speaker": "卡维",
                    "text": "谢谢您，我午饭吃得晚，还不饿，晚饭延后一点没问题的。"
                },
                {
                    "id": "130350318",
                    "speaker": "卡维",
                    "text": "今天来兰巴德这里买点酒，隐约听到你们的声音，就上来看看。"
                },
                {
                    "id": "130350319",
                    "speaker": "卡维",
                    "text": "怎么了？聚在这里庆祝喜事？"
                },
                {
                    "id": "130350320",
                    "speaker": "居勒什",
                    "text": "唉，糟糕事还差不多…我们不说你都想不到今天发生了什么。"
                },
                {
                    "id": "130350321",
                    "speaker": "Black Screen",
                    "text": "居勒什给刚才不在场的人绘声绘色地讲述了白天发生的事…"
                },
                {
                    "id": "130350322",
                    "speaker": "提纳里",
                    "text": "…确实比我当学生的时候糟糕些。我从入学到毕业都没听说过这种事。"
                },
                {
                    "id": "130350323",
                    "speaker": "柯莱",
                    "text": "犯人的年纪也很小…唉，他父母知道了会怎么想呢？"
                },
                {
                    "id": "130350324",
                    "speaker": "居勒什",
                    "text": "观念没成型的年轻人有时比成年人更容易铤而走险，也是没办法的事。"
                },
                {
                    "id": "130350325",
                    "speaker": "居勒什",
                    "text": "但是啊！这封信的口气，真叫人生气！你们看看！"
                },
                {
                    "id": "130350326",
                    "speaker": "卡维",
                    "text": "…呃，这实在是…"
                },
                {
                    "id": "130350327",
                    "speaker": "柯莱",
                    "text": "「而我监视着你和你所有的秘密…」然后就跟着居勒什先生去了智慧宫吗…"
                },
                {
                    "id": "130350328",
                    "speaker": "居勒什",
                    "text": "要是我儿子做出这种事，一定得狠狠教训他一顿。哼。"
                },
                {
                    "id": "130350329",
                    "speaker": "赛诺",
                    "text": "还好我也是个刚正不阿的好人。"
                },
                {
                    "id": "130350330",
                    "speaker": "兰巴德",
                    "text": "卡维先生！打包好了！"
                },
                {
                    "id": "130350331",
                    "speaker": "卡维",
                    "text": "噢，来了！"
                },
                {
                    "id": "130350332",
                    "speaker": "卡维",
                    "text": "那我先走一步，你们慢慢聊。下次见啦。"
                },
                {
                    "id": "130350333",
                    "speaker": "派蒙",
                    "text": "嗯，再见！"
                },
                {
                    "id": "130350334",
                    "speaker": "卡维",
                    "text": "来了来了，咖啡豆也打包进去了吗？"
                },
                {
                    "id": "130350335",
                    "speaker": "兰巴德",
                    "text": "放心。"
                },
                {
                    "id": "130350336",
                    "speaker": "居勒什",
                    "text": "说了这么多，大家再吃点，别让菜凉了。"
                },
                {
                    "id": "130350337",
                    "speaker": "Black Screen",
                    "text": "聊了很久的天，差点忘记用餐。"
                },
                {
                    "id": "130350338",
                    "speaker": "Black Screen",
                    "text": "好在桌上的菜肴还热着，众人一同愉快地享用美食，庆祝这次乌龙案件告结…"
                }
            ]
        },
        {
            "id": "1303505",
            "objective": "离开兰巴德酒馆",
            "dialogues": [
                {
                    "id": "130350401",
                    "speaker": "居勒什",
                    "text": "呼——"
                },
                {
                    "id": "130350402",
                    "speaker": "派蒙",
                    "text": "吃得肚子都要炸了，真好吃…"
                },
                {
                    "id": "130350403",
                    "speaker": "居勒什",
                    "text": "哈哈，我也是。吃太饱了，我走回去，消消食。"
                },
                {
                    "id": "130350404",
                    "speaker": "柯莱",
                    "text": "谢谢您招待我们！下次见面我带我和提纳里师父做的安眠药草茶给您。"
                },
                {
                    "id": "130350405",
                    "speaker": "居勒什",
                    "text": "我可盼着呢，哎，多拿点来，给其他老头老太也分一些，叫他们羡慕羡慕我。"
                },
                {
                    "id": "130350406",
                    "speaker": "提纳里",
                    "text": "没问题，我打包好拿过来。"
                },
                {
                    "id": "130350407",
                    "speaker": "Player",
                    "text": "谢谢你的招待！"
                },
                {
                    "id": "130350408",
                    "speaker": "居勒什",
                    "text": "噢！回头见了各位。我还得回去照料我那片田呢！"
                },
                {
                    "id": "130350409",
                    "speaker": "赛诺",
                    "text": "再见老师，晚上早点睡，别光想着番茄了。"
                },
                {
                    "id": "130350410",
                    "speaker": "居勒什",
                    "text": "哎！这是什么话，我肯定得赢萨赫哈蒂啊！"
                },
                {
                    "id": "130350411",
                    "speaker": "居勒什",
                    "text": "走了走了，早点休息孩子们，晚安喽。"
                },
                {
                    "id": "130350412",
                    "speaker": "派蒙",
                    "text": "慢走哦！路上小心！"
                },
                {
                    "id": "130350413",
                    "speaker": "赛诺",
                    "text": "好，到属于我们的时间了。"
                },
                {
                    "id": "130350414",
                    "speaker": "派蒙",
                    "text": "什么意思？"
                },
                {
                    "id": "130350415",
                    "speaker": "赛诺",
                    "text": "我和提纳里柯莱商量过了，趁最近有空，加上庆祝你回来须弥，我们几个去露营吧。"
                },
                {
                    "id": "130350416",
                    "speaker": "派蒙",
                    "text": "露营？太好啦！",
                    "choices": [
                        {
                            "id": "130350417",
                            "text": "听上去真不错。",
                            "response": [
                                {
                                    "id": "130350418",
                                    "speaker": "柯莱",
                                    "text": "对吧？好久没一起玩了，真期待啊。"
                                },
                                {
                                    "id": "130350422",
                                    "speaker": "提纳里",
                                    "text": "明天下午，到化城郭东南方向的河岸见吧。"
                                },
                                {
                                    "id": "130350423",
                                    "speaker": "提纳里",
                                    "text": "不用带什么东西，我们都准备好了，带上好心情过来就行。"
                                },
                                {
                                    "id": "130350424",
                                    "speaker": "派蒙",
                                    "text": "噢！就这么说定了！"
                                },
                                {
                                    "id": "130350425",
                                    "speaker": "赛诺",
                                    "text": "好，那就明天见了。"
                                }
                            ]
                        },
                        {
                            "id": "130350419",
                            "text": "是时候展示我扎帐篷的实力了！",
                            "response": [
                                {
                                    "id": "130350420",
                                    "speaker": "柯莱",
                                    "text": "等一下，请不要抢我的工作！你和派蒙帮师父和赛诺先生干别的吧。"
                                },
                                {
                                    "id": "130350421",
                                    "speaker": "柯莱",
                                    "text": "跟我们一起出去玩的时候，偷偷懒，发发呆，做一个不那么英雄的人也可以哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1303599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130359901",
                    "speaker": "派蒙",
                    "text": "好久没跟须弥的朋友们见面了，不知道大家最近怎么样？"
                },
                {
                    "id": "130359902",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，去须弥城找人叙叙旧吧！"
                }
            ]
        }
    ]
}