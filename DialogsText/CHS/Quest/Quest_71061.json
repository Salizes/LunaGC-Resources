        {
            "id": "7106108",
            "objective": "对「邪气」源头使用「才慧之瑞佑」",
            "dialogues": []
        },
        {
            "id": "7106109",
            "objective": "告知赞玛兰「邪气」源头已被清除",
            "dialogues": [
                {
                    "id": "710610501",
                    "speaker": "派蒙",
                    "text": "喂，大蘑头，我们回来啦。你的那个什么…对了，「才慧之瑞佑」！用完了…"
                },
                {
                    "id": "710610503",
                    "speaker": "派蒙",
                    "text": "不过裂口已经堵上了，现在应该没问题啦！"
                },
                {
                    "id": "710610504",
                    "speaker": "赞玛兰",
                    "text": "#赞美{NICKNAME}，赞美派蒙。"
                },
                {
                    "id": "710610505",
                    "speaker": "赞玛兰",
                    "text": "愿已逝的昨日没有悔恨，未至的明晨一切顺遂。"
                },
                {
                    "id": "710610506",
                    "speaker": "赞玛兰",
                    "text": "……"
                },
                {
                    "id": "710610507",
                    "speaker": "派蒙",
                    "text": "看来大蘑头又睡着了，我们还是不要打扰它了。"
                }
            ]
        }
    ]
