    "talks": [
        {
            "id": "7106116",
            "objective": "靠近奇怪的大蘑菇$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7106101",
            "objective": "与赞玛兰对话",
            "dialogues": [
                {
                    "id": "710610101",
                    "speaker": "赞玛兰",
                    "text": "两脚但不用脚的小东西太过多疑。"
                },
                {
                    "id": "710610102",
                    "speaker": "派蒙",
                    "text": "我不叫什么「两脚但不用脚的小东西」！我叫派蒙！气死我了，一定要找机会给你取一个难听的绰号。"
                },
                {
                    "id": "710610103",
                    "speaker": "派蒙",
                    "text": "对了，就叫你「大蘑头」好了！"
                },
                {
                    "id": "710610104",
                    "speaker": "派蒙",
                    "text": "周围好像飘着一些发光的粉尘，看起来像是蘑菇的孢子，不知道我们能听到蘑菇的声音是不是和它们有关系。"
                },
                {
                    "id": "710610105",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰知道许多有脚但不用脚的，不知道派蒙。"
                },
                {
                    "id": "710610106",
                    "speaker": "派蒙",
                    "text": "哼哼，那是因为我是特别的呀。"
                },
                {
                    "id": "710610107",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰知道两脚的，怪哉怪哉，有熟悉的气息。"
                },
                {
                    "id": "710610108",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你认识大蘑头吗？",
                    "choices": [
                        {
                            "id": "710610109",
                            "text": "不认识。",
                            "response": [
                                {
                                    "id": "710610111",
                                    "speaker": "赞玛兰",
                                    "text": "是镀金的热砂与幽邃的雨林的气息，是故乡的气息。"
                                },
                                {
                                    "id": "710610112",
                                    "speaker": "派蒙",
                                    "text": "热砂和雨林，是说须弥吗？我们的确在营地和从须弥来的学者接触过…"
                                },
                                {
                                    "id": "710610113",
                                    "speaker": "赞玛兰",
                                    "text": "赞玛兰虽然已经离开故乡有些时日，但绝不会错认。"
                                },
                                {
                                    "id": "710610114",
                                    "speaker": "赞玛兰",
                                    "text": "#两脚的{NICKNAME}，有缘之人，赞玛兰有事相求。"
                                },
                                {
                                    "id": "710610115",
                                    "speaker": "赞玛兰",
                                    "text": "赞玛兰在此处安住已久，原本此地是处惬意的居所…"
                                },
                                {
                                    "id": "710610116",
                                    "speaker": "赞玛兰",
                                    "text": "但近来邪气愈来愈盛，为抵御邪气，赞玛兰耗尽了气力，落得如此模样，不得已而向两脚的求救。"
                                },
                                {
                                    "id": "710610117",
                                    "speaker": "派蒙",
                                    "text": "仔细看看，大蘑头确实很没精神呢，好像生病了一样。"
                                },
                                {
                                    "id": "710610118",
                                    "speaker": "派蒙",
                                    "text": "#唔，对了，{NICKNAME}，要不要把「触媒」的能量分给大蘑头？也许这样它就能打起精神来了。"
                                }
                            ]
                        },
                        {
                            "id": "710610110",
                            "text": "也许认识，但是不记得了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7106102",
            "objective": "将「触媒」能量分给赞玛兰",
            "dialogues": [
                {
                    "id": "710610201",
                    "speaker": "Black Screen",
                    "text": "将「触媒」的能量分给了赞玛兰。"
                },
                {
                    "id": "710610202",
                    "speaker": "派蒙",
                    "text": "呜哇，大蘑头亮起来了！现在是不是该叫「荧光大蘑头」了…"
                },
                {
                    "id": "710610203",
                    "speaker": "赞玛兰",
                    "text": "#赞美{NICKNAME}，赞美派蒙。"
                },
                {
                    "id": "710610204",
                    "speaker": "赞玛兰",
                    "text": "#多亏{NICKNAME}，多亏派蒙，赞玛兰重获了生命的辉光。"
                },
                {
                    "id": "710610205",
                    "speaker": "赞玛兰",
                    "text": "但切不可放松大意，赞玛兰知道，邪气的源头仍在，邪气随时可能再来袭扰。"
                },
                {
                    "id": "710610206",
                    "speaker": "派蒙",
                    "text": "欸，那该怎么办才好？"
                },
                {
                    "id": "710610207",
                    "speaker": "派蒙",
                    "text": "呜啊，哪里冒出来的这些黑泥？这就是大蘑头说的「邪气」吗？"
                }
            ]
        },
        {
            "id": "7106121",
            "objective": "test播放特效$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7106103",
            "objective": "与赞玛兰对话",
            "dialogues": []
        },
        {
            "id": "7106124",
            "objective": "test通知刷出黑泥$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7106104",
            "objective": "清除赞玛兰周围的「邪气」",
            "dialogues": [
                {
                    "id": "710610401",
                    "speaker": "赞玛兰",
                    "text": "#赞美{NICKNAME}，赞美派蒙。"
                },
                {
                    "id": "710610402",
                    "speaker": "赞玛兰",
                    "text": "虽于心不安，但且容赞玛兰直言，正如两脚的有言：「帮人帮到底」…",
                    "choices": [
                        {
                            "id": "710610403",
                            "text": "你该不会还有事情想让我们跑腿吧？",
                            "response": [
                                {
                                    "id": "710610404",
                                    "speaker": "赞玛兰",
                                    "text": "两脚的这等远见卓识的确配得上有智慧者的称号。"
                                },
                                {
                                    "id": "710610407",
                                    "speaker": "赞玛兰",
                                    "text": "还请不要推辞，收下这份「才慧之瑞佑」。"
                                },
                                {
                                    "id": "710610408",
                                    "speaker": "Black Screen",
                                    "text": "获得了「才慧之瑞佑」。"
                                },
                                {
                                    "id": "710610409",
                                    "speaker": "派蒙",
                                    "text": "呜啊…这是什么东西，看起来好可疑的样子…"
                                },
                                {
                                    "id": "710610410",
                                    "speaker": "赞玛兰",
                                    "text": "此处仍有不少邪气在空中游荡，赞玛兰能够感知，却无法分辨源头的所在。沿水流探索，必定会有所发现。"
                                },
                                {
                                    "id": "710610411",
                                    "speaker": "赞玛兰",
                                    "text": "#{NICKNAME}只要对邪气的源头使用「才慧之瑞佑」，赞玛兰的同族自会把问题处理。",
                                    "choices": [
                                        {
                                            "id": "710610412",
                                            "text": "邪气的源头…的确不能放着不管。",
                                            "response": [
                                                {
                                                    "id": "710610414",
                                                    "speaker": "赞玛兰",
                                                    "text": "#{NICKNAME}比派蒙更懂幽默。赞玛兰无脚而{NICKNAME}有脚，有脚的活计自然由有脚的完成。"
                                                },
                                                {
                                                    "id": "710610415",
                                                    "speaker": "赞玛兰",
                                                    "text": "况且赞玛兰身负更重要的使命。"
                                                },
                                                {
                                                    "id": "710610416",
                                                    "speaker": "Player",
                                                    "text": "更重要的使命指？"
                                                },
                                                {
                                                    "id": "710610417",
                                                    "speaker": "赞玛兰",
                                                    "text": "#此番消耗了太多气力，和{NICKNAME}、派蒙交谈非常愉快，但赞玛兰需要休眠，积蓄力量抵御邪气，荫蔽同族，繁衍生息。"
                                                },
                                                {
                                                    "id": "710610418",
                                                    "speaker": "赞玛兰",
                                                    "text": "#祝福{NICKNAME}，祝福派蒙。"
                                                },
                                                {
                                                    "id": "710610419",
                                                    "speaker": "赞玛兰",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "710610420",
                                                    "speaker": "派蒙",
                                                    "text": "喂，大蘑头，喂！"
                                                },
                                                {
                                                    "id": "710610421",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，看来大蘑头已经睡着啦，我们走吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710610413",
                                            "text": "…说真的，你怎么不自己去？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710610405",
                            "text": "可你不是人而是蘑菇啊？",
                            "response": [
                                {
                                    "id": "710610406",
                                    "speaker": "赞玛兰",
                                    "text": "同为安享大地恩惠的有生之物，彼此扶助才顺应道理。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7106110",
            "objective": "告知赞玛兰「邪气」已被清除",
            "dialogues": [
                {
                    "id": "710610301",
                    "speaker": "赞玛兰",
                    "text": "#赞美{NICKNAME}，赞美派蒙。"
                },
                {
                    "id": "710610302",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰的呼唤久久未得到回应。多脚的和四脚的自不必说，两脚的也对赞玛兰的呼救置若罔闻。"
                },
                {
                    "id": "710610303",
                    "speaker": "赞玛兰",
                    "text": "#只有真正有智慧者才会回应赞玛兰的呼唤。派蒙是有智慧者，{NICKNAME}也是有智慧者。"
                },
                {
                    "id": "710610304",
                    "speaker": "赞玛兰",
                    "text": "两脚的之中的佼佼者理应获得赞玛兰的感谢。"
                },
                {
                    "id": "710610323",
                    "speaker": "派蒙",
                    "text": "哼哼，「有智慧者」派蒙，不容小觑！"
                },
                {
                    "id": "710610305",
                    "speaker": "Player",
                    "text": "小事一桩。"
                },
                {
                    "id": "710610306",
                    "speaker": "赞玛兰",
                    "text": "#相信假以时日，{NICKNAME}和派蒙也能成为与赞玛兰和赞玛兰的同族相提并论的存在。"
                },
                {
                    "id": "710610307",
                    "speaker": "派蒙",
                    "text": "等等，大蘑头这话是什么意思？"
                },
                {
                    "id": "710610308",
                    "speaker": "赞玛兰",
                    "text": "多脚的不如四脚的，四脚的不如两脚的，自然两脚的也不如无脚的。"
                },
                {
                    "id": "710610309",
                    "speaker": "赞玛兰",
                    "text": "#虽然{NICKNAME}和派蒙先天不足，但只要有心，后天的努力也未必不能改变运命的走向。"
                },
                {
                    "id": "710610310",
                    "speaker": "派蒙",
                    "text": "不过是个荧光大蘑菇而已，竟然这么嚣张！不知道荧光蘑菇能不能做成料理…",
                    "choices": [
                        {
                            "id": "710610311",
                            "text": "野菇鸡肉串应该不错。",
                            "response": [
                                {
                                    "id": "710610313",
                                    "speaker": "赞玛兰",
                                    "text": "派蒙胃口不小。今日吃蘑菇，明日吃蘑菇，百日之后派蒙之中已经不剩派蒙，只留蘑菇。"
                                },
                                {
                                    "id": "710610314",
                                    "speaker": "派蒙",
                                    "text": "#呜呜，{NICKNAME}，大蘑头讲话好可怕…"
                                },
                                {
                                    "id": "710610315",
                                    "speaker": "赞玛兰",
                                    "text": "唔，派蒙不懂幽默。"
                                },
                                {
                                    "id": "710610316",
                                    "speaker": "派蒙",
                                    "text": "这话一点也不幽默！"
                                },
                                {
                                    "id": "710610317",
                                    "speaker": "赞玛兰",
                                    "text": "赞玛兰摆脱了邪气，同族却仍在受苦。而今的赞玛兰力有不逮，无法像过去那般为弱者提供庇佑。"
                                },
                                {
                                    "id": "710610318",
                                    "speaker": "赞玛兰",
                                    "text": "#赞玛兰恳请{NICKNAME}，莫要吝惜哀怜，拯救无法自救的弱者吧。"
                                },
                                {
                                    "id": "710610319",
                                    "speaker": "派蒙",
                                    "text": "#意思是，还有其他的病怏怏的蘑菇吗？{NICKNAME}，要不要帮帮它们呢。",
                                    "choices": [
                                        {
                                            "id": "710610320",
                                            "text": "来都来了…",
                                            "response": [
                                                {
                                                    "id": "710610322",
                                                    "speaker": "派蒙",
                                                    "text": "那就快点出发吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710610321",
                                            "text": "如果顺路的话。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710610312",
                            "text": "漂亮的蘑菇都会骗人，一定有毒。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7106106",
            "objective": "帮助赞玛兰的同族$HIDDEN",
            "dialogues": [
                {
                    "id": "710610601",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰知道，仍有邪气残留。两脚的，有劳了。"
                }
            ]
        },
