    "talks": [
        {
            "id": "1180101",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "698350101",
                    "speaker": "神里绫人",
                    "text": "…这种样式倒是有几分闲趣，绫华应该会喜欢。"
                },
                {
                    "id": "698350102",
                    "speaker": "Player",
                    "text": "绫人？你是来买衣服么？"
                },
                {
                    "id": "698350103",
                    "speaker": "神里绫人",
                    "text": "#{NICKNAME}，真是巧遇。之前我在小仓屋预约了一批布料，按照惯例原本是要送到神里屋敷进行挑选的。"
                },
                {
                    "id": "698350104",
                    "speaker": "神里绫人",
                    "text": "只是今日恰好来天守阁与将军大人会谈，所以干脆顺路提前过来看看。",
                    "choices": [
                        {
                            "id": "698350105",
                            "text": "绫人原来会亲自来挑布…",
                            "response": [
                                {
                                    "id": "698350107",
                                    "speaker": "神里绫人",
                                    "text": "如果只是寻常用布，那自然是有专人安排。"
                                },
                                {
                                    "id": "698350108",
                                    "speaker": "神里绫人",
                                    "text": "但如果是出席正式场合所用的衣物，便要从布料与着色开始考虑，我一般还是会亲自挑选。"
                                },
                                {
                                    "id": "698350109",
                                    "speaker": "神里绫人",
                                    "text": "毕竟…神里家为社奉行，负责文化与民生，一举一动也皆会进入稻妻民众的眼中。购入的布匹样式，自然也瞒不过大家。"
                                },
                                {
                                    "id": "698350110",
                                    "speaker": "神里绫人",
                                    "text": "每一年采买布匹后，都会有不少商家打着「社奉行曾用此布」的名号来推销布匹。"
                                },
                                {
                                    "id": "698350111",
                                    "speaker": "神里绫人",
                                    "text": "之前有一年我曾差使家仆采买，但…却有人拿着摩拉去向他贿赂，呵呵，他倒也不推辞…处理这件事时，也算是颇费了一些功夫。"
                                },
                                {
                                    "id": "698350112",
                                    "speaker": "神里绫人",
                                    "text": "所以，之后涉及到这类事务时，都是由我来亲自处理，也算是提前免去一些麻烦事。",
                                    "choices": [
                                        {
                                            "id": "698350113",
                                            "text": "好、好辛苦…",
                                            "response": [
                                                {
                                                    "id": "698350115",
                                                    "speaker": "神里绫人",
                                                    "text": "呵呵，牵涉社奉行之事从无小事，我已经习惯了。"
                                                },
                                                {
                                                    "id": "698350116",
                                                    "speaker": "神里绫人",
                                                    "text": "#我已经挑出了两种布料，但又一时决定不了到底选哪一种…{NICKNAME}，不如交由你来判断吧。",
                                                    "choices": [
                                                        {
                                                            "id": "698350117",
                                                            "text": "这么重要的事…",
                                                            "response": [
                                                                {
                                                                    "id": "698350119",
                                                                    "speaker": "神里绫人",
                                                                    "text": "你是我神里府的贵客，更是绫华的知心好友，呵呵，倒不如说没有比你更适合的人选了。"
                                                                },
                                                                {
                                                                    "id": "698350120",
                                                                    "speaker": "神里绫人",
                                                                    "text": "再说了，观你的气质仪态，我也相信你对衣料的品味。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698350121",
                                                                            "text": "那…我选左边的。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698350123",
                                                                                    "speaker": "神里绫人",
                                                                                    "text": "嗯，不错。老板，就要这一种布，请包五匹送进府里吧。"
                                                                                },
                                                                                {
                                                                                    "id": "698350124",
                                                                                    "speaker": "神里绫人",
                                                                                    "text": "#多谢你了，{NICKNAME}，替我解了这踌躇之急。"
                                                                                },
                                                                                {
                                                                                    "id": "698350125",
                                                                                    "speaker": "神里绫人",
                                                                                    "text": "我还有些事情要处理，等衣服做好了，还请你来府上做客。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698350126",
                                                                                            "text": "我一定去。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350129",
                                                                                                    "speaker": "神里绫人",
                                                                                                    "text": "#那么，我就先告辞了。下次见，{NICKNAME}。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698350127",
                                                                                            "text": "希望能做出漂亮的衣服。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350128",
                                                                                                    "speaker": "神里绫人",
                                                                                                    "text": "由你挑的上等布料，自然能做出漂亮衣服。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698350122",
                                                                            "text": "那…我选右边的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698350118",
                                                            "text": "让我决定真的好吗…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698350114",
                                            "text": "做衣服也这么复杂…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698350106",
                            "text": "我还以为会让府内人代劳。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1180102",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        }
    ]
