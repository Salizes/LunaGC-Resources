    "talks": [
        {
            "id": "7165601",
            "objective": "与稻妻城的凯瑟琳交谈",
            "dialogues": [
                {
                    "id": "716560101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！感谢你的到来，冒险家。",
                    "choices": [
                        {
                            "id": "716560102",
                            "text": "有新的委托吗？",
                            "response": [
                                {
                                    "id": "716560103",
                                    "speaker": "凯瑟琳",
                                    "text": "是的，我们准备展开新一轮的生态调查。"
                                },
                                {
                                    "id": "716560106",
                                    "speaker": "凯瑟琳",
                                    "text": "总之，还是由我先解释一下情况吧。"
                                },
                                {
                                    "id": "716560107",
                                    "speaker": "凯瑟琳",
                                    "text": "近些日子，有关「飘浮灵」的目击报告激增，状况很不寻常。"
                                },
                                {
                                    "id": "716560108",
                                    "speaker": "凯瑟琳",
                                    "text": "这本来是一种很少见的元素生物，它们突然大量出现，背后多半有什么原因。"
                                },
                                {
                                    "id": "716560109",
                                    "speaker": "凯瑟琳",
                                    "text": "由于对这种生物了解甚少，冒险家协会正在组织全方位的调查行动。",
                                    "choices": [
                                        {
                                            "id": "716560110",
                                            "text": "是这么厉害的怪物吗？",
                                            "response": [
                                                {
                                                    "id": "716560112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "由于情况反常，又事出突然，所以它们现在性情如何，是否有很强的攻击性，这些我们都还难以确定。"
                                                },
                                                {
                                                    "id": "716560115",
                                                    "speaker": "Player",
                                                    "text": "好吧，我接受了。"
                                                },
                                                {
                                                    "id": "716560117",
                                                    "speaker": "凯瑟琳",
                                                    "text": "感谢你能答应，需要你帮忙的其实很简单，就是和同伴一起走访稻妻各处，观察「飘浮灵」的异状。"
                                                },
                                                {
                                                    "id": "716560118",
                                                    "speaker": "凯瑟琳",
                                                    "text": "形式类似于之前你执行过的「探索派遣」，我已经将各地的「飘浮灵」目击情报整理好了。"
                                                },
                                                {
                                                    "id": "716560119",
                                                    "speaker": "凯瑟琳",
                                                    "text": "事不宜迟，由我来为你展示一下。"
                                                },
                                                {
                                                    "id": "716560120",
                                                    "speaker": "凯瑟琳",
                                                    "text": "由于「飘浮灵」是元素生物，如果能够按照协会所推荐的元素类型安排人手，应该就能取得事半功倍的效果。"
                                                },
                                                {
                                                    "id": "716560121",
                                                    "speaker": "凯瑟琳",
                                                    "text": "其中会有一项比较特殊的委托，由于协会收集的信息不足，需要麻烦你先去现场调查，完成后再由我来安排派遣事宜。"
                                                },
                                                {
                                                    "id": "716560122",
                                                    "speaker": "Player",
                                                    "text": "简单来说就是前期准备吧。"
                                                },
                                                {
                                                    "id": "716560123",
                                                    "speaker": "凯瑟琳",
                                                    "text": "嗯，这种委托往往有一些难度，但交给你我非常放心。"
                                                },
                                                {
                                                    "id": "716560124",
                                                    "speaker": "凯瑟琳",
                                                    "text": "我会每天更新关于「飘浮灵」的情报，尽全力为你和你的同伴做好支援工作。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716560111",
                                            "text": "太兴师动众了吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716560104",
                            "text": "我大概知道要做什么…",
                            "response": [
                                {
                                    "id": "716560105",
                                    "speaker": "凯瑟琳",
                                    "text": "欸？以前你处理过这样的委托吗？那太好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}