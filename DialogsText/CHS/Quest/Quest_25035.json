    },
    "talks": [
        {
            "id": "2503501",
            "objective": "与米齐卡对话",
            "dialogues": [
                {
                    "id": "250350101",
                    "speaker": "米齐卡",
                    "text": "这群冒失鬼。怎么又丢失了好几份快件。都说了在送东西的时候不要玩那些花里胡哨的动作…"
                },
                {
                    "id": "250350102",
                    "speaker": "Player",
                    "text": "发生什么事了吗？"
                },
                {
                    "id": "250350103",
                    "speaker": "米齐卡",
                    "text": "有几个「讯使」又不听劝，把人家寄出去的快件弄丢了。"
                },
                {
                    "id": "250350104",
                    "speaker": "米齐卡",
                    "text": "唉，他们都意识不到，这是在损坏我们「悬木人」的声誉吗？"
                },
                {
                    "id": "250350105",
                    "speaker": "米齐卡",
                    "text": "送东西就好好送东西，遇见山坡就正常越过去，有什么必要半路突然开始玩滑行？"
                },
                {
                    "id": "250350106",
                    "speaker": "米齐卡",
                    "text": "我说了好多次，但那群年轻人就是听不进去。成天就想着追求刺激…"
                },
                {
                    "id": "250350107",
                    "speaker": "米齐卡",
                    "text": "唉，我还得托人去把那些快件找回来。谁有空呢？我想想…",
                    "choices": [
                        {
                            "id": "250350108",
                            "text": "我可以帮忙。",
                            "response": [
                                {
                                    "id": "250350109",
                                    "speaker": "米齐卡",
                                    "text": "你…愿意帮我？那就太好了。"
                                },
                                {
                                    "id": "250350110",
                                    "speaker": "米齐卡",
                                    "text": "我一时半会也找不到能帮忙的人，如果我自己去找，那「讯使长屋」就没人看店了。"
                                },
                                {
                                    "id": "250350117",
                                    "speaker": "米齐卡",
                                    "text": "我也不会让你大海捞针的。我知道那群小子一般会从哪里走，也大概能猜到那些快件的丢失地点。"
                                },
                                {
                                    "id": "250350118",
                                    "speaker": "米齐卡",
                                    "text": "我这就给你划出那些快件的丢失地点，就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "250350111",
                            "text": "那些快件，很大吗？",
                            "response": [
                                {
                                    "id": "250350112",
                                    "speaker": "米齐卡",
                                    "text": "不大。但就因为它们不大，每次找起来都很麻烦，唉，那群粗心的小子…"
                                },
                                {
                                    "id": "250350113",
                                    "speaker": "米齐卡",
                                    "text": "…如果你有空的话。愿意帮我去找找那些快件吗？"
                                },
                                {
                                    "id": "250350114",
                                    "speaker": "米齐卡",
                                    "text": "现在「讯使长屋」里的人手也不够，如果我自己去找，那就没人看店了。"
                                },
                                {
                                    "id": "250350115",
                                    "speaker": "Player",
                                    "text": "没问题，我来帮忙。"
                                },
                                {
                                    "id": "250350116",
                                    "speaker": "米齐卡",
                                    "text": "那就太好了！真是多谢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503502",
            "objective": "寻找丢失的快件",
            "dialogues": [
                {
                    "id": "250350201",
                    "speaker": "派蒙",
                    "text": "按照标记…快件应该就在附近了。"
                },
                {
                    "id": "250350202",
                    "speaker": "派蒙",
                    "text": "我们仔细在周围找一找吧，唔…会在哪里呢…"
                }
            ]
        },
        {
            "id": "2503503",
            "objective": "寻找丢失的快件$HIDDEN",
            "dialogues": [
                {
                    "id": "250350301",
                    "speaker": "米齐卡",
                    "text": "一份…两份，还差几份…"
                }
            ]
        },
        {
            "id": "2503504",
            "objective": "寻找丢失的快件$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2503505",
