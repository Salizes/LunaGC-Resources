{
    "quest": {
        "id": "25035",
        "title": "嘿！你的信！",
        "description": "「悬木人」的米齐卡，最近遇见了一些麻烦…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
