            "dialogues": []
        },
        {
            "id": "2503506",
            "objective": "寻找丢失的快件",
            "dialogues": [
                {
                    "id": "250350601",
                    "speaker": "米齐卡",
                    "text": "一份…两份，还差几份…"
                }
            ]
        },
        {
            "id": "2503507",
            "objective": "向米齐卡回报",
            "dialogues": [
                {
                    "id": "250350701",
                    "speaker": "米齐卡",
                    "text": "怎么样？你找到那些快件了吗？"
                }
            ]
        },
        {
            "id": "2503508",
            "objective": "与米齐卡对话",
            "dialogues": [
                {
                    "id": "250350801",
                    "speaker": "米齐卡",
                    "text": "两份…三份…齐了。太好了，那些丢失的快件都找回来了。"
                },
                {
                    "id": "250350802",
                    "speaker": "米齐卡",
                    "text": "…等会，这份快件是不是归图达玛送来着？"
                },
                {
                    "id": "250350803",
                    "speaker": "米齐卡",
                    "text": "这些报酬给你，谢谢你帮忙。"
                },
                {
                    "id": "250350804",
                    "speaker": "米齐卡",
                    "text": "呼…我真是要找图达玛这小子好好聊一聊了！"
                }
            ]
        },
        {
            "id": "2503511",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250351101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "250351102",
                    "speaker": "米齐卡",
                    "text": "寻找快件的事就拜托了，我还要整理店里的快件。唉…那群小子什么时候能稳重点…"
                }
            ]
        }
    ]
