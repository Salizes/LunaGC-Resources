    "talks": [
        {
            "id": "7507110",
            "objective": "(test)钻地龙听导演讲戏$HIDDEN",
            "dialogues": [
                {
                    "id": "750711001",
                    "speaker": "马尼菲科",
                    "text": "#哈哈，亲爱的{NICKNAME}和派蒙，我的缪斯和…呃，小缪斯！"
                },
                {
                    "id": "750711002",
                    "speaker": "马尼菲科",
                    "text": "#啊，还有{REALNAME[ID(2)|SHOWHOST(true)]}！"
                },
                {
                    "id": "750711003",
                    "speaker": "派蒙",
                    "text": "哪个才是小的啦！"
                },
                {
                    "id": "750711004",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750711005",
                    "speaker": "马尼菲科",
                    "text": "哈哈，请别在意！"
                },
                {
                    "id": "750711006",
                    "speaker": "派蒙",
                    "text": "哼，我很在意！",
                    "choices": [
                        {
                            "id": "750711007",
                            "text": "又有什么新灵感了吗？",
                            "response": [
                                {
                                    "id": "750711008",
                                    "speaker": "马尼菲科",
                                    "text": "当然，不过…呃，嘿嘿，新的灵感就意味着…我又要找你们求助了。"
                                },
                                {
                                    "id": "750711009",
                                    "speaker": "派蒙",
                                    "text": "没问题啦！反正你每次都会给钱！"
                                },
                                {
                                    "id": "750711010",
                                    "speaker": "马尼菲科",
                                    "text": "哈哈，好呀，我的小小雇佣兵！"
                                },
                                {
                                    "id": "750711017",
                                    "speaker": "马尼菲科",
                                    "text": "你看，我这次打算拍摄的是嵴锋龙…嘘，我们小心点。不要吵到它了。"
                                },
                                {
                                    "id": "750711018",
                                    "speaker": "马尼菲科",
                                    "text": "我还是第一次接触这种龙类，但我已经观察了它们一段时间了…真是迷人的动物…在坚硬的甲壳下面，它们也有自己的个性呢。"
                                },
                                {
                                    "id": "750711019",
                                    "speaker": "马尼菲科",
                                    "text": "嘿嘿，喂过它几次之后，它现在已经能听懂基本的指令了。"
                                },
                                {
                                    "id": "750711020",
                                    "speaker": "马尼菲科",
                                    "text": "不过我需要驯龙大师做的事呢，就是和那头离群的嵴锋龙互动，让我拍一张它与其他同类在一起的照片。"
                                },
                                {
                                    "id": "750711021",
                                    "speaker": "马尼菲科",
                                    "text": "嘿嘿，很简单，不是吗？"
                                },
                                {
                                    "id": "750711022",
                                    "speaker": "派蒙",
                                    "text": "嗯，太简单啦！",
                                    "choices": [
                                        {
                                            "id": "750711023",
                                            "text": "（反正不是你在忙…）",
                                            "response": [
                                                {
                                                    "id": "750711025",
                                                    "speaker": "马尼菲科",
                                                    "text": "哈哈，就是这个劲头！来吧，帮我带来那头离群的嵴锋龙，我们就可以开始啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750711024",
                                            "text": "（也没那么简单啦…！）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750711011",
                            "text": "又需要你的慕斯们帮忙了？",
                            "response": [
                                {
                                    "id": "750711012",
                                    "speaker": "派蒙",
                                    "text": "慕斯…我也想吃了…"
                                },
                                {
                                    "id": "750711013",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "咕噜…咕噜…"
                                },
                                {
                                    "id": "750711014",
                                    "speaker": "马尼菲科",
                                    "text": "呃…是「缪斯」…不是吃的！"
                                },
                                {
                                    "id": "750711015",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，只要你给钱，我们就能换成吃的！"
                                },
                                {
                                    "id": "750711016",
                                    "speaker": "马尼菲科",
                                    "text": "随便你怎么说啦…不过我确实有钱，两位不用担心白忙活！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7507116",
            "objective": "魂附嵴锋龙，与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750711901",
                    "speaker": "派蒙",
                    "text": "嵴锋龙来啦！我们可以拍摄了吧！"
                },
                {
                    "id": "750711902",
                    "speaker": "马尼菲科",
                    "text": "很好，开始啦！"
                }
            ]
        },
        {
            "id": "7507114",
            "objective": "配合马尼菲科的拍摄",
            "dialogues": []
        },
        {
            "id": "7507111",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750711101",
                    "speaker": "马尼菲科",
                    "text": "你发现了吗？小家伙好像注意到了什么东西…是它的家人吗？"
                },
                {
                    "id": "750711102",
                    "speaker": "马尼菲科",
                    "text": "它自己往那边去了！我们也跟上吧，可别让它走丢了！"
                }
            ]
        },
        {
            "id": "7507115",
            "objective": "追上小嵴锋龙",
            "dialogues": []
        },
        {
            "id": "7507112",
            "objective": "击败敌人",
            "dialogues": []
        },
        {
            "id": "7507113",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750711321",
                    "speaker": "Black Screen",
                    "text": "你们击败了敌人，破开了囚禁小驮兽的笼门。驮兽从笼子里雀跃地奔出来，对你们发出欢快的叫声。"
                },
                {
                    "id": "750711301",
                    "speaker": "派蒙",
                    "text": "哇啊…呼，终于告一段落了！好惊险！"
                },
                {
                    "id": "750711302",
                    "speaker": "马尼菲科",
                    "text": "嘘——！看……"
                },
                {
                    "id": "750711303",
                    "speaker": "马尼菲科",
                    "text": "「咔嚓！」"
                },
                {
                    "id": "750711304",
                    "speaker": "马尼菲科",
                    "text": "完美。"
                },
                {
                    "id": "750711305",
                    "speaker": "派蒙",
                    "text": "哇…它们关系很好呢…我还以为驮兽会被吃掉…之类的。"
                },
                {
                    "id": "750711306",
                    "speaker": "马尼菲科",
                    "text": "嘿嘿，别看嵴锋龙一副很凶恶的样子，其实它们的个性很温和的。"
                },
                {
                    "id": "750711307",
                    "speaker": "马尼菲科",
                    "text": "终于拍好了，副本给你。还有报酬…这里。"
                },
                {
                    "id": "750711308",
                    "speaker": "马尼菲科",
                    "text": "唉…本以为能拍到幼年嵴锋龙和成年体亲密互动的场面，没想到让一头小驮兽占了便宜！"
                },
                {
                    "id": "750711309",
                    "speaker": "派蒙",
                    "text": "嘿嘿，不过驮兽也不讨厌呀。你肯定也这样觉得吧！"
                },
                {
                    "id": "750711310",
                    "speaker": "马尼菲科",
                    "text": "我怎样觉得不重要！重要的是摄影委员会的评委怎么觉得！"
                },
                {
                    "id": "750711311",
                    "speaker": "马尼菲科",
                    "text": "不过…这小东西在纳塔的陌生环境里晃荡还是太危险了，我正好也缺少一个帮忙背东西的搭档…"
                },
                {
                    "id": "750711312",
                    "speaker": "马尼菲科",
                    "text": "嘿嘿，我也就只好勉为其难收养它咯。"
                },
                {
                    "id": "750711313",
                    "speaker": "派蒙",
                    "text": "那它原来的主人怎么办呀…？"
                },
                {
                    "id": "750711314",
                    "speaker": "马尼菲科",
                    "text": "哼，把这小东西丢在那么危险的地方不管，是他自己的过错！"
                },
                {
                    "id": "750711317",
                    "speaker": "马尼菲科",
                    "text": "好啦，不管那些啦！枫丹摄影画廊，我来咯！哈哈，到时候你们也要来哇！"
                },
                {
                    "id": "750711318",
                    "speaker": "马尼菲科",
                    "text": "#不好意思，这次我真的要离开这个国家了！再见了！{NICKNAME}和派蒙！再见，小家伙！"
                },
                {
                    "id": "750711319",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750711320",
                    "speaker": "马尼菲科",
                    "text": "嘿，接住！留个纪念！别忘了我呀，小家伙们！"
                }
            ]
        },
        {
            "id": "7507116",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750711601",
                    "speaker": "马尼菲科",
                    "text": "「…幽暗的森林中飘荡着芬芳的花香…」"
                },
                {
                    "id": "750711602",
                    "speaker": "马尼菲科",
                    "text": "「…珍重离别之前，请给我一个美好的拥抱~」"
                },
                {
                    "id": "750711603",
                    "speaker": "马尼菲科",
                    "text": "嗯…？哈，抱歉，我又在哼歌了。"
                }
            ]
        },
        {
            "id": "7507120",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750712001",
                    "speaker": "马尼菲科",
                    "text": "来吧，帮我找头嵴锋龙，我们就可以开始啦！"
                }
            ]
        }
    ]
}