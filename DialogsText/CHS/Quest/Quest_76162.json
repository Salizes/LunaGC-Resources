    "talks": [
        {
            "id": "7616201",
            "objective": "前往战场南侧的阵地",
            "dialogues": [
                {
                    "id": "761620101",
                    "speaker": "叶洛亚",
                    "text": "别挡道，滚开！"
                },
                {
                    "id": "761620102",
                    "speaker": "来自魔物的声音",
                    "text": "嘻嘻…你急什么…"
                },
                {
                    "id": "761620103",
                    "speaker": "来自魔物的声音",
                    "text": "反正你们…迟早都得死…不过是…有人要提早上路了…"
                },
                {
                    "id": "761620104",
                    "speaker": "来自魔物的声音",
                    "text": "他不是抱怨…三年前自己没死成么…现在…我就成全他…"
                },
                {
                    "id": "761620105",
                    "speaker": "叶洛亚",
                    "text": "…比约恩？你把他怎么了？！"
                },
                {
                    "id": "761620106",
                    "speaker": "来自魔物的声音",
                    "text": "是他太弱了…弱者…废物…虫豸…"
                },
                {
                    "id": "761620107",
                    "speaker": "来自魔物的声音",
                    "text": "…会死难道不是理所应当么？"
                },
                {
                    "id": "761620108",
                    "speaker": "叶洛亚",
                    "text": "不准你侮辱他！他一点也不弱！"
                },
                {
                    "id": "761620109",
                    "speaker": "来自魔物的声音",
                    "text": "哦…在你看来…他是强者…"
                },
                {
                    "id": "761620110",
                    "speaker": "来自魔物的声音",
                    "text": "可是…可是强者就不会死么…"
                },
                {
                    "id": "761620111",
                    "speaker": "来自魔物的声音",
                    "text": "我还以为…你心里清楚得很哪…"
                },
                {
                    "id": "761620112",
                    "speaker": "来自魔物的声音",
                    "text": "那些比你强的人…不都死掉了么…不管是三年前…还是十年前…"
                },
                {
                    "id": "761620113",
                    "speaker": "叶洛亚",
                    "text": "…闭上你的狗嘴！"
                },
                {
                    "id": "761620114",
                    "speaker": "来自魔物的声音",
                    "text": "是啊…原来弱小的…就只有你而已啊…"
                },
                {
                    "id": "761620115",
                    "speaker": "来自魔物的声音",
                    "text": "要不然为什么…每次…每次活下来的都只有你？"
                },
                {
                    "id": "761620116",
                    "speaker": "来自魔物的声音",
                    "text": "…是你从战场逃跑了吧？苟且偷生的胆小鬼…"
                },
                {
                    "id": "761620117",
                    "speaker": "派蒙",
                    "text": "叶洛亚！别听它胡说八道！"
                },
                {
                    "id": "761620118",
                    "speaker": "Player",
                    "text": "少废话，纳命来！"
                },
                {
                    "id": "761620119",
                    "speaker": "叶洛亚",
                    "text": "#…{NICKNAME}！我们速战速决！"
                }
            ]
        },
        {
            "id": "7616202",
            "objective": "前往战场南侧的阵地查看",
            "dialogues": [
                {
                    "id": "761620201",
                    "speaker": "叶洛亚",
                    "text": "…比约恩怎么样了？"
                },
                {
                    "id": "761620202",
                    "speaker": "伊捷莉",
                    "text": "…伤得很重。攻击来得太突然了，他为了保护我们…呜…"
                },
                {
                    "id": "761620203",
                    "speaker": "伊捷莉",
                    "text": "…战场环境太危险，他也经不起转移的颠簸了，我们只能就地进行紧急处理，但以我们现有的能力，实在是…"
                },
                {
                    "id": "761620204",
                    "speaker": "比约恩",
                    "text": "…队长…"
                },
                {
                    "id": "761620205",
                    "speaker": "叶洛亚",
                    "text": "比约恩！"
                },
                {
                    "id": "761620206",
                    "speaker": "比约恩",
                    "text": "…对不起…我没能完成任务…"
                },
                {
                    "id": "761620207",
                    "speaker": "叶洛亚",
                    "text": "你完成得很好！阵地守住了，大家也都平安无事…"
                },
                {
                    "id": "761620208",
                    "speaker": "比约恩",
                    "text": "是吗…原来我做到了…太好了…"
                },
                {
                    "id": "761620209",
                    "speaker": "叶洛亚",
                    "text": "别说话了，先专心养伤。"
                },
                {
                    "id": "761620210",
                    "speaker": "比约恩",
                    "text": "现在不说…以后就没机会了…"
                },
                {
                    "id": "761620211",
                    "speaker": "叶洛亚",
                    "text": "…这是队长命令！我不许你再说这种话！你会没事的…一定会没事的…"
                },
                {
                    "id": "761620212",
                    "speaker": "比约恩",
                    "text": "呵…好…遵命…我不会再说了…"
                },
                {
                    "id": "761620213",
                    "speaker": "比约恩",
                    "text": "不过…等我见到维德…也算能够交代了…"
                },
                {
                    "id": "761620214",
                    "speaker": "比约恩",
                    "text": "他以前常说…我们执灯人就像冬凌草…"
                },
                {
                    "id": "761620215",
                    "speaker": "比约恩",
                    "text": "面对狂猎…我们每个人都很脆弱…就像冬凌草的花一样…会轻易凋落…"
                },
                {
                    "id": "761620216",
                    "speaker": "比约恩",
                    "text": "但是…只要叶片还在…只要根还牢牢扎在泥土里…"
                },
                {
                    "id": "761620217",
                    "speaker": "比约恩",
                    "text": "到了下一季…再下一季…总会有新的花朵绽放…"
                },
                {
                    "id": "761620218",
                    "speaker": "比约恩",
                    "text": "我们是不会失败的…对吧…队长…"
                },
                {
                    "id": "761620219",
                    "speaker": "叶洛亚",
                    "text": "…嗯！我们绝不会失败！我一定会亲手、彻底将那魔物葬送！"
                },
                {
                    "id": "761620220",
                    "speaker": "比约恩",
                    "text": "…你是我们之中最强的…我相信你…队长…"
                },
                {
                    "id": "761620221",
                    "speaker": "叶洛亚",
                    "text": "…放心吧，比约恩，我一定遵守约定。你该休息了…等你伤养好了，一切都会好的…"
                },
                {
                    "id": "761620222",
                    "speaker": "比约恩",
                    "text": "……"
                },
                {
                    "id": "761620223",
                    "speaker": "叶洛亚",
                    "text": "……"
                },
                {
                    "id": "761620224",
                    "speaker": "叶洛亚",
                    "text": "#…{NICKNAME}，派蒙，我们该走了。任务还没结束，我们不能在这里耽搁了。"
                },
                {
                    "id": "761620225",
                    "speaker": "派蒙",
                    "text": "叶洛亚…",
                    "choices": [
                        {
                            "id": "761620226",
                            "text": "就算为了比约恩，我们也得向前。",
                            "response": [
                                {
                                    "id": "761620228",
                                    "speaker": "叶洛亚",
                                    "text": "…嗯，继续前进吧！"
                                }
                            ]
                        },
                        {
                            "id": "761620227",
                            "text": "我们一定能打败敌人，取得胜利。"
                        }
                    ]
                }
            ]
        },
