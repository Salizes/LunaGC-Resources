    "talks": [
        {
            "id": "7452301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745230101",
                    "speaker": "枫原万叶",
                    "text": "如何？风中的诗意，是否也传入了你的留影机之中？"
                }
            ]
        },
        {
            "id": "7452302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745230201",
                    "speaker": "Player",
                    "text": "我们继续留影吧！"
                }
            ]
        },
        {
            "id": "7452303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745230301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7452304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745230401",
                    "speaker": "枫原万叶",
                    "text": "这风中…带来了海潮的咸味，远方商船的木香，还有…故人的气息。"
                },
                {
                    "id": "745230402",
                    "speaker": "枫原万叶",
                    "text": "#{NICKNAME}，别来无恙。",
                    "choices": [
                        {
                            "id": "745230403",
                            "text": "万叶，好久不见。",
                            "response": [
                                {
                                    "id": "745230405",
                                    "speaker": "枫原万叶",
                                    "text": "「南十字」船队在稻妻停靠补给。难得故地重游，便想四处走走，多看一眼故乡的景色，多听一听这里的风声。"
                                },
                                {
                                    "id": "745230406",
                                    "speaker": "枫原万叶",
                                    "text": "离岛的风，总是比别处更喧闹些，混杂着离别与重逢，希望与迷惘…是个能听到许多故事的地方。",
                                    "choices": [
                                        {
                                            "id": "745230407",
                                            "text": "能让我为你留影吗？",
                                            "response": [
                                                {
                                                    "id": "745230409",
                                                    "speaker": "枫原万叶",
                                                    "text": "呵呵，万物皆有其形，风亦然。只是风的形貌，只在叶落、浪起、或是旅人衣袂飘举的一瞬才得以窥见。"
                                                },
                                                {
                                                    "id": "745230410",
                                                    "speaker": "枫原万叶",
                                                    "text": "希望借由我的身影，能让你捕捉到那一瞬即逝的「风之形」。",
                                                    "choices": [
                                                        {
                                                            "id": "745230411",
                                                            "text": "那我要开始了。",
                                                            "response": [
                                                                {
                                                                    "id": "745230413",
                                                                    "speaker": "枫原万叶",
                                                                    "text": "那么，就请你来采集属于此刻的诗篇吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745230412",
                                                            "text": "请像刚才那样，感受风就好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745230408",
                                            "text": "我也想记录此刻的风。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745230404",
                            "text": "你怎么会在这里？"
                        }
                    ]
                }
            ]
        }
    ]
}