    "talks": [
        {
            "id": "7509401",
            "objective": "(test)（隐藏）打开房间$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7509402",
            "objective": "调查隐藏房间",
            "dialogues": [
                {
                    "id": "751260601",
                    "speaker": "派蒙",
                    "text": "没想到还发生过这样的事…密力奇，还有留下这篇笔记的人，大家真的都好勇敢…"
                },
                {
                    "id": "751260602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "751260603",
                    "speaker": "派蒙",
                    "text": "这个是…是刚才手记里提到的，那颗休眠的龙蛋！"
                },
                {
                    "id": "751260604",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你是想让我们用孵化器把它孵出来吗？"
                },
                {
                    "id": "751260605",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "751260606",
                    "speaker": "派蒙",
                    "text": "#——唔，龙蛋看起来状态蛮不错的，孵化器上正好也有操作指南。{NICKNAME}，要不我们就试试吧！",
                    "choices": [
                        {
                            "id": "751260607",
                            "text": "虽然不知道行不行，但值得一试。",
                            "response": [
                                {
                                    "id": "751260609",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "751260608",
                            "text": "好欸，小家伙要有新朋友了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509405",
            "objective": "调查隐藏房间",
            "dialogues": []
        },
        {
            "id": "7509404",
            "objective": "调查隐藏房间",
            "dialogues": []
        },
        {
            "id": "7509406",
            "objective": "启动孵化器",
            "dialogues": [
                {
                    "id": "750940601",
                    "speaker": "派蒙",
                    "text": "呼——吓死我了，突然就有怪物袭击过来了，还好我们足够厉害！",
                    "choices": [
                        {
                            "id": "750940602",
                            "text": "那下次就拜托派蒙了。",
                            "response": [
                                {
                                    "id": "750940603",
                                    "speaker": "派蒙",
                                    "text": "啊？不行不行不行，我不行的！我才不要跟那么可怕的怪物战斗呢！"
                                },
                                {
                                    "id": "750940606",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀！"
                                },
                                {
                                    "id": "750940607",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你看小家伙都着急了。我们还是先想办法孵化龙蛋吧！"
                                },
                                {
                                    "id": "750940608",
                                    "speaker": "Player",
                                    "text": "启动孵化器。"
                                },
                                {
                                    "id": "750940609",
                                    "speaker": "Black Screen",
                                    "text": "孵化器恢复了工作…\\n接下来需要做的，似乎只有等待…\\n然而，时间过去了很久…龙蛋没有发生任何的变化，一丝一毫都没有…"
                                },
                                {
                                    "id": "750940610",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯…嗯？"
                                },
                                {
                                    "id": "750940611",
                                    "speaker": "派蒙",
                                    "text": "好奇怪，感觉好像没有任何反应欸？难道是我们的操作有问题吗？我们要不再试一遍吧！",
                                    "choices": [
                                        {
                                            "id": "750940612",
                                            "text": "再试一遍…",
                                            "response": [
                                                {
                                                    "id": "750940613",
                                                    "speaker": "Black Screen",
                                                    "text": "你们按照说明重新启动了孵化器…\\n但跟之前一样，龙蛋上依旧没有出现任何变化…"
                                                },
                                                {
                                                    "id": "750940614",
                                                    "speaker": "派蒙",
                                                    "text": "呜…到底还要等多久啊，我感觉我的眼睛快要花掉了…头也好晕…肚子也好饿…"
                                                },
                                                {
                                                    "id": "750940615",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜…咕…"
                                                },
                                                {
                                                    "id": "750940616",
                                                    "speaker": "派蒙",
                                                    "text": "欸？！欸？！等等！它好像动了一下！",
                                                    "choices": [
                                                        {
                                                            "id": "750940617",
                                                            "text": "那要不再等等…？",
                                                            "response": [
                                                                {
                                                                    "id": "750940618",
                                                                    "speaker": "Black Screen",
                                                                    "text": "又经过了一段漫长的时间…\\n龙蛋仍然一切如故，没有任何的反应，更没有任何即将要破壳而出的迹象。"
                                                                },
                                                                {
                                                                    "id": "750940619",
                                                                    "speaker": "派蒙",
                                                                    "text": "还是没有反应…不会是孵化器坏了吧…可它明明都亮起来了！难道问题出在龙蛋上？"
                                                                },
                                                                {
                                                                    "id": "750940620",
                                                                    "speaker": "派蒙",
                                                                    "text": "——唔，感觉再这样等下去也不是办法…要不然，我们把龙蛋带走吧？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750940621",
                                                                            "text": "再饿也不能想着吃龙蛋哦…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940622",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "哇！哇！"
                                                                                },
                                                                                {
                                                                                    "id": "750940623",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#才不会吃呢！不要让{REALNAME[ID(2)|SHOWHOST(true)]}产生奇怪的误解呀！"
                                                                                },
                                                                                {
                                                                                    "id": "750940626",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "小家伙，我的意思是说，如果问题真的出在龙蛋身上的话，那这颗龙蛋它可能永远都…"
                                                                                },
                                                                                {
                                                                                    "id": "750940634",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "呜…"
                                                                                },
                                                                                {
                                                                                    "id": "750940635",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#别伤心，{REALNAME[ID(2)|SHOWHOST(true)]}，这也是没有办法的事情…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "750940636",
                                                                                            "text": "或许，只是这里的环境不适宜…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "750940638",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "说、说得对！孵不出来可能是因为龙蛋觉得现在的纳塔和以前一样，不适合当它的家呢！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940639",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "毕竟，它一直藏在这里，根本不可能知道外面已经变得多棒了！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940640",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "所以，我们把它带回去好好照顾吧！每天都给它讲故事！讲漂亮的风景、精彩的冒险、还有那些很好很好的人！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940641",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "总而言之，告诉它现在的纳塔有多棒！等它心动了，一定会自己主动破壳而出的！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940642",
                                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                                    "text": "…啵嗯。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "750940637",
                                                                                            "text": "或许，是它认为还不是时候…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750940624",
                                                                            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}，你怎么看？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940625",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "嗯…嗯？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750940627",
                                                            "text": "根本没有。",
                                                            "response": [
                                                                {
                                                                    "id": "750940628",
                                                                    "speaker": "派蒙",
                                                                    "text": "#欸？！可是…刚才明明…难道是我的错觉？不对，不对，{REALNAME[ID(2)|SHOWHOST(true)]}，你刚才看到了吗？"
                                                                },
                                                                {
                                                                    "id": "750940629",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "嗯…嗯？"
                                                                },
                                                                {
                                                                    "id": "750940630",
                                                                    "speaker": "派蒙",
                                                                    "text": "#啊…小家伙也没看到？难道真的只是我的错觉而已？那怎么办，{NICKNAME}，我们还要继续等下去吗？"
                                                                },
                                                                {
                                                                    "id": "750940631",
                                                                    "speaker": "派蒙",
                                                                    "text": "还是说…问题出在龙蛋上？可、可是，如果问题真的出在龙蛋上，那不就意味着永远孵不出来了吗？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750940632",
                                            "text": "问题应该出在龙蛋上。",
                                            "response": [
                                                {
                                                    "id": "750940633",
                                                    "speaker": "派蒙",
                                                    "text": "啊？那、那就是说，这颗龙蛋有可能永远孵不出来了？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750940604",
                            "text": "哼，不过如此。",
                            "response": [
                                {
                                    "id": "750940605",
                                    "speaker": "派蒙",
                                    "text": "就是！张牙舞爪的，我还以为是什么特别厉害的角色呢！结果就这，这样的攻击还不如小家伙撞人痛呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
