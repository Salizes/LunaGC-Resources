    "talks": [
        {
            "id": "7905401",
            "objective": "与高山上的杰洛尼对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790540101",
                    "speaker": "杰洛尼",
                    "text": "咦，你们怎么到这里来了？这里没有轨道，也很高，又在整个琉形蜃境边缘的位置。"
                },
                {
                    "id": "790540102",
                    "speaker": "杰洛尼",
                    "text": "平时很少有人会到这边来，就连伊迪娅…哼哼，我怀疑她自己都压根不知道有这么个地方。"
                },
                {
                    "id": "790540103",
                    "speaker": "派蒙",
                    "text": "这里什么都没有嘛，杰洛尼在这里做什么呢？"
                },
                {
                    "id": "790540104",
                    "speaker": "杰洛尼",
                    "text": "我只是稍微出来散散心啦…咦，别用那种「不会又和费迪南德吵架，所以离家出走了吧！」的眼神看我。"
                },
                {
                    "id": "790540105",
                    "speaker": "杰洛尼",
                    "text": "没有，真的没有吵架，我之所以会到处跑是出于，呃，该怎么说，是出于个人兴趣。"
                },
                {
                    "id": "790540106",
                    "speaker": "杰洛尼",
                    "text": "之前不是也说过吗，「呼呼飞车」一开始的想法是我提出的，那时我的想法就是，有什么东西能够轻松爬到高处就好了…"
                },
                {
                    "id": "790540107",
                    "speaker": "杰洛尼",
                    "text": "所以我…所以杰洛尼才想出了飞车和轨道，那是因为喜欢天空和高处。"
                },
                {
                    "id": "790540108",
                    "speaker": "杰洛尼",
                    "text": "很像个傻瓜吧，我记得稻妻也有那种谚语，什么只有脑子不好使的人和烟喜欢往上跑之类的…",
                    "choices": [
                        {
                            "id": "790540109",
                            "text": "能想到飞车就很了不起。",
                            "response": [
                                {
                                    "id": "790540111",
                                    "speaker": "杰洛尼",
                                    "text": "但是在琉形蜃境中，才能建起这样的飞车。"
                                },
                                {
                                    "id": "790540112",
                                    "speaker": "杰洛尼",
                                    "text": "…算了，不提这个。我到这里来的原因还有一个，那就是为了观赏这里的星空。"
                                },
                                {
                                    "id": "790540113",
                                    "speaker": "杰洛尼",
                                    "text": "虽然琉形蜃境的星空应该也只是瓶外星空的折影，但是对我来说也足够美丽了。"
                                },
                                {
                                    "id": "790540114",
                                    "speaker": "杰洛尼",
                                    "text": "每天晚上…只要看着这片星空，心中就会感受到无比的安宁。"
                                },
                                {
                                    "id": "790540115",
                                    "speaker": "Player",
                                    "text": "喜欢星空的，是杰洛尼吗…"
                                },
                                {
                                    "id": "790540116",
                                    "speaker": "杰洛尼",
                                    "text": "只要看到那样的星空，不管谁都会喜欢上的。真是可惜啊，如果白天也能看到星空就好了。"
                                },
                                {
                                    "id": "790540117",
                                    "speaker": "杰洛尼",
                                    "text": "当然了，如果不用每天爬到这里也能看到那就更好了，哈哈。"
                                },
                                {
                                    "id": "790540118",
                                    "speaker": "派蒙",
                                    "text": "啊，这样的办法！我想到了一个！"
                                },
                                {
                                    "id": "790540119",
                                    "speaker": "杰洛尼",
                                    "text": "咦，真的有这样的办法吗？"
                                },
                                {
                                    "id": "790540120",
                                    "speaker": "Player",
                                    "text": "只要拍摄画片就好了…"
                                },
                                {
                                    "id": "790540121",
                                    "speaker": "杰洛尼",
                                    "text": "…画、画片？原来现在还有那么先进的东西。"
                                },
                                {
                                    "id": "790540122",
                                    "speaker": "派蒙",
                                    "text": "嗯，不如我们拍一张星空的画片给杰洛尼看吧！"
                                },
                                {
                                    "id": "790540123",
                                    "speaker": "杰洛尼",
                                    "text": "真的可以吗？"
                                },
                                {
                                    "id": "790540124",
                                    "speaker": "Player",
                                    "text": "当然可以。"
                                },
                                {
                                    "id": "790540125",
                                    "speaker": "派蒙",
                                    "text": "不过，不知道哪里能拍出好看的星空呢…"
                                },
                                {
                                    "id": "790540126",
                                    "speaker": "杰洛尼",
                                    "text": "啊，这里！夜晚，在这边的平台上，能看到最漂亮的星空，这也是为什么我爬到这里来的原因。"
                                },
                                {
                                    "id": "790540127",
                                    "speaker": "派蒙",
                                    "text": "这样啊，好！杰洛尼你就等我们的画片吧！"
                                }
                            ]
                        },
                        {
                            "id": "790540110",
                            "text": "飞车很有趣哦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7905402",
            "objective": "等待至夜晚（19点—5点）",
            "dialogues": [
                {
                    "id": "790540201",
                    "speaker": "开始拍照",
                    "text": "占位"
                }
            ]
        },
        {
            "id": "7905403",
            "objective": "前往高处平台拍摄星空",
            "dialogues": [
                {
                    "id": "790540301",
                    "speaker": "派蒙",
                    "text": "杰洛尼！我们回来啦，你看，这就是我们说的画片。"
                },
                {
                    "id": "790540302",
                    "speaker": "杰洛尼",
                    "text": "…真的，看上去跟真的一模一样。"
                },
                {
                    "id": "790540303",
                    "speaker": "杰洛尼",
                    "text": "这张画片，真的能给我吗？"
                },
                {
                    "id": "790540304",
                    "speaker": "派蒙",
                    "text": "本来就是为你拍的啦！"
                },
                {
                    "id": "790540305",
                    "speaker": "杰洛尼",
                    "text": "哈哈，谢谢…谢谢你们，没想到我还能看到这么厉害的技术。已经都有这样的技术了，说不定在蜃境之外能看到飞车也不是梦。"
                },
                {
                    "id": "790540306",
                    "speaker": "杰洛尼",
                    "text": "真是漂亮的星空啊，如果那个时候有这样的技术就好了，这样…他也可以随时看到这片星空了吧…"
                }
            ]
        },
        {
            "id": "7905404",
            "objective": "回报杰洛尼",
            "dialogues": []
        },
        {
            "id": "7905404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790540401",
                    "speaker": "杰洛尼",
                    "text": "画片啊…现在居然有这么神奇的东西，这样应该也能轻松记录沿途的风景吧。"
                },
                {
                    "id": "790540402",
                    "speaker": "杰洛尼",
                    "text": "#怎么了，{NICKNAME}，拍下画片了吗？我可是很期待你在那里拍出的星空呢。"
                }
            ]
        }
    ]
}