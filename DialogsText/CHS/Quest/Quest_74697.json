            "芭比洛斯": 18
        }
    },
    "talks": [
        {
            "id": "7469701",
            "objective": "与梦见月瑞希对话",
            "dialogues": [
                {
                    "id": "746970101",
                    "speaker": "派蒙",
                    "text": "咦？那不是瑞希和她的两位小貘吗？已经和芭比洛斯女士聊上了？"
                },
                {
                    "id": "746970102",
                    "speaker": "梦见月瑞希",
                    "text": "#{NICKNAME}和派蒙…？我刚听芭比洛斯女士提起你们，还想着，能不能和你们巧遇呢。"
                },
                {
                    "id": "746970103",
                    "speaker": "梦见月瑞希",
                    "text": "呵…现在看来，「命运」已经安排好我们相汇的地点了。"
                },
                {
                    "id": "746970104",
                    "speaker": "Player",
                    "text": "瑞希是来旅行的吗？"
                },
                {
                    "id": "746970105",
                    "speaker": "梦见月瑞希",
                    "text": "嗯…算是吧。如果那部心理知识科普映影的筹备工作顺利的话，我确实可以去周围散散心。但在那之前，还是得专注工作才行。",
                    "choices": [
                        {
                            "id": "746970106",
                            "text": "心理知识的映影？",
                            "response": [
                                {
                                    "id": "746970108",
                                    "speaker": "派蒙",
                                    "text": "映影还能干这个？听起来好厉害喔。"
                                },
                                {
                                    "id": "746970109",
                                    "speaker": "梦见月瑞希",
                                    "text": "嗯，是我刚琢磨出来的新想法。之前宣传「秋沙钱汤」时，我就参考了枫丹映影，录制了几期综艺节目。"
                                },
                                {
                                    "id": "746970110",
                                    "speaker": "梦见月瑞希",
                                    "text": "大家对那几期映影很感兴趣，不仅每一期都看得很仔细，甚至连节目里讲的那些心理学知识都记得很牢。"
                                },
                                {
                                    "id": "746970111",
                                    "speaker": "梦见月瑞希",
                                    "text": "我就想，不如直接以「心理疾病」为题材拍摄几部映影，以这种寓教于乐的方式，为大家讲解一些心理学常识吧。"
                                },
                                {
                                    "id": "746970112",
                                    "speaker": "梦见月瑞希",
                                    "text": "…具备了常识之后，大家或许对于「心理疾病」就能有一个初步的客观认知。"
                                },
                                {
                                    "id": "746970157",
                                    "speaker": "梦见月瑞希",
                                    "text": "…而不是盲目地将这个客观存在的病症视为无稽之谈，或者是洪水猛兽。"
                                },
                                {
                                    "id": "746970113",
                                    "speaker": "梦见月瑞希",
                                    "text": "这样一来，我为大家做诊疗时，说不定也会更顺利一些吧…",
                                    "choices": [
                                        {
                                            "id": "746970114",
                                            "text": "瑞希思考得好多…",
                                            "response": [
                                                {
                                                    "id": "746970116",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "是啊。毕竟心的病症无形无色，想要抓住…甚至意识到它的存在，都并不是一件容易的事。"
                                                },
                                                {
                                                    "id": "746970117",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "呵…我甚至都不知道，怎么将它抓起来，然后融入映影的剧本里…"
                                                },
                                                {
                                                    "id": "746970118",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "说来惭愧，虽然我平时也写了不少有关心理疾病的论文，但在写映影剧本的时候，却格外卡壳。"
                                                },
                                                {
                                                    "id": "746970119",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "有的时候，我一整天都要闷在房间里，围绕着几行对白，几十秒的情节去反复推敲，最后可能还得不到结果。",
                                                    "choices": [
                                                        {
                                                            "id": "746970120",
                                                            "text": "感觉好辛苦…",
                                                            "response": [
                                                                {
                                                                    "id": "746970122",
                                                                    "speaker": "派蒙",
                                                                    "text": "#也许只差一点灵感？我和{NICKNAME}被一件事卡住的时候，就去干点别的，说不定就「噼咔」一下想通了！"
                                                                },
                                                                {
                                                                    "id": "746970123",
                                                                    "speaker": "梦见月瑞希",
                                                                    "text": "嗯，小派蒙和我想的一样。所以我才会来到这里，想要体验一下这种和「御神签」完全不一样的占卜形式。"
                                                                },
                                                                {
                                                                    "id": "746970124",
                                                                    "speaker": "梦见月瑞希",
                                                                    "text": "希望，这位魔女的「月谕圣牌」，能为我带来一些别样的灵感。"
                                                                },
                                                                {
                                                                    "id": "746970125",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "灵感…之前安雅确实说，想要为「月谕圣牌」的每一张牌，都写一篇特别的童话故事。但她想写的故事太多，时间却…呵…"
                                                                },
                                                                {
                                                                    "id": "746970126",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "既然你想要寻找灵感，那就抽一张牌吧，妖怪小姐。希望那位魔女未完成的童话，能指引你寻觅到故事的灵光。"
                                                                },
                                                                {
                                                                    "id": "746970127",
                                                                    "speaker": "梦见月瑞希",
                                                                    "text": "好的，芭比洛斯女士。不过…我之前所知的「占卜」之事，大多和…鸣神大社有关。用卡牌来占卜还是第一次。"
                                                                },
                                                                {
                                                                    "id": "746970128",
                                                                    "speaker": "梦见月瑞希",
                                                                    "text": "要是有什么不符合仪式规范的行为，还请您及时纠正。"
                                                                },
                                                                {
                                                                    "id": "746970129",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "哎呀，逆位之「月」…"
                                                                },
                                                                {
                                                                    "id": "746970130",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "「月」的正逆位意义相似。「逃避」、「蒙蔽」、「自欺欺人」…"
                                                                },
                                                                {
                                                                    "id": "746970158",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "就像是行走在暗月下的人，迷失了前进的方向，却不知晓应当如何脱身。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746970131",
                                                                            "text": "听起来不太妙啊…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746970133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "是啊，怎么这张牌的释义，听起来和警告似的…怎么都感觉有点不太妙…"
                                                                                },
                                                                                {
                                                                                    "id": "746970134",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "不过，既然梦见月小姐还能听到这则预言，就说明事情还没有凶险到那个地步。"
                                                                                },
                                                                                {
                                                                                    "id": "746970135",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "稍加努力，说不定便能走出蒙蔽前路的阴霾，寻得企求之物…说不定是这样的。"
                                                                                },
                                                                                {
                                                                                    "id": "746970136",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "逃避与蒙蔽…还有「自欺欺人」么？"
                                                                                },
                                                                                {
                                                                                    "id": "746970137",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "单纯解读牌面的话，就是这样。用更直白的说法…"
                                                                                },
                                                                                {
                                                                                    "id": "746970138",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "大概意思就是，你正在逃避着某一个近在眼前的答案，甚至不惜舍近求远，也要远离它。"
                                                                                },
                                                                                {
                                                                                    "id": "746970139",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "这意思是说，能为我研判剧本的人，其实就近在眼前么？"
                                                                                },
                                                                                {
                                                                                    "id": "746970140",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "倒也不局限于剧本，不过，具体要如何理解牌面的寓意，就只能看你自己了。"
                                                                                },
                                                                                {
                                                                                    "id": "746970141",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "746970142",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "近在眼前的答案，舍近求远的逃避…我大概明白，这是在指向什么了。"
                                                                                },
                                                                                {
                                                                                    "id": "746970143",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "呵…这么说来。我的确是在「自欺欺人」…或者说，不由自主地开始「舍近求远」了。"
                                                                                },
                                                                                {
                                                                                    "id": "746970144",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "虽然我之前也想过去八重堂拜访，也向八重宫司请教一番，有关映影剧本的事，但却…"
                                                                                },
                                                                                {
                                                                                    "id": "746970145",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "如果从心理诊疗的角度来说，我这也算是「不自觉回避」了…"
                                                                                },
                                                                                {
                                                                                    "id": "746970146",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "感谢您的占卜，芭比洛斯女士，您果然为我找到了灵感。"
                                                                                },
                                                                                {
                                                                                    "id": "746970147",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "不必感谢我。我什么都没有做。是你自己为自己捋顺了命运的丝线，我只是把线头递到了你手里而已。"
                                                                                },
                                                                                {
                                                                                    "id": "746970148",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "只不过，那位八重宫司也是位被命运裹挟之人。"
                                                                                },
                                                                                {
                                                                                    "id": "746970149",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "丝线的交缠往往会带来麻烦，从这个角度来说，你与她保持距离，倒也不是一件完全的坏事。"
                                                                                },
                                                                                {
                                                                                    "id": "746970150",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "如果只是请八重宫司帮忙看看映影稿件，给些意见，想必也牵涉不到那些「命运」吧。"
                                                                                },
                                                                                {
                                                                                    "id": "746970151",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "正如我先前所说，这要看你如何理解，梦见月小姐。我无法从一张牌里看到你未来的全部细节。"
                                                                                },
                                                                                {
                                                                                    "id": "746970152",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "在真正被命运绊倒之前，又有谁能发现路上的绊线呢？"
                                                                                },
                                                                                {
                                                                                    "id": "746970153",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "有时候，就和那个小丫头说的一样…"
                                                                                },
                                                                                {
                                                                                    "id": "746970154",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "「…正是因为无法更改，无可违逆，只能接受，命运才会被称之为命运。」"
                                                                                },
                                                                                {
                                                                                    "id": "746970155",
                                                                                    "speaker": "梦见月瑞希",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "746970156",
                                                                                    "speaker": "芭比洛斯",
                                                                                    "text": "总之，妖怪小姐，我还是很期待那部「映影」的。呵呵呵呵呵…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746970132",
                                                                            "text": "听起来有点消极…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746970121",
                                                            "text": "需要适当放松…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746970115",
                                            "text": "原来是这么复杂的考量…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746970107",
                            "text": "心理诊疗的延伸？"
                        }
                    ]
                }
            ]
        },
        {
