    "talks": [
        {
            "id": "2502101",
            "objective": "与卡兹加对话",
            "dialogues": [
                {
                    "id": "250210101",
                    "speaker": "卡兹加",
                    "text": "霍莱，这次你可不能乱跑了。"
                },
                {
                    "id": "250210102",
                    "speaker": "霍莱",
                    "text": "呜，呜…"
                },
                {
                    "id": "250210103",
                    "speaker": "Player",
                    "text": "今天霍莱很听话啊。"
                },
                {
                    "id": "250210104",
                    "speaker": "卡兹加",
                    "text": "是啊。多亏了你帮我做的那个「漂流球」。"
                },
                {
                    "id": "250210105",
                    "speaker": "卡兹加",
                    "text": "有了这个球，我也能引导霍莱去做各种事。不管是洗澡，吃东西，睡觉还是训练，都方便了很多。"
                },
                {
                    "id": "250210106",
                    "speaker": "卡兹加",
                    "text": "特别是修剪指甲这件事！要是放在之前，我光是追霍莱都能追到累瘫。"
                },
                {
                    "id": "250210107",
                    "speaker": "卡兹加",
                    "text": "现在只要把球放在霍莱面前，这小伙子就会乖乖坐下了。"
                },
                {
                    "id": "250210108",
                    "speaker": "霍莱",
                    "text": "呜呜，呜…"
                },
                {
                    "id": "250210109",
                    "speaker": "卡兹加",
                    "text": "#霍莱，你记得{M#他}{F#她}吗？这可是帮你做玩具的人。"
                },
                {
                    "id": "250210110",
                    "speaker": "霍莱",
                    "text": "呜呜，呜呜！",
                    "choices": [
                        {
                            "id": "250210111",
                            "text": "乖乖喔。",
                            "response": [
                                {
                                    "id": "250210113",
                                    "speaker": "卡兹加",
                                    "text": "喔！霍莱记得你啊，看起来还挺开心的。"
                                },
                                {
                                    "id": "250210114",
                                    "speaker": "卡兹加",
                                    "text": "你要试试给它剪指甲吗？顺便再擦擦它的角。"
                                },
                                {
                                    "id": "250210115",
                                    "speaker": "卡兹加",
                                    "text": "这对小嵴锋龙来说可是一件很重要的事，毕竟它们可是要挖岩掘土，爪子必须要时常打磨，并且修剪那些长歪，或者被撞坏的指甲。"
                                },
                                {
                                    "id": "250210116",
                                    "speaker": "卡兹加",
                                    "text": "只有这样，才能保证小嵴锋龙在长大之后拥有一对最完美的爪子…"
                                },
                                {
                                    "id": "250210117",
                                    "speaker": "卡兹加",
                                    "text": "来，拿着这个！咱们正好趁这个修剪指甲的机会，把霍莱的全身都收拾一下！",
                                    "choices": [
                                        {
                                            "id": "250210118",
                                            "text": "你说得真详细…",
                                            "response": [
                                                {
                                                    "id": "250210120",
                                                    "speaker": "霍莱",
                                                    "text": "呜呜，呜——"
                                                },
                                                {
                                                    "id": "250210121",
                                                    "speaker": "卡兹加",
                                                    "text": "咳…难得看见霍莱这么听话。一想到今天我不用追着霍莱跑遍整个部族，我就不由自主地高兴…"
                                                },
                                                {
                                                    "id": "250210122",
                                                    "speaker": "Player",
                                                    "text": "…真是辛苦你了。"
                                                },
                                                {
                                                    "id": "250210123",
                                                    "speaker": "卡兹加",
                                                    "text": "没什么！那我们就开始吧，我会在旁边指导你的。"
                                                },
                                                {
                                                    "id": "250210124",
                                                    "speaker": "卡兹加",
                                                    "text": "为了让霍莱放松，你首先得用大刷子轻轻清理它的后背…"
                                                },
                                                {
                                                    "id": "250210130",
                                                    "speaker": "卡兹加",
                                                    "text": "再用细毛刷清理它的角，这个时候要用点力道，否则就会漏掉一些缝隙中的污渍。"
                                                },
                                                {
                                                    "id": "250210125",
                                                    "speaker": "卡兹加",
                                                    "text": "然后呢，拿毛巾擦洗霍莱的全身…这样，它就会慢慢放松，四足上的爪子也会伸出来，这个时候，就可以为它修剪指甲了。",
                                                    "choices": [
                                                        {
                                                            "id": "250210126",
                                                            "text": "这也太详细了。",
                                                            "response": [
                                                                {
                                                                    "id": "250210128",
                                                                    "speaker": "卡兹加",
                                                                    "text": "那当然。霍莱可是我一手带大的。整个部族…不，整个纳塔也找不到比我更了解它的人了。"
                                                                },
                                                                {
                                                                    "id": "250210129",
                                                                    "speaker": "卡兹加",
                                                                    "text": "好了，你就按照我刚才说的，帮霍莱修剪一下指甲吧。我就在旁边，不明白的话来问我就行。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "250210127",
                                                            "text": "你真是了解霍莱…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250210119",
                                            "text": "你怎么突然变兴奋了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250210112",
                            "text": "（摸摸霍莱。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502102",
            "objective": "摸摸霍莱",
            "dialogues": [
                {
                    "id": "250212609",
                    "speaker": "霍莱",
                    "text": "（霍莱逐渐放松了下来。它舒展全身，四足的爪子也伸了出来。看起来是时候为它修剪指甲了。）"
                },
                {
                    "id": "250212610",
                    "speaker": "Black Screen",
                    "text": "在卡兹加的指导下，为霍莱细致地修剪了指甲。"
                },
                {
                    "id": "250212601",
                    "speaker": "卡兹加",
                    "text": "哈哈哈，没看出来，你还挺擅长做这件事的啊。"
                },
                {
                    "id": "250212602",
                    "speaker": "霍莱",
                    "text": "呜呜，呜呜，呜——"
                },
                {
                    "id": "250212603",
                    "speaker": "卡兹加",
                    "text": "霍莱也在谢谢你呢。你修剪得这么仔细，霍莱挖土的时候肯定能挖得更快。"
                },
                {
                    "id": "250212604",
                    "speaker": "卡兹加",
                    "text": "这些东西给你，就当做是谢礼吧。呃…对了，我得叮嘱你一句，你之后要是得照顾其他小龙，可不能照搬今天的方法啊。"
                },
                {
                    "id": "250212605",
                    "speaker": "卡兹加",
                    "text": "每一只小龙的脾气都不一样，照顾它们的方法也不一样，我折腾到现在，也就只弄懂了怎么照顾霍莱。"
                },
                {
                    "id": "250212606",
                    "speaker": "卡兹加",
                    "text": "不过，能弄懂这件事我就已经知足了。毕竟，我们俩可要继续相处很久…"
                },
                {
                    "id": "250212607",
                    "speaker": "卡兹加",
                    "text": "咦？霍莱去哪了？不，不会是又跑了吧！"
                },
                {
                    "id": "250212608",
                    "speaker": "卡兹加",
                    "text": "喂！霍莱——"
                }
            ]
        },
        {
            "id": "2502103",
            "objective": "(test)子任务描述Test$HIDDEN",
            "dialogues": [
                {
                    "id": "250213701",
                    "speaker": "霍莱",
                    "text": "（霍莱歪了歪脑袋，挠了挠自己的肚子，迷茫地看着你。）"
                },
                {
                    "id": "250213702",
                    "speaker": "卡兹加",
                    "text": "你可不能一直光顾着和霍莱玩呀。还有正事要做。"
                },
                {
                    "id": "250213703",
                    "speaker": "卡兹加",
                    "text": "咳！还是我来吧。让我给你示范一下，正确的刷洗方法。"
                },
                {
                    "id": "250213704",
                    "speaker": "霍莱",
                    "text": "（卡兹加及时接手了工作。在又一阵细致的打理后，终于还是为霍莱修剪了指甲…）"
                },
                {
                    "id": "250213705",
                    "speaker": "卡兹加",
                    "text": "你可不能光顾着和霍莱玩啊，还是先做正事比较好。"
                },
                {
                    "id": "250213706",
                    "speaker": "霍莱",
                    "text": "呜！呜呜呜！"
                },
                {
                    "id": "250213707",
                    "speaker": "卡兹加",
                    "text": "哈哈哈哈，但霍莱看起来还挺喜欢和你玩的，难怪这次刷洗的时候它这么听话。"
                },
                {
                    "id": "250213708",
                    "speaker": "卡兹加",
                    "text": "无论如何，这次还是多谢你了。这些东西给你，就当做是谢礼吧。"
                },
                {
                    "id": "250213709",
                    "speaker": "卡兹加",
                    "text": "唔，要不然…我之后也试试，先陪霍莱玩个痛快，再给它刷洗…？"
                },
                {
                    "id": "250213710",
                    "speaker": "卡兹加",
                    "text": "霍莱，你觉得这个主意怎么样？"
                },
                {
                    "id": "250213711",
                    "speaker": "卡兹加",
                    "text": "咦？霍莱去哪了？不，不会是又跑了吧！"
                },
                {
                    "id": "250213712",
                    "speaker": "卡兹加",
                    "text": "喂！霍莱——"
                }
            ]
        },
