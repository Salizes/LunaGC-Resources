        {
            "id": "1503308",
            "objective": "(test)伊安珊常驻对话$HIDDEN",
            "dialogues": [
                {
                    "id": "150330801",
                    "speaker": "瓦雷莎",
                    "text": "欸，是伊安珊老师！你正好要训练吗？"
                },
                {
                    "id": "150330802",
                    "speaker": "伊安珊",
                    "text": "哦不是，今天总算有时间，我想保养一下院子里的这些设备。"
                },
                {
                    "id": "150330803",
                    "speaker": "伊安珊",
                    "text": "欸，是你们！欢迎你们到「沃陆之邦」来！"
                },
                {
                    "id": "150330804",
                    "speaker": "伊安珊",
                    "text": "快看，我前几天在竞技场买了这个。"
                },
                {
                    "id": "150330805",
                    "speaker": "派蒙",
                    "text": "哦，这上面是我们之前见过的涂鸦！"
                },
                {
                    "id": "150330806",
                    "speaker": "伊安珊",
                    "text": "现在可难买了，我排了好久的队才买到，哈哈哈。"
                },
                {
                    "id": "150330807",
                    "speaker": "瓦雷莎",
                    "text": "我也有件画上这个涂鸦的衣服，我挂在床头了，嘿嘿。",
                    "choices": [
                        {
                            "id": "150330808",
                            "text": "没错，正是大名鼎鼎的我。",
                            "response": [
                                {
                                    "id": "150330809",
                                    "speaker": "瓦雷莎",
                                    "text": "下次麻烦你给我的衣服签名吧，我会珍藏起来！"
                                },
                                {
                                    "id": "150330812",
                                    "speaker": "伊安珊",
                                    "text": "对了，你们来这里，有什么安排吗？"
                                }
                            ]
                        },
                        {
                            "id": "150330810",
                            "text": "有点不好意思…",
                            "response": [
                                {
                                    "id": "150330811",
                                    "speaker": "伊安珊",
                                    "text": "哈哈哈，受欢迎是件好事啊，这是你应有的待遇。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503303",
            "objective": "前往果园，与瓦雷莎交谈",
            "dialogues": [
                {
                    "id": "150331401",
                    "speaker": "瓦娜娜",
                    "text": "呜呜——"
                },
                {
                    "id": "150331402",
                    "speaker": "瓦雷莎",
                    "text": "辛苦你看家啦，瓦娜娜。我看看，我看看，你是不是又变壮了。"
                },
                {
                    "id": "150331403",
                    "speaker": "瓦娜娜",
                    "text": "呜呜！"
                },
                {
                    "id": "150331404",
                    "speaker": "瓦雷莎",
                    "text": "哈哈，我只是要看看，没有要角力的意思。下次吧，下次吧。"
                },
                {
                    "id": "150331405",
                    "speaker": "瓦雷莎",
                    "text": "它是瓦娜娜，平时果园没人的时候，它就会守在这里，是个很靠谱，也很黏人的小家伙。"
                },
                {
                    "id": "150331406",
                    "speaker": "派蒙",
                    "text": "小、小家伙吗？已经足够强壮了…"
                },
                {
                    "id": "150331407",
                    "speaker": "瓦雷莎",
                    "text": "来吧，进来，这里就是我家的果园。"
                },
                {
                    "id": "150331408",
                    "speaker": "派蒙",
                    "text": "哇，里面比想象中还要大！"
                },
                {
                    "id": "150331409",
                    "speaker": "派蒙",
                    "text": "到处都是果子，看起来每个都很好吃！"
                },
                {
                    "id": "150331410",
                    "speaker": "瓦雷莎",
                    "text": "嘿嘿，我们这里叫「沃陆之邦」，有个原因就是临近火山，所以土地很肥沃，种什么都好吃。"
                },
                {
                    "id": "150331411",
                    "speaker": "瓦雷莎",
                    "text": "果子很受欢迎，我们不仅一直在往外卖，也留好多自己吃，还送亲朋好友。"
                },
                {
                    "id": "150331412",
                    "speaker": "派蒙",
                    "text": "原来如此，我之前还在想怎么会有部族住在火山下面，居然还有这种好处。"
                },
                {
                    "id": "150331413",
                    "speaker": "瓦雷莎",
                    "text": "是啊。对了，既然都到这里了，我们摘点果子吃吧。"
                },
                {
                    "id": "150331414",
                    "speaker": "派蒙",
                    "text": "欸，你不是刚吃过饭吗？"
                },
                {
                    "id": "150331415",
                    "speaker": "瓦雷莎",
                    "text": "水果是餐后甜点，不会和正餐抢位置。只是吃三五十个的话，不会有事的。",
                    "choices": [
                        {
                            "id": "150331416",
                            "text": "三、三五十个…",
                            "response": [
                                {
                                    "id": "150331418",
                                    "speaker": "瓦雷莎",
                                    "text": "哈哈，小的时候，我爸爸在门口的水果铺卖水果，我扯他的衣服，他就会塞给我一个果子。"
                                },
                                {
                                    "id": "150331419",
                                    "speaker": "瓦雷莎",
                                    "text": "我吃得飞快，吃完又找他要一个，结果越来越多人围上来，都是来看我吃水果的。"
                                },
                                {
                                    "id": "150331420",
                                    "speaker": "瓦雷莎",
                                    "text": "爸爸说，因为我吃得很香，买水果的人都变多了。我能帮上爸爸的忙，特别开心，于是吃得更多了。"
                                },
                                {
                                    "id": "150331421",
                                    "speaker": "瓦雷莎",
                                    "text": "客人买完果子都会摸摸我的头，还夸我，说「这么能吃的小孩子以后一定能长得很好」。"
                                },
                                {
                                    "id": "150331422",
                                    "speaker": "瓦雷莎",
                                    "text": "我就傻傻地看着他们笑，过一会儿我爸爸也开始笑，来帮忙的妈妈也笑…"
                                },
                                {
                                    "id": "150331423",
                                    "speaker": "派蒙",
                                    "text": "好温馨的画面啊，真是羡慕。"
                                },
                                {
                                    "id": "150331424",
                                    "speaker": "瓦雷莎",
                                    "text": "但总归还是因为家里种的水果很好吃，大家才愿意来照顾生意。我可不是自吹自擂哦，你们马上就会理解了。"
                                },
                                {
                                    "id": "150331425",
                                    "speaker": "瓦雷莎",
                                    "text": "正好过几天会有「豪宴热斗」，我们家也会赞助很多水果当甜点的原料。"
                                },
                                {
                                    "id": "150331426",
                                    "speaker": "派蒙",
                                    "text": "「豪宴热斗」？"
                                },
                                {
                                    "id": "150331427",
                                    "speaker": "瓦雷莎",
                                    "text": "嗯，简单来说，就是像大胃王比赛一样的活动，需要准备很多很多的食材。"
                                },
                                {
                                    "id": "150331428",
                                    "speaker": "瓦雷莎",
                                    "text": "所以，放心地摘，我也会一起摘的，不用担心浪费！"
                                },
                                {
                                    "id": "150331429",
                                    "speaker": "派蒙",
                                    "text": "好！让我看看，从哪里开始…"
                                },
                                {
                                    "id": "150331430",
                                    "speaker": "派蒙",
                                    "text": "欸，怎么那边有…蘑菇？"
                                },
                                {
                                    "id": "150331431",
                                    "speaker": "瓦雷莎",
                                    "text": "哦，这个蘑菇啊，是建果园的时候不知从哪里长出来的。"
                                },
                                {
                                    "id": "150331432",
                                    "speaker": "瓦雷莎",
                                    "text": "它不用浇水也不用施肥，长得可快了，肉质肥美，味道特别好。"
                                },
                                {
                                    "id": "150331433",
                                    "speaker": "瓦雷莎",
                                    "text": "不仅适合拿来炒和油煎，就连生吃都很好吃，一股水果味！"
                                },
                                {
                                    "id": "150331434",
                                    "speaker": "派蒙",
                                    "text": "水果味的蘑菇？没听说过啊。"
                                },
                                {
                                    "id": "150331435",
                                    "speaker": "Player",
                                    "text": "或许是吸收了周围果树的养分。"
                                },
                                {
                                    "id": "150331436",
                                    "speaker": "瓦雷莎",
                                    "text": "应该是，如果吃起来像水果，那它就可以算水果，不用太在意来历啦。"
                                },
                                {
                                    "id": "150331437",
                                    "speaker": "瓦雷莎",
                                    "text": "来吧，想摘多少摘多少，再摘一些蘑菇吧，等会儿一起做给你们吃！"
                                }
                            ]
                        },
                        {
                            "id": "150331417",
                            "text": "你的胃口确实很好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503304",
            "objective": "采摘果实，准备接下来的烹饪",
            "dialogues": []
        },
        {
            "id": "1503305",
            "objective": "与瓦雷莎交谈",
            "dialogues": [
                {
                    "id": "150331501",
                    "speaker": "瓦雷莎",
                    "text": "原来摘了这么多，真了不起！"
                },
                {
                    "id": "150331502",
                    "speaker": "派蒙",
                    "text": "因为你说「豪宴热斗」需要很多原料嘛，我们可不能白吃不帮忙。"
                },
                {
                    "id": "150331503",
                    "speaker": "派蒙",
                    "text": "我刚刚尝过了，确实很好吃，汁水丰富，甜味充足，一定是市场里最先卖断货的果子！"
                },
                {
                    "id": "150331504",
                    "speaker": "派蒙",
                    "text": "蘑菇我也吃了，蘑菇原本的香味背后居然有股淡淡的果香，真不可思议。"
                },
                {
                    "id": "150331505",
                    "speaker": "派蒙",
                    "text": "我就叫它「果果菇」吧！",
                    "choices": [
                        {
                            "id": "150331506",
                            "text": "可以相信派蒙的判断。",
                            "response": [
                                {
                                    "id": "150331507",
                                    "speaker": "派蒙",
                                    "text": "是吧，毕竟已经走过那么多地方，尝了各种各样的美食，我舌头的记性和脑袋一样好！"
                                },
                                {
                                    "id": "150331510",
                                    "speaker": "瓦雷莎",
                                    "text": "谢谢你们，既然这样我也提前收工吧，说好了要给你做蘑菇吃，稍等一下。"
                                },
                                {
                                    "id": "150331511",
                                    "speaker": "Black Screen",
                                    "text": "瓦雷莎快速烹饪了几下，热气腾腾的蘑菇菜肴便端到了你们面前。"
                                },
                                {
                                    "id": "150331512",
                                    "speaker": "瓦雷莎",
                                    "text": "我手艺不太精湛，请不要在意，但只要原料足够好，简单做一做就会特别好吃。"
                                },
                                {
                                    "id": "150331513",
                                    "speaker": "派蒙",
                                    "text": "没有没有，闻上去超级香，蘑菇的香味浓郁了很多，感觉肯定很美味。"
                                },
                                {
                                    "id": "150331514",
                                    "speaker": "派蒙",
                                    "text": "唔，这个味道，和生吃又完全不同了！",
                                    "choices": [
                                        {
                                            "id": "150331515",
                                            "text": "各有各的风味。",
                                            "response": [
                                                {
                                                    "id": "150331517",
                                                    "speaker": "瓦雷莎",
                                                    "text": "哈哈哈，你们喜欢就好。"
                                                },
                                                {
                                                    "id": "150331518",
                                                    "speaker": "瓦雷莎",
                                                    "text": "这种蘑菇在「沃陆之邦」很受欢迎，不过还没怎么在外面出名。"
                                                },
                                                {
                                                    "id": "150331519",
                                                    "speaker": "瓦雷莎",
                                                    "text": "这次的「豪宴热斗」，也有推广这个蘑菇的目的在里面，阿托力叔叔为了更新菜单下足了功夫。"
                                                },
                                                {
                                                    "id": "150331520",
                                                    "speaker": "瓦雷莎",
                                                    "text": "如果你们感兴趣的话，到时候也可以来参加！"
                                                },
                                                {
                                                    "id": "150331521",
                                                    "speaker": "Player",
                                                    "text": "你有兴趣吗？"
                                                },
                                                {
                                                    "id": "150331522",
                                                    "speaker": "派蒙",
                                                    "text": "我？「豪宴热斗」…嗯，当然要参加！虽然我不知道能吃多少…"
                                                },
                                                {
                                                    "id": "150331523",
                                                    "speaker": "瓦雷莎",
                                                    "text": "没关系，不用担心会浪费，如果你吃不完，告诉我，我会来帮你的。"
                                                },
                                                {
                                                    "id": "150331524",
                                                    "speaker": "派蒙",
                                                    "text": "那我就放心了…欸，不对，我们应该是对手吧，跟你比要怎么赢啊！"
                                                },
                                                {
                                                    "id": "150331525",
                                                    "speaker": "瓦雷莎",
                                                    "text": "不试试怎么知道呢，我觉得你的胃口也蛮不错啊。"
                                                },
                                                {
                                                    "id": "150331526",
                                                    "speaker": "瓦雷莎",
                                                    "text": "而且输赢不重要，就当成是一次品尝我们「沃陆之邦」美食的好机会嘛。"
                                                },
                                                {
                                                    "id": "150331527",
                                                    "speaker": "派蒙",
                                                    "text": "你说的有道理！"
                                                },
                                                {
                                                    "id": "150331528",
                                                    "speaker": "Player",
                                                    "text": "我也陪她吧。"
                                                },
                                                {
                                                    "id": "150331529",
                                                    "speaker": "派蒙",
                                                    "text": "好，那我们都要报名！等着吧，看我派蒙大显神通！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150331516",
                                            "text": "都很不错。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150331508",
                            "text": "有时可以相信派蒙的判断。",
                            "response": [
                                {
                                    "id": "150331509",
                                    "speaker": "派蒙",
                                    "text": "这个「有时」总感觉怪怪的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150330101",
                    "speaker": "伊安珊",
                    "text": "祝你们在「沃陆之邦」过得开心，我要准备训练了。呼——"
                }
            ]
        },
        {
            "id": "1503302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150330201",
                    "speaker": "瓦娜娜",
                    "text": "这里是，瓦雷莎的果园。要努力保护好，不可以让很坏的人和很坏的龙进去。"
                },
                {
                    "id": "150330202",
                    "speaker": "瓦娜娜",
                    "text": "可是，你的气息，不一样。是很好很好的朋友。所以，可以随便吃果子。吃得饱饱的，才会开心。瓦雷莎也这么说。"
                }
            ]
        },
        {
            "id": "1503305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150330501",
                    "speaker": "瓦雷莎",
                    "text": "欸，是伊安珊老师！听说你要参加归火圣夜巡礼，怎么回来了啊。"
                },
                {
                    "id": "150330502",
                    "speaker": "伊安珊",
                    "text": "哦，我临时想起有一些战斗用的消耗品快用完了，保险起见，还是回来取一趟。"
                },
                {
                    "id": "150330503",
                    "speaker": "伊安珊",
                    "text": "你们好，我在竞技场见过你们，就是你们在帮卡齐娜吧。"
                },
                {
                    "id": "150330504",
                    "speaker": "派蒙",
                    "text": "#嗯，我是派蒙，{M#他}{F#她}是{NICKNAME}！"
                },
                {
                    "id": "150330505",
                    "speaker": "伊安珊",
                    "text": "你们真厉害，卡齐娜一下子长进了很多，自信心也充足了不少。"
                },
                {
                    "id": "150330506",
                    "speaker": "伊安珊",
                    "text": "这次能夺得归火圣夜巡礼的优胜，也是她长年努力的结果，非常值得骄傲。"
                },
                {
                    "id": "150330507",
                    "speaker": "Player",
                    "text": "麻烦你和她见面再夸夸她。"
                },
                {
                    "id": "150330508",
                    "speaker": "伊安珊",
                    "text": "嗯，放心吧，我知道，这对她来说很重要。"
                },
                {
                    "id": "150330509",
                    "speaker": "伊安珊",
                    "text": "你们来「沃陆之邦」有什么事吗？"
                }
            ]
        },
        {
            "id": "1503307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150330701",
                    "speaker": "瓦雷莎",
                    "text": "欸，是伊安珊老师！你正好要训练吗？"
                },
                {
                    "id": "150330702",
                    "speaker": "伊安珊",
                    "text": "哦不是，今天正好有时间，我想保养一下院子里的这些设备。"
                },
                {
                    "id": "150330703",
                    "speaker": "伊安珊",
                    "text": "你们好，又见面了啊，欢迎到我家来。"
                },
                {
                    "id": "150330704",
                    "speaker": "伊安珊",
                    "text": "你们来「沃陆之邦」有什么事吗？"
                }
            ]
        },
        {
            "id": "1503316",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150331601",
                    "speaker": "瓦雷莎",
                    "text": "来吧，想摘多少摘多少，再摘一些蘑菇吧，等会儿一起做给你们吃！"
                }
            ]
        },
        {
            "id": "1503399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150339901",
                    "speaker": "瓦雷莎",
                    "text": "这个，摘一点…这个，也摘一点♪"
                }
            ]
        }
    ]
}