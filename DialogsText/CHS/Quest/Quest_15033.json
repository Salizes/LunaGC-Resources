    "talks": [
        {
            "id": "1503301",
            "objective": "前往「逐响擂台」",
            "dialogues": [
                {
                    "id": "150330401",
                    "speaker": "派蒙",
                    "text": "欸，原来你先到了啊。"
                },
                {
                    "id": "150330402",
                    "speaker": "瓦雷莎",
                    "text": "是啊，回家饱餐了一顿。我爸爸的手艺可好了，无论是肉还是蔬菜，做什么都好吃。"
                },
                {
                    "id": "150330403",
                    "speaker": "派蒙",
                    "text": "怪不得感觉你的气色恢复了很多，原来是吃饱了呀。"
                },
                {
                    "id": "150330404",
                    "speaker": "瓦雷莎",
                    "text": "嘿嘿，没错。来之前我还想叫上阿卡特叔叔，但他好像不在家，我就一个人过来了。"
                },
                {
                    "id": "150330405",
                    "speaker": "瓦雷莎",
                    "text": "阿卡特叔叔是我们的首领，本来我觉得让他来介绍「沃陆之邦」会更合适。"
                },
                {
                    "id": "150330406",
                    "speaker": "瓦雷莎",
                    "text": "我不知道应该按什么路线来，也只能想到哪里说哪里，这个你们会介意吗？"
                },
                {
                    "id": "150330407",
                    "speaker": "派蒙",
                    "text": "当然不会，这有什么关系啦。"
                },
                {
                    "id": "150330408",
                    "speaker": "瓦雷莎",
                    "text": "那就好，那就好，那么…走那边！"
                }
            ]
        },
        {
            "id": "1503306",
            "objective": "沿路前进，听瓦雷莎的介绍",
            "dialogues": [
                {
                    "id": "150330601",
                    "speaker": "瓦雷莎",
                    "text": "那边就是我的家，你们看，前面是水果店，后面是我和爸爸妈妈住的地方。"
                },
                {
                    "id": "150330602",
                    "speaker": "派蒙",
                    "text": "开在家门口的水果店？难道你们家会自己种水果？"
                },
                {
                    "id": "150330603",
                    "speaker": "瓦雷莎",
                    "text": "嘿嘿，是的，我们家有好大一片果园呢。"
                },
                {
                    "id": "150330604",
                    "speaker": "瓦雷莎",
                    "text": "这里靠部族营地的出入口很近，每天早上就会听到门外的行走和车轮声。"
                },
                {
                    "id": "150330605",
                    "speaker": "瓦雷莎",
                    "text": "我的爸爸妈妈也会在那个时候忙碌起来，我就知道我该起床了。"
                },
                {
                    "id": "150330606",
                    "speaker": "派蒙",
                    "text": "然后一起去果园干活吗？"
                },
                {
                    "id": "150330607",
                    "speaker": "瓦雷莎",
                    "text": "这、这个嘛…我刚想说，脑袋知道该起床，和身体准备好起床，是两件事…"
                },
                {
                    "id": "150330608",
                    "speaker": "瓦雷莎",
                    "text": "更多的时候，我都是脑袋往被窝里一缩，马上又睡着了。"
                },
                {
                    "id": "150330609",
                    "speaker": "派蒙",
                    "text": "我懂我懂，这种时候睡懒觉，总能睡得特别沉特别香。"
                },
                {
                    "id": "150330610",
                    "speaker": "派蒙",
                    "text": "#反正出发之前，{NICKNAME}{M#他}{F#她}一定会叫我起床的。"
                },
                {
                    "id": "150330611",
                    "speaker": "Player",
                    "text": "以后你先起，我睡懒觉。"
                },
                {
                    "id": "150330612",
                    "speaker": "派蒙",
                    "text": "开玩笑，我开玩笑的啦，别说这么可怕的事…"
                },
                {
                    "id": "150330613",
                    "speaker": "瓦雷莎",
                    "text": "哈哈哈，偶尔都睡睡懒觉也挺好的啊。"
                },
                {
                    "id": "150330614",
                    "speaker": "瓦雷莎",
                    "text": "我一般睡醒之后就会帮爸爸妈妈收拾房间，然后出门训练，接着回家吃饭。"
                },
                {
                    "id": "150330615",
                    "speaker": "瓦雷莎",
                    "text": "吃完饭之后爸爸妈妈会去运货，就轮到我去果园工作的时间了。"
                },
                {
                    "id": "150330616",
                    "speaker": "Player",
                    "text": "也就是现在的时间吗？"
                },
                {
                    "id": "150330617",
                    "speaker": "派蒙",
                    "text": "那我们也去果园看看吧，我很感兴趣！"
                },
                {
                    "id": "150330618",
                    "speaker": "瓦雷莎",
                    "text": "好啊，等下我就带你们过去，现在…跟我走吧，走这边。"
                }
            ]
        },
        {
            "id": "1503302",
            "objective": "继续沿路前进",
            "dialogues": [
                {
                    "id": "150330901",
                    "speaker": "派蒙",
                    "text": "我们就是打算到这附近冒险，倒是没有什么特别的计划。"
                },
                {
                    "id": "150330902",
                    "speaker": "派蒙",
                    "text": "路上碰到了瓦雷莎，她特别热心地为我们引路，还给我们介绍了好多这里的知识。"
                },
                {
                    "id": "150330903",
                    "speaker": "瓦雷莎",
                    "text": "不客气，这些都是应该做的。"
                },
                {
                    "id": "150330904",
                    "speaker": "伊安珊",
                    "text": "这几天的训练计划完成得如何，瓦雷莎，没有怠慢吧？"
                },
                {
                    "id": "150330905",
                    "speaker": "瓦雷莎",
                    "text": "报告老师，完成得很好！今天的往返跑三个来回也做完了！"
                },
                {
                    "id": "150330906",
                    "speaker": "伊安珊",
                    "text": "很好，接下来也要按照计划执行，至于饮食…嗯，最近还没有必要控制。"
                },
                {
                    "id": "150330907",
                    "speaker": "伊安珊",
                    "text": "我这里的器械，你都可以随意使用，不过在做力量训练的时候，一定要注意安全，最好找个人辅助你。"
                },
                {
                    "id": "150330908",
                    "speaker": "瓦雷莎",
                    "text": "知道了，我很有经验。"
                },
                {
                    "id": "150330909",
                    "speaker": "派蒙",
                    "text": "欸，我听说锻炼肌肉的话，吃饭也是很重要的一件事，为什么你不给瓦雷莎安排食谱呢？"
                },
                {
                    "id": "150330910",
                    "speaker": "伊安珊",
                    "text": "这就说来话长了…怎么说呢，瓦雷莎算是很少见的天赋型选手。"
                },
                {
                    "id": "150330911",
                    "speaker": "伊安珊",
                    "text": "她刚和我训练的时候，我给她安排的方法和其他学员差不多，也给她父亲写了专门的食谱。"
                },
                {
                    "id": "150330912",
                    "speaker": "瓦雷莎",
                    "text": "…然后我就被饿得眼冒金星，根本没有力气上课。"
                },
                {
                    "id": "150330913",
                    "speaker": "伊安珊",
                    "text": "抱歉，我安排的都是标准食量，但似乎完全跟不上你的消耗。"
                },
                {
                    "id": "150330914",
                    "speaker": "伊安珊",
                    "text": "我认真研究了瓦雷莎过去的饮食习惯，才逐渐形成了现在专门针对她的计划。"
                },
                {
                    "id": "150330915",
                    "speaker": "瓦雷莎",
                    "text": "是的，老师非常细心，我觉得我每天都有进步，越来越喜欢上课和锻炼了。"
                },
                {
                    "id": "150330916",
                    "speaker": "伊安珊",
                    "text": "在所有学员里，瓦雷莎是目前运动表现最好的…单论负重极限，我已经比不上她了。"
                },
                {
                    "id": "150330917",
                    "speaker": "派蒙",
                    "text": "欸？你可是老师，还是归火圣夜巡礼的优胜者啊？"
                },
                {
                    "id": "150330918",
                    "speaker": "伊安珊",
                    "text": "哈哈哈，不用惊讶，这样的事在健身领域里很正常，天赋是非常重要的。"
                },
                {
                    "id": "150330919",
                    "speaker": "派蒙",
                    "text": "哇，好、好厉害！完全看不出来…"
                },
                {
                    "id": "150330920",
                    "speaker": "伊安珊",
                    "text": "我可没有夸张，瓦雷莎的实力相当靠得住，如果能再自信一点就好了。"
                },
                {
                    "id": "150330921",
                    "speaker": "瓦雷莎",
                    "text": "都是老师教得好，嘿嘿，我自己没有花什么力气。"
                },
                {
                    "id": "150330922",
                    "speaker": "Player",
                    "text": "这就是天才吗…"
                },
                {
                    "id": "150330923",
                    "speaker": "瓦雷莎",
                    "text": "没有没有，不是的，面对这些训练器械或者魔物，我可以使出全力，不会有什么心理负担。"
                },
                {
                    "id": "150330924",
                    "speaker": "瓦雷莎",
                    "text": "但是一旦要和别人对抗，我就不行了…因为害怕把别人弄伤…"
                },
                {
                    "id": "150330925",
                    "speaker": "派蒙",
                    "text": "呃，你这么说也对…那「归火圣夜巡礼」怎么办呢？"
                },
                {
                    "id": "150330926",
                    "speaker": "瓦雷莎",
                    "text": "唉，连团体赛都没有赢过，更别说取得名次了，我不擅长抢来抢去的事。"
                },
                {
                    "id": "150330927",
                    "speaker": "伊安珊",
                    "text": "力量的精髓之一，就是「控制」，就拿这边的杠铃作比方。"
                },
                {
                    "id": "150330928",
                    "speaker": "伊安珊",
                    "text": "不光是推起的时候需要用力气，放下的时候同样需要，一个力量强大的人，肯定能收放自如。"
                },
                {
                    "id": "150330929",
                    "speaker": "瓦雷莎",
                    "text": "我明白，训练的时候我都是这么做的，也没出过问题，但真的到了和别人对抗的时候，我又会有点怀疑自己…",
                    "choices": [
                        {
                            "id": "150330930",
                            "text": "没关系。",
                            "response": [
                                {
                                    "id": "150330932",
                                    "speaker": "瓦雷莎",
                                    "text": "嗯，谢谢你安慰我，只要努力训练，总会克服的吧。"
                                },
                                {
                                    "id": "150330933",
                                    "speaker": "瓦雷莎",
                                    "text": "#那老师我们就先走了，我要带{M#他}{F#她}们去果园看看。"
                                },
                                {
                                    "id": "150330934",
                                    "speaker": "伊安珊",
                                    "text": "好的，祝你们在「沃陆之邦」过得开心。"
                                }
                            ]
                        },
                        {
                            "id": "150330931",
                            "text": "不用急于这一时。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503307",
            "objective": "继续沿路前进",
            "dialogues": [
                {
                    "id": "150331001",
                    "speaker": "瓦雷莎",
                    "text": "这里就是伊安珊老师的家，听说竞技场那边出了意外，所以她现在不在家。"
                },
                {
                    "id": "150331002",
                    "speaker": "瓦雷莎",
                    "text": "她让我帮她保养一下这里的器械，麻烦你们稍等一会儿哦。"
                },
                {
                    "id": "150331003",
                    "speaker": "派蒙",
                    "text": "这么多器械，都是你们平常会用的吗？"
                },
                {
                    "id": "150331004",
                    "speaker": "瓦雷莎",
                    "text": "嗯，没错，伊安珊老师会带我们训练，教我们很多技巧…"
                },
                {
                    "id": "150331005",
                    "speaker": "瓦雷莎",
                    "text": "她说的很多理论知识我都听不懂，但只要她说什么我做什么，长进就会很明显…嘿嘿，她真厉害。"
                },
                {
                    "id": "150331006",
                    "speaker": "Player",
                    "text": "这说明你的天赋也很好。"
                },
                {
                    "id": "150331007",
                    "speaker": "派蒙",
                    "text": "我也想试试！可以让我试试吗？"
                },
                {
                    "id": "150331008",
                    "speaker": "瓦雷莎",
                    "text": "好啊，那就用这个最轻的吧。"
                },
                {
                    "id": "150331009",
                    "speaker": "派蒙",
                    "text": "唔，唔唔唔——"
                },
                {
                    "id": "150331010",
                    "speaker": "派蒙",
                    "text": "不行，我连拿都拿不起来…这真的是能用来训练的重量吗？"
                },
                {
                    "id": "150331011",
                    "speaker": "瓦雷莎",
                    "text": "欸，我觉得还好，伊安珊老师说这里的配重片已经不够我用了，需要再订几对特制的才行。"
                },
