    "talks": [
        {
            "id": "7227101",
            "objective": "（test）跟琳琅对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722710101",
                    "speaker": "琳琅",
                    "text": "欢迎光临敝店，请来看看新上架的古董吧。"
                },
                {
                    "id": "722710102",
                    "speaker": "Player",
                    "text": "我有宝物想要出售。"
                },
                {
                    "id": "722710103",
                    "speaker": "琳琅",
                    "text": "您又找到了什么稀奇东西？请让我看看。"
                },
                {
                    "id": "722710104",
                    "speaker": "Black Screen",
                    "text": "将龙骨花凝珠的故事告诉了琳琅。"
                },
                {
                    "id": "722710105",
                    "speaker": "琳琅",
                    "text": "听您所说，这可是一件了不得的古物啊。"
                },
                {
                    "id": "722710106",
                    "speaker": "琳琅",
                    "text": "只是我入手察看一番，并没有感觉到特别明显的异样，或许需要长期使用才行…"
                },
                {
                    "id": "722710107",
                    "speaker": "琳琅",
                    "text": "依我之见，您所听来的神妙效用，可能有些夸大了，又或者...说不定只是失败者的托辞呢…"
                },
                {
                    "id": "722710108",
                    "speaker": "琳琅",
                    "text": "哈哈，您不用在意，我只是随口一说，您听听便好。"
                },
                {
                    "id": "722710122",
                    "speaker": "琳琅",
                    "text": "在我们古董行当里，这种事情倒十分常见。"
                },
                {
                    "id": "722710109",
                    "speaker": "琳琅",
                    "text": "另外，您似乎没有对它密封保存，粗粗看去，它的表面似乎已经有了一些耗损。"
                },
                {
                    "id": "722710110",
                    "speaker": "琳琅",
                    "text": "这样一来，价格又要小打一点折扣。"
                },
                {
                    "id": "722710123",
                    "speaker": "琳琅",
                    "text": "您看，80000摩拉如何？除此之外，再加5份特色料理丰年有余。"
                },
                {
                    "id": "722710111",
                    "speaker": "琳琅",
                    "text": "我相信这是一个不错的价格。",
                    "choices": [
                        {
                            "id": "722710112",
                            "text": "你会拿它做什么？",
                            "response": [
                                {
                                    "id": "722710113",
                                    "speaker": "琳琅",
                                    "text": "其实跟它的功效相比，我倒觉得它背后的那段故事更有价值。"
                                },
                                {
                                    "id": "722710114",
                                    "speaker": "琳琅",
                                    "text": "我猜港里的说书人、戏班子，或者玉京台上的贵人们都会对它有兴趣。"
                                },
                                {
                                    "id": "722710115",
                                    "speaker": "琳琅",
                                    "text": "就算只摆在本店的柜台上展示，也能算上一件珍稀的古董了。"
                                }
                            ]
                        },
                        {
                            "id": "722710116",
                            "text": "公道的价格，成交。",
                            "response": [
                                {
                                    "id": "722710117",
                                    "speaker": "琳琅",
                                    "text": "您可真爽快，这些摩拉请收好。"
                                },
                                {
                                    "id": "722710118",
                                    "speaker": "琳琅",
                                    "text": "往后要是还有类似的宝贝，敝店随时恭候您的光临。"
                                }
                            ]
                        },
                        {
                            "id": "722710119",
                            "text": "我再考虑一下。",
                            "response": [
                                {
                                    "id": "722710120",
                                    "speaker": "琳琅",
                                    "text": "嗯，对于这种珍奇宝物，货比三家…啊不是，价比三家也是应该的。"
                                },
                                {
                                    "id": "722710121",
                                    "speaker": "琳琅",
                                    "text": "如果您考虑好了，可以再来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7227102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722710201",
                    "speaker": "Player",
                    "text": "关于龙骨花凝珠。"
                },
                {
                    "id": "722710202",
                    "speaker": "琳琅",
                    "text": "那么，您考虑的如何了？"
                },
                {
                    "id": "722710203",
                    "speaker": "琳琅",
                    "text": "敝店愿意以80000摩拉加5份丰年有余来收购。",
                    "choices": [
                        {
                            "id": "722710204",
                            "text": "就决定卖给你了。",
                            "response": [
                                {
                                    "id": "722710205",
                                    "speaker": "琳琅",
                                    "text": "谢您惠顾，这些摩拉请收好。"
                                },
                                {
                                    "id": "722710206",
                                    "speaker": "琳琅",
                                    "text": "往后要是还有类似的宝贝，敝店随时恭候您的光临。"
                                }
                            ]
                        },
                        {
                            "id": "722710207",
                            "text": "我还要再考虑一下。",
                            "response": [
                                {
                                    "id": "722710208",
                                    "speaker": "琳琅",
                                    "text": "嗯，对于这种珍奇宝物，价比三家也是应该的。"
                                },
                                {
                                    "id": "722710209",
                                    "speaker": "琳琅",
                                    "text": "如果您考虑好了，可以再来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
