    "talks": [
        {
            "id": "7723301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "675720401",
                    "speaker": "Player",
                    "text": "有什么需要帮忙的吗？"
                },
                {
                    "id": "675720402",
                    "speaker": "索博列夫",
                    "text": "巧了，还真有。我这儿等会有一批货物要装车发往至冬堡。结果负责押车的队伍里，有三个人到现在还没见着人影。"
                },
                {
                    "id": "675720403",
                    "speaker": "索博列夫",
                    "text": "虽说少他们三个也能凑合发车，但路上万一出点什么岔子，临时缺人手，那可就是大麻烦了。"
                },
                {
                    "id": "675720404",
                    "speaker": "索博列夫",
                    "text": "我估计这几个糊涂蛋是把日子记错了，这会儿多半还在底下闷头干活呢。就麻烦你跑一趟，去他们的工作区找找人吧…"
                }
            ]
        },
        {
            "id": "7723302",
            "objective": "找回负责押车的工人",
            "dialogues": [
                {
                    "id": "772330101",
                    "speaker": "兹亚布林",
                    "text": "什么？今天轮到我跟车？完了完了，主管非骂死我不可！我、我立刻就过去！"
                }
            ]
        },
        {
            "id": "7723304",
            "objective": "找回负责押车的工人",
            "dialogues": [
                {
                    "id": "772330201",
                    "speaker": "斯利夫科夫",
                    "text": "哦…都已经这个点了吗？我都没发现。嘶…早知道昨天晚上少喝两杯了…"
                }
            ]
        },
        {
            "id": "7723305",
            "objective": "找回负责押车的工人",
            "dialogues": [
                {
                    "id": "772330301",
                    "speaker": "诺索夫",
                    "text": "嗯？跟车？怎么还有我的份？他没跟我说啊…好吧好吧，我现在就动身…"
                }
            ]
        },
        {
            "id": "7723306",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7723307",
            "objective": "找回负责押车的工人$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7723303",
            "objective": "与索博列夫对话",
            "dialogues": [
                {
                    "id": "675720501",
                    "speaker": "索博列夫",
                    "text": "嗯，看样子这三个蠢货是赶上车了。还好还好…只要没耽误事儿，我也懒得跟他们计较了。"
                },
                {
                    "id": "675720502",
                    "speaker": "索博列夫",
                    "text": "辛苦你跑这一趟了。唉，今天总算是有那么一件事儿是被顺利解决的了…对了，这是给你的报酬，多谢你帮忙了。"
                }
            ]
        }
    ]
