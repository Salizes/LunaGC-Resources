    "talks": [
        {
            "id": "7609101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760910101",
                    "speaker": "？？？",
                    "text": "是会飞的妖精！我的笔记…重要的笔记被愚人众扣下来了，你能帮我找回来吗？"
                },
                {
                    "id": "760910102",
                    "speaker": "派蒙",
                    "text": "虽然我不是妖精…但这点小忙也不是不能帮啦。话说回来，愚人众为什么会扣留小孩子的笔记呀？"
                },
                {
                    "id": "760910103",
                    "speaker": "？？？",
                    "text": "说不定是害怕我将笔记上的内容公之于众…你们要是能帮我把笔记找回来，我就把这个秘密也告诉你们。"
                },
                {
                    "id": "760910105",
                    "speaker": "？？？",
                    "text": "这些待会儿再说，拜托你们先帮我<color=#00E1FFFF>找回笔记</color>吧，说不定还有些从笔记本里<color=#00E1FFFF>散落的纸页</color>，就在那边，有愚人众的地方。"
                }
            ]
        },
        {
            "id": "7609102",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609103",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609104",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760910401",
                    "speaker": "？？？",
                    "text": "笔记就拜托你们了，可能还有些散落的…就在那边有愚人众的地方。"
                }
            ]
        },
        {
            "id": "7609105",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609108",
            "objective": "回滚隔离环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609106",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760910601",
                    "speaker": "谢苗",
                    "text": "总之多谢你们，再见！"
                }
            ]
        },
        {
            "id": "7609107",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760910702",
                    "speaker": "？？？",
                    "text": "我看看…没错！就是这些，太感谢了。这里面可是记录了不少愚人众的罪证呢。"
                },
                {
                    "id": "760910703",
                    "speaker": "派蒙",
                    "text": "…罪证？"
                },
                {
                    "id": "760910704",
                    "speaker": "？？？",
                    "text": "你瞧他们在帕哈岛上建的那些设施，还有他们带来的机械装置…那里原本也是很多动物的家呀。"
                },
                {
                    "id": "760910705",
                    "speaker": "？？？",
                    "text": "我刚从绯沙盐沼回来，一定是因为愚人众的机器，那边的水母都奄奄一息了…我得让大家都知道这件事才行。"
                },
                {
                    "id": "760910706",
                    "speaker": "派蒙",
                    "text": "原来是这样…"
                },
                {
                    "id": "760910709",
                    "speaker": "谢苗",
                    "text": "对了，如果你们要和别人说，一定要说是谢苗，也就是我告诉你们的。毕竟回去写成文章在报纸上刊登还需要时间…"
                },
                {
                    "id": "760910710",
                    "speaker": "谢苗",
                    "text": "这份笔记就交给你们了。我得快点回去把其他的笔记的内容整理好，写成文章才行。"
                },
                {
                    "id": "760910701",
                    "speaker": "谢苗",
                    "text": "总之多谢你们，再见！"
                }
            ]
        },
        {
            "id": "7609102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760910203",
                    "speaker": "Black Screen",
                    "text": "将之前捡到的笔记本和纸页交给了他…"
                },
                {
                    "id": "760910204",
                    "speaker": "？？？",
                    "text": "我看看…没错！就是这些，太感谢了。这里面可是记录了不少愚人众的罪证呢。"
                },
                {
                    "id": "760910205",
