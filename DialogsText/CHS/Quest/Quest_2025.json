            "dialogues": []
        },
        {
            "id": "4012316",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401231601",
                    "speaker": "乔姨",
                    "text": "连石门都热闹起来啦？哈哈，这还真是不多见啊。"
                },
                {
                    "id": "401231602",
                    "speaker": "乔姨",
                    "text": "年轻人，想歇就歇会儿吧，可别累着。"
                }
            ]
        },
        {
            "id": "4012317",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401231701",
                    "speaker": "老周叔",
                    "text": "哈哈…这年轻人的花样可越来越多了。"
                },
                {
                    "id": "401231702",
                    "speaker": "老周叔",
                    "text": "诗歌大会…嗯，遥想我年轻的时候，也有好多能写的故事…"
                },
                {
                    "id": "401231703",
                    "speaker": "老周叔",
                    "text": "哎…山月常在，红颜易消啊…"
                }
            ]
        },
        {
            "id": "4012621",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262101",
                    "speaker": "纪芳",
                    "text": "…你不是要出书吗？"
                },
                {
                    "id": "401262102",
                    "speaker": "胡桃",
                    "text": "对呀。"
                },
                {
                    "id": "401262103",
                    "speaker": "纪芳",
                    "text": "…书呢？"
                },
                {
                    "id": "401262104",
                    "speaker": "胡桃",
                    "text": "等诗来就有了。"
                },
                {
                    "id": "401262105",
                    "speaker": "纪芳",
                    "text": "…诗呢？"
                },
                {
                    "id": "401262106",
                    "speaker": "胡桃",
                    "text": "诗在路上了。"
                },
                {
                    "id": "401262107",
                    "speaker": "纪芳",
                    "text": "…不是，胡堂主，你这诗还没来，我怎么跟你聊生意？"
                },
                {
                    "id": "401262108",
                    "speaker": "胡桃",
                    "text": "我这不是先来和老板你谈谈妥嘛。"
                },
                {
                    "id": "401262109",
                    "speaker": "纪芳",
                    "text": "我总要看看内容再决定卖不卖，怎么卖吧？"
                },
                {
                    "id": "401262110",
                    "speaker": "胡桃",
                    "text": "哎呀呀，光是堂主我刚才给你看的几句，就足以撑起这本书的销量了吧！"
                },
                {
                    "id": "401262111",
                    "speaker": "纪芳",
                    "text": "…就凭「林猪二十斤」？"
                },
                {
                    "id": "401262112",
                    "speaker": "胡桃",
                    "text": "还有「地下开饭」那个呀！见多识广的钟离客卿可都说是好诗对！这不做个什么宣传宣传？"
                },
                {
                    "id": "401262113",
                    "speaker": "纪芳",
                    "text": "…堂主，我们这都是小本生意。要是成本进去了但没人买，亏的是我的钱。"
                },
                {
                    "id": "401262114",
                    "speaker": "胡桃",
                    "text": "放心放心，我和你担保，这诗集印出来，绝对惊天地泣鬼神！"
                },
                {
                    "id": "401262115",
                    "speaker": "胡桃",
                    "text": "这不，我来的路上就听见了些鬼魂的哭声呢！你不信的话，我叫来给你听听？"
                },
                {
                    "id": "401262116",
                    "speaker": "纪芳",
                    "text": "…这就免了。"
                }
            ]
        },
        {
            "id": "4012622",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262201",
                    "speaker": "魈",
                    "text": "…是你。"
                },
                {
                    "id": "401262202",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "401262203",
                    "speaker": "魈",
                    "text": "依你所言，试着作了首诗…"
                },
                {
                    "id": "401262204",
                    "speaker": "魈",
                    "text": "把心绪落于纸上，胸中倒是平静不少…"
                },
                {
                    "id": "401262205",
                    "speaker": "魈",
                    "text": "他们…真的能听见吗…"
                }
            ]
        },
        {
            "id": "4012623",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262302",
                    "speaker": "（聆听…）",
                    "text": "（愉快的歌声…）"
                }
            ]
        },
        {
            "id": "4012624",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262401",
                    "speaker": "浣溪",
                    "text": "有这么一个和蒙德朋友一起写诗的机会还真不错。"
                },
                {
                    "id": "401262402",
                    "speaker": "浣溪",
                    "text": "不过光在会场站着也挺无聊的，我就把老家的果蔬拿来买买赚外快了。"
                },
                {
                    "id": "401262403",
                    "speaker": "浣溪",
                    "text": "哦，当然，想要交流诗歌的话，我也奉陪哟。"
                }
            ]
        },
        {
            "id": "4012625",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262501",
                    "speaker": "雷温",
                    "text": "听说这次负责调酒的是猫尾酒馆的特派员。"
                },
                {
                    "id": "401262502",
                    "speaker": "雷温",
                    "text": "平时都因为太热闹了，没怎么进去过，这次一定得尝尝到底是什么味道。"
                }
            ]
        },
        {
            "id": "4012626",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262601",
                    "speaker": "约亨",
                    "text": "这里的位子您随便坐，看看风景写写诗，再来一杯上好的饮品。"
                },
                {
                    "id": "401262602",
                    "speaker": "约亨",
                    "text": "…这么看来，璃月和蒙德娱乐消遣的方式还挺相似？"
                }
            ]
        },
        {
            "id": "4012628",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262801",
                    "speaker": "留言",
                    "text": "我猜，台上左边的那个诗谜，谜底是「琉璃百合」。"
                },
                {
                    "id": "401262802",
                    "speaker": "回复",
                    "text": "谜题里说这种花以前开得很多，「琉璃百合」真有那么多吗？"
                },
                {
                    "id": "401262803",
                    "speaker": "回复",
                    "text": "会不会是「薄荷」？诗里不是说这种植物挺香吗？"
                },
                {
                    "id": "401262804",
                    "speaker": "回复",
                    "text": "我觉得还是「琉璃百合」更符合意象。"
                },
                {
                    "id": "401262805",
                    "speaker": "回复",
                    "text": "那右边那个诗谜呢？我怎么都猜不出，难道是什么我没见过的东西？"
                },
                {
                    "id": "401262806",
                    "speaker": "回复",
                    "text": "我知道是什么，但我不方便说…"
                },
                {
                    "id": "401262807",
                    "speaker": "回复",
                    "text": "这还有不方便说的东西？"
                }
            ]
        },
        {
            "id": "4012629",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401262901",
                    "speaker": "谜底揭晓",
                    "text": "琉璃百合、攫金鸦印。"
                }
            ]
        },
        {
            "id": "4012630",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401263001",
                    "speaker": "留言",
                    "text": "我记得璃月的「对子」好像挺难的…"
                },
                {
                    "id": "401263002",
                    "speaker": "回复",
                    "text": "若是依照严格的规则来对，的确挺难。"
                },
                {
                    "id": "401263003",
                    "speaker": "回复",
                    "text": "除了字数相同，还要讲究平仄相合、仄起平收、词性虚实相对什么的…"
                },
                {
                    "id": "401263004",
                    "speaker": "回复",
                    "text": "不过难得有蒙德的朋友来玩，大家还是尽兴为好！"
                }
            ]
        },
        {
            "id": "4012631",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401263101",
                    "speaker": "某人留下的诗",
                    "text": "「我想变成一只蘑菇，不用蓝得像湖，也不用映出高天的星图。」"
                },
                {
                    "id": "401263102",
                    "speaker": "某人留下的诗",
                    "text": "「我想变成一只普普通通的，谁都不会采摘的蘑菇。」"
                },
                {
                    "id": "401263103",
                    "speaker": "某人留下的诗",
                    "text": "「我想永远躲在树脚，除非凑巧遇上一只林猪，戴起我，如同戴上一脑袋的花束。」"
                },
                {
                    "id": "401263104",
                    "speaker": "某人留下的诗",
                    "text": "「原来我并不想变成蘑菇，我只是害怕孤独。」"
                }
            ]
        },
        {
            "id": "4012632",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401263201",
                    "speaker": "某人留下的诗",
                    "text": "「把诗琴的弦涂成彩虹的颜色，叮咚叮咚。」"
                },
                {
                    "id": "401263202",
                    "speaker": "某人留下的诗",
                    "text": "「下起雨来，叶子也是甜的。」"
                }
            ]
        },
        {
            "id": "7152102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715210201",
                    "speaker": "巴特洛",
                    "text": "这幅画作需要修复的地方在这里…"
                },
                {
                    "id": "715210202",
                    "speaker": "巴特洛",
                    "text": "#{NICKNAME}！真高兴见到您，再次感谢您愿意帮我去野外取景。"
                },
                {
                    "id": "715210203",
                    "speaker": "巴特洛",
                    "text": "有了您的帮助，我一定能更高效地修复好这些画作。"
                }
            ]
        },
        {
            "id": "7152202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715220201",
                    "speaker": "比勒",
                    "text": "怎么？您想要再寻找寻找灵感吗？",
                    "choices": [
                        {
                            "id": "715220202",
                            "text": "想要试玩。",
                            "response": [
                                {
                                    "id": "715220203",
                                    "speaker": "比勒",
                                    "text": "没问题，请来这边。好好感受灵感吧！"
                                }
                            ]
                        },
                        {
                            "id": "715220204",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "715220205",
                                    "speaker": "比勒",
                                    "text": "好吧，等您想玩了，直接过来这边就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7152302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715230201",
                    "speaker": "廷稚",
                    "text": "您想来试玩一下「百步礼掷」吗？",
                    "choices": [
                        {
                            "id": "715230202",
                            "text": "想试玩一下。",
                            "response": [
                                {
                                    "id": "715230203",
                                    "speaker": "廷稚",
                                    "text": "没问题，这些「掷箭」您拿好，「容壶」就在那边。"
                                }
                            ]
                        },
                        {
                            "id": "715230204",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "715230205",
                                    "speaker": "廷稚",
                                    "text": "没关系，东西我都准备好了。您想玩的时候，直接过来就行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}