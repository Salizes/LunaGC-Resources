    "talks": [
        {
            "id": "800301",
            "objective": "与戴因对话",
            "dialogues": [
                {
                    "id": "80030101",
                    "speaker": "派蒙",
                    "text": "呀，戴因在这里。你有见过琴团长吗？"
                },
                {
                    "id": "80030102",
                    "speaker": "戴因斯雷布",
                    "text": "我见到她了，但刻意避开了她。"
                },
                {
                    "id": "80030103",
                    "speaker": "戴因斯雷布",
                    "text": "她是「狮牙骑士」，又是代理团长，必然会对我抱有戒心。"
                },
                {
                    "id": "80030104",
                    "speaker": "戴因斯雷布",
                    "text": "若我不谨慎，总有一天会变成她的调查对象。"
                },
                {
                    "id": "80030105",
                    "speaker": "戴因斯雷布",
                    "text": "话说回来，我这边只是解决了些魔物，没找到什么情报。你们那边，有收获吗？"
                },
                {
                    "id": "80030106",
                    "speaker": "戴因斯雷布",
                    "text": "原来如此…"
                },
                {
                    "id": "80030107",
                    "speaker": "戴因斯雷布",
                    "text": "那么，「世上第一座耕地机」动向的全貌，大致就已经能够拼凑齐了。"
                },
                {
                    "id": "80030108",
                    "speaker": "派蒙",
                    "text": "咦？真的吗？就凭「王狼」说的那些话？"
                },
                {
                    "id": "80030109",
                    "speaker": "戴因斯雷布",
                    "text": "不止是凭这一条信息，而是更综合的考虑。"
                },
                {
                    "id": "80030110",
                    "speaker": "戴因斯雷布",
                    "text": "比如，你们之前告诉我说，教会传下的那个「老故事」…"
                },
                {
                    "id": "80030111",
                    "speaker": "Player",
                    "text": "「暴君的遗怨」！"
                },
                {
                    "id": "80030112",
                    "speaker": "戴因斯雷布",
                    "text": "没错。正是你口中那位修女提到的，曾被误认为暴君遗怨的奇怪事件。",
                    "choices": [
                        {
                            "id": "80030113",
                            "text": "如果从天而降的火球是导弹…",
                            "response": [
                                {
                                    "id": "80030115",
                                    "speaker": "派蒙",
                                    "text": "啊，我懂了！所以「暴君的遗怨」，其实是从奔狼领逃走的那座机器，自动发射的导弹！"
                                },
                                {
                                    "id": "80030116",
                                    "speaker": "派蒙",
                                    "text": "它在「狼的试炼」里损坏以后，游荡到了「旧蒙德」的废墟，住了下来…"
                                },
                                {
                                    "id": "80030117",
                                    "speaker": "派蒙",
                                    "text": "只要有人接近，就咚咚咚——地发射。直到有一天，它终于坏掉了，所以从天而降的火球也消失了。"
                                },
                                {
                                    "id": "80030118",
                                    "speaker": "派蒙",
                                    "text": "那时候的蒙德人还没大量接触过「遗迹守卫」，就只能解读成是「暴君的遗怨」了！"
                                },
                                {
                                    "id": "80030119",
                                    "speaker": "戴因斯雷布",
                                    "text": "看来，我们该去那个现在叫做<color=#00E1FFFF>「风龙废墟」</color>的地方，开始地毯式搜查了。",
                                    "choices": [
                                        {
                                            "id": "80030120",
                                            "text": "不。",
                                            "response": [
                                                {
                                                    "id": "80030122",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "哦？你的意思是…"
                                                },
                                                {
                                                    "id": "80030123",
                                                    "speaker": "Player",
                                                    "text": "我有…现成的「记忆」。"
                                                },
                                                {
                                                    "id": "80030124",
                                                    "speaker": "派蒙",
                                                    "text": "咦…你是说…"
                                                },
                                                {
                                                    "id": "80030125",
                                                    "speaker": "派蒙",
                                                    "text": "哦！我也懂了！没错没错，那台<color=#00E1FFFF>「坐在高塔上的守卫」</color>，确实很让人印象深刻呢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80030121",
                                            "text": "不用了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80030114",
                            "text": "当时的蒙德想不通火球是什么…"
                        },
                        {
                            "id": "80030126",
                            "text": "其实芭芭拉是祈礼牧师来着…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800306",
            "objective": "前往风龙废墟",
            "dialogues": [
                {
                    "id": "80030601",
                    "speaker": "派蒙",
                    "text": "他们走了…"
                },
                {
                    "id": "80030602",
                    "speaker": "派蒙",
                    "text": "#呜…{NICKNAME}，别这么伤心…我们会找到他们的！往好的一面想吧！这次至少已经找到很有用的线索了！",
                    "choices": [
                        {
                            "id": "80030603",
                            "text": "我…没有伤心。",
                            "response": [
                                {
                                    "id": "80030604",
                                    "speaker": "派蒙",
                                    "text": "欸？真的吗？唔…"
                                },
                                {
                                    "id": "80030607",
                                    "speaker": "派蒙",
                                    "text": "总之，以目前的情形而言，寻找亲人的突破口，除了「七神」以外，又多了一个「戴因」吧？",
                                    "choices": [
                                        {
                                            "id": "80030608",
                                            "text": "我们去稻妻以后，也需要多留意。",
                                            "response": [
                                                {
                                                    "id": "80030610",
                                                    "speaker": "派蒙",
                                                    "text": "没错。对了，他们刚才说的话好难懂，你听明白了吗？",
                                                    "choices": [
                                                        {
                                                            "id": "80030611",
                                                            "text": "差不多明白了。",
                                                            "response": [
                                                                {
                                                                    "id": "80030613",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…那我们来稍微梳理一下吧。"
                                                                },
                                                                {
                                                                    "id": "80030614",
                                                                    "speaker": "派蒙",
                                                                    "text": "#首先是那个深渊使徒，它把你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}叫做「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}」殿下。"
                                                                },
                                                                {
                                                                    "id": "80030615",
                                                                    "speaker": "派蒙",
                                                                    "text": "#看来你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}正在统领深渊教团，而且地位比深渊使徒更高…虽然不知道是不是最高的统治者就是了。"
                                                                },
                                                                {
                                                                    "id": "80030616",
                                                                    "speaker": "派蒙",
                                                                    "text": "#还有，你{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}说{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}的目标是「淹没神座、与天理作战」。这是什么意思呢？听起来…是不是要覆灭七神与七国？"
                                                                },
                                                                {
                                                                    "id": "80030617",
                                                                    "speaker": "派蒙",
                                                                    "text": "然后，深渊教团的怪物，就是坎瑞亚灭国时的人民…扭曲成的怪物。这真是可怕的故事。"
                                                                },
                                                                {
                                                                    "id": "80030618",
                                                                    "speaker": "派蒙",
                                                                    "text": "戴因也是坎瑞亚人，五百年前也经历了那一切。但他没有变成怪物，而且在五百年后的今天，正对抗着深渊教团…"
                                                                },
                                                                {
                                                                    "id": "80030619",
                                                                    "speaker": "派蒙",
                                                                    "text": "#也就是，你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}说的，「戴因正在与{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}为敌」的意思吧？"
                                                                },
                                                                {
                                                                    "id": "80030620",
                                                                    "speaker": "派蒙",
                                                                    "text": "但是，如果深渊教团的怪物，是当年戴因守护的人民，那为什么戴因要与深渊教团敌对呢？"
                                                                },
                                                                {
                                                                    "id": "80030621",
                                                                    "speaker": "派蒙",
                                                                    "text": "#另外，为什么…我一直在陪你寻找的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}，现在却和深渊教团的怪物站在一起？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80030622",
                                                                            "text": "情报并不太多。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80030624",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，没错。"
                                                                                },
                                                                                {
                                                                                    "id": "80030625",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#那——{NICKNAME}，打起精神来！"
                                                                                },
                                                                                {
                                                                                    "id": "80030626",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我们的旅行不会结束，该动身了！离开这个讨厌的地方，先回到阳光照耀的地面上去吧。"
                                                                                },
                                                                                {
                                                                                    "id": "80030627",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#如果你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}要你「抵达终点」…好啊，那你就抵达给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}看！"
                                                                                },
                                                                                {
                                                                                    "id": "80030628",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "「旅行者」，我们走吧！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80030623",
                                                                            "text": "再多想也没意义了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80030612",
                                                            "text": "#注意力只在{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}身上，没仔细听。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80030609",
                                            "text": "「旅行」的目标又多了一个。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80030605",
                            "text": "派蒙说得没错，希望已经出现了。",
                            "response": [
                                {
                                    "id": "80030606",
                                    "speaker": "派蒙",
                                    "text": "嗯，是吧是吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "800307",
            "objective": "与戴因对话",
            "dialogues": [
                {
                    "id": "80030301",
                    "speaker": "派蒙",
                    "text": "就是这个吗？好，用元素视野看看吧！"
                },
                {
                    "id": "80030302",
                    "speaker": "派蒙",
                    "text": "唔唔唔唔——怎么样，有什么发现吗？"
                },
                {
                    "id": "80030303",
                    "speaker": "派蒙",
                    "text": "欸？你说什么都没发生？明明我还这么期待…"
                },
                {
                    "id": "80030304",
                    "speaker": "派蒙",
                    "text": "怎么会，是不是哪里搞错了？"
                },
                {
                    "id": "80030305",
                    "speaker": "戴因斯雷布",
                    "text": "是方法的问题。"
                },
                {
                    "id": "80030306",
                    "speaker": "戴因斯雷布",
                    "text": "对「耕地机」用元素视野是不可行的，因为驱动它的能源从来不是「元素」。"
                },
                {
                    "id": "80030307",
                    "speaker": "戴因斯雷布",
                    "text": "交给我吧，我来尝试。"
                },
                {
                    "id": "80030308",
                    "speaker": "戴因斯雷布",
                    "text": "…好了。"
                },
                {
                    "id": "80030309",
                    "speaker": "派蒙",
                    "text": "哇，这就是…！"
                },
                {
                    "id": "80030310",
                    "speaker": "戴因斯雷布",
                    "text": "深渊使徒一直寻找的关键，「世上第一座耕地机的眼睛」。"
                },
                {
                    "id": "80030311",
                    "speaker": "戴因斯雷布",
                    "text": "如今留存的所有遗迹守卫，都是这台机器的仿制品。作为「原型机」，它的战斗力不受控制。"
                },
                {
                    "id": "80030312",
                    "speaker": "派蒙",
                    "text": "「原型机」…难懂的词，是坎瑞亚人的术语吗。"
                },
                {
                    "id": "80030313",
                    "speaker": "戴因斯雷布",
                    "text": "正如深渊教团所想，若能将「眼」置于「污秽逆位神像」之手…"
                },
                {
                    "id": "80030314",
                    "speaker": "戴因斯雷布",
                    "text": "以此作为基底，接合「漩涡之魔神」奥赛尔的肢体，制造机械魔神…"
                },
                {
                    "id": "80030315",
                    "speaker": "戴因斯雷布",
                    "text": "就能为新诞生的污秽魔神，赋予「动摇天空岛上神座」的力量。",
                    "choices": [
                        {
                            "id": "80030316",
                            "text": "极端又危险的行为…",
                            "response": [
                                {
                                    "id": "80030318",
                                    "speaker": "戴因斯雷布",
                                    "text": "没错。"
                                },
                                {
                                    "id": "80030319",
                                    "speaker": "派蒙",
                                    "text": "那那那，这「眼睛」该怎么处理？",
                                    "choices": [
                                        {
                                            "id": "80030320",
                                            "text": "找个隐秘的地方藏起来吧。",
                                            "response": [
                                                {
                                                    "id": "80030322",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "不。由我来保管它。"
                                                },
                                                {
                                                    "id": "80030323",
                                                    "speaker": "派蒙",
                                                    "text": "欸？！你？戴因…你该不会拿它去做奇怪的事吧！"
                                                },
                                                {
                                                    "id": "80030324",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "随你质疑我的立场吧，但我必须确保它的力量不被旁人利用。"
                                                },
                                                {
                                                    "id": "80030325",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "隐秘之地会被挖掘，而教会——在我眼中不值得信任。"
                                                },
                                                {
                                                    "id": "80030326",
                                                    "speaker": "派蒙",
                                                    "text": "呃…嗯…"
                                                },
                                                {
                                                    "id": "80030327",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "不仅如此，为了永绝后患，我们还要「处理」那座「污秽逆位神像」。",
                                                    "choices": [
                                                        {
                                                            "id": "80030328",
                                                            "text": "怎么处理？",
                                                            "response": [
                                                                {
                                                                    "id": "80030330",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "不能让教会介入，我们自己处理。至于「处理」的意思…自然是销毁了。"
                                                                },
                                                                {
                                                                    "id": "80030331",
                                                                    "speaker": "派蒙",
                                                                    "text": "销、销毁？！那可是七天神像啊！不仅是很有意义的文物，而且是真正的、神灵的…"
                                                                },
                                                                {
                                                                    "id": "80030332",
                                                                    "speaker": "派蒙",
                                                                    "text": "幸亏之前瞒着芭芭拉，否则她现在一定会疯的！"
                                                                },
                                                                {
                                                                    "id": "80030333",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "呵…七神之物，难道还要我帮他们悉心爱护？"
                                                                },
                                                                {
                                                                    "id": "80030334",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "走吧，回<color=#00E1FFFF>那座遗迹</color>。我们去砸毁逆位的神像，而且，运气好的话，还能遇到「深渊使徒」。"
                                                                },
                                                                {
                                                                    "id": "80030335",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "有我在，它就没可能再从你眼前消失一次了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80030329",
                                                            "text": "可以交给教会去办吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80030321",
                                            "text": "交给西风教会保管吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80030317",
                            "text": "一定要阻止深渊教团。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800302",
            "objective": "再次进入遗迹",
            "dialogues": [
                {
                    "id": "80030201",
                    "speaker": "派蒙",
                    "text": "那，那个人，难道就是…？！"
                },
                {
                    "id": "80030202",
                    "speaker": "Player",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}！"
                },
                {
                    "id": "80030203",
                    "speaker": "Sibling",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}…",
                    "choices": [
                        {
                            "id": "80030204",
                            "text": "终于找到你了！",
                            "response": [
                                {
                                    "id": "80030206",
                                    "speaker": "派蒙",
                                    "text": "#等…等等，{NICKNAME}，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}刚才替深渊使徒挡住了攻击…"
                                },
                                {
                                    "id": "80030207",
                                    "speaker": "派蒙",
                                    "text": "#你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}，好像和「深渊」…"
                                },
                                {
                                    "id": "80030208",
                                    "speaker": "Sibling",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}，为什么你和戴因在一起？",
                                    "choices": [
                                        {
                                            "id": "80030209",
                                            "text": "…什么？",
                                            "response": [
                                                {
                                                    "id": "80030211",
                                                    "speaker": "Player",
                                                    "text": "（我们分离了这么久…）"
                                                },
                                                {
                                                    "id": "80030213",
                                                    "speaker": "派蒙",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "80030214",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SISTER|INFO_FEMALE_PRONOUN_BROTHER]}…认识戴因？"
                                                },
                                                {
                                                    "id": "80030215",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "80030216",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}。我们又见面了。"
                                                },
                                                {
                                                    "id": "80030217",
                                                    "speaker": "派蒙",
                                                    "text": "#这…这究竟是怎么回事？！戴因也知道{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_FEMALE_PRONOUN_HE]}的名字！"
                                                },
                                                {
                                                    "id": "80030218",
                                                    "speaker": "Sibling",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}…你不该和这个人同行。"
                                                },
                                                {
                                                    "id": "80030219",
                                                    "speaker": "Sibling",
                                                    "text": "这个人…是我的「敌人」。"
                                                },
                                                {
                                                    "id": "80030220",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}…",
                                                    "choices": [
                                                        {
                                                            "id": "80030221",
                                                            "text": "等一下！",
                                                            "response": [
                                                                {
                                                                    "id": "80030223",
                                                                    "speaker": "Sibling",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "80030224",
                                                                    "speaker": "Sibling",
                                                                    "text": "#但这是必须对你说的话，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}。不要与戴因一起来阻止我。不要阻止「深渊」。"
                                                                },
                                                                {
                                                                    "id": "80030225",
                                                                    "speaker": "Sibling",
                                                                    "text": "那个人…戴因斯雷布。他是坎瑞亚末代宫廷卫队的「末光之剑」。在五百年前，他未能阻止坎瑞亚的灭国。"
                                                                },
                                                                {
                                                                    "id": "80030226",
                                                                    "speaker": "Sibling",
                                                                    "text": "那时他身受不死诅咒，流浪荒野…只能看着他想要守护的人民，化作深渊的怪物。"
                                                                },
                                                                {
                                                                    "id": "80030227",
                                                                    "speaker": "派蒙",
                                                                    "text": "你说…戴因是坎瑞亚人？！五百年前经历灭国的坎瑞亚人？！"
                                                                },
                                                                {
                                                                    "id": "80030228",
                                                                    "speaker": "派蒙",
                                                                    "text": "而且你说「人民化作怪物」…是说现在的深渊教团，不止是「和坎瑞亚有关联」的程度，根本就是坎瑞亚的「遗民」本身吗？！"
                                                                },
                                                                {
                                                                    "id": "80030229",
                                                                    "speaker": "派蒙",
                                                                    "text": "呜…还有「戴因是你的敌人」什么的，一下子完全搞不清状况了…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80030230",
                                                                            "text": "#先跟我走吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}！我们回家！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80030232",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "家…"
                                                                                },
                                                                                {
                                                                                    "id": "80030233",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "#嗯，当然，有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}在的地方就是「家」。"
                                                                                },
                                                                                {
                                                                                    "id": "80030234",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "但我还不能与你去往下一个世界、寻找新的家园…至少现在不能。"
                                                                                },
                                                                                {
                                                                                    "id": "80030235",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "在「深渊」淹没神座之前，我与「天理」，有一场尚未完结的战争…"
                                                                                },
                                                                                {
                                                                                    "id": "80030236",
                                                                                    "speaker": "Player",
                                                                                    "text": "天…理？"
                                                                                },
                                                                                {
                                                                                    "id": "80030237",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "#听我说，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_YING]}。"
                                                                                },
                                                                                {
                                                                                    "id": "80030238",
                                                                                    "speaker": "Sibling",
                                                                                    "text": "我已经有过一次旅行。所以，你也要像我一样抵达终点，才能在自己的眼中，留下这个世界的沉淀。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80030231",
                                                                            "text": "这些事以后再告诉我，我们回家吧！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80030222",
                                                            "text": "#别再说我不明白的话了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80030210",
                                            "text": "你问…戴因？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80030205",
                            "text": "快跟我走！这里很危险！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800308",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "80030401",
                    "speaker": "派蒙",
                    "text": "没想到，这一路上兜兜转转，最后又走回来了呀。"
                },
                {
                    "id": "80030402",
                    "speaker": "派蒙",
                    "text": "好不容易逃出险境，现在又要钻进去！"
                },
                {
                    "id": "80030403",
                    "speaker": "派蒙",
                    "text": "哎，像我们这样勇敢的冒险家，整个提瓦特大陆都找不出多少啦。"
                }
            ]
        },
        {
            "id": "800309",
            "objective": "再次进入遗迹",
            "dialogues": []
        },
        {
            "id": "800303",
            "objective": "找到「污秽逆位神像」",
            "dialogues": []
        },
        {
            "id": "800310",
            "objective": "与戴因对话",
            "dialogues": [
                {
                    "id": "80030501",
                    "speaker": "戴因斯雷布",
                    "text": "看来，我们到了。"
                },
                {
                    "id": "80030502",
                    "speaker": "戴因斯雷布",
                    "text": "怪异、枯萎…令人不快的房间。我理解你们所说的恶质气氛了。"
                },
                {
                    "id": "80030503",
                    "speaker": "派蒙",
                    "text": "呜呜呜…还是这么恐怖的环境…"
                },
                {
                    "id": "80030504",
                    "speaker": "戴因斯雷布",
                    "text": "小心，不要被「污秽逆位神像」的力量压倒了——「深渊使徒」就在这里。"
                },
                {
                    "id": "80030505",
                    "speaker": "深渊使徒",
                    "text": "呵呵呵呵…敏锐的嗅觉…"
                },
                {
                    "id": "80030506",
                    "speaker": "深渊使徒",
                    "text": "你还是这么讨人厌啊，教团之敌，戴因斯雷布！"
                },
                {
                    "id": "80030507",
                    "speaker": "深渊使徒",
                    "text": "我能感受到，你身上有股可怕的血腥味。是来自漆黑的噩梦，亦或是…嗯？"
                },
                {
                    "id": "80030508",
                    "speaker": "深渊使徒",
                    "text": "噢噢…真危险。你也有那种「腐朽」的味道，让我熟悉…"
                },
                {
                    "id": "80030509",
                    "speaker": "深渊使徒",
                    "text": "你和我们一样，都是危险的事物。但「教团」以外的危险之物，都该被放在笼子里才对…"
                },
                {
                    "id": "80030510",
                    "speaker": "戴因斯雷布",
                    "text": "啧。"
                },
                {
                    "id": "80030511",
                    "speaker": "戴因斯雷布",
                    "text": "你的舌头，恐怕也「腐朽」了太久…"
                },
                {
                    "id": "80030512",
                    "speaker": "戴因斯雷布",
                    "text": "该切了！"
                }
            ]
        },
        {
            "id": "800304",
            "objective": "击败深渊使徒",
            "dialogues": []
        },
        {
            "id": "800305",
            "objective": "#与{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_KONG]}相会",
            "dialogues": []
        },
        {
            "id": "800311",
            "objective": "与派蒙对话",
            "dialogues": []
        }
    ]
}