    "talks": [
        {
            "id": "7319301",
            "objective": "(test)与村民对话$HIDDEN",
            "dialogues": [
                {
                    "id": "731930101",
                    "speaker": "齐亚德",
                    "text": "♪蔷薇啊蔷薇，实现我的愿望。"
                },
                {
                    "id": "731930102",
                    "speaker": "齐亚德",
                    "text": "♪花从石头中绽放，金蔷薇对我歌唱。"
                },
                {
                    "id": "731930103",
                    "speaker": "齐亚德",
                    "text": "♪她唱…"
                },
                {
                    "id": "731930104",
                    "speaker": "派蒙",
                    "text": "这是须弥本地的童谣吧。会唱歌的蔷薇，嗯，是首可爱的歌呢。"
                },
                {
                    "id": "731930105",
                    "speaker": "派蒙",
                    "text": "可惜那个男孩唱到一半就跑开了，本来我还想听完再打个招呼的。"
                },
                {
                    "id": "731930106",
                    "speaker": "赛芭",
                    "text": "是生面孔啊，两位客人是第一次来阿如村吗？",
                    "choices": [
                        {
                            "id": "731930107",
                            "text": "是的。",
                            "response": [
                                {
                                    "id": "731930108",
                                    "speaker": "赛芭",
                                    "text": "这就对了，难怪你们没听过蔷薇歌谣。"
                                },
                                {
                                    "id": "731930111",
                                    "speaker": "赛芭",
                                    "text": "你们是从其他国家来须弥求学的学者吧，我记得教令院里有很多异国学者。"
                                },
                                {
                                    "id": "731930112",
                                    "speaker": "派蒙",
                                    "text": "虽然我们是认识很多学者没错，但要说我们自己…哎呀，还算不上啦。"
                                },
                                {
                                    "id": "731930113",
                                    "speaker": "派蒙",
                                    "text": "#严格来说，我们是冒险家哦，周游世界的冒险家二人组——派蒙和{NICKNAME}。"
                                },
                                {
                                    "id": "731930114",
                                    "speaker": "赛芭",
                                    "text": "周游世界吗？哈哈哈哈…"
                                },
                                {
                                    "id": "731930115",
                                    "speaker": "派蒙",
                                    "text": "怎么嘛？有什么好笑的啦，我们可是很有名的冒险家，你别不信。"
                                },
                                {
                                    "id": "731930116",
                                    "speaker": "赛芭",
                                    "text": "啊，两位远道来的客人，我并不是在嘲笑你们。正相反，听到周游世界这种让人振奋的话，我很开心。"
                                },
                                {
                                    "id": "731930117",
                                    "speaker": "赛芭",
                                    "text": "跟世界脱节太久，突然听到这样的豪言壮语，还有些惊讶。"
                                },
                                {
                                    "id": "731930118",
                                    "speaker": "赛芭",
                                    "text": "这才一时做出了冒犯的行为，我叫作赛芭，向两位道歉，同时也欢迎你们来到阿如村。"
                                },
                                {
                                    "id": "731930119",
                                    "speaker": "赛芭",
                                    "text": "对了，你们刚才是在讨论齐亚德唱的蔷薇歌谣吗？",
                                    "choices": [
                                        {
                                            "id": "731930120",
                                            "text": "没错。",
                                            "response": [
                                                {
                                                    "id": "731930122",
                                                    "speaker": "赛芭",
                                                    "text": "既然你们感兴趣，我们可以聊聊蔷薇歌谣，希望这些闲聊能点缀你们的旅程。"
                                                },
                                                {
                                                    "id": "731930123",
                                                    "speaker": "派蒙",
                                                    "text": "赛芭小姐打算给我们唱歌听吗？好啊好啊，刚才那首歌谣特别好听，我正想听完呢。"
                                                },
                                                {
                                                    "id": "731930124",
                                                    "speaker": "赛芭",
                                                    "text": "抱歉，我不太擅长唱歌…不过我们倒是可以谈谈蔷薇歌谣的内容。"
                                                },
                                                {
                                                    "id": "731930125",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，记得刚才那个孩子唱到「蔷薇能实现愿望」来着…"
                                                },
                                                {
                                                    "id": "731930126",
                                                    "speaker": "赛芭",
                                                    "text": "是的，我们这样的小村子里，没有教令院那样的大图书馆，所有的歌都是口口相传的。"
                                                },
                                                {
                                                    "id": "731930127",
                                                    "speaker": "赛芭",
                                                    "text": "我一直认为，歌谣中能实现愿望的花朵，应该是先民们的集体想象。"
                                                },
                                                {
                                                    "id": "731930128",
                                                    "speaker": "赛芭",
                                                    "text": "在沙漠这种极端环境下，水是一种极其重要的生存资源，先民们非常重视能储水的植物。"
                                                },
                                                {
                                                    "id": "731930129",
                                                    "speaker": "赛芭",
                                                    "text": "所以越是地理条件苛刻的地方，越是多植物的传说，这里面蕴含着先民对美好生活的向往。"
                                                },
                                                {
                                                    "id": "731930130",
                                                    "speaker": "赛芭",
                                                    "text": "同时，它们也是先民与沙漠生物之间共生关系的例证。"
                                                },
                                                {
                                                    "id": "731930131",
                                                    "speaker": "赛芭",
                                                    "text": "不过就这个例子而言…阿如村是一个建立在沙地上的村落，这里的土壤并不适合须弥蔷薇。"
                                                },
                                                {
                                                    "id": "731930132",
                                                    "speaker": "赛芭",
                                                    "text": "我自己栽种的须弥蔷薇就始终无法生长，所以我想，歌谣中的金蔷薇可能是想象出的物种…"
                                                },
                                                {
                                                    "id": "731930133",
                                                    "speaker": "派蒙",
                                                    "text": "唔，等一下…我越来越跟不上了。"
                                                },
                                                {
                                                    "id": "731930134",
                                                    "speaker": "派蒙",
                                                    "text": "赛芭小姐，你们闲聊的时候都会讨论这种话题吗？"
                                                },
                                                {
                                                    "id": "731930135",
                                                    "speaker": "赛芭",
                                                    "text": "…啊！对不起，我以为两位是从外面来的，比起天气和收成，可能更想听这种话题。"
                                                },
                                                {
                                                    "id": "731930136",
                                                    "speaker": "派蒙",
                                                    "text": "前面的那些共生关系、集体想象什么的…我的确是不明白，不过最后那句我听懂了。"
                                                },
                                                {
                                                    "id": "731930137",
                                                    "speaker": "派蒙",
                                                    "text": "你是说这里的土地不适合种须弥蔷薇对吧？的确，我们也只在土壤更湿润的地方见过须弥蔷薇呢。",
                                                    "choices": [
                                                        {
                                                            "id": "731930138",
                                                            "text": "毕竟是沙地。",
                                                            "response": [
                                                                {
                                                                    "id": "731930140",
                                                                    "speaker": "赛芭",
                                                                    "text": "讲起蔷薇，有件事我刚才就在想了，既然两位是冒险家，说不定能接受我的委托…"
                                                                },
                                                                {
                                                                    "id": "731930141",
                                                                    "speaker": "派蒙",
                                                                    "text": "#哈哈，说这个可就有得聊了。{NICKNAME}和我是见过大风大浪的冒险家，什么委托都能解决。"
                                                                },
                                                                {
                                                                    "id": "731930142",
                                                                    "speaker": "Player",
                                                                    "text": "所以遇到了什么困难？"
                                                                },
                                                                {
                                                                    "id": "731930143",
                                                                    "speaker": "赛芭",
                                                                    "text": "我知道，非要求本不属于这里的蔷薇开出花来实在勉强，但无论如何，我还是希望看到它们开放的样子。"
                                                                },
                                                                {
                                                                    "id": "731930144",
                                                                    "speaker": "赛芭",
                                                                    "text": "说起来有点不好意思，这算是我的一点心结吧。"
                                                                },
                                                                {
                                                                    "id": "731930145",
                                                                    "speaker": "赛芭",
                                                                    "text": "按我对蔷薇的了解，如果能使用草元素含量高的肥料，就算是沙地上，它们还是能发芽的。"
                                                                },
                                                                {
                                                                    "id": "731930146",
                                                                    "speaker": "赛芭",
                                                                    "text": "不过这里很难弄到那样的肥料，所以我想拜托两位看看，能不能买到草元素含量高的肥料…"
                                                                },
                                                                {
                                                                    "id": "731930147",
                                                                    "speaker": "Player",
                                                                    "text": "草元素？"
                                                                },
                                                                {
                                                                    "id": "731930148",
                                                                    "speaker": "赛芭",
                                                                    "text": "是的，草元素对生物的生长有很大促进作用，对长势不佳的作物尤其有效。"
                                                                },
                                                                {
                                                                    "id": "731930149",
                                                                    "speaker": "赛芭",
                                                                    "text": "但我是个普通人，没有草元素神之眼，高效的肥料又买不到，真是没有办法。"
                                                                },
                                                                {
                                                                    "id": "731930150",
                                                                    "speaker": "派蒙",
                                                                    "text": "只要<color=#00E1FFFF>草元素</color>的话，那反而简单了，看我们的吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731930139",
                                                            "text": "蔷薇真娇气。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731930121",
                                            "text": "蔷薇歌谣？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731930109",
                            "text": "不是。",
                            "response": [
                                {
                                    "id": "731930110",
                                    "speaker": "赛芭",
                                    "text": "哦？我猜错了吗…让我想想。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7319302",
            "objective": "使用草元素的力量为种子「施肥」",
            "dialogues": []
        },
        {
            "id": "7319305",
            "objective": "和赛芭聊聊",
            "dialogues": [
                {
                    "id": "731930901",
                    "speaker": "赛芭",
                    "text": "你能够使用草元素力？难道我碰上神之眼持有者了…"
                },
                {
                    "id": "731930902",
                    "speaker": "赛芭",
                    "text": "好久没见过这样的人了，真让人怀念。"
                },
                {
                    "id": "731930903",
                    "speaker": "派蒙",
                    "text": "赛芭小姐，赛芭小姐，这样就好了吧。"
                },
                {
                    "id": "731930904",
                    "speaker": "赛芭",
                    "text": "没错，而且直接使用草元素力的话，它们应该很快就能发芽，我们等等看吧——"
                },
                {
                    "id": "731930905",
                    "speaker": "Black Screen",
                    "text": "慢慢地，几根细弱的幼芽从土坑里钻了出来。"
                },
                {
                    "id": "731930906",
                    "speaker": "Black Screen",
                    "text": "展开几片绿叶后，幼芽不再生长。"
                },
                {
                    "id": "731930907",
                    "speaker": "派蒙",
                    "text": "#发芽了发芽了，我就说嘛，{NICKNAME}什么都能做好。"
                },
                {
                    "id": "731930908",
                    "speaker": "赛芭",
                    "text": "果然立刻就看到效果了，感谢你们。"
                },
                {
                    "id": "731930909",
                    "speaker": "Player",
                    "text": "可惜没有开花。"
                },
                {
                    "id": "731930910",
                    "speaker": "赛芭",
                    "text": "啊，这是很自然的事，不能着急。"
                },
                {
                    "id": "731930911",
                    "speaker": "赛芭",
                    "text": "植物总要经历发芽、抽枝、结苞、开花这样的生长阶段，你能那么快就让种子发芽，已经很厉害了。"
                },
                {
                    "id": "731930912",
                    "speaker": "赛芭",
                    "text": "多给蔷薇点时间，让它们继续汲取些养分再开花吧，这样对它们也好。"
                },
                {
                    "id": "731930913",
                    "speaker": "赛芭",
                    "text": "况且今天的事已经让我很感激了，再麻烦两位就太不礼貌了。"
                },
                {
                    "id": "731930914",
                    "speaker": "赛芭",
                    "text": "以后你们空闲的时候，能来看看它们就很好了。"
                }
            ]
        },
        {
            "id": "7319309",
            "objective": "(test)发芽刷suite$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7319308",
            "objective": "(test)73193与赛芭闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "731930501",
                    "speaker": "赛芭",
                    "text": "如果不是遇到你们，恐怕我很难看到那些蔷薇发芽。"
                },
                {
                    "id": "731930502",
                    "speaker": "赛芭",
                    "text": "早知道会这样，比起种子，当初我更应该带些书来这里。",
                    "choices": [
                        {
                            "id": "731930503",
                            "text": "你不是本地人？",
                            "response": [
                                {
                                    "id": "731930504",
                                    "speaker": "赛芭",
                                    "text": "很意外吗？这算是说明我适应得很好吧。"
                                },
                                {
                                    "id": "731930505",
                                    "speaker": "赛芭",
                                    "text": "当初刚来这里的时候，从衣食到起居习惯，每一样我都没办法适应。"
                                },
                                {
                                    "id": "731930506",
                                    "speaker": "赛芭",
                                    "text": "但过了这么久，慢慢也就接受了。"
                                },
                                {
                                    "id": "731930507",
                                    "speaker": "赛芭",
                                    "text": "只不过表面适应，并不代表内心就接受了自己的处境。"
                                },
                                {
                                    "id": "731930508",
                                    "speaker": "赛芭",
                                    "text": "能在须弥城里盛放的蔷薇，在这里始终还是难以开花。"
                                },
                                {
                                    "id": "731930509",
                                    "speaker": "Player",
                                    "text": "你是学者吗？"
                                },
                                {
                                    "id": "731930510",
                                    "speaker": "赛芭",
                                    "text": "我…曾经被称为学者，但现在不是了。"
                                },
                                {
                                    "id": "731930511",
                                    "speaker": "赛芭",
                                    "text": "我说了以我的身份不该说的话，了解了以我的身份不该了解的知识。"
                                },
                                {
                                    "id": "731930512",
                                    "speaker": "赛芭",
                                    "text": "这是有违教令院禁忌的，所以我就不再是学者了。"
                                },
                                {
                                    "id": "731930513",
                                    "speaker": "Player",
                                    "text": "你说了什么？"
                                },
                                {
                                    "id": "731930514",
                                    "speaker": "赛芭",
                                    "text": "好奇心是我们寻求智慧的原动力，但也是招致罪罚的源头。"
                                },
                                {
                                    "id": "731930515",
                                    "speaker": "赛芭",
                                    "text": "这是我被驱逐到这里来之后才明白的。"
                                },
                                {
                                    "id": "731930516",
                                    "speaker": "赛芭",
                                    "text": "安全起见，我认为不向你细说最好。"
                                },
                                {
                                    "id": "731930517",
                                    "speaker": "Player",
                                    "text": "那好吧。"
                                },
                                {
                                    "id": "731930518",
                                    "speaker": "赛芭",
                                    "text": "咳咳，不过…那个…"
                                },
                                {
                                    "id": "731930535",
                                    "speaker": "赛芭",
                                    "text": "我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。"
                                },
                                {
                                    "id": "731930536",
                                    "speaker": "赛芭",
                                    "text": "没想到，又跟你说了这么多话。"
                                },
                                {
                                    "id": "731930537",
                                    "speaker": "赛芭",
                                    "text": "嗯…在这里，我能敞开聊天的朋友不是很多。"
                                },
                                {
                                    "id": "731930538",
                                    "speaker": "赛芭",
                                    "text": "你认为…之后…你有空来帮忙给它们施肥吗？"
                                },
                                {
                                    "id": "731930539",
                                    "speaker": "Player",
                                    "text": "可以。"
                                },
                                {
                                    "id": "731930540",
                                    "speaker": "赛芭",
                                    "text": "那…好，我会等你来的。"
                                }
                            ]
                        },
                        {
                            "id": "731930519",
                            "text": "为什么要种须弥蔷薇？",
                            "response": [
                                {
                                    "id": "731930520",
                                    "speaker": "赛芭",
                                    "text": "你可能不太了解须弥蔷薇，这种植物的用途非常广泛。"
                                },
                                {
                                    "id": "731930521",
                                    "speaker": "赛芭",
                                    "text": "它可以食用、可以药用，作为礼品，也有很高的经济价值。"
                                },
                                {
                                    "id": "731930522",
                                    "speaker": "赛芭",
                                    "text": "这还仅仅是它在我们日常生活中的常见用途。"
                                },
                                {
                                    "id": "731930523",
                                    "speaker": "赛芭",
                                    "text": "须弥蔷薇的花、叶、茎并不总是我们今天见到的这样，它曾经也有过不同的形态。"
                                },
                                {
                                    "id": "731930524",
                                    "speaker": "赛芭",
                                    "text": "我认为地理条件的改变，促使须弥蔷薇的形态特征也发生过改变。"
                                },
                                {
                                    "id": "731930525",
                                    "speaker": "赛芭",
                                    "text": "从它的形态演化过程，我们能得到很多历史地理方面的信息。"
                                },
                                {
                                    "id": "731930526",
                                    "speaker": "赛芭",
                                    "text": "这不是一两句话说得清的事，向一位路过的冒险家解释恐怕也不合规定。"
                                },
                                {
                                    "id": "731930527",
                                    "speaker": "赛芭",
                                    "text": "如果你对植物演化感兴趣，就去教令院吧，那里的植物学教育更加完备。"
                                },
                                {
                                    "id": "731930528",
                                    "speaker": "Player",
                                    "text": "所以是为了研究？"
                                },
                                {
                                    "id": "731930529",
                                    "speaker": "赛芭",
                                    "text": "我已经不是学者了，没有做研究的条件和资格。"
                                },
                                {
                                    "id": "731930530",
                                    "speaker": "赛芭",
                                    "text": "非要说为什么的话…唉，你的好奇心可真重。"
                                },
                                {
                                    "id": "731930531",
                                    "speaker": "赛芭",
                                    "text": "我以前的居所里种了很多须弥蔷薇，它们开花的时候很漂亮，我每天都看得到。"
                                },
                                {
                                    "id": "731930532",
                                    "speaker": "赛芭",
                                    "text": "有可能的话，我还想像以前一样，每天都有它们作陪。"
                                },
                                {
                                    "id": "731930533",
                                    "speaker": "赛芭",
                                    "text": "…只是这样而已。"
                                },
                                {
                                    "id": "731930534",
                                    "speaker": "Player",
                                    "text": "我能理解。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
