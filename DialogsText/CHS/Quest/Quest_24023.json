    "talks": [
        {
            "id": "2402301",
            "objective": "与安里对话",
            "dialogues": [
                {
                    "id": "240230101",
                    "speaker": "安里",
                    "text": "#{NICKNAME}，你来得正好！枫达研究工作取得了重大进展！"
                },
                {
                    "id": "240230102",
                    "speaker": "安里",
                    "text": "我已经做出了一瓶「实验饮品」，正想要找人来试喝，给我一些意见。"
                },
                {
                    "id": "240230103",
                    "speaker": "安里",
                    "text": "既然你来了，正好来试喝一下！"
                },
                {
                    "id": "240230104",
                    "speaker": "Player",
                    "text": "不会给我喝出问题来吧？"
                },
                {
                    "id": "240230105",
                    "speaker": "安里",
                    "text": "绝对不会，我已经试喝过这瓶饮品了，相信我，它绝对不会危害你的健康。"
                },
                {
                    "id": "240230106",
                    "speaker": "Player",
                    "text": "那我…我就试试看。"
                },
                {
                    "id": "240230107",
                    "speaker": "安里",
                    "text": "没问题，我最看重您的意见了！走，咱们去那边试喝一下。"
                },
                {
                    "id": "240230108",
                    "speaker": "安里",
                    "text": "美味的枫达，当然要配着开阔的景致享用！"
                }
            ]
        },
        {
            "id": "2402302",
            "objective": "尝尝「实验饮品」",
            "dialogues": [
                {
                    "id": "240230201",
                    "speaker": "安里",
                    "text": "这瓶枫达就送给您了。这里面可是饱含着我们的心血啊，味道一定不会差的。"
                },
                {
                    "id": "240230202",
                    "speaker": "安里",
                    "text": "但这种枫达还存在着许多问题。比如原料的处理方式和投放剂量、灌装时的最佳容量…"
                },
                {
                    "id": "240230203",
                    "speaker": "安里",
                    "text": "甚至还有瓶身的设计方案。既然是新型枫达，那自然也要采用全新的包装，才能让人印象深刻。"
                },
                {
                    "id": "240230204",
                    "speaker": "安里",
                    "text": "不过，这些问题就留给我操心吧，您只需要安心享用枫达就好。"
                },
                {
                    "id": "240230205",
                    "speaker": "安里",
                    "text": "这瓶枫达我特意灌装了两个人的量，应该够您喝了。"
                },
                {
                    "id": "240230206",
                    "speaker": "安里",
                    "text": "再次感谢您的协助！记住，清爽枫达，畅饮世界！"
                }
            ]
        },
