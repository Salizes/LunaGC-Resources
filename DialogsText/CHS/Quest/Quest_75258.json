    "talks": [
        {
            "id": "7525801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752580101",
                    "speaker": "派蒙",
                    "text": "欸？这里怎么有一个晕倒的人？"
                },
                {
                    "id": "752580102",
                    "speaker": "派蒙",
                    "text": "喂！你听得见吗？你怎么啦？"
                },
                {
                    "id": "752580103",
                    "speaker": "Black Screen",
                    "text": "你们扶起了地上的人，他慢慢醒了过来…"
                },
                {
                    "id": "752580104",
                    "speaker": "晕倒的员工",
                    "text": "哎哟哟哟…",
                    "choices": [
                        {
                            "id": "752580105",
                            "text": "你好，你喝多了吗？",
                            "response": [
                                {
                                    "id": "752580107",
                                    "speaker": "晕倒的员工",
                                    "text": "头好晕…这是怎么回事…让我想想…"
                                },
                                {
                                    "id": "752580108",
                                    "speaker": "晕倒的员工",
                                    "text": "啊！想起来了！我好像是被人打晕了…但是我没见着是谁动手的。等等…不会就是你们动的手吧？！"
                                },
                                {
                                    "id": "752580109",
                                    "speaker": "派蒙",
                                    "text": "喂！我们可是好心扶你起来的人啊，你可不要碰瓷！"
                                },
                                {
                                    "id": "752580110",
                                    "speaker": "晕倒的员工",
                                    "text": "噢噢，对不起，呃…我是「醅蜜」酒吧的员工，本来要去北边的港口送货，嗯…挪德卡莱的商会跟我们采购了一些蜜酿。"
                                },
                                {
                                    "id": "752580111",
                                    "speaker": "晕倒的员工",
                                    "text": "哎呀！完了，我的货呢？蜜酿没了！难道是被抢走了？等等…不会就是你们抢走的吧？！"
                                },
                                {
                                    "id": "752580112",
                                    "speaker": "派蒙",
                                    "text": "都说了我们是好心扶你起来的人啊！"
                                },
                                {
                                    "id": "752580113",
                                    "speaker": "晕倒的员工",
                                    "text": "哦对对对，对不起，我现在有点头晕。非常感谢你们，但我得立刻回酒吧报告一下情况…"
                                },
                                {
                                    "id": "752580114",
                                    "speaker": "晕倒的员工",
                                    "text": "如果真的有强盗，你们也不要往北边的港口去了，可能会有危险。"
                                }
                            ]
                        },
                        {
                            "id": "752580106",
                            "text": "需要送你回家吗？"
                        }
                    ]
                }
            ]
        }
    ]
}