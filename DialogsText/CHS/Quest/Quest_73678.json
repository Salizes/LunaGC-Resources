    "talks": [
        {
            "id": "7367801",
            "objective": "与晨曦酒庄附近的瓦尔特对话",
            "dialogues": [
                {
                    "id": "736780101",
                    "speaker": "法拉比",
                    "text": "旅行者，你们来了。"
                },
                {
                    "id": "736780102",
                    "speaker": "法拉比",
                    "text": "告诉你们一个好消息，因为之前找到了雪猪存活的确凿证据，刚刚我收到了导师的来信，我的论文选题已经在学院通过了。"
                },
                {
                    "id": "736780103",
                    "speaker": "派蒙",
                    "text": "哇，听起来很顺利呀，真是恭喜你了。"
                },
                {
                    "id": "736780104",
                    "speaker": "法拉比",
                    "text": "嗯，虽说开了个好头，不过后续的研究工作应该还会持续很长时间，我也做好了长期留在蒙德的准备。"
                },
                {
                    "id": "736780105",
                    "speaker": "法拉比",
                    "text": "接下来我要弄清楚的，就是雪猪们到底是以何种路径离开雪山，出现在了林子里。"
                },
                {
                    "id": "736780106",
                    "speaker": "法拉比",
                    "text": "根据之前找到的痕迹，我推测它们是从龙脊雪山的西侧下山，途径晨曦酒庄，然后再前往清泉镇的。"
                },
                {
                    "id": "736780107",
                    "speaker": "法拉比",
                    "text": "如果这个推断是正确的，我们应该能够在附近发现它们的踪迹，所以今天我们的目标，就是调查这件事。"
                },
                {
                    "id": "736780108",
                    "speaker": "派蒙",
                    "text": "原来如此。说起来你身边这位猎人打扮的大叔是谁？"
                },
                {
                    "id": "736780109",
                    "speaker": "瓦尔特",
                    "text": "你们好，我叫瓦尔特，最近负责保护晨曦酒庄附近的安全。"
                },
                {
                    "id": "736780110",
                    "speaker": "瓦尔特",
                    "text": "你们找雪猪的事，埃德蒙德那小子已经和我说了，今天你们就跟我一起行动吧，刚好我这里的人手也很紧缺呢。"
                },
                {
                    "id": "736780111",
                    "speaker": "瓦尔特",
                    "text": "唉，昨天晚上有野林猪闯进了附近的农舍，把居民养的鸽子和鸭子都惊飞了，到现在还没全部找回来。"
                },
                {
                    "id": "736780112",
                    "speaker": "瓦尔特",
                    "text": "旅行者，待会我们去捕猎的时候，如果你发现了这些小动物，就把它们捉住一并带回来吧。"
                },
                {
                    "id": "736780113",
                    "speaker": "Player",
                    "text": "没问题，交给我吧。"
                },
                {
                    "id": "736780114",
                    "speaker": "瓦尔特",
                    "text": "听说你会用猎人的捕猎工具，我在附近也放了一些，到时候你可以自行取用。等你做好准备，我们就可以出发了。",
                    "choices": [
                        {
                            "id": "736780115",
                            "text": "准备好了，出发吧！"
                        },
                        {
                            "id": "736780116",
                            "text": "等等，我还有些其他事要做。",
                            "response": [
                                {
                                    "id": "736780117",
                                    "speaker": "瓦尔特",
                                    "text": "嗯，别着急。我就在这等你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367802",
            "objective": "参加晨曦酒庄附近的捕猎",
            "dialogues": []
        }
    ]
}