    "talks": [
        {
            "id": "7650101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765010101",
                    "speaker": "菈乌玛",
                    "text": "#是你们啊，{NICKNAME}和派蒙。林间的飞鸟刚刚就在谈论你们的到来。今日前来，可是有什么要事，或是…需要我稍作指引？",
                    "choices": [
                        {
                            "id": "765010102",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765010104",
                                    "speaker": "菈乌玛",
                                    "text": "这里深受月华浸润，无论是植被还是栖息于此的生灵，都与外界不尽相同。"
                                },
                                {
                                    "id": "765010105",
                                    "speaker": "菈乌玛",
                                    "text": "的确是个能留下许多珍贵画片的地方。"
                                },
                                {
                                    "id": "765010106",
                                    "speaker": "菈乌玛",
                                    "text": "二位请随意徜徉，若有任何好奇之处，随时可以问我，我会尽我所能解答。",
                                    "choices": [
                                        {
                                            "id": "765010107",
                                            "text": "这里的气氛非常宁静呢。",
                                            "response": [
                                                {
                                                    "id": "765010109",
                                                    "speaker": "菈乌玛",
                                                    "text": "是的，这里是我的静思之地，也是我与万物低语、交流的所在。"
                                                },
                                                {
                                                    "id": "765010110",
                                                    "speaker": "菈乌玛",
                                                    "text": "仅仅是站在这里，心神就会归于安宁。"
                                                },
                                                {
                                                    "id": "765010111",
                                                    "speaker": "派蒙",
                                                    "text": "哇，听起来好有诗意啊！",
                                                    "choices": [
                                                        {
                                                            "id": "765010112",
                                                            "text": "其实，我有一个小小的请求…",
                                                            "response": [
                                                                {
                                                                    "id": "765010114",
                                                                    "speaker": "派蒙",
                                                                    "text": "是啊，菈乌玛小姐站在这里，和这里的景色浑然一体，简直美得像一幅画！用留影机拍下来一定特别好看！"
                                                                },
                                                                {
                                                                    "id": "765010115",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "为我…留下画片么？这倒是新奇的体验。若你们认为此刻的宁静，以及我的身影，值得被你们的镜头记录，我很乐意。"
                                                                },
                                                                {
                                                                    "id": "765010116",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "能成为你们旅途中一段美好的回忆，也是我的荣幸。"
                                                                },
                                                                {
                                                                    "id": "765010117",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "那么，我该如何配合呢？是需要我望向某个方向，还是保持自然的姿态便可？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765010118",
                                                                            "text": "像平时一样就可以了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765010120",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "好的，那接下来就交给你了。愿你能捕捉到那瞬息的灵感之光。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765010119",
                                                                            "text": "我会努力捕捉最动人的一刻。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765010113",
                                                            "text": "我们希望能为你拍摄画片。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765010108",
                                            "text": "菈乌玛平时都会待在这附近吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765010103",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650102",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7650104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010401",
                    "speaker": "菈乌玛",
                    "text": "那么，你准备好了吗？如果时机合适，我们随时可以开始。"
                }
            ]
        },
        {
            "id": "7650105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010501",
                    "speaker": "Player",
                    "text": "准备好了，我们开始留影吧！"
                }
            ]
        },
        {
            "id": "7650106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010601",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下角度。"
                }
            ]
        },
        {
            "id": "7650107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010701",
                    "speaker": "菈乌玛",
                    "text": "#是你们啊，{NICKNAME}和派蒙。林间的飞鸟刚刚就在谈论你们的到来。今日前来，可是有什么要事，或是…需要我稍作指引？",
                    "choices": [
                        {
                            "id": "765010702",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765010704",
                                    "speaker": "菈乌玛",
                                    "text": "嗯，请随意地感受和记录吧。"
                                },
                                {
                                    "id": "765010705",
                                    "speaker": "菈乌玛",
                                    "text": "不过，我似乎没看到你带着留影机？若无此物，再美的构思，也难以转化为可供回味的画片呢。"
                                }
                            ]
                        },
                        {
                            "id": "765010703",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010801",
                    "speaker": "菈乌玛",
                    "text": "感觉如何？有找到你心中想要的拍摄素材吗？",
                    "choices": [
                        {
                            "id": "765010803",
                            "text": "没问题，我们开始留影吧！",
                            "response": [
                                {
                                    "id": "765010804",
                                    "speaker": "菈乌玛",
                                    "text": "这很好。不过，我似乎没看到你带着留影机？若无此物，再美的构思，也难以转化为可供回味的画片呢。"
                                }
                            ]
                        },
                        {
                            "id": "765010802",
                            "text": "请稍等，我再构思一下角度。"
                        }
                    ]
                }
            ]
        }
    ]
