    "talks": [
        {
            "id": "7404101",
            "objective": "与布罗意对话",
            "dialogues": [
                {
                    "id": "740410101",
                    "speaker": "派蒙",
                    "text": "布罗意，你说的那两座观测站的数据，我们已经拿到手啦！"
                },
                {
                    "id": "740410102",
                    "speaker": "布罗意",
                    "text": "真的吗？！那可真是太好了！拜托了，快点让我看看——",
                    "choices": [
                        {
                            "id": "740410103",
                            "text": "喏，给你。",
                            "response": [
                                {
                                    "id": "740410107",
                                    "speaker": "Black Screen",
                                    "text": "将之前收集到的纸带交给了布罗意…"
                                },
                                {
                                    "id": "740410108",
                                    "speaker": "布罗意",
                                    "text": "啊啊啊，没错，就是这个，就是这个！两位简直就是上天派来救我脱离苦海，重新过上美好幸福清闲生活的天使——"
                                },
                                {
                                    "id": "740410109",
                                    "speaker": "派蒙",
                                    "text": "也不至于夸张到这个地步吧！"
                                },
                                {
                                    "id": "740410110",
                                    "speaker": "布罗意",
                                    "text": "#总之，事不宜迟，好心的{M#先生}{F#小姐}，我这就去找主管申请中枢处理站的钥匙，请您稍微等我一下！"
                                },
                                {
                                    "id": "740410111",
                                    "speaker": "派蒙",
                                    "text": "唉，真是的…记得快一点呀！"
                                },
                                {
                                    "id": "740410112",
                                    "speaker": "Black Screen",
                                    "text": "没过多久，布罗意兴奋地回来了…"
                                },
                                {
                                    "id": "740410113",
                                    "speaker": "布罗意",
                                    "text": "#{M#先生}{F#小姐}，我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！",
                                    "choices": [
                                        {
                                            "id": "740410114",
                                            "text": "哦…",
                                            "response": [
                                                {
                                                    "id": "740410116",
                                                    "speaker": "布罗意",
                                                    "text": "考虑到「果果软糖站」和「桔桔薄饼站」的情况，中枢处理站说不定也有那些来自至冬的先生们…"
                                                },
                                                {
                                                    "id": "740410117",
                                                    "speaker": "布罗意",
                                                    "text": "所以…拜托了，请两位陪伴我一起去吧！"
                                                },
                                                {
                                                    "id": "740410118",
                                                    "speaker": "派蒙",
                                                    "text": "唔，你可别忘了给我们报酬呀！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740410115",
                                            "text": "这种事情也需要我们跟着去吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740410104",
                            "text": "我们的报酬呢？",
                            "response": [
                                {
                                    "id": "740410105",
                                    "speaker": "布罗意",
                                    "text": "这个…请您不必担心，只要主管能批准恢复原本的水文研究，报酬一定不会少了您的！"
                                },
                                {
                                    "id": "740410106",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，那就好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
