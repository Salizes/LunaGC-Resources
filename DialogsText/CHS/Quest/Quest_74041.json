        {
            "id": "7404103",
            "objective": "(test)与研究员对话",
            "dialogues": [
                {
                    "id": "740410301",
                    "speaker": "(test)摸鱼研究员$UNRELEASED",
                    "text": "（test）我已经申请到了洞窟塔的紧急备用钥匙，咱们去洞窟塔回收数据吧 $UNRELEASED"
                },
                {
                    "id": "740410302",
