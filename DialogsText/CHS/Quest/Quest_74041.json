        {
            "id": "7404104",
            "objective": "前往中枢处理站",
            "dialogues": []
        },
        {
            "id": "7404114",
            "objective": "与布罗意对话",
            "dialogues": [
                {
                    "id": "740411401",
                    "speaker": "布罗意",
                    "text": "#我们到了！请看，{M#先生}{F#小姐}，这里就是中枢处理站，用来读取水文研究数据的地方！",
                    "choices": [
                        {
                            "id": "740411402",
                            "text": "好像没什么人…",
                            "response": [
                                {
                                    "id": "740411404",
                                    "speaker": "派蒙",
                                    "text": "是呀，既然没有愚人众，这里应该也就用不到我们了…"
                                },
                                {
                                    "id": "740411405",
                                    "speaker": "布罗意",
                                    "text": "这个…现在还不能肯定嘛，要是里面万一有那些至冬来的先生，我可能就再也见不到晶螺糕了…"
                                },
                                {
                                    "id": "740411406",
                                    "speaker": "布罗意",
                                    "text": "#咳，我是说，再也没办法进行水文研究了！就拜托两位好心{M#人}{F#的小姐}，陪我一起进去看看吧！"
                                },
                                {
                                    "id": "740411407",
                                    "speaker": "派蒙",
                                    "text": "唉，没办法，你开门吧…"
                                }
                            ]
                        },
                        {
                            "id": "740411403",
                            "text": "我能回去了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7404105",
            "objective": "进入中枢处理站",
            "dialogues": [
                {
                    "id": "740410501",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，看到那家伙了！在那边，不要逃！"
                }
            ]
        },
        {
            "id": "7404106",
            "objective": "调查中枢处理站",
            "dialogues": [
                {
                    "id": "740410601",
                    "speaker": "布罗意",
                    "text": "嗯，让我看看…"
                },
                {
                    "id": "740410602",
                    "speaker": "布罗意",
                    "text": "如果能把先前收集到的数据汇总起来，应该能取得不错的成果…恢复水文监测的事情，指日可待，指日可待呀！"
                },
                {
                    "id": "740410603",
                    "speaker": "派蒙",
                    "text": "哦哦，那真是太好啦！"
                },
                {
                    "id": "740410604",
                    "speaker": "布罗意",
                    "text": "咦？总觉得好像缺了一部分数据…是错觉吗？"
                },
                {
                    "id": "740410605",
                    "speaker": "派蒙",
                    "text": "为什么说得这么不确定啦！这不是你自己负责的数据吗！"
                },
                {
                    "id": "740410606",
                    "speaker": "马林诺夫斯基",
                    "text": "……"
                },
                {
                    "id": "740410607",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "740410608",
                    "speaker": "Player",
                    "text": "…？"
                },
                {
                    "id": "740410609",
                    "speaker": "马林诺夫斯基",
                    "text": "…呃，抱歉，走错房间了…"
                },
                {
                    "id": "740410610",
                    "speaker": "Black Screen",
                    "text": "愚人众指挥官，以一种与体型完全不符的敏捷，飞也似的溜走了…"
                },
                {
                    "id": "740410611",
                    "speaker": "派蒙",
                    "text": "等…等一下，刚才什么东西过去了？",
                    "choices": [
                        {
                            "id": "740410612",
                            "text": "好快，比龙蜥还要快…",
                            "response": [
                                {
                                    "id": "740410614",
                                    "speaker": "派蒙",
                                    "text": "不不不，现在好像不是关心那种事情的时候啦！那家伙是愚人众吧！为什么会出现在这里啊！"
                                },
                                {
                                    "id": "740410615",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们快点追上去，好好问个清楚！"
                                }
                            ]
                        },
                        {
                            "id": "740410613",
                            "text": "还真是个灵活的家伙…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7404107",
