        {
            "id": "501308",
            "objective": "与伙伴共享战场情报",
            "dialogues": [
                {
                    "id": "50130801",
                    "speaker": "希诺宁",
                    "text": "回声之子这里的魔物已经被清理干净了。"
                },
                {
                    "id": "50130802",
                    "speaker": "卡齐娜",
                    "text": "我去干掉了深渊瘤石！"
                },
                {
                    "id": "50130803",
                    "speaker": "玛拉妮",
                    "text": "流泉之众也搞定了，一炮了事！"
                },
                {
                    "id": "50130804",
                    "speaker": "茜特菈莉",
                    "text": "烟谜主的危险也解除了，需要去花羽会帮忙吗？"
                },
                {
                    "id": "50130805",
                    "speaker": "欧洛伦",
                    "text": "那边的情况好像挺严重的，我已经在路上了。"
                },
                {
                    "id": "50130806",
                    "speaker": "恰斯卡",
                    "text": "用不着，已经处理完了。"
                },
                {
                    "id": "50130807",
                    "speaker": "派蒙",
                    "text": "这么快？！你刚刚还在竞技场啊！"
                },
                {
                    "id": "50130808",
                    "speaker": "恰斯卡",
                    "text": "想找人揍一顿，你知道我忍了多久？"
                },
                {
                    "id": "50130809",
                    "speaker": "派蒙",
                    "text": "好、好吧…"
                },
                {
                    "id": "50130810",
                    "speaker": "玛拉妮",
                    "text": "伊安珊，沃陆之邦怎么办，你家离竞技场可远了。"
                },
                {
                    "id": "50130811",
                    "speaker": "伊安珊",
                    "text": "哦，这个不用担心，刚刚瓦雷莎和我通信了，那边也解决了。"
                },
                {
                    "id": "50130812",
                    "speaker": "基尼奇",
                    "text": "看来全都没事了呢，深渊似乎也示弱了。"
                },
                {
                    "id": "50130813",
                    "speaker": "派蒙",
                    "text": "对啊，这家伙就知道用数量优势，和还魂诗比比，看看谁人更多吧！"
                },
                {
                    "id": "50130814",
                    "speaker": "基尼奇",
                    "text": "等等，深渊好像集结了一批魔物，往竞技场的方向冲了。"
                },
                {
                    "id": "50130815",
                    "speaker": "基尼奇",
                    "text": "看来它也意识到，还魂诗是最大的麻烦，想要去破坏圣火。"
                },
                {
                    "id": "50130816",
                    "speaker": "玛拉妮",
                    "text": "怎么可能让它得逞，朋友们，竞技场集合！"
                },
                {
                    "id": "50130817",
                    "speaker": "希诺宁",
                    "text": "我看到有新的深渊瘤石砸下来，都在竞技场附近，我们还是分头去击破吧。"
                },
                {
                    "id": "50130818",
                    "speaker": "希诺宁",
                    "text": "对了，还需要有人去守住大门。"
                },
                {
                    "id": "50130819",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "50130820",
                    "speaker": "玛拉妮",
                    "text": "好的，这就是最后的战斗了！"
                }
            ]
        },
