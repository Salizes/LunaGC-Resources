    "talks": [
        {
            "id": "7751101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "775110101",
                    "speaker": "赛况播报员",
                    "text": "来自提瓦特各地的杰出冒险家们，首届「冒险家竞技大赛」的所有赛程都已结束。"
                },
                {
                    "id": "775110102",
                    "speaker": "赛况播报员",
                    "text": "#结果已然揭晓，「传奇」一词具象化般的{NICKNAME}和{M#他}{F#她}的向导，不可阻挡地直取冠军！"
                },
                {
                    "id": "775110103",
                    "speaker": "萨林",
                    "text": "漂亮！"
                },
                {
                    "id": "775110104",
                    "speaker": "瓦乐瑞娜",
                    "text": "恭喜啊，两位！"
                },
                {
                    "id": "775110105",
                    "speaker": "苏赫拉布",
                    "text": "这位陌生的前辈…就是我以后努力的目标了…"
                },
                {
                    "id": "775110106",
                    "speaker": "岚姐",
                    "text": "换成别人，在最后时刻把我从榜首打下来，我可能还会有一点不服输。"
                },
                {
                    "id": "775110107",
                    "speaker": "岚姐",
                    "text": "但由你和派蒙的组合出手，那还说什么？应该为你们举杯庆祝！"
                },
                {
                    "id": "775110108",
                    "speaker": "梨香",
                    "text": "喝个痛快！"
                },
                {
                    "id": "775110109",
                    "speaker": "塔拉利欣",
                    "text": "除了摩拉，我们还为你准备了一些纪念物，请稍等片刻…",
                    "choices": [
                        {
                            "id": "775110110",
                            "text": "谢谢，谢谢。",
                            "response": [
                                {
                                    "id": "775110112",
                                    "speaker": "派蒙",
                                    "text": "虽然意外参加了这场比赛，观众也不怎么多，但考虑到比赛本身就是临时举办的，已经很尽兴了。"
                                },
                                {
                                    "id": "775110113",
                                    "speaker": "派蒙",
                                    "text": "而且，我们正好也练了练手，好好强化了一下刚刚学会没多久的新本领！"
                                },
                                {
                                    "id": "775110114",
                                    "speaker": "梨香",
                                    "text": "那庆功宴…"
                                },
                                {
                                    "id": "775110115",
                                    "speaker": "玉霞",
                                    "text": "喝酒的事之后再说，这场比赛最重要的目的还没解决。"
                                },
                                {
                                    "id": "775110116",
                                    "speaker": "梨香",
                                    "text": "噫！倒也是。"
                                },
                                {
                                    "id": "775110117",
                                    "speaker": "岚姐",
                                    "text": "现在，能完全服众的人在场了，之前暂停的会议，也该就此继续下去。"
                                },
                                {
                                    "id": "775110118",
                                    "speaker": "塔拉利欣",
                                    "text": "#按照规则，投票决定任何一条议题时，{NICKNAME}的权重将以其余人的总合计算。"
                                },
                                {
                                    "id": "775110119",
                                    "speaker": "派蒙",
                                    "text": "总合…就是加在一起的意思…也就是说…"
                                },
                                {
                                    "id": "775110120",
                                    "speaker": "岚姐",
                                    "text": "#{NICKNAME}有一票通过或否决权，还可以直接给出修改的建议。"
                                },
                                {
                                    "id": "775110121",
                                    "speaker": "派蒙",
                                    "text": "#现在我理解这个冠军份量了…搞不好，{NICKNAME}说的话，能影响成百上千的冒险家？",
                                    "choices": [
                                        {
                                            "id": "775110122",
                                            "text": "那我也要好好斟酌了。",
                                            "response": [
                                                {
                                                    "id": "775110124",
                                                    "speaker": "尤维尔",
                                                    "text": "总而言之，从逻辑上说，现在你们两位就是全场所有人的老大了。"
                                                },
                                                {
                                                    "id": "775110125",
                                                    "speaker": "莉琉",
                                                    "text": "好啊，老大！开会时间到，请听我们报告！"
                                                },
                                                {
                                                    "id": "775110126",
                                                    "speaker": "Black Screen",
                                                    "text": "在漫长的讨论中，对一些规则条文提出了决定性的建议…"
                                                },
                                                {
                                                    "id": "775110127",
                                                    "speaker": "Black Screen",
                                                    "text": "第一条待定的规则，便成了递进的问题——\\n「对于挂靠协会的全职冒险家，如果不去城外执行委托，是否应当设置早间到岗的打卡时间？」\\n「如果设置打卡时间，应当是八点还是九点？」\\n「最早下班时间该如何安排？午休留出多长的时间？」…\\n单单这一条规则，就在此前引发了两个小时的争论。\\n纳塔和须弥两方就坚决不同意这种做法，理由是：冒险家们的工作时间差异极大，有人习惯夜间行动，可能整个白天都在睡觉，昼夜颠倒后连剑都拿不稳。"
                                                },
                                                {
                                                    "id": "775110128",
                                                    "speaker": "Black Screen",
                                                    "text": "枫丹方和稻妻方则认为，标准化的管理有助于提升协会的效率，冒险家们也可以尝试健康作息…\\n而你和派蒙考虑到，自己也从来没按固定时间去协会柜台报到，便给出了「每天设个最晚打卡时间就好」的最终建议。\\n各个分会对此都没有任何异议，原本两个小时没解决的问题在十分钟内被你们搞定…"
                                                },
                                                {
                                                    "id": "775110161",
                                                    "speaker": "Black Screen",
                                                    "text": "再谈重点规则：「量化评估任务难度、引入难度分数机制、进而评定冒险家可接取任务的标准怎么确定？」\\n以及衍生的讨论：「标准严苛一点，压低所有冒险家的平均分好，还是宽松点为妙？」\\n初步设想下，引入难度分数机制后，原本都属于B级，绰号「菇测高度」和「临危受命」的两类委托，可能在具体的难度分数上相差95分之多。\\n坏处是：用难度分数而非委托等级来对冒险家设置门槛，可能导致三成至五成的普通冒险家无法接取同一等级后半段的委托，进而让许多冒险家的收入下降，打击冒险家们的整体积极性，影响协会整体的潜力…\\n好处则是：人员安全还是应该摆在第一位，具体而细致的分数摆在面前，高估自己能力的冒险家将明显减少，进而让他们不再贸然挑战强大魔物，潜在的冒险家受伤人数将大大减少，医疗费用的损耗也能大幅降低…"
                                                },
                                                {
                                                    "id": "775110162",
                                                    "speaker": "Black Screen",
                                                    "text": "\\n这个问题让你和派蒙头疼，感觉好像两边都有道理，难怪谁也说服不了谁。\\n最终，派蒙列举了「帝利耶悉」需掌握的一门初级学识：「面对风险不可预测的假说的基本实验原则」，并向你作出了详细的解释…\\n基于上述思想，你们决定，首先让各个分会派出各自的情报部主力，整理普通冒险家们的情报，对所有委托进行更精准的评估，减少分数粗放造成的评估失误…"
                                                },
                                                {
                                                    "id": "775110163",
                                                    "speaker": "Black Screen",
                                                    "text": "\\n随后在三个分会的冒险家中，进行基数足够庞大的随机抽样，对六组实力和等阶均匀分布的冒险家进行为期半年试点实验。分别采用原有的委托等阶体系和新的难度分数机制，对冒险家们执行委托的效率、人员受伤率、综合消耗与损失等情况进行追踪观测，最后进行细致的对比，再综合评判两种机制的优劣，以此决定采用哪种机制。如有必要，甚至可以让不同分会分别采用不同机制。\\n此事的工作量相当复杂，需要各个分会都拿出全力。在场各个分会都表示赞同，准备在会后立刻拿出对应方案。"
                                                },
                                                {
                                                    "id": "775110129",
                                                    "speaker": "Black Screen",
                                                    "text": "余下的十六个主要规则，也在你和派蒙的建议下进行了一定修改，以各方高度认可的状态敲定…"
                                                },
                                                {
                                                    "id": "775110130",
                                                    "speaker": "尤维尔",
                                                    "text": "那么，所有议题都得出结果了，没错吧？"
                                                },
                                                {
                                                    "id": "775110131",
                                                    "speaker": "莉琉",
                                                    "text": "我最担心的那几条规则，再也没有吵起来，这不是挺好的嘛。"
                                                },
                                                {
                                                    "id": "775110132",
                                                    "speaker": "萨林",
                                                    "text": "#{NICKNAME}和派蒙的提议实在一针见血…"
                                                },
                                                {
                                                    "id": "775110133",
                                                    "speaker": "塔拉利欣",
                                                    "text": "那么，如此之久，全面且高效的讨论，终于落下了帷幕， 各位达成了最终的共识，有劳了。"
                                                },
                                                {
                                                    "id": "775110134",
                                                    "speaker": "塔拉利欣",
                                                    "text": "接下来，总部的工作人员会将最终的文件整理好，交给各位二次确认。临走前，还请记得来我这边签字…"
                                                },
                                                {
                                                    "id": "775110135",
                                                    "speaker": "塔拉利欣",
                                                    "text": "关于后续事宜，总部会在时机恰当时，向各分会派出专员，检验工作进展，届时还请各分部积极配合。"
                                                },
                                                {
                                                    "id": "775110136",
                                                    "speaker": "梨香",
                                                    "text": "全都赞成。"
                                                },
                                                {
                                                    "id": "775110137",
                                                    "speaker": "岚姐",
                                                    "text": "我没意见。"
                                                },
                                                {
                                                    "id": "775110138",
                                                    "speaker": "Black Screen",
                                                    "text": "参会的冒险家各自和你们打了招呼，散会了。\\n之前还有人在隐隐较劲的紧张氛围，也彻底消散…"
                                                },
                                                {
                                                    "id": "775110139",
                                                    "speaker": "派蒙",
                                                    "text": "呼啊…我还以为，会有很多超麻烦的东西呢，其实感觉还好？"
                                                },
                                                {
                                                    "id": "775110140",
                                                    "speaker": "派蒙",
                                                    "text": "至少不是那种，唔，会让某个分会的冒险家掀桌子的严重问题？用书上教的理论，也基本能找到解决的办法。",
                                                    "choices": [
                                                        {
                                                            "id": "775110141",
                                                            "text": "这个程度对我也不算轻松了哦？",
                                                            "response": [
                                                                {
                                                                    "id": "775110143",
                                                                    "speaker": "派蒙",
                                                                    "text": "真的吗？这次我有帮到这么大的忙吗？"
                                                                },
                                                                {
                                                                    "id": "775110144",
                                                                    "speaker": "派蒙",
                                                                    "text": "太好了，感觉很充实，很开心！"
                                                                },
                                                                {
                                                                    "id": "775110145",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "对我们总部的成员来说，也实在是一件幸事。"
                                                                },
                                                                {
                                                                    "id": "775110146",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "今天要是你们不在，就很难收场了。"
                                                                },
                                                                {
                                                                    "id": "775110147",
                                                                    "speaker": "派蒙",
                                                                    "text": "那刚开始，为什么要做这么麻烦的一件事啦？"
                                                                },
                                                                {
                                                                    "id": "775110148",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "嗯…或许，越有意义的事，做起来越不轻松。"
                                                                },
                                                                {
                                                                    "id": "775110149",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "协会是一个横跨全提瓦特的巨大组织，今天这样复杂的交流和争论，初看之下，或许太耗费时间了。"
                                                                },
                                                                {
                                                                    "id": "775110150",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "但，不听各地的成员好好说明他们关心的事宜，粗暴地定下规则再予以执行…"
                                                                },
                                                                {
                                                                    "id": "775110151",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "这种方法管理下的组织，人心也会慢慢散掉，不能长久存续。"
                                                                },
                                                                {
                                                                    "id": "775110152",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "不早早彼此磨合，等问题出现再采取紧急措施，可能就晚了。"
                                                                },
                                                                {
                                                                    "id": "775110153",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "我们既需要及时改进各项细节，又需要在这个过程中拿出更多耐心。"
                                                                },
                                                                {
                                                                    "id": "775110154",
                                                                    "speaker": "派蒙",
                                                                    "text": "不愧是文员…讲的道理好高深…"
                                                                },
                                                                {
                                                                    "id": "775110155",
                                                                    "speaker": "派蒙",
                                                                    "text": "可不可以从结果出发，我们算是开了个好头？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "775110156",
                                                                            "text": "每条规则，都被全员赞同了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "775110158",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "当然，教科书级的满分开局。"
                                                                                },
                                                                                {
                                                                                    "id": "775110159",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "也不用我多唠叨，将来，你们再行走各地时，就会看到这次会议的成果了。"
                                                                                },
                                                                                {
                                                                                    "id": "775110160",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "未必有多辉煌，但肯定会给每个分会注入…你们那种风格独特的活力。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "775110157",
                                                                            "text": "大家离开时，神色都很轻松。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775110142",
                                                            "text": "没派蒙帮忙的话，我可不好说…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775110123",
                                            "text": "我们就认真思考问题吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775110111",
                            "text": "不用这么客气。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7751102",
            "objective": "前往会场",
            "dialogues": []
        }
    ]
}