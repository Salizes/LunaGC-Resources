    },
    "talks": [
        {
            "id": "4134101",
            "objective": "与蒙蒙对话",
            "dialogues": [
                {
                    "id": "413410101",
                    "speaker": "蒙蒙",
                    "text": "编霄灯好难啊…"
                },
                {
                    "id": "413410102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "413410103",
                    "speaker": "蒙蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你知道怎么编霄灯吗？蒙蒙不会编霄灯…"
                },
                {
                    "id": "413410104",
                    "speaker": "蒙蒙",
                    "text": "穿过去，弄过来，一不小心材料就掉了，要不然就把线弄断了…"
                },
                {
                    "id": "413410105",
                    "speaker": "蒙蒙",
                    "text": "蒙蒙本来是想编盏霄灯送给小羽的。"
                },
                {
                    "id": "413410106",
                    "speaker": "蒙蒙",
                    "text": "小羽一直在看茶店，没有时间玩，也没有时间做霄灯。"
                },
                {
                    "id": "413410107",
                    "speaker": "蒙蒙",
                    "text": "但是小羽应该有愿望想要许吧，所以蒙蒙就想编一盏霄灯送给他…",
                    "choices": [
                        {
                            "id": "413410108",
                            "text": "我来帮你编吧。",
                            "response": [
                                {
                                    "id": "413410110",
                                    "speaker": "蒙蒙",
                                    "text": "可是，蒙蒙想自己编好之后送给小羽…"
                                },
                                {
                                    "id": "413410111",
                                    "speaker": "蒙蒙",
                                    "text": "而且，蒙蒙想知道做霄灯的诀窍，这样我还可以讲给小羽听。"
                                },
                                {
                                    "id": "413410112",
                                    "speaker": "蒙蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能…你能教蒙蒙编一下霄灯吗？"
                                },
                                {
                                    "id": "413410113",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "413410114",
                                    "speaker": "蒙蒙",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                                },
                                {
                                    "id": "413410115",
                                    "speaker": "蒙蒙",
                                    "text": "霄灯这样应该就…算是做好了吧。"
                                },
                                {
                                    "id": "413410116",
                                    "speaker": "蒙蒙",
                                    "text": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！我们赶快把霄灯送给小羽吧！"
                                }
                            ]
                        },
                        {
                            "id": "413410109",
                            "text": "我编一个给你好了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134102",
            "objective": "陪蒙蒙去见小羽",
            "dialogues": [
                {
                    "id": "413410201",
                    "speaker": "小羽",
                    "text": "客、客官，你好，那个…想要歇脚的话请…"
                },
                {
                    "id": "413410203",
                    "speaker": "Player",
                    "text": "我们是来送霄灯的。"
                },
                {
                    "id": "413410204",
                    "speaker": "小羽",
                    "text": "送霄灯…？"
                },
                {
                    "id": "413410205",
                    "speaker": "蒙蒙",
                    "text": "小羽，这盏霄灯送给你。"
                },
                {
                    "id": "413410206",
                    "speaker": "小羽",
                    "text": "蒙蒙？咦，这盏霄灯是你做的吗？谢、谢谢你…"
                },
                {
                    "id": "413410207",
                    "speaker": "蒙蒙",
                    "text": "#是这个{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}教我编的，其实做得不太好，你…你喜欢吗？"
                },
                {
                    "id": "413410208",
                    "speaker": "小羽",
                    "text": "这盏霄灯做的很好啊！我很喜欢的，我还正在发愁，怎么抽出时间来编霄灯呢。"
                },
                {
                    "id": "413410209",
                    "speaker": "小羽",
                    "text": "谢谢你蒙蒙，我等会就去请人帮我把这盏霄灯挂到门上去。",
                    "choices": [
                        {
                            "id": "413410210",
                            "text": "为什么要请人帮忙挂霄灯？",
                            "response": [
                                {
                                    "id": "413410212",
                                    "speaker": "小羽",
                                    "text": "这个啊，嗯…我爸爸身体一直不好，不能过来挂霄灯。我个子又太矮，肯定也挂不上去…"
                                },
                                {
                                    "id": "413410213",
                                    "speaker": "小羽",
                                    "text": "想把霄灯挂到门上去，只能去周围请人帮忙了…",
                                    "choices": [
                                        {
                                            "id": "413410214",
                                            "text": "我来帮忙吧。",
                                            "response": [
                                                {
                                                    "id": "413410216",
                                                    "speaker": "小羽",
                                                    "text": "你愿意帮忙吗？那太好了，谢谢你。我还担心我要是去找人帮忙，谁来收拾店里呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "413410215",
                                            "text": "交给我吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "413410211",
                            "text": "家里没有人来挂霄灯吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134103",
            "objective": "挂霄灯",
            "dialogues": []
        },
        {
            "id": "4134104",
            "objective": "与小羽对话",
            "dialogues": [
                {
                    "id": "413410401",
                    "speaker": "小羽",
                    "text": "#这霄灯挂起来真好看，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                },
                {
                    "id": "413410402",
                    "speaker": "蒙蒙",
                    "text": "那小羽…我们出去玩吧，我知道一个地方，那里的花可漂亮了。"
                },
                {
                    "id": "413410403",
                    "speaker": "蒙蒙",
                    "text": "#刚才{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}教我编霄灯了，去那边之后，我也教你编好不好？"
                },
                {
                    "id": "413410404",
                    "speaker": "小羽",
                    "text": "这个…还不行，我还得收拾店里，虽然没多少客人，但店里必须保持干净才好，这是爸爸叮嘱我的。"
                },
                {
                    "id": "413410405",
                    "speaker": "蒙蒙",
                    "text": "那…那我们不编霄灯，去那边说一会话好不好？一会就回来了，不耽误时间的。"
                },
                {
                    "id": "413410406",
                    "speaker": "小羽",
                    "text": "可是…",
                    "choices": [
                        {
                            "id": "413410407",
                            "text": "我来帮忙打扫店里吧。",
                            "response": [
                                {
                                    "id": "413410409",
                                    "speaker": "小羽",
                                    "text": "欸？可以吗？这也、这也太麻烦你了…"
                                },
                                {
                                    "id": "413410410",
                                    "speaker": "蒙蒙",
                                    "text": "我们就去一小会，一小会就回来了，不会耽误很多时间的！"
                                },
                                {
                                    "id": "413410411",
                                    "speaker": "蒙蒙",
                                    "text": "#那就拜托你啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，谢谢你！"
                                }
                            ]
                        },
                        {
                            "id": "413410408",
                            "text": "打扫的事就交给我吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134105",
            "objective": "帮助小羽收拾店里",
            "dialogues": []
        },
        {
            "id": "4134106",
            "objective": "寻找小羽和蒙蒙",
            "dialogues": []
        },
        {
            "id": "4134107",
            "objective": "悄悄听一下小羽和蒙蒙的对话",
            "dialogues": [
                {
                    "id": "413410701",
                    "speaker": "派蒙",
                    "text": "好像是他们两个，还在玩的样子，看来不用太担心了。"
                },
                {
                    "id": "413410702",
                    "speaker": "派蒙",
                    "text": "不过现在这个气氛，好像不应该靠过去？",
                    "choices": [
                        {
                            "id": "413410703",
                            "text": "想听听他们在说什么…",
                            "response": [
                                {
                                    "id": "413410705",
                                    "speaker": "蒙蒙",
                                    "text": "给小羽的爸爸编花环，他会好得快一点吗？"
                                },
                                {
                                    "id": "413410706",
                                    "speaker": "小羽",
                                    "text": "我不知道…"
                                },
                                {
                                    "id": "413410707",
                                    "speaker": "蒙蒙",
                                    "text": "书上说，只要过得开心，就算生病也会好得很快。"
                                },
                                {
                                    "id": "413410708",
                                    "speaker": "蒙蒙",
                                    "text": "蒙蒙觉得，小羽已经这么懂事了，天天都在帮忙看店，小羽的爸爸，一定很开心。"
                                },
                                {
                                    "id": "413410709",
                                    "speaker": "小羽",
                                    "text": "但，爸爸有时候还说我来着…「别老是窝在店里，多出去玩」什么的。"
                                },
                                {
                                    "id": "413410710",
                                    "speaker": "小羽",
                                    "text": "「你不陪蒙蒙玩，她能把周围的花都采秃咯。」"
                                },
                                {
                                    "id": "413410711",
                                    "speaker": "蒙蒙",
                                    "text": "这里有很多花，才不会采完呢…等一下，我编一个花环给你。"
                                },
                                {
                                    "id": "413410712",
                                    "speaker": "小羽",
                                    "text": "谢谢你蒙蒙，我们也该回去了。"
                                },
                                {
                                    "id": "413410713",
                                    "speaker": "蒙蒙",
                                    "text": "好吧…那等你爸爸身体好了之后，你是不是就有时间了？到时候我再来找你玩…"
                                },
                                {
                                    "id": "413410714",
                                    "speaker": "小羽",
                                    "text": "嗯，爸爸的身体一定会好得很快的…"
                                },
                                {
                                    "id": "413410715",
                                    "speaker": "小羽",
                                    "text": "#欸？！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…你，你什么时候来的…",
                                    "choices": [
                                        {
                                            "id": "413410716",
                                            "text": "刚来不久。",
                                            "response": [
                                                {
                                                    "id": "413410718",
                                                    "speaker": "小羽",
                                                    "text": "唔唔唔…我…我…"
                                                },
                                                {
                                                    "id": "413410719",
                                                    "speaker": "Player",
                                                    "text": "海灯节快乐。"
                                                },
                                                {
                                                    "id": "413410720",
                                                    "speaker": "蒙蒙",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}也是，海灯节快乐！"
                                                },
                                                {
                                                    "id": "413410721",
                                                    "speaker": "小羽",
                                                    "text": "海…海灯节快乐…"
                                                },
                                                {
                                                    "id": "413410722",
                                                    "speaker": "小羽",
                                                    "text": "那个，谢谢你帮忙，这些东西请收下吧。爸爸说，拜托人做事要准备好报酬的。"
                                                },
                                                {
                                                    "id": "413410723",
                                                    "speaker": "小羽",
                                                    "text": "我们…我们就先回店里了，走吧蒙蒙。"
                                                },
                                                {
                                                    "id": "413410724",
                                                    "speaker": "蒙蒙",
                                                    "text": "#嗯，我们回去吧，谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "413410717",
                                            "text": "什么也没听到。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "413410704",
                            "text": "听听他们在说什么吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4134198",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413419801",
                    "speaker": "蒙蒙",
                    "text": "#谢谢你呀，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
                }
            ]
        },
        {
            "id": "4134199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "413419901",
                    "speaker": "小羽",
                    "text": "#那就麻烦你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}…"
                }
            ]
        }
    ]
}