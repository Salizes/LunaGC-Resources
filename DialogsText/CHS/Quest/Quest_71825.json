    "talks": [
        {
            "id": "7182501",
            "objective": "",
            "dialogues": [
                {
                    "id": "718150901",
                    "speaker": "灯谜",
                    "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
                },
                {
                    "id": "718150902",
                    "speaker": "灯谜",
                    "text": "「莫道此生沉黑海，身中自有大光明。」"
                },
                {
                    "id": "718150903",
                    "speaker": "派蒙",
                    "text": "这、这就是灯谜吗？好难…你有什么头绪吗？"
                },
                {
                    "id": "718150904",
                    "speaker": "灯谜",
                    "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
                },
                {
                    "id": "718150905",
                    "speaker": "灯谜",
                    "text": "「莫道此生沉黑海，身中自有大光明。」",
                    "choices": [
                        {
                            "id": "718150906",
                            "text": "水煮鱼。",
                            "response": [
                                {
                                    "id": "718150909",
                                    "speaker": "清昼",
                                    "text": "唔…猜得不对，还是再想想吧。"
                                }
                            ]
                        },
                        {
                            "id": "718150907",
                            "text": "霄灯。",
                            "response": [
                                {
                                    "id": "718150910",
                                    "speaker": "清昼",
                                    "text": "不错，正确的谜底就是这个。"
                                },
                                {
                                    "id": "718150911",
                                    "speaker": "清昼",
                                    "text": "霄灯正是竹骨石肌所做，放飞后浮空而行，这衡经说的也正是「玑衡经」，正是「不听菱歌听衡经」。"
                                },
                                {
                                    "id": "718150913",
                                    "speaker": "清昼",
                                    "text": "霄灯放飞后，虽然浮生石不坏，但灯罩本身会坏，坏掉的灯罩坠入海中后，就是「此生沉黑海」了。"
                                },
                                {
                                    "id": "718150914",
                                    "speaker": "清昼",
                                    "text": "但即便如此，寄托在霄灯上的愿望也不会消逝…这就是「身中自有大光明」。"
                                },
                                {
                                    "id": "718150915",
                                    "speaker": "小六",
                                    "text": "欸…是这么解的吗？完全想不到…"
                                },
                                {
                                    "id": "718150916",
                                    "speaker": "小六",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好厉害，那…这个礼物给你！"
                                },
                                {
                                    "id": "718150917",
                                    "speaker": "小六",
                                    "text": "我听人家说，猜对了灯谜都要给「彩头」的…这个给你，就当做是「彩头」吧。"
                                }
                            ]
                        },
                        {
                            "id": "718150908",
                            "text": "派蒙。"
                        }
                    ]
                }
            ]
        }
    ]
}