            "objective": "告知莉奥波汀林猪被赶跑的消息",
            "dialogues": [
                {
                    "id": "700610701",
                    "speaker": "莉奥波汀",
                    "text": "哦…你们回来了？怎么样？"
                },
                {
                    "id": "700610702",
                    "speaker": "Player",
                    "text": "已经赶跑啦！"
                },
                {
                    "id": "700610703",
                    "speaker": "莉奥波汀",
                    "text": "啊，真是太感谢你了，来，这是给你的酬劳。"
                },
                {
                    "id": "700610704",
                    "speaker": "莉奥波汀",
                    "text": "付出了劳动，就应该拿到报酬。"
                },
                {
                    "id": "700610705",
                    "speaker": "莉奥波汀",
                    "text": "这下也能重新修整花田了，希望这次不会再有什么不是人的家伙来捣乱…"
                }
            ]
        },
        {
            "id": "7006102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700610201",
                    "speaker": "莉奥波汀",
                    "text": "唉，这些被糟蹋的花，又得重新种…真是让人讨厌…"
                }
