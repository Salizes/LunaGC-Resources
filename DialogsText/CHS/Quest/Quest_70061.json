    "talks": [
        {
            "id": "7006111",
            "objective": "对话接取花田任务$HIDDEN",
            "dialogues": [
                {
                    "id": "700610101",
                    "speaker": "莉奥波汀",
                    "text": "唉，又是这样，怎么花田又变成这个样子…真是的…"
                },
                {
                    "id": "700610102",
                    "speaker": "莉奥波汀",
                    "text": "这样，花又不能按期交付，该怎么和收花的人说呢。"
                },
                {
                    "id": "700610103",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "700610104",
                    "speaker": "莉奥波汀",
                    "text": "花田被毁了…唉你看看，本来多好的花呀，被祸害成了这样。"
                },
                {
                    "id": "700610105",
                    "speaker": "莉奥波汀",
                    "text": "都是那个家伙干的！"
                },
                {
                    "id": "700610106",
                    "speaker": "Player",
                    "text": "过分，真不是人！"
                },
                {
                    "id": "700610107",
                    "speaker": "莉奥波汀",
                    "text": "是啊！真不是人…虽然这么说，但做出这种事的确实不是人，而是一只林猪。"
                },
                {
                    "id": "700610108",
                    "speaker": "莉奥波汀",
                    "text": "不知道为什么，最近总是跑下来啃花，还在花田里滚来滚去。"
                },
                {
                    "id": "700610109",
                    "speaker": "莉奥波汀",
                    "text": "又特别狡猾，每次弄出动静，一旦有人围过来，就会立刻逃跑，刚刚还差点把路过老人的腰撞坏…"
                },
                {
                    "id": "700610110",
                    "speaker": "莉奥波汀",
                    "text": "过分，真不是…真不是好林猪！"
                },
                {
                    "id": "700610111",
                    "speaker": "莉奥波汀",
                    "text": "唔，仔细一看…哦，你不是荣誉骑士吗，拯救蒙德的大英雄，就，就请帮帮我吧。"
                },
                {
                    "id": "700610112",
                    "speaker": "Player",
                    "text": "好，我来赶跑它！"
                },
                {
                    "id": "700610113",
                    "speaker": "莉奥波汀",
                    "text": "你愿意出手帮忙就太好了…我记得，它好像跑到山谷里去了。"
                },
                {
                    "id": "700610114",
                    "speaker": "莉奥波汀",
                    "text": "但这家伙特别狡猾，说不定得用花才能把它引诱出来…可惜花田现在变成这样…"
                },
                {
                    "id": "700610115",
                    "speaker": "莉奥波汀",
                    "text": "也许你能在路上采几朵风息花，把它骗出来，让它也知道被人捉弄的味道！"
                }
            ]
        },
        {
