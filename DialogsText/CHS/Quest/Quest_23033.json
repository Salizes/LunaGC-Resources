{
    "quest": {
        "id": "23033",
        "title": "《召唤王》",
        "description": "在须弥，你遇见了一个正在取材的小说家…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 178,
        "total_speaker_counts": {
            "Player": 36,
            "派蒙": 2,
            "福本": 140
        }
    },
    "talks": [
        {
            "id": "2303301",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230330101",
                    "speaker": "福本",
                    "text": "旅行者！又见面了，上次多亏你帮忙，朝雾小姐的插画创作得很顺利。",
                    "choices": [
                        {
                            "id": "230330102",
                            "text": "能帮上忙就好。",
                            "response": [
                                {
                                    "id": "230330104",
                                    "speaker": "福本",
                                    "text": "是啊，教令院的那帮学者还在讨论一些制作细节呢。"
                                },
                                {
                                    "id": "230330105",
                                    "speaker": "福本",
                                    "text": "有的学者说，既然是新版，那玩法就要有创意，游戏的资源系统也要有创意。"
                                },
                                {
                                    "id": "230330106",
                                    "speaker": "福本",
                                    "text": "有的学者说，卡牌游戏一定要有精美的卡面，所以他要求把预算拨去雇更多的画家。"
                                },
                                {
                                    "id": "230330107",
                                    "speaker": "福本",
                                    "text": "还有一位就更离谱了…他希望在所有参与制作「七圣召唤」的学者之间举办一场对战比赛。"
                                },
                                {
                                    "id": "230330108",
                                    "speaker": "福本",
                                    "text": "谁能赢得冠军，谁的意见就更有份量。我看这个人就是单纯地想要玩「七圣召唤」而已。"
                                },
                                {
                                    "id": "230330109",
                                    "speaker": "福本",
                                    "text": "他们的讨论我几乎都听不懂，所以就借口取材跑了出来。"
                                },
                                {
                                    "id": "230330110",
                                    "speaker": "福本",
                                    "text": "旅行者，你能再给我当一回模特吗？"
                                },
                                {
                                    "id": "230330111",
                                    "speaker": "福本",
                                    "text": "这次我没什么特别的要求，只需要你为我展示一下你的战斗技巧就好。",
                                    "choices": [
                                        {
                                            "id": "230330112",
                                            "text": "你写的不是卡牌游戏小说吗？",
                                            "response": [
                                                {
                                                    "id": "230330114",
                                                    "speaker": "福本",
                                                    "text": "你这就有所不知了，单纯地打牌已经没有市场了。"
                                                },
                                                {
                                                    "id": "230330115",
                                                    "speaker": "福本",
                                                    "text": "说实话，打牌变打架我都觉得有点俗气了，我都已经想让角色骑着马一边竞速一边打牌了。"
                                                },
                                                {
                                                    "id": "230330116",
                                                    "speaker": "福本",
                                                    "text": "不过我还没想好他们骑马打牌的原因…所以我决定还是先写一段打牌变打架的戏。"
                                                },
                                                {
                                                    "id": "230330117",
                                                    "speaker": "福本",
                                                    "text": "取景地我已经选好了，我们赶紧出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230330113",
                                            "text": "打牌和战斗有什么关系？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230330103",
                            "text": "你今天还是来取材吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303302",
            "objective": "前往取景地",
            "dialogues": []
        },
        {
            "id": "2303303",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230330301",
                    "speaker": "福本",
                    "text": "就是这里了！你看前面，有几个零星的史莱姆。"
                },
                {
                    "id": "230330302",
                    "speaker": "福本",
                    "text": "旅行者，请你用你认为最帅气的方式，一口气打倒它们吧！"
                },
                {
                    "id": "230330303",
                    "speaker": "Player",
                    "text": "这真的能用在卡牌游戏小说里吗？"
                },
                {
                    "id": "230330304",
                    "speaker": "福本",
                    "text": "哎呀，放心吧，虽然我写的小说里大部分事情都能靠打牌解决。"
                },
                {
                    "id": "230330305",
                    "speaker": "福本",
                    "text": "但总有一些不能靠打牌解决的事，需要角色们运用一些「现实性」手段。"
                },
                {
                    "id": "230330306",
                    "speaker": "福本",
                    "text": "那就拜托你了，旅行者。我会在这边看着的。"
                }
            ]
        },
        {
            "id": "2303304",
            "objective": "打倒所有魔物",
            "dialogues": []
        },
        {
            "id": "2303305",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230330501",
                    "speaker": "福本",
                    "text": "太好了，非常好！这些画片肯定够朝雾再画好几张了。",
                    "choices": [
                        {
                            "id": "230330502",
                            "text": "想玩「七圣召唤」。",
                            "response": [
                                {
                                    "id": "230330504",
                                    "speaker": "福本",
                                    "text": "哈哈哈…我会把你的愿望转达给学者们的。"
                                },
                                {
                                    "id": "230330505",
                                    "speaker": "福本",
                                    "text": "不过，这群学者们的研究似乎进行得很顺利，现在他们讨论的时候都能打打趣了。"
                                },
                                {
                                    "id": "230330506",
                                    "speaker": "福本",
                                    "text": "不像最开始，咳…剑拔弩张的…"
                                }
                            ]
                        },
                        {
                            "id": "230330503",
                            "text": "期待「七圣召唤」。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303306",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230330601",
                    "speaker": "福本",
                    "text": "坏了，这下真的被这帮须弥人给骗惨了…"
                },
                {
                    "id": "230330602",
                    "speaker": "Player",
                    "text": "你被骗钱了？"
                },
                {
                    "id": "230330603",
                    "speaker": "福本",
                    "text": "哎哟！你…你吓我一跳！"
                },
                {
                    "id": "230330604",
                    "speaker": "福本",
                    "text": "唉，我倒是没有被骗钱，就是被教令院里的那群人给骗来了须弥…"
                },
                {
                    "id": "230330605",
                    "speaker": "福本",
                    "text": "还没自我介绍…我叫福本，是一个稻妻的小说家。"
                },
                {
                    "id": "230330606",
                    "speaker": "Player",
                    "text": "你说你被骗了？"
                },
                {
                    "id": "230330607",
                    "speaker": "福本",
                    "text": "这事情说来话长…你听说教令院研发出的卡牌游戏「七圣召唤」吗？",
                    "choices": [
                        {
                            "id": "230330608",
                            "text": "七…七圣召唤？",
                            "response": [
                                {
                                    "id": "230330610",
                                    "speaker": "福本",
                                    "text": "你没听说过？不应该啊，你没看过我写的那本《召唤王》吗？在「八重堂」里可是卖得很好的。"
                                },
                                {
                                    "id": "230330611",
                                    "speaker": "福本",
                                    "text": "呃…《召唤王》也没看过？没，没问题，不用管这些！"
                                },
                                {
                                    "id": "230330612",
                                    "speaker": "福本",
                                    "text": "总之，就是须弥教令院里的人研发了一种名为「七圣召唤」的卡牌游戏。"
                                },
                                {
                                    "id": "230330613",
                                    "speaker": "福本",
                                    "text": "为了推广，他们就通过「八重堂」来拜托我，以「七圣召唤」这种卡牌游戏的规则为蓝本，写一本轻小说。"
                                },
                                {
                                    "id": "230330614",
                                    "speaker": "福本",
                                    "text": "因为那群学者自己都没把「七圣召唤」的规则梳理清楚，加上须弥和稻妻离得太远，我们难以沟通，所以写起来非常艰难…"
                                },
                                {
                                    "id": "230330615",
                                    "speaker": "福本",
                                    "text": "不过在「八重堂」内诸位老师的帮助下，我还是完成了《召唤王》，不仅销量不错，而且还和计划中一样带动了「七圣召唤」的销量。"
                                },
                                {
                                    "id": "230330616",
                                    "speaker": "福本",
                                    "text": "然后，重点来了…那群学者说，他们要重新梳理一遍「七圣召唤」的规则，再对外推出一版全新的「七圣召唤」。"
                                },
                                {
                                    "id": "230330617",
                                    "speaker": "福本",
                                    "text": "他们也再次拜托我以新版的「七圣召唤」为蓝本续写《召唤王》，并且邀请我来须弥教令院面对面沟通。"
                                },
                                {
                                    "id": "230330618",
                                    "speaker": "福本",
                                    "text": "我从稻妻长途跋涉来了须弥，但学者们说…新版「七圣召唤」的规则他们还没有确定下来，请我先在须弥暂住一段时间。"
                                },
                                {
                                    "id": "230330619",
                                    "speaker": "福本",
                                    "text": "他们说为了致歉，还会帮我介绍几个教令院里的名人作为我取材的对象，比如那位赛诺先生，还有提纳里先生…"
                                },
                                {
                                    "id": "230330620",
                                    "speaker": "福本",
                                    "text": "我本来有点生气，但是那群学者…每个人都是一副严重睡眠不足的样子，接待我的那位学者简直站都站不稳了…"
                                },
                                {
                                    "id": "230330621",
                                    "speaker": "福本",
                                    "text": "唉，我想了想，本来我的大纲就还没有确定，再等一段时间也没什么大问题，就答应了他们暂时住在须弥，等他们把新规则确定下来。"
                                },
                                {
                                    "id": "230330622",
                                    "speaker": "福本",
                                    "text": "这不，我今天就是出来取材的。"
                                },
                                {
                                    "id": "230330623",
                                    "speaker": "福本",
                                    "text": "旅行者，你愿意帮我一个忙吗？",
                                    "choices": [
                                        {
                                            "id": "230330624",
                                            "text": "你先说是什么…",
                                            "response": [
                                                {
                                                    "id": "230330626",
                                                    "speaker": "福本",
                                                    "text": "是这样，为了让《召唤王》这本小说更有吸引力，我特意去拜托朝雾小姐来绘制插画。"
                                                },
                                                {
                                                    "id": "230330627",
                                                    "speaker": "福本",
                                                    "text": "我已经想好了几个关键的情节，但除了文字描述外，我还要给朝雾小姐一点具体的姿势参考…"
                                                },
                                                {
                                                    "id": "230330628",
                                                    "speaker": "福本",
                                                    "text": "但我可没什么战斗的经验，摆出来的几个姿势都软塌塌的，看起来一点精神都没有。"
                                                },
                                                {
                                                    "id": "230330629",
                                                    "speaker": "福本",
                                                    "text": "旅行者，我看你肯定有丰富的战斗经验，能拜托你来做模特吗？你瞧，我还借了架「留影机」来…",
                                                    "choices": [
                                                        {
                                                            "id": "230330630",
                                                            "text": "好吧…",
                                                            "response": [
                                                                {
                                                                    "id": "230330633",
                                                                    "speaker": "福本",
                                                                    "text": "谢谢你愿意帮忙，旅行者。我已经找到了一个不错的取景地，我们去那边吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230330631",
                                                            "text": "拍得好看点喔。",
                                                            "response": [
                                                                {
                                                                    "id": "230330632",
                                                                    "speaker": "福本",
                                                                    "text": "没问题，你就放心吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230330625",
                                            "text": "我不太会打牌…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230330609",
                            "text": "卡牌游戏？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303307",
            "objective": "前往取景地",
            "dialogues": []
        },
        {
            "id": "2303308",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230330801",
                    "speaker": "福本",
                    "text": "就是这里了，让我看看…首先，我需要一个…"
                },
                {
                    "id": "230330802",
                    "speaker": "福本",
                    "text": "角色陷入困境中的姿势…"
                },
                {
                    "id": "230330803",
                    "speaker": "派蒙",
                    "text": "这描述也太模糊了，完全不知道要摆出什么样的姿势啊！"
                },
                {
                    "id": "230330804",
                    "speaker": "福本",
                    "text": "这个…就按照你的第一反应来摆姿势就好。"
                },
                {
                    "id": "230330805",
                    "speaker": "福本",
                    "text": "旅行者，当你遇见困境的时候，你会做出什么样的反应？",
                    "choices": [
                        {
                            "id": "230330806",
                            "text": "那当然是战斗了。",
                            "response": [
                                {
                                    "id": "230330807",
                                    "speaker": "福本",
                                    "text": "嚯，很有气势的回答，面对困境的第一反应是战斗…那就请你摆出一个有力的战斗姿态来吧！"
                                },
                                {
                                    "id": "230330808",
                                    "speaker": "福本",
                                    "text": "就是那种…你已经陷入困境，必须要开始挣扎了的感觉。"
                                },
                                {
                                    "id": "230330809",
                                    "speaker": "福本",
                                    "text": "这场战斗就是你为了活下去而做出的挣扎！为了活下去而不得不做出的选择！"
                                },
                                {
                                    "id": "230330810",
                                    "speaker": "福本",
                                    "text": "咳！这都是我为角色设计的台词…但总之，差不多就是这样的一种感觉。"
                                },
                                {
                                    "id": "230330811",
                                    "speaker": "派蒙",
                                    "text": "唔唔…真有角色会说出这种话来吗…"
                                }
                            ]
                        },
                        {
                            "id": "230330812",
                            "text": "我不会让自己陷入困境。",
                            "response": [
                                {
                                    "id": "230330813",
                                    "speaker": "福本",
                                    "text": "喔！你这个回答很有傲气啊，很不错，正好能和我小说里的一个人对上！"
                                },
                                {
                                    "id": "230330814",
                                    "speaker": "福本",
                                    "text": "那就拜托你摆出一个，很有傲气的姿势吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303309",
            "objective": "前往取景地，摆好姿势",
            "dialogues": []
        },
        {
            "id": "2303310",
            "objective": "与福本对话",
            "dialogues": [
                {
                    "id": "230331001",
                    "speaker": "福本",
                    "text": "真不错！真不错，这些画片肯定足够朝雾小姐参考了。这样子也算是暂时解决插画问题了…"
                },
                {
                    "id": "230331002",
                    "speaker": "福本",
                    "text": "谢谢你，旅行者，这些报酬就请你收下吧。"
                },
                {
                    "id": "230331003",
                    "speaker": "福本",
                    "text": "我得再回教令院一趟，看看怎么把这些画片寄回去给朝雾小姐。"
                },
                {
                    "id": "230331004",
                    "speaker": "福本",
                    "text": "听说朝雾小姐最近被很多人约稿，哈哈哈，我也得快点去抢她的排期了。"
                },
                {
                    "id": "230331005",
                    "speaker": "福本",
                    "text": "唔，这张不错，这张也很好…"
                }
            ]
        },
        {
            "id": "2303380",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338001",
                    "speaker": "福本",
                    "text": "唉，这群学者的身体，真的没问题吗…"
                },
                {
                    "id": "230338002",
                    "speaker": "Player",
                    "text": "学者怎么了？"
                },
                {
                    "id": "230338003",
                    "speaker": "福本",
                    "text": "咳，别提了。还不是「七圣召唤」的事，那群学者成天不眠不休的研究，我真担心「七圣召唤」的规则没出来，他们自己的身体先垮了。"
                },
                {
                    "id": "230338004",
                    "speaker": "福本",
                    "text": "不过，他们似乎已经设计出了游戏规则的大框架，我总算是有能参考的东西了。"
                },
                {
                    "id": "230338005",
                    "speaker": "福本",
                    "text": "我是不懂他们的工作…只能让学者们自己努力了。"
                },
                {
                    "id": "230338006",
                    "speaker": "福本",
                    "text": "至于我嘛…还是得接着解决小说的插画问题。"
                },
                {
                    "id": "230338007",
                    "speaker": "福本",
                    "text": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。"
                },
                {
                    "id": "230338008",
                    "speaker": "福本",
                    "text": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
                    "choices": [
                        {
                            "id": "230338009",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "230338010",
                                    "speaker": "福本",
                                    "text": "多谢啦，我会准备好报酬的。"
                                },
                                {
                                    "id": "230338017",
                                    "speaker": "福本",
                                    "text": "我已经找到了一个不错的取景地，就在附近。"
                                },
                                {
                                    "id": "230338018",
                                    "speaker": "福本",
                                    "text": "等我收拾一下留影机，咱们就出发。"
                                }
                            ]
                        },
                        {
                            "id": "230338011",
                            "text": "他们没给你介绍一些「名人」吗？",
                            "response": [
                                {
                                    "id": "230338012",
                                    "speaker": "福本",
                                    "text": "那个啊…他们说已经在联系了，不过赛诺先生和提纳里先生似乎工作很忙，暂时没什么空过来做模特。"
                                },
                                {
                                    "id": "230338013",
                                    "speaker": "福本",
                                    "text": "不过我听说，赛诺先生可是玩「七圣召唤」的好手。"
                                },
                                {
                                    "id": "230338014",
                                    "speaker": "福本",
                                    "text": "要是能让他拿着卡牌，在牌桌前摆出一个帅气的姿势的话…"
                                },
                                {
                                    "id": "230338015",
                                    "speaker": "福本",
                                    "text": "算了，我们还是现实点吧。"
                                },
                                {
                                    "id": "230338016",
                                    "speaker": "福本",
                                    "text": "那做模特的事就拜托你了，旅行者。我会准备好报酬的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303381",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338101",
                    "speaker": "福本",
                    "text": "唉，这群学者的身体，真的没问题吗…"
                },
                {
                    "id": "230338102",
                    "speaker": "Player",
                    "text": "学者怎么了？"
                },
                {
                    "id": "230338103",
                    "speaker": "福本",
                    "text": "咳，别提了。还不是「七圣召唤」的事，那群学者成天不眠不休的研究，我真担心「七圣召唤」的规则没出来，他们自己的身体先垮了。"
                },
                {
                    "id": "230338104",
                    "speaker": "福本",
                    "text": "不过，他们似乎已经设计出了游戏规则的大框架，我总算是有能参考的东西了。"
                },
                {
                    "id": "230338105",
                    "speaker": "福本",
                    "text": "我是不懂他们的工作…只能让学者们自己努力了。"
                },
                {
                    "id": "230338106",
                    "speaker": "福本",
                    "text": "至于我嘛…还是得接着解决小说的插画问题。"
                },
                {
                    "id": "230338107",
                    "speaker": "福本",
                    "text": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。"
                },
                {
                    "id": "230338108",
                    "speaker": "福本",
                    "text": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
                    "choices": [
                        {
                            "id": "230338109",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "230338113",
                                    "speaker": "福本",
                                    "text": "那做模特的事就拜托你了，旅行者。我会准备好报酬的。"
                                },
                                {
                                    "id": "230338114",
                                    "speaker": "福本",
                                    "text": "我已经找到了一个不错的取景地，就在附近。"
                                },
                                {
                                    "id": "230338115",
                                    "speaker": "福本",
                                    "text": "等我收拾一下留影机，咱们就出发。"
                                }
                            ]
                        },
                        {
                            "id": "230338110",
                            "text": "你还要取多少材？",
                            "response": [
                                {
                                    "id": "230338111",
                                    "speaker": "福本",
                                    "text": "哎呀，好不容易来一趟须弥，我当然得多取一点材。"
                                },
                                {
                                    "id": "230338112",
                                    "speaker": "福本",
                                    "text": "顺便…还能躲一下我的编辑…咳！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303382",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338201",
                    "speaker": "福本",
                    "text": "真不错！真不错，这些画片肯定足够朝雾小姐参考了。这样子也算是暂时解决插画问题了…"
                },
                {
                    "id": "230338202",
                    "speaker": "福本",
                    "text": "谢谢你，旅行者，这些报酬就请你收下吧。"
                },
                {
                    "id": "230338203",
                    "speaker": "福本",
                    "text": "我得再回教令院一趟，看看怎么把这些画片寄回去给朝雾小姐。"
                },
                {
                    "id": "230338204",
                    "speaker": "福本",
                    "text": "听说朝雾小姐最近被很多人约稿，哈哈哈，我也得快点去抢她的排期了。"
                },
                {
                    "id": "230338205",
                    "speaker": "福本",
                    "text": "唔，这张不错，这张也很好…"
                }
            ]
        },
        {
            "id": "2303383",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338301",
                    "speaker": "福本",
                    "text": "坏了，这下真的被这帮须弥人给骗惨了…"
                },
                {
                    "id": "230338302",
                    "speaker": "Player",
                    "text": "你被骗钱了？"
                },
                {
                    "id": "230338303",
                    "speaker": "福本",
                    "text": "哎哟！你…你吓我一跳！"
                },
                {
                    "id": "230338304",
                    "speaker": "福本",
                    "text": "唉，我倒是没有被骗钱，就是被教令院里的那群人给骗来了须弥…"
                },
                {
                    "id": "230338305",
                    "speaker": "福本",
                    "text": "还没自我介绍…我叫福本，是一个稻妻的小说家。"
                },
                {
                    "id": "230338306",
                    "speaker": "Player",
                    "text": "你说你被骗了？"
                },
                {
                    "id": "230338307",
                    "speaker": "福本",
                    "text": "这事情说来话长…你听说过教令院研发出的卡牌游戏「七圣召唤」吧。"
                },
                {
                    "id": "230338308",
                    "speaker": "福本",
                    "text": "我写的那本《召唤王》，你应该也看过…呃，至少听说过吧？"
                },
                {
                    "id": "230338309",
                    "speaker": "福本",
                    "text": "咳…先不管这些了。总之，就是须弥教令院里的人研发了一种名为「七圣召唤」的卡牌游戏。"
                },
                {
                    "id": "230338310",
                    "speaker": "福本",
                    "text": "为了推广，他们就通过「八重堂」来拜托我，以「七圣召唤」这种卡牌游戏的规则为蓝本，写一本轻小说。"
                },
                {
                    "id": "230338311",
                    "speaker": "福本",
                    "text": "因为那群学者自己都没把「七圣召唤」的规则梳理清楚，加上须弥和稻妻离得太远，我们难以沟通，所以写起来非常艰难…"
                },
                {
                    "id": "230338312",
                    "speaker": "福本",
                    "text": "不过在「八重堂」内诸位老师的帮助下，我还是完成了《召唤王》，不仅销量不错，而且还和计划中一样带动了「七圣召唤」的销量。"
                },
                {
                    "id": "230338313",
                    "speaker": "福本",
                    "text": "然后，重点来了…那群学者说，他们要重新梳理一遍「七圣召唤」的规则，再对外推出一版全新的「七圣召唤」。"
                },
                {
                    "id": "230338314",
                    "speaker": "福本",
                    "text": "他们也再次拜托我以新版的「七圣召唤」为蓝本续写《召唤王》，并且邀请我来须弥教令院面对面沟通。"
                },
                {
                    "id": "230338315",
                    "speaker": "福本",
                    "text": "虽然在辛苦了很久之后，那群学者总算把「七圣召唤」的规则给确定下来了…"
                },
                {
                    "id": "230338316",
                    "speaker": "福本",
                    "text": "但我的小说还没有完成，为了取材，我还得在须弥暂住一段时间。"
                },
                {
                    "id": "230338317",
                    "speaker": "福本",
                    "text": "旅行者，你愿意帮我一个忙吗？",
                    "choices": [
                        {
                            "id": "230338318",
                            "text": "你先说是什么…",
                            "response": [
                                {
                                    "id": "230338320",
                                    "speaker": "福本",
                                    "text": "是这样，为了让《召唤王》这本小说更有吸引力，我特意去拜托朝雾小姐来绘制插画。"
                                },
                                {
                                    "id": "230338321",
                                    "speaker": "福本",
                                    "text": "我已经想好了几个关键的情节，但除了文字描述外，我还要给朝雾小姐一点具体的姿势参考…"
                                },
                                {
                                    "id": "230338322",
                                    "speaker": "福本",
                                    "text": "但我可没什么战斗的经验，摆出来的几个姿势都软塌塌的，看起来一点精神都没有。"
                                },
                                {
                                    "id": "230338323",
                                    "speaker": "福本",
                                    "text": "旅行者，我看你肯定有丰富的战斗经验，能拜托你来做模特吗？你瞧，我还借了架「留影机」来…",
                                    "choices": [
                                        {
                                            "id": "230338324",
                                            "text": "好吧…",
                                            "response": [
                                                {
                                                    "id": "230338326",
                                                    "speaker": "福本",
                                                    "text": "没问题，你就放心吧！"
                                                },
                                                {
                                                    "id": "230338327",
                                                    "speaker": "福本",
                                                    "text": "谢谢你愿意帮忙，旅行者。我已经找到了一个不错的取景地，我们去那边吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230338325",
                                            "text": "拍得好看点喔。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230338319",
                            "text": "我不太会打牌…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303384",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338401",
                    "speaker": "福本",
                    "text": "唉，这群学者的身体，还真是有精神啊…"
                },
                {
                    "id": "230338402",
                    "speaker": "Player",
                    "text": "学者怎么了？"
                },
                {
                    "id": "230338403",
                    "speaker": "福本",
                    "text": "咳，别提了，还不是「七圣召唤」的事。那群学者之前不是不眠不休，把「七圣召唤」的规则给确定下来了吗？"
                },
                {
                    "id": "230338404",
                    "speaker": "福本",
                    "text": "我还以为他们这下可以休息了…但没想到，他们又开始研究了起来，说是要继续规划后续的设计方案…"
                },
                {
                    "id": "230338405",
                    "speaker": "福本",
                    "text": "我是不懂他们的工作…只能让学者们自己努力了。"
                },
                {
                    "id": "230338406",
                    "speaker": "福本",
                    "text": "至于我嘛…还是得接着解决小说的插画问题。"
                },
                {
                    "id": "230338407",
                    "speaker": "福本",
                    "text": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。"
                },
                {
                    "id": "230338408",
                    "speaker": "福本",
                    "text": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
                    "choices": [
                        {
                            "id": "230338409",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "230338410",
                                    "speaker": "福本",
                                    "text": "多谢啦，我会准备好报酬的。"
                                },
                                {
                                    "id": "230338414",
                                    "speaker": "福本",
                                    "text": "我已经找到了一个不错的取景地，就在附近。"
                                },
                                {
                                    "id": "230338415",
                                    "speaker": "福本",
                                    "text": "等我收拾一下留影机，咱们就出发。"
                                }
                            ]
                        },
                        {
                            "id": "230338411",
                            "text": "你什么时候回稻妻？",
                            "response": [
                                {
                                    "id": "230338412",
                                    "speaker": "福本",
                                    "text": "唔…等我取到足够的素材之后吧。"
                                },
                                {
                                    "id": "230338413",
                                    "speaker": "福本",
                                    "text": "这么好的小说题材，我还想要多写几部呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303385",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338501",
                    "speaker": "福本",
                    "text": "旅行者！又见面了，上次多亏你帮忙，朝雾小姐的插画创作得很顺利。",
                    "choices": [
                        {
                            "id": "230338502",
                            "text": "能帮上忙就好。",
                            "response": [
                                {
                                    "id": "230338504",
                                    "speaker": "福本",
                                    "text": "是啊，对我这个小说家来说，素材当然是越多越好啦。"
                                },
                                {
                                    "id": "230338505",
                                    "speaker": "福本",
                                    "text": "而且须弥这地方还是很有趣的，有许多新鲜的事物等着我去见识啊。"
                                },
                                {
                                    "id": "230338506",
                                    "speaker": "福本",
                                    "text": "要不是朝雾小姐的身体不太好，我都想邀请她也来须弥实地取材了。"
                                },
                                {
                                    "id": "230338507",
                                    "speaker": "福本",
                                    "text": "咳，说正事。旅行者，你能再给我当一回模特吗？"
                                },
                                {
                                    "id": "230338508",
                                    "speaker": "福本",
                                    "text": "这次我没什么特别的要求，只需要你为我展示一下你的战斗技巧就好。",
                                    "choices": [
                                        {
                                            "id": "230338509",
                                            "text": "你写的不是卡牌游戏小说吗？",
                                            "response": [
                                                {
                                                    "id": "230338511",
                                                    "speaker": "福本",
                                                    "text": "你这就有所不知了，单纯地打牌已经没有市场了。"
                                                },
                                                {
                                                    "id": "230338512",
                                                    "speaker": "福本",
                                                    "text": "说实话，打牌变打架我都觉得有点俗气了，我都已经想让角色骑着马一边竞速一边打牌了。"
                                                },
                                                {
                                                    "id": "230338513",
                                                    "speaker": "福本",
                                                    "text": "不过我还没想好他们骑马打牌的原因…所以我决定还是先写一段打牌变打架的戏。"
                                                },
                                                {
                                                    "id": "230338514",
                                                    "speaker": "福本",
                                                    "text": "取景地我已经选好了，我们赶紧出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230338510",
                                            "text": "打牌和战斗有什么关系？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230338503",
                            "text": "你今天还是来取材吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303386",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230338601",
                    "speaker": "福本",
                    "text": "太好了，非常好！这些画片肯定够朝雾再画好几张了。"
                },
                {
                    "id": "230338602",
                    "speaker": "福本",
                    "text": "多谢你了，旅行者，这些报酬请你收下吧。"
                },
                {
                    "id": "230338603",
                    "speaker": "福本",
                    "text": "等我的工作告一段落，我们俩可以好好地「对决」几场，哈哈哈！"
                }
            ]
        }
    ]
}