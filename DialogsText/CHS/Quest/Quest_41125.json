        {
            "id": "4112518",
            "objective": "向杰克回报",
            "dialogues": [
                {
                    "id": "411251001",
                    "speaker": "杰克",
                    "text": "我知道了，谢谢你帮我调查，这些请你收下吧。"
                },
                {
                    "id": "411251002",
                    "speaker": "杰克",
                    "text": "不肯避难的学者…异常的魔物，还有协会人手不足的现状…"
                },
                {
                    "id": "411251003",
                    "speaker": "杰克",
                    "text": "唔…好好想想，好好想想…一定有说服塞琉斯先生的方法…"
