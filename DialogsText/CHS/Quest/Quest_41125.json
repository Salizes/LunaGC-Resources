    "talks": [
        {
            "id": "4112501",
            "objective": "与杰克对话",
            "dialogues": [
                {
                    "id": "411250101",
                    "speaker": "杰克",
                    "text": "唉…要是我也能去看看就好了…"
                },
                {
                    "id": "411250102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "411250103",
                    "speaker": "杰克",
                    "text": "是你啊。倒也没发生什么特别的事…"
                },
                {
                    "id": "411250104",
                    "speaker": "杰克",
                    "text": "呃，其实也算挺特别的吧…",
                    "choices": [
                        {
                            "id": "411250105",
                            "text": "是陨石的事？",
                            "response": [
                                {
                                    "id": "411250106",
                                    "speaker": "杰克",
                                    "text": "对，你也看见了吧，最近一段时间，不断有陨石从天而降。"
                                },
                                {
                                    "id": "411250107",
                                    "speaker": "杰克",
                                    "text": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。"
                                },
                                {
                                    "id": "411250113",
                                    "speaker": "杰克",
                                    "text": "但还有不少的陨石坠落在了野外，而且据说…只要摸到了陨石的人，都会陷入沉睡，怎么样都叫不醒的那种。"
                                },
                                {
                                    "id": "411250114",
                                    "speaker": "杰克",
                                    "text": "塞琉斯先生已经发布委托召集了一些冒险家，一部分去通知那些还留在野外的人进城避难…"
                                },
                                {
                                    "id": "411250115",
                                    "speaker": "杰克",
                                    "text": "另外一部分，则是帮助西风骑士团去确认各处陨石的落点。"
                                },
                                {
                                    "id": "411250116",
                                    "speaker": "杰克",
                                    "text": "然后以落点为中心，向四周搜索援救。"
                                },
                                {
                                    "id": "411250117",
                                    "speaker": "杰克",
                                    "text": "至于我嘛…塞琉斯先生说，我最好还是留在城里，帮助照顾那些陷入昏睡的人比较好。"
                                },
                                {
                                    "id": "411250118",
                                    "speaker": "杰克",
                                    "text": "也许是因为我实力没达标吧…但总是负责这些小事，我也一点变强的机会都没有嘛…"
                                },
                                {
                                    "id": "411250119",
                                    "speaker": "杰克",
                                    "text": "唉，但不管怎么说，我也得先把分内的事处理好才行…不过旅行者，能请你帮我个忙吗？"
                                },
                                {
                                    "id": "411250120",
                                    "speaker": "杰克",
                                    "text": "我想请你帮我去野外看看，搜集一下和那些陨石相关的信息…",
                                    "choices": [
                                        {
                                            "id": "411250121",
                                            "text": "搜集这些做什么？",
                                            "response": [
                                                {
                                                    "id": "411250122",
                                                    "speaker": "杰克",
                                                    "text": "塞琉斯先生总是说，在开始冒险前，一定要做好万全的准备…"
                                                },
                                                {
                                                    "id": "411250123",
                                                    "speaker": "杰克",
                                                    "text": "如果我能说服塞琉斯先生，我已经对现在的情况十分了解，也做好了充足的准备…"
                                                },
                                                {
                                                    "id": "411250124",
                                                    "speaker": "杰克",
                                                    "text": "那么，说不定他就能让我也去野外加入调查了。"
                                                },
                                                {
                                                    "id": "411250125",
                                                    "speaker": "杰克",
                                                    "text": "但我现在还得去帮忙照顾那些人，没机会出去搜集信息。"
                                                },
                                                {
                                                    "id": "411250133",
                                                    "speaker": "杰克",
                                                    "text": "所以，只能拜托你了，旅行者！请你帮我去野外调查一下吧，就…去低语森林附近就好。"
                                                },
                                                {
                                                    "id": "411250134",
                                                    "speaker": "杰克",
                                                    "text": "有收获的话，就快回来告诉我吧。我能不能去野外加入调查…就全靠你了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "411250126",
                                            "text": "你想偷偷地…",
                                            "response": [
                                                {
                                                    "id": "411250127",
                                                    "speaker": "杰克",
                                                    "text": "啊？我偷偷地…没有！没有，绝对没有！"
                                                },
                                                {
                                                    "id": "411250128",
                                                    "speaker": "杰克",
                                                    "text": "虽然我确实很想去野外调查…但城里也需要有人帮忙，城里的事也很重要！我可不能擅离职守…"
                                                },
                                                {
                                                    "id": "411250129",
                                                    "speaker": "杰克",
                                                    "text": "哎呀，就是…塞琉斯先生总说，在开始冒险前，一定要做好万全的准备…"
                                                },
                                                {
                                                    "id": "411250130",
                                                    "speaker": "杰克",
                                                    "text": "如果我能说服塞琉斯先生，我已经对现在的情况十分了解，也做好了充足的准备…"
                                                },
                                                {
                                                    "id": "411250131",
                                                    "speaker": "杰克",
                                                    "text": "那么，说不定他就能让我也去野外加入调查了。"
                                                },
                                                {
                                                    "id": "411250132",
                                                    "speaker": "杰克",
                                                    "text": "但我现在还得去帮忙照顾那些人，没机会出去搜集信息。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "411250108",
                            "text": "是「猎鹿人」店庆活动菜品半价？",
                            "response": [
                                {
                                    "id": "411250109",
                                    "speaker": "杰克",
                                    "text": "什么？！我怎么不知道！「猎鹿人」今天还有活动吗？"
                                },
                                {
                                    "id": "411250110",
                                    "speaker": "杰克",
                                    "text": "哎！不对不对…我要说的不是这个…"
                                },
                                {
                                    "id": "411250111",
                                    "speaker": "杰克",
                                    "text": "你也看见了吧，最近一段时间，不断有陨石从天而降。"
                                },
                                {
                                    "id": "411250112",
                                    "speaker": "杰克",
                                    "text": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112520",
            "objective": "（test)用于保证独占$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4112502",
            "objective": "（test）仅用于随机$HIDDEN",
            "dialogues": [
                {
                    "id": "411250201",
                    "speaker": "冒失的帕拉德",
                    "text": "可算甩掉了，这到底是怎么回事…"
                },
                {
                    "id": "411250202",
                    "speaker": "Player",
                    "text": "你是来调查陨石的？"
                },
                {
                    "id": "411250203",
                    "speaker": "冒失的帕拉德",
                    "text": "是的，我从协会里接受了委托，来野外调查和陨石相关的事情。"
                },
                {
                    "id": "411250204",
                    "speaker": "冒失的帕拉德",
                    "text": "但陨石落点附近的魔物不知道为什么，突然变得和平时不一样了。"
                },
                {
                    "id": "411250205",
                    "speaker": "冒失的帕拉德",
                    "text": "无论是攻击的力度、行动的状态，还是其他的方面都格外异常，而且数量也格外多。"
                },
                {
                    "id": "411250206",
                    "speaker": "冒失的帕拉德",
                    "text": "我不小心被它们发现，不敢在那边多逗留，就抄了几条小路，把它们全给甩开了。"
                },
                {
                    "id": "411250207",
                    "speaker": "冒失的帕拉德",
                    "text": "这种魔物的异常情况，我得赶紧回去城里向塞琉斯先生报告才行。"
                },
                {
                    "id": "411250208",
                    "speaker": "Player",
                    "text": "还有其他什么情况吗？"
                },
                {
                    "id": "411250209",
                    "speaker": "冒失的帕拉德",
                    "text": "其他的情况？这个嘛…非要说的话，那就是还有很多学者不肯进城避难吧。"
                },
                {
                    "id": "411250210",
                    "speaker": "冒失的帕拉德",
                    "text": "不管我怎么劝他们，他们都坚持要继续待在野外研究。"
                },
                {
                    "id": "411250211",
                    "speaker": "冒失的帕拉德",
                    "text": "现在能到野外调查的冒险家又不多，也不可能隔几天就去提醒他们一次…"
                },
                {
                    "id": "411250212",
                    "speaker": "冒失的帕拉德",
                    "text": "这拨人真是够让人头疼的…"
                },
                {
                    "id": "411250213",
                    "speaker": "冒失的帕拉德",
                    "text": "好了旅行者，如果没有什么重要的事，你也赶紧回城里避难吧，现在可不是在野外逗留的时候。"
                }
            ]
        },
        {
            "id": "4112503",
            "objective": "（test）仅用于随机$HIDDEN",
            "dialogues": [
                {
                    "id": "411250301",
                    "speaker": "杰克",
                    "text": "你回来了，有什么收获吗？"
                }
            ]
        },
        {
            "id": "4112504",
            "objective": "（test）仅用于随机$HIDDEN",
            "dialogues": [
                {
                    "id": "411250401",
                    "speaker": "派蒙",
                    "text": "这附近的魔物好像活跃了许多，和平常的样子也有些不一样…"
                }
            ]
        },
        {
            "id": "4112505",
            "objective": "（test）仅用于随机$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4112506",
            "objective": "前往低语森林调查",
            "dialogues": [
                {
                    "id": "411250601",
                    "speaker": "杰克",
                    "text": "唉，也不知道…我能不能说服塞琉斯先生…"
                },
                {
                    "id": "411250602",
                    "speaker": "Player",
                    "text": "你为什么想加入野外的调查？"
                },
                {
                    "id": "411250603",
                    "speaker": "杰克",
                    "text": "这个啊，哎呀…参与重要的工作，才能展现自己的价值嘛，我是这么想的…"
                },
                {
                    "id": "411250604",
                    "speaker": "Player",
                    "text": "但要是事办砸了…"
                },
                {
                    "id": "411250605",
                    "speaker": "杰克",
                    "text": "喂！我还什么都没做呢，别说这么不吉利的话啊！"
                }
            ]
        },
        {
            "id": "4112509",
            "objective": "",
            "dialogues": [
                {
                    "id": "411250901",
                    "speaker": "Player",
                    "text": "野外的魔物有些异常。"
                },
                {
                    "id": "411250902",
                    "speaker": "杰克",
                    "text": "异常？难道是被陨石影响了，不过这种事情，应该早就有人报告过了吧。"
                },
                {
                    "id": "411250903",
                    "speaker": "杰克",
                    "text": "而且以我的实力，连那些普通的魔物都有些对付不了，这些异常的魔物…就更别提了。"
                }
            ]
        },
        {
