    "talks": [
        {
            "id": "2001809",
            "objective": "前去查看详情",
            "dialogues": [
                {
                    "id": "200180901",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "200180902",
                    "speaker": "害怕的玛伽",
                    "text": "那就麻烦你了，我，我接着看看车的状况。"
                }
            ]
        },
        {
            "id": "2001801",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "200180101",
                    "speaker": "害怕的玛伽",
                    "text": "谢谢你，旅行者，呜…我就知道，我肯定会把工作给搞砸…"
                },
                {
                    "id": "200180102",
                    "speaker": "害怕的玛伽",
                    "text": "就是运一车酒而已我都能搞砸，我到底能做成什么事情呀。"
                },
                {
                    "id": "200180103",
                    "speaker": "害怕的玛伽",
                    "text": "这么下去肯定会被酒庄开除，康纳先生说不定早就觉得我工作能力不行，埃泽先生也许把我的辞退信都拟好了，完了，全都完了…"
                },
                {
                    "id": "200180104",
                    "speaker": "Player",
                    "text": "你…你冷静点…"
                },
                {
                    "id": "200180105",
                    "speaker": "害怕的玛伽",
                    "text": "唉，我肯定完蛋了，但是这车酒还是要运到才行。"
                },
                {
                    "id": "200180106",
                    "speaker": "害怕的玛伽",
                    "text": "车也被打坏了…旅行者，能麻烦你帮我找点材料来吗？只要一块<color=#00E1FFFF>结实的木板</color>就行了。"
                }
            ]
        },
        {
            "id": "2001802",
            "objective": "和玛伽对话",
            "dialogues": [
                {
                    "id": "200180701",
                    "speaker": "Player",
                    "text": "好的，别担心…"
                },
                {
                    "id": "200180702",
                    "speaker": "害怕的玛伽",
                    "text": "那就拜托你了，我…我想想怎么才能把车修好。"
                }
            ]
        },
        {
            "id": "2001803",
            "objective": "收集木材",
            "dialogues": [
                {
                    "id": "200180301",
                    "speaker": "害怕的玛伽",
                    "text": "这些就足够了，我应该，应该很快就能把车修好…"
                },
                {
                    "id": "200180302",
                    "speaker": "害怕的玛伽",
                    "text": "那群家伙怎么又来了！旅行者，帮帮我！"
                }
            ]
        },
        {
            "id": "2001804",
            "objective": "将结实的木板交给玛伽",
            "dialogues": []
        },
        {
            "id": "2001805",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "200180501",
                    "speaker": "害怕的玛伽",
                    "text": "帮我去旁边树林里找找看吧，如果<color=#00E1FFFF>绳子</color>在那就好了。"
                }
            ]
        },
        {
            "id": "2001806",
            "objective": "和玛伽对话",
            "dialogues": []
        },
        {
            "id": "2001807",
            "objective": "收集绳索",
            "dialogues": []
        },
        {
            "id": "2001808",
            "objective": "将绳索交给玛伽",
            "dialogues": [
                {
                    "id": "200180601",
                    "speaker": "害怕的玛伽",
                    "text": "谢谢你，旅行者，就先这样吧。"
                },
                {
                    "id": "200180602",
                    "speaker": "害怕的玛伽",
                    "text": "勉强能到清泉镇，把货卸了之后，我再回去向酒庄报告情况。"
                },
                {
                    "id": "200180603",
                    "speaker": "害怕的玛伽",
                    "text": "就是不知道埃泽先生看见车被破坏成这样，我会不会被当场开除啊…"
                }
            ]
        },
        {
            "id": "2001802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200180201",
                    "speaker": "害怕的玛伽",
                    "text": "树林里应该就能找到<color=#00E1FFFF>结实的木板</color>了，找到后就给我吧。"
                }
            ]
        },
        {
            "id": "2001804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200180401",
                    "speaker": "害怕的玛伽",
                    "text": "呼…谢谢，旅行者，还好有你在。"
                },
                {
                    "id": "200180402",
                    "speaker": "害怕的玛伽",
                    "text": "不过这么一折腾，这车我已经不知道怎么修了…"
                },
                {
                    "id": "200180403",
                    "speaker": "害怕的玛伽",
                    "text": "这里是坏的，那里也是坏的…这就算是勉强修好了，走着走着也会散架。"
                },
                {
                    "id": "200180404",
                    "speaker": "害怕的玛伽",
                    "text": "算了，总之先把车弄到镇里去，再慢慢想办法吧。"
                },
                {
                    "id": "200180405",
                    "speaker": "害怕的玛伽",
                    "text": "我记得车上有绳子来着…准是被那群家伙拿走了。"
                },
                {
                    "id": "200180406",
                    "speaker": "害怕的玛伽",
                    "text": "旅行者，帮我去旁边树林里找找看吧，如果<color=#00E1FFFF>绳子</color>在那就好了。"
                }
            ]
        },
        {
            "id": "2001808",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200180801",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "200180802",
                    "speaker": "害怕的玛伽",
                    "text": "别，不要，要是我自己来，肯定又会搞砸的，只能拜托你了…"
                }
            ]
        },
        {
            "id": "2001810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200181001",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "200181002",
                    "speaker": "害怕的玛伽",
                    "text": "呜…这里只有你能帮我，拜托了——"
                }
            ]
        }
    ]
}