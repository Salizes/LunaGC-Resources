    "talks": [
        {
            "id": "1104001",
            "objective": "前往蒙德城的炼金铺",
            "dialogues": []
        },
        {
            "id": "1104002",
            "objective": "与铺中的少女交谈",
            "dialogues": [
                {
                    "id": "110400201",
                    "speaker": "派蒙",
                    "text": "咦，蒂玛乌斯先生今天好像不在…"
                },
                {
                    "id": "110400202",
                    "speaker": "？？？",
                    "text": "（是、是客人？！）"
                },
                {
                    "id": "110400203",
                    "speaker": "？？？",
                    "text": "那个！嗯…请问，你们找他有什么事吗？"
                },
                {
                    "id": "110400204",
                    "speaker": "派蒙",
                    "text": "没什么没什么，只是平时他总是站在这里，有点奇怪而已。"
                },
                {
                    "id": "110400205",
                    "speaker": "？？？",
                    "text": "哦，这样啊。他刚刚被阿贝多先生叫走了，我是被叫来照看炼金铺的。"
                },
                {
                    "id": "110400206",
                    "speaker": "砂糖",
                    "text": "我叫砂糖，是阿贝多先生的助手。炼金术方面如果有问题，也可以问我，我…会尽量帮上忙的。",
                    "choices": [
                        {
                            "id": "110400207",
                            "text": "自信一点。",
                            "response": [
                                {
                                    "id": "110400208",
                                    "speaker": "砂糖",
                                    "text": "我…其实我很不擅长做这种事。"
                                },
                                {
                                    "id": "110400211",
                                    "speaker": "砂糖",
                                    "text": "不、不好意思，平时我都在实验室里，不怎么出门，也不太经常和别人说话。"
                                },
                                {
                                    "id": "110400212",
                                    "speaker": "砂糖",
                                    "text": "需要我帮忙的话，就叫我的名字，如果不需要，我…我就在那边看书，嗯。"
                                },
                                {
                                    "id": "110400213",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，谢谢你的好意，不过不用担心啦，炼金台的使用已经很熟悉了，对吧，{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "110400214",
                                            "text": "嗯，不会打扰到你。",
                                            "response": [
                                                {
                                                    "id": "110400216",
                                                    "speaker": "砂糖",
                                                    "text": "#欸？{NICKNAME}…难道你就是传说中的那位，击退了风魔龙的旅行者？",
                                                    "choices": [
                                                        {
                                                            "id": "110400217",
                                                            "text": "「传说中的」太夸张了。",
                                                            "response": [
                                                                {
                                                                    "id": "110400220",
                                                                    "speaker": "砂糖",
                                                                    "text": "我听说了很多关于你的故事，一直心想能有机会近距离研究你！"
                                                                },
                                                                {
                                                                    "id": "110400221",
                                                                    "speaker": "派蒙",
                                                                    "text": "研、研究？"
                                                                },
                                                                {
                                                                    "id": "110400222",
                                                                    "speaker": "砂糖",
                                                                    "text": "啊，对不起，不用在意，一不小心就…"
                                                                },
                                                                {
                                                                    "id": "110400223",
                                                                    "speaker": "砂糖",
                                                                    "text": "不过，既然是你的话，一定能帮上阿贝多先生的忙吧。"
                                                                },
                                                                {
                                                                    "id": "110400224",
                                                                    "speaker": "派蒙",
                                                                    "text": "说起来刚刚就一直听到「阿贝多先生」，他也是蒙德城的炼金术士吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110400225",
                                                                            "text": "确实是没听过的名字。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110400227",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "抱歉，一直没能介绍，阿贝多先生是西风骑士团首席炼金术士，也是我和蒂玛乌斯先生的老师。"
                                                                                },
                                                                                {
                                                                                    "id": "110400228",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "平时看到的都是蒂玛乌斯先生在教别人炼金术。这么说，那他就是老师的老师？"
                                                                                },
                                                                                {
                                                                                    "id": "110400229",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "是的，他致力于探究世界的真相，已经有了很多很多伟大的成果。"
                                                                                },
                                                                                {
                                                                                    "id": "110400230",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "经常会有炼金术士不远万里来到蒙德，请求他的帮助。在他们看来艰深复杂的问题，只需要阿贝多先生稍加指点，就能完美解决。"
                                                                                },
                                                                                {
                                                                                    "id": "110400231",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "哇，居然是这么厉害的人！"
                                                                                },
                                                                                {
                                                                                    "id": "110400232",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "嗯。可是，最近他的研究好像遇到了瓶颈，我见到他的时候，他总是一副愁眉不展的样子。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110400233",
                                                                                            "text": "我能帮得上这么厉害的人吗？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110400235",
                                                                                                    "speaker": "砂糖",
                                                                                                    "text": "你在冒险中一系列非凡经历，一定会让阿贝多先生特别感兴趣，这应该能为他提供很多很多灵感。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110400236",
                                                                                                    "speaker": "砂糖",
                                                                                                    "text": "阿贝多先生是一位很有风度的人，如果你帮助了他，他肯定会给你相应的回报的。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "110400237",
                                                                                                            "text": "能让我变得更强吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110400238",
                                                                                                                    "speaker": "砂糖",
                                                                                                                    "text": "我想应该没问题，探究生命的极限本来也是阿贝多先生的研究内容之一。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110400241",
                                                                                                                    "speaker": "砂糖",
                                                                                                                    "text": "阿贝多先生现在应该和蒂玛乌斯先生一起在雪山做研究，我很想带你们去，可是炼金铺不能没人照看。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110400242",
                                                                                                                    "speaker": "砂糖",
                                                                                                                    "text": "就麻烦你们去雪山的入口找找看吧，是一位温文尔雅的年轻先生，很有学者气质，然后，嗯…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110400243",
                                                                                                                    "speaker": "砂糖",
                                                                                                                    "text": "…抱歉，我也不知道要怎么说得更清楚，还要麻烦你们努力辨认了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110400244",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "嗯，好，放心吧。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "110400239",
                                                                                                            "text": "能让派蒙变得更强吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110400240",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "我没有这个需求啦。想回报我的话，嘿嘿，用摩拉结算怎么样？"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110400234",
                                                                                            "text": "我对炼金的了解只有炼金台。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110400226",
                                                                            "text": "好像听说过。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110400218",
                                                            "text": "可以免费为你签名。",
                                                            "response": [
                                                                {
                                                                    "id": "110400219",
                                                                    "speaker": "砂糖",
                                                                    "text": "啊，谢谢！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110400215",
                                            "text": "好…好像有点忘记了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110400209",
                            "text": "别紧张。",
                            "response": [
                                {
                                    "id": "110400210",
                                    "speaker": "砂糖",
                                    "text": "欸？我…我看上去很紧张吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104003",
            "objective": "前往龙脊雪山的入口",
            "dialogues": [
                {
                    "id": "110400301",
                    "speaker": "砂糖",
                    "text": "不好意思，关于阿贝多先生，我只能给出这种程度的描述。"
                },
                {
                    "id": "110400302",
                    "speaker": "砂糖",
                    "text": "要是能给你们画一幅他的肖像画就好了，但是我的画技也远远不如他…"
                }
            ]
        },
        {
            "id": "1104004",
            "objective": "接近交谈中的两人",
            "dialogues": [
                {
                    "id": "110400401",
                    "speaker": "芭芭拉",
                    "text": "原、原来你在这里，罗莎莉亚小姐，唱诗班的活动马上就…"
                },
                {
                    "id": "110400402",
                    "speaker": "罗莎莉亚",
                    "text": "都说了我不参加这种活动，我还有更重要的事要做。"
                },
                {
                    "id": "110400403",
                    "speaker": "芭芭拉",
                    "text": "可是，这次是有纪念性的活动，希望所有的修女都要出席。"
                },
                {
                    "id": "110400404",
                    "speaker": "罗莎莉亚",
                    "text": "希望归希望，我的工作内容里又没有「满足别人希望」这一条。"
                },
                {
                    "id": "110400405",
                    "speaker": "芭芭拉",
                    "text": "这、这个，话不能这么说…"
                },
                {
                    "id": "110400406",
                    "speaker": "罗莎莉亚",
                    "text": "倒是你，你是这次活动的组织者吧，你不觉得很奇怪吗？"
                },
                {
                    "id": "110400407",
                    "speaker": "芭芭拉",
                    "text": "哪、哪里奇怪了？"
                },
                {
                    "id": "110400408",
                    "speaker": "罗莎莉亚",
                    "text": "按现在的时间算，就算你立刻赶回蒙德城，估计也赶不上活动开始的时间了。"
                },
                {
                    "id": "110400409",
                    "speaker": "罗莎莉亚",
                    "text": "难道不是有人算好了这个，想让你出丑吗？"
                },
                {
                    "id": "110400410",
                    "speaker": "芭芭拉",
                    "text": "欸欸？怎、怎么可能！大家不是这样的人！"
                },
                {
                    "id": "110400411",
                    "speaker": "罗莎莉亚",
                    "text": "是不是这样的人，讲的是证据，而不是你的感觉。唉，还是说你太容易相信别人了呢？"
                },
                {
                    "id": "110400412",
                    "speaker": "罗莎莉亚",
                    "text": "放心吧，即便你就这么回去了，也不会有人责怪你。因为估计也没有几个人觉得我真的会去参加。"
                },
                {
                    "id": "110400413",
                    "speaker": "罗莎莉亚",
                    "text": "但再磨蹭下去，你就真的迟到了。"
                },
                {
                    "id": "110400414",
                    "speaker": "芭芭拉",
                    "text": "对啊！重要的纪念活动，如果迟到了就…那、那我回去了！"
                },
                {
                    "id": "110400415",
                    "speaker": "派蒙",
                    "text": "听上去…这位修女好像完全是在靠诡辩骗人呢。"
                },
                {
                    "id": "110400416",
                    "speaker": "罗莎莉亚",
                    "text": "从刚才起，就注意到你们了——你们是什么人，又为什么要偷听？"
                },
                {
                    "id": "110400417",
                    "speaker": "派蒙",
                    "text": "小心点！我觉得她是个危险人物…呃，至少，有点狡猾。"
                },
                {
                    "id": "110400418",
                    "speaker": "罗莎莉亚",
                    "text": "哦？相比起历史悠久的西风教会的成员，你这种来历不明的小漂浮物才更危险吧。"
                },
                {
                    "id": "110400419",
                    "speaker": "派蒙",
                    "text": "被听到了？！我还以为我说得够小声了…"
                },
                {
                    "id": "110400420",
                    "speaker": "罗莎莉亚",
                    "text": "嗯，带着小漂浮物的外乡人…原来如此，你就是…呵呵。"
                },
                {
                    "id": "110400421",
                    "speaker": "罗莎莉亚",
                    "text": "击退了风魔龙的「荣誉骑士」，凭这层身份，就先不急着追究你的偷听了。"
                },
                {
                    "id": "110400422",
                    "speaker": "罗莎莉亚",
                    "text": "否则…视你们的回答而定，最坏的情况可能会是牢狱之灾呢。"
                },
                {
                    "id": "110400423",
                    "speaker": "派蒙",
                    "text": "欸！蒙德城的修女还能负责抓捕可疑人士的吗？！"
                },
                {
                    "id": "110400424",
                    "speaker": "罗莎莉亚",
                    "text": "至少不能对明显存在的隐患视而不见吧，修女就不可以拥有正义感吗？"
                },
                {
                    "id": "110400425",
                    "speaker": "派蒙",
                    "text": "呃，听上去怪怪的，但好像没办法反驳…"
                },
                {
                    "id": "110400426",
                    "speaker": "罗莎莉亚",
                    "text": "还是说说你们吧，你们是为什么要到雪山来呢？",
                    "choices": [
                        {
                            "id": "110400427",
                            "text": "来找阿贝多先生。",
                            "response": [
                                {
                                    "id": "110400431",
                                    "speaker": "罗莎莉亚",
                                    "text": "找他的话，我之前特意留意了一下他的足迹。"
                                },
                                {
                                    "id": "110400432",
                                    "speaker": "罗莎莉亚",
                                    "text": "雪停之后，往来雪山的人很多，希望一路上的痕迹还没有被盖掉。"
                                },
                                {
                                    "id": "110400433",
                                    "speaker": "派蒙",
                                    "text": "难不成，你也是来找他的？"
                                },
                                {
                                    "id": "110400434",
                                    "speaker": "罗莎莉亚",
                                    "text": "不是的，这应该算职业习惯吧，因为我察觉到这些足迹上残留了元素力，警惕一点总没错。",
                                    "choices": [
                                        {
                                            "id": "110400435",
                                            "text": "以修女而言，你好像太神秘了…",
                                            "response": [
                                                {
                                                    "id": "110400437",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "无所谓你怎么想，走吧，我也顺路去看看他在干什么。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110400436",
                                            "text": "像侦探一样。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110400428",
                            "text": "来探究世界的真相。",
                            "response": [
                                {
                                    "id": "110400429",
                                    "speaker": "罗莎莉亚",
                                    "text": "但你只是个旅行者，并非什么伟大的炼金术士吧。"
                                },
                                {
                                    "id": "110400430",
                                    "speaker": "罗莎莉亚",
                                    "text": "无所谓，我大概知道你是想来找谁了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110400311",
                    "speaker": "派蒙",
                    "text": "聊到炼金和研究的话题，砂糖就完全不怯场了，这就是研究者的气质吗？"
                },
                {
                    "id": "110400312",
                    "speaker": "派蒙",
                    "text": "总之，去雪山找那位「阿贝多先生」吧。"
                },
                {
                    "id": "110400313",
                    "speaker": "派蒙",
                    "text": "既然罗莎莉亚说足迹上有元素力，用元素视野应该能很清楚地看到吧。"
                }
            ]
        },
        {
            "id": "1104005",
