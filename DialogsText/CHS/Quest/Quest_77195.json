    "talks": [
        {
            "id": "7719501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771950101",
                    "speaker": "派蒙",
                    "text": "这…这是什么？"
                },
                {
                    "id": "771950102",
                    "speaker": "「灰眸」",
                    "text": "这是被设置为「靶场」的影域拥有的功能…曾经，（…）和（…）都曾利用此处的功能进行训练…"
                },
                {
                    "id": "771950103",
                    "speaker": "「灰眸」",
                    "text": "进行进一步的对于影域深处的环境的模拟，为更为深度的影域遗迹发掘工作…"
                },
                {
                    "id": "771950104",
                    "speaker": "「灰眸」",
                    "text": "……"
                },
                {
                    "id": "771950105",
                    "speaker": "派蒙",
                    "text": "怎么了？"
                },
                {
                    "id": "771950106",
                    "speaker": "「灰眸」",
                    "text": "奇怪，这部分记忆似乎遭到抹除。"
                },
                {
                    "id": "771950107",
                    "speaker": "「灰眸」",
                    "text": "总之，通过该装置，就能够进行影域的模拟，或压力更大的深度影域的模拟…"
                },
                {
                    "id": "771950108",
                    "speaker": "「灰眸」",
                    "text": "完成训练，似乎还会解锁相应的权限…以获取更为强大的枪械的蓝图。"
                },
                {
                    "id": "771950109",
                    "speaker": "派蒙",
                    "text": "哦哦，我明白了，在这里进行训练，然后就能取得资格证，就能用更厉害的武器。"
                },
                {
                    "id": "771950110",
                    "speaker": "「灰眸」",
                    "text": "是的，您理解得很快，请跟随的我的指引…"
                },
                {
                    "id": "771950111",
                    "speaker": "「灰眸」",
                    "text": "这里的…「荣耀展柜」里的枪械与配件蓝图即是为通过影域训练和深度影域清剿的人准备的。"
                },
                {
                    "id": "771950112",
                    "speaker": "派蒙",
                    "text": "原来是这样！"
                },
                {
                    "id": "771950113",
                    "speaker": "「灰眸」",
                    "text": "那么，功能的说明就是这样，推荐在有时间时做好准备，进行尝试…"
                },
                {
                    "id": "771950114",
                    "speaker": "「灰眸」",
                    "text": "「荣耀展柜」的权限已解锁…随之开启的是新的枪械配件，还请进行领取。"
                }
            ]
        },
