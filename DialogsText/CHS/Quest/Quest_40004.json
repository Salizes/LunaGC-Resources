    "talks": [
        {
            "id": "4000400",
            "objective": "(test)派蒙开车台词（隐藏）$UNRELEASED$HIDDEN",
            "dialogues": [
                {
                    "id": "400040001",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，准备好动身了吗？我们该去蒙德找凯亚了。"
                }
            ]
        },
        {
            "id": "4000401",
            "objective": "在蒙德寻找凯亚$UNRELEASED",
            "dialogues": []
        },
        {
            "id": "4000402",
            "objective": "与凯亚对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "400040201",
                    "speaker": "凯亚",
                    "text": "#{NICKNAME}，嚯，好久不见。"
                },
                {
                    "id": "400040202",
                    "speaker": "派蒙",
                    "text": "凯亚，我们去璃月海灯节了！"
                },
                {
                    "id": "400040203",
                    "speaker": "凯亚",
                    "text": "怎么样，海灯节有趣吗？"
                },
                {
                    "id": "400040204",
                    "speaker": "派蒙",
                    "text": "好吃！"
                },
                {
                    "id": "400040205",
                    "speaker": "凯亚",
                    "text": "那你好好期待蒙德的羽球节吧。应该也不会让你失望的。"
                },
                {
                    "id": "400040206",
                    "speaker": "Player",
                    "text": "说正事吧，派蒙。"
                },
                {
                    "id": "400040207",
                    "speaker": "派蒙",
                    "text": "啊，对了。凯亚，事情是这样的。"
                },
                {
                    "id": "400040208",
                    "speaker": "凯亚",
                    "text": "嗯…建灯用的木、纸、油这些材料…无论怎么想，都很容易滑向危险的方向…"
                },
                {
                    "id": "400040209",
                    "speaker": "凯亚",
                    "text": "哼哼，很有意思，你们为什么觉得我会认识这个符号呢？",
                    "choices": [
                        {
                            "id": "400040210",
                            "text": "因为凯亚神通广大，值得信任。",
                            "response": [
                                {
                                    "id": "400040211",
                                    "speaker": "派蒙",
                                    "text": "是的！"
                                },
                                {
                                    "id": "400040212",
                                    "speaker": "凯亚",
                                    "text": "呵呵呵，不敢当，我哪有那种本事。"
                                },
                                {
                                    "id": "400040213",
                                    "speaker": "派蒙",
                                    "text": "出现了！骑士「谦虚」的品德。"
                                },
                                {
                                    "id": "400040214",
                                    "speaker": "凯亚",
                                    "text": "哼哼，在璃月呆了一阵子，变得牙尖嘴利了啊。"
                                },
                                {
                                    "id": "400040220",
                                    "speaker": "凯亚",
                                    "text": "回到正题吧。这是跨国犯罪组织「盗宝团」的符号。"
                                },
                                {
                                    "id": "400040221",
                                    "speaker": "凯亚",
                                    "text": "你如果有兴趣的话，我可以安排你和线人见一面哦。"
                                },
                                {
                                    "id": "400040222",
                                    "speaker": "派蒙",
                                    "text": "西风骑士团不是不和敌人做交易吗？"
                                },
                                {
                                    "id": "400040223",
                                    "speaker": "凯亚",
                                    "text": "——那是我凯亚的线人，不是西风骑士团的啊。"
                                },
                                {
                                    "id": "400040224",
                                    "speaker": "凯亚",
                                    "text": "晚些时候，去风起地吧。我会安排线人去赴会的。"
                                },
                                {
                                    "id": "400040225",
                                    "speaker": "派蒙",
                                    "text": "谢谢你，凯亚。"
                                },
                                {
                                    "id": "400040226",
                                    "speaker": "凯亚",
                                    "text": "记住了，「酒中出真知」。"
                                },
                                {
                                    "id": "400040227",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                }
                            ]
                        },
                        {
                            "id": "400040215",
                            "text": "因为凯亚黑白通吃，可以依赖。",
                            "response": [
                                {
                                    "id": "400040216",
                                    "speaker": "派蒙",
                                    "text": "没错！"
                                },
                                {
                                    "id": "400040217",
                                    "speaker": "凯亚",
                                    "text": "啧啧。作为荣誉骑士，要慎言啊。"
                                },
                                {
                                    "id": "400040218",
                                    "speaker": "凯亚",
                                    "text": "什么叫黑白通吃？我们西风骑士团是不和敌人做交易的。"
                                },
                                {
                                    "id": "400040219",
                                    "speaker": "凯亚",
                                    "text": "这就是骑士「诚实」的品德。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4000403",
            "objective": "与凯亚的线人对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "400040301",
                    "speaker": "宁禄",
                    "text": "……"
                },
                {
                    "id": "400040302",
                    "speaker": "派蒙",
                    "text": "你就是凯亚先生推荐来的线人吗？"
                },
                {
                    "id": "400040303",
                    "speaker": "宁禄",
                    "text": "什么线人？不是。"
                },
                {
                    "id": "400040304",
                    "speaker": "派蒙",
                    "text": "可是，在这个约好的地方，只有你啊…"
                },
                {
                    "id": "400040305",
                    "speaker": "宁禄",
                    "text": "什么约好的？不知道。"
                },
                {
                    "id": "400040306",
                    "speaker": "派蒙",
                    "text": "哇，真是让人烦躁的态度！",
                    "choices": [
                        {
                            "id": "400040307",
                            "text": "「酒中出真知。」",
                            "response": [
                                {
                                    "id": "400040308",
                                    "speaker": "宁禄",
                                    "text": "嗯，是自己人。"
                                },
                                {
                                    "id": "400040309",
                                    "speaker": "派蒙",
                                    "text": "这个形式上的流程有什么意义！？"
                                },
                                {
                                    "id": "400040316",
                                    "speaker": "宁禄",
                                    "text": "有什么想问的吗？"
                                },
                                {
                                    "id": "400040317",
                                    "speaker": "派蒙",
                                    "text": "事情是这样的…"
                                },
                                {
                                    "id": "400040318",
                                    "speaker": "宁禄",
                                    "text": "这样吗？"
                                },
                                {
                                    "id": "400040319",
                                    "speaker": "派蒙",
                                    "text": "有什么内部的消息吗？"
                                },
                                {
                                    "id": "400040320",
                                    "speaker": "宁禄",
                                    "text": "我觉得这应该不是盗宝团所为。"
                                },
                                {
                                    "id": "400040321",
                                    "speaker": "宁禄",
                                    "text": "盗宝团能够打下横跨多国的基业，是因为他们永远遵循一个最根本的原则。"
                                },
                                {
                                    "id": "400040322",
                                    "speaker": "宁禄",
                                    "text": "——「富贵险中求」都是骗人的鬼话，稳扎稳打才是人间正道。"
                                },
                                {
                                    "id": "400040323",
                                    "speaker": "宁禄",
                                    "text": "璃月港可是有仙人守护的，尤其是在海灯节期间…"
                                },
                                {
                                    "id": "400040325",
                                    "speaker": "宁禄",
                                    "text": "所以对海灯节出手，这事我们——对不起，角色没缓过来——这事盗宝团绝不会做。"
                                },
                                {
                                    "id": "400040326",
                                    "speaker": "宁禄",
                                    "text": "而且…璃月那里的盗宝团组织，最近收到了一封匿名信。"
                                },
                                {
                                    "id": "400040327",
                                    "speaker": "派蒙",
                                    "text": "匿名信？难道是有人准备栽赃盗宝团？"
                                },
                                {
                                    "id": "400040328",
                                    "speaker": "宁禄",
                                    "text": "这就不得而知了。但我可以告诉你们这封信在盗宝团的哪个分部手里。"
                                },
                                {
                                    "id": "400040329",
                                    "speaker": "宁禄",
                                    "text": "…好了，已经帮你们标在地图上了。"
                                },
                                {
                                    "id": "400040330",
                                    "speaker": "派蒙",
                                    "text": "#嗯，很有收获！{NICKNAME}，我们要努力抓住这唯一的线索啊！"
                                },
                                {
                                    "id": "400040331",
                                    "speaker": "宁禄",
                                    "text": "那么，如果没什么别的事情，我就回去继续盗…我是说，回去监视盗宝团了。"
                                }
                            ]
                        },
                        {
                            "id": "400040310",
                            "text": "都、都在酒里。",
                            "response": [
                                {
                                    "id": "400040311",
                                    "speaker": "宁禄",
                                    "text": "嗯…"
                                },
                                {
                                    "id": "400040312",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "400040313",
                                    "speaker": "宁禄",
                                    "text": "嗯，虽然暗号错了，但如果都在酒里，那真知也应该在酒里。"
                                },
                                {
                                    "id": "400040314",
                                    "speaker": "宁禄",
                                    "text": "没错。是自己人。"
                                },
                                {
                                    "id": "400040315",
                                    "speaker": "派蒙",
                                    "text": "这个形式上的流程有什么意义！？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4000404",
            "objective": "（test）回去蒙德骑士团$UNRELEASED",
            "dialogues": []
        },
        {
            "id": "4000405",
            "objective": "（test）与凯亚对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "400040501",
                    "speaker": "凯亚",
                    "text": "小派蒙一脸失望呢，是线索断了吗？"
                },
                {
                    "id": "400040502",
                    "speaker": "派蒙",
                    "text": "嗯，看来很可能不是盗宝团干的。"
                },
                {
                    "id": "400040503",
                    "speaker": "凯亚",
                    "text": "你们离开的空档里，我正好也听到了另一条消息。"
                },
                {
                    "id": "400040504",
                    "speaker": "凯亚",
                    "text": "来自于璃月那边的…业务合作伙伴。或许对你们有所帮助。"
                },
                {
                    "id": "400040505",
                    "speaker": "派蒙",
                    "text": "是什么是什么？"
                },
                {
                    "id": "400040506",
                    "speaker": "凯亚",
                    "text": "璃月那里的盗宝团组织，收到了一封匿名信。"
                },
                {
                    "id": "400040508",
                    "speaker": "凯亚",
                    "text": "我只能告诉你们那封信在哪里，内容就无从得知了。"
                },
                {
                    "id": "400040509",
                    "speaker": "派蒙",
                    "text": "#嗯！{NICKNAME}，我们要努力抓住这唯一的线索啊！"
                }
            ]
        },
        {
            "id": "4000406",
            "objective": "根据情报寻找盗宝团$UNRELEASED",
            "dialogues": []
        },
        {
            "id": "4000409",
            "objective": "与盗宝团成员对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "400040901",
                    "speaker": "贝儿",
                    "text": "朋友，你走错地方了。无论您想去哪里，都往那边去吧。$UNRELEASED"
                },
                {
                    "id": "400040902",
                    "speaker": "派蒙",
                    "text": "那边不是璃月港吗？$UNRELEASED"
                },
                {
                    "id": "400040903",
                    "speaker": "贝儿",
                    "text": "当然是去璃月港了，因为这里什么都没有啊。$UNRELEASED"
                },
                {
                    "id": "400040904",
                    "speaker": "伶俐鬼",
                    "text": "要吃喝住宿？那可以去那边的望舒客栈。价格公道，态度一流，风景绝好。$UNRELEASED"
                },
                {
                    "id": "400040905",
                    "speaker": "Player",
                    "text": "我们想看「那封匿名信」。$UNRELEASED"
                },
                {
                    "id": "400040906",
                    "speaker": "贝儿",
                    "text": "你为什么会知道这件事？$UNRELEASED"
                },
                {
                    "id": "400040907",
                    "speaker": "派蒙",
                    "text": "…是、是璃月的仙人告诉我们的！$UNRELEASED"
                },
                {
                    "id": "400040908",
                    "speaker": "贝儿",
                    "text": "你这句话也编得也太假了吧。$UNRELEASED"
                },
                {
                    "id": "400040909",
                    "speaker": "？？？$UNRELEASED",
                    "text": "不错。是我委托他们来调查的。$UNRELEASED"
                },
                {
                    "id": "400040910",
                    "speaker": "魈",
                    "text": "现在，还有什么问题吗？$UNRELEASED"
                },
                {
                    "id": "400040911",
                    "speaker": "贝儿",
                    "text": "你…你是「护法夜叉」？！$UNRELEASED"
                },
                {
                    "id": "400040912",
                    "speaker": "派蒙",
                    "text": "见到仙人，为什么反而是这种想要开打的语气？$UNRELEASED"
                },
                {
                    "id": "400040913",
                    "speaker": "伶俐鬼",
                    "text": "不是我们不信您是仙人…但大家想，开开眼界。$UNRELEASED"
                },
                {
                    "id": "400040914",
                    "speaker": "贝儿",
                    "text": "您也知道，我们盗宝团不做什么大奸大恶之事。$UNRELEASED"
                },
                {
                    "id": "400040915",
                    "speaker": "伶俐鬼",
                    "text": "您要真是仙人的话，劳烦手下留情。$UNRELEASED"
                },
                {
                    "id": "400040916",
                    "speaker": "贝儿",
                    "text": "当然，如果不是真正仙人…$UNRELEASED"
                },
                {
                    "id": "400040917",
                    "speaker": "伶俐鬼",
                    "text": "那就休怪我们兵器不长眼睛了。$UNRELEASED"
                }
            ]
        },
        {
            "id": "4000407",
            "objective": "击败盗宝团$UNRELEASED",
            "dialogues": []
        },
        {
            "id": "4000408",
            "objective": "(test)与盗宝团成员对话（隐藏）$UNRELEASED$HIDDEN",
            "dialogues": [
                {
                    "id": "400040801",
                    "speaker": "贝儿",
                    "text": "英雄大人，神仙哥哥！手下留情！$UNRELEASED"
                },
                {
                    "id": "400040802",
                    "speaker": "伶俐鬼",
                    "text": "那匿名信一纸胡言乱语，不必这般兵戎相向的！拿去便是！$UNRELEASED"
                },
                {
                    "id": "400040803",
                    "speaker": "派蒙",
                    "text": "真巧，我早就这么觉得了。$UNRELEASED"
                },
                {
                    "id": "400040804",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，来看看匿名信的内容吧。$UNRELEASED"
                },
                {
                    "id": "400040805",
                    "speaker": "魈",
                    "text": "原来如此，那么就让这两位前去赴会吧。$UNRELEASED"
                },
                {
                    "id": "400040806",
                    "speaker": "魈",
                    "text": "寄信之人可能对海灯节图谋不轨，似乎准备纵火焚城。$UNRELEASED"
                },
                {
                    "id": "400040807",
                    "speaker": "贝儿",
                    "text": "如此甚好。你们也好，我们也好。只是…$UNRELEASED"
                },
                {
                    "id": "400040808",
                    "speaker": "伶俐鬼",
                    "text": "只是，他们两人和我们两人，未免体形相差太大了吧。$UNRELEASED"
                },
                {
                    "id": "400040809",
                    "speaker": "派蒙",
                    "text": "不用担心，乔装打扮之后就认不出来了。$UNRELEASED"
                },
                {
                    "id": "400040810",
                    "speaker": "贝儿",
                    "text": "虽然我觉得哪里不对，但是既然有仙人撑腰，应该不要紧吧。$UNRELEASED"
                },
                {
                    "id": "400040811",
                    "speaker": "伶俐鬼",
                    "text": "那…那璃月安危就托付两位了，我们盗宝团也不希望全城尽毁啊。$UNRELEASED"
                },
                {
                    "id": "400040812",
                    "speaker": "魈",
                    "text": "既然如此，我们就这样讲定了。$UNRELEASED"
                },
                {
                    "id": "400040813",
                    "speaker": "Player",
                    "text": "请等等…$UNRELEASED"
                },
                {
                    "id": "400040814",
                    "speaker": "魈",
                    "text": "怎么了？$UNRELEASED"
                },
                {
                    "id": "400040815",
                    "speaker": "Player",
                    "text": "我们下一次见面的地方…$UNRELEASED"
                },
                {
                    "id": "400040816",
                    "speaker": "魈",
                    "text": "嗯？$UNRELEASED"
                },
                {
                    "id": "400040817",
                    "speaker": "Player",
                    "text": "希望是能看到明霄灯的地方。$UNRELEASED"
                },
                {
                    "id": "400040818",
                    "speaker": "魈",
                    "text": "…我不喜欢人来人往之处，尤其是每年的这几天里。$UNRELEASED"
                },
                {
                    "id": "400040819",
                    "speaker": "魈",
                    "text": "非要在那里不可吗？$UNRELEASED"
                },
                {
                    "id": "400040820",
                    "speaker": "Player",
                    "text": "是的！$UNRELEASED"
                },
                {
                    "id": "400040821",
                    "speaker": "魈",
                    "text": "…我明白了。我会在那里等你的消息的。$UNRELEASED"
                }
            ]
        }
    ]
}