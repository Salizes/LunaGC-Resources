    "talks": [
        {
            "id": "7480001",
            "objective": "和吉雅罗对话",
            "dialogues": [
                {
                    "id": "748000101",
                    "speaker": "吉雅罗",
                    "text": "应该不会…应该不会…"
                },
                {
                    "id": "748000102",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "748000103",
                    "speaker": "吉雅罗",
                    "text": "啊！别！我什么也没干，别伤害我！"
                },
                {
                    "id": "748000104",
                    "speaker": "派蒙",
                    "text": "你在说什么呢。我们为什么要伤害你呀？"
                },
                {
                    "id": "748000105",
                    "speaker": "吉雅罗",
                    "text": "我不知道！但我也不知道你们不会伤害我。",
                    "choices": [
                        {
                            "id": "748000106",
                            "text": "什么乱七八糟的…",
                            "response": [
                                {
                                    "id": "748000108",
                                    "speaker": "吉雅罗",
                                    "text": "对了…对了！一定是因为我发现了你们的秘密，对吧？"
                                },
                                {
                                    "id": "748000109",
                                    "speaker": "吉雅罗",
                                    "text": "是…是我在咖啡馆里拿走了夹着你们密信的报纸？"
                                },
                                {
                                    "id": "748000110",
                                    "speaker": "吉雅罗",
                                    "text": "还是我不小心看见了你们接头的密语？等等，难道是我昨晚上吃的那一条鱼…"
                                },
                                {
                                    "id": "748000111",
                                    "speaker": "吉雅罗",
                                    "text": "我就说那条鱼为什么刺那么少，是你们把那条鱼身上的刺给剔下来的！"
                                },
                                {
                                    "id": "748000112",
                                    "speaker": "吉雅罗",
                                    "text": "对，对，你们想用鱼骨两侧不同的鱼刺数量传递消息…但这条鱼却阴差阳错被我买回了家…"
                                },
                                {
                                    "id": "748000113",
                                    "speaker": "派蒙",
                                    "text": "这家伙，到底在说什么呀？完全听不明白…",
                                    "choices": [
                                        {
                                            "id": "748000114",
                                            "text": "我不会伤害你的。",
                                            "response": [
                                                {
                                                    "id": "748000116",
                                                    "speaker": "吉雅罗",
                                                    "text": "你们、你们真不是来害我的？"
                                                },
                                                {
                                                    "id": "748000117",
                                                    "speaker": "派蒙",
                                                    "text": "你这个人！我们才第一次见到你，为什么要害你呀？"
                                                },
                                                {
                                                    "id": "748000118",
                                                    "speaker": "吉雅罗",
                                                    "text": "是吗？那、那就好…真是抱歉，不好意思…"
                                                },
                                                {
                                                    "id": "748000119",
                                                    "speaker": "吉雅罗",
                                                    "text": "我最近一直在琢磨一篇侦探小说，但一直不知道让里面的犯人用什么手法作案比较巧妙。"
                                                },
                                                {
                                                    "id": "748000120",
                                                    "speaker": "吉雅罗",
                                                    "text": "因为我想得太多，所以…现在看见任何东西，第一反应就是如何用它来…作案。"
                                                },
                                                {
                                                    "id": "748000121",
                                                    "speaker": "吉雅罗",
                                                    "text": "唉，所以我才…这么紧张，真是不好意思。用人家的话来说，我简直有「被害妄想」了。"
                                                },
                                                {
                                                    "id": "748000122",
                                                    "speaker": "吉雅罗",
                                                    "text": "我刚才准备坐巡轨船去城里喝杯咖啡，但当我看见巡轨船运行的样子…"
                                                },
                                                {
                                                    "id": "748000123",
                                                    "speaker": "吉雅罗",
                                                    "text": "我、我脑子里一瞬间就浮现了无数种我在巡轨船上被害的样子，根本不敢上船。",
                                                    "choices": [
                                                        {
                                                            "id": "748000124",
                                                            "text": "你自己都说是「妄想」了。",
                                                            "response": [
                                                                {
                                                                    "id": "748000126",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "话是这么说没错。但我就是忍不住想个没完，越想就越害怕…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000127",
                                                                            "text": "我陪你去吧…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000129",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "真的？！太好了，但是…如果那个想要害我的人，连你一起害了呢？"
                                                                                },
                                                                                {
                                                                                    "id": "748000130",
                                                                                    "speaker": "Player",
                                                                                    "text": "你就放心吧…"
                                                                                },
                                                                                {
                                                                                    "id": "748000131",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#走啦走啦，别想那么多。无论任何问题，{NICKNAME}都会轻松解决掉的。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000128",
                                                                            "text": "我来护送你。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000125",
                                                            "text": "怎么可能，别想太多了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000115",
                                            "text": "别妄想这些乱七八糟的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000107",
                            "text": "你在说什么呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7480007",
            "objective": "前往巡轨船附近",
            "dialogues": [
                {
                    "id": "748000201",
                    "speaker": "吉雅罗",
                    "text": "旁边就是巡轨船了…等会我们一起上去吧。"
                }
            ]
        },
        {
            "id": "7480006",
            "objective": "和吉雅罗对话",
            "dialogues": [
                {
                    "id": "748000801",
                    "speaker": "派蒙",
                    "text": "…我说啊。为什么你一直蹲在地上？还抱着头。"
                },
                {
                    "id": "748000802",
                    "speaker": "派蒙",
                    "text": "难道你是怕被撞到头吗？但这里连顶都没有啊。"
                },
                {
                    "id": "748000803",
                    "speaker": "吉雅罗",
                    "text": "嘘，快过来，你们快和我一起趴下！这里很危险…"
                },
                {
                    "id": "748000804",
                    "speaker": "派蒙",
                    "text": "这个人又开始了…"
                },
                {
                    "id": "748000805",
                    "speaker": "吉雅罗",
                    "text": "这条巡轨船的顶上没有任何遮挡，如果在两侧立起两根竖杆，中间再挂上一根钓鱼线…"
                },
                {
                    "id": "748000806",
                    "speaker": "吉雅罗",
                    "text": "只要巡轨船路过那两根竖杆之间，那根钓鱼线就会瞬间切向…"
                },
                {
                    "id": "748000807",
                    "speaker": "派蒙",
                    "text": "呜哇！别说啦！"
                },
                {
                    "id": "748000808",
                    "speaker": "吉雅罗",
                    "text": "不、不，甚至不需要两根竖杆，只需要一根…"
                },
                {
                    "id": "748000809",
                    "speaker": "吉雅罗",
                    "text": "只要在上面挂上一根带鱼钩的鱼线，让它垂在半空…"
                },
                {
                    "id": "748000810",
                    "speaker": "吉雅罗",
                    "text": "巡轨船上的人，就会自然而然地被鱼钩勾住，然后…"
                },
                {
                    "id": "748000811",
                    "speaker": "派蒙",
                    "text": "我不听我不听我不听我不听…"
                },
                {
                    "id": "748000812",
                    "speaker": "派蒙",
                    "text": "听她说了一路，连我都有点害怕了…"
                },
                {
                    "id": "748000813",
                    "speaker": "派蒙",
                    "text": "等到站了之后，我们就快下去吧…"
                }
            ]
        },
        {
            "id": "7480003",
            "objective": "前往咖啡馆",
            "dialogues": [
                {
                    "id": "748000401",
                    "speaker": "派蒙",
                    "text": "你怎么又躲起来了，这周围什么也没有啊？"
                },
                {
                    "id": "748000402",
                    "speaker": "吉雅罗",
                    "text": "你没看见那台警卫机关吗？就在我们面前！",
                    "choices": [
                        {
                            "id": "748000403",
                            "text": "它…怎么了？",
                            "response": [
                                {
                                    "id": "748000405",
                                    "speaker": "吉雅罗",
                                    "text": "嘘，快点离开那边，这警卫机关要是失控了怎么办？"
                                },
                                {
                                    "id": "748000406",
                                    "speaker": "吉雅罗",
                                    "text": "或者它…它的能源核心突然发生爆炸，或者是被人遥控着攻击我们！"
                                },
                                {
                                    "id": "748000407",
                                    "speaker": "Player",
                                    "text": "但它一切正常。"
                                },
                                {
                                    "id": "748000408",
                                    "speaker": "吉雅罗",
                                    "text": "这正是我害怕的。一个原本正常的机关突然失控，让某个倒霉蛋丢了命…"
                                },
                                {
                                    "id": "748000409",
                                    "speaker": "吉雅罗",
                                    "text": "这件事不会有任何人为其负责，说不定连作案主使都找不到…实在是太危险了！"
                                },
                                {
                                    "id": "748000410",
                                    "speaker": "派蒙",
                                    "text": "它已经走了喔，你可以出来了。"
                                },
                                {
                                    "id": "748000411",
                                    "speaker": "吉雅罗",
                                    "text": "喔，它真的没有失控，真是出乎预料。我们又捡了一条命啊。",
                                    "choices": [
                                        {
                                            "id": "748000412",
                                            "text": "根本就不可能出现这种意外。",
                                            "response": [
                                                {
                                                    "id": "748000414",
                                                    "speaker": "吉雅罗",
                                                    "text": "我所想要构想的，就是一场「人为营造的纯粹意外」。"
                                                },
                                                {
                                                    "id": "748000415",
                                                    "speaker": "吉雅罗",
                                                    "text": "等等。没有主使…不会由任何人单独为其负责的案件…"
                                                },
                                                {
                                                    "id": "748000416",
                                                    "speaker": "吉雅罗",
                                                    "text": "对！我有灵感了，快，快，我们去咖啡馆，我必须得快点写下来！"
                                                },
                                                {
                                                    "id": "748000417",
                                                    "speaker": "派蒙",
                                                    "text": "喂！跑慢点啊，你不怕有人突然丢块石头绊倒你吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000413",
                                            "text": "它从一开始就不可能失控好吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000404",
                            "text": "呃…然后呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7480005",
            "objective": "前往咖啡馆",
            "dialogues": [
                {
                    "id": "748000501",
                    "speaker": "吉雅罗",
                    "text": "对，没错…就是这样…",
                    "choices": [
                        {
                            "id": "748000502",
                            "text": "咖啡要凉了。",
                            "response": [
                                {
                                    "id": "748000504",
                                    "speaker": "吉雅罗",
                                    "text": "#好的，谢谢你，{NICKNAME}。多谢一路护送我过来。"
                                },
                                {
                                    "id": "748000505",
                                    "speaker": "派蒙",
                                    "text": "说是护送…其实我们只是跟着你走了一路而已，什么也没做啊。",
                                    "choices": [
                                        {
                                            "id": "748000506",
                                            "text": "什么坏事也没发生。",
                                            "response": [
                                                {
                                                    "id": "748000508",
                                                    "speaker": "吉雅罗",
                                                    "text": "是的。看来我的确是想太多了。"
                                                },
                                                {
                                                    "id": "748000509",
                                                    "speaker": "吉雅罗",
                                                    "text": "这咖啡味道真不错，哈哈…哈…"
                                                },
                                                {
                                                    "id": "748000510",
                                                    "speaker": "吉雅罗",
                                                    "text": "…你说，会不会有人在里面下毒啊。",
                                                    "choices": [
                                                        {
                                                            "id": "748000511",
                                                            "text": "…咳。",
                                                            "response": [
                                                                {
                                                                    "id": "748000513",
                                                                    "speaker": "派蒙",
                                                                    "text": "胡说，我们都喝完了，一点事也没有啊？"
                                                                },
                                                                {
                                                                    "id": "748000514",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "不不不，也许是一种…特别的下毒方式。"
                                                                },
                                                                {
                                                                    "id": "748000515",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "首先，下毒的人在我们喝的咖啡里倒入了第一种药物。"
                                                                },
                                                                {
                                                                    "id": "748000516",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "单独服用这种药物，不会对服用者造成任何影响。"
                                                                },
                                                                {
                                                                    "id": "748000517",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "当我们全部服下了这种药，离开这里回家的时候，下毒者就会偷偷尾随我们…"
                                                                },
                                                                {
                                                                    "id": "748000518",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "等我们睡着，他们就潜入房里，在我们的水壶里倒入第二种药。"
                                                                },
                                                                {
                                                                    "id": "748000519",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "这样，等我们第二天带着水壶出行，并且喝下水壶里的水时，两种药物就会起反应。"
                                                                },
                                                                {
                                                                    "id": "748000520",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "我们就会…"
                                                                },
                                                                {
                                                                    "id": "748000521",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "这位客人，你到底在说什么？"
                                                                },
                                                                {
                                                                    "id": "748000522",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "咖啡？下毒？请不要在我的店里开这种玩笑。"
                                                                },
                                                                {
                                                                    "id": "748000523",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "如果影响到其他客人，我就要请你出去了！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000524",
                                                                            "text": "店长，我来解释…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000526",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "向阿鲁埃讲述了吉雅罗的事。听完后，阿鲁埃无奈地离开了…"
                                                                                },
                                                                                {
                                                                                    "id": "748000527",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "为了道歉，吉雅罗又买了三杯咖啡…"
                                                                                },
                                                                                {
                                                                                    "id": "748000528",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这次的咖啡，可是你看着店长做的喔，绝对不会有问题了吧。"
                                                                                },
                                                                                {
                                                                                    "id": "748000529",
                                                                                    "speaker": "Player",
                                                                                    "text": "不要再胡思乱想了。"
                                                                                },
                                                                                {
                                                                                    "id": "748000530",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "我知道了…不过，这一路上我确实找到了很多灵感。"
                                                                                },
                                                                                {
                                                                                    "id": "748000531",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "只要稍加整理，我一定能找到一种不留痕迹的完美手法！"
                                                                                },
                                                                                {
                                                                                    "id": "748000532",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "等我写好了那本小说，一定会马上寄给你看的。"
                                                                                },
                                                                                {
                                                                                    "id": "748000533",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "但在那之前，我要先喝完这杯咖啡，这杯…咖啡…"
                                                                                },
                                                                                {
                                                                                    "id": "748000534",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "#呃，{NICKNAME}，你说…有没有可能…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "748000535",
                                                                                            "text": "你给我住嘴！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "748000537",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "这个杯子，本身就是有毒的？！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "748000536",
                                                                                            "text": "别往下说了！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000525",
                                                                            "text": "她是我的朋友。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000512",
                                                            "text": "你、你少说两句！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000507",
                                            "text": "你也没遇见什么危险。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000503",
                            "text": "我都已经喝完了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7480002",
            "objective": "登上巡轨船",
            "dialogues": []
        },
        {
            "id": "7480004",
            "objective": "与吉雅罗对话",
            "dialogues": []
        },
        {
            "id": "7480006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "748000601",
                    "speaker": "吉雅罗",
                    "text": "对，没错…就是这样…",
                    "choices": [
                        {
                            "id": "748000602",
                            "text": "咖啡要凉了。",
                            "response": [
                                {
                                    "id": "748000604",
                                    "speaker": "吉雅罗",
                                    "text": "#好的，谢谢你，{NICKNAME}。多谢一路护送我过来。"
                                },
                                {
                                    "id": "748000605",
                                    "speaker": "派蒙",
                                    "text": "说是护送…其实我们只是跟着你走了一路而已，什么也没做啊。",
                                    "choices": [
                                        {
                                            "id": "748000606",
                                            "text": "什么坏事也没发生。",
                                            "response": [
                                                {
                                                    "id": "748000608",
                                                    "speaker": "吉雅罗",
                                                    "text": "是的。看来我的确是想太多了。"
                                                },
                                                {
                                                    "id": "748000609",
                                                    "speaker": "吉雅罗",
                                                    "text": "这咖啡味道真不错，哈哈…哈…"
                                                },
                                                {
                                                    "id": "748000610",
                                                    "speaker": "吉雅罗",
                                                    "text": "…你说，会不会有人在里面下毒啊。",
                                                    "choices": [
                                                        {
                                                            "id": "748000611",
                                                            "text": "…咳。",
                                                            "response": [
                                                                {
                                                                    "id": "748000613",
                                                                    "speaker": "派蒙",
                                                                    "text": "胡说，我们都喝完了，一点事也没有啊？"
                                                                },
                                                                {
                                                                    "id": "748000614",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "不不不，也许是一种…特别的下毒方式。"
                                                                },
                                                                {
                                                                    "id": "748000615",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "首先，下毒的人在我们喝的咖啡里倒入了第一种药物。"
                                                                },
                                                                {
                                                                    "id": "748000616",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "单独服用这种药物，不会对服用者造成任何影响。"
                                                                },
                                                                {
                                                                    "id": "748000617",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "当我们全部服下了这种药，离开这里回家的时候，下毒者就会偷偷尾随我们…"
                                                                },
                                                                {
                                                                    "id": "748000618",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "等我们睡着，他们就潜入房里，在我们的水壶里倒入第二种药。"
                                                                },
                                                                {
                                                                    "id": "748000619",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "这样，等我们第二天带着水壶出行，并且喝下水壶里的水时，两种药物就会起反应。"
                                                                },
                                                                {
                                                                    "id": "748000620",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "我们就会…"
                                                                },
                                                                {
                                                                    "id": "748000621",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "这位客人，你到底在说什么？"
                                                                },
                                                                {
                                                                    "id": "748000622",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "咖啡？下毒？请不要在我的店里开这种玩笑。"
                                                                },
                                                                {
                                                                    "id": "748000623",
                                                                    "speaker": "阿鲁埃",
                                                                    "text": "如果影响到其他客人，我就要请你出去了！"
                                                                },
                                                                {
                                                                    "id": "748000624",
                                                                    "speaker": "Black Screen",
                                                                    "text": "吉雅罗慌慌张张地向阿鲁埃道了歉，并且讲述了自己的事。"
                                                                },
                                                                {
                                                                    "id": "748000625",
                                                                    "speaker": "Black Screen",
                                                                    "text": "为了道歉，吉雅罗又买了三杯咖啡…"
                                                                },
                                                                {
                                                                    "id": "748000626",
                                                                    "speaker": "派蒙",
                                                                    "text": "这次的咖啡，可是你看着店长做的喔，绝对不会有问题了吧。"
                                                                },
                                                                {
                                                                    "id": "748000627",
                                                                    "speaker": "Player",
                                                                    "text": "不要再胡思乱想了。"
                                                                },
                                                                {
                                                                    "id": "748000628",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "我知道了…不过，这一路上我确实找到了很多灵感。"
                                                                },
                                                                {
                                                                    "id": "748000629",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "只要稍加整理，我一定能找到一种不留痕迹的完美手法！"
                                                                },
                                                                {
                                                                    "id": "748000630",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "等我写好了那本小说，一定会马上寄给你看的。"
                                                                },
                                                                {
                                                                    "id": "748000631",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "但在那之前，我要先喝完这杯咖啡，这杯…咖啡…"
                                                                },
                                                                {
                                                                    "id": "748000632",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "#呃，{NICKNAME}，你说…有没有可能…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000633",
                                                                            "text": "你给我住嘴！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000635",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "这个杯子，本身就是有毒的？！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000634",
                                                                            "text": "别往下说了！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000612",
                                                            "text": "你、你少说两句！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000607",
                                            "text": "你也没遇见什么危险。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000603",
                            "text": "我都已经喝完了。"
                        }
                    ]
                },
                {
                    "id": "748000699",
                    "speaker": "Black Screen",
                    "text": "一阵急促的脚步声突然靠近…"
                }
            ]
        },
        {
            "id": "7480099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "748009905",
                    "speaker": "派蒙",
                    "text": "喂！跑慢点啊，你不怕有人突然丢块石头绊倒你吗？"
                }
            ]
        }
    ]
