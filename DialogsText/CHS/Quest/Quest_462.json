    "talks": [
        {
            "id": "46201",
            "objective": "在约定地点与线人见面",
            "dialogues": [
                {
                    "id": "4620101",
                    "speaker": "派蒙",
                    "text": "#那边…{NICKNAME}，快看！那个姑娘有危险！"
                },
                {
                    "id": "4620102",
                    "speaker": "派蒙",
                    "text": "先别管接头的事了，快去救救她吧！"
                }
            ]
        },
        {
            "id": "46202",
            "objective": "击退围攻线人的怪物",
            "dialogues": [
                {
                    "id": "4620201",
                    "speaker": "派蒙",
                    "text": "。。。"
                }
            ]
        },
        {
            "id": "46203",
            "objective": "与线人对话",
            "dialogues": [
                {
                    "id": "4620301",
                    "speaker": "薇尔",
                    "text": "唉…怎么会遇到这种事，早知道就不该帮<color=#00E1FFFF>他</color>这个忙了…"
                },
                {
                    "id": "4620302",
                    "speaker": "派蒙",
                    "text": "「他」？"
                },
                {
                    "id": "4620303",
                    "speaker": "薇尔",
                    "text": "真是谢谢你们！差点就要有大麻烦了，你们可比那些西风骑士靠谱多了。"
                },
                {
                    "id": "4620304",
                    "speaker": "派蒙",
                    "text": "#小意思小意思，毕竟{NICKNAME}作为旅行者，每天都要面对很多麻烦的。"
                },
                {
                    "id": "4620305",
                    "speaker": "薇尔",
                    "text": "旅行者？我好像听过你的情报，没想到被<color=#00E1FFFF>接头人</color>救了一命。"
                },
                {
                    "id": "4620306",
                    "speaker": "派蒙",
                    "text": "哇！原来你就是…"
                },
                {
                    "id": "4620307",
                    "speaker": "薇尔",
                    "text": "呵呵呵…本来还不知道该如何报答你们。既然这样，就把情报免费送给你们好了。"
                },
                {
                    "id": "4620308",
                    "speaker": "薇尔",
                    "text": "做情报生意的，都知道多交朋友的重要性呢。",
                    "choices": [
                        {
                            "id": "4620309",
                            "text": "真的可以吗？",
                            "response": [
                                {
                                    "id": "4620310",
                                    "speaker": "薇尔",
                                    "text": "当然，毕竟是救命恩人嘛。"
                                },
                                {
                                    "id": "4620312",
                                    "speaker": "派蒙",
                                    "text": "嘿，真是好运！"
                                },
                                {
                                    "id": "4620313",
                                    "speaker": "派蒙",
                                    "text": "可是…怎么感觉便宜了凯亚那家伙，说好情报费由他来出的…"
                                },
                                {
                                    "id": "4620314",
                                    "speaker": "薇尔",
                                    "text": "那听好咯，有关「阿卡狄亚遗迹」的情报…"
                                },
                                {
                                    "id": "4620315",
                                    "speaker": "薇尔",
                                    "text": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」"
                                },
                                {
                                    "id": "4620316",
                                    "speaker": "派蒙",
                                    "text": "…嗯？这就完啦？"
                                },
                                {
                                    "id": "4620325",
                                    "speaker": "薇尔",
                                    "text": "记录着情报的纸上还附了这样一张图…"
                                },
                                {
                                    "id": "4620317",
                                    "speaker": "派蒙",
                                    "text": "唔…这图上画的难道就是藏宝地？"
                                },
                                {
                                    "id": "4620318",
                                    "speaker": "派蒙",
                                    "text": "唔…好不容易拿到了线索，原来还要猜谜呀。"
                                },
                                {
                                    "id": "4620319",
                                    "speaker": "派蒙",
                                    "text": "#不过以{NICKNAME}的聪明才智应该不是问题吧~！",
                                    "choices": [
                                        {
                                            "id": "4620320",
                                            "text": "那是当然！",
                                            "response": [
                                                {
                                                    "id": "4620322",
                                                    "speaker": "派蒙",
                                                    "text": "唔嗯，就算解不出来，至少还可以去问问凯亚，他好像脑袋也很好用的样子呢。"
                                                },
                                                {
                                                    "id": "4620326",
                                                    "speaker": "薇尔",
                                                    "text": "那这份情报就先放在你们这边吧，如果忘记了可以随时拿出来看。"
                                                },
                                                {
                                                    "id": "4620327",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，谢谢薇尔小姐啦。"
                                                },
                                                {
                                                    "id": "4620323",
                                                    "speaker": "派蒙",
                                                    "text": "「湖中之城里住着三只六臂巨人，两位守护着神像，一位守护着众神的财宝」"
                                                },
                                                {
                                                    "id": "4620324",
                                                    "speaker": "派蒙",
                                                    "text": "…究竟是指什么呢？如果不想麻烦凯亚，就自己好好想想吧~！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4620321",
                                            "text": "…应该…没问题吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4620311",
                            "text": "谢谢你，朋友。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46204",
            "objective": "(test)寻找谜题中所指的地点$HIDDEN",
            "dialogues": [
                {
                    "id": "4620401",
                    "speaker": "派蒙",
                    "text": "快让我看看~！藏起来的是什么东西？"
                },
                {
                    "id": "4620402",
                    "speaker": "派蒙",
                    "text": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」。"
                },
                {
                    "id": "4620407",
                    "speaker": "派蒙",
                    "text": "这次同样也附了一张图呢。"
                },
                {
                    "id": "4620403",
                    "speaker": "派蒙",
                    "text": "什么嘛，还要猜谜吗？"
                },
                {
                    "id": "4620404",
                    "speaker": "派蒙",
                    "text": "不行了，派蒙觉得好累，头晕晕的，大概是用脑过度了吧。"
                },
                {
                    "id": "4620405",
                    "speaker": "Player",
                    "text": "你明明就没动过脑…"
                },
                {
                    "id": "4620406",
                    "speaker": "派蒙",
                    "text": "总之这次也靠你了，嘻嘻。没有想法的话，就再去找凯亚帮忙吧~！"
                }
            ]
        },
        {
            "id": "46210",
            "objective": "(test)控制派蒙对话后消失$HIDDEN",
            "dialogues": []
        },
        {
            "id": "46205",
            "objective": "破解谜题（到骑士团找凯亚可获取提示）",
            "dialogues": [
                {
                    "id": "4620501",
                    "speaker": "凯亚",
                    "text": "#{NICKNAME}！你们回来了，看上去线索你们已经拿到了。"
                },
                {
                    "id": "4620502",
                    "speaker": "派蒙",
                    "text": "拿到了是没错，但好像比想象中复杂…"
                },
                {
                    "id": "4620503",
                    "speaker": "派蒙",
                    "text": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」，这是什么意思？"
                },
                {
                    "id": "4620504",
                    "speaker": "凯亚",
                    "text": "居然是用猜谜的方式…真是传统呢。让我想想…"
                },
                {
                    "id": "4620505",
                    "speaker": "凯亚",
                    "text": "湖中之城应该指的是蒙德城没错…六臂巨人？六…什么东西与六相关来着…"
                },
                {
                    "id": "4620506",
                    "speaker": "Player",
                    "text": "难道是螃蟹脚？"
                },
                {
                    "id": "4620507",
                    "speaker": "派蒙",
                    "text": "所以六臂巨人是巨大的螃蟹！"
                },
                {
                    "id": "4620508",
                    "speaker": "凯亚",
                    "text": "…先不说哪里有巨大螃蟹的问题…"
                },
                {
                    "id": "4620509",
                    "speaker": "凯亚",
                    "text": "螃蟹是有八只蟹脚的吧。"
                },
                {
                    "id": "4620516",
                    "speaker": "Player",
                    "text": "…那应该是指风车？"
                },
                {
                    "id": "4620517",
                    "speaker": "Player",
                    "text": "应该是指…风车？"
                },
                {
                    "id": "4620518",
                    "speaker": "凯亚",
                    "text": "哦~！不愧是你。"
                },
                {
                    "id": "4620519",
                    "speaker": "凯亚",
                    "text": "风车上的扇叶刚好有六个，称它为「六臂巨人」似乎很形象呢。"
                },
                {
                    "id": "4620510",
                    "speaker": "派蒙",
                    "text": "呜哇！你这么一说！"
                },
                {
                    "id": "4620511",
                    "speaker": "凯亚",
                    "text": "剩下的问题就简单了，三座风车中，有两座离神像很近，是守护神像的「巨人」。"
                },
                {
                    "id": "4620512",
                    "speaker": "凯亚",
                    "text": "而除此之外的那一座所守护的东西，应该就是…"
                },
                {
                    "id": "4620513",
                    "speaker": "派蒙",
                    "text": "宝藏！这里可难不倒我！"
                },
                {
                    "id": "4620514",
                    "speaker": "凯亚",
                    "text": "呵呵呵…希望真的能那样顺利。"
                },
                {
                    "id": "4620515",
                    "speaker": "派蒙",
                    "text": "#走吧走吧，{NICKNAME}我们快去那座风车下看看吧！"
                }
            ]
        },
        {
            "id": "46208",
            "objective": "寻找谜题中所指的地点",
            "dialogues": [
                {
                    "id": "4620801",
                    "speaker": "凯亚",
                    "text": "地点在低语森林，你没忘记吧。"
                }
            ]
        },
        {
            "id": "46206",
            "objective": "(test)寻找谜题中所指的地点$HIDDEN",
            "dialogues": [
                {
                    "id": "4620601",
                    "speaker": "派蒙",
                    "text": "嘿嘿，对本天才来说真是小意思。你看这是张地图！"
                }
            ]
        },
        {
            "id": "46207",
            "objective": "破解谜题（到骑士团找凯亚可获取提示）",
            "dialogues": [
                {
                    "id": "4620701",
                    "speaker": "凯亚",
                    "text": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」…"
                },
                {
                    "id": "4620702",
                    "speaker": "派蒙",
                    "text": "想到什么了吗？"
                },
                {
                    "id": "4620703",
                    "speaker": "凯亚",
                    "text": "这该不会是你们碰巧捡到的恋爱小说的残页吧…"
                },
                {
                    "id": "4620704",
                    "speaker": "派蒙",
                    "text": "原来搞错了呀，怪不得我这么聪明都猜不出来！"
                },
                {
                    "id": "4620705",
                    "speaker": "凯亚",
                    "text": "哈哈哈…我开玩笑的。"
                },
                {
                    "id": "4620706",
                    "speaker": "派蒙",
                    "text": "唔嗯…你认真点啦，凯亚！"
                },
                {
                    "id": "4620707",
                    "speaker": "凯亚",
                    "text": "哈哈，这个谜题确实更难猜一点。清泉…是说清泉镇吗？"
                },
                {
                    "id": "4620708",
                    "speaker": "凯亚",
                    "text": "「清泉的热情奔放」…什么情况下清泉会显得热情奔放呢？"
                },
                {
                    "id": "4620709",
                    "speaker": "凯亚",
                    "text": "至于「瀑布的心」，应该就是瀑布左侧的山崖之上吧，我巡逻的时候从瀑布下面眺望过那里。"
                },
                {
                    "id": "4620710",
                    "speaker": "凯亚",
                    "text": "最后「冰冷寂寞之时」，大概和神之眼所能操控的冰元素脱不了关系。"
                },
                {
                    "id": "4620711",
                    "speaker": "凯亚",
                    "text": "你最好<color=#00E1FFFF>带上一位能够掌控冰元素的朋友一起去</color>。"
                },
                {
                    "id": "4620712",
                    "speaker": "Player",
                    "text": "多亏了凯亚帮忙。"
                },
                {
                    "id": "4620713",
                    "speaker": "凯亚",
                    "text": "不足挂齿，作为西风骑士如果连猜谜都不擅长的话，还怎么看穿罪犯的阴谋诡计呢？"
                },
                {
                    "id": "4620714",
                    "speaker": "派蒙",
                    "text": "那我们去清泉镇看看了，就不打扰你的阴谋诡计啦~！"
                },
                {
                    "id": "4620715",
                    "speaker": "凯亚",
                    "text": "…嗯？"
                },
                {
                    "id": "4620716",
                    "speaker": "派蒙",
                    "text": "哦不对…是不打扰你看穿罪犯的阴谋诡计！"
                }
            ]
        },
        {
            "id": "46209",
            "objective": "寻找谜题中所指的地点",
            "dialogues": [
                {
                    "id": "4620901",
                    "speaker": "凯亚",
                    "text": "没猜错的话，线索指向的是离神像最远的风车处…我也不是那么确定哦。"
                }
            ]
        },
        {
            "id": "46210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4621001",
                    "speaker": "凯亚",
                    "text": "去清泉镇的瀑布上找找吧，记得带上一位善用冰元素的朋友。哦？嗯…我自己吗…"
                }
            ]
        },
        {
            "id": "46211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4621101",
                    "speaker": "薇尔",
                    "text": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」…记住了吗。"
                }
            ]
        }
    ]
}