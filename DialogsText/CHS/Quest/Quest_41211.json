    "talks": [
        {
            "id": "4121101",
            "objective": "与阿贝多会合",
            "dialogues": [
                {
                    "id": "412110101",
                    "speaker": "派蒙",
                    "text": "阿贝多——！"
                },
                {
                    "id": "412110102",
                    "speaker": "阿贝多",
                    "text": "回来啦。"
                },
                {
                    "id": "412110103",
                    "speaker": "派蒙",
                    "text": "我们可是努力了好久，快看看剑的进展如何！"
                },
                {
                    "id": "412110104",
                    "speaker": "Player",
                    "text": "你看。"
                },
                {
                    "id": "412110105",
                    "speaker": "阿贝多",
                    "text": "唔…果然。"
                },
                {
                    "id": "412110106",
                    "speaker": "阿贝多",
                    "text": "和我想的一样，这把剑会随着战斗成长。"
                },
                {
                    "id": "412110107",
                    "speaker": "派蒙",
                    "text": "它又不是人！"
                },
                {
                    "id": "412110108",
                    "speaker": "阿贝多",
                    "text": "所以这就是它的特殊之处了。"
                },
                {
                    "id": "412110109",
                    "speaker": "阿贝多",
                    "text": "对了，先说一件比较重要的事。"
                },
                {
                    "id": "412110110",
                    "speaker": "阿贝多",
                    "text": "我调查了附近的雪地，发现有不同寻常的痕迹。"
                },
                {
                    "id": "412110111",
                    "speaker": "派蒙",
                    "text": "呀，不会是小偷吧！",
                    "choices": [
                        {
                            "id": "412110112",
                            "text": "不是说我们才是小偷吗？",
                            "response": [
                                {
                                    "id": "412110114",
                                    "speaker": "派蒙",
                                    "text": "也对哦。"
                                },
                                {
                                    "id": "412110115",
                                    "speaker": "阿贝多",
                                    "text": "我认为那些痕迹并不寻常，有调查的必要。"
                                },
                                {
                                    "id": "412110116",
                                    "speaker": "阿贝多",
                                    "text": "是小偷，还是别的东西，调查完自然会有结论。"
                                }
                            ]
                        },
                        {
                            "id": "412110113",
                            "text": "盗宝团应该不这么想。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121105",
            "objective": "刷出魔剑（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4121106",
            "objective": "刷走魔剑（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4121102",
            "objective": "前往调查地点",
            "dialogues": [
                {
                    "id": "412110201",
                    "speaker": "阿贝多",
                    "text": "居然是愚人众？而且还选在盗宝团的营地里袭击我们…莫非他们是跟着我们来的？"
                },
                {
                    "id": "412110202",
                    "speaker": "派蒙",
                    "text": "可是，为什么要跟着我们呢？"
                },
                {
                    "id": "412110203",
                    "speaker": "派蒙",
                    "text": "啊！该不会是你背着我去犯了什么事吧！"
                },
                {
                    "id": "412110204",
                    "speaker": "阿贝多",
                    "text": "你犯事了吗？",
                    "choices": [
                        {
                            "id": "412110205",
                            "text": "怎么可能！",
                            "response": [
                                {
                                    "id": "412110207",
                                    "speaker": "派蒙",
                                    "text": "唔…那就不是我们的错了…"
                                },
                                {
                                    "id": "412110208",
                                    "speaker": "阿贝多",
                                    "text": "我猜愚人众也在找这把剑。"
                                },
                                {
                                    "id": "412110209",
                                    "speaker": "派蒙",
                                    "text": "哎哎？可你不是把这把剑藏得很好吗，愚人众怎么会知道它的存在呢？"
                                },
                                {
                                    "id": "412110210",
                                    "speaker": "阿贝多",
                                    "text": "或许是你在雪山战斗的样子被他们看到了。"
                                },
                                {
                                    "id": "412110211",
                                    "speaker": "阿贝多",
                                    "text": "如果愚人众的人眼光够好，就会发现这把剑的与众不同之处。"
                                },
                                {
                                    "id": "412110212",
                                    "speaker": "派蒙",
                                    "text": "愚人众怎么什么都要啊！"
                                },
                                {
                                    "id": "412110213",
                                    "speaker": "阿贝多",
                                    "text": "这可不是什么都要哦。"
                                },
                                {
                                    "id": "412110214",
                                    "speaker": "Player",
                                    "text": "我记得我有听说过相关信息。"
                                },
                                {
                                    "id": "412110215",
                                    "speaker": "阿贝多",
                                    "text": "愚人众在搜集与神有关的东西，你们应该已经知道了。"
                                },
                                {
                                    "id": "412110216",
                                    "speaker": "派蒙",
                                    "text": "呀，这么一说，确实听迪卢克老爷提起过呢。"
                                },
                                {
                                    "id": "412110217",
                                    "speaker": "阿贝多",
                                    "text": "杜林是风神的仇敌，具有相当的力量。"
                                },
                                {
                                    "id": "412110218",
                                    "speaker": "阿贝多",
                                    "text": "说它是「能匹敌神的存在」也好，「与神有关的存在」也好，都不为过。"
                                },
                                {
                                    "id": "412110219",
                                    "speaker": "Player",
                                    "text": "难怪这把剑会被愚人众当成目标。"
                                },
                                {
                                    "id": "412110220",
                                    "speaker": "派蒙",
                                    "text": "原来是这样啊…"
                                },
                                {
                                    "id": "412110221",
                                    "speaker": "阿贝多",
                                    "text": "不久前来附近写生，我有个新发现。"
                                },
                                {
                                    "id": "412110222",
                                    "speaker": "阿贝多",
                                    "text": "从这里向前，有一处较为特殊的土地。它的地脉流向与别处都不一样。"
                                },
                                {
                                    "id": "412110223",
                                    "speaker": "阿贝多",
                                    "text": "周边的怪物被它吸引，又受它影响，久而久之，身体素质会比同类更强。"
                                },
                                {
                                    "id": "412110224",
                                    "speaker": "派蒙",
                                    "text": "还有这种好事？"
                                },
                                {
                                    "id": "412110225",
                                    "speaker": "派蒙",
                                    "text": "我们是要帮助这把剑成长对吧？来都来了，不如去试试手！"
                                },
                                {
                                    "id": "412110226",
                                    "speaker": "阿贝多",
                                    "text": "没错。顺便还能观察不同敌人对这把剑造成的影响。"
                                }
                            ]
                        },
                        {
                            "id": "412110206",
                            "text": "我绝不可能做这种事。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121103",
            "objective": "与阿贝多对话",
            "dialogues": [
                {
                    "id": "412110401",
                    "speaker": "派蒙",
                    "text": "确实有大量人类活动的痕迹。"
                },
                {
                    "id": "412110402",
                    "speaker": "派蒙",
                    "text": "而且，看起来还不止一个人。"
                },
                {
                    "id": "412110403",
                    "speaker": "Player",
                    "text": "看这些线索，像是盗宝团。"
                },
                {
                    "id": "412110404",
                    "speaker": "派蒙",
                    "text": "盗宝团真的在雪山有营地呀…是来偷窃抢劫的吗？"
                },
                {
                    "id": "412110405",
                    "speaker": "阿贝多",
                    "text": "山上有落单的冒险家，打劫起来很方便。"
                },
                {
                    "id": "412110406",
                    "speaker": "派蒙",
                    "text": "真是弱肉强食的雪山呀。"
                },
                {
                    "id": "412110407",
                    "speaker": "派蒙",
                    "text": "不过他们偷了这么多东西，却还是一贫如洗，真够寒碜的…",
                    "choices": [
                        {
                            "id": "412110408",
                            "text": "该不该同情呢…",
                            "response": [
                                {
                                    "id": "412110410",
                                    "speaker": "派蒙",
                                    "text": "哼，叫我们小偷的人，我才不会同情呢！"
                                },
                                {
                                    "id": "412110411",
                                    "speaker": "？？？",
                                    "text": "谁！竟敢在我们的营地里撒野！"
                                },
                                {
                                    "id": "412110412",
                                    "speaker": "派蒙",
                                    "text": "呀，被发现了！"
                                }
                            ]
                        },
                        {
                            "id": "412110409",
                            "text": "难道这就是他们的命运吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121104",
            "objective": "击败来袭的敌人",
            "dialogues": []
        },
        {
            "id": "4121113",
            "objective": "（隐藏）愚人众开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4121109",
            "objective": "与阿贝多对话",
            "dialogues": []
        },
        {
            "id": "4121110",
            "objective": "调查地脉异常之地",
            "dialogues": []
        },
        {
            "id": "4121111",
            "objective": "击败来袭的怪物",
            "dialogues": []
        },
        {
            "id": "4121112",
            "objective": "与阿贝多对话",
            "dialogues": [
                {
                    "id": "412110301",
                    "speaker": "派蒙",
                    "text": "有什么感觉吗？",
                    "choices": [
                        {
                            "id": "412110302",
                            "text": "剑上的力量更强了。",
                            "response": [
                                {
                                    "id": "412110304",
                                    "speaker": "阿贝多",
                                    "text": "我有一个推测。"
                                },
                                {
                                    "id": "412110305",
                                    "speaker": "阿贝多",
                                    "text": "这把剑从敌人身上吸收力量后，会与这座雪山深处暗藏的杜林亡骸发生共鸣。"
                                },
                                {
                                    "id": "412110306",
                                    "speaker": "派蒙",
                                    "text": "哇…好像很厉害呀！"
                                },
                                {
                                    "id": "412110307",
                                    "speaker": "阿贝多",
                                    "text": "如果这一猜想成立，那么这座雪山上的怪物也可能与杜林的亡骸共鸣。"
                                },
                                {
                                    "id": "412110308",
                                    "speaker": "Player",
                                    "text": "为什么会跟龙的亡骸共鸣呢？"
                                },
                                {
                                    "id": "412110309",
                                    "speaker": "阿贝多",
                                    "text": "恐怕与这一带怪物的力量来源有关。"
                                },
                                {
                                    "id": "412110310",
                                    "speaker": "阿贝多",
                                    "text": "杜林不是一般的怪物。哪怕在它已经死亡的现在，整座雪山也依然受到它亡骸的影响。"
                                },
                                {
                                    "id": "412110311",
                                    "speaker": "阿贝多",
                                    "text": "神秘的龙之力…或许也是某种诅咒。"
                                },
                                {
                                    "id": "412110312",
                                    "speaker": "阿贝多",
                                    "text": "信息还是不够。想了解更多，就需要更多数据。这也正是我找你的原因。"
                                },
                                {
                                    "id": "412110313",
                                    "speaker": "派蒙",
                                    "text": "没想到，听故事也成了体力活呢…"
                                },
                                {
                                    "id": "412110314",
                                    "speaker": "阿贝多",
                                    "text": "我有些研究工作要收尾，得和你们分开行动了。之后在断桥附近会合吧。"
                                }
                            ]
                        },
                        {
                            "id": "412110303",
                            "text": "不同的呼应…却有着相同的流淌之力。"
                        }
                    ]
                }
            ]
        },
