    "talks": [
        {
            "id": "7466802",
            "objective": "(test)解锁任意七天神像$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7466801",
            "objective": "(test)与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "746680101",
                    "speaker": "派蒙",
                    "text": "咦，刚才七天神像是不是突然很夸张地亮了一下…"
                },
                {
                    "id": "746680102",
                    "speaker": "派蒙",
                    "text": "好奇怪，以前发生过这样的事吗？",
                    "choices": [
                        {
                            "id": "746680103",
                            "text": "七天神像发光很正常吧。",
                            "response": [
                                {
                                    "id": "746680107",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，没有觉得不舒服吧…",
                                    "choices": [
                                        {
                                            "id": "746680108",
                                            "text": "吔，水、水在对我说话…",
                                            "response": [
                                                {
                                                    "id": "746680109",
                                                    "speaker": "派蒙",
                                                    "text": "最好是能说啦！还有心情开玩笑，看来没什么问题嘛。"
                                                },
                                                {
                                                    "id": "746680112",
                                                    "speaker": "派蒙",
                                                    "text": "不过，确实在那阵光亮起来之后，周围的空气也变得稍微湿乎乎了一些，说不定也是刚才冒出的水元素力的功劳。"
                                                },
                                                {
                                                    "id": "746680113",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，听说在枫丹，如果能运用好元素力，就能够在水下畅游，说不定还能捡到掉在水里的宝藏呢。"
                                                },
                                                {
                                                    "id": "746680114",
                                                    "speaker": "派蒙",
                                                    "text": "打捞宝藏的工作，就交给你了，我…我就负责在岸上为你放风！",
                                                    "choices": [
                                                        {
                                                            "id": "746680115",
                                                            "text": "一个人下水，好寂寞…",
                                                            "response": [
                                                                {
                                                                    "id": "746680117",
                                                                    "speaker": "派蒙",
                                                                    "text": "呜，但是、但是水里很可怕嘛！"
                                                                },
                                                                {
                                                                    "id": "746680118",
                                                                    "speaker": "派蒙",
                                                                    "text": "说不定一个不小心，就会被卷入水流里，晕头转向，怎么都飞不起来。"
                                                                },
                                                                {
                                                                    "id": "746680119",
                                                                    "speaker": "派蒙",
                                                                    "text": "就像在蒙德遇到你之前那样…"
                                                                },
                                                                {
                                                                    "id": "746680120",
                                                                    "speaker": "Player",
                                                                    "text": "那我再把你钓上来好啦！"
                                                                },
                                                                {
                                                                    "id": "746680121",
                                                                    "speaker": "派蒙",
                                                                    "text": "…真的吗，那、那也不是不可以和你一起到水里去。哼，你可得说话算话哦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746680116",
                                                            "text": "可以出点力了派蒙！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746680110",
                                            "text": "哇！感觉可以用鳃呼吸！",
                                            "response": [
                                                {
                                                    "id": "746680111",
                                                    "speaker": "派蒙",
                                                    "text": "好啊，你先长个鳃出来看看吧。哼，看起来精神不错嘛，害我白担心了一小会儿。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746680105",
                            "text": "好像冒出了水？",
                            "response": [
                                {
                                    "id": "746680106",
                                    "speaker": "派蒙",
                                    "text": "不愧是水神的国度呢，连七天神像都会冒出水来…才怪啦，刚才那个光亮怎么想都不是正常反应。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}