        }
    },
    "talks": [
        {
            "id": "202401",
            "objective": "",
            "dialogues": [
                {
                    "id": "20240101",
                    "speaker": "八重神子",
                    "text": "刚才的话题是不是有些太过严肃了，你还是更喜欢被我捉弄吗？呵呵…",
                    "choices": [
                        {
                            "id": "20210301",
                            "text": "关于「人偶」将军…",
                            "response": [
                                {
                                    "id": "20210302",
                                    "speaker": "八重神子",
                                    "text": "「人偶」将军的技术源自于某些现今已然失落的知识，或许只有身为神明的她才能知会其中源头…"
                                },
                                {
                                    "id": "20210303",
                                    "speaker": "八重神子",
                                    "text": "不过…倒是有件事你们应该会感兴趣。"
                                },
                                {
                                    "id": "20210304",
                                    "speaker": "八重神子",
                                    "text": "在影开始对自己的神明之躯进行自我改造之前，还凭空创造过一个「原型人偶」…"
                                },
                                {
                                    "id": "20210305",
                                    "speaker": "派蒙",
                                    "text": "那、那难道有三个雷电将军！？"
                                },
                                {
                                    "id": "20210306",
                                    "speaker": "八重神子",
                                    "text": "不，那个原型只是为了验证可行性，外貌和智能都没有依托影的自身去设计，可以说算是试做品。"
                                },
                                {
                                    "id": "20210307",
                                    "speaker": "八重神子",
                                    "text": "按照最初设想，影应当将他直接废弃，但也许影认为这样做过于残酷，便选择只将他体内的力量封印。"
                                },
                                {
                                    "id": "20210308",
                                    "speaker": "八重神子",
                                    "text": "后来，他便像个普通人一样，凭借自我意识流浪在稻妻的土地上，直到…愚人众看中了他。"
                                },
                                {
                                    "id": "20210309",
                                    "speaker": "派蒙",
                                    "text": "愚人众！"
                                },
                                {
                                    "id": "20210310",
                                    "speaker": "八重神子",
                                    "text": "而那个原型人偶经过愚人众里某些奇人异士的调整，解除了力量的封印，甚至比封印之前更强大也说不定。"
                                },
                                {
                                    "id": "20210311",
                                    "speaker": "Player",
                                    "text": "莫非…"
                                },
                                {
                                    "id": "20210312",
                                    "speaker": "八重神子",
                                    "text": "嗯，神之造物亲手夺去了神之心…那个原型人偶便是如今的「散兵」。"
                                },
                                {
                                    "id": "20210313",
                                    "speaker": "派蒙",
                                    "text": "居、居然还有这样的事！"
                                },
                                {
                                    "id": "20210314",
                                    "speaker": "八重神子",
                                    "text": "是啊，究竟是机缘巧合，还是天命注定呢。",
                                    "choices": [
                                        {
                                            "id": "20210301",
                                            "text": "关于「人偶」将军…"
                                        },
                                        {
                                            "id": "20210401",
                                            "text": "关于前任雷电将军…",
                                            "response": [
                                                {
                                                    "id": "20210402",
                                                    "speaker": "八重神子",
                                                    "text": "你这个异乡人居然知道雷神曾经更易过的事…这在稻妻的国民之中也是鲜有人知的。"
                                                },
                                                {
                                                    "id": "20210403",
                                                    "speaker": "派蒙",
                                                    "text": "是摩拉克斯曾经提及过，雷神巴尔也已经逝去的事…"
                                                },
                                                {
                                                    "id": "20210404",
                                                    "speaker": "八重神子",
                                                    "text": "嗯，事实是这样的，「巴尔」与「巴尔泽布」其实是一对双生魔神。"
                                                },
                                                {
                                                    "id": "20210405",
                                                    "speaker": "派蒙",
                                                    "text": "双生…魔神？"
                                                },
                                                {
                                                    "id": "20210406",
                                                    "speaker": "八重神子",
                                                    "text": "她们共同赢下魔神战争，而后来巴尔建立幕府后，巴尔泽布则以御侧「影武者」的身份，成为巴尔的替身。"
                                                },
                                                {
                                                    "id": "20210407",
                                                    "speaker": "八重神子",
                                                    "text": "巴尔泽布便是你我熟悉的影，而巴尔，其名则为「真」。"
                                                },
                                                {
                                                    "id": "20210408",
                                                    "speaker": "八重神子",
                                                    "text": "在世人眼中，她们二者从来都是统一的存在，她们两人也一直相互补足，共同治理稻妻，因而民众也没有知晓真相的必要。"
                                                },
                                                {
                                                    "id": "20210409",
                                                    "speaker": "八重神子",
                                                    "text": "不论是「巴尔」这个魔神名讳，还是雷电将军这个称谓，其实一直都可以看做是同时指代她们两人的，直到…"
                                                },
                                                {
                                                    "id": "20210410",
                                                    "speaker": "派蒙",
                                                    "text": "直到？"
                                                },
                                                {
                                                    "id": "20210411",
                                                    "speaker": "八重神子",
                                                    "text": "直到真死于数百年前的一场我未能亲身经历的战争，自那以后影才来到了幕前。"
                                                },
                                                {
                                                    "id": "20210412",
                                                    "speaker": "派蒙",
                                                    "text": "一定对影的打击很大吧，是姐妹的话…",
                                                    "choices": [
                                                        {
                                                            "id": "20210413",
                                                            "text": "数百年前的…战争…",
                                                            "response": [
                                                                {
                                                                    "id": "20210415",
                                                                    "speaker": "八重神子",
                                                                    "text": "所以影的转变也是从那时开始的，对她来说这是最大的「失去」吧。"
                                                                },
                                                                {
                                                                    "id": "20210416",
                                                                    "speaker": "派蒙",
                                                                    "text": "原来还有这样的往事，好像更加理解影一些了…那么「真」是一个什么样的神呢？"
                                                                },
                                                                {
                                                                    "id": "20210417",
                                                                    "speaker": "八重神子",
                                                                    "text": "我与她相处的时间并不算长，印象里…是个温柔的神吧，总是珍惜着眼前的一切美好。"
                                                                },
                                                                {
                                                                    "id": "20210418",
                                                                    "speaker": "派蒙",
                                                                    "text": "这样啊…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "20210301",
                                                                            "text": "关于「人偶」将军…"
                                                                        },
                                                                        {
                                                                            "id": "20210401",
                                                                            "text": "关于前任雷电将军…"
                                                                        },
                                                                        {
                                                                            "id": "20210501",
                                                                            "text": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "20210502",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "抱歉，这个我没什么头绪，我对你们所说的那位神明也并不了解。"
                                                                                },
                                                                                {
                                                                                    "id": "20210503",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "但如果你们还在怀疑影的话，我觉得就有些多虑了。"
                                                                                },
                                                                                {
                                                                                    "id": "20210504",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "影不仅不符合你们之前的描述，而且很久以前便主动放弃神之心，断绝了与天空岛的联系。"
                                                                                },
                                                                                {
                                                                                    "id": "20210505",
                                                                                    "speaker": "Player",
                                                                                    "text": "见过以后，感觉确实不是她。"
                                                                                },
                                                                                {
                                                                                    "id": "20210506",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "那就好，不然的话，作为雷神眷属，好像我们的关系就会一下子微妙起来了？"
                                                                                },
                                                                                {
                                                                                    "id": "20210507",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "放心吧，我们不会想和你打架的！"
                                                                                },
                                                                                {
                                                                                    "id": "20210508",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "呵呵呵…祝你们早日达成目的，知晓一切真相吧。"
                                                                                },
                                                                                {
                                                                                    "id": "20210509",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "#至于你{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的踪迹，我会尽我所能利用一切资源去调查的，包括从绫人那里借用一些终末番的手下。"
                                                                                },
                                                                                {
                                                                                    "id": "20210510",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "有消息我会通知你，就算是酬谢的一部分吧。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "20210301",
                                                                                            "text": "关于「人偶」将军…"
                                                                                        },
                                                                                        {
                                                                                            "id": "20210401",
                                                                                            "text": "关于前任雷电将军…"
                                                                                        },
                                                                                        {
                                                                                            "id": "20210501",
                                                                                            "text": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                                                                                        },
                                                                                        {
                                                                                            "id": "20210601",
                                                                                            "text": "关于旅途的下一站…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "20210602",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "离开稻妻以后的话，我想…去往须弥应该会比较便利。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210603",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "须弥呀，我们一路上见过很多来自须弥的学者了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210604",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "嗯，须弥是智慧之神的国度，他们对智慧与知识的探求是永无止境的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210605",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "但这份执着往往也会衍生出一些令人费解的事，比如…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210606",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "…在须弥，知识是作为一种「资源」而被统一管理的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210607",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "知识…也是资源？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210608",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "嗯，只是不知道做出这种决定的究竟是那些「贤者」，还是「小吉祥草王」。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210609",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "「小吉祥草王」？有些可爱的名字呢。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210610",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "欸，原来你们还不清楚吗，「小吉祥草王」便是须弥所信仰的神明，是须弥人对她的爱称。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "20210611",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "想必你们也有些事情想要找她确认吧？祝你们顺利。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "20210301",
                                                                                                            "text": "关于「人偶」将军…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "20210401",
                                                                                                            "text": "关于前任雷电将军…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "20210501",
                                                                                                            "text": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "20210601",
                                                                                                            "text": "关于旅途的下一站…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "20210701",
                                                                                                            "text": "没什么想问的了。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "20210702",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "这样啊，那好吧。哦对了旅行者，我送给你的御守，你还留着吗？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210703",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "当然，我会好好保管的。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210704",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "好好保管，仅此而已吗？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210705",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "我还以为你会将它挂在胸前最显眼的位置，以后逢人便说，这可是兼具智慧与美貌的八重神子大人赠予我的。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210706",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "谁会那样做呀！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210707",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "呵呵…好了好了。说起来，旅行者，你的愿望又是什么呢？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210708",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "#嗯…与{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}再次团聚？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210709",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "这样吗…但我觉得，那或许只是你眼下的一个小小目标而已。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210710",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "对你来说，「愿望」应当是可以跨越尘世和星海，与命运一同闪耀之物。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210711",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "你没有神之眼，或许是因为那个愿望尚未诞生…也说不定呢。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "20210712",
                                                                                                                    "speaker": "八重神子",
                                                                                                                    "text": "就在你接下来的旅途中，去见证那一刻吧。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "20210701",
                                                                                            "text": "没什么想问的了。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "20210601",
                                                                            "text": "关于旅途的下一站…"
                                                                        },
                                                                        {
                                                                            "id": "20210701",
                                                                            "text": "没什么想问的了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20210414",
                                                            "text": "难道说…是坎瑞亚…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20210501",
                                            "text": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                                        },
                                        {
                                            "id": "20210601",
                                            "text": "关于旅途的下一站…"
                                        },
                                        {
                                            "id": "20210701",
                                            "text": "没什么想问的了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20210401",
                            "text": "关于前任雷电将军…"
                        },
                        {
                            "id": "20210501",
                            "text": "#关于我的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                        },
                        {
                            "id": "20210601",
                            "text": "关于旅途的下一站…"
                        },
                        {
                            "id": "20210701",
                            "text": "没什么想问的了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745040201",
                    "speaker": "阿尔邦",
                    "text": "你听说了吗？阿尔芒最近状态好像好多了，虽然人多的时候还会紧张，不过至少能表达意思了。"
                },
                {
                    "id": "745040202",
                    "speaker": "阿尔贝",
                    "text": "那还不错。要是话都说不完整，想当喜剧演员是肯定没戏的。"
                },
                {
                    "id": "745040203",
                    "speaker": "Player",
                    "text": "阿尔芒？"
                },
                {
                    "id": "745040204",
                    "speaker": "阿尔邦",
                    "text": "就是勒波特钟表店门口的那个店员。老爷您没见过他吗？"
                },
                {
                    "id": "745040205",
                    "speaker": "阿尔贝",
                    "text": "他跟我们是同一个村庄的，也是个想当喜剧演员的好小伙子，可惜，他有严重的口吃。"
                },
                {
                    "id": "745040206",
                    "speaker": "阿尔邦",
                    "text": "据说是小时候观看一场喜剧的时候，意外从看台摔了下来，脑袋落下了后遗症。"
                },
                {
                    "id": "745040207",
                    "speaker": "阿尔贝",
                    "text": "那场喜剧我本来很喜欢，名字叫「审判」。但现在总觉得有点爱不起来了。"
                },
                {
                    "id": "745040208",
                    "speaker": "阿尔邦",
                    "text": "志向成为喜剧演员的孩子在名为「审判」的喜剧中被审判了，惩罚是他再也当不了喜剧演员。"
                },
                {
                    "id": "745040209",
                    "speaker": "阿尔贝",
                    "text": "可怜的阿尔芒，他犯了什么罪？谁是审判官？"
                },
                {
                    "id": "745040210",
                    "speaker": "阿尔邦",
                    "text": "谁知道呢？"
                }
            ]
        },
        {
            "id": "7450403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745040301",
                    "speaker": "阿尔邦",
                    "text": "你看见留言板了吗？好像有人看上了那个发条企鹅。"
                },
                {
                    "id": "745040302",
                    "speaker": "阿尔贝",
                    "text": "看到了，是想要认识下菲米尼的那条吧？听口气，感觉还有点想进一步合作的意思。",
                    "choices": [
                        {
                            "id": "745040303",
                            "text": "菲米尼？",
                            "response": [
                                {
                                    "id": "745040305",
                                    "speaker": "阿尔邦",
                                    "text": "哦，就是摆在那边桌子上的发条玩具企鹅，是一个叫做菲米尼的潜水员做的。他放在我们店寄售。"
                                },
                                {
                                    "id": "745040306",
                                    "speaker": "阿尔贝",
                                    "text": "他是个好小伙子，有一张漂亮的脸蛋，说话轻声细语，做玩具的手艺还很棒。"
                                },
                                {
                                    "id": "745040307",
                                    "speaker": "阿尔邦",
                                    "text": "唯一就是，他看起来有点忧伤，就好像缺少了什么本该属于他的东西…"
                                },
                                {
                                    "id": "745040308",
                                    "speaker": "阿尔贝",
                                    "text": "那眼神我太清楚啦，和阿尔邦看他那空荡荡的钱包的眼神一模一样，他绝对是缺钱。"
                                },
                                {
                                    "id": "745040309",
                                    "speaker": "阿尔邦",
                                    "text": "别胡说，你忘了他来谈寄售的那天，都没说分成的事。这一看就不是冲着摩拉来的。"
                                },
                                {
                                    "id": "745040310",
                                    "speaker": "阿尔贝",
                                    "text": "这倒也是，但这种年纪的小伙子还能烦恼什么呢？"
                                },
                                {
                                    "id": "745040311",
                                    "speaker": "阿尔邦",
                                    "text": "话说回来，他确实挺讨人喜欢的，老板这还是头一回答应了寄售。"
                                },
                                {
                                    "id": "745040312",
                                    "speaker": "阿尔邦",
                                    "text": "不仅给安排了户外的摊位，也没占人便宜，主动提出了五五分成。"
                                },
                                {
                                    "id": "745040313",
                                    "speaker": "阿尔贝",
                                    "text": "可惜啊，最后卖的情况，只能说一般般吧。看的人不少，买的人不多。"
                                },
                                {
                                    "id": "745040314",
                                    "speaker": "阿尔贝",
                                    "text": "那个玩具的设计确实精巧，但可能正因为这样，上手的门槛也变高了，维修起来也不容易。"
                                },
                                {
                                    "id": "745040315",
                                    "speaker": "阿尔邦",
                                    "text": "没想到这次居然有人特地在留言板上留言。搞不好碰上大客户了呢。"
                                },
                                {
                                    "id": "745040316",
                                    "speaker": "阿尔贝",
                                    "text": "总之，回头记得提醒一下老板，好买卖可别弄丢了。"
                                }
                            ]
                        },
                        {
                            "id": "745040304",
                            "text": "发条企鹅？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745040401",
                    "speaker": "利弗",
                    "text": "北国银行那边有进展的话，我不会忘记通知两位贵客的。"
                },
                {
                    "id": "745040402",
                    "speaker": "Player",
                    "text": "阿尔邦和阿尔贝今天不在吗？"
                },
                {
                    "id": "745040403",
                    "speaker": "利弗",
                    "text": "他们两个请假了，说是有什么玩具的新点子。真是奇事。"
                },
                {
                    "id": "745040404",
                    "speaker": "利弗",
                    "text": "这两个家伙，平时满脑子都是他们的喜剧，对玩具可从没这么上心过。"
                },
                {
                    "id": "745040405",
                    "speaker": "利弗",
                    "text": "这回居然变性了，真不知道他们在想什么。"
                }
            ]
        },
        {
            "id": "7450502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745050201",
                    "speaker": "阿尔芒",
                    "text": "这个又…又简单…又…又好玩，试…试…试试吧？",
                    "choices": [
                        {
                            "id": "745050202",
                            "text": "开始吧。",
                            "response": [
                                {
                                    "id": "745050203",
                                    "speaker": "阿尔芒",
                                    "text": "祝…祝…祝两位…玩开心。"
                                }
                            ]
                        },
                        {
                            "id": "745050204",
                            "text": "等会再来。",
                            "response": [
                                {
                                    "id": "745050205",
                                    "speaker": "阿尔芒",
                                    "text": "好…好！什…什么时候来，我…我都在这。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}