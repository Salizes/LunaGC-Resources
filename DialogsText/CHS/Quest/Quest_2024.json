            "num": "第二章 第三幕",
            "title": "千手百眼，天下人间"
        },
        "total_dialogue_lines": 122,
        "total_speaker_counts": {
            "Player": 37,
            "八重神子": 41,
            "利弗": 4,
            "派蒙": 14,
            "阿尔芒": 3,
