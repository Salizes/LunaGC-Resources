            "dialogues": [
                {
                    "id": "752751601",
                    "speaker": "古盾上的刻痕",
                    "text": "…远方…隐约的建…"
                },
                {
                    "id": "752751602",
                    "speaker": "古盾上的刻痕",
                    "text": "…形…熟悉…来自…或…"
