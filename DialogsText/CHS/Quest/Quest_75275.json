            ]
        },
        {
            "id": "7527507",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750701",
                    "speaker": "石碑",
                    "text": "（一块古朴的石碑，其上的文字被磨损了大半——）"
                },
                {
                    "id": "752750702",
                    "speaker": "石碑",
                    "text": "…吾覆谜土，可蔽此宫…"
                },
                {
                    "id": "752750703",
                    "speaker": "石碑",
                    "text": "…启以英杰之遗…——修洛维兹"
                }
            ]
        },
        {
            "id": "7527509",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750901",
                    "speaker": "字迹潇洒的册子",
                    "text": "（一本年代较近的册子，仅留有行迹潇洒快意的几个字。）"
                },
                {
                    "id": "752750902",
                    "speaker": "字迹潇洒的册子",
                    "text": "业竟，坐而歌！——伊莎佳"
                }
            ]
        },
