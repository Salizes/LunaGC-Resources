        {
            "id": "7527508",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750801",
                    "speaker": "风蚀的册子",
                    "text": "（一本被风蚀严重的古老册子，仅有少数文字可以辨识——）"
                },
                {
                    "id": "752750802",
                    "speaker": "风蚀的册子",
                    "text": "…凝聚边界，隔绝烬海，非一代可为…"
                },
                {
                    "id": "752750803",
                    "speaker": "风蚀的册子",
                    "text": "…时日无多…将思虑置入圣火…后者勿忘…——柯夏尼娜"
                }
            ]
        },
        {
            "id": "7527503",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750301",
                    "speaker": "石碑",
                    "text": "（一块古朴的石碑，其上的文字被磨损了大半——）"
                },
                {
                    "id": "752750302",
                    "speaker": "石碑",
                    "text": "…巴窟纳瓦复苏…"
                },
                {
                    "id": "752750303",
                    "speaker": "石碑",
                    "text": "…在…归来前…需阻烬海…拦黑潮…"
                },
                {
                    "id": "752750304",
                    "speaker": "石碑",
                    "text": "…若身死功亦未成…后来者承之…——古洛哈莉"
                }
            ]
        },
        {
            "id": "7527502",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750201",
                    "speaker": "石碑",
                    "text": "（一块古朴的石碑，其上的文字被磨损了大半——）"
                },
                {
                    "id": "752750202",
                    "speaker": "石碑",
                    "text": "…基扬戈兹已去十余载…"
                },
                {
                    "id": "752750203",
                    "speaker": "石碑",
                    "text": "…大捷…"
                },
                {
                    "id": "752750204",
                    "speaker": "石碑",
                    "text": "…建此坛…慰英灵…"
                }
            ]
        },
        {
            "id": "7527506",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "752750601",
                    "speaker": "石碑",
                    "text": "（一块古朴的石碑，其上的文字已经不可辨识，依稀可以看出，底部留有某人的名字。）"
