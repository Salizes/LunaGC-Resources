            "dialogues": [
                {
                    "id": "191871897",
                    "speaker": "Player",
                    "text": "唔…好像有点忘了…"
                }
            ]
        },
        {
            "id": "1918719",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191871901",
                    "speaker": "夏沃蕾",
                    "text": "在警备队赶来之前，这里就由我们看管吧。放心，他们不会再有机会溜走了。",
                    "choices": [
                        {
                            "id": "191871902",
                            "text": "还有一些好奇的事…",
                            "response": [
                                {
                                    "id": "191871904",
                                    "speaker": "夏沃蕾",
                                    "text": "嗯…涉案原料还有很多正规用途，不只是能用来制备「仿制乐斯」，所以不会直接违禁。"
                                },
                                {
                                    "id": "191871905",
                                    "speaker": "夏沃蕾",
                                    "text": "港口一般会暂时扣留，等通过各种申报再允许过关，否则就退回原船。艾洛迪应该就是在退回之前，偷换了原料。"
                                },
                                {
                                    "id": "191871906",
                                    "speaker": "夏沃蕾",
                                    "text": "载着原料来的海外船只，多半也是她事先联系好的，所以收到了调换过的货品后，依旧心照不宣。"
                                },
                                {
                                    "id": "191871907",
                                    "speaker": "夏沃蕾",
                                    "text": "这些罪行我们还会继续追查。既然抓住了艾洛迪，剩下的也只是时间问题了。"
                                }
                            ]
                        },
                        {
                            "id": "191871903",
                            "text": "艾洛迪是怎么偷换原料的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1918720",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191872001",
                    "speaker": "林尼",
                    "text": "今天「认真模式」的运行时长算是破纪录了吧…还真少见，是因为谁呢？",
                    "choices": [
                        {
                            "id": "191872002",
                            "text": "还有一些好奇的事…",
                            "response": [
                                {
                                    "id": "191872004",
                                    "speaker": "林尼",
                                    "text": "唔…按之前查到的线索，「仿制乐斯」先是在枫丹小规模流通，后来才从小买卖变成大走私。"
                                },
                                {
                                    "id": "191872005",
                                    "speaker": "林尼",
                                    "text": "一开始流通的，应该是皮埃尔早期制备的存货。但他粗劣的犯罪，很快就被身为巡警的艾洛迪发现。"
                                },
                                {
                                    "id": "191872006",
                                    "speaker": "林尼",
                                    "text": "艾洛迪从中看到了能大量牟利，甚至改头换面、重新生活的机会，所以一边暗中掩饰他的早期罪行…"
                                },
                                {
                                    "id": "191872007",
                                    "speaker": "林尼",
                                    "text": "一边以贝努瓦的名义写信，用搜集的罪证和巨额的利润，威逼利诱皮埃尔配合她的后续计划吧。"
                                },
                                {
                                    "id": "191872008",
                                    "speaker": "林尼",
                                    "text": "可惜，遇到了琳妮特。别看她平时不喜欢想太多，「认真模式」下的她可比谁都敏锐。"
                                },
                                {
                                    "id": "191872009",
                                    "speaker": "林尼",
                                    "text": "…不过这个模式的「耗能」也很快。我们一会儿还要做笔录，陪她「充能」的事，可就交给你啦。"
                                }
                            ]
                        },
                        {
                            "id": "191872003",
                            "text": "皮埃尔是怎么入伙的？"
                        }
                    ]
                }
            ]
        }
    ]
}