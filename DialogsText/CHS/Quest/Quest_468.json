    },
    "talks": [
        {
            "id": "46801",
            "objective": "(test)对话NPC$HIDDEN",
            "dialogues": [
                {
                    "id": "4680201",
                    "speaker": "Player",
                    "text": "有什么可以帮忙的吗？"
                },
                {
                    "id": "4680202",
                    "speaker": "特纳",
                    "text": "你是…？"
                },
                {
                    "id": "4680203",
                    "speaker": "特纳",
                    "text": "…是旅行者啊，可真是个热心肠的好人！"
                },
                {
                    "id": "4680204",
                    "speaker": "特纳",
                    "text": "现在正是葡萄生长的关键时节，可不知道哪儿来的野猪，成群结队，盯上这块地盘啦。"
                },
                {
                    "id": "4680205",
                    "speaker": "特纳",
                    "text": "我一个人赶又赶不走，儿子现在又不在身边，只能眼睁睁看着它们在地里横冲直撞…"
                },
                {
                    "id": "4680206",
                    "speaker": "特纳",
                    "text": "你要是能帮忙给这些野猪一点儿教训的话，我特纳一定会好好答谢你的！"
                }
            ]
        },
        {
            "id": "46802",
            "objective": "(test)完成玩法$HIDDEN",
            "dialogues": []
        },
        {
            "id": "46801",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680101",
                    "speaker": "特纳",
                    "text": "好好的葡萄藤，就这样给糟蹋了…这些可恶的野猪…"
                }
            ]
        },
        {
            "id": "46803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680301",
                    "speaker": "Player",
                    "text": "我还有事…"
                },
                {
                    "id": "4680302",
                    "speaker": "特纳",
                    "text": "这样啊，那我只能等儿子休假回来，再教训这些坏东西了"
                }
            ]
        },
        {
            "id": "46804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680401",
                    "speaker": "特纳",
                    "text": "你好，客人。我儿子有没有从你那儿带来什么口信儿？",
                    "choices": [
                        {
                            "id": "4680601",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "4680602",
                                    "speaker": "特纳",
                                    "text": "我啊？酒庄里的伙计们都叫我老特纳，是这晨曦酒庄的农夫。"
                                },
                                {
                                    "id": "4680603",
                                    "speaker": "特纳",
                                    "text": "我们家祖祖辈辈都在耕这块地，如果你在这儿尝到过什么好葡萄酒，我敢说十有八九是这地里的葡萄酿的。"
                                },
                                {
                                    "id": "4680604",
                                    "speaker": "特纳",
                                    "text": "所以这酒庄历代的大老板，总是待我们家不薄，少不了吃的穿的。"
                                },
                                {
                                    "id": "4680605",
                                    "speaker": "特纳",
                                    "text": "可想到子子孙孙也都要这么种一辈子田，好像也不是什么好事…",
                                    "choices": [
                                        {
                                            "id": "4680601",
                                            "text": "你是？"
                                        },
                                        {
                                            "id": "4680701",
                                            "text": "你的儿子？",
                                            "response": [
                                                {
                                                    "id": "4680702",
                                                    "speaker": "特纳",
                                                    "text": "盖伊！他叫盖伊，我的宝贝儿子！"
                                                },
                                                {
                                                    "id": "4680703",
                                                    "speaker": "特纳",
                                                    "text": "什么？你没听说过这名字？哈哈，没关系，你迟早会知道他的，全蒙德都会知道他的…"
                                                },
                                                {
                                                    "id": "4680704",
                                                    "speaker": "特纳",
                                                    "text": "他会成为全蒙德最优秀的西风骑士，他就是这么跟我说的，我当然相信自己的儿子。"
                                                },
                                                {
                                                    "id": "4680705",
                                                    "speaker": "特纳",
                                                    "text": "唉，想想他小时候，为了不让他也像我这样种一辈子田，我可把全部心血都花在他身上啦。"
                                                },
                                                {
                                                    "id": "4680706",
                                                    "speaker": "特纳",
                                                    "text": "不过这小子果然很争气，十六岁就当上了见习骑士，我们家就要靠他翻身了…",
                                                    "choices": [
                                                        {
                                                            "id": "4680601",
                                                            "text": "你是？"
                                                        },
                                                        {
                                                            "id": "4680701",
                                                            "text": "你的儿子？"
                                                        },
                                                        {
                                                            "id": "4680801",
                                                            "text": "再见",
                                                            "response": [
                                                                {
                                                                    "id": "4680802",
                                                                    "speaker": "特纳",
                                                                    "text": "再见，如果见到我儿子盖伊，帮我跟他说，让他有空回来看看~！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4680801",
                                            "text": "再见"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4680701",
                            "text": "你的儿子？"
                        },
                        {
                            "id": "4680801",
                            "text": "再见"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680501",
                    "speaker": "特纳",
                    "text": "嗯？野猪好像还没驱赶完吧，你看那边还有…"
                }
            ]
        }
    ]
}