    "talks": [
        {
            "id": "2003401",
            "objective": "与安娜对话",
            "dialogues": [
                {
                    "id": "200340101",
                    "speaker": "安娜",
                    "text": "好…今天也要努力完成委托！",
                    "choices": [
                        {
                            "id": "200340102",
                            "text": "真是有干劲啊。",
                            "response": [
                                {
                                    "id": "200340103",
                                    "speaker": "安娜",
                                    "text": "那是当然了，做冒险家可是很有趣的。"
                                },
                                {
                                    "id": "200340104",
                                    "speaker": "安娜",
                                    "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。"
                                },
                                {
                                    "id": "200340105",
                                    "speaker": "安娜",
                                    "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。"
                                },
                                {
                                    "id": "200340108",
                                    "speaker": "安娜",
                                    "text": "那我们就快出发吧，今天的委托是…"
                                },
                                {
                                    "id": "200340109",
                                    "speaker": "安娜",
                                    "text": "嗯…又是护送货运热气球…"
                                }
                            ]
                        },
                        {
                            "id": "200340106",
                            "text": "要我陪你去吗？",
                            "response": [
                                {
                                    "id": "200340107",
                                    "speaker": "安娜",
                                    "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003402",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200340201",
                    "speaker": "班尼特",
                    "text": "菲谢尔，你刚才跑得太快了，很危险的…"
                },
                {
                    "id": "200340202",
                    "speaker": "菲谢尔",
                    "text": "本皇女的圣裁之雷，绝不会放任邪孽滋长…"
                },
                {
                    "id": "200340203",
                    "speaker": "安娜",
                    "text": "是菲谢尔前辈，还有班尼特前辈，你们好！"
                },
                {
                    "id": "200340204",
                    "speaker": "班尼特",
                    "text": "是安娜啊，还有旅行者，你们是在这里执行协会的委托吗？"
                },
                {
                    "id": "200340205",
                    "speaker": "菲谢尔",
                    "text": "喔！本皇女的祝圣之人啊，想来是命运的丝线，将你引至此地。"
                },
                {
                    "id": "200340206",
                    "speaker": "奥兹",
                    "text": "小姐很意外会在这种地方见到你，她很高兴。"
                },
                {
                    "id": "200340207",
                    "speaker": "Player",
                    "text": "我是陪着安娜出来执行委托的。"
                },
                {
                    "id": "200340208",
                    "speaker": "安娜",
                    "text": "是的，我和旅行者正在这里护送货运热气球呢。"
                },
                {
                    "id": "200340209",
                    "speaker": "安娜",
                    "text": "可是，突然看见有一群盗宝团朝我们冲了过来…"
                },
                {
                    "id": "200340210",
                    "speaker": "班尼特",
                    "text": "抱歉抱歉，这都要怪我…"
                },
                {
                    "id": "200340211",
                    "speaker": "班尼特",
                    "text": "原本我和菲谢尔接了委托，要追查一群盗宝团的下落…"
                },
                {
                    "id": "200340212",
                    "speaker": "班尼特",
                    "text": "奥兹好不容易捕捉了对方的去向，我们正准备去捉拿的时候…我被路上的树枝绊倒，一下子就摔了出去…"
                },
                {
                    "id": "200340213",
                    "speaker": "班尼特",
                    "text": "这伙盗宝团发现动静，掉头就跑，我们只能在后面一直追、一直追…"
                },
                {
                    "id": "200340214",
                    "speaker": "菲谢尔",
                    "text": "无须烦忧。苍紫的罚罪之光，注定裁断恶徒的命运。"
                },
                {
                    "id": "200340215",
                    "speaker": "奥兹",
                    "text": "但小姐，真正出手抓住恶徒的，是旅行者…"
                },
                {
                    "id": "200340216",
                    "speaker": "菲谢尔",
                    "text": "奥，奥兹！"
                },
                {
                    "id": "200340217",
                    "speaker": "班尼特",
                    "text": "话，话说回来，这次真要好好谢谢你们了，多亏有你们在前面拦着！"
                },
                {
                    "id": "200340218",
                    "speaker": "班尼特",
                    "text": "看来，我今天的运气还是挺好的嘛。"
                },
                {
                    "id": "200340219",
                    "speaker": "Player",
                    "text": "能帮上忙就好。"
                },
                {
                    "id": "200340220",
                    "speaker": "班尼特",
                    "text": "嘿嘿，那我们先带着这群盗宝团回协会去了，你们执行委托路上也要小心啊，尤其是注意脚下！"
                }
            ]
        },
        {
            "id": "2003403",
            "objective": "与安娜一同完成冒险家协会的委托",
            "dialogues": [
                {
                    "id": "200340301",
                    "speaker": "安娜",
                    "text": "班尼特前辈，还是一如既往地可靠呢。"
                },
                {
                    "id": "200340302",
                    "speaker": "安娜",
                    "text": "菲谢尔前辈…她说的话也一如既往地很有气势！",
                    "choices": [
                        {
                            "id": "200340303",
                            "text": "关于班尼特。",
                            "response": [
                                {
                                    "id": "200340304",
                                    "speaker": "安娜",
                                    "text": "你说班尼特前辈？"
                                },
                                {
                                    "id": "200340305",
                                    "speaker": "安娜",
                                    "text": "我刚进入协会的时候，班尼特前辈给我解答了很多问题，也帮了我不少忙。"
                                },
                                {
                                    "id": "200340306",
                                    "speaker": "安娜",
                                    "text": "但我听说，班尼特前辈的运气一直很差。"
                                },
                                {
                                    "id": "200340307",
                                    "speaker": "安娜",
                                    "text": "真是不公平啊，明明是那么好的人…"
                                },
                                {
                                    "id": "200340313",
                                    "speaker": "安娜",
                                    "text": "呼…这样子委托也完成了，谢谢你旅行者，我这就回去协会报告啦。"
                                },
                                {
                                    "id": "200340314",
                                    "speaker": "安娜",
                                    "text": "不过，为什么我连续几天都是在护送热气球…协会里没有别的委托了吗…"
                                }
                            ]
                        },
                        {
                            "id": "200340308",
                            "text": "关于菲谢尔。",
                            "response": [
                                {
                                    "id": "200340309",
                                    "speaker": "安娜",
                                    "text": "菲谢尔前辈…嗯…"
                                },
                                {
                                    "id": "200340310",
                                    "speaker": "安娜",
                                    "text": "她、她也很可靠喔！箭法很好，也执行过很多委托。"
                                },
                                {
                                    "id": "200340311",
                                    "speaker": "安娜",
                                    "text": "虽然她说的那些话…我不太能听懂…"
                                },
                                {
                                    "id": "200340312",
                                    "speaker": "安娜",
                                    "text": "但她也是一位…一位很有经验的冒险家！不、不对，调查员！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003404",
            "objective": "击退盗宝团",
            "dialogues": [
                {
                    "id": "200340401",
                    "speaker": "安东尼",
                    "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…"
                },
                {
                    "id": "200340402",
                    "speaker": "Player",
                    "text": "你不希望她做冒险家吗？"
                },
                {
                    "id": "200340403",
                    "speaker": "安东尼",
                    "text": "……"
                },
                {
                    "id": "200340404",
                    "speaker": "安东尼",
                    "text": "我尊重我妹妹的梦想。"
                },
                {
                    "id": "200340405",
                    "speaker": "安东尼",
                    "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。"
                },
                {
                    "id": "200340406",
                    "speaker": "安东尼",
                    "text": "作为她的哥哥，我…会全力支持她。"
                },
                {
                    "id": "200340407",
                    "speaker": "安东尼",
                    "text": "就这样。"
                }
            ]
        },
