    "talks": [
        {
            "id": "7211301",
            "objective": "（test）抽签引导（废弃）$HIDDEN",
            "dialogues": [
                {
                    "id": "721130101",
                    "speaker": "玄冬林檎",
                    "text": "你要求签？"
                },
                {
                    "id": "721130102",
                    "speaker": "派蒙",
                    "text": "呜哇，好冷淡。"
                },
                {
                    "id": "721130103",
                    "speaker": "Player",
                    "text": "我想求签…"
                },
                {
                    "id": "721130104",
                    "speaker": "玄冬林檎",
                    "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。"
                },
                {
                    "id": "721130105",
                    "speaker": "Player",
                    "text": "记得是叫「御神签箱」…"
                },
                {
                    "id": "721130106",
                    "speaker": "玄冬林檎",
                    "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。"
                },
                {
                    "id": "721130107",
                    "speaker": "Player",
                    "text": "好像叫「御神签」来着…"
                },
                {
                    "id": "721130108",
                    "speaker": "玄冬林檎",
                    "text": "这种事情怎样都好吧。"
                },
                {
                    "id": "721130109",
                    "speaker": "派蒙",
                    "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？"
                },
                {
                    "id": "721130110",
                    "speaker": "玄冬林檎",
                    "text": "是命运让你抽到凶签，你还想怎样？啊？"
                },
                {
                    "id": "721130111",
                    "speaker": "派蒙",
                    "text": "欸！"
                },
                {
                    "id": "721130112",
                    "speaker": "Player",
                    "text": "外头那个像架子的东西…"
                },
                {
                    "id": "721130113",
                    "speaker": "玄冬林檎",
                    "text": "啧。"
                },
                {
                    "id": "721130114",
                    "speaker": "派蒙",
                    "text": "她很露骨地「啧」了耶！"
                },
                {
                    "id": "721130115",
                    "speaker": "玄冬林檎",
                    "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。"
                },
                {
                    "id": "721130116",
                    "speaker": "玄冬林檎",
                    "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。"
                },
                {
                    "id": "721130117",
                    "speaker": "玄冬林檎",
                    "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。"
                },
                {
                    "id": "721130118",
                    "speaker": "派蒙",
                    "text": "虽然感觉哪里好像怪怪的…"
                },
                {
                    "id": "721130119",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们求签吧！"
                }
            ]
        },
        {
            "id": "7211302",
            "objective": "（test）第一次抽到大吉$HIDDEN",
            "dialogues": [
                {
                    "id": "721130201",
                    "speaker": "派蒙",
                    "text": "我瞧瞧我瞧瞧…"
                },
                {
                    "id": "721130202",
                    "speaker": "派蒙",
                    "text": "哇！写着「大吉」耶！"
                },
                {
                    "id": "721130203",
                    "speaker": "派蒙",
                    "text": "看来今天是派蒙的幸运日！"
                },
                {
                    "id": "721130204",
                    "speaker": "Player",
                    "text": "你的？"
                },
                {
                    "id": "721130205",
                    "speaker": "派蒙",
                    "text": "没错！你的幸福就是派蒙的幸福呀！所以反过来说，派蒙幸福，你也幸福。"
                },
                {
                    "id": "721130206",
                    "speaker": "派蒙",
                    "text": "我吃到好吃的就会幸福。所以，为了你自己的幸福，请给我吃好吃的。"
                }
            ]
        },
        {
            "id": "7211303",
            "objective": "（test）第一次抽到大吉、凶以外的东西1$HIDDEN",
            "dialogues": [
                {
                    "id": "721130301",
                    "speaker": "派蒙",
                    "text": "我瞧瞧我瞧瞧…"
                },
                {
                    "id": "721130302",
                    "speaker": "派蒙",
                    "text": "嗯，还不错嘛。"
                },
                {
                    "id": "721130303",
                    "speaker": "派蒙",
                    "text": "和派蒙在一起，一定会幸运的！"
                }
            ]
        },
        {
            "id": "7211304",
            "objective": "（test）第一次抽到凶$HIDDEN",
            "dialogues": [
                {
                    "id": "721130401",
                    "speaker": "派蒙",
                    "text": "我瞧瞧我瞧瞧…"
                },
                {
                    "id": "721130402",
                    "speaker": "派蒙",
                    "text": "欸，是「凶」！"
                },
                {
                    "id": "721130403",
                    "speaker": "派蒙",
                    "text": "这种情况我记得！是说…「把凶签捆到『御签挂』上。」"
                },
                {
                    "id": "721130404",
                    "speaker": "派蒙",
                    "text": "「然后请派蒙吃好吃的，就可以逢凶化吉。」"
                },
                {
                    "id": "721130405",
                    "speaker": "Player",
                    "text": "是这样喔？"
                },
                {
                    "id": "721130406",
                    "speaker": "派蒙",
                    "text": "当然了！你要质疑古人的智慧吗？"
                },
                {
                    "id": "721130407",
                    "speaker": "派蒙",
                    "text": "古人的智慧真了不起哪！总之，先找找御签挂吧！"
                }
            ]
        },
        {
            "id": "7211305",
            "objective": "（test）第一次抽到大吉、凶以外的东西2$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211306",
            "objective": "（test）判定大凶成就$HIDDEN",
            "dialogues": [
                {
                    "id": "721130601",
                    "speaker": "派蒙",
                    "text": "嗯？这是什么？好像是什么人的手记，我看看…"
                },
                {
                    "id": "721130602",
                    "speaker": "派蒙",
                    "text": "「…终末…愚人众…暗算…」"
                },
                {
                    "id": "721130603",
                    "speaker": "派蒙",
                    "text": "这是什么呀，乱七八糟的，都是污渍。根本看不清。"
                },
                {
                    "id": "721130604",
                    "speaker": "Player",
                    "text": "可能是宝藏的线索。"
                },
                {
                    "id": "721130605",
                    "speaker": "派蒙",
                    "text": "有道理！我再看看。"
                },
                {
                    "id": "721130606",
                    "speaker": "派蒙",
                    "text": "「…解签的时候，暗号…」",
                    "choices": [
                        {
                            "id": "721130607",
                            "text": "解签？",
                            "response": [
                                {
                                    "id": "721130609",
                                    "speaker": "派蒙",
                                    "text": "我看看…「…上半是『胧夜正中』…」"
                                },
                                {
                                    "id": "721130610",
                                    "speaker": "派蒙",
                                    "text": "到这里就断开了，不知道下半是什么。"
                                },
                                {
                                    "id": "721130611",
                                    "speaker": "派蒙",
                                    "text": "不过既然会用到暗号，背后一定隐藏着什么秘密吧？"
                                },
                                {
                                    "id": "721130612",
                                    "speaker": "派蒙",
                                    "text": "好在意啊。下次去鸣神大社解签的时候，要不要试着对对暗号？"
                                }
                            ]
                        },
                        {
                            "id": "721130608",
                            "text": "暗号？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211315",
            "objective": "（test）回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211307",
            "objective": "（test）暗号获得Talk$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211312",
            "objective": "（test）暗号获得回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "721131101",
                    "speaker": "派蒙",
                    "text": "#（喂，{NICKNAME}！）"
                },
                {
                    "id": "721131102",
                    "speaker": "派蒙",
                    "text": "（这个玄冬小姐，按照那个玄冬小姐说的…）"
                },
                {
                    "id": "721131103",
                    "speaker": "Player",
                    "text": "（嗯，愚人众的冒牌货。）"
                },
                {
                    "id": "721131104",
                    "speaker": "「玄冬林檎」",
                    "text": "啊呀，又见面了。今天也要来看看运势吗？还是说…"
                },
                {
                    "id": "721131105",
                    "speaker": "「玄冬林檎」",
                    "text": "如果有什么想倾诉、想找人商量的事，我也能听您讲喔。",
                    "choices": [
                        {
                            "id": "721131106",
                            "text": "只是路过而已。",
                            "response": [
                                {
                                    "id": "721131108",
                                    "speaker": "派蒙",
                                    "text": "玄冬小姐好亲切喔！"
                                },
                                {
                                    "id": "721131109",
                                    "speaker": "「玄冬林檎」",
                                    "text": "是这样吗？呵呵，最近经常有人这么夸我呢。感觉好开心。"
                                },
                                {
                                    "id": "721131110",
                                    "speaker": "「玄冬林檎」",
                                    "text": "在这样漂亮的神社工作，一直是我的梦想。"
                                },
                                {
                                    "id": "721131111",
                                    "speaker": "Player",
                                    "text": "（她是愚人众假扮的。）"
                                },
                                {
                                    "id": "721131112",
                                    "speaker": "派蒙",
                                    "text": "（唔…但是，她比较亲切耶…）",
                                    "choices": [
                                        {
                                            "id": "721131113",
                                            "text": "（不能掉以轻心。）",
                                            "response": [
                                                {
                                                    "id": "721131115",
                                                    "speaker": "「玄冬林檎」",
                                                    "text": "#那么，{NICKNAME}，今天找我有什么事吗？",
                                                    "choices": [
                                                        {
                                                            "id": "721131116",
                                                            "text": "我只是来看你的。",
                                                            "response": [
                                                                {
                                                                    "id": "721131117",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "我…欸？啊，欸？不、不好意思，我不太明白您、您您的意思…"
                                                                },
                                                                {
                                                                    "id": "721131118",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "请、请让我冷静一下…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721131119",
                                                            "text": "没什么事。",
                                                            "response": [
                                                                {
                                                                    "id": "721131120",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "我明白了。有什么问题随时来找我喔。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721131114",
                                            "text": "（等玄冬小姐联络吧。）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721131107",
                            "text": "谢谢，不用了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211308",
            "objective": "（test）第一次对暗号获取后Talk第一环$HIDDEN",
            "dialogues": [
                {
                    "id": "721130801",
                    "speaker": "派蒙",
                    "text": "咦？玄冬小姐到哪去了？"
                },
                {
                    "id": "721130802",
                    "speaker": "Player",
                    "text": "有点担心…"
                },
                {
                    "id": "721130803",
                    "speaker": "派蒙",
                    "text": "是啊，万一她不回来，我要怎么看今天的运势呢。"
                },
                {
                    "id": "721130804",
                    "speaker": "派蒙",
                    "text": "咦？这里有一张签条。我看看…"
                },
                {
                    "id": "721130805",
                    "speaker": "Player",
                    "text": "不太好吧…"
                },
                {
                    "id": "721130806",
                    "speaker": "派蒙",
                    "text": "有什么关系嘛！说不定是线索呢！"
                },
                {
                    "id": "721130807",
                    "speaker": "派蒙",
                    "text": "咦？这是…"
                },
                {
                    "id": "721130808",
                    "speaker": "派蒙",
                    "text": "好像是要我们到这个地方，接受进一步指示的样子…？"
                },
                {
                    "id": "721130809",
                    "speaker": "派蒙",
                    "text": "我们去看看吧！"
                }
            ]
        },
        {
            "id": "7211314",
            "objective": "（test）第一次对暗号获取后Talk第二环$HIDDEN",
            "dialogues": [
                {
                    "id": "721130701",
                    "speaker": "派蒙",
                    "text": "玄冬小姐的态度还是老样子…不管怎样，先看看签文吧。"
                },
                {
                    "id": "721130702",
                    "speaker": "派蒙",
                    "text": "咦？这是…"
                },
                {
                    "id": "721130703",
                    "speaker": "派蒙",
                    "text": "我明白了，这是需要对付的坏蛋吧！"
                },
                {
                    "id": "721130704",
                    "speaker": "派蒙",
                    "text": "嗯嗯，原来如此。原来玄冬小姐是谍报人员，通过这种方式接头，扫除对稻妻不利的人。"
                },
                {
                    "id": "721130705",
                    "speaker": "玄冬林檎",
                    "text": "好吵。"
                },
                {
                    "id": "721130706",
                    "speaker": "派蒙",
                    "text": "噫！对、对不起！不要对我们降下「终末」！"
                },
                {
                    "id": "721130707",
                    "speaker": "玄冬林檎",
                    "text": "赶紧走开。"
                },
                {
                    "id": "721130708",
                    "speaker": "派蒙",
                    "text": "我们这就走！到画里的地方看看，能不能找到目标！"
                }
            ]
        },
        {
            "id": "7211319",
            "objective": "（test）炎刀后回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7211309",
