    "talks": [
        {
            "id": "1200701",
            "objective": "前往笔记中记载的地点",
            "dialogues": [
                {
                    "id": "120070101",
                    "speaker": "派蒙",
                    "text": "这就是高人的居所吗？"
                },
                {
                    "id": "120070102",
                    "speaker": "派蒙",
                    "text": "呜…怎么感觉凉飕飕的呀…真有人住在这里吗？"
                },
                {
                    "id": "120070103",
                    "speaker": "神里绫华",
                    "text": "我、我也觉得有点意外…"
                },
                {
                    "id": "120070104",
                    "speaker": "神里绫华",
                    "text": "奇怪，笔记上说的确实是这里没错啊，难道说…",
                    "choices": [
                        {
                            "id": "120070105",
                            "text": "也许我们搞错了。",
                            "response": [
                                {
                                    "id": "120070107",
                                    "speaker": "神里绫华",
                                    "text": "呜…内心有点动摇…"
                                },
                                {
                                    "id": "120070108",
                                    "speaker": "神里绫华",
                                    "text": "不过既然已经走到这里，我认为，我们还是应该进去一探究竟。"
                                },
                                {
                                    "id": "120070109",
                                    "speaker": "派蒙",
                                    "text": "嗯，也有道理，万一有什么惊喜呢？"
                                },
                                {
                                    "id": "120070110",
                                    "speaker": "派蒙",
                                    "text": "对了，那本笔记上是怎么说的呀？"
                                },
                                {
                                    "id": "120070111",
                                    "speaker": "神里绫华",
                                    "text": "我想想…"
                                },
                                {
                                    "id": "120070112",
                                    "speaker": "神里绫华",
                                    "text": "「鹤衔来<color=#00E1FFFF>一</color>朵装饰发梢的鲜花，白兔将<color=#00E1FFFF>四</color>片月光缝成裙摆，我打扮得当，<color=#00E1FFFF>向着东方</color>喊了<color=#00E1FFFF>七</color>声椿的名字，转眼便站在去往她家的小径上。」"
                                },
                                {
                                    "id": "120070113",
                                    "speaker": "派蒙",
                                    "text": "好像童话故事一样…难道说，只要这样做，「椿」就会来迎接你妈妈？"
                                },
                                {
                                    "id": "120070114",
                                    "speaker": "Player",
                                    "text": "越来越像仙人了。"
                                },
                                {
                                    "id": "120070115",
                                    "speaker": "神里绫华",
                                    "text": "总觉得，也像是某种暗号…"
                                },
                                {
                                    "id": "120070116",
                                    "speaker": "神里绫华",
                                    "text": "我们靠近一点再做判断吧。"
                                },
                                {
                                    "id": "120070117",
                                    "speaker": "派蒙",
                                    "text": "嗯！"
                                }
                            ]
                        },
                        {
                            "id": "120070106",
                            "text": "说不定是狐狸神使？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200702",
            "objective": "与神里绫华对话",
            "dialogues": []
        },
        {
            "id": "1200711",
            "objective": "(test)【隐藏】开门3对$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200710",
            "objective": "(test)【隐藏】开门2对$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200703",
            "objective": "根据提示探查可疑之处",
            "dialogues": [
                {
                    "id": "120070301",
                    "speaker": "神里绫华",
                    "text": "到这里就可以了。"
                },
                {
                    "id": "120070302",
                    "speaker": "派蒙",
                    "text": "快看看笔记里写了什么！"
                },
                {
                    "id": "120070303",
                    "speaker": "派蒙",
                    "text": "呜~会不会是神秘宝藏呀，好期待！"
                },
                {
                    "id": "120070304",
                    "speaker": "Player",
                    "text": "派蒙。"
                },
                {
                    "id": "120070305",
                    "speaker": "派蒙",
                    "text": "怎么了？突然那么小声，搞得我也紧张起来了…"
                },
                {
                    "id": "120070306",
                    "speaker": "Player",
                    "text": "我们到边上去吧。"
                },
                {
                    "id": "120070307",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "120070308",
                    "speaker": "派蒙",
                    "text": "原来是不想打扰绫华看笔记啊，看来，那本笔记真是有来头的东西。"
                },
                {
                    "id": "120070309",
                    "speaker": "派蒙",
                    "text": "不过看她的神情…多半不是藏宝图了。"
                },
                {
                    "id": "120070310",
                    "speaker": "派蒙",
                    "text": "唔，里面会有什么呢？"
                },
                {
                    "id": "120070311",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "120070312",
                    "speaker": "神里绫华",
                    "text": "呼。"
                },
                {
                    "id": "120070313",
                    "speaker": "神里绫华",
                    "text": "旅行者，派蒙，抱歉让你们久等了。"
                },
                {
                    "id": "120070314",
                    "speaker": "派蒙",
                    "text": "才一小会儿，你已经看得很快啦！"
                },
                {
                    "id": "120070315",
                    "speaker": "Player",
                    "text": "笔记看完了吗？"
                },
                {
                    "id": "120070316",
                    "speaker": "神里绫华",
                    "text": "嗯，看完了哦。"
                },
                {
                    "id": "120070317",
                    "speaker": "神里绫华",
                    "text": "我想，我应当和你们分享这本笔记的真相。"
                },
                {
                    "id": "120070318",
                    "speaker": "神里绫华",
                    "text": "虽然，里面的内容跟我想的完全不同就是了…"
                },
                {
                    "id": "120070319",
                    "speaker": "派蒙",
                    "text": "不同？这不是狐狸神使的笔记吗？"
                },
                {
                    "id": "120070320",
                    "speaker": "神里绫华",
                    "text": "不是狐狸神使。"
                },
                {
                    "id": "120070321",
                    "speaker": "神里绫华",
                    "text": "「椿」的真身…"
                },
                {
                    "id": "120070322",
                    "speaker": "神里绫华",
                    "text": "就是我的母亲。"
                },
                {
                    "id": "120070323",
                    "speaker": "派蒙",
                    "text": "哎？！"
                },
                {
                    "id": "120070324",
                    "speaker": "神里绫华",
                    "text": "很惊讶对吧？我、我也很惊讶…但这本笔记一开始便这样写了。"
                },
                {
                    "id": "120070325",
                    "speaker": "神里绫华",
                    "text": "「椿与平时的我既相同又不同，作为椿时，我不是神里华代，而是一个最最平凡的女子。」"
                },
                {
                    "id": "120070326",
                    "speaker": "神里绫华",
                    "text": "「以下所有，仅仅是一个普通的我所记录的生活琐事罢了。」"
                },
                {
                    "id": "120070327",
                    "speaker": "神里绫华",
                    "text": "笔记中写的，大多是母亲平日里私密又琐碎的小心思…那些我们以为与「椿」有关的事，也是属于她的想法。"
                },
                {
                    "id": "120070328",
                    "speaker": "派蒙",
                    "text": "意思是说，设计图纸跟异国料理…"
                },
                {
                    "id": "120070329",
                    "speaker": "神里绫华",
                    "text": "嗯，都是我母亲想要尝试的东西。"
                },
                {
                    "id": "120070330",
                    "speaker": "神里绫华",
                    "text": "或许对你们来说有些奇怪，但作为我而言，非常能够理解母亲的这种行为。"
                },
                {
                    "id": "120070331",
                    "speaker": "神里绫华",
                    "text": "倒不如说，其实…其实我自己也有这样的一面…"
                },
                {
                    "id": "120070332",
                    "speaker": "神里绫华",
                    "text": "看笔记的时候甚至有些不知所措，就好像是我的一些想法被人看穿了、写到笔记上一样…"
                },
                {
                    "id": "120070333",
                    "speaker": "派蒙",
                    "text": "绫华…"
                },
                {
                    "id": "120070334",
                    "speaker": "神里绫华",
                    "text": "母亲嫁给我父亲之后，就一直作为神里家的主母掌管各项事宜。社奉行身份相对尊贵，需要打点的方面非常多。"
                },
                {
                    "id": "120070335",
                    "speaker": "神里绫华",
                    "text": "不仅如此，她的一举一动都代表着神里家族。人们总是注视着她，在这种情况下，她一定没有太多时间去做自己想做的事…"
                },
                {
                    "id": "120070336",
                    "speaker": "神里绫华",
                    "text": "父母过世后，我和哥哥接手了神里家的一切。期间遇到的许多困难，可能对外人来说有些难以想象…"
                },
                {
                    "id": "120070337",
                    "speaker": "神里绫华",
                    "text": "每当我遇到麻烦事，总是会想：母亲当年是否也这样做过？这样的事，她会怎么处理呢？"
                },
                {
                    "id": "120070338",
                    "speaker": "神里绫华",
                    "text": "或许，真是太久没见她了吧。不知不觉中，就连我的记忆里也几乎只剩下母亲威严和高贵的一面。"
                },
                {
                    "id": "120070339",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "120070340",
                    "speaker": "神里绫华",
                    "text": "但…这是不对的。"
                },
                {
                    "id": "120070341",
                    "speaker": "神里绫华",
                    "text": "当我看到这本笔记，就意识到了…她和我完全一样，无论我们背负着怎样的职责，也都只是一介普通人而已。"
                },
                {
                    "id": "120070342",
                    "speaker": "神里绫华",
                    "text": "喜欢漂亮的着物，想要尝试每个地区的美食，渴望不曾见过的美景…"
                },
                {
                    "id": "120070343",
                    "speaker": "神里绫华",
                    "text": "也许你们听见这样的话会笑话我不够成熟，但…我确实也有这样的想法。不是作为神里绫华，而是作为一个普通的女孩去生活。"
                },
                {
                    "id": "120070344",
                    "speaker": "神里绫华",
                    "text": "母亲写到，她一直想参加稻妻本地的民间祭典。她说，天气晴朗的夜晚，自家中向远方眺望，偶尔能看见祭典的灯火。"
                },
                {
                    "id": "120070345",
                    "speaker": "神里绫华",
                    "text": "我也看到过哦！非常热闹，人很多，灯笼里的火非常明亮，能照亮大片夜空…有时我们还要操心那里的治安问题呢。"
                },
                {
                    "id": "120070346",
                    "speaker": "神里绫华",
                    "text": "只是，以我们的身份，贸然参加祭典或许并不合礼数。尤其在我父母的时代，社奉行与民众的关系还没有那么亲近…"
                },
                {
                    "id": "120070347",
                    "speaker": "神里绫华",
                    "text": "就算没有人限制我们，社奉行的人突然出现在人群中，大家多少也会投来异样的眼光吧。会想着，我们去那里是要做什么呢？"
                },
                {
                    "id": "120070348",
                    "speaker": "神里绫华",
                    "text": "母亲说，她不想让别人感到拘谨，希望大家尽情享受祭典的快乐与自由…她不愿打扰别人，也没有那么多闲暇，便一次都没有去过了。"
                },
                {
                    "id": "120070349",
                    "speaker": "派蒙",
                    "text": "原来是这样…所以那张设计图纸上画的是她打算穿去祭典的衣服吗？"
                },
                {
                    "id": "120070350",
                    "speaker": "神里绫华",
                    "text": "是的。祭典上有时会售卖异国料理，那些也是她想要尝试的东西。"
                },
                {
                    "id": "120070351",
                    "speaker": "神里绫华",
                    "text": "说来有些冒昧，但…真没想到我的妈妈也有这么少女心的一面呢，哈哈哈。"
                },
                {
                    "id": "120070352",
                    "speaker": "派蒙",
                    "text": "才不冒昧呢，我认为，你妈妈是个可爱又有责任心的人！"
                },
                {
                    "id": "120070353",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "120070354",
                    "speaker": "神里绫华",
                    "text": "不知不觉中，我为母亲完成了一些愿望。唯独去祭典一事，我无法替她完成。"
                },
                {
                    "id": "120070355",
                    "speaker": "神里绫华",
                    "text": "似乎…也没有机会见到她完成这件事了呢。",
                    "choices": [
                        {
                            "id": "120070356",
                            "text": "你已经做得很棒了。",
                            "response": [
                                {
                                    "id": "120070358",
                                    "speaker": "神里绫华",
                                    "text": "嗯，我明白。"
                                },
                                {
                                    "id": "120070359",
                                    "speaker": "神里绫华",
                                    "text": "…谢谢你们，我好像明白了一些事呢。"
                                },
                                {
                                    "id": "120070360",
                                    "speaker": "神里绫华",
                                    "text": "母亲和我，在某些方面是完全一样的。她所面临的事，同样也是我将要面对的事。"
                                },
                                {
                                    "id": "120070361",
                                    "speaker": "神里绫华",
                                    "text": "她把无法实现的事寄托在「椿」身上，而我…已经下定决心了。"
                                },
                                {
                                    "id": "120070362",
                                    "speaker": "派蒙",
                                    "text": "咦！难道你也要…"
                                },
                                {
                                    "id": "120070363",
                                    "speaker": "神里绫华",
                                    "text": "不，我…"
                                },
                                {
                                    "id": "120070364",
                                    "speaker": "神里绫华",
                                    "text": "我不打算用这样的方式。我想…我有了新的目标，我会不留遗憾地度过每一天。"
                                },
                                {
                                    "id": "120070365",
                                    "speaker": "神里绫华",
                                    "text": "那个…旅行者，我…呃…"
                                },
                                {
                                    "id": "120070366",
                                    "speaker": "神里绫华",
                                    "text": "呼…放松，放松…"
                                },
                                {
                                    "id": "120070367",
                                    "speaker": "神里绫华",
                                    "text": "你对我们这里的祭典有兴趣吗？"
                                },
                                {
                                    "id": "120070368",
                                    "speaker": "派蒙",
                                    "text": "从看到海报开始，我就一直想去哦！绫华是不是也有兴趣？"
                                },
                                {
                                    "id": "120070369",
                                    "speaker": "Player",
                                    "text": "绫华，你也没去过祭典吗？"
                                },
                                {
                                    "id": "120070370",
                                    "speaker": "神里绫华",
                                    "text": "啊啊，请不要笑话我！我、我也曾担心过那些事…不过，已经不要紧了。"
                                },
                                {
                                    "id": "120070371",
                                    "speaker": "神里绫华",
                                    "text": "我打算真诚地面对自己的心，完成这个同样属于我的愿望。如果是你的话，一定不会责怪我的任性…"
                                },
                                {
                                    "id": "120070372",
                                    "speaker": "神里绫华",
                                    "text": "我想…我想请你和我一起去祭典！"
                                },
                                {
                                    "id": "120070373",
                                    "speaker": "Player",
                                    "text": "我非常乐意。"
                                },
                                {
                                    "id": "120070374",
                                    "speaker": "派蒙",
                                    "text": "要去要去！祭典上肯定有很多好吃的吧？还有好玩的，嘿嘿！"
                                },
                                {
                                    "id": "120070375",
                                    "speaker": "神里绫华",
                                    "text": "…太好了，谢谢你们！"
                                },
                                {
                                    "id": "120070376",
                                    "speaker": "神里绫华",
                                    "text": "现在去的话，应该还能赶上。"
                                },
                                {
                                    "id": "120070377",
                                    "speaker": "派蒙",
                                    "text": "对哦，今天好像是最后一天吧？还等什么，快走快走！"
                                }
                            ]
                        },
                        {
                            "id": "120070357",
                            "text": "不是绫华的问题哦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200708",
            "objective": "调查石壁上的灌木",
            "dialogues": [
                {
                    "id": "3477901",
                    "speaker": "Player",
                    "text": "叩击七下"
                },
                {
                    "id": "3478092",
                    "speaker": "令人在意的石壁",
                    "text": "石壁中传来了奇妙的响声。"
                }
            ]
        },
        {
            "id": "1200704",
            "objective": "打开神秘盒子",
            "dialogues": []
        },
        {
            "id": "1200705",
            "objective": "与神里绫华对话",
            "dialogues": [
                {
                    "id": "120070201",
                    "speaker": "派蒙",
                    "text": "开了吗开了吗？有没有仙人留下的财宝？"
                },
                {
                    "id": "120070202",
                    "speaker": "神里绫华",
                    "text": "这是…"
                },
                {
                    "id": "120070203",
                    "speaker": "派蒙",
                    "text": "唔…这是书吗？"
                },
                {
                    "id": "120070204",
                    "speaker": "神里绫华",
                    "text": "看起来也是本笔记。"
                },
                {
                    "id": "120070205",
                    "speaker": "神里绫华",
                    "text": "难道这会是「椿」的笔记吗…"
                },
                {
                    "id": "120070206",
                    "speaker": "神里绫华",
                    "text": "各位，我们还是到外面去吧。这里气氛跟我想的有些不同，总觉得…不太想在这里翻开这本笔记。"
                },
                {
                    "id": "120070207",
                    "speaker": "派蒙",
                    "text": "说得对，光线不好容易看坏眼睛哦。走吧走吧，去外面！"
                }
            ]
