    "talks": [
        {
            "id": "7605701",
            "objective": "第二天对话$HIDDEN",
            "dialogues": [
                {
                    "id": "760570101",
                    "speaker": "瓦伊诺",
                    "text": "下次再设计一下团队战好了？或许对战也是不错的主意？哦，是你们呀，欢迎来到训练场！",
                    "choices": [
                        {
                            "id": "760570102",
                            "text": "关于训练场…",
                            "response": [
                                {
                                    "id": "760570103",
                                    "speaker": "瓦伊诺",
                                    "text": "客人渐渐多了起来，这还是多亏了你们。当然，还有孩子们和「地隐会」的功劳！"
                                },
                                {
                                    "id": "760570104",
                                    "speaker": "瓦伊诺",
                                    "text": "我发现，训练场会是一个很适合聚会的地方。和多年不见的朋友突然相聚，一时会不知道该说些什么吧？"
                                }
                            ]
                        },
                        {
                            "id": "760570105",
                            "text": "关于「地隐会」…",
                            "response": [
                                {
                                    "id": "760570106",
                                    "speaker": "瓦伊诺",
                                    "text": "啊…暂时还没有找到比靶标更合适的鼹鼠窝垫材…"
                                },
                                {
                                    "id": "760570107",
                                    "speaker": "瓦伊诺",
                                    "text": "我和孩子们试了好几种材料了，它们就是特别中意靶标。目前为止还是只能去和它们交易换回来…"
                                },
                                {
                                    "id": "760570108",
                                    "speaker": "瓦伊诺",
                                    "text": "不过，我们也渐渐掌握了它们的宝物汇率，净赚不少。"
                                }
                            ]
                        },
                        {
                            "id": "760570109",
                            "text": "下次再来找你。",
                            "response": [
                                {
                                    "id": "760570110",
                                    "speaker": "瓦伊诺",
                                    "text": "嗯，请随时来！记得哦，只要是你们，永远免费！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
