    "talks": [
        {
            "id": "7609301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760930101",
                    "speaker": "叶洛亚",
                    "text": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…"
                },
                {
                    "id": "760930102",
                    "speaker": "执灯士众人",
                    "text": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」"
                },
                {
                    "id": "760930103",
                    "speaker": "执灯士众人",
                    "text": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」"
                },
                {
                    "id": "760930104",
                    "speaker": "执灯士众人",
                    "text": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」"
                },
                {
                    "id": "760930105",
                    "speaker": "叶洛亚",
                    "text": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。"
                },
                {
                    "id": "760930106",
                    "speaker": "叶洛亚",
                    "text": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。"
                },
                {
                    "id": "760930107",
                    "speaker": "叶洛亚",
                    "text": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。"
                },
                {
                    "id": "760930108",
                    "speaker": "叶洛亚",
                    "text": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！"
                },
                {
                    "id": "760930109",
                    "speaker": "叶洛亚",
                    "text": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！"
                },
                {
                    "id": "760930110",
                    "speaker": "叶洛亚",
                    "text": "出发！"
                },
                {
                    "id": "760930111",
                    "speaker": "执灯士众人",
                    "text": "是！队长！"
                }
            ]
        },
        {
            "id": "7609302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760930201",
                    "speaker": "派蒙",
                    "text": "这么多执灯士集结出发的场景，我还是第一次见。看来事情真的很严重…"
                },
                {
                    "id": "760930202",
                    "speaker": "Player",
                    "text": "他们的队长看起来很可靠。"
                },
                {
                    "id": "760930203",
                    "speaker": "派蒙",
                    "text": "#是哦，看起来和{NICKNAME}差不多大，但是很有气势呢！"
                },
                {
                    "id": "760930204",
                    "speaker": "派蒙",
                    "text": "不过，我还是有点担心，他们要对付的是很特别的狂猎吧？就算有这么多人，真的没问题吗…"
                },
                {
                    "id": "760930205",
                    "speaker": "Player",
                    "text": "我们也想办法帮忙吧。"
                },
                {
                    "id": "760930206",
                    "speaker": "派蒙",
                    "text": "嗯！既然是狂猎的威胁，那就不只是执灯人的责任，我们也不能放任不管。"
                },
                {
                    "id": "760930207",
                    "speaker": "？？？",
                    "text": "恕我冒昧，打扰一下二位…"
                },
                {
                    "id": "760930208",
                    "speaker": "派蒙",
                    "text": "老爷爷，怎么啦？"
                },
                {
                    "id": "760930209",
                    "speaker": "？？？",
                    "text": "虽然是第一次见，不过看两位的面相，想必不是无名之辈。"
                },
                {
                    "id": "760930210",
                    "speaker": "？？？",
                    "text": "#正巧我听闻，有位游历诸国，留下诸多传奇的金发冒险家{NICKNAME}与{M#他}{F#她}的伙伴，最近也来到了挪德卡莱…"
                },
                {
                    "id": "760930211",
                    "speaker": "？？？",
                    "text": "莫非就是二位？",
                    "choices": [
                        {
                            "id": "760930212",
                            "text": "正是在下。",
                            "response": [
                                {
                                    "id": "760930214",
                                    "speaker": "派蒙",
                                    "text": "没想到在这里也会被人认出来…这样下去，迟早有一天我们不管去哪都要乔装打扮才行了。",
                                    "choices": [
                                        {
                                            "id": "760930215",
                                            "text": "派蒙不喜欢当名人的感觉？",
                                            "response": [
                                                {
                                                    "id": "760930216",
                                                    "speaker": "派蒙",
                                                    "text": "倒也不是啦。我只是担心以后要是接到了对付坏人的委托，说不定还没离开协会多远，坏家伙就收到消息逃跑了！"
                                                },
                                                {
                                                    "id": "760930219",
                                                    "speaker": "尼基塔",
                                                    "text": "我叫尼基塔，是长年驻守在这边鄙之地的一名普通的执灯士。"
                                                },
                                                {
                                                    "id": "760930220",
                                                    "speaker": "尼基塔",
                                                    "text": "唐突耽搁两位…实不相瞒，鄙人有个不情之请。"
                                                },
                                                {
                                                    "id": "760930221",
                                                    "speaker": "派蒙",
                                                    "text": "唔…该不会和狂猎有关？"
                                                },
                                                {
                                                    "id": "760930222",
                                                    "speaker": "尼基塔",
                                                    "text": "的确有着莫大的关系，我想请两位协助我们寻找一件名为「银灯芯」的圣物。"
                                                },
                                                {
                                                    "id": "760930223",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，那你可算找对人了，我们很擅长找东西的！不过，这个圣物和狂猎有什么关系呀？"
                                                },
                                                {
                                                    "id": "760930224",
                                                    "speaker": "尼基塔",
                                                    "text": "嗯…那就要从五百年前席卷此地的狂猎灾厄说起了，传说彼时驱使漆黑力量的恶兽，将挪德卡莱当作了它的猎场，荼毒了无数的生灵。"
                                                },
                                                {
                                                    "id": "760930225",
                                                    "speaker": "尼基塔",
                                                    "text": "直到铸灯者用<color=#00E1FFFF>剑、灯、镜三件圣物</color>将其击败，并镇压、封印在苦壑崖下，这才平息了在大地上蔓延的灾厄。"
                                                },
                                                {
                                                    "id": "760930226",
                                                    "speaker": "尼基塔",
                                                    "text": "「银灯芯」就是三件圣物中的一件，它可以展开结界，抵御狂猎的攻击。"
                                                },
                                                {
                                                    "id": "760930227",
                                                    "speaker": "尼基塔",
                                                    "text": "在平息了灾厄后，铸灯者便将它交给了守护厄布拉神柱的妖精爱莉厄保管。"
                                                },
                                                {
                                                    "id": "760930228",
                                                    "speaker": "尼基塔",
                                                    "text": "而今情况危急，要渡过此次的危机，免不了要仰赖圣物之力。虽然也派出了执灯士去寻找，但寻物毕竟不是我们的长项。"
                                                },
                                                {
                                                    "id": "760930229",
                                                    "speaker": "尼基塔",
                                                    "text": "若能得到两位的助力，那便是再好不过了。",
                                                    "choices": [
                                                        {
                                                            "id": "760930230",
                                                            "text": "既然与狂猎有关，我义不容辞。",
                                                            "response": [
                                                                {
                                                                    "id": "760930231",
                                                                    "speaker": "尼基塔",
                                                                    "text": "好，好！看来传说果然不错，你不仅是位了不起的冒险家，还是个急公好义的勇士。"
                                                                },
                                                                {
                                                                    "id": "760930234",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，也就是说，我们的任务就是去厄布拉神柱找到传说中的「银灯芯」，然后把它带回这里…"
                                                                },
                                                                {
                                                                    "id": "760930235",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？可是，圣物不是被妖精保管起来了吗？我们要怎么找到它，又怎么取走呢？"
                                                                },
                                                                {
                                                                    "id": "760930236",
                                                                    "speaker": "尼基塔",
                                                                    "text": "依据传说的内容，依着月矩力的指引向上，就能见到她。她也曾是铸灯者的盟友，只要说明情况，相信她一定会理解的。"
                                                                },
                                                                {
                                                                    "id": "760930237",
                                                                    "speaker": "尼基塔",
                                                                    "text": "不过，若你们取到了「银灯芯」，就把它交给叶洛亚吧。"
                                                                },
                                                                {
                                                                    "id": "760930238",
                                                                    "speaker": "尼基塔",
                                                                    "text": "你们刚才已经见过他了，那个带队的少年就是了，他才是目前最需要这件圣物的人…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760930232",
                                                            "text": "反正你会付报酬的吧？",
                                                            "response": [
                                                                {
                                                                    "id": "760930233",
                                                                    "speaker": "尼基塔",
                                                                    "text": "那是当然，我们执灯人虽然实力不复当年，但给协助者的报酬我们是不会吝啬的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760930217",
                                            "text": "还好我已经习惯了。",
                                            "response": [
                                                {
                                                    "id": "760930218",
                                                    "speaker": "派蒙",
                                                    "text": "真的假的，你该不会每天都背着我偷偷练习签名吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760930213",
                            "text": "我们的行踪怎么又泄露了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760930301",
                    "speaker": "？？？",
                    "text": "真够见鬼的，这破车怎么又停着不动了！"
                },
                {
                    "id": "760930302",
                    "speaker": "？？？",
                    "text": "我说月厢车大哥，你就不能再多撑一会吗？"
                },
                {
                    "id": "760930303",
                    "speaker": "？？？",
                    "text": "就差那么几步路，咱们就能回到皮拉米达了，到时候你是熄火还是趴窝都没人管你。"
                },
                {
                    "id": "760930304",
                    "speaker": "？？？",
                    "text": "结果你呢，偏偏要停在这里。怎么着，难道是要我们把你给抬回城里去？"
                },
                {
                    "id": "760930305",
                    "speaker": "？？？",
                    "text": "哎，真是多事之秋，不管干什么都触霉头。我可没工夫跟你耗，罗洛老弟，看来我们得多找几个帮手来了。"
                },
                {
                    "id": "760930306",
                    "speaker": "？？？",
                    "text": "哎哟，我这还没叫人呢，怎么就有两位朋友来了？"
                },
                {
                    "id": "760930307",
                    "speaker": "？？？",
                    "text": "看起来不是很眼熟啊，难不成是新入行的宝藏猎人？"
                },
                {
                    "id": "760930308",
                    "speaker": "派蒙",
                    "text": "#你们好，我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是路过这里的冒险家。"
                },
                {
                    "id": "760930309",
                    "speaker": "派蒙",
                    "text": "看你们的样子，是遇到什么困难了吗？"
                },
                {
                    "id": "760930310",
                    "speaker": "安莱夫",
                    "text": "喔！你们好，我叫安莱夫，是一名执灯士。原来两位是冒险家啊…那你们恐怕来错地方了。",
                    "choices": [
                        {
                            "id": "760930311",
                            "text": "放心，我们不会乱动东西的。",
                            "response": [
                                {
                                    "id": "760930313",
                                    "speaker": "安莱夫",
                                    "text": "倒也不是这个意思，你们刚来或许不知道，最近北边的苦壑崖一带爆发了大规模的狂猎。"
                                },
                                {
                                    "id": "760930314",
                                    "speaker": "安莱夫",
                                    "text": "那里有一座开拓时代遗留下来的古老遗迹，几年前就出过事故，但没想到会突然变得这么严重…"
                                },
                                {
                                    "id": "760930315",
                                    "speaker": "安莱夫",
                                    "text": "你们往北边看，瞧见了吗？这阵子不少魔物从那儿冒出来，很不太平，你们要是没什么要紧事，最好也别在这一带游荡了。"
                                },
                                {
                                    "id": "760930316",
                                    "speaker": "安莱夫",
                                    "text": "这次我们就是受到了老爷子的召唤，为了参加讨伐狂猎的行动才赶回皮拉米达城的。"
                                },
                                {
                                    "id": "760930317",
                                    "speaker": "安莱夫",
                                    "text": "你说对吧，罗洛老弟？"
                                },
                                {
                                    "id": "760930318",
                                    "speaker": "安莱夫",
                                    "text": "喂，你这是怎么了，从刚才开始就一言不发的…"
                                },
                                {
                                    "id": "760930319",
                                    "speaker": "安莱夫",
                                    "text": "！！！"
                                }
                            ]
                        },
                        {
                            "id": "760930312",
                            "text": "这里不欢迎冒险家吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609304",
            "objective": "帮助执灯人",
            "dialogues": [
                {
                    "id": "760930401",
                    "speaker": "叶洛亚",
                    "text": "可惜现在没时间带你们参观总部了，接下来等待我们的将会是一场苦战。你们要是需要做些准备，可以尽快安排。"
                },
                {
                    "id": "760930402",
                    "speaker": "叶洛亚",
                    "text": "我就带着大部队先行前往「望崖营壁」进行必要的战备工作了，在那儿等你们会合。"
                },
                {
                    "id": "760930403",
                    "speaker": "派蒙",
                    "text": "嗯！我们也会尽快赶到的！"
                },
                {
                    "id": "760930404",
                    "speaker": "派蒙",
                    "text": "好啦，想想我们有什么需要赶紧准备的…"
                },
                {
                    "id": "760930405",
                    "speaker": "？？？",
                    "text": "恕我冒昧，打扰一下二位…"
                },
                {
                    "id": "760930406",
                    "speaker": "派蒙",
                    "text": "老爷爷，怎么啦？"
                },
                {
                    "id": "760930407",
                    "speaker": "尼基塔",
                    "text": "我叫尼基塔，是长年驻守在这边鄙之地的一名普通的执灯士。虽然是第一次见，不过看两位的面相，想必不是无名之辈。"
                },
                {
                    "id": "760930408",
                    "speaker": "尼基塔",
                    "text": "#正巧我听闻，有位游历诸国，留下诸多传奇的金发冒险家{NICKNAME}与{M#他}{F#她}的伙伴，最近也来到了挪德卡莱…"
                },
                {
                    "id": "760930409",
                    "speaker": "尼基塔",
                    "text": "莫非就是二位？",
                    "choices": [
                        {
                            "id": "760930410",
                            "text": "正是在下。",
                            "response": [
                                {
                                    "id": "760930412",
                                    "speaker": "派蒙",
                                    "text": "没想到在这里也会被人认出来…这样下去，迟早有一天我们不管去哪儿都要乔装打扮才行了。"
                                },
                                {
                                    "id": "760930413",
                                    "speaker": "尼基塔",
                                    "text": "我看两位也参加了誓师，你们也要去讨伐苦壑崖的魔物吗？"
                                },
                                {
                                    "id": "760930414",
                                    "speaker": "派蒙",
                                    "text": "是呀，我们可是调查分队的临时成员呢！"
                                },
                                {
                                    "id": "760930415",
                                    "speaker": "Black Screen",
                                    "text": "告诉了尼基塔你们是如何结识了叶洛亚，并加入调查分队的…"
                                },
                                {
                                    "id": "760930416",
                                    "speaker": "尼基塔",
                                    "text": "原来是这样，能够结识两位，是那孩子的福分啊。这次作战有你们的助力，我也能放心不少了。"
                                },
                                {
                                    "id": "760930417",
                                    "speaker": "尼基塔",
                                    "text": "这话虽然有些多余，但那孩子作为队长，承担这样艰巨的任务也还是第一次。"
                                },
                                {
                                    "id": "760930418",
                                    "speaker": "尼基塔",
                                    "text": "叶洛亚的实力在新一代的执灯士里当属魁首，战斗方面的事情我是不担心的，就怕那孩子…"
                                },
                                {
                                    "id": "760930419",
                                    "speaker": "尼基塔",
                                    "text": "就当是老头子的杞人忧天吧，我听说过不少你们的事迹，对于调查这种危险之地时的进退一定很有经验。"
                                },
                                {
                                    "id": "760930420",
                                    "speaker": "尼基塔",
                                    "text": "无论如何，请你们多多用冒险家的智慧帮助他吧。"
                                },
                                {
                                    "id": "760930421",
                                    "speaker": "Player",
                                    "text": "作为队员当然义不容辞。"
                                },
                                {
                                    "id": "760930422",
                                    "speaker": "派蒙",
                                    "text": "对啊，就算你不说，我们也会全力帮忙的！"
                                },
                                {
                                    "id": "760930423",
                                    "speaker": "尼基塔",
                                    "text": "那就太好了。可惜我的腿脚没有当年那么灵便了，不然也要亲自去苦壑崖会会那个怪物。"
                                },
                                {
                                    "id": "760930424",
                                    "speaker": "尼基塔",
                                    "text": "呵呵，终究还是得把担子交给年轻人啊…"
                                }
                            ]
                        },
                        {
                            "id": "760930411",
                            "text": "我们的行踪怎么又泄露了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609305",
            "objective": "与执灯人对话",
            "dialogues": [
                {
                    "id": "760930501",
                    "speaker": "安莱夫",
                    "text": "罗洛老弟，你真的没事吧？"
                },
                {
                    "id": "760930502",
                    "speaker": "罗洛",
                    "text": "我没事。抱歉…想到马上能回到皮拉米达城，精神稍微松懈了…"
                },
                {
                    "id": "760930503",
                    "speaker": "安莱夫",
                    "text": "你没事就好。刚才你中了狂猎的招，多亏这位小英雄出手相助…总之谢谢你们了。"
                },
                {
                    "id": "760930504",
                    "speaker": "Player",
                    "text": "举手之劳。"
                },
                {
                    "id": "760930505",
                    "speaker": "派蒙",
                    "text": "#对{NICKNAME}来说就是小菜一碟啦。"
                },
                {
                    "id": "760930506",
                    "speaker": "安莱夫",
                    "text": "说来小英雄的身手不错啊。怎么样，要不要加入我们执灯人军团呢？"
                },
                {
                    "id": "760930507",
                    "speaker": "安莱夫",
                    "text": "不过说起来，在这个节骨眼上邀请你们，在外人看来可能有点恩将仇报的意思…还是算了，你们就当我没说。"
                },
                {
                    "id": "760930508",
                    "speaker": "安莱夫",
                    "text": "刚才我们对付的就是来自苦壑崖的狂猎，这些狂猎怪得很，不仅会成群结队地袭击遇上的活物，据说还有摄人心智的能力…"
                },
                {
                    "id": "760930509",
                    "speaker": "安莱夫",
                    "text": "不知道它们使的什么邪术，会在人意志松懈的瞬间趁虚而入，把人裹挟进狂猎的队伍…"
                },
                {
                    "id": "760930510",
                    "speaker": "安莱夫",
                    "text": "这次的作战就是要对付它们，要是不顺利，从今往后还有没有「执灯人」都难说了…"
                },
                {
                    "id": "760930511",
                    "speaker": "派蒙",
                    "text": "这、这么严重吗？"
                },
                {
                    "id": "760930512",
                    "speaker": "安莱夫",
                    "text": "是啊，不过这不是你们冒险家…而且还是小孩子该担心的事，就交给我们吧。"
                },
                {
                    "id": "760930513",
                    "speaker": "安莱夫",
                    "text": "若是还能再见的话，我一定请你们喝「皮拉米达的夜莺」，再来点肉馅黑麦包表达感谢，这才是我们执灯人的待客之道。"
                },
                {
                    "id": "760930514",
                    "speaker": "Player",
                    "text": "一定会再见的。"
                },
                {
                    "id": "760930515",
                    "speaker": "派蒙",
                    "text": "加油啊，一定要平安回来！"
                },
                {
                    "id": "760930516",
                    "speaker": "安莱夫",
                    "text": "那借两位的吉言，我们就先回皮拉米达城了。有缘再会吧！"
                }
            ]
        },
        {
            "id": "7609306",
            "objective": "调查「高塔」",
            "dialogues": [
                {
                    "id": "760930601",
                    "speaker": "菲林斯",
                    "text": "放平时我恐怕不会主动请缨，但这次的麻烦真的不需要我出手吗？"
                },
                {
                    "id": "760930602",
                    "speaker": "尼基塔",
                    "text": "哦，你来了啊，菲林斯。我还以为你不会来。"
                },
                {
                    "id": "760930603",
                    "speaker": "菲林斯",
                    "text": "如果您真那么想，为何不直接减少给我寄信的频次呢？"
                },
                {
                    "id": "760930604",
                    "speaker": "菲林斯",
                    "text": "没记错的话，您一个星期前就把通知送到我的灯塔来了，我要是都不来看看，也太不尊重您这位执灯长了。"
                },
                {
                    "id": "760930605",
                    "speaker": "尼基塔",
                    "text": "总部的通知从来也没落下你，说到底还是因为那孩子吧。在执灯人里他跟你走得最近，总向我打听你的近况。"
                },
                {
                    "id": "760930606",
                    "speaker": "菲林斯",
                    "text": "他的近况如何？"
                },
                {
                    "id": "760930607",
                    "speaker": "尼基塔",
                    "text": "……"
                },
                {
                    "id": "760930608",
                    "speaker": "菲林斯",
                    "text": "你还是选择了将重任放在他的肩上。"
                },
                {
                    "id": "760930609",
                    "speaker": "尼基塔",
                    "text": "是啊。我需要他，而我也深切地信任着他…"
                },
                {
                    "id": "760930610",
                    "speaker": "菲林斯",
                    "text": "我已经给出了忠告，那并非寻常的狂猎。那些魔物是被吸引过来的，被某个过去被封印在苦壑崖的古老存在。"
                },
                {
                    "id": "760930611",
                    "speaker": "菲林斯",
                    "text": "关于「他」，我也略知一二，我曾在白沙皇的宫廷中与他有过一面之缘，那条毒蛇绝非等闲之辈。"
                },
                {
                    "id": "760930612",
                    "speaker": "菲林斯",
                    "text": "我记得他的眼睛，就和现在正盯着我们的那只一模一样。"
                },
                {
                    "id": "760930613",
                    "speaker": "尼基塔",
                    "text": "我说，菲林斯啊，你还记得我们是怎么成为执灯人的吗？"
                },
                {
                    "id": "760930614",
                    "speaker": "菲林斯",
                    "text": "你是说「你们」？"
                },
                {
                    "id": "760930615",
                    "speaker": "尼基塔",
                    "text": "「我们」，菲林斯，我们。最近我总梦到过去的事情，梦见你我一起经历过的那些战场。"
                },
                {
                    "id": "760930616",
                    "speaker": "尼基塔",
                    "text": "灾难总是突然到来的…无论是枕戈待旦、坦然面对之人，还是提心吊胆、心怀侥幸之辈，大限来时，无人能够幸免。"
                },
                {
                    "id": "760930617",
                    "speaker": "尼基塔",
                    "text": "但你我都知道，在永恒的宁静到来前，人的抗争是有意义的。而我们执灯人正是这样，用五百年的抗争，铸成了这座堡垒的根基。"
                },
                {
                    "id": "760930618",
                    "speaker": "菲林斯",
                    "text": "我看叶洛亚没到需要补上这一课的程度吧？你比我更清楚他曾经失去过一切。"
                },
                {
                    "id": "760930619",
                    "speaker": "菲林斯",
                    "text": "这道理他想必早已知道，只是眼下，少年的心气让他还不愿意承认罢了。"
                },
                {
                    "id": "760930620",
                    "speaker": "尼基塔",
                    "text": "但我的时间也不多了…比起他即将肩负的责任，我本该为他争取的岁月，现在也所剩无几了。"
                },
                {
                    "id": "760930621",
                    "speaker": "菲林斯",
                    "text": "看来你决心已定了。那我就不再白费口舌了，毕竟你才是执灯长。"
                },
                {
                    "id": "760930622",
                    "speaker": "尼基塔",
                    "text": "话说回来，上次托你寻的物件，你还记得吧？"
                },
                {
                    "id": "760930623",
                    "speaker": "菲林斯",
                    "text": "执灯长先生的委托我怎么会忘？五百年前的古物，且与最初的咏月使有着千丝万缕的联系。即使是我也费了不少周折…"
                },
                {
                    "id": "760930624",
                    "speaker": "尼基塔",
                    "text": "呵呵，既然如此，我们也该开始准备了。铸灯者留下的「弓矢」，就让我们见识一下它的威力吧…"
                }
            ]
        },
