        {
            "id": "7609308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760930801",
                    "speaker": "像是队长的人",
                    "text": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…"
                },
                {
                    "id": "760930802",
                    "speaker": "执灯士众人",
                    "text": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」"
                },
                {
                    "id": "760930803",
                    "speaker": "执灯士众人",
                    "text": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」"
                },
                {
                    "id": "760930804",
                    "speaker": "执灯士众人",
                    "text": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」"
                },
                {
                    "id": "760930805",
                    "speaker": "像是队长的人",
                    "text": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。"
                },
                {
                    "id": "760930806",
                    "speaker": "像是队长的人",
                    "text": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。"
                },
                {
                    "id": "760930807",
                    "speaker": "像是队长的人",
                    "text": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。"
                },
                {
                    "id": "760930808",
                    "speaker": "像是队长的人",
                    "text": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！"
                },
                {
                    "id": "760930809",
                    "speaker": "像是队长的人",
                    "text": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！"
                },
                {
                    "id": "760930810",
                    "speaker": "像是队长的人",
                    "text": "出发！"
                },
                {
                    "id": "760930811",
                    "speaker": "执灯士众人",
                    "text": "是！队长！"
                }
            ]
        }
    ]
}