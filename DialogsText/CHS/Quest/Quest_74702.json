{
    "quest": {
        "id": "74702",
        "title": "水族馆？开业！",
        "description": "桑多涅似乎有事找我们…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 29,
        "total_speaker_counts": {
            "Player": 8,
            "「木偶」": 8,
            "派蒙": 13
        }
    },
    "talks": [
        {
            "id": "7470201",
            "objective": "与桑多涅对话",
            "dialogues": [
                {
                    "id": "747020101",
                    "speaker": "「木偶」",
                    "text": "哟，最近带回来不少鱼嘛。水族箱也装点得越来越像那么回事了。"
                },
                {
                    "id": "747020102",
                    "speaker": "派蒙",
                    "text": "嘿嘿，我们这方面可是很在行的！"
                },
                {
                    "id": "747020103",
                    "speaker": "「木偶」",
                    "text": "你们好像很有成就感的样子。"
                },
                {
                    "id": "747020104",
                    "speaker": "派蒙",
                    "text": "那当然！不过除了成就感之外，总觉得心中有些…有些…",
                    "choices": [
                        {
                            "id": "747020105",
                            "text": "可惜？",
                            "response": [
                                {
                                    "id": "747020107",
                                    "speaker": "派蒙",
                                    "text": "对对对，差不多就是你那个意思。"
                                },
                                {
                                    "id": "747020108",
                                    "speaker": "「木偶」",
                                    "text": "这是为什么？"
                                },
                                {
                                    "id": "747020109",
                                    "speaker": "派蒙",
                                    "text": "我也不知道…总觉得这里还少了什么…",
                                    "choices": [
                                        {
                                            "id": "747020110",
                                            "text": "少了餐厅？",
                                            "response": [
                                                {
                                                    "id": "747020111",
                                                    "speaker": "派蒙",
                                                    "text": "喂！肯定不是啦！这么漂亮的鱼儿怎么舍得吃呀！"
                                                },
                                                {
                                                    "id": "747020114",
                                                    "speaker": "派蒙",
                                                    "text": "少的是来欣赏我们成果的客人呀！"
                                                },
                                                {
                                                    "id": "747020115",
                                                    "speaker": "「木偶」",
                                                    "text": "你的意思是…想让这个水族馆开业接待游客？"
                                                },
                                                {
                                                    "id": "747020116",
                                                    "speaker": "派蒙",
                                                    "text": "你有什么顾虑吗？",
                                                    "choices": [
                                                        {
                                                            "id": "747020117",
                                                            "text": "怕这里变得太热闹？",
                                                            "response": [
                                                                {
                                                                    "id": "747020119",
                                                                    "speaker": "派蒙",
                                                                    "text": "如果是这样的话，把经营和宣传工作交给我们就好！桑多涅你安心做自己的事，不用操心这边！"
                                                                },
                                                                {
                                                                    "id": "747020120",
                                                                    "speaker": "「木偶」",
                                                                    "text": "既然你们都这么说了…"
                                                                },
                                                                {
                                                                    "id": "747020121",
                                                                    "speaker": "Player",
                                                                    "text": "营收额三七分！"
                                                                },
                                                                {
                                                                    "id": "747020122",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸…？我们才拿七成吗？"
                                                                },
                                                                {
                                                                    "id": "747020123",
                                                                    "speaker": "Player",
                                                                    "text": "七成是人家的。"
                                                                },
                                                                {
                                                                    "id": "747020124",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦哦…也对，毕竟这船是桑多涅租的…"
                                                                },
                                                                {
                                                                    "id": "747020125",
                                                                    "speaker": "「木偶」",
                                                                    "text": "得了得了，别把我说得像什么不讲道理的地主。你们出的力，你们拿大头。我可没潘塔罗涅那么抠。"
                                                                },
                                                                {
                                                                    "id": "747020126",
                                                                    "speaker": "派蒙",
                                                                    "text": "那也就是…你同意水族馆营业了？"
                                                                },
                                                                {
                                                                    "id": "747020127",
                                                                    "speaker": "「木偶」",
                                                                    "text": "嗯，随你们倒弄去吧。别吵到我研究就行。"
                                                                },
                                                                {
                                                                    "id": "747020128",
                                                                    "speaker": "派蒙",
                                                                    "text": "好欸！维恩歌莱噗噗水族馆，开业！"
                                                                },
                                                                {
                                                                    "id": "747020129",
                                                                    "speaker": "「木偶」",
                                                                    "text": "原来早就把名字想好了吗…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "747020118",
                                                            "text": "怕事情变得麻烦？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "747020112",
                                            "text": "少了客人？",
                                            "response": [
                                                {
                                                    "id": "747020113",
                                                    "speaker": "派蒙",
                                                    "text": "哦！没错！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "747020106",
                            "text": "孤独？"
                        }
                    ]
                }
            ]
        }
    ]
}