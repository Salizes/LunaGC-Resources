    "talks": [
        {
            "id": "7650001",
            "objective": "前往那夏镇",
            "dialogues": [
                {
                    "id": "765000101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}！快过来这边！给你看一个超级棒的东西！"
                },
                {
                    "id": "765000102",
                    "speaker": "派蒙",
                    "text": "当当——！你看，这是我费了好大劲，才从这个乱糟糟的市集里淘到的好宝贝！",
                    "choices": [
                        {
                            "id": "765000103",
                            "text": "这留影机…看起来很有年代感。",
                            "response": [
                                {
                                    "id": "765000106",
                                    "speaker": "派蒙",
                                    "text": "听那个神神秘秘的卖家说，这可是几十年前，枫丹那位超级有名的摄影大师——皮埃尔·勒布朗先生用过的留影机哦！"
                                },
                                {
                                    "id": "765000107",
                                    "speaker": "派蒙",
                                    "text": "据说啊，他当年用这台留影机拍摄的画片，每一张都很受欢迎，时不时就会登上《蒸汽鸟报》的头条呢！"
                                },
                                {
                                    "id": "765000108",
                                    "speaker": "派蒙",
                                    "text": "#如果{NICKNAME}也用上这么厉害的相机，说不定也能拍出传世名作呢！搞不好还能卖出天价！",
                                    "choices": [
                                        {
                                            "id": "765000109",
                                            "text": "这相机…应该不便宜吧。",
                                            "response": [
                                                {
                                                    "id": "765000110",
                                                    "speaker": "派蒙",
                                                    "text": "欸嘿嘿，还好啦！派蒙也是有悄悄攒下来一点「应急储备金」的！"
                                                },
                                                {
                                                    "id": "765000111",
                                                    "speaker": "派蒙",
                                                    "text": "#只要{NICKNAME}喜欢，这点摩拉不算什么啦。",
                                                    "choices": [
                                                        {
                                                            "id": "765000116",
                                                            "text": "谢谢你，派蒙。我很喜欢。",
                                                            "response": [
                                                                {
                                                                    "id": "765000118",
                                                                    "speaker": "派蒙",
                                                                    "text": "太好了，你喜欢就好！刚好我们来到了新的国家，这里肯定有很多好玩的好看的，把这些通通都拍下来吧！"
                                                                },
                                                                {
                                                                    "id": "765000119",
                                                                    "speaker": "派蒙",
                                                                    "text": "新的留影册，我也早就替你准备好了。是不是超级贴心！"
                                                                },
                                                                {
                                                                    "id": "765000120",
                                                                    "speaker": "派蒙",
                                                                    "text": "好啦好啦， 我们一起去发掘那些有意思的地方吧！出发！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765000117",
                                                            "text": "我会努力用它拍出好画片的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765000112",
                                            "text": "派蒙没有遇上无良商人吧。",
                                            "response": [
                                                {
                                                    "id": "765000113",
                                                    "speaker": "派蒙",
                                                    "text": "放心啦，为了确保万无一失，我已经拜托一位非常可靠的工程师帮忙鉴定过了，这就是勒布朗大师当年使用的那个型号，错不了！"
                                                },
                                                {
                                                    "id": "765000114",
                                                    "speaker": "派蒙",
                                                    "text": "而且，工程师拆开机器的时候，还发现内部有一个小小的、刻着他名字缩写的印记呢。这可是独一无二的证据。"
                                                },
                                                {
                                                    "id": "765000115",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，作为你的向导，我还是很靠得住的。关键时刻绝不掉链子！",
                                                    "choices": [
                                                        {
                                                            "id": "765000116",
                                                            "text": "谢谢你，派蒙。我很喜欢。"
                                                        },
                                                        {
                                                            "id": "765000117",
                                                            "text": "我会努力用它拍出好画片的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765000104",
                            "text": "派蒙打算做起古董生意了？",
                            "response": [
                                {
                                    "id": "765000105",
                                    "speaker": "派蒙",
                                    "text": "才不是呢！这是我特意为你准备的惊喜礼物!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}