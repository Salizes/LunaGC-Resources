    "talks": [
        {
            "id": "37701",
            "objective": "离开酒馆",
            "dialogues": []
        },
        {
            "id": "37702",
            "objective": "在第二天的晚上前往酒馆$HIDDEN",
            "dialogues": [
                {
                    "id": "3770201",
                    "speaker": "温迪",
                    "text": "你们来啦。"
                },
                {
                    "id": "3770202",
                    "speaker": "琴",
                    "text": "#咦？你不是…{NICKNAME}吗？",
                    "choices": [
                        {
                            "id": "3770203",
                            "text": "你不是…琴吗？",
                            "response": [
                                {
                                    "id": "3770205",
                                    "speaker": "迪卢克",
                                    "text": "首先，我联系的不止一人。"
                                },
                                {
                                    "id": "3770206",
                                    "speaker": "迪卢克",
                                    "text": "其次，这一位只是「琴」，不是作为「团长」的琴。"
                                },
                                {
                                    "id": "3770207",
                                    "speaker": "迪卢克",
                                    "text": "这可是身为荣誉骑士的你，也没可能接触到的人。"
                                },
                                {
                                    "id": "3770208",
                                    "speaker": "琴",
                                    "text": "真是意外。"
                                },
                                {
                                    "id": "3770209",
                                    "speaker": "琴",
                                    "text": "虽然听说了天空之琴的事，但没想到居然是你…"
                                },
                                {
                                    "id": "3770210",
                                    "speaker": "琴",
                                    "text": "那么，琴声的净化能让风魔龙恢复正常…这也是真的吗？"
                                },
                                {
                                    "id": "3770211",
                                    "speaker": "温迪",
                                    "text": "#没错！现在{NICKNAME}正为了解决风魔龙事件，积极投身在最前线。"
                                },
                                {
                                    "id": "3770212",
                                    "speaker": "温迪",
                                    "text": "#实在不愧于骑士团超新星{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}之名。"
                                },
                                {
                                    "id": "3770213",
                                    "speaker": "派蒙",
                                    "text": "虽然感觉上已经越过了违法的边缘…"
                                },
                                {
                                    "id": "3770214",
                                    "speaker": "迪卢克",
                                    "text": "哼。这种牵扯上神话的荒诞解释，无法相信也很正常。"
                                },
                                {
                                    "id": "3770215",
                                    "speaker": "迪卢克",
                                    "text": "但没关系。我们可以让诗人再上演一次那种歌谣，来说服…"
                                },
                                {
                                    "id": "3770216",
                                    "speaker": "琴",
                                    "text": "我相信你们。"
                                },
                                {
                                    "id": "3770217",
                                    "speaker": "迪卢克",
                                    "text": "来说服固执的团长大…嗯？"
                                },
                                {
                                    "id": "3770218",
                                    "speaker": "琴",
                                    "text": "四风守护中的东风之龙，特瓦林，我一直想象不到它背叛的原因。"
                                },
                                {
                                    "id": "3770219",
                                    "speaker": "琴",
                                    "text": "但如果是在多年前守护蒙德的战争中，受到了毒血的侵害…"
                                },
                                {
                                    "id": "3770220",
                                    "speaker": "琴",
                                    "text": "苏醒后又被深渊法师腐蚀，那确实是会变得身不由己…"
                                },
                                {
                                    "id": "3770221",
                                    "speaker": "琴",
                                    "text": "——但这些话，「代理团长」是绝对不能说出口的。"
                                },
                                {
                                    "id": "3770222",
                                    "speaker": "琴",
                                    "text": "迫于「愚人众」的外交压力，骑士团很难公开表示对风魔龙的善意。"
                                },
                                {
                                    "id": "3770223",
                                    "speaker": "琴",
                                    "text": "那会被理解为纵容和不作为，所以我才只能私下行动。"
                                },
                                {
                                    "id": "3770224",
                                    "speaker": "迪卢克",
                                    "text": "哼。"
                                },
                                {
                                    "id": "3770225",
                                    "speaker": "迪卢克",
                                    "text": "这也是我不喜欢骑士团的原因之一。"
                                },
                                {
                                    "id": "3770226",
                                    "speaker": "迪卢克",
                                    "text": "不过我倒是没料到，你就这样相信了来历不明的异乡人…"
                                },
                                {
                                    "id": "3770227",
                                    "speaker": "琴",
                                    "text": "#<color=#00E1FFFF>前辈</color>这样严厉又谨慎的人，不也愿意去相信{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}吗？"
                                },
                                {
                                    "id": "3770228",
                                    "speaker": "迪卢克",
                                    "text": "都说别叫我前辈…也罢，这回就难得地合作一次吧。",
                                    "choices": [
                                        {
                                            "id": "3770229",
                                            "text": "前辈？",
                                            "response": [
                                                {
                                                    "id": "3770231",
                                                    "speaker": "琴",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "3770232",
                                                    "speaker": "迪卢克",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "3770233",
                                                    "speaker": "派蒙",
                                                    "text": "看来是有一些不该追问的过往呐…"
                                                },
                                                {
                                                    "id": "3770234",
                                                    "speaker": "琴",
                                                    "text": "总之天空之琴的真正下落，我已经大致心里有数了。"
                                                },
                                                {
                                                    "id": "3770235",
                                                    "speaker": "温迪",
                                                    "text": "（漂亮！看不出来她还有转移话题的天赋…）"
                                                },
                                                {
                                                    "id": "3770236",
                                                    "speaker": "琴",
                                                    "text": "蒙德城与至冬国的冲突，本质上是七国与七神的冲突。"
                                                },
                                                {
                                                    "id": "3770237",
                                                    "speaker": "琴",
                                                    "text": "冰之神统率的「愚人众」，正觊觎着风神留下的神力…"
                                                },
                                                {
                                                    "id": "3770238",
                                                    "speaker": "温迪",
                                                    "text": "……",
                                                    "choices": [
                                                        {
                                                            "id": "3770239",
                                                            "text": "所以他们会提出接管城防？",
                                                            "response": [
                                                                {
                                                                    "id": "3770241",
                                                                    "speaker": "琴",
                                                                    "text": "没错。"
                                                                },
                                                                {
                                                                    "id": "3770242",
                                                                    "speaker": "琴",
                                                                    "text": "如果公然杀死风龙的企图被骑士团阻止，那么…"
                                                                },
                                                                {
                                                                    "id": "3770243",
                                                                    "speaker": "琴",
                                                                    "text": "天空之琴，就是他们唯一能得到的风神之力了。"
                                                                },
                                                                {
                                                                    "id": "3770244",
                                                                    "speaker": "迪卢克",
                                                                    "text": "蒙德城里落单的「愚人众」成员，要多少就有多少。"
                                                                },
                                                                {
                                                                    "id": "3770245",
                                                                    "speaker": "迪卢克",
                                                                    "text": "我已经从他们嘴里撬了些情报出来…"
                                                                },
                                                                {
                                                                    "id": "3770246",
                                                                    "speaker": "琴",
                                                                    "text": "迪卢克得到的信息是，愚人众没有把天空之琴放在歌德大酒店。"
                                                                },
                                                                {
                                                                    "id": "3770247",
                                                                    "speaker": "琴",
                                                                    "text": "即使是他们也不想太过嚣张、把偷来的圣物收藏在半公开的驻地吧。"
                                                                },
                                                                {
                                                                    "id": "3770248",
                                                                    "speaker": "派蒙",
                                                                    "text": "我懂我懂。事情闹太大的话，就会变成严重的外交危机呢。"
                                                                },
                                                                {
                                                                    "id": "3770249",
                                                                    "speaker": "迪卢克",
                                                                    "text": "呵…七国的关系就是这么回事。"
                                                                },
                                                                {
                                                                    "id": "3770250",
                                                                    "speaker": "迪卢克",
                                                                    "text": "异乡人，做好出发的准备了吗？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3770240",
                                                            "text": "所以他们想要杀死特瓦林？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3770230",
                                            "text": "（假装没听到那个词。）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3770204",
                            "text": "为什么团长会在这里？"
                        }
                    ]
                }
            ]
        },
