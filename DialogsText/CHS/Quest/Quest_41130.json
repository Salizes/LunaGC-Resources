    "talks": [
        {
            "id": "4113005",
            "objective": "",
            "dialogues": [
                {
                    "id": "411300501",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411300502",
                    "speaker": "经纶",
                    "text": "哦…好吧。没关系，我再寻思一下怎么对付那些魔物…"
                }
            ]
        },
        {
            "id": "4113001",
            "objective": "与经纶对话",
            "dialogues": [
                {
                    "id": "411300401",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "411300402",
                    "speaker": "经纶",
                    "text": "太好了。那我先去叫上其他人，我们马上出发，速战速决。"
                },
                {
                    "id": "411300403",
                    "speaker": "经纶",
                    "text": "把魔物营地清理干净之后，我们再回来这里碰头。"
                }
            ]
        },
        {
            "id": "4113002",
            "objective": "打倒所有魔物，并清理所有障碍物",
            "dialogues": [
                {
                    "id": "411300201",
                    "speaker": "经纶",
                    "text": "不行…必须得要人来支援…"
                },
                {
                    "id": "411300202",
                    "speaker": "Player",
                    "text": "魔物营地已经清理干净了。"
                },
                {
                    "id": "411300203",
                    "speaker": "经纶",
                    "text": "好的，谢谢你。但是刚才又出现了意外情况。"
                },
                {
                    "id": "411300204",
                    "speaker": "经纶",
                    "text": "我本来以为，在轻策庄外围徘徊的只有一些普通的魔物…"
                },
                {
                    "id": "411300205",
                    "speaker": "经纶",
                    "text": "我领着几个人，刚清理完了一个魔物营地，正准备休息一下之后再继续前进。"
                },
                {
                    "id": "411300206",
                    "speaker": "经纶",
                    "text": "但是旁边的树林里，突然出现了一只丘丘岩盔王…"
                },
                {
                    "id": "411300207",
                    "speaker": "经纶",
                    "text": "我们还没来得及做出反应，它就袭击了我们，很多人受了伤…我们只能暂时撤退。"
                },
                {
                    "id": "411300208",
                    "speaker": "经纶",
                    "text": "那只魔物的威胁太大了，绝不能坐视不管。但去其他地方清理魔物营地的人还没回来…"
                },
                {
                    "id": "411300209",
                    "speaker": "经纶",
                    "text": "旅行者，你愿意帮忙去打倒那个魔物吗？",
                    "choices": [
                        {
                            "id": "411300210",
                            "text": "交给我了。",
                            "response": [
                                {
                                    "id": "411300211",
                                    "speaker": "经纶",
                                    "text": "那就拜托你了，真是不好意思…这本来是我们的职责。"
                                }
                            ]
                        },
                        {
                            "id": "411300212",
                            "text": "受伤的人没事吧？",
                            "response": [
                                {
                                    "id": "411300213",
                                    "speaker": "经纶",
                                    "text": "还好治疗及时，都没什么大碍…但一时半会是没法自如行动了。"
                                },
                                {
                                    "id": "411300214",
                                    "speaker": "经纶",
                                    "text": "所以，只能拜托你去打倒那个魔物了，旅行者。"
                                },
                                {
                                    "id": "411300215",
                                    "speaker": "经纶",
                                    "text": "真是不好意思…这本来是我们的职责…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4113006",
            "objective": "清扫路障$HIDDEN",
            "dialogues": [
                {
                    "id": "411300601",
                    "speaker": "经纶",
                    "text": "怎么样，你把那只魔物打倒了吗？"
                },
                {
                    "id": "411300602",
                    "speaker": "Player",
                    "text": "已经打倒了。"
                },
                {
                    "id": "411300603",
                    "speaker": "经纶",
                    "text": "太好了…这样子总算能缓口气了。"
                },
                {
                    "id": "411300604",
                    "speaker": "经纶",
                    "text": "谢谢你帮忙，旅行者，这些东西请收下吧，就当是谢礼了。"
                },
                {
                    "id": "411300605",
                    "speaker": "经纶",
                    "text": "但轻策庄周围为什么会突然出现这种魔物，真是奇怪…"
                },
                {
                    "id": "411300606",
                    "speaker": "经纶",
                    "text": "算了，不管怎么样，我都得向总务司报告一下这件事。"
                },
                {
                    "id": "411300607",
                    "speaker": "经纶",
                    "text": "希望总务司能再调一些人过来支援…"
                }
            ]
        },
        {
            "id": "4113007",
            "objective": "清扫路障$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113008",
            "objective": "清扫路障$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113009",
            "objective": "清扫路障$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113003",
            "objective": "回轻策庄向经纶回报",
            "dialogues": []
        },
        {
            "id": "4113004",
            "objective": "打倒魔物",
            "dialogues": []
        },
        {
            "id": "4113012",
            "objective": "向经纶回报",
            "dialogues": []
        },
        {
            "id": "4113001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411300101",
                    "speaker": "经纶",
                    "text": "旅行者，这里，这里！"
                },
                {
                    "id": "411300102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "411300103",
                    "speaker": "经纶",
                    "text": "还是轻策庄的事。因为掉下来的那些陨石，轻策庄周围的魔物都乱了。它们在路上到处肆虐，轻策庄几乎都要被它们给围住了。"
                },
                {
                    "id": "411300106",
                    "speaker": "经纶",
                    "text": "虽然轻策庄有我们守着，不会出大问题，但是城里支援过来的物资，还是要从外面过来。"
                },
                {
                    "id": "411300107",
                    "speaker": "经纶",
                    "text": "现在这个情况，总务司也不可能分出很多人来护送…要是遇见了大群的魔物，只怕物资会有风险。"
                },
                {
                    "id": "411300108",
                    "speaker": "经纶",
                    "text": "所以，我和几个兄弟就寻思着…就算不能离开轻策庄太远，但是，轻策庄周围的那些魔物，我们还是能清理一下的。"
                },
                {
                    "id": "411300109",
                    "speaker": "经纶",
                    "text": "这样也算是给送物资过来的兄弟帮个忙了。但按照之前我们的侦察，周围的魔物聚集点还不少。"
                },
                {
                    "id": "411300110",
                    "speaker": "经纶",
                    "text": "只凭我们的话，很难把这些魔物营地迅速地全部清理干净。但如果时间拖太长了，我担心轻策庄里说不定也会出问题…"
                },
                {
                    "id": "411300111",
                    "speaker": "经纶",
                    "text": "旅行者，你愿意帮我们去清理一部分魔物吗？"
                }
            ]
        },
        {
            "id": "4113003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411300301",
                    "speaker": "经纶",
                    "text": "那只魔物就拜托你了，旅行者。"
                },
                {
                    "id": "411300302",
                    "speaker": "经纶",
                    "text": "唉，要是我能再警觉一点的话…"
                }
            ]
        }
    ]
}