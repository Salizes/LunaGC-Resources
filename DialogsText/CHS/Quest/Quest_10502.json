    "talks": [
        {
            "id": "1050201",
            "objective": "抵达蒙德城",
            "dialogues": [
                {
                    "id": "105020101",
                    "speaker": "莫娜",
                    "text": "马上就要见到那位继承者了，你准备好了吗？可别让你的师父丢脸。",
                    "choices": [
                        {
                            "id": "105020102",
                            "text": "我又不会算命…",
                            "response": [
                                {
                                    "id": "105020104",
                                    "speaker": "莫娜",
                                    "text": "也对…不对！就算是假的弟子，也不能一问三不知吧。"
                                },
                                {
                                    "id": "105020105",
                                    "speaker": "莫娜",
                                    "text": "虽然师门有规定，不得传授外人，不过…如果是你，也未尝不可。"
                                },
                                {
                                    "id": "105020106",
                                    "speaker": "莫娜",
                                    "text": "我的占星术是「水占术」，顾名思义，是通过水中的倒影观看真正的星空。"
                                },
                                {
                                    "id": "105020107",
                                    "speaker": "莫娜",
                                    "text": "让我先给你示范一下，看仔细了。"
                                },
                                {
                                    "id": "105020108",
                                    "speaker": "莫娜",
                                    "text": "就目前的星象和走势来看，嗯，那位继承者是西风骑士，年轻有为…女性…"
                                },
                                {
                                    "id": "105020109",
                                    "speaker": "派蒙",
                                    "text": "听这个描述…唔…难道是丽莎？"
                                },
                                {
                                    "id": "105020110",
                                    "speaker": "莫娜",
                                    "text": "我们马上就会在这里遇见她。"
                                },
                                {
                                    "id": "105020111",
                                    "speaker": "莫娜",
                                    "text": "好了，有这么多信息应该就足够了。",
                                    "choices": [
                                        {
                                            "id": "105020112",
                                            "text": "就，就结束了？",
                                            "response": [
                                                {
                                                    "id": "105020114",
                                                    "speaker": "莫娜",
                                                    "text": "唉，看来就算是最基础的占星术，也不是一目了然的。"
                                                },
                                                {
                                                    "id": "105020115",
                                                    "speaker": "莫娜",
                                                    "text": "算了，等会儿再详细给你讲，她已经来了。"
                                                },
                                                {
                                                    "id": "105020116",
                                                    "speaker": "可莉",
                                                    "text": "#哇，是荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！还有小派蒙，你们回来啦！"
                                                },
                                                {
                                                    "id": "105020117",
                                                    "speaker": "莫娜",
                                                    "text": "——就是她！伟大学识的继承者！",
                                                    "choices": [
                                                        {
                                                            "id": "105020118",
                                                            "text": "…你说可莉？！",
                                                            "response": [
                                                                {
                                                                    "id": "105020120",
                                                                    "speaker": "可莉",
                                                                    "text": "继承者…？"
                                                                },
                                                                {
                                                                    "id": "105020121",
                                                                    "speaker": "莫娜",
                                                                    "text": "没错，我就是那个洞悉了星海秘密的占星术士！你也早就计算出我的到来了吧。"
                                                                },
                                                                {
                                                                    "id": "105020122",
                                                                    "speaker": "可莉",
                                                                    "text": "星海？星海是什么，星海里也有鱼吗？"
                                                                },
                                                                {
                                                                    "id": "105020123",
                                                                    "speaker": "莫娜",
                                                                    "text": "鱼…？不，别装糊涂了。你是在害怕我的挑战吗？"
                                                                },
                                                                {
                                                                    "id": "105020124",
                                                                    "speaker": "可莉",
                                                                    "text": "姐姐你才是，在说什么呀！我一点都没听懂！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "105020125",
                                                                            "text": "这样聊下去会没完没了的！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "105020127",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "但我的占星术是不会错的…唔，以防万一我还是问一下，你的妈妈叫「艾莉丝」，对吗？"
                                                                                },
                                                                                {
                                                                                    "id": "105020128",
                                                                                    "speaker": "可莉",
                                                                                    "text": "对啊。哦！姐姐是妈妈的朋友啊。但是，妈妈现在去了很远的地方…"
                                                                                },
                                                                                {
                                                                                    "id": "105020129",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "这个我知道——是占星的结果。但在她走之前，应该把她懂得的神秘学知识，都留给你了吧？"
                                                                                },
                                                                                {
                                                                                    "id": "105020130",
                                                                                    "speaker": "可莉",
                                                                                    "text": "神秘学，知识…听不太懂，妈妈只教了我要怎么做蹦蹦炸弹。"
                                                                                },
                                                                                {
                                                                                    "id": "105020131",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "原来可莉的妈妈，就是莫娜师父的「朋友兼劲敌」？"
                                                                                },
                                                                                {
                                                                                    "id": "105020132",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "是的。我师父虽然很擅长占星术，但她也只懂占星术。艾莉丝就不一样了，她是精通各种神秘领域的全才…"
                                                                                },
                                                                                {
                                                                                    "id": "105020133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "所以…可莉年纪这么小，就算听了那些高深的知识，也听不懂吧。"
                                                                                },
                                                                                {
                                                                                    "id": "105020134",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "嗯，看来是只继承了血脉，还没继承知识…真是失算，这根本没法较量…"
                                                                                },
                                                                                {
                                                                                    "id": "105020135",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "对了，这位小朋友。艾莉丝走之前，告诉过你「五十年之约」，和那个箱子的事吗？"
                                                                                },
                                                                                {
                                                                                    "id": "105020136",
                                                                                    "speaker": "可莉",
                                                                                    "text": "哦哦，这个我知道！原来姐姐是来拿那个箱子的呀。我找找，等一下哦！"
                                                                                },
                                                                                {
                                                                                    "id": "105020137",
                                                                                    "speaker": "可莉",
                                                                                    "text": "不是这个…"
                                                                                },
                                                                                {
                                                                                    "id": "105020138",
                                                                                    "speaker": "可莉",
                                                                                    "text": "也不是这个…"
                                                                                },
                                                                                {
                                                                                    "id": "105020139",
                                                                                    "speaker": "可莉",
                                                                                    "text": "不对不对，这个也不是…"
                                                                                },
                                                                                {
                                                                                    "id": "105020140",
                                                                                    "speaker": "可莉",
                                                                                    "text": "啊！我想起来了，我把它和我的新宝物都藏在<color=#00E1FFFF>风起地</color>了！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "105020141",
                                                                                            "text": "不会又是炸弹吧？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "105020143",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "你们等我一下，我马上拿过来！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "105020144",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "别跑啊！你包里的东西都不要了吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "105020145",
                                                                                                    "speaker": "莫娜",
                                                                                                    "text": "我帮她收拾这些东西，你们去追她吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "105020146",
                                                                                                    "speaker": "莫娜",
                                                                                                    "text": "唉，看她这么冒冒失失的，我真担心箱子会出什么事…"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "105020142",
                                                                                            "text": "为什么总把重要的东西埋在野外…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "105020126",
                                                                            "text": "所以说绝对是搞错了…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "105020119",
                                                            "text": "绝对是搞错了！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105020113",
                                            "text": "我还没看清呢！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105020103",
                            "text": "我又不会占星…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050202",
            "objective": "与莫娜交谈，准备面见继承者",
            "dialogues": []
        },
        {
            "id": "1050203",
            "objective": "追上可莉，取回箱子",
            "dialogues": [
                {
                    "id": "105020301",
                    "speaker": "可莉",
                    "text": "我找到了，就是这个箱子。"
                },
                {
                    "id": "105020302",
                    "speaker": "派蒙",
                    "text": "没有被炸坏真是太好了。"
                },
                {
                    "id": "105020303",
                    "speaker": "可莉",
                    "text": "回收完毕，我们带回去给那个姐姐吧！"
                }
            ]
        },
        {
            "id": "1050204",
            "objective": "与可莉交谈，回收箱子",
            "dialogues": [
                {
                    "id": "105020201",
                    "speaker": "可莉",
                    "text": "到了到了，就是这里，我们来把宝物挖出来吧。",
                    "choices": [
                        {
                            "id": "105020202",
                            "text": "这一定是草史莱姆吧。",
                            "response": [
                                {
                                    "id": "105020204",
                                    "speaker": "可莉",
                                    "text": "不会的，我专门做了记号，是不会有错的——"
                                },
                                {
                                    "id": "105020205",
                                    "speaker": "可莉",
                                    "text": "呜啊，是草史莱姆！"
                                },
                                {
                                    "id": "105020206",
                                    "speaker": "Player",
                                    "text": "是草史莱姆。"
                                },
                                {
                                    "id": "105020207",
                                    "speaker": "派蒙",
                                    "text": "呃…先解决掉它们再说吧！"
                                }
                            ]
                        },
                        {
                            "id": "105020203",
                            "text": "这绝对是草史莱姆吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050205",
            "objective": "击败来袭的草史莱姆",
            "dialogues": [
                {
                    "id": "105020501",
                    "speaker": "凯瑟琳",
                    "text": "关于莫娜的来历与困境…"
                },
                {
                    "id": "105020502",
                    "speaker": "凯瑟琳",
                    "text": "原来是这样，我知道了。"
                },
                {
                    "id": "105020503",
                    "speaker": "凯瑟琳",
                    "text": "蒙德城里，有一间空着的<color=#00E1FFFF>魔法实验室</color>，但被不知道什么人施加了一个封印。"
                },
                {
                    "id": "105020504",
                    "speaker": "凯瑟琳",
                    "text": "虽然有几位专家可以解开封印，但他们都有自己的实验室了，对这件事不感兴趣。"
                },
                {
                    "id": "105020505",
                    "speaker": "凯瑟琳",
                    "text": "我觉得，如果你提到的占星术士能解开那个封印，房子的主人应该就会同意她住下吧。",
                    "choices": [
                        {
                            "id": "105020506",
                            "text": "我觉得她应该有办法。",
                            "response": [
                                {
                                    "id": "105020508",
                                    "speaker": "凯瑟琳",
                                    "text": "好的，那我这就告诉你房子的位置。"
                                }
                            ]
                        },
                        {
                            "id": "105020507",
                            "text": "我带她去看看。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050206",
            "objective": "与可莉交谈，回收箱子",
            "dialogues": []
        },
        {
            "id": "1050207",
            "objective": "陪同可莉，把箱子带给莫娜",
            "dialogues": [
                {
                    "id": "105020401",
                    "speaker": "莫娜",
                    "text": "你们终于回来了，等得我好无聊。"
                },
                {
                    "id": "105020402",
                    "speaker": "莫娜",
                    "text": "本来还想看看书打发时间，结果这居然是一本莫名其妙的日记，一点意思都没有。"
                },
                {
                    "id": "105020403",
                    "speaker": "莫娜",
                    "text": "明明是从可莉的包里掉出来的，我还以为记载了什么古代知识呢。"
                },
                {
                    "id": "105020404",
                    "speaker": "莫娜",
                    "text": "不管了，所以，箱子找到了吗？"
                },
                {
                    "id": "105020405",
                    "speaker": "可莉",
                    "text": "找到啦，完好无损！"
                },
                {
                    "id": "105020406",
                    "speaker": "莫娜",
                    "text": "那太好了——等等？！为、为什么没有锁着？！里面…呃！里面又为什么是空的啊？！"
                },
                {
                    "id": "105020407",
                    "speaker": "派蒙",
                    "text": "咦——？！"
                },
                {
                    "id": "105020408",
                    "speaker": "可莉",
                    "text": "是这样的，因为我借用了这个箱子，用来装我收集的宝贝。"
                },
                {
                    "id": "105020409",
                    "speaker": "莫娜",
                    "text": "借用？！"
                },
                {
                    "id": "105020410",
                    "speaker": "可莉",
                    "text": "现在姐姐要收回这个箱子，所以我就把我的宝贝都拿了出来，箱子就是空的了。"
                },
                {
                    "id": "105020411",
                    "speaker": "莫娜",
                    "text": "你用来装你的东西了？！…那、那原本里面装着的东西呢？我要的是那个！"
                },
                {
                    "id": "105020412",
                    "speaker": "可莉",
                    "text": "哦，姐姐原来是要以前装在箱子里面的东西…早说嘛。"
                },
                {
                    "id": "105020413",
                    "speaker": "莫娜",
                    "text": "你…该不会把它弄坏了吧？"
                },
                {
                    "id": "105020414",
                    "speaker": "可莉",
                    "text": "没有！一点都没弄坏哦。"
                },
                {
                    "id": "105020415",
                    "speaker": "莫娜",
                    "text": "呼…"
                },
                {
                    "id": "105020416",
                    "speaker": "可莉",
                    "text": "那件东西，就是姐姐手里的那本书呀。"
                },
                {
                    "id": "105020417",
                    "speaker": "莫娜",
                    "text": "咿——？！"
                },
                {
                    "id": "105020418",
                    "speaker": "莫娜",
                    "text": "这、这…原来这书，这日记…是老太婆的…难道是她五十年前的日记？！"
                },
                {
                    "id": "105020419",
                    "speaker": "莫娜",
                    "text": "时隔五十年要回收的，是她少女时代的黑历史吗？！"
                },
                {
                    "id": "105020420",
                    "speaker": "莫娜",
                    "text": "完了！难怪…！难怪老太婆说…无论如何都不能看，看了就要把我大卸八块…"
                },
                {
                    "id": "105020421",
                    "speaker": "可莉",
                    "text": "我，我是不是闯祸了…？"
                },
                {
                    "id": "105020422",
                    "speaker": "可莉",
                    "text": "啊！是姐姐说想要箱子的，没说里面东西的事情！"
                },
                {
                    "id": "105020423",
                    "speaker": "可莉",
                    "text": "我什么都不知道！我先走了！",
                    "choices": [
                        {
                            "id": "105020424",
                            "text": "真是个感人的结局…",
                            "response": [
                                {
                                    "id": "105020426",
                                    "speaker": "派蒙",
                                    "text": "唔…不过，只要莫娜不说，你的师父也不知道你看过日记了吧？"
                                },
                                {
                                    "id": "105020427",
                                    "speaker": "莫娜",
                                    "text": "不可能，占星术能看破一切谎言，你们也都见识过了。"
                                },
                                {
                                    "id": "105020428",
                                    "speaker": "莫娜",
                                    "text": "啊…花光所有摩拉来了蒙德，没有得到知识，现在也回不去了，怎么会变成这样…"
                                },
                                {
                                    "id": "105020429",
                                    "speaker": "派蒙",
                                    "text": "好可怜…要不然，就等你把书里的内容都忘光了，再回去吧？"
                                },
                                {
                                    "id": "105020430",
                                    "speaker": "莫娜",
                                    "text": "这个…太难了，而且就算我想留在蒙德城，也…",
                                    "choices": [
                                        {
                                            "id": "105020431",
                                            "text": "没有面子？",
                                            "response": [
                                                {
                                                    "id": "105020432",
                                                    "speaker": "莫娜",
                                                    "text": "是的，如果我和这些俗人生活在一起，占星术士的心境要怎么维持…"
                                                },
                                                {
                                                    "id": "105020435",
                                                    "speaker": "派蒙",
                                                    "text": "那也没办法，不然你就只能回去见你的师父。"
                                                },
                                                {
                                                    "id": "105020436",
                                                    "speaker": "莫娜",
                                                    "text": "别、别说了！那、那，就先这样吧…"
                                                },
                                                {
                                                    "id": "105020437",
                                                    "speaker": "莫娜",
                                                    "text": "我决定了，暂时住在蒙德城吧。等老太婆的命数到了尽头，我就自由了。",
                                                    "choices": [
                                                        {
                                                            "id": "105020438",
                                                            "text": "真是过分坚定的觉悟。",
                                                            "response": [
                                                                {
                                                                    "id": "105020440",
                                                                    "speaker": "莫娜",
                                                                    "text": "可是，占星术的研究要怎么办…不对，首先连住的地方都没有。"
                                                                },
                                                                {
                                                                    "id": "105020441",
                                                                    "speaker": "派蒙",
                                                                    "text": "关于这个，我们去问一下<color=#00E1FFFF>冒险家协会的凯瑟琳小姐</color>，能不能帮忙吧？"
                                                                },
                                                                {
                                                                    "id": "105020442",
                                                                    "speaker": "莫娜",
                                                                    "text": "冒险家协会？嗯…对，如果能通过接他们的委托，换取…嗯，你懂吧？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "105020443",
                                                                            "text": "了解。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "105020445",
                                                                                    "speaker": "莫娜",
                                                                                    "text": "唔，谢谢…那个，我…算了，没什么。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "105020444",
                                                                            "text": "本来也是这么打算的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "105020439",
                                                            "text": "这也算是「暂时」吗。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105020433",
                                            "text": "没有钱？",
                                            "response": [
                                                {
                                                    "id": "105020434",
                                                    "speaker": "莫娜",
                                                    "text": "是…唔，不是！你还真是不会说话啊！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105020425",
                            "text": "对可莉发脾气也是没用的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050212",
            "objective": "(test)日记出现$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1050213",
            "objective": "(test)日记消失$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1050208",
            "objective": "与凯瑟琳交谈，帮莫娜寻找住处",
            "dialogues": []
        },
        {
            "id": "1050209",
            "objective": "前往魔法实验室，查看封印",
            "dialogues": []
        },
        {
            "id": "1050210",
            "objective": "(test)解除封印$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1050211",
            "objective": "与莫娜交谈",
            "dialogues": [
                {
                    "id": "105020601",
                    "speaker": "莫娜",
                    "text": "留下这个封印的人…不简单，要暴力破解几乎是不可能的。"
                },
                {
                    "id": "105020602",
                    "speaker": "莫娜",
                    "text": "有意思，值得我用占星术计算一下了。"
                },
                {
                    "id": "105020603",
                    "speaker": "莫娜",
                    "text": "我看看，嗯…原来如此，只需要这样，然后这样…"
                },
                {
                    "id": "105020604",
                    "speaker": "莫娜",
                    "text": "好了，打开了。"
                },
                {
                    "id": "105020605",
                    "speaker": "派蒙",
                    "text": "哇，真厉害！"
                },
                {
                    "id": "105020606",
                    "speaker": "派蒙",
                    "text": "只要回去和凯瑟琳报告一下，应该就可以住进去了吧。"
                },
                {
                    "id": "105020607",
                    "speaker": "歌德",
                    "text": "不必了不必了，太谢谢你们了。"
                },
                {
                    "id": "105020608",
                    "speaker": "莫娜",
                    "text": "这位是…？"
                },
                {
                    "id": "105020609",
                    "speaker": "歌德",
                    "text": "哦，我是这栋房子的主人，歌德。刚刚路过冒险家协会的时候，凯瑟琳告诉了我这件事。"
                },
                {
                    "id": "105020610",
                    "speaker": "歌德",
                    "text": "没想到这么快，这个烦人的封印就被解开了！"
                },
                {
                    "id": "105020611",
                    "speaker": "莫娜",
                    "text": "那就是说，我可以住在这里了？"
                },
                {
                    "id": "105020612",
                    "speaker": "歌德",
                    "text": "当然当然，反正里面的设备放着也是放着，能有人发挥它们的价值，我也很开心。"
                },
                {
                    "id": "105020613",
                    "speaker": "歌德",
                    "text": "为了表示感谢，我可以用最低最低的价格，把房子租给你！"
                },
                {
                    "id": "105020614",
                    "speaker": "莫娜",
                    "text": "租、租？！"
                },
                {
                    "id": "105020615",
                    "speaker": "莫娜",
                    "text": "来之前没听说租的事，而且我还帮了忙…"
                },
                {
                    "id": "105020616",
                    "speaker": "歌德",
                    "text": "帮忙？嗯，对，我明白啊。我非常感谢你，所以租金肯定会给你最优惠的价格！"
                },
                {
                    "id": "105020617",
                    "speaker": "莫娜",
                    "text": "我、我的意思是…"
                },
                {
                    "id": "105020618",
                    "speaker": "派蒙",
                    "text": "看来莫娜有些误解，但是…",
                    "choices": [
                        {
                            "id": "105020619",
                            "text": "这可能是最好的选择了。",
                            "response": [
                                {
                                    "id": "105020621",
                                    "speaker": "莫娜",
                                    "text": "唉…也没有别的办法了，就租这里吧。"
                                },
                                {
                                    "id": "105020622",
                                    "speaker": "歌德",
                                    "text": "好！那就这么说定了，我去准备一下手续，稍等片刻吧。"
                                },
                                {
                                    "id": "105020623",
                                    "speaker": "莫娜",
                                    "text": "这次的事，谢谢了。还有就是…很对不起，答应你的事，暂时还做不到。"
                                },
                                {
                                    "id": "105020624",
                                    "speaker": "莫娜",
                                    "text": "没有占星需要的设备，也没有新的知识，想要看清你的「命运」，还需要一些时间…"
                                },
                                {
                                    "id": "105020625",
                                    "speaker": "莫娜",
                                    "text": "但我答应你，等我准备好了，我一定会第一个为你占卜的！",
                                    "choices": [
                                        {
                                            "id": "105020626",
                                            "text": "如你所说，这次旅程有益无害。",
                                            "response": [
                                                {
                                                    "id": "105020627",
                                                    "speaker": "莫娜",
                                                    "text": "谢谢你，能和你同行是我的命运——而且，算是「好运」的那一边吧。"
                                                },
                                                {
                                                    "id": "105020630",
                                                    "speaker": "莫娜",
                                                    "text": "祝你们的冒险一路顺风！我…也要想想以后的事了。"
                                                },
                                                {
                                                    "id": "105020631",
                                                    "speaker": "派蒙",
                                                    "text": "如果她不用占星术赚钱，要怎么活下去呢？"
                                                },
                                                {
                                                    "id": "105020632",
                                                    "speaker": "派蒙",
                                                    "text": "…我们还是偶尔回来看看她吧？要是饿晕在房间里，就不好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "105020628",
                                            "text": "总之先努力活下去吧。",
                                            "response": [
                                                {
                                                    "id": "105020629",
                                                    "speaker": "莫娜",
                                                    "text": "嗯…虽然我不知道该怎么办，但…我会努力的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "105020620",
                            "text": "摩拉攒一攒总是会有的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1050207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "105020701",
                    "speaker": "莫娜",
                    "text": "那箱子对我真的很重要…"
                },
                {
                    "id": "105020702",
                    "speaker": "莫娜",
                    "text": "出了任何问题，我都没法回去和老太婆交差…"
                }
            ]
        }
    ]
}