        {
            "id": "2301205",
            "objective": "向莎莉回报",
            "dialogues": [
                {
                    "id": "230120301",
                    "speaker": "莎莉",
                    "text": "你们已经把小猫带回来了啊，真是辛苦你们了。"
                },
                {
                    "id": "230120302",
                    "speaker": "莎莉",
                    "text": "看样子，你们的「猫语」学得也不错嘛。"
                },
                {
                    "id": "230120303",
                    "speaker": "莎莉",
                    "text": "这些报酬给你，请收下吧。"
                },
                {
                    "id": "230120304",
                    "speaker": "莎莉",
                    "text": "能这么快学会「猫语」的人可真难得，说不定我下次还要麻烦你帮忙呢。"
                },
                {
                    "id": "230120305",
                    "speaker": "Player",
                    "text": "喵！"
                },
                {
                    "id": "230120306",
                    "speaker": "派蒙",
                    "text": "可以说人话啦！莎莉小姐又不是猫！"
                },
                {
                    "id": "230120307",
                    "speaker": "莎莉",
                    "text": "我可以从你的表情里看出来，你想说的话是「没问题」，不过…这次你的发音可不对喔。"
                },
                {
                    "id": "230120308",
                    "speaker": "莎莉",
                    "text": "不过没关系，我以后会继续教你「猫语」的，就让我们一起来学习吧！"
                }
            ]
        },
        {
            "id": "2301201",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230120101",
                    "speaker": "莎莉",
                    "text": "喵——咳咳，咳…"
                },
                {
                    "id": "230120102",
                    "speaker": "Player",
                    "text": "你在做什么呢…"
                },
                {
                    "id": "230120103",
                    "speaker": "莎莉",
                    "text": "我正在找我家的小猫呢，平时我这么叫一下，它们就会回应我的。"
                },
                {
                    "id": "230120104",
                    "speaker": "莎莉",
                    "text": "难道是我今天的发音不对吗？叫了好久都没回应，真奇怪…",
                    "choices": [
                        {
                            "id": "230120105",
                            "text": "不能直接叫它们的名字吗…",
                            "response": [
                                {
                                    "id": "230120106",
                                    "speaker": "派蒙",
                                    "text": "对啊，一般来说找小猫的话，都应该直接叫它们的名字吧？"
                                },
                                {
                                    "id": "230120107",
                                    "speaker": "莎莉",
                                    "text": "可是，用我们人的语言来呼唤它们的名字，小猫们肯定也听不懂吧？"
                                },
                                {
                                    "id": "230120108",
                                    "speaker": "派蒙",
                                    "text": "咦？这，这么说倒是有些道理…"
                                },
                                {
                                    "id": "230120113",
                                    "speaker": "莎莉",
                                    "text": "不过，再这么喊下去也不是个办法…"
                                },
                                {
                                    "id": "230120114",
                                    "speaker": "莎莉",
                                    "text": "旅行者，我想问你一个严肃的问题…",
                                    "choices": [
                                        {
                                            "id": "230120115",
                                            "text": "就交给…",
                                            "response": [
                                                {
                                                    "id": "230120117",
                                                    "speaker": "莎莉",
                                                    "text": "…你想学「猫语」吗？"
                                                },
                                                {
                                                    "id": "230120118",
                                                    "speaker": "Player",
                                                    "text": "欸？"
                                                },
                                                {
                                                    "id": "230120119",
                                                    "speaker": "派蒙",
                                                    "text": "咦？"
                                                },
                                                {
                                                    "id": "230120120",
                                                    "speaker": "派蒙",
                                                    "text": "你是说，要教我们学猫说话吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230120116",
                                            "text": "报酬不能…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230120109",
                            "text": "什么叫做「今天的发音」不对？",
                            "response": [
                                {
                                    "id": "230120110",
                                    "speaker": "莎莉",
                                    "text": "因为我现在发出的这些喵喵声，其实就是那些小猫们的名字喔。"
                                },
                                {
                                    "id": "230120111",
                                    "speaker": "莎莉",
                                    "text": "毕竟，如果直接用人的语言来呼唤小猫们的名字，它们肯定也听不懂吧？"
                                },
                                {
                                    "id": "230120112",
                                    "speaker": "派蒙",
                                    "text": "咦？这，这么说倒是有些道理…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
