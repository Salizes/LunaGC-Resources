    "talks": [
        {
            "id": "2301201",
            "objective": "与莎莉对话",
            "dialogues": [
                {
                    "id": "230121101",
                    "speaker": "Player",
                    "text": "我之前和猫也正经交流过…"
                },
                {
                    "id": "230121102",
                    "speaker": "派蒙",
                    "text": "你是说「寝子」吗？不过寝子可是能说人话的猫啊，应该也不算「猫语」吧。"
                },
                {
                    "id": "230121103",
                    "speaker": "莎莉",
                    "text": "没错，但作为交换，你得去帮我把一只小猫带回来。",
                    "choices": [
                        {
                            "id": "230121104",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "230121108",
                                    "speaker": "莎莉",
                                    "text": "那么，你们是答应我了？那就太感谢你们了。"
                                },
                                {
                                    "id": "230121109",
                                    "speaker": "莎莉",
                                    "text": "咳，咳咳…那就请你们听好了，这是我总结了很长时间才总结出的「猫的定型语」。"
                                }
                            ]
                        },
                        {
                            "id": "230121105",
                            "text": "每个城市的找猫方式都不一样啊…",
                            "response": [
                                {
                                    "id": "230121106",
                                    "speaker": "派蒙",
                                    "text": "哈哈，哈…没错呢，这么一想，我们在好多城市里都帮人找过猫…"
                                },
                                {
                                    "id": "230121107",
                                    "speaker": "派蒙",
                                    "text": "是该说每个人都喜欢小猫呢，还是该说…每个养猫的人都会遇见一样的烦恼呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301209",
            "objective": "向莎莉确认小猫的信息",
            "dialogues": [
                {
                    "id": "230121901",
                    "speaker": "莎莉",
                    "text": "那么就拜托你了，旅行者。我就在这里等着你回来。"
                },
                {
                    "id": "230121902",
                    "speaker": "莎莉",
                    "text": "希望你能顺利和小猫说上话。"
                }
            ]
        },
        {
            "id": "2301206",
            "objective": "",
            "dialogues": [
                {
                    "id": "230121501",
                    "speaker": "莎莉",
                    "text": "今天跑出去玩的贪玩小猫是一只「黑白色」的猫，它的名字是「拉勒」。"
                },
                {
                    "id": "230121502",
                    "speaker": "莎莉",
                    "text": "用「猫语」呼唤它的话，应该是…喵，喵喵喵，喵——"
                },
                {
                    "id": "230121503",
                    "speaker": "莎莉",
                    "text": "记得音调要先下后上，最后一声喵要高高扬起。"
                },
                {
                    "id": "230121504",
                    "speaker": "莎莉",
                    "text": "唔…我给你写一张便签好了，请你稍等一下。"
                }
            ]
        },
        {
            "id": "2301207",
            "objective": "",
            "dialogues": [
                {
                    "id": "230121601",
                    "speaker": "莎莉",
                    "text": "今天跑出去找零食吃的贪吃小猫是一只「深灰色」的猫，它的名字是「纳尔吉斯」。"
                },
                {
                    "id": "230121602",
                    "speaker": "莎莉",
                    "text": "用「猫语」呼唤它的话，应该是…喵！喵喵，喵。"
                },
                {
                    "id": "230121603",
                    "speaker": "莎莉",
                    "text": "记得第一声喵要发重音，后面的喵要快速发音。"
                },
                {
                    "id": "230121604",
                    "speaker": "莎莉",
                    "text": "唔…我给你写一张便签好了，请你稍等一下。"
                }
            ]
        },
        {
            "id": "2301208",
            "objective": "",
            "dialogues": [
                {
                    "id": "230121701",
                    "speaker": "莎莉",
                    "text": "今天偷跑出去约会的小猫是一只带有「灰黑条纹」的猫，它的名字是「萝赞」。"
                },
                {
                    "id": "230121702",
                    "speaker": "莎莉",
                    "text": "用「猫语」呼唤它的话，应该是…喵喵喵，喵喵喵。"
                },
                {
                    "id": "230121703",
                    "speaker": "莎莉",
                    "text": "这两组喵声都是快速发音，记得不要拖长声调喔。"
                },
                {
                    "id": "230121704",
                    "speaker": "莎莉",
                    "text": "唔…我给你写一张便签好了，请你稍等一下。"
                }
            ]
        },
        {
            "id": "2301202",
            "objective": "寻找「拉勒」",
            "dialogues": [
                {
                    "id": "230122101",
                    "speaker": "「拉勒」",
                    "text": "喵…喵喵？"
                },
                {
                    "id": "230122102",
                    "speaker": "派蒙",
                    "text": "#该，该你喵了！{NICKNAME}！加油啊！",
                    "choices": [
                        {
                            "id": "230122103",
                            "text": "喵，喵喵喵，喵——",
                            "response": [
                                {
                                    "id": "230122104",
                                    "speaker": "「拉勒」",
                                    "text": "喵，喵喵，喵喵喵。"
                                },
                                {
                                    "id": "230122105",
                                    "speaker": "Black Screen",
                                    "text": "拉勒迅速钻进了旅行者的怀里…"
                                },
                                {
                                    "id": "230122106",
                                    "speaker": "派蒙",
                                    "text": "呜哇！好快！看上去是成功了呢…"
                                }
                            ]
                        },
                        {
                            "id": "230122107",
                            "text": "喵！喵喵，喵。",
                            "response": [
                                {
                                    "id": "230122108",
                                    "speaker": "「拉勒」",
                                    "text": "喵？喵？喵？喵！"
                                },
                                {
                                    "id": "230122109",
                                    "speaker": "Black Screen",
                                    "text": "拉勒掉过头，飞快地窜了出去…"
                                },
                                {
                                    "id": "230122110",
                                    "speaker": "派蒙",
                                    "text": "它的声音，好像不是很开心呢…难道是你发音错了吗？"
                                }
                            ]
                        },
                        {
                            "id": "230122111",
                            "text": "喵喵喵，喵喵喵。",
                            "response": [
                                {
                                    "id": "230122112",
                                    "speaker": "「拉勒」",
                                    "text": "喵？喵？喵？喵！"
                                },
                                {
                                    "id": "230122113",
                                    "speaker": "Black Screen",
                                    "text": "拉勒掉过头，飞快地窜了出去…"
                                },
                                {
                                    "id": "230122114",
                                    "speaker": "派蒙",
                                    "text": "它的声音，好像不是很开心呢…难道是你发音错了吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
