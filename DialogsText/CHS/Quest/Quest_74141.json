    "talks": [
        {
            "id": "7414101",
            "objective": "(test)判断前置任务是否完成$HIDDEN",
            "dialogues": [
                {
                    "id": "741410101",
                    "speaker": "「揭示之书」",
                    "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）"
                },
                {
                    "id": "741410102",
                    "speaker": "派蒙",
                    "text": "夏诺蒂拉好像不在呢，可能又到那个神秘的地方去了！要进行「冥想」吗？"
                },
                {
                    "id": "741410103",
                    "speaker": "Player",
                    "text": "听了她上次说的话…"
                },
                {
                    "id": "741410104",
                    "speaker": "Player",
                    "text": "有点在意。我要去看看。"
                },
                {
                    "id": "741410105",
                    "speaker": "派蒙",
                    "text": "唔…虽然有点不安，不过我们一起去吧！夏诺蒂拉真是让人担心呢！"
                },
                {
                    "id": "741410106",
                    "speaker": "Player",
                    "text": "派蒙，你在外面等我就好。"
                },
                {
                    "id": "741410107",
                    "speaker": "派蒙",
                    "text": "欸？"
                },
                {
                    "id": "741410108",
                    "speaker": "Player",
                    "text": "「揭示之书」的世界…",
                    "choices": [
                        {
                            "id": "741410109",
                            "text": "可能比想象中更危险。",
                            "response": [
                                {
                                    "id": "741410111",
                                    "speaker": "Player",
                                    "text": "所以，我不希望你冒险。"
                                },
                                {
                                    "id": "741410112",
                                    "speaker": "派蒙",
                                    "text": "但是…但是，一直以来我们不是一起冒险的吗？我们在一起，就没有克服不了的困难、战胜不了的敌人才对…"
                                },
                                {
                                    "id": "741410113",
                                    "speaker": "Player",
                                    "text": "里面的危险可能不是战斗能解决的。"
                                },
                                {
                                    "id": "741410114",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "741410115",
                                    "speaker": "派蒙",
                                    "text": "好吧！哼，你比我聪明多了，我相信你。那你可别抛下我喔！我会一直等你回来的！"
                                }
                            ]
                        },
                        {
                            "id": "741410110",
                            "text": "可能有我们不知道的一面。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414102",
