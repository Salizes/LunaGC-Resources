                    "text": "我先准备一下…"
                },
                {
                    "id": "741410302",
                    "speaker": "派蒙",
                    "text": "好喔！"
                }
            ]
        },
        {
            "id": "7414199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741419901",
                    "speaker": "Player",
                    "text": "（不是之前「冥想」抵达的地方。那边的是…）"
                },
                {
                    "id": "741419902",
                    "speaker": "卡特皮拉",
                    "text": "但我不会就这样离开。你原本的名字是…"
                }
            ]
