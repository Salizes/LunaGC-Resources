    "talks": [
        {
            "id": "7524401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752440501",
                    "speaker": "瑞安提",
                    "text": "好吧，我帮你找。"
                }
            ]
        },
        {
            "id": "7524402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752440201",
                    "speaker": "瑞安提",
                    "text": "哦呀，你找到我的帽子了？"
                },
                {
                    "id": "752440202",
                    "speaker": "Player",
                    "text": "是这个吗？"
                }
            ]
        },
        {
            "id": "7524403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752440302",
                    "speaker": "瑞安提",
                    "text": "没错！真是太感谢你了，有了这顶帽子，我一下就放心很多了。"
                },
                {
                    "id": "752440303",
                    "speaker": "瑞安提",
                    "text": "这可是我找人特制的安全帽，连铳枪的子弹都能防出去。"
                },
                {
                    "id": "752440307",
                    "speaker": "Player",
                    "text": "你多虑了，只是钓鱼而已。"
                },
                {
                    "id": "752440304",
                    "speaker": "瑞安提",
                    "text": "你不知道，之前就有个家伙在岸边钓鱼，被人在远处用箭还是铳枪之类的玩意，射瞎了一只眼，多危险啊。"
                },
                {
                    "id": "752440305",
                    "speaker": "瑞安提",
                    "text": "据说那是一伙挪德卡莱过来的土匪在内讧…但谁知道呢？既然有了这种先例，我们也还是小心为妙啊。"
                }
            ]
        },
        {
            "id": "7524404",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7524405",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7524401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752440101",
                    "speaker": "瑞安提",
                    "text": "哦呀，你也是来钓鱼的吗？要知道钓鱼啊，要戴着足够坚固的帽子才行啊。"
                },
                {
                    "id": "752440106",
                    "speaker": "Player",
                    "text": "为什么要戴帽子？"
                },
                {
                    "id": "752440102",
                    "speaker": "瑞安提",
                    "text": "因为戴帽子才安全。"
                },
                {
                    "id": "752440107",
                    "speaker": "Player",
                    "text": "可你也没戴帽子。"
                },
                {
                    "id": "752440103",
                    "speaker": "瑞安提",
                    "text": "这就是我跟你搭话的原因…真不好意思，我的帽子被风吹跑了。"
                },
                {
                    "id": "752440104",
                    "speaker": "瑞安提",
                    "text": "不介意的话，能帮我找一找吗？"
                },
                {
                    "id": "752440108",
                    "speaker": "Player",
                    "text": "为什么不自己去找？"
                },
                {
                    "id": "752440105",
                    "speaker": "瑞安提",
                    "text": "如果我去找帽子，就必须要放下鱼竿，如果我拿起鱼竿，就没法去找帽子…"
                },
                {
                    "id": "752440109",
                    "speaker": "瑞安提",
                    "text": "所以拜托你，请帮我一把吧。"
                }
            ]
        },
        {
            "id": "7524404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752440402",
                    "speaker": "瑞安提",
                    "text": "还在在乎那些土匪吗？别太担心啦，万一你真遇上了，报我的名字，你会没事的。"
                },
                {
                    "id": "752440403",
                    "speaker": "瑞安提",
                    "text": "别的就不要问了，你和我有缘，还帮我捡了帽子，就当是对你的感谢啦。"
                }
            ]
        },
        {
            "id": "7524406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752440601",
                    "speaker": "瑞安提",
                    "text": "不好意思，再见。"
                }
            ]
        }
    ]
}