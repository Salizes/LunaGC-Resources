    "talks": [
        {
            "id": "7612201",
            "objective": "同哥伦比娅见面",
            "dialogues": [
                {
                    "id": "761220101",
                    "speaker": "派蒙",
                    "text": "哥伦比娅？"
                },
                {
                    "id": "761220102",
                    "speaker": "派蒙",
                    "text": "咦？奇怪，刚刚好像听到了哥伦比娅的声音…"
                },
                {
                    "id": "761220103",
                    "speaker": "哥伦比娅",
                    "text": "…嘿！"
                },
                {
                    "id": "761220104",
                    "speaker": "派蒙",
                    "text": "噫！"
                },
                {
                    "id": "761220105",
                    "speaker": "哥伦比娅",
                    "text": "你们好。"
                },
                {
                    "id": "761220106",
                    "speaker": "派蒙",
                    "text": "不好不好，又被你吓了一大跳，你在的话怎么不早说嘛！"
                },
                {
                    "id": "761220107",
                    "speaker": "哥伦比娅",
                    "text": "我想你们已经熟悉这种游戏了，所以这次适当增加了一点难度…"
                },
                {
                    "id": "761220108",
                    "speaker": "派蒙",
                    "text": "可恶，下次我也要找机会吓你一跳！"
                },
                {
                    "id": "761220109",
                    "speaker": "哥伦比娅",
                    "text": "好呀，那我期待着。"
                },
                {
                    "id": "761220110",
                    "speaker": "Player",
                    "text": "哥伦比娅你的眼罩呢？"
                },
                {
                    "id": "761220111",
                    "speaker": "哥伦比娅",
                    "text": "哦，似乎是刚才和月灵们玩耍的时候，被它们蹭掉了。"
                },
                {
                    "id": "761220112",
                    "speaker": "哥伦比娅",
                    "text": "我平时也不用睁眼，这样没什么区别，它们喜欢的话，就让它们拿着玩玩吧。"
                },
                {
                    "id": "761220113",
                    "speaker": "派蒙",
                    "text": "话说回来，哥伦比娅不打算多去外面走走吗？"
                },
                {
                    "id": "761220114",
                    "speaker": "Player",
                    "text": "你不需要再躲着谁了吧。"
                },
                {
                    "id": "761220115",
                    "speaker": "哥伦比娅",
                    "text": "嗯…现在时间很多，想什么时候动身都行。"
                },
                {
                    "id": "761220116",
                    "speaker": "哥伦比娅",
                    "text": "但想到你们或许会来找我，不告而别的话，可能会让你们担心吧。",
                    "choices": [
                        {
                            "id": "761220117",
                            "text": "这种时候…",
                            "response": [
                                {
                                    "id": "761220119",
                                    "speaker": "派蒙",
                                    "text": "是呀是呀，只要让我们知道你没事就好。"
                                },
                                {
                                    "id": "761220120",
                                    "speaker": "哥伦比娅",
                                    "text": "好的，那我会考虑的。"
                                },
                                {
                                    "id": "761220121",
                                    "speaker": "派蒙",
                                    "text": "只是考虑而已啊…"
                                },
                                {
                                    "id": "761220122",
                                    "speaker": "Player",
                                    "text": "说不定哥伦比娅就是喜欢这里。"
                                },
                                {
                                    "id": "761220123",
                                    "speaker": "哥伦比娅",
                                    "text": "在这里发生的事，对我来说都是愉快的记忆。"
                                },
                                {
                                    "id": "761220124",
                                    "speaker": "哥伦比娅",
                                    "text": "不过，我在这等你们还有另外一个原因。"
                                },
                                {
                                    "id": "761220125",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "761220126",
                                    "speaker": "哥伦比娅",
                                    "text": "我想给你们一个惊喜。"
                                }
                            ]
                        },
                        {
                            "id": "761220118",
                            "text": "留张纸条就行了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7612205",
            "objective": "前往惊喜地点",
            "dialogues": []
        },
        {
            "id": "7612204",
            "objective": "同哥伦比娅对话",
            "dialogues": [
                {
                    "id": "761220401",
                    "speaker": "派蒙",
                    "text": "哇！这就是你们提到过的那个地方吧？上次我不在，都没能看到。"
                },
                {
                    "id": "761220402",
                    "speaker": "Player",
                    "text": "真的很漂亮。"
                },
                {
                    "id": "761220403",
                    "speaker": "派蒙",
                    "text": "我可以四处飞着看看吗？"
                },
                {
                    "id": "761220404",
                    "speaker": "哥伦比娅",
                    "text": "当然。"
                },
                {
                    "id": "761220405",
                    "speaker": "哥伦比娅",
                    "text": "喜欢的话，以后我也可以再带你们过来。"
                },
                {
                    "id": "761220406",
                    "speaker": "派蒙",
                    "text": "这就是你想给我们的惊喜吗？"
                },
                {
                    "id": "761220407",
                    "speaker": "哥伦比娅",
                    "text": "原来这种程度就算派蒙心中的惊喜了吗？但还不是。"
                },
                {
                    "id": "761220408",
                    "speaker": "Player",
                    "text": "还有比这更厉害的？"
                },
                {
                    "id": "761220409",
                    "speaker": "哥伦比娅",
                    "text": "我们来作画吧。"
                },
                {
                    "id": "761220410",
                    "speaker": "派蒙",
                    "text": "在这里画画吗？可是哪里有画布、画笔和颜料呀？"
                },
                {
                    "id": "761220411",
                    "speaker": "哥伦比娅",
                    "text": "很简单。"
                },
                {
                    "id": "761220412",
                    "speaker": "哥伦比娅",
                    "text": "将水面纺作画布，月光织作画笔，你我途经的轨迹就会构成画作的轮廓。"
                },
                {
                    "id": "761220413",
                    "speaker": "「少女」",
                    "text": "顺着月之倒影的指引，将纯净的意念流转到脚下。"
                }
            ]
        },
        {
            "id": "7612202",
            "objective": "跟随月之指引，绘制图案",
            "dialogues": [
                {
                    "id": "761220201",
                    "speaker": "努昂诺塔",
                    "text": "……！"
                },
                {
                    "id": "761220202",
                    "speaker": "派蒙",
                    "text": "努昂诺塔！真的是水灵灵的努昂诺塔！我还以为再也见不到你了。"
                },
                {
                    "id": "761220203",
                    "speaker": "Player",
                    "text": "刚才的画作…"
                },
                {
                    "id": "761220204",
                    "speaker": "哥伦比娅",
                    "text": "我们用月光为这孩子勾勒出了形体，我在其中注入了新的力量与赐福，让它再度诞生。"
                },
                {
                    "id": "761220205",
                    "speaker": "哥伦比娅",
                    "text": "现在的它无须承载我的灵魂，它拥有独属于它自己的意志。"
                },
                {
                    "id": "761220206",
                    "speaker": "努昂诺塔",
                    "text": "！！"
                },
                {
                    "id": "761220207",
                    "speaker": "派蒙",
                    "text": "啊，它飞过来了！"
                },
                {
                    "id": "761220208",
                    "speaker": "哥伦比娅",
                    "text": "嗯，我唤醒了它与你们共度时光里的所有记忆。"
                },
                {
                    "id": "761220210",
                    "speaker": "努昂诺塔",
                    "text": "……！……！"
                },
                {
                    "id": "761220211",
                    "speaker": "派蒙",
                    "text": "呜，太好了努昂诺塔，今后我一定会对你更加好一点。"
                },
                {
                    "id": "761220212",
                    "speaker": "派蒙",
                    "text": "没想到是这个惊喜…我好喜欢。"
                },
                {
                    "id": "761220213",
                    "speaker": "Player",
                    "text": "谢谢你，哥伦比娅。"
                },
                {
                    "id": "761220214",
                    "speaker": "哥伦比娅",
                    "text": "没什么。能再次见到努昂诺塔，我也很高兴。"
                },
                {
                    "id": "761220216",
                    "speaker": "努昂诺塔",
                    "text": "……！"
                },
                {
                    "id": "761220217",
                    "speaker": "哥伦比娅",
                    "text": "……"
                },
                {
                    "id": "761220218",
                    "speaker": "Player",
                    "text": "（她还是那么中意努昂诺塔，但她的神情和从前相比又有不同。）"
                },
                {
                    "id": "761220219",
                    "speaker": "Player",
                    "text": "（好像它之于她不仅是被创造的眷属，更是熟悉的朋友。）"
                },
                {
                    "id": "761220220",
                    "speaker": "哥伦比娅",
                    "text": "#去吧，你一定很想{M#他}{F#她}们了吧。"
                },
                {
                    "id": "761220221",
                    "speaker": "努昂诺塔",
                    "text": "……！"
                },
                {
                    "id": "761220222",
                    "speaker": "哥伦比娅",
                    "text": "随时欢迎你们再来。"
                }
            ]
        },
        {
            "id": "7612203",
            "objective": "同哥伦比娅对话",
            "dialogues": []
        },
        {
            "id": "7612206",
            "objective": "返回「银月之庭」",
            "dialogues": []
        },
        {
            "id": "7612203",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761220301",
                    "speaker": "哥伦比娅",
                    "text": "#我知道你很喜欢{NICKNAME}和派蒙，但不要给{M#他}{F#她}们添麻烦哦。"
                },
                {
                    "id": "761220303",
                    "speaker": "「少女」",
                    "text": "#要是和{M#他}{F#她}们在外面玩累了的话，就回来这里休息吧。"
                },
                {
                    "id": "761220302",
                    "speaker": "努昂诺塔",
                    "text": "……！"
                }
            ]
        }
    ]
}