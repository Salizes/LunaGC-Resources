        {
            "id": "7103715",
            "objective": "返回勘探队营地",
            "dialogues": [
                {
                    "id": "710371501",
                    "speaker": "派蒙",
                    "text": "唔，瑾武姐之前提到的应该就是这几处地方了，我们回去找她吧！"
                }
            ]
        },
        {
            "id": "7103716",
            "objective": "与志琼交谈",
            "dialogues": [
                {
                    "id": "710371101",
                    "speaker": "志琼",
                    "text": "多谢前辈的帮助，请收下这个。"
                },
                {
                    "id": "710371102",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "710371103",
                    "speaker": "志琼",
                    "text": "哈哈，前辈不用这么客气啦，反正是海迪夫出钱…嘘，小声点，别被那个须弥小气鬼听见啦。"
                },
                {
                    "id": "710371104",
                    "speaker": "志琼",
                    "text": "咳咳…抱歉，我们去找瑾武姐吧？之前一路上的许多疑问，或许可以借助她的经验解答呢。"
                },
                {
                    "id": "710371105",
                    "speaker": "志琼",
                    "text": "就像前辈在雪山那样…瑾武姐虽然不太愿意提起，但她年轻时也是矿上的传奇人物呢…咳咳…"
                },
                {
                    "id": "710371106",
                    "speaker": "志琼",
                    "text": "听说她为千岩军的搜救队引路，从险境救出了许多矿工…哈哈，不过那些旧事我就不提啦，免得她生气。"
                },
                {
                    "id": "710371107",
                    "speaker": "志琼",
                    "text": "好了，我就不啰嗦强留你啦。"
                }
            ]
        },
