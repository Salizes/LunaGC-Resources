    "talks": [
        {
            "id": "7103701",
            "objective": "进入层岩巨渊矿洞",
            "dialogues": [
                {
                    "id": "710370101",
                    "speaker": "志琼",
                    "text": "呼，好久没有下来过了…是矿下熟悉的空气。"
                },
                {
                    "id": "710370102",
                    "speaker": "瑾武",
                    "text": "可不要太懈怠了，小琼。我怎么闻到了不熟悉的气味呢？"
                },
                {
                    "id": "710370103",
                    "speaker": "志琼",
                    "text": "毕竟我们又不能直接跳下来…摇摇晃晃的起重机太让人分心了。"
                },
                {
                    "id": "710370104",
                    "speaker": "瑾武",
                    "text": "你呀…还是在地面上时间长了。"
                },
                {
                    "id": "710370105",
                    "speaker": "派蒙",
                    "text": "我怎么什么都没闻到呀…你们矿工，鼻子都这么灵吗…？"
                },
                {
                    "id": "710370106",
                    "speaker": "志琼",
                    "text": "哈哈，在矿下鼻子不灵的话可是会要命的。不过现在还好啦，团雀们还很有精神呢。"
                },
                {
                    "id": "710370107",
                    "speaker": "瑾武",
                    "text": "看那边，流明晶石都长到这里来了…上次下矿时还没有延伸到这边。"
                },
                {
                    "id": "710370108",
                    "speaker": "志琼",
                    "text": "真的呀，我们一起去看看吧！"
                },
                {
                    "id": "710370109",
                    "speaker": "派蒙",
                    "text": "唔…总感觉有人抢了我的话…"
                }
            ]
        },
        {
            "id": "7103702",
            "objective": "与勘探队成员对话",
            "dialogues": []
        },
        {
            "id": "7103703",
            "objective": "调查营地附近的「流明晶石」",
            "dialogues": [
                {
                    "id": "710370301",
                    "speaker": "瑾武",
                    "text": "啊，你们回来了。"
                },
                {
                    "id": "710370302",
                    "speaker": "Player",
                    "text": "老何留下了些信息。"
                },
                {
                    "id": "710370303",
                    "speaker": "瑾武",
                    "text": "哦？他还真留了些东西！来，告诉我吧。"
                },
                {
                    "id": "710370306",
                    "speaker": "Black Screen",
                    "text": "你们向瑾武具言了此前寻到的信息。"
                },
                {
                    "id": "710370304",
                    "speaker": "瑾武",
                    "text": "嗯…黑色「熔岩」…流明石…蘑菇…？"
                },
                {
                    "id": "710370305",
                    "speaker": "瑾武",
                    "text": "哼…真是邪门，似曾相识的邪门。我们也别在这里久留了，一起动身去营地吧。"
                }
            ]
        },
        {
            "id": "7103704",
            "objective": "与志琼、瑾武进行交谈",
            "dialogues": [
                {
                    "id": "710370201",
                    "speaker": "瑾武",
                    "text": "没想到流明晶石会出现在距离地面这么近的地方…我本以为这些东西不会增生在结构比较脆弱的位置。"
                },
                {
                    "id": "710370202",
                    "speaker": "志琼",
                    "text": "它们是地下那个「东西」的碎片，沿着岩石的脉络而迁移，最终来到了这里。"
                },
                {
                    "id": "710370203",
                    "speaker": "瑾武",
                    "text": "别乱说。它们就是本地的岩石，之所以变成这样，只是因为经历了某种转化作用，形成了结晶而已。"
                },
                {
                    "id": "710370204",
                    "speaker": "瑾武",
                    "text": "「七星」委托我们做过分析…成分上大部分还是层岩巨渊本地的矿物，但只是…受到外力影响，重构成了奇特的结晶。"
                },
                {
                    "id": "710370205",
                    "speaker": "派蒙",
                    "text": "#快看，那块晶石和{NICKNAME}身上的「触媒」似乎差不多呢！"
                },
                {
                    "id": "710370231",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}也快把流明石「触媒」拿出来看看吧？"
                },
                {
                    "id": "710370232",
                    "speaker": "瑾武",
                    "text": "没错，流明石「触媒」和此种晶石实际上是同一种东西。其结构一致，自然会彼此共鸣。",
                    "choices": [
                        {
                            "id": "710370206",
                            "text": "好邪门…",
                            "response": [
                                {
                                    "id": "710370208",
                                    "speaker": "派蒙",
                                    "text": "喂，你就只会说这个吗！"
                                },
                                {
                                    "id": "710370209",
                                    "speaker": "瑾武",
                                    "text": "你们先不要吵架啦…"
                                },
                                {
                                    "id": "710370210",
                                    "speaker": "Player",
                                    "text": "我们没有吵架…"
                                },
                                {
                                    "id": "710370211",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}没有在和我吵架啦…"
                                },
                                {
                                    "id": "710370212",
                                    "speaker": "瑾武",
                                    "text": "我是说，我没在关心你们有没有吵架，志琼和我要在前方布置一个临时的前进营地，这段时间请不要到处乱跑。"
                                },
                                {
                                    "id": "710370213",
                                    "speaker": "瑾武",
                                    "text": "我们刚刚发现的结晶，对于接下来的探险十分有用，如果接下来再有新发现，请务必通知我。"
                                },
                                {
                                    "id": "710370214",
                                    "speaker": "瑾武",
                                    "text": "我的手艺还没有生疏，可以替你们精加工一下这些粗糙的原晶…对后面的冒险很有用处。"
                                },
                                {
                                    "id": "710370215",
                                    "speaker": "瑾武",
                                    "text": "嗯，还有就是…不要吵架。"
                                },
                                {
                                    "id": "710370216",
                                    "speaker": "派蒙",
                                    "text": "知道啦！"
                                },
                                {
                                    "id": "710370217",
                                    "speaker": "Player",
                                    "text": "知道了。"
                                },
                                {
                                    "id": "710370218",
                                    "speaker": "瑾武",
                                    "text": "真乖，等下给你们发糖。对了，如果你们在附近遇到了什么奇怪的东西，请及时回来报告。"
                                },
                                {
                                    "id": "710370219",
                                    "speaker": "志琼",
                                    "text": "对了，上次瑾武姐说的，关于老何的事情…"
                                },
                                {
                                    "id": "710370220",
                                    "speaker": "瑾武",
                                    "text": "#我还没忘呢。既然{NICKNAME}也来了，就麻烦再帮我一个忙吧。"
                                },
                                {
                                    "id": "710370221",
                                    "speaker": "瑾武",
                                    "text": "老何是我们矿上的前辈，前些年层岩巨渊疏散矿工时，他是不幸失踪的其中一个…他耳朵背，也许没注意到警报。"
                                },
                                {
                                    "id": "710370222",
                                    "speaker": "瑾武",
                                    "text": "辉山厅与盛露厅的抚恤也到位了，他家里也把白事办好了…不过我还是不信邪，我总觉得他还活在矿下某个地方。"
                                },
                                {
                                    "id": "710370223",
                                    "speaker": "瑾武",
                                    "text": "老何他算是资深矿工啦…如何规避矿难、如何逃生、如何等待救援，等等等等…他懂得可多了，也教了我不少。"
                                },
                                {
                                    "id": "710370224",
                                    "speaker": "瑾武",
                                    "text": "所以我相信，这么久了，他一定还在哪里活着…可不能放弃搜救才行。"
                                },
                                {
                                    "id": "710370225",
                                    "speaker": "瑾武",
                                    "text": "稍后我给你们指出几个方位，是矿工撤离前老何曾经所在的工作地点…说不定在那边还能找到什么线索。"
                                },
                                {
                                    "id": "710370226",
                                    "speaker": "志琼",
                                    "text": "至于我呢，就先去矿洞深处勘察啦！"
                                },
                                {
                                    "id": "710370233",
                                    "speaker": "瑾武",
                                    "text": "对了，别忘了你们的糖！",
                                    "choices": [
                                        {
                                            "id": "710370227",
                                            "text": "你不一起来吗？",
                                            "response": [
                                                {
                                                    "id": "710370228",
                                                    "speaker": "瑾武",
                                                    "text": "她还要为我们绘制地图，层岩巨渊的地下结构错综复杂，没有地图可不行。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710370229",
                                            "text": "注意安全。",
                                            "response": [
                                                {
                                                    "id": "710370230",
                                                    "speaker": "志琼",
                                                    "text": "没关系的啦，我也不是新手了。请你尽管放心吧，前辈！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710370207",
                            "text": "好神奇…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103723",
            "objective": "隐藏控制刷出流明石$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7103724",
            "objective": "隐藏控制激活流明石$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7103705",
            "objective": "寻找关于老何的线索$HIDDEN",
            "dialogues": [
                {
                    "id": "710370501",
                    "speaker": "志琼",
                    "text": "#啊，是{NICKNAME}前辈，你们来了！",
                    "choices": [
                        {
                            "id": "710370502",
                            "text": "瑾武有事嘱咐…",
                            "response": [
                                {
                                    "id": "710370503",
                                    "speaker": "志琼",
                                    "text": "又是那套安全叮嘱吧？唉…我听都听烦啦。"
                                },
                                {
                                    "id": "710370504",
                                    "speaker": "志琼",
                                    "text": "我从小也是在矿上长大的，矿坑里的危险哪有不知道的？"
                                },
                                {
                                    "id": "710370505",
                                    "speaker": "志琼",
                                    "text": "至于那些未知的事物，长辈们总是喜欢借经验来判断是否危险…然后反过来用结果来证明自己的经验。"
                                },
                                {
                                    "id": "710370506",
                                    "speaker": "志琼",
                                    "text": "我是受够他们这种自大了…我相信身为冒险家的前辈你，也是一样吧？"
                                },
                                {
                                    "id": "710370507",
                                    "speaker": "志琼",
                                    "text": "如果霞姐一味警告你雪山的危险，而前辈就听信了，就这样裹足不前的话，那得错过多少精彩的冒险呀！"
                                },
                                {
                                    "id": "710370508",
                                    "speaker": "志琼",
                                    "text": "好啦——不要再劝我了，我不想和前辈为这种小事吵起来…唔，我们换个话题吧？"
                                },
                                {
                                    "id": "710370509",
                                    "speaker": "志琼",
                                    "text": "前辈你看，我现在正在勘探这里的地形，以便绘制地图…"
                                },
                                {
                                    "id": "710370512",
                                    "speaker": "志琼",
                                    "text": "只不过…之前在探索矿洞的时候，前路被几处奇怪的异变点阻挡了…"
                                },
                                {
                                    "id": "710370513",
                                    "speaker": "志琼",
                                    "text": "如果能够取样或者拍下照的话，总务司与冒险家协会应该都会很高兴的。"
                                },
                                {
                                    "id": "710370514",
                                    "speaker": "志琼",
                                    "text": "说来丢人…下矿时我的留影机不小心摔坏了，所以只能仰赖前辈高超的摄影技巧啦。"
                                },
                                {
                                    "id": "710370515",
                                    "speaker": "志琼",
                                    "text": "还有另一些地点…嗯，这里和这里，有盗宝团的踪迹…"
                                },
                                {
                                    "id": "710370516",
                                    "speaker": "派蒙",
                                    "text": "什么呀…完全看不出哪里是哪里！"
                                },
                                {
                                    "id": "710370517",
                                    "speaker": "Player",
                                    "text": "只是几个叉号和几条线呢…"
                                },
                                {
                                    "id": "710370518",
                                    "speaker": "志琼",
                                    "text": "哈哈，抱歉抱歉…只是自己习惯，就忘记不是人人都有制图师的直觉了。"
                                },
                                {
                                    "id": "710370519",
                                    "speaker": "志琼",
                                    "text": "不过没关系，我会随前辈一起去，给你们指路的。"
                                },
                                {
                                    "id": "710370520",
                                    "speaker": "志琼",
                                    "text": "这几处地点，我们先去解决哪里都可以的。",
                                    "choices": [
                                        {
                                            "id": "710370521",
                                            "text": "那我们就出发吧。"
                                        },
                                        {
                                            "id": "710370522",
                                            "text": "路上你要小心安全。",
                                            "response": [
                                                {
                                                    "id": "710370523",
                                                    "speaker": "志琼",
                                                    "text": "谢谢前辈关心！我明白的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710370510",
                            "text": "你在这里做什么呢？",
                            "response": [
                                {
                                    "id": "710370511",
                                    "speaker": "志琼",
                                    "text": "嗯…我刚刚说了呀，我在勘探地形，绘制地图。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103706",
            "objective": "寻找关于老何的线索",
            "dialogues": [
                {
                    "id": "710371001",
                    "speaker": "日志的残片",
                    "text": "「…光线暗下来了…我的晶石灯还能用大概四个小时…」"
                },
                {
                    "id": "710371002",
                    "speaker": "日志的残片",
                    "text": "「…食物不多了，凭借记忆还能找到滤水器的所在，但必须尽快找到新的光源才行…」"
                },
                {
                    "id": "710371003",
                    "speaker": "日志的残片",
                    "text": "「…看到荧光在飘动，或者，在走动？可能是缺氧导致的幻觉…」"
                }
            ]
        },
        {
            "id": "7103707",
            "objective": "寻找关于老何的线索",
            "dialogues": [
                {
                    "id": "710371201",
                    "speaker": "日志的残片",
                    "text": "「…从地下深处渗上来了奇怪的黑色熔岩，也许不是熔岩。总之看起来很不妙，没有敢靠近…」"
                },
                {
                    "id": "710371202",
                    "speaker": "日志的残片",
                    "text": "「…去了更深处探索，带回了一些奇怪的蘑菇…无法确定能否食用…」"
                },
                {
                    "id": "710371203",
                    "speaker": "日志的残片",
                    "text": "「…『熔岩』吸引了一些元素生物…如果它们能吃的话，或许我也能…」"
                },
                {
                    "id": "710371204",
                    "speaker": "日志的残片",
                    "text": "「…不对，不太妙。那些小东西变得不太对劲了，尽快离开这里，这东西显然不能当成食物…」"
                },
                {
                    "id": "710371205",
                    "speaker": "日志的残片",
                    "text": "「…如果习惯的话，蘑菇的味道还不错…继续往生着蘑菇的地方前进，接下来就去那边扎营好了…」"
                }
            ]
        },
        {
            "id": "7103708",
            "objective": "寻找关于老何的线索",
            "dialogues": [
                {
                    "id": "710371401",
                    "speaker": "日志的残片",
                    "text": "「…一靠近黑色『熔岩』，就会思维紊乱、五感敏感，情绪易怒。但来到这块晶石附近就能缓解不少…」"
                },
                {
                    "id": "710371402",
                    "speaker": "日志的残片",
                    "text": "「…听说瑾武小妹她们那边的什么『触媒』可以从这些晶石里汲取能量，等出去上到地面，一定要找她好好问问…」"
                },
                {
                    "id": "710371403",
                    "speaker": "日志的残片",
                    "text": "「…耳朵仍然痒，听到有人叫我，她说深处有水，有蘑菇…」"
                },
                {
                    "id": "710371404",
                    "speaker": "日志的残片",
                    "text": "「…妈呀，可能我要疯掉了…」"
                }
            ]
        },
        {
            "id": "7103721",
            "objective": "隐藏回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7103709",
            "objective": "向瑾武回报老何留下的线索",
            "dialogues": []
        },
        {
            "id": "7103725",
            "objective": "前往勘探队营地",
            "dialogues": []
        },
        {
            "id": "7103710",
            "objective": "前往勘探队营地",
            "dialogues": []
        },
        {
            "id": "7103711",
            "objective": "与瑾武交谈",
            "dialogues": [
                {
                    "id": "710370401",
                    "speaker": "瑾武",
                    "text": "就是这里了…奇怪，志琼那娃子在哪里…"
                },
                {
                    "id": "710370402",
                    "speaker": "瑾武",
                    "text": "志琼，志琼！"
                },
                {
                    "id": "710370403",
                    "speaker": "瑾武",
                    "text": "唉…对，那娃子又自顾自跑到矿洞深处画地图了…",
                    "choices": [
                        {
                            "id": "710370404",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "710370407",
                                    "speaker": "瑾武",
                                    "text": "刚刚你们离开的时候，她画了这幅地图。"
                                },
                                {
                                    "id": "710370408",
                                    "speaker": "瑾武",
                                    "text": "她应该又跑去深处探险了。请替我告诉她一声，前方很危险，不要冒冒失失地甩下大家自己一个人乱撞…"
                                },
                                {
                                    "id": "710370409",
                                    "speaker": "瑾武",
                                    "text": "…如果再惹出什么麻烦拖累大家，瑾武姐的拳头是不会留情的。"
                                },
                                {
                                    "id": "710370410",
                                    "speaker": "派蒙",
                                    "text": "呜哇…好凶恶…"
                                },
                                {
                                    "id": "710370411",
                                    "speaker": "Player",
                                    "text": "好凶恶…"
                                },
                                {
                                    "id": "710370412",
                                    "speaker": "瑾武",
                                    "text": "好啦，两位也不要闲着。要么帮我布置营地，要么去前面探路。"
                                },
                                {
                                    "id": "710370413",
                                    "speaker": "瑾武",
                                    "text": "抱歉，我不太会说客气话…总之，至少要对大家有用。"
                                },
                                {
                                    "id": "710370414",
                                    "speaker": "瑾武",
                                    "text": "啊，顺便一提，如果你们在路上看见了流明石的原晶，就请带给我吧。"
                                },
                                {
                                    "id": "710370415",
                                    "speaker": "瑾武",
                                    "text": "我会想办法把它们加工成更有效用的「触媒」。根据我的经验…这些东西在矿下会很有用的。"
                                }
                            ]
                        },
                        {
                            "id": "710370405",
                            "text": "志琼有危险了？",
                            "response": [
                                {
                                    "id": "710370406",
                                    "speaker": "瑾武",
                                    "text": "现在还没…哼，不过她如果再不通知我就乱跑的话，她的屁股就有危险了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
