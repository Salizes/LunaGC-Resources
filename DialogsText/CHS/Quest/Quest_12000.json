    "talks": [
        {
            "id": "1200001",
            "objective": "前往璃月港「万文集舍」",
            "dialogues": []
        },
        {
            "id": "1200003",
            "objective": "向纪芳打听游览指南",
            "dialogues": [
                {
                    "id": "120000301",
                    "speaker": "纪芳",
                    "text": "啊，随便看看吧，不买也行。"
                },
                {
                    "id": "120000302",
                    "speaker": "派蒙",
                    "text": "我们是来找书的，这里有没有《提瓦特游览指南》的璃月篇呢？"
                },
                {
                    "id": "120000303",
                    "speaker": "纪芳",
                    "text": "哦，这本书很久以前就不卖了，没什么人气。"
                },
                {
                    "id": "120000304",
                    "speaker": "派蒙",
                    "text": "欸？！明明蒙德篇那么有趣…太可惜了！"
                },
                {
                    "id": "120000305",
                    "speaker": "纪芳",
                    "text": "这书的作者太有个性了，说是指南，但其实起不到什么指南的作用。"
                },
                {
                    "id": "120000306",
                    "speaker": "纪芳",
                    "text": "不仅卖不出去，我曾经还因为这书被游客投诉过。",
                    "choices": [
                        {
                            "id": "120000307",
                            "text": "个人风格太强烈了吗…",
                            "response": [
                                {
                                    "id": "120000309",
                                    "speaker": "派蒙",
                                    "text": "但我还是觉得很可惜，蒙德篇当成冒险日记来读也很有趣啊…"
                                },
                                {
                                    "id": "120000310",
                                    "speaker": "纪芳",
                                    "text": "反正我这里现在已经没有了，如果实在想看，可以去常九爷那儿碰碰运气。"
                                },
                                {
                                    "id": "120000311",
                                    "speaker": "派蒙",
                                    "text": "常九爷？"
                                },
                                {
                                    "id": "120000312",
                                    "speaker": "纪芳",
                                    "text": "他住在轻策庄，收藏各种书籍。虽然脾气不太好，但聊到藏书还是很健谈的。"
                                },
                                {
                                    "id": "120000313",
                                    "speaker": "纪芳",
                                    "text": "他还在璃月港的时候就是我的老主顾了，现在我有时也会给他寄两本绝版藏书…"
                                },
                                {
                                    "id": "120000324",
                                    "speaker": "纪芳",
                                    "text": "不过他住的地方很难找，要先沿着轻策庄后山的栈道一路爬上去…"
                                },
                                {
                                    "id": "120000314",
                                    "speaker": "？？？",
                                    "text": "你说，绝版藏书？"
                                },
                                {
                                    "id": "120000315",
                                    "speaker": "？？？",
                                    "text": "那已经绝版的《神霄折戟录》第六卷，也可能在他的收藏之中？",
                                    "choices": [
                                        {
                                            "id": "120000316",
                                            "text": "你是谁啊？",
                                            "response": [
                                                {
                                                    "id": "120000318",
                                                    "speaker": "行秋",
                                                    "text": "失礼了，在下行秋，只是一个偶然路过的爱书人。"
                                                },
                                                {
                                                    "id": "120000319",
                                                    "speaker": "行秋",
                                                    "text": "既然你我都在寻书，那何不一同前往轻策山，拜访这位常九爷呢？",
                                                    "choices": [
                                                        {
                                                            "id": "120000320",
                                                            "text": "有道理，那就麻烦你带路了。",
                                                            "response": [
                                                                {
                                                                    "id": "120000321",
                                                                    "speaker": "行秋",
                                                                    "text": "都是爱书之人，不必客气。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120000322",
                                                            "text": "其实我没想跑这么远…",
                                                            "response": [
                                                                {
                                                                    "id": "120000323",
                                                                    "speaker": "行秋",
                                                                    "text": "别这么说嘛，这璃月港分外嘈杂，偶尔也要去清静之地透透气。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120000317",
                                            "text": "神出鬼没的，吓死了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120000308",
                            "text": "是某些条目在教唆犯罪吗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200004",
            "objective": "前往轻策庄后山，拜访常九爷",
            "dialogues": []
        },
        {
            "id": "1200005",
            "objective": "与常九爷对话",
            "dialogues": [
                {
                    "id": "120000501",
                    "speaker": "常九爷",
                    "text": "唉，天要亡我啊…天要…亡我…"
                },
                {
                    "id": "120000502",
                    "speaker": "Player",
                    "text": "请问你就是常九爷吗？"
                },
                {
                    "id": "120000503",
                    "speaker": "常九爷",
                    "text": "嗯，有事吗？有事快说。"
                },
                {
                    "id": "120000504",
                    "speaker": "派蒙",
                    "text": "听说你这里有很多绝版的藏书，我们想借《提瓦特游览指南》的璃月篇看一看。"
                },
                {
                    "id": "120000505",
                    "speaker": "常九爷",
                    "text": "唉，别跟我提书的事了，我都快烦死了。"
                },
                {
                    "id": "120000506",
                    "speaker": "常九爷",
                    "text": "层岩巨渊封锁以后，我家矿石生意很不好做，「愚人众」还在下黑手…"
                },
                {
                    "id": "120000507",
                    "speaker": "常九爷",
                    "text": "为了筹货款，我只能把我的爱书都拿去当了…！你知道这意味什么吗？！",
                    "choices": [
                        {
                            "id": "120000508",
                            "text": "…没书看了很难过？",
                            "response": [
                                {
                                    "id": "120000510",
                                    "speaker": "常九爷",
                                    "text": "不对！是我的人生！我倾尽一生收藏的！保护的！我的藏书，没了！！"
                                },
                                {
                                    "id": "120000511",
                                    "speaker": "常九爷",
                                    "text": "唉…算了，冲着你们大吼大叫也没什么意义。早点筹钱把书赎回来才是真的。"
                                },
                                {
                                    "id": "120000512",
                                    "speaker": "常九爷",
                                    "text": "没其他事的话，我也没心情聊天。走吧走吧。"
                                },
                                {
                                    "id": "120000513",
                                    "speaker": "行秋",
                                    "text": "莫非，连《神霄折戟录》的第六卷，也当掉了？"
                                },
                                {
                                    "id": "120000514",
                                    "speaker": "常九爷",
                                    "text": "哦？想不到会听到这个名字…你还挺有品味的。"
                                },
                                {
                                    "id": "120000515",
                                    "speaker": "派蒙",
                                    "text": "意思是我们没有品味吗？！"
                                },
                                {
                                    "id": "120000516",
                                    "speaker": "常九爷",
                                    "text": "这可是具有时代意义的一本奇书，当年刚推出的时候不被任何人看好…"
                                },
                                {
                                    "id": "120000517",
                                    "speaker": "常九爷",
                                    "text": "但它改变了很多人对武侠小说的印象，之后也出现了大批的模仿者。"
                                },
                                {
                                    "id": "120000518",
                                    "speaker": "常九爷",
                                    "text": "最初的一版数量非常少，几乎一下子就绝版了。"
                                },
                                {
                                    "id": "120000519",
                                    "speaker": "行秋",
                                    "text": "在后来的加印版本中，作为补充故事的第六卷，不知为何并没有再版的机会。"
                                },
                                {
                                    "id": "120000520",
                                    "speaker": "常九爷",
                                    "text": "对对对，就是这样！因为存世数量非常之少，无论我再怎么缺钱，也舍不得当掉啊。"
                                },
                                {
                                    "id": "120000521",
                                    "speaker": "行秋",
                                    "text": "这么说，这本书还在你的手上？！"
                                },
                                {
                                    "id": "120000522",
                                    "speaker": "常九爷",
                                    "text": "嗯，这是我剩下的唯一一本爱书了…"
                                },
                                {
                                    "id": "120000523",
                                    "speaker": "昌虎",
                                    "text": "喂，老常！"
                                },
                                {
                                    "id": "120000524",
                                    "speaker": "昌虎",
                                    "text": "磨磨蹭蹭的，是我家老爷给你脸了？那批石珀，究竟是卖还是不卖？！"
                                },
                                {
                                    "id": "120000525",
                                    "speaker": "昌虎",
                                    "text": "惹恼了茂才公，就等于惹恼了「愚人众」，这道理总该明白吧。"
                                },
                                {
                                    "id": "120000526",
                                    "speaker": "常九爷",
                                    "text": "啊，又是你…"
                                },
                                {
                                    "id": "120000527",
                                    "speaker": "常九爷",
                                    "text": "可我也不能三折来卖这一批石珀啊，那样的话…我可能再也赎不回我的书了…"
                                },
                                {
                                    "id": "120000528",
                                    "speaker": "昌虎",
                                    "text": "那我不管，你是要看书还是要吃饭？还是想带着书进棺材提前躺好？"
                                },
                                {
                                    "id": "120000529",
                                    "speaker": "常九爷",
                                    "text": "呃，你…唉…"
                                },
                                {
                                    "id": "120000530",
                                    "speaker": "行秋",
                                    "text": "话不能这么讲，这位兄台。买卖讲究一个你情我愿，哪里有强买强卖的道理。"
                                },
                                {
                                    "id": "120000531",
                                    "speaker": "昌虎",
                                    "text": "你又是从哪儿冒出来的？关你什么事！"
                                },
                                {
                                    "id": "120000532",
                                    "speaker": "行秋",
                                    "text": "在下路见不平行侠仗义之人，古华派，行秋。"
                                },
                                {
                                    "id": "120000533",
                                    "speaker": "昌虎",
                                    "text": "噗…噗哈哈哈——！"
                                },
                                {
                                    "id": "120000534",
                                    "speaker": "昌虎",
                                    "text": "古华派，他说古华派！哈哈哈——！听见了吗？这年头还有人提古华派！"
                                },
                                {
                                    "id": "120000535",
                                    "speaker": "昌虎",
                                    "text": "不过是个断了香火、摇摇欲坠的小门派吧？就这还敢行侠仗义？"
                                },
                                {
                                    "id": "120000536",
                                    "speaker": "行秋",
                                    "text": "正义和身份可没什么关系，你只不过是个狐假虎威的小家丁，不是一样在作恶吗？"
                                },
                                {
                                    "id": "120000537",
                                    "speaker": "昌虎",
                                    "text": "你…你！行啊，你给我等着！看我有没有本事收拾你！"
                                },
                                {
                                    "id": "120000538",
                                    "speaker": "昌虎",
                                    "text": "还有你，老常！这批矿你不卖也得卖！"
                                },
                                {
                                    "id": "120000539",
                                    "speaker": "常九爷",
                                    "text": "唉，虎落平阳被犬欺。这日子是过不下去了啊。"
                                },
                                {
                                    "id": "120000540",
                                    "speaker": "行秋",
                                    "text": "那话说回来吧，究竟能否将书借给我呢？",
                                    "choices": [
                                        {
                                            "id": "120000541",
                                            "text": "你这也太漠不关心了。",
                                            "response": [
                                                {
                                                    "id": "120000543",
                                                    "speaker": "常九爷",
                                                    "text": "算了算了，我也不指望别人能操心我。看你刚刚帮我说了话的份儿上，拿着书快滚吧。"
                                                },
                                                {
                                                    "id": "120000544",
                                                    "speaker": "行秋",
                                                    "text": "非常感谢！我盼这书三载有余，予书之恩，行秋必报。"
                                                },
                                                {
                                                    "id": "120000545",
                                                    "speaker": "常九爷",
                                                    "text": "行了行了，记得把书还给我就行。我对古华派弟子可没什么期待…"
                                                },
                                                {
                                                    "id": "120000546",
                                                    "speaker": "派蒙",
                                                    "text": "喂喂！你这就走了？什么都还没搞清楚呢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120000542",
                                            "text": "稍微看一下现场气氛啊…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120000509",
                            "text": "…没书看了很无聊？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200006",
            "objective": "寻找借书离开的行秋",
            "dialogues": [
                {
                    "id": "120000601",
                    "speaker": "派蒙",
                    "text": "站在这里看书就是你行侠仗义的方式吗？"
                },
                {
                    "id": "120000602",
                    "speaker": "行秋",
                    "text": "有意思，有意思，原来还发生了这样的事…"
                },
                {
                    "id": "120000603",
                    "speaker": "派蒙",
                    "text": "喂，听我说话啦！"
                },
                {
                    "id": "120000604",
                    "speaker": "行秋",
                    "text": "原来如此，备受追捧果然是有原因的啊。"
                },
                {
                    "id": "120000608",
                    "speaker": "派蒙",
                    "text": "喂——",
                    "choices": [
                        {
                            "id": "120000605",
                            "text": "刚才来势汹汹的那帮人…",
                            "response": [
                                {
                                    "id": "120000607",
                                    "speaker": "派蒙",
                                    "text": "是啊，不能以超低价买到矿石，就要让常九爷吃苦头，他们简直和强盗没区别！",
                                    "choices": [
                                        {
                                            "id": "120000609",
                                            "text": "我们得想办法帮帮常九爷。",
                                            "response": [
                                                {
                                                    "id": "120000610",
                                                    "speaker": "行秋",
                                                    "text": "可别把我排除在外。"
                                                },
                                                {
                                                    "id": "120000613",
                                                    "speaker": "派蒙",
                                                    "text": "你这不是听得到我们说话吗！"
                                                },
                                                {
                                                    "id": "120000614",
                                                    "speaker": "行秋",
                                                    "text": "借来这书，只是我觉得常九爷走投无路，最后还是会当掉它，那就太可惜了。"
                                                },
                                                {
                                                    "id": "120000615",
                                                    "speaker": "行秋",
                                                    "text": "对常九爷说的话，我可不只是说说而已，既然他有恩于我，那我必定报答，此乃侠义。"
                                                },
                                                {
                                                    "id": "120000616",
                                                    "speaker": "行秋",
                                                    "text": "这书由我代为保管，而他的其他藏书，我也会帮他赎回来。",
                                                    "choices": [
                                                        {
                                                            "id": "120000617",
                                                            "text": "你想到办法了？",
                                                            "response": [
                                                                {
                                                                    "id": "120000619",
                                                                    "speaker": "行秋",
                                                                    "text": "当然有办法，我已经有头绪了，现在只需要考虑考虑细节。"
                                                                },
                                                                {
                                                                    "id": "120000620",
                                                                    "speaker": "行秋",
                                                                    "text": "嗯，容我思考一番，不需要太长的时间…"
                                                                },
                                                                {
                                                                    "id": "120000621",
                                                                    "speaker": "昌虎",
                                                                    "text": "居然还敢待在这儿，你以为我真的只是吓唬吓唬你？"
                                                                },
                                                                {
                                                                    "id": "120000622",
                                                                    "speaker": "昌虎",
                                                                    "text": "豆花派要人没人，要本事没本事，就胆子还不小。"
                                                                },
                                                                {
                                                                    "id": "120000623",
                                                                    "speaker": "昌虎",
                                                                    "text": "哦，搞错了，古华派！古华派，对吧？"
                                                                },
                                                                {
                                                                    "id": "120000624",
                                                                    "speaker": "行秋",
                                                                    "text": "有道是「蚍蜉撼大树，可笑不自量」。"
                                                                },
                                                                {
                                                                    "id": "120000625",
                                                                    "speaker": "昌虎",
                                                                    "text": "啊？拽什么文辞呢？"
                                                                },
                                                                {
                                                                    "id": "120000626",
                                                                    "speaker": "行秋",
                                                                    "text": "请回吧，强买强卖的事我是不容的，何况还是于我有恩的常九爷。"
                                                                },
                                                                {
                                                                    "id": "120000627",
                                                                    "speaker": "昌虎",
                                                                    "text": "你小子，看来又想帮老常出头？"
                                                                },
                                                                {
                                                                    "id": "120000628",
                                                                    "speaker": "昌虎",
                                                                    "text": "那你可找错时候了，看，今天有「愚人众」的大人为我撑腰，几十个古华派加起来也得罪不起！"
                                                                },
                                                                {
                                                                    "id": "120000629",
                                                                    "speaker": "行秋",
                                                                    "text": "在下虽年少，也行走江湖数年，面对恶者又何曾惧过？"
                                                                },
                                                                {
                                                                    "id": "120000630",
                                                                    "speaker": "昌虎",
                                                                    "text": "那就给你点教训吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120000618",
                                                            "text": "我不觉得你有办法…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120000611",
                                            "text": "看来璃月篇是看不成了。",
                                            "response": [
                                                {
                                                    "id": "120000612",
                                                    "speaker": "行秋",
                                                    "text": "同是求书，你们这么轻易就要放弃了？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120000606",
                            "text": "那帮人自称是帮茂才公做事？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200009",
            "objective": "击败来袭的愚人众",
            "dialogues": []
        },
        {
            "id": "1200011",
            "objective": "(test)击败来袭的愚人众$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1200010",
            "objective": "(test)击败来袭的愚人众$HIDDEN",
            "dialogues": [
                {
                    "id": "120001001",
                    "speaker": "昌虎",
                    "text": "还以为腰上那个只是普通的玉石…没想到居然是「神之眼」！"
                },
                {
                    "id": "120001002",
                    "speaker": "昌虎",
                    "text": "今、今天就先放过你！咱们走着瞧！这事没完！"
                },
                {
                    "id": "120001022",
                    "speaker": "行秋",
                    "text": "唉，指望他们吸取教训，是不可能的吧。",
                    "choices": [
                        {
                            "id": "120001003",
                            "text": "你居然有「神之眼」…",
                            "response": [
                                {
                                    "id": "120001004",
                                    "speaker": "行秋",
                                    "text": "嗯，只不过以「神之眼」退敌有恃强凌弱之嫌，所以我不太喜欢用。"
                                },
                                {
                                    "id": "120001008",
                                    "speaker": "派蒙",
                                    "text": "他们现在走了，但肯定会再来找麻烦。"
                                },
                                {
                                    "id": "120001009",
                                    "speaker": "行秋",
                                    "text": "我知道，我不会害了我的恩人，商有商道，这件事我会负责到底。"
                                },
                                {
                                    "id": "120001010",
                                    "speaker": "行秋",
                                    "text": "「愚人众」平常不会站在某个商人一边，但看那家丁的嚣张态度，应该所言非虚。"
                                },
                                {
                                    "id": "120001011",
                                    "speaker": "行秋",
                                    "text": "这其中多半是有更深的勾结。"
                                },
                                {
                                    "id": "120001012",
                                    "speaker": "行秋",
                                    "text": "刚才他们提到的「茂才公」，这名号我也听过，他的宅子在璃月港很显眼，拜托你们去打探些线索吧。"
                                },
                                {
                                    "id": "120001013",
                                    "speaker": "派蒙",
                                    "text": "道理是有道理的…那你要干什么呢？"
                                },
                                {
                                    "id": "120001014",
                                    "speaker": "行秋",
                                    "text": "我？我还有其他想要了解的事，我想想…等下我们就在璃月港的玉京台见吧。"
                                },
                                {
                                    "id": "120001015",
                                    "speaker": "派蒙",
                                    "text": "真的吗？不会只是想使唤我们去跑腿吧？"
                                },
                                {
                                    "id": "120001016",
                                    "speaker": "行秋",
                                    "text": "哦哦，竟然发生了这样的事，这一段真是妙，妙不可言！"
                                },
                                {
                                    "id": "120001017",
                                    "speaker": "派蒙",
                                    "text": "唔唔唔！气死我了！我可以打他吗！",
                                    "choices": [
                                        {
                                            "id": "120001018",
                                            "text": "还是要先帮常九爷。",
                                            "response": [
                                                {
                                                    "id": "120001020",
                                                    "speaker": "派蒙",
                                                    "text": "好吧，但每个惹我生气的人我都要给他取个难听的绰号！"
                                                },
                                                {
                                                    "id": "120001021",
                                                    "speaker": "派蒙",
                                                    "text": "就叫他「书呆子」好了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120001019",
                                            "text": "君子报仇，十年不晚。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120001005",
                            "text": "其实古华派是藏龙卧虎之地？！",
                            "response": [
                                {
                                    "id": "120001006",
                                    "speaker": "行秋",
                                    "text": "不不不，你误会了，刚才那人的话虽不堪入耳，但对古华派的评价…其实也不算错…唉。"
                                },
                                {
                                    "id": "120001007",
                                    "speaker": "行秋",
                                    "text": "虽然我有重振山门之愿，但这也非一朝一夕之功。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120000201",
                    "speaker": "派蒙",
                    "text": "「万文集舍」…这里是璃月港的书店吧。"
                },
                {
                    "id": "120000202",
                    "speaker": "派蒙",
                    "text": "要不要问问这里有没有《提瓦特游览指南》的璃月篇？那书超有意思的！"
                }
            ]
        },
        {
            "id": "1200042",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120004201",
                    "speaker": "行秋",
                    "text": "《神霄折戟录》第六卷，我对它心念已久了。"
                },
                {
                    "id": "120004202",
                    "speaker": "行秋",
                    "text": "若真能寻到这本书，那路再远都不算什么。"
                }
            ]
        },
        {
            "id": "6100451",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "610045101",
                    "speaker": "行秋",
                    "text": "哈哈哈，有趣，真是有趣，或许这也是一种侠义吧。"
                },
                {
                    "id": "610045102",
                    "speaker": "派蒙",
                    "text": "不管我们说什么他都听不见的样子…"
                }
            ]
        }
    ]
}