    "talks": [
        {
            "id": "102201",
            "objective": "前往「碎雪」标注的地点",
            "dialogues": []
        },
        {
            "id": "102202",
            "objective": "查看愚人众的研究",
            "dialogues": [
                {
                    "id": "10220201",
                    "speaker": "派蒙",
                    "text": "这里有好多符咒，还有好几叠空白的纸，会是做什么用的呢？",
                    "choices": [
                        {
                            "id": "10220202",
                            "text": "看起来是在抄写符咒上的图案。",
                            "response": [
                                {
                                    "id": "10220204",
                                    "speaker": "派蒙",
                                    "text": "这上面的图案，似乎在哪见过…"
                                },
                                {
                                    "id": "10220205",
                                    "speaker": "派蒙",
                                    "text": "我想起来了，「公子」给你的那张「百无禁忌箓」，确实也长这样呢。"
                                },
                                {
                                    "id": "10220206",
                                    "speaker": "派蒙",
                                    "text": "嗯…这种和仙人有关的信物，为什么会落到「公子」手里，也确实相当可疑。"
                                },
                                {
                                    "id": "10220207",
                                    "speaker": "Player",
                                    "text": "而且，不止是「信物」…"
                                },
                                {
                                    "id": "10220208",
                                    "speaker": "派蒙",
                                    "text": "对哦，留云借风真君说过，岩王爷当年造「百无禁忌箓」的时候，不是当作信物来用的。"
                                },
                                {
                                    "id": "10220209",
                                    "speaker": "派蒙",
                                    "text": "这种符咒最初的用途，是在魔神战争当中，用来发挥神力…"
                                },
                                {
                                    "id": "10220210",
                                    "speaker": "派蒙",
                                    "text": "愚人众这样抄写「百无禁忌箓」，是想尝试用什么方法来引导出类似真品的效果吗？"
                                },
                                {
                                    "id": "10220211",
                                    "speaker": "派蒙",
                                    "text": "在战争中发挥神力的效果…唔，听起来很凶险。",
                                    "choices": [
                                        {
                                            "id": "10220212",
                                            "text": "看来愚人众还有大计划。",
                                            "response": [
                                                {
                                                    "id": "10220214",
                                                    "speaker": "派蒙",
                                                    "text": "真复杂…总之，以后要对「公子」更多防备一些了吧。"
                                                },
                                                {
                                                    "id": "10220215",
                                                    "speaker": "派蒙",
                                                    "text": "好了，在这里折腾了这么久，和钟离约好再见的时间也差不多快到了。"
                                                },
                                                {
                                                    "id": "10220216",
                                                    "speaker": "派蒙",
                                                    "text": "「送仙典仪筹办之旅」的最后一站…记得是在荻花洲吧？"
                                                },
                                                {
                                                    "id": "10220217",
                                                    "speaker": "派蒙",
                                                    "text": "快走吧，别迟到啦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10220213",
                                            "text": "给我的那张，只是大计划的副产物吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10220203",
                            "text": "可能是想复制真品。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102203",
            "objective": "去荻花洲见钟离",
            "dialogues": [
                {
                    "id": "10220301",
                    "speaker": "钟离",
                    "text": "你们很准时嘛，我也刚到不久。"
                },
                {
                    "id": "10220302",
                    "speaker": "钟离",
                    "text": "群玉阁好玩吗？"
                },
                {
                    "id": "10220303",
                    "speaker": "派蒙",
                    "text": "超——大！超华丽，超贵，是我见过最贵的建筑！"
                },
                {
                    "id": "10220304",
                    "speaker": "钟离",
                    "text": "确实。群玉阁若称第二，璃月便无人敢称第一。"
                },
                {
                    "id": "10220305",
                    "speaker": "钟离",
                    "text": "你们应该见过凝光了。聊得如何？"
                },
                {
                    "id": "10220306",
                    "speaker": "派蒙",
                    "text": "她好有钱，好慷慨，是很亲切的人！"
                },
                {
                    "id": "10220307",
                    "speaker": "Player",
                    "text": "但「亲切」也是商人的武器。"
                },
                {
                    "id": "10220308",
                    "speaker": "派蒙",
                    "text": "#嗯…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}对凝光的看法和我不一样。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}觉得，还是那位说话过于直白的「玉衡星」更加可信一些。"
                },
                {
                    "id": "10220309",
                    "speaker": "钟离",
                    "text": "哦？你们还遇到刻晴了？她对你们说了什么吗？"
                },
                {
                    "id": "10220310",
                    "speaker": "派蒙",
                    "text": "她说，「『仙人』的时代已经过去了，如果连『璃月七星』都不敢正视这一点，那璃月的未来要怎么办啊？」"
                },
                {
                    "id": "10220311",
                    "speaker": "钟离",
                    "text": "哈哈哈…不敬仙神。"
                },
                {
                    "id": "10220312",
                    "speaker": "钟离",
                    "text": "的确，比起什么话都敢说的刻晴，同为七星，还是凝光更像一位典型的商人。"
                },
                {
                    "id": "10220313",
                    "speaker": "钟离",
                    "text": "虽然亲切，但你无法确定她是百分之百的真诚。",
                    "choices": [
                        {
                            "id": "10220314",
                            "text": "凝光是个有谋略的人。",
                            "response": [
                                {
                                    "id": "10220316",
                                    "speaker": "钟离",
                                    "text": "嗯，她能坐上今天的位置，全靠自己。这样的人物，必定有其超凡之处。"
                                },
                                {
                                    "id": "10220317",
                                    "speaker": "钟离",
                                    "text": "我听说，不断扩建的「群玉阁」正是她志向的体现，是她人生中第二重要的东西。哪怕放弃天权之位，她也不会放弃群玉阁。"
                                },
                                {
                                    "id": "10220318",
                                    "speaker": "派蒙",
                                    "text": "群玉阁是第二位？那排第一位的呢？"
                                },
                                {
                                    "id": "10220319",
                                    "speaker": "钟离",
                                    "text": "当然是摩拉了。",
                                    "choices": [
                                        {
                                            "id": "10220320",
                                            "text": "很有道理。",
                                            "response": [
                                                {
                                                    "id": "10220322",
                                                    "speaker": "派蒙",
                                                    "text": "对了，她找我们说的最多的事，是关于「愚人众」的。她说帝君遇害以后，愚人众一直在璃月搅混水，可坏了。"
                                                },
                                                {
                                                    "id": "10220323",
                                                    "speaker": "钟离",
                                                    "text": "「愚人众」历来如此，我一点都不觉得意外。"
                                                },
                                                {
                                                    "id": "10220324",
                                                    "speaker": "Player",
                                                    "text": "而且他们正在仿制百无禁忌箓。"
                                                },
                                                {
                                                    "id": "10220325",
                                                    "speaker": "钟离",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "10220326",
                                                    "speaker": "钟离",
                                                    "text": "不论「愚人众」在图谋什么，总之，与他们打交道时，凡事都多留个心眼吧。"
                                                },
                                                {
                                                    "id": "10220327",
                                                    "speaker": "派蒙",
                                                    "text": "说起来，荻花洲也有送仙典仪要用的东西吗？"
                                                },
                                                {
                                                    "id": "10220328",
                                                    "speaker": "钟离",
                                                    "text": "对，我们今天要找的是野生的琉璃百合。"
                                                },
                                                {
                                                    "id": "10220329",
                                                    "speaker": "派蒙",
                                                    "text": "琉璃百合？为什么要来这里找啊？明明玉京台的园林里就有很多…我听说轻策庄也有一些。"
                                                },
                                                {
                                                    "id": "10220330",
                                                    "speaker": "派蒙",
                                                    "text": "对了，我记得我们遇到萍姥姥的时候，她就在看花。不如直接去问萍姥姥要吧。"
                                                },
                                                {
                                                    "id": "10220331",
                                                    "speaker": "钟离",
                                                    "text": "不…那都是人工培育的，并不合用。"
                                                },
                                                {
                                                    "id": "10220332",
                                                    "speaker": "钟离",
                                                    "text": "琉璃百合曾经大量生长在荻花洲，是一种欢欣的花，会聆听人们的歌声。"
                                                },
                                                {
                                                    "id": "10220333",
                                                    "speaker": "钟离",
                                                    "text": "魔神战争前，荻花洲还是片陆地。是战争引来山崩，才让这里被大水淹没，变为湿地，令琉璃百合几乎绝种。"
                                                },
                                                {
                                                    "id": "10220334",
                                                    "speaker": "钟离",
                                                    "text": "现在，城里还保留了一些人工培育的品类。但只有极少数人知道，其实野生琉璃百合还没完全灭绝…"
                                                },
                                                {
                                                    "id": "10220335",
                                                    "speaker": "钟离",
                                                    "text": "这种琉璃百合香气浓郁，碾成粉末以后放在永生香的香炉里，才是完整的「送仙」传统。"
                                                },
                                                {
                                                    "id": "10220336",
                                                    "speaker": "钟离",
                                                    "text": "不过，想采这种花，还需要你的帮助。",
                                                    "choices": [
                                                        {
                                                            "id": "10220337",
                                                            "text": "需要我劳动吗？",
                                                            "response": [
                                                                {
                                                                    "id": "10220338",
                                                                    "speaker": "钟离",
                                                                    "text": "不，我要你对那些花唱歌，来提升它的香气。"
                                                                },
                                                                {
                                                                    "id": "10220341",
                                                                    "speaker": "派蒙",
                                                                    "text": "#呃…{NICKNAME}，你唱歌的水平怎么样？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "10220342",
                                                                            "text": "略通一二。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10220344",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "是吗？有点不信…"
                                                                                },
                                                                                {
                                                                                    "id": "10220345",
                                                                                    "speaker": "钟离",
                                                                                    "text": "效果如何，一试便知。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10220343",
                                                                            "text": "我超会的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10220339",
                                                            "text": "需要我…唱歌吗？",
                                                            "response": [
                                                                {
                                                                    "id": "10220340",
                                                                    "speaker": "钟离",
                                                                    "text": "没错，你的歌声一定能让花的香味提升到极致。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10220321",
                                            "text": "我不意外。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10220315",
                            "text": "凝光是个有志向的人。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102204",
            "objective": "随钟离寻找野生琉璃百合",
            "dialogues": [
                {
                    "id": "10220401",
                    "speaker": "派蒙",
                    "text": "是时候一展歌喉了，加油！"
                },
                {
                    "id": "10220402",
                    "speaker": "Player",
                    "text": "咳咳。"
                },
                {
                    "id": "10220403",
                    "speaker": "Player",
                    "text": "♪…♪♪♪♪…♪♪♪♪…♪♪"
                }
            ]
        },
        {
            "id": "102205",
            "objective": "击败来袭的魔物",
            "dialogues": []
        },
        {
            "id": "102206",
            "objective": "(test)甘雨对话，获得异种琉璃百合$HIDDEN",
            "dialogues": [
                {
                    "id": "10220601",
                    "speaker": "派蒙",
                    "text": "它们根本不是琉璃百合，琉璃百合怎么会打人！"
                },
                {
                    "id": "10220602",
                    "speaker": "Player",
                    "text": "超乎想象的敌人…"
                },
                {
                    "id": "10220603",
                    "speaker": "钟离",
                    "text": "这是一种叫做「骗骗花」的魔物。"
                },
                {
                    "id": "10220604",
                    "speaker": "钟离",
                    "text": "嗯？这些花瓣…？有点意思。"
                },
                {
                    "id": "10220605",
                    "speaker": "钟离",
                    "text": "用于伪装的琉璃百合，与「骗骗花」一起埋了太久，反倒成了极好的药材。因祸得福…把这些花瓣收起来吧。"
                },
                {
                    "id": "10220606",
                    "speaker": "派蒙",
                    "text": "还有这种好事？那这些花瓣可以用在送仙典仪上吗？"
                },
                {
                    "id": "10220607",
                    "speaker": "钟离",
                    "text": "很遗憾，不能。"
                },
                {
                    "id": "10220608",
                    "speaker": "派蒙",
                    "text": "啊，怎么这样——"
                },
                {
                    "id": "10220609",
                    "speaker": "甘雨",
                    "text": "请问…"
                },
                {
                    "id": "10220610",
                    "speaker": "甘雨",
                    "text": "你们是在找琉璃百合吗？"
                },
                {
                    "id": "10220611",
                    "speaker": "派蒙",
                    "text": "啊！是你！呃、呃…糟糕，想不起名字…",
                    "choices": [
                        {
                            "id": "10220612",
                            "text": "你好啊，甘雨。",
                            "response": [
                                {
                                    "id": "10220613",
                                    "speaker": "甘雨",
                                    "text": "你好，旅行者，没想到你还记得我的名字。"
                                },
                                {
                                    "id": "10220617",
                                    "speaker": "甘雨",
                                    "text": "说起来，二位的「群玉阁」之行，感受如何？"
                                },
                                {
                                    "id": "10220618",
                                    "speaker": "派蒙",
                                    "text": "因为你没告诉我们怎么上去，所以我们费了好大力气才找到路呢！"
                                },
                                {
                                    "id": "10220619",
                                    "speaker": "甘雨",
                                    "text": "哎哎哎？我、我没说吗？！"
                                },
                                {
                                    "id": "10220620",
                                    "speaker": "派蒙",
                                    "text": "我们靠自己打听来的！",
                                    "choices": [
                                        {
                                            "id": "10220621",
                                            "text": "因为并不是秘密，所以没提吧。",
                                            "response": [
                                                {
                                                    "id": "10220623",
                                                    "speaker": "甘雨",
                                                    "text": "是…是的呢。"
                                                },
                                                {
                                                    "id": "10220624",
                                                    "speaker": "甘雨",
                                                    "text": "（完了，我竟然忘记说了…）"
                                                },
                                                {
                                                    "id": "10220625",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？感觉甘雨脸色不太对劲的样子。"
                                                },
                                                {
                                                    "id": "10220626",
                                                    "speaker": "派蒙",
                                                    "text": "而且比起第一次见面的时候，连气质也不太一样…好像没有当时的那种严肃感了？"
                                                },
                                                {
                                                    "id": "10220627",
                                                    "speaker": "甘雨",
                                                    "text": "啊…因为那时是「天权星使者」的身份，但现在只是在看花。"
                                                },
                                                {
                                                    "id": "10220628",
                                                    "speaker": "派蒙",
                                                    "text": "看花？为什么不在城里看，要跑到这种地方来呢？"
                                                },
                                                {
                                                    "id": "10220629",
                                                    "speaker": "甘雨",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "10220630",
                                                    "speaker": "甘雨",
                                                    "text": "玉京台是帝君逝去之地，在那里看花，是很令人寂寞的。"
                                                },
                                                {
                                                    "id": "10220631",
                                                    "speaker": "甘雨",
                                                    "text": "最近这几天，我在玉京台附近办公时，都会把窗户关上，以免望见窗外的风景…"
                                                },
                                                {
                                                    "id": "10220632",
                                                    "speaker": "派蒙",
                                                    "text": "唔…对不起，我不该提起这个话题。"
                                                },
                                                {
                                                    "id": "10220633",
                                                    "speaker": "甘雨",
                                                    "text": "不…是我自己没能整理好自己的心情。"
                                                },
                                                {
                                                    "id": "10220634",
                                                    "speaker": "甘雨",
                                                    "text": "两千年前魔神战争结束，最初的七神曾在璃月相聚，与帝君对饮…而今神位更迭，酒会上的七神已逝五神。"
                                                },
                                                {
                                                    "id": "10220635",
                                                    "speaker": "Player",
                                                    "text": "也就是说…"
                                                },
                                                {
                                                    "id": "10220636",
                                                    "speaker": "甘雨",
                                                    "text": "是的，既然帝君魂归高天，那最初的七神，就只剩蒙德的巴巴托斯大人尚在尘世了。"
                                                },
                                                {
                                                    "id": "10220666",
                                                    "speaker": "甘雨",
                                                    "text": "其余五位，包括稻妻的那位雷电将军，都已不是两千年前的故人。"
                                                },
                                                {
                                                    "id": "10220637",
                                                    "speaker": "甘雨",
                                                    "text": "现今的「尘世七执政」，须弥的草之神最年轻，只有五百岁。而岩王帝君在世最久，已有六千余年。"
                                                },
                                                {
                                                    "id": "10220638",
                                                    "speaker": "甘雨",
                                                    "text": "所以，三千七百年历史的璃月，从建立之初就已是帝君统治，从未经历过与神灵的「辞行」…"
                                                },
                                                {
                                                    "id": "10220639",
                                                    "speaker": "钟离",
                                                    "text": "那么，你对这场「辞行」，有何看法？"
                                                },
                                                {
                                                    "id": "10220640",
                                                    "speaker": "甘雨",
                                                    "text": "哎？突然这么问，我也…"
                                                },
                                                {
                                                    "id": "10220641",
                                                    "speaker": "甘雨",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "10220642",
                                                    "speaker": "甘雨",
                                                    "text": "作为「人」，我至今也无法想象，失去了帝君的璃月会变成什么样…"
                                                },
                                                {
                                                    "id": "10220643",
                                                    "speaker": "甘雨",
                                                    "text": "但作为「仙」…我想，我迟早还是会接受事实的。既然帝君逝去，那么仙神与璃月立下「契约」的时代，在事实上就已走向终结了。"
                                                },
                                                {
                                                    "id": "10220644",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？你说…作为「仙」？"
                                                },
                                                {
                                                    "id": "10220645",
                                                    "speaker": "甘雨",
                                                    "text": "我…我是人类与麒麟的混血，有一半仙人的血统，在魔神战争时也为帝君、为璃月出过一份力。"
                                                },
                                                {
                                                    "id": "10220646",
                                                    "speaker": "甘雨",
                                                    "text": "战争终结以后，我与帝君签下「契约」，开始担任历代七星的秘书，就这样一直到了今天。",
                                                    "choices": [
                                                        {
                                                            "id": "10220647",
                                                            "text": "怪不得你脑袋上有角！",
                                                            "response": [
                                                                {
                                                                    "id": "10220649",
                                                                    "speaker": "甘雨",
                                                                    "text": "咳…咳咳。还是聊些其他的吧。你们刚才说，是来找琉璃百合…"
                                                                },
                                                                {
                                                                    "id": "10220650",
                                                                    "speaker": "甘雨",
                                                                    "text": "我也知道野生琉璃百合所藏的位置，刚好摘了一株。不嫌弃的话，请收下它。"
                                                                },
                                                                {
                                                                    "id": "10220651",
                                                                    "speaker": "钟离",
                                                                    "text": "那就恭敬不如从命了。"
                                                                },
                                                                {
                                                                    "id": "10220652",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？那你摘之前唱过歌了吗？"
                                                                },
                                                                {
                                                                    "id": "10220653",
                                                                    "speaker": "甘雨",
                                                                    "text": "是的，这种传统我自然也很清楚。请放心，我唱的是璃月本地的民谣。"
                                                                },
                                                                {
                                                                    "id": "10220654",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇，你也很内行呢。谢谢你，甘雨！"
                                                                },
                                                                {
                                                                    "id": "10220655",
                                                                    "speaker": "甘雨",
                                                                    "text": "不，是我该感谢你们。若不是这次偶遇，我也没想到自己能为「辞行久远之躯」的仪式，送上一份心意。"
                                                                },
                                                                {
                                                                    "id": "10220656",
                                                                    "speaker": "甘雨",
                                                                    "text": "我该回去工作了，祝你们一切顺利。"
                                                                },
                                                                {
                                                                    "id": "10220657",
                                                                    "speaker": "钟离",
                                                                    "text": "这样一来，「送仙典仪」所需的各种筹备，基本都完成了。"
                                                                },
                                                                {
                                                                    "id": "10220658",
                                                                    "speaker": "钟离",
                                                                    "text": "摘花这件事，在各种意义上都很方便，做起来没有困难，所以才把它留在了最后。"
                                                                },
                                                                {
                                                                    "id": "10220659",
                                                                    "speaker": "Player",
                                                                    "text": "钟离的性格，是适合开荒的类型。"
                                                                },
                                                                {
                                                                    "id": "10220660",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，他要是在璃月做生意的话，应该会很享受创业的生活吧？"
                                                                },
                                                                {
                                                                    "id": "10220661",
                                                                    "speaker": "钟离",
                                                                    "text": "哈哈…我也确实有过那种日子。"
                                                                },
                                                                {
                                                                    "id": "10220662",
                                                                    "speaker": "钟离",
                                                                    "text": "创业、开荒…万事开头难，投注的情感也多。等到一切运转如常，久而久之，情感就会逐渐「磨损」。"
                                                                },
                                                                {
                                                                    "id": "10220663",
                                                                    "speaker": "钟离",
                                                                    "text": "「磨损」得多了，就要重新审视自己。若不小心处理，灵魂就会留下裂纹，无法挽回。"
                                                                },
                                                                {
                                                                    "id": "10220664",
                                                                    "speaker": "派蒙",
                                                                    "text": "看吧！这种语气，一听就是过来人！"
                                                                },
                                                                {
                                                                    "id": "10220665",
                                                                    "speaker": "派蒙",
                                                                    "text": "好了，既然事情都搞定了，我们也该回璃月港啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10220648",
                                                            "text": "怪不得你会忘记说该说的事！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10220622",
                                            "text": "我们不该走冤枉路，问一下就好了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10220614",
                            "text": "你好啊，王小美。",
                            "response": [
                                {
                                    "id": "10220615",
                                    "speaker": "甘雨",
                                    "text": "王小美？那、那是谁啊？"
                                },
                                {
                                    "id": "10220616",
                                    "speaker": "甘雨",
                                    "text": "甘雨和王小美，根本一个字都没记对吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "102207",
            "objective": "返回璃月港外",
            "dialogues": []
        },
        {
            "id": "102208",
            "objective": "打听消息",
            "dialogues": [
                {
                    "id": "10220801",
                    "speaker": "菲利克斯",
                    "text": "喔，是「往生堂」的客卿，钟离先生吧。"
                },
                {
                    "id": "10220802",
                    "speaker": "菲利克斯",
                    "text": "千岩军正在对我们严加监视，现在是非常时期，你可别轻举妄动。"
                },
                {
                    "id": "10220803",
                    "speaker": "钟离",
                    "text": "非常时期？"
                },
                {
                    "id": "10220804",
                    "speaker": "菲利克斯",
                    "text": "「绝云间」的仙人终于动身了。他们此来，恐怕来意不善。"
                },
                {
                    "id": "10220805",
                    "speaker": "钟离",
                    "text": "是为兴师问罪么？"
                },
                {
                    "id": "10220806",
                    "speaker": "菲利克斯",
                    "text": "多半是这样。听说七星中的几位，早早地带人前去迎接…嘿，说是迎接，不如说想要把仙人阻拦在城外吧。"
                },
                {
                    "id": "10220807",
                    "speaker": "菲利克斯",
                    "text": "但双方态度都很强硬，一时陷入了僵局。"
                },
                {
                    "id": "10220808",
                    "speaker": "钟离",
                    "text": "…事情走到这一步，也是必然。"
                },
                {
                    "id": "10220809",
                    "speaker": "菲利克斯",
                    "text": "仙人不认七星，只认与岩神的「契约」。如果他们决定强攻，这璃月港恐怕是挡不住的。"
                },
                {
                    "id": "10220810",
                    "speaker": "钟离",
                    "text": "但「璃月七星」也不是坐以待毙的人。"
                },
                {
                    "id": "10220811",
                    "speaker": "菲利克斯",
                    "text": "哼，谁不知道他们态度强硬？但就因为这样，人和仙的矛盾才会一触即发！"
                },
                {
                    "id": "10220812",
                    "speaker": "钟离",
                    "text": "然后呢？怎么「愚人众」反倒成了众矢之的？"
                },
                {
                    "id": "10220813",
                    "speaker": "菲利克斯",
                    "text": "呼…还不是因为那个凝光…"
                },
                {
                    "id": "10220814",
                    "speaker": "菲利克斯",
                    "text": "说什么「在这山雨欲来的时刻，要千岩军彻底控制愚人众的动向」。"
                },
                {
                    "id": "10220815",
                    "speaker": "菲利克斯",
                    "text": "切！现在才想起来要限制我们的行动？七星也不过如此！"
                },
                {
                    "id": "10220816",
                    "speaker": "菲利克斯",
                    "text": "总之，钟离先生，你是「公子」大人的合作者，你的态度也有一半是我们的态度，可别让人抓到把柄。"
                },
                {
                    "id": "10220817",
                    "speaker": "派蒙",
                    "text": "看来，璃月港里的各种矛盾，都已经彻底达到极限了…",
                    "choices": [
                        {
                            "id": "10220818",
                            "text": "我们能做些什么吗？",
                            "response": [
                                {
                                    "id": "10220820",
                                    "speaker": "钟离",
                                    "text": "你的意思是，想要凭特殊的中立身份出面调解？还是想要靠你个人的武力改变某些平衡？"
                                },
                                {
                                    "id": "10220821",
                                    "speaker": "钟离",
                                    "text": "这两条路，恐怕都不那么容易吧…"
                                },
                                {
                                    "id": "10220822",
                                    "speaker": "菲利克斯",
                                    "text": "啊，对了！钟离先生。我听说你们「往生堂」，好像也被卷进了冲突里，正在与找上门来的官军对峙呢！"
                                },
                                {
                                    "id": "10220823",
                                    "speaker": "钟离",
                                    "text": "…这可不妙。"
                                },
                                {
                                    "id": "10220824",
                                    "speaker": "钟离",
                                    "text": "我得先走一步，去往生堂看看了，希望胡堂主暂时应付得来…可别闹出什么大乱子。"
                                },
                                {
                                    "id": "10220825",
                                    "speaker": "钟离",
                                    "text": "旅者，你也再思考一下吧。在我看来，想要阻止一触即发的爆炸，不如先想想「引信」在哪。"
                                },
                                {
                                    "id": "10220827",
                                    "speaker": "派蒙",
                                    "text": "呼…当「愚人众」的「道上朋友」，看来既有好处，也有麻烦呢。"
                                },
                                {
                                    "id": "10220828",
                                    "speaker": "派蒙",
                                    "text": "所以，刚才钟离说的「引信」，是指什么？",
                                    "choices": [
                                        {
                                            "id": "10220829",
                                            "text": "「公子」。",
                                            "response": [
                                                {
                                                    "id": "10220832",
                                                    "speaker": "派蒙",
                                                    "text": "原来如此！我…我好像也明白了。嗯，要说谁最盼着这种满城大乱的情况，我的第一反应也是他了。"
                                                },
                                                {
                                                    "id": "10220833",
                                                    "speaker": "派蒙",
                                                    "text": "这家伙，一定是趁着所有人都没空管他的时候，去做什么坏事了！"
                                                },
                                                {
                                                    "id": "10220834",
                                                    "speaker": "派蒙",
                                                    "text": "可是，现在该到哪里找他？"
                                                },
                                                {
                                                    "id": "10220835",
                                                    "speaker": "派蒙",
                                                    "text": "在所有混乱都变得…特别混乱的时候，他会去哪里呢？",
                                                    "choices": [
                                                        {
                                                            "id": "10220836",
                                                            "text": "跟我来。"
                                                        },
                                                        {
                                                            "id": "10220837",
                                                            "text": "他会去的地方，只有一个。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10220830",
                                            "text": "那个橙色头发的男人。"
                                        },
                                        {
                                            "id": "10220831",
                                            "text": "一路上给我们买单的冤大头。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10220819",
                            "text": "我不想袖手旁观。"
                        }
                    ]
                }
            ]
        }
    ]
}