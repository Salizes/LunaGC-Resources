            "title": ""
        },
        "total_dialogue_lines": 49,
        "total_speaker_counts": {
            "Player": 9,
            "派蒙": 13,
            "贾米": 27
        }
    },
    "talks": [
        {
            "id": "7353001",
            "objective": "与唉声叹气的学者对话",
            "dialogues": [
                {
                    "id": "735300101",
                    "speaker": "贾米",
                    "text": "哈哈…唉…哈哈…"
                },
                {
                    "id": "735300102",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，快看，这里有个又哭又笑的家伙…咦，好像还有点眼熟？"
                },
                {
                    "id": "735300103",
                    "speaker": "贾米",
                    "text": "啊！好久不见，两位，你们还记得我吗？",
                    "choices": [
                        {
                            "id": "735300104",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "735300105",
                                    "speaker": "贾米",
                                    "text": "是我啦，我！生论派学者贾米，调配出「溢神剂」的那个人！"
                                },
                                {
                                    "id": "735300108",
                                    "speaker": "派蒙",
                                    "text": "哦哦，我好像有点印象了。"
                                },
                                {
                                    "id": "735300109",
                                    "speaker": "派蒙",
                                    "text": "怎么样，最近你的研究还顺利吗？"
                                },
                                {
                                    "id": "735300110",
                                    "speaker": "贾米",
                                    "text": "哈哈…这个嘛…唉…"
                                },
                                {
                                    "id": "735300111",
                                    "speaker": "Player",
                                    "text": "看来不怎么顺利？"
                                },
                                {
                                    "id": "735300112",
                                    "speaker": "贾米",
                                    "text": "不不，托各位的福，上次关于溢神剂的研究取得了相当不错的成绩。"
                                },
                                {
                                    "id": "735300113",
                                    "speaker": "贾米",
                                    "text": "之前我提心吊胆，总怕对不起导师的期待。没想到他看了我的研究之后，竟然对我大加赞赏。"
                                },
                                {
                                    "id": "735300114",
                                    "speaker": "贾米",
                                    "text": "「贾米，你做的好哇，不愧是我最骄傲的学生！」"
                                },
                                {
                                    "id": "735300115",
                                    "speaker": "派蒙",
                                    "text": "这不是挺好的吗？恭喜你啦。"
                                },
                                {
                                    "id": "735300116",
                                    "speaker": "贾米",
                                    "text": "如果到这里的话，确实很美好…唉，只可惜后面发生的事情，对我来说却是不折不扣的噩梦啊。"
                                },
                                {
                                    "id": "735300117",
                                    "speaker": "Player",
                                    "text": "发生什么事了？"
                                },
                                {
                                    "id": "735300118",
                                    "speaker": "贾米",
                                    "text": "或许是上次的实验数据过于理想，我的导师——那个笑起来满脸褶皱的老头，竟然产生了「亲自试一试」的想法。"
                                },
                                {
                                    "id": "735300119",
                                    "speaker": "贾米",
                                    "text": "于是，我帮他重新搭好了实验场地，并且精心调配了效果最好的溢神剂…"
                                },
                                {
                                    "id": "735300120",
                                    "speaker": "派蒙",
                                    "text": "然后呢？"
                                },
                                {
                                    "id": "735300121",
                                    "speaker": "贾米",
                                    "text": "然后，怎么说呢…在无数学生的围观下，他在魔物面前堂而皇之地饮用溢神剂，遭到了魔物的偷袭，转眼间败下阵来…"
                                },
                                {
                                    "id": "735300122",
                                    "speaker": "贾米",
                                    "text": "幸好人没事，只是要在床上多躺一段时间。"
                                },
                                {
                                    "id": "735300123",
                                    "speaker": "派蒙",
                                    "text": "噗，哈哈哈！"
                                },
                                {
                                    "id": "735300124",
                                    "speaker": "贾米",
                                    "text": "哈哈…咳。不管怎么说，是我学艺不精，让导师丢了面子。"
                                },
                                {
                                    "id": "735300125",
                                    "speaker": "贾米",
                                    "text": "事后那个臭脾气的老头，更是斥责我「没有考虑用户需求」、「无法满足实际情况」，把我狠批了一顿。"
                                },
                                {
                                    "id": "735300126",
                                    "speaker": "派蒙",
                                    "text": "这不是强人所难嘛，明明他自己也有错！"
                                },
                                {
                                    "id": "735300127",
                                    "speaker": "贾米",
                                    "text": "谁说不是呢？所以我想拜托两位，帮我——",
                                    "choices": [
                                        {
                                            "id": "735300128",
                                            "text": "教训教训他？",
                                            "response": [
                                                {
                                                    "id": "735300130",
                                                    "speaker": "贾米",
                                                    "text": "不是，不是啦！我可没有这么可怕的想法，至少现在没有！"
                                                },
                                                {
                                                    "id": "735300131",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，也就是说「曾经」有过？"
                                                },
                                                {
                                                    "id": "735300132",
                                                    "speaker": "贾米",
                                                    "text": "呃…有那么一点儿…这个不重要啦。"
                                                },
                                                {
                                                    "id": "735300133",
                                                    "speaker": "贾米",
                                                    "text": "我是想说，在重新审视之前的实验后，我调配出了一种「长效溢神剂」。"
                                                },
                                                {
                                                    "id": "735300134",
                                                    "speaker": "派蒙",
                                                    "text": "长效溢神剂？那是什么？"
                                                },
                                                {
                                                    "id": "735300135",
                                                    "speaker": "贾米",
                                                    "text": "我回忆起导师被偷袭时的反应，突然意识到一个问题：我们这些普通人面对危机时，通常会脑袋空空、身体僵硬、不知所措…"
                                                },
                                                {
                                                    "id": "735300136",
                                                    "speaker": "贾米",
                                                    "text": "如果等遇到危险时再找出溢神剂喝下，说不定就等不到溢神剂生效了。"
                                                },
                                                {
                                                    "id": "735300137",
                                                    "speaker": "贾米",
                                                    "text": "但是长效溢神剂不同。喝下之后，每次遇到危险都会自动生效，可以为普通人争取更多的反应时间。"
                                                },
                                                {
                                                    "id": "735300138",
                                                    "speaker": "Player",
                                                    "text": "怎么判断是否「遇到危险」呢？"
                                                },
                                                {
                                                    "id": "735300139",
                                                    "speaker": "贾米",
                                                    "text": "还记得我刚刚说的吗？普通人面对危机会身体僵硬。喝下长效溢神剂后，只要实验者正常行动，长效溢神剂就不会生效。"
                                                },
                                                {
                                                    "id": "735300140",
                                                    "speaker": "贾米",
                                                    "text": "可一旦他们停止行动、僵在原地，长效溢神剂就会发生作用，让他们的「主观」时间变得非常缓慢。"
                                                },
                                                {
                                                    "id": "735300141",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样，我差不多听懂了。所以…你刚刚是想拜托我们帮你完成实验吗？"
                                                },
                                                {
                                                    "id": "735300142",
                                                    "speaker": "贾米",
                                                    "text": "没错，虽然长效溢神剂是为普通人开发的，但实验有一定的风险，还是要先找有战斗经验的人帮忙。"
                                                },
                                                {
                                                    "id": "735300143",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，让我想想，要不要帮忙呢？"
                                                },
                                                {
                                                    "id": "735300144",
                                                    "speaker": "派蒙",
                                                    "text": "#突然有点饿了呢，好想去兰巴德酒馆大吃一顿呀…{NICKNAME}，我们的摩拉还够用吗？",
                                                    "choices": [
                                                        {
                                                            "id": "735300145",
                                                            "text": "很遗憾…",
                                                            "response": [
                                                                {
                                                                    "id": "735300147",
                                                                    "speaker": "贾米",
                                                                    "text": "咳。实不相瞒，导师虽然把我骂得狗血淋头，但过后还是特批了一笔不菲的实验经费。我打算重金聘请两位…"
                                                                },
                                                                {
                                                                    "id": "735300148",
                                                                    "speaker": "派蒙",
                                                                    "text": "既然这样，就让我们助你一臂之力吧！"
                                                                },
                                                                {
                                                                    "id": "735300149",
                                                                    "speaker": "贾米",
                                                                    "text": "太感谢了！呜呜，如果能挽回我那支离破碎的学术声誉，两位就是我的救星！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735300146",
                                                            "text": "这个月已经超支了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735300129",
                                            "text": "收买收买他？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735300106",
                            "text": "一直在唉声叹气的那个？",
                            "response": [
                                {
                                    "id": "735300107",
                                    "speaker": "贾米",
                                    "text": "你还记得那个外号啊。没错，是我啦…辜负导师期望、一直在唉声叹气的生论派学者，时至今日已经羞于报上名字的贾米——"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}