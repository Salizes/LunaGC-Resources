    "talks": [
        {
            "id": "7550101",
            "objective": "(test)钻地龙彩蛋对话$HIDDEN",
            "dialogues": [
                {
                    "id": "755010101",
                    "speaker": "派蒙",
                    "text": "咦，这不是卡齐娜吗？"
                },
                {
                    "id": "755010102",
                    "speaker": "卡齐娜",
                    "text": "#{NICKNAME}和派蒙？没想到你们会出现在这一带…"
                },
                {
                    "id": "755010103",
                    "speaker": "卡齐娜",
                    "text": "难道说，你们接了什么厉害的委托…是冲着那边的「游隙灵道」来的吗？",
                    "choices": [
                        {
                            "id": "755010104",
                            "text": "我们这次的委托确实很厉害。",
                            "response": [
                                {
                                    "id": "755010106",
                                    "speaker": "派蒙",
                                    "text": "说起来，给我们委托的人也属于「回声之子」，说不定你们还认识？"
                                },
                                {
                                    "id": "755010107",
                                    "speaker": "Black Screen",
                                    "text": "向卡齐娜描述了结识「炫彩呆子」的过程，她对涂鸦的看法，以及邀请你们学习前卫艺术理念一事…"
                                },
                                {
                                    "id": "755010108",
                                    "speaker": "卡齐娜",
                                    "text": "原来是「炫彩呆子」吗？我知道~"
                                },
                                {
                                    "id": "755010109",
                                    "speaker": "卡齐娜",
                                    "text": "她看着和我一样不起眼，但一聊起色彩就能滔滔不绝说上半天…或许你们可以多跟着她玩玩，应该能见识到…不一样的纳塔？"
                                },
                                {
                                    "id": "755010110",
                                    "speaker": "派蒙",
                                    "text": "卡齐娜也是被「炫彩呆子」邀请涂鸦，才和她成为朋友的吗？"
                                },
                                {
                                    "id": "755010111",
                                    "speaker": "卡齐娜",
                                    "text": "也不算吧？应该说是偶然间认识的…"
                                },
                                {
                                    "id": "755010112",
                                    "speaker": "卡齐娜",
                                    "text": "很久之前，我和爸爸妈妈一起去圣火竞技场买水果，看见她一个人坐在颜料店门口，认真地看着爱雅姐姐调色。"
                                },
                                {
                                    "id": "755010113",
                                    "speaker": "卡齐娜",
                                    "text": "她一坐就是大半天，纹丝不动，好像能从不同的颜色里看到特别厉害的东西。"
                                },
                                {
                                    "id": "755010114",
                                    "speaker": "卡齐娜",
                                    "text": "当时，她特别专注，好像除了颜料其他什么都不在乎。我还以为她不会注意到我的~"
                                },
                                {
                                    "id": "755010115",
                                    "speaker": "卡齐娜",
                                    "text": "没想到路过她身边的时候，她被我衣服的配色吸引，和我热情地聊起了喜欢的颜色，完全变了个人…"
                                },
                                {
                                    "id": "755010116",
                                    "speaker": "派蒙",
                                    "text": "卡齐娜的衣服确实很独特，「炫彩呆子」还挺有眼光的嘛！",
                                    "choices": [
                                        {
                                            "id": "755010117",
                                            "text": "平衡了活力、淳朴和纯真。",
                                            "response": [
                                                {
                                                    "id": "755010118",
                                                    "speaker": "派蒙",
                                                    "text": "对对对，我怎么就想不到这种用词…既有活力，又纯真得刚刚好！"
                                                },
                                                {
                                                    "id": "755010121",
                                                    "speaker": "派蒙",
                                                    "text": "不过，听你这么一说，以前的「炫彩呆子」好像和现在有点不一样，没那么擅长…和人打交道？"
                                                },
                                                {
                                                    "id": "755010122",
                                                    "speaker": "卡齐娜",
                                                    "text": "她可能和我一样不太擅长吸引人注意吧，大家要么忙着练习战斗，要么钻研跳舞…"
                                                },
                                                {
                                                    "id": "755010123",
                                                    "speaker": "卡齐娜",
                                                    "text": "相比之下，一直专注于画画的话，确实有点难交到朋友…"
                                                },
                                                {
                                                    "id": "755010124",
                                                    "speaker": "卡齐娜",
                                                    "text": "但我觉得有自己的目标，并为之付出努力的人非常了不起！"
                                                },
                                                {
                                                    "id": "755010125",
                                                    "speaker": "卡齐娜",
                                                    "text": "她认真研究颜色和涂鸦的时候，我总觉得…她会坚持自己的目标，并且坚定地走下去，这和传说故事中的英雄有点像哦。"
                                                },
                                                {
                                                    "id": "755010126",
                                                    "speaker": "卡齐娜",
                                                    "text": "说不定，在别人看来越不起眼，说明她越认真，以后就会变得越厉害？"
                                                },
                                                {
                                                    "id": "755010127",
                                                    "speaker": "派蒙",
                                                    "text": "好像…是这么个道理？",
                                                    "choices": [
                                                        {
                                                            "id": "755010128",
                                                            "text": "细节不重要。",
                                                            "response": [
                                                                {
                                                                    "id": "755010130",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "认识「炫彩呆子」以后，她邀请我一起去涂鸦。我喜欢那些漂亮的图案，但好像没什么天分，想不出有意思的画面。"
                                                                },
                                                                {
                                                                    "id": "755010131",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "「炫彩呆子」说不要紧，涂鸦还会记录著名的部族战士，我画不出厉害的涂鸦，但是可以成为涂鸦上描绘的有名人。"
                                                                },
                                                                {
                                                                    "id": "755010132",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "「到时候，就由成为了纳塔著名涂鸦高手的我，来帮你这个著名的战士画涂鸦…」"
                                                                },
                                                                {
                                                                    "id": "755010133",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "她这么说着的时候，好像整个人都变得炫彩夺目了起来。"
                                                                },
                                                                {
                                                                    "id": "755010134",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "不过…我真的能成为合格的部族战士吗…？为了不扫她的兴，我没有说出口…"
                                                                },
                                                                {
                                                                    "id": "755010135",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "在她涂鸦的时候，我有时候会在旁边当她的观众，努力给她出主意，比如…和她聊我骑着「冲天转转」在山崖上看到的风景。"
                                                                },
                                                                {
                                                                    "id": "755010136",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "虽然总共也没和「炫彩呆子」一起出去玩几次，但看到她那么努力的样子，我觉得我也应该加油才行。"
                                                                },
                                                                {
                                                                    "id": "755010137",
                                                                    "speaker": "卡齐娜",
                                                                    "text": "听说她好像被什么人鼓舞，慢慢变得健谈了，前几年还加入了一个…大涂鸦帮会。"
                                                                },
                                                                {
                                                                    "id": "755010138",
                                                                    "speaker": "派蒙",
                                                                    "text": "没错，「炫彩呆子」好像已经是涂鸦联盟里的重要人物了，而你成为了「回声之子」重要的部族战士！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755010139",
                                                                            "text": "你们两位确实在进步。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755010141",
                                                                                    "speaker": "卡齐娜",
                                                                                    "text": "果然「炫彩呆子」也没有松懈，一直在自己的领域努力…"
                                                                                },
                                                                                {
                                                                                    "id": "755010142",
                                                                                    "speaker": "卡齐娜",
                                                                                    "text": "但我离重要的部族战士还差得远…唔，对了，我要好好准备接下来的比赛！"
                                                                                },
                                                                                {
                                                                                    "id": "755010143",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对喔！我们四个都要加油！"
                                                                                },
                                                                                {
                                                                                    "id": "755010144",
                                                                                    "speaker": "卡齐娜",
                                                                                    "text": "那就先不打扰你们了…我也得继续练习，争取尽快提升各方面的能力，做好准备…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755010140",
                                                                            "text": "你们都在向上冲击。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755010129",
                                                            "text": "很有卡齐娜的风格！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755010119",
                                            "text": "有种好吃的感觉。",
                                            "response": [
                                                {
                                                    "id": "755010120",
                                                    "speaker": "派蒙",
                                                    "text": "虽然确实有点像…咖啡柠檬蛋糕加薄荷，但用这种比喻，总觉得聊着聊着就饿了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755010105",
                            "text": "有点抽象，但也挺有意思。"
                        }
                    ]
                }
            ]
        }
    ]
}