        }
    },
    "talks": [
        {
            "id": "7470301",
            "objective": "与桑多涅对话",
            "dialogues": [
                {
                    "id": "747030101",
                    "speaker": "「木偶」",
                    "text": "等等…这账目…你们确定没算错？"
                },
                {
                    "id": "747030102",
                    "speaker": "派蒙",
                    "text": "嗯？有什么问题吗？"
                },
                {
                    "id": "747030103",
                    "speaker": "「木偶」",
                    "text": "…这赚得也太多了吧？"
                },
                {
                    "id": "747030104",
                    "speaker": "Player",
                    "text": "后悔只拿三成了？"
                },
                {
                    "id": "747030105",
                    "speaker": "「木偶」",
                    "text": "我在你心中是那么小气的人吗？我单纯在感慨你们居然真能把水族馆运营得那么好。"
                },
                {
                    "id": "747030106",
                    "speaker": "派蒙",
                    "text": "我觉得多少也有「千灵映影节」的功劳啦。"
                },
                {
                    "id": "747030107",
                    "speaker": "「木偶」",
                    "text": "这营业额…不止赚回了我租维恩歌莱号的钱，甚至还有很多盈余。"
                },
                {
                    "id": "747030108",
                    "speaker": "Player",
                    "text": "想转行了？"
                },
                {
                    "id": "747030109",
                    "speaker": "「木偶」",
                    "text": "那倒不至于。我知道自己不适合做生意。我还是对机械结构和术式研究更感兴趣。"
                },
                {
                    "id": "747030110",
                    "speaker": "「木偶」",
                    "text": "不过…也对，看着这地方从一条鱼都没有的房间，变成现在这副模样，的确令人惊讶。"
                },
                {
                    "id": "747030111",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这里面也有桑多涅慷慨出借的功劳啦！自己装点的房间被大家喜欢，还是很开心的对吧？"
                },
                {
                    "id": "747030112",
                    "speaker": "「木偶」",
                    "text": "哼，有那么一点点吧。"
                },
                {
                    "id": "747030113",
                    "speaker": "派蒙",
                    "text": "只有一点点吗？"
                },
                {
                    "id": "747030114",
                    "speaker": "Player",
                    "text": "可能因为她只拿了三成。"
                },
                {
                    "id": "747030115",
                    "speaker": "「木偶」",
                    "text": "说了我不在意这个啦！！"
                }
            ]
        }
    ]
}