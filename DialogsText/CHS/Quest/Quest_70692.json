    "talks": [
        {
            "id": "7069201",
            "objective": "与米卡对话",
            "dialogues": [
                {
                    "id": "706920101",
                    "speaker": "「狂图捕手」",
                    "text": "哇哇，骑士小哥，你把我们的大英雄引过来了！"
                },
                {
                    "id": "706920102",
                    "speaker": "米卡",
                    "text": "是荣誉骑士前辈，还有白色小帮手！你们好！"
                },
                {
                    "id": "706920103",
                    "speaker": "派蒙",
                    "text": "米卡和…纳塔的朋友？你们在忙什么呢？"
                },
                {
                    "id": "706920104",
                    "speaker": "米卡",
                    "text": "我们正在推广一种对冒险家团体很有帮助的「前哨龙龙」。"
                },
                {
                    "id": "706920105",
                    "speaker": "米卡",
                    "text": "它结合了安柏前辈从须弥带回来的「侦察伙伴」机关核心，还有纳塔朋友们送我的小龙玩偶外形…"
                },
                {
                    "id": "706920106",
                    "speaker": "派蒙",
                    "text": "伙伴机关…哦哦，我还有印象！"
                },
                {
                    "id": "706920107",
                    "speaker": "米卡",
                    "text": "与须弥的「侦察伙伴」的功能类似，「前哨龙龙」可以帮忙侦察魔物，勘测地形。"
                },
                {
                    "id": "706920108",
                    "speaker": "米卡",
                    "text": "不过，由于重点放在后者，它更侧重行动的可控性和精准度…"
                },
                {
                    "id": "706920109",
                    "speaker": "米卡",
                    "text": "…荣誉骑士前辈有兴趣试飞一下吗？",
                    "choices": [
                        {
                            "id": "706920110",
                            "text": "真是一本正经的介绍。",
                            "response": [
                                {
                                    "id": "706920112",
                                    "speaker": "米卡",
                                    "text": "欸？是…是我太紧张了吗？"
                                },
                                {
                                    "id": "706920113",
                                    "speaker": "米卡",
                                    "text": "好像的确…明明之前基本放松下来，可以比较自然地面对你了。"
                                },
                                {
                                    "id": "706920114",
                                    "speaker": "米卡",
                                    "text": "但最近从不少其他国家的朋友那里听说了你的事迹，感觉你越来越厉害，越来越了不起了…"
                                },
                                {
                                    "id": "706920115",
                                    "speaker": "米卡",
                                    "text": "一想到以后要帮上你的忙，不能拖你的后腿，下意识又绷紧了弦。"
                                },
                                {
                                    "id": "706920116",
                                    "speaker": "派蒙",
                                    "text": "还真是米卡特有的逻辑…"
                                },
                                {
                                    "id": "706920117",
                                    "speaker": "「狂图捕手」",
                                    "text": "已经很不错了，骑士小哥！"
                                },
                                {
                                    "id": "706920118",
                                    "speaker": "「狂图捕手」",
                                    "text": "#在纳塔啊，部族里的战士要是碰见了{NICKNAME}，有的会激动到语无伦次，有的还会半个字都说不出来！"
                                },
                                {
                                    "id": "706920119",
                                    "speaker": "「狂图捕手」",
                                    "text": "#你作为{NICKNAME}的同事，也能算得上传奇级高手，和我们的部族首领对话都不必虚！"
                                },
                                {
                                    "id": "706920120",
                                    "speaker": "派蒙",
                                    "text": "没错没错，米卡要自信点！"
                                },
                                {
                                    "id": "706920121",
                                    "speaker": "米卡",
                                    "text": "原来还有这种事…这样的思考角度，我完全没想过…"
                                },
                                {
                                    "id": "706920122",
                                    "speaker": "米卡",
                                    "text": "#总之，如果{NICKNAME}试飞过「前哨龙龙」后感到满意，这个可爱又可靠的辅助机关，肯定能造福更多冒险家团体！",
                                    "choices": [
                                        {
                                            "id": "706920123",
                                            "text": "这个我在行！",
                                            "response": [
                                                {
                                                    "id": "706920125",
                                                    "speaker": "米卡",
                                                    "text": "好的！我这就调试好「前哨龙龙」，试飞很快就能开始！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706920124",
                                            "text": "让我试试龙龙的性能！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706920111",
                            "text": "可以不用这么正式的。"
                        }
                    ]
                }
            ]
        }
    ]
}