    "talks": [
        {
            "id": "7565401",
            "objective": "",
            "dialogues": [
                {
                    "id": "756540201",
                    "speaker": "枫原万叶",
                    "text": "鸣神大社的签文上说今日运势大吉，宜与故人再会。"
                },
                {
                    "id": "756540202",
                    "speaker": "枫原万叶",
                    "text": "#看来是应在你身上了，好久不见，{NICKNAME}。",
                    "choices": [
                        {
                            "id": "756540203",
                            "text": "是来给稻妻城留影的。",
                            "response": [
                                {
                                    "id": "756540205",
                                    "speaker": "枫原万叶",
                                    "text": "好雅兴，给走过的风景留下纪念，在旅途中也能常常回想起来时的路。"
                                },
                                {
                                    "id": "756540206",
                                    "speaker": "Player",
                                    "text": "万叶呢？"
                                },
                                {
                                    "id": "756540207",
                                    "speaker": "枫原万叶",
                                    "text": "我正打算去茶室和中西先生探讨茶道，他是这里的常客，对茶道中的种种学问颇有见解。"
                                },
                                {
                                    "id": "756540208",
                                    "speaker": "Player",
                                    "text": "万叶很了解茶道吗？"
                                },
                                {
                                    "id": "756540209",
                                    "speaker": "枫原万叶",
                                    "text": "幼年学习过一段时间，不过那时我对茶道的了解还很粗浅，如今重拾过去的爱好之后，越是钻研越发现其中妙趣无穷。"
                                },
                                {
                                    "id": "756540210",
                                    "speaker": "枫原万叶",
                                    "text": "譬如说，不同国家的茶道有不同的表现形式，稻妻的茶道有「清」及「寂」这样的宗旨。"
                                },
                                {
                                    "id": "756540211",
                                    "speaker": "枫原万叶",
                                    "text": "璃月翘英庄一带也出茶，璃月人饮茶时追求的氛围更偏向「怡」和「真」这样的境界。"
                                },
                                {
                                    "id": "756540212",
                                    "speaker": "枫原万叶",
                                    "text": "二者之间的差异亦能与两地人不同的生活习惯照应，这一点就很有意思。",
                                    "choices": [
                                        {
                                            "id": "756540213",
                                            "text": "万叶真好学。",
                                            "response": [
                                                {
                                                    "id": "756540215",
                                                    "speaker": "枫原万叶",
                                                    "text": "见笑了，其实…我回稻妻也不只是为了品茶。"
                                                },
                                                {
                                                    "id": "756540216",
                                                    "speaker": "枫原万叶",
                                                    "text": "我毕竟生长在稻妻城，虽然不得已离开过这里，但稻妻城始终还是我的家乡。"
                                                },
                                                {
                                                    "id": "756540217",
                                                    "speaker": "枫原万叶",
                                                    "text": "偶尔归乡，看到一些幼年认识的人，去熟悉的地方呆一呆。"
                                                },
                                                {
                                                    "id": "756540218",
                                                    "speaker": "枫原万叶",
                                                    "text": "会感觉到自己的根还扎在这里，旅途上走得更从容些。"
                                                },
                                                {
                                                    "id": "756540219",
                                                    "speaker": "枫原万叶",
                                                    "text": "用留影机固定回忆是个好想法，浪游天地的人更需要锚，对你我来说都是这样。"
                                                },
                                                {
                                                    "id": "756540220",
                                                    "speaker": "枫原万叶",
                                                    "text": "说了半天我的事，恐怕耽误你留影了，如果需要人协助，只要同我说一声便好。"
                                                },
                                                {
                                                    "id": "756540221",
                                                    "speaker": "Player",
                                                    "text": "想请你一起入镜！"
                                                },
                                                {
                                                    "id": "756540222",
                                                    "speaker": "枫原万叶",
                                                    "text": "没问题，你觉得什么样的姿势比较好？",
                                                    "choices": [
                                                        {
                                                            "id": "756540223",
                                                            "text": "端正的姿势。",
                                                            "response": [
                                                                {
                                                                    "id": "756540226",
                                                                    "speaker": "枫原万叶",
                                                                    "text": "好呀，这样可以吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756540227",
                                                                            "text": "很棒！我们开始留影吧！"
                                                                        },
                                                                        {
                                                                            "id": "756540228",
                                                                            "text": "还是放松的姿势合适。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756540229",
                                                                                    "speaker": "枫原万叶",
                                                                                    "text": "那就这样好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756540230",
                                                                            "text": "还是深沉的姿势合适。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756540231",
                                                                                    "speaker": "枫原万叶",
                                                                                    "text": "那就这样好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756540232",
                                                                            "text": "还是端正的姿势合适。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756540233",
                                                                                    "speaker": "枫原万叶",
                                                                                    "text": "那就这样好了。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756540224",
                                                            "text": "放松的姿势。"
                                                        },
                                                        {
                                                            "id": "756540225",
                                                            "text": "深沉的姿势。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756540214",
                                            "text": "万叶真风雅。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756540204",
                            "text": "是来找人留影的。"
                        }
                    ]
                }
            ]
        },
        {
