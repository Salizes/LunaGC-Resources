    "talks": [
        {
            "id": "7451901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745190101",
                    "speaker": "诺艾尔",
                    "text": "前辈，拍摄还顺利吗？如果有什么需要我配合的地方，请尽管吩咐！"
                }
            ]
        },
        {
            "id": "7451902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745190201",
                    "speaker": "Player",
                    "text": "我们继续留影吧！"
                }
            ]
        },
        {
            "id": "7451903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745190301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7451904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745190401",
                    "speaker": "诺艾尔",
                    "text": "啊…前辈好！是来找琴团长的吗？还是说…有什么需要我帮忙的地方？",
                    "choices": [
                        {
                            "id": "745190402",
                            "text": "我只是在四处逛逛。",
                            "response": [
                                {
                                    "id": "745190404",
                                    "speaker": "诺艾尔",
                                    "text": "我正在对骑士团的办公区域进行例行大扫除。目前灰尘已经基本清理完成，接下来就是整理旧档案了。"
                                },
                                {
                                    "id": "745190405",
                                    "speaker": "诺艾尔",
                                    "text": "那些文件堆积了很久，我想如果能把它们分门别类地归档，大家以后查阅起来就会方便很多。"
                                },
                                {
                                    "id": "745190406",
                                    "speaker": "诺艾尔",
                                    "text": "而且，整理前人的记录，也能学到很多东西。对我来说，这也是一种修行！"
                                },
                                {
                                    "id": "745190407",
                                    "speaker": "Player",
                                    "text": "诺艾尔还是这么认真可靠啊。"
                                },
                                {
                                    "id": "745190408",
                                    "speaker": "诺艾尔",
                                    "text": "这是我应尽的职责。而且，前辈和骑士团的大家都在不断前进，我也想尽快追上你们的步伐。",
                                    "choices": [
                                        {
                                            "id": "745190409",
                                            "text": "那么为了纪念这份决心…",
                                            "response": [
                                                {
                                                    "id": "745190411",
                                                    "speaker": "诺艾尔",
                                                    "text": "欸？前辈要拍画片？我…当然非常乐意！但是我刚刚才结束扫除，身上还沾着灰尘…",
                                                    "choices": [
                                                        {
                                                            "id": "745190412",
                                                            "text": "我想拍的就是诺艾尔努力的样子！",
                                                            "response": [
                                                                {
                                                                    "id": "745190414",
                                                                    "speaker": "诺艾尔",
                                                                    "text": "这、这个称呼还是太早了！不过，既然是前辈想拍…那就算带着灰尘，我也觉得很荣幸！"
                                                                },
                                                                {
                                                                    "id": "745190415",
                                                                    "speaker": "诺艾尔",
                                                                    "text": "那就请在前辈认为最合适的时机按下快门吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745190413",
                                                            "text": "这是女仆骑士的「决定性瞬间」！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745190410",
                                            "text": "我来帮你拍张画片吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745190403",
                            "text": "诺艾尔又在忙什么呢？"
                        }
                    ]
                }
            ]
        }
    ]
}