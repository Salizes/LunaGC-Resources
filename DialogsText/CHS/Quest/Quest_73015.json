    "talks": [
        {
            "id": "7301501",
            "objective": "前往谒颂幽境寻找兰那库拉",
            "dialogues": []
        },
        {
            "id": "7301502",
            "objective": "在附近寻找兰那库拉",
            "dialogues": []
        },
        {
            "id": "7301503",
            "objective": "与兰那库拉对话",
            "dialogues": [
                {
                    "id": "730150301",
                    "speaker": "派蒙",
                    "text": "你一定就是兰那库拉了吧！"
                },
                {
                    "id": "730150302",
                    "speaker": "兰那库拉",
                    "text": "呜哇！被、被那菈发现了！该、该怎么办…"
                },
                {
                    "id": "730150303",
                    "speaker": "派蒙",
                    "text": "你先别逃跑！是兰般度告诉我们你在这里的！"
                },
                {
                    "id": "730150304",
                    "speaker": "兰那库拉",
                    "text": "既、既然是兰般度告诉你们的，那一定是好那菈了。"
                },
                {
                    "id": "730150305",
                    "speaker": "派蒙",
                    "text": "#嗯？兰那库拉是不是太轻信了？万一{NICKNAME}是坏那菈，用兰般度的名字来骗你…"
                },
                {
                    "id": "730150306",
                    "speaker": "兰那库拉",
                    "text": "呀！那、那金色的那菈，其实是在骗兰那库拉？金色的那菈，其实是坏那菈？"
                },
                {
                    "id": "730150307",
                    "speaker": "派蒙",
                    "text": "感觉突然涌出了罪恶感…"
                },
                {
                    "id": "730150308",
                    "speaker": "Player",
                    "text": "别听派蒙的，我是好那菈。"
                },
                {
                    "id": "730150309",
                    "speaker": "兰那库拉",
                    "text": "#太好了，感谢兰穆护昆达，金色的那菈果然是好那菈。虽然那菈{NICKNAME}比兰那库拉高很多，但是不害怕。"
                },
                {
                    "id": "730150310",
                    "speaker": "兰那库拉",
                    "text": "派蒙…派蒙小只，也不害怕。"
                },
                {
                    "id": "730150311",
                    "speaker": "派蒙",
                    "text": "喂！",
                    "choices": [
                        {
                            "id": "730150312",
                            "text": "派蒙的确很小只…",
                            "response": [
                                {
                                    "id": "730150313",
                                    "speaker": "派蒙",
                                    "text": "小瞧我可是要吃大亏的！哼！"
                                },
                                {
                                    "id": "730150316",
                                    "speaker": "派蒙",
                                    "text": "不过说回正事，我们是来治好法留纳神机的，这片「桓那」应该也有法留纳神机的「枝」和「叶」？"
                                },
                                {
                                    "id": "730150317",
                                    "speaker": "派蒙",
                                    "text": "兰般度让我们来看看情况，如果你遇到了困难，也好帮帮你。"
                                },
                                {
                                    "id": "730150318",
                                    "speaker": "兰那库拉",
                                    "text": "啊！很多坏家伙在桓那…有安全的路，但是要小心。而且到处都是坏种子，就连为了那菈法留纳而造的…呜呜…"
                                },
                                {
                                    "id": "730150319",
                                    "speaker": "兰那库拉",
                                    "text": "#那菈{NICKNAME}又高又大，说不定和兰百梨迦一样强…那菈{NICKNAME}，说不定有办法…"
                                },
                                {
                                    "id": "730150320",
                                    "speaker": "兰那库拉",
                                    "text": "#…那菈{NICKNAME}，说不定能够帮忙。"
                                },
                                {
                                    "id": "730150321",
                                    "speaker": "派蒙",
                                    "text": "#我们本来就是来帮忙的呀，对吧，{NICKNAME}。"
                                },
                                {
                                    "id": "730150322",
                                    "speaker": "Player",
                                    "text": "交给我们吧。"
                                },
                                {
                                    "id": "730150323",
                                    "speaker": "兰那库拉",
                                    "text": "兰那库拉有别的请求，在治好法留纳神机以前…想要先去找回石头的记忆。"
                                },
                                {
                                    "id": "730150324",
                                    "speaker": "Player",
                                    "text": "…「石头的记忆」？"
                                },
                                {
                                    "id": "730150325",
                                    "speaker": "兰那库拉",
                                    "text": "桓那不会忘记，兰那罗不会忘记，但是兰那罗留下看得到的记忆。坏家伙来了以后，四处都是坏种子…"
                                },
                                {
                                    "id": "730150326",
                                    "speaker": "派蒙",
                                    "text": "和兰那罗说话就像猜谜一样呢…不过，实际见到之后应该就明白了吧。"
                                },
                                {
                                    "id": "730150327",
                                    "speaker": "派蒙",
                                    "text": "总之，我们先和兰那库拉一起过去吧！"
                                },
                                {
                                    "id": "730150328",
                                    "speaker": "兰那库拉",
                                    "text": "好那菈，好派蒙！我们不要惊动坏家伙，有安全的路。"
                                },
                                {
                                    "id": "730150329",
                                    "speaker": "派蒙",
                                    "text": "欸？兰那库拉说的「坏家伙」应该就是蕈兽吧，那完全不用担心呀！"
                                },
                                {
                                    "id": "730150330",
                                    "speaker": "派蒙",
                                    "text": "#哼哼，兰那库拉，你听好了，那菈{NICKNAME}可是很强的！"
                                },
                                {
                                    "id": "730150331",
                                    "speaker": "派蒙",
                                    "text": "而且不是一般的强！是非——常——强！"
                                },
                                {
                                    "id": "730150332",
                                    "speaker": "派蒙",
                                    "text": "我们之前已经和兰般度一起打败了好多蕈兽呢！就连兰般度也认可了我们的实力！"
                                },
                                {
                                    "id": "730150333",
                                    "speaker": "兰那库拉",
                                    "text": "#知道了，那菈{NICKNAME}一定和兰百梨迦一样厉害。可是派蒙呢？"
                                },
                                {
                                    "id": "730150334",
                                    "speaker": "派蒙",
                                    "text": "我？我怎么了？"
                                },
                                {
                                    "id": "730150335",
                                    "speaker": "兰那库拉",
                                    "text": "发生过这样的事…兰那库拉被坏家伙追赶，钻进了土里，但是被刨出来…"
                                },
                                {
                                    "id": "730150336",
                                    "speaker": "派蒙",
                                    "text": "欸…"
                                },
                                {
                                    "id": "730150337",
                                    "speaker": "兰那库拉",
                                    "text": "坏家伙的大口里滴出来，湿的、热的，还有果实坏掉的味道…"
                                },
                                {
                                    "id": "730150338",
                                    "speaker": "派蒙",
                                    "text": "呜哇…"
                                },
                                {
                                    "id": "730150339",
                                    "speaker": "兰那库拉",
                                    "text": "要不是兰百梨迦及时赶到，兰那库拉就…"
                                },
                                {
                                    "id": "730150340",
                                    "speaker": "派蒙",
                                    "text": "呜呜…"
                                },
                                {
                                    "id": "730150341",
                                    "speaker": "兰那库拉",
                                    "text": "之后兰般度说教了很久，太阳下去又上来，就连苗圃里种下的种子都已经发芽。"
                                },
                                {
                                    "id": "730150342",
                                    "speaker": "派蒙",
                                    "text": "…这说教也太久了吧！"
                                },
                                {
                                    "id": "730150343",
                                    "speaker": "Player",
                                    "text": "可是这跟派蒙有什么关系？"
                                },
                                {
                                    "id": "730150344",
                                    "speaker": "派蒙",
                                    "text": "对呀对呀，这和派蒙有什么关系呢？"
                                },
                                {
                                    "id": "730150345",
                                    "speaker": "兰那库拉",
                                    "text": "兰那库拉比派蒙厉害，却差点被坏家伙吃掉。派…派蒙这么小只，太危险了！"
                                },
                                {
                                    "id": "730150346",
                                    "speaker": "派蒙",
                                    "text": "#好、好像有点道理？不对！{NICKNAME}厉害，一定会保护派蒙的啦，对吧？",
                                    "choices": [
                                        {
                                            "id": "730150347",
                                            "text": "那当然。",
                                            "response": [
                                                {
                                                    "id": "730150348",
                                                    "speaker": "派蒙",
                                                    "text": "#嘿嘿，毕竟我是{NICKNAME}最好的伙伴嘛！"
                                                },
                                                {
                                                    "id": "730150351",
                                                    "speaker": "兰那库拉",
                                                    "text": "可是坏家伙那么多，兰那库拉也敌不过坏家伙…唔…金色的那菈虽然厉害，但是…"
                                                },
                                                {
                                                    "id": "730150352",
                                                    "speaker": "兰那库拉",
                                                    "text": "兰那库拉知道安全的路，我们走安全的路，好不好？"
                                                },
                                                {
                                                    "id": "730150353",
                                                    "speaker": "派蒙",
                                                    "text": "欸？该不会…该不会是兰那库拉其实特别害怕蕈兽吧？"
                                                },
                                                {
                                                    "id": "730150354",
                                                    "speaker": "兰那库拉",
                                                    "text": "呜…"
                                                },
                                                {
                                                    "id": "730150355",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，原来是这样啊。不过拿派蒙当借口可不是好孩子！"
                                                },
                                                {
                                                    "id": "730150356",
                                                    "speaker": "派蒙",
                                                    "text": "#既然这样，{NICKNAME}，我们就和兰那库拉一起走安全的路吧，路上小心一点，不要惊动了蕈兽。"
                                                },
                                                {
                                                    "id": "730150357",
                                                    "speaker": "Player",
                                                    "text": "那我可是经验丰富。"
                                                },
                                                {
                                                    "id": "730150358",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，总觉得已经做过很多次类似的事情了…"
                                                },
                                                {
                                                    "id": "730150359",
                                                    "speaker": "兰那库拉",
                                                    "text": "嗯！兰那库拉带那菈走安全的路。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730150349",
                                            "text": "派蒙可以自己逃跑。",
                                            "response": [
                                                {
                                                    "id": "730150350",
                                                    "speaker": "派蒙",
                                                    "text": "#我才不会丢下{NICKNAME}自己逃跑呢！应该…不会吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730150314",
                            "text": "小小派蒙，大大能量。",
                            "response": [
                                {
                                    "id": "730150315",
                                    "speaker": "派蒙",
                                    "text": "说得对！派蒙可是很厉害的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301523",
            "objective": "在不被发现的情况下前进",
