    "talks": [
        {
            "id": "4133126",
            "objective": "(接取任务）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4133101",
            "objective": "废弃",
            "dialogues": []
        },
        {
            "id": "4133102",
            "objective": "与若心对话",
            "dialogues": [
                {
                    "id": "413310201",
                    "speaker": "若心",
                    "text": "又到了海灯节了，唉…"
                },
                {
                    "id": "413310202",
                    "speaker": "Player",
                    "text": "您在担心什么？"
                },
                {
                    "id": "413310203",
                    "speaker": "若心",
                    "text": "到海灯节啦，按理说，是该热热闹闹地过。"
                },
                {
                    "id": "413310204",
                    "speaker": "若心",
                    "text": "但是这轻策庄里…老的老，小的小。"
                },
                {
                    "id": "413310205",
                    "speaker": "若心",
                    "text": "去城里工作的那些孩子们，要么是说工作忙请不到假…"
                },
                {
                    "id": "413310206",
                    "speaker": "若心",
                    "text": "要么就是离得远，怎么样都赶不及回来。"
                },
                {
                    "id": "413310207",
                    "speaker": "若心",
                    "text": "明明是个大家伙聚在一起，团团圆圆热热闹闹的节日，结果…"
                },
                {
                    "id": "413310208",
                    "speaker": "若心",
                    "text": "我也理解他们在外的难处，但是大过节的，唉…"
                },
                {
                    "id": "413310209",
                    "speaker": "若心",
                    "text": "哎呀，不说了，不说了。大过节的可不能这样…"
                },
                {
                    "id": "413310210",
                    "speaker": "若心",
                    "text": "对了，如果你愿意的话，能去帮一下小白吗？"
                },
                {
                    "id": "413310211",
                    "speaker": "若心",
                    "text": "那孩子说想要给大家置办桌好菜，正在那忙呢，我担心她一个人会有点忙不过来…",
                    "choices": [
                        {
                            "id": "413310212",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "413310214",
                                    "speaker": "若心",
                                    "text": "那就拜托你了，实在是太谢谢了…"
                                }
                            ]
                        },
                        {
                            "id": "413310213",
                            "text": "您别担心，我这就去帮忙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133103",
            "objective": "与小白对话",
            "dialogues": [
                {
                    "id": "413310301",
                    "speaker": "小白",
                    "text": "还差这么多东西吗…"
                },
                {
                    "id": "413310302",
                    "speaker": "<UNKNOWN>",
                    "text": "我来帮忙置办吧。"
                },
                {
                    "id": "413310303",
                    "speaker": "小白",
                    "text": "咦？哦…你愿意帮忙那就最好了，我正发愁怎么置办食材呢。"
                },
                {
                    "id": "413310304",
                    "speaker": "小白",
                    "text": "我看看…请你帮我准备三份兽肉和三份禽肉吧。"
                },
                {
                    "id": "413310305",
                    "speaker": "小白",
                    "text": "其余的材料，我会想办法准备的。"
                }
            ]
        },
        {
            "id": "4133105",
            "objective": "（隐藏）是否已交付食材$HIDDEN",
            "dialogues": [
                {
                    "id": "413310501",
                    "speaker": "小白",
                    "text": "这些就够了…对了，我还要请你帮个忙，请帮我去和凯叔说一声，让他把桌椅板凳什么的都搬出来吧。"
                },
                {
                    "id": "413310502",
                    "speaker": "小白",
                    "text": "我准备做的菜还挺多的，到时候再把桌椅搬出来的话，说不定有些菜都要凉了。"
                }
            ]
        },
        {
            "id": "4133104",
            "objective": "帮助小白准备三份兽肉与三份禽肉",
            "dialogues": []
        },
        {
            "id": "4133106",
            "objective": "与凯叔对话",
            "dialogues": [
                {
                    "id": "413310601",
                    "speaker": "凯叔",
                    "text": "嗯？找我有什么事吗？"
                },
                {
                    "id": "413310602",
                    "speaker": "Player",
                    "text": "关于桌椅的事…"
                },
                {
                    "id": "413310603",
                    "speaker": "凯叔",
                    "text": "桌椅啊，我记得，早就已经准备好了。"
                },
                {
                    "id": "413310604",
                    "speaker": "凯叔",
                    "text": "嗯…店里面应该还有一些，算了，都一起搬出来吧。"
                },
                {
                    "id": "413310605",
                    "speaker": "凯叔",
                    "text": "这就行了，差不多够用了。"
                },
                {
                    "id": "413310606",
                    "speaker": "凯叔",
                    "text": "不过，没想到你还特意过来帮忙…"
                },
                {
                    "id": "413310607",
                    "speaker": "Player",
                    "text": "应该做的。"
                },
                {
                    "id": "413310608",
                    "speaker": "凯叔",
                    "text": "嗬，你这年轻人倒是不错…不过这大过节的，你怎么不回家里去？",
                    "choices": [
                        {
                            "id": "413310609",
                            "text": "……",
                            "response": [
                                {
                                    "id": "413310611",
                                    "speaker": "凯叔",
                                    "text": "没事没事，我不多问了，你肯定也有自己的原因吧。"
                                },
                                {
                                    "id": "413310612",
                                    "speaker": "凯叔",
                                    "text": "不过你要是愿意，留在这过节也行，反正这里人也挺多的，也算热闹。"
                                }
                            ]
                        },
                        {
                            "id": "413310610",
                            "text": "因为一些事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133107",
            "objective": "（隐藏）刷出桌椅$HIDDEN",
            "dialogues": [
                {
                    "id": "413310701",
                    "speaker": "若心",
                    "text": "唉…也不知道那些在外奔波的那些孩子们，什么时候能得空休息一下…"
                }
            ]
        },
        {
            "id": "4133115",
            "objective": "小白闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "413313701",
                    "speaker": "若心",
                    "text": "这么多人在一起，倒是也有几分节日的气氛了。"
                },
                {
                    "id": "413313702",
                    "speaker": "若心",
                    "text": "呵呵，我们就一起放了这盏霄灯吧。"
                },
                {
                    "id": "413313703",
                    "speaker": "若心",
                    "text": "希望新的一年里，大家都能身体健康，万事如意。"
                },
                {
                    "id": "413313704",
                    "speaker": "若心",
                    "text": "还有在外奔波的那些孩子们，也能万事如意啊…"
                },
                {
                    "id": "413313705",
                    "speaker": "小白",
                    "text": "好了若心奶奶，再不去吃，我准备的那些饭菜可都要凉了。"
                },
                {
                    "id": "413313706",
                    "speaker": "小六",
                    "text": "哇，有好吃的！"
                },
                {
                    "id": "413313707",
                    "speaker": "东东",
                    "text": "奶奶，那我们去啦！"
                },
                {
                    "id": "413313708",
                    "speaker": "若心",
                    "text": "你们这群孩子啊…好，好，快去吧。"
                },
                {
                    "id": "413313709",
                    "speaker": "Player",
                    "text": "您不去吗？"
                },
                {
                    "id": "413313710",
                    "speaker": "若心",
                    "text": "我？我不急，我想再看会霄灯。"
                },
                {
                    "id": "413313711",
                    "speaker": "若心",
                    "text": "对了孩子，这些给你，收下吧，谢谢你在这里忙前忙后的帮忙。"
                },
                {
                    "id": "413313712",
                    "speaker": "Player",
                    "text": "谢谢奶奶。"
                },
                {
                    "id": "413313713",
                    "speaker": "若心",
                    "text": "不用谢，我看你的年纪也不大，这样子在外面跑，一定很辛苦吧，唉…"
                },
                {
                    "id": "413313714",
                    "speaker": "若心",
                    "text": "不然，你就在这再待一会，和大家一起过个节吧。"
                },
                {
                    "id": "413313715",
                    "speaker": "若心",
                    "text": "奔波了一整年，能歇息一会总是好的…"
                }
            ]
        },
        {
            "id": "4133121",
            "objective": "凯叔闲置对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4133109",
            "objective": "废弃",
            "dialogues": []
        },
        {
            "id": "4133110",
            "objective": "与若心对话",
            "dialogues": [
                {
                    "id": "413311001",
                    "speaker": "若心",
                    "text": "你回来了，辛苦你了，大过节的还在这忙前忙后的。"
                },
                {
                    "id": "413311002",
                    "speaker": "Player",
                    "text": "应该做的。"
                },
                {
                    "id": "413311003",
                    "speaker": "若心",
                    "text": "那我也得好好谢谢你才是。刚才我也编了不少的霄灯，想要和这轻策庄里的人一起放出去。"
                },
                {
                    "id": "413311004",
                    "speaker": "若心",
                    "text": "你愿意的话，就晚上来门口找我吧，我们一起放放霄灯，过个好节。"
                },
                {
                    "id": "413311005",
                    "speaker": "若心",
                    "text": "但那群孩子们也不知道跑到哪去了…我也走不动远路，没办法去找他们。"
                },
                {
                    "id": "413311006",
                    "speaker": "若心",
                    "text": "如果可以的话，请你替我去找找那些孩子们，让他们过来吧，他们一向很喜欢放霄灯的。"
                },
                {
                    "id": "413311007",
                    "speaker": "若心",
                    "text": "要是你能再顺便再叫些其他的人来，那就更好了，毕竟人越多越热闹嘛。"
                }
            ]
        },
        {
            "id": "4133111",
            "objective": "（废弃）与阿佑对话$HIDDEN",
            "dialogues": [
                {
                    "id": "413312001",
                    "speaker": "阿佑",
                    "text": "哎呀，又没抓到…"
                },
                {
                    "id": "413312002",
                    "speaker": "Player",
                    "text": "关于放霄灯的事…"
                },
                {
                    "id": "413312003",
                    "speaker": "阿佑",
                    "text": "晚上可以放霄灯吗？太好了！我要去告诉哥哥。"
                },
                {
                    "id": "413312004",
                    "speaker": "阿佑",
                    "text": "我听爷爷说，放霄灯的时候，可以许愿望的对吧？"
                },
                {
                    "id": "413312005",
                    "speaker": "阿佑",
                    "text": "我有个很重要的愿望要许…"
                },
                {
                    "id": "413312006",
                    "speaker": "Player",
                    "text": "是什么愿望？"
                },
                {
                    "id": "413312007",
                    "speaker": "阿佑",
                    "text": "是我…哎呀，不行不行，爷爷说愿望说出来就不灵了。"
                },
                {
                    "id": "413312008",
                    "speaker": "阿佑",
                    "text": "我等会就去告诉哥哥，他一定也有愿望想许的…"
                },
                {
                    "id": "413312009",
                    "speaker": "阿佑",
                    "text": "嗯…等一下，愿望好像是要写在霄灯上的，我直接许的话，会不会不灵啊…"
                }
            ]
        },
        {
            "id": "4133112",
            "objective": "与罗小妹对话$HIDDEN",
            "dialogues": [
                {
                    "id": "413312101",
                    "speaker": "罗小妹",
                    "text": "仙人哥哥会不会过海灯节呢…"
                },
                {
                    "id": "413312102",
                    "speaker": "Player",
                    "text": "关于放霄灯的事…"
                },
                {
                    "id": "413312103",
                    "speaker": "罗小妹",
                    "text": "嗯…要放霄灯吗？我知道啦。"
                },
                {
                    "id": "413312104",
                    "speaker": "罗小妹",
                    "text": "要是霄灯放得多，说不定…仙人哥哥也会来看…"
                }
            ]
        },
        {
            "id": "4133113",
            "objective": "与常九爷对话$HIDDEN",
            "dialogues": [
                {
                    "id": "413312201",
                    "speaker": "常九爷",
                    "text": "嗯？你有什么事找我？"
                },
                {
                    "id": "413312202",
                    "speaker": "Player",
                    "text": "关于放霄灯的事…"
                },
                {
                    "id": "413312203",
                    "speaker": "常九爷",
                    "text": "若心要放霄灯？唉，她也是会操心…"
                },
                {
                    "id": "413312204",
                    "speaker": "常九爷",
                    "text": "我知道了，我过会就去看看，大过节的，人多点总是好的。"
                }
            ]
        },
        {
            "id": "4133114",
            "objective": "与江城对话$HIDDEN",
            "dialogues": [
                {
                    "id": "413312301",
                    "speaker": "江城",
                    "text": "老婆子…老婆子？"
                },
                {
                    "id": "413312302",
                    "speaker": "Player",
                    "text": "关于放霄灯的事…"
                },
                {
                    "id": "413312303",
                    "speaker": "江城",
                    "text": "霄灯？嗯…嗯，是，我也记着，差不多是该放霄灯的时候啦。"
                },
                {
                    "id": "413312304",
                    "speaker": "江城",
                    "text": "唉，也亏得若心有这心思，咱们一起，好好许个愿…好好许个愿…"
                }
            ]
        },
