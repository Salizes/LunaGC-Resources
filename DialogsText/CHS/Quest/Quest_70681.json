        }
    },
    "talks": [
        {
            "id": "7068101",
            "objective": "前往<color=#00E1FFFF>苍风高地</color>",
            "dialogues": []
        },
        {
            "id": "7068102",
            "objective": "解救冒险家",
            "dialogues": []
        },
        {
            "id": "7068103",
            "objective": "与冒险家对话",
            "dialogues": [
                {
                    "id": "706810301",
                    "speaker": "格茜妮",
                    "text": "呼…总算得救了。谢谢你们！"
                },
                {
                    "id": "706810302",
                    "speaker": "格茜妮",
                    "text": "我叫格茜妮，如你们所见，是一位冒险家。"
                },
                {
                    "id": "706810303",
                    "speaker": "格茜妮",
                    "text": "你们身手这么了得，一定不是普通人吧！难道是好心的骑士？或者是云游四方的游侠？",
                    "choices": [
                        {
                            "id": "706810304",
                            "text": "我是路过的旅行者。",
                            "response": [
                                {
                                    "id": "706810309",
                                    "speaker": "派蒙",
                                    "text": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。其实{M#他}{F#她}也是冒险家协会的成员哦。"
                                },
                                {
                                    "id": "706810310",
                                    "speaker": "格茜妮",
                                    "text": "原来是冒险家前辈！真是人外有人啊，这么难缠的魔物，你们一下子就解决了。"
                                },
                                {
                                    "id": "706810311",
                                    "speaker": "格茜妮",
                                    "text": "不像我，训练的时候明明动作都记住了，结果到了实战，手脚就不听使唤…"
                                },
                                {
                                    "id": "706810312",
                                    "speaker": "格茜妮",
                                    "text": "就像老师说的那样，我还得再锻炼个三五年吗？但是就这么空手回去也太丢脸了吧…呜呜…"
                                },
                                {
                                    "id": "706810313",
                                    "speaker": "派蒙",
                                    "text": "哎呀，我觉得只是经验的差距啦。我们也是经历了很多场实战，才能游刃有余的！",
                                    "choices": [
                                        {
                                            "id": "706810314",
                                            "text": "首先要保持冷静。",
                                            "response": [
                                                {
                                                    "id": "706810315",
                                                    "speaker": "派蒙",
                                                    "text": "是呀，新手在实战里都容易慌里慌张的，原本的实力都发挥不出来了。"
                                                },
                                                {
                                                    "id": "706810316",
                                                    "speaker": "派蒙",
                                                    "text": "就算敌人看起来很强，也要冷静观察，找到他们的弱点哦。"
                                                },
                                                {
                                                    "id": "706810317",
                                                    "speaker": "派蒙",
                                                    "text": "这样就能哐哐哐地解决战斗了！"
                                                },
                                                {
                                                    "id": "706810320",
                                                    "speaker": "格茜妮",
                                                    "text": "原来是这样…不愧是经验丰富的前辈！看来我还得边旅行边磨练自己的本领呢。"
                                                },
                                                {
                                                    "id": "706810321",
                                                    "speaker": "Player",
                                                    "text": "你也正在旅行中吗？"
                                                },
                                                {
                                                    "id": "706810322",
                                                    "speaker": "格茜妮",
                                                    "text": "是的…我准备去<color=#00E1FFFF>璃月</color>看看。"
                                                },
                                                {
                                                    "id": "706810323",
                                                    "speaker": "格茜妮",
                                                    "text": "你们听说过璃月的武学吗？据说能让人飞檐走壁，刀枪不入，削铁如泥！"
                                                },
                                                {
                                                    "id": "706810324",
                                                    "speaker": "格茜妮",
                                                    "text": "要是能向高人请教，学到一二，以后的冒险就轻松不少了吧。"
                                                },
                                                {
                                                    "id": "706810325",
                                                    "speaker": "格茜妮",
                                                    "text": "但说实话，虽然加入冒险家协会有一段时间了，我还是第一次出远门呢。"
                                                },
                                                {
                                                    "id": "706810326",
                                                    "speaker": "格茜妮",
                                                    "text": "唉，刚出城没多久就被魔物拦住，我真的能顺利走到璃月吗…",
                                                    "choices": [
                                                        {
                                                            "id": "706810327",
                                                            "text": "我们也打算去璃月。",
                                                            "response": [
                                                                {
                                                                    "id": "706810329",
                                                                    "speaker": "格茜妮",
                                                                    "text": "真的吗？难道前辈也打算寻访世外高人？"
                                                                },
                                                                {
                                                                    "id": "706810330",
                                                                    "speaker": "派蒙",
                                                                    "text": "这倒不是啦。因为某些原因，我们正在各国旅行。"
                                                                },
                                                                {
                                                                    "id": "706810331",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然对璃月还不是很了解，但是早晚也是要去看看的。"
                                                                },
                                                                {
                                                                    "id": "706810332",
                                                                    "speaker": "派蒙",
                                                                    "text": "既然刚好顺路，一起过去也有个照应嘛！"
                                                                },
                                                                {
                                                                    "id": "706810333",
                                                                    "speaker": "格茜妮",
                                                                    "text": "哇，居然能跟厉害的前辈一起行动…我的旅途充满了希望！"
                                                                },
                                                                {
                                                                    "id": "706810334",
                                                                    "speaker": "格茜妮",
                                                                    "text": "那让我来带路吧。我在出发之前仔细研究了地图，肯定不会迷路的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706810328",
                                                            "text": "要加入我们的队伍吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706810318",
                                            "text": "判断形势也很重要。",
                                            "response": [
                                                {
                                                    "id": "706810319",
                                                    "speaker": "派蒙",
                                                    "text": "是呀，如果判断敌人的实力在自己之上，还是及时撤离比较好哦。恋战是很危险的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706810305",
                            "text": "我的身份不方便透露…",
                            "response": [
                                {
                                    "id": "706810306",
                                    "speaker": "格茜妮",
                                    "text": "我明白的！你一定是身负秘密使命，只能低调行事…"
                                },
                                {
                                    "id": "706810307",
                                    "speaker": "Player",
                                    "text": "差不多就是这样。"
                                },
                                {
                                    "id": "706810308",
                                    "speaker": "派蒙",
                                    "text": "好啦，你就别卖关子了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068104",
            "objective": "与格茜妮一起继续前进",
            "dialogues": [
                {
                    "id": "706810401",
                    "speaker": "格茜妮",
                    "text": "前辈！不好意思，可以在这里稍等一下吗？"
                },
                {
                    "id": "706810402",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "706810403",
                    "speaker": "派蒙",
                    "text": "难道忘带什么东西了吗？"
                },
                {
                    "id": "706810404",
                    "speaker": "格茜妮",
                    "text": "这倒没有。只是我看地图，再往前走就要离开蒙德了呢。"
                },
                {
                    "id": "706810405",
                    "speaker": "格茜妮",
                    "text": "下次回来也不知道是什么时候…老师看到我留的信，说不定会大发雷霆吧…",
                    "choices": [
                        {
                            "id": "706810406",
                            "text": "之前就听你提过老师…",
                            "response": [
                                {
                                    "id": "706810408",
                                    "speaker": "格茜妮",
                                    "text": "是的…他刚成为冒险家的时候，在野外遇到了丘丘暴徒，结果在周旋的时候，不小心被一斧子砸晕了。"
                                },
                                {
                                    "id": "706810409",
                                    "speaker": "格茜妮",
                                    "text": "好在路过的骑士把他救了回去。"
                                },
                                {
                                    "id": "706810410",
                                    "speaker": "格茜妮",
                                    "text": "他觉得很没面子，决定在城里将武艺锻炼到极致再外出冒险。结果这一锻炼就是十年…"
                                },
                                {
                                    "id": "706810411",
                                    "speaker": "格茜妮",
                                    "text": "老师总说基础是最重要的，可是我真的受不了每天砍木桩了！"
                                },
                                {
                                    "id": "706810412",
                                    "speaker": "格茜妮",
                                    "text": "所以我就瞒着老师，一个人出门旅行…",
                                    "choices": [
                                        {
                                            "id": "706810413",
                                            "text": "等变强了再回去吧。",
                                            "response": [
                                                {
                                                    "id": "706810415",
                                                    "speaker": "格茜妮",
                                                    "text": "嗯！我也是这么想的。"
                                                },
                                                {
                                                    "id": "706810416",
                                                    "speaker": "格茜妮",
                                                    "text": "啊，我想到了…"
                                                },
                                                {
                                                    "id": "706810417",
                                                    "speaker": "Black Screen",
                                                    "text": "格茜妮翻出背包里的蒲公英籽，放在手掌上，对着它们说了些什么，然后让种子随风飘散…"
                                                },
                                                {
                                                    "id": "706810418",
                                                    "speaker": "格茜妮",
                                                    "text": "在我们的习俗里，蒲公英能够承载愿望呢。"
                                                },
                                                {
                                                    "id": "706810419",
                                                    "speaker": "格茜妮",
                                                    "text": "我刚才许了愿，希望这一路能顺利实现目标，也希望老师能理解我。"
                                                },
                                                {
                                                    "id": "706810420",
                                                    "speaker": "Player",
                                                    "text": "风神一定听到你的愿望了。"
                                                },
                                                {
                                                    "id": "706810421",
                                                    "speaker": "格茜妮",
                                                    "text": "嗯！那我们继续前进吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706810414",
                                            "text": "做出能让他认可的成就吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706810407",
                            "text": "他也是冒险家吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068105",
            "objective": "前往<color=#00E1FFFF>石门</color>",
            "dialogues": [
                {
                    "id": "706810501",
                    "speaker": "格茜妮",
                    "text": "前面就是<color=#00E1FFFF>荻花洲</color>了吧？好漂亮呀，是在蒙德看不到的风景呢。"
                },
                {
                    "id": "706810502",
                    "speaker": "格茜妮",
                    "text": "果然出来旅行是正确的选择！"
                },
                {
                    "id": "706810503",
                    "speaker": "格茜妮",
                    "text": "对了，机会难得，我们在这里一起合影留念吧！"
                }
            ]
        },
        {
            "id": "7068106",
            "objective": "在附近合影留念",
            "dialogues": []
        },
        {
            "id": "7068107",
            "objective": "与格茜妮对话",
            "dialogues": [
                {
                    "id": "706810701",
                    "speaker": "格茜妮",
                    "text": "和前辈的珍贵合影，我会好好收藏的！"
                },
                {
                    "id": "706810702",
                    "speaker": "格茜妮",
                    "text": "啊，一放松下来就饿了…"
                },
                {
                    "id": "706810703",
                    "speaker": "派蒙",
                    "text": "这么一说，派蒙的肚子也在咕咕叫了…",
                    "choices": [
                        {
                            "id": "706810704",
                            "text": "找个地方休息吧。",
                            "response": [
                                {
                                    "id": "706810708",
                                    "speaker": "派蒙",
                                    "text": "我们就在附近看看，找个能吃饭的地方吧！"
                                },
                                {
                                    "id": "706810709",
                                    "speaker": "格茜妮",
                                    "text": "这附近好像没有什么合适的餐馆呢…如果随便对付一下的话，就太委屈前辈了。"
                                },
                                {
                                    "id": "706810710",
                                    "speaker": "格茜妮",
                                    "text": "说起来，前面那个建在大石头上的建筑，就是有名的<color=#00E1FFFF>望舒客栈</color>吧？"
                                },
                                {
                                    "id": "706810711",
                                    "speaker": "格茜妮",
                                    "text": "我以前听来蒙德做买卖的璃月商人说过，那里的菜品可好吃了！"
                                },
                                {
                                    "id": "706810712",
                                    "speaker": "格茜妮",
                                    "text": "作为答谢，我请前辈去吃顿大餐吧！"
                                },
                                {
                                    "id": "706810713",
                                    "speaker": "派蒙",
                                    "text": "好耶！去吃好吃的！"
                                }
                            ]
                        },
                        {
                            "id": "706810705",
                            "text": "派蒙，生火做饭！",
                            "response": [
                                {
                                    "id": "706810706",
                                    "speaker": "派蒙",
                                    "text": "喂，使唤我也要有个限度呀！"
                                },
                                {
                                    "id": "706810707",
                                    "speaker": "派蒙",
                                    "text": "而且我的厨艺水平你也是知道的嘛…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068108",
            "objective": "抵达<color=#00E1FFFF>望舒客栈</color>",
            "dialogues": [
                {
                    "id": "706810801",
                    "speaker": "格茜妮",
                    "text": "听说璃月菜讲究色香味俱全，看上去真的很不一样呢。"
                },
                {
                    "id": "706810802",
                    "speaker": "派蒙",
                    "text": "光是看着就已经垂涎欲滴了！"
                },
                {
                    "id": "706810803",
                    "speaker": "Black Screen",
                    "text": "你们细细地品味了这里的美食…"
                },
                {
                    "id": "706810804",
                    "speaker": "派蒙",
                    "text": "呜哇，这个也好吃，那个也好吃…实在是吃不下了！",
                    "choices": [
                        {
                            "id": "706810805",
                            "text": "满足！",
                            "response": [
                                {
                                    "id": "706810807",
                                    "speaker": "格茜妮",
                                    "text": "前辈一路辛苦了，要是没有你们，我肯定没法这么轻松地来到这里。"
                                },
                                {
                                    "id": "706810808",
                                    "speaker": "格茜妮",
                                    "text": "刚才听客栈的人说，再往前走就是<color=#00E1FFFF>璃月港</color>了。"
                                },
                                {
                                    "id": "706810809",
                                    "speaker": "格茜妮",
                                    "text": "我打算在这里休息几天，跟其他旅客打听一下，怎么才能找到世外高人，然后再决定之后要去哪里。"
                                },
                                {
                                    "id": "706810810",
                                    "speaker": "格茜妮",
                                    "text": "虽然跟前辈旅行真的很开心，但是不能继续耽误你们的时间了。"
                                },
                                {
                                    "id": "706810811",
                                    "speaker": "格茜妮",
                                    "text": "接下来我会努力变强，成为像前辈一样可靠的冒险家的！"
                                },
                                {
                                    "id": "706810812",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，虽然相处时间不长，但是我们也很开心呢！"
                                },
                                {
                                    "id": "706810813",
                                    "speaker": "派蒙",
                                    "text": "希望以后还能在别的地方相遇！",
                                    "choices": [
                                        {
                                            "id": "706810814",
                                            "text": "那我们有缘再见啦。",
                                            "response": [
                                                {
                                                    "id": "706810816",
                                                    "speaker": "格茜妮",
                                                    "text": "嗯嗯！前辈也是，祝你们旅途顺利呀！"
                                                },
                                                {
                                                    "id": "706810817",
                                                    "speaker": "Black Screen",
                                                    "text": "格茜妮向你们挥手道别。"
                                                },
                                                {
                                                    "id": "706810818",
                                                    "speaker": "派蒙",
                                                    "text": "既然来到这里了，我们也在附近逛逛吧。"
                                                },
                                                {
                                                    "id": "706810819",
                                                    "speaker": "派蒙",
                                                    "text": "说不定会有什么奇遇呢！"
                                                },
                                                {
                                                    "id": "706810820",
                                                    "speaker": "派蒙",
                                                    "text": "听格茜妮说，前面就是<color=#00E1FFFF>璃月港</color>，有空我们也去看看吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706810815",
                                            "text": "希望你能如愿以偿！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706810806",
                            "text": "旅途的疲惫消除了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068112",
            "objective": "Additional",
            "dialogues": [
                {
