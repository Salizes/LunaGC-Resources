    "talks": [
        {
            "id": "7320307",
            "objective": "(test)73193与赛芭闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "731930501",
                    "speaker": "赛芭",
                    "text": "如果不是遇到你们，恐怕我很难看到那些蔷薇发芽。"
                },
                {
                    "id": "731930502",
                    "speaker": "赛芭",
                    "text": "早知道会这样，比起种子，当初我更应该带些书来这里。",
                    "choices": [
                        {
                            "id": "731930503",
                            "text": "你不是本地人？",
                            "response": [
                                {
                                    "id": "731930504",
                                    "speaker": "赛芭",
                                    "text": "很意外吗？这算是说明我适应得很好吧。"
                                },
                                {
                                    "id": "731930505",
                                    "speaker": "赛芭",
                                    "text": "当初刚来这里的时候，从衣食到起居习惯，每一样我都没办法适应。"
                                },
                                {
                                    "id": "731930506",
                                    "speaker": "赛芭",
                                    "text": "但过了这么久，慢慢也就接受了。"
                                },
                                {
                                    "id": "731930507",
                                    "speaker": "赛芭",
                                    "text": "只不过表面适应，并不代表内心就接受了自己的处境。"
                                },
                                {
                                    "id": "731930508",
                                    "speaker": "赛芭",
                                    "text": "能在须弥城里盛放的蔷薇，在这里始终还是难以开花。"
                                },
                                {
                                    "id": "731930509",
                                    "speaker": "Player",
                                    "text": "你是学者吗？"
                                },
                                {
                                    "id": "731930510",
                                    "speaker": "赛芭",
                                    "text": "我…曾经被称为学者，但现在不是了。"
                                },
                                {
                                    "id": "731930511",
                                    "speaker": "赛芭",
                                    "text": "我说了以我的身份不该说的话，了解了以我的身份不该了解的知识。"
                                },
                                {
                                    "id": "731930512",
                                    "speaker": "赛芭",
                                    "text": "这是有违教令院禁忌的，所以我就不再是学者了。"
                                },
                                {
                                    "id": "731930513",
                                    "speaker": "Player",
                                    "text": "你说了什么？"
                                },
                                {
                                    "id": "731930514",
                                    "speaker": "赛芭",
                                    "text": "好奇心是我们寻求智慧的原动力，但也是招致罪罚的源头。"
                                },
                                {
                                    "id": "731930515",
                                    "speaker": "赛芭",
                                    "text": "这是我被驱逐到这里来之后才明白的。"
                                },
                                {
                                    "id": "731930516",
                                    "speaker": "赛芭",
                                    "text": "安全起见，我认为不向你细说最好。"
                                },
                                {
                                    "id": "731930517",
                                    "speaker": "Player",
                                    "text": "那好吧。"
                                },
                                {
                                    "id": "731930518",
                                    "speaker": "赛芭",
                                    "text": "咳咳，不过…那个…"
                                },
                                {
                                    "id": "731930535",
                                    "speaker": "赛芭",
                                    "text": "我以为冒险家都是来去匆匆的人，帮过一次忙，你大概就不会回来了。"
                                },
                                {
                                    "id": "731930536",
                                    "speaker": "赛芭",
                                    "text": "没想到，又跟你说了这么多话。"
                                },
                                {
                                    "id": "731930537",
                                    "speaker": "赛芭",
                                    "text": "嗯…在这里，我能敞开聊天的朋友不是很多。"
                                },
                                {
                                    "id": "731930538",
                                    "speaker": "赛芭",
                                    "text": "你认为…之后…你有空来帮忙给它们施肥吗？"
                                },
                                {
                                    "id": "731930539",
                                    "speaker": "Player",
                                    "text": "可以。"
                                },
                                {
                                    "id": "731930540",
                                    "speaker": "赛芭",
                                    "text": "那…好，我会等你来的。"
                                }
                            ]
                        },
                        {
                            "id": "731930519",
                            "text": "为什么要种须弥蔷薇？",
                            "response": [
                                {
                                    "id": "731930520",
                                    "speaker": "赛芭",
                                    "text": "你可能不太了解须弥蔷薇，这种植物的用途非常广泛。"
                                },
                                {
                                    "id": "731930521",
                                    "speaker": "赛芭",
                                    "text": "它可以食用、可以药用，作为礼品，也有很高的经济价值。"
                                },
                                {
                                    "id": "731930522",
                                    "speaker": "赛芭",
                                    "text": "这还仅仅是它在我们日常生活中的常见用途。"
                                },
                                {
                                    "id": "731930523",
                                    "speaker": "赛芭",
                                    "text": "须弥蔷薇的花、叶、茎并不总是我们今天见到的这样，它曾经也有过不同的形态。"
                                },
                                {
                                    "id": "731930524",
                                    "speaker": "赛芭",
                                    "text": "我认为地理条件的改变，促使须弥蔷薇的形态特征也发生过改变。"
                                },
                                {
                                    "id": "731930525",
                                    "speaker": "赛芭",
                                    "text": "从它的形态演化过程，我们能得到很多历史地理方面的信息。"
                                },
                                {
                                    "id": "731930526",
                                    "speaker": "赛芭",
                                    "text": "这不是一两句话说得清的事，向一位路过的冒险家解释恐怕也不合规定。"
                                },
                                {
                                    "id": "731930527",
                                    "speaker": "赛芭",
                                    "text": "如果你对植物演化感兴趣，就去教令院吧，那里的植物学教育更加完备。"
                                },
                                {
                                    "id": "731930528",
                                    "speaker": "Player",
                                    "text": "所以是为了研究？"
                                },
                                {
                                    "id": "731930529",
                                    "speaker": "赛芭",
                                    "text": "我已经不是学者了，没有做研究的条件和资格。"
                                },
                                {
                                    "id": "731930530",
                                    "speaker": "赛芭",
                                    "text": "非要说为什么的话…唉，你的好奇心可真重。"
                                },
                                {
                                    "id": "731930531",
                                    "speaker": "赛芭",
                                    "text": "我以前的居所里种了很多须弥蔷薇，它们开花的时候很漂亮，我每天都看得到。"
                                },
                                {
                                    "id": "731930532",
                                    "speaker": "赛芭",
                                    "text": "有可能的话，我还想像以前一样，每天都有它们作陪。"
                                },
                                {
                                    "id": "731930533",
                                    "speaker": "赛芭",
                                    "text": "…只是这样而已。"
                                },
                                {
                                    "id": "731930534",
                                    "speaker": "Player",
                                    "text": "我能理解。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320308",
            "objective": "(test)计时$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320310",
            "objective": "(test)回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320301",
            "objective": "(test)与赛芭对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732030101",
                    "speaker": "赛芭",
                    "text": "你们来了啊，很守约呢。"
                },
                {
                    "id": "732030102",
                    "speaker": "赛芭",
                    "text": "我做了一些黄油鸡，如果你们肚子饿的话，可以一起坐下来吃。"
                },
                {
                    "id": "732030103",
                    "speaker": "派蒙",
                    "text": "黄油鸡！好耶，我要吃一大盘！",
                    "choices": [
                        {
                            "id": "732030104",
                            "text": "派蒙，这样不好…",
                            "response": [
                                {
                                    "id": "732030106",
                                    "speaker": "派蒙",
                                    "text": "唔…对不起嘛。"
                                },
                                {
                                    "id": "732030107",
                                    "speaker": "赛芭",
                                    "text": "没关系的，请不用跟我客气，喜爱食物也是人之常情。"
                                },
                                {
                                    "id": "732030108",
                                    "speaker": "赛芭",
                                    "text": "待会儿我就去把菜拿出来热一热，再给你们装好，也算是答谢你们之前帮我的忙了。"
                                },
                                {
                                    "id": "732030109",
                                    "speaker": "派蒙",
                                    "text": "呜哇，赛芭小姐，你真好！你种的蔷薇花一定会顺着你的心意，好好生长的。"
                                },
                                {
                                    "id": "732030110",
                                    "speaker": "赛芭",
                                    "text": "哈哈，这段时间，我一直在尽量保持土壤湿润，植株幼苗状态还算良好。"
                                },
                                {
                                    "id": "732030111",
                                    "speaker": "赛芭",
                                    "text": "只是它们的生长速度有点慢，让人担心。"
                                },
                                {
                                    "id": "732030112",
                                    "speaker": "赛芭",
                                    "text": "一般来说，如果胚芽状态良好，很快就应该萌发了，但这几株到现在也没有动静…"
                                },
                                {
                                    "id": "732030113",
                                    "speaker": "赛芭",
                                    "text": "不知道是不是土壤肥力不够，它们还是这个状态的话，我最好继续从外部施肥。",
                                    "choices": [
                                        {
                                            "id": "732030114",
                                            "text": "再施一次肥吧。",
                                            "response": [
                                                {
                                                    "id": "732030116",
                                                    "speaker": "赛芭",
                                                    "text": "那就又要麻烦你们了。"
                                                },
                                                {
                                                    "id": "732030117",
                                                    "speaker": "派蒙",
                                                    "text": "小事一桩，包在我们身上。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732030115",
                                            "text": "用草元素的力量试试。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732030105",
                            "text": "抱歉，派蒙是这样的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320302",
            "objective": "使用草元素的力量为幼苗「施肥」",
            "dialogues": []
        },
        {
            "id": "7320303",
            "objective": "和赛芭聊聊",
            "dialogues": [
                {
                    "id": "732030301",
                    "speaker": "赛芭",
                    "text": "这次也谢谢你们了，能在这里看到须弥蔷薇生长，我真的很开心。"
                },
                {
                    "id": "732030302",
                    "speaker": "Black Screen",
                    "text": "在赛芭和你们说话的同时，一簇簇新叶从旧叶中伸出…"
                },
                {
                    "id": "732030303",
                    "speaker": "Black Screen",
                    "text": "新叶逐渐舒展，结出了饱满的花苞…"
                },
                {
                    "id": "732030304",
                    "speaker": "Black Screen",
                    "text": "花苞缓缓绽放，赛芭种下的须弥蔷薇终于吐蕊。"
                },
                {
                    "id": "732030305",
                    "speaker": "Black Screen",
                    "text": "她折下一支须弥蔷薇，交给了你和派蒙。"
                },
                {
                    "id": "732030306",
                    "speaker": "派蒙",
                    "text": "这不好吧，本来赛芭小姐种的蔷薇就不多，现在还折了一支给我们…"
                },
                {
                    "id": "732030307",
                    "speaker": "赛芭",
                    "text": "没关系哦，如果不是你们帮忙，须弥蔷薇是没办法在这里开出花来的。",
                    "choices": [
                        {
                            "id": "732030308",
                            "text": "一点小忙。",
                            "response": [
                                {
                                    "id": "732030310",
                                    "speaker": "赛芭",
                                    "text": "一座蔷薇园当然很壮观，不过单支蔷薇也有自己的美。以前我还是学者的时候，就对蔷薇感兴趣。"
                                },
                                {
                                    "id": "732030311",
                                    "speaker": "派蒙",
                                    "text": "欸，原来赛芭小姐是位学者吗？"
                                },
                                {
                                    "id": "732030312",
                                    "speaker": "赛芭",
                                    "text": "对了，我还没有告诉过派蒙呢。我并不是一直居住在阿如村的居民，我是从教令院里…「搬」过来的。"
                                },
                                {
                                    "id": "732030313",
                                    "speaker": "派蒙",
                                    "text": "我就说嘛，赛芭小姐说话的方式好文雅，真的很像学者。"
                                },
                                {
                                    "id": "732030314",
                                    "speaker": "派蒙",
                                    "text": "我明白啦，赛芭小姐是想继续研究蔷薇，所以才会种植它们的吧。"
                                },
                                {
                                    "id": "732030315",
                                    "speaker": "赛芭",
                                    "text": "倒不能这么说，学者们对研究对象的兴趣不该是为了做研究才刻意培养出来的。"
                                },
                                {
                                    "id": "732030316",
                                    "speaker": "赛芭",
                                    "text": "是因为喜爱这个世界，所以才想了解它，想理解草木的生命轨迹。"
                                },
                                {
                                    "id": "732030317",
                                    "speaker": "赛芭",
                                    "text": "拿我举例的话，以前我有个课题——须弥地理环境演化对蔷薇物种形态的影响。"
                                },
                                {
                                    "id": "732030318",
                                    "speaker": "赛芭",
                                    "text": "你想，如果须弥的地理环境演化方向和今天完全不同，为了适应自然条件，蔷薇会演化成什么形态呢？"
                                },
                                {
                                    "id": "732030319",
                                    "speaker": "赛芭",
                                    "text": "会不会演化成爬藤植物？那样的话，今天的教令院墙壁上说不定就会爬满蔷薇。"
                                },
                                {
                                    "id": "732030320",
                                    "speaker": "赛芭",
                                    "text": "会不会演化出族生花？一开一大捧，很有气派吧？"
                                },
                                {
                                    "id": "732030321",
                                    "speaker": "赛芭",
                                    "text": "说不定还会有各种各样的颜色，白的、红的、金的…那会是一个全新的品种。"
                                },
                                {
                                    "id": "732030322",
                                    "speaker": "赛芭",
                                    "text": "当然咯，现在很少有人能发现新物种了，像过去某些顶尖学者那样培育新物种，就更别提了。"
                                },
                                {
                                    "id": "732030323",
                                    "speaker": "赛芭",
                                    "text": "我想说明的是：每一支蔷薇身上都蕴含着大量的可能性。"
                                },
                                {
                                    "id": "732030324",
                                    "speaker": "赛芭",
                                    "text": "探索这些可能性是一件很开心的事，那时候我每天都怀着兴趣开开心心地收集着标本。"
                                },
                                {
                                    "id": "732030325",
                                    "speaker": "赛芭",
                                    "text": "回想起来，真是一段纯粹又愉快的时光。"
                                },
                                {
                                    "id": "732030326",
                                    "speaker": "赛芭",
                                    "text": "总而言之，你们拿着就好了，对我来说，这可不是损失，而是快乐的分享。"
                                },
                                {
                                    "id": "732030327",
                                    "speaker": "赛芭",
                                    "text": "如果实在觉得心里别扭，以后就多带些须弥蔷薇来看我吧。"
                                },
                                {
                                    "id": "732030328",
                                    "speaker": "赛芭",
                                    "text": "和你们说话的时候，感觉很放松。"
                                },
                                {
                                    "id": "732030329",
                                    "speaker": "赛芭",
                                    "text": "不管我说些什么，你们都不会觉得我是在说「闲话」，打断我说话。"
                                },
                                {
                                    "id": "732030330",
                                    "speaker": "赛芭",
                                    "text": "我也会送你们一些小礼物的，虽然对现在的我基本没用处，但你们说不定会喜欢。"
                                },
                                {
                                    "id": "732030331",
                                    "speaker": "Player",
                                    "text": "会常来的。"
                                },
                                {
                                    "id": "732030332",
                                    "speaker": "赛芭",
                                    "text": "一定要常来看我呀。"
                                }
                            ]
                        },
                        {
                            "id": "732030309",
                            "text": "别放心上。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320309",
            "objective": "（test）开花刷suite$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320306",
            "objective": "(test)73203与赛芭闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "732030601",
                    "speaker": "赛芭",
                    "text": "来找我聊天了吗？我可攒了一肚子的话。"
                }
            ]
        },
        {
            "id": "7320304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732030401",
                    "speaker": "赛芭",
                    "text": "你不像是拥有神之眼的人，却能驾驭草元素的力量，不是一般的冒险家吧。"
                },
                {
                    "id": "732030402",
                    "speaker": "赛芭",
                    "text": "据说的确有一帮人不借助神之眼就能驱动元素力，不过相关的传闻都很糟糕，你…"
                },
                {
                    "id": "732030403",
                    "speaker": "赛芭",
                    "text": "总之我相信你是个热心的好人，不要走上歪路啊。"
                }
            ]
        }
    ]
}