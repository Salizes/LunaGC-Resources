        },
        "total_dialogue_lines": 21,
        "total_speaker_counts": {
            "Player": 3,
            "德贵": 18
        }
    },
    "talks": [
        {
            "id": "2230301",
            "objective": "与德贵对话",
            "dialogues": [
                {
                    "id": "223030101",
                    "speaker": "德贵",
                    "text": "生意真是越来越难做了…"
                },
                {
                    "id": "223030102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "223030103",
                    "speaker": "德贵",
                    "text": "嗯？哦，我说我这家酒馆的生意越来越难做了。"
                },
                {
                    "id": "223030104",
                    "speaker": "德贵",
                    "text": "我们这种管吃喝的店，开的时间长了有好有不好。"
                },
                {
                    "id": "223030105",
                    "speaker": "德贵",
                    "text": "好的是，时间长了总有名声，名声大了，自然有钱赚。"
                },
                {
                    "id": "223030106",
                    "speaker": "德贵",
                    "text": "坏的就是，吃喝总是会腻的，要是铺子大，品类多倒也没问题。"
                },
                {
                    "id": "223030107",
                    "speaker": "德贵",
                    "text": "可是我这小酒馆，又不是什么大铺面的大店子…"
                },
                {
                    "id": "223030108",
                    "speaker": "德贵",
                    "text": "主顾们吃太长时间渐渐觉着腻味，来得也越来越少，唉…"
                },
                {
                    "id": "223030109",
                    "speaker": "德贵",
                    "text": "我听说，蒙德城的酒业也很发达。他们用蒲公英酿造的「蒲公英酒」很有名。"
                },
                {
                    "id": "223030110",
                    "speaker": "德贵",
                    "text": "虽然不知道蒲公英到底能不能用来酿酒，但我也只能试试看了。"
                },
                {
                    "id": "223030111",
                    "speaker": "德贵",
                    "text": "你能帮我去蒙德一趟，带点蒲公英回来吗？",
                    "choices": [
                        {
                            "id": "223030112",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "223030113",
                                    "speaker": "德贵",
                                    "text": "那就拜托你了，我会付你报酬的。我们璃月人，说到做到。"
                                }
                            ]
                        },
                        {
                            "id": "223030114",
                            "text": "蒲公英酒吗…",
                            "response": [
                                {
                                    "id": "223030115",
                                    "speaker": "德贵",
                                    "text": "怎么？是酒的口味很怪吗？我听说，这种酒很受蒙德人欢迎啊。"
                                },
                                {
                                    "id": "223030116",
                                    "speaker": "德贵",
                                    "text": "不过，我要只是照搬蒲公英酒的方子，肯定也卖不动…"
                                },
                                {
                                    "id": "223030117",
                                    "speaker": "德贵",
                                    "text": "您先把<color=#00E1FFFF>蒲公英</color>拿来吧，我再看看怎么用璃月的法子来酿造酿造。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2230302",
            "objective": "将蒲公英交给德贵",
            "dialogues": [
                {
                    "id": "223030201",
                    "speaker": "德贵",
                    "text": "你找到<color=#00E1FFFF>蒲公英</color>了吗？"
                }
            ]
        },
        {
            "id": "2230303",
            "objective": "向德贵回报",
            "dialogues": [
                {
                    "id": "223030301",
                    "speaker": "德贵",
                    "text": "我先试试看吧，看能不能用璃月的酿酒法，来用一用这蒲公英。"
                },
                {
                    "id": "223030302",
                    "speaker": "德贵",
                    "text": "哦，这是给您的，收下吧。"
                },
                {
                    "id": "223030303",
                    "speaker": "德贵",
                    "text": "我这拿蒲公英酿酒啊，估计会失败很多次，蒲公英用完了，下次还得烦请您帮忙，可要请您多担待。"
                }
            ]
        }
    ]
}