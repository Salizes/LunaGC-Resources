    "talks": [
        {
            "id": "7227008",
            "objective": "前往「天光流泻之处」",
            "dialogues": []
        },
        {
            "id": "7227009",
            "objective": "在「常夜」时调查池水",
            "dialogues": []
        },
        {
            "id": "7227001",
            "objective": "和封印前的残魂对话",
            "dialogues": [
                {
                    "id": "722700101",
                    "speaker": "大门",
                    "text": "我乃末代地走官·大门。珊瑚宫之勇者，我认可你挑战的荣誉。"
                },
                {
                    "id": "722700102",
                    "speaker": "大门",
                    "text": "勇武即是不择手段战胜一切敌人的能力。你只要打败所有敌人解放「高门之火」就可以了。"
                },
                {
                    "id": "722700103",
                    "speaker": "大门",
                    "text": "顺带一提，此处的敌人皆是虚像。乃是阳炎幻法与你自己内心所知晓的强敌之印象互摄而成的。"
                },
                {
                    "id": "722700104",
                    "speaker": "大门",
                    "text": "尽管如此，稍有不慎还是会受伤甚至被打垮的。"
                },
                {
                    "id": "722700105",
                    "speaker": "大门",
                    "text": "我将在上方三界塔处等候你完成挑战。"
                }
            ]
        },
        {
            "id": "7227002",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722700201",
                    "speaker": "大门",
                    "text": "珊瑚宫之勇者，已经完成了挑战吗？"
                },
                {
                    "id": "722700202",
                    "speaker": "大门",
                    "text": "追求勇武，那就用尽一切手段打倒所有挡在面前的敌人就可以了。"
                }
            ]
        },
        {
            "id": "7227003",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722700301",
                    "speaker": "大门",
                    "text": "漂亮漂亮！把一切强敌都粉碎了！"
                },
                {
                    "id": "722700302",
                    "speaker": "大门",
                    "text": "如此威武，可称「常世无双」！我，末代地走官·大门，于此认可你的勇武。"
                }
            ]
        },
        {
            "id": "7227004",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722700401",
                    "speaker": "宇陀",
                    "text": "我乃末代地走官·大门。虽然不知道你怎么来的，请回吧。"
                }
            ]
        },
        {
