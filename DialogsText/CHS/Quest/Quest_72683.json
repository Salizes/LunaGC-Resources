    "talks": [
        {
            "id": "7268301",
            "objective": "前去察看画画的人",
            "dialogues": [
                {
                    "id": "726830101",
                    "speaker": "朝雾",
                    "text": "咳、咳…这样…还是不行…"
                },
                {
                    "id": "726830102",
                    "speaker": "朝雾",
                    "text": "再拖下去，这一期的稿件就交不上去了…呜…",
                    "choices": [
                        {
                            "id": "726830103",
                            "text": "你好…",
                            "response": [
                                {
                                    "id": "726830105",
                                    "speaker": "朝雾",
                                    "text": "欸？！"
                                },
                                {
                                    "id": "726830106",
                                    "speaker": "朝雾",
                                    "text": "对不起！对不起！我今天一定会交稿的！"
                                },
                                {
                                    "id": "726830107",
                                    "speaker": "派蒙",
                                    "text": "呜哇！等一下，我们…"
                                },
                                {
                                    "id": "726830108",
                                    "speaker": "朝雾",
                                    "text": "森子小姐！请您…"
                                },
                                {
                                    "id": "726830109",
                                    "speaker": "朝雾",
                                    "text": "咦？原来不是森子小姐…太好…咳咳！咳…"
                                },
                                {
                                    "id": "726830110",
                                    "speaker": "Player",
                                    "text": "森子小姐是…"
                                },
                                {
                                    "id": "726830111",
                                    "speaker": "朝雾",
                                    "text": "森子小姐是我的责任编辑。"
                                },
                                {
                                    "id": "726830112",
                                    "speaker": "朝雾",
                                    "text": "我叫朝雾，是一个…嗯…算是一名「自由插画师」吧。森子小姐…是负责我的责任编辑。"
                                },
                                {
                                    "id": "726830113",
                                    "speaker": "派蒙",
                                    "text": "插画？那是什么呀？"
                                },
                                {
                                    "id": "726830114",
                                    "speaker": "朝雾",
                                    "text": "你们应该也读过「八重堂」里的那些轻小说吧。"
                                },
                                {
                                    "id": "726830115",
                                    "speaker": "朝雾",
                                    "text": "在那些小说里，不是偶尔会有几页不是文字而是画吗？"
                                },
                                {
                                    "id": "726830116",
                                    "speaker": "朝雾",
                                    "text": "这种插入轻小说页面内的画，就是「插画」喔。"
                                },
                                {
                                    "id": "726830117",
                                    "speaker": "朝雾",
                                    "text": "如果小说里出现了某些重要的场景或者剧情，或者是作者想要让主角的形象正式出现的时候，有的作者就会选择约上一幅插画。"
                                },
                                {
                                    "id": "726830118",
                                    "speaker": "朝雾",
                                    "text": "这样，不仅会让读者读起小说来更有感觉，整本轻小说的内容也会更加丰富呢。"
                                },
                                {
                                    "id": "726830119",
                                    "speaker": "派蒙",
                                    "text": "喔…原来是这样，轻小说还真是复杂啊…"
                                },
                                {
                                    "id": "726830120",
                                    "speaker": "朝雾",
                                    "text": "我可以为你们推荐几本！比如那本…咳！咳咳…咳…"
                                },
                                {
                                    "id": "726830121",
                                    "speaker": "Player",
                                    "text": "你没事吧…"
                                },
                                {
                                    "id": "726830122",
                                    "speaker": "朝雾",
                                    "text": "没事，没事，我的身体一直不太好，画插画的时候又总是熬夜，有时候也会忘记吃饭…"
                                },
                                {
                                    "id": "726830123",
                                    "speaker": "朝雾",
                                    "text": "咳咳…然后身体就越来越差了…"
                                },
                                {
                                    "id": "726830124",
                                    "speaker": "派蒙",
                                    "text": "你身体这么差，为什么还要在这里画画呀？不能回家画吗？"
                                },
                                {
                                    "id": "726830125",
                                    "speaker": "朝雾",
                                    "text": "我是为了取材，才到这里来的。"
                                },
                                {
                                    "id": "726830126",
                                    "speaker": "朝雾",
                                    "text": "我最近完全没有画画的灵感，已经有好几幅插画稿件过了截稿期了。"
                                },
                                {
                                    "id": "726830127",
                                    "speaker": "朝雾",
                                    "text": "森子小姐已经帮我把截稿日推迟了好多次了，我要是再交不了，森子小姐肯定会生气的。"
                                },
                                {
                                    "id": "726830128",
                                    "speaker": "朝雾",
                                    "text": "我觉得如果能出去走走的话，说不定能得到什么灵感，所以就想要出门旅行。"
                                },
                                {
                                    "id": "726830129",
                                    "speaker": "朝雾",
                                    "text": "结果…哈哈…如你们所见，没逛多久我就有点受不了了…"
                                },
                                {
                                    "id": "726830130",
                                    "speaker": "朝雾",
                                    "text": "唉，我还是去冒险家协会挂一个委托，拜托哪位手里有「留影机」的冒险家帮忙吧。"
                                },
                                {
                                    "id": "726830131",
                                    "speaker": "派蒙",
                                    "text": "欸？说到「留影机」…",
                                    "choices": [
                                        {
                                            "id": "726830132",
                                            "text": "我手里倒是有「留影机」…",
                                            "response": [
                                                {
                                                    "id": "726830133",
                                                    "speaker": "朝雾",
                                                    "text": "欸？！你有留影机吗？"
                                                },
                                                {
                                                    "id": "726830135",
                                                    "speaker": "朝雾",
                                                    "text": "我、我是拜托冒险家用「留影机」拍摄各种画片！"
                                                },
                                                {
                                                    "id": "726830136",
                                                    "speaker": "朝雾",
                                                    "text": "我听说，外面有很多有趣的地方！比如蒙德附近那座很高的雪山啦，璃月的那片有很多柱子的地方啦…"
                                                },
                                                {
                                                    "id": "726830137",
                                                    "speaker": "朝雾",
                                                    "text": "还有还有！璃月有一片叫做「绝云间」的地方，据说那里住着仙人呢！"
                                                },
                                                {
                                                    "id": "726830138",
                                                    "speaker": "朝雾",
                                                    "text": "仙人的居所…光是想想就觉得激动…"
                                                },
                                                {
                                                    "id": "726830139",
                                                    "speaker": "朝雾",
                                                    "text": "我因为身体原因，实在不能亲身过去旅行…"
                                                },
                                                {
                                                    "id": "726830140",
                                                    "speaker": "朝雾",
                                                    "text": "但是，如果你能帮我用「留影机」记录下那边的景致…我一定也能…咳咳！咳咳…"
                                                },
                                                {
                                                    "id": "726830141",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇！你冷静点！",
                                                    "choices": [
                                                        {
                                                            "id": "726830142",
                                                            "text": "交给我吧。",
                                                            "response": [
                                                                {
                                                                    "id": "726830144",
                                                                    "speaker": "朝雾",
                                                                    "text": "是吗！？太好了！我、我有很多想要看的地方，稍等一下，我找出来给你…"
                                                                },
                                                                {
                                                                    "id": "726830145",
                                                                    "speaker": "朝雾",
                                                                    "text": "对了，报酬的话不用担心，我还是有一些积蓄的…"
                                                                },
                                                                {
                                                                    "id": "726830146",
                                                                    "speaker": "朝雾",
                                                                    "text": "我的笔记本呢？笔记本，笔记本…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726830143",
                                                            "text": "我会想办法的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726830134",
                                            "text": "可是，「留影机」能做什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726830104",
                            "text": "请问…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268302",
            "objective": "与朝雾对话",
            "dialogues": []
        }
    ]
}