    "talks": [
        {
            "id": "7450901",
            "objective": "与摊位旁的两人对话",
            "dialogues": [
                {
                    "id": "745090101",
                    "speaker": "Black Screen",
                    "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…"
                },
                {
                    "id": "745090102",
                    "speaker": "左右加",
                    "text": "呀吼！「智巧勇武双连星」，你们又来玩「小小灵蕈大幻戏」啦！"
                },
                {
                    "id": "745090103",
                    "speaker": "左右加",
                    "text": "昂吉安妮小姐接到了任务，先回执律庭去了，之后就由我来陪你们玩！"
                },
                {
                    "id": "745090104",
                    "speaker": "派蒙",
                    "text": "左右加，你回来了！"
                },
                {
                    "id": "745090105",
                    "speaker": "派蒙",
                    "text": "虽然之前见到海妮耶的时候，已经大大吃惊过一次了，但你更夸张，我都觉得你这套衣服都有点精神过头了…"
                },
                {
                    "id": "745090106",
                    "speaker": "左右加",
                    "text": "有精神是好事，我的活儿还有很多，干劲可不能早早用完。"
                },
                {
                    "id": "745090107",
                    "speaker": "左右加",
                    "text": "要像挥舞斧子一样，把难题一个一个都劈开，嘿嘿！",
                    "choices": [
                        {
                            "id": "745090108",
                            "text": "报社那边的事忙得怎么样了？",
                            "response": [
                                {
                                    "id": "745090110",
                                    "speaker": "左右加",
                                    "text": "计划正在稳步推进，这种新奇的活动能吸引不少目光，报社也不会放过大肆宣传的机会！"
                                },
                                {
                                    "id": "745090111",
                                    "speaker": "左右加",
                                    "text": "虽然我们没有拿到最重要的版面，但显而易见，最近活动受欢迎的程度一直在上升。"
                                },
                                {
                                    "id": "745090112",
                                    "speaker": "海妮耶",
                                    "text": "的确，这段时间来摊位试玩「小小灵蕈大幻戏」的普通市民在不断增加。"
                                },
                                {
                                    "id": "745090113",
                                    "speaker": "海妮耶",
                                    "text": "不少人开始讨论，如何搭配「小小灵蕈」的队伍，才能最快赢下游戏。"
                                },
                                {
                                    "id": "745090114",
                                    "speaker": "海妮耶",
                                    "text": "我也有听说，大家都想找到「黄金流星」和「白银伴星」，和你们好好较量一番，见识一下高手的玩法。",
                                    "choices": [
                                        {
                                            "id": "745090115",
                                            "text": "哈哈！大师可不会随便出手！",
                                            "response": [
                                                {
                                                    "id": "745090117",
                                                    "speaker": "派蒙",
                                                    "text": "除非海妮耶和左右加亲自出手，你们两位老朋友已经非常了解我们的策略了。"
                                                },
                                                {
                                                    "id": "745090118",
                                                    "speaker": "派蒙",
                                                    "text": "我们之间的对局，才算是…技术含量最高的对局！"
                                                },
                                                {
                                                    "id": "745090119",
                                                    "speaker": "左右加",
                                                    "text": "话都说到这份上了，我们确实也该友情切磋一下了吧？"
                                                },
                                                {
                                                    "id": "745090120",
                                                    "speaker": "左右加",
                                                    "text": "仔细一想，上次我们直接较量，还是在第一次「月莲杯驯兽师大赛」的时候，我两下子就被你们打垮了。"
                                                },
                                                {
                                                    "id": "745090121",
                                                    "speaker": "左右加",
                                                    "text": "有点怀念呀…从那以后，我和海妮耶经历了很多事，有了很多变化，你们肯定也一样吧…"
                                                },
                                                {
                                                    "id": "745090122",
                                                    "speaker": "左右加",
                                                    "text": "但你们身上那股…清澈干练的勇气，无所畏惧的豪气，还是像水晶一样坚定、牢固！"
                                                },
                                                {
                                                    "id": "745090123",
                                                    "speaker": "左右加",
                                                    "text": "单凭这一点来看，我们在筹备「灵蕈棋阵」后就决定跟着你混，真是选对老大了！"
                                                },
                                                {
                                                    "id": "745090124",
                                                    "speaker": "派蒙",
                                                    "text": "左右加怎么突然开始感慨了？这难道是…作家特有的状态吗？",
                                                    "choices": [
                                                        {
                                                            "id": "745090125",
                                                            "text": "我也很怀念开心的往事！",
                                                            "response": [
                                                                {
                                                                    "id": "745090127",
                                                                    "speaker": "左右加",
                                                                    "text": "好！真是漂亮的台词。"
                                                                },
                                                                {
                                                                    "id": "745090128",
                                                                    "speaker": "左右加",
                                                                    "text": "那就看好啦，作为游戏的设计者之一，我可是准备了很强力的底牌的！"
                                                                },
                                                                {
                                                                    "id": "745090129",
                                                                    "speaker": "海妮耶",
                                                                    "text": "要用那个吗，左右加？"
                                                                },
                                                                {
                                                                    "id": "745090130",
                                                                    "speaker": "左右加",
                                                                    "text": "没错，我来暖暖场，就由海妮耶指挥强劲的对手，来和你们再次打出一场精彩的对决吧！"
                                                                },
                                                                {
                                                                    "id": "745090131",
                                                                    "speaker": "海妮耶",
                                                                    "text": "那就请多关照了，「黄金流星」和「白银伴星」！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745090132",
                                                                            "text": "好哦好哦！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745090134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#时隔这么久，{NICKNAME}又要和海妮耶较量一番…我也激动起来了，"
                                                                                },
                                                                                {
                                                                                    "id": "745090135",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过这次是友好纯粹的对局，要玩得开开心心！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745090133",
                                                                            "text": "开打开打！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745090126",
                                                            "text": "我们还能创造新的回忆！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745090116",
                                            "text": "哎吔！为什么要急着挨打呢？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745090109",
                            "text": "活动的广告投放还算顺利吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450902",
