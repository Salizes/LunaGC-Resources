    "talks": [
        {
            "id": "7221601",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722160101",
                    "speaker": "「寝子」",
                    "text": "来了啊。石头人类说，他马上就好了。"
                },
                {
                    "id": "722160102",
                    "speaker": "「寝子」",
                    "text": "汝等，快随奴家去看看吧，石头人类就在那边。"
                }
            ]
        },
        {
            "id": "7221603",
            "objective": "test 天气变化用 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722160301",
                    "speaker": "大岛纯平",
                    "text": "代宫司大人居然这么高兴，看来那个对它来说，真的是很重要的人啊。"
                },
                {
                    "id": "722160302",
                    "speaker": "Player",
                    "text": "但是，不知道她到底在哪…"
                }
            ]
        },
        {
            "id": "7221604",
            "objective": "test 锁时间用 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722160401",
                    "speaker": "悦子",
                    "text": "确实，「阿响」…「浅濑神社」和「百目鬼」，都很让人在意。",
                    "choices": [
                        {
                            "id": "722160402",
                            "text": "你们是什么时候冒出来的…",
                            "response": [
                                {
                                    "id": "722160403",
                                    "speaker": "悦子",
                                    "text": "岛上闹出那么大的动静，我们自然就过来了。"
                                },
                                {
                                    "id": "722160404",
                                    "speaker": "悦子",
                                    "text": "不过，有些事我觉得，必须要和你们说一下。"
                                },
                                {
                                    "id": "722160405",
                                    "speaker": "悦子",
                                    "text": "大祐，说明一下吧。"
                                },
                                {
                                    "id": "722160406",
                                    "speaker": "大祐",
                                    "text": "啊…好的，悦子小姐。是这样的，我要说的是一些…有关这座清籁岛的事情…"
                                },
                                {
                                    "id": "722160408",
                                    "speaker": "大祐",
                                    "text": "清籁岛的历史实在是太久远了，虽然协会已经特意搜罗过了资料，但还是几乎没找到什么有用的…"
                                },
                                {
                                    "id": "722160409",
                                    "speaker": "大祐",
                                    "text": "根据协会给的资料，几百年前，这里似乎曾经是一处「海贼」的聚集点，当时，是由幕府出面扫清了所有海贼，并且把岛上的居民都迁移到了别处…"
                                },
                                {
                                    "id": "722160410",
                                    "speaker": "大祐",
                                    "text": "那个「百目鬼」，如果不出意外的话，也许正是当时和幕府正面冲突过的海贼头目「赤穗百目鬼」，卷宗里明确记录着他的名字。"
                                },
                                {
                                    "id": "722160411",
                                    "speaker": "大祐",
                                    "text": "据协会给我们的那些资料里记载，这位「赤穗百目鬼」指挥着海贼的船队，和幕府在海上作战。"
                                },
                                {
                                    "id": "722160412",
                                    "speaker": "大祐",
                                    "text": "虽然他的船队很快被幕府压制了下去，被迫向清籁岛逃窜…"
                                },
                                {
                                    "id": "722160413",
                                    "speaker": "大祐",
                                    "text": "但是，幕府的船队在追击他的时候，清籁岛上突然爆发了一阵不知来由的雷暴。"
                                },
                                {
                                    "id": "722160414",
                                    "speaker": "大祐",
                                    "text": "赤穗百目鬼的船队和幕府的船队一起被雷暴击中…就这样全部失去了踪迹。"
                                },
                                {
                                    "id": "722160415",
                                    "speaker": "Player",
                                    "text": "雷暴…"
                                },
                                {
                                    "id": "722160416",
                                    "speaker": "悦子",
                                    "text": "接下来的我来说吧…这件事里最大的疑点，就是那场突然出现的雷暴。"
                                },
                                {
                                    "id": "722160417",
                                    "speaker": "悦子",
                                    "text": "虽然赤穗百目鬼的船队也被雷暴波及，几乎全灭…但幕府派来清籁岛的船队也几乎全军覆没，被迫退回鸣神岛，过了一段时间才重整好了船队。"
                                },
                                {
                                    "id": "722160418",
                                    "speaker": "悦子",
                                    "text": "那场雷暴实在来得太过恰到好处，简直就像是…有人特意操控的一样。"
                                },
                                {
                                    "id": "722160419",
                                    "speaker": "悦子",
                                    "text": "你还记得，这座岛上被特意解开封印的那些「镇石」吧。"
                                },
                                {
                                    "id": "722160420",
                                    "speaker": "悦子",
                                    "text": "还有，我们封印了这些「镇石」之后，岛上的雷暴也平息了。"
                                },
                                {
                                    "id": "722160421",
                                    "speaker": "悦子",
                                    "text": "我不想妄下推断，但是…我感觉这一切多多少少有些关联。"
                                },
                                {
                                    "id": "722160422",
                                    "speaker": "大祐",
                                    "text": "不然，我们去问问寝子大人…"
                                },
                                {
                                    "id": "722160423",
                                    "speaker": "悦子",
                                    "text": "…算了吧。资料记载那位百目鬼失踪了。说是失踪，但被那种雷暴击中，也许已经…"
                                },
                                {
                                    "id": "722160424",
                                    "speaker": "悦子",
                                    "text": "我们会继续在这座岛上探索，也继续搜集关于这件事的线索，等过段时间，我们就会回去向协会报告。"
                                },
                                {
                                    "id": "722160425",
                                    "speaker": "悦子",
                                    "text": "呵呵，旅行者，说不定到时候我们还会继续合作呢。"
                                },
                                {
                                    "id": "722160426",
                                    "speaker": "Player",
                                    "text": "到时候请多多关照。"
                                },
                                {
                                    "id": "722160427",
                                    "speaker": "悦子",
                                    "text": "彼此彼此。"
                                },
                                {
                                    "id": "722160428",
                                    "speaker": "悦子",
                                    "text": "大祐，准备一下，我们继续制订探索计划。"
                                },
                                {
                                    "id": "722160429",
                                    "speaker": "大祐",
                                    "text": "呃…悦子小姐，那寝子大人…"
                                },
                                {
                                    "id": "722160430",
                                    "speaker": "悦子",
                                    "text": "你之前怎么和那只猫相处，以后也怎么和那只猫相处。"
                                },
                                {
                                    "id": "722160431",
                                    "speaker": "悦子",
                                    "text": "但是记住，不要说任何不该说的话。"
                                },
                                {
                                    "id": "722160432",
                                    "speaker": "悦子",
                                    "text": "它…现在应该很开心，不要说任何煞风景的话。"
                                },
                                {
                                    "id": "722160433",
                                    "speaker": "大祐",
                                    "text": "我知道了！悦子小姐，嘿嘿，你果然还是很…"
                                },
                                {
                                    "id": "722160434",
                                    "speaker": "悦子",
                                    "text": "…只不过是为了更好地完成委托而已，快点去工作。"
                                },
                                {
                                    "id": "722160435",
                                    "speaker": "悦子",
                                    "text": "清籁岛…看来这座岛上，还有很多秘密…"
                                }
                            ]
                        },
                        {
                            "id": "722160407",
                            "text": "你们知道什么吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221602",
            "objective": "与大岛纯平对话",
            "dialogues": [
                {
                    "id": "722160201",
                    "speaker": "大岛纯平",
                    "text": "呼，总算是要完成了，真是个大工程…"
                },
                {
                    "id": "722160202",
                    "speaker": "大岛纯平",
                    "text": "是你们啊，还有代宫司大人。"
                },
                {
                    "id": "722160203",
                    "speaker": "「寝子」",
                    "text": "怎么样，好了吗？"
                },
                {
                    "id": "722160204",
                    "speaker": "大岛纯平",
                    "text": "喔！那是当然了，嘿嘿，为了有点仪式感，我可是专门留了最后一个角，等着代宫司大人过来再敲掉呢。"
                },
                {
                    "id": "722160205",
                    "speaker": "Player",
                    "text": "真是有心了。"
                },
                {
                    "id": "722160206",
                    "speaker": "大岛纯平",
                    "text": "嘿嘿，那是当然了，制作雕像这种重要的事，当然要严肃对待了。"
                },
                {
                    "id": "722160207",
                    "speaker": "「寝子」",
                    "text": "喵喵…敲石头，很重要吗？"
                },
                {
                    "id": "722160208",
                    "speaker": "大岛纯平",
                    "text": "嗯…怎么说呢，一般来说，做成雕像的东西，都是很重要的东西。"
                },
                {
                    "id": "722160209",
                    "speaker": "Player",
                    "text": "那派蒙应该给吃的做雕像。"
                },
                {
                    "id": "722160210",
                    "speaker": "派蒙",
                    "text": "喂！真没礼貌！"
                },
                {
                    "id": "722160211",
                    "speaker": "「寝子」",
                    "text": "也就是好东西？"
                },
                {
                    "id": "722160212",
                    "speaker": "大岛纯平",
                    "text": "哈哈哈，那应该…嗯…比好东西还好！毕竟雕像这种东西，可以称得上是「永恒的留念」嘛，哈哈哈！"
                },
                {
                    "id": "722160213",
                    "speaker": "「寝子」",
                    "text": "不是哦。不是「永恒的留念」。"
                },
                {
                    "id": "722160214",
                    "speaker": "「寝子」",
                    "text": "奴家是为了，阿响回来的时候，如果找不到路，可以看到石头奴家。"
                },
                {
                    "id": "722160215",
                    "speaker": "「寝子」",
                    "text": "然后就知道，自己要到这里来，而不会走错，走到别的地方去。"
                },
                {
                    "id": "722160216",
                    "speaker": "大岛纯平",
                    "text": "是、是这样啊。代宫司大人真是对那位「阿响」有心了啊。"
                },
                {
                    "id": "722160217",
                    "speaker": "Player",
                    "text": "寝子…"
                },
                {
                    "id": "722160218",
                    "speaker": "「寝子」",
                    "text": "阿响随时都会回来的。而且她和百目鬼说过，石头奴家做好的时候，就会发生好事。"
                },
                {
                    "id": "722160219",
                    "speaker": "「寝子」",
                    "text": "话说回来，石头人类，汝还需要奴家干什么吗？"
                },
                {
                    "id": "722160220",
                    "speaker": "大岛纯平",
                    "text": "倒也没啥…那么闲话不说了，既然代宫司大人已经在这里了，那我可要敲掉这最后一角了！"
                },
                {
                    "id": "722160221",
                    "speaker": "大岛纯平",
                    "text": "三…二…一！"
                },
                {
                    "id": "722160222",
                    "speaker": "大岛纯平",
                    "text": "这、这云，到底是…",
                    "choices": [
                        {
                            "id": "722160223",
                            "text": "变成猫的模样了…",
                            "response": [
                                {
                                    "id": "722160225",
                                    "speaker": "「寝子」",
                                    "text": "是阿响。"
                                },
                                {
                                    "id": "722160226",
                                    "speaker": "Player",
                                    "text": "欸？"
                                },
                                {
                                    "id": "722160227",
                                    "speaker": "大岛纯平",
                                    "text": "阿响？"
                                },
                                {
                                    "id": "722160228",
                                    "speaker": "「寝子」",
                                    "text": "喵喵喵！一定是阿响！这就是阿响说的！一定会出现的好事！"
                                },
                                {
                                    "id": "722160229",
                                    "speaker": "「寝子」",
                                    "text": "她说过的，她和奴家说过的，只要敲好那块石头，就一定会出现好事！"
                                },
                                {
                                    "id": "722160230",
                                    "speaker": "「寝子」",
                                    "text": "太好了，太好了！阿响说的是真的！"
                                },
                                {
                                    "id": "722160231",
                                    "speaker": "「寝子」",
                                    "text": "她肯定会回来的！"
                                },
                                {
                                    "id": "722160232",
                                    "speaker": "大岛纯平",
                                    "text": "喔…喔！哈哈哈，虽然不知道是什么情况，但看代宫司大人的模样，这肯定是一件好事啊。"
                                },
                                {
                                    "id": "722160233",
                                    "speaker": "Player",
                                    "text": "寝子…"
                                },
                                {
                                    "id": "722160234",
                                    "speaker": "「寝子」",
                                    "text": "有了汝等，神社也变得漂亮了。"
                                },
                                {
                                    "id": "722160235",
                                    "speaker": "「寝子」",
                                    "text": "「塞钱箱」也修好了。"
                                },
                                {
                                    "id": "722160236",
                                    "speaker": "「寝子」",
                                    "text": "「绘马架」也修好了。"
                                },
                                {
                                    "id": "722160237",
                                    "speaker": "「寝子」",
                                    "text": "还造了石头奴家。这样一来，阿响一定会回来的。"
                                },
                                {
                                    "id": "722160238",
                                    "speaker": "「寝子」",
                                    "text": "还有，百目鬼、蛇目，还有好多好多阿响的朋友，都会和阿响一起回来。"
                                },
                                {
                                    "id": "722160239",
                                    "speaker": "「寝子」",
                                    "text": "汝啊，是好人！比饭还好！阿响会喜欢你的！"
                                },
                                {
                                    "id": "722160240",
                                    "speaker": "「寝子」",
                                    "text": "奴家得去把小家伙们叫来，跟他们交代一下，阿响的事情。然后，还有，会有很多人过来拜拜。不好好叮嘱他们可不行…"
                                },
                                {
                                    "id": "722160241",
                                    "speaker": "「寝子」",
                                    "text": "在那之前，奴家必须要把所有事情都打理好才行…"
                                },
                                {
                                    "id": "722160242",
                                    "speaker": "「寝子」",
                                    "text": "阿响…喵喵喵！太好了，太好了！"
                                }
                            ]
                        },
                        {
                            "id": "722160224",
                            "text": "这到底是怎么回事…"
                        }
                    ]
                }
            ]
        }
    ]
}