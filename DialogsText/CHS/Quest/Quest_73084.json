    "talks": [
        {
            "id": "7308418",
            "objective": "test*隐藏*主动和冒险家对话$HIDDEN",
            "dialogues": [
                {
                    "id": "730840101",
                    "speaker": "阿弗拉图",
                    "text": "你们是受本人阿弗拉图委托而来的镀金旅团吗？如果不是的话，还是请在此留步吧。"
                },
                {
                    "id": "730840102",
                    "speaker": "阿弗拉图",
                    "text": "前面的区域很危险，我已经委托了聚砂厅让镀金旅团来处理了，普通人还是小心为好。"
                },
                {
                    "id": "730840103",
                    "speaker": "阿弗拉图",
                    "text": "作为教令官，你们要是出了什么意外的话，那就是我的失职了。",
                    "choices": [
                        {
                            "id": "730840104",
                            "text": "我们不是普通人。",
                            "response": [
                                {
                                    "id": "730840105",
                                    "speaker": "阿弗拉图",
                                    "text": "唔…那些初来乍到的冒险家们都这么说，在沙漠过于自信可是很危险的。"
                                },
                                {
                                    "id": "730840108",
                                    "speaker": "阿弗拉图",
                                    "text": "注意到那边的巨大机械了吗，那是传说中荼诃人的遗物。"
                                },
                                {
                                    "id": "730840109",
                                    "speaker": "Player",
                                    "text": "荼诃人？"
                                },
                                {
                                    "id": "730840110",
                                    "speaker": "阿弗拉图",
                                    "text": "嗯，通常的说法应该是坎瑞亚？荼诃是我们因论派喜欢用的古称。"
                                },
                                {
                                    "id": "730840111",
                                    "speaker": "阿弗拉图",
                                    "text": "传说五百年前，荼诃{RUBY#[D]坎瑞亚}古国的「白鹄骑士」曾驾驶着这些巨大的机械对抗黑渊涌出的魔群。"
                                },
                                {
                                    "id": "730840112",
                                    "speaker": "阿弗拉图",
                                    "text": "在残酷的战争后，最终残留下来的三台遗迹巨像被贤者们所封印，这台遗迹巨像就是其中之一。"
                                },
                                {
                                    "id": "730840113",
                                    "speaker": "阿弗拉图",
                                    "text": "按理来说这台机械已经在此静默了数百年了，但是不知道怎么最近突然活跃了起来，甚至还开始攻击附近的人类。"
                                },
                                {
                                    "id": "730840114",
                                    "speaker": "阿弗拉图",
                                    "text": "无差别地用激光炮攻击附近的活物，这样危险的机能在这些被封印的遗迹巨像身上还是第一次见。没办法放任不管。"
                                },
                                {
                                    "id": "730840115",
                                    "speaker": "阿弗拉图",
                                    "text": "明明为这些机械提供能源的混沌炉心早就进行过无害化处理了，没想到过了几百年竟然还能运行，真是奇怪。"
                                },
                                {
                                    "id": "730840116",
                                    "speaker": "派蒙",
                                    "text": "混沌炉心？听上去和遗迹守卫一样嘛。"
                                },
                                {
                                    "id": "730840117",
                                    "speaker": "阿弗拉图",
                                    "text": "哦哦，你们知道遗迹守卫吗，那解释起来就要方便多了。简单来说遗迹巨像就像是超级巨大版的遗迹守卫。"
                                },
                                {
                                    "id": "730840118",
                                    "speaker": "阿弗拉图",
                                    "text": "不过和遗迹守卫不同，遗迹巨像虽然也装载了自律系统，但主要还是由人类操纵的。"
                                },
                                {
                                    "id": "730840119",
                                    "speaker": "阿弗拉图",
                                    "text": "这也是最奇怪的地方，进入遗迹巨像的通路都被贤者利用「须陀流心」的力量封印起来了，应该没有人能够进去启动它才对。"
                                },
                                {
                                    "id": "730840120",
                                    "speaker": "阿弗拉图",
                                    "text": "是有人通过其他的方法进去了吗？还是说触发了什么我们还不知道的自启动机制呢？"
                                },
                                {
                                    "id": "730840121",
                                    "speaker": "Player",
                                    "text": "要进去看看才知道吧。"
                                },
                                {
                                    "id": "730840122",
                                    "speaker": "阿弗拉图",
                                    "text": "话是这么说，不过不知道是不是聚砂厅的业务太忙了，这么久也没有镀金旅团的人过来。"
                                },
                                {
                                    "id": "730840123",
                                    "speaker": "阿弗拉图",
                                    "text": "教令院的封印还好说，问题是进入遗迹巨像的通路入口是被巨石堵住的，靠我自己可没办法挪开。"
                                },
                                {
                                    "id": "730840124",
                                    "speaker": "派蒙",
                                    "text": "哦哦，这个的话我们倒是可以帮忙。"
                                },
                                {
                                    "id": "730840125",
                                    "speaker": "派蒙",
                                    "text": "#如果能把给镀金旅团的报酬给我们的话。对吧？{NICKNAME}。"
                                },
                                {
                                    "id": "730840126",
                                    "speaker": "阿弗拉图",
                                    "text": "你们是冒险家吗？如果是一般民众的话，我可不能让你们冒这样的风险。"
                                },
                                {
                                    "id": "730840127",
                                    "speaker": "阿弗拉图",
                                    "text": "毕竟这家伙的激光炮可不是闹着玩的，要是让你们白白送命的话，我可没法向教令院交待。",
                                    "choices": [
                                        {
                                            "id": "730840128",
                                            "text": "我们是注册在籍的冒险家。",
                                            "response": [
                                                {
                                                    "id": "730840129",
                                                    "speaker": "阿弗拉图",
                                                    "text": "如果是这样的话，程序上倒是没有问题。"
                                                },
                                                {
                                                    "id": "730840132",
                                                    "speaker": "阿弗拉图",
                                                    "text": "毕竟我也还有重要的研究工作，一直耽搁在这里也不是办法。为了尽快解决就交给你们了。"
                                                },
                                                {
                                                    "id": "730840133",
                                                    "speaker": "阿弗拉图",
                                                    "text": "那么委托就是进入遗迹巨像里面关闭它的自律系统，如果能搞清楚遗迹巨像发生异变的原因就更好了。"
                                                },
                                                {
                                                    "id": "730840134",
                                                    "speaker": "阿弗拉图",
                                                    "text": "自律系统的开关应该是在驾驶舱里，成功关闭之后会进入手动模式。不过驾驶舱也被封印了，只有将封印解除才能进到里面。"
                                                },
                                                {
                                                    "id": "730840135",
                                                    "speaker": "阿弗拉图",
                                                    "text": "嗯…根据记载，维持封印力量的是散布在巨像内的三组「须陀流心」，只要把它们都打破就好了。"
                                                },
                                                {
                                                    "id": "730840136",
                                                    "speaker": "阿弗拉图",
                                                    "text": "不过要注意小心不要破坏机关内部的结构啊，毕竟这可是教令院登记在册的重要文物。"
                                                },
                                                {
                                                    "id": "730840137",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，好说好说，就交给我们好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730840130",
                                            "text": "我们是闻名诸国的冒险家。",
                                            "response": [
                                                {
                                                    "id": "730840131",
                                                    "speaker": "阿弗拉图",
                                                    "text": "是吗？我之后会向冒险家协会查证的，现在就先姑且相信你们好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730840106",
                            "text": "前面发生了什么吗？",
                            "response": [
                                {
                                    "id": "730840107",
                                    "speaker": "阿弗拉图",
                                    "text": "发生了一些异变哪。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7308401",
            "objective": "test*隐藏*到地方强制进入对话$HIDDEN",
