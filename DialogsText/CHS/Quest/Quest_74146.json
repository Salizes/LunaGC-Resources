    },
    "talks": [
        {
            "id": "7414601",
            "objective": "",
            "dialogues": [
                {
                    "id": "741460101",
                    "speaker": "安",
                    "text": "#{NICKNAME}骑士…",
                    "choices": [
                        {
                            "id": "741460102",
                            "text": "关于现在的情况…",
                            "response": [
                                {
                                    "id": "741460103",
                                    "speaker": "安",
                                    "text": "我好像想起了一些…一些很模糊的感觉。我不知道这些感觉能不能被称为「记忆」…"
                                },
                                {
                                    "id": "741460104",
                                    "speaker": "安",
                                    "text": "虽然不知道人类的记忆到底是保存在头脑里还是心中…"
                                },
                                {
                                    "id": "741460105",
                                    "speaker": "安",
                                    "text": "但纯水精灵好像既没有头脑也没有心，只有水…"
                                },
                                {
                                    "id": "741460106",
                                    "speaker": "安",
                                    "text": "要是我也能像笨狗那样，只要坐在那里念叨什么「碎片数据整理」之类的就能想起一切，那该多好呀。"
                                }
                            ]
                        },
                        {
                            "id": "741460107",
                            "text": "还想了解一些关于安的事…",
                            "response": [
                                {
                                    "id": "741460108",
                                    "speaker": "安",
                                    "text": "我不知道还有什么可以告诉你的…"
                                },
                                {
                                    "id": "741460109",
                                    "speaker": "安",
                                    "text": "我是「玛丽安」幻化出来的部分，可是…可是她拒绝了我，也拒绝了其他人…我是说，其他存在…"
                                },
                                {
                                    "id": "741460110",
                                    "speaker": "安",
                                    "text": "我想要解救的莉利丝公主并不存在，「玛丽安」也不是玛丽安，不是笨狗的主人。"
                                },
                                {
                                    "id": "741460111",
                                    "speaker": "安",
                                    "text": "不知道为什么看到笨狗就觉得，内部好像涌起了什么…像气泡一样的感情！快要想起什么的时候，泡泡就碎开了…"
                                },
                                {
                                    "id": "741460112",
                                    "speaker": "安",
                                    "text": "卡特皮拉好像知道什么的样子，可是他不是有十足的把握就不愿多说。"
                                },
                                {
                                    "id": "741460113",
                                    "speaker": "安",
                                    "text": "明明来到了名字里有「水仙十字」的地方，却还是什么也没搞明白…"
                                }
                            ]
                        },
                        {
                            "id": "741460114",
                            "text": "还想了解一些关于莉利丝公主的事…",
                            "response": [
                                {
                                    "id": "741460115",
                                    "speaker": "安",
                                    "text": "莉利丝公主善良又勇敢，所以为了保护朋友，才让自己陷入困境。"
                                },
                                {
                                    "id": "741460116",
                                    "speaker": "安",
                                    "text": "之前我只想，我一定也是她的伙伴，她曾经保护过我，所以在她遇到困难的时候，我必须去解救她。"
                                },
                                {
                                    "id": "741460117",
                                    "speaker": "安",
                                    "text": "虽然她可能不希望我去救她…因为她太善良了，宁可自己受困也不要朋友遇到危险。"
                                },
                                {
                                    "id": "741460118",
                                    "speaker": "安",
                                    "text": "但是我如果不去救她，怎么配当她的朋友，受她的保护呢。"
                                },
                                {
                                    "id": "741460119",
                                    "speaker": "安",
                                    "text": "「记忆」…是模糊的，好像水里的涡流。感情…愿望，却那么真实。即使现在我已经知道她却只是故事里的角色…"
                                }
                            ]
                        },
                        {
                            "id": "741460120",
                            "text": "没什么，你先休息吧。",
                            "response": [
                                {
                                    "id": "741460121",
                                    "speaker": "安",
                                    "text": "#嗯。晚安，{NICKNAME}骑士。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741460201",
                    "speaker": "西摩尔",
                    "text": "#…演算进程中止。{NICKNAME}{M#先生}{F#小姐}，请问有何吩咐。",
                    "choices": [
                        {
                            "id": "741460202",
                            "text": "关于现在的情况…",
                            "response": [
                                {
                                    "id": "741460203",
                                    "speaker": "西摩尔",
                                    "text": "经过与纯水精灵·安，以及水仙十字结社残党·卡特皮拉的沟通，获得了部分有效信息。"
                                },
                                {
                                    "id": "741460204",
                                    "speaker": "西摩尔",
                                    "text": "我是原型机4ACV07，由吉约丹设计，用以陪伴并保护我的主人，玛丽安小姐。"
                                },
                                {
                                    "id": "741460205",
                                    "speaker": "西摩尔",
                                    "text": "很遗憾，目前没有获得更多有关玛丽安小姐的有效信息。"
                                },
                                {
                                    "id": "741460206",
                                    "speaker": "西摩尔",
                                    "text": "此外，纯水精灵·安能够提供的信息很少。"
                                },
                                {
                                    "id": "741460207",
                                    "speaker": "西摩尔",
                                    "text": "水仙十字结社残党·卡特皮拉没有提供全部信息。"
                                },
                                {
                                    "id": "741460208",
                                    "speaker": "西摩尔",
                                    "text": "需要更多时间进行分析…"
                                }
                            ]
                        },
                        {
                            "id": "741460209",
                            "text": "还想了解一些关于西摩尔的事…",
                            "response": [
                                {
                                    "id": "741460210",
                                    "speaker": "西摩尔",
                                    "text": "我是原型机4ACV07，由吉约丹设计，用以陪伴并保护我的主人，玛丽安小姐。"
                                },
                                {
                                    "id": "741460211",
                                    "speaker": "西摩尔",
                                    "text": "我搭载了枫丹自然哲学学院最先进的光学设备、记忆储存单元、逻辑单元，以及各种功能模块。"
                                },
                                {
                                    "id": "741460212",
                                    "speaker": "西摩尔",
                                    "text": "让我得以在记录玛丽安小姐日常生活之余，也作为探员助手发挥实力。"
                                },
                                {
                                    "id": "741460213",
                                    "speaker": "西摩尔",
                                    "text": "目前的首要目标是：找到玛丽安小姐，并确保她的安全。"
                                }
                            ]
                        },
                        {
                            "id": "741460214",
                            "text": "还想了解一些关于玛丽安的事…",
                            "response": [
                                {
                                    "id": "741460215",
                                    "speaker": "西摩尔",
                                    "text": "我被设计、制造的目的即是为了陪伴及保护我的主人，玛丽安小姐。"
                                },
                                {
                                    "id": "741460216",
                                    "speaker": "西摩尔",
                                    "text": "目前的首要目标是：找到玛丽安小姐，并确保她的安全。"
                                },
                                {
                                    "id": "741460217",
                                    "speaker": "西摩尔",
                                    "text": "纯水精灵·安的部分行为表现出了与玛丽安小姐过往行为相似的特征。"
                                },
                                {
                                    "id": "741460218",
                                    "speaker": "西摩尔",
                                    "text": "但构成她们的要素…（嘈杂的机械音），…（嘈杂的机械音）。"
                                },
                                {
                                    "id": "741460219",
                                    "speaker": "西摩尔",
                                    "text": "提示：定期进行记录空间整理，能够有效降低此类问题的发生频率。"
                                }
                            ]
                        },
                        {
                            "id": "741460220",
                            "text": "没什么，再见。",
                            "response": [
                                {
                                    "id": "741460221",
                                    "speaker": "西摩尔",
                                    "text": "#收到。祝您一切顺利，{NICKNAME}{M#先生}{F#小姐}。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741460301",
                    "speaker": "卡特皮拉",
                    "text": "怎么了，还有什么想聊聊的吗？",
                    "choices": [
                        {
                            "id": "741460302",
                            "text": "关于现在的情况…",
                            "response": [
                                {
                                    "id": "741460303",
                                    "speaker": "卡特皮拉",
                                    "text": "真好啊，时隔数百年，这里又热闹起来了。"
                                },
                                {
                                    "id": "741460304",
                                    "speaker": "卡特皮拉",
                                    "text": "…只是开个玩笑。我想这都是有意义的，我是说我们像这样聚在一起。如果只当作巧合，未免太过无趣，太过愚钝了。"
                                },
                                {
                                    "id": "741460305",
                                    "speaker": "卡特皮拉",
                                    "text": "我们的相遇一定是某种开端的征兆，就像被压抑的存在将要萌芽，将要迸发之前的异象。"
                                },
                                {
                                    "id": "741460306",
                                    "speaker": "卡特皮拉",
                                    "text": "但是话说回来，在真正的末日到来以前，又有谁会在荒谬中觅得意义，确信那些异象预示着一个庄重的时刻必将到来？"
                                },
                                {
                                    "id": "741460307",
                                    "speaker": "卡特皮拉",
                                    "text": "除了纳齐森科鲁兹…过去我也曾将他称作「主人」，不管怎么说，他的确能够被称为「大师」。"
                                },
                                {
                                    "id": "741460308",
                                    "speaker": "卡特皮拉",
                                    "text": "就像我们的道路在此处——在这末日时钟之下交汇，若我们循着交织的路继续前进，或许能够…"
                                },
                                {
                                    "id": "741460309",
                                    "speaker": "卡特皮拉",
                                    "text": "……"
                                },
                                {
                                    "id": "741460310",
                                    "speaker": "卡特皮拉",
                                    "text": "…剩下的话，还是留到旅途的终点再说吧。"
                                }
                            ]
                        },
                        {
                            "id": "741460311",
                            "text": "还想了解一些关于卡特皮拉的事…",
                            "response": [
                                {
                                    "id": "741460312",
                                    "speaker": "卡特皮拉",
                                    "text": "关于我自己还有什么可说的呢。"
                                },
                                {
                                    "id": "741460313",
                                    "speaker": "卡特皮拉",
                                    "text": "我时常感到在自己本质的根底存在着相斥的属性，它们分别都是纯粹的，但同时，对彼此来说也是异质的。"
                                },
                                {
                                    "id": "741460314",
                                    "speaker": "卡特皮拉",
                                    "text": "因此当它们交融时，各自都混入了杂质。你能理解吗？"
                                },
                                {
                                    "id": "741460315",
                                    "speaker": "卡特皮拉",
                                    "text": "我的自我是不牢固的…我有时是勇者，有时是恶龙，我的自我是用他者的叙述堆砌成的谎言…"
                                },
                                {
                                    "id": "741460316",
                                    "speaker": "卡特皮拉",
                                    "text": "但我相信答案是存在的，唯一正确的答案。时钟的指针再次走动，我已经做好准备踏出这一步了。"
                                }
                            ]
                        },
                        {
                            "id": "741460317",
                            "text": "还想了解一些关于莉诺尔的事…",
                            "response": [
                                {
                                    "id": "741460318",
                                    "speaker": "卡特皮拉",
                                    "text": "虽然只是很短的一段时间…我也没有想到自己会这样热衷在她面前扮演保护者的角色。"
                                },
                                {
                                    "id": "741460319",
                                    "speaker": "卡特皮拉",
                                    "text": "的确是很新奇的体验。也许是被她的纯粹所吸引了吧，因为那恰恰是我不可能具有的品质。"
                                },
                                {
                                    "id": "741460320",
                                    "speaker": "卡特皮拉",
                                    "text": "但保全她纯粹的却是梅洛彼得堡…一个她本不应在此的地方。"
                                },
                                {
                                    "id": "741460321",
                                    "speaker": "卡特皮拉",
                                    "text": "为了给她选择的机会，必得先从她手中夺走选择的权利。"
                                },
                                {
                                    "id": "741460322",
                                    "speaker": "卡特皮拉",
                                    "text": "一想到现在，尘世已经进入了她的心坎…"
                                },
                                {
                                    "id": "741460323",
                                    "speaker": "卡特皮拉",
                                    "text": "……"
                                }
                            ]
                        },
                        {
                            "id": "741460324",
                            "text": "之后再聊吧。",
                            "response": [
                                {
                                    "id": "741460325",
                                    "speaker": "卡特皮拉",
                                    "text": "我会暂时留在这里，直到启程的时刻到来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}