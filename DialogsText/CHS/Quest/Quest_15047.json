    "talks": [
        {
            "id": "1504701",
            "objective": "前往「暝导游船」",
            "dialogues": [
                {
                    "id": "150470101",
                    "speaker": "玛拉妮",
                    "text": "你们来了！这里的工作人员好像临时有事走开了，不过我已经弄明白要怎么玩…我是说，完成测试了！"
                },
                {
                    "id": "150470102",
                    "speaker": "派蒙",
                    "text": "好呀，那你教教我们。"
                },
                {
                    "id": "150470103",
                    "speaker": "玛拉妮",
                    "text": "简单来说，需要一方登上游船，另一方给龙员工发送信号。通过默契的双人合作，将游船安全送到目的地。"
                },
                {
                    "id": "150470104",
                    "speaker": "玛拉妮",
                    "text": "#要说考验默契，我对我和{NICKNAME}的配合可是很有信心的。"
                },
                {
                    "id": "150470105",
                    "speaker": "派蒙",
                    "text": "是吗？一般说完大话就离翻船不远了…"
                },
                {
                    "id": "150470106",
                    "speaker": "玛拉妮",
                    "text": "喂喂，派蒙，不吉利的话可不要乱说噢！"
                },
                {
                    "id": "150470107",
                    "speaker": "派蒙",
                    "text": "好吧，那…那祝你们一帆风顺。"
                },
                {
                    "id": "150470108",
                    "speaker": "玛拉妮",
                    "text": "哼哼，一定会的。"
                },
                {
                    "id": "150470109",
                    "speaker": "玛拉妮",
                    "text": "其实我挺想坐船的，平时高难度的冲浪挑战惯了，换个口味也很新鲜！",
                    "choices": [
                        {
                            "id": "150470110",
                            "text": "我也开腻浪船了。",
                            "response": [
                                {
                                    "id": "150470112",
                                    "speaker": "玛拉妮",
                                    "text": "哇！一拍即合？！这就是我们牵绊的证明吧！"
                                },
                                {
                                    "id": "150470113",
                                    "speaker": "玛拉妮",
                                    "text": "我已经等不及想要给豚豚泳装充足气，一个弹跳飞到游船上去了！"
                                }
                            ]
                        },
                        {
                            "id": "150470111",
                            "text": "我来发信号吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504703",
            "objective": "体验「暝导游船」",
            "dialogues": []
        },
        {
            "id": "1504704",
            "objective": "与玛拉妮会合",
            "dialogues": [
                {
                    "id": "150470401",
                    "speaker": "玛拉妮",
                    "text": "…噢，原来这里的设施还没有建造完成啊。"
                },
                {
                    "id": "150470402",
                    "speaker": "派蒙",
                    "text": "有只暝视龙员工在这里！是不是应该拜托它帮忙？"
                },
                {
                    "id": "150470403",
                    "speaker": "玛拉妮",
                    "text": "可以请你把它们建造出来吗？"
                },
                {
                    "id": "150470404",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470405",
                    "speaker": "玛拉妮",
                    "text": "把它…放到这里…造出来！"
                },
                {
                    "id": "150470406",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470407",
                    "speaker": "派蒙",
                    "text": "它好像看不懂你的比划。"
                },
                {
                    "id": "150470408",
                    "speaker": "玛拉妮",
                    "text": "是啊…怎么办呢…"
                },
                {
                    "id": "150470409",
                    "speaker": "玛拉妮",
                    "text": "慢着慢着慢着，我突然想到新办法了！"
                },
                {
                    "id": "150470410",
                    "speaker": "玛拉妮",
                    "text": "「咿——」"
                },
                {
                    "id": "150470411",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470412",
                    "speaker": "玛拉妮",
                    "text": "「咿——」「咿——」「咿——」"
                },
                {
                    "id": "150470413",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470414",
                    "speaker": "玛拉妮",
                    "text": "哈…不行…它根本听不懂鳍游龙的叫声啊！"
                },
                {
                    "id": "150470415",
                    "speaker": "Player",
                    "text": "要不然…"
                },
                {
                    "id": "150470416",
                    "speaker": "玛拉妮",
                    "text": "…我又想起来了！"
                },
                {
                    "id": "150470417",
                    "speaker": "派蒙",
                    "text": "又想起什么？"
                },
                {
                    "id": "150470418",
                    "speaker": "玛拉妮",
                    "text": "我听伊法说过，暝视龙最喜欢吃的就是微光角菌，正好我随身带着。"
                },
                {
                    "id": "150470419",
                    "speaker": "玛拉妮",
                    "text": "太好了太好了，这下有救了！给它吃完肯定就能互通心意了。"
                },
                {
                    "id": "150470420",
                    "speaker": "幼暝视龙",
                    "text": "！"
                },
                {
                    "id": "150470421",
                    "speaker": "玛拉妮",
                    "text": "出远门的物资就是要多准备些才行…卡齐娜提醒得一点没错。谢谢你呀，卡齐…"
                },
                {
                    "id": "150470422",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470423",
                    "speaker": "派蒙",
                    "text": "这…并没有互通心意的征兆…"
                },
                {
                    "id": "150470424",
                    "speaker": "玛拉妮",
                    "text": "完蛋了…征服浪浪湾所有项目的梦想在出航的第一日真的翻船了。"
                },
                {
                    "id": "150470425",
                    "speaker": "玛拉妮",
                    "text": "#{NICKNAME}，大英雄{NICKNAME}，你有什么办法吗？",
                    "choices": [
                        {
                            "id": "150470426",
                            "text": "办法的确有…",
                            "response": [
                                {
                                    "id": "150470428",
                                    "speaker": "玛拉妮",
                                    "text": "嗯，好吧…那就辛苦你了！"
                                }
                            ]
                        },
                        {
                            "id": "150470427",
                            "text": "帮你再喊一只暝视龙来。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504705",
            "objective": "与玛拉妮会合",
            "dialogues": [
                {
                    "id": "150470501",
                    "speaker": "Black Screen",
                    "text": "魂附暝视龙后返回…"
                },
                {
                    "id": "150470502",
                    "speaker": "派蒙",
                    "text": "玛拉妮，我们回来啦！"
                },
                {
                    "id": "150470503",
                    "speaker": "Player",
                    "text": "！"
                },
                {
                    "id": "150470504",
                    "speaker": "玛拉妮",
                    "text": "#噢！你好你好，你看起来好乖哦，{NICKNAME}没有跟你一起来吗？"
                },
                {
                    "id": "150470505",
                    "speaker": "派蒙",
                    "text": "#呃，{M#他}{F#她}，{M#他}{F#她}突然肚子疼上厕所去了。"
                },
                {
                    "id": "150470506",
                    "speaker": "Player",
                    "text": "（为什么是那么蹩脚的理由…算了，玛拉妮没有看出异样就好…）"
                },
                {
                    "id": "150470507",
                    "speaker": "Player",
                    "text": "！"
                },
                {
                    "id": "150470508",
                    "speaker": "玛拉妮",
                    "text": "哎呀哎呀你好热情，要吃微光角菌吗？先来一点尝尝？"
                },
                {
                    "id": "150470509",
                    "speaker": "Player",
                    "text": "（奇妙的味道。菌类肉质厚实而鲜嫩，意外称得上可口。）"
                },
                {
                    "id": "150470510",
                    "speaker": "Player",
                    "text": "！"
                },
                {
                    "id": "150470511",
                    "speaker": "玛拉妮",
                    "text": "哈哈，很高兴你能这么喜欢呀！这些全都给你啦。"
                },
                {
                    "id": "150470512",
                    "speaker": "玛拉妮",
                    "text": "我…我可以摸一下你吗？我们来交个朋友吧…"
                },
                {
                    "id": "150470513",
                    "speaker": "幼暝视龙",
                    "text": "……"
                },
                {
                    "id": "150470514",
                    "speaker": "玛拉妮",
                    "text": "那就麻烦你帮我一点忙喽！"
                }
            ]
        },
        {
            "id": "1504706",
            "objective": "利用暝视龙能力，完成搭建",
            "dialogues": [
                {
                    "id": "150470601",
                    "speaker": "幼暝视龙",
                    "text": "那女孩到底在说些什么？我不明白啊。朋友只让我帮忙看一下场子，没提到要做什么事呀。"
                },
                {
                    "id": "150470602",
                    "speaker": "幼暝视龙",
                    "text": "但菌菌好好吃噢…要是能再多来点就好了。"
                }
            ]
        },
        {
            "id": "1504707",
            "objective": "再次体验「暝导游船」",
            "dialogues": []
        },
        {
            "id": "1504708",
            "objective": "与玛拉妮会合",
            "dialogues": [
                {
                    "id": "150470801",
                    "speaker": "玛拉妮",
                    "text": "呼…这下就全部完成了。"
                },
                {
                    "id": "150470802",
                    "speaker": "玛拉妮",
                    "text": "谢谢你，这都是多亏了你的帮助。"
                },
                {
                    "id": "150470803",
                    "speaker": "玛拉妮",
                    "text": "可以再摸你一下吗？好龙龙，好龙龙，你最棒了！"
                },
                {
                    "id": "150470804",
                    "speaker": "Player",
                    "text": "！"
                },
                {
                    "id": "150470805",
                    "speaker": "派蒙",
                    "text": "那个…玛拉妮，差不多要把它送回去了。"
                },
                {
                    "id": "150470806",
                    "speaker": "玛拉妮",
                    "text": "#噢噢，好呀，那我就在这里等吧，免得{NICKNAME}回来的时候和我们走岔了。"
                },
                {
                    "id": "150470807",
                    "speaker": "玛拉妮",
                    "text": "真可爱啊，我之后是不是该找奶奶补习补习暝视龙语言了…"
                },
                {
                    "id": "150470808",
                    "speaker": "玛拉妮",
                    "text": "#{NICKNAME}，肚子还好吗？"
                },
                {
                    "id": "150470809",
                    "speaker": "Player",
                    "text": "我没事。"
                },
                {
                    "id": "150470810",
                    "speaker": "玛拉妮",
                    "text": "那就好。哎，刚才太可惜了，你没见到那只好乖好乖的暝视龙，它特别可爱！"
                },
                {
                    "id": "150470811",
                    "speaker": "玛拉妮",
                    "text": "我都想去「烟谜主」住上一阵子，多采点微光角菌来和暝视龙培养感情了。"
                }
            ]
        },
        {
            "id": "1504702",
            "objective": "与玛拉妮会合",
            "dialogues": []
        },
        {
            "id": "1504799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150479901",
                    "speaker": "玛拉妮",
                    "text": "那这边的测试就完成了，我来勾上标记…好了，下一处在对岸。"
                }
            ]
        }
    ]
}