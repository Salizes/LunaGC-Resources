    "talks": [
        {
            "id": "7512701",
            "objective": "(test)迷海结束后卫兵对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751270101",
                    "speaker": "萨卡乌",
                    "text": "哎呀，您也是来这里留影的吧。之前就有外国的旅客过来，想要在这里留影，毕竟海面上的浮岛是很好的景色呀…"
                },
                {
                    "id": "751270102",
                    "speaker": "萨卡乌",
                    "text": "可惜之前没有留影机，我可是特地托认识的外国商人弄来了一台嘞。"
                },
                {
                    "id": "751270103",
                    "speaker": "萨卡乌",
                    "text": "怎么样，客人，要不要试试拍张画片？不过得您自己动手，我拍照的技术可不怎么样呀…"
                },
                {
                    "id": "751270104",
                    "speaker": "Player",
                    "text": "奇怪，海面上的雾…"
                },
                {
                    "id": "751270105",
                    "speaker": "萨卡乌",
                    "text": "海面上的雾？客人你在说什么呀，这里海风可大咧，哪会有雾啊…"
                },
                {
                    "id": "751270106",
                    "speaker": "萨卡乌",
                    "text": "从我出生到现在，可还没看到过海上有雾嘞。"
                },
                {
                    "id": "751270107",
                    "speaker": "萨卡乌",
                    "text": "客人不会是把这里和镜璧山下那些全是雾的地方搞混了吧。"
                },
                {
                    "id": "751270108",
                    "speaker": "Player",
                    "text": "大概吧…"
                },
                {
                    "id": "751270109",
                    "speaker": "萨卡乌",
                    "text": "嘿嘿，要我说呀，客人你就是太紧张了。"
                },
                {
                    "id": "751270110",
                    "speaker": "萨卡乌",
                    "text": "来纳塔旅游，还是要放松一些才行呀。"
                }
            ]
        }
    ]
}