        }
    },
    "talks": [
        {
            "id": "2002901",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "200290101",
                    "speaker": "维克多",
                    "text": "呼…总算能回去了…"
                },
                {
                    "id": "200290102",
                    "speaker": "Player",
                    "text": "你要回国了吗？"
                },
                {
                    "id": "200290103",
                    "speaker": "维克多",
                    "text": "啊？是你啊…"
                },
                {
                    "id": "200290104",
                    "speaker": "维克多",
                    "text": "没错，我最近才刚接到上头的命令，让我回至冬去。"
                },
                {
                    "id": "200290105",
                    "speaker": "维克多",
                    "text": "说是什么…我被调去另外一个执行官大人手下，暂时不用在蒙德这边待命了。"
                },
                {
                    "id": "200290106",
                    "speaker": "维克多",
                    "text": "也不知道我到底被调去哪位执行官大人手下了，可千万别是「散兵」啊…"
                },
                {
                    "id": "200290107",
                    "speaker": "Player",
                    "text": "你大概什么时候离开？"
                },
                {
                    "id": "200290108",
                    "speaker": "维克多",
                    "text": "上头没说，只要我先把东西收拾好，到时候尽快出发。"
                },
                {
                    "id": "200290109",
                    "speaker": "维克多",
                    "text": "哎呀，总算是能离开这破地方，不用天天吃修女的白眼了。"
                },
                {
                    "id": "200290110",
                    "speaker": "维克多",
                    "text": "哦对了，旅行者，你看我们俩也合作了这么长时间了，你最后再帮我个忙呗。"
                },
                {
                    "id": "200290111",
                    "speaker": "维克多",
                    "text": "和之前一样，你帮我忙，我付你报酬，绝对不让你白跑，怎么样？",
                    "choices": [
                        {
                            "id": "200290112",
                            "text": "你又要讲什么故事？",
                            "response": [
                                {
                                    "id": "200290114",
                                    "speaker": "维克多",
                                    "text": "哈哈哈，我这里能告诉你的「愚人众故事」已经全部讲完啦。"
                                },
                                {
                                    "id": "200290115",
                                    "speaker": "维克多",
                                    "text": "这次你帮我忙，我绝对付你真金白银的报酬，怎么样？"
                                },
                                {
                                    "id": "200290116",
                                    "speaker": "维克多",
                                    "text": "除非，你想听我给莉莉讲的那些童话故事…",
                                    "choices": [
                                        {
                                            "id": "200290117",
                                            "text": "你要我帮什么忙？",
                                            "response": [
                                                {
                                                    "id": "200290120",
                                                    "speaker": "维克多",
                                                    "text": "嗯…其实我这次想请你帮的忙，也和莉莉有关。"
                                                },
                                                {
                                                    "id": "200290121",
                                                    "speaker": "维克多",
                                                    "text": "除了你之外，整个蒙德城里愿意听我这个「愚人众坏叔叔」说话的，估计也就只有莉莉这孩子了。"
                                                },
                                                {
                                                    "id": "200290122",
                                                    "speaker": "维克多",
                                                    "text": "我要是走了，估计以后也不可能有机会再回蒙德城了…我就想最后送点礼物给莉莉做留念。"
                                                },
                                                {
                                                    "id": "200290123",
                                                    "speaker": "维克多",
                                                    "text": "但你也知道，我要是自己上街买东西，指不定要吃多少白眼。"
                                                },
                                                {
                                                    "id": "200290124",
                                                    "speaker": "维克多",
                                                    "text": "所以，这件事就拜托你了，旅行者。"
                                                },
                                                {
                                                    "id": "200290125",
                                                    "speaker": "维克多",
                                                    "text": "你就去玛乔丽那边，帮我看看有什么适合送给小孩子的礼物吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200290118",
                                            "text": "你还在陪莉莉玩？",
                                            "response": [
                                                {
                                                    "id": "200290119",
                                                    "speaker": "维克多",
                                                    "text": "我就是偶尔…偶尔陪她玩玩…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200290113",
                            "text": "你这里，愚人众的故事真是特别多…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002902",
            "objective": "向玛乔丽询问有关礼物的事",
            "dialogues": [
                {
                    "id": "200290201",
                    "speaker": "玛乔丽",
                    "text": "你好，有什么事吗？旅行者。"
                },
                {
                    "id": "200290202",
                    "speaker": "Player",
                    "text": "关于适合送给小朋友的礼物…"
                },
                {
                    "id": "200290203",
                    "speaker": "玛乔丽",
                    "text": "送给小朋友的礼物…我想想…"
                },
                {
                    "id": "200290204",
                    "speaker": "玛乔丽",
                    "text": "嗯…这么一说，我最近确实在试着做一些小玩具。"
                },
                {
                    "id": "200290205",
                    "speaker": "玛乔丽",
                    "text": "但做这些玩具的时候，需要用很多钩钩果来染色，但我手里的钩钩果都用完了。"
                },
                {
                    "id": "200290206",
                    "speaker": "玛乔丽",
                    "text": "虽然我已经拜托了舒特去野外采一些钩钩果，但他到现在也没有回来。"
                },
                {
                    "id": "200290207",
                    "speaker": "玛乔丽",
                    "text": "旅行者，你能帮我去野外找找舒特吗？"
                },
                {
                    "id": "200290208",
                    "speaker": "玛乔丽",
                    "text": "有了足够的钩钩果之后，我应该就可以把那些玩具做出来了。",
                    "choices": [
                        {
                            "id": "200290209",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "200290211",
                                    "speaker": "玛乔丽",
                                    "text": "舒特说，他要去<color=#00E1FFFF>奔狼领附近</color>采钩钩果，你可以去那边找找他。"
                                },
                                {
                                    "id": "200290212",
                                    "speaker": "玛乔丽",
                                    "text": "那就拜托你了，旅行者。"
                                }
                            ]
                        },
                        {
                            "id": "200290210",
                            "text": "舒特去哪里了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002903",
            "objective": "寻找害怕的舒特",
            "dialogues": []
        },
        {
            "id": "2002904",
            "objective": "解救害怕的舒特",
            "dialogues": [
                {
                    "id": "200290401",
                    "speaker": "维克多",
                    "text": "你拿到礼物了吗？",
                    "choices": [
                        {
                            "id": "200290402",
                            "text": "你回去之后会做什么？",
                            "response": [
                                {
                                    "id": "200290403",
                                    "speaker": "维克多",
                                    "text": "做什么？那…肯定是听上头的调遣呗。"
                                },
                                {
                                    "id": "200290404",
                                    "speaker": "维克多",
                                    "text": "唉，如果运气不好，说不定又要被丢到什么鬼地方呆着。"
                                },
                                {
                                    "id": "200290405",
                                    "speaker": "维克多",
                                    "text": "无论如何，别把我丢去稻妻就行…"
                                }
                            ]
                        },
                        {
                            "id": "200290406",
                            "text": "你为什么突然被调走了？",
                            "response": [
                                {
                                    "id": "200290407",
                                    "speaker": "维克多",
                                    "text": "还能是因为什么，当然是因为「女士」大人…那个…牺牲了呗。"
                                },
                                {
                                    "id": "200290408",
                                    "speaker": "维克多",
                                    "text": "哎呀，我这种级别的人，听上头的命令行事就行了，想那么多干啥。"
                                }
                            ]
                        },
                        {
                            "id": "200290409",
                            "text": "莉莉去哪了？",
                            "response": [
                                {
                                    "id": "200290410",
                                    "speaker": "维克多",
                                    "text": "我听鲁道夫和她说，要带她去广场上玩，还是什么的…"
                                },
                                {
                                    "id": "200290411",
                                    "speaker": "维克多",
                                    "text": "哼，估计是不想让莉莉和我这个「愚人众坏叔叔」说话吧。"
                                }
                            ]
                        },
                        {
                            "id": "200290412",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "200290413",
                                    "speaker": "维克多",
                                    "text": "嗯，礼物的事就拜托你了啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002905",
            "objective": "与舒特对话",
            "dialogues": [
                {
                    "id": "200290501",
                    "speaker": "害怕的舒特",
                    "text": "谢、谢谢你，旅行者。"
                },
                {
                    "id": "200290502",
                    "speaker": "害怕的舒特",
                    "text": "这群魔物怎么追得这么紧，我都跑到这里了它们还不放过我…"
                },
                {
                    "id": "200290503",
                    "speaker": "Player",
                    "text": "你是来采钩钩果的吗？"
                },
                {
                    "id": "200290504",
                    "speaker": "害怕的舒特",
                    "text": "欸？是的，这是玛乔丽小姐的委托…",
                    "choices": [
                        {
                            "id": "200290505",
                            "text": "就不能找个人陪同吗…",
                            "response": [
                                {
                                    "id": "200290506",
                                    "speaker": "害怕的舒特",
                                    "text": "「采集植物」这种级别的委托，怎么可能会有人愿意和我一起来执行委托啦…"
                                },
                                {
                                    "id": "200290508",
                                    "speaker": "害怕的舒特",
                                    "text": "虽然道理我都懂啦。但钩钩果只有奔狼领里有。"
                                },
                                {
                                    "id": "200290509",
                                    "speaker": "害怕的舒特",
                                    "text": "而且那些长在安全区域的钩钩果，也早就被人采集完了。"
                                },
                                {
                                    "id": "200290510",
                                    "speaker": "害怕的舒特",
                                    "text": "我还想要采钩钩果的话，就只能往深处走了…"
                                },
                                {
                                    "id": "200290511",
                                    "speaker": "害怕的舒特",
                                    "text": "先不说这些了，你能帮我把这些钩钩果带给玛乔丽小姐吗？"
                                },
                                {
                                    "id": "200290512",
                                    "speaker": "害怕的舒特",
                                    "text": "我得先去休息一会，刚才我跑得累死了…"
                                }
                            ]
                        },
                        {
                            "id": "200290507",
                            "text": "一个人就别跑这么远了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002906",
            "objective": "将钩钩果带给玛乔丽",
            "dialogues": [
                {
                    "id": "200290601",
                    "speaker": "玛乔丽",
                    "text": "旅行者，你找到舒特了吗？"
                },
                {
                    "id": "200290602",
                    "speaker": "Player",
                    "text": "他让我把钩钩果带给你。"
                },
                {
                    "id": "200290603",
                    "speaker": "玛乔丽",
                    "text": "喔…谢谢你，这些钩钩果我就收下啦。"
                },
                {
                    "id": "200290604",
                    "speaker": "玛乔丽",
                    "text": "等舒特回来了，我会把报酬付给他。"
                },
                {
                    "id": "200290605",
                    "speaker": "玛乔丽",
                    "text": "对了，你是想要一个适合送给小孩子的礼物对吧？请稍等一下…"
                },
                {
                    "id": "200290606",
                    "speaker": "Black Screen",
                    "text": "玛乔丽开始制作礼物…"
                },
                {
                    "id": "200290607",
                    "speaker": "玛乔丽",
                    "text": "好了！这份礼物请你收下吧。谢谢你把钩钩果带给我。"
                },
                {
                    "id": "200290608",
                    "speaker": "玛乔丽",
                    "text": "这种带着香气的娃娃，小朋友肯定会喜欢的。"
                }
            ]
        },
        {
            "id": "2002907",
            "objective": "将礼物带给维克多",
            "dialogues": [
                {
                    "id": "200290701",
                    "speaker": "维克多",
                    "text": "怎么样，你拿到礼物了吗？"
                },
                {
                    "id": "200290702",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "200290703",
                    "speaker": "维克多",
                    "text": "喔，你还挺能干的嘛。我看看啊…"
                },
                {
                    "id": "200290704",
                    "speaker": "维克多",
                    "text": "这是…什么…"
                },
                {
                    "id": "200290705",
                    "speaker": "维克多",
                    "text": "这歪歪扭扭的娃娃，还染着这种莫名其妙的颜色…不过这气味倒是不错。"
                },
                {
                    "id": "200290706",
                    "speaker": "维克多",
                    "text": "我说，这玩意真能送给小孩子吗？",
                    "choices": [
                        {
                            "id": "200290707",
                            "text": "这是玛乔丽小姐的推荐。",
                            "response": [
                                {
                                    "id": "200290710",
                                    "speaker": "维克多",
                                    "text": "行吧，这礼物也凑合。不过这封信放哪呢…喔，放在底下好了…",
                                    "choices": [
                                        {
                                            "id": "200290711",
                                            "text": "你还给莉莉写信了吗？",
                                            "response": [
                                                {
                                                    "id": "200290713",
                                                    "speaker": "维克多",
                                                    "text": "没什么，都是一些废话，你就别管了。"
                                                },
                                                {
                                                    "id": "200290714",
                                                    "speaker": "维克多",
                                                    "text": "行了，这礼物给你，帮我转交给莉莉吧，她应该就在<color=#00E1FFFF>广场附近</color>。"
                                                },
                                                {
                                                    "id": "200290715",
                                                    "speaker": "维克多",
                                                    "text": "哼，要是我直接去把礼物送给莉莉，鲁道夫估计又要瞪我了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200290712",
                                            "text": "信里写什么了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200290708",
                            "text": "那你从至冬买礼物寄回来。",
                            "response": [
                                {
                                    "id": "200290709",
                                    "speaker": "维克多",
                                    "text": "我倒是想啊。但是我这个愚人众要是寄东西到蒙德城，估计骑士团的那帮人会直接把包裹给拦下来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002908",
            "objective": "将礼物转交给莉莉",
            "dialogues": [
                {
                    "id": "200290801",
                    "speaker": "鲁道夫",
                    "text": "莉莉，不要和那个愚人众叔叔说话喔。"
                },
                {
                    "id": "200290802",
                    "speaker": "莉莉",
                    "text": "为森么呀？驴人众蜀黍，和我讲了粉多故事呢。"
                },
                {
                    "id": "200290803",
                    "speaker": "Player",
                    "text": "莉莉，这是维克多给你的礼物。"
                },
                {
                    "id": "200290804",
                    "speaker": "莉莉",
                    "text": "哇！那个驴人众蜀黍，给我的礼物？谢谢！"
                },
                {
                    "id": "200290805",
                    "speaker": "鲁道夫",
                    "text": "等会，为什么愚人众要给莉莉送礼物，他不会是想干什么…"
                },
                {
                    "id": "200290806",
                    "speaker": "莉莉",
                    "text": "因为窝，窝请那个蜀黍，吃了好次的！蜀黍才送礼物给窝！"
                },
                {
                    "id": "200290807",
                    "speaker": "鲁道夫",
                    "text": "莉莉，愚人众叔叔可不是什么好人…"
                },
                {
                    "id": "200290808",
                    "speaker": "莉莉",
                    "text": "可是，那个蜀黍会给窝讲故事，是好嫩！",
                    "choices": [
                        {
                            "id": "200290809",
                            "text": "这是维克多的临别礼物。",
                            "response": [
                                {
                                    "id": "200290811",
                                    "speaker": "莉莉",
                                    "text": "欸…驴人众蜀黍为森么要走哇…"
                                },
                                {
                                    "id": "200290812",
                                    "speaker": "鲁道夫",
                                    "text": "呼…好吧。走了也好，那家伙天天和莉莉说话，搞得我每天都在担心。"
                                },
                                {
                                    "id": "200290813",
                                    "speaker": "莉莉",
                                    "text": "把拔，我要去和那个蜀黍说再见！"
                                },
                                {
                                    "id": "200290814",
                                    "speaker": "鲁道夫",
                                    "text": "唉…莉莉，你不要和那个叔叔走太近…"
                                },
                                {
                                    "id": "200290815",
                                    "speaker": "莉莉",
                                    "text": "为森么呀！那个蜀黍…那个蜀黍对窝很好的！"
                                },
                                {
                                    "id": "200290816",
                                    "speaker": "莉莉",
                                    "text": "他给窝讲故事，还给窝好次的！真的是好嫩！"
                                },
                                {
                                    "id": "200290817",
                                    "speaker": "鲁道夫",
                                    "text": "莉莉，听爸爸的话…这件事不是这么简单的…唉，爸爸以后再和你慢慢讲这件事…"
                                }
                            ]
                        },
                        {
                            "id": "200290810",
                            "text": "维克多马上就要离开蒙德城了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002909",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "200290901",
                    "speaker": "维克多",
                    "text": "你把礼物转交给莉莉了吗？"
                },
                {
                    "id": "200290902",
                    "speaker": "Player",
                    "text": "莉莉很高兴。"
                },
                {
                    "id": "200290903",
                    "speaker": "维克多",
                    "text": "高兴就行。鲁道夫那家伙肯定又在旁边说三道四了吧？"
                },
                {
                    "id": "200290904",
                    "speaker": "维克多",
                    "text": "哼，你不说我也知道。这蒙德城里谁能信任我这个愚人众。"
                },
                {
                    "id": "200290905",
                    "speaker": "Player",
                    "text": "你什么时候出发？"
                },
                {
                    "id": "200290906",
                    "speaker": "维克多",
                    "text": "正式的命令还没下来，我只是提前收拾好了东西，过段时间会先去歌德大酒店里呆着，随时准备离开。"
                },
                {
                    "id": "200290907",
                    "speaker": "维克多",
                    "text": "你这一脸严肃的表情，不会是想向我正式道别吧？"
                },
                {
                    "id": "200290908",
                    "speaker": "Player",
                    "text": "不会。"
                },
                {
                    "id": "200290909",
                    "speaker": "维克多",
                    "text": "哼，这就对了，我们俩可不是什么朋友，只不过是临时的合作伙伴罢了。"
                },
                {
                    "id": "200290910",
                    "speaker": "维克多",
                    "text": "你以后去了至冬，可以过来找我，我们俩可以继续合作。"
                },
                {
                    "id": "200290911",
                    "speaker": "维克多",
                    "text": "好了，不多说废话了，这些报酬给你，收下吧。这是我们在蒙德城里的最后一次「等量交换」了。"
                },
                {
                    "id": "200290912",
                    "speaker": "维克多",
                    "text": "唉，希望回去之后，别再给我派麻烦活了…"
                }
            ]
        },
        {
            "id": "2002910",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200291001",
                    "speaker": "鲁道夫",
                    "text": "莉莉，不要和那个愚人众叔叔说话喔。"
                },
                {
                    "id": "200291002",
                    "speaker": "莉莉",
                    "text": "为森么呀？驴人众蜀黍，和我讲了粉多故事呢。"
                }
            ]
        },
        {
            "id": "2002912",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200291201",
                    "speaker": "玛乔丽",
                    "text": "那就拜托你了，旅行者。"
                },
                {
                    "id": "200291202",
                    "speaker": "玛乔丽",
                    "text": "舒特说，他要去<color=#00E1FFFF>奔狼领附近</color>采钩钩果，你可以去那边找找他。"
                }
            ]
        },
        {
            "id": "2002914",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200291401",
                    "speaker": "害怕的舒特",
                    "text": "请你帮我把这些钩钩果带给玛乔丽小姐吧，我得先去休息一会，刚才我跑得累死了…"
                }
            ]
        },
        {
            "id": "2002917",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200291701",
                    "speaker": "维克多",
                    "text": "你帮我把这礼物转交给莉莉吧，她应该就在<color=#00E1FFFF>广场附近</color>。"
                },
                {
                    "id": "200291702",
                    "speaker": "维克多",
                    "text": "要是我直接去把礼物送给莉莉，鲁道夫估计又要瞪我了…"
                }
            ]
        },
        {
            "id": "2002919",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200291901",
                    "speaker": "莉莉",
                    "text": "把拔，那个蜀黍会给窝讲故事，真的是好嫩！"
                },
                {
                    "id": "200291902",
                    "speaker": "鲁道夫",
                    "text": "莉莉，这件事不是这么简单的…唉，爸爸以后再和你慢慢讲这件事…"
                }
            ]
        },
        {
            "id": "2002927",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200292701",
                    "speaker": "维克多",
                    "text": "唉，希望回去之后，别再给我派麻烦活了…"
                }
            ]
        },
        {
            "id": "2002928",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200292801",
                    "speaker": "维克多",
                    "text": "呼…总算能回去了…"
                },
                {
                    "id": "200292802",
                    "speaker": "Player",
                    "text": "你要回国了吗？"
                },
                {
                    "id": "200292803",
                    "speaker": "维克多",
                    "text": "啊？是你啊…"
                },
                {
                    "id": "200292804",
                    "speaker": "维克多",
                    "text": "没错，我最近才刚接到上头的命令，让我回至冬去。"
                },
                {
                    "id": "200292805",
                    "speaker": "维克多",
                    "text": "说是什么…我被调去另外一个执行官大人手下，暂时不用在蒙德这边待命了。"
                },
                {
                    "id": "200292806",
                    "speaker": "维克多",
                    "text": "也不知道我到底被调去哪位执行官大人手下了…"
                }
            ]
        }
    ]
}