        {
            "id": "7452504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745250401",
                    "speaker": "赛诺",
                    "text": "……",
                    "choices": [
                        {
                            "id": "745250402",
                            "text": "你看起来表情有些严肃。",
                            "response": [
                                {
                                    "id": "745250404",
                                    "speaker": "赛诺",
                                    "text": "是你啊。不，今天的调查任务已经结束了，附近暂时没有发现异常。"
                                },
                                {
                                    "id": "745250405",
                                    "speaker": "赛诺",
                                    "text": "我只是在想，刚才那群路过的镀金旅团，为什么看起来无精打采的。",
                                    "choices": [
                                        {
                                            "id": "745250406",
                                            "text": "难道是因为旅途太累了？",
                                            "response": [
                                                {
                                                    "id": "745250408",
                                                    "speaker": "赛诺",
                                                    "text": "我猜测，可能是经济原因。毕竟，一支「镀金」旅团，如果没有了「金」，那不就「没劲」了吗？",
                                                    "choices": [
                                                        {
                                                            "id": "745250409",
                                                            "text": "…那来点「有劲」的事情如何？",
                                                            "response": [
                                                                {
                                                                    "id": "745250411",
                                                                    "speaker": "赛诺",
                                                                    "text": "我明白了。不过，如果只是站着不动，画面可能会有些单调，缺乏冲击力。"
                                                                },
                                                                {
                                                                    "id": "745250412",
                                                                    "speaker": "赛诺",
                                                                    "text": "放心，我会调动雷元素力，让你的画面真正做到令人「眼前一亮」。"
                                                                },
                                                                {
                                                                    "id": "745250413",
                                                                    "speaker": "Player",
                                                                    "text": "…想法不错，我会抓拍好的。"
                                                                },
                                                                {
                                                                    "id": "745250414",
                                                                    "speaker": "赛诺",
                                                                    "text": "嗯。交给你了。别错过了「决定性瞬间」。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745250410",
                                                            "text": "让我为你拍张画片吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745250407",
                                            "text": "难道是因为任务失败了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745250403",
                            "text": "难道是在追捕犯人？"
                        }
                    ]
                }
            ]
        }
