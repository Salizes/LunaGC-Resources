            "dialogues": [
                {
                    "id": "700480101",
                    "speaker": "菲米尼",
                    "text": "#是{NICKNAME}，抱歉，我才发现你也在这里。"
                },
                {
                    "id": "700480102",
                    "speaker": "菲米尼",
                    "text": "这个度假村很大，不认识的人很多，幸好遇到你了。"
                },
                {
                    "id": "700480103",
                    "speaker": "Player",
                    "text": "菲米尼在做什么？"
                },
                {
                    "id": "700480104",
                    "speaker": "菲米尼",
                    "text": "我在看纳塔的海，这里有些我不认识的水生动物，比方说我们旁边的那两只。",
                    "choices": [
                        {
                            "id": "700480105",
                            "text": "那是鳍游龙。",
                            "response": [
                                {
                                    "id": "700480109",
                                    "speaker": "菲米尼",
                                    "text": "纳塔的生态和枫丹区别真大，感觉很特别，要是「家」里的所有人都能看到就好了。"
                                },
                                {
                                    "id": "700480110",
                                    "speaker": "Player",
                                    "text": "我们来给度假村留影吧。"
                                },
                                {
                                    "id": "700480111",
                                    "speaker": "菲米尼",
                                    "text": "好啊，这样就能把看到的景色记录下来，不怕忘记了。"
                                },
                                {
                                    "id": "700480112",
                                    "speaker": "Player",
                                    "text": "顺便给菲米尼也拍一张。"
                                },
                                {
                                    "id": "700480113",
                                    "speaker": "菲米尼",
                                    "text": "给我吗？我也要拍啊…"
                                },
                                {
                                    "id": "700480114",
                                    "speaker": "菲米尼",
                                    "text": "不好意思，我不是想要拒绝你的意思，只是不太习惯站在镜头前。"
                                },
                                {
                                    "id": "700480115",
                                    "speaker": "菲米尼",
                                    "text": "「父亲」说过，总是把自己藏起来的话，可能会让关心自己的人担忧。"
                                },
                                {
                                    "id": "700480116",
                                    "speaker": "菲米尼",
                                    "text": "我会努力克服这个坏习惯的。既然你说想给我留影，那我们就试试。"
                                },
                                {
                                    "id": "700480117",
                                    "speaker": "菲米尼",
                                    "text": "我想想，你对入镜的姿势有想法吗？",
