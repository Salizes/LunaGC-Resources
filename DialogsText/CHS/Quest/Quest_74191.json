    "talks": [
        {
            "id": "7419104",
            "objective": "(test）接取闪回$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419101",
            "objective": "(test)传送金色大厅$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419102",
            "objective": "(test)波爱修斯和雷穆斯的争吵$HIDDEN",
            "dialogues": [
                {
                    "id": "741910201",
                    "speaker": "「████」",
                    "text": "王上，王上，您还好吗？该不会是又做梦了吧。"
                },
                {
                    "id": "741910202",
                    "speaker": "Player",
                    "text": "好吵啊，发生什么事了…"
                },
                {
                    "id": "741910203",
                    "speaker": "「████」",
                    "text": "公民们都聚集在大厅那边，似乎有事情要向您询问。"
                },
                {
                    "id": "741910204",
                    "speaker": "「████」",
                    "text": "因为最近「福波斯」的旋律多次中断，大家对此都有不少疑问。"
                },
                {
                    "id": "741910205",
                    "speaker": "Player",
                    "text": "我不得不这样做…"
                },
                {
                    "id": "741910206",
                    "speaker": "「████」",
                    "text": "我当然相信您的睿断，近来发生的事情我也有所耳闻…是「福波斯」出了什么问题吗？"
                },
                {
                    "id": "741910207",
                    "speaker": "「████」",
                    "text": "为了通往人类的整体幸福，「福波斯」为每个人都规划了道路。依靠「西比尔」近乎无限的计算力，应该不会有问题才对…"
                },
                {
                    "id": "741910208",
                    "speaker": "Player",
                    "text": "但我从乐声中听到了悲鸣。"
                },
                {
                    "id": "741910209",
                    "speaker": "「████」",
                    "text": "难道是有人偷偷修改了「福波斯」的曲谱？不，除了您和我等调律师外应该没人能做到…"
                },
                {
                    "id": "741910210",
                    "speaker": "「████」",
                    "text": "该不会是那位先知对我们有所隐瞒？不可能，她已经为此献上了自己的生命，她的预言也被水的主人所验证，绝不会有什么私心…"
                },
                {
                    "id": "741910211",
                    "speaker": "Player",
                    "text": "或许正因为「她」没有私心…"
                },
                {
                    "id": "741910212",
                    "speaker": "「████」",
                    "text": "如今所有人都依赖于「福波斯」为他们做出的判断与决定，如果「福波斯」出了什么问题的话，公民们恐怕都会陷入混乱…",
                    "choices": [
                        {
                            "id": "741910213",
                            "text": "我需要你前往那些盲信之人的所在…",
                            "response": [
                                {
                                    "id": "741910215",
                                    "speaker": "「████」",
                                    "text": "您的意思是说，要将我的旋律从大乐章中分离出来以防不测？"
                                },
                                {
                                    "id": "741910216",
                                    "speaker": "「████」",
                                    "text": "不不，这还为时尚早，我担心我的灵魂还不能承受伟大的命运…",
                                    "choices": [
                                        {
                                            "id": "741910217",
                                            "text": "我相信你。",
                                            "response": [
                                                {
                                                    "id": "741910219",
                                                    "speaker": "「████」",
                                                    "text": "…我明白了，我已有所觉悟。既然这是您的愿望，我当然愿意为您实现。",
                                                    "choices": [
                                                        {
                                                            "id": "741910220",
                                                            "text": "「乌兰诺珀里斯」，未来之城…",
                                                            "response": [
                                                                {
                                                                    "id": "741910222",
                                                                    "speaker": "「████」",
                                                                    "text": "「████」离去后，你穿过金色的回廊，人们争论的声音也越来越近。\\n直到你登上大殿中心的讲台，周围才稍微安静了下来。"
                                                                },
                                                                {
                                                                    "id": "741910223",
                                                                    "speaker": "「████」",
                                                                    "text": "伟大的至尊，请您谕示…"
                                                                },
                                                                {
                                                                    "id": "741910224",
                                                                    "speaker": "「████」",
                                                                    "text": "近来，因为无法聆听到「福波斯」的旋律，公民们都为此而感到恐惧与彷徨。"
                                                                },
                                                                {
                                                                    "id": "741910225",
                                                                    "speaker": "「████」",
                                                                    "text": "明明伟大的规划正在一如往常地推进。隐藏在阴影中的蛮族被我们一个一个地消灭，污秽的水域也被我们用灵露洗净。"
                                                                },
                                                                {
                                                                    "id": "741910226",
                                                                    "speaker": "「████」",
                                                                    "text": "然而您却打算无故停止高贵的战争，这到底是为什么？"
                                                                },
                                                                {
                                                                    "id": "741910227",
                                                                    "speaker": "Player",
                                                                    "text": "我当然有我的判断。"
                                                                },
                                                                {
                                                                    "id": "741910228",
                                                                    "speaker": "「████」",
                                                                    "text": "伟大的至尊，我无意挑战您的权威，但我认为对那些蛮族您已经足够仁慈了。"
                                                                },
                                                                {
                                                                    "id": "741910229",
                                                                    "speaker": "「████」",
                                                                    "text": "我们带来了伟大的秩序，雷穆利亚的大门向所有愿意融入黄金秩序的人敞开。"
                                                                },
                                                                {
                                                                    "id": "741910230",
                                                                    "speaker": "「████」",
                                                                    "text": "然而那些蛮族又是怎么做的呢？他们摧毁我们的高塔，屠害我们的乐师。以他们灵魂的品性，本不应得到任何拯救。"
                                                                },
                                                                {
                                                                    "id": "741910231",
                                                                    "speaker": "「████」",
                                                                    "text": "我们用鲜血洗净蛮荒的土地，而秩序与文明将在毁灭之后生长出来。这对那些蒙昧的族类而言，可说是无上的恩赐了。"
                                                                },
                                                                {
                                                                    "id": "741910232",
                                                                    "speaker": "Player",
                                                                    "text": "这不是我想要的…"
                                                                },
                                                                {
                                                                    "id": "741910233",
                                                                    "speaker": "「████」",
                                                                    "text": "在太阳的照射下，本就不应有一丝的阴影，这不也正是您的伟大理想吗？"
                                                                },
                                                                {
                                                                    "id": "741910234",
                                                                    "speaker": "「████」",
                                                                    "text": "我想这也是雷穆利亚所有公民们的愿望。"
                                                                },
                                                                {
                                                                    "id": "741910235",
                                                                    "speaker": "「████」",
                                                                    "text": "至尊，请下命令吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741910221",
                                                            "text": "就以这新的名字自称吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741910218",
                                            "text": "但从此你将不再是「我们」…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741910214",
                            "text": "为此，我要给与你自由的意志。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419103",
            "objective": "（test）传送$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741910298",
                    "speaker": "<UNKNOWN>",
                    "text": "「污秽啊污秽，卡皮托利姆的每一个人都是污秽的！若是不用血洗净这片土地，怎能开出无罪的花…」"
                },
                {
                    "id": "741910299",
                    "speaker": "<UNKNOWN>",
                    "text": "「众神啊，快关上天城的铜门！雷穆斯的宝剑已斩断命运的绳结，在征服陆地和海洋之后，只剩下上天的道路…」"
                }
            ]
        }
    ]
}