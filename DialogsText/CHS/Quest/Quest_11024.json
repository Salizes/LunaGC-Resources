    "talks": [
        {
            "id": "1102401",
            "objective": "抵达孤云阁，与钟离交谈",
            "dialogues": [
                {
                    "id": "110240101",
                    "speaker": "钟离",
                    "text": "之前对你提过，孤云阁之下，镇压了很多旧日的魔神。"
                },
                {
                    "id": "110240102",
                    "speaker": "钟离",
                    "text": "如今仙众已将璃月交给凡人，而赫乌莉亚的时代，是更久远的过去。她留下的「盐盏」与「盐尺」，不应该回到璃月港。"
                },
                {
                    "id": "110240103",
                    "speaker": "钟离",
                    "text": "让它们留在这里，既是沉眠，也是返乡…"
                },
                {
                    "id": "110240104",
                    "speaker": "Player",
                    "text": "所以钟离要我做什么呢？"
                },
                {
                    "id": "110240105",
                    "speaker": "钟离",
                    "text": "我亲手终结了一个时代。我一直在想，如何记录那些…被我终结的历史。"
                },
                {
                    "id": "110240106",
                    "speaker": "钟离",
                    "text": "历史可以记录，但历史并不可靠，这次的事也证明了这点。时间拥有强大的力量，历史会在岁月中扭曲…"
                },
                {
                    "id": "110240107",
                    "speaker": "钟离",
                    "text": "我需要找到更好的「记录」，才能铭刻真实的历史。"
                },
                {
                    "id": "110240108",
                    "speaker": "钟离",
                    "text": "刻石曾是一种久远的「记录」。但看似不变的磐石、看似不变的世界与我…或许也都会在某一天消失。"
                },
                {
                    "id": "110240109",
                    "speaker": "派蒙",
                    "text": "钟离…"
                },
                {
                    "id": "110240110",
                    "speaker": "钟离",
                    "text": "所以，旅行者，我想到了你。"
                },
                {
                    "id": "110240111",
                    "speaker": "钟离",
                    "text": "你是远渡重天、跨越星海之人。把历史刻在你的记忆里，就可以在未来某日，随你一同前往别的世界。"
                },
                {
                    "id": "110240112",
                    "speaker": "钟离",
                    "text": "身为旅行者的你，只要能够「记录」，那么，提瓦特的时代与历史，就获得了一种「存在的备份」…",
                    "choices": [
                        {
                            "id": "110240113",
                            "text": "原来这才是找我同行的理由。",
                            "response": [
                                {
                                    "id": "110240114",
                                    "speaker": "派蒙",
                                    "text": "任重而道远啊。"
                                },
                                {
                                    "id": "110240118",
                                    "speaker": "钟离",
                                    "text": "那么，接下来，就是将「盐盏」与「盐尺」投入海中的时刻了。"
                                },
                                {
                                    "id": "110240119",
                                    "speaker": "派蒙",
                                    "text": "啊？为什么要扔进海里？"
                                },
                                {
                                    "id": "110240120",
                                    "speaker": "钟离",
                                    "text": "刚才我说过吧？这里镇压了很多旧日的魔神。"
                                },
                                {
                                    "id": "110240121",
                                    "speaker": "钟离",
                                    "text": "也包括被「群玉阁」重锁深海的「漩涡之魔神」，奥赛尔…"
                                }
                            ]
                        },
                        {
                            "id": "110240115",
                            "text": "原来不是为了让我找宝箱啊。",
                            "response": [
                                {
                                    "id": "110240116",
                                    "speaker": "钟离",
                                    "text": "哈哈哈…祝你离开提瓦特以后，在星海之间也能捡到宝箱。"
                                },
                                {
                                    "id": "110240117",
                                    "speaker": "钟离",
                                    "text": "我有「财富之神」的别号，所以这句话是有效力的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1102402",
            "objective": "将遗物投入海中",
            "dialogues": []
        }
    ]
