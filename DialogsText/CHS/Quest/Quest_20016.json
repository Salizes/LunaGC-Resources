    "talks": [
        {
            "id": "2001601",
            "objective": "前往猎鹿人餐馆询问莎拉",
            "dialogues": [
                {
                    "id": "200160101",
                    "speaker": "莎拉",
                    "text": "餐品外送订单"
                },
                {
                    "id": "200160102",
                    "speaker": "莎拉",
                    "text": "旅行者！你来的正好…"
                },
                {
                    "id": "200160103",
                    "speaker": "莎拉",
                    "text": "抱歉，虽然你饿着肚子，但是能不能请你帮我个忙？"
                },
                {
                    "id": "200160104",
                    "speaker": "莎拉",
                    "text": "最近的送餐订单越来越多，我一般是先把订单按照地区分好，然后再标好是谁订的。"
                },
                {
                    "id": "200160105",
                    "speaker": "莎拉",
                    "text": "但是这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>的订餐人标签被我弄丢了，只知道订餐的人在清泉镇。"
                },
                {
                    "id": "200160106",
                    "speaker": "莎拉",
                    "text": "你能帮我把这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>送去清泉镇，再找找是谁订的吗？",
                    "choices": [
                        {
                            "id": "200160107",
                            "text": "好吧，但是…",
                            "response": [
                                {
                                    "id": "200160108",
                                    "speaker": "莎拉",
                                    "text": "等你回来的时候，会有一顿大餐做回报的！"
                                },
                                {
                                    "id": "200160109",
                                    "speaker": "莎拉",
                                    "text": "拜托了！"
                                }
                            ]
                        },
                        {
                            "id": "200160110",
                            "text": "太饿了，我只是来吃饭的。",
                            "response": [
                                {
                                    "id": "200160111",
                                    "speaker": "莎拉",
                                    "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
