            "objective": "(test)任务npc对话block$HIDDEN",
            "dialogues": [
                {
                    "id": "727330101",
                    "speaker": "「造笼师」",
                    "text": "「破空白铁小堇瓜」！我来替「电气鞘翅」报仇了！准备好你的鬼兜虫吧！"
                },
                {
                    "id": "727330102",
                    "speaker": "「造笼师」",
                    "text": "淘汰你以后，我会把荒泷派的成员挨个击败！"
                },
                {
                    "id": "727330103",
                    "speaker": "派蒙",
                    "text": "噫…这次倒是个成年人，不过怎么比之前的孩子更起劲了…",
                    "choices": [
                        {
                            "id": "727330104",
                            "text": "派蒙不要怕。",
                            "response": [
                                {
                                    "id": "727330106",
                                    "speaker": "荒泷一斗",
                                    "text": "白铁小堇瓜，人家点名要和你比拼了，你的气势可不能输给他。"
                                },
                                {
                                    "id": "727330107",
                                    "speaker": "荒泷一斗",
                                    "text": "带上「赤红一杵」，尽管放手去打吧！"
                                }
                            ]
                        },
                        {
                            "id": "727330105",
                            "text": "把他变成你的战果。"
                        }
                    ]
                }
            ]
        }
    ]
