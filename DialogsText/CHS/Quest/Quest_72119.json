    "talks": [
        {
            "id": "7211901",
            "objective": "",
            "dialogues": [
                {
                    "id": "721190101",
                    "speaker": "泽维尔",
                    "text": "呃！旅行者，我觉得…事情好像不太妙。"
                },
                {
                    "id": "721190102",
                    "speaker": "泽维尔",
                    "text": "里面的愚人众们突然把人都聚集到了核心附近，好像是有什么发现。"
                },
                {
                    "id": "721190103",
                    "speaker": "泽维尔",
                    "text": "他们不会真的能攻破核心的防御吧…不行，我们不能再拖下去了，必须马上开始进行功能性测试。"
                },
                {
                    "id": "721190104",
                    "speaker": "Player",
                    "text": "功能性测试？"
                },
                {
                    "id": "721190105",
                    "speaker": "泽维尔",
                    "text": "就是测试一下这位新伙计的净化能力，我可不想把它运进去之后再发现它没法干活。"
                },
                {
                    "id": "721190106",
                    "speaker": "泽维尔",
                    "text": "所以，我想请您帮我去找三只「鬼兜虫」来。"
                },
                {
                    "id": "721190107",
                    "speaker": "泽维尔",
                    "text": "我想要将这些小家伙们放入现在的「御影炉心」周围，让它们沾染上「祟神」。"
                },
                {
                    "id": "721190108",
                    "speaker": "泽维尔",
                    "text": "然后再将它们拿出来，用净化装置尝试净化它们所沾染的「祟神」。"
                },
                {
                    "id": "721190109",
                    "speaker": "泽维尔",
                    "text": "这，就是我所设计的「功能性测试」。"
                },
                {
                    "id": "721190110",
                    "speaker": "Player",
                    "text": "在哪能找到「鬼兜虫」？"
                },
                {
                    "id": "721190111",
                    "speaker": "泽维尔",
                    "text": "嗯…它们一般都栖息在雷元素富集区域…"
                },
                {
                    "id": "721190112",
                    "speaker": "泽维尔",
                    "text": "而且我还听说，它们在「御影炉心」附近也能生存…真是一群厉害的小家伙。"
                },
                {
                    "id": "721190113",
                    "speaker": "Player",
                    "text": "那我不如直接去「御影炉心」里抓…"
                },
                {
                    "id": "721190114",
                    "speaker": "泽维尔",
                    "text": "虽然这样也可以…但是，如果直接从「御影炉心」里面抓「鬼兜虫」来测试的话…"
                },
                {
                    "id": "721190115",
                    "speaker": "泽维尔",
                    "text": "说实话，我真有些担心我们这位新伙计的…可靠性。"
                },
                {
                    "id": "721190116",
                    "speaker": "泽维尔",
                    "text": "做测试，最好还是讲一个「循序渐进」嘛。"
                },
                {
                    "id": "721190117",
                    "speaker": "泽维尔",
                    "text": "咳，总之，请您拿三只「鬼兜虫」过来吧，我就在这等着您。",
                    "choices": [
                        {
                            "id": "721190118",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "721190119",
                                    "speaker": "泽维尔",
                                    "text": "那就拜托您了，只要三只「鬼兜虫」就好。"
                                }
                            ]
                        },
                        {
                            "id": "721190120",
                            "text": "不如我直接进去转一圈…",
                            "response": [
                                {
                                    "id": "721190121",
                                    "speaker": "泽维尔",
                                    "text": "呃…就测试本身而言，您直接进去转一圈，沾满「祟神」再出来，确实也可以作为测试对象。"
                                },
                                {
                                    "id": "721190122",
                                    "speaker": "泽维尔",
                                    "text": "但我之前也说了，这个装置的可靠性有些…不达预期。"
                                },
                                {
                                    "id": "721190123",
                                    "speaker": "泽维尔",
                                    "text": "如果在净化过程中，真的发生了什么预期之外的情况，您可能也会…呃，面临一些预期之外的问题…"
                                },
                                {
                                    "id": "721190124",
                                    "speaker": "泽维尔",
                                    "text": "咳，总之，我们还是就用「鬼兜虫」来测试吧。"
                                },
                                {
                                    "id": "721190125",
                                    "speaker": "泽维尔",
                                    "text": "只要三只「鬼兜虫」就好，您抓到了之后，就拿回来给我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211902",
            "objective": "与泽维尔对话",
            "dialogues": []
        },
        {
            "id": "7211903",
