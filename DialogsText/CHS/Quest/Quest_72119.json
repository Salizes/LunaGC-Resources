            "dialogues": [
                {
                    "id": "721190301",
                    "speaker": "泽维尔",
                    "text": "怎么样，您抓到三只「鬼兜虫」了吗？"
                },
                {
                    "id": "721190302",
                    "speaker": "Player",
                    "text": "已经抓齐了。"
                }
            ]
        },
        {
            "id": "7211904",
            "objective": "与泽维尔对话",
            "dialogues": [
                {
                    "id": "721190401",
                    "speaker": "泽维尔",
                    "text": "这些应该就够用了，谢谢您，我等会就开始试验。"
                }
            ]
        },
        {
            "id": "7211902",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721190201",
                    "speaker": "泽维尔",
                    "text": "希望我们的这位新伙计能正常运行…"
                }
            ]
        },
        {
            "id": "7211905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721190501",
                    "speaker": "泽维尔",
                    "text": "真不知道稻妻这边有没有给「御影炉心」派一个项目管理…"
                }
            ]
        }
    ]
