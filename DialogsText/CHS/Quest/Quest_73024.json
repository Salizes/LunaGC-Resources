{
    "quest": {
        "id": "73024",
        "title": "林中奇遇",
        "description": "在林间道路上，见到了一位被蕈兽攻击的人。无论如何，不能放着遇到困难的人不管。",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
