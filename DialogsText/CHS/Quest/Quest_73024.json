    "talks": [
        {
            "id": "7302401",
            "objective": "(test)判定摸过神像$HIDDEN",
            "dialogues": [
                {
                    "id": "730240101",
                    "speaker": "？？？",
                    "text": "哎呀，真是帮大忙了！谢谢你们。"
                },
                {
                    "id": "730240102",
                    "speaker": "拉娜",
                    "text": "如二位所见，我是这边的巡林官。名字嘛，叫拉娜。",
                    "choices": [
                        {
                            "id": "730240103",
                            "text": "#我是{NICKNAME}。",
                            "response": [
                                {
                                    "id": "730240104",
                                    "speaker": "派蒙",
                                    "text": "我的名字叫派蒙！我们是从别的国度来的。"
                                },
                                {
                                    "id": "730240107",
                                    "speaker": "拉娜",
                                    "text": "原来如此。嗯…从穿着打扮来看，确实不像是森林的子民…也不像是从黄沙里来的。透气性看起来很好，很适合在须弥行动。"
                                },
                                {
                                    "id": "730240108",
                                    "speaker": "派蒙",
                                    "text": "嗯？这么说来，既然拉娜是巡林官的话…",
                                    "choices": [
                                        {
                                            "id": "730240109",
                                            "text": "应该认识提纳里？",
                                            "response": [
                                                {
                                                    "id": "730240110",
                                                    "speaker": "拉娜",
                                                    "text": "#哦哦！{NICKNAME}也认识前辈吗？"
                                                },
                                                {
                                                    "id": "730240111",
                                                    "speaker": "拉娜",
                                                    "text": "提纳里前辈虽然有着「生人勿近」的气场，但其实是很不错的人。见习的时候，受了他很多照顾呢。而且，他的耳朵很漂亮。"
                                                },
                                                {
                                                    "id": "730240112",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯！其实我也很想摸摸看…",
                                                    "choices": [
                                                        {
                                                            "id": "730240113",
                                                            "text": "其实我也…",
                                                            "response": [
                                                                {
                                                                    "id": "730240114",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯…如果悄悄飞过去的话，是不是可以摸到呢？"
                                                                },
                                                                {
                                                                    "id": "730240115",
                                                                    "speaker": "拉娜",
                                                                    "text": "哈哈哈，如果贸然动手，提纳里前辈应该会生气吧。"
                                                                },
                                                                {
                                                                    "id": "730240118",
                                                                    "speaker": "拉娜",
                                                                    "text": "对吧？看起来很有光泽，不知道是什么样的触感。他现在在带的孩子对这个也很有兴趣…"
                                                                },
                                                                {
                                                                    "id": "730240119",
                                                                    "speaker": "派蒙",
                                                                    "text": "咦？拉娜说的，难道是…"
                                                                },
                                                                {
                                                                    "id": "730240120",
                                                                    "speaker": "Player",
                                                                    "text": "是柯莱吗？"
                                                                },
                                                                {
                                                                    "id": "730240121",
                                                                    "speaker": "拉娜",
                                                                    "text": "#咦，{NICKNAME}也认识柯莱吗？"
                                                                },
                                                                {
                                                                    "id": "730240122",
                                                                    "speaker": "拉娜",
                                                                    "text": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。"
                                                                },
                                                                {
                                                                    "id": "730240141",
                                                                    "speaker": "拉娜",
                                                                    "text": "咳咳！不管怎么说，我们巡林官的职责是保护森林、帮助旅人、提供指引。"
                                                                },
                                                                {
                                                                    "id": "730240142",
                                                                    "speaker": "拉娜",
                                                                    "text": "#诚如{NICKNAME}和派蒙所见，最近林子…应该说状况不太理想吧？无论是「蕈兽」，还是猛兽，都特别狂躁。还有「死域」…"
                                                                },
                                                                {
                                                                    "id": "730240143",
                                                                    "speaker": "拉娜",
                                                                    "text": "不如让我送你们一程吧？我的巡林路线接下来会经过维摩庄。到那边沿着水路，无论是去奥摩斯港，还是须弥城，都很方便。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730240144",
                                                                            "text": "可以，我们走吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240145",
                                                                                    "speaker": "拉娜",
                                                                                    "text": "嗯，我会保障二位平安的！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730240146",
                                                                            "text": "好，不过暂时有点别的事要处理…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240147",
                                                                                    "speaker": "拉娜",
                                                                                    "text": "我明白了，我会暂时在这里等你们。要注意安全喔！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730240116",
                                                            "text": "派蒙可以悄悄飞过去摸。",
                                                            "response": [
                                                                {
                                                                    "id": "730240117",
                                                                    "speaker": "派蒙",
                                                                    "text": "喂！这样的话，提纳里会生气吧？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730240123",
                                            "text": "应该认识柯莱？",
                                            "response": [
                                                {
                                                    "id": "730240124",
                                                    "speaker": "拉娜",
                                                    "text": "#咦，{NICKNAME}和那个孩子见过面吗？"
                                                },
                                                {
                                                    "id": "730240125",
                                                    "speaker": "拉娜",
                                                    "text": "柯莱的身体似乎不太好。就算是这样，她也很努力地看护着森林、祓除死域。大家都很担心她的情况。"
                                                },
                                                {
                                                    "id": "730240126",
                                                    "speaker": "拉娜",
                                                    "text": "不过，既然她身边有那个「耳朵看起来很好摸」的前辈，应该不会有问题的！"
                                                },
                                                {
                                                    "id": "730240127",
                                                    "speaker": "派蒙",
                                                    "text": "咦？耳朵…难道是说…",
                                                    "choices": [
                                                        {
                                                            "id": "730240128",
                                                            "text": "是提纳里吧？",
                                                            "response": [
                                                                {
                                                                    "id": "730240129",
                                                                    "speaker": "拉娜",
                                                                    "text": "#哦哦！{NICKNAME}也认识前辈吗？"
                                                                },
                                                                {
                                                                    "id": "730240130",
                                                                    "speaker": "拉娜",
                                                                    "text": "提纳里前辈虽然有着「生人勿近」的气场，但其实是很不错的人。见习的时候，受了他很多照顾呢。而且，他的耳朵很漂亮。"
                                                                },
                                                                {
                                                                    "id": "730240131",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯嗯！其实我也很想摸摸看…"
                                                                },
                                                                {
                                                                    "id": "730240132",
                                                                    "speaker": "拉娜",
                                                                    "text": "对吧？看起来很有光泽，不知道是什么样的触感。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730240133",
                                                                            "text": "其实我也…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯…如果悄悄飞过去的话，是不是可以摸到呢？"
                                                                                },
                                                                                {
                                                                                    "id": "730240135",
                                                                                    "speaker": "拉娜",
                                                                                    "text": "哈哈哈，如果贸然动手，提纳里前辈应该会生气吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730240136",
                                                                            "text": "派蒙可以悄悄飞过去摸。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730240137",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂！这样的话，提纳里会生气吧？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730240138",
                                                            "text": "是安柏吗？",
                                                            "response": [
                                                                {
                                                                    "id": "730240139",
                                                                    "speaker": "派蒙",
                                                                    "text": "「兔兔伯爵，出击！」"
                                                                },
                                                                {
                                                                    "id": "730240140",
                                                                    "speaker": "派蒙",
                                                                    "text": "…怎么想都不可能是安柏吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730240105",
                            "text": "我们来自很远的地方…",
                            "response": [
                                {
                                    "id": "730240106",
                                    "speaker": "派蒙",
                                    "text": "#嗯！我叫派蒙，{M#他}{F#她}是{NICKNAME}。"
                                }
                            ]
                        }
                    ]
                }
            ]
