    "talks": [
        {
            "id": "7069301",
            "objective": "与正在讨论的两人对话",
            "dialogues": [
                {
                    "id": "706930101",
                    "speaker": "安柏",
                    "text": "所以说呀，我们都看出来了！"
                },
                {
                    "id": "706930102",
                    "speaker": "安柏",
                    "text": "优菈最讨厌的应该是那种…死板和迂腐写在眉毛之间，一股劲儿钻牛角尖，只知道在流程和细节上卡人的家伙！"
                },
                {
                    "id": "706930103",
                    "speaker": "烟绯",
                    "text": "说不定，脸上还戴着单片眼镜，手里时常拿着一本书，但自己并没有完全读透，只是把它当成了装饰品。"
                },
                {
                    "id": "706930104",
                    "speaker": "烟绯",
                    "text": "如此一来，就显得自己有股「老学派」的气质，好像对话刚开始，就能在气势上压人一头！"
                },
                {
                    "id": "706930105",
                    "speaker": "安柏",
                    "text": "啊，实在太精准了，我的脑袋里都有画面了！"
                },
                {
                    "id": "706930106",
                    "speaker": "派蒙",
                    "text": "烟绯和…安柏？是之前完全没见过的组合！",
                    "choices": [
                        {
                            "id": "706930107",
                            "text": "这是在聊什么呢？",
                            "response": [
                                {
                                    "id": "706930109",
                                    "speaker": "安柏",
                                    "text": "啊呀，荣誉骑士和派蒙，你们来啦！"
                                },
                                {
                                    "id": "706930110",
                                    "speaker": "安柏",
                                    "text": "我正和烟绯商量方案呢，要不要给我们的游艺加几个「坏家伙雪人」，当成彩蛋。"
                                },
                                {
                                    "id": "706930111",
                                    "speaker": "派蒙",
                                    "text": "就像是魔物的靶子吗？"
                                },
                                {
                                    "id": "706930112",
                                    "speaker": "安柏",
                                    "text": "除了反派专业户魔物，也可以有些不那么传统的形象。"
                                },
                                {
                                    "id": "706930113",
                                    "speaker": "安柏",
                                    "text": "在选角的方向上，我和烟绯不谋而合的点子太多了！",
                                    "choices": [
                                        {
                                            "id": "706930114",
                                            "text": "在这里看到烟绯，有些惊喜。",
                                            "response": [
                                                {
                                                    "id": "706930116",
                                                    "speaker": "派蒙",
                                                    "text": "说起来也挺神奇的，你们真的站在一起的时候，我才发现，你们一看就很合得来！"
                                                },
                                                {
                                                    "id": "706930117",
                                                    "speaker": "烟绯",
                                                    "text": "#确实，能在蒙德遇见{NICKNAME}和派蒙，我也非常意外！"
                                                },
                                                {
                                                    "id": "706930118",
                                                    "speaker": "烟绯",
                                                    "text": "其实哦，我也不是第一次来蒙德了，之前在这边帮忙处理过不少民事诉讼…"
                                                },
                                                {
                                                    "id": "706930119",
                                                    "speaker": "烟绯",
                                                    "text": "这回，我刚和瑶瑶忙完，就碰上了「龙脊雪山国际越野赛」开幕，正好来看点新鲜的场面。"
                                                },
                                                {
                                                    "id": "706930120",
                                                    "speaker": "烟绯",
                                                    "text": "结果，到会场问路时，我遇见了安柏，和安柏聊得很投缘。"
                                                },
                                                {
                                                    "id": "706930121",
                                                    "speaker": "烟绯",
                                                    "text": "于是就来体验一下安柏管理的游戏，也帮忙出出主意！"
                                                },
                                                {
                                                    "id": "706930122",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，优菈的朋友，也是我的朋友，有趣的游戏，当然要一起享受啦！"
                                                },
                                                {
                                                    "id": "706930123",
                                                    "speaker": "安柏",
                                                    "text": "荣誉骑士和派蒙也来试试吧？为各国客人放松心情，施放压力的小游戏「飞玉趣掷」。"
                                                },
                                                {
                                                    "id": "706930124",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！练习一下打雪仗的本领，说不定以后能派上用场！"
                                                },
                                                {
                                                    "id": "706930125",
                                                    "speaker": "派蒙",
                                                    "text": "#而且，我和{NICKNAME}无聊的时候也可以玩，比一比谁更厉害，输了的负责做饭！",
                                                    "choices": [
                                                        {
                                                            "id": "706930126",
                                                            "text": "那我可不能错过。",
                                                            "response": [
                                                                {
                                                                    "id": "706930128",
                                                                    "speaker": "安柏",
                                                                    "text": "投雪球，和扔火球…以至于各种元素的投掷物，都有共通之处。"
                                                                },
                                                                {
                                                                    "id": "706930129",
                                                                    "speaker": "烟绯",
                                                                    "text": "对于你这位武艺天才来说，肯定不在话下！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706930127",
                                                            "text": "我丢雪球还蛮准的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706930115",
                                            "text": "以前没想过你们碰面的场景。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706930108",
                            "text": "优菈讨厌的家伙？"
                        }
                    ]
                }
            ]
        }
    ]
}