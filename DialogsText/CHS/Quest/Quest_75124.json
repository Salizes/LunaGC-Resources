    "talks": [
        {
            "id": "7512401",
            "objective": "(test)（test）与发愁的摄影师聊聊$HIDDEN",
            "dialogues": [
                {
                    "id": "751240101",
                    "speaker": "？？？",
                    "text": "唉，又跑出去了，我看看，在游泳圈里的不是只剩下一只了嘛…这下可怎么办…"
                },
                {
                    "id": "751240102",
                    "speaker": "？？？",
                    "text": "这要套到什么时候去啊…"
                },
                {
                    "id": "751240103",
                    "speaker": "派蒙",
                    "text": "哦，居然有人在这里拍画片…是在拍浮流鸟吗？"
                },
                {
                    "id": "751240104",
                    "speaker": "派蒙",
                    "text": "浮流鸟确实很可爱呢…",
                    "choices": [
                        {
                            "id": "751240105",
                            "text": "嗯，晃晃悠悠的…",
                            "response": [
                                {
                                    "id": "751240106",
                                    "speaker": "派蒙",
                                    "text": "对，走起路来晃晃悠悠的感觉十分可爱。而且，胀起身子，变成球，浮在水上时的样子，让人看着就觉得很开心。"
                                },
                                {
                                    "id": "751240109",
                                    "speaker": "？？？",
                                    "text": "这位有着漂亮银色光泽秀发的小小女士说得对啊！创造出浮流鸟这一生物的创造者应该受到此世所有的赞美…"
                                },
                                {
                                    "id": "751240110",
                                    "speaker": "容韦勒",
                                    "text": "真是了不起，啊，抱歉，我还没有自我介绍，我是浮流鸟摄影爱好者，叫我容韦勒就好。"
                                },
                                {
                                    "id": "751240111",
                                    "speaker": "派蒙",
                                    "text": "#嗯，我叫派蒙，这位是{NICKNAME}…不过，这里有这么多浮流鸟，容韦勒你为什么还唉声叹气的啊？"
                                },
                                {
                                    "id": "751240112",
                                    "speaker": "容韦勒",
                                    "text": "此事说来话长…不过就容我容韦勒长话短说吧，浮流鸟的摄影爱好者有很多，大家都希望拍出更有趣的照片…"
                                },
                                {
                                    "id": "751240113",
                                    "speaker": "容韦勒",
                                    "text": "而我在前几天诞生了个天才的想法——那就是让镜头中的所有浮流鸟套在游泳圈里！",
                                    "choices": [
                                        {
                                            "id": "751240114",
                                            "text": "有什么意义吗？",
                                            "response": [
                                                {
                                                    "id": "751240115",
                                                    "speaker": "容韦勒",
                                                    "text": "当然了，意义就在于没有意义，明明自己能够漂浮在水面上的浮流鸟，却仍然套着游泳圈…"
                                                },
                                                {
                                                    "id": "751240116",
                                                    "speaker": "容韦勒",
                                                    "text": "就如同用摩拉赚取摩拉那般虚无！"
                                                },
                                                {
                                                    "id": "751240120",
                                                    "speaker": "派蒙",
                                                    "text": "浮流鸟身上背负的东西也太多了吧…"
                                                },
                                                {
                                                    "id": "751240121",
                                                    "speaker": "容韦勒",
                                                    "text": "这就是所谓的超现实拍摄，要从留影之内找到更深的意义…啊，但，遇到了麻烦的情况。"
                                                },
                                                {
                                                    "id": "751240122",
                                                    "speaker": "容韦勒",
                                                    "text": "现实中的浮流鸟果然还是不会套着泳圈的…所以根本就拍不到这样的画面…"
                                                },
                                                {
                                                    "id": "751240123",
                                                    "speaker": "Player",
                                                    "text": "毕竟是「超现实」拍摄呢…"
                                                },
                                                {
                                                    "id": "751240124",
                                                    "speaker": "派蒙",
                                                    "text": "#不过，听上去好像只要用游泳圈把所有的浮流鸟圈住就好？{NICKNAME}，同为浮流鸟爱好者，我们来帮忙吧！",
                                                    "choices": [
                                                        {
                                                            "id": "751240125",
                                                            "text": "呼呼，浮流鸟爱好者应当互帮互助！",
                                                            "response": [
                                                                {
                                                                    "id": "751240126",
                                                                    "speaker": "派蒙",
                                                                    "text": "说得对！"
                                                                },
                                                                {
                                                                    "id": "751240129",
                                                                    "speaker": "容韦勒",
                                                                    "text": "真的吗？你们愿意帮忙吗？"
                                                                },
                                                                {
                                                                    "id": "751240130",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，只要事后你把好看的画片给我们几张就好！"
                                                                },
                                                                {
                                                                    "id": "751240131",
                                                                    "speaker": "容韦勒",
                                                                    "text": "那、那就拜托你们两位了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "751240127",
                                                            "text": "虽然我比较喜欢飞鼯啦…",
                                                            "response": [
                                                                {
                                                                    "id": "751240128",
                                                                    "speaker": "派蒙",
                                                                    "text": "这里就不要再说这种扫兴的话！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751240117",
                                            "text": "正常人确实想不到…",
                                            "response": [
                                                {
                                                    "id": "751240118",
                                                    "speaker": "容韦勒",
                                                    "text": "浮流鸟明明自己能够漂浮在水面上，却仍然套着游泳圈。就能在画面中形成一种意义的过度堆叠。"
                                                },
                                                {
                                                    "id": "751240119",
                                                    "speaker": "容韦勒",
                                                    "text": "这其实展现了一类「过度使用」和「浪费」的主题…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751240107",
                            "text": "其实我比较喜欢飞鼯啦…",
                            "response": [
                                {
                                    "id": "751240108",
                                    "speaker": "派蒙",
                                    "text": "飞鼯当然也很可爱，但是，「飞鼯比浮流鸟可爱」，你能够在这些游来游去的浮流鸟们面前说出这么残忍的话吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7512402",
            "objective": "(test)lua通知block$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7512403",
            "objective": "(test)（test）与摄影师对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751240301",
                    "speaker": "容韦勒",
                    "text": "哎呀，正是好时机…"
                },
                {
                    "id": "751240302",
                    "speaker": "容韦勒",
                    "text": "我忙了那么久都没有完成的画面，在两位的帮助下居然这么快就能够拍摄完毕…"
                },
                {
                    "id": "751240303",
                    "speaker": "容韦勒",
                    "text": "啊，浮流鸟，晃晃的滚滚的身子在游泳圈内…真是让人感动到落泪啊…"
                },
                {
                    "id": "751240304",
                    "speaker": "Player",
                    "text": "真的能那么感动吗…"
                },
                {
                    "id": "751240305",
                    "speaker": "容韦勒",
                    "text": "对于旁人来说无法理解，甚至觉得荒谬的东西，对于我们来说却是这段人生的追求…"
                },
                {
                    "id": "751240306",
                    "speaker": "容韦勒",
                    "text": "不过我相信，如果我能拍出更多浮流鸟可爱的画片，最终，喜欢浮流鸟的人一定会越来越多的！"
                },
                {
                    "id": "751240307",
                    "speaker": "派蒙",
                    "text": "我也完全相信这样的未来！"
                },
                {
                    "id": "751240308",
                    "speaker": "容韦勒",
                    "text": "啊，多谢你们的帮忙，哎，这些就给你们作为答谢吧，还请务必收下呀…"
                }
            ]
        },
        {
            "id": "7512404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751240401",
                    "speaker": "容韦勒",
                    "text": "我一定会及时按下快门的，赌上我浮流鸟摄影爱好者之名…哈哈，虽然感觉这个名头听上去抵不上什么赌资。"
                }
            ]
        },
        {
            "id": "7512405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751240501",
                    "speaker": "容韦勒",
                    "text": "只要让画面中的每只浮流鸟都套上游泳圈就行了…"
                },
                {
                    "id": "751240502",
                    "speaker": "容韦勒",
                    "text": "我一定会及时按下快门的，赌上我浮流鸟摄影爱好者之名…哈哈，虽然感觉这个名头听上去抵不上什么赌资。"
                }
            ]
        },
        {
            "id": "7512407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751240701",
                    "speaker": "Black Screen",
                    "text": "似乎有浮流鸟飘走了…\\n只能等待它们回来，重新套圈了…"
                }
            ]
        }
    ]
