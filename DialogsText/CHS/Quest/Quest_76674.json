        {
            "id": "7667401",
            "objective": "与尼可闲聊",
            "dialogues": [
                {
                    "id": "766740101",
                    "speaker": "尼可",
                    "text": "哇哦，没想到最后的成品这么出人意料。如果真的有人误入这里，应该会为魔女的力量赞叹不已。",
                    "choices": [
                        {
                            "id": "766740102",
                            "text": "如果真的有人误入这里…",
                            "response": [
                                {
                                    "id": "766740104",
                                    "speaker": "尼可",
                                    "text": "这个嘛，要看对方是怎样的人了。"
                                },
                                {
                                    "id": "766740105",
                                    "speaker": "尼可",
                                    "text": "引导很容易催生贪婪和懒惰。如果是像你们一样自食其力的人，我很愿意提供一些帮助。"
                                },
                                {
                                    "id": "766740106",
                                    "speaker": "尼可",
                                    "text": "但是，如果是那些把全部希望都寄托在魔女的力量上，想要不劳而获的人…呵呵。"
                                },
                                {
                                    "id": "766740107",
                                    "speaker": "派蒙",
                                    "text": "难、难道说要把他们变成雕塑吗？"
                                },
                                {
                                    "id": "766740108",
                                    "speaker": "尼可",
                                    "text": "那倒不会，我会引导他们离开这里，去附近的秘闻馆，那个叫奈芙尔的女人应该比我更懂得如何跟他们打交道。"
                                },
                                {
                                    "id": "766740109",
                                    "speaker": "尼可",
                                    "text": "想要不劳而获，不付出代价怎么行呢？"
                                }
                            ]
                        },
                        {
                            "id": "766740103",
                            "text": "你会引导他们实现愿望吗？"
                        }
                    ]
                }
            ]
        }
    ]
