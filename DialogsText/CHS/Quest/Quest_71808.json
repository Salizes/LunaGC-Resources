            "dialogues": [
                {
                    "id": "718080201",
                    "speaker": "阿鸠",
                    "text": "待苏醒之时…"
                },
                {
                    "id": "718080202",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "718080203",
                    "speaker": "阿鸠",
                    "text": "你是想要来见证「那位」的复苏吗？"
                },
                {
                    "id": "718080204",
                    "speaker": "阿鸠",
                    "text": "你来得稍微早了些…不过，也不算太晚。"
                },
                {
                    "id": "718080205",
                    "speaker": "派蒙",
                    "text": "她在说什么呀，完全听不懂…"
                },
                {
                    "id": "718080206",
                    "speaker": "Player",
                    "text": "呃，你在说什么？"
                },
                {
                    "id": "718080207",
                    "speaker": "阿鸠",
                    "text": "呵呵，你还没有意识到么…"
                },
                {
                    "id": "718080208",
                    "speaker": "阿鸠",
                    "text": "对你来说，这样也不错。"
                },
                {
                    "id": "718080209",
                    "speaker": "阿鸠",
                    "text": "回去吧，等到「那位」复苏的时候，你会明白一切的。"
                }
            ]
        },
        {
            "id": "7180803",
            "objective": "到南天门调查异常",
            "dialogues": [
                {
                    "id": "718080301",
                    "speaker": "嘉义",
                    "text": "你回来了，情况怎么样？"
                },
                {
                    "id": "718080302",
                    "speaker": "Player",
                    "text": "关于南天门的情况…"
                },
                {
                    "id": "718080303",
                    "speaker": "嘉义",
                    "text": "地震、魔物，还有个小女孩…是谁家孩子走失了吗？"
                },
                {
                    "id": "718080304",
                    "speaker": "Player",
                    "text": "关于小女孩说的话…"
                },
                {
                    "id": "718080305",
                    "speaker": "嘉义",
                    "text": "那个孩子说什么了？「那位」的复苏？见证？这都什么乱七八糟的…"
                },
                {
                    "id": "718080306",
                    "speaker": "嘉义",
                    "text": "准是又看了什么奇奇怪怪的书…算了，我马上去安排人，把那孩子带回城里来。"
                },
                {
                    "id": "718080307",
                    "speaker": "嘉义",
                    "text": "又是地震又是魔物，那孩子可别被伤着了。"
                },
                {
                    "id": "718080308",
                    "speaker": "嘉义",
                    "text": "谢谢你，这些东西请你收下吧，辛苦你帮我跑这一趟了。"
                },
                {
                    "id": "718080309",
                    "speaker": "嘉义",
                    "text": "唉，事情真是只多不少…"
                }
            ]
        },
        {
            "id": "7180804",
            "objective": "到南天门调查异常",
            "dialogues": [
                {
                    "id": "718080401",
                    "speaker": "嘉义",
