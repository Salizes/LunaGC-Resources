    "talks": [
        {
            "id": "7450301",
            "objective": "与店员阿尔邦交谈",
            "dialogues": [
                {
                    "id": "745030101",
                    "speaker": "阿尔邦",
                    "text": "两位老爷，又见面了。虽然才分开一会会，但我都开始有点想你们了。"
                },
                {
                    "id": "745030102",
                    "speaker": "派蒙",
                    "text": "你真是油嘴滑舌啦！"
                },
                {
                    "id": "745030103",
                    "speaker": "阿尔邦",
                    "text": "真伤心，被讨厌了。我看我还是好好工作吧。"
                },
                {
                    "id": "745030104",
                    "speaker": "阿尔邦",
                    "text": "我先说明，这次的数据收集分为两大部分，我和阿尔贝分别负责其中之一。"
                },
                {
                    "id": "745030105",
                    "speaker": "阿尔邦",
                    "text": "我这块的数据收集，是为了模拟决斗代理人的灵敏度，所以需要老爷完成一些水下的模拟冲刺项目。"
                },
                {
                    "id": "745030106",
                    "speaker": "派蒙",
                    "text": "原来决斗代理人是要在水下训练的啊？"
                },
                {
                    "id": "745030107",
                    "speaker": "阿尔邦",
                    "text": "谁知道呢？反正我也不认识决斗代理人，老板大概也不认识，但他觉得这样比较酷。"
                },
                {
                    "id": "745030108",
                    "speaker": "阿尔邦",
                    "text": "他本来还想在玩具的手臂内置十种滋水机关，滋起水来噼咻噼咻的，不过因为成本太高放弃了。",
                    "choices": [
                        {
                            "id": "745030109",
                            "text": "确实很酷。",
                            "response": [
                                {
                                    "id": "745030111",
                                    "speaker": "阿尔邦",
                                    "text": "枫丹毕竟是水的国度，要想远销异国，体现一些枫丹特色总是好的。"
                                },
                                {
                                    "id": "745030112",
                                    "speaker": "阿尔邦",
                                    "text": "总之，具体的注意事项，我们准备了一份手册，两位老爷稍后可以看看。"
                                },
                                {
                                    "id": "745030113",
                                    "speaker": "阿尔邦",
                                    "text": "怎么样？是不是已经跃跃欲试了？"
                                },
                                {
                                    "id": "745030114",
                                    "speaker": "Player",
                                    "text": "我准备一下。"
                                },
                                {
                                    "id": "745030115",
                                    "speaker": "阿尔邦",
                                    "text": "没问题，场地那边已经布置好了数据收集的仪器，所以这些就不用两位老爷费心了，只要专注地完成挑战就可以。"
                                }
                            ]
                        },
                        {
                            "id": "745030110",
                            "text": "小孩子才觉得酷吧。"
                        }
                    ]
                }
            ]
        }
    ]
}