        "total_speaker_counts": {
            "Player": 6,
            "安柏": 10,
            "派蒙": 5,
            "灰郁香": 3,
            "耶嘉": 11
        }
    },
    "talks": [
        {
            "id": "7055601",
            "objective": "和安柏对话",
            "dialogues": [
                {
                    "id": "705560101",
                    "speaker": "安柏",
                    "text": "#你们来啦，{NICKNAME}和派蒙。"
                },
                {
                    "id": "705560102",
                    "speaker": "安柏",
                    "text": "先认识一下新同事？这是第七小队的信号官耶嘉，还有她的搭档灰郁香。"
                },
                {
                    "id": "705560103",
                    "speaker": "耶嘉",
                    "text": "初次见面，荣誉骑士和白色小帮手，向你们致以敬意。"
                },
                {
                    "id": "705560104",
                    "speaker": "耶嘉",
                    "text": "灰郁香，来问好。"
                },
                {
                    "id": "705560105",
                    "speaker": "灰郁香",
                    "text": "嘎啊！",
                    "choices": [
                        {
                            "id": "705560106",
                            "text": "又一位信号官？",
                            "response": [
                                {
                                    "id": "705560108",
                                    "speaker": "派蒙",
                                    "text": "这只大大的鹰好听话欸！居然还穿着铠甲一样的衣服，还背着一个小包？"
                                },
                                {
                                    "id": "705560109",
                                    "speaker": "派蒙",
                                    "text": "等等，我有点迷糊了…安柏说的表演又是什么意思？"
                                },
                                {
                                    "id": "705560110",
                                    "speaker": "派蒙",
                                    "text": "和耶嘉小姐，还有这只鹰有关吗？"
                                },
                                {
                                    "id": "705560111",
                                    "speaker": "安柏",
                                    "text": "啊哈哈，我来简单解释一下。"
                                },
                                {
                                    "id": "705560112",
                                    "speaker": "安柏",
                                    "text": "琴团长应该和你说过，我们这边在举办风之翼竞速射击活动，没错吧？这是一种便于理解的说法…"
                                },
                                {
                                    "id": "705560113",
                                    "speaker": "安柏",
                                    "text": "其实，有可能不同于你们的预期，这次更像是一次「飞行表演与指挥挑战」。"
                                },
                                {
                                    "id": "705560114",
                                    "speaker": "安柏",
                                    "text": "核心不是传统的风之翼滑翔，而是从地面给灰郁香这样的空中单位发信，引导它进行各种复杂的行动，战胜魔物标靶…"
                                },
                                {
                                    "id": "705560115",
                                    "speaker": "安柏",
                                    "text": "算是一种新奇的体验，能给大家带来小小的惊喜！"
                                },
                                {
                                    "id": "705560116",
                                    "speaker": "灰郁香",
                                    "text": "嘎呜！",
                                    "choices": [
                                        {
                                            "id": "705560117",
                                            "text": "从自己滑翔，改成指挥飞鹰？",
                                            "response": [
                                                {
                                                    "id": "705560119",
                                                    "speaker": "耶嘉",
                                                    "text": "没错，这次飞行挑战也是一种技术演示，目标是向同僚们展现骑士团侦察力量的发展方向。"
                                                },
                                                {
                                                    "id": "705560120",
                                                    "speaker": "耶嘉",
                                                    "text": "并非每位骑士都像安柏前辈这样，能在滑翔中准确捕捉敌情，并进行简明扼要的记录…"
                                                },
                                                {
                                                    "id": "705560121",
                                                    "speaker": "耶嘉",
                                                    "text": "而我和灰郁香的使命，就是写好条令，让普通骑士与训练有素的蒙德鹰达成配合，运营一双「空中的眼睛」。"
                                                },
                                                {
                                                    "id": "705560122",
                                                    "speaker": "耶嘉",
                                                    "text": "这样一来，就算没有强劲的侦察骑士，也能长时间探明敌情，稳定地向前行军。"
                                                },
                                                {
                                                    "id": "705560123",
                                                    "speaker": "耶嘉",
                                                    "text": "甚至，通过灰郁香装备的前向武器，还能提前排除一些较为弱小的空中魔物。"
                                                },
                                                {
                                                    "id": "705560124",
                                                    "speaker": "派蒙",
                                                    "text": "好…好专业的感觉？口吻有点像工程师！"
                                                },
                                                {
                                                    "id": "705560125",
                                                    "speaker": "安柏",
                                                    "text": "放轻松，耶嘉，不用像面对芙蕾德莉卡阿姨那样严肃嘛。"
                                                },
                                                {
                                                    "id": "705560126",
                                                    "speaker": "安柏",
                                                    "text": "荣誉骑士和派蒙，你们就当是和新认识的动物朋友一起游玩就好，开心最重要！"
                                                },
                                                {
                                                    "id": "705560127",
                                                    "speaker": "耶嘉",
                                                    "text": "不好意思，前辈，我们只是有点…跃跃欲试。因为我和灰郁香一直在为这次演示反复练习。"
                                                },
                                                {
                                                    "id": "705560128",
                                                    "speaker": "耶嘉",
                                                    "text": "如果能被荣誉骑士和白色小帮手认可，说明条令已经趋于完善，稍稍润色就能投入使用了。"
                                                },
                                                {
                                                    "id": "705560129",
                                                    "speaker": "耶嘉",
                                                    "text": "当然，演示过程中可能出现一些机械故障…这都是因为之前训练的强度太高，耗尽了某些部件的使用寿命。"
                                                },
                                                {
                                                    "id": "705560130",
                                                    "speaker": "耶嘉",
                                                    "text": "等到消耗性的部件到位，统统替换上去，灰郁香的背包在正式行动中就绝不会有差池，请别在意！"
                                                },
                                                {
                                                    "id": "705560131",
                                                    "speaker": "灰郁香",
                                                    "text": "嘎嗷！",
                                                    "choices": [
                                                        {
                                                            "id": "705560132",
                                                            "text": "我会严格一些，但不至于苛责。",
                                                            "response": [
                                                                {
                                                                    "id": "705560134",
                                                                    "speaker": "派蒙",
                                                                    "text": "那，那我也要来好好试一试！"
                                                                },
                                                                {
                                                                    "id": "705560135",
                                                                    "speaker": "安柏",
                                                                    "text": "嘿嘿，听起来，你们四位都干劲满满啊，那就祝你们玩得开心啦！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705560133",
                                                            "text": "没事，我不会乱挑毛病的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705560118",
                                            "text": "我们不上阵，坐镇发令就行？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705560107",
                            "text": "是没听过的职位…"
                        }
                    ]
                }
            ]
        }
    ]
}