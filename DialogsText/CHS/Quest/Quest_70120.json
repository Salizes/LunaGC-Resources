    "talks": [
        {
            "id": "7012001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200101",
                    "speaker": "卢科夫",
                    "text": "唉…该怎么办呢，风雪那么大，他们怎么还没回来？可是，可是我只是个送热茶的，哎，这该如何是好？"
                },
                {
                    "id": "701200102",
                    "speaker": "派蒙",
                    "text": "咦，为什么要向山做这样的动作？啊，我懂了，难道是在…向雪山祈祷？"
                },
                {
                    "id": "701200103",
                    "speaker": "卢科夫",
                    "text": "唉…说是向山里祈祷也没毛病，我的朋友们，一共三位，进山打猎去啦，我负责管理营地。"
                },
                {
                    "id": "701200104",
                    "speaker": "卢科夫",
                    "text": "顺便泡点热茶，给他们暖暖身子什么的…我不会打猎，只能做这些啦，但是他们一直没回来，就让人觉得忧心。"
                },
                {
                    "id": "701200105",
                    "speaker": "卢科夫",
                    "text": "哎呦，我可求求雪山了，把我的朋友们送回来，不然他们肯定要被冻僵了。"
                },
                {
                    "id": "701200106",
                    "speaker": "卢科夫",
                    "text": "唉…或者，二位，能不能帮我把热茶送给我的朋友们？"
                },
                {
                    "id": "701200107",
                    "speaker": "卢科夫",
                    "text": "看你们在这寒风中行走，脚步倒是没有丝毫冗乱，看来倒是很熟悉这样严苛的环境。"
                },
                {
                    "id": "701200108",
                    "speaker": "卢科夫",
                    "text": "热茶就在这里，要是能在凉透之前送到…"
                },
                {
                    "id": "701200109",
                    "speaker": "派蒙",
                    "text": "倒也不是不行？",
                    "choices": [
                        {
                            "id": "701200110",
                            "text": "嗯，让我们试试吧！",
                            "response": [
                                {
                                    "id": "701200111",
                                    "speaker": "卢科夫",
                                    "text": "那就靠二位了，哎，要是找不到人，茶凉了，可以回来再取！"
                                }
                            ]
                        },
                        {
                            "id": "701200112",
                            "text": "之后再说…",
                            "response": [
                                {
                                    "id": "701200113",
                                    "speaker": "卢科夫",
                                    "text": "好的…唉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7012014",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012015",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200201",
                    "speaker": "派蒙",
                    "text": "卢科夫，卢科夫…怎么样？他们情况还好吗？"
                },
                {
                    "id": "701200202",
                    "speaker": "卢科夫",
                    "text": "哦是你们！你们回来了！"
                },
                {
                    "id": "701200203",
                    "speaker": "卢科夫",
                    "text": "他们的情况都还好，至少现在还好…在你们送热茶上去之前可就不太行了，险些就没法从雪山上下来啦。"
                },
                {
                    "id": "701200204",
                    "speaker": "卢科夫",
                    "text": "看来向你们求助是对的，唉，要不然我就得一下失去三位朋友了。"
                },
                {
                    "id": "701200205",
                    "speaker": "卢科夫",
                    "text": "这是给你们的报酬…见义勇为的人就应该多拿一些，哈哈，这样才有更多的人见义勇为嘛。"
                }
            ]
        },
        {
            "id": "7012006",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200301",
                    "speaker": "派蒙",
                    "text": "这是你的同伴让我给你们送的热茶！"
                },
                {
                    "id": "701200302",
                    "speaker": "马尔金",
                    "text": "哦哦，太感谢了，哎…真好，拿在手里都觉得暖和…哎，险些下不去，这温度实在是太冷了…"
                },
                {
                    "id": "701200303",
                    "speaker": "马尔金",
                    "text": "我和我的同伴们也在风雪中走失，要是没你们送来这碗热茶，说不定就回不去了。"
                },
                {
                    "id": "701200304",
                    "speaker": "派蒙",
                    "text": "唔，那还是喝完这碗茶就回去吧！"
                },
                {
                    "id": "701200305",
                    "speaker": "马尔金",
                    "text": "好、好的…"
                },
                {
                    "id": "701200306",
                    "speaker": "Black Screen",
                    "text": "名为马尔金的猎人喝下了热茶。\\n趁着身子还有余温往山下走去。"
                }
            ]
        },
        {
            "id": "7012011",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701201101",
                    "speaker": "卢科夫",
                    "text": "这么冷的天，要是没这么一碗热茶暖暖身子…唉，要是有谁能帮忙送送就好了。",
                    "choices": [
                        {
                            "id": "701201102",
                            "text": "嗯，让我试试吧！",
                            "response": [
                                {
                                    "id": "701201103",
                                    "speaker": "卢科夫",
                                    "text": "那就靠你了，哎，要是找不到人，茶凉了，可以回来再取！"
                                }
                            ]
                        },
                        {
                            "id": "701201104",
                            "text": "之后再说…",
                            "response": [
                                {
                                    "id": "701201105",
                                    "speaker": "卢科夫",
                                    "text": "好的…唉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7012003",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012007",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200501",
                    "speaker": "派蒙",
                    "text": "怎么样，你还好吗？"
                },
                {
                    "id": "701200502",
                    "speaker": "纳尔金",
                    "text": "呃…我、我还好，但是就是有点冷…唉，要是有碗热茶喝就好了，呜…我们要是回不去，卢科夫肯定要担心啦。"
                },
                {
                    "id": "701200503",
                    "speaker": "纳尔金",
                    "text": "一说起热茶就想到了他，他泡的茶总有种清香…"
                },
                {
                    "id": "701200504",
                    "speaker": "派蒙",
                    "text": "我们猜你说的就是这个。"
                },
                {
                    "id": "701200505",
                    "speaker": "纳尔金",
                    "text": "哦哦…果然，这个味道，是他请你们来的吗？"
                },
                {
                    "id": "701200506",
                    "speaker": "纳尔金",
                    "text": "呜…我还以为我要交代在这儿了，感谢你们，还有卢科夫的茶…呜呜。"
                },
                {
                    "id": "701200507",
                    "speaker": "派蒙",
                    "text": "别哭啦，在这哭，眼泪和鼻涕都会冻在脸上…得先回到营地里！"
                },
                {
                    "id": "701200508",
                    "speaker": "纳尔金",
                    "text": "说得对，还是得先下山才行…"
                },
                {
                    "id": "701200509",
                    "speaker": "Black Screen",
                    "text": "名为纳尔金的猎人喝下了热茶。\\n趁着身子还有余温往山下走去。"
                }
            ]
        },
        {
            "id": "7012012",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012005",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012010",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200401",
                    "speaker": "派蒙",
                    "text": "怎么样，你没事吧？"
                },
                {
                    "id": "701200402",
                    "speaker": "莫罗夫",
                    "text": "啊，我记得快要晕过去之前…看到了熊…谢谢你们，要是没有你们二位出手相助，我可就得被野兽们分而食之了…"
                },
                {
                    "id": "701200403",
                    "speaker": "莫罗夫",
                    "text": "要是身子能暖和点，也不至于会陷入这种情况，呜，说起来，这不是卢科夫泡的热茶嘛…"
                },
                {
                    "id": "701200404",
                    "speaker": "莫罗夫",
                    "text": "难道是卢科夫拜托你们来找我的吗，真好啊…"
                },
                {
                    "id": "701200405",
                    "speaker": "派蒙",
                    "text": "是的！"
                },
                {
                    "id": "701200406",
                    "speaker": "莫罗夫",
                    "text": "看来下山之后还得向他道谢。"
                },
                {
                    "id": "701200407",
                    "speaker": "莫罗夫",
                    "text": "我和我的同伴们也在风雪中走失，不知道他们怎么样了…唉，现在自身难保，也不是担心他们的时候。"
                },
                {
                    "id": "701200408",
                    "speaker": "莫罗夫",
                    "text": "谢谢你们，二位！救命之恩今生难忘！"
                },
                {
                    "id": "701200409",
                    "speaker": "Black Screen",
                    "text": "名为莫罗夫的猎人喝下了热茶。\\n趁着身子还有余温往山下走去。"
                }
            ]
        },
        {
            "id": "7012013",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012004",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012008",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7012009",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701200901",
                    "speaker": "卢科夫",
                    "text": "有送到吗…一共是三位。难道说是茶凉了，茶凉了可以从这里取，凉茶也可以放这，我重新热好。"
                }
            ]
        },
        {
            "id": "7012006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701200601",
                    "speaker": "马尔金",
                    "text": "呼…让我，让我稍微休息会儿。"
                },
                {
                    "id": "701200602",
                    "speaker": "马尔金",
                    "text": "还是营地里暖和，唉…"
                }
            ]
        },
        {
            "id": "7012007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701200701",
                    "speaker": "纳尔金",
                    "text": "多谢！多谢二位的帮助…"
                },
                {
                    "id": "701200702",
                    "speaker": "纳尔金",
                    "text": "唉…要是没有二位，我还真没法从山上下来。唉…"
                }
            ]
        },
        {
            "id": "7012008",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701200801",
                    "speaker": "莫罗夫",
                    "text": "唉…回过神来想想还真是后怕，下次打猎…"
                },
                {
                    "id": "701200802",
                    "speaker": "莫罗夫",
                    "text": "下次还是先做好准备再进雪山打猎吧。"
                }
            ]
        },
        {
            "id": "7012010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701201001",
                    "speaker": "卢科夫",
                    "text": "嗯…又有一壶茶泡好了，不得不说在冰天雪地里喝热茶的风味还是不错的…"
                },
                {
                    "id": "701201002",
                    "speaker": "卢科夫",
                    "text": "如果没有这些个执意想要上山打猎，还差点困住下不来的朋友就好了！"
                }
            ]
        }
    ]
}