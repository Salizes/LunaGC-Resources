    "talks": [
        {
            "id": "2205001",
            "objective": "与寝子对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2205002",
            "objective": "前往鸣神大社附近",
            "dialogues": [
                {
                    "id": "220500201",
                    "speaker": "「寝子」",
                    "text": "「鸣神大社」…就是这里吗？"
                },
                {
                    "id": "220500202",
                    "speaker": "「寝子」",
                    "text": "红色的门有好多。人类很喜欢红色的门吗？"
                },
                {
                    "id": "220500203",
                    "speaker": "Player",
                    "text": "这个叫「鸟居」。"
                },
                {
                    "id": "220500204",
                    "speaker": "派蒙",
                    "text": "浅濑神社也有呢。"
                },
                {
                    "id": "220500205",
                    "speaker": "「寝子」",
                    "text": "哦哦奴家明白了，原来那就是「鸟居」啊。也就是鸟居住的地方对吧。"
                },
                {
                    "id": "220500206",
                    "speaker": "「寝子」",
                    "text": "所以鸟居越多，鸟就越多吧。鸟，那可是好东西。人类也挺聪明的嘛。"
                },
                {
                    "id": "220500207",
                    "speaker": "「寝子」",
                    "text": "汝等，看见阿响在哪了吗？"
                },
                {
                    "id": "220500208",
                    "speaker": "Player",
                    "text": "没发现人的踪迹…"
                },
                {
                    "id": "220500209",
                    "speaker": "派蒙",
                    "text": "这周围，好像都没有人的样子…"
                },
                {
                    "id": "220500210",
                    "speaker": "派蒙",
                    "text": "不如，我们上去「鸣神大社」，问问里面的那些巫女小姐吧。"
                },
                {
                    "id": "220500211",
                    "speaker": "派蒙",
                    "text": "那位「阿响」应该也是巫女…说不定，她们会知道些什么呢。"
                }
            ]
        },
        {
            "id": "2205003",
            "objective": "前往鸣神大社",
            "dialogues": [
                {
                    "id": "220500301",
                    "speaker": "「寝子」",
                    "text": "喵喵，这神社可真大，也有很多人类呢。"
                },
                {
                    "id": "220500302",
                    "speaker": "「寝子」",
                    "text": "喔！塞钱箱和架子也很气派，怪不得有这么多人来这里。"
                },
                {
                    "id": "220500303",
                    "speaker": "「寝子」",
                    "text": "汝等好好学。以后，浅濑神社也要变成这样。",
                    "choices": [
                        {
                            "id": "220500304",
                            "text": "应该不是这方面的原因啦…",
                            "response": [
                                {
                                    "id": "220500306",
                                    "speaker": "「寝子」",
                                    "text": "不过，还是没看到阿响哪。"
                                },
                                {
                                    "id": "220500307",
                                    "speaker": "派蒙",
                                    "text": "总、总之，我们找人问问关于「阿响」的事吧。"
                                }
                            ]
                        },
                        {
                            "id": "220500305",
                            "text": "为什么是我要好好学？！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2205004",
            "objective": "向稻城萤美询问信息",
            "dialogues": [
                {
                    "id": "220500401",
                    "speaker": "稻城萤美",
                    "text": "你好，远道而来的旅者，欢迎来到「鸣神大社」。"
                },
                {
                    "id": "220500402",
                    "speaker": "稻城萤美",
                    "text": "如果有烦恼或者心愿，可以来这里求签，雷神会保佑你的。"
                },
                {
                    "id": "220500403",
                    "speaker": "派蒙",
                    "text": "我们不是来求签的，是有一件事想要请问你…"
                },
                {
                    "id": "220500404",
                    "speaker": "稻城萤美",
                    "text": "问我？喔…那请说吧。"
                },
                {
                    "id": "220500405",
                    "speaker": "Player",
                    "text": "是这样的…"
                },
                {
                    "id": "220500406",
                    "speaker": "稻城萤美",
                    "text": "浅濑神社的…阿响？难道是「浅濑响」…"
                },
                {
                    "id": "220500407",
                    "speaker": "「寝子」",
                    "text": "对！阿响就是「浅濑响」，人类！汝认识阿响吗？知道她在哪里吗？"
                },
                {
                    "id": "220500408",
                    "speaker": "稻城萤美",
                    "text": "嗯…咦？！这只猫怎么会说话，是我听错了吗…"
                },
                {
                    "id": "220500409",
                    "speaker": "「寝子」",
                    "text": "人类真是喜欢大惊小怪啊…奴家会说话是件很奇怪的事吗？"
                },
                {
                    "id": "220500410",
                    "speaker": "「寝子」",
                    "text": "汝，认识阿响吗？知道她在哪里吗？"
                },
                {
                    "id": "220500411",
                    "speaker": "稻城萤美",
                    "text": "被一只猫这么追问，感觉还真是奇怪…"
                },
                {
                    "id": "220500412",
                    "speaker": "稻城萤美",
                    "text": "不过，如果你们问的真的是那位「浅濑响」的话，那你们找错地方了…"
                },
                {
                    "id": "220500413",
                    "speaker": "派蒙",
                    "text": "欸？"
                },
                {
                    "id": "220500414",
                    "speaker": "Player",
                    "text": "找错了…地方？"
                },
                {
                    "id": "220500415",
                    "speaker": "稻城萤美",
                    "text": "我之前在神社少数保存完整的典籍里读到过她的名字。她是浅濑神社最后一代…"
                },
                {
                    "id": "220500416",
                    "speaker": "稻城萤美",
                    "text": "大约四五百年前，曾经有「影向役者三人组」的说法。浅濑响、惟神晴之介、御舆长正曾经在影向山上，向影向天狗求学。"
                },
                {
                    "id": "220500417",
                    "speaker": "稻城萤美",
                    "text": "期间浅濑在我们神社见习过，也与狐斋宫大人结交。不过，最后…"
                },
                {
                    "id": "220500418",
                    "speaker": "稻城萤美",
                    "text": "三人最终似乎是在一场记事中语焉不详的「灾难」后分道扬镳了。据说，惟神渡海去了璃月，想要学习更强大的「仙家道法」。"
                },
                {
                    "id": "220500419",
                    "speaker": "稻城萤美",
                    "text": "御舆回到了稻妻城，为幕府效力。浅濑则…",
                    "choices": [
                        {
                            "id": "220500420",
                            "text": "回到了清籁岛…",
                            "response": [
                                {
                                    "id": "220500422",
                                    "speaker": "稻城萤美",
                                    "text": "嗯，没错。不过因为可考的史料太少，所以具体的情况也不太清楚。"
                                },
                                {
                                    "id": "220500423",
                                    "speaker": "Player",
                                    "text": "等一下…"
                                },
                                {
                                    "id": "220500424",
                                    "speaker": "派蒙",
                                    "text": "唔…她说四五百年前，也就是说，阿响是很久前的人。"
                                },
                                {
                                    "id": "220500425",
                                    "speaker": "派蒙",
                                    "text": "那寝子也是有四五百岁的猫？！"
                                },
                                {
                                    "id": "220500426",
                                    "speaker": "「寝子」",
                                    "text": "喵喵？奴家不清楚。「四五百岁」是什么意思？"
                                },
                                {
                                    "id": "220500427",
                                    "speaker": "「寝子」",
                                    "text": "奴家又不是人。没有那么多要计较的事情，只知道太阳升起、月亮升起。如果心情不好，那睡一觉就好了。"
                                },
                                {
                                    "id": "220500428",
                                    "speaker": "派蒙",
                                    "text": "好羡慕啊…",
                                    "choices": [
                                        {
                                            "id": "220500429",
                                            "text": "派蒙也差不多吧。",
                                            "response": [
                                                {
                                                    "id": "220500430",
                                                    "speaker": "派蒙",
                                                    "text": "#喂！真没礼貌，派蒙可是天天为了{NICKNAME}，担心得不得了。"
                                                },
                                                {
                                                    "id": "220500433",
                                                    "speaker": "「寝子」",
                                                    "text": "汝等说了很多奴家不懂的事情。所以，阿响呢？"
                                                },
                                                {
                                                    "id": "220500434",
                                                    "speaker": "稻城萤美",
                                                    "text": "恕我直言，浅濑响的话，恐怕已经…"
                                                },
                                                {
                                                    "id": "220500435",
                                                    "speaker": "Player",
                                                    "text": "阿响不在这里。"
                                                },
                                                {
                                                    "id": "220500436",
                                                    "speaker": "派蒙",
                                                    "text": "对、对啊，阿响应该是去别的地方了。"
                                                },
                                                {
                                                    "id": "220500437",
                                                    "speaker": "「寝子」",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "220500438",
                                                    "speaker": "「寝子」",
                                                    "text": "也是。"
                                                },
                                                {
                                                    "id": "220500439",
                                                    "speaker": "「寝子」",
                                                    "text": "真没办法哪。阿响怎么还跟小家伙似的。到处乱跑。"
                                                },
                                                {
                                                    "id": "220500440",
                                                    "speaker": "派蒙",
                                                    "text": "不管怎么说，谢谢巫女小姐！"
                                                },
                                                {
                                                    "id": "220500441",
                                                    "speaker": "Player",
                                                    "text": "那么，我们先走了。"
                                                },
                                                {
                                                    "id": "220500442",
                                                    "speaker": "稻城萤美",
                                                    "text": "唉…请慢走。如果需要我帮忙的话，就请尽管来找我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220500431",
                                            "text": "猫的寿命有这么长吗？",
                                            "response": [
                                                {
                                                    "id": "220500432",
                                                    "speaker": "派蒙",
                                                    "text": "一般来说是没有的…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220500421",
                            "text": "回了浅濑神社…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2205005",
            "objective": "(test)帮寝子把信放在神像旁",
            "dialogues": [
                {
                    "id": "220500501",
                    "speaker": "「寝子」",
                    "text": "就在这里歇歇吧，奴家也累了。"
                },
                {
                    "id": "220500502",
                    "speaker": "「寝子」",
                    "text": "不过，真的和阿响说的一样。"
                },
                {
                    "id": "220500503",
                    "speaker": "「寝子」",
                    "text": "不同的岛，真的完全不一样。而且，原来神社可以在这么高的山上。人类难道不怕高吗？"
                },
                {
                    "id": "220500504",
                    "speaker": "「寝子」",
                    "text": "还是奴家的浅濑神社好。"
                },
                {
                    "id": "220500505",
                    "speaker": "「寝子」",
                    "text": "不过，阿响到底在哪呢…"
                },
                {
                    "id": "220500506",
                    "speaker": "Player",
                    "text": "还要继续找吗？"
                },
                {
                    "id": "220500507",
                    "speaker": "「寝子」",
                    "text": "奴家累了。以后再说吧。"
                },
                {
                    "id": "220500508",
                    "speaker": "派蒙",
                    "text": "还有以后喔！"
                },
                {
                    "id": "220500509",
                    "speaker": "「寝子」",
                    "text": "那当然。阿响她对我说过好多好多故事。在海边的故事、在很多树的地方的故事、什么「狐狸大人」的故事。"
                },
                {
                    "id": "220500510",
                    "speaker": "「寝子」",
                    "text": "这些故事，奴家都记得很清楚。"
                },
                {
                    "id": "220500511",
                    "speaker": "「寝子」",
                    "text": "但现在最重要的，就是回家。毕竟，浅濑神社必须要有它的宫司才行。"
                },
                {
                    "id": "220500512",
                    "speaker": "「寝子」",
                    "text": "总之，汝等现在就和奴家一起回去吧。"
                }
            ]
        },
        {
            "id": "2205006",
            "objective": "陪寝子离开",
            "dialogues": []
        },
        {
            "id": "2205007",
            "objective": "和寝子一同回到清籁岛",
            "dialogues": [
                {
                    "id": "220500601",
                    "speaker": "「寝子」",
                    "text": "呼…总算回来了，在那座神社旁边待久了，奴家的毛都要全部打卷了。"
                },
                {
                    "id": "220500602",
                    "speaker": "「寝子」",
                    "text": "这次多谢汝等了，汝等真是不可多得的可靠人类啊，喵喵。"
                },
                {
                    "id": "220500603",
                    "speaker": "「寝子」",
                    "text": "奴家就继续去打理神社了，等阿响回来之后，奴家就把汝等介绍给她。"
                },
                {
                    "id": "220500604",
                    "speaker": "「寝子」",
                    "text": "喵喵…"
                },
                {
                    "id": "220500605",
                    "speaker": "「寝子」",
                    "text": "阿响，到底什么时候才会回来呢…"
                }
            ]
        },
        {
            "id": "2205007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220500701",
                    "speaker": "稻城萤美",
                    "text": "您还有什么事吗？",
                    "choices": [
                        {
                            "id": "220500702",
                            "text": "关于御舆…",
                            "response": [
                                {
                                    "id": "220500703",
                                    "speaker": "稻城萤美",
                                    "text": "传说御舆长正一直在为幕府效力，据说，他的为人极为清白正直，甚至到了…近乎偏执的程度。"
                                },
                                {
                                    "id": "220500704",
                                    "speaker": "稻城萤美",
                                    "text": "他的血脉一直流传到了今天。城内如今还有姓御舆的人，多半是他的后人。"
                                }
                            ]
                        },
                        {
                            "id": "220500705",
                            "text": "关于惟神…",
                            "response": [
                                {
                                    "id": "220500706",
                                    "speaker": "稻城萤美",
                                    "text": "关于他的记载不多。他在渡海去璃月学了仙术之后，又回了稻妻。"
                                },
                                {
                                    "id": "220500707",
                                    "speaker": "稻城萤美",
                                    "text": "然后，他就创立了自己的「阴阳术」和「式大将」。"
                                },
                                {
                                    "id": "220500708",
                                    "speaker": "稻城萤美",
                                    "text": "根据记载，为了给稻妻带来安宁，他曾经用这种术封印了四处大闹的妖狸五百藏。"
                                },
                                {
                                    "id": "220500709",
                                    "speaker": "稻城萤美",
                                    "text": "但后来，他也逐渐销声匿迹了。"
                                }
                            ]
                        },
                        {
                            "id": "220500710",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "220500711",
                                    "speaker": "稻城萤美",
                                    "text": "请慢走。如果需要我帮忙的话，就请尽管来找我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}