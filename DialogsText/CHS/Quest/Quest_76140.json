    "talks": [
        {
            "id": "7614001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761390301",
                    "speaker": "萨维特",
                    "text": "怎么又是你，我不卖投资券了，走吧走吧。"
                },
                {
                    "id": "761390302",
                    "speaker": "萨维特",
                    "text": "唉，回头一想，我就不该信你还有什么朋友…",
                    "choices": [
                        {
                            "id": "761390303",
                            "text": "你那完全就是骗人啦。",
                            "response": [
                                {
                                    "id": "761390305",
                                    "speaker": "派蒙",
                                    "text": "是啊，好好卖书不是挺好的？"
                                },
                                {
                                    "id": "761390306",
                                    "speaker": "派蒙",
                                    "text": "#喔！{NICKNAME}，你看那边，那本书好像很有趣，我们去看看吧。"
                                },
                                {
                                    "id": "761390307",
                                    "speaker": "萨维特",
                                    "text": "行，行，算我倒…霉…"
                                },
                                {
                                    "id": "761390308",
                                    "speaker": "萨维特",
                                    "text": "奈…奈芙尔老板！没想到您居然大驾光临…您…您也想买张投资…不是，您想买本书吗？"
                                },
                                {
                                    "id": "761390309",
                                    "speaker": "奈芙尔",
                                    "text": "我就不了，只是陪我这位朋友过来看看而已。"
                                },
                                {
                                    "id": "761390310",
                                    "speaker": "奈芙尔",
                                    "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。"
                                },
                                {
                                    "id": "761390311",
                                    "speaker": "萨维特",
                                    "text": "一般，一般，哈哈哈…小本生意，糊口罢了。"
                                },
                                {
                                    "id": "761390312",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特老板客气了，您的信誉和商业头脑，在那夏镇可是很有名的。"
                                },
                                {
                                    "id": "761390313",
                                    "speaker": "奈芙尔",
                                    "text": "我相信，大家跟着您投资，您一定能赚到大钱。"
                                },
                                {
                                    "id": "761390314",
                                    "speaker": "萨维特",
                                    "text": "借奈芙尔老板吉言…借奈芙尔老板吉言。"
                                },
                                {
                                    "id": "761390315",
                                    "speaker": "萨维特",
                                    "text": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…"
                                },
                                {
                                    "id": "761390316",
                                    "speaker": "奈芙尔",
                                    "text": "东西是已经找到了，但…"
                                },
                                {
                                    "id": "761390317",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特先生，不要心急。事情，要一步一步地做才稳当。"
                                },
                                {
                                    "id": "761390318",
                                    "speaker": "萨维特",
                                    "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
                                }
                            ]
                        },
                        {
                            "id": "761390304",
                            "text": "下次别干了喔。"
                        }
                    ]
                }
            ]
        }
    ]
}