    "talks": [
        {
            "id": "45301",
            "objective": "与杜拉夫对话",
            "dialogues": [
                {
                    "id": "4530101",
                    "speaker": "杜拉夫",
                    "text": "唉，真是凄惨啊。 站都站不起来了。"
                },
                {
                    "id": "4530102",
                    "speaker": "安柏",
                    "text": "什么？！真是太可恶了！"
                },
                {
                    "id": "4530103",
                    "speaker": "派蒙",
                    "text": "可是……他没有受伤啊。"
                },
                {
                    "id": "4530104",
                    "speaker": "杜拉夫",
                    "text": "没错，太凄惨了。 他被吓得站不起来了。"
                },
                {
                    "id": "4530105",
                    "speaker": "安柏",
                    "text": "哦……那，那真是太凄惨了。"
                },
                {
                    "id": "4530106",
                    "speaker": "安柏",
                    "text": "刚才还有没有目击到什么有用的情报？"
                },
                {
                    "id": "4530107",
                    "speaker": "神奇的霍普金斯",
                    "text": "这，这还是我第一次见到狼，真是太吓人了…"
                },
                {
                    "id": "4530108",
                    "speaker": "安柏",
                    "text": "…看来是没有什么有用的目击情报了。"
                },
                {
                    "id": "4530109",
                    "speaker": "安柏",
                    "text": "还是再去调查一下现场的痕迹吧。"
                }
            ]
        },
        {
            "id": "45302",
            "objective": "调查线索",
            "dialogues": [
                {
                    "id": "4530201",
                    "speaker": "派蒙",
                    "text": "这爪印，看来狼不止两只！呃，而且居然大概有两米高！"
                }
            ]
        },
        {
            "id": "45307",
            "objective": "与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "4530701",
                    "speaker": "派蒙",
                    "text": "这个爪印——"
                },
                {
                    "id": "4530702",
                    "speaker": "派蒙",
                    "text": "通过爪印，可以推断出来狼的数量和大小。"
                },
                {
                    "id": "4530703",
                    "speaker": "派蒙",
                    "text": "数量不止两条，大小的话，这一匹大概有——"
                },
                {
                    "id": "4530704",
                    "speaker": "Player",
                    "text": "大概有？"
                },
                {
                    "id": "4530705",
                    "speaker": "派蒙",
                    "text": "…嗯，呃，大概有两米高！"
                },
                {
                    "id": "4530706",
                    "speaker": "Player",
                    "text": "…派蒙，你，见过狼吗？"
                },
                {
                    "id": "4530707",
                    "speaker": "派蒙",
                    "text": "狼很神秘的，一般哪有机会看到。"
                }
            ]
        },
        {
            "id": "45303",
            "objective": "调查线索",
            "dialogues": []
        },
        {
            "id": "45308",
            "objective": "与派蒙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "4530801",
                    "speaker": "派蒙",
                    "text": "这个是狼的牙齿。"
                },
                {
                    "id": "4530802",
                    "speaker": "派蒙",
                    "text": "好像是扑起来的时候，正好撞到了关上的门。"
                },
                {
                    "id": "4530803",
                    "speaker": "Player",
                    "text": "可能是有点缺钙。"
                },
                {
                    "id": "4530804",
                    "speaker": "派蒙",
                    "text": "总之这次袭击，没有村民受致命伤，真是万幸。"
                }
            ]
        },
        {
            "id": "45304",
            "objective": "调查线索",
            "dialogues": []
        },
        {
            "id": "45305",
            "objective": "重要线索$HIDDEN",
            "dialogues": [
                {
                    "id": "4530501",
                    "speaker": "安柏",
                    "text": "这是狼的毛发。 据说璃月人会拿这个制作毛笔。"
                },
                {
                    "id": "4530502",
                    "speaker": "安柏",
                    "text": "毛色和书上说的蒙德狼毛色出入很大。说不定真的是外来的狼？"
                },
                {
                    "id": "4530503",
                    "speaker": "派蒙",
                    "text": "狼身上有好几种毛发，颜色深浅都不同啦。"
                },
                {
                    "id": "4530504",
                    "speaker": "安柏",
                    "text": "不过，你看看这个——"
                },
                {
                    "id": "4530505",
                    "speaker": "派蒙",
                    "text": "这是另一撮毛，不过，上面沾了什么。",
                    "choices": [
                        {
                            "id": "4530506",
                            "text": "是种子。",
                            "response": [
                                {
                                    "id": "4530508",
                                    "speaker": "安柏",
                                    "text": "哼哼，这是钩钩果的种子。看到了吗，种子上的这种钩子。"
                                },
                                {
                                    "id": "4530509",
                                    "speaker": "安柏",
                                    "text": "蒙德境内，它只在奔狼领和明冠峡这种野地方才长。"
                                },
                                {
                                    "id": "4530510",
                                    "speaker": "派蒙",
                                    "text": "那…果然还是奔狼领的狼群咯？"
                                },
                                {
                                    "id": "4530511",
                                    "speaker": "安柏",
                                    "text": "嗯…同一地区，也可能会有多个狼群争夺领地的情况。"
                                },
                                {
                                    "id": "4530512",
                                    "speaker": "安柏",
                                    "text": "虽然不知道详情，但这也是个重要的线索，足够推进调查了。"
                                },
                                {
                                    "id": "4530513",
                                    "speaker": "安柏",
                                    "text": "在出发之前，我去安抚一下村民的情绪吧。"
                                }
                            ]
                        },
                        {
                            "id": "4530507",
                            "text": "有什么特殊的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "45306",
            "objective": "前往清泉镇，安抚众人情绪",
            "dialogues": [
                {
                    "id": "4530601",
                    "speaker": "神奇的霍普金斯",
                    "text": "你们调查找到什么结果了吗？"
                },
                {
                    "id": "4530602",
                    "speaker": "派蒙",
                    "text": "呜啊，你站起来了！"
                },
                {
                    "id": "4530603",
                    "speaker": "神奇的霍普金斯",
                    "text": "我缓过来了。甚至可以说，我从地狱里爬回来了。"
                },
                {
                    "id": "4530604",
                    "speaker": "神奇的霍普金斯",
                    "text": "所以骑士团调查有结果了吗？"
                },
                {
                    "id": "4530605",
                    "speaker": "安柏",
                    "text": "从残留的毛发里能看出来狼群生活在奔狼领。除此以外都不太明朗。"
                },
                {
                    "id": "4530606",
                    "speaker": "安柏",
                    "text": "不过请你们放心，我马上就去奔狼领把事件调查清楚。"
                },
                {
                    "id": "4530607",
                    "speaker": "安柏",
                    "text": "骑士团绝对不会放任这么危险的事情继续发生。"
                },
                {
                    "id": "4530608",
                    "speaker": "神奇的霍普金斯",
                    "text": "行吧。补救得晚了点，好过完全不作为。"
                },
                {
                    "id": "4530609",
                    "speaker": "派蒙",
                    "text": "哇，这个人好没礼貌。"
                },
                {
                    "id": "4530610",
                    "speaker": "神奇的霍普金斯",
                    "text": "我们现在就要去做该做的事情了。"
                },
                {
                    "id": "4530611",
                    "speaker": "安柏",
                    "text": "喂，不要做蠢事啊。"
                },
                {
                    "id": "4530612",
                    "speaker": "神奇的霍普金斯",
                    "text": "笑话，我们和骑士团不一样。这仇必须算清楚了。"
                },
                {
                    "id": "4530613",
                    "speaker": "神奇的霍普金斯",
                    "text": "我们走！"
                },
                {
                    "id": "4530614",
                    "speaker": "杜拉夫",
                    "text": "真是凄惨啊。"
                },
                {
                    "id": "4530615",
                    "speaker": "派蒙",
                    "text": "你在说什么？"
                },
                {
                    "id": "4530616",
                    "speaker": "杜拉夫",
                    "text": "说他们的未来。"
                },
                {
                    "id": "4530617",
                    "speaker": "Player",
                    "text": "我同意你的意见。"
                },
                {
                    "id": "4530618",
                    "speaker": "杜拉夫",
                    "text": "年轻人容易火气上头。劳烦各位再照顾一下吧，别让他们做蠢事。"
                },
                {
                    "id": "4530619",
                    "speaker": "安柏",
                    "text": "放心吧，这是我们职责所在——虽然这家伙真的很让人不爽。"
                },
                {
                    "id": "4530620",
                    "speaker": "安柏",
                    "text": "请交给我们吧。"
                },
                {
                    "id": "4530621",
                    "speaker": "派蒙",
                    "text": "那我们赶快去奔狼领吧！"
                }
            ]
        }
    ]
}