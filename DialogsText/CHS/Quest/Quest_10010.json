    },
    "talks": [
        {
            "id": "1001001",
            "objective": "前往西风骑士团总部",
            "dialogues": [
                {
                    "id": "100100101",
                    "speaker": "可莉",
                    "text": "嗯…嘟嘟可…"
                },
                {
                    "id": "100100102",
                    "speaker": "派蒙",
                    "text": "哎呀，可莉！"
                },
                {
                    "id": "100100103",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}！小派蒙！"
                },
                {
                    "id": "100100104",
                    "speaker": "可莉",
                    "text": "#妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，会和可莉一起帮助嘟嘟可，没想到这么快就来了！"
                },
                {
                    "id": "100100105",
                    "speaker": "派蒙",
                    "text": "帮助嘟嘟可？"
                },
                {
                    "id": "100100106",
                    "speaker": "派蒙",
                    "text": "…咦，「课题」，是这个吗？"
                },
                {
                    "id": "100100107",
                    "speaker": "可莉",
                    "text": "可莉不知道…但是可莉是可莉，不是可提？"
                },
                {
                    "id": "100100108",
                    "speaker": "派蒙",
                    "text": "啊，我没有念错可莉的名字啦，可莉是可莉，课题是…",
                    "choices": [
                        {
                            "id": "100100109",
                            "text": "课题是课题。",
                            "response": [
                                {
                                    "id": "100100110",
                                    "speaker": "可莉",
                                    "text": "？"
                                },
                                {
                                    "id": "100100111",
                                    "speaker": "派蒙",
                                    "text": "…唉，谢谢你没什么用的说明啦。"
                                },
                                {
                                    "id": "100100112",
                                    "speaker": "派蒙",
                                    "text": "嗯…课题就是，唔，好难直接解释哦。总之，课题就是，可莉想要做的，要帮助嘟嘟可完成的事！"
                                },
                                {
                                    "id": "100100119",
                                    "speaker": "可莉",
                                    "text": "哦！谢谢小派蒙，可莉虽然不明白，但好像又有点明白了。"
                                },
                                {
                                    "id": "100100120",
                                    "speaker": "可莉",
                                    "text": "那么我们这就出发吧，去帮助嘟嘟可…"
                                },
                                {
                                    "id": "100100121",
                                    "speaker": "派蒙",
                                    "text": "等等，所以可莉呀，你说要帮助嘟嘟可，具体是要做什么？"
                                },
                                {
                                    "id": "100100122",
                                    "speaker": "可莉",
                                    "text": "嗯，每一个嘟嘟可都要找到红色的四叶草，这样才能变成与众不同的嘟嘟可。"
                                },
                                {
                                    "id": "100100123",
                                    "speaker": "可莉",
                                    "text": "然后，然后嘟嘟可要与很多人成为朋友，经历「嘟嘟大魔王」的试炼，才能成为了不起的——"
                                },
                                {
                                    "id": "100100124",
                                    "speaker": "可莉",
                                    "text": "「嘟嘟大魔法师」！"
                                },
                                {
                                    "id": "100100125",
                                    "speaker": "可莉",
                                    "text": "…至少妈妈是这样说的。"
                                },
                                {
                                    "id": "100100126",
                                    "speaker": "派蒙",
                                    "text": "哇，「大魔王」管着「大魔法师」…听上去还挺合理的。"
                                },
                                {
                                    "id": "100100127",
                                    "speaker": "派蒙",
                                    "text": "那么我们具体要做什么呢？"
                                },
                                {
                                    "id": "100100128",
                                    "speaker": "可莉",
                                    "text": "可莉不知道。"
                                },
                                {
                                    "id": "100100129",
                                    "speaker": "可莉",
                                    "text": "#但是妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙会告诉可莉。"
                                },
                                {
                                    "id": "100100130",
                                    "speaker": "派蒙",
                                    "text": "对、对哦，可莉，看看这本书…"
                                },
                                {
                                    "id": "100100131",
                                    "speaker": "可莉",
                                    "text": "啊，里面夹着一张纸条。"
                                },
                                {
                                    "id": "100100132",
                                    "speaker": "派蒙",
                                    "text": "那就让我们一起来看看吧…"
                                },
                                {
                                    "id": "100100133",
                                    "speaker": "派蒙",
                                    "text": "「…试炼的第一站，嘟嘟可来到了树叶呢喃的森林，在那里，要找到埋藏的秘密，在重重的障碍之下…」"
                                },
                                {
                                    "id": "100100134",
                                    "speaker": "派蒙",
                                    "text": "听上去像是什么嘟嘟可故事的一部分呢…"
                                },
                                {
                                    "id": "100100135",
                                    "speaker": "可莉",
                                    "text": "啊，可莉知道在哪里了，一定是在可莉经常炸…经常与嘟嘟可玩耍的森林里！"
                                },
                                {
                                    "id": "100100136",
                                    "speaker": "可莉",
                                    "text": "#可莉，嘟嘟可，荣誉骑士{M#哥哥}{F#姐姐}，小派蒙，出发！"
                                },
                                {
                                    "id": "100100137",
                                    "speaker": "派蒙",
                                    "text": "好哦！出发！"
                                }
                            ]
                        },
                        {
                            "id": "100100113",
                            "text": "是要去做的事。",
                            "response": [
                                {
                                    "id": "100100114",
                                    "speaker": "派蒙",
                                    "text": "对，就是要完成的事。"
                                },
                                {
                                    "id": "100100115",
                                    "speaker": "可莉",
                                    "text": "哦，那…可莉用蹦蹦炸弹炸鱼也是「课题」？"
                                },
                                {
                                    "id": "100100116",
                                    "speaker": "派蒙",
                                    "text": "不，那应该不是吧，也不是所有的事都能被称之为「课题」啦！"
                                },
                                {
                                    "id": "100100117",
                                    "speaker": "可莉",
                                    "text": "可莉有点弄不明白了…"
                                },
                                {
                                    "id": "100100118",
                                    "speaker": "派蒙",
                                    "text": "唔，总之就是艾莉丝说的，要让可莉完成的事，就是「课题」！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1001003",
            "objective": "前往低语森林",
            "dialogues": [
                {
                    "id": "100100301",
                    "speaker": "派蒙",
                    "text": "这里、怎么，怎么有这么多奇怪的东西…还有好多丘丘人…"
                },
                {
                    "id": "100100302",
                    "speaker": "派蒙",
                    "text": "不如说，感觉就是丘丘人把这些奇怪的东西搬到这儿来的。"
                },
                {
                    "id": "100100303",
                    "speaker": "可莉",
                    "text": "唔，原来这就是试炼里的「丛丛障碍」！"
                },
                {
                    "id": "100100304",
                    "speaker": "派蒙",
                    "text": "虽然读得很相近，但其实是「重重障碍」啦。"
                },
                {
                    "id": "100100305",
                    "speaker": "派蒙",
                    "text": "不过，按照纸条的提示，我们要找的东西应该在这些「重重障碍」下面…有什么别的提示吗…"
                },
                {
                    "id": "100100306",
                    "speaker": "派蒙",
                    "text": "这个时候难道没有什么「嘟嘟可的指引」之类的东西？"
                },
                {
                    "id": "100100307",
                    "speaker": "可莉",
                    "text": "没有哦？"
                },
                {
                    "id": "100100308",
                    "speaker": "派蒙",
                    "text": "啊…那要怎么办？"
                },
                {
                    "id": "100100309",
                    "speaker": "可莉",
                    "text": "嗯…妈妈曾经说过，遇到困难就要解决困难！"
                },
                {
                    "id": "100100310",
                    "speaker": "Player",
                    "text": "那就让「重重障碍」消失吧。"
                },
                {
                    "id": "100100311",
                    "speaker": "可莉",
                    "text": "嗯！"
                }
            ]
        },
        {
            "id": "1001002",
            "objective": "前往低语森林",
            "dialogues": []
        },
        {
            "id": "1001004",
            "objective": "清理掉「丛丛障碍」",
            "dialogues": []
        },
        {
            "id": "1001005",
            "objective": "与可莉对话",
            "dialogues": [
                {
                    "id": "100100501",
                    "speaker": "派蒙",
                    "text": "好耶，全都清理掉了，不管是障碍还是丘丘人…"
                },
                {
                    "id": "100100502",
                    "speaker": "派蒙",
                    "text": "而且也没有引发大火什么的。"
                },
                {
                    "id": "100100503",
                    "speaker": "可莉",
                    "text": "可莉有好好控制蹦蹦炸弹！"
                },
                {
                    "id": "100100504",
                    "speaker": "可莉",
                    "text": "现在可莉进禁闭室的次数，已经越来越少啦！"
                },
                {
                    "id": "100100505",
                    "speaker": "派蒙",
                    "text": "可莉，了不起。"
                },
                {
                    "id": "100100506",
                    "speaker": "派蒙",
                    "text": "但是什么时候可莉能够不进禁闭室呢…"
                },
                {
                    "id": "100100507",
                    "speaker": "可莉",
                    "text": "要是琴团长同意可莉炸掉禁闭室的话…"
                },
                {
                    "id": "100100508",
                    "speaker": "派蒙",
                    "text": "不是在说用这种方法实现啦！啊对了，嘟嘟可的试炼呢？"
                },
                {
                    "id": "100100509",
                    "speaker": "可莉",
                    "text": "啊，可莉拿到了，就在刚才蹦蹦炸弹炸出的土坑里…"
                },
                {
                    "id": "100100510",
                    "speaker": "派蒙",
                    "text": "是新的纸条呢。"
                },
                {
                    "id": "100100511",
                    "speaker": "可莉",
                    "text": "嗯，上面的是妈妈写的字…"
                },
                {
                    "id": "100100512",
                    "speaker": "派蒙",
                    "text": "「嘟嘟可有没有把所有的障碍炸飞呢，有的时候直接才是最具有美学的做法呢。然后，嘟嘟可到了试炼的第二站…」"
                },
                {
                    "id": "100100513",
                    "speaker": "派蒙",
                    "text": "「其实也就是最后一站，即使是再有活力的孩子，也要好好控制每日活动的时间，那么…」"
                },
                {
                    "id": "100100514",
                    "speaker": "派蒙",
                    "text": "「在星星坠入的湖水之畔，嘟嘟可经过了试炼，得到了最终的褒奖，但是事情真的会如此简单吗…」"
                },
                {
                    "id": "100100515",
                    "speaker": "派蒙",
                    "text": "说起星星和湖的话，那就是星落湖了吧。"
                },
                {
                    "id": "100100516",
                    "speaker": "派蒙",
                    "text": "那我们就去湖边看看吧…"
                },
                {
                    "id": "100100517",
                    "speaker": "可莉",
                    "text": "好！"
                },
                {
                    "id": "100100518",
                    "speaker": "派蒙",
                    "text": "真好奇这个最终的褒奖是什么，说不定是了不起的宝藏呢！"
                }
            ]
        },
        {
            "id": "1001006",
            "objective": "前往星落湖",
            "dialogues": [
                {
                    "id": "100100601",
                    "speaker": "可莉",
                    "text": "啊，是一个了不起的箱子。"
                },
                {
                    "id": "100100602",
                    "speaker": "派蒙",
                    "text": "看来最终的宝藏就藏在这个了不起的箱子里…"
                },
                {
                    "id": "100100603",
                    "speaker": "Player",
                    "text": "可莉，打开箱子吧…"
                },
                {
                    "id": "100100604",
                    "speaker": "可莉",
                    "text": "嗯嗯，可莉就和嘟嘟可一起…"
                },
                {
                    "id": "100100605",
                    "speaker": "派蒙",
                    "text": "咦，等等，周围怎么突然聚集了一堆怪物。"
                },
                {
                    "id": "100100606",
                    "speaker": "Player",
                    "text": "看来并没有那么简单呢…"
                },
                {
                    "id": "100100607",
                    "speaker": "可莉",
                    "text": "哼哼，肯定是看到嘟嘟可找到了通过试炼得到的宝藏，那些坏家伙要来抢！"
                },
                {
                    "id": "100100608",
                    "speaker": "可莉",
                    "text": "那我们就先把那些坏家伙赶跑，再打开箱子吧！"
                }
            ]
        },
        {
            "id": "1001009",
            "objective": "前往星落湖",
            "dialogues": []
        },
        {
            "id": "1001007",
            "objective": "守护嘟嘟可的宝藏",
            "dialogues": []
        },
        {
            "id": "1001008",
            "objective": "与可莉对话",
            "dialogues": [
                {
                    "id": "100100801",
                    "speaker": "派蒙",
                    "text": "终于把那些家伙赶跑了…"
                },
                {
                    "id": "100100802",
                    "speaker": "派蒙",
                    "text": "仔细一想，之前的纸条上写的「事情不会如此简单」…其实就是指会有魔物跑过来吧。"
                },
                {
                    "id": "100100803",
                    "speaker": "可莉",
                    "text": "嗯！嘟嘟可试炼大成功！"
                },
                {
                    "id": "100100804",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那现在试炼结束了，我们看看箱子里的是什么…"
                },
                {
                    "id": "100100805",
                    "speaker": "可莉",
                    "text": "啊，这个是…"
                },
                {
                    "id": "100100806",
                    "speaker": "派蒙",
                    "text": "是一顶小小的帽子？"
                },
                {
                    "id": "100100807",
                    "speaker": "可莉",
                    "text": "是给嘟嘟可的帽子！"
                },
                {
                    "id": "100100808",
                    "speaker": "可莉",
                    "text": "在嘟嘟一族之中，只有更加特别，更加了不起的嘟嘟可，才能被「嘟嘟大魔王」承认！"
                },
                {
                    "id": "100100809",
                    "speaker": "可莉",
                    "text": "这些了不起的嘟嘟可肩负着帮助和保护别的嘟嘟可的职责，所以「嘟嘟大魔王」赐予他们特殊的帽子。"
                },
                {
                    "id": "100100810",
                    "speaker": "可莉",
                    "text": "这样，别的嘟嘟可就能认出他们，然后遇到没办法解决的困难，就找到他们寻求帮助。"
                },
                {
                    "id": "100100811",
                    "speaker": "派蒙",
                    "text": "哦，那嘟嘟可就会变成戴帽子的嘟嘟可啦！"
                },
                {
                    "id": "100100812",
                    "speaker": "可莉",
                    "text": "嗯！成为戴帽子的嘟嘟可就是「嘟嘟大魔法师」…就能用大魔法师的火花力量帮助更多的人了！"
                },
                {
                    "id": "100100813",
                    "speaker": "琴",
                    "text": "可莉——"
                },
                {
                    "id": "100100814",
                    "speaker": "琴",
                    "text": "骑士团的人说，城外的森林里又传来了特别大的爆炸声…"
                },
                {
                    "id": "100100815",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}，小派蒙，现在是可莉需要帮助…"
                },
                {
                    "id": "100100816",
                    "speaker": "派蒙",
                    "text": "啊，我可以作证，我们和可莉一起清除了聚集的丘丘人，还有史莱姆，而且我们是为了完成「课题」才来的。"
                },
                {
                    "id": "100100817",
                    "speaker": "可莉",
                    "text": "小派蒙说得一点没错。"
                },
                {
                    "id": "100100818",
                    "speaker": "琴",
                    "text": "那这里的鱼…"
                },
                {
                    "id": "100100819",
                    "speaker": "可莉",
                    "text": "那是刚才对付湖上的坏家伙的时候，可莉不小心炸到的…跟以前可不一样…"
                },
                {
                    "id": "100100820",
                    "speaker": "琴",
                    "text": "也就是说，以前都是故意炸的？"
                },
                {
                    "id": "100100821",
                    "speaker": "可莉",
                    "text": "可莉因为以前炸的鱼无话可说。"
                },
                {
                    "id": "100100822",
                    "speaker": "琴",
                    "text": "…唉，我来的路上已经看到了，被摧毁的魔物营地，以及刚才从星落湖边上跑走的魔物。"
                },
                {
                    "id": "100100823",
                    "speaker": "琴",
                    "text": "#没有造成其他的破坏吧，{NICKNAME}？",
                    "choices": [
                        {
                            "id": "100100824",
                            "text": "其他的破坏都是派蒙造成的。",
                            "response": [
                                {
                                    "id": "100100825",
                                    "speaker": "派蒙",
                                    "text": "…对对，都是我一口气吹出来的，我了不起。"
                                },
                                {
                                    "id": "100100827",
                                    "speaker": "琴",
                                    "text": "可莉。"
                                },
                                {
                                    "id": "100100828",
                                    "speaker": "琴",
                                    "text": "走吧，我们回去。"
                                },
                                {
                                    "id": "100100829",
                                    "speaker": "可莉",
                                    "text": "呜，又要进禁闭室了嘛？"
                                },
                                {
                                    "id": "100100830",
                                    "speaker": "琴",
                                    "text": "#这次因为有{NICKNAME}为你作担保，所以就罚你…跟我去猎鹿人好好吃一顿吧！"
                                },
                                {
                                    "id": "100100831",
                                    "speaker": "琴",
                                    "text": "跑出来折腾那么久，应该也饿了吧。"
                                },
                                {
                                    "id": "100100832",
                                    "speaker": "可莉",
                                    "text": "今天是好人琴团长！"
                                },
                                {
                                    "id": "100100833",
                                    "speaker": "琴",
                                    "text": "#{NICKNAME}和派蒙也一起来吧。"
                                },
                                {
                                    "id": "100100834",
