    "talks": [
        {
            "id": "7566201",
            "objective": "(test)隐藏环对话$HIDDEN",
            "dialogues": [
                {
                    "id": "756620101",
                    "speaker": "基尼奇",
                    "text": "有信使告诉我，战备联络官找到了强大的试炼检验人。"
                },
                {
                    "id": "756620102",
                    "speaker": "基尼奇",
                    "text": "确认是你，我就放心了。"
                },
                {
                    "id": "756620103",
                    "speaker": "阿乔",
                    "text": "嘁，怎么连这家伙都找上了？基尼奇，你这朋友跟你一副德行，是份委托就会接啊。"
                },
                {
                    "id": "756620104",
                    "speaker": "基尼奇",
                    "text": "链接器来提示了。我收到了一份让聒噪的龙闭嘴的委托。",
                    "choices": [
                        {
                            "id": "756620105",
                            "text": "我刚发布的。",
                            "response": [
                                {
                                    "id": "756620106",
                                    "speaker": "阿乔",
                                    "text": "你…你们…好哇，竟敢合起伙来捉弄我伟大圣龙…你们会付出代价的！"
                                },
                                {
                                    "id": "756620109",
                                    "speaker": "基尼奇",
                                    "text": "#言归正传吧，{NICKNAME}，这次要有劳你检验这几个关卡了。难度和平衡性应当不会让你失望。"
                                },
                                {
                                    "id": "756620110",
                                    "speaker": "阿乔",
                                    "text": "难度？我是没看出有半点难度。"
                                },
                                {
                                    "id": "756620111",
                                    "speaker": "基尼奇",
                                    "text": "「让他们随机抽选笨蛋伙伴，蒙上脑袋体验山崖速降去。」这是你对难度的理解和诠释？"
                                },
                                {
                                    "id": "756620112",
                                    "speaker": "基尼奇",
                                    "text": "况且，抽选的伙伴里只有一成概率是匿叶龙，剩下的全是熔岩游像和岩史莱姆。",
                                    "choices": [
                                        {
                                            "id": "756620113",
                                            "text": "这是玩命啊。",
                                            "response": [
                                                {
                                                    "id": "756620114",
                                                    "speaker": "阿乔",
                                                    "text": "呵，你还不知道「悬木人」爱玩的是什么吗？你跟我的小小仆从认识也有一段时间了，我这建议可是量身定制。"
                                                },
                                                {
                                                    "id": "756620115",
                                                    "speaker": "基尼奇",
                                                    "text": "那你怎么不亲自示范？"
                                                },
                                                {
                                                    "id": "756620120",
                                                    "speaker": "阿乔",
                                                    "text": "…参加这种小打小闹的挑战，简直有辱我伟大圣龙的尊严。你们爱怎么玩就怎么玩吧。"
                                                },
                                                {
                                                    "id": "756620121",
                                                    "speaker": "基尼奇",
                                                    "text": "总之，伊拉德给我开的价码非常不错，希望你既能在挑战中收获乐趣，也能得到满意的报酬。",
                                                    "choices": [
                                                        {
                                                            "id": "756620122",
                                                            "text": "非常期待！",
                                                            "response": [
                                                                {
                                                                    "id": "756620124",
                                                                    "speaker": "基尼奇",
                                                                    "text": "一切顺利。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756620123",
                                                            "text": "交给我吧！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756620116",
                                            "text": "好像还挺有劲的…",
                                            "response": [
                                                {
                                                    "id": "756620117",
                                                    "speaker": "阿乔",
                                                    "text": "你看看，你听听？人家的眼力、见识和思维样样都比你这家伙好！"
                                                },
                                                {
                                                    "id": "756620118",
                                                    "speaker": "Player",
                                                    "text": "但我想看阿乔先做榜样。"
                                                },
                                                {
                                                    "id": "756620119",
                                                    "speaker": "基尼奇",
                                                    "text": "支持。阿乔身形袖珍，一定远比挑战者灵活。即使不巧被魔物揍了一击，也不会径直砸进地里，摔出一个坑洞吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756620107",
                            "text": "没关系，可以晚点再完成那份。",
                            "response": [
                                {
                                    "id": "756620108",
                                    "speaker": "阿乔",
                                    "text": "哼…别以为你帮伟大圣龙说了句好话，我就会对你感恩戴德！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}