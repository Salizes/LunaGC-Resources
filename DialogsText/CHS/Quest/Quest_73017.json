        }
    },
    "talks": [
        {
            "id": "7301701",
            "objective": "前往梦景林莽寻找兰贡迪",
            "dialogues": []
        },
        {
            "id": "7301713",
            "objective": "在指定地点弹奏「大梦的曲调」以引出兰那罗",
            "dialogues": []
        },
        {
            "id": "7301702",
            "objective": "与兰贡迪对话",
            "dialogues": [
                {
                    "id": "730170201",
                    "speaker": "派蒙",
                    "text": "哦！可算找到你啦！你就是兰贡迪吧！"
                },
                {
                    "id": "730170202",
                    "speaker": "兰贡迪",
                    "text": "我可以不是。"
                },
                {
                    "id": "730170203",
                    "speaker": "派蒙",
                    "text": "嗯？这是什么意思？"
                },
                {
                    "id": "730170204",
                    "speaker": "兰贡迪",
                    "text": "因为我可以是树，可以是雨，可以是桓那的梦，也可以是乐器的弦。"
                },
                {
                    "id": "730170205",
                    "speaker": "派蒙",
                    "text": "哦…"
                },
                {
                    "id": "730170206",
                    "speaker": "派蒙",
                    "text": "#完全没听懂他在说什么呢！{NICKNAME}，你知道他在说什么吗？",
                    "choices": [
                        {
                            "id": "730170207",
                            "text": "我也没听懂。",
                            "response": [
                                {
                                    "id": "730170208",
                                    "speaker": "派蒙",
                                    "text": "感觉每个字都知道是什么意思，但是连成句子就听不懂了…"
                                },
                                {
                                    "id": "730170213",
                                    "speaker": "兰贡迪",
                                    "text": "金色的那菈，和会飞的小东西，为什么要找兰贡迪？"
                                },
                                {
                                    "id": "730170214",
                                    "speaker": "派蒙",
                                    "text": "我不是什么「会飞的小东西」啦！等等，我好像确实是…？哎！总之，我叫派蒙！"
                                },
                                {
                                    "id": "730170215",
                                    "speaker": "派蒙",
                                    "text": "#「金色的那菈」也有自己的名字，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}叫{NICKNAME}。"
                                },
                                {
                                    "id": "730170216",
                                    "speaker": "派蒙",
                                    "text": "是兰般度告诉我们的，说兰贡迪在梦景林莽，让我们来看看情况。"
                                },
                                {
                                    "id": "730170217",
                                    "speaker": "兰贡迪",
                                    "text": "派蒙可以告诉兰般度，兰贡迪很好，梦景林莽很好，潮湿的梦也很好。"
                                },
                                {
                                    "id": "730170218",
                                    "speaker": "派蒙",
                                    "text": "#好哦…{NICKNAME}，那我们回去找兰般度吧。"
                                },
                                {
                                    "id": "730170219",
                                    "speaker": "派蒙",
                                    "text": "…才不是啦！我们是来治好法留纳神机的！好险，差点被牵着鼻子走了…"
                                },
                                {
                                    "id": "730170220",
                                    "speaker": "兰贡迪",
                                    "text": "派蒙可以告诉兰般度，兰贡迪不想牵派蒙的鼻子。"
                                },
                                {
                                    "id": "730170221",
                                    "speaker": "Player",
                                    "text": "兰般度可能不想知道这个。"
                                },
                                {
                                    "id": "730170222",
                                    "speaker": "派蒙",
                                    "text": "我也不想知道啦！这个兰那罗到底是怎么回事嘛！"
                                },
                                {
                                    "id": "730170223",
                                    "speaker": "Player",
                                    "text": "记得兰般度说过…"
                                },
                                {
                                    "id": "730170224",
                                    "speaker": "派蒙",
                                    "text": "兰般度提到兰贡迪的时候说，「他和那菈更疏远」…意思是，他不知道怎么和人交流吗？"
                                },
                                {
                                    "id": "730170225",
                                    "speaker": "Player",
                                    "text": "是我们不知道怎么和兰那罗交流。"
                                },
                                {
                                    "id": "730170226",
                                    "speaker": "派蒙",
                                    "text": "啊！说的也是，「入乡随俗」，应该是我们学习他们的交流方式才对？"
                                },
                                {
                                    "id": "730170227",
                                    "speaker": "派蒙",
                                    "text": "不过，事到如今仔细想想，兰那罗的交流方式到底是什么样的呢？",
                                    "choices": [
                                        {
                                            "id": "730170228",
                                            "text": "会飞的小东西觉得呢？",
                                            "response": [
                                                {
                                                    "id": "730170229",
                                                    "speaker": "派蒙",
                                                    "text": "金色的那菈都不知道，会飞的小东西怎么会知道呢？不如我们来问问神奇的兰贡迪吧！"
                                                },
                                                {
                                                    "id": "730170233",
                                                    "speaker": "派蒙",
                                                    "text": "兰贡迪可不可以告诉我们，兰那罗之间到底是怎么交流的呢？我们也想认真学习一下！"
                                                },
                                                {
                                                    "id": "730170234",
                                                    "speaker": "兰贡迪",
                                                    "text": "为什么要学？那菈是那菈，派蒙是派蒙，兰那罗是兰那罗。"
                                                },
                                                {
                                                    "id": "730170235",
                                                    "speaker": "兰贡迪",
                                                    "text": "…啊，知道了，派蒙也想变成种子埋进土里？"
                                                },
                                                {
                                                    "id": "730170236",
                                                    "speaker": "派蒙",
                                                    "text": "不想！一点也不想！"
                                                },
                                                {
                                                    "id": "730170237",
                                                    "speaker": "兰贡迪",
                                                    "text": "那金色的那菈想要变成种子吗？",
                                                    "choices": [
                                                        {
                                                            "id": "730170238",
                                                            "text": "谢谢，不用了。",
                                                            "response": [
                                                                {
                                                                    "id": "730170239",
                                                                    "speaker": "兰贡迪",
                                                                    "text": "种子很好，可惜。"
                                                                },
                                                                {
                                                                    "id": "730170242",
                                                                    "speaker": "派蒙",
                                                                    "text": "扯了半天都快忘记我们来这儿的目的了，是无忧节！"
                                                                },
                                                                {
                                                                    "id": "730170243",
                                                                    "speaker": "派蒙",
                                                                    "text": "为了无忧节，我们得把法留纳神机治好，这样天气就会恢复正常了，也不会有那些讨人厌的孢子。"
                                                                },
                                                                {
                                                                    "id": "730170244",
                                                                    "speaker": "兰贡迪",
                                                                    "text": "派蒙说得对，为了无忧节，为了蔚蓝大地的中心。"
                                                                },
                                                                {
                                                                    "id": "730170245",
                                                                    "speaker": "兰贡迪",
                                                                    "text": "湿气氤氲的梦景林莽很好，但是「孢子」不好，会跑的蘑菇也不好，雨太多了，蘑菇也变得难煮。"
                                                                },
                                                                {
                                                                    "id": "730170246",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦！你这不是很明白嘛！"
                                                                },
                                                                {
                                                                    "id": "730170247",
                                                                    "speaker": "兰贡迪",
                                                                    "text": "#我们去治好法留纳神机，那菈{NICKNAME}和派蒙跟兰贡迪走。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730170240",
                                                            "text": "如果可以的话，好呀。",
                                                            "response": [
                                                                {
                                                                    "id": "730170241",
                                                                    "speaker": "派蒙",
                                                                    "text": "别信口胡说呀，他会当真的！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730170230",
                                            "text": "总之先试试比喻？",
                                            "response": [
                                                {
                                                    "id": "730170231",
                                                    "speaker": "派蒙",
                                                    "text": "那我试试！金色的那菈，就像…就像…唔…就像提瓦特煎蛋一样？"
                                                },
                                                {
                                                    "id": "730170232",
                                                    "speaker": "派蒙",
                                                    "text": "…我们还是问问兰贡迪吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730170209",
                            "text": "大概能猜到。",
                            "response": [
                                {
                                    "id": "730170210",
                                    "speaker": "派蒙",
                                    "text": "太厉害了！那么他的话到底是什么意思呢？"
                                },
                                {
                                    "id": "730170211",
                                    "speaker": "Player",
                                    "text": "他说他可以变形成很多其他的东西。"
                                },
                                {
                                    "id": "730170212",
                                    "speaker": "派蒙",
                                    "text": "#真的吗？{NICKNAME}可不要骗我…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301703",
            "objective": "和兰贡迪一起找到「枝」",
            "dialogues": []
        },
        {
            "id": "7301704",
            "objective": "和兰贡迪一起找到「枝」",
            "dialogues": [
                {
                    "id": "730170401",
                    "speaker": "兰贡迪",
                    "text": "大树的根，很好，可以听到潮湿的呼吸，是昏昏欲睡的曲调。"
                },
                {
                    "id": "730170402",
                    "speaker": "派蒙",
                    "text": "哦…还是没听懂兰贡迪在说什么，不过算了！"
                },
                {
                    "id": "730170403",
                    "speaker": "派蒙",
                    "text": "说起来，里面居然有这么大的空间，这就叫「盘根错节」吗？而且，总觉得这里的氛围和其他地方很不一样呢。"
                },
                {
                    "id": "730170404",
                    "speaker": "派蒙",
                    "text": "要在这种地方找到给法留纳神机输送能量的「叶」吗…"
                },
                {
                    "id": "730170405",
                    "speaker": "兰贡迪",
                    "text": "在这里，但是又不在。听得到它的声音，闻得到它的气息，看得到它的脉络，但是派蒙找不到它。"
                },
                {
                    "id": "730170406",
                    "speaker": "派蒙",
                    "text": "啊？那是怎么回事…"
                },
                {
                    "id": "730170407",
                    "speaker": "Player",
                    "text": "派蒙找不到，那我呢？"
                },
                {
                    "id": "730170408",
                    "speaker": "兰贡迪",
                    "text": "金色的那菈，看得到旋律，像夜晚的凉风，倏忽而至的雨，破碎湖面一千片的梦。"
                },
                {
                    "id": "730170409",
                    "speaker": "Player",
                    "text": "听起来很厉害的样子。"
                },
                {
                    "id": "730170410",
                    "speaker": "派蒙",
                    "text": "#不愧是{NICKNAME}！"
                },
                {
                    "id": "730170411",
                    "speaker": "Player",
                    "text": "嘿嘿。"
                },
                {
                    "id": "730170412",
                    "speaker": "派蒙",
                    "text": "#嘿嘿…不对啦！{NICKNAME}这不是在抢我的词吗！"
                },
                {
                    "id": "730170413",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}变成派蒙…比在无留陀和蘑菇一起跳舞更可怕…"
                },
                {
                    "id": "730170414",
                    "speaker": "Player",
                    "text": "无法想象…"
                },
                {
                    "id": "730170415",
                    "speaker": "派蒙",
                    "text": "所以说这种事情是不会发生的啦！最好是不要发生…"
                },
                {
                    "id": "730170416",
                    "speaker": "派蒙",
                    "text": "兰贡迪也是，就不能说得明白点吗？我们到底要去哪里找法留纳神机的「叶」呢？"
                },
                {
                    "id": "730170417",
                    "speaker": "兰贡迪",
                    "text": "在梦里找。"
                },
                {
                    "id": "730170418",
                    "speaker": "派蒙",
                    "text": "哦…等等，那你为什么不一开始就这么说呢？"
                },
                {
                    "id": "730170419",
                    "speaker": "兰贡迪",
                    "text": "因为派蒙问为什么，没有问在哪里。"
                },
                {
                    "id": "730170420",
                    "speaker": "派蒙",
                    "text": "欸…我好像突然明白兰那罗的交流方式了！"
                },
                {
                    "id": "730170421",
                    "speaker": "派蒙",
                    "text": "兰贡迪可不可以告诉我们要找的三个「叶」分别具体在哪里呢？"
                },
                {
                    "id": "730170422",
                    "speaker": "兰贡迪",
                    "text": "可以呀。"
                },
                {
                    "id": "730170423",
                    "speaker": "派蒙",
                    "text": "哇，兰贡迪是真的只会回答被直接问到的问题…好吧，那这三个地方具体在哪里呢？"
                },
                {
                    "id": "730170424",
                    "speaker": "兰贡迪",
                    "text": "在这边、那边和另一边。"
                },
                {
                    "id": "730170425",
                    "speaker": "派蒙",
                    "text": "嗯嗯…不是，你这不是什么也没说吗！"
                },
                {
                    "id": "730170426",
                    "speaker": "Player",
                    "text": "派蒙大失败。"
                },
                {
                    "id": "730170427",
                    "speaker": "派蒙",
                    "text": "#派蒙大失败和{NICKNAME}大失败是一回事啦！兰贡迪的话根本没法参考嘛…我们该怎么找到那三个地方呢…"
                },
                {
                    "id": "730170428",
                    "speaker": "兰贡迪",
                    "text": "法留纳神机是最了不起的兰那罗造的，「枝」和「叶」的联系，看不见，又看得见。"
                },
                {
                    "id": "730170429",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}看得见兰那罗，看得见兰那罗的痕迹，就能找到方向。"
                },
                {
                    "id": "730170430",
                    "speaker": "派蒙",
                    "text": "我、我居然听懂了！"
                },
                {
                    "id": "730170431",
                    "speaker": "Player",
                    "text": "跟着兰那罗的痕迹就能找到，对吧？"
                },
                {
                    "id": "730170432",
                    "speaker": "派蒙",
                    "text": "呜呜…至少把这次回答的机会让给我嘛！"
                }
            ]
        },
        {
            "id": "7301715",
            "objective": "在「修梨薜那」前，弹奏「大梦的曲调」",
            "dialogues": []
        },
        {
            "id": "7301710",
            "objective": "让梦境中的三个「叶」都朝向「枝」的方向",
            "dialogues": [
                {
                    "id": "730171001",
                    "speaker": "兰贡迪",
                    "text": "潮湿的梦，干燥的梦…叮咚，嘀嗒，沙沙，是桓那的曲子…"
                },
                {
                    "id": "730171002",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}？「叶」在梦里，「枝」在这里。"
                }
            ]
        },
        {
            "id": "7301716",
            "objective": "在「修梨薜那」前，弹奏「大梦的曲调」",
            "dialogues": []
        },
        {
            "id": "7301712",
            "objective": "与兰贡迪对话",
            "dialogues": [
                {
                    "id": "730171201",
                    "speaker": "派蒙",
                    "text": "我们回来啦！"
                },
                {
                    "id": "730171202",
                    "speaker": "兰贡迪",
                    "text": "听到了，呜咽变成了婉转的曲调，但是要汇入声音的大流还需要…"
                },
                {
                    "id": "730171203",
                    "speaker": "派蒙",
                    "text": "还需要兰贡迪帮忙！嘿嘿，接下来就拜托你啦！"
                },
                {
                    "id": "730171204",
                    "speaker": "兰贡迪",
                    "text": "兰贡迪知道。"
                },
                {
                    "id": "730171205",
                    "speaker": "派蒙",
                    "text": "哦！这样应该没问题了吧！希望能快点治好法留纳神机，不然水天丛林那边全是孢子…光是想想就…阿嚏——呜…"
                },
                {
                    "id": "730171206",
                    "speaker": "派蒙",
                    "text": "真不敢相信兰那罗居然对孢子没什么反应…难道兰那罗都不会受影响吗？"
                },
                {
                    "id": "730171207",
                    "speaker": "兰贡迪",
                    "text": "兰那罗会煮蘑菇，不是没事。「孢子」，太小太多，抓不到。"
                },
                {
                    "id": "730171208",
                    "speaker": "兰贡迪",
                    "text": "法留纳神机没有坏的时候，桓那没有这么多蘑菇，所以治好法留纳神机，都会变好。除了无留陀。"
                },
                {
                    "id": "730171209",
                    "speaker": "Player",
                    "text": "一定会变好的。"
                },
                {
                    "id": "730171210",
                    "speaker": "派蒙",
                    "text": "#对呀，我和{NICKNAME}也会帮忙的！"
                },
                {
                    "id": "730171211",
                    "speaker": "Player",
                    "text": "无留陀也会有办法解决的。"
                },
                {
                    "id": "730171212",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}是那菈法留纳吗？"
                },
                {
                    "id": "730171213",
                    "speaker": "派蒙",
                    "text": "欸？为什么突然这样问？"
                },
                {
                    "id": "730171214",
                    "speaker": "兰贡迪",
                    "text": "兰般度说，那菈法留纳是金色的、勇敢的那菈，和兰那罗一起治好了法留纳神机，赶走了黑色的雨和泥，带回了月亮和太阳。"
                },
                {
                    "id": "730171215",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}也帮兰那罗治法留纳神机，也是金色的、勇敢的那菈，不是吗？"
                },
                {
                    "id": "730171216",
                    "speaker": "派蒙",
                    "text": "可是，那菈法留纳不是很早以前的人吗…"
                },
                {
                    "id": "730171217",
                    "speaker": "兰贡迪",
