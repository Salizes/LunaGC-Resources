        "rewards_formatted": "冒险阅历 x250, 原石 x30, 摩拉 x30000, 大英雄的经验 x3",
        "chapter": {
            "icon": "UI_ChapterIcon_Sumeru",
            "id": "10072",
            "num": "",
            "title": "水天供书"
        },
        "total_dialogue_lines": 110,
        "total_speaker_counts": {
            "Player": 22,
