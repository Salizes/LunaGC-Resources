    "talks": [
        {
            "id": "7011101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701110101",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "贵殿，暂请留步。"
                },
                {
                    "id": "701110102",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "省去委细之事，某有一事相求。先日，璃月的虞黄衣殿下曾向某寄送一件稀代的珍品，然至今未达…"
                },
                {
                    "id": "701110103",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "某怀疑其为此地守护者所掠取。若贵殿见到虞黄衣殿下所说的「珍品」，可否为某取回？届时，某必将奉上相应的报谢。"
                }
            ]
        },
        {
            "id": "7011102",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701110201",
                    "speaker": "派蒙",
                    "text": "我们回来啦！你看看，这个是不是你说的「珍品」？"
                },
                {
                    "id": "701110202",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "哦哦，感激不尽，感激不尽！多谢两位相助！"
                },
                {
                    "id": "701110203",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "那么，事不宜迟，某这便启封——"
                },
                {
                    "id": "701110204",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "这、这是…！"
                },
                {
                    "id": "701110205",
                    "speaker": "派蒙",
                    "text": "呜哇！这东西是不是快要炸了？！"
                },
                {
                    "id": "701110206",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "虞黄衣殿下不会害某…莫非是被守护者所寻获，改造成了所谓的「爆弹」吗？！"
                },
                {
                    "id": "701110207",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "实是耻辱，但某对如何拆解「爆弹」一窍不通…无计可施，只好把它丢出去了！"
                },
                {
                    "id": "701110208",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "不必担心！某还记得，有位从「亥珀波瑞亚」来的殿下好像说过，应当如何丢出神圣的「爆弹」！"
                },
                {
                    "id": "701110209",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "「汝当数到三，不可多，也不可少；汝既不可数四，也不可数二，五是数多了。当汝数到的数是三——」"
                },
                {
                    "id": "701110210",
                    "speaker": "派蒙",
                    "text": "废话太多啦！再不扔就真的要炸啦！"
                }
            ]
        },
        {
            "id": "7011104",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7011103",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701110301",
                    "speaker": "派蒙",
                    "text": "什么嘛，虚惊一场，搞了半天原来就只是烟花而已…"
                },
                {
                    "id": "701110302",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "何、何等绚烂…某追随御建鸣神主尊大御所大人征战时，还从未见过这般夺目的火之花…"
                },
                {
                    "id": "701110303",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "原来如此，这便是虞黄衣殿下让某观赏的奇景么…恐悦至极，恐悦至极…"
                },
                {
                    "id": "701110304",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "「漆夜如乌玉，夜半云居绽明花，身似水间沫；须臾一刹终归寂，星离雨散落片空…」嗟乎，何等风雅…"
                },
                {
                    "id": "701110305",
                    "speaker": "派蒙",
                    "text": "虽然不知道你到底在风雅些什么啦…总之没事就好！"
                }
            ]
        }
    ]
}