    "talks": [
        {
            "id": "7269701",
            "objective": "前往离岛，寻找伯特兰",
            "dialogues": [
                {
                    "id": "726970101",
                    "speaker": "伯特兰",
                    "text": "#嘿嘿，{NICKNAME}，派蒙，你们来了！"
                },
                {
                    "id": "726970102",
                    "speaker": "伯特兰",
                    "text": "我的玩具城就要开业了！"
                },
                {
                    "id": "726970103",
                    "speaker": "派蒙",
                    "text": "玩具城？"
                },
                {
                    "id": "726970104",
                    "speaker": "伯特兰",
                    "text": "咳咳，当然了，说是玩具城，实际上也只有我和我的「大工机」啦。"
                },
                {
                    "id": "726970105",
                    "speaker": "伯特兰",
                    "text": "我改良了一下工序，现在没必要那么等待那么长时间才能完成制造。"
                },
                {
                    "id": "726970106",
                    "speaker": "伯特兰",
                    "text": "虽然称不上是「瞬间完成」，但也好歹也可以说是「立等可取」。"
                },
                {
                    "id": "726970107",
                    "speaker": "派蒙",
                    "text": "哇，听上去很了不起的样子。"
                },
                {
                    "id": "726970108",
                    "speaker": "伯特兰",
                    "text": "还有这个，我改良了「素材收集器」。"
                },
                {
                    "id": "726970109",
                    "speaker": "伯特兰",
                    "text": "之前不是必须完成一个工序以后回来一趟嘛。"
                },
                {
                    "id": "726970110",
                    "speaker": "伯特兰",
                    "text": "那之后我就觉得效率有点低，就做了调整，现在它会根据收集的状况更新当前的工序内容了。"
                },
                {
                    "id": "726970111",
                    "speaker": "派蒙",
                    "text": "根据收集状况…"
                },
                {
                    "id": "726970112",
                    "speaker": "派蒙",
                    "text": "调节工序内容？"
                },
                {
                    "id": "726970113",
                    "speaker": "Player",
                    "text": "听不明白…"
                },
                {
                    "id": "726970114",
                    "speaker": "伯特兰",
                    "text": "哎，该怎么跟你们解释呢？"
                },
                {
                    "id": "726970115",
                    "speaker": "伯特兰",
                    "text": "比如我在第一道工序需要十个日落果，第二道工序需要水元素，第三道工序需要击败两只水史莱姆。"
                },
                {
                    "id": "726970116",
                    "speaker": "伯特兰",
                    "text": "现在你带着「素材收集器」，收集了十个日落果，那么它就会判定第一道工序所需材料已全部收集完毕。"
                },
                {
                    "id": "726970117",
                    "speaker": "伯特兰",
                    "text": "然后它就会…"
                },
                {
                    "id": "726970118",
                    "speaker": "派蒙",
                    "text": "我懂了，然后它就会自动进入第二个工序的收集模式！"
                },
                {
                    "id": "726970119",
                    "speaker": "伯特兰",
                    "text": "对，它就会进入「元素充能」的模式，补充水元素。等到水元素补充完了以后，又会进行一次变更。",
                    "choices": [
                        {
                            "id": "726970120",
                            "text": "就会进入第三个工序…",
                            "response": [
                                {
                                    "id": "726970122",
                                    "speaker": "伯特兰",
                                    "text": "是的，到时候你就只用击败两只水史莱姆就好。"
                                },
                                {
                                    "id": "726970123",
                                    "speaker": "派蒙",
                                    "text": "听上去真的方便了好多。"
                                },
                                {
                                    "id": "726970124",
                                    "speaker": "伯特兰",
                                    "text": "是吧，改良这个素材收集器啊，花了我一晚上时间，我愿称它为终极居家三合一…"
                                },
                                {
                                    "id": "726970125",
                                    "speaker": "派蒙",
                                    "text": "「素材收集器」真是好了不起啊。"
                                },
                                {
                                    "id": "726970126",
                                    "speaker": "Player",
                                    "text": "确实。"
                                },
                                {
                                    "id": "726970127",
                                    "speaker": "伯特兰",
                                    "text": "呃…"
                                },
                                {
                                    "id": "726970128",
                                    "speaker": "派蒙",
                                    "text": "不过，为什么要把这个「素材收集器」给我们？"
                                },
                                {
                                    "id": "726970129",
                                    "speaker": "伯特兰",
                                    "text": "嘿嘿，我暂时被禁足，只能在离岛上…根本没法收集材料。"
                                },
                                {
                                    "id": "726970130",
                                    "speaker": "伯特兰",
                                    "text": "帮人帮到底嘛，到时候制造玩具卖出的收入也会给你们一些的，而且这些造出的玩具，你可以免费拿走一个！"
                                },
                                {
                                    "id": "726970141",
                                    "speaker": "伯特兰",
                                    "text": "还记得之前给你们的那张券吗，嘿嘿，用那个券就可以免费兑换…"
                                },
                                {
                                    "id": "726970142",
                                    "speaker": "伯特兰",
                                    "text": "只要是你试出来的玩具造型，随便兑换哪个都行。"
                                },
                                {
                                    "id": "726970131",
                                    "speaker": "派蒙",
                                    "text": "好啊，我们跑前跑后，制造的材料是我们出的，造出来的玩具卖的摩拉大部分归你，玩具也只能留一个！"
                                },
                                {
                                    "id": "726970132",
                                    "speaker": "派蒙",
                                    "text": "#哪有这样的事，我们走，{NICKNAME}。"
                                },
                                {
                                    "id": "726970133",
                                    "speaker": "伯特兰",
                                    "text": "那…给你们的分成多一些，玩具可以拿走两个…要么…三个？"
                                },
                                {
                                    "id": "726970134",
                                    "speaker": "Player",
                                    "text": "我们走，派蒙。"
                                },
                                {
                                    "id": "726970135",
                                    "speaker": "伯特兰",
                                    "text": "四个！四个！这可是底线了！"
                                },
                                {
                                    "id": "726970136",
                                    "speaker": "伯特兰",
                                    "text": "唉，要是我没欠钱，这些玩具全给你们都行，但是我、我这不还欠着万国商会的钱要还…"
                                },
                                {
                                    "id": "726970137",
                                    "speaker": "Player",
                                    "text": "哼，看你可怜。"
                                },
                                {
                                    "id": "726970138",
                                    "speaker": "派蒙",
                                    "text": "…唉，是呀，我们可是看着你可怜才愿意帮你的，可不是为了分成的摩拉和那四个玩具。"
                                },
                                {
                                    "id": "726970139",
                                    "speaker": "伯特兰",
                                    "text": "嘿嘿，多谢两位帮忙了。"
                                },
                                {
                                    "id": "726970140",
                                    "speaker": "伯特兰",
                                    "text": "这下，总算能够稍微松一口气了…"
                                }
                            ]
                        },
                        {
                            "id": "726970121",
                            "text": "就会进入「核心激活」工序…"
                        }
                    ]
                }
            ]
        }
    ]
}