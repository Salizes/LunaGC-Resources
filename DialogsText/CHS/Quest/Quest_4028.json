    "talks": [
        {
            "id": "402801",
            "objective": "",
            "dialogues": [
                {
                    "id": "40250901",
                    "speaker": "那维莱特",
                    "text": "…以上是她告知我的信息。无论是否有用，我都想先将这些转达给你。"
                },
                {
                    "id": "40250902",
                    "speaker": "派蒙",
                    "text": "第三降临者…的遗骨？"
                },
                {
                    "id": "40250903",
                    "speaker": "派蒙",
                    "text": "神之心吗？在我印象里一直都是像棋子一样的东西，怎么会是什么遗骨？"
                },
                {
                    "id": "40250904",
                    "speaker": "那维莱特",
                    "text": "如果没有误会或特殊比喻的话，她应该是想表达这个意思。"
                },
                {
                    "id": "40250905",
                    "speaker": "派蒙",
                    "text": "她说这个很不吉利，还是丢掉为好，于是你就送给愚人众了呀…"
                },
                {
                    "id": "40250906",
                    "speaker": "那维莱特",
                    "text": "如果丝柯克小姐所说的都是真实的，那么这种位格的东西留在枫丹，的确只会徒增隐患。"
                },
                {
                    "id": "40250907",
                    "speaker": "Player",
                    "text": "（降临者…她提到了降临者…）",
                    "choices": [
                        {
                            "id": "40250908",
                            "text": "我是第四降临者。",
                            "response": [
                                {
                                    "id": "40250910",
                                    "speaker": "Player",
                                    "text": "神之心的存在，与降临者有关。"
                                },
                                {
                                    "id": "40250912",
                                    "speaker": "那维莱特",
                                    "text": "我本就猜测你应该会对降临者这个概念有所了解，可没想到你也是其中之一。"
                                },
                                {
                                    "id": "40250913",
                                    "speaker": "那维莱特",
                                    "text": "这么说来，对元素有着极强的兼容性，以至于可以增幅元素力的「神之心」，源于第三降临者。"
                                },
                                {
                                    "id": "40250914",
                                    "speaker": "那维莱特",
                                    "text": "你的身上是否也拥有类似的特质呢？"
                                },
                                {
                                    "id": "40250915",
                                    "speaker": "派蒙",
                                    "text": "比如…不需要神之眼，就可以使用元素力？应该也算是一种特殊的兼容性吗…"
                                },
                                {
                                    "id": "40250916",
                                    "speaker": "派蒙",
                                    "text": "不要不要，还是先不要想这些了吧，总觉得怪怪的…"
                                },
                                {
                                    "id": "40250917",
                                    "speaker": "派蒙",
                                    "text": "#拿死去的第三降临者和{NICKNAME}作比较什么的…"
                                },
                                {
                                    "id": "40250918",
                                    "speaker": "Player",
                                    "text": "放心，我可没那么容易死。"
                                },
                                {
                                    "id": "40250919",
                                    "speaker": "派蒙",
                                    "text": "话虽这么说啦，可还是觉得很不吉利。"
                                },
                                {
                                    "id": "40250920",
                                    "speaker": "派蒙",
                                    "text": "等「公子」恢复好了，我们再找个机会去逼问他吧！让他找自己师父帮我们好好问问清楚！"
                                },
                                {
                                    "id": "40250921",
                                    "speaker": "那维莱特",
                                    "text": "我也认为在情报不足的情况下，盲目进行过多猜测并不明智，审判庭上也一贯如此。"
                                },
                                {
                                    "id": "40250922",
                                    "speaker": "派蒙",
                                    "text": "好了，这么说来，枫丹的预言危机也算真正告一段落了呢。"
                                },
                                {
                                    "id": "40250923",
                                    "speaker": "那维莱特",
                                    "text": "嗯，芙卡洛斯的一切努力也都是为了这一刻。"
                                },
                                {
                                    "id": "40250924",
                                    "speaker": "派蒙",
                                    "text": "可是…作为神，她最后牺牲了自己，作为人，她又那样煎熬地度过了五百年…这依旧是她想要的吗？"
                                },
                                {
                                    "id": "40250925",
                                    "speaker": "那维莱特",
                                    "text": "…「神」的意愿，大概就是这么神秘吧。"
                                },
                                {
                                    "id": "40250926",
                                    "speaker": "Player",
                                    "text": "你能理解神的意愿吗？"
                                },
                                {
                                    "id": "40250927",
                                    "speaker": "那维莱特",
                                    "text": "我想不能。只是偶尔我也会猜想，假如愿望是天空中片片云朵，终有一日化作雨水落回大地…"
                                },
                                {
                                    "id": "40250928",
                                    "speaker": "那维莱特",
                                    "text": "生命如水流般循环不息，雨是最终的回答。水偶尔倾斜，雨却会公平地降下。"
                                },
                                {
                                    "id": "40250929",
                                    "speaker": "那维莱特",
                                    "text": "你、我、她所沐浴的雨，又有什么分别呢。"
                                }
                            ]
                        },
                        {
                            "id": "40250909",
                            "text": "对我来说，这个情报意味着两件事。"
                        }
                    ]
                }
            ]
        }
    ]
}