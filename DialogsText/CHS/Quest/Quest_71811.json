        {
            "id": "7181103",
            "objective": "将「画」送给顾客",
            "dialogues": [
                {
                    "id": "718110501",
                    "speaker": "阿山婆",
                    "text": "嗯？你找我有什么事吗？"
                },
                {
                    "id": "718110502",
                    "speaker": "Player",
                    "text": "关于「留影机」…"
                },
                {
                    "id": "718110503",
                    "speaker": "阿山婆",
                    "text": "「留影机」…哦，前几天我是去飞云商会，拜托他们过来给我留个影的。"
                },
                {
                    "id": "718110504",
                    "speaker": "阿山婆",
                    "text": "你是特意来把印出来的画送过来的吗？真是谢谢你了。"
                }
            ]
        },
        {
            "id": "7181104",
            "objective": "将「画」送给顾客",
            "dialogues": [
                {
                    "id": "718110601",
                    "speaker": "茶博士刘苏",
                    "text": "您有事找我？"
                },
                {
                    "id": "718110602",
                    "speaker": "Player",
                    "text": "关于「留影机」…"
                },
                {
                    "id": "718110603",
                    "speaker": "茶博士刘苏",
                    "text": "对，对，我前几天是去飞云商会，让他们过来给我留影的。"
                },
                {
                    "id": "718110604",
                    "speaker": "茶博士刘苏",
                    "text": "怎么，画已经印出来了？给我看看…"
                },
                {
                    "id": "718110605",
                    "speaker": "茶博士刘苏",
                    "text": "这还真不错，谢谢你专门跑一趟。"
                }
            ]
        },
        {
            "id": "7181107",
            "objective": "向阿旭回报",
            "dialogues": [
                {
                    "id": "718110412",
                    "speaker": "Player",
                    "text": "关于「留影机」的事…"
                },
                {
                    "id": "718110401",
                    "speaker": "阿旭",
                    "text": "你把东西都送到了吗？"
                },
                {
                    "id": "718110402",
                    "speaker": "Player",
                    "text": "都送到了。"
                },
                {
                    "id": "718110403",
                    "speaker": "阿旭",
                    "text": "谢谢谢谢，真是劳烦您了，我真是要忙晕头了…"
                },
                {
                    "id": "718110404",
                    "speaker": "阿旭",
                    "text": "哦对了，这架「留影机」送给您，谢谢您帮忙。",
                    "choices": [
                        {
                            "id": "718110405",
                            "text": "这怎么好意思…",
                            "response": [
                                {
                                    "id": "718110407",
                                    "speaker": "阿旭",
                                    "text": "没事，没事，您不是给我们帮了忙吗？"
                                },
                                {
                                    "id": "718110408",
                                    "speaker": "阿旭",
                                    "text": "这也不是什么贵重的东西，是我们去进货的时候，枫丹那边给我们的试用装。"
                                },
                                {
                                    "id": "718110409",
                                    "speaker": "阿旭",
                                    "text": "虽然和正式装的还是有点区别…但基本功能都有，您随便玩玩肯定是够的。"
                                },
                                {
                                    "id": "718110410",
                                    "speaker": "阿旭",
                                    "text": "然后…您要是觉着用得不错，您也帮我们四处宣传宣传…"
                                },
                                {
                                    "id": "718110411",
                                    "speaker": "阿旭",
                                    "text": "咳…总之谢谢您帮忙！这「留影机」您收好，收好。"
                                }
                            ]
                        },
                        {
                            "id": "718110406",
                            "text": "这东西挺贵吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718110701",
                    "speaker": "阿山婆",
                    "text": "那个「留影机」可真不错，唔…我要不要去买一台呢…"
                }
            ]
        },
        {
            "id": "7181108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718110801",
                    "speaker": "茶博士刘苏",
                    "text": "不知道这「留影机」卖多少钱，我也想买一个了…"
                }
            ]
        },
        {
            "id": "7181109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718110901",
                    "speaker": "Player",
                    "text": "关于「留影机」的事…"
                },
                {
                    "id": "718110902",
                    "speaker": "阿旭",
                    "text": "枫丹那边居然能鼓捣出这种东西来，真有意思…"
                }
            ]
