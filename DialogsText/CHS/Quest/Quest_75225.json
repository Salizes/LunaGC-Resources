        {
            "id": "7522501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752250101",
                    "speaker": "萨赤阿",
                    "text": "真是只有「喷吐」时期才有的了不起的赛道啊…"
                },
                {
                    "id": "752250102",
                    "speaker": "萨赤阿",
                    "text": "哼哼，眼神坚定的异邦的旅人，你想要挑战这条滚石赛道吗？规则就是突破那些滚石，达到道路的尽头！"
                },
                {
                    "id": "752250103",
                    "speaker": "萨赤阿",
                    "text": "这可是相当难的赛道啊，怎么样，要不要试试看？"
                }
            ]
        },
        {
