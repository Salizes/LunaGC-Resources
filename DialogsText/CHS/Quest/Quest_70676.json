    "talks": [
        {
            "id": "7067601",
            "objective": "进入骑士团图书馆下层的房间",
            "dialogues": [
                {
                    "id": "706760101",
                    "speaker": "派蒙",
                    "text": "没想到图书馆里还有这样的房间，该不会这里就是丽莎小姐说过的禁书区？"
                },
                {
                    "id": "706760102",
                    "speaker": "派蒙",
                    "text": "唔，不过看这里的氛围感觉不太像呢。"
                },
                {
                    "id": "706760103",
                    "speaker": "派蒙",
                    "text": "还是说这里就是故事里常见的那种，因为隐藏了不可告人的秘密所以禁止进入的神秘房间！"
                },
                {
                    "id": "706760104",
                    "speaker": "Player",
                    "text": "如果真的不想让人进应该会上锁吧。"
                },
                {
                    "id": "706760105",
                    "speaker": "派蒙",
                    "text": "也是哦。刚才我们很普通地就进来了，也不像是门锁坏掉了…"
                },
                {
                    "id": "706760106",
                    "speaker": "派蒙",
                    "text": "欸？等一下，这好像不是我们刚才进来的门！呜哇，我们还在图书馆里面吗？",
                    "choices": [
                        {
                            "id": "706760107",
                            "text": "可能在果酒湖底吧？",
                            "response": [
                                {
                                    "id": "706760108",
                                    "speaker": "派蒙",
                                    "text": "原来是这样的建筑结构吗，好厉害…不对，不管怎么想都不可能吧！"
                                },
                                {
                                    "id": "706760111",
                                    "speaker": "派蒙",
                                    "text": "唔…可惜丽莎小姐今天休假，不然就可以问问她了。不过既然来都来了，这里看起来也没什么危险的样子，不如四处看看吧？"
                                },
                                {
                                    "id": "706760112",
                                    "speaker": "派蒙",
                                    "text": "每到一个新的地方就要尽情地自由探索！这就是成为好向导的秘诀，哼哼。"
                                },
                                {
                                    "id": "706760113",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，快看快看，好可爱的小狼布偶！"
                                },
                                {
                                    "id": "706760114",
                                    "speaker": "派蒙",
                                    "text": "毛绒绒的，摸起来手感一定很好吧！不知道是谁留在这里的…",
                                    "choices": [
                                        {
                                            "id": "706760115",
                                            "text": "说不定它才是这个房间的主人。",
                                            "response": [
                                                {
                                                    "id": "706760116",
                                                    "speaker": "派蒙",
                                                    "text": "「大胆的旅行者，竟敢闯入我的城堡，我要把你们吃掉！嗷呜嗷呜！」"
                                                },
                                                {
                                                    "id": "706760120",
                                                    "speaker": "派蒙",
                                                    "text": "…还是先不要管它好了。这个房间还挺大的，我们也去别处逛逛吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706760117",
                                            "text": "可能是神秘房间的看门人。",
                                            "response": [
                                                {
                                                    "id": "706760118",
                                                    "speaker": "派蒙",
                                                    "text": "明明是看门人却在房间里的沙发上呼呼大睡吗？"
                                                },
                                                {
                                                    "id": "706760119",
                                                    "speaker": "派蒙",
                                                    "text": "「呼——呼——没有看到危险就说明没有危险，呼——呼——」"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706760109",
                            "text": "说不定已经到别的世界了…",
                            "response": [
                                {
                                    "id": "706760110",
                                    "speaker": "派蒙",
                                    "text": "别的世界是哪个世界啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7067602",
            "objective": "探索神秘房间",
            "dialogues": []
        }
    ]
}