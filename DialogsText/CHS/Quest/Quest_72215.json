    "talks": [
        {
            "id": "7221501",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722150101",
                    "speaker": "「寝子」",
                    "text": "唔喵，这块石头，什么时候能变得和奴家一样呢…"
                },
                {
                    "id": "722150102",
                    "speaker": "Player",
                    "text": "雕像怎么样了？"
                },
                {
                    "id": "722150103",
                    "speaker": "「寝子」",
                    "text": "那个石头人类说，再过段时间，石头就可以完全敲好了。"
                },
                {
                    "id": "722150104",
                    "speaker": "「寝子」",
                    "text": "等阿响回来的时候，她一定会很高兴的。"
                },
                {
                    "id": "722150105",
                    "speaker": "「寝子」",
                    "text": "对了，可不能只是把那块石头敲好，还得再把神社周围打扮打扮才行呐。"
                },
                {
                    "id": "722150106",
                    "speaker": "「寝子」",
                    "text": "请你们帮奴家去把这些圆圆的，会响的铁球挂在神社周围吧。"
                },
                {
                    "id": "722150107",
                    "speaker": "「寝子」",
                    "text": "这些东西是阿响之前准备的，记得是说百目鬼看她喜欢奴家和别的孩子们，特地送给她的。奴家好不容易才找到。"
                },
                {
                    "id": "722150108",
                    "speaker": "Player",
                    "text": "这是…铃铛？"
                },
                {
                    "id": "722150109",
                    "speaker": "「寝子」",
                    "text": "「铃铛」？奴家不清楚…但阿响之前，经常和奴家一起玩这种铁球。"
                },
                {
                    "id": "722150110",
                    "speaker": "「寝子」",
                    "text": "阿响把铁球放在地上，然后打到远处。铁球动的时候，会叮叮当当地响。"
                },
                {
                    "id": "722150111",
                    "speaker": "「寝子」",
                    "text": "不知道这些铁球有什么力量，奴家和别的猫一听到，就忍不住想要过去。"
                },
                {
                    "id": "722150112",
                    "speaker": "「寝子」",
                    "text": "所以，奴家想明白了。现在来神社的人这么少，一定是因为没有铁球。"
                },
                {
                    "id": "722150113",
                    "speaker": "「寝子」",
                    "text": "所以奴家要汝帮忙，把这些铁球挂在高处。"
                },
                {
                    "id": "722150114",
                    "speaker": "「寝子」",
                    "text": "这样的话，人类听到铁球的声音，就会来神社，也不会走错路。"
                },
                {
                    "id": "722150115",
                    "speaker": "「寝子」",
                    "text": "那就会给「塞钱箱」塞很多钱，神社会变得很热闹。阿响回来就会很高兴。"
                },
                {
                    "id": "722150116",
                    "speaker": "「寝子」",
                    "text": "所以，去帮奴家把这些铁球挂在神社周围吧。"
                },
                {
                    "id": "722150117",
                    "speaker": "Player",
                    "text": "我知道了。"
                },
                {
                    "id": "722150118",
                    "speaker": "「寝子」",
                    "text": "那就拜托你了，喵喵。"
                }
            ]
        },
        {
            "id": "7221502",
            "objective": "将铃铛挂在神社周围",
            "dialogues": [
                {
                    "id": "722150201",
                    "speaker": "「寝子」",
                    "text": "有了这些铁球，一定会有很多人来的。阿响一定会高兴的。"
                }
            ]
        },
        {
            "id": "7221504",
            "objective": "将铃铛挂在神社周围",
            "dialogues": []
        },
