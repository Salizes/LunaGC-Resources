            "dialogues": []
        },
        {
            "id": "7221503",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "722150301",
                    "speaker": "「寝子」",
                    "text": "都挂上去了吗？"
                },
                {
                    "id": "722150302",
                    "speaker": "Player",
                    "text": "都挂好了。"
                },
                {
                    "id": "722150303",
                    "speaker": "「寝子」",
                    "text": "喵喵，太好了，这样子神社就会热闹一些了。"
                },
                {
                    "id": "722150304",
                    "speaker": "「寝子」",
                    "text": "……"
                },
                {
                    "id": "722150305",
                    "speaker": "「寝子」",
                    "text": "咦？怎么还没有好多好多人类来？",
                    "choices": [
                        {
                            "id": "722150306",
                            "text": "应该不会这么快…",
                            "response": [
                                {
                                    "id": "722150308",
                                    "speaker": "「寝子」",
                                    "text": "哎，人类好难懂啊。当然，汝不一样，汝很有悟性。"
                                },
                                {
                                    "id": "722150309",
                                    "speaker": "「寝子」",
                                    "text": "虽然暂时还没人…但有了铁球的叮当声，至少那些小家伙就不会迷路了，喵喵。"
                                },
                                {
                                    "id": "722150310",
                                    "speaker": "「寝子」",
                                    "text": "那个石头人类说，石头奴家很快就能好，一定要来。"
                                },
                                {
                                    "id": "722150311",
                                    "speaker": "「寝子」",
                                    "text": "啊，对了。还有件怪事。"
                                },
                                {
                                    "id": "722150312",
                                    "speaker": "「寝子」",
                                    "text": "奴家去问了那两个绿绿的人类，阿响和百目鬼的事情。"
                                },
                                {
                                    "id": "722150313",
                                    "speaker": "「寝子」",
                                    "text": "但那两个绿绿的人类，都说不认识阿响，也不记得和阿响有关的事。"
                                },
                                {
                                    "id": "722150314",
                                    "speaker": "「寝子」",
                                    "text": "但高高的绿绿的人类说，他读到过「赤穗百目鬼」的事。"
                                },
                                {
                                    "id": "722150315",
                                    "speaker": "「寝子」",
                                    "text": "不过他说什么…「贼」、什么「讨伐」来着…意思好像说，百目鬼是个坏人。"
                                },
                                {
                                    "id": "722150316",
                                    "speaker": "「寝子」",
                                    "text": "肯定是弄错了。阿响和他经常在一起玩。所以，百目鬼也是很好的人。"
                                },
                                {
                                    "id": "722150317",
                                    "speaker": "「寝子」",
                                    "text": "一定是那个人类悟性不行。归根到底，还是汝比较可靠哪。"
                                },
                                {
                                    "id": "722150318",
                                    "speaker": "「寝子」",
                                    "text": "阿响…到底什么时候才会回来呢…"
                                }
                            ]
                        },
                        {
                            "id": "722150307",
                            "text": "应该没有这么简单…"
                        }
                    ]
                }
            ]
        }
    ]
}