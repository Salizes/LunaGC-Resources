    "talks": [
        {
            "id": "1204201",
            "objective": "前往鸣神大社见八重神子",
            "dialogues": [
                {
                    "id": "120420101",
                    "speaker": "八重神子",
                    "text": "瞧你一脸焦急，该不会又有事求我了吧？"
                },
                {
                    "id": "120420102",
                    "speaker": "八重神子",
                    "text": "幸亏来的是你，换了别人，我可没心思一而再再而三地笑脸相迎。"
                },
                {
                    "id": "120420103",
                    "speaker": "派蒙",
                    "text": "可我看你一直在笑！"
                },
                {
                    "id": "120420104",
                    "speaker": "八重神子",
                    "text": "刚才那是俗语，好吗？不许挑我的毛病。"
                },
                {
                    "id": "120420105",
                    "speaker": "Player",
                    "text": "派蒙，说重点…"
                },
                {
                    "id": "120420106",
                    "speaker": "派蒙",
                    "text": "啊对对，出大事了！影她…她…"
                },
                {
                    "id": "120420107",
                    "speaker": "Black Screen",
                    "text": "为八重神子讲述了事件经过…"
                },
                {
                    "id": "120420108",
                    "speaker": "八重神子",
                    "text": "哦——原来如此，影想把稻妻托付给人类，自己一个人面对这场不知何时才能结束的恶战…"
                },
                {
                    "id": "120420109",
                    "speaker": "八重神子",
                    "text": "死板又极致，完全凭借自身意志行动，只要缺少一分实力都无法达成目的…确实是她的作风。"
                },
                {
                    "id": "120420110",
                    "speaker": "八重神子",
                    "text": "我说，过去那么多年她都是这样，现在你又是为什么担心呢？",
                    "choices": [
                        {
                            "id": "120420111",
                            "text": "这场对决严重性不同以往。",
                            "response": [
                                {
                                    "id": "120420113",
                                    "speaker": "八重神子",
                                    "text": "操之过急…呵呵，这么说也没错。影啊，有时候像个小孩子似的。"
                                },
                                {
                                    "id": "120420114",
                                    "speaker": "八重神子",
                                    "text": "所以，你觉得我能帮上忙？谁告诉你的呀？"
                                },
                                {
                                    "id": "120420115",
                                    "speaker": "派蒙",
                                    "text": "她是在装傻吧？她故意的吧！"
                                },
                                {
                                    "id": "120420116",
                                    "speaker": "八重神子",
                                    "text": "小东西变聪明了嘛。不过这次我说的是实话，有关雷电真的意识空间，我也知之甚少。"
                                },
                                {
                                    "id": "120420117",
                                    "speaker": "八重神子",
                                    "text": "我只知道它是神樱树的根基，也听说它和影的「一心净土」有些差别。"
                                },
                                {
                                    "id": "120420118",
                                    "speaker": "派蒙",
                                    "text": "是因为雷电真已经不在了吗？"
                                },
                                {
                                    "id": "120420119",
                                    "speaker": "八重神子",
                                    "text": "倒也不全是这样。空间本身的性质也有差别…比起我在这里纸上谈兵，你们这些亲身访问过的人应该更有体会吧？",
                                    "choices": [
                                        {
                                            "id": "120420120",
                                            "text": "没看出来。",
                                            "response": [
                                                {
                                                    "id": "120420122",
                                                    "speaker": "八重神子",
                                                    "text": "总之，这些都是细节啦，只是待会儿解释起来比较麻烦。"
                                                },
                                                {
                                                    "id": "120420123",
                                                    "speaker": "八重神子",
                                                    "text": "先跟我到空间入口去吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120420121",
                                            "text": "没注意。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120420112",
                            "text": "她有些操之过急了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204202",
            "objective": "与八重神子交谈",
            "dialogues": []
        },
        {
            "id": "1204203",
            "objective": "回到神秘空间的入口处",
            "dialogues": [
                {
                    "id": "120420301",
                    "speaker": "影",
                    "text": "……"
                },
                {
                    "id": "120420302",
                    "speaker": "影",
                    "text": "为什么？"
                },
                {
                    "id": "120420303",
                    "speaker": "影",
                    "text": "你们…怎么能再次来到这里？而且…你们的模样居然还和当年一样…"
                },
                {
                    "id": "120420304",
                    "speaker": "Player",
                    "text": "当年？你的意思是…"
                },
                {
                    "id": "120420305",
                    "speaker": "雷电将军",
                    "text": "这场对决，令人甚是怀念。"
                },
                {
                    "id": "120420306",
                    "speaker": "雷电将军",
                    "text": "仿佛回到了永恒的法则刚刚订立之时，你如今这份意志，竟堪比那时。"
                },
                {
                    "id": "120420307",
                    "speaker": "雷电将军",
                    "text": "无数场战斗，你一次都未落败，也丝毫没有犹豫。"
                },
                {
                    "id": "120420308",
                    "speaker": "雷电将军",
                    "text": "即便我将一切永恒之敌都展现在你的面前，你也不曾动摇。"
                },
                {
                    "id": "120420309",
                    "speaker": "影",
                    "text": "能如此坚定地执行规则，你也值得敬佩。"
                },
                {
                    "id": "120420310",
                    "speaker": "影",
                    "text": "你无愧「永恒的守护者」之名。"
                },
                {
                    "id": "120420311",
                    "speaker": "雷电将军",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}们再次回到这个空间，就像是命运的必然一般。"
                },
                {
                    "id": "120420312",
                    "speaker": "雷电将军",
                    "text": "那就以这决战，为我们五百多年的宿命画上句号吧。"
                },
                {
                    "id": "120420313",
                    "speaker": "影",
                    "text": "决战？难道你终于…"
                },
                {
                    "id": "120420314",
                    "speaker": "影",
                    "text": "向后退，旅行者。"
                },
                {
                    "id": "120420315",
                    "speaker": "Player",
                    "text": "你要结束一切吗？"
                },
                {
                    "id": "120420316",
                    "speaker": "影",
                    "text": "我会成为下一个「开始」。"
                }
            ]
        },
        {
            "id": "1204204",
            "objective": "与八重神子交谈",
            "dialogues": [
                {
                    "id": "120420201",
                    "speaker": "八重神子",
                    "text": "办法嘛，总是有的，虽然有些狡猾。"
                },
                {
                    "id": "120420202",
                    "speaker": "八重神子",
                    "text": "意识空间对外行来说非常抽象。好在我是影的眷属，多少能感应到她的所在之处。"
                },
                {
                    "id": "120420203",
                    "speaker": "八重神子",
                    "text": "换句话说，我无法定位那个地点在空间里的具体位置，但能把你们送到影身边去。"
                },
                {
                    "id": "120420204",
                    "speaker": "派蒙",
                    "text": "抽象…？位置？什么跟什么…"
                },
                {
                    "id": "120420205",
                    "speaker": "八重神子",
                    "text": "你不用理解了。简单来说，现在她身旁的一切都很混沌。"
                },
                {
                    "id": "120420206",
                    "speaker": "八重神子",
                    "text": "如湍流一般无序…强行闯入也许会被巨浪卷走，彻底迷失在时间空间之中哦。"
                },
                {
                    "id": "120420207",
                    "speaker": "八重神子",
                    "text": "正因如此，进入「一心净土」时把意识寄宿在物体上，才是比较保险的做法。"
                },
                {
                    "id": "120420208",
                    "speaker": "派蒙",
                    "text": "啊？那我不去了，你们去吧！",
                    "choices": [
                        {
                            "id": "120420209",
                            "text": "想得美哦。",
                            "response": [
                                {
                                    "id": "120420211",
                                    "speaker": "八重神子",
                                    "text": "不去也行，最坏的情况不就是失去影吗？"
                                },
                                {
                                    "id": "120420212",
                                    "speaker": "派蒙",
                                    "text": "#你、你们…唉讨厌啦！我陪你去吧，{NICKNAME}…"
                                },
                                {
                                    "id": "120420213",
                                    "speaker": "八重神子",
                                    "text": "既然心意已决，那我就送你上路了哦。"
                                },
                                {
                                    "id": "120420214",
                                    "speaker": "八重神子",
                                    "text": "……"
                                },
                                {
                                    "id": "120420215",
                                    "speaker": "八重神子",
                                    "text": "嗯？这是…"
                                },
                                {
                                    "id": "120420216",
                                    "speaker": "Player",
                                    "text": "怎么了？"
                                },
                                {
                                    "id": "120420217",
                                    "speaker": "八重神子",
                                    "text": "没什么。感觉很紊乱，证实了我心中的判断。"
                                },
                                {
                                    "id": "120420218",
                                    "speaker": "八重神子",
                                    "text": "对了，在进入空间时，记得不断在心中重复你的愿望哦。"
                                },
                                {
                                    "id": "120420219",
                                    "speaker": "八重神子",
                                    "text": "只有强大到一定地步的意识才能不被抽象空间里的巨浪吞没。你足够强，我才能将你送到最合适的位置。"
                                },
                                {
                                    "id": "120420220",
                                    "speaker": "Player",
                                    "text": "我知道了。"
                                },
                                {
                                    "id": "120420221",
                                    "speaker": "八重神子",
                                    "text": "那么，门开了，请进吧。"
                                },
                                {
                                    "id": "120420222",
                                    "speaker": "八重神子",
                                    "text": "我会守在外侧随机应变，做你的最后一道保险。"
                                },
                                {
                                    "id": "120420223",
                                    "speaker": "八重神子",
                                    "text": "#我的神明就交给你了，{NICKNAME}。"
                                },
                                {
                                    "id": "120420224",
                                    "speaker": "八重神子",
                                    "text": "为了我，为了稻妻，你可要好好努力啊。"
                                },
                                {
                                    "id": "120420225",
                                    "speaker": "派蒙",
                                    "text": "神子，你靠得住吗…"
                                },
                                {
                                    "id": "120420226",
                                    "speaker": "Player",
                                    "text": "我们一定会成功。"
                                },
                                {
                                    "id": "120420227",
                                    "speaker": "八重神子",
                                    "text": "好了好了，快去努力！"
                                }
                            ]
                        },
                        {
                            "id": "120420210",
                            "text": "派蒙，你不会不要我吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204205",
            "objective": "闯入空间之内",
            "dialogues": [
                {
                    "id": "120420501",
                    "speaker": "Black Screen",
                    "text": "离开意识空间返回神社后，你们向八重神子讲述了一切…"
                },
                {
                    "id": "120420502",
                    "speaker": "八重神子",
                    "text": "如今的影亲手在意识空间里种下神樱树，它在过去的稻妻发了芽…"
                },
                {
                    "id": "120420503",
                    "speaker": "八重神子",
                    "text": "无论怎么想，都是不可思议的事呢。"
                },
                {
                    "id": "120420504",
                    "speaker": "影",
                    "text": "这些都归功于真的力量。对于永恒，她的理解比我更深。"
                },
                {
                    "id": "120420505",
                    "speaker": "影",
                    "text": "「永恒」是与时间息息相关的概念。一旦触及永恒，时间的概念就会变得模糊。"
                },
                {
                    "id": "120420506",
                    "speaker": "Player",
                    "text": "进入空间时我看到了奇妙的景象。"
                },
                {
                    "id": "120420507",
                    "speaker": "Player",
                    "text": "时间既在前进，又在后退。"
                },
                {
                    "id": "120420508",
                    "speaker": "八重神子",
                    "text": "时间本身不具有意义，也无法以常理诠释…原来，这就是我感受到的「湍流」。"
                },
                {
                    "id": "120420509",
                    "speaker": "八重神子",
                    "text": "或许，这正是你们能顺利返回这个时间节点的原因。"
                },
                {
                    "id": "120420510",
                    "speaker": "八重神子",
                    "text": "不过，那种紊乱感已经完全消失了。"
                },
                {
                    "id": "120420511",
                    "speaker": "影",
                    "text": "我还不能完全理解。但直觉告诉我，一切的根源…就是那颗种子。"
                },
                {
                    "id": "120420512",
                    "speaker": "八重神子",
                    "text": "我倒觉得，只靠真的力量，或许…"
                },
                {
                    "id": "120420513",
                    "speaker": "影",
                    "text": "我明白你在想什么。或许真有「更高层{RUBY#[D]伊斯塔露}次的力量」参与其中。但无论如何，她的这个办法在最后关头保护了我们所有人。"
                },
                {
                    "id": "120420514",
                    "speaker": "影",
                    "text": "要是没有神樱树，稻妻可能早在几百年前就被灾难与污秽完全吞没了。"
                },
                {
                    "id": "120420515",
                    "speaker": "八重神子",
                    "text": "我知道你对神樱树有奇妙的感知，可对我来说，神樱树一直都存在。"
                },
                {
                    "id": "120420516",
                    "speaker": "八重神子",
                    "text": "以前你还想向我证明这棵神樱树与真的意识空间存在关联，可惜没能成功，对吧？"
                },
                {
                    "id": "120420517",
                    "speaker": "影",
                    "text": "嗯，现在我明白了。因为那个时候神樱树甚至都还没有被种下去。"
                },
                {
                    "id": "120420518",
                    "speaker": "派蒙",
                    "text": "可是，你们不觉得那棵树跟现在这副样子差别很大吗？"
                },
                {
                    "id": "120420519",
                    "speaker": "八重神子",
                    "text": "神樱树可是种在我的地盘里，当然要根据我的趣味进行修剪啦。"
                },
                {
                    "id": "120420520",
                    "speaker": "派蒙",
                    "text": "呃…你好霸道…"
                },
                {
                    "id": "120420521",
                    "speaker": "八重神子",
                    "text": "开玩笑的。发芽至今，这棵树也经历了很多。多亏狐狸的悉心照料，它才能有如今这副模样。"
                },
                {
                    "id": "120420522",
                    "speaker": "八重神子",
                    "text": "和我也不是完全无关的哦。"
                },
                {
                    "id": "120420523",
                    "speaker": "八重神子",
                    "text": "你们离开又再次进入空间，按理说间隔很短，可内部的恶战已经持续了几百年，没错吧？"
                },
                {
                    "id": "120420524",
                    "speaker": "八重神子",
                    "text": "如果我没猜错…旅行者，你一定像我说的，一直默念着心中的愿望吧？",
                    "choices": [
                        {
                            "id": "120420525",
                            "text": "当然了。",
                            "response": [
                                {
                                    "id": "120420527",
                                    "speaker": "八重神子",
                                    "text": "那时我感知到影的所在地，也同样察觉到内部的「时间」有异常。"
                                },
                                {
                                    "id": "120420528",
                                    "speaker": "八重神子",
                                    "text": "如果「时间」也是我们追寻所求之物的要素之一，那只知道「位置」是不够的。"
                                },
                                {
                                    "id": "120420529",
                                    "speaker": "八重神子",
                                    "text": "不过幸好，凭借你们顽强的意志，湍流带你们去到的，正是一切心愿汇聚的时间交点——最具有可能性的那个瞬间。"
                                },
                                {
                                    "id": "120420530",
                                    "speaker": "八重神子",
                                    "text": "湍流的走向或许受到了真的影响，但能帮到影，每个人的努力都不可或缺。这一次确实要谢谢你们呢。"
                                },
                                {
                                    "id": "120420531",
                                    "speaker": "派蒙",
                                    "text": "难道说，我们碰上那场决战不是偶然，而是我们一定会遇到、见证的场面…",
                                    "choices": [
                                        {
                                            "id": "120420532",
                                            "text": "或许这也是将军说的…",
                                            "response": [
                                                {
                                                    "id": "120420534",
                                                    "speaker": "影",
                                                    "text": "我本以为，空间内外的时间流动一致，所以旅行者再度出现，令我非常震惊。"
                                                },
                                                {
                                                    "id": "120420535",
                                                    "speaker": "影",
                                                    "text": "那一刻我首先想到，「莫非稻妻遭遇了巨大的灾难？」"
                                                },
                                                {
                                                    "id": "120420536",
                                                    "speaker": "影",
                                                    "text": "结果原来是你想要救我…你们为我而来，帮助我迎来了最好的结局。"
                                                },
                                                {
                                                    "id": "120420537",
                                                    "speaker": "影",
                                                    "text": "多谢二位。你们为我做了许多，我铭记在心。"
                                                },
                                                {
                                                    "id": "120420538",
                                                    "speaker": "八重神子",
                                                    "text": "影，你现在感觉如何？"
                                                },
                                                {
                                                    "id": "120420539",
                                                    "speaker": "影",
                                                    "text": "身体完全恢复了，将军的意志不再和我对抗。"
                                                },
                                                {
                                                    "id": "120420540",
                                                    "speaker": "八重神子",
                                                    "text": "身体当然很重要啦，但我更想知道，你的心情平复了吗？"
                                                },
                                                {
                                                    "id": "120420541",
                                                    "speaker": "八重神子",
                                                    "text": "你见到真的意识了，对吧。"
                                                },
                                                {
                                                    "id": "120420542",
                                                    "speaker": "影",
                                                    "text": "只是听到了她的声音，不算是见到…"
                                                },
                                                {
                                                    "id": "120420543",
                                                    "speaker": "影",
                                                    "text": "没关系，有点怀念而已。我已经决定向前了。"
                                                },
                                                {
                                                    "id": "120420544",
                                                    "speaker": "影",
                                                    "text": "但这一次又让我坚信，真确实很厉害，她在那时就预料到了稻妻未来的种种可能。"
                                                },
                                                {
                                                    "id": "120420545",
                                                    "speaker": "影",
                                                    "text": "甚至，连我的这份不成熟，都被她计算在内。"
                                                },
                                                {
                                                    "id": "120420546",
                                                    "speaker": "影",
                                                    "text": "稻妻能迎来今天，也是她的功劳吧。",
                                                    "choices": [
                                                        {
                                                            "id": "120420547",
                                                            "text": "真很厉害。",
                                                            "response": [
                                                                {
                                                                    "id": "120420549",
                                                                    "speaker": "影",
                                                                    "text": "我只是种了一颗种子而已。"
                                                                },
                                                                {
                                                                    "id": "120420550",
                                                                    "speaker": "Player",
                                                                    "text": "你和她的意志，缺一不可。"
                                                                },
                                                                {
                                                                    "id": "120420551",
                                                                    "speaker": "派蒙",
                                                                    "text": "对啊！你是凭自己的本事回到她面前的，很厉害了！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "120420552",
                                                                            "text": "最后的行为看似简单。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "120420554",
                                                                                    "speaker": "Player",
                                                                                    "text": "不能因为因果倒转…"
                                                                                },
                                                                                {
                                                                                    "id": "120420556",
                                                                                    "speaker": "影",
                                                                                    "text": "#…谢谢你，{NICKNAME}。"
                                                                                },
                                                                                {
                                                                                    "id": "120420557",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "直到今天，你和稻妻才真正从几百年前的阴影中完全走出来。"
                                                                                },
                                                                                {
                                                                                    "id": "120420558",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "真和你，是稻妻不可或缺的「过去」与「未来」。"
                                                                                },
                                                                                {
                                                                                    "id": "120420559",
                                                                                    "speaker": "影",
                                                                                    "text": "难得从你这里听到安慰的话，我也收下了。"
                                                                                },
                                                                                {
                                                                                    "id": "120420560",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "哎呀，那不还是因为以前的你根本听不进去嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "120420561",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "和真说了一样的话呢。"
                                                                                },
                                                                                {
                                                                                    "id": "120420562",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "真的吗？那将军的位置，是不是也可以给我坐两天呢？"
                                                                                },
                                                                                {
                                                                                    "id": "120420563",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "算了算了，这种麻烦事我才不要。"
                                                                                },
                                                                                {
                                                                                    "id": "120420564",
                                                                                    "speaker": "影",
                                                                                    "text": "玩笑就到此为止。接下来，我还有很多事要做。"
                                                                                },
                                                                                {
                                                                                    "id": "120420565",
                                                                                    "speaker": "影",
                                                                                    "text": "我会和将军一起仔细审视如今的稻妻，整理现状，斟酌未来。"
                                                                                },
                                                                                {
                                                                                    "id": "120420566",
                                                                                    "speaker": "影",
                                                                                    "text": "随后…我将下令解除锁国。"
                                                                                },
                                                                                {
                                                                                    "id": "120420567",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "真的吗？这是不得了的大事呀！"
                                                                                },
                                                                                {
                                                                                    "id": "120420568",
                                                                                    "speaker": "影",
                                                                                    "text": "我已决定不再追逐静止的「永恒」。既然如此，没必要再封锁这个国度。"
                                                                                },
                                                                                {
                                                                                    "id": "120420569",
                                                                                    "speaker": "影",
                                                                                    "text": "接下来，稻妻一定会面临更多挑战…"
                                                                                },
                                                                                {
                                                                                    "id": "120420570",
                                                                                    "speaker": "Player",
                                                                                    "text": "也会诞生出更多「相遇」。"
                                                                                },
                                                                                {
                                                                                    "id": "120420571",
                                                                                    "speaker": "影",
                                                                                    "text": "我对此充满期待。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "120420553",
                                                                            "text": "却是由无数努力积淀而成。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120420548",
                                                            "text": "但影也做了重要的事。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120420533",
                                            "text": "命运的必然吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120420526",
                            "text": "难道这有特殊的含义？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204211",
            "objective": "闯入空间之内",
            "dialogues": []
        },
        {
            "id": "1204206",
            "objective": "与影交谈，整理情况",
            "dialogues": []
        },
        {
            "id": "1204207",
            "objective": "击败雷电将军",
            "dialogues": []
        },
        {
            "id": "1204208",
            "objective": "见证漫长战斗的尾声",
            "dialogues": [
                {
                    "id": "120420401",
                    "speaker": "雷电将军",
                    "text": "到此为止。你赢了。"
                },
                {
                    "id": "120420402",
                    "speaker": "雷电将军",
                    "text": "我原以为你无法超越过去，看来我还是太过武断，轻视了你的灵魂。"
                },
                {
                    "id": "120420403",
                    "speaker": "雷电将军",
                    "text": "永不磨损的意志，终究是无法拥抱未来啊。"
                },
                {
                    "id": "120420404",
                    "speaker": "影",
                    "text": "你无需担忧未来，也无需独自前行。"
                },
                {
                    "id": "120420405",
                    "speaker": "影",
                    "text": "我最懂得你的强大，若只凭我一己之力，这场决斗的败者必然是我。"
                },
                {
                    "id": "120420406",
                    "speaker": "影",
                    "text": "然而出刀的理由，决定了武艺的格局与极限。我所背负的是投向天光的万千视线。"
                },
                {
                    "id": "120420407",
                    "speaker": "影",
                    "text": "每思及此，我就能感觉到这把「梦想一心」中传来的异动。"
                },
                {
                    "id": "120420408",
                    "speaker": "影",
                    "text": "这把从真手里接过的刀，像是在试图提醒我…激励我。"
                },
                {
                    "id": "120420409",
                    "speaker": "雷电将军",
                    "text": "我也感觉到了，方才激战中，它似乎释放出了全新的力量。"
                },
                {
                    "id": "120420410",
                    "speaker": "雷电将军",
                    "text": "这份力量，甚至在我的认知之外。"
                },
                {
                    "id": "120420411",
                    "speaker": "影",
                    "text": "这是真{RUBY#[D]前代雷神}的佩刀。可能在我真正理解并认同她的时候，刀才会全力回应我。"
                },
                {
                    "id": "120420412",
                    "speaker": "影",
                    "text": "握紧「梦想一心」，让我有了与她再次并肩的感觉。"
                },
                {
                    "id": "120420413",
                    "speaker": "影",
                    "text": "熟悉而又陌生…从不挥刀的她，始终在我身旁。"
                },
                {
                    "id": "120420414",
                    "speaker": "雷电将军",
                    "text": "我，认可了。"
                },
                {
                    "id": "120420415",
                    "speaker": "雷电将军",
                    "text": "你崭新的意志并非源于磨损。我不会再阻碍你试图修改法则的行为。"
                },
                {
                    "id": "120420416",
                    "speaker": "雷电将军",
                    "text": "从今往后，此身依然是你的协助者。"
                },
                {
                    "id": "120420417",
                    "speaker": "影",
                    "text": "我不会再设下什么绝不容更改的法则了。"
                },
                {
                    "id": "120420418",
                    "speaker": "影",
                    "text": "你曾代表我的过去，但从今天起，你——就是我。"
                },
                {
                    "id": "120420419",
                    "speaker": "影",
                    "text": "真从没把我当成无惧无畏的武器，我也不该将你视为工具。"
                },
                {
                    "id": "120420420",
                    "speaker": "雷电将军",
                    "text": "…呵，你真的变了。这就是人类常说的「成长」吧。"
                },
                {
                    "id": "120420421",
                    "speaker": "雷电将军",
                    "text": "我明白了，我会成为你的影子，就像你曾经是真的影子一样。"
                },
                {
                    "id": "120420422",
                    "speaker": "雷电将军",
                    "text": "我将履行的职责不会改变。"
                },
                {
                    "id": "120420423",
                    "speaker": "雷电将军",
                    "text": "但作为武者，我很期待以后还有像这样战斗的机会。"
                },
                {
                    "id": "120420424",
                    "speaker": "影",
                    "text": "单论胜负本身，你仍心有不甘，是吗？"
                },
                {
                    "id": "120420425",
                    "speaker": "雷电将军",
                    "text": "只是从来没有过这样的感觉，很新奇，值得回味。"
                },
                {
                    "id": "120420426",
                    "speaker": "派蒙",
                    "text": "打完了？这就算，全部结束了吗？"
                },
                {
                    "id": "120420427",
                    "speaker": "影",
                    "text": "嗯？"
                },
                {
                    "id": "120420428",
                    "speaker": "Player",
                    "text": "「梦想一心」在发光？"
                },
                {
                    "id": "120420429",
                    "speaker": "真",
                    "text": "你们好啊，影，还有在此的见证者们。"
                },
                {
                    "id": "120420430",
                    "speaker": "真",
                    "text": "我是雷电真，没能尽到职责的前代雷神，为你们留下了无数的麻烦。"
                },
                {
                    "id": "120420431",
                    "speaker": "影",
                    "text": "真…？"
                },
                {
                    "id": "120420432",
                    "speaker": "真",
                    "text": "我很开心，我知道如果是你的话，一定能走到这一步。"
                },
                {
                    "id": "120420433",
                    "speaker": "真",
                    "text": "我在「梦想一心」中留下了些许微弱的意志，你发挥出它所有力量的那一刻，我也会被释放出来。"
                },
                {
                    "id": "120420434",
                    "speaker": "真",
                    "text": "至于为什么要用如此迂回的方法——因为那时的你深信自己的想法，什么都听不进去嘛。"
                },
                {
                    "id": "120420435",
                    "speaker": "真",
                    "text": "可我没有时间等待你回心转意。请原谅，我只能以这种方式等待你的归来。"
                },
                {
                    "id": "120420436",
                    "speaker": "影",
                    "text": "但你从未向我提起这些…"
                },
                {
                    "id": "120420437",
                    "speaker": "真",
                    "text": "一切来得太过突然…抱歉。"
                },
                {
                    "id": "120420438",
                    "speaker": "真",
                    "text": "我一直觉得很愧疚，突然就将稻妻托付给了你。"
                },
                {
                    "id": "120420439",
                    "speaker": "真",
                    "text": "这些道理，本应由我循序渐进地传授给你，让你不再执着于「无想」。"
                },
                {
                    "id": "120420440",
                    "speaker": "影",
                    "text": "那时你就感知到坎瑞亚即将发生的事了吗？"
                },
                {
                    "id": "120420441",
                    "speaker": "真",
                    "text": "嗯，多少有点吧。无论是对于哪位尘世执政来说，「那边」都是不容忽视的存在。"
                },
                {
                    "id": "120420442",
                    "speaker": "真",
                    "text": "现在的我已经无法感知到时间了。我不知道我们阔别多久才重逢，也不知道在此期间稻妻经历了什么。"
                },
                {
                    "id": "120420443",
                    "speaker": "真",
                    "text": "但我知道，你一定走过了极其艰难的路，一定有许多次想要落泪，对吧？"
                },
                {
                    "id": "120420444",
                    "speaker": "影",
                    "text": "…别小看我了。"
                },
                {
                    "id": "120420445",
                    "speaker": "真",
                    "text": "你看，你承认了呢。"
                },
                {
                    "id": "120420446",
                    "speaker": "真",
                    "text": "我考虑到这种可能性，才特地为你留下一份礼物，以缓解稻妻的痛苦。"
                },
                {
                    "id": "120420447",
                    "speaker": "真",
                    "text": "来吧，在我最后的意识消逝前，收下它。"
                },
                {
                    "id": "120420448",
                    "speaker": "真",
                    "text": "不过，最重要的一步还是要由你亲手…"
                }
            ]
        },
        {
            "id": "1204210",
            "objective": "见证梦想的起点",
            "dialogues": []
        },
        {
            "id": "1204209",
            "objective": "与影和八重神子交谈",
            "dialogues": []
        },
        {
            "id": "1204299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120429901",
                    "speaker": "雷电将军",
                    "text": "对决所需的时间，足以见证王国兴起又覆灭。"
                },
                {
                    "id": "120429902",
                    "speaker": "雷电将军",
                    "text": "对决所耗的能量，足以倾倒大海、覆灭天光。"
                },
                {
                    "id": "120429903",
                    "speaker": "雷电将军",
                    "text": "对决所求的意志，足以贯通一心、颠倒梦想。"
                },
                {
                    "id": "120429904",
                    "speaker": "雷电将军",
                    "text": "而你，依然存在。"
                },
                {
                    "id": "120429905",
                    "speaker": "影",
                    "text": "我将永远存在。"
                }
            ]
        }
    ]
}