    "talks": [
        {
            "id": "7512901",
            "objective": "(test)涂了某一个石块$HIDDEN",
            "dialogues": [
                {
                    "id": "751290101",
                    "speaker": "疲惫的暝视龙",
                    "text": "唉，我的孩子啊，被关在那里的孩子…"
                },
                {
                    "id": "751290102",
                    "speaker": "疲惫的暝视龙",
                    "text": "可是我的孩子被关在了那里，如果能把它救出来的话…"
                },
                {
                    "id": "751290103",
                    "speaker": "Player",
                    "text": "门已被打开了…"
                },
                {
                    "id": "751290104",
                    "speaker": "疲惫的暝视龙",
                    "text": "咦，难道是刚才两位异邦的客人…啊，真是感谢。"
                },
                {
                    "id": "751290105",
                    "speaker": "疲惫的暝视龙",
                    "text": "好，我知道该怎么做了，哼，欺骗他人的骗子，就该受到应有的惩罚！"
                },
                {
                    "id": "751290106",
                    "speaker": "疲惫的暝视龙",
                    "text": "哼，继续那个游戏吧，这次我会让那个狡猾的部落骗子一败涂地！"
                }
            ]
        },
        {
            "id": "7512902",
            "objective": "(test)涂完石块后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751290201",
                    "speaker": "马穆勒",
                    "text": "哎呀，这位异邦来的客人！"
                },
                {
                    "id": "751290202",
                    "speaker": "马穆勒",
                    "text": "真是所谓来得早不如来得巧啊，我今天才刚把这个摊子支起来，你们就来到这儿啦。"
                },
                {
                    "id": "751290203",
                    "speaker": "马穆勒",
                    "text": "嘿，哼哼，运气真是不错！"
                },
                {
                    "id": "751290204",
                    "speaker": "Player",
                    "text": "你运气是挺好的。"
                },
                {
                    "id": "751290205",
                    "speaker": "马穆勒",
                    "text": "不不不，客人，我不是指我的运气好，而是指你们的运气好啊。"
                },
                {
                    "id": "751290206",
                    "speaker": "派蒙",
                    "text": "我们的运气好？"
                },
                {
                    "id": "751290207",
                    "speaker": "马穆勒",
                    "text": "是啊，可不是人人都有机会参与彩璧山历史悠久的传统挑战项目，「染绘石挑战」！"
                },
                {
                    "id": "751290208",
                    "speaker": "马穆勒",
                    "text": "这可是传说中「烟谜主」的英雄，呃…瓦勒豪达肯留下来的试炼，旨在锻炼部族人民的记忆力和对色彩的感知能力。"
                },
                {
                    "id": "751290209",
                    "speaker": "派蒙",
                    "text": "「烟谜主」有叫这样名字的英雄吗…"
                },
                {
                    "id": "751290210",
                    "speaker": "马穆勒",
                    "text": "部族历史悠远流长，唉，你们这些外地人怎么能全部知道。"
                },
                {
                    "id": "751290211",
                    "speaker": "Player",
                    "text": "可你不是「烟谜主」的人吧。"
                },
                {
                    "id": "751290212",
                    "speaker": "马穆勒",
                    "text": "哎，哎，传承英雄试炼的使命，和我是什么部族的人又有什么关系，六大部族建立都这么多年啦，早该打开隔阂…咳咳。"
                },
                {
                    "id": "751290213",
                    "speaker": "马穆勒",
                    "text": "总之，运气好的异邦旅人，不如听听「染绘石挑战」的规则吧，实不相瞒，我准备的奖励之丰厚，真是让我自己都觉得肉痛啊。"
                },
                {
                    "id": "751290214",
                    "speaker": "派蒙",
                    "text": "真…真的吗？"
                },
                {
                    "id": "751290215",
                    "speaker": "派蒙",
                    "text": "#虽然感觉还是有点可疑，不过我们就听听看吧…怎么样，{NICKNAME}？",
                    "choices": [
                        {
                            "id": "751290216",
                            "text": "我说不听你也会听的吧…",
                            "response": [
                                {
                                    "id": "751290217",
                                    "speaker": "派蒙",
                                    "text": "冒险家就不该放过任何一个拿奖励的机会嘛！"
                                },
                                {
                                    "id": "751290220",
                                    "speaker": "马穆勒",
                                    "text": "那就让我这个英雄瓦勒肯的传人来跟你们介绍规则吧…"
                                },
                                {
                                    "id": "751290221",
                                    "speaker": "派蒙",
                                    "text": "怎么感觉名字都不太一样了…"
                                },
                                {
                                    "id": "751290222",
                                    "speaker": "马穆勒",
                                    "text": "不一样吗？一样吧。唉你们这些外地人就是记不清那些古老伟大英雄的名字，但这些都不重要，总之，规则是这样的…"
                                },
                                {
                                    "id": "751290223",
                                    "speaker": "马穆勒",
                                    "text": "挑战开始的时候，我身边的暝视龙兄弟会在空台子上创造颜色不同的染色石块，不过很快，那些石块就会消失…"
                                },
                                {
                                    "id": "751290224",
                                    "speaker": "马穆勒",
                                    "text": "而你们要做的，就是在各个台子前，对应的石块上，<color=#00E1FFFF>用蕴色幻写灵染上相应的颜色</color>，只要相同，即可通过关卡。"
                                },
                                {
                                    "id": "751290225",
                                    "speaker": "马穆勒",
                                    "text": "其实是个考验记忆的游戏，怎么样，很简单吧。"
                                },
                                {
                                    "id": "751290226",
                                    "speaker": "Player",
                                    "text": "听上去倒不是很难…"
                                },
                                {
                                    "id": "751290227",
                                    "speaker": "派蒙",
                                    "text": "而且，我们有两个人呢，只不过记一些颜色…"
                                },
                                {
                                    "id": "751290228",
                                    "speaker": "马穆勒",
                                    "text": "是啊是啊，哎呀，今天真是你们的幸运日，不过是我钱包的不幸运日咯。"
                                },
                                {
                                    "id": "751290229",
                                    "speaker": "马穆勒",
                                    "text": "那么，如果要参加的话，一次五百摩拉，敬请参与。"
                                },
                                {
                                    "id": "751290230",
                                    "speaker": "派蒙",
                                    "text": "什么，居然还要摩拉？"
                                },
                                {
                                    "id": "751290231",
                                    "speaker": "马穆勒",
                                    "text": "这位小客人有所不知，一代一代传承纳塔英雄的试炼，本身也需要很多的开销…此间辛苦不足为外人道。"
                                },
                                {
                                    "id": "751290232",
                                    "speaker": "马穆勒",
                                    "text": "更何况，比起最终的奖励来说，五百摩拉可真是少之又少，哎，更像是一个门槛，为了考察想要经历试炼的人诚心与否…"
                                },
                                {
                                    "id": "751290233",
                                    "speaker": "派蒙",
                                    "text": "好吧好吧，唔…"
                                },
                                {
                                    "id": "751290234",
                                    "speaker": "派蒙",
                                    "text": "#报名费我包了，{NICKNAME}，你可一定要赢啊！"
                                },
                                {
                                    "id": "751290235",
                                    "speaker": "马穆勒",
                                    "text": "好好，那，两位，现在就开始吗？"
                                }
                            ]
                        },
                        {
                            "id": "751290218",
                            "text": "那就让我看看是什么幸运事件…",
                            "response": [
                                {
                                    "id": "751290219",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，幸运事件这个词听上去真让人心潮澎湃。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7512904",
            "objective": "(test)接取到猜猜猜任务$HIDDEN",
            "dialogues": [
                {
                    "id": "751294438",
                    "speaker": "Player",
                    "text": "现在开始吧。"
                },
                {
                    "id": "751294439",
                    "speaker": "马穆勒",
                    "text": "好嘞！真是激动人心啊！激动人心的「染绘石挑战」又迎来了新的挑战者！开始挑战吧！"
                }
            ]
        },
        {
            "id": "7512905",
            "objective": "(test)赢下全部奖励$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7512906",
            "objective": "(test)与骗子对话（骗子耍赖）$HIDDEN",
            "dialogues": [
                {
                    "id": "751290601",
                    "speaker": "马穆勒",
                    "text": "真是可惜啊，异邦的客人，这次只差一点…"
                },
                {
                    "id": "751290602",
                    "speaker": "派蒙",
                    "text": "不对不对，我记得明明我们答案就是对的啊！"
                },
                {
                    "id": "751290603",
                    "speaker": "马穆勒",
                    "text": "哎呀，回答错误的人都会以为自己回答的答案是正确的，这很正常，最后的试炼和之前的试炼难度确实不太一样…"
                },
                {
                    "id": "751290604",
                    "speaker": "马穆勒",
                    "text": "「明明是最后的试炼，可是看上去还是很简单嘛…」"
                },
                {
                    "id": "751290605",
                    "speaker": "马穆勒",
                    "text": "这位会飞的小客人，你扪心自问，真的没有这样想过吗…"
                },
                {
                    "id": "751290606",
                    "speaker": "派蒙",
                    "text": "啊，嗯…倒确实也有这样的想法啦…"
                },
                {
                    "id": "751290607",
                    "speaker": "马穆勒",
                    "text": "所以说呀，这可是英雄的试炼，可没有办法这么简单就能够让你轻易过关呢。"
                },
                {
                    "id": "751290608",
                    "speaker": "马穆勒",
                    "text": "不过没关系，就让你们再免费尝试一次吧！"
                },
                {
                    "id": "751290609",
                    "speaker": "马穆勒",
                    "text": "这样你就明白了…最终试炼的难度啦！"
                },
                {
                    "id": "751290610",
                    "speaker": "派蒙",
                    "text": "真的吗？这次不用摩拉。"
                },
                {
                    "id": "751290611",
                    "speaker": "派蒙",
                    "text": "既、既然是免费的，就让我们再试一试吧…",
                    "choices": [
                        {
                            "id": "751290612",
                            "text": "免费的才是最贵的…",
                            "response": [
                                {
                                    "id": "751290613",
                                    "speaker": "派蒙",
                                    "text": "倒也不能这么说啦，总之试一试总没错！"
                                },
                                {
                                    "id": "751290616",
                                    "speaker": "马穆勒",
                                    "text": "那么，最终的试炼，但是第二次，两位，现在要开始吗？"
                                },
                                {
                                    "id": "751290619",
                                    "speaker": "Player",
                                    "text": "现在开始吧。"
                                },
                                {
                                    "id": "751290620",
                                    "speaker": "马穆勒",
                                    "text": "哼哼，那么，这次就请一定要小心了哦。"
                                }
                            ]
                        },
                        {
                            "id": "751290614",
                            "text": "既然是免费的那就…",
                            "response": [
                                {
                                    "id": "751290615",
                                    "speaker": "派蒙",
                                    "text": "对对，反正都是免费的嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
