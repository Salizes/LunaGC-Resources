            "dialogues": [
                {
                    "id": "751290301",
                    "speaker": "疲惫的暝视龙",
                    "text": "(test)咕咕——"
                },
                {
                    "id": "751290302",
                    "speaker": "派蒙",
                    "text": "(test)它好像想说什么的样子"
                },
                {
                    "id": "751290303",
                    "speaker": "Player",
                    "text": "(test)让人有些在意"
                }
            ]
        },
        {
            "id": "7512908",
            "objective": "(test)寻找赢下奖励的方法$HIDDEN",
            "dialogues": [
                {
                    "id": "751290801",
                    "speaker": "疲惫的暝视龙",
                    "text": "那两个异邦的客人什么时候才能发现，这个试炼就是个骗局…"
                },
                {
                    "id": "751290802",
                    "speaker": "疲惫的暝视龙",
                    "text": "唉…唉…都这么多次了，这个叫马穆勒的骗子，利用我骗了好多人…"
                },
                {
                    "id": "751290803",
                    "speaker": "疲惫的暝视龙",
                    "text": "可是我的孩子被关在了那里，如果能把它救出来的话…"
                }
            ]
        },
        {
            "id": "7512909",
            "objective": "(test)救出小灵视龙$HIDDEN",
            "dialogues": [
                {
                    "id": "751290901",
                    "speaker": "疲惫的暝视龙",
                    "text": "要小心…这个部族人很狡猾，唉…"
                }
            ]
        },
        {
            "id": "7512910",
            "objective": "(test)和小灵视龙对话$HIDDEN",
            "dialogues": [
                {
