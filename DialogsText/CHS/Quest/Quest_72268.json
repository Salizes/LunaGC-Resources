        {
            "id": "7226809",
            "objective": "在「常夜」时调查池水",
            "dialogues": []
        },
        {
            "id": "7226801",
            "objective": "和封印前的残魂对话",
            "dialogues": [
                {
                    "id": "722680101",
                    "speaker": "宇陀",
                    "text": "我乃末代地走官·宇陀。珊瑚宫之勇者，我认可你挑战的荣誉。"
                },
                {
                    "id": "722680102",
                    "speaker": "宇陀",
                    "text": "我将主持「智慧」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。"
                },
                {
                    "id": "722680103",
                    "speaker": "宇陀",
                    "text": "如果没有足够的智慧，勇往直前并不能称为勇敢，只是鲁莽罢了！"
                },
                {
                    "id": "722680104",
                    "speaker": "宇陀",
                    "text": "我将在上方三界塔处等候你完成挑战。"
                }
            ]
        },
        {
            "id": "7226802",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722680201",
                    "speaker": "宇陀",
                    "text": "珊瑚宫之勇者, 前去挑战吧。"
                },
                {
                    "id": "722680202",
                    "speaker": "宇陀",
                    "text": "让所有的「高门之火」归位吧。"
                }
            ]
        },
        {
            "id": "7226803",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722680301",
                    "speaker": "宇陀",
                    "text": "我乃末代地走官·宇陀，于此认可你的勇武。"
                },
                {
                    "id": "722680302",
                    "speaker": "宇陀",
                    "text": "你的智慧，可称得上「智圆行方」了。"
                },
                {
                    "id": "722680303",
                    "speaker": "派蒙",
                    "text": "怎么从这种的试炼看出来人品德的？"
                },
                {
                    "id": "722680304",
                    "speaker": "宇陀",
                    "text": "这其实是以前历史里现人神巫女夸青年才俊的话，后来变成了地走官部门里每年流动的小锦旗。"
                }
            ]
        },
        {
            "id": "7226804",
            "objective": "解放所有「高门之火」",
            "dialogues": [
                {
                    "id": "722680401",
                    "speaker": "宇陀",
                    "text": "我乃末代地走官·宇陀。无关人士请回。"
                }
            ]
        },
        {
