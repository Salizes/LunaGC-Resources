    "talks": [
        {
            "id": "7001901",
            "objective": "与另一个愿意交流的丘丘人对话",
            "dialogues": [
                {
                    "id": "700190101",
                    "speaker": "失眠的丘丘人",
                    "text": "Yoyo dala si?"
                },
                {
                    "id": "700190102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo. Mimi mani ye."
                },
                {
                    "id": "700190103",
                    "speaker": "失眠的丘丘人",
                    "text": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye."
                },
                {
                    "id": "700190104",
                    "speaker": "艾拉·马斯克",
                    "text": "他说他希望天上的太阳不见，想要一睡不醒，想要死。是什么让它这么痛苦啊。"
                },
                {
                    "id": "700190105",
                    "speaker": "失眠的丘丘人",
                    "text": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye."
                },
                {
                    "id": "700190106",
                    "speaker": "艾拉·马斯克",
                    "text": "唔，不如我们就把它想要的东西交给它，权作安慰吧？"
                }
            ]
        },
        {
            "id": "7001902",
            "objective": "向丘丘人交付物品",
            "dialogues": [
                {
                    "id": "700190301",
                    "speaker": "失眠的丘丘人",
                    "text": "Yeye dada."
                },
                {
                    "id": "700190302",
                    "speaker": "失眠的丘丘人",
                    "text": "Wei? Du odomu tomo zido mi si, du zido <color=#00E1FFFF>unta nunu</color>！"
                },
                {
                    "id": "700190303",
                    "speaker": "派蒙",
                    "text": "<color=#00E1FFFF>Unta nunu</color>…它在提示我们时间吧？",
                    "choices": [
                        {
                            "id": "700190304",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700190306",
                                    "speaker": "失眠的丘丘人",
                                    "text": "Valo, mi tomo!"
                                },
                                {
                                    "id": "700190307",
                                    "speaker": "派蒙",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700190305",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
