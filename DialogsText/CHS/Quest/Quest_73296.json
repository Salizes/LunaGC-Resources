    "talks": [
        {
            "id": "7329601",
            "objective": "(test)等到第三天$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7329602",
            "objective": "前往水边营地",
            "dialogues": [
                {
                    "id": "732960201",
                    "speaker": "于连",
                    "text": "#派蒙，还有{NICKNAME}，你们果然来了！出门在外还是得靠朋友啊。"
                },
                {
                    "id": "732960202",
                    "speaker": "派蒙",
                    "text": "因为答应了给你带路嘛，而且带路也不是什么难事！举手之劳…这时候该说是举足之劳吗？"
                },
                {
                    "id": "732960203",
                    "speaker": "派蒙",
                    "text": "不过，你真的这么快就回枫丹吗？难得到了须弥，其实须弥可看的风景还是很多的…",
                    "choices": [
                        {
                            "id": "732960204",
                            "text": "雨林的风景很不错。",
                            "response": [
                                {
                                    "id": "732960205",
                                    "speaker": "派蒙",
                                    "text": "有很多树，很多河！"
                                },
                                {
                                    "id": "732960208",
                                    "speaker": "于连",
                                    "text": "听起来确实很诱人，但是我想…我其实还没有做好远游的准备。这次虽然是一次失败的旅行，但是也算是收获了一些教训吧…"
                                },
                                {
                                    "id": "732960209",
                                    "speaker": "派蒙",
                                    "text": "唔…那…那这附近也有很值得一看的景观呢！要是错过就太可惜啦。"
                                },
                                {
                                    "id": "732960210",
                                    "speaker": "Player",
                                    "text": "派蒙推荐的地方准没错。"
                                },
                                {
                                    "id": "732960211",
                                    "speaker": "于连",
                                    "text": "既然两位坚持，我再推辞就显得对好朋友失礼了。"
                                },
                                {
                                    "id": "732960212",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我可是提瓦特的最佳向导，带路就交给我吧！你们可不要掉队啦。"
                                }
                            ]
                        },
                        {
                            "id": "732960206",
                            "text": "沙漠的景观很特别。",
                            "response": [
                                {
                                    "id": "732960207",
                                    "speaker": "派蒙",
                                    "text": "有很多沙，很多遗迹！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329603",
            "objective": "前往甘露花海",
            "dialogues": [
                {
                    "id": "732960301",
                    "speaker": "派蒙",
                    "text": "听说画家在动笔之前都会从不同角度观察…这应该不是什么「刻板印象」吧？"
                },
                {
                    "id": "732960302",
                    "speaker": "派蒙",
                    "text": "我们一起在附近转转？还可以去视野更好的高处观察一下！"
                },
                {
                    "id": "732960303",
                    "speaker": "于连",
                    "text": "听起来是个不错的主意，我已经准备好出发了。"
                },
                {
                    "id": "732960304",
                    "speaker": "派蒙",
                    "text": "#对了，不如我们比比谁先到终点？{NICKNAME}，准备好出发了吗？"
                }
            ]
        },
        {
            "id": "7329604",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732960401",
                    "speaker": "派蒙",
                    "text": "充满了大自然的气息…是不是很适合写生和寻找灵感？"
                },
                {
                    "id": "732960402",
                    "speaker": "Player",
                    "text": "这是刻板印象啦。"
                },
                {
                    "id": "732960403",
                    "speaker": "派蒙",
                    "text": "唔…可是如果是我就会很想提起画笔呢，这里的景物都有种充满生命力的美，而且色彩也都很绚丽…"
                },
                {
                    "id": "732960404",
                    "speaker": "Player",
                    "text": "咳。"
                },
                {
                    "id": "732960405",
                    "speaker": "派蒙",
                    "text": "啊…"
                },
                {
                    "id": "732960406",
                    "speaker": "派蒙",
                    "text": "对不起…我不是…"
                },
                {
                    "id": "732960407",
                    "speaker": "于连",
                    "text": "哈哈，没关系，我只是看到了不同的景色。但是美是共通的，对吧？"
                },
                {
                    "id": "732960408",
                    "speaker": "派蒙",
                    "text": "嗯！我很喜欢这里的景色呢，感觉心灵都被净化了。"
                },
                {
                    "id": "732960409",
                    "speaker": "Player",
                    "text": "派蒙的心灵应该不需要净化吧。"
                },
                {
                    "id": "732960410",
                    "speaker": "于连",
                    "text": "两位好朋友，给了我这样一个一开始甚至没有说实话的陌生人这么多的善意…"
                },
                {
                    "id": "732960411",
                    "speaker": "于连",
                    "text": "两位都是有着纯洁心灵的好人。"
                },
                {
                    "id": "732960412",
                    "speaker": "派蒙",
                    "text": "嘿嘿…倒也不用这么夸奖啦。对了，其实还有更特别的景色呢！"
                },
                {
                    "id": "732960413",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你一定知道我在说什么，也让于连见识一下吧！"
                }
            ]
        },
        {
            "id": "7329612",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732960501",
                    "speaker": "Player",
                    "text": "我们出发吧！"
                },
                {
                    "id": "732960502",
                    "speaker": "派蒙",
                    "text": "出发咯！"
                }
            ]
        },
        {
            "id": "7329609",
            "objective": "（test）倒计时$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7329605",
            "objective": "前往视野更好的高处",
            "dialogues": []
        },
        {
            "id": "7329613",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732961601",
                    "speaker": "于连",
                    "text": "呼…想…想不到画画对体力的要求也这么高，早知道我就…"
                },
                {
                    "id": "732961602",
                    "speaker": "派蒙",
                    "text": "看来对于连来说还是太勉强了…"
                },
                {
                    "id": "732961603",
                    "speaker": "于连",
                    "text": "毕…毕竟是刚养好伤…呼…"
                },
                {
                    "id": "732961604",
                    "speaker": "于连",
                    "text": "不过这里的风景的确很独特，真奇怪，为什么之前都没注意到…"
                },
                {
                    "id": "732961605",
                    "speaker": "派蒙",
                    "text": "前边视野应该也不错，我们去那边看看吧，要小心一点哦！"
                }
            ]
        },
        {
            "id": "7329611",
            "objective": "离开高处，继续向前",
            "dialogues": []
        },
        {
            "id": "7329607",
            "objective": "向于连展示特别的景色",
            "dialogues": []
        },
        {
            "id": "7329608",
            "objective": "与于连对话",
            "dialogues": [
                {
                    "id": "732960801",
                    "speaker": "派蒙",
                    "text": "怎么样，风景很不错吧？「胡椒」刚才也很高兴呢。"
                },
                {
                    "id": "732960802",
                    "speaker": "于连",
                    "text": "面对这样的景色，语言已经显得多余了。卡特皮拉说得对，铁格子之外还有广阔的世界…"
                },
                {
                    "id": "732960803",
                    "speaker": "派蒙",
                    "text": "铁格子…于连之前说自己在枫丹的住处很小…"
                },
                {
                    "id": "732960804",
                    "speaker": "Player",
                    "text": "咳，须弥的自然风物挺多的。"
                },
                {
                    "id": "732960805",
                    "speaker": "派蒙",
                    "text": "…啊，对对！他已经决定要当个堂堂正正的画家了，换个环境也挺好的，那话怎么说的来着…拓宽视野！"
                },
                {
                    "id": "732960806",
                    "speaker": "派蒙",
                    "text": "虽然于连自己说想要放弃…但我觉得没必要那么快就下结论嘛！可以再多考虑考虑…"
                },
                {
                    "id": "732960807",
                    "speaker": "派蒙",
                    "text": "想一想还有很多和眼前的景色一样，或者比这还要壮美的绝景你都还没见识过呢，说不定…说不定看过之后就有灵感了！"
                },
                {
                    "id": "732960808",
                    "speaker": "派蒙",
                    "text": "至于辨别颜色…于连自己也说了，「只是看到了不同的景色」…"
                },
                {
                    "id": "732960809",
                    "speaker": "Player",
                    "text": "「但是美是共通的。」"
                },
                {
                    "id": "732960810",
                    "speaker": "派蒙",
                    "text": "对吧？"
                },
                {
                    "id": "732960811",
                    "speaker": "于连",
                    "text": "的确…你们的话很有道理。"
                },
                {
                    "id": "732960812",
                    "speaker": "派蒙",
                    "text": "是你自己的话啦！"
                },
                {
                    "id": "732960813",
                    "speaker": "于连",
                    "text": "我…哈哈，原来这道理我是明白的，只是…只是我总是走上错误的路…"
                },
                {
                    "id": "732960814",
                    "speaker": "派蒙",
                    "text": "「胡椒」带你走了这条路，我们才能认识呢，所以这也不完全是「错误的路」吧？"
                },
                {
                    "id": "732960815",
                    "speaker": "派蒙",
                    "text": "虽然没能帮你找到纯水精灵的朝圣之路挺遗憾的…唔…"
                },
                {
                    "id": "732960816",
                    "speaker": "Player",
                    "text": "这种东西真的存在吗…"
                },
                {
                    "id": "732960817",
                    "speaker": "于连",
                    "text": "我到现在也相信朝圣之路的确存在，不过…对我来说，能否找到它的终点已经不再重要了吧。"
                },
                {
                    "id": "732960818",
                    "speaker": "于连",
                    "text": "因为我已经找到我想要的答案了。"
                },
                {
                    "id": "732960819",
                    "speaker": "于连",
                    "text": "谢谢两位好朋友，唉，我该怎么感谢你们呢。"
                },
                {
                    "id": "732960820",
                    "speaker": "于连",
                    "text": "要是之前买下了那枚神奇鸟蛋就好了…能够抵消掉一天的厄运的神奇道具，送给你们这样的冒险家正合适呢。",
                    "choices": [
                        {
                            "id": "732960821",
                            "text": "是啊，真可惜。",
                            "response": [
                                {
                                    "id": "732960822",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}居然真的相信有这样方便的神奇道具吗？"
                                },
                                {
                                    "id": "732960825",
                                    "speaker": "于连",
                                    "text": "我打算在这里多留一下，这里让人心绪宁静，很适合思考。"
                                },
                                {
                                    "id": "732960826",
                                    "speaker": "于连",
                                    "text": "有种能够画出点什么不一样的东西的预感…"
                                },
                                {
                                    "id": "732960827",
                                    "speaker": "于连",
                                    "text": "谢谢两位的帮助，也祝好朋友旅途顺利！"
                                }
                            ]
                        },
                        {
                            "id": "732960823",
                            "text": "多谢，不过还是不用了吧。",
                            "response": [
                                {
                                    "id": "732960824",
                                    "speaker": "派蒙",
                                    "text": "为什么呀！就算不能抵消厄运…说不定…说不定它是比普通鸟蛋好吃一百倍的鸟蛋呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329610",
            "objective": "(test)前往B点",
            "dialogues": []
        },
        {
            "id": "7329606",
            "objective": "(test)完成B点的花海玩法",
            "dialogues": [
                {
                    "id": "732960601",
                    "speaker": "Player",
                    "text": "还需要做一下准备。"
                },
                {
                    "id": "732960602",
                    "speaker": "派蒙",
                    "text": "唔…那准备好之后再出发吧！"
                }
            ]
        },
        {
            "id": "7329614",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732961401",
                    "speaker": "于连",
                    "text": "离开城市的好处是不用特意准备狗粮了。反正「胡椒」这么能干，自己的口粮自己想办法吧。"
                },
                {
                    "id": "732961402",
                    "speaker": "于连",
                    "text": "坏处是…我既没有战斗又没有烹饪的天赋，简直就是城市废人…"
                },
                {
                    "id": "732961403",
                    "speaker": "于连",
                    "text": "……"
                },
                {
                    "id": "732961404",
                    "speaker": "于连",
                    "text": "我还是好好休息养伤吧。"
                }
            ]
        },
        {
            "id": "7329615",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732961501",
                    "speaker": "「胡椒」",
                    "text": "（期待地看着你们。）"
                }
            ]
        },
        {
            "id": "7329699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732969911",
                    "speaker": "派蒙",
                    "text": "之前跟于连约好了要帮他带路呢，他休息了一阵应该恢复得差不多了吧？不如我们去看看他？"
                },
                {
                    "id": "732969912",
                    "speaker": "派蒙",
                    "text": "有了之前的教训，这次他应该会在海边的营地乖乖等我们吧！"
                },
                {
                    "id": "732969916",
                    "speaker": "Black Screen",
                    "text": "于连没能跟上你们，或许回到起点处能找到他…"
                }
            ]
        }
    ]
}