                                                            "response": [
                                                                {
                                                                    "id": "741890416",
                                                                    "speaker": "佩尔曼雅",
                                                                    "text": "您答对了，离启动大炮又近了一步。"
                                                                },
                                                                {
                                                                    "id": "741890419",
                                                                    "speaker": "佩尔曼雅",
                                                                    "text": "第三个问题是，有什么东西，是我们「锈舵」酒馆不供应的？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890420",
                                                                            "text": "奶酪。"
                                                                        },
                                                                        {
                                                                            "id": "741890421",
                                                                            "text": "海露花。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890422",
                                                                                    "speaker": "佩尔曼雅",
                                                                                    "text": "全部答对了，恭喜您，可以去启动大炮了。"
                                                                                },
                                                                                {
                                                                                    "id": "741890423",
                                                                                    "speaker": "佩尔曼雅",
                                                                                    "text": "稍等，我先去旁边捂住耳朵。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741890424",
                                                                            "text": "牛奶。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890418",
                                                            "text": "我就是工作人员。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
