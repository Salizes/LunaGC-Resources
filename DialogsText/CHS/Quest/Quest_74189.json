                                                                    "text": "很遗憾，您答错了…要再试一次吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890426",
                                                                            "text": "再来一次。"
                                                                        },
                                                                        {
                                                                            "id": "741890427",
                                                                            "text": "我再想想…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890428",
                                                                                    "speaker": "佩尔曼雅",
                                                                                    "text": "那就请您去寻找那几个问题的答案吧，我就在这里等着您。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
