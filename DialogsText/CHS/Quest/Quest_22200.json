    "talks": [
        {
            "id": "2220001",
            "objective": "找到咕噜声的来源",
            "dialogues": [
                {
                    "id": "222000101",
                    "speaker": "一成",
                    "text": "你好，有什么咕…"
                },
                {
                    "id": "222000102",
                    "speaker": "一成",
                    "text": "唔，肚子又发出声音了。我是说，有什么可以帮你的咕噜…"
                },
                {
                    "id": "222000103",
                    "speaker": "Player",
                    "text": "呃，你说什么？"
                },
                {
                    "id": "222000104",
                    "speaker": "一成",
                    "text": "唉，每次我肚子饿的时候都会这样，咕噜咕噜的，声音特别大，连我说话的声音都盖过去了。"
                },
                {
                    "id": "222000105",
                    "speaker": "一成",
                    "text": "虽然…咕噜…也去「不卜庐」看过了，但医生说我只是单纯肚子饿了，不是病，所以没法治咕噜…"
                },
                {
                    "id": "222000106",
                    "speaker": "一成",
                    "text": "医生说只要我吃饱了就好，但是我…我食量比人家都大啊咕噜，要是一直吃到吃饱的话，我的钱包也撑不住。"
                },
                {
                    "id": "222000107",
                    "speaker": "一成",
                    "text": "嘉义和我说，如果正餐没吃饱，那就饭后再吃点东西垫一垫，至少别影响到工作。"
                },
                {
                    "id": "222000108",
                    "speaker": "一成",
                    "text": "但是这「垫一垫」…我有很多想吃的菜，但也不知道哪个最容易填饱肚子。"
                },
                {
                    "id": "222000109",
                    "speaker": "一成",
                    "text": "旅行者，你经常在野外跑，肯定知道吃什么最容易填饱肚子，对吧？"
                },
                {
                    "id": "222000110",
                    "speaker": "一成",
                    "text": "不如你来帮我，在我想吃的菜里面选出好吃又能填饱肚子的菜吧。"
                },
                {
                    "id": "222000111",
                    "speaker": "Player",
                    "text": "你这次想吃什么？"
                },
                {
                    "id": "222000112",
                    "speaker": "一成",
                    "text": "我想吃的东西可多了…我想想…"
                }
            ]
        },
        {
            "id": "2220002",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000201",
                    "speaker": "一成",
                    "text": "唔，我听说，有些蒙德菜味道不错，比方说甜甜花酿鸡、蒙德烤鱼、渔人吐司还有嘟嘟莲海鲜羹咕…"
                },
                {
                    "id": "222000202",
                    "speaker": "一成",
                    "text": "拜托你了，把你觉得最容易填饱肚子的菜带给我吧。"
                },
                {
                    "id": "222000203",
                    "speaker": "一成",
                    "text": "吃完的话，至少今天肚子就不会叫了吧咕…"
                }
            ]
        },
        {
            "id": "2220003",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000301",
                    "speaker": "一成",
                    "text": "你找到那道最容易填饱肚子的菜了吗？",
                    "choices": [
                        {
                            "id": "222000302",
                            "text": "做好了。",
                            "response": [
                                {
                                    "id": "222000303",
                                    "speaker": "一成",
                                    "text": "那太好了，让我尝尝。"
                                }
                            ]
                        },
                        {
                            "id": "222000304",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "222000305",
                                    "speaker": "一成",
                                    "text": "好吧，渔人吐司的话，「万民堂」平时就有卖。"
                                },
                                {
                                    "id": "222000307",
                                    "speaker": "一成",
                                    "text": "唔，我听从蒙德来的商人说，「猎鹿人」餐馆有一道嘟嘟莲海鲜羹，感觉味道应该很不错。"
                                },
                                {
                                    "id": "222000308",
                                    "speaker": "一成",
                                    "text": "还有蒙德烤鱼和甜甜花酿鸡，这两道菜做起来应该很简单吧。"
                                },
                                {
                                    "id": "222000309",
                                    "speaker": "一成",
                                    "text": "咕噜…啊…一报菜名肚子更饿了咕噜…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2220004",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000401",
                    "speaker": "一成",
                    "text": "好想吃莲子禽蛋羹和水煮黑背鲈。唔，我听说，有些蒙德菜也不错，比方说野菇鸡肉串和庄园烤松饼…"
                },
                {
                    "id": "222000402",
                    "speaker": "一成",
                    "text": "拜托你了，把你觉得最容易填饱肚子的菜带给我吧。"
                },
                {
                    "id": "222000403",
                    "speaker": "一成",
                    "text": "吃完的话，至少今天肚子就不会叫了吧咕…"
                }
            ]
        },
        {
            "id": "2220005",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000501",
                    "speaker": "一成",
                    "text": "你找到那道最容易填饱肚子的菜了吗？",
                    "choices": [
                        {
                            "id": "222000502",
                            "text": "做好了。",
                            "response": [
                                {
                                    "id": "222000503",
                                    "speaker": "一成",
                                    "text": "那太好了，让我尝尝。"
                                }
                            ]
                        },
                        {
                            "id": "222000504",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "222000505",
                                    "speaker": "一成",
                                    "text": "水煮黑背鲈的话「万民堂」的卯师傅好像会做，你可以去问问他。"
                                },
                                {
                                    "id": "222000506",
                                    "speaker": "一成",
                                    "text": "至于莲子禽蛋羹，阿桂好像会做，他平时都在玉京台上的「不卜庐」里工作，你可以去问问他。"
                                },
                                {
                                    "id": "222000507",
                                    "speaker": "一成",
                                    "text": "我听从蒙德来的商人说，蒙德城「猎鹿人」餐馆的庄园烤松饼的味道也不错，而且听起来就很容易吃饱。"
                                },
                                {
                                    "id": "222000508",
                                    "speaker": "一成",
                                    "text": "还有野菇鸡肉串，这一道菜做起来应该很简单吧。"
                                },
                                {
                                    "id": "222000509",
                                    "speaker": "一成",
                                    "text": "咕噜…啊…一报菜名肚子更饿了咕噜…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2220006",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000601",
                    "speaker": "一成",
                    "text": "好想吃松鼠鱼和香嫩椒椒鸡，唔，我听说，有些蒙德菜也不错，比方说白汁时蔬烩肉还有提瓦特煎蛋咕…"
                },
                {
                    "id": "222000602",
                    "speaker": "一成",
                    "text": "想想更饿了，咕噜噜…"
                },
                {
                    "id": "222000603",
                    "speaker": "一成",
                    "text": "拜托你了，带一份菜品给我吧咕…吃完的话，至少今天肚子就不会叫了吧咕…"
                }
            ]
        },
        {
            "id": "2220007",
            "objective": "将一份能吃饱的料理交给一成",
            "dialogues": [
                {
                    "id": "222000701",
                    "speaker": "一成",
                    "text": "你找到那道最容易填饱肚子的菜了吗？",
                    "choices": [
                        {
                            "id": "222000702",
                            "text": "做好了。",
                            "response": [
                                {
                                    "id": "222000703",
                                    "speaker": "一成",
                                    "text": "那太好了，让我尝尝。"
                                }
                            ]
                        },
                        {
                            "id": "222000704",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "222000705",
                                    "speaker": "一成",
                                    "text": "松鼠鱼和香嫩椒椒鸡的做法，可以去找「万民堂」的卯师傅请教。"
                                },
                                {
                                    "id": "222000706",
                                    "speaker": "一成",
                                    "text": "我听从蒙德来的商人说，蒙德的「猎鹿人」餐馆有一道菜叫白汁时蔬烩肉，不知道味道怎么样…"
                                },
                                {
                                    "id": "222000707",
                                    "speaker": "一成",
                                    "text": "还有提瓦特煎蛋，这道菜做起来应该很简单咕…"
                                },
                                {
                                    "id": "222000708",
                                    "speaker": "一成",
                                    "text": "咕噜…啊…一报菜名肚子更饿了咕噜…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2220010",
            "objective": "与一成对话",
            "dialogues": [
                {
                    "id": "222001001",
                    "speaker": "一成",
                    "text": "这菜闻着就不对劲，食材完全没切好，这一大块都没熟啊。"
                },
                {
                    "id": "222001002",
                    "speaker": "一成",
                    "text": "好吧，虽然味道不怎么样…但分量倒是很足，吃完至少肚子不叫了。"
                },
                {
                    "id": "222001003",
                    "speaker": "一成",
                    "text": "谢了，嗝。这是我一点心意，请收下吧，嗝。"
                }
            ]
        },
        {
            "id": "2220011",
            "objective": "与一成对话",
            "dialogues": [
                {
                    "id": "222001101",
                    "speaker": "一成",
                    "text": "这口感，这味道，太棒了！"
                },
                {
                    "id": "222001102",
                    "speaker": "一成",
                    "text": "分量也足，吃得真过瘾！我的肚子也不叫了，嗝。"
                },
                {
                    "id": "222001103",
                    "speaker": "一成",
                    "text": "只是，吃饱了我又忍不住，嗝，开始打嗝了。"
                },
                {
                    "id": "222001104",
                    "speaker": "一成",
                    "text": "太谢谢你了，嗝。这是我一点心意，请收下吧，嗝。"
                }
            ]
        },
        {
            "id": "2220012",
            "objective": "与一成对话",
            "dialogues": [
                {
                    "id": "222001201",
                    "speaker": "一成",
                    "text": "这味道好奇怪，像是隔了夜似的，和我想象的也太不一样了。"
                },
                {
                    "id": "222001202",
                    "speaker": "一成",
                    "text": "口感也不好，像在嚼沙子…而且分量也少，我两口就吃完了。"
                },
                {
                    "id": "222001203",
                    "speaker": "一成",
                    "text": "唉，这道菜肯定不够我吃的，我还是自己去找点吃的吧…"
                },
                {
                    "id": "222001204",
                    "speaker": "一成",
                    "text": "不过还是要谢谢你，朋友。这是我一点心意，请收下吧。"
                }
            ]
        },
        {
            "id": "2220013",
            "objective": "与一成对话",
            "dialogues": [
                {
                    "id": "222001301",
                    "speaker": "一成",
                    "text": "这菜真是够精致的，看这品相绝对下了不少功夫吧，看着味道真不错。"
                },
                {
                    "id": "222001302",
                    "speaker": "一成",
                    "text": "不过…虽然味道不错，但分量太少了，填不饱肚子啊。"
                },
                {
                    "id": "222001303",
                    "speaker": "一成",
                    "text": "不过，能吃到味道这么好的菜也不错吧，咕噜…"
                },
                {
                    "id": "222001304",
                    "speaker": "一成",
                    "text": "谢谢了，这是我一点心意，请收下吧。"
                }
            ]
        }
    ]
}