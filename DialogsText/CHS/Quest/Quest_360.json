    "talks": [
        {
            "id": "36001",
            "objective": "消灭游荡的丘丘人",
            "dialogues": [
                {
                    "id": "3600101",
                    "speaker": "安柏",
                    "text": "呼，小菜一碟。"
                },
                {
                    "id": "3600102",
                    "speaker": "安柏",
                    "text": "不过没想到，原来你也不是没有战斗能力的路人…"
                },
                {
                    "id": "3600103",
                    "speaker": "安柏",
                    "text": "谢谢你刚才的支援啦，这一战感觉如何？",
                    "choices": [
                        {
                            "id": "3600104",
                            "text": "轻轻松松。",
                            "response": [
                                {
                                    "id": "3600106",
                                    "speaker": "派蒙",
                                    "text": "说起来，「丘丘人」怎么会出现在这里呢？"
                                },
                                {
                                    "id": "3600107",
                                    "speaker": "派蒙",
                                    "text": "这种生物，一般不会在离城市这么近的地方建立营地吧？"
                                },
                                {
                                    "id": "3600108",
                                    "speaker": "安柏",
                                    "text": "是啊。它们本该只在荒野游荡才对。"
                                },
                                {
                                    "id": "3600109",
                                    "speaker": "安柏",
                                    "text": "但最近风魔龙经常出现，果园被摧毁，商路也受到了影响。"
                                },
                                {
                                    "id": "3600110",
                                    "speaker": "安柏",
                                    "text": "风暴爆发时又经常有人受伤…所以骑士团要分心防御。"
                                },
                                {
                                    "id": "3600111",
                                    "speaker": "派蒙",
                                    "text": "所以这些烦人的生物，活动范围就越来越近？"
                                },
                                {
                                    "id": "3600112",
                                    "speaker": "安柏",
                                    "text": "是呀。不过今天又清理了一个营地，还是很有收获的。"
                                },
                                {
                                    "id": "3600113",
                                    "speaker": "安柏",
                                    "text": "跟我来吧！认真负责的好骑士要护送你们进城了。"
                                }
                            ]
                        },
                        {
                            "id": "3600105",
                            "text": "勉勉强强。"
                        }
                    ]
                }
            ]
        },
