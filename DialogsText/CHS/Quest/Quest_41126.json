    "talks": [
        {
            "id": "4112601",
            "objective": "用于接取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "411260101",
                    "speaker": "嘉义",
                    "text": "唉，这可怎么办…"
                },
                {
                    "id": "411260102",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "411260103",
                    "speaker": "嘉义",
                    "text": "那些从天而降的陨石，你应该也看见了吧，城里虽然没有被波及，但野外已经乱了套了。"
                },
                {
                    "id": "411260104",
                    "speaker": "嘉义",
                    "text": "而且，陨石不仅堵塞着道路，周围的魔物似乎也被陨石影响，变得格外暴躁危险，到处袭击行人和商队。"
                },
                {
                    "id": "411260105",
                    "speaker": "嘉义",
                    "text": "总务司几乎把能派出去的千岩军全都派出去了，但璃月太大了，我们也只能保障几条主干道和村庄的安全。"
                },
                {
                    "id": "411260106",
                    "speaker": "嘉义",
                    "text": "我本来已经向上面申请要去轻策庄驻防的，但不知道为什么，我还是被分到这里待命…"
                },
                {
                    "id": "411260107",
                    "speaker": "嘉义",
                    "text": "旅行者，你能帮我把这封信带去轻策庄，给一个叫小六的女孩吗？"
                },
                {
                    "id": "411260108",
                    "speaker": "嘉义",
                    "text": "她是我女儿，我本来答应她会回去陪她几天，但这次事出紧急，我肯定又回不去了…",
                    "choices": [
                        {
                            "id": "411260109",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "411260110",
                                    "speaker": "嘉义",
                                    "text": "那就拜托你了，唉，这都叫什么事啊…"
                                },
                                {
                                    "id": "411260115",
                                    "speaker": "嘉义",
                                    "text": "不过，据从那边换防回来的人说，轻策庄附近好像也聚集了不少魔物。"
                                },
                                {
                                    "id": "411260116",
                                    "speaker": "嘉义",
                                    "text": "那个…不好意思，看你的装束，你是冒险家，对吧？"
                                },
                                {
                                    "id": "411260117",
                                    "speaker": "嘉义",
                                    "text": "在送信的时候，你能不能先去轻策庄周围看看，把一些边角里的魔物给扫清了。"
                                },
                                {
                                    "id": "411260118",
                                    "speaker": "嘉义",
                                    "text": "千岩军一般是驻防在大路和要道上…如果这些零星的魔物悄悄进了轻策庄，那可就糟糕了。",
                                    "choices": [
                                        {
                                            "id": "411260119",
                                            "text": "好吧…",
                                            "response": [
                                                {
                                                    "id": "411260120",
                                                    "speaker": "嘉义",
                                                    "text": "谢谢，那就拜托你了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "411260121",
                                            "text": "这算是额外委托…",
                                            "response": [
                                                {
                                                    "id": "411260122",
                                                    "speaker": "嘉义",
                                                    "text": "呃，这个…放心吧，我肯定会准备好合适的报酬。"
                                                },
                                                {
                                                    "id": "411260123",
                                                    "speaker": "嘉义",
                                                    "text": "那就拜托你了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "411260111",
                            "text": "这也是没办法的事…",
                            "response": [
                                {
                                    "id": "411260112",
                                    "speaker": "嘉义",
                                    "text": "我知道，但是…唉，我真是奇了怪了，每次我想请假的时候，总是会出点事。"
                                },
                                {
                                    "id": "411260113",
                                    "speaker": "嘉义",
                                    "text": "这也太巧了，这都叫什么事啊…"
                                },
                                {
                                    "id": "411260114",
                                    "speaker": "嘉义",
                                    "text": "那就拜托你了，把这封信送去轻策庄给小六吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112602",
            "objective": "与嘉义对话",
            "dialogues": []
        },
        {
            "id": "4112612",
            "objective": "在轻策庄周边清扫魔物",
            "dialogues": [
                {
                    "id": "411261201",
                    "speaker": "派蒙",
                    "text": "说起来…你知道小六在哪吗？"
                },
                {
                    "id": "411261202",
                    "speaker": "派蒙",
                    "text": "唔…没办法，去问问轻策庄里的人吧。"
                }
            ]
        },
        {
            "id": "4112603",
            "objective": "在轻策庄周边清扫魔物",
            "dialogues": [
                {
                    "id": "411260301",
                    "speaker": "小六",
                    "text": "真奇怪，爸爸每次请假的时候都会出点事…"
                }
            ]
        },
        {
            "id": "4112604",
            "objective": "把嘉义的信送给小六",
            "dialogues": []
        },
        {
            "id": "4112605",
            "objective": "向轻策庄里的人询问小六的去向",
            "dialogues": [
                {
                    "id": "411260501",
                    "speaker": "Player",
                    "text": "关于小六…"
                },
                {
                    "id": "411260502",
                    "speaker": "云淡",
                    "text": "小六，哦…那孩子啊，我记得她说要找个高点的地方看陨石…"
                },
                {
                    "id": "411260503",
                    "speaker": "云淡",
                    "text": "唔，好像是<color=#00E1FFFF>顺着那边的梯子爬上去</color>了吧。"
                }
            ]
        },
        {
            "id": "4112606",
            "objective": "向轻策庄里的人询问小六的去向",
            "dialogues": [
                {
                    "id": "411260601",
                    "speaker": "Player",
                    "text": "关于小六…"
                },
                {
                    "id": "411260602",
                    "speaker": "东东",
                    "text": "你问小六啊，我们本来约好了一起在这看陨石的，但她说要找个高点的地方看。"
                },
                {
                    "id": "411260603",
                    "speaker": "东东",
                    "text": "她说找到了地方之后就回来告诉我…我还真不知道她现在在哪。"
                }
            ]
        },
        {
            "id": "4112607",
            "objective": "向轻策庄里的人询问小六的去向",
            "dialogues": [
                {
                    "id": "411260701",
                    "speaker": "Player",
                    "text": "关于小六…"
                },
                {
                    "id": "411260702",
                    "speaker": "鬼伯伯",
                    "text": "小六…小六，我倒是知道这孩子，但我一直在这呆着，没见着她经过。"
                }
            ]
        },
        {
            "id": "4112608",
            "objective": "保护环$HIDDEN",
            "dialogues": [
                {
                    "id": "411260801",
                    "speaker": "小六",
                    "text": "在这里，应该就能看清楚陨石了…"
                },
                {
                    "id": "411260802",
                    "speaker": "Player",
                    "text": "有封信给你。"
                },
                {
                    "id": "411260803",
                    "speaker": "小六",
                    "text": "爸爸写给我的信…唔，我大概知道里面写了什么…"
                },
                {
                    "id": "411260804",
                    "speaker": "小六",
                    "text": "肯定是说，他又因为工作没法回来陪我了。"
                },
                {
                    "id": "411260805",
                    "speaker": "小六",
                    "text": "那些千岩军叔叔过来的时候，我还以为爸爸也会一起来呢，结果他还是没来…"
                },
                {
                    "id": "411260806",
                    "speaker": "小六",
                    "text": "不过也好，那么多大石头从天上掉下来，要是爸爸在野外的话，说不定会有危险。",
                    "choices": [
                        {
                            "id": "411260807",
                            "text": "你害怕吗？",
                            "response": [
                                {
                                    "id": "411260808",
                                    "speaker": "小六",
                                    "text": "嗯…有一点点，但是有千岩军叔叔在这里呢，不会有问题的。"
                                },
                                {
                                    "id": "411260811",
                                    "speaker": "小六",
                                    "text": "对了，那你帮我把这封信送给爸爸吧，他肯定担心我了。"
                                },
                                {
                                    "id": "411260812",
                                    "speaker": "小六",
                                    "text": "唉…真奇怪，爸爸每次说要请假回来陪我的时候，都会出点事让他没法回来…"
                                }
                            ]
                        },
                        {
                            "id": "411260809",
                            "text": "别去野外。",
                            "response": [
                                {
                                    "id": "411260810",
                                    "speaker": "小六",
                                    "text": "我知道，那些千岩军叔叔不知道说了多少遍了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112609",
            "objective": "把嘉义的信交给小六",
            "dialogues": []
        },
        {
            "id": "4112610",
            "objective": "向嘉义回报",
            "dialogues": [
                {
                    "id": "411261001",
                    "speaker": "嘉义",
                    "text": "谢谢，旅行者。这封信我先收着，现在可不是读信的时候…我马上要出去执行任务了。"
                },
                {
                    "id": "411261002",
                    "speaker": "嘉义",
                    "text": "这是给你的报酬，辛苦你了。"
                },
                {
                    "id": "411261003",
                    "speaker": "嘉义",
                    "text": "等这次事情过去，我一定要请个长假…"
                }
            ]
        },
        {
            "id": "4112611",
            "objective": "与嘉义对话",
            "dialogues": []
        },
        {
            "id": "4112602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411260201",
                    "speaker": "嘉义",
                    "text": "唉，我这个假到底什么时候才能请到…"
                }
            ]
        },
        {
            "id": "4112609",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411260901",
                    "speaker": "嘉义",
                    "text": "你回来了，信送到了吗？"
                },
                {
                    "id": "411260902",
                    "speaker": "Player",
                    "text": "送到了，这是小六给你的信。"
                },
                {
                    "id": "411260903",
                    "speaker": "嘉义",
                    "text": "小六给我写了信？我看看…"
                }
            ]
        }
    ]
