    "talks": [
        {
            "id": "1103201",
            "objective": "前往新月轩赴宴",
            "dialogues": []
        },
        {
            "id": "1103202",
            "objective": "与慧心对话",
            "dialogues": [
                {
                    "id": "110320201",
                    "speaker": "慧心",
                    "text": "甘雨前辈，感谢您的赏光。还有这二位，也感谢你们能来捧场。"
                },
                {
                    "id": "110320202",
                    "speaker": "派蒙",
                    "text": "小事小事！"
                },
                {
                    "id": "110320203",
                    "speaker": "甘雨",
                    "text": "辛苦慧心安排了，明明不用如此费周折的。"
                },
                {
                    "id": "110320204",
                    "speaker": "慧心",
                    "text": "呵呵，其实…甘雨前辈，除了感谢您之前的帮助，还有些事情想要跟您讲…"
                },
                {
                    "id": "110320205",
                    "speaker": "甘雨",
                    "text": "哦？有什么需要帮忙的，你都可以跟我直说，不需要避讳什么的。"
                },
                {
                    "id": "110320206",
                    "speaker": "慧心",
                    "text": "啊…不不，其实也不算是需要帮忙…嗯…您可以慢慢听我说吗？"
                },
                {
                    "id": "110320207",
                    "speaker": "甘雨",
                    "text": "我非常愿意。"
                },
                {
                    "id": "110320208",
                    "speaker": "慧心",
                    "text": "呵呵…我从很小很小的时候，就曾听父亲讲过很多有关甘雨前辈的故事。"
                },
                {
                    "id": "110320209",
                    "speaker": "慧心",
                    "text": "虽然我对父亲也一直非常敬佩，但每次都还是会被甘雨前辈的温柔可靠所吸引…"
                },
                {
                    "id": "110320210",
                    "speaker": "慧心",
                    "text": "我那时是如此向往着您的身影，也正是因此才决定来到月海亭工作。"
                },
                {
                    "id": "110320211",
                    "speaker": "甘雨",
                    "text": "原来在你眼里的我，是这样…"
                },
                {
                    "id": "110320212",
                    "speaker": "慧心",
                    "text": "不过事实上，作为月海亭秘书的工作还是非常辛苦的。"
                },
                {
                    "id": "110320213",
                    "speaker": "慧心",
                    "text": "我没有您那样优秀的工作能力，因而时不时总是会怀疑自己…"
                },
                {
                    "id": "110320214",
                    "speaker": "甘雨",
                    "text": "没有的事，慧心已经做得很好了。"
                },
                {
                    "id": "110320215",
                    "speaker": "慧心",
                    "text": "呵呵，谢谢前辈。"
                },
                {
                    "id": "110320216",
                    "speaker": "慧心",
                    "text": "这些年，我也有了自己的女儿…"
                },
                {
                    "id": "110320217",
                    "speaker": "派蒙",
                    "text": "欸！原来天叔已经当爷爷了！"
                },
                {
                    "id": "110320218",
                    "speaker": "慧心",
                    "text": "我的女儿在我的熏陶下，如今也继承了我当年的理想——成为月海亭的秘书。"
                },
                {
                    "id": "110320219",
                    "speaker": "慧心",
                    "text": "起初我会有些担心，毕竟这份工作并不容易，目前也还看不出她是否有这样的资质。"
                },
                {
                    "id": "110320220",
                    "speaker": "慧心",
                    "text": "但经过这次的事之后…我现在很坚定，会选择支持她。"
                },
                {
                    "id": "110320221",
                    "speaker": "甘雨",
                    "text": "欸，是什么会让你觉得…"
                },
                {
                    "id": "110320222",
                    "speaker": "慧心",
                    "text": "因为她以后也会遇上一位叫做甘雨的前辈。"
                },
                {
                    "id": "110320223",
                    "speaker": "慧心",
                    "text": "甘雨前辈会温柔地帮助她，并且跟她说，你妈妈当年是这样做的…"
                },
                {
                    "id": "110320224",
                    "speaker": "慧心",
                    "text": "想到那副画面，可真是美好。"
                },
                {
                    "id": "110320225",
                    "speaker": "慧心",
                    "text": "所以——二十年后的事也拜托前辈您了。"
                },
                {
                    "id": "110320226",
                    "speaker": "甘雨",
                    "text": "慧心…"
                },
                {
                    "id": "110320227",
                    "speaker": "甘雨",
                    "text": "…我、我从没想过，我的存在对你来说还有这样的意义…"
                },
                {
                    "id": "110320228",
                    "speaker": "慧心",
                    "text": "呵呵，就像前辈您之前向我展示我父亲的做法一样，有您在「见证」，就会让人感觉很安心。"
                },
                {
                    "id": "110320229",
                    "speaker": "甘雨",
                    "text": "「见证」…"
                },
                {
                    "id": "110320230",
                    "speaker": "甘雨",
                    "text": "…我确实，在见证着璃月港这几千年的时光。不论发展变迁，还是人情世故…"
                },
                {
                    "id": "110320231",
                    "speaker": "甘雨",
                    "text": "但我曾以为，这除了带给我孤独之外，并没有什么其他的意义。"
                },
                {
                    "id": "110320232",
                    "speaker": "甘雨",
                    "text": "慧心，你刚才的话对我来说，非常重要…"
                },
                {
                    "id": "110320233",
                    "speaker": "甘雨",
                    "text": "让我真正感觉到，除了岩王帝君与我订下的「契约」外，我与璃月港的这片人海之间的联系。"
                },
                {
                    "id": "110320234",
                    "speaker": "甘雨",
                    "text": "体会到被依赖，被认可，被渴望见证的感觉。"
                },
                {
                    "id": "110320235",
                    "speaker": "慧心",
                    "text": "当然了，您可是我们独一无二的甘雨前辈呀！"
                },
                {
                    "id": "110320236",
                    "speaker": "甘雨",
                    "text": "呵呵…是啊，所以要好好回应大家才行。"
                },
                {
                    "id": "110320237",
                    "speaker": "派蒙",
                    "text": "这才对嘛！甘雨小姐终于振作起来了！"
                },
                {
                    "id": "110320238",
                    "speaker": "甘雨",
                    "text": "哪怕我真的被排挤了，我也希望还能争取一下…"
                },
                {
                    "id": "110320239",
                    "speaker": "甘雨",
                    "text": "为了不辜负你对我的托付，我也还想继续履行「契约」，继续作为「七星」的秘书。",
                    "choices": [
                        {
                            "id": "110320240",
                            "text": "唉…我从一开始就说过…",
                            "response": [
                                {
                                    "id": "110320242",
                                    "speaker": "甘雨",
                                    "text": "总之，我现在要回去看看。"
                                },
                                {
                                    "id": "110320243",
                                    "speaker": "甘雨",
                                    "text": "没有我在的话，那些事务的处理恐怕正乱作一团吧。"
                                },
                                {
                                    "id": "110320244",
                                    "speaker": "甘雨",
                                    "text": "工作，工作，没时间可以这样浪费了！"
                                },
                                {
                                    "id": "110320245",
                                    "speaker": "慧心",
                                    "text": "请加油！甘雨前辈！"
                                },
                                {
                                    "id": "110320246",
                                    "speaker": "派蒙",
                                    "text": "欸欸！就这样要走了吗，我还没吃饱呢！"
                                }
                            ]
                        },
                        {
                            "id": "110320241",
                            "text": "你被排挤的事是场误会。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1103203",
            "objective": "与慧心对话",
            "dialogues": []
        },
        {
            "id": "1103205",
            "objective": "与「群玉阁」的秘书们对话",
            "dialogues": []
        },
        {
            "id": "1103204",
            "objective": "与「群玉阁」的秘书们对话",
            "dialogues": [
                {
                    "id": "110320301",
                    "speaker": "百识",
                    "text": "啊…"
                },
                {
                    "id": "110320302",
                    "speaker": "百闻",
                    "text": "阿识，你还好吗…难道说站着睡着了…"
                },
                {
                    "id": "110320303",
                    "speaker": "百晓",
                    "text": "你们看…你们看看是谁来了！"
                },
                {
                    "id": "110320304",
                    "speaker": "甘雨",
                    "text": "居然还有闲情雅致在这里偷懒，看来你们确实有接替我的能力。"
                },
                {
                    "id": "110320305",
                    "speaker": "百闻",
                    "text": "没有没有！我们只是…真的连续工作了太久，如果不出来稍微歇歇…"
                },
                {
                    "id": "110320306",
                    "speaker": "百晓",
                    "text": "恐怕就熬不到见到甘雨小姐的这天了…"
                },
                {
                    "id": "110320307",
                    "speaker": "百识",
                    "text": "甘雨小姐，我们好想你…"
                },
                {
                    "id": "110320308",
                    "speaker": "甘雨",
                    "text": "唔，我好像和各位只有过一面之缘而已，竟然说得这么亲昵…"
                },
                {
                    "id": "110320309",
                    "speaker": "百闻",
                    "text": "因为我们最近日日夜夜都在盼着您回来，把工作重新接手…"
                },
                {
                    "id": "110320310",
                    "speaker": "百识",
                    "text": "您的出现对我们来说，就像仙人下凡拯救苍生一样…"
                },
                {
                    "id": "110320311",
                    "speaker": "百晓",
                    "text": "以往那些不服输的心情都已经不重要了，只想快点从这繁重的工作解脱…"
                },
                {
                    "id": "110320312",
                    "speaker": "甘雨",
                    "text": "好了好了，我知道了。"
                },
                {
                    "id": "110320313",
                    "speaker": "甘雨",
                    "text": "请把手上的工作按照政务、商务、民事来分开归类，标记好哪些未开始，哪些已经在进行中…"
                },
                {
                    "id": "110320314",
                    "speaker": "甘雨",
                    "text": "剩下的交给我就好。"
                },
                {
                    "id": "110320315",
                    "speaker": "百闻",
                    "text": "好的！我们现在就去办！"
                },
                {
                    "id": "110320316",
                    "speaker": "百识",
                    "text": "终于…得救了…"
                },
                {
                    "id": "110320317",
                    "speaker": "甘雨",
                    "text": "啊，对了，还有一件事…"
                },
                {
                    "id": "110320318",
                    "speaker": "甘雨",
                    "text": "旅行者，我要郑重向你道谢，多亏了你这段时间的陪伴…不然我可能还陷在内心的困境里。",
                    "choices": [
                        {
                            "id": "110320319",
                            "text": "这一路上我也很开心。",
                            "response": [
                                {
                                    "id": "110320321",
                                    "speaker": "甘雨",
                                    "text": "呵呵，在工作之外，能拥有一位人类朋友的感觉，真是超乎预想的开心呢。"
                                },
                                {
                                    "id": "110320322",
                                    "speaker": "甘雨",
                                    "text": "等我忙完手上的工作，作为回报，请让我也陪你一起…参与你的一小段旅行吧？"
                                },
                                {
                                    "id": "110320323",
                                    "speaker": "派蒙",
                                    "text": "可、可是…甘雨小姐的工作，真的忙得完吗？"
                                },
                                {
                                    "id": "110320324",
                                    "speaker": "甘雨",
                                    "text": "…欸。"
                                },
                                {
                                    "id": "110320325",
                                    "speaker": "甘雨",
                                    "text": "嗯…嗯。未来的事，那就留待未来分说吧…"
                                }
                            ]
                        },
                        {
                            "id": "110320320",
                            "text": "甘雨能振作就好。"
                        }
                    ]
                }
            ]
        }
    ]
}