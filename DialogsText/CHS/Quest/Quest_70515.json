    "talks": [
        {
            "id": "7051501",
            "objective": "与菲利斯·尤格对话",
            "dialogues": [
                {
                    "id": "705150101",
                    "speaker": "菲利斯·尤格",
                    "text": "太棒了！整整六幅「恒动械画」部件！接下来，我们只需要再把他们全都拼起来…"
                },
                {
                    "id": "705150102",
                    "speaker": "Player",
                    "text": "全、全都拼起来？"
                },
                {
                    "id": "705150103",
                    "speaker": "菲利斯·尤格",
                    "text": "那是当然，这六幅小型的「恒动械画」部件可以再次组装！"
                },
                {
                    "id": "705150104",
                    "speaker": "菲利斯·尤格",
                    "text": "拼接成一幅…庞大的！绝美的…大型「恒动械画」。"
                },
                {
                    "id": "705150105",
                    "speaker": "菲利斯·尤格",
                    "text": "来吧，接下来我们只需要把它们都拼接起来就行了。",
                    "choices": [
                        {
                            "id": "705150106",
                            "text": "不用烧铸什么的…",
                            "response": [
                                {
                                    "id": "705150108",
                                    "speaker": "菲利斯·尤格",
                                    "text": "不，不不不不，绝对不，我的机器不是那种被笨拙地强捏在一起的金属垃圾。"
                                },
                                {
                                    "id": "705150109",
                                    "speaker": "菲利斯·尤格",
                                    "text": "每一个零件，都简洁又巧妙地拼接在一起，就像是…呃…就像是…"
                                },
                                {
                                    "id": "705150110",
                                    "speaker": "菲利斯·尤格",
                                    "text": "算了，打比方的事我从来不在行，我在修辞学方面的灵感全让泽维尔给偷走了。"
                                },
                                {
                                    "id": "705150111",
                                    "speaker": "菲利斯·尤格",
                                    "text": "总之，请您来亲手试试吧，相信我，这会很有趣的。"
                                }
                            ]
                        },
                        {
                            "id": "705150107",
                            "text": "需要什么额外工艺吗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051502",
            "objective": "拼接「恒动械画」",
            "dialogues": [
                {
                    "id": "705150201",
                    "speaker": "菲利斯·尤格",
                    "text": "完美，太美丽了！您的理解力和动手能力真不错，真是超乎我的预料。"
                },
                {
                    "id": "705150202",
                    "speaker": "菲利斯·尤格",
                    "text": "哈，《蒸汽鸟日报》还有几篇荒谬的稿件把您形容地就像是一个…一个…",
                    "choices": [
                        {
                            "id": "705150203",
                            "text": "一个…",
                            "response": [
                                {
                                    "id": "705150205",
                                    "speaker": "菲利斯·尤格",
                                    "text": "呵…呵呵…一个…乐于用剑来说服人的…直爽勇者…"
                                },
                                {
                                    "id": "705150206",
                                    "speaker": "菲利斯·尤格",
                                    "text": "荒谬，愚蠢！写这几篇稿件的记者简直是无事生非！您明明是一位敏锐、聪慧、谦逊…又直爽的勇者！"
                                },
                                {
                                    "id": "705150207",
                                    "speaker": "菲利斯·尤格",
                                    "text": "等我有空了，我一定要写封信去狠狠驳斥他们！"
                                },
                                {
                                    "id": "705150208",
                                    "speaker": "菲利斯·尤格",
                                    "text": "对了，这份机关就请您收下吧，无聊的时候，您可以用它来解闷。"
                                },
                                {
                                    "id": "705150209",
                                    "speaker": "菲利斯·尤格",
                                    "text": "而我嘛…嗯…我得开始筹措去璃月的路费了…"
                                }
                            ]
                        },
                        {
                            "id": "705150204",
                            "text": "你接着说。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051503",
            "objective": "和菲利斯·尤格对话",
