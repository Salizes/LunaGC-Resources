            "dialogues": [
                {
                    "id": "732470201",
                    "speaker": "Player",
                    "text": "好啊，我们玩什么？"
                },
                {
                    "id": "732470202",
                    "speaker": "兰钵答",
                    "text": "兰钵答收集了很多「什物」，先给那菈朋友「涨涨见识」，但是一小会儿之后，兰钵答要把「什物」收起来…"
                },
                {
                    "id": "732470203",
                    "speaker": "兰钵答",
                    "text": "那菈记性好，兰钵答所想的那件「什物」到底有几个，那菈肯定记住了吧？"
                },
                {
                    "id": "732470204",
                    "speaker": "兰钵答",
                    "text": "好那菈，准备好了吗？"
                },
                {
                    "id": "732470205",
                    "speaker": "Player",
                    "text": "开始吧。"
                }
            ]
        },
        {
            "id": "7324703",
            "objective": "",
            "dialogues": [
                {
                    "id": "732470301",
                    "speaker": "Player",
                    "text": "下次一定。"
                },
                {
                    "id": "732470302",
                    "speaker": "兰钵答",
                    "text": "兰钵答会耐心等！"
                }
            ]
        },
        {
            "id": "7324704",
            "objective": "",
            "dialogues": [
                {
                    "id": "732470501",
                    "speaker": "Player",
                    "text": "3个。"
                },
                {
                    "id": "732470502",
                    "speaker": "兰钵答",
                    "text": "金色的那菈，果然不会忘记！"
                },
                {
                    "id": "732470503",
                    "speaker": "兰钵答",
                    "text": "金色的那菈厉害，兰钵答有好东西送给厉害的那菈！"
                }
            ]
        },
        {
            "id": "7324701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470101",
                    "speaker": "兰钵答",
                    "text": "那菈朋友！来和兰钵答玩游戏吧！"
                }
            ]
        },
        {
            "id": "7324704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470401",
                    "speaker": "兰钵答",
                    "text": "那菈朋友，兰钵答所想的是<color=#00E1FFFF>草元素的亮晶晶</color>！刚才的一小会儿，那菈所见的有几个呢？"
                }
            ]
        },
        {
            "id": "7324706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732470601",
                    "speaker": "Player",
                    "text": "2个。"
                },
                {
                    "id": "732470602",
                    "speaker": "兰钵答",
                    "text": "糊涂那菈，记得不对。"
                },
                {
                    "id": "732470603",
                    "speaker": "兰钵答",
                    "text": "唔唔，兰钵答有很多「机会」，可以分给那菈。还想挑战的话，再来找兰钵答吧！"
                }
