    "talks": [
        {
            "id": "7409101",
            "objective": "与艾古伊对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740910101",
                    "speaker": "艾古伊",
                    "text": "那小子，该不会被丘丘人抓去煮汤了吧…",
                    "choices": [
                        {
                            "id": "740910102",
                            "text": "谁被抓走了？",
                            "response": [
                                {
                                    "id": "740910105",
                                    "speaker": "艾古伊",
                                    "text": "那边，你们瞧，能看到水上的丘丘人营地吧？"
                                },
                                {
                                    "id": "740910106",
                                    "speaker": "艾古伊",
                                    "text": "简直就像一夜之间突然冒出来的，该休息的时间不休息，拼命干活，哎哟，和巴朗那臭小子一模一样。"
                                },
                                {
                                    "id": "740910107",
                                    "speaker": "艾古伊",
                                    "text": "依我看，他要是走运，现在没在锅里，那说不定正跟丘丘人聊得火热呢。"
                                },
                                {
                                    "id": "740910108",
                                    "speaker": "派蒙",
                                    "text": "欸？你的意思是说，你认识的人被那边的丘丘人抓走了？你怎么一点也不着急，如果是真的，得赶紧救人呀。"
                                },
                                {
                                    "id": "740910109",
                                    "speaker": "艾古伊",
                                    "text": "救人？救什么人？我早跟他说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。"
                                },
                                {
                                    "id": "740910110",
                                    "speaker": "艾古伊",
                                    "text": "我好心教他，可他小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。"
                                },
                                {
                                    "id": "740910111",
                                    "speaker": "艾古伊",
                                    "text": "既然他不把老前辈的经验和智慧当回事，那我只好说，都是他自己选的，年轻人就该吃点苦头，不吃点教训怎么能成长。",
                                    "choices": [
                                        {
                                            "id": "740910112",
                                            "text": "只听一面之词难以评判。",
                                            "response": [
                                                {
                                                    "id": "740910114",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，现在救人要紧。"
                                                },
                                                {
                                                    "id": "740910115",
                                                    "speaker": "艾古伊",
                                                    "text": "危险得很呀！你们这些小孩子，受伤了怎么办？"
                                                },
                                                {
                                                    "id": "740910116",
                                                    "speaker": "派蒙",
                                                    "text": "#那你就放心好啦，{NICKNAME}很强的！老爷爷在这里等等好了，我们去去就回！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740910113",
                                            "text": "万一遇险了，命都没了还怎么成长。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740910103",
                            "text": "什么汤？",
                            "response": [
                                {
                                    "id": "740910104",
                                    "speaker": "派蒙",
                                    "text": "重点在这里吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7409112",
            "objective": "(test)（隐藏）前往区域搜寻巴朗$HIDDEN",
            "dialogues": [
                {
                    "id": "740911201",
                    "speaker": "艾古伊",
                    "text": "要是为了救巴朗那臭小子害你们受伤，到时让他给你们赔罪，让他休假照顾你们！"
                }
            ]
        },
        {
            "id": "7409102",
            "objective": "前往水上丘丘人营地寻找巴朗",
            "dialogues": []
        },
        {
            "id": "7409115",
            "objective": "解救被困的人",
            "dialogues": [
                {
                    "id": "740911501",
                    "speaker": "巴朗",
                    "text": "怎么了，遇到麻烦了吗？是检修工作有哪里不明白吗？我再给你们讲讲！",
                    "choices": [
                        {
                            "id": "740911506",
                            "text": "再听一遍说明。",
                            "response": [
                                {
                                    "id": "740911502",
                                    "speaker": "巴朗",
                                    "text": "如果在水下发现管道有<color=#00E1FFFF>气体外泄</color>的情况，应该是水下生物…或者是非生物的冲撞导致的。"
                                },
                                {
                                    "id": "740911503",
                                    "speaker": "巴朗",
                                    "text": "应急处理的方法是<color=#00E1FFFF>控制调节阀调整流量，暂时止住气体外泄</color>。你们只需要做到这种程度就好了。"
                                },
                                {
                                    "id": "740911504",
                                    "speaker": "巴朗",
                                    "text": "调节阀的操作是有技巧的，<color=#00E1FFFF>转动手轮时需要观察气体流量，如果气体流量变小了，就说明思路没问题</color>。"
                                },
                                {
                                    "id": "740911505",
                                    "speaker": "巴朗",
                                    "text": "应该没有那么难的，就拜托你们了。"
                                }
                            ]
                        },
                        {
                            "id": "740911507",
                            "text": "不用了。",
                            "response": [
                                {
                                    "id": "740911508",
                                    "speaker": "巴朗",
                                    "text": "那就拜托了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7409103",
            "objective": "解救巴朗",
            "dialogues": []
        },
        {
            "id": "7409113",
            "objective": "与被困的人对话",
            "dialogues": [
                {
                    "id": "740910401",
                    "speaker": "？？？",
                    "text": "两位…好心人…谢谢你们…"
                },
                {
                    "id": "740910402",
                    "speaker": "派蒙",
                    "text": "你没事吧？"
                },
                {
                    "id": "740910403",
                    "speaker": "？？？",
                    "text": "我…我…还行…大概还行…"
                },
                {
                    "id": "740910404",
                    "speaker": "Player",
                    "text": "看起来快不行了。"
                },
                {
                    "id": "740910405",
                    "speaker": "？？？",
                    "text": "麻…麻烦两位带我去那边的码头…我…我…"
                },
                {
                    "id": "740910406",
                    "speaker": "派蒙",
                    "text": "你还是先别说话了，我们带你回去就是了！"
                }
            ]
        },
        {
            "id": "7409104",
            "objective": "与巴朗对话",
            "dialogues": [
                {
                    "id": "740911301",
                    "speaker": "巴朗",
                    "text": "两位…好心人…谢谢你们…"
                },
                {
                    "id": "740911302",
                    "speaker": "派蒙",
                    "text": "你没事吧？"
                },
                {
                    "id": "740911303",
                    "speaker": "巴朗",
                    "text": "我…我…还行…大概还行…"
                },
                {
                    "id": "740911304",
                    "speaker": "Player",
                    "text": "看起来快不行了。"
                },
                {
                    "id": "740911305",
                    "speaker": "派蒙",
                    "text": "你还是快点跟我们回码头那边吧！"
                }
            ]
        },
        {
            "id": "7409114",
            "objective": "前往码头",
            "dialogues": [
                {
                    "id": "740910501",
                    "speaker": "？？？",
                    "text": "艾古伊先生，我…我回来了…"
                },
                {
                    "id": "740910502",
                    "speaker": "艾古伊",
                    "text": "你们是…看样子是你们救了巴朗，谢谢你们。"
                },
                {
                    "id": "740910503",
                    "speaker": "艾古伊",
                    "text": "你这臭小子…我早跟你说了，危险的工作没必要自己拼命，等艾蒂安定期联络的时候报告一声，让艾蒂安找人处理就行了。"
                },
                {
                    "id": "740910504",
                    "speaker": "艾古伊",
                    "text": "我当初好心教你，可你小子是什么嘴脸？反过来指责我工作不认真，玩忽职守。"
                },
                {
                    "id": "740910505",
                    "speaker": "艾古伊",
                    "text": "看看，我说什么来着？太危险了，你应付不来。你还不信，现在吃到教训了吧？"
                },
                {
                    "id": "740910506",
                    "speaker": "巴朗",
                    "text": "我…我…"
                },
                {
                    "id": "740910507",
                    "speaker": "艾古伊",
                    "text": "怎么，你还想嘴硬？我倒要听听，你还有什么高见。"
                },
                {
                    "id": "740910508",
                    "speaker": "巴朗",
                    "text": "让我喝口水…"
                },
                {
                    "id": "740910509",
                    "speaker": "Black Screen",
                    "text": "巴朗找到水瓶，咕噜咕噜猛灌了几口，接着又掰了一块干面包嚼了起来。\\n其间不管老人说什么，他都好像没听见似的，只顾吃喝。"
                },
                {
                    "id": "740910510",
                    "speaker": "巴朗",
                    "text": "呼…总算是…总算是活下来了。感谢两位相助，不然我恐怕是…"
                },
                {
                    "id": "740910511",
                    "speaker": "艾古伊",
                    "text": "恐怕是只能留下些抚恤金给你的父母了。"
                },
                {
                    "id": "740910512",
                    "speaker": "巴朗",
                    "text": "哼，那也比因为玩忽职守而导致重大安全事故最后被革职要强得多。"
                },
                {
                    "id": "740910513",
                    "speaker": "艾古伊",
                    "text": "臭小子…唉，真是跟你说不通！"
                },
                {
                    "id": "740910514",
                    "speaker": "巴朗",
                    "text": "两位，虽然这么说非常厚脸皮…可是我必须说，这也是为了大家的安全。"
                },
                {
                    "id": "740910515",
                    "speaker": "巴朗",
                    "text": "两位应该会潜水吧？"
                },
                {
                    "id": "740910516",
                    "speaker": "派蒙",
                    "text": "会倒是会…"
                },
                {
                    "id": "740910517",
                    "speaker": "巴朗",
                    "text": "我被丘丘人抓住的时候，潜水服也丢失了，此前例行检查时发现备用品损坏了，虽然重新申请了，但还没送到…"
                },
                {
                    "id": "740910518",
                    "speaker": "巴朗",
                    "text": "但是管道的维护工作不能怠慢，两位会潜水的话，能否麻烦两位代替我下水检查一下梅洛彼得堡的管道。"
                },
                {
                    "id": "740910519",
                    "speaker": "巴朗",
                    "text": "当然，酬劳我一定会准备好，不会亏待两位。"
                },
                {
                    "id": "740910520",
                    "speaker": "派蒙",
                    "text": "既然关系到大家的安全，这忙我们也不是不能帮。但是检查管道听起来好像是很专业的工作，交给我们真的没问题吗？"
                },
                {
                    "id": "740910521",
                    "speaker": "巴朗",
                    "text": "只是例行检查而已，我估计是会有一些小问题，上次检查的时候就发现有四处风险…但处理起来应该不会太难，我给你们讲讲！"
                },
                {
                    "id": "740910522",
                    "speaker": "巴朗",
                    "text": "如果在水下发现管道有<color=#00E1FFFF>气体外泄</color>的情况，应该是水下生物…或者是非生物的冲撞导致的。"
                },
                {
                    "id": "740910523",
                    "speaker": "巴朗",
                    "text": "应急处理的方法是<color=#00E1FFFF>控制调节阀调整流量，暂时止住气体外泄</color>。你们只需要做到这种程度就好了。"
                },
                {
                    "id": "740910527",
                    "speaker": "巴朗",
                    "text": "调节阀的操作是有技巧的，<color=#00E1FFFF>转动手轮时需要观察气体流量，如果气体流量变小了，就说明思路没问题</color>。"
                },
                {
                    "id": "740910524",
                    "speaker": "派蒙",
                    "text": "哦…好像听懂了！"
                },
                {
                    "id": "740910525",
                    "speaker": "巴朗",
                    "text": "如果还有哪里不明白，在例行检查完成之前，有任何问题我随时为两位解答。"
                },
                {
                    "id": "740910526",
                    "speaker": "派蒙",
                    "text": "好吧，总之我们先去试试！"
                }
            ]
        },
