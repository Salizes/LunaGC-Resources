    "talks": [
        {
            "id": "7601904",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7601901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760190101",
                    "speaker": "派蒙",
                    "text": "「识者之证」？难道是…"
                },
                {
                    "id": "760190102",
                    "speaker": "维里",
                    "text": "你、你们凑过来干什么，我们在谈很秘密的话题，关于雷德·米勒「伟大财宝」的线索…",
                    "choices": [
                        {
                            "id": "760190103",
                            "text": "太好了，也算我一份吧。",
                            "response": [
                                {
                                    "id": "760190105",
                                    "speaker": "维里",
                                    "text": "唔…对了，既然这样，那我们组队好了，我正愁凑不齐启动资金呢。"
                                },
                                {
                                    "id": "760190106",
                                    "speaker": "维里",
                                    "text": "我一个，你一个，还有会飞的一个，一共三份，我们三个正好，一人五十万摩拉。"
                                },
                                {
                                    "id": "760190107",
                                    "speaker": "派蒙",
                                    "text": "五十万摩拉？！"
                                },
                                {
                                    "id": "760190108",
                                    "speaker": "希丁芭",
                                    "text": "唉，维里小弟，不是说好了这是我们两个之间的秘密吗？我是信任你，才会告诉你的。"
                                },
                                {
                                    "id": "760190109",
                                    "speaker": "维里",
                                    "text": "可是一百五十万摩拉，对我来说实在不是启动资金级别的数目呀，五十万还勉强能够凑齐…"
                                },
                                {
                                    "id": "760190110",
                                    "speaker": "维里",
                                    "text": "他们两个看起来也像是有经验的冒险者，我们组队的话，成功概率不是更高吗？"
                                },
                                {
                                    "id": "760190111",
                                    "speaker": "希丁芭",
                                    "text": "#唉，我是很看好维里小弟的，既然{M#他们}{F#她们}是你看好的人选，那我也愿意交往。"
                                },
                                {
                                    "id": "760190112",
                                    "speaker": "希丁芭",
                                    "text": "不过呢，这位会飞的朋友，体型和咱们不一样，自然要特别关照。"
                                },
                                {
                                    "id": "760190113",
                                    "speaker": "派蒙",
                                    "text": "哇，是有什么礼物要送给我吗？"
                                },
                                {
                                    "id": "760190114",
                                    "speaker": "希丁芭",
                                    "text": "嗯，因为是特别定制的，相比纳塔原版的「强水」，能够适应的人群也更广，会飞的朋友当然也能放心使用。"
                                },
                                {
                                    "id": "760190115",
                                    "speaker": "希丁芭",
                                    "text": "至于价格嘛，要是别人，按理是得收两百万摩拉的，但看在你们是维里小弟的朋友的份上，就只要一百万摩拉好了。"
                                },
                                {
                                    "id": "760190116",
                                    "speaker": "派蒙",
                                    "text": "一百万摩拉？！",
                                    "choices": [
                                        {
                                            "id": "760190117",
                                            "text": "是惊喜大礼啊，派蒙！",
                                            "response": [
                                                {
                                                    "id": "760190118",
                                                    "speaker": "派蒙",
                                                    "text": "根本就是惊吓才对吧！"
                                                },
                                                {
                                                    "id": "760190121",
                                                    "speaker": "维里",
                                                    "text": "就是啊，希丁芭小姐，会飞的这个原本我就没指望她能派上用场，「强水」就不必分给她了吧？"
                                                },
                                                {
                                                    "id": "760190122",
                                                    "speaker": "派蒙",
                                                    "text": "等一下，你这根本就不是在帮我说话吧？"
                                                },
                                                {
                                                    "id": "760190123",
                                                    "speaker": "派蒙",
                                                    "text": "哼，原本只是想听听看有没有宝物的线索，结果你们两个家伙，根本就是一个坏一个笨！"
                                                },
                                                {
                                                    "id": "760190124",
                                                    "speaker": "派蒙",
                                                    "text": "#想要骗我和{NICKNAME}可没那么容易！"
                                                },
                                                {
                                                    "id": "760190125",
                                                    "speaker": "希丁芭",
                                                    "text": "谁是坏人？谁在欺骗？线索是真的，货品也半分不假，至于价钱嘛…那也是你情我愿的买卖。而像你这样聒噪的小东西…"
                                                },
                                                {
                                                    "id": "760190126",
                                                    "speaker": "希丁芭",
                                                    "text": "…我呢，最看不惯的就是你这样自以为是的家伙了，明明自己没多大本事，却腆着脸狐假虎威。"
                                                },
                                                {
                                                    "id": "760190127",
                                                    "speaker": "维里",
                                                    "text": "希、希丁芭小姐…？"
                                                },
                                                {
                                                    "id": "760190128",
                                                    "speaker": "希丁芭",
                                                    "text": "维里小弟也是，既然是秘密的话题，当然要贴近了，小声地说，可你呢，却大着嗓门把这两个不速之客招来。"
                                                },
                                                {
                                                    "id": "760190129",
                                                    "speaker": "希丁芭",
                                                    "text": "我现在烦得很，不让你们吃点教训，实在是心火难消呀。"
                                                },
                                                {
                                                    "id": "760190130",
                                                    "speaker": "希丁芭",
                                                    "text": "看招！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760190119",
                                            "text": "五十万摩拉，不卖我就走了。",
                                            "response": [
                                                {
                                                    "id": "760190120",
                                                    "speaker": "派蒙",
                                                    "text": "你怎么开始砍价了？我们根本不需要这种东西吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760190104",
                            "text": "已经被人听到就算不上秘密了。"
                        }
                    ]
                }
            ]
        },
