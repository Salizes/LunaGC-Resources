        {
            "id": "7601903",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760190301",
                    "speaker": "希丁芭",
                    "text": "…要杀要剐，悉听尊便了。"
                },
                {
                    "id": "760190302",
                    "speaker": "派蒙",
                    "text": "#呜啊，我跟{NICKNAME}才不会做这么可怕的事！只要你之后不要再骗人就好啦。"
                },
                {
                    "id": "760190303",
                    "speaker": "派蒙",
                    "text": "就算是维里这样的笨蛋…欸？那家伙什么时候溜了？总、总之就算是他那样的笨蛋也不能骗。"
                },
                {
                    "id": "760190304",
                    "speaker": "希丁芭",
                    "text": "你们真善良，唉，如果我在须弥的时候也遇到像你们这样善良的人，也许就不会落到今天的下场了吧。"
                },
                {
                    "id": "760190305",
                    "speaker": "希丁芭",
                    "text": "……"
                },
                {
                    "id": "760190306",
                    "speaker": "希丁芭",
                    "text": "你们不问我遭遇了什么吗？",
                    "choices": [
                        {
                            "id": "760190307",
                            "text": "我的直觉让我别继续追问了。",
                            "response": [
                                {
                                    "id": "760190309",
                                    "speaker": "希丁芭",
                                    "text": "真是敏锐的小鬼…唉，最近一段时间都没开过张，也许是时候改行了，我也不想被伏尼契商会盯上。"
                                },
                                {
                                    "id": "760190310",
                                    "speaker": "派蒙",
                                    "text": "如果你能早点这么想，刚才就不用白白挨打啦！"
                                },
                                {
                                    "id": "760190311",
                                    "speaker": "希丁芭",
                                    "text": "做出人生抉择时总归需要一个契机嘛，不管是好是坏。"
                                },
                                {
                                    "id": "760190312",
                                    "speaker": "希丁芭",
                                    "text": "#{M#小弟}{F#小妹}，还有会飞的小东西，如果你们需要这个契机，可以随时来找我…"
                                },
                                {
                                    "id": "760190313",
                                    "speaker": "派蒙",
                                    "text": "还、还是算了吧！"
                                },
                                {
                                    "id": "760190314",
                                    "speaker": "Black Screen",
                                    "text": "希丁芭留下红绸，摆摆手离开了…"
                                }
                            ]
                        },
                        {
                            "id": "760190308",
                            "text": "给我两百万摩拉我就问。"
                        }
                    ]
                }
            ]
        }
    ]
