                                                    "id": "740830159",
                                                    "speaker": "派蒙",
                                                    "text": "#哎呀，{NICKNAME}，你看珀西芙都不太会说话，肯定找不到其他人帮忙了，我们就帮帮她吧？"
                                                },
                                                {
                                                    "id": "740830160",
                                                    "speaker": "Player",
                                                    "text": "那要怎么帮忙？"
                                                },
                                                {
                                                    "id": "740830162",
                                                    "speaker": "珀西芙",
                                                    "text": "钥匙，钥匙，钥匙，数量。"
                                                },
                                                {
                                                    "id": "740830163",
                                                    "speaker": "派蒙",
                                                    "text": "然后呢？钥匙的数量是？"
                                                },
                                                {
                                                    "id": "740830164",
                                                    "speaker": "珀西芙",
                                                    "text": "钥匙！钥匙！钥匙！"
                                                },
                                                {
                                                    "id": "740830165",
                                                    "speaker": "Player",
                                                    "text": "三把钥匙？"
                                                },
                                                {
                                                    "id": "740830166",
                                                    "speaker": "珀西芙",
                                                    "text": "珀西芙！钥匙，雾道，南…"
                                                },
                                                {
                                                    "id": "740830167",
                                                    "speaker": "珀西芙",
                                                    "text": "钥匙，泉眼，北…"
                                                },
                                                {
                                                    "id": "740830168",
                                                    "speaker": "珀西芙",
                                                    "text": "钥匙，垂柳，东…"
                                                },
                                                {
                                                    "id": "740830169",
                                                    "speaker": "派蒙",
                                                    "text": "哦，原来是这个意思…那我先记一下…一共有三把钥匙，分别是南边的雾道，北边的泉眼，东边的垂柳…是这样吧？"
                                                },
                                                {
                                                    "id": "740830170",
                                                    "speaker": "珀西芙",
                                                    "text": "钥匙，钥匙，钥匙，广场，西。"
                                                },
                                                {
                                                    "id": "740830171",
                                                    "speaker": "派蒙",
                                                    "text": "西边的广场还有三把钥匙？"
                                                },
                                                {
                                                    "id": "740830172",
                                                    "speaker": "Player",
                                                    "text": "集齐三把钥匙去广场？"
                                                },
                                                {
                                                    "id": "740830173",
                                                    "speaker": "珀西芙",
                                                    "text": "#派蒙，美露莘！{NICKNAME}，珀西芙！"
                                                },
                                                {
                                                    "id": "740830174",
                                                    "speaker": "派蒙",
                                                    "text": "#哎呀，珀西芙，你不要老是说这种显得{NICKNAME}比我聪明的话嘛！明明我和{M#他}{F#她}差不多聪明才对！"
                                                },
                                                {
                                                    "id": "740830175",
                                                    "speaker": "派蒙",
                                                    "text": "总而言之，现在我们已经得到一把钥匙了，看来只要再弄到另外两把就好了。"
                                                },
                                                {
                                                    "id": "740830176",
                                                    "speaker": "珀西芙",
                                                    "text": "伊黎耶，美露莘…珀西芙，保护！"
                                                },
                                                {
                                                    "id": "740830177",
                                                    "speaker": "派蒙",
                                                    "text": "你放心啦，虽然不知道发生了什么，但我们会帮你保护伊黎耶岛的。"
                                                },
                                                {
                                                    "id": "740830178",
                                                    "speaker": "派蒙",
                                                    "text": "不过我再补充一小点哦，珀西芙，假如你碰巧看见一种没人要的，金灿灿的，圆滚滚的东西，或者一看就很贵的箱子…"
                                                },
                                                {
                                                    "id": "740830179",
                                                    "speaker": "派蒙",
                                                    "text": "能跟我们说一声就再好不过啦！"
                                                },
                                                {
                                                    "id": "740830180",
                                                    "speaker": "Black Screen",
                                                    "text": "珀西芙似懂非懂地摸了摸头，又高兴地蹦跳了两下，然后略显匆忙地离开了。"
                                                },
                                                {
                                                    "id": "740830181",
                                                    "speaker": "派蒙",
                                                    "text": "#啊，她就直接跑掉了，看来是很紧急的事啊。{NICKNAME}，我们现在就去寻找另外两把钥匙吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740830161",
                                            "text": "那要怎么帮忙？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740830110",
                            "text": "说不定是别人存放在这里的。",
                            "response": [
                                {
                                    "id": "740830111",
                                    "speaker": "派蒙",
                                    "text": "什么？完蛋了，那我们不就成小偷了？对不起对不起…我们快把东西放回去吧…"
                                },
                                {
                                    "id": "740830112",
                                    "speaker": "？？？",
                                    "text": "啊…"
                                },
                                {
                                    "id": "740830113",
                                    "speaker": "派蒙",
                                    "text": "完蛋了！主人回来了！"
                                },
                                {
                                    "id": "740830114",
                                    "speaker": "？？？",
                                    "text": "主人？美露莘。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7408302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740830201",
                    "speaker": "Black Screen",
                    "text": "一滴晶莹的水珠出现在了祭坛上。"
                },
                {
                    "id": "740830202",
                    "speaker": "派蒙",
                    "text": "太好了！这下就拿到第三把钥匙了吧。"
                },
                {
                    "id": "740830203",
                    "speaker": "珀西芙",
                    "text": "钥匙，钥匙，钥匙！"
                },
                {
                    "id": "740830204",
                    "speaker": "Player",
                    "text": "无影踪，珀西芙！"
                },
                {
                    "id": "740830205",
                    "speaker": "珀西芙",
                    "text": "#派蒙，珀西芙！{NICKNAME}，珀西芙！钥匙，钥匙，钥匙…"
                },
                {
                    "id": "740830206",
                    "speaker": "派蒙",
                    "text": "广场，西！"
                },
                {
                    "id": "740830207",
                    "speaker": "派蒙",
                    "text": "嘿嘿，你是不是想说这个啦？不要急，我们现在就过去。"
                }
            ]
        },
        {
            "id": "7408399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740839901",
                    "speaker": "派蒙",
                    "text": "这里应该就是另一个藏着钥匙的地方了吧？情况果然不太对劲的样子…"
                },
                {
                    "id": "740839907",
                    "speaker": "派蒙",
                    "text": "我们试着找找那个祭坛吧？钥匙应该和之前一样在祭坛里。"
                },
                {
                    "id": "740839902",
                    "speaker": "(test)派蒙",
                    "text": "(test)哇，怎么有这么多污秽，我们清除一下吧"
                }
            ]
        }
    ]
}