    "talks": [
        {
            "id": "201301",
            "objective": "尝试离开离岛",
            "dialogues": [
                {
                    "id": "20130101",
                    "speaker": "小林",
                    "text": "等一下！请出示「通行凭证」！"
                },
                {
                    "id": "20130102",
                    "speaker": "派蒙",
                    "text": "抱歉，我们有急事要去鸣神岛…"
                },
                {
                    "id": "20130103",
                    "speaker": "小林",
                    "text": "未持有「通行凭证」的话就请回吧，这是规矩。"
                },
                {
                    "id": "20130104",
                    "speaker": "派蒙",
                    "text": "唉…果然嘛。"
                },
                {
                    "id": "20130105",
                    "speaker": "派蒙",
                    "text": "旅行者，快想想办法，现在要怎么办才能出去呀？",
                    "choices": [
                        {
                            "id": "20130106",
                            "text": "如果社奉行的人听说过我们…",
                            "response": [
                                {
                                    "id": "20130108",
                                    "speaker": "派蒙",
                                    "text": "你是说，直接去见勘定奉行本人吗？"
                                },
                                {
                                    "id": "20130109",
                                    "speaker": "派蒙",
                                    "text": "…尽管对他手下的人很有意见，但好像也只能试试看了。"
                                },
                                {
                                    "id": "20130110",
                                    "speaker": "派蒙",
                                    "text": "万一他很崇拜我们呢？嘿嘿。"
                                }
                            ]
                        },
                        {
                            "id": "20130107",
                            "text": "勘定奉行应该也听说过吧？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201311",
            "objective": "前往勘定奉行所，询问离开离岛的方法",
            "dialogues": [
                {
                    "id": "20131101",
                    "speaker": "横山",
                    "text": "站住，这里是勘定奉行所，闲杂人等不得入内！"
                },
                {
                    "id": "20131102",
                    "speaker": "派蒙",
                    "text": "我们要见…要见那个…勘定奉行！"
                },
                {
                    "id": "20131103",
                    "speaker": "横山",
                    "text": "勘定奉行大人平时不接见外国人，快回去！不然我们就…"
                },
                {
                    "id": "20131104",
                    "speaker": "柊慎介",
                    "text": "欸，等等，等一下…"
                },
                {
                    "id": "20131105",
                    "speaker": "横山",
                    "text": "啊，奉行大人！"
                },
                {
                    "id": "20131106",
                    "speaker": "柊慎介",
                    "text": "这两位是远道而来的贵客，别再用那老一套了。"
                },
                {
                    "id": "20131107",
                    "speaker": "柊慎介",
                    "text": "来来，有事就请进来说。"
                },
                {
                    "id": "20131108",
                    "speaker": "派蒙",
                    "text": "哼，听到了吗！"
                },
                {
                    "id": "20131109",
                    "speaker": "横山",
                    "text": "非、非常抱歉。"
                }
            ]
        },
        {
            "id": "201302",
            "objective": "与勘定奉行慎介对话",
            "dialogues": [
                {
                    "id": "20130201",
                    "speaker": "柊慎介",
                    "text": "我是柊慎介，勘定奉行柊家的家主，很荣幸见到二位。",
                    "choices": [
                        {
                            "id": "20130202",
                            "text": "我也很荣幸。",
                            "response": [
                                {
                                    "id": "20130204",
                                    "speaker": "派蒙",
                                    "text": "很高兴见到你！"
                                },
                                {
                                    "id": "20130205",
                                    "speaker": "派蒙",
                                    "text": "我们这次来找你，是想…"
                                },
                                {
                                    "id": "20130206",
                                    "speaker": "柊慎介",
                                    "text": "欸，不急不急。好不容易见到闻名遐迩的两位旅者，何必这么匆忙谈正事。"
                                },
                                {
                                    "id": "20130207",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我们果然很有名气吗？"
                                },
                                {
                                    "id": "20130208",
                                    "speaker": "柊慎介",
                                    "text": "当然。能挫败风魔龙，镇压漩涡之魔神的凡人，普天之下又有几人？"
                                },
                                {
                                    "id": "20130209",
                                    "speaker": "派蒙",
                                    "text": "确实！这点说的对，嗯嗯！"
                                },
                                {
                                    "id": "20130210",
                                    "speaker": "柊慎介",
                                    "text": "还有…在璃月港破坏愚人众的计划，在决斗中战胜他们的执行官的事，也是真的？"
                                },
                                {
                                    "id": "20130211",
                                    "speaker": "派蒙",
                                    "text": "哇，连这你都知道，当然是真的啦！"
                                },
                                {
                                    "id": "20130212",
                                    "speaker": "柊慎介",
                                    "text": "嗯…果然吗。"
                                },
                                {
                                    "id": "20130213",
                                    "speaker": "派蒙",
                                    "text": "怎么了嘛？"
                                },
                                {
                                    "id": "20130214",
                                    "speaker": "柊慎介",
                                    "text": "呵呵，没什么没什么，老朽由衷敬佩二位。",
                                    "choices": [
                                        {
                                            "id": "20130215",
                                            "text": "过奖了。",
                                            "response": [
                                                {
                                                    "id": "20130217",
                                                    "speaker": "柊慎介",
                                                    "text": "…能有二位光临离岛，也是本岛的荣幸。"
                                                },
                                                {
                                                    "id": "20130218",
                                                    "speaker": "柊慎介",
                                                    "text": "早就听闻二位的热心肠，不知可否能屈尊为我们勘定奉行办些小事呢？"
                                                },
                                                {
                                                    "id": "20130219",
                                                    "speaker": "派蒙",
                                                    "text": "#尽管说吧，客气了客气了！对吧，{NICKNAME}？",
                                                    "choices": [
                                                        {
                                                            "id": "20130220",
                                                            "text": "又到了帮忙的时间，对吧？",
                                                            "response": [
                                                                {
                                                                    "id": "20130222",
                                                                    "speaker": "柊慎介",
                                                                    "text": "呵呵，那便好。这样的话…"
                                                                },
                                                                {
                                                                    "id": "20130223",
                                                                    "speaker": "柊慎介",
                                                                    "text": "清心，你知道吧，那种经常长在璃月山顶上的植物。"
                                                                },
                                                                {
                                                                    "id": "20130224",
                                                                    "speaker": "派蒙",
                                                                    "text": "知道，我们摘过，难道还要我们回一趟璃月吗？"
                                                                },
                                                                {
                                                                    "id": "20130225",
                                                                    "speaker": "柊慎介",
                                                                    "text": "嗯，就帮我摘三百株新鲜的清心来吧？要刚摘的。"
                                                                },
                                                                {
                                                                    "id": "20130226",
                                                                    "speaker": "派蒙",
                                                                    "text": "我是不是听错了什么？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "20130227",
                                                                            "text": "数量级是不是有些不对。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "20130229",
                                                                                    "speaker": "柊慎介",
                                                                                    "text": "啊？有点麻烦是吗…唔，这样啊。"
                                                                                },
                                                                                {
                                                                                    "id": "20130230",
                                                                                    "speaker": "柊慎介",
                                                                                    "text": "那不如，岛上有些信件需要派送，不知能否帮忙呢？"
                                                                                },
                                                                                {
                                                                                    "id": "20130231",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这还差不多。"
                                                                                },
                                                                                {
                                                                                    "id": "20130232",
                                                                                    "speaker": "柊慎介",
                                                                                    "text": "一共七百零九封。"
                                                                                },
                                                                                {
                                                                                    "id": "20130233",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂！怎么回事呀！而且这种事真的需要我们来吗？"
                                                                                },
                                                                                {
                                                                                    "id": "20130234",
                                                                                    "speaker": "柊慎介",
                                                                                    "text": "呵呵，真是不好意思，岛上确实有些人手不足…"
                                                                                },
                                                                                {
                                                                                    "id": "20130235",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "理由也好俗套！"
                                                                                },
                                                                                {
                                                                                    "id": "20130236",
                                                                                    "speaker": "Player",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "20130237",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "怎么办，旅行者，我们真的要帮忙吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "20130238",
                                                                                            "text": "我会考虑考虑。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "20130240",
                                                                                                    "speaker": "柊慎介",
                                                                                                    "text": "不愧是阁下，那我就等您的消息了，呵呵…"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "20130239",
                                                                                            "text": "等我先去勘察下情况。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "20130228",
                                                                            "text": "等摘完早就不新鲜了吧？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20130221",
                                                            "text": "这个我擅长。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20130216",
                                            "text": "虽然最后还是让他们得逞了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20130203",
                            "text": "你好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201303",
            "objective": "离开勘定奉行所",
            "dialogues": []
        },
        {
            "id": "201304",
            "objective": "与新之丞对话",
            "dialogues": [
                {
                    "id": "20130401",
                    "speaker": "新之丞",
                    "text": "二位请留步。",
                    "choices": [
                        {
                            "id": "20130402",
                            "text": "果然。",
                            "response": [
                                {
                                    "id": "20130404",
                                    "speaker": "派蒙",
                                    "text": "欸？我们怎么了吗？"
                                },
                                {
                                    "id": "20130405",
                                    "speaker": "新之丞",
                                    "text": "我们家小姐有封信要交给您，请一定要看一下。"
                                },
                                {
                                    "id": "20130406",
                                    "speaker": "派蒙",
                                    "text": "信？让我看看！"
                                },
                                {
                                    "id": "20130407",
                                    "speaker": "派蒙",
                                    "text": "见信如晤：如此唐突地递上信笺，实在抱歉。希望没有让您为此感到困扰。写信邀约来自异乡的陌生人，这种事情对我来说也是第一次呢。但我相信与您的相遇绝非偶然。所以，恰好今夜月色尚佳，望您不吝相会。请不用担心家臣与侍卫盘查，我自有办法引离。企盼着您务必前来。"
                                },
                                {
                                    "id": "20130408",
                                    "speaker": "派蒙",
                                    "text": "是说…要你晚上偷偷去找她？"
                                },
                                {
                                    "id": "20130409",
                                    "speaker": "派蒙",
                                    "text": "刚才你好像早就知道会发生这样的事…是为什么呢？",
                                    "choices": [
                                        {
                                            "id": "20130410",
                                            "text": "我和她确认过眼神。",
                                            "response": [
                                                {
                                                    "id": "20130411",
                                                    "speaker": "派蒙",
                                                    "text": "唔？你们在背着我搞什么名堂。"
                                                },
                                                {
                                                    "id": "20130414",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…还是晚上问问她看吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20130412",
                                            "text": "慎介根本不打算让我们离开。",
                                            "response": [
                                                {
                                                    "id": "20130413",
                                                    "speaker": "派蒙",
                                                    "text": "我就觉得哪里不对！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20130403",
                            "text": "来了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201305",
            "objective": "在第二天的约定时间（18~24时）与柊家小姐见面$HIDDEN",
            "dialogues": []
        },
        {
            "id": "201306",
            "objective": "在约定时间（18~24时）与柊家小姐见面",
            "dialogues": []
        },
        {
            "id": "201307",
            "objective": "与柊千里会面",
            "dialogues": [
                {
                    "id": "20130701",
                    "speaker": "柊千里",
                    "text": "啊，你们终于来了吗…我…我叫柊千里。"
                },
                {
                    "id": "20130702",
                    "speaker": "柊千里",
                    "text": "算是…第二次见面了吧，请多关照。"
                },
                {
                    "id": "20130703",
                    "speaker": "派蒙",
                    "text": "哇，真的是柊家的大小姐。",
                    "choices": [
                        {
                            "id": "20130704",
                            "text": "我才是，请多关照。",
                            "response": [
                                {
                                    "id": "20130706",
                                    "speaker": "柊千里",
                                    "text": "不用…不用这么客气，我早就很仰慕您的事迹，终于找到这样的机会了。"
                                },
                                {
                                    "id": "20130707",
                                    "speaker": "派蒙",
                                    "text": "嗯？怎么感觉气氛有点奇怪。"
                                },
                                {
                                    "id": "20130708",
                                    "speaker": "柊千里",
                                    "text": "这次偷偷见面，主要是在想…如果错过了机会，是不是就再也没办法和你讲…"
                                },
                                {
                                    "id": "20130709",
                                    "speaker": "派蒙",
                                    "text": "讲…讲什么？"
                                },
                                {
                                    "id": "20130710",
                                    "speaker": "柊千里",
                                    "text": "讲…想让你帮忙送信的事。",
                                    "choices": [
                                        {
                                            "id": "20130711",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "20130713",
                                                    "speaker": "派蒙",
                                                    "text": "你和你父亲果然是父女呢！不能换一换事情做吗！"
                                                },
                                                {
                                                    "id": "20130714",
                                                    "speaker": "柊千里",
                                                    "text": "不不…请等一下！"
                                                },
                                                {
                                                    "id": "20130715",
                                                    "speaker": "柊千里",
                                                    "text": "我是希望二位可以替我送信去鸣神岛，到天领奉行的二少爷镰治先生那里。"
                                                },
                                                {
                                                    "id": "20130716",
                                                    "speaker": "柊千里",
                                                    "text": "我父亲一直反对我们联络，想必在政治上他对我的婚配对象有更好的期许，可是我的心里却只有镰治先生。"
                                                },
                                                {
                                                    "id": "20130717",
                                                    "speaker": "柊千里",
                                                    "text": "在离岛没有人可以违抗父亲的意思，而你们又是难得的想往鸣神岛去的异乡人…"
                                                },
                                                {
                                                    "id": "20130718",
                                                    "speaker": "派蒙",
                                                    "text": "原来是有这样的苦衷啊…"
                                                },
                                                {
                                                    "id": "20130719",
                                                    "speaker": "柊千里",
                                                    "text": "当然，与此相对的，我会全力帮助你们离开这里，请相信我！",
                                                    "choices": [
                                                        {
                                                            "id": "20130720",
                                                            "text": "嗯…好像是不错的交易。",
                                                            "response": [
                                                                {
                                                                    "id": "20130722",
                                                                    "speaker": "柊千里",
                                                                    "text": "其实，只要你们还身在稻妻…父亲就没有让你们离开离岛的意思。"
                                                                },
                                                                {
                                                                    "id": "20130723",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯嗯，这点我们也看出来了，安排那样的任务肯定是想要拖住我们而已嘛。"
                                                                },
                                                                {
                                                                    "id": "20130724",
                                                                    "speaker": "柊千里",
                                                                    "text": "前些天我偷偷听到父亲和一位趾高气昂的女性谈话…"
                                                                },
                                                                {
                                                                    "id": "20130725",
                                                                    "speaker": "柊千里",
                                                                    "text": "他们在说的，似乎就是如何将异乡的旅者禁锢在离岛的事，还是头一次见父亲对将军之外的人如此恭敬。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "20130726",
                                                                            "text": "趾高气昂的女性…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "20130728",
                                                                                    "speaker": "柊千里",
                                                                                    "text": "时间应该差不多了，我把安排你们出去的计划告诉你…刚好有一批货物…"
                                                                                },
                                                                                {
                                                                                    "id": "20130729",
                                                                                    "speaker": "柊千里",
                                                                                    "text": "（柊千里告知了旅行者她的计划…）"
                                                                                },
                                                                                {
                                                                                    "id": "20130730",
                                                                                    "speaker": "柊千里",
                                                                                    "text": "好了，我到关口那边等你，信的事…就拜托了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "20130727",
                                                                            "text": "看来要尽快离开。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20130721",
                                                            "text": "除此之外也别无他法了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20130712",
                                            "text": "我回去了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20130705",
                            "text": "很高兴能再见到你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201308",
            "objective": "前往离岛边境，实施千里的计划",
            "dialogues": [
                {
                    "id": "20130801",
                    "speaker": "柊千里",
                    "text": "等一下，这批货…可是要送往海祇岛？"
                },
                {
                    "id": "20130802",
                    "speaker": "新之丞",
                    "text": "大小姐！您怎么过来了。您说的没错，这批货是勘定奉行大人特意叮嘱过，务必完好地送到海祇岛的。"
                },
                {
                    "id": "20130803",
                    "speaker": "健三郎",
                    "text": "不知小姐的意思是…？"
                },
                {
                    "id": "20130804",
                    "speaker": "柊千里",
                    "text": "那就没错了，家父不放心，刻意要我带上一位「高手」一同押运。"
                },
                {
                    "id": "20130805",
                    "speaker": "健三郎",
                    "text": "大小姐亲自押送吗？这、这…还是不需要劳烦您同行了吧，而且这位…这位「高手」的身份也…",
                    "choices": [
                        {
                            "id": "20130806",
                            "text": "请多关照。",
                            "response": [
                                {
                                    "id": "20130808",
                                    "speaker": "柊千里",
                                    "text": "请不要耽误时间了，我记得家父有催促过你们，迟到也同样会受罚吧?"
                                },
                                {
                                    "id": "20130809",
                                    "speaker": "健三郎",
                                    "text": "小姐，您的意思我们明白，可唯独这位…"
                                },
                                {
                                    "id": "20130810",
                                    "speaker": "柊千里",
                                    "text": "怎么，你们知道家父的脾气，如果我的安全出了闪失，你们要受的责罚恐怕不需要我讲了吧。"
                                },
                                {
                                    "id": "20130811",
                                    "speaker": "柊千里",
                                    "text": "你们真的有百分百的把握…保护好我么？"
                                },
                                {
                                    "id": "20130812",
                                    "speaker": "派蒙",
                                    "text": "千里小姐好拼，气场就像变了个人一样呢…"
                                },
                                {
                                    "id": "20130813",
                                    "speaker": "新之丞",
                                    "text": "好吧，小姐，非、非常荣幸可以与您随行…在下一定拼死护您周全。"
                                },
                                {
                                    "id": "20130814",
                                    "speaker": "健三郎",
                                    "text": "新之丞！你就真的答应了吗！"
                                },
                                {
                                    "id": "20130815",
                                    "speaker": "新之丞",
                                    "text": "嗯…既然是小姐的意思，做属下的就该竭尽所能才是。"
                                },
                                {
                                    "id": "20130816",
                                    "speaker": "健三郎",
                                    "text": "可是，问题不在这里…"
                                },
                                {
                                    "id": "20130817",
                                    "speaker": "柊千里",
                                    "text": "好了好了，那就赶快出发吧，这样磨磨蹭蹭的，是要给贼人准备动手的机会么？"
                                },
                                {
                                    "id": "20130818",
                                    "speaker": "健三郎",
                                    "text": "唉…好吧，出发！"
                                }
                            ]
                        },
                        {
                            "id": "20130807",
                            "text": "瞧不起我？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201309",
            "objective": "护送货物离开离岛",
            "dialogues": []
        },
        {
            "id": "201312",
            "objective": "(test)护送失败处理回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "201310",
            "objective": "向柊千里道别",
            "dialogues": [
                {
                    "id": "20131001",
                    "speaker": "新之丞",
                    "text": "呼…前面的村庄可以暂且歇息下，小姐你的状态还好吧？"
                },
                {
                    "id": "20131002",
                    "speaker": "柊千里",
                    "text": "嗯，到这里就可以了，那边是往鸣神岛的路…"
                },
                {
                    "id": "20131003",
                    "speaker": "柊千里",
                    "text": "我在信里有写，让镰治给你天领奉行特批的全稻妻的「通行凭证」，就当是谢礼。",
                    "choices": [
                        {
                            "id": "20131004",
                            "text": "多谢千里小姐。",
                            "response": [
                                {
                                    "id": "20131006",
                                    "speaker": "新之丞",
                                    "text": "小…姐…？"
                                },
                                {
                                    "id": "20131007",
                                    "speaker": "健三郎",
                                    "text": "唉，没想到真会如此，我就猜是会这样，新之丞你却…"
                                },
                                {
                                    "id": "20131008",
                                    "speaker": "新之丞",
                                    "text": "不会的，小姐一定别有用意，对吧？还有小姐你说的那个镰治是…？"
                                },
                                {
                                    "id": "20131009",
                                    "speaker": "柊千里",
                                    "text": "不避讳地说…是我的心上人。"
                                },
                                {
                                    "id": "20131010",
                                    "speaker": "新之丞",
                                    "text": "心上人…？"
                                },
                                {
                                    "id": "20131011",
                                    "speaker": "健三郎",
                                    "text": "喂，不是吧，新之丞你难道？"
                                },
                                {
                                    "id": "20131012",
                                    "speaker": "新之丞",
                                    "text": "没、没什么…咳咳…我只是随便问问，我怎么可能、怎么可能做那种梦呢…咳咳…"
                                },
                                {
                                    "id": "20131013",
                                    "speaker": "柊千里",
                                    "text": "二位不必担心，这件事还请二位先当做不知道，如果家父怪罪下来，我会一人承担。"
                                },
                                {
                                    "id": "20131014",
                                    "speaker": "健三郎",
                                    "text": "也只能如此了，唉…都听您的，小姐。"
                                },
                                {
                                    "id": "20131015",
                                    "speaker": "派蒙",
                                    "text": "可是千里小姐，如果真的被发现了可怎么办…？"
                                },
                                {
                                    "id": "20131016",
                                    "speaker": "柊千里",
                                    "text": "没关系的，家父自我小时候便非常宠我，最多会罚我半日禁食之类的而已，不必担心。"
                                },
                                {
                                    "id": "20131017",
                                    "speaker": "派蒙",
                                    "text": "原来那个老头子还有这样的一面…那好吧。"
                                },
                                {
                                    "id": "20131018",
                                    "speaker": "柊千里",
                                    "text": "请二位路上小心，我们有缘再见吧。"
                                },
                                {
                                    "id": "20131019",
                                    "speaker": "派蒙",
                                    "text": "嗯，再见，千里小姐！"
                                },
                                {
                                    "id": "20131020",
                                    "speaker": "健三郎",
                                    "text": "走啊，继续运货啊，愣着干什么呢！"
                                },
                                {
                                    "id": "20131021",
                                    "speaker": "新之丞",
                                    "text": "呜…咳咳…呜呜…"
                                }
                            ]
                        },
                        {
                            "id": "20131005",
                            "text": "也请你务必保重。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "201391",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20139101",
                    "speaker": "柊慎介",
                    "text": "之前说的事情，两位已经办完了吗？"
                },
                {
                    "id": "20139102",
                    "speaker": "柊慎介",
                    "text": "办完之后，再来向我汇报吧。"
                }
            ]
        },
        {
            "id": "201399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "20139901",
                    "speaker": "派蒙",
                    "text": "你真的要考虑完成这种委托吗？条件也太奇怪了…"
                },
                {
                    "id": "20139902",
                    "speaker": "健三郎",
                    "text": "喂！是魔物，准备攻击！"
                },
                {
                    "id": "20139903",
                    "speaker": "新之丞",
                    "text": "不，优先保护小姐！"
                },
                {
                    "id": "20139904",
                    "speaker": "派蒙",
                    "text": "瞧我们的吧！你们好好待在千里身边！"
                },
                {
                    "id": "20139907",
                    "speaker": "派蒙",
                    "text": "这下终于自由了！"
                },
                {
                    "id": "20139908",
                    "speaker": "派蒙",
                    "text": "是时候去找托马那个家伙了吧？记得是在…嗯！「木漏茶室」！"
                }
            ]
        }
    ]
}