    "talks": [
        {
            "id": "7182112",
            "objective": "（活动接取任务）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7182101",
            "objective": "与宏宇对话",
            "dialogues": [
                {
                    "id": "718210101",
                    "speaker": "宏宇",
                    "text": "怎么被派到这种活…"
                },
                {
                    "id": "718210102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718210103",
                    "speaker": "宏宇",
                    "text": "旅行者你可能不了解，每年海灯节的霄灯都是要回收的。"
                },
                {
                    "id": "718210104",
                    "speaker": "宏宇",
                    "text": "但霄灯放飞的时候是好看，飞出去之后，总是问题多多。"
                },
                {
                    "id": "718210105",
                    "speaker": "宏宇",
                    "text": "有的灯罩没做好，飞到一半灯罩坏了，就只剩一块浮生石到处乱飞。"
                },
                {
                    "id": "718210106",
                    "speaker": "宏宇",
                    "text": "有霄灯被风一吹，卡在了什么犄角旮旯里…"
                },
                {
                    "id": "718210107",
                    "speaker": "宏宇",
                    "text": "这样子一是有安全隐患，二是影响了市容，所以总务司一般都派了专人负责回收这些霄灯。"
                },
                {
                    "id": "718210108",
                    "speaker": "宏宇",
                    "text": "这不，今年就轮到我了…"
                },
                {
                    "id": "718210109",
                    "speaker": "宏宇",
                    "text": "但海灯节放的霄灯数量太大了…如果全堆到节日结束的那一天，我肯定忙不过来。"
                },
                {
                    "id": "718210110",
                    "speaker": "宏宇",
                    "text": "所以只能大家一边放，我一边回收那些落到犄角旮旯，已经坏掉的霄灯。"
                },
                {
                    "id": "718210111",
                    "speaker": "宏宇",
                    "text": "但就这样，我一个人也已经忙不过来了。"
                },
                {
                    "id": "718210112",
                    "speaker": "宏宇",
                    "text": "旅行者，如果你愿意帮忙的话，就帮我去看看这几处有没有需要回收的霄灯吧。"
                },
                {
                    "id": "718210113",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "718210114",
                    "speaker": "宏宇",
                    "text": "我把那几个地点给你标在地图上，那么就拜托了！"
                }
            ]
        },
        {
            "id": "7182111",
            "objective": "宏宇闲置对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7182102",
            "objective": "前往指定地点回收霄灯",
            "dialogues": [
                {
                    "id": "718210201",
                    "speaker": "快拳阿凌",
                    "text": "怎么会这样！"
                },
                {
                    "id": "718210202",
                    "speaker": "Player",
                    "text": "你怎么在这里？"
                },
                {
                    "id": "718210203",
                    "speaker": "快拳阿凌",
                    "text": "我…唉，是这样，师父说，他最近领悟出了一套新的腿法，非常厉害！"
                },
                {
                    "id": "718210204",
                    "speaker": "快拳阿凌",
                    "text": "他说我的心不够诚，基本功也不到家，不愿意将腿法传授于我…"
                },
                {
                    "id": "718210205",
                    "speaker": "快拳阿凌",
                    "text": "不过我想正好现在赶上海灯节，我诚心献一盏霄灯给师父，说不定他心情一好就愿意传授我了呢？"
                },
                {
                    "id": "718210206",
                    "speaker": "快拳阿凌",
                    "text": "但我实在找不到浮生石了，看见了有一盏霄灯卡在那，就想去把那盏霄灯的浮生石拿过来…"
                },
                {
                    "id": "718210207",
                    "speaker": "快拳阿凌",
                    "text": "结果就是这样了…唉，霄灯我还是别要了，给你吧。"
                },
                {
                    "id": "718210208",
                    "speaker": "快拳阿凌",
                    "text": "居然被魔物逼成这样，我的基本功果然还是不到家啊…"
                }
            ]
        },
        {
            "id": "7182103",
            "objective": "回收霄灯",
            "dialogues": [
                {
                    "id": "718210301",
                    "speaker": "宏宇",
                    "text": "怎么样，那些地方有需要回收的霄灯吗？"
                },
                {
                    "id": "718210302",
                    "speaker": "Player",
                    "text": "回收了三盏霄灯。"
                },
                {
                    "id": "718210303",
                    "speaker": "宏宇",
                    "text": "多谢了，要回收那些地方的霄灯真是太费事了，我每次过去都累得要命…"
                },
                {
                    "id": "718210304",
                    "speaker": "宏宇",
                    "text": "有你帮忙，我总算能轻松点了。对了，这是给你的报酬，辛苦你了。"
                }
            ]
        },
        {
            "id": "7182104",
            "objective": "前往指定地点回收霄灯",
            "dialogues": [
                {
                    "id": "718210401",
                    "speaker": "宏宇",
                    "text": "人家往外放霄灯，我往回收霄灯，总觉得有点不对头啊…"
                }
            ]
        },
        {
            "id": "7182105",
            "objective": "回收霄灯",
            "dialogues": [
                {
                    "id": "718210501",
                    "speaker": "快拳阿凌",
                    "text": "只怪我学艺不精，师父传授的功夫我还没有练到家。"
                }
            ]
        },
