        {
            "id": "4011111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401111101",
                    "speaker": "提米",
                    "text": "赢喽赢喽！",
                    "choices": [
                        {
                            "id": "401111102",
                            "text": "恭喜提米！",
                            "response": [
                                {
                                    "id": "401111103",
                                    "speaker": "提米",
                                    "text": "谢谢你们。这样一来，妈妈一定也会开心的吧？"
                                },
                                {
                                    "id": "401111104",
                                    "speaker": "提米",
                                    "text": "葛瑞丝妈妈一直鼓励我来参加比赛，我要把得到的奖品都送给妈妈！"
                                },
                                {
                                    "id": "401111105",
                                    "speaker": "提米",
                                    "text": "真希望爸爸也能看到我现在的样子…"
                                }
                            ]
                        },
                        {
                            "id": "401111106",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "401111107",
                                    "speaker": "提米",
                                    "text": "再见，「七圣召唤」真好玩。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401111201",
                    "speaker": "米卡",
                    "text": "已经散场了吗？我、我来晚了…"
                },
                {
                    "id": "401111202",
                    "speaker": "霍夫曼",
                    "text": "米卡，真遗憾你没看到。凯亚队长…居然输了。"
                },
                {
                    "id": "401111203",
                    "speaker": "米卡",
                    "text": "啊？！"
                },
                {
                    "id": "401111204",
                    "speaker": "米卡",
                    "text": "哥哥，具体是怎么回事？"
                },
                {
                    "id": "401111205",
                    "speaker": "霍夫曼",
                    "text": "我对「七圣召唤」没什么研究，全靠大家的谈论来理解局势。"
                },
                {
                    "id": "401111206",
                    "speaker": "霍夫曼",
                    "text": "一开始，凯亚队长很快拿下了对面的第一张牌，形势大优。"
                },
                {
                    "id": "401111207",
                    "speaker": "霍夫曼",
                    "text": "但这似乎正是对方的策略？那位叫提米的孩子，靠着前几个回合囤积起手上的卡牌…最后爆发出了惊人的威力。"
                },
                {
                    "id": "401111208",
                    "speaker": "霍夫曼",
                    "text": "不…或许这场比赛的胜负，早在凯亚队长抽到「后手」的那一刻，就被决定了…"
                },
                {
                    "id": "401111209",
                    "speaker": "霍夫曼",
                    "text": "唉，我想去喝一杯…"
                },
                {
                    "id": "401111210",
                    "speaker": "米卡",
                    "text": "哥哥，你冷静一点，现在不是借酒消愁的时候。"
                },
                {
                    "id": "401111211",
                    "speaker": "米卡",
                    "text": "据我了解的凯亚队长，他应该也不想看到你为他难过才对。"
                },
                {
                    "id": "401111212",
                    "speaker": "米卡",
                    "text": "倒不如我们也学学打牌吧？说不好下次还能跟凯亚队长亲自过招！哈哈…恐怕会输得很惨吧。"
                },
                {
                    "id": "401111213",
                    "speaker": "霍夫曼",
                    "text": "哈，你说得对，米卡。"
                }
            ]
        },
        {
            "id": "4011113",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401111301",
                    "speaker": "凯亚",
                    "text": "哟，还有什么想聊的吗？",
                    "choices": [
                        {
                            "id": "401111302",
                            "text": "关于「七圣召唤」…",
                            "response": [
                                {
                                    "id": "401111303",
                                    "speaker": "凯亚",
                                    "text": "最近这卡牌可真是火爆，简直像成了大家生活的一部分。到处都能看到有人玩。"
                                },
                                {
                                    "id": "401111304",
                                    "speaker": "凯亚",
                                    "text": "而且，还真有人为了保持清醒的头脑打牌，把酒都给戒了。"
                                },
                                {
                                    "id": "401111305",
                                    "speaker": "凯亚",
                                    "text": "啧啧，迪奥娜听到后应该会很高兴吧？",
                                    "choices": [
                                        {
                                            "id": "401111306",
                                            "text": "骑士团的大家…",
                                            "response": [
                                                {
                                                    "id": "401111307",
                                                    "speaker": "凯亚",
                                                    "text": "放心放心，大家都挺好的。"
                                                },
                                                {
                                                    "id": "401111308",
                                                    "speaker": "凯亚",
                                                    "text": "我曾经试过拉琴团长一起玩，结果刚打到一半她就被人喊走了，残局还是由我打完的，唉，真是没办法。只能说是「各司其职」了。"
                                                },
                                                {
                                                    "id": "401111309",
                                                    "speaker": "凯亚",
                                                    "text": "不过看到这次大赛办得这么成功，大家都乐在其中，她恐怕也能松一口气吧。",
                                                    "choices": [
                                                        {
                                                            "id": "401111302",
                                                            "text": "关于「七圣召唤」…"
                                                        },
                                                        {
                                                            "id": "401111310",
                                                            "text": "改天再聊。",
                                                            "response": [
                                                                {
                                                                    "id": "401111311",
                                                                    "speaker": "凯亚",
                                                                    "text": "好呀，有机会还想和你也来一局「七圣召唤」呢。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401111310",
                                            "text": "改天再聊。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401111306",
                            "text": "骑士团的大家…"
                        },
                        {
                            "id": "401111310",
                            "text": "改天再聊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011114",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401111401",
                    "speaker": "艾辛多弗",
                    "text": "真是场精彩的比赛，那位提米小弟…潜力无限啊。"
                },
                {
                    "id": "401111402",
                    "speaker": "伦纳德",
                    "text": "没想到提米还真的赢了…我也算是…虽败犹荣，虽败犹荣。"
                }
            ]
        },
        {
            "id": "4011115",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401111501",
                    "speaker": "夏洛蒂",
                    "text": "「西风骑兵队长对阵天才不败少年，湖中之城人才辈出」…"
                },
                {
                    "id": "401111502",
                    "speaker": "夏洛蒂",
                    "text": "唔，用这个标题的话，面子倒是给足了，但少了些「爆点」。"
                },
                {
                    "id": "401111503",
                    "speaker": "夏洛蒂",
                    "text": "「西风骑士团的顶尖头脑派，竟在五回合内输给桥头少年」…"
                },
                {
                    "id": "401111504",
                    "speaker": "夏洛蒂",
                    "text": "「如麦穗般辉煌的逆转胜」…"
                },
                {
                    "id": "401111505",
                    "speaker": "夏洛蒂",
                    "text": "嗯，要不，还是用回第一版？…"
                }
            ]
        },
        {
            "id": "4011131",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401113101",
                    "speaker": "胡桃",
                    "text": "这么说来，北斗姐也会打「七圣召唤」？"
                },
                {
                    "id": "401113102",
                    "speaker": "枫原万叶",
                    "text": "嗯，大姐头的牌技在南十字船队称得上数一数二了。"
                },
                {
                    "id": "401113103",
                    "speaker": "胡桃",
                    "text": "要不万叶小哥帮我引荐引荐？我对北斗姐崇拜已久，早就想跟她交朋友啦，可一直没遇到机会。"
                },
                {
                    "id": "401113104",
                    "speaker": "枫原万叶",
                    "text": "好。到时候还请堂主手下留情。"
                }
            ]
        },
        {
            "id": "4011132",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401113201",
                    "speaker": "凝光",
                    "text": "听闻「七圣召唤」的坊间比赛办得很是热闹，不少热爱牌戏的选手甚至在两边同时报了名。"
                },
                {
                    "id": "401113202",
                    "speaker": "凝光",
                    "text": "我的话…偶尔迎迎潮流无妨，但还是对棋戏更感兴趣。"
                },
                {
                    "id": "401113203",
                    "speaker": "凝光",
                    "text": "说到底，这些游艺只是形式不同。更珍贵的，还是朋友相聚这一事实。"
                }
            ]
        },
        {
            "id": "4011133",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401113301",
                    "speaker": "夏洛蒂",
                    "text": "您好您好，我是来自枫丹「蒸汽鸟报社」的记者夏洛蒂。"
                },
                {
                    "id": "401113302",
                    "speaker": "夏洛蒂",
                    "text": "请问方便抽点时间吗？我想对您做个简单采访。"
                },
                {
                    "id": "401113303",
                    "speaker": "小千",
                    "text": "唉，你问吧。"
                },
                {
                    "id": "401113304",
                    "speaker": "夏洛蒂",
                    "text": "您一路过关斩将，最后关头不敌往生堂的胡桃胡堂主，与冠军失之交臂，看起来相当遗憾。"
                },
                {
                    "id": "401113305",
                    "speaker": "夏洛蒂",
                    "text": "请问您会如何评价这场比赛呢？"
                },
                {
                    "id": "401113306",
                    "speaker": "小千",
                    "text": "…这。"
                },
                {
                    "id": "401113307",
                    "speaker": "小千",
                    "text": "记者小姐，你要的是能写上报纸的回答，还是我的真实想法？"
                },
                {
                    "id": "401113308",
                    "speaker": "夏洛蒂",
                    "text": "当然是真实想法。"
                },
                {
                    "id": "401113309",
                    "speaker": "小千",
                    "text": "唉…"
                },
                {
                    "id": "401113310",
                    "speaker": "小千",
                    "text": "虽然打牌七分靠技术，三分靠运气…但这一次投出六个同色骰，别说我只是个冒险家，就算我是仙人也打不过啊！"
                }
            ]
        },
        {
            "id": "4011151",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401115101",
                    "speaker": "荒泷一斗",
                    "text": "狐狸女人和什么宫的什么海的比赛，看得我热血沸腾，脑门的汗就像烧开的水一样！"
                },
                {
                    "id": "401115102",
                    "speaker": "久岐忍",
                    "text": "是是是。老大，整个离岛都知道你的激动之情了。但荒泷派大家还在等着，差不多该回去了。"
                },
                {
                    "id": "401115103",
                    "speaker": "荒泷一斗",
                    "text": "再等等，不差这一会儿。至少也让我和挚友最后来上一局…这愿望不过分吧？",
                    "choices": [
                        {
                            "id": "401115104",
                            "text": "那就来一局。",
                            "response": [
                                {
                                    "id": "401115105",
                                    "speaker": "荒泷一斗",
                                    "text": "挚友啊！你真的是我的挚友！我这熊熊燃烧的卡牌之魂，只有你才能懂！"
                                },
                                {
                                    "id": "401115106",
                                    "speaker": "久岐忍",
                                    "text": "…真拿你们没办法。"
                                }
                            ]
                        },
                        {
                            "id": "401115107",
                            "text": "这次不打了。",
                            "response": [
                                {
                                    "id": "401115108",
                                    "speaker": "荒泷一斗",
                                    "text": "…好吧。"
                                },
                                {
                                    "id": "401115109",
                                    "speaker": "荒泷一斗",
                                    "text": "男子汉有泪不轻弹。我是不会责怪你的，挚友！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011152",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401115201",
                    "speaker": "珊瑚宫心海",
                    "text": "九条小姐，有空聊上几句吗？"
                },
                {
                    "id": "401115202",
                    "speaker": "九条裟罗",
                    "text": "祝贺你获胜，珊瑚宫心海。"
                },
                {
                    "id": "401115203",
                    "speaker": "珊瑚宫心海",
                    "text": "正是多亏了九条小姐此前的提醒，非常感谢。"
                },
                {
                    "id": "401115204",
                    "speaker": "九条裟罗",
                    "text": "你说笑了。明眼人都明白，左右胜负的是彼此的技艺与策略。无论如何，它都是一场精彩的较量。"
                },
                {
                    "id": "401115205",
                    "speaker": "珊瑚宫心海",
                    "text": "这次九条小姐没有报名实在可惜。"
                },
                {
                    "id": "401115206",
                    "speaker": "九条裟罗",
                    "text": "我恐怕赢不了你。"
                },
                {
                    "id": "401115207",
                    "speaker": "珊瑚宫心海",
                    "text": "哪里的话。我猜九条小姐也像我一样，期待着在牌局中磨炼技艺，思考对策，和他人如朋友般切磋吧。"
                },
                {
                    "id": "401115208",
                    "speaker": "九条裟罗",
                    "text": "…或许吧。"
                },
                {
                    "id": "401115209",
                    "speaker": "九条裟罗",
                    "text": "我明白了。既然如此，在你离开鸣神岛之前，我们就来上一局「七圣召唤」吧。"
                },
                {
                    "id": "401115210",
                    "speaker": "珊瑚宫心海",
                    "text": "乐意之至。"
                }
            ]
        },
        {
            "id": "4011153",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401115301",
                    "speaker": "夏洛蒂",
                    "text": "我听你叫她「狐妖大人」，这里面有什么来由吗？"
                },
                {
                    "id": "401115302",
                    "speaker": "夏洛蒂",
                    "text": "和我具体讲讲吧，说不定写稿用得上呢！"
                },
                {
                    "id": "401115303",
                    "speaker": "绮良良",
                    "text": "欸？真要我讲，我反倒怕说错话了，毕竟我作为妖怪的资历还很浅嘛。"
                },
                {
                    "id": "401115304",
                    "speaker": "夏洛蒂",
                    "text": "好吧，那油豆腐和狐狸有什么关系？"
                },
                {
                    "id": "401115305",
                    "speaker": "绮良良",
                    "text": "哎呀，被你问得肚子都饿了。"
                },
                {
                    "id": "401115306",
                    "speaker": "绮良良",
                    "text": "不如我带你吃稻妻的油豆腐拉面吧，边吃边跟你解释。"
                }
            ]
        },
        {
            "id": "4011199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401119901",
                    "speaker": "提纳里",
                    "text": "（没想到啊…）"
                }
            ]
        }
    ]
}