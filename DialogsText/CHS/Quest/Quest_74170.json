    "talks": [
        {
            "id": "7417001",
            "objective": "(test)自然日计时开始$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7417007",
            "objective": "(test)自然日计时完成$HIDDEN",
            "dialogues": [
                {
                    "id": "741700701",
                    "speaker": "布里科勒",
                    "text": "唔，是时限太短了吗？居然连你也觉得有难度…"
                },
                {
                    "id": "741700702",
                    "speaker": "布里科勒",
                    "text": "你要再试一次吗？<color=#00E1FFFF>在规定时间内回收建筑内的所有桩锚复制品</color>，完成后来找我。",
                    "choices": [
                        {
                            "id": "741700703",
                            "text": "让我再试一次。",
                            "response": [
                                {
                                    "id": "741700704",
                                    "speaker": "布里科勒",
                                    "text": "没问题，我来计时。"
                                }
                            ]
                        },
                        {
                            "id": "741700705",
                            "text": "挑战先不提，关于库特罗…",
                            "response": [
                                {
                                    "id": "741700706",
                                    "speaker": "布里科勒",
                                    "text": "之前只是将他从枫丹科学院除名看来没有起到警醒的效果，真是冥顽不灵啊。"
                                },
                                {
                                    "id": "741700707",
                                    "speaker": "布里科勒",
                                    "text": "不过这次可没人替他担保了，所以你放心好了，他不会再有机会作恶了。"
                                }
                            ]
                        },
                        {
                            "id": "741700708",
                            "text": "话说回来，奎瑟尔是谁？",
                            "response": [
                                {
                                    "id": "741700709",
                                    "speaker": "布里科勒",
                                    "text": "我也不知道。在我印象中枫丹科学院应该没有叫这个名字的…也许对他来说，没有叫这个名字的人更好？"
                                },
                                {
                                    "id": "741700710",
                                    "speaker": "布里科勒",
                                    "text": "就像他自己说的，奎瑟尔只是一个方便的角色，和他本人的区别越大越好，这样就能减少被认出的可能性…我乱猜的。"
                                },
                                {
                                    "id": "741700711",
                                    "speaker": "布里科勒",
                                    "text": "唉，不过要我说，他本人就和过去差别够大了。一开始我都没认出来是他呢。"
                                }
                            ]
                        },
                        {
                            "id": "741700712",
                            "text": "挑战先不提，关于这里的装置…",
                            "response": [
                                {
                                    "id": "741700713",
                                    "speaker": "布里科勒",
                                    "text": "很令人费解对吧？看得出来他对这里进行了，呃，各种方面的改造。"
                                },
                                {
                                    "id": "741700714",
                                    "speaker": "布里科勒",
                                    "text": "感觉现在这样反而比较符合废墟旅游的选址要求呢…这么说好像有点不太谨慎。"
                                },
                                {
                                    "id": "741700715",
                                    "speaker": "布里科勒",
                                    "text": "咳，刚才的发言只是我个人的见解，不代表枫丹科学院的意见。"
                                }
                            ]
                        },
                        {
                            "id": "741700716",
                            "text": "这次就算了，你忙吧。",
                            "response": [
                                {
                                    "id": "741700717",
                                    "speaker": "布里科勒",
                                    "text": "这就走吗？好吧…"
                                },
                                {
                                    "id": "741700718",
                                    "speaker": "布里科勒",
                                    "text": "唉，这地方一个人呆久了真有点毛骨悚然的感觉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7417002",
            "objective": "(test)与布里科勒开启对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741700208",
                    "speaker": "Player",
                    "text": "让我试试。"
                },
                {
                    "id": "741700209",
                    "speaker": "布里科勒",
                    "text": "好的，我来计时。别忘了，<color=#00E1FFFF>在规定时间内回收建筑内的所有桩锚复制品</color>，完成后来找我。"
                }
            ]
        },
        {
            "id": "7417005",
            "objective": "(test)倒计时$HIDDEN",
            "dialogues": [
                {
                    "id": "741700501",
                    "speaker": "布里科勒",
                    "text": "我已经在计时了。<color=#00E1FFFF>在规定时间内回收建筑内的所有桩锚复制品</color>，完成后来找我。"
                }
            ]
        },
        {
            "id": "7417003",
            "objective": "(test)完成挑战$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7417006",
            "objective": "(test)与布里科勒失败对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7417004",
            "objective": "(test)向布里科勒回报$HIDDEN",
            "dialogues": [
                {
                    "id": "741700401",
                    "speaker": "布里科勒",
                    "text": "你成功了！看来这并不是无法完成的挑战，我可以安心把方案提交给院里了！"
                },
                {
                    "id": "741700402",
                    "speaker": "布里科勒",
                    "text": "可惜这里的资产还没有清点完毕，之后我多半还得回来…"
                },
                {
                    "id": "741700403",
                    "speaker": "布里科勒",
                    "text": "不管怎么说，感谢你的协助，对了，还有报酬。祝你旅途顺利！"
                }
            ]
        },
        {
            "id": "7417002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741700201",
                    "speaker": "布里科勒",
                    "text": "哦！你又回来了。我也回来了…"
                },
                {
                    "id": "741700202",
                    "speaker": "布里科勒",
                    "text": "院里听完简报之后让我在回收资产的时候也评估一下这里是否具有改造成素质拓展训练场地的可能。"
                },
                {
                    "id": "741700203",
                    "speaker": "布里科勒",
                    "text": "唉，总觉得这种工作似曾相识。以前也有这么一段时期，事务官格外热衷于带大家进行潜水训练。"
                },
                {
                    "id": "741700204",
                    "speaker": "布里科勒",
                    "text": "我是觉得没什么用，不过工作就是工作，任务就是任务…而且这里的确结构很奇怪…我是说奇特。"
                },
                {
                    "id": "741700205",
                    "speaker": "布里科勒",
                    "text": "所以我在各处放了一些桩锚复制品，简单说就是桩锚的模型啦，是完全没有风险的安全道具。"
                },
                {
                    "id": "741700206",
                    "speaker": "布里科勒",
                    "text": "我目前设想的训练内容是，<color=#00E1FFFF>在规定时间内回收建筑内的所有桩锚复制品。</color>"
                },
                {
                    "id": "741700207",
                    "speaker": "布里科勒",
                    "text": "你想试试看吗？挑战成功的话我也会提供一些报酬，毕竟也是协助调研。",
                    "choices": [
                        {
                            "id": "741700208",
