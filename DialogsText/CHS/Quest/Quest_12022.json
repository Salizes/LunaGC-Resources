    "talks": [
        {
            "id": "1202201",
            "objective": "等待到第二天上午10点 - 12点",
            "dialogues": [
                {
                    "id": "120220101",
                    "speaker": "派蒙",
                    "text": "咦，心海还没来吗？"
                },
                {
                    "id": "120220102",
                    "speaker": "派蒙",
                    "text": "好奇怪啊，总感觉心海不像是那种会迟到的人…我们再多等一会儿吧。"
                },
                {
                    "id": "120220103",
                    "speaker": "派蒙",
                    "text": "心海怎么还没来，会不会是遇到什么麻烦了？"
                },
                {
                    "id": "120220104",
                    "speaker": "派蒙",
                    "text": "我们去找那边的士兵打听一下吧！"
                }
            ]
        },
        {
            "id": "1202202",
            "objective": "在珊瑚宫附近等候心海",
            "dialogues": []
        },
        {
            "id": "1202203",
            "objective": "与派蒙交谈",
            "dialogues": []
        },
        {
            "id": "1202205",
            "objective": "赶往锦囊指示的地点",
            "dialogues": [
                {
                    "id": "120220501",
                    "speaker": "派蒙",
                    "text": "唔…这里放着好多好多的公文呢。"
                },
                {
                    "id": "120220502",
                    "speaker": "派蒙",
                    "text": "即便是在休息的时候，心海也要抽时间来处理公文吗？"
                },
                {
                    "id": "120220503",
                    "speaker": "派蒙",
                    "text": "「珊瑚宫经营活动摩拉流量报表」、「渔业产量年度统筹管理报告」、「海祇岛内设施维护经费分拨月度报表」…"
                },
                {
                    "id": "120220504",
                    "speaker": "派蒙",
                    "text": "原来有这么多事情要处理呀。而且心海平时还要写锦囊，要接见很多人，怪不得会变得很憔悴。"
                },
                {
                    "id": "120220505",
                    "speaker": "派蒙",
                    "text": "我们还是快点找到兵书，帮助心海打起精神来吧！"
                }
            ]
        },
        {
            "id": "1202208",
            "objective": "与心海交谈",
            "dialogues": [
                {
                    "id": "120220204",
                    "speaker": "派蒙",
                    "text": "心海！！"
                },
                {
                    "id": "120220205",
                    "speaker": "派蒙",
                    "text": "原来你在这里呀！不是说好今天一起去筹备庆功晚会吗？"
                },
                {
                    "id": "120220206",
                    "speaker": "珊瑚宫心海",
                    "text": "哦…是你们啊…"
                },
                {
                    "id": "120220207",
                    "speaker": "珊瑚宫心海",
                    "text": "抱歉，今天…有点不在状态。"
                },
                {
                    "id": "120220208",
                    "speaker": "派蒙",
                    "text": "是生病了吗？我们马上去找医生..."
                },
                {
                    "id": "120220209",
                    "speaker": "珊瑚宫心海",
                    "text": "不是啦，只是我的「能量」暂时用完了。"
                },
                {
                    "id": "120220210",
                    "speaker": "派蒙",
                    "text": "能量…难，难道说心海，其实不是人类吗！"
                },
                {
                    "id": "120220211",
                    "speaker": "珊瑚宫心海",
                    "text": "不，只是一种比喻而已啦。虽然有些惭愧，但我没办法一直维持那种无所不能的样子。",
                    "choices": [
                        {
                            "id": "120220212",
                            "text": "昨天被搭话的时候…",
                            "response": [
                                {
                                    "id": "120220214",
                                    "speaker": "珊瑚宫心海",
                                    "text": "啊，你注意到了吗？看来我遮掩的功夫还不到家，还得继续锻炼才行…"
                                },
                                {
                                    "id": "120220215",
                                    "speaker": "珊瑚宫心海",
                                    "text": "其实，我并不是很擅长做一个上位者。最早的时候，我的梦想就是读读兵书，做个幕僚之类的。"
                                },
                                {
                                    "id": "120220216",
                                    "speaker": "珊瑚宫心海",
                                    "text": "跟别人说话、照顾别人的情绪、察言观色、分配利益…在我看来是很麻烦的事。"
                                },
                                {
                                    "id": "120220217",
                                    "speaker": "珊瑚宫心海",
                                    "text": "要让别人如沐春风，又要让他们有所敬畏，这不是我擅长的领域。不如说，这是我曾经不想涉足的领域。"
                                },
                                {
                                    "id": "120220218",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但是因为血脉的原因，「现人神巫女」的位置终究会传到我的手里。喜欢也好，不喜欢也罢，这是没办法的事情。"
                                },
                                {
                                    "id": "120220219",
                                    "speaker": "珊瑚宫心海",
                                    "text": "所以，当我感觉自己要扛不住了的时候，我就会到这里来。看看书，休息一会儿…"
                                },
                                {
                                    "id": "120220220",
                                    "speaker": "珊瑚宫心海",
                                    "text": "不用担心，并不会影响工作。筹备庆功会的事情，我已经安排给其他人了。"
                                },
                                {
                                    "id": "120220221",
                                    "speaker": "珊瑚宫心海",
                                    "text": "今晚还有一场演讲，不能让士兵们看出有什么端倪…好不容易争取到了和平，我希望他们可以更加轻松自在一些。"
                                },
                                {
                                    "id": "120220222",
                                    "speaker": "派蒙",
                                    "text": "有什么我们能帮忙的吗？"
                                },
                                {
                                    "id": "120220223",
                                    "speaker": "珊瑚宫心海",
                                    "text": "其实放着不管，我的能量也会慢慢恢复。但如果能听到我感兴趣的兵书，或许能更快地振作起来。"
                                },
                                {
                                    "id": "120220224",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我记得上次有一本书看了一半，不知道放哪了…"
                                },
                                {
                                    "id": "120220225",
                                    "speaker": "派蒙",
                                    "text": "就让我们来找一找吧！"
                                },
                                {
                                    "id": "120220226",
                                    "speaker": "派蒙",
                                    "text": "然后读给心海听，这样心海就能振作起来了！"
                                },
                                {
                                    "id": "120220227",
                                    "speaker": "珊瑚宫心海",
                                    "text": "真的吗？谢谢你们啦。"
                                },
                                {
                                    "id": "120220228",
                                    "speaker": "珊瑚宫心海",
                                    "text": "呵呵…果然，你们回海祇岛真的太好了。"
                                }
                            ]
                        },
                        {
                            "id": "120220213",
                            "text": "确实感觉心海很苦恼。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202209",
            "objective": "调查心海的秘密基地",
            "dialogues": []
        },
        {
            "id": "1202216",
            "objective": "与派蒙交谈",
            "dialogues": []
        },
        {
            "id": "1202210",
            "objective": "调查心海的秘密基地",
            "dialogues": [
                {
                    "id": "120221001",
                    "speaker": "珊瑚宫心海",
                    "text": "呜呜…完全不想动弹…"
                },
                {
                    "id": "120221002",
                    "speaker": "珊瑚宫心海",
                    "text": "如果工作能够自动完成，该有多好啊…"
                }
            ]
        },
        {
            "id": "1202217",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "120220301",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}你看，这个会不会就是心海在找的兵书呢？"
                },
                {
                    "id": "120220302",
                    "speaker": "派蒙",
                    "text": "今天剑鱼二番队的队长回来了，能量值+4——"
                },
                {
                    "id": "120220303",
                    "speaker": "珊瑚宫心海",
                    "text": "啊啊…那个是…",
                    "choices": [
                        {
                            "id": "120220304",
                            "text": "我们什么也没看到。",
                            "response": [
                                {
                                    "id": "120220306",
                                    "speaker": "珊瑚宫心海",
                                    "text": "还——给——我——"
                                },
                                {
                                    "id": "120220307",
                                    "speaker": "派蒙",
                                    "text": "唔唔，看来这个也不是呢，我们还是再找找吧。"
                                }
                            ]
                        },
                        {
                            "id": "120220305",
                            "text": "是派蒙打开的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202211",
            "objective": "调查心海的秘密基地",
            "dialogues": [
                {
                    "id": "120221101",
                    "speaker": "珊瑚宫心海",
                    "text": "能量回满的时候，我也很擅长社交。"
                },
                {
                    "id": "120221102",
                    "speaker": "珊瑚宫心海",
                    "text": "不过对我来说，跟不熟的人说话是一件消耗能量的事情呢…"
                }
            ]
        },
        {
            "id": "1202213",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "120220601",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我觉得应该就是这一本吧？"
                },
                {
                    "id": "120220602",
                    "speaker": "派蒙",
                    "text": "你看，这里还有心海放进去的书签呢。像这一些就没有书签，应该是已经读完了吧。"
                },
                {
                    "id": "120220603",
                    "speaker": "派蒙",
                    "text": "感觉里面的内容好难懂，完全看不明白…"
                },
                {
                    "id": "120220604",
                    "speaker": "派蒙",
                    "text": "我们现在就把这本兵书带过去，读给她听吧？"
                }
            ]
        },
        {
            "id": "1202207",
            "objective": "设置任务全局变量$HIDDEN",
            "dialogues": [
                {
                    "id": "120220701",
                    "speaker": "柴田",
                    "text": "你要见珊瑚宫大人？"
                },
                {
                    "id": "120220702",
                    "speaker": "柴田",
                    "text": "不好意思，珊瑚宫大人不在这里，我也不知道她去了哪。"
                },
                {
                    "id": "120220703",
                    "speaker": "派蒙",
                    "text": "怎么这样…那我们只能回去了吗？"
                },
                {
                    "id": "120220704",
                    "speaker": "柴田",
                    "text": "倒也不是。我记得珊瑚宫大人留下来的常备锦囊中，好像有应对这种情况的解决办法。"
                },
                {
                    "id": "120220705",
                    "speaker": "柴田",
                    "text": "让我想想。第九十八条…<color=#00E1FFFF>「有客远来，寻我不见；可来南边，紫叶树前」</color>。"
                },
                {
                    "id": "120220706",
                    "speaker": "柴田",
                    "text": "备注上还写了，只有珊瑚宫大人没有留下任何其他交代，且客人身份很特别时，才能适用这一条。"
                },
                {
                    "id": "120220707",
                    "speaker": "柴田",
                    "text": "两位应该算远道而来的客人吧。这锦囊我一直带着，应该不会有错。"
                },
                {
                    "id": "120220708",
                    "speaker": "派蒙",
                    "text": "心海果然什么情况都考虑到了，那我们到她说的地方找找看吧！"
                }
            ]
        },
        {
            "id": "1202212",
            "objective": "为心海朗读兵书",
            "dialogues": [
                {
                    "id": "120220401",
                    "speaker": "派蒙",
                    "text": "心海，你在找的是这一本吗？"
                },
                {
                    "id": "120220402",
                    "speaker": "珊瑚宫心海",
                    "text": "我也有点记不清了…可以读两句让我听听吗？",
                    "choices": [
                        {
                            "id": "120220403",
                            "text": "「制由权也，权因事制」…",
                            "response": [
                                {
                                    "id": "120220405",
                                    "speaker": "珊瑚宫心海",
                                    "text": "嗯嗯，就是这个！拜托你啦。"
                                },
                                {
                                    "id": "120220406",
                                    "speaker": "派蒙",
                                    "text": "心海…心海…"
                                },
                                {
                                    "id": "120220407",
                                    "speaker": "派蒙",
                                    "text": "#怎么办呀，{NICKNAME}，心海她好像睡着了。"
                                },
                                {
                                    "id": "120220408",
                                    "speaker": "派蒙",
                                    "text": "今天晚上还有庆功晚会呢！而且马上就要和谈了，还有很多事没有做…",
                                    "choices": [
                                        {
                                            "id": "120220409",
                                            "text": "让她休息一会儿吧。",
                                            "response": [
                                                {
                                                    "id": "120220410",
                                                    "speaker": "派蒙",
                                                    "text": "真的没问题吗？"
                                                },
                                                {
                                                    "id": "120220411",
                                                    "speaker": "派蒙",
                                                    "text": "不过，心海确实很疲惫的样子。既然还有时间，我们再陪她一起休息一下吧。"
                                                },
                                                {
                                                    "id": "120220412",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "祓除灾厄…护佑平安…"
                                                },
                                                {
                                                    "id": "120220413",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "战争已经结束了哦…一切都在慢慢变好…"
                                                },
                                                {
                                                    "id": "120220414",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "你们看到了吗…"
                                                },
                                                {
                                                    "id": "120220415",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "欸…我睡着了吗？现在几点了？"
                                                },
                                                {
                                                    "id": "120220416",
                                                    "speaker": "派蒙",
                                                    "text": "心海已经睡了很久了哦！马上就要篝火晚会啦！"
                                                },
                                                {
                                                    "id": "120220417",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "这么晚了！"
                                                },
                                                {
                                                    "id": "120220418",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "已经好久没有睡得这么安稳了。感觉这次至少回复了三点能量值，应该能坚持到和谈结束。"
                                                },
                                                {
                                                    "id": "120220419",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "#谢谢你了，{NICKNAME}。走吧，我们一起去篝火晚会。"
                                                },
                                                {
                                                    "id": "120220420",
                                                    "speaker": "派蒙",
                                                    "text": "心海恢复平时的样子了呢！真的太好啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120220421",
                                            "text": "叫她起来吧。",
                                            "response": [
                                                {
                                                    "id": "120220422",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，心海也说了，不能耽误正事！"
                                                },
                                                {
                                                    "id": "120220423",
                                                    "speaker": "派蒙",
                                                    "text": "喂——心海，起床啦！"
                                                },
                                                {
                                                    "id": "120220424",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "唔…我睡着了吗，现在几点了？"
                                                },
                                                {
                                                    "id": "120220425",
                                                    "speaker": "派蒙",
                                                    "text": "准备出发去篝火晚会啦！"
                                                },
                                                {
                                                    "id": "120220426",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "都这么晚了吗？呜呜…总觉得能量还没有回满。"
                                                },
                                                {
                                                    "id": "120220427",
                                                    "speaker": "Player",
                                                    "text": "等下给你买新的兵书。"
                                                },
                                                {
                                                    "id": "120220428",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "真的吗！我想看《提瓦特战争艺术》最新的一期！"
                                                },
                                                {
                                                    "id": "120220429",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "八重堂应该上个月就印制出来了，但我一直没办法去买…你可不能反悔哦。"
                                                },
                                                {
                                                    "id": "120220430",
                                                    "speaker": "派蒙",
                                                    "text": "感觉心海一下子恢复了精神呢。"
                                                },
                                                {
                                                    "id": "120220431",
                                                    "speaker": "派蒙",
                                                    "text": "我们去篝火晚会看看吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120220404",
                            "text": "「击其懈怠，出其空虚」…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202214",
            "objective": "预留",
            "dialogues": []
        },
        {
            "id": "1202215",
            "objective": "预留",
            "dialogues": []
