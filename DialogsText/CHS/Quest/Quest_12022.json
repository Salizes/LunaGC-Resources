        {
            "id": "1202204",
            "objective": "废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1202217",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120221701",
                    "speaker": "珊瑚宫心海",
                    "text": "…你看到了吧？"
                }
            ]
        },
        {
            "id": "1202299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120229901",
                    "speaker": "派蒙",
                    "text": "真的是这边吗…我怎么感觉越走越远了。"
                },
                {
                    "id": "120229902",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你看那棵树像不像心海在锦囊里写的？"
                },
                {
                    "id": "120229903",
                    "speaker": "派蒙",
                    "text": "那边好像可以钻进去…我们过去看看吧！"
                }
            ]
        }
    ]
}