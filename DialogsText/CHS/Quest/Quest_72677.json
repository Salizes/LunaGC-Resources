        {
            "id": "7267701",
            "objective": "前往渌华池附近",
            "dialogues": [
                {
                    "id": "726770101",
                    "speaker": "派蒙",
                    "text": "这里的景致，很特别吧！"
                },
                {
                    "id": "726770102",
                    "speaker": "「吉法师」",
                    "text": "一层一层的水，颜色很特别呶。",
                    "choices": [
                        {
                            "id": "726770103",
                            "text": "派蒙和吉法师的词汇量一样匮乏…",
                            "response": [
                                {
                                    "id": "726770104",
                                    "speaker": "派蒙",
                                    "text": "#但是，真的很特别嘛！这个颜色，{NICKNAME}要怎么形容呢？",
                                    "choices": [
                                        {
                                            "id": "726770105",
                                            "text": "像冰元素…",
                                            "response": [
                                                {
                                                    "id": "726770107",
                                                    "speaker": "派蒙",
                                                    "text": "什么嘛…"
                                                },
                                                {
                                                    "id": "726770113",
                                                    "speaker": "派蒙",
                                                    "text": "#不过，这里的景色真的很特别呢。{NICKNAME}还记得之前那位画家吗？",
                                                    "choices": [
                                                        {
                                                            "id": "726770114",
                                                            "text": "梵米尔？",
                                                            "response": [
                                                                {
                                                                    "id": "726770115",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯！就是梵米尔！当时，咱们不是还帮他在那两个大雕像上装超级发光大珠子吗？"
                                                                },
                                                                {
                                                                    "id": "726770118",
                                                                    "speaker": "派蒙",
                                                                    "text": "最后还送了一幅画给我们！"
                                                                },
                                                                {
                                                                    "id": "726770119",
                                                                    "speaker": "Player",
                                                                    "text": "是这个吗？"
                                                                },
                                                                {
                                                                    "id": "726770120",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯！就是这个！吉法师，快看！"
                                                                },
                                                                {
                                                                    "id": "726770121",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "呶！好像！是拍照吗？"
                                                                },
                                                                {
                                                                    "id": "726770122",
                                                                    "speaker": "派蒙",
                                                                    "text": "不是哦，是人画的。"
                                                                },
                                                                {
                                                                    "id": "726770123",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "咦？但是、为什么人能拍照，还要画画呶？"
                                                                },
                                                                {
                                                                    "id": "726770124",
                                                                    "speaker": "派蒙",
                                                                    "text": "#唔…是呀，{NICKNAME}，这是为什么呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "726770125",
                                                                            "text": "因为想要创造只属于自己的东西吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "726770126",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好像很有道理的样子。"
                                                                                },
                                                                                {
                                                                                    "id": "726770130",
                                                                                    "speaker": "Player",
                                                                                    "text": "而且，自己画的东西，有很多心意。"
                                                                                },
                                                                                {
                                                                                    "id": "726770131",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，一笔一笔把自己心里想的东西画出来，很辛苦的事情呢！"
                                                                                },
                                                                                {
                                                                                    "id": "726770132",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "嗯…那给我拍照，是不是很容易、不辛苦，所以没有很多心意？"
                                                                                },
                                                                                {
                                                                                    "id": "726770133",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸！不是这样的，是因为…"
                                                                                },
                                                                                {
                                                                                    "id": "726770134",
                                                                                    "speaker": "Player",
                                                                                    "text": "画画要好长时间。吉法师会累。"
                                                                                },
                                                                                {
                                                                                    "id": "726770135",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对对！画画要好长时间的，吉法师要是一直保持一个姿势，会很累。"
                                                                                },
                                                                                {
                                                                                    "id": "726770136",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "以前被封印变成石头的时候，就一直站着。"
                                                                                },
                                                                                {
                                                                                    "id": "726770137",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "所以，挣脱封印以后，好长时间里，脚好难受。"
                                                                                },
                                                                                {
                                                                                    "id": "726770138",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "呜哇，听起来就觉得好辛苦…"
                                                                                },
                                                                                {
                                                                                    "id": "726770139",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "但是，派蒙可以飞飞。应该脚不会累。"
                                                                                },
                                                                                {
                                                                                    "id": "726770140",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂！飞的时候，全身的幻肢都在运动，很累的。"
                                                                                },
                                                                                {
                                                                                    "id": "726770141",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "哇！着火的花！"
                                                                                },
                                                                                {
                                                                                    "id": "726770142",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "好好听人说话啦…"
                                                                                },
                                                                                {
                                                                                    "id": "726770143",
                                                                                    "speaker": "Player",
                                                                                    "text": "烈焰花？"
                                                                                },
                                                                                {
                                                                                    "id": "726770144",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "对喔，在镇守之森好像确实没怎么见过烈焰花…"
                                                                                },
                                                                                {
                                                                                    "id": "726770145",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "吉法师想要吗？"
                                                                                },
                                                                                {
                                                                                    "id": "726770146",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "想要！看上去很暖和。"
                                                                                },
                                                                                {
                                                                                    "id": "726770147",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#那要好好拜托{NICKNAME}喔！"
                                                                                },
                                                                                {
                                                                                    "id": "726770148",
                                                                                    "speaker": "「吉法师」",
                                                                                    "text": "#{NICKNAME}，想要。谢谢。"
                                                                                },
                                                                                {
                                                                                    "id": "726770149",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "妖狸说话就是这种风格吗…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "726770127",
                                                                            "text": "因为留影机很贵。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "726770128",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸？！留影机很贵吗？那平时战斗、游泳、爬山，又从山上掉下来会不会弄坏…"
                                                                                },
                                                                                {
                                                                                    "id": "726770129",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "呜哇，不得了，以后要小心才行…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726770116",
                                                            "text": "谁啊。",
                                                            "response": [
                                                                {
                                                                    "id": "726770117",
                                                                    "speaker": "派蒙",
                                                                    "text": "是梵米尔啦！当时，不是还帮他在那两个大雕像上装超级发光大珠子来着吗？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726770106",
                                            "text": "像风元素？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726770108",
                            "text": "吉法师的词汇量和派蒙一样丰富…",
                            "response": [
                                {
                                    "id": "726770109",
                                    "speaker": "「吉法师」",
                                    "text": "和派蒙一样厉害！"
                                },
                                {
                                    "id": "726770110",
                                    "speaker": "派蒙",
                                    "text": "#唔…{NICKNAME}可能不是那个意思，但总之…吉法师就是很聪明呢！哼！"
                                }
                            ]
                        },
                        {
                            "id": "726770111",
                            "text": "真的很特别呢！",
                            "response": [
                                {
                                    "id": "726770112",
                                    "speaker": "派蒙",
                                    "text": "#哎？{NICKNAME}的词汇量是不是有点匮乏…"
                                }
                            ]
                        }
                    ]
                }
            ]
