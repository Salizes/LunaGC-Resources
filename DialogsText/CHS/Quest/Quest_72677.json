        {
            "id": "7267702",
            "objective": "将1个「烈焰花花蕊」交给吉法师",
            "dialogues": [
                {
                    "id": "726770201",
                    "speaker": "「吉法师」",
                    "text": "#{NICKNAME}，想要着火的花。谢谢。"
                }
            ]
        },
        {
            "id": "7267708",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "726770801",
                    "speaker": "「吉法师」",
                    "text": "好温暖。"
                },
                {
                    "id": "726770802",
                    "speaker": "「吉法师」",
                    "text": "如果去雪山的时候，有烈焰花就好了哩。"
                },
                {
                    "id": "726770803",
                    "speaker": "派蒙",
                    "text": "这么说来，当时确实应该准备一些保暖的东西…"
                },
                {
                    "id": "726770804",
                    "speaker": "「吉法师」",
                    "text": "派蒙，如果有很大的这种花，能不能把雪山变得没有雪？"
                },
                {
                    "id": "726770805",
                    "speaker": "派蒙",
                    "text": "恐、恐怕不太能吧…"
                },
                {
                    "id": "726770806",
                    "speaker": "「吉法师」",
                    "text": "呶。"
                },
                {
                    "id": "726770807",
                    "speaker": "Player",
                    "text": "可以带吉法师看「很大的烈焰花」。"
                },
                {
                    "id": "726770808",
                    "speaker": "派蒙",
                    "text": "欸，说的难道是…",
                    "choices": [
                        {
                            "id": "726770809",
                            "text": "附近就有爆炎树。",
                            "response": [
                                {
                                    "id": "726770811",
                                    "speaker": "派蒙",
                                    "text": "嗯！就当吉法师今天的修行吧！"
                                }
                            ]
                        },
                        {
                            "id": "726770810",
                            "text": "我们出发吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267703",
            "objective": "前往爆炎树所在的洞窟深处",
            "dialogues": [
                {
                    "id": "726770301",
                    "speaker": "「吉法师」",
                    "text": "好大喔！好热！竟然有这么大的着火的花！"
                },
                {
                    "id": "726770302",
                    "speaker": "派蒙",
                    "text": "对吧！啊，对了…"
                },
                {
                    "id": "726770303",
                    "speaker": "派蒙",
                    "text": "吉法师你等一下，我们给你拍照！"
                },
                {
                    "id": "726770304",
                    "speaker": "Player",
                    "text": "在这么热的地方？"
                },
                {
                    "id": "726770305",
                    "speaker": "派蒙",
                    "text": "就是这么热才好！"
                },
                {
                    "id": "726770306",
                    "speaker": "「吉法师」",
                    "text": "呜呶呶…好…"
                }
            ]
        },
        {
            "id": "7267704",
            "objective": "为吉法师拍照",
            "dialogues": [
                {
                    "id": "726770401",
                    "speaker": "「吉法师」",
                    "text": "呜呶呶…好热…"
                },
                {
                    "id": "726770402",
                    "speaker": "派蒙",
                    "text": "哼哼，吉法师，这下知道了吧！"
                },
                {
                    "id": "726770403",
                    "speaker": "「吉法师」",
                    "text": "呶？"
                },
                {
                    "id": "726770404",
                    "speaker": "Player",
                    "text": "知道什么了？"
                },
                {
                    "id": "726770405",
                    "speaker": "派蒙",
                    "text": "如果是画画的话，就要花更多时间了！"
                },
                {
                    "id": "726770406",
                    "speaker": "派蒙",
                    "text": "所以，选择拍照，而不是画画，并不是因为缺乏心意，而是体贴！是体贴啦！",
                    "choices": [
                        {
                            "id": "726770407",
                            "text": "是这样的用意喔！",
                            "response": [
                                {
                                    "id": "726770410",
                                    "speaker": "「吉法师」",
                                    "text": "明白了。拍照，好。好热喔…"
                                },
                                {
                                    "id": "726770411",
                                    "speaker": "Player",
                                    "text": "我去把热源快速处理掉。很快就好。"
                                },
                                {
                                    "id": "726770412",
                                    "speaker": "「吉法师」",
                                    "text": "呜呶呶…"
                                }
                            ]
                        },
                        {
                            "id": "726770408",
                            "text": "莫名其妙！"
                        },
                        {
                            "id": "726770409",
                            "text": "虽然道理没错，但是真的好热…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7267705",
            "objective": "与吉法师对话",
            "dialogues": []
        },
        {
            "id": "7267706",
            "objective": "击败爆炎树",
            "dialogues": []
        },
        {
            "id": "7267707",
            "objective": "与吉法师对话",
            "dialogues": [
                {
                    "id": "726770701",
                    "speaker": "「吉法师」",
                    "text": "#{NICKNAME}好厉害！",
                    "choices": [
                        {
                            "id": "726770702",
                            "text": "还好。",
                            "response": [
                                {
                                    "id": "726770704",
                                    "speaker": "「吉法师」",
                                    "text": "#{NICKNAME}、派蒙，经常打吗？"
                                },
                                {
                                    "id": "726770705",
                                    "speaker": "派蒙",
                                    "text": "嗯…仔细一想，虽然我们旅行的目的是找到失散的亲人，但旅途中总是在战斗呢。",
                                    "choices": [
                                        {
                                            "id": "726770706",
                                            "text": "还好。我很喜欢打架。",
                                            "response": [
                                                {
                                                    "id": "726770707",
                                                    "speaker": "派蒙",
                                                    "text": "唔…虽然有斗志是好事，但不要把这种事情当成爱好比较好吧？"
                                                },
                                                {
                                                    "id": "726770710",
                                                    "speaker": "「吉法师」",
                                                    "text": "#等我变成大妖狸，也要像{NICKNAME}这么厉害。"
                                                },
                                                {
                                                    "id": "726770711",
                                                    "speaker": "派蒙",
                                                    "text": "吉法师一定没问题的！但是，要答应派蒙…"
                                                },
                                                {
                                                    "id": "726770712",
                                                    "speaker": "「吉法师」",
                                                    "text": "派蒙说。"
                                                },
                                                {
                                                    "id": "726770713",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…咳咳！吉法师就算变成比五百藏还厉害的妖狸大王，也不要欺负弱小。然后，也不要随便打架。"
                                                },
                                                {
                                                    "id": "726770714",
                                                    "speaker": "派蒙",
                                                    "text": "#不能像那个好大好大的、着火的花那样，看到{NICKNAME}就冒出来扭来扭去喷火！"
                                                },
                                                {
                                                    "id": "726770715",
                                                    "speaker": "「吉法师」",
                                                    "text": "那，要什么时候才能打打？",
                                                    "choices": [
                                                        {
                                                            "id": "726770716",
                                                            "text": "保护自己的时候…",
                                                            "response": [
                                                                {
                                                                    "id": "726770719",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "呶…虽然不是很明白，不过，我答应派蒙。不欺负弱小，也不随便打架。"
                                                                },
                                                                {
                                                                    "id": "726770720",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，吉法师真乖。"
                                                                },
                                                                {
                                                                    "id": "726770721",
                                                                    "speaker": "派蒙",
                                                                    "text": "接下来…应该就是五百藏决定的，去八个地方修行的最后一站了呢…"
                                                                },
                                                                {
                                                                    "id": "726770722",
                                                                    "speaker": "「吉法师」",
                                                                    "text": "呶…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726770717",
                                                            "text": "保护别人的时候…"
                                                        },
                                                        {
                                                            "id": "726770718",
                                                            "text": "守护正确的事情的时候…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726770708",
                                            "text": "战斗麻烦死了。",
                                            "response": [
                                                {
                                                    "id": "726770709",
                                                    "speaker": "派蒙",
                                                    "text": "嗯。但是，有时候也不得不拿起武器呢。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726770703",
                            "text": "还好。和这种东西战斗很多次了。"
                        }
                    ]
                }
            ]
        }
    ]
}