            "dialogues": [
                {
                    "id": "752520601",
                    "speaker": "Player",
                    "text": "你是那个酒吧迎宾，我们见过。"
                },
                {
                    "id": "752520602",
                    "speaker": "泰克胡",
                    "text": "是吗？难怪觉得你有点眼熟，不过我一天见过很多人，所以记不太清了…不过，这不重要。"
                }
            ]
        },
        {
            "id": "7525205",
            "objective": "回去找伊凯卡",
            "dialogues": [
                {
                    "id": "752520701",
                    "speaker": "泰克胡",
                    "text": "重要的是，你在这附近见过一个光头吗？我找他有事。",
                    "choices": [
                        {
                            "id": "752520702",
                            "text": "我也是来找他的。",
                            "response": [
                                {
                                    "id": "752520704",
                                    "speaker": "泰克胡",
                                    "text": "哦？他刚才在这里是吗？看来已经跑了，是知道我正在追他了吧…"
                                },
                                {
                                    "id": "752520709",
                                    "speaker": "泰克胡",
                                    "text": "哼，伊凯卡…你跑不了的。"
                                },
                                {
                                    "id": "752520706",
                                    "speaker": "泰克胡",
                                    "text": "看在我们还算有缘的份上，劝你离那家伙和我都远一点，免得你这张漂亮脸蛋溅到白白红红的脏颜料。"
                                },
                                {
                                    "id": "752520707",
                                    "speaker": "泰克胡",
                                    "text": "这些是我在营地里搜出来的东西，我猜是他来不及带走的。"
                                },
                                {
                                    "id": "752520708",
                                    "speaker": "泰克胡",
                                    "text": "送给你了，别有什么顾虑，这些东西现在是我说了算。"
                                },
                                {
                                    "id": "752520710",
                                    "speaker": "泰克胡",
                                    "text": "那家伙的命迟早也都是我的。"
                                }
                            ]
                        },
                        {
                            "id": "752520703",
                            "text": "没见过。",
                            "response": [
                                {
                                    "id": "752520705",
                                    "speaker": "泰克胡",
                                    "text": "你没骗我吧？我暂且信了你这张诚恳的小脸。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
