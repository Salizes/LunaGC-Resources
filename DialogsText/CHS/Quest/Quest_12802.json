    "talks": [
        {
            "id": "1280201",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "698390101",
                    "speaker": "玄冬林檎",
                    "text": "#你好，{NICKNAME}，你是来求签的吗？抱歉了，现在可能不是很方便求签。"
                },
                {
                    "id": "698390102",
                    "speaker": "Player",
                    "text": "这签筒不是还在吗？"
                },
                {
                    "id": "698390103",
                    "speaker": "玄冬林檎",
                    "text": "签筒在，里面的竹签也在，但是对应的御神签，也就是用来解签的「纸片儿」用完了。",
                    "choices": [
                        {
                            "id": "698390104",
                            "text": "这也能用完的？",
                            "response": [
                                {
                                    "id": "698390106",
                                    "speaker": "玄冬林檎",
                                    "text": "这要看你的运势，本社正在准备新的御神签。"
                                },
                                {
                                    "id": "698390107",
                                    "speaker": "Player",
                                    "text": "那怎么看我的运势？"
                                },
                                {
                                    "id": "698390108",
                                    "speaker": "玄冬林檎",
                                    "text": "求签。"
                                },
                                {
                                    "id": "698390109",
                                    "speaker": "Player",
                                    "text": "那什么时候才能求呢？"
                                },
                                {
                                    "id": "698390110",
                                    "speaker": "玄冬林檎",
                                    "text": "看你的运势。",
                                    "choices": [
                                        {
                                            "id": "698390111",
                                            "text": "你玩这个就没意思了。",
                                            "response": [
                                                {
                                                    "id": "698390112",
                                                    "speaker": "玄冬林檎",
                                                    "text": "有意思…看来你的运势是大吉。"
                                                },
                                                {
                                                    "id": "698390115",
                                                    "speaker": "Player",
                                                    "text": "你怎么知道？"
                                                },
                                                {
                                                    "id": "698390116",
                                                    "speaker": "八重神子",
                                                    "text": "哎呀呀，我说是谁来的这么巧，原来是你这小家伙啊。是来求签的？",
                                                    "choices": [
                                                        {
                                                            "id": "698390117",
                                                            "text": "是啊。",
                                                            "response": [
                                                                {
                                                                    "id": "698390119",
                                                                    "speaker": "八重神子",
                                                                    "text": "对啊，稻妻的各位真是每一年比前一年更不安啊，御神签的消耗量年年攀升…"
                                                                },
                                                                {
                                                                    "id": "698390120",
                                                                    "speaker": "八重神子",
                                                                    "text": "明明不久之前才补充过御神签，这就又抽完了。而且连大吉都被抽得没剩下几张。唉，真让我这位宫司犯愁啊。"
                                                                },
                                                                {
                                                                    "id": "698390121",
                                                                    "speaker": "八重神子",
                                                                    "text": "不过，你今天的运势不错。林檎，拿去吧，这些是新的签文。这次我一口气写了三百张「吉」，肯定够抽一段时间了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698390122",
                                                                            "text": "三、三百张？！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698390124",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "那…就要看各位稻妻民众们的运势了。"
                                                                                },
                                                                                {
                                                                                    "id": "698390125",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "好啦，小家伙，你不是来求签的么？来，我蒙着你的眼睛，你来抽一根竹签吧。"
                                                                                },
                                                                                {
                                                                                    "id": "698390126",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "要好好抽喔，这可是由八重宫司大人主持的特别抽签，和普通的签可不太一样呢。"
                                                                                },
                                                                                {
                                                                                    "id": "698390127",
                                                                                    "speaker": "八重神子",
                                                                                    "text": "你看，林檎说得没错，看来你今天的运势确实是大吉呢。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698390128",
                                                                                            "text": "你怎么听到的？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390129",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "哎呀，这可是在鸣神大社里，我听得稍微远一点也不奇怪吧？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390132",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "喏，这可是鸣神大社现任宫司八重神子大人亲手写的签，可灵验了。你可要好好收着，别被狸猫或者食梦貘偷走了喔。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390133",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "那么和之前一样，剩下的就交给你了喔，林檎。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390134",
                                                                                                    "speaker": "玄冬林檎",
                                                                                                    "text": "好的。宫司大人。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390135",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "欸？剩下的是…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390136",
                                                                                                    "speaker": "玄冬林檎",
                                                                                                    "text": "如您所听的。神子大人所写的御神签是「吉」，还剩下「凶」。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390137",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "没办法，我亲手写的御神签实在太过灵验了，我总不能把这种力量用在写「凶」签上吧？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390138",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "所以，为了各位来求签的客人们的福祉，写「凶」签这件事就只能拜托林檎了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390139",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "好啦，我要继续回去写小吉了，好好享受今天的好运气吧，小家伙。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "698390140",
                                                                                                            "text": "她是不是就是单纯想偷懒？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "698390142",
                                                                                                                    "speaker": "玄冬林檎",
                                                                                                                    "text": "#…请您享受今天的好运气吧，{NICKNAME}。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698390141",
                                                                                                            "text": "她就是不想写这么多签。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698390130",
                                                                                            "text": "神子，你不会…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390131",
                                                                                                    "speaker": "八重神子",
                                                                                                    "text": "嘘，抽到了好签可不能声张，不然好运气会被妖怪叼走的。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698390123",
                                                                            "text": "这得抽到什么时候？！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698390118",
                                                            "text": "但是林檎说御神签都被抽完了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698390113",
                                            "text": "我俩要继续说到什么时候…",
                                            "response": [
                                                {
                                                    "id": "698390114",
                                                    "speaker": "玄冬林檎",
                                                    "text": "不用继续了。看来你的运势是大吉。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698390105",
                            "text": "那什么时候能继续求签？"
                        }
                    ]
                }
            ]
        }
    ]
}