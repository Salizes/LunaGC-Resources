        "rewards_formatted": "冒险阅历 x125, 摩拉 x4650, 冒险家的经验 x2, 精锻用良矿 x5",
        "chapter": {
            "icon": "UI_ChapterIcon_Xiangling",
            "id": "2007",
            "num": "长杓之章 第一幕",
            "title": "蒙德食遇之旅"
        },
        "total_dialogue_lines": 60,
        "total_speaker_counts": {
            "Player": 7,
            "布洛克": 12,
            "杜拉夫": 12,
            "派蒙": 8,
            "香菱": 21
        }
    },
    "talks": [
        {
            "id": "1100101",
            "objective": "陪香菱去清泉镇",
            "dialogues": []
        },
        {
            "id": "1100102",
            "objective": "向杜拉夫道歉",
            "dialogues": [
                {
                    "id": "110010201",
                    "speaker": "杜拉夫",
                    "text": "你就是香菱，是吧？"
                },
                {
                    "id": "110010202",
                    "speaker": "香菱",
                    "text": "对不起，杜拉夫先生，是我的不对。"
                },
                {
                    "id": "110010203",
                    "speaker": "杜拉夫",
                    "text": "你做的那些事我都听说了。既然你人都来了——"
                },
                {
                    "id": "110010204",
                    "speaker": "派蒙",
                    "text": "好、好可怕！",
                    "choices": [
                        {
                            "id": "110010205",
                            "text": "暴、暴力是不对的！",
                            "response": [
                                {
                                    "id": "110010207",
                                    "speaker": "杜拉夫",
                                    "text": "——请帮帮我们推广我们的肉产品吧！"
                                },
                                {
                                    "id": "110010208",
                                    "speaker": "香菱",
                                    "text": "…啊？"
                                },
                                {
                                    "id": "110010209",
                                    "speaker": "杜拉夫",
                                    "text": "不好意思，唐突了点，我这就跟你们解释。"
                                },
                                {
                                    "id": "110010210",
                                    "speaker": "杜拉夫",
                                    "text": "清泉镇向来以高品质的肉类闻名，但它的名声不应该只局限在蒙德。"
                                },
                                {
                                    "id": "110010211",
                                    "speaker": "杜拉夫",
                                    "text": "正好我听说大厨香菱来了蒙德，我就马上叫艾伦把你请过来了。"
                                },
                                {
                                    "id": "110010212",
                                    "speaker": "派蒙",
                                    "text": "大厨？"
                                },
                                {
                                    "id": "110010213",
                                    "speaker": "杜拉夫",
                                    "text": "你没听过吗？在璃月港独树一帜，主打平民菜品的「万民堂」，就是香菱掌厨。"
                                },
                                {
                                    "id": "110010214",
                                    "speaker": "杜拉夫",
                                    "text": "她对食材有独特的理解，做出来的菜深受当地居民喜爱，在游客中也是好评如潮。"
                                },
                                {
                                    "id": "110010215",
                                    "speaker": "香菱",
                                    "text": "嘿嘿，说得太夸张啦。我只是想做出便宜又好吃的东西而已。"
                                },
                                {
                                    "id": "110010216",
                                    "speaker": "杜拉夫",
                                    "text": "像香菱这样一流的大厨，用一流的肉做出一流的料理，我们清泉镇的肉就能声名远扬了。"
                                },
                                {
                                    "id": "110010217",
                                    "speaker": "香菱",
                                    "text": "可是…这个请求我觉得我做不到。"
                                },
                                {
                                    "id": "110010218",
                                    "speaker": "香菱",
                                    "text": "我只考虑过怎么做出好吃的菜，没限制过食材，更没做过宣传。"
                                },
                                {
                                    "id": "110010219",
                                    "speaker": "杜拉夫",
                                    "text": "反正肉也是你想用的食材，我觉得没什么区别吧。"
                                },
                                {
                                    "id": "110010220",
                                    "speaker": "香菱",
                                    "text": "有区别，有很大的区别！比如我要加史莱姆凝液进去你会同意吗？"
                                },
                                {
                                    "id": "110010221",
                                    "speaker": "杜拉夫",
                                    "text": "这、这确实有点…不能用稍微正常一点的食材吗？"
                                },
                                {
                                    "id": "110010222",
                                    "speaker": "香菱",
                                    "text": "食材是没有正常不正常的！无论是什么只要方法得当，都能做出美味佳肴！"
                                },
                                {
                                    "id": "110010223",
                                    "speaker": "香菱",
                                    "text": "我不能让材料束缚我的灵感，那样做出来的东西注定是无聊的。",
                                    "choices": [
                                        {
                                            "id": "110010224",
                                            "text": "气场突然变得好强…",
                                            "response": [
                                                {
                                                    "id": "110010226",
                                                    "speaker": "杜拉夫",
                                                    "text": "唉，既然态度这么坚决，那就算了吧。但是真的很可惜啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110010225",
                                            "text": "这就是大厨的执着吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110010206",
                            "text": "真要动手的话…冲着我来吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100103",
            "objective": "跟上打算离开的香菱",
            "dialogues": [
                {
                    "id": "110010301",
                    "speaker": "派蒙",
                    "text": "其实也不用拒绝得这么坚决吧…我们不是来道歉的吗？"
                }
            ]
        },
        {
            "id": "1100104",
            "objective": "在香味的源头和香菱对话",
            "dialogues": [
                {
                    "id": "110010401",
                    "speaker": "香菱",
                    "text": "你好，你做的这个料理我可以尝尝看吗？"
                },
                {
                    "id": "110010402",
                    "speaker": "布洛克",
                    "text": "不好意思，这几天的份都预定满了，想吃的话要排到七天以后，可以吗？"
                },
                {
                    "id": "110010403",
                    "speaker": "派蒙",
                    "text": "这么受欢迎啊…那一定很好吃！"
                },
                {
                    "id": "110010404",
                    "speaker": "Player",
                    "text": "奇怪，明明有这么受欢迎的厨师…"
                },
                {
                    "id": "110010405",
                    "speaker": "派蒙",
                    "text": "对哦，为什么杜拉夫先生还要找香菱啊？"
                },
                {
                    "id": "110010406",
                    "speaker": "布洛克",
                    "text": "唉…可能是他觉得蒙德比起璃月港那种全大陆的商业枢纽，口味不够大众吧。"
                },
                {
                    "id": "110010407",
                    "speaker": "布洛克",
                    "text": "但我不服气！我从来不觉得我做出来的肉会输给谁！"
                },
                {
                    "id": "110010408",
                    "speaker": "香菱",
                    "text": "那就破例给我露一手嘛，或许我还能提一些建议什么的。"
                },
                {
                    "id": "110010409",
                    "speaker": "布洛克",
                    "text": "普通人只会说「好吃」之类没用的话，你又不是呃…等等…你就是香菱？！"
                },
                {
                    "id": "110010410",
                    "speaker": "香菱",
                    "text": "嗯，对啊。"
                },
                {
                    "id": "110010411",
                    "speaker": "布洛克",
                    "text": "原来就是你！那你一定也很会做肉了。"
                },
                {
                    "id": "110010412",
                    "speaker": "布洛克",
                    "text": "其实我这里还留了一块今天最好的肉，如果让你来做烤肉，你会怎么做？"
                },
                {
                    "id": "110010413",
                    "speaker": "香菱",
                    "text": "那要看肉质和脂肪含量了，这块肉我应该会岩烤，搭配海盐，绝云椒椒和清心花。"
                },
                {
                    "id": "110010414",
                    "speaker": "布洛克",
                    "text": "清心花？！它遇热油香味会大量释放，比生冷时浓郁好几倍，肉的香味都会被盖掉的！"
                },
                {
                    "id": "110010415",
                    "speaker": "香菱",
                    "text": "我知道的哦，但这清心花不是肉排的香料，而是配菜。"
                },
                {
                    "id": "110010416",
                    "speaker": "香菱",
                    "text": "我尝试过，只要火候得当，过了油的清心花花瓣的苦味会被去除，变成口感爽脆的点心。"
                },
                {
                    "id": "110010417",
                    "speaker": "香菱",
                    "text": "再选取长在高山上的绝云椒椒。低湿度和大温差，使得它能够产生特殊的干香风味。"
                },
                {
                    "id": "110010418",
                    "speaker": "香菱",
                    "text": "海盐的咸，绝云椒椒的辣，肉排油脂的鲜香，汇聚在花瓣上，咬下去还有植物的清香。"
                },
                {
                    "id": "110010419",
                    "speaker": "布洛克",
                    "text": "花里胡哨的，这不是喧宾夺主了吗？！"
                },
                {
                    "id": "110010420",
                    "speaker": "布洛克",
                    "text": "烤肉就是烤肉，肉香被盖住了还吃什么？"
                },
                {
                    "id": "110010421",
                    "speaker": "派蒙",
                    "text": "呜哇，别吵架，不要吵架啊！",
                    "choices": [
                        {
                            "id": "110010422",
                            "text": "已经听不到其他人的声音了…",
                            "response": [
                                {
                                    "id": "110010424",
                                    "speaker": "香菱",
                                    "text": "哼，既然这样，烹饪的问题就用烹饪来解决好了！"
                                },
                                {
                                    "id": "110010425",
                                    "speaker": "香菱",
                                    "text": "我要和你切磋厨艺！"
                                },
                                {
                                    "id": "110010426",
                                    "speaker": "布洛克",
                                    "text": "完全没问题，要是连我的料理都比不过，那就证明杜拉夫是看走眼了。"
                                },
                                {
                                    "id": "110010427",
                                    "speaker": "香菱",
                                    "text": "好啊，那这样吧，如果我赢了，我获胜的料理就用来宣传清泉镇！"
                                },
                                {
                                    "id": "110010428",
                                    "speaker": "布洛克",
                                    "text": "你输了的话，就在「万民堂」的菜单上加上我的这道菜。"
                                },
                                {
                                    "id": "110010429",
                                    "speaker": "布洛克",
                                    "text": "上面还要写上，清泉镇肉类大师布洛克之作。"
                                },
                                {
                                    "id": "110010430",
                                    "speaker": "香菱",
                                    "text": "一言为定！"
                                },
                                {
                                    "id": "110010431",
                                    "speaker": "香菱",
                                    "text": "我先走一步去找食材了！在璃月等你们！"
                                },
                                {
                                    "id": "110010432",
                                    "speaker": "派蒙",
                                    "text": "喂，等等啊！"
                                },
                                {
                                    "id": "110010433",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，只能跟上去了。"
                                }
                            ]
                        },
                        {
                            "id": "110010423",
                            "text": "这就是所谓的棋逢对手吧。"
                        }
                    ]
                }
            ]
        }
    ]
}