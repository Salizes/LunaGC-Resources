    "talks": [
        {
            "id": "7651001",
            "objective": "与埃德勒及维斯菈娃对话",
            "dialogues": [
                {
                    "id": "765100101",
                    "speaker": "埃德勒",
                    "text": "…这下总能证明，这不是什么秘密军事武器了吧。"
                },
                {
                    "id": "765100102",
                    "speaker": "维斯菈娃",
                    "text": "唔，确实，设计得再难一点就不算是过家家了，加油。"
                },
                {
                    "id": "765100103",
                    "speaker": "派蒙",
                    "text": "哇！又是一样可怕的气氛，紧张得像是要…"
                },
                {
                    "id": "765100104",
                    "speaker": "Player",
                    "text": "马上打起来了？"
                },
                {
                    "id": "765100105",
                    "speaker": "维斯菈娃",
                    "text": "#是啊…趁{NICKNAME}也在，不如现在，我们公平地切磋切磋。"
                },
                {
                    "id": "765100106",
                    "speaker": "埃德勒",
                    "text": "唉，真不知道你哪来的执念？不会是因为上次随随便便被我打翻了吧！如果是这个原因，那就切磋。"
                },
                {
                    "id": "765100107",
                    "speaker": "埃德勒",
                    "text": "#{NICKNAME}，您就瞧好了，看看谁先认输！"
                },
                {
                    "id": "765100108",
                    "speaker": "维斯菈娃",
                    "text": "哼，空会说大话可没用。",
                    "choices": [
                        {
                            "id": "765100109",
                            "text": "埃德勒看起来更有力…",
                            "response": [
                                {
                                    "id": "765100111",
                                    "speaker": "埃德勒",
                                    "text": "……"
                                },
                                {
                                    "id": "765100112",
                                    "speaker": "维斯菈娃",
                                    "text": "……"
                                },
                                {
                                    "id": "765100113",
                                    "speaker": "Player",
                                    "text": "……！"
                                },
                                {
                                    "id": "765100114",
                                    "speaker": "派蒙",
                                    "text": "呜哇哇！她们不是只是切磋一下吗？！"
                                },
                                {
                                    "id": "765100115",
                                    "speaker": "埃德勒",
                                    "text": "你现在认输还来得及，我会给你三秒钟的时间…"
                                },
                                {
                                    "id": "765100116",
                                    "speaker": "埃德勒",
                                    "text": "三，二，一…"
                                },
                                {
                                    "id": "765100117",
                                    "speaker": "派蒙",
                                    "text": "哇呜！"
                                },
                                {
                                    "id": "765100118",
                                    "speaker": "Black Screen",
                                    "text": "一声金属的「咔哒」脆响后，一切都归于了平静…"
                                },
                                {
                                    "id": "765100119",
                                    "speaker": "埃德勒",
                                    "text": "好了，小派蒙，可以睁眼了。"
                                },
                                {
                                    "id": "765100120",
                                    "speaker": "维斯菈娃",
                                    "text": "看来，全场最紧张的人在这儿了！"
                                },
                                {
                                    "id": "765100121",
                                    "speaker": "派蒙",
                                    "text": "什、什么？维斯菈娃居然是好好的。",
                                    "choices": [
                                        {
                                            "id": "765100122",
                                            "text": "埃德勒在吓唬维斯菈娃。",
                                            "response": [
                                                {
                                                    "id": "765100124",
                                                    "speaker": "埃德勒",
                                                    "text": "是啊，我可不想出来一趟，还被关到外地的监狱里…"
                                                },
                                                {
                                                    "id": "765100125",
                                                    "speaker": "埃德勒",
                                                    "text": "只好强装大胆，虚张声势，好让她瞧瞧，我不是那种能随意拿捏的懦弱行商。"
                                                },
                                                {
                                                    "id": "765100126",
                                                    "speaker": "埃德勒",
                                                    "text": "这样下次见面，她就不敢随随便便找我麻烦。"
                                                },
                                                {
                                                    "id": "765100127",
                                                    "speaker": "派蒙",
                                                    "text": "#可是，{NICKNAME}你又是怎么看出来的！我看你完全不紧张。",
                                                    "choices": [
                                                        {
                                                            "id": "765100128",
                                                            "text": "埃德勒的表情看起来很放松。",
                                                            "response": [
                                                                {
                                                                    "id": "765100130",
                                                                    "speaker": "维斯菈娃",
                                                                    "text": "您真敏锐。恐吓的确是最快让人认输的办法。可惜，走捷径总归是没那么容易的，朋友。"
                                                                },
                                                                {
                                                                    "id": "765100131",
                                                                    "speaker": "维斯菈娃",
                                                                    "text": "#更何况，{NICKNAME}还在这呢…总之，现在我还好好地站着。"
                                                                },
                                                                {
                                                                    "id": "765100132",
                                                                    "speaker": "维斯菈娃",
                                                                    "text": "只是下次遇见的时候，希望有机会…"
                                                                },
                                                                {
                                                                    "id": "765100133",
                                                                    "speaker": "埃德勒",
                                                                    "text": "可别，小的可没这么多机会和您这位大人遇上。"
                                                                },
                                                                {
                                                                    "id": "765100134",
                                                                    "speaker": "埃德勒",
                                                                    "text": "如果，下次碰面在你的执勤期内，你要对我做些什么，我也只好正当防卫。"
                                                                },
                                                                {
                                                                    "id": "765100135",
                                                                    "speaker": "埃德勒",
                                                                    "text": "若又在你的休假期内碰上了，那还是来盘兵棋推演算了，就当是照顾照顾我的生意好了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765100129",
                                                            "text": "埃德勒说了，是看「谁先认输」。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765100123",
                                            "text": "铳枪里没有子弹。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765100110",
                            "text": "维斯菈娃看起来更高大…"
                        }
                    ]
                }
            ]
        }
    ]
}