        {
            "id": "7711009",
            "objective": "与娜斯佳会合",
            "dialogues": [
                {
                    "id": "771100201",
                    "speaker": "娜斯佳",
                    "text": "呼！你们回来了！找到「控制轮」了吗？"
                },
                {
                    "id": "771100202",
                    "speaker": "Player",
                    "text": "哼哼，小事一桩哦~"
                },
                {
                    "id": "771100203",
                    "speaker": "派蒙",
                    "text": "喂喂！怎么突然抢我台词啦！"
                },
                {
                    "id": "771100204",
                    "speaker": "派蒙",
                    "text": "不过现在有了「控制轮」，我们就能坐升降梯去大礼堂了吧。"
                },
                {
                    "id": "771100205",
                    "speaker": "娜斯佳",
                    "text": "嗯，我们快出发吧，爸爸妈妈、还有其他人肯定急得不得了啦…跟我来！"
                }
            ]
        },
