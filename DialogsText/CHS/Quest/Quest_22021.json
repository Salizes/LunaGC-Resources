            "龟井宗久": 33
        }
    },
    "talks": [
        {
            "id": "2202101",
            "objective": "对话旭东",
            "dialogues": [
                {
                    "id": "220210101",
                    "speaker": "旭东",
                    "text": "我这道菜可是很厉害的，你可要做好准备！"
                },
                {
                    "id": "220210102",
                    "speaker": "龟井宗久",
                    "text": "在下的这道菜同样很不错，请阁下也做好准备。"
                },
                {
                    "id": "220210103",
                    "speaker": "Player",
                    "text": "你们干什么呢？"
                },
                {
                    "id": "220210104",
                    "speaker": "旭东",
                    "text": "是你啊旅行者。是这样，芭尔瓦涅和朱莉出去搜集食材了，我们本来打算给她们准备准备饭菜。"
                },
                {
                    "id": "220210105",
                    "speaker": "旭东",
                    "text": "但我和宗久大叔对于准备什么菜，有一点点分歧。"
                },
                {
                    "id": "220210106",
                    "speaker": "旭东",
                    "text": "所以，我和宗久大叔就打算各自出一道菜切磋一下厨艺，顺便以此决定今天的菜色。"
                },
                {
                    "id": "220210107",
                    "speaker": "旭东",
                    "text": "我打算做一道璃月特色菜「珍珠翡翠白玉汤」。"
                },
                {
                    "id": "220210108",
                    "speaker": "龟井宗久",
                    "text": "在下则准备用拿手的「串串三味」来应战。",
                    "choices": [
                        {
                            "id": "220210109",
                            "text": "需要我帮忙吗？",
                            "response": [
                                {
                                    "id": "220210110",
                                    "speaker": "旭东",
                                    "text": "唔，如果你有空的话，我们确实需要一个负责评判味道高低的裁判…"
                                },
                                {
                                    "id": "220210113",
                                    "speaker": "旭东",
                                    "text": "但我俩各自都只有一个人，而且每道菜要准备四个人的份，说不定会有些忙不过来。"
                                },
                                {
                                    "id": "220210114",
                                    "speaker": "旭东",
                                    "text": "在评判味道之前，还是请你先帮我们准备准备那道菜吧。"
                                },
                                {
                                    "id": "220210115",
                                    "speaker": "旭东",
                                    "text": "当然，你也只有一个人，所以你就挑一道你感兴趣的菜帮忙吧。",
                                    "choices": [
                                        {
                                            "id": "220210116",
                                            "text": "旭东，你忙得过来吗？",
                                            "response": [
                                                {
                                                    "id": "220210117",
                                                    "speaker": "旭东",
                                                    "text": "你也不用担心我，我好歹之前在璃月也是个开餐馆的，只是准备准备饭菜而已，难不倒我。"
                                                },
                                                {
                                                    "id": "220210118",
                                                    "speaker": "旭东",
                                                    "text": "只不过，如果有人帮忙的话，饭菜能做得更精细一些就是了。"
                                                },
                                                {
                                                    "id": "220210122",
                                                    "speaker": "旭东",
                                                    "text": "总之，你就挑一道你感兴趣的菜帮忙吧。",
                                                    "choices": [
                                                        {
                                                            "id": "220210123",
                                                            "text": "旭东，我来帮你。",
                                                            "response": [
                                                                {
                                                                    "id": "220210124",
                                                                    "speaker": "旭东",
                                                                    "text": "噢！那太好了，宗久大叔，你可要准备好，可别被我的菜一口气打倒了！"
                                                                },
                                                                {
                                                                    "id": "220210125",
                                                                    "speaker": "龟井宗久",
                                                                    "text": "在下可不会轻易认输的，阁下尽管放手施为。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220210126",
                                                            "text": "宗久大叔，我来帮你。",
                                                            "response": [
                                                                {
                                                                    "id": "220210127",
                                                                    "speaker": "龟井宗久",
                                                                    "text": "多谢阁下。旭东阁下，你可要小心了。"
                                                                },
                                                                {
                                                                    "id": "220210128",
                                                                    "speaker": "旭东",
                                                                    "text": "没问题，你就尽管放马过来吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220210119",
                                            "text": "宗久大叔，你忙得过来吗？",
                                            "response": [
                                                {
                                                    "id": "220210120",
                                                    "speaker": "龟井宗久",
                                                    "text": "阁下凭自己喜好挑选即可，在下还在幕府之时，也经常一人准备好几个人的下酒菜，现在只是四人份而已，不成问题。"
                                                },
                                                {
                                                    "id": "220210121",
                                                    "speaker": "龟井宗久",
                                                    "text": "但如果阁下愿施以援手，那在下的饭菜一定能做出更好的味道。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220210111",
                            "text": "你们一定缺一个裁判。",
                            "response": [
                                {
                                    "id": "220210112",
                                    "speaker": "旭东",
                                    "text": "哈哈哈，可不是，我们正需要一个负责评判味道高低的裁判呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2202102",
            "objective": "帮助旭东制作「珍珠翡翠白玉汤」",
            "dialogues": [
                {
                    "id": "220210201",
                    "speaker": "旭东",
                    "text": "这样就做好了，多谢啦旅行者。这香味，闻着就好。"
                },
                {
                    "id": "220210202",
                    "speaker": "旭东",
                    "text": "我先来尝尝…嗬，不错，食材炖煮的程度刚好，香气也很足。"
                },
                {
                    "id": "220210203",
                    "speaker": "旭东",
                    "text": "可以说是一道「完美的珍珠翡翠白玉汤」了。"
                },
                {
                    "id": "220210204",
                    "speaker": "旭东",
                    "text": "好嘞，宗久大叔，你的菜做得怎么样了？你也拿出来让旅行者品鉴一下吧。"
                },
                {
                    "id": "220210205",
                    "speaker": "龟井宗久",
                    "text": "唔，在下失误了。在开始做菜的时候，才发现没有备足鸟蛋。"
                },
                {
                    "id": "220210206",
                    "speaker": "龟井宗久",
                    "text": "虽然在下马上从旁边的树林里取了些鸟蛋，但其余的食材却都过了最佳的处理期。"
                },
                {
                    "id": "220210207",
                    "speaker": "龟井宗久",
                    "text": "以这种新鲜度欠佳的食材制作的「串串三味」，已经不能称得上是一道好菜了。"
                },
                {
                    "id": "220210208",
                    "speaker": "龟井宗久",
                    "text": "居然会如此疏忽，在下真是惭愧，在厨艺一道上，我还需要再多加训练才是。"
                },
                {
                    "id": "220210209",
                    "speaker": "龟井宗久",
                    "text": "这次的比试，是在下输了。但下次，在下一定会赢过你的，旭东阁下。",
                    "choices": [
                        {
                            "id": "220210210",
                            "text": "要加油啊，大叔。",
                            "response": [
                                {
                                    "id": "220210211",
                                    "speaker": "旭东",
                                    "text": "嘿嘿，不过我也不是那么好战胜的啦。"
                                },
                                {
                                    "id": "220210212",
                                    "speaker": "旭东",
                                    "text": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。"
                                },
                                {
                                    "id": "220210213",
                                    "speaker": "旭东",
                                    "text": "下次我们对决的时候，你可一定也要过来啊。"
                                }
                            ]
                        },
                        {
                            "id": "220210214",
                            "text": "其实我感觉味道还好啦…",
                            "response": [
                                {
                                    "id": "220210215",
                                    "speaker": "龟井宗久",
                                    "text": "不，就算是做菜，也要怀着追求极致之心，不断追求厨艺的「极意」，绝不能满意于「差不多」。"
                                },
                                {
                                    "id": "220210216",
                                    "speaker": "龟井宗久",
                                    "text": "这样，才能不断攀上厨艺之道上的一个个高点！"
                                },
                                {
                                    "id": "220210217",
                                    "speaker": "旭东",
                                    "text": "是…是！"
                                },
                                {
                                    "id": "220210218",
                                    "speaker": "Player",
                                    "text": "是…是！"
                                },
                                {
                                    "id": "220210219",
                                    "speaker": "龟井宗久",
                                    "text": "这既是武道，也是厨道，更是在下的为人之道。"
                                },
                                {
                                    "id": "220210220",
                                    "speaker": "旭东",
                                    "text": "啊…好！要加油啊，宗久大叔，要加油啊，哈哈…"
                                },
                                {
                                    "id": "220210221",
                                    "speaker": "旭东",
                                    "text": "呃啊…我对这种…这种严肃的人一点办法都没有…只有朱莉能对付宗久大叔，但是她现在又不在…"
                                },
                                {
                                    "id": "220210222",
                                    "speaker": "Player",
                                    "text": "完全被震慑住了…"
                                },
                                {
                                    "id": "220210223",
                                    "speaker": "旭东",
                                    "text": "咳，这次辛苦你了旅行者，这些东西请收下吧，我…"
                                },
                                {
                                    "id": "220210224",
                                    "speaker": "龟井宗久",
                                    "text": "旭东阁下，在下还想请教您一些厨艺上的问题，请问您现在有空吗？"
                                },
                                {
                                    "id": "220210225",
                                    "speaker": "旭东",
                                    "text": "啊？有！我有空，现在就来！马上就来…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2202103",
            "objective": "帮助龟井宗久制作「串串三味」",
            "dialogues": [
                {
                    "id": "220210301",
                    "speaker": "龟井宗久",
                    "text": "嗯，这气味和外表…这道「串串三味」应该能称得上是「极意之串」了。"
                },
                {
                    "id": "220210302",
                    "speaker": "Player",
                    "text": "极、极意之串？"
                },
                {
                    "id": "220210303",
                    "speaker": "龟井宗久",
                    "text": "呵呵，就是一道完美的「串串三味」…看时间，旭东阁下的「珍珠翡翠白玉汤」应该也做好了。"
                },
                {
                    "id": "220210304",
                    "speaker": "旭东",
                    "text": "那是当然了，这就是我做的「珍珠翡翠白玉汤」了。"
                },
                {
                    "id": "220210305",
                    "speaker": "旭东",
                    "text": "虽然因为我没有分配好处理食材的时间，汤可能煮得稍微过了一点，但味道应该还过得去。"
                },
                {
                    "id": "220210306",
                    "speaker": "龟井宗久",
                    "text": "请容在下尝尝。"
                },
                {
                    "id": "220210307",
                    "speaker": "龟井宗久",
                    "text": "唔，确实略有一些焦糊味，虽然不至于坏掉一锅菜，但终究是有些瑕疵。"
                },
                {
                    "id": "220210308",
                    "speaker": "旭东",
                    "text": "哈哈哈，这次赶得太急了，下次等我预先把食材都准备好，应该就不会有这个问题了。"
                },
                {
                    "id": "220210309",
                    "speaker": "旭东",
                    "text": "这次是我输了，不过下次我可就不会犯这种错误了。",
                    "choices": [
                        {
                            "id": "220210310",
                            "text": "是你大意了啊。",
                            "response": [
                                {
                                    "id": "220210311",
                                    "speaker": "旭东",
                                    "text": "哈哈哈…是啊，一个不留神就输给大叔了，下次对决的时候，我可要更仔细一点才行…"
                                },
                                {
                                    "id": "220210312",
                                    "speaker": "旭东",
                                    "text": "对了旅行者，这些东西给你，收下吧，谢谢你陪我和大叔折腾到现在。"
                                },
                                {
                                    "id": "220210313",
                                    "speaker": "旭东",
                                    "text": "下次我们对决的时候，你可一定也要过来啊。"
                                }
                            ]
                        },
                        {
                            "id": "220210314",
                            "text": "大叔的「极意之串」更胜一筹了啊。",
                            "response": [
                                {
                                    "id": "220210315",
                                    "speaker": "旭东",
                                    "text": "极、极意之串？什么？"
                                },
                                {
                                    "id": "220210316",
                                    "speaker": "龟井宗久",
                                    "text": "意思就是「品质完美的串串三味」。"
                                },
                                {
                                    "id": "220210317",
                                    "speaker": "龟井宗久",
                                    "text": "所谓「极意」，正是绝不满意于「差不多」，不断追求极致之心。"
                                },
                                {
                                    "id": "220210318",
                                    "speaker": "龟井宗久",
                                    "text": "即便是做菜也是如此，只有怀着追求极致之心，才能不断攀上厨艺之道上的一个个高点！"
                                },
                                {
                                    "id": "220210319",
                                    "speaker": "旭东",
                                    "text": "是…是！"
                                },
                                {
                                    "id": "220210320",
                                    "speaker": "Player",
                                    "text": "是…是！"
                                },
                                {
                                    "id": "220210321",
                                    "speaker": "龟井宗久",
                                    "text": "这既是武道，也是厨道，更是在下的为人之道。"
                                },
                                {
                                    "id": "220210322",
                                    "speaker": "龟井宗久",
                                    "text": "旭东阁下，请来这边，容在下稍微为您讲一讲「极意」之道。"
                                },
                                {
                                    "id": "220210323",
                                    "speaker": "旭东",
                                    "text": "啊？这…这…大叔你稍等一下，旅行者，这些报酬你拿好…"
                                },
                                {
                                    "id": "220210324",
                                    "speaker": "旭东",
                                    "text": "呃啊…我对这种…这种严肃的人一点办法都没有…只有朱莉能对付宗久大叔，但是她现在又不在…"
                                },
                                {
                                    "id": "220210325",
                                    "speaker": "Player",
                                    "text": "你就好好去感受「极意厨道」吧。"
                                },
                                {
                                    "id": "220210326",
                                    "speaker": "龟井宗久",
                                    "text": "旭东阁下？"
                                },
                                {
                                    "id": "220210327",
                                    "speaker": "旭东",
                                    "text": "啊？我来了，现在就来！马上就来…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2202104",
            "objective": "帮助旭东增大火力",
            "dialogues": [
                {
                    "id": "220210401",
                    "speaker": "旭东",
                    "text": "怎么样，你采到金鱼草了吗？"
                }
            ]
        },
        {
            "id": "2202105",
            "objective": "帮助龟井宗久调小火力",
            "dialogues": [
                {
                    "id": "220210501",
                    "speaker": "龟井宗久",
                    "text": "怎么样，您拿到鸟蛋了吗？"
                }
            ]
        },
        {
            "id": "2202111",
            "objective": "对话旭东",
            "dialogues": [
                {
                    "id": "220210601",
                    "speaker": "旭东",
                    "text": "那我们就开始吧。「珍珠翡翠白玉汤」要用到金鱼草、豆腐和莲蓬…"
                },
                {
                    "id": "220210602",
                    "speaker": "旭东",
                    "text": "莲蓬…豆腐…幸好还有些剩下，但金鱼草好像不太够了…"
                },
                {
                    "id": "220210603",
                    "speaker": "旭东",
                    "text": "旅行者，我在这里处理食材。为了保险起见，请你再帮我去找三份新鲜的金鱼草过来吧。"
                }
            ]
        },
        {
            "id": "2202112",
            "objective": "对话龟井宗久",
            "dialogues": [
                {
                    "id": "220210701",
                    "speaker": "龟井宗久",
                    "text": "多谢阁下愿意帮忙。这道名为「串串三味」的菜做法虽然简单，但却需要格外注意食材的新鲜度。"
                },
                {
                    "id": "220210702",
                    "speaker": "龟井宗久",
                    "text": "其余的材料我都已经准备完毕，但鸟蛋却备少了一些…为了保险起见，阁下，能请您帮我去取两颗新鲜的鸟蛋过来吗？",
                    "choices": [
                        {
                            "id": "220210703",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "220210704",
                                    "speaker": "龟井宗久",
                                    "text": "那就拜托阁下了。"
                                }
                            ]
                        },
                        {
                            "id": "220210705",
                            "text": "你怎么会做这个的？",
                            "response": [
                                {
                                    "id": "220210706",
                                    "speaker": "龟井宗久",
                                    "text": "还在幕府内任职的时候，在下经常做这种小菜，和几位同僚用来下酒。"
                                },
                                {
                                    "id": "220210707",
                                    "speaker": "龟井宗久",
                                    "text": "但现在…"
                                },
                                {
                                    "id": "220210708",
                                    "speaker": "龟井宗久",
                                    "text": "往事就不提了，鸟蛋就拜托阁下了。"
                                },
                                {
                                    "id": "220210709",
                                    "speaker": "龟井宗久",
                                    "text": "我会在这里处理食材，您拿到了鸟蛋后，请尽快拿给我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2202113",
            "objective": "采摘三份新鲜的金鱼草",
            "dialogues": []
        },
        {
            "id": "2202114",
            "objective": "取得两颗新鲜的鸟蛋",
            "dialogues": []
        },
        {
            "id": "2202106",
            "objective": "将新鲜的金鱼草带给旭东",
            "dialogues": []
        },
        {
            "id": "2202107",
            "objective": "将新鲜的鸟蛋带回给龟井宗久",
            "dialogues": []
