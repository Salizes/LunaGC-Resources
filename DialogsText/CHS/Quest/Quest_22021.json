{
    "quest": {
        "id": "22021",
        "title": "全能美食队·烹饪对决",
        "description": "全能美食队的旭东和龟井宗久似乎正在准备进行一场烹饪对决…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
