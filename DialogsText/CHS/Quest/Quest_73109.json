    "talks": [
        {
            "id": "7310901",
            "objective": "与贾维对话$HIDDEN",
            "dialogues": [
                {
                    "id": "731090101",
                    "speaker": "贾维",
                    "text": "咦？应该就在这附近啊，怎么不见了…"
                },
                {
                    "id": "731090102",
                    "speaker": "Player",
                    "text": "你在找什么呢？"
                },
                {
                    "id": "731090103",
                    "speaker": "贾维",
                    "text": "你是…喔，应该是旅行者吧，我听人家提起过你。"
                },
                {
                    "id": "731090104",
                    "speaker": "贾维",
                    "text": "我叫贾维，是个…是个普通的售货员，我正在这里找我之前埋下去的一个「梦想盒」呢。"
                },
                {
                    "id": "731090105",
                    "speaker": "派蒙",
                    "text": "好奇怪的名字…这盒子里面装着什么呀？"
                },
                {
                    "id": "731090106",
                    "speaker": "贾维",
                    "text": "嗯…非要说的话，应该是装着我小时候「期待实现的梦想」吧。"
                },
                {
                    "id": "731090107",
                    "speaker": "Player",
                    "text": "为什么要这么做？"
                },
                {
                    "id": "731090108",
                    "speaker": "贾维",
                    "text": "哈哈哈，这是我在很小的时候，和我的朋友们一起做的一种游戏啦。"
                },
                {
                    "id": "731090109",
                    "speaker": "贾维",
                    "text": "把自己最想要实现的那个梦想写下来，然后埋在这里。然后再约定一个时间，一起过来把这「梦想盒」挖出来。"
                },
                {
                    "id": "731090110",
                    "speaker": "贾维",
                    "text": "现在就是我们约定的时间啦。但是…看来只有我一个人还记得这件事啊。"
                },
                {
                    "id": "731090111",
                    "speaker": "贾维",
                    "text": "唉，这件事他们忘了就忘了吧…只要别忘了自己的梦想就行。"
                },
                {
                    "id": "731090112",
                    "speaker": "贾维",
                    "text": "总之，我这次过来就是想把自己的盒子挖出来，也算是了结一桩心事。"
                },
                {
                    "id": "731090113",
                    "speaker": "贾维",
                    "text": "但我找了一圈，却什么也没找到，不会被人给挖走了吧？",
                    "choices": [
                        {
                            "id": "731090114",
                            "text": "你那个时候做了标记吗？",
                            "response": [
                                {
                                    "id": "731090118",
                                    "speaker": "贾维",
                                    "text": "我记得，那个时候我是埋在一棵树旁边…"
                                },
                                {
                                    "id": "731090119",
                                    "speaker": "派蒙",
                                    "text": "一棵树？这，这周围可是有好多树啊！"
                                },
                                {
                                    "id": "731090120",
                                    "speaker": "贾维",
                                    "text": "我小时候也没有注意过这种事啊，当时我们就在埋盒子的地方插了一个小牌子做标记。"
                                },
                                {
                                    "id": "731090121",
                                    "speaker": "贾维",
                                    "text": "过了这么长时间，那个牌子已经不见了，周围的树我也完全认不出来了…"
                                },
                                {
                                    "id": "731090122",
                                    "speaker": "贾维",
                                    "text": "我就隐约记得，埋盒子的地方就在这附近。"
                                },
                                {
                                    "id": "731090123",
                                    "speaker": "贾维",
                                    "text": "旅行者，能请你帮我一起找找看吗？",
                                    "choices": [
                                        {
                                            "id": "731090124",
                                            "text": "怎么找？",
                                            "response": [
                                                {
                                                    "id": "731090125",
                                                    "speaker": "贾维",
                                                    "text": "我把那个盒子埋在了一棵树的旁边，所以…就先在树旁边挖挖看吧。"
                                                },
                                                {
                                                    "id": "731090126",
                                                    "speaker": "贾维",
                                                    "text": "帮帮忙啦旅行者，我会支付给你报酬的。"
                                                },
                                                {
                                                    "id": "731090130",
                                                    "speaker": "贾维",
                                                    "text": "你看，这片树林这么大，我一个人可找不过来…"
                                                },
                                                {
                                                    "id": "731090131",
                                                    "speaker": "Player",
                                                    "text": "好吧…"
                                                },
                                                {
                                                    "id": "731090132",
                                                    "speaker": "贾维",
                                                    "text": "嘿嘿，多谢你了，那我们就分头行动吧，我在这边，另外一边就拜托你了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090127",
                                            "text": "反正梦想都飞走了…",
                                            "response": [
                                                {
                                                    "id": "731090128",
                                                    "speaker": "贾维",
                                                    "text": "就是因为我的梦想飞走了，我才更要挖出来那个盒子，看看我当初希望实现的梦想啊。"
                                                },
                                                {
                                                    "id": "731090129",
                                                    "speaker": "贾维",
                                                    "text": "拜托你啦旅行者，就帮帮我吧，我会支付给你报酬的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090115",
                            "text": "梦想飞走了啊…",
                            "response": [
                                {
                                    "id": "731090116",
                                    "speaker": "贾维",
                                    "text": "哈哈哈…我倒是不否认这件事，毕竟我现在都不记得我当初写下来的梦想了…"
                                },
                                {
                                    "id": "731090117",
                                    "speaker": "贾维",
                                    "text": "但就算我的梦想会飞走，那个盒子也不会飞走啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310902",
            "objective": "帮贾维寻找「梦想」",
            "dialogues": []
        },
        {
            "id": "7310903",
            "objective": "把「梦想」交给贾维",
            "dialogues": [
                {
                    "id": "731090301",
                    "speaker": "贾维",
                    "text": "坏了，这个「梦想盒」不是我的…",
                    "choices": [
                        {
                            "id": "731090302",
                            "text": "我们挖到了一个盒子。",
                            "response": [
                                {
                                    "id": "731090303",
                                    "speaker": "贾维",
                                    "text": "哈哈…我也挖到了一个…"
                                },
                                {
                                    "id": "731090305",
                                    "speaker": "贾维",
                                    "text": "我还把这个「梦想盒」打开了，盒子里的纸条上还署着阿米的名呢。"
                                },
                                {
                                    "id": "731090306",
                                    "speaker": "贾维",
                                    "text": "我记得这孩子，她是贾汉吉尔的女儿，经常在那个食品店旁边待着。"
                                },
                                {
                                    "id": "731090307",
                                    "speaker": "贾维",
                                    "text": "这孩子的梦想是当一个花匠，要种很多花…"
                                },
                                {
                                    "id": "731090308",
                                    "speaker": "贾维",
                                    "text": "没看出来啊，我还以为贾汉吉尔要把她培养成自家店的接班人呢。",
                                    "choices": [
                                        {
                                            "id": "731090309",
                                            "text": "先看看你的梦想吧。",
                                            "response": [
                                                {
                                                    "id": "731090311",
                                                    "speaker": "贾维",
                                                    "text": "喔！对对，得先看看我自己的梦想…"
                                                },
                                                {
                                                    "id": "731090312",
                                                    "speaker": "贾维",
                                                    "text": "我看看啊…"
                                                },
                                                {
                                                    "id": "731090313",
                                                    "speaker": "贾维",
                                                    "text": "「希望成为『林行者』，一直住在树林里…」"
                                                },
                                                {
                                                    "id": "731090314",
                                                    "speaker": "贾维",
                                                    "text": "我小时候的梦想居然是这个？真不知道我当时在想什么…"
                                                },
                                                {
                                                    "id": "731090315",
                                                    "speaker": "贾维",
                                                    "text": "唉…臭小子，林行者可不是一个能轻松赚钱的活啊。",
                                                    "choices": [
                                                        {
                                                            "id": "731090316",
                                                            "text": "我觉得没什么不好。",
                                                            "response": [
                                                                {
                                                                    "id": "731090318",
                                                                    "speaker": "贾维",
                                                                    "text": "那是小孩子才能有的想法，到我这个年纪了，梦想…"
                                                                },
                                                                {
                                                                    "id": "731090319",
                                                                    "speaker": "贾维",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "731090320",
                                                                    "speaker": "贾维",
                                                                    "text": "倒不如想想怎么多赚几个摩拉，晚上睡觉的时候能睡得安稳些。"
                                                                },
                                                                {
                                                                    "id": "731090321",
                                                                    "speaker": "贾维",
                                                                    "text": "行了，别说我那个无聊的梦想了，还是看看阿米的吧。"
                                                                },
                                                                {
                                                                    "id": "731090322",
                                                                    "speaker": "贾维",
                                                                    "text": "我把她的「梦想盒」给拆了，要做点事给她赔罪才行。"
                                                                },
                                                                {
                                                                    "id": "731090323",
                                                                    "speaker": "贾维",
                                                                    "text": "嗯…让我想想，既然她想做花匠，那首先就要学一学种花。"
                                                                },
                                                                {
                                                                    "id": "731090324",
                                                                    "speaker": "贾维",
                                                                    "text": "我那里正好有闲置的花盆，可以拿去给她。"
                                                                },
                                                                {
                                                                    "id": "731090325",
                                                                    "speaker": "贾维",
                                                                    "text": "旅行者，你知道怎么弄到花的种子吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "731090326",
                                                                            "text": "交给我吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090332",
                                                                                    "speaker": "贾维",
                                                                                    "text": "那种子的事情就拜托你了，旅行者，我们等会在贾汉吉尔的店旁边碰头吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "731090327",
                                                                            "text": "你为什么要这么做？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090328",
                                                                                    "speaker": "贾维",
                                                                                    "text": "哈哈哈…算是一时兴起吧。"
                                                                                },
                                                                                {
                                                                                    "id": "731090329",
                                                                                    "speaker": "贾维",
                                                                                    "text": "我是不可能再去追逐梦想了，一方面是年纪不小了，另一方面…是我也不怎么在意这个梦想了。"
                                                                                },
                                                                                {
                                                                                    "id": "731090330",
                                                                                    "speaker": "贾维",
                                                                                    "text": "但阿米还小，她还能尝试实现自己的梦想。"
                                                                                },
                                                                                {
                                                                                    "id": "731090331",
                                                                                    "speaker": "贾维",
                                                                                    "text": "我这个无聊的大人也没什么能帮她的，就送个花盆，算是为她加油打气吧。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090317",
                                                            "text": "梦想没有好坏之分。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090310",
                                            "text": "这是你的「梦想盒」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090304",
                            "text": "你也挖出来一个？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310904",
            "objective": "收集「须弥蔷薇」的种子",
            "dialogues": []
        },
        {
            "id": "7310905",
            "objective": "与阿米对话",
            "dialogues": [
                {
                    "id": "731090501",
                    "speaker": "阿米",
                    "text": "这个…是给我的吗？"
                },
                {
                    "id": "731090502",
                    "speaker": "阿米",
                    "text": "那个盒子我是随便埋下去的，里面的纸条也是我随便写的，叔叔看到了没什么关系，不用向我道歉的！"
                },
                {
                    "id": "731090503",
                    "speaker": "贾维",
                    "text": "没事，这花盆反正放在我那里也没用，就送给你啦。"
                },
                {
                    "id": "731090504",
                    "speaker": "贾维",
                    "text": "我还拜托人去找种子，应该马上就会过来…",
                    "choices": [
                        {
                            "id": "731090505",
                            "text": "种子来了！",
                            "response": [
                                {
                                    "id": "731090507",
                                    "speaker": "贾维",
                                    "text": "欸？你是什么时候来的，我都没注意到…"
                                },
                                {
                                    "id": "731090508",
                                    "speaker": "贾维",
                                    "text": "咳…阿米，你不是想要做花匠吗？你就先用这些东西开始种花吧。"
                                },
                                {
                                    "id": "731090509",
                                    "speaker": "阿米",
                                    "text": "谢谢…但我如果在爸爸的店旁边养花的话，虫虫说不定就会飞进那个锅里…"
                                },
                                {
                                    "id": "731090510",
                                    "speaker": "阿米",
                                    "text": "掉进锅里的虫虫很可怜，吃到虫虫的大人也很可怜。"
                                },
                                {
                                    "id": "731090511",
                                    "speaker": "阿米",
                                    "text": "如果把花挪远的话，我又担心会忘记去照顾它，枯掉的花也很可怜…"
                                },
                                {
                                    "id": "731090512",
                                    "speaker": "阿米",
                                    "text": "而且爸爸平时很忙，也不让我一个人跑太远…"
                                },
                                {
                                    "id": "731090513",
                                    "speaker": "贾维",
                                    "text": "嗯…如果你愿意的话，我和你一起照顾这盆花，怎么样？"
                                },
                                {
                                    "id": "731090514",
                                    "speaker": "贾维",
                                    "text": "虽然我每天只能下班的时候过来，但多少也有点空闲时间。"
                                },
                                {
                                    "id": "731090515",
                                    "speaker": "阿米",
                                    "text": "好呀！但是爸爸也许不会答应…"
                                },
                                {
                                    "id": "731090516",
                                    "speaker": "贾维",
                                    "text": "我和贾汉吉尔先生也算是认识了，等会我们一起去和他说说，他应该会答应的。"
                                },
                                {
                                    "id": "731090517",
                                    "speaker": "阿米",
                                    "text": "好！那…那我还要再种几盆花！我最喜欢须弥蔷薇了！将来…我要在爸爸的店旁边种满须弥蔷薇！"
                                },
                                {
                                    "id": "731090518",
                                    "speaker": "贾维",
                                    "text": "行啊，小丫头还挺有理想的，那我们两个就一起努力吧！",
                                    "choices": [
                                        {
                                            "id": "731090519",
                                            "text": "到时候记得分我一朵。",
                                            "response": [
                                                {
                                                    "id": "731090521",
                                                    "speaker": "阿米",
                                                    "text": "#嗯！谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想想…我还要再种一盆甜甜花，然后再种什么好呢…"
                                                },
                                                {
                                                    "id": "731090522",
                                                    "speaker": "贾维",
                                                    "text": "看来这孩子是真心喜欢种花啊，希望她能一直坚持自己的梦想…"
                                                },
                                                {
                                                    "id": "731090523",
                                                    "speaker": "贾维",
                                                    "text": "嘿嘿…可别和我一样，变成这么一个普通又无聊的人啊。"
                                                },
                                                {
                                                    "id": "731090524",
                                                    "speaker": "贾维",
                                                    "text": "咳！旅行者，谢谢你帮忙，这些报酬给你，收下吧。",
                                                    "choices": [
                                                        {
                                                            "id": "731090525",
                                                            "text": "认真的生活并不普通。",
                                                            "response": [
                                                                {
                                                                    "id": "731090527",
                                                                    "speaker": "贾维",
                                                                    "text": "谢谢你啊，我也不是在抱怨什么啦。"
                                                                },
                                                                {
                                                                    "id": "731090528",
                                                                    "speaker": "贾维",
                                                                    "text": "只不过…今天看见我埋下去的「梦想」，稍微有点感慨而已。"
                                                                },
                                                                {
                                                                    "id": "731090529",
                                                                    "speaker": "贾维",
                                                                    "text": "好了，我也差不多要回去了，今天多谢你帮忙了，旅行者。"
                                                                },
                                                                {
                                                                    "id": "731090530",
                                                                    "speaker": "贾维",
                                                                    "text": "我要不要…重新写一份「梦想」，然后再埋回去呢…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090526",
                                                            "text": "认真的生活并不无聊。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090520",
                                            "text": "加油啊！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090506",
                            "text": "这些花种给你。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310930",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731093001",
                    "speaker": "贾维",
                    "text": "这里也没有…"
                },
                {
                    "id": "731093002",
                    "speaker": "贾维",
                    "text": "唉，那个盒子不会真的飞走了吧…"
                }
            ]
        },
        {
            "id": "7310999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731099901",
                    "speaker": "派蒙",
                    "text": "这里没有啊…我们去下一棵树旁边看看吧。"
                },
                {
                    "id": "731099902",
                    "speaker": "派蒙",
                    "text": "什么也没发现呢，不会是被人拿走了吧…"
                },
                {
                    "id": "731099903",
                    "speaker": "派蒙",
                    "text": "咦？这里真有个盒子，我们拿回去给他看看吧。"
                }
            ]
        }
    ]
}