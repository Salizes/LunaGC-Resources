    "talks": [
        {
            "id": "7351702",
            "objective": "等待至次日（8-12点）",
            "dialogues": []
        },
        {
            "id": "7351701",
            "objective": "与两位学者对话",
            "dialogues": [
                {
                    "id": "735170101",
                    "speaker": "维纳亚克",
                    "text": "…所以就结论来说，还是要靠「对沙虫用杀虫炮」来消灭它们对吧？"
                },
                {
                    "id": "735170102",
                    "speaker": "施芮娅",
                    "text": "这根本就不能同日而语！不要摆出那副「早听我的不就得了」的表情！",
                    "choices": [
                        {
                            "id": "735170103",
                            "text": "你们怎么又开始了？",
                            "response": [
                                {
                                    "id": "735170105",
                                    "speaker": "施芮娅",
                                    "text": "#啊，冒险家{M#先生}{F#小姐}！您听我说，我已经找出这起事件的原因了！"
                                },
                                {
                                    "id": "735170106",
                                    "speaker": "施芮娅",
                                    "text": "——是沙虫在地下的活动频繁，导致了这片区域内元素能量的紊乱。"
                                },
                                {
                                    "id": "735170107",
                                    "speaker": "施芮娅",
                                    "text": "而庞杂的能量又反过来影响了沙虫的习性，使得它们开始在地表上四处作乱，进一步加剧了环境的失衡。"
                                },
                                {
                                    "id": "735170108",
                                    "speaker": "施芮娅",
                                    "text": "「对沙虫用杀虫炮」充能装置的效率异常，也是环境中元素能量紊乱导致的。"
                                },
                                {
                                    "id": "735170109",
                                    "speaker": "维纳亚克",
                                    "text": "我就知道，我设计的机械，绝对不会这么轻易就出故障！"
                                },
                                {
                                    "id": "735170110",
                                    "speaker": "派蒙",
                                    "text": "没考虑到使用环境的问题，难道就不算设计问题吗…",
                                    "choices": [
                                        {
                                            "id": "735170111",
                                            "text": "既然原因是沙虫过度活跃…",
                                            "response": [
                                                {
                                                    "id": "735170113",
                                                    "speaker": "维纳亚克",
                                                    "text": "所以，我们绕了那么多圈子，最后还是得出了一开始的结论？"
                                                },
                                                {
                                                    "id": "735170114",
                                                    "speaker": "施芮娅",
                                                    "text": "知道要做什么和知道为什么要做可是两码事，身为一名学者，你不会连这都不懂吧？而且我的推论可还没结束呢。"
                                                },
                                                {
                                                    "id": "735170115",
                                                    "speaker": "施芮娅",
                                                    "text": "正常来说，大自然会自行限制种群的生态及行为，来维持周遭环境的稳定。"
                                                },
                                                {
                                                    "id": "735170116",
                                                    "speaker": "施芮娅",
                                                    "text": "但这次紊乱的元素能量打破了这种平衡机制，也使得沙虫们异常活跃…"
                                                },
                                                {
                                                    "id": "735170117",
                                                    "speaker": "施芮娅",
                                                    "text": "只要想办法让元素环境回归到正常状态，就可以减弱沙虫的活动。一段时间以后，这种平衡也就能自行恢复了吧。"
                                                },
                                                {
                                                    "id": "735170118",
                                                    "speaker": "派蒙",
                                                    "text": "调理元素能量？这要怎么做啊？"
                                                },
                                                {
                                                    "id": "735170119",
                                                    "speaker": "施芮娅",
                                                    "text": "唔，只要推算出元素能量淤积最严重的「节点」，在那里用一些可以引导能量流动的装置…"
                                                },
                                                {
                                                    "id": "735170120",
                                                    "speaker": "施芮娅",
                                                    "text": "…把淤塞的能量给激发出来，剩下的就可以交给大自然去自我调节了。"
                                                },
                                                {
                                                    "id": "735170121",
                                                    "speaker": "施芮娅",
                                                    "text": "「节点」的位置我已经计算出来了，就在这附近。可以引导能量流动的装置，我们也已经有了…"
                                                },
                                                {
                                                    "id": "735170122",
                                                    "speaker": "Player",
                                                    "text": "难道是…「对沙虫用杀虫炮」？"
                                                },
                                                {
                                                    "id": "735170123",
                                                    "speaker": "施芮娅",
                                                    "text": "没错，「对沙虫用杀虫炮」可以抽调周遭的元素能量，然后一口气迸发。"
                                                },
                                                {
                                                    "id": "735170124",
                                                    "speaker": "施芮娅",
                                                    "text": "接下来我们只要在那里架设「对沙虫用杀虫炮」，像昨天一样进行一遍流程就行。"
                                                },
                                                {
                                                    "id": "735170125",
                                                    "speaker": "施芮娅",
                                                    "text": "这期间可能也会有魔物和沙虫被吸引来…嗯，适当削减一下它们的数量，也能加快自然调节的进程吧。"
                                                },
                                                {
                                                    "id": "735170126",
                                                    "speaker": "维纳亚克",
                                                    "text": "——所以就结论来说，还是要靠「对沙虫用杀虫炮」给它们来一发对吧？"
                                                },
                                                {
                                                    "id": "735170127",
                                                    "speaker": "施芮娅",
                                                    "text": "你…！不要摆出那副「早听我的不就得了」的表情！！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735170112",
                                            "text": "解决方案就还是多打沙虫？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735170104",
                            "text": "这次是为什么吵起来？"
                        }
                    ]
                }
            ]
        }
    ]
}