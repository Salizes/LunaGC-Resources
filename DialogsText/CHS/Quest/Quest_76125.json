    "talks": [
        {
            "id": "7612501",
            "objective": "（隐藏）踩圈触发任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7612502",
            "objective": "前往银月之庭",
            "dialogues": [
                {
                    "id": "761250201",
                    "speaker": "Player",
                    "text": "（哥伦比娅，果然不在这里…）"
                },
                {
                    "id": "761250202",
                    "speaker": "派蒙",
                    "text": "难道哥伦比娅真的…"
                },
                {
                    "id": "761250203",
                    "speaker": "Player",
                    "text": "（她踏入了「月之门」，没人知道门内有什么，但那是个将极为强大的猎月人都彻底撕碎了的地方…）"
                },
                {
                    "id": "761250204",
                    "speaker": "Player",
                    "text": "（如果我当时…）"
                },
                {
                    "id": "761250205",
                    "speaker": "派蒙",
                    "text": "哥伦比娅？"
                },
                {
                    "id": "761250206",
                    "speaker": "月灵",
                    "text": "……"
                },
                {
                    "id": "761250207",
                    "speaker": "月灵",
                    "text": "…？"
                },
                {
                    "id": "761250208",
                    "speaker": "派蒙",
                    "text": "是你们啊…"
                },
                {
                    "id": "761250209",
                    "speaker": "月灵",
                    "text": "~"
                },
                {
                    "id": "761250210",
                    "speaker": "派蒙",
                    "text": "你们…也在等哥伦比娅回来吗？"
                },
                {
                    "id": "761250211",
                    "speaker": "努昂诺塔",
                    "text": "……"
                },
                {
                    "id": "761250212",
                    "speaker": "派蒙",
                    "text": "就连你也…"
                },
                {
                    "id": "761250213",
                    "speaker": "努昂诺塔",
                    "text": "……"
                },
                {
                    "id": "761250214",
                    "speaker": "派蒙",
                    "text": "呜…不要那么难过嘛，打起精神来…"
                },
                {
                    "id": "761250215",
                    "speaker": "派蒙",
                    "text": "大家一起难过的话，不就像是…不就像是…"
                },
                {
                    "id": "761250216",
                    "speaker": "派蒙",
                    "text": "我才不要这么想呢…"
                },
                {
                    "id": "761250217",
                    "speaker": "Player",
                    "text": "（……）"
                },
                {
                    "id": "761250218",
                    "speaker": "Player",
                    "text": "（…我不能沉溺在自责之中。）"
                },
                {
                    "id": "761250219",
                    "speaker": "Player",
                    "text": "（哥伦比娅不是为了看到这样的局面才做出的牺牲，更何况…）"
                },
                {
                    "id": "761250220",
                    "speaker": "Player",
                    "text": "我…还没有放弃。"
                },
                {
                    "id": "761250221",
                    "speaker": "Player",
                    "text": "哥伦比娅，她的每一位朋友，都不会就此放弃…"
                },
                {
                    "id": "761250222",
                    "speaker": "Player",
                    "text": "再给我们一点时间。我没法向各位许诺什么，但我一定会尽力…"
                },
                {
                    "id": "761250223",
                    "speaker": "月灵",
                    "text": "……"
                },
                {
                    "id": "761250224",
                    "speaker": "努昂诺塔",
                    "text": "~！"
                },
                {
                    "id": "761250225",
                    "speaker": "派蒙",
                    "text": "它们，这是在…鼓励我们？"
                },
                {
                    "id": "761250226",
                    "speaker": "Player",
                    "text": "嗯…"
                },
                {
                    "id": "761250227",
                    "speaker": "派蒙",
                    "text": "谢谢你们…"
                },
                {
                    "id": "761250228",
                    "speaker": "派蒙",
                    "text": "想要陪你们做点什么吗？"
                },
                {
                    "id": "761250229",
                    "speaker": "月灵",
                    "text": "……"
                },
                {
                    "id": "761250230",
                    "speaker": "月灵",
                    "text": "~！"
                },
                {
                    "id": "761250231",
                    "speaker": "派蒙",
                    "text": "这只月灵…似乎是喜欢弹琴的那只。"
                },
                {
                    "id": "761250232",
                    "speaker": "派蒙",
                    "text": "这只月灵…有点心神不宁的样子呢…"
                },
                {
                    "id": "761250233",
                    "speaker": "派蒙",
                    "text": "要不你弹点什么吧？听到熟悉的旋律，说不定就可以稍稍安下心来…"
                },
                {
                    "id": "761250234",
                    "speaker": "Player",
                    "text": "熟悉的旋律…"
                },
                {
                    "id": "761250235",
                    "speaker": "Player",
                    "text": "演奏哥伦比娅常哼的歌…"
                },
                {
                    "id": "761250236",
                    "speaker": "派蒙",
                    "text": "…它们睡着了。"
                },
                {
                    "id": "761250237",
                    "speaker": "派蒙",
                    "text": "看起来小家伙们很久都没有好好休息过了…"
                },
                {
                    "id": "761250238",
                    "speaker": "派蒙",
                    "text": "我们悄悄离开这里吧。"
                },
                {
                    "id": "761250239",
                    "speaker": "「木偶」",
                    "text": "……"
                },
                {
                    "id": "761250240",
                    "speaker": "派蒙",
                    "text": "桑多涅！你怎么会在这里？"
                },
                {
                    "id": "761250241",
                    "speaker": "「木偶」",
                    "text": "随便出门散散心不行吗？"
                },
                {
                    "id": "761250242",
                    "speaker": "Player",
                    "text": "她没有回来。"
                },
                {
                    "id": "761250243",
                    "speaker": "「木偶」",
                    "text": "我想也是。"
                },
                {
                    "id": "761250244",
                    "speaker": "「木偶」",
                    "text": "奇迹怎么可能没有代价呢。"
                },
                {
                    "id": "761250245",
                    "speaker": "派蒙",
                    "text": "你要往哪个方向走？我是说…好不容易遇见了，要不要再一起走一段？"
                },
                {
                    "id": "761250246",
                    "speaker": "「木偶」",
                    "text": "算了吧，今天心情不好，说出来的话不会好听。"
                },
                {
                    "id": "761250247",
                    "speaker": "「木偶」",
                    "text": "而且我看，这里最不需要的就是安慰。"
                }
            ]
        },
        {
            "id": "7612504",
            "objective": "（隐藏）辅助传送判定$HIDDEN",
            "dialogues": []
        }
    ]
