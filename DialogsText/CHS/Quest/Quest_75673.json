    "talks": [
        {
            "id": "7567301",
            "objective": "与班尼特对话",
            "dialogues": [
                {
                    "id": "756730101",
                    "speaker": "班尼特",
                    "text": "看来，调色家阿夏已经心满意足了…"
                },
                {
                    "id": "756730102",
                    "speaker": "班尼特",
                    "text": "我们成功帮助神奇的阿夏，完成了又一个特别的挑战！"
                },
                {
                    "id": "756730103",
                    "speaker": "派蒙",
                    "text": "好耶，收集颜料大成功~"
                },
                {
                    "id": "756730104",
                    "speaker": "派蒙",
                    "text": "这只阿夏是马上就来灵感了嘛，等不及要去作画？",
                    "choices": [
                        {
                            "id": "756730105",
                            "text": "「噼咔」的那一会儿转瞬即逝…",
                            "response": [
                                {
                                    "id": "756730107",
                                    "speaker": "班尼特",
                                    "text": "#啊，它还留下了不少自己收集的财宝呢…都给{NICKNAME}和派蒙当辛苦费才对！"
                                },
                                {
                                    "id": "756730108",
                                    "speaker": "班尼特",
                                    "text": "说不定，过段时间我们再来，就能看见调色家阿夏的新杰作了。"
                                },
                                {
                                    "id": "756730109",
                                    "speaker": "派蒙",
                                    "text": "普通的阿夏就能喷出很好看的色彩了，这种特别的阿夏，会有多厉害呢。"
                                },
                                {
                                    "id": "756730110",
                                    "speaker": "派蒙",
                                    "text": "哎呀，感觉已经开始期待了，说不定真能被它们调出什么…一般语言形容不出来的…"
                                },
                                {
                                    "id": "756730111",
                                    "speaker": "派蒙",
                                    "text": "燃素啊，月亮啊，星空深处的颜色？"
                                },
                                {
                                    "id": "756730112",
                                    "speaker": "班尼特",
                                    "text": "对嘛，在冒险过程中，只要遇见了遭遇困难的生灵，就尽可能给对方最真诚的帮助…"
                                },
                                {
                                    "id": "756730113",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯！说不定哪天，还能得到意想不到的回报呢！",
                                    "choices": [
                                        {
                                            "id": "756730114",
                                            "text": "我也赞成班尼特。",
                                            "response": [
                                                {
                                                    "id": "756730116",
                                                    "speaker": "班尼特",
                                                    "text": "啊，不过…如果只为了回报而去帮助，有点本末倒置了。"
                                                },
                                                {
                                                    "id": "756730117",
                                                    "speaker": "班尼特",
                                                    "text": "就算没有任何酬劳，看见问题被解决，原本面露难色的朋友们开心起来，一切事情都在向着好的方向发展…"
                                                },
                                                {
                                                    "id": "756730118",
                                                    "speaker": "班尼特",
                                                    "text": "我喜欢这种感觉！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756730115",
                                            "text": "这样感觉很充实。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756730106",
                            "text": "谁也不想放过灵感最好的时候吧。"
                        }
                    ]
                }
            ]
        }
    ]
}