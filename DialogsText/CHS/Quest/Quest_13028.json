    "talks": [
        {
            "id": "1302801",
            "objective": "向仍在等待的蕈兽转达情况",
            "dialogues": [
                {
                    "id": "130280113",
                    "speaker": "纳西妲",
                    "text": "它们已经在这里很长时间了…"
                },
                {
                    "id": "130280101",
                    "speaker": "纳西妲",
                    "text": "为了它们有机会能重逢，我很想再做点什么…"
                },
                {
                    "id": "130280102",
                    "speaker": "派蒙",
                    "text": "除了这两只蕈兽，我也有点担心浮游风蕈兽的营地。"
                },
                {
                    "id": "130280103",
                    "speaker": "纳西妲",
                    "text": "嗯，我也有同感…"
                },
                {
                    "id": "130280104",
                    "speaker": "纳西妲",
                    "text": "我有个想法，要不要把它们送去，让它们在一起生活呢？"
                },
                {
                    "id": "130280105",
                    "speaker": "纳西妲",
                    "text": "既然平日里都有元素生物在引导，它们的生活习惯应该也比较接近。"
                },
                {
                    "id": "130280106",
                    "speaker": "派蒙",
                    "text": "对哦，互相也能有个照应！"
                },
                {
                    "id": "130280107",
                    "speaker": "纳西妲",
                    "text": "那你们愿意跟我们走吗？"
                },
                {
                    "id": "130280108",
                    "speaker": "浮游水蕈兽",
                    "text": "……？"
                },
                {
                    "id": "130280109",
                    "speaker": "浮游水蕈兽",
                    "text": "♪~"
                },
                {
                    "id": "130280110",
                    "speaker": "浮游水蕈兽",
                    "text": "……"
                },
                {
                    "id": "130280111",
                    "speaker": "派蒙",
                    "text": "看来是被说服了呢。"
                },
                {
                    "id": "130280112",
                    "speaker": "纳西妲",
                    "text": "那我们走吧。"
                }
            ]
        },
        {
            "id": "1302802",
            "objective": "带领蕈兽前往新家",
            "dialogues": [
                {
                    "id": "130280201",
                    "speaker": "Black Screen",
                    "text": "来到营地之后，两只蕈兽很顺利地被接纳了。"
                },
                {
                    "id": "130280202",
                    "speaker": "派蒙",
                    "text": "这里的蕈兽好像记得我们，对我们特别温和。"
                },
                {
                    "id": "130280203",
                    "speaker": "纳西妲",
                    "text": "看来那个元素生命在这里的地位真的很高。"
                },
                {
                    "id": "130280204",
                    "speaker": "派蒙",
                    "text": "欸，你们干嘛，是想和我玩吗？"
                },
                {
                    "id": "130280205",
                    "speaker": "浮游风蕈兽",
                    "text": "♩~♩~"
                },
                {
                    "id": "130280206",
                    "speaker": "派蒙",
                    "text": "#好啦好啦，那，{NICKNAME}，我去和它们玩一会儿？",
                    "choices": [
                        {
                            "id": "130280207",
                            "text": "去吧去吧。",
                            "response": [
                                {
                                    "id": "130280209",
                                    "speaker": "纳西妲",
                                    "text": "有件事我想和你道歉，就是在阿佩普的体内，「火种」破碎的时候…我想要消耗我的力量。"
                                },
                                {
                                    "id": "130280210",
                                    "speaker": "纳西妲",
                                    "text": "派蒙和你说了吗？",
                                    "choices": [
                                        {
                                            "id": "130280211",
                                            "text": "嗯，我觉得很担心。",
                                            "response": [
                                                {
                                                    "id": "130280213",
                                                    "speaker": "纳西妲",
                                                    "text": "我还是不够冷静，那时候我应该再多想一想，做出更加周全的判断。"
                                                },
                                                {
                                                    "id": "130280214",
                                                    "speaker": "纳西妲",
                                                    "text": "但我只要想到草龙危在旦夕，整个须弥的人都处于威胁之中，我就觉得焦急和害怕。"
                                                },
                                                {
                                                    "id": "130280215",
                                                    "speaker": "纳西妲",
                                                    "text": "如果有能做的事最后却决定不做，如果还没有用尽力气就耗光了时间…"
                                                },
                                                {
                                                    "id": "130280216",
                                                    "speaker": "纳西妲",
                                                    "text": "使用力量是最简单的，但其实也是最困难的。"
                                                },
                                                {
                                                    "id": "130280217",
                                                    "speaker": "Player",
                                                    "text": "还需要不断「成长」。"
                                                },
                                                {
                                                    "id": "130280218",
                                                    "speaker": "纳西妲",
                                                    "text": "嗯，我觉得它们教会了我很多。"
                                                },
                                                {
                                                    "id": "130280219",
                                                    "speaker": "纳西妲",
                                                    "text": "在听到「得偿所愿」这几个字的时候，我可以理解，但迟迟无法接受。"
                                                },
                                                {
                                                    "id": "130280220",
                                                    "speaker": "纳西妲",
                                                    "text": "我不知道为什么它的声音听起来那么轻快，明明是这么让人想哭的一件事…"
                                                },
                                                {
                                                    "id": "130280221",
                                                    "speaker": "纳西妲",
                                                    "text": "我又一次，没办法「共情」了。",
                                                    "choices": [
                                                        {
                                                            "id": "130280222",
                                                            "text": "这不是你的问题。",
                                                            "response": [
                                                                {
                                                                    "id": "130280224",
                                                                    "speaker": "纳西妲",
                                                                    "text": "谢谢你能安慰我…"
                                                                },
                                                                {
                                                                    "id": "130280225",
                                                                    "speaker": "纳西妲",
                                                                    "text": "感情真的很复杂，看来我还要继续学习才行。"
                                                                },
                                                                {
                                                                    "id": "130280226",
                                                                    "speaker": "纳西妲",
                                                                    "text": "欸？"
                                                                },
                                                                {
                                                                    "id": "130280227",
                                                                    "speaker": "浮游水蕈兽",
                                                                    "text": "♪~"
                                                                },
                                                                {
                                                                    "id": "130280228",
                                                                    "speaker": "浮游水蕈兽",
                                                                    "text": "♪~♪~"
                                                                },
                                                                {
                                                                    "id": "130280229",
                                                                    "speaker": "纳西妲",
                                                                    "text": "它们居然知道应该怎么照料农田…可能只是在有样学样吧。"
                                                                },
                                                                {
                                                                    "id": "130280230",
                                                                    "speaker": "纳西妲",
                                                                    "text": "但既然那只蕈兽都能开口说话，说不定这都是元素力长期以来的影响。"
                                                                },
                                                                {
                                                                    "id": "130280231",
                                                                    "speaker": "Player",
                                                                    "text": "时间是有力量的。"
                                                                },
                                                                {
                                                                    "id": "130280232",
                                                                    "speaker": "纳西妲",
                                                                    "text": "没错，这下子两只元素生命的担忧都消失了。"
                                                                },
                                                                {
                                                                    "id": "130280233",
                                                                    "speaker": "纳西妲",
                                                                    "text": "之后这个营地就交给我来照看吧，我会时不时过来看看这里的情况。"
                                                                },
                                                                {
                                                                    "id": "130280234",
                                                                    "speaker": "纳西妲",
                                                                    "text": "我希望保存它们留下的痕迹，为了它们在未来的邂逅创造可能性。"
                                                                },
                                                                {
                                                                    "id": "130280235",
                                                                    "speaker": "纳西妲",
                                                                    "text": "毕竟，最后它想起了「努尔」这个名字啊，它的记忆回来了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "130280236",
                                                                            "text": "我相信亲情。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "130280238",
                                                                                    "speaker": "纳西妲",
                                                                                    "text": "嗯，权当是一个美好的期愿吧。"
                                                                                },
                                                                                {
                                                                                    "id": "130280239",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "纳西妲，蕈兽它们又拿水果过来了，一起来吃吧！"
                                                                                },
                                                                                {
                                                                                    "id": "130280240",
                                                                                    "speaker": "纳西妲",
                                                                                    "text": "好的，我这就来！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "130280237",
                                                                            "text": "我相信奇迹。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "130280223",
                                                            "text": "我和你的情绪相同。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130280212",
                                            "text": "嗯，我觉得很生气。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130280208",
                            "text": "玩得开心。"
                        }
                    ]
                }
            ]
        }
    ]
}