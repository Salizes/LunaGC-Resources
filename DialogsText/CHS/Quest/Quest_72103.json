    "talks": [
        {
            "id": "7210325",
            "objective": "（test）神官神社创生$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7210335",
            "objective": "（test）判定小黑屋完成$HIDDEN",
            "dialogues": [
                {
                    "id": "721033501",
                    "speaker": "玄冬林檎",
                    "text": "你要求签？"
                },
                {
                    "id": "721033502",
                    "speaker": "派蒙",
                    "text": "呜哇，好冷淡。"
                },
                {
                    "id": "721033503",
                    "speaker": "Player",
                    "text": "我想求签…"
                },
                {
                    "id": "721033504",
                    "speaker": "玄冬林檎",
                    "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。"
                },
                {
                    "id": "721033505",
                    "speaker": "Player",
                    "text": "记得是叫「御神签箱」…"
                },
                {
                    "id": "721033506",
                    "speaker": "玄冬林檎",
                    "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。"
                },
                {
                    "id": "721033507",
                    "speaker": "Player",
                    "text": "好像叫「御神签」来着…"
                },
                {
                    "id": "721033508",
                    "speaker": "玄冬林檎",
                    "text": "这种事情怎样都好吧。"
                },
                {
                    "id": "721033509",
                    "speaker": "派蒙",
                    "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？"
                },
                {
                    "id": "721033510",
                    "speaker": "玄冬林檎",
                    "text": "是命运让你抽到凶签，你还想怎样？啊？"
                },
                {
                    "id": "721033511",
                    "speaker": "派蒙",
                    "text": "欸！"
                },
                {
                    "id": "721033512",
                    "speaker": "Player",
                    "text": "外头那个像架子的东西…"
                },
                {
                    "id": "721033513",
                    "speaker": "玄冬林檎",
                    "text": "啧。"
                },
                {
                    "id": "721033514",
                    "speaker": "派蒙",
                    "text": "她很露骨地「啧」了耶！"
                },
                {
                    "id": "721033515",
                    "speaker": "玄冬林檎",
                    "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。"
                },
                {
                    "id": "721033516",
                    "speaker": "玄冬林檎",
                    "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。"
                },
                {
                    "id": "721033517",
                    "speaker": "玄冬林檎",
                    "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。"
                },
                {
                    "id": "721033518",
                    "speaker": "派蒙",
                    "text": "虽然感觉哪里好像怪怪的…"
                },
                {
                    "id": "721033519",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们求签吧！"
                }
            ]
        },
        {
            "id": "7210336",
            "objective": "(test)首次遇到假扮巫女$HIDDEN",
            "dialogues": [
                {
                    "id": "721033601",
                    "speaker": "玄冬林檎",
                    "text": "把竹签交出来。"
                },
                {
                    "id": "721033602",
                    "speaker": "Player",
                    "text": "好、好的。"
                },
                {
                    "id": "721033603",
                    "speaker": "派蒙",
                    "text": "神社真是个不讲情面的地方…"
                },
                {
                    "id": "721033604",
                    "speaker": "玄冬林檎",
                    "text": "给你。"
                },
                {
                    "id": "721033605",
                    "speaker": "派蒙",
                    "text": "唔呣，看看运势吧。"
                },
                {
                    "id": "721033606",
                    "speaker": "玄冬林檎",
                    "text": "对了。每天只能求一次签，这点请你记住。"
                },
                {
                    "id": "721033607",
                    "speaker": "玄冬林檎",
                    "text": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？"
                },
                {
                    "id": "721033608",
                    "speaker": "玄冬林檎",
                    "text": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」"
                },
                {
                    "id": "721033609",
                    "speaker": "玄冬林檎",
                    "text": "你看，写得真好。所以每天只能求一次签，记好了。"
                }
            ]
        },
        {
            "id": "7210315",
            "objective": "(test)假扮巫女首次对话$HIDDEN",
            "dialogues": [
                {
                    "id": "721031901",
                    "speaker": "派蒙",
                    "text": "#（喂，{NICKNAME}！）"
                },
                {
                    "id": "721031902",
                    "speaker": "派蒙",
                    "text": "（这个玄冬小姐，按照那个玄冬小姐说的…）"
                },
                {
                    "id": "721031903",
                    "speaker": "Player",
                    "text": "（嗯，愚人众的冒牌货。）"
                },
                {
                    "id": "721031904",
                    "speaker": "「玄冬林檎」",
                    "text": "啊呀，又见面了。今天也要来看看运势吗？还是说…"
                },
                {
                    "id": "721031905",
                    "speaker": "「玄冬林檎」",
                    "text": "如果有什么想倾诉、想找人商量的事，我也能听您讲喔。",
                    "choices": [
                        {
                            "id": "721031906",
                            "text": "只是路过而已。",
                            "response": [
                                {
                                    "id": "721031908",
                                    "speaker": "派蒙",
                                    "text": "玄冬小姐好亲切喔！"
                                },
                                {
                                    "id": "721031909",
                                    "speaker": "「玄冬林檎」",
                                    "text": "是这样吗？呵呵，最近经常有人这么夸我呢。感觉好开心。"
                                },
                                {
                                    "id": "721031910",
                                    "speaker": "「玄冬林檎」",
                                    "text": "在这样漂亮的神社工作，一直是我的梦想。"
                                },
                                {
                                    "id": "721031911",
                                    "speaker": "Player",
                                    "text": "（她就是愚人众派来的冒牌货。）"
                                },
                                {
                                    "id": "721031912",
                                    "speaker": "派蒙",
                                    "text": "（唔…不过这个玄冬小姐，好像真的很喜欢这里的工作。）",
                                    "choices": [
                                        {
                                            "id": "721031913",
                                            "text": "（不能掉以轻心。）",
                                            "response": [
                                                {
                                                    "id": "721031915",
                                                    "speaker": "「玄冬林檎」",
                                                    "text": "#那么，{NICKNAME}，今天找我有什么事吗？",
                                                    "choices": [
                                                        {
                                                            "id": "721031916",
                                                            "text": "我只是来看你的。",
                                                            "response": [
                                                                {
                                                                    "id": "721031917",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "我…欸？啊，欸？不、不好意思，我不太明白您、您您的意思…"
                                                                },
                                                                {
                                                                    "id": "721031918",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "请、请让我冷静一下…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721031919",
                                                            "text": "没什么事。",
                                                            "response": [
                                                                {
                                                                    "id": "721031920",
                                                                    "speaker": "「玄冬林檎」",
                                                                    "text": "我明白了。有什么问题随时来找我喔。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721031914",
                                            "text": "（等玄冬小姐联络吧。）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721031907",
                            "text": "谢谢，不用了。"
                        }
                    ]
                }
            ]
        },
