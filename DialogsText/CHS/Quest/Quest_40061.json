{
    "quest": {
        "id": "40061",
        "title": "御先祖大人的委托",
        "description": "你很关心海祇御灵祭的进展，于是决定再去一趟珊瑚宫…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
