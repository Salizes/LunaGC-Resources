        }
    },
    "talks": [
        {
            "id": "4006101",
            "objective": "前往珊瑚宫，与露子对话",
            "dialogues": [
                {
                    "id": "400610101",
                    "speaker": "露子",
                    "text": "今天海祇岛刮起了南来风，我就料想会有好友来拜访。"
                },
                {
                    "id": "400610102",
                    "speaker": "派蒙",
                    "text": "#每次你这么一说话，我和{NICKNAME}就要奔波大半天。"
                },
                {
                    "id": "400610103",
                    "speaker": "露子",
                    "text": "不要这么说嘛。我们不是，好搭档吗？最好的那种。"
                },
                {
                    "id": "400610104",
                    "speaker": "露子",
                    "text": "不过今天，我确实有件事想要拜托你们。"
                },
                {
                    "id": "400610105",
                    "speaker": "露子",
                    "text": "相传，我家先祖在珊瑚宫海祇御灵祭之事外，还追加了另一套试炼。和海祇岛存亡无关，和真相有关。"
                },
                {
                    "id": "400610106",
                    "speaker": "派蒙",
                    "text": "另一套…试炼？"
                },
                {
                    "id": "400610107",
                    "speaker": "露子",
                    "text": "现在海祇岛的存亡危机既然已经解除了，那我就出于祖传的义务与责任提醒你们一下吧。"
                },
                {
                    "id": "400610108",
                    "speaker": "露子",
                    "text": "你们可以去那个所谓的「蛇心之地」的某处，寻找第二试炼的线索。"
                },
                {
                    "id": "400610109",
                    "speaker": "露子",
                    "text": "哎呀，解脱了，轻松了。这份沉重的责任可以传给我未来的女儿了。"
                },
                {
                    "id": "400610110",
                    "speaker": "派蒙",
                    "text": "祖传的任务就是说这么简单的一句话吗！？"
                },
                {
                    "id": "400610111",
                    "speaker": "派蒙",
                    "text": "…我至今还是有点跟不上露子的思维…"
                }
            ]
        },
        {
            "id": "4006102",
            "objective": "在「常夜」状态下调查蛇心之地",
            "dialogues": []
        },
        {
            "id": "4006103",
            "objective": "在「常夜」状态下调查蛇心之地",
            "dialogues": [
                {
                    "id": "722750101",
                    "speaker": "乌帽子",
                    "text": "此身既然已经显现，那血枝珊瑚应该已入海祇之手。让人欣慰。"
                },
                {
                    "id": "722750102",
                    "speaker": "乌帽子",
                    "text": "我名厄伯斯，稻妻式名字是乌帽子。乃是珊瑚宫之辅弼，渊下宫巫女中的一位。"
                },
                {
                    "id": "722750103",
                    "speaker": "乌帽子",
                    "text": "您应该就是取得珊瑚枝的勇者吧？"
                },
                {
                    "id": "722750104",
                    "speaker": "Player",
                    "text": "是我没错。"
                },
                {
                    "id": "722750105",
                    "speaker": "乌帽子",
                    "text": "实在抱歉，我要讲述之事可能过于复杂，不知应该如何说起。"
                },
                {
                    "id": "722750106",
                    "speaker": "派蒙",
                    "text": "你可以从头开始说，我们会听的。"
                },
                {
                    "id": "722750107",
                    "speaker": "乌帽子",
                    "text": "非常感谢。那么，就请容我为您稍事介绍吧。这要从海祇大御神打通海渊之门说起。"
                },
                {
                    "id": "722750108",
                    "speaker": "乌帽子",
                    "text": "渊下宫的深处有一处天然溶洞，便是通往海祇岛之路。也是海祇所许诺的地上乐土。"
                },
                {
                    "id": "722750109",
                    "speaker": "乌帽子",
                    "text": "我们在大御神的授意下，学习了鸣神文化，并且曾与诸方土地建立了外交。"
                },
                {
                    "id": "722750110",
                    "speaker": "乌帽子",
                    "text": "鸣神岛还称赞我们的「海祇美人」呢。因为我们海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼。"
                },
                {
                    "id": "722750111",
                    "speaker": "乌帽子",
                    "text": "这种说法的来由呢，是因为我们和祖先都在渊下宫生活得不到日照…",
                    "choices": [
                        {
                            "id": "722750112",
                            "text": "说重点。",
                            "response": [
                                {
                                    "id": "722750114",
                                    "speaker": "乌帽子",
                                    "text": "啊，抱歉。以前日子与诸国外交，我作为珊瑚宫之辅弼，经常担任向导。一不小心就…"
                                },
                                {
                                    "id": "722750115",
                                    "speaker": "乌帽子",
                                    "text": "话说回来吧。我与珊瑚宫大人产生了分歧，在海祇大御神的调停之下，我们有了现在的这个方案。"
                                },
                                {
                                    "id": "722750116",
                                    "speaker": "乌帽子",
                                    "text": "因为渊下宫有「罪影」这种现象，「过去」、「历史」、「真相」这种东西，放着不管也会永世长存。"
                                },
                                {
                                    "id": "722750117",
                                    "speaker": "乌帽子",
                                    "text": "所以我们费心尽力，并不是为了铭记，而是为了「遗忘」。很明显，珊瑚宫大人就是这么想的。"
                                },
                                {
                                    "id": "722750118",
                                    "speaker": "派蒙",
                                    "text": "（她说的珊瑚宫，应该是很久以前的珊瑚宫巫女吧…）"
                                },
                                {
                                    "id": "722750119",
                                    "speaker": "乌帽子",
                                    "text": "取珊瑚枝的试炼，就是尽可能少地让后人接触事件全貌的设计。"
                                },
                                {
                                    "id": "722750120",
                                    "speaker": "乌帽子",
                                    "text": "而我则支持留下真相。因此海祇大御神许可我在此追加一道试炼，通过的话，就可以知晓秘密。"
                                },
                                {
                                    "id": "722750121",
                                    "speaker": "乌帽子",
                                    "text": "请您接受这个挑战吧。",
                                    "choices": [
                                        {
                                            "id": "722750122",
                                            "text": "我接受挑战。",
                                            "response": [
                                                {
                                                    "id": "722750124",
                                                    "speaker": "乌帽子",
                                                    "text": "如此甚好，那么我来为你启动追加的试炼。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722750123",
                                            "text": "我对秘密很感兴趣。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722750113",
                            "text": "怎么又是这话。说重点。"
                        }
                    ]
                }
            ]
        }
    ]
}