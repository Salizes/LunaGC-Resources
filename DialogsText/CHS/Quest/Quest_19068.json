            "dialogues": [
                {
                    "id": "190680501",
                    "speaker": "诺艾尔",
                    "text": "呼…一想到书上写的这些…心跳都变得好快…"
                },
                {
                    "id": "190680502",
                    "speaker": "诺艾尔",
                    "text": "我是不是该去做点别的事情…分散一下注意力呢…"
                },
                {
                    "id": "190680503",
                    "speaker": "诺艾尔",
                    "text": "唔…还是先把这本看完吧。就把这本看完…应该没事的吧？"
                }
            ]
        },
