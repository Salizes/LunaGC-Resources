        {
            "id": "1906804",
            "objective": "将一份「蒙德烤鱼」交给贝雅",
            "dialogues": [
                {
                    "id": "190680301",
                    "speaker": "贝雅特丽奇",
                    "text": "欸…送「蒙德烤鱼」吗？"
                },
                {
                    "id": "190680302",
                    "speaker": "贝雅特丽奇",
                    "text": "我以前也经常说要给他送午饭，不知道能不能行得通啊…"
                },
                {
                    "id": "190680303",
                    "speaker": "贝雅特丽奇",
                    "text": "算了，既然是诺艾尔的推荐，我就去试试吧！"
