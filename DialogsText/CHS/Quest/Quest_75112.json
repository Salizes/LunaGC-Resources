            "objective": "test游猎龙NPC挑战3$HIDDEN",
            "dialogues": [
                {
                    "id": "751120901",
                    "speaker": "阿乌伊娅",
                    "text": "我，很喜欢在「游隙灵道」上滑行的感觉。耳畔的风，往后，感觉很舒服。"
                },
                {
                    "id": "751120904",
                    "speaker": "阿乌伊娅",
                    "text": "成为「训练大师」，也是为了在训练部族里战士的同时，让他们了解在「游隙灵道」上滑行的快乐。"
                },
                {
                    "id": "751120905",
                    "speaker": "阿乌伊娅",
                    "text": "怎么样，你，要不要也来试试。",
                    "choices": [
                        {
                            "id": "751120902",
                            "text": "现在开始吧！"
                        },
                        {
                            "id": "751120903",
                            "text": "让我稍作准备…"
