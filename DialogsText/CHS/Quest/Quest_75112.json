            "objective": "test钻地龙3回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "751121201",
                    "speaker": "希乌休",
                    "text": "嗯…一路上收集挑战币，然后…如果能追上小嵴锋龙就更好了。"
                },
                {
                    "id": "751121202",
                    "speaker": "希乌休",
                    "text": "因为小嵴锋龙很可爱，我想，这样能有趣一些…"
                }
            ]
        },
        {
            "id": "7511213",
            "objective": "test勾爪龙1回滚$HIDDEN",
            "dialogues": [
                {
                    "id": "751121301",
