        {
            "id": "7511203",
            "objective": "test钻地龙NPC挑战3$HIDDEN",
            "dialogues": [
                {
                    "id": "751120301",
                    "speaker": "希乌休",
                    "text": "唔…异邦的勇士，我有一事相求。"
                },
                {
                    "id": "751120304",
                    "speaker": "希乌休",
                    "text": "我是部族里的「训练大师」，只不过，我的能力与这个头衔还并不相称，吃不准所安排的「勇士挑战」的难度…"
                },
                {
                    "id": "751120305",
                    "speaker": "希乌休",
                    "text": "所以，能请您帮忙试试看吗？",
                    "choices": [
                        {
                            "id": "751120302",
                            "text": "现在开始吧！"
                        },
                        {
                            "id": "751120303",
                            "text": "让我稍作准备…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7511204",
            "objective": "test勾爪龙NPC挑战1$HIDDEN",
            "dialogues": [
                {
                    "id": "751120401",
                    "speaker": "莉莉尤",
                    "text": "身为「悬木人」的人，轻捷而灵巧的移动是必须的素质，这也是我准备「勇士挑战」的原因。"
                },
                {
                    "id": "751120404",
                    "speaker": "莉莉尤",
                    "text": "怎么样，异邦的勇士，有没有兴趣进行尝试呢？",
                    "choices": [
                        {
                            "id": "751120402",
                            "text": "现在开始吧！"
                        },
                        {
                            "id": "751120403",
                            "text": "让我稍作准备…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7511205",
            "objective": "test勾爪龙NPC挑战2$HIDDEN",
            "dialogues": [
                {
                    "id": "751120501",
                    "speaker": "奇玛",
                    "text": "哦，是很少见的异邦的客人呢…怎么样，要试试「勇士挑战」吗？"
                },
                {
                    "id": "751120504",
                    "speaker": "奇玛",
                    "text": "在纳塔，有很多这样的为部族勇士们准备的试炼和挑战，嗯，我呢，就是那些负责安排挑战的人的其中一员。"
                },
                {
                    "id": "751120505",
                    "speaker": "奇玛",
                    "text": "异邦的客人看上去很强嘛，要来尝试进行我准备的挑战吗？",
                    "choices": [
                        {
                            "id": "751120502",
                            "text": "现在开始吧！"
                        },
                        {
                            "id": "751120503",
                            "text": "让我稍作准备…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7511206",
            "objective": "test勾爪龙NPC挑战3$HIDDEN",
            "dialogues": [
                {
                    "id": "751120601",
