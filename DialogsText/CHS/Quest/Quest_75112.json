            "objective": "test钻地龙NPC挑战2$HIDDEN",
            "dialogues": [
                {
                    "id": "751120201",
                    "speaker": "森塔加",
                    "text": "哼哼，异邦的勇士，我从很远的地方就感受到了你的气息，真是了不起啊。"
                },
                {
                    "id": "751120204",
                    "speaker": "森塔加",
                    "text": "要不要来试试为部族战士准备的「勇士挑战」，不说大话，我准备的试炼一定会能让你受益匪浅哦。",
                    "choices": [
                        {
