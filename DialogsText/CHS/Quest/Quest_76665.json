    "talks": [
        {
            "id": "7666501",
            "objective": "",
            "dialogues": [
                {
                    "id": "766506501",
                    "speaker": "菈乌玛",
                    "text": "辛苦你了，库齐娅。"
                },
                {
                    "id": "766506502",
                    "speaker": "库齐娅",
                    "text": "菈乌玛大人？您怎么过来了，我只是顺手清理了一下周围，谈不上辛苦的。"
                },
                {
                    "id": "766506503",
                    "speaker": "菈乌玛",
                    "text": "但是，你平日里也经常过来，给雕像做一些维护的工作，对吗？"
                },
                {
                    "id": "766506504",
                    "speaker": "库齐娅",
                    "text": "是的，我偶尔会来，是小鸟们告诉您的？还是月神大人？"
                },
                {
                    "id": "766506505",
                    "speaker": "菈乌玛",
                    "text": "呵呵，月神大人的确用她的月光给过我一些指引。"
                },
                {
                    "id": "766506506",
                    "speaker": "菈乌玛",
                    "text": "顺着那道月光，我注意过你在深夜前去更换雕像前的花，或者是清洗雕像底座。"
                },
                {
                    "id": "766506507",
                    "speaker": "菈乌玛",
                    "text": "库齐娅，除却对月神大人的虔诚外，你也要关心自己的身体。"
                },
                {
                    "id": "766506508",
                    "speaker": "库齐娅",
                    "text": "…我会注意的，谢谢您，菈乌玛大人。"
                },
                {
                    "id": "766506509",
                    "speaker": "菈乌玛",
                    "text": "是我要感谢你才对，稍微过来一点，库齐娅。"
                },
                {
                    "id": "766506510",
                    "speaker": "菈乌玛",
                    "text": "愿月神，庇佑你的前路。"
                },
                {
                    "id": "766506511",
                    "speaker": "菈乌玛",
                    "text": "…也庇佑，我们所有人。"
                }
            ]
        }
    ]
}