    "talks": [
        {
            "id": "2303801",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230380101",
                    "speaker": "扎卡里亚",
                    "text": "旅行者！旅行者，请快些过来，我有事情想请你帮忙。"
                },
                {
                    "id": "230380102",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "230380103",
                    "speaker": "扎卡里亚",
                    "text": "你还记得马鲁夫吗？就那位阿如村的医生，之前拜托你找我要过药方的那位。"
                },
                {
                    "id": "230380104",
                    "speaker": "扎卡里亚",
                    "text": "这家伙自己试吃了一碗自己熬的药，结果整个人上吐下泻了好几天。"
                },
                {
                    "id": "230380105",
                    "speaker": "扎卡里亚",
                    "text": "我一问才知道，因为病人喝了药汤之后没有效果，他就突发奇想，想要自己改造一下药方。"
                },
                {
                    "id": "230380106",
                    "speaker": "扎卡里亚",
                    "text": "真不知道这家伙往药汤里加入了什么药材，能把自己搞成现在这样…"
                },
                {
                    "id": "230380107",
                    "speaker": "扎卡里亚",
                    "text": "唉，如果他只是在原来药汤的基础上调整药材的比例和药汤做法，绝不会出现这种事。"
                },
                {
                    "id": "230380108",
                    "speaker": "扎卡里亚",
                    "text": "他也不是第一次吃这种亏了，怎么还是…"
                },
                {
                    "id": "230380109",
                    "speaker": "扎卡里亚",
                    "text": "算了，说不定他也有自己的苦衷吧。"
                },
                {
                    "id": "230380110",
                    "speaker": "扎卡里亚",
                    "text": "旅行者，如果你愿意的话，能帮我去拿点药材回来吗？这回我亲自做一副药，请你直接带给马鲁夫吧。",
                    "choices": [
                        {
                            "id": "230380111",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230380114",
                                    "speaker": "扎卡里亚",
                                    "text": "马鲁夫这次改的药方，是我上次开给他用来治疗头疼的药方。"
                                },
                                {
                                    "id": "230380115",
                                    "speaker": "扎卡里亚",
                                    "text": "我的药方里还差三枚赤念果，拜托你帮我去采三枚回来吧。"
                                }
                            ]
                        },
                        {
                            "id": "230380112",
                            "text": "他之前也这么做过吗？",
                            "response": [
                                {
                                    "id": "230380113",
                                    "speaker": "扎卡里亚",
                                    "text": "是啊，我都忘了这是多少次了。还好他不经手那种药性猛烈的药方，不然…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
