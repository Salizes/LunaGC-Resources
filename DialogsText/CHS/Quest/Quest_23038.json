        {
            "id": "2303803",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230380601",
                    "speaker": "扎卡里亚",
                    "text": "非常感谢，这些就够了。我这就去熬制药汤。"
                },
                {
                    "id": "230380602",
                    "speaker": "Black Screen",
                    "text": "扎卡里亚回到屋内，开始熬煮药汤…"
                },
                {
                    "id": "230380603",
                    "speaker": "扎卡里亚",
                    "text": "把这副药带去给马鲁夫吧。希望他多少能学到点教训…"
                }
            ]
        },
