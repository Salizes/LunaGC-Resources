    "talks": [
        {
            "id": "7110901",
            "objective": "继续前进",
            "dialogues": []
        },
        {
            "id": "7110902",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "711090201",
                    "speaker": "派蒙",
                    "text": "哇啊，没想到这破破烂烂的王山厅里，居然还真的藏了这么深的秘密…",
                    "choices": [
                        {
                            "id": "711090202",
                            "text": "我也没想到！",
                            "response": [
                                {
                                    "id": "711090204",
                                    "speaker": "派蒙",
                                    "text": "而且，黄三爷好像也不知道有这种地方…等等，难道这里就是传说中的「古华藏宝室」吗？！"
                                },
                                {
                                    "id": "711090205",
                                    "speaker": "派蒙",
                                    "text": "#而且…{NICKNAME}你看，那边的台子上好像有什么东西在发光！",
                                    "choices": [
                                        {
                                            "id": "711090206",
                                            "text": "是宝藏！",
                                            "response": [
                                                {
                                                    "id": "711090208",
                                                    "speaker": "派蒙",
                                                    "text": "总之，我们快点过去看看吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711090207",
                                            "text": "是机关？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711090203",
                            "text": "可能这就叫「人不可貌相」…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7110903",
            "objective": "调查机关",
            "dialogues": []
        },
        {
            "id": "7110904",
            "objective": "完成试炼",
            "dialogues": []
        },
        {
            "id": "7110905",
            "objective": "继续前进",
            "dialogues": [
                {
                    "id": "711090501",
                    "speaker": "碑铭",
                    "text": "「…天其难谌，臻而见眷者罕。命其靡常，盛而未衰者鲜…获目于天，犹有径路所穷之时，况复天目未及者…」"
                },
                {
                    "id": "711090502",
                    "speaker": "碑铭",
                    "text": "「…遗此碑宇，且问来许。行至绝处，自当何如？」",
                    "choices": [
                        {
                            "id": "711090503",
                            "text": "（触碰石碑。）"
                        },
                        {
                            "id": "711090504",
                            "text": "（离开。）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7110906",
            "objective": "调查古剑",
            "dialogues": [
                {
                    "id": "711090601",
                    "speaker": "派蒙",
                    "text": "欸？这把剑上好像写了什么？让我看看…"
                },
                {
                    "id": "711090602",
                    "speaker": "古剑铭文",
                    "text": "「…抚剑长歌去，斫龙歃血还。神光似游电，寒浪欲摧山…」"
                },
                {
                    "id": "711090603",
                    "speaker": "古剑铭文",
                    "text": "「…斩虎天衡下，刺蛟云海间。功成拂衣后，永同烟水闲…」"
                },
                {
                    "id": "711090604",
                    "speaker": "派蒙",
                    "text": "旁边好像还有一块石碑…咦，这下面的字迹好像不太一样？"
                },
                {
                    "id": "711090605",
                    "speaker": "古老的摹刻",
                    "text": "「…本欲遗鱼羊丰肴于此，奈何日久必腐。且留食谱于此，足下可自烹之。甚美。」"
                },
                {
                    "id": "711090606",
                    "speaker": "古老的摹刻",
                    "text": "「…此外别无他物，唯此剑与此景。」"
                },
                {
                    "id": "711090607",
                    "speaker": "古老的摹刻",
                    "text": "「…行至绝处，当何如？足下已知。」"
                },
                {
                    "id": "711090608",
                    "speaker": "歪歪扭扭的摹刻",
                    "text": "「…不取…遗宝，仅留一…自此…」"
                },
                {
                    "id": "711090609",
                    "speaker": "歪歪扭扭的摹刻",
                    "text": "「请从绝处…读我…」"
                },
                {
                    "id": "711090610",
                    "speaker": "派蒙",
                    "text": "呜哇…下面这几行字儿歪歪扭扭的，根本看不懂写了什么！",
                    "choices": [
                        {
                            "id": "711090611",
                            "text": "大概就是他什么都没拿的意思吧。",
                            "response": [
                                {
                                    "id": "711090613",
                                    "speaker": "派蒙",
                                    "text": "呜呜，到头来都没找到什么价值连城的宝藏，白期待一场了…",
                                    "choices": [
                                        {
                                            "id": "711090614",
                                            "text": "就是啊！",
                                            "response": [
                                                {
                                                    "id": "711090617",
                                                    "speaker": "派蒙",
                                                    "text": "不过，没想到在这种绝境，还能看到这样的风景…至少算是物有所值了吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711090615",
                                            "text": "没事没事，我做料理给你吃。",
                                            "response": [
                                                {
                                                    "id": "711090616",
                                                    "speaker": "派蒙",
                                                    "text": "#欸？！真的吗！{NICKNAME}，一言为定喔！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711090612",
                            "text": "我也看不懂…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7110925",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711092501",
                    "speaker": "文四爷",
                    "text": "唉，不想我古华派千年传承，到头来竟落到了门长带头骗吃骗喝的境地…奈何，奈何啊…"
                },
                {
                    "id": "711092502",
                    "speaker": "黄三爷",
                    "text": "嗨…行了行了，我这不是舍不得师弟守着这师门饿死嘛？"
                },
                {
                    "id": "711092503",
                    "speaker": "黄三爷",
                    "text": "#你也别露出那种表情了。你一天到晚郁郁寡欢的…看到刚才那个{M#小伙子}{F#小姑娘}活跃的表现，你也挺欣慰的不是？"
                },
                {
                    "id": "711092504",
                    "speaker": "文四爷",
                    "text": "#就那{M#傻小子}{F#傻姑娘}？进去转一圈给你做个腊肉饭？我还欣慰？我要年轻几岁先一掌拍死你…"
                },
                {
                    "id": "711092505",
                    "speaker": "黄三爷",
                    "text": "嘿，年轻几岁你掌法还不如我呢！"
                },
                {
                    "id": "711092506",
                    "speaker": "黄三爷",
                    "text": "行了，你听我说…就剩下咱们几个老家伙了，若不像这样试探有缘人的底细，总不能真让那些藏书陪着咱们进棺材吧？"
                },
                {
                    "id": "711092507",
                    "speaker": "文四爷",
                    "text": "……"
                },
                {
                    "id": "711092508",
                    "speaker": "黄三爷",
                    "text": "哈哈，罢了，罢了，这等让人难受的丧气话，不说也罢。"
                },
                {
                    "id": "711092509",
                    "speaker": "黄三爷",
                    "text": "对了，那两个孩子刚才做给我的美食，你也尝尝看吧？嘿嘿，我觉得比万民堂做得还美味呢！来，尝一口，尝一口嘛！"
                }
            ]
        },
        {
            "id": "7110999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711099902",
                    "speaker": "派蒙",
                    "text": "好耶！这样一来水位就降下去了，我们快点去里面看看吧！"
                }
            ]
        }
    ]
}