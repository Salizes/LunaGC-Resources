    "talks": [
        {
            "id": "101001",
            "objective": "等待到第二天",
            "dialogues": []
        },
        {
            "id": "101002",
            "objective": "与银行人员对话",
            "dialogues": [
                {
                    "id": "10100201",
                    "speaker": "叶卡捷琳娜",
                    "text": "#欢迎，「公子」大人的朋友，{NICKNAME}。祝你今后在「愚人众」平步青云。",
                    "choices": [
                        {
                            "id": "10100202",
                            "text": "我不是「公子」的朋友。",
                            "response": [
                                {
                                    "id": "10100204",
                                    "speaker": "叶卡捷琳娜",
                                    "text": "呵…我们都是凡人，不是「冰之女皇」。凡人的想法就像冰层下的水…是不会永远坚固锐利的。"
                                },
                                {
                                    "id": "10100205",
                                    "speaker": "叶卡捷琳娜",
                                    "text": "失礼了，请容我回到正题。「公子」大人说，他与你们的约定已经完成了。"
                                },
                                {
                                    "id": "10100206",
                                    "speaker": "派蒙",
                                    "text": "约定完成了？啊，是指他之前说的，要帮我们找人吗？"
                                },
                                {
                                    "id": "10100207",
                                    "speaker": "叶卡捷琳娜",
                                    "text": "是的，「公子」大人答应会为你们找到能够突破僵局的人。「愚人众」执行官的承诺从不落空。"
                                },
                                {
                                    "id": "10100208",
                                    "speaker": "派蒙",
                                    "text": "那么，他人在哪？"
                                },
                                {
                                    "id": "10100209",
                                    "speaker": "叶卡捷琳娜",
                                    "text": "大人在<color=#00E1FFFF>「琉璃亭」</color>。"
                                },
                                {
                                    "id": "10100210",
                                    "speaker": "Player",
                                    "text": "琉璃亭？"
                                },
                                {
                                    "id": "10100211",
                                    "speaker": "派蒙",
                                    "text": "呀，是琉璃亭！我听说过！"
                                },
                                {
                                    "id": "10100212",
                                    "speaker": "派蒙",
                                    "text": "璃月的两大菜系，「璃菜」和「月菜」，互相斗争了几百年，不分上下。"
                                },
                                {
                                    "id": "10100213",
                                    "speaker": "派蒙",
                                    "text": "「璃菜」的最高代表，就是「琉璃亭」酒家。老板特地把店开在了绯云坡，和代表「月菜」的「新月轩」当面竞争呢！",
                                    "choices": [
                                        {
                                            "id": "10100214",
                                            "text": "派蒙只有在这种时候才像个好向导。",
                                            "response": [
                                                {
                                                    "id": "10100216",
                                                    "speaker": "派蒙",
                                                    "text": "#不要这么说嘛——总之，有好吃的！{NICKNAME}，我们快点过去吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10100215",
                                            "text": "一到蹭吃蹭喝的话题，你就…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10100203",
                            "text": "我不打算加入「愚人众」。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "101003",
            "objective": "寻找「公子」",
            "dialogues": [
                {
                    "id": "10100301",
                    "speaker": "「公子」",
                    "text": "哟，你们来了。"
                },
                {
                    "id": "10100302",
                    "speaker": "「公子」",
                    "text": "约定已经完成了，我找到了能帮助你们的人——能解决「岩神的仙体被七星藏匿」这个难题的人。"
                },
                {
                    "id": "10100303",
                    "speaker": "派蒙",
                    "text": "那么，这个人又在哪？<color=#00E1FFFF>「琉璃亭」</color>里吗？"
                },
                {
                    "id": "10100304",
                    "speaker": "「公子」",
                    "text": "没错。跟我来吧。"
                },
                {
                    "id": "10100305",
                    "speaker": "「公子」",
                    "text": "我准备了一场——嗯，在这个国家，叫做「饭局」的见面仪式。"
                }
            ]
        },
        {
            "id": "101004",
            "objective": "（test）隐藏 钟离登场CS（室外）$HIDDEN",
            "dialogues": [
                {
                    "id": "10100401",
                    "speaker": "鸿如",
                    "text": "有幸又见公子，敝店蓬荜生辉。"
                }
            ]
        },
        {
            "id": "101007",
            "objective": "（test）隐藏 传进室内$HIDDEN",
            "dialogues": []
        },
        {
            "id": "101008",
            "objective": "（test）隐藏 钟离登场CS（琉璃亭室内）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "101005",
            "objective": "进入琉璃亭",
            "dialogues": [
                {
                    "id": "10100501",
                    "speaker": "「公子」",
                    "text": "我来介绍一下，这位朋友是道上人士、「往生堂」的客卿，钟离先生。",
                    "choices": [
                        {
                            "id": "10100502",
                            "text": "道上人士？",
                            "response": [
                                {
                                    "id": "10100504",
                                    "speaker": "「公子」",
                                    "text": "嗯，在璃月，像「往生堂」这样的产业，总是不得不接触一些「道上」的生意。"
                                },
                                {
                                    "id": "10100505",
                                    "speaker": "「公子」",
                                    "text": "而我们愚人众，一向都喜欢与这些…在阴影中行走的朋友们打交道。"
                                },
                                {
                                    "id": "10100506",
                                    "speaker": "派蒙",
                                    "text": "在，在阴影中行走…"
                                },
                                {
                                    "id": "10100507",
                                    "speaker": "钟离",
                                    "text": "二位，幸会。我听过你们在蒙德的传闻。"
                                },
                                {
                                    "id": "10100508",
                                    "speaker": "派蒙",
                                    "text": "道上人士…阴影…送人「往生」…哇！难道说，「往生堂」这个组织，是…"
                                },
                                {
                                    "id": "10100509",
                                    "speaker": "钟离",
                                    "text": "没错，正如你所猜测。"
                                },
                                {
                                    "id": "10100510",
                                    "speaker": "派蒙",
                                    "text": "呀——！"
                                },
                                {
                                    "id": "10100511",
                                    "speaker": "钟离",
                                    "text": "「往生堂」是执掌葬仪的组织，旨在送人安心往生。"
                                },
                                {
                                    "id": "10100512",
                                    "speaker": "派蒙",
                                    "text": "咦。"
                                },
                                {
                                    "id": "10100513",
                                    "speaker": "「公子」",
                                    "text": "哈哈，难道是把钟离先生误认成杀手了？"
                                },
                                {
                                    "id": "10100514",
                                    "speaker": "「公子」",
                                    "text": "愚人众的朋友里确实有很多杀手，但「往生堂」并不是做这一行的…起码明面上不是。"
                                },
                                {
                                    "id": "10100515",
                                    "speaker": "Player",
                                    "text": "明面上…"
                                },
                                {
                                    "id": "10100516",
                                    "speaker": "「公子」",
                                    "text": "毕竟还是「道上人士」嘛，这就不能细说了。总之，我带你们来认识钟离，是因为…"
                                },
                                {
                                    "id": "10100517",
                                    "speaker": "钟离",
                                    "text": "因为我有办法让你们见到岩王帝君的仙体。"
                                },
                                {
                                    "id": "10100518",
                                    "speaker": "派蒙",
                                    "text": "什么？！"
                                },
                                {
                                    "id": "10100519",
                                    "speaker": "「公子」",
                                    "text": "哈，不必惊讶，虽然在「天权星」凝光的操纵下，岩神的仙体早已被藏匿起来…但，还是先听听钟离的说法吧。"
                                },
                                {
                                    "id": "10100520",
                                    "speaker": "钟离",
                                    "text": "岩王帝君虽是众仙之祖，但说到底也算是仙人之一。纵观璃月数千年的历史，仙人纷纷离去，这是不可挽回的趋势。"
                                },
                                {
                                    "id": "10100521",
                                    "speaker": "钟离",
                                    "text": "因为时代变了——你在绝云间，应该也已体会到这种变迁。",
                                    "choices": [
                                        {
                                            "id": "10100522",
                                            "text": "确实，仙人们正在远离璃月。",
                                            "response": [
                                                {
                                                    "id": "10100525",
                                                    "speaker": "钟离",
                                                    "text": "如你所见，仙众的时代正在远去，人的时代正在逐渐成为现实。"
                                                },
                                                {
                                                    "id": "10100526",
                                                    "speaker": "钟离",
                                                    "text": "往年每位仙人离去时，都会有一场盛大的纪念仪式。这是璃月的传统。但这次竟连七星都无暇顾及这项传统…实在不成样子。"
                                                },
                                                {
                                                    "id": "10100527",
                                                    "speaker": "Player",
                                                    "text": "毕竟是「谋杀神明的奇案」…"
                                                },
                                                {
                                                    "id": "10100528",
                                                    "speaker": "派蒙",
                                                    "text": "是啊，连真正的凶手都没抓到呢。"
                                                },
                                                {
                                                    "id": "10100529",
                                                    "speaker": "钟离",
                                                    "text": "谋杀神明的奇案…「往生堂」不关心这种事。「往生堂」关心的是，请仙的仪式如此隆重，送仙的仪式就没人管了吗？"
                                                },
                                                {
                                                    "id": "10100530",
                                                    "speaker": "钟离",
                                                    "text": "旅者，我从「公子」那里听说了你的事。既然你与风神有些交情…那么，可否考虑与我一起，筹备一场送别岩神的仪式？",
                                                    "choices": [
                                                        {
                                                            "id": "10100531",
                                                            "text": "我需要再思考一下…",
                                                            "response": [
                                                                {
                                                                    "id": "10100532",
                                                                    "speaker": "派蒙",
                                                                    "text": "#唔…{NICKNAME}，仔细想想，恐怕也没有别的办法了…"
                                                                },
                                                                {
                                                                    "id": "10100533",
                                                                    "speaker": "「公子」",
                                                                    "text": "没错，再多思考也是一样的结果。"
                                                                },
                                                                {
                                                                    "id": "10100539",
                                                                    "speaker": "「公子」",
                                                                    "text": "「天权」凝光…她正在阻止任何人瞻仰帝君的仙体。所以，如果你想达成寻访七神的目标，就只剩这样一条渠道了。"
                                                                },
                                                                {
                                                                    "id": "10100540",
                                                                    "speaker": "钟离",
                                                                    "text": "正是如此。唯有参与「送仙典仪」，你才能再次得见岩神之躯。"
                                                                },
                                                                {
                                                                    "id": "10100541",
                                                                    "speaker": "Player",
                                                                    "text": "看来也没有别的办法了。"
                                                                },
                                                                {
                                                                    "id": "10100542",
                                                                    "speaker": "钟离",
                                                                    "text": "嗯，若你答允，就跟我来吧。详细的情况，我们路上再说。"
                                                                },
                                                                {
                                                                    "id": "10100543",
                                                                    "speaker": "钟离",
                                                                    "text": "（黑屏，钟离出门）"
                                                                },
                                                                {
                                                                    "id": "10100544",
                                                                    "speaker": "「公子」",
                                                                    "text": "好了，我牵线搭桥的任务已经完成了。怎样，这结果还不错吧？"
                                                                },
                                                                {
                                                                    "id": "10100545",
                                                                    "speaker": "「公子」",
                                                                    "text": "你们要走的话就走吧，不用管我，我也许会在这里再喝几杯…顺便熟悉一下「筷子」的用法。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10100534",
                                                            "text": "要接受邀请，也不是不行…",
                                                            "response": [
                                                                {
                                                                    "id": "10100535",
                                                                    "speaker": "「公子」",
                                                                    "text": "明智之选。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10100536",
                                                            "text": "「公子」的话太多了。",
                                                            "response": [
                                                                {
                                                                    "id": "10100537",
                                                                    "speaker": "「公子」",
                                                                    "text": "哦？在「道上」，这句话就是要灭口的意思咯…很有意思，拔剑吧，我们就在这里——"
                                                                },
                                                                {
                                                                    "id": "10100538",
                                                                    "speaker": "「公子」",
                                                                    "text": "开玩笑的。我们继续说正事。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10100523",
                                            "text": "七神之一的岩神，也是仙人？",
                                            "response": [
                                                {
                                                    "id": "10100524",
                                                    "speaker": "钟离",
                                                    "text": "神有许多尊名。契约之神、商业之神、武神、摩拉克斯、岩王帝君…其中自然也包括「仙人」。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10100503",
                            "text": "往生堂？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "101006",
            "objective": "在门外与钟离对话",
            "dialogues": [
                {
                    "id": "10100601",
                    "speaker": "钟离",
                    "text": "旅者，经历了「神离开的城邦」以后，你对璃月这「有神之地」，感受如何呢？",
                    "choices": [
                        {
                            "id": "10100602",
                            "text": "我更喜欢蒙德的气氛。",
                            "response": [
                                {
                                    "id": "10100603",
                                    "speaker": "钟离",
                                    "text": "原来如此…你是这种类型的游人。那也不错。"
                                },
                                {
                                    "id": "10100604",
                                    "speaker": "钟离",
                                    "text": "不过，「有神之地」三千七百年的历史厚度，或许你还没有完全体验到吧。"
                                },
                                {
                                    "id": "10100607",
                                    "speaker": "钟离",
                                    "text": "筹办「送仙典仪」的过程，也会成为你旅途的一部分，增广见闻。"
                                },
                                {
                                    "id": "10100608",
                                    "speaker": "钟离",
                                    "text": "璃月是尘世七国里最繁荣的一国，往年也有神灵镇守、七星统治。所以「愚人众」的许多外交手段，在璃月都施展不开。"
                                },
                                {
                                    "id": "10100609",
                                    "speaker": "钟离",
                                    "text": "七星之一的凝光，始终对愚人众重重防备，或许这就是「公子」想借「往生堂」关系办事的原因吧。"
                                },
                                {
                                    "id": "10100610",
                                    "speaker": "派蒙",
                                    "text": "唔…我们要办「送仙典仪」，对「公子」有什么好处呢？"
                                },
                                {
                                    "id": "10100611",
                                    "speaker": "钟离",
                                    "text": "我不知道，也不想知道。对我来说，「愚人众」只是提供资金支持，我只希望璃月的传统不要被人遗忘。"
                                },
                                {
                                    "id": "10100612",
                                    "speaker": "钟离",
                                    "text": "（钟离交给主角一个钱袋）"
                                },
                                {
                                    "id": "10100613",
                                    "speaker": "钟离",
                                    "text": "这是「公子」给的第一笔垫付资金。如果用完，也可以再去找他报销后续款项。"
                                },
                                {
                                    "id": "10100614",
                                    "speaker": "派蒙",
                                    "text": "哇哦…"
                                },
                                {
                                    "id": "10100615",
                                    "speaker": "钟离",
                                    "text": "好了，我们动身吧。筹备仪式的第一步…是要取得品质足以匹配神灵的，最上等的<color=#00E1FFFF>「夜泊石」</color>。"
                                }
                            ]
                        },
                        {
                            "id": "10100605",
                            "text": "果然还是璃月好。",
                            "response": [
                                {
                                    "id": "10100606",
                                    "speaker": "钟离",
                                    "text": "嗯，「有神之地」三千七百年的历史厚度，在七国中亦是最深。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}