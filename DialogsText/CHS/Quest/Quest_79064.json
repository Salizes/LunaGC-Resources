    "talks": [
        {
            "id": "7906402",
            "objective": "（test）被巨人赶出去1$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7906403",
            "objective": "（test）被巨人赶出去1的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790640301",
                    "speaker": "奥比奇",
                    "text": "#大家，是我回来了。我带着预言中的侯爵和{M#他}{F#她}的随从一起回来寻找家族的失落原典了！"
                },
                {
                    "id": "790640302",
                    "speaker": "巨人卫兵",
                    "text": "我们今早并没有听说有这样的事情。赶紧离开，不要给我们添麻烦。"
                },
                {
                    "id": "790640303",
                    "speaker": "Black Screen",
                    "text": "巨大的卫兵拎起了众人，丢出了外面。\\n大家无法反抗…"
                }
            ]
        },
        {
            "id": "7906401",
            "objective": "（test）被巨人赶出去2$HIDDEN",
            "dialogues": [
                {
                    "id": "790640101",
                    "speaker": "巨人卫兵",
                    "text": "谢谢你诚实地自首。我们一样会有礼貌地将您请出禁地的。"
                },
                {
                    "id": "790640102",
                    "speaker": "Black Screen",
                    "text": "巨大的卫兵拎起了众人，放到了外面。\\n整个过程非常文明…"
                }
            ]
        },
        {
            "id": "7906411",
            "objective": "（test）和科学怪人对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7906410",
            "objective": "（test）和科学怪人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790640801",
                    "speaker": "奥比奇",
                    "text": "这个是警卫室总部，只要和他们说清楚，一定可以解除巨大化卫兵的警戒。"
                },
                {
                    "id": "790640802",
                    "speaker": "Player",
                    "text": "您好…"
                },
                {
                    "id": "790640803",
                    "speaker": "门后的声音",
                    "text": "干什么，我正拿着我朋友的照片思念旧日时光呢。"
                },
                {
                    "id": "790640804",
                    "speaker": "奥比奇",
                    "text": "这声音，是温斯顿吗？"
                },
                {
                    "id": "790640805",
                    "speaker": "温斯顿",
                    "text": "哼哼，你终于灰溜溜地跑回来了啊。都说了你只有我一个朋友，为什么要接下和两个陌生人一起的任务？"
                },
                {
                    "id": "790640806",
                    "speaker": "温斯顿",
                    "text": "当时你一脸天真：「我一定会和他们成为朋友的！」结果到最后也只有我还在等着你，只有我还是你朋友。"
                },
                {
                    "id": "790640807",
                    "speaker": "奥比奇",
                    "text": "#那倒不是…不仅他们两个一起来了，还有{NICKNAME}侯爵和{M#他}{F#她}的伙伴呢。"
                },
                {
                    "id": "790640808",
                    "speaker": "温斯顿",
                    "text": "…你居然背着我在外面交了朋友？长大了啊，奥比奇。够了，你滚吧，我再也不想见到你了！"
                },
                {
                    "id": "790640809",
                    "speaker": "奥比奇",
                    "text": "欸，不是。你倒是解除一下戒严状态啊。现在我带着重要人物回来了，马上就可以解开圣地之谜了。"
                },
                {
                    "id": "790640810",
                    "speaker": "温斯顿",
                    "text": "给我滚！"
                },
                {
                    "id": "790640811",
                    "speaker": "黑屏文字",
                    "text": "温斯顿敲响了警报。巨大的卫兵过来拎起了众人，放到了外面。\\n「现在把你和温斯顿分开一下比较好，你们的友谊也需要冷静期。」\\n巨大卫兵人很好，还给出了情感建议。\\n整个过程异常文明。"
                }
            ]
        },
        {
            "id": "7906404",
            "objective": "（test）被巨人赶出去2的对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7906405",
            "objective": "（test）被巨人赶出去3$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7906409",
            "objective": "（test）回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7906408",
            "objective": "（test）跑酷被NPC追上$HIDDEN",
            "dialogues": [
                {
                    "id": "790640701",
                    "speaker": "巨人卫兵",
                    "text": "逮捕可疑人士若干，以及混在可疑人士里的奥比奇！跟我走一趟！"
                }
            ]
        },
        {
            "id": "7906406",
            "objective": "（test）被巨人赶出去3的对话$HIDDEN",
            "dialogues": [
                {
                    "id": "790640601",
                    "speaker": "巨人卫兵",
                    "text": "发现可疑人士！虽然不知道你们犯了什么法，但是现在最高戒备，走，和我们去自首！"
                },
                {
                    "id": "790640602",
                    "speaker": "Black Screen",
                    "text": "你们四散逃开。卡佩喊了一句「各凭本事！」 \\n甩开守卫之后，你们在原地重新集合了。好在没有人被抓…"
                },
                {
                    "id": "790640603",
                    "speaker": "旁白",
                    "text": "再试试吧。"
                }
            ]
        },
        {
            "id": "7906407",
            "objective": "（test）完成父任务$HIDDEN",
            "dialogues": []
        }
