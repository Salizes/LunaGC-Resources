        {
            "id": "4011141",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401114101",
                    "speaker": "迪奥娜",
                    "text": "臭老爹，要打牌吗？"
                },
                {
                    "id": "401114102",
                    "speaker": "迪奥娜",
                    "text": "我可有言在先哦！要是你今天喝了酒，脑袋晕乎乎的，肯定在三回合内就输给我了。"
                },
                {
                    "id": "401114103",
                    "speaker": "杜拉夫",
                    "text": "三回合？迪奥娜是不是有点小看爸爸了啊？"
                },
                {
                    "id": "401114104",
                    "speaker": "杜拉夫",
                    "text": "再怎么说也能拖到五回合吧。"
                },
                {
                    "id": "401114105",
                    "speaker": "迪奥娜",
                    "text": "一样是输！那有什么好骄傲的！"
                },
                {
                    "id": "401114106",
                    "speaker": "迪奥娜",
                    "text": "上次，臭老爹你还指着水元素的骰子，对我说是冰元素！气死人了。"
                },
                {
                    "id": "401114107",
                    "speaker": "杜拉夫",
                    "text": "哈哈哈，是我眼神不好…"
                },
                {
                    "id": "401114108",
                    "speaker": "迪奥娜",
                    "text": "是「酒」不好！不许为它辩护。"
                },
                {
                    "id": "401114109",
                    "speaker": "杜拉夫",
                    "text": "好好好，是酒不好。那今天就先不喝了，一滴也不碰，这下总行了吧？"
                },
                {
                    "id": "401114110",
                    "speaker": "迪奥娜",
                    "text": "勉勉强强。"
                },
                {
                    "id": "401114111",
                    "speaker": "杜拉夫",
                    "text": "那我要是赢了迪奥娜呢？有没有什么奖励？"
                },
                {
                    "id": "401114112",
                    "speaker": "迪奥娜",
                    "text": "想我给你做一杯特调？门都没有！"
                },
                {
                    "id": "401114113",
                    "speaker": "杜拉夫",
                    "text": "如果是在五回合之内赢的呢？…"
                },
                {
                    "id": "401114114",
                    "speaker": "迪奥娜",
                    "text": "小看我！来就来…我才不会输呢！"
                }
            ]
        },
        {
            "id": "4011142",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401114201",
                    "speaker": "北斗",
                    "text": "几日不见，小子，你的牌技怎么长进这么多？"
                },
                {
                    "id": "401114202",
                    "speaker": "枫原万叶",
                    "text": "多亏和高人交过手。"
                },
                {
                    "id": "401114203",
                    "speaker": "北斗",
                    "text": "哦？哪位高人？你先别急着说…让我猜猜。"
                },
                {
                    "id": "401114204",
                    "speaker": "北斗",
                    "text": "凝光那家伙没这个闲心，香菱和辛焱也不是一直琢磨牌的人…"
                },
                {
                    "id": "401114205",
                    "speaker": "北斗",
                    "text": "瑶瑶最近要是不忙，早耐不住往船上跑，和大家打招呼了。也不会是她。"
                },
                {
                    "id": "401114206",
                    "speaker": "北斗",
                    "text": "#难道是{NICKNAME}？{M#他}{F#她}刚巧也来璃月港了？"
                },
                {
                    "id": "401114207",
                    "speaker": "枫原万叶",
                    "text": "#可惜大姐头还是猜的不对。我的确和{NICKNAME}同行了一阵，期间也「以牌会友」…"
                },
                {
                    "id": "401114208",
                    "speaker": "北斗",
                    "text": "新朋友？那我就猜不出了。"
                },
                {
                    "id": "401114209",
                    "speaker": "枫原万叶",
                    "text": "往生堂堂主，胡桃小姐。大姐头可有耳闻？"
                },
                {
                    "id": "401114210",
                    "speaker": "北斗",
                    "text": "听倒是听说过。这次拿了「召唤王大奖赛」冠军的也是她吧？"
                },
                {
                    "id": "401114211",
                    "speaker": "枫原万叶",
                    "text": "正是。她还说对大姐头崇拜已久，一直想跟你交个朋友。"
                },
                {
                    "id": "401114212",
                    "speaker": "北斗",
                    "text": "那好啊！这不是正好吗？"
                },
                {
                    "id": "401114213",
                    "speaker": "北斗",
                    "text": "把她请来船上，切磋上几局，让我仰望仰望冠军的风采。"
                },
                {
                    "id": "401114214",
                    "speaker": "北斗",
                    "text": "唔…这么说来，是不是还是我亲自去往生堂，显得比较有诚意？"
                }
            ]
        },
        {
            "id": "4011143",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401114301",
                    "speaker": "珊瑚宫心海",
                    "text": "#咦？{NICKNAME}，你是专程回来见我的吗？",
                    "choices": [
                        {
                            "id": "401114302",
                            "text": "关于「怪盗」…",
                            "response": [
                                {
                                    "id": "401114303",
                                    "speaker": "珊瑚宫心海",
                                    "text": "原来谜底是这样…让人不知该以怎样的表情面对呢。"
                                },
                                {
                                    "id": "401114304",
                                    "speaker": "珊瑚宫心海",
                                    "text": "谢谢你能告诉我这些。"
                                },
                                {
                                    "id": "401114305",
                                    "speaker": "珊瑚宫心海",
                                    "text": "就像读完了小说的结尾，这下可以安心了。",
                                    "choices": [
                                        {
                                            "id": "401114306",
                                            "text": "关于「比赛」…",
                                            "response": [
                                                {
                                                    "id": "401114307",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "「胜负不是最重要的。」「要打出风度。」——原本我一直这么想着。"
                                                },
                                                {
                                                    "id": "401114308",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "可看着你们为我加油的样子，不知不觉就想以最认真的姿态面对了。"
                                                },
                                                {
                                                    "id": "401114309",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "呵呵…这一想，能在比赛前见到你们真是太好了。"
                                                },
                                                {
                                                    "id": "401114310",
                                                    "speaker": "Player",
                                                    "text": "能量值+5？"
                                                },
                                                {
                                                    "id": "401114311",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "唔…！不，不要再提那个了啦！",
                                                    "choices": [
                                                        {
                                                            "id": "401114302",
                                                            "text": "关于「怪盗」…"
                                                        },
                                                        {
                                                            "id": "401114312",
                                                            "text": "先不打扰你了。",
                                                            "response": [
                                                                {
                                                                    "id": "401114313",
                                                                    "speaker": "珊瑚宫心海",
                                                                    "text": "既然来了海祇岛，就多坐一会儿再走吧。"
                                                                },
                                                                {
                                                                    "id": "401114314",
                                                                    "speaker": "珊瑚宫心海",
                                                                    "text": "希望这片风景能一直留在你的心中。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401114312",
                                            "text": "先不打扰你了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401114306",
                            "text": "关于「比赛」…"
                        },
                        {
                            "id": "401114312",
                            "text": "先不打扰你了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011144",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401114401",
                    "speaker": "提纳里",
                    "text": "这么巧？赛诺先前和我讲了你们的经历。",
                    "choices": [
                        {
                            "id": "401114402",
                            "text": "关于「冷笑话」…",
                            "response": [
                                {
                                    "id": "401114403",
                                    "speaker": "提纳里",
                                    "text": "停！赛诺已经满脸得意地和我一一细数了他想出的冷笑话。我不想听第二遍了。"
                                },
                                {
                                    "id": "401114404",
                                    "speaker": "提纳里",
                                    "text": "这个话题到此为止吧。",
                                    "choices": [
                                        {
                                            "id": "401114405",
                                            "text": "关于「七圣召唤」…",
                                            "response": [
                                                {
                                                    "id": "401114406",
                                                    "speaker": "提纳里",
                                                    "text": "最近道成林的事务不多，就带着柯莱一起去玩了玩。"
                                                },
                                                {
                                                    "id": "401114407",
                                                    "speaker": "提纳里",
                                                    "text": "柯莱她还挺厉害的，在大奖赛上也拿到了不错的名次。"
                                                },
                                                {
                                                    "id": "401114408",
                                                    "speaker": "提纳里",
                                                    "text": "我虽然通过了预选，但签运不好，没打几场就碰到了赛诺。"
                                                },
                                                {
                                                    "id": "401114409",
                                                    "speaker": "提纳里",
                                                    "text": "那家伙，打起牌来一点情面都不给。使出杀手锏时也喊得格外大声，震得我耳朵疼。"
                                                },
                                                {
                                                    "id": "401114410",
                                                    "speaker": "提纳里",
                                                    "text": "好久没见他这么激动的样子了…",
                                                    "choices": [
                                                        {
                                                            "id": "401114402",
                                                            "text": "关于「冷笑话」…"
                                                        },
                                                        {
                                                            "id": "401114411",
                                                            "text": "先不打扰你了。",
                                                            "response": [
                                                                {
                                                                    "id": "401114412",
                                                                    "speaker": "提纳里",
                                                                    "text": "不必客气，有空多来玩。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401114411",
                                            "text": "先不打扰你了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401114405",
                            "text": "关于「七圣召唤」…"
                        },
                        {
                            "id": "401114411",
                            "text": "先不打扰你了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4011161",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401116101",
                    "speaker": "大赛公告",
                    "text": "提米选手一路过关斩将，牌运如有风神相助！一跃成为蒙德赛区热门夺冠人选！"
                },
                {
                    "id": "401116102",
                    "speaker": "留言",
                    "text": "提米小弟是真不一般，我看了他与一位金发姑娘的比赛，赢得真是精彩。"
                },
                {
                    "id": "401116103",
                    "speaker": "匿名回复",
                    "text": "愚昧！汝可曾看到那位少年背后圣耀的翎羽？"
                },
                {
                    "id": "401116104",
                    "speaker": "匿名回复",
                    "text": "定是其辉灼的光芒桎梏了那位皇女的断罪之眼，才使得命运的天平产生了偏谬！"
                },
                {
                    "id": "401116105",
                    "speaker": "匿名回复",
                    "text": "下次本皇女一定会带上幽夜净土的扈从一报前仇！"
                },
                {
                    "id": "401116106",
                    "speaker": "被涂得模糊不清的留言",
                    "text": "██咪，别在██待太晚了，看到这██的话就早点回██饭。"
                }
            ]
        },
        {
            "id": "4011162",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401116201",
                    "speaker": "大赛公告",
                    "text": "欢迎大家在大赛期间光临会场周边各类特色小吃摊。「清心薄荷凉糕」限量热卖中。"
                },
                {
                    "id": "401116202",
                    "speaker": "留言",
                    "text": "这个「清心薄荷凉糕」真的那么好吃吗？我来好几次了，一次都没见到…"
                },
                {
                    "id": "401116203",
                    "speaker": "回复",
                    "text": "兄弟是这几天才来的吧？听说这是仙人喜欢吃的东西，开售第一天就被抢完了。"
                },
                {
                    "id": "401116204",
                    "speaker": "回复",
                    "text": "吃起来挺清爽的，就是的确有点苦。"
                },
                {
                    "id": "401116205",
                    "speaker": "回复",
                    "text": "好苦。"
                },
                {
                    "id": "401116206",
                    "speaker": "回复",
                    "text": "好苦好苦。"
                },
                {
                    "id": "401116207",
                    "speaker": "回复",
                    "text": "好吃。"
                },
                {
                    "id": "401116208",
                    "speaker": "回复",
                    "text": "可恶啊，我更好奇了！这点心什么时候返场？店家赶紧安排起来啊！"
                },
                {
                    "id": "401116209",
                    "speaker": "回复",
                    "text": "说起来…仙人也会玩「七圣召唤」吗？"
                },
                {
                    "id": "401116210",
                    "speaker": "回复",
                    "text": "有趣的东西谁都喜欢吧？"
                }
            ]
        },
        {
            "id": "4011163",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401116301",
                    "speaker": "大赛公告",
                    "text": "稻妻赛区的决赛，将由鸣神大社宫司八重神子，对阵海祇岛现人神巫女珊瑚宫心海！"
                },
                {
                    "id": "401116302",
                    "speaker": "大赛公告",
                    "text": "这道倨傲的惊雷，是否能在那深不可测的海底鸣响？"
                },
                {
                    "id": "401116303",
                    "speaker": "八重堂广告",
                    "text": "全新修订版精装《召唤王》正在各大会场售卖，现在购买的话还送书中同款「禁忌骰」周边一枚！"
                },
                {
                    "id": "401116304",
                    "speaker": "留言",
                    "text": "我永远支持八重神子大人！"
                },
                {
                    "id": "401116305",
                    "speaker": "回复",
                    "text": "别想了，最后胜利的肯定是我们海祇岛的珊瑚宫心海大人。"
                },
                {
                    "id": "401116306",
                    "speaker": "回复",
                    "text": "痴心妄想！敢不敢来打赌？"
                },
                {
                    "id": "401116307",
                    "speaker": "回复",
                    "text": "来就来！输了的晚上请客吃饭！"
                },
                {
                    "id": "401116308",
                    "speaker": "天领奉行回复",
                    "text": "请各位遵守会场秩序，理性观赛。"
                }
            ]
        },
        {
            "id": "4011164",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401116401",
                    "speaker": "大赛公告",
                    "text": "召唤王大奖赛热烈举办中！坊间比赛人才辈出，欢迎大家前来决斗！"
                },
                {
                    "id": "401116402",
                    "speaker": "留言",
                    "text": "没想到你们这些搞建筑的玩牌这么厉害，我看大赛八强里有好几个都是妙论派的人。"
                },
                {
                    "id": "401116403",
                    "speaker": "回复",
                    "text": "什么叫「搞建筑的」？我们平时研究的建筑几何还有机关术，比那些搞文字的知论派还要复杂得多。"
                },
                {
                    "id": "401116404",
                    "speaker": "回复",
                    "text": "这话我可就不爱听了。什么叫「搞文字的」？语言学和符文学可是很深奥的学问。"
                },
                {
                    "id": "401116405",
                    "speaker": "回复",
                    "text": "大家都各有所长。既然谁也不服谁的话，不如我们办一场「召唤王学院争霸赛」吧！"
                },
                {
                    "id": "401116406",
                    "speaker": "回复",
                    "text": "好主意！"
                },
                {
                    "id": "401116407",
                    "speaker": "回复",
                    "text": "好主意！"
                },
                {
                    "id": "401116408",
                    "speaker": "回复",
                    "text": "咱们赛场上见！"
                }
            ]
        },
        {
            "id": "7053102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705310201",
                    "speaker": "奥妮",
