    "talks": [
        {
            "id": "1201310",
            "objective": "沿路出城寻找线索",
            "dialogues": [
                {
                    "id": "120131001",
                    "speaker": "森彦",
                    "text": "你们路上要小心啊。"
                },
                {
                    "id": "120131002",
                    "speaker": "森彦",
                    "text": "对方可是天领奉行众，千万别太莽撞了。"
                }
            ]
        },
        {
            "id": "1201301",
            "objective": "和孩子们交谈",
            "dialogues": [
                {
                    "id": "120130101",
                    "speaker": "松坂",
                    "text": "宵宫姐姐好！对付「大貉妖」的武器，宵宫姐姐做好了吗？"
                },
                {
                    "id": "120130102",
                    "speaker": "宵宫",
                    "text": "那个我已经拜托给龙之介伯伯了，等会儿你们就去找他拿吧。"
                },
                {
                    "id": "120130103",
                    "speaker": "彩香",
                    "text": "欸？难道姐姐不陪我们玩了吗？"
                },
                {
                    "id": "120130104",
                    "speaker": "宵宫",
                    "text": "对不起，姐姐还有些重要的事，会稍微晚一点回来。"
                },
                {
                    "id": "120130105",
                    "speaker": "宵宫",
                    "text": "下次给你们带糖果吧！就是你们喜欢的，很甜很甜的那种糖。"
                },
                {
                    "id": "120130106",
                    "speaker": "岩夫",
                    "text": "好！又有糖吃啦！"
                },
                {
                    "id": "120130107",
                    "speaker": "宵宫",
                    "text": "对了，我有个事想打听，你们刚刚看到了一群看起来很凶的叔叔经过这里吗？"
                },
                {
                    "id": "120130108",
                    "speaker": "彩香",
                    "text": "有的有的，他们好像在抓什么人！"
                },
                {
                    "id": "120130109",
                    "speaker": "岩夫",
                    "text": "他们是不是也在抓妖怪啊？"
                },
                {
                    "id": "120130110",
                    "speaker": "宵宫",
                    "text": "没事，你们不用担心，是叔叔他们误会了。"
                },
                {
                    "id": "120130111",
                    "speaker": "宵宫",
                    "text": "你们听话，留在城里，等烟花会开始了就和大家一起玩吧。"
                },
                {
                    "id": "120130112",
                    "speaker": "松坂",
                    "text": "嗯，会好好听话的！宵宫姐姐说什么我们就做什么！"
                }
            ]
        },
        {
            "id": "1201311",
            "objective": "按照孩子们指示的方向前进",
            "dialogues": []
        },
        {
            "id": "1201302",
            "objective": "接近拦路的天领奉行众",
            "dialogues": [
                {
                    "id": "120130201",
                    "speaker": "义高",
                    "text": "前方正在执行公务，禁止通行。"
                },
                {
                    "id": "120130202",
                    "speaker": "宵宫",
                    "text": "朔次郎和佳祐就在里面对吧？我们有事情要找他们。"
                },
                {
                    "id": "120130203",
                    "speaker": "义高",
                    "text": "听不懂话吗？说了禁止通行。"
                },
                {
                    "id": "120130204",
                    "speaker": "宵宫",
                    "text": "真碍事，那就别怪我们不客气了！"
                }
            ]
        },
        {
            "id": "1201303",
            "objective": "击败天领奉行众",
            "dialogues": [
                {
                    "id": "120130301",
                    "speaker": "义高",
                    "text": "你们胆敢妨碍公务，好大的胆子！"
                },
                {
                    "id": "120130302",
                    "speaker": "义高",
                    "text": "这种行为，天领奉行定会严惩！"
                },
                {
                    "id": "120130303",
                    "speaker": "义高",
                    "text": "就算你们逃到天涯海角，也休想逃脱制裁！"
                },
                {
                    "id": "120130304",
                    "speaker": "宵宫",
                    "text": "说得这么吓人，跑得比谁都快。"
                },
                {
                    "id": "120130305",
                    "speaker": "宵宫",
                    "text": "没时间耽误在他们的身上了，我们继续往里面走吧，应该就在里面了。"
                }
            ]
        },
        {
            "id": "1201304",
            "objective": "与仓皇的天领奉行众交谈",
            "dialogues": []
        },
        {
            "id": "1201305",
            "objective": "继续深入，寻找朔次郎",
            "dialogues": [
                {
                    "id": "120130501",
                    "speaker": "朔次郎",
                    "text": "哈啊…哈啊…"
                },
                {
                    "id": "120130502",
                    "speaker": "今谷佳祐",
                    "text": "你的剑技，很久没有提升了，朔次郎。"
                },
                {
                    "id": "120130503",
                    "speaker": "今谷佳祐",
                    "text": "你明知道和我决斗，是不可能有胜算的。"
                },
                {
                    "id": "120130504",
                    "speaker": "朔次郎",
                    "text": "我没想到，最后会落到你的手上。"
                },
                {
                    "id": "120130505",
                    "speaker": "朔次郎",
                    "text": "……"
                },
                {
                    "id": "120130506",
                    "speaker": "朔次郎",
                    "text": "我认了，这就是命运吧，我已经没什么想说了。"
                },
                {
                    "id": "120130507",
                    "speaker": "今谷佳祐",
                    "text": "但至少你回来就说明，你最终还是认同了我的想法。"
                },
                {
                    "id": "120130508",
                    "speaker": "朔次郎",
                    "text": "随你怎么说吧。"
                },
                {
                    "id": "120130509",
                    "speaker": "今谷佳祐",
                    "text": "跟我回天领奉行，听候发落。"
                },
                {
                    "id": "120130510",
                    "speaker": "今谷佳祐",
                    "text": "这艘船的制造者，也逃不过惩处。"
                },
                {
                    "id": "120130511",
                    "speaker": "宵宫",
                    "text": "等一下！"
                },
                {
                    "id": "120130512",
                    "speaker": "宵宫",
                    "text": "为什么就这么决定了！你们没有更多的话要说吗！"
                },
                {
                    "id": "120130513",
                    "speaker": "今谷佳祐",
                    "text": "我知道你，是长野原家造烟花的那个姑娘…早就知道你爱管闲事，但这件事和你无关。"
                },
                {
                    "id": "120130514",
                    "speaker": "朔次郎",
                    "text": "没事的，宵宫，过去的事已经没有什么好说的了。"
                },
                {
                    "id": "120130515",
                    "speaker": "宵宫",
                    "text": "那你辛辛苦苦，不惜偷渡也要回到稻妻是为了什么？！犹豫那么久又是为了什么？！"
                },
                {
                    "id": "120130516",
                    "speaker": "宵宫",
                    "text": "不就是想要现在这样，可以好好说话的机会吗！"
                },
                {
                    "id": "120130517",
                    "speaker": "今谷佳祐",
                    "text": "我没有话要和他说。"
                },
                {
                    "id": "120130518",
                    "speaker": "今谷佳祐",
                    "text": "他是犯人，我是天领奉行的执行者，本来就没有交谈的余地。"
                },
                {
                    "id": "120130519",
                    "speaker": "今谷佳祐",
                    "text": "只是念在旧日的友谊，我给了他与我决斗的机会，但他的剑技还是像以前一样不争气。"
                },
                {
                    "id": "120130520",
                    "speaker": "宵宫",
                    "text": "为什么要说这种话？别再骗人了！"
                },
                {
                    "id": "120130521",
                    "speaker": "宵宫",
                    "text": "你把你的手下都留在了那边封路，这里一个跟随的人都没有，不就是觉得，可能还有对话的机会吗？"
                },
                {
                    "id": "120130522",
                    "speaker": "宵宫",
                    "text": "明明两个人都是一副有话要说的样子，为什么就是什么都不愿意说啊？"
                },
                {
                    "id": "120130523",
                    "speaker": "今谷佳祐",
                    "text": "……"
                },
                {
                    "id": "120130524",
                    "speaker": "今谷佳祐",
                    "text": "自作多情，你又懂什么。"
                },
                {
                    "id": "120130525",
                    "speaker": "朔次郎",
                    "text": "行了，宵宫，我觉得只是我一厢情愿而已。"
                },
                {
                    "id": "120130526",
                    "speaker": "宵宫",
                    "text": "不行！明明什么都没做，当然不行！"
                },
                {
                    "id": "120130527",
                    "speaker": "宵宫",
                    "text": "既然这样，佳祐，你习惯用决斗解决问题，那就跟我决斗吧！"
                },
                {
                    "id": "120130528",
                    "speaker": "宵宫",
                    "text": "只要我赢了你，你就要说出你的真心话，不要再把自己藏起来了！"
                },
                {
                    "id": "120130529",
                    "speaker": "宵宫",
                    "text": "朔次郎，你也是！我赢了的话，你就把你回来的原因告诉他，无论结果如何，都一定要说出来！"
                },
                {
                    "id": "120130530",
                    "speaker": "宵宫",
                    "text": "不说的话，可能就再也没有机会了！"
                },
                {
                    "id": "120130531",
                    "speaker": "今谷佳祐",
                    "text": "那，如果你输了呢？"
                },
                {
                    "id": "120130532",
                    "speaker": "宵宫",
                    "text": "我输了，那我就承认我是朔次郎的共犯，任凭天领奉行发落！"
                },
                {
                    "id": "120130533",
                    "speaker": "朔次郎",
                    "text": "宵宫…"
                },
                {
                    "id": "120130534",
                    "speaker": "今谷佳祐",
                    "text": "那我接受了，一决胜负吧。"
                }
            ]
        },
        {
            "id": "1201306",
            "objective": "战胜今谷佳祐",
            "dialogues": []
        },
        {
            "id": "1201307",
            "objective": "与今谷佳祐和朔次郎交谈",
            "dialogues": [
                {
                    "id": "120130701",
                    "speaker": "义高",
                    "text": "#头儿，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}们真的很强，我们还要找更多的兄弟来支援…"
                },
                {
                    "id": "120130702",
                    "speaker": "今谷佳祐",
                    "text": "退下。"
                },
                {
                    "id": "120130703",
                    "speaker": "义高",
                    "text": "欸？"
                },
                {
                    "id": "120130704",
                    "speaker": "今谷佳祐",
                    "text": "不是让你们不要闯进来吗！都给我退下！"
                },
                {
                    "id": "120130705",
                    "speaker": "义高",
                    "text": "是、是…不好意思！"
                },
                {
                    "id": "120130706",
                    "speaker": "今谷佳祐",
                    "text": "我觉得，你这个姑娘，跟当年的朔次郎一样固执。"
                },
                {
                    "id": "120130707",
                    "speaker": "今谷佳祐",
                    "text": "你为什么觉得，我们之间一定有话要说。"
                },
                {
                    "id": "120130708",
                    "speaker": "宵宫",
                    "text": "因为，朔次郎回来，虽然没有对我讲你的故事，但他找我做了烟花。"
                },
                {
                    "id": "120130709",
                    "speaker": "宵宫",
                    "text": "从你的爸爸妈妈那里，我听到了你和朔次郎过去的故事，那时候我就知道，这烟花对你们有特殊的意义。"
                },
                {
                    "id": "120130710",
                    "speaker": "宵宫",
                    "text": "——那就绝对不是无话可说，绝对不是！"
                },
                {
                    "id": "120130711",
                    "speaker": "宵宫",
                    "text": "不是为了感受寂寞，才放烟花的啊…"
                },
                {
                    "id": "120130712",
                    "speaker": "今谷佳祐",
                    "text": "……"
                },
                {
                    "id": "120130713",
                    "speaker": "朔次郎",
                    "text": "其实，我是因为迷茫才回来的。"
                },
                {
                    "id": "120130714",
                    "speaker": "朔次郎",
                    "text": "并不是我改变了曾经的想法，而是我觉得我的做法只是在逃避现实。"
                },
                {
                    "id": "120130715",
                    "speaker": "朔次郎",
                    "text": "我见识到了蒙德的自由，璃月的契约，须弥的智慧，枫丹的正义…对我而言都有很深的感触。"
                },
                {
                    "id": "120130716",
                    "speaker": "朔次郎",
                    "text": "我庆幸我离开了稻妻，但在我庆幸之时，我偶然听说稻妻实施了锁国。"
                },
                {
                    "id": "120130717",
                    "speaker": "朔次郎",
                    "text": "我是逃离者，我因我的逃跑而骄傲，但实际上，我真正应该做的，是把这些外面的东西带回来。"
                },
                {
                    "id": "120130718",
                    "speaker": "今谷佳祐",
                    "text": "你还是天真地想要改变这里吗？"
                },
                {
                    "id": "120130719",
                    "speaker": "朔次郎",
                    "text": "不，不再是那么恢弘的想法了，我只是觉得逃走是不对的…"
                },
                {
                    "id": "120130720",
                    "speaker": "朔次郎",
                    "text": "明明你都没有逃。"
                },
                {
                    "id": "120130721",
                    "speaker": "今谷佳祐",
                    "text": "……！"
                },
                {
                    "id": "120130722",
                    "speaker": "朔次郎",
                    "text": "我过得并不好，也不知道你过得怎么样。"
                },
                {
                    "id": "120130723",
                    "speaker": "朔次郎",
                    "text": "但就像听到了命运的召唤，我想回来看看的心情，已经无法遏止了。"
                },
                {
                    "id": "120130724",
                    "speaker": "今谷佳祐",
                    "text": "…谁又过得好呢。"
                },
                {
                    "id": "120130725",
                    "speaker": "今谷佳祐",
                    "text": "我非常崇拜雷电将军，将她的一切想法都奉为教条去执行。"
                },
                {
                    "id": "120130726",
                    "speaker": "今谷佳祐",
                    "text": "但我现在的工作，就是在惩罚锁国的违逆者，收缴神之眼。我没有想过成为天领奉行众会做这样的事…"
                },
                {
                    "id": "120130727",
                    "speaker": "今谷佳祐",
                    "text": "我做的，真的就是正确的吗？"
                },
                {
                    "id": "120130728",
                    "speaker": "今谷佳祐",
                    "text": "……"
                },
                {
                    "id": "120130729",
                    "speaker": "朔次郎",
                    "text": "……"
                },
                {
                    "id": "120130730",
                    "speaker": "今谷佳祐",
                    "text": "船留给你吧。"
                },
                {
                    "id": "120130731",
                    "speaker": "朔次郎",
                    "text": "欸？"
                },
                {
                    "id": "120130732",
                    "speaker": "今谷佳祐",
                    "text": "我没法让你留在稻妻，但我不想把你抓回去。"
                },
                {
                    "id": "120130733",
                    "speaker": "朔次郎",
                    "text": "但这样你不是没办法和上面交代？"
                },
                {
                    "id": "120130734",
                    "speaker": "今谷佳祐",
                    "text": "不用管我，我有办法。"
                },
                {
                    "id": "120130735",
                    "speaker": "今谷佳祐",
                    "text": "我听说现在外面的人想回稻妻，需要办理的手续很复杂，但总归还是有办法。"
                },
                {
                    "id": "120130736",
                    "speaker": "今谷佳祐",
                    "text": "我会帮你一把的，在那之前，你在外面等着我。"
                },
                {
                    "id": "120130737",
                    "speaker": "今谷佳祐",
                    "text": "…别死在路上了。"
                },
                {
                    "id": "120130738",
                    "speaker": "朔次郎",
                    "text": "放心吧，佳祐。"
                },
                {
                    "id": "120130739",
                    "speaker": "朔次郎",
                    "text": "我还想和你一起看烟花呢。"
                },
                {
                    "id": "120130740",
                    "speaker": "今谷佳祐",
                    "text": "嗯，下次吧。"
                },
                {
                    "id": "120130741",
                    "speaker": "今谷佳祐",
                    "text": "这下子会被降职吧，唉…"
                },
                {
                    "id": "120130742",
                    "speaker": "今谷佳祐",
                    "text": "也老大不小的了，我怎么会做出这么幼稚的事。"
                },
                {
                    "id": "120130743",
                    "speaker": "Player",
                    "text": "那个船…"
                },
                {
                    "id": "120130744",
                    "speaker": "今谷佳祐",
                    "text": "就是朔次郎想用来逃跑的那一艘，之前我叫义高他们运到了这里，用的是「暂放违禁品」的说法。"
                },
                {
                    "id": "120130745",
                    "speaker": "今谷佳祐",
                    "text": "把朔次郎追到这里来，也是我早就计划好的。"
                },
                {
                    "id": "120130746",
                    "speaker": "今谷佳祐",
                    "text": "就像宵宫所说，虽然当时我没下定决心，但我的行为，已经暴露了我的愿望…"
                },
                {
                    "id": "120130747",
                    "speaker": "宵宫",
                    "text": "但我觉得你做得很正确，而且你看，只要把这些话都说出来，心中的芥蒂是能化解的啊。"
                },
                {
                    "id": "120130748",
                    "speaker": "今谷佳祐",
                    "text": "嗯，我现在也明白了，谢谢你。没想到你这么敏锐，能看穿我的想法。"
                },
                {
                    "id": "120130749",
                    "speaker": "宵宫",
                    "text": "嘿嘿，因为我和你的爸妈很熟啊，他们都是特别特别好的人，那你一定也是好人。"
                },
                {
                    "id": "120130750",
                    "speaker": "今谷佳祐",
                    "text": "早听说长野原家后继有人，虽然有点鲁莽和吵闹，但…名不虚传。"
                },
                {
                    "id": "120130751",
                    "speaker": "今谷佳祐",
                    "text": "对了，那时候的烟花，「长野原烟花店」是可以重现的吧，能为我做一个吗？"
                },
                {
                    "id": "120130752",
                    "speaker": "宵宫",
                    "text": "不行哦，没有那个纸条我是做不出来的，纸条已经被朔次郎带走了。"
                },
                {
                    "id": "120130753",
                    "speaker": "今谷佳祐",
                    "text": "原来是这样…"
                },
                {
                    "id": "120130754",
                    "speaker": "今谷佳祐",
                    "text": "那就算了吧。"
                },
                {
                    "id": "120130755",
                    "speaker": "宵宫",
                    "text": "嘿嘿，别这么沮丧，我之前说了嘛，朔次郎回来就找我做了烟花。"
                },
                {
                    "id": "120130756",
                    "speaker": "宵宫",
                    "text": "虽然不能帮你做，但是现在朔次郎已经没办法放烟花了，为了不浪费，就破例让你代替他放吧。"
                },
                {
                    "id": "120130757",
                    "speaker": "今谷佳祐",
                    "text": "…非常感谢。"
                },
                {
                    "id": "120130758",
                    "speaker": "宵宫",
                    "text": "嗯，可不要错过烟花会开始的时间了哦。"
                },
                {
                    "id": "120130759",
                    "speaker": "派蒙",
                    "text": "这件事上，宵宫表现得很强硬呢。"
                },
                {
                    "id": "120130760",
                    "speaker": "宵宫",
                    "text": "因为我喜欢说话嘛，我相信，语言拥有强大的力量。"
                },
                {
                    "id": "120130761",
                    "speaker": "宵宫",
                    "text": "不愿意沟通的话，问题就会永远留在那里。人们就看着，看着…直到眼睁睁地错过所有解决它的机会。"
                },
                {
                    "id": "120130762",
                    "speaker": "宵宫",
                    "text": "虽然朔次郎和佳祐已经没办法回到从前了，但至少…我觉得不应在心中留下懊悔。"
                },
                {
                    "id": "120130763",
                    "speaker": "宵宫",
                    "text": "好了，跟我走吧，我带你去一个最适合看烟花会的地方。"
                },
                {
                    "id": "120130764",
                    "speaker": "宵宫",
                    "text": "老爹会代替我，把答应送给你们的那个烟花，升上天空的。"
                }
            ]
        },
        {
            "id": "1201308",
            "objective": "前往观看烟花会的地方",
            "dialogues": [
                {
                    "id": "120130801",
                    "speaker": "宵宫",
                    "text": "啊，满足满足，这次的烟花会也好看得要哭出来了。"
                },
                {
                    "id": "120130802",
                    "speaker": "宵宫",
                    "text": "应该没有真的哭出来吧？我感觉眼眶湿湿的就是了。",
                    "choices": [
                        {
                            "id": "120130803",
                            "text": "我也觉得非常漂亮。",
                            "response": [
                                {
                                    "id": "120130805",
                                    "speaker": "宵宫",
                                    "text": "对了，你看到第一枚升空的，那颗金色的大烟花了吗？"
                                },
                                {
                                    "id": "120130806",
                                    "speaker": "宵宫",
                                    "text": "那就是我拜托老爹为你们做的。"
                                },
                                {
                                    "id": "120130807",
                                    "speaker": "派蒙",
                                    "text": "哦哦，感觉很有气势，印象深刻！"
                                },
                                {
                                    "id": "120130808",
                                    "speaker": "宵宫",
                                    "text": "哈哈，那就对了，那枚烟花我希望你们看过之后的感觉，就是印象深刻。"
                                },
                                {
                                    "id": "120130809",
                                    "speaker": "宵宫",
                                    "text": "无论走了多远，遇到了什么，觉得动摇了，或者累了，至少还能想起今天的烟花。"
                                },
                                {
                                    "id": "120130810",
                                    "speaker": "宵宫",
                                    "text": "我相信在时间的沉淀之后，这枚烟花在你们的心里，会变得越来越漂亮的。"
                                },
                                {
                                    "id": "120130811",
                                    "speaker": "宵宫",
                                    "text": "对了，这样的话你们就是我的客人了，来，纸条也收好，想再看这金色大烟花，就尽管来找我好了。",
                                    "choices": [
                                        {
                                            "id": "120130812",
                                            "text": "谢谢你的烟花。",
                                            "response": [
                                                {
                                                    "id": "120130814",
                                                    "speaker": "派蒙",
                                                    "text": "不过，在看烟花的时候，宵宫你好像变了一个人，什么也不说，也好像什么都听不到了。"
                                                },
                                                {
                                                    "id": "120130815",
                                                    "speaker": "宵宫",
                                                    "text": "那个嘛，其实听到了，只是看烟花的时候，我从来不说话，这是我的习惯。"
                                                },
                                                {
                                                    "id": "120130816",
                                                    "speaker": "宵宫",
                                                    "text": "自己做出来的东西，安静地目送它升空，是一件有仪式感而又神圣的事。"
                                                },
                                                {
                                                    "id": "120130817",
                                                    "speaker": "宵宫",
                                                    "text": "你刚刚问我，对我来说烟花是什么，对吧？"
                                                },
                                                {
                                                    "id": "120130818",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯。"
                                                },
                                                {
                                                    "id": "120130819",
                                                    "speaker": "派蒙",
                                                    "text": "对准备船的耕一来说，他和三姐好像是要纪念友谊。"
                                                },
                                                {
                                                    "id": "120130820",
                                                    "speaker": "派蒙",
                                                    "text": "对佳祐的爸爸妈妈来说，他们纪念的是婚姻。"
                                                },
                                                {
                                                    "id": "120130821",
                                                    "speaker": "派蒙",
                                                    "text": "而佳祐和朔次郎，他们要纪念的，嗯…"
                                                },
                                                {
                                                    "id": "120130822",
                                                    "speaker": "Player",
                                                    "text": "是不曾改变的信念吧。"
                                                },
                                                {
                                                    "id": "120130823",
                                                    "speaker": "派蒙",
                                                    "text": "对对对，信念！"
                                                },
                                                {
                                                    "id": "120130824",
                                                    "speaker": "宵宫",
                                                    "text": "对我来说呢…"
                                                },
                                                {
                                                    "id": "120130825",
                                                    "speaker": "宵宫",
                                                    "text": "嘿嘿，老实说，我从来没想过，我不知道。"
                                                },
                                                {
                                                    "id": "120130826",
                                                    "speaker": "派蒙",
                                                    "text": "欸？我还以为能听到很震撼的答案呢。"
                                                },
                                                {
                                                    "id": "120130827",
                                                    "speaker": "宵宫",
                                                    "text": "因为其实没什么人会问我这个，我也不觉得这是件很了不起的事。"
                                                },
                                                {
                                                    "id": "120130828",
                                                    "speaker": "宵宫",
                                                    "text": "我只是碰巧生在了长野原家，碰巧在老爹的教导下学了这门手艺。"
                                                },
                                                {
                                                    "id": "120130829",
                                                    "speaker": "宵宫",
                                                    "text": "碰巧认识了很多人，听说了很多事，知道他们都把心中珍视之物寄托在了烟花里。"
                                                },
                                                {
                                                    "id": "120130830",
                                                    "speaker": "宵宫",
                                                    "text": "烟花一瞬间就消失了，那是和将军想要的永恒距离最远的东西。"
                                                },
                                                {
                                                    "id": "120130831",
                                                    "speaker": "宵宫",
                                                    "text": "但大家的寄托可不会消失，那才是烟花存在的理由。如果没有人想看烟花，那就没有烟花了。"
                                                },
                                                {
                                                    "id": "120130832",
                                                    "speaker": "Player",
                                                    "text": "这也是一种永恒吧。"
                                                },
                                                {
                                                    "id": "120130833",
                                                    "speaker": "宵宫",
                                                    "text": "但也要这么想，正是因为有这么多的人把思念寄托在烟花里，长野原才必须存在。"
                                                },
                                                {
                                                    "id": "120130834",
                                                    "speaker": "宵宫",
                                                    "text": "不然，不是辜负了他们的心意吗？"
                                                },
                                                {
                                                    "id": "120130835",
                                                    "speaker": "宵宫",
                                                    "text": "#你知道吗，{NICKNAME}，虽然我不怎么会去考虑复杂的事——"
                                                },
                                                {
                                                    "id": "120130836",
                                                    "speaker": "宵宫",
                                                    "text": "但能生在长野原家，能做好多好多好多漂亮的烟花，我是非常自豪的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120130813",
                                            "text": "谢谢你的祝福。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120130804",
                            "text": "长野原果然名不虚传。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1201309",
            "objective": "与宵宫交谈",
            "dialogues": []
        },
        {
            "id": "1201209",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120120901",
                    "speaker": "今谷三郎",
                    "text": "对不起啊，没能帮上你们的忙。"
                },
                {
                    "id": "120120902",
                    "speaker": "今谷香里",
                    "text": "不过，那个孩子，总要学会面对他的心事。"
                },
                {
                    "id": "120120903",
                    "speaker": "今谷香里",
                    "text": "这是作父母的，没办法教他的东西啊。"
                }
            ]
        },
        {
            "id": "1201309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120130901",
                    "speaker": "长野原龙之介",
                    "text": "朔次郎他，恐怕是凶多吉少了。"
                },
                {
                    "id": "120130902",
                    "speaker": "长野原龙之介",
                    "text": "有什么办法能帮到他呢…"
                }
            ]
        },
        {
            "id": "1201399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120139901",
                    "speaker": "宵宫",
                    "text": "哎，是松坂他们！问问看吧！"
                },
                {
                    "id": "120139902",
                    "speaker": "宵宫",
                    "text": "看来就是这个方向没错了，我们继续追吧！"
                },
                {
                    "id": "120139903",
                    "speaker": "宵宫",
                    "text": "如果朔次郎还是没有下定决心，我就不得不帮忙了…"
                },
                {
                    "id": "120139904",
                    "speaker": "宵宫",
                    "text": "看，那边有天领奉行的人，应该就是那里！"
                }
            ]
        }
    ]
}