    "talks": [
        {
            "id": "7514502",
            "objective": "(test)接取环$HIDDEN",
            "dialogues": [
                {
                    "id": "751450201",
                    "speaker": "派蒙",
                    "text": "受龙所选者…啊，受龙所选者啊…"
                },
                {
                    "id": "751450202",
                    "speaker": "派蒙",
                    "text": "圣山就在汝之身前…如若…就须清除…阴影之敌。"
                },
                {
                    "id": "751450203",
                    "speaker": "派蒙",
                    "text": "啊，受龙所选者…进入…进入圣山吧…"
                },
                {
                    "id": "751450204",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…"
                },
                {
                    "id": "751450205",
                    "speaker": "Player",
                    "text": "刚才…火山喷发了…？"
                },
                {
                    "id": "751450206",
                    "speaker": "派蒙",
                    "text": "没有哦，刚才火山非常安静…你们看到火山喷发了吗？"
                },
                {
                    "id": "751450207",
                    "speaker": "派蒙",
                    "text": "#怎么了，{NICKNAME}，还有{REALNAME[ID(2)|SHOWHOST(true)]}，怎么一副沉思的样子…"
                },
                {
                    "id": "751450208",
                    "speaker": "派蒙",
                    "text": "简直就像是侦探小说里突然想到了事件真相的侦探一样…",
                    "choices": [
                        {
                            "id": "751450209",
                            "text": "看到的是别的「真相」…",
                            "response": [
                                {
                                    "id": "751450210",
                                    "speaker": "Player",
                                    "text": "（向派蒙说明了所看到的…）"
                                },
                                {
                                    "id": "751450211",
                                    "speaker": "派蒙",
                                    "text": "#啊，你是说，看到了和刚进入纳塔遇到{REALNAME[ID(2)|SHOWHOST(true)]}时看到的相同的东西…"
                                },
                                {
                                    "id": "751450218",
                                    "speaker": "派蒙",
                                    "text": "还有一些奇怪的影像吗？"
                                },
                                {
                                    "id": "751450219",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "751450220",
                                    "speaker": "派蒙",
                                    "text": "#在那个时候{NICKNAME}就说看到了奇怪的话…唔，我没看到所以不知道啦，感觉上，像是一个人说的吗？"
                                },
                                {
                                    "id": "751450221",
                                    "speaker": "Player",
                                    "text": "应该是同一个人…"
                                },
                                {
                                    "id": "751450222",
                                    "speaker": "派蒙",
                                    "text": "唔，感觉有点奇怪呢…不过，这次你们还看到…巨大的遗迹，破碎的城市，深渊…"
                                },
                                {
                                    "id": "751450223",
                                    "speaker": "派蒙",
                                    "text": "还有「圣山」…唔，纳塔人好像也称那座火山为「圣山」，难道说，你们看到的东西和那座火山有关？"
                                },
                                {
                                    "id": "751450224",
                                    "speaker": "派蒙",
                                    "text": "#总觉得那个把{REALNAME[ID(2)|SHOWHOST(true)]}交到我们手上的人好像很想让我们「进入圣山」的样子…"
                                },
                                {
                                    "id": "751450225",
                                    "speaker": "派蒙",
                                    "text": "到了圣山里以后，是不是就可以解开小家伙身上的那个什么「焰主之祝」了…"
                                },
                                {
                                    "id": "751450226",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751450227",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，为了{REALNAME[ID(2)|SHOWHOST(true)]}能够健康长大！之后我们就去那个「圣山」看看吧。"
                                },
                                {
                                    "id": "751450228",
                                    "speaker": "派蒙",
                                    "text": "对了，纳塔六个部族中的「沃陆之邦」好像就在火山的一侧，说不定可以在那里打探到消息呢！"
                                }
                            ]
                        },
                        {
                            "id": "751450212",
                            "text": "蛋糕杀人的凶手…就是派蒙你！",
                            "response": [
                                {
                                    "id": "751450213",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751450214",
                                    "speaker": "派蒙",
                                    "text": "可恶，怎么会，明明我偷吃小蛋糕小姐的时候没有被任何人看到…才怪啦，我偷吃的是火焰炖肉。"
                                },
                                {
                                    "id": "751450215",
                                    "speaker": "派蒙",
                                    "text": "所以你…不对，你们刚才看到了什么呀？"
                                },
                                {
                                    "id": "751450216",
                                    "speaker": "Player",
                                    "text": "（向派蒙说明了所看到的…）"
                                },
                                {
                                    "id": "751450217",
                                    "speaker": "派蒙",
                                    "text": "又看到了奇怪的话…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
