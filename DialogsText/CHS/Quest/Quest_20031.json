            }
        ],
        "rewards_formatted": "冒险阅历 x100, 原石 x20, 冒险家的经验 x2",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 59,
        "total_speaker_counts": {
            "Player": 9,
            "凯瑟琳": 47,
            "派蒙": 3
        }
    },
    "talks": [
        {
            "id": "2003101",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "200310101",
                    "speaker": "凯瑟琳",
                    "text": "我们又见面了，冒险家新星。"
                },
                {
                    "id": "200310102",
                    "speaker": "凯瑟琳",
                    "text": "怎么样，最近的冒险还顺利吗？",
                    "choices": [
                        {
                            "id": "200310103",
                            "text": "很顺利。",
                            "response": [
                                {
                                    "id": "200310104",
                                    "speaker": "凯瑟琳",
                                    "text": "很不错的气势，记得一直保持下去哦。"
                                },
                                {
                                    "id": "200310107",
                                    "speaker": "凯瑟琳",
                                    "text": "看起来你已经积累了很多的阅历，是时候介绍给你冒险家协会的重要工作了。"
                                },
                                {
                                    "id": "200310108",
                                    "speaker": "凯瑟琳",
                                    "text": "冒险家协会每天都会收到来自各处的<color=#00E1FFFF>委托</color>，并负责整理发放给各位冒险家。"
                                },
                                {
                                    "id": "200310109",
                                    "speaker": "凯瑟琳",
                                    "text": "这也是冒险家们最主要的报酬来源。"
                                },
                                {
                                    "id": "200310110",
                                    "speaker": "派蒙",
                                    "text": "都是什么样的委托？"
                                },
                                {
                                    "id": "200310111",
                                    "speaker": "凯瑟琳",
                                    "text": "什么类型都可能有，从帮助居民到清理怪物，有琐碎的也有很危险的。"
                                },
                                {
                                    "id": "200310112",
                                    "speaker": "凯瑟琳",
                                    "text": "俗话说百闻不如一见，还是亲自上手做一做更容易理解。"
                                },
                                {
                                    "id": "200310113",
                                    "speaker": "凯瑟琳",
                                    "text": "这里就是今天的委托内容。"
                                },
                                {
                                    "id": "200310114",
                                    "speaker": "凯瑟琳",
                                    "text": "麻烦完成之后来向我报告一下，我会提供一份丰厚的奖励的。",
                                    "choices": [
                                        {
                                            "id": "200310115",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "200310116",
                                                    "speaker": "凯瑟琳",
                                                    "text": "#不愧是{NICKNAME}，很可靠呢。"
                                                },
                                                {
                                                    "id": "200310119",
                                                    "speaker": "凯瑟琳",
                                                    "text": "#那我就在这里等你的好消息，{NICKNAME}，向着星辰与深渊！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200310117",
                                            "text": "有多丰厚？",
                                            "response": [
                                                {
                                                    "id": "200310118",
                                                    "speaker": "凯瑟琳",
                                                    "text": "别那么心急，保留一下期待吧，不会让你失望的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200310105",
                            "text": "有点吃力。",
                            "response": [
                                {
                                    "id": "200310106",
                                    "speaker": "凯瑟琳",
                                    "text": "刚开始是会这样的，在冒险前做好准备会让你轻松不少。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003102",
            "objective": "(test)与凯瑟琳对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2003103",
            "objective": "(test)完成委托$HIDDEN",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "id": "2003104",
            "objective": "(test)与凯瑟琳对话$HIDDEN",
            "dialogues": [
                {
                    "id": "200310301",
                    "speaker": "派蒙",
                    "text": "嘿嘿，那我们就不客气地收下了。"
                },
                {
                    "id": "200310302",
                    "speaker": "凯瑟琳",
                    "text": "尽管收下，这是冒险家协会表示感谢的方式。"
                },
                {
                    "id": "200310303",
                    "speaker": "凯瑟琳",
                    "text": "因为每天协会都会收到很多委托，如果不是各位冒险家鼎力相助，是肯定没办法完成的。"
                },
                {
                    "id": "200310304",
                    "speaker": "凯瑟琳",
                    "text": "当你每天完成足够数量的委托，就可以到我这里领取一份额外的礼物。"
                },
                {
                    "id": "200310305",
                    "speaker": "凯瑟琳",
                    "text": "「冒险之证」里会记录今天已经完成过的数量。"
                },
                {
                    "id": "200310306",
                    "speaker": "凯瑟琳",
                    "text": "一定记得要当天过来领取礼物，因为数量有限，错过了是没办法补发的。",
                    "choices": [
                        {
                            "id": "200310307",
                            "text": "明白了，谢谢你。",
                            "response": [
                                {
                                    "id": "200310308",
                                    "speaker": "凯瑟琳",
                                    "text": "不用客气，是应该谢谢你。"
                                },
                                {
                                    "id": "200310312",
                                    "speaker": "凯瑟琳",
                                    "text": "对了，如果你帮助你的冒险伙伴完成委托，同样会计算在领取礼物的数量之内。"
                                },
                                {
                                    "id": "200310313",
                                    "speaker": "凯瑟琳",
                                    "text": "也请多多与你的伙伴相互合作吧！向着星辰与深渊！"
                                }
                            ]
                        },
                        {
                            "id": "200310309",
                            "text": "一天只有一份吗？",
                            "response": [
                                {
                                    "id": "200310310",
                                    "speaker": "凯瑟琳",
                                    "text": "现在的话是这样的…很抱歉。"
                                },
                                {
                                    "id": "200310311",
                                    "speaker": "凯瑟琳",
                                    "text": "不过也请放心，关于冒险家们的报酬，我们一直都在和总部争取。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
