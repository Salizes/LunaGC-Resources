        },
        {
            "id": "2003107",
            "objective": "完成4个每日委托后与凯瑟琳对话",
            "dialogues": []
        },
        {
            "id": "2003102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200310201",
                    "speaker": "凯瑟琳",
                    "text": "#完成得很好，{NICKNAME}，作为第一次来说相当出色了。"
                },
                {
                    "id": "200310202",
                    "speaker": "凯瑟琳",
                    "text": "委托人都让我帮忙感谢你呢。"
                },
                {
                    "id": "200310203",
                    "speaker": "凯瑟琳",
                    "text": "那么现在该我履行之前的约定了。"
                }
            ]
        },
        {
            "id": "2003104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200310401",
                    "speaker": "凯瑟琳",
                    "text": "#我听说了哦，{NICKNAME}。"
                },
                {
                    "id": "200310402",
                    "speaker": "凯瑟琳",
                    "text": "你已经完成了冒险家协会承接的<color=#00E1FFFF>委托</color>，委托人都让我向你道谢呢。"
                },
                {
                    "id": "200310403",
                    "speaker": "凯瑟琳",
                    "text": "委托？没什么印象。"
                },
                {
                    "id": "200310404",
                    "speaker": "凯瑟琳",
                    "text": "就是你在路上遇到的需要你帮忙的事。"
                },
                {
                    "id": "200310405",
                    "speaker": "凯瑟琳",
                    "text": "他们其实都是在协会发布了委托的。"
                },
                {
                    "id": "200310408",
                    "speaker": "凯瑟琳",
                    "text": "总之，还是和你简单介绍下吧。"
                },
                {
                    "id": "200310409",
                    "speaker": "凯瑟琳",
                    "text": "冒险家协会每天都会收到来自各处的委托，并负责整理发放给各位冒险家。"
                },
                {
                    "id": "200310410",
                    "speaker": "凯瑟琳",
                    "text": "这也是冒险家们最主要的报酬来源。"
                },
                {
                    "id": "200310411",
                    "speaker": "凯瑟琳",
                    "text": "说到报酬，就不得不提到协会为你准备的一个惊喜。"
                }
            ]
        }
    ]
}