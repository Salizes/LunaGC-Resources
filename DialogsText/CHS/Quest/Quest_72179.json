                {
                    "id": "721790101",
                    "speaker": "简朴的墓碑",
                    "text": "（由军人之手简单削凿而成、静静伫立的石碑，简朴却庄重）"
                },
                {
                    "id": "721790102",
                    "speaker": "简朴的墓碑",
                    "text": "「长野重秀，阿初」"
                },
                {
                    "id": "721790103",
                    "speaker": "简朴的墓碑",
                    "text": "「在此地与恋人作别，在此处与恋人重聚。」"
                },
                {
                    "id": "721790104",
                    "speaker": "派蒙",
                    "text": "唔…似乎是战死者的墓碑呢。"
                },
                {
                    "id": "721790105",
                    "speaker": "派蒙",
                    "text": "孤零零地太可怜了…我们在墓前放些鲜花吧？"
                },
                {
                    "id": "721790106",
                    "speaker": "Player",
                    "text": "（放置血斛）"
                }
            ]
        },
