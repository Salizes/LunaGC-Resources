    "talks": [
        {
            "id": "1110009",
            "objective": "在望舒客栈附近查看",
            "dialogues": []
        },
        {
            "id": "1110001",
            "objective": "(test)在望舒客栈附近查看$HIDDEN",
            "dialogues": [
                {
                    "id": "111000101",
                    "speaker": "派蒙",
                    "text": "#是我的幻觉吗，{NICKNAME}…那些丘丘人是不是看起来有些古怪？",
                    "choices": [
                        {
                            "id": "111000102",
                            "text": "身体上散发着…邪气？",
                            "response": [
                                {
                                    "id": "111000103",
                                    "speaker": "派蒙",
                                    "text": "是呀，以前见过的丘丘人，虽然是魔物，但从来没有这样的…"
                                },
                                {
                                    "id": "111000106",
                                    "speaker": "派蒙",
                                    "text": "啊！「望舒客栈」就在附近，会威胁到来往的客人吧？"
                                },
                                {
                                    "id": "111000107",
                                    "speaker": "派蒙",
                                    "text": "#见到了又不管的话，总觉得会良心不安…试试看对付它们吧，{NICKNAME}！"
                                }
                            ]
                        },
                        {
                            "id": "111000104",
                            "text": "有些躁动的样子。",
                            "response": [
                                {
                                    "id": "111000105",
                                    "speaker": "派蒙",
                                    "text": "是呀，难道和它们身上那种奇怪的黑气有关系？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110002",
            "objective": "消灭沾染「邪气」的丘丘人",
            "dialogues": []
        },
        {
            "id": "1110003",
            "objective": "(test)战斗后对话$HIDDEN",
            "dialogues": [
                {
                    "id": "111000301",
                    "speaker": "派蒙",
                    "text": "这些满身邪气的家伙，确实比一般的丘丘人要难对付一些呢。"
                },
                {
                    "id": "111000302",
                    "speaker": "派蒙",
                    "text": "咦，你看那边，聚集了一些人的样子…"
                },
                {
                    "id": "111000303",
                    "speaker": "派蒙",
                    "text": "呜哇…你看到那个戴着面具的人了吗？他那边的丘丘人都害怕得跑掉了…",
                    "choices": [
                        {
                            "id": "111000304",
                            "text": "莫非他是「仙人」…",
                            "response": [
                                {
                                    "id": "111000306",
                                    "speaker": "派蒙",
                                    "text": "你是说像魈那样的仙人吗？这么说确实…魈也戴过差不多的面具。"
                                },
                                {
                                    "id": "111000307",
                                    "speaker": "派蒙",
                                    "text": "看他刚才「作法」，好像比魈更有仙人的样子呢。不如去跟他聊聊吧？"
                                }
                            ]
                        },
                        {
                            "id": "111000305",
                            "text": "看起来像是「仙家法术」…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110010",
            "objective": "与戴着面具的男子对话",
            "dialogues": [
                {
                    "id": "111001001",
                    "speaker": "派蒙",
                    "text": "你好！我们是…"
                },
                {
                    "id": "111001002",
                    "speaker": "？？？",
                    "text": "欸。道谢的话就不必了，除魔济世是仙家本分，不足挂齿，不足挂齿…"
                },
                {
                    "id": "111001003",
                    "speaker": "？？？",
                    "text": "哦？你们好像是没见过的面孔，本仙还以为是「信众」呢。",
                    "choices": [
                        {
                            "id": "111001004",
                            "text": "我们是路过的旅行者。",
                            "response": [
                                {
                                    "id": "111001005",
                                    "speaker": "派蒙",
                                    "text": "#我叫派蒙！这位是我的旅伴{NICKNAME}。"
                                },
                                {
                                    "id": "111001006",
                                    "speaker": "？？？",
                                    "text": "原来如此，那本仙也当介绍一下自己，才合礼数。"
                                },
                                {
                                    "id": "111001010",
                                    "speaker": "？？？",
                                    "text": "咳咳…本仙乃是「掇星攫辰天君」，也即是信众们口中的「星辰天君」。"
                                },
                                {
                                    "id": "111001011",
                                    "speaker": "掇星攫辰天君",
                                    "text": "此番本仙下山济世，相逢有缘，若二位有什么心愿，无妨说与我听。"
                                },
                                {
                                    "id": "111001012",
                                    "speaker": "派蒙",
                                    "text": "心愿？天君你…还能帮人实现愿望的吗？我本来以为璃月的仙人都只是打架厉害…"
                                },
                                {
                                    "id": "111001013",
                                    "speaker": "掇星攫辰天君",
                                    "text": "呵呵，毕竟「天君」比「真君」在仙位上高一阶。"
                                },
                                {
                                    "id": "111001014",
                                    "speaker": "掇星攫辰天君",
                                    "text": "鼓吹自己的神通并非本仙作风，二位不如与几位信众聊聊，再做评判。"
                                }
                            ]
                        },
                        {
                            "id": "111001007",
                            "text": "我们也是追寻仙家之道的人。",
                            "response": [
                                {
                                    "id": "111001008",
                                    "speaker": "派蒙",
                                    "text": "#我叫派蒙！这位是我的旅伴{NICKNAME}。"
                                },
                                {
                                    "id": "111001009",
                                    "speaker": "？？？",
                                    "text": "原来是同道中人，那本仙也当介绍一下自己，才合礼数。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110004",
            "objective": "与「信众」们交谈，了解「掇星攫辰天君」",
            "dialogues": [
                {
                    "id": "111000401",
                    "speaker": "男性信众",
                    "text": "看到「星辰天君」作法了吗？真是神通广大！"
                },
                {
                    "id": "111000402",
                    "speaker": "男性信众",
                    "text": "家父的病想必也有指望了吧…"
                },
                {
                    "id": "111000403",
                    "speaker": "Player",
                    "text": "关于「星辰天君」…"
                },
                {
                    "id": "111000404",
                    "speaker": "男性信众",
                    "text": "见到那样的法术还有什么好怀疑的，当然是真真正正的仙人。"
                },
                {
                    "id": "111000405",
                    "speaker": "男性信众",
                    "text": "我之前替卧床的老父求了个药方，跟「不卜庐」的方子天差地别。"
                },
                {
                    "id": "111000406",
                    "speaker": "男性信众",
                    "text": "药熬出来还飘着一股淡淡的雾气，仙得很！虽然也可能是加了冰雾花的缘故…"
                },
                {
                    "id": "111000407",
                    "speaker": "男性信众",
                    "text": "仙家药方实在了得，家父的病一定会好起来的…"
                },
                {
                    "id": "111000408",
                    "speaker": "男性信众",
                    "text": "至于那些献给「星辰天君」作为贡品的古董，跟家父的性命比起来根本不值一提…对吧？"
                }
            ]
        },
        {
            "id": "1110005",
            "objective": "与「信众」们交谈，了解「掇星攫辰天君」",
            "dialogues": [
                {
                    "id": "111000501",
                    "speaker": "女性信众",
                    "text": "总觉得现在每天过得充满了希望…"
                },
                {
                    "id": "111000502",
                    "speaker": "Player",
                    "text": "关于「星辰天君」…"
                },
                {
                    "id": "111000503",
                    "speaker": "女性信众",
                    "text": "你们也是「星辰天君」的「信众」吧？"
                },
                {
                    "id": "111000504",
                    "speaker": "女性信众",
                    "text": "自从我的未婚夫不告而别，我每天以泪洗面…"
                },
                {
                    "id": "111000505",
                    "speaker": "女性信众",
                    "text": "后来尝试了「星辰天君」的仙法——把他的画像烧掉，再把灰烬在日出时刻吹向大海…"
                },
                {
                    "id": "111000506",
                    "speaker": "女性信众",
                    "text": "冥冥之中，我真的感觉到他要回来了，是真的！绝对不是什么心理作用…"
                },
                {
                    "id": "111000507",
                    "speaker": "女性信众",
                    "text": "于是我开开心心地把嫁妆献给了「星辰天君」。毕竟若不是他帮我找回夫君，这嫁妆可能一辈子也用不到了…"
                }
            ]
        },
        {
            "id": "1110006",
            "objective": "与「信众」们交谈，了解「掇星攫辰天君」",
            "dialogues": [
                {
                    "id": "111000601",
                    "speaker": "商人信众",
                    "text": "有「星辰天君」在，千岩军都可以下岗了吧？"
                },
                {
                    "id": "111000602",
                    "speaker": "Player",
                    "text": "关于「星辰天君」…"
                },
                {
                    "id": "111000603",
                    "speaker": "商人信众",
                    "text": "我是个商人，上一批货物实在太值钱了，便冒昧拜托「星辰天君」同行。"
                },
                {
                    "id": "111000604",
                    "speaker": "商人信众",
                    "text": "只见天君祭出符咒，魔物全都退避三舍，一路上连个影儿都没见着。"
                },
                {
                    "id": "111000605",
                    "speaker": "商人信众",
                    "text": "虽说费用方面确实贵了点…但毕竟「请仙」是件大事嘛，也不知道你们外国人能不能负担得起…"
                }
            ]
        },
        {
            "id": "1110007",
            "objective": "完成细节探听$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1110011",
            "objective": "(test)完成细节探听$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1110008",
            "objective": "与「掇星攫辰天君」对话",
            "dialogues": [
                {
                    "id": "111000801",
                    "speaker": "掇星攫辰天君",
                    "text": "如何？信众们可能有些言过其实，但都是肺腑之言。"
                },
                {
                    "id": "111000802",
                    "speaker": "Player",
                    "text": "感觉都是心理作用…"
                },
                {
                    "id": "111000803",
                    "speaker": "掇星攫辰天君",
                    "text": "哈哈哈…阁下说笑了。有位仙家高人，薛无量，人称「量子」，他曾经说过——"
                },
                {
                    "id": "111000804",
                    "speaker": "掇星攫辰天君",
                    "text": "「万物本是纠缠在一起，『心理作用』亦是一种『魂魄』与『事物结局』相连接的因缘…」"
                },
                {
                    "id": "111000805",
                    "speaker": "掇星攫辰天君",
                    "text": "也就是说他们的愿望都已经走上了通往实现的正轨，这样讲明白了么？"
                },
                {
                    "id": "111000806",
                    "speaker": "派蒙",
                    "text": "完全听不明白…但总之他们的愿望都能实现是吧。"
                },
                {
                    "id": "111000807",
                    "speaker": "掇星攫辰天君",
                    "text": "没错，这位小友悟性很高。"
                },
                {
                    "id": "111000808",
                    "speaker": "派蒙",
                    "text": "说起来…还有一个问题…"
                },
                {
                    "id": "111000809",
                    "speaker": "掇星攫辰天君",
                    "text": "嗯？但说无妨。",
                    "choices": [
                        {
                            "id": "111000810",
                            "text": "你为什么戴着面具？",
                            "response": [
                                {
                                    "id": "111000814",
                                    "speaker": "掇星攫辰天君",
                                    "text": "本仙…游历民间，济世行善。不露真容，只为少生事端而已。"
                                },
                                {
                                    "id": "111000815",
                                    "speaker": "派蒙",
                                    "text": "原来如此，原来如此。"
                                },
                                {
                                    "id": "111000816",
                                    "speaker": "掇星攫辰天君",
                                    "text": "那么二位的愿望是什么？",
                                    "choices": [
                                        {
                                            "id": "111000817",
                                            "text": "想获知亲人的行踪。",
                                            "response": [
                                                {
                                                    "id": "111000818",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "嗯…这背后一定有段悲伤的往事吧。"
                                                },
                                                {
                                                    "id": "111000824",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "…好吧，想要实现这个愿望也不是不可以…"
                                                },
                                                {
                                                    "id": "111000825",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "只是…还差了那么点意思。"
                                                },
                                                {
                                                    "id": "111000826",
                                                    "speaker": "派蒙",
                                                    "text": "差了点…意思？"
                                                },
                                                {
                                                    "id": "111000827",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "仙道但凭「悟性」，若二位参不透我话中之意，那就恕本仙难以相助了。"
                                                },
                                                {
                                                    "id": "111000828",
                                                    "speaker": "派蒙",
                                                    "text": "怎么办，我还是不明白他说的意思呀？",
                                                    "choices": [
                                                        {
                                                            "id": "111000829",
                                                            "text": "看来是需要给一些好处…",
                                                            "response": [
                                                                {
                                                                    "id": "111000831",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦！刚才那些信众们好像也提起过，请仙人帮忙要付出不小的代价…"
                                                                },
                                                                {
                                                                    "id": "111000832",
                                                                    "speaker": "派蒙",
                                                                    "text": "可我们两个身上，也没什么值钱的东西。"
                                                                },
                                                                {
                                                                    "id": "111000833",
                                                                    "speaker": "派蒙",
                                                                    "text": "甚至，你连「神之眼」都没有…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "111000834",
                                                                            "text": "应该不会有人把神之眼卖掉吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "111000836",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸！不如我们做些好吃的给他？没人能抵挡美食的诱惑吧？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "111000837",
                                                                                            "text": "在派蒙的价值观里确实是这样…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "111000839",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "嗯，好吃的！这个办法肯定能成功的，嘿嘿。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "111000840",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "不如我们赶快出发，去「万文集舍」看看有没有什么最新最好的流行菜谱吧？"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "111000838",
                                                                                            "text": "好吃的！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "111000835",
                                                                            "text": "是啊，真可惜…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "111000830",
                                                            "text": "看来是要给他摩拉…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111000821",
                                            "text": "想要一夜暴富！",
                                            "response": [
                                                {
                                                    "id": "111000822",
                                                    "speaker": "派蒙",
                                                    "text": "#欸欸！你不管你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}了吗！"
                                                },
                                                {
                                                    "id": "111000823",
                                                    "speaker": "掇星攫辰天君",
                                                    "text": "嗯，人之常情。你看上去并非璃月人，却好像沾染了不少璃月的铜臭气。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111000811",
                            "text": "可以把面具摘下来看看吗？",
                            "response": [
                                {
                                    "id": "111000812",
                                    "speaker": "派蒙",
                                    "text": "喂！是不是太不礼貌啦？"
                                },
                                {
                                    "id": "111000813",
                                    "speaker": "掇星攫辰天君",
                                    "text": "呵呵，确实有所不便。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1110023",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111002301",
                    "speaker": "掇星攫辰天君",
                    "text": "随意和他们聊聊吧，本仙从不自吹自擂，是非都留给他人评判。"
                }
            ]
        }
    ]
