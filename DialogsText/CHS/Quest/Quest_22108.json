{
    "quest": {
        "id": "22108",
        "title": "试问，藏锋何处？",
        "description": "岚姐正在寻找一把剑，但却始终没有收获，她决定扩大搜索范围…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 26,
        "total_speaker_counts": {
            "Player": 5,
            "岚姐": 21
        }
    },
    "talks": [
        {
            "id": "2210801",
            "objective": "与岚姐对话",
            "dialogues": [
                {
                    "id": "221080101",
                    "speaker": "岚姐",
                    "text": "这一次也没找到，线索已经快没了…"
                },
                {
                    "id": "221080102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221080103",
                    "speaker": "岚姐",
                    "text": "你是谁？如果要了解协会的事，你去找旁边的凯瑟琳吧。"
                },
                {
                    "id": "221080104",
                    "speaker": "岚姐",
                    "text": "你已经是冒险家了吗，抱歉，虽然是分会长，但我不太关心协会的事。"
                },
                {
                    "id": "221080105",
                    "speaker": "岚姐",
                    "text": "所以，新人我也不太认识…不过看你这副样子，是对冒险已经有点心得了？"
                },
                {
                    "id": "221080106",
                    "speaker": "岚姐",
                    "text": "那么就帮我个忙吧，怎么样？但是先说好，这并不是协会的任务，而是我个人的委托。",
                    "choices": [
                        {
                            "id": "221080107",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "221080109",
                                    "speaker": "岚姐",
                                    "text": "真爽快，不过连情况都不问就接下委托，可不太明智。"
                                },
                                {
                                    "id": "221080111",
                                    "speaker": "岚姐",
                                    "text": "关于委托，我想请你去消灭两只举着巨盾的强壮丘丘人。"
                                },
                                {
                                    "id": "221080112",
                                    "speaker": "岚姐",
                                    "text": "它们的盾牌上，有着「岩」属性的力量，虽然不算太危险，但也要小心应付。"
                                },
                                {
                                    "id": "221080113",
                                    "speaker": "岚姐",
                                    "text": "你要做的就是消灭它们。消灭了之后，再回来找我，我会付你合适的报酬。"
                                },
                                {
                                    "id": "221080114",
                                    "speaker": "岚姐",
                                    "text": "对了，如果发现了有什么和「剑」有关的东西，就带回来给我。"
                                },
                                {
                                    "id": "221080115",
                                    "speaker": "岚姐",
                                    "text": "如果没发现也没关系，只要消灭了丘丘人，我就会付给你正常的报酬，你就放心准备去吧。"
                                }
                            ]
                        },
                        {
                            "id": "221080108",
                            "text": "是什么委托？",
                            "response": [
                                {
                                    "id": "221080110",
                                    "speaker": "岚姐",
                                    "text": "你还真谨慎，是之前踩过什么坑吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210802",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "221080201",
                    "speaker": "岚姐",
                    "text": "你消灭它们了吗？"
                },
                {
                    "id": "221080202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "221080203",
                    "speaker": "岚姐",
                    "text": "不用心急，心急的冒险家，只会将自己陷入困境。"
                },
                {
                    "id": "221080204",
                    "speaker": "岚姐",
                    "text": "但也别太慢慢吞吞了，因为你的报酬也和时间挂钩。"
                }
            ]
        },
        {
            "id": "2210803",
            "objective": "向岚姐回报",
            "dialogues": [
                {
                    "id": "221080301",
                    "speaker": "岚姐",
                    "text": "你消灭它们了吗？"
                },
                {
                    "id": "221080302",
                    "speaker": "Player",
                    "text": "已经全部消灭了。"
                },
                {
                    "id": "221080303",
                    "speaker": "岚姐",
                    "text": "不错，你做事还挺利索的，也算是有个冒险家的样子了。"
                },
                {
                    "id": "221080304",
                    "speaker": "岚姐",
                    "text": "这是你的报酬，辛苦你了，消灭了它们，周围也会安宁许多吧。"
                },
                {
                    "id": "221080305",
                    "speaker": "岚姐",
                    "text": "没有找到任何与「剑」有关的东西？"
                },
                {
                    "id": "221080306",
                    "speaker": "岚姐",
                    "text": "…是这样吗，没关系，这也在我预料之中。"
                },
                {
                    "id": "221080307",
                    "speaker": "岚姐",
                    "text": "辛苦了，这是给你的报酬，拿好了，去忙你自己的事吧。"
                }
            ]
        }
    ]
}