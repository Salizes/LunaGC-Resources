    "talks": [
        {
            "id": "7903501",
            "objective": "与蒙德的凯瑟琳对话",
            "dialogues": [
                {
                    "id": "790350101",
                    "speaker": "凯瑟琳",
                    "text": "#{NICKNAME}，派蒙，你们见过两只妖狸吗？一只背着紫色包袱，一只背着黄色包袱…"
                },
                {
                    "id": "790350102",
                    "speaker": "派蒙",
                    "text": "啊！一定是豆助和柴助！"
                },
                {
                    "id": "790350103",
                    "speaker": "凯瑟琳",
                    "text": "看来你们的确知道它们，太好了。"
                },
                {
                    "id": "790350104",
                    "speaker": "派蒙",
                    "text": "欸？难道它们出什么事了吗？"
                },
                {
                    "id": "790350105",
                    "speaker": "凯瑟琳",
                    "text": "那倒不是。只是它们手舞足蹈地比划了一阵以后交给我这个…"
                },
                {
                    "id": "790350106",
                    "speaker": "凯瑟琳",
                    "text": "听说之前你们和稻妻的妖狸去过猎鹿人，我猜这两只妖狸或许也是你们的朋友，它们大概是想让我转交给你们吧。"
                },
                {
                    "id": "790350107",
                    "speaker": "派蒙",
                    "text": "哇！是豆助和柴助的礼物！"
                },
                {
                    "id": "790350108",
                    "speaker": "派蒙",
                    "text": "嘿嘿，看来它们的旅途有一个顺利的开始呢，不知道以后还有没有机会见到它们…"
                }
            ]
        },
