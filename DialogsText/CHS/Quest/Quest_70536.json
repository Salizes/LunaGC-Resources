        "total_dialogue_lines": 63,
        "total_speaker_counts": {
            "Player": 12,
            "丽莎": 20,
            "可莉": 19,
            "派蒙": 12
        }
    },
    "talks": [
        {
            "id": "7053601",
            "objective": "回到花园的游戏桌旁",
            "dialogues": [
                {
                    "id": "705360101",
                    "speaker": "可莉",
                    "text": "嘿嘿！嘟嘟可战胜了一大群坏坏的角角鱼士兵！角角鱼的大王也不是对手！"
                },
                {
                    "id": "705360102",
                    "speaker": "可莉",
                    "text": "嘟嘟可，蹦蹦炸弹和轰轰火花的组合，是最厉害的！",
                    "choices": [
                        {
                            "id": "705360103",
                            "text": "是无敌的！",
                            "response": [
                                {
                                    "id": "705360105",
                                    "speaker": "派蒙",
                                    "text": "玩这个游戏的时候，我经常想到果酒湖的那件事呢…难道丽莎直接把那件事改编成了游戏的主题？"
                                },
                                {
                                    "id": "705360106",
                                    "speaker": "派蒙",
                                    "text": "不过话说回来，如果真的找不到那些外来的鱼…让小可莉去把可疑的礁石统统炸一遍，不就万事大吉了吗？"
                                },
                                {
                                    "id": "705360107",
                                    "speaker": "派蒙",
                                    "text": "实在不行，给我们几个炸弹，我们也能把这件事包办了！",
                                    "choices": [
                                        {
                                            "id": "705360108",
                                            "text": "派蒙，你和可莉更合拍了啊。",
                                            "response": [
                                                {
                                                    "id": "705360110",
                                                    "speaker": "丽莎",
                                                    "text": "嗯，看你们的表情，似乎还挺享受这个游戏的嘛？"
                                                },
                                                {
                                                    "id": "705360111",
                                                    "speaker": "可莉",
                                                    "text": "丽莎姐姐，你来了！"
                                                },
                                                {
                                                    "id": "705360112",
                                                    "speaker": "派蒙",
                                                    "text": "丽莎，你终于露面了！"
                                                },
                                                {
                                                    "id": "705360113",
                                                    "speaker": "派蒙",
                                                    "text": "你设计的「嘟嘟可轰轰奇遇记」很有趣，我们和小可莉都玩得很尽兴！"
                                                },
                                                {
                                                    "id": "705360114",
                                                    "speaker": "丽莎",
                                                    "text": "谢谢你们的喜欢。难道说，我还要设计这部作品的续作了？"
                                                },
                                                {
                                                    "id": "705360115",
                                                    "speaker": "可莉",
                                                    "text": "好耶！我还想看…嘟嘟可去其他地方冒险的故事！"
                                                },
                                                {
                                                    "id": "705360116",
                                                    "speaker": "可莉",
                                                    "text": "不，不对，我记得，丽莎姐姐做这个游戏花了好多时间，肯定很累，不能总是让丽莎姐姐这么累…"
                                                },
                                                {
                                                    "id": "705360117",
                                                    "speaker": "丽莎",
                                                    "text": "啊呀，小可莉这么关心姐姐，姐姐很高兴哦。"
                                                },
                                                {
                                                    "id": "705360118",
                                                    "speaker": "丽莎",
                                                    "text": "如果你喜欢这样的游戏，愿意安安心心待在城里玩，我花再多时间都值得。"
                                                },
                                                {
                                                    "id": "705360119",
                                                    "speaker": "丽莎",
                                                    "text": "当然，我明白，自由自在地到处冒险，才是你的最爱，这个游戏只是一种新奇的消遣。"
                                                },
                                                {
                                                    "id": "705360120",
                                                    "speaker": "丽莎",
                                                    "text": "所以，我给你们带来了一条好消息，还有给小可爱们的礼物。"
                                                },
                                                {
                                                    "id": "705360121",
                                                    "speaker": "可莉",
                                                    "text": "礼物！"
                                                },
                                                {
                                                    "id": "705360122",
                                                    "speaker": "可莉",
                                                    "text": "#我，我也有礼物要给荣誉骑士{M#哥哥}{F#姐姐}和小派蒙！"
                                                },
                                                {
                                                    "id": "705360123",
                                                    "speaker": "丽莎",
                                                    "text": "礼物放在最后，先说好消息吧！",
                                                    "choices": [
                                                        {
                                                            "id": "705360124",
                                                            "text": "我猜，果酒湖的问题解决了？",
                                                            "response": [
                                                                {
                                                                    "id": "705360126",
                                                                    "speaker": "丽莎",
                                                                    "text": "没错，调查小队的两位骑士找到了外来鱼类的老巢，将它轻松捣毁啦。"
                                                                },
                                                                {
                                                                    "id": "705360127",
                                                                    "speaker": "丽莎",
                                                                    "text": "至于外来鱼类突然出现的原因，骑士团也查清了。"
                                                                },
                                                                {
                                                                    "id": "705360128",
                                                                    "speaker": "丽莎",
                                                                    "text": "这次的事故起源于一位商人的无心之举，念在她没有恶意，骑士团只让她缴纳了相应的罚金，好好教育了她。"
                                                                },
                                                                {
                                                                    "id": "705360129",
                                                                    "speaker": "派蒙",
                                                                    "text": "呼…还好还好，没有造成很大的影响。不过，那个商人未免也太不小心了！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705360130",
                                                                            "text": "果酒湖的水质安全了！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705360132",
                                                                                    "speaker": "可莉",
                                                                                    "text": "那，接下来就是——公布礼物的时间了！可莉可以先说吗？"
                                                                                },
                                                                                {
                                                                                    "id": "705360133",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "当然没问题啦。"
                                                                                },
                                                                                {
                                                                                    "id": "705360134",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "我也有些好奇呢，小可莉最近每天很早就回家了，完全都不用别人提醒呢。"
                                                                                },
                                                                                {
                                                                                    "id": "705360135",
                                                                                    "speaker": "可莉",
                                                                                    "text": "哼哼~"
                                                                                },
                                                                                {
                                                                                    "id": "705360136",
                                                                                    "speaker": "可莉",
                                                                                    "text": "晚上在家的时候，我一边看着阿贝多哥哥的手工画册，一边学，一边做出来了这个——"
                                                                                },
                                                                                {
                                                                                    "id": "705360137",
                                                                                    "speaker": "可莉",
                                                                                    "text": "锵锵！"
                                                                                },
                                                                                {
                                                                                    "id": "705360138",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这是…准备投出蹦蹦炸弹的嘟嘟可！"
                                                                                },
                                                                                {
                                                                                    "id": "705360139",
                                                                                    "speaker": "可莉",
                                                                                    "text": "嗯！可莉照着「嘟嘟可轰轰奇遇记」的棋子，做了这个嘟嘟可的玩偶！"
                                                                                },
                                                                                {
                                                                                    "id": "705360140",
                                                                                    "speaker": "可莉",
                                                                                    "text": "虽然这个嘟嘟可不能真的丢出蹦蹦炸弹，但我觉得…"
                                                                                },
                                                                                {
                                                                                    "id": "705360141",
                                                                                    "speaker": "可莉",
                                                                                    "text": "#只要看到这个玩偶，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙就能想起这几天的开心时光，烦恼和无聊丢光光！"
                                                                                },
                                                                                {
                                                                                    "id": "705360142",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘟嘟可的大玩偶！确实是个大惊喜！"
                                                                                },
                                                                                {
                                                                                    "id": "705360143",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这样一来，感觉随时都能见到小可莉和嘟嘟可了！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705360144",
                                                                                            "text": "谢谢你！细心手巧又体贴的可莉！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705360146",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "#嘿嘿！荣誉骑士{M#哥哥}{F#姐姐}和小派蒙喜欢我的礼物，可莉的努力大获成功！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360147",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "丽莎姐姐的礼物呢？可莉也想知道！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360148",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "啊呀，比起小可莉的心意，我的这件礼物就要保守得多了呢~"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360149",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "来看看「嘟嘟可轰轰奇遇记」的冒险故事书吧——"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360150",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "冒险故事书！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360151",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "一整本故事！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360152",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "小可爱们回到了蒙德，与小可莉一起加入了嘟嘟可的冒险旅程！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360153",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "#{M#他们}{F#她们}一起打败了坏坏的角角鱼士兵，开开心心地喝起了下午茶…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360154",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "这个故事才是「嘟嘟可轰轰奇遇记」最最完美的模样。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360155",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "难道说，丽莎在设计这些游戏关卡的时候，就想好了整个故事吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360156",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "不是的。派蒙，这个故事是小可爱，你和小可莉合力完成的哦，你们才是决定一切的主角。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360157",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "我之前特别为这本书预留出了一张插图的位置…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360158",
                                                                                                    "speaker": "丽莎",
                                                                                                    "text": "现在我有个提议——大家难得在这么悠闲的时候相聚，不如，小可爱们一起合个影，怎么样？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360159",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好呀，见到了好朋友，还一起玩到了开心的游戏，这一刻确实值得纪念！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705360160",
                                                                                                            "text": "开开心心合个影！",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705360162",
                                                                                                                    "speaker": "可莉",
                                                                                                                    "text": "#那就来吧，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，这边这边！丽莎姐姐，拜托你了！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705360163",
                                                                                                                    "speaker": "可莉",
                                                                                                                    "text": "今天也是开心的一天！三、二、一——嘟嘟可！"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705360161",
                                                                                                            "text": "平平淡淡也珍贵！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705360145",
                                                                                            "text": "太好啦！可莉和嘟嘟可陪着我们！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705360131",
                                                                            "text": "蒙德的酒业也没事了！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705360125",
                                                            "text": "可莉不用再闷在蒙德城里了？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705360109",
                                            "text": "派蒙，我不能让你乱丢炸弹。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705360104",
                            "text": "打跑坏鱼！"
                        }
                    ]
                }
            ]
        }
    ]
}