{
    "quest": {
        "id": "22030",
        "title": "全能美食队·厨道的极意",
        "description": "全能美食队的龟井宗久似乎有什么事想要找人帮忙…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 62,
        "total_speaker_counts": {
            "Player": 12,
            "龟井宗久": 50
        }
    },
    "talks": [
        {
            "id": "2203001",
            "objective": "与龟井宗久对话",
            "dialogues": [
                {
                    "id": "220300101",
                    "speaker": "龟井宗久",
                    "text": "阁下，又见面了。"
                },
                {
                    "id": "220300102",
                    "speaker": "龟井宗久",
                    "text": "恕在下唐突，今天有一事想请阁下帮助。",
                    "choices": [
                        {
                            "id": "220300103",
                            "text": "什么事？",
                            "response": [
                                {
                                    "id": "220300106",
                                    "speaker": "龟井宗久",
                                    "text": "在受旭东阁下雇佣后，我一直与他们同行。"
                                },
                                {
                                    "id": "220300107",
                                    "speaker": "龟井宗久",
                                    "text": "为了报答旭东阁下收留我之恩，我想做些谢礼赠予他。"
                                },
                                {
                                    "id": "220300108",
                                    "speaker": "龟井宗久",
                                    "text": "但旭东阁下比起武艺，更喜欢美食，所以我想要亲手制作些食品。"
                                },
                                {
                                    "id": "220300109",
                                    "speaker": "龟井宗久",
                                    "text": "在下本来已经看好了两处食材的所在地，打算等这些食材成熟后再去取用。"
                                },
                                {
                                    "id": "220300110",
                                    "speaker": "龟井宗久",
                                    "text": "可是，却有两股魔物分别占据了那两处食材所在地，而且还都已经把食材取下了。"
                                },
                                {
                                    "id": "220300111",
                                    "speaker": "龟井宗久",
                                    "text": "我所要制作的那道菜，最重要的就是食材新鲜，我本来打算先取一处，再去另外一处…"
                                },
                                {
                                    "id": "220300112",
                                    "speaker": "龟井宗久",
                                    "text": "但现在两边魔物都已经取下了食材，想要烹制那道菜，在下必须快些把那两道食材都拿到手才行。"
                                },
                                {
                                    "id": "220300113",
                                    "speaker": "龟井宗久",
                                    "text": "但在下…分身乏术，就算能对付一处的魔物，另一处的食材想必也早已被魔物糟蹋殆尽。"
                                },
                                {
                                    "id": "220300114",
                                    "speaker": "龟井宗久",
                                    "text": "所以，我想请阁下与我共同出手，一起击倒那些魔物，取得食材。",
                                    "choices": [
                                        {
                                            "id": "220300115",
                                            "text": "交给我了。",
                                            "response": [
                                                {
                                                    "id": "220300116",
                                                    "speaker": "龟井宗久",
                                                    "text": "多谢阁下，在下感激不尽。"
                                                },
                                                {
                                                    "id": "220300119",
                                                    "speaker": "龟井宗久",
                                                    "text": "唔…在这里说也无用，阁下，请与我一同去前面一些的地方看看，然后我们再做商议吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220300117",
                                            "text": "做完了食物之后能分我点吗？",
                                            "response": [
                                                {
                                                    "id": "220300118",
                                                    "speaker": "龟井宗久",
                                                    "text": "那是自然，阁下当取第一份。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220300104",
                            "text": "不用这么客气…",
                            "response": [
                                {
                                    "id": "220300105",
                                    "speaker": "龟井宗久",
                                    "text": "是在下有求于阁下，这种礼节也是应当。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203002",
            "objective": "跟随龟井宗久",
            "dialogues": [
                {
                    "id": "220300201",
                    "speaker": "龟井宗久",
                    "text": "就是这里了。两处魔物分别在左右两边扎了营。"
                },
                {
                    "id": "220300202",
                    "speaker": "龟井宗久",
                    "text": "在下悄悄去侦察了一番，左边营地的魔物虽然弱小，但数量众多。"
                },
                {
                    "id": "220300203",
                    "speaker": "龟井宗久",
                    "text": "右边营地的魔物虽然数量略少，但却格外强壮。"
                },
                {
                    "id": "220300204",
                    "speaker": "龟井宗久",
                    "text": "有劳阁下清剿一处魔物，另一处交给在下即可。"
                }
            ]
        },
        {
            "id": "2203003",
            "objective": "（test)玩家选了左边$HIDDEN",
            "dialogues": [
                {
                    "id": "220300401",
                    "speaker": "Player",
                    "text": "我去左边。"
                },
                {
                    "id": "220300402",
                    "speaker": "龟井宗久",
                    "text": "那就有劳阁下了，在下这就去另一处营地。"
                },
                {
                    "id": "220300403",
                    "speaker": "Player",
                    "text": "你一个人能对付它们吗？"
                },
                {
                    "id": "220300404",
                    "speaker": "龟井宗久",
                    "text": "只是些许魔物罢了，无需担心，若不是担心食材，我一人就能对付这两处魔物。"
                },
                {
                    "id": "220300405",
                    "speaker": "龟井宗久",
                    "text": "好了，阁下清剿完魔物，拿到食材后，再到另外一处营地寻我就是。"
                },
                {
                    "id": "220300406",
                    "speaker": "龟井宗久",
                    "text": "我们快些出发吧，要是食材坏了，做出来的菜只怕无法入口了。"
                }
            ]
        },
        {
            "id": "2203004",
            "objective": "（test)玩家选了右边$HIDDEN",
            "dialogues": [
                {
                    "id": "220300301",
                    "speaker": "Player",
                    "text": "我去右边。"
                },
                {
                    "id": "220300302",
                    "speaker": "龟井宗久",
                    "text": "那就有劳阁下了，在下这就去另一处营地。"
                },
                {
                    "id": "220300303",
                    "speaker": "Player",
                    "text": "你一个人能对付它们吗？"
                },
                {
                    "id": "220300304",
                    "speaker": "龟井宗久",
                    "text": "只是些许魔物罢了，无需担心，若不是担心食材，我一人就能对付这两处魔物。"
                },
                {
                    "id": "220300305",
                    "speaker": "龟井宗久",
                    "text": "好了，阁下清剿完魔物，拿到食材后，再到另外一处营地寻我就是。"
