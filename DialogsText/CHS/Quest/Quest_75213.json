    "talks": [
        {
            "id": "7521301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752130201",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "752130202",
                    "speaker": "哈雅库",
                    "text": "欸？可以吗？小店的员工已经全派出去了，现在还有一份加急的外送订单。"
                },
                {
                    "id": "752130203",
                    "speaker": "哈雅库",
                    "text": "订单上备注了送给一位<color=#00E1FFFF>沙滩上的蓝裤子客人</color>，只要及时送到就好。"
                },
                {
                    "id": "752130204",
                    "speaker": "哈雅库",
                    "text": "实在感谢，除了这笔订单的外送费以外，小店的饮料配方也送给你当作酬金，就拜托了！"
                }
            ]
        },
        {
            "id": "7521302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7521304",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752130601",
                    "speaker": "Player",
                    "text": "你好，你的饮料到了。"
                },
                {
                    "id": "752130607",
                    "speaker": "阿考",
                    "text": "噢！噢！原来你们是送饮料的啊，我说怎么这么半天没有收到。"
                },
                {
                    "id": "752130608",
                    "speaker": "派蒙",
                    "text": "都怪你啦，在订单上留下「送给沙滩上蓝裤子客人」的备注，却偷偷躲在沙子里，害我们找了蓝裤子大半天。"
                },
                {
                    "id": "752130609",
                    "speaker": "派蒙",
                    "text": "你应该给我们加倍的外送费！"
                },
                {
                    "id": "752130610",
                    "speaker": "阿考",
                    "text": "啊，实在对不起，我忘记了这件事，我应该把裤子摆在一边，这样可能方便你们找到我。"
                },
                {
                    "id": "752130611",
                    "speaker": "Player",
                    "text": "你为什么要埋在沙子里？"
                },
                {
                    "id": "752130612",
                    "speaker": "阿考",
                    "text": "因为很有趣啊，我听说很多人度假的时候都会这么干，所以也想试试。"
                },
                {
                    "id": "752130613",
                    "speaker": "派蒙",
                    "text": "可你的姿势不太对吧，你看起来像是萝卜扎在地里。"
                },
                {
                    "id": "752130614",
                    "speaker": "阿考",
                    "text": "欸？这样会有什么坏处吗？"
                },
                {
                    "id": "752130615",
                    "speaker": "Player",
                    "text": "容易绊倒别人，自己也会受伤。"
                },
                {
                    "id": "752130617",
                    "speaker": "阿考",
                    "text": "明白了，我会考虑的，噢，这是你们的加倍外送费，谢谢！"
                }
            ]
        },
        {
            "id": "7521305",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752130701",
                    "speaker": "警示牌",
                    "text": "小心脚下！不是皮球！"
                }
            ]
        },
        {
            "id": "7521306",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7521307",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752130801",
                    "speaker": "警示牌",
                    "text": "近日，一位游客将身体埋进沙滩时，脑袋意外绊倒另一位游客，目前双方均已接受治疗。请诸位游客提高警惕，谨防意外。"
                }
            ]
        },
        {
            "id": "7521303",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7521301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752130101",
                    "speaker": "哈雅库",
                    "text": "没想到度假村试营业也这么火爆，这下有点缺人手了。"
                }
            ]
        },
        {
            "id": "7521303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752130301",
                    "speaker": "Player",
                    "text": "（默默走开。）"
                },
                {
                    "id": "752130302",
                    "speaker": "哈雅库",
                    "text": "咦？这个人好奇怪，我还以为是来帮忙的。"
                }
            ]
        },
        {
            "id": "7521304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752130401",
                    "speaker": "蓝衣服的游客",
                    "text": "天气好热啊…"
                },
                {
                    "id": "752130402",
                    "speaker": "Player",
                    "text": "你好，你的饮料到了。"
                },
                {
                    "id": "752130403",
                    "speaker": "蓝衣服的游客",
                    "text": "饮料？我没有点饮料啊。"
                },
                {
                    "id": "752130404",
                    "speaker": "派蒙",
                    "text": "不是这个啦，我们要找的是蓝色裤子的人！不是蓝色衣服！"
                }
            ]
        },
        {
            "id": "7521305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752130501",
                    "speaker": "灰裤子的游客",
                    "text": "天气好热啊…"
                },
                {
                    "id": "752130502",
                    "speaker": "Player",
                    "text": "你好，你的饮料到了。"
                },
                {
                    "id": "752130503",
                    "speaker": "灰裤子的游客",
                    "text": "这杯饮料送给我吗？天哪！是我的祈祷被神明听见了吗？"
                },
                {
                    "id": "752130504",
                    "speaker": "派蒙",
                    "text": "不是这个啦，我们要找的是蓝色裤子的人！不是灰色裤子！"
                }
            ]
        }
    ]
