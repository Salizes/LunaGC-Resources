    "talks": [
        {
            "id": "7351202",
            "objective": "回到学者身边",
            "dialogues": []
        },
        {
            "id": "7351201",
            "objective": "与维纳亚克对话",
            "dialogues": [
                {
                    "id": "735120101",
                    "speaker": "维纳亚克",
                    "text": "哦哦，感谢你！勇敢的冒险家啊！"
                },
                {
                    "id": "735120102",
                    "speaker": "维纳亚克",
                    "text": "还好还好，没过多长时间，零件还没怎么被糟蹋…只要再修整一下…"
                },
                {
                    "id": "735120103",
                    "speaker": "Black Screen",
                    "text": "维纳亚克开始埋头鼓捣机械…"
                },
                {
                    "id": "735120104",
                    "speaker": "施芮娅",
                    "text": "…维纳亚克？"
                },
                {
                    "id": "735120105",
                    "speaker": "维纳亚克",
                    "text": "嗯嗯，快了快了！马上就好！"
                },
                {
                    "id": "735120106",
                    "speaker": "施芮娅",
                    "text": "——维、纳、亚、克！"
                },
                {
                    "id": "735120107",
                    "speaker": "维纳亚克",
                    "text": "呜哇！施芮娅？你是什么时候来的？"
                },
                {
                    "id": "735120108",
                    "speaker": "Player",
                    "text": "就在你摆弄零件的时候…"
                },
                {
                    "id": "735120109",
                    "speaker": "维纳亚克",
                    "text": "你不是说，这里有魔物，很危险吗？怎么连你自己也过来了？"
                },
                {
                    "id": "735120110",
                    "speaker": "施芮娅",
                    "text": "…我只是在担心我们的零件而已，免得到时候交不上差，连我都回不了教令院！"
                },
                {
                    "id": "735120111",
                    "speaker": "维纳亚克",
                    "text": "哈，我就说嘛——你看，全都收集完了，等回去做完进一步的调试，就能开始组装了。"
                },
                {
                    "id": "735120112",
                    "speaker": "派蒙",
                    "text": "话说，这些都是什么的零件呀？"
                },
                {
                    "id": "735120113",
                    "speaker": "维纳亚克",
                    "text": "啊，忘了向你们介绍了——这是「对沙虫用杀虫炮」，我们当年的毕业设计项目！"
                },
                {
                    "id": "735120114",
                    "speaker": "派蒙",
                    "text": "——为什么会有这么偏门的选题啊！"
                },
                {
                    "id": "735120115",
                    "speaker": "维纳亚克",
                    "text": "你要是也为了毕业开过题，就知道为什么了…咳，总之这些不重要。"
                },
                {
                    "id": "735120116",
                    "speaker": "施芮娅",
                    "text": "正式自我介绍一下，我是从阿弥利多学院毕业的学者施芮娅，主修沙漠生物学与环境学。"
                },
                {
                    "id": "735120117",
                    "speaker": "施芮娅",
                    "text": "…这边这个机械笨蛋是刹诃伐罗学院的，主修的是应用机关术。"
                },
                {
                    "id": "735120118",
                    "speaker": "维纳亚克",
                    "text": "——我叫维纳亚克，之前真是多谢啦。"
                },
                {
                    "id": "735120119",
                    "speaker": "派蒙",
                    "text": "学的方向完全不同欸…这也能合作起来吗？"
                },
                {
                    "id": "735120120",
                    "speaker": "施芮娅",
                    "text": "别提了…当初为了成功开题跟这家伙合作做毕设，绝对是我在学生时代犯的最大错误…"
                },
                {
                    "id": "735120121",
                    "speaker": "维纳亚克",
                    "text": "也不能这么说吧，你看我们俩不还是照样毕业了？"
                },
                {
                    "id": "735120122",
                    "speaker": "施芮娅",
                    "text": "是啊！你算算看比同届入学的人晚了多少年？"
                },
                {
                    "id": "735120123",
                    "speaker": "维纳亚克",
                    "text": "那好歹也算毕业了吧？我听说有些人去年才过的开题呢。"
                },
                {
                    "id": "735120124",
                    "speaker": "施芮娅",
                    "text": "啊啊…够了！这种无意义的争论留在学生时代就够了！"
                },
                {
                    "id": "735120125",
                    "speaker": "维纳亚克",
                    "text": "可每次不都是你先开始的吗…"
                },
                {
                    "id": "735120126",
                    "speaker": "施芮娅",
                    "text": "哪有？就说我们第一次造原型机的时候…",
                    "choices": [
                        {
                            "id": "735120127",
                            "text": "停停停！",
                            "response": [
                                {
                                    "id": "735120129",
                                    "speaker": "派蒙",
                                    "text": "唔…关系好差，教令院怎么会想到派你们俩来处理这件事啊…"
                                },
                                {
                                    "id": "735120130",
                                    "speaker": "施芮娅",
                                    "text": "唉，倒也不能说是教令院让我们来的…其实这事本来是由我们院的库纳尔全权负责。"
                                },
                                {
                                    "id": "735120160",
                                    "speaker": "施芮娅",
                                    "text": "他算是我导师的导师吧，当初我们毕业答辩的时候也有来旁听。"
                                },
                                {
                                    "id": "735120161",
                                    "speaker": "施芮娅",
                                    "text": "大概就是那时候，给他留下了「院里的年轻人做过什么沙虫炮」的印象。"
                                },
                                {
                                    "id": "735120162",
                                    "speaker": "施芮娅",
                                    "text": "所以这次，他说着什么「要多让年轻人发光发热！」然后硬是把我们抓到一起，派来解决这件事。"
                                },
                                {
                                    "id": "735120163",
                                    "speaker": "施芮娅",
                                    "text": "明明我们毕业之后就没怎么来往了…"
                                },
                                {
                                    "id": "735120131",
                                    "speaker": "维纳亚克",
                                    "text": "就连我的导师也被他说动了…咳，不过借这机会，我才能让这门「对沙虫用杀虫炮」重见天日！"
                                },
                                {
                                    "id": "735120132",
                                    "speaker": "维纳亚克",
                                    "text": "——等到组装完成，就能让那些虫子见识一下它的厉害了！"
                                },
                                {
                                    "id": "735120133",
                                    "speaker": "施芮娅",
                                    "text": "这个机械笨蛋又开始了…不过从我的角度来说，也想研究一下这些沙虫作乱的原因，维护沙漠的生态平衡。"
                                },
                                {
                                    "id": "735120134",
                                    "speaker": "施芮娅",
                                    "text": "#冒险家{M#先生}{F#小姐}，您的身手看起来很不错。请问在我们留居沙漠的这段时间里，能聘请您来保护我们的安全吗？",
                                    "choices": [
                                        {
                                            "id": "735120135",
                                            "text": "摩拉到位一切好说。",
                                            "response": [
                                                {
                                                    "id": "735120137",
                                                    "speaker": "施芮娅",
                                                    "text": "请放心，这趟出来教令院别的援助不多，经费倒是给得挺充足…虽然某人已经花掉了大半来升级机械配置。"
                                                },
                                                {
                                                    "id": "735120138",
                                                    "speaker": "维纳亚克",
                                                    "text": "都、都是必要的提升！…话说你这不是能好好说话吗，怎么一拐到我身上就带刺了？"
                                                },
                                                {
                                                    "id": "735120139",
                                                    "speaker": "施芮娅",
                                                    "text": "——那要看说话的对象有没有让人好好说话的价值！"
                                                },
                                                {
                                                    "id": "735120140",
                                                    "speaker": "派蒙",
                                                    "text": "欸，这两个人又要开始了…",
                                                    "choices": [
                                                        {
                                                            "id": "735120141",
                                                            "text": "要吵架你们后边随意…",
                                                            "response": [
                                                                {
                                                                    "id": "735120143",
                                                                    "speaker": "施芮娅",
                                                                    "text": "唉…抱歉，学生时代留下的老毛病了…"
                                                                },
                                                                {
                                                                    "id": "735120144",
                                                                    "speaker": "施芮娅",
                                                                    "text": "这批零件还得拉回阿如村去做进一步的调整，算起来，怎么也得到明天才能开始组装了吧？"
                                                                },
                                                                {
                                                                    "id": "735120145",
                                                                    "speaker": "施芮娅",
                                                                    "text": "我们之前计划在附近有沙虫出没过的地方，安设「对沙虫用杀虫炮」。"
                                                                },
                                                                {
                                                                    "id": "735120146",
                                                                    "speaker": "施芮娅",
                                                                    "text": "到时候，可能还会有其它魔物被我们弄出的动静吸引过来——那就得拜托你出手了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "735120147",
                                                                            "text": "没问题。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "735120149",
                                                                                    "speaker": "维纳亚克",
                                                                                    "text": "那现在，施芮娅，我们可以继续辩论了，我花掉的经费绝对有理有据。"
                                                                                },
                                                                                {
                                                                                    "id": "735120150",
                                                                                    "speaker": "施芮娅",
                                                                                    "text": "你…！好啊！算账是吧？奉陪到底！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "735120148",
                                                                            "text": "明天见。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735120142",
                                                            "text": "能不能先说下工作安排。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735120136",
                                            "text": "区区小事不足挂齿。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735120128",
                            "text": "没完了要。"
                        }
                    ]
                }
            ]
        }
    ]
}