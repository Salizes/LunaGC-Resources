    "talks": [
        {
            "id": "1112201",
            "objective": "前往灵矩关一带调查线索",
            "dialogues": [
                {
                    "id": "111229901",
                    "speaker": "派蒙",
                    "text": "等等，地上有线索！"
                },
                {
                    "id": "111229902",
                    "speaker": "派蒙",
                    "text": "一定是那些矿工留下的！"
                },
                {
                    "id": "111229903",
                    "speaker": "钟离",
                    "text": "我们到灵矩关出口去。如果那里没有脚印，就说明他们还在灵矩关内，如果有新线索，就继续追查。"
                }
            ]
        },
        {
            "id": "1112202",
            "objective": "在附近寻找更多线索",
            "dialogues": [
                {
                    "id": "111220201",
                    "speaker": "派蒙",
                    "text": "呀，脚印！"
                },
                {
                    "id": "111220202",
                    "speaker": "钟离",
                    "text": "看来他们穿过了灵矩关，继续向前步行。"
                },
                {
                    "id": "111220203",
                    "speaker": "派蒙",
                    "text": "跟着脚印就能找到他们的去处了，对吧？"
                }
            ]
        },
        {
            "id": "1112203",
            "objective": "跟着脚印继续追踪",
            "dialogues": []
        },
        {
            "id": "1112210",
            "objective": "向附近的人们打听情报",
            "dialogues": [
                {
                    "id": "111220401",
                    "speaker": "派蒙",
                    "text": "请问你在这附近见过矿工打扮的人吗？"
                },
                {
                    "id": "111220402",
                    "speaker": "小玲",
                    "text": "大约是四五天前吧，有几个人从这里走过，背着篓子，提着铁镐什么的…和你说的差不多。"
                },
                {
                    "id": "111220403",
                    "speaker": "派蒙",
                    "text": "对对，就是他们！"
                },
                {
                    "id": "111220404",
                    "speaker": "钟离",
                    "text": "四五天前？看来他们走得远不如我们想象中快，恐怕是被灵矩关的地形耗去了不少时间。"
                },
                {
                    "id": "111220405",
                    "speaker": "小玲",
                    "text": "哎呀，那些人可奇怪了，四个大男人，个个面色呆滞，都像没睡醒一样！前面还有个小孩，晃晃悠悠的…"
                },
                {
                    "id": "111220406",
                    "speaker": "钟离",
                    "text": "你看清那个小孩的模样了吗？"
                },
                {
                    "id": "111220407",
                    "speaker": "小玲",
                    "text": "只扫了一眼，蓝色头发，个子很矮，好像…好像是个女孩儿！还有，她表情也很严肃，一点笑意都没有。"
                },
                {
                    "id": "111220408",
                    "speaker": "钟离",
                    "text": "他们走的是这条路吗？"
                },
                {
                    "id": "111220409",
                    "speaker": "小玲",
                    "text": "是啊，从这儿一直往前走了。"
                },
                {
                    "id": "111220410",
                    "speaker": "派蒙",
                    "text": "我们追吧！"
                }
            ]
        },
        {
            "id": "1112211",
            "objective": "向附近的人们打听情报",
            "dialogues": []
        },
        {
            "id": "1112204",
            "objective": "向附近的人们打听情报",
            "dialogues": []
        },
        {
            "id": "1112205",
            "objective": "沿路继续追踪",
            "dialogues": []
        },
        {
            "id": "1112206",
            "objective": "救下被围攻的学者",
            "dialogues": []
        },
        {
            "id": "1112207",
            "objective": "与学者对话",
            "dialogues": [
                {
                    "id": "111220701",
                    "speaker": "琬玉",
                    "text": "这些怪物太暴躁了，只是走过都会被它们发现，二话不说就往人身上扑…多亏各位救了我，谢谢。"
                },
                {
                    "id": "111220702",
                    "speaker": "琬玉",
                    "text": "我叫琬玉，隶属于璃月盛露厅，负责人文古迹的研究工作。"
                },
                {
                    "id": "111220703",
                    "speaker": "派蒙",
                    "text": "哎呀？不是矿工…"
                },
                {
                    "id": "111220704",
                    "speaker": "琬玉",
                    "text": "矿工？"
                },
                {
                    "id": "111220705",
                    "speaker": "派蒙",
                    "text": "嗯，我们在找矿工，一共四个！都是个子高高大大的男性，带着采矿工具。"
                },
                {
                    "id": "111220706",
                    "speaker": "琬玉",
                    "text": "你说的人，我好像见过。"
                },
                {
                    "id": "111220707",
                    "speaker": "派蒙",
                    "text": "真的吗？"
                },
                {
                    "id": "111220708",
                    "speaker": "琬玉",
                    "text": "对，我是前天从南天门出发的，要往灵矩关方向去。半路上遇到一队人，是一个小孩和几个大人。"
                },
                {
                    "id": "111220709",
                    "speaker": "Player",
                    "text": "能说得详细一点吗？"
                },
                {
                    "id": "111220710",
                    "speaker": "琬玉",
                    "text": "我走得比较急，没能细看。面貌特征什么的都记不清了…抱歉。"
                },
                {
                    "id": "111220711",
                    "speaker": "钟离",
                    "text": "这些就足够了，谢谢你。"
                },
                {
                    "id": "111220712",
                    "speaker": "琬玉",
                    "text": "能帮上忙就好。"
                },
                {
                    "id": "111220713",
                    "speaker": "琬玉",
                    "text": "那我就先走一步了，还有学术会议要参加，再次感谢几位。"
                },
                {
                    "id": "111220714",
                    "speaker": "派蒙",
                    "text": "根据那位学者的说法，这些人应该是往南天门方向去了。"
                },
                {
                    "id": "111220715",
                    "speaker": "昆钧",
                    "text": "不过，能确定是同一批人吗？"
                },
                {
                    "id": "111220716",
                    "speaker": "派蒙",
                    "text": "小孩跟大人的组合，没那么常见吧！"
                },
                {
                    "id": "111220717",
                    "speaker": "Player",
                    "text": "还是挺常见的。"
                },
                {
                    "id": "111220718",
                    "speaker": "派蒙",
                    "text": "呃…那、那…"
                },
                {
                    "id": "111220719",
                    "speaker": "昆钧",
                    "text": "喂，你们看那边那块石头！"
                },
                {
                    "id": "111220720",
                    "speaker": "派蒙",
                    "text": "哦哦，还有这一招呀！"
                },
                {
                    "id": "111220721",
                    "speaker": "昆钧",
                    "text": "应该能用，我来试试。"
                },
                {
                    "id": "111220722",
                    "speaker": "昆钧",
                    "text": "唔。"
                },
                {
                    "id": "111220723",
                    "speaker": "昆钧",
                    "text": "……"
                },
                {
                    "id": "111220724",
                    "speaker": "昆钧",
                    "text": "没错，是同一批人。他们沿着这条路走过去了。"
                },
                {
                    "id": "111220725",
                    "speaker": "钟离",
                    "text": "昆兄读取石块回忆的场面，无论看几次都觉得有趣。"
                },
                {
                    "id": "111220726",
                    "speaker": "昆钧",
                    "text": "这所谓的本事，平时还真用不上。能让钟离先生消遣，也算有些意义。"
                },
                {
                    "id": "111220727",
                    "speaker": "派蒙",
                    "text": "小昆简直是我们的指南针！有你在，才好确定方向呀。"
                },
                {
                    "id": "111220728",
                    "speaker": "昆钧",
                    "text": "哈哈哈哈，是吗？那我也就不枉来此一遭了。"
                },
                {
                    "id": "111220729",
                    "speaker": "昆钧",
                    "text": "嗯，这感觉…像在办案一样，好有意思。"
                },
                {
                    "id": "111220730",
                    "speaker": "钟离",
                    "text": "有趣之余，别忘了保持警惕。"
                },
                {
                    "id": "111220731",
                    "speaker": "钟离",
                    "text": "四名成年人面容呆滞地跟着一个孩童日夜赶路，翻山越岭…此事绝不简单。"
                },
                {
                    "id": "111220732",
                    "speaker": "昆钧",
                    "text": "噢噢！说得也是，钟离先生当真谨慎。"
                },
                {
                    "id": "111220733",
                    "speaker": "钟离",
                    "text": "另外，刚才那位学者是被幼岩龙蜥袭击了，但这种怪物不该有这么强的攻击性才对。"
                },
                {
                    "id": "111220734",
                    "speaker": "钟离",
                    "text": "一路走来诸多线索，冥冥之中似乎都有联系…"
                },
                {
                    "id": "111220735",
                    "speaker": "钟离",
                    "text": "工人们是前天往南天门方向去的。从这里过去，要经过一段艰险的山路。假如他们的目的地就是南天门，我们应该还能赶上。"
                },
                {
                    "id": "111220736",
                    "speaker": "派蒙",
                    "text": "嗯，马上出发吧！"
                },
                {
                    "id": "111220737",
                    "speaker": "钟离",
                    "text": "方才我在附近做了记号，万一老戴追来，也能循着记号找到我们。"
                },
                {
                    "id": "111220738",
                    "speaker": "派蒙",
                    "text": "不愧是钟离！"
                }
            ]
        },
        {
            "id": "1112212",
            "objective": "（test)触发trigger$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1112208",
            "objective": "前往南天门寻找新的线索",
            "dialogues": [
                {
                    "id": "111220802",
                    "speaker": "昆钧",
                    "text": "旁边还落着背篓…他确实是矿工。"
                },
                {
                    "id": "111220803",
                    "speaker": "派蒙",
                    "text": "喂，喂，能听见我说话吗？"
                },
                {
                    "id": "111220804",
                    "speaker": "钟离",
                    "text": "看他的样子，应该是筋疲力尽才昏倒在此。"
                },
                {
                    "id": "111220805",
                    "speaker": "派蒙",
                    "text": "要叫醒他吗？"
                },
                {
                    "id": "111220806",
                    "speaker": "矿工",
                    "text": "我还能…能挖…"
                },
                {
                    "id": "111220807",
                    "speaker": "派蒙",
                    "text": "嗯？嘴里嘀咕着什么东西…",
                    "choices": [
                        {
                            "id": "111220808",
                            "text": "一直在挣扎…",
                            "response": [
                                {
                                    "id": "111220810",
                                    "speaker": "钟离",
                                    "text": "如此执着，实在反常。"
                                },
                                {
                                    "id": "111220811",
                                    "speaker": "钟离",
                                    "text": "附近有个营地，先带他到那里安顿下来，再做打算。"
                                }
                            ]
                        },
                        {
                            "id": "111220809",
                            "text": "很想站起来的样子。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1112209",
            "objective": "送矿工去附近的营地休息",
            "dialogues": [
                {
                    "id": "111220901",
                    "speaker": "钟离",
                    "text": "……"
                },
                {
                    "id": "111220902",
                    "speaker": "派蒙",
                    "text": "怎么样？他不会死吧？"
                },
                {
                    "id": "111220903",
                    "speaker": "钟离",
                    "text": "他是劳累过度，陷入了昏迷。幸好，没有性命之忧。"
                },
                {
                    "id": "111220904",
                    "speaker": "Player",
                    "text": "他怎么会累成这样？"
                },
                {
                    "id": "111220905",
                    "speaker": "派蒙",
                    "text": "我刚才听见他在念叨，说要挖什么东西，所以他是挖累了吗？"
                },
                {
                    "id": "111220906",
                    "speaker": "钟离",
                    "text": "不无可能。",
                    "choices": [
                        {
                            "id": "111220907",
                            "text": "好奇怪…",
                            "response": [
                                {
                                    "id": "111220909",
                                    "speaker": "昆钧",
                                    "text": "嗯？他口袋里好像有什么东西…"
                                },
                                {
                                    "id": "111220910",
                                    "speaker": "昆钧",
                                    "text": "这是…矿石的碎片？"
                                },
                                {
                                    "id": "111220911",
                                    "speaker": "昆钧",
                                    "text": "……"
                                },
                                {
                                    "id": "111220912",
                                    "speaker": "昆钧",
                                    "text": "各位，我看了他口袋中矿石碎片的记忆。这些碎片是这个人从矿区带出来的，可见此人确实是我们要找的四名矿工之一。"
                                },
                                {
                                    "id": "111220913",
                                    "speaker": "钟离",
                                    "text": "那他会倒在这里，就更有意思了。"
                                },
                                {
                                    "id": "111220914",
                                    "speaker": "派蒙",
                                    "text": "被人带走，然后…被丢弃？"
                                },
                                {
                                    "id": "111220915",
                                    "speaker": "派蒙",
                                    "text": "可既然要丢掉他，又为什么要把他一路带到这里呢？"
                                },
                                {
                                    "id": "111220916",
                                    "speaker": "钟离",
                                    "text": "除非发生了什么事，让他不得不掉队。"
                                },
                                {
                                    "id": "111220917",
                                    "speaker": "派蒙",
                                    "text": "唔…唔唔…"
                                },
                                {
                                    "id": "111220918",
                                    "speaker": "派蒙",
                                    "text": "不行，太神秘了！"
                                },
                                {
                                    "id": "111220919",
                                    "speaker": "昆钧",
                                    "text": "啊，对了！看到这些碎片才想起来，我也有些东西要送给你们。"
                                },
                                {
                                    "id": "111220920",
                                    "speaker": "派蒙",
                                    "text": "什么什么，有礼物吗？"
                                },
                                {
                                    "id": "111220921",
                                    "speaker": "钟离",
                                    "text": "送给我们？为什么？"
                                },
                                {
                                    "id": "111220922",
                                    "speaker": "昆钧",
                                    "text": "不瞒你们说，与老戴会合之前我总是犯迷糊，和你们一起查案，思路才变得清晰起来。"
                                },
                                {
                                    "id": "111220923",
                                    "speaker": "昆钧",
                                    "text": "我一直在偷偷庆幸老戴还找了你们几位帮忙。要是没有你们，只凭我一人，恐怕没办法查到这么多线索。"
                                },
                                {
                                    "id": "111220924",
                                    "speaker": "昆钧",
                                    "text": "这些是我从集市淘来的水晶，别看它只是水晶，成色可是极其罕见的！一人一块，就当留个纪念吧。"
                                },
                                {
                                    "id": "111220925",
                                    "speaker": "派蒙",
                                    "text": "好漂亮的水晶啊，颜色还会变！这样看，那样看…感觉都不一样。",
                                    "choices": [
                                        {
                                            "id": "111220926",
                                            "text": "看起来非常贵重…",
                                            "response": [
                                                {
                                                    "id": "111220928",
                                                    "speaker": "昆钧",
                                                    "text": "别客气，拿着吧。"
                                                },
                                                {
                                                    "id": "111220929",
                                                    "speaker": "昆钧",
                                                    "text": "这块给钟离先生。"
                                                },
                                                {
                                                    "id": "111220930",
                                                    "speaker": "钟离",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "111220931",
                                                    "speaker": "昆钧",
                                                    "text": "咦？怎、怎么了，不喜欢吗？"
                                                },
                                                {
                                                    "id": "111220932",
                                                    "speaker": "钟离",
                                                    "text": "不，怎么会。只是没想到，会在这样的时刻收到礼物。"
                                                },
                                                {
                                                    "id": "111220933",
                                                    "speaker": "钟离",
                                                    "text": "多谢，我会好好保管的。"
                                                },
                                                {
                                                    "id": "111220934",
                                                    "speaker": "昆钧",
                                                    "text": "谢谢你们愿意收下。好的礼物送给识货的朋友才有意义。"
                                                },
                                                {
                                                    "id": "111220935",
                                                    "speaker": "昆钧",
                                                    "text": "我看这一带也有不少石块，你们先休息吧，我去周围逛逛，顺便摸摸石头。"
                                                },
                                                {
                                                    "id": "111220936",
                                                    "speaker": "派蒙",
                                                    "text": "小昆还真是喜欢石头啊！"
                                                },
                                                {
                                                    "id": "111220937",
                                                    "speaker": "昆钧",
                                                    "text": "矿石是大地的结晶，时间的沉淀。和它们在一起，我会觉得安心。"
                                                },
                                                {
                                                    "id": "111220938",
                                                    "speaker": "昆钧",
                                                    "text": "你们慢慢休息，出发前叫我一声。我就在附近，不会走远。"
                                                },
                                                {
                                                    "id": "111220939",
                                                    "speaker": "Player",
                                                    "text": "他一个人不要紧吧。"
                                                },
                                                {
                                                    "id": "111220940",
                                                    "speaker": "钟离",
                                                    "text": "不用担心，我刚才看过周围，没有其他危险。"
                                                },
                                                {
                                                    "id": "111220941",
                                                    "speaker": "钟离",
                                                    "text": "对了，我有话要跟你说。"
                                                },
                                                {
                                                    "id": "111220942",
                                                    "speaker": "派蒙",
                                                    "text": "唔？神情有些严肃哦？"
                                                },
                                                {
                                                    "id": "111220943",
                                                    "speaker": "钟离",
                                                    "text": "旅行者，关于「镇龙石」，你有什么印象吗？"
                                                },
                                                {
                                                    "id": "111220944",
                                                    "speaker": "Player",
                                                    "text": "没有。"
                                                },
                                                {
                                                    "id": "111220945",
                                                    "speaker": "派蒙",
                                                    "text": "是他找的那种矿石对吧，有什么特别之处吗？"
                                                },
                                                {
                                                    "id": "111220946",
                                                    "speaker": "钟离",
                                                    "text": "镇龙石是一种罕见的锻造用矿石。常见的水晶多数是在高温环境下自然形成，镇龙石却是元素反应引发的结晶成品。"
                                                },
                                                {
                                                    "id": "111220947",
                                                    "speaker": "派蒙",
                                                    "text": "元素反应能产生实物吗？"
                                                },
                                                {
                                                    "id": "111220948",
                                                    "speaker": "钟离",
                                                    "text": "可以。不过，只有很少一部分能被长久保存下来。"
                                                },
                                                {
                                                    "id": "111220949",
                                                    "speaker": "钟离",
                                                    "text": "镇龙石诞生于千百年前的一场大战。强烈的元素力碰撞导致元素结晶，战斗结束后，这些石头奇迹般留存了下来。"
                                                },
                                                {
                                                    "id": "111220950",
                                                    "speaker": "派蒙",
                                                    "text": "居然是这样啊…"
                                                },
                                                {
                                                    "id": "111220951",
                                                    "speaker": "钟离",
                                                    "text": "但它毕竟是结晶造物，数量很少，知名度也不高。再者，早在几百年前它就被开采殆尽了。"
                                                },
                                                {
                                                    "id": "111220952",
                                                    "speaker": "钟离",
                                                    "text": "现代的璃月人，为什么要找早已不存在的矿石？"
                                                },
                                                {
                                                    "id": "111220953",
                                                    "speaker": "派蒙",
                                                    "text": "对哦！如果他能知道这种石头的存在，不就更应该知道它被人采光了吗？"
                                                },
                                                {
                                                    "id": "111220954",
                                                    "speaker": "派蒙",
                                                    "text": "好奇怪…完全说不通…"
                                                },
                                                {
                                                    "id": "111220955",
                                                    "speaker": "钟离",
                                                    "text": "矿业相关的工作者里，也有一些对镇龙石感兴趣的人。但像昆兄这样说不出缘由却要找石头的…十分少见。"
                                                },
                                                {
                                                    "id": "111220956",
                                                    "speaker": "Player",
                                                    "text": "或许他是另有来意。"
                                                },
                                                {
                                                    "id": "111220957",
                                                    "speaker": "派蒙",
                                                    "text": "另有来意…是坏人吗？！"
                                                },
                                                {
                                                    "id": "111220958",
                                                    "speaker": "钟离",
                                                    "text": "现在很难定论，不如先静观其变。"
                                                },
                                                {
                                                    "id": "111220959",
                                                    "speaker": "钟离",
                                                    "text": "别忘了，眼下最主要的目的是救回那些矿工。至于其他，早晚也会水落石出。"
                                                },
                                                {
                                                    "id": "111220960",
                                                    "speaker": "钟离",
                                                    "text": "与目标的距离正在缩短。我想，我们应该沿这条路继续走，能找到其中一个，就能找到剩下的人。"
                                                },
                                                {
                                                    "id": "111220961",
                                                    "speaker": "钟离",
                                                    "text": "等你休息完毕，请你叫上昆兄，我们继续追查。"
                                                },
                                                {
                                                    "id": "111220962",
                                                    "speaker": "钟离",
                                                    "text": "至于这位工人，可以先安置在营地内，等解决了事件，再回来照看他。给老戴留张字条，万一他找来也能及时处理。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "111220927",
                                            "text": "真的可以给我吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "111220908",
                            "text": "他不是被带走了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1112110",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111211001",
                    "speaker": "观察石块",
                    "text": "（看起来…可能是石珀的一种？）"
                },
                {
                    "id": "111211002",
                    "speaker": "观察石块",
                    "text": "（竟然能记录下我们需要的信息，真是神奇的石头啊。）"
                }
            ]
        },
        {
            "id": "1112210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111221001",
                    "speaker": "观察石块",
                    "text": "（明明和普通石珀没什么区别…小昆却能从中读到记忆。）"
                },
                {
                    "id": "111221002",
                    "speaker": "观察石块",
                    "text": "（多亏了这种石头，我们才能追踪到线索。）"
                }
            ]
        },
        {
            "id": "1112241",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111224101",
                    "speaker": "派蒙",
                    "text": "请问你在这附近见过矿工打扮的人吗？"
                },
                {
                    "id": "111224102",
                    "speaker": "永贵",
                    "text": "矿工？没见过。"
                },
                {
                    "id": "111224103",
                    "speaker": "派蒙",
                    "text": "嗯…问问别人好了。"
                }
            ]
        },
        {
            "id": "1112242",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111224201",
                    "speaker": "派蒙",
                    "text": "你好，你看见过矿工吗？这么大的个子，一共四个！"
                },
                {
                    "id": "111224202",
                    "speaker": "小伟",
                    "text": "去去去，别打扰我欣赏浮云！"
                },
                {
                    "id": "111224203",
                    "speaker": "派蒙",
                    "text": "好不耐烦的样子啊，这个人…"
                },
                {
                    "id": "111224204",
                    "speaker": "派蒙",
                    "text": "算了，再问问其他人吧。"
                }
            ]
        },
        {
            "id": "1112251",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111225101",
                    "speaker": "永贵",
                    "text": "唉，年纪大了，走不动路喽…"
                }
            ]
        },
        {
            "id": "1112252",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111225201",
                    "speaker": "小伟",
                    "text": "哎呀别吵，没看见我在忙吗？"
                }
            ]
        },
        {
            "id": "1112253",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111225301",
                    "speaker": "小玲",
                    "text": "我也是第一次看见那种情况…那些大人是睡着了吗？真奇怪。"
                }
            ]
        },
        {
            "id": "1112299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111229908",
                    "speaker": "派蒙",
                    "text": "喂喂，快看地上！这是我们要找的人吗？"
                }
            ]
        }
    ]
}