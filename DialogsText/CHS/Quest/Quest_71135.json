    "talks": [
        {
            "id": "7113502",
            "objective": "",
            "dialogues": [
                {
                    "id": "711350201",
                    "speaker": "派蒙",
                    "text": "哇啊！不知不觉间，我们已经收集到这么多仙力啦！",
                    "choices": [
                        {
                            "id": "711350202",
                            "text": "不愧是我！",
                            "response": [
                                {
                                    "id": "711350205",
                                    "speaker": "派蒙",
                                    "text": "按照浮锦之前的说法，这些仙力都用在「祀珑」上了。这样一来，翘英庄明年应该也会大丰收啦！"
                                },
                                {
                                    "id": "711350206",
                                    "speaker": "派蒙",
                                    "text": "到了那时候，我要让罗叔给我准备好多好多好吃的！我想想，比如说茶糕，乳鸽，红烧肉圆，蜜汁叉烧，还有还有…"
                                },
                                {
                                    "id": "711350207",
                                    "speaker": "？？？",
                                    "text": "茶露？"
                                },
                                {
                                    "id": "711350208",
                                    "speaker": "派蒙",
                                    "text": "对对对，还有沉玉茶露！这个一定要记下来…欸？不对，什么人？"
                                },
                                {
                                    "id": "711350209",
                                    "speaker": "派蒙",
                                    "text": "浮、浮锦？！"
                                },
                                {
                                    "id": "711350210",
                                    "speaker": "浮锦",
                                    "text": "呵呵，抱歉，吓到你们了吗？"
                                },
                                {
                                    "id": "711350211",
                                    "speaker": "派蒙",
                                    "text": "你已经能变回人形啦！"
                                },
                                {
                                    "id": "711350212",
                                    "speaker": "浮锦",
                                    "text": "是呀。咳咳，小仙我不是说过嘛，又不是受了什么严重的伤，只要稍微休养一段时间，就能恢复我最喜欢的模样啦。"
                                },
                                {
                                    "id": "711350213",
                                    "speaker": "浮锦",
                                    "text": "#谢谢你们，在我休养的这段时间，为祀珑收集了这么多的仙力。来年的丰收，{NICKNAME}和派蒙是最大的功臣呢。",
                                    "choices": [
                                        {
                                            "id": "711350214",
                                            "text": "#哼哼，对本{M#少爷}{F#小姐}来说不过是举手之劳！",
                                            "response": [
                                                {
                                                    "id": "711350216",
                                                    "speaker": "派蒙",
                                                    "text": "说到这个，既然浮锦现在已经恢复人形了，也不用再被关在这个黑漆漆的地方了，接下来有什么想做的事情吗？"
                                                },
                                                {
                                                    "id": "711350217",
                                                    "speaker": "浮锦",
                                                    "text": "嗯…具体的我还没有想好呢。说不定会先在附近走走看吧？"
                                                },
                                                {
                                                    "id": "711350218",
                                                    "speaker": "浮锦",
                                                    "text": "品一品现在的茶，听一听现在的戏，见一见现在的人…呵呵，抱歉，总是强调「现在」，感觉像是什么讨人厌的老古董一样呢。"
                                                },
                                                {
                                                    "id": "711350219",
                                                    "speaker": "浮锦",
                                                    "text": "不过，我真的很喜欢「现在」这个词。过去没办法做到的事情，「现在」也能做得到了。过去没办法实现的、好多好多的约定，「现在」也能实现了。"
                                                },
                                                {
                                                    "id": "711350220",
                                                    "speaker": "浮锦",
                                                    "text": "之后，我想要到归离集去看一看，到璃月港去看一看，去见见她们所说的可爱的人们，也想要见见药君…"
                                                },
                                                {
                                                    "id": "711350221",
                                                    "speaker": "Player",
                                                    "text": "需要我带你去吗？"
                                                },
                                                {
                                                    "id": "711350222",
                                                    "speaker": "派蒙",
                                                    "text": "是呀，我记得浮锦好像说过，「没办法离开清水太长时间」、「需要依靠仙家的茶壶才能去很远的地方」什么的…"
                                                },
                                                {
                                                    "id": "711350223",
                                                    "speaker": "浮锦",
                                                    "text": "呵呵…谢谢你还记得这件事，也谢谢你愿意帮我。不过，我还是希望先在沉玉谷停留一段时间，好好欣赏一下家中的风景。"
                                                },
                                                {
                                                    "id": "711350224",
                                                    "speaker": "浮锦",
                                                    "text": "至于远游，我想想…嗯，要不然等小茂长大吧？"
                                                },
                                                {
                                                    "id": "711350225",
                                                    "speaker": "派蒙",
                                                    "text": "这也太久了！"
                                                },
                                                {
                                                    "id": "711350226",
                                                    "speaker": "浮锦",
                                                    "text": "开玩笑的啦！总之，我还是打算先在这边停留一段时间，也顺便试试看能不能劝灵渊和我一同出游。"
                                                },
                                                {
                                                    "id": "711350227",
                                                    "speaker": "浮锦",
                                                    "text": "#对了，{NICKNAME}！在你走之前，还有一件事…"
                                                },
                                                {
                                                    "id": "711350228",
                                                    "speaker": "浮锦",
                                                    "text": "无论是灵渊还是我，都给你们添了太多太多的麻烦。我的仙力也稍稍恢复一些了，还请让我为你们献上真正的祝福，护佑你们接下来的旅途吧。"
                                                },
                                                {
                                                    "id": "711350229",
                                                    "speaker": "Black Screen",
                                                    "text": "「采彼佳茗，酌我芳兰。白华凝露，翠叶垂烟。」\\n「时物向晚，岁聿其安。浮怀所思，永矢弗谖。」\\n「愿言相从，同此清欢。锦瑟在御，行与君还。」"
                                                },
                                                {
                                                    "id": "711350230",
                                                    "speaker": "浮锦",
                                                    "text": "呵呵，好了！这样一来，应该就没问题啦！",
                                                    "choices": [
                                                        {
                                                            "id": "711350231",
                                                            "text": "谢谢。",
                                                            "response": [
                                                                {
                                                                    "id": "711350234",
                                                                    "speaker": "浮锦",
                                                                    "text": "#那么，再一次…谢谢你们，{NICKNAME}和派蒙，谢谢你们为我，为沉玉谷做的一切。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711350232",
                                                            "text": "总觉得好像没什么变化…",
                                                            "response": [
                                                                {
                                                                    "id": "711350233",
                                                                    "speaker": "浮锦",
                                                                    "text": "毕竟「福运」也不是一下子就能看出来的呢。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711350215",
                                            "text": "能帮上忙就好。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711350203",
                            "text": "#不愧是本{M#少爷}{F#小姐}！",
                            "response": [
                                {
                                    "id": "711350204",
                                    "speaker": "派蒙",
                                    "text": "喂！都过去那么久了，就别再用那种奇怪的说话方式啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}