        {
            "id": "7452803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745280301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7452804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745280401",
                    "speaker": "丝柯克",
                    "text": "是你啊。我们的旅途，又交汇到了一起。",
                    "choices": [
                        {
                            "id": "745280402",
                            "text": "丝柯克，好久不见。",
                            "response": [
                                {
                                    "id": "745280404",
                                    "speaker": "丝柯克",
                                    "text": "我在观察这个世界留下的「伤疤」。那次爆炸将这里夷为废墟…"
                                },
                                {
                                    "id": "745280405",
                                    "speaker": "丝柯克",
                                    "text": "但如今，人们又在废墟之上建起了新的东西。"
                                },
                                {
                                    "id": "745280406",
                                    "speaker": "丝柯克",
                                    "text": "万物皆有终点，但凋亡之后，亦会孕育新的可能。"
                                },
                                {
                                    "id": "745280407",
                                    "speaker": "丝柯克",
                                    "text": "你的力量比上次见面时又成长了些。看来你没有懈怠锻炼。不错。",
                                    "choices": [
                                        {
                                            "id": "745280408",
                                            "text": "其实，我有一个小小的请求…",
                                            "response": [
                                                {
                                                    "id": "745280410",
                                                    "speaker": "丝柯克",
                                                    "text": "留影吗？对这个世界而言，我只是过客，又何必留下存在的印记呢？",
                                                    "choices": [
                                                        {
                                                            "id": "745280411",
                                                            "text": "但对我而言，你不是过客。",
                                                            "response": [
                                                                {
                                                                    "id": "745280413",
                                                                    "speaker": "丝柯克",
                                                                    "text": "…既然是你想做的事，那就去做吧。"
                                                                },
                                                                {
                                                                    "id": "745280414",
                                                                    "speaker": "丝柯克",
                                                                    "text": "我就在这里。随时可以开始。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745280412",
                                                            "text": "每次重逢都值得纪念。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745280409",
                                            "text": "我希望能为你拍张画片。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745280403",
                            "text": "你在这里做什么呢？"
                        }
                    ]
                }
            ]
        }
    ]
