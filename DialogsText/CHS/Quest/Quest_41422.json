    "talks": [
        {
            "id": "4142205",
            "objective": "完成一次「洛蒂娅的愤怒」挑战 (完成后需返回单人模式以继续)",
            "dialogues": [
                {
                    "id": "414220501",
                    "speaker": "老芬奇",
                    "text": "潺潺…向前…"
                }
            ]
        },
        {
            "id": "4142201",
            "objective": "与嫣朵拉对话",
            "dialogues": [
                {
                    "id": "414220101",
                    "speaker": "嫣朵拉",
                    "text": "我已经和洛蒂娅说明白了。"
                },
                {
                    "id": "414220102",
                    "speaker": "嫣朵拉",
                    "text": "她是我们纯水精灵密探中最为有名，也是最为强大的一位。不过她却怀揣着对上一任水之神的思念，叛逃了枫丹。"
                },
                {
                    "id": "414220103",
                    "speaker": "嫣朵拉",
                    "text": "我也已经回不去枫丹了，所以我就全部告诉你们吧。"
                },
                {
                    "id": "414220104",
                    "speaker": "嫣朵拉",
                    "text": "我们纯水精灵曾经分布在全大陆的山川河流、小池溪水之中，绝大部分都是枫丹的间谍。"
                },
                {
                    "id": "414220105",
                    "speaker": "派蒙",
                    "text": "呜啊！水之神究竟在计划着什么？"
                },
                {
                    "id": "414220106",
                    "speaker": "嫣朵拉",
                    "text": "曾经的那位没有什么计划，只是想要像是水系一样，贯通大陆，把大家联系在一起。可随着她的消逝，许多精灵切断了和枫丹的联系。"
                },
                {
                    "id": "414220107",
                    "speaker": "嫣朵拉",
                    "text": "就像是最强大的洛蒂娅，并不认可新的水之神，只想怀抱着曾经的梦活下去而已。洛蒂娅她，只想要一方静水。"
                },
                {
                    "id": "414220108",
                    "speaker": "嫣朵拉",
                    "text": "但是她察觉到了我，误以为我是枫丹的刺客。所以她散出恶意，变苦河流，想要消灭我。"
                },
                {
                    "id": "414220109",
                    "speaker": "派蒙",
                    "text": "可是你当初明明这么弱小，她至于这么大费周章嘛？"
                },
                {
                    "id": "414220110",
                    "speaker": "嫣朵拉",
                    "text": "纯水精灵的主导意识，很容易因为融合了一个有恶念的小意识就崩溃的。"
                },
                {
                    "id": "414220111",
                    "speaker": "嫣朵拉",
                    "text": "我很向往洛蒂娅，所以靠着寄宿水史莱姆，在水系间跳跃，远离枫丹来到了这里。"
                },
                {
                    "id": "414220112",
                    "speaker": "嫣朵拉",
                    "text": "除了背负任务的刺客，应该没有别的纯水精灵能有我这样的执着吧。"
                },
                {
                    "id": "414220113",
                    "speaker": "派蒙",
                    "text": "某种程度上，是听起来挺厉害的…"
                },
                {
                    "id": "414220114",
                    "speaker": "派蒙",
                    "text": "#不过我也一样，是被{NICKNAME}载着迟早要横跨七国的人哦。和我的伟绩相比，你还差了点。"
                },
                {
                    "id": "414220115",
                    "speaker": "Player",
                    "text": "喂。"
                },
                {
                    "id": "414220116",
                    "speaker": "嫣朵拉",
                    "text": "我已经和她解释清楚了，水的苦味应该不久就会消失了。最后她还询问我，是否还想要融入轻策之水。"
                },
                {
                    "id": "414220117",
                    "speaker": "派蒙",
                    "text": "所以你是来告别的吗？"
                },
                {
                    "id": "414220118",
                    "speaker": "嫣朵拉",
                    "text": "我还有一条信息需要传达呢。请你们陪我再去一次清泉镇吧。"
                }
            ]
        },
        {
            "id": "4142202",
            "objective": "前往清泉镇与老芬奇对话",
            "dialogues": [
                {
                    "id": "414220201",
                    "speaker": "嫣朵拉",
                    "text": "芬奇，芬奇！"
                },
                {
                    "id": "414220202",
                    "speaker": "老芬奇",
                    "text": "哎哟，吓我一跳。"
                },
                {
                    "id": "414220203",
                    "speaker": "派蒙",
                    "text": "嫣朵拉她学习东西进步神速。会被吓到也是当然的。"
                },
                {
                    "id": "414220204",
                    "speaker": "老芬奇",
                    "text": "只是觉得，会喊我芬奇，真像是她啊…"
                },
                {
                    "id": "414220205",
                    "speaker": "派蒙",
                    "text": "啊…"
                },
                {
                    "id": "414220206",
                    "speaker": "嫣朵拉",
                    "text": "「每天都有一个孩子蹒跚向前，世间一切由他自己去发现。他的所见变成了他的一部分——」"
                },
                {
                    "id": "414220207",
                    "speaker": "老芬奇",
                    "text": "「这个孩子蹒跚向前，如此一生的时间。」"
                },
                {
                    "id": "414220208",
                    "speaker": "老芬奇",
                    "text": "我知道这首诗。"
                },
                {
                    "id": "414220209",
                    "speaker": "嫣朵拉",
                    "text": "我们的生命和你们的生命有很大不同。所以可能我们在活着的时候，无法互相理解。"
                },
                {
                    "id": "414220210",
                    "speaker": "嫣朵拉",
                    "text": "但是我们的生命，也都是一样的。一直都在迎接新事物和新转机的过程里，奔流到海。"
                },
                {
                    "id": "414220211",
                    "speaker": "嫣朵拉",
                    "text": "所以她说：「在夜空里所有星星熄灭的时候，所有溪流、所有的梦想，都能汇入同一片大海之中。那时我们终会再见的。」"
                },
                {
                    "id": "414220212",
                    "speaker": "老芬奇",
                    "text": "…嗯。"
                },
                {
                    "id": "414220213",
                    "speaker": "嫣朵拉",
                    "text": "生命之流还在前行，请你也迈开脚步，不要驻足。"
                },
                {
                    "id": "414220214",
                    "speaker": "老芬奇",
                    "text": "哈哈哈，果然是她。还是一副把我当小孩子的语气啊。"
                },
                {
                    "id": "414220215",
                    "speaker": "老芬奇",
                    "text": "好了，请让我一个人静静吧。"
                },
                {
                    "id": "414220216",
                    "speaker": "派蒙",
                    "text": "#那{NICKNAME}，我们也应该找康纳回复了。"
                }
            ]
        },
        {
            "id": "4142203",
            "objective": "前往晨曦酒庄询问康纳",
            "dialogues": [
                {
                    "id": "414220301",
                    "speaker": "康纳",
                    "text": "哦哦，你们来了。"
                },
                {
                    "id": "414220302",
                    "speaker": "康纳",
                    "text": "我猜想如果是你们出马的话，事情应该完美解决了吧？",
                    "choices": [
                        {
                            "id": "414220303",
                            "text": "那是当然。",
                            "response": [
                                {
                                    "id": "414220305",
                                    "speaker": "派蒙",
                                    "text": "大概过几天水的苦味就会消散了吧。"
                                },
                                {
                                    "id": "414220306",
                                    "speaker": "康纳",
                                    "text": "哦，我明白我明白。就算消除了源头，还得给水一点时间让它自我清洁。"
                                },
                                {
                                    "id": "414220307",
                                    "speaker": "康纳",
                                    "text": "那我就联系冒险家协会结案了。实在是太感谢两位了。"
                                }
                            ]
                        },
                        {
                            "id": "414220304",
                            "text": "虽然过程有点复杂…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4142204",
            "objective": "与嫣朵拉对话",
            "dialogues": [
                {
                    "id": "414220401",
                    "speaker": "嫣朵拉",
                    "text": "我们族群表达喜爱的方式，是把双方的水体融汇在一起。这样多个意识就可以无隔阂的相处。"
                },
                {
                    "id": "414220402",
                    "speaker": "嫣朵拉",
                    "text": "但理解世界上其他生命却没有这么简单。因此我们观察、研究、模仿，幻化出动物的样子。也可以说，它们的模样变成了我们的一部分。"
                },
                {
                    "id": "414220403",
                    "speaker": "派蒙",
                    "text": "望着流逝的河水，嫣朵拉开始了高深话题的思考。"
                },
                {
                    "id": "414220404",
                    "speaker": "嫣朵拉",
                    "text": "我以前也从来没有思考过以后的生命如何度过。我以前一直觉得和洛蒂娅融为一体就好了。"
                },
                {
                    "id": "414220405",
                    "speaker": "嫣朵拉",
                    "text": "但是洛蒂娅看起来并不开心。她自己也明白，她只是在等待着净水腐败。",
                    "choices": [
                        {
                            "id": "414220406",
                            "text": "所以你的选择是？",
                            "response": [
                                {
                                    "id": "414220408",
                                    "speaker": "嫣朵拉",
                                    "text": "不论是洛蒂娅还是清泉镇的她，似乎都不想让我走上她们的路。但是她们肯定更加讨厌枫丹的生活吧。"
                                },
                                {
                                    "id": "414220409",
                                    "speaker": "派蒙",
                                    "text": "你们这种生命真的很奇妙，所以我也没办法提出什么有用的建议。不过我觉得，生命还是过得开心一点比较好吧。"
                                },
                                {
                                    "id": "414220410",
                                    "speaker": "嫣朵拉",
                                    "text": "所以，我决定选一条从没有前人选过的路。因为和你们相处的旅行很开心，我想要以后每天都这么开心。"
                                },
                                {
                                    "id": "414220411",
                                    "speaker": "嫣朵拉",
                                    "text": "我想要和你们一起旅行。去看看生命的小溪到海之前，会经历的夹岸繁花与天际云霞。",
                                    "choices": [
                                        {
                                            "id": "414220412",
                                            "text": "当然欢迎你。",
                                            "response": [
                                                {
                                                    "id": "414220415",
                                                    "speaker": "派蒙",
                                                    "text": "#不过这样的话，被{NICKNAME}带着走遍七国的殊荣我就不能独占了呀。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "414220413",
                                            "text": "要不换掉派蒙吧。",
                                            "response": [
                                                {
                                                    "id": "414220414",
                                                    "speaker": "派蒙",
                                                    "text": "喂！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "414220407",
                            "text": "所以你拒绝了她吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4142206",
            "objective": "",
            "dialogues": [
                {
                    "id": "414220601",
                    "speaker": "康纳",
                    "text": "之前也考虑过应急方案，那就是调清泉镇的水来酿酒。杜拉夫肯定会同意的。毕竟来年没酒喝他可能会死。"
                }
            ]
        }
    ]
}