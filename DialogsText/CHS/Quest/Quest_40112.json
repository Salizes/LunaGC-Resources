        "rewards_formatted": "原石 x20, 摩拉 x20000, 大英雄的经验 x2, 精锻用魔矿 x4",
        "chapter": {
            "icon": "UI_ChapterIcon_PenumbraAdventure",
            "id": "10117",
            "num": "清夏！乐园？大秘境！其一",
            "title": "远方传来邀请函！"
        },
        "total_dialogue_lines": 201,
        "total_speaker_counts": {
            "Black Screen": 3,
            "Player": 20,
            "优菈": 25,
