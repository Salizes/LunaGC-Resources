        {
            "id": "4006603",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400660301",
                    "speaker": "派蒙",
                    "text": "哇，是新的空间！"
                },
                {
                    "id": "400660302",
                    "speaker": "奥兹",
                    "text": "与上次一样，只有万叶卿不在。"
                },
                {
                    "id": "400660303",
                    "speaker": "辛焱",
                    "text": "好，这里就交给我们几个啦。"
                }
            ]
        },
        {
            "id": "4006604",
            "objective": "探索周围寻找出口",
            "dialogues": []
        },
        {
            "id": "4006605",
            "objective": "探索周围寻找出口",
            "dialogues": []
        },
        {
            "id": "4006606",
            "objective": "沿路前进",
            "dialogues": [
                {
                    "id": "400660601",
                    "speaker": "枫原景春",
                    "text": "…好，这样就可以了。万叶，来得正好，你看我这块石头雕得如何？"
                },
                {
                    "id": "400660602",
                    "speaker": "枫原万叶",
                    "text": "灵巧有趣。"
                },
                {
                    "id": "400660603",
                    "speaker": "枫原景春",
                    "text": "呵呵，这是我从书上看来的山景。别国有许多高耸入云的名山，如有机会，真想外出看看。"
                },
                {
                    "id": "400660604",
                    "speaker": "枫原万叶",
                    "text": "您若想去，随时都能出发。"
                },
                {
                    "id": "400660605",
                    "speaker": "枫原景春",
                    "text": "话不能这么说。我是如今的家主，虽说枫原家远不比从前，可该做的事，一件都没少啊。"
                },
                {
                    "id": "400660606",
                    "speaker": "枫原景春",
                    "text": "但…像这样坚持父辈的道路，为一度陨落的家族事业倾尽所有，当真值得吗？"
                },
                {
                    "id": "400660607",
                    "speaker": "枫原万叶",
                    "text": "父亲，我…不明白。"
                },
                {
                    "id": "400660608",
                    "speaker": "枫原景春",
                    "text": "…万叶，我希望你记得一件事。"
                },
                {
                    "id": "400660609",
                    "speaker": "枫原景春",
                    "text": "家族固然重要，人却也不能拘泥于此。"
                },
                {
                    "id": "400660610",
                    "speaker": "枫原景春",
                    "text": "家因人而存在。要是我们自己过得苦闷，又谈何让家人快乐幸福呢。"
                },
                {
                    "id": "400660611",
                    "speaker": "枫原景春",
                    "text": "从前的事，影响家族甚多。可它不应是让子孙背负的重担。"
                },
                {
                    "id": "400660612",
                    "speaker": "枫原景春",
                    "text": "…如果有一天，你厌倦了无趣的生活，就丢下一切出去走走。切记，不要让生活束缚了你。"
                },
                {
                    "id": "400660613",
                    "speaker": "枫原万叶",
                    "text": "是。"
                }
            ]
        },
        {
            "id": "4006607",
            "objective": "进入道场击败对手",
            "dialogues": []
        },
        {
            "id": "4006608",
            "objective": "操控装置进入新区域",
            "dialogues": []
        },
        {
            "id": "4006609",
            "objective": "探索周围寻找出口",
            "dialogues": []
        },
        {
            "id": "4006610",
            "objective": "探索周围寻找出口",
            "dialogues": []
        },
        {
            "id": "4006611",
            "objective": "沿路前进",
            "dialogues": [
                {
                    "id": "400661101",
                    "speaker": "枫原万叶",
                    "text": "请恕我无法理解！"
                },
                {
                    "id": "400661102",
                    "speaker": "枫原景春",
                    "text": "万叶，你忘了我们之间的约定吗？"
                },
                {
                    "id": "400661103",
                    "speaker": "枫原万叶",
                    "text": "您真的要放弃这一切吗？就算…就算我们过得艰苦，可您还有我在身边啊，我难道不能帮助您吗？"
                },
                {
                    "id": "400661104",
                    "speaker": "枫原万叶",
                    "text": "您像我这么大的时候，已经在为爷爷分忧了吧。是我太无能，让您失望，还是说…"
                },
                {
                    "id": "400661105",
                    "speaker": "枫原景春",
                    "text": "万叶！"
                },
                {
                    "id": "400661106",
                    "speaker": "枫原景春",
                    "text": "…唉，你会为这些事自责，正是我作为父亲失败的证明啊。"
                },
                {
                    "id": "400661107",
                    "speaker": "枫原景春",
                    "text": "枫原家为过去的错误付出了太多太多。从你曾祖父那一辈开始，直到现在，我们都没能真正走出阴霾。"
                },
                {
                    "id": "400661108",
                    "speaker": "枫原景春",
                    "text": "锻刀是我们一族的事业，可你记住，家族的事业，未必就要是你的全部。"
                },
                {
                    "id": "400661109",
                    "speaker": "枫原景春",
                    "text": "受伤的野兽想要走出陷阱，就要忍痛舍弃被钳制的后腿。你觉得这是损失，可不离开陷阱，后果更为致命。"
                },
                {
                    "id": "400661110",
                    "speaker": "枫原景春",
                    "text": "已经够了，万叶。我身为一家之主，却没能振兴家族让你当上贵族少爷。你不埋怨我，我就挺高兴了。"
                },
                {
                    "id": "400661111",
                    "speaker": "枫原景春",
                    "text": "几代人的痛苦…就到今天为止吧。从今往后，卸下担子生活。"
                },
                {
                    "id": "400661112",
                    "speaker": "枫原景春",
                    "text": "至于舍弃家族产业的恶名，我来背负就好。"
                },
                {
                    "id": "400661113",
                    "speaker": "枫原万叶",
                    "text": "…父亲…请别这样，当不起家的恶名，可不能落在您头上。"
                },
                {
                    "id": "400661114",
                    "speaker": "枫原万叶",
                    "text": "要是真有那么一天，我也要为您分担。"
                },
                {
                    "id": "400661115",
                    "speaker": "枫原万叶",
                    "text": "再等等吧。枫原家迟早会传到我手中，等那时，再由我来处理这些。"
                }
            ]
        },
        {
            "id": "4006612",
            "objective": "进入道场击败对手",
            "dialogues": []
        },
        {
            "id": "4006613",
            "objective": "跟着声音前进",
            "dialogues": []
        },
        {
            "id": "4006614",
            "objective": "靠近「万叶」",
            "dialogues": [
                {
                    "id": "400661401",
                    "speaker": "派蒙",
                    "text": "不对，虽然样子没什么区别…可他都听不到我们说话。"
                },
                {
                    "id": "400661402",
                    "speaker": "派蒙",
                    "text": "看来这只是个幻影，不是跟我们一起来的那个万叶。"
                }
            ]
        },
        {
            "id": "4006615",
            "objective": "进入最终的房间",
            "dialogues": []
        },
        {
            "id": "4006616",
            "objective": "穿过未知空间",
            "dialogues": []
        },
        {
            "id": "4006617",
            "objective": "寻找万叶",
            "dialogues": [
                {
                    "id": "400661701",
                    "speaker": "派蒙",
                    "text": "果然又被关在这里了呀。"
                },
                {
                    "id": "400661702",
                    "speaker": "枫原万叶",
                    "text": "哈哈，也算是规律使然。"
                },
                {
                    "id": "400661703",
                    "speaker": "派蒙",
                    "text": "我们又进了幻境里的迷宫哦，不过这一次，似乎跟上次不太一样呢。"
                },
                {
                    "id": "400661704",
                    "speaker": "Black Screen",
                    "text": "讲述了这一次的见闻…"
                },
                {
                    "id": "400661705",
                    "speaker": "枫原万叶",
                    "text": "人气变淡，摆设也不那么华丽了…嗯，本该如此。"
                },
                {
                    "id": "400661706",
                    "speaker": "枫原万叶",
                    "text": "你们见到的，应该是正在没落的枫原家。"
                },
                {
                    "id": "400661707",
                    "speaker": "派蒙",
                    "text": "不过，幻境里的你像个影子一样，而且跟现在不太一样。"
                },
                {
                    "id": "400661708",
                    "speaker": "菲谢尔",
                    "text": "没错，本皇女也赞同。"
                },
                {
                    "id": "400661709",
                    "speaker": "奥兹",
                    "text": "与现在的万叶卿相比，那道幻影有更多迷茫，背负着沉重的命运。"
                },
                {
                    "id": "400661710",
                    "speaker": "莫娜",
                    "text": "确实能算是背负着沉重的命运。"
                },
                {
                    "id": "400661711",
                    "speaker": "枫原万叶",
                    "text": "说明如今的我成长了。让各位见到不成熟的我，实在抱歉。"
                },
                {
                    "id": "400661712",
                    "speaker": "枫原万叶",
                    "text": "离开稻妻之后很长一段时间里，我的生活颠沛流离。但不是坏事，我因而沉淀了。"
                },
                {
                    "id": "400661713",
                    "speaker": "枫原万叶",
                    "text": "如果我也能见到那个从前的我就好了。他见了我，定会明白的。"
                },
                {
                    "id": "400661714",
                    "speaker": "枫原万叶",
                    "text": "——人生路远，我仍需远行。"
                }
            ]
        },
        {
            "id": "4006619",
            "objective": "(test)(hide)刷新假山$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006618",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400661801",
                    "speaker": "枫原万叶",
                    "text": "跟我想的一样，盆景就是幻境的关键。"
                },
                {
                    "id": "400661802",
                    "speaker": "派蒙",
                    "text": "那我们继续去找假山吧。"
                }
            ]
        }
    ]
}