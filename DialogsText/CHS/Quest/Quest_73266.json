    "talks": [
        {
            "id": "7326601",
            "objective": "(test)和祖尔宛对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "732660101",
                    "speaker": "祖尔宛",
                    "text": "没想到你们真的完成了「祭水之仪」，真是让我惊讶。$UNRELEASED"
                },
                {
                    "id": "732660102",
                    "speaker": "派蒙",
                    "text": "你明明就是一副一点也不惊讶的样子吧！$UNRELEASED"
                },
                {
                    "id": "732660103",
                    "speaker": "祖尔宛",
                    "text": "欸嘿，别那么严肃嘛，这也是我相信你们的表现啊。$UNRELEASED"
                },
                {
                    "id": "732660104",
                    "speaker": "祖尔宛",
                    "text": "完成了「祭水之仪」，「焚真之天象」也熄灭了。$UNRELEASED"
                },
                {
                    "id": "732660105",
                    "speaker": "祖尔宛",
                    "text": "清除了困扰这里的污秽，这下我也终于可以放心了。$UNRELEASED"
                },
                {
                    "id": "732660106",
                    "speaker": "祖尔宛",
                    "text": "接下来该做什么呢，干脆大睡一觉吧，这下可要一次性睡上个几百年呢。$UNRELEASED"
                },
                {
                    "id": "732660107",
                    "speaker": "派蒙",
                    "text": "你们花灵怎么一个个都这么懒哪。$UNRELEASED"
                },
                {
                    "id": "732660108",
                    "speaker": "斯露莎",
                    "text": "你们可别带上我。$UNRELEASED"
                },
                {
                    "id": "732660109",
                    "speaker": "祖尔宛",
                    "text": "反正你们又不会留在这里陪我，你们这些人都一样啦，永远也不打算停下脚步。$UNRELEASED",
                    "choices": [
                        {
                            "id": "732660110",
                            "text": "我们还会回来的。$UNRELEASED",
                            "response": [
                                {
                                    "id": "732660112",
                                    "speaker": "祖尔宛",
                                    "text": "哎呀，我是不会再相信这种话了，毕竟已经不是第一次听了哪。$UNRELEASED"
                                },
                                {
                                    "id": "732660113",
                                    "speaker": "祖尔宛",
                                    "text": "说起这个，也不知道我那位好友现在怎么样了，你们要是见到他可要帮我问好。$UNRELEASED"
                                },
                                {
                                    "id": "732660114",
                                    "speaker": "祖尔宛",
                                    "text": "毕竟你们都是旅人嘛，总是会有机会见面的。$UNRELEASED"
                                },
                                {
                                    "id": "732660115",
                                    "speaker": "祖尔宛",
                                    "text": "哦对了，还有一件事。$UNRELEASED"
                                },
                                {
                                    "id": "732660116",
                                    "speaker": "祖尔宛",
                                    "text": "你们要是再遇到剩下的矫论团的人，就把「祭水之仪」的事情告诉他们吧。$UNRELEASED"
                                },
                                {
                                    "id": "732660117",
                                    "speaker": "祖尔宛",
                                    "text": "我可不想再处理一次这种事了。$UNRELEASED"
                                },
                                {
                                    "id": "732660118",
                                    "speaker": "派蒙",
                                    "text": "知道啦，知道啦。$UNRELEASED"
                                },
                                {
                                    "id": "732660119",
                                    "speaker": "祖尔宛",
                                    "text": "好啦，你们该回到属于你们的地方去了，可别太想我哦。$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "732660111",
                            "text": "还会有机会见面的。$UNRELEASED"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7326602",
            "objective": "(test)和凯瑟琳对话$UNRELEASED",
            "dialogues": [
                {
                    "id": "732660201",
                    "speaker": "派蒙",
                    "text": "凯瑟琳小姐，我们回来了！$UNRELEASED"
                },
                {
                    "id": "732660202",
                    "speaker": "凯瑟琳",
                    "text": "欢迎回来，我已经收到教令院的反馈了，没想到你们真的成功解决掉那个奇异天象了呢。$UNRELEASED"
                },
                {
                    "id": "732660203",
                    "speaker": "凯瑟琳",
                    "text": "可以说是超出预期了。$UNRELEASED"
                },
                {
                    "id": "732660204",
                    "speaker": "派蒙",
                    "text": "欸？我记得凯瑟琳小姐不是说，我们是最合适的人选吗？$UNRELEASED"
                },
                {
                    "id": "732660205",
                    "speaker": "派蒙",
                    "text": "该不会你对每个人都会说同样的话吧。$UNRELEASED"
                },
                {
                    "id": "732660206",
                    "speaker": "凯瑟琳",
                    "text": "怎么会，我当然相信你们可以完成这个委托了。$UNRELEASED"
                },
                {
                    "id": "732660207",
                    "speaker": "凯瑟琳",
                    "text": "对了，之前还有拜托你们先联系到「那迦朱那团」。不知道他们是不是帮上什么忙了呢？$UNRELEASED",
                    "choices": [
                        {
                            "id": "732660208",
                            "text": "有点复杂…$UNRELEASED",
                            "response": [
                                {
                                    "id": "732660210",
                                    "speaker": "凯瑟琳",
                                    "text": "看来发生了很多故事呢。$UNRELEASED"
                                },
                                {
                                    "id": "732660211",
                                    "speaker": "凯瑟琳",
                                    "text": "不过不管发生什么样的事情，都是冒险的一部分。对于冒险家来说，都是难得的宝物呢。$UNRELEASED"
                                },
                                {
                                    "id": "732660212",
                                    "speaker": "凯瑟琳",
                                    "text": "既然顺利完成了委托，协会应该也可以获得坎瑞亚遗迹的调查许可了，如果有相关委托的话，我也会优先考虑你们的。$UNRELEASED"
                                },
                                {
                                    "id": "732660213",
                                    "speaker": "派蒙",
                                    "text": "不过说起来，虽然做了这么多事情，我们都还不知道委托人是谁呢！$UNRELEASED"
                                },
                                {
                                    "id": "732660214",
                                    "speaker": "凯瑟琳",
                                    "text": "这个嘛…冒险家协会有义务为委托人保密，没办法直接向你们透露。$UNRELEASED"
                                },
                                {
                                    "id": "732660215",
                                    "speaker": "凯瑟琳",
                                    "text": "不过将信物交给我们的那位先生，倒是自称是什么轻小说作家。$UNRELEASED"
                                },
                                {
                                    "id": "732660216",
                                    "speaker": "派蒙",
                                    "text": "轻小说作家？听起来有点耳熟，我记得之前也提到过矫论团有一位前辈…$UNRELEASED"
                                },
                                {
                                    "id": "732660217",
                                    "speaker": "凯瑟琳",
                                    "text": "看来你们是知道些什么呢，不过这些事情就与协会无关了。那么教令院的报酬已经放在我这里了，就请你们收下吧。$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "732660209",
                            "text": "算是帮上忙了吧…$UNRELEASED"
                        }
                    ]
                }
            ]
        }
    ]
}