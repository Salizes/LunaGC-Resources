            "dialogues": []
        },
        {
            "id": "7404302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740430201",
                    "speaker": "恩里",
                    "text": "抗议！抗议！为我劳动的权利抗议！",
                    "choices": [
                        {
                            "id": "740430202",
                            "text": "你要的核心…",
                            "response": [
                                {
                                    "id": "740430203",
                                    "speaker": "恩里",
                                    "text": "哦？让我看看！"
                                }
                            ]
                        },
                        {
                            "id": "740430204",
                            "text": "为什么在这里抗议…",
                            "response": [
                                {
                                    "id": "740430205",
                                    "speaker": "恩里",
                                    "text": "在哪里跌倒的，就要在哪里站起来！"
                                }
                            ]
                        },
                        {
                            "id": "740430206",
                            "text": "我要干什么来着？",
                            "response": [
                                {
                                    "id": "740430207",
                                    "speaker": "恩里",
                                    "text": "真拿你没办法。在地上和水下的一些地方，有人部署了这种奇怪机器。识别的方法也很简单，机器的周围会产生很奇怪的光。"
                                },
                                {
                                    "id": "740430208",
                                    "speaker": "恩里",
                                    "text": "把它解决掉，把里面这种特定的核心带给我，一共<color=#00E1FFFF>需要七个</color>。拜托了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}