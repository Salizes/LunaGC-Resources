    "talks": [
        {
            "id": "7404312",
            "objective": "（test）判定完成$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7404310",
            "objective": "与恩里对话",
            "dialogues": []
        },
        {
            "id": "7404311",
            "objective": "与恩里对话",
            "dialogues": [
                {
                    "id": "740430301",
                    "speaker": "恩里",
                    "text": "嗯，确实收到了，七个神秘的核心。"
                },
                {
                    "id": "740430302",
                    "speaker": "Player",
                    "text": "所以核心到底是干什么用的？"
                },
                {
                    "id": "740430303",
                    "speaker": "恩里",
                    "text": "我怎么知道？老板只是说，需要七个这些神奇机器里的神奇核心。能弄到核心，就能赚大钱。"
                },
                {
                    "id": "740430304",
                    "speaker": "恩里",
                    "text": "这样好了！我跟老板约好了今天在这里见面，汇报工作进度。你们当面问他吧？反正也要等他结帐，我才能跟你分钱。"
                },
                {
                    "id": "740430305",
                    "speaker": "派蒙",
                    "text": "真拿你没办法。既然恩里这么说了，就等一会吧！"
                },
                {
                    "id": "740430306",
                    "speaker": "Black Screen",
                    "text": "等了一会…"
                },
                {
                    "id": "740430307",
                    "speaker": "「老板」",
                    "text": "亲爱的恩里，情况如何啊？"
                },
                {
                    "id": "740430308",
                    "speaker": "恩里",
                    "text": "好得很，老板！您要的七个神秘核心都收集齐全了。来来，让我介绍一下，这是我的合伙人…叫啥来着？"
                },
                {
                    "id": "740430309",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "740430310",
                    "speaker": "「老板」",
                    "text": "呃…"
                },
                {
                    "id": "740430311",
                    "speaker": "派蒙",
                    "text": "呃呃…"
                },
                {
                    "id": "740430312",
                    "speaker": "恩里",
                    "text": "哎？你们认识啊？那就好说了！事情是这样的，老板…"
                },
                {
                    "id": "740430315",
                    "speaker": "「老板」",
                    "text": "哎吔！饶命啊！"
                },
                {
                    "id": "740430316",
                    "speaker": "派蒙",
                    "text": "呜哇，这两个人好熟练…"
                },
                {
                    "id": "740430317",
                    "speaker": "恩里",
                    "text": "老板别担心，没有生命危险的！"
                },
                {
                    "id": "740430318",
                    "speaker": "亨特",
                    "text": "当然，当然。当然不会有生命危险。"
                },
                {
                    "id": "740430319",
                    "speaker": "特纳",
                    "text": "就目前而言呢。"
                },
                {
                    "id": "740430320",
                    "speaker": "「老板」",
                    "text": "就、就目前而言…？！"
                },
                {
                    "id": "740430321",
                    "speaker": "亨特",
                    "text": "接下来呢…"
                },
                {
                    "id": "740430322",
                    "speaker": "特纳",
                    "text": "是烤鸡，抑或是…烤鸡以外的东西，就取决于老板您的态度了。"
                },
                {
                    "id": "740430323",
                    "speaker": "「老板」",
                    "text": "噫噫——"
                },
                {
                    "id": "740430324",
                    "speaker": "派蒙",
                    "text": "你们怎么会在这里？"
                },
                {
                    "id": "740430325",
                    "speaker": "亨特",
                    "text": "上次，我们…有幸相遇以后，我们决定监视恩里。"
                },
                {
                    "id": "740430326",
                    "speaker": "恩里",
                    "text": "等等，为什么要监视我？"
                },
                {
                    "id": "740430327",
                    "speaker": "恩里",
                    "text": "不对，归根到底，你们为什么要针对我！明明我只是在努力工作而已！"
                },
                {
                    "id": "740430328",
                    "speaker": "特纳",
                    "text": "你拆掉的机器是枫丹科学院的人用来监测、优化水质的装置。"
                },
                {
                    "id": "740430329",
                    "speaker": "恩里",
                    "text": "哎？不是用来制造污染的机器吗？"
                },
                {
                    "id": "740430330",
                    "speaker": "亨特",
                    "text": "拆出来的核心包含着最先进的机芯和枫丹的水文数据。我们希望能…认识您的交易对象。"
                },
                {
                    "id": "740430331",
                    "speaker": "恩里",
                    "text": "哎？哎？什么？为什么？",
                    "choices": [
                        {
                            "id": "740430332",
                            "text": "恩里！你骗我！",
                            "response": [
                                {
                                    "id": "740430333",
                                    "speaker": "恩里",
                                    "text": "不对不对，你是我的大恩人，我怎么可能骗你啊！"
                                },
                                {
                                    "id": "740430335",
                                    "speaker": "恩里",
                                    "text": "老板，你骗我！你竟然骗我把这么重要的东西弄坏了！"
                                },
                                {
                                    "id": "740430336",
                                    "speaker": "「老板」",
                                    "text": "我、我不是故意…我只是最下面的…"
                                },
                                {
                                    "id": "740430337",
                                    "speaker": "特纳",
                                    "text": "啊啊？老板，说的什么胡话我没听清，我还以为您说自己「不是故意」…您再说一遍？"
                                },
                                {
                                    "id": "740430338",
                                    "speaker": "「老板」",
                                    "text": "噫噫——"
                                },
                                {
                                    "id": "740430339",
                                    "speaker": "亨特",
                                    "text": "这位老板看来是累了。睁着眼晕过去了。"
                                },
                                {
                                    "id": "740430340",
                                    "speaker": "派蒙",
                                    "text": "呃呃，我、我们也不是故意的…"
                                },
                                {
                                    "id": "740430341",
                                    "speaker": "特纳",
                                    "text": "关于这个嘛。我们决定，不追究了。"
                                },
                                {
                                    "id": "740430342",
                                    "speaker": "派蒙",
                                    "text": "欸？没关系吗？"
                                },
                                {
                                    "id": "740430343",
                                    "speaker": "亨特",
                                    "text": "反正只要核心完好，其中的数据完好，机器根本没所谓。"
                                },
                                {
                                    "id": "740430344",
                                    "speaker": "特纳",
                                    "text": "上面说了没所谓。反正不能跟你们过不去。"
                                },
                                {
                                    "id": "740430345",
                                    "speaker": "Player",
                                    "text": "有什么跟我过不去的？"
                                },
                                {
                                    "id": "740430346",
                                    "speaker": "亨特",
                                    "text": "没什么，没什么。您瞧…"
                                },
                                {
                                    "id": "740430347",
                                    "speaker": "特纳",
                                    "text": "我们只是在散步而已。"
                                },
                                {
                                    "id": "740430348",
                                    "speaker": "亨特",
                                    "text": "真是偶遇，不是吗？美好的天气，美好的邂逅。"
                                },
                                {
                                    "id": "740430349",
                                    "speaker": "特纳",
                                    "text": "但是美好的邂逅总会结束。我们该…告别了。"
                                },
                                {
                                    "id": "740430350",
                                    "speaker": "亨特",
                                    "text": "就让美好的邂逅留在心中，或者…"
                                },
                                {
                                    "id": "740430351",
                                    "speaker": "特纳",
                                    "text": "忘了更好。忘了更好。"
                                },
                                {
                                    "id": "740430352",
                                    "speaker": "恩里",
                                    "text": "欸…所以我们没事了？"
                                },
                                {
                                    "id": "740430353",
                                    "speaker": "亨特",
                                    "text": "怎么，你想有什么事？"
                                },
                                {
                                    "id": "740430354",
                                    "speaker": "恩里",
                                    "text": "没事没事！哈哈，当然没事了！"
                                },
                                {
                                    "id": "740430355",
                                    "speaker": "恩里",
                                    "text": "唉，本来我还以为遇上了好心人，总算能通过劳动改变命运了。到头来，这世上还是坏人多！"
                                },
                                {
                                    "id": "740430356",
                                    "speaker": "特纳",
                                    "text": "…喂，恩里。来搭把手。"
                                },
                                {
                                    "id": "740430357",
                                    "speaker": "恩里",
                                    "text": "啊？"
                                },
                                {
                                    "id": "740430358",
                                    "speaker": "亨特",
                                    "text": "真是不幸啊，这位好心的老板神志不清了。"
                                },
                                {
                                    "id": "740430359",
                                    "speaker": "特纳",
                                    "text": "我们需要一位…"
                                },
                                {
                                    "id": "740430360",
                                    "speaker": "亨特",
                                    "text": "干活认真。"
                                },
                                {
                                    "id": "740430361",
                                    "speaker": "特纳",
                                    "text": "忠实可靠。"
                                },
                                {
                                    "id": "740430362",
                                    "speaker": "亨特",
                                    "text": "希望用劳动改变命运的…好朋友。"
                                },
                                {
                                    "id": "740430363",
                                    "speaker": "特纳",
                                    "text": "没错，一位好朋友。来帮忙把这位好老板带到我们的安全屋去。"
                                },
                                {
                                    "id": "740430364",
                                    "speaker": "亨特",
                                    "text": "我们才方便…好好跟这位好心的老板聊聊。"
                                },
                                {
                                    "id": "740430365",
                                    "speaker": "特纳",
                                    "text": "当然了，我们会充分地…表达我们的谢意。通过摩拉。"
                                },
                                {
                                    "id": "740430366",
                                    "speaker": "恩里",
                                    "text": "嗯？嗯！算我一个！"
                                },
                                {
                                    "id": "740430367",
                                    "speaker": "恩里",
                                    "text": "太好了！谢谢你们！也很感谢你们，那个…"
                                },
                                {
                                    "id": "740430368",
                                    "speaker": "Player",
                                    "text": "#我是{NICKNAME}，她是派蒙。"
                                },
                                {
                                    "id": "740430369",
                                    "speaker": "恩里",
                                    "text": "#谢谢你们，{NICKNAME}、派蒙！遇到你们以后，我的命运都改变啦！"
                                },
                                {
                                    "id": "740430370",
                                    "speaker": "派蒙",
                                    "text": "不用谢！要加油哦，恩里！不要再被骗了！"
                                },
                                {
                                    "id": "740430371",
                                    "speaker": "恩里",
                                    "text": "嗯！不会的！我要努力工作，成为大富翁！以后雇佣别人给我干活！"
                                },
                                {
                                    "id": "740430372",
                                    "speaker": "Black Screen",
                                    "text": "亨特、特纳和恩里将不省人事的愚人众挖了出来，带走了。"
                                },
                                {
                                    "id": "740430373",
                                    "speaker": "派蒙",
                                    "text": "希望恩里能获得幸福呢…"
                                },
                                {
                                    "id": "740430374",
                                    "speaker": "派蒙",
                                    "text": "等等！恩里说好的，给我们的报酬呢？！"
                                }
                            ]
                        },
                        {
                            "id": "740430334",
                            "text": "震惊！我们被骗了！"
                        }
                    ]
                }
            ]
        },
