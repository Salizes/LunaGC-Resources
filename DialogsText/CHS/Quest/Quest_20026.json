    "talks": [
        {
            "id": "2002601",
            "objective": "前往猎鹿人餐馆询问莎拉",
            "dialogues": [
                {
                    "id": "200260101",
                    "speaker": "莎拉",
                    "text": "餐品外送订单"
                },
                {
                    "id": "200260102",
                    "speaker": "莎拉",
                    "text": "旅行者，你来的正好——"
                },
                {
                    "id": "200260103",
                    "speaker": "莎拉",
                    "text": "咦？你说你只是来吃东西的…"
                },
                {
                    "id": "200260104",
                    "speaker": "莎拉",
                    "text": "我，我知道了，但是请你帮我个忙吧，我一定会把最好吃的料理给你！"
                },
                {
                    "id": "200260105",
                    "speaker": "莎拉",
                    "text": "晨曦酒庄的恩内斯特先生经常在我们这里订下酒菜，而且总是会提出各种奇怪的加料要求。"
                },
                {
                    "id": "200260106",
                    "speaker": "莎拉",
                    "text": "嗯…这次他虽然订的是<color=#00E1FFFF>炸萝卜丸子</color>，但他一定要我们多加蛋类，可我们的蛋类料理材料都用光了。"
                },
                {
                    "id": "200260107",
                    "speaker": "莎拉",
                    "text": "所以，请你帮我们找两颗鸟蛋回来吧。",
                    "choices": [
                        {
                            "id": "200260108",
                            "text": "好吧，但是…",
                            "response": [
                                {
                                    "id": "200260109",
                                    "speaker": "莎拉",
                                    "text": "在风起地，应该可以找到很多鸟蛋。"
                                },
                                {
                                    "id": "200260110",
                                    "speaker": "莎拉",
                                    "text": "那么，就拜托你了！"
                                }
                            ]
                        },
                        {
                            "id": "200260111",
                            "text": "太饿了，我只是来吃饭的。",
                            "response": [
                                {
                                    "id": "200260112",
                                    "speaker": "莎拉",
                                    "text": "在风起地，应该可以找到很多鸟蛋。"
                                },
                                {
                                    "id": "200260113",
                                    "speaker": "莎拉",
                                    "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2002602",
            "objective": "与莎拉对话",
            "dialogues": []
        },
        {
            "id": "2002603",
            "objective": "找到两颗鸟蛋",
            "dialogues": [
                {
                    "id": "200260301",
                    "speaker": "Player",
                    "text": "这是你点的餐。"
                },
                {
                    "id": "200260302",
                    "speaker": "恩内斯特",
                    "text": "哦！是按照我的要求特制的<color=#00E1FFFF>炸萝卜丸子</color>啊。"
                },
                {
                    "id": "200260303",
                    "speaker": "恩内斯特",
                    "text": "果然，加了蛋类之后，口感和香气都更好了。"
                },
                {
                    "id": "200260304",
                    "speaker": "恩内斯特",
                    "text": "哈哈哈，我的品味果然是最棒的！"
                },
                {
                    "id": "200260305",
                    "speaker": "恩内斯特",
                    "text": "对了，这是餐费，辛苦你了。"
                }
            ]
        },
        {
            "id": "2002604",
            "objective": "取得制作好的餐品",
            "dialogues": [
                {
                    "id": "200260201",
                    "speaker": "Player",
                    "text": "已经找好了。"
                },
                {
                    "id": "200260202",
                    "speaker": "莎拉",
                    "text": "这下子材料就够了，稍等一下…"
                },
                {
                    "id": "200260203",
                    "speaker": "莎拉",
                    "text": "好啦，拜托你把这份特制的<color=#00E1FFFF>炸萝卜丸子</color>送给恩内斯特先生吧。"
                },
                {
                    "id": "200260204",
                    "speaker": "莎拉",
                    "text": "别这么看着我嘛，我知道你肚子很饿了。"
                },
                {
                    "id": "200260205",
                    "speaker": "莎拉",
                    "text": "回来的时候，我会用猎鹿人餐馆特制料理来答谢你的！"
                }
            ]
        },
