    "talks": [
        {
            "id": "4014705",
            "objective": "等待至次日的6时至8时",
            "dialogues": []
        },
        {
            "id": "4014701",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "401470101",
                    "speaker": "言笑",
                    "text": "#早啊，{NICKNAME}！掌柜的跟我说了，上回来的新老顾客，对你的评价都非常好！"
                },
                {
                    "id": "401470102",
                    "speaker": "言笑",
                    "text": "我之前还担心你适应不了呢，现在看起来以你的本事，日常工作是足够应付了。"
                },
                {
                    "id": "401470103",
                    "speaker": "言笑",
                    "text": "除非来位口味又挑剔，要求又严苛的客人，否则还真难不倒你…"
                },
                {
                    "id": "401470104",
                    "speaker": "派蒙",
                    "text": "哇，还会有这种客人吗？"
                },
                {
                    "id": "401470105",
                    "speaker": "言笑",
                    "text": "那可不，尤其是那些菜没做几道，书读了一堆的老学究！"
                },
                {
                    "id": "401470106",
                    "speaker": "言笑",
                    "text": "没事就来挑你哪里做的不合古法、哪里做的跟几百年前的老味道有区别…"
                },
                {
                    "id": "401470107",
                    "speaker": "？？？",
                    "text": "——这里就是望舒客栈？也算是一家老字号了吧…"
                },
                {
                    "id": "401470108",
                    "speaker": "Player",
                    "text": "这声音是…"
                },
                {
                    "id": "401470109",
                    "speaker": "珐露珊",
                    "text": "店家！有什么招牌名菜，就快点招待上来吧！要最贵的！"
                },
                {
                    "id": "401470110",
                    "speaker": "派蒙",
                    "text": "珐露珊！…前！前辈好…"
                },
                {
                    "id": "401470111",
                    "speaker": "珐露珊",
                    "text": "#呀！{NICKNAME}，派蒙？你们怎么在这儿？"
                },
                {
                    "id": "401470112",
                    "speaker": "派蒙",
                    "text": "我们还想问呢，你怎么突然就有经费来旅游了？还直接点了最贵的菜…"
                },
                {
                    "id": "401470113",
                    "speaker": "珐露珊",
                    "text": "哼哼，这可不是旅游哦。像我这样的学者，受邀成为「随船顾问」满世界出差，也只是家常便饭而已…"
                },
                {
                    "id": "401470114",
                    "speaker": "莱依拉",
                    "text": "珐露珊前辈…请…请慢一点…呼…明明昨晚大家都在熬夜，怎么就前辈还这么精神？她真有一百来岁了吗…"
                },
                {
                    "id": "401470115",
                    "speaker": "多莉",
                    "text": "哈…哈…从我说要请客开始，她就一直这样了…真是失策…"
                },
                {
                    "id": "401470116",
                    "speaker": "派蒙",
                    "text": "莱依拉！还有多莉？真是少见的组合…"
                },
                {
                    "id": "401470117",
                    "speaker": "Player",
                    "text": "总之先歇一会儿吧…"
                },
                {
                    "id": "401470118",
                    "speaker": "Black Screen",
                    "text": "你们招待三人入座，并说明了自己正在望舒客栈帮忙的事情…"
                },
                {
                    "id": "401470119",
                    "speaker": "珐露珊",
                    "text": "原来是这样…你还真是个大忙人呢。"
                },
                {
                    "id": "401470120",
                    "speaker": "珐露珊",
                    "text": "不过既然连这里的主厨都认可你的话，也不用担心吃不上正宗的招牌菜了吧！"
                },
                {
                    "id": "401470121",
                    "speaker": "派蒙",
                    "text": "所以你们又是为什么来璃月的啊？刚才好像听到了什么「随船顾问」…"
                },
                {
                    "id": "401470122",
                    "speaker": "多莉",
                    "text": "嚯嚯，我前阵子从枫丹弄了一条新船，上面装了最先进的导航机关！如果能推广出去，那可是大大的商机！"
                },
                {
                    "id": "401470123",
                    "speaker": "多莉",
                    "text": "最近几天正在试行呢：从奥摩斯港到离岛，从离岛到璃月港，后面还打算去荆夫港…"
                },
                {
                    "id": "401470124",
                    "speaker": "莱依拉",
                    "text": "我跟前辈就是受雇来帮忙调试罗盘、调整机关的。昨晚为了压力测试，还在云来海上漂了一整夜…"
                },
                {
                    "id": "401470125",
                    "speaker": "Player",
                    "text": "这是非法加班吗…"
                },
                {
                    "id": "401470126",
                    "speaker": "多莉",
                    "text": "会…会有加班补贴的！两位也都是自愿的，签合同的时候特意提过的！"
                },
                {
                    "id": "401470127",
                    "speaker": "派蒙",
                    "text": "你还真是滴水不漏…所以「请客」也算是补贴之一吗？难怪一上来就点贵的。"
                },
                {
                    "id": "401470128",
                    "speaker": "珐露珊",
                    "text": "哼哼，「想吃什么就吃什么！」——这种机会可不多见！那就先来一份…"
                },
                {
                    "id": "401470129",
                    "speaker": "多莉",
                    "text": "咳！珐露珊…前辈，我当然也很想用最~贵的菜慰劳你们啦，但贵，不一定就是好嘛！"
                },
                {
                    "id": "401470130",
                    "speaker": "多莉",
                    "text": "我听说璃月菜里最贵的几样，不是要用很多海鲜，就是要费很长的功夫…"
                },
                {
                    "id": "401470131",
                    "speaker": "多莉",
                    "text": "可是我们都在海上晃了这么多天，再吃什么鱼啊虾啊，也尝不出好味道来吧？"
                },
                {
                    "id": "401470132",
                    "speaker": "珐露珊",
                    "text": "呃，你这么一说，还真是这样…"
                },
                {
                    "id": "401470133",
                    "speaker": "多莉",
                    "text": "——而且莱依拉小姐，看着都快饿晕了！"
                },
                {
                    "id": "401470134",
                    "speaker": "莱依拉",
                    "text": "欸？我不是因为饿…"
                },
                {
                    "id": "401470135",
                    "speaker": "多莉",
                    "text": "…想必年高德劭的珐露珊前辈，一定不忍心让后辈继续饿着肚子等吧！"
                },
                {
                    "id": "401470136",
                    "speaker": "珐露珊",
                    "text": "唔，要照顾后辈的话，我是没意见…不过怎么总觉得上套了…"
                },
                {
                    "id": "401470137",
                    "speaker": "多莉",
                    "text": "#所以，需要花大把时间来熬的菜也别上了！除此以外，有什么贵就上什么吧。交给你咯，{NICKNAME}！"
                }
            ]
        },
        {
            "id": "4014706",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "401470401",
                    "speaker": "言笑",
                    "text": "…既要贵，又不能见海鲜，还不能花时间…这大半的老菜就都被排除了吧？究竟是谁提的要求，居然这么刁钻？"
                },
                {
                    "id": "401470402",
                    "speaker": "派蒙",
                    "text": "多莉这家伙！该不会是故意的吧？"
                },
                {
                    "id": "401470403",
                    "speaker": "Player",
                    "text": "估计就是故意的…"
                },
                {
                    "id": "401470404",
                    "speaker": "言笑",
                    "text": "我们客栈跟琉璃亭、新月轩也不一样，不会常备什么名贵的食材，一般都是有客人预定才会去准备。"
                },
                {
                    "id": "401470405",
                    "speaker": "言笑",
                    "text": "要用寻常食材，在短时间内做一道货真价实的高价菜…那贵的就只能是厨师的「功夫」跟菜肴的「创意」了。"
                },
                {
                    "id": "401470406",
                    "speaker": "言笑",
                    "text": "#{NICKNAME}，我知道一道叫做「繁弦急管」的菜，用现成的食材就能做，出菜也不费时，一盘售价…三万摩拉！"
                },
                {
                    "id": "401470407",
                    "speaker": "派蒙",
                    "text": "——三万！不是说用料普通，也不费时间吗？为什么会那么贵？"
                },
                {
                    "id": "401470408",
                    "speaker": "言笑",
                    "text": "这道菜的「功夫」不在于时间，而在于厨师对刀工跟火候的把控。"
                },
                {
                    "id": "401470409",
                    "speaker": "言笑",
                    "text": "要用多种不同的肉类切作细丝，揉制成条，最后再下锅煎炒，主打口味多变，层层递进。"
                },
                {
                    "id": "401470410",
                    "speaker": "言笑",
                    "text": "如何令几种不同的肉凝而不散，一起达到各自合适的熟度，味道又不相互冲突，才是这道菜真正可贵的地方！"
                },
                {
                    "id": "401470411",
                    "speaker": "言笑",
                    "text": "做好了，就是一等一的名菜；做糟了，可就成一盘肉末了。"
                },
                {
                    "id": "401470412",
                    "speaker": "派蒙",
                    "text": "哦——我懂了，所以这道菜贵的不是菜，而是你的出场费啊！"
                },
                {
                    "id": "401470413",
                    "speaker": "Player",
                    "text": "说得我都不太自信了…"
                },
                {
                    "id": "401470414",
                    "speaker": "言笑",
                    "text": "没事，揉条之类的琐碎工序，我可以帮你搞定。你专心对付最紧要的环节就好。"
                },
                {
                    "id": "401470415",
                    "speaker": "派蒙",
                    "text": "放心大胆地去试吧，就算做糟了，你做的肉末我也喜欢吃！"
                }
            ]
        },
        {
            "id": "4014702",
            "objective": "烹制「繁弦急管」",
            "dialogues": [
                {
                    "id": "401470201",
                    "speaker": "派蒙",
                    "text": "菜来咯！各位慢用——"
                },
                {
                    "id": "401470202",
                    "speaker": "珐露珊",
                    "text": "哦哦，闻着很香呀！"
                },
                {
                    "id": "401470203",
                    "speaker": "多莉",
                    "text": "#…啊，对了对了，派蒙跟{NICKNAME}也没吃早餐吧，干脆一块坐下？"
                },
                {
                    "id": "401470204",
                    "speaker": "派蒙",
                    "text": "咦，多莉什么时候这么好心了…居然会有免费的早餐…"
                },
                {
                    "id": "401470205",
                    "speaker": "多莉",
                    "text": "嚯嚯，大生意都是在宴席上谈成的嘛…来来来坐坐坐！大家都不用客气！"
                },
                {
                    "id": "401470206",
                    "speaker": "多莉",
                    "text": "（这道菜看起来平平无奇，我又事先做过调查，应该不会花很多摩拉吧！不怕一万，就怕三万…）"
                },
                {
                    "id": "401470207",
                    "speaker": "珐露珊",
                    "text": "#（这道菜，能抵得过一晚上的熬夜吗？…能不能吃回本，可就看你了啊，{NICKNAME}！）"
                },
                {
                    "id": "401470208",
                    "speaker": "莱依拉",
                    "text": "（好累…好困…好想睡…快点吃完回去睡…）"
                },
                {
                    "id": "401470209",
                    "speaker": "Black Screen",
                    "text": "几人各怀心事，各自动筷…"
                },
                {
                    "id": "401470210",
                    "speaker": "莱依拉",
                    "text": "这是…鸡腿肉？不对，又好像是蕈猪的口感…"
                },
                {
                    "id": "401470211",
                    "speaker": "珐露珊",
                    "text": "每嚼一口都是不同的滋味…仔细尝起来，还有点烟熏的风味…真是不可思议，到底是怎么做出来的？"
                },
                {
                    "id": "401470212",
                    "speaker": "Player",
                    "text": "是火腿，我加了火腿。"
                },
                {
                    "id": "401470213",
                    "speaker": "珐露珊",
                    "text": "火腿？可是这盘菜里哪里有——啊！"
                },
                {
                    "id": "401470214",
                    "speaker": "派蒙",
                    "text": "嘿嘿，已经有人发现了？没错，每根肉条都是用不同的肉丝揉成的！费了我跟言笑好大的劲呢！"
                },
                {
                    "id": "401470215",
                    "speaker": "莱依拉",
                    "text": "可是，虽然我也不太清楚…不同的肉类，熟透的时间应该也不一样吧？可这道菜搭配得却很和谐…"
                },
                {
                    "id": "401470216",
                    "speaker": "派蒙",
                    "text": "#呃…呃…这就是{NICKNAME}的商业机密了！",
                    "choices": [
                        {
                            "id": "401470217",
                            "text": "没别的，只是熟练了。",
                            "response": [
                                {
                                    "id": "401470219",
                                    "speaker": "珐露珊",
                                    "text": "没想到这还是你的独门菜式呢，算是没白来一趟。对了，这道菜有名字吗？"
                                },
                                {
                                    "id": "401470220",
                                    "speaker": "派蒙",
                                    "text": "啊，我都忘了介绍了，这道菜的名字叫「繁弦急管」——既是在描述丝条交错的外观，也是在…"
                                },
                                {
                                    "id": "401470221",
                                    "speaker": "珐露珊",
                                    "text": "…描述复杂多变的口感？是从璃月的俗语里起的吧？"
                                },
                                {
                                    "id": "401470222",
                                    "speaker": "珐露珊",
                                    "text": "原意应该是多种乐器同时演奏，热闹纷呈…嗯，放到这里也算贴切。"
                                },
                                {
                                    "id": "401470223",
                                    "speaker": "派蒙",
                                    "text": "欸…原来你知道啊…"
                                },
                                {
                                    "id": "401470224",
                                    "speaker": "珐露珊",
                                    "text": "每个年轻人在毕业前都该学会至少二十种语言吧。咦…难道现在没这要求了？"
                                },
                                {
                                    "id": "401470225",
                                    "speaker": "莱依拉",
                                    "text": "——欸？以前有过的吗！"
                                },
                                {
                                    "id": "401470226",
                                    "speaker": "派蒙",
                                    "text": "差点忘了你也是知论派的…"
                                },
                                {
                                    "id": "401470227",
                                    "speaker": "多莉",
                                    "text": "那…那个…这道菜的价格是…"
                                },
                                {
                                    "id": "401470228",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿——不多不多，承惠摩拉三万！"
                                },
                                {
                                    "id": "401470229",
                                    "speaker": "多莉",
                                    "text": "三…三万！哈…哈哈…"
                                },
                                {
                                    "id": "401470230",
                                    "speaker": "多莉",
                                    "text": "#话说回来…派蒙、{NICKNAME}，我之前是让你们「一块坐下」…没说要连你们一起请客吧？"
                                },
                                {
                                    "id": "401470231",
                                    "speaker": "多莉",
                                    "text": "…所以这是不是得算…拼桌？"
                                },
                                {
                                    "id": "401470232",
                                    "speaker": "派蒙",
                                    "text": "——果然没有免费的早餐啊！",
                                    "choices": [
                                        {
                                            "id": "401470233",
                                            "text": "三万而已，对你来说不算破费吧。",
                                            "response": [
                                                {
                                                    "id": "401470234",
                                                    "speaker": "派蒙",
                                                    "text": "就是就是！商人要重信誉！"
                                                },
                                                {
                                                    "id": "401470235",
                                                    "speaker": "多莉",
                                                    "text": "呜…一枚摩拉也是钱啊！"
                                                },
                                                {
                                                    "id": "401470239",
                                                    "speaker": "多莉",
                                                    "text": "唉，成吧…就当作交学费了。"
                                                },
                                                {
                                                    "id": "401470240",
                                                    "speaker": "多莉",
                                                    "text": "…等回了须弥，我一定要请人把这菜复现出来，再狠狠地赚一笔！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401470236",
                                            "text": "打八折吧，回头我跟掌柜说一声。",
                                            "response": [
                                                {
                                                    "id": "401470237",
                                                    "speaker": "派蒙",
                                                    "text": "你啊…行吧，反正贵的也是你的出场费。"
                                                },
                                                {
                                                    "id": "401470238",
                                                    "speaker": "多莉",
                                                    "text": "三万打八折…呜，还是有点心疼…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401470218",
                            "text": "我有独特的烹饪手法。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014703",
            "objective": "为等待已久的须弥一行人上菜",
            "dialogues": []
        },
        {
            "id": "4014704",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "401470301",
                    "speaker": "言笑",
                    "text": "今早算是开了个好头啊，接下来也拜托你们了！"
                },
                {
                    "id": "401470302",
                    "speaker": "Black Screen",
                    "text": "你与派蒙忙里忙外，直到打烊。来客纷纭，口味众多，留下的好评却出奇一致。"
                }
            ]
        },
        {
            "id": "4014792",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479201",
                    "speaker": "言笑",
                    "text": "油、盐、酱、醋…嗯，储备都很充足，够用过这阵了。"
                }
            ]
        },
        {
            "id": "4014793",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479301",
                    "speaker": "淮安",
                    "text": "#哟，{NICKNAME}，今年算是开了个好头呀。"
                }
            ]
        },
        {
            "id": "4014794",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479401",
                    "speaker": "珐露珊",
                    "text": "虽然没吃上仙跳墙跟腌笃鲜…不过「繁弦急管」也很不赖嘛，多谢你啦。"
                },
                {
                    "id": "401479402",
                    "speaker": "Player",
                    "text": "没想到你会接跟遗迹无关的委托…"
                },
                {
                    "id": "401479403",
                    "speaker": "珐露珊",
                    "text": "这个嘛…虽然新式机关确实不在我的专业范畴之内，不过多莉提出的报酬也很诱人…"
                },
                {
                    "id": "401479404",
                    "speaker": "珐露珊",
                    "text": "——每到一个新港口，都能上街淘点古籍带回去研究！"
                },
                {
                    "id": "401479405",
                    "speaker": "珐露珊",
                    "text": "呵，不枉我用最低的报价，吓跑了所有妙论派的竞争者！"
                }
            ]
        },
        {
            "id": "4014795",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479501",
                    "speaker": "言笑",
                    "text": "据说当年曾有高人可以调和整整五种肉类，而我这道菜才只用到三种，实在惭愧。"
                }
            ]
        },
        {
            "id": "4014796",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479601",
                    "speaker": "多莉",
                    "text": "不要海鲜、不要费时。别的就都交给你啦，嘿嘿！"
                },
                {
                    "id": "401479602",
                    "speaker": "珐露珊",
                    "text": "唔…仙跳墙腌笃鲜金丝虾球黄金蟹…都只能下次再试了吗？下次还得等多少年呢…"
                },
                {
                    "id": "401479603",
                    "speaker": "莱依拉",
                    "text": "#珐露珊前辈一下子变得好消沉…{NICKNAME}，能麻烦你尽量选贵点的菜吗？"
                }
            ]
        },
        {
            "id": "4014797",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479701",
                    "speaker": "多莉",
                    "text": "该怎么把便宜的食材做成高价的菜呢…先从起一个好名字开始吗…",
                    "choices": [
                        {
                            "id": "401479702",
                            "text": "话说你一开始提的条件…",
                            "response": [
                                {
                                    "id": "401479704",
                                    "speaker": "多莉",
                                    "text": "啊…哈哈——果然被你发现了。"
                                },
                                {
                                    "id": "401479705",
                                    "speaker": "多莉",
                                    "text": "唉，昨晚答应下来的时候，看大家又熬夜又晕船，我就想着第二天也吃不了多少…结果嘛，你也看见了。"
                                },
                                {
                                    "id": "401479706",
                                    "speaker": "多莉",
                                    "text": "后来又加了那么多限制，没想到照样难不倒你！唉，不事先做好市场调查，就是会变成这样啦。"
                                },
                                {
                                    "id": "401479707",
                                    "speaker": "派蒙",
                                    "text": "明明她们俩的咨询费都不高，说到底还是你贪小便宜嘛！下次可别这样咯！"
                                },
                                {
                                    "id": "401479708",
                                    "speaker": "Player",
                                    "text": "论贪小便宜…你也没好多少吧。"
                                },
                                {
                                    "id": "401479709",
                                    "speaker": "派蒙",
                                    "text": "我…我…所以我才有那么多经验教训嘛！"
                                }
                            ]
                        },
                        {
                            "id": "401479703",
                            "text": "还有选择望舒客栈的原因…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4014798",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401479801",
                    "speaker": "莱依拉",
                    "text": "吃完饭感觉精神多了，好吃的东西确实可以提神呢。"
                },
                {
                    "id": "401479802",
                    "speaker": "Player",
                    "text": "没想到你会接这么费神的委托…"
                },
                {
                    "id": "401479803",
                    "speaker": "莱依拉",
                    "text": "哈哈…导师说，年轻人不该一直埋在论文和书本里，让我抓住机会出来，看看各地的星空。"
                },
                {
                    "id": "401479804",
                    "speaker": "莱依拉",
                    "text": "嗯…就当作「提前实习」了？不过还真是累人啊…呼…"
                }
            ]
        }
    ]
}