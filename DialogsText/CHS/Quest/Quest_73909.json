            "dialogues": [
                {
                    "id": "739090101",
                    "speaker": "Player",
                    "text": "美丽…温柔…"
                },
                {
                    "id": "739090102",
                    "speaker": "娜斯米儿",
                    "text": "嘘，小声点！可别让她听见了。"
                },
                {
                    "id": "739090103",
                    "speaker": "娜斯米儿",
                    "text": "每次我一说这些话，她就嫌我啰嗦，然后一整天不理我，我可不要。"
                },
                {
                    "id": "739090104",
                    "speaker": "娜斯米儿",
                    "text": "实不相瞒，我就是因为罗莎娜姐姐才离开镀金旅团来这里工作的。"
                },
                {
                    "id": "739090105",
                    "speaker": "娜斯米儿",
                    "text": "罗莎娜姐姐果然英明决断。在这里工作，确实比接教令院的委托自由多了！"
                },
                {
                    "id": "739090106",
                    "speaker": "娜斯米儿",
                    "text": "咳咳…这些话你都不许跟她讲哦。给你做点好吃的，当作封口费！"
                }
            ]
        }
    ]
}