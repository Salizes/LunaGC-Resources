    "talks": [
        {
            "id": "7334808",
            "objective": "",
            "dialogues": [
                {
                    "id": "733480801",
                    "speaker": "赛达菲",
                    "text": "再次感谢您的帮助，如果您以后需要我的帮助，请尽管开口。"
                }
            ]
        },
        {
            "id": "7334806",
            "objective": "寻找普尔比鲁尼一门的学者",
            "dialogues": [
                {
                    "id": "733480901",
                    "speaker": "伊丽丝",
                    "text": "唉，就这么一点经费，我怎么推进研究…",
                    "choices": [
                        {
                            "id": "733480902",
                            "text": "那个，抱歉打扰一下…",
                            "response": [
                                {
                                    "id": "733480904",
                                    "speaker": "伊丽丝",
                                    "text": "普尔比鲁尼一门的学者？喔，你是来找赛达菲的吧，真稀奇…居然有人来找他。"
                                },
                                {
                                    "id": "733480905",
                                    "speaker": "伊丽丝",
                                    "text": "他最近正好在教令院里办事，应该就在附近…你找他有什么事吗？"
                                },
                                {
                                    "id": "733480906",
                                    "speaker": "Player",
                                    "text": "关于海迪夫的举荐信…"
                                },
                                {
                                    "id": "733480907",
                                    "speaker": "伊丽丝",
                                    "text": "海迪夫？他的研究已经结束了吗？有钱真是好啊，能够请一整支队伍陪着自己去考察…"
                                },
                                {
                                    "id": "733480908",
                                    "speaker": "伊丽丝",
                                    "text": "而我，连田野考察的补贴都申请不下来…"
                                },
                                {
                                    "id": "733480909",
                                    "speaker": "Player",
                                    "text": "你知道海迪夫？"
                                },
                                {
                                    "id": "733480910",
                                    "speaker": "伊丽丝",
                                    "text": "当然了，我们这些为经费头疼，又不怎么会赚钱的学者，早就对他的财力广有耳闻了。"
                                },
                                {
                                    "id": "733480911",
                                    "speaker": "派蒙",
                                    "text": "呜哇，那…这个海迪夫…他们家族的学者，是不是都特别有钱呀？"
                                },
                                {
                                    "id": "733480912",
                                    "speaker": "派蒙",
                                    "text": "那我们是不是可以拿到很多报酬了？"
                                },
                                {
                                    "id": "733480913",
                                    "speaker": "伊丽丝",
                                    "text": "才没有呢，海迪夫这家伙是个特例，你可别对普尔比鲁尼和普尔希娜两家的学者产生什么错觉。"
                                },
                                {
                                    "id": "733480914",
                                    "speaker": "伊丽丝",
                                    "text": "特别是主修星象学，辅修历史和生物的那一支…就凭这几个研究方向，运气不好连经费都申请不下来。"
                                },
                                {
                                    "id": "733480915",
                                    "speaker": "伊丽丝",
                                    "text": "而且他们还说什么「金钱不能作为智慧的报酬」…"
                                },
                                {
                                    "id": "733480916",
                                    "speaker": "伊丽丝",
                                    "text": "咳，我好像说太多了…赛达菲就在那边，其他的事你就去问问他吧。"
                                }
                            ]
                        },
                        {
                            "id": "733480903",
                            "text": "关于普尔比鲁尼一门的学者…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334801",
            "objective": "寻找赛达菲",
            "dialogues": [
                {
                    "id": "733480101",
                    "speaker": "赛达菲",
                    "text": "但是…如果没有那些样本的话…",
                    "choices": [
                        {
                            "id": "733480102",
                            "text": "关于普尔比鲁尼一门…",
                            "response": [
                                {
                                    "id": "733480104",
                                    "speaker": "赛达菲",
                                    "text": "是的。我是普尔比鲁尼一门现在的「诃般荼」，请问您找我有什么事？"
                                },
                                {
                                    "id": "733480105",
                                    "speaker": "赛达菲",
                                    "text": "是关于学术问题吗？但看您的装束，并不像是教令院里的学者…"
                                },
                                {
                                    "id": "733480106",
                                    "speaker": "Player",
                                    "text": "关于海迪夫的举荐信…"
                                },
                                {
                                    "id": "733480107",
                                    "speaker": "赛达菲",
                                    "text": "这是海迪夫…海迪夫学弟的亲笔信？稍等，容我看一看…"
                                },
                                {
                                    "id": "733480108",
                                    "speaker": "赛达菲",
                                    "text": "嗯，看来他在层岩巨渊的研究推进得很顺利。"
                                },
                                {
                                    "id": "733480109",
                                    "speaker": "赛达菲",
                                    "text": "…菌类调查…水生环境…古代生物化石…特殊的地质环境…样本…"
                                },
                                {
                                    "id": "733480110",
                                    "speaker": "赛达菲",
                                    "text": "很好，很好，很好！他的学术嗅觉和考察能力还是如此优秀，果然没令我失望！"
                                },
                                {
                                    "id": "733480111",
                                    "speaker": "赛达菲",
                                    "text": "哼…虽然不是太愿意在外人面前承认，但普尔希娜门人的学术能力，还是值得信任的呀…"
                                },
                                {
                                    "id": "733480112",
                                    "speaker": "赛达菲",
                                    "text": "而且，海迪夫在信里也强调了很多次您对他的巨大帮助。"
                                },
                                {
                                    "id": "733480113",
                                    "speaker": "赛达菲",
                                    "text": "在您的帮助下，他的研究就如同「猛虎插上了翅膀一样顺利」啊！",
                                    "choices": [
                                        {
                                            "id": "733480114",
                                            "text": "不用再重复一遍了…",
                                            "response": [
                                                {
                                                    "id": "733480116",
                                                    "speaker": "赛达菲",
                                                    "text": "是这样吗？咳，是我失态了。"
                                                },
                                                {
                                                    "id": "733480117",
                                                    "speaker": "赛达菲",
                                                    "text": "等他回到教令院，普尔希娜一门的学术史册上，一定又将添上光辉的一笔…"
                                                },
                                                {
                                                    "id": "733480118",
                                                    "speaker": "赛达菲",
                                                    "text": "呃…还有，我们两个师门之间的千年友谊，也一定会大大增进的！"
                                                },
                                                {
                                                    "id": "733480119",
                                                    "speaker": "赛达菲",
                                                    "text": "总而言之！我同时代表普尔比鲁尼和普尔希娜，再次感谢您。"
                                                },
                                                {
                                                    "id": "733480120",
                                                    "speaker": "赛达菲",
                                                    "text": "对了，他在信里还拜托我为您准备一些礼物…这没有问题，请您稍等一会。"
                                                },
                                                {
                                                    "id": "733480121",
                                                    "speaker": "Player",
                                                    "text": "您不会也给我一封信做报酬吧…"
                                                },
                                                {
                                                    "id": "733480122",
                                                    "speaker": "赛达菲",
                                                    "text": "那当然不会！您辛苦劳碌，帮助海迪夫四处考察，付您摩拉是再自然不过的事了。"
                                                },
                                                {
                                                    "id": "733480123",
                                                    "speaker": "赛达菲",
                                                    "text": "但…请您原谅，我今天出门太过匆忙，没有带多少摩拉。如果您愿意的话，还请在这里稍等我一会…"
                                                },
                                                {
                                                    "id": "733480124",
                                                    "speaker": "派蒙",
                                                    "text": "虽然都是很为各自门派自豪的学者…但他和海迪夫的样子完全不一样呢。"
                                                },
                                                {
                                                    "id": "733480125",
                                                    "speaker": "派蒙",
                                                    "text": "看起来好像…真没有多少钱的样子…"
                                                },
                                                {
                                                    "id": "733480126",
                                                    "speaker": "赛达菲",
                                                    "text": "怎，怎么会呢？我们普尔比鲁尼一门可是学者世家，绝不可能有财物上的困扰…"
                                                },
                                                {
                                                    "id": "733480127",
                                                    "speaker": "赛达菲",
                                                    "text": "只不过，我们将大部分的财物都投入了研究之中，在研究之外…就会略显拮据。"
                                                },
                                                {
                                                    "id": "733480128",
                                                    "speaker": "赛达菲",
                                                    "text": "但这并不妨碍我们的研究，不如说，正因为我们没有被物欲遮蔽双眼，所以才能将智慧的道路看得更加清楚。"
                                                },
                                                {
                                                    "id": "733480129",
                                                    "speaker": "赛达菲",
                                                    "text": "我这就回去为您准备报酬。但在这之前，我还有一个不情之请…"
                                                },
                                                {
                                                    "id": "733480130",
                                                    "speaker": "赛达菲",
                                                    "text": "我看海迪夫在信中写道，您的身手十分矫健，战斗经验也十分丰富，是一位出类拔萃的，万里挑一的精锐冒险家…"
                                                },
                                                {
                                                    "id": "733480131",
                                                    "speaker": "赛达菲",
                                                    "text": "如果！如果您愿意的话，能帮我一个忙吗？在不久之前，为了调查一处地区的地质环境，我一个人进入沙漠考察…"
                                                },
                                                {
                                                    "id": "733480132",
                                                    "speaker": "赛达菲",
                                                    "text": "因为…我没多少钱，所以没有雇佣护卫。我想着，如果快去快回，应该也不会有什么风险…"
                                                },
                                                {
                                                    "id": "733480133",
                                                    "speaker": "赛达菲",
                                                    "text": "但我运气实在不好，考察结束后，在回去的路上被盗宝团袭击了。"
                                                },
                                                {
                                                    "id": "733480134",
                                                    "speaker": "赛达菲",
                                                    "text": "虽然我安全逃回了城里，也没有受伤，但装着所有地质样本和笔记的箱子却丢了。"
                                                },
                                                {
                                                    "id": "733480135",
                                                    "speaker": "赛达菲",
                                                    "text": "在商人和盗宝团的眼里，那个箱子也许根本就不值钱…但在我眼里！这箱子里的东西价值连城，无可替代！"
                                                },
                                                {
                                                    "id": "733480136",
                                                    "speaker": "赛达菲",
                                                    "text": "我一时半会找不到愿意帮忙的冒险家…旅行者，能请您帮帮我吗？",
                                                    "choices": [
                                                        {
                                                            "id": "733480137",
                                                            "text": "我会帮忙的。",
                                                            "response": [
                                                                {
                                                                    "id": "733480139",
                                                                    "speaker": "赛达菲",
                                                                    "text": "太感谢了！没有您，我都不知道如何是好了…"
                                                                },
                                                                {
                                                                    "id": "733480140",
                                                                    "speaker": "赛达菲",
                                                                    "text": "我这就把被袭击的地点标在地图上，那个箱子一定就在那附近！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733480138",
                                                            "text": "包在我身上。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480115",
                                            "text": "我已经听他说过了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480103",
                            "text": "请问您是普尔比鲁尼的学者吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334802",
            "objective": "寻找赛达菲的箱子",
            "dialogues": [
                {
                    "id": "733480201",
                    "speaker": "达拉",
                    "text": "等一下！等一下！停手！别打了！"
                },
                {
                    "id": "733480202",
                    "speaker": "达拉",
                    "text": "呼…呼…就一箱子书，没必要下这么狠的手，你要的话，全都给你。",
                    "choices": [
                        {
                            "id": "733480203",
                            "text": "就只有这些？",
                            "response": [
                                {
                                    "id": "733480205",
                                    "speaker": "达拉",
                                    "text": "我对天发誓！我们在这里就只挖到了这一个箱子！"
                                },
                                {
                                    "id": "733480206",
                                    "speaker": "达拉",
                                    "text": "除了书之外，里面还有一些石头和装在瓶子里的泥巴…石头里面嘛，倒是有些好看的宝石…"
                                },
                                {
                                    "id": "733480207",
                                    "speaker": "Player",
                                    "text": "你们把这些宝石拿走了吗？"
                                },
                                {
                                    "id": "733480208",
                                    "speaker": "派蒙",
                                    "text": "喂！把那些宝石全部还回来！那都是珍贵的地质样本！"
                                },
                                {
                                    "id": "733480209",
                                    "speaker": "达拉",
                                    "text": "地质…样本…",
                                    "choices": [
                                        {
                                            "id": "733480210",
                                            "text": "还回来。",
                                            "response": [
                                                {
                                                    "id": "733480212",
                                                    "speaker": "达拉",
                                                    "text": "还！还！全都还！快快快，把东西都放进箱子里…"
                                                },
                                                {
                                                    "id": "733480213",
                                                    "speaker": "达拉",
                                                    "text": "东西…东西都放在箱子里了，兄弟们就先走了…哈哈哈…"
                                                },
                                                {
                                                    "id": "733480214",
                                                    "speaker": "派蒙",
                                                    "text": "赛达菲想找的东西应该都在里面啦，我们把箱子拿回去给他吧。"
                                                },
                                                {
                                                    "id": "733480215",
                                                    "speaker": "派蒙",
                                                    "text": "但他居然一个人进了沙漠，还挖了这么多地质样本，记了这么多笔记，真是一位了不起的学者啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480211",
                                            "text": "我数到三。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480204",
                            "text": "还有其他的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334807",
            "objective": "打倒盗宝团",
            "dialogues": []
        },
        {
            "id": "7334803",
            "objective": "与达拉对话",
            "dialogues": []
        },
        {
            "id": "7334805",
            "objective": "向赛达菲回报",
            "dialogues": [
                {
                    "id": "733480301",
                    "speaker": "赛达菲",
                    "text": "旅行者，您回来了，请问我的箱子…",
                    "choices": [
                        {
                            "id": "733480302",
                            "text": "就在这里。",
                            "response": [
                                {
                                    "id": "733480304",
                                    "speaker": "赛达菲",
                                    "text": "太好了！非常感谢您…唉，您拿着举荐信来来访，我却让您如此辛劳，真是太不好意思了…这些摩拉还请您收下。",
                                    "choices": [
                                        {
                                            "id": "733480305",
                                            "text": "你们不是说…",
                                            "response": [
                                                {
                                                    "id": "733480306",
                                                    "speaker": "赛达菲",
                                                    "text": "咦？您连这句话也知道吗？我们普尔比鲁尼一门里确实有这种训诫…"
                                                },
                                                {
                                                    "id": "733480307",
                                                    "speaker": "赛达菲",
                                                    "text": "但这句话只是用来劝诫我们，在任何时候都不能因为钱财或其他外部原因而动摇研究的原则。"
                                                },
                                                {
                                                    "id": "733480308",
                                                    "speaker": "赛达菲",
                                                    "text": "毕竟，如果一个研究者将逐利作为自己的首要学术原则，那么…他就不配做一个研究者了。"
                                                },
                                                {
                                                    "id": "733480309",
                                                    "speaker": "赛达菲",
                                                    "text": "但您为了帮助我辛苦奔波，理应获得一份数量合理的报酬。"
                                                },
                                                {
                                                    "id": "733480310",
                                                    "speaker": "赛达菲",
                                                    "text": "再次感谢您的帮助，如果您以后需要我的帮助，请尽管开口。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480311",
                                            "text": "「金钱不能作为智慧的报酬」吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480303",
                            "text": "已经拿回来了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334804",
            "objective": "向海迪夫回报",
            "dialogues": [
                {
                    "id": "733480401",
                    "speaker": "海迪夫",
                    "text": "欸，你怎么回来了，找到普尔比鲁尼一门的人了吗？应该没费多大劲吧。",
                    "choices": [
                        {
                            "id": "733480402",
                            "text": "找是找到了…",
                            "response": [
                                {
                                    "id": "733480404",
                                    "speaker": "海迪夫",
                                    "text": "嗯？你怎么一副欲言又止的样子，你不会被人给为难了吧？"
                                },
                                {
                                    "id": "733480405",
                                    "speaker": "Black Screen",
                                    "text": "向海迪夫讲述了和赛达菲有关的事…"
                                },
                                {
                                    "id": "733480406",
                                    "speaker": "海迪夫",
                                    "text": "赛达菲学长啊…他可是出了名的死心眼，有时候连老师都对付不来他…"
                                },
                                {
                                    "id": "733480407",
                                    "speaker": "海迪夫",
                                    "text": "而且还拒绝所有资助，坚持自己研究，说要保持自己研究的纯洁性…"
                                },
                                {
                                    "id": "733480408",
                                    "speaker": "派蒙",
                                    "text": "这就是「金钱不能作为智慧的报酬」吗…"
                                },
                                {
                                    "id": "733480409",
                                    "speaker": "海迪夫",
                                    "text": "这是他们普尔比鲁尼一门学者的研究原则…哈哈，我们普尔希娜一门没有这么迂腐就是啦。"
                                },
                                {
                                    "id": "733480410",
                                    "speaker": "海迪夫",
                                    "text": "唔…也不能这么说，只是我比较有钱而已。",
                                    "choices": [
                                        {
                                            "id": "733480411",
                                            "text": "你是怎么赚钱的？",
                                            "response": [
                                                {
                                                    "id": "733480413",
                                                    "speaker": "海迪夫",
                                                    "text": "你怎么这么一副怀疑的样子？我的这些钱也是我辛苦打拼出来的啊，你知道做期货交易有多麻烦吗？",
                                                    "choices": [
                                                        {
                                                            "id": "733480414",
                                                            "text": "期、期货交易？",
                                                            "response": [
                                                                {
                                                                    "id": "733480416",
                                                                    "speaker": "海迪夫",
                                                                    "text": "做期货交易…又要关注货物交易量，又要关注市场动向，还要权衡投资的方向…"
                                                                },
                                                                {
                                                                    "id": "733480417",
                                                                    "speaker": "海迪夫",
                                                                    "text": "我最开始只是投一点钱玩玩，不想影响我的研究。"
                                                                },
                                                                {
                                                                    "id": "733480418",
                                                                    "speaker": "海迪夫",
                                                                    "text": "但谁知道…唉！谁知道我越赚越多，放在交易所里的钱也越来越多…"
                                                                },
                                                                {
                                                                    "id": "733480419",
                                                                    "speaker": "海迪夫",
                                                                    "text": "我的本职是学者啊！我想要做研究，我想要做学术！我想要的是学术成果，不是摩拉成果！我一直这么告诫自己…"
                                                                },
                                                                {
                                                                    "id": "733480420",
                                                                    "speaker": "海迪夫",
                                                                    "text": "但只要待在须弥城里，我就不由自主地走进交易所，一笔又一笔地做期货交易。"
                                                                },
                                                                {
                                                                    "id": "733480421",
                                                                    "speaker": "海迪夫",
                                                                    "text": "我账上的钱是越来越多，但我的学术研究一点进展都没有！"
                                                                },
                                                                {
                                                                    "id": "733480422",
                                                                    "speaker": "海迪夫",
                                                                    "text": "所以！我才请了这么多人，一起进入层岩巨渊里考察。只有待在这个没有交易所的地方，我才能安心开展学术研究！"
                                                                },
                                                                {
                                                                    "id": "733480423",
                                                                    "speaker": "海迪夫",
                                                                    "text": "如果研究不出成果，我…我就不从层岩巨渊里出去了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733480415",
                                                            "text": "你用期货交易来赚钱？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480412",
                                            "text": "那你为什么这么有钱？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480403",
                            "text": "发生了一些事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733480501",
                    "speaker": "赛达菲",
                    "text": "那就拜托您了，我稍后就去准备报酬。"
                }
            ]
        },
        {
            "id": "7334810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733481001",
                    "speaker": "伊丽丝",
                    "text": "到底怎么才能把经费申请下来呢…唉…"
                }
            ]
        },
        {
            "id": "7334811",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733481101",
                    "speaker": "哈瓦",
                    "text": "我还是去休息一下吧。看了太多文献，头都有些晕了…"
                }
            ]
        },
        {
            "id": "7334899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733489901",
                    "speaker": "派蒙",
                    "text": "既然来了教令院，那我们…顺便找找海迪夫说的「普尔比鲁尼一门」吧。但是，从哪里开始呢…"
                },
                {
                    "id": "733489902",
                    "speaker": "伊丽丝",
                    "text": "（不行不行，不能再去尝试交易期货了，再这样赔下去，我连饭都要吃不起了…）"
                },
                {
                    "id": "733489903",
                    "speaker": "哈瓦",
                    "text": "（这些古文字…彼此交叠…）"
                },
                {
                    "id": "733489904",
                    "speaker": "赛达菲",
                    "text": "（海迪夫…好像是普尔希娜那边的来着？这位旅行者怎么会有他的亲笔信…）"
                },
                {
                    "id": "733489905",
                    "speaker": "派蒙",
                    "text": "唔，应该就在这附近了。我们…开始挖吧…"
                },
                {
                    "id": "733489906",
                    "speaker": "赛达菲",
                    "text": "（太好了，没有被破坏太多…）"
                },
                {
                    "id": "733489907",
                    "speaker": "赛达菲",
                    "text": "（如果没有那些样本的话…）"
                }
            ]
        }
    ]
}