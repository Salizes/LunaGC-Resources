    "talks": [
        {
            "id": "4019301",
            "objective": "与一斗对话",
            "dialogues": [
                {
                    "id": "401930101",
                    "speaker": "荒泷一斗",
                    "text": "哦！挚友，听说你们昨晚去了「秋沙钱汤」对吧？"
                },
                {
                    "id": "401930102",
                    "speaker": "荒泷一斗",
                    "text": "我打算叫上所有人，再去「秋沙钱汤」好好地庆上一回功！怎么样？你也去吧！"
                },
                {
                    "id": "401930103",
                    "speaker": "派蒙",
                    "text": "欸，可是昨晚不是已经去过一次了吗…"
                },
                {
                    "id": "401930104",
                    "speaker": "荒泷一斗",
                    "text": "呃…你看这不是还有昨晚没去成的吗？比如阿忍…五郎…还有绫人兄弟…"
                },
                {
                    "id": "401930105",
                    "speaker": "久岐忍",
                    "text": "简单来说，是老大听说过后，自己很想去。"
                },
                {
                    "id": "401930106",
                    "speaker": "荒泷一斗",
                    "text": "总…总之！你要是逛得差不多了，就来跟我说一声，大家一起去泡！温！泉！"
                }
            ]
        },
        {
            "id": "4019304",
            "objective": "随一斗离开会场",
            "dialogues": [
                {
                    "id": "401930501",
                    "speaker": "Player",
                    "text": "要出发了！"
                },
                {
                    "id": "401930502",
                    "speaker": "荒泷一斗",
                    "text": "好嘞！目标——「秋沙钱汤」！"
                }
            ]
        },
        {
            "id": "4019302",
            "objective": "前往「秋沙钱汤」",
            "dialogues": [
                {
                    "id": "401930201",
                    "speaker": "Black Screen",
                    "text": "在一斗的连番催促下，众人再次前往秋沙钱汤…"
                },
                {
                    "id": "401930202",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈！这里应该就是最热的了！今天我们就来比一比，谁能在温泉里坚持最久！"
                },
                {
                    "id": "401930203",
                    "speaker": "托马",
                    "text": "呵呵，一斗兄如此盛情，我又怎么能不奉陪呢？"
                },
                {
                    "id": "401930204",
                    "speaker": "久岐忍",
                    "text": "我说…这又不是在蒸桑拿…"
                },
                {
                    "id": "401930205",
                    "speaker": "早柚",
                    "text": "温泉…好暖和…呼呼…"
                },
                {
                    "id": "401930206",
                    "speaker": "派蒙",
                    "text": "不、不要在浴池里睡着啊！"
                },
                {
                    "id": "401930207",
                    "speaker": "五郎",
                    "text": "唔…毛皮变得好重，感觉有点头晕…"
                },
                {
                    "id": "401930208",
                    "speaker": "荒泷一斗",
                    "text": "哈哈哈！五郎兄弟！可别说这就不行了啊！"
                },
                {
                    "id": "401930209",
                    "speaker": "九条裟罗",
                    "text": "喂——浴场内禁止喧哗！"
                },
                {
                    "id": "401930210",
                    "speaker": "Black Screen",
                    "text": "与此同时，在另一边…"
                },
                {
                    "id": "401930211",
                    "speaker": "神里绫人",
                    "text": "呵呵，一斗兄弟还是那么有精神啊。"
                },
                {
                    "id": "401930212",
                    "speaker": "神里绫华",
                    "text": "兄长，对局中分神可不好哦。"
                },
                {
                    "id": "401930213",
                    "speaker": "宵宫",
                    "text": "#嚯嚯——比赛已经来到了最焦灼的阶段！{NICKNAME}会怎么应对呢！两位大师！你们有什么看法？"
                },
                {
                    "id": "401930214",
                    "speaker": "珊瑚宫心海",
                    "text": "嗯…如果是我的话，会考虑步步为营，巩固优势。"
                },
                {
                    "id": "401930215",
                    "speaker": "鹿野院平藏",
                    "text": "唔，积极进攻，险中求胜…也是一个好办法。",
                    "choices": [
                        {
                            "id": "401930216",
                            "text": "（稳扎稳打…）",
                            "response": [
                                {
                                    "id": "401930218",
                                    "speaker": "神里绫人",
                                    "text": "哦？竟有如此妙手？看来我败局已定，不必继续了。那按照之前抽签的顺序，接下来就该轮到…"
                                },
                                {
                                    "id": "401930219",
                                    "speaker": "神里绫人",
                                    "text": "绫华，要玩得开心哦。"
                                },
                                {
                                    "id": "401930220",
                                    "speaker": "神里绫华",
                                    "text": "#啊…好！好的！{NICKNAME}，请多指教…"
                                },
                                {
                                    "id": "401930221",
                                    "speaker": "Player",
                                    "text": "（绫人这家伙，怕不是想让绫华多玩一会儿故意输的吧…）"
                                }
                            ]
                        },
                        {
                            "id": "401930217",
                            "text": "（搏上一把！）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4019303",
            "objective": "前往「秋沙钱汤」",
            "dialogues": [
                {
                    "id": "401930301",
                    "speaker": "蓝川丞",
                    "text": "老板！这「三川花祭」可真不错！这几天来我们这儿的游客数量，比平时翻了三倍啊！"
                },
                {
                    "id": "401930302",
                    "speaker": "蓝川丞",
                    "text": "这个月的营业金额…恐怕能上这个数！"
                },
                {
                    "id": "401930303",
                    "speaker": "梦见月瑞希",
                    "text": "很不错嘛，看来这个月，说不定能正面击败八重堂…"
                },
                {
                    "id": "401930304",
                    "speaker": "八重神子",
                    "text": "什么事情这么高兴？怎么不叫上我？"
                },
                {
                    "id": "401930305",
                    "speaker": "梦见月瑞希",
                    "text": "啊哈…也没什么…"
                },
                {
                    "id": "401930306",
                    "speaker": "八重神子",
                    "text": "哦，我倒是有个好消息忘了跟你分享…"
                },
                {
                    "id": "401930307",
                    "speaker": "八重神子",
                    "text": "「三川花祭」的三成收益，都会划到八重堂的账上哦。这个月应该能创纪录了吧？来恭喜我吧。"
                },
                {
                    "id": "401930308",
                    "speaker": "梦见月瑞希",
                    "text": "什么——！"
                },
                {
                    "id": "401930309",
                    "speaker": "蓝川丞",
                    "text": "那…那不如，恭喜老板在第三百三十三次挑战八重堂营收的尝试中，取得了亚军的好成绩！"
                },
                {
                    "id": "401930310",
                    "speaker": "八重神子",
                    "text": "呵呵呵…"
                },
                {
                    "id": "401930311",
                    "speaker": "影",
                    "text": "…祝愿今夜，人人皆得「好梦」。"
                }
            ]
        },
        {
            "id": "4019304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401930401",
                    "speaker": "荒泷一斗",
                    "text": "怎么样？要出发了吗？要出发了吗！"
                }
            ]
        },
        {
            "id": "4019306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401930601",
                    "speaker": "Player",
                    "text": "再等等…"
                },
                {
                    "id": "401930602",
                    "speaker": "荒泷一斗",
                    "text": "你不会也跟阿晃他们一样沉迷游艺了吧…虽然游艺是很好玩，但先泡完温泉也不迟嘛！"
                }
            ]
        },
        {
            "id": "4019307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401930701",
                    "speaker": "阿守",
                    "text": "欸？你没跟老大他们去泡温泉吗？"
                },
                {
                    "id": "401930702",
                    "speaker": "Player",
                    "text": "你们怎么不去？"
                },
                {
                    "id": "401930703",
                    "speaker": "阿晃",
                    "text": "…我们以前跟老大去过一次。但老大当时突发奇想，突然就开始比赛…"
                },
                {
                    "id": "401930704",
                    "speaker": "Player",
                    "text": "比赛什么？"
                },
                {
                    "id": "401930705",
                    "speaker": "元太",
                    "text": "…忘了，只记得当时差点就热晕过去了。"
                }
            ]
        }
    ]
}