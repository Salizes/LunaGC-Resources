    "talks": [
        {
            "id": "7507301",
            "objective": "(test)杀怪$HIDDEN",
            "dialogues": [
                {
                    "id": "750730101",
                    "speaker": "？？？",
                    "text": "啊，恩人！哎呀，恩人，多谢你出手相助…清理了这些丘丘人。"
                },
                {
                    "id": "750730102",
                    "speaker": "？？？",
                    "text": "实不相瞒，我刚才只是站在山崖上看风景，一个不注意就被丘丘人敲晕了脑袋，醒来的时候就在这儿关着啦。"
                },
                {
                    "id": "750730103",
                    "speaker": "？？？",
                    "text": "关着，对钥匙…啊，钥匙就在那边的箱子上，能不能请您再伸出您的贵手，帮我一个微不足道的小忙？"
                },
                {
                    "id": "750730104",
                    "speaker": "？？？",
                    "text": "小女子我一定感激不尽…"
                }
            ]
        },
        {
            "id": "7507302",
            "objective": "(test)与笼中的女子对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7507303",
            "objective": "(test)靠近钥匙$HIDDEN",
            "dialogues": [
                {
                    "id": "750730301",
                    "speaker": "？？？",
                    "text": "呜呜，终于能从这个笼子里出来了。"
                },
                {
                    "id": "750730302",
                    "speaker": "？？？",
                    "text": "这个热气球晃晃荡荡的，嘿，说不定来上一阵风，整个笼子都得被掀下去…"
                },
                {
                    "id": "750730303",
                    "speaker": "？？？",
                    "text": "那时候估计就连黑曜石奶奶都没办法救我啦。"
                },
                {
                    "id": "750730304",
                    "speaker": "Player",
                    "text": "你是谁，为什么在这？"
                },
                {
                    "id": "750730305",
                    "speaker": "科奴拉芙",
                    "text": "啊，我还没做自我介绍，我啊，我的名字叫科奴拉芙，是「烟谜主」的实习祭司…"
                },
                {
                    "id": "750730306",
                    "speaker": "科奴拉芙",
                    "text": "现在正在祭司的修行途中，嗯…之前一直待在部族里，所以部族里的长辈跟我说，「你总得出去见见世面吧！」"
                },
                {
                    "id": "750730307",
                    "speaker": "科奴拉芙",
                    "text": "于是就以进行修行为名把我一脚踢出了部族的大门——"
                },
                {
                    "id": "750730308",
                    "speaker": "科奴拉芙",
                    "text": "不过，被丘丘人抓起来，这种「世面」还是不见为妙啊，你说对不对啊，恩人。",
                    "choices": [
                        {
                            "id": "750730309",
                            "text": "独自冒险很危险…",
                            "response": [
                                {
                                    "id": "750730310",
                                    "speaker": "科奴拉芙",
                                    "text": "就是就是，要不是遇到恩人，我还不知道要在这里被困到什么时候呢…"
                                },
                                {
                                    "id": "750730313",
                                    "speaker": "科奴拉芙",
                                    "text": "唔，总之，多谢恩人救了小女子…在这上面吹了这么多风，还是先下去，想想继续修行的事…"
                                },
                                {
                                    "id": "750730314",
                                    "speaker": "科奴拉芙",
                                    "text": "小女子身上的盘缠不多，不过家里人说，受人恩惠总要回报，这些就给恩人吧！"
                                }
                            ]
                        },
                        {
                            "id": "750730311",
                            "text": "只要足够强…",
                            "response": [
                                {
                                    "id": "750730312",
                                    "speaker": "科奴拉芙",
                                    "text": "嘿…这你就骗不着小女子我啦，像恩人这么强的冒险者，这个世上也是少数吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
