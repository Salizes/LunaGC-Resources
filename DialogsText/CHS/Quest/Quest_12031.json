    "talks": [
        {
            "id": "1203101",
            "objective": "前往鸣神大社寻找八重神子",
            "dialogues": [
                {
                    "id": "120310101",
                    "speaker": "八重神子",
                    "text": "嗨，小家伙们，你们来了呀。不错，很准时。"
                },
                {
                    "id": "120310102",
                    "speaker": "派蒙",
                    "text": "哼，为了稿费，不来也不行嘛。"
                },
                {
                    "id": "120310103",
                    "speaker": "派蒙",
                    "text": "神子，要帮大家进行「百鬼夜行」，具体要怎么做呢？"
                },
                {
                    "id": "120310104",
                    "speaker": "派蒙",
                    "text": "其实我们连百鬼夜行是什么都不清楚。"
                },
                {
                    "id": "120310105",
                    "speaker": "八重神子",
                    "text": "「百鬼夜行」听起来挺吓人的，但简单来说，就是妖怪们的聚会。"
                },
                {
                    "id": "120310106",
                    "speaker": "八重神子",
                    "text": "当年妖怪们在一起聚会，酒酣之时，纷纷使出妖力腾空而起，翻飞的身影能把月亮都遮住。"
                },
                {
                    "id": "120310107",
                    "speaker": "八重神子",
                    "text": "不过现在，地脉中溢出的妖怪记忆，力量很微弱，他们已经做不到腾空而起了。"
                },
                {
                    "id": "120310108",
                    "speaker": "八重神子",
                    "text": "所以，我会为他们进行一场聚灵仪式，让逸散的记忆能够汇聚在一起。"
                },
                {
                    "id": "120310109",
                    "speaker": "八重神子",
                    "text": "到时候，他们就会在这鸣神大社的上空相会。然后，力量耗尽的他们，就会心满意足地重新回到属于他们的地方。"
                },
                {
                    "id": "120310110",
                    "speaker": "Player",
                    "text": "原来如此。"
                },
                {
                    "id": "120310111",
                    "speaker": "八重神子",
                    "text": "仪式的铺垫其实早就已经做好了。还记得我在小说中加入的咒语和「无月之夜」吗？"
                },
                {
                    "id": "120310112",
                    "speaker": "派蒙",
                    "text": "好像是要在「无月之夜」念诵「狐狸小姐秘传术法」来着。"
                },
                {
                    "id": "120310113",
                    "speaker": "八重神子",
                    "text": "对，那里写着的可不是什么实现愿望的咒语，而是能安抚地脉记忆的术式。"
                },
                {
                    "id": "120310114",
                    "speaker": "八重神子",
                    "text": "到时候，就让大家一起帮忙送他们一程吧！"
                },
                {
                    "id": "120310115",
                    "speaker": "Player",
                    "text": "那么我该做什么？"
                },
                {
                    "id": "120310116",
                    "speaker": "八重神子",
                    "text": "等下我会开始筹备仪式，希望你们帮我做两件事："
                },
                {
                    "id": "120310117",
                    "speaker": "八重神子",
                    "text": "首先是通知神社巫女们下山。"
                },
                {
                    "id": "120310118",
                    "speaker": "八重神子",
                    "text": "百鬼夜行之时，大量妖怪的记忆盘踞在鸣神大社上空，万一有谁不小心被附了身，还是会有点麻烦。"
                },
                {
                    "id": "120310119",
                    "speaker": "八重神子",
                    "text": "之后，我会启动仪式让记忆汇聚。这个过程会花一定时间，你们就去影向山下观察附近魔物的动向。"
                },
                {
                    "id": "120310120",
                    "speaker": "八重神子",
                    "text": "虽说平常分散的记忆没有什么危险，可把力量聚拢，魔物们还是难免会受到影响。"
                },
                {
                    "id": "120310121",
                    "speaker": "八重神子",
                    "text": "它们可能会凭借本能想要上山，你们就负责把它们都打倒吧。"
                },
                {
                    "id": "120310122",
                    "speaker": "派蒙",
                    "text": "明白啦。那之后呢？"
                },
                {
                    "id": "120310123",
                    "speaker": "八重神子",
                    "text": "嗯，那之后啊…如果你们想到神社这里帮忙，顺便近距离看看那些妖怪，也不是不可以。"
                },
                {
                    "id": "120310124",
                    "speaker": "派蒙",
                    "text": "#好，{NICKNAME}，我们出发吧！"
                }
            ]
        },
        {
            "id": "1203102",
            "objective": "告知巫女暂离神社",
            "dialogues": [
                {
                    "id": "120310201",
                    "speaker": "麻纪",
                    "text": "下山？这是宫司大人的命令吗？"
                },
                {
                    "id": "120310202",
                    "speaker": "派蒙",
                    "text": "是的，神子说接下来要举行的仪式，对你们的身体可能会有影响。"
                },
                {
                    "id": "120310203",
                    "speaker": "麻纪",
                    "text": "原来如此…我会立刻安排。你们呢？"
                },
                {
                    "id": "120310204",
                    "speaker": "派蒙",
                    "text": "我们会帮她做些事情，然后回到这里来，和她一起进行仪式。",
                    "choices": [
                        {
                            "id": "120310205",
                            "text": "因为还是有点担心她。",
                            "response": [
                                {
                                    "id": "120310207",
                                    "speaker": "麻纪",
                                    "text": "看来宫司大人对你们很信任。"
                                },
                                {
                                    "id": "120310208",
                                    "speaker": "麻纪",
                                    "text": "之前遇到这种重要的仪式，宫司大人身边是一个人都不会留的。"
                                },
                                {
                                    "id": "120310209",
                                    "speaker": "麻纪",
                                    "text": "那仪式就拜托你们了。"
                                },
                                {
                                    "id": "120310210",
                                    "speaker": "派蒙",
                                    "text": "放心吧，我们可是很强的！"
                                }
                            ]
                        },
                        {
                            "id": "120310206",
                            "text": "因为有点想看看妖怪。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203103",
            "objective": "(test)检查神樱大树",
            "dialogues": [
                {
                    "id": "120310301",
                    "speaker": "派蒙",
                    "text": "让我看看…神樱树没有任何被污染的迹象，看来怨灵并不能直接影响到神樱树呢。"
                },
                {
                    "id": "120310302",
                    "speaker": "派蒙",
                    "text": "既然这样，它们确实有可能像八重神子说的那样，附在怪物身上进攻鸣神大社。"
                },
                {
                    "id": "120310303",
                    "speaker": "派蒙",
                    "text": "我们赶紧去山下看看吧！"
                }
            ]
        },
        {
            "id": "1203107",
            "objective": "(test)检查大社周边",
            "dialogues": [
                {
                    "id": "120310701",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你看那些怪物，一副躁动不安的样子…"
                },
                {
                    "id": "120310702",
                    "speaker": "派蒙",
                    "text": "我有种不好的感觉，不过它们为什么没有进攻呢？"
                },
                {
                    "id": "120310703",
                    "speaker": "Player",
                    "text": "可能是没到晚上。"
                },
                {
                    "id": "120310704",
                    "speaker": "派蒙",
                    "text": "有道理，它们或许也在等无月之夜…"
                },
                {
                    "id": "120310705",
                    "speaker": "派蒙",
                    "text": "那我们先在这里警戒，等到晚上再看看吧！"
                }
            ]
        },
        {
            "id": "1203109",
            "objective": "(test)时间切换",
            "dialogues": [
                {
                    "id": "120310901",
                    "speaker": "八重神子",
                    "text": "嗯，和我预想的一样，仪式进行得很顺利。辛苦你们了。"
                },
                {
                    "id": "120310902",
                    "speaker": "Player",
                    "text": "神子，你还好吗？"
                },
                {
                    "id": "120310903",
                    "speaker": "八重神子",
                    "text": "嗯？我很好啊。"
                },
                {
                    "id": "120310904",
                    "speaker": "派蒙",
                    "text": "可是，你刚才的样子…"
                },
                {
                    "id": "120310905",
                    "speaker": "八重神子",
                    "text": "没事啦，我很好的，我…"
                },
                {
                    "id": "120310906",
                    "speaker": "八重神子",
                    "text": "呵…真是的。"
                },
                {
                    "id": "120310907",
                    "speaker": "派蒙",
                    "text": "神子…"
                },
                {
                    "id": "120310908",
                    "speaker": "八重神子",
                    "text": "好啦，如果你们真的想为我做点什么，不如就下次请我吃饭好了。"
                },
                {
                    "id": "120310909",
                    "speaker": "派蒙",
                    "text": "好，没问题，我们请你吃饭！"
                },
                {
                    "id": "120310910",
                    "speaker": "Player",
                    "text": "一言为定。"
                },
                {
                    "id": "120310911",
                    "speaker": "八重神子",
                    "text": "嗯，那就期待我们下次的见面咯。"
                }
            ]
        },
        {
            "id": "1203108",
            "objective": "前往影向山下主干道",
            "dialogues": [
                {
                    "id": "120310801",
                    "speaker": "派蒙",
                    "text": "那些魔物…看起来果然有些狂躁！",
                    "choices": [
                        {
                            "id": "120310802",
                            "text": "不能让它们上山。",
                            "response": [
                                {
                                    "id": "120310804",
                                    "speaker": "派蒙",
                                    "text": "嗯没错！赶快清理掉它们，我还想上山去看看妖怪们呢，嘿嘿。"
                                },
                                {
                                    "id": "120310805",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，它们冲过来了！"
                                }
                            ]
                        },
                        {
                            "id": "120310803",
                            "text": "帮神子处理掉它们吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203104",
            "objective": "阻止被影响的魔物们上山",
            "dialogues": [
                {
                    "id": "120310401",
                    "speaker": "八重神子",
                    "text": "小家伙，你们来啦。"
                },
                {
                    "id": "120310402",
                    "speaker": "派蒙",
                    "text": "神子，我们都还没到，你竟然就已经开始吃了啊！"
                },
                {
                    "id": "120310403",
                    "speaker": "八重神子",
                    "text": "嗯，对啊，因为你们请客嘛。"
                },
                {
                    "id": "120310404",
                    "speaker": "八重神子",
                    "text": "一想到能免费吃最贵的菜，喝最好的酒，我就赶快过来了。"
                },
                {
                    "id": "120310405",
                    "speaker": "八重神子",
                    "text": "啊，老板，看见这两个人没有？这桌等会是他们买单哦。"
                },
                {
                    "id": "120310406",
                    "speaker": "冈崎陆斗",
                    "text": "好嘞！"
                },
                {
                    "id": "120310407",
                    "speaker": "派蒙",
                    "text": "呃…"
                },
                {
                    "id": "120310408",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "120310409",
                    "speaker": "八重神子",
                    "text": "怎么啦你们两个，快过来坐啊。"
                },
                {
                    "id": "120310410",
                    "speaker": "八重神子",
                    "text": "来尝尝这个，这可是清籁岛附近才有的鱼，连夜运到稻妻城的，刚才还是活的。"
                },
                {
                    "id": "120310411",
                    "speaker": "八重神子",
                    "text": "或者来杯这个？像这样名贵的酒，我平时也不舍得喝呢。"
                },
                {
                    "id": "120310412",
                    "speaker": "八重神子",
                    "text": "不能喝酒也没关系，果汁也很多的，各种价位都有。"
                },
                {
                    "id": "120310413",
                    "speaker": "派蒙",
                    "text": "呜——神子，你太过分了！"
                },
                {
                    "id": "120310414",
                    "speaker": "派蒙",
                    "text": "上次在这里赶稿的时候，你给我们吃的只是最大众的炸串啊！"
                },
                {
                    "id": "120310415",
                    "speaker": "八重神子",
                    "text": "咦，有这回事吗？",
                    "choices": [
                        {
                            "id": "120310416",
                            "text": "就是这么回事。",
                            "response": [
                                {
                                    "id": "120310418",
                                    "speaker": "八重神子",
                                    "text": "哦，那又怎样呢？之前说要请客的，不是你们自己吗？再说了，你们忍心亏待我这个贵客吗？"
                                },
                                {
                                    "id": "120310419",
                                    "speaker": "派蒙",
                                    "text": "神子，这顿饭要好多好多钱呀，你就不怕我们付不起吗？"
                                },
                                {
                                    "id": "120310420",
                                    "speaker": "八重神子",
                                    "text": "呵呵，不用怕，付得起。咱们之前一起写的那本小说，最近又再版了，你们的稿费还不少呢。"
                                },
                                {
                                    "id": "120310421",
                                    "speaker": "派蒙",
                                    "text": "你、你说什么？！"
                                },
                                {
                                    "id": "120310422",
                                    "speaker": "派蒙",
                                    "text": "#啊啊啊啊，可恶！{NICKNAME}，我们被气氛给骗了！神子打从一开始就在打我们稿费的主意哪！",
                                    "choices": [
                                        {
                                            "id": "120310423",
                                            "text": "大意了…",
                                            "response": [
                                                {
                                                    "id": "120310425",
                                                    "speaker": "八重神子",
                                                    "text": "哈哈哈哈，你们现在这副样子，真是太有趣了，哈哈哈。"
                                                },
                                                {
                                                    "id": "120310426",
                                                    "speaker": "八重神子",
                                                    "text": "哦对了，因为上次无月之夜许愿后什么都没有发生，现在咒语之类的小说，已经完全不流行了。"
                                                },
                                                {
                                                    "id": "120310427",
                                                    "speaker": "八重神子",
                                                    "text": "所以《旅行者的奇妙冒险》的最新章，你们得想点新的套路才行。"
                                                },
                                                {
                                                    "id": "120310428",
                                                    "speaker": "八重神子",
                                                    "text": "截稿期马上就到了，那就拜托你了哦，「老师」。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120310424",
                                            "text": "被算计了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120310417",
                            "text": "只有炸串，和油豆腐。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1203110",
            "objective": "返回鸣神大社",
            "dialogues": [
                {
                    "id": "120311001",
                    "speaker": "八重神子",
                    "text": "谢谢你们请客，今天我过得很愉快。"
                },
                {
                    "id": "120311002",
                    "speaker": "八重神子",
                    "text": "说起来，我们之前在鸣神大社上搞的聚灵仪式，影也看到了。"
                },
                {
                    "id": "120311003",
                    "speaker": "八重神子",
                    "text": "没想到，那个死脑筋的家伙专门写了一封那——么长的信来骂我，说我们「搞得太夸张了」。"
                },
                {
                    "id": "120311004",
                    "speaker": "八重神子",
                    "text": "哎，有什么关系嘛，明明大家都很开心呢。"
                }
            ]
        },
        {
            "id": "1203105",
            "objective": "为地脉中的妖怪灵魂送别",
            "dialogues": []
        },
        {
            "id": "1203111",
            "objective": "等待到约定日期（第二天）",
            "dialogues": []
        },
        {
            "id": "1203112",
            "objective": "到乌有亭附近",
            "dialogues": [
                {
                    "id": "120311901",
                    "speaker": "响太",
                    "text": "《旅行者的奇妙冒险》竟然还没出下一章，真是急死我了！"
                },
                {
                    "id": "120311902",
                    "speaker": "大助",
                    "text": "没想到无月之夜还真的出现了。"
                },
                {
                    "id": "120311903",
                    "speaker": "哲夫",
                    "text": "对啊，那天晚上汇聚在影向山顶上，好大一片黑压压的云彩！"
                },
                {
                    "id": "120311904",
                    "speaker": "大助",
                    "text": "不过用书上的办法许愿了之后，却什么都没有发生。"
                },
                {
                    "id": "120311905",
                    "speaker": "哲夫",
                    "text": "唉，看来轻小说毕竟只是轻小说啊。"
                },
                {
                    "id": "120311906",
                    "speaker": "大助",
                    "text": "这件事之后，小说里的咒语什么的，就完全不流行了呢。不过《旅行者的奇妙冒险》应该还能搞出有趣的内容吧！"
                },
                {
                    "id": "120311907",
                    "speaker": "派蒙",
                    "text": "咦，周围没看见神子呢。"
                },
                {
                    "id": "120311908",
                    "speaker": "派蒙",
                    "text": "神子好像不在店外面，会不会已经进去了？我们去里面找找吧。"
                }
            ]
        },
        {
            "id": "1203106",
            "objective": "进入乌有亭",
            "dialogues": []
        },
        {
            "id": "1202908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120290812",
                    "speaker": "Black Screen",
                    "text": "等待到了深夜，魔物慢慢朝这边汇聚…"
                }
            ]
        }
    ]
}