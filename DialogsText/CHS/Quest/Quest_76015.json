    "talks": [
        {
            "id": "7601501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760150201",
                    "speaker": "大嗓门的幽影",
                    "text": "喂，你是谁？这是我的椅子，酒馆里谁不知道这是我███的位置。"
                },
                {
                    "id": "760150202",
                    "speaker": "大嗓门的幽影",
                    "text": "你是刚来岛上报到还是怎么回事？别乱占别人位置啊。"
                },
                {
                    "id": "760150203",
                    "speaker": "大嗓门的幽影",
                    "text": "我的啤酒怎么还没上，快点，我再坐会儿就得去巡夜了。",
                    "choices": [
                        {
                            "id": "760150204",
                            "text": "这里过去的确是酒馆。",
                            "response": [
                                {
                                    "id": "760150206",
                                    "speaker": "大嗓门的幽影",
                                    "text": "你非要坐也行，先来跟我们一起喝酒唱歌，熟了都是朋友，你要坐就坐吧。"
                                },
                                {
                                    "id": "760150207",
                                    "speaker": "大嗓门的幽影",
                                    "text": "会唱歌吧？哟吼，大伙唱一句你唱一句——"
                                },
                                {
                                    "id": "760150208",
                                    "speaker": "大嗓门的幽影",
                                    "text": "「邻家的舞曲让我忍不住踏脚！」"
                                },
                                {
                                    "id": "760150209",
                                    "speaker": "Player",
                                    "text": "「我在拉琴你们在微笑。」"
                                },
                                {
                                    "id": "760150210",
                                    "speaker": "大嗓门的幽影",
                                    "text": "「大家都在开心跳舞，嘿！嘿！」"
                                },
                                {
                                    "id": "760150211",
                                    "speaker": "Player",
                                    "text": "「我们聚起来，聚起来跳舞！」"
                                },
                                {
                                    "id": "760150212",
                                    "speaker": "大嗓门的幽影",
                                    "text": "啊哈，没错没错，就是这么唱，你习惯得很快嘛。"
                                },
                                {
                                    "id": "760150213",
                                    "speaker": "大嗓门的幽影",
                                    "text": "我的名字叫███，这下我们就算认识了。椅子你想坐就坐吧，我也不是小气的人。"
                                },
                                {
                                    "id": "760150214",
                                    "speaker": "大嗓门的幽影",
                                    "text": "你也是执灯士对吧，这杯啤酒算我请你的，说不定我们还能在训练的时候遇上。",
                                    "choices": [
                                        {
                                            "id": "760150215",
                                            "text": "谢谢，尽管我喝不到。",
                                            "response": [
                                                {
                                                    "id": "760150217",
                                                    "speaker": "大嗓门的幽影",
                                                    "text": "我该去巡夜了，回头见。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760150216",
                                            "text": "幸会，我叫作菲林斯。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760150205",
                            "text": "如果我想坐在这里呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7601502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760150401",
                    "speaker": "大嗓门的幽影",
                    "text": "是那个…那个…跟我坐同一把椅子的…我忘记了…"
                },
                {
                    "id": "760150402",
                    "speaker": "大嗓门的幽影",
                    "text": "哟吼，大伙来唱歌，我唱一句你唱一句——"
                },
                {
                    "id": "760150403",
                    "speaker": "Player",
                    "text": "「邻家的舞曲让我忍不住踏脚！」"
                },
                {
