    "talks": [
        {
            "id": "7416507",
            "objective": "进入洋流",
            "dialogues": []
        },
        {
            "id": "7416501",
            "objective": "进入洋流",
            "dialogues": [
                {
                    "id": "741650101",
                    "speaker": "纳齐森科鲁兹",
                    "text": "我…感受到了「理性」。到来之人，汝等是水仙十字的后继者，还是齿轮的鹰犬？"
                },
                {
                    "id": "741650102",
                    "speaker": "纳齐森科鲁兹",
                    "text": "对我拔剑相向了。看来答案不言自明。"
                },
                {
                    "id": "741650103",
                    "speaker": "安",
                    "text": "纳齐森科鲁兹…"
                },
                {
                    "id": "741650104",
                    "speaker": "派蒙",
                    "text": "欸？这个东西就是纳齐森科鲁兹吗？"
                },
                {
                    "id": "741650105",
                    "speaker": "纳齐森科鲁兹",
                    "text": "既然已听闻我名，那汝等自当理解我救世之道义。既已听闻我名，尔等意识之内便有得救的种子。"
                },
                {
                    "id": "741650106",
                    "speaker": "纳齐森科鲁兹",
                    "text": "想来尔等对我兵锋相向，应该是被谎言所欺骗。如此时机，我也不想浪费太多力量。"
                },
                {
                    "id": "741650107",
                    "speaker": "纳齐森科鲁兹",
                    "text": "欣喜吧，喝彩吧。在一切结束之后我来解答，我来展现。现在把圣剑归还到我的手中，然后离开避难吧。"
                },
                {
                    "id": "741650108",
                    "speaker": "派蒙",
                    "text": "才不能把圣剑给你。"
                },
                {
                    "id": "741650109",
                    "speaker": "纳齐森科鲁兹",
                    "text": "愚蠢啊愚蠢。但是我原谅尔等，就算如此我也会拯救尔等。"
                },
                {
                    "id": "741650110",
                    "speaker": "纳齐森科鲁兹",
                    "text": "我感觉到了，四象限虽然得以逆转，但是涌流之树的全图并没有完成。"
                },
                {
                    "id": "741650111",
                    "speaker": "纳齐森科鲁兹",
                    "text": "已经没有办法拯救所有人了。我将最大程度延展我的慈悲，透支我的生命。"
                },
                {
                    "id": "741650112",
                    "speaker": "纳齐森科鲁兹",
                    "text": "如果只能救五成的人，我就尽力去救下六成的人。"
                },
                {
                    "id": "741650113",
                    "speaker": "纳齐森科鲁兹",
                    "text": "现在，我要来取圣剑了。"
                }
            ]
        },
        {
            "id": "7416508",
            "objective": "进入洋流",
            "dialogues": []
        },
        {
            "id": "7416502",
            "objective": "前进",
            "dialogues": [
                {
                    "id": "741650201",
                    "speaker": "纳齐森科鲁兹",
                    "text": "不可能…我明明已经登达了「不退还」之位阶。为什么，跌落到了如此境界。"
                },
                {
                    "id": "741650202",
                    "speaker": "纳齐森科鲁兹",
                    "text": "对原始胎海的掌控也彻底丧失了。"
                },
                {
                    "id": "741650203",
                    "speaker": "纳齐森科鲁兹",
                    "text": "为什么，为什么会这样？为什么，为什么你们要这么做！"
                },
                {
                    "id": "741650204",
                    "speaker": "纳齐森科鲁兹",
                    "text": "新世界无法诞生，所有人都要在蛋壳之梦里死去了！"
                },
                {
                    "id": "741650205",
                    "speaker": "派蒙",
                    "text": "你才是早点从自己的梦里醒过来吧。"
                },
                {
                    "id": "741650206",
                    "speaker": "派蒙",
                    "text": "世界末日这种事，当然是全世界的人一起想办法解决的事情啦。"
                },
                {
                    "id": "741650207",
                    "speaker": "纳齐森科鲁兹",
                    "text": "我明白了，是圣剑。它没有站在我这边。它每一次挥动都切削了围聚在我周身的众生意志。"
                },
                {
                    "id": "741650208",
                    "speaker": "纳齐森科鲁兹",
                    "text": "直到最后，我懦弱的凡人性——我的人格也回到了我的体内。",
                    "choices": [
                        {
                            "id": "741650209",
                            "text": "胎海泛滥并没有那么快。",
                            "response": [
                                {
                                    "id": "741650210",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "我已经有所察觉，最早填入「世界式」的输入值出现了变动。"
                                },
                                {
                                    "id": "741650211",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "有谁掌控了生命之力，又有什么人开辟了兽之国度。"
                                },
                                {
                                    "id": "741650212",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "还有一个「变量」，那就是你啊。"
                                },
                                {
                                    "id": "741650213",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "注定见证吞食一切之鲸败走的人，一切的见证者。"
                                },
                                {
                                    "id": "741650214",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "原来是这样，原来是这样。"
                                },
                                {
                                    "id": "741650221",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "我也做过这样的梦，想要成为你这样的事物。不过这个梦，刚刚破碎了。"
                                },
                                {
                                    "id": "741650222",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "我所做的一切都毫无意义，就像是一个空虚的梦。"
                                },
                                {
                                    "id": "741650223",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "不，甚至不如一个梦。至少梦是无害的。而我……不，你们，还有他们却为这件事付出了那么多。"
                                },
                                {
                                    "id": "741650224",
                                    "speaker": "安",
                                    "text": "纳齐森科鲁兹。"
                                },
                                {
                                    "id": "741650225",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "啊，是你。我都没有发现。"
                                },
                                {
                                    "id": "741650226",
                                    "speaker": "安",
                                    "text": "你能知道我究竟是谁吗？"
                                },
                                {
                                    "id": "741650227",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "名字只是一个称呼。混在你灵魂里的两种颜色，我都是再熟悉不过了。"
                                },
                                {
                                    "id": "741650228",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "莉利丝院长不知道发生了什么，她只是抱住了一息尚存的玛丽安。"
                                },
                                {
                                    "id": "741650229",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "她理解不了过于复杂的当下与未来，只是想要留住过去。于是她做了她唯一会做的事情。"
                                },
                                {
                                    "id": "741650230",
                                    "speaker": "安",
                                    "text": "我叫做安。"
                                },
                                {
                                    "id": "741650231",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "那么，你好，安。"
                                },
                                {
                                    "id": "741650232",
                                    "speaker": "安",
                                    "text": "我愿意原谅你。"
                                },
                                {
                                    "id": "741650233",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "你在说什么奇怪的话。从一开始我的规划就有着崇高与神圣的目的。这中间没有私心。"
                                },
                                {
                                    "id": "741650234",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "没有人能评价我，没有人能审判我，没有人能原谅我。"
                                },
                                {
                                    "id": "741650235",
                                    "speaker": "安",
                                    "text": "你的目的或许是崇高的，但是你的疯狂伤害了很多人。"
                                },
                                {
                                    "id": "741650236",
                                    "speaker": "安",
                                    "text": "你连算式的输入都没填对。犯错然后被原谅，有什么问题吗？"
                                },
                                {
                                    "id": "741650237",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "…你说得对。我很抱歉。"
                                },
                                {
                                    "id": "741650238",
                                    "speaker": "安",
                                    "text": "然后纳齐森科鲁兹，你和我们回去吧。你需要见一见其他人。"
                                },
                                {
                                    "id": "741650239",
                                    "speaker": "派蒙",
                                    "text": "虽然这家伙好像变得很好说话了，但是这种要求…"
                                },
                                {
                                    "id": "741650240",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "741650241",
                                    "speaker": "派蒙",
                                    "text": "欸！一般不是要做点心理斗争然后让我们劝个半天的吗？"
                                },
                                {
                                    "id": "741650242",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "正如我之前所说，我并未觉得自己有任何负罪。如今伟业惜溃，但是世界已然得救。"
                                },
                                {
                                    "id": "741650243",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "任由他人责骂与嘲笑我吧。我的内心已经空落，徒余一种渴望。"
                                },
                                {
                                    "id": "741650244",
                                    "speaker": "派蒙",
                                    "text": "是什么呢？"
                                },
                                {
                                    "id": "741650245",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "我也想回到最开始的时候。水仙的勇者还没有踏上旅程的时候。"
                                },
                                {
                                    "id": "741650246",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "不过这已经办不到了。决定人命运的终究不是人自己，如今我连让自己做什么梦的力量也丢失了。"
                                },
                                {
                                    "id": "741650247",
                                    "speaker": "安",
                                    "text": "#那，{NICKNAME}骑士，准备好之后我们就去重新封印胎海然后离开这里吧。"
                                }
                            ]
                        },
                        {
                            "id": "741650215",
                            "text": "那条鲸已经被打败了。",
                            "response": [
                                {
                                    "id": "741650216",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "我本该有所察觉，最早填入「世界式」的输入值出现了变动。有「变量」降临此间。"
                                },
                                {
                                    "id": "741650217",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "并非是所有宇宙外到来的事物都能被叫做「降临」或者「变量」。"
                                },
                                {
                                    "id": "741650218",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "原来我少算了一个「变量」，那就是你啊。"
                                },
                                {
                                    "id": "741650219",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "一切的见证者，一切的记录者，一切的设计者。"
                                },
                                {
                                    "id": "741650220",
                                    "speaker": "纳齐森科鲁兹",
                                    "text": "唯有自身等价一个世界的人才能担此头衔。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
