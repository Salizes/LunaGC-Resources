    "talks": [
        {
            "id": "7526501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752650101",
                    "speaker": "玛纳奥",
                    "text": "嘿！朋友，我这有好东西，价格也美丽，要看看吗？"
                },
                {
                    "id": "752650102",
                    "speaker": "派蒙",
                    "text": "欸？这不是那些鳍游龙玩偶吗？好像在悠悠集市见过。"
                },
                {
                    "id": "752650103",
                    "speaker": "玛纳奥",
                    "text": "真有眼光，但我这货便宜，五折就卖。"
                },
                {
                    "id": "752650104",
                    "speaker": "Player",
                    "text": "为什么这么便宜？"
                },
                {
                    "id": "752650105",
                    "speaker": "玛纳奥",
                    "text": "嘿嘿，朋友，这你就别管了，我有我的渠道。"
                },
                {
                    "id": "752650106",
                    "speaker": "派蒙",
                    "text": "虽然便宜了很多，但是感觉这些玩偶的颜色有点怪怪的，不会是假货吧？"
                },
                {
                    "id": "752650107",
                    "speaker": "玛纳奥",
                    "text": "假货？你这个不识货的小东西…一边去！"
                },
                {
                    "id": "752650108",
                    "speaker": "玛纳奥",
                    "text": "快走快走！我不卖给你们了。"
                }
            ]
        },
        {
            "id": "7526502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752650603",
                    "speaker": "Player",
                    "text": "那个玛纳奥似乎在卖假货。"
                },
                {
                    "id": "752650607",
                    "speaker": "派蒙",
                    "text": "果然是假货吗？居然还想骗我们，我们去找他算账去吧！"
                }
            ]
        },
        {
            "id": "7526503",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752650401",
                    "speaker": "Player",
                    "text": "我要教训你一顿。"
                }
            ]
        },
        {
            "id": "7526504",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
