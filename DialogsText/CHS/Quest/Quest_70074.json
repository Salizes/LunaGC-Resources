    "talks": [
        {
            "id": "7007401",
            "objective": "前往蒙德城",
            "dialogues": [
                {
                    "id": "700740101",
                    "speaker": "派蒙",
                    "text": "说起来，明明是法尔伽跟魔女们开启的「会谈」，他自己的课题我们怎么就一直没注意呢？"
                },
                {
                    "id": "700740102",
                    "speaker": "派蒙",
                    "text": "让我来翻翻看…法尔伽法尔伽…咦？怎么是…一行空白？"
                },
                {
                    "id": "700740103",
                    "speaker": "Player",
                    "text": "要不找他自己问问？"
                },
                {
                    "id": "700740104",
                    "speaker": "派蒙",
                    "text": "也对…要找他的话，感觉「酒馆」跟「餐馆」之类的地方会比较容易…"
                },
                {
                    "id": "700740105",
                    "speaker": "法尔伽",
                    "text": "…还是不在吗？看来只能靠自己想办法了啊。"
                },
                {
                    "id": "700740106",
                    "speaker": "Player",
                    "text": "正说着就出现了！"
                },
                {
                    "id": "700740107",
                    "speaker": "派蒙",
                    "text": "嘿！法尔伽！我们想来问问关于「课题」的事…"
                },
                {
                    "id": "700740108",
                    "speaker": "法尔伽",
                    "text": "哦？荣誉骑士跟派蒙！课题…？怎么突然问起这个？",
                    "choices": [
                        {
                            "id": "700740109",
                            "text": "魔女会给大家准备了课题…",
                            "response": [
                                {
                                    "id": "700740111",
                                    "speaker": "法尔伽",
                                    "text": "课题…课题…啊，好像还真听艾莉丝讲过这么一回事？"
                                },
                                {
                                    "id": "700740112",
                                    "speaker": "派蒙",
                                    "text": "——不是因为你的「会谈」才有的「课题」吗！算了…还是说说，为什么你的课题是一行空白吧？"
                                },
                                {
                                    "id": "700740113",
                                    "speaker": "法尔伽",
                                    "text": "…嗯，恐怕是因为我的「课题」，对于那本小册子来说，有些太过沉重了。",
                                    "choices": [
                                        {
                                            "id": "700740114",
                                            "text": "你这么说我倒是感兴趣了。",
                                            "response": [
                                                {
                                                    "id": "700740116",
                                                    "speaker": "法尔伽",
                                                    "text": "——调出全提瓦特最棒的美酒。"
                                                },
                                                {
                                                    "id": "700740117",
                                                    "speaker": "派蒙",
                                                    "text": "…这算哪门子的沉重啊！"
                                                },
                                                {
                                                    "id": "700740118",
                                                    "speaker": "法尔伽",
                                                    "text": "可不要小看了这个课题啊——我臂上的这道新疤，就是为了获得它的酒方才添的。"
                                                },
                                                {
                                                    "id": "700740119",
                                                    "speaker": "法尔伽",
                                                    "text": "我为它深入了一片混沌的秘境，跟最凶最狠的魔物搏斗…！"
                                                },
                                                {
                                                    "id": "700740120",
                                                    "speaker": "Player",
                                                    "text": "真的假的…"
                                                },
                                                {
                                                    "id": "700740121",
                                                    "speaker": "法尔伽",
                                                    "text": "现在距离成功，就差三道特殊的材料了！荣誉骑士，派蒙，你们愿意助我一臂之力吗？"
                                                },
                                                {
                                                    "id": "700740122",
                                                    "speaker": "派蒙",
                                                    "text": "好吧，既然只差三道…就当做是被你骗了，陪你走一趟吧！"
                                                },
                                                {
                                                    "id": "700740123",
                                                    "speaker": "法尔伽",
                                                    "text": "好，要收集的材料还有：「骑士击碎的木屑」、「欢欣而落的鸽羽」、「大锅烹煮的药汤」。"
                                                },
                                                {
                                                    "id": "700740124",
                                                    "speaker": "派蒙",
                                                    "text": "这还是调酒吗喂！听着像是在炼什么很不妙的魔药啊！"
                                                },
                                                {
                                                    "id": "700740125",
                                                    "speaker": "法尔伽",
                                                    "text": "嗯…那什么，你看，毕竟是魔女们的课题嘛，哈哈！"
                                                },
                                                {
                                                    "id": "700740126",
                                                    "speaker": "法尔伽",
                                                    "text": "为了保证完美还原酒方，三种材料都必须严格符合要求，先到可以获得「木屑」的地方去吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700740115",
                                            "text": "有什么课题说来听听？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700740110",
                            "text": "但你的那行好像是空白的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7007402",
            "objective": "前往骑士团训练场",
            "dialogues": [
                {
                    "id": "700740201",
                    "speaker": "派蒙",
                    "text": "…说起「骑士击碎的木屑」，果然就是这里了吧？"
                },
                {
                    "id": "700740202",
                    "speaker": "艾琳",
                    "text": "啊！大团长！荣誉骑士！你们今天也是来训练的吗？"
                },
                {
                    "id": "700740203",
                    "speaker": "法尔伽",
                    "text": "为了追求「目标」而奋进…嗯，确实是一种训练呢。"
                },
                {
                    "id": "700740204",
                    "speaker": "艾琳",
                    "text": "明明都已经这么强了，却还在精益求精吗…两位请随意训练吧！我会在旁边做笔记的！"
                }
            ]
        },
        {
            "id": "7007412",
            "objective": "前往骑士团训练场",
            "dialogues": []
        },
        {
            "id": "7007411",
            "objective": "在时限内击破所有木桩",
            "dialogues": []
        },
        {
            "id": "7007403",
            "objective": "在时限内击破所有木桩",
            "dialogues": [
                {
                    "id": "700740301",
                    "speaker": "艾琳",
                    "text": "训练场就交给你们了！能亲眼目睹两位顶尖高手的风采，就算让我再等上三天也值啊！"
                }
            ]
        },
        {
            "id": "7007410",
            "objective": "击败特制木桩",
            "dialogues": [
                {
                    "id": "700741001",
                    "speaker": "迪奥娜",
                    "text": "欸？那个酒鬼大叔…不会有事吧？"
                }
            ]
        },
        {
            "id": "7007404",
            "objective": "与法尔伽对话",
            "dialogues": [
                {
                    "id": "700740401",
                    "speaker": "艾琳",
                    "text": "太厉害了！原来是用这种方式…"
                },
                {
                    "id": "700740402",
                    "speaker": "派蒙",
                    "text": "…打住！这句话我耳朵都要听出茧子了！"
                },
                {
                    "id": "700740403",
                    "speaker": "法尔伽",
                    "text": "嗯…这份木屑…不管是形状还是质感都很像…成色很不错！"
                },
                {
                    "id": "700740404",
                    "speaker": "派蒙",
                    "text": "木屑究竟能有什么成色啦…不过你满意就行。下一份材料是…「欢欣而落的鸽羽」？"
                }
            ]
        },
        {
            "id": "7007405",
            "objective": "前往城门口",
            "dialogues": [
                {
                    "id": "700740501",
                    "speaker": "提米",
                    "text": "喂！你们把鸽子全给…吓跑…了…"
                },
                {
                    "id": "700740502",
                    "speaker": "提米",
                    "text": "…大…大团长？"
                },
                {
                    "id": "700740503",
                    "speaker": "法尔伽",
                    "text": "哦？这不是小提米吗？看起来个子长高了不少啊？有在好好吃饭吗？"
                },
                {
                    "id": "700740504",
                    "speaker": "提米",
                    "text": "有…有的！我一直记得您说的！想成为顶天立地的男子汉，就要好好吃饭！好好锻炼！",
                    "choices": [
                        {
                            "id": "700740505",
                            "text": "这小子的态度…",
                            "response": [
                                {
                                    "id": "700740507",
                                    "speaker": "派蒙",
                                    "text": "没办法…我估计这座城里没有哪个小孩子不崇拜西风骑士团的当代传奇吧？"
                                },
                                {
                                    "id": "700740508",
                                    "speaker": "法尔伽",
                                    "text": "抱歉啊，把你的鸽子全吓跑了。"
                                },
                                {
                                    "id": "700740509",
                                    "speaker": "法尔伽",
                                    "text": "我刚好也想问一下，有什么方法能接近鸽子却不惊动它们…还能让它们保持心情愉悦吗？"
                                },
                                {
                                    "id": "700740510",
                                    "speaker": "提米",
                                    "text": "呃…我平时，会静静地走到它们身边，再撒下饲料…"
                                },
                                {
                                    "id": "700740511",
                                    "speaker": "法尔伽",
                                    "text": "——对了！就是这个！你身上还有多的饲料吗？"
                                },
                                {
                                    "id": "700740512",
                                    "speaker": "提米",
                                    "text": "饲料倒是有不少…不过…大团长…那个…你们是要…"
                                },
                                {
                                    "id": "700740513",
                                    "speaker": "法尔伽",
                                    "text": "放心吧，我向你保证——只是找它们借点羽毛而已，这是大人之间的约定！"
                                },
                                {
                                    "id": "700740514",
                                    "speaker": "提米",
                                    "text": "啊…好的！谢谢大团长！"
                                }
                            ]
                        },
                        {
                            "id": "700740506",
                            "text": "跟以前完全不一样！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7007406",
            "objective": "前往鸽子出没处",
            "dialogues": [
                {
                    "id": "700740601",
                    "speaker": "法尔伽",
                    "text": "地上好像有鸽子的痕迹？在这里稍微等一会儿吧。"
                },
                {
                    "id": "700740602",
                    "speaker": "法尔伽",
                    "text": "等鸽子出现就静静地走到它们身边，再撒下饲料…千万不要伤害它们哦？你准备好了吗？"
                }
            ]
        },
        {
            "id": "7007413",
            "objective": "前往鸽子出没处",
            "dialogues": [
                {
                    "id": "700740703",
                    "speaker": "Player",
                    "text": "准备好了。"
                }
            ]
        },
        {
