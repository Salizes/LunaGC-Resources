                }
            ]
        },
        {
            "id": "7007408",
            "objective": "与法尔伽对话",
            "dialogues": [
                {
                    "id": "700740801",
                    "speaker": "鸽子",
                    "text": "咕咕——"
                },
                {
                    "id": "700740802",
                    "speaker": "法尔伽",
                    "text": "羽毛！我拿到了！"
                },
                {
                    "id": "700740803",
                    "speaker": "派蒙",
                    "text": "可算拿到了，这课题确实比想象的要艰难…"
                },
                {
                    "id": "700740804",
                    "speaker": "法尔伽",
                    "text": "只差一步了…「大锅烹煮的药汤」，没记错的话是在达达乌帕谷吧？"
                },
                {
                    "id": "700740805",
                    "speaker": "法尔伽",
                    "text": "我这就过去，你们快点跟上来！"
                },
                {
                    "id": "700740806",
                    "speaker": "派蒙",
                    "text": "喂——这家伙，兴致也太高了吧？跑得比飞得还快？",
                    "choices": [
                        {
                            "id": "700740807",
                            "text": "不愧是像风一样自由的人…",
                            "response": [
                                {
                                    "id": "700740809",
                                    "speaker": "迪奥娜",
                                    "text": "…那个酒鬼大叔…！"
                                },
                                {
                                    "id": "700740810",
                                    "speaker": "Player",
                                    "text": "嗯？谁在那里？"
                                },
                                {
                                    "id": "700740811",
                                    "speaker": "迪奥娜",
                                    "text": "…呀！"
                                },
                                {
                                    "id": "700740812",
                                    "speaker": "派蒙",
                                    "text": "迪奥娜？你怎么在这里？还专门藏起来了…"
                                },
                                {
                                    "id": "700740813",
                                    "speaker": "迪奥娜",
                                    "text": "我…我就只是出门采点果子，没想到突然就碰到那个大叔…"
                                },
                                {
                                    "id": "700740814",
                                    "speaker": "迪奥娜",
                                    "text": "他最近老是缠着我不放，想让我再给他调一次上回的酒…我被烦得不行，就只好到处躲着他了…"
                                },
                                {
                                    "id": "700740815",
                                    "speaker": "Player",
                                    "text": "上回的酒…是什么情况？"
                                },
                                {
                                    "id": "700740816",
                                    "speaker": "迪奥娜",
                                    "text": "他前阵子不是和一些远征军一起回来了吗？就到猫尾酒馆里喝庆功酒…"
                                },
                                {
                                    "id": "700740817",
                                    "speaker": "派蒙",
                                    "text": "猫尾酒馆？我还以为会在骑士团里开…"
                                },
                                {
                                    "id": "700740818",
                                    "speaker": "Player",
                                    "text": "我还以为会去「天使的馈赠」…"
                                },
                                {
                                    "id": "700740819",
                                    "speaker": "迪奥娜",
                                    "text": "呃…他们全都去了。猫尾酒馆已经是第三轮了——城里所有酒馆他们都打算喝上一轮。"
                                },
                                {
                                    "id": "700740820",
                                    "speaker": "派蒙",
                                    "text": "…我强烈怀疑等下一波远征军回来，他们还能用这借口再喝一轮。"
                                },
                                {
                                    "id": "700740821",
                                    "speaker": "Player",
                                    "text": "我毫不怀疑。"
                                },
                                {
                                    "id": "700740822",
                                    "speaker": "迪奥娜",
                                    "text": "…总之！那帮酒鬼大叔的样子，我实在是看不下去了！就想调杯最难喝最反胃的饮料让他们醒一醒！",
                                    "choices": [
                                        {
                                            "id": "700740823",
                                            "text": "但你的体质不是…",
                                            "response": [
                                                {
                                                    "id": "700740825",
                                                    "speaker": "迪奥娜",
                                                    "text": "是啊，所以我一开始是让小王子去帮我调的…谁知道那群家伙一喝醉就想逗小王子玩。"
                                                },
                                                {
                                                    "id": "700740826",
                                                    "speaker": "迪奥娜",
                                                    "text": "…所以小王子没调到最后就跑了，哦，顺便还挠了那个酒鬼大叔一爪子！"
                                                },
                                                {
                                                    "id": "700740827",
                                                    "speaker": "Player",
                                                    "text": "（法尔伽说的那道疤…该不会就是…）"
                                                },
                                                {
                                                    "id": "700740828",
                                                    "speaker": "法尔伽",
                                                    "text": "我为它深入了一片混沌的秘{RUBY#[D]酒馆}境，跟最凶最狠的魔{RUBY#[D]小王子}物搏斗…！"
                                                },
                                                {
                                                    "id": "700740829",
                                                    "speaker": "迪奥娜",
                                                    "text": "…我看着差不多调完的饮料，想着就只差那么一点了，是不是…"
                                                },
                                                {
                                                    "id": "700740830",
                                                    "speaker": "Player",
                                                    "text": "结果还是亲手完成最后一步了吗…"
                                                },
                                                {
                                                    "id": "700740831",
                                                    "speaker": "迪奥娜",
                                                    "text": "是…",
                                                    "choices": [
                                                        {
                                                            "id": "700740832",
                                                            "text": "我再好奇一问…",
                                                            "response": [
                                                                {
                                                                    "id": "700740834",
                                                                    "speaker": "迪奥娜",
                                                                    "text": "呃，有骑士们身上沾的木屑、从林子里捡的鸽子羽毛…"
                                                                },
                                                                {
                                                                    "id": "700740835",
                                                                    "speaker": "迪奥娜",
                                                                    "text": "还有最后一种，原本打算拿来醒酒的…丘丘人的草药汤…"
                                                                },
                                                                {
                                                                    "id": "700740836",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}…你说法尔伽他刚回来没多久…会不会…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700740837",
                                                                            "text": "…还没人告诉过他这些材料…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700740839",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这家伙…要出大事了！快去阻止他！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700740838",
                                                                            "text": "只有迪奥娜自己能这么调！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700740833",
                                                            "text": "你都往里面加了什么？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700740824",
                                            "text": "调什么都会变成美味？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700740808",
                            "text": "想喝酒的心情都溢出来了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7007409",
            "objective": "前往达达乌帕谷",
            "dialogues": [
                {
                    "id": "700740901",
                    "speaker": "艾拉·马斯克",
                    "text": "难以置信…丘丘人居然这么好说话了？"
                },
                {
                    "id": "700740902",
                    "speaker": "派蒙",
                    "text": "艾拉！你有看到法尔伽吗！"
                },
                {
                    "id": "700740903",
                    "speaker": "艾拉·马斯克",
                    "text": "嗯，他刚刚说是要去向丘丘人借锅子用…然后丘丘人一见到他，就连忙把锅给让出来了。"
                },
                {
                    "id": "700740904",
                    "speaker": "艾拉·马斯克",
                    "text": "明明也没有交流几句，怎么会这么顺利？难道大团长还掌握了我不知道的丘丘人肢体语言？",
                    "choices": [
                        {
                            "id": "700740905",
                            "text": "我觉得那不算交流…",
                            "response": [
                                {
                                    "id": "700740907",
                                    "speaker": "派蒙",
                                    "text": "——重点不在这吧喂！法尔伽他现在人呢！"
                                },
                                {
                                    "id": "700740908",
                                    "speaker": "艾拉·马斯克",
                                    "text": "喏——就在那儿呢。"
                                },
                                {
                                    "id": "700740909",
                                    "speaker": "法尔伽",
                                    "text": "终于…完成了！全提瓦特最棒的美酒！此时此刻，就在我的手中！"
                                },
                                {
                                    "id": "700740910",
                                    "speaker": "Player",
                                    "text": "法尔伽——"
                                },
                                {
                                    "id": "700740911",
                                    "speaker": "法尔伽",
                                    "text": "哦？你们可算来了啊？那些丘丘人意外地很通情达理嘛，调酒的进度比想象得要快一点。"
                                },
                                {
                                    "id": "700740912",
                                    "speaker": "法尔伽",
                                    "text": "现在，就是品鉴之时！"
                                },
                                {
                                    "id": "700740913",
                                    "speaker": "Player",
                                    "text": "——你先别喝！"
                                },
                                {
                                    "id": "700740914",
                                    "speaker": "法尔伽",
                                    "text": "嗯？你们是想尝第一杯？哼哼…这第一杯的荣耀我是绝对不会让出去的！"
                                },
                                {
                                    "id": "700740915",
                                    "speaker": "Player",
                                    "text": "不是这个问题！"
                                },
                                {
                                    "id": "700740916",
                                    "speaker": "法尔伽",
                                    "text": "放心吧！我会给你们留一点的——"
                                },
                                {
                                    "id": "700740917",
                                    "speaker": "法尔伽",
                                    "text": "咕…咕…哈！"
                                },
                                {
                                    "id": "700740918",
                                    "speaker": "法尔伽",
                                    "text": "嗯？怎么感觉…有点…坏…"
                                },
                                {
                                    "id": "700740919",
                                    "speaker": "派蒙",
                                    "text": "法尔伽！你还好吗？法尔伽？法——尔——伽——！！",
                                    "choices": [
                                        {
                                            "id": "700740920",
                                            "text": "——团长！",
                                            "response": [
                                                {
                                                    "id": "700740922",
                                                    "speaker": "派蒙",
                                                    "text": "喂！都从魔神嘴里头凯旋了，倒在这种地方算什么啊！"
                                                },
                                                {
                                                    "id": "700740923",
                                                    "speaker": "法尔伽",
                                                    "text": "唔…啊…"
                                                },
                                                {
                                                    "id": "700740924",
                                                    "speaker": "法尔伽",
                                                    "text": "…感觉刚刚有一瞬间，好像看到了历代北风骑士啊…",
                                                    "choices": [
                                                        {
                                                            "id": "700740925",
                                                            "text": "该说你怎么能倒在这好…",
                                                            "response": [
                                                                {
                                                                    "id": "700740927",
                                                                    "speaker": "法尔伽",
                                                                    "text": "让我再消化一下吧…不管是刚才那杯酒也好，还是这个惨痛的教训也好。"
                                                                },
                                                                {
                                                                    "id": "700740928",
                                                                    "speaker": "Black Screen",
                                                                    "text": "向法尔伽说明了迪奥娜「百分百调出美酒」的祝福…\\n只有经过她手，奇怪的材料才会变成美酒…"
                                                                },
                                                                {
                                                                    "id": "700740929",
                                                                    "speaker": "法尔伽",
                                                                    "text": "原来是这样啊…缺的那份材料，其实是泉水精灵的祝福吗…哈哈，还真是没想到！"
                                                                },
                                                                {
                                                                    "id": "700740930",
                                                                    "speaker": "派蒙",
                                                                    "text": "喂，不要一脸清爽得好像什么事都没了！你骗我们的账都还没算呢！"
                                                                },
                                                                {
                                                                    "id": "700740931",
                                                                    "speaker": "法尔伽",
                                                                    "text": "抱歉抱歉…我是真以为这酒方没问题的，还想着调完之后，一边跟你们喝一边解释呢。"
                                                                },
                                                                {
                                                                    "id": "700740932",
                                                                    "speaker": "法尔伽",
                                                                    "text": "现在么…你们应该不会想喝了吧？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700740933",
                                                                            "text": "算了算了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700740935",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "嗯…那这次的酒就当是我欠你们吧，回头去猎鹿人餐馆再请你们一顿。"
                                                                                },
                                                                                {
                                                                                    "id": "700740936",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "——请客？这还差不多！"
                                                                                },
                                                                                {
                                                                                    "id": "700740937",
                                                                                    "speaker": "Player",
                                                                                    "text": "你也太好收买了吧…"
                                                                                },
                                                                                {
                                                                                    "id": "700740938",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "呃…你看他喝了那杯酒难受这么久，也算是尝到教训了嘛？"
                                                                                },
                                                                                {
                                                                                    "id": "700740939",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "唉，自作自受啊…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "700740940",
                                                                                            "text": "不过你的空白课题…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700740942",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "哈哈，本来还想拿来当下酒故事的，现在也只能就着西北风来讲了呀。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700740943",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "…给蒙德的大家定制一套「课题」？挺好的点子，能不能给我也来一份？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700740944",
                                                                                                    "speaker": "艾莉丝",
                                                                                                    "text": "呵，你的课题——「改变水占盘里倒映的命运」——在你决定开启远征的时候，就已经完成了呀。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "700740941",
                                                                                            "text": "究竟是什么情况？"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700740934",
                                                                            "text": "怕了怕了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700740926",
                                                            "text": "还是说你这都能站起来好…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700740921",
                                            "text": "你在干什么啊团长！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700740906",
                            "text": "起码不是用语言…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7007407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700740704",
                    "speaker": "Player",
                    "text": "再等一会…"
                }
            ]
        },
        {
            "id": "7007410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700741002",
                    "speaker": "Black Screen",
                    "text": "艾琳搬出了新的木桩…"
                }
            ]
        },
        {
            "id": "7007499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700749901",
                    "speaker": "派蒙",
                    "text": "骑士团里还有这种木桩吗！太大了吧！"
                },
                {
                    "id": "700749902",
                    "speaker": "艾琳",
                    "text": "——是我父亲特制的珍藏款哦！这才配得上你们出手吧！"
                },
                {
                    "id": "700749903",
                    "speaker": "法尔伽",
                    "text": "哈哈——那就试试这个！"
                },
                {
                    "id": "700749904",
                    "speaker": "法尔伽",
                    "text": "嗯…不太行，这个成色跟那天不一样…再来一次吧。"
                },
                {
                    "id": "700749905",
                    "speaker": "法尔伽",
                    "text": "喂喂——这不就把鸽子全吓走了吗！重新等它们飞回来吧…"
                }
            ]
        }
    ]
}