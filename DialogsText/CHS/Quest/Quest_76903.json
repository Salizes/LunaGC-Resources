    "talks": [
        {
            "id": "7690301",
            "objective": "",
            "dialogues": [
                {
                    "id": "769030101",
                    "speaker": "Player",
                    "text": "关于附近发狂的稻妻武士…"
                },
                {
                    "id": "769030102",
                    "speaker": "阿锦",
                    "text": "…您说的是那个见人就砍的疯子吧。不瞒您说，我和他是同乡。"
                },
                {
                    "id": "769030103",
                    "speaker": "阿锦",
                    "text": "他叫权八，和我一样，都是从八酝岛逃出来的。对我来说…算是像弟弟一样的人吧。"
                },
                {
                    "id": "769030104",
                    "speaker": "阿锦",
                    "text": "只可惜为了生计走了歪路，得罪了不该得罪的人，结果害得跟他逃到这里的青梅竹马丧命…那孩子也彻底发了疯。"
                },
                {
                    "id": "769030105",
                    "speaker": "阿锦",
                    "text": "您要是遇到他，还请您躲远点。现在的他已经没有理智可言了。哪怕是见到我，也会直接拔刀砍过来吧。"
                },
                {
                    "id": "769030106",
                    "speaker": "阿锦",
                    "text": "又或者…若是您能予他解脱，那便是那孩子不配拥有的幸运了。"
                },
                {
                    "id": "769030107",
                    "speaker": "阿锦",
                    "text": "浮世此身哀，徒樱散尽不相待，春去难再来…春去难再来呀…"
                }
            ]
        }
    ]
}