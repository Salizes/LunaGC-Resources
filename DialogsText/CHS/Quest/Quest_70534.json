    "talks": [
        {
            "id": "7053401",
            "objective": "与费恩对话",
            "dialogues": [
                {
                    "id": "705340101",
                    "speaker": "费恩",
                    "text": "真不知道为什么又要再做一个桌面游戏，唉…"
                },
                {
                    "id": "705340102",
                    "speaker": "费恩",
                    "text": "旅行者，你吓我一跳…你也是来参加「召唤王大奖赛」的吗？",
                    "choices": [
                        {
                            "id": "705340103",
                            "text": "你在做什么呢？",
                            "response": [
                                {
                                    "id": "705340105",
                                    "speaker": "费恩",
                                    "text": "喔，这是协会里的一个冒险家自己设计的小游戏，说是一种…将七圣召唤和战斗结合起来的新型桌面游戏，叫做「妙骰战法」。"
                                },
                                {
                                    "id": "705340106",
                                    "speaker": "费恩",
                                    "text": "咱们不是正在协办「召唤王大奖赛」嘛，协会就看中了这家伙设计的「妙骰战法」，专门拿出来做了一个小活动…",
                                    "choices": [
                                        {
                                            "id": "705340107",
                                            "text": "打牌和战斗也能结合起来？",
                                            "response": [
                                                {
                                                    "id": "705340109",
                                                    "speaker": "费恩",
                                                    "text": "哈哈哈，说实话，我也不太明白。但我这边有一本规则书…您瞧瞧，这都厚成什么样了。"
                                                },
                                                {
                                                    "id": "705340110",
                                                    "speaker": "费恩",
                                                    "text": "但按照我的理解，「骰子」的使用方法应该就是「妙骰战法」的核心玩法了。"
                                                },
                                                {
                                                    "id": "705340111",
                                                    "speaker": "费恩",
                                                    "text": "总之，如果您想玩的话，就请来这边体验一下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705340108",
                                            "text": "想象不出来结合的方法…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705340104",
                            "text": "什么桌面游戏？"
                        }
                    ]
                }
            ]
        }
    ]
