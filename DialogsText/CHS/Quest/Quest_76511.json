    "talks": [
        {
            "id": "7651101",
            "objective": "前往那夏镇旁的码头",
            "dialogues": [
                {
                    "id": "765110101",
                    "speaker": "泽西切",
                    "text": "按照奈芙尔女士的预测，比赛进行到现在，那位高手差不多要到场了。"
                },
                {
                    "id": "765110102",
                    "speaker": "枫原万叶",
                    "text": "#的确，泽西切先生，晚风已经捎来了{M#他}{F#她}的气息…"
                },
                {
                    "id": "765110103",
                    "speaker": "枫原万叶",
                    "text": "#久违了，{NICKNAME}和派蒙。"
                },
                {
                    "id": "765110104",
                    "speaker": "枫原万叶",
                    "text": "看见你们容光焕发的状态，我由衷欣喜。",
                    "choices": [
                        {
                            "id": "765110105",
                            "text": "居然是万叶？",
                            "response": [
                                {
                                    "id": "765110107",
                                    "speaker": "派蒙",
                                    "text": "没想到，万叶也会来挪德卡莱，还和这位执灯人先生聊上了？"
                                },
                                {
                                    "id": "765110108",
                                    "speaker": "派蒙",
                                    "text": "不对，周围的情况…气氛怎么有点紧张？"
                                },
                                {
                                    "id": "765110109",
                                    "speaker": "枫原万叶",
                                    "text": "紧张是理所当然的，毕竟赛事已经到达了白热化的阶段，各地的「武学高人」都在等待最终结果。",
                                    "choices": [
                                        {
                                            "id": "765110110",
                                            "text": "比拼？",
                                            "response": [
                                                {
                                                    "id": "765110112",
                                                    "speaker": "泽西切",
                                                    "text": "没错，欢迎来到「挪德卡莱有限制冷静格斗赛」的决赛现场！"
                                                },
                                                {
                                                    "id": "765110113",
                                                    "speaker": "泽西切",
                                                    "text": "相比肆意出招，天马行空的比武，这次格斗赛更聚焦于淳朴的武器技艺。"
                                                },
                                                {
                                                    "id": "765110114",
                                                    "speaker": "泽西切",
                                                    "text": "因此，我们组委会才委托冒险家协会，邀请到了这位「南十字船队」的顶尖剑客，担任我们的顾问！"
                                                },
                                                {
                                                    "id": "765110115",
                                                    "speaker": "派蒙",
                                                    "text": "我明白了，这次万叶成了武斗会的评委！"
                                                },
                                                {
                                                    "id": "765110116",
                                                    "speaker": "枫原万叶",
                                                    "text": "是的，我之前也略感意外，没想到那场比武的消息居然传到了挪德卡莱。"
                                                },
                                                {
                                                    "id": "765110117",
                                                    "speaker": "枫原万叶",
                                                    "text": "大姐头她们前不久才在那夏镇参了展，处理完了这里的所有事务，短时间内不会再来了。"
                                                },
                                                {
                                                    "id": "765110118",
                                                    "speaker": "枫原万叶",
                                                    "text": "而我相对空闲，又有着「南十字武斗会」的一些经验，所以就答应了泽西切先生的邀请。"
                                                },
                                                {
                                                    "id": "765110119",
                                                    "speaker": "泽西切",
                                                    "text": "多亏万叶先生那敏锐的观察力，还有近乎绝对客观的评价，一些混乱的赛况才能被准确判明结果。"
                                                },
                                                {
                                                    "id": "765110120",
                                                    "speaker": "泽西切",
                                                    "text": "不过现在又难办了，三位冠军候选者各有优势，互相破不了对方的招。"
                                                },
                                                {
                                                    "id": "765110121",
                                                    "speaker": "泽西切",
                                                    "text": "这样打下去，再来几天几夜都没个结果。"
                                                },
                                                {
                                                    "id": "765110122",
                                                    "speaker": "派蒙",
                                                    "text": "呜啊，比赛打不出结果？还真是从没听过的情况…"
                                                },
                                                {
                                                    "id": "765110123",
                                                    "speaker": "枫原万叶",
                                                    "text": "依我看，还是实行那个方案好了。"
                                                },
                                                {
                                                    "id": "765110124",
                                                    "speaker": "泽西切",
                                                    "text": "没错，还是要麻烦这位专家中的专家。"
                                                },
                                                {
                                                    "id": "765110125",
                                                    "speaker": "派蒙",
                                                    "text": "#咦，焦点怎么转移到了{NICKNAME}身上？"
                                                },
                                                {
                                                    "id": "765110126",
                                                    "speaker": "枫原万叶",
                                                    "text": "如果你能稍微露两手，僵局就会被打破。",
                                                    "choices": [
                                                        {
                                                            "id": "765110127",
                                                            "text": "我来打表演赛？",
                                                            "response": [
                                                                {
                                                                    "id": "765110129",
                                                                    "speaker": "枫原万叶",
                                                                    "text": "不，是由你这位「南十字武斗会」的冠军，武学界的绝对泰斗，来扮演决定冠军的最终试炼人。"
                                                                },
                                                                {
                                                                    "id": "765110130",
                                                                    "speaker": "枫原万叶",
                                                                    "text": "你分别对战三位冠军候选人，以他们对你造成的威胁来进行评分。"
                                                                },
                                                                {
                                                                    "id": "765110131",
                                                                    "speaker": "枫原万叶",
                                                                    "text": "最终，分数最高的一位便将获得冠军。"
                                                                },
                                                                {
                                                                    "id": "765110132",
                                                                    "speaker": "泽西切",
                                                                    "text": "而为了答谢你为比赛做出的贡献，原定冠军一半的奖金，将支付给您作为酬劳。"
                                                                },
                                                                {
                                                                    "id": "765110133",
                                                                    "speaker": "派蒙",
                                                                    "text": "还有这种解决方式吗？"
                                                                },
                                                                {
                                                                    "id": "765110134",
                                                                    "speaker": "派蒙",
                                                                    "text": "既能搞定比赛僵住的麻烦，又给足了我们面子和好处…不愧是万叶！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765110135",
                                                                            "text": "这种事，我还真没体验过。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765110137",
                                                                                    "speaker": "泽西切",
                                                                                    "text": "真爽快，那就这么说定了！"
                                                                                },
                                                                                {
                                                                                    "id": "765110138",
                                                                                    "speaker": "枫原万叶",
                                                                                    "text": "#有劳你了，{NICKNAME}。"
                                                                                },
                                                                                {
                                                                                    "id": "765110139",
                                                                                    "speaker": "枫原万叶",
                                                                                    "text": "三位对手各有看家本领，相信你会享受这次的切磋，并展现出往届冠军的英姿。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765110136",
                                                                            "text": "的确是非常新奇的做法。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765110128",
                                                            "text": "我给大家助兴？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765110111",
                                            "text": "武学？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765110106",
                            "text": "好久不见！"
                        }
                    ]
                }
            ]
        }
    ]
}