    "talks": [
        {
            "id": "1301001",
            "objective": "前往沙漠拍卖会现场",
            "dialogues": []
        },
        {
            "id": "1301002",
            "objective": "前往沙漠拍卖会现场",
            "dialogues": [
                {
                    "id": "130100201",
                    "speaker": "派蒙",
                    "text": "好热…要是有乘凉的地方就好了…"
                },
                {
                    "id": "130100202",
                    "speaker": "Player",
                    "text": "稍微休息一下吧。"
                },
                {
                    "id": "130100203",
                    "speaker": "赛诺",
                    "text": "还有不少路要走，再坚持一下。而且从周围环境来看，这里也不适合休息。"
                },
                {
                    "id": "130100204",
                    "speaker": "派蒙",
                    "text": "呼…好吧，可赛诺不觉得热吗？"
                },
                {
                    "id": "130100205",
                    "speaker": "赛诺",
                    "text": "当然觉得，不过我已经习惯了。"
                },
                {
                    "id": "130100206",
                    "speaker": "派蒙",
                    "text": "有什么秘诀吗？我感觉已经快坚持不住啦。"
                },
                {
                    "id": "130100207",
                    "speaker": "赛诺",
                    "text": "尽可能保持清醒，然后靠毅力撑着。一旦放松下来，只会更加疲惫。"
                },
                {
                    "id": "130100208",
                    "speaker": "赛诺",
                    "text": "一步一步走，不要让大脑判断身体的极限，到相对安全的地方再彻底放松。"
                },
                {
                    "id": "130100209",
                    "speaker": "派蒙",
                    "text": "好吧。不过安全的地方指的是哪里呢？我觉得这里很安全呀。"
                },
                {
                    "id": "130100210",
                    "speaker": "派蒙",
                    "text": "你看，这里是一望无际的沙漠，附近也没什么怪物——呜哇！这些毒蝎是从哪里来的！"
                },
                {
                    "id": "130100211",
                    "speaker": "赛诺",
                    "text": "小心，这些家伙不太对劲——"
                }
            ]
        },
        {
            "id": "1301003",
            "objective": "击败伏击的魔物",
            "dialogues": []
        },
        {
            "id": "1301004",
            "objective": "与赛诺对话",
            "dialogues": [
                {
                    "id": "130100401",
                    "speaker": "派蒙",
                    "text": "呼…没想到这里居然会有毒蝎…"
                },
                {
                    "id": "130100402",
                    "speaker": "赛诺",
                    "text": "这不是普通的毒蝎。"
                },
                {
                    "id": "130100403",
                    "speaker": "赛诺",
                    "text": "你看，它们的钳子上有编号，这是人为饲养的毒蝎。"
                },
                {
                    "id": "130100404",
                    "speaker": "Player",
                    "text": "你的意思是…"
                },
                {
                    "id": "130100405",
                    "speaker": "赛诺",
                    "text": "有人不希望我们去拍卖会，所以派它们过来围堵。"
                },
                {
                    "id": "130100406",
                    "speaker": "赛诺",
                    "text": "反正周围是漫漫黄沙，就算我们被干掉，也不会有人知道。"
                },
                {
                    "id": "130100407",
                    "speaker": "派蒙",
                    "text": "好危险！幸好我们没有放松警惕。"
                },
                {
                    "id": "130100408",
                    "speaker": "赛诺",
                    "text": "但是不太对…沙漠中没有固定的路，他们怎么知道我们会到这里来？"
                },
                {
                    "id": "130100409",
                    "speaker": "赛诺",
                    "text": "#别动，{NICKNAME}。"
                },
                {
                    "id": "130100410",
                    "speaker": "赛诺",
                    "text": "果然…他们把这东西放在你身上了。"
                },
                {
                    "id": "130100411",
                    "speaker": "派蒙",
                    "text": "这是什么？"
                },
                {
                    "id": "130100412",
                    "speaker": "赛诺",
                    "text": "妙论派造出来的小型定位器，能够据此确定佩戴者的大致方位。"
                },
                {
                    "id": "130100413",
                    "speaker": "赛诺",
                    "text": "我记得这个装置没有获得量产许可，他们是从哪里搞来的…莫非有妙论派的学者牵涉其中？可是不太对…"
                },
                {
                    "id": "130100414",
                    "speaker": "派蒙",
                    "text": "#居然还有这种东西，为什么会在{NICKNAME}的身上？"
                },
                {
                    "id": "130100415",
                    "speaker": "赛诺",
                    "text": "应该是和佣兵缠斗的时候，被他们放上去的。",
                    "choices": [
                        {
                            "id": "130100416",
                            "text": "抱歉。",
                            "response": [
                                {
                                    "id": "130100418",
                                    "speaker": "赛诺",
                                    "text": "当时情况很乱，没发现很正常。"
                                },
                                {
                                    "id": "130100419",
                                    "speaker": "派蒙",
                                    "text": "幸亏赛诺发现了，那我们快把它扔掉！"
                                },
                                {
                                    "id": "130100420",
                                    "speaker": "赛诺",
                                    "text": "…不，还是先让它留在你身上，应该会派上用场。"
                                },
                                {
                                    "id": "130100421",
                                    "speaker": "赛诺",
                                    "text": "继续去拍卖会吧，在这里耽误太久，说不定会有别的危险。"
                                }
                            ]
                        },
                        {
                            "id": "130100417",
                            "text": "没注意到…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1301005",
            "objective": "继续前往沙漠拍卖会",
            "dialogues": []
        },
        {
            "id": "1301006",
            "objective": "击败伏击的魔物",
            "dialogues": [
                {
                    "id": "130100601",
                    "speaker": "派蒙",
                    "text": "奇怪，这里就是拍卖会吗？"
                },
                {
                    "id": "130100602",
                    "speaker": "Player",
                    "text": "一个人都没有。"
                },
                {
                    "id": "130100603",
                    "speaker": "派蒙",
                    "text": "是呀！一个人都没有，难道说是中场休息？"
                },
                {
                    "id": "130100604",
                    "speaker": "赛诺",
                    "text": "打败那些佣兵团之后，我们立刻马不停蹄地赶往这里。之所以这么急，就是担心会有人过来通风报信。"
                },
                {
                    "id": "130100605",
                    "speaker": "赛诺",
                    "text": "而我们还是扑了个空，想必是因为这里的人通过定位器观察到了我们的动向，提前撤离了。"
                },
                {
                    "id": "130100606",
                    "speaker": "派蒙",
                    "text": "那我们现在该怎么办？"
                },
                {
                    "id": "130100607",
                    "speaker": "赛诺",
                    "text": "搜。他们没来得及转移所有的罐装知识，这里可能会有线索。"
                },
                {
                    "id": "130100608",
                    "speaker": "派蒙",
                    "text": "那我们可要好好找一找！"
                }
            ]
        },
        {
            "id": "1301009",
            "objective": "继续前往沙漠拍卖会",
            "dialogues": []
        },
        {
            "id": "1301018",
            "objective": "调查拍卖会现场",
            "dialogues": [
                {
                    "id": "130101301",
                    "speaker": "调查",
                    "text": "（散乱的脚印还未完全被风沙掩埋，但也无法根据脚印推测商人们逃跑的方向。）"
                }
            ]
        },
        {
            "id": "1301017",
            "objective": "调查拍卖会现场",
            "dialogues": [
                {
                    "id": "130101401",
                    "speaker": "调查",
                    "text": "（驮兽正在优哉游哉地喝水，似乎完全没有受到什么影响。）"
                }
            ]
        },
        {
            "id": "1301016",
            "objective": "调查拍卖会现场",
            "dialogues": [
                {
                    "id": "130101501",
                    "speaker": "调查",
                    "text": "（普通的罐装知识，和归寂之庭似乎没什么关系。）"
                }
            ]
        },
        {
            "id": "1301015",
            "objective": "调查拍卖会现场",
            "dialogues": [
                {
                    "id": "130101601",
                    "speaker": "调查",
                    "text": "（大量罐装知识堆积在这里，以市价来看，相当于一笔极其庞大的摩拉。）"
                }
            ]
        },
        {
            "id": "1301013",
            "objective": "与赛诺对话",
            "dialogues": [
                {
                    "id": "130100610",
                    "speaker": "赛诺",
                    "text": "有什么发现吗？"
                },
                {
                    "id": "130100611",
                    "speaker": "派蒙",
                    "text": "嗯…好像没有看到什么特别的地方…"
                },
                {
                    "id": "130100612",
                    "speaker": "Player",
                    "text": "都是一些很普通的罐装知识。"
                },
                {
                    "id": "130100613",
                    "speaker": "赛诺",
                    "text": "也许是记录归寂之庭的罐装知识数量不多，被他们带走了。"
                },
                {
                    "id": "130100614",
                    "speaker": "赛诺",
                    "text": "#没关系，我还有一个办法。{NICKNAME}，你们原路返回，而我藏在这里。"
                },
                {
                    "id": "130100615",
                    "speaker": "赛诺",
                    "text": "过一段时间你们回来跟我会合，应该会有收获。"
                },
                {
                    "id": "130100616",
                    "speaker": "Player",
                    "text": "难怪你让我带着定位器…"
                },
                {
                    "id": "130100617",
                    "speaker": "赛诺",
                    "text": "他们匆忙撤离，很多货物来不及带走，不可能一直这样放着不管。"
                },
                {
                    "id": "130100618",
                    "speaker": "赛诺",
                    "text": "确认我们「离开」之后，自然会有人过来收拾。所以要让定位器离这里足够远，让他们误以为自己已经安全。"
                },
                {
                    "id": "130100619",
                    "speaker": "派蒙",
                    "text": "我明白了！你是想让我们当诱饵，来骗他们现身！"
                },
                {
                    "id": "130100620",
                    "speaker": "派蒙",
                    "text": "好吧，我们现在就出发，这里就交给你啦。"
                },
                {
                    "id": "130100621",
                    "speaker": "赛诺",
                    "text": "放心。只要他们敢来，我一定把他们留下。"
                }
            ]
        },
        {
            "id": "1301010",
            "objective": "携带定位器离开拍卖会",
            "dialogues": [
                {
                    "id": "130101001",
                    "speaker": "派蒙",
                    "text": "呼…好累呀，走了这么远，应该可以了吧？",
                    "choices": [
                        {
                            "id": "130101002",
                            "text": "可以了。",
                            "response": [
                                {
                                    "id": "130101003",
                                    "speaker": "派蒙",
                                    "text": "好耶！那我们就在这里休息一会儿，然后回去找赛诺吧！"
                                },
                                {
                                    "id": "130101006",
                                    "speaker": "Black Screen",
                                    "text": "在附近坐下歇息了一段时间。"
                                },
                                {
                                    "id": "130101007",
                                    "speaker": "派蒙",
                                    "text": "感觉时间差不多了，我们回拍卖会那里看看吧？"
                                },
                                {
                                    "id": "130101008",
                                    "speaker": "派蒙",
                                    "text": "不知道赛诺那边有没有收获…"
                                }
                            ]
                        },
                        {
                            "id": "130101004",
                            "text": "再走一段路。",
                            "response": [
                                {
                                    "id": "130101005",
                                    "speaker": "派蒙",
                                    "text": "还要继续走吗？可是我已经没力气了…不如就在这里休息一会儿吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1301011",
            "objective": "与赛诺会合",
            "dialogues": [
                {
                    "id": "130100701",
                    "speaker": "派蒙",
                    "text": "哇！真的抓到了！"
                },
                {
                    "id": "130100702",
                    "speaker": "派蒙",
                    "text": "你就是在背后捣鬼的大坏蛋吗？快把你知道的说出来！",
                    "choices": [
                        {
                            "id": "130100703",
                            "text": "这个人知道什么吗？",
                            "response": [
                                {
                                    "id": "130100705",
                                    "speaker": "赛诺",
                                    "text": "刚刚他出现的时候，我没有第一时间出手，而是在旁边观察了一会儿。"
                                },
                                {
                                    "id": "130100706",
                                    "speaker": "赛诺",
                                    "text": "他不是幕后主使，但他应该是一个分量不轻的商人。我说的对吧？"
                                },
                                {
                                    "id": "130100707",
                                    "speaker": "巴哈利",
                                    "text": "不愧是赛诺，看得真准…早知道你没走，我就不贪这点便宜了。"
                                },
                                {
                                    "id": "130100708",
                                    "speaker": "派蒙",
                                    "text": "贪便宜？什么意思？"
                                },
                                {
                                    "id": "130100709",
                                    "speaker": "巴哈利",
                                    "text": "得知你们要来，各地的罐装知识商人立刻作鸟兽散，货物也来不及全部带走。"
                                },
                                {
                                    "id": "130100710",
                                    "speaker": "巴哈利",
                                    "text": "这些暂时都是无主之物，只要抢在别人之前拿回去，就能大赚一笔。当然，现在说这些也没有什么意义了。"
                                },
                                {
                                    "id": "130100711",
                                    "speaker": "赛诺",
                                    "text": "你应该知道是谁在制造和售卖罐装知识吧。需要我动手，还是你自己说？"
                                },
                                {
                                    "id": "130100712",
                                    "speaker": "巴哈利",
                                    "text": "我自己说吧。不过在那之前，我希望换个地方说话…"
                                },
                                {
                                    "id": "130100713",
                                    "speaker": "巴哈利",
                                    "text": "留在这里，如果被别人看到我和你们接触，我和我的家人也会有危险。"
                                },
                                {
                                    "id": "130100714",
                                    "speaker": "赛诺",
                                    "text": "你想去哪？"
                                },
                                {
                                    "id": "130100715",
                                    "speaker": "巴哈利",
                                    "text": "到我家吧，在阿如村，那里很安全。"
                                },
                                {
                                    "id": "130100716",
                                    "speaker": "赛诺",
                                    "text": "#可以。{NICKNAME}，把定位器丢掉，我们过去看看。"
                                }
                            ]
                        },
                        {
                            "id": "130100704",
                            "text": "这个人的「分量」够吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1301007",
            "objective": "跟随巴哈利前往阿如村",
            "dialogues": []
        },
        {
            "id": "1301008",
            "objective": "跟随巴哈利前往阿如村",
            "dialogues": [
                {
                    "id": "130100801",
                    "speaker": "西敏",
                    "text": "爸爸，你回来啦！"
                },
                {
                    "id": "130100802",
                    "speaker": "西敏",
                    "text": "啊，是客人吗？你们好…"
                },
                {
                    "id": "130100803",
                    "speaker": "巴哈利",
                    "text": "这是我的女儿，名叫西敏，稍微有些怕生。"
                },
                {
                    "id": "130100804",
                    "speaker": "巴哈利",
                    "text": "乖，你先自己玩会儿，爸爸有事要和几位客人聊。"
                },
                {
                    "id": "130100805",
                    "speaker": "西敏",
                    "text": "噢…好…"
                },
                {
                    "id": "130100806",
                    "speaker": "巴哈利",
                    "text": "赛诺的名字，业内没有不知道的。你们两位怎么称呼？"
                },
                {
                    "id": "130100807",
                    "speaker": "派蒙",
                    "text": "#我是派蒙，这位是{NICKNAME}！"
                },
                {
                    "id": "130100808",
                    "speaker": "巴哈利",
                    "text": "说实话，我也没想到那位独来独往的赛诺，居然会有同伴。所以看着定位器逐渐远离，我才笃定是赛诺无功而返。"
                },
                {
                    "id": "130100809",
                    "speaker": "巴哈利",
                    "text": "不过，就算你们抓到了我，我还是想劝你们一句…到此为止吧，不要继续查下去了。"
                },
                {
                    "id": "130100810",
                    "speaker": "赛诺",
                    "text": "为什么？"
                },
                {
                    "id": "130100811",
                    "speaker": "巴哈利",
                    "text": "制造、销售、分赃…每个环节少则几十人、多则上百人，高额的利润让所有人聚拢在一起。"
                },
                {
                    "id": "130100812",
                    "speaker": "巴哈利",
                    "text": "为了维护这条来之不易的产业链，每个人都会竭尽全力，就算是你也只能撞得头破血流。"
                },
                {
                    "id": "130100813",
                    "speaker": "巴哈利",
                    "text": "而且就算你真的做到了，也没有任何人会感谢你。或许你自己都会感到难过…为什么要这么拼命呢？"
                },
                {
                    "id": "130100814",
                    "speaker": "赛诺",
                    "text": "每个人都有自己的坚持，没什么好说的。"
                },
                {
                    "id": "130100815",
                    "speaker": "巴哈利",
                    "text": "唉…"
                },
                {
                    "id": "130100816",
                    "speaker": "西敏",
                    "text": "爸爸…喝茶…还有客人的…"
                },
                {
                    "id": "130100817",
                    "speaker": "巴哈利",
                    "text": "哦，瞧我都忘了给客人倒茶了。多谢你了。"
                },
                {
                    "id": "130100818",
                    "speaker": "西敏",
                    "text": "没事…那个…"
                },
                {
                    "id": "130100819",
                    "speaker": "西敏",
                    "text": "家里的茶很苦。所以，我把爸爸给我的糖放进去了。应该会好喝一些…"
                },
                {
                    "id": "130100820",
                    "speaker": "巴哈利",
                    "text": "真懂事，糖还有吗？没有的话，爸爸下次再给你买。"
                },
                {
                    "id": "130100821",
                    "speaker": "西敏",
                    "text": "好…我去休息了。"
                },
                {
                    "id": "130100822",
                    "speaker": "赛诺",
                    "text": "不是说参与其中的人可以获得高额的利润吗？我从你身上看不到这一点。"
                },
                {
                    "id": "130100823",
                    "speaker": "巴哈利",
                    "text": "…其实，这也是我想跟你们说的，一个我自己的请求。"
                },
                {
                    "id": "130100824",
                    "speaker": "巴哈利",
                    "text": "我的女儿，出生起就患有一种顽疾。她的心肺比一般人虚弱，稍微剧烈的运动就可能导致晕厥，甚至面临生命危险。"
                },
                {
                    "id": "130100825",
                    "speaker": "巴哈利",
                    "text": "因为这个原因，她自幼没有玩伴，整天把自己关在房间里。平时还要吃很多药，开销很大。"
                },
                {
                    "id": "130100826",
                    "speaker": "巴哈利",
                    "text": "而我呢，原本只是个小商人，起早贪黑、东奔西走，赚到的那点钱远远不够，只能一天天地看着她越来越虚弱。"
                },
                {
                    "id": "130100827",
                    "speaker": "巴哈利",
                    "text": "直到有人找上我，给我指了一条生财之道——"
                },
                {
                    "id": "130100828",
                    "speaker": "赛诺",
                    "text": "售卖罐装知识？"
                },
                {
                    "id": "130100829",
                    "speaker": "巴哈利",
                    "text": "没错。赚到了钱，总算可以给她治病。看着她逐渐好起来，我心里比谁都开心。"
                },
                {
                    "id": "130100830",
                    "speaker": "巴哈利",
                    "text": "像我这样的人还有很多。走私罐装知识在你看来不可原谅，但对我们来说这却是活命的办法。"
                },
                {
                    "id": "130100831",
                    "speaker": "巴哈利",
                    "text": "我告诉你这些，就是想劝你一句——收手吧，赛诺大人，给我们一条活路。"
                },
                {
                    "id": "130100832",
                    "speaker": "派蒙",
                    "text": "怎么会这样…也就是说如果我们禁止售卖罐装知识，她就会…"
                },
                {
                    "id": "130100833",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "130100834",
                    "speaker": "赛诺",
                    "text": "……"
                },
                {
                    "id": "130100835",
                    "speaker": "赛诺",
                    "text": "我必须要知道真相。"
                },
                {
                    "id": "130100836",
                    "speaker": "赛诺",
                    "text": "我可以找人帮那孩子看病，但我不能对走私罐装知识视而不见。这是两码事。"
                },
                {
                    "id": "130100837",
                    "speaker": "巴哈利",
                    "text": "我就知道你会这么说，不过有你这句话就够了。既然你执意要查下去，就去房屋后面找吧。"
                },
                {
                    "id": "130100838",
                    "speaker": "巴哈利",
                    "text": "那里有我不久前刚刚进的货，看过之后，你就明白了。"
                },
                {
                    "id": "130100839",
                    "speaker": "Black Screen",
                    "text": "与赛诺一同来到了房屋后面。"
                },
                {
                    "id": "130100840",
                    "speaker": "派蒙",
                    "text": "居然有这么多！"
                },
                {
                    "id": "130100841",
                    "speaker": "赛诺",
                    "text": "整整齐齐装了这么多箱子，这里还只是其中一个商人的窝点。"
                },
                {
                    "id": "130100842",
                    "speaker": "赛诺",
                    "text": "这个数量不可能是小作坊生产的。难道真的是教令院？可是像这样大宗货物进出，不可能没有审查…"
                },
                {
                    "id": "130100843",
                    "speaker": "派蒙",
                    "text": "快看，这些罐装知识好像不太一样，难道这就是记录归寂之庭的罐装知识？"
                },
                {
                    "id": "130100844",
                    "speaker": "赛诺",
                    "text": "应该没错。等等，这是…",
                    "choices": [
                        {
                            "id": "130100845",
                            "text": "没见过的标记。",
                            "response": [
                                {
                                    "id": "130100847",
                                    "speaker": "赛诺",
                                    "text": "这是风纪官的放行图章。印有这个标记，就意味着里面的货物已经由风纪官审查过了。"
                                },
                                {
                                    "id": "130100848",
                                    "speaker": "赛诺",
                                    "text": "见到定位器的时候，我怀疑有教令院的人参与其中，但我想不明白怎么把这么多罐装知识送出教令院。"
                                },
                                {
                                    "id": "130100849",
                                    "speaker": "赛诺",
                                    "text": "现在我明白了。有了这个图章，货物进出教令院就无需二次审查，可以畅行无阻。"
                                },
                                {
                                    "id": "130100850",
                                    "speaker": "赛诺",
                                    "text": "哼，难怪不希望我继续查下去。破坏风纪的竟是风纪官本身，难以置信。"
                                },
                                {
                                    "id": "130100851",
                                    "speaker": "Player",
                                    "text": "也可能是误会。"
                                },
                                {
                                    "id": "130100852",
                                    "speaker": "赛诺",
                                    "text": "#{NICKNAME}，可以拜托你一件事吗？"
                                },
                                {
                                    "id": "130100853",
                                    "speaker": "赛诺",
                                    "text": "既然这些罐装知识来自教令院，那么关于归寂之庭的罐装知识，很可能用的也是教令院内封存的研究资料。"
                                },
                                {
                                    "id": "130100854",
                                    "speaker": "赛诺",
                                    "text": "只要去资料室查看记录，就能搞清楚背后是谁在捣鬼了。"
                                },
                                {
                                    "id": "130100855",
                                    "speaker": "赛诺",
                                    "text": "但以我现在的身份，贸然出现在教令院，只会打草惊蛇。"
                                },
                                {
                                    "id": "130100856",
                                    "speaker": "赛诺",
                                    "text": "这件事，可以拜托你来调查吗？我会写信给纳比尔，让他带你去资料室。"
                                },
                                {
                                    "id": "130100857",
                                    "speaker": "派蒙",
                                    "text": "包在我们身上！"
                                },
                                {
                                    "id": "130100858",
                                    "speaker": "赛诺",
                                    "text": "这段时间我也不会闲着。虽然幕后之人的线索指向教令院，但对方明显在教令院外也很有势力。"
                                },
                                {
                                    "id": "130100859",
                                    "speaker": "赛诺",
                                    "text": "从巴哈利那里可以拿到一些其他商人的信息，我留下来提前做些准备。你们有什么新的发现，可以随时回来找我。"
                                }
                            ]
                        },
                        {
                            "id": "130100846",
                            "text": "赛诺认识吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1301011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130101101",
                    "speaker": "赛诺",
                    "text": "事不宜迟，准备好就出发吧。"
                }
            ]
        },
        {
            "id": "1301099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "130109902",
                    "speaker": "派蒙",
                    "text": "喂，你可不许耍什么花招哦！"
                },
                {
                    "id": "130109903",
                    "speaker": "巴哈利",
                    "text": "你也太抬举我了…被那位眼光毒辣的赛诺盯着，我哪有什么花招可以耍？"
                }
            ]
        }
    ]
}