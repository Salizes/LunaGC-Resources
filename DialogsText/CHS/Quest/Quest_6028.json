    "talks": [
        {
            "id": "602801",
            "objective": "踏上回月亮的路",
            "dialogues": []
        },
        {
            "id": "602802",
            "objective": "踏上回月亮的路",
            "dialogues": [
                {
                    "id": "60280201",
                    "speaker": "「少女」",
                    "text": "这里就是…亥珀波瑞亚时期，人们与「月亮」沟通的地方…"
                },
                {
                    "id": "60280202",
                    "speaker": "菈乌玛",
                    "text": "恒月、霜月、虹月…当三个月亮的力量汇聚时…"
                },
                {
                    "id": "60280203",
                    "speaker": "「少女」",
                    "text": "通往月亮的门就会打开。"
                },
                {
                    "id": "60280204",
                    "speaker": "菈乌玛",
                    "text": "嗯…"
                },
                {
                    "id": "60280205",
                    "speaker": "「仆人」",
                    "text": "月髓已经准备就绪，只差最后一步了。"
                },
                {
                    "id": "60280206",
                    "speaker": "「少女」",
                    "text": "现在的那夏镇，应该是最热闹的时候吧。"
                },
                {
                    "id": "60280207",
                    "speaker": "派蒙",
                    "text": "是啊，可惜我们不得不在这种时候送你回去。"
                },
                {
                    "id": "60280208",
                    "speaker": "「少女」",
                    "text": "没关系的，作为最后一份，也是唯一一份行李，我很满意。"
                },
                {
                    "id": "60280209",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "60280210",
                    "speaker": "「少女」",
                    "text": "我已经感受到了，来自月亮的召唤。"
                },
                {
                    "id": "60280211",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "60280212",
                    "speaker": "「仆人」",
                    "text": "你的家就在这束光的彼岸，哥伦比娅。"
                },
                {
                    "id": "60280213",
                    "speaker": "菈乌玛",
                    "text": "以后终于有对真正的月亮祈祷的理由了。"
                },
                {
                    "id": "60280214",
                    "speaker": "Player",
                    "text": "哥伦比娅。"
                },
                {
                    "id": "60280215",
                    "speaker": "「少女」",
                    "text": "嗯，我听着呢。"
                },
                {
                    "id": "60280216",
                    "speaker": "Player",
                    "text": "如果有机会，就多回来看看吧！"
                },
                {
                    "id": "60280217",
                    "speaker": "「少女」",
                    "text": "哈…当然。"
                },
                {
                    "id": "60280218",
                    "speaker": "Player",
                    "text": "如果没有…也请记得，在这个星球上有一群想念着「哥伦比娅」的朋友们。"
                },
                {
                    "id": "60280219",
                    "speaker": "「少女」",
                    "text": "嗯，一定会的，谢谢你们为我做那么多。"
                },
                {
                    "id": "60280220",
                    "speaker": "「少女」",
                    "text": "也请你们记得，月光永远联系着我们，不论日夜。"
                },
                {
                    "id": "60280221",
                    "speaker": "「少女」",
                    "text": "呼…那么…再见了，我的朋友们。"
                }
            ]
        },
        {
            "id": "602803",
            "objective": "踏上回月亮的路",
            "dialogues": []
        },
        {
            "id": "602804",
            "objective": "与同伴们商讨对策",
            "dialogues": [
                {
                    "id": "60280301",
                    "speaker": "菈乌玛",
                    "text": "如何，伤口还痛吗？"
                },
                {
                    "id": "60280302",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "60280303",
                    "speaker": "奈芙尔",
                    "text": "我找人准备了些可能会用到的药品，需要就吃吧。",
                    "choices": [
                        {
                            "id": "60280304",
                            "text": "谢谢…",
                            "response": [
                                {
                                    "id": "60280306",
                                    "speaker": "杜林",
                                    "text": "那，我把事件发生后，和艾莉丝女士的通话内容复述一下。"
                                },
                                {
                                    "id": "60280307",
                                    "speaker": "艾莉丝",
                                    "text": "多托雷那个家伙，为了吸引「魔女会」的注意，在提瓦特的边界做了大文章。"
                                },
                                {
                                    "id": "60280308",
                                    "speaker": "艾莉丝",
                                    "text": "我一直以为是来自世界外的深渊力量在干扰提瓦特，这是相当常见的情况。"
                                },
                                {
                                    "id": "60280309",
                                    "speaker": "艾莉丝",
                                    "text": "但是在杜林你们成功干涉了挪德卡莱的虚影之后，我意识到这种干扰也有可能来自提瓦特内部。"
                                },
                                {
                                    "id": "60280310",
                                    "speaker": "杜林",
                                    "text": "可是，我们并没有改变虚影的命运啊…"
                                },
                                {
                                    "id": "60280311",
                                    "speaker": "艾莉丝",
                                    "text": "对，你们没有影响那个虚影的结局，但是某种「变数」被堆砌到了你的身上。"
                                },
                                {
                                    "id": "60280312",
                                    "speaker": "Wanderer",
                                    "text": "「变数」？"
                                },
                                {
                                    "id": "60280313",
                                    "speaker": "艾莉丝",
                                    "text": "嗯，比如你们听到了本来无从得知的消息，或是产生了原本不会萌发的想法，这都算是「变数」。"
                                },
                                {
                                    "id": "60280314",
                                    "speaker": "艾莉丝",
                                    "text": "当然这种事在几乎无穷无尽的可能性面前，并不算什么，可是当它被刻意堆砌，概念就不一样了。"
                                },
                                {
                                    "id": "60280315",
                                    "speaker": "艾莉丝",
                                    "text": "而这一切「变数」，便是让多托雷能够在这一晚，在你们开启传送门的时候，达成自己阴谋的必要条件。"
                                },
                                {
                                    "id": "60280316",
                                    "speaker": "尼可",
                                    "text": "不过，具体多托雷做了什么，我们还无从得知。"
                                },
                                {
                                    "id": "60280317",
                                    "speaker": "法尔伽",
                                    "text": "嗯，还要搞清楚哥伦比娅的现状如何。"
                                },
                                {
                                    "id": "60280318",
                                    "speaker": "杜林",
                                    "text": "大概就是这样。"
                                },
                                {
                                    "id": "60280319",
                                    "speaker": "「仆人」",
                                    "text": "和我想的一样，多托雷完全消失了。但至少他并没有如愿控制哥伦比娅。"
                                },
                                {
                                    "id": "60280320",
                                    "speaker": "Player",
                                    "text": "但现状可能比那更糟…"
                                },
                                {
                                    "id": "60280321",
                                    "speaker": "派蒙",
                                    "text": "唔…",
                                    "choices": [
                                        {
                                            "id": "60280322",
                                            "text": "她为了破坏「博士」的计划…",
                                            "response": [
                                                {
                                                    "id": "60280324",
                                                    "speaker": "派蒙",
                                                    "text": "欸，是这样吗？！"
                                                },
                                                {
                                                    "id": "60280325",
                                                    "speaker": "Player",
                                                    "text": "你们没看到吗？她跳了进去…"
                                                },
                                                {
                                                    "id": "60280326",
                                                    "speaker": "派蒙",
                                                    "text": "我们只看到「博士」出现，使用了某种力量，接着他和哥伦比娅就都消失了，你也从空中掉进了海里。"
                                                },
                                                {
                                                    "id": "60280327",
                                                    "speaker": "Player",
                                                    "text": "（原来如此，「博士」锁定了时间，只有我可以自由行动。）"
                                                },
                                                {
                                                    "id": "60280328",
                                                    "speaker": "Player",
                                                    "text": "（在他们眼里，那场战斗和哥伦比娅的决断都只是一瞬间的事。）"
                                                },
                                                {
                                                    "id": "60280329",
                                                    "speaker": "Player",
                                                    "text": "（这就是「三月」的权能吗…我没受到影响…是因为我是「降临者」？）"
                                                },
                                                {
                                                    "id": "60280330",
                                                    "speaker": "奈芙尔",
                                                    "text": "所以，哥伦比娅主动开启了「月之门」，落入了雷利尔和索琳蒂丝曾踏入的神秘空间…"
                                                },
                                                {
                                                    "id": "60280331",
                                                    "speaker": "法尔伽",
                                                    "text": "凶多吉少啊。"
                                                },
                                                {
                                                    "id": "60280332",
                                                    "speaker": "「仆人」",
                                                    "text": "……",
                                                    "choices": [
                                                        {
                                                            "id": "60280333",
                                                            "text": "所以多托雷一直躲着我们…",
                                                            "response": [
                                                                {
                                                                    "id": "60280335",
                                                                    "speaker": "阿贝多",
                                                                    "text": "这么看来，「三月现世」、还有猎月人的出现…恐怕背后都有多托雷在操纵。"
                                                                },
                                                                {
                                                                    "id": "60280336",
                                                                    "speaker": "阿贝多",
                                                                    "text": "按照艾莉丝女士的说法，他想做的事，就是超越自己的命运，完成只有神才能完成的实验。"
                                                                },
                                                                {
                                                                    "id": "60280337",
                                                                    "speaker": "「仆人」",
                                                                    "text": "…真是个疯狂的家伙。"
                                                                },
                                                                {
                                                                    "id": "60280338",
                                                                    "speaker": "派蒙",
                                                                    "text": "对了，阿帽呢，他怎么不在这里？"
                                                                },
                                                                {
                                                                    "id": "60280339",
                                                                    "speaker": "杜林",
                                                                    "text": "在和艾莉丝女士通讯之后，他说有些眉目，就拿走了嘟嘟通讯仪，独自去调查了。"
                                                                },
                                                                {
                                                                    "id": "60280340",
                                                                    "speaker": "杜林",
                                                                    "text": "临走的时候他的表情变得很可怕，我从来没见过他那副样子…"
                                                                },
                                                                {
                                                                    "id": "60280341",
                                                                    "speaker": "Player",
                                                                    "text": "（应该是愤怒和不甘心吧，明明已经在提防多托雷了，还是被他抢先了一步。）"
                                                                },
                                                                {
                                                                    "id": "60280342",
                                                                    "speaker": "Player",
                                                                    "text": "（这么说的话，我又何尝不是这样…）"
                                                                },
                                                                {
                                                                    "id": "60280343",
                                                                    "speaker": "Wanderer",
                                                                    "text": "我回来了。"
                                                                },
                                                                {
                                                                    "id": "60280344",
                                                                    "speaker": "杜林",
                                                                    "text": "阿帽！"
                                                                },
                                                                {
                                                                    "id": "60280345",
                                                                    "speaker": "Wanderer",
                                                                    "text": "我又去找了那些「亥珀波瑞亚」的虚影，总算是搞清楚了。"
                                                                },
                                                                {
                                                                    "id": "60280346",
                                                                    "speaker": "Wanderer",
                                                                    "text": "我让他们和通讯仪另一边的尼可细细对质，发现他们描述的历史和尼可的记忆果然是不同的。"
                                                                },
                                                                {
                                                                    "id": "60280347",
                                                                    "speaker": "派蒙",
                                                                    "text": "为什么会这样？尼可应该不会出错才对。"
                                                                },
                                                                {
                                                                    "id": "60280348",
                                                                    "speaker": "Wanderer",
                                                                    "text": "因为被骗的是那些虚影。他们的历史里出现了一个根本就不该存在的救世主。"
                                                                },
                                                                {
                                                                    "id": "60280349",
                                                                    "speaker": "Wanderer",
                                                                    "text": "这个救世主许诺他们能够在虚假之天内创造一个新的月亮，还能把他们的月神带回来。"
                                                                },
                                                                {
                                                                    "id": "60280350",
                                                                    "speaker": "Wanderer",
                                                                    "text": "这些人愚蠢地相信了他，将他所需要的关于月亮的知识全部告诉了他。"
                                                                },
                                                                {
                                                                    "id": "60280351",
                                                                    "speaker": "Wanderer",
                                                                    "text": "一听就知道，这是多托雷在搞鬼。"
                                                                },
                                                                {
                                                                    "id": "60280352",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "在亥珀波瑞亚的遗迹中，听虚影聊起历史，尼可会说里面有些错误…"
                                                                },
                                                                {
                                                                    "id": "60280353",
                                                                    "speaker": "派蒙",
                                                                    "text": "可多托雷应该没办法进入那扇门啊！"
                                                                },
                                                                {
                                                                    "id": "60280354",
                                                                    "speaker": "Wanderer",
                                                                    "text": "他没进去过。尼可说，这是同时代的虚影因果联系被干扰后引发的异样状况。"
                                                                },
                                                                {
                                                                    "id": "60280355",
                                                                    "speaker": "Wanderer",
                                                                    "text": "而多托雷所堆砌的「变数」，甚至大到能够对不曾见过的虚影造成影响。"
                                                                },
                                                                {
                                                                    "id": "60280356",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "原来不是记忆不清，而是被篡改了啊。"
                                                                },
                                                                {
                                                                    "id": "60280357",
                                                                    "speaker": "Wanderer",
                                                                    "text": "这就是多托雷想方设法堆砌的可能性，他将变数化为知识，都堆砌在了自己的身上。"
                                                                },
                                                                {
                                                                    "id": "60280358",
                                                                    "speaker": "Wanderer",
                                                                    "text": "「祈月之夜」的夜晚…他用这些知识，真的创造了一轮「伪月」。"
                                                                },
                                                                {
                                                                    "id": "60280359",
                                                                    "speaker": "派蒙",
                                                                    "text": "这怎么可能做到？"
                                                                },
                                                                {
                                                                    "id": "60280360",
                                                                    "speaker": "Wanderer",
                                                                    "text": "准确来说，是让术法的感知出现了偏差——"
                                                                },
                                                                {
                                                                    "id": "60280361",
                                                                    "speaker": "Wanderer",
                                                                    "text": "术法通过月矩力感受月亮的位置，只要「伪月」比天外的霜月更像月亮…"
                                                                },
                                                                {
                                                                    "id": "60280362",
                                                                    "speaker": "Wanderer",
                                                                    "text": "那扇门就会把哥伦比娅送到「伪月」的位置，也就是多托雷身边！"
                                                                },
                                                                {
                                                                    "id": "60280363",
                                                                    "speaker": "Wanderer",
                                                                    "text": "在多托雷控制了哥伦比娅之后，传送术法依然维持着，他又操纵她的力量，夺走了两块月髓。"
                                                                },
                                                                {
                                                                    "id": "60280364",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "那个时候，月髓从我们眼前突然消失…离开遗迹的时候，为时已晚。"
                                                                },
                                                                {
                                                                    "id": "60280365",
                                                                    "speaker": "「仆人」",
                                                                    "text": "那时候，多托雷已经集齐了三月的力量。"
                                                                },
                                                                {
                                                                    "id": "60280366",
                                                                    "speaker": "派蒙",
                                                                    "text": "现在要…如何是好…"
                                                                },
                                                                {
                                                                    "id": "60280367",
                                                                    "speaker": "「仆人」",
                                                                    "text": "我想知道女皇陛下的想法，之前和她提及的担心果然发生了。但我们也不能一味等待女皇陛下的决断…"
                                                                },
                                                                {
                                                                    "id": "60280368",
                                                                    "speaker": "「仆人」",
                                                                    "text": "将我们视作朋友的，并非愚人众执行官「少女」，而是哥伦比娅·希珀塞莱尼娅。"
                                                                },
                                                                {
                                                                    "id": "60280369",
                                                                    "speaker": "「仆人」",
                                                                    "text": "在此严峻情形下，如果女皇陛下仍然执意禁止执行官之间的兵刃相向…"
                                                                },
                                                                {
                                                                    "id": "60280370",
                                                                    "speaker": "「仆人」",
                                                                    "text": "那我也将遵从内心的选择，以「佩露薇利」的身份出战。"
                                                                },
                                                                {
                                                                    "id": "60280371",
                                                                    "speaker": "派蒙",
                                                                    "text": "阿蕾奇诺…"
                                                                },
                                                                {
                                                                    "id": "60280372",
                                                                    "speaker": "「仆人」",
                                                                    "text": "时间紧迫，我先走一步。"
                                                                },
                                                                {
                                                                    "id": "60280373",
                                                                    "speaker": "派蒙",
                                                                    "text": "就连阿蕾奇诺好像也变得不太冷静了…"
                                                                },
                                                                {
                                                                    "id": "60280374",
                                                                    "speaker": "Player",
                                                                    "text": "（可能她觉得这件事有她的责任，而我也是同样…可恶。）"
                                                                },
                                                                {
                                                                    "id": "60280375",
                                                                    "speaker": "Wanderer",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "60280376",
                                                                    "speaker": "杜林",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "60280377",
                                                                    "speaker": "法尔伽",
                                                                    "text": "来来来，大家不要都丧着脸，听我说两句。"
                                                                },
                                                                {
                                                                    "id": "60280378",
                                                                    "speaker": "法尔伽",
                                                                    "text": "情况很糟，非常糟。"
                                                                },
                                                                {
                                                                    "id": "60280379",
                                                                    "speaker": "法尔伽",
                                                                    "text": "多托雷采取了每位骑士都会唾弃的方式，侥幸获得了一时之利。"
                                                                },
                                                                {
                                                                    "id": "60280380",
                                                                    "speaker": "法尔伽",
                                                                    "text": "连魔女都说他用「变数」影响了命运，哈哈，但我看未必。"
                                                                },
                                                                {
                                                                    "id": "60280381",
                                                                    "speaker": "法尔伽",
                                                                    "text": "我听过很多人告诉我，提瓦特的命运既定，事实好像真的如此。那多托雷凭什么能让自己成为例外呢？"
                                                                },
                                                                {
                                                                    "id": "60280382",
                                                                    "speaker": "法尔伽",
                                                                    "text": "既然多托雷可以堆砌「变数」，我们怎么不行？"
                                                                },
                                                                {
                                                                    "id": "60280383",
                                                                    "speaker": "法尔伽",
                                                                    "text": "而且，你就更不应该沮丧了，远道而来的旅人。"
                                                                },
                                                                {
                                                                    "id": "60280384",
                                                                    "speaker": "法尔伽",
                                                                    "text": "一切都还没结束呢。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "60280385",
                                                                            "text": "嗯。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "60280387",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "你不是一个人。这里的所有人，说话的，不说话的，全都在自责。"
                                                                                },
                                                                                {
                                                                                    "id": "60280388",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "但我们没一个人是会躺在安乐椅上晒太阳的家伙。"
                                                                                },
                                                                                {
                                                                                    "id": "60280389",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "即便被击倒，也会很快站起来，这才是骑士之道！不要忘了，荣誉骑士你可是我们蒙德的正统骑士！"
                                                                                },
                                                                                {
                                                                                    "id": "60280390",
                                                                                    "speaker": "Player",
                                                                                    "text": "嗯…"
                                                                                },
                                                                                {
                                                                                    "id": "60280391",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "法尔伽说得对，还没结束呢！"
                                                                                },
                                                                                {
                                                                                    "id": "60280392",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "至少多托雷这个家伙，我们要痛揍他一顿，新账旧账一起算！"
                                                                                },
                                                                                {
                                                                                    "id": "60280393",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "这才像话。"
                                                                                },
                                                                                {
                                                                                    "id": "60280394",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "其他人呢？"
                                                                                },
                                                                                {
                                                                                    "id": "60280395",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "我会借助月矩力，调查哥伦比娅的下落，我也不愿意就此放弃。"
                                                                                },
                                                                                {
                                                                                    "id": "60280396",
                                                                                    "speaker": "奈芙尔",
                                                                                    "text": "发生在挪德卡莱的事情，「秘闻馆」想知道就一定能知道。情报这边我来提供。"
                                                                                },
                                                                                {
                                                                                    "id": "60280397",
                                                                                    "speaker": "伊涅芙",
                                                                                    "text": "「叮铃哐啷蛋卷工坊」也会提供全力支持，我和爱诺计划逆向研究多托雷的本次行动，寻找突破口。"
                                                                                },
                                                                                {
                                                                                    "id": "60280398",
                                                                                    "speaker": "杜林",
                                                                                    "text": "虽然艾莉丝女士和尼可女士要解决提瓦特边界的突发灾害，暂时回不来…"
                                                                                },
                                                                                {
                                                                                    "id": "60280399",
                                                                                    "speaker": "杜林",
                                                                                    "text": "但她们都很生气，要求我和阿贝多作为「魔女会」的代理人不留余力地抗击多托雷。"
                                                                                },
                                                                                {
                                                                                    "id": "60280401",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "准备好了？前期也有许多研究工作要做。"
                                                                                },
                                                                                {
                                                                                    "id": "60280402",
                                                                                    "speaker": "杜林",
                                                                                    "text": "我会尽力的。"
                                                                                },
                                                                                {
                                                                                    "id": "60280403",
                                                                                    "speaker": "Wanderer",
                                                                                    "text": "我算是了解多托雷的行事风格，能尝试预测他的下一步行动。调查上我来帮忙。"
                                                                                },
                                                                                {
                                                                                    "id": "60280404",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "嗯，听起来算是有个初步分工了。"
                                                                                },
                                                                                {
                                                                                    "id": "60280405",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "我会和菲林斯与叶洛亚取得联系，请他们找执灯长谈，让「执灯人」也站在我们这一边。"
                                                                                },
                                                                                {
                                                                                    "id": "60280406",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "同时我也会交代挪德卡莱的西风骑士，尽全力协助「执灯人」和其他组织，保护此处民众的安全。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "60280407",
                                                                                            "text": "我知道了…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "60280409",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "对，谁怕谁啊！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "60280410",
                                                                                                    "speaker": "法尔伽",
                                                                                                    "text": "嗯，各位加油。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "60280408",
                                                                                            "text": "做好迎接一切的准备。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "60280386",
                                                                            "text": "我有些自责。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "60280334",
                                                            "text": "就是在准备这个计划。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "60280323",
                                            "text": "跳进了「月亮倒影」之中。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "60280305",
                            "text": "还是尽快进入正题吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "602805",
            "objective": "出门看看月亮",
            "dialogues": [
                {
                    "id": "60280501",
                    "speaker": "Player",
                    "text": "（哥伦比娅…）"
                },
                {
                    "id": "60280502",
                    "speaker": "哥伦比娅",
                    "text": "……"
                }
            ]
        },
        {
            "id": "602411",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60241102",
                    "speaker": "哥伦比娅",
                    "text": "以前从没想过，「哥伦比娅」会成为我的真名。"
                },
                {
                    "id": "60241104",
                    "speaker": "哥伦比娅",
                    "text": "它从一个愚人众的代号，变成了「朋友们口中的我」。"
                }
            ]
        },
        {
            "id": "602899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "60289902",
                    "speaker": "哥伦比娅",
                    "text": "（月亮上…会有什么呢…）"
                },
                {
                    "id": "60289903",
                    "speaker": "哥伦比娅",
                    "text": "（真的…能给朋友们留下消息吗…）"
                },
                {
                    "id": "60289905",
                    "speaker": "哥伦比娅",
                    "text": "（下一个祈月之夜…我会在哪…）"
                }
            ]
        }
    ]
}