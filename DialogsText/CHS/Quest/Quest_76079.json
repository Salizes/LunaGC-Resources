    "talks": [
        {
            "id": "7607901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760790101",
                    "speaker": "菲林斯",
                    "text": "魔物已经消失，但这里还留着一道裂隙，而且透过这道裂隙…"
                },
                {
                    "id": "760790102",
                    "speaker": "菲林斯",
                    "text": "是深渊的臭味，非常浓烈，有什么东西躲在裂隙的背后。"
                },
                {
                    "id": "760790103",
                    "speaker": "菲林斯",
                    "text": "出来吧，你还在等什么？"
                },
                {
                    "id": "760790104",
                    "speaker": "菲林斯",
                    "text": "难道你以为等到四下无人之后再从裂隙里爬出来，就不会被执灯人发现了吗？"
                }
            ]
        },
        {
            "id": "7607902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7607903",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760790301",
                    "speaker": "诡异的裂隙",
                    "text": "（即便魔物已经散去，黑暗依然未褪，要解决这里的问题，或许需要对狂猎有了解的专业人士协助。）"
                }
            ]
        },
        {
            "id": "7607904",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760790201",
                    "speaker": "菲林斯",
                    "text": "随狂猎而来的魔物并非完全没有心智，它们也知道利用策略。"
                },
                {
                    "id": "760790202",
                    "speaker": "菲林斯",
                    "text": "每一次作战都不可轻敌，否则后果不堪设想。"
                }
            ]
        },
        {
            "id": "7607904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760790401",
                    "speaker": "叶洛亚",
                    "text": "这里的魔物已经被击退了，但却依旧残存着狂猎的裂隙，难道说…"
                },
                {
                    "id": "760790402",
                    "speaker": "叶洛亚",
                    "text": "别再躲躲藏藏的了，该死的魔物，我知道你就躲在这裂隙之后。"
                },
                {
                    "id": "760790403",
                    "speaker": "叶洛亚",
                    "text": "靠这种把戏可是骗不过我的，出来受死吧！"
                }
            ]
        },
        {
            "id": "7607905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760790501",
                    "speaker": "叶洛亚",
                    "text": "总算是把魔物消灭干净了…老爷子说最近的狂猎变得越来越狡猾了，果然没错。"
                },
                {
                    "id": "760790502",
                    "speaker": "叶洛亚",
                    "text": "看来以后得更加谨慎才行。"
                }
            ]
        }
    ]
}