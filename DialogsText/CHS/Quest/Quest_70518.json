            "格奥尔格": 9,
            "派蒙": 26,
            "芭芭拉": 22
        }
    },
    "talks": [
        {
            "id": "7051801",
            "objective": "在佳酿节的会场逛一逛",
            "dialogues": [
                {
                    "id": "705180101",
                    "speaker": "伯恩哈德",
                    "text": "请留步！大名鼎鼎的荣誉骑士，还有「提瓦特最好的向导」派蒙！"
                },
                {
                    "id": "705180102",
                    "speaker": "伯恩哈德",
                    "text": "恳请你们帮我一把！"
                },
                {
                    "id": "705180103",
                    "speaker": "派蒙",
                    "text": "噫！居然有人会这样叫我？我的名号终于传开了吗？"
                },
                {
                    "id": "705180140",
                    "speaker": "派蒙",
                    "text": "等等…我怎么感觉你有点眼熟？"
                },
                {
                    "id": "705180104",
                    "speaker": "Player",
                    "text": "我们在骑士团总部大厅见过。"
                },
                {
                    "id": "705180105",
                    "speaker": "伯恩哈德",
                    "text": "没错，我是西风骑士伯恩哈德，隶属赫塔队长的后勤小队。"
                },
                {
                    "id": "705180106",
                    "speaker": "伯恩哈德",
                    "text": "按照基本的礼仪，我应该先和你积累起足够的交情…但时间太紧张了，我只能厚着脸皮求你。"
                },
                {
                    "id": "705180107",
                    "speaker": "伯恩哈德",
                    "text": "请你帮帮忙吧，拯救这次义卖活动！"
                },
                {
                    "id": "705180108",
                    "speaker": "Player",
                    "text": "拯救？"
                },
                {
                    "id": "705180109",
                    "speaker": "派蒙",
                    "text": "义卖活动…好像听琴团长提起过。你遇到什么麻烦了吗？"
                },
                {
                    "id": "705180110",
                    "speaker": "伯恩哈德",
                    "text": "是这样的，西风骑士团打算在佳酿节期间经营一间店铺…"
                },
                {
                    "id": "705180111",
                    "speaker": "伯恩哈德",
                    "text": "店铺赚到的钱会被用于慈善事业，提供给生活条件比较艰苦的孩子和老人。"
                },
                {
                    "id": "705180112",
                    "speaker": "伯恩哈德",
                    "text": "而人选是由抽签决定的，恰巧…就抽到了我。为了不让这次义卖失败，我去请教了许多人，但…"
                },
                {
                    "id": "705180113",
                    "speaker": "伯恩哈德",
                    "text": "但我平常大多负责仓储和运输工作，就连要卖什么都想了很久，更别提经营店铺了…"
                },
                {
                    "id": "705180114",
                    "speaker": "伯恩哈德",
                    "text": "所以，我想恳请你们出手帮忙…",
                    "choices": [
                        {
                            "id": "705180115",
                            "text": "可以理解。",
                            "response": [
                                {
                                    "id": "705180117",
                                    "speaker": "派蒙",
                                    "text": "对哦对哦，你说话不用这么客气啦。"
                                },
                                {
                                    "id": "705180118",
                                    "speaker": "派蒙",
                                    "text": "按你的说法，义卖活动是为了蒙德的孩子和老人们好嘛，意义重大！"
                                },
                                {
                                    "id": "705180119",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}是荣誉骑士，我也是骑士团的老朋友了，分担一点责任也不算什么。",
                                    "choices": [
                                        {
                                            "id": "705180120",
                                            "text": "就让我们出一份力吧。",
                                            "response": [
                                                {
                                                    "id": "705180122",
                                                    "speaker": "伯恩哈德",
                                                    "text": "实在感激不尽！那我就长话短说了…"
                                                },
                                                {
                                                    "id": "705180123",
                                                    "speaker": "伯恩哈德",
                                                    "text": "活动开始前，我们需要筹备<color=#00E1FFFF>「佳酿晶冻」</color>。这是经营店铺的基础资金。"
                                                },
                                                {
                                                    "id": "705180124",
                                                    "speaker": "伯恩哈德",
                                                    "text": "附近的酒商急需酿酒原料，向他们出售原料，就能得到大量「佳酿晶冻」。"
                                                },
                                                {
                                                    "id": "705180125",
                                                    "speaker": "伯恩哈德",
                                                    "text": "此外，一些外国的客人想要大量采购佳酿节期间的饮品，他们正在寻找帮忙下单的代理人。"
                                                },
                                                {
                                                    "id": "705180126",
                                                    "speaker": "伯恩哈德",
                                                    "text": "出于长期合作的考虑，这些客人给出的资金通常很宽裕，和酒商们也有商量价格的余地。"
                                                },
                                                {
                                                    "id": "705180127",
                                                    "speaker": "伯恩哈德",
                                                    "text": "这之间的差价，就是给我们的辛苦费了，也能够换成等价的「佳酿晶冻」。"
                                                },
                                                {
                                                    "id": "705180128",
                                                    "speaker": "派蒙",
                                                    "text": "也就是说，我们的任务是给酒商提供酿酒材料，还有帮外地客人下单砍价，对吧？"
                                                },
                                                {
                                                    "id": "705180129",
                                                    "speaker": "派蒙",
                                                    "text": "完全没有我想象得那么难嘛！"
                                                },
                                                {
                                                    "id": "705180130",
                                                    "speaker": "Player",
                                                    "text": "都是我们擅长的事。"
                                                },
                                                {
                                                    "id": "705180131",
                                                    "speaker": "伯恩哈德",
                                                    "text": "真、真的吗？那就太好了！"
                                                },
                                                {
                                                    "id": "705180132",
                                                    "speaker": "伯恩哈德",
                                                    "text": "我这里已经接到了一份委托——须弥的沙瓦玛先生想要订购<color=#00E1FFFF>50箱「假日果酿」</color>。"
                                                },
                                                {
                                                    "id": "705180133",
                                                    "speaker": "伯恩哈德",
                                                    "text": "这种饮品可以在<color=#00E1FFFF>「天使的馈赠」的摊位</color>买到，店主是<color=#00E1FFFF>格奥尔格</color>先生。"
                                                },
                                                {
                                                    "id": "705180134",
                                                    "speaker": "伯恩哈德",
                                                    "text": "格奥尔格先生比较和善，但也不会吃哑巴亏。还请你们谨慎考虑价格，和格奥尔格先生好好勾兑了。"
                                                },
                                                {
                                                    "id": "705180135",
                                                    "speaker": "伯恩哈德",
                                                    "text": "我先继续搭建店铺。等到你们筹备到了足够的「佳酿晶冻」，就回到这里来吧。"
                                                },
                                                {
                                                    "id": "705180136",
                                                    "speaker": "伯恩哈德",
                                                    "text": "至于店铺的相关物料，就不用你们多费心了。"
                                                },
                                                {
                                                    "id": "705180137",
                                                    "speaker": "伯恩哈德",
                                                    "text": "我已经联系了供货商，只等资金到位，他们就会把东西送过来。"
                                                },
                                                {
                                                    "id": "705180138",
                                                    "speaker": "派蒙",
                                                    "text": "好哦，分工合作！店铺布置交给你，资金筹备就交给我们。"
                                                },
                                                {
                                                    "id": "705180139",
                                                    "speaker": "伯恩哈德",
                                                    "text": "帮大忙了，有劳二位！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705180121",
                                            "text": "需要我们怎么做？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705180116",
                            "text": "每个人都有不擅长的事。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051804",
            "objective": "与伯恩哈德对话",
            "dialogues": []
        },
        {
            "id": "7051802",
            "objective": "前往「天使的馈赠」摊位",
            "dialogues": [
                {
                    "id": "705180201",
                    "speaker": "派蒙",
                    "text": "格奥尔格先生，你好啊。我们是沙瓦玛先生的代理人，想代他订购50箱「假日果酿」！"
                },
                {
                    "id": "705180202",
                    "speaker": "格奥尔格",
                    "text": "哦？沙瓦玛先生吗？他是我的熟客了，订货的数量很少有变化…"
                },
                {
                    "id": "705180203",
                    "speaker": "格奥尔格",
                    "text": "言归正传，今年你们打算出多少价钱？"
                }
            ]
        },
        {
            "id": "7051805",
            "objective": "与格奥尔格交涉",
            "dialogues": [
                {
                    "id": "705182601",
                    "speaker": "格奥尔格",
                    "text": "按照惯例，我会安排专人送货，直接把这些饮品送到沙瓦玛先生的店里去。"
                },
                {
                    "id": "705182602",
                    "speaker": "格奥尔格",
                    "text": "请你们放心吧，记得保管好这份单据。"
                },
                {
                    "id": "705182603",
                    "speaker": "派蒙",
                    "text": "好啦，接下来我们就继续筹备资金吧，目标是尽快收集足够的「佳酿晶冻」！"
                },
                {
                    "id": "705182604",
                    "speaker": "派蒙",
                    "text": "按伯恩哈德的说法，方法可以自己选，只要筹备到足够的资金就行了…"
                },
                {
                    "id": "705182605",
                    "speaker": "派蒙",
                    "text": "外地的客人下单后，我们能拿到一笔辛苦费，就不用向酒商们出售那么多酿酒原料了吧…"
                },
                {
                    "id": "705182606",
                    "speaker": "派蒙",
                    "text": "不过，为了万无一失，还是先去其他酒商那边看看吧。"
                }
            ]
        },
        {
            "id": "7051803",
            "objective": "提前去其他店铺踩点",
            "dialogues": [
                {
                    "id": "705180301",
                    "speaker": "芭芭拉",
                    "text": "#{NICKNAME}和派蒙，你们在这里啊！"
                },
                {
                    "id": "705180302",
                    "speaker": "派蒙",
                    "text": "喔！是芭芭拉！",
                    "choices": [
                        {
                            "id": "705180303",
                            "text": "你好呀，芭芭拉。",
                            "response": [
                                {
                                    "id": "705180305",
                                    "speaker": "芭芭拉",
                                    "text": "嗯，佳酿节快乐！"
                                },
                                {
                                    "id": "705180306",
                                    "speaker": "芭芭拉",
                                    "text": "佳酿节是蒙德最热闹的节日之一，我很开心能在这个时候见到你们，希望你们也喜欢佳酿节！"
                                },
                                {
                                    "id": "705180307",
                                    "speaker": "芭芭拉",
                                    "text": "说起来，刚才我听格奥尔格先生说，你们在收集「佳酿晶冻」？"
                                },
                                {
                                    "id": "705180308",
                                    "speaker": "芭芭拉",
                                    "text": "我有点好奇，你们是在帮骑士团义卖吗？"
                                },
                                {
                                    "id": "705180309",
                                    "speaker": "派蒙",
                                    "text": "对啊，我们也是骑士团的一份子嘛！"
                                },
                                {
                                    "id": "705180310",
                                    "speaker": "派蒙",
                                    "text": "现在店铺还没开张，我们要多跑几趟，筹集开店资金！"
                                },
                                {
                                    "id": "705180311",
                                    "speaker": "派蒙",
                                    "text": "虽然还不知道开店后会遇上什么问题，但我们肯定能搞定所有麻烦！"
                                },
                                {
                                    "id": "705180312",
                                    "speaker": "芭芭拉",
                                    "text": "太可靠了！嘿嘿…有你们帮忙，一定会取得前所未有的成功！"
                                },
                                {
                                    "id": "705180313",
                                    "speaker": "Player",
                                    "text": "借你吉言。"
                                },
                                {
                                    "id": "705180314",
                                    "speaker": "芭芭拉",
                                    "text": "之前，骑士团举办小型义卖活动的时候，我也去帮过忙。"
                                },
                                {
                                    "id": "705180315",
                                    "speaker": "芭芭拉",
                                    "text": "虽然，我帮忙的方式是站在商铺前唱歌啦…"
                                },
                                {
                                    "id": "705180316",
                                    "speaker": "芭芭拉",
                                    "text": "对了！那次我还遇到了那位吟游诗人温迪哦！他还邀请我即兴合作了一曲。"
                                },
                                {
                                    "id": "705180317",
                                    "speaker": "芭芭拉",
                                    "text": "他演奏的音阶古朴又典雅，一开始，我只敢小声跟唱，生怕哪里不对破坏了气氛…"
                                },
                                {
                                    "id": "705180318",
                                    "speaker": "芭芭拉",
                                    "text": "好在他用和声引导着我，我们很快找到了感觉。"
                                },
                                {
                                    "id": "705180319",
                                    "speaker": "芭芭拉",
                                    "text": "最后，听众们都很享受，商品也卖得特别好。"
                                },
                                {
                                    "id": "705180320",
                                    "speaker": "派蒙",
                                    "text": "原来芭芭拉和卖唱的还合作过啊…"
                                },
                                {
                                    "id": "705180321",
                                    "speaker": "Player",
                                    "text": "我也有点想听了。"
                                },
                                {
                                    "id": "705180322",
                                    "speaker": "芭芭拉",
                                    "text": "嗯，只可惜这次时间冲突了。"
                                },
                                {
                                    "id": "705180323",
                                    "speaker": "芭芭拉",
                                    "text": "佳酿节期间，西风教会要在风景优美的地方安排特别的唱诗，我还得参加排练…",
                                    "choices": [
                                        {
                                            "id": "705180324",
                                            "text": "你去忙吧，没关系。",
                                            "response": [
                                                {
                                                    "id": "705180326",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，都是很有意义的工作，我们各自加油吧。"
                                                },
                                                {
                                                    "id": "705180327",
                                                    "speaker": "芭芭拉",
                                                    "text": "谢谢你们！虽然不能留在这里唱歌，但我也想做点什么！"
                                                },
                                                {
                                                    "id": "705180328",
                                                    "speaker": "芭芭拉",
                                                    "text": "我…我来向大家宣传你们的店铺吧。"
                                                },
                                                {
                                                    "id": "705180329",
                                                    "speaker": "芭芭拉",
                                                    "text": "唔…该做成大幅海报吗，还是拿在手里的传单…"
                                                },
                                                {
                                                    "id": "705180330",
                                                    "speaker": "芭芭拉",
                                                    "text": "宣传语得设计一下！附上签名会不会更有诚意…"
                                                },
                                                {
                                                    "id": "705180331",
                                                    "speaker": "芭芭拉",
                                                    "text": "唔，还是说挨个通知比较好…"
                                                },
                                                {
                                                    "id": "705180332",
                                                    "speaker": "派蒙",
                                                    "text": "哇，有芭芭拉帮忙做广告，店铺知名度会大幅提升吧！",
                                                    "choices": [
                                                        {
                                                            "id": "705180333",
                                                            "text": "太费心了。",
                                                            "response": [
                                                                {
                                                                    "id": "705180335",
                                                                    "speaker": "芭芭拉",
                                                                    "text": "这是我力所能及的小事，你们这么说，我会不好意思的…"
                                                                },
                                                                {
                                                                    "id": "705180336",
                                                                    "speaker": "芭芭拉",
                                                                    "text": "#那我再琢磨一下，也向其他人请教一下宣传的经验！{NICKNAME}，派蒙，我们回见了~"
                                                                },
                                                                {
                                                                    "id": "705180337",
                                                                    "speaker": "芭芭拉",
                                                                    "text": "那个…骑士团和教会的大家都会为你们骄傲的！"
                                                                },
                                                                {
                                                                    "id": "705180338",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯！一起加油哦。"
                                                                },
                                                                {
                                                                    "id": "705180339",
                                                                    "speaker": "派蒙",
                                                                    "text": "#这下我更有干劲了！{NICKNAME}，我们可得好好表现了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705180334",
                                                            "text": "量力而行就好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705180325",
                                            "text": "义卖交给我们就行了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705180304",
                            "text": "佳酿节快乐。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7051821",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705182101",
                    "speaker": "格奥尔格",
                    "text": "不不不，沙瓦玛先生有和你们通过气吗？这也太低了，请别和我开玩笑。"
                }
            ]
        },
        {
            "id": "7051822",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705182201",
                    "speaker": "格奥尔格",
                    "text": "虽说今年遇上了大丰收，酿酒成本比往年低了不少，但这个价格还是有点难接受啊。"
                }
            ]
        },
        {
            "id": "7051823",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705182301",
                    "speaker": "格奥尔格",
                    "text": "不错，和往年价格很接近，就这样成交吧！"
                }
            ]
        },
        {
            "id": "7051824",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705182401",
                    "speaker": "格奥尔格",
                    "text": "这个价钱…虽然有点可惜，但看在是老熟人的份上，还是成交吧。"
                }
            ]
        },
        {
            "id": "7051825",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705182501",
                    "speaker": "格奥尔格",
                    "text": "不好意思，我实在接受不了这么低的数字。如果你们还想订货，就接受我说的价钱吧。"
                }
            ]
        },
        {
            "id": "7051899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705189901",
                    "speaker": "派蒙",
