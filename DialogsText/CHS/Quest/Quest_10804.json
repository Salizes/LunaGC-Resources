    "talks": [
        {
            "id": "1080401",
            "objective": "",
            "dialogues": [
                {
                    "id": "698090101",
                    "speaker": "安柏",
                    "text": "呼啊…又护送了一位迷路的冒险家，这个地方真的有这么难走吗…",
                    "choices": [
                        {
                            "id": "698090102",
                            "text": "超难走的。",
                            "response": [
                                {
                                    "id": "698090104",
                                    "speaker": "安柏",
                                    "text": "欸？没关系，我是蒙德城西风骑士团…"
                                },
                                {
                                    "id": "698090105",
                                    "speaker": "Player",
                                    "text": "最好的侦察骑士。"
                                },
                                {
                                    "id": "698090106",
                                    "speaker": "安柏",
                                    "text": "#{NICKNAME}！居然能在这里遇见你，你来蒙德玩的么？"
                                },
                                {
                                    "id": "698090107",
                                    "speaker": "安柏",
                                    "text": "你来得正好，莎拉小姐刚巧发明了新菜品，正找人去试吃呢。"
                                },
                                {
                                    "id": "698090108",
                                    "speaker": "安柏",
                                    "text": "凯亚和琴应该也都在骑士团里，还有小可莉也在…"
                                },
                                {
                                    "id": "698090109",
                                    "speaker": "安柏",
                                    "text": "哎呀，不好不好，我是不是说太多，耽误你行程了？",
                                    "choices": [
                                        {
                                            "id": "698090110",
                                            "text": "不多不多。",
                                            "response": [
                                                {
                                                    "id": "698090112",
                                                    "speaker": "安柏",
                                                    "text": "没耽误你的事情就好。拿着这个，你有段时间没尝过我的手艺了吧？这是我刚做的，可要趁热吃啊。"
                                                },
                                                {
                                                    "id": "698090113",
                                                    "speaker": "安柏",
                                                    "text": "虽然还想和你多聊聊天，但是，最近有好多冒险家在这片树林里迷了路。"
                                                },
                                                {
                                                    "id": "698090114",
                                                    "speaker": "安柏",
                                                    "text": "为了护送他们进城，我这几天的巡逻次数都增加了好多，都快要有点忙不过来了…"
                                                },
                                                {
                                                    "id": "698090115",
                                                    "speaker": "Player",
                                                    "text": "有安柏护送，肯定没问题。"
                                                },
                                                {
                                                    "id": "698090116",
                                                    "speaker": "安柏",
                                                    "text": "那当然啦。哎呀，我还要去巡逻，就先走啦，有什么事的话，直接来骑士团找我就行。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698090111",
                                            "text": "很好很好。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698090103",
                            "text": "我迷路了。"
                        }
                    ]
                }
            ]
        }
    ]
}