    "talks": [
        {
            "id": "2503401",
            "objective": "与特拉忒对话",
            "dialogues": [
                {
                    "id": "250340101",
                    "speaker": "特拉忒",
                    "text": "它不喜欢你们，走开！"
                },
                {
                    "id": "250340102",
                    "speaker": "不耐烦的贼匪",
                    "text": "臭小子…你认识这只龙吗？它和你什么关系？"
                },
                {
                    "id": "250340103",
                    "speaker": "奇卡",
                    "text": "呜…呜呜！"
                },
                {
                    "id": "250340104",
                    "speaker": "不耐烦的贼匪",
                    "text": "瞧瞧，这只龙都不耐烦了。小子，滚一边去，我们不打小孩。"
                },
                {
                    "id": "250340105",
                    "speaker": "不耐烦的贼匪",
                    "text": "哥几个，把袋子拿过来。哼哼，这只小龙肯定能卖个好价钱。"
                },
                {
                    "id": "250340106",
                    "speaker": "特拉忒",
                    "text": "不许过来！再过来我可要动手了！"
                },
                {
                    "id": "250340107",
                    "speaker": "不耐烦的贼匪",
                    "text": "动，动手？你？哈哈哈哈哈哈，哥几个，他要和我们动手！"
                },
                {
                    "id": "250340108",
                    "speaker": "不耐烦的贼匪",
                    "text": "我好怕啊，小子。但既然你都放出话了，那可别怪我了。"
                },
                {
                    "id": "250340109",
                    "speaker": "奇卡",
                    "text": "呜！呜呜！呜！"
                },
                {
                    "id": "250340110",
                    "speaker": "不耐烦的贼匪",
                    "text": "啧，这小龙还挺凶的…小子，你就好好睡一觉…",
                    "choices": [
                        {
                            "id": "250340111",
                            "text": "要睡一觉的是你们。",
                            "response": [
                                {
                                    "id": "250340113",
                                    "speaker": "特拉忒",
                                    "text": "#{M#大哥哥}{F#大姐姐}！他们是坏蛋！想要抢走奇卡！"
                                },
                                {
                                    "id": "250340114",
                                    "speaker": "奇卡",
                                    "text": "呜呜！呜呜！"
                                },
                                {
                                    "id": "250340115",
                                    "speaker": "不耐烦的贼匪",
                                    "text": "…过路的好汉。只要你不管这件事，哥们承你的情，事成后分你一份钱。",
                                    "choices": [
                                        {
                                            "id": "250340116",
                                            "text": "不许伤害奇卡。",
                                            "response": [
                                                {
                                                    "id": "250340118",
                                                    "speaker": "不耐烦的贼匪",
                                                    "text": "那就是没得谈了。行啊，那还是道上规矩。咱们手上见真章。"
                                                },
                                                {
                                                    "id": "250340119",
                                                    "speaker": "不耐烦的贼匪",
                                                    "text": "嘿嘿…兄弟们给我上！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250340117",
                                            "text": "谁要你的情？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250340112",
                            "text": "那你们也别怪我了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503403",
            "objective": "打倒所有敌人",
            "dialogues": []
        },
        {
            "id": "2503404",
            "objective": "与特拉忒对话",
            "dialogues": [
                {
                    "id": "250340501",
                    "speaker": "特拉忒",
                    "text": "#{M#大哥哥}{F#大姐姐}，谢谢你救了我们。"
                },
                {
                    "id": "250340502",
                    "speaker": "奇卡",
                    "text": "呜，呜呜…"
                },
                {
                    "id": "250340503",
                    "speaker": "特拉忒",
                    "text": "这里离部族太远，我都没办法通知伊莱帕姐姐。要是你没来，奇卡肯定会被抓走的。"
                },
                {
                    "id": "250340504",
                    "speaker": "Player",
                    "text": "你来这里做什么？"
                },
                {
                    "id": "250340505",
                    "speaker": "特拉忒",
                    "text": "我们还是来这里训练爬山。但训练到一半的时候，我们肚子都饿了。"
                },
                {
                    "id": "250340506",
                    "speaker": "特拉忒",
                    "text": "所以，我就和奇卡去摘果子。没想到一边摘果子，一边走了太远…"
                },
                {
                    "id": "250340507",
                    "speaker": "特拉忒",
                    "text": "等到我们吃饱的时候，已经走了好远。回去肯定又要被妈妈念叨了…"
                },
                {
                    "id": "250340508",
                    "speaker": "特拉忒",
                    "text": "#再次谢谢你救了我，{M#大哥哥}{F#大姐姐}，这些「苦种」给你，都是我刚摘下来的！"
                },
                {
                    "id": "250340509",
                    "speaker": "特拉忒",
                    "text": "我们快点回去吧，奇卡，走吧！"
                },
                {
                    "id": "250340510",
                    "speaker": "奇卡",
                    "text": "呜！呜呜！呜呜！"
                }
            ]
        }
    ]
}