        }
    },
    "talks": [
        {
            "id": "7335401",
            "objective": "与为难的两人对话",
            "dialogues": [
                {
                    "id": "733540101",
                    "speaker": "毗伽尔",
                    "text": "灯光的色调和强度恰到好处，特效也相当华丽，综合表现的效果堪称完美。"
                },
                {
                    "id": "733540102",
                    "speaker": "毗伽尔",
                    "text": "太棒了，萨费伊，多亏了你，我们才能将花之骑士传说中的英姿重现。"
                },
                {
                    "id": "733540103",
                    "speaker": "萨费伊",
                    "text": "哎呀呀，又不是我一个人的功劳，你跑前跑后，比我这个只管书面工作的文职累多了。"
                },
                {
                    "id": "733540104",
                    "speaker": "萨费伊",
                    "text": "现在最重要的问题是花之骑士的人选…需要演员拥有非凡身手，气质又与传说中的法里斯相似，条件似乎有些苛刻？",
                    "choices": [
                        {
                            "id": "733540105",
                            "text": "你们在聊什么呢？",
                            "response": [
                                {
                                    "id": "733540107",
                                    "speaker": "派蒙",
                                    "text": "灯光？特效？你们在为演出的事发愁吗？"
                                },
                                {
                                    "id": "733540108",
                                    "speaker": "萨费伊",
                                    "text": "出现了！绝无仅有的大英雄，花之骑士扮演者的无上人选…"
                                },
                                {
                                    "id": "733540109",
                                    "speaker": "萨费伊",
                                    "text": "不，应该说您就是当之无愧的花之骑士本尊！"
                                },
                                {
                                    "id": "733540110",
                                    "speaker": "派蒙",
                                    "text": "#噫，这个学者好激动！一看到{NICKNAME}，都眼里放光了…",
                                    "choices": [
                                        {
                                            "id": "733540111",
                                            "text": "欸呀，没那么夸张啦。",
                                            "response": [
                                                {
                                                    "id": "733540113",
                                                    "speaker": "毗伽尔",
                                                    "text": "#咳咳，很荣幸再次遇见您，{NICKNAME}{M#先生}{F#女士}，这位是伐护末那学院的民俗学者萨费伊。"
                                                },
                                                {
                                                    "id": "733540114",
                                                    "speaker": "毗伽尔",
                                                    "text": "最近他趁着「花神诞祭」的热潮，根据各种历史文献和民间传说，结合枫丹的新技术，设计了一部映影。"
                                                },
                                                {
                                                    "id": "733540115",
                                                    "speaker": "萨费伊",
                                                    "text": "这部映影的重点是「花之骑士不为人知的战斗」，着重描绘了那位骑士为草神大人深入神秘幽邃的险境，斩除邪恶势力的故事…"
                                                },
                                                {
                                                    "id": "733540116",
                                                    "speaker": "派蒙",
                                                    "text": "等等，我好像能猜到了…你们是不是没有擅长战斗的演员，拍不了战斗的桥段？"
                                                },
                                                {
                                                    "id": "733540117",
                                                    "speaker": "萨费伊",
                                                    "text": "#严格说来，无论文戏还是打戏，都没有比{NICKNAME}{M#先生}{F#女士}更合适的演员。"
                                                },
                                                {
                                                    "id": "733540118",
                                                    "speaker": "萨费伊",
                                                    "text": "#要是{NICKNAME}愿意参演，这部映影有可能成为须弥历史上最出色的花之骑士艺术作品，上映后的收入相当乐观…"
                                                },
                                                {
                                                    "id": "733540119",
                                                    "speaker": "毗伽尔",
                                                    "text": "当然，绝不会在分成上亏待两位。"
                                                },
                                                {
                                                    "id": "733540120",
                                                    "speaker": "派蒙",
                                                    "text": "#嘿嘿，{NICKNAME}的形象，确实就该这么有人气！"
                                                },
                                                {
                                                    "id": "733540121",
                                                    "speaker": "派蒙",
                                                    "text": "我们算是在「花神诞祭」度假，这段时间倒不怎么忙啦，拍几段戏的空闲应该是有的。"
                                                },
                                                {
                                                    "id": "733540122",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，你觉得呢？",
                                                    "choices": [
                                                        {
                                                            "id": "733540123",
                                                            "text": "演戏我不在行，战斗我很专业。",
                                                            "response": [
                                                                {
                                                                    "id": "733540124",
                                                                    "speaker": "萨费伊",
                                                                    "text": "您愿意参演真是太好了，我们就只拍战斗戏！"
                                                                },
                                                                {
                                                                    "id": "733540125",
                                                                    "speaker": "萨费伊",
                                                                    "text": "同时，我们会以您的仪容为准，重新设计剧中花之骑士的形象，调整文戏演员的化妆和服装。"
                                                                },
                                                                {
                                                                    "id": "733540129",
                                                                    "speaker": "毗伽尔",
                                                                    "text": "#事不宜迟，要是{NICKNAME}{M#先生}{F#女士}准备好了，我们就直接开始吧？"
                                                                },
                                                                {
                                                                    "id": "733540130",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好，为了{NICKNAME}的大明星形象，还有花之骑士的热血传说，开演！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733540126",
                                                            "text": "打戏简简单单，文戏可以试试。",
                                                            "response": [
                                                                {
                                                                    "id": "733540127",
                                                                    "speaker": "萨费伊",
                                                                    "text": "您愿意参演真是太好了，我们感激不尽！"
                                                                },
                                                                {
                                                                    "id": "733540128",
                                                                    "speaker": "萨费伊",
                                                                    "text": "不过，文戏的拍摄和打戏是分开的，前者要另定时间，到时候可能还要麻烦您了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733540112",
                                            "text": "说得好，再夸夸？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733540106",
                            "text": "好像遇上了难题？"
                        }
                    ]
                }
            ]
        }
    ]
}