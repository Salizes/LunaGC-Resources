        }
    },
    "talks": [
        {
            "id": "4113101",
            "objective": "与伊凡诺维奇对话",
            "dialogues": [
                {
                    "id": "411311101",
                    "speaker": "伊凡诺维奇",
                    "text": "好吧，好吧！我知道了，别说了，你说这么多，不就是想劝我别去碰那个陨石吗？"
                },
                {
                    "id": "411311102",
                    "speaker": "伊凡诺维奇",
                    "text": "看你的样子，你也不会接我的委托了。如果你真不愿意，那就算了。"
                },
                {
                    "id": "411311103",
                    "speaker": "伊凡诺维奇",
                    "text": "这个时候，我也不可能马上雇到其他的人当我的护卫…"
                },
                {
                    "id": "411311104",
                    "speaker": "伊凡诺维奇",
                    "text": "但我是不会放弃的，就算拿不到陨石，我也不能完全放过这次商机！"
                },
                {
                    "id": "411311105",
                    "speaker": "伊凡诺维奇",
                    "text": "旅行者，我不去拿陨石了，但是我得请你帮我另外一个忙。"
                },
                {
                    "id": "411311106",
                    "speaker": "伊凡诺维奇",
                    "text": "如果那个陨石真有那么奇妙…呃，危险，能让摸到的人昏睡过去。"
                },
                {
                    "id": "411311107",
                    "speaker": "伊凡诺维奇",
                    "text": "那么，陨石落在地上之后，周围的环境说不定也会受到影响。"
                },
                {
                    "id": "411311108",
                    "speaker": "伊凡诺维奇",
                    "text": "旅行者，请你帮我去陨石旁边看看，搜集一点东西回来吧，花花草草…什么都可以。",
                    "choices": [
                        {
                            "id": "411311109",
                            "text": "我知道了…",
                            "response": [
                                {
                                    "id": "411311110",
                                    "speaker": "伊凡诺维奇",
                                    "text": "那就拜托你了，这么大的商机，我可不能完全放过。"
                                }
                            ]
                        },
                        {
                            "id": "411311111",
                            "text": "这就是商人吗…",
                            "response": [
                                {
                                    "id": "411311112",
                                    "speaker": "伊凡诺维奇",
                                    "text": "哈哈哈，谢谢夸奖，那么就拜托你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4113102",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310201",
                    "speaker": "Player",
                    "text": "那里有很多魔物。"
                },
                {
                    "id": "411310202",
                    "speaker": "伊凡诺维奇",
                    "text": "这正是我想要雇佣你的原因，旅行者。"
                }
            ]
        },
        {
            "id": "4113103",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310301",
                    "speaker": "Player",
                    "text": "别人也会想到做这个生意…"
                },
                {
                    "id": "411310302",
                    "speaker": "伊凡诺维奇",
                    "text": "哦，当然，所以我们才要尽快到那边去。"
                },
                {
                    "id": "411310303",
                    "speaker": "伊凡诺维奇",
                    "text": "旅行者，如果你愿意，我们尽快出发。"
                },
                {
                    "id": "411310304",
                    "speaker": "伊凡诺维奇",
                    "text": "我们在这里多磨嘴皮子一秒，我说不定就会少赚一摩拉。"
                },
                {
                    "id": "411310305",
                    "speaker": "派蒙",
                    "text": "…呜哇…这样应该没法说服他。"
                },
                {
                    "id": "411310306",
                    "speaker": "派蒙",
                    "text": "如果能让他知道，这笔生意赚不了钱，或者…陨石真的很危险就好了…"
                }
            ]
        },
        {
            "id": "4113104",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310401",
                    "speaker": "Player",
                    "text": "摸到陨石就会昏睡过去…"
                },
                {
                    "id": "411310402",
                    "speaker": "伊凡诺维奇",
                    "text": "嗯？啊…我倒是对这传闻有所耳闻，这可是个问题…"
                },
                {
                    "id": "411310403",
                    "speaker": "伊凡诺维奇",
                    "text": "但是，我相信一定有器械能解决这个问题，呃…应该有吧。"
                },
                {
                    "id": "411310404",
                    "speaker": "派蒙",
                    "text": "…哎，他好像有点动摇了，难道…是在权衡做这笔生意的成本吗？"
                },
                {
                    "id": "411310405",
                    "speaker": "派蒙",
                    "text": "就这样说服他，告诉他这笔生意绝对赚不了钱，还有…那个陨石真的很危险。"
                }
            ]
        },
        {
            "id": "4113105",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310501",
                    "speaker": "Player",
                    "text": "没什么能配得上的配饰…"
                },
                {
                    "id": "411310502",
                    "speaker": "伊凡诺维奇",
                    "text": "不用担心这点问题，我自然会找到配得上的配饰。"
                },
                {
                    "id": "411310503",
                    "speaker": "伊凡诺维奇",
                    "text": "无论是宝石、金银，还是其他什么，想找的话一定能找得到。"
                }
            ]
        },
        {
            "id": "4113106",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310601",
                    "speaker": "Player",
                    "text": "你的生意还不错，不用冒险…"
                },
                {
                    "id": "411310602",
                    "speaker": "伊凡诺维奇",
                    "text": "冒险？朋友，你知道我们至冬国人经商的准则吗？"
                },
                {
                    "id": "411310603",
                    "speaker": "伊凡诺维奇",
                    "text": "追求极致，我的朋友，追求极致！不能沉溺在已有的成果里止步不前。"
                },
                {
                    "id": "411310604",
                    "speaker": "伊凡诺维奇",
                    "text": "用更妙的方法，赚更多的钱，这才是一位合格的商人。"
                }
            ]
        },
        {
            "id": "4113107",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310701",
                    "speaker": "Player",
                    "text": "不如去找冒险家协会…"
                },
                {
                    "id": "411310702",
                    "speaker": "伊凡诺维奇",
                    "text": "哈！冒险家协会，他们拒绝了我的委托，也说什么…陨石绝对不能去碰。"
                },
                {
                    "id": "411310703",
                    "speaker": "伊凡诺维奇",
                    "text": "什么冒险家协会，没有一点冒险家的精神。"
                },
                {
                    "id": "411310704",
                    "speaker": "Player",
                    "text": "因为冒险家协会也觉得陨石很危险。"
                },
                {
                    "id": "411310705",
                    "speaker": "伊凡诺维奇",
                    "text": "呃…你这么说，倒也有几分道理，但是也不会太过危险吧…"
                }
            ]
        },
        {
            "id": "4113108",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310801",
                    "speaker": "Player",
                    "text": "陨石很沉…"
                },
                {
                    "id": "411310802",
                    "speaker": "伊凡诺维奇",
                    "text": "这么点小问题，我已经雇好了车。那些陨石总不可能让热气球也停摆。"
                }
            ]
        },
        {
            "id": "4113109",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310901",
                    "speaker": "Player",
                    "text": "千岩军肯定不会让你去的。"
                },
                {
                    "id": "411310902",
                    "speaker": "伊凡诺维奇",
                    "text": "老天…我亲爱的朋友，我们又不是在做什么违法的事。"
                },
                {
                    "id": "411310903",
                    "speaker": "伊凡诺维奇",
                    "text": "这些从天而降的陨石是一场灾难，你明白吗？一场灾难，但我们的生意会让这场灾难成为机遇！"
                }
            ]
        },
        {
            "id": "4113110",
            "objective": "",
            "dialogues": [
                {
                    "id": "411311001",
                    "speaker": "Player",
                    "text": "买了首饰的客人们也会…"
                },
                {
                    "id": "411311002",
                    "speaker": "伊凡诺维奇",
                    "text": "呃，对啊…就算我用器械避免了触碰，那些首饰也都要贴身佩戴…"
                },
                {
                    "id": "411311003",
                    "speaker": "伊凡诺维奇",
                    "text": "如果客人陷入昏睡，那…会不会对我的声誉有影响…"
                },
                {
                    "id": "411311004",
                    "speaker": "伊凡诺维奇",
                    "text": "但是，假如能做成个摆设，远远摆着应该也行，但那样的话，价钱会不会低不少？"
                },
                {
                    "id": "411311005",
                    "speaker": "伊凡诺维奇",
                    "text": "哎呀，这可有点麻烦了…"
                }
            ]
        },
        {
            "id": "4113121",
            "objective": "与伊凡诺维奇对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113112",
            "objective": "去陨石附近采集植物",
            "dialogues": [
                {
                    "id": "411311201",
                    "speaker": "伊凡诺维奇",
                    "text": "摸了就会陷入昏睡的陨石…有什么方法能让它变成普通的陨石吗…"
                },
                {
                    "id": "411311202",
                    "speaker": "伊凡诺维奇",
                    "text": "呃，不，变成普通陨石之后，不就没得赚了吗…"
                }
            ]
        },
        {
            "id": "4113113",
            "objective": "将甜甜花交给伊凡诺维奇",
            "dialogues": [
                {
                    "id": "411311301",
                    "speaker": "伊凡诺维奇",
                    "text": "你找到东西了吗？",
                    "choices": [
                        {
                            "id": "411311302",
                            "text": "找到了。",
                            "response": [
                                {
                                    "id": "411311303",
                                    "speaker": "伊凡诺维奇",
                                    "text": "太棒了，让我看看。"
                                },
                                {
                                    "id": "411311304",
                                    "speaker": "伊凡诺维奇",
                                    "text": "啊…新鲜的甜甜花，不错，它们准是已经受到了陨石的影响，变得颇为不凡了…"
                                }
                            ]
                        },
                        {
                            "id": "411311305",
                            "text": "这朵花也许有问题…",
                            "response": [
                                {
                                    "id": "411311306",
                                    "speaker": "伊凡诺维奇",
                                    "text": "有问题，这朵花会有什么问题？"
                                },
                                {
                                    "id": "411311307",
                                    "speaker": "伊凡诺维奇",
                                    "text": "你们在采花的时候，突然被花攻击了…有会攻击人的花？"
                                },
                                {
                                    "id": "411311308",
                                    "speaker": "伊凡诺维奇",
                                    "text": "啊哈，这一定是陨石的影响！只有陨石，才会让这些花变得这么特别。"
                                },
                                {
                                    "id": "411311309",
                                    "speaker": "Player",
                                    "text": "应该完全没关系…"
                                },
                                {
                                    "id": "411311310",
                                    "speaker": "派蒙",
                                    "text": "对啊，陨石和花…这完全挨不上边吧…"
                                },
                                {
                                    "id": "411311311",
                                    "speaker": "伊凡诺维奇",
                                    "text": "不，不不，请你相信我，这株甜甜花，肯定有什么特别之处。"
                                },
                                {
                                    "id": "411311312",
                                    "speaker": "Player",
                                    "text": "可这朵花真没什么特别…"
                                },
                                {
                                    "id": "411311313",
                                    "speaker": "伊凡诺维奇",
                                    "text": "不，不不，朋友，它可是在陨石旁边呆过，它当然有特别的地方。"
                                },
                                {
                                    "id": "411311314",
                                    "speaker": "派蒙",
                                    "text": "但是，无论是看起来、摸起来和闻起来，这朵甜甜花都和普通的甜甜花都没什么两样呀。"
                                },
                                {
                                    "id": "411311315",
                                    "speaker": "伊凡诺维奇",
                                    "text": "这个嘛…就不劳您们操心了。"
                                },
                                {
                                    "id": "411311316",
                                    "speaker": "伊凡诺维奇",
                                    "text": "这是给您的报酬，请拿好了，合作愉快。"
                                },
                                {
                                    "id": "411311317",
                                    "speaker": "伊凡诺维奇",
                                    "text": "这株甜甜花…嗯…香水？书签？干花？好像都不错…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4113114",
            "objective": "",
            "dialogues": [
                {
                    "id": "411311401",
                    "speaker": "伊凡诺维奇",
                    "text": "好吧，你们说得很有道理，那颗陨石确实太过危险了。我不会去自找麻烦。"
                },
                {
                    "id": "411311402",
                    "speaker": "伊凡诺维奇",
                    "text": "但是…唉，白白放过这么大的商机，真是遗憾…"
                }
            ]
        },
        {
            "id": "4113116",
            "objective": "去陨石附近采集植物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113117",
            "objective": "采集植物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113118",
            "objective": "采集植物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4113122",
            "objective": "",
            "dialogues": [
                {
                    "id": "411310101",
                    "speaker": "伊凡诺维奇",
                    "text": "嗯…不错，这生意准能大赚一笔。但是还有个小问题…"
                },
                {
                    "id": "411310102",
                    "speaker": "Player",
                    "text": "什么问题？"
                },
                {
                    "id": "411310103",
                    "speaker": "伊凡诺维奇",
                    "text": "嗯？哦…旅行者，是你啊，你来得正好！你有兴趣参与一场…一场…"
                },
                {
                    "id": "411310107",
                    "speaker": "伊凡诺维奇",
                    "text": "一场…神奇的…伟大的…前所未有，必定能大赚特赚的生意吗？"
                },
                {
                    "id": "411310108",
                    "speaker": "伊凡诺维奇",
                    "text": "只需要你帮我一个小小的忙。我们俩必然都能赚得盆满钵满。",
                    "choices": [
                        {
                            "id": "411310104",
                            "text": "北国银行守卫森严。",
                            "response": [
                                {
                                    "id": "411310105",
                                    "speaker": "伊凡诺维奇",
                                    "text": "啊，那是当然，连守卫都是至冬国人，我…不！不，您在想什么？"
                                },
                                {
                                    "id": "411310106",
                                    "speaker": "伊凡诺维奇",
                                    "text": "看来四处旅行确实让您的思维开阔了不少，您的想法实在是颇富想象力。"
                                },
                                {
                                    "id": "411310112",
                                    "speaker": "伊凡诺维奇",
                                    "text": "但我这次的生意计划，绝对是脚踏实地的扎实计划。"
                                },
                                {
                                    "id": "411310113",
                                    "speaker": "伊凡诺维奇",
                                    "text": "您知道最近从天而降的那些陨石吗？"
                                },
                                {
                                    "id": "411310114",
                                    "speaker": "伊凡诺维奇",
                                    "text": "我想要去找到一块陨石，从上面敲下来几块带回来。"
                                },
                                {
                                    "id": "411310115",
                                    "speaker": "伊凡诺维奇",
                                    "text": "然后，再找个能工巧匠，将它雕刻琢磨，制成首饰…"
                                },
                                {
                                    "id": "411310116",
                                    "speaker": "伊凡诺维奇",
                                    "text": "一副由陨石制成的首饰…无论是戒指、项链、手环还是耳环，准能让那些有钱人们爽快掏钱。"
                                },
                                {
                                    "id": "411310117",
                                    "speaker": "伊凡诺维奇",
                                    "text": "旅行者，你要做的事很简单，只要保证我不受怪物干扰就行了。"
                                },
                                {
                                    "id": "411310118",
                                    "speaker": "伊凡诺维奇",
                                    "text": "怎么样，我们俩就此成交？"
                                },
                                {
                                    "id": "411310119",
                                    "speaker": "Player",
                                    "text": "绝不能接近陨石。"
                                },
                                {
                                    "id": "411310120",
                                    "speaker": "伊凡诺维奇",
                                    "text": "什么？为什么，这笔大生意我绝不会放过。"
                                }
                            ]
                        },
                        {
                            "id": "411310109",
                            "text": "法典里有什么新发现？",
                            "response": [
                                {
                                    "id": "411310110",
                                    "speaker": "伊凡诺维奇",
                                    "text": "唔，老实说，璃月的法典颇为严谨，几乎没有漏洞，但…"
                                },
                                {
                                    "id": "411310111",
                                    "speaker": "伊凡诺维奇",
                                    "text": "呃，不！不，我做的事，绝对是在法典允许的范围内。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}