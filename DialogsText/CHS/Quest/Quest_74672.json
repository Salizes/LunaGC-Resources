    "talks": [
        {
            "id": "7467203",
            "objective": "(test)隐藏任务用来开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7467201",
            "objective": "与乐平波琳对话",
            "dialogues": [
                {
                    "id": "746720101",
                    "speaker": "派蒙",
                    "text": "咦，是夏洛蒂？"
                },
                {
                    "id": "746720102",
                    "speaker": "派蒙",
                    "text": "她在和乐平波琳说些什么呢…"
                },
                {
                    "id": "746720103",
                    "speaker": "乐平波琳",
                    "text": "求求你求求你，夏洛蒂小姐，夏洛蒂大人！你一定只是在开玩笑，没错吧！"
                },
                {
                    "id": "746720104",
                    "speaker": "乐平波琳",
                    "text": "「穿着膨膨兽伪装服，骗过了警卫机关，成功犯罪」…这个案件真的发生过，对不对！"
                },
                {
                    "id": "746720105",
                    "speaker": "乐平波琳",
                    "text": "为了「图形对抗」的技术，我已经投入了全部存款，甚至还向银行借了一大笔钱啊！"
                },
                {
                    "id": "746720106",
                    "speaker": "乐平波琳",
                    "text": "我给你磕头了！磕磕磕磕磕！"
                },
                {
                    "id": "746720107",
                    "speaker": "夏洛蒂",
                    "text": "请你冷静一点，乐平波琳小姐…"
                },
                {
                    "id": "746720108",
                    "speaker": "夏洛蒂",
                    "text": "我理解你对研究的热情，还有…呃…对大笔订单的渴望？"
                },
                {
                    "id": "746720109",
                    "speaker": "夏洛蒂",
                    "text": "但…那确实只是一篇小说，是一位匿名作者出于个人兴趣写作，通过无署名信件投递的纪实风小说。",
                    "choices": [
                        {
                            "id": "746720110",
                            "text": "案件？",
                            "response": [
                                {
                                    "id": "746720112",
                                    "speaker": "派蒙",
                                    "text": "唔…我好像明白了。"
                                },
                                {
                                    "id": "746720113",
                                    "speaker": "派蒙",
                                    "text": "难道说，乐平波琳之前在《蒸汽鸟报》上读到的那一起案件，其实只是…"
                                },
                                {
                                    "id": "746720114",
                                    "speaker": "夏洛蒂",
                                    "text": "我亲耳听见了编辑们开会讨论的内容，编辑们也在担心，那篇小说会不会误导民众，还派人专门咨询了执律庭。"
                                },
                                {
                                    "id": "746720115",
                                    "speaker": "夏洛蒂",
                                    "text": "没想到，执律庭居然很中意那篇小说，觉得它会为潜在的罪犯提供一份假情报，引诱罪犯们穿着夸张的玩偶服行动…"
                                },
                                {
                                    "id": "746720116",
                                    "speaker": "夏洛蒂",
                                    "text": "警卫机关的识别能力非常可靠，与经验丰富的警备队员不相上下，这种措施其实根本骗不过它们，反而会使罪犯无比显眼…"
                                },
                                {
                                    "id": "746720117",
                                    "speaker": "夏洛蒂",
                                    "text": "自从刊登了那篇小说，执律庭已经成功抓获了一大群…「膨膨兽怪盗」、「巨大红冠雀」和「飘浮灵侠」。"
                                },
                                {
                                    "id": "746720118",
                                    "speaker": "夏洛蒂",
                                    "text": "没想到，那篇小说在辅助治安的同时，居然误导了你这样的研究员，还让你白白投入了一大笔资金…"
                                },
                                {
                                    "id": "746720119",
                                    "speaker": "乐平波琳",
                                    "text": "噫…啊啊啊啊啊…"
                                },
                                {
                                    "id": "746720120",
                                    "speaker": "派蒙",
                                    "text": "呃…乐平波琳的研究，居然建立在一个虚构的故事上？"
                                },
                                {
                                    "id": "746720121",
                                    "speaker": "派蒙",
                                    "text": "那我们岂不是也分不到那一大笔钱…不对不对，那她的投入，岂不是全都白费了？"
                                },
                                {
                                    "id": "746720122",
                                    "speaker": "夏洛蒂",
                                    "text": "#{NICKNAME}和派蒙，你们回来了！"
                                },
                                {
                                    "id": "746720123",
                                    "speaker": "夏洛蒂",
                                    "text": "我在附近留影取材的时候，遇见了这位乐平波琳小姐，听说了她的研究和你们的事。"
                                },
                                {
                                    "id": "746720124",
                                    "speaker": "夏洛蒂",
                                    "text": "乐平波琳小姐还想让我写一篇文章，帮她的「图形识别技术」打打广告，硬塞了我一笔稿费和一个样品。"
                                },
                                {
                                    "id": "746720125",
                                    "speaker": "夏洛蒂",
                                    "text": "很遗憾，她的期待和你们的努力都白费了…她还要想想办法，支付你们的酬劳…我说了些安慰的话，她一时也接受不了。"
                                },
                                {
                                    "id": "746720126",
                                    "speaker": "派蒙",
                                    "text": "我们也是头一回碰见这种事…"
                                },
                                {
                                    "id": "746720127",
                                    "speaker": "派蒙",
                                    "text": "总感觉…那篇小说的作者只是想写个吸引人的故事，执律庭的做法也的确有助于枫丹的治安…",
                                    "choices": [
                                        {
                                            "id": "746720128",
                                            "text": "没有人做错了什么事。",
                                            "response": [
                                                {
                                                    "id": "746720130",
                                                    "speaker": "夏洛蒂",
                                                    "text": "等等，乐平波琳小姐，你要干什么？"
                                                },
                                                {
                                                    "id": "746720131",
                                                    "speaker": "乐平波琳",
                                                    "text": "去找警卫机关打一架，走一趟欧庇克莱歌剧院，拿一张梅洛彼得堡的居住证。"
                                                },
                                                {
                                                    "id": "746720132",
                                                    "speaker": "乐平波琳",
                                                    "text": "这样就不用还钱了，嗯，只有这样才能活下去了…"
                                                },
                                                {
                                                    "id": "746720133",
                                                    "speaker": "夏洛蒂",
                                                    "text": "不至于这么夸张吧！看你的样子，就算袭击警卫机关，也打不破它们的装甲，最多只会被执律庭拘留几天，还是要还钱的！"
                                                },
                                                {
                                                    "id": "746720134",
                                                    "speaker": "夏洛蒂",
                                                    "text": "啊，不对，重点是你究竟为了这个技术投入了多少钱，绝望成这样…"
                                                },
                                                {
                                                    "id": "746720135",
                                                    "speaker": "乐平波琳",
                                                    "text": "二…二十七万摩拉。"
                                                },
                                                {
                                                    "id": "746720136",
                                                    "speaker": "夏洛蒂",
                                                    "text": "这个数额，好像也不至于…躲进梅洛彼得堡去吧？"
                                                },
                                                {
                                                    "id": "746720137",
                                                    "speaker": "乐平波琳",
                                                    "text": "作为一个前枫丹科学院外包器材供应商的工程师，这已经是我这种小角色辛辛苦苦几年才攒下来的极限存款了呀！"
                                                },
                                                {
                                                    "id": "746720138",
                                                    "speaker": "乐平波琳",
                                                    "text": "而且，失去的不止是我的存款，还有我对「图形对抗」畅想的美好未来，还有我亿万富翁的梦！"
                                                },
                                                {
                                                    "id": "746720139",
                                                    "speaker": "乐平波琳",
                                                    "text": "哈…哈哈…呵呵…呜呜…"
                                                },
                                                {
                                                    "id": "746720140",
                                                    "speaker": "乐平波琳",
                                                    "text": "我的人生完蛋了。"
                                                },
                                                {
                                                    "id": "746720141",
                                                    "speaker": "夏洛蒂",
                                                    "text": "咳咳，不必这么丧气，乐平波琳小姐，我有一个提议。"
                                                },
                                                {
                                                    "id": "746720142",
                                                    "speaker": "夏洛蒂",
                                                    "text": "刚才我发现，为了更精准地收集与分析图像，你给我的样品——那个「图形识别样本收集留影镜头」，采用了一种很特别的设计。"
                                                },
                                                {
                                                    "id": "746720143",
                                                    "speaker": "夏洛蒂",
                                                    "text": "不考虑原本的功能，这种能快速变焦的镜头，一定能为记者们提供许多便利，甚至加速整个枫丹新闻业的进步！"
                                                },
                                                {
                                                    "id": "746720144",
                                                    "speaker": "夏洛蒂",
                                                    "text": "所以说，你之前的研究没有白费，它们能在你没想到的领域展现出不凡的价值！"
                                                },
                                                {
                                                    "id": "746720145",
                                                    "speaker": "乐平波琳",
                                                    "text": "真，真的吗？"
                                                },
                                                {
                                                    "id": "746720146",
                                                    "speaker": "夏洛蒂",
                                                    "text": "那是当然！我好歹也是在《蒸汽鸟报》工作了一段时间的记者，同行们工作时遇到的难题，我再清楚不过了。"
                                                },
                                                {
                                                    "id": "746720147",
                                                    "speaker": "夏洛蒂",
                                                    "text": "你先冷静一下，振作起来，然后考虑一下量产镜头的问题，我会和同行们介绍你的镜头，为你介绍生意的。"
                                                },
                                                {
                                                    "id": "746720148",
                                                    "speaker": "乐平波琳",
                                                    "text": "还有这种好事…"
                                                },
                                                {
                                                    "id": "746720149",
                                                    "speaker": "乐平波琳",
                                                    "text": "那我岂不是可以…抓住「留影设备」的发展脉络了？我还是能拿到大笔订单，成为亿万富翁！"
                                                },
                                                {
                                                    "id": "746720150",
                                                    "speaker": "乐平波琳",
                                                    "text": "我是不是应该…再去借一笔钱？尽早改进镜头的工艺，抢先占领市场，为留影设备的对抗战争做好准备！"
                                                },
                                                {
                                                    "id": "746720151",
                                                    "speaker": "派蒙",
                                                    "text": "别总是想着抓住什么脉络了啦，乐平波琳…还是走一步看一步，不要一下子就把全部身家砸进去赚大钱…",
                                                    "choices": [
                                                        {
                                                            "id": "746720152",
                                                            "text": "野心越大越容易失望哦。",
                                                            "response": [
                                                                {
                                                                    "id": "746720154",
                                                                    "speaker": "乐平波琳",
                                                                    "text": "嗯…要是找个熟人，把图形识别的设备卖给有需要的工坊，还能再筹集一笔摩拉…我应该早点想到的！"
                                                                },
                                                                {
                                                                    "id": "746720155",
                                                                    "speaker": "乐平波琳",
                                                                    "text": "事不宜迟，我现在就要开工，不然就晚了！"
                                                                },
                                                                {
                                                                    "id": "746720156",
                                                                    "speaker": "派蒙",
                                                                    "text": "啊，居然就这么跑掉了！"
                                                                },
                                                                {
                                                                    "id": "746720157",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们劝她的话，好像根本就没听进去嘛！"
                                                                },
                                                                {
                                                                    "id": "746720158",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "嗯…可以理解，「灵感和热情涌上来的时候，很容易忽略别人的话，只顾着推进工作」…许多刚入行的记者也是这样。"
                                                                },
                                                                {
                                                                    "id": "746720159",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "不过，你们不用担心，我打算把这次的事件写成一篇报道，还会经常去找乐平波琳小姐的。"
                                                                },
                                                                {
                                                                    "id": "746720160",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "她的研究能帮助整个记者群体，我也会为她提供建议，防止她走入误区的，争取让她尽早成功量产那种镜头。"
                                                                },
                                                                {
                                                                    "id": "746720161",
                                                                    "speaker": "派蒙",
                                                                    "text": "你这样一说，我们就放心多了！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746720162",
                                                                            "text": "不愧是夏洛蒂！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746720164",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "说起来，你们两位经常四处旅行，这个样品镜头就送给你们了！"
                                                                                },
                                                                                {
                                                                                    "id": "746720165",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "新奇的道具在厉害的人手里才能发挥最大的作用，在你们的运用下，它想必能记录不少精彩的景色。"
                                                                                },
                                                                                {
                                                                                    "id": "746720166",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "谢谢你啦，夏洛蒂！"
                                                                                },
                                                                                {
                                                                                    "id": "746720167",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "拿不到分成也无所谓了，起码，我们没有白白跑腿！"
                                                                                },
                                                                                {
                                                                                    "id": "746720168",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "别客气，我也收获了很特别的新闻素材！"
                                                                                },
                                                                                {
                                                                                    "id": "746720169",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "「即使有着特殊的需求，新闻报道和纪实类文学作品的边界，也还是划分得越清楚越好。」"
                                                                                },
                                                                                {
                                                                                    "id": "746720170",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "我会向编辑们好好反馈的，希望以后不要再出现乐平波琳这种…一番好心却撞上霉运的人！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746720163",
                                                                            "text": "不愧是王牌记者！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746720153",
                                                            "text": "踏踏实实做事才是正道。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746720129",
                                            "text": "只有乐平波琳受了伤。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746720111",
                            "text": "小说？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7467202",
            "objective": "与夏洛蒂对话",
            "dialogues": [
                {
                    "id": "746720201",
