    "talks": [
        {
            "id": "1100301",
            "objective": "前往香菱提到的地方",
            "dialogues": [
                {
                    "id": "110030101",
                    "speaker": "香菱",
                    "text": "那、那是…！"
                }
            ]
        },
        {
            "id": "1100302",
            "objective": "与香菱和瑟瑟发抖的人交谈",
            "dialogues": [
                {
                    "id": "110030201",
                    "speaker": "奥拉夫",
                    "text": "好…好冷。"
                },
                {
                    "id": "110030202",
                    "speaker": "香菱",
                    "text": "他的身子好冷！得赶快帮他暖暖才行！"
                },
                {
                    "id": "110030203",
                    "speaker": "派蒙",
                    "text": "那在这里生火吧！"
                },
                {
                    "id": "110030204",
                    "speaker": "香菱",
                    "text": "嗯，最好还能有一碗热汤。"
                },
                {
                    "id": "110030205",
                    "speaker": "香菱",
                    "text": "#{NICKNAME}，我在这里照顾他，能麻烦你去准备一份<color=#00E1FFFF>美味的热汤</color>吗？"
                },
                {
                    "id": "110030206",
                    "speaker": "香菱",
                    "text": "我记得来的路上有个丘丘人营地，那里多半就有能做汤的地方。"
                },
                {
                    "id": "110030207",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "110030208",
                    "speaker": "香菱",
                    "text": "好的，准备好了就尽快回来！"
                }
            ]
        },
        {
            "id": "1100303",
            "objective": "烹制「美味的萝卜时蔬汤」",
            "dialogues": []
        },
        {
            "id": "1100304",
            "objective": "给猎人送上做好的汤",
            "dialogues": [
                {
                    "id": "110030401",
                    "speaker": "奥拉夫",
                    "text": "哈啊…哈啊…好多了。"
                },
                {
                    "id": "110030402",
                    "speaker": "奥拉夫",
                    "text": "谢谢你们，这碗汤真好喝。"
                },
                {
                    "id": "110030403",
                    "speaker": "Player",
                    "text": "怎么会冻成这个样子？"
                },
                {
                    "id": "110030404",
                    "speaker": "奥拉夫",
                    "text": "我本来在追一只野猪，追了好远，它逃进了那边的地下遗迹里。"
                },
                {
                    "id": "110030405",
                    "speaker": "奥拉夫",
                    "text": "我追进去，却遇到了一棵好大好大的急冻树。"
                },
                {
                    "id": "110030406",
                    "speaker": "奥拉夫",
                    "text": "我被冻僵了，清醒之后就跑了出来，但跑到这里身子就使不上劲了。"
                },
                {
                    "id": "110030407",
                    "speaker": "香菱",
                    "text": "急冻树？一棵树，还会攻击人？"
                },
                {
                    "id": "110030408",
                    "speaker": "奥拉夫",
                    "text": "是啊，我以前只是听别人说过，亲眼见到还是头一次。"
                },
                {
                    "id": "110030409",
                    "speaker": "派蒙",
                    "text": "听起来好危险…我们还是不要靠近那个遗迹吧。"
                },
                {
                    "id": "110030410",
                    "speaker": "香菱",
                    "text": "说不定会很好吃！",
                    "choices": [
                        {
                            "id": "110030411",
                            "text": "…啊？",
                            "response": [
                                {
                                    "id": "110030413",
                                    "speaker": "香菱",
                                    "text": "就是这个！一锤定音的食材，肯定会很好吃的！"
                                },
                                {
                                    "id": "110030414",
                                    "speaker": "派蒙",
                                    "text": "冷静啊，这么凶猛的植物真的能吃吗？"
                                },
                                {
                                    "id": "110030415",
                                    "speaker": "香菱",
                                    "text": "不试试看怎么知道，快，我们出发吧！"
                                },
                                {
                                    "id": "110030416",
                                    "speaker": "派蒙",
                                    "text": "又跑掉了…",
                                    "choices": [
                                        {
                                            "id": "110030417",
                                            "text": "我们要先走一步了。",
                                            "response": [
                                                {
                                                    "id": "110030419",
                                                    "speaker": "奥拉夫",
                                                    "text": "没事，不用管我，但一定要阻止她，很危险的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110030418",
                                            "text": "你先回清泉镇吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110030412",
                            "text": "这也能联想到吃的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100398",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110039801",
                    "speaker": "香菱",
                    "text": "我们来的时候路过了一个丘丘人的营地，那里应该有能做汤的地方。"
                },
                {
                    "id": "110039802",
                    "speaker": "香菱",
                    "text": "我在这里照顾他，麻烦你去准备一碗美味的热汤，给他暖暖身子吧！"
                }
            ]
        },
        {
            "id": "1100399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110039901",
                    "speaker": "奥拉夫",
                    "text": "好冷啊…里面冷死了…"
                }
            ]
        }
    ]
