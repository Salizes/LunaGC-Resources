    "talks": [
        {
            "id": "4140201",
            "objective": "与季同对话",
            "dialogues": [
                {
                    "id": "414020101",
                    "speaker": "季同",
                    "text": "哎，你来了，我正好有事和你说。",
                    "choices": [
                        {
                            "id": "414020102",
                            "text": "有什么事？",
                            "response": [
                                {
                                    "id": "414020104",
                                    "speaker": "季同",
                                    "text": "不用了不用了，我已经弄清原因了。"
                                },
                                {
                                    "id": "414020105",
                                    "speaker": "季同",
                                    "text": "前几天，我总算找到那个卖我「留影机」的人了。"
                                },
                                {
                                    "id": "414020106",
                                    "speaker": "季同",
                                    "text": "我说他的「留影机」有问题，但是他怎么都不信。"
                                },
                                {
                                    "id": "414020107",
                                    "speaker": "季同",
                                    "text": "多亏了你之前帮我拍了那么多画，要不是我有那么多画，那家伙估计不肯认账。"
                                },
                                {
                                    "id": "414020108",
                                    "speaker": "季同",
                                    "text": "有了你帮我拍了那些画，他才答应回去检查一下卖给我的那批「留影机」。"
                                },
                                {
                                    "id": "414020109",
                                    "speaker": "季同",
                                    "text": "这不，昨天他刚给我拿了一瓶什么药剂过来。"
                                },
                                {
                                    "id": "414020110",
                                    "speaker": "季同",
                                    "text": "他说这种「留影机」的结构和普通的不一样，需要往机器添加点药剂，印出来的画才是出正常的画面。"
                                },
                                {
                                    "id": "414020111",
                                    "speaker": "季同",
                                    "text": "要是不加那种药剂，那就和你之前拍的那种画一样，只有颜色，没有清晰的画面。",
                                    "choices": [
                                        {
                                            "id": "414020112",
                                            "text": "机器没事就好。",
                                            "response": [
                                                {
                                                    "id": "414020114",
                                                    "speaker": "季同",
                                                    "text": "唔，话是这么说，但比起「留影机」，我其实对那种药剂更感兴趣…"
                                                },
                                                {
                                                    "id": "414020115",
                                                    "speaker": "季同",
                                                    "text": "你想，大多数人只会买一台「留影机」对吧？买了也可以一直用。"
                                                },
                                                {
                                                    "id": "414020116",
                                                    "speaker": "季同",
                                                    "text": "但那种药剂可是耗材，用完了之后，想用就得接着卖。"
                                                },
                                                {
                                                    "id": "414020117",
                                                    "speaker": "季同",
                                                    "text": "而且据那个人说，根据药剂的不同，印出来的画效果也不一样。他那边也正在研究更多的药剂…"
                                                },
                                                {
                                                    "id": "414020118",
                                                    "speaker": "季同",
                                                    "text": "也许…那种药剂才是真正的大生意…"
                                                },
                                                {
                                                    "id": "414020119",
                                                    "speaker": "季同",
                                                    "text": "咳，抱歉，我一个人在这自言自语个没完。"
                                                },
                                                {
                                                    "id": "414020120",
                                                    "speaker": "季同",
                                                    "text": "谢谢您帮忙，您先把这台「留影机」给我一下，我给您把那种药剂添进去…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "414020113",
                                            "text": "那…就都没问题了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "414020103",
                            "text": "今天也要拍「颜色」强烈的东西吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4140202",
            "objective": "与季同对话",
            "dialogues": [
                {
                    "id": "414020201",
                    "speaker": "季同",
                    "text": "这位旅行者，请你留步。"
                },
                {
                    "id": "414020202",
                    "speaker": "Player",
                    "text": "有什么事吗？"
                },
                {
                    "id": "414020203",
                    "speaker": "季同",
                    "text": "虽然有点突然…但是，请问你对「留影机」有兴趣吗？",
                    "choices": [
                        {
                            "id": "414020204",
                            "text": "有一点兴趣…",
                            "response": [
                                {
                                    "id": "414020206",
                                    "speaker": "季同",
                                    "text": "哎，我这台「留影机」可不是一般的「留影机」，这可是枫丹最新的技术。"
                                },
                                {
                                    "id": "414020207",
                                    "speaker": "季同",
                                    "text": "从这台「留影机」里印出来的画，能有一种普通「留影机」没有的色调。",
                                    "choices": [
                                        {
                                            "id": "414020208",
                                            "text": "这是怎么做到的…",
                                            "response": [
                                                {
                                                    "id": "414020210",
                                                    "speaker": "季同",
                                                    "text": "哎！你怎么一副不相信的样子，你不信的话，就去冒险家协会那边问问去。"
                                                },
                                                {
                                                    "id": "414020211",
                                                    "speaker": "季同",
                                                    "text": "之前我也不相信，摆弄了这台「留影机」半天没摆弄好，还是协会里的一位冒险家帮了我的忙。"
                                                },
                                                {
                                                    "id": "414020212",
                                                    "speaker": "季同",
                                                    "text": "这「留影机」啊，和普通的「留影机」不一样的地方，就是在它里面的有个小结构。"
                                                },
                                                {
                                                    "id": "414020213",
                                                    "speaker": "季同",
                                                    "text": "这个结构里填着一种特别的药剂，能让印出来的画带有特别的效果，可比普通「留影机」拍出来的画好看多了。"
                                                },
                                                {
                                                    "id": "414020214",
                                                    "speaker": "季同",
                                                    "text": "怎么样？有兴趣的话，您先拿着这个玩玩？虽然这台里面的药剂种类不太多，但体验体验还是足够了。"
                                                },
                                                {
                                                    "id": "414020215",
                                                    "speaker": "季同",
                                                    "text": "我之后还会去枫丹进一批全新的药剂，要是您有兴趣，欢迎来光顾。",
                                                    "choices": [
                                                        {
                                                            "id": "414020216",
                                                            "text": "那…谢谢了…",
                                                            "response": [
                                                                {
                                                                    "id": "414020219",
                                                                    "speaker": "季同",
                                                                    "text": "那这台「留影机」就送给您玩了，如果觉得不错，以后记得多多光顾我的生意。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "414020217",
                                                            "text": "那些药剂多少钱？",
                                                            "response": [
                                                                {
                                                                    "id": "414020218",
                                                                    "speaker": "季同",
                                                                    "text": "这个…咳，您别担心，单支非常便宜。如果您买得多，到时候也能商量着优惠点…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "414020209",
                                            "text": "真的假的…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "414020205",
                            "text": "没什么兴趣…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4140203",
            "objective": "与季同对话",
            "dialogues": [
                {
                    "id": "414020301",
                    "speaker": "季同",
                    "text": "好了这台「留影机」就送给您了，请您收好。",
                    "choices": [
                        {
                            "id": "414020302",
                            "text": "这台「留影机」就…送我了？",
                            "response": [
                                {
                                    "id": "414020304",
                                    "speaker": "季同",
                                    "text": "这些药剂也够您用一段时间的了，药剂用完了的话…您就可以找我买嘛，对吧？"
                                },
                                {
                                    "id": "414020305",
                                    "speaker": "季同",
                                    "text": "再说了，我还准备去找那个人，进更多种类的药剂呢。"
                                },
                                {
                                    "id": "414020306",
                                    "speaker": "季同",
                                    "text": "您以后要是有兴趣，欢迎您来我这光顾啊。"
                                },
                                {
                                    "id": "414020307",
                                    "speaker": "季同",
                                    "text": "哎呀…没想到，买台「留影机」，还能买出一桩好生意…"
                                }
                            ]
                        },
                        {
                            "id": "414020303",
                            "text": "要是那种药剂用完的话…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4140204",
            "objective": "（隐藏）加载和删除NPC的逻辑配置$HIDDEN",
