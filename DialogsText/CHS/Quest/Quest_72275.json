    },
    "talks": [
        {
            "id": "7227501",
            "objective": "和乌帽子对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722750101",
                    "speaker": "乌帽子",
                    "text": "此身既然已经显现，那血枝珊瑚应该已入海祇之手。让人欣慰。"
                },
                {
                    "id": "722750102",
                    "speaker": "乌帽子",
                    "text": "我名厄伯斯，稻妻式名字是乌帽子。乃是珊瑚宫之辅弼，渊下宫巫女中的一位。"
                },
                {
                    "id": "722750103",
                    "speaker": "乌帽子",
                    "text": "您应该就是取得珊瑚枝的勇者吧？"
                },
                {
                    "id": "722750104",
                    "speaker": "Player",
                    "text": "是我没错。"
                },
                {
                    "id": "722750105",
                    "speaker": "乌帽子",
                    "text": "实在抱歉，我要讲述之事可能过于复杂，不知应该如何说起。"
                },
                {
                    "id": "722750106",
                    "speaker": "派蒙",
                    "text": "你可以从头开始说，我们会听的。"
                },
                {
                    "id": "722750107",
                    "speaker": "乌帽子",
                    "text": "非常感谢。那么，就请容我为您稍事介绍吧。这要从海祇大御神打通海渊之门说起。"
                },
                {
                    "id": "722750108",
                    "speaker": "乌帽子",
                    "text": "渊下宫的深处有一处天然溶洞，便是通往海祇岛之路。也是海祇所许诺的地上乐土。"
                },
                {
                    "id": "722750109",
                    "speaker": "乌帽子",
                    "text": "我们在大御神的授意下，学习了鸣神文化，并且曾与诸方土地建立了外交。"
                },
                {
                    "id": "722750110",
                    "speaker": "乌帽子",
                    "text": "鸣神岛还称赞我们的「海祇美人」呢。因为我们海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼。"
                },
                {
                    "id": "722750111",
                    "speaker": "乌帽子",
                    "text": "这种说法的来由呢，是因为我们和祖先都在渊下宫生活得不到日照…",
                    "choices": [
                        {
                            "id": "722750112",
                            "text": "说重点。",
                            "response": [
                                {
                                    "id": "722750114",
                                    "speaker": "乌帽子",
                                    "text": "啊，抱歉。以前日子与诸国外交，我作为珊瑚宫之辅弼，经常担任向导。一不小心就…"
                                },
                                {
                                    "id": "722750115",
                                    "speaker": "乌帽子",
                                    "text": "话说回来吧。我与珊瑚宫大人产生了分歧，在海祇大御神的调停之下，我们有了现在的这个方案。"
                                },
                                {
                                    "id": "722750116",
                                    "speaker": "乌帽子",
                                    "text": "因为渊下宫有「罪影」这种现象，「过去」、「历史」、「真相」这种东西，放着不管也会永世长存。"
                                },
                                {
                                    "id": "722750117",
                                    "speaker": "乌帽子",
                                    "text": "所以我们费心尽力，并不是为了铭记，而是为了「遗忘」。很明显，珊瑚宫大人就是这么想的。"
                                },
                                {
                                    "id": "722750118",
                                    "speaker": "派蒙",
                                    "text": "（她说的珊瑚宫，应该是很久以前的珊瑚宫巫女吧…）"
                                },
                                {
                                    "id": "722750119",
                                    "speaker": "乌帽子",
                                    "text": "取珊瑚枝的试炼，就是尽可能少地让后人接触事件全貌的设计。"
                                },
                                {
                                    "id": "722750120",
                                    "speaker": "乌帽子",
                                    "text": "而我则支持留下真相。因此海祇大御神许可我在此追加一道试炼，通过的话，就可以知晓秘密。"
                                },
                                {
                                    "id": "722750121",
                                    "speaker": "乌帽子",
                                    "text": "请您接受这个挑战吧。",
                                    "choices": [
                                        {
                                            "id": "722750122",
                                            "text": "我接受挑战。",
                                            "response": [
                                                {
                                                    "id": "722750124",
                                                    "speaker": "乌帽子",
                                                    "text": "如此甚好，那么我来为你启动追加的试炼。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722750123",
                                            "text": "我对秘密很感兴趣。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722750113",
                            "text": "怎么又是这话。说重点。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7227507",
            "objective": "Cutscene$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7227508",
            "objective": "乌帽子的对话",
            "dialogues": [
                {
                    "id": "722750401",
                    "speaker": "乌帽子",
                    "text": "边陲三角的试炼之地已经准备好了。"
                },
                {
                    "id": "722750402",
                    "speaker": "乌帽子",
                    "text": "那么我来传达剩下三场试炼的线索吧。"
                },
                {
                    "id": "722750403",
                    "speaker": "乌帽子",
                    "text": "请你在常夜之中，远望白夜国的边疆吧。"
                },
                {
                    "id": "722750404",
                    "speaker": "乌帽子",
                    "text": "——「于昏冥的常世之夜中，于奔流的冥河之外，于无罪的天光流泻之处。」"
                },
                {
                    "id": "722750405",
                    "speaker": "乌帽子",
                    "text": "请你解开天光流泻之处的封印，升入天之门扉到达试炼之处。"
                },
                {
                    "id": "722750406",
                    "speaker": "Player",
                    "text": "天光流泻之处?"
                },
                {
                    "id": "722750408",
                    "speaker": "乌帽子",
                    "text": "在夜晚可以看到自穹顶落下的三道光柱，这些光柱指向了天光流泻之处。"
                },
                {
                    "id": "722750410",
                    "speaker": "派蒙",
                    "text": "你说的有点太模糊了。"
                },
                {
                    "id": "722750411",
                    "speaker": "乌帽子",
                    "text": "抱歉，海祇大御神它写的台本就是这样的。语焉不详的指示也是试炼的老传统了嘛。"
                },
                {
                    "id": "722750412",
                    "speaker": "乌帽子",
                    "text": "总之试炼之处的地走官们都是怪人。没有通过传送门过去的话，他们是不会和气说话的。"
                },
                {
                    "id": "722750413",
                    "speaker": "乌帽子",
                    "text": "我唯有在这里恭候你踏破所有阻碍，取得所有认可之后归来。"
                }
            ]
        },
        {
            "id": "7227502",
            "objective": "完成挑战",
            "dialogues": [
                {
                    "id": "722750201",
                    "speaker": "乌帽子",
                    "text": "如此您已经获得了所有地走官的认可。他们代行海祇之意志，因此你也获得了知道一切的权力。"
                },
                {
                    "id": "722750202",
                    "speaker": "乌帽子",
                    "text": "您是拯救海祇万民的救主，亦是海祇认可之人。您有权知晓任何您关心的问题。"
                },
                {
                    "id": "722750203",
                    "speaker": "乌帽子",
                    "text": "但是请您遵守规矩，一定不要将这些真相带离海渊。"
                },
                {
                    "id": "722750204",
                    "speaker": "乌帽子",
                    "text": "你还有什么想知道的呢?",
                    "choices": [
                        {
                            "id": "722750205",
                            "text": "关于深海龙蜥…",
                            "response": [
                                {
                                    "id": "722750210",
                                    "speaker": "乌帽子",
                                    "text": "深海龙蜥是原始的元素生物，因为久居深海，所以并没有被天上降临的力量降伏。"
                                },
                                {
                                    "id": "722750211",
                                    "speaker": "乌帽子",
                                    "text": "它们其实非常聪明，而且擅长进化。在和我们战斗的历史里，甚至进化出了其他元素的品种。"
                                },
                                {
                                    "id": "722750212",
                                    "speaker": "乌帽子",
                                    "text": "如果它们学会了语言，甚至进化出蜥蜴人这种东西我都不会奇怪的。"
                                },
                                {
                                    "id": "722750213",
                                    "speaker": "乌帽子",
                                    "text": "「圣土化」的本质，其实就是它们宜居环境的拓张。也就是三界中的原始元素力量变得强势。"
                                },
                                {
                                    "id": "722750214",
                                    "speaker": "乌帽子",
                                    "text": "我们唯有使用海祇大御神生命力，唤醒它的第二眷属，将荒蛮的元素力转化掉。"
                                }
                            ]
                        },
                        {
                            "id": "722750206",
                            "text": "关于海祇大御神…",
                            "response": [
                                {
                                    "id": "722750215",
                                    "speaker": "乌帽子",
                                    "text": "海祇大御神因为它的厄运，落入了「天之秩序」管辖之外的此处。"
                                },
                                {
                                    "id": "722750216",
                                    "speaker": "乌帽子",
                                    "text": "这件事毫无疑问是我等白夜国民的好运。它真的为了我们做了许多事情。"
                                },
                                {
                                    "id": "722750217",
                                    "speaker": "乌帽子",
                                    "text": "只不过也因为接触了我们，触碰了甚至在它诞生之前的真相。于是它被天京敕令，必须舍身成仁。"
                                },
                                {
                                    "id": "722750218",
                                    "speaker": "乌帽子",
                                    "text": "此番献头，必须做到无人怀疑。唯有此法，白夜之民才能被允许活在新的「七之秩序」之下。"
                                }
                            ]
                        },
                        {
                            "id": "722750207",
                            "text": "关于日月之前的事…",
                            "response": [
                                {
                                    "id": "722750219",
                                    "speaker": "乌帽子",
                                    "text": "白夜国落入海渊之前，确实整个世界都在统一的文化之下。"
                                },
                                {
                                    "id": "722750220",
                                    "speaker": "乌帽子",
                                    "text": "后来发生了一场大战，天也倾覆，地也崩裂。这片土地在那时落下了漆黑的海渊。"
                                },
                                {
                                    "id": "722750221",
                                    "speaker": "乌帽子",
                                    "text": "而后，天之秩序似乎并不想让记得这一切的人残留在大地之上。我们寻找归途，却怎么也找不到。"
                                },
                                {
                                    "id": "722750222",
                                    "speaker": "乌帽子",
                                    "text": "直到很久以后，天之禁令的力量逐渐减弱了。海祇大御神掉入了这里。"
                                }
                            ]
                        },
                        {
                            "id": "722750208",
                            "text": "关于大日御舆…",
                            "response": [
                                {
                                    "id": "722750223",
                                    "speaker": "乌帽子",
                                    "text": "大日御舆是贤人·阿布拉克设计的建筑。它拥有为海渊之下带来光的力量。"
                                },
                                {
                                    "id": "722750224",
                                    "speaker": "乌帽子",
                                    "text": "除此以外，还集成了很多功能。"
                                },
                                {
                                    "id": "722750225",
                                    "speaker": "乌帽子",
                                    "text": "总之很厉害。"
                                }
                            ]
                        },
                        {
                            "id": "722750209",
                            "text": "没有其他的事了。",
                            "response": [
                                {
                                    "id": "722750226",
                                    "speaker": "乌帽子",
                                    "text": "那么好的。请你务必记住，渊下宫所遇之事，请当成永远的秘密吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7227503",
            "objective": "完成挑战",
            "dialogues": [
                {
                    "id": "722750301",
                    "speaker": "乌帽子",
                    "text": "请您向地走官的常世之灵证明自己的勇武吧。"
                },
                {
                    "id": "722750302",
                    "speaker": "乌帽子",
                    "text": "当你完成了所有挑战，我才能告诉你所有的秘密。"
                },
                {
                    "id": "722750303",
                    "speaker": "乌帽子",
                    "text": "…唉，我像是个知道了点小秘密就忍不住想找人说的小姑娘似的。"
                }
            ]
        },
        {
            "id": "7227504",
            "objective": "完成挑战",
            "dialogues": []
        },
        {
            "id": "7227506",
            "objective": "与乌帽子对话",
            "dialogues": []
        }
    ]
}