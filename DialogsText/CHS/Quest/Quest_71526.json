    "talks": [
        {
            "id": "7152601",
            "objective": "(test)斗虫二期-畅畅关卡$HIDDEN",
            "dialogues": [
                {
                    "id": "716663001",
                    "speaker": "「恐怖猫爪草」",
                    "text": "鬼兜虫…也可以当成猫猫狗狗一样的朋友！"
                },
                {
                    "id": "716663002",
                    "speaker": "荒泷一斗",
                    "text": "这次也找来了一个孩子？"
                },
                {
                    "id": "716663003",
                    "speaker": "派蒙",
                    "text": "唔，不过「花角玉将」也年纪轻轻，我记得上次还有一位小朋友，看来斗虫的本领和年龄完全无关嘛。"
                },
                {
                    "id": "716663004",
                    "speaker": "「花角玉将」",
                    "text": "虽然这位人称…「恐怖猫爪草」的斗虫选手没有斗虫经验，但她的鬼兜虫伙伴散发出了极强的气势！"
                },
                {
                    "id": "716663005",
                    "speaker": "「恐怖猫爪草」",
                    "text": "畅畅不懂你在说什么。"
                },
                {
                    "id": "716663006",
                    "speaker": "「恐怖猫爪草」",
                    "text": "畅畅的鬼兜虫是爸爸上次带回来的礼物，是爸爸在旅行中交到的朋友送给他的。"
                },
                {
                    "id": "716663007",
                    "speaker": "荒泷一斗",
                    "text": "哦哟，看来你的爸爸很懂行嘛！"
                },
                {
                    "id": "716663008",
                    "speaker": "荒泷一斗",
                    "text": "那我们这边就派出「破空白铁小堇瓜」来参战，免得像是在欺负人家。"
                },
                {
                    "id": "716663009",
                    "speaker": "派蒙",
                    "text": "哼，怎么说得我好像是最弱的那个一样…"
                },
                {
                    "id": "716663010",
                    "speaker": "派蒙",
                    "text": "不过，你们两个斗虫狂人有可能把握不好轻重，确实应该由我来和她较量。"
                },
                {
                    "id": "716663011",
                    "speaker": "派蒙",
                    "text": "别紧张哦，这位小朋友，只是游戏而已，开心就好！"
                }
            ]
        },
        {
            "id": "7152602",
            "objective": "(test)挑战畅畅$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7152603",
            "objective": "(test)成功挑战一次畅畅$HIDDEN",
            "dialogues": [
                {
                    "id": "716663101",
                    "speaker": "派蒙",
                    "text": "呼啊…还好没有失误！"
                },
                {
                    "id": "716663102",
                    "speaker": "荒泷一斗",
                    "text": "吓，吓死我了！还…还挺生猛的，换我也不好对付！"
                },
                {
                    "id": "716663103",
                    "speaker": "荒泷一斗",
                    "text": "璃月的斗虫强者都是无师自通的鬼才吗！"
                },
                {
                    "id": "716663104",
                    "speaker": "「恐怖猫爪草」",
                    "text": "原来鬼兜虫之间，是这么一起玩的吗？畅畅完全明白了！"
                },
                {
                    "id": "716663105",
                    "speaker": "「恐怖猫爪草」",
                    "text": "你们有时间的话，可以和畅畅再玩几局嘛？我也会继续看你们一起玩，好好学一学的！"
                },
                {
                    "id": "716663106",
                    "speaker": "派蒙",
                    "text": "看来…「恐怖猫爪草」的天分，确实很恐怖！"
                },
                {
                    "id": "716663107",
                    "speaker": "派蒙",
                    "text": "要是放牛的有这种天分，说不定只是听着锅巴和「水晶岛梆梆旋风」交流，就能明白甲壳生物的交流方式呢。"
                },
                {
                    "id": "716663108",
                    "speaker": "荒泷一斗",
                    "text": "哈…哈哈哈…我也希望自己有那么强啊！"
                }
            ]
        }
    ]
}