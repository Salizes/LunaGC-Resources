    "talks": [
        {
            "id": "7622604",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7622601",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762260201",
                    "speaker": "派蒙",
                    "text": "欸？这不是梅拉吗？居然在月亮上碰面了，真是意想不到。"
                },
                {
                    "id": "762260202",
                    "speaker": "派蒙",
                    "text": "一定是哥伦比娅带你来的吧？毕竟她说过要带你来月亮上办画展呢。"
                },
                {
                    "id": "762260203",
                    "speaker": "派蒙",
                    "text": "对了，说到画展…你的画呢？"
                },
                {
                    "id": "762260204",
                    "speaker": "梅拉",
                    "text": "！"
                },
                {
                    "id": "762260205",
                    "speaker": "派蒙",
                    "text": "怎么了？难道…画丢了？"
                },
                {
                    "id": "762260206",
                    "speaker": "梅拉",
                    "text": "！"
                },
                {
                    "id": "762260207",
                    "speaker": "派蒙",
                    "text": "怎么会这样？这可是在月亮上啊，总不能是被偷走了吧…"
                },
                {
                    "id": "762260208",
                    "speaker": "派蒙",
                    "text": "不管怎么说，我们先帮帮梅拉找一找画吧，也有可能是落在了附近。"
                }
            ]
        },
        {
            "id": "7622602",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7622603",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "762260101",
                    "speaker": "派蒙",
                    "text": "梅拉快看，我们把你的画都找回来啦。"
                },
                {
                    "id": "762260102",
                    "speaker": "梅拉",
                    "text": "♪~"
                },
                {
                    "id": "762260103",
                    "speaker": "派蒙",
                    "text": "嘿嘿，不用客气啦。毕竟这些画还有我们的功劳呢。"
                },
                {
                    "id": "762260104",
                    "speaker": "Player",
                    "text": "派蒙什么时候能听懂梅拉的话了？"
                },
                {
                    "id": "762260105",
                    "speaker": "派蒙",
                    "text": "哎呀，我都和你一起去了好多次银月之庭了，能听懂梅拉的意思也不奇怪吧。"
                },
                {
                    "id": "762260106",
                    "speaker": "Player",
                    "text": "那梅拉说画是怎么丢的？"
                },
                {
                    "id": "762260107",
                    "speaker": "派蒙",
                    "text": "呃…这个…我理解一下哦…梅拉说…"
                },
                {
                    "id": "762260108",
                    "speaker": "派蒙",
                    "text": "可能是其他月灵偷走的…"
                },
                {
                    "id": "762260109",
                    "speaker": "派蒙",
                    "text": "嗯…也可能是月亮上那些神奇的运输机关偷走的…"
                },
                {
                    "id": "762260110",
                    "speaker": "派蒙",
                    "text": "嗯…还可能是哥伦比娅偷走的…"
                },
                {
                    "id": "762260111",
                    "speaker": "Player",
                    "text": "这个绝对不可能吧！"
                },
                {
                    "id": "762260112",
                    "speaker": "派蒙",
                    "text": "欸？对哦…难道我理解错了…"
                },
                {
                    "id": "762260113",
                    "speaker": "Player",
                    "text": "原来只是连蒙带猜。"
                },
                {
                    "id": "762260114",
                    "speaker": "派蒙",
                    "text": "哼哼，学习外语哪有那么容易啦…"
                },
                {
                    "id": "762260115",
                    "speaker": "派蒙",
                    "text": "我需要一个好老师，等有机会，我要请哥伦比娅好好教教我。"
                }
            ]
        }
    ]
}