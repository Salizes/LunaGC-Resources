            "dialogues": []
        },
        {
            "id": "1910706",
            "objective": "与迪奥娜对话",
            "dialogues": []
        },
        {
            "id": "1910795",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191079501",
                    "speaker": "埃泽",
                    "text": "呃，您、您已经调制完了吗？真是…真是期待您的新作品啊…"
                },
                {
                    "id": "191079502",
                    "speaker": "康纳",
                    "text": "真不知道…您又会给我们带来怎么样的惊喜…"
                }
            ]
        },
        {
            "id": "1910797",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191079701",
                    "speaker": "康纳",
                    "text": "埃泽先生，可这样真的…"
                },
                {
                    "id": "191079702",
                    "speaker": "埃泽",
                    "text": "康纳，现在最重要的，是让小迪奥娜感受到我们的诚意，你明白吗？"
                },
                {
                    "id": "191079703",
                    "speaker": "康纳",
                    "text": "明、明白了，埃泽先生！"
                }
            ]
        },
        {
            "id": "1910798",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191079801",
                    "speaker": "埃泽",
                    "text": "康纳，你做得不错，继续保持这样，我们一定能把小迪奥娜请来晨曦酒庄做常驻调酒师！"
                },
                {
                    "id": "191079802",
                    "speaker": "康纳",
                    "text": "希望能够真的成功，我连着好几周蹲守，才换来了这么一次巧遇…一定要把握住这次机会。"
                },
                {
                    "id": "191079803",
                    "speaker": "埃泽",
                    "text": "真是辛苦你了，康纳。但只要能把小迪奥娜请来，我们付出的一切努力都是值得的，现在我们才迈出第一步。"
                },
                {
                    "id": "191079804",
                    "speaker": "埃泽",
                    "text": "记住，一定要让小迪奥娜感受到我们的诚意，我们的热情！但记住，千万不要过于猛烈…"
                },
                {
                    "id": "191079805",
                    "speaker": "康纳",
                    "text": "没问题，埃泽先生，这些我们俩都练过好多次了，这次一定…"
                },
                {
                    "id": "191079806",
                    "speaker": "Player",
                    "text": "你们在说什么呢…"
                },
                {
                    "id": "191079807",
                    "speaker": "埃泽",
                    "text": "啊？！没、没什么，我们正…讨论一些和酒庄生意相关的事，哈哈哈…"
                },
                {
                    "id": "191079808",
                    "speaker": "康纳",
                    "text": "是…对啊，我们正讨论酒庄生意的事呢，那个埃泽先生，我们再讨论一下最近酒庄的各项支出吧…"
                }
            ]
        },
        {
            "id": "1910799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191079901",
                    "speaker": "迪奥娜",
                    "text": "记住了，要用和康纳完全相反的调酒手法来调制，这样才能达到我…我们的目的。"
                }
            ]
        }
    ]
}