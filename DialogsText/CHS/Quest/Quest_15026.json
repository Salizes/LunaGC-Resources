    "talks": [
        {
            "id": "1502607",
            "objective": "前往烟谜主",
            "dialogues": [
                {
                    "id": "150260701",
                    "speaker": "派蒙",
                    "text": "欸？这里怎么有愚人众的人？"
                },
                {
                    "id": "150260702",
                    "speaker": "派蒙",
                    "text": "总觉得有点不放心啊…我们过去看看他们在做什么吧。"
                },
                {
                    "id": "150260703",
                    "speaker": "派蒙",
                    "text": "话说回来，他们这些人是怎么来到这里的？这里可是部族驻地啊。",
                    "choices": [
                        {
                            "id": "150260704",
                            "text": "考虑到「队长」的贡献…",
                            "response": [
                                {
                                    "id": "150260706",
                                    "speaker": "派蒙",
                                    "text": "哦…现在还留在纳塔的愚人众应该都是「队长」的部下吧？严格来说，他们也算是一位纳塔英雄的追随者呢。"
                                },
                                {
                                    "id": "150260707",
                                    "speaker": "派蒙",
                                    "text": "不过，我承认我对他们还是有偏见，在这里看到他们，总觉得很奇怪…可得好好问问！"
                                }
                            ]
                        },
                        {
                            "id": "150260705",
                            "text": "他们被允许来到这里也算正常。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502601",
            "objective": "盘问可疑的愚人众",
            "dialogues": [
                {
                    "id": "150260101",
                    "speaker": "派蒙",
                    "text": "咳咳…你们在这里做什么？"
                },
                {
                    "id": "150260102",
                    "speaker": "？？？",
                    "text": "哈？我们拿钱办事，有事请找雇主。"
                },
                {
                    "id": "150260103",
                    "speaker": "派蒙",
                    "text": "什么态度…话说愚人众接受雇佣的吗？"
                },
                {
                    "id": "150260104",
                    "speaker": "？？？",
                    "text": "咳咳！他是格洛德克，受我雇佣，负责在纳塔保护我的安全。看来他不太擅长待人接物，让两位见笑了。"
                },
                {
                    "id": "150260105",
                    "speaker": "？？？",
                    "text": "我本来想从纳塔的原住民当中雇佣人手，但一位祭司向我推荐了格洛德克和他的小队。"
                },
                {
                    "id": "150260106",
                    "speaker": "？？？",
                    "text": "说是他们最近正好闲着，战斗力也不错，很符合我的要求…听起来愚人众在纳塔的风评似乎还挺好的。"
                },
                {
                    "id": "150260107",
                    "speaker": "派蒙",
                    "text": "原来是这样啊…另外，你是枫丹人？"
                },
                {
                    "id": "150260108",
                    "speaker": "蒙吕松",
                    "text": "#在下蒙吕松，来自枫丹，主要做一些出版生意。两位…两位莫非就是那位旅行者和{M#他}{F#她}的精灵伙伴？"
                },
                {
                    "id": "150260109",
                    "speaker": "派蒙",
                    "text": "你知道我们？"
                },
                {
                    "id": "150260110",
                    "speaker": "蒙吕松",
                    "text": "金发的旅者，银色的飞行伙伴…不会错的。"
                },
                {
                    "id": "150260111",
                    "speaker": "蒙吕松",
                    "text": "两位在枫丹留下的事迹足以支撑起一个畅销书系列，我作为书商怎么会认不出两位？"
                },
                {
                    "id": "150260112",
                    "speaker": "派蒙",
                    "text": "#我们果然很有名啊，{NICKNAME}！"
                },
                {
                    "id": "150260113",
                    "speaker": "蒙吕松",
                    "text": "我的运气真不错——说起来有些唐突，其实我刚刚还在发愁要去哪里寻找两位呢，我有个不情之请…"
                },
                {
                    "id": "150260114",
                    "speaker": "派蒙",
                    "text": "怎么有种委托人从枫丹追到纳塔的感觉？又开心不起来了…"
                },
                {
                    "id": "150260115",
                    "speaker": "蒙吕松",
                    "text": "事成之后，必有重谢！"
                },
                {
                    "id": "150260116",
                    "speaker": "派蒙",
                    "text": "…这位倒是干脆，先听他讲讲？",
                    "choices": [
                        {
                            "id": "150260117",
                            "text": "哪次躲得掉？",
                            "response": [
                                {
                                    "id": "150260119",
                                    "speaker": "派蒙",
                                    "text": "咳咳…请问阁下有什么请求？"
                                },
                                {
                                    "id": "150260120",
                                    "speaker": "蒙吕松",
                                    "text": "两位认识茜特菈莉吧？我想麻烦两位请那位大萨满出山助我一臂之力！"
                                },
                                {
                                    "id": "150260121",
                                    "speaker": "派蒙",
                                    "text": "呃…让茜特菈莉帮陌生人办事，凭我们的交情也很难办到吧？"
                                },
                                {
                                    "id": "150260122",
                                    "speaker": "Player",
                                    "text": "那种性格，很难想象…"
                                },
                                {
                                    "id": "150260123",
                                    "speaker": "派蒙",
                                    "text": "说实话，她不太喜欢和陌生人打交道…"
                                },
                                {
                                    "id": "150260124",
                                    "speaker": "蒙吕松",
                                    "text": "这个我已经从烟谜主的族人那里打听到了，他们还告诉我，如果非要找出一个能够请她出山的人，那就只能是「金发的旅者」。"
                                },
                                {
                                    "id": "150260125",
                                    "speaker": "蒙吕松",
                                    "text": "只要两位能帮忙，报酬可以加倍！"
                                },
                                {
                                    "id": "150260126",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "150260127",
                                    "speaker": "Player",
                                    "text": "先问清楚是什么事吧。"
                                },
                                {
                                    "id": "150260128",
                                    "speaker": "派蒙",
                                    "text": "也对…请问你要找茜特菈莉帮忙做什么？我们至少要先了解一下。"
                                },
                                {
                                    "id": "150260129",
                                    "speaker": "蒙吕松",
                                    "text": "这个说来话长，涉及到烟谜主的一些历史…还是让专业人士来向两位说明吧——艾列尔，有劳了。"
                                },
                                {
                                    "id": "150260130",
                                    "speaker": "艾列尔",
                                    "text": "当然可以！平时很少有人愿意听我讲这些…初次见面，我是来自枫丹科学院的研究员，叫我艾列尔就好。"
                                },
                                {
                                    "id": "150260131",
                                    "speaker": "艾列尔",
                                    "text": "和大部分研究员不同，我对研究古代遗迹也很感兴趣，所以才有幸受邀加入蒙吕松先生的队伍。"
                                },
                                {
                                    "id": "150260132",
                                    "speaker": "艾列尔",
                                    "text": "不知道两位是否听说过传奇萨满维奇琳的事迹？",
                                    "choices": [
                                        {
                                            "id": "150260133",
                                            "text": "有些耳熟…",
                                            "response": [
                                                {
                                                    "id": "150260135",
                                                    "speaker": "艾列尔",
                                                    "text": "按照目前能收集到的纳塔史料，她生活在两百多年前，最擅长与色彩相关的秘术。"
                                                },
                                                {
                                                    "id": "150260136",
                                                    "speaker": "艾列尔",
                                                    "text": "而她的所有事迹中，最著名的就是传奇的「七彩之战」。"
                                                },
                                                {
                                                    "id": "150260137",
                                                    "speaker": "艾列尔",
                                                    "text": "传说那也是一场由深渊入侵而引发的战争，其惨烈程度即便放到整个纳塔战争史中也可以位居前列。"
                                                },
                                                {
                                                    "id": "150260138",
                                                    "speaker": "艾列尔",
                                                    "text": "神奇的是，纳塔一方在形势极其不利的情况下最终扭转了战局。而取胜的关键，正是维奇琳在战场上创造出的一种「色彩」。"
                                                },
                                                {
                                                    "id": "150260139",
                                                    "speaker": "艾列尔",
                                                    "text": "在传说中，这种「色彩」非常神奇，它虚幻缥缈，却又仿佛有实体，维奇琳就用它构筑了一座绚丽的迷宫。"
                                                },
                                                {
                                                    "id": "150260140",
                                                    "speaker": "艾列尔",
                                                    "text": "来势汹汹的敌人都被困在里面无法脱身，友军在维奇琳的引导下趁势反攻，并最终取得了胜利…"
                                                },
                                                {
                                                    "id": "150260141",
                                                    "speaker": "蒙吕松",
                                                    "text": "咳咳…把事情大概讲清楚就好，旅行者也不想被耽误太多时间，不是吗？"
                                                },
                                                {
                                                    "id": "150260142",
                                                    "speaker": "蒙吕松",
                                                    "text": "他刚刚讲的故事就是我来纳塔的原因，我喜欢收集其他国家的历史故事，编集成书，然后出版，这种书一直卖得不错。"
                                                },
                                                {
                                                    "id": "150260143",
                                                    "speaker": "蒙吕松",
                                                    "text": "最初听到这个故事，我就想把它也收录到接下来要出版的故事集里，但是…"
                                                },
                                                {
                                                    "id": "150260144",
                                                    "speaker": "蒙吕松",
                                                    "text": "纳塔的史料都不太详细，我的人甚至无法确认战场遗址的位置，也找不到其他能证明「七彩之战」发生过的证据。"
                                                },
                                                {
                                                    "id": "150260145",
                                                    "speaker": "蒙吕松",
                                                    "text": "甚至部分烟谜主的族人也不认可「七彩之战」的真实性，觉得它更像是一个被编撰出来的传说故事。"
                                                },
                                                {
                                                    "id": "150260146",
                                                    "speaker": "蒙吕松",
                                                    "text": "这样的话，不好收录啊。"
                                                },
                                                {
                                                    "id": "150260147",
                                                    "speaker": "派蒙",
                                                    "text": "欸？如果只是当成一个写进书里的故事，有必要寻找切实的证据吗？"
                                                },
                                                {
                                                    "id": "150260148",
                                                    "speaker": "蒙吕松",
                                                    "text": "我这个系列最大的卖点就是「复原真实的历史」，当然要有考据啊。"
                                                },
                                                {
                                                    "id": "150260149",
                                                    "speaker": "蒙吕松",
                                                    "text": "所以我才来到了这里，我听说烟谜主部族有记录历史的习惯，就想调查一下他们的史料。"
                                                },
                                                {
                                                    "id": "150260150",
                                                    "speaker": "蒙吕松",
                                                    "text": "结果那个什么「曜石祭场」根本不让进，申请了半天也只拿到一些普通的织卷，能研究出什么？明明我可以帮忙宣传他们的历史…"
                                                },
                                                {
                                                    "id": "150260151",
                                                    "speaker": "艾列尔",
                                                    "text": "据我研究，烟谜主的族民用织物来记录历史，这些织物在他们看来如同圣物，自然不肯轻易给外人看。"
                                                },
                                                {
                                                    "id": "150260152",
                                                    "speaker": "艾列尔",
                                                    "text": "另外，那些织卷包含的信息量其实很大，如果能让我仔细研究下…"
                                                },
                                                {
                                                    "id": "150260153",
                                                    "speaker": "蒙吕松",
                                                    "text": "艾列尔，我们之前不是已经谈过了吗？有更好的路子，就不必在这里浪费时间了。"
                                                },
                                                {
                                                    "id": "150260154",
                                                    "speaker": "派蒙",
                                                    "text": "更好的路子？难道…"
                                                },
                                                {
                                                    "id": "150260155",
                                                    "speaker": "蒙吕松",
                                                    "text": "嗯，两位想必也知道茜特菈莉是一位活了两百多年的大萨满，她亲身经历过「七彩之战」发生的时代！"
                                                },
                                                {
                                                    "id": "150260156",
                                                    "speaker": "蒙吕松",
                                                    "text": "能请她出山做顾问，还用得着研究史料？"
                                                },
                                                {
                                                    "id": "150260157",
                                                    "speaker": "派蒙",
                                                    "text": "原来如此…"
                                                },
                                                {
                                                    "id": "150260158",
                                                    "speaker": "蒙吕松",
                                                    "text": "两位意下如何？报酬再翻一倍也可以！"
                                                },
                                                {
                                                    "id": "150260159",
                                                    "speaker": "派蒙",
                                                    "text": "实在不是我们不想帮忙…",
                                                    "choices": [
                                                        {
                                                            "id": "150260160",
                                                            "text": "派蒙，我们有必要去一趟。",
                                                            "response": [
                                                                {
                                                                    "id": "150260162",
                                                                    "speaker": "派蒙",
                                                                    "text": "哦，对了！之前烟谜主的首领托付给我们的那个使命和维奇琳之间的关联很大。"
                                                                },
                                                                {
                                                                    "id": "150260163",
                                                                    "speaker": "派蒙",
                                                                    "text": "这个「七彩之战」背后，可能也有我们想要调查的线索？"
                                                                },
                                                                {
                                                                    "id": "150260164",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们可以帮这个忙，只是请让我们全权负责和茜特菈莉沟通。"
                                                                },
                                                                {
                                                                    "id": "150260165",
                                                                    "speaker": "蒙吕松",
                                                                    "text": "没问题！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "150260161",
                                                            "text": "我们还有一个未完成的使命。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150260134",
                                            "text": "那位与色彩有关的萨满…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150260118",
                            "text": "报酬给到位也行。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502602",
            "objective": "前往茜特菈莉的住处",
            "dialogues": [
                {
                    "id": "150260201",
                    "speaker": "蒙吕松",
                    "text": "这里就是那位大萨满的住处吗？也太偏远了些，帮我们指路的族民应该没骗人吧？"
                },
                {
                    "id": "150260202",
                    "speaker": "派蒙",
                    "text": "如果是茜特菈莉的话，住在这种地方倒也不奇怪吧。"
                },
                {
                    "id": "150260203",
                    "speaker": "艾列尔",
                    "text": "这墙上的涂鸦是那位大萨满的创作吗？或许和部族文化有关！如果能让我把这些涂鸦临摹下来的话…"
                },
                {
                    "id": "150260204",
                    "speaker": "蒙吕松",
                    "text": "艾列尔，办正事要紧。就像之前说好的那样，请两位帮忙接洽，我和其他人就在这里等候好了。"
                },
                {
                    "id": "150260205",
                    "speaker": "派蒙",
                    "text": "#嗯，{NICKNAME}，我们去敲门吧！希望她没有宿醉…"
                },
                {
                    "id": "150260206",
                    "speaker": "派蒙",
                    "text": "#茜特菈莉，你在家吗？{NICKNAME}和我有些事情要找你帮忙。"
                },
                {
                    "id": "150260207",
                    "speaker": "派蒙",
                    "text": "…没反应啊，难道她不在家？"
                },
                {
                    "id": "150260208",
                    "speaker": "Player",
                    "text": "试试另一个称呼？"
                },
                {
                    "id": "150260209",
                    "speaker": "派蒙",
                    "text": "哦，黑曜石奶奶，你在家吗？"
                },
                {
                    "id": "150260210",
                    "speaker": "Black Screen",
                    "text": "房门突然被打开，一股酒气扑面而来。"
                },
                {
                    "id": "150260211",
                    "speaker": "茜特菈莉",
                    "text": "小鬼，要找我挑战得提前预约…"
                },
                {
                    "id": "150260212",
                    "speaker": "Player",
                    "text": "（茜特菈莉平时这么宅的吗？）"
                },
                {
                    "id": "150260213",
                    "speaker": "茜特菈莉",
                    "text": "#…{NICKNAME}！"
                },
                {
                    "id": "150260214",
                    "speaker": "Black Screen",
                    "text": "房门又被猛地关闭。"
                },
                {
                    "id": "150260215",
                    "speaker": "派蒙",
                    "text": "…看来我们来得很不是时候。"
                },
                {
                    "id": "150260216",
                    "speaker": "茜特菈莉",
                    "text": "咳咳…你们还在吗？可以进来了…进来讲！"
                },
                {
                    "id": "150260217",
                    "speaker": "派蒙",
                    "text": "还好没有被拒绝…"
                }
            ]
        },
        {
            "id": "1502603",
            "objective": "进入茜特菈莉的住处",
            "dialogues": []
        },
        {
            "id": "1502604",
            "objective": "与茜特菈莉对话",
            "dialogues": [
                {
                    "id": "150260401",
                    "speaker": "派蒙",
                    "text": "呃…这就是茜特菈莉住的地方…"
                },
                {
                    "id": "150260402",
                    "speaker": "茜特菈莉",
                    "text": "我就知道一时半会儿根本收拾不完…想要吐槽也无所谓啦。奶奶我身为烟谜主的大萨满，从来不关注这些无聊的家务活。"
                },
                {
                    "id": "150260403",
                    "speaker": "茜特菈莉",
                    "text": "那种总是把房间收拾得干干净净的人，在轻小说里往往都当不上主角。"
                },
                {
                    "id": "150260404",
                    "speaker": "茜特菈莉",
                    "text": "另外，我那是看透世事的不修边幅，不是宅。"
                },
                {
                    "id": "150260405",
                    "speaker": "派蒙",
                    "text": "她似乎很在意自己在我们眼里的形象？"
                },
                {
                    "id": "150260406",
                    "speaker": "茜特菈莉",
                    "text": "对了，之前用法术将部分感官分享给你们的时候出现了一些副作用，你们摆脱那种副作用了吧？"
                },
                {
                    "id": "150260407",
                    "speaker": "茜特菈莉",
                    "text": "出于身为大萨满的责任，我必须再确认一下。"
                },
                {
                    "id": "150260408",
                    "speaker": "派蒙",
                    "text": "你是指能听到各自心声的事？没有没有，已经过去那么久了，不必再为这种事担心了吧？"
                },
                {
                    "id": "150260409",
                    "speaker": "茜特菈莉",
                    "text": "#那为什么我突然能听到{NICKNAME}的心声了…"
                },
                {
                    "id": "150260410",
                    "speaker": "派蒙",
                    "text": "什么？"
                },
                {
                    "id": "150260411",
                    "speaker": "Player",
                    "text": "（所以是因为听到了我在心里的评价吗？茜特菈莉应该更坦然一些才对吧，毕竟是「看透世事的不修边幅」啊…）"
                },
                {
                    "id": "150260412",
                    "speaker": "茜特菈莉",
                    "text": "我现在还能听到的！"
                },
                {
                    "id": "150260413",
                    "speaker": "Player",
                    "text": "如果有所冒犯，我道歉…"
                },
                {
                    "id": "150260414",
                    "speaker": "茜特菈莉",
                    "text": "少废话，我会想办法处理的。啧，之前是你能听到我的心声，现在是我能听到你的心声…"
                },
                {
                    "id": "150260415",
                    "speaker": "茜特菈莉",
                    "text": "只是一种用来分享感官的法术而已，到底是什么样的体质才能搞出这么复杂的副作用？"
                },
                {
                    "id": "150260416",
                    "speaker": "茜特菈莉",
                    "text": "罢了罢了，先说说你们来找我有什么事吧。"
                },
                {
                    "id": "150260417",
                    "speaker": "派蒙",
                    "text": "哦，是这样的。有人委托我们请你出山做顾问，他们想调查一些与纳塔历史有关的事。"
                },
                {
                    "id": "150260418",
                    "speaker": "茜特菈莉",
                    "text": "专门委托拯救了纳塔的英雄来请我？看来这些人明白奶奶我很讨厌麻烦事。"
                },
                {
                    "id": "150260419",
                    "speaker": "派蒙",
                    "text": "他们给的报酬很不错呢！"
                },
                {
                    "id": "150260420",
                    "speaker": "茜特菈莉",
                    "text": "我拒绝，我很忙。"
                },
                {
                    "id": "150260421",
                    "speaker": "派蒙",
                    "text": "怎么看都不像是很忙的样子啊…果然凭我们的交情也没法请她出面帮陌生人办事…"
                },
                {
                    "id": "150260422",
                    "speaker": "Player",
                    "text": "如果这也是我的请求呢？"
                },
                {
                    "id": "150260423",
                    "speaker": "茜特菈莉",
                    "text": "你的请求…"
                },
                {
                    "id": "150260424",
                    "speaker": "派蒙",
                    "text": "嗯，我们不久前被赋予了一项神圣的使命——帮助烟谜主制作记录历史大事件的特殊织物！"
                },
                {
                    "id": "150260425",
                    "speaker": "茜特菈莉",
                    "text": "欸？这一次被选中的人是你们？"
                },
                {
                    "id": "150260426",
                    "speaker": "派蒙",
                    "text": "#我和{NICKNAME}当初也很惊讶，毕竟我们根本不知道如何制作那种织物…"
                },
                {
                    "id": "150260427",
                    "speaker": "派蒙",
                    "text": "不过在首领庇兰的帮助下，还是获得了一些进展。"
                },
                {
                    "id": "150260428",
                    "speaker": "派蒙",
                    "text": "虽然最后没有成功，但至少我们知道制作这种织物的关键是一种特殊的色彩。"
                },
                {
                    "id": "150260429",
                    "speaker": "派蒙",
                    "text": "那些人想要调查的历史事件就与色彩有关，如果茜特菈莉能出山，或许也能帮到我们。"
                },
                {
                    "id": "150260430",
                    "speaker": "茜特菈莉",
                    "text": "……"
                },
                {
                    "id": "150260431",
                    "speaker": "派蒙",
                    "text": "茜特菈莉又摆出那种表情了，是我解释得不清楚吗？"
                },
                {
                    "id": "150260432",
                    "speaker": "茜特菈莉",
                    "text": "该说是超展开还是伏笔回收呢？"
                },
                {
                    "id": "150260433",
                    "speaker": "派蒙",
                    "text": "呃…我不太懂你在想什么，所以还是不方便吗？"
                },
                {
                    "id": "150260434",
                    "speaker": "茜特菈莉",
                    "text": "我…我必须慎重地考虑一下…"
                },
                {
                    "id": "150260435",
                    "speaker": "派蒙",
                    "text": "好像有戏哎！"
                },
                {
                    "id": "150260436",
                    "speaker": "格洛德克",
                    "text": "喂！还没谈好吗？来不来倒是给个准信啊！"
                },
                {
                    "id": "150260437",
                    "speaker": "派蒙",
                    "text": "这…说好了让我们来负责沟通的！"
                },
                {
                    "id": "150260438",
                    "speaker": "茜特菈莉",
                    "text": "啧…"
                },
                {
                    "id": "150260439",
                    "speaker": "派蒙",
                    "text": "茜特菈莉…"
                }
            ]
        },
        {
            "id": "1502605",
            "objective": "离开茜特菈莉的住处",
            "dialogues": []
        },
        {
            "id": "1502606",
            "objective": "追上茜特菈莉",
            "dialogues": [
                {
                    "id": "150260601",
                    "speaker": "蒙吕松",
                    "text": "格洛德克，付钱的人是我，陪同雇主等待也是你需要提供的服务吧？退下！"
                },
                {
                    "id": "150260602",
                    "speaker": "格洛德克",
                    "text": "明白。"
                },
                {
                    "id": "150260603",
                    "speaker": "蒙吕松",
                    "text": "几百岁的大萨满竟然如此…非常抱歉，惊扰到您了，这临时雇佣的部下果然不好约束。"
                },
                {
                    "id": "150260604",
                    "speaker": "派蒙",
                    "text": "呼…没惹得茜特菈莉动手，真是万幸。"
                },
                {
                    "id": "150260605",
                    "speaker": "蒙吕松",
                    "text": "既然您来了，不如我们就谈谈…"
                },
                {
                    "id": "150260606",
                    "speaker": "茜特菈莉",
                    "text": "打听过黑曜石奶奶是什么人物吗？你觉得我会被你们唱的双簧骗到？"
                },
                {
                    "id": "150260607",
                    "speaker": "蒙吕松",
                    "text": "这…"
                },
                {
                    "id": "150260608",
                    "speaker": "茜特菈莉",
                    "text": "我根本没打算和你谈，刚刚要做一个很重要的决定，但你的人打扰到我了。"
                },
                {
                    "id": "150260609",
                    "speaker": "茜特菈莉",
                    "text": "我出来就是为了告诉你，如果还有下一次，你们的下场会惨到恐怖小说都写不出来。"
                },
                {
                    "id": "150260610",
                    "speaker": "派蒙",
                    "text": "哇…"
                },
                {
                    "id": "150260611",
                    "speaker": "茜特菈莉",
                    "text": "#{NICKNAME}，我们回去继续谈。"
                },
                {
                    "id": "150260612",
                    "speaker": "蒙吕松",
                    "text": "黑曜石奶奶果然名不虚传，是我无礼了。不过，我真的很难想象，就连「七彩之战」也吸引不了您啊…"
                },
                {
                    "id": "150260613",
                    "speaker": "茜特菈莉",
                    "text": "你想调查的是「七彩之战」？"
                },
                {
                    "id": "150260614",
                    "speaker": "蒙吕松",
                    "text": "#原来{NICKNAME}还没有将此事向您讲明吗？"
                },
                {
                    "id": "150260615",
                    "speaker": "蒙吕松",
                    "text": "#其实我当初认为能请您出山，除了{NICKNAME}愿意帮我引荐之外，还因为我觉得查清这件事对您本身也很重要。"
                },
                {
                    "id": "150260616",
                    "speaker": "蒙吕松",
                    "text": "我听说那位名为维奇琳的大萨满曾是您的故旧，想必您十分了解她。"
                },
                {
                    "id": "150260617",
                    "speaker": "蒙吕松",
                    "text": "如果我能厘清与「七彩之战」有关的争议，证明它的真实性，就能把它收录到出版书籍里，让全提瓦特都了解这段传奇。"
                },
                {
                    "id": "150260618",
                    "speaker": "蒙吕松",
                    "text": "故友的光辉事迹借您之口重新流传于世，这也算是一段美谈，您意下如何？",
                    "choices": [
                        {
                            "id": "150260619",
                            "text": "这对我完成使命有帮助。",
                            "response": [
                                {
                                    "id": "150260621",
                                    "speaker": "茜特菈莉",
                                    "text": "其实你想完成使命的话…好吧，我先帮你调查一下。"
                                },
                                {
                                    "id": "150260622",
                                    "speaker": "蒙吕松",
                                    "text": "非常荣幸…"
                                },
                                {
                                    "id": "150260623",
                                    "speaker": "茜特菈莉",
                                    "text": "#少来，我可不打算接受你的雇佣。我决定帮的是{NICKNAME}，你们就顺便沾点光。"
                                },
                                {
                                    "id": "150260624",
                                    "speaker": "派蒙",
                                    "text": "茜特菈莉总算答应下来了…"
                                },
                                {
                                    "id": "150260625",
                                    "speaker": "Player",
                                    "text": "（看来我和茜特菈莉的交情还是挺管用的，她终究不是那种很绝情的人。）"
                                },
                                {
                                    "id": "150260626",
                                    "speaker": "茜特菈莉",
                                    "text": "我什么时候让你觉得是个绝情的人了？"
                                },
                                {
                                    "id": "150260627",
                                    "speaker": "蒙吕松",
                                    "text": "#无妨无妨，我本来就准备和{NICKNAME}合作。"
                                },
                                {
                                    "id": "150260628",
                                    "speaker": "蒙吕松",
                                    "text": "请问您亲身经历过「七彩之战」吗？您知道战场的遗址在哪里吗？现在还能不能找到一些可以证明那场战争发生过的遗物？"
                                },
                                {
                                    "id": "150260629",
                                    "speaker": "茜特菈莉",
                                    "text": "好吵…"
                                },
                                {
                                    "id": "150260630",
                                    "speaker": "蒙吕松",
                                    "text": "这…"
                                },
                                {
                                    "id": "150260631",
                                    "speaker": "Player",
                                    "text": "我也想问。"
                                },
                                {
                                    "id": "150260632",
                                    "speaker": "茜特菈莉",
                                    "text": "没有，不知道，不知道。"
                                },
                                {
                                    "id": "150260633",
                                    "speaker": "蒙吕松",
                                    "text": "呃…"
                                },
                                {
                                    "id": "150260634",
                                    "speaker": "茜特菈莉",
                                    "text": "我确实曾经和她生活在同一个时代，但这不代表我经历过与她有关的所有事件。我只是活得久了一些，又不是历史书。"
                                },
                                {
                                    "id": "150260635",
                                    "speaker": "茜特菈莉",
                                    "text": "调查方向你们自己定，如果涉及到我比较了解的地方，我可以给你们答疑解惑。"
                                },
                                {
                                    "id": "150260636",
                                    "speaker": "蒙吕松",
                                    "text": "…这样也好，虽然您不是「七彩之战」的亲历者，但您毕竟曾经生活在那个时代，您的意见肯定非常有用！"
                                },
                                {
                                    "id": "150260637",
                                    "speaker": "蒙吕松",
                                    "text": "艾列尔，你之前想好的调查方向是什么？"
                                },
                                {
                                    "id": "150260638",
                                    "speaker": "艾列尔",
                                    "text": "我的计划吗？我之前调查到烟谜主内部有专门负责记录历史的人，或许可以先向他们咨询一下。"
                                },
                                {
                                    "id": "150260639",
                                    "speaker": "蒙吕松",
                                    "text": "那就先按这个方向继续调查！"
                                },
                                {
                                    "id": "150260640",
                                    "speaker": "蒙吕松",
                                    "text": "#{NICKNAME}，我们正式合作吧，毕竟我只有通过你才能得到这位大萨满的帮助呢。"
                                },
                                {
                                    "id": "150260641",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                }
                            ]
                        },
                        {
                            "id": "150260620",
                            "text": "这对烟谜主也很有意义。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502650",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150265001",
                    "speaker": "艾列尔",
                    "text": "活了几百年的大萨满…如果真的能请她帮忙，或许还可以研究一下「七彩之战」以外的历史…"
                },
                {
                    "id": "150265002",
                    "speaker": "蒙吕松",
                    "text": "艾列尔，作为研究经费的拨款人，我还是希望你能专注于当下的任务，这对我很重要！"
                },
                {
                    "id": "150265003",
                    "speaker": "艾列尔",
                    "text": "抱歉，如果以后有机会的话…"
                },
                {
                    "id": "150265004",
                    "speaker": "蒙吕松",
                    "text": "以后的事情以后再说。"
                }
            ]
        },
        {
            "id": "1502699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150269999",
                    "speaker": "Black Screen",
                    "text": "茜特菈莉推门而出，你和派蒙急忙跟了出去。"
                }
            ]
        }
    ]
}