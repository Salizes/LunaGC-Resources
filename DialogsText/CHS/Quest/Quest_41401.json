    "talks": [
        {
            "id": "4140101",
            "objective": "与季同对话",
            "dialogues": [
                {
                    "id": "414010101",
                    "speaker": "季同",
                    "text": "奇了怪了，这架「留影机」是怎么回事…"
                },
                {
                    "id": "414010102",
                    "speaker": "Player",
                    "text": "这架「留影机」怎么了？"
                },
                {
                    "id": "414010103",
                    "speaker": "季同",
                    "text": "好像是坏了…还是什么，总之就是不灵了。"
                },
                {
                    "id": "414010104",
                    "speaker": "季同",
                    "text": "我之前在枫丹那边订了一批「留影机」。"
                },
                {
                    "id": "414010105",
                    "speaker": "季同",
                    "text": "卖「留影机」的人说，这批「留影机」是他们枫丹的最新技术。"
                },
                {
                    "id": "414010106",
                    "speaker": "季同",
                    "text": "说是可以让印出来的画有特殊的色调，带有特殊的效果什么的，我就买了一台过来想要试试。"
                },
                {
                    "id": "414010107",
                    "speaker": "季同",
                    "text": "结果不知道是我操作有问题，还是这台「留影机」本身就有问题，怎么弄都印不出来正常的画。"
                },
                {
                    "id": "414010108",
                    "speaker": "季同",
                    "text": "难道，真是我用这机器的方法有问题…"
                },
                {
                    "id": "414010109",
                    "speaker": "季同",
                    "text": "对了，你了解「留影机」吗？",
                    "choices": [
                        {
                            "id": "414010110",
                            "text": "还算是了解。",
                            "response": [
                                {
                                    "id": "414010111",
                                    "speaker": "季同",
                                    "text": "那太好了，能请你帮我个忙吗？"
                                },
                                {
                                    "id": "414010114",
                                    "speaker": "季同",
                                    "text": "看你的样子，是旅行者对吧？一定去过很地方，见识也很广。"
                                },
                                {
                                    "id": "414010115",
                                    "speaker": "季同",
                                    "text": "我想请你帮我用这台「留影机」去拍点「颜色」很强烈的东西。"
                                },
                                {
                                    "id": "414010116",
                                    "speaker": "季同",
                                    "text": "拍好了之后，请再把印出来的画拿给我，我想看看，这「留影机」到底是哪里出了问题…"
                                },
                                {
                                    "id": "414010117",
                                    "speaker": "季同",
                                    "text": "实在不行，我就拿着这些画去找那个人问问去。有这些画做证据，我也不怕他不认账。",
                                    "choices": [
                                        {
                                            "id": "414010118",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "414010119",
                                                    "speaker": "季同",
                                                    "text": "那就拜托你了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "414010120",
                                            "text": "什么叫做「颜色」很强烈的东西…",
                                            "response": [
                                                {
                                                    "id": "414010121",
                                                    "speaker": "季同",
                                                    "text": "唔，就是那种…色调特别明显的，比如红色的绝云椒椒啦，蓝色的冰雾花啦…"
                                                },
                                                {
                                                    "id": "414010122",
                                                    "speaker": "季同",
                                                    "text": "拍好了之后，就请把印出来的画拿来给我吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "414010112",
                            "text": "没接触过…",
                            "response": [
                                {
                                    "id": "414010113",
                                    "speaker": "季同",
                                    "text": "唔…倒也没关系，这东西的操作还算简单…能请你帮我个忙吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}