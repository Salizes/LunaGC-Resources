    "talks": [
        {
            "id": "1204601",
            "objective": "等待到第二天早上（8点到12点）",
            "dialogues": []
        },
        {
            "id": "1204602",
            "objective": "前往秋沙钱汤",
            "dialogues": [
                {
                    "id": "120460201",
                    "speaker": "派蒙",
                    "text": "瑞希，我们来预约下次的心理诊疗服务了…"
                },
                {
                    "id": "120460202",
                    "speaker": "百日白白音",
                    "text": "唔…"
                },
                {
                    "id": "120460203",
                    "speaker": "柴葉紫",
                    "text": "真难熬…"
                },
                {
                    "id": "120460204",
                    "speaker": "派蒙",
                    "text": "欸？这是怎么了？"
                },
                {
                    "id": "120460205",
                    "speaker": "蓝川丞",
                    "text": "一觉醒来，就变成了这个样子…"
                },
                {
                    "id": "120460206",
                    "speaker": "梦见月瑞希",
                    "text": "…是很严重的消化不良。"
                },
                {
                    "id": "120460207",
                    "speaker": "派蒙",
                    "text": "啊？难道白音和阿紫昨晚吃了很多噩梦？"
                },
                {
                    "id": "120460208",
                    "speaker": "蓝川丞",
                    "text": "#不会吧？昨天登记的客人除了{NICKNAME}和派蒙，就只剩下两个。"
                },
                {
                    "id": "120460209",
                    "speaker": "派蒙",
                    "text": "那两个人…"
                },
                {
                    "id": "120460210",
                    "speaker": "梦见月瑞希",
                    "text": "那两个人的噩梦有问题，影响食梦貘消化的因素除了噩梦的数量，还有噩梦的强度。"
                },
                {
                    "id": "120460211",
                    "speaker": "梦见月瑞希",
                    "text": "这种强度的噩梦，根本不是正常人应该有的。"
                },
                {
                    "id": "120460212",
                    "speaker": "百日白白音",
                    "text": "呕…"
                },
                {
                    "id": "120460213",
                    "speaker": "梦见月瑞希",
                    "text": "如果不能帮她们尽快消化噩梦的话…"
                },
                {
                    "id": "120460214",
                    "speaker": "派蒙",
                    "text": "接下来需要做什么？我们可以帮忙！"
                },
                {
                    "id": "120460215",
                    "speaker": "梦见月瑞希",
                    "text": "必须先找到那两名客人，了解他们产生噩梦的原因，我才能帮助白音和阿紫消化噩梦。"
                },
                {
                    "id": "120460216",
                    "speaker": "梦见月瑞希",
                    "text": "#{NICKNAME}，派蒙，你们昨天和他们交流过，有把握找到他们吗？"
                },
                {
                    "id": "120460217",
                    "speaker": "派蒙",
                    "text": "嗯…对了，他们说还要再找「江村一玄斋」接受一次指导，今天可能还会去那个地方！"
                },
                {
                    "id": "120460218",
                    "speaker": "梦见月瑞希",
                    "text": "请带我去。"
                }
            ]
        },
        {
            "id": "1204603",
            "objective": "前往「江村一玄斋」的营业地点",
            "dialogues": [
                {
                    "id": "120460301",
                    "speaker": "海彦",
                    "text": "今天出海，撒网的时候没注意，把那么大一张网给搞丢了，不过也无所谓，哈哈…"
                },
                {
                    "id": "120460302",
                    "speaker": "薄田",
                    "text": "我也搞砸了一件差事，但现在想想，放跑几个匪徒也没什么大不了的，哈哈…"
                },
                {
                    "id": "120460303",
                    "speaker": "派蒙",
                    "text": "喂，你们两个！就是因为你们的噩梦，阿紫和白音才变成那样！"
                },
                {
                    "id": "120460304",
                    "speaker": "薄田",
                    "text": "这个小家伙好生气啊，真有趣，哈哈…"
                },
                {
                    "id": "120460305",
                    "speaker": "海彦",
                    "text": "真有趣，哈哈…"
                },
                {
                    "id": "120460306",
                    "speaker": "派蒙",
                    "text": "这…"
                },
                {
                    "id": "120460307",
                    "speaker": "梦见月瑞希",
                    "text": "怎么了？"
                },
                {
                    "id": "120460308",
                    "speaker": "派蒙",
                    "text": "这两个人好奇怪啊，我都觉得自己刚刚的语气有些冲，结果他们一点也不生气。"
                },
                {
                    "id": "120460309",
                    "speaker": "梦见月瑞希",
                    "text": "…让我来。两位还记得昨晚前往秋沙钱汤进行梦境调理的事吗？"
                },
                {
                    "id": "120460310",
                    "speaker": "海彦",
                    "text": "有吗？"
                },
                {
                    "id": "120460311",
                    "speaker": "薄田",
                    "text": "没有吧？"
                },
                {
                    "id": "120460312",
                    "speaker": "梦见月瑞希",
                    "text": "这…两位最近有做噩梦吗？"
                },
                {
                    "id": "120460313",
                    "speaker": "薄田",
                    "text": "怎么会？这世界上什么东西能让人做噩梦？"
                },
                {
                    "id": "120460314",
                    "speaker": "海彦",
                    "text": "让我想想…完全没有啊，正常人怎么会做噩梦？看看海，赏赏花，人生就很美好了。"
                },
                {
                    "id": "120460315",
                    "speaker": "派蒙",
                    "text": "怎么回事？这两个人好像完全不记得昨晚的事啊。"
                },
                {
                    "id": "120460316",
                    "speaker": "派蒙",
                    "text": "不过，考虑到他们现在的状态，我真的很难想象他们会做噩梦…难道那个「江村一玄斋」真的没有骗人？"
                },
                {
                    "id": "120460317",
                    "speaker": "梦见月瑞希",
                    "text": "#不，这种心理状态很奇怪…{NICKNAME}，派蒙，请不要分神，我可能要采取一些特殊的手段。"
                },
                {
                    "id": "120460318",
                    "speaker": "派蒙",
                    "text": "这是…"
                },
                {
                    "id": "120460319",
                    "speaker": "梦见月瑞希",
                    "text": "我发现他们的潜意识都是游离状态，这让我可以借助与入梦类似的手段来到他们的潜意识里。"
                },
                {
                    "id": "120460320",
                    "speaker": "薄田",
                    "text": "可恶！可恶！绝不放过他们，绝不！"
                },
                {
                    "id": "120460321",
                    "speaker": "海彦",
                    "text": "风浪太大了，让我留在岸上吧…"
                },
                {
                    "id": "120460322",
                    "speaker": "派蒙",
                    "text": "欸！？"
                },
                {
                    "id": "120460323",
                    "speaker": "梦见月瑞希",
                    "text": "如你们所见，他们的「烦恼」并没有被消除。"
                },
                {
                    "id": "120460324",
                    "speaker": "梦见月瑞希",
                    "text": "这名薄田大概冲动易怒，这会让他在行动中做出很出格的举动，不免深受其扰。"
                },
                {
                    "id": "120460325",
                    "speaker": "梦见月瑞希",
                    "text": "而这位海彦，可能是因为某次劫后余生的经历而害怕风浪，不愿意出海，恐怕他的生计也因此受到了很大影响。"
                },
                {
                    "id": "120460326",
                    "speaker": "梦见月瑞希",
                    "text": "他们的负面情绪被强行从心智中隔离出来，游离在潜意识里，所以他们表现出来的只有「快乐」。"
                },
                {
                    "id": "120460327",
                    "speaker": "梦见月瑞希",
                    "text": "但是，这些被压抑的情绪会在潜意识里持续发酵，最终变成了阿紫她们无法消化的噩梦。"
                },
                {
                    "id": "120460328",
                    "speaker": "Player",
                    "text": "为什么会这样？"
                },
                {
                    "id": "120460329",
                    "speaker": "梦见月瑞希",
                    "text": "恐怕那个「江村一玄斋」没有我们想象的那么简单，或许他真的有能力影响到人类的情绪，所以那些人一直没有识破他…"
                },
                {
                    "id": "120460330",
                    "speaker": "梦见月瑞希",
                    "text": "你们昨天来的时候，有注意到什么异样的事吗？"
                },
                {
                    "id": "120460331",
                    "speaker": "派蒙",
                    "text": "那时候这两个人还蛮正经的。"
                },
                {
                    "id": "120460332",
                    "speaker": "Player",
                    "text": "非要说的话…"
                },
                {
                    "id": "120460333",
                    "speaker": "Black Screen",
                    "text": "你想起了昨天那个古怪的梦，将它描述给瑞希听。"
                },
                {
                    "id": "120460334",
                    "speaker": "派蒙",
                    "text": "还发生过这种事？"
                },
                {
                    "id": "120460335",
                    "speaker": "Player",
                    "text": "当时不太在意。"
                },
                {
                    "id": "120460336",
                    "speaker": "梦见月瑞希",
                    "text": "难道…我们必须尽快找到这个「江村一玄斋」！"
                },
                {
                    "id": "120460337",
                    "speaker": "派蒙",
                    "text": "瑞希，怎么突然…"
                },
                {
                    "id": "120460338",
                    "speaker": "梦见月瑞希",
                    "text": "我现在能确认那个「江村一玄斋」不是普通人类，那些接受过「指导」的人，都是他的受害者。"
                },
                {
                    "id": "120460339",
                    "speaker": "梦见月瑞希",
                    "text": "如果不能及时解决作为源头的「江村一玄斋」，这些受害者的人格都会受到不可逆的损害。"
                },
                {
                    "id": "120460340",
                    "speaker": "派蒙",
                    "text": "天呐…那也只能再问问这两个人了，请问你们知道「江村一玄斋」什么时候来这里吗？"
                },
                {
                    "id": "120460341",
                    "speaker": "薄田",
                    "text": "怎么突然又这么急？什么时候来有关系吗？"
                },
                {
                    "id": "120460342",
                    "speaker": "海彦",
                    "text": "什么时候来都行，哈哈…"
                },
                {
                    "id": "120460343",
                    "speaker": "派蒙",
                    "text": "气死我了！"
                },
                {
                    "id": "120460344",
                    "speaker": "梦见月瑞希",
                    "text": "其实你们记得昨晚发生的事吧？"
                },
                {
                    "id": "120460345",
                    "speaker": "梦见月瑞希",
                    "text": "你们不愿提起，是因为昨晚困扰你们的噩梦与你们现在的「快乐」是如此格格不入。"
                },
                {
                    "id": "120460346",
                    "speaker": "梦见月瑞希",
                    "text": "只要稍微回想一下，就有一种无法言明的割裂感，几乎要撕开你们的心智，对吗？"
                },
                {
                    "id": "120460347",
                    "speaker": "海彦",
                    "text": "…请不要再说了。只要不去想，一切都还好…"
                },
                {
                    "id": "120460348",
                    "speaker": "梦见月瑞希",
                    "text": "这就是「江村一玄斋」在你们身上留下的隐患，但我现在无意强行纠正你们的自我欺骗。"
                },
                {
                    "id": "120460349",
                    "speaker": "梦见月瑞希",
                    "text": "只要你们能好好回答刚才的问题。"
                },
                {
                    "id": "120460350",
                    "speaker": "薄田",
                    "text": "好吧…但是我们真的不知道，刚刚我们问过了，只知道他今天不会来。"
                },
                {
                    "id": "120460351",
                    "speaker": "海彦",
                    "text": "对，好像是因为昨天太累了？"
                },
                {
                    "id": "120460352",
                    "speaker": "梦见月瑞希",
                    "text": "又在故意避开我吗？"
                },
                {
                    "id": "120460353",
                    "speaker": "派蒙",
                    "text": "难道最后还是问不出有用的东西吗？"
                },
                {
                    "id": "120460354",
                    "speaker": "梦见月瑞希",
                    "text": "你们打听过那个「江村一玄斋」住在哪里吗？"
                },
                {
                    "id": "120460355",
                    "speaker": "派蒙",
                    "text": "昨天专门问过，帮他把门的人也不知道。"
                },
                {
                    "id": "120460356",
                    "speaker": "梦见月瑞希",
                    "text": "这样的话…",
                    "choices": [
                        {
                            "id": "120460357",
                            "text": "瑞希，现在的话…",
                            "response": [
                                {
                                    "id": "120460359",
                                    "speaker": "梦见月瑞希",
                                    "text": "现在的话，我了解了那两个人的噩梦，确实可以治好阿紫和白音。",
                                    "choices": [
                                        {
                                            "id": "120460360",
                                            "text": "那就先去治好她们。",
                                            "response": [
                                                {
                                                    "id": "120460362",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "…其实，你们带我来这里之后，我已经没有继续劳烦你们的理由了。"
                                                },
                                                {
                                                    "id": "120460363",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}和我还在期待下次的心理诊疗呢，要是瑞希一直为那个家伙的事担心，我们不知道什么时候才有机会。"
                                                },
                                                {
                                                    "id": "120460364",
                                                    "speaker": "派蒙",
                                                    "text": "所以，在瑞希能重新静下心来经营秋沙钱汤之前，我们一定会帮到底的！"
                                                },
                                                {
                                                    "id": "120460365",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "…阿紫和白音现在的情况容不得让我犹豫太久，只能再劳烦你们一次了。"
                                                },
                                                {
                                                    "id": "120460366",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "不过我有个请求，如果找到了「江村一玄斋」，盯紧他就好，请不要出手，先找其他人向我报信。"
                                                },
                                                {
                                                    "id": "120460367",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "总之，我不想让你们遭遇危险。"
                                                },
                                                {
                                                    "id": "120460368",
                                                    "speaker": "派蒙",
                                                    "text": "#不用担心啦，我和{NICKNAME}一起击败过那么多敌人，这个家伙可能都排不上号。"
                                                },
                                                {
                                                    "id": "120460369",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "派蒙？"
                                                },
                                                {
                                                    "id": "120460370",
                                                    "speaker": "派蒙",
                                                    "text": "好吧，我们肯定先给你报信。"
                                                },
                                                {
                                                    "id": "120460371",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "这就好，那我们都动身吧。"
                                                },
                                                {
                                                    "id": "120460372",
                                                    "speaker": "派蒙",
                                                    "text": "你是为了不让瑞希担心吧？但大话已经说出口，找不到那个家伙该怎么办？"
                                                },
                                                {
                                                    "id": "120460373",
                                                    "speaker": "派蒙",
                                                    "text": "这两个人…再问也问不出什么了。",
                                                    "choices": [
                                                        {
                                                            "id": "120460374",
                                                            "text": "他们肯定不知道。",
                                                            "response": [
                                                                {
                                                                    "id": "120460376",
                                                                    "speaker": "派蒙",
                                                                    "text": "神子？想起来了，我们昨天能找到这里来，就是因为听她随口提到了这个地址，看起来她手里有不少情报。"
                                                                },
                                                                {
                                                                    "id": "120460377",
                                                                    "speaker": "派蒙",
                                                                    "text": "事不宜迟，我们这就去鸣神大社！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120460375",
                                                            "text": "但神子应该知道。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120460361",
                                            "text": "我来负责找到「江村一玄斋」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120460358",
                            "text": "可以治好阿紫和白音了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204604",
            "objective": "前往鸣神大社寻找神子",
            "dialogues": [
                {
                    "id": "120460401",
                    "speaker": "派蒙",
                    "text": "神子平时应该在这里吧？"
                },
                {
                    "id": "120460402",
                    "speaker": "八重神子",
                    "text": "小家伙们，求签，还是访友？"
                },
                {
                    "id": "120460403",
                    "speaker": "派蒙",
                    "text": "哇！什么时候…"
                },
                {
                    "id": "120460404",
                    "speaker": "Player",
                    "text": "好久不见，宫司大人。"
                },
                {
                    "id": "120460405",
                    "speaker": "八重神子",
                    "text": "这语气怎么有点像我那个老朋友…不要客套了，看你们的样子，有急事吧？",
                    "choices": [
                        {
                            "id": "120460406",
                            "text": "想打听个人。",
                            "response": [
                                {
                                    "id": "120460408",
                                    "speaker": "八重神子",
                                    "text": "我昨天的提示那么明显，你们还没找到人？"
                                },
                                {
                                    "id": "120460409",
                                    "speaker": "派蒙",
                                    "text": "你昨天果然是故意那么说的？"
                                },
                                {
                                    "id": "120460410",
                                    "speaker": "八重神子",
                                    "text": "…先别管这个，既然来求人帮忙，至少先向我说明下情况吧？"
                                },
                                {
                                    "id": "120460411",
                                    "speaker": "派蒙",
                                    "text": "好吧，我们昨天去过那个地址，可惜没有抓住机会。"
                                },
                                {
                                    "id": "120460412",
                                    "speaker": "派蒙",
                                    "text": "现在那个家伙已经不在那里露面了，据说是在避世清修，我们根本不知道去哪里找…"
                                },
                                {
                                    "id": "120460413",
                                    "speaker": "八重神子",
                                    "text": "唉…明明找到昨天那个地址就已经很不容易了。"
                                },
                                {
                                    "id": "120460414",
                                    "speaker": "派蒙",
                                    "text": "如果需要的话，我们这边也有些新的情报。那个「江村一玄斋」可能是瑞希接待过的一名客人，我记得是叫江村中弥来着…"
                                },
                                {
                                    "id": "120460415",
                                    "speaker": "八重神子",
                                    "text": "哈？那个家伙？"
                                },
                                {
                                    "id": "120460416",
                                    "speaker": "派蒙",
                                    "text": "神子知道？"
                                },
                                {
                                    "id": "120460417",
                                    "speaker": "八重神子",
                                    "text": "我让八重堂举办那次读者来信活动，本来是想找同好聊一些有趣的事情，结果这个家伙蹦了出来…"
                                },
                                {
                                    "id": "120460418",
                                    "speaker": "八重神子",
                                    "text": "传播烦恼的家伙和消除烦恼的大师，也能是同一个人？"
                                },
                                {
                                    "id": "120460419",
                                    "speaker": "派蒙",
                                    "text": "从我们之前的调查来看，确实有这种可能性。"
                                },
                                {
                                    "id": "120460420",
                                    "speaker": "八重神子",
                                    "text": "好吧，如果你们想找这个人，可以去这个地址试试。"
                                },
                                {
                                    "id": "120460421",
                                    "speaker": "派蒙",
                                    "text": "这个地址…这真是住人的地方吗？"
                                },
                                {
                                    "id": "120460422",
                                    "speaker": "八重神子",
                                    "text": "他曾经在八重堂一口气订购了几十本小说，然后留了这个收货地址，还要求到付。"
                                },
                                {
                                    "id": "120460423",
                                    "speaker": "八重神子",
                                    "text": "仓库那边以为是恶作剧，就拒绝了这个订单，结果这件事还被他在那封读者来信中专门骂了一遍。"
                                },
                                {
                                    "id": "120460424",
                                    "speaker": "八重神子",
                                    "text": "现在想想，这种性格的家伙，还真就只能住在那种地方。"
                                },
                                {
                                    "id": "120460425",
                                    "speaker": "派蒙",
                                    "text": "确实…来找神子果然没错！"
                                },
                                {
                                    "id": "120460426",
                                    "speaker": "八重神子",
                                    "text": "能帮上我那个老朋友就好。"
                                },
                                {
                                    "id": "120460427",
                                    "speaker": "派蒙",
                                    "text": "所以你还是想帮她的吧？"
                                },
                                {
                                    "id": "120460428",
                                    "speaker": "八重神子",
                                    "text": "我看得出来瑞希对秋沙钱汤这份产业的投入很大，现在秋沙钱汤遇到了困难，我作为朋友自然要关心一下。"
                                },
                                {
                                    "id": "120460429",
                                    "speaker": "派蒙",
                                    "text": "看你昨天的样子，我还以为你是去吵架的…"
                                },
                                {
                                    "id": "120460430",
                                    "speaker": "八重神子",
                                    "text": "瑞希应该和你们说过，我和她之间存在竞争关系吧？"
                                },
                                {
                                    "id": "120460431",
                                    "speaker": "八重神子",
                                    "text": "从同窗时期开始，她就一直这么认为。现在我是鸣神大社的宫司，她肯定也想通过秋沙钱汤证明自己。"
                                },
                                {
                                    "id": "120460432",
                                    "speaker": "八重神子",
                                    "text": "要是这种生死攸关的经营问题都必须靠我帮忙解决…我总该考虑一下老朋友的心情。"
                                },
                                {
                                    "id": "120460433",
                                    "speaker": "Player",
                                    "text": "难得见你这么体贴。"
                                },
                                {
                                    "id": "120460434",
                                    "speaker": "八重神子",
                                    "text": "就当你是在夸我吧。我这个老朋友习惯了体贴别人，也总该有人来体贴她一下。",
                                    "choices": [
                                        {
                                            "id": "120460435",
                                            "text": "你不方便的话…",
                                            "response": [
                                                {
                                                    "id": "120460437",
                                                    "speaker": "八重神子",
                                                    "text": "小家伙，一点就透嘛——你们来的时候很急，还有时间闲聊吗？"
                                                },
                                                {
                                                    "id": "120460438",
                                                    "speaker": "派蒙",
                                                    "text": "哦哦，我们快通知瑞希吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120460436",
                                            "text": "我来帮她吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120460407",
                            "text": "请问那个「江村一玄斋」在哪？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204605",
            "objective": "(test)返回秋沙钱汤找瑞希",
            "dialogues": [
                {
                    "id": "120460501",
                    "speaker": "梦见月瑞希",
                    "text": "(test)返回秋沙钱汤找瑞希"
                },
                {
                    "id": "120460502",
                    "speaker": "梦见月瑞希",
                    "text": "(test)瑞希已经用自己的力量帮助了大小女仆很多，她要独自面对那个妖怪"
                },
                {
                    "id": "120460503",
                    "speaker": "梦见月瑞希",
                    "text": "(test)我们当然绝对不能允许这种事情发生"
                },
                {
                    "id": "120460504",
                    "speaker": "梦见月瑞希",
                    "text": "(test)经过一番我们对瑞希的劝阻，大家决定一起去找求福了。"
                }
            ]
        },
        {
            "id": "1204630",
