            "dialogues": [
                {
                    "id": "120463001",
                    "speaker": "百日白白音",
                    "text": "工作该怎么办…"
                }
            ]
        },
        {
            "id": "1204632",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120463201",
                    "speaker": "柴葉紫",
                    "text": "唔，倒霉催的…"
                }
            ]
        },
        {
            "id": "1204633",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120463301",
                    "speaker": "蓝川丞",
                    "text": "请放心，这边就先交给我了。"
                }
            ]
        }
    ]
