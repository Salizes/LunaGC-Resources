    "talks": [
        {
            "id": "302301",
            "objective": "（test）隐藏子任务带闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "30230101",
                    "speaker": "赛诺",
                    "text": "…过去，我从没想过神明也会遭遇不幸。"
                },
                {
                    "id": "30230102",
                    "speaker": "赛诺",
                    "text": "假如有什么办法能改变这一切…这个国家会因此变得更好吗？"
                }
            ]
        },
        {
            "id": "302302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30230201",
                    "speaker": "艾尔海森",
                    "text": "别着急。这么大的事，不可能马上准备完毕。"
                },
                {
                    "id": "30230202",
                    "speaker": "艾尔海森",
                    "text": "慢慢想，保证计划的合理性。"
                },
                {
                    "id": "30230203",
                    "speaker": "派蒙",
                    "text": "说着又开始看书了，喂！你这个人！"
                },
                {
                    "id": "30230204",
                    "speaker": "艾尔海森",
                    "text": "要我借本书给你吗？"
                },
                {
                    "id": "30230205",
                    "speaker": "派蒙",
                    "text": "不要啦，你的书都不适合我…"
                },
                {
                    "id": "30230206",
                    "speaker": "艾尔海森",
                    "text": "骗你的。我的书确实不适合你，恕不外借。"
                },
                {
                    "id": "30230207",
                    "speaker": "派蒙",
                    "text": "啊——！气死我了…"
                }
            ]
        },
        {
            "id": "302303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30230301",
                    "speaker": "坎蒂丝",
                    "text": "如果有什么我能为你们做的，一定要告诉我。"
                },
                {
                    "id": "30230302",
                    "speaker": "坎蒂丝",
                    "text": "虽然无法离开阿如村，但看到你们的样子，不知为什么…我心跳加速了。"
                },
                {
                    "id": "30230303",
                    "speaker": "坎蒂丝",
                    "text": "过去独自一人面对战斗，我都没有像今天这样沸腾…"
                },
                {
                    "id": "30230304",
                    "speaker": "坎蒂丝",
                    "text": "我想，这就是同伴的力量吧。"
                }
            ]
        },
        {
            "id": "302304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30230401",
                    "speaker": "迪希雅",
                    "text": "最近这些差事，难度可不小。"
                },
                {
                    "id": "30230402",
                    "speaker": "迪希雅",
                    "text": "而且，这么高难度的工作竟然不会带来经济收益，真不敢相信。"
                },
                {
                    "id": "30230403",
                    "speaker": "派蒙",
                    "text": "往好处想，说不定事成就发财了呢！"
                },
                {
                    "id": "30230404",
                    "speaker": "迪希雅",
                    "text": "说得也是，唔，如果你一夜之间变成富翁，想做什么？"
                },
                {
                    "id": "30230405",
                    "speaker": "派蒙",
                    "text": "我想买很多很多好吃的！"
                },
                {
                    "id": "30230406",
                    "speaker": "迪希雅",
                    "text": "就这样？"
                },
                {
                    "id": "30230407",
                    "speaker": "派蒙",
                    "text": "唔…再买点好喝的？"
                },
                {
                    "id": "30230408",
                    "speaker": "迪希雅",
                    "text": "哈哈哈，好可爱啊。"
                },
                {
                    "id": "30230409",
                    "speaker": "迪希雅",
                    "text": "那么，为了这些美好的幻想…我也会帮忙的。"
                },
                {
                    "id": "30230410",
                    "speaker": "迪希雅",
                    "text": "希望接下去我们要做的一切都能让这个世界变好。"
                }
            ]
        }
    ]
}