            "dialogues": [
                {
                    "id": "617830801",
                    "speaker": "Player",
                    "text": "会。"
                },
                {
                    "id": "617830802",
                    "speaker": "菲乐丝",
                    "text": "那能劳烦你帮忙做一道「奶油鲑鱼汤」吗？今天来的客人点名要这道菜，说是想回味一下「过去」。"
                },
                {
                    "id": "617830803",
                    "speaker": "菲乐丝",
                    "text": "但我…都快要忘记「过去」的味道了。能否请你帮个忙呢，报酬绝对让你满意。"
                }
            ]
        },
        {
            "id": "7083402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7083403",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "708340301",
                    "speaker": "菲乐丝",
                    "text": "这个香味，这个色泽…真是让人怀念。我这就去给那位客人送过去。"
                },
                {
                    "id": "708340302",
                    "speaker": "菲乐丝",
                    "text": "有了这回的印象，下一次应该不用再麻烦你了。多谢呢，旅行者。"
                }
            ]
        },
        {
            "id": "7083404",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "618010801",
                    "speaker": "Player",
                    "text": "关于这里的菜品…"
                },
                {
                    "id": "618010802",
                    "speaker": "洛恩",
                    "text": "嗯…都是些蒙德常见的菜，不过今天我点了一道「奶油鲑鱼汤」。"
                },
                {
                    "id": "618010803",
                    "speaker": "洛恩",
                    "text": "真没想到，店家还真能端上连我都挑不出毛病的菜品…呵，会不会是换厨子了？"
                }
            ]
