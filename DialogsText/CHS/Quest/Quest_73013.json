        "rewards_formatted": "冒险阅历 x300, 原石 x40, 摩拉 x30000, 大英雄的经验 x3",
        "chapter": {
            "icon": "UI_ChapterIcon_Common",
            "id": "10069",
            "num": "",
            "title": "愿为一炊之梦"
        },
        "total_dialogue_lines": 140,
        "total_speaker_counts": {
            "Player": 24,
            "兰帕卡提": 58,
            "兰罗摩": 10,
            "兰茶荼": 4,
            "兰萨卡": 4,
            "兰阿帕斯": 3,
