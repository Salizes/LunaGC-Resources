        }
    },
    "talks": [
        {
            "id": "7301301",
            "objective": "",
            "dialogues": [
                {
                    "id": "730130101",
                    "speaker": "兰帕卡提",
                    "text": "呀！是金色的那菈。噫…"
                },
                {
                    "id": "730130102",
                    "speaker": "兰罗摩",
                    "text": "#兰帕卡提不害怕。那菈{NICKNAME}是好那菈，和故事里的那个那菈一样。那菈{NICKNAME}和派蒙，帮助了大家许多。"
                },
                {
                    "id": "730130103",
                    "speaker": "兰帕卡提",
                    "text": "#嗯，不害怕了。兰罗摩，兰帕卡提相信你，也相信草、叶子和种子说的话，明白是好那菈。你们好，那菈{NICKNAME}和派蒙。"
                },
                {
                    "id": "730130104",
                    "speaker": "派蒙",
                    "text": "兰帕卡提，你好！",
                    "choices": [
                        {
                            "id": "730130105",
                            "text": "其实我是坏人。",
                            "response": [
                                {
                                    "id": "730130106",
                                    "speaker": "派蒙",
                                    "text": "喂！别开这种玩笑！"
                                },
                                {
                                    "id": "730130107",
                                    "speaker": "兰帕卡提",
                                    "text": "不是的。兰帕卡提知道。"
                                },
                                {
                                    "id": "730130108",
                                    "speaker": "兰帕卡提",
                                    "text": "#很多风的地方，有小小的种子。它们和那菈一起来到桓那兰那。它们说，那菈{NICKNAME}很好。"
                                },
                                {
                                    "id": "730130109",
                                    "speaker": "派蒙",
                                    "text": "之前兰罗摩也说过类似的话呢！这么说来，很多风的地方来的种子…是指蒲公英吗？",
                                    "choices": [
                                        {
                                            "id": "730130110",
                                            "text": "也可能是风车菊。",
                                            "response": [
                                                {
                                                    "id": "730130115",
                                                    "speaker": "兰罗摩",
                                                    "text": "#那菈{NICKNAME}要帮助兰拉娜，结出惟耶之实。所以，我们要一起为无忧节做准备。"
                                                },
                                                {
                                                    "id": "730130116",
                                                    "speaker": "兰帕卡提",
                                                    "text": "哎呀呀…无忧节…"
                                                },
                                                {
                                                    "id": "730130117",
                                                    "speaker": "兰罗摩",
                                                    "text": "兰帕卡提的样子好奇怪。有什么烦恼的事情吗？"
                                                },
                                                {
                                                    "id": "730130118",
                                                    "speaker": "兰帕卡提",
                                                    "text": "兰帕卡提的「哥哥」们，一直没有回到桓那兰那。如果他们不回来，我们「兄妹」就不能一起过无忧节…"
                                                },
                                                {
                                                    "id": "730130119",
                                                    "speaker": "兰罗摩",
                                                    "text": "我也很久没在桓那兰那遇到兰茶荼、兰萨卡、兰阿帕斯和兰非拉了。自从上次那次事情以后，就一直没见到。"
                                                },
                                                {
                                                    "id": "730130120",
                                                    "speaker": "派蒙",
                                                    "text": "很久…是有多久呀？"
                                                },
                                                {
                                                    "id": "730130121",
                                                    "speaker": "兰帕卡提",
                                                    "text": "那是很多很多个月亮以前。幼苗才刚刚钻出土。到现在，幼苗已经长成了能为兰那罗遮雨的大树，有七个兰帕卡提那么高。"
                                                },
                                                {
                                                    "id": "730130122",
                                                    "speaker": "派蒙",
                                                    "text": "从种子长成大树…哇！那岂不是已经过去好久好久了！兰帕卡提的哥哥们失踪了吗？"
                                                },
                                                {
                                                    "id": "730130123",
                                                    "speaker": "兰帕卡提",
                                                    "text": "「失踪」？是一种种子吗？"
                                                },
                                                {
                                                    "id": "730130124",
                                                    "speaker": "兰罗摩",
                                                    "text": "哦哦！原来那菈的种子，叫失踪。好厉害！"
                                                },
                                                {
                                                    "id": "730130125",
                                                    "speaker": "兰帕卡提",
                                                    "text": "#那菈好厉害！那菈{NICKNAME}一定有好多好多的失踪。"
                                                },
                                                {
                                                    "id": "730130126",
                                                    "speaker": "派蒙",
                                                    "text": "不是这个意思啦…",
                                                    "choices": [
                                                        {
                                                            "id": "730130127",
                                                            "text": "「不知道到哪去了」的意思。",
                                                            "response": [
                                                                {
                                                                    "id": "730130128",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "噢。不是这样的。兰帕卡提知道兰茶荼、兰萨卡、兰阿帕斯和兰非拉在哪里。所以，哥哥没有失踪。"
                                                                },
                                                                {
                                                                    "id": "730130129",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "他们到桓那兰那外修行了好久好久。「烹饪修行」。"
                                                                },
                                                                {
                                                                    "id": "730130136",
                                                                    "speaker": "派蒙",
                                                                    "text": "原来如此，是「烹饪修行」吗…"
                                                                },
                                                                {
                                                                    "id": "730130137",
                                                                    "speaker": "Player",
                                                                    "text": "听着像是派蒙会感兴趣的东西…"
                                                                },
                                                                {
                                                                    "id": "730130138",
                                                                    "speaker": "派蒙",
                                                                    "text": "#哼哼！派蒙对「{NICKNAME}的烹饪修行」更感兴趣！"
                                                                },
                                                                {
                                                                    "id": "730130139",
                                                                    "speaker": "派蒙",
                                                                    "text": "所以，「烹饪修行」究竟是…"
                                                                },
                                                                {
                                                                    "id": "730130140",
                                                                    "speaker": "兰罗摩",
                                                                    "text": "那是上次无忧节的故事。那时候，那菈做了很多很多「菜肴」，给兰那罗们品尝。"
                                                                },
                                                                {
                                                                    "id": "730130141",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "所以，兰茶荼他们为了这次无忧节，能够给那菈做「菜肴」，就一直在「烹饪修行」。"
                                                                },
                                                                {
                                                                    "id": "730130142",
                                                                    "speaker": "派蒙",
                                                                    "text": "…突然期待起无忧节了！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730130143",
                                                                            "text": "但那是兰那罗的饭菜…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730130144",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "美食是所有生物共同的语言！没问题的！"
                                                                                },
                                                                                {
                                                                                    "id": "730130146",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过，既然兰帕卡提知道他们在哪，为什么不自己去找呢？"
                                                                                },
                                                                                {
                                                                                    "id": "730130147",
                                                                                    "speaker": "兰帕卡提",
                                                                                    "text": "盛大的无忧节即将举办，兰帕卡提也要做很多、很多的准备。没有时间去找。"
                                                                                },
                                                                                {
                                                                                    "id": "730130148",
                                                                                    "speaker": "兰帕卡提",
                                                                                    "text": "为了无忧节离开桓那兰那烹饪修行。但是不知道无忧节快要到来。兰茶荼、兰萨卡、兰阿帕斯、兰非拉，笨蛋。"
                                                                                },
                                                                                {
                                                                                    "id": "730130149",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#那就交给我们吧！反正我们和兰罗摩也要为无忧节做准备，找回森林里的兰那罗。对吧，{NICKNAME}？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "730130150",
                                                                                            "text": "交给我们吧。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "730130152",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "可是我们要怎么找到兰茶荼、兰…兰什么来着？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130153",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "兰茶荼、兰萨卡、兰阿帕斯、兰非拉。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130154",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "呜哇，一想到还有兰拉娜、兰罗摩、兰拉迦、兰帕卡提…兰那罗的名字怎么这么难记！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130155",
                                                                                                    "speaker": "兰罗摩",
                                                                                                    "text": "派蒙，不要说兰那罗的名字不好。不然，兰那罗会伤心的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130156",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好啦，我知道了。所以说，我们要怎么找到他们呢？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130157",
                                                                                                    "speaker": "兰罗摩",
                                                                                                    "text": "他们以前在桓那兰那烹饪修行。结果，弄出好多好多烟。所以，兰帕卡提把他们赶出去了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130158",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "当时，大家都好害怕，还有的兰那罗吓得休眠了。幸好兰罗摩勇敢，惩罚了烟。兰帕卡提很生气，所以让他们出去。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130159",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "在林子里，看到<color=#00E1FFFF>袅袅升起的烟柱</color>，就能找到他们。应该吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130160",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "原来是你把他们撵走的喔！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130161",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "嗯。不对吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130162",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#倒也没有啦…总之，{NICKNAME}，我们出发吧！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130163",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "啊。对了。还有一件事。如果哥哥们变得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪叽」他们。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130164",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "以前，他们弄出好多好多烟。整个桓那兰那都是烟。他们也害怕，到处乱跑。有时候，如果碰到奇怪的蘑菇，也会变成那样。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130165",
                                                                                                    "speaker": "兰帕卡提",
                                                                                                    "text": "但是，兰那罗是草木的精灵。所以，只要吸收<color=#00E1FFFF>草元素的力量</color>，就能恢复、清醒。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "730130166",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#我明白了。{NICKNAME}只要吃甜甜花酿鸡，就能恢复。所以是甜甜花酿鸡的精灵。嗯！很有道理。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "730130167",
                                                                                                            "text": "？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "730130168",
                                                                                                                    "speaker": "兰罗摩",
                                                                                                                    "text": "？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "730130169",
                                                                                                                    "speaker": "兰帕卡提",
                                                                                                                    "text": "？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "730130170",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "…总之，我们出发吧！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "730130172",
                                                                                                                    "speaker": "兰罗摩",
                                                                                                                    "text": "#那菈{NICKNAME}和派蒙加油！"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "730130171",
                                                                                                            "text": "总之，出发吧。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "730130151",
                                                                                            "text": "哦。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730130145",
                                                                            "text": "好期待！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730130130",
                                                            "text": "我明白你的心情…",
                                                            "response": [
                                                                {
                                                                    "id": "730130131",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "#那菈{NICKNAME}也明白我的心情？"
                                                                },
                                                                {
                                                                    "id": "730130132",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯，{NICKNAME}也有失散的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…"
                                                                },
                                                                {
                                                                    "id": "730130133",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "#噢。那菈{NICKNAME}的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}也去「烹饪修行」了吗？"
                                                                },
                                                                {
                                                                    "id": "730130134",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？感觉有些地方搞错了…失踪就是，「不知道到哪去了」的意思！"
                                                                },
                                                                {
                                                                    "id": "730130135",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "噢。不是这样的。兰帕卡提知道哥哥们没有失踪。他们到桓那兰那外修行了好久好久。「烹饪修行」。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730130111",
                                            "text": "也可能是松果。"
                                        },
                                        {
                                            "id": "730130112",
                                            "text": "难道是风带来了故事的种子…",
                                            "response": [
                                                {
                                                    "id": "730130113",
                                                    "speaker": "派蒙",
                                                    "text": "？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730130114",
                            "text": "你好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301302",
            "objective": "",
            "dialogues": [
                {
                    "id": "730130201",
                    "speaker": "兰帕卡提",
                    "text": "…和那菈说话，好困难。而且，好高喔。"
                },
                {
                    "id": "730130202",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "730130203",
                    "speaker": "兰帕卡提",
                    "text": "#噫！是那菈{NICKNAME}…"
                },
                {
                    "id": "730130204",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提不害怕。而且，哥哥们胆子大，一定也不害怕。"
                },
                {
                    "id": "730130205",
                    "speaker": "兰帕卡提",
                    "text": "只要跟着<color=#00E1FFFF>烟柱</color>，应该就能找到他们。如果变得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪叽」他们。"
                }
            ]
        },
        {
            "id": "7301303",
            "objective": "向兰帕卡提回报",
            "dialogues": [
                {
                    "id": "730130301",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提现在可是非常生气，哎呀呀，比非常生气还要生气一点！"
                },
                {
                    "id": "730130302",
                    "speaker": "兰帕卡提",
                    "text": "森林里面多危险呀，「无留陀」在森林里肆虐。出发的时候，兰帕卡提还特意叮嘱几位哥哥要团结一心…"
                },
                {
                    "id": "730130303",
                    "speaker": "兰帕卡提",
                    "text": "结果刚出门就大吵了一架，兰茶荼，你自己还吃了奇怪的东西。"
                },
                {
                    "id": "730130304",
                    "speaker": "兰茶荼",
                    "text": "呜呜…"
                },
                {
                    "id": "730130305",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提决定，在十次日落果成熟的时间里，兰茶荼都不准采蘑菇了。"
                },
                {
                    "id": "730130306",
                    "speaker": "兰茶荼",
                    "text": "怎么这样…呜呜…"
                },
                {
                    "id": "730130307",
                    "speaker": "兰非拉",
                    "text": "就是，要是把坏孢子带进来了，让蘑菇怪物长出来，那怎么行嘛。"
                },
                {
                    "id": "730130308",
                    "speaker": "兰帕卡提",
                    "text": "兰非拉哥哥也是，跑到离桓那兰那那么远的地方去采果子。那边有好坏好坏的东西！兰拉迦也特地说过的！"
                },
                {
                    "id": "730130309",
                    "speaker": "兰非拉",
                    "text": "呜呜…"
                },
                {
                    "id": "730130310",
                    "speaker": "兰阿帕斯",
                    "text": "就是就是。果实也要喝水，兰那罗也要喝水。所以，水是最好的。"
                },
                {
                    "id": "730130311",
                    "speaker": "兰帕卡提",
                    "text": "兰阿帕斯哥哥，你非得去「法留纳神机」找水。难道不知道，就连那菈法留纳也说过，桓那兰那的水是最好喝的吗？"
                },
                {
                    "id": "730130312",
                    "speaker": "兰阿帕斯",
                    "text": "呜呜…"
                },
                {
                    "id": "730130313",
                    "speaker": "兰萨卡",
                    "text": "现、现在你们看见了吧，只有「开心的味道」，才能给妹妹带来幸福。"
                },
                {
                    "id": "730130314",
                    "speaker": "兰帕卡提",
                    "text": "#兰萨卡哥哥，我听说，你为了你的「开心的味道」，给那菈{NICKNAME}增添了许多麻烦…"
                },
                {
                    "id": "730130315",
                    "speaker": "兰萨卡",
                    "text": "那、那都是为了「至上珍馐」…"
                },
                {
                    "id": "730130316",
                    "speaker": "兰帕卡提",
                    "text": "完成「至上珍馐」是为了得到「烹饪修行」的结果，哎呀呀，依靠他人的力量完成的修行，又有什么意义可言？"
                },
                {
                    "id": "730130317",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提觉得，兰萨卡哥哥最需要好好进行反省。"
                },
                {
                    "id": "730130318",
                    "speaker": "兰萨卡",
                    "text": "呜呜…"
                },
                {
                    "id": "730130319",
                    "speaker": "派蒙",
                    "text": "兰帕卡提！我们来啦！"
                },
                {
                    "id": "730130320",
                    "speaker": "兰帕卡提",
                    "text": "哎呀呀，是你们。"
                },
                {
                    "id": "730130321",
                    "speaker": "兰帕卡提",
                    "text": "#那菈{NICKNAME}和派蒙分享了兰帕卡提的烦恼，解决了烦恼的根源…"
                },
                {
                    "id": "730130322",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提终于不再为哥哥们错过无忧节，是否在外涉险而感到烦恼了。多亏你们了。"
                },
                {
                    "id": "730130323",
                    "speaker": "兰帕卡提",
                    "text": "兰帕卡提和哥哥们，都很感谢。"
                },
                {
                    "id": "730130324",
                    "speaker": "派蒙",
                    "text": "那就最好不过了！"
                },
                {
                    "id": "730130325",
                    "speaker": "派蒙",
                    "text": "不过，有件事情，我一直很好奇…"
                },
                {
                    "id": "730130326",
                    "speaker": "Player",
                    "text": "「那菈法留纳」到底是谁？"
                },
                {
                    "id": "730130327",
                    "speaker": "兰帕卡提",
                    "text": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是我们的朋友。是桓那兰那的朋友。"
                },
                {
                    "id": "730130328",
                    "speaker": "兰帕卡提",
                    "text": "#在好久好久好久以前，兰那罗的朋友。和那菈{NICKNAME}很像，是个金灿灿的那菈。"
                },
                {
                    "id": "730130329",
                    "speaker": "派蒙",
                    "text": "原来如此。不过，我还有别的问题…"
                },
                {
                    "id": "730130330",
                    "speaker": "Player",
                    "text": "关于「兄妹」的事情吗？"
                },
                {
                    "id": "730130331",
                    "speaker": "派蒙",
                    "text": "嗯。兰帕卡提的哥哥们，究竟谁最大、谁最小呢？"
                },
                {
                    "id": "730130332",
                    "speaker": "兰帕卡提",
                    "text": "嗯？大小？",
                    "choices": [
                        {
                            "id": "730130333",
                            "text": "指年龄…",
                            "response": [
                                {
                                    "id": "730130336",
                                    "speaker": "兰帕卡提",
                                    "text": "「年龄」…啊。兰帕卡提知道了，就像树的年轮。嗯，森林的孩子们，是不分「年龄」大小的。"
                                },
                                {
                                    "id": "730130337",
                                    "speaker": "派蒙",
                                    "text": "欸？那「哥哥」和「妹妹」又是怎么回事…"
                                },
                                {
                                    "id": "730130338",
                                    "speaker": "兰帕卡提",
                                    "text": "#这个啊。以前，我们有一个那菈朋友。那菈法留纳。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}有一个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」。"
                                },
                                {
                                    "id": "730130339",
                                    "speaker": "兰帕卡提",
                                    "text": "#兰帕卡提和哥哥们听{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说到那个「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」的时候，看起来都很幸福，又很难过。"
                                },
                                {
                                    "id": "730130340",
                                    "speaker": "兰帕卡提",
                                    "text": "所以，我们知道了。对「哥哥」来说，「妹妹」是很重要的那菈。对「妹妹」来说，「哥哥」是很重要的那菈。"
                                },
                                {
                                    "id": "730130341",
                                    "speaker": "兰帕卡提",
                                    "text": "我们觉得很好。所以，兰帕卡提和哥哥们也决定，要变成「哥哥」和「妹妹」。那菈法留纳说，这样很好。要珍惜亲人。"
                                },
                                {
                                    "id": "730130342",
                                    "speaker": "Player",
                                    "text": "没错，一定要珍惜自己的亲人。"
                                },
                                {
                                    "id": "730130343",
                                    "speaker": "派蒙",
                                    "text": "嗯…"
                                },
                                {
                                    "id": "730130344",
                                    "speaker": "派蒙",
                                    "text": "我还有一件事情很在意…兰那罗需要吃饭吗？"
                                },
                                {
                                    "id": "730130345",
                                    "speaker": "兰帕卡提",
                                    "text": "人类会把食材做成菜肴，森林的孩子也可以把食材做成菜肴。"
                                },
                                {
                                    "id": "730130346",
                                    "speaker": "兰帕卡提",
                                    "text": "因为那菈法留纳以前，教过我们，那菈吃东西的方法。兰帕卡提和哥哥们，才会开始「烹饪修行」…"
                                },
                                {
                                    "id": "730130347",
                                    "speaker": "派蒙",
                                    "text": "唔，还真是奇怪…",
                                    "choices": [
                                        {
                                            "id": "730130348",
                                            "text": "就像是在玩什么游戏一样…",
                                            "response": [
                                                {
                                                    "id": "730130350",
                                                    "speaker": "兰帕卡提",
                                                    "text": "兰帕卡提和哥哥们可是很认真的。因为，那菈法留纳说过，能够一起分享食物，是很幸福的事情。"
                                                },
                                                {
                                                    "id": "730130351",
                                                    "speaker": "兰帕卡提",
                                                    "text": "#对了，听兰阿帕斯哥哥说，那菈{NICKNAME}也会烹饪。"
                                                },
                                                {
                                                    "id": "730130352",
                                                    "speaker": "派蒙",
                                                    "text": "#嗯，{NICKNAME}的技术也是久经考验的！"
                                                },
                                                {
                                                    "id": "730130353",
                                                    "speaker": "兰帕卡提",
                                                    "text": "#这样呀…无忧节的时候，那菈{NICKNAME}一定要来。陪不才的哥哥们烹饪。"
                                                },
                                                {
                                                    "id": "730130354",
                                                    "speaker": "兰帕卡提",
                                                    "text": "让他们再一次见到，只有那菈才明白、兰那罗永远不能明白的，真正的烹饪与菜肴。",
                                                    "choices": [
                                                        {
                                                            "id": "730130355",
                                                            "text": "到时候可别惊讶…",
                                                            "response": [
                                                                {
                                                                    "id": "730130357",
                                                                    "speaker": "兰帕卡提",
                                                                    "text": "兰帕卡提会满心期待的。这次无忧节，一定会很好、很厉害。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730130356",
                                                            "text": "等我给你露一手吧！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730130349",
                                            "text": "就像是在过家家一样…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730130334",
                            "text": "指尺寸…",
                            "response": [
                                {
                                    "id": "730130335",
                                    "speaker": "派蒙",
                                    "text": "喂！才不是啦，是问年龄。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7301304",
            "objective": "",
            "dialogues": [
                {
                    "id": "730130401",
                    "speaker": "兰帕卡提",
                    "text": "#这次多亏了那菈{NICKNAME}，等到无忧节的时候，那菈{NICKNAME}也一定要来呀！"
                }
            ]
        },
        {
            "id": "7301305",
            "objective": "",
            "dialogues": [
                {
                    "id": "730130501",
                    "speaker": "兰茶荼",
                    "text": "十次日落果成熟的时间都不能采蘑菇，呜呜，虽然时间很短…"
                },
                {
                    "id": "730130502",
                    "speaker": "兰茶荼",
                    "text": "但是不知道为什么，一想到不能摘蘑菇，时间就变长起来了…"
                }
            ]
        },
        {
            "id": "7301306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730130601",
                    "speaker": "兰非拉",
                    "text": "兰帕卡提，生气的时候好可怕，希望待会儿吃了果子，就不要那么生气了…"
                }
            ]
        },
        {
            "id": "7301307",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730130701",
                    "speaker": "兰阿帕斯",
                    "text": "桓那兰那的水虽然好，可是桓那兰那的水是触手可及的水…不过下次就用桓那兰那的水来烹饪吧！"
                }
            ]
        },
        {
            "id": "7301308",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730130801",
                    "speaker": "兰萨卡",
                    "text": "「开心的味道」换来的不是开心，而是惹人担忧的苦恼，怎么会这样呢？"
                }
            ]
        }
    ]
}