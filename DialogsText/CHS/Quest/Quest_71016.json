            "dialogues": [
                {
                    "id": "710160301",
                    "speaker": "Player",
                    "text": "关于无名的宝藏"
                },
                {
                    "id": "710160302",
                    "speaker": "琳琅",
                    "text": "如果我的猜测没错，您上次拿来的那份东西，应该总共有三份。"
                },
                {
                    "id": "710160303",
                    "speaker": "琳琅",
                    "text": "将三份合起来，才是一个完整的物件。"
                },
                {
                    "id": "710160304",
                    "speaker": "琳琅",
                    "text": "如果您真能找齐，那我非常愿意出个好价钱收下。"
                },
                {
                    "id": "710160305",
                    "speaker": "琳琅",
                    "text": "不过这东西年代实在太过久远，想要找齐…还是有些难度的。"
                }
