        },
        {
            "id": "1918253",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191825301",
                    "speaker": "吉莲",
                    "text": "吉娜？你是什么时候溜进来的…不是说好不来探班的吗？"
                },
                {
                    "id": "191825302",
                    "speaker": "吉娜",
                    "text": "抱歉，姐姐…我有不得不来的理由…"
                }
            ]
        },
