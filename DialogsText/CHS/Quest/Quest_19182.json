            "id": "1918254",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191825401",
                    "speaker": "雅各",
                    "text": "梅里埃导演，怎么会变成现在这样…"
                },
                {
                    "id": "191825402",
                    "speaker": "吉莲",
                    "text": "或许他也有自己的苦衷吧…"
