            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191824301",
                    "speaker": "调查正式剧本",
                    "text": "（《人偶迷踪》的正式剧本，讲述了身为舞蹈用机械人偶的「主角」，在被人类废弃后开始找寻存在意义的故事…）"
                },
                {
                    "id": "191824302",
                    "speaker": "Player",
                    "text": "[调查]（仔细翻阅一遍…）"
