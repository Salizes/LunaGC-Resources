            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191824501",
                    "speaker": "调查正式剧本",
                    "text": "（第四幕里「主角」因线路老化失去了舞蹈的能力…注释上说「象征性地做点动作就好，豪华布景和群演能吸引视线」。）"
                }
            ]
        },
        {
            "id": "1918246",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191824601",
                    "speaker": "调查「原剧本」",
