    "talks": [
        {
            "id": "7050601",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705060101",
                    "speaker": "丽莎",
                    "text": "嗨，小可爱，见到你真好。"
                },
                {
                    "id": "705060102",
                    "speaker": "琴",
                    "text": "虽然很少会在这种地方见面，但我此刻的心情，和丽莎是一样的。"
                },
                {
                    "id": "705060103",
                    "speaker": "丽莎",
                    "text": "欸，怎么能叫「这种地方」呢？酒馆明明是娱乐休闲的好去处。"
                },
                {
                    "id": "705060104",
                    "speaker": "丽莎",
                    "text": "你一定想不到，我可是费尽力气劝了半天，才把这位大忙人从她那把椅子上请起来。"
                },
                {
                    "id": "705060105",
                    "speaker": "丽莎",
                    "text": "才到这里坐了没多久，琴那张脸上呀，又写满了担忧…"
                },
                {
                    "id": "705060106",
                    "speaker": "琴",
                    "text": "丽莎…"
                },
                {
                    "id": "705060107",
                    "speaker": "Player",
                    "text": "毕竟骑士团事务繁多…"
                },
                {
                    "id": "705060108",
                    "speaker": "派蒙",
                    "text": "是啊，琴团长是代理团长嘛，当然会挂念团里的事啦！"
                },
                {
                    "id": "705060109",
                    "speaker": "派蒙",
                    "text": "不过那句话怎么说的来着…「来都来了！」"
                },
                {
                    "id": "705060110",
                    "speaker": "派蒙",
                    "text": "#让{M#他}{F#她}为你们调两杯好喝的吧，喝完就开心了！"
                },
                {
                    "id": "705060111",
                    "speaker": "Player",
                    "text": "就当换换心情。"
                },
                {
                    "id": "705060112",
                    "speaker": "丽莎",
                    "text": "唉，需要学会放松的，就只有琴啦。"
                },
                {
                    "id": "705060113",
                    "speaker": "丽莎",
                    "text": "小可爱，麻烦给我一杯情诗吧，中杯，要甜一点。"
                },
                {
                    "id": "705060114",
                    "speaker": "丽莎",
                    "text": "琴呢？来点什么？"
                },
                {
                    "id": "705060115",
                    "speaker": "琴",
                    "text": "我的话…咖啡就好，也要中杯。"
                },
                {
                    "id": "705060116",
                    "speaker": "派蒙",
                    "text": "琴团长平时咖啡喝得够多了吧，要不要换点别的口味？"
                },
                {
                    "id": "705060117",
                    "speaker": "琴",
                    "text": "谢谢你，不过，我还是想喝点提神的…"
                },
                {
                    "id": "705060118",
                    "speaker": "Player",
                    "text": "明白了，请稍等片刻。"
                },
                {
                    "id": "705060119",
                    "speaker": "琴",
                    "text": "嗯，辛苦你了。"
                }
            ]
        },
        {
            "id": "7050606",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050605",
            "objective": "与丽莎和琴对话",
            "dialogues": []
        },
        {
            "id": "7050602",
            "objective": "为丽莎调制指定饮品",
            "dialogues": [
                {
                    "id": "705060201",
                    "speaker": "丽莎",
                    "text": "啊…就是这种甜味，真不错。"
                },
                {
                    "id": "705060202",
                    "speaker": "琴",
                    "text": "咖啡非常醇厚，苦味也恰到好处。"
                },
                {
                    "id": "705060203",
                    "speaker": "Player",
                    "text": "两位满意就好。"
                },
                {
                    "id": "705060204",
                    "speaker": "琴",
                    "text": "…丽莎会那样说，其实我也明白。"
                },
                {
                    "id": "705060205",
                    "speaker": "丽莎",
                    "text": "哦？"
                },
                {
                    "id": "705060206",
                    "speaker": "琴",
                    "text": "最近我常常反思自己的不足。工作效率也好，办事手腕也好…各方面都有提升空间。"
                },
                {
                    "id": "705060207",
                    "speaker": "琴",
                    "text": "看来我身上这份压力，已经在不知不觉中扩散给丽莎了吧…"
                },
                {
                    "id": "705060208",
                    "speaker": "Player",
                    "text": "这不完全没明白吗…"
                },
                {
                    "id": "705060209",
                    "speaker": "琴",
                    "text": "欸？"
                },
                {
                    "id": "705060210",
                    "speaker": "丽莎",
                    "text": "是啊。喏，小可爱一眼就看出来了。"
                },
                {
                    "id": "705060211",
                    "speaker": "丽莎",
                    "text": "我是看你太过操劳，想带你品品酒，喝喝茶，体验点开心的事情而已。"
                },
                {
                    "id": "705060212",
                    "speaker": "丽莎",
                    "text": "结果来到酒馆，你还满心想着工作，这才有些失落的。"
                },
                {
                    "id": "705060213",
                    "speaker": "丽莎",
                    "text": "总像这样紧绷神经，早晚会累趴下的啦。"
                },
                {
                    "id": "705060214",
                    "speaker": "Player",
                    "text": "没错。"
                },
                {
                    "id": "705060215",
                    "speaker": "琴",
                    "text": "#{NICKNAME}，连你也这样想吗？"
                },
                {
                    "id": "705060216",
                    "speaker": "琴",
                    "text": "唔，所以说…学会休息，对我来说才是最大的挑战吗？"
                },
                {
                    "id": "705060217",
                    "speaker": "Player",
                    "text": "借一句璃月俗语：「张弛有度」。"
                },
                {
                    "id": "705060218",
                    "speaker": "派蒙",
                    "text": "嗯！该工作的时候工作，该休息的时候休息。简单来说，就是你们俩加一加再除以二啦！"
                },
                {
                    "id": "705060219",
                    "speaker": "Player",
                    "text": "好怪的说法…"
                },
                {
                    "id": "705060220",
                    "speaker": "丽莎",
                    "text": "噗…"
                },
                {
                    "id": "705060221",
                    "speaker": "琴",
                    "text": "我，我明白了…"
                },
                {
                    "id": "705060222",
                    "speaker": "琴",
                    "text": "谢谢你们。没想到来这里除了喝饮品，还能让心情轻松不少。这就是丽莎和凯亚喜欢酒馆的原因吗？"
                },
                {
                    "id": "705060223",
                    "speaker": "丽莎",
                    "text": "是，也不全是。更重要的还要看调酒的是谁。"
                },
                {
                    "id": "705060224",
                    "speaker": "丽莎",
                    "text": "今天也是托小可爱的福才能说动琴，你可真有口才。",
                    "choices": [
                        {
                            "id": "705060225",
                            "text": "这没什么。",
                            "response": [
                                {
                                    "id": "705060227",
                                    "speaker": "丽莎",
                                    "text": "呵呵，那我们就先告辞了。"
                                },
                                {
                                    "id": "705060228",
                                    "speaker": "琴",
                                    "text": "今后有机会的话，我也会考虑再来这里放松一下的。"
                                },
                                {
                                    "id": "705060229",
                                    "speaker": "派蒙",
                                    "text": "好耶，两位慢走！"
                                }
                            ]
                        },
                        {
                            "id": "705060226",
                            "text": "能帮到你们就好。"
                        }
                    ]
                }
            ]
        },
