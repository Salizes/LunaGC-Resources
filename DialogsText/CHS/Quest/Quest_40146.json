    "talks": [
        {
            "id": "4014603",
            "objective": "等待至两天后",
            "dialogues": []
        },
        {
            "id": "4014601",
            "objective": "返回店铺",
            "dialogues": [
                {
                    "id": "401460801",
                    "speaker": "Black Screen",
                    "text": "又过了一段时间，炼金店铺的经营规模越来越大，你也即将迎来全新的商机…"
                },
                {
                    "id": "401460802",
                    "speaker": "派蒙",
                    "text": "似乎有其他国家的商人过来了，我们去看看吧。"
                }
            ]
        },
        {
            "id": "4014602",
            "objective": "与商人对话",
            "dialogues": [
                {
                    "id": "401460101",
                    "speaker": "阿泰菲",
                    "text": "你们好呀，我是来自须弥的旅行商人阿泰菲，很高兴认识你们！"
                },
                {
                    "id": "401460102",
                    "speaker": "派蒙",
                    "text": "哇，居然从这么远的地方过来吗，不知不觉，我们的店铺名气已经这么大了？",
                    "choices": [
                        {
                            "id": "401460103",
                            "text": "多亏了派蒙。",
                            "response": [
                                {
                                    "id": "401460104",
                                    "speaker": "派蒙",
                                    "text": "哼哼，现在在你面前的，正是冉冉升起的销售之星，派蒙！"
                                },
                                {
                                    "id": "401460106",
                                    "speaker": "阿泰菲",
                                    "text": "啊哈哈，最近确实有不少消息灵通的商人听说了你们在售卖的炼金药剂呢。"
                                },
                                {
                                    "id": "401460107",
                                    "speaker": "阿泰菲",
                                    "text": "这种不太常见的商品，大部分人还是不太敢冒险。"
                                },
                                {
                                    "id": "401460108",
                                    "speaker": "阿泰菲",
                                    "text": "但在我看来，要想赚大钱，就得抢占商机！"
                                },
                                {
                                    "id": "401460109",
                                    "speaker": "阿泰菲",
                                    "text": "虽然现在普通人对炼金药剂的了解程度还不是很高，但只要配合销售手段，一旦打开了市场，那可就是赚不完的摩拉了！"
                                },
                                {
                                    "id": "401460110",
                                    "speaker": "阿泰菲",
                                    "text": "如果能打响名号，说不定售价能翻十倍…嘿嘿，干完这一票，就能休息到年底了。"
                                },
                                {
                                    "id": "401460111",
                                    "speaker": "派蒙",
                                    "text": "十倍！你是认真的吗？"
                                },
                                {
                                    "id": "401460112",
                                    "speaker": "阿泰菲",
                                    "text": "哼哼，只要有人愿意买，不管价格卖多高都是合理的。所谓你情我愿嘛。"
                                },
                                {
                                    "id": "401460113",
                                    "speaker": "派蒙",
                                    "text": "这个说辞，让我想起了某个满脑子都是摩拉的家伙…"
                                },
                                {
                                    "id": "401460114",
                                    "speaker": "派蒙",
                                    "text": "我说，既然你来自须弥，该不会凑巧认识多莉吧？"
                                },
                                {
                                    "id": "401460115",
                                    "speaker": "阿泰菲",
                                    "text": "多莉？难道你说的是多莉·桑歌马哈巴依老爷？你们居然认识这位大人物吗？",
                                    "choices": [
                                        {
                                            "id": "401460116",
                                            "text": "她是我的朋友。",
                                            "response": [
                                                {
                                                    "id": "401460118",
                                                    "speaker": "阿泰菲",
                                                    "text": "好厉害！桑歌马哈巴依老爷是我的偶像，她的商业嗅觉和对摩拉的执着一直激励着我！"
                                                },
                                                {
                                                    "id": "401460119",
                                                    "speaker": "阿泰菲",
                                                    "text": "我曾经有幸拜访过卡萨扎莱宫，真是气派又美丽的宅邸啊。"
                                                },
                                                {
                                                    "id": "401460120",
                                                    "speaker": "阿泰菲",
                                                    "text": "总有一天，我也想像她一样，拥有数都数不完的摩拉，嘿嘿…"
                                                },
                                                {
                                                    "id": "401460121",
                                                    "speaker": "派蒙",
                                                    "text": "呃…她已经彻底沉浸在梦里了。",
                                                    "choices": [
                                                        {
                                                            "id": "401460122",
                                                            "text": "祝你成功。",
                                                            "response": [
                                                                {
                                                                    "id": "401460123",
                                                                    "speaker": "阿泰菲",
                                                                    "text": "谢谢你的祝福！"
                                                                },
                                                                {
                                                                    "id": "401460126",
                                                                    "speaker": "阿泰菲",
                                                                    "text": "那么，我们来聊聊一起赚大钱的方法吧。"
                                                                },
                                                                {
                                                                    "id": "401460127",
                                                                    "speaker": "阿泰菲",
                                                                    "text": "其实很简单，我定期来向你进货，你生产出需要的药剂，然后我就能帮你卖到其他地方啦！"
                                                                },
                                                                {
                                                                    "id": "401460128",
                                                                    "speaker": "阿泰菲",
                                                                    "text": "如果决定合作的话，就来具体谈谈这批要出售的药剂吧。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "401460129",
                                                                            "text": "查看药剂需求。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401460130",
                                                                                    "speaker": "阿泰菲",
                                                                                    "text": "根据我敏锐的市场嗅觉，这次需要的药剂是这样的。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "401460131",
                                                                            "text": "以后再说吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401460132",
                                                                                    "speaker": "阿泰菲",
                                                                                    "text": "赚钱的机会可是稍纵即逝的呀。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401460124",
                                                            "text": "还是聊正事吧。",
                                                            "response": [
                                                                {
                                                                    "id": "401460125",
                                                                    "speaker": "阿泰菲",
                                                                    "text": "咳咳，一下子扯远了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401460117",
                                            "text": "以前打过交道。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401460105",
                            "text": "这段时间的努力有成果了。"
                        }
                    ]
                }
            ]
        }
    ]
}