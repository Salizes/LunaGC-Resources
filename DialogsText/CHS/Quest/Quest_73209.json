    "talks": [
        {
            "id": "7320908",
            "objective": "(test)73207后闲置对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320907",
            "objective": "(test)计时$HIDDEN",
            "dialogues": [
                {
                    "id": "732090701",
                    "speaker": "阿凡",
                    "text": "老头子我都快不抱希望了，没想到这花最后还是种出来了，果然活着就能有奇妙的事发生。"
                },
                {
                    "id": "732090702",
                    "speaker": "阿凡",
                    "text": "小姑娘，还在为沙法卡特叔叔的事难过吗？别愁啦，活着的人要带着死去的人那些心愿活下去才算对得起他们哩。"
                },
                {
                    "id": "732090703",
                    "speaker": "赛芭",
                    "text": "老先生…我已经不小了，那些和我一起长大的朋友们，说不定她们的孩子都会去店里买香料了。"
                },
                {
                    "id": "732090704",
                    "speaker": "赛芭",
                    "text": "但无论如何你说得对，既然活着总要开开心心地活下去才行。"
                }
            ]
        },
        {
            "id": "7320901",
            "objective": "(test)再次与阿凡和赛芭对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732090101",
                    "speaker": "阿凡",
                    "text": "是你们啊，蔷薇还有我们都在等着。"
                },
                {
                    "id": "732090102",
                    "speaker": "派蒙",
                    "text": "赛芭也早早地来了啊。"
                },
                {
                    "id": "732090103",
                    "speaker": "赛芭",
                    "text": "我最近常来这里，沙法卡特先生留下的手记都看了个遍。"
                },
                {
                    "id": "732090104",
                    "speaker": "赛芭",
                    "text": "以前我一直觉得呆在阿如村生活很寂寞，但现在感觉不同了。"
                },
                {
                    "id": "732090105",
                    "speaker": "赛芭",
                    "text": "至少我不完全是一个人，还有这些蔷薇，和你们一起的记忆，还有阿凡先生一起。"
                },
                {
                    "id": "732090106",
                    "speaker": "赛芭",
                    "text": "我的生活里还有些美好的念想，这样一想就觉得自己没有那么寂寞了。"
                },
                {
                    "id": "732090107",
                    "speaker": "赛芭",
                    "text": "我和阿凡老先生商量好了，以后我就帮他一起照看金蔷薇。"
                },
                {
                    "id": "732090108",
                    "speaker": "赛芭",
                    "text": "让它们越开越多，开满整个苗圃。至于现在，先让这几株开出花来吧。"
                },
                {
                    "id": "732090109",
                    "speaker": "赛芭",
                    "text": "你还记得之前是怎么让我的须弥蔷薇开花的吗？用同样的方法就好。"
                },
                {
                    "id": "732090110",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "732090111",
                    "speaker": "赛芭",
                    "text": "来，看你的了。"
                }
            ]
        },
        {
            "id": "7320902",
            "objective": "用草元素的力量「唤醒」金蔷薇",
            "dialogues": []
        },
        {
            "id": "7320903",
            "objective": "用草元素的力量「唤醒」金蔷薇",
            "dialogues": [
                {
                    "id": "732090426",
                    "speaker": "Black Screen",
                    "text": "「蔷薇啊蔷薇，实现我的愿望。」"
                },
                {
                    "id": "732090427",
                    "speaker": "Black Screen",
                    "text": "「花从石头中绽放，金蔷薇对我歌唱。」"
                },
                {
                    "id": "732090401",
                    "speaker": "派蒙",
                    "text": "金色的蔷薇花果然很漂亮，看到它们开放，感觉心情也明亮起来了。"
                },
                {
                    "id": "732090402",
                    "speaker": "派蒙",
                    "text": "这些天的辛苦没有白费，好开心！",
                    "choices": [
                        {
                            "id": "732090403",
                            "text": "心愿终于实现了。",
                            "response": [
                                {
                                    "id": "732090405",
                                    "speaker": "阿凡",
                                    "text": "到最后，我终于有一件能做好的事了。沙法卡特叔叔，你的心愿我替你达成了。"
                                },
                                {
                                    "id": "732090406",
                                    "speaker": "赛芭",
                                    "text": "遗憾的是，他看不到了。"
                                },
                                {
                                    "id": "732090407",
                                    "speaker": "阿凡",
                                    "text": "赛芭，不能这样说啊。你记得蔷薇歌谣最后的那段吗？"
                                },
                                {
                                    "id": "732090408",
                                    "speaker": "阿凡",
                                    "text": "「没有土地承载我，唯有歌谣承载我。」"
                                },
                                {
                                    "id": "732090409",
                                    "speaker": "阿凡",
                                    "text": "「歌谣战胜敌视我的命运，战胜我的结局。」"
                                },
                                {
                                    "id": "732090410",
                                    "speaker": "阿凡",
                                    "text": "「战胜我战胜时间，战胜永不消逝的消逝。」"
                                },
                                {
                                    "id": "732090411",
                                    "speaker": "阿凡",
                                    "text": "沙法卡特叔叔的生命和金蔷薇还有他亲自编写的歌谣一起，都留在了我们身边。"
                                },
                                {
                                    "id": "732090412",
                                    "speaker": "赛芭",
                                    "text": "嗯，说的没错，他是战胜了消逝的人。"
                                },
                                {
                                    "id": "732090413",
                                    "speaker": "赛芭",
                                    "text": "谢谢你们让我知道沙法卡特先生的事，这对我来说很重要。"
                                },
                                {
                                    "id": "732090414",
                                    "speaker": "赛芭",
                                    "text": "他是在我之前的流放者，看到他的那些生活痕迹，总让我觉得自己好像跨越了时空…"
                                },
                                {
                                    "id": "732090415",
                                    "speaker": "赛芭",
                                    "text": "我看着的不仅是沙法卡特先生，还有我自己。"
                                },
                                {
                                    "id": "732090416",
                                    "speaker": "赛芭",
                                    "text": "虽然我不能对他说些什么，但我可以带着他的遗憾生活下去。"
                                },
                                {
                                    "id": "732090417",
                                    "speaker": "赛芭",
                                    "text": "如果我连带着他的份一起努力生活下去，那最终我一定能救赎自己。",
                                    "choices": [
                                        {
                                            "id": "732090418",
                                            "text": "希望你幸福。",
                                            "response": [
                                                {
                                                    "id": "732090420",
                                                    "speaker": "赛芭",
                                                    "text": "感觉在这里的生活也并不糟糕了呢，能遇到你们真好。"
                                                },
                                                {
                                                    "id": "732090421",
                                                    "speaker": "赛芭",
                                                    "text": "蔷薇花果然是能带给人幸福的花，阿凡老先生，以后我们得加油种上更多的蔷薇花。"
                                                },
                                                {
                                                    "id": "732090422",
                                                    "speaker": "阿凡",
                                                    "text": "哈哈哈，那我们就算约定好了。"
                                                },
                                                {
                                                    "id": "732090423",
                                                    "speaker": "赛芭",
                                                    "text": "嗯，我会努力的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732090419",
                                            "text": "不要气馁。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732090404",
                            "text": "一切都是值得的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320905",
            "objective": "（test）苗圃变化$HIDDEN",
            "dialogues": [
                {
                    "id": "732090501",
                    "speaker": "赛芭",
                    "text": "只要用<color=#00E1FFFF>草元素</color>的力量，就能让沉睡在这些嫩芽里的花醒过来。"
                }
            ]
        },
        {
            "id": "7320904",
            "objective": "(test)对话中开花$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320906",
            "objective": "（test）用草元素的力量「唤醒」金蔷薇",
            "dialogues": [
                {
                    "id": "732090601",
                    "speaker": "阿凡",
                    "text": "只要这几株能健康地生长，我们以后一定能培育出更多的金蔷薇。"
                },
                {
                    "id": "732090602",
                    "speaker": "阿凡",
                    "text": "不过在这之前，还是得先看到这几株金蔷薇开花我才放心啊。"
                }
            ]
        },
