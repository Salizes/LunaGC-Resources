    },
    "talks": [
        {
            "id": "7406401",
            "objective": "与嘉维娅对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740640101",
                    "speaker": "嘉维娅",
                    "text": "我说，要么想办法清除掉它，要么搞清楚到底是谁干的。"
                },
                {
                    "id": "740640102",
                    "speaker": "莫普瓦",
                    "text": "你说得倒是轻巧…我试了各种清洁剂都没办法清除它，再强效的…就只能试试浊水幻灵克星了。"
                },
                {
                    "id": "740640103",
                    "speaker": "嘉维娅",
                    "text": "浊水幻灵克星？你是想给墙上开个洞，让所有人都和鱼睡觉吗？"
                },
                {
                    "id": "740640104",
                    "speaker": "莫普瓦",
                    "text": "那就只能找到罪魁祸首再说了。话虽如此，我们现在可是一点线索也没有啊。"
                },
                {
                    "id": "740640105",
                    "speaker": "派蒙",
                    "text": "怎么了？有什么我们能帮上忙的吗？"
                },
                {
                    "id": "740640106",
                    "speaker": "莫普瓦",
                    "text": "是这样，你们瞧，墙上的标记。梅洛彼得堡是禁止乱涂乱画的啊…"
                },
                {
                    "id": "740640107",
                    "speaker": "莫普瓦",
                    "text": "我们试了各种办法都没办法清除掉标记，如果至少能找到是谁干的这好事…"
                },
                {
                    "id": "740640108",
                    "speaker": "嘉维娅",
                    "text": "仔细想想也不是全无线索，我好像听克兰茨提起过，在枫丹科学院有一种标记，需要用特殊的方法解读。"
                },
                {
                    "id": "740640109",
                    "speaker": "莫普瓦",
                    "text": "你是说这个标记可能是他说的那种？"
                },
                {
                    "id": "740640110",
                    "speaker": "嘉维娅",
                    "text": "当时我完全没兴趣，所以也没有继续追问。要是他人在这里，或许就能给出答案了吧。",
                    "choices": [
                        {
                            "id": "740640111",
                            "text": "说不定就是他本人干的。",
                            "response": [
                                {
                                    "id": "740640112",
                                    "speaker": "嘉维娅",
                                    "text": "的确不能排除这种可能。但如果真是这样，呵呵…他应该知道规矩的。"
                                },
                                {
                                    "id": "740640115",
                                    "speaker": "嘉维娅",
                                    "text": "#{NICKNAME}和派蒙，你们是见多识广的冒险家，你们有什么好办法吗？"
                                },
                                {
                                    "id": "740640116",
                                    "speaker": "嘉维娅",
                                    "text": "帮我们找到乱涂乱画的罪魁祸首，或者找到克兰茨让他来看看。唔…就当是正式的工作委托好了，我们会支付特许券作为报酬。"
                                },
                                {
                                    "id": "740640117",
                                    "speaker": "派蒙",
                                    "text": "好吧，既然是正式的工作委托，那我们就想想办法。"
                                },
                                {
                                    "id": "740640118",
                                    "speaker": "嘉维娅",
                                    "text": "感谢。我们也再试试有没有可以清除标记的办法。"
                                }
                            ]
                        },
                        {
                            "id": "740640113",
                            "text": "那去找他来看看？",
                            "response": [
                                {
                                    "id": "740640114",
                                    "speaker": "莫普瓦",
                                    "text": "不知道他人在哪里…我今天还没见过他呢。而且，真的要拜托他吗？每次拜托他做点什么，我的自尊都会死去一点点。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406402",
            "objective": "调查墙上的齿轮图形",
            "dialogues": [
                {
                    "id": "740640201",
                    "speaker": "莫普瓦",
                    "text": "抓一只膨膨兽来对着它吐口水会有用吗？"
                },
                {
                    "id": "740640202",
                    "speaker": "嘉维娅",
                    "text": "认真的吗？你最近是不是压力有点大？精神还健康吗？是不是排班排太多了？"
                },
                {
                    "id": "740640203",
                    "speaker": "莫普瓦",
                    "text": "我的精神很健康啊，我只是想看膨膨兽吐口水而已。"
                },
                {
                    "id": "740640204",
                    "speaker": "嘉维娅",
                    "text": "你还是休个假吧。"
                }
            ]
        },
        {
            "id": "7406403",
            "objective": "找到乱涂乱画的罪魁祸首",
            "dialogues": [
                {
                    "id": "740640301",
                    "speaker": "派蒙",
                    "text": "欸？这不是克兰茨吗？",
                    "choices": [
                        {
                            "id": "740640302",
                            "text": "你好，克兰茨，又见面了。",
                            "response": [
                                {
                                    "id": "740640303",
                                    "speaker": "派蒙",
                                    "text": "…嗯？克兰茨在这里的话也就说，那个标记果然是你留下的吧？"
                                },
                                {
                                    "id": "740640306",
                                    "speaker": "克兰茨",
                                    "text": "唉，怎么会是你们啊…"
                                },
                                {
                                    "id": "740640307",
                                    "speaker": "克兰茨",
                                    "text": "你们说的是什么事？我一点头绪也没有，要不你们去问问别人？",
                                    "choices": [
                                        {
                                            "id": "740640308",
                                            "text": "派蒙，看来我们找错人了。",
                                            "response": [
                                                {
                                                    "id": "740640309",
                                                    "speaker": "派蒙",
                                                    "text": "#原来是我们找错人了吗…不对吧！{NICKNAME}，你可不要被他骗了，这里除了他根本就没有其他人了嘛，肯定是他！"
                                                },
                                                {
                                                    "id": "740640312",
                                                    "speaker": "克兰茨",
                                                    "text": "好吧，你们赢了，是我干的。"
                                                },
                                                {
                                                    "id": "740640313",
                                                    "speaker": "克兰茨",
                                                    "text": "唉，我还以为能靠这个找到熟人叙叙旧呢，没想到来的是你们。"
                                                },
                                                {
                                                    "id": "740640314",
                                                    "speaker": "派蒙",
                                                    "text": "靠这个找到熟人？"
                                                },
                                                {
                                                    "id": "740640315",
                                                    "speaker": "克兰茨",
                                                    "text": "是啊。密图函是布托尔先生开发的技术，枫丹科学院里知道解读方法的人也不多。我也是因为曾经受到他不少照顾所以知道…"
                                                },
                                                {
                                                    "id": "740640316",
                                                    "speaker": "克兰茨",
                                                    "text": "可惜他去世得太早了，密图函的技术也不受管理层重视。所以我想如果还有能够解读密图函的家伙，我们应该有得聊吧。"
                                                },
                                                {
                                                    "id": "740640317",
                                                    "speaker": "克兰茨",
                                                    "text": "哦，我的意思不是和你们无话可说，只是我们之间可能缺少一些共同话题。",
                                                    "choices": [
                                                        {
                                                            "id": "740640318",
                                                            "text": "别勉强自己了，确实无话可说。",
                                                            "response": [
                                                                {
                                                                    "id": "740640319",
                                                                    "speaker": "克兰茨",
                                                                    "text": "你可真是诚实啊。我曾经有一个朋友，就和你一样有话直说，也曾经因此惹出过不少麻烦…"
                                                                },
                                                                {
                                                                    "id": "740640320",
                                                                    "speaker": "克兰茨",
                                                                    "text": "不过现在回想起来，那真是一段快乐的时光。"
                                                                },
                                                                {
                                                                    "id": "740640325",
                                                                    "speaker": "克兰茨",
                                                                    "text": "话说回来，你们就为这件事找我吗？"
                                                                },
                                                                {
                                                                    "id": "740640326",
                                                                    "speaker": "派蒙",
                                                                    "text": "差点忘了！是嘉维娅和莫普瓦拜托我们调查乱涂乱画的罪魁祸首来着。"
                                                                },
                                                                {
                                                                    "id": "740640327",
                                                                    "speaker": "Player",
                                                                    "text": "你自首吧。"
                                                                },
                                                                {
                                                                    "id": "740640328",
                                                                    "speaker": "派蒙",
                                                                    "text": "自首吧！拒捕的话我们不会手下留情的。"
                                                                },
                                                                {
                                                                    "id": "740640329",
                                                                    "speaker": "克兰茨",
                                                                    "text": "欸…真的没有商量的余地吗？莫普瓦姑且不提，我可不想又落到嘉维娅手上啊。"
                                                                },
                                                                {
                                                                    "id": "740640330",
                                                                    "speaker": "克兰茨",
                                                                    "text": "有没有一种可能，两位就对这件事睁一只眼闭一只眼…"
                                                                },
                                                                {
                                                                    "id": "740640331",
                                                                    "speaker": "派蒙",
                                                                    "text": "可是莫普瓦说了，梅洛彼得堡禁止乱涂乱画。违反规定是不好的。"
                                                                },
                                                                {
                                                                    "id": "740640332",
                                                                    "speaker": "克兰茨",
                                                                    "text": "宽容一点看，密图函和墙上的那些文字也没有什么区别嘛，都是装饰，装饰而已。"
                                                                },
                                                                {
                                                                    "id": "740640333",
                                                                    "speaker": "克兰茨",
                                                                    "text": "#这样吧，我和你们回去，但是要不要告发我，就看{NICKNAME}的决定了。"
                                                                },
                                                                {
                                                                    "id": "740640334",
                                                                    "speaker": "克兰茨",
                                                                    "text": "当然，如果你选择帮我一把，让我不至于落入嘉维娅的魔爪之中，我也愿意提供相应的回报。"
                                                                },
                                                                {
                                                                    "id": "740640335",
                                                                    "speaker": "克兰茨",
                                                                    "text": "我把我的命运托付给你们了。我们这就走吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740640321",
                                                            "text": "那还真是抱歉了。",
                                                            "response": [
                                                                {
                                                                    "id": "740640322",
                                                                    "speaker": "克兰茨",
                                                                    "text": "哈，你要这么说我可接不下去了。"
                                                                },
                                                                {
                                                                    "id": "740640323",
                                                                    "speaker": "克兰茨",
                                                                    "text": "我也知道，按照常理，这时候应该说些「听你们讲讲旅途的经历或许也很不错吧」之类的客套话，不过…"
                                                                },
                                                                {
                                                                    "id": "740640324",
                                                                    "speaker": "克兰茨",
                                                                    "text": "唯独这件事，我决定对自己诚实一点。我不想听外面的新鲜故事了，只想找人叙旧。所以，要道歉的是我才对。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740640310",
                                            "text": "你要不看看这里除了你还有谁。",
                                            "response": [
                                                {
                                                    "id": "740640311",
                                                    "speaker": "派蒙",
                                                    "text": "就是就是！少拿这种蹩脚的演技糊弄我们！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740640304",
                            "text": "老实交代，就是你小子干的对吧？",
                            "response": [
                                {
                                    "id": "740640305",
                                    "speaker": "派蒙",
                                    "text": "老实交代！那个标记就是你干的好事吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406404",
            "objective": "与嘉维娅对话",
            "dialogues": [
                {
                    "id": "740640401",
                    "speaker": "嘉维娅",
                    "text": "看来你们找到克兰茨了。不过，乱涂乱画的罪魁祸首…你们找到了吗？或者说，有线索了吗？"
                },
                {
                    "id": "740640402",
                    "speaker": "派蒙",
                    "text": "这个嘛…",
                    "choices": [
                        {
                            "id": "740640403",
                            "text": "就是克兰茨干的。",
                            "response": [
                                {
                                    "id": "740640404",
                                    "speaker": "嘉维娅",
                                    "text": "我猜也是。"
                                },
                                {
                                    "id": "740640405",
                                    "speaker": "克兰茨",
                                    "text": "唉，想好的说辞这下全报废了。现在我就是砧板上的肉，随你们处置了。"
                                },
                                {
                                    "id": "740640406",
                                    "speaker": "派蒙",
                                    "text": "规矩就是规矩嘛。"
                                },
                                {
                                    "id": "740640407",
                                    "speaker": "莫普瓦",
                                    "text": "比起你要接受的惩罚，我现在更关心这标记要怎么去除。"
                                },
                                {
                                    "id": "740640408",
                                    "speaker": "克兰茨",
                                    "text": "你对密图函的技术感兴趣吗？这要讲起来可得花些时间，不如你们坐下，听我慢慢说。"
                                },
                                {
                                    "id": "740640409",
                                    "speaker": "莫普瓦",
                                    "text": "不，我对技术细节不感兴趣，你只要告诉我该怎么去除掉它就行了…"
                                },
                                {
                                    "id": "740640410",
                                    "speaker": "克兰茨",
                                    "text": "那可说来话长了，毕竟用到了特殊的涂料和技巧…"
                                },
                                {
                                    "id": "740640411",
                                    "speaker": "莫普瓦",
                                    "text": "我还有其他的工作要做，你简短点说明，呃，拜托你了。"
                                },
                                {
                                    "id": "740640412",
                                    "speaker": "嘉维娅",
                                    "text": "#别管他们了。{NICKNAME}，派蒙，这是说好的报酬，感谢你们的劳动。"
                                }
                            ]
                        },
                        {
                            "id": "740640413",
                            "text": "这太专业了，请克兰茨来看看吧。",
                            "response": [
                                {
                                    "id": "740640414",
                                    "speaker": "嘉维娅",
                                    "text": "克兰茨，这就是你之前提起过的特殊标记吗？"
                                },
                                {
                                    "id": "740640415",
                                    "speaker": "克兰茨",
                                    "text": "我看看…唔，唔，你瞧它多像一个齿轮，这么大的齿轮，不是来自枫丹科学院，还能是来自哪里呢？"
                                },
                                {
                                    "id": "740640416",
                                    "speaker": "嘉维娅",
                                    "text": "它来自枫丹科学院，你也来自枫丹科学院，你们之间的联系显而易见，你就老实承认吧，是你干的。"
                                },
                                {
                                    "id": "740640417",
                                    "speaker": "克兰茨",
                                    "text": "话不能这么说，如果哪天我有幸和嘉维娜一起在德波大饭店用餐…"
                                },
                                {
                                    "id": "740640418",
                                    "speaker": "嘉维娅",
                                    "text": "你要是还没睡醒我可以帮你的。你要是觉得我的拳头太轻，罗西莫夫肯定也愿意帮忙的。"
                                },
                                {
                                    "id": "740640419",
                                    "speaker": "克兰茨",
                                    "text": "你先别激动，我这不是举例子吗！只是举例子而已！"
                                },
                                {
                                    "id": "740640420",
                                    "speaker": "克兰茨",
                                    "text": "说到哪儿了…咳，总之，我和嘉维娜一起出去，我们都来自梅洛彼得堡，可也未必有关系吧。"
                                },
                                {
                                    "id": "740640421",
                                    "speaker": "克兰茨",
                                    "text": "你瞧，这不是完全没关系吗！我和这个标记没关系，就像我和嘉维娜也没关系一样。"
                                },
                                {
                                    "id": "740640422",
                                    "speaker": "嘉维娅",
                                    "text": "好吧，你说服我了。不过仅限于你和姐姐没关系那段。"
                                },
                                {
                                    "id": "740640423",
                                    "speaker": "Player",
                                    "text": "那不是根本没说服吗？"
                                },
                                {
                                    "id": "740640424",
                                    "speaker": "派蒙",
                                    "text": "我、我们已经没什么可说的了，接下来就看你自己的了！"
                                },
                                {
                                    "id": "740640425",
                                    "speaker": "克兰茨",
                                    "text": "唉，无论如何，还是谢谢你们。之前说好的回报…"
                                },
                                {
                                    "id": "740640426",
                                    "speaker": "莫普瓦",
                                    "text": "#对了！{NICKNAME}，派蒙，劳动的报酬差点忘了交给你们。虽然没找到罪魁祸首很可惜…"
                                },
                                {
                                    "id": "740640427",
                                    "speaker": "莫普瓦",
                                    "text": "不过相信克兰茨一定有办法清除掉这个标记吧！之后就交给嘉维娅和克兰茨了，我还有其他工作要做呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740640501",
                    "speaker": "莫普瓦",
                    "text": "都说了我还有其他工作要做呢…"
                },
                {
                    "id": "740640502",
                    "speaker": "克兰茨",
                    "text": "凡事都讲先后顺序，你得先搞清楚原理…"
                },
                {
                    "id": "740640503",
                    "speaker": "嘉维娅",
                    "text": "真头疼啊。我和姐姐约好了一起吃晚餐，就算这问题解决不了，到换班时间我也会走的。"
                }
            ]
        }
    ]
}