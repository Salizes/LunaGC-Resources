            "objective": "(test)派蒙开车用$HIDDEN",
            "dialogues": [
                {
                    "id": "400000101",
                    "speaker": "派蒙",
                    "text": "咦？那边怎么围着这么多人…"
                }
            ]
        },
        {
            "id": "4000002",
            "objective": "与瑞锦对话",
            "dialogues": [
                {
                    "id": "400000201",
                    "speaker": "瑞锦",
                    "text": "你好！你也想试玩一下「机关棋谭」吗？"
                },
                {
                    "id": "400000202",
                    "speaker": "Player",
                    "text": "什么…「机关棋谭」？"
                },
                {
                    "id": "400000203",
                    "speaker": "瑞锦",
                    "text": "唔，看来你不太了解呢…「机关棋谭」是我发明的一种能在桌子上玩的「游戏」。"
                },
                {
                    "id": "400000204",
                    "speaker": "瑞锦",
                    "text": "你看到桌子上的这些摆件了吗？这些都是「机关棋谭」里要用到的道具。"
                },
                {
                    "id": "400000205",
                    "speaker": "Player",
                    "text": "看起来好复杂…"
                },
                {
                    "id": "400000206",
                    "speaker": "瑞锦",
                    "text": "只是看起来复杂啦，其实很容易上手的，只要玩几局就熟悉规则了。"
                },
                {
                    "id": "400000207",
                    "speaker": "瑞锦",
                    "text": "怎么样，你想试试看吗？",
                    "choices": [
                        {
                            "id": "400000208",
                            "text": "这得…多少钱玩一局？",
                            "response": [
                                {
                                    "id": "400000210",
                                    "speaker": "瑞锦",
                                    "text": "没有没有，这不是海灯节嘛，刚好我也想要看看大家对于这个「机关棋谭」的态度…"
                                },
                                {
                                    "id": "400000211",
                                    "speaker": "瑞锦",
                                    "text": "所以，现在只需要一盏「霄灯」就能玩一局。"
                                },
                                {
                                    "id": "400000212",
                                    "speaker": "瑞锦",
                                    "text": "如果你想玩的话，拿着「霄灯」来找我就好了。"
                                },
                                {
                                    "id": "400000213",
                                    "speaker": "瑞锦",
                                    "text": "怎么样，来试试吧，第一局我就不收你霄灯啦。"
                                }
                            ]
                        },
                        {
                            "id": "400000209",
                            "text": "这玩一局挺贵的吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4000003",
            "objective": "试玩「机关棋谭」",
