        {
            "id": "7902205",
            "objective": "将内有照片的怀表交给藏镜仕女",
            "dialogues": [
                {
                    "id": "790220501",
                    "speaker": "(test)派蒙",
                    "text": "(test)显然不可能她说什么我们就听什么，或许是其他的诡计"
                },
                {
                    "id": "790220502",
                    "speaker": "Player",
                    "text": "(test)我们跟上去"
                }
            ]
        },
        {
            "id": "7902213",
            "objective": "与藏镜仕女对话",
            "dialogues": [
                {
                    "id": "790221201",
                    "speaker": "藏镜仕女",
                    "text": "这…啊，这个是我的，这里面是哥哥们和我的合照…"
                },
                {
                    "id": "790221202",
                    "speaker": "藏镜仕女",
                    "text": "能够重新找回来真是太好了，之前到底是丢在哪了呢…唔，不对，头好痛…"
                },
                {
                    "id": "790221203",
                    "speaker": "派蒙",
                    "text": "我们是在丘丘人营地的旁边找到的啦！"
                },
                {
                    "id": "790221204",
                    "speaker": "藏镜仕女",
                    "text": "真是，真是十分感谢…"
                },
                {
                    "id": "790221205",
                    "speaker": "藏镜仕女",
                    "text": "#啊！是内部文件上看到过的…金发的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}和小飞人！"
                },
                {
                    "id": "790221206",
                    "speaker": "派蒙",
                    "text": "是「派蒙」啦…唉，我干脆改名叫「小飞人」算了…"
                },
                {
                    "id": "790221207",
                    "speaker": "藏镜仕女",
                    "text": "你们对我做了什么，记忆…记忆有一段空白，你们不会对我做了什么奇怪的实验吧！"
                },
                {
                    "id": "790221208",
                    "speaker": "藏镜仕女",
                    "text": "就算我们立场不同…这样的行为也是不能被接受的！"
                },
                {
                    "id": "790221209",
                    "speaker": "派蒙",
                    "text": "做奇怪实验的是你们啦！"
                },
                {
                    "id": "790221210",
                    "speaker": "派蒙",
                    "text": "居然对把合照还给你的好心人说这种话！"
                },
                {
                    "id": "790221211",
                    "speaker": "藏镜仕女",
                    "text": "…原来是这样，可是，既然我清醒了过来就说明，佩尔西科夫研究员的实验失败了。"
                },
                {
                    "id": "790221212",
                    "speaker": "藏镜仕女",
                    "text": "看到你们也大概猜到失败的原因…欸呀，从立场上我们暂时仍是敌对的，你们还把合照给我，你们对敌人也太好心了吧…"
                },
                {
                    "id": "790221213",
                    "speaker": "藏镜仕女",
                    "text": "正确的做法应该是把别人的珍贵之物，比如对我来说，就是刚才怀表里的合照…应该把合照拿在手里，然后威胁我说出情报。"
                },
                {
                    "id": "790221214",
                    "speaker": "派蒙",
                    "text": "居然反过来被教训了…",
                    "choices": [
                        {
                            "id": "790221215",
                            "text": "好没有人情味的做法…",
                            "response": [
                                {
                                    "id": "790221216",
                                    "speaker": "藏镜仕女",
                                    "text": "…确实，是很没有人情味的做法，但是我们进入愚人众之后就是这样被教导的。"
                                },
                                {
                                    "id": "790221219",
                                    "speaker": "派蒙",
                                    "text": "对了，你们在这里到底在搞什么破坏，快说出来啦！"
                                },
                                {
                                    "id": "790221220",
                                    "speaker": "藏镜仕女",
                                    "text": "我…我们，我们一起到了这岛上…对了，扎哈尔！"
                                },
                                {
                                    "id": "790221221",
                                    "speaker": "藏镜仕女",
                                    "text": "他还一个人在那里，得快点回去！"
                                },
                                {
                                    "id": "790221222",
                                    "speaker": "Black Screen",
                                    "text": "似乎想起了什么，刚清醒的愚人众转身就离开了…"
                                }
                            ]
                        },
                        {
                            "id": "790221217",
                            "text": "下次试试看吧…",
                            "response": [
                                {
                                    "id": "790221218",
                                    "speaker": "派蒙",
                                    "text": "不要学这种事啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902206",
            "objective": "前去藏镜仕女离开的方向查看",
            "dialogues": [
                {
                    "id": "790220601",
                    "speaker": "阿加菲娅",
                    "text": "扎哈尔！扎哈尔！你能听见吗！"
                },
                {
                    "id": "790220602",
                    "speaker": "阿加菲娅",
                    "text": "这里怎么会变成这样…我们来的时候这里明明就是个山洞，这荆棘是怎么回事…"
                },
                {
                    "id": "790220603",
                    "speaker": "派蒙",
                    "text": "啊，这就是因为受到你们那个什么幻境实验的影响导致的啦。"
                },
                {
                    "id": "790220604",
                    "speaker": "派蒙",
                    "text": "这个岛上有很多类似的荆棘呢，不过只要用一定的方法…"
                },
                {
                    "id": "790220605",
                    "speaker": "阿加菲娅",
                    "text": "是放火吗？你们不会是想放火烧掉荆棘吧，不行，里面可还有人呢！"
                },
                {
                    "id": "790220606",
                    "speaker": "阿加菲娅",
                    "text": "#虽说早就听闻{NICKNAME}和派蒙非常危险，有的时候只是走在执行公务的路上也会被突然袭击…"
                },
                {
                    "id": "790220607",
                    "speaker": "阿加菲娅",
                    "text": "但是居然想放火慢慢烧一个大活人，天啊，就连最残忍的债务处理人都做不到这种程度…"
                },
                {
                    "id": "790220608",
                    "speaker": "派蒙",
                    "text": "当然不是啦…而且这种荆棘用火烧也没用…"
                },
                {
                    "id": "790220609",
                    "speaker": "派蒙",
                    "text": "我们有将荆棘打开，但不会伤到里面的人的办法…"
                },
                {
                    "id": "790220610",
                    "speaker": "阿加菲娅",
                    "text": "真的吗，我可不信你们有这么神通广大。"
                },
                {
                    "id": "790220611",
                    "speaker": "派蒙",
                    "text": "#什么，{NICKNAME}，这就把荆棘打开给她看看！",
                    "choices": [
                        {
                            "id": "790220612",
                            "text": "上当受骗了哦，派蒙…",
                            "response": [
                                {
                                    "id": "790220614",
                                    "speaker": "派蒙",
                                    "text": "咦…好呀，你故意挑拨我！"
                                },
                                {
                                    "id": "790220615",
                                    "speaker": "阿加菲娅",
                                    "text": "居然被识破了，真是可惜。"
                                },
                                {
                                    "id": "790220616",
                                    "speaker": "派蒙",
                                    "text": "哼，真是奸诈狡猾的愚人众，我们差点就中了你的诡计！"
                                },
                                {
                                    "id": "790220617",
                                    "speaker": "Player",
                                    "text": "中计的只有你啦…"
                                },
                                {
                                    "id": "790220618",
                                    "speaker": "派蒙",
                                    "text": "呜…总之，总之我们可以救出里面的人，但是相对的，你也得说出一些情报来…"
                                },
                                {
                                    "id": "790220619",
                                    "speaker": "派蒙",
                                    "text": "这就是用别人的珍贵之物作为威胁，让别人说出情报的方法！"
                                },
                                {
                                    "id": "790220620",
                                    "speaker": "阿加菲娅",
                                    "text": "哇，真是好没有人情味的做法。"
                                },
                                {
                                    "id": "790220621",
                                    "speaker": "Player",
                                    "text": "好没有人情味的做法…"
                                },
                                {
                                    "id": "790220622",
                                    "speaker": "派蒙",
                                    "text": "她说也就算了，为什么你也说我呀，你到底是哪一边的！"
                                },
                                {
                                    "id": "790220623",
                                    "speaker": "阿加菲娅",
                                    "text": "…情报吗，阿加菲娅，我的名字是阿加菲娅，现在能给的情报只有这样了。"
                                },
                                {
                                    "id": "790220624",
                                    "speaker": "派蒙",
                                    "text": "只有一个名字吗！"
                                },
                                {
                                    "id": "790220625",
                                    "speaker": "阿加菲娅",
                                    "text": "我要是说出什么重要情报，你们就拉下脸来说什么「是嘛，你已经没用了…」之类的台词，然后把我解决掉…"
                                },
                                {
                                    "id": "790220626",
                                    "speaker": "阿加菲娅",
                                    "text": "愚人众的教官说每年都会发生很多类似的事，所以一定不能外泄重要的情报。"
                                },
                                {
                                    "id": "790220627",
                                    "speaker": "派蒙",
                                    "text": "我们才不会干这样的事呢！还有你们愚人众的教官真的很奇怪…"
                                },
                                {
                                    "id": "790220628",
                                    "speaker": "阿加菲娅",
                                    "text": "奇怪吗…我倒觉得还挺正常的。总之，我现在就一个人在这里，无论如何你们都能很轻松解决我不是吗，我又逃不掉。"
                                },
                                {
                                    "id": "790220629",
                                    "speaker": "派蒙",
                                    "text": "#嗯…总觉得有点不甘心，唉，没办法，{NICKNAME}，那我们就先打开封住洞口的荆棘吧…"
                                }
                            ]
                        },
                        {
                            "id": "790220613",
                            "text": "别这么简单就被挑拨啦…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902207",
            "objective": "解开荆棘封锁的洞口",
            "dialogues": [
                {
                    "id": "790220701",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，这个藏镜仕女给人感觉好奇怪啊…"
                },
                {
                    "id": "790220702",
                    "speaker": "阿加菲娅",
                    "text": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…"
                },
                {
                    "id": "790220703",
                    "speaker": "派蒙",
                    "text": "喂，愚人众的…"
                },
                {
                    "id": "790220704",
                    "speaker": "阿加菲娅",
                    "text": "哥哥们的照片…丢了照片，就回不去了…"
                },
                {
                    "id": "790220705",
                    "speaker": "派蒙",
                    "text": "愚人众的！"
                },
                {
                    "id": "790220706",
                    "speaker": "阿加菲娅",
                    "text": "不能，把他丢下…不能让他一个人…",
                    "choices": [
                        {
                            "id": "790220707",
                            "text": "状态不太对呢…",
                            "response": [
                                {
                                    "id": "790220709",
                                    "speaker": "派蒙",
                                    "text": "总觉得看到过类似的场景啊…"
                                },
                                {
                                    "id": "790220710",
                                    "speaker": "Player",
                                    "text": "之前的愚人众…"
                                },
                                {
                                    "id": "790220711",
                                    "speaker": "派蒙",
                                    "text": "是哦，之前碰到叶夫卡的时候，他也一直念叨着「徽记、徽记…」什么的，把徽记给他就清醒了…"
                                },
                                {
                                    "id": "790220712",
                                    "speaker": "派蒙",
                                    "text": "愚人众在这里做实验，结果连自己的人都被影响了，这就叫「恶有恶报」！"
                                },
                                {
                                    "id": "790220713",
                                    "speaker": "Player",
                                    "text": "派蒙说的对！"
                                },
                                {
                                    "id": "790220714",
                                    "speaker": "派蒙",
                                    "text": "这么说来，这个藏镜仕女是不是就是叶夫卡说的，他们小队的成员啊…"
                                },
                                {
                                    "id": "790220715",
                                    "speaker": "派蒙",
                                    "text": "那我们是不是也要找到什么让她清醒过来…"
                                },
                                {
                                    "id": "790220716",
                                    "speaker": "阿加菲娅",
                                    "text": "哥哥们和我的合照…要是那个找不回来了，我就没法回去，可是…可是他还在那里，独自等着我…"
                                },
                                {
                                    "id": "790220717",
                                    "speaker": "派蒙",
                                    "text": "#我明白了…{NICKNAME}，看来得把她心心念念的那个合照给她，她才会醒过来了。"
                                }
                            ]
                        },
                        {
                            "id": "790220708",
                            "text": "没法沟通啊…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902208",
            "objective": "进入洞口与阿加菲娅对话",
            "dialogues": [
                {
                    "id": "790220801",
                    "speaker": "阿加菲娅",
                    "text": "扎哈尔，扎哈尔…你没事吧？"
                },
                {
                    "id": "790220802",
                    "speaker": "扎哈尔",
                    "text": "阿加霞，怎么了，出什么事了…我只是在这儿睡了一觉，不过身体已经舒服很多啦。"
                },
                {
                    "id": "790220803",
                    "speaker": "阿加菲娅",
                    "text": "唉…你没事就好。"
                },
                {
                    "id": "790220804",
                    "speaker": "扎哈尔",
                    "text": "嘿嘿，对了，阿加霞，你之前给我的果子，你给了我四个，我可一个都没吃呢，就等你回来一起吃。"
                },
                {
                    "id": "790220805",
                    "speaker": "阿加菲娅",
                    "text": "真是的，本来就是给你摘的苹果…要是等太久饿了，就先吃嘛。"
                },
                {
                    "id": "790220806",
                    "speaker": "扎哈尔",
                    "text": "可是你独自去做任务，更辛苦…虽然很饿，但是扎哈尔忍住了！"
                },
                {
                    "id": "790220807",
                    "speaker": "派蒙",
                    "text": "哦？独自去做任务呀，是做了什么任务呢…"
                },
                {
                    "id": "790220808",
                    "speaker": "扎哈尔",
                    "text": "啊，不就是因为雅科夫差点弄坏了设备，所以…"
                },
                {
                    "id": "790220809",
                    "speaker": "阿加菲娅",
                    "text": "扎哈尔！你怎么什么词都敢往外捅啊！"
                },
                {
                    "id": "790220810",
                    "speaker": "扎哈尔",
                    "text": "#啊！你们，这不是内部文件上的，{NICKNAME}和…"
                },
                {
                    "id": "790220811",
                    "speaker": "Player",
                    "text": "「小飞人」。"
                },
                {
                    "id": "790220812",
                    "speaker": "扎哈尔",
                    "text": "对，是「小飞人」！"
                },
                {
                    "id": "790220813",
                    "speaker": "派蒙",
                    "text": "我已经说腻了，我的名字是「派蒙」啦。"
                },
                {
                    "id": "790220814",
                    "speaker": "扎哈尔",
                    "text": "嘿嘿，我脑袋不太好使，我的名字是扎哈尔…不对，你们和我们愚人众不是…不是敌人吗！"
                },
                {
                    "id": "790220815",
                    "speaker": "扎哈尔",
                    "text": "阿加菲娅，是你把敌人带到这里来的？"
                },
                {
                    "id": "790220816",
                    "speaker": "阿加菲娅",
                    "text": "对，这两位就是把你从荆棘里救出来的好心…救出来的好敌人。"
                },
                {
                    "id": "790220817",
                    "speaker": "扎哈尔",
                    "text": "对哦，你走了以后不久，这里突然长出了巨大的荆棘，把山洞封起来了…是你们把那个巨大荆棘消灭掉的吗，了不起啊！"
                },
                {
                    "id": "790220818",
                    "speaker": "派蒙",
                    "text": "正是如此！"
                },
                {
                    "id": "790220819",
                    "speaker": "扎哈尔",
                    "text": "可是我们不是敌人嘛，为什么要做帮助敌人的事呢？"
                },
                {
                    "id": "790220820",
                    "speaker": "派蒙",
                    "text": "真是个让人有点答不上来的好问题…"
                },
                {
                    "id": "790220821",
                    "speaker": "派蒙",
                    "text": "当然是因为她答应了，如果我们把你救出来，她就告诉我们，你们几个到底在干什么…"
                },
                {
                    "id": "790220822",
                    "speaker": "扎哈尔",
                    "text": "阿加菲娅，你居然出卖愚人众的情报！"
                },
                {
                    "id": "790220823",
                    "speaker": "阿加菲娅",
                    "text": "没关系的，扎哈尔，到时候我们随便说些什么「愚人众在这片海域捕猎神秘花鳉」之类的话糊弄过去就是了。"
                },
                {
                    "id": "790220824",
                    "speaker": "派蒙",
                    "text": "哇，居然光明正大地说要糊弄我们，真是被小瞧了。"
                },
                {
                    "id": "790220825",
                    "speaker": "派蒙",
                    "text": "好了，荆棘也打开了，扎哈尔也救出来了，该说出你们要做什么事了吧…"
                },
                {
                    "id": "790220826",
                    "speaker": "扎哈尔",
                    "text": "不能说呀，阿加菲娅。"
                },
                {
                    "id": "790220827",
                    "speaker": "阿加菲娅",
                    "text": "唉，都到了这个时候了…不过说实话。其实我们也不太清楚，只是过来做测试的而已。",
                    "choices": [
                        {
                            "id": "790220828",
                            "text": "测试？",
                            "response": [
                                {
                                    "id": "790220830",
                                    "speaker": "阿加菲娅",
                                    "text": "大概是什么信号测试吧…具体的我也不清楚，不过如果是小队里的另一组人，应该知道。"
                                },
                                {
                                    "id": "790220831",
                                    "speaker": "派蒙",
                                    "text": "只有这些吗…"
                                },
                                {
                                    "id": "790220832",
                                    "speaker": "阿加菲娅",
                                    "text": "我知道的也不多嘛…对了，情报也说了，你们可以放我们走了吧。"
                                },
                                {
                                    "id": "790220833",
                                    "speaker": "派蒙",
                                    "text": "虽然好像没有答应过会放你们走，不过看上去也没什么危险…"
                                },
                                {
                                    "id": "790220834",
                                    "speaker": "Player",
                                    "text": "那就算我们大发慈悲…"
                                },
                                {
                                    "id": "790220835",
                                    "speaker": "阿加菲娅",
                                    "text": "欸呀，那还真是感谢了。唉，也不知道<color=#00E1FFFF>另一组的家伙们</color>怎么样了，我们当时约好，说做完任务就回海域中间的营地…"
                                },
                                {
                                    "id": "790220836",
                                    "speaker": "派蒙",
                                    "text": "另一组人？"
                                },
                                {
                                    "id": "790220837",
                                    "speaker": "阿加菲娅",
                                    "text": "对，也是两个人，说是要朝着<color=#00E1FFFF>南方的两个岛</color>的方向去了…啊，这可是额外的情报，可不是无意中被套话了哦。"
                                },
                                {
                                    "id": "790220838",
                                    "speaker": "派蒙",
                                    "text": "南方的大岛上…那就是危危岛吧！"
                                },
                                {
                                    "id": "790220839",
                                    "speaker": "阿加菲娅",
                                    "text": "好了好了，不能再说了，我们得快点回海域中央岛屿上的营地才行…"
                                }
                            ]
                        },
                        {
                            "id": "790220829",
                            "text": "什么测试？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7902211",
            "objective": "寻找另一个小队成员的线索",
            "dialogues": [
                {
                    "id": "790221101",
                    "speaker": "派蒙",
                    "text": "对了…说起来，我们在这个岛上不是捡到了一个怀表，那个怀表里有一张合照，会不会就是那一张啊…"
                },
                {
                    "id": "790221102",
                    "speaker": "Player",
                    "text": "把怀表给她试试看吧。"
                }
            ]
        },
        {
            "id": "7902212",
            "objective": "唤醒愚人众$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7902216",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790221601",
                    "speaker": "派蒙",
                    "text": "快，把怀表里的合照拿出来给她看看吧！"
                },
                {
                    "id": "790221602",
                    "speaker": "Player",
                    "text": "把怀表给她试试看吧。"
                }
            ]
        },
        {
            "id": "7902218",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790221801",
                    "speaker": "阿加菲娅",
                    "text": "啊，扎哈尔，扎哈尔你一定要平安无事啊…怎么了，还没打开荆棘封住的洞口吗？",
                    "choices": [
                        {
                            "id": "790221802",
                            "text": "你们到底是来做什么的…",
                            "response": [
                                {
                                    "id": "790221803",
                                    "speaker": "阿加菲娅",
                                    "text": "只是一些跑腿的工作罢了，言尽于此，再问的话我也不会多说。"
                                }
                            ]
                        },
                        {
                            "id": "790221804",
                            "text": "扎哈尔是谁…",
                            "response": [
                                {
                                    "id": "790221805",
                                    "speaker": "阿加菲娅",
                                    "text": "扎哈尔是我的队友，他身体有点不舒服…"
                                },
                                {
                                    "id": "790221806",
                                    "speaker": "阿加菲娅",
                                    "text": "真不知道他有没有出什么事啊…"
                                }
                            ]
                        },
                        {
                            "id": "790221807",
                            "text": "关于怀表里的合照…",
                            "response": [
                                {
                                    "id": "790221808",
                                    "speaker": "阿加菲娅",
                                    "text": "不行，那个跟愚人众没什么关系，也没有什么好告诉你的。你帮我找回了怀表我很感激，可也不能说…"
                                }
                            ]
                        },
                        {
                            "id": "790221809",
                            "text": "再见…"
                        }
                    ]
                }
            ]
        },
        {
