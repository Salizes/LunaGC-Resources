            "objective": "(test)子任务描述Test$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4017305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401730501",
                    "speaker": "茜特菈莉",
                    "text": "#{NICKNAME}，有事吗？"
                },
                {
                    "id": "401730502",
                    "speaker": "茜特菈莉",
                    "text": "我稍后要去首领那里还仪式剑，营地的其他东西就暂时留在这里。你有兴趣的话可以随便使用。"
                },
                {
                    "id": "401730503",
                    "speaker": "Player",
                    "text": "我有一本《蜃楼战记》最新卷…"
                },
                {
                    "id": "401730504",
                    "speaker": "茜特菈莉",
                    "text": "欸？"
                },
                {
                    "id": "401730505",
                    "speaker": "Player",
                    "text": "还有《奥西兹小姐事件簿》番外…"
                },
                {
                    "id": "401730506",
                    "speaker": "茜特菈莉",
                    "text": "欸欸欸？！"
                },
                {
                    "id": "401730507",
                    "speaker": "Player",
                    "text": "要来一起看看吗？"
                },
                {
                    "id": "401730508",
                    "speaker": "茜特菈莉",
                    "text": "唔…"
                },
                {
                    "id": "401730509",
                    "speaker": "茜特菈莉",
                    "text": "#（怎么回事？怎么回事？{M#他}{F#她}怎么知道我喜欢那些？难道，{M#他}{F#她}在关注我？！）"
                },
                {
                    "id": "401730510",
                    "speaker": "茜特菈莉",
                    "text": "（不，我怎么会有这种不切实际的想法…肯定是欧洛伦暴露了我，可恶…）"
                },
                {
                    "id": "401730511",
                    "speaker": "茜特菈莉",
                    "text": "#（可…{M#他}{F#她}记住我的喜好了吗？欸？其实不记住也没关系，又不是什么重要的事…）"
                },
                {
                    "id": "401730512",
                    "speaker": "茜特菈莉",
                    "text": "#（但…{M#他}{F#她}正在邀请我欸！怎么办怎么办，要怎么回应？）"
                },
                {
                    "id": "401730513",
                    "speaker": "茜特菈莉",
                    "text": "咳咳…"
                },
                {
                    "id": "401730514",
                    "speaker": "茜特菈莉",
                    "text": "好啊，有空吧，等我忙完。"
                }
            ]
        }
    ]
}