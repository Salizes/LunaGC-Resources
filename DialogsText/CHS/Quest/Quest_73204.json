    "talks": [
        {
            "id": "7320410",
            "objective": "(test)73203与赛芭闲聊$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320401",
            "objective": "(test)与老者对话$HIDDEN",
            "dialogues": [
                {
                    "id": "732040101",
                    "speaker": "阿凡",
                    "text": "两个小娃娃干什么呢，你们也是来看我这个「种石头」老头笑话的？"
                },
                {
                    "id": "732040102",
                    "speaker": "阿凡",
                    "text": "我好着呢，用不着村里人费心。"
                },
                {
                    "id": "732040103",
                    "speaker": "派蒙",
                    "text": "呜哇，不用一上来就这么大敌意吧。"
                },
                {
                    "id": "732040104",
                    "speaker": "派蒙",
                    "text": "你搞错了，我们不是阿如村的人，也不是来看笑话的。",
                    "choices": [
                        {
                            "id": "732040105",
                            "text": "我们只是路过。",
                            "response": [
                                {
                                    "id": "732040106",
                                    "speaker": "阿凡",
                                    "text": "路过的人？这个…"
                                },
                                {
                                    "id": "732040110",
                                    "speaker": "阿凡",
                                    "text": "平时只有几个老相识会来我这儿，一个劲叫我放弃这里的苗圃，搬回村子。"
                                },
                                {
                                    "id": "732040111",
                                    "speaker": "阿凡",
                                    "text": "还有几个坏小子，老是跑到我这里来调皮捣蛋。"
                                },
                                {
                                    "id": "732040112",
                                    "speaker": "阿凡",
                                    "text": "我倒是第一次见到打扮成你们这样的，两个小娃娃，你们是做什么的？",
                                    "choices": [
                                        {
                                            "id": "732040113",
                                            "text": "是正在寻亲的旅人。",
                                            "response": [
                                                {
                                                    "id": "732040114",
                                                    "speaker": "派蒙",
                                                    "text": "是啊，为了这个目标，我们走过了很远的路，一路冒险一路寻找。"
                                                },
                                                {
                                                    "id": "732040115",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}{M#他}{F#她}啊，是个很有正义感的人。"
                                                },
                                                {
                                                    "id": "732040119",
                                                    "speaker": "派蒙",
                                                    "text": "欺负独居老人什么的，这种事我们才不会干呢。"
                                                },
                                                {
                                                    "id": "732040120",
                                                    "speaker": "派蒙",
                                                    "text": "所以老爷爷，你不用担心啦，我们不是坏人。"
                                                },
                                                {
                                                    "id": "732040121",
                                                    "speaker": "阿凡",
                                                    "text": "咳咳，让我给两个小娃娃道歉还真是有点不好意思，谁叫我没看清楚就胡说呢。"
                                                },
                                                {
                                                    "id": "732040122",
                                                    "speaker": "阿凡",
                                                    "text": "两个小娃娃，老头阿凡给你们道歉啦。"
                                                },
                                                {
                                                    "id": "732040123",
                                                    "speaker": "阿凡",
                                                    "text": "你们年纪还这么轻，就自己养活自己了，挺有本事的，比我年轻时候强。"
                                                },
                                                {
                                                    "id": "732040124",
                                                    "speaker": "阿凡",
                                                    "text": "照你们刚才那么说，如果我遇上了解决不了的麻烦，是不是也能委托你们帮忙？"
                                                },
                                                {
                                                    "id": "732040125",
                                                    "speaker": "派蒙",
                                                    "text": "哦？这是有工作要委托我们的意思吗？"
                                                },
                                                {
                                                    "id": "732040126",
                                                    "speaker": "Player",
                                                    "text": "遇到了什么问题？"
                                                },
                                                {
                                                    "id": "732040127",
                                                    "speaker": "阿凡",
                                                    "text": "我原本开了两块苗圃，这里是一块，另外一块在村子的西边。"
                                                },
                                                {
                                                    "id": "732040128",
                                                    "speaker": "阿凡",
                                                    "text": "也是我年纪大了，之前一个人照看不过来，几天没去看，另外那块苗圃就被黑乎乎的奇怪东西给祸害了。"
                                                },
                                                {
                                                    "id": "732040129",
                                                    "speaker": "阿凡",
                                                    "text": "危险得很，进去一次我差点就出不来了，吓得我再也不敢往那片地里跑。"
                                                },
                                                {
                                                    "id": "732040130",
                                                    "speaker": "阿凡",
                                                    "text": "我现在最大的希望就是把苗圃的地治好，方便以后再种上花。"
                                                },
                                                {
                                                    "id": "732040131",
                                                    "speaker": "派蒙",
                                                    "text": "#听起来不太复杂。怎么样？{NICKNAME}，我们要不要接受这个委托？"
                                                },
                                                {
                                                    "id": "732040132",
                                                    "speaker": "Player",
                                                    "text": "没问题。"
                                                },
                                                {
                                                    "id": "732040133",
                                                    "speaker": "阿凡",
                                                    "text": "那块苗圃在村子西边，你们可别走错路啊。"
                                                },
                                                {
                                                    "id": "732040134",
                                                    "speaker": "派蒙",
                                                    "text": "小意思，你就放心吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732040116",
                                            "text": "是探索世界的冒险家。",
                                            "response": [
                                                {
                                                    "id": "732040117",
                                                    "speaker": "派蒙",
                                                    "text": "是啊，我们翻越了好多好多座高山，跨越了好大好大的水泊，来到了须弥。"
                                                },
                                                {
                                                    "id": "732040118",
                                                    "speaker": "派蒙",
                                                    "text": "那个话怎么说来着，我们是…嗯…心胸宽广的冒险家。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732040107",
                            "text": "听说这里有人在种花。",
                            "response": [
                                {
                                    "id": "732040108",
                                    "speaker": "阿凡",
                                    "text": "没错，我种的是花，可不是什么烂石头。"
                                },
                                {
                                    "id": "732040109",
                                    "speaker": "阿凡",
                                    "text": "我刚才还以为…哎哟，叫我说什么呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320409",
            "objective": "前往阿凡的苗圃",
            "dialogues": []
        },
        {
            "id": "7320402",
            "objective": "清理阿凡的苗圃",
            "dialogues": []
        },
        {
            "id": "7320404",
            "objective": "与阿凡对话",
            "dialogues": [
                {
                    "id": "732040401",
                    "speaker": "阿凡",
                    "text": "你们两个回来了？那块苗圃的状态怎么样，你们觉得它有救不？"
                },
                {
                    "id": "732040402",
                    "speaker": "Player",
                    "text": "已经解决了。"
                },
                {
                    "id": "732040403",
                    "speaker": "Black Screen",
                    "text": "将死域的事解释给阿凡听。"
                },
                {
                    "id": "732040404",
                    "speaker": "阿凡",
                    "text": "原来是这么回事，我就说好端端的地里怎么会突然冒出这么多黑乎乎的怪东西。"
                },
                {
                    "id": "732040405",
                    "speaker": "阿凡",
                    "text": "好好好，这下我可以安心把种子种上了。"
                },
                {
                    "id": "732040406",
                    "speaker": "阿凡",
                    "text": "等这三颗种子发芽开花结新种子，再往那块地里种，以后这花就能开得到处都是了。"
                },
                {
                    "id": "732040407",
                    "speaker": "派蒙",
                    "text": "欸，这些…形状奇怪的石头吗？它们能长出花来？"
                },
                {
                    "id": "732040408",
                    "speaker": "派蒙",
                    "text": "阿凡爷爷，你这是在哪里买来的呀，别被人骗了。"
                },
                {
                    "id": "732040409",
                    "speaker": "阿凡",
                    "text": "这个小娃娃心地还挺好，你们放心，摩拉可买不到这些花种子。"
                },
                {
                    "id": "732040410",
                    "speaker": "阿凡",
                    "text": "这三颗都是鬼…咳咳…一个朋友留给我的珍贵种子，当然跟普通的果子啊花苗啊不同。"
                },
                {
                    "id": "732040411",
                    "speaker": "派蒙",
                    "text": "越听越奇怪呢，阿凡爷爷，你种的到底是什么呀？"
                },
                {
                    "id": "732040412",
                    "speaker": "阿凡",
                    "text": "呵呵，我种的是一个朋友的嘱托，是他的愿望。"
                },
                {
                    "id": "732040413",
                    "speaker": "派蒙",
                    "text": "好奇怪的说法，这种东西是可以种的吗？"
                },
                {
                    "id": "732040414",
                    "speaker": "阿凡",
                    "text": "小娃娃，跟你说了你也不会明白的，以后有机会再来看看吧。"
                },
                {
                    "id": "732040415",
                    "speaker": "阿凡",
                    "text": "别看这里现在空荡荡的，将来这片苗圃里的三颗种子都会发芽开花。"
                },
                {
                    "id": "732040416",
                    "speaker": "阿凡",
                    "text": "以后它们会越长越多的，哈哈，那时候一定很漂亮。"
                },
                {
                    "id": "732040417",
                    "speaker": "阿凡",
                    "text": "好了好了，说好了委托你们帮忙，报酬我是不会赖着不给的。"
                },
                {
                    "id": "732040418",
                    "speaker": "阿凡",
                    "text": "你们俩拿着吧，我能给的也不多，都在这里了。"
                },
                {
                    "id": "732040419",
                    "speaker": "派蒙",
                    "text": "呼，委托完成，跑了这半天感觉肚子有点饿。"
                },
                {
                    "id": "732040420",
                    "speaker": "Player",
                    "text": "明明都是我在跑。"
                },
                {
                    "id": "732040421",
                    "speaker": "派蒙",
                    "text": "我也有一路陪你说话嘛，说话也是会消耗能量的。"
                },
                {
                    "id": "732040422",
                    "speaker": "派蒙",
                    "text": "#别那么小气啦，{NICKNAME}，我们拿上酬金去买点好吃的犒劳自己一下，怎么样？"
                },
                {
                    "id": "732040423",
                    "speaker": "派蒙",
                    "text": "快看看报酬有多少，够我们吃几顿。"
                },
                {
                    "id": "732040424",
                    "speaker": "Player",
                    "text": "我看看。"
                },
                {
                    "id": "732040425",
                    "speaker": "派蒙",
                    "text": "欸，比起摩拉，更多的是食物…烤肉卷、米圆塔，还有好多蔬菜。"
                },
                {
                    "id": "732040426",
                    "speaker": "派蒙",
                    "text": "这也太多了。我们…是不是拿了阿凡爷爷一天的口粮啊…"
                },
                {
                    "id": "732040427",
                    "speaker": "派蒙",
                    "text": "这个阿凡爷爷一个人住在村子外面，应该也挺不容易的。"
                },
                {
                    "id": "732040428",
                    "speaker": "派蒙",
                    "text": "摩拉就算了，把口粮都给我们的话，唔…感觉有点沉重。"
                },
                {
                    "id": "732040429",
                    "speaker": "派蒙",
                    "text": "而且，他明明种着石头一样的种子，却说自己种的是…愿望？"
                },
                {
                    "id": "732040430",
                    "speaker": "派蒙",
                    "text": "你说，他会不会是一个人住了太久，产生了幻觉？"
                },
                {
                    "id": "732040431",
                    "speaker": "派蒙",
                    "text": "越想越觉得不放心，我们有空的时候就去看看他吧。"
                }
            ]
        },
