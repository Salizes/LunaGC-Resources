    },
    "talks": [
        {
            "id": "2003601",
            "objective": "前往询问葛罗丽",
            "dialogues": [
                {
                    "id": "200360101",
                    "speaker": "葛罗丽",
                    "text": "…古德温…到底什么时候能回来呢…"
                },
                {
                    "id": "200360102",
                    "speaker": "Player",
                    "text": "你好…"
                },
                {
                    "id": "200360103",
                    "speaker": "葛罗丽",
                    "text": "这个声音…是远方来的旅行者吗？感谢风神大人，一定是他的风将您带来的…请您听听我的请求吧。"
                },
                {
                    "id": "200360104",
                    "speaker": "葛罗丽",
                    "text": "我的…唔，男朋友，西风骑士古德温离开蒙德城已经很久了。"
                },
                {
                    "id": "200360105",
                    "speaker": "葛罗丽",
                    "text": "这么久了，我一直没有收到他的消息。"
                },
                {
                    "id": "200360106",
                    "speaker": "葛罗丽",
                    "text": "我很担心古德温。他要和那些难缠的丘丘人，还有他和我说过的深渊教团战斗，要是他受了伤怎么办，而且离开那么久，要是他遇见了哪位温柔的女骑士…"
                },
                {
                    "id": "200360107",
                    "speaker": "葛罗丽",
                    "text": "抱，抱歉！我，我自顾自说太多了！我听我母亲说，蒲公英能够带着人们的思念，被风一直带到很远。"
                },
                {
                    "id": "200360108",
                    "speaker": "葛罗丽",
                    "text": "所以我的请求是…能不能请您帮我去风起地搜集三份蒲公英籽？",
                    "choices": [
                        {
                            "id": "200360109",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200360111",
                                    "speaker": "葛罗丽",
                                    "text": "太感谢您了，愿风神保佑您。"
                                }
                            ]
                        },
                        {
                            "id": "200360110",
                            "text": "还有别的事。",
                            "response": [
                                {
                                    "id": "200360112",
                                    "speaker": "葛罗丽",
                                    "text": "等一下！求您了，对您这样的旅行者来说，这肯定只是举手之劳…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003602",
            "objective": "与葛罗丽对话",
            "dialogues": []
        },
        {
            "id": "2003603",
            "objective": "寻找三份蒲公英籽",
            "dialogues": [
                {
                    "id": "200360301",
                    "speaker": "葛罗丽",
                    "text": "您已经做好了吗？"
                },
                {
                    "id": "200360302",
                    "speaker": "Player",
                    "text": "顶上的风真大…"
                },
                {
                    "id": "200360303",
                    "speaker": "葛罗丽",
                    "text": "这样子才好，能让蒲公英飞得更远。"
                },
                {
                    "id": "200360304",
                    "speaker": "葛罗丽",
                    "text": "这样子，古德温说不定就能收到，我对他说的话了吧。"
                },
                {
                    "id": "200360305",
                    "speaker": "葛罗丽",
                    "text": "您伸出手来吧，让我能碰到…请拿好了，这些谢礼是给您的。"
                },
                {
                    "id": "200360306",
                    "speaker": "葛罗丽",
                    "text": "我还有很多话想要和古德温说，之后，说不定也要多多麻烦您啦。"
                }
            ]
        },
        {
            "id": "2003604",
            "objective": "将蒲公英籽交给葛罗丽",
            "dialogues": [
                {
                    "id": "200360201",
                    "speaker": "葛罗丽",
                    "text": "您回来了，蒲公英搜集到了吗？"
                },
                {
                    "id": "200360202",
                    "speaker": "Player",
                    "text": "已经搜集好了。"
                },
                {
                    "id": "200360203",
                    "speaker": "葛罗丽",
                    "text": "谢谢您，请您把蒲公英籽放在我手上，好吗？我看不见，怕把它们都弄撒了"
                },
                {
                    "id": "200360204",
                    "speaker": "Player",
                    "text": "这些够了吗？"
                },
                {
                    "id": "200360205",
                    "speaker": "葛罗丽",
                    "text": "请您先把蒲公英籽放在我手上吧，这样我才能感受一下它们…"
                },
                {
                    "id": "200360206",
                    "speaker": "葛罗丽",
                    "text": "这些就够了，我要把想和古德温说的话都告诉它们才行…"
                },
                {
                    "id": "200360207",
                    "speaker": "葛罗丽",
                    "text": "唔——请您捂住耳朵，别偷听，这是恋人之间的悄悄话哦。您肯定也…嘻嘻，您有过这种体验吗？"
                },
                {
                    "id": "200360208",
                    "speaker": "葛罗丽",
                    "text": "好啦。请您带着这些蒲公英籽去风神像上，然后把它们洒在风中，让风神大人带走它们吧。"
                },
                {
                    "id": "200360209",
                    "speaker": "葛罗丽",
                    "text": "希望风神大人，能够把它们带到古德温身边。"
                }
            ]
        },
        {
            "id": "2003605",
            "objective": "前往风神像顶端播撒蒲公英籽",
            "dialogues": []
        },
        {
