    "talks": [
        {
            "id": "7155513",
            "objective": "进考古营地任务完成$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7155500",
            "objective": "进圈调查后接任务$HIDDEN",
            "dialogues": [
                {
                    "id": "715550001",
                    "speaker": "派蒙",
                    "text": "这本日记，好像是一位学者的呢。"
                },
                {
                    "id": "715550002",
                    "speaker": "派蒙",
                    "text": "看起来…她好像被盗宝团盯上了，希望她已经安全离开了…"
                }
            ]
        },
        {
            "id": "7155502",
            "objective": "调查奇怪的扎营地",
            "dialogues": [
                {
                    "id": "715550201",
                    "speaker": "派蒙",
                    "text": "在这里扎营的那位学者，说不定真的遇到了危险。"
                },
                {
                    "id": "715550202",
                    "speaker": "派蒙",
                    "text": "我们四处找找看吧，说不定能找到什么线索呢。"
                },
                {
                    "id": "715550203",
                    "speaker": "派蒙",
                    "text": "而且，那位学者在这里研究这么久，一定对这里很了解。"
                },
                {
                    "id": "715550204",
                    "speaker": "派蒙",
                    "text": "要是这里有宝藏的话，这位学者说不定也…"
                }
            ]
        },
        {
            "id": "7155503",
            "objective": "test日志对话1$HIDDEN",
            "dialogues": [
                {
                    "id": "715550301",
                    "speaker": "笔迹端正的日记",
                    "text": "「…还是没有任何线索，果然我就不该选璃月作为研究地，再这么下去，我肯定又要空手回去了…」"
                },
                {
                    "id": "715550302",
                    "speaker": "笔迹端正的日记",
                    "text": "「空手回去，我非得被那个老头子念叨疯了不可…索拉雅小姐好像也在璃月做研究，似乎是住在『望舒客栈』，她要是能帮帮我的话…」"
                },
                {
                    "id": "715550303",
                    "speaker": "笔迹端正的日记",
                    "text": "「唉，索拉雅小姐还是没回信，我突然写信过去是不是有点太失礼了？我们之前也就是上过同一门课而已。」"
                },
                {
                    "id": "715550304",
                    "speaker": "笔迹端正的日记",
                    "text": "「她说不定都不记得我了…再呆几天吧，再没线索，我就只能回去了…」"
                },
                {
                    "id": "715550305",
                    "speaker": "笔迹端正的日记",
                    "text": "「索拉雅小姐的研究方法真厉害！原来还能从这种角度来切入，要是能早点向她请教，我就不用浪费这么多时间了…」"
                },
                {
                    "id": "715550306",
                    "speaker": "笔迹端正的日记",
                    "text": "「不过她让我小心一些，最好不要在野外露宿，笔记一定要贴身带着，不然说不定会招来盗宝团…」"
                },
                {
                    "id": "715550307",
                    "speaker": "笔迹端正的日记",
                    "text": "「不会吧，盗宝团有这么嚣张吗？算了，反正过几天我就走了…」"
                },
                {
                    "id": "715550308",
                    "speaker": "笔迹端正的日记",
                    "text": "「…不知道是不是我多心了，我好像看见<color=#00E1FFFF>西边的山上 </color>有人影…营地里好像进来过人，我的笔记也被人翻过了…」"
                },
                {
                    "id": "715550309",
                    "speaker": "笔迹端正的日记",
                    "text": "「索拉雅小姐说得对，我要赶紧离开这里…」"
                }
            ]
        },
        {
            "id": "7155501",
            "objective": "派蒙日志对话完成$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7155504",
