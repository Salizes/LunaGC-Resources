            "dialogues": []
        },
        {
            "id": "7155508",
            "objective": "解救考古学家-隐藏任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7155517",
            "objective": "痕迹对话3$HIDDEN",
            "dialogues": [
                {
                    "id": "715551701",
                    "speaker": "派蒙",
                    "text": "咦？这里刻着字。"
                },
                {
                    "id": "715551702",
                    "speaker": "派蒙",
                    "text": "「他们要带我去山上，救救我。」"
                },
                {
                    "id": "715551703",
                    "speaker": "派蒙",
                    "text": "一定是那位学者，我们快去山上吧！"
                }
            ]
        },
        {
            "id": "7155509",
            "objective": "打倒盗宝团，获得钥匙",
            "dialogues": [
                {
                    "id": "715550901",
                    "speaker": "爱拉尼",
                    "text": "test救命！钥匙在他们身上！"
                }
            ]
        },
        {
            "id": "7155512",
            "objective": "打开笼子",
            "dialogues": []
        },
        {
            "id": "7155510",
            "objective": "与爱拉尼对话",
            "dialogues": [
                {
                    "id": "715551001",
                    "speaker": "爱拉尼",
                    "text": "谢谢你们，我还以为我彻底完了…这帮盗宝团应该是一直在跟踪我。"
                },
                {
                    "id": "715551002",
                    "speaker": "爱拉尼",
                    "text": "我对这片遗迹的研究刚刚有了进展，想着要是能挖出埋藏在这里的宝藏带回去就再好不过了…"
                },
                {
                    "id": "715551003",
                    "speaker": "爱拉尼",
                    "text": "但是还没等我做好准备，盗宝团就闯进营地，把我给绑起来带到了这里。"
                },
                {
                    "id": "715551004",
                    "speaker": "爱拉尼",
                    "text": "他们还一直逼问我宝藏的下落，还威胁我说，如果我不把宝藏地点说出来，他们就要了我的命。"
                },
                {
                    "id": "715551005",
                    "speaker": "爱拉尼",
                    "text": "不过我知道，要是我直接把宝藏的线索告诉了他们，那我才是真不要命了…"
                },
                {
                    "id": "715551006",
                    "speaker": "爱拉尼",
                    "text": "唉，我果然该听索拉雅小姐的话，考古学家最好别太在意宝藏，只要有学术上的收获就好。"
                },
                {
                    "id": "715551007",
                    "speaker": "爱拉尼",
                    "text": "但是我的经费就这么一点，光是几篇论文，连我自己掏的来往路费都填不平…"
                },
                {
                    "id": "715551008",
                    "speaker": "爱拉尼",
                    "text": "也不知道索拉雅小姐是怎么做到一个人在璃月研究这么久的，光是看她被拒的那么多论文，我都替她觉得累。"
                },
                {
                    "id": "715551009",
                    "speaker": "Player",
                    "text": "那你接下来打算怎么办？"
                },
                {
                    "id": "715551010",
                    "speaker": "爱拉尼",
                    "text": "还能怎么办，学术上的资料我已经搜集齐了，宝藏什么的…就算了，就让给你们吧。"
                },
                {
                    "id": "715551011",
                    "speaker": "爱拉尼",
                    "text": "杂七杂八的推导过程我就不说啦，总之，宝藏就埋在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>。"
                },
                {
                    "id": "715551012",
                    "speaker": "爱拉尼",
                    "text": "你们要的话就去拿吧，我把地址写下来给你们，免得你们忘了。"
                },
                {
                    "id": "715551013",
                    "speaker": "爱拉尼",
                    "text": "我休息一会就回营地收拾东西，我要尽快离开这，免得又有盗宝团过来…"
                },
                {
                    "id": "715551014",
                    "speaker": "爱拉尼",
                    "text": "不知道从这里走去望舒客栈要花多长时间，别等我到了望舒客栈，索拉雅小姐已经走了。"
                },
                {
                    "id": "715551015",
                    "speaker": "爱拉尼",
                    "text": "唉，要是索拉雅小姐能做我的导师就好了…"
                }
            ]
        },
        {
            "id": "7155511",
            "objective": "获得宝藏",
            "dialogues": [
                {
                    "id": "715551101",
                    "speaker": "爱拉尼",
                    "text": "笔记…笔记…还好没缺页…"
                },
                {
                    "id": "715551102",
                    "speaker": "爱拉尼",
                    "text": "咦？你们还没找到吗？宝藏就在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>，你们想要的话，就快点去拿吧。"
                }
            ]
        },
