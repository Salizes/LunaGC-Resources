    "talks": [
        {
            "id": "7332702",
            "objective": "",
            "dialogues": [
                {
                    "id": "733270201",
                    "speaker": "婕德",
                    "text": "#一千个拥抱，{NICKNAME}！我们一定还会再见的！"
                }
            ]
        },
        {
            "id": "7332701",
            "objective": "",
            "dialogues": [
                {
                    "id": "733270101",
                    "speaker": "婕德",
                    "text": "#{NICKNAME}？！是你…是你吗！"
                },
                {
                    "id": "733270102",
                    "speaker": "婕德",
                    "text": "还有派蒙！真没想到在这里遇到你们！"
                },
                {
                    "id": "733270103",
                    "speaker": "派蒙",
                    "text": "婕德！！真的是你！"
                },
                {
                    "id": "733270104",
                    "speaker": "婕德",
                    "text": "哈哈，你小点声啦！把我的鱼都吵走了！"
                },
                {
                    "id": "733270105",
                    "speaker": "奔奔",
                    "text": "哔哔——！"
                },
                {
                    "id": "733270106",
                    "speaker": "派蒙",
                    "text": "欸…你们在钓鱼吗？可是怎么没有看到鱼竿…"
                },
                {
                    "id": "733270107",
                    "speaker": "奔奔",
                    "text": "哔…"
                },
                {
                    "id": "733270108",
                    "speaker": "婕德",
                    "text": "#奔奔，不要乱说！好啦…{NICKNAME}，我们聊聊别的话题吧？",
                    "choices": [
                        {
                            "id": "733270109",
                            "text": "你的鱼竿呢？",
                            "response": [
                                {
                                    "id": "733270110",
                                    "speaker": "婕德",
                                    "text": "你…！"
                                },
                                {
                                    "id": "733270111",
                                    "speaker": "婕德",
                                    "text": "它…自己坏掉了…嘿嘿。"
                                },
                                {
                                    "id": "733270112",
                                    "speaker": "婕德",
                                    "text": "唉…我也没想到钓鱼和打猎一点也不一样…太难了，太难了！我是没耐心枯坐在这里半天等鱼…还不如自己下河抓！"
                                },
                                {
                                    "id": "733270113",
                                    "speaker": "派蒙",
                                    "text": "结果鱼也没抓到，对吧？"
                                },
                                {
                                    "id": "733270114",
                                    "speaker": "婕德",
                                    "text": "哼，当然抓到了，好大一条，比你还长…嗯，比你还长半个奔奔！"
                                },
                                {
                                    "id": "733270115",
                                    "speaker": "奔奔",
                                    "text": "哔哔！哔哔！"
                                },
                                {
                                    "id": "733270116",
                                    "speaker": "婕德",
                                    "text": "我全都烤来吃掉了，没你的份！"
                                },
                                {
                                    "id": "733270117",
                                    "speaker": "奔奔",
                                    "text": "哔哔…？"
                                },
                                {
                                    "id": "733270118",
                                    "speaker": "婕德",
                                    "text": "嗯，还有奔奔也吃了呢，只有你没份哦！"
                                },
                                {
                                    "id": "733270119",
                                    "speaker": "派蒙",
                                    "text": "我才不信咧！"
                                },
                                {
                                    "id": "733270120",
                                    "speaker": "婕德",
                                    "text": "哈哈哈哈！你不信是你的损失啦！"
                                },
                                {
                                    "id": "733270125",
                                    "speaker": "Player",
                                    "text": "你最近过得怎样？"
                                },
                                {
                                    "id": "733270126",
                                    "speaker": "婕德",
                                    "text": "嗯？挺好的，不必担心。"
                                },
                                {
                                    "id": "733270127",
                                    "speaker": "婕德",
                                    "text": "反正也不是第一次孤身一人旅行啦…"
                                },
                                {
                                    "id": "733270128",
                                    "speaker": "奔奔",
                                    "text": "哔哔！哔哔！"
                                },
                                {
                                    "id": "733270129",
                                    "speaker": "婕德",
                                    "text": "哈哈哈，别急！我知道还有你呀！"
                                },
                                {
                                    "id": "733270130",
                                    "speaker": "婕德",
                                    "text": "自从塔尼特的事情之后，沙漠各部族都不再为我提供帐篷和食物…我没有部族的保护了。"
                                },
                                {
                                    "id": "733270131",
                                    "speaker": "婕德",
                                    "text": "后来嘛…虽说「三十人团」的鲁克沙大哥愿意接纳我，但是…城里让我很不自在，让我想起母亲…嗯。"
                                },
                                {
                                    "id": "733270132",
                                    "speaker": "婕德",
                                    "text": "所以我告别了须弥城，想着…还是去另一个国家吧，看看此前没见过的景色。"
                                },
                                {
                                    "id": "733270133",
                                    "speaker": "婕德",
                                    "text": "于是，我登上商船，不知不觉就来到了这里。"
                                },
                                {
                                    "id": "733270134",
                                    "speaker": "婕德",
                                    "text": "再然后嘛…哈哈，没什么好讲的啦！不管哪里都需要保镖嘛，尤其这种商队来来往往的大城市！所以我的日子过得还不错。"
                                },
                                {
                                    "id": "733270135",
                                    "speaker": "婕德",
                                    "text": "嘿嘿，就这样吧…就这样过四海为家的日子也挺好的。"
                                },
                                {
                                    "id": "733270136",
                                    "speaker": "婕德",
                                    "text": "我和奔奔，就像你和派蒙，不是吗？"
                                },
                                {
                                    "id": "733270137",
                                    "speaker": "派蒙",
                                    "text": "哼，奔奔可不如我！"
                                },
                                {
                                    "id": "733270138",
                                    "speaker": "奔奔",
                                    "text": "哔哔！！"
                                },
                                {
                                    "id": "733270139",
                                    "speaker": "婕德",
                                    "text": "#哈哈哈，好啦好啦…{NICKNAME}，我就不多留你们啦。本来还想请你们一起大吃一顿的，但镖局的规定…唉…"
                                },
                                {
                                    "id": "733270140",
                                    "speaker": "婕德",
                                    "text": "咳咳！不说不开心的事情了！给你一千个拥抱，祝你接下来的旅途一路平安！"
                                },
                                {
                                    "id": "733270141",
                                    "speaker": "婕德",
                                    "text": "#{M#别忘啦，我们的旅途，总有一天会再次相交呢！}{F#…先前在塔尼特那边，我和你说的话，你也不要忘记呀。等你什么时候累了，想要歇息了…我们也许会再次相遇。}"
                                }
                            ]
                        },
                        {
                            "id": "733270121",
                            "text": "没想到会在这里遇到你。",
                            "response": [
                                {
                                    "id": "733270122",
                                    "speaker": "婕德",
                                    "text": "嗯…我、我也没想到会在这里遇到你们，真的很开心。"
                                },
                                {
                                    "id": "733270123",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我们没打扰你钓…抓鱼吧？"
                                },
                                {
                                    "id": "733270124",
                                    "speaker": "婕德",
                                    "text": "闭嘴啦，小派蒙！就你话多！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}