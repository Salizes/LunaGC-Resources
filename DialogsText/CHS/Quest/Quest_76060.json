        }
    },
    "talks": [
        {
            "id": "7606001",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760600101",
                    "speaker": "梅拉",
                    "text": "……"
                },
                {
                    "id": "760600102",
                    "speaker": "派蒙",
                    "text": "咦？这不是梅拉吗？它又出去取材了？"
                },
                {
                    "id": "760600103",
                    "speaker": "「少女」",
                    "text": "嗯，但它回来后就一直这样，像是在思考什么一样。"
                },
                {
                    "id": "760600104",
                    "speaker": "派蒙",
                    "text": "说不定这次的主题比较深刻呢，就像大画家突然顿悟了世间真理什么的。"
                },
                {
                    "id": "760600105",
                    "speaker": "派蒙",
                    "text": "说起来，梅拉已经给过我们好多幅画了呢，要是再这么画下去的话，都可以为它专门办个画展了吧？"
                },
                {
                    "id": "760600106",
                    "speaker": "派蒙",
                    "text": "哼哼，到时候就由我来为人们讲述大画家梅拉的创作历程。当然，真要办画展的话，也得哥伦比娅同意才行。"
                },
                {
                    "id": "760600107",
                    "speaker": "「少女」",
                    "text": "嗯？为什么？"
                },
                {
                    "id": "760600108",
                    "speaker": "Player",
                    "text": "梅拉画的几乎都是你…"
                },
                {
                    "id": "760600109",
                    "speaker": "「少女」",
                    "text": "哦，没事，我不介意。听起来挺有趣的。"
                },
                {
                    "id": "760600110",
                    "speaker": "梅拉",
                    "text": "~！"
                },
                {
                    "id": "760600111",
                    "speaker": "派蒙",
                    "text": "哦！梅拉好像决定要画什么了！快快快，看看我们有什么合适的颜料。"
                },
                {
                    "id": "760600112",
                    "speaker": "派蒙",
                    "text": "这次的话…就选一些比较深沉、静谧的颜色吧！"
                }
            ]
        },
        {
            "id": "7606002",
            "objective": "将一些色彩丰富的东西交给月灵",
            "dialogues": [
                {
                    "id": "760600201",
                    "speaker": "Player",
                    "text": "（深沉而又静谧的颜色…）"
                }
            ]
        },
        {
            "id": "7606003",
            "objective": "观看月灵的画作",
            "dialogues": [
                {
                    "id": "760600301",
                    "speaker": "派蒙",
                    "text": "好，就这些吧。梅拉觉得呢？"
                },
                {
                    "id": "760600302",
                    "speaker": "梅拉",
                    "text": "~！"
                },
                {
                    "id": "760600303",
                    "speaker": "派蒙",
                    "text": "它看起来挺满意的。嘿嘿…这次会是怎样的一幅画呢？"
                },
                {
                    "id": "760600304",
                    "speaker": "梅拉",
                    "text": "……"
                },
                {
                    "id": "760600305",
                    "speaker": "派蒙",
                    "text": "咦？已经画好了吗？"
                },
                {
                    "id": "760600306",
                    "speaker": "梅拉",
                    "text": "……"
                },
                {
                    "id": "760600307",
                    "speaker": "派蒙",
                    "text": "梅拉的样子，看起来有些伤心呢，是因为画的关系吗？我看看…"
                },
                {
                    "id": "760600308",
                    "speaker": "派蒙",
                    "text": "啊，这次画的也是哥伦比娅呢，这是在…月光下散步吗？画中的你还抬头望着夜空。"
                },
                {
                    "id": "760600309",
                    "speaker": "「少女」",
                    "text": "我大概…是在看虚假之天外的那轮月亮吧。以前经常这么在晚上散步。"
                },
                {
                    "id": "760600310",
                    "speaker": "派蒙",
                    "text": "以前？啊…这么说来…"
                },
                {
                    "id": "760600311",
                    "speaker": "Player",
                    "text": "（现在的哥伦比娅几乎只能待在这处庭园里…明明挪德卡莱是她诞生的地方…）"
                },
                {
                    "id": "760600312",
                    "speaker": "「少女」",
                    "text": "以前散步的时候就会想，那个真实的「霜月」上究竟有些什么？"
                },
                {
                    "id": "760600313",
                    "speaker": "「少女」",
                    "text": "会不会也像这边一样，有很多小动物…"
                },
                {
                    "id": "760600314",
                    "speaker": "「少女」",
                    "text": "还是说，其实什么都没有呢。"
                },
                {
                    "id": "760600315",
                    "speaker": "派蒙",
                    "text": "唔…",
                    "choices": [
                        {
                            "id": "760600316",
                            "text": "不如带一些上去？",
                            "response": [
                                {
                                    "id": "760600317",
                                    "speaker": "「少女」",
                                    "text": "哈，你的想法很有趣。"
                                },
                                {
                                    "id": "760600318",
                                    "speaker": "「少女」",
                                    "text": "不过…月亮在虚假之天外，或许还是不要让这里的小动物们陪我一起去冒险比较好…"
                                },
                                {
                                    "id": "760600322",
                                    "speaker": "Player",
                                    "text": "（一边是无法自由行动的「家」…一边是不知道有什么的「家」…）"
                                },
                                {
                                    "id": "760600323",
                                    "speaker": "Player",
                                    "text": "（……）"
                                },
                                {
                                    "id": "760600324",
                                    "speaker": "梅拉",
                                    "text": "……"
                                },
                                {
                                    "id": "760600325",
                                    "speaker": "派蒙",
                                    "text": "梅拉一定也很舍不得你走吧。"
                                },
                                {
                                    "id": "760600326",
                                    "speaker": "「少女」",
                                    "text": "我也舍不得它们。"
                                },
                                {
                                    "id": "760600327",
                                    "speaker": "「少女」",
                                    "text": "但这终究是我一个人的旅行。是需要我独自去寻找的答案。"
                                },
                                {
                                    "id": "760600328",
                                    "speaker": "「少女」",
                                    "text": "说不定，这个答案其实很美好呢？"
                                },
                                {
                                    "id": "760600329",
                                    "speaker": "派蒙",
                                    "text": "那，那到时候我们就带着梅拉一起去看望你！"
                                },
                                {
                                    "id": "760600330",
                                    "speaker": "「少女」",
                                    "text": "好啊，办一个月亮上的画展。"
                                },
                                {
                                    "id": "760600331",
                                    "speaker": "派蒙",
                                    "text": "哇，听起来就不错！说好了啊！"
                                },
                                {
                                    "id": "760600332",
                                    "speaker": "「少女」",
                                    "text": "嗯…"
                                },
                                {
                                    "id": "760600333",
                                    "speaker": "「少女」",
                                    "text": "希望如此…"
                                }
                            ]
                        },
                        {
                            "id": "760600319",
                            "text": "说不定有其他可爱的生灵。",
                            "response": [
                                {
                                    "id": "760600320",
                                    "speaker": "「少女」",
                                    "text": "唔，希望如此。"
                                },
                                {
                                    "id": "760600321",
                                    "speaker": "「少女」",
                                    "text": "也希望它们欢迎我这个突然回家的「神明」吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7606004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760600401",
                    "speaker": "「少女」",
                    "text": "月亮上…有什么呢…"
                }
            ]
        }
    ]
}