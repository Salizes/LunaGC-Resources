        {
            "id": "7216231",
            "objective": "跟随藤原俊子前往营地",
            "dialogues": []
        },
        {
            "id": "7216226",
            "objective": "与藤原俊子对话",
            "dialogues": [
                {
                    "id": "721621301",
                    "speaker": "藤原俊子",
                    "text": "呼…总算是到了，你们稍等一下，我去准备报酬。"
                },
                {
                    "id": "721621302",
                    "speaker": "藤原俊子",
                    "text": "好了。这些东西请你们收下吧，虽然不多…但也算是我的一点心意。"
                },
                {
                    "id": "721621303",
                    "speaker": "藤原俊子",
                    "text": "这次的寻宝行动真是乱七八糟，而且还就拿到了一幅画。"
                },
                {
                    "id": "721621304",
                    "speaker": "藤原俊子",
                    "text": "唉，为什么我家的祖先，会专门为一张画设计那么多机关呢？"
                },
                {
                    "id": "721621305",
                    "speaker": "藤原俊子",
                    "text": "完全搞不明白…我还是带着这幅画，回去稻妻城里找人问问看吧。"
                },
                {
                    "id": "721621306",
                    "speaker": "藤原俊子",
                    "text": "唔，不如…直接去问问太田太郎先生吧…"
                }
            ]
        },
        {
            "id": "7216202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721620201",
                    "speaker": "藤原俊子",
                    "text": "这机关，到底是怎么解的呢…"
                }
            ]
