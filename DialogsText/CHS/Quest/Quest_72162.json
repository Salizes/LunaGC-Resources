    "talks": [
        {
            "id": "7216216",
            "objective": "解救被魔物围困的人(隐藏)$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7216201",
            "objective": "解救被魔物围困的人",
            "dialogues": [
                {
                    "id": "721620101",
                    "speaker": "藤原俊子",
                    "text": "谢、谢谢你们，呼…这些家伙居然趁我不注意偷袭我…",
                    "choices": [
                        {
                            "id": "721620102",
                            "text": "你是谁？",
                            "response": [
                                {
                                    "id": "721620104",
                                    "speaker": "藤原俊子",
                                    "text": "我叫藤原俊子，正在这里…嗯…"
                                },
                                {
                                    "id": "721620105",
                                    "speaker": "藤原俊子",
                                    "text": "算了，你们救了我…我就告诉你们吧。"
                                },
                                {
                                    "id": "721620106",
                                    "speaker": "藤原俊子",
                                    "text": "其实，我正在这里寻找我祖上留下来的宝藏！"
                                },
                                {
                                    "id": "721620107",
                                    "speaker": "派蒙",
                                    "text": "宝、宝藏！"
                                },
                                {
                                    "id": "721620108",
                                    "speaker": "Player",
                                    "text": "你找到了吗？"
                                },
                                {
                                    "id": "721620109",
                                    "speaker": "藤原俊子",
                                    "text": "哈哈哈，那是当然，我顺着线索找到了宝藏所在地，也确定了进入的方法。"
                                },
                                {
                                    "id": "721620110",
                                    "speaker": "藤原俊子",
                                    "text": "但是…在我准备启动开关，进入藏宝地的时候，就被那群魔物偷袭了。"
                                },
                                {
                                    "id": "721620111",
                                    "speaker": "藤原俊子",
                                    "text": "多亏你们击退了那群魔物，谢谢你们。"
                                },
                                {
                                    "id": "721620112",
                                    "speaker": "藤原俊子",
                                    "text": "然后…那个，虽然有点不好意思…"
                                },
                                {
                                    "id": "721620113",
                                    "speaker": "藤原俊子",
                                    "text": "但是，能不能请你们接着保护我一段时间？"
                                },
                                {
                                    "id": "721620114",
                                    "speaker": "藤原俊子",
                                    "text": "我还得继续寻宝，这周围又有那么多魔物，我一个人肯定没法对付…"
                                },
                                {
                                    "id": "721620115",
                                    "speaker": "藤原俊子",
                                    "text": "如果你们愿意帮忙的话，我可以把…把宝藏分给你们一些！",
                                    "choices": [
                                        {
                                            "id": "721620116",
                                            "text": "真的有宝藏吗？",
                                            "response": [
                                                {
                                                    "id": "721620118",
                                                    "speaker": "藤原俊子",
                                                    "text": "肯定能找到！你们就相信我吧！"
                                                },
                                                {
                                                    "id": "721620119",
                                                    "speaker": "藤原俊子",
                                                    "text": "我连进入藏宝地的开关都找到了，就在那边。"
                                                },
                                                {
                                                    "id": "721620120",
                                                    "speaker": "藤原俊子",
                                                    "text": "但那座机关似乎不能直接打开，得用一种特殊的方法才能启动…"
                                                },
                                                {
                                                    "id": "721620121",
                                                    "speaker": "藤原俊子",
                                                    "text": "虽然我手上有祖上留下的一张图，里面似乎有解开这座机关的线索…"
                                                },
                                                {
                                                    "id": "721620122",
                                                    "speaker": "藤原俊子",
                                                    "text": "但是…哈哈哈…我还是不知道怎么才能打开。"
                                                },
                                                {
                                                    "id": "721620123",
                                                    "speaker": "藤原俊子",
                                                    "text": "哦，你们也看看吧，说不定你们能从这张图里看出什么来。"
                                                },
                                                {
                                                    "id": "721620124",
                                                    "speaker": "藤原俊子",
                                                    "text": "唉，这个机关到底是怎么解的呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721620117",
                                            "text": "真的找得到吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721620103",
                            "text": "你在这做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7216202",
            "objective": "与藤原俊子对话",
            "dialogues": []
        },
        {
            "id": "7216203",
            "objective": "启动开关",
            "dialogues": [
                {
                    "id": "721620301",
                    "speaker": "藤原俊子",
                    "text": "这座机关…好像和我们进来的时候解开的那座机关是同一类型。"
                },
                {
                    "id": "721620302",
                    "speaker": "藤原俊子",
                    "text": "不过，好像复杂了不少…"
                },
                {
                    "id": "721620303",
                    "speaker": "藤原俊子",
                    "text": "但是没关系！我祖上的那张图上一定有解开这座机关的线索！"
                }
            ]
        },
        {
            "id": "7216205",
            "objective": "查看并启动机关",
            "dialogues": [
                {
                    "id": "721620501",
                    "speaker": "藤原俊子",
                    "text": "营地就在不远，走一会就到了，我们出发吧。"
                }
            ]
        },
        {
            "id": "7216204",
            "objective": "与藤原俊子对话",
            "dialogues": [
                {
                    "id": "721629902",
                    "speaker": "藤原俊子",
                    "text": "突、突然响起了什么声音…"
                },
                {
                    "id": "721629903",
                    "speaker": "藤原俊子",
                    "text": "看那边！那边…怎么突然出现了一个大洞？"
                },
                {
                    "id": "721629904",
                    "speaker": "藤原俊子",
                    "text": "底下…好像是一个地下室，我们进去看看吧！快！"
                }
            ]
        },
        {
            "id": "7216206",
            "objective": "进入地下室",
            "dialogues": [
                {
                    "id": "721620601",
                    "speaker": "藤原俊子",
                    "text": "唉，这回真是…"
                },
                {
                    "id": "721620602",
                    "speaker": "盗宝团",
                    "text": "真是大发横财了？"
                },
                {
                    "id": "721620603",
                    "speaker": "藤原俊子",
                    "text": "你、你们…"
                },
                {
                    "id": "721620604",
                    "speaker": "盗宝团",
                    "text": "嘿嘿…少废话，把宝贝交出来！兄弟们跟着你这么久，可不能白跑一趟！"
                },
                {
                    "id": "721620605",
                    "speaker": "藤原俊子",
                    "text": "什么？等一下！我就只找到了一幅画！"
                },
                {
                    "id": "721620606",
                    "speaker": "盗宝团",
                    "text": "一幅画？那也得给我交出来！兄弟们，上！"
                },
                {
                    "id": "721620607",
                    "speaker": "藤原俊子",
                    "text": "救、救命啊！旅行者！"
                }
            ]
        },
        {
            "id": "7216217",
            "objective": "与藤原俊子对话",
            "dialogues": []
        },
        {
            "id": "7216210",
            "objective": "启动开关",
            "dialogues": [
                {
                    "id": "721621001",
                    "speaker": "藤原俊子",
                    "text": "唉，真是不知道…"
                },
                {
                    "id": "721621002",
                    "speaker": "愚人众",
                    "text": "把那幅画，拿出来吧。"
                },
                {
                    "id": "721621003",
                    "speaker": "派蒙",
                    "text": "愚人众？！他、他们来这里做什么？！"
                },
                {
                    "id": "721621004",
                    "speaker": "藤原俊子",
                    "text": "那就是一幅普通的画而已啦！你们要就给你们好了！给你们啦！"
                },
                {
                    "id": "721621005",
                    "speaker": "愚人众",
                    "text": "还有其余的东西，也一并拿出来！"
                },
                {
                    "id": "721621006",
                    "speaker": "藤原俊子",
                    "text": "其余的？没有其余的东西了！我就只找到这一幅画而已啊！"
                },
                {
                    "id": "721621007",
                    "speaker": "愚人众",
                    "text": "哼，只有一幅画…还能用那么复杂的机关保护着的？"
                },
                {
                    "id": "721621008",
                    "speaker": "愚人众",
                    "text": "要不是发现了那群野武士的踪迹，我们还发现不了那个地下室。"
                },
                {
                    "id": "721621009",
                    "speaker": "愚人众",
                    "text": "等了这么久，总归要有点收获才行…上！"
                },
                {
                    "id": "721621010",
                    "speaker": "藤原俊子",
                    "text": "我…我真是…旅行者！救命啊！"
                }
            ]
        },
        {
            "id": "7216207",
            "objective": "启动机关",
            "dialogues": [
                {
                    "id": "721620701",
                    "speaker": "藤原俊子",
                    "text": "这帮盗宝团到底是什么时候盯上我的…"
                },
                {
                    "id": "721620702",
                    "speaker": "藤原俊子",
                    "text": "谢谢你，旅行者，我们快点回营地吧。"
                }
            ]
        },
        {
            "id": "7216208",
            "objective": "再次启动机关",
            "dialogues": [
                {
                    "id": "721620801",
                    "speaker": "藤原俊子",
                    "text": "唉，真是没想…"
                },
                {
                    "id": "721620802",
                    "speaker": "野武士",
                    "text": "还请各位，稍微留步。"
                },
                {
                    "id": "721620803",
                    "speaker": "野武士",
                    "text": "能劳烦你们，把刚刚找到的宝物拿出来吗？"
                },
                {
                    "id": "721620804",
                    "speaker": "藤原俊子",
                    "text": "什么…"
                },
                {
                    "id": "721620805",
                    "speaker": "野武士",
                    "text": "刚才你们不是为了保护宝物，连盗宝团都击退了吗？"
                },
                {
                    "id": "721620806",
                    "speaker": "野武士",
                    "text": "想必，肯定是找到了什么贵重的宝物吧。"
                },
                {
                    "id": "721620807",
                    "speaker": "藤原俊子",
                    "text": "都说了只有一幅画啊！"
                },
                {
                    "id": "721620808",
                    "speaker": "野武士",
                    "text": "看来是说不通了…但我们也不能白跟着那群盗宝团这么久，动手！"
                },
                {
                    "id": "721620809",
                    "speaker": "藤原俊子",
                    "text": "你们给我好好听人说话啊！旅行者！救命啊！"
                }
            ]
        },
        {
            "id": "7216209",
            "objective": "等待藤原俊子开启宝箱",
            "dialogues": [
                {
                    "id": "721620901",
                    "speaker": "藤原俊子",
                    "text": "这帮人怎么这么不讲道理啊！都说了我只找到一幅画了啊！"
                },
                {
                    "id": "721620902",
                    "speaker": "藤原俊子",
                    "text": "我们继续走吧，必须快点回营地去…"
                }
            ]
        },
        {
            "id": "7216219",
            "objective": "与藤原俊子对话",
            "dialogues": [
                {
                    "id": "721620401",
                    "speaker": "藤原俊子",
                    "text": "这里面…怎么只有这个…"
                },
                {
                    "id": "721620402",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "721620403",
                    "speaker": "藤原俊子",
                    "text": "那个箱子里只装着这一幅画。"
                },
                {
                    "id": "721620404",
                    "speaker": "藤原俊子",
                    "text": "这个就是宝藏吗？真是莫名其妙。"
                },
                {
                    "id": "721620405",
                    "speaker": "藤原俊子",
                    "text": "唉，只找到了这一幅画，也没办法分给你…"
                },
                {
                    "id": "721620406",
                    "speaker": "藤原俊子",
                    "text": "这样吧，你们跟我来，我们先回我的营地去。"
                },
                {
                    "id": "721620407",
                    "speaker": "藤原俊子",
                    "text": "去了那里之后，我再把报酬给你们。"
                },
                {
                    "id": "721620408",
                    "speaker": "藤原俊子",
                    "text": "行了，我们快点出发吧。"
                },
                {
                    "id": "721620409",
                    "speaker": "藤原俊子",
                    "text": "就一幅画，真奇怪…"
                }
            ]
        },
        {
            "id": "7216211",
            "objective": "跟上藤原俊子",
            "dialogues": [
                {
                    "id": "721621101",
                    "speaker": "藤原俊子",
                    "text": "为、为什么所有人都不相信我只拿到了这一幅画，呜…"
                },
                {
                    "id": "721621102",
                    "speaker": "藤原俊子",
                    "text": "就算是抢劫…也要好好听人讲话吧！"
                },
                {
                    "id": "721621103",
                    "speaker": "Player",
                    "text": "我们还是快走吧…"
                },
                {
                    "id": "721621104",
                    "speaker": "藤原俊子",
                    "text": "呜呜呜…好、好…我们快点回营地吧，我真是受不了了…"
                }
            ]
        },
        {
            "id": "7216212",
            "objective": "跟随藤原俊子前往营地",
            "dialogues": [
                {
                    "id": "721621201",
                    "speaker": "？？？",
                    "text": "喵！"
                },
                {
                    "id": "721621202",
                    "speaker": "藤原俊子",
                    "text": "呜哇！又是谁啊！我真的只拿到了这一幅画而已！"
                },
                {
                    "id": "721621203",
                    "speaker": "藤原俊子",
                    "text": "对不起！对不起！我以后绝对不会再来寻宝了！"
                },
                {
                    "id": "721621204",
                    "speaker": "Player",
                    "text": "是猫啦…"
                },
                {
                    "id": "721621205",
                    "speaker": "藤原俊子",
                    "text": "欸？是吗？好吧…"
                }
            ]
        },
