    "talks": [
        {
            "id": "7010801",
            "objective": "与艾斯特尔对话",
            "dialogues": [
                {
                    "id": "701080101",
                    "speaker": "艾斯特尔",
                    "text": "唉，只用这些信标，果然还是不能准确勘测雪山的高度啊，这误差也太大了…"
                },
                {
                    "id": "701080102",
                    "speaker": "艾斯特尔",
                    "text": "除非…"
                },
                {
                    "id": "701080103",
                    "speaker": "玩家",
                    "text": "除非…"
                },
                {
                    "id": "701080104",
                    "speaker": "艾斯特尔",
                    "text": "除非，有一位勇敢的冒险家能帮我把这枚信标直接放到山顶上。",
                    "choices": [
                        {
                            "id": "701080105",
                            "text": "你说的是谁？",
                            "response": [
                                {
                                    "id": "701080107",
                                    "speaker": "艾斯特尔",
                                    "text": "拜托你了！再帮帮我吧，我的信标被怪物弄坏太多，只有这种方法能缩小勘测误差了。"
                                },
                                {
                                    "id": "701080108",
                                    "speaker": "艾斯特尔",
                                    "text": "只要把这枚信标放在雪山顶上就可以了，报酬我一定会准备好的，只有你能帮我这个忙了！"
                                }
                            ]
                        },
                        {
                            "id": "701080106",
                            "text": "你说的是我吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7010802",
            "objective": "将勘测信标放置在雪山山顶",
            "dialogues": [
                {
                    "id": "701080201",
                    "speaker": "派蒙",
                    "text": "呜…这，这样应该就可，可以了…"
                },
                {
                    "id": "701080202",
                    "speaker": "派蒙",
                    "text": "好冷…我们还是快点下去吧…"
                }
            ]
        },
        {
            "id": "7010803",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "7010804",
            "objective": "向艾斯特尔回报",
            "dialogues": [
                {
                    "id": "701080301",
                    "speaker": "艾斯特尔",
                    "text": "你把信标放好了吗？"
                },
                {
                    "id": "701080302",
                    "speaker": "玩家",
                    "text": "已经放好了。"
                },
                {
                    "id": "701080303",
                    "speaker": "艾斯特尔",
                    "text": "太好了，谢谢你，这样我一定能勘测到雪山的高度。"
                },
                {
                    "id": "701080304",
                    "speaker": "艾斯特尔",
                    "text": "啊，对了，你的报酬我已经拜托塞琉斯先生准备好了，你去城里找他拿一下吧。"
                },
                {
                    "id": "701080305",
                    "speaker": "艾斯特尔",
                    "text": "然后，顺便帮我把这封信带给他，他答应我帮忙留意第二支要进山的探险队，结果到现在也没有消息。"
                },
                {
                    "id": "701080306",
                    "speaker": "艾斯特尔",
                    "text": "那些信标修好了之后，我还得再进山把它们安置一遍。这座雪山上还有很多东西要勘测呢。"
                }
            ]
        },
        {
            "id": "7010805",
            "objective": "将信带给塞琉斯",
            "dialogues": [
                {
                    "id": "701080401",
                    "speaker": "塞琉斯",
                    "text": "你好，有什么事吗？"
                },
                {
                    "id": "701080402",
                    "speaker": "玩家",
                    "text": "这封信是给你的。"
                },
                {
                    "id": "701080403",
                    "speaker": "塞琉斯",
                    "text": "信？哦…是她的啊，我知道了，肯定又是来问我有关探险队的事…"
                },
                {
                    "id": "701080404",
                    "speaker": "塞琉斯",
                    "text": "唉，这事我也没办法，现在没几支探险队会去雪山里探险，那地方实在是太危险了…"
                },
                {
                    "id": "701080405",
                    "speaker": "塞琉斯",
                    "text": "我等一下会自己写封信给她，把情况和她说明一下，谢谢你专门送信过来。"
                },
                {
                    "id": "701080406",
                    "speaker": "塞琉斯",
                    "text": "哦对了，这是她之前写信过来让我给你准备的报酬，你就收下吧。"
                },
                {
                    "id": "701080407",
                    "speaker": "塞琉斯",
                    "text": "还有…我多说一句，虽然你看起来身手不错，但在雪山里活动，还是要格外小心才好。"
                },
                {
                    "id": "701080410",
                    "speaker": "塞琉斯",
                    "text": "唉，雪山…要是有机会的话，我一定要亲自领队进山看看。"
                }
            ]
        },
        {
            "id": "7010805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701080501",
                    "speaker": "艾斯特尔",
                    "text": "只要把信标放在山顶上，一定能缩小不少勘测误差…"
                }
            ]
        },
        {
            "id": "7010806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "701080601",
                    "speaker": "艾斯特尔",
                    "text": "唉，到底什么时候我才能再进雪山呢…"
                }
            ]
        }
    ]
