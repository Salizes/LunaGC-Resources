    },
    "talks": [
        {
            "id": "7367501",
            "objective": "与芭努对话",
            "dialogues": [
                {
                    "id": "736750101",
                    "speaker": "芭努",
                    "text": "哇，太好了！不是镀金旅团不是盗宝团，是衣着正经的陌生人，得赶快抓住机会。"
                },
                {
                    "id": "736750102",
                    "speaker": "芭努",
                    "text": "嗯，那个…「这位行路的朋友，请停下你的脚步！」",
                    "choices": [
                        {
                            "id": "736750103",
                            "text": "你好？",
                            "response": [
                                {
                                    "id": "736750105",
                                    "speaker": "芭努",
                                    "text": "「您好！括号，根据对方性别选择称呼先生或者女士，括号。唐突打扰非常抱歉，烦请您在百忙之际抽空…嗯…听取我的请求。」"
                                },
                                {
                                    "id": "736750106",
                                    "speaker": "派蒙",
                                    "text": "括、括号？"
                                },
                                {
                                    "id": "736750107",
                                    "speaker": "芭努",
                                    "text": "不行不行，不能打断，要不然我就记不得下一句了。下一句是——"
                                },
                                {
                                    "id": "736750108",
                                    "speaker": "芭努",
                                    "text": "「括号，用简要的语言描述你遇到的困难…并礼貌地请求对方协助，然后郑重向对方表示感谢，括号。」"
                                },
                                {
                                    "id": "736750109",
                                    "speaker": "芭努",
                                    "text": "最后一句是——「括号，范例，括号。感谢您的慷慨大度，我将永远把它记在心上。」"
                                },
                                {
                                    "id": "736750110",
                                    "speaker": "芭努",
                                    "text": "「同时，我愿意为您的不辞辛苦支付可观的报酬，因此我恳请您稍稍考虑这一请求。」"
                                },
                                {
                                    "id": "736750111",
                                    "speaker": "芭努",
                                    "text": "呼，这遍一个字都没背落，肯定没问题。那么，找未来星的事就靠你帮忙了。"
                                },
                                {
                                    "id": "736750112",
                                    "speaker": "派蒙",
                                    "text": "听起来像是有事要委托我们，但我怎么听不懂你说的话…"
                                },
                                {
                                    "id": "736750113",
                                    "speaker": "芭努",
                                    "text": "哪里有问题呢？《游学者不可不知的五十件事》上说，要找人帮忙的话就这么说，不该有问题啊。",
                                    "choices": [
                                        {
                                            "id": "736750114",
                                            "text": "哪里都有问题。",
                                            "response": [
                                                {
                                                    "id": "736750115",
                                                    "speaker": "芭努",
                                                    "text": "这样吗？等、等一下，我找一找「哪里都有问题」的时候该背哪一段。"
                                                },
                                                {
                                                    "id": "736750118",
                                                    "speaker": "Black Screen",
                                                    "text": "女孩从口袋里掏出了一本叫作《游学者不可不知的五十件事》的书，焦急地翻了起来。"
                                                },
                                                {
                                                    "id": "736750119",
                                                    "speaker": "芭努",
                                                    "text": "唉，这上面没说。但是沙尔玛明明说遇到问题的时候，只要翻这本书就好了啊。"
                                                },
                                                {
                                                    "id": "736750120",
                                                    "speaker": "派蒙",
                                                    "text": "虽然很混乱，但是看样子，小朋友你是遇到了困难需要帮助对吗？"
                                                },
                                                {
                                                    "id": "736750121",
                                                    "speaker": "派蒙",
                                                    "text": "既然书本派不上用场，不如用你自己的话说说你碰到的问题。"
                                                },
                                                {
                                                    "id": "736750122",
                                                    "speaker": "芭努",
                                                    "text": "我想想，事情是这样的：我叫芭努，是跟着地图来这里找未来星的，未来星一共有六颗。"
                                                },
                                                {
                                                    "id": "736750123",
                                                    "speaker": "芭努",
                                                    "text": "只要找到全部六颗未来星，就能召唤出大未来星，大未来星超级厉害的，我的目标就是召唤出大未来星。"
                                                },
                                                {
                                                    "id": "736750124",
                                                    "speaker": "派蒙",
                                                    "text": "哦，之前你说的「找未来星」指的就是这件事啊。"
                                                },
                                                {
                                                    "id": "736750125",
                                                    "speaker": "芭努",
                                                    "text": "嗯，未来星的设定差不多就是这些了。",
                                                    "choices": [
                                                        {
                                                            "id": "736750126",
                                                            "text": "设定？",
                                                            "response": [
                                                                {
                                                                    "id": "736750127",
                                                                    "speaker": "芭努",
                                                                    "text": "对呀，我觉得比起我平时看的那些，这个设定还挺好懂的，不过就是太简单了，不好玩。"
                                                                },
                                                                {
                                                                    "id": "736750130",
                                                                    "speaker": "Player",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "736750131",
                                                                    "speaker": "芭努",
                                                                    "text": "然后，嗯…这个设定我觉得太模糊了，没有解释该怎么找到未来星。为了解决这个问题，我又想了一个补充设定："
                                                                },
                                                                {
                                                                    "id": "736750132",
                                                                    "speaker": "Black Screen",
                                                                    "text": "女孩从身后的草丛里翻出了一个奇怪的物体。"
                                                                },
                                                                {
                                                                    "id": "736750133",
                                                                    "speaker": "芭努",
                                                                    "text": "就是这个重要道具，它叫…嗯就叫「芭努的智慧」吧。它可以指引出未来星的位置，很厉害吧，嘿嘿。"
                                                                },
                                                                {
                                                                    "id": "736750134",
                                                                    "speaker": "芭努",
                                                                    "text": "我觉得这个名字超级酷！不过它太高了，而且又很重，我搬不动，就变得不酷了。"
                                                                },
                                                                {
                                                                    "id": "736750135",
                                                                    "speaker": "芭努",
                                                                    "text": "我想找你们帮忙的就是这件事，你们应该能搬得动吧，能帮我用它找到未来星吗？召唤出大未来星之后我可以给你们付很多很多报酬！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "736750136",
                                                                            "text": "这就是你的委托吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "736750138",
                                                                                    "speaker": "芭努",
                                                                                    "text": "#遇到{M#大哥哥}{F#大姐姐}你们之前，我还试过找别人帮忙。但他们听到未来星的时候表情都变得很怪，都不想听我说下去了。"
                                                                                },
                                                                                {
                                                                                    "id": "736750139",
                                                                                    "speaker": "芭努",
                                                                                    "text": "他们还让我不要胡闹，乖乖回家找爸爸妈妈去，真气人。我又不是瞒着家人溜出来的玩的幼稚鬼！"
                                                                                },
                                                                                {
                                                                                    "id": "736750140",
                                                                                    "speaker": "芭努",
                                                                                    "text": "大人们总是这样，就因为我是小孩子，就觉得我在乱说。"
                                                                                },
                                                                                {
                                                                                    "id": "736750141",
                                                                                    "speaker": "芭努",
                                                                                    "text": "但未来星是真实存在的！我才没有在幻想，只要你们带着…嗯…「芭努的智慧」找一找就会知道我有没有撒谎了。"
                                                                                },
                                                                                {
                                                                                    "id": "736750142",
                                                                                    "speaker": "芭努",
                                                                                    "text": "要是你们也不愿意帮忙，唉，我再等等看，遇到的下一个人会不会愿意听我说话。"
                                                                                },
                                                                                {
                                                                                    "id": "736750143",
                                                                                    "speaker": "Player",
                                                                                    "text": "好吧，我可以去看看。"
                                                                                },
                                                                                {
                                                                                    "id": "736750144",
                                                                                    "speaker": "芭努",
                                                                                    "text": "#你相信我！太好了，{M#大哥哥}{F#大姐姐}你拿着这个「芭努的智慧」吧。"
                                                                                },
                                                                                {
                                                                                    "id": "736750145",
                                                                                    "speaker": "芭努",
                                                                                    "text": "你要记得哦，「芭努的智慧」运行一段时间之后要休息一会儿才能再指出未来星的位置。"
                                                                                },
                                                                                {
                                                                                    "id": "736750146",
                                                                                    "speaker": "芭努",
                                                                                    "text": "还有这本《游学者不可不知的五十件事》你也拿着，我在这本书的地图插画里标了未来星的位置，你们可以跟着地图走。"
                                                                                },
                                                                                {
                                                                                    "id": "736750147",
                                                                                    "speaker": "芭努",
                                                                                    "text": "你们找到全部六颗未来星就来找我吧，我带你们一起去看大未来星！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "736750137",
                                                                            "text": "我考虑一下。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736750128",
                                                            "text": "这又是哪本书里的？",
                                                            "response": [
                                                                {
                                                                    "id": "736750129",
                                                                    "speaker": "芭努",
                                                                    "text": "哦，这个设定的话，我觉得应该是现编的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736750116",
                                            "text": "你没说遇到的困难是什么。",
                                            "response": [
                                                {
                                                    "id": "736750117",
                                                    "speaker": "芭努",
                                                    "text": "这样吗？等、等一下，我找一找「没说遇到的困难是什么」的时候该背哪一段。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736750104",
                            "text": "什么事？"
                        }
                    ]
                }
            ]
        }
    ]
}