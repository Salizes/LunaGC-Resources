        {
            "id": "2304113",
            "objective": "寻找小猫",
            "dialogues": [
                {
                    "id": "230410602",
                    "speaker": "懒散的小猫",
                    "text": "喵？喵喵喵！"
                },
                {
                    "id": "230410603",
                    "speaker": "派蒙",
                    "text": "呜哇！我们不是坏人，别这么凶呀。"
                },
                {
                    "id": "230410604",
                    "speaker": "派蒙",
                    "text": "这应该就是内尔敏说的那只小猫了，我们喂它点吃的吧。"
                },
                {
                    "id": "230410605",
                    "speaker": "Black Screen",
                    "text": "在小猫警惕地注视下，把食物放在了它面前…"
                },
                {
                    "id": "230410606",
                    "speaker": "派蒙",
                    "text": "它吃的可真香…这样应该就可以了，我们回去告诉内尔敏这件事吧。"
                }
            ]
        },
        {
            "id": "2304112",
            "objective": "寻找小猫",
            "dialogues": []
        },
        {
            "id": "2304106",
            "objective": "寻找小猫",
            "dialogues": []
        },
        {
            "id": "2304107",
            "objective": "向内尔敏回报",
            "dialogues": [
                {
                    "id": "230410701",
                    "speaker": "内尔敏",
                    "text": "旅行者，你找到那只小猫了吗？",
                    "choices": [
                        {
                            "id": "230410702",
                            "text": "已经喂过它了。",
                            "response": [
                                {
                                    "id": "230410704",
                                    "speaker": "内尔敏",
                                    "text": "那就好，希望它别再来咬花了。无论怎么说，猫粮都要比花叶好吃啊。"
                                },
                                {
                                    "id": "230410705",
                                    "speaker": "内尔敏",
                                    "text": "谢谢你帮忙旅行者，这是报酬，请你收下吧。"
                                },
                                {
                                    "id": "230410706",
                                    "speaker": "内尔敏",
                                    "text": "唉，希望小猫不要饿得太快…"
                                }
                            ]
                        },
                        {
                            "id": "230410703",
                            "text": "它应该已经吃饱了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304109",
            "objective": "将「墩墩桃」带给内尔敏",
            "dialogues": [
                {
                    "id": "230410901",
                    "speaker": "内尔敏",
                    "text": "谢谢你！我得先把它切块，然后再加入进「薄荷豆汤」里…"
                },
                {
                    "id": "230410902",
                    "speaker": "Black Screen",
                    "text": "内尔敏开始制作特别的「薄荷豆汤」…"
                },
                {
                    "id": "230410903",
                    "speaker": "内尔敏",
                    "text": "完成了！唔…看起来和普通的「薄荷豆汤」好像也没什么区别…"
                },
                {
                    "id": "230410904",
                    "speaker": "内尔敏",
                    "text": "不过，尝起来肯定会不一样的！"
                },
                {
                    "id": "230410905",
                    "speaker": "内尔敏",
                    "text": "旅行者，就麻烦你把这碗「薄荷豆汤」带去给里夫吧。"
                },
                {
                    "id": "230410906",
                    "speaker": "内尔敏",
                    "text": "我还得给库尔苏姆奶奶做几份，奥贝德和希尔米说他们也想喝…",
                    "choices": [
                        {
                            "id": "230410907",
                            "text": "别太累了喔。",
                            "response": [
                                {
                                    "id": "230410908",
                                    "speaker": "内尔敏",
                                    "text": "我知道啦，只是几碗「薄荷豆汤」而已，不会有什么问题的。"
                                },
                                {
                                    "id": "230410911",
                                    "speaker": "内尔敏",
                                    "text": "总之，请你把这份「薄荷豆汤」送给里夫吧。"
                                },
                                {
                                    "id": "230410912",
                                    "speaker": "内尔敏",
                                    "text": "还得给纳瓦兹和拉米兹也准备几份…"
                                }
                            ]
                        },
                        {
                            "id": "230410909",
                            "text": "你还真有精力…",
                            "response": [
                                {
                                    "id": "230410910",
                                    "speaker": "内尔敏",
                                    "text": "毕竟…我总算是可以做一些正事了，当然要好好把握住这个机会。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
