        },
        {
            "id": "2304115",
            "objective": "把内尔敏做好的饮料带给里夫",
            "dialogues": [
                {
                    "id": "230411001",
                    "speaker": "里夫",
                    "text": "这「薄荷豆汤」…是内尔敏自己做的？"
                },
                {
                    "id": "230411002",
                    "speaker": "里夫",
                    "text": "我说她最近怎么神神秘秘的，而且还找人买了几个花盆，不知道往里面种了什么…"
                },
                {
                    "id": "230411003",
                    "speaker": "里夫",
                    "text": "不过这样也不错，至少…内尔敏不会每天都只想着自己的身体问题了。"
                },
                {
                    "id": "230411004",
                    "speaker": "里夫",
                    "text": "等会还有一批货要送进来，等我把那批货接进村里之后，就把这碗汤给喝了。"
                },
                {
                    "id": "230411005",
                    "speaker": "里夫",
                    "text": "对了，这些报酬给你，多谢你跑一趟啦，旅行者。"
                }
            ]
        },
        {
            "id": "2304108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230410801",
                    "speaker": "内尔敏",
                    "text": "旅行者，你采到「墩墩桃」了吗？"
                }
            ]
        },
        {
            "id": "2304111",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230411101",
                    "speaker": "内尔敏",
                    "text": "唔唔，为什么花叶上会有这么多虫子啊…"
                }
            ]
        },
        {
            "id": "2304112",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230411201",
                    "speaker": "内尔敏",
                    "text": "小猫居然这么喜欢咬花叶…那花叶尝起来到底是什么味道呢…"
                }
            ]
        },
        {
            "id": "2304115",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230411501",
                    "speaker": "里夫",
                    "text": "喔！旅行者，你今天怎么有空过来了，是有事找我帮忙吗？"
                },
                {
                    "id": "230411502",
                    "speaker": "Player",
                    "text": "这是内尔敏给你的。"
                }
            ]
        },
        {
            "id": "2304116",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230411601",
                    "speaker": "里夫",
                    "text": "唉，怎么突然有一批货物要运过来…"
                }
            ]
        }
    ]
}