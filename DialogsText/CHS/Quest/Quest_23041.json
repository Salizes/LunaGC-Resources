    "talks": [
        {
            "id": "2304101",
            "objective": "与内尔敏对话",
            "dialogues": [
                {
                    "id": "230410101",
                    "speaker": "内尔敏",
                    "text": "呼…这样松土应该就可以了吧…"
                },
                {
                    "id": "230410102",
                    "speaker": "Player",
                    "text": "你还在照顾这盆花吗？"
                },
                {
                    "id": "230410103",
                    "speaker": "内尔敏",
                    "text": "嗯，库尔苏姆奶奶教了我很多照顾花的方法。"
                },
                {
                    "id": "230410104",
                    "speaker": "内尔敏",
                    "text": "比如要给它松土啦，定时修剪叶片啦，用各种方法除虫啦…"
                },
                {
                    "id": "230410105",
                    "speaker": "内尔敏",
                    "text": "还有浇水不能浇得太多，不然花的根部就会被水泡烂。"
                },
                {
                    "id": "230410106",
                    "speaker": "内尔敏",
                    "text": "哎呀，我还以为要每天浇花，时刻让土壤保持湿润呢…"
                },
                {
                    "id": "230410107",
                    "speaker": "内尔敏",
                    "text": "不过这样也好，我就不用每天都去打水了，取水的地方离这里可远了。"
                },
                {
                    "id": "230410108",
                    "speaker": "内尔敏",
                    "text": "我得接着修剪枝叶，旅行者，你能帮我去打一小壶水过来吗？"
                },
                {
                    "id": "230410109",
                    "speaker": "内尔敏",
                    "text": "我已经和卡桑说过了，他答应我可以去取水浇花。",
                    "choices": [
                        {
                            "id": "230410110",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230410114",
                                    "speaker": "内尔敏",
                                    "text": "水壶就在那边，你打水的时候可要注意喔，可不要打上来太多泥沙了。"
                                }
                            ]
                        },
                        {
                            "id": "230410111",
                            "text": "这都是库尔苏姆奶奶告诉你的？",
                            "response": [
                                {
                                    "id": "230410112",
                                    "speaker": "内尔敏",
                                    "text": "唔…差不多吧，库尔苏姆奶奶知道的事可多了，我经常去找她请教呢。"
                                },
                                {
                                    "id": "230410113",
                                    "speaker": "内尔敏",
                                    "text": "那就拜托你了，旅行者，只要打一小壶水过来就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304118",
            "objective": "刷水壶辅助$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2304102",
            "objective": "拿起水壶",
            "dialogues": [
                {
                    "id": "230410201",
                    "speaker": "内尔敏",
                    "text": "呜…又有几片叶子被咬破了…"
                },
                {
                    "id": "230410202",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "230410203",
                    "speaker": "内尔敏",
                    "text": "旅行者，你看呀！又有小猫过来咬花了！"
                },
                {
                    "id": "230410204",
                    "speaker": "内尔敏",
                    "text": "你看这片叶子，这片…还有这片！都被咬下去了一大块！",
                    "choices": [
                        {
                            "id": "230410205",
                            "text": "小猫饿了？",
                            "response": [
                                {
                                    "id": "230410206",
                                    "speaker": "内尔敏",
                                    "text": "里夫也这么说，他还专门带着吃的到处去喂猫…"
                                },
                                {
                                    "id": "230410207",
                                    "speaker": "内尔敏",
                                    "text": "但是第二天，还是有小猫过来咬花。"
                                },
                                {
                                    "id": "230410210",
                                    "speaker": "内尔敏",
                                    "text": "现在小猫只是咬叶子，但我就怕小猫有一天开始咬花茎…那可就糟了。"
                                },
                                {
                                    "id": "230410211",
                                    "speaker": "内尔敏",
                                    "text": "不过，我也狠不下心去把它赶得很远，毕竟外面就是沙漠，它除了这个村子之外，也无处可去…"
                                },
                                {
                                    "id": "230410212",
                                    "speaker": "内尔敏",
                                    "text": "旅行者，你能帮我再去喂喂它吗？希望小猫吃饱了之后，别再来咬花了，花叶也不是什么好吃的东西呀…",
                                    "choices": [
                                        {
                                            "id": "230410213",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "230410216",
                                                    "speaker": "内尔敏",
                                                    "text": "那就拜托你了，旅行者，我把那只小猫经常待的地方给你标在地图上…"
                                                },
                                                {
                                                    "id": "230410217",
                                                    "speaker": "内尔敏",
                                                    "text": "我要在这盆花旁边守着，免得又有其他的小猫过来咬花…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230410214",
                                            "text": "我很擅长和猫打交道。",
                                            "response": [
                                                {
                                                    "id": "230410215",
                                                    "speaker": "内尔敏",
                                                    "text": "那样就最好了！我每次看见小猫的爪子，都担心它会突然扑上来给我一爪…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230410208",
                            "text": "小猫是…咬着玩？",
                            "response": [
                                {
                                    "id": "230410209",
                                    "speaker": "内尔敏",
                                    "text": "我是弄不清小猫喜欢玩什么啦…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304103",
            "objective": "到达梯井下接水",
            "dialogues": [
                {
                    "id": "230410301",
                    "speaker": "内尔敏",
                    "text": "旅行者，你来得正好，快来尝尝我做的薄荷豆汤。"
                },
                {
                    "id": "230410303",
                    "speaker": "Player",
                    "text": "这些材料是…"
                },
                {
                    "id": "230410304",
                    "speaker": "内尔敏",
                    "text": "有些是我托人买回来的，但是薄荷嘛…是我自己种的。"
                },
                {
                    "id": "230410305",
                    "speaker": "内尔敏",
                    "text": "里夫不是送了我一套园艺工具，还有一堆肥料吗？"
                },
                {
                    "id": "230410306",
                    "speaker": "内尔敏",
                    "text": "如果仅仅是种一盆花，我觉得实在是太浪费了…所以，我就拜托阿扎莱帮我买了一些薄荷种子。"
                },
                {
                    "id": "230410307",
                    "speaker": "内尔敏",
                    "text": "把薄荷种子种下去之后，我就和照顾那盆花一样照顾着它。"
                },
                {
                    "id": "230410308",
                    "speaker": "内尔敏",
                    "text": "照顾着照顾着，薄荷就顺利地成长…成熟…"
                },
                {
                    "id": "230410309",
                    "speaker": "内尔敏",
                    "text": "我就采了一些下来，做成了「薄荷豆汤」，怎么样，味道还不错吧。"
                },
                {
                    "id": "230410310",
                    "speaker": "内尔敏",
                    "text": "那…你既然喝了我做的「薄荷豆汤」，就得帮我个忙。",
                    "choices": [
                        {
                            "id": "230410311",
                            "text": "那个，我没喝完…",
                            "response": [
                                {
                                    "id": "230410313",
                                    "speaker": "内尔敏",
                                    "text": "别呀！我开玩笑的，会好好付给你报酬的啦！"
                                },
                                {
                                    "id": "230410314",
                                    "speaker": "内尔敏",
                                    "text": "我就是想请你去帮我采三枚「墩墩桃」回来，里夫很喜欢吃这种水果…"
                                },
                                {
                                    "id": "230410315",
                                    "speaker": "内尔敏",
                                    "text": "我想把它们加入「薄荷豆汤」里，然后送去给里夫。"
                                },
                                {
                                    "id": "230410316",
                                    "speaker": "内尔敏",
                                    "text": "现在「薄荷豆汤」我已经会做了，就等人帮我去拿「墩墩桃」啦。",
                                    "choices": [
                                        {
                                            "id": "230410317",
                                            "text": "我知道了…",
                                            "response": [
                                                {
                                                    "id": "230410318",
                                                    "speaker": "内尔敏",
                                                    "text": "谢谢你啦，等你回来之后，我再请你喝一碗「薄荷豆汤」。"
                                                },
                                                {
                                                    "id": "230410321",
                                                    "speaker": "内尔敏",
                                                    "text": "那就拜托你了，旅行者。采到「墩墩桃」后就带回来给我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230410319",
                                            "text": "他在工作时能喝吗？",
                                            "response": [
                                                {
                                                    "id": "230410320",
                                                    "speaker": "内尔敏",
                                                    "text": "就只是喝点东西而已啦，他的工作没有那么紧张。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230410312",
                            "text": "这碗还给你！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304105",
            "objective": "回去给绿植浇水",
            "dialogues": [
                {
                    "id": "230410501",
                    "speaker": "内尔敏",
                    "text": "旅行者，你取到水了吗？"
                },
                {
                    "id": "230410502",
                    "speaker": "Player",
                    "text": "算是取到了吧…"
                },
                {
                    "id": "230410503",
                    "speaker": "内尔敏",
                    "text": "太好了，我这就开始浇花，你稍等一下…"
                },
                {
                    "id": "230410504",
                    "speaker": "Black Screen",
                    "text": "内尔敏开始了浇花…"
                },
                {
                    "id": "230410505",
                    "speaker": "内尔敏",
                    "text": "呼…这样应该就可以了…"
                },
                {
                    "id": "230410506",
                    "speaker": "内尔敏",
                    "text": "库尔苏姆奶奶说，浇水的时候，只要浇到花盆底下有水透出来就可以停下了。"
                },
                {
                    "id": "230410507",
                    "speaker": "内尔敏",
                    "text": "这样就算是「浇透」了花土，之后就要每三天浇一次水…"
                },
                {
                    "id": "230410508",
                    "speaker": "内尔敏",
                    "text": "喔！对不起，我怎么自言自语起来了…这些是报酬，谢谢你帮忙，旅行者。"
                },
                {
                    "id": "230410509",
                    "speaker": "内尔敏",
                    "text": "修剪叶片的时候，要用什么工具好呢…"
                }
            ]
        },
        {
            "id": "2304117",
