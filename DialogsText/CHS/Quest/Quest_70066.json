            "id": "7006601",
            "objective": "与常九爷对话",
            "dialogues": [
                {
                    "id": "100031301",
                    "speaker": "常九爷",
                    "text": "开始幻想了，幻想我是九老师。这种文章，九老师会怎么写…"
                },
                {
                    "id": "100031302",
                    "speaker": "派蒙",
                    "text": "常九爷，这个给你。"
                },
                {
                    "id": "100031303",
                    "speaker": "常九爷",
                    "text": "嗯，什么东西？"
                },
                {
                    "id": "100031304",
                    "speaker": "常九爷",
                    "text": "怎么这么多钱！"
                },
                {
                    "id": "100031305",
                    "speaker": "派蒙",
                    "text": "这个，呃，那个。就是…对！九老师很欣赏你，所以决定资助你的写作事业！"
                },
                {
                    "id": "100031306",
                    "speaker": "常九爷",
                    "text": "什么乱七八糟的。不过我发现了。我的天，幻想自己是九老师真的有用！"
                },
                {
                    "id": "100031307",
                    "speaker": "Black Screen",
                    "text": "不过常九爷觉得钱财皆下品，唯有写书高。他很随意地把钱丢在一边，继续幻想了。\\n\\n你们继续走上了回蒙德的路…"
                }
            ]
        }
    ]
