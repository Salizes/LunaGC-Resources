    "talks": [
        {
            "id": "7334201",
            "objective": "(test)首次看到花$HIDDEN",
            "dialogues": [
                {
                    "id": "733420101",
                    "speaker": "派蒙",
                    "text": "哇，斯露莎还挺厉害的嘛，一下子就让周围焕发了生机！"
                },
                {
                    "id": "733420102",
                    "speaker": "Player",
                    "text": "花灵的力量真奇妙。"
                },
                {
                    "id": "733420103",
                    "speaker": "斯露莎",
                    "text": "大惊小怪！以吾之威能，拯救「净觉花」不过是举手之劳！"
                },
                {
                    "id": "733420104",
                    "speaker": "斯露莎",
                    "text": "黯色的侵蚀还在扩张，这片「净觉花」只不过是诸多受害者之一…"
                },
                {
                    "id": "733420105",
                    "speaker": "斯露莎",
                    "text": "其他花池也没法幸免于难，瑟法娜想必正手忙脚乱，惊慌失措吧。"
                },
                {
                    "id": "733420106",
                    "speaker": "派蒙",
                    "text": "听起来，你说的瑟法娜，应该是个勤勤恳恳照顾花儿们的好花灵？"
                },
                {
                    "id": "733420107",
                    "speaker": "派蒙",
                    "text": "#我们就帮帮那位花灵吧，{NICKNAME}？"
                },
                {
                    "id": "733420108",
                    "speaker": "斯露莎",
                    "text": "这点功绩，作为伟业正道旁的小小装点倒也无妨。吾之「谒颂主」，你就多多留意这样的「净觉花」吧。"
                },
                {
                    "id": "733420109",
                    "speaker": "Player",
                    "text": "下次看到了就通知你。"
                },
                {
                    "id": "733420110",
                    "speaker": "派蒙",
                    "text": "嗯，我们一起拯救这些漂亮的花！"
                }
            ]
        },
        {
            "id": "7334202",
