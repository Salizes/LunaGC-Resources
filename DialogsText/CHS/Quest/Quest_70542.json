    "talks": [
        {
            "id": "7054201",
            "objective": "(test)彩蛋对话1$HIDDEN",
            "dialogues": [
                {
                    "id": "705420101",
                    "speaker": "莫娜",
                    "text": "喵…喵呜？"
                },
                {
                    "id": "705420102",
                    "speaker": "莫娜",
                    "text": "猫之间是这样打招呼的吗？发音会不会不够标准…"
                },
                {
                    "id": "705420103",
                    "speaker": "「雪糕」",
                    "text": "喵？"
                },
                {
                    "id": "705420104",
                    "speaker": "派蒙",
                    "text": "结果「雪糕」完全没听懂嘛。"
                },
                {
                    "id": "705420105",
                    "speaker": "派蒙",
                    "text": "莫娜在尝试猫语吗…",
                    "choices": [
                        {
                            "id": "705420106",
                            "text": "莫娜老师，不是这样念的。",
                            "response": [
                                {
                                    "id": "705420108",
                                    "speaker": "派蒙",
                                    "text": "喂！「嗷嗷呜呜」听起来像老虎狮子，完全是吓唬猫猫的发音嘛！"
                                },
                                {
                                    "id": "705420109",
                                    "speaker": "莫娜",
                                    "text": "#{NICKNAME}和派蒙！原来传说是真的，你们确实在「猫茸茸城堡」打工啊？"
                                },
                                {
                                    "id": "705420110",
                                    "speaker": "派蒙",
                                    "text": "倒也不能说是打工啦，我们只是在帮瓦乐瑞娜和罗莎莉亚的忙而已，更像是…顾问！"
                                },
                                {
                                    "id": "705420111",
                                    "speaker": "派蒙",
                                    "text": "没错，顾问这个称号听起来就很厉害，哼哼！"
                                },
                                {
                                    "id": "705420112",
                                    "speaker": "派蒙",
                                    "text": "话说回来，「伟大的占星术士莫娜」，你是想要领养一只猫猫，来辅佐你观察星象吗？"
                                },
                                {
                                    "id": "705420113",
                                    "speaker": "莫娜",
                                    "text": "凭我对星象学的理解，教会猫猫看懂星象，似乎也不是难事，甚至还能…让猫猫帮我写稿？"
                                },
                                {
                                    "id": "705420114",
                                    "speaker": "莫娜",
                                    "text": "（偷瞄雪糕）"
                                },
                                {
                                    "id": "705420115",
                                    "speaker": "派蒙",
                                    "text": "（堂堂正正看向雪糕）"
                                },
                                {
                                    "id": "705420116",
                                    "speaker": "「雪糕」",
                                    "text": "喵！"
                                },
                                {
                                    "id": "705420117",
                                    "speaker": "莫娜",
                                    "text": "咳咳，还是算了，只是看懂星象，而不懂深入浅出地遣词造句，写出的稿子就不足以传达我的真知灼见。"
                                },
                                {
                                    "id": "705420118",
                                    "speaker": "莫娜",
                                    "text": "需要写稿的助手，不如再去趟枫丹，说服某位蒸汽鸟报的文员，或者找一位会用打字机的美露莘来蒙德…"
                                },
                                {
                                    "id": "705420119",
                                    "speaker": "莫娜",
                                    "text": "要是我当真领养了猫猫，最多只是和猫猫们一起玩，好好放松，排解学术研究的劳累。"
                                },
                                {
                                    "id": "705420120",
                                    "speaker": "莫娜",
                                    "text": "不能当个坏主人，自己累了，还要让猫猫一起累。"
                                },
                                {
                                    "id": "705420121",
                                    "speaker": "莫娜",
                                    "text": "踏进这间屋子前，我还真没想到，和猫猫们交流是这么愉快的事…大家都要一直这样开开心心！"
                                },
                                {
                                    "id": "705420122",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，看来莫娜还是非常自觉的，把猫猫交给你，大家都放一万个心！"
                                },
                                {
                                    "id": "705420123",
                                    "speaker": "莫娜",
                                    "text": "不过我也听说，有的猫猫性格特别活泼，总是在屋里上蹿下跳，还喜欢抓挠啃咬家具…"
                                },
                                {
                                    "id": "705420124",
                                    "speaker": "莫娜",
                                    "text": "万一把我的稿子，或者占星相关的资料咬坏，那可就麻烦了！"
                                },
                                {
                                    "id": "705420125",
                                    "speaker": "派蒙",
                                    "text": "咬坏贵重的书…这么恐怖的事，我也不敢想了！"
                                },
                                {
                                    "id": "705420126",
                                    "speaker": "莫娜",
                                    "text": "「雪糕」看起来非常乖，但好像不太能理解我的意思…或许我们不是特别默契。"
                                },
                                {
                                    "id": "705420127",
                                    "speaker": "莫娜",
                                    "text": "所以我还要再观察一下，有没有听话的猫猫。"
                                },
                                {
                                    "id": "705420128",
                                    "speaker": "莫娜",
                                    "text": "然后计算一下猫窝，猫粮之类的开销。不能过分奢侈，也不能委屈了猫猫。",
                                    "choices": [
                                        {
                                            "id": "705420129",
                                            "text": "没事没事，慢慢来就好。",
                                            "response": [
                                                {
                                                    "id": "705420131",
                                                    "speaker": "派蒙",
                                                    "text": "对喔，瓦乐瑞娜小姐说过，以后还会收养更多流浪猫的，就算现在找不到合适的猫猫，也可以多来玩玩，多看看！"
                                                },
                                                {
                                                    "id": "705420132",
                                                    "speaker": "「雪糕」",
                                                    "text": "喵~"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705420130",
                                            "text": "城堡里还会有更多猫的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705420107",
                            "text": "尝试对它嗷嗷呜呜…"
                        }
                    ]
                }
            ]
        }
    ]
}