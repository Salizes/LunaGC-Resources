    "talks": [
        {
            "id": "4007401",
            "objective": "休息到次日（6点-24点）",
            "dialogues": []
        },
        {
            "id": "4007411",
            "objective": "与众人会合",
            "dialogues": [
                {
                    "id": "400741101",
                    "speaker": "辛焱",
                    "text": "各位，这边集合！"
                },
                {
                    "id": "400741102",
                    "speaker": "枫原万叶",
                    "text": "大家都睡醒了吧？莫娜刚才说，有重要的事要宣布。"
                },
                {
                    "id": "400741103",
                    "speaker": "菲谢尔",
                    "text": "君临幽夜净土后晨曦初绽之时，确实令本皇女心旷神怡。"
                },
                {
                    "id": "400741104",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，她已经准备好面对接下来的挑战了。"
                },
                {
                    "id": "400741105",
                    "speaker": "派蒙",
                    "text": "我们也睡饱吃饱了哦。"
                },
                {
                    "id": "400741106",
                    "speaker": "莫娜",
                    "text": "嗯。那我就直说了。"
                },
                {
                    "id": "400741107",
                    "speaker": "莫娜",
                    "text": "刚才我用水占盘看过，有一处新的幻境，已经在那边的岛屿上汇聚成型。"
                },
                {
                    "id": "400741108",
                    "speaker": "莫娜",
                    "text": "而且…如果直觉没错的话，应该与我有关。"
                },
                {
                    "id": "400741109",
                    "speaker": "辛焱",
                    "text": "这次是莫娜啊。之前几个幻境，莫娜都陪着我们去了。这回轮到我们去你那里看看啦。"
                },
                {
                    "id": "400741110",
                    "speaker": "莫娜",
                    "text": "呃…没什么好看的。"
                },
                {
                    "id": "400741111",
                    "speaker": "奥兹",
                    "text": "梅姬斯图斯卿，您是在不好意思吗？"
                },
                {
                    "id": "400741112",
                    "speaker": "莫娜",
                    "text": "不不，怎么会呢，啊哈哈，我才不担心大家看见过于寒碜的幻境从而对我这个人产生偏见呢…"
                },
                {
                    "id": "400741113",
                    "speaker": "枫原万叶",
                    "text": "都说出来了…"
                },
                {
                    "id": "400741114",
                    "speaker": "莫娜",
                    "text": "其实…大家一般都会觉得占星术士很超凡脱俗，对吧？我担心，万一我的幻境不是那样…"
                },
                {
                    "id": "400741115",
                    "speaker": "菲谢尔",
                    "text": "本皇女可没有在期待那种愚昧无比的事。"
                },
                {
                    "id": "400741116",
                    "speaker": "辛焱",
                    "text": "我也没有。倒不是不对你抱有期待啦，但我认为，莫娜你本来就是个亲切善良的人，不需要伪装。"
                },
                {
                    "id": "400741117",
                    "speaker": "枫原万叶",
                    "text": "怀抱平常心的人，其幻境也会呈现出相应的亲切。这不是好事吗？"
                },
                {
                    "id": "400741118",
                    "speaker": "派蒙",
                    "text": "对呀，再说，我们去莫娜的幻境也不只是观光旅游，还有别的目的吧？",
                    "choices": [
                        {
                            "id": "400741119",
                            "text": "嗯。说不定…",
                            "response": [
                                {
                                    "id": "400741121",
                                    "speaker": "莫娜",
                                    "text": "…这样啊，那就好。"
                                },
                                {
                                    "id": "400741122",
                                    "speaker": "莫娜",
                                    "text": "只要你们别太期待，我就不紧张了。好，那出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "400741120",
                            "text": "那里有解决幻象的线索。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007402",
            "objective": "前往危危岛",
            "dialogues": [
                {
                    "id": "400740201",
                    "speaker": "莫娜",
                    "text": "水占盘上显示，我们已经到幻境了。唔，先找入口…"
                },
                {
                    "id": "400740202",
                    "speaker": "派蒙",
                    "text": "会不会是那边那个？"
                },
                {
                    "id": "400740203",
                    "speaker": "辛焱",
                    "text": "这看起来…好像是个水池。"
                },
                {
                    "id": "400740204",
                    "speaker": "派蒙",
                    "text": "不会是要游泳进去吧？"
                },
                {
                    "id": "400740205",
                    "speaker": "莫娜",
                    "text": "……"
                },
                {
                    "id": "400740206",
                    "speaker": "莫娜",
                    "text": "难道，我们之中有旱鸭子？"
                },
                {
                    "id": "400740207",
                    "speaker": "枫原万叶",
                    "text": "我倒觉得问题可能不在这里…"
                },
                {
                    "id": "400740208",
                    "speaker": "莫娜",
                    "text": "啊哈，有人害怕了是吗？那好吧，就由我来打头阵。"
                },
                {
                    "id": "400740209",
                    "speaker": "菲谢尔",
                    "text": "开始了！她对游泳很自信，所以开始炫耀了！"
                },
                {
                    "id": "400740210",
                    "speaker": "奥兹",
                    "text": "咳！小姐，注意措辞。"
                },
                {
                    "id": "400740211",
                    "speaker": "菲谢尔",
                    "text": "啊、噢噢！"
                },
                {
                    "id": "400740212",
                    "speaker": "莫娜",
                    "text": "先走一步！"
                },
                {
                    "id": "400740213",
                    "speaker": "派蒙",
                    "text": "啊，莫娜跳进池子里消失了？！我们也快跟上去！"
                }
            ]
        },
        {
            "id": "4007403",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400740301",
                    "speaker": "枫原万叶",
                    "text": "好宏伟的建筑…"
                },
                {
                    "id": "400740302",
                    "speaker": "辛焱",
                    "text": "哇…我从来没见过这样的地方…"
                },
                {
                    "id": "400740303",
                    "speaker": "辛焱",
                    "text": "喂莫娜，你的幻境太厉害了吧！"
                },
                {
                    "id": "400740304",
                    "speaker": "菲谢尔",
                    "text": "虽然比起幽夜净土还是寒碜了一些，但也不错哦，梅姬斯图斯卿。"
                },
                {
                    "id": "400740305",
                    "speaker": "莫娜",
                    "text": "（太好了，幸好不是什么被老太婆训话的课堂…面子算是保住了…）"
                },
                {
                    "id": "400740306",
                    "speaker": "莫娜",
                    "text": "天才占星术士的幻境，当然得气派啦。"
                },
                {
                    "id": "400740307",
                    "speaker": "莫娜",
                    "text": "接下来，开始搜索吧。"
                }
            ]
        },
        {
