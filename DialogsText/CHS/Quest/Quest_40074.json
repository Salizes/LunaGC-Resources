            "dialogues": []
        },
        {
            "id": "4007412",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400741201",
                    "speaker": "奥兹",
                    "text": "梅姬斯图斯卿…这太让人难过了。"
                },
                {
                    "id": "400741202",
                    "speaker": "莫娜",
                    "text": "呃，别安慰我，我会很尴尬的…"
                },
                {
                    "id": "400741203",
                    "speaker": "辛焱",
                    "text": "此时无声胜有声，你需要拥抱吗？"
                },
                {
                    "id": "400741204",
                    "speaker": "莫娜",
                    "text": "不要啦！"
                },
                {
                    "id": "400741205",
                    "speaker": "莫娜",
                    "text": "这些是我以前的感悟，那时我才刚接触占星术没多久。"
                },
                {
                    "id": "400741206",
                    "speaker": "莫娜",
                    "text": "现在可是老手了，不会再被凡人的意见撼动。"
                },
                {
                    "id": "400741207",
                    "speaker": "菲谢尔",
                    "text": "真令人意外，宫廷大法师梅姬斯图斯卿也有混得很差的阶段呢。"
                },
                {
                    "id": "400741208",
                    "speaker": "枫原万叶",
                    "text": "被人误解的生活，一定很难熬…你能释怀真是太好了。"
                },
                {
                    "id": "400741209",
                    "speaker": "莫娜",
                    "text": "其实，真有人因为受不了这些，忍痛放弃了占星术。"
                },
                {
                    "id": "400741210",
                    "speaker": "莫娜",
                    "text": "但我是天才嘛，肯定能做到别人做不到的事。"
                },
                {
                    "id": "400741211",
                    "speaker": "派蒙",
                    "text": "在这么宏伟漂亮的地方说这种话，格外有魄力哦！",
                    "choices": [
                        {
                            "id": "400741212",
                            "text": "莫娜真厉害！",
                            "response": [
                                {
                                    "id": "400741214",
                                    "speaker": "莫娜",
                                    "text": "很好很好，再多夸一点。"
                                },
                                {
                                    "id": "400741215",
                                    "speaker": "奥兹",
                                    "text": "那个…无意叨扰各位的雅兴，不过，那边有扇门哦？"
                                },
                                {
                                    "id": "400741216",
                                    "speaker": "莫娜",
                                    "text": "好吧，等解决这一带的问题，再给你们机会使劲夸我。"
                                }
                            ]
                        },
                        {
                            "id": "400741213",
                            "text": "我知道莫娜绝对是天才。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007414",
            "objective": "进入幻境之门",
            "dialogues": []
        },
        {
            "id": "4007409",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400740901",
                    "speaker": "枫原万叶",
                    "text": "周围变了。这里不是我们出发前的海滩。"
                },
                {
                    "id": "400740902",
                    "speaker": "奥兹",
                    "text": "看起来，应该是蒙德的山地。难道说，我们被送到蒙德了？"
                },
                {
                    "id": "400740903",
                    "speaker": "菲谢尔",
                    "text": "但周围还是无垠之海呢。"
                },
                {
                    "id": "400740904",
                    "speaker": "莫娜",
                    "text": "周围应该有刚才那样可供进入的水池。"
                },
                {
                    "id": "400740905",
                    "speaker": "辛焱",
                    "text": "在这边！"
                },
                {
                    "id": "400740906",
                    "speaker": "莫娜",
                    "text": "…嗯？不能直接进入？"
                },
                {
                    "id": "400740907",
                    "speaker": "派蒙",
                    "text": "水面上好像浮现出什么东西了…"
                },
                {
                    "id": "400740908",
                    "speaker": "辛焱",
                    "text": "这是画吗？还是…"
                },
                {
                    "id": "400740909",
                    "speaker": "枫原万叶",
                    "text": "似乎在提示某个地点。"
                },
                {
                    "id": "400740910",
                    "speaker": "菲谢尔",
                    "text": "是希望本皇女带领大家前往那里呢。"
                },
                {
                    "id": "400740911",
                    "speaker": "莫娜",
                    "text": "怎么又是你带队了…算了，谁带都行，总之先把这个地方找出来吧。"
                }
            ]
        },
        {
            "id": "4007416",
            "objective": "(test)(hide)发送水池通知$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4007499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400749902",
                    "speaker": "派蒙",
                    "text": "唔？那边有颗星星…"
                },
                {
                    "id": "400749903",
                    "speaker": "派蒙",
                    "text": "跑掉了，我们也跟上去！"
                },
                {
                    "id": "400749904",
                    "speaker": "派蒙",
                    "text": "它进到那个里面了！"
                }
            ]
        }
    ]
}