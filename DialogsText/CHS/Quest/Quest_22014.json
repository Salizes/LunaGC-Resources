        },
        "total_dialogue_lines": 83,
        "total_speaker_counts": {
            "Player": 15,
            "卯师傅": 19,
            "旭东": 33,
            "派蒙": 3,
            "香菱": 13
        }
    },
    "talks": [
        {
            "id": "2201401",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "220140101",
                    "speaker": "旭东",
                    "text": "旅行者，嘿嘿，又见面了。",
                    "choices": [
                        {
                            "id": "220140102",
                            "text": "有什么事要帮忙吗？",
                            "response": [
                                {
                                    "id": "220140103",
                                    "speaker": "旭东",
                                    "text": "你还记得我上次承诺你的那顿饭吧？我正在为这顿饭做准备呢。"
                                },
                                {
                                    "id": "220140106",
                                    "speaker": "旭东",
                                    "text": "为了做一顿好菜，我们可是四处搜集各种新鲜的食材。"
                                },
                                {
                                    "id": "220140107",
                                    "speaker": "旭东",
                                    "text": "现在食材搜集得差不多了，我正在想做菜方法呢。"
                                },
                                {
                                    "id": "220140108",
                                    "speaker": "Player",
                                    "text": "朱莉和芭尔瓦涅去哪了？"
                                },
                                {
                                    "id": "220140109",
                                    "speaker": "旭东",
                                    "text": "她们啊，芭尔瓦涅说还想要继续寻找其他的食材，去做她想要的那种「万能调料」。"
                                },
                                {
                                    "id": "220140110",
                                    "speaker": "旭东",
                                    "text": "然后她就拉着朱莉去野外寻找食材去了…她们说不会离城太远，不用担心。"
                                },
                                {
                                    "id": "220140111",
                                    "speaker": "旭东",
                                    "text": "不过，我倒是需要你帮帮忙。虽然搜集到了很多稻妻的新鲜食材，但我却没有什么…突破性的灵感。"
                                },
                                {
                                    "id": "220140112",
                                    "speaker": "旭东",
                                    "text": "你看，海草…海灵芝，还有这个…呃，绯樱绣球…"
                                },
                                {
                                    "id": "220140113",
                                    "speaker": "旭东",
                                    "text": "虽然都是些新鲜的食材，我却完全不知道如何下手。"
                                },
                                {
                                    "id": "220140114",
                                    "speaker": "旭东",
                                    "text": "我本来是想请教一下稻妻本地的厨师。但如果这样做，那我做出来的菜肯定又是寻常的「稻妻菜」，没有任何新意。"
                                },
                                {
                                    "id": "220140115",
                                    "speaker": "旭东",
                                    "text": "所以，我想要以璃月厨师的思维，来处理这些稻妻的食材。这样的话，说不定就能做出新奇的好菜。"
                                },
                                {
                                    "id": "220140116",
                                    "speaker": "旭东",
                                    "text": "旅行者，能请你帮我回璃月一趟，请教一下「万民堂」的卯师傅吗？",
                                    "choices": [
                                        {
                                            "id": "220140117",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "220140118",
                                                    "speaker": "旭东",
                                                    "text": "那就拜托你了，我就在这等着你。"
                                                },
                                                {
                                                    "id": "220140124",
                                                    "speaker": "旭东",
                                                    "text": "希望卯师傅能有些好主意…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220140119",
                                            "text": "你是想要那种「噼咔」的感觉对吧？",
                                            "response": [
                                                {
                                                    "id": "220140120",
                                                    "speaker": "旭东",
                                                    "text": "「噼咔」是、是什么感觉？你是说那种…美食给人的震惊感吗？"
                                                },
                                                {
                                                    "id": "220140121",
                                                    "speaker": "旭东",
                                                    "text": "如果能找到有那种感觉的食谱，那当然最好。"
                                                },
                                                {
                                                    "id": "220140122",
                                                    "speaker": "旭东",
                                                    "text": "不过，能想出这种食谱的人，我可不认识啊…"
                                                },
                                                {
                                                    "id": "220140123",
                                                    "speaker": "旭东",
                                                    "text": "总之，拜托你先去帮我请教一下卯师傅吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220140104",
                            "text": "你是准备请我吃那顿饭吗？",
                            "response": [
                                {
                                    "id": "220140105",
                                    "speaker": "旭东",
                                    "text": "哈哈哈，我这不正是在为这顿饭做准备吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201402",
            "objective": "前往「万民堂」",
            "dialogues": [
                {
                    "id": "220140201",
                    "speaker": "卯师傅",
                    "text": "咦？旅行者，你怎么来了，是又想吃点好菜了吗？"
                },
                {
                    "id": "220140202",
                    "speaker": "Player",
                    "text": "是想要请教一件事…"
                },
                {
                    "id": "220140203",
                    "speaker": "卯师傅",
                    "text": "旭东居然为了做菜去稻妻了啊，他还真是有毅力。"
                },
                {
                    "id": "220140204",
                    "speaker": "Player",
                    "text": "你认识他？"
                },
                {
                    "id": "220140205",
                    "speaker": "卯师傅",
                    "text": "算是吧，之前我们俩也切磋过厨艺，勉强算是…不相上下吧。"
                },
                {
                    "id": "220140206",
                    "speaker": "卯师傅",
                    "text": "他之前就一直说，自己想要寻求突破，想要去世界各地旅行…没想到他还真这么做了。"
                },
                {
                    "id": "220140207",
                    "speaker": "卯师傅",
                    "text": "不过，看样子他也遇到瓶颈了…",
                    "choices": [
                        {
                            "id": "220140208",
                            "text": "你知道怎么解决他的问题吗？",
                            "response": [
                                {
                                    "id": "220140209",
                                    "speaker": "卯师傅",
                                    "text": "我也不能保证，但我会尽力试试。"
                                },
                                {
                                    "id": "220140214",
                                    "speaker": "卯师傅",
                                    "text": "海草…海灵芝…还有这个什么…绯樱绣球？这都是什么奇怪的食材…"
                                },
                                {
                                    "id": "220140215",
                                    "speaker": "卯师傅",
                                    "text": "不过，如果单看海草和海灵芝…的话，我想也许可以做一道菜…但还需要些另外的辅料。"
                                },
                                {
                                    "id": "220140216",
                                    "speaker": "卯师傅",
                                    "text": "旅行者，能请你帮我去找一些绝云椒椒和禽肉来吗？",
                                    "choices": [
                                        {
                                            "id": "220140217",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "220140218",
                                                    "speaker": "卯师傅",
                                                    "text": "那就拜托了，找到绝云椒椒和禽肉之后，就带回来给我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220140219",
                                            "text": "果然是经典食材啊…",
                                            "response": [
                                                {
                                                    "id": "220140220",
                                                    "speaker": "卯师傅",
                                                    "text": "哈哈哈，那是当然了，这些食材可都是最可靠的，你拿到之后，就带回来给我吧。"
                                                },
                                                {
                                                    "id": "220140221",
                                                    "speaker": "卯师傅",
                                                    "text": "不过，这个什么绯樱绣球我是真不知道怎么入菜…不知道稻妻那边的厨师会怎么处理。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220140210",
                            "text": "也许香菱知道怎么解决他的问题…",
                            "response": [
                                {
                                    "id": "220140211",
                                    "speaker": "卯师傅",
                                    "text": "香菱啊，嗯…这孩子做菜一向很有创意，说不定真能找到解决方法。"
                                },
                                {
                                    "id": "220140212",
                                    "speaker": "卯师傅",
                                    "text": "但她现在去轻策庄那边采竹笋去了，暂时不在店里，你们想找她，估计要花点时间了。"
                                },
                                {
                                    "id": "220140213",
                                    "speaker": "卯师傅",
                                    "text": "旭东应该急着等回复呢，还是我来看看能不能解决他的问题吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201403",
            "objective": "将绝云椒椒和禽肉交给卯师傅",
            "dialogues": [
                {
                    "id": "220140301",
                    "speaker": "卯师傅",
                    "text": "你拿到绝云椒椒和禽肉了吗？"
                }
            ]
        },
        {
            "id": "2201404",
            "objective": "与卯师傅对话",
            "dialogues": [
                {
                    "id": "220140401",
                    "speaker": "卯师傅",
                    "text": "这些应该就足够了，你们稍等一下，我看看怎么处理这些食材…"
                },
                {
                    "id": "220140402",
                    "speaker": "卯师傅",
                    "text": "做好了。唔…但我感觉，好像和平常我做的那些菜没什么太大的区别…"
                },
                {
                    "id": "220140403",
                    "speaker": "卯师傅",
                    "text": "你们拿回去给旭东吧，希望这份菜能解决他的问题…"
                }
            ]
        },
        {
            "id": "2201405",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "220140601",
                    "speaker": "香菱",
                    "text": "这里的竹笋应该还不错，挖一点带回去好了…"
                },
                {
                    "id": "220140602",
                    "speaker": "香菱",
                    "text": "咦？是你啊，你怎么在这？是又想吃点好菜了吗？",
                    "choices": [
                        {
                            "id": "220140603",
                            "text": "有事情想请教你。",
                            "response": [
                                {
                                    "id": "220140607",
                                    "speaker": "香菱",
                                    "text": "用璃月的手法，处理稻妻的食材吗…"
                                },
                                {
                                    "id": "220140608",
                                    "speaker": "香菱",
                                    "text": "嘿嘿，你们问我算是问对人啦。我之前听说过稻妻那边，有一种用面粉裹住食材下锅油炸的做菜手法。"
                                },
                                {
                                    "id": "220140609",
                                    "speaker": "香菱",
                                    "text": "用这种手法做出来的食物，似乎是被称为「天妇罗」，还要搭配特别的蘸汁来着。"
                                },
                                {
                                    "id": "220140610",
                                    "speaker": "香菱",
                                    "text": "我之前试做「天妇罗」的时候，对这种蘸汁特别感兴趣。"
                                },
                                {
                                    "id": "220140615",
                                    "speaker": "香菱",
                                    "text": "而且还试过好多材料呢，比如骗骗花蜜啦、烈焰花啦…"
                                },
                                {
                                    "id": "220140611",
                                    "speaker": "Player",
                                    "text": "还有史莱姆凝液是吧…"
                                },
                                {
                                    "id": "220140612",
                                    "speaker": "香菱",
                                    "text": "没有没有，这道菜用史莱姆凝液不太合适啦。"
                                },
                                {
                                    "id": "220140616",
                                    "speaker": "香菱",
                                    "text": "我还是更倾向于加入雷萤翅膀上的粉末，让口感更加有层次感。"
                                },
                                {
                                    "id": "220140613",
                                    "speaker": "香菱",
                                    "text": "这么说你肯定也记不住，我给你抄一份下来，你拿过去给旭东吧。"
                                },
                                {
                                    "id": "220140614",
                                    "speaker": "香菱",
                                    "text": "唉，要是我也能去稻妻就好了，那里肯定有很多我没试过的食材。"
                                }
                            ]
                        },
                        {
                            "id": "220140604",
                            "text": "和卯师傅的反应一模一样…",
                            "response": [
                                {
                                    "id": "220140605",
                                    "speaker": "香菱",
                                    "text": "你还去店里了啊，不过，看你也不是特意去吃饭的样子…"
                                },
                                {
                                    "id": "220140606",
                                    "speaker": "香菱",
                                    "text": "难道，你是遇见了什么和做菜有关的问题吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2201406",
            "objective": "(test)对话香菱$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2201407",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "220140701",
                    "speaker": "旭东",
                    "text": "你们回来了，卯师傅怎么说？"
                }
            ]
        },
        {
            "id": "2201408",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "220140801",
                    "speaker": "旭东",
                    "text": "这道菜…我尝尝看…"
                },
                {
                    "id": "220140802",
                    "speaker": "旭东",
                    "text": "味道确实很正，食材之间的搭配也很不错，不愧是卯师傅。"
                },
                {
                    "id": "220140803",
                    "speaker": "旭东",
                    "text": "但是，我总觉得这份菜少了一点感觉…"
                },
                {
                    "id": "220140804",
                    "speaker": "Player",
                    "text": "是「噼咔」的感觉吧。"
                },
                {
                    "id": "220140805",
                    "speaker": "旭东",
                    "text": "我也说不清…唉，我还是再自己想一想吧，卯师傅至少给我提供了一个思路。"
                },
                {
                    "id": "220140806",
                    "speaker": "旭东",
                    "text": "谢谢你帮忙跑这一趟，这些东西请你收下吧。"
                },
                {
                    "id": "220140807",
                    "speaker": "旭东",
                    "text": "到底怎么样才能做出有新意的菜呢…"
                }
            ]
        },
        {
            "id": "2201409",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "220140901",
                    "speaker": "旭东",
                    "text": "这是…香菱写的？你们居然能找到她，真是不容易，辛苦你们了。"
                },
                {
                    "id": "220140903",
                    "speaker": "旭东",
                    "text": "我来看看…呃，骗骗花蜜…烈焰花…还有雷萤翅膀上的粉末…"
                },
                {
                    "id": "220140904",
                    "speaker": "旭东",
                    "text": "这还真是…出乎意料。"
                },
                {
                    "id": "220140905",
                    "speaker": "旭东",
                    "text": "我会好好研究一下这份笔记的，这些东西请收下，谢谢你们帮忙。"
                },
                {
                    "id": "220140906",
                    "speaker": "旭东",
                    "text": "咳…我得快点看完收好，绝对不能让芭尔瓦涅发现这份笔记…"
                }
            ]
        },
        {
            "id": "2201405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220140501",
                    "speaker": "旭东",
                    "text": "你们回来了，卯师傅怎么说？"
                }
            ]
        },
        {
            "id": "2201410",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220141001",
                    "speaker": "旭东",
                    "text": "希望卯师傅能有些好主意…"
                }
            ]
        },
        {
            "id": "2201499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220149901",
                    "speaker": "派蒙",
                    "text": "「万民堂」啊…我记得，那是香菱她们家开的店吧？"
                },
                {
                    "id": "220149902",
                    "speaker": "派蒙",
                    "text": "如果能向香菱请教的话就好了，她可是很擅长做菜呢。"
                },
                {
                    "id": "220149903",
                    "speaker": "派蒙",
                    "text": "说不定，还能再找到那种「噼咔」的感觉。"
                }
            ]
        }
    ]
}