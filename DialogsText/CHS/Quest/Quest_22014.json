{
    "quest": {
        "id": "22014",
        "title": "全能美食队·突破性思维",
        "description": "「全能美食队」的领队旭东似乎正为了某事而发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
