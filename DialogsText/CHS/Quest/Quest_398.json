    "talks": [
        {
            "id": "39810",
            "objective": "(test)拆除QQ人营地$HIDDEN",
            "dialogues": [
                {
                    "id": "3981001",
                    "speaker": "奥特",
                    "text": "唔…蒙德的受害情况还要整理成表，上报给丽莎小姐…"
                },
                {
                    "id": "3981002",
                    "speaker": "奥特",
                    "text": "没有伤亡，只是些碎砖破瓦，也要记录在案吗，唉…"
                }
            ]
        },
        {
            "id": "39812",
            "objective": "清理丘丘人设施",
            "dialogues": []
        },
        {
            "id": "39814",
            "objective": "(test)任务隔离，防止回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39811",
            "objective": "与奥特对话",
            "dialogues": [
                {
                    "id": "3981101",
                    "speaker": "奥特",
                    "text": "明明不是您需要承担的工作，居然还帮助我们打扫了战场…"
                },
                {
                    "id": "3981102",
                    "speaker": "奥特",
                    "text": "您的这种奉献精神让我自惭形秽。"
                },
                {
                    "id": "3981103",
                    "speaker": "奥特",
                    "text": "虽说比起您对骑士团的贡献，这点谢礼不值一提…但，还是希望您能收下。"
                }
            ]
        },
        {
            "id": "39801",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "3980101",
                    "speaker": "安柏",
                    "text": "啊，是你们！荣誉骑士凯旋归来啦。"
                },
                {
                    "id": "3980102",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{NICKNAME}陪特瓦林好好折腾了一番呢。"
                },
                {
                    "id": "3980103",
                    "speaker": "安柏",
                    "text": "嗯，你们是昨天回来的吧？琴团长比你们先回蒙德，你们的事迹，她都已经告诉大家了。"
                },
                {
                    "id": "3980104",
                    "speaker": "安柏",
                    "text": "呼…我什么时候也能有这样的机会呀…",
                    "choices": [
                        {
                            "id": "3980105",
                            "text": "多亏了安柏的引荐。",
                            "response": [
                                {
                                    "id": "3980106",
                                    "speaker": "安柏",
                                    "text": "不对不对，事情能这样和平解决，是多亏了你们才对。"
                                },
                                {
                                    "id": "3980107",
                                    "speaker": "安柏",
                                    "text": "那时我把你们带来蒙德，也只是普通地尽了侦察骑士的职责而已。"
                                },
                                {
                                    "id": "3980111",
                                    "speaker": "派蒙",
                                    "text": "哼哼，不用客气——对了，安柏是在这里等我们吗？"
                                },
                                {
                                    "id": "3980112",
                                    "speaker": "安柏",
                                    "text": "呃，虽然我这次的任务不是出征，但也没那么闲啦…你看，正在忙着做善后工作呢。"
                                },
                                {
                                    "id": "3980113",
                                    "speaker": "派蒙",
                                    "text": "「善后工作」？蒙德城这边发生什么了吗？"
                                },
                                {
                                    "id": "3980114",
                                    "speaker": "安柏",
                                    "text": "嗯…趁我们没有琴团长指挥的时候，附近的魔物向蒙德城发动了「总攻」。"
                                },
                                {
                                    "id": "3980115",
                                    "speaker": "安柏",
                                    "text": "好在很早之前我就侦察到了动向，丘丘人的聚落不自然地向蒙德城附近迁移。"
                                },
                                {
                                    "id": "3980116",
                                    "speaker": "派蒙",
                                    "text": "啊，我还记得。我们第一次见面的时候，你正在清理其中一个营地…"
                                },
                                {
                                    "id": "3980117",
                                    "speaker": "安柏",
                                    "text": "对，如果不是我们之前早有准备，蒙德城就会陷入危险。",
                                    "choices": [
                                        {
                                            "id": "3980118",
                                            "text": "成功击退了就好。",
                                            "response": [
                                                {
                                                    "id": "3980119",
                                                    "speaker": "安柏",
                                                    "text": "嗯，可是事情依旧蹊跷…"
                                                },
                                                {
                                                    "id": "3980120",
                                                    "speaker": "安柏",
                                                    "text": "丘丘人应该没有发动总攻的组织能力…"
                                                },
                                                {
                                                    "id": "3980123",
                                                    "speaker": "安柏",
                                                    "text": "所以我们猜测，这背后也是深渊教团在捣鬼。"
                                                },
                                                {
                                                    "id": "3980124",
                                                    "speaker": "派蒙",
                                                    "text": "他们操纵了那些丘丘人吗？嗯…如果我们不去解救特瓦林，那特瓦林也会像这样被操纵吧…"
                                                },
                                                {
                                                    "id": "3980125",
                                                    "speaker": "安柏",
                                                    "text": "没错。身为侦察骑士，看来今后要想办法多多监视深渊教团的家伙了。"
                                                },
                                                {
                                                    "id": "3980126",
                                                    "speaker": "安柏",
                                                    "text": "啊，真是不好意思。明明你们才刚经历大战归来，我就又说起这些严肃的话题。"
                                                },
                                                {
                                                    "id": "3980127",
                                                    "speaker": "安柏",
                                                    "text": "对了！我记得之前有过约定，要请你们吃「蜜酱胡萝卜煎肉」的，可后来一直在忙龙灾的事…"
                                                },
                                                {
                                                    "id": "3980128",
                                                    "speaker": "安柏",
                                                    "text": "不如这次就当作庆功，我来请你们吃吧？"
                                                },
                                                {
                                                    "id": "3980129",
                                                    "speaker": "派蒙",
                                                    "text": "好耶！就算安柏忘了，派蒙也不会忘的！"
                                                },
                                                {
                                                    "id": "3980130",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，我也好久没吃「蜜酱胡萝卜煎肉」了呢。"
                                                },
                                                {
                                                    "id": "3980131",
                                                    "speaker": "安柏",
                                                    "text": "你们先去<color=#00E1FFFF>「猎鹿人」</color>等我吧，等战场打扫完了，我就过去！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3980121",
                                            "text": "可是为什么丘丘人会…",
                                            "response": [
                                                {
                                                    "id": "3980122",
                                                    "speaker": "安柏",
                                                    "text": "是很奇怪，丘丘人应该没有发动总攻的组织能力…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3980108",
                            "text": "希望这样的「机会」不要太多…",
                            "response": [
                                {
                                    "id": "3980109",
                                    "speaker": "安柏",
                                    "text": "啊…说得也对，毕竟和平来之不易嘛。"
                                },
                                {
                                    "id": "3980110",
                                    "speaker": "安柏",
                                    "text": "这次也是多亏了你们，事情才能这样和平解决。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "39802",
            "objective": "途中与市民交谈（塞琉斯）",
            "dialogues": [
                {
                    "id": "3980401",
                    "speaker": "塞琉斯",
                    "text": "来了来了，热闹起来了！"
                },
                {
                    "id": "3980402",
                    "speaker": "塞琉斯",
                    "text": "危机啊，灾难啊！冒险啊，热血啊！"
                },
                {
                    "id": "3980403",
                    "speaker": "塞琉斯",
                    "text": "冒险家协会！终于！要脱离那些抓猫抓狗的琐碎委托了！新的冒险时代就要来临了！"
                },
                {
                    "id": "3980404",
                    "speaker": "塞琉斯",
                    "text": "年轻人啊，快来加入冒险家协会吧！在这动荡的时期，共赴龙灾，拯救蒙德！"
                },
                {
                    "id": "3980405",
                    "speaker": "Player",
                    "text": "这个嘛…"
                },
                {
                    "id": "3980406",
                    "speaker": "塞琉斯",
                    "text": "…啊，你说什么？！"
                },
                {
                    "id": "3980407",
                    "speaker": "塞琉斯",
                    "text": "龙灾的问题解决了？我错过了代理团长的演讲？"
                },
                {
                    "id": "3980408",
                    "speaker": "塞琉斯",
                    "text": "……"
                },
                {
                    "id": "3980409",
                    "speaker": "塞琉斯",
                    "text": "风魔龙为什么不能再坚持一下啊！我们还没出场呢！"
                }
            ]
        },
        {
            "id": "39803",
            "objective": "途中与市民交谈（宁禄）",
            "dialogues": [
                {
                    "id": "3980301",
                    "speaker": "宁禄",
                    "text": "谢谢你们！这一切终于真正地结束了。"
                },
                {
                    "id": "3980302",
                    "speaker": "宁禄",
                    "text": "受龙灾的影响，好多商路都不通了。粮食水果也就算了…酒要是断了货，那可真就要命咯！"
                },
                {
                    "id": "3980303",
                    "speaker": "宁禄",
                    "text": "我没法想象没有酒喝的日子。"
                },
                {
                    "id": "3980304",
                    "speaker": "宁禄",
                    "text": "唉，希望商道的修复可以快一些完成吧。"
                }
            ]
        },
        {
            "id": "39804",
            "objective": "途中与市民交谈（葛瑞丝）",
            "dialogues": [
                {
                    "id": "3980201",
                    "speaker": "葛瑞丝",
                    "text": "原来是「四风守护」之一的特瓦林大人啊…蒙德人不该忘记他旧日的自我牺牲。"
                },
                {
                    "id": "3980202",
                    "speaker": "葛瑞丝",
                    "text": "不幸中的万幸，我们与「东风之龙」特瓦林大人的关系，还没有走到不可挽回的地步…"
                },
                {
                    "id": "3980203",
                    "speaker": "葛瑞丝",
                    "text": "这多亏了你们，还有骑士团的琴团长，真是个虔诚的人呀。"
                },
                {
                    "id": "3980204",
                    "speaker": "葛瑞丝",
                    "text": "有西风骑士团在的话，今后的蒙德也会一如既往地安宁自由下去吧。"
                }
            ]
        },
        {
            "id": "39805",
            "objective": "(test)途中与市民交谈$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39806",
            "objective": "(test)任务隔离，防止回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39807",
            "objective": "前往猎鹿人餐馆",
            "dialogues": [
                {
                    "id": "3980701",
                    "speaker": "莎拉",
                    "text": "啊，客人今天要点些什么？"
                },
                {
                    "id": "3980702",
                    "speaker": "凯亚",
                    "text": "唉…真是无情啊，就这样无视了我这个「挚友」吗？",
                    "choices": [
                        {
                            "id": "3980703",
                            "text": "不小心把你看漏了。",
                            "response": [
                                {
                                    "id": "3980704",
                                    "speaker": "凯亚",
                                    "text": "哈哈哈…看来大战之后，你不仅是实力成长了，还具备了骑士「幽默」的美德。"
                                },
                                {
                                    "id": "3980707",
                                    "speaker": "凯亚",
                                    "text": "蒙德的新晋英雄站在我的面前，身为骑士，感觉真是士气大振啊。"
                                },
                                {
                                    "id": "3980708",
                                    "speaker": "派蒙",
                                    "text": "凯亚又在花言巧语了。"
                                },
                                {
                                    "id": "3980709",
                                    "speaker": "凯亚",
                                    "text": "哈哈，我说的可都是真心话。",
                                    "choices": [
                                        {
                                            "id": "3980710",
                                            "text": "你在这边做什么？",
                                            "response": [
                                                {
                                                    "id": "3980711",
                                                    "speaker": "凯亚",
                                                    "text": "我正准备找个清静些的地方，好好整理一下思绪。"
                                                },
                                                {
                                                    "id": "3980712",
                                                    "speaker": "派蒙",
                                                    "text": "明明其他骑士都在辛苦地打扫战场…"
                                                },
                                                {
                                                    "id": "3980713",
                                                    "speaker": "凯亚",
                                                    "text": "思考也是一件辛苦的差事啊，我倒觉得清理那些垃圾更轻松一些。"
                                                },
                                                {
                                                    "id": "3980717",
                                                    "speaker": "派蒙",
                                                    "text": "嗯？那你在思考些什么呢？"
                                                },
                                                {
                                                    "id": "3980718",
                                                    "speaker": "凯亚",
                                                    "text": "是关于…深渊教团。"
                                                },
                                                {
                                                    "id": "3980719",
                                                    "speaker": "凯亚",
                                                    "text": "龙灾肆虐，骑士团长身在远方、讨伐巨龙，这对深渊教团来说，是非常好的战略机会。"
                                                },
                                                {
                                                    "id": "3980720",
                                                    "speaker": "凯亚",
                                                    "text": "如果你是深渊教团的怪物，你会只派丘丘人来「抓住这个好机会」吗？",
                                                    "choices": [
                                                        {
                                                            "id": "3980721",
                                                            "text": "只有丘丘人进攻，确实奇怪…",
                                                            "response": [
                                                                {
                                                                    "id": "3980723",
                                                                    "speaker": "凯亚",
                                                                    "text": "为了看清真相，我的决定是等待——等着观察他们的进一步行动。"
                                                                },
                                                                {
                                                                    "id": "3980724",
                                                                    "speaker": "凯亚",
                                                                    "text": "直到你们把风龙废墟搞得天昏地暗，丘丘人的喊声在城门响起的那天…"
                                                                },
                                                                {
                                                                    "id": "3980725",
                                                                    "speaker": "凯亚",
                                                                    "text": "我终于在蒙德城里，发现了可疑的身影。"
                                                                },
                                                                {
                                                                    "id": "3980726",
                                                                    "speaker": "派蒙",
                                                                    "text": "城里？！"
                                                                },
                                                                {
                                                                    "id": "3980727",
                                                                    "speaker": "凯亚",
                                                                    "text": "嗯，其他骑士在城外御敌的时候，不就是城内防御最空虚的时候吗？"
                                                                },
                                                                {
                                                                    "id": "3980728",
                                                                    "speaker": "凯亚",
                                                                    "text": "所以，留守城中的我，就与深渊教团的潜入者…周旋了一番。"
                                                                },
                                                                {
                                                                    "id": "3980729",
                                                                    "speaker": "凯亚",
                                                                    "text": "通过一些小手段，我获得了新的情报。"
                                                                },
                                                                {
                                                                    "id": "3980730",
                                                                    "speaker": "凯亚",
                                                                    "text": "情报是：这些集结起来的深渊教团怪物，在它们背后，还有一位统领者。"
                                                                },
                                                                {
                                                                    "id": "3980731",
                                                                    "speaker": "派蒙",
                                                                    "text": "深渊教团的…统领者？"
                                                                },
                                                                {
                                                                    "id": "3980732",
                                                                    "speaker": "凯亚",
                                                                    "text": "将特瓦林改造成战争兵器的计划，也是那位统领者所谋划的。"
                                                                },
                                                                {
                                                                    "id": "3980733",
                                                                    "speaker": "派蒙",
                                                                    "text": "用什么样的「小手段」，才能打听出这些啊？"
                                                                },
                                                                {
                                                                    "id": "3980734",
                                                                    "speaker": "凯亚",
                                                                    "text": "呵呵呵…你们可以认为是我在「语言」方面的天然才华吧。"
                                                                },
                                                                {
                                                                    "id": "3980735",
                                                                    "speaker": "凯亚",
                                                                    "text": "#那位统领者，被深渊教团的怪物称为…「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}殿下」。"
                                                                },
                                                                {
                                                                    "id": "3980736",
                                                                    "speaker": "Player",
                                                                    "text": "#「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…"
                                                                },
                                                                {
                                                                    "id": "3980737",
                                                                    "speaker": "凯亚",
                                                                    "text": "好了，情报共享就先到这里，我好像看到安柏正在向这边过来了。"
                                                                },
                                                                {
                                                                    "id": "3980738",
                                                                    "speaker": "凯亚",
                                                                    "text": "没去城门陪她一起御敌，她好像还在生我的气…请容我先离开一下，避避风头吧。"
                                                                },
                                                                {
                                                                    "id": "3980739",
                                                                    "speaker": "安柏",
                                                                    "text": "凯亚那个家伙居然跑掉了！做贼心虚！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "3980740",
                                                                            "text": "其实他也在暗地里努力…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3980741",
                                                                                    "speaker": "安柏",
                                                                                    "text": "是这样吗？唔…该不会你被他的什么花言巧语骗了吧？"
                                                                                },
                                                                                {
                                                                                    "id": "3980744",
                                                                                    "speaker": "安柏",
                                                                                    "text": "算了，先不提他啦。累了这么久，我已经肚子咕咕叫了，还是先点菜吧！"
                                                                                },
                                                                                {
                                                                                    "id": "3980745",
                                                                                    "speaker": "安柏",
                                                                                    "text": "莎拉小姐，我要「蜜酱胡萝卜煎肉」——"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "3980742",
                                                                            "text": "对！真是个坏家伙！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3980743",
                                                                                    "speaker": "安柏",
                                                                                    "text": "是呀，骑兵队长居然这么不以身作则，哼。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3980722",
                                                            "text": "那么，真相是…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3980714",
                                            "text": "你又在打什么主意？",
                                            "response": [
                                                {
                                                    "id": "3980715",
                                                    "speaker": "凯亚",
                                                    "text": "我吗？不不，恰恰相反，我在思考「别人」正在打什么主意。"
                                                },
                                                {
                                                    "id": "3980716",
                                                    "speaker": "凯亚",
                                                    "text": "我正准备找个清静些的地方，好好整理一下思绪。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3980705",
                            "text": "是你啊，我的挚友凯亚。",
                            "response": [
                                {
                                    "id": "3980706",
                                    "speaker": "凯亚",
                                    "text": "哦~我的热情得到回应了，这就是真诚的魅力吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "39815",
            "objective": "(test)控制门口营地和npc$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39808",
            "objective": "与安柏坐在同桌",
            "dialogues": []
        },
        {
            "id": "39816",
            "objective": "(test)上菜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39813",
            "objective": "(test)吃菜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39809",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "3980901",
                    "speaker": "安柏",
                    "text": "既然龙灾已经告一段落，你们接下来有什么安排呢？"
                },
                {
                    "id": "3980902",
                    "speaker": "派蒙",
                    "text": "#大概会离开蒙德，继续以走遍七国为目标，寻找{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}亲人的线索吧。"
                },
                {
                    "id": "3980903",
                    "speaker": "安柏",
                    "text": "这样啊…那也就是说要暂时分别了吗…",
                    "choices": [
                        {
                            "id": "3980904",
                            "text": "我也舍不得离开蒙德。",
                            "response": [
                                {
                                    "id": "3980906",
                                    "speaker": "安柏",
                                    "text": "没关系！不管去了哪里，只要是风能够吹到的地方，你永远都是西风骑士团的战友，是荣誉骑士！",
                                    "choices": [
                                        {
                                            "id": "3980907",
                                            "text": "听凭风引！",
                                            "response": [
                                                {
                                                    "id": "3980909",
                                                    "speaker": "安柏",
                                                    "text": "嗯！蒙德随时欢迎你们。"
                                                },
                                                {
                                                    "id": "3980910",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，我们快点吃吧，再多聊一会儿，肉就要凉啦。"
                                                },
                                                {
                                                    "id": "3980911",
                                                    "speaker": "派蒙",
                                                    "text": "嗯——好吃。不愧是安柏的推荐菜，没让我白白期待呢。"
                                                },
                                                {
                                                    "id": "3980912",
                                                    "speaker": "安柏",
                                                    "text": "那当然啦，虽然我对厨艺没什么自信，但我的品味还是很不错的！"
                                                },
                                                {
                                                    "id": "3980913",
                                                    "speaker": "安柏",
                                                    "text": "啊，对了，差点忘记告诉你…"
                                                },
                                                {
                                                    "id": "3980914",
                                                    "speaker": "安柏",
                                                    "text": "琴团长正在<color=#00E1FFFF>大教堂</color>等你，好像是关于天空之琴的事…还是赶快去一趟吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3980908",
                                            "text": "以后一定会回来的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3980905",
                            "text": "我也舍不得骑士团的大家。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "39820",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3982001",
                    "speaker": "安柏",
                    "text": "唉，真是的…丘丘人进攻的时候不仅琴团长不在，连身为骑兵队长的凯亚，也不知道去哪里了。"
                },
                {
                    "id": "3982002",
                    "speaker": "安柏",
                    "text": "好在参战的都是值得信赖的骑士，很好地履行了防御义务。"
                },
                {
                    "id": "3982003",
                    "speaker": "安柏",
                    "text": "不过，凯亚应该有他自己的行动理由吧。"
                },
                {
                    "id": "3982004",
                    "speaker": "安柏",
                    "text": "我是尽力不会去想「他其实躲在猫尾酒馆喝酒」的可能性啦…"
                }
            ]
        },
        {
            "id": "39821",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3982101",
                    "speaker": "霍夫曼",
                    "text": "向你致敬，荣誉骑士。"
                },
                {
                    "id": "3982102",
                    "speaker": "霍夫曼",
                    "text": "代理团长已经公开讲述了风魔龙事件的经过，真是振奋人心。"
                },
                {
                    "id": "3982103",
                    "speaker": "霍夫曼",
                    "text": "想不到真相竟是如此，骑士团差点制定了歼灭计划…现在看来恐怕太武断了。"
                },
                {
                    "id": "3982104",
                    "speaker": "霍夫曼",
                    "text": "不过，那些受灾民众，不知道会在什么时候原谅…又会原谅它到什么程度呢…？"
                },
                {
                    "id": "3982105",
                    "speaker": "霍夫曼",
                    "text": "总而言之，还是听凭风引吧。"
                }
            ]
        },
        {
            "id": "39822",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3982201",
                    "speaker": "盖伊",
                    "text": "好在当时阿贝多没离开蒙德城，防守一下子轻松了很多。"
                },
                {
                    "id": "3982202",
                    "speaker": "盖伊",
                    "text": "那位「骑士团首席炼金术士」的出手，还真是难得一见呢。"
                },
                {
                    "id": "3982203",
                    "speaker": "盖伊",
                    "text": "呼，说不定连我都开始对炼金术感兴趣了…"
                }
            ]
        }
    ]
}