    "talks": [
        {
            "id": "7721106",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7721101",
            "objective": "靠近冰上的木屋",
            "dialogues": [
                {
                    "id": "772110101",
                    "speaker": "下沉的房屋",
                    "text": "……"
                },
                {
                    "id": "772110102",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你听到了吗？窸窸窣窣的声音，好像是从木房子里面传出来的…"
                },
                {
                    "id": "772110103",
                    "speaker": "派蒙",
                    "text": "喂——你还在吗，丘尔卡图林！"
                },
                {
                    "id": "772110104",
                    "speaker": "Player",
                    "text": "你还在吗——"
                },
                {
                    "id": "772110105",
                    "speaker": "丘尔卡图林",
                    "text": "是你们，岸上的旅者。"
                },
                {
                    "id": "772110106",
                    "speaker": "派蒙",
                    "text": "你还在里面！快出来吧，冰块要融化了，你的房子要沉了！"
                },
                {
                    "id": "772110107",
                    "speaker": "丘尔卡图林",
                    "text": "是啊，冰块要融化了。",
                    "choices": [
                        {
                            "id": "772110108",
                            "text": "我们可以拉你上来。",
                            "response": [
                                {
                                    "id": "772110110",
                                    "speaker": "丘尔卡图林",
                                    "text": "上岸…谢谢你们，岸上的旅者。但是…"
                                },
                                {
                                    "id": "772110111",
                                    "speaker": "丘尔卡图林",
                                    "text": "不，我不会离开这间房屋。"
                                },
                                {
                                    "id": "772110112",
                                    "speaker": "派蒙",
                                    "text": "都什么时候了！不上岸的话，就要跟着这木房子一起沉到水下面去了呀。"
                                },
                                {
                                    "id": "772110113",
                                    "speaker": "丘尔卡图林",
                                    "text": "若是这片最后的、属于我的立足之地，终要在此刻，走向不可抗的下沉，那么我接受了：这也同样是我的命运。"
                                },
                                {
                                    "id": "772110114",
                                    "speaker": "丘尔卡图林",
                                    "text": "本就是我执意要增加它的重量：为了扩建、为了我对往昔荣光和体面的一点点贪恋，终让那冰块不堪重负…"
                                },
                                {
                                    "id": "772110115",
                                    "speaker": "丘尔卡图林",
                                    "text": "可这房屋…不论如何，它是我最后的栖息之所了。它承载我的肉身，也承载我身上的所有历史。"
                                },
                                {
                                    "id": "772110116",
                                    "speaker": "丘尔卡图林",
                                    "text": "它与我，本就同是旧时代仅存的遗物。如果踏出这间房屋，我也再不能找到自己在这世界上的根系。"
                                },
                                {
                                    "id": "772110117",
                                    "speaker": "派蒙",
                                    "text": "什么呀！那、那你不要命了！"
                                },
                                {
                                    "id": "772110118",
                                    "speaker": "丘尔卡图林",
                                    "text": "我本就是历史的幽灵，岸上的旅者。我承载着不可抛却的过去，已经度过了足够漫长的时间。"
                                },
                                {
                                    "id": "772110119",
                                    "speaker": "丘尔卡图林",
                                    "text": "除我以外，人人都可以靠岸，旅者。因为他们仍有新的生活可言。"
                                },
                                {
                                    "id": "772110120",
                                    "speaker": "丘尔卡图林",
                                    "text": "可我不同。要想开始新的生活，就必须抵偿过去，而这过去太沉重，太顽固，早已变成我生命中的一部分，难以切割。"
                                },
                                {
                                    "id": "772110121",
                                    "speaker": "丘尔卡图林",
                                    "text": "如果沉没要在此刻来临，那便让它来临。这本是我等待已久的命运。"
                                },
                                {
                                    "id": "772110122",
                                    "speaker": "Player",
                                    "text": "你还有机会选择你的命运…"
                                },
                                {
                                    "id": "772110123",
                                    "speaker": "丘尔卡图林",
                                    "text": "这就是我的「选择」，旅者。"
                                },
                                {
                                    "id": "772110124",
                                    "speaker": "丘尔卡图林",
                                    "text": "在河流上，只要知晓了风的规律，你总归大致知道，自己将漂向水域的何方。"
                                },
                                {
                                    "id": "772110125",
                                    "speaker": "丘尔卡图林",
                                    "text": "可在陆地上——陆地上的风，虽然几百年没有改变过它的轨迹，可这土地的未来，却不可以预测。"
                                },
                                {
                                    "id": "772110126",
                                    "speaker": "丘尔卡图林",
                                    "text": "如果踏上陆地…在这没有归属的土地，和它看不见尽头的未来里，我做出的选择，又有多少还属于「我」？"
                                },
                                {
                                    "id": "772110127",
                                    "speaker": "派蒙",
                                    "text": "糟了，冰块好像又多融化了一点…"
                                },
                                {
                                    "id": "772110128",
                                    "speaker": "派蒙",
                                    "text": "哎呀，别管什么选择了，快点下来吧！以后的事情以后再说。",
                                    "choices": [
                                        {
                                            "id": "772110129",
                                            "text": "以后也可以重新回到水上…",
                                            "response": [
                                                {
                                                    "id": "772110131",
                                                    "speaker": "派蒙",
                                                    "text": "对呀！如果只是不想回到陆地上生活，那上岸后再造一间一样的木房子，然后重新回到水上就好了！"
                                                },
                                                {
                                                    "id": "772110132",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "那永远不会一样，岸上的旅者。"
                                                },
                                                {
                                                    "id": "772110133",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "一间新的房屋，即使不建造在至冬的陆地上，对我来说，同样不是可以栖息的地方。"
                                                },
                                                {
                                                    "id": "772110134",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "重新制作一间房屋，那用以制作房屋的树木，不会再是与我共同生长的那片雪杨。"
                                                },
                                                {
                                                    "id": "772110135",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "重新为这房屋凝结的冰，承载的也不是过去的重量。"
                                                },
                                                {
                                                    "id": "772110136",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "失去了过去的我，和水面上的那些没有根基的浮冰，在本质上没有任何区别。即使回到水中，也会随时破碎、融化。"
                                                },
                                                {
                                                    "id": "772110137",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "这房子是旧时代存在的最后一点凭依，请让我这旧日的幽灵和它继续待在一块吧。"
                                                },
                                                {
                                                    "id": "772110138",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "谢谢你们，岸上的旅者，我的…朋友们。你们的帮助，曾经让这注定要沉没的房屋延续了些时日。"
                                                },
                                                {
                                                    "id": "772110139",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "如今，我最后一次请求你们的帮助。"
                                                },
                                                {
                                                    "id": "772110140",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "请你们将我留在这里，不必再破开水面的浮冰，不必再牵引，也不必再劝告。"
                                                },
                                                {
                                                    "id": "772110141",
                                                    "speaker": "丘尔卡图林",
                                                    "text": "如果你们愿意，就与我做最后的告别。"
                                                },
                                                {
                                                    "id": "772110142",
                                                    "speaker": "派蒙",
                                                    "text": "丘尔卡图林…",
                                                    "choices": [
                                                        {
                                                            "id": "772110143",
                                                            "text": "不，请你上岸吧。",
                                                            "response": [
                                                                {
                                                                    "id": "772110144",
                                                                    "speaker": "下沉的房屋",
                                                                    "text": "（房屋没有回应你，只是安静地下沉。）"
                                                                },
                                                                {
                                                                    "id": "772110147",
                                                                    "speaker": "Black Screen",
                                                                    "text": "\\n屋内再没有传来熟悉的声音。许久，只隐约听到一支陌生的歌谣，是谁用一种古老又复杂的语言轻轻哼唱。\\n也许它歌唱的是未曾倒下的雪杨树，是未曾消散的荣光，和未曾沉没的往昔。\\n歌声越来越轻，像细碎的、融化着的冰块，最终化作水面的泡沫。"
                                                                },
                                                                {
                                                                    "id": "772110148",
                                                                    "speaker": "Black Screen",
                                                                    "text": "\\n冰块融化了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "772110145",
                                                            "text": "再见。",
                                                            "response": [
                                                                {
                                                                    "id": "772110146",
                                                                    "speaker": "丘尔卡图林",
                                                                    "text": "再见。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "772110130",
                                            "text": "你还可以再造一间冰上的房屋…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "772110109",
                            "text": "是时候上岸了。"
                        }
                    ]
                }
            ]
        },
