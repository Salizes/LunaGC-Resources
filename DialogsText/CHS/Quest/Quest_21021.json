        {
            "id": "2102188",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210218801",
                    "speaker": "凯叔",
                    "text": "关于碎片…"
                },
                {
                    "id": "210218802",
                    "speaker": "凯叔",
                    "text": "什么东西，我瞧瞧。"
                },
                {
                    "id": "210218803",
                    "speaker": "凯叔",
                    "text": "这上面字不是字的…看不懂。"
                },
                {
                    "id": "210218804",
                    "speaker": "凯叔",
                    "text": "你去问问村长吧，她也许能看明白。"
                }
            ]
        },
        {
            "id": "2102199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210219901",
                    "speaker": "若心",
                    "text": "…没想到，还能看见这东西。"
                },
                {
                    "id": "210219902",
                    "speaker": "若心",
                    "text": "罢了，罢了，也算是缘分到了吧…",
                    "choices": [
                        {
                            "id": "210219903",
                            "text": "您能再说说那些碎片的位置吗…",
                            "response": [
                                {
                                    "id": "210219904",
                                    "speaker": "若心",
                                    "text": "你们是记不清了吗？也是啊，絮絮叨叨一大堆，太难记了。"
                                },
                                {
                                    "id": "210219905",
                                    "speaker": "若心",
                                    "text": "如果你们想要找到有关于那场战斗的碎片，可以先去<color=#00E1FFFF>「高处」</color>碰碰运气。"
                                },
                                {
                                    "id": "210219906",
                                    "speaker": "若心",
                                    "text": "然后，你们可以再去<color=#00E1FFFF>西边</color>，沿着<color=#00E1FFFF>「岩尊像」</color>仔细看看。"
                                },
                                {
                                    "id": "210219907",
                                    "speaker": "若心",
                                    "text": "最后，再留意一下周围的<color=#00E1FFFF>「遗迹」</color>吧。"
                                }
                            ]
                        },
                        {
                            "id": "210219908",
                            "text": "您是怎么知道…",
                            "response": [
                                {
                                    "id": "210219909",
                                    "speaker": "若心",
                                    "text": "知道？哈哈哈，谈不上「知道」。"
                                },
                                {
                                    "id": "210219910",
                                    "speaker": "若心",
                                    "text": "只不过年纪大了点，见识多了点，记性好了点。勉强记得些老掉牙的东西"
                                },
                                {
