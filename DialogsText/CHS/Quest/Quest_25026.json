        {
            "id": "2502611",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250261101",
                    "speaker": "特阿墨",
                    "text": "#又见面了，{NICKNAME}。怎么样？愿意和上次一样再帮我的忙吗？"
                },
                {
                    "id": "250261102",
                    "speaker": "特阿墨",
                    "text": "那群盗宝团可是一群不知悔改的恶徒，要是不管他们，这群人一定会继续犯下恶行。"
                },
                {
                    "id": "250261103",
                    "speaker": "特阿墨",
                    "text": "那只小匿叶龙虽然暂时安全了，但是它还那么小，还是得继续照顾…"
                }
            ]
        },
        {
            "id": "2502612",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250261201",
                    "speaker": "Player",
                    "text": "还是先去安慰小匿叶龙吧。"
                },
                {
                    "id": "250261202",
                    "speaker": "特阿墨",
                    "text": "行。这样的话，也许能让那孩子心情更好一些。"
                },
                {
                    "id": "250261203",
                    "speaker": "特阿墨",
                    "text": "有我们俩在，那群盗宝团一定不敢再来找霉头。"
                },
                {
                    "id": "250261204",
                    "speaker": "特阿墨",
                    "text": "让我想想…请你先去那边的树下采两朵新鲜的烛伞蘑菇吧。"
                },
                {
                    "id": "250261205",
                    "speaker": "特阿墨",
                    "text": "等你采好了，我们还是在竞技场那边的悬崖上集合。有你在，那些盗宝团肯定不敢露头。"
                }
            ]
        },
        {
            "id": "2502614",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250261401",
                    "speaker": "Player",
                    "text": "我们一起去教训盗宝团吧。"
                },
                {
                    "id": "250261402",
                    "speaker": "特阿墨",
                    "text": "没问题，那群盗宝团死性不改，又扎了新营。我已经确定好了位置。"
                },
                {
                    "id": "250261403",
                    "speaker": "特阿墨",
                    "text": "报酬还是按照冒险家的规矩来算。我们立刻出发吧。"
                }
            ]
        },
        {
            "id": "2502616",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250261601",
                    "speaker": "特阿墨",
                    "text": "那孩子不在啊…唔，我们就把烛伞蘑菇放在这里吧。",
                    "choices": [
                        {
                            "id": "250261602",
                            "text": "没看见它，有点遗憾。",
                            "response": [
                                {
                                    "id": "250261604",
                                    "speaker": "怯生生的小匿叶龙",
                                    "text": "呜！呜呜！呜…",
                                    "choices": [
                                        {
                                            "id": "250261605",
                                            "text": "欸？我好像听见什么声音。",
                                            "response": [
                                                {
                                                    "id": "250261607",
                                                    "speaker": "特阿墨",
                                                    "text": "我们还是先依着它吧。也许等这孩子再长大一些之后，就愿意和我们更亲近一些了。"
                                                },
                                                {
                                                    "id": "250261608",
                                                    "speaker": "特阿墨",
                                                    "text": "无论如何，只要它能开心地生活下去就好了。"
                                                },
                                                {
                                                    "id": "250261614",
                                                    "speaker": "特阿墨",
                                                    "text": "喂——我们走啦！",
                                                    "choices": [
                                                        {
                                                            "id": "250261615",
                                                            "text": "我们走啦！",
                                                            "response": [
                                                                {
                                                                    "id": "250261617",
                                                                    "speaker": "特阿墨",
                                                                    "text": "对了，这些报酬给你，就当做是感谢了。"
                                                                },
                                                                {
                                                                    "id": "250261618",
                                                                    "speaker": "特阿墨",
                                                                    "text": "希望那孩子能快快长大。这样的话…它就能亲自踢飞那些盗宝团了，哈哈哈！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "250261616",
                                                            "text": "下次再见！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250261606",
                                            "text": "难道它就躲在旁边？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250261603",
                            "text": "还想再见见那只小匿叶龙。"
                        }
                    ]
