    "talks": [
        {
            "id": "2502601",
            "objective": "帮助烦恼的猎人",
            "dialogues": [
                {
                    "id": "250260201",
                    "speaker": "Player",
                    "text": "还是先去安慰小匿叶龙吧。"
                },
                {
                    "id": "250260202",
                    "speaker": "特阿墨",
                    "text": "唔…你说得也有道理，那孩子一定被吓得够呛。还是先去安慰一下它比较好啊…"
                },
                {
                    "id": "250260203",
                    "speaker": "特阿墨",
                    "text": "那就跟我来吧，看你的模样，想必也是位经验丰富的冒险家。"
                },
                {
                    "id": "250260204",
                    "speaker": "特阿墨",
                    "text": "我们两个一起过去，那群不怀好意的人肯定不敢再来。不用担心报酬，我会按照冒险家的规矩准备好的。"
                },
                {
                    "id": "250260206",
                    "speaker": "特阿墨",
                    "text": "我想想，那孩子很喜欢吃新鲜的烛伞蘑菇…我记得那边的树下长着很多,请你先去采一些吧。"
                },
                {
                    "id": "250260205",
                    "speaker": "特阿墨",
                    "text": "我去另一边采烛伞蘑菇，等你采好了，我们在竞技场那边的悬崖上集合。"
                },
                {
                    "id": "250260207",
                    "speaker": "特阿墨",
                    "text": "那孩子平时经常在那边休息。也许我们可以去那边找到它。"
                }
            ]
        },
        {
            "id": "2502606",
            "objective": "(test)隐藏任务去采集$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2502607",
            "objective": "(test)隐藏任务去打怪$HIDDEN",
            "dialogues": [
                {
                    "id": "250260401",
                    "speaker": "Player",
                    "text": "我们一起去教训盗宝团吧。"
                },
                {
                    "id": "250260402",
                    "speaker": "特阿墨",
                    "text": "你愿意和我一起去？那太好了，看你这副模样…想必也是位经验丰富的冒险家。"
                },
                {
                    "id": "250260403",
                    "speaker": "特阿墨",
                    "text": "我会按冒险家的规矩准备好报酬的。那我们立即出发吧，给那群恶棍一点颜色瞧瞧。"
                }
            ]
        },
        {
            "id": "2502602",
            "objective": "采两朵新鲜的烛伞蘑菇",
            "dialogues": []
        },
        {
            "id": "2502603",
            "objective": "前往悬崖边寻找特阿墨",
            "dialogues": [
                {
                    "id": "250260301",
                    "speaker": "特阿墨",
                    "text": "平时那孩子经常呆在这里。但今天，怎么没见到它留下的痕迹…"
                },
                {
                    "id": "250260302",
                    "speaker": "特阿墨",
                    "text": "也许是被吓坏了，特意藏起来了吧。"
                },
                {
                    "id": "250260303",
                    "speaker": "Player",
                    "text": "我们要去找到它吗？"
                },
                {
                    "id": "250260304",
                    "speaker": "特阿墨",
                    "text": "…不必了。先让那孩子安静一会吧。咱们把烛伞蘑菇放在这里就好。"
                },
                {
                    "id": "250260305",
                    "speaker": "Player",
                    "text": "你还挺熟练的…"
                },
                {
                    "id": "250260306",
                    "speaker": "特阿墨",
                    "text": "我已经照顾这孩子一段时间了。它的性格很敏感，就算是遇见陌生人都会吓一跳。"
                },
                {
                    "id": "250260307",
                    "speaker": "特阿墨",
                    "text": "我喂了这只小匿叶龙很长时间，这孩子才愿意靠近我…唉，可是被那群恶棍一闹，它肯定又不愿意出来了。"
                },
                {
                    "id": "250260308",
                    "speaker": "特阿墨",
                    "text": "没办法，只能让它先自己安静一会了。"
                },
                {
                    "id": "250260309",
                    "speaker": "特阿墨",
                    "text": "多谢你陪我一起来。这是报酬，请收下吧。",
                    "choices": [
                        {
                            "id": "250260310",
                            "text": "没看见它，有点遗憾。",
                            "response": [
                                {
                                    "id": "250260312",
                                    "speaker": "特阿墨",
                                    "text": "放心。那孩子会记住对它好的人。等到时机成熟，它一定会来见我们的。"
                                }
                            ]
                        },
                        {
                            "id": "250260311",
                            "text": "还是想见见那只小匿叶龙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502604",
            "objective": "教训盗宝团",
            "dialogues": []
        },
        {
            "id": "2502605",
            "objective": "与特阿墨交谈",
            "dialogues": [
                {
                    "id": "250260501",
                    "speaker": "特阿墨",
                    "text": "哼，这下他们应该不敢随便去伤害小匿叶龙了。"
                },
                {
                    "id": "250260502",
                    "speaker": "Player",
                    "text": "总感觉，有什么误会…"
                },
                {
                    "id": "250260503",
                    "speaker": "特阿墨",
                    "text": "别听他们的花言巧语。我可是亲眼看着，他们想要把绳子捆在小匿叶龙的尾巴上。"
                },
                {
                    "id": "250260504",
                    "speaker": "特阿墨",
                    "text": "要不是我过去的及时，真不知道会出什么事。"
                },
                {
                    "id": "250260505",
                    "speaker": "特阿墨",
                    "text": "再次感谢你帮忙，这些报酬给你，请收下吧。"
                },
                {
                    "id": "250260506",
                    "speaker": "特阿墨",
                    "text": "可惜，那群盗宝团跑得太快了。要是能抓住他们，我一定要把这群恶徒斩草除根！"
                }
            ]
        },
        {
            "id": "2502601",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250260101",
                    "speaker": "特阿墨",
                    "text": "可怜的小匿叶龙…这帮恶棍，我一定得教训他们！"
                },
                {
                    "id": "250260102",
                    "speaker": "特阿墨",
                    "text": "恶棍们，你们可以逃，但绝对无处可藏…！"
                },
                {
                    "id": "250260103",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "250260104",
                    "speaker": "特阿墨",
                    "text": "你是…外来的旅行者，对吧？向你致意，很抱歉，现在我没办法招待你。"
                },
                {
                    "id": "250260105",
                    "speaker": "特阿墨",
                    "text": "那群不识好歹的盗宝团恶棍，又想抓住那只小匿叶龙，还好我去的及时，把他们都赶跑了。"
                },
                {
                    "id": "250260106",
                    "speaker": "特阿墨",
                    "text": "那只小匿叶龙一定是吓坏了，无论我怎么招呼，它都不肯过来…"
                },
                {
                    "id": "250260107",
                    "speaker": "特阿墨",
                    "text": "但现在，我已经找到了那群盗宝团的所在地，等会就去教训这帮恶棍。再把他们捆在树上，拿树藤狠狠地抽一顿！"
                },
                {
                    "id": "250260108",
                    "speaker": "特阿墨",
                    "text": "而且，还要找点好吃的，去安慰一下那只小匿叶龙才行…"
                }
            ]
        },
        {
            "id": "2502606",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "250260601",
                    "speaker": "特阿墨",
                    "text": "…嘘。看那边，那孩子在等我们。"
                },
                {
                    "id": "250260602",
                    "speaker": "怯生生的小匿叶龙",
                    "text": "…呜？呜，呜…？"
                },
                {
                    "id": "250260603",
                    "speaker": "特阿墨",
                    "text": "好孩子，来这边。我们不会伤害你的。"
                },
                {
                    "id": "250260604",
                    "speaker": "怯生生的小匿叶龙",
                    "text": "呜…？呜呜…"
                },
                {
                    "id": "250260605",
                    "speaker": "特阿墨",
                    "text": "我是特阿墨，记得吗？之前给你吃过好吃的。",
                    "choices": [
                        {
                            "id": "250260606",
                            "text": "#我是{NICKNAME}。",
                            "response": [
                                {
                                    "id": "250260608",
                                    "speaker": "怯生生的小匿叶龙",
                                    "text": "呜…呜呜！"
                                },
                                {
                                    "id": "250260609",
                                    "speaker": "Black Screen",
                                    "text": "和开心的小匿叶龙玩了一段时间。看起来，它似乎心情好了不少…"
                                },
                                {
                                    "id": "250260610",
                                    "speaker": "怯生生的小匿叶龙",
                                    "text": "呜！呜呜，呜！"
                                },
                                {
                                    "id": "250260611",
                                    "speaker": "特阿墨",
                                    "text": "#这是…{NICKNAME}，看来这孩子已经把你当朋友了，我们也都收到了礼物。"
                                },
                                {
                                    "id": "250260612",
                                    "speaker": "怯生生的小匿叶龙",
                                    "text": "呜！呜！"
                                },
                                {
                                    "id": "250260613",
                                    "speaker": "Player",
                                    "text": "谢谢你喔。"
                                },
                                {
                                    "id": "250260614",
                                    "speaker": "怯生生的小匿叶龙",
                                    "text": "呜！呜呜！呜！"
                                },
                                {
                                    "id": "250260615",
                                    "speaker": "Black Screen",
                                    "text": "小匿叶龙欢快地围着你们转了两圈，随后就转身，再次钻进了林子里。"
                                },
                                {
                                    "id": "250260616",
                                    "speaker": "特阿墨",
                                    "text": "看来，这孩子是回家了。希望它之后别再遇见恶棍了。"
                                },
                                {
                                    "id": "250260617",
                                    "speaker": "特阿墨",
                                    "text": "我们也回去吧。这些报酬给你，请收下吧。",
                                    "choices": [
                                        {
                                            "id": "250260618",
                                            "text": "一次委托收到了两份报酬。",
                                            "response": [
                                                {
                                                    "id": "250260620",
                                                    "speaker": "特阿墨",
                                                    "text": "那你可要把小匿叶龙送给你的那一份收好了。我给你的那一份嘛…哈哈哈，就随你怎么花吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250260619",
                                            "text": "这次的委托还蛮赚的嘛。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250260607",
                            "text": "帮你找过好吃的。"
                        }
                    ]
                }
            ]
        },
