    "talks": [
        {
            "id": "7507007",
            "objective": "(test)翼手龙听导演讲戏$HIDDEN",
            "dialogues": [
                {
                    "id": "750700701",
                    "speaker": "马尼菲科",
                    "text": "哈哈！我就知道我们会再次见面！瞧瞧你们来得多巧！你们即将见证我拍下人生中第二件杰作！"
                },
                {
                    "id": "750700702",
                    "speaker": "马尼菲科",
                    "text": "呃…也不是第二件啦，我不错的作品还是很多的…"
                },
                {
                    "id": "750700703",
                    "speaker": "马尼菲科",
                    "text": "总之，你们非常幸运，我正在准备在这里拍下一张动态场景画片，哈哈，这是我第一次挑战动态拍摄！"
                },
                {
                    "id": "750700704",
                    "speaker": "马尼菲科",
                    "text": "毕竟以前都是在案发现场拍受害者归档画片…呃，不过那些就没必要细说啦…"
                },
                {
                    "id": "750700705",
                    "speaker": "派蒙",
                    "text": "所以，这次还需要我们帮忙吗，马尼菲科先生？"
                },
                {
                    "id": "750700706",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀？"
                },
                {
                    "id": "750700707",
                    "speaker": "马尼菲科",
                    "text": "不…呃，嗯，如果你们能帮忙的话，也好！来吧，让我给你介绍下情况。"
                },
                {
                    "id": "750700708",
                    "speaker": "马尼菲科",
                    "text": "是这样的，我需要在这座瀑布拍摄一张绒翼龙向水面俯冲的画片，就是它在俯冲到谷底水面之上时最具冲击感的那个瞬间！"
                },
                {
                    "id": "750700709",
                    "speaker": "马尼菲科",
                    "text": "为了做准备，我在瀑布下的水潭里隐藏了能吸引绒翼龙的食物。只是…唉，到现在我还没有等到它们以合适的角度俯冲下去。"
                },
                {
                    "id": "750700710",
                    "speaker": "派蒙",
                    "text": "欸？不过水面上那个大圈…是个什么东西呀？"
                },
                {
                    "id": "750700711",
                    "speaker": "马尼菲科",
                    "text": "不用太在意那个，我也不太清楚…只是从附近的部落捡来充当标靶的垃圾罢了。"
                },
                {
                    "id": "750700712",
                    "speaker": "马尼菲科",
                    "text": "唉，到目前为止，我拍出的废片都是平平无奇，真是气人。我倒是还能继续等啦，只是既然你们来了…"
                },
                {
                    "id": "750700713",
                    "speaker": "马尼菲科",
                    "text": "或许你们可以…呃，开导一下它们？教教这些任性的小家伙们怎么好好俯冲！毕竟你们可是全纳塔有名的驯龙大师嘛！"
                },
                {
                    "id": "750700714",
                    "speaker": "马尼菲科",
                    "text": "很好，我从这里发出信号，只要在我倒数到「一」的时候，你们能够准确地冲到标靶的所在的水面上就好！",
                    "choices": [
                        {
                            "id": "750700715",
                            "text": "我们可以试试看。",
                            "response": [
                                {
                                    "id": "750700716",
                                    "speaker": "马尼菲科",
                                    "text": "哈哈，太好了，那就快点试试看吧！"
                                }
                            ]
                        },
                        {
                            "id": "750700717",
                            "text": "我们不保证成功…",
                            "response": [
                                {
                                    "id": "750700718",
                                    "speaker": "派蒙",
                                    "text": "没关系，失败也不过是浪费了我们的时间而已。我们是旅行者，旅行者的时间最不值钱。"
                                },
                                {
                                    "id": "750700719",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7507019",
            "objective": "帮助马尼菲科完成拍摄",
            "dialogues": []
        },
        {
            "id": "7507008",
            "objective": "帮助马尼菲科完成拍摄",
            "dialogues": []
        },
        {
            "id": "7507015",
            "objective": "(test)隐藏判断第一次失败$HIDDEN",
            "dialogues": [
                {
                    "id": "750701501",
                    "speaker": "马尼菲科",
                    "text": "有什么事吗？那些小家伙也不听你使唤吗？"
                }
            ]
        },
        {
            "id": "7507016",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750701601",
                    "speaker": "马尼菲科",
                    "text": "唉…如你所见，效果很…不理想。就像我这个人一样…一事无成，一事无成！"
                },
                {
                    "id": "750701602",
                    "speaker": "马尼菲科",
                    "text": "啊…我的家人总是告诉我，像我这样的小树总能投下大大的影子！全是胡说八道，全是胡说八道！他们只是想羞辱我！"
                },
                {
                    "id": "750701603",
                    "speaker": "马尼菲科",
                    "text": "呜……"
                },
                {
                    "id": "750701604",
                    "speaker": "派蒙",
                    "text": "呜哇…你也别发脾气啦！发脾气也不能让你显得块头更大呀！",
                    "choices": [
                        {
                            "id": "750701605",
                            "text": "请不要泄气…",
                            "response": [
                                {
                                    "id": "750701606",
                                    "speaker": "马尼菲科",
                                    "text": "谁说我泄气了！可恶！混蛋！愤怒和羞辱只能鞭策我继续前进！这就是恼羞成怒带来的力量！我们继续！"
                                },
                                {
                                    "id": "750701607",
                                    "speaker": "派蒙",
                                    "text": "唔…虽然确实蛮有斗志的…但这个人真奇怪啊…"
                                },
                                {
                                    "id": "750701608",
                                    "speaker": "马尼菲科",
                                    "text": "嗯，嗯。"
                                }
                            ]
                        },
                        {
                            "id": "750701609",
                            "text": "我们重来一次吧。",
                            "response": [
                                {
                                    "id": "750701610",
                                    "speaker": "马尼菲科",
                                    "text": "好！我们重来！"
                                },
                                {
                                    "id": "750701611",
                                    "speaker": "派蒙",
                                    "text": "呜哇！这心态恢复得也太快了点！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7507018",
            "objective": "帮助马尼菲科完成拍摄",
            "dialogues": []
        },
        {
            "id": "7507017",
            "objective": "帮助马尼菲科完成拍摄",
            "dialogues": []
        },
        {
            "id": "7507014",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750701401",
                    "speaker": "马尼菲科",
                    "text": "可恶，我们又得重来一次了！呃…我是说，如果你们不介意的话。"
                },
                {
                    "id": "750701402",
                    "speaker": "派蒙",
                    "text": "唉…既然来都来了，没什么介意不介意啦。",
                    "choices": [
                        {
                            "id": "750701403",
                            "text": "我们继续吧。",
                            "response": [
                                {
                                    "id": "750701404",
                                    "speaker": "马尼菲科",
                                    "text": "嗯，谢谢。"
                                }
                            ]
                        },
                        {
                            "id": "750701405",
                            "text": "请让我们休息一下…",
                            "response": [
                                {
                                    "id": "750701406",
                                    "speaker": "派蒙",
                                    "text": "跳崖可是体力活，也该让人家休息一下啦！"
                                },
                                {
                                    "id": "750701407",
                                    "speaker": "马尼菲科",
                                    "text": "唔…抱歉，是我欠考虑了。等你们准备好了直接开始就是，我一直在这里等着呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7507009",
            "objective": "与马尼菲科对话",
            "dialogues": [
                {
                    "id": "750700901",
                    "speaker": "马尼菲科",
                    "text": "哈哈，完美！副本给你！"
                },
                {
                    "id": "750700902",
                    "speaker": "派蒙",
                    "text": "哇！果然好厉害！"
                },
                {
                    "id": "750700903",
                    "speaker": "马尼菲科",
                    "text": "来，给你报酬，这是第二次…不，第三次受你们帮助了，我都怀疑如果没有你们帮忙，我这次摄影之旅还能不能走到最后！"
                },
                {
                    "id": "750700904",
                    "speaker": "马尼菲科",
                    "text": "我的下一个目的地是这里…在地图上给你们标好了。如果有兴趣的话，我时刻等着与你们再次合作。"
                },
                {
                    "id": "750700905",
                    "speaker": "马尼菲科",
                    "text": "啊…时间差不多了，我要走咯！也祝你们好运！"
                },
                {
                    "id": "750700906",
                    "speaker": "Black Screen",
                    "text": "马尼菲科收拾好行李，欢快地跃上了热气球。\\n随着热气球慢慢远去，小小的马尼菲科哈哈大笑，留下了悠远的回声。"
                }
            ]
        },
        {
            "id": "7507004",
            "objective": "Additional",
            "dialogues": [
