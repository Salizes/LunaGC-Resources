    "talks": [
        {
            "id": "7500901",
            "objective": "(test)试图进入挖掘场$HIDDEN",
            "dialogues": [
                {
                    "id": "750090101",
                    "speaker": "奎皮亚",
                    "text": "…进场三百摩拉。",
                    "choices": [
                        {
                            "id": "750090102",
                            "text": "能便宜点吗？",
                            "response": [
                                {
                                    "id": "750090105",
                                    "speaker": "奎皮亚",
                                    "text": "这是龙遗物研究协会规定的价格，没有商量的余地。据我所知，这里已经是定价最低的一处挖掘场了，毕竟开发得早。"
                                },
                                {
                                    "id": "750090106",
                                    "speaker": "奎皮亚",
                                    "text": "不过现在也偶尔会有像你们这样的梦想家来碰碰运气。"
                                },
                                {
                                    "id": "750090107",
                                    "speaker": "奎皮亚",
                                    "text": "说不定是之前的一百甚至一千人都没眼光，遗漏了那看似平平无奇实则价值连城的珍贵龙遗物。"
                                },
                                {
                                    "id": "750090108",
                                    "speaker": "奎皮亚",
                                    "text": "愿意花三百摩拉做个美梦的可是大有人在。"
                                },
                                {
                                    "id": "750090109",
                                    "speaker": "奎皮亚",
                                    "text": "那么，你也相信自己才是独一无二的那个幸运儿吗？"
                                },
                                {
                                    "id": "750090110",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…呀！呀呀！",
                                    "choices": [
                                        {
                                            "id": "750090111",
                                            "text": "我对自己的运气有信心。",
                                            "response": [
                                                {
                                                    "id": "750090113",
                                                    "speaker": "派蒙",
                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想去碰碰运气吗？"
                                                },
                                                {
                                                    "id": "750090114",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750090115",
                                                    "speaker": "派蒙",
                                                    "text": "看样子是很感兴趣呢。哼哼，区区三百摩拉，就由我来出好啦。"
                                                },
                                                {
                                                    "id": "750090116",
                                                    "speaker": "派蒙",
                                                    "text": "只用三百摩拉就可以买到三份希望，还是很划算的嘛！"
                                                },
                                                {
                                                    "id": "750090117",
                                                    "speaker": "奎皮亚",
                                                    "text": "那就祝几位旗开得胜了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750090112",
                                            "text": "无所谓，我有幸运小龙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750090103",
                            "text": "只要打败你就是免费对吧。",
                            "response": [
                                {
                                    "id": "750090104",
                                    "speaker": "派蒙",
                                    "text": "通常来说都不会这么想啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500907",
            "objective": "(test)提前进入遗迹$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7500908",
            "objective": "(test)被看守拦住$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7500903",
            "objective": "在挖掘场碰碰运气",
            "dialogues": []
        },
        {
            "id": "7500904",
            "objective": "跟上龙伙伴",
            "dialogues": []
        },
        {
            "id": "7500905",
            "objective": "在挖掘场继续探索",
            "dialogues": []
        },
        {
            "id": "7500902",
            "objective": "查看龙伙伴找到的「宝物」",
            "dialogues": [
                {
                    "id": "750090201",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750090202",
                    "speaker": "派蒙",
                    "text": "这个小球…看起来像是零件之类的东西。你喜欢这个吗？"
                },
                {
                    "id": "750090203",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…呀！"
                },
                {
                    "id": "750090204",
                    "speaker": "派蒙",
                    "text": "虽然不是挖出来的东西，但毕竟还是在这里发现的…说不定也有很高的价值呢。"
                },
                {
                    "id": "750090205",
                    "speaker": "派蒙",
                    "text": "离开的时候去问问吧！"
                }
            ]
        },
        {
            "id": "7500906",
            "objective": "回去问问奎皮亚",
            "dialogues": [
                {
                    "id": "750090601",
                    "speaker": "奎皮亚",
                    "text": "战果如何？"
                },
                {
                    "id": "750090602",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}找到了这个…"
                },
                {
                    "id": "750090603",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750090604",
                    "speaker": "奎皮亚",
                    "text": "让我看看…是不少见但难得的物件。保存完整，燃素流经的纹路也清晰可见。"
                },
                {
                    "id": "750090605",
                    "speaker": "奎皮亚",
                    "text": "嗯。如果我出一万摩拉的话，你们愿意把这个东西交给我吗？"
                },
                {
                    "id": "750090606",
                    "speaker": "派蒙",
                    "text": "欸？！难道我们真的找到了价值连城的珍贵龙遗物？"
                },
                {
                    "id": "750090607",
                    "speaker": "派蒙",
                    "text": "#我就知道{REALNAME[ID(2)|SHOWHOST(true)]}是个了不起的小家伙，能给我们带来好运！"
                },
                {
                    "id": "750090608",
                    "speaker": "奎皮亚",
                    "text": "不，这东西并没有你想的那么珍贵。拿去龙遗物研究协会总部鉴定的话，根据我的判断，充其量也就值五千摩拉。"
                },
                {
                    "id": "750090609",
                    "speaker": "派蒙",
                    "text": "我才不会上当呢，要是它真的只值五千摩拉，你又怎么会出一万收购？"
                },
                {
                    "id": "750090610",
                    "speaker": "奎皮亚",
                    "text": "因为我很中意它独特的纹路。虽然它在别人眼中没有那么高的价值，但我愿意为了得到它而花费额外的金钱。"
                },
                {
                    "id": "750090611",
                    "speaker": "奎皮亚",
                    "text": "可以说是怪癖，也可以说是收藏家的本性。"
                },
                {
                    "id": "750090612",
                    "speaker": "派蒙",
                    "text": "唔…这么说好像也不是不能理解。而且相比三百摩拉的进场费，一万摩拉也相当多了呢。"
                },
                {
                    "id": "750090613",
                    "speaker": "派蒙",
                    "text": "那我们要用它换一万摩拉吗？"
                },
                {
                    "id": "750090614",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜…呜呜。"
                },
                {
                    "id": "750090615",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}看起来不愿意的样子…是想自己留着吗？"
                },
                {
                    "id": "750090616",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…呀！",
                    "choices": [
                        {
                            "id": "750090617",
                            "text": "#毕竟是{REALNAME[ID(2)|SHOWHOST(true)]}自己找到的。",
                            "response": [
                                {
                                    "id": "750090619",
                                    "speaker": "派蒙",
                                    "text": "#既然{REALNAME[ID(2)|SHOWHOST(true)]}不愿意，那我们还是自己留着好了。"
                                },
                                {
                                    "id": "750090620",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750090621",
                                    "speaker": "奎皮亚",
                                    "text": "#看来你们是看重{REALNAME[ID(2)|SHOWHOST(true)]}更甚摩拉了。"
                                },
                                {
                                    "id": "750090622",
                                    "speaker": "派蒙",
                                    "text": "#那当然啦，{REALNAME[ID(2)|SHOWHOST(true)]}也是我们的伙伴嘛。不过如果我们之后找到类似的东西…"
                                },
                                {
                                    "id": "750090623",
                                    "speaker": "奎皮亚",
                                    "text": "谢谢你们，不过收藏家的热情就像潮水，来得快退得也快。之后大概会迷上别的东西吧，但会是什么我也说不好。"
                                },
                                {
                                    "id": "750090624",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750090625",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}是在赞同她？我懂了，这就是收藏家之间的惺惺相惜吧！"
                                },
                                {
                                    "id": "750090626",
                                    "speaker": "奎皮亚",
                                    "text": "能得到这么聪颖的小嵴锋龙的认可，真是荣幸。买卖不成仁义在，今后如果想交流收藏的心得，不妨来找我聊聊。"
                                },
                                {
                                    "id": "750090627",
                                    "speaker": "奎皮亚",
                                    "text": "那就不耽搁几位了，祝好。"
                                }
                            ]
                        },
                        {
                            "id": "750090618",
                            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想当收藏家啊。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750090801",
                    "speaker": "奎皮亚",
                    "text": "怎么了？进场是没有时限的，请便吧。"
                }
            ]
        }
    ]
