        {
            "id": "7115408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711540802",
                    "speaker": "夏洛蒂",
                    "text": "拍完了？你校正镜头了没，光源也确定好了？焦距什么的也都搞定了？我看看…"
                },
                {
                    "id": "711540803",
                    "speaker": "夏洛蒂",
                    "text": "呜哇，你还真的全部搞定了…拍得这么好，真厉害。"
                },
                {
                    "id": "711540804",
                    "speaker": "夏洛蒂",
                    "text": "等我下次出去采访的时候，一定要把你叫上，我们一起留影，肯定能拍出不少好画片。",
                    "choices": [
                        {
                            "id": "711540801",
                            "text": "关于我刚放的霄灯…",
                            "response": [
                                {
                                    "id": "711540805",
                                    "speaker": "夏洛蒂",
                                    "text": "我已经看到啦。我刚才为了留影，也放飞了好几盏霄灯呢。"
                                },
                                {
                                    "id": "711540806",
                                    "speaker": "夏洛蒂",
                                    "text": "心愿？啊…啊？！我光顾着留影，忘记写心愿了！不对不对，放飞那么多盏，许愿会不会不灵啊——"
                                }
                            ]
                        },
                        {
                            "id": "711540807",
                            "text": "再见，海灯节快乐。",
                            "response": [
                                {
                                    "id": "711540808",
                                    "speaker": "夏洛蒂",
                                    "text": "再见，你也要海灯节快乐啊！呃，这句话好像不太对…总之，要快快乐乐地玩喔。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
