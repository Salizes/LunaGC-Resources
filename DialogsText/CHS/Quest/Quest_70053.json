            "dialogues": [
                {
                    "id": "700530101",
                    "speaker": "宵宫",
                    "text": "#啊，是{NICKNAME}！好久没见你了，有好多话想和你讲。"
                },
                {
                    "id": "700530102",
                    "speaker": "宵宫",
                    "text": "昨天老爹又做了一批新的烟花，我也一起帮忙了，是一对新婚夫妇订购的。"
                },
                {
                    "id": "700530103",
                    "speaker": "宵宫",
                    "text": "我特地叮嘱老爹用了不同颜色的烟花，希望这些色彩能成为他们美好回忆的一部分。"
                },
                {
                    "id": "700530104",
                    "speaker": "宵宫",
                    "text": "还有还有…昨天早柚来我们店里玩了哦，我们还聊起你呢。"
                },
                {
                    "id": "700530105",
                    "speaker": "宵宫",
                    "text": "哎呀，你不在这里的时候，发生了好多事，好想全部分享给你！"
                },
                {
                    "id": "700530106",
                    "speaker": "宵宫",
                    "text": "结果一高兴就说得没完没了，都没好好问候你、听你说话。",
                    "choices": [
                        {
                            "id": "700530107",
                            "text": "好久不见，宵宫。",
                            "response": [
                                {
                                    "id": "700530108",
                                    "speaker": "宵宫",
                                    "text": "在这里遇见你真巧，一定是好运的预兆。对了，今天来这里是有什么特别的事情吗？",
                                    "choices": [
                                        {
                                            "id": "700530111",
                                            "text": "是来给美景留影的，正好遇见宵宫。",
                                            "response": [
                                                {
                                                    "id": "700530112",
                                                    "speaker": "宵宫",
                                                    "text": "所以你选中了甘金岛是吗？我也很喜欢这里，有空的时候就会来这里测试烟花。"
                                                },
                                                {
                                                    "id": "700530115",
                                                    "speaker": "宵宫",
                                                    "text": "我突然想到一个主意，你看，我带了新做的烟花哦。"
                                                },
                                                {
                                                    "id": "700530116",
                                                    "speaker": "宵宫",
                                                    "text": "你准备好留影机之后，就点燃烟花，我们一起把这个瞬间记录下来怎么样？"
                                                },
                                                {
                                                    "id": "700530117",
                                                    "speaker": "Player",
                                                    "text": "顺便给宵宫也拍一张吧。"
                                                },
                                                {
                                                    "id": "700530118",
                                                    "speaker": "宵宫",
                                                    "text": "好呀，用烟花做背景拍出来的画片一定很漂亮。"
                                                },
                                                {
                                                    "id": "700530119",
                                                    "speaker": "宵宫",
                                                    "text": "让我想想，用什么姿势入镜比较好呢，你有什么想法吗？",
