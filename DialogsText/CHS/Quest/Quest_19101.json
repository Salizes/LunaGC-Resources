    "quest": {
        "id": "19101",
        "title": "「猫尾酒馆」的调酒师",
        "description": "据说，「猫尾酒馆」里有一位人气颇高的调酒师。",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "UI_ChapterIcon_Diona",
            "id": "103901",
            "num": "邀约事件·迪奥娜 第一幕",
            "title": "猫与特调酒"
        },
        "total_dialogue_lines": 16,
        "total_speaker_counts": {
            "Player": 3,
            "宁禄": 13
        }
    },
    "talks": [
        {
            "id": "1910101",
            "objective": "与宁禄对话",
            "dialogues": [
                {
                    "id": "191010101",
                    "speaker": "宁禄",
                    "text": "真不错…这「猫尾酒馆」的酒真不错…"
                },
                {
                    "id": "191010102",
                    "speaker": "Player",
                    "text": "什么酒馆？"
                },
                {
                    "id": "191010103",
                    "speaker": "宁禄",
                    "text": "咦？呃…是旅行者啊，你…你不知道「猫尾酒馆」吗？"
                },
                {
                    "id": "191010104",
                    "speaker": "宁禄",
                    "text": "看你样子，肯定没怎么听说过，也没怎么光顾过…欸，你可是亏大了…"
                },
                {
                    "id": "191010105",
                    "speaker": "宁禄",
                    "text": "「猫尾酒馆」里面可是有不少奇妙特调，这些特调的味道你绝对从未尝试过。"
                },
                {
                    "id": "191010106",
                    "speaker": "宁禄",
                    "text": "而且，「猫尾酒馆」就和它的名字一样，里面还有很多，很多的可爱小猫。"
                },
                {
                    "id": "191010107",
                    "speaker": "宁禄",
                    "text": "在那么多可爱小猫的围绕下，喝着美味的特调酒…总是会让人不由自主地忘记时间…",
                    "choices": [
                        {
                            "id": "191010108",
                            "text": "现在「猫尾酒馆」在营业中吗？",
                            "response": [
                                {
                                    "id": "191010110",
                                    "speaker": "宁禄",
                                    "text": "呃…可你看上去，好像还没到可以喝酒的年纪…"
                                },
                                {
                                    "id": "191010111",
                                    "speaker": "宁禄",
                                    "text": "不过没关系，没关系！那位叫做迪奥娜的调酒师，可是蒙德城最棒的调酒师。"
                                },
                                {
                                    "id": "191010112",
                                    "speaker": "宁禄",
                                    "text": "给你调制一杯不含酒的饮品…对她来说应该也不在话下。"
                                },
                                {
                                    "id": "191010113",
                                    "speaker": "宁禄",
                                    "text": "而且，那位叫做迪奥娜的调酒师也很可爱，就像是只小猫一样…"
                                },
                                {
                                    "id": "191010114",
                                    "speaker": "宁禄",
                                    "text": "嗝…嗝！说出来了，不行不行，你、你可别告诉迪奥娜，我说过这个词啊…"
                                },
                                {
                                    "id": "191010115",
                                    "speaker": "宁禄",
                                    "text": "不啰嗦了，你要是想去「猫尾酒馆」的话，酒馆的门就在后面，你直接过去就行。"
                                },
                                {
                                    "id": "191010116",
                                    "speaker": "宁禄",
                                    "text": "我…呃！我去旁边醒醒酒，之前喝了太多，看来喝不动第五轮了…"
                                }
                            ]
                        },
                        {
                            "id": "191010109",
                            "text": "我也想去试试…"
                        }
                    ]
                }
            ]
        },
