    "talks": [
        {
            "id": "7223101",
            "objective": "test 对话用$HIDDEN",
            "dialogues": [
                {
                    "id": "722310101",
                    "speaker": "大岛纯平",
                    "text": "代宫司大人居然这么高兴，看来那个对它来说，真的是很重要的人啊。"
                },
                {
                    "id": "722310102",
                    "speaker": "Player",
                    "text": "但是，不知道她到底在哪…"
                }
            ]
        },
        {
            "id": "7223102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722310201",
                    "speaker": "悦子",
                    "text": "确实，「阿响」…「浅濑神社」和「百目鬼」，都很让人在意。",
                    "choices": [
                        {
                            "id": "722310202",
                            "text": "你们是什么时候冒出来的…",
                            "response": [
                                {
                                    "id": "722310203",
                                    "speaker": "悦子",
                                    "text": "岛上闹出那么大的动静，我们自然就过来了。"
                                },
                                {
                                    "id": "722310204",
                                    "speaker": "悦子",
                                    "text": "不过，有些事我觉得，必须要和你们说一下。"
                                },
                                {
                                    "id": "722310205",
                                    "speaker": "悦子",
                                    "text": "大祐，说明一下吧。"
                                },
                                {
                                    "id": "722310206",
                                    "speaker": "大祐",
                                    "text": "啊…好的，悦子小姐。是这样的，我要说的是一些…有关这座清籁岛的事情…"
                                },
                                {
                                    "id": "722310208",
                                    "speaker": "大祐",
                                    "text": "清籁岛的历史实在是太久远了，虽然协会已经特意搜罗过了资料，但还是几乎没找到什么有用的…"
                                },
                                {
                                    "id": "722310209",
                                    "speaker": "大祐",
                                    "text": "根据协会给的资料，几百年前，这里似乎曾经是一处「海贼」的聚集点，当时，是由幕府出面扫清了所有海贼，并且把岛上的居民都迁移到了别处…"
                                },
                                {
                                    "id": "722310210",
                                    "speaker": "大祐",
                                    "text": "那个「百目鬼」，如果不出意外的话，也许正是当时和幕府正面冲突过的海贼头目「赤穗百目鬼」，卷宗里明确记录着他的名字。"
                                },
                                {
                                    "id": "722310211",
                                    "speaker": "大祐",
                                    "text": "据协会给我们的那些资料里记载，这位「赤穗百目鬼」指挥着海贼的船队，和幕府在海上作战。"
                                },
                                {
                                    "id": "722310212",
                                    "speaker": "大祐",
                                    "text": "虽然他的船队很快被幕府压制了下去，被迫向清籁岛逃窜…"
                                },
                                {
                                    "id": "722310213",
                                    "speaker": "大祐",
                                    "text": "但是，幕府的船队在追击他的时候，清籁岛上突然爆发了一阵不知来由的雷暴。"
                                },
                                {
                                    "id": "722310214",
                                    "speaker": "大祐",
                                    "text": "赤穗百目鬼的船队和幕府的船队一起被雷暴击中…就这样全部失去了踪迹。"
                                },
                                {
                                    "id": "722310215",
                                    "speaker": "Player",
                                    "text": "雷暴…"
                                },
                                {
                                    "id": "722310216",
                                    "speaker": "悦子",
                                    "text": "接下来的我来说吧…这件事里最大的疑点，就是那场突然出现的雷暴。"
                                },
                                {
                                    "id": "722310217",
                                    "speaker": "悦子",
                                    "text": "虽然赤穗百目鬼的船队也被雷暴波及，几乎全灭…但幕府派来清籁岛的船队也几乎全军覆没，被迫退回鸣神岛，过了一段时间才重整好了船队。"
                                },
                                {
                                    "id": "722310218",
                                    "speaker": "悦子",
                                    "text": "那场雷暴实在来得太过恰到好处，简直就像是…有人特意操控的一样。"
                                },
                                {
                                    "id": "722310219",
                                    "speaker": "悦子",
                                    "text": "你还记得，这座岛上被特意解开封印的那些「镇石」吧。"
                                },
                                {
                                    "id": "722310220",
                                    "speaker": "悦子",
                                    "text": "还有，我们封印了这些「镇石」之后，岛上的雷暴也平息了。"
                                },
                                {
                                    "id": "722310221",
                                    "speaker": "悦子",
                                    "text": "我不想妄下推断，但是…我感觉这一切多多少少有些关联。"
                                },
                                {
                                    "id": "722310222",
                                    "speaker": "大祐",
                                    "text": "不然，我们去问问寝子大人…"
                                },
                                {
                                    "id": "722310223",
                                    "speaker": "悦子",
                                    "text": "…算了吧。资料记载那位百目鬼失踪了。说是失踪，但被那种雷暴击中，也许已经…"
                                },
                                {
                                    "id": "722310224",
                                    "speaker": "悦子",
                                    "text": "我们会继续在这座岛上探索，也继续搜集关于这件事的线索，等过段时间，我们就会回去向协会报告。"
                                },
                                {
                                    "id": "722310225",
                                    "speaker": "悦子",
                                    "text": "呵呵，旅行者，说不定到时候我们还会继续合作呢。"
                                },
                                {
                                    "id": "722310226",
                                    "speaker": "Player",
                                    "text": "到时候请多多关照。"
                                },
                                {
                                    "id": "722310227",
                                    "speaker": "悦子",
                                    "text": "彼此彼此。"
                                },
                                {
                                    "id": "722310228",
                                    "speaker": "悦子",
                                    "text": "大祐，准备一下，我们继续制订探索计划。"
                                },
                                {
                                    "id": "722310229",
                                    "speaker": "大祐",
                                    "text": "呃…悦子小姐，那寝子大人…"
                                },
                                {
                                    "id": "722310230",
                                    "speaker": "悦子",
                                    "text": "你之前怎么和那只猫相处，以后也怎么和那只猫相处。"
                                },
                                {
                                    "id": "722310231",
                                    "speaker": "悦子",
                                    "text": "但是记住，不要说任何不该说的话。"
                                },
                                {
                                    "id": "722310232",
                                    "speaker": "悦子",
                                    "text": "它…现在应该很开心，不要说任何煞风景的话。"
                                },
                                {
                                    "id": "722310233",
                                    "speaker": "大祐",
                                    "text": "我知道了！悦子小姐，嘿嘿，你果然还是很…"
                                },
                                {
                                    "id": "722310234",
                                    "speaker": "悦子",
                                    "text": "…只不过是为了更好地完成委托而已，快点去工作。"
                                },
                                {
                                    "id": "722310235",
                                    "speaker": "悦子",
                                    "text": "清籁岛…看来这座岛上，还有很多秘密…"
                                }
                            ]
                        },
                        {
                            "id": "722310207",
                            "text": "你们知道什么吗？"
                        }
                    ]
                }
            ]
        }
    ]
}