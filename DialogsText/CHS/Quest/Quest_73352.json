    "talks": [
        {
            "id": "7335201",
            "objective": "与麦斯欧德对话",
            "dialogues": [
                {
                    "id": "733520101",
                    "speaker": "麦斯欧德",
                    "text": "异乡的旅者和小朋友，你们好啊，花神诞祭玩得还开心吗？"
                },
                {
                    "id": "733520102",
                    "speaker": "麦斯欧德",
                    "text": "要是两位还有兴致，我「幻之玩具王」诚邀你们来玩玩新游戏——只在花神诞祭期间才开放的「花车摇曳」。"
                },
                {
                    "id": "733520103",
                    "speaker": "派蒙",
                    "text": "花车摇曳？"
                },
                {
                    "id": "733520104",
                    "speaker": "派蒙",
                    "text": "一听这个名字，我好像能想象出…纳西妲坐在花车里开心摇摆的画面！",
                    "choices": [
                        {
                            "id": "733520105",
                            "text": "听得我也有点开心了！",
                            "response": [
                                {
                                    "id": "733520107",
                                    "speaker": "麦斯欧德",
                                    "text": "好呀，「草神大人每天都快快乐乐」是我们这些须弥人的愿望！"
                                },
                                {
                                    "id": "733520108",
                                    "speaker": "麦斯欧德",
                                    "text": "你们的联想…是何等美妙的画面，值得画成一幅华丽的绘卷。"
                                },
                                {
                                    "id": "733520109",
                                    "speaker": "麦斯欧德",
                                    "text": "不过，这个游戏的氛围更加活泼，比起欣喜的庆祝，更像是一场历险——"
                                },
                                {
                                    "id": "733520110",
                                    "speaker": "麦斯欧德",
                                    "text": "「无论聪明与否，不管乖巧还是顽皮，每个拥有美好心灵的孩子，都在花神诞祭的庆祝上得到了一辆自己的花车…」"
                                },
                                {
                                    "id": "733520111",
                                    "speaker": "麦斯欧德",
                                    "text": "「乘着这辆花车，孩子们开启了自己独一无二的旅程，遭遇了惊险，也成功化险为夷，寻得了千朵鲜花的至宝…」",
                                    "choices": [
                                        {
                                            "id": "733520112",
                                            "text": "派蒙聪明又乖巧。",
                                            "response": [
                                                {
                                                    "id": "733520114",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，说得对！千朵鲜花的至宝，我们也能拿下。"
                                                },
                                                {
                                                    "id": "733520115",
                                                    "speaker": "麦斯欧德",
                                                    "text": "那就请两位尽情游玩，好好享受游戏了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733520113",
                                            "text": "我们都很擅长化险为夷。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733520106",
                            "text": "听得我想看纳西妲摇摆…"
                        }
                    ]
                }
            ]
        }
    ]
}