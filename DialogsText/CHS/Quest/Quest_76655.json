    "talks": [
        {
            "id": "7665501",
            "objective": "与菲林斯对话",
            "dialogues": [
                {
                    "id": "766550101",
                    "speaker": "派蒙",
                    "text": "菲林斯，你也上来了啊？"
                },
                {
                    "id": "766550102",
                    "speaker": "菲林斯",
                    "text": "两位辛苦了，有人维护之后，这座灯塔的状态好了很多。"
                },
                {
                    "id": "766550103",
                    "speaker": "派蒙",
                    "text": "嘿嘿，举手之劳。不过就算我们再怎么维护灯塔，这里还是那么黑，总有灯塔照不到的地方。"
                },
                {
                    "id": "766550104",
                    "speaker": "菲林斯",
                    "text": "是的，和外面不同，坟场里的时间仿佛永远停在了夜晚，停在了那场战斗结束的晚上。"
                },
                {
                    "id": "766550105",
                    "speaker": "菲林斯",
                    "text": "我原本无意改变这里的环境，是你们点亮了灯塔，推动了这里的时间。",
                    "choices": [
                        {
                            "id": "766550106",
                            "text": "会影响你的生活吗？",
                            "response": [
                                {
                                    "id": "766550107",
                                    "speaker": "菲林斯",
                                    "text": "如果你想问这样是否会给我带来不便，答案是否定的。"
                                },
                                {
                                    "id": "766550110",
                                    "speaker": "菲林斯",
                                    "text": "生命是轮回，即便没有我们，这座岛上的鬼魂们也会逐渐消散，回到地脉中去。"
                                },
                                {
                                    "id": "766550111",
                                    "speaker": "菲林斯",
                                    "text": "所以不用担心灯塔无法照亮整座岛，随着鬼魂逐渐消失，笼罩这里的雾气也会变淡。"
                                },
                                {
                                    "id": "766550112",
                                    "speaker": "菲林斯",
                                    "text": "太阳总要升起。"
                                }
                            ]
                        },
                        {
                            "id": "766550108",
                            "text": "这是意外，抱歉。",
                            "response": [
                                {
                                    "id": "766550109",
                                    "speaker": "菲林斯",
                                    "text": "请不要道歉，我并不厌恶这种改变。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}