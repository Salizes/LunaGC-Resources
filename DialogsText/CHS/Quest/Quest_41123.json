        {
            "id": "4112351",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411235101",
                    "speaker": "霍夫曼",
                    "text": "到现在为止，还没有陨石掉在城里，可以说是不幸中的万幸了。"
                }
            ]
        },
        {
            "id": "4112353",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411235301",
                    "speaker": "霍夫曼",
                    "text": "陨石、魔物和盗宝团…倒霉的事怎么都一起来…"
                }
            ]
        },
        {
            "id": "4112354",
