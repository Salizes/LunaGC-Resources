    "talks": [
        {
            "id": "4112310",
            "objective": "（隐藏）活动首环隐藏任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4112301",
            "objective": "与霍夫曼对话",
            "dialogues": [
                {
                    "id": "411230101",
                    "speaker": "霍夫曼",
                    "text": "您好，旅行者。这段时间请尽量待在城里，不要外出。"
                },
                {
                    "id": "411230102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "411230103",
                    "speaker": "霍夫曼",
                    "text": "外面那些砸落的陨石，您应该也看见了。"
                },
                {
                    "id": "411230104",
                    "speaker": "霍夫曼",
                    "text": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。"
                },
                {
                    "id": "411230105",
                    "speaker": "霍夫曼",
                    "text": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…"
                },
                {
                    "id": "411230106",
                    "speaker": "霍夫曼",
                    "text": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…"
                },
                {
                    "id": "411230107",
                    "speaker": "霍夫曼",
                    "text": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？"
                },
                {
                    "id": "411230108",
                    "speaker": "霍夫曼",
                    "text": "本来这应该是骑士团的职责，但我们实在抽不出人手来处理这件事，只能拜托你了。",
                    "choices": [
                        {
                            "id": "411230109",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "411230110",
                                    "speaker": "霍夫曼",
                                    "text": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。"
                                }
                            ]
                        },
                        {
                            "id": "411230111",
                            "text": "盗宝团不怕陨石吗？",
                            "response": [
                                {
                                    "id": "411230112",
                                    "speaker": "霍夫曼",
                                    "text": "哼，为了钱，那群家伙应该什么都不怕吧。"
                                },
                                {
                                    "id": "411230113",
                                    "speaker": "霍夫曼",
                                    "text": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112302",
            "objective": "打倒盗宝团",
            "dialogues": []
        },
        {
            "id": "4112303",
            "objective": "向霍夫曼回报结果",
            "dialogues": [
                {
                    "id": "411230301",
                    "speaker": "霍夫曼",
                    "text": "你把那些盗宝团都赶走了吗？"
                },
                {
                    "id": "411230302",
                    "speaker": "Player",
                    "text": "都赶走了。"
                },
                {
                    "id": "411230303",
                    "speaker": "霍夫曼",
                    "text": "太好了，实在是帮大忙了。"
                },
                {
                    "id": "411230304",
                    "speaker": "霍夫曼",
                    "text": "那群盗宝团吃了这个教训，应该不敢来趁火打劫了。"
                },
                {
                    "id": "411230305",
                    "speaker": "Player",
                    "text": "没事的话…"
                },
                {
                    "id": "411230306",
                    "speaker": "霍夫曼",
                    "text": "呃，请留步…还有一件事，想要再请你帮帮忙。"
                },
                {
                    "id": "411230307",
                    "speaker": "霍夫曼",
                    "text": "其实在陨石落下之后，骑士团就收到很多有关魔物异常的报告。"
                },
                {
                    "id": "411230308",
                    "speaker": "霍夫曼",
                    "text": "这些报告里面提到，魔物似乎也受到了陨石的影响，变得格外暴躁。"
                },
                {
                    "id": "411230309",
                    "speaker": "霍夫曼",
                    "text": "蒙德城的防卫还算全面，不需要担心，但是有一颗陨石正好落在了清泉镇旁边…"
                },
                {
                    "id": "411230310",
                    "speaker": "霍夫曼",
                    "text": "清泉镇里虽然有不少猎人，我们也派了骑士过去协助，但那里的地形实在难以做到完全防守好。"
                },
                {
                    "id": "411230311",
                    "speaker": "霍夫曼",
                    "text": "假如漏了魔物进镇子，那就糟糕了…"
                },
                {
                    "id": "411230312",
                    "speaker": "霍夫曼",
                    "text": "能请你去清泉镇周围调查一下魔物的情况吗？",
                    "choices": [
                        {
                            "id": "411230313",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "411230314",
                                    "speaker": "霍夫曼",
                                    "text": "那就拜托你了，我也会尽量快点再安排些骑士过去支援。"
                                }
                            ]
                        },
                        {
                            "id": "411230315",
                            "text": "清泉镇的情况怎么样？",
                            "response": [
                                {
                                    "id": "411230316",
                                    "speaker": "霍夫曼",
                                    "text": "老实说…不太乐观，除了要处理陨石相关的诸多事宜外，还要提防魔物和盗宝团…"
                                },
                                {
                                    "id": "411230317",
                                    "speaker": "霍夫曼",
                                    "text": "同时要应付这么多东西，实在是太吃力了…"
                                },
                                {
                                    "id": "411230318",
                                    "speaker": "霍夫曼",
                                    "text": "那这件事就拜托你了，我也会尽量快点再安排些骑士过去支援。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4112304",
            "objective": "前往清泉镇附近调查",
            "dialogues": [
                {
                    "id": "411230401",
                    "speaker": "胆小的莫罗",
                    "text": "呜哇！别，别过…"
                },
                {
                    "id": "411230402",
                    "speaker": "胆小的莫罗",
                    "text": "咦？不是魔物…你，你是谁？"
                },
                {
                    "id": "411230403",
                    "speaker": "Player",
                    "text": "关于魔物的情况…"
                },
                {
                    "id": "411230404",
                    "speaker": "胆小的莫罗",
                    "text": "魔物的情况…那还用问吗？我就是刚从魔物堆旁边跑过来的！"
                },
                {
                    "id": "411230405",
                    "speaker": "胆小的莫罗",
                    "text": "就在旁边，一群魔物已经在那扎堆了，一副要进攻镇子的样子。"
                },
                {
                    "id": "411230406",
                    "speaker": "胆小的莫罗",
                    "text": "要不是我跑得快，说不定你就看不到我了…"
                },
                {
                    "id": "411230407",
                    "speaker": "Player",
                    "text": "那群魔物在哪？"
                },
                {
                    "id": "411230408",
                    "speaker": "胆小的莫罗",
                    "text": "就在镇子旁边，很近，走几步就能看见了。"
                },
                {
                    "id": "411230409",
                    "speaker": "胆小的莫罗",
                    "text": "你也快点去避难吧，我在这再歇一会…再歇一会就回去把情况告诉镇子里的人。"
                }
            ]
        },
        {
            "id": "4112305",
            "objective": "打倒清泉镇附近的魔物",
            "dialogues": []
        },
        {
            "id": "4112306",
            "objective": "清理清泉镇附近的魔物营地",
            "dialogues": []
        },
        {
            "id": "4112307",
            "objective": "打倒所有魔物",
            "dialogues": []
        },
        {
            "id": "4112308",
            "objective": "向胆小的莫罗回报",
            "dialogues": [
                {
                    "id": "411230801",
                    "speaker": "胆小的莫罗",
                    "text": "咦？怎么又是你，你去做什么了？"
                },
                {
                    "id": "411230802",
                    "speaker": "Player",
                    "text": "我把魔物都打倒了。"
                },
                {
                    "id": "411230803",
                    "speaker": "胆小的莫罗",
                    "text": "打倒了…真的假的，就你一个人？"
                },
                {
                    "id": "411230804",
                    "speaker": "Player",
                    "text": "你可以自己去看看。"
                },
                {
                    "id": "411230805",
                    "speaker": "胆小的莫罗",
                    "text": "呃…我可不敢自己去看，要是被魔物发现了可就完蛋了…"
                },
                {
                    "id": "411230806",
                    "speaker": "胆小的莫罗",
                    "text": "算了，不管你说的是真是假，我都得回去报告一声。"
                },
                {
                    "id": "411230807",
                    "speaker": "胆小的莫罗",
                    "text": "要是你真把那些魔物都打倒了，镇子里的那些西风骑士总会有办法验证的。"
                }
            ]
        },
        {
            "id": "4112309",
            "objective": "向霍夫曼回报",
            "dialogues": [
                {
                    "id": "411230901",
                    "speaker": "霍夫曼",
                    "text": "情况怎么样？"
                },
                {
                    "id": "411230902",
                    "speaker": "Player",
                    "text": "清泉镇已经安全了。"
                },
                {
                    "id": "411230903",
                    "speaker": "霍夫曼",
                    "text": "那就太好了…我还在发愁抽调不出人手来呢。"
                },
                {
                    "id": "411230904",
                    "speaker": "霍夫曼",
                    "text": "十分感谢你，实在帮大忙了，这些谢礼请收下吧。"
                },
                {
                    "id": "411230905",
                    "speaker": "霍夫曼",
                    "text": "唉，又是陨石，又是魔物…千万别再出什么乱子了。"
                }
            ]
        },
