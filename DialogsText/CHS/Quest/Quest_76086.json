    "talks": [
        {
            "id": "7608601",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760860101",
                    "speaker": "「少女」",
                    "text": "夜空…月亮…"
                },
                {
                    "id": "760860102",
                    "speaker": "派蒙",
                    "text": "她似乎又想玩「月亮棋」了呢，我们去陪陪她吧！"
                },
                {
                    "id": "760860103",
                    "speaker": "「少女」",
                    "text": "咦？是你们？"
                },
                {
                    "id": "760860104",
                    "speaker": "Player",
                    "text": "要来下棋吗？"
                },
                {
                    "id": "760860105",
                    "speaker": "「少女」",
                    "text": "好啊。我来为你准备「夜空」。"
                }
            ]
        },
        {
            "id": "7608602",
            "objective": "同「少女」玩月亮棋",
            "dialogues": [
                {
                    "id": "760540301",
                    "speaker": "「少女」",
                    "text": "这样对吗…？"
                },
                {
                    "id": "760540302",
                    "speaker": "「少女」",
                    "text": "我想想…"
                },
                {
                    "id": "760540303",
                    "speaker": "「少女」",
                    "text": "唔…"
                },
                {
                    "id": "760540304",
                    "speaker": "「少女」",
                    "text": "月亮…月亮…"
                },
                {
                    "id": "760540305",
                    "speaker": "「少女」",
                    "text": "这里怎么样？"
                },
                {
                    "id": "760540306",
                    "speaker": "「少女」",
                    "text": "这次是我赢了。"
                },
                {
                    "id": "760540307",
                    "speaker": "「少女」",
                    "text": "我的三个月亮连起来了。"
                },
                {
                    "id": "760540308",
                    "speaker": "「少女」",
                    "text": "嗯，这样就赢了。"
                },
                {
                    "id": "760540309",
                    "speaker": "「少女」",
                    "text": "嗯…月升月落，真是漫长。"
                },
                {
                    "id": "760540310",
                    "speaker": "「少女」",
                    "text": "我们的月亮谁都不让谁呢。"
                },
                {
                    "id": "760540311",
                    "speaker": "「少女」",
                    "text": "是不是…快平手了？"
                },
                {
                    "id": "760540312",
                    "speaker": "「少女」",
                    "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。"
                },
                {
                    "id": "760540313",
                    "speaker": "「少女」",
                    "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？"
                },
                {
                    "id": "760540314",
                    "speaker": "「少女」",
                    "text": "不喜欢这个游戏吗？我觉得还挺有意思。"
                },
                {
                    "id": "760540315",
                    "speaker": "「少女」",
                    "text": "嗯？你是在盯着我看吗？我感觉得到。"
                },
                {
                    "id": "760540316",
                    "speaker": "「少女」",
                    "text": "我的脸上…有关于「月亮」的答案吗？"
                },
                {
                    "id": "760540317",
                    "speaker": "「少女」",
                    "text": "棋盘在那边哦。"
                },
                {
                    "id": "760540318",
                    "speaker": "「少女」",
                    "text": "嗯，是你的「月亮」获胜了。"
                },
                {
                    "id": "760540319",
                    "speaker": "「少女」",
                    "text": "这片夜空属于你了。"
                },
                {
                    "id": "760540320",
                    "speaker": "「少女」",
                    "text": "啊…一不小心就…"
                },
                {
                    "id": "760540321",
                    "speaker": "Black Screen",
                    "text": "与哥伦比娅在游戏中度过了一段愉快的时光…"
                },
                {
                    "id": "760540322",
                    "speaker": "「少女」",
                    "text": "谢谢你，我玩得很开心。"
                },
                {
                    "id": "760540323",
                    "speaker": "「少女」",
                    "text": "如果可以的话，下次也来陪我吧。"
                },
                {
                    "id": "760540324",
                    "speaker": "「少女」",
                    "text": "把这个，当做「约定」的证明。"
                }
            ]
        },
