    "talks": [
        {
            "id": "2001401",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "200140101",
                    "speaker": "安东尼",
                    "text": "安娜，你再好好想想，这件事我认为要从长计议才好…"
                },
                {
                    "id": "200140102",
                    "speaker": "安娜",
                    "text": "哎呀，你就别担心我了，我肯定没问题的！",
                    "choices": [
                        {
                            "id": "200140103",
                            "text": "安娜，你的身体还好吗？",
                            "response": [
                                {
                                    "id": "200140105",
                                    "speaker": "安东尼",
                                    "text": "旅行者！你来得正好，快帮我劝劝安娜吧，她要去做冒险家！"
                                },
                                {
                                    "id": "200140106",
                                    "speaker": "安娜",
                                    "text": "我为什么不能做冒险家？我现在身体很健康，塞琉斯叔叔也说我脑子很灵活，很适合做冒险家！"
                                },
                                {
                                    "id": "200140107",
                                    "speaker": "安东尼",
                                    "text": "你病才好了多久？如果你去做冒险家，又折腾出病来怎么办？而且，爸妈也不会同意…"
                                },
                                {
                                    "id": "200140108",
                                    "speaker": "安娜",
                                    "text": "我和爸爸妈妈已经说过了，他们说，只要我能通过冒险家协会的考试，他们就同意我做冒险家。"
                                },
                                {
                                    "id": "200140109",
                                    "speaker": "安东尼",
                                    "text": "啊…啊？！",
                                    "choices": [
                                        {
                                            "id": "200140110",
                                            "text": "冷静…",
                                            "response": [
                                                {
                                                    "id": "200140112",
                                                    "speaker": "安娜",
                                                    "text": "塞琉斯叔叔前几天刚帮我制订好了训练计划，我已经训练了好几天了。"
                                                },
                                                {
                                                    "id": "200140113",
                                                    "speaker": "安娜",
                                                    "text": "不过，那些计划上都是一些侦察啦，寻找应急食物啦，野外求生啦之类的…"
                                                },
                                                {
                                                    "id": "200140114",
                                                    "speaker": "安娜",
                                                    "text": "但我听说，冒险家也经常和野外的那些魔物搏斗。"
                                                },
                                                {
                                                    "id": "200140115",
                                                    "speaker": "安娜",
                                                    "text": "我很想学习这方面的事，但又找不到人教我…"
                                                },
                                                {
                                                    "id": "200140116",
                                                    "speaker": "安娜",
                                                    "text": "而且，我哥哥他也…"
                                                },
                                                {
                                                    "id": "200140117",
                                                    "speaker": "安东尼",
                                                    "text": "当然不行！那些魔物都很危险，就算要去，你也要找一个经验丰富的冒险家和你同行！"
                                                },
                                                {
                                                    "id": "200140118",
                                                    "speaker": "安娜",
                                                    "text": "我之前不是找过杰克吗？他都答应我啦。"
                                                },
                                                {
                                                    "id": "200140119",
                                                    "speaker": "安东尼",
                                                    "text": "杰克那家伙我又不是不认识…他在野外连自己都照顾不好，怎么可能照顾得了你。"
                                                },
                                                {
                                                    "id": "200140120",
                                                    "speaker": "安娜",
                                                    "text": "那协会里一时半会也找不到有经验的冒险家，我也没钱挂委托…",
                                                    "choices": [
                                                        {
                                                            "id": "200140121",
                                                            "text": "不如我陪你去吧。",
                                                            "response": [
                                                                {
                                                                    "id": "200140123",
                                                                    "speaker": "安娜",
                                                                    "text": "欸？你愿意帮我吗？太好了！"
                                                                },
                                                                {
                                                                    "id": "200140124",
                                                                    "speaker": "安娜",
                                                                    "text": "哥！这下你总可以放心了吧！"
                                                                },
                                                                {
                                                                    "id": "200140125",
                                                                    "speaker": "安东尼",
                                                                    "text": "这…"
                                                                },
                                                                {
                                                                    "id": "200140126",
                                                                    "speaker": "安东尼",
                                                                    "text": "#呼…好吧，旅行者的实力我是知道的，有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}陪着，我可以稍微放心点了…"
                                                                },
                                                                {
                                                                    "id": "200140127",
                                                                    "speaker": "安东尼",
                                                                    "text": "不过！你去野外的时候也要注意安全…"
                                                                },
                                                                {
                                                                    "id": "200140128",
                                                                    "speaker": "安东尼",
                                                                    "text": "…就是这些，你记住了没有？"
                                                                },
                                                                {
                                                                    "id": "200140129",
                                                                    "speaker": "安娜",
                                                                    "text": "记住了，记住了…哥，你说得我头都要晕了…"
                                                                },
                                                                {
                                                                    "id": "200140130",
                                                                    "speaker": "安娜",
                                                                    "text": "旅行者，我们快点出发吧，那个营地的位置我已经找杰克打听好了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "200140122",
                                                            "text": "我对战斗也算有些心得。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200140111",
                                            "text": "那你训练得怎么样了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200140104",
                            "text": "安东尼，你们在做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2001402",
            "objective": "打倒所有魔物",
            "dialogues": [
                {
                    "id": "200140201",
                    "speaker": "安娜",
                    "text": "魔物全都被打倒啦，你可真厉害。"
                },
                {
                    "id": "200140202",
                    "speaker": "安娜",
                    "text": "冒险手册上面写的果然没错，可以使用各种方式来打倒魔物…"
                },
                {
                    "id": "200140203",
                    "speaker": "安娜",
                    "text": "不过…说实话，离这些魔物这么近，我还是有些害怕…幸好有你陪着我。"
                },
                {
                    "id": "200140204",
                    "speaker": "Player",
                    "text": "你还得多多训练。"
                },
                {
                    "id": "200140205",
                    "speaker": "安娜",
                    "text": "嗯，我知道。要成为冒险家可不是一件容易的事。"
                },
                {
                    "id": "200140206",
                    "speaker": "安娜",
                    "text": "谢谢你旅行者，我先回去城里啦。出来这么长时间，我哥哥又要着急了。"
                },
                {
                    "id": "200140207",
                    "speaker": "安娜",
                    "text": "今后的训练，我得再努力一点才行。"
                }
            ]
        },
        {
            "id": "2001403",
