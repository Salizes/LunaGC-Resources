    "talks": [
        {
            "id": "7550701",
            "objective": "回到纳塔的营地与赫卡对话",
            "dialogues": [
                {
                    "id": "755070101",
                    "speaker": "赫卡",
                    "text": "#{NICKNAME}，派蒙，谢谢你们，没有你们的帮助，我一定无法完成这项任务。"
                },
                {
                    "id": "755070102",
                    "speaker": "Player",
                    "text": "现在可以邀请我加入「组织」了吗？"
                },
                {
                    "id": "755070103",
                    "speaker": "派蒙",
                    "text": "你还真想加入啊！"
                },
                {
                    "id": "755070104",
                    "speaker": "赫卡",
                    "text": "嗯…年龄方面可能有点微妙，不过不管怎么说，也得看看其他人的意见，大家投票通过的话，也不是没有先例。"
                },
                {
                    "id": "755070105",
                    "speaker": "赫卡",
                    "text": "如果之后你去到挪德卡莱，就去那夏镇的「斯佩兰扎」吧，卡嘉虽然不是我们的一员，但她是信得过的人，她会帮你的。"
                },
                {
                    "id": "755070106",
                    "speaker": "派蒙",
                    "text": "#好哦。说起来，在{NICKNAME}战斗的时候，看你又是留影又是在笔记本上涂涂画画，好专业的样子！",
                    "choices": [
                        {
                            "id": "755070107",
                            "text": "该不会是想偷学我的战斗技巧…",
                            "response": [
                                {
                                    "id": "755070109",
                                    "speaker": "赫卡",
                                    "text": "唔…告诉你们也没关系吧。我的任务是收集一百种怪物的情报，托你们的福，纳塔和枫丹的部分已经完成啦。"
                                },
                                {
                                    "id": "755070110",
                                    "speaker": "赫卡",
                                    "text": "之后该去须弥了，到时委托镀金旅团好了。不过在那之前还得把已经做好的图鉴寄回那夏镇…"
                                },
                                {
                                    "id": "755070111",
                                    "speaker": "派蒙",
                                    "text": "哇，原来你是在做怪物图鉴吗？"
                                },
                                {
                                    "id": "755070112",
                                    "speaker": "赫卡",
                                    "text": "嗯。挪德卡莱已经没什么我不知道的怪物了，所以才决定去其他地方看看。"
                                },
                                {
                                    "id": "755070113",
                                    "speaker": "赫卡",
                                    "text": "玫熙虽然胆子小，但却很喜欢听这些怪物的故事呢。从前每次我把新做好的图鉴交给她的时候，她都高兴得两眼放光。"
                                },
                                {
                                    "id": "755070114",
                                    "speaker": "赫卡",
                                    "text": "可惜她身体不好不能远行，不然就带她一起来了。而且卡嘉说过，如果我的图鉴做得足够好，说不定还有出版的机会。"
                                },
                                {
                                    "id": "755070115",
                                    "speaker": "赫卡",
                                    "text": "要是能带着出版的图鉴回去，偷偷藏在她的枕头下边，等她醒了给她一个惊喜…咳，一不小心说太远了。"
                                },
                                {
                                    "id": "755070116",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，赫卡真的很关心朋友呢。"
                                },
                                {
                                    "id": "755070117",
                                    "speaker": "赫卡",
                                    "text": "朋友…更像是家人吧，虽然没有血缘关系。哎呀，还是不要说这些了。"
                                },
                                {
                                    "id": "755070118",
                                    "speaker": "赫卡",
                                    "text": "对了，这次的图鉴也送给你们一份副本好了，画片要留备份，还得寄给玫熙，所以你们的那份就…",
                                    "choices": [
                                        {
                                            "id": "755070119",
                                            "text": "我也对留影略知一二。",
                                            "response": [
                                                {
                                                    "id": "755070121",
                                                    "speaker": "赫卡",
                                                    "text": "那就好。我也差不多该去下一个目的地了，可能过几天就动身。"
                                                },
                                                {
                                                    "id": "755070122",
                                                    "speaker": "派蒙",
                                                    "text": "路上要小心哦。"
                                                },
                                                {
                                                    "id": "755070123",
                                                    "speaker": "赫卡",
                                                    "text": "你们也是，祝你们旅途一切顺利！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755070120",
                                            "text": "想见它们了随时能见，没关系。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755070108",
                            "text": "难道是画家写生或者映影导演拍摄…"
                        }
                    ]
                }
            ]
        }
    ]
}