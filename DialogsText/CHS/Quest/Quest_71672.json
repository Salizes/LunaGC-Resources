    "talks": [
        {
            "id": "7167201",
            "objective": "与报菲对话",
            "dialogues": [
                {
                    "id": "716720101",
                    "speaker": "报菲",
                    "text": "…嘿嘿，昨天又听了一段和「白马仙人」有关的书，这下又有新灵感了。",
                    "choices": [
                        {
                            "id": "716720102",
                            "text": "什么灵感？",
                            "response": [
                                {
                                    "id": "716720104",
                                    "speaker": "报菲",
                                    "text": "欸…啊！你好你好你好，欢…欢迎来璃月港！海灯节欢迎你…不对不对，璃月港欢迎你…"
                                },
                                {
                                    "id": "716720105",
                                    "speaker": "报菲",
                                    "text": "萍溪姐没看见吧，好，应该没看见…"
                                },
                                {
                                    "id": "716720106",
                                    "speaker": "报菲",
                                    "text": "欢迎来到璃月港！您一定是来参加海灯节的，对吧？那么，您一定不能错过我设计的小游艺「月映仙踪」…"
                                },
                                {
                                    "id": "716720107",
                                    "speaker": "Player",
                                    "text": "你这是进入工作状态了啊…"
                                },
                                {
                                    "id": "716720108",
                                    "speaker": "报菲",
                                    "text": "别、别拆穿啊！要是被萍溪姐发现我走神，我肯定又要挨训了！"
                                },
                                {
                                    "id": "716720109",
                                    "speaker": "报菲",
                                    "text": "我可是磨了好久的嘴皮子才让她同意我过来摆摊的，你先听我说完…"
                                },
                                {
                                    "id": "716720110",
                                    "speaker": "报菲",
                                    "text": "咳、咳咳，「月映仙踪」是取材自流传在我们璃月港的「白马仙人」传说。"
                                },
                                {
                                    "id": "716720111",
                                    "speaker": "报菲",
                                    "text": "据传说呢，这位仙人常常在天上循着月光游弋，为璃月港驱除邪魔妖祟…"
                                },
                                {
                                    "id": "716720112",
                                    "speaker": "报菲",
                                    "text": "…哎呀，但这种传说我都觉得太无聊了，所以…嘿嘿，特意在这个小游戏里加入了一些听来的故事。"
                                },
                                {
                                    "id": "716720113",
                                    "speaker": "报菲",
                                    "text": "比如…其实天上一直有怪物，想要吞吃掉整个月亮！多亏了白马仙人，那些怪物才没能得逞…"
                                },
                                {
                                    "id": "716720114",
                                    "speaker": "报菲",
                                    "text": "虽然我不知道月亮被吞吃掉的时候具体是什么样…但刘苏说，就和我们啃烧饼一样，怪物吭哧吭哧地把月亮慢慢吞进肚子里。"
                                },
                                {
                                    "id": "716720115",
                                    "speaker": "报菲",
                                    "text": "但我过几天去听，刘苏他又换了一种说法，说什么怪物就和吃汤圆一样，啊呜一口，就把月亮整个吞下去了。"
                                },
                                {
                                    "id": "716720116",
                                    "speaker": "报菲",
                                    "text": "不过，在故事的最后，白马仙人总是会借助着霄灯的光芒，把所有魔物都一口气驱散掉。"
                                },
                                {
                                    "id": "716720117",
                                    "speaker": "主角",
                                    "text": "这也是传说？"
                                },
                                {
                                    "id": "716720118",
                                    "speaker": "报菲",
                                    "text": "反正刘苏说的那段书是这么说的，我觉得很帅气，就把这段故事也加入「月映仙踪」里啦。"
                                },
                                {
                                    "id": "716720119",
                                    "speaker": "报菲",
                                    "text": "呃，不好不好，我不能闲聊了，还是要办正事…"
                                },
                                {
                                    "id": "716720120",
                                    "speaker": "报菲",
                                    "text": "你想要试玩「月映仙踪」的话，就和我说一声，所有东西都准备齐全了，随时可以开始。"
                                }
                            ]
                        },
                        {
                            "id": "716720103",
                            "text": "你是准备说书么？"
                        }
                    ]
                }
            ]
        }
    ]
}