    "talks": [
        {
            "id": "1401701",
            "objective": "前往白淞镇",
            "dialogues": [
                {
                    "id": "140170101",
                    "speaker": "娜维娅",
                    "text": "阿黛尔，我们回来了，给你从枫丹廷带了礼物。"
                },
                {
                    "id": "140170102",
                    "speaker": "阿黛尔",
                    "text": "呜哇，谢谢老板！"
                },
                {
                    "id": "140170103",
                    "speaker": "科拉莉",
                    "text": "不要这么叫，你应该叫娜维娅姐姐，知道吗？"
                },
                {
                    "id": "140170104",
                    "speaker": "娜维娅",
                    "text": "哈哈哈，没关系啦。不只是有礼物，你们看是谁来了？"
                },
                {
                    "id": "140170105",
                    "speaker": "派蒙",
                    "text": "好久不见啊。"
                },
                {
                    "id": "140170106",
                    "speaker": "Player",
                    "text": "你们好。"
                },
                {
                    "id": "140170107",
                    "speaker": "科拉莉",
                    "text": "是你们啊，好久不见，之前的事情，非常谢谢你们的帮助。"
                },
                {
                    "id": "140170108",
                    "speaker": "科拉莉",
                    "text": "听说你们还拯救了整个枫丹，真是了不起的大英雄。"
                },
                {
                    "id": "140170109",
                    "speaker": "阿黛尔",
                    "text": "你们很厉害，能和厉害的人做朋友的娜维娅姐姐，也很厉害！"
                },
                {
                    "id": "140170110",
                    "speaker": "阿黛尔",
                    "text": "这个里面是什么啊，我能看看吗？"
                },
                {
                    "id": "140170111",
                    "speaker": "娜维娅",
                    "text": "当然可以。"
                },
                {
                    "id": "140170112",
                    "speaker": "阿黛尔",
                    "text": "哦，是…是刺玫会的制服！是送给我的吗？但是…好大啊，我穿不了。"
                },
                {
                    "id": "140170113",
                    "speaker": "娜维娅",
                    "text": "是送给未来的你的制服。之前你说想要加入刺玫会，能听到你这么说，我心里非常开心。"
                },
                {
                    "id": "140170114",
                    "speaker": "娜维娅",
                    "text": "但刺玫会需要保护大家的安全，所以会遭遇各种各样的危险，现在你还很小，我们不想让你的母亲担心。"
                },
                {
                    "id": "140170115",
                    "speaker": "娜维娅",
                    "text": "所以那时候拒绝了你，说需要你再长大一点。这件衣服，就是我们的约定啦。"
                },
                {
                    "id": "140170116",
                    "speaker": "阿黛尔",
                    "text": "原来是这样，好的，谢谢娜维娅姐姐！我会努力长大的！"
                },
                {
                    "id": "140170117",
                    "speaker": "科尔特",
                    "text": "呵呵，长大不是努力来的哦，要保持耐心。"
                },
                {
                    "id": "140170118",
                    "speaker": "科拉莉",
                    "text": "你们能把我女儿的事情放在心上，我非常感激。"
                },
                {
                    "id": "140170119",
                    "speaker": "科拉莉",
                    "text": "有刺玫会的照顾，就算她的父亲已经不在我们的身边，我们依然能感受到温暖与安全感。"
                },
                {
                    "id": "140170120",
                    "speaker": "娜维娅",
                    "text": "不用这么客气，不管是不是刺玫会的成员，只要住在白淞镇，我们就是一家人。"
                },
                {
                    "id": "140170121",
                    "speaker": "弗洛朗",
                    "text": "老、老板！"
                },
                {
                    "id": "140170122",
                    "speaker": "娜维娅",
                    "text": "欸，弗洛朗，怎么了？"
                },
                {
                    "id": "140170123",
                    "speaker": "弗洛朗",
                    "text": "大事不好了！罗默夫那帮人聚集在了白淞镇外面，还运了一堆炸药过来！"
                },
                {
                    "id": "140170124",
                    "speaker": "娜维娅",
                    "text": "啊？炸药？他们想干什么？"
                },
                {
                    "id": "140170125",
                    "speaker": "弗洛朗",
                    "text": "应该是蓄谋已久的行动，在昨天收到了你寄来的信之后，我就和刺玫会成员一同去调查。"
                },
                {
                    "id": "140170126",
                    "speaker": "弗洛朗",
                    "text": "但罗默夫他们好像也听到了风声，所有人都从之前的据点撤离了。"
                },
                {
                    "id": "140170127",
                    "speaker": "弗洛朗",
                    "text": "我们追查他们的踪迹，没想到目的地竟然就是白淞镇！"
                },
                {
                    "id": "140170128",
                    "speaker": "派蒙",
                    "text": "该不会是因为昨天在城里的冲突，让他们警觉起来了吧？"
                },
                {
                    "id": "140170129",
                    "speaker": "科尔特",
                    "text": "看来他们连一点想要坐下来谈的想法都没有啊，早知道就该把他们全部扔给执律庭。"
                },
                {
                    "id": "140170130",
                    "speaker": "娜维娅",
                    "text": "抱歉，是我太天真了。现在说这些也没用，弗洛朗，他们的炸药放在什么地方？"
                },
                {
                    "id": "140170131",
                    "speaker": "弗洛朗",
                    "text": "在白淞镇东边的山坡上，克莱门汀线的附近…"
                },
                {
                    "id": "140170132",
                    "speaker": "Player",
                    "text": "难道说…"
                },
                {
                    "id": "140170133",
                    "speaker": "娜维娅",
                    "text": "难道说，他们想炸掉克莱门汀线？！"
                },
                {
                    "id": "140170134",
                    "speaker": "科尔特",
                    "text": "很有可能…"
                },
                {
                    "id": "140170135",
                    "speaker": "娜维娅",
                    "text": "罗默夫他们憎恨刺玫会和卡雷斯，而双方关系产生裂痕的原因就是巡轨船。"
                },
                {
                    "id": "140170136",
                    "speaker": "娜维娅",
                    "text": "如果炸掉克莱门汀线，无数碎石就会顺着山坡滚下来，砸进白淞镇。"
                },
                {
                    "id": "140170137",
                    "speaker": "派蒙",
                    "text": "他们是疯了吗？这里还有很多无辜的人啊！"
                },
                {
                    "id": "140170138",
                    "speaker": "Player",
                    "text": "必须阻止他们。"
                },
                {
                    "id": "140170139",
                    "speaker": "娜维娅",
                    "text": "嗯，如果是酝酿已久的报复，他们绝对不会放过眼前的机会。"
                },
                {
                    "id": "140170140",
                    "speaker": "娜维娅",
                    "text": "现在必须尽快让白淞镇的人去避难，远离入口，不要被滚落的巨石砸到。"
                },
                {
                    "id": "140170141",
                    "speaker": "弗洛朗",
                    "text": "把所有人集中到大船上去吧，那里最安全。"
                },
                {
                    "id": "140170142",
                    "speaker": "娜维娅",
                    "text": "搭档，克莱门汀线那边能交给你吗？"
                },
                {
                    "id": "140170143",
                    "speaker": "娜维娅",
                    "text": "如果炸药爆炸，不只是白淞镇的人会遇到危险，正行驶在上面的巡轨船也会掉下来。"
                },
                {
                    "id": "140170144",
                    "speaker": "娜维娅",
                    "text": "先阻止他们的疯狂行为，再和他们算总账！"
                },
                {
                    "id": "140170145",
                    "speaker": "Player",
                    "text": "好。"
                },
                {
                    "id": "140170146",
                    "speaker": "派蒙",
                    "text": "交给我们吧，娜维娅你们也要小心啊！"
                }
            ]
        },
        {
            "id": "1401713",
            "objective": "前往白淞镇",
            "dialogues": [
                {
                    "id": "140170147",
                    "speaker": "娜维娅",
                    "text": "走吧，弗洛朗，科尔特，我们也赶紧行动起来。科拉莉女士，赶快带阿黛尔去我们的大船…"
                },
                {
                    "id": "140170148",
                    "speaker": "弗洛朗",
                    "text": "小心，老板！"
                },
                {
                    "id": "140170149",
                    "speaker": "科尔特",
                    "text": "…！"
                },
                {
                    "id": "140170150",
                    "speaker": "弗洛朗",
                    "text": "你要干什么，科尔特！"
                },
                {
                    "id": "140170151",
                    "speaker": "科尔特",
                    "text": "嘁，我还说碍事的家伙终于走了，结果还有你。"
                },
                {
                    "id": "140170152",
                    "speaker": "娜维娅",
                    "text": "难道说是调虎离山？科尔特，你也是罗默夫的人？"
                },
                {
                    "id": "140170153",
                    "speaker": "娜维娅",
                    "text": "原来如此，你早就知道他们在做准备，才说他们的近况不好，让我们放松警惕…"
                },
                {
                    "id": "140170154",
                    "speaker": "科尔特",
                    "text": "这不全对，或许我和他的立场相似，但我并不赞成他那种激进的做法。"
                },
                {
                    "id": "140170155",
                    "speaker": "科尔特",
                    "text": "因为我恨的只有你，只有你一个，娜维娅！"
                },
                {
                    "id": "140170156",
                    "speaker": "弗洛朗",
                    "text": "到我身边来，小心。"
                },
                {
                    "id": "140170157",
                    "speaker": "科尔特",
                    "text": "罗默夫答应我，如果我能杀了你，他就不会对白淞镇动手。"
                },
                {
                    "id": "140170158",
                    "speaker": "科尔特",
                    "text": "可是从头到尾，你都和那个碍事的家伙待在一起，我没有下手的机会。"
                },
                {
                    "id": "140170159",
                    "speaker": "科尔特",
                    "text": "罗默夫失去耐心了，我本来没必要出现在这里，但就算是和你们一起埋在这鬼地方，我也要亲手杀了你。"
                },
                {
                    "id": "140170160",
                    "speaker": "娜维娅",
                    "text": "为什么？"
                },
                {
                    "id": "140170161",
                    "speaker": "科尔特",
                    "text": "因为你一无所知，你才会问出这么愚蠢的问题。"
                },
                {
                    "id": "140170162",
                    "speaker": "科尔特",
                    "text": "你没有见过刺玫会当年有多辉煌，没有经历过白淞镇最繁荣的时期，而我不一样…"
                },
                {
                    "id": "140170163",
                    "speaker": "科尔特",
                    "text": "我亲眼见证过！再一点一点地看它们全部消失！"
                },
                {
                    "id": "140170164",
                    "speaker": "科尔特",
                    "text": "都是因为你的出现，娜维娅。"
                },
                {
                    "id": "140170165",
                    "speaker": "科尔特",
                    "text": "克莱门汀因为你死了，卡雷斯也因为你死了，迈勒斯和西尔弗因为你死了，还有那么多人，都因为你死了！"
                },
                {
                    "id": "140170166",
                    "speaker": "弗洛朗",
                    "text": "第一次见面那副无知的样子，也是在骗我们。"
                },
                {
                    "id": "140170167",
                    "speaker": "科尔特",
                    "text": "对啊，我刚出来的时候就知道迈勒斯死了。"
                },
                {
                    "id": "140170168",
                    "speaker": "科尔特",
                    "text": "你们知道吗？在那个该死的水下，我很认真地在考虑，等我出来以后，就去和迈勒斯道歉。"
                },
                {
                    "id": "140170169",
                    "speaker": "科尔特",
                    "text": "当年因为巡轨船，我和他大吵了一架，我认为他脑子里只有忠心，没有思考能力。"
                },
                {
                    "id": "140170170",
                    "speaker": "科尔特",
                    "text": "转眼就过去了那么多年，我本来以为我差点就能理解他了，以为他能让我回忆起刺玫会美好的那段时光…"
                },
                {
                    "id": "140170171",
                    "speaker": "科尔特",
                    "text": "结果他死了！因为你，又是你，娜维娅！"
                },
                {
                    "id": "140170172",
                    "speaker": "娜维娅",
                    "text": "……"
                },
                {
                    "id": "140170173",
                    "speaker": "科尔特",
                    "text": "我曾经比谁都要爱刺玫会和白淞镇，但现在我的眼中只有凄凉，美好的一切被你毁得一干二净。"
                },
                {
                    "id": "140170174",
                    "speaker": "弗洛朗",
                    "text": "老板，别听他的，尽是胡言乱语。"
                },
                {
                    "id": "140170175",
                    "speaker": "科尔特",
                    "text": "你有没有想过，其实你身边的人都没有那么喜欢你。"
                },
                {
                    "id": "140170176",
                    "speaker": "科尔特",
                    "text": "你有没有想过，你受到尊重只因为你是卡雷斯和克莱门汀的孩子，你根本什么都不是。"
                },
                {
                    "id": "140170177",
                    "speaker": "科尔特",
                    "text": "你有没有想过，这里的人还留在白淞镇，不是因为你，只是因为舍不得曾经的回忆！"
                },
                {
                    "id": "140170178",
                    "speaker": "娜维娅",
                    "text": "（因为当错误的惩罚降临时，那些人真的会不顾一切地为你挺身而出，为你付出代价…）"
                },
                {
                    "id": "140170179",
                    "speaker": "娜维娅",
                    "text": "（是啊，现在想想，他们真的都是一群很温柔的人。）"
                },
                {
                    "id": "140170180",
                    "speaker": "娜维娅",
                    "text": "（真的吗？真的是因为…温柔吗？）"
                },
                {
                    "id": "140170181",
                    "speaker": "阿黛尔",
                    "text": "你胡说！我就很喜欢娜维娅姐姐！我妈妈也喜欢！"
                },
                {
                    "id": "140170182",
                    "speaker": "娜维娅",
                    "text": "！！！"
                },
                {
                    "id": "140170183",
                    "speaker": "阿黛尔",
                    "text": "道理，我不会讲，但喜欢就是喜欢！"
                },
                {
                    "id": "140170184",
                    "speaker": "弗洛朗",
                    "text": "迈勒斯先生一定会对你非常失望。"
                },
                {
                    "id": "140170185",
                    "speaker": "弗洛朗",
                    "text": "你居然把刺玫会历史上的诸多不幸，都归结在老板个人的身上。"
                },
                {
                    "id": "140170186",
                    "speaker": "科尔特",
                    "text": "让开，弗洛朗，我不想对你动手。"
                },
                {
                    "id": "140170187",
                    "speaker": "弗洛朗",
                    "text": "那还是动手吧。"
                },
                {
                    "id": "140170188",
                    "speaker": "弗洛朗",
                    "text": "老板，危难在前，没有时间犹豫了。"
                },
                {
                    "id": "140170189",
                    "speaker": "娜维娅",
                    "text": "或许在你眼中，你说的这些就是「现实」。"
                },
                {
                    "id": "140170190",
                    "speaker": "娜维娅",
                    "text": "但我所接受过的来自每个人的爱，也都是真实的，这些爱都切实地帮助了我。"
                },
                {
                    "id": "140170191",
                    "speaker": "娜维娅",
                    "text": "即便是现在，我也会相信这个事实，让你知道刺玫会在我心中的分量！"
                }
            ]
        },
        {
            "id": "1401702",
            "objective": "击败科尔特等人",
            "dialogues": []
        },
        {
            "id": "1401703",
            "objective": "与弗洛朗交谈",
            "dialogues": [
                {
                    "id": "140170301",
                    "speaker": "娜维娅",
                    "text": "弗洛朗，这边交给你，赶紧召集其他刺玫会的成员，转移镇上的居民。"
                },
                {
                    "id": "140170302",
                    "speaker": "娜维娅",
                    "text": "如果还有偷偷混进来的科尔特的同伴，迅速制服，不要给他们伤害普通人的机会。"
                },
                {
                    "id": "140170303",
                    "speaker": "娜维娅",
                    "text": "我不能扔下我的搭档一个人面对危险。"
                },
                {
                    "id": "140170304",
                    "speaker": "弗洛朗",
                    "text": "好的，老板，我马上去做。"
                },
                {
                    "id": "140170305",
                    "speaker": "弗洛朗",
                    "text": "…娜维娅，你没问题吧？"
                },
                {
                    "id": "140170306",
                    "speaker": "娜维娅",
                    "text": "我不知道，但我必须要去。"
                },
                {
                    "id": "140170307",
                    "speaker": "Black Screen",
                    "text": "稍早之前，你和派蒙急匆匆地来到白淞镇的出口。"
                }
            ]
        },
        {
            "id": "1401704",
            "objective": "和派蒙商议对策",
            "dialogues": [
                {
                    "id": "140170401",
                    "speaker": "派蒙",
                    "text": "必须要保护克莱门汀线，我们赶紧上去吧。"
                },
                {
                    "id": "140170402",
                    "speaker": "派蒙",
                    "text": "他们想要炸掉水道的话，炸药应该在支撑柱的附近！"
                }
            ]
        },
        {
            "id": "1401705",
            "objective": "迅速前往水道的下方",
            "dialogues": []
        },
        {
            "id": "1401711",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "140171101",
                    "speaker": "派蒙",
                    "text": "这个就是炸药吧，然后这里是控制台，怎么才能让它停下来？"
                },
                {
                    "id": "140171102",
                    "speaker": "派蒙",
                    "text": "这上面的按钮，似乎都不应该随便碰。"
                },
                {
                    "id": "140171103",
                    "speaker": "Player",
                    "text": "这里…"
                },
                {
                    "id": "140171104",
                    "speaker": "派蒙",
                    "text": "有个形状奇怪的洞，唔，为什么会有这个东西？",
                    "choices": [
                        {
                            "id": "140171105",
                            "text": "说不定是钥匙孔。",
                            "response": [
                                {
                                    "id": "140171107",
                                    "speaker": "派蒙",
                                    "text": "有可能，那钥匙应该就在我们刚刚打倒的人身上吧？"
                                },
                                {
                                    "id": "140171108",
                                    "speaker": "派蒙",
                                    "text": "既然这样，我们分头行动，到处找找！"
                                }
                            ]
                        },
                        {
                            "id": "140171106",
                            "text": "说不定是紧急停止开关。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401712",
            "objective": "寻找钥匙",
            "dialogues": []
        },
        {
            "id": "1401706",
            "objective": "停止即将起爆的炸药",
            "dialogues": []
        },
        {
            "id": "1401707",
            "objective": "与派蒙交谈",
            "dialogues": [
                {
                    "id": "140170701",
                    "speaker": "派蒙",
                    "text": "这样应该就行了吧。"
                },
                {
                    "id": "140170702",
                    "speaker": "派蒙",
                    "text": "呼，这下娜维娅他们也能松口气了。"
                },
                {
                    "id": "140170703",
                    "speaker": "Player",
                    "text": "最好再去周围看看。"
                },
                {
                    "id": "140170704",
                    "speaker": "派蒙",
                    "text": "对哦，万一还有其他炸药呢…我们快走吧！"
                }
            ]
        },
        {
            "id": "1401714",
            "objective": "(test)(hide)解除炸弹表现逻辑$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1401708",
            "objective": "与埃斯蒙德交谈",
            "dialogues": [
                {
                    "id": "140170801",
                    "speaker": "Black Screen",
                    "text": "一段时间后，接到通知的执律庭成员抵达，将罗默夫一伙人悉数抓获。"
                },
                {
                    "id": "140170802",
                    "speaker": "埃斯蒙德",
                    "text": "听蒂埃里说，你们是仇人，但他们总归还是在刺玫会待过一段时间，你打算出面解决吗？"
                },
                {
                    "id": "140170803",
                    "speaker": "娜维娅",
                    "text": "我没有什么想和他们说的。"
                },
                {
                    "id": "140170804",
                    "speaker": "娜维娅",
                    "text": "仇恨也好，愤怒也罢，把普通人的安危置之不顾，我不认为这种人还有正常沟通的理智。"
                },
                {
                    "id": "140170805",
                    "speaker": "娜维娅",
                    "text": "请依照律法对他们进行处置吧，刺玫会方面没有任何意见。"
                },
                {
                    "id": "140170806",
                    "speaker": "埃斯蒙德",
                    "text": "好的，感谢你们能出手相助，没有引发更大的灾难。"
                },
                {
                    "id": "140170807",
                    "speaker": "埃斯蒙德",
                    "text": "该收队了，把这帮人都带走！"
                },
                {
                    "id": "140170808",
                    "speaker": "派蒙",
                    "text": "太好了，娜维娅，我们成功了！你好厉害啊！"
                },
                {
                    "id": "140170809",
                    "speaker": "娜维娅",
                    "text": "嗯，幸好赶上了…",
                    "choices": [
                        {
                            "id": "140170810",
                            "text": "感觉你精神不好？",
                            "response": [
                                {
                                    "id": "140170812",
                                    "speaker": "娜维娅",
                                    "text": "可能是使用了太多元素力吧，呵呵，没关系的，不用在意我。"
                                },
                                {
                                    "id": "140170813",
                                    "speaker": "派蒙",
                                    "text": "平时这么夸奖你的时候，你总会吹嘘几句。这样的你我还有点不习惯呢。"
                                },
                                {
                                    "id": "140170814",
                                    "speaker": "弗洛朗",
                                    "text": "老板，白淞镇里潜伏的家伙也全都抓住了。他们也会被执律庭的人送回去。"
                                },
                                {
                                    "id": "140170815",
                                    "speaker": "弗洛朗",
                                    "text": "这次罗默夫他们可谓是倾巢出动，也因此被一网打尽，之后应该也不需要担心了。"
                                },
                                {
                                    "id": "140170816",
                                    "speaker": "娜维娅",
                                    "text": "我知道了，是个好结果。"
                                },
                                {
                                    "id": "140170817",
                                    "speaker": "科尔特",
                                    "text": "……"
                                },
                                {
                                    "id": "140170818",
                                    "speaker": "娜维娅",
                                    "text": "科尔特。"
                                },
                                {
                                    "id": "140170819",
                                    "speaker": "娜维娅",
                                    "text": "我并非不能理解你的想法，失去的东西正因为无法挽回，才会显得更加珍贵。"
                                },
                                {
                                    "id": "140170820",
                                    "speaker": "娜维娅",
                                    "text": "我不是卡雷斯，也永远不会成为卡雷斯，你爱的刺玫会和白淞镇，再也不会回来了。"
                                },
                                {
                                    "id": "140170821",
                                    "speaker": "娜维娅",
                                    "text": "但我的想法没有改变，这是个重新开始的契机。"
                                },
                                {
                                    "id": "140170822",
                                    "speaker": "娜维娅",
                                    "text": "以后刺玫会赚到的钱会更多地投入到白淞镇的建设，我也会想办法改造巡轨船的线路…"
                                },
                                {
                                    "id": "140170823",
                                    "speaker": "娜维娅",
                                    "text": "将来的某一天，巡轨船也能为白淞镇的每一个人提供便利。"
                                },
                                {
                                    "id": "140170824",
                                    "speaker": "科尔特",
                                    "text": "我明白你的意思，如果是卡雷斯先生，他一定不会说出这种话。"
                                },
                                {
                                    "id": "140170825",
                                    "speaker": "科尔特",
                                    "text": "有太多的事情无能为力了，你我都是一样。"
                                },
                                {
                                    "id": "140170826",
                                    "speaker": "娜维娅",
                                    "text": "你不再是刺玫会的一员了。"
                                },
                                {
                                    "id": "140170827",
                                    "speaker": "娜维娅",
                                    "text": "但等你再度获得自由的那天，如果想回白淞镇看看，我们依然欢迎。"
                                },
                                {
                                    "id": "140170828",
                                    "speaker": "科尔特",
                                    "text": "谢谢你，娜维娅。"
                                },
                                {
                                    "id": "140170829",
                                    "speaker": "弗洛朗",
                                    "text": "老板果然是个温柔的人。"
                                },
                                {
                                    "id": "140170830",
                                    "speaker": "娜维娅",
                                    "text": "…也是个不走运的人。"
                                },
                                {
                                    "id": "140170831",
                                    "speaker": "娜维娅",
                                    "text": "谢谢你，能够保护克莱门汀线。"
                                },
                                {
                                    "id": "140170832",
                                    "speaker": "娜维娅",
                                    "text": "#其实我很害怕，{NICKNAME}。短期之内，卡雷斯线都无法重建…"
                                },
                                {
                                    "id": "140170833",
                                    "speaker": "娜维娅",
                                    "text": "如果连克莱门汀线也被人破坏，我不知道该怎么面对。"
                                },
                                {
                                    "id": "140170834",
                                    "speaker": "娜维娅",
                                    "text": "名字是一种「铭刻」，失去了每天都能看见的克莱门汀线，我就觉得像再一次失去了母亲一样…"
                                },
                                {
                                    "id": "140170835",
                                    "speaker": "娜维娅",
                                    "text": "但它还好好地站在那里，真是太好了。"
                                },
                                {
                                    "id": "140170836",
                                    "speaker": "派蒙",
                                    "text": "到底发生了什么啊？比起累，你更像是沮丧…"
                                },
                                {
                                    "id": "140170837",
                                    "speaker": "弗洛朗",
                                    "text": "给老板一些时间吧。",
                                    "choices": [
                                        {
                                            "id": "140170838",
                                            "text": "没关系，一切都还好。",
                                            "response": [
                                                {
                                                    "id": "140170840",
                                                    "speaker": "娜维娅",
                                                    "text": "嗯，谢谢，扶我一下吧，我实在没什么力气了。"
                                                },
                                                {
                                                    "id": "140170841",
                                                    "speaker": "娜维娅",
                                                    "text": "#{NICKNAME}，我想问你一件事，请一定要说实话。"
                                                },
                                                {
                                                    "id": "140170842",
                                                    "speaker": "娜维娅",
                                                    "text": "在你心里，我真的是你的「搭档」吗？"
                                                },
                                                {
                                                    "id": "140170843",
                                                    "speaker": "Player",
                                                    "text": "当然。"
                                                },
                                                {
                                                    "id": "140170844",
                                                    "speaker": "娜维娅",
                                                    "text": "那就好。"
                                                },
                                                {
                                                    "id": "140170845",
                                                    "speaker": "娜维娅",
                                                    "text": "有你这句话，我真的松了一口气。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140170839",
                                            "text": "我陪你回去吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140170811",
                            "text": "有点疲惫吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401715",
            "objective": "(test)(hide)隐藏控制船只消失$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1401709",
            "objective": "扶娜维娅回到白淞镇",
            "dialogues": [
                {
                    "id": "140170901",
                    "speaker": "派蒙",
                    "text": "怎么样，休息了一会儿，你好点了吗？"
                },
                {
                    "id": "140170902",
                    "speaker": "娜维娅",
                    "text": "嗯，好些了，不过应该还要休养一两天。"
                },
                {
                    "id": "140170903",
                    "speaker": "娜维娅",
                    "text": "抱歉，搭档，我刚刚说了点奇怪的话，你别往心里去。",
                    "choices": [
                        {
                            "id": "140170904",
                            "text": "确实有点奇怪。",
                            "response": [
                                {
                                    "id": "140170906",
                                    "speaker": "娜维娅",
                                    "text": "曾经我也这么以为，只不过我没有我想象中那么坚强。"
                                },
                                {
                                    "id": "140170907",
                                    "speaker": "娜维娅",
                                    "text": "科尔特提到了我的父母，还有迈勒斯和西尔弗，因为他们，我才能活到现在。"
                                },
                                {
                                    "id": "140170908",
                                    "speaker": "娜维娅",
                                    "text": "他们…不会后悔吗？我活着，又让谁感到了幸福呢？"
                                },
                                {
                                    "id": "140170909",
                                    "speaker": "派蒙",
                                    "text": "不要这样想，娜维娅，你已经做得够好了。"
                                },
                                {
                                    "id": "140170910",
                                    "speaker": "派蒙",
                                    "text": "#无论别人如何，我和{M#他}{F#她}，永远永远都会支持你！"
                                },
                                {
                                    "id": "140170911",
                                    "speaker": "弗洛朗",
                                    "text": "事到如今，看来不得不坦白了。"
                                },
                                {
                                    "id": "140170912",
                                    "speaker": "弗洛朗",
                                    "text": "老板，我也有件事瞒着你，请你们都跟我来吧，已经准备好了。"
                                },
                                {
                                    "id": "140170913",
                                    "speaker": "娜维娅",
                                    "text": "现在的我，可承受不住什么「真相」了。"
                                },
                                {
                                    "id": "140170914",
                                    "speaker": "弗洛朗",
                                    "text": "放心吧，一定会是惊喜。"
                                }
                            ]
                        },
                        {
                            "id": "140170905",
                            "text": "因为你从不怀疑自己。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1401710",
            "objective": "和娜维娅去看「惊喜」",
            "dialogues": [
                {
                    "id": "140171001",
                    "speaker": "娜维娅",
                    "text": "为什么大家都聚在这里？这是什么？"
                },
                {
                    "id": "140171002",
                    "speaker": "弗洛朗",
                    "text": "本来这是我们全镇人为老板准备的礼物，打算在做好之后再向你揭晓。"
                },
                {
                    "id": "140171003",
                    "speaker": "弗洛朗",
                    "text": "但现在情况特殊，我还从来没见过你如此沮丧的样子，所以就先把这个礼物的设计图拿出来了。"
                },
                {
                    "id": "140171004",
                    "speaker": "娜维娅",
                    "text": "我…我的样子居然有这么难看吗？"
                },
                {
                    "id": "140171005",
                    "speaker": "弗洛朗",
                    "text": "准备好了的话，就把布揭开了。"
                },
                {
                    "id": "140171006",
                    "speaker": "娜维娅",
                    "text": "嗯…"
                },
                {
                    "id": "140171007",
                    "speaker": "娜维娅",
                    "text": "这、这是…"
                },
                {
                    "id": "140171008",
                    "speaker": "娜维娅",
                    "text": "老爹，母亲，还有，我…"
                },
                {
                    "id": "140171009",
                    "speaker": "弗洛朗",
                    "text": "克莱门汀女士的样子，是我们参考以前的留影和众人的印象绘制的。"
                },
                {
                    "id": "140171010",
                    "speaker": "派蒙",
                    "text": "这不会是，之前提到的那个雕像吧？！"
                },
                {
                    "id": "140171011",
                    "speaker": "弗洛朗",
                    "text": "是的，其实我们早就定好了雕像的设计，已经在委托人制作了。"
                },
                {
                    "id": "140171012",
                    "speaker": "弗洛朗",
                    "text": "为了不让老板察觉，才故意说需要老板来决定造型。"
                },
                {
                    "id": "140171013",
                    "speaker": "伊薇特",
                    "text": "只有卡雷斯先生和克莱门汀女士怎么行呢？"
                },
                {
                    "id": "140171014",
                    "speaker": "桑迪诺",
                    "text": "虽然我们的老板很年轻，「乐斯」的事也好，重建白淞镇也好，她做过的事我们都看在眼里。"
                },
                {
                    "id": "140171015",
                    "speaker": "艾琪诺",
                    "text": "值得我们用雕像的形式去纪念。"
                },
                {
                    "id": "140171016",
                    "speaker": "阿黛尔",
                    "text": "我不知道以前的刺玫会是什么样，但我知道，现在很好！"
                },
                {
                    "id": "140171017",
                    "speaker": "科拉莉",
                    "text": "有娜维娅在，我们很放心。"
                },
                {
                    "id": "140171018",
                    "speaker": "弗洛朗",
                    "text": "我们聚于此地，是想要告诉老板——"
                },
                {
                    "id": "140171019",
                    "speaker": "弗洛朗",
                    "text": "我们是相信你，而不是沉溺于过去的辉煌才决定留在这里的。"
                },
                {
                    "id": "140171020",
                    "speaker": "派蒙",
                    "text": "#我和{M#他}{F#她}也是！"
                },
                {
                    "id": "140171021",
                    "speaker": "Player",
                    "text": "我也永远相信我们的默契。"
                },
                {
                    "id": "140171022",
                    "speaker": "娜维娅",
                    "text": "谢谢你们，那我就厚着脸皮接受大家的好意了…"
                },
                {
                    "id": "140171023",
                    "speaker": "娜维娅",
                    "text": "真是了不起的惊喜啊。"
                },
                {
                    "id": "140171024",
                    "speaker": "娜维娅",
                    "text": "我连做梦都没想过，居然有机会和母亲站在一起。"
                }
            ]
        },
        {
            "id": "1401750",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140175001",
                    "speaker": "派蒙",
                    "text": "看我把他翻过来。这个人好重啊，该减肥了…"
                }
            ]
        },
        {
            "id": "1401751",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140175101",
                    "speaker": "派蒙",
                    "text": "快把它停下来吧，时间紧迫。"
                }
            ]
        },
        {
            "id": "1401799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140179901",
                    "speaker": "派蒙",
                    "text": "什么？你找到了？真厉害！"
                }
            ]
        }
    ]
}