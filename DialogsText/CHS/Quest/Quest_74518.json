    "talks": [
        {
            "id": "7451801",
            "objective": "和「执律庭」队员们对话",
            "dialogues": [
                {
                    "id": "745180101",
                    "speaker": "蒂蕾娜",
                    "text": "嗯…对敌人的强硬支撑点开展进攻时，机动组的路径选择，和屏卫单位的配合调度，确实值得深入研究。"
                },
                {
                    "id": "745180102",
                    "speaker": "昂吉安妮",
                    "text": "#主要还是{NICKNAME}指挥得太离谱，根本不按常理出牌…",
                    "choices": [
                        {
                            "id": "745180103",
                            "text": "看来你们有灵感了？",
                            "response": [
                                {
                                    "id": "745180105",
                                    "speaker": "蒂蕾娜",
                                    "text": "的确！如您所见，主攻部队一旦展开，短时间内很难脱离接触，这个时候，掩护侧方、截断敌方增援的兵力就显得至关重要了。"
                                },
                                {
                                    "id": "745180106",
                                    "speaker": "蒂蕾娜",
                                    "text": "但在兵力有限的情况下，分出多少单位去屏卫，一直是个难题。"
                                },
                                {
                                    "id": "745180107",
                                    "speaker": "昂吉安妮",
                                    "text": "哎呀…人多了有可能削弱主力，人少了可能没法形成遮断，每次行动派多少人去屏卫，谁都说不准。"
                                },
                                {
                                    "id": "745180108",
                                    "speaker": "昂吉安妮",
                                    "text": "按照惯例，特巡队会以约四分之一主攻部队的兵力组成屏卫力量，在敌方潜在增援到来的方向上巡逻…"
                                },
                                {
                                    "id": "745180109",
                                    "speaker": "昂吉安妮",
                                    "text": "一般情况下，这样安排就够用了，但也出现过邪门的情况…屏卫搁那边悠闲散步，没敌人来，主力反倒缺人，打得气喘吁吁…"
                                },
                                {
                                    "id": "745180110",
                                    "speaker": "蒂蕾娜",
                                    "text": "而您，准领队，您有时会将主力部队机动组的进攻路径安排得万分巧妙，与屏卫部队相互照应。"
                                },
                                {
                                    "id": "745180111",
                                    "speaker": "蒂蕾娜",
                                    "text": "如此一来，主力部队机动组和屏卫部队可以在合适的时机互相支援，最大程度利用兵力。"
                                },
                                {
                                    "id": "745180112",
                                    "speaker": "蒂蕾娜",
                                    "text": "进攻受阻时，屏卫就适当辅助机动组，敌方强大增援来袭时，机动组也可以就地与屏卫一同对其拦截，堪称攻守一体！",
                                    "choices": [
                                        {
                                            "id": "745180113",
                                            "text": "被发现了？不愧是我！",
                                            "response": [
                                                {
                                                    "id": "745180115",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "总之，正是在您这样灵活的调度下，曾经难倒过昂吉安妮教官的第三个进攻想定，对您来说完全不在话下…"
                                                },
                                                {
                                                    "id": "745180116",
                                                    "speaker": "昂吉安妮",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "745180117",
                                                    "speaker": "昂吉安妮",
                                                    "text": "行吧行吧，我输了！回头就把那几组竞赛弹药送给你！"
                                                },
                                                {
                                                    "id": "745180118",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "嘿！这次我赢得理所当然，就不和教官客气了！"
                                                },
                                                {
                                                    "id": "745180119",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "夏沃蕾队长同款的限量竞赛弹头，超高的精度和远距离存速…啊哈哈…"
                                                },
                                                {
                                                    "id": "745180120",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "呃咳！言归正传，我早就感觉到准领队对铳枪有兴趣了。之前我去问了几位同僚，搞清楚了必要的申请程序，您完全符合要求！"
                                                },
                                                {
                                                    "id": "745180121",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "下次等您有时间，我们找个机会，走完相关流程，测好关键数据，帮您定制一把专用的铳枪！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745180114",
                                            "text": "有这事吗？我随便打的！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745180104",
                            "text": "我打出了值得研究的案例？"
                        }
                    ]
                }
            ]
        }
    ]
}