    "talks": [
        {
            "id": "7069401",
            "objective": "与「邦邦滚石」对话",
            "dialogues": [
                {
                    "id": "706940101",
                    "speaker": "宵宫",
                    "text": "邦邦小姐，腰还疼吗？"
                },
                {
                    "id": "706940102",
                    "speaker": "「邦邦滚石」",
                    "text": "目前没事了…热敷当真见效快！"
                },
                {
                    "id": "706940103",
                    "speaker": "宵宫",
                    "text": "嘿嘿，用慢速火药加热湿绷带的方法，可得把握好时间哦，不然就会把绷带点燃。"
                },
                {
                    "id": "706940104",
                    "speaker": "派蒙",
                    "text": "这种加热绷带的方法，可能只有宵宫才能想到了！"
                },
                {
                    "id": "706940105",
                    "speaker": "「邦邦滚石」",
                    "text": "#等等…看看这是谁来了！名副其实的大英雄，和{M#他}{F#她}的白色伙伴！"
                },
                {
                    "id": "706940106",
                    "speaker": "「邦邦滚石」",
                    "text": "漫画织卷里的场景，要在我眼前上演了吗？",
                    "choices": [
                        {
                            "id": "706940107",
                            "text": "你们这是在疗伤？",
                            "response": [
                                {
                                    "id": "706940109",
                                    "speaker": "「邦邦滚石」",
                                    "text": "不打紧！只不过是在野外转悠，找了些以前没怎么见过的强敌练手！"
                                },
                                {
                                    "id": "706940110",
                                    "speaker": "「邦邦滚石」",
                                    "text": "宵宫小姐才是，我不小心扭到腰咕噜噜摔成雪球滚下来的时候，帮了我大忙！"
                                },
                                {
                                    "id": "706940111",
                                    "speaker": "派蒙",
                                    "text": "哇啊…听着就疼…"
                                },
                                {
                                    "id": "706940112",
                                    "speaker": "宵宫",
                                    "text": "哈哈，按照《炽魂斗士战记》的说法，「我只是一个路过的战士罢了」…"
                                },
                                {
                                    "id": "706940113",
                                    "speaker": "宵宫",
                                    "text": "而且是自由的雇佣战士！骑士团已经给我行动许可了，可以自行击退魔物。",
                                    "choices": [
                                        {
                                            "id": "706940114",
                                            "text": "听起来，还有魔物在徘徊？",
                                            "response": [
                                                {
                                                    "id": "706940116",
                                                    "speaker": "派蒙",
                                                    "text": "好像不妙啊，要不要通知骑士团那边，再派一些人手来支援？"
                                                },
                                                {
                                                    "id": "706940117",
                                                    "speaker": "宵宫",
                                                    "text": "确实不能怠慢，不过情况也不算紧急啦。"
                                                },
                                                {
                                                    "id": "706940118",
                                                    "speaker": "宵宫",
                                                    "text": "骑士团的专业人士已经把「国际越野赛」场地周围的魔物清理完了，剩下的都是一些游荡不定的家伙。"
                                                },
                                                {
                                                    "id": "706940119",
                                                    "speaker": "宵宫",
                                                    "text": "说实话，参加越野赛的选手们中，也不乏武力不错的冒险家。"
                                                },
                                                {
                                                    "id": "706940120",
                                                    "speaker": "宵宫",
                                                    "text": "他们有体魄，有胆识，让他们像普通人一样，处处小心魔物，人家反而觉得自己被看轻了呢。"
                                                },
                                                {
                                                    "id": "706940121",
                                                    "speaker": "「邦邦滚石」",
                                                    "text": "所以，按照冒险家协会的办事传统，我们就地组成团队，将处理这些魔物当成了一种试炼。"
                                                },
                                                {
                                                    "id": "706940122",
                                                    "speaker": "「邦邦滚石」",
                                                    "text": "正是——「斗魂试炼」，在清剿魔物的基础上，尽量模仿英雄们的战斗风格，实现对自我的超越！"
                                                },
                                                {
                                                    "id": "706940123",
                                                    "speaker": "派蒙",
                                                    "text": "这个思路，确实很符合「沃陆之邦」的作风！",
                                                    "choices": [
                                                        {
                                                            "id": "706940124",
                                                            "text": "那我要加入！",
                                                            "response": [
                                                                {
                                                                    "id": "706940126",
                                                                    "speaker": "宵宫",
                                                                    "text": "#好啊！很久没看见{NICKNAME}露一手了！"
                                                                },
                                                                {
                                                                    "id": "706940127",
                                                                    "speaker": "宵宫",
                                                                    "text": "非常期待，现在你的身手…漂亮得像是哪种烟花？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706940125",
                                                            "text": "我也不能缺席！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706940115",
                                            "text": "那需要谨慎，附近还有平民。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706940108",
                            "text": "刚刚经历过战斗吗？"
                        }
                    ]
                }
            ]
        }
    ]
}