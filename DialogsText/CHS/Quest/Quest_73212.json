    "talks": [
        {
            "id": "7321201",
            "objective": "(test)与尤夫腾对话 $HIDDEN",
            "dialogues": [
                {
                    "id": "732120101",
                    "speaker": "尤夫腾",
                    "text": "啊，「镇灵主人」，您、您、您来了。"
                },
                {
                    "id": "732120102",
                    "speaker": "尤夫腾",
                    "text": "我正好有一件事要拜托您，一件、一件…急事。",
                    "choices": [
                        {
                            "id": "732120103",
                            "text": "请别着急，我在听着。",
                            "response": [
                                {
                                    "id": "732120104",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，你慢慢说，我们会帮忙的啦！"
                                },
                                {
                                    "id": "732120107",
                                    "speaker": "尤夫腾",
                                    "text": "是我的一批、一批、一批货物…丢失了。"
                                },
                                {
                                    "id": "732120108",
                                    "speaker": "派蒙",
                                    "text": "居然丢了三批货物呢！"
                                },
                                {
                                    "id": "732120109",
                                    "speaker": "尤夫腾",
                                    "text": "不，是一、一、一批…货物。"
                                },
                                {
                                    "id": "732120110",
                                    "speaker": "尤夫腾",
                                    "text": "外人运进来的「丰沃之惠」，已经很、很久了，但没、没有到货…"
                                },
                                {
                                    "id": "732120111",
                                    "speaker": "尤夫腾",
                                    "text": "可能是那些北、北方人搞的鬼…因为芭别尔主母一直在针对他们，搜、搜捕叛徒什么的…"
                                },
                                {
                                    "id": "732120112",
                                    "speaker": "尤夫腾",
                                    "text": "自从、自从阿德菲和阿萨里格不在了以后…他们的活动也多起来了。"
                                },
                                {
                                    "id": "732120113",
                                    "speaker": "尤夫腾",
                                    "text": "好、好了，不多说别、别的闲话。运送「丰沃之惠」的商队最后是在、在这片区域被哨兵发现的…"
                                },
                                {
                                    "id": "732120114",
                                    "speaker": "尤夫腾",
                                    "text": "希望您能帮助我找、找、找到货物，或者至少、至少、至少…将商队留下的线索告知我。"
                                },
                                {
                                    "id": "732120115",
                                    "speaker": "Player",
                                    "text": "好的，我会帮忙的。"
                                },
                                {
                                    "id": "732120116",
                                    "speaker": "派蒙",
                                    "text": "商队自己就不见了？听起来是被坏家伙打劫了呢…"
                                },
                                {
                                    "id": "732120117",
                                    "speaker": "尤夫腾",
                                    "text": "十分、十分、十分感谢，这些肉请您收下吧。"
                                },
                                {
                                    "id": "732120118",
                                    "speaker": "派蒙",
                                    "text": "你太客气啦！"
                                }
                            ]
                        },
                        {
                            "id": "732120105",
                            "text": "有什么事情需要我帮忙？",
                            "response": [
                                {
                                    "id": "732120106",
                                    "speaker": "派蒙",
                                    "text": "慢慢说啦，不要着急！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321202",
            "objective": "前往商队最后出现的地点",
            "dialogues": []
        },
        {
            "id": "7321203",
            "objective": "调查该地点",
            "dialogues": [
                {
                    "id": "732120501",
                    "speaker": "破损的罐子",
                    "text": "（一个破损的空罐，尚未完全被沙子掩埋。看起来它是在不久前被人丢弃的。）"
                },
                {
                    "id": "732120502",
                    "speaker": "派蒙",
                    "text": "你看！这个罐子还没有被沙子掩埋呢！",
                    "choices": [
                        {
                            "id": "732120503",
                            "text": "物资散落在商道上了…",
                            "response": [
                                {
                                    "id": "732120504",
                                    "speaker": "派蒙",
                                    "text": "看起来很不妙呢…说不定他们顺路还遗落了其他东西，我们再往前找找看吧？"
                                }
                            ]
                        },
                        {
                            "id": "732120505",
                            "text": "我们再顺路寻找一番吧。",
                            "response": [
                                {
                                    "id": "732120506",
                                    "speaker": "派蒙",
                                    "text": "嗯…他们应该还沿途丢弃了其他东西，我们继续往前走走看看吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321204",
            "objective": "沿途调查线索",
            "dialogues": [
                {
                    "id": "732120601",
                    "speaker": "破裂的空木箱",
                    "text": "（空空如也的破木箱，被人随意地丢弃在这里，无力地倒在路边。）"
                },
                {
                    "id": "732120602",
                    "speaker": "派蒙",
                    "text": "咦，这个木箱一定是车队的吧，上面有部落的标志呢！"
                },
                {
                    "id": "732120603",
                    "speaker": "Player",
                    "text": "这里的地形很适合伏击。"
                },
                {
                    "id": "732120604",
                    "speaker": "派蒙",
                    "text": "说得是呢…这个位置，一看就很凶险！"
                },
                {
                    "id": "732120605",
                    "speaker": "Player",
                    "text": "就连大件物资也被抢夺一空了…"
                },
                {
                    "id": "732120606",
                    "speaker": "派蒙",
                    "text": "他们搬走了物资，但是留下了空箱子…嗯，他们的人数应该不少，而且缺少搬运木箱的工具。"
                },
                {
                    "id": "732120607",
                    "speaker": "Player",
                    "text": "或者，这是他们的计谋…"
                },
                {
                    "id": "732120608",
                    "speaker": "派蒙",
                    "text": "欸…？计谋？"
                },
                {
                    "id": "732120609",
                    "speaker": "派蒙",
                    "text": "难道这些空箱是他们故意留下来的…为了引人上钩吗？"
                },
                {
                    "id": "732120610",
                    "speaker": "Player",
                    "text": "为了引我们上钩。"
                },
                {
                    "id": "732120611",
                    "speaker": "派蒙",
                    "text": "呜哇…我汗毛都要起来了！那我们还要不要继续往前探查呀…",
                    "choices": [
                        {
                            "id": "732120612",
                            "text": "派蒙害怕的话，可以先回去呀。",
                            "response": [
                                {
                                    "id": "732120613",
                                    "speaker": "派蒙",
                                    "text": "我不要，谁说我害怕啦！哼…况且你也一定离不开我呀！"
                                }
                            ]
                        },
                        {
                            "id": "732120614",
                            "text": "打劫车队的人，也许还埋伏在附近。",
                            "response": [
                                {
                                    "id": "732120615",
                                    "speaker": "派蒙",
                                    "text": "唔，你说的好可怕…哼，但既然你都不怕，我们就继续顺着道路探查吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321214",
            "objective": "沿途调查线索",
            "dialogues": []
        },
        {
            "id": "7321215",
            "objective": "(test)剿灭丘丘人营地$HIDDEN",
            "dialogues": [
                {
                    "id": "732121501",
                    "speaker": "尤夫腾",
                    "text": "这件事情很、很紧急，请、请、请快去告诉主母吧。"
                }
            ]
        },
        {
            "id": "7321213",
            "objective": "调查丘丘人营地",
            "dialogues": [
                {
                    "id": "732121601",
                    "speaker": "派蒙",
                    "text": "唔…没有什么完整的东西留下来呢…哼，气死我啦！这些丘丘人太糟蹋东西啦！",
                    "choices": [
                        {
                            "id": "732121602",
                            "text": "等等，这些应该不是丘丘人破坏的…",
                            "response": [
                                {
                                    "id": "732121603",
                                    "speaker": "派蒙",
                                    "text": "欸…？可是…丘丘人就在这里扎营呀？",
                                    "choices": [
                                        {
                                            "id": "732121606",
                                            "text": "因为我们还没有看到马车…",
                                            "response": [
                                                {
                                                    "id": "732121607",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…对哦！马车残骸不在这里…丘丘人搭建的棚子上也没有看到像是马车零件的东西…奇怪。"
                                                },
                                                {
                                                    "id": "732121610",
                                                    "speaker": "Player",
                                                    "text": "我们再顺路往前走走看吧。"
                                                },
                                                {
                                                    "id": "732121611",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…好吧。既然不是丘丘人干的，那又会是谁呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732121608",
                                            "text": "你看，营地里没有马车。",
                                            "response": [
                                                {
                                                    "id": "732121609",
                                                    "speaker": "派蒙",
                                                    "text": "对哦！如果是丘丘人抢劫了商队，应该会把马车留在原地慢慢拆解，但是我们既没看到马车，也没看到马车的零件…真是奇怪！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732121604",
                            "text": "等等，抢劫应该没有发生在这里…",
                            "response": [
                                {
                                    "id": "732121605",
                                    "speaker": "派蒙",
                                    "text": "可是丘丘人在路中间扎下了营地呀？你看，挡在这里不是正好可以拦路抢劫吗！",
                                    "choices": [
                                        {
                                            "id": "732121606",
                                            "text": "因为我们还没有看到马车…"
                                        },
                                        {
                                            "id": "732121608",
                                            "text": "你看，营地里没有马车。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321205",
            "objective": "调查附近的线索",
            "dialogues": [
                {
                    "id": "732120801",
                    "speaker": "残破的毛毯",
                    "text": "（一卷完好的毛毯，其上缝制着塔尼特部族的标志，沾染着点点不祥的污迹…）"
                },
                {
                    "id": "732120802",
                    "speaker": "Player",
                    "text": "这卷毛毯…真奇怪…"
                },
                {
                    "id": "732120803",
                    "speaker": "派蒙",
                    "text": "唔…昂贵的毛毯，为什么会被丢在这里呢？"
                },
                {
                    "id": "732120804",
                    "speaker": "Player",
                    "text": "或许是因为发生了抢夺和打斗…"
                },
                {
                    "id": "732120805",
                    "speaker": "派蒙",
                    "text": "嗯…有道理哦…这样的话，就能说明白啦。"
                },
                {
                    "id": "732120806",
                    "speaker": "派蒙",
                    "text": "商队和劫匪在这里发生了打斗，一些物资在打斗过程中被破坏掉了，还有一些完好的物资没有顾得上整理就被丢弃掉了…"
                },
                {
                    "id": "732120807",
                    "speaker": "Player",
                    "text": "派蒙的推理很靠谱呢。"
                },
                {
                    "id": "732120808",
                    "speaker": "派蒙",
                    "text": "哼哼！毕竟是我派蒙嘛！"
                },
                {
                    "id": "732120809",
                    "speaker": "派蒙",
                    "text": "于是，商队和劫匪一路打、一路跑！一路打、一路跑！一路打、一路跑…所以路上会散落着破碎的箱子和罐子！"
                },
                {
                    "id": "732120810",
                    "speaker": "派蒙",
                    "text": "嗯，这样就能说得通啦！"
                },
                {
                    "id": "732120811",
                    "speaker": "Player",
                    "text": "完全说不通吧！"
                },
                {
                    "id": "732120812",
                    "speaker": "派蒙",
                    "text": "欸——！",
                    "choices": [
                        {
                            "id": "732120813",
                            "text": "那些垃圾应该是劫匪得手后丢弃的…",
                            "response": [
                                {
                                    "id": "732120815",
                                    "speaker": "派蒙",
                                    "text": "这样吗…"
                                },
                                {
                                    "id": "732120816",
                                    "speaker": "Player",
                                    "text": "因为沿途没有发现争斗痕迹。"
                                },
                                {
                                    "id": "732120817",
                                    "speaker": "派蒙",
                                    "text": "这样呀…哼哼，那我的推理也差的不远啦…八九不离十嘛！"
                                },
                                {
                                    "id": "732120818",
                                    "speaker": "派蒙",
                                    "text": "唔…但我总觉得哪里不太对劲…",
                                    "choices": [
                                        {
                                            "id": "732120819",
                                            "text": "是哪里呢？",
                                            "response": [
                                                {
                                                    "id": "732120821",
                                                    "speaker": "派蒙",
                                                    "text": "那个…你不觉得这些线索太刻意了吗？就像为专门引导我们而排列的一样…",
                                                    "choices": [
                                                        {
                                                            "id": "732120822",
                                                            "text": "唔…是你太多疑了吧。",
                                                            "response": [
                                                                {
                                                                    "id": "732120824",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸！你看，马车不就在那边吗！"
                                                                },
                                                                {
                                                                    "id": "732120825",
                                                                    "speaker": "派蒙",
                                                                    "text": "几乎认不出原状了呢…不过上面还有塔尼特部族的标志…模模糊糊的…"
                                                                },
                                                                {
                                                                    "id": "732120826",
                                                                    "speaker": "派蒙",
                                                                    "text": "好啦，我们可以结案了！"
                                                                },
                                                                {
                                                                    "id": "732120827",
                                                                    "speaker": "派蒙",
                                                                    "text": "你看，很显然是马队被人伏击，物资也都被抢走了。我们可以回去向尤夫腾回报情况啦！"
                                                                },
                                                                {
                                                                    "id": "732120828",
                                                                    "speaker": "Player",
                                                                    "text": "嗯，我们回去吧。"
                                                                },
                                                                {
                                                                    "id": "732120829",
                                                                    "speaker": "？？？",
                                                                    "text": "不好意思，两位客人请留步。"
                                                                },
                                                                {
                                                                    "id": "732120830",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸…你们是谁呀？"
                                                                },
                                                                {
                                                                    "id": "732120831",
                                                                    "speaker": "？？？",
                                                                    "text": "我们是婕德的朋友，辛苦你们了。"
                                                                },
                                                                {
                                                                    "id": "732120832",
                                                                    "speaker": "派蒙",
                                                                    "text": "这样呀，婕德的朋友就是我们的朋友！正好我们这边也忙完啦，我们一起回去吧！"
                                                                },
                                                                {
                                                                    "id": "732120833",
                                                                    "speaker": "？？？",
                                                                    "text": "哈哈，不着急，客人不用着急回去。"
                                                                },
                                                                {
                                                                    "id": "732120834",
                                                                    "speaker": "Player",
                                                                    "text": "等等，派蒙…他们有些不对劲。"
                                                                },
                                                                {
                                                                    "id": "732120835",
                                                                    "speaker": "？？？",
                                                                    "text": "婕德说，希望你们在沙漠里多留一段时间…她委托我们在这里「招待」一下你们。"
                                                                },
                                                                {
                                                                    "id": "732120836",
                                                                    "speaker": "？？？",
                                                                    "text": "希望你不要辜负她的好意。"
                                                                },
                                                                {
                                                                    "id": "732120837",
                                                                    "speaker": "派蒙",
                                                                    "text": "#欸…？{NICKNAME}…"
                                                                },
                                                                {
                                                                    "id": "732120838",
                                                                    "speaker": "Player",
                                                                    "text": "躲起来，派蒙。"
                                                                },
                                                                {
                                                                    "id": "732120839",
                                                                    "speaker": "派蒙",
                                                                    "text": "好、好的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "732120823",
                                                            "text": "有道理呢，但我们还没有足够证据。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732120820",
                                            "text": "是派蒙的直觉时间！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732120814",
                            "text": "丢弃那些，是出于轻装赶路的需要。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321212",
