            "dialogues": [
                {
                    "id": "711210201",
                    "speaker": "奇怪的商人",
                    "text": "万分感谢！嗨呀，要不是有你们搭救，我的货物险些就全完了！"
                },
                {
                    "id": "711210202",
                    "speaker": "奇怪的商人",
                    "text": "请别客气，我身上也没多少钱，就请收下这些做报酬吧。"
                },
                {
                    "id": "711210203",
                    "speaker": "派蒙",
                    "text": "哇，你也太客气啦！"
                },
                {
                    "id": "711210204",
                    "speaker": "奇怪的商人",
                    "text": "哈哈，我们就此别过，希望下次还有机会相见！"
                }
            ]
        },
        {
            "id": "7112105",
            "objective": "(test)7112102锁定环$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7112103",
            "objective": "(test)NPC瑟缩角落$HIDDEN",
            "dialogues": [
                {
                    "id": "711210301",
                    "speaker": "奇怪的商人",
                    "text": "大、大侠饶命…欸，是你们？！"
                },
                {
                    "id": "711210302",
                    "speaker": "Player",
                    "text": "是你？！"
                },
                {
                    "id": "711210303",
                    "speaker": "奇怪的商人",
                    "text": "嘿嘿，无巧不成书嘛这不是…哈哈，你们先忙着，我先走了哈！"
                },
                {
                    "id": "711210304",
                    "speaker": "奇怪的商人",
                    "text": "我建议你看看他们留下了什么宝贝，唔…别担心我，我把它们都登记备案了…该归还的东西由我归还就好。"
                },
                {
                    "id": "711210305",
                    "speaker": "Player",
                    "text": "等等…！"
                },
                {
                    "id": "711210306",
                    "speaker": "奇怪的商人",
                    "text": "没关系，反正之后我们还有机会再见！"
                }
            ]
        },
        {
            "id": "7112104",
            "objective": "(test)判定商人能不能说话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7112151",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711215101",
                    "speaker": "奇怪的商人",
                    "text": "大、大侠饶命！我和他们不是一伙儿的！"
                },
                {
                    "id": "711215102",
                    "speaker": "Player",
                    "text": "你是什么人？！"
                },
                {
                    "id": "711215103",
                    "speaker": "奇怪的商人",
                    "text": "我是…我…呃，说来话长…？他们偷走了一些东西，我便受主人之托，把他们登记备案，再还回去而已。"
                },
                {
                    "id": "711215104",
                    "speaker": "奇怪的商人",
                    "text": "好啦，反正你把贼人都打跑了，我这里的工作也完成了。那我就先走咯！"
                },
                {
                    "id": "711215105",
                    "speaker": "Player",
                    "text": "等等…！"
                },
                {
                    "id": "711215106",
                    "speaker": "奇怪的商人",
                    "text": "没关系，反正之后我们还有机会再见！"
                },
                {
                    "id": "711215107",
                    "speaker": "Black Screen",
                    "text": "奇怪的商人很快离开了…"
                }
            ]
        }
