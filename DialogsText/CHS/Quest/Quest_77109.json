    "talks": [
        {
            "id": "7710901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771090101",
                    "speaker": "告示牌",
                    "text": "「最近自（…）通往白冕宫的道路遭人为破坏，至冬皇家能源协会与至冬皇家铁路运输局正在进行调查。」"
                },
                {
                    "id": "771090102",
                    "speaker": "告示牌",
                    "text": "「在铁路修复之前，还望谨慎靠近，警惕结构性破坏导致的后续塌方…」"
                }
            ]
        },
        {
            "id": "7710902",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771090201",
                    "speaker": "某位高贵之人的笔记·其六",
                    "text": "(test)台词文本"
                }
            ]
        },
        {
            "id": "7710903",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771090801",
                    "speaker": "？？？",
                    "text": "帕芙琳娜…这就是你在晚宴上曾应允的，为我展示的…你所作的研究的成果…"
                },
                {
                    "id": "771090802",
                    "speaker": "？？？",
                    "text": "但没想到你应用到了自己的族裔身上。"
                },
                {
                    "id": "771090803",
                    "speaker": "帕芙琳娜",
                    "text": "这全然出自他们自己的意志…他们本来已时日无多，能够成为您的助力亦是最后的愿望。"
                },
                {
                    "id": "771090804",
                    "speaker": "帕芙琳娜",
                    "text": "不过正因为有他们的献身，我和卡谢伊才得以明晰了…"
                },
                {
                    "id": "771090805",
                    "speaker": "帕芙琳娜",
                    "text": "您从影域中…亥珀波瑞亚遗迹中取得的「埃特{RUBY#[S]地原胚质}尔」究竟是什么样的东西…"
                },
                {
                    "id": "771090806",
                    "speaker": "？？？",
                    "text": "结论是？"
                },
                {
                    "id": "771090807",
                    "speaker": "帕芙琳娜",
                    "text": "那是亥珀波瑞亚时期，触犯了禁忌的实验的残余…拥有难以想象的力量，成分复杂…"
                },
                {
                    "id": "771090808",
                    "speaker": "帕芙琳娜",
                    "text": "其中不仅有特殊的…血肉，有被调整过专行创造之事的光界力，还有…"
                },
                {
                    "id": "771090809",
                    "speaker": "帕芙琳娜",
                    "text": "总之，它拥有难以想象的力量，会接触并改造生命…"
                },
                {
                    "id": "771090810",
                    "speaker": "帕芙琳娜",
                    "text": "然后，这些生命的运作方式就会逐渐向着某个倾向转化，并且最后趋同于一种模式。"
                },
                {
                    "id": "771090811",
                    "speaker": "帕芙琳娜",
                    "text": "……"
                },
                {
                    "id": "771090812",
                    "speaker": "？？？",
                    "text": "什么样的模式？"
                },
                {
                    "id": "771090813",
                    "speaker": "帕芙琳娜",
                    "text": "…恕我僭越，被改造的生命体内，力量的流转方式与您…十分相似，当然，他们自然无法达到您这样的高度。"
                },
                {
                    "id": "771090814",
                    "speaker": "帕芙琳娜",
                    "text": "对于人造种族妖精来说，这并不是可以凭借稍微改造过的肉身就能完全容纳的力量。"
                },
                {
                    "id": "771090815",
                    "speaker": "帕芙琳娜",
                    "text": "但是卡谢伊…他无法亲口向您请求，因为他是戴罪之身。但是他认为，如需让实验再进一步…"
                },
                {
                    "id": "771090816",
                    "speaker": "帕芙琳娜",
                    "text": "或许您的躯体的是必要的。"
                },
                {
                    "id": "771090817",
                    "speaker": "？？？",
                    "text": "…那便取用吧。"
                },
                {
                    "id": "771090818",
                    "speaker": "？？？",
                    "text": "我的血，我的肉，如果为了达成前人未尽的伟业，为了让这个世界更进一步，如果一切最后都值得…"
                },
                {
                    "id": "771090819",
                    "speaker": "？？？",
                    "text": "便随你们取用吧！"
                },
                {
                    "id": "771090820",
                    "speaker": "帕芙琳娜",
                    "text": "啊…陛下…"
                },
                {
                    "id": "771090821",
                    "speaker": "帕芙琳娜",
                    "text": "我为所有将踏入「明日」，为所有…可得拯救者，感谢您的慷慨。"
                }
            ]
        },
