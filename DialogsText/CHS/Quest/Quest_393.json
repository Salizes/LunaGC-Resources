    "talks": [
        {
            "id": "39301",
            "objective": "激活入口的封印",
            "dialogues": [
                {
                    "id": "3930101",
                    "speaker": "温迪",
                    "text": "我在想，一切结束以后，我要把这些都写进歌里…",
                    "choices": [
                        {
                            "id": "3930102",
                            "text": "这段时间还真是发生了很多事啊。",
                            "response": [
                                {
                                    "id": "3930104",
                                    "speaker": "温迪",
                                    "text": "嗯，这首歌也会像《温妮莎传奇》一样，被蒙德的人们传唱下去吧。"
                                },
                                {
                                    "id": "3930105",
                                    "speaker": "琴",
                                    "text": "我从小就很喜欢那首歌。"
                                },
                                {
                                    "id": "3930106",
                                    "speaker": "琴",
                                    "text": "#那么，{NICKNAME}…你今天状态如何？"
                                },
                                {
                                    "id": "3930107",
                                    "speaker": "琴",
                                    "text": "我已经调整到了最佳状态，一定能成为各位的助力。",
                                    "choices": [
                                        {
                                            "id": "3930108",
                                            "text": "琴团长真可靠。",
                                            "response": [
                                                {
                                                    "id": "3930110",
                                                    "speaker": "派蒙",
                                                    "text": "说起来，迪卢克老爷也陪我们一路走到了最后呢。"
                                                },
                                                {
                                                    "id": "3930111",
                                                    "speaker": "派蒙",
                                                    "text": "明明当初只是不小心被卷进来的…"
                                                },
                                                {
                                                    "id": "3930112",
                                                    "speaker": "派蒙",
                                                    "text": "的…呃…路人？"
                                                },
                                                {
                                                    "id": "3930113",
                                                    "speaker": "迪卢克",
                                                    "text": "你们向我分享了秘密，我不过是报以相同的信任而已。",
                                                    "choices": [
                                                        {
                                                            "id": "3930114",
                                                            "text": "迪卢克老爷的理由，是「信任」啊。",
                                                            "response": [
                                                                {
                                                                    "id": "3930115",
                                                                    "speaker": "派蒙",
                                                                    "text": "然后，琴团长的理由，是「责任」吧？"
                                                                },
                                                                {
                                                                    "id": "3930116",
                                                                    "speaker": "派蒙",
                                                                    "text": "那么，卖唱的呢？"
                                                                },
                                                                {
                                                                    "id": "3930121",
                                                                    "speaker": "温迪",
                                                                    "text": "是「自由」喔。"
                                                                },
                                                                {
                                                                    "id": "3930122",
                                                                    "speaker": "派蒙",
                                                                    "text": "自由…？"
                                                                },
                                                                {
                                                                    "id": "3930123",
                                                                    "speaker": "温迪",
                                                                    "text": "你们来蒙德时，有没有人对你们说过，蒙德是「自由之都」？"
                                                                },
                                                                {
                                                                    "id": "3930124",
                                                                    "speaker": "Player",
                                                                    "text": "安柏…"
                                                                },
                                                                {
                                                                    "id": "3930125",
                                                                    "speaker": "温迪",
                                                                    "text": "啊哈哈，那也是个自由自在的孩子呢。"
                                                                },
                                                                {
                                                                    "id": "3930126",
                                                                    "speaker": "温迪",
                                                                    "text": "蒙德是一座没有「国王」统治的浪漫城邦。"
                                                                },
                                                                {
                                                                    "id": "3930127",
                                                                    "speaker": "温迪",
                                                                    "text": "而蒙德的国民，是七国中最自由的国民。"
                                                                },
                                                                {
                                                                    "id": "3930128",
                                                                    "speaker": "温迪",
                                                                    "text": "我希望，曾经守护蒙德的龙也一样——"
                                                                },
                                                                {
                                                                    "id": "3930129",
                                                                    "speaker": "温迪",
                                                                    "text": "不该有人欺骗它，说「这座城市背叛了你」。"
                                                                },
                                                                {
                                                                    "id": "3930130",
                                                                    "speaker": "温迪",
                                                                    "text": "也不该有人告诉它，说「守护这座城市是你永恒的义务」。"
                                                                },
                                                                {
                                                                    "id": "3930131",
                                                                    "speaker": "温迪",
                                                                    "text": "它有选择自己生活方式的权利。"
                                                                },
                                                                {
                                                                    "id": "3930132",
                                                                    "speaker": "派蒙",
                                                                    "text": "温迪…"
                                                                },
                                                                {
                                                                    "id": "3930133",
                                                                    "speaker": "温迪",
                                                                    "text": "#那么，{NICKNAME}，蒙德的千年流风与你同在。"
                                                                },
                                                                {
                                                                    "id": "3930134",
                                                                    "speaker": "温迪",
                                                                    "text": "接下来我会像上次一样，为你引导「风」的元素力。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "3930135",
                                                                            "text": "你说「上次」…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3930137",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#原来如此！怪不得{NICKNAME}说你的声音很熟悉呢。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "3930136",
                                                                            "text": "我就知道，那时的声音果然是你。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930117",
                                                            "text": "琴团长的理由，是「责任」啊。",
                                                            "response": [
                                                                {
                                                                    "id": "3930118",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，迪卢克老爷的理由，是「信任」吧？"
                                                                },
                                                                {
                                                                    "id": "3930119",
                                                                    "speaker": "派蒙",
                                                                    "text": "那么，卖唱的呢？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930120",
                                                            "text": "那么温迪呢？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3930109",
                                            "text": "放心，我也状态满满！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3930103",
                            "text": "和温迪也快变成老搭档了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "39302",
            "objective": "回到塔顶",
            "dialogues": [
                {
                    "id": "3930201",
                    "speaker": "温迪",
                    "text": "让万物生长的风变成冒险的风也不错呢。"
                },
                {
                    "id": "3930202",
                    "speaker": "温迪",
                    "text": "<color=#00E1FFFF>特瓦林</color>就拜托你咯。"
                }
            ]
        },
