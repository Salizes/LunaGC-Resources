    "talks": [
        {
            "id": "7406501",
            "objective": "与德瑟布尔对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740650101",
                    "speaker": "德瑟布尔",
                    "text": "#哎哟，瞧瞧，这不是{NICKNAME}和派蒙吗？",
                    "choices": [
                        {
                            "id": "740650102",
                            "text": "我们很熟吗？",
                            "response": [
                                {
                                    "id": "740650104",
                                    "speaker": "德瑟布尔",
                                    "text": "别这么冷淡嘛，上次那事，我可记在心上了。"
                                },
                                {
                                    "id": "740650105",
                                    "speaker": "派蒙",
                                    "text": "上次那事…啊！我们还有好多想问的都没问清楚呢！"
                                },
                                {
                                    "id": "740650106",
                                    "speaker": "德瑟布尔",
                                    "text": "是、是这样吗？你看我这记性，上次是什么事来着？我全忘了！"
                                },
                                {
                                    "id": "740650107",
                                    "speaker": "德瑟布尔",
                                    "text": "聪明人都说，与其回顾过去，不如放眼未来。不如我们聊聊今后的合作吧！"
                                },
                                {
                                    "id": "740650108",
                                    "speaker": "德瑟布尔",
                                    "text": "现在我手头上有些报酬不错的活计，就愁没人帮忙。两位如果有空的话，要不要来试试看？"
                                },
                                {
                                    "id": "740650109",
                                    "speaker": "派蒙",
                                    "text": "哼，别以为我们还会轻易上当…"
                                },
                                {
                                    "id": "740650110",
                                    "speaker": "Player",
                                    "text": "报酬不错怎么说？"
                                },
                                {
                                    "id": "740650111",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                },
                                {
                                    "id": "740650112",
                                    "speaker": "德瑟布尔",
                                    "text": "#这就是为什么我喜欢和{NICKNAME}{M#先生}{F#小姐}这样的人物谈买卖，那话怎么说的，上道！"
                                },
                                {
                                    "id": "740650113",
                                    "speaker": "德瑟布尔",
                                    "text": "这样，我说个数，包你们满意。"
                                },
                                {
                                    "id": "740650114",
                                    "speaker": "德瑟布尔",
                                    "text": "一百特许券，怎么样？"
                                },
                                {
                                    "id": "740650115",
                                    "speaker": "派蒙",
                                    "text": "一百？！"
                                },
                                {
                                    "id": "740650116",
                                    "speaker": "德瑟布尔",
                                    "text": "嗯，看你的样子，是被我的慷慨给打动了吧。",
                                    "choices": [
                                        {
                                            "id": "740650117",
                                            "text": "买枫达的瓶塞都不够。",
                                            "response": [
                                                {
                                                    "id": "740650118",
                                                    "speaker": "派蒙",
                                                    "text": "就是！简直不敢相信你居然说得出口！"
                                                },
                                                {
                                                    "id": "740650121",
                                                    "speaker": "德瑟布尔",
                                                    "text": "我这还不够慷慨？你们这些年轻人可真是…不要不知好歹。"
                                                },
                                                {
                                                    "id": "740650122",
                                                    "speaker": "德瑟布尔",
                                                    "text": "要知道，这些干起来轻松又有赚头的活计，那些穷鬼可都是抢着…"
                                                },
                                                {
                                                    "id": "740650123",
                                                    "speaker": "莫普瓦",
                                                    "text": "德瑟布尔，你这滑头，可算让我逮到你了！上次在发信室附近抓到你把自己应该完成的委托低价转包给新来的…"
                                                },
                                                {
                                                    "id": "740650124",
                                                    "speaker": "莫普瓦",
                                                    "text": "#{NICKNAME}和派蒙？你们不会信了这家伙说的鬼话吧？",
                                                    "choices": [
                                                        {
                                                            "id": "740650125",
                                                            "text": "呜呜，已经被骗过一次了。",
                                                            "response": [
                                                                {
                                                                    "id": "740650126",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "唉，还是晚了一步。"
                                                                },
                                                                {
                                                                    "id": "740650130",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "总之他的话一个字也不要信。他专挑刚来梅洛彼得堡，或者来了一段时间但是不懂规矩的人行骗，已经有不少人受害了。"
                                                                },
                                                                {
                                                                    "id": "740650131",
                                                                    "speaker": "德瑟布尔",
                                                                    "text": "什么行骗…说这么难听。我们之间有什么区别吗？你们看守不也会用特许券打发人干些杂活…"
                                                                },
                                                                {
                                                                    "id": "740650132",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "我们可不会截留一部分放进自己的口袋。"
                                                                },
                                                                {
                                                                    "id": "740650133",
                                                                    "speaker": "德瑟布尔",
                                                                    "text": "你在暗示什么？没有证据就不要血口喷人。"
                                                                },
                                                                {
                                                                    "id": "740650134",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "唉，想看证据是吧？我们走，禁闭室又安静又宽敞，最适合看材料了。真是的，明明晶簇矿坑道那边还有麻烦事等着我去…"
                                                                },
                                                                {
                                                                    "id": "740650135",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "#对了，{NICKNAME}和派蒙，如果你们方便的话，可以帮我…"
                                                                },
                                                                {
                                                                    "id": "740650136",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们也不是总是很空闲的啦！"
                                                                },
                                                                {
                                                                    "id": "740650137",
                                                                    "speaker": "Player",
                                                                    "text": "报酬一定很优厚吧，这忙我帮。"
                                                                },
                                                                {
                                                                    "id": "740650138",
                                                                    "speaker": "派蒙",
                                                                    "text": "喂！"
                                                                },
                                                                {
                                                                    "id": "740650139",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "哈哈，那当然是按规定发放。你们应该知道标准的，我也不会弄虚作假。"
                                                                },
                                                                {
                                                                    "id": "740650140",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "事情是这样，晶簇矿坑道那边有些原海异种…放任不管的话可能会造成危害，必须尽早处理。"
                                                                },
                                                                {
                                                                    "id": "740650141",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "我先把这家伙送去禁闭室，和同事交接大概会耽搁一会儿…手续办完了我会尽快和你们会合的。"
                                                                },
                                                                {
                                                                    "id": "740650142",
                                                                    "speaker": "派蒙",
                                                                    "text": "好吧，那你可不要耽误太久。"
                                                                },
                                                                {
                                                                    "id": "740650143",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "我会尽快的，不过手续嘛…能不能快也不是我说了算。那边就拜托你们了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740650127",
                                                            "text": "这次还没有。",
                                                            "response": [
                                                                {
                                                                    "id": "740650128",
                                                                    "speaker": "莫普瓦",
                                                                    "text": "这次？"
                                                                },
                                                                {
                                                                    "id": "740650129",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…之前发生过一些事…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740650119",
                                            "text": "给你一百，你帮我干活，我还能赚。",
                                            "response": [
                                                {
                                                    "id": "740650120",
                                                    "speaker": "派蒙",
                                                    "text": "哇，你该不会就是这么打算的吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740650103",
                            "text": "我有不好的预感…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406502",
            "objective": "击退在晶簇矿坑道游荡的原海异种",
            "dialogues": []
        },
        {
            "id": "7406503",
            "objective": "向莫普瓦回报",
            "dialogues": [
                {
                    "id": "740650301",
                    "speaker": "派蒙",
                    "text": "你怎么才来呀，那些原海异种都被我们赶走啦。"
                },
                {
                    "id": "740650302",
                    "speaker": "莫普瓦",
                    "text": "这么说来，终于让我赶上一回。"
                },
                {
                    "id": "740650303",
                    "speaker": "派蒙",
                    "text": "赶上一回？"
                },
                {
                    "id": "740650304",
                    "speaker": "莫普瓦",
                    "text": "那当然是等我到现场的时候，发现工作已经全都由别人完成了。我呢？我什么也不用做。"
                },
                {
                    "id": "740650305",
                    "speaker": "莫普瓦",
                    "text": "这是给你们的。真是多谢你们了，今晚我能睡个好觉了！"
                }
            ]
        }
    ]
}