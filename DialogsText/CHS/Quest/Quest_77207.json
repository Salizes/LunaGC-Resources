            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772070101",
                    "speaker": "万尼亚",
                    "text": "呼呼…火水…哼，再来一杯…我、我还可以喝…"
                },
                {
                    "id": "772070102",
                    "speaker": "派蒙",
                    "text": "唔，怎么还有喝醉酒倒在地上的家伙，这不是把路都挡住了…"
                },
                {
                    "id": "772070103",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，得想办法把他叫醒才行…说不定用点元素力，或者其他更直接的办法？",
                    "choices": [
                        {
                            "id": "772070104",
                            "text": "（用风元素唤醒…）",
                            "response": [
                                {
                                    "id": "772070105",
                                    "speaker": "万尼亚",
                                    "text": "哇…哈，你们是谁，我、咦，我怎么在这里？"
                                },
                                {
                                    "id": "772070108",
                                    "speaker": "派蒙",
                                    "text": "你喝醉酒，倒在路上啦！"
                                },
                                {
                                    "id": "772070109",
                                    "speaker": "万尼亚",
                                    "text": "唔，好险好险，要是就这样躺在路上，一定会得感冒…谢谢你们…"
                                }
                            ]
                        },
                        {
                            "id": "772070106",
                            "text": "（轻拍对方的脸…）",
                            "response": [
                                {
                                    "id": "772070107",
                                    "speaker": "万尼亚",
                                    "text": "哇…哈，你们是谁，我、咦，我怎么在这里？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7720702",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772070201",
                    "speaker": "万尼亚",
                    "text": "哼哼…看我的…我只要一拳，一拳…"
                },
                {
                    "id": "772070202",
                    "speaker": "派蒙",
                    "text": "怎么又有喝醉酒躺在这挡路的家伙，等等，这不就是上次的那个醉汉吗！"
                },
                {
                    "id": "772070203",
                    "speaker": "派蒙",
                    "text": "就像上次一样叫醒他吧…用点元素力，或者稍微拍拍他！",
                    "choices": [
                        {
                            "id": "772070204",
                            "text": "（用水元素唤醒…）",
                            "response": [
                                {
                                    "id": "772070205",
                                    "speaker": "万尼亚",
                                    "text": "…唔，怎么回事，头…头有点晕，唔…"
                                },
                                {
                                    "id": "772070208",
                                    "speaker": "派蒙",
                                    "text": "你又喝醉酒，倒在地上了！"
                                },
                                {
                                    "id": "772070209",
                                    "speaker": "万尼亚",
                                    "text": "嘿嘿，是嘛…真是不好意思，唔，谢谢你们，不然又要被巡逻的冬契军骂了…"
                                }
                            ]
                        },
                        {
                            "id": "772070206",
                            "text": "（重拍对方的脸…）",
                            "response": [
                                {
                                    "id": "772070207",
                                    "speaker": "万尼亚",
                                    "text": "…唔，怎么回事，头…头有点晕，唔…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7720703",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772070301",
                    "speaker": "万尼亚",
                    "text": "哎呀，祖奶奶…祖奶奶，我好想你…"
                },
                {
                    "id": "772070302",
                    "speaker": "派蒙",
                    "text": "哇已经第三次了…真是有点见怪不怪了。"
                },
                {
                    "id": "772070303",
                    "speaker": "派蒙",
                    "text": "就像上次一样叫醒他吧…用点元素力，或者拍拍他，或者让我来把他叫醒！",
                    "choices": [
                        {
                            "id": "772070304",
                            "text": "还是我来吧。",
                            "response": [
                                {
                                    "id": "772070305",
                                    "speaker": "派蒙",
                                    "text": "好吧，那还是交给你了。",
                                    "choices": [
                                        {
                                            "id": "772070306",
                                            "text": "（用雷元素唤醒…）",
                                            "response": [
                                                {
                                                    "id": "772070307",
                                                    "speaker": "万尼亚",
                                                    "text": "哇，我好像看到了，看到了很奇怪的景象…咦，是你们，哈哈，看来我又喝多了！"
                                                },
                                                {
                                                    "id": "772070314",
                                                    "speaker": "派蒙",
                                                    "text": "已经三次了！再看到你，我们就要告诉运输局，或者冬契军啦！"
                                                },
                                                {
                                                    "id": "772070315",
                                                    "speaker": "万尼亚",
                                                    "text": "哎哎…别，有话好好说嘛。"
                                                },
                                                {
                                                    "id": "772070316",
                                                    "speaker": "派蒙",
                                                    "text": "那就得看你表现如何了。"
                                                },
                                                {
                                                    "id": "772070317",
                                                    "speaker": "万尼亚",
                                                    "text": "好吧…我、我下次克制一点，不喝那么多了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "772070308",
                                            "text": "（狠狠拍了对方的脸…）",
                                            "response": [
                                                {
                                                    "id": "772070309",
                                                    "speaker": "万尼亚",
                                                    "text": "哇，我好像看到了，看到了很奇怪的景象…咦，是你们，哈哈，看来我又喝多了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
