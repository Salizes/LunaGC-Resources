    "talks": [
        {
            "id": "7452401",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745240101",
                    "speaker": "八重神子",
                    "text": "如何？八重宫司大人的美貌，有好好地收录进你的镜头里吗？"
                }
            ]
        },
        {
            "id": "7452402",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "745240201",
                    "speaker": "Player",
                    "text": "我们继续留影吧！"
                }
            ]
        },
        {
            "id": "7452403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745240301",
                    "speaker": "Player",
                    "text": "请稍等，我再构思一下。"
                }
            ]
        },
        {
            "id": "7452404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745240401",
                    "speaker": "八重神子",
                    "text": "哎呀，这不是小家伙吗？难道是打听到了我今天的行程，特意来这里见我？",
                    "choices": [
                        {
                            "id": "745240402",
                            "text": "神子刚去见过将军吗？",
                            "response": [
                                {
                                    "id": "745240404",
                                    "speaker": "八重神子",
                                    "text": "呵呵，鼻子还挺灵。不过是给某位不爱出门的友人带了些甜点，和时下最热门的轻小说罢了。"
                                },
                                {
                                    "id": "745240405",
                                    "speaker": "Player",
                                    "text": "影也开始追更了？"
                                },
                                {
                                    "id": "745240406",
                                    "speaker": "八重神子",
                                    "text": "她的说法是，想借此了解稻妻民众近来的娱乐生活和喜好变化。"
                                },
                                {
                                    "id": "745240407",
                                    "speaker": "八重神子",
                                    "text": "刚才，她还和我讨论了一番呢。一开始，她还只是一本正经地分析故事内容所体现出的读者偏好…"
                                },
                                {
                                    "id": "745240408",
                                    "speaker": "八重神子",
                                    "text": "…可说着说着，就忽然很在意地问我：「所以，那个角色最后的结局究竟如何？」"
                                },
                                {
                                    "id": "745240409",
                                    "speaker": "八重神子",
                                    "text": "呵呵，看来就算是影，也难免会被精彩的故事所吸引呢。",
                                    "choices": [
                                        {
                                            "id": "745240410",
                                            "text": "神子刚才的表情…",
                                            "response": [
                                                {
                                                    "id": "745240412",
                                                    "speaker": "八重神子",
                                                    "text": "哦？所以这才是你今天真正的来意吗？"
                                                },
                                                {
                                                    "id": "745240413",
                                                    "speaker": "八重神子",
                                                    "text": "我知道了。一定是小家伙在旅途中时常会思念我，所以想要拍些画片留作念想，对吧？"
                                                },
                                                {
                                                    "id": "745240414",
                                                    "speaker": "八重神子",
                                                    "text": "那就交给你了。可要用心挑选角度哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745240411",
                                            "text": "非常值得被记录下来。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745240403",
                            "text": "我闻到了一股甜味…"
                        }
                    ]
                }
            ]
        }
    ]
}