    "talks": [
        {
            "id": "7150404",
            "objective": "等到一天后",
            "dialogues": []
        },
        {
            "id": "7150401",
            "objective": "与胡塞尼对话",
            "dialogues": [
                {
                    "id": "715040101",
                    "speaker": "胡塞尼",
                    "text": "咳咳…"
                },
                {
                    "id": "715040102",
                    "speaker": "派蒙",
                    "text": "胡塞尼，你怎么了？"
                },
                {
                    "id": "715040103",
                    "speaker": "胡塞尼",
                    "text": "之前在矿道处为了想出将「普尔希娜光钉」搬运到地脉喷口的办法，在矿道逗留了太久，受到了一些影响。"
                },
                {
                    "id": "715040104",
                    "speaker": "胡塞尼",
                    "text": "不过没什么大碍，休息了一会儿以后，已经恢复很多了。"
                },
                {
                    "id": "715040105",
                    "speaker": "胡塞尼",
                    "text": "与此同时，我也已经想出了解决方案，只是找一个搬运「普尔希娜光钉」的办法，还能比找一个拖延交研究报告的借口困难？"
                },
                {
                    "id": "715040106",
                    "speaker": "胡塞尼",
                    "text": "黑泥覆盖了地面，那就稍微浮空一点，用热气球在矿道进行搬运不就行了。"
                },
                {
                    "id": "715040107",
                    "speaker": "派蒙",
                    "text": "这么一说，热气球确实还算是不错的方法。"
                },
                {
                    "id": "715040108",
                    "speaker": "胡塞尼",
                    "text": "当然，这样虽然可以一定程度上解决了黑泥的问题，但是存在过量黑泥淤塞通道的时候，也还是会影响热气球的前进。"
                },
                {
                    "id": "715040109",
                    "speaker": "胡塞尼",
                    "text": "以及，黑泥周围还会有引来的怪物…"
                },
                {
                    "id": "715040110",
                    "speaker": "胡塞尼",
                    "text": "这些恐怕就得交给你们解决了。"
                },
                {
                    "id": "715040111",
                    "speaker": "派蒙",
                    "text": "#放心吧，我和{NICKNAME}联手，一定能把那些靠近热气球的怪物统统打跑。",
                    "choices": [
                        {
                            "id": "715040112",
                            "text": "待会儿主要看你。",
                            "response": [
                                {
                                    "id": "715040114",
                                    "speaker": "派蒙",
                                    "text": "我、我主要是在旁边负责给你加油打气嘛…"
                                },
                                {
                                    "id": "715040115",
                                    "speaker": "胡塞尼",
                                    "text": "哈哈哈呃咳、咳咳…咳咳…"
                                },
                                {
                                    "id": "715040116",
                                    "speaker": "胡塞尼",
                                    "text": "这么笑了一下就咳得那么厉害…总之老图和阿昊在帮忙打包「普尔希娜光钉」，做热气球的准备。"
                                },
                                {
                                    "id": "715040117",
                                    "speaker": "胡塞尼",
                                    "text": "本来我想亲手做「普尔希娜光钉」的打包的，可就多站了一会儿，咳嗽咳得手都发抖了。"
                                },
                                {
                                    "id": "715040118",
                                    "speaker": "胡塞尼",
                                    "text": "真是惭愧，看来以后不仅要做学术研究，还得注意锻炼一下身体。"
                                },
                                {
                                    "id": "715040119",
                                    "speaker": "胡塞尼",
                                    "text": "你快点去找他们吧。"
                                }
                            ]
                        },
                        {
                            "id": "715040113",
                            "text": "我手上这把剑就暂借你一下。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7150402",
            "objective": "与老图对话",
            "dialogues": [
                {
                    "id": "715040201",
                    "speaker": "老图",
                    "text": "#嘿，{NICKNAME}，我们这刚打包好你就下来了。"
                },
                {
                    "id": "715040202",
                    "speaker": "老图",
                    "text": "那个须弥佬已经跟你说了吧，要用这个热气球。"
                },
                {
                    "id": "715040203",
                    "speaker": "阿昊",
                    "text": "什么叫「须弥佬」啊，胡塞尼可是来帮我们处理这些黑泥的，须弥的大学者，你就不能尊重别人一点嘛！"
                },
                {
                    "id": "715040204",
                    "speaker": "老图",
                    "text": "你、你懂什么，这种称呼也是一种表示熟络的方式。"
                },
                {
                    "id": "715040205",
                    "speaker": "阿昊",
                    "text": "行了，热气球也确定能够使用，清理黑泥用的仪器也都准备好了…"
                },
                {
                    "id": "715040206",
                    "speaker": "老图",
                    "text": "#{NICKNAME}，如果你需要挖矿巨星我的帮忙…咳咳…咳咳…算了，我估计也帮不上什么忙。"
                },
                {
                    "id": "715040207",
                    "speaker": "阿昊",
                    "text": "知道就好，你还是好好休息着吧。"
                },
                {
                    "id": "715040208",
                    "speaker": "老图",
                    "text": "唉，总之，你要是打算开始搬运，启动热气球就行。"
                }
            ]
        },
        {
            "id": "7150403",
            "objective": "启动热气球进行「光钉」的运输",
            "dialogues": []
        },
        {
            "id": "7150405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715040501",
                    "speaker": "胡塞尼",
                    "text": "希望用热气球搬运「普尔希娜光钉」能够成功。"
                }
            ]
        }
    ]
}