    "talks": [
        {
            "id": "7510308",
            "objective": "",
            "dialogues": [
                {
                    "id": "751030801",
                    "speaker": "派蒙",
                    "text": "哇，好多鱼肉！"
                },
                {
                    "id": "751030802",
                    "speaker": "帕尼娅",
                    "text": "#啊，不可以乱动喔，金发的{M#大哥哥}{F#大姐姐}！那些是用来吸引浮流鸟的啦！"
                },
                {
                    "id": "751030803",
                    "speaker": "派蒙",
                    "text": "呃，吸引浮流鸟？"
                },
                {
                    "id": "751030804",
                    "speaker": "帕尼娅",
                    "text": "是呀，我和伊瓦伊正在等这些浮流鸟上岸呢。反正也没有什么别的事情好做嘛。"
                },
                {
                    "id": "751030805",
                    "speaker": "伊瓦伊",
                    "text": "呜，呜呜！"
                },
                {
                    "id": "751030806",
                    "speaker": "帕尼娅",
                    "text": "好啦好啦，伊瓦伊是乖孩子，对吧？要有耐心，不可以着急喔。"
                },
                {
                    "id": "751030807",
                    "speaker": "伊瓦伊",
                    "text": "呜…"
                },
                {
                    "id": "751030808",
                    "speaker": "帕尼娅",
                    "text": "总之，我们本来打算来这里玩。毕竟除了朗戈叔叔以外，平时一般不会有人到这里来，所以这就是我们的秘密基地——之类的吧？"
                },
                {
                    "id": "751030809",
                    "speaker": "帕尼娅",
                    "text": "结果没想到，今天反而被这些浮流鸟占去先机啦。"
                },
                {
                    "id": "751030810",
                    "speaker": "帕尼娅",
                    "text": "所以呢，我就准备了这些鱼肉，打算把浮流鸟们吸引过来。浮流鸟可是很喜欢吃鱼肉的喔！",
                    "choices": [
                        {
                            "id": "751030811",
                            "text": "但浮流鸟好像并没有被吸引过来？",
                            "response": [
                                {
                                    "id": "751030816",
                                    "speaker": "帕尼娅",
                                    "text": "是呀，可能是因为距离太远了，没闻到鱼肉的气味吧？要是能想办法先把它们引到岸上来的话…"
                                },
                                {
                                    "id": "751030817",
                                    "speaker": "帕尼娅",
                                    "text": "哎，要是朗戈叔叔的话，估计会说<color=#00E1FFFF>「只要把它们撞上岸就好！」</color>之类的吧…可惜，我和伊瓦伊力气太小，只会被反过来撞飞啦。"
                                },
                                {
                                    "id": "751030818",
                                    "speaker": "派蒙",
                                    "text": "#嗯…{NICKNAME}，要不然我们来试试看吧？如果把浮流鸟引到岸上来的话，说不定它们就会被鱼肉吸引啦！"
                                }
                            ]
                        },
                        {
                            "id": "751030812",
                            "text": "原来如此，派蒙其实也是浮流鸟…",
                            "response": [
                                {
                                    "id": "751030813",
                                    "speaker": "帕尼娅",
                                    "text": "圆滚滚的，喜欢吃鱼肉…原来如此，的确是浮流鸟呢。"
                                },
                                {
                                    "id": "751030814",
                                    "speaker": "伊瓦伊",
                                    "text": "嗯，嗯！"
                                },
                                {
                                    "id": "751030815",
                                    "speaker": "派蒙",
                                    "text": "才不是呢！话说回来，这些浮流鸟不是完全没被吸引过来嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
