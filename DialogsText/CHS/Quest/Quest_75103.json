        },
        {
            "id": "7510304",
            "objective": "（test）企鹅全上岸判定$HIDDEN",
            "dialogues": [
                {
                    "id": "751030401",
                    "speaker": "帕尼娅",
                    "text": "#谢谢你，{M#大哥哥}{F#大姐姐}！浮流鸟们都被鱼肉吸引住了，我也可以和伊瓦伊一起玩啦。"
                },
                {
                    "id": "751030402",
                    "speaker": "伊瓦伊",
                    "text": "呜，呜！",
                    "choices": [
                        {
                            "id": "751030403",
                            "text": "能帮上忙就好。",
                            "response": [
                                {
                                    "id": "751030406",
                                    "speaker": "帕尼娅",
                                    "text": "#那就再见啦，好心的{M#大哥哥}{F#大姐姐}！要是下次有时间的话，也可以来找我一起玩喔！"
                                }
                            ]
                        },
                        {
                            "id": "751030404",
                            "text": "派蒙似乎也被鱼肉吸引住了…",
                            "response": [
                                {
                                    "id": "751030405",
                                    "speaker": "派蒙",
                                    "text": "才、才没有这回事！不管怎么说我也不会被没做成料理的食材吸引住…嗯，绝对不会！"
                                }
                            ]
                        }
                    ]
