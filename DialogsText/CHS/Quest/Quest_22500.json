            "title": ""
        },
        "total_dialogue_lines": 75,
        "total_speaker_counts": {
            "Player": 18,
            "璐璐": 21,
            "莺儿": 36
        }
    },
    "talks": [
        {
            "id": "2250001",
            "objective": "与璐璐对话",
            "dialogues": [
                {
                    "id": "225000101",
                    "speaker": "璐璐",
                    "text": "什么时候才能做好呢…"
                },
                {
                    "id": "225000102",
                    "speaker": "Player",
                    "text": "今天没玩游戏吗？"
                },
                {
                    "id": "225000103",
                    "speaker": "璐璐",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你呀，最近不适合玩游戏呢。"
                },
                {
                    "id": "225000104",
                    "speaker": "璐璐",
                    "text": "小蒙好像有点不开心，老是一个人发呆，阿飞也时不时就找不到人了。"
                },
                {
                    "id": "225000105",
                    "speaker": "璐璐",
                    "text": "我问小蒙怎么了，小蒙也不和我说…总觉得，大家最近都有点奇怪。",
                    "choices": [
                        {
                            "id": "225000106",
                            "text": "长大了就会这样。",
                            "response": [
                                {
                                    "id": "225000107",
                                    "speaker": "璐璐",
                                    "text": "人长大了，就会不开心吗？但是小蒙和阿飞都很想长大…"
                                },
                                {
                                    "id": "225000108",
                                    "speaker": "璐璐",
                                    "text": "如果是这样的话，那我还是先不长大比较好。"
                                },
                                {
                                    "id": "225000109",
                                    "speaker": "璐璐",
                                    "text": "#先不说这个了，我有点小事，想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。"
                                },
                                {
                                    "id": "225000112",
                                    "speaker": "璐璐",
                                    "text": "你能帮我去莺儿姐姐那里拿点东西吗？我和她已经说好了，那里应该已经把东西留给我了。",
                                    "choices": [
                                        {
                                            "id": "225000113",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "225000114",
                                                    "speaker": "璐璐",
                                                    "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "225000115",
                                            "text": "从莺儿那里…",
                                            "response": [
                                                {
                                                    "id": "225000116",
                                                    "speaker": "璐璐",
                                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}可不要瞎想喔，我只是拜托莺儿姐姐帮忙做了点东西而已。"
                                                },
                                                {
                                                    "id": "225000117",
                                                    "speaker": "璐璐",
                                                    "text": "#总之，就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "225000110",
                            "text": "你也不开心吗？",
                            "response": [
                                {
                                    "id": "225000111",
                                    "speaker": "璐璐",
                                    "text": "#我？我还好喔，不过…还是有点小事想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2250002",
            "objective": "与莺儿对话",
            "dialogues": [
                {
                    "id": "225000301",
                    "speaker": "Player",
                    "text": "三千摩拉够了吗？"
                },
                {
                    "id": "225000302",
                    "speaker": "莺儿",
                    "text": "你可真是个急性子…好吧，就当看在我们情谊的份儿上，我会先做璐璐的那份香膏的。"
                },
                {
                    "id": "225000303",
                    "speaker": "莺儿",
                    "text": "不过，白天我还得看店，只有晚上才能做些私事。"
                },
                {
                    "id": "225000304",
                    "speaker": "莺儿",
                    "text": "请你晚上再来找我吧，我会先把准备工作做好的。"
                }
            ]
        },
        {
            "id": "2250003",
            "objective": "等待夜晚降临",
            "dialogues": []
        },
        {
            "id": "2250004",
            "objective": "与莺儿对话取得香膏",
            "dialogues": [
                {
                    "id": "225000501",
                    "speaker": "莺儿",
                    "text": "香膏已经做好了，是我用薄荷精油特别制作的喔。"
                },
                {
                    "id": "225000502",
                    "speaker": "莺儿",
                    "text": "来，拿好了，带回去给璐璐吧。",
                    "choices": [
                        {
                            "id": "225000503",
                            "text": "我知道了。"
                        },
                        {
                            "id": "225000504",
                            "text": "为什么是薄荷精油？",
                            "response": [
                                {
                                    "id": "225000505",
                                    "speaker": "莺儿",
                                    "text": "稀释一些刺激性的成分…略微中和一下气味…"
                                },
                                {
                                    "id": "225000506",
                                    "speaker": "莺儿",
                                    "text": "话说回来，当时也真是没想到会收到璐璐的订单呢。"
                                },
                                {
                                    "id": "225000507",
                                    "speaker": "莺儿",
                                    "text": "情窦初开的年纪，回想一下真是令人脸红心跳啊，要是当时懂得再多一点的话…"
                                },
                                {
                                    "id": "225000508",
                                    "speaker": "莺儿",
                                    "text": "咳…好了，快点拿回去给璐璐吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2250005",
            "objective": "寻找三株薄荷",
            "dialogues": []
        },
        {
            "id": "2250006",
            "objective": "合成薄荷精油",
            "dialogues": [
                {
                    "id": "225000601",
                    "speaker": "璐璐",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你拿到香膏了吗？"
                },
                {
                    "id": "225000602",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "225000603",
                    "speaker": "璐璐",
                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，莺儿姐姐做的香膏可真好。"
                },
                {
                    "id": "225000604",
                    "speaker": "璐璐",
                    "text": "不知道小蒙和阿飞闻到了之后会是什么反应…"
                },
                {
                    "id": "225000605",
                    "speaker": "璐璐",
                    "text": "不过，不管他们是什么反应，应该都很好玩吧。",
                    "choices": [
                        {
                            "id": "225000606",
                            "text": "他们会喜欢的。",
                            "response": [
                                {
                                    "id": "225000607",
                                    "speaker": "璐璐",
                                    "text": "这样就最好啦。"
                                },
                                {
                                    "id": "225000610",
                                    "speaker": "璐璐",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我等会就回家试试看这盒香膏。"
                                },
                                {
                                    "id": "225000611",
                                    "speaker": "璐璐",
                                    "text": "如果合适的话，那我就可以一直用下去啦。"
                                }
                            ]
                        },
                        {
                            "id": "225000608",
                            "text": "你最喜欢和谁玩？",
                            "response": [
                                {
                                    "id": "225000609",
                                    "speaker": "璐璐",
                                    "text": "唔？没有「最喜欢」喔，小蒙和阿飞，都是我最好的朋友。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2250007",
            "objective": "等待莺儿熬制香膏",
            "dialogues": []
        },
        {
            "id": "2250008",
            "objective": "与莺儿交谈",
            "dialogues": [
                {
                    "id": "225001201",
                    "speaker": "莺儿",
                    "text": "完成了，这就是我专门给璐璐制作的薄荷香膏了，赶紧拿回去给她吧。",
                    "choices": [
                        {
                            "id": "225001202",
                            "text": "我知道了。"
                        },
                        {
                            "id": "225001203",
                            "text": "璐璐要这个来做什么…",
                            "response": [
                                {
                                    "id": "225001204",
                                    "speaker": "莺儿",
                                    "text": "这我可不知道，我也不会去问璐璐。"
                                },
                                {
                                    "id": "225001205",
                                    "speaker": "莺儿",
                                    "text": "每个女孩子的心底都会有一些自己的小秘密的，要做识趣的人才能招人喜欢呀。"
                                },
                                {
                                    "id": "225001206",
                                    "speaker": "莺儿",
                                    "text": "好了，快点把薄荷香膏带回去给璐璐吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2250009",
            "objective": "把香膏交给璐璐",
            "dialogues": []
        },
        {
            "id": "2250010",
            "objective": "",
            "dialogues": [
                {
                    "id": "225000801",
                    "speaker": "莺儿",
                    "text": "急什么呀，心急可吃不了热豆腐。"
                }
            ]
        },
        {
            "id": "2250002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225000201",
                    "speaker": "莺儿",
                    "text": "哎呀，又是你，这次来找我是想做什么呢？"
                },
                {
                    "id": "225000202",
                    "speaker": "Player",
                    "text": "来取璐璐的东西。"
                },
                {
                    "id": "225000203",
                    "speaker": "莺儿",
                    "text": "那孩子的东西啊…我记起来了，她确实让我帮她做一份香膏…"
                },
                {
                    "id": "225000204",
                    "speaker": "莺儿",
                    "text": "不过，你们来得有些不巧…不知道为什么，自从那天你们来找我之后，突然有很多人来找我预定香膏。"
                },
                {
                    "id": "225000205",
                    "speaker": "莺儿",
                    "text": "那么多订单，我还得打理店里的生意，一个人都要处理不来了。"
                },
                {
                    "id": "225000206",
                    "speaker": "莺儿",
                    "text": "而且璐璐还是个孩子，平常我们大人用的香膏如果直接给她用的话，未免有些不太合适。"
                },
                {
                    "id": "225000207",
                    "speaker": "莺儿",
                    "text": "我之前在想怎么调整香膏的配方，才刚刚想出个方案来，还没开始做呢。"
                },
                {
                    "id": "225000208",
                    "speaker": "莺儿",
                    "text": "如果要加急的话，倒也不是不行，可是…"
                }
            ]
        },
        {
            "id": "2250004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225000401",
                    "speaker": "Player",
                    "text": "我来帮你。"
                },
                {
                    "id": "225000402",
                    "speaker": "莺儿",
                    "text": "嗯，这样也好，你在这种事上的丰富经验…我再清楚不过了，呵呵。"
                },
                {
                    "id": "225000403",
                    "speaker": "莺儿",
                    "text": "我这边还有之前没用完的原料，我会去卯师傅的厨房处理一下。"
                },
                {
                    "id": "225000404",
                    "speaker": "莺儿",
                    "text": "你先去采三株薄荷，再把薄荷拿到合成台上去制成精油吧，制作的手法你应该很了解了吧？"
                },
                {
                    "id": "225000405",
                    "speaker": "莺儿",
                    "text": "把薄荷精油拿给我，我来帮忙把璐璐的香膏做好。"
                }
            ]
        },
        {
            "id": "2250009",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225000901",
                    "speaker": "Player",
                    "text": "三千摩拉够了吗？"
                },
                {
                    "id": "225000903",
                    "speaker": "莺儿",
                    "text": "唔，你身上的钱好像不够呢。"
                }
            ]
        },
        {
            "id": "2250010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225001001",
                    "speaker": "莺儿",
                    "text": "记住了，是薄荷精油哦。",
                    "choices": [
                        {
                            "id": "225001002",
                            "text": "薄荷精油怎么做…",
                            "response": [
                                {
                                    "id": "225001003",
                                    "speaker": "莺儿",
                                    "text": "你已经全忘了？哼，明明之前才一起做过，居然忘得这么快…"
                                },
                                {
                                    "id": "225001004",
                                    "speaker": "莺儿",
                                    "text": "我再教你一次好了，先去采三株薄荷，再把薄荷拿到合成台上制成精油。"
                                },
                                {
                                    "id": "225001005",
                                    "speaker": "莺儿",
                                    "text": "把精油拿回来给我，其余的就交给我吧。"
                                }
                            ]
                        },
                        {
                            "id": "225001006",
                            "text": "薄荷精油有什么用…",
                            "response": [
                                {
                                    "id": "225001007",
                                    "speaker": "莺儿",
                                    "text": "嗯…主要是中和一些刺激性的成分…"
                                },
                                {
                                    "id": "225001008",
                                    "speaker": "莺儿",
                                    "text": "不过，最重要的还是，薄荷的味道很适合璐璐这孩子。"
                                },
                                {
                                    "id": "225001009",
                                    "speaker": "莺儿",
                                    "text": "女孩子的香味可不应该仅仅是一种闻起来的味道而已…"
                                },
                                {
                                    "id": "225001010",
                                    "speaker": "莺儿",
                                    "text": "璐璐动人的活力，涉世未深的清纯，我会将它们都融进这一盒香膏中，呵呵。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2250011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225001101",
                    "speaker": "莺儿",
                    "text": "薄荷的味道，应该很适合那孩子吧。"
                }
            ]
        },
        {
            "id": "2250013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225001301",
                    "speaker": "莺儿",
                    "text": "虽然不知道璐璐为什么要香膏…不过，那孩子也在长大呢。"
                }
            ]
        },
        {
            "id": "2250014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "225001401",
                    "speaker": "璐璐",
                    "text": "小蒙和阿飞，到底怎么了呢…"
                }
            ]
        }
    ]
}