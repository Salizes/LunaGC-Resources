{
    "quest": {
        "id": "22500",
        "title": "成长的烦恼",
        "description": "璐璐最近有些不开心，似乎正在因为某事而烦恼着…",
        "rewards": [
            {
                "itemId": 202,
                "count": 400
            },
            {
                "itemId": 100029,
                "count": 1
            }
        ],
        "rewards_formatted": "摩拉 x400, 霓裳花 x1",
        "chapter": {
            "icon": "",
