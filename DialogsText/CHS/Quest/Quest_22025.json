    "talks": [
        {
            "id": "2202501",
            "objective": "与汤雯对话",
            "dialogues": [
                {
                    "id": "220250101",
                    "speaker": "汤雯",
                    "text": "啊...好饿...好难受…"
                },
                {
                    "id": "220250102",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "220250103",
                    "speaker": "汤雯",
                    "text": "我、我也不太清楚…总之就是整个人都不太精神。"
                },
                {
                    "id": "220250104",
                    "speaker": "汤雯",
                    "text": "大概就是昨天晚上，我把你做的那份美食带回家好好品尝了一番。"
                },
                {
                    "id": "220250105",
                    "speaker": "汤雯",
                    "text": "虽然那道菜的口味确实是…「另辟蹊径」了些，但多少还是能填饱肚子…"
                },
                {
                    "id": "220250106",
                    "speaker": "汤雯",
                    "text": "之后我就打算睡个好觉，今天好好工作，结果…结果…"
                },
                {
                    "id": "220250107",
                    "speaker": "汤雯",
                    "text": "每次我要睡着的时候，那道菜的微妙气味就突然从胃里反上来！搞得我瞬间就清醒了。"
                },
                {
                    "id": "220250108",
                    "speaker": "汤雯",
                    "text": "然后就是这样的循环，一直半睡半醒地折腾到天亮…"
                },
                {
                    "id": "220250109",
                    "speaker": "汤雯",
                    "text": "如果光是睡少一些，倒还不是什么大事，之前偶尔也会遇到加班加点的情况…"
                },
                {
                    "id": "220250110",
                    "speaker": "汤雯",
                    "text": "关键是今天！本以为起来后，吃点东西就没事了，可没想到一吃东西，居然满嘴都还是那道菜的味道…"
                },
                {
                    "id": "220250111",
                    "speaker": "Player",
                    "text": "那道菜有这么大威力吗…"
                },
                {
                    "id": "220250112",
                    "speaker": "汤雯",
                    "text": "唉，不管怎么样，我现在感觉…应该只有口味独特的美食，才能冲刷掉那股奇怪的气息了…"
                },
                {
                    "id": "220250113",
                    "speaker": "派蒙",
                    "text": "口味独特的美食？不如我们去问问其他人，什么才是口味独特的美食吧？"
                },
                {
                    "id": "220250114",
                    "speaker": "派蒙",
                    "text": "然后再给汤雯小姐做一份…说不定就能解决她的困扰了！"
                },
                {
                    "id": "220250115",
                    "speaker": "汤雯",
                    "text": "真的吗？真是太好了，实在感谢你们！如果、如果方便的话，请去离岛问问…"
                },
                {
                    "id": "220250116",
                    "speaker": "汤雯",
                    "text": "我记得…离岛的商人李晓对美食就很有研究，还有楚瑜商行的秋月，她也算是半个美食家了！"
                }
            ]
        },
        {
            "id": "2202502",
            "objective": "问问李晓的意见",
            "dialogues": [
                {
                    "id": "220250201",
                    "speaker": "李晓",
                    "text": "什么事？啊…你说汤雯小姐啊。"
                },
                {
                    "id": "220250207",
                    "speaker": "李晓",
                    "text": "食欲不振...满嘴都是怪味...需要特别的美食才能拯救？"
                },
                {
                    "id": "220250202",
                    "speaker": "李晓",
                    "text": "居然遇到了这样的困难…确实有些棘手啊。"
                },
                {
                    "id": "220250203",
                    "speaker": "李晓",
                    "text": "不过依我看，倒不一定要特别名贵的菜，只要口感和风味独树一帜，再加上一些些的冲击力就足够了…"
                },
                {
                    "id": "220250204",
                    "speaker": "李晓",
                    "text": "所以我的建议是——绝云锅巴！既有独特的劲脆口感，又有猛烈的香辣力道…"
                },
                {
                    "id": "220250205",
                    "speaker": "李晓",
                    "text": "从当年在轻策庄第一次尝到绝云锅巴，已经过去十几年了，到现在我还时常想起它..."
                },
                {
                    "id": "220250206",
                    "speaker": "李晓",
                    "text": "我想如果是绝云锅巴的话，无论什么问题都会迎刃而解的吧。"
                }
            ]
        },
        {
            "id": "2202503",
            "objective": "问问秋月的意见",
            "dialogues": [
                {
                    "id": "220250301",
                    "speaker": "秋月",
                    "text": "什么事？欸…汤雯小姐吗？"
                },
                {
                    "id": "220250307",
                    "speaker": "秋月",
                    "text": "满嘴怪味，没有食欲，吃不下饭？"
                },
                {
                    "id": "220250302",
                    "speaker": "秋月",
                    "text": "真的是吃了不好的奇怪食物吗？没搞错吧？"
                },
                {
                    "id": "220250303",
                    "speaker": "秋月",
                    "text": "怎么听起来感觉更像是吃撑了不消化呢。唔，让我想想..."
                },
                {
                    "id": "220250304",
                    "speaker": "秋月",
                    "text": "算了，既然没法判断的话，就只有一道菜可以推荐了，那就是——腌笃鲜！"
                },
                {
                    "id": "220250305",
                    "speaker": "秋月",
                    "text": "口味咸鲜，肉质酥嫩，爽口开胃，最后还有一锅老汤帮助消食。嗯！真想现在就来一点啊。"
                },
                {
                    "id": "220250306",
                    "speaker": "秋月",
                    "text": "相信我，汤雯现在需要的就是腌笃鲜！"
                }
            ]
        },
        {
            "id": "2202504",
            "objective": "问问派蒙的意见",
            "dialogues": [
                {
                    "id": "220250401",
                    "speaker": "派蒙",
                    "text": "呜哇，得到了不同的答案呢，绝云锅巴和腌笃鲜，都是很特别的美味呀。"
                },
                {
                    "id": "220250402",
                    "speaker": "派蒙",
                    "text": "到底该做什么才好呢？好纠结！"
                },
                {
                    "id": "220250403",
                    "speaker": "Player",
                    "text": "派蒙觉得应该做什么呢？"
                },
                {
                    "id": "220250404",
                    "speaker": "派蒙",
                    "text": "欸？我吗？"
                },
                {
                    "id": "220250405",
                    "speaker": "派蒙",
                    "text": "这样的话...让我选的话…让我选的话…"
                },
                {
                    "id": "220250406",
                    "speaker": "派蒙",
                    "text": "我选烤吃虎鱼！"
                },
                {
                    "id": "220250407",
                    "speaker": "派蒙",
                    "text": "烤吃虎鱼一听很有勇气的样子，如果汤雯小姐吃掉这种勇气，一定能顺利解决现在的麻烦吧？",
                    "choices": [
                        {
                            "id": "220250408",
                            "text": "派蒙对吃还是很精通啊…",
                            "response": [
                                {
                                    "id": "220250410",
                                    "speaker": "派蒙",
                                    "text": "哎呀，所以说还是你来决定吧。",
                                    "choices": [
                                        {
                                            "id": "220250411",
                                            "text": "那就…美味的绝云锅巴！",
                                            "response": [
                                                {
                                                    "id": "220250414",
                                                    "speaker": "派蒙",
                                                    "text": "好嘞，那我们就赶紧做好这份美食，给汤雯小姐送去吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220250412",
                                            "text": "那就…美味的腌笃鲜！"
                                        },
                                        {
                                            "id": "220250413",
                                            "text": "那就…美味的烤吃虎鱼！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220250409",
                            "text": "吃虎鱼不是这么个说法吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2202505",
            "objective": "将美味的绝云锅巴送给汤雯",
            "dialogues": [
                {
                    "id": "220250501",
                    "speaker": "汤雯",
                    "text": "啊，你们回来了。"
                },
                {
                    "id": "220250502",
                    "speaker": "派蒙",
                    "text": "汤雯小姐，快看我们给你带来了什么？"
                },
                {
                    "id": "220250503",
                    "speaker": "汤雯",
                    "text": "欸？好独特的香气…"
                },
                {
                    "id": "220250504",
                    "speaker": "汤雯",
                    "text": "快！请让我尝一尝吧！"
                }
            ]
        },
        {
            "id": "2202506",
            "objective": "将美味的腌笃鲜送给汤雯",
            "dialogues": [
                {
                    "id": "220250601",
                    "speaker": "汤雯",
                    "text": "这、这味道…清脆的口感、浓郁的香气混合着丝丝辛辣…"
                },
                {
                    "id": "220250602",
                    "speaker": "汤雯",
                    "text": "嘴里的怪味也被冲洗得一干二净了。"
                },
                {
                    "id": "220250603",
                    "speaker": "汤雯",
                    "text": "太好吃了！没想到身在异国他乡，还能尝到这种美味…"
                },
                {
                    "id": "220250604",
                    "speaker": "汤雯",
                    "text": "这些是我的谢意，请不要推辞！"
                }
            ]
        },
        {
            "id": "2202507",
