    "talks": [
        {
            "id": "7609501",
            "objective": "寻回彩特琳德的失物并解放各区域",
            "dialogues": [
                {
                    "id": "760950101",
                    "speaker": "彩特琳德",
                    "text": "#{NICKNAME}、派蒙谢谢你们。在最后认识你们真幸运。"
                },
                {
                    "id": "760950102",
                    "speaker": "派蒙",
                    "text": "嘿嘿，没有啦。感觉你还是因为和我们在一起才卷进这些事情里的。"
                },
                {
                    "id": "760950103",
                    "speaker": "派蒙",
                    "text": "等等，什么叫最后？"
                },
                {
                    "id": "760950104",
                    "speaker": "彩特琳德",
                    "text": "虽然都是些高危冒险，不过见识到了很多神奇的东西。"
                },
                {
                    "id": "760950105",
                    "speaker": "彩特琳德",
                    "text": "也不赖。"
                },
                {
                    "id": "760950106",
                    "speaker": "派蒙",
                    "text": "彩特琳德你不要避重就轻啊。"
                },
                {
                    "id": "760950107",
                    "speaker": "彩特琳德",
                    "text": "有吗？"
                }
            ]
        },
        {
            "id": "7609512",
            "objective": "寻回彩特琳德的失物并解放各区域",
            "dialogues": []
        },
        {
            "id": "7609513",
            "objective": "寻回彩特琳德的失物并解放各区域",
            "dialogues": []
        },
        {
            "id": "7609511",
            "objective": "寻回彩特琳德的失物并解放各区域",
            "dialogues": []
        },
        {
            "id": "7609502",
            "objective": "前往柱殿中心",
            "dialogues": []
        },
        {
            "id": "7609503",
            "objective": "与伊斯托利亚对话",
            "dialogues": [
                {
                    "id": "760950301",
                    "speaker": "派蒙",
                    "text": "伊斯托利亚，现在三个区域基本都解放了。人也差不多都救出来了。"
                },
                {
                    "id": "760950302",
                    "speaker": "派蒙",
                    "text": "彩特琳德丢失的东西也都找回来了。"
                },
                {
                    "id": "760950303",
                    "speaker": "伊斯托利亚",
                    "text": "哦哦，太谢谢你们了。尼西里塔开眼之后的眼光真是不错啊。"
                },
                {
                    "id": "760950304",
                    "speaker": "派蒙",
                    "text": "现在该你说说，之前提到的去往上面的方法和代价了。"
                },
                {
                    "id": "760950305",
                    "speaker": "派蒙",
                    "text": "如果只是再来些小冒险或者花点小摩拉什么的，我派蒙是不怕的。"
                },
                {
                    "id": "760950306",
                    "speaker": "派蒙",
                    "text": "还有哦，我们要怎么把彩特琳德送下去啊。她的事情已经忙完了。"
                },
                {
                    "id": "760950307",
                    "speaker": "伊斯托利亚",
                    "text": "没问题。不过你们先休息一下吧。明天我会和你们详细解释的。"
                },
                {
                    "id": "760950308",
                    "speaker": "派蒙",
                    "text": "那好啊。可是这里没有床也没有吃的啊？"
                },
                {
                    "id": "760950309",
                    "speaker": "伊斯托利亚",
                    "text": "在这里欲望是止息的。你发现了吗？在这里这么久了你既不饿也不困。"
                },
                {
                    "id": "760950310",
                    "speaker": "派蒙",
                    "text": "哇，那我休息一天要怎么打发时间啊！"
                },
                {
                    "id": "760950311",
                    "speaker": "伊斯托利亚",
                    "text": "这里有纵贯历史的各种奇人异士，和他们聊天应该挺有趣的吧？"
                },
                {
                    "id": "760950312",
                    "speaker": "派蒙",
                    "text": "#那好吧。但是睡觉是我的基本权利，就算不困我也要趴在{NICKNAME}头上睡！"
                },
                {
                    "id": "760950313",
                    "speaker": "伊斯托利亚",
                    "text": "彩特琳德，等你休息好了，我想和你谈谈。就是我之前说的，需要时间想想的那件事。"
                },
                {
                    "id": "760950314",
                    "speaker": "伊斯托利亚",
                    "text": "你晚些来找我聊聊，好吗？"
                },
                {
                    "id": "760950315",
                    "speaker": "彩特琳德",
                    "text": "好的。"
                },
                {
                    "id": "760950316",
                    "speaker": "伊斯托利亚",
                    "text": "#{NICKNAME}和派蒙，你们休息好了的话。过来找我吧。"
                }
            ]
        },
        {
            "id": "7609506",
            "objective": "和大家聊聊$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7609505",
            "objective": "和大家聊聊",
            "dialogues": [
                {
                    "id": "760950501",
                    "speaker": "伊斯托利亚",
                    "text": "休息好了吗？感兴趣的人、有兴趣的话都聊过了吗？",
                    "choices": [
                        {
                            "id": "760950502",
                            "text": "还没。",
                            "response": [
                                {
                                    "id": "760950503",
                                    "speaker": "伊斯托利亚",
                                    "text": "好好休息吧。"
                                },
                                {
                                    "id": "760950506",
                                    "speaker": "伊斯托利亚",
                                    "text": "彩特琳德，你冷静一点听我说。我没有任何不尊重或者妄想。"
                                },
                                {
                                    "id": "760950507",
                                    "speaker": "伊斯托利亚",
                                    "text": "你的姐姐应该没有死。"
                                },
                                {
                                    "id": "760950508",
                                    "speaker": "彩特琳德",
                                    "text": "我都见到墓碑了。"
                                },
                                {
                                    "id": "760950509",
                                    "speaker": "彩特琳德",
                                    "text": "墓碑上甚至还有姐姐的照片。"
                                },
                                {
                                    "id": "760950510",
                                    "speaker": "伊斯托利亚",
                                    "text": "但是，墓碑下面也有可能是空的吧？"
                                },
                                {
                                    "id": "760950511",
                                    "speaker": "派蒙",
                                    "text": "虽然我也很希望彩特琳德姐姐没事。但是你这个猜测有点过于乐观了吧。"
                                },
                                {
                                    "id": "760950512",
                                    "speaker": "彩特琳德",
                                    "text": "我姐姐最后给我的信上写了，她决心要…"
                                },
                                {
                                    "id": "760950513",
                                    "speaker": "伊斯托利亚",
                                    "text": "她的告别，写的肯定不是她准备结束生命吧。"
                                },
                                {
                                    "id": "760950514",
                                    "speaker": "彩特琳德",
                                    "text": "她说她要去很远的地方了。"
                                },
                                {
                                    "id": "760950515",
                                    "speaker": "伊斯托利亚",
                                    "text": "她和我说过。她的理想是在老去之前，环游世界一次。"
                                },
                                {
                                    "id": "760950516",
                                    "speaker": "伊斯托利亚",
                                    "text": "希尔妲只是字面意思。她从疗养院离开，去环游世界了。"
                                },
                                {
                                    "id": "760950517",
                                    "speaker": "彩特琳德",
                                    "text": "她还和你说过这些啊。"
                                },
                                {
                                    "id": "760950518",
                                    "speaker": "伊斯托利亚",
                                    "text": "她一直很开朗，和大家相处得很愉快。"
                                },
                                {
                                    "id": "760950519",
                                    "speaker": "彩特琳德",
                                    "text": "那她一定没有和你说过，我们没有别的亲人了吧。"
                                },
                                {
                                    "id": "760950520",
                                    "speaker": "伊斯托利亚",
                                    "text": "这…"
                                },
                                {
                                    "id": "760950521",
                                    "speaker": "彩特琳德",
                                    "text": "我用最冷血的方式算算这件事吧。"
                                },
                                {
                                    "id": "760950522",
                                    "speaker": "彩特琳德",
                                    "text": "她的离开如果会让三个人、四个人伤心，那这份沉重或许会赢过她的哀愁。"
                                },
                                {
                                    "id": "760950523",
                                    "speaker": "彩特琳德",
                                    "text": "但是现在只剩下了我，而她知道，我理解她。我会原谅她的。"
                                },
                                {
                                    "id": "760950524",
                                    "speaker": "伊斯托利亚",
                                    "text": "不是这样的，不能这么算。"
                                },
                                {
                                    "id": "760950525",
                                    "speaker": "彩特琳德",
                                    "text": "不用那么怜悯。在我们的童年中，父母都还在，生活很幸福的。这些回忆足够支撑我们长大。"
                                },
                                {
                                    "id": "760950526",
                                    "speaker": "彩特琳德",
                                    "text": "可是，大人的世界，好艰难啊。"
                                },
                                {
                                    "id": "760950527",
                                    "speaker": "彩特琳德",
                                    "text": "我从小就更加内向，工作里与人打交道都格外耗费心神。我本以为外向的姐姐会如鱼得水。"
                                },
                                {
                                    "id": "760950528",
                                    "speaker": "彩特琳德",
                                    "text": "姐姐长大以后，脸上也常年挂着疲惫。"
                                },
                                {
                                    "id": "760950529",
                                    "speaker": "派蒙",
                                    "text": "唔…"
                                },
                                {
                                    "id": "760950530",
                                    "speaker": "伊斯托利亚",
                                    "text": "你们还有未来。"
                                },
                                {
                                    "id": "760950531",
                                    "speaker": "彩特琳德",
                                    "text": "哦，看来她也没有和你说她未婚夫的事情。"
                                },
                                {
                                    "id": "760950532",
                                    "speaker": "彩特琳德",
                                    "text": "一个普通的好人，一个有趣的好人。他为什么不是一个坏蛋呢？要是个恶人就好了啊。"
                                },
                                {
                                    "id": "760950533",
                                    "speaker": "彩特琳德",
                                    "text": "他家里有着短寿的遗传，好像是某种怪病。"
                                },
                                {
                                    "id": "760950534",
                                    "speaker": "彩特琳德",
                                    "text": "他也总是自嘲：都怪风神把蒙德规划得太好了，他家这种不应该延续的血脉都延续了下来。"
                                },
                                {
                                    "id": "760950535",
                                    "speaker": "彩特琳德",
                                    "text": "后来，他说他要去拯救世界，然后就走了。"
                                },
                                {
                                    "id": "760950536",
                                    "speaker": "彩特琳德",
                                    "text": "拯救世界。"
                                },
                                {
                                    "id": "760950537",
                                    "speaker": "彩特琳德",
                                    "text": "我们的世界现在还在运转，说不定真的是因为他在某个不起眼的角落拯救了世界吧。"
                                },
                                {
                                    "id": "760950538",
                                    "speaker": "彩特琳德",
                                    "text": "你们不是常说「永恒的生命如果不能去爱所有人，然后被所有人爱，世界会被悲哀淹没吗？」"
                                },
                                {
                                    "id": "760950539",
                                    "speaker": "彩特琳德",
                                    "text": "说得很有道理。短暂的生命就是不配去爱的。"
                                },
                                {
                                    "id": "760950540",
                                    "speaker": "彩特琳德",
                                    "text": "他想要用自己的生命去爱。结果只是让姐姐受伤更深。"
                                },
                                {
                                    "id": "760950541",
                                    "speaker": "彩特琳德",
                                    "text": "甚至让她住进了山里的疗养院。我们脚下这个，萦绕着诅咒的疗养院。"
                                },
                                {
                                    "id": "760950542",
                                    "speaker": "伊斯托利亚",
                                    "text": "她从没有和我说过这些。对不起。"
                                },
                                {
                                    "id": "760950543",
                                    "speaker": "彩特琳德",
                                    "text": "听了这些，你还要坚持姐姐依旧活着的论点吗？"
                                },
                                {
                                    "id": "760950544",
                                    "speaker": "伊斯托利亚",
                                    "text": "是的。因为她在这里，做了一件事情。"
                                },
                                {
                                    "id": "760950545",
                                    "speaker": "伊斯托利亚",
                                    "text": "因为我的怯懦，她不得不活下去。"
                                },
                                {
                                    "id": "760950546",
                                    "speaker": "彩特琳德",
                                    "text": "我很敬重您，伊斯托利亚。但是我觉得，或许你在历史长河里见过的苦难太多了。"
                                },
                                {
                                    "id": "760950547",
                                    "speaker": "彩特琳德",
                                    "text": "足以淹没世界好多次的悲伤之沙，只要一抔就可以盖住平凡如我的人生。"
                                },
                                {
                                    "id": "760950548",
                                    "speaker": "彩特琳德",
                                    "text": "您无法理解我和姐姐。"
                                },
                                {
                                    "id": "760950549",
                                    "speaker": "彩特琳德",
                                    "text": "请问，我该如何回到地上呢？我只是朝生暮死的小人物，不配得到永恒。"
                                },
                                {
                                    "id": "760950550",
                                    "speaker": "伊斯托利亚",
                                    "text": "唉…"
                                },
                                {
                                    "id": "760950551",
                                    "speaker": "彩特琳德",
                                    "text": "伊斯托利亚先生？"
                                },
                                {
                                    "id": "760950552",
                                    "speaker": "伊斯托利亚",
                                    "text": "原先此处天地不通，我们是绝无可能离开的。"
                                },
                                {
                                    "id": "760950553",
                                    "speaker": "伊斯托利亚",
                                    "text": "但尼西里塔堕天之后，小右似乎有能力带你们现世之人来往柱殿与地面。"
                                },
                                {
                                    "id": "760950554",
                                    "speaker": "伊斯托利亚",
                                    "text": "但是它是无法带走蒙选上来的人，因为它就是守望者的幼体。这是深埋在它体内的规则。"
                                },
                                {
                                    "id": "760950555",
                                    "speaker": "派蒙",
                                    "text": "什么？小右居然和尼西里塔是一种东西？"
                                },
                                {
                                    "id": "760950556",
                                    "speaker": "小右",
                                    "text": "♪~"
                                },
                                {
                                    "id": "760950557",
                                    "speaker": "伊斯托利亚",
                                    "text": "我们想要下去，只有放弃自己的一切记忆和知识，登上最高处。以前是去觐见女主人，如今是觐见梅兰塔。"
                                },
                                {
                                    "id": "760950558",
                                    "speaker": "伊斯托利亚",
                                    "text": "所以我是没办法和你们一起下去啦。请让我送送你们吧。"
                                }
                            ]
                        },
                        {
                            "id": "760950504",
                            "text": "已经好了。",
                            "response": [
                                {
                                    "id": "760950505",
                                    "speaker": "伊斯托利亚",
                                    "text": "那好吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
