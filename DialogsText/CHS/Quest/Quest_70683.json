    "talks": [
        {
            "id": "7068301",
            "objective": "(test)子任务描述Test$HIDDEN",
            "dialogues": [
                {
                    "id": "706830701",
                    "speaker": "方妮雅",
                    "text": "多谢你们的协助，荣誉骑士和白色小帮手。不愧是蒙德家喻户晓的勇者。实在是令人印象深刻的推演，值得反复深入拆解分析。",
                    "choices": [
                        {
                            "id": "706830702",
                            "text": "哼哼，不愧是我们！",
                            "response": [
                                {
                                    "id": "706830703",
                                    "speaker": "派蒙",
                                    "text": "#嘿嘿，毕竟{NICKNAME}在现实中也已经和无数魔物交过手啦！总之，这样一来就算是帮上骑士团的忙了吧？"
                                },
                                {
                                    "id": "706830705",
                                    "speaker": "方妮雅",
                                    "text": "嗯，这次的兵棋推演过程非常顺利。无论是第七小队还是整个西风骑士团，都能从推演结果的分析中学到一些有用的东西。"
                                },
                                {
                                    "id": "706830706",
                                    "speaker": "方妮雅",
                                    "text": "这样一来，改善蒙德周边治安状况的行动应该也会更为顺利。比方说，像是突然出现的史莱姆袭击老年人，丘丘人劫掠商队…"
                                },
                                {
                                    "id": "706830707",
                                    "speaker": "派蒙",
                                    "text": "唔啊，不知为何，总觉得类似的事情好像已经见过很多次了…呃，也就是说，这些以后不会发生了，对吧！"
                                },
                                {
                                    "id": "706830708",
                                    "speaker": "方妮雅",
                                    "text": "……"
                                },
                                {
                                    "id": "706830709",
                                    "speaker": "派蒙",
                                    "text": "对…对吧？"
                                },
                                {
                                    "id": "706830710",
                                    "speaker": "方妮雅",
                                    "text": "这需要一定的时间，不过我们会…"
                                },
                                {
                                    "id": "706830711",
                                    "speaker": "艾玛托",
                                    "text": "方妮雅！方妮雅！你听我说…啊，是荣誉骑士大人和白色小帮手！你们好呀！"
                                },
                                {
                                    "id": "706830712",
                                    "speaker": "方妮雅",
                                    "text": "…你又有什么事？"
                                },
                                {
                                    "id": "706830713",
                                    "speaker": "艾玛托",
                                    "text": "欸，不要摆出那副表情嘛！真是的，明明我要报告的也是和推演有关的事…"
                                },
                                {
                                    "id": "706830714",
                                    "speaker": "艾玛托",
                                    "text": "哼！总之，我刚才按照你的要求「安安静静地进行推演」的时候，发现了一件特别厉害的事！"
                                },
                                {
                                    "id": "706830715",
                                    "speaker": "派蒙",
                                    "text": "呃，特别厉害的事？"
                                },
                                {
                                    "id": "706830716",
                                    "speaker": "艾玛托",
                                    "text": "没错没错！你看，虽然只是推演啦，但要是在计算数值的时候，把爆炸威力乘以十倍系数的话…"
                                },
                                {
                                    "id": "706830717",
                                    "speaker": "艾玛托",
                                    "text": "那我们之前开发的、小型化的爆破弩箭，不就能一下子打倒一台遗迹守卫了嘛！"
                                },
                                {
                                    "id": "706830718",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "706830719",
                                    "speaker": "主角",
                                    "text": "？"
                                },
                                {
                                    "id": "706830720",
                                    "speaker": "方妮雅",
                                    "text": "……"
                                },
                                {
                                    "id": "706830721",
                                    "speaker": "方妮雅",
                                    "text": "我姑且先问一句…为什么要乘以十倍？"
                                },
                                {
                                    "id": "706830722",
                                    "speaker": "艾玛托",
                                    "text": "因为这样一来，模拟的结果就会很漂亮！虽然现实里还做不到，但看到这样的数据，难道不会让人兴奋吗？！"
                                },
                                {
                                    "id": "706830723",
                                    "speaker": "艾玛托",
                                    "text": "向着这个目标加倍努力的话，说不定有朝一日就真的能取得那样的成果！几乎能复现蹦蹦炸弹十分之一威力的美丽爆炸…啊啊…"
                                },
                                {
                                    "id": "706830724",
                                    "speaker": "方妮雅",
                                    "text": "那你应该把爆炸威力乘以一百倍才对。"
                                },
                                {
                                    "id": "706830725",
                                    "speaker": "艾玛托",
                                    "text": "嗯？对喔！不愧是方妮雅！要是乘以一百倍的话，就绝对可以…不，是轻易可以打倒任何一种魔物啦！"
                                },
                                {
                                    "id": "706830726",
                                    "speaker": "艾玛托",
                                    "text": "特别是搭载了「角角鱼大王型战术核心」的改进型号，一发就可以摧毁一个遗迹重机战斗群——"
                                },
                                {
                                    "id": "706830727",
                                    "speaker": "方妮雅",
                                    "text": "何止。你不妨更进一步，要是按照一千万倍计算的话，说不定一发就可以把西风大教堂炸上天了。还能和枫丹科学院隔海相望呢。"
                                },
                                {
                                    "id": "706830728",
                                    "speaker": "方妮雅",
                                    "text": "然后等你被教会挂起来示众的时候，我就终于能和你彻底撇清关系，找个正常的租客把房子租出去了。"
                                },
                                {
                                    "id": "706830729",
                                    "speaker": "艾玛托",
                                    "text": "呜呜，我开玩笑的，开玩笑的！"
                                },
                                {
                                    "id": "706830730",
                                    "speaker": "方妮雅",
                                    "text": "没事，我也是开玩笑的。毕竟我现在是你的直属长官，你要是被挂起来示众，我也逃不掉失察的罪责。房子是租不出去的。"
                                },
                                {
                                    "id": "706830731",
                                    "speaker": "派蒙",
                                    "text": "原来如此，开玩笑的部分是房子其实租不出去…不对，这算是哪门子开玩笑啦！"
                                },
                                {
                                    "id": "706830732",
                                    "speaker": "方妮雅",
                                    "text": "总之，荣誉骑士和白色小帮手，再次感谢你们的协助。另外，艾玛托，你回去以后给我闭门反省私自修改参数的事。不许反驳。"
                                }
                            ]
                        },
                        {
                            "id": "706830704",
                            "text": "没事，帮上忙就好。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068302",
