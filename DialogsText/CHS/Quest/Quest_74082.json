    "talks": [
        {
            "id": "7408201",
            "objective": "(test)（隐藏）调查雕像$HIDDEN",
            "dialogues": [
                {
                    "id": "740820101",
                    "speaker": "刻字的石碑",
                    "text": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…歌于幽林雾道…」）"
                },
                {
                    "id": "740820102",
                    "speaker": "派蒙",
                    "text": "哎呀！好多字被磨掉了！这些应该是什么景点介绍吧？有些游客真是不太道德。"
                },
                {
                    "id": "740820103",
                    "speaker": "Player",
                    "text": "游客应该只会写字的。"
                },
                {
                    "id": "740820104",
                    "speaker": "派蒙",
                    "text": "#嗯…说的也对，比如写点{NICKNAME}和派蒙在此一游之类的…不不不，我们很有道德，我们不会乱写…"
                },
                {
                    "id": "740820105",
                    "speaker": "派蒙",
                    "text": "那这样想就奇怪了，为什么字被磨掉了？只剩下这句…"
                },
                {
                    "id": "740820106",
                    "speaker": "派蒙",
                    "text": "就连这句上面也有好多划痕，肯定是没磨干净，幸运的幽林雾道，你是漏网之鱼哦。"
                },
                {
                    "id": "740820107",
                    "speaker": "Player",
                    "text": "幽林雾道是什么地方？"
                },
                {
                    "id": "740820108",
                    "speaker": "派蒙",
                    "text": "嗯…林子里面有很多雾的道路？是这个意思吧…"
                },
                {
                    "id": "740820109",
                    "speaker": "派蒙",
                    "text": "有点想去找找看呢，总感觉隐藏了什么秘密，最后指向一个珍贵的宝藏！书里都是这么写的，嘿嘿。",
                    "choices": [
                        {
                            "id": "740820110",
                            "text": "你在哪个地摊看的书？",
                            "response": [
                                {
                                    "id": "740820112",
                                    "speaker": "派蒙",
                                    "text": "我才不是只会吃东西的派蒙！我有预感，这个幽林雾道一定藏着宝藏，所以才会被人掩盖！"
                                },
                                {
                                    "id": "740820113",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，是时候开始寻宝之旅了！带上你最好的伙伴，拥有绝对敏锐宝藏嗅觉的派蒙出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "740820111",
                            "text": "你在哪座书库看的书？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7408214",
            "objective": "(test)（隐藏）管理蓝叹号$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7408209",
            "objective": "(test)（隐藏）交互祭坛$HIDDEN",
            "dialogues": [
                {
                    "id": "740820401",
                    "speaker": "神秘祭坛",
                    "text": "（大部分字迹被磨毁，仅能依稀辨识出——「…清露…三…」）"
                },
                {
                    "id": "740820402",
                    "speaker": "派蒙",
                    "text": "可恶，这上面的字也被毁掉了，一定有秘密！",
                    "choices": [
                        {
                            "id": "740820403",
                            "text": "清露？",
                            "response": [
                                {
                                    "id": "740820404",
                                    "speaker": "派蒙",
                                    "text": "「清露」是什么意思？清清的露水？可是这附近到处都是水啊？"
                                },
                                {
                                    "id": "740820405",
                                    "speaker": "派蒙",
                                    "text": "至于这个「三」字，该不会是指三滴水吧？真头痛…"
                                },
                                {
                                    "id": "740820409",
                                    "speaker": "Player",
                                    "text": "快问问你的绝对敏锐宝藏嗅觉啊！"
                                },
                                {
                                    "id": "740820410",
                                    "speaker": "派蒙",
                                    "text": "已经问过了！总之…总之…"
                                },
                                {
                                    "id": "740820411",
                                    "speaker": "派蒙",
                                    "text": "总之它说跟「三」和「水」有关嘛，我们应该在附近找一找！"
                                }
                            ]
                        },
                        {
                            "id": "740820406",
                            "text": "三？",
                            "response": [
                                {
                                    "id": "740820407",
                                    "speaker": "派蒙",
                                    "text": "「三」是三个东西的意思吗？"
                                },
                                {
                                    "id": "740820408",
                                    "speaker": "派蒙",
                                    "text": "至于「清露」，难道是清清的露水？可是这附近到处都是水…真头痛…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
