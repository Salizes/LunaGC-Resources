    "talks": [
        {
            "id": "2005901",
            "objective": "与玛乔丽对话",
            "dialogues": [
                {
                    "id": "200590101",
                    "speaker": "玛乔丽",
                    "text": "这下可糟糕了，怎么办呢…"
                },
                {
                    "id": "200590102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "200590103",
                    "speaker": "玛乔丽",
                    "text": "旅行者！你来得正好！你知道，这里是我家开的纪念品商店。"
                },
                {
                    "id": "200590104",
                    "speaker": "玛乔丽",
                    "text": "之前，我老爹会收购其他的冒险家带回来的战利品，然后摆在店里卖。"
                },
                {
                    "id": "200590105",
                    "speaker": "玛乔丽",
                    "text": "但是自从冒险家协会…不是那么热闹之后，我能收购的东西也越来越少。"
                },
                {
                    "id": "200590106",
                    "speaker": "玛乔丽",
                    "text": "而且还尽是一些不怎么值钱的东西，根本没有客人愿意买。"
                },
                {
                    "id": "200590107",
                    "speaker": "玛乔丽",
                    "text": "旅行者，你会四处冒险对吧？能不能帮帮我，去找点好卖的战利品回来？",
                    "choices": [
                        {
                            "id": "200590108",
                            "text": "我明白了。",
                            "response": [
                                {
                                    "id": "200590109",
                                    "speaker": "玛乔丽",
                                    "text": "那就拜托你了！找到之后，我一定把它卖个好价钱。"
                                }
                            ]
                        },
                        {
                            "id": "200590110",
                            "text": "派蒙其实就…",
                            "response": [
                                {
                                    "id": "200590111",
                                    "speaker": "玛乔丽",
                                    "text": "抱歉，应该没人会买哦。"
                                },
                                {
                                    "id": "200590112",
                                    "speaker": "玛乔丽",
                                    "text": "因为…肯定会自己跑掉。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2005902",
            "objective": "与玛乔丽对话",
            "dialogues": [
                {
                    "id": "200590201",
                    "speaker": "玛乔丽",
                    "text": "记住了吗？那就快去吧，我就在这等着你。"
                }
            ]
        },
        {
