    "talks": [
        {
            "id": "7268801",
            "objective": "等待至翌日上午（次日早8点-12点），与柴染对话",
            "dialogues": [
                {
                    "id": "726880101",
                    "speaker": "柴染",
                    "text": "又见面了，两位。"
                },
                {
                    "id": "726880102",
                    "speaker": "柴染",
                    "text": "上次的「花影瑶庭」令人欣喜，看来你们天赋异禀，很快就能领会花艺的精髓。"
                },
                {
                    "id": "726880103",
                    "speaker": "柴染",
                    "text": "新的「花题」正等待两位作答。",
                    "choices": [
                        {
                            "id": "726880104",
                            "text": "现在就开始吧。",
                            "response": [
                                {
                                    "id": "726880105",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯！我们准备好了哦！"
                                },
                                {
                                    "id": "726880106",
                                    "speaker": "柴染",
                                    "text": "两位的眼中有着瑰丽的光彩，像是映照着绚烂的花海，令人惊叹…"
                                },
                                {
                                    "id": "726880107",
                                    "speaker": "柴染",
                                    "text": "那么，今日的「花题」稍稍提升了难度，有助于你们深究构图的技巧——"
                                },
                                {
                                    "id": "726880108",
                                    "speaker": "柴染",
                                    "text": "「锦绣槃固，池中溪客」。"
                                },
                                {
                                    "id": "726880109",
                                    "speaker": "柴染",
                                    "text": "请领会题中的含义，谨慎挑选花材，悉心构筑你们的「花庭」吧。"
                                }
                            ]
                        },
                        {
                            "id": "726880110",
                            "text": "还有别的事…",
                            "response": [
                                {
                                    "id": "726880111",
                                    "speaker": "柴染",
                                    "text": "没关系。「插花」需要安神定气。"
                                },
                                {
                                    "id": "726880112",
                                    "speaker": "柴染",
                                    "text": "等到二位忙完手头的事，摆脱了喧扰。必定能将题中的「花庭」构筑得更加完满。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268802",
            "objective": "与柴染对话",
            "dialogues": []
        },
        {
            "id": "7268803",
            "objective": "完成花题",
            "dialogues": []
        },
        {
            "id": "7268804",
            "objective": "与柴染对话",
            "dialogues": []
        },
        {
            "id": "7268702",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726870201",
                    "speaker": "柴染",
                    "text": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。"
                },
                {
                    "id": "726870202",
                    "speaker": "柴染",
                    "text": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。"
                },
                {
                    "id": "726870203",
                    "speaker": "柴染",
                    "text": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
                    "choices": [
                        {
                            "id": "726870204",
                            "text": "关于这里的花卉…",
                            "response": [
                                {
                                    "id": "726870205",
                                    "speaker": "柴染",
                                    "text": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。"
                                },
                                {
                                    "id": "726870206",
                                    "speaker": "柴染",
                                    "text": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。"
                                },
                                {
                                    "id": "726870207",
                                    "speaker": "柴染",
                                    "text": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。"
                                },
                                {
                                    "id": "726870208",
                                    "speaker": "柴染",
                                    "text": "所以，我也会向其他客人宣传她的「咲耶花屋」。"
                                },
                                {
                                    "id": "726870209",
                                    "speaker": "派蒙",
                                    "text": "有机会的话，我们也可以帮忙哦！"
                                },
                                {
                                    "id": "726870219",
                                    "speaker": "柴染",
                                    "text": "那么，还有什么问题吗，两位？"
                                },
                                {
                                    "id": "726870220",
                                    "speaker": "Player",
                                    "text": "谢谢你，柴染小姐。"
                                },
                                {
                                    "id": "726870221",
                                    "speaker": "柴染",
                                    "text": "不用客气。如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        },
                        {
                            "id": "726870210",
                            "text": "关于社奉行…",
                            "response": [
                                {
                                    "id": "726870211",
                                    "speaker": "柴染",
                                    "text": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。"
                                },
                                {
                                    "id": "726870212",
                                    "speaker": "柴染",
                                    "text": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。"
                                },
                                {
                                    "id": "726870213",
                                    "speaker": "柴染",
                                    "text": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。"
                                },
                                {
                                    "id": "726870214",
                                    "speaker": "柴染",
                                    "text": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…"
                                },
                                {
                                    "id": "726870215",
                                    "speaker": "柴染",
                                    "text": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。"
                                },
                                {
                                    "id": "726870216",
                                    "speaker": "派蒙",
                                    "text": "原来绫华为稻妻的花艺付出过这么多啊…"
                                },
                                {
                                    "id": "726870217",
                                    "speaker": "Player",
                                    "text": "希望她的愿望能实现。"
                                },
                                {
                                    "id": "726870218",
                                    "speaker": "柴染",
                                    "text": "感谢两位，你们真是善解人意。"
                                }
                            ]
                        },
                        {
                            "id": "726870222",
                            "text": "暂时没有问题了。",
                            "response": [
                                {
                                    "id": "726870223",
                                    "speaker": "柴染",
                                    "text": "如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}