    "talks": [
        {
            "id": "7014302",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "701430201",
                    "speaker": "凯瑟琳",
                    "text": "你好，旅行者，最近的冒险行动还顺利吗？"
                },
                {
                    "id": "701430202",
                    "speaker": "Player",
                    "text": "还算是顺利。"
                },
                {
                    "id": "701430203",
                    "speaker": "凯瑟琳",
                    "text": "嗯，你的那些冒险事迹我都听说了，以这个势头继续冒险的话，你肯定能成为一名优秀的冒险家。"
                },
                {
                    "id": "701430204",
                    "speaker": "凯瑟琳",
                    "text": "然后…关于冒险行动，我这里有一份「冒险情报」，不知道你有没有兴趣。"
                },
                {
                    "id": "701430205",
                    "speaker": "Player",
                    "text": "又有什么新委托吗…"
                },
                {
                    "id": "701430206",
                    "speaker": "凯瑟琳",
                    "text": "看来你对于协会里的这些事务已经很熟练了呢。"
                },
                {
                    "id": "701430207",
                    "speaker": "凯瑟琳",
                    "text": "不过，这次不是委托，而是一份「冒险情报」。"
                },
                {
                    "id": "701430208",
                    "speaker": "凯瑟琳",
                    "text": "这份「冒险情报」，是关于蒙德旁边那座「龙脊雪山」的。"
                },
                {
                    "id": "701430209",
                    "speaker": "凯瑟琳",
                    "text": "在那里，协会已经设置好了营地，还驻扎了不少冒险家。"
                },
                {
                    "id": "701430210",
                    "speaker": "凯瑟琳",
                    "text": "地点我给你标注在地图上了，到达那片营地之后，你可以先去找一位叫做「玉霞」的冒险家了解一下周围的情况。"
                },
                {
                    "id": "701430211",
                    "speaker": "凯瑟琳",
                    "text": "那么，继续冒险吧，向着星辰与深渊！"
                }
            ]
        },
        {
            "id": "7014301",
            "objective": "与玉霞对话",
            "dialogues": [
                {
                    "id": "701430101",
                    "speaker": "Player",
                    "text": "关于进入雪山冒险…"
                },
                {
                    "id": "701430102",
                    "speaker": "玉霞",
                    "text": "如果你真想去雪山里冒险，那可要先做好万全的准备再进山，绝不能掉以轻心。"
                },
                {
                    "id": "701430103",
                    "speaker": "玉霞",
                    "text": "对于粗心大意的冒险家，雪山可不会留任何情面。"
                }
            ]
        }
    ]
}