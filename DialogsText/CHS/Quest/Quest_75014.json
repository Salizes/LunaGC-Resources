    "talks": [
        {
            "id": "7501405",
            "objective": "前往塔卢加所说的地点附近探查",
            "dialogues": []
        },
        {
            "id": "7501404",
            "objective": "坐下休息，等待至次日20:00-22:00",
            "dialogues": []
        },
        {
            "id": "7501415",
            "objective": "(test)隐藏回滚环$HIDDEN",
            "dialogues": [
                {
                    "id": "750141501",
                    "speaker": "塔卢加",
                    "text": "我和奥伯龙在这里等你的消息，拜托了。"
                },
                {
                    "id": "750141502",
                    "speaker": "奥伯龙",
                    "text": "啊呜…"
                }
            ]
        },
        {
            "id": "7501412",
            "objective": "准备前往营地",
            "dialogues": [
                {
                    "id": "750141201",
                    "speaker": "葵莉娅",
                    "text": "咦？小家伙，你是迷路了吗？"
                },
                {
                    "id": "750141202",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750141203",
                    "speaker": "葵莉娅",
                    "text": "很有活力，看起来很健康。角上有特别的花纹…真不错。"
                },
                {
                    "id": "750141204",
                    "speaker": "葵莉娅",
                    "text": "不过你们为什么会一起出现在这里？是我的管教出了问题？不，这不可能。"
                },
                {
                    "id": "750141205",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔？呀呀！"
                },
                {
                    "id": "750141206",
                    "speaker": "葵莉娅",
                    "text": "嗯？它怎么了？是它带你来的？"
                },
                {
                    "id": "750141207",
                    "speaker": "Player",
                    "text": "（不能被她发现…）",
                    "choices": [
                        {
                            "id": "750141208",
                            "text": "呜呜…",
                            "response": [
                                {
                                    "id": "750141210",
                                    "speaker": "葵莉娅",
                                    "text": "怎么会发出这么奇怪的叫声，难道是生病了？行为也有反常的地方，看来得好好检查一下。"
                                },
                                {
                                    "id": "750141211",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750141212",
                                    "speaker": "葵莉娅",
                                    "text": "小家伙，别心急，待会儿就轮到你了。"
                                },
                                {
                                    "id": "750141221",
                                    "speaker": "葵莉娅",
                                    "text": "首先是你，你得跟我走，能听懂指令吗？",
                                    "choices": [
                                        {
                                            "id": "750141213",
                                            "text": "（点头。）",
                                            "response": [
                                                {
                                                    "id": "750141214",
                                                    "speaker": "葵莉娅",
                                                    "text": "你这是从哪里学会的把戏？而且，难道你能听懂我的话？"
                                                },
                                                {
                                                    "id": "750141219",
                                                    "speaker": "Black Screen",
                                                    "text": "#这时，从外边传来一阵嘈杂的声响…\\n「谁把箱子打开了…喂！别抢！你们先别抢！待会儿葵莉娅要发脾气了！」\\n来不及确认发生了什么，先趁乱和{REALNAME[ID(2)|SHOWHOST(true)]}一起离开了营地…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750141215",
                                            "text": "（摇头。）",
                                            "response": [
                                                {
                                                    "id": "750141216",
                                                    "speaker": "葵莉娅",
                                                    "text": "你这是从哪里学会的把戏？而且，难道你能听懂我的话？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750141217",
                                            "text": "（跟她走。）",
                                            "response": [
                                                {
                                                    "id": "750141218",
                                                    "speaker": "葵莉娅",
                                                    "text": "怪事，我还没说指令呢。难道你能听懂我的话？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750141209",
                            "text": "呀！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501406",
            "objective": "魂附暝视龙，潜入营地深处",
            "dialogues": []
        },
        {
            "id": "7501408",
            "objective": "在不被发现的情况下，听听密谈内容",
            "dialogues": [
                {
                    "id": "750140801",
                    "speaker": "派蒙",
                    "text": "（唔…这里看不太清楚呢，不过再靠近的话可能会被发现，还是保持现在距离听听他们在说什么好了。）"
                },
                {
                    "id": "750140802",
                    "speaker": "温和的声音",
                    "text": "上次的货质量确实不错，这次也拜托你们了。"
                },
                {
                    "id": "750140803",
                    "speaker": "低沉的声音",
                    "text": "好说好说，还是老规矩？"
                },
                {
                    "id": "750140804",
                    "speaker": "温和的声音",
                    "text": "嗯，在飞行竞赛之前送到，会有人需要的。"
                },
                {
                    "id": "750140805",
                    "speaker": "低沉的声音",
                    "text": "没问题。他们那边应该也聊得差不多了，要不这就撤了？"
                },
                {
                    "id": "750140806",
                    "speaker": "派蒙",
                    "text": "（欸？他们这就走了？跟预想的情况好像不太一样…不过我们还是先回去吧，小心不要被发现哦。）"
                }
            ]
        },
        {
            "id": "7501411",
            "objective": "用完美的伪装设法脱身吧！",
            "dialogues": []
        },
        {
            "id": "7501409",
            "objective": "离开北部营地",
            "dialogues": [
                {
                    "id": "750141320",
                    "speaker": "派蒙",
                    "text": "真叫我吓出一身冷汗！幸好我先一步躲起来了，不然说不定她就不会在意两只龙，而是把我抓起来了！"
                },
                {
                    "id": "750141321",
                    "speaker": "Player",
                    "text": "派蒙居然把我们两个丢下独自逃跑…"
                },
                {
                    "id": "750141322",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜呜…"
                },
                {
                    "id": "750141323",
                    "speaker": "Player",
                    "text": "再晚一步就要变成不可能犯罪了…"
                },
                {
                    "id": "750141324",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜呜…"
                },
                {
                    "id": "750141325",
                    "speaker": "派蒙",
                    "text": "的确是没人可以指证暝视龙…指证你，但是不要说这种可怕的话啦！"
                },
                {
                    "id": "750141326",
                    "speaker": "派蒙",
                    "text": "总、总之，这是我临机应变的策略！要不是有我在外边弄出点动静来，你们也没法顺利脱身嘛。"
                },
                {
                    "id": "750141327",
                    "speaker": "派蒙",
                    "text": "说来也巧，原来箱子里不是普通货物，全是龙龙饼干。推倒之后暝视龙都围过来了，真是一团乱！"
                },
                {
                    "id": "750141328",
                    "speaker": "派蒙",
                    "text": "不过我在外边也没看到拉密萨纳，之前谈交易的两个人没看太清楚，但应该也不是拉密萨纳吧，声音听起来也不像。"
                },
                {
                    "id": "750141329",
                    "speaker": "派蒙",
                    "text": "唔…不管怎么说，先把刚才看到听到的照实告诉塔卢加好了。"
                }
            ]
        },
        {
            "id": "7501410",
            "objective": "向塔卢加回报发现",
            "dialogues": [
                {
                    "id": "750141001",
                    "speaker": "塔卢加",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}！幸好你们没事，我好担心你们。"
                },
                {
                    "id": "750141002",
                    "speaker": "派蒙",
                    "text": "是真的很惊险！呃，但是很难描述…先不说这个。"
                },
                {
                    "id": "750141003",
                    "speaker": "Black Screen",
                    "text": "向塔卢加讲述了在营地的见闻…"
                },
                {
                    "id": "750141004",
                    "speaker": "塔卢加",
                    "text": "怎么会呢？你们没见到拉密萨纳，但是见到了葵莉娅小姐…"
                },
                {
                    "id": "750141005",
                    "speaker": "派蒙",
                    "text": "不过他们确实提到了飞行竞赛，听起来像是要进行什么交易，具体是什么东西不知道，但是好像会在竞赛时用到。"
                },
                {
                    "id": "750141006",
                    "speaker": "塔卢加",
                    "text": "葵莉娅小姐是最近才来的行商，听帕朗说，她经手的货品种类很多。说不定拉密萨纳是从她那里得到了什么危险物品…"
                },
                {
                    "id": "750141007",
                    "speaker": "塔卢加",
                    "text": "这样在飞行竞赛的时候就可以执行他的危险计划了！",
                    "choices": [
                        {
                            "id": "750141008",
                            "text": "所以到底是什么危险计划？",
                            "response": [
                                {
                                    "id": "750141010",
                                    "speaker": "塔卢加",
                                    "text": "不知道…但是我知道他肯定在谋划些什么，而且很危险！"
                                },
                                {
                                    "id": "750141011",
                                    "speaker": "帕朗",
                                    "text": "#太好了，在这里。你就是{NICKNAME}对吧？我听拉密萨纳说了，你体验过训练赛道，而且表现得还不错。",
                                    "choices": [
                                        {
                                            "id": "750141012",
                                            "text": "过誉了。",
                                            "response": [
                                                {
                                                    "id": "750141015",
                                                    "speaker": "帕朗",
                                                    "text": "事情是这样，飞行竞赛马上就要举行了，但是有个选手临时无法参加，正好又是莉瓦的对手。"
                                                },
                                                {
                                                    "id": "750141016",
                                                    "speaker": "帕朗",
                                                    "text": "呃，塔卢加也知道的，她一向好强，如果算她不战而胜，她肯定也不会服气…"
                                                },
                                                {
                                                    "id": "750141017",
                                                    "speaker": "塔卢加",
                                                    "text": "那姐姐不要参加不就好了，正好，我再去劝劝她！"
                                                },
                                                {
                                                    "id": "750141018",
                                                    "speaker": "帕朗",
                                                    "text": "这、这不好吧！她也为了这次的竞赛准备了很长时间，呃，最好是能找到一个实力相当的替补选手…"
                                                },
                                                {
                                                    "id": "750141019",
                                                    "speaker": "派蒙",
                                                    "text": "#所以就找到{NICKNAME}吗？"
                                                },
                                                {
                                                    "id": "750141020",
                                                    "speaker": "帕朗",
                                                    "text": "是的。不管是否能在竞赛中取得名次，我们都会额外为你提供一份奖励，只要参与过…",
                                                    "choices": [
                                                        {
                                                            "id": "750141021",
                                                            "text": "还真是被看扁了啊。",
                                                            "response": [
                                                                {
                                                                    "id": "750141022",
                                                                    "speaker": "帕朗",
                                                                    "text": "欸？啊，说的也是…如果拿到名次的话，对应名次的奖励和额外奖励也会一并交给你。"
                                                                },
                                                                {
                                                                    "id": "750141025",
                                                                    "speaker": "帕朗",
                                                                    "text": "你愿意参加就太好了，比赛的邀请函会之后发给你。我还有其他准备工作要做，下次见应该就是飞行竞赛当天了。"
                                                                },
                                                                {
                                                                    "id": "750141026",
                                                                    "speaker": "Black Screen",
                                                                    "text": "帕朗带着加勒弗大汪离开了…"
                                                                },
                                                                {
                                                                    "id": "750141027",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}会答应他是因为这样就可以近距离调查了对吧？如果飞行竞赛上真的发生了什么，作为选手肯定能更快知道。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750141028",
                                                                            "text": "而且感觉事情没那么简单。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750141031",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过说起来，帕朗的声音有点耳熟呢，是最近在哪里听到过吗…"
                                                                                },
                                                                                {
                                                                                    "id": "750141032",
                                                                                    "speaker": "塔卢加",
                                                                                    "text": "飞行学校的方方面面都要他操心，他和加勒弗大汪常在这里跑来跑去，想要不听到他的声音反而比较难呢。"
                                                                                },
                                                                                {
                                                                                    "id": "750141033",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "也是哦！说起来，好像在什么故事里看过…"
                                                                                },
                                                                                {
                                                                                    "id": "750141034",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "如果是这样和背景融为一体的人犯案，大家一般都不会第一时间想到，因为已经对他们的存在习以为常了嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "750141035",
                                                                                    "speaker": "塔卢加",
                                                                                    "text": "嗯…不过这件事最好不要在他面前提吧。他的家族中曾经有些人做了不好的事，被部族放逐了。"
                                                                                },
                                                                                {
                                                                                    "id": "750141036",
                                                                                    "speaker": "塔卢加",
                                                                                    "text": "后来也常有人拿这件事当借口找他的麻烦…可能是因为这个，他对自己总是很严格，但却很为大家着想。"
                                                                                },
                                                                                {
                                                                                    "id": "750141037",
                                                                                    "speaker": "塔卢加",
                                                                                    "text": "就算是我也得承认，虽然他跟拉密萨纳关系很好，但是除此之外，他是个不错的家伙。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "750141038",
                                                                                            "text": "拉密萨纳是什么害虫吗？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "750141039",
                                                                                                    "speaker": "塔卢加",
                                                                                                    "text": "要让我说，就连害虫都比他可爱一百倍。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141041",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "幸好现在知道了！不然就算是无意说出的话，要是伤到人那也是不好的。说回飞行竞赛…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141042",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#不过对手是塔卢加的姐姐的话，那塔卢加也不用太担心了，如果发生什么，{NICKNAME}肯定会保护好你姐姐的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141043",
                                                                                                    "speaker": "塔卢加",
                                                                                                    "text": "嗯…到时我会在终点附近等你们，拉密萨纳和我应该会先比完，我会好好盯紧他的！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141044",
                                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                                    "text": "呜呜？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141045",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#这次的确不是适合{REALNAME[ID(2)|SHOWHOST(true)]}发挥的舞台呢，你就跟我一起观赛好啦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750141046",
                                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                                    "text": "呜…"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "750141040",
                                                                                            "text": "他也很辛苦呢。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750141029",
                                                                            "text": "不，我只是为了参与奖…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750141030",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "就算为了让自己看起来帅气一点你也应该配合我的说法吧！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750141023",
                                                            "text": "好耶，是保底的参与奖。",
                                                            "response": [
                                                                {
                                                                    "id": "750141024",
                                                                    "speaker": "派蒙",
                                                                    "text": "你的目标也太低了吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750141013",
                                            "text": "什么，他居然小看我。",
                                            "response": [
                                                {
                                                    "id": "750141014",
                                                    "speaker": "帕朗",
                                                    "text": "哪里哪里，不敢不敢！这情况如果是特马乔会怎么说…对了，是训练赛道没有给你提供足够发挥的空间！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750141009",
                            "text": "可是他的动机呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750140152",
                    "speaker": "派蒙",
                    "text": "唔…如果拉密萨纳真的来了，应该会<color=#00E1FFFF>在更里边的地方</color>吧？毕竟是要谈些见不得人的事呢！"
                },
                {
                    "id": "750140153",
                    "speaker": "派蒙",
                    "text": "要是能<color=#00E1FFFF>混在暝视龙里偷偷潜入</color>进去的话…"
                }
            ]
        },
        {
            "id": "7501416",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750141601",
                    "speaker": "莉瓦",
                    "text": "真伤脑筋呀…",
                    "choices": [
                        {
                            "id": "750141602",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "750141603",
                                    "speaker": "莉瓦",
                                    "text": "是这样，我有一个年纪差得比较多的弟弟，可能正是叛逆的年纪吧，和谁都处不来…"
                                },
                                {
                                    "id": "750141604",
                                    "speaker": "莉瓦",
                                    "text": "哎呀，说给你听也是徒增烦恼吧。等他再长大些说不定就好了，嗯！"
                                }
                            ]
                        },
                        {
                            "id": "750141605",
                            "text": "打扰了。",
                            "response": [
                                {
                                    "id": "750141606",
                                    "speaker": "莉瓦",
                                    "text": "没事，再见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508757",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750875701",
                    "speaker": "特马乔",
                    "text": "我们这儿还有几项飞行挑战，具体内容都写在告示牌上了，如果你感兴趣不妨试试，当然也会有对应的奖励。",
                    "choices": [
                        {
                            "id": "750875702",
                            "text": "关于帕帕卡飞行学校…",
                            "response": [
                                {
                                    "id": "750875703",
                                    "speaker": "特马乔",
                                    "text": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？"
                                },
                                {
                                    "id": "750875704",
                                    "speaker": "特马乔",
                                    "text": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。"
                                }
                            ]
                        },
                        {
                            "id": "750875705",
                            "text": "关于拉密萨纳…",
                            "response": [
                                {
                                    "id": "750875706",
                                    "speaker": "特马乔",
                                    "text": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？"
                                },
                                {
                                    "id": "750875707",
                                    "speaker": "特马乔",
                                    "text": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。"
                                },
                                {
                                    "id": "750875708",
                                    "speaker": "特马乔",
                                    "text": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。"
                                }
                            ]
                        },
                        {
                            "id": "750875709",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "750875710",
                                    "speaker": "特马乔",
                                    "text": "再见，也欢迎你随时回来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508761",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750876101",
                    "speaker": "琪希可",
                    "text": "欢迎来到帕帕卡飞行学校！",
                    "choices": [
                        {
                            "id": "750876102",
                            "text": "你在这里做什么？",
                            "response": [
                                {
                                    "id": "750876104",
                                    "speaker": "琪希可",
                                    "text": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。"
                                },
                                {
                                    "id": "750876105",
                                    "speaker": "琪希可",
                                    "text": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。"
                                },
                                {
                                    "id": "750876106",
                                    "speaker": "琪希可",
                                    "text": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？"
                                }
                            ]
                        },
                        {
                            "id": "750876103",
                            "text": "先走了。",
                            "response": [
                                {
                                    "id": "750876107",
                                    "speaker": "琪希可",
                                    "text": "祝你度过愉快的一天！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508764",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750876401",
                    "speaker": "奥伯龙",
                    "text": "塔卢加好像不高兴，发生什么了…"
                }
            ]
        }
    ]
