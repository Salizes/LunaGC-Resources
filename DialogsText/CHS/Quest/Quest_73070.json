        },
        {
            "id": "7307007",
            "objective": "利用「新芽的曲调」，开启通路",
            "dialogues": []
        },
        {
            "id": "7307010",
            "objective": "继续前进，前往觉树之堂",
            "dialogues": []
        },
        {
            "id": "7307001",
            "objective": "消除死域",
            "dialogues": []
        },
        {
            "id": "7307012",
            "objective": "调查觉树之堂中的树木",
            "dialogues": []
        },
        {
            "id": "7307013",
            "objective": "与兰罗摩对话",
            "dialogues": [
                {
                    "id": "730701301",
                    "speaker": "派蒙",
                    "text": "这就是…莎兰树？看起来，好像没有想象中那么有生机…"
                },
                {
                    "id": "730701302",
                    "speaker": "兰罗摩",
                    "text": "嗯。兰玛哈很努力地抵抗了，把无留陀控制在边上。不然的话，附近的森林情况应该会变得更可怕。"
                },
                {
                    "id": "730701303",
                    "speaker": "兰罗摩",
                    "text": "树叶都掉下来，在地上腐烂。蘑菇全部变成生气的蕈兽，走兽和飞鸟也躺下来，回到土地里，只剩下白白的硬硬的东西。"
                },
                {
                    "id": "730701304",
                    "speaker": "派蒙",
                    "text": "听起来好可怕…"
                },
                {
                    "id": "730701305",
                    "speaker": "兰罗摩",
                    "text": "#嗯。不过，幸亏有那菈{NICKNAME}和派蒙，无留陀的问题好了很多很多！"
                },
                {
                    "id": "730701306",
                    "speaker": "兰罗摩",
                    "text": "如果只有我一个的话，肯定不行。我经过的时间很少，记忆也很少，所以，没有别的兰那罗力量那么强。"
                },
                {
                    "id": "730701307",
                    "speaker": "兰罗摩",
                    "text": "#但是，和那菈{NICKNAME}和派蒙一起，我就能得到一起冒险的记忆，力量也会变强！",
                    "choices": [
                        {
                            "id": "730701308",
                            "text": "我们也一样。",
                            "response": [
                                {
                                    "id": "730701309",
                                    "speaker": "派蒙",
                                    "text": "嗯！朋友一起冒险，就是这样的！"
                                },
                                {
                                    "id": "730701311",
                                    "speaker": "兰罗摩",
                                    "text": "嗯。我们要先进入他的梦中，消除无留陀的影响。"
                                },
                                {
                                    "id": "730701312",
                                    "speaker": "派蒙",
                                    "text": "「他」是指…莎兰树吗？"
                                },
                                {
                                    "id": "730701313",
                                    "speaker": "兰罗摩",
                                    "text": "没错。如果准备好了，就伸出手，进入他的梦吧…"
                                }
                            ]
                        },
                        {
                            "id": "730701310",
                            "text": "接下来要怎么做？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307017",
            "objective": "与兰罗摩对话，进入莎兰树的梦",
            "dialogues": [
                {
                    "id": "730701701",
                    "speaker": "Player",
                    "text": "（对莎兰树伸出手…）"
                }
            ]
        },
        {
            "id": "7307019",
            "objective": "与兰罗摩对话，进入莎兰树的梦",
            "dialogues": [
                {
                    "id": "730701901",
                    "speaker": "派蒙",
                    "text": "这就是…"
                },
                {
                    "id": "730701902",
                    "speaker": "兰罗摩",
                    "text": "嗯。这就是恒素果。"
                },
                {
                    "id": "730701903",
                    "speaker": "兰罗摩",
                    "text": "恒素果是莎兰树积聚梦想和记忆，结出来的。对于我们来说，是能让我们恢复力量的宝贵果实。"
                },
                {
                    "id": "730701904",
                    "speaker": "兰罗摩",
                    "text": "要让「觉王之树」长出惟耶之实，需要消耗大量的力量。所以，我们要拿恒素果去供养他。"
                },
                {
                    "id": "730701905",
                    "speaker": "兰罗摩",
                    "text": "#那菈{NICKNAME}，要好好保管恒素果喔！"
                },
                {
                    "id": "730701906",
                    "speaker": "派蒙",
                    "text": "嗯…既然如此，我们教兰罗摩「宝藏」的意思吧！"
                },
                {
                    "id": "730701907",
                    "speaker": "派蒙",
                    "text": "宝藏就是很珍贵的东西的意思。你看，恒素果有很多梦想和记忆，而且能让兰那罗恢复力量，很厉害、很稀有对吧！"
                },
                {
                    "id": "730701908",
                    "speaker": "派蒙",
                    "text": "像恒素果这样，很珍贵、很重要的东西，这就是宝藏喔！"
                },
                {
                    "id": "730701909",
                    "speaker": "兰罗摩",
                    "text": "哦哦！原来宝藏是这样的意思…我知道了！谢谢派蒙！",
                    "choices": [
                        {
                            "id": "730701910",
                            "text": "接下来要做什么？",
                            "response": [
                                {
                                    "id": "730701911",
                                    "speaker": "派蒙",
                                    "text": "唔…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？"
                                },
                                {
                                    "id": "730701914",
                                    "speaker": "兰罗摩",
                                    "text": "#嗯。我会努力！那菈{NICKNAME}、派蒙，我们之后再见吧！"
                                },
                                {
                                    "id": "730701915",
                                    "speaker": "派蒙",
                                    "text": "嗯！之后再见啦，兰罗摩！"
                                }
                            ]
                        },
                        {
                            "id": "730701912",
                            "text": "谢谢派蒙！",
                            "response": [
                                {
                                    "id": "730701913",
                                    "speaker": "派蒙",
                                    "text": "真是的，你在说什么呀…记得之前兰拉迦说了，好像要不止一个恒素果。这样的话，我们还要找别的觉树之堂吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307014",
            "objective": "探索莎兰树的梦",
            "dialogues": [
                {
                    "id": "730701401",
                    "speaker": "派蒙",
                    "text": "想不到这里也有无留陀的侵蚀…"
                },
                {
                    "id": "730701402",
                    "speaker": "兰罗摩",
                    "text": "#嗯。那菈{NICKNAME}真厉害，这次也轻轻松松击退了无留陀。"
                },
                {
                    "id": "730701403",
                    "speaker": "兰罗摩",
                    "text": "兰玛哈很努力地抵抗了，把无留陀控制在边上。不然的话，附近的森林情况应该会变得更可怕。"
