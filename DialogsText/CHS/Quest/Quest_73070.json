    "talks": [
        {
            "id": "7307002",
            "objective": "(test)寻找巨大草种子之曲$HIDDEN",
            "dialogues": [
                {
                    "id": "730700201",
                    "speaker": "兰罗摩",
                    "text": "#我也要变成聪明的兰那罗，像那菈{NICKNAME}一样！"
                }
            ]
        },
        {
            "id": "7307020",
            "objective": "前往指定地点，寻找与觉树之堂有关的线索",
            "dialogues": [
                {
                    "id": "730702001",
                    "speaker": "派蒙",
                    "text": "这么一来，第二个恒素果就到手了呢！"
                },
                {
                    "id": "730702002",
                    "speaker": "兰罗摩",
                    "text": "#那菈{NICKNAME}好厉害！不但能击退无留陀，连怪物也不怕。不愧是能打败桓那吉的那菈！"
                },
                {
                    "id": "730702003",
                    "speaker": "派蒙",
                    "text": "哼哼，我们一直一起冒险，遇到过很多事情呢！"
                },
                {
                    "id": "730702004",
                    "speaker": "兰罗摩",
                    "text": "#好棒！那那菈{NICKNAME}和派蒙也有很多记忆、很多故事吧？",
                    "choices": [
                        {
                            "id": "730702005",
                            "text": "的确有很多…",
                            "response": [
                                {
                                    "id": "730702007",
                                    "speaker": "兰罗摩",
                                    "text": "#嗯。那菈{NICKNAME}和派蒙以后要说故事给我们听。"
                                },
                                {
                                    "id": "730702008",
                                    "speaker": "派蒙",
                                    "text": "没问题！之前我们也给人讲过故事呢，感觉已经过了好久了…"
                                },
                                {
                                    "id": "730702009",
                                    "speaker": "派蒙",
                                    "text": "这么说来，莎兰树的梦…在梦里面，我看到远方有一个好大好大的、紫色的树，那是什么呀？在桓那兰那好像也看得到…"
                                },
                                {
                                    "id": "730702010",
                                    "speaker": "兰罗摩",
                                    "text": "那个呀，是第一棵「觉王的梦之树」。唔…应该怎么说呢…"
                                },
                                {
                                    "id": "730702011",
                                    "speaker": "兰罗摩",
                                    "text": "梦就像是在溪水里的树叶，它很快就会和水一起跑掉跑掉不见。所以，如果要让梦一直留着，就要让梦扎根。这样就不会跑掉。"
                                },
                                {
                                    "id": "730702012",
                                    "speaker": "兰罗摩",
                                    "text": "呜呜…应该怎么说才好…",
                                    "choices": [
                                        {
                                            "id": "730702013",
                                            "text": "觉王的梦之树就像树根？",
                                            "response": [
                                                {
                                                    "id": "730702015",
                                                    "speaker": "兰罗摩",
                                                    "text": "#那菈{NICKNAME}聪明。有了这种树，兰那罗的梦就能一直在，而且能让好多好多兰那罗进去、出去，还能和莎兰树连在一起。"
                                                },
                                                {
                                                    "id": "730702016",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样…所以说，梦中的桓那兰那，一直在梦里，也是因为那棵树？"
                                                },
                                                {
                                                    "id": "730702017",
                                                    "speaker": "兰罗摩",
                                                    "text": "因为梦之树。但是，我现在好担心无留陀的事情。之后，要和大家一起想办法才行…"
                                                },
                                                {
                                                    "id": "730702018",
                                                    "speaker": "兰罗摩",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "730702019",
                                                    "speaker": "兰罗摩",
                                                    "text": "#不过还是先结出惟耶之实再说吧！因为，要帮助那菈{NICKNAME}、派蒙和兰拉娜的朋友才行！"
                                                },
                                                {
                                                    "id": "730702020",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！兰罗摩接下来也要去找觉树之堂吗？"
                                                },
                                                {
                                                    "id": "730702021",
                                                    "speaker": "兰罗摩",
                                                    "text": "对！我们一定会再见的！"
                                                },
                                                {
                                                    "id": "730702022",
                                                    "speaker": "派蒙",
                                                    "text": "要注意安全哦，兰罗摩！"
                                                },
                                                {
                                                    "id": "730702023",
                                                    "speaker": "兰罗摩",
                                                    "text": "#你们也是，那菈{NICKNAME}、派蒙！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730702014",
                                            "text": "觉王的梦之树让梦跑不掉？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730702006",
                            "text": "还好啦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307004",
            "objective": "与兰罗摩对话",
            "dialogues": [
                {
                    "id": "730700401",
                    "speaker": "派蒙",
                    "text": "兰罗摩！我们又见面啦！"
                },
                {
                    "id": "730700402",
                    "speaker": "兰罗摩",
                    "text": "#嗯！那菈{NICKNAME}、派蒙，你们好。这位是兰修提袈。"
                },
                {
                    "id": "730700403",
                    "speaker": "兰修提袈",
                    "text": "#哇！那菈{NICKNAME}、派蒙，很高兴认识你们！和诗歌里说的一样，金色的那菈，又高又强壮！"
                },
                {
                    "id": "730700404",
                    "speaker": "派蒙",
                    "text": "我也很高兴！兰修提袈是兰罗摩的朋友吗？"
                },
                {
                    "id": "730700405",
                    "speaker": "兰罗摩",
                    "text": "嗯！兰修提袈是「采歌者」，经常去收集各种各样的歌曲。"
                },
                {
                    "id": "730700406",
                    "speaker": "兰罗摩",
                    "text": "在种子变成树苗之前，我们还一起藏在树叶里，到草王的大树里去，看那菈一边喝会让他们变笨的水，一边唱歌！"
                },
                {
                    "id": "730700407",
                    "speaker": "兰修提袈",
                    "text": "#那菈{NICKNAME}、派蒙，有诗歌吗？"
                },
                {
                    "id": "730700408",
                    "speaker": "派蒙",
                    "text": "诗歌吗…如果是那个绿色的家伙，应该知道不少吧！"
                },
                {
                    "id": "730700409",
                    "speaker": "兰修提袈",
                    "text": "绿色的家伙？暝彩鸟？蕈猪？"
                },
                {
                    "id": "730700410",
                    "speaker": "派蒙",
                    "text": "不是不是！他是蒙德的风神，是吟游诗人哦。"
                },
                {
                    "id": "730700411",
                    "speaker": "兰修提袈",
                    "text": "哇！那一定知道很多歌！"
                },
                {
                    "id": "730700412",
                    "speaker": "兰罗摩",
                    "text": "好厉害！风神一定能把诗歌用风吹到很远很远的地方！"
                },
                {
                    "id": "730700413",
                    "speaker": "派蒙",
                    "text": "嗯！不过话说回来，这里是觉树之堂吗？"
                },
                {
                    "id": "730700414",
                    "speaker": "兰罗摩",
                    "text": "啊。不是的，但这也是很厉害的发现。在这里，沉睡着很多年没有兰那罗找到的歌。"
                },
                {
                    "id": "730700415",
                    "speaker": "兰罗摩",
                    "text": "兰那罗的采歌者，会一直一直追求歌的美丽。所以，在时间的最后，会把只属于自己的歌留下。",
                    "choices": [
                        {
                            "id": "730700416",
                            "text": "那和觉树之堂有关吗？",
                            "response": [
                                {
                                    "id": "730700417",
                                    "speaker": "兰修提袈",
                                    "text": "这边似乎是有兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了！"
                                },
                                {
                                    "id": "730700420",
                                    "speaker": "派蒙",
                                    "text": "莎兰树…之前兰拉迦好像说过，就是那个什么来着，我看看森林书…"
                                },
                                {
                                    "id": "730700421",
                                    "speaker": "派蒙",
                                    "text": "#莎兰树！就是能结出恒素果的莎兰树！我们也帮忙吧，{NICKNAME}！"
                                },
                                {
                                    "id": "730700422",
                                    "speaker": "兰罗摩",
                                    "text": "太好了！能和那菈一起研究过去的歌！"
                                },
                                {
                                    "id": "730700423",
                                    "speaker": "兰修提袈",
                                    "text": "兰玛哈很喜欢这种玫瑰，但用玫瑰将诗歌藏起来的办法是兰雅玛发现的！因为兰雅玛很骄傲，所以他的玫瑰也很骄傲。"
                                },
                                {
                                    "id": "730700424",
                                    "speaker": "兰修提袈",
                                    "text": "所以，玫瑰不会自己告诉我们。只有聪明的兰那罗，或者聪明的那菈，才能够找到隐藏的歌。但是兰修提袈不够聪明…"
                                },
                                {
                                    "id": "730700425",
                                    "speaker": "派蒙",
                                    "text": "#不用担心！哼哼，{NICKNAME}可是很聪明的。",
                                    "choices": [
                                        {
                                            "id": "730700426",
                                            "text": "既然是为了帮助拉娜…",
                                            "response": [
                                                {
                                                    "id": "730700428",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！找东西嘛，我们很擅长的，对吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730700427",
                                            "text": "哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730700418",
                            "text": "祝你们好运。",
                            "response": [
                                {
                                    "id": "730700419",
                                    "speaker": "兰罗摩",
                                    "text": "#嗯！谢谢那菈{NICKNAME}。这边似乎是兰玛哈留下的歌。如果是这样的话，附近应该就有莎兰树了。运气很好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
