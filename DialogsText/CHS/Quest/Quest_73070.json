        {
            "id": "7307011",
            "objective": "依照蔷薇的图形，弹奏乐曲",
            "dialogues": []
        },
        {
            "id": "7307006",
            "objective": "与兰罗摩、兰修提袈对话",
            "dialogues": [
                {
                    "id": "730700601",
                    "speaker": "兰修提袈",
                    "text": "「来呀，来呀，苗圃的梦想，树叶的记忆…」"
                },
                {
                    "id": "730700602",
                    "speaker": "兰罗摩",
                    "text": "「看，宝石一般的石榴，余晖色的日落果…」"
                },
                {
                    "id": "730700603",
                    "speaker": "兰罗摩",
                    "text": "原来如此，兰纳迦他们的歌，和兰玛哈的歌是同源的…"
                },
                {
                    "id": "730700604",
                    "speaker": "派蒙",
                    "text": "同源是指…？"
                },
                {
                    "id": "730700605",
                    "speaker": "兰修提袈",
                    "text": "歌就像河川一样。他们一开始，都在一起，那就是「源之歌」，她是所有歌的故乡、大河的源头。"
                },
                {
                    "id": "730700606",
                    "speaker": "兰修提袈",
                    "text": "后来，又因为不同的记忆、不同的故事，所以唱出来以后，发生变化。就像河流变成小溪。"
                },
                {
                    "id": "730700607",
                    "speaker": "兰修提袈",
                    "text": "但所有的小溪都会流入大海，所有的歌最终也会汇聚成同一首，回归成源之歌。"
                },
                {
                    "id": "730700608",
                    "speaker": "兰修提袈",
                    "text": "#所以，采歌的兰那罗，要找到所有的歌。这样的话，就能找到源之歌。谢谢你，那菈{NICKNAME}、派蒙，找到了兰玛哈的歌。",
                    "choices": [
                        {
                            "id": "730700609",
                            "text": "真是了不起的愿望。",
                            "response": [
                                {
                                    "id": "730700610",
                                    "speaker": "兰修提袈",
                                    "text": "#谢谢那菈{NICKNAME}！"
                                },
                                {
                                    "id": "730700611",
                                    "speaker": "派蒙",
                                    "text": "嗯…歌一直会变多，还会改变，那要怎样才能找到所有的歌呀？"
                                },
                                {
                                    "id": "730700613",
                                    "speaker": "兰修提袈",
                                    "text": "兰那罗也会增加。所以，只要一直努力，一定没问题的！"
                                },
                                {
                                    "id": "730700614",
                                    "speaker": "兰罗摩",
                                    "text": "兰玛哈的歌，能够吸引健壮的草种子。他的觉树之堂，应该也是这样封印的。"
                                },
                                {
                                    "id": "730700615",
                                    "speaker": "兰罗摩",
                                    "text": "#既然那菈{NICKNAME}找到了他的歌，我们就能到觉树之堂了！"
                                },
                                {
                                    "id": "730700616",
                                    "speaker": "兰修提袈",
                                    "text": "#嗯！祝你们好运，那菈{NICKNAME}、派蒙，还有兰罗摩！我先去为无忧节做准备啦！"
                                },
                                {
                                    "id": "730700617",
                                    "speaker": "派蒙",
                                    "text": "交给我们吧！无忧节再见，兰修提袈！"
                                },
                                {
                                    "id": "730700618",
                                    "speaker": "兰修提袈",
                                    "text": "再见！"
                                }
                            ]
                        },
                        {
                            "id": "730700612",
                            "text": "歌是会不断增加的…"
                        }
                    ]
                }
            ]
        },
        {
