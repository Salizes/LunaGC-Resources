    "talks": [
        {
            "id": "7408701",
            "objective": "前往「科学院宿舍」",
            "dialogues": []
        },
        {
            "id": "7408702",
            "objective": "和纳克对话",
            "dialogues": [
                {
                    "id": "740870201",
                    "speaker": "克洛妮艾",
                    "text": "研究员平时就在这种地方休息吗？这合乎人道吗？枫丹科学院有考虑过优先修缮此处吗？"
                },
                {
                    "id": "740870202",
                    "speaker": "纳克",
                    "text": "…这里应该有一枚「勘测桩锚」。正如克洛妮艾小姐暗示的，此处亟待修缮，储能装置的数量十分有限，或者说，短缺。"
                },
                {
                    "id": "740870203",
                    "speaker": "纳克",
                    "text": "#在我为克洛妮艾小姐答疑期间，回收「勘测桩锚」的工作就拜托{NICKNAME}了。"
                }
            ]
        },
        {
            "id": "7408703",
            "objective": "取回「勘测桩锚」",
            "dialogues": [
                {
                    "id": "740870301",
                    "speaker": "纳克",
                    "text": "「宿舍」相对其他区域，可以说没有被爆炸影响太多。"
                },
                {
                    "id": "740870302",
                    "speaker": "克洛妮艾",
                    "text": "宿舍？但这里连一张床都没有，研究员要怎么休息？他们总不能坐在椅子上睡觉吧。"
                },
                {
                    "id": "740870303",
                    "speaker": "纳克",
                    "text": "克洛妮艾小姐，你所理解的「休息」和研究员们所需的「休息」不太一样。"
                },
                {
                    "id": "740870304",
                    "speaker": "纳克",
                    "text": "当一个枫丹科学院的研究员说自己需要休息时，他实际上只是想让自己的头脑稍微停歇一会。"
                },
                {
                    "id": "740870305",
                    "speaker": "纳克",
                    "text": "然后，他一般就会来到这里，弹弹琴、看看闲书、有必要的话再喝两杯。"
                },
                {
                    "id": "740870306",
                    "speaker": "克洛妮艾",
                    "text": "呃…但在我看来，直接睡一觉不是更能让头脑得到休息吗？"
                },
                {
                    "id": "740870307",
                    "speaker": "纳克",
                    "text": "这话说得没错。但…对于我们研究员来说，睡觉首先太过浪费时间。"
                },
                {
                    "id": "740870308",
                    "speaker": "克洛妮艾",
                    "text": "睡觉也算是浪费时间吗？这是必要的休息呀！"
                },
                {
                    "id": "740870309",
                    "speaker": "纳克",
                    "text": "睡觉会完全打断我们的研究思路，这对研究工作来说实在太不可接受了。",
                    "choices": [
                        {
                            "id": "740870310",
                            "text": "（继续听下去…）",
                            "response": [
                                {
                                    "id": "740870312",
                                    "speaker": "克洛妮艾",
                                    "text": "你是认真的吗？不睡觉的话，被打断的就是生命了。"
                                },
                                {
                                    "id": "740870313",
                                    "speaker": "纳克",
                                    "text": "那可不会，之前院里可是有着优秀的医疗保障，保证一个研究员的健康不成问题。"
                                },
                                {
                                    "id": "740870314",
                                    "speaker": "克洛妮艾",
                                    "text": "这也不是不睡觉的理由吧？"
                                },
                                {
                                    "id": "740870315",
                                    "speaker": "克洛妮艾",
                                    "text": "而且…那些研究员来这里不就是暂时让头脑歇息吗？研究思路本来就是中断着的呀。"
                                },
                                {
                                    "id": "740870316",
                                    "speaker": "纳克",
                                    "text": "那可不会。说是让头脑暂时停歇，但实际上他们还是本能地在思考着学术问题。"
                                },
                                {
                                    "id": "740870317",
                                    "speaker": "纳克",
                                    "text": "就像是在一片广阔的大海上，虽然它表面上的波涛暂歇，但在深处依然有暗流涌动。"
                                },
                                {
                                    "id": "740870318",
                                    "speaker": "纳克",
                                    "text": "有时候，这种暗流所蕴含的力量，会比表面上的波涛更巨大啊。"
                                },
                                {
                                    "id": "740870319",
                                    "speaker": "克洛妮艾",
                                    "text": "我理解了，您的意思就是，如果枫丹科学院的研究员正在研究，那他们就只能一直研究，不得休息，对吧？"
                                },
                                {
                                    "id": "740870320",
                                    "speaker": "纳克",
                                    "text": "这说法不客观，如果真的需要睡觉的话，他们大可以回去自己家里睡觉。"
                                },
                                {
                                    "id": "740870321",
                                    "speaker": "克洛妮艾",
                                    "text": "那就是，枫丹科学院的研究员如果处于枫丹科学院内，那就只能一直研究，不得休息。"
                                },
                                {
                                    "id": "740870322",
                                    "speaker": "纳克",
                                    "text": "您的修辞学水平真是让我赞叹不已，克洛妮艾小姐。"
                                }
                            ]
                        },
                        {
                            "id": "740870311",
                            "text": "（还是别听了吧…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7408704",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        }
    ]
