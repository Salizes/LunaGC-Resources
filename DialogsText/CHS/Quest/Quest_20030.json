    "talks": [
        {
            "id": "2003001",
            "objective": "(test)派蒙开车$HIDDEN",
            "dialogues": [
                {
                    "id": "200300101",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到<color=#00E1FFFF>冒险家协会</color>，我已经观察你很久了。"
                },
                {
                    "id": "200300102",
                    "speaker": "派蒙",
                    "text": "#观察{NICKNAME}？难道我的伙伴做了什么奇怪的事吗？"
                },
                {
                    "id": "200300103",
                    "speaker": "凯瑟琳",
                    "text": "没有没有，发现优秀的冒险者，这也是我的工作之一。"
                },
                {
                    "id": "200300104",
                    "speaker": "凯瑟琳",
                    "text": "从你的身上，我能看到与那些传说中的冒险家比肩的资质。"
                },
                {
                    "id": "200300105",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这个我也看得出来。"
                },
                {
                    "id": "200300106",
                    "speaker": "派蒙",
                    "text": "#跟着{NICKNAME}冒险，总感觉很安心。"
                },
                {
                    "id": "200300107",
                    "speaker": "凯瑟琳",
                    "text": "嗯嗯，不过对冒险家来说，阅历比资质更加重要。"
                },
                {
                    "id": "200300108",
                    "speaker": "凯瑟琳",
                    "text": "只有不断积累<color=#00E1FFFF>「冒险阅历」</color>，才能提高<color=#00E1FFFF>「冒险等阶」</color>的评定。"
                },
                {
                    "id": "200300109",
                    "speaker": "凯瑟琳",
                    "text": "事不宜迟，就由我为刚入籍的冒险家介绍一下…"
                },
                {
                    "id": "200300110",
                    "speaker": "派蒙",
                    "text": "等一下！我们已经成为正式冒险家了吗？"
                },
                {
                    "id": "200300111",
                    "speaker": "凯瑟琳",
                    "text": "放心，冒险家协会无需会费，也更不会强制冒险家履行什么义务。"
                },
                {
                    "id": "200300112",
                    "speaker": "凯瑟琳",
                    "text": "换句话说，加入协会是只有好处，没有坏处的哦。",
                    "choices": [
                        {
                            "id": "200300113",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "200300116",
                                    "speaker": "凯瑟琳",
                                    "text": "总之，每当「冒险等阶」提升，冒险家协会都会提供奖励。"
                                },
                                {
                                    "id": "200300117",
                                    "speaker": "凯瑟琳",
                                    "text": "这就当做协会的新人礼了，请你亲自确认一下吧。"
                                },
                                {
                                    "id": "200300118",
                                    "speaker": "Player",
                                    "text": "冒险等阶奖励"
                                }
                            ]
                        },
                        {
                            "id": "200300114",
                            "text": "我现在就要好处！",
                            "response": [
                                {
                                    "id": "200300115",
                                    "speaker": "凯瑟琳",
                                    "text": "哈哈…现在的新人怎么变得这么直接了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003002",
            "objective": "(test)与凯瑟琳对话，询问详情$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2003003",
            "objective": "(test)与凯瑟琳对话，询问详情$HIDDEN",
            "dialogues": [
                {
                    "id": "200300201",
                    "speaker": "凯瑟琳",
                    "text": "那么容我正式欢迎你的加入，冒险家新星！"
                },
                {
                    "id": "200300202",
                    "speaker": "凯瑟琳",
                    "text": "这是你的<color=#00E1FFFF>「冒险之证」</color>。",
                    "choices": [
                        {
                            "id": "200300203",
                            "text": "还有证书？",
                            "response": [
                                {
                                    "id": "200300204",
                                    "speaker": "凯瑟琳",
                                    "text": "新人加入这么重要的事，当然要有仪式感。"
                                },
                                {
                                    "id": "200300207",
                                    "speaker": "凯瑟琳",
                                    "text": "这上面记载了很多关于协会的委托和奖励的信息。"
                                },
                                {
                                    "id": "200300208",
                                    "speaker": "凯瑟琳",
                                    "text": "同时这也是会员的证明，记得多多查看并妥善保管哦。"
                                },
                                {
                                    "id": "200300209",
                                    "speaker": "凯瑟琳",
                                    "text": "对了，还有一件事。"
                                },
                                {
                                    "id": "200300210",
                                    "speaker": "凯瑟琳",
                                    "text": "「冒险等阶」的提升是会有瓶颈存在的。"
                                },
                                {
                                    "id": "200300211",
                                    "speaker": "凯瑟琳",
                                    "text": "到那时就需要完成一些「令人印象深刻的任务」来得到协会的进一步认可。"
                                },
                                {
                                    "id": "200300212",
                                    "speaker": "派蒙",
                                    "text": "令人印象深刻…的任务？"
                                },
                                {
                                    "id": "200300213",
                                    "speaker": "凯瑟琳",
                                    "text": "可以说是用来突破「冒险等阶」上限的「突破任务」吧。"
                                },
                                {
                                    "id": "200300214",
                                    "speaker": "凯瑟琳",
                                    "text": "现在还不是时候，当你的「阅历」足够丰富，自然就会有博得大家认可的机会。"
                                },
                                {
                                    "id": "200300215",
                                    "speaker": "凯瑟琳",
                                    "text": "那么今天就先这样吧，以后我们应该还会经常见面的。"
                                },
                                {
                                    "id": "200300216",
                                    "speaker": "凯瑟琳",
                                    "text": "努力吧冒险家，向着星辰与深渊！"
                                }
                            ]
                        },
                        {
                            "id": "200300205",
                            "text": "这是…宣传手册？",
                            "response": [
                                {
                                    "id": "200300206",
                                    "speaker": "凯瑟琳",
                                    "text": "这么说也可以，但它的功能性更强。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003004",
