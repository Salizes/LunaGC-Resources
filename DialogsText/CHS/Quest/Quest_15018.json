    "talks": [
        {
            "id": "1501801",
            "objective": "和路边的少女交谈",
            "dialogues": [
                {
                    "id": "150180201",
                    "speaker": "派蒙",
                    "text": "原来你就是瓦雷莎，我们听过这个名字！"
                },
                {
                    "id": "150180202",
                    "speaker": "派蒙",
                    "text": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我们是最好的伙伴。"
                },
                {
                    "id": "150180203",
                    "speaker": "瓦雷莎",
                    "text": "#好的，派蒙和{NICKNAME}，真是不错的名字，我记住了。"
                },
                {
                    "id": "150180204",
                    "speaker": "派蒙",
                    "text": "那我们这就出发吧！"
                }
            ]
        },
        {
            "id": "1501802",
            "objective": "跟随瓦雷莎",
            "dialogues": []
        },
        {
            "id": "1501808",
            "objective": "与瓦雷莎交谈",
            "dialogues": [
                {
                    "id": "150180101",
                    "speaker": "派蒙",
                    "text": "这个立在路边的木板是干什么用的？"
                },
                {
                    "id": "150180107",
                    "speaker": "瓦雷莎",
                    "text": "哦，这是我们部族的健身器材，我也经常用。"
                },
                {
                    "id": "150180108",
                    "speaker": "派蒙",
                    "text": "健身器材？"
                },
                {
                    "id": "150180109",
                    "speaker": "瓦雷莎",
                    "text": "嗯，我想想…比起解释还是直接演示一下更快。瓦雷莎，要上了——"
                },
                {
                    "id": "150180103",
                    "speaker": "瓦雷莎",
                    "text": "平稳落地！"
                },
                {
                    "id": "150180104",
                    "speaker": "派蒙",
                    "text": "呜哇啊啊，就这么跳过去了，你好厉害啊！"
                },
                {
                    "id": "150180105",
                    "speaker": "瓦雷莎",
                    "text": "没什么，没什么，只要多加练习，很多人都可以做得到。"
                },
                {
                    "id": "150180110",
                    "speaker": "瓦雷莎",
                    "text": "哦！你甚至都不需要训练，直接飞过来就好，这不是比我厉害多了嘛。"
                },
                {
                    "id": "150180112",
                    "speaker": "派蒙",
                    "text": "这不一样啦…嗯，但你说的有道理！"
                }
            ]
        },
        {
            "id": "1501805",
            "objective": "沿道路前进",
            "dialogues": [
                {
                    "id": "150180501",
                    "speaker": "派蒙",
                    "text": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我们是最好的伙伴。"
                },
                {
                    "id": "150180502",
                    "speaker": "瓦雷莎",
                    "text": "#好的，派蒙和{NICKNAME}，真是不错的名字，我记住了。"
                },
                {
                    "id": "150180503",
                    "speaker": "派蒙",
                    "text": "那我们这就出发吧！"
                }
            ]
        },
        {
            "id": "1501803",
            "objective": "沿道路继续前进",
            "dialogues": [
                {
                    "id": "150180301",
                    "speaker": "派蒙",
                    "text": "你好，请问…"
                },
                {
                    "id": "150180303",
                    "speaker": "？？？",
                    "text": "嗯？"
                },
                {
                    "id": "150180304",
                    "speaker": "？？？",
                    "text": "你们是不是迷路了？需要我帮忙吗？"
                },
                {
                    "id": "150180305",
                    "speaker": "派蒙",
                    "text": "没有没有，我们只是正巧路过这里，想去「沃陆之邦」看看…请问是往这个方向去吗？"
                },
                {
                    "id": "150180306",
                    "speaker": "？？？",
                    "text": "没错，那里是我的家，如果需要的话，现在我就能带你们过去。"
                },
                {
                    "id": "150180307",
                    "speaker": "派蒙",
                    "text": "#太好了，{NICKNAME}，又遇到了当地的向导！"
                },
                {
                    "id": "150180308",
                    "speaker": "Player",
                    "text": "你想偷懒的语气太明显了。"
                },
                {
                    "id": "150180309",
                    "speaker": "？？？",
                    "text": "向导啊…我应该没问题吧，嘿嘿，那我现在就是你们的向导。"
                },
                {
                    "id": "150180310",
                    "speaker": "？？？",
                    "text": "这一路上有很多特别的风景，我可以帮你们介绍，几乎每个刚来我们这里的人，都会发出「哇哦——」的感叹呢。"
                },
                {
                    "id": "150180311",
                    "speaker": "派蒙",
                    "text": "谢谢你的好意，不过等等…你接受得这么快，我反而有点愧疚…呃，没关系吗？会不会耽误你本来要做的事？"
                },
                {
                    "id": "150180312",
                    "speaker": "？？？",
                    "text": "没关系没关系，我本来是到这边训练的，正好打算收拾东西回家，我们也算顺路。"
                },
                {
                    "id": "150180313",
                    "speaker": "？？？",
                    "text": "而且我来当向导的话，你们会了解更多这里的风土人情，收获很多新知识，就会很开心对吧！"
                },
                {
                    "id": "150180314",
                    "speaker": "？？？",
                    "text": "你们开心的话，我就会开心。阿卡特叔叔说，这叫「待客之道」。"
                },
                {
                    "id": "150180315",
                    "speaker": "派蒙",
                    "text": "好、好吧…"
                },
                {
                    "id": "150180316",
                    "speaker": "派蒙",
                    "text": "感觉是个单纯又热情的人呢。"
                },
                {
                    "id": "150180317",
                    "speaker": "Player",
                    "text": "运气挺好的。"
                },
                {
                    "id": "150180318",
                    "speaker": "派蒙",
                    "text": "是吧，我也这样觉得，我喜欢她！"
                },
                {
                    "id": "150180319",
                    "speaker": "？？？",
                    "text": "怎么啦，如果准备好了的话，我们就出发吧。"
                },
                {
                    "id": "150180320",
                    "speaker": "派蒙",
                    "text": "对了，还没有问你叫什么名字呢。"
                },
                {
                    "id": "150180321",
                    "speaker": "瓦雷莎",
                    "text": "对哦，我叫瓦雷莎，很高兴认识你们！"
                }
            ]
        },
        {
            "id": "1501804",
            "objective": "继续前进",
            "dialogues": [
                {
                    "id": "150180401",
                    "speaker": "派蒙",
                    "text": "你好，请问…"
                },
                {
                    "id": "150180403",
                    "speaker": "？？？",
                    "text": "嗯？"
                },
                {
                    "id": "150180404",
                    "speaker": "？？？",
                    "text": "#你们…难道就是派蒙和{NICKNAME}？！终于等到你们了！"
                },
                {
                    "id": "150180405",
                    "speaker": "派蒙",
                    "text": "哇啊！你认识我们？原来我们名声已经这么响了啊。"
                },
                {
                    "id": "150180406",
                    "speaker": "派蒙",
                    "text": "不过…我们来「沃陆之邦」这件事难道和谁说过吗？"
                },
                {
                    "id": "150180407",
                    "speaker": "？？？",
                    "text": "欸，你们不知道？伊安珊老师和我说邀请你们来「沃陆之邦」做客，所以我很早就在这里边训练边等了。"
                },
                {
                    "id": "150180408",
                    "speaker": "？？？",
                    "text": "你们真的来了…嘿嘿，居然真的来了，太好了。"
                },
                {
                    "id": "150180409",
                    "speaker": "派蒙",
                    "text": "也、也不用这么激动吧？"
                },
                {
                    "id": "150180410",
                    "speaker": "？？？",
                    "text": "你们可是对抗深渊的英雄啊，事迹已经传遍纳塔了，我听了好几遍「杜麦{RUBY#[S]希望}尼」的故事，印象深刻！"
                },
                {
                    "id": "150180411",
                    "speaker": "瓦雷莎",
                    "text": "从伊安珊老师说你们可能会来「沃陆之邦」开始，我就特别期待！哦，对了，我叫瓦雷莎，伊安珊老师应该提过我的名字吧？"
                },
                {
                    "id": "150180412",
                    "speaker": "派蒙",
                    "text": "啊，我有印象！"
                },
                {
                    "id": "150180413",
                    "speaker": "派蒙",
                    "text": "那个时候深渊打进来，我们问伊安珊需不需要回「沃陆之邦」支援，她说瓦雷莎已经把那边的威胁解决了。",
                    "choices": [
                        {
                            "id": "150180414",
                            "text": "这么说你也很厉害。",
                            "response": [
                                {
                                    "id": "150180416",
                                    "speaker": "瓦雷莎",
                                    "text": "没有啦，还是阿卡特叔叔指挥得好，我只是清理了一些魔物而已。"
                                },
                                {
                                    "id": "150180417",
                                    "speaker": "瓦雷莎",
                                    "text": "想想那时候发生的事，还是觉得有点后怕呢…"
                                },
                                {
                                    "id": "150180418",
                                    "speaker": "瓦雷莎",
                                    "text": "不过现在这些已经结束了，「沃陆之邦」受到的影响比较小，重建也已经完成，我们部族的人最近都在到处支援。"
                                },
                                {
                                    "id": "150180419",
                                    "speaker": "瓦雷莎",
                                    "text": "嘿嘿，就让我带你们去部族的营地看看吧。"
                                },
                                {
                                    "id": "150180420",
                                    "speaker": "派蒙",
                                    "text": "好啊，这就出发吧！"
                                }
                            ]
                        },
                        {
                            "id": "150180415",
                            "text": "是名副其实的英雄。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1501806",
            "objective": "继续前进，抵达「沃陆之邦」",
            "dialogues": []
        },
        {
            "id": "1501807",
            "objective": "与瓦雷莎交谈",
            "dialogues": [
                {
                    "id": "150180801",
                    "speaker": "瓦雷莎",
                    "text": "我们终于到了，这里就是「沃陆之邦」的部族营地，也就是我的家。"
                },
                {
                    "id": "150180814",
                    "speaker": "派蒙",
                    "text": "哇啊，好壮观，那个牛头形状的高台真气派，我很喜欢！"
                },
                {
                    "id": "150180802",
                    "speaker": "瓦雷莎",
                    "text": "嘿嘿，那个叫「逐响擂台」，是我们举办各种比赛的地方。"
                },
                {
                    "id": "150180803",
                    "speaker": "Player",
                    "text": "谢谢你带我们来。"
                },
                {
                    "id": "150180804",
                    "speaker": "瓦雷莎",
                    "text": "不客气不客气，小事一桩。"
                },
                {
                    "id": "150180815",
                    "speaker": "瓦雷莎",
                    "text": "我很想带你们在这里好好转一圈，但是我要先回家一趟。"
                },
                {
                    "id": "150180816",
                    "speaker": "派蒙",
                    "text": "想起什么重要的事了吗？刚刚丘丘人出现的时候，就感觉你好像很着急…"
                },
                {
                    "id": "150180817",
                    "speaker": "Player",
                    "text": "希望没耽误你。"
                },
                {
                    "id": "150180818",
                    "speaker": "瓦雷莎",
                    "text": "不耽误不耽误，时间上正正好好！不过这件事确实挺重要，训练后最重要的事就是——吃饭！"
                },
                {
                    "id": "150180805",
                    "speaker": "瓦雷莎",
                    "text": "饿了肚子，就会有气无力，头晕目眩，精神涣散，胡思乱想，可谓是坏处多多，一定要警惕。"
                },
                {
                    "id": "150180806",
                    "speaker": "瓦雷莎",
                    "text": "实在抱歉，我必须首先，立刻，马上吃饭！你们也快去吃饭吧——"
                },
                {
                    "id": "150180807",
                    "speaker": "瓦雷莎",
                    "text": "之后我们「逐响擂台」再见，我先走一步！"
                },
                {
                    "id": "150180808",
                    "speaker": "派蒙",
                    "text": "瓦雷莎走掉了…"
                },
                {
                    "id": "150180809",
                    "speaker": "派蒙",
                    "text": "怎么说呢，真是个神奇的人，有时候软绵绵的，有时候又横冲直撞…"
                },
                {
                    "id": "150180810",
                    "speaker": "Player",
                    "text": "这叫「青春」。"
                },
                {
                    "id": "150180811",
                    "speaker": "派蒙",
                    "text": "「这叫『青春』」…干嘛突然说只有老头子才会说的话啊，我们还年轻呢！"
                },
                {
                    "id": "150180812",
                    "speaker": "派蒙",
                    "text": "既然她回家去了，我们就先自己逛逛吧，等会儿再去「逐响擂台」等她。"
                },
                {
                    "id": "150180813",
                    "speaker": "派蒙",
                    "text": "那么高的地方，视野一定超级好！"
                }
            ]
        }
    ]
}