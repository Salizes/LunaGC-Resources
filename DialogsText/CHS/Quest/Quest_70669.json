            "dialogues": [
                {
                    "id": "706660101",
                    "speaker": "Player",
                    "text": "进行突破挑战！"
                },
                {
                    "id": "706660102",
                    "speaker": "「小王子」",
                    "text": "#喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，{NICKNAME}确实已经拥有了挑战的资格，那我这就…」"
                },
                {
                    "id": "706660103",
                    "speaker": "「小王子」",
                    "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
                }
            ]
        },
        {
            "id": "7066903",
            "objective": "与「小王子」进行突破对局",
            "dialogues": []
        },
        {
            "id": "7066904",
            "objective": "与「小王子」对话",
            "dialogues": [
                {
                    "id": "706690201",
                    "speaker": "「小王子」",
                    "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是传说牌手了！」"
                },
                {
                    "id": "706690202",
                    "speaker": "「小王子」",
                    "text": "喵…「传说牌手是个了不起的头衔呢…」"
                },
                {
                    "id": "706690203",
                    "speaker": "「小王子」",
                    "text": "#「希望{NICKNAME}以后也能继续精进自己的牌技！要成为不辜负传说牌手这一头衔的了不起的牌手！」"
                },
                {
                    "id": "706690204",
                    "speaker": "「小王子」",
                    "text": "「事到如今再说或许有点多余了，但是…」"
                },
                {
                    "id": "706690205",
                    "speaker": "「小王子」",
                    "text": "#「{NICKNAME}，希望你能感受到『七圣召唤』的乐趣！」"
                }
            ]
        },
        {
            "id": "7066603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706660301",
                    "speaker": "「小王子」",
                    "text": "#喵…「嗯，{NICKNAME}得要再小心一点才行啊，先调整一下，之后再来挑战吧？」"
                },
                {
                    "id": "706660302",
                    "speaker": "「小王子」",
                    "text": "「我相信你是有足以完成试炼的实力的…」"
                }
            ]
        }
    ]
