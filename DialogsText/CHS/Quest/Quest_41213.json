    "talks": [
        {
            "id": "4121301",
            "objective": "寻找阿贝多",
            "dialogues": [
                {
                    "id": "412130101",
                    "speaker": "派蒙",
                    "text": "阿贝多！我们又——来啦！"
                },
                {
                    "id": "412130102",
                    "speaker": "派蒙",
                    "text": "嗯？阿贝多好像不在？"
                },
                {
                    "id": "412130103",
                    "speaker": "派蒙",
                    "text": "是出去调查了吗，还是又去画神秘写生了呢…"
                },
                {
                    "id": "412130104",
                    "speaker": "砂糖",
                    "text": "啊！是你们！"
                },
                {
                    "id": "412130105",
                    "speaker": "派蒙",
                    "text": "这不是砂糖吗，你怎么在这里？"
                },
                {
                    "id": "412130106",
                    "speaker": "砂糖",
                    "text": "我的研究刚告一段落，今天有五小时二十六分左右的空闲时间。"
                },
                {
                    "id": "412130107",
                    "speaker": "砂糖",
                    "text": "所以，就来找你们打听之前委托的事了！"
                },
                {
                    "id": "412130108",
                    "speaker": "派蒙",
                    "text": "好精确的时间，你是人型钟表吗？"
                },
                {
                    "id": "412130109",
                    "speaker": "砂糖",
                    "text": "不不不，这没什么值得夸奖的，你太客气了…"
                },
                {
                    "id": "412130110",
                    "speaker": "派蒙",
                    "text": "人家没有在夸你啦！"
                },
                {
                    "id": "412130111",
                    "speaker": "砂糖",
                    "text": "旅行者，我、我可以问吗？之前拜托你去调查阿贝多先生隐瞒的事，进展得还顺利吗？"
                },
                {
                    "id": "412130112",
                    "speaker": "派蒙",
                    "text": "如果我的感官没有出问题，那已经是一个多星期前的事了哦。"
                },
                {
                    "id": "412130113",
                    "speaker": "Player",
                    "text": "还以为你已经忘了。"
                },
                {
                    "id": "412130114",
                    "speaker": "砂糖",
                    "text": "什么…！！"
                },
                {
                    "id": "412130115",
                    "speaker": "砂糖",
                    "text": "一、一个多星期？！我明明…啊！"
                },
                {
                    "id": "412130116",
                    "speaker": "砂糖",
                    "text": "呜，我太沉迷实验，完全忽略了这件事…"
                },
                {
                    "id": "412130117",
                    "speaker": "派蒙",
                    "text": "该说她的时间观念太强呢，还是太弱呢…"
                },
                {
                    "id": "412130118",
                    "speaker": "砂糖",
                    "text": "所、所以！你已经知道答案了对吗？",
                    "choices": [
                        {
                            "id": "412130119",
                            "text": "嗯，可以这么说哦。",
                            "response": [
                                {
                                    "id": "412130121",
                                    "speaker": "砂糖",
                                    "text": "太好了，能说给我听吗？"
                                },
                                {
                                    "id": "412130122",
                                    "speaker": "Player",
                                    "text": "派蒙，你觉得呢？"
                                },
                                {
                                    "id": "412130123",
                                    "speaker": "派蒙",
                                    "text": "唔…告诉她应该不要紧吧？"
                                },
                                {
                                    "id": "412130124",
                                    "speaker": "派蒙",
                                    "text": "看看也行，只要不是触摸…"
                                },
                                {
                                    "id": "412130125",
                                    "speaker": "砂糖",
                                    "text": "等一下，你们在说什么呀？"
                                },
                                {
                                    "id": "412130126",
                                    "speaker": "砂糖",
                                    "text": "这是…？",
                                    "choices": [
                                        {
                                            "id": "412130127",
                                            "text": "这就是阿贝多隐瞒的事。",
                                            "response": [
                                                {
                                                    "id": "412130129",
                                                    "speaker": "派蒙",
                                                    "text": "是一把非常厉害的剑哦，不能用手碰。"
                                                },
                                                {
                                                    "id": "412130130",
                                                    "speaker": "砂糖",
                                                    "text": "嗯…这是…"
                                                },
                                                {
                                                    "id": "412130131",
                                                    "speaker": "砂糖",
                                                    "text": "！！这、这是！！我从未见过的…"
                                                },
                                                {
                                                    "id": "412130132",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，尽情欣赏吧！不知为什么，连我都有一种奇怪的成就感！"
                                                },
                                                {
                                                    "id": "412130133",
                                                    "speaker": "砂糖",
                                                    "text": "太厉害了，我还是第一次见到这么神奇的武器。"
                                                },
                                                {
                                                    "id": "412130134",
                                                    "speaker": "砂糖",
                                                    "text": "我能隐约感到有力量在剑的内部徐徐流动…它就像活着的生物一样。"
                                                },
                                                {
                                                    "id": "412130135",
                                                    "speaker": "派蒙",
                                                    "text": "这么具体的感觉吗？"
                                                },
                                                {
                                                    "id": "412130136",
                                                    "speaker": "砂糖",
                                                    "text": "也许是我学习过炼金术的缘故吧。"
                                                },
                                                {
                                                    "id": "412130137",
                                                    "speaker": "砂糖",
                                                    "text": "我不敢用太绝对的说辞，但确实有「流动」的感觉。虽然这说法很不严谨…本、本来我是不会用的。"
                                                },
                                                {
                                                    "id": "412130138",
                                                    "speaker": "砂糖",
                                                    "text": "请相信我，我平时绝不会用这么模棱两可的说法！"
                                                },
                                                {
                                                    "id": "412130139",
                                                    "speaker": "派蒙",
                                                    "text": "好好好，知道了。"
                                                },
                                                {
                                                    "id": "412130140",
                                                    "speaker": "砂糖",
                                                    "text": "旅行者，请问…你可以使用这把剑战斗吗？"
                                                },
                                                {
                                                    "id": "412130141",
                                                    "speaker": "砂糖",
                                                    "text": "我想多了解一些，但我不能使用它，只能拜托你了。",
                                                    "choices": [
                                                        {
                                                            "id": "412130142",
                                                            "text": "偷偷地，别让阿贝多知道哦。",
                                                            "response": [
                                                                {
                                                                    "id": "412130144",
                                                                    "speaker": "派蒙",
                                                                    "text": "那就到附近找合适的地点吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "412130143",
                                                            "text": "找个不容易被发现的地方比较好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412130128",
                                            "text": "这就是你想知道的答案。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412130120",
                            "text": "完全调查清楚了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121302",
