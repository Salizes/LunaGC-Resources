        {
            "id": "4121303",
            "objective": "前往怪物栖息地试剑",
            "dialogues": [
                {
                    "id": "412130301",
                    "speaker": "冒失的帕拉德",
                    "text": "呜呜…呜啊啊嗷嗷呜…"
                },
                {
                    "id": "412130302",
                    "speaker": "砂糖",
                    "text": "帕拉德先生？！"
                },
                {
                    "id": "412130303",
                    "speaker": "砂糖",
                    "text": "你、你还没回去吗？"
                },
                {
                    "id": "412130304",
                    "speaker": "派蒙",
                    "text": "这不是蒙德那个冒失鬼冒险家吗？他也跟着塞琉斯来雪山探险啊？"
                },
                {
                    "id": "412130305",
                    "speaker": "冒失的帕拉德",
                    "text": "冷冷冷死我了，阿嚏！"
                },
                {
                    "id": "412130306",
                    "speaker": "砂糖",
                    "text": "我把你从雪坑里救出来以后，你就一直在这里吗？！"
                },
                {
                    "id": "412130307",
                    "speaker": "冒失的帕拉德",
                    "text": "我也不想的，可是、可是我迷路了！抱歉…"
                },
                {
                    "id": "412130308",
                    "speaker": "冒失的帕拉德",
                    "text": "呜噗噗噗…冷死了，一步也走不动啦…"
                },
                {
                    "id": "412130309",
                    "speaker": "砂糖",
                    "text": "唉，帕拉德先生，你对雪山之旅太掉以轻心啦。"
                },
                {
                    "id": "412130310",
                    "speaker": "Player",
                    "text": "我们带他一起回去吧。"
                },
                {
                    "id": "412130311",
                    "speaker": "砂糖",
                    "text": "可以吗？他现在这样，恐怕要我们扶着才能走路了…"
                },
                {
                    "id": "412130312",
                    "speaker": "派蒙",
                    "text": "就算不可以，也不能把他丢在这里吧？"
                },
                {
                    "id": "412130313",
                    "speaker": "砂糖",
                    "text": "说得也是…抱歉呀旅行者，我、我替他向你道歉。"
                },
                {
                    "id": "412130314",
                    "speaker": "？？？",
                    "text": "还有心思考虑别人？先担心你自己吧！"
                },
                {
                    "id": "412130315",
                    "speaker": "派蒙",
                    "text": "啊！又是愚人众！"
                },
                {
                    "id": "412130316",
                    "speaker": "瓦京",
                    "text": "我们的来意，你们想必已经知道了。"
                },
                {
                    "id": "412130317",
                    "speaker": "瓦京",
                    "text": "交出那把剑，否则谁也别想离开这里！"
                },
                {
                    "id": "412130318",
                    "speaker": "砂糖",
                    "text": "不行，请不要把剑交给他们！",
                    "choices": [
                        {
                            "id": "412130319",
                            "text": "当然不会交给他们了！",
                            "response": [
                                {
                                    "id": "412130321",
                                    "speaker": "派蒙",
                                    "text": "好有气势！一鼓作气把他们打翻！"
                                },
                                {
                                    "id": "412130322",
                                    "speaker": "砂糖",
                                    "text": "帕拉德先生，我带你到安全的地方去！快来！"
                                },
                                {
                                    "id": "412130323",
                                    "speaker": "瓦京",
                                    "text": "天真，所有知情人一个都别想跑！"
                                },
                                {
                                    "id": "412130324",
                                    "speaker": "瓦京",
                                    "text": "这把剑将被作为礼物，献给尊贵的执行官「女士」大人！"
                                }
                            ]
                        },
                        {
                            "id": "412130320",
                            "text": "谁也别想从我这里夺走东西！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121304",
            "objective": "击败周边的怪物",
            "dialogues": [
                {
                    "id": "412130401",
                    "speaker": "雷萤术士",
                    "text": "（test）看来就是你们了"
                },
                {
                    "id": "412130402",
                    "speaker": "雷萤术士",
                    "text": "（test）快把那把剑交出来吧"
                },
                {
                    "id": "412130403",
                    "speaker": "雷萤术士",
                    "text": "（test）不然，我可无法保证你们能安然无恙地离开雪山"
                },
                {
                    "id": "412130404",
                    "speaker": "冒失的帕拉德",
                    "text": "（test）呜哇！是什么东西啊，快给他们吧"
                },
                {
                    "id": "412130405",
                    "speaker": "冒失的帕拉德",
                    "text": "（test）我怎么这么倒霉啊，冻得快死了，还被半路打劫"
                },
                {
                    "id": "412130406",
                    "speaker": "派蒙",
                    "text": "（test）别在这说风凉话了",
                    "choices": [
                        {
                            "id": "412130407",
                            "text": "（test）你想得美",
                            "response": [
                                {
                                    "id": "412130408",
                                    "speaker": "派蒙",
                                    "text": "（test）对！你想得美"
                                },
                                {
                                    "id": "412130412",
                                    "speaker": "雷萤术士",
                                    "text": "（test）你们可真是敬酒不吃吃罚酒"
                                },
                                {
                                    "id": "412130413",
                                    "speaker": "砂糖",
                                    "text": "（test）旅行者，帕拉德由我来保护，你就安心地去打败他吧"
                                }
                            ]
                        },
                        {
                            "id": "412130409",
                            "text": "（test）那就交给你吧",
                            "response": [
                                {
                                    "id": "412130410",
                                    "speaker": "派蒙",
                                    "text": "（test）喂！你在想什么！"
                                },
                                {
                                    "id": "412130411",
                                    "speaker": "派蒙",
                                    "text": "（test）我们是绝对不会交给你的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121305",
            "objective": "与砂糖对话",
            "dialogues": [
                {
                    "id": "412130201",
                    "speaker": "砂糖",
                    "text": "太厉害了，这样的武器我还是第一次看到…"
                },
                {
                    "id": "412130202",
                    "speaker": "砂糖",
                    "text": "你也好厉害，无论是战斗的姿势还是挥剑的气势都非常完美。"
                },
                {
                    "id": "412130203",
                    "speaker": "Player",
                    "text": "你过奖了。"
                },
                {
                    "id": "412130204",
                    "speaker": "砂糖",
                    "text": "这把剑好特别，明明没有想要深入研究，眼神却不知不觉就被吸引了过去…"
                },
                {
                    "id": "412130205",
                    "speaker": "派蒙",
                    "text": "我倒觉得比起剑的属性，这个更像是你自己的属性呢…"
                },
                {
                    "id": "412130206",
                    "speaker": "砂糖",
                    "text": "危险诱人的神秘单手剑，嗯，不会错的。"
                },
                {
                    "id": "412130207",
                    "speaker": "砂糖",
                    "text": "把这么重要的东西交给你，阿贝多先生果然非常信任你呢！",
                    "choices": [
                        {
                            "id": "412130208",
                            "text": "对于这件事，我也很惊讶。",
                            "response": [
                                {
                                    "id": "412130210",
                                    "speaker": "派蒙",
                                    "text": "哼哼，这也是凭本事换来的信任吧。"
                                },
                                {
                                    "id": "412130211",
                                    "speaker": "砂糖",
                                    "text": "我也这么觉得。"
                                },
                                {
                                    "id": "412130212",
                                    "speaker": "砂糖",
                                    "text": "不过在交给你之前，剑还没有吸收多少能量…阿贝多先生是怎么从一堆杂物中发觉它与众不同的呢？"
                                },
                                {
                                    "id": "412130213",
                                    "speaker": "派蒙",
                                    "text": "灵光一闪通常是没有道理的。比如我想吃蜜酱胡萝卜煎肉！"
                                },
                                {
                                    "id": "412130214",
                                    "speaker": "砂糖",
                                    "text": "啊…这么一说，我今天还没吃过多少东西呢。"
                                },
                                {
                                    "id": "412130215",
                                    "speaker": "砂糖",
                                    "text": "忙完实验赶来找你们，却在路上遇到被困在雪地里的冒险家，为了救他又花了不少时间…"
                                },
                                {
                                    "id": "412130216",
                                    "speaker": "砂糖",
                                    "text": "（咕…咕…）"
                                },
                                {
                                    "id": "412130217",
                                    "speaker": "Player",
                                    "text": "刚才那是肚子饿了的声音吗？"
                                },
                                {
                                    "id": "412130218",
                                    "speaker": "砂糖",
                                    "text": "啊、啊啊啊！不、不是这样的…"
                                },
                                {
                                    "id": "412130219",
                                    "speaker": "派蒙",
                                    "text": "别害羞别害羞，大胆地说出你的想法嘛！"
                                },
                                {
                                    "id": "412130220",
                                    "speaker": "砂糖",
                                    "text": "呃、呃…"
                                },
                                {
                                    "id": "412130221",
                                    "speaker": "派蒙",
                                    "text": "那我先说：肚子饿了！我想吃饭！",
                                    "choices": [
                                        {
                                            "id": "412130222",
                                            "text": "肚子饿了！",
                                            "response": [
                                                {
                                                    "id": "412130224",
                                                    "speaker": "砂糖",
                                                    "text": "肚子…肚子饿了，要吃…"
                                                },
                                                {
                                                    "id": "412130225",
                                                    "speaker": "砂糖",
                                                    "text": "呜啊啊果然还是好丢脸啊！"
                                                },
                                                {
                                                    "id": "412130226",
                                                    "speaker": "派蒙",
                                                    "text": "才没有这种事呢，承认饥饿会让食物更美味哦。"
                                                },
                                                {
                                                    "id": "412130227",
                                                    "speaker": "砂糖",
                                                    "text": "咦，是这样吗？"
                                                },
                                                {
                                                    "id": "412130228",
                                                    "speaker": "派蒙",
                                                    "text": "是这样哦！所以打起精神来，去休息地找食物吧~"
                                                },
                                                {
                                                    "id": "412130229",
                                                    "speaker": "派蒙",
                                                    "text": "可以的话，真想在这冰天雪地里享用美味的蜜酱胡萝卜煎肉呀。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412130223",
                                            "text": "我想吃饭！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412130209",
                            "text": "很感谢他能这么相信我。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121306",
            "objective": "跟随砂糖前往冒险家营地",
            "dialogues": [
                {
                    "id": "412130601",
                    "speaker": "阿贝多",
                    "text": "龙的力量…龙的生命力，能让枯死的植物复活到这种地步…"
                },
                {
                    "id": "412130602",
                    "speaker": "阿贝多",
                    "text": "不可思议。"
                },
                {
                    "id": "412130603",
                    "speaker": "派蒙",
                    "text": "还以为是一截枯树桩，没想到是这种怪物呀！"
                },
                {
                    "id": "412130604",
                    "speaker": "派蒙",
                    "text": "差一点就被吞下去了！"
                },
                {
                    "id": "412130605",
                    "speaker": "派蒙",
                    "text": "不过，为什么只有今天发生了这种情况呢？"
                },
                {
                    "id": "412130606",
                    "speaker": "阿贝多",
                    "text": "多半是因为剑落到地上遭受了撞击，导致力量外泄。"
                },
                {
                    "id": "412130607",
                    "speaker": "冒失的帕拉德",
                    "text": "我错了，不要赶我走，千万不要赶我走啊！"
                },
                {
                    "id": "412130608",
                    "speaker": "冒失的帕拉德",
                    "text": "我保证绝不乱动！"
                },
                {
                    "id": "412130609",
                    "speaker": "砂糖",
                    "text": "啊，帕拉德先生…也不用抱着膝盖蹲到地上变成蘑菇呀…"
                },
                {
                    "id": "412130610",
                    "speaker": "阿贝多",
                    "text": "唉。"
                },
                {
                    "id": "412130611",
                    "speaker": "阿贝多",
                    "text": "这棵急冻树会枯死在这种地方，难道是因为它无法吸收被污染过的力量？"
                },
                {
                    "id": "412130612",
                    "speaker": "阿贝多",
                    "text": "旅行者能够净化污秽，净化后的纯净元素力不仅能让它复活，甚至强化了它。"
                },
                {
                    "id": "412130613",
                    "speaker": "阿贝多",
                    "text": "纯粹的生命之力会迫使它不断重生…看来，之后还会有持续不断的战斗。",
                    "choices": [
                        {
                            "id": "412130614",
                            "text": "发生了比想象中还麻烦的事呀…",
                            "response": [
                                {
                                    "id": "412130616",
                                    "speaker": "阿贝多",
                                    "text": "我也从没遇到过类似事件。"
                                },
                                {
                                    "id": "412130617",
                                    "speaker": "阿贝多",
                                    "text": "如此罕见的情况，不得不说，也是一种意外收获。"
                                },
                                {
                                    "id": "412130618",
                                    "speaker": "阿贝多",
                                    "text": "砂糖。"
                                },
                                {
                                    "id": "412130619",
                                    "speaker": "砂糖",
                                    "text": "啊、是！"
                                },
                                {
                                    "id": "412130620",
                                    "speaker": "阿贝多",
                                    "text": "看好那个冒险家，把他送回营地去。"
                                },
                                {
                                    "id": "412130621",
                                    "speaker": "砂糖",
                                    "text": "好的先生！"
                                },
                                {
                                    "id": "412130622",
                                    "speaker": "阿贝多",
                                    "text": "至于这里，虽然很不好意思…但还是要麻烦你了，旅行者。"
                                },
                                {
                                    "id": "412130623",
                                    "speaker": "Player",
                                    "text": "我会尽力解决它。"
                                },
                                {
                                    "id": "412130624",
                                    "speaker": "派蒙",
                                    "text": "预料之外的麻烦事，却只有我们能解决。果然还是因为我们越来越厉害了！"
                                }
                            ]
                        },
                        {
                            "id": "412130615",
                            "text": "真没想到，是我太厉害了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4121307",
            "objective": "与帕拉德对话",
            "dialogues": []
        },
        {
            "id": "4121309",
            "objective": "击败意图夺剑的愚人众",
            "dialogues": []
        },
        {
            "id": "4121311",
            "objective": "阿贝多开车$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4121310",
            "objective": "与阿贝多对话",
            "dialogues": [
                {
                    "id": "412130501",
                    "speaker": "阿贝多",
                    "text": "听到声音过来一看，居然是你们几个。"
                },
                {
                    "id": "412130502",
                    "speaker": "阿贝多",
                    "text": "怎么回事，你们跟人打架了？"
                },
                {
                    "id": "412130503",
                    "speaker": "砂糖",
                    "text": "阿、阿贝多先生…我不是故意的…"
                },
                {
                    "id": "412130504",
                    "speaker": "阿贝多",
                    "text": "砂糖，你不是在整理资料吗？怎么突然跑到这种地方来了。"
                },
                {
                    "id": "412130505",
                    "speaker": "阿贝多",
                    "text": "而且还在冰天雪地里和这么危险的对手作战…"
                },
                {
                    "id": "412130506",
                    "speaker": "Player",
                    "text": "我、我也作战了，对不起…"
                },
                {
                    "id": "412130507",
                    "speaker": "派蒙",
                    "text": "为什么连我也跟着心虚起来了呀…"
                },
                {
                    "id": "412130508",
                    "speaker": "砂糖",
                    "text": "呜啊啊我、我只是…对不起对不起，我就是路过…"
                },
                {
                    "id": "412130509",
                    "speaker": "阿贝多",
                    "text": "唉，我猜，一定又有什么让你感兴趣的东西出现了。"
                },
                {
                    "id": "412130510",
                    "speaker": "Player",
                    "text": "我把剑的事告诉砂糖了，抱歉。"
                },
                {
                    "id": "412130511",
                    "speaker": "阿贝多",
                    "text": "你都告诉她了？"
                },
                {
                    "id": "412130512",
                    "speaker": "派蒙",
                    "text": "只是说了剑的属性和来历，没有让她触摸本体！这点意识我们还是有的嘛~"
                },
                {
                    "id": "412130513",
                    "speaker": "阿贝多",
                    "text": "算了，本来也不可能瞒她多久。"
                },
                {
                    "id": "412130514",
                    "speaker": "阿贝多",
                    "text": "砂糖对知识和秘密很有探究精神，确实适合做炼金术研究。"
                },
                {
                    "id": "412130515",
                    "speaker": "砂糖",
                    "text": "啊呜呜…我再也不敢乱惹麻烦了！用我新研究的四倍大种子甜甜花发誓！"
                },
                {
                    "id": "412130516",
                    "speaker": "阿贝多",
                    "text": "我不怕麻烦，只是担心你们的安全。下次千万注意。"
                },
                {
                    "id": "412130517",
                    "speaker": "阿贝多",
                    "text": "对了，那个蹲在那里的冒险家是怎么回事？"
                },
                {
                    "id": "412130518",
                    "speaker": "砂糖",
                    "text": "刚才战斗中我负责保护帕拉德先生，我想，他应该没有受伤。"
                },
                {
                    "id": "412130519",
                    "speaker": "冒失的帕拉德",
                    "text": "冷…冷死我了…"
                },
                {
                    "id": "412130520",
                    "speaker": "派蒙",
                    "text": "好像是在刚才的战斗中着凉了。"
                },
                {
                    "id": "412130521",
                    "speaker": "砂糖",
                    "text": "啊啊，这倒是没想到…是我疏忽了，非常抱歉！"
                },
                {
                    "id": "412130522",
                    "speaker": "砂糖",
                    "text": "阿贝多先生，我去看看他的情况！"
                },
                {
                    "id": "412130523",
                    "speaker": "阿贝多",
                    "text": "嗯。"
                },
                {
                    "id": "412130524",
                    "speaker": "派蒙",
                    "text": "砂糖看起来有些死板，居然是个很有爱心的好孩子呢。"
                },
                {
                    "id": "412130525",
                    "speaker": "Player",
                    "text": "不要叫比你大的人孩子哦。"
                },
                {
                    "id": "412130526",
                    "speaker": "派蒙",
                    "text": "说得也是呢。"
                },
                {
                    "id": "412130527",
                    "speaker": "阿贝多",
                    "text": "砂糖这家伙，一不小心就会跑到奇怪的地方去…"
                },
                {
                    "id": "412130528",
                    "speaker": "Player",
                    "text": "年轻人都这样。"
                },
                {
                    "id": "412130529",
                    "speaker": "阿贝多",
                    "text": "也是。"
                },
                {
                    "id": "412130530",
                    "speaker": "Player",
                    "text": "砂糖不是故意的，请不要生气。"
                },
                {
                    "id": "412130531",
                    "speaker": "阿贝多",
                    "text": "放心吧，我没生气。"
                },
                {
                    "id": "412130532",
                    "speaker": "派蒙",
                    "text": "哎？剑上面好像有什么东西在闪烁呢。"
                },
                {
                    "id": "412130533",
                    "speaker": "阿贝多",
                    "text": "嗯？又有变化…"
                },
                {
                    "id": "412130534",
                    "speaker": "阿贝多",
                    "text": "剑上的力量比之前强大了不少。怎么回事？"
                },
                {
                    "id": "412130535",
                    "speaker": "Player",
                    "text": "我们和愚人众发生了战斗。"
                },
                {
                    "id": "412130536",
                    "speaker": "派蒙",
                    "text": "这一带的愚人众士兵里有些我们没见过的狠角色哦。"
                },
                {
                    "id": "412130537",
                    "speaker": "阿贝多",
                    "text": "是之前没有遇到过的力量吗…"
                },
                {
                    "id": "412130538",
                    "speaker": "阿贝多",
                    "text": "所以，剑也大幅成长了。"
                }
            ]
        },
