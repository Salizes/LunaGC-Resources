    "talks": [
        {
            "id": "7902701",
            "objective": "与「大肉丸」对话",
            "dialogues": [
                {
                    "id": "790270101",
                    "speaker": "「大肉丸」",
                    "text": "欸呀，你们来啦，我还以为你们每天用那个什么翅膀，在海岛间飞来飞去…"
                },
                {
                    "id": "790270102",
                    "speaker": "「大肉丸」",
                    "text": "早就忘了泡在水里的老伙计「大肉丸」啦。"
                },
                {
                    "id": "790270103",
                    "speaker": "派蒙",
                    "text": "我们这不就想起你了嘛！"
                },
                {
                    "id": "790270104",
                    "speaker": "派蒙",
                    "text": "对了，你之前说要帮忙的，是什么事呀…"
                },
                {
                    "id": "790270105",
                    "speaker": "「大肉丸」",
                    "text": "其实也不是什么重要的事…上次你们不是帮我找到了我身躯的碎片嘛。"
                },
                {
                    "id": "790270106",
                    "speaker": "「大肉丸」",
                    "text": "该怎么说呢，不知道是因为达成了一些心愿…还是这片海域让我能开口说话的力量在逐渐消退…"
                },
                {
                    "id": "790270107",
                    "speaker": "「大肉丸」",
                    "text": "最近清醒的时候少，睡着的时候倒是越来越多啦。",
                    "choices": [
                        {
                            "id": "790270108",
                            "text": "难道和那个装置有关？",
                            "response": [
                                {
                                    "id": "790270110",
                                    "speaker": "「大肉丸」",
                                    "text": "#原来如此，是因为什么装置，我才能够变成{NICKNAME}你的浪船，也可以开口与你交流…"
                                },
                                {
                                    "id": "790270111",
                                    "speaker": "派蒙",
                                    "text": "啊…那等装置的影响结束以后，「大肉丸」岂不是不能再开口说话了！"
                                },
                                {
                                    "id": "790270112",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，不如我们快想些办法…"
                                },
                                {
                                    "id": "790270113",
                                    "speaker": "「大肉丸」",
                                    "text": "哈哈，不用啦，派蒙…能够像现在这样与你们说话，我已经感到十分满足了。"
                                },
                                {
                                    "id": "790270114",
                                    "speaker": "「大肉丸」",
                                    "text": "呀…这么一想，我身为一艘船却能在过去几日和你们那样畅快交流，本身就是如梦幻一般的美好之事呀。"
                                },
                                {
                                    "id": "790270115",
                                    "speaker": "「大肉丸」",
                                    "text": "不过我现在还有一事相求…"
                                },
                                {
                                    "id": "790270116",
                                    "speaker": "Player",
                                    "text": "但说无妨…"
                                },
                                {
                                    "id": "790270117",
                                    "speaker": "「大肉丸」",
                                    "text": "之前不是一直说，等找到我的身体以后，就带着你们在这儿兜风嘛，只不过我的身体早就变成了那个样子…"
                                },
                                {
                                    "id": "790270125",
                                    "speaker": "「大肉丸」",
                                    "text": "宝藏大部分也被带走，没留下什么好东西…"
                                },
                                {
                                    "id": "790270118",
                                    "speaker": "「大肉丸」",
                                    "text": "但是这次，我以大海盗船之名起誓，一定会有了不起的大宝藏的！就当是再被我骗一次，跟我一起去吧！"
                                },
                                {
                                    "id": "790270119",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，「大肉丸」说不定马上就没法说话了…"
                                },
                                {
                                    "id": "790270120",
                                    "speaker": "派蒙",
                                    "text": "#而且…那可是有宝藏呢！我们就一起去吧，{NICKNAME}！",
                                    "choices": [
                                        {
                                            "id": "790270121",
                                            "text": "真拿你没办法。",
                                            "response": [
                                                {
                                                    "id": "790270123",
                                                    "speaker": "派蒙",
                                                    "text": "那我们现在就出发吧！"
                                                },
                                                {
                                                    "id": "790270124",
                                                    "speaker": "「大肉丸」",
                                                    "text": "好嘞，那就请两位立刻上船吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790270122",
                                            "text": "既然都这么说了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790270109",
                            "text": "被装置的关闭影响了。"
                        }
                    ]
                }
            ]
        },
