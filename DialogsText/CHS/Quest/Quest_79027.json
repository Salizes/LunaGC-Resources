            "objective": "前去取得「宝藏」",
            "dialogues": [
                {
                    "id": "790271001",
                    "speaker": "派蒙",
                    "text": "「越石丸」、「越石丸」！"
                },
                {
                    "id": "790271002",
                    "speaker": "派蒙",
                    "text": "我们找到宝藏啦，你看，是一艘海盗船的模型呢！这次你的直觉终于准了一次！"
                },
                {
                    "id": "790271003",
                    "speaker": "派蒙",
                    "text": "对了对了，你之前说，要告诉我们的第二件事到底是什么呀！"
                },
                {
                    "id": "790271004",
                    "speaker": "「越石丸」",
                    "text": "……"
                },
                {
                    "id": "790271005",
                    "speaker": "派蒙",
                    "text": "「越石丸」。"
                },
                {
                    "id": "790271006",
                    "speaker": "「越石丸」",
                    "text": "（其名为「越石丸」的船并没有作出任何反应…）",
                    "choices": [
                        {
                            "id": "790271007",
                            "text": "派蒙…",
                            "response": [
                                {
                                    "id": "790271009",
                                    "speaker": "派蒙",
                                    "text": "…哼，还说我们回来就告诉我们。"
                                },
                                {
                                    "id": "790271010",
                                    "speaker": "派蒙",
                                    "text": "「越石丸」…真是个大骗子！"
                                }
                            ]
                        },
                        {
                            "id": "790271008",
                            "text": "「越石丸」已经不能说话了…"
                        }
                    ]
                }
            ]
        },
