            "dialogues": []
        },
        {
            "id": "7902706",
            "objective": "与「越石丸」对话",
            "dialogues": [
                {
                    "id": "790270601",
                    "speaker": "派蒙",
                    "text": "真是险呀，感觉刚才差点就要被击沉了！"
                },
                {
                    "id": "790270602",
                    "speaker": "派蒙",
                    "text": "「越石丸」，了不起！"
                },
                {
                    "id": "790270603",
                    "speaker": "「越石丸」",
                    "text": "#哈哈，会说话的船也不过是船罢了，能够穿越雷暴，{NICKNAME}精湛的驾驶技术才是真的功不可没。",
                    "choices": [
                        {
                            "id": "790270604",
                            "text": "要再来一次吗？",
                            "response": [
                                {
                                    "id": "790270606",
                                    "speaker": "「越石丸」",
                                    "text": "哈哈，那还是别了。"
                                },
                                {
                                    "id": "790270607",
                                    "speaker": "「越石丸」",
                                    "text": "唉，刚才的雷暴，恐怕是因为受到了我的影响，这么看来，这片海域的环境已经变得没那么稳定啦…"
                                },
                                {
                                    "id": "790270608",
                                    "speaker": "「越石丸」",
                                    "text": "#不过，也是正好…{NICKNAME}，派蒙，宝藏就在上面哦！"
                                },
                                {
                                    "id": "790270609",
                                    "speaker": "派蒙",
                                    "text": "这不是我们第一次找宝藏的地方吗，上面只有「越石丸」你的半截断船而已吧！"
                                },
                                {
                                    "id": "790270610",
                                    "speaker": "「越石丸」",
                                    "text": "这次上面肯定有宝藏啦，这可是…怎么说的来着，这可是「大海盗船的直觉」啊！"
                                },
                                {
                                    "id": "790270611",
                                    "speaker": "派蒙",
                                    "text": "是嘛…对了，之前「越石丸」说有两件事要告诉我们，一件事是你记起了你的名字，另一件事是什么呀…"
                                },
                                {
                                    "id": "790270612",
                                    "speaker": "「越石丸」",
                                    "text": "哈哈哈，我还以为你忘记了呢，剩下的一件事，就等你们回来再告诉你们吧！"
                                }
                            ]
                        },
                        {
                            "id": "790270605",
                            "text": "谢谢夸奖。"
                        }
                    ]
                }
            ]
        },
        {
