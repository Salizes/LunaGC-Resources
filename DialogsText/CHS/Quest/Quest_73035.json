    "talks": [
        {
            "id": "7303501",
            "objective": "与兰罗摩会合",
            "dialogues": [
                {
                    "id": "730350101",
                    "speaker": "派蒙",
                    "text": "兰罗摩！"
                },
                {
                    "id": "730350102",
                    "speaker": "兰罗摩",
                    "text": "#嗯！那菈{NICKNAME}和派蒙，精神饱满。就像沾着露水的墩墩桃。但派蒙看起来，不高兴。是做了噩梦吗？"
                },
                {
                    "id": "730350103",
                    "speaker": "派蒙",
                    "text": "我好担心，以为你丢下我们走了…"
                },
                {
                    "id": "730350104",
                    "speaker": "兰罗摩",
                    "text": "咦？派蒙好奇怪。我一直在这里。",
                    "choices": [
                        {
                            "id": "730350105",
                            "text": "派蒙怎么了？",
                            "response": [
                                {
                                    "id": "730350106",
                                    "speaker": "派蒙",
                                    "text": "因为，因为桓那兰那在梦境里，而且之前无忧节那么开心，就像做梦一样！所以，我好怕这些真的是梦，一醒来就都没有了…"
                                },
                                {
                                    "id": "730350107",
                                    "speaker": "派蒙",
                                    "text": "#只剩下我和{NICKNAME}，就像刚开始旅行的时候一样…"
                                },
                                {
                                    "id": "730350108",
                                    "speaker": "兰罗摩",
                                    "text": "但是，梦里的事情是真的事情呀。我观察过那菈。噩梦会让那菈变得胆小，好梦能让那菈开心，就和梦外面的事情一样。"
                                },
                                {
                                    "id": "730350109",
                                    "speaker": "兰罗摩",
                                    "text": "所以，就算派蒙是梦见我们，梦见桓那兰那，那就和真的见到我们、真的到了桓那兰那一样。",
                                    "choices": [
                                        {
                                            "id": "730350110",
                                            "text": "而且兰罗摩也在这里。",
                                            "response": [
                                                {
                                                    "id": "730350111",
                                                    "speaker": "兰罗摩",
                                                    "text": "对呀！我就在这里等你们，一起出发，去觉王之殿，这样才能拿到惟耶之实，让那菈拉娜变好。"
                                                },
                                                {
                                                    "id": "730350116",
                                                    "speaker": "派蒙",
                                                    "text": "#…嗯，说得对。哼，一定是{NICKNAME}在无忧节大餐里放了什么奇怪的蘑菇，我才会想这些东西的。"
                                                },
                                                {
                                                    "id": "730350117",
                                                    "speaker": "派蒙",
                                                    "text": "我们走吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730350112",
                                            "text": "而且我们要帮助拉娜。",
                                            "response": [
                                                {
                                                    "id": "730350113",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯！我们要出发，去觉王之殿，这样才能拿到惟耶之实，让那菈拉娜变好。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730350114",
                            "text": "别想太多，我们出发吧。",
                            "response": [
                                {
                                    "id": "730350115",
                                    "speaker": "兰罗摩",
                                    "text": "嗯！我们去觉王之殿，拿到惟耶之实。这样，就可以让那菈拉娜变好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303512",
            "objective": "前往「觉王之殿」",
            "dialogues": []
        },
        {
            "id": "7303502",
            "objective": "前往「觉王之殿」",
            "dialogues": [
                {
                    "id": "730350201",
                    "speaker": "兰罗摩",
                    "text": "#这里不像兰雅玛他们那样，受了无留陀侵蚀，真是太好了。那菈{NICKNAME}、派蒙，这就是觉王树。"
                },
                {
                    "id": "730350202",
                    "speaker": "派蒙",
                    "text": "喔——好怪的树…"
                },
                {
                    "id": "730350203",
                    "speaker": "兰罗摩",
                    "text": "派蒙真失礼！觉王树会生气。这是好厉害好厉害的树，也是最老的莎兰树，比所有兰那罗、所有兰那罗的故事都古老…"
                },
                {
                    "id": "730350204",
                    "speaker": "兰罗摩",
                    "text": "几千、或者更多个月亮以前，千树之王在这里唱歌。那时候她刚刚离开巴螺迦，丛林远远还没有现在茂密，地上还有很多沙子。"
                },
                {
                    "id": "730350205",
                    "speaker": "兰罗摩",
                    "text": "她的兰迦拉梨比所有兰那罗都强大，因为她的歌更接近「源之歌」。于是从沙恒中，觉王树回应她的召唤，蔌藗地长出来了。"
                },
                {
                    "id": "730350206",
                    "speaker": "兰罗摩",
                    "text": "千树之王对觉王树说，在森林有好多那菈，他们很聪明、很美丽，但又很孤独。所以，要增加森林的子民，与他们成为朋友。"
                },
                {
                    "id": "730350207",
                    "speaker": "兰罗摩",
                    "text": "于是，觉王树生出了一颗又漂亮又饱满的石榴。石榴里面，有着许许多多的种子，而其中第一个长大的种子就是兰穆护昆达。"
                },
                {
                    "id": "730350208",
                    "speaker": "兰罗摩",
                    "text": "所以，兰穆护昆达是最早的兰那罗。后来，种子都长大了，兰那罗就像大树的叶子一样多。我们和那菈一起，都是森林的子民。"
                },
                {
                    "id": "730350209",
                    "speaker": "兰罗摩",
                    "text": "所以，觉王树是很厉害，很重要的！就像那菈会生出那菈孩子一样，所有兰那罗都是觉王树的孩子、千树之王的孩子。"
                },
                {
                    "id": "730350210",
                    "speaker": "派蒙",
                    "text": "是这样喔…不好意思，兰罗摩。觉王树好厉害！",
                    "choices": [
                        {
                            "id": "730350211",
                            "text": "派蒙说别人的妈妈怪，太失礼了。",
                            "response": [
                                {
                                    "id": "730350212",
                                    "speaker": "派蒙",
                                    "text": "我才没有这个意思啦！咳咳，不管这个，惟耶之实要怎么办来着…？"
                                },
                                {
                                    "id": "730350214",
                                    "speaker": "兰罗摩",
                                    "text": "嗯。正如土与雨是大树枝叶繁茂、开花结果所需的，梦与记忆能供养莎兰树。刚刚说了，觉王树是最老的莎兰树。"
                                },
                                {
                                    "id": "730350215",
                                    "speaker": "兰罗摩",
                                    "text": "所以，我们取来了三颗兰拉吉、兰雅玛、兰玛哈的恒素果，要将它供给觉王树。这样，觉王树就能积蓄力量，结出伟大的果实。"
                                },
                                {
                                    "id": "730350216",
                                    "speaker": "派蒙",
                                    "text": "兰拉吉、兰雅玛、兰玛哈的恒素果？不是莎兰树的吗？"
                                },
                                {
                                    "id": "730350217",
                                    "speaker": "兰罗摩",
                                    "text": "嗯，是莎兰树的。"
                                },
                                {
                                    "id": "730350218",
                                    "speaker": "兰罗摩",
                                    "text": "#那菈{NICKNAME}，靠近一点，靠近觉王树吧。"
                                },
                                {
                                    "id": "730350219",
                                    "speaker": "派蒙",
                                    "text": "哇…",
                                    "choices": [
                                        {
                                            "id": "730350220",
                                            "text": "好神奇。",
                                            "response": [
                                                {
                                                    "id": "730350222",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯。一切兰那罗都是这棵树的孩子。你现在与所有兰那罗都联系在一起，身负所有兰那罗的祝福，所以，觉王树也祝福你。"
                                                },
                                                {
                                                    "id": "730350223",
                                                    "speaker": "兰罗摩",
                                                    "text": "只要你戴着花冠，觉王树就会认可你，是森林的孩子。"
                                                },
                                                {
                                                    "id": "730350224",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "730350225",
                                                    "speaker": "兰罗摩",
                                                    "text": "觉王树的状态有点不对劲…感觉有些虚弱。可能和最近到处长出来的无留陀有关吧！"
                                                },
                                                {
                                                    "id": "730350226",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯。无论如何，接下来，我们要进入觉王树的梦，向梦之树供上恒素果。这样的话，它也会恢复的吧！"
                                                },
                                                {
                                                    "id": "730350227",
                                                    "speaker": "派蒙",
                                                    "text": "#接下来要像之前在觉树之堂那样对吗？{NICKNAME}伸出手，然后我们就「咻咻」地到了神奇的梦中！"
                                                },
                                                {
                                                    "id": "730350228",
                                                    "speaker": "兰罗摩",
                                                    "text": "#嗯！派蒙聪明。那菈{NICKNAME}，如果准备好了，就和之前一样，伸出手，进入觉王树的梦吧。",
                                                    "choices": [
                                                        {
                                                            "id": "730350229",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "730350230",
                                                                    "speaker": "派蒙",
                                                                    "text": "#刚刚兰罗摩也提到了无留陀的事情，不知道梦境里会发生什么呢！不过，既然有{NICKNAME}在，一定没问题的！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730350231",
                                                                            "text": "（向觉王树伸出手…）"
                                                                        },
                                                                        {
                                                                            "id": "730350232",
                                                                            "text": "还是准备一下吧…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730350233",
                                                                                    "speaker": "兰罗摩",
                                                                                    "text": "嗯。如果准备好了，就告诉我。我会陪你们一起去。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730350234",
                                                            "text": "我要准备一下…",
                                                            "response": [
                                                                {
                                                                    "id": "730350235",
                                                                    "speaker": "兰罗摩",
                                                                    "text": "嗯。如果准备好了，就告诉我。我会陪你们一起去。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730350221",
                                            "text": "好邪门。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730350213",
                            "text": "关于惟耶之实…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303509",
            "objective": "与兰罗摩对话",
            "dialogues": [
                {
                    "id": "730350901",
                    "speaker": "派蒙",
                    "text": "总算解决了…这么说来，之前在莎兰树的梦境里，也能看见这棵很神奇的树呢！"
                },
                {
                    "id": "730350902",
                    "speaker": "兰罗摩",
                    "text": "#对不起，那菈{NICKNAME}。对不起，派蒙。我完全没发现，觉王树的梦境已经被无留陀侵蚀了…"
                },
                {
                    "id": "730350903",
                    "speaker": "兰罗摩",
                    "text": "无数黑色的虫子在侵蚀梦之树在沙恒中的根。就算在梦中，也能感受到无留陀的手，在摇晃着这个梦。"
                },
                {
                    "id": "730350904",
                    "speaker": "兰罗摩",
                    "text": "对不起喔…之前在觉树之堂见到无留陀的时候，我就应该知道。"
                },
                {
                    "id": "730350905",
                    "speaker": "派蒙",
                    "text": "#没关系啦！你看，有{NICKNAME}在，不是轻轻松松地解决了吗？",
                    "choices": [
                        {
                            "id": "730350906",
                            "text": "那惟耶之实…",
                            "response": [
                                {
                                    "id": "730350912",
                                    "speaker": "兰罗摩",
                                    "text": "#有了恒素果，多少应该能为他恢复一些力量。那菈{NICKNAME}，拜托你了…"
                                },
                                {
                                    "id": "730350913",
                                    "speaker": "兰罗摩",
                                    "text": "……"
                                },
                                {
                                    "id": "730350914",
                                    "speaker": "兰罗摩",
                                    "text": "嗯，我明白了。虽然没想到会这么快，但是我知道，在正确的时候，就会明白应该做什么。"
                                },
                                {
                                    "id": "730350915",
                                    "speaker": "兰罗摩",
                                    "text": "就像云朵会明白要降下雨滴，雨水会明白要落入土地。种子会明白要茁壮成长，变成大树，然后结出饱满的果实。"
                                },
                                {
                                    "id": "730350916",
                                    "speaker": "派蒙",
                                    "text": "兰罗摩看起来怪怪的…"
                                },
                                {
                                    "id": "730350917",
                                    "speaker": "兰罗摩",
                                    "text": "嗯，我在和梦之树说话。原来你们听不到喔！"
                                },
                                {
                                    "id": "730350918",
                                    "speaker": "派蒙",
                                    "text": "虽然之前也看见兰纳真和蘑菇说话…但是，正常来说，人是不能和植物说话的啦！"
                                },
                                {
                                    "id": "730350919",
                                    "speaker": "兰罗摩",
                                    "text": "原来是这样！又学到了新的知识。谢谢派蒙。"
                                },
                                {
                                    "id": "730350920",
                                    "speaker": "兰罗摩",
                                    "text": "#惟耶之实的事情，那菈{NICKNAME}、派蒙，不用担心。我们先从梦里出去吧。"
                                }
                            ]
                        },
                        {
                            "id": "730350907",
                            "text": "小菜一碟。",
                            "response": [
                                {
                                    "id": "730350908",
                                    "speaker": "派蒙",
                                    "text": "唔…不过，这对惟耶之实有影响吗？"
                                }
                            ]
                        },
                        {
                            "id": "730350909",
                            "text": "也没你说的那么轻松…",
                            "response": [
                                {
                                    "id": "730350910",
                                    "speaker": "派蒙",
                                    "text": "多亏了你，不管怎么说，还是解决了呢！"
                                },
                                {
                                    "id": "730350911",
                                    "speaker": "派蒙",
                                    "text": "唔…不过，这对惟耶之实有影响吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303504",
            "objective": "与兰罗摩对话",
            "dialogues": [
                {
                    "id": "730350401",
                    "speaker": "派蒙",
                    "text": "觉王树中间好像在发光…那就是惟耶之实吗？"
                },
                {
                    "id": "730350402",
                    "speaker": "派蒙",
                    "text": "哎呀，真是不容易，这些终于能让拉娜恢复了…"
                },
                {
                    "id": "730350403",
                    "speaker": "兰罗摩",
                    "text": "……"
                },
                {
                    "id": "730350404",
                    "speaker": "派蒙",
                    "text": "欸？！",
                    "choices": [
                        {
                            "id": "730350405",
                            "text": "兰罗摩，你…",
                            "response": [
                                {
                                    "id": "730350407",
                                    "speaker": "兰罗摩",
                                    "text": "……"
                                },
                                {
                                    "id": "730350408",
                                    "speaker": "兰罗摩",
                                    "text": "觉王树已经被无留陀侵蚀了，无法结出惟耶之实。所以，我要种出新的觉王树，这样才能帮助你们。"
                                },
                                {
                                    "id": "730350409",
                                    "speaker": "派蒙",
                                    "text": "但是…种树不是要花好长好长时间吗？从种子到长成大树…"
                                },
                                {
                                    "id": "730350410",
                                    "speaker": "兰罗摩",
                                    "text": "毋须担心。莎兰树成长的速度与种子有关。觉王树将所有的力量交给了我，加上恒素果与我们一同的记忆，没问题的。"
                                },
                                {
                                    "id": "730350411",
                                    "speaker": "兰罗摩",
                                    "text": "谢谢你，最初的觉王树。谢谢你们，兰拉吉、兰雅玛、兰玛哈，我会好好利用你们留下的记忆，让新的觉王树重新连接梦的通路。"
                                },
                                {
                                    "id": "730350412",
                                    "speaker": "派蒙",
                                    "text": "感觉，兰罗摩好像变了…"
                                },
                                {
                                    "id": "730350413",
                                    "speaker": "兰罗摩",
                                    "text": "是吗？我知道了很多事情、学到了很多词语、获得了许多记忆。"
                                },
                                {
                                    "id": "730350414",
                                    "speaker": "兰罗摩",
                                    "text": "但是，不用担心。我还是我，你们是我的朋友。我一定会帮助你们。",
                                    "choices": [
                                        {
                                            "id": "730350415",
                                            "text": "那惟耶之实…",
                                            "response": [
                                                {
                                                    "id": "730350419",
                                                    "speaker": "兰罗摩",
                                                    "text": "觉王之殿的深处封印着往昔的桓那兰那，无留陀的化身就在其中。"
                                                },
                                                {
                                                    "id": "730350420",
                                                    "speaker": "兰罗摩",
                                                    "text": "它会不停向大地、向沙恒灌注蛇毒，直到一切青翠的都枯黄，所有花朵都凋零，溪水散发出腐臭的气味。直到万物死去。"
                                                },
                                                {
                                                    "id": "730350421",
                                                    "speaker": "兰罗摩",
                                                    "text": "我们要将它摧毁。只有这样，才能种出强壮的树，结出惟耶之实。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730350416",
                                            "text": "我相信你。接下来要做什么？"
                                        },
                                        {
                                            "id": "730350417",
                                            "text": "我明白了。",
                                            "response": [
                                                {
                                                    "id": "730350418",
                                                    "speaker": "兰罗摩",
                                                    "text": "#那菈{NICKNAME}明白了就好。那就没什么问题了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730350406",
                            "text": "怎么回事？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303505",
            "objective": "与兰罗摩对话",
            "dialogues": [
                {
                    "id": "730350301",
                    "speaker": "兰罗摩",
                    "text": "怎么会这样…"
                },
                {
                    "id": "730350302",
                    "speaker": "派蒙",
                    "text": "欸？为什么在觉王树的梦境里…会有死域？"
                },
                {
                    "id": "730350303",
                    "speaker": "派蒙",
                    "text": "总之，要尽快消除死域才行！"
                }
            ]
        },
        {
            "id": "7303506",
            "objective": "消除死域",
            "dialogues": [
                {
                    "id": "730350601",
                    "speaker": "兰罗摩",
                    "text": "#这里不像兰雅玛他们那样，受了无留陀侵蚀，真是太好了。那菈{NICKNAME}、派蒙，这就是觉王树。"
                },
                {
                    "id": "730350602",
                    "speaker": "派蒙",
                    "text": "喔——好怪的树…"
                },
                {
                    "id": "730350603",
                    "speaker": "兰罗摩",
                    "text": "派蒙真失礼！觉王树会生气。这是好厉害好厉害的树，也是最老的莎兰树，比所有兰那罗、所有兰那罗的故事都古老…"
                },
                {
                    "id": "730350604",
                    "speaker": "兰罗摩",
                    "text": "几千、或者更多个月亮以前，一切草木的主神在这里唱歌。那时候她刚刚离开巴螺迦，丛林远远还没有现在茂密，地上还有很多沙子。"
                },
                {
                    "id": "730350605",
                    "speaker": "兰罗摩",
                    "text": "她的兰迦拉梨比所有兰那罗都强大，因为她的歌更接近「源之歌」。于是从沙恒中，觉王树回应她的召唤，蔌藗地长出来了。"
                },
                {
                    "id": "730350606",
                    "speaker": "兰罗摩",
                    "text": "她对觉王树说，在森林有好多那菈，他们很聪明、很美丽，但又很孤独。所以，要增加森林的子民，与他们成为朋友。"
                },
                {
                    "id": "730350607",
                    "speaker": "兰罗摩",
                    "text": "于是，觉王树生出了一颗又漂亮又饱满的石榴。石榴里面，有着许许多多的种子，而其中第一个长大的种子就是兰穆护昆达。"
                },
                {
                    "id": "730350608",
                    "speaker": "兰罗摩",
                    "text": "所以，兰穆护昆达是最早的兰那罗。后来，种子都长大了，兰那罗就像大树的叶子一样多。我们和那菈一起，都是森林的子民。"
                },
                {
                    "id": "730350609",
                    "speaker": "兰罗摩",
                    "text": "所以，觉王树是很厉害，很重要的！就像那菈会生出那菈孩子一样，所有兰那罗都是觉王树的孩子、草神的孩子。"
                },
                {
                    "id": "730350610",
                    "speaker": "派蒙",
                    "text": "是这样喔…不好意思，兰罗摩。觉王树好厉害！",
                    "choices": [
                        {
                            "id": "730350611",
                            "text": "派蒙说别人的妈妈怪，太失礼了。",
                            "response": [
                                {
                                    "id": "730350612",
                                    "speaker": "派蒙",
                                    "text": "我才没有这个意思啦！咳咳，不管这个，惟耶之实要怎么办来着…？"
                                },
                                {
                                    "id": "730350614",
                                    "speaker": "兰罗摩",
                                    "text": "嗯。正如土与雨是大树枝叶繁茂、开花结果所需的，梦与记忆能供养莎兰树。刚刚说了，觉王树是最老的莎兰树。"
                                },
                                {
                                    "id": "730350615",
                                    "speaker": "兰罗摩",
                                    "text": "所以，我们取来了三颗兰拉吉、兰雅玛、兰玛哈的恒素果，要将它供给觉王树。这样，觉王树就能积蓄力量，结出伟大的果实。"
                                },
                                {
                                    "id": "730350616",
                                    "speaker": "派蒙",
                                    "text": "兰拉吉、兰雅玛、兰玛哈的恒素果？不是莎兰树的吗？"
                                },
                                {
                                    "id": "730350617",
                                    "speaker": "兰罗摩",
                                    "text": "嗯，是莎兰树的。"
                                },
                                {
                                    "id": "730350618",
                                    "speaker": "兰罗摩",
                                    "text": "#那菈{NICKNAME}，靠近一点，靠近觉王树吧。"
                                },
                                {
                                    "id": "730350619",
                                    "speaker": "派蒙",
                                    "text": "哇…",
                                    "choices": [
                                        {
                                            "id": "730350620",
                                            "text": "好神奇。",
                                            "response": [
                                                {
                                                    "id": "730350622",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯。一切兰那罗都是这棵树的孩子。你现在与所有兰那罗都联系在一起，身负所有兰那罗的祝福，所以，觉王树也祝福你。"
                                                },
                                                {
                                                    "id": "730350623",
                                                    "speaker": "兰罗摩",
                                                    "text": "只要你戴着花冠，觉王树就会认可你，是森林的孩子。"
                                                },
                                                {
                                                    "id": "730350624",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "730350625",
                                                    "speaker": "兰罗摩",
                                                    "text": "觉王树的状态有点不对劲…感觉有些虚弱。可能和最近到处长出来的无留陀有关吧！"
                                                },
                                                {
                                                    "id": "730350626",
                                                    "speaker": "兰罗摩",
                                                    "text": "嗯。无论如何，接下来，我们要进入觉王树的梦，向梦之树供上恒素果。这样的话，它也会恢复的吧！"
                                                },
                                                {
                                                    "id": "730350627",
                                                    "speaker": "派蒙",
                                                    "text": "#接下来要像之前在觉树之堂那样对吗？{NICKNAME}伸出手，然后我们就「咻咻」地到了神奇的梦中！"
                                                },
                                                {
                                                    "id": "730350628",
                                                    "speaker": "兰罗摩",
                                                    "text": "#嗯！派蒙聪明。那菈{NICKNAME}，如果准备好了，就和之前一样，伸出手，进入觉王树的梦吧。",
                                                    "choices": [
                                                        {
                                                            "id": "730350629",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "730350630",
                                                                    "speaker": "派蒙",
                                                                    "text": "#刚刚兰罗摩也提到了无留陀的事情，不知道梦境里会发生什么呢！不过，既然有{NICKNAME}在，一定没问题的！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730350631",
                                                                            "text": "（向觉王树伸出手…）"
                                                                        },
                                                                        {
                                                                            "id": "730350632",
                                                                            "text": "还是准备一下吧…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730350633",
                                                                                    "speaker": "兰罗摩",
                                                                                    "text": "嗯。如果准备好了，就告诉我。我会陪你们一起去。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730350634",
                                                            "text": "我要准备一下…",
                                                            "response": [
                                                                {
                                                                    "id": "730350635",
                                                                    "speaker": "兰罗摩",
                                                                    "text": "嗯。如果准备好了，就告诉我。我会陪你们一起去。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730350621",
                                            "text": "好邪门。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730350613",
                            "text": "关于惟耶之实…"
                        }
                    ]
                }
            ]
        },
