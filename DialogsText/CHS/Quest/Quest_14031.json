    "talks": [
        {
            "id": "1403101",
            "objective": "前往枫丹廷·利奥奈区",
            "dialogues": [
                {
                    "id": "140310101",
                    "speaker": "克洛琳德",
                    "text": "…还是不行吗？"
                },
                {
                    "id": "140310102",
                    "speaker": "娜维娅",
                    "text": "不行，我整个枫丹廷都跑过一遍了。"
                },
                {
                    "id": "140310103",
                    "speaker": "娜维娅",
                    "text": "琳妮特听到要连续几天在外面跑，耳朵都耷下来了。菲米尼好像觉得生人太多，直接把头缩进了头盔里。"
                },
                {
                    "id": "140310104",
                    "speaker": "克洛琳德",
                    "text": "千织和夏洛蒂呢？感觉她们能够胜任。"
                },
                {
                    "id": "140310105",
                    "speaker": "娜维娅",
                    "text": "我问过了，但她们最近都挺忙，没有空闲。另外我刚给刺玫会成员放了几天假，不想因为这事打扰大家。"
                },
                {
                    "id": "140310106",
                    "speaker": "克洛琳德",
                    "text": "…难办了啊。"
                },
                {
                    "id": "140310107",
                    "speaker": "派蒙",
                    "text": "娜维娅！克洛琳德！你们好呀。"
                },
                {
                    "id": "140310108",
                    "speaker": "娜维娅",
                    "text": "天哪！是我的好搭档和派蒙！你们好！"
                },
                {
                    "id": "140310109",
                    "speaker": "克洛琳德",
                    "text": "…娜维娅！"
                },
                {
                    "id": "140310110",
                    "speaker": "娜维娅",
                    "text": "…哦！你的意思是…！"
                },
                {
                    "id": "140310111",
                    "speaker": "克洛琳德",
                    "text": "嗯，机会来了…",
                    "choices": [
                        {
                            "id": "140310112",
                            "text": "…你，你们要干什么？",
                            "response": [
                                {
                                    "id": "140310114",
                                    "speaker": "派蒙",
                                    "text": "你们这是遇到什么难事了吗？"
                                },
                                {
                                    "id": "140310115",
                                    "speaker": "娜维娅",
                                    "text": "没错！我的好搭档，有个天大的难事，眼下只有你们能帮我们解决！"
                                },
                                {
                                    "id": "140310116",
                                    "speaker": "派蒙",
                                    "text": "这么夸张？"
                                },
                                {
                                    "id": "140310117",
                                    "speaker": "克洛琳德",
                                    "text": "毫不夸张。已经走投无路了。",
                                    "choices": [
                                        {
                                            "id": "140310118",
                                            "text": "到底是多大的难事…",
                                            "response": [
                                                {
                                                    "id": "140310120",
                                                    "speaker": "娜维娅",
                                                    "text": "#{NICKNAME}，派蒙…你们愿意…"
                                                },
                                                {
                                                    "id": "140310121",
                                                    "speaker": "娜维娅",
                                                    "text": "——来玩《逐影猎人：审判之时》吗？！"
                                                },
                                                {
                                                    "id": "140310122",
                                                    "speaker": "派蒙",
                                                    "text": "什么东西？"
                                                },
                                                {
                                                    "id": "140310123",
                                                    "speaker": "克洛琳德",
                                                    "text": "一个由枫丹「桌上剧团」俱乐部推出的游戏剧本。"
                                                },
                                                {
                                                    "id": "140310124",
                                                    "speaker": "娜维娅",
                                                    "text": "你们听过「桌上剧团」吧？就是和好朋友围在桌前，扮演剧中角色，参与剧本故事的游戏。我小时候就爱玩。"
                                                },
                                                {
                                                    "id": "140310125",
                                                    "speaker": "派蒙",
                                                    "text": "好像挺有趣的！"
                                                },
                                                {
                                                    "id": "140310126",
                                                    "speaker": "娜维娅",
                                                    "text": "我和克洛琳德都是俱乐部里的老会员了。最近，有人找到我，说他们出了一个新剧本，想请人免费试玩。"
                                                },
                                                {
                                                    "id": "140310127",
                                                    "speaker": "娜维娅",
                                                    "text": "这可是一个全新的剧本欸！我们是第一批体验者！"
                                                },
                                                {
                                                    "id": "140310128",
                                                    "speaker": "克洛琳德",
                                                    "text": "试玩阶段的剧本一般来说会有很多瑕疵，但这次的我觉得不错，完成度比较高，作者的考据也很到位。"
                                                },
                                                {
                                                    "id": "140310129",
                                                    "speaker": "娜维娅",
                                                    "text": "欸停停停！剧本我一个字没看就直接拿给你了，千万别在这里剧透！"
                                                },
                                                {
                                                    "id": "140310130",
                                                    "speaker": "克洛琳德",
                                                    "text": "…总之，这个剧本要求四位扮演者，现在三缺一。"
                                                },
                                                {
                                                    "id": "140310131",
                                                    "speaker": "Player",
                                                    "text": "…那还真是天大的麻烦！"
                                                },
                                                {
                                                    "id": "140310132",
                                                    "speaker": "娜维娅",
                                                    "text": "你果然也这么觉得吧？我的好搭档。"
                                                },
                                                {
                                                    "id": "140310133",
                                                    "speaker": "派蒙",
                                                    "text": "#但我和{NICKNAME}是两个人欸，这没问题吗？"
                                                },
                                                {
                                                    "id": "140310134",
                                                    "speaker": "克洛琳德",
                                                    "text": "没问题，我会根据实际参与人数进行节奏的把控，保证你们的游玩体验。"
                                                },
                                                {
                                                    "id": "140310135",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，你怎么看？想玩吗？我听你的。",
                                                    "choices": [
                                                        {
                                                            "id": "140310136",
                                                            "text": "朋友有难怎能不帮！",
                                                            "response": [
                                                                {
                                                                    "id": "140310138",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "好。那现在问题就解决了。"
                                                                },
                                                                {
                                                                    "id": "140310139",
                                                                    "speaker": "娜维娅",
                                                                    "text": "太棒了！我这就去俱乐部叫剧本管理人过来！"
                                                                },
                                                                {
                                                                    "id": "140310140",
                                                                    "speaker": "派蒙",
                                                                    "text": "剧本管理人？剧本不就在克洛琳德手里吗？"
                                                                },
                                                                {
                                                                    "id": "140310141",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "配合这个剧本，俱乐部推出了全新的游玩方式。"
                                                                },
                                                                {
                                                                    "id": "140310142",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "一开始主持人手中的剧本并不完整，需要跑完当前阶段的剧情，才能从剧本管理人那边接到下一阶段的剧本。"
                                                                },
                                                                {
                                                                    "id": "140310143",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "而且，俱乐部还会在现实中搭建剧中场景，让参与者身临其境，实景参与。第一天的游玩地点，得等剧本管理人告诉我们才知道。"
                                                                },
                                                                {
                                                                    "id": "140310144",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇，听起来写这个剧本的人真的很用心呢！"
                                                                },
                                                                {
                                                                    "id": "140310145",
                                                                    "speaker": "娜维娅",
                                                                    "text": "嘿嘿，而且还很有悬念对吧？就连主持人都不知道故事的结局呢！"
                                                                },
                                                                {
                                                                    "id": "140310146",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "我很期待和你们共同见证。"
                                                                },
                                                                {
                                                                    "id": "140310147",
                                                                    "speaker": "娜维娅",
                                                                    "text": "你们先去和其他人会合吧，他们还在千织屋等着呢，我待会儿就和剧本管理人一起过来。"
                                                                },
                                                                {
                                                                    "id": "140310148",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "好，不要着急，小心看路。"
                                                                },
                                                                {
                                                                    "id": "140310149",
                                                                    "speaker": "娜维娅",
                                                                    "text": "你怎么把我说得像个小孩子一样？"
                                                                },
                                                                {
                                                                    "id": "140310150",
                                                                    "speaker": "娜维娅",
                                                                    "text": "唔…让我想想，这次该扮演一个什么样的角色呢？"
                                                                },
                                                                {
                                                                    "id": "140310151",
                                                                    "speaker": "克洛琳德",
                                                                    "text": "…希望这次你能学一些正常的技能。另外，别再试图对每一只见到的动物都使用「说服」了…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "140310137",
                                                            "text": "好的剧本怎能不玩！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "140310119",
                                            "text": "先听听看…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "140310113",
                            "text": "…我，我只是路过。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1403104",
            "objective": "与克洛琳德和娜维娅对话",
            "dialogues": []
        },
        {
            "id": "1403102",
            "objective": "前往「千织屋」与其他人会合",
            "dialogues": [
                {
                    "id": "140310201",
                    "speaker": "克洛琳德",
                    "text": "久等了。"
                },
                {
                    "id": "140310202",
                    "speaker": "芙宁娜",
                    "text": "#哦，你们回来了。咦？是{NICKNAME}和派蒙？"
                },
                {
                    "id": "140310203",
                    "speaker": "林尼",
                    "text": "真惊喜，原来最后找到了你们一起来玩吗？"
                },
                {
                    "id": "140310204",
                    "speaker": "派蒙",
                    "text": "林尼！还有芙宁娜！另外两位玩家居然是你们呀！你们也是「桌上剧团」俱乐部的会员吗？"
                },
                {
                    "id": "140310205",
                    "speaker": "Player",
                    "text": "二位好。"
                },
                {
                    "id": "140310206",
                    "speaker": "林尼",
                    "text": "我只能算个「挂名成员」吧，没参加过几次活动。在布法蒂公馆，倒是经常由我担任主持人，陪琳妮特和菲米尼玩类似的游戏。"
                },
                {
                    "id": "140310207",
                    "speaker": "林尼",
                    "text": "不过，自己作为玩家体验剧本还是头一次呢，希望能和大家玩得开心。"
                },
                {
                    "id": "140310208",
                    "speaker": "芙宁娜",
                    "text": "我不是俱乐部的会员。只是一大早被克洛琳德敲门叫醒，说有个不错的剧本可以体验，这才决定加入的。"
                },
                {
                    "id": "140310209",
                    "speaker": "克洛琳德",
                    "text": "如果你感兴趣，我可以当你的介绍人，入会费打六折。"
                },
                {
                    "id": "140310210",
                    "speaker": "芙宁娜",
                    "text": "我还是先看这次的剧本质量再考虑啦，体验好的话我就加入。"
                },
                {
                    "id": "140310211",
                    "speaker": "派蒙",
                    "text": "克洛琳德是经常玩「桌上剧团」吗？"
                },
                {
                    "id": "140310212",
                    "speaker": "林尼",
                    "text": "她可是俱乐部数一数二的「资深主持人」哟。"
                },
                {
                    "id": "140310213",
                    "speaker": "芙宁娜",
                    "text": "嗯，以前跟我还是上下级关系的时候，我就知道这一点了。"
                },
                {
                    "id": "140310214",
                    "speaker": "克洛琳德",
                    "text": "…一点业余爱好而已，不必那么惊讶。"
                },
                {
                    "id": "140310215",
                    "speaker": "派蒙",
                    "text": "天哪，平时看你都是身为决斗代理人威严的一面，完全想象不到你带人玩桌上剧团的样子呢。",
                    "choices": [
                        {
                            "id": "140310216",
                            "text": "如果对规则有意见的话…",
                            "response": [
                                {
                                    "id": "140310218",
                                    "speaker": "克洛琳德",
                                    "text": "你说笑了。我不会这样为难玩家。"
                                },
                                {
                                    "id": "140310219",
                                    "speaker": "克洛琳德",
                                    "text": "工作是工作，生活是生活。审判庭上的我，代表枫丹的律法与规则，赐予想要维护自身荣誉的人一场公正的决斗。不掺任何私情。"
                                },
                                {
                                    "id": "140310220",
                                    "speaker": "克洛琳德",
                                    "text": "但生活中，我和大家一样，是个普普通通的人，生气难过之类的情绪，也是会有的。"
                                },
                                {
                                    "id": "140310221",
                                    "speaker": "芙宁娜",
                                    "text": "骗人的吧，你在我旁边这么久，我从没看你掉过眼泪，生气倒是有过不少…还是说你只是看起来像生气了？"
                                },
                                {
                                    "id": "140310222",
                                    "speaker": "克洛琳德",
                                    "text": "那时的我也是工作状态。"
                                },
                                {
                                    "id": "140310223",
                                    "speaker": "芙宁娜",
                                    "text": "是这样吗？但总觉得你在生活中情绪波动也不大。"
                                },
                                {
                                    "id": "140310224",
                                    "speaker": "克洛琳德",
                                    "text": "你想看我哭吗？那可能有些困难。生气或许会更容易些。"
                                },
                                {
                                    "id": "140310225",
                                    "speaker": "芙宁娜",
                                    "text": "啊不不不，我不是这个意思…"
                                },
                                {
                                    "id": "140310226",
                                    "speaker": "娜维娅",
                                    "text": "我回来啦！向大家介绍一下，这位就是此次剧本的负责人，弗洛莱恩先生！"
                                },
                                {
                                    "id": "140310227",
                                    "speaker": "弗洛莱恩",
                                    "text": "各位好。"
                                },
                                {
                                    "id": "140310228",
                                    "speaker": "派蒙",
                                    "text": "你好你好。咦？难道弗洛莱恩先生也是决斗代理人吗？"
                                },
                                {
                                    "id": "140310229",
                                    "speaker": "弗洛莱恩",
                                    "text": "哦，不是的，这是俱乐部提供的演出服。我偶尔还会扮演剧本中的其他角色。"
                                },
                                {
                                    "id": "140310230",
                                    "speaker": "林尼",
                                    "text": "还真是辛苦的工作呢。"
                                },
                                {
                                    "id": "140310231",
                                    "speaker": "弗洛莱恩",
                                    "text": "这没什么。为了能让扮演者更为沉浸地体验故事，这是我们该做的。"
                                },
                                {
                                    "id": "140310232",
                                    "speaker": "弗洛莱恩",
                                    "text": "那么我为各位简单介绍一下——"
                                },
                                {
                                    "id": "140310233",
                                    "speaker": "弗洛莱恩",
                                    "text": "此次的剧本，是参考逐影猎人的历史改编而成。诸位将亲自扮演那个时代的逐影猎人，解决在王城发生的一系列事件。"
                                },
                                {
                                    "id": "140310234",
                                    "speaker": "派蒙",
                                    "text": "呃…我对逐影猎人的历史不是那么熟悉，应该没什么影响吧？"
                                },
                                {
                                    "id": "140310235",
                                    "speaker": "弗洛莱恩",
                                    "text": "哦，这完全没问题。简单介绍的话，「逐影猎人」指的是那些继承了特殊的剑技，猎杀魔物、守护城市的人。"
                                },
                                {
                                    "id": "140310236",
                                    "speaker": "弗洛莱恩",
                                    "text": "关于他们的故事，最早能追溯到很久以前的雷穆利亚王朝，以及第一位猎人「卡西奥多」…"
                                },
                                {
                                    "id": "140310237",
                                    "speaker": "弗洛莱恩",
                                    "text": "但更加详细的，就留给各位之后去寻找和发现吧。"
                                },
                                {
                                    "id": "140310238",
                                    "speaker": "克洛琳德",
                                    "text": "嗯，我也会在此过程中为你们进一步解说。"
                                },
                                {
                                    "id": "140310239",
                                    "speaker": "弗洛莱恩",
                                    "text": "那么…咳咳！各位勇敢的猎人啊，你们准备好踏入一场未知的冒险之旅了吗？"
                                },
                                {
                                    "id": "140310240",
                                    "speaker": "派蒙",
                                    "text": "哦！气氛一下子就上来了呢！"
                                },
                                {
                                    "id": "140310241",
                                    "speaker": "弗洛莱恩",
                                    "text": "很好，我已经看到了你们坚毅的眼神。就请前往此处，开启你们的旅途吧！"
                                },
                                {
                                    "id": "140310242",
                                    "speaker": "芙宁娜",
                                    "text": "根据故事走向，前往特定情景吗？听起来挺新颖。所以信封里写了什么？"
                                },
                                {
                                    "id": "140310243",
                                    "speaker": "克洛琳德",
                                    "text": "是第一阶段剧本情景的具体位置，还有场地使用许可。准备得挺周全。"
                                },
                                {
                                    "id": "140310244",
                                    "speaker": "克洛琳德",
                                    "text": "请各位检查随身物品，防止遗漏。准备好后，就随我前往指定的地点吧。"
                                },
                                {
                                    "id": "140310245",
                                    "speaker": "派蒙",
                                    "text": "好欸！逐影猎人小队，出发！"
                                }
                            ]
                        },
                        {
