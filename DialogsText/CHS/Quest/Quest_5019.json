            "dialogues": [
                {
                    "id": "50191701",
                    "speaker": "阿伽娅",
                    "text": "你们两个，要我说几遍？不许往温泉里丢石子！"
                },
                {
                    "id": "50191702",
                    "speaker": "妮乌",
                    "text": "知道了…"
                },
                {
                    "id": "50191703",
                    "speaker": "阿纳",
                    "text": "这怪阿姨是从哪里冒出来的…"
                }
            ]
        },
        {
            "id": "501919",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50191901",
                    "speaker": "妮乌",
                    "text": "那个古板怪阿姨呢？好像有段时间没见到她了。"
                },
                {
                    "id": "50191902",
                    "speaker": "阿纳",
                    "text": "好耶！终于没人管我们了，去丢石子玩吧！"
                },
                {
                    "id": "50191903",
                    "speaker": "妮乌",
                    "text": "……"
                },
                {
                    "id": "50191904",
                    "speaker": "阿纳",
                    "text": "……"
                },
                {
                    "id": "50191905",
                    "speaker": "妮乌",
                    "text": "仔细想想，丢石子也没什么好玩的。阿伽娅阿姨什么时候回来啊？我有点想她了。"
                },
                {
                    "id": "50191906",
                    "speaker": "阿纳",
                    "text": "大人们说她去了很远的地方，所以大概要很久才会回来吧？"
                }
            ]
        }
    ]
