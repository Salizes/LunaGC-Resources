    "talks": [
        {
            "id": "7609201",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760920101",
                    "speaker": "罗尔夫",
                    "text": "躲远点，伙计！这地方很危险，一会要是「狂猎」出现了，我可没余力保护你。",
                    "choices": [
                        {
                            "id": "760920102",
                            "text": "你怎么知道会有「狂猎」？",
                            "response": [
                                {
                                    "id": "760920103",
                                    "speaker": "罗尔夫",
                                    "text": "作为执灯人，应对「狂猎」灾祸是我的职责，"
                                },
                                {
                                    "id": "760920104",
                                    "speaker": "罗尔夫",
                                    "text": "看见旁边这个汐印石了吗？为了确保对「狂猎」的清剿万无一失，我得在这盯上三天三夜才行。"
                                },
                                {
                                    "id": "760920105",
                                    "speaker": "Player",
                                    "text": "汐印石？"
                                },
                                {
                                    "id": "760920106",
                                    "speaker": "罗尔夫",
                                    "text": "汐印石是我们执灯人为了驱散「狂猎」气息所设置的封印。"
                                },
                                {
                                    "id": "760920107",
                                    "speaker": "罗尔夫",
                                    "text": "虽然我也不清楚其中的原理，不过通常来说，出现过「狂猎」的地方所残留的气息，很容易把它们再次引来。"
                                },
                                {
                                    "id": "760920108",
                                    "speaker": "罗尔夫",
                                    "text": "因此在击退「狂猎」后，我们便会设置这种汐印石。若是附近再有「狂猎」出现，它也能在战斗中护佑我们。"
                                }
                            ]
                        },
                        {
                            "id": "760920109",
                            "text": "我可不怕什么「狂猎」。",
                            "response": [
                                {
                                    "id": "760920110",
                                    "speaker": "罗尔夫",
                                    "text": "虽然不知道你哪来的这种自信，不过「狂猎」可不是能随意应对的敌人。"
                                },
                                {
                                    "id": "760920111",
                                    "speaker": "罗尔夫",
                                    "text": "听我一句劝，遇到有这种汐印石的地方，还是小心谨慎为好。"
                                }
                            ]
                        },
                        {
                            "id": "760920112",
                            "text": "不打扰了。",
                            "response": [
                                {
                                    "id": "760920113",
                                    "speaker": "罗尔夫",
                                    "text": "好的，路上小心。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7609202",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760920201",
                    "speaker": "「汐印石」上的铭文",
                    "text": "「死寂毁灭了星月夜，我们使骨血做燃料，如是宣告：长夜未明，于此执灯，群魔幽影，不得侵扰，奉月之灵，予以封刻。」"
                }
            ]
        }
    ]
}