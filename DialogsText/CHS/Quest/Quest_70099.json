    "talks": [
        {
            "id": "7009901",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "700990101",
                    "speaker": "？？？",
                    "text": "真是好话难劝想死的鬼啊。都说了现在不能上山。"
                },
                {
                    "id": "700990102",
                    "speaker": "霍夫曼",
                    "text": "哎哎，曼恩大爷，你别这么激动。好好说话，好好说话。"
                },
                {
                    "id": "700990103",
                    "speaker": "？？？",
                    "text": "之前我和这位大爷在暗夜之酿聊得还好好的呢。"
                },
                {
                    "id": "700990104",
                    "speaker": "？？？",
                    "text": "他一听说我要去风息山就开始拽着我了，一路拉扯都走到这里来了。"
                },
                {
                    "id": "700990105",
                    "speaker": "派蒙",
                    "text": "咦，是霍夫曼啊。这里发生什么了吗？"
                },
                {
                    "id": "700990106",
                    "speaker": "霍夫曼",
                    "text": "如你所见，曼恩大爷正在力劝人们远离风息山呢。"
                },
                {
                    "id": "700990107",
                    "speaker": "霍夫曼",
                    "text": "介绍一下，这位是冒险家莉普哈特。"
                },
                {
                    "id": "700990108",
                    "speaker": "曼恩",
                    "text": "我的亲身经历可是很吓人的！你们真的要听吗？"
                },
                {
                    "id": "700990109",
                    "speaker": "莉普哈特",
                    "text": "好嘛，我感觉今天是走不了了。那听听吧，就当是刚才喝酒吹牛的延续了。"
                },
                {
                    "id": "700990110",
                    "speaker": "莉普哈特",
                    "text": "我来看看究竟是怎么个危险法。"
                },
                {
                    "id": "700990111",
                    "speaker": "曼恩",
                    "text": "疗养院里真的有鬼！我亲眼看见的！"
                },
                {
                    "id": "700990112",
                    "speaker": "派蒙",
                    "text": "哇，鬼！"
                },
                {
                    "id": "700990113",
                    "speaker": "曼恩",
                    "text": "昨天晚上的事情是这样的…"
                }
            ]
        },
        {
            "id": "7009902",
            "objective": "(test)隐藏$HIDDEN",
