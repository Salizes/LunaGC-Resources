    "talks": [
        {
            "id": "30700",
            "objective": "在庙宇门口跟凯亚见面",
            "dialogues": []
        },
        {
            "id": "30701",
            "objective": "与凯亚对话",
            "dialogues": [
                {
                    "id": "3071101",
                    "speaker": "凯亚",
                    "text": "你来了。"
                },
                {
                    "id": "3071102",
                    "speaker": "凯亚",
                    "text": "喏，靠近点。闻到了吗？",
                    "choices": [
                        {
                            "id": "3071103",
                            "text": "…没闻到。",
                            "response": [
                                {
                                    "id": "3071105",
                                    "speaker": "凯亚",
                                    "text": "这个<color=#00E1FFFF>神庙</color>里发生了一些事。"
                                },
                                {
                                    "id": "3071106",
                                    "speaker": "凯亚",
                                    "text": "史莱姆、丘丘人…还有…风魔龙留下的魔力联结。"
                                },
                                {
                                    "id": "3071107",
                                    "speaker": "凯亚",
                                    "text": "哈哈，里面肯定很热闹吧。",
                                    "choices": [
                                        {
                                            "id": "3071108",
                                            "text": "会很危险吗？",
                                            "response": [
                                                {
                                                    "id": "3071109",
                                                    "speaker": "凯亚",
                                                    "text": "嗯…热闹归热闹，却并不危险。"
                                                },
                                                {
                                                    "id": "3071112",
                                                    "speaker": "凯亚",
                                                    "text": "真遗憾啊，「北风之狼」的庙宇，如今竟被这样打扰。"
                                                },
                                                {
                                                    "id": "3071113",
                                                    "speaker": "凯亚",
                                                    "text": "#我们走吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRL]}。"
                                                },
                                                {
                                                    "id": "3071114",
                                                    "speaker": "凯亚",
                                                    "text": "虽然「四风守护」已经不再有人祭祀，但古老的风不会消散…"
                                                },
                                                {
                                                    "id": "3071115",
                                                    "speaker": "凯亚",
                                                    "text": "现在，要去帮「四风守护」清理一下环境咯。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3071110",
                                            "text": "只是乌合之众罢了。",
                                            "response": [
                                                {
                                                    "id": "3071111",
                                                    "speaker": "凯亚",
                                                    "text": "喔！很有气魄的发言。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3071104",
                            "text": "是火史莱姆烧焦的味道。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30702",
            "objective": "进入庙宇",
            "dialogues": []
        },
        {
            "id": "30710",
            "objective": "与凯亚对话",
            "dialogues": [
                {
                    "id": "3071201",
                    "speaker": "凯亚",
                    "text": "那么，就让我来展示一下骑士团的战法。"
                }
            ]
