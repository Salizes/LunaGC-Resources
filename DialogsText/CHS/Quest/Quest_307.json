        },
        {
            "id": "30715",
            "objective": "(test)与凯亚对话$HIDDEN",
            "dialogues": [
                {
                    "id": "3071501",
                    "speaker": "凯亚",
                    "text": "哦！真是精彩。"
                },
                {
                    "id": "3071502",
                    "speaker": "凯亚",
                    "text": "原来阁下是一位训练有素的战士。"
                },
                {
                    "id": "3071503",
                    "speaker": "凯亚",
                    "text": "刚才在庙宇里，一路上的那些战斗，实在令人大开眼界。",
                    "choices": [
                        {
                            "id": "3071504",
                            "text": "您过奖了…",
                            "response": [
                                {
                                    "id": "3071506",
                                    "speaker": "凯亚",
                                    "text": "哈哈哈。连骑士般的「谦虚」品德也已经具备了啊！"
                                },
                                {
                                    "id": "3071507",
                                    "speaker": "凯亚",
                                    "text": "阁下拯救蒙德的英姿，未来一定会传遍整座自由之城。"
                                },
                                {
                                    "id": "3071508",
                                    "speaker": "凯亚",
                                    "text": "今后有空的话，还请到骑士团总部来聊聊天吧。"
                                },
                                {
                                    "id": "3071509",
                                    "speaker": "凯亚",
                                    "text": "嗯…或者，我也知道一家不错的酒馆哦？"
                                }
                            ]
                        },
                        {
                            "id": "3071505",
                            "text": "夸得太肉麻了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "30713",
