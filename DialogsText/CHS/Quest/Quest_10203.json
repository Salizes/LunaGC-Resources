    "talks": [
        {
            "id": "1020301",
            "objective": "(test)与琴谈话$HIDDEN",
            "dialogues": [
                {
                    "id": "102030101",
                    "speaker": "琴",
                    "text": "呼…可莉这孩子，其实是我们西风骑士团的「火花骑士」。"
                },
                {
                    "id": "102030102",
                    "speaker": "派蒙",
                    "text": "什么？竟然连可莉都是骑士吗！",
                    "choices": [
                        {
                            "id": "102030103",
                            "text": "那么，可不可以给派蒙也…",
                            "response": [
                                {
                                    "id": "102030105",
                                    "speaker": "派蒙",
                                    "text": "没错，派蒙不甘心！"
                                },
                                {
                                    "id": "102030106",
                                    "speaker": "派蒙",
                                    "text": "话说回来，称号是「火花骑士」，也难怪可莉的宝物会是那种东西吧。"
                                },
                                {
                                    "id": "102030107",
                                    "speaker": "琴",
                                    "text": "嗯，虽然平时没有少给骑士团添麻烦，但骑士们还是很关心她。"
                                },
                                {
                                    "id": "102030108",
                                    "speaker": "琴",
                                    "text": "说起她的来历，其实…"
                                },
                                {
                                    "id": "102030109",
                                    "speaker": "琴",
                                    "text": "总之，以后你会对她有更多了解的。"
                                },
                                {
                                    "id": "102030110",
                                    "speaker": "琴",
                                    "text": "#到时也请你对她多关照些了，{NICKNAME}。"
                                }
                            ]
                        },
                        {
                            "id": "102030104",
                            "text": "而且听上去比「荣誉骑士」还强？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020302",
            "objective": "(test)自由对话可莉$HIDDEN",
            "dialogues": [
                {
                    "id": "102030201",
                    "speaker": "可莉",
                    "text": "呜…下次我会更小心的。"
                },
                {
                    "id": "102030202",
                    "speaker": "可莉",
                    "text": "下一次，我会安全地完成一场伟大的冒险！"
                },
                {
                    "id": "102030203",
                    "speaker": "可莉",
                    "text": "我听说「冒险家协会」也有一套冒险的守则，是不是应该去拜托他们呢…"
                },
                {
                    "id": "102030204",
                    "speaker": "派蒙",
                    "text": "唉，要是这段话被塞琉斯会长听见了…"
                },
                {
                    "id": "102030205",
                    "speaker": "派蒙",
                    "text": "他一定会去拜托琴团长，继续加长可莉的禁闭时间吧…"
                }
            ]
        },
