    "talks": [
        {
            "id": "7525701",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752570201",
                    "speaker": "Player",
                    "text": "听上去挺有趣的。"
                },
                {
                    "id": "752570202",
                    "speaker": "伊斯特莉",
                    "text": "太好了！那么几位客人，谁先来？"
                },
                {
                    "id": "752570203",
                    "speaker": "因提",
                    "text": "本人建议，女士优先。"
                },
                {
                    "id": "752570204",
                    "speaker": "韦涅季克特",
                    "text": "没意见。"
                },
                {
                    "id": "752570205",
                    "speaker": "苏玛",
                    "text": "哎呀，多么绅士的小伙子啊，我就想和你们这种年轻人合影。"
                },
                {
                    "id": "752570206",
                    "speaker": "因提",
                    "text": "欸？也…也不是不行。"
                },
                {
                    "id": "752570207",
                    "speaker": "韦涅季克特",
                    "text": "咳咳，没意见。"
                },
                {
                    "id": "752570208",
                    "speaker": "苏玛",
                    "text": "嗯…不，还不够，再来三个小伙子吧，应该可以办到吧？"
                },
                {
                    "id": "752570209",
                    "speaker": "苏玛",
                    "text": "唔…最好还能来点烟花，我年轻的时候，最喜欢那样的氛围了。"
                },
                {
                    "id": "752570210",
                    "speaker": "伊斯特莉",
                    "text": "没问题，那我们开始吧。"
                }
            ]
        },
        {
            "id": "7525702",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7525703",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752570501",
                    "speaker": "Player",
                    "text": "开始吧！"
                }
            ]
        },
        {
            "id": "7525704",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "752570401",
