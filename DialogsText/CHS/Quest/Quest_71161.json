    "talks": [
        {
            "id": "7116101",
            "objective": "霄灯-艾梅莉埃$HIDDEN",
            "dialogues": [
                {
                    "id": "711610301",
                    "speaker": "艾梅莉埃",
                    "text": "#…{NICKNAME}？呵…节日快乐，久疏问候了。",
                    "choices": [
                        {
                            "id": "711610311",
                            "text": "我也放好霄灯啦。",
                            "response": [
                                {
                                    "id": "711610312",
                                    "speaker": "艾梅莉埃",
                                    "text": "这是你的霄灯么？很漂亮，我也在考虑多购置几盏带回枫丹…"
                                },
                                {
                                    "id": "711610313",
                                    "speaker": "艾梅莉埃",
                                    "text": "#希望你的心愿能圆满实现，{NICKNAME}。",
                                    "choices": [
                                        {
                                            "id": "711610302",
                                            "text": "节日快乐，艾梅莉埃。",
                                            "response": [
                                                {
                                                    "id": "711610304",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "算是吧。我本来就有到璃月考察花卉香精的打算，这次正好有商船来璃月做贸易，我就随船同来了。"
                                                },
                                                {
                                                    "id": "711610305",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "没想到，恰好遇见了海灯节。既逢佳节，再为工作烦心的话，难免有些不解风情，我就打算放下心来，游玩一番。"
                                                },
                                                {
                                                    "id": "711610306",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "我刚向一位女士请教了霄灯的编造方法，亲手编了一盏霄灯，正准备放飞呢。"
                                                },
                                                {
                                                    "id": "711610307",
                                                    "speaker": "Player",
                                                    "text": "肯定很漂亮！"
                                                },
                                                {
                                                    "id": "711610308",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "谢谢。我听那位女士说，还要把心愿写在霄灯上，然后将它放飞上天。"
                                                },
                                                {
                                                    "id": "711610309",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "唔，该写什么心愿好呢…"
                                                },
                                                {
                                                    "id": "711610310",
                                                    "speaker": "Black Screen",
                                                    "text": "与艾梅莉埃一同放飞了霄灯…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711610303",
                                            "text": "你是来璃月玩的么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711610302",
                            "text": "节日快乐，艾梅莉埃。"
                        },
                        {
                            "id": "711610303",
                            "text": "你是来璃月玩的么？"
                        }
                    ]
                }
