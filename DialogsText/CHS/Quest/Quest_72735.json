    "talks": [
        {
            "id": "7273501",
            "objective": "(test)任务npc对话block$HIDDEN",
            "dialogues": [
                {
                    "id": "727350101",
                    "speaker": "「千日喧哗大飞车」",
                    "text": "你们三个，谁是老大？站出来面对我！"
                },
                {
                    "id": "727350102",
                    "speaker": "「千日喧哗大飞车」",
                    "text": "我「千日喧哗大飞车」可是精锐中的精锐，代表「花角玉将」大人，来取你们荒泷派老大的首级！"
                },
                {
                    "id": "727350103",
                    "speaker": "派蒙",
                    "text": "呜哇，好凶好凶！说话也好狠！这次好像真的来了个强人…"
                },
                {
                    "id": "727350104",
                    "speaker": "荒泷一斗",
                    "text": "什么乱七八糟的！还有，你的称号里居然也用了「大」字，是想和本大爷抢风头吗？"
                },
                {
                    "id": "727350105",
                    "speaker": "荒泷一斗",
                    "text": "本大爷揍的就是你这种精锐！"
                },
                {
                    "id": "727350106",
                    "speaker": "「千日喧哗大飞车」",
                    "text": "好，好高的男人，居然还是…鬼族！"
                },
                {
                    "id": "727350107",
                    "speaker": "「千日喧哗大飞车」",
                    "text": "如此豪气飒爽的家伙，怎么会玩斗虫这种小孩喜欢的游戏…真是见了鬼了！"
                },
                {
                    "id": "727350108",
                    "speaker": "荒泷一斗",
                    "text": "你说什么？你在小瞧斗虫吗？真是胆大包天！"
                },
                {
                    "id": "727350109",
                    "speaker": "荒泷一斗",
                    "text": "根本不懂斗虫精髓的家伙，必须由热爱斗虫的人来修正！本大爷就好好教训你一回！",
                    "choices": [
                        {
                            "id": "727350110",
                            "text": "教训他！教训他！",
                            "response": [
                                {
                                    "id": "727350112",
                                    "speaker": "派蒙",
                                    "text": "对对对，可不能让他一直这么嚣张！就看你的了，放牛的！"
                                },
                                {
                                    "id": "727350113",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "没办法了…来就来，谁怕谁！"
                                }
                            ]
                        },
                        {
                            "id": "727350111",
                            "text": "修正他！修正他！"
                        }
                    ]
                }
            ]
        }
    ]
}