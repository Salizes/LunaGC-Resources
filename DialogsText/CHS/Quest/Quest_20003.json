        }
    },
    "talks": [
        {
            "id": "2000301",
            "objective": "与歌德对话",
            "dialogues": [
                {
                    "id": "200030101",
                    "speaker": "歌德",
                    "text": "唉，看来我还是得自己跑一趟…"
                },
                {
                    "id": "200030102",
                    "speaker": "歌德",
                    "text": "我这把老骨头，非得散架不可…"
                },
                {
                    "id": "200030103",
                    "speaker": "Player",
                    "text": "有什么急事吗？"
                },
                {
                    "id": "200030104",
                    "speaker": "歌德",
                    "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…"
                },
                {
                    "id": "200030105",
                    "speaker": "歌德",
                    "text": "你也知道，那群愚人众把我的酒店给包下来了吧。"
                },
                {
                    "id": "200030106",
                    "speaker": "歌德",
                    "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。"
                },
                {
                    "id": "200030107",
                    "speaker": "歌德",
                    "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。"
                },
                {
                    "id": "200030108",
                    "speaker": "歌德",
                    "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。"
                },
                {
                    "id": "200030109",
                    "speaker": "歌德",
                    "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。"
                },
                {
                    "id": "200030110",
                    "speaker": "歌德",
                    "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…",
                    "choices": [
                        {
                            "id": "200030111",
                            "text": "我来帮您。",
                            "response": [
                                {
                                    "id": "200030113",
                                    "speaker": "歌德",
                                    "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…"
                                },
                                {
                                    "id": "200030114",
                                    "speaker": "歌德",
                                    "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
                                }
                            ]
                        },
                        {
                            "id": "200030112",
                            "text": "你先在这歇一会吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2000302",
            "objective": "将木材带给歌德",
            "dialogues": [
                {
                    "id": "200030201",
                    "speaker": "歌德",
                    "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
                }
            ]
        },
        {
            "id": "2000303",
            "objective": "与歌德对话",
            "dialogues": [
                {
                    "id": "200030301",
                    "speaker": "歌德",
                    "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…"
                },
                {
                    "id": "200030302",
                    "speaker": "歌德",
                    "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…"
                },
                {
                    "id": "200030303",
                    "speaker": "Player",
                    "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。"
                },
                {
                    "id": "200030304",
                    "speaker": "歌德",
                    "text": "对！就是这个名字，哎哟…我是真的记不住。"
                },
                {
                    "id": "200030305",
                    "speaker": "派蒙",
                    "text": "咦？莫娜还没交房租吗？"
                },
                {
                    "id": "200030306",
                    "speaker": "歌德",
                    "text": "可不是嘛，其他的租客都把房租交了，就剩她了。"
                },
                {
                    "id": "200030307",
                    "speaker": "歌德",
                    "text": "我跑了好几趟了，但她一直都不在家。"
                },
                {
                    "id": "200030308",
                    "speaker": "歌德",
                    "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
                }
            ]
        },
        {
            "id": "2000304",
            "objective": "与歌德对话",
            "dialogues": []
        },
        {
            "id": "2000306",
            "objective": "",
            "dialogues": [
                {
                    "id": "200030601",
                    "speaker": "Player",
                    "text": "骑士团里的图书馆。"
                },
                {
                    "id": "200030602",
                    "speaker": "派蒙",
                    "text": "图书馆啊…嗯！骑士团的图书馆特别大，莫娜说不定会去那边查资料呢。"
                },
                {
                    "id": "200030603",
                    "speaker": "派蒙",
                    "text": "那我们就过去看看吧！"
                }
            ]
        },
        {
            "id": "2000307",
            "objective": "",
            "dialogues": [
                {
                    "id": "200030701",
                    "speaker": "Player",
                    "text": "能买到沙拉的猎鹿人。"
                },
                {
                    "id": "200030702",
                    "speaker": "派蒙",
                    "text": "猎鹿人…嗯…说不定莫娜会去买沙拉吃呢。我们过去看看吧。"
                },
                {
                    "id": "200030703",
                    "speaker": "派蒙",
                    "text": "希望莫娜最近手里的钱够买沙拉的…"
                }
            ]
        },
        {
            "id": "2000308",
            "objective": "",
            "dialogues": [
                {
                    "id": "200030801",
                    "speaker": "Player",
                    "text": "直接去问问凯瑟琳。"
                },
                {
                    "id": "200030802",
                    "speaker": "派蒙",
                    "text": "去问凯瑟琳小姐啊…也对，凯瑟琳小姐什么都知道，问她准没错。"
                },
                {
                    "id": "200030803",
                    "speaker": "派蒙",
                    "text": "那我们赶紧去问问她吧。"
                }
            ]
        },
        {
            "id": "2000305",
            "objective": "拜访莫娜",
            "dialogues": []
        },
        {
            "id": "2000309",
            "objective": "去图书馆寻找莫娜",
            "dialogues": [
                {
                    "id": "200030901",
                    "speaker": "派蒙",
                    "text": "图书馆里好像没见到莫娜呢，丽莎小姐也不在。"
                },
                {
                    "id": "200030902",
                    "speaker": "派蒙",
                    "text": "我们去问问门口的那位西风骑士，看看他有没有见过莫娜吧。"
                }
            ]
        },
        {
            "id": "2000310",
            "objective": "向威拉格询问莫娜的去向",
            "dialogues": [
                {
                    "id": "200031001",
                    "speaker": "威拉格",
                    "text": "你好，有什么能为你效劳的吗？"
                },
                {
                    "id": "200031002",
                    "speaker": "Player",
                    "text": "请问你见过一个这样的女孩吗…"
                },
                {
                    "id": "200031003",
                    "speaker": "Black Screen",
                    "text": "（旅行者向威拉格描述了莫娜的外貌特点…）"
                },
                {
                    "id": "200031004",
                    "speaker": "威拉格",
                    "text": "噢！你说她啊，我记得，那个帽子很大的女孩。"
                },
                {
                    "id": "200031005",
                    "speaker": "威拉格",
                    "text": "她经常过来图书馆查资料，一查就是一天，我印象很深的。"
                },
                {
                    "id": "200031006",
                    "speaker": "威拉格",
                    "text": "不过，最近她倒是没怎么来图书馆了，你们来这里应该是找不到她了…"
                },
                {
                    "id": "200031007",
                    "speaker": "Player",
                    "text": "来晚了啊…"
                },
                {
                    "id": "200031008",
                    "speaker": "威拉格",
                    "text": "她要是再来的话，我会告诉她你们在找她的。"
                },
                {
                    "id": "200031009",
                    "speaker": "威拉格",
                    "text": "不过，我也就能帮你这个忙了…"
                },
                {
                    "id": "200031010",
                    "speaker": "Player",
                    "text": "谢谢你。"
                },
                {
                    "id": "200031011",
                    "speaker": "威拉格",
                    "text": "小事，不用客气。"
                },
                {
                    "id": "200031012",
                    "speaker": "派蒙",
                    "text": "看来莫娜不在图书馆啊，没办法，只能告诉歌德先生，我们今天没找到莫娜了…"
                }
            ]
        },
        {
            "id": "2000311",
            "objective": "去猎鹿人餐馆寻找莫娜",
            "dialogues": [
                {
                    "id": "200031101",
                    "speaker": "莎拉",
                    "text": "你好！有什么想吃的吗？"
                },
                {
                    "id": "200031102",
                    "speaker": "Player",
                    "text": "请问你见过一个这样的女孩吗…"
                },
                {
                    "id": "200031103",
                    "speaker": "Black Screen",
                    "text": "（旅行者向莎拉描述了莫娜的外貌特点…）"
                },
                {
                    "id": "200031104",
                    "speaker": "莎拉",
                    "text": "你说莫娜啊，唔…她前段时间确实每天晚上都会来买沙拉，有时候还会拜托我往沙拉里多加点蛋。"
                },
                {
                    "id": "200031105",
                    "speaker": "派蒙",
                    "text": "莫娜，还是一如既往地没钱啊…"
                },
                {
                    "id": "200031106",
                    "speaker": "莎拉",
                    "text": "但最近，她已经连续好几天没来了。"
                },
                {
                    "id": "200031107",
                    "speaker": "莎拉",
                    "text": "如果你们急着找她，那等她下次来买沙拉的时候，我可以帮你们告诉她一声。"
                },
                {
                    "id": "200031108",
                    "speaker": "Player",
                    "text": "谢谢你。"
                },
                {
                    "id": "200031109",
                    "speaker": "派蒙",
                    "text": "看来莫娜最近也没有来过猎鹿人呢。唔…只能回去告诉歌德先生，我们今天没找到莫娜了…"
                }
            ]
        },
        {
            "id": "2000312",
            "objective": "向凯瑟琳询问莫娜的去向",
            "dialogues": [
                {
                    "id": "200031201",
                    "speaker": "凯瑟琳",
                    "text": "您好，请问有什么事吗？"
                },
                {
                    "id": "200031202",
                    "speaker": "Player",
                    "text": "请问你最近见过莫娜吗？"
                },
                {
                    "id": "200031203",
                    "speaker": "凯瑟琳",
                    "text": "莫娜？唔…我最近还真没见过她…"
                },
                {
                    "id": "200031204",
                    "speaker": "凯瑟琳",
                    "text": "如果你们急着找她的话，就在冒险家协会挂个委托吧。"
                },
                {
                    "id": "200031205",
                    "speaker": "Player",
                    "text": "谢谢，我们自己再去找找吧。"
                },
                {
                    "id": "200031206",
                    "speaker": "派蒙",
                    "text": "看来，凯瑟琳小姐不知道莫娜的去向呢。只能告诉歌德先生，我们今天没找到莫娜了…"
                }
            ]
        },
        {
            "id": "2000313",
            "objective": "向歌德回报",
            "dialogues": [
                {
                    "id": "200031301",
                    "speaker": "歌德",
                    "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？"
                },
                {
                    "id": "200031302",
                    "speaker": "Player",
                    "text": "她好像今天不在家。"
                },
                {
                    "id": "200031303",
                    "speaker": "歌德",
                    "text": "好吧…她欠的租金倒也不多，那就再缓几天。"
                },
                {
                    "id": "200031304",
                    "speaker": "歌德",
                    "text": "这些报酬请你们收下吧，谢谢你们帮忙了。"
                }
            ]
        },
        {
            "id": "2000304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200030401",
                    "speaker": "歌德",
                    "text": "阿斯…阿斯托洛…什么来着…"
                }
            ]
        },
        {
            "id": "2000305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200030501",
                    "speaker": "派蒙",
                    "text": "莫娜，你在吗？"
                },
                {
                    "id": "200030502",
                    "speaker": "Player",
                    "text": "莫娜，该交房租啦！"
                },
                {
                    "id": "200030503",
                    "speaker": "派蒙",
                    "text": "呃…莫娜好像不在呢…"
                },
                {
                    "id": "200030504",
                    "speaker": "派蒙",
                    "text": "奇怪，她一般不都是在房间里吗？难道今天出门办事去了？"
                },
                {
                    "id": "200030505",
                    "speaker": "派蒙",
                    "text": "难、难道！莫娜已经被饿晕在房间里了，根本没力气来开门吗！？",
                    "choices": [
                        {
                            "id": "200030506",
                            "text": "不至于啦…",
                            "response": [
                                {
                                    "id": "200030508",
                                    "speaker": "派蒙",
                                    "text": "是、是这样吗？"
                                },
                                {
                                    "id": "200030509",
                                    "speaker": "派蒙",
                                    "text": "但是，我们要去哪里才能找到莫娜呢…"
                                }
                            ]
                        },
                        {
                            "id": "200030507",
                            "text": "她之前都说自己想到赚钱的方法了。"
                        }
                    ]
                }
            ]
        }
    ]
}