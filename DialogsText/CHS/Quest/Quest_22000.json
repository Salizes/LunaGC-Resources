            "小蒙": 32,
            "派蒙": 1,
            "璐璐": 1,
            "阿飞": 8
        }
    },
    "talks": [
        {
            "id": "2200001",
            "objective": "与璐璐、阿飞、小蒙对话",
            "dialogues": [
                {
                    "id": "220000101",
                    "speaker": "小蒙",
                    "text": "今天我们怎么玩？"
                },
                {
                    "id": "220000102",
                    "speaker": "阿飞",
                    "text": "哼，要是没人来扮海盗，今天也玩不了。"
                },
                {
                    "id": "220000103",
                    "speaker": "小蒙",
                    "text": "可是，谁也不愿意扮海盗，怎么办呢…"
                },
                {
                    "id": "220000104",
                    "speaker": "Player",
                    "text": "你们在做什么？"
                },
                {
                    "id": "220000105",
                    "speaker": "小蒙",
                    "text": "我们在玩游戏呢，可总是缺一个人来扮海盗。"
                },
                {
                    "id": "220000106",
                    "speaker": "小蒙",
                    "text": "因为没人扮海盗来抢劫，我们一直没法开始玩…"
                },
                {
                    "id": "220000107",
                    "speaker": "小蒙",
                    "text": "#对了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你能来扮海盗吗？",
                    "choices": [
                        {
                            "id": "220000108",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "220000109",
                                    "speaker": "小蒙",
                                    "text": "好哎！那我们就去准备啦！"
                                },
                                {
                                    "id": "220000115",
                                    "speaker": "小蒙",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了的话，就过来吧。"
                                }
                            ]
                        },
                        {
                            "id": "220000110",
                            "text": "我不太了解这方面…",
                            "response": [
                                {
                                    "id": "220000111",
                                    "speaker": "小蒙",
                                    "text": "没关系啦，海盗…唔，应该是那种蛮不讲理，随便抢走人家东西的坏人。"
                                },
                                {
                                    "id": "220000112",
                                    "speaker": "小蒙",
                                    "text": "虽然我也没有见过，只是听北斗姐姐讲过。"
                                },
                                {
                                    "id": "220000113",
                                    "speaker": "小蒙",
                                    "text": "但我觉得…这种人，应该挺好演的吧。"
                                },
                                {
                                    "id": "220000114",
                                    "speaker": "小蒙",
                                    "text": "#嘿嘿，总之就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200002",
            "objective": "与「船长」小蒙对话",
            "dialogues": [
                {
                    "id": "220000201",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "220000202",
                    "speaker": "小蒙",
                    "text": "那我们直接开始吧。"
                },
                {
                    "id": "220000203",
                    "speaker": "小蒙",
                    "text": "从哪开始呢…"
                },
                {
                    "id": "220000204",
                    "speaker": "Player",
                    "text": "那个，抢劫…"
                },
                {
                    "id": "220000205",
                    "speaker": "璐璐",
                    "text": "呜哇！是海盗！"
                },
                {
                    "id": "220000206",
                    "speaker": "阿飞",
                    "text": "璐璐快过来，我来保护你！"
                },
                {
                    "id": "220000207",
                    "speaker": "小蒙",
                    "text": "你是海盗吧，为什么要来抢劫？",
                    "choices": [
                        {
                            "id": "220000208",
                            "text": "我是海盗。",
                            "response": [
                                {
                                    "id": "220000210",
                                    "speaker": "小蒙",
                                    "text": "海盗也分好坏，不一定都要抢劫呀。"
                                },
                                {
                                    "id": "220000211",
                                    "speaker": "小蒙",
                                    "text": "北斗姐姐也说自己是海盗，可是她是很好的人，会给我好吃的，大家都很喜欢她。"
                                },
                                {
                                    "id": "220000212",
                                    "speaker": "小蒙",
                                    "text": "#为什么{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}要做坏海盗，不做好海盗呢？"
                                },
                                {
                                    "id": "220000213",
                                    "speaker": "派蒙",
                                    "text": "明明是你说，海盗是那种「蛮不讲理」的人吧…",
                                    "choices": [
                                        {
                                            "id": "220000214",
                                            "text": "好吧，我错了…",
                                            "response": [
                                                {
                                                    "id": "220000216",
                                                    "speaker": "小蒙",
                                                    "text": "唔，愿意改邪归正是好事。这也是北斗姐姐说的。"
                                                },
                                                {
                                                    "id": "220000217",
                                                    "speaker": "小蒙",
                                                    "text": "那么，你就帮忙去清理一下周围吧，只要做好事，那就可以做好人，或者好海盗。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220000215",
                                            "text": "我想做个好人。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220000209",
                            "text": "海盗就是要抢劫。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200003",
            "objective": "用「风」或「水」来清洗甲板",
            "dialogues": [
                {
                    "id": "220000301",
                    "speaker": "小蒙",
                    "text": "清洗好了吗？"
                },
                {
                    "id": "220000302",
                    "speaker": "Player",
                    "text": "清洗好了。"
                },
                {
                    "id": "220000303",
                    "speaker": "小蒙",
                    "text": "嗯！辛苦你啦，这些给你，谢谢你陪我们玩。"
                },
                {
                    "id": "220000304",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}以后也要做好人啊。"
                },
                {
                    "id": "220000305",
                    "speaker": "阿飞",
                    "text": "喂，什么时候能轮到我做船长啊？"
                },
                {
                    "id": "220000306",
                    "speaker": "小蒙",
                    "text": "下次吧，下次就归你了。"
                },
                {
                    "id": "220000307",
                    "speaker": "阿飞",
                    "text": "哼，上次你就这么说的…"
                }
            ]
        },
        {
            "id": "2200005",
            "objective": "(test)防止进度被重置$HIDDEN",
            "dialogues": [
                {
                    "id": "220000501",
                    "speaker": "小蒙",
                    "text": "清理好了吗？"
                },
                {
                    "id": "220000502",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "220000503",
                    "speaker": "小蒙",
                    "text": "#快去清理吧，这可是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}改邪归正的好机会喔。"
                },
                {
                    "id": "220000504",
                    "speaker": "阿飞",
                    "text": "喂，我说啊，做一下清洁工作就能成好人了吗？"
                },
                {
                    "id": "220000505",
                    "speaker": "小蒙",
                    "text": "只要愿意去做好事，那就是好人。"
                },
                {
                    "id": "220000506",
                    "speaker": "阿飞",
                    "text": "这也太简单了…"
                },
                {
                    "id": "220000507",
                    "speaker": "小蒙",
                    "text": "做了好事，就是好人，做了坏事，就是坏人，就这么简单。"
                },
                {
                    "id": "220000508",
                    "speaker": "阿飞",
                    "text": "哼，你说是简单，但如果这么简单，那天下哪里还有坏人呢？"
                },
                {
                    "id": "220000509",
                    "speaker": "小蒙",
                    "text": "因为天下的所有事都是说起来容易，做起来难。"
                },
                {
                    "id": "220000510",
                    "speaker": "小蒙",
                    "text": "而坏事做起来，总是比好事容易的。"
                },
                {
                    "id": "220000511",
                    "speaker": "阿飞",
                    "text": "这也是北斗姐姐教你的？"
                },
                {
                    "id": "220000512",
                    "speaker": "小蒙",
                    "text": "是我从书里看的。"
                }
            ]
        },
        {
            "id": "2200004",
            "objective": "与小蒙对话",
            "dialogues": []
        },
        {
            "id": "2200004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220000401",
                    "speaker": "小蒙",
                    "text": "你准备好了吗？"
                }
            ]
        },
        {
            "id": "2200007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220000701",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "220000702",
                    "speaker": "小蒙",
                    "text": "不用急，准备好了再来找我吧。"
                }
            ]
        }
    ]
}