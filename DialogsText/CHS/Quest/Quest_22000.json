{
    "quest": {
        "id": "22000",
        "title": "璃月港，有海盗！",
        "description": "有一群孩子想要玩一场海盗游戏…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
