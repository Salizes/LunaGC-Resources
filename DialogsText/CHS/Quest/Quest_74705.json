{
    "quest": {
        "id": "74705",
        "title": "水族箱里的…我们？",
        "description": "朋友们似乎在欣赏水族箱…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 16,
        "total_speaker_counts": {
            "千织": 4,
            "夏沃蕾": 5,
            "派蒙": 4,
            "芙宁娜": 3
        }
    },
    "talks": [
        {
            "id": "7470501",
            "objective": "前往水族箱附近…",
            "dialogues": [
                {
                    "id": "747050101",
                    "speaker": "夏沃蕾",
                    "text": "…我觉得是这条。"
                },
                {
                    "id": "747050102",
                    "speaker": "芙宁娜",
                    "text": "有道理。"
                },
                {
                    "id": "747050103",
                    "speaker": "千织",
                    "text": "为什么？"
                },
                {
                    "id": "747050104",
                    "speaker": "夏沃蕾",
                    "text": "看看这尾摆的颜色，整个水族箱里没有比它更时髦的了。"
                },
                {
                    "id": "747050105",
                    "speaker": "千织",
                    "text": "虽然颜色艳了点，但好吧，就当你是在夸我。"
                },
                {
                    "id": "747050106",
                    "speaker": "派蒙",
                    "text": "哇！好多人呀！大家都是来逛水族馆的吗？"
                },
                {
                    "id": "747050107",
                    "speaker": "芙宁娜",
                    "text": "嗯，刚拍完一个镜头，趁休息时间来欣赏一下。"
                },
                {
                    "id": "747050108",
                    "speaker": "派蒙",
                    "text": "你们刚刚在聊什么？"
                },
                {
                    "id": "747050109",
                    "speaker": "夏沃蕾",
                    "text": "哪条鱼和千织比较像。"
                },
                {
                    "id": "747050110",
                    "speaker": "派蒙",
                    "text": "怎么你们也…？！"
                },
                {
                    "id": "747050111",
                    "speaker": "芙宁娜",
                    "text": "啊…哈哈，好像是聊天时听哥伦比娅小姐提到类似的话题，觉得很有趣，我们不知不觉就也这么玩上了。"
                },
                {
                    "id": "747050112",
                    "speaker": "派蒙",
                    "text": "原来这东西还能传染的…"
                },
                {
                    "id": "747050113",
                    "speaker": "千织",
                    "text": "哦！那条像你，夏沃蕾。"
                },
                {
                    "id": "747050114",
                    "speaker": "夏沃蕾",
                    "text": "怎么说？"
                },
                {
                    "id": "747050115",
                    "speaker": "千织",
                    "text": "一闲下来就绕着水缸游圈，在锻炼呢。"
                },
                {
                    "id": "747050116",
                    "speaker": "夏沃蕾",
                    "text": "…我在你心里就这形象吗？"
                }
            ]
        }
    ]
}