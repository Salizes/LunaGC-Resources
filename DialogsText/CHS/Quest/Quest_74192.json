    "talks": [
        {
            "id": "7419206",
            "objective": "用于处理隐藏派蒙$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419207",
            "objective": "用于处理隐藏派蒙$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7419201",
            "objective": "(test)常驻对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741920101",
                    "speaker": "夏诺蒂拉",
                    "text": "我看见：王座上的火焰已经熄灭，烧却的灰烬重新变成了树。"
                },
                {
                    "id": "741920102",
                    "speaker": "夏诺蒂拉",
                    "text": "花朵随着你的脚步绽放，你能给必然颓败的未来带来变化。"
                },
                {
                    "id": "741920103",
                    "speaker": "Player",
                    "text": "夏诺蒂拉？"
                },
                {
                    "id": "741920104",
                    "speaker": "夏诺蒂拉",
                    "text": "#咦，原来是{NICKNAME}{M#哥哥}{F#姐姐}！你怎么会在这里？"
                },
                {
                    "id": "741920105",
                    "speaker": "夏诺蒂拉",
                    "text": "啊，对了！金色的蝴蝶已经回来了，要赶紧去看看才行！再见啦！"
                }
            ]
        },
        {
            "id": "7419202",
            "objective": "(test)常驻对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741920201",
                    "speaker": "夏诺蒂拉",
                    "text": "呜呜…"
                },
                {
                    "id": "741920202",
                    "speaker": "Player",
                    "text": "夏诺蒂拉…"
                },
                {
                    "id": "741920203",
                    "speaker": "夏诺蒂拉",
                    "text": "#咦？{M#哥哥}{F#姐姐}…你是谁？我还以为，这里除了我谁也进不来。"
                },
                {
                    "id": "741920204",
                    "speaker": "夏诺蒂拉",
                    "text": "你为什么知道我的名字？",
                    "choices": [
                        {
                            "id": "741920205",
                            "text": "我们认识。",
                            "response": [
                                {
                                    "id": "741920206",
                                    "speaker": "夏诺蒂拉",
                                    "text": "骗人！你肯定也和那些怪物一样…"
                                }
                            ]
                        },
                        {
                            "id": "741920207",
                            "text": "（撒谎）是瑟琳让我来找你的。",
                            "response": [
                                {
                                    "id": "741920208",
                                    "speaker": "夏诺蒂拉",
                                    "text": "是喔…老是让她这么担心，我真是个坏孩子…"
                                },
                                {
                                    "id": "741920209",
                                    "speaker": "Player",
                                    "text": "#我是{NICKNAME}，你还记得吗？"
                                },
                                {
                                    "id": "741920210",
                                    "speaker": "夏诺蒂拉",
                                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，我想起来了…虽然是个一口能吞下世界的大怪兽，但是很善良。",
                                    "choices": [
                                        {
                                            "id": "741920211",
                                            "text": "真没礼貌。",
                                            "response": [
                                                {
                                                    "id": "741920212",
                                                    "speaker": "夏诺蒂拉",
                                                    "text": "对不起喔。"
                                                },
                                                {
                                                    "id": "741920214",
                                                    "speaker": "Player",
                                                    "text": "发生什么事情了？"
                                                },
                                                {
                                                    "id": "741920215",
                                                    "speaker": "夏诺蒂拉",
                                                    "text": "我看到，有几个人，他们慢慢融化、变成了怪物…"
                                                },
                                                {
                                                    "id": "741920216",
                                                    "speaker": "夏诺蒂拉",
                                                    "text": "啊啊，好可怕…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741920213",
                                            "text": "谢谢。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419203",
            "objective": "(test)常驻对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741920301",
                    "speaker": "夏诺蒂拉",
                    "text": "既然记忆能被制作成书，那么反过来，书本中的内容，应该也能被直接写入记忆…"
                },
                {
                    "id": "741920302",
                    "speaker": "Player",
                    "text": "夏诺蒂拉？"
                },
                {
                    "id": "741920303",
                    "speaker": "夏诺蒂拉",
                    "text": "#啊，是奇奇怪怪的{NICKNAME}{M#哥哥}{F#姐姐}。怎么了，找我有什么事吗？"
                },
                {
                    "id": "741920304",
                    "speaker": "Player",
                    "text": "你在说什么…"
                },
                {
                    "id": "741920305",
                    "speaker": "夏诺蒂拉",
                    "text": "嗯，不管怎么想，将「记忆」制作成书本都是相当不可思议的事…"
                },
                {
                    "id": "741920306",
                    "speaker": "夏诺蒂拉",
                    "text": "制作这本书的人，一定将「记{RUBY#[D]妄想}忆」中的心情当作最为珍贵的事物，才能做出这样的书吧。"
                },
                {
                    "id": "741920307",
                    "speaker": "夏诺蒂拉",
                    "text": "不过这样子的书，确实很难懂…"
                },
                {
                    "id": "741920308",
                    "speaker": "夏诺蒂拉",
                    "text": "…而且，会对「读者」产生什么样的影响，也不知道。这可真是…"
                }
            ]
        },
        {
            "id": "7419204",
            "objective": "(test)常驻对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741920401",
                    "speaker": "夏诺蒂拉",
                    "text": "……"
                },
                {
                    "id": "741920402",
                    "speaker": "Player",
                    "text": "夏诺蒂拉？"
                },
                {
                    "id": "741920403",
                    "speaker": "夏诺蒂拉",
                    "text": "咦？你终于回来了！呜呜，我好担心，要是你一直回不来要怎么办…"
                },
                {
                    "id": "741920404",
                    "speaker": "夏诺蒂拉",
                    "text": "你进去以后，我一直在外面等，等了好久、好久。我去找别的美露莘帮忙，但大家都不知道怎么办…"
                },
                {
                    "id": "741920405",
                    "speaker": "Player",
                    "text": "（…看来我也在这里待得够久了。）"
                },
                {
                    "id": "741920406",
                    "speaker": "Player",
                    "text": "我该走了。"
                },
                {
                    "id": "741920407",
                    "speaker": "夏诺蒂拉",
                    "text": "#咦？{NICKNAME}，你要去哪…"
                },
                {
                    "id": "741920408",
                    "speaker": "Player",
                    "text": "别担心。我找到夏诺蒂拉就回来。"
                },
                {
                    "id": "741920409",
                    "speaker": "Player",
                    "text": "再稍微等我一下，好吗？"
                },
                {
                    "id": "741920410",
                    "speaker": "Player",
                    "text": "虽然我知道，对你说这些也没用。",
                    "choices": [
                        {
                            "id": "741920411",
                            "text": "不过，相信我。",
                            "response": [
                                {
                                    "id": "741920413",
                                    "speaker": "夏诺蒂拉",
                                    "text": "#{NICKNAME}…"
                                }
                            ]
                        },
                        {
                            "id": "741920412",
                            "text": "毋须担心。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7419205",
            "objective": "(test)常驻对话$HIDDEN",
            "dialogues": []
        }
    ]
}