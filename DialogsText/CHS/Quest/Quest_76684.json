    "talks": [
        {
            "id": "7668401",
            "objective": "与恰斯卡对话",
            "dialogues": [
                {
                    "id": "766840101",
                    "speaker": "恰斯卡",
                    "text": "那…成交？"
                },
                {
                    "id": "766840102",
                    "speaker": "夏沃蕾",
                    "text": "成交。"
                },
                {
                    "id": "766840103",
                    "speaker": "派蒙",
                    "text": "成交什么？我是不是错过了什么重要的事？"
                },
                {
                    "id": "766840104",
                    "speaker": "恰斯卡",
                    "text": "正式的说法，应该是确定签署一份备忘录——"
                },
                {
                    "id": "766840105",
                    "speaker": "夏沃蕾",
                    "text": "《关于提升射手效能的联合训练备忘录》。"
                },
                {
                    "id": "766840106",
                    "speaker": "夏沃蕾",
                    "text": "想来，招募恰斯卡小姐至特巡队，会对她的故乡纳塔造成不可估量的人才损失，不是明智之举。"
                },
                {
                    "id": "766840107",
                    "speaker": "恰斯卡",
                    "text": "特巡队那宛如钟表的稳定运转，也离不开夏沃蕾队长每天的指挥调度，少了夏沃蕾队长，枫丹也会遇上不少麻烦。"
                },
                {
                    "id": "766840108",
                    "speaker": "夏沃蕾",
                    "text": "要想达成我们的目标…"
                },
                {
                    "id": "766840109",
                    "speaker": "恰斯卡",
                    "text": "就需要前所未有的合作方式。"
                },
                {
                    "id": "766840110",
                    "speaker": "派蒙",
                    "text": "这种惊人的默契是怎么回事…",
                    "choices": [
                        {
                            "id": "766840111",
                            "text": "两位高手的思维对上了。",
                            "response": [
                                {
                                    "id": "766840113",
                                    "speaker": "恰斯卡",
                                    "text": "总之，经过和夏沃蕾队长的商讨，我们决定在三个月内，争取开始「交换代表长期进修」。"
                                },
                                {
                                    "id": "766840114",
                                    "speaker": "恰斯卡",
                                    "text": "这个方案能在最大程度减少负担的前提下，加强特巡队、「花羽会」与西风骑士团的合作。"
                                },
                                {
                                    "id": "766840115",
                                    "speaker": "派蒙",
                                    "text": "…是我理解的，字面意思上那么做吗？"
                                },
                                {
                                    "id": "766840116",
                                    "speaker": "派蒙",
                                    "text": "你们两边互相派人，「花羽会」的勇士在枫丹住一段时间，特巡队的战士就去纳塔？"
                                },
                                {
                                    "id": "766840117",
                                    "speaker": "夏沃蕾",
                                    "text": "没错，只不过实践起来，就不止是「让两边的人各自去对方的国家旅居」那么简单了。"
                                },
                                {
                                    "id": "766840118",
                                    "speaker": "恰斯卡",
                                    "text": "进修代表的人选，驻地，每天的课程，模拟训练与实际演练的计划，经费的安排…种种细节都需要系统性的规划。"
                                },
                                {
                                    "id": "766840119",
                                    "speaker": "夏沃蕾",
                                    "text": "而且要盯住弱项，对症下药，比如，纳塔勇士不太关注编制学，枫丹射手几乎没有实践经验的动对动射击…"
                                },
                                {
                                    "id": "766840120",
                                    "speaker": "夏沃蕾",
                                    "text": "那就让纳塔勇士试着以班组为单位，严格分工行动；让绒翼龙抓着特巡队射手的双肩，低空飞行，截射靶标。"
                                },
                                {
                                    "id": "766840121",
                                    "speaker": "派蒙",
                                    "text": "听起来也太严格了！",
                                    "choices": [
                                        {
                                            "id": "766840122",
                                            "text": "真能做到的话，肯定效果拔群。",
                                            "response": [
                                                {
                                                    "id": "766840124",
                                                    "speaker": "夏沃蕾",
                                                    "text": "许多计划中的课程，还要用到蒙德友军的卓越装备，西风骑士团的代表也不可或缺，所有进修所得的结果都应与他们分享。"
                                                },
                                                {
                                                    "id": "766840125",
                                                    "speaker": "赫得蔚格",
                                                    "text": "呃咳！夏沃蕾队长有心了，再次感谢贵方慷慨的报价！"
                                                },
                                                {
                                                    "id": "766840126",
                                                    "speaker": "赫得蔚格",
                                                    "text": "这次演练中，「观测榴弹」和一系列装备发挥正常，我们会按照之前的采购合同定期交付货品。"
                                                },
                                                {
                                                    "id": "766840127",
                                                    "speaker": "赫得蔚格",
                                                    "text": "派出代表进修一事，也请容我将消息传回骑士团，由长官们给出正式答复。"
                                                },
                                                {
                                                    "id": "766840128",
                                                    "speaker": "夏沃蕾",
                                                    "text": "我会给你提供正式的书面文件，等着你的好消息。"
                                                },
                                                {
                                                    "id": "766840129",
                                                    "speaker": "恰斯卡",
                                                    "text": "最后，话题该回到我们的「射击推理」了。"
                                                },
                                                {
                                                    "id": "766840130",
                                                    "speaker": "恰斯卡",
                                                    "text": "夏沃蕾队长可是对这次的结果异常满意啊。"
                                                },
                                                {
                                                    "id": "766840131",
                                                    "speaker": "夏沃蕾",
                                                    "text": "#嗯，得到了{NICKNAME}令人惊叹的对照组后，我们最后的拼图也被补全了。"
                                                },
                                                {
                                                    "id": "766840132",
                                                    "speaker": "夏沃蕾",
                                                    "text": "这次演练带来了大量弹道规划的思维样本，覆盖各种水平的射手——"
                                                },
                                                {
                                                    "id": "766840133",
                                                    "speaker": "夏沃蕾",
                                                    "text": "足以让原本的铳枪射击教材，甚至训练射手的教官手册，都进一步改良，效率成倍提升。",
                                                    "choices": [
                                                        {
                                                            "id": "766840134",
                                                            "text": "下次推演还可以叫我哦。",
                                                            "response": [
                                                                {
                                                                    "id": "766840136",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "就等你这句话呢。"
                                                                },
                                                                {
                                                                    "id": "766840137",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "到时候，肯定第一时间给你寄信！"
                                                                },
                                                                {
                                                                    "id": "766840138",
                                                                    "speaker": "夏沃蕾",
                                                                    "text": "以你目前的射击才能，下次坐到出题者的位置上来才合适。"
                                                                },
                                                                {
                                                                    "id": "766840139",
                                                                    "speaker": "派蒙",
                                                                    "text": "哈哈！能帮蒙德、枫丹和纳塔的朋友们变强，真是再好不过了！"
                                                                },
                                                                {
                                                                    "id": "766840140",
                                                                    "speaker": "派蒙",
                                                                    "text": "如果哪天听说，我们帮忙编好的书，教出了厉害的战士，砰砰几枪就击退了魔物，保护了大家…"
                                                                },
                                                                {
                                                                    "id": "766840141",
                                                                    "speaker": "派蒙",
                                                                    "text": "那种感觉，应该会和我们亲自打跑坏家伙一样，自豪又踏实！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766840135",
                                                            "text": "我乐于参加这样的演习。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766840123",
                                            "text": "专练弱项的确是最有效的方法。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766840112",
                            "text": "她们找出了彼此满意的方案。"
                        }
                    ]
                }
            ]
        }
    ]
}