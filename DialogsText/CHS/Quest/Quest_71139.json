    "talks": [
        {
            "id": "7113907",
            "objective": "（test）27接续灵渊常驻$HIDDEN",
            "dialogues": [
                {
                    "id": "711390701",
                    "speaker": "派蒙",
                    "text": "话说回来，这里就是浮锦的洞天吧？总觉得和我们见过的其他洞天不太一样，怎么说呢，好像更…有现实感？"
                },
                {
                    "id": "711390702",
                    "speaker": "派蒙",
                    "text": "既没有什么奇奇怪怪的机关，也没有什么透明的浮空桥…"
                },
                {
                    "id": "711390703",
                    "speaker": "浮锦的声音",
                    "text": "实在是对不起…之前觉得太丢人了，一直没能解释清楚。"
                },
                {
                    "id": "711390704",
                    "speaker": "浮锦的声音",
                    "text": "我没办法像南方众仙那样，创造出新的空间来。「锦落庭」不是什么「洞天」，充其量也就只是个「洞穴」而已…"
                },
                {
                    "id": "711390705",
                    "speaker": "派蒙",
                    "text": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不过，也不知道浮锦什么时候才能变回人形呢…"
                },
                {
                    "id": "711390706",
                    "speaker": "灵渊",
                    "text": "她积攒的力量已经全部逸散到了这片土地上。短时间内应该没办法再恢复人形了。"
                },
                {
                    "id": "711390707",
                    "speaker": "灵渊",
                    "text": "我耗尽力量的时候也是一样。主人死去后，从雪落到雪融，再从雪融到雪落，如此反复不知多少次，我才能再度化为人的模样。"
                },
                {
                    "id": "711390708",
                    "speaker": "派蒙",
                    "text": "原来是这样…欸？等一下，原来灵渊也能化成人形吗？！"
                },
                {
                    "id": "711390709",
                    "speaker": "浮锦的声音",
                    "text": "哼哼，那是当然！二位有所不知，想当初，在药君山的时候，灵渊的姿容可是——"
                },
                {
                    "id": "711390710",
                    "speaker": "灵渊",
                    "text": "浮锦。没必要说下去。这和现在的话题没有任何关系。"
                },
                {
                    "id": "711390711",
                    "speaker": "浮锦的声音",
                    "text": "欸？那化为人形以后，因为在庙会上吃了太多茶糕，哭着跑去求药君帮自己调配减肥茶的事情…"
                },
                {
                    "id": "711390712",
                    "speaker": "浮锦的声音",
                    "text": "或者不小心把庆典上的酒当作茶水喝了下去，拽着山间的林猪，问「药君和我谁更美」的事情，果然还是没必要说下去了吧？"
                },
                {
                    "id": "711390713",
                    "speaker": "灵渊",
                    "text": "…浮锦！"
                },
                {
                    "id": "711390714",
                    "speaker": "派蒙",
                    "text": "呜啊，你这么一说，我开始好奇灵渊化成的人形到底是什么样的了！会是像现在一样蓝蓝的吗？还是会…呃，更白一点？",
                    "choices": [
                        {
                            "id": "711390715",
                            "text": "我也很好奇！",
                            "response": [
                                {
                                    "id": "711390716",
                                    "speaker": "灵渊",
                                    "text": "我不理解你好奇的原因。你也是人。对人的形态感兴趣，看看自己就好。"
                                },
                                {
                                    "id": "711390721",
                                    "speaker": "浮锦的声音",
                                    "text": "#呵呵…总之，谢谢你们，{NICKNAME}和派蒙。我也没有想到，有朝一日，还能像这样和其他人交流…"
                                },
                                {
                                    "id": "711390722",
                                    "speaker": "浮锦的声音",
                                    "text": "咳咳——既然小仙我心情大悦，不妨就护佑二位，接下来的旅途能够一帆风顺，时通运泰…"
                                },
                                {
                                    "id": "711390723",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "711390724",
                                    "speaker": "浮锦的声音",
                                    "text": "…对不起是我得意忘形了。我刚才想要像仙人那样，说一下这句话试试看…"
                                },
                                {
                                    "id": "711390725",
                                    "speaker": "浮锦的声音",
                                    "text": "无论如何，我都会在这里祈愿，愿你们接下来的旅途一帆风顺。"
                                }
                            ]
                        },
                        {
                            "id": "711390717",
                            "text": "灵渊，可以变一下看看吗？",
                            "response": [
                                {
                                    "id": "711390718",
                                    "speaker": "灵渊",
                                    "text": "我拒绝。人类的身躯过于羸弱。没有撕碎猎物的尖牙，没有逐狩仇敌的利爪。除非浮锦命令，我不会做那种事。",
                                    "choices": [
                                        {
                                            "id": "711390726",
                                            "text": "好可惜…"
                                        },
                                        {
                                            "id": "711390727",
                                            "text": "浮锦，拜托你了！",
                                            "response": [
                                                {
                                                    "id": "711390719",
                                                    "speaker": "浮锦的声音",
                                                    "text": "…欸？这、这个，我觉得还是应该尊重灵渊的想法吧…？"
                                                },
                                                {
                                                    "id": "711390720",
                                                    "speaker": "灵渊",
                                                    "text": "我没有什么想法。你要是有想法的话，可以直接告诉我。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7113901",
            "objective": "（test）回滚随机变量$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7113902",
            "objective": "（test）灵渊小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711390201",
                    "speaker": "小茂",
                    "text": "阿蓝，阿蓝，你上次给我讲的那个故事，还没有结尾呢！"
                },
                {
                    "id": "711390202",
                    "speaker": "灵渊",
                    "text": "嗯。我记得。不过，我改变主意了。"
                },
                {
                    "id": "711390203",
                    "speaker": "小茂",
                    "text": "「改变主意」是什么意思呀？"
                },
                {
                    "id": "711390204",
                    "speaker": "灵渊",
                    "text": "这个故事的结尾，就交给你来讲吧。"
                },
                {
                    "id": "711390205",
                    "speaker": "小茂",
                    "text": "欸？！阿蓝也太耍赖啦！明明说好的，我给你讲一个故事，你给我讲一个故事，怎么现在两个故事全都变成我来讲啦！"
                },
                {
                    "id": "711390206",
                    "speaker": "灵渊",
                    "text": "我只是愚钝的野兽。想不出好的结局。"
                },
                {
                    "id": "711390207",
                    "speaker": "灵渊",
                    "text": "我想出的结局是坏结局，故事也是没有人会欢笑的坏故事。所以，你来讲故事的结局。"
                },
                {
                    "id": "711390208",
                    "speaker": "小茂",
                    "text": "可这还是在耍赖嘛！"
                },
                {
                    "id": "711390209",
                    "speaker": "灵渊",
                    "text": "我不否认。作为补偿，我可以带你去看灵濛山中隐藏的绝景。"
                },
                {
                    "id": "711390210",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711390211",
                    "speaker": "灵渊",
                    "text": "不要露出那种表情。我特别允许你…坐在我背上，五分钟左右。十分钟也可以。"
                },
                {
                    "id": "711390212",
                    "speaker": "小茂",
                    "text": "那…那就这样说好了，我想想这个故事该怎么结尾…"
                }
            ]
        },
        {
            "id": "7113903",
            "objective": "（test）灵渊$HIDDEN",
            "dialogues": [
                {
                    "id": "711390301",
                    "speaker": "派蒙",
                    "text": "欸，这不是灵渊吗？"
                },
                {
                    "id": "711390302",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711390303",
                    "speaker": "派蒙",
                    "text": "啊，对不起！难道说你是在狩猎，我们不小心打扰了你…"
                },
                {
                    "id": "711390304",
                    "speaker": "灵渊",
                    "text": "我没有在狩猎。你们也没有打扰我。"
                },
                {
                    "id": "711390305",
                    "speaker": "派蒙",
                    "text": "呃，那你这是在…发呆？比方说，在想好吃的？"
                },
                {
                    "id": "711390306",
                    "speaker": "灵渊",
                    "text": "我也没在想你的事情。我在思考。"
                },
                {
                    "id": "711390307",
                    "speaker": "派蒙",
                    "text": "思考…不对，你前半句话是什么意思啦！"
                },
                {
                    "id": "711390308",
                    "speaker": "灵渊",
                    "text": "#我在思考{NICKNAME}之前的问题。"
                },
                {
                    "id": "711390309",
                    "speaker": "灵渊",
                    "text": "「如果人类活动也是自然法则的一部分，该如何看待人类。」"
                },
                {
                    "id": "711390310",
                    "speaker": "灵渊",
                    "text": "浮锦和蛇，她们离开后，我太久没有接触过组成聚落的人类了。"
                },
                {
                    "id": "711390311",
                    "speaker": "派蒙",
                    "text": "你这话说的，小茂不也是人类嘛！"
                },
                {
                    "id": "711390312",
                    "speaker": "灵渊",
                    "text": "#小茂是属于聚落的人类，而不是组成聚落的人类。你和{NICKNAME}「组成」了旅行的同伴，而不「属于」{NICKNAME}。这就是区别。",
                    "choices": [
                        {
                            "id": "711390313",
                            "text": "你认为小茂不是社会秩序的一部分？",
                            "response": [
                                {
                                    "id": "711390314",
                                    "speaker": "灵渊",
                                    "text": "还没有完全成为这种秩序的一部分。人类的幼崽几乎都是这样，直到他们被这种秩序彻底涂抹，就像是自然那样。"
                                },
                                {
                                    "id": "711390317",
                                    "speaker": "灵渊",
                                    "text": "我太久没有接触过组成聚落的人类了。或许是出于厌恶，或许是出于恐惧，或许两者皆有。",
                                    "choices": [
                                        {
                                            "id": "711390318",
                                            "text": "因为他们侵占了属于自然的土地？",
                                            "response": [
                                                {
                                                    "id": "711390320",
                                                    "speaker": "灵渊",
                                                    "text": "我不知道。"
                                                },
                                                {
                                                    "id": "711390321",
                                                    "speaker": "灵渊",
                                                    "text": "也许不存在明显的区别，划分「我们」和「他们」，但我无法确定。"
                                                },
                                                {
                                                    "id": "711390322",
                                                    "speaker": "灵渊",
                                                    "text": "人类的幼崽会与我同行，我也有年幼的同族，出于好奇选择与人类同行。"
                                                },
                                                {
                                                    "id": "711390323",
                                                    "speaker": "派蒙",
                                                    "text": "欸？年幼的同族？"
                                                },
                                                {
                                                    "id": "711390324",
                                                    "speaker": "灵渊",
                                                    "text": "那孩子在山中遇到了烟火气的人类，"
                                                },
                                                {
                                                    "id": "711390325",
                                                    "speaker": "灵渊",
                                                    "text": "所以，我现在依然没办法回答你的问题。我需要继续观察人类。"
                                                },
                                                {
                                                    "id": "711390326",
                                                    "speaker": "灵渊",
                                                    "text": "许多事情，我不理解。我会试着理解，直到我能够按照约定，回答你的问题。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711390319",
                                            "text": "因为浮锦为了他们选择牺牲自己？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711390315",
                            "text": "这可不好说…",
                            "response": [
                                {
                                    "id": "711390316",
                                    "speaker": "派蒙",
                                    "text": "喂！不要说这么奇怪的话啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7113904",
            "objective": "（test）大山小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711390401",
                    "speaker": "小茂",
                    "text": "听大山这么讲，我感觉枫丹的「歌剧」和我们这边的戏好像也差不多呢！"
                },
                {
                    "id": "711390402",
                    "speaker": "小茂",
                    "text": "骑士呀，巫师呀，勇士呀，恶龙呀，你杀我，我杀你的，最后大家都死了！"
                },
                {
                    "id": "711390403",
                    "speaker": "沃特蒙泰涅",
                    "text": "重要的不是结局啦，而是过程，过程！不是所有悲剧都能当武打戏那么看的！"
                },
                {
                    "id": "711390404",
                    "speaker": "小茂",
                    "text": "还有还有，大山刚才说的「累牡蛎牙魔像」，听上去好像很有趣！不知道和阿蓝比起来哪个更大呢？"
                },
                {
                    "id": "711390405",
                    "speaker": "沃特蒙泰涅",
                    "text": "欸？阿兰？"
                },
                {
                    "id": "711390406",
                    "speaker": "小茂",
                    "text": "对喔，我好像还没给大山讲过阿蓝的事情…这样吧，你再给我讲一讲「累牡蛎牙」的魔像，我就给你讲阿蓝的故事好啦！"
                }
            ]
        },
        {
            "id": "7113905",
            "objective": "（test）浮锦灵渊$HIDDEN",
            "dialogues": [
                {
                    "id": "711390501",
                    "speaker": "派蒙",
                    "text": "哇啊！不知不觉间，我们已经收集到这么多仙力啦！",
                    "choices": [
                        {
                            "id": "711390502",
                            "text": "不愧是我！",
                            "response": [
                                {
                                    "id": "711390505",
                                    "speaker": "派蒙",
                                    "text": "按照浮锦之前的说法，这些仙力都用在「祀珑」上了。这样一来，翘英庄明年应该也会大丰收啦！"
                                },
                                {
                                    "id": "711390506",
                                    "speaker": "派蒙",
                                    "text": "到了那时候，我要让罗叔给我准备好多好多好吃的！我想想，比如说茶糕，乳鸽，红烧肉圆，蜜汁叉烧，还有还有…"
                                },
                                {
                                    "id": "711390507",
                                    "speaker": "派蒙",
                                    "text": "对对对，还有沉玉茶露！这个一定要记下来…欸？不对，什么人？"
                                },
                                {
                                    "id": "711390508",
                                    "speaker": "派蒙",
                                    "text": "浮、浮锦？！"
                                },
                                {
                                    "id": "711390509",
                                    "speaker": "浮锦",
                                    "text": "呵呵，抱歉，吓到你们了吗？"
                                },
                                {
                                    "id": "711390510",
                                    "speaker": "派蒙",
                                    "text": "你已经能变回人形啦！"
                                },
                                {
                                    "id": "711390511",
                                    "speaker": "浮锦",
                                    "text": "是呀。咳咳，小仙我不是说过嘛，又不是受了什么严重的伤，只要稍微休养一段时间，就能恢复我最喜欢的模样啦。"
                                },
                                {
                                    "id": "711390512",
                                    "speaker": "浮锦",
                                    "text": "#谢谢你们，在我休养的这段时间，为祀珑收集了这么多的仙力。来年的丰收，{NICKNAME}和派蒙是最大的功臣呢。",
                                    "choices": [
                                        {
                                            "id": "711390513",
                                            "text": "#哼哼，对本{M#少爷}{F#小姐}来说不过是举手之劳！",
                                            "response": [
                                                {
                                                    "id": "711390515",
                                                    "speaker": "派蒙",
                                                    "text": "说到这个，既然浮锦现在已经恢复人形了，也不用再被关在这个黑漆漆的地方了，接下来有什么想做的事情吗？"
                                                },
                                                {
                                                    "id": "711390516",
                                                    "speaker": "浮锦",
                                                    "text": "嗯…具体的我还没有想好呢。说不定会先在附近走走看吧？"
                                                },
                                                {
                                                    "id": "711390517",
                                                    "speaker": "浮锦",
                                                    "text": "品一品现在的茶，听一听现在的戏，见一见现在的人…呵呵，抱歉，总是强调「现在」，感觉像是什么讨人厌的老古董一样呢。"
                                                },
                                                {
                                                    "id": "711390518",
                                                    "speaker": "浮锦",
                                                    "text": "不过，我真的很喜欢「现在」这个词。过去没办法做到的事情，「现在」也能做得到了。过去没办法实现的、好多好多的约定，「现在」也能实现了。"
                                                },
                                                {
                                                    "id": "711390519",
                                                    "speaker": "浮锦",
                                                    "text": "之后，我想要到归离集去看一看，到璃月港去看一看，去见见她们所说的可爱的人们，也想要见见药君…"
                                                },
                                                {
                                                    "id": "711390520",
                                                    "speaker": "Player",
                                                    "text": "需要我带你去吗？"
                                                },
                                                {
                                                    "id": "711390521",
                                                    "speaker": "派蒙",
                                                    "text": "是呀，我记得浮锦好像说过，「没办法离开清水太长时间」、「需要依靠仙家的茶壶才能去很远的地方」什么的…"
                                                },
                                                {
                                                    "id": "711390522",
                                                    "speaker": "浮锦",
                                                    "text": "呵呵…谢谢你还记得这件事，也谢谢你愿意帮我。不过，我还是希望先在沉玉谷停留一段时间，好好欣赏一下家中的风景。"
                                                },
                                                {
                                                    "id": "711390523",
                                                    "speaker": "浮锦",
                                                    "text": "至于远游，我想想…嗯，要不然等小茂长大吧？"
                                                },
                                                {
                                                    "id": "711390524",
                                                    "speaker": "派蒙",
                                                    "text": "这也太久了！"
                                                },
                                                {
                                                    "id": "711390525",
                                                    "speaker": "浮锦",
                                                    "text": "开玩笑的啦！总之，我还是打算先在这边停留一段时间，也顺便试试看能不能劝灵渊和我一同出游。"
                                                },
                                                {
                                                    "id": "711390526",
                                                    "speaker": "浮锦",
                                                    "text": "#对了，{NICKNAME}！在你走之前，还有一件事…"
                                                },
                                                {
                                                    "id": "711390527",
                                                    "speaker": "浮锦",
                                                    "text": "无论是灵渊还是我，都给你们添了太多太多的麻烦。我的仙力也稍稍恢复一些了，还请让我为你们献上真正的祝福，护佑你们接下来的旅途吧。"
                                                },
                                                {
                                                    "id": "711390528",
                                                    "speaker": "浮锦",
                                                    "text": "呵呵，好了！这样一来，应该就没问题啦！",
                                                    "choices": [
                                                        {
                                                            "id": "711390529",
                                                            "text": "谢谢。",
                                                            "response": [
                                                                {
                                                                    "id": "711390532",
                                                                    "speaker": "浮锦",
                                                                    "text": "#那么，再一次…谢谢你们，{NICKNAME}和派蒙，谢谢你们为我，为沉玉谷做的一切。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711390530",
                                                            "text": "总觉得好像没什么变化…",
                                                            "response": [
                                                                {
                                                                    "id": "711390531",
                                                                    "speaker": "浮锦",
                                                                    "text": "毕竟「福运」也不是一下子就能看出来的呢。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711390514",
                                            "text": "能帮上忙就好。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711390503",
                            "text": "#不愧是本{M#少爷}{F#小姐}！",
                            "response": [
                                {
                                    "id": "711390504",
                                    "speaker": "派蒙",
                                    "text": "喂！都过去那么久了，就别再用那种奇怪的说话方式啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7113906",
            "objective": "（test）浮锦小茂$HIDDEN",
            "dialogues": [
                {
                    "id": "711390601",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711390602",
                    "speaker": "浮锦",
                    "text": "怎么了，灵渊？一直盯着我看，我身上有什么奇怪的东西吗？"
                },
                {
                    "id": "711390603",
                    "speaker": "灵渊",
                    "text": "我只是在想…不，没什么。"
                },
                {
                    "id": "711390604",
                    "speaker": "灵渊",
                    "text": "就算你和蛇一起要求，我也不会再化成人形了。"
                },
                {
                    "id": "711390605",
                    "speaker": "浮锦",
                    "text": "呵呵，我也没要求过你呀？"
                },
                {
                    "id": "711390606",
                    "speaker": "灵渊",
                    "text": "…算了。走吧。你不是还要去看现在的茶园吗。"
                }
            ]
        },
        {
            "id": "7113908",
            "objective": "（test）6.3海灯节诶浮锦灵渊$HIDDEN",
            "dialogues": [
                {
                    "id": "711390801",
                    "speaker": "小茂",
                    "text": "浮锦姐姐！祝贺你重新变回来！"
                },
                {
                    "id": "711390802",
                    "speaker": "小茂",
                    "text": "我已经听阿蓝说过啦！虽然她一直在说「还是原来的样子更好」「不知道为什么要变回人形」什么的，但我能看出来，阿蓝也很开心！"
                },
                {
                    "id": "711390803",
                    "speaker": "小茂",
                    "text": "#浮锦姐姐好像很喜欢喝茶，所以我就去向陆爷爷学习做茶糕的方法啦。等我学会了，就做超级美味的茶糕给浮锦姐姐和{NICKNAME}{M#哥哥}{F#姐姐}吃！"
                },
                {
                    "id": "711390804",
                    "speaker": "浮锦",
                    "text": "呵呵，谢谢你，小茂。作为茶糕的交换…嗯，到时候，我就给你讲一些灵渊过去的故事好啦。"
                }
            ]
        },
        {
            "id": "7113909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711390901",
                    "speaker": "灵渊",
                    "text": "…你不去见见他们么？过去成天对我和蛇念叨你的仪式，待与你相识的使者当真回到赤望台，你却像这般躲起来了。我不理解。"
                },
                {
                    "id": "711390902",
                    "speaker": "浮锦",
                    "text": "也、也不能说是躲起来啦…我与那位来自高天的使者原本便并非熟识，即便感念她昔日的恩德，如今再见也没什么话好说…"
                },
                {
                    "id": "711390903",
                    "speaker": "浮锦",
                    "text": "更何况，你看，我只是普通的鱼而已，不会说什么话的。咕嘟咕嘟…"
                },
                {
                    "id": "711390904",
                    "speaker": "灵渊",
                    "text": "……"
                },
                {
                    "id": "711390905",
                    "speaker": "灵渊",
                    "text": "你只是害怕见她，浮锦，害怕她问我们主君的事。但我不知道你为什么要怕。实话实说就好。而且还有我在。"
                },
                {
                    "id": "711390906",
                    "speaker": "浮锦",
                    "text": "…不是那个问题啦！唉，真是的，总之…还是先让我好好做一下心理准备吧…"
                }
            ]
        }
    ]
}