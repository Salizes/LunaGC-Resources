    "talks": [
        {
            "id": "7055901",
            "objective": "与特雷斯对话",
            "dialogues": [
                {
                    "id": "705590101",
                    "speaker": "派蒙",
                    "text": "大家好呀！看起来，你们的精神都不错呢！"
                },
                {
                    "id": "705590102",
                    "speaker": "特雷斯",
                    "text": "多谢关心，这几天收获很大，还要多多感谢米卡教官、埃洛雯，还有荣誉骑士和派蒙…"
                },
                {
                    "id": "705590103",
                    "speaker": "埃洛雯",
                    "text": "唔，好像有点在发表什么获奖感言？不过好像也可以这么说，毕竟特雷斯的成果可算是大获成功！"
                },
                {
                    "id": "705590104",
                    "speaker": "米卡",
                    "text": "没错…从骑士团任务的角度考虑，特雷斯目前的测绘技巧，已经足以应对九成以上的情景了。"
                },
                {
                    "id": "705590105",
                    "speaker": "米卡",
                    "text": "当然，要不是荣誉骑士前辈挑战「测绘寻物」的思路带给了我们启发，这次的训练可能还需要三倍的时间…"
                },
                {
                    "id": "705590106",
                    "speaker": "派蒙",
                    "text": "#说明我们配合得好，有默契，对不对？{NICKNAME}觉得呢？",
                    "choices": [
                        {
                            "id": "705590107",
                            "text": "本次体验相当新奇。",
                            "response": [
                                {
                                    "id": "705590109",
                                    "speaker": "特雷斯",
                                    "text": "真、真的吗？荣誉骑士前辈这么说了之后，不知道为什么，好像紧张都消散一些了…"
                                },
                                {
                                    "id": "705590110",
                                    "speaker": "特雷斯",
                                    "text": "我总是担心如果我做不好，就会出现像米卡教官说那种情况——「结果往往影响的不仅仅是你自己」…"
                                },
                                {
                                    "id": "705590111",
                                    "speaker": "埃洛雯",
                                    "text": "可恶！但你已经获得了荣誉骑士的认可…如果我能等到这一句…"
                                },
                                {
                                    "id": "705590112",
                                    "speaker": "Player",
                                    "text": "埃洛雯也很棒！"
                                },
                                {
                                    "id": "705590113",
                                    "speaker": "埃洛雯",
                                    "text": "欸…欸？！真的吗？我吗？我、我会好好记住的！"
                                },
                                {
                                    "id": "705590114",
                                    "speaker": "埃洛雯",
                                    "text": "…让我好好想想，要用什么方式来庆祝这一天呢…"
                                },
                                {
                                    "id": "705590115",
                                    "speaker": "特雷斯",
                                    "text": "说到庆祝。我倒是有个想法…有什么比一顿热气腾腾的美食更适合庆祝呢？听说埃洛雯的手艺…"
                                },
                                {
                                    "id": "705590116",
                                    "speaker": "埃洛雯",
                                    "text": "嗯？想尝尝我的手艺吗…之前我只在行军路上做过饭，因为我总是倒霉抽到坏签…当然，如果你们不嫌难吃的话…"
                                },
                                {
                                    "id": "705590117",
                                    "speaker": "特雷斯",
                                    "text": "怎么会？埃洛雯的手艺在骑士团里也算是远近闻名了吧。"
                                },
                                {
                                    "id": "705590118",
                                    "speaker": "米卡",
                                    "text": "确实…目前还没有听到过一句差评呢…"
                                },
                                {
                                    "id": "705590119",
                                    "speaker": "派蒙",
                                    "text": "呜哇！那我更好奇了！埃洛雯，让我们尝尝你的手艺嘛！"
                                },
                                {
                                    "id": "705590120",
                                    "speaker": "埃洛雯",
                                    "text": "既然大家都这么说了，那就没问题！我想，我只需要一些准备…"
                                },
                                {
                                    "id": "705590121",
                                    "speaker": "Black Screen",
                                    "text": "众人一起预处理食材、搭建临时灶台后，埃洛雯烹饪了许多看起来平平无奇，但香气却很诱人的美食…"
                                },
                                {
                                    "id": "705590122",
                                    "speaker": "Black Screen",
                                    "text": "大家像野餐那样，围成一圈坐下，享用了这顿独特的饭菜…"
                                }
                            ]
                        },
                        {
                            "id": "705590108",
                            "text": "寻物挑战也给了我灵感。"
                        }
                    ]
                }
            ]
        }
    ]
}