            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 54,
        "total_speaker_counts": {
            "Player": 12,
            "柴染": 32,
            "派蒙": 10
        }
    },
    "talks": [
        {
            "id": "7268701",
            "objective": "与柴染对话",
            "dialogues": [
                {
                    "id": "726870101",
                    "speaker": "柴染",
                    "text": "你们好，有缘人。"
                },
                {
                    "id": "726870102",
                    "speaker": "柴染",
                    "text": "两位举手投足间散发着一股馨香，必定经受过风雅之物的熏陶…"
                },
                {
                    "id": "726870103",
                    "speaker": "派蒙",
                    "text": "#咦，我们身上香香的？让我闻闻你，{NICKNAME}。"
                },
                {
                    "id": "726870104",
                    "speaker": "派蒙",
                    "text": "真的诶，你身上有股松茸酿肉卷的香味！这个姐姐看人真准！",
                    "choices": [
                        {
                            "id": "726870105",
                            "text": "她说的应该不是这种香味…",
                            "response": [
                                {
                                    "id": "726870107",
                                    "speaker": "派蒙",
                                    "text": "也对哦，这种熟悉的展开…我明白了！这位姐姐果然也需要我们帮忙吗？"
                                },
                                {
                                    "id": "726870108",
                                    "speaker": "柴染",
                                    "text": "两位是尽职尽责的向导，的确能为我招徕更多客人，但我希望你们也能以客人的身份享受这场祭典。"
                                },
                                {
                                    "id": "726870109",
                                    "speaker": "柴染",
                                    "text": "如果两位有空，要来试试看吗？构筑专属你们的「花影瑶庭」。"
                                },
                                {
                                    "id": "726870110",
                                    "speaker": "派蒙",
                                    "text": "「花影瑶庭」是什么啊？"
                                },
                                {
                                    "id": "726870111",
                                    "speaker": "Player",
                                    "text": "我也想了解一下。"
                                },
                                {
                                    "id": "726870112",
                                    "speaker": "柴染",
                                    "text": "如你所见，我是一名花匠。我身边这些花架上陈列着的，是以「插花」之道所构筑的「花庭」。"
                                },
                                {
                                    "id": "726870113",
                                    "speaker": "柴染",
                                    "text": "将精心修剪的花卉置入花器，辅以各色饰物，构建桌上庭院般的景致。这便是「花影瑶庭」，花艺的结晶。"
                                },
                                {
                                    "id": "726870114",
                                    "speaker": "柴染",
                                    "text": "在社奉行的支持下，我携多座「花影瑶庭」参与容彩祭，希望能让客人们领略到花艺的美好。"
                                },
                                {
                                    "id": "726870115",
                                    "speaker": "柴染",
                                    "text": "要是对「花影瑶庭」感兴趣，现在就可以来体验一番。"
                                },
                                {
                                    "id": "726870116",
                                    "speaker": "派蒙",
                                    "text": "确实…这些花艺作品都好漂亮，听起来也好高雅啊。不过，总觉得这种事情好难好难…我们能做到吗？",
                                    "choices": [
                                        {
                                            "id": "726870117",
                                            "text": "派蒙有点手笨。",
                                            "response": [
                                                {
                                                    "id": "726870119",
                                                    "speaker": "柴染",
                                                    "text": "请别担心。"
                                                },
                                                {
                                                    "id": "726870120",
                                                    "speaker": "柴染",
                                                    "text": "为了让客人们充分体验花艺的魅力，我预先制作了许多部件，适当简化了「花影瑶庭」的制作步骤。"
                                                },
                                                {
                                                    "id": "726870121",
                                                    "speaker": "柴染",
                                                    "text": "只需要选择「主花」「花景」和「茵席」，将它们适当组合，就能完成「花影瑶庭」。"
                                                },
                                                {
                                                    "id": "726870122",
                                                    "speaker": "柴染",
                                                    "text": "当然，重要的是品味花艺的「表达」，因此，我会为你们提出四道「花题」，考验你们的构图思维。"
                                                },
                                                {
                                                    "id": "726870123",
                                                    "speaker": "柴染",
                                                    "text": "完成每天的「花题」后，就能将相应的「花庭」和花材带走留念，还可以获得额外的奖品。"
                                                },
                                                {
                                                    "id": "726870124",
                                                    "speaker": "派蒙",
                                                    "text": "真的吗！还有这种好事！"
                                                },
                                                {
                                                    "id": "726870125",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，这位姐姐这么尽心尽力地推崇花艺，我们就帮帮她吧！",
                                                    "choices": [
                                                        {
                                                            "id": "726870126",
                                                            "text": "为了优美的花艺…",
                                                            "response": [
                                                                {
                                                                    "id": "726870128",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们现在就要试试…什么来着？对！制作我们的「花影瑶庭」！"
                                                                },
                                                                {
                                                                    "id": "726870129",
                                                                    "speaker": "柴染",
                                                                    "text": "两位愿意对花艺投入心意和热情，实在感激不尽…"
                                                                },
                                                                {
                                                                    "id": "726870130",
                                                                    "speaker": "柴染",
                                                                    "text": "那我们现在就开始吧。今日的「花题」是「紫樱扶疏，澄砂薄香」。"
                                                                },
                                                                {
                                                                    "id": "726870131",
                                                                    "speaker": "柴染",
                                                                    "text": "请两位领会题中的深意，专注于花材与花器，开始构筑你们的「花影瑶庭」吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726870127",
                                                            "text": "为了额外的奖品…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726870118",
                                            "text": "派蒙习惯大开大合。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726870106",
                            "text": "重点错了啦，派蒙…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268702",
            "objective": "完成花题",
            "dialogues": [
                {
                    "id": "726870201",
                    "speaker": "柴染",
                    "text": "接下来的几天，我会一直守候在这里，引导容彩祭的客人们，让他们感受「花影瑶庭」的精妙之处。"
                },
                {
                    "id": "726870202",
                    "speaker": "柴染",
                    "text": "两位也别忘了每天揭晓一道的「花题」哦，一共有四道「花题」等着你们作答呢。"
                },
                {
                    "id": "726870203",
                    "speaker": "柴染",
                    "text": "当然，要是两位还有其他问题，我也会尽力为你们解答的。",
                    "choices": [
                        {
                            "id": "726870204",
                            "text": "关于这里的花卉…",
                            "response": [
                                {
                                    "id": "726870205",
                                    "speaker": "柴染",
                                    "text": "我所使用的花材，都是由「咲耶花屋」提供的。「咲耶花屋」栽培的花卉有着难以挑剔的品质和亲民的价格。"
                                },
                                {
                                    "id": "726870206",
                                    "speaker": "柴染",
                                    "text": "也许你们已经见过咲耶了，我们曾在同一位老师门下学习「插花」的技巧。"
                                },
                                {
                                    "id": "726870207",
                                    "speaker": "柴染",
                                    "text": "咲耶对于花艺的理解也可圈可点，但是听说容彩祭的客人络绎不绝时，她似乎有些怯场，认为在这种环境里难以静下心来插花。"
                                },
                                {
                                    "id": "726870208",
                                    "speaker": "柴染",
                                    "text": "所以，我也会向其他客人宣传她的「咲耶花屋」。"
                                },
                                {
                                    "id": "726870209",
                                    "speaker": "派蒙",
                                    "text": "有机会的话，我们也可以帮忙哦！"
                                },
                                {
                                    "id": "726870219",
                                    "speaker": "柴染",
                                    "text": "那么，还有什么问题吗，两位？"
                                },
                                {
                                    "id": "726870220",
                                    "speaker": "Player",
                                    "text": "谢谢你，柴染小姐。"
                                },
                                {
                                    "id": "726870221",
                                    "speaker": "柴染",
                                    "text": "不用客气。如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        },
                        {
                            "id": "726870210",
                            "text": "关于社奉行…",
                            "response": [
                                {
                                    "id": "726870211",
                                    "speaker": "柴染",
                                    "text": "社奉行一直支持着稻妻的花艺事业。准确来说，为这次活动出资的贵人，是那位白鹭公主。"
                                },
                                {
                                    "id": "726870212",
                                    "speaker": "柴染",
                                    "text": "白鹭公主自小就表现出惊人的花艺天赋。我曾看过她的「插花」表演，有幸与她交流过心得。"
                                },
                                {
                                    "id": "726870213",
                                    "speaker": "柴染",
                                    "text": "虽说我比她年长，但论插花的技巧和对花艺的理解，完全没法与她相提并论呢。"
                                },
                                {
                                    "id": "726870214",
                                    "speaker": "柴染",
                                    "text": "在条件允许的情况下，白鹭公主每年都会提供资金，推广「插花」这门艺术。听说有时她还会用掉自己的积蓄…"
                                },
                                {
                                    "id": "726870215",
                                    "speaker": "柴染",
                                    "text": "白鹭公主曾坦率表达过自己的愿望——她想让更多人了解「插花」，对花艺产生兴趣，进而沉下心来修习这门学问。"
                                },
                                {
                                    "id": "726870216",
                                    "speaker": "派蒙",
                                    "text": "原来绫华为稻妻的花艺付出过这么多啊…"
                                },
                                {
                                    "id": "726870217",
                                    "speaker": "Player",
                                    "text": "希望她的愿望能实现。"
                                },
                                {
                                    "id": "726870218",
                                    "speaker": "柴染",
                                    "text": "感谢两位，你们真是善解人意。"
                                }
                            ]
                        },
                        {
                            "id": "726870222",
                            "text": "暂时没有问题了。",
                            "response": [
                                {
                                    "id": "726870223",
                                    "speaker": "柴染",
                                    "text": "如果你们有空，随时都可以来找我哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268703",
            "objective": "与柴染对话",
            "dialogues": []
        }
    ]
}