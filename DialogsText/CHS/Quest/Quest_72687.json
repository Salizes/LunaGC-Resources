{
    "quest": {
        "id": "72687",
        "title": "花影瑶庭·其一",
        "description": "容彩祭上，花匠柴染正在寻找有缘之人，体会花艺之道。",
        "rewards": [
            {
                "itemId": 104002,
                "count": 2
            },
            {
                "itemId": 104001,
                "count": 4
            }
        ],
        "rewards_formatted": "冒险家的经验 x2, 流浪者的经验 x4",
        "chapter": {
            "icon": "",
