    "talks": [
        {
            "id": "7519405",
            "objective": "(test)隐藏任务,用于接一个默认对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751940901",
                    "speaker": "库蕾玛娜",
                    "text": "这可怎么办，已经没钱雇帮工了…而且，火山那边经费也不够用了，得想个办法…"
                }
            ]
        },
        {
            "id": "7519401",
            "objective": "(test)靠近,自动触发和NPC对话$HIDDEN",
            "dialogues": [
                {
                    "id": "751940101",
                    "speaker": "库蕾玛娜",
                    "text": "等一下，等一下，这是商品，不买别碰啊！欸…你，对黄头发那位，就是你，别着急走，让我再看看你。"
                },
                {
                    "id": "751940102",
                    "speaker": "库蕾玛娜",
                    "text": "唔——果然如此，有如太阳般耀眼的头发，有如夜神之国般深邃的双目…我估计，不，我笃定，你将来会成为不得了的人物。"
                },
                {
                    "id": "751940103",
                    "speaker": "库蕾玛娜",
                    "text": "来来来，我这里有一组奇妙的玉饰，里面蕴含着各种各样不同的旋律，正巧配得上你这样的大英雄！"
                },
                {
                    "id": "751940104",
                    "speaker": "库蕾玛娜",
                    "text": "不过，这可是无价之宝。一般人来买，我起码开价一千多万摩拉。但我看你与这些玉饰有缘，就给你打个一折，如何？"
                },
                {
                    "id": "751940105",
                    "speaker": "派蒙",
                    "text": "哇，一折！那岂不是大甩卖嘛！等等…那不还要一百多万摩拉嘛！这也太贵了吧！"
                },
                {
                    "id": "751940106",
                    "speaker": "库蕾玛娜",
                    "text": "哎呀，没办法。这已经是成本价了，毕竟我们这种小商小贩也不容易嘛…",
                    "choices": [
                        {
                            "id": "751940107",
                            "text": "经费可不应该这么挣哦。",
                            "response": [
                                {
                                    "id": "751940109",
                                    "speaker": "库蕾玛娜",
                                    "text": "原来您都听到了啊。啊哈哈，你看我这喜欢自言自语的毛病啊…"
                                },
                                {
                                    "id": "751940110",
                                    "speaker": "库蕾玛娜",
                                    "text": "唉——既然都被发现了，我就实话实说了。这玉帛是我捡来的，也确实不值这个价格。"
                                },
                                {
                                    "id": "751940111",
                                    "speaker": "库蕾玛娜",
                                    "text": "但我也没办法，如您所听到的，我们很缺经费，缺到连雇佣人回收水上浮标数据的辛苦费都凑不出来。"
                                },
                                {
                                    "id": "751940112",
                                    "speaker": "派蒙",
                                    "text": "那就不回收了嘛，总比骗人好吧！"
                                },
                                {
                                    "id": "751940113",
                                    "speaker": "库蕾玛娜",
                                    "text": "不行啊…对于别的组织来说，缺经费无非就是不活动了，但我们的组织还肩负着观察火山的志愿任务。"
                                },
                                {
                                    "id": "751940114",
                                    "speaker": "库蕾玛娜",
                                    "text": "我们投放浮标也是为了通过收集水温等数据，来检测火山的活动情况。"
                                },
                                {
                                    "id": "751940115",
                                    "speaker": "库蕾玛娜",
                                    "text": "眼下火山的活动越来越活跃，浮标的回收也必须加紧，不然可能会出大问题。"
                                },
                                {
                                    "id": "751940116",
                                    "speaker": "库蕾玛娜",
                                    "text": "要不是我受过伤，根本破坏不了浮标，更不要提回收里面的数据…"
                                },
                                {
                                    "id": "751940117",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你说我们要不帮帮她吧？毕竟火山的事情，跟大家的安危有关，我们总不能视而不见吧…"
                                },
                                {
                                    "id": "751940118",
                                    "speaker": "库蕾玛娜",
                                    "text": "真、真的？如果你们愿意帮我的话，这些玉帛我就免费送你们了！就当成你们的报酬，如何？",
                                    "choices": [
                                        {
                                            "id": "751940119",
                                            "text": "不是说有一百万吗…",
                                            "response": [
                                                {
                                                    "id": "751940121",
                                                    "speaker": "库蕾玛娜",
                                                    "text": "你放心，虽然没有特别多，但除了玉帛之外，一定还会有额外的报酬的。"
                                                },
                                                {
                                                    "id": "751940122",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，只要玉帛也足够啦！毕竟这次是为了在火山旁边的大家嘛！总而言之，你就放心交给我们吧。",
                                                    "choices": [
                                                        {
                                                            "id": "751940123",
                                                            "text": "现在就开始吧。"
                                                        },
                                                        {
                                                            "id": "751940124",
                                                            "text": "需要准备一下。",
                                                            "response": [
                                                                {
                                                                    "id": "751940125",
                                                                    "speaker": "库蕾玛娜",
                                                                    "text": "嗯嗯，我这边随时都可以开始。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751940120",
                                            "text": "啊…原来只有玉帛呀？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751940108",
                            "text": "什么帮工值一百万摩拉啊？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7519403",
            "objective": "(test)挑战期间$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7519404",
            "objective": "(test)挑战胜利表演$HIDDEN",
            "dialogues": [
                {
                    "id": "751940401",
                    "speaker": "库蕾玛娜",
                    "text": "呼…太好了，从结果上来看，火山的情况并没有预想中的那么糟，这下大家能睡个好觉了…"
                },
                {
                    "id": "751940402",
                    "speaker": "库蕾玛娜",
                    "text": "这还得多谢你们，要不是你们不计前嫌出手相助，想来这件事也不会这么顺利。"
                },
                {
                    "id": "751940403",
                    "speaker": "库蕾玛娜",
                    "text": "请你们务必收下这份报酬，这算是我个人的赔罪和感谢！"
                },
                {
                    "id": "751940404",
                    "speaker": "派蒙",
                    "text": "嘿嘿，既然你这么说，那我们就恭敬不如从命啦！"
                },
                {
                    "id": "751940405",
                    "speaker": "Player",
                    "text": "你接下来准备怎么办…"
                },
                {
                    "id": "751940406",
                    "speaker": "库蕾玛娜",
                    "text": "我手里还有一些积压的货物，只要运作一番经费自然就有啦。"
                },
                {
                    "id": "751940407",
                    "speaker": "库蕾玛娜",
                    "text": "哈哈，当然啦，这次没有什么紧急情况，所以会诚信经商的，你们放心好啦。"
                }
            ]
        },
        {
            "id": "7519405",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751940501",
                    "speaker": "库蕾玛娜",
                    "text": "一十、二十…卖了这么多钱，最近的经费应该是足够了…",
                    "choices": [
                        {
                            "id": "751940502",
                            "text": "不再多挣点了？",
                            "response": [
                                {
                                    "id": "751940503",
                                    "speaker": "库蕾玛娜",
                                    "text": "哈哈，不挣啦，见好就收！要不是你不计较我的小心思，帮了我一把，我恐怕早就因为那几块玉惹上大麻烦啦。"
                                },
                                {
                                    "id": "751940504",
                                    "speaker": "库蕾玛娜",
                                    "text": "再说了，每天只盯着钱很没意思的，对我而言挣钱只是爱好，观察火山才是生活。"
                                },
                                {
                                    "id": "751940505",
                                    "speaker": "库蕾玛娜",
                                    "text": "钱没了可以再挣，可万一因为我们这帮人的疏忽，导致对火山喷发没有预警，那可就得不偿失了…"
                                },
                                {
                                    "id": "751940506",
                                    "speaker": "Player",
                                    "text": "「话事处」不给你们经费吗？"
                                },
                                {
                                    "id": "751940507",
                                    "speaker": "库蕾玛娜",
                                    "text": "我们没去申请。毕竟，平时的各种事务已经足够让「话事处」和首领们焦头烂额了，怎么能这个时候再去给他们增添负担呢？"
                                },
                                {
                                    "id": "751940508",
                                    "speaker": "库蕾玛娜",
                                    "text": "而我和我的旅伴就不一样了。平时，我们这群人也是一边各处旅行一边赚旅费的，早就习惯了这种生活了。"
                                },
                                {
                                    "id": "751940509",
                                    "speaker": "库蕾玛娜",
                                    "text": "在旅行中顺便观察一下火山也不是什么难事，就像你们经常顺手帮助一些有困难的人一样，轻轻松松啦！"
                                }
                            ]
                        },
                        {
                            "id": "751940510",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "751940511",
                                    "speaker": "库蕾玛娜",
                                    "text": "慢走慢走，嘿嘿，有缘再见啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7519406",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751940601",
                    "speaker": "库蕾玛娜",
                    "text": "如何，准备好了吗？"
                }
            ]
        },
        {
            "id": "7519407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751940701",
                    "speaker": "Player",
                    "text": "那就来试试吧。"
                }
            ]
        },
        {
            "id": "7519408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751940801",
                    "speaker": "Player",
                    "text": "等会再说。"
                },
                {
                    "id": "751940802",
                    "speaker": "库蕾玛娜",
                    "text": "嗯嗯，我这边随时都可以开始。"
                }
            ]
        }
    ]
}