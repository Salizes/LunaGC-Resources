        }
    },
    "talks": [
        {
            "id": "7166301",
            "objective": "前往璃月港的码头",
            "dialogues": [
                {
                    "id": "716630101",
                    "speaker": "派蒙",
                    "text": "你好。遇到什么麻烦了吗？"
                },
                {
                    "id": "716630102",
                    "speaker": "娜扎法琳",
                    "text": "噢，我的小吉祥草王啊。我确实遇到了一些棘手的问题。"
                },
                {
                    "id": "716630103",
                    "speaker": "娜扎法琳",
                    "text": "草王在上，二位大人一定是来拯救可怜的娜扎法琳的大英雄吧？"
                },
                {
                    "id": "716630104",
                    "speaker": "娜扎法琳",
                    "text": "对了，这就是所谓的那个什么来着…呃？天冷有人送被子？呃？雨、雨中送炭？"
                },
                {
                    "id": "716630105",
                    "speaker": "派蒙",
                    "text": "呃…这是什么须弥人特有的说话方式吗？",
                    "choices": [
                        {
                            "id": "716630106",
                            "text": "恐怕只是她特有的说话方式…",
                            "response": [
                                {
                                    "id": "716630108",
                                    "speaker": "派蒙",
                                    "text": "也是呢。而且是雪中送炭吧！"
                                },
                                {
                                    "id": "716630109",
                                    "speaker": "娜扎法琳",
                                    "text": "对对对，雪中送炭，这可真是雪中送炭。"
                                },
                                {
                                    "id": "716630110",
                                    "speaker": "派蒙",
                                    "text": "咳…先不管这些，总之你叫做娜扎法琳对吧？那么娜扎法琳，有什么我们可以帮忙的吗？"
                                },
                                {
                                    "id": "716630111",
                                    "speaker": "娜扎法琳",
                                    "text": "您可真是机灵，总能说到点子上！事实上，娜扎法琳我正遇到我人生中最大的困难！"
                                },
                                {
                                    "id": "716630112",
                                    "speaker": "派蒙",
                                    "text": "#叫我派蒙就好了，这是{NICKNAME}。"
                                },
                                {
                                    "id": "716630113",
                                    "speaker": "Player",
                                    "text": "#那个，我是{NICKNAME}。"
                                },
                                {
                                    "id": "716630114",
                                    "speaker": "娜扎法琳",
                                    "text": "很高兴认识二位大人！我叫娜扎法琳！"
                                },
                                {
                                    "id": "716630115",
                                    "speaker": "派蒙",
                                    "text": "你之前已经说过名字了啦…所以，你遇到了什么困难呢？"
                                },
                                {
                                    "id": "716630116",
                                    "speaker": "娜扎法琳",
                                    "text": "是这样子的，我有个志向远大的好朋友叫做芭尔瓦涅。她曾经和我说，她要制作一种让大家都变得幸福的调料。"
                                },
                                {
                                    "id": "716630117",
                                    "speaker": "派蒙",
                                    "text": "欸，能让大家都变幸福的调料？调料…怎么能让人变得幸福呀？"
                                },
                                {
                                    "id": "716630118",
                                    "speaker": "娜扎法琳",
                                    "text": "嗯…娜扎法琳也不清楚。"
                                },
                                {
                                    "id": "716630119",
                                    "speaker": "娜扎法琳",
                                    "text": "不过芭尔瓦涅说，只要加入那种调料，无论是什么菜都会变得格外美味！"
                                },
                                {
                                    "id": "716630155",
                                    "speaker": "娜扎法琳",
                                    "text": "只要人们能吃到格外美味的菜，一定就会感觉到幸福了。"
                                },
                                {
                                    "id": "716630120",
                                    "speaker": "派蒙",
                                    "text": "唔喔！很有道理！"
                                },
                                {
                                    "id": "716630121",
                                    "speaker": "Player",
                                    "text": "一下子就被说服了啊…"
                                },
                                {
                                    "id": "716630122",
                                    "speaker": "娜扎法琳",
                                    "text": "她之所以要出发去旅行，也是为了找到制作那种调料的方法…"
                                },
                                {
                                    "id": "716630123",
                                    "speaker": "娜扎法琳",
                                    "text": "不过，她边旅行边研究，就像一只忙碌的小蜜蜂。我身为她最好的朋友，却只能留在须弥帮不上什么忙…"
                                },
                                {
                                    "id": "716630124",
                                    "speaker": "娜扎法琳",
                                    "text": "多么可怜。所以我想为她做点什么，根据她之前和我聊过的思路，我想了又想。"
                                },
                                {
                                    "id": "716630156",
                                    "speaker": "娜扎法琳",
                                    "text": "一连茶不思饭不想地想了好几天，我终于知道我能做什么了！"
                                },
                                {
                                    "id": "716630125",
                                    "speaker": "派蒙",
                                    "text": "嗯？茶不思饭不想好像不是这么用的吧？"
                                },
                                {
                                    "id": "716630126",
                                    "speaker": "娜扎法琳",
                                    "text": "噢，谢谢您的提醒。璃月的熟语真的是很难运用呢，我要多多学习才是。"
                                },
                                {
                                    "id": "716630127",
                                    "speaker": "派蒙",
                                    "text": "我们回到话题上来吧，然后你想出了什么？"
                                },
                                {
                                    "id": "716630128",
                                    "speaker": "娜扎法琳",
                                    "text": "对！我想出了一个办法。"
                                },
                                {
                                    "id": "716630157",
                                    "speaker": "娜扎法琳",
                                    "text": "那就是…我也可以依照芭尔瓦涅的思路想一些调料配方，然后再把这些调料加入菜里，听听人们对于这些菜的看法。"
                                },
                                {
                                    "id": "716630129",
                                    "speaker": "娜扎法琳",
                                    "text": "就这样帮芭尔瓦涅做一些市场调研，再把搜集到的信息整理起来交给她。"
                                },
                                {
                                    "id": "716630130",
                                    "speaker": "娜扎法琳",
                                    "text": "您也是知道的，实际的调查也在研究中非常重要。这是我唯一能为我那忙碌的好朋友做的事情了。"
                                },
                                {
                                    "id": "716630131",
                                    "speaker": "娜扎法琳",
                                    "text": "虽然我想出来的这种调料配方，肯定不是她想要的那种调料…"
                                },
                                {
                                    "id": "716630132",
                                    "speaker": "娜扎法琳",
                                    "text": "但大家对于这种调料的反馈，一定能给聪明的芭尔瓦涅帮助，让她快快地做出那种很厉害的调料！"
                                },
                                {
                                    "id": "716630133",
                                    "speaker": "娜扎法琳",
                                    "text": "所以我来了七国之中，以饮食文化出名的璃月！据说这里民以食为天，一定能给我非常多的灵感。"
                                },
                                {
                                    "id": "716630134",
                                    "speaker": "派蒙",
                                    "text": "所以，其实配方你还没有想出来？要我们帮忙想配方？"
                                },
                                {
                                    "id": "716630135",
                                    "speaker": "娜扎法琳",
                                    "text": "噢不，草王在上，想配方这件事情，还是让身为须弥人的我来做吧。"
                                },
                                {
                                    "id": "716630136",
                                    "speaker": "娜扎法琳",
                                    "text": "须弥人非常擅长在料理里使用调料，您瞧，和二位大人谈话间我已经想好一个配方了。"
                                },
                                {
                                    "id": "716630137",
                                    "speaker": "娜扎法琳",
                                    "text": "所以，我要再次谢谢二位大人！二位大人真的是来拯救可怜的娜扎法琳的大英雄！"
                                },
                                {
                                    "id": "716630138",
                                    "speaker": "派蒙",
                                    "text": "呃？不客气…？"
                                },
                                {
                                    "id": "716630139",
                                    "speaker": "Player",
                                    "text": "所、所以我们到底要帮你什么…"
                                },
                                {
                                    "id": "716630140",
                                    "speaker": "娜扎法琳",
                                    "text": "事实上，嗯…虽然我想出了一些调料的配方，但是可怜的娜扎法琳在璃月一个人都不认识。"
                                },
                                {
                                    "id": "716630141",
                                    "speaker": "娜扎法琳",
                                    "text": "而且我不是专业的冒险家，收集这么多的原料对我来说，难度实在太高，不亚于手无缚鸡之力的菜鸟独闯镀金旅团的老巢了…"
                                },
                                {
                                    "id": "716630142",
                                    "speaker": "Player",
                                    "text": "镀金旅团？"
                                },
                                {
                                    "id": "716630143",
                                    "speaker": "娜扎法琳",
                                    "text": "噢，那是须弥的雇佣兵组织，只要给钱他们什么都干。有些成员甚至还能役使一些诡异的力量，非常难缠。"
                                },
                                {
                                    "id": "716630144",
                                    "speaker": "娜扎法琳",
                                    "text": "光是想想就觉得可怕，让我们回到之前的话题上来吧。"
                                },
                                {
                                    "id": "716630145",
                                    "speaker": "娜扎法琳",
                                    "text": "#现在，娜扎法琳想要拜托派蒙阁下和{NICKNAME}阁下，按照配方收集原料，再制作出调料！"
                                },
                                {
                                    "id": "716630146",
                                    "speaker": "娜扎法琳",
                                    "text": "再把调料加到料理里，请二位大人熟悉的人试吃，最后把感想记录下来给娜扎法琳。",
                                    "choices": [
                                        {
                                            "id": "716630147",
                                            "text": "原来是这样…",
                                            "response": [
                                                {
                                                    "id": "716630149",
                                                    "speaker": "派蒙",
                                                    "text": "原来如此！你早说呀。就交给我们吧，我们认识的人可多了！"
                                                },
                                                {
                                                    "id": "716630150",
                                                    "speaker": "娜扎法琳",
                                                    "text": "草王在上，感谢二位大人的热心肠！这段时间我也会陆续想点配方，等新的配方想出来之后，会直接告诉二位大人的。"
                                                },
                                                {
                                                    "id": "716630151",
                                                    "speaker": "娜扎法琳",
                                                    "text": "请收下这口锅，这是我请须弥工匠特制的，用它一定能做出让大家都幸福的调料的！"
                                                },
                                                {
                                                    "id": "716630152",
                                                    "speaker": "派蒙",
                                                    "text": "#太好了！{NICKNAME}快行动起来吧！我给你当第一位试吃员，嘿嘿！"
                                                },
                                                {
                                                    "id": "716630153",
                                                    "speaker": "Player",
                                                    "text": "怪不得你这么积极想帮忙…"
                                                },
                                                {
                                                    "id": "716630154",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿…快点快点！我们该行动啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716630148",
                                            "text": "就是找人试吃啊…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716630107",
                            "text": "以前遇到的须弥人都不是这样的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166302",
            "objective": "与看起来困扰的人对话",
            "dialogues": []
        }
    ]
}