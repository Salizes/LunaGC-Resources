    "talks": [
        {
            "id": "7470601",
            "objective": "前往水族箱附近…",
            "dialogues": [
                {
                    "id": "747060101",
                    "speaker": "哥伦比娅",
                    "text": "…这条呢？"
                },
                {
                    "id": "747060102",
                    "speaker": "芙宁娜",
                    "text": "好像还是差一点…"
                },
                {
                    "id": "747060103",
                    "speaker": "派蒙",
                    "text": "哥伦比娅，还有芙宁娜？你们在干嘛呢？"
                },
                {
                    "id": "747060104",
                    "speaker": "哥伦比娅",
                    "text": "在和芙宁娜导演一起…「选角」？"
                },
                {
                    "id": "747060105",
                    "speaker": "芙宁娜",
                    "text": "这么说倒也没错，只不过我们准备选的演员，是水族箱里的鱼。"
                },
                {
                    "id": "747060106",
                    "speaker": "派蒙",
                    "text": "鱼都能演戏了？"
                },
                {
                    "id": "747060107",
                    "speaker": "芙宁娜",
                    "text": "现在动物演员也不少见嘛。我们想选一条气质比较符合的鱼，拍摄一些映影中用来烘托氛围的空镜。"
                },
                {
                    "id": "747060108",
                    "speaker": "芙宁娜",
                    "text": "只不过看了一圈下来，还没有找到太合适的。"
                },
                {
                    "id": "747060109",
                    "speaker": "哥伦比娅",
                    "text": "#要试着拜托{NICKNAME}和派蒙吗？很多问题{M#他}{F#她}们都能解决。"
                },
                {
                    "id": "747060110",
                    "speaker": "派蒙",
                    "text": "你这么信任我们倒是很高兴啦…但这个问题上…",
                    "choices": [
                        {
                            "id": "747060111",
                            "text": "我们可以多找一些鱼？",
                            "response": [
                                {
                                    "id": "747060113",
                                    "speaker": "芙宁娜",
                                    "text": "对哦！这水族馆就是你们负责经营的。"
                                },
                                {
                                    "id": "747060114",
                                    "speaker": "派蒙",
                                    "text": "也就是说，我们以后在下水的时候多留个心就行了？好像的确不难。"
                                },
                                {
                                    "id": "747060115",
                                    "speaker": "芙宁娜",
                                    "text": "那就这么说定了！我稍后将想象中符合气质的鱼告诉你们。"
                                },
                                {
                                    "id": "747060116",
                                    "speaker": "哥伦比娅",
                                    "text": "那你们现在就是「星探」了？"
                                },
                                {
                                    "id": "747060117",
                                    "speaker": "派蒙",
                                    "text": "你跟着芙宁娜还真是学到好多新词…"
                                }
                            ]
                        },
                        {
                            "id": "747060112",
                            "text": "我们可以多下水看看？"
                        }
                    ]
                }
            ]
        }
    ]
}