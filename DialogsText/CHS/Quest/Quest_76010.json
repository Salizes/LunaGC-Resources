    "talks": [
        {
            "id": "7601001",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7601002",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760100201",
                    "speaker": "佩卡尼",
                    "text": "二十五…二十六…"
                },
                {
                    "id": "760100202",
                    "speaker": "派蒙",
                    "text": "咦，你在数什么呢？"
                },
                {
                    "id": "760100203",
                    "speaker": "佩卡尼",
                    "text": "嘘…！小声点…唉，算了，反正这次也肯定钓不上来了。"
                },
                {
                    "id": "760100204",
                    "speaker": "佩卡尼",
                    "text": "我说啊，小妹妹，这种事应该看一眼就明白了吧？当然是在给钓鱼计时，不然你以为我拿着鱼竿是在做什么，施法吗？",
                    "choices": [
                        {
                            "id": "760100205",
                            "text": "既然是霜月之子，也不是没有可能…",
                            "response": [
                                {
                                    "id": "760100206",
                                    "speaker": "佩卡尼",
                                    "text": "#唉，{M#小伙子}{F#小妹妹}属实是高看我了。我充其量也就只能算半个霜月之子，连侍祭都算不上，就是个不会用月矩力的普通人。"
                                },
                                {
                                    "id": "760100210",
                                    "speaker": "派蒙",
                                    "text": "算了，先不管那个，我还是第一次见到有人钓鱼论秒钓的…"
                                },
                                {
                                    "id": "760100211",
                                    "speaker": "佩卡尼",
                                    "text": "哎呀，重要的是钓技，不是在岸上站着的时间长短嘛。老伊尔玛里就是因为想不明白这一点，才总是钓不上来鱼。"
                                },
                                {
                                    "id": "760100212",
                                    "speaker": "佩卡尼",
                                    "text": "嗯？这么说来，你们两个应该是宝藏猎人吧？"
                                },
                                {
                                    "id": "760100213",
                                    "speaker": "派蒙",
                                    "text": "不是的，我们是冒险家…呃，所以是有什么事要让我们做吗？"
                                },
                                {
                                    "id": "760100214",
                                    "speaker": "佩卡尼",
                                    "text": "差不多，宝藏猎人也好，冒险家也好，只要是拿报酬办事的就行。要是你们有空的话，我想让你们帮我个忙。"
                                },
                                {
                                    "id": "760100215",
                                    "speaker": "佩卡尼",
                                    "text": "你看，我的钓技分明是希汐岛第一，哪怕是历代咏月使，也没人能在钓鱼领域胜过我…"
                                },
                                {
                                    "id": "760100216",
                                    "speaker": "派蒙",
                                    "text": "是、是这样吗？好厉害…咦？仔细一想好像也没什么厉害的，咏月使的本职工作又不是钓鱼！"
                                },
                                {
                                    "id": "760100217",
                                    "speaker": "佩卡尼",
                                    "text": "然而，这样厉害的我，最近却一条鱼也没钓上来！这是为什么呢？"
                                },
                                {
                                    "id": "760100218",
                                    "speaker": "佩卡尼",
                                    "text": "显而易见，问题不是出在我，而是出在环境。就像是受诅的刻拉蒂之眼那样，这里的水下也一定有什么东西在影响鱼群。"
                                },
                                {
                                    "id": "760100219",
                                    "speaker": "派蒙",
                                    "text": "好、好莫名其妙的推断…"
                                },
                                {
                                    "id": "760100220",
                                    "speaker": "佩卡尼",
                                    "text": "所以呀，拜托你们两位，帮我调查一下这附近的水域，看看到底是什么东西在阻止鱼儿上钩。放心，不会少给你们报酬的。"
                                },
                                {
                                    "id": "760100221",
                                    "speaker": "派蒙",
                                    "text": "呃，看在报酬的份上，我们就在附近看看吧…不过我们可不能保证真的能找到什么奇怪的东西哦？"
                                }
                            ]
                        },
                        {
                            "id": "760100207",
                            "text": "说不定是在寻找最好的伙伴…",
                            "response": [
                                {
                                    "id": "760100208",
                                    "speaker": "佩卡尼",
                                    "text": "？"
                                },
                                {
                                    "id": "760100209",
                                    "speaker": "派蒙",
                                    "text": "不是什么人随便一钓都能把最好的伙伴钓上来啦…不对，重点根本就不在那里吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7601003",
            "objective": "调查附近的干扰",
            "dialogues": [
                {
                    "id": "760100301",
                    "speaker": "佩卡尼",
                    "text": "拜托你们帮我调查一下这附近，看看到底是什么东西在阻止鱼儿上钩吧。"
                }
            ]
        },
        {
            "id": "7601004",
            "objective": "将碎片安放到石头上",
            "dialogues": []
        },
        {
            "id": "7601005",
            "objective": "与佩卡尼对话",
            "dialogues": []
        },
        {
            "id": "7601006",
            "objective": "与佩卡尼对话",
            "dialogues": [
                {
                    "id": "760100601",
                    "speaker": "佩卡尼",
                    "text": "喂，你们看到了吗？刚才不知道发生了什么事，我一不留神，那块大石头就突然飞走了！"
                },
                {
                    "id": "760100602",
                    "speaker": "Black Screen",
                    "text": "讲述了之前的事…"
                },
                {
                    "id": "760100603",
                    "speaker": "佩卡尼",
                    "text": "唔哦！虽然完全没听懂怎么回事，但既然能展现这般奇迹，你们一定是受到月之{RUBY#[D]库塔尔}少女宠爱的人吧！"
                },
                {
                    "id": "760100604",
                    "speaker": "佩卡尼",
                    "text": "月神大人保佑，月神大人保佑！这样一来，我就能在这里大钓特钓了！只要那个讨厌的游吟诗人不再带着他的宠物过来唱歌…"
                },
                {
                    "id": "760100605",
                    "speaker": "佩卡尼",
                    "text": "来，这是说好的报酬！虽说我最近都没钓上鱼，但其他的小玩意儿倒是钓了不少，有的应该还挺值钱的…"
                },
                {
                    "id": "760100606",
                    "speaker": "佩卡尼",
                    "text": "只是希汐岛这边也用不上什么摩拉，所以就全都送给你们吧。谢谢你们帮忙，接下来就让我一个人安心钓鱼吧！"
                }
            ]
        },
        {
            "id": "7600801",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760080114",
                    "speaker": "佩卡尼",
                    "text": "十二…十三…"
                }
            ]
        }
    ]
}