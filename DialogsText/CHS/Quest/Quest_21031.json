    "talks": [
        {
            "id": "2103101",
            "objective": "与淮安对话",
            "dialogues": [
                {
                    "id": "210310101",
                    "speaker": "淮安",
                    "text": "哎哟…还是得想个办法…"
                },
                {
                    "id": "210310102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "210310103",
                    "speaker": "淮安",
                    "text": "是您啊，唉…别提了。"
                },
                {
                    "id": "210310104",
                    "speaker": "淮安",
                    "text": "最近客栈的生意越来越好，来店里住的人也越来越多。"
                },
                {
                    "id": "210310105",
                    "speaker": "淮安",
                    "text": "有的一个人过来找清净，有的拖家带口过来旅游。"
                },
                {
                    "id": "210310106",
                    "speaker": "淮安",
                    "text": "唉，虽然客栈生意好我很高兴，但这周围有很多魔物徘徊。"
                },
                {
                    "id": "210310107",
                    "speaker": "淮安",
                    "text": "如果有哪个小朋友跑出去玩，或者是哪位老人出去散步的时候遇见那群魔物的话…"
                },
                {
                    "id": "210310108",
                    "speaker": "淮安",
                    "text": "为了防止这种事发生，我得出去驱赶一下客栈周围的魔物。"
                },
                {
                    "id": "210310109",
                    "speaker": "淮安",
                    "text": "但我一个人，也驱赶不了多少魔物…"
                },
                {
                    "id": "210310110",
                    "speaker": "淮安",
                    "text": "旅行者，你能帮我一把吗？报酬肯定不会少你的。",
                    "choices": [
                        {
                            "id": "210310111",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "210310115",
                                    "speaker": "淮安",
                                    "text": "那就拜托您了。我之前就注意到了几处魔物的营地，里面有不少危险的魔物。"
                                },
                                {
                                    "id": "210310116",
                                    "speaker": "淮安",
                                    "text": "而且，还有另外一群魔物偷偷摸到了客栈附近，还扎起了营…"
                                },
                                {
                                    "id": "210310117",
                                    "speaker": "淮安",
                                    "text": "唔…"
                                },
                                {
                                    "id": "210310118",
                                    "speaker": "淮安",
                                    "text": "这样吧，那些危险的魔物就交给我了，您帮我处理一下那些客栈周围的魔物就好。"
                                },
                                {
                                    "id": "210310119",
                                    "speaker": "淮安",
                                    "text": "把那些魔物赶走之后，我们再来客栈里碰头。"
                                },
                                {
                                    "id": "210310120",
                                    "speaker": "淮安",
                                    "text": "这些魔物，真是够烦人的…"
                                }
                            ]
                        },
                        {
                            "id": "210310112",
                            "text": "你的身手应该不错。",
                            "response": [
                                {
                                    "id": "210310113",
                                    "speaker": "淮安",
                                    "text": "我？这个…您谬赞，算是过得去吧。"
                                },
                                {
                                    "id": "210310114",
                                    "speaker": "淮安",
                                    "text": "但是就凭我一个人，也不可能把那些魔物全部都打倒…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103102",
            "objective": "前往魔物营地，并打倒所有魔物",
            "dialogues": [
                {
                    "id": "210310201",
                    "speaker": "派蒙",
                    "text": "完全没什么线索呢…到底是谁打倒的这些魔物，难道…是哪位冒险家？"
                },
                {
                    "id": "210310202",
                    "speaker": "派蒙",
                    "text": "唔…好在意啊…"
                },
                {
                    "id": "210310203",
                    "speaker": "派蒙",
                    "text": "不过，既然这些魔物已经被打倒了，现在回去告诉淮安这个消息也行。"
                }
            ]
        },
        {
            "id": "2103103",
            "objective": "在四周搜索",
            "dialogues": [
                {
                    "id": "210310301",
                    "speaker": "魈",
                    "text": "…是你啊。",
                    "choices": [
                        {
                            "id": "210310302",
                            "text": "你怎么在这？",
                            "response": [
                                {
                                    "id": "210310304",
                                    "speaker": "魈",
                                    "text": "路遇魔物，便随手处理了。"
                                },
                                {
                                    "id": "210310305",
                                    "speaker": "魈",
                                    "text": "这一带不太安宁，你…"
                                },
                                {
                                    "id": "210310306",
                                    "speaker": "Player",
                                    "text": "我会多加小心。"
                                },
                                {
                                    "id": "210310307",
                                    "speaker": "魈",
                                    "text": "好。我另有要事，先行一步。"
                                }
                            ]
                        },
                        {
                            "id": "210310303",
                            "text": "那些魔物是你…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103107",
            "objective": "与派蒙对话",
            "dialogues": []
        },
        {
            "id": "2103104",
            "objective": "前去察看情况$HIDDEN$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2103105",
            "objective": "向淮安回报",
            "dialogues": [
                {
                    "id": "210310401",
                    "speaker": "淮安",
                    "text": "你们回来了，哎哟…那些魔物真是难对付…"
                },
                {
                    "id": "210310402",
                    "speaker": "Player",
                    "text": "你把那些魔物都打倒了？"
                },
                {
                    "id": "210310403",
                    "speaker": "淮安",
                    "text": "哈哈哈，是的，颇费了一番功夫，年纪大了终归是有些力不从心啊。"
                },
                {
                    "id": "210310404",
                    "speaker": "淮安",
                    "text": "您应该也已经把那些魔物都解决掉了吧？"
                },
                {
                    "id": "210310405",
                    "speaker": "Player",
                    "text": "关于魔物营地…"
                },
                {
                    "id": "210310406",
                    "speaker": "淮安",
                    "text": "魔物全都被打倒了…但是营地里却没有人影？"
                },
                {
                    "id": "210310407",
                    "speaker": "淮安",
                    "text": "这倒是怪了，难道是哪位路过的冒险家，顺手打倒了那些魔物？"
                },
                {
                    "id": "210310408",
                    "speaker": "淮安",
                    "text": "总之，还是谢谢您帮我去周围巡查，这些报酬请您收下。"
                }
            ]
        },
        {
            "id": "2103106",
