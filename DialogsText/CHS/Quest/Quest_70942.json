            "dialogues": [
                {
                    "id": "709420101",
                    "speaker": "Player",
                    "text": "关于雪山…"
                },
                {
                    "id": "709420102",
                    "speaker": "艾斯特尔",
                    "text": "哦？你对雪山感兴趣吗？那你说不定有成为地理学家的潜力。"
                },
                {
                    "id": "709420103",
                    "speaker": "艾斯特尔",
                    "text": "我成为学者的契机就是好奇清泉镇泉水的源头来自哪里，结果调查之后发现居然是这座雪山的融雪。"
                },
                {
                    "id": "709420104",
                    "speaker": "艾斯特尔",
                    "text": "为了能深入研究雪山的环境，我还专门准备了一些耐寒的药剂，结果没想到这里的寒冷程度甚至连药剂都失去了作用…"
                },
                {
                    "id": "709420105",
                    "speaker": "艾斯特尔",
                    "text": "留在我这里也没什么用，不如你拿走吧。虽然不足以抵抗雪山的寒冷，但说不定能对你以后的冒险有帮助。"
                }
            ]
        }
    ]
