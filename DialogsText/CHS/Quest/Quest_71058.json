    "talks": [
        {
            "id": "7105801",
            "objective": "击败雷莹术士$HIDDEN",
            "dialogues": [
                {
                    "id": "710580101",
                    "speaker": "？？？",
                    "text": "咳咳…呼…等等，请先停手…！你是谁？为什么会在这里…？"
                },
                {
                    "id": "710580102",
                    "speaker": "？？？",
                    "text": "以及…为什么要攻击我？"
                },
                {
                    "id": "710580103",
                    "speaker": "派蒙",
                    "text": "我们还想问你咧！谁让你在这里鬼鬼祟祟的！"
                },
                {
                    "id": "710580104",
                    "speaker": "Player",
                    "text": "你是坏人，你先说。"
                },
                {
                    "id": "710580105",
                    "speaker": "？？？",
                    "text": "…卡塔琳娜，卡塔琳娜·雪奈茨芙娜。"
                },
                {
                    "id": "710580106",
                    "speaker": "卡塔琳娜",
                    "text": "名字是我们最不值得保守的情报，我只能透露这些，抱歉啦。"
                },
                {
                    "id": "710580107",
                    "speaker": "派蒙",
                    "text": "唔…我们只是想问问情况而已，又没想拷问你啦！"
                },
                {
                    "id": "710580108",
                    "speaker": "卡塔琳娜",
                    "text": "抱歉、抱歉，这是我能透露的全部情报了。"
                },
                {
                    "id": "710580109",
                    "speaker": "Player",
                    "text": "为什么愚人众会在这里活动？"
                },
                {
                    "id": "710580110",
                    "speaker": "卡塔琳娜",
                    "text": "机密。"
                },
                {
                    "id": "710580111",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "710580112",
                    "speaker": "派蒙",
                    "text": "什么啦！你们这些神神秘秘的坏家伙！"
                },
                {
                    "id": "710580113",
                    "speaker": "卡塔琳娜",
                    "text": "呵呵，对呀，我们就是这种坏家伙哦。"
                },
                {
                    "id": "710580114",
                    "speaker": "卡塔琳娜",
                    "text": "好了，好奇宝宝时间结束…我们有麻烦了。"
                }
            ]
        },
        {
            "id": "7105802",
            "objective": "被击败的愚人众术士似乎有话要说",
            "dialogues": []
        },
        {
            "id": "7105803",
            "objective": "击败出现的蕈兽",
            "dialogues": []
        },
        {
            "id": "7105804",
            "objective": "与愚人众术士继续被打断的对话",
            "dialogues": [
                {
                    "id": "710580201",
                    "speaker": "卡塔琳娜",
                    "text": "谢谢…不论如何，我很开心你没有趁机在我背后捅刀。",
                    "choices": [
                        {
                            "id": "710580202",
                            "text": "这是我要说的话才对。",
                            "response": [
                                {
                                    "id": "710580204",
                                    "speaker": "卡塔琳娜",
                                    "text": "噗…虽然不知道你对愚人众有何成见，但在这种地方搭话可一点也不浪漫…有什么话就请来我的藏身点一叙吧。"
                                },
                                {
                                    "id": "710580207",
                                    "speaker": "Black Screen",
                                    "text": "卡塔琳娜离开了。"
                                },
                                {
                                    "id": "710580205",
                                    "speaker": "派蒙",
                                    "text": "欸？她可是愚人众呀，我们就这样把她放走了吗？不把她交给千岩军吗？"
                                },
                                {
                                    "id": "710580206",
                                    "speaker": "派蒙",
                                    "text": "哼…我知道啦，算啦，反正她也没有伤到我们，就当是饶她一命好啦！"
                                }
                            ]
                        },
                        {
                            "id": "710580203",
                            "text": "愚人众对别人都是如此疑心病吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105805",
            "objective": "前往愚人众术士藏身的营地",
            "dialogues": [
                {
                    "id": "710580501",
                    "speaker": "卡塔琳娜",
                    "text": "你们两个果然来了，请找个地方休息一下吧。"
                },
                {
                    "id": "710580502",
                    "speaker": "卡塔琳娜",
                    "text": "我这里还有些嗯…红茶，没有了…砂糖，也没了…嗯，牛奶，呕——酸掉了，我稍后丢掉好了…真是不好意思。"
                },
                {
                    "id": "710580503",
                    "speaker": "卡塔琳娜",
                    "text": "不过火水还多得是…也有硬饼干做茶点，还有点酸果酱…嗯，足够开个茶会了。"
                },
                {
                    "id": "710580504",
                    "speaker": "派蒙",
                    "text": "哇啊…！你们都用火水开茶会吗？"
                },
                {
                    "id": "710580505",
                    "speaker": "卡塔琳娜",
                    "text": "对啊，很奇怪吗？",
                    "choices": [
                        {
                            "id": "710580506",
                            "text": "唔…还是不了。",
                            "response": [
                                {
                                    "id": "710580507",
                                    "speaker": "卡塔琳娜",
                                    "text": "怎么？嘿嘿，在这里是没有人管你喝酒的。不要拘谨啦！",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "你这是在做什么？",
                                            "response": [
                                                {
                                                    "id": "710580512",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "「恰到好处地分享食物和情报，可以堵住询问者的嘴。」"
                                                },
                                                {
                                                    "id": "710580513",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "…我们的手册是这么说的。"
                                                },
                                                {
                                                    "id": "710580514",
                                                    "speaker": "Player",
                                                    "text": "可是情报呢？"
                                                },
                                                {
                                                    "id": "710580515",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "嗯？刚刚那就是呀。"
                                                },
                                                {
                                                    "id": "710580516",
                                                    "speaker": "派蒙",
                                                    "text": "什么呀…你刚刚说了什么吗？"
                                                },
                                                {
                                                    "id": "710580517",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "「《愚人众先遣部队训练手册》附录4-4，第32条：恰到好处地分享食物和情报，可以堵住询问者的嘴。」喏？"
                                                },
                                                {
                                                    "id": "710580518",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "为了报答救命之恩，我甚至透露了机密的训练手册内容！哼哼，诚意如何？"
                                                },
                                                {
                                                    "id": "710580519",
                                                    "speaker": "派蒙",
                                                    "text": "告诉我们那个有什么用啦！"
                                                },
                                                {
                                                    "id": "710580520",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "呵呵，不和你们开玩笑了…说真的，非常感谢你们的帮助，请不要过度解读了我的好意。"
                                                },
                                                {
                                                    "id": "710580521",
                                                    "speaker": "派蒙",
                                                    "text": "唔…鉴于你们之前做的那些坏事，还真不好相信愚人众会有好意呢…"
                                                },
                                                {
                                                    "id": "710580522",
                                                    "speaker": "Player",
                                                    "text": "你有什么图谋？"
                                                },
                                                {
                                                    "id": "710580523",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "外人无法理解愚人众的理念，并不出我意料。不过在不聊什么理念呀、立场呀之类问题的时候，我们也是些普通人嘛。"
                                                },
                                                {
                                                    "id": "710580524",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "…况且，我们的一切行为，不论目的如何，都不过是在为最终的决战做准备而已。"
                                                },
                                                {
                                                    "id": "710580525",
                                                    "speaker": "Player",
                                                    "text": "最终的决战…？"
                                                },
                                                {
                                                    "id": "710580526",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "嗯，我们最终要面对的是共同的大敌，和无可逃脱的长夜…至冬国的国民都接受了这样的警告。"
                                                },
                                                {
                                                    "id": "710580527",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "所以，为了这个冷酷的世界，人类流下的每一滴泪水与鲜血…都不是没有意义。"
                                                },
                                                {
                                                    "id": "710580528",
                                                    "speaker": "卡塔琳娜",
                                                    "text": "干杯？哼，好吧，好吧，我自便…",
                                                    "choices": [
                                                        {
                                                            "id": "710580529",
                                                            "text": "你是在为恶行找借口吗？",
                                                            "response": [
                                                                {
                                                                    "id": "710580530",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "或许吧…不知道，不在乎。你想要解释，我给你理由…只不过是我的版本，可能不对你胃口。就这么简单。"
                                                                },
                                                                {
                                                                    "id": "710580534",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…你们怎么突然正经聊起天来啦…"
                                                                },
                                                                {
                                                                    "id": "710580535",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "顺便，我已经自我介绍过了，但还不知道你们的名字呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710580536",
                                                                            "text": "#{NICKNAME}。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710580538",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我是派蒙！你一定听说过！"
                                                                                },
                                                                                {
                                                                                    "id": "710580539",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "哦哦！你们的名字…！"
                                                                                },
                                                                                {
                                                                                    "id": "710580540",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "哼，哼！怎么样？一定传遍了整个提瓦特大陆，对不对？"
                                                                                },
                                                                                {
                                                                                    "id": "710580541",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "抱歉，没听说过，一个都没有。"
                                                                                },
                                                                                {
                                                                                    "id": "710580542",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸——？"
                                                                                },
                                                                                {
                                                                                    "id": "710580543",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "无意冒犯，不过我们很早就调来这里了。除了从补给线传下来的消息之外，我们对地面上的新闻几乎一无所知…"
                                                                                },
                                                                                {
                                                                                    "id": "710580544",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "欸…！那不就是说…"
                                                                                },
                                                                                {
                                                                                    "id": "710580545",
                                                                                    "speaker": "Player",
                                                                                    "text": "你们的补给线断了很久？"
                                                                                },
                                                                                {
                                                                                    "id": "710580546",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "710580547",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "茶会时间结束！我要休息了，抱歉！"
                                                                                },
                                                                                {
                                                                                    "id": "710580548",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "喂！明明我们什么都没吃到！"
                                                                                },
                                                                                {
                                                                                    "id": "710580549",
                                                                                    "speaker": "卡塔琳娜",
                                                                                    "text": "给我走啦！你们不是嫌弃我的火水吗！"
                                                                                },
                                                                                {
                                                                                    "id": "710580550",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "那种东西本来也不是人能喝的吧！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "710580551",
                                                                                            "text": "好啦，派蒙…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710580553",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "哼！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580554",
                                                                                                    "speaker": "卡塔琳娜",
                                                                                                    "text": "#顺便，顺便…！{NICKNAME}，请稍微留步…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580555",
                                                                                                    "speaker": "卡塔琳娜",
                                                                                                    "text": "唔…没什么，只是…如果是你的话…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580556",
                                                                                                    "speaker": "卡塔琳娜",
                                                                                                    "text": "改天请来找我…如果你方便的话。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "710580552",
                                                                                            "text": "不要以你自己的标准度人嘛…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "710580537",
                                                                            "text": "#你可能听说过，我是{NICKNAME}。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710580531",
                                                            "text": "这理由太宏大了…",
                                                            "response": [
                                                                {
                                                                    "id": "710580532",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "哈…！至冬国的酒和果酱，你真应该试试。"
                                                                },
                                                                {
                                                                    "id": "710580533",
                                                                    "speaker": "卡塔琳娜",
                                                                    "text": "是你太严肃啦…不要想那么多，相信自己愿意相信的东西就好。这就是所谓的「信仰」嘛。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "你又在搞什么鬼？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710580508",
                            "text": "我们不是来开茶会的…",
                            "response": [
                                {
                                    "id": "710580509",
                                    "speaker": "卡塔琳娜",
                                    "text": "我知道，我知道…别想那么多啦。",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "你这是在做什么？"
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "你又在搞什么鬼？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105806",
            "objective": "与愚人众术士对话",
            "dialogues": []
        }
    ]
