    "talks": [
        {
            "id": "1504801",
            "objective": "前往「阿夏快跑」",
            "dialogues": [
                {
                    "id": "150480101",
                    "speaker": "高恩",
                    "text": "…我们不能让您承担这种风险。"
                },
                {
                    "id": "150480102",
                    "speaker": "班尼特",
                    "text": "可您刚才还不是这么说的…"
                },
                {
                    "id": "150480103",
                    "speaker": "高恩",
                    "text": "实在抱歉，虽然时间很紧张，但我们更需要考虑游客的人身安全，请您谅解。"
                },
                {
                    "id": "150480104",
                    "speaker": "班尼特",
                    "text": "#{NICKNAME}，你来得正好，请帮我说服这位先生吧。"
                },
                {
                    "id": "150480105",
                    "speaker": "班尼特",
                    "text": "他们急着等人测试，我好不容易向对方证明了我的冒险经验，也表明我愿意承担测试后果，本来很顺利…"
                },
                {
                    "id": "150480106",
                    "speaker": "班尼特",
                    "text": "但一听到我的「过往危机经历」，这位先生就说什么都不肯了。"
                },
                {
                    "id": "150480107",
                    "speaker": "高恩",
                    "text": "这位游客，我理解您的热心。"
                },
                {
                    "id": "150480108",
                    "speaker": "高恩",
                    "text": "但如果您过桥的时候都会失足掉进水里，最好还是去参与更温和一点的项目…那边的沙滩躺椅怎么样？"
                },
                {
                    "id": "150480109",
                    "speaker": "班尼特",
                    "text": "唉，可是，可是我确实是符合测试条件的冒险家！那只是因为…运气不好…"
                },
                {
                    "id": "150480110",
                    "speaker": "班尼特",
                    "text": "我是真的很想帮上忙，请您相信我的实力是值得信任的…",
                    "choices": [
                        {
                            "id": "150480111",
                            "text": "我可以证明。",
                            "response": [
                                {
                                    "id": "150480113",
                                    "speaker": "高恩",
                                    "text": "既然拯救纳塔的大英雄都这么说了…这样吧，可否先让这位阿夏搭档完成第一轮测试呢？"
                                },
                                {
                                    "id": "150480114",
                                    "speaker": "高恩",
                                    "text": "您可以在一旁观看，提前熟悉整体路线。一切顺利无误的话，再来请您参与第二轮测试。"
                                },
                                {
                                    "id": "150480115",
                                    "speaker": "班尼特",
                                    "text": "阿夏，你愿意吗？"
                                },
                                {
                                    "id": "150480116",
                                    "speaker": "阿夏",
                                    "text": "♪"
                                },
                                {
                                    "id": "150480117",
                                    "speaker": "班尼特",
                                    "text": "好，那就交给你了哦，我的好搭档。"
                                }
                            ]
                        },
                        {
                            "id": "150480112",
                            "text": "我为他担保。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504802",
            "objective": "协助阿夏到达终点",
            "dialogues": []
        },
        {
            "id": "1504803",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150480301",
                    "speaker": "派蒙",
                    "text": "成功啦！也不算很难嘛。"
                },
                {
                    "id": "150480302",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150480303",
                    "speaker": "班尼特",
                    "text": "做得好，阿夏！你的运动能力超级棒啊，看得我目瞪口呆！"
                },
                {
                    "id": "150480304",
                    "speaker": "派蒙",
                    "text": "接下去轮到班尼特测试了对吧？"
                },
                {
                    "id": "150480305",
                    "speaker": "班尼特",
                    "text": "对！我已经做好热身运动，活动开全身的筋骨和肌肉了，包在我身上。"
                },
                {
                    "id": "150480306",
                    "speaker": "Player",
                    "text": "也要注意安全。"
                },
                {
                    "id": "150480307",
                    "speaker": "班尼特",
                    "text": "嗯！多谢关心！"
                }
            ]
        },
        {
            "id": "1504804",
            "objective": "与班尼特和阿夏对话",
            "dialogues": [
                {
                    "id": "150480401",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150480402",
                    "speaker": "班尼特",
                    "text": "阿夏，你的意思是，你愿意在前方引导我，当我的指导教练吗？"
                },
                {
                    "id": "150480403",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150480404",
                    "speaker": "班尼特",
                    "text": "太可靠了！有你领路我就更不担心会出意外了。我们走吧，教练先请！"
                },
                {
                    "id": "150480405",
                    "speaker": "派蒙",
                    "text": "加油阿夏，加油班尼特！"
                }
            ]
        },
        {
            "id": "1504805",
            "objective": "跟随阿夏，前往终点",
            "dialogues": []
        },
        {
            "id": "1504806",
            "objective": "前往终点",
            "dialogues": [
                {
                    "id": "150480601",
                    "speaker": "班尼特",
                    "text": "…好，还差最后一点，沉住气…"
                },
                {
                    "id": "150480602",
                    "speaker": "班尼特",
                    "text": "终点？！终点怎么飞走了啊——"
                },
                {
                    "id": "150480603",
                    "speaker": "班尼特",
                    "text": "难道是我乌鸦嘴了？还是说我的好运突然用完了？不对，现在不是沮丧的时候。"
                },
                {
                    "id": "150480604",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150480605",
                    "speaker": "班尼特",
                    "text": "阿夏…对啊！只要我们心意相通…"
                }
            ]
        },
        {
            "id": "1504807",
            "objective": "追回「终点」",
            "dialogues": []
        },
        {
            "id": "1504808",
            "objective": "与其他人会合",
            "dialogues": [
                {
                    "id": "150480801",
                    "speaker": "班尼特",
                    "text": "我心跳好快，感觉还要好一阵才能恢复平稳…"
                },
                {
                    "id": "150480802",
                    "speaker": "阿夏",
                    "text": "♪"
                },
                {
                    "id": "150480803",
                    "speaker": "派蒙",
                    "text": "恭喜班尼特和阿夏呀！教练指导的好，学员完成的也好。"
                },
                {
                    "id": "150480804",
                    "speaker": "派蒙",
                    "text": "尤其是最后的配合，你们的默契发挥了巨大的作用！"
                },
                {
                    "id": "150480805",
                    "speaker": "Player",
                    "text": "靠合作突破了厄运的封锁。"
                },
                {
                    "id": "150480806",
                    "speaker": "班尼特",
                    "text": "嗯！"
                },
                {
                    "id": "150480807",
                    "speaker": "班尼特",
                    "text": "#我还想特别感谢你，{NICKNAME}。"
                },
                {
                    "id": "150480808",
                    "speaker": "班尼特",
                    "text": "要不是你愿意相信我，帮我说服工作人员，我肯定不会有机会完成挑战，也就没有机会和它共渡难关…"
                },
                {
                    "id": "150480809",
                    "speaker": "高恩",
                    "text": "班尼特先生，最后的安全测试已经完全通过了，「阿夏快跑」即刻起就可以投入正式运营，多谢您的协助！"
                },
                {
                    "id": "150480810",
                    "speaker": "班尼特",
                    "text": "阿夏，听到了吗？我们成功了！"
                },
                {
                    "id": "150480811",
                    "speaker": "高恩",
                    "text": "我会记得你的名字，热心而勇敢的冒险家班尼特先生。"
                },
                {
                    "id": "150480812",
                    "speaker": "班尼特",
                    "text": "虽然冒险还在继续，可我总感觉，自己已经越来越舍不得离开它了…"
                },
                {
                    "id": "150480813",
                    "speaker": "班尼特",
                    "text": "阿夏，我一定会想念你的。"
                },
                {
                    "id": "150480814",
                    "speaker": "阿夏",
                    "text": "……"
                },
                {
                    "id": "150480815",
                    "speaker": "班尼特",
                    "text": "不…怎么能让你安慰我呢，我可是团长啊。我才应该照顾团员、安慰团员才对。"
                },
                {
                    "id": "150480816",
                    "speaker": "阿夏",
                    "text": "……"
                },
                {
                    "id": "150480817",
                    "speaker": "班尼特",
                    "text": "奇怪，我这是太激动了吗？为什么眼眶突然变得好热，都有点语无伦次了，哈哈…"
                },
                {
                    "id": "150480818",
                    "speaker": "班尼特",
                    "text": "回头我得请教最会写诗的温迪老师，让他教教我在这种时候，要用怎样的词句表达心情…"
                },
                {
                    "id": "150480819",
                    "speaker": "派蒙",
                    "text": "卖唱的恐怕会说…"
                },
                {
                    "id": "150480820",
                    "speaker": "Player",
                    "text": "自由传达你想说的就好。"
                },
                {
                    "id": "150480821",
                    "speaker": "班尼特",
                    "text": "有你在真的太好了…谢谢你，阿夏…"
                },
                {
                    "id": "150480822",
                    "speaker": "阿夏",
                    "text": "……"
                }
            ]
        },
        {
            "id": "1504809",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        }
    ]
}