        "chapter": {
            "icon": "UI_ChapterIcon_EasybreezeHolidayResort",
            "id": "10246",
            "num": "绘夏！烈日？度假村！其二",
            "title": "畅玩！举目之处皆为画布！"
        },
        "total_dialogue_lines": 56,
        "total_speaker_counts": {
