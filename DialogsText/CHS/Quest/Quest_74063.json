    "talks": [
        {
            "id": "7406301",
            "objective": "(test)靠近摄像机播reminder$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7406307",
            "objective": "",
            "dialogues": [
                {
                    "id": "740630701",
                    "speaker": "格兰维尔",
                    "text": "在生产区需要遵守劳动纪律，安全第一。没什么问题的话不要打扰我工作。"
                }
            ]
        },
        {
            "id": "7406302",
            "objective": "与奈莉对话",
            "dialogues": [
                {
                    "id": "740630201",
                    "speaker": "派蒙",
                    "text": "嗯？这里怎么会有留影机？"
                },
                {
                    "id": "740630202",
                    "speaker": "奈莉",
                    "text": "「有新闻的地方就有留影机」，你们没听过这句话吗？",
                    "choices": [
                        {
                            "id": "740630203",
                            "text": "好像听过。",
                            "response": [
                                {
                                    "id": "740630204",
                                    "speaker": "奈莉",
                                    "text": "可是这句话是我刚编的欸，你是在哪里听过的？"
                                },
                                {
                                    "id": "740630205",
                                    "speaker": "奈莉",
                                    "text": "唉，果然这世上根本没有什么新鲜东西。不管说什么、写什么，都只能是对他者的戏仿。"
                                },
                                {
                                    "id": "740630208",
                                    "speaker": "Player",
                                    "text": "留影机有了，新闻在哪儿？"
                                },
                                {
                                    "id": "740630209",
                                    "speaker": "奈莉",
                                    "text": "新闻…就像钓鱼一样。需要耐心的等待，在准确的时机做出正确的判断，这样才能钓上大鱼…"
                                },
                                {
                                    "id": "740630210",
                                    "speaker": "奈莉",
                                    "text": "哦，不，我是说，这样才能钓到大新闻。嗯？好像也不对，算了，不管了！",
                                    "choices": [
                                        {
                                            "id": "740630211",
                                            "text": "听起来好业余啊，你不是记者吧。",
                                            "response": [
                                                {
                                                    "id": "740630212",
                                                    "speaker": "奈莉",
                                                    "text": "那你就看走眼了，哼哼，我是业余记者。"
                                                },
                                                {
                                                    "id": "740630222",
                                                    "speaker": "派蒙",
                                                    "text": "话说回来，业余记者为什么会在这里？"
                                                },
                                                {
                                                    "id": "740630223",
                                                    "speaker": "奈莉",
                                                    "text": "为了完成前辈交给我的课题呀，也就是用留影机捕捉梅洛彼得堡看守在工作中的生动瞬间！"
                                                },
                                                {
                                                    "id": "740630224",
                                                    "speaker": "奈莉",
                                                    "text": "可是之前为了办理相关的合规文件耗费了太多时间…你们看看就知道了。"
                                                },
                                                {
                                                    "id": "740630225",
                                                    "speaker": "Black Screen",
                                                    "text": "奈莉拿出一大摞文件，密密麻麻写着各项条款和各种署名，看了感觉头昏眼花…"
                                                },
                                                {
                                                    "id": "740630226",
                                                    "speaker": "奈莉",
                                                    "text": "这一套流程全跑完，都错过看守当班的时间啦。用钓鱼来类比的话，现在根本没鱼可钓…"
                                                },
                                                {
                                                    "id": "740630227",
                                                    "speaker": "派蒙",
                                                    "text": "欸？可是这里明明还有看守在当班吧？"
                                                },
                                                {
                                                    "id": "740630228",
                                                    "speaker": "奈莉",
                                                    "text": "可我想钓白金典藏型嘛，如果是初始能力型或者水域清理者，总觉得少了点冲击力…就算完成了课题，前辈也一定不会称赞我。",
                                                    "choices": [
                                                        {
                                                            "id": "740630229",
                                                            "text": "不想空手而归的话就别挑挑拣拣了。",
                                                            "response": [
                                                                {
                                                                    "id": "740630233",
                                                                    "speaker": "奈莉",
                                                                    "text": "说得对，我应该正视自己的能力，不要妄想去钓超出自己能力范围的鱼…呜呜，我是个没用的钓师…哦不，是没用的业余记者。"
                                                                },
                                                                {
                                                                    "id": "740630234",
                                                                    "speaker": "奈莉",
                                                                    "text": "好，丧气话说完了，该振作起来了！两位如果方便的话…能帮我一个小忙吗？拜托了！我会支付报酬的！"
                                                                },
                                                                {
                                                                    "id": "740630235",
                                                                    "speaker": "派蒙",
                                                                    "text": "变脸可真快呀…帮忙也得看是什么内容呀，不如你先说说需要我们做什么？"
                                                                },
                                                                {
                                                                    "id": "740630236",
                                                                    "speaker": "奈莉",
                                                                    "text": "那边的看守，格兰维尔，根据我的判断，他的新闻价值等价于态势控制者在维护机关里的价值…"
                                                                },
                                                                {
                                                                    "id": "740630237",
                                                                    "speaker": "奈莉",
                                                                    "text": "给他留影的话，应该能写出一篇不错的报道吧。这样前辈一定也无话可说了。"
                                                                },
                                                                {
                                                                    "id": "740630238",
                                                                    "speaker": "奈莉",
                                                                    "text": "但是他根本不过来这边！两位能不能把他带到这边适合留影的地方来…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740630239",
                                                                            "text": "你自己说明情况让他过来不就好了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740630240",
                                                                                    "speaker": "奈莉",
                                                                                    "text": "那样的话他肯定会因为太过在意镜头而摆出僵硬的姿势的，那不就成摆拍了吗？"
                                                                                },
                                                                                {
                                                                                    "id": "740630243",
                                                                                    "speaker": "奈莉",
                                                                                    "text": "我想想，最好是这样，先把扩音机关掉，然后向格兰维尔报告，说这边的扩音机故障了，请他来看看。"
                                                                                },
                                                                                {
                                                                                    "id": "740630244",
                                                                                    "speaker": "奈莉",
                                                                                    "text": "这样一定就能拍到了，梅洛彼得堡看守在工作中的生动瞬间！"
                                                                                },
                                                                                {
                                                                                    "id": "740630245",
                                                                                    "speaker": "奈莉",
                                                                                    "text": "课题能否完成就在此一举了！拜托你们了，帮帮我吧！"
                                                                                },
                                                                                {
                                                                                    "id": "740630246",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#听起来倒是不难，{NICKNAME}，要不我们就帮帮她好了。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740630241",
                                                                            "text": "带留影机去他那边不就好了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740630242",
                                                                                    "speaker": "奈莉",
                                                                                    "text": "欸——可是这边更适合取景嘛。而且如果让他看到留影机，一定会在意得不得了，最后拍出一些姿势僵硬的画片…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740630230",
                                                            "text": "那你继续等吧，再见。",
                                                            "response": [
                                                                {
                                                                    "id": "740630231",
                                                                    "speaker": "奈莉",
                                                                    "text": "你们这就走吗？真的走？不帮帮我吗？"
                                                                },
                                                                {
                                                                    "id": "740630232",
                                                                    "speaker": "派蒙",
                                                                    "text": "呃…我们也不可能变出你想要的白金典藏型吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740630213",
                                            "text": "别管新闻了，我也喜欢钓鱼。",
                                            "response": [
                                                {
                                                    "id": "740630214",
                                                    "speaker": "奈莉",
                                                    "text": "当真？那太好了，其实我只是钓鱼新手，正愁有些问题没处讨教，比如说钓到维护机关但它咬人…是你的话会怎么应对呢？",
                                                    "choices": [
                                                        {
                                                            "id": "740630215",
                                                            "text": "放生就好了。",
                                                            "response": [
                                                                {
                                                                    "id": "740630219",
                                                                    "speaker": "奈莉",
                                                                    "text": "原来如此，这就是你的选择啊。嗯嗯，很有参考价值，我记下了。"
                                                                },
                                                                {
                                                                    "id": "740630220",
                                                                    "speaker": "奈莉",
                                                                    "text": "…欸！怎么突然聊起钓鱼了？你们好擅长引导话题！看来我作为业余记者还有很多要学的…"
                                                                },
                                                                {
                                                                    "id": "740630221",
                                                                    "speaker": "派蒙",
                                                                    "text": "钓鱼的话题根本就是你自己先提起的吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740630216",
                                                            "text": "那当然是揍它一顿让它知道厉害。"
                                                        },
                                                        {
                                                            "id": "740630217",
                                                            "text": "做成料理请派蒙品尝。",
                                                            "response": [
                                                                {
                                                                    "id": "740630218",
                                                                    "speaker": "派蒙",
                                                                    "text": "#呜哇，虽然我很信任{NICKNAME}的厨艺，但是那东西怎么看都不像可食用的类型吧！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740630206",
                            "text": "没听过。",
                            "response": [
                                {
                                    "id": "740630207",
                                    "speaker": "奈莉",
                                    "text": "哦哦！那你们现在听过了。请记住，如果要在别处引用，一定要注明来源！也就是我！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406303",
            "objective": "关闭扩音机",
            "dialogues": [
                {
                    "id": "740630301",
                    "speaker": "奈莉",
                    "text": "我一定要拍出让前辈刮目相看的画片！"
                },
                {
                    "id": "740630302",
                    "speaker": "奈莉",
                    "text": "可恶，还是好想要白金典藏型…"
                }
            ]
        },
        {
            "id": "7406304",
            "objective": "与看守对话",
            "dialogues": [
                {
                    "id": "740630401",
                    "speaker": "派蒙",
                    "text": "你好，我们发现扩音机好像出了点小问题…就在那边。"
                },
                {
                    "id": "740630402",
                    "speaker": "格兰维尔",
                    "text": "又故障了？真是怪事…明明之前找克兰茨修过。看来他这水平还不如我呢，明明过去都是锤两下就好。"
                },
                {
                    "id": "740630403",
                    "speaker": "格兰维尔",
                    "text": "谢谢你们，我过去看看。"
                },
                {
                    "id": "740630404",
                    "speaker": "派蒙",
                    "text": "辛苦啦！"
                }
            ]
        },
        {
            "id": "7406306",
            "objective": "等待看守到达指定位置",
            "dialogues": [
                {
                    "id": "740630601",
                    "speaker": "格兰维尔",
                    "text": "到底哪里有问题？唔…"
                }
            ]
        },
        {
            "id": "7406305",
            "objective": "与奈莉对话",
            "dialogues": [
                {
                    "id": "740630501",
                    "speaker": "奈莉",
                    "text": "这下前辈交给我的课题总算能完成了，我也是个独当一面的记者了！谢谢你们！"
                },
                {
                    "id": "740630502",
                    "speaker": "派蒙",
                    "text": "看来是拍到了生动的画片呢。"
                },
                {
                    "id": "740630503",
                    "speaker": "奈莉",
                    "text": "是啊，你们瞧。",
                    "choices": [
                        {
                            "id": "740630504",
                            "text": "生动看不出来，但很艺术。",
                            "response": [
                                {
                                    "id": "740630505",
                                    "speaker": "派蒙",
                                    "text": "是我完全看不懂的艺术…"
                                },
                                {
                                    "id": "740630508",
                                    "speaker": "派蒙",
                                    "text": "真的这样就可以了吗？"
                                },
                                {
                                    "id": "740630509",
                                    "speaker": "奈莉",
                                    "text": "哪里有问题吗？我觉得拍得很棒！前辈一定想不到我会拍出这样的画片来，肯定会大吃一惊的。"
                                },
                                {
                                    "id": "740630510",
                                    "speaker": "派蒙",
                                    "text": "真搞不懂你的评价标准…"
                                },
                                {
                                    "id": "740630511",
                                    "speaker": "奈莉",
                                    "text": "哎呀，这就是所谓的「象征意义大于实质内容」。我相信前辈肯定能读懂背后的含义！"
                                },
                                {
                                    "id": "740630512",
                                    "speaker": "奈莉",
                                    "text": "不管怎么说，谢谢你们帮忙，这些是给你们的。嘿嘿，下次要是能在可以钓鱼的地方聊天就好啦！"
                                }
                            ]
                        },
                        {
                            "id": "740630506",
                            "text": "太生动了，好像随时都会动起来。",
                            "response": [
                                {
                                    "id": "740630507",
                                    "speaker": "派蒙",
                                    "text": "唔唔，感觉多看一会儿就会头晕…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406300",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740630004",
                    "speaker": "奈莉",
                    "text": "嘿嘿，成了！"
                },
                {
                    "id": "740630005",
                    "speaker": "派蒙",
                    "text": "总之先去把扩音机关掉好了。"
                },
                {
                    "id": "740630006",
                    "speaker": "派蒙",
                    "text": "接下来去找格兰维尔报告吧？就说扩音机出了点小问题…"
                },
                {
                    "id": "740630007",
                    "speaker": "派蒙",
                    "text": "之后就看奈莉的本领了。我们等等吧。"
                }
            ]
        }
    ]
}