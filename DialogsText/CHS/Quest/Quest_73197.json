    "talks": [
        {
            "id": "7319701",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970101",
                    "speaker": "健康之家箴言栏",
                    "text": "此为收集教令院历代学者箴言的箴言栏，唯有沿着先贤开拓的道路，我们才能终见智慧之光。"
                },
                {
                    "id": "731970102",
                    "speaker": "健康之家箴言栏",
                    "text": "正所谓「日光之下，并无新事。」"
                }
            ]
        },
        {
            "id": "7319702",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970201",
                    "speaker": "普尔希娜",
                    "text": "「健康的身体造就健全的灵魂，灵魂的健全保证身体的健康。」"
                }
            ]
        },
        {
            "id": "7319703",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970301",
                    "speaker": "苏诃瓦蒂",
                    "text": "「学者是灵魂和身体的守护者。」"
                }
            ]
        },
        {
            "id": "7319704",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970401",
                    "speaker": "阿尔比鲁尼",
                    "text": "「亲近智慧，而非知识。」"
                }
            ]
        },
        {
            "id": "7319705",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970501",
                    "speaker": "希般卡帝",
                    "text": "「不懂占星的医师没资格称自己为医师。」"
                }
            ]
        },
        {
            "id": "7319706",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970601",
                    "speaker": "阿尔瓦·尼古拉",
                    "text": "「孤独是新知的前导。」"
                }
            ]
        },
        {
            "id": "7319707",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970701",
                    "speaker": "麦苏迪",
                    "text": "「从棋盘观世界之理，群星的艺术皆在纵横捭阖之间。」"
                }
            ]
        },
        {
            "id": "7319708",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970801",
                    "speaker": "阿叶夏",
                    "text": "「我们知道的，多于我们所能言说的。」"
                }
            ]
        },
        {
            "id": "7319709",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970901",
                    "speaker": "法德兰",
                    "text": "「似乎某些时刻，共同行走于凡世的七神也会彼此背道而驰。」"
                }
            ]
        },
        {
            "id": "7319710",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971001",
                    "speaker": "普尔希娜",
                    "text": "「即使是再幼小的龙蜥，也有成为『龙』的潜质。」"
                }
            ]
        },
        {
            "id": "7319711",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971101",
                    "speaker": "伊斯坎德",
                    "text": "「倚仗刀剑者，必将为刀剑所伤。」"
                }
            ]
        },
        {
            "id": "7319712",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971201",
                    "speaker": "维斯塔姆",
                    "text": "「事实比语言更加清楚。」"
                }
            ]
        },
        {
            "id": "7319713",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971301",
                    "speaker": "娜迦师",
                    "text": "「治愈爱情的良药是没有的…」"
                }
            ]
        },
        {
            "id": "7319714",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971401",
                    "speaker": "迦毗鸠师",
                    "text": "「事实证明，降诸魔山上连不上虚空。」"
                }
            ]
        },
        {
            "id": "7319715",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971501",
                    "speaker": "玛塔布",
                    "text": "「人要是唉声叹气，驮兽也会不叫。」"
                }
            ]
        },
        {
            "id": "7319716",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971601",
                    "speaker": "居勒什",
                    "text": "「世上没有什么是永恒不变的。」"
                }
            ]
        },
        {
            "id": "7319717",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971701",
                    "speaker": "印和阗",
                    "text": "「我死后想到猫去的地方…」"
                }
            ]
        }
    ]
}