    "talks": [
        {
            "id": "7103901",
            "objective": "隐藏计时时间$HIDDEN",
            "dialogues": [
                {
                    "id": "710390101",
                    "speaker": "瑾武",
                    "text": "……",
                    "choices": [
                        {
                            "id": "710390102",
                            "text": "你好，瑾武姐！",
                            "response": [
                                {
                                    "id": "710390104",
                                    "speaker": "瑾武",
                                    "text": "…？！"
                                },
                                {
                                    "id": "710390105",
                                    "speaker": "派蒙",
                                    "text": "哇啊，吓我一跳！"
                                },
                                {
                                    "id": "710390106",
                                    "speaker": "瑾武",
                                    "text": "抱…抱歉。那个，如果你们要找志琼的话…她离队了。",
                                    "choices": [
                                        {
                                            "id": "710390107",
                                            "text": "她去哪里了？",
                                            "response": [
                                                {
                                                    "id": "710390108",
                                                    "speaker": "瑾武",
                                                    "text": "我不知道…只是疏忽了一会，她就这样不见了。"
                                                },
                                                {
                                                    "id": "710390112",
                                                    "speaker": "瑾武",
                                                    "text": "我和她谈过了…她还是执意要走。好话坏话，或者拳头都留不住她。"
                                                },
                                                {
                                                    "id": "710390113",
                                                    "speaker": "瑾武",
                                                    "text": "唉…希望她知道她自己在做什么吧。希望如此。"
                                                },
                                                {
                                                    "id": "710390114",
                                                    "speaker": "瑾武",
                                                    "text": "希望如此…"
                                                },
                                                {
                                                    "id": "710390115",
                                                    "speaker": "瑾武",
                                                    "text": "对了，这件事一定要和沐宁说。让他尽快组织一支搜救队，尽早找到那孩子才行！",
                                                    "choices": [
                                                        {
                                                            "id": "710390116",
                                                            "text": "我们会去的。",
                                                            "response": [
                                                                {
                                                                    "id": "710390118",
                                                                    "speaker": "派蒙",
                                                                    "text": "真是的…志琼怎么又不见了！我们快去地面找沐宁吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710390117",
                                                            "text": "请你稍微安心。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710390109",
                                            "text": "她离开时情况如何？",
                                            "response": [
                                                {
                                                    "id": "710390110",
                                                    "speaker": "瑾武",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "710390111",
                                                    "speaker": "瑾武",
                                                    "text": "海迪夫给她做过了检查，她的情况很不好…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710390103",
                            "text": "你还好吗！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103902",
            "objective": "与瑾武对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7103903",
            "objective": "向沐宁说明志琼离开之事",
            "dialogues": [
                {
                    "id": "710390201",
                    "speaker": "沐宁",
                    "text": "嗯？志琼没和你一起上来吗？总务司的荐书下来了。"
                },
                {
                    "id": "710390202",
                    "speaker": "沐宁",
                    "text": "因为她绘制的地图给辉山厅帮了大忙，总务司破格聘任她为…嗯，我看看…顾问向导，享受正式职位待遇。"
                },
                {
                    "id": "710390203",
                    "speaker": "沐宁",
                    "text": "恭喜志琼啦，先前那样四处乱跑果然不是白做工的。"
                },
                {
                    "id": "710390204",
                    "speaker": "Player",
                    "text": "她退出了。"
                },
                {
                    "id": "710390205",
                    "speaker": "沐宁",
                    "text": "退出了？什么意思…？她先离开了吗？可是千岩军没有和我说有人离开过层岩巨渊啊…"
                },
                {
                    "id": "710390206",
                    "speaker": "Player",
                    "text": "志琼退出了勘探队。"
                },
                {
                    "id": "710390207",
                    "speaker": "沐宁",
                    "text": "啊？哦…"
                },
                {
                    "id": "710390208",
                    "speaker": "沐宁",
                    "text": "等等！等等！"
                },
                {
                    "id": "710390209",
                    "speaker": "沐宁",
                    "text": "不对不对…你说，她，退出了勘探队？"
                },
                {
                    "id": "710390210",
                    "speaker": "沐宁",
                    "text": "志琼，退出了？"
                },
                {
                    "id": "710390211",
                    "speaker": "派蒙",
                    "text": "对呀！你是哪个部分听不懂呀！"
                },
                {
                    "id": "710390212",
                    "speaker": "沐宁",
                    "text": "…我明白了，我会即刻组织起一支搜救队。如果她还留在层岩巨渊，我们应该还能找到她。"
                },
                {
                    "id": "710390213",
                    "speaker": "沐宁",
                    "text": "不管她是又一次自己犯傻，还是别的什么原因…要找到她才行。"
                },
                {
                    "id": "710390214",
                    "speaker": "沐宁",
                    "text": "以她现在的状态，脱离队伍擅自行动完全是在胡闹…",
                    "choices": [
                        {
                            "id": "710390215",
                            "text": "需要我帮忙吗？",
                            "response": [
                                {
                                    "id": "710390216",
                                    "speaker": "沐宁",
                                    "text": "抱歉，这次就不需要劳烦你帮忙了…我也总得派上点用场嘛。"
                                },
                                {
                                    "id": "710390233",
                                    "speaker": "Player",
                                    "text": "如果需要我帮忙，我一定尽快赶到。"
                                },
                                {
                                    "id": "710390234",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，我也是！不能放着后辈不管呀！"
                                },
                                {
                                    "id": "710390235",
                                    "speaker": "派蒙",
                                    "text": "我们也在路上多多注意吧，说不定什么时候就能遇见她了呢！"
                                }
                            ]
                        },
                        {
                            "id": "710390217",
                            "text": "关于志琼…",
                            "response": [
                                {
                                    "id": "710390218",
                                    "speaker": "沐宁",
                                    "text": "她是个不安分的家伙，但我们再怎么说也算是朋友。我知道我不讨人喜欢…但我可不能随随便便就把朋友忘了。"
                                },
                                {
                                    "id": "710390219",
                                    "speaker": "沐宁",
                                    "text": "这家伙总是在做什么冒险家的大梦，之前受过几次重伤…还差点把命也搭进去。后来好不容易才安生了一段时间…"
                                },
                                {
                                    "id": "710390220",
                                    "speaker": "沐宁",
                                    "text": "本来以为她已经把不切实际的美梦抛之脑后了…罗尔德、斯坦利，哪有那么好当！"
                                },
                                {
                                    "id": "710390221",
                                    "speaker": "沐宁",
                                    "text": "唉…可是没想到…或许这次我不应该推荐请你来探索层岩巨渊才是，不然也不至于引起志琼的这把火…",
                                    "choices": [
                                        {
                                            "id": "710390222",
                                            "text": "但她的努力并非毫无收获。",
                                            "response": [
                                                {
                                                    "id": "710390223",
                                                    "speaker": "沐宁",
                                                    "text": "收获…？你这样说，未免有点太功利了。她画下了地下大部分区域的地图，我们很感激没错…但…"
                                                },
                                                {
                                                    "id": "710390224",
                                                    "speaker": "沐宁",
                                                    "text": "把「愿望」这种虚无缥缈的东西，和追求它的行为，放置于生命本身之上…？"
                                                },
                                                {
                                                    "id": "710390225",
                                                    "speaker": "沐宁",
                                                    "text": "我是无论如何也不能理解的，我也不能想象有人真的为此置身危险之中。"
                                                },
                                                {
                                                    "id": "710390232",
                                                    "speaker": "沐宁",
                                                    "text": "所以，寻找她的事情，就请包在我身上吧…呃，我是说，包在千岩军的搜救队身上吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710390226",
                                            "text": "但这是她的选择。",
                                            "response": [
                                                {
                                                    "id": "710390227",
                                                    "speaker": "沐宁",
                                                    "text": "选择，选择，选择…什么借口！她是在去送死，你没意识到吗？"
                                                },
                                                {
                                                    "id": "710390228",
                                                    "speaker": "沐宁",
                                                    "text": "咳咳…抱歉，我的话说得有点太重了。但…在我们凡人无法扭转的情势面前…她应该更耐心些的。"
                                                },
                                                {
                                                    "id": "710390229",
                                                    "speaker": "沐宁",
                                                    "text": "再等…二三十年，也许只用十年，说不定她就能等到更加安全的矿下设备研发完成了呢？到那时候她也用不着急着勘探地下地图了。"
                                                },
                                                {
                                                    "id": "710390230",
                                                    "speaker": "沐宁",
                                                    "text": "但她一点也不愿意等等…只想在自己最年轻的时候，就完成别人一辈子的成就！"
                                                },
                                                {
                                                    "id": "710390231",
                                                    "speaker": "沐宁",
                                                    "text": "这家伙太傻了…作为朋友，这件事我不能不管。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}