            "dialogues": []
        },
        {
            "id": "7903301",
            "objective": "监听是否获取海螺1号$HIDDEN",
            "dialogues": [
                {
                    "id": "790330101",
                    "speaker": "派蒙",
                    "text": "唔，影像居然正好放在舞台的中间…"
                },
                {
                    "id": "790330102",
                    "speaker": "派蒙",
                    "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…"
                },
                {
                    "id": "790330103",
                    "speaker": "派蒙",
                    "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…"
                },
                {
                    "id": "790330104",
                    "speaker": "Player",
                    "text": "愚人众也要听睡前故事吗…"
                },
                {
                    "id": "790330105",
                    "speaker": "派蒙",
                    "text": "说不定愚人众里也有人有这种需要的嘛。"
                },
                {
                    "id": "790330106",
                    "speaker": "岩使游击兵的影像",
                    "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…"
                },
                {
                    "id": "790330107",
                    "speaker": "藏镜仕女的影像",
                    "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…"
                },
                {
                    "id": "790330108",
                    "speaker": "藏镜仕女的影像",
                    "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。"
                },
                {
                    "id": "790330109",
                    "speaker": "派蒙",
                    "text": "什么嘛，原来不是在讲故事呀…"
                },
                {
                    "id": "790330110",
                    "speaker": "派蒙",
                    "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
                }
            ]
        },
        {
            "id": "7903302",
            "objective": "监听是否获取海螺2号$HIDDEN",
            "dialogues": [
                {
                    "id": "790330201",
                    "speaker": "派蒙",
                    "text": "海螺居然能够从井中浮起来…",
                    "choices": [
                        {
                            "id": "790330202",
                            "text": "毕竟是被幻境影响的海螺…",
                            "response": [
                                {
                                    "id": "790330204",
                                    "speaker": "派蒙",
                                    "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！"
                                },
                                {
                                    "id": "790330205",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，你不要动，你的身后…",
                                    "choices": [
                                        {
                                            "id": "790330206",
                                            "text": "是、是什么可怕的东西吗…",
                                            "response": [
                                                {
                                                    "id": "790330208",
                                                    "speaker": "派蒙",
                                                    "text": "啊，仔细一看只是海螺产生的影像，突然出现在背后，真是吓了人一大跳呢！"
                                                },
                                                {
                                                    "id": "790330209",
                                                    "speaker": "岩使游击兵的影像",
                                                    "text": "信号测试器…两组…"
                                                },
                                                {
                                                    "id": "790330210",
                                                    "speaker": "雷锤前锋军的影像",
                                                    "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。"
                                                },
                                                {
                                                    "id": "790330211",
                                                    "speaker": "藏镜仕女的影像",
                                                    "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…"
                                                },
                                                {
                                                    "id": "790330212",
                                                    "speaker": "藏镜仕女的影像",
                                                    "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…"
                                                },
                                                {
                                                    "id": "790330213",
                                                    "speaker": "雷锤前锋军的影像",
                                                    "text": "家人吗…"
                                                },
                                                {
                                                    "id": "790330214",
                                                    "speaker": "派蒙",
                                                    "text": "嗯…总有种偷听到了不该偷听到的话的感觉…"
                                                },
                                                {
                                                    "id": "790330215",
                                                    "speaker": "派蒙",
                                                    "text": "影像里这几个人好像不是…「那么坏」的愚人众嘛…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790330207",
                                            "text": "不许故意吓人哦！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790330203",
                            "text": "大概壳中有空气…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7903303",
            "objective": "监听是否获取海螺2号$HIDDEN",
            "dialogues": [
                {
                    "id": "790330301",
                    "speaker": "派蒙",
                    "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？"
                },
                {
                    "id": "790330302",
                    "speaker": "派蒙",
                    "text": "总觉得是有点奇怪的影像呢…"
                },
                {
                    "id": "790330303",
                    "speaker": "水铳重卫士的影像",
                    "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。"
                },
                {
                    "id": "790330304",
                    "speaker": "岩使游击兵的影像",
                    "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…"
                },
                {
                    "id": "790330305",
                    "speaker": "岩使游击兵的影像",
                    "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…"
                },
                {
                    "id": "790330306",
                    "speaker": "水铳重卫士的影像",
                    "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！"
                },
                {
                    "id": "790330307",
                    "speaker": "派蒙",
                    "text": "他们指着那么高的地方，是想要吃什么啊…"
                },
                {
                    "id": "790330308",
                    "speaker": "派蒙",
                    "text": "难道这个海螺…放歪了？"
                }
            ]
        }
    ]
}