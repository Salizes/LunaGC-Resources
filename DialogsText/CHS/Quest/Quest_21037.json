            "芷若": 4
        }
    },
    "talks": [
        {
            "id": "2103701",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210370101",
                    "speaker": "孙宇",
                    "text": "璃月啊…璃月，不知我何时才能再回来了…"
                },
                {
                    "id": "210370102",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "210370103",
                    "speaker": "孙宇",
                    "text": "旅行者，是你啊…"
                },
                {
                    "id": "210370104",
                    "speaker": "孙宇",
                    "text": "是这样。我去枫丹的行程终于定下来了，过几天我就随着那位客商一起启程。"
                },
                {
                    "id": "210370105",
                    "speaker": "孙宇",
                    "text": "现在他还得处理一些商贸事务，我也趁着这个时间，最后再收拾收拾。",
                    "choices": [
                        {
                            "id": "210370106",
                            "text": "你不回绝云间看看？",
                            "response": [
                                {
                                    "id": "210370108",
                                    "speaker": "孙宇",
                                    "text": "呵呵，我要是再去周围看看，只怕我就狠不下心离开璃月了。"
                                },
                                {
                                    "id": "210370109",
                                    "speaker": "孙宇",
                                    "text": "我就在这里多看几眼城里就行。在这里生活了这么久，这次离开，也不知道什么时候才能再回来。"
                                },
                                {
                                    "id": "210370110",
                                    "speaker": "孙宇",
                                    "text": "哦对了，师妹她…最后还是没答应和我一起走，但我已经拜托芷若照顾她了。"
                                },
                                {
                                    "id": "210370111",
                                    "speaker": "孙宇",
                                    "text": "我也把一些钱财留给了她，师妹比我聪明，她会照顾好自己的。"
                                },
                                {
                                    "id": "210370112",
                                    "speaker": "孙宇",
                                    "text": "…也许未来有一天，她也会理解我的。"
                                },
                                {
                                    "id": "210370113",
                                    "speaker": "孙宇",
                                    "text": "对了旅行者，我还想再拜托你一件事。"
                                },
                                {
                                    "id": "210370114",
                                    "speaker": "孙宇",
                                    "text": "能不能请你帮我去拿一些「土」回来？",
                                    "choices": [
                                        {
                                            "id": "210370115",
                                            "text": "倒是没问题…",
                                            "response": [
                                                {
                                                    "id": "210370117",
                                                    "speaker": "孙宇",
                                                    "text": "游子离乡，多少得带点纪念走不是？"
                                                },
                                                {
                                                    "id": "210370118",
                                                    "speaker": "孙宇",
                                                    "text": "带一撮璃月的土在身边，我也勉强能算是没有和这片土地断了联系。"
                                                },
                                                {
                                                    "id": "210370119",
                                                    "speaker": "Player",
                                                    "text": "你怎么不自己去取？"
                                                },
                                                {
                                                    "id": "210370120",
                                                    "speaker": "孙宇",
                                                    "text": "哈哈哈…之前不是说了吗？要是我真去周围看一圈，再触景生情一下…"
                                                },
                                                {
                                                    "id": "210370121",
                                                    "speaker": "孙宇",
                                                    "text": "只怕我好不容易鼓起的这么一点离乡的勇气，就要烟消云散了。"
                                                },
                                                {
                                                    "id": "210370122",
                                                    "speaker": "孙宇",
                                                    "text": "所以这件取土的事，就拜托你了，旅行者。我把取土的位置给你标在地图上。"
                                                },
                                                {
                                                    "id": "210370123",
                                                    "speaker": "Player",
                                                    "text": "这个地方有什么特别的吗？"
                                                },
                                                {
                                                    "id": "210370124",
                                                    "speaker": "孙宇",
                                                    "text": "咳…我…我之前经常带着师妹在那里练剑…"
                                                },
                                                {
                                                    "id": "210370125",
                                                    "speaker": "孙宇",
                                                    "text": "总之！所以这件取土的事，就拜托你了，旅行者。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210370116",
                                            "text": "你要土做什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210370107",
                            "text": "你不再去周围看看？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103703",
            "objective": "帮助孙宇取土",
            "dialogues": [
                {
                    "id": "210370301",
                    "speaker": "孙宇",
                    "text": "多谢，这些就足够了。",
                    "choices": [
                        {
                            "id": "210370302",
                            "text": "你…看起来情绪不高。",
                            "response": [
                                {
                                    "id": "210370303",
                                    "speaker": "孙宇",
                                    "text": "啊？没事没事，哈哈哈…让你见笑了。"
                                },
                                {
                                    "id": "210370304",
                                    "speaker": "孙宇",
                                    "text": "只不过，突然要离开生活了这么久的璃月，我多少还是会有些不舍。"
                                }
                            ]
                        },
                        {
                            "id": "210370305",
                            "text": "你们什么时候出发？",
                            "response": [
                                {
                                    "id": "210370306",
                                    "speaker": "孙宇",
                                    "text": "等物资准备齐全之后，我们就会出发了。"
                                },
                                {
                                    "id": "210370307",
                                    "speaker": "孙宇",
                                    "text": "哦对了，之前和我一起去层岩巨渊的那位冒险家也会和我们同行。"
                                },
                                {
                                    "id": "210370308",
                                    "speaker": "孙宇",
                                    "text": "这位冒险家听说我要去枫丹，说自己也很有兴趣，于是就和我们一起走了。"
                                },
                                {
                                    "id": "210370309",
                                    "speaker": "孙宇",
                                    "text": "那位客商倒是很高兴多了个冒险家来保护他…但老实说，我真的不擅长和这种太过热情的人交流啊，唉…"
                                },
                                {
                                    "id": "210370310",
                                    "speaker": "孙宇",
                                    "text": "真没想到，我也会有离乡远行的一天…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103704",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210370401",
                    "speaker": "小雀儿",
                    "text": "芷若姐姐，你…你说师兄他是不是故意的！他就是…就是不想和我呆在一块！呜…"
                },
                {
                    "id": "210370402",
                    "speaker": "芷若",
                    "text": "师妹，你们朝夕相处，他又怎么可能不明白你的心意呢？"
                },
                {
                    "id": "210370403",
                    "speaker": "芷若",
                    "text": "他之所以要离开璃月外出游历，也是有自己的考量，你就是随他一起出行又有何妨？"
                },
                {
                    "id": "210370404",
                    "speaker": "小雀儿",
                    "text": "我就是不想离开璃月！我们俩就在这里呆着不好吗？古华派…管他古华派做什么…"
                },
                {
                    "id": "210370405",
                    "speaker": "芷若",
                    "text": "那你为什么不把这些话告诉他呢？"
                },
                {
                    "id": "210370406",
                    "speaker": "小雀儿",
                    "text": "我…我…我…师兄一心都是古华派…我要是对师兄说了这话，师兄讨厌我怎么办…"
                },
                {
                    "id": "210370407",
                    "speaker": "芷若",
                    "text": "唉，师妹啊…"
                }
            ]
        },
        {
            "id": "2103705",
            "objective": "与孙宇对话",
            "dialogues": []
        },
        {
            "id": "2103702",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210370201",
                    "speaker": "孙宇",
                    "text": "旅行者，你帮我把土取回来了吗？"
                },
                {
                    "id": "210370202",
                    "speaker": "Player",
                    "text": "取回来了。"
                }
            ]
        },
        {
            "id": "2103705",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210370501",
                    "speaker": "孙宇",
                    "text": "所以这件取土的事，就拜托你了，旅行者。"
                }
            ]
        }
    ]
}