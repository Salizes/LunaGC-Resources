{
    "quest": {
        "id": "21037",
        "title": "剑去之日",
        "description": "距离孙宇离开璃月港的日子，似乎越来越近了…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
