    "talks": [
        {
            "id": "1401301",
            "objective": "(test)隐藏任务用于孤儿NPC$HIDDEN",
            "dialogues": [
                {
                    "id": "140130101",
                    "speaker": "迪尔菲",
                    "text": "要说不遗憾是不可能的，但…"
                },
                {
                    "id": "140130102",
                    "speaker": "劳维克",
                    "text": "接下来还有很多机会，能演属于我们自己的故事呢。"
                }
            ]
        },
        {
            "id": "1401303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140130301",
                    "speaker": "波洛",
                    "text": "我收拾一下就要离开，等下还有「蒸汽鸟报」的采访。"
                },
                {
                    "id": "140130302",
                    "speaker": "波洛",
                    "text": "感谢你们的帮助，没有你们就不会有这么完美的演出。"
                },
                {
                    "id": "140130303",
                    "speaker": "波洛",
                    "text": "非常谢谢你们，能让我终于有机会和奥蕾丽告别…"
                }
            ]
        },
        {
            "id": "1401304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140130401",
                    "speaker": "芙宁娜",
                    "text": "或许我也曾向往过这种力量，但那更像是一种讽刺。"
                },
                {
                    "id": "140130402",
                    "speaker": "芙宁娜",
                    "text": "现在…虽然还是「神」的馈赠，我却有将命运握在自己手中的感觉。"
                },
                {
                    "id": "140130403",
                    "speaker": "芙宁娜",
                    "text": "人类，也是如此吗？"
                }
            ]
        },
        {
            "id": "1401305",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140130501",
                    "speaker": "比罗",
                    "text": "放松下来之后，感觉快要晕过去了。"
                }
            ]
        },
        {
            "id": "1401306",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "140130601",
                    "speaker": "埃兰",
                    "text": "谢谢你们的帮助，我好像也找回了刚加入剧团时的那种动力。"
                },
                {
                    "id": "140130602",
                    "speaker": "埃兰",
                    "text": "也许已经太迟了吧，但至少这次经历，终身难忘。"
                }
            ]
        }
    ]
