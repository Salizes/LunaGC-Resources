    "talks": [
        {
            "id": "7052501",
            "objective": "",
            "dialogues": [
                {
                    "id": "705250101",
                    "speaker": "伽禄",
                    "text": "哼，我一定会像追击猎物那样，逐渐击败所有的敌人，成为最强的「七圣召唤」牌手…"
                },
                {
                    "id": "705250102",
                    "speaker": "伽禄",
                    "text": "嗯？你也对「七圣召唤」感兴趣吗？不过现在的你还不是牌手吧。"
                },
                {
                    "id": "705250103",
                    "speaker": "伽禄",
                    "text": "哼哼，等你成为牌手了，或许有一天，我会出现在你的牌桌之前…"
                }
            ]
        },
        {
            "id": "7052502",
            "objective": "",
            "dialogues": [
                {
                    "id": "705250201",
                    "speaker": "阿特拉",
                    "text": "你也想成为牌手吗，如果你也想成为牌手的话，就得记好了！"
                },
                {
                    "id": "705250202",
                    "speaker": "阿特拉",
                    "text": "最后成为「七圣召唤」之王的人，一定是我！"
                }
            ]
        },
        {
            "id": "7052503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705250301",
                    "speaker": "贝莲",
                    "text": "怎么了，要来打一局牌吗…啊，抱歉，你现在还不是牌手吧。"
                },
                {
                    "id": "705250302",
                    "speaker": "贝莲",
                    "text": "等你成为牌手之后再来找我吧…或许，我能够从你在牌局里犯下的过错中学习到什么呢…"
                }
            ]
        },
        {
            "id": "7052504",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705250401",
                    "speaker": "马克利",
                    "text": "是要成为牌手的新人吗…具体的规则倒是可以去问恕筠，不过如果有其他想要了解的…"
                },
                {
                    "id": "705250402",
                    "speaker": "马克利",
                    "text": "欢迎到时候来找我哦。"
                }
            ]
        },
        {
            "id": "7052505",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705250501",
                    "speaker": "七夜由美",
                    "text": "「七圣召唤」，其中有些牌上的画很好看吧，我在收集好看的牌。"
                },
                {
                    "id": "705250502",
                    "speaker": "七夜由美",
                    "text": "美丽，也是另外一种胜利呢！"
                }
            ]
        }
    ]
