    "talks": [
        {
            "id": "7415309",
            "objective": "(test)时间经过$HIDDEN",
            "dialogues": [
                {
                    "id": "741530901",
                    "speaker": "门",
                    "text": "（已经决定自行调查勒鲁瓦家的奇怪状况了，现在敲门似乎会打草惊蛇。）"
                },
                {
                    "id": "741530902",
                    "speaker": "门",
                    "text": "（等到掌握更多信息后再来敲门吧。）"
                }
            ]
        },
        {
            "id": "7415301",
            "objective": "前往伯努瓦家附近调查",
            "dialogues": [
                {
                    "id": "741530101",
                    "speaker": "皮普",
                    "text": "有没有人啊，报纸不要了吗？喂，应下门啊。"
                },
                {
                    "id": "741530102",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "741530103",
                    "speaker": "Player",
                    "text": "伯努瓦不在家吗？"
                },
                {
                    "id": "741530104",
                    "speaker": "皮普",
                    "text": "我哪儿知道，怪得很，自己订的报纸自己不来拿。"
                },
                {
                    "id": "741530105",
                    "speaker": "皮普",
                    "text": "以前我送报到门口，勒鲁瓦先生至少会应一声，最近完全看不到他人。"
                },
                {
                    "id": "741530106",
                    "speaker": "皮普",
                    "text": "我这儿已经堆了好几份他订的蒸汽鸟报了，你们认识他是吧？"
                },
                {
                    "id": "741530107",
                    "speaker": "派蒙",
                    "text": "对，对，我们是伯努瓦的好朋友。"
                },
                {
                    "id": "741530108",
                    "speaker": "皮普",
                    "text": "好朋友？…行吧，要不我把报纸交给你们，你们见到他的时候帮我转交？",
                    "choices": [
                        {
                            "id": "741530109",
                            "text": "好的，给我们吧。",
                            "response": [
                                {
                                    "id": "741530111",
                                    "speaker": "皮普",
                                    "text": "我也算尽力了，别回头怪我没送报纸上门，我还有其他事要忙呢。"
                                },
                                {
                                    "id": "741530112",
                                    "speaker": "派蒙",
                                    "text": "但最近我们也几乎见不到他本人…"
                                },
                                {
                                    "id": "741530113",
                                    "speaker": "皮普",
                                    "text": "你们也找不到他？勒鲁瓦先生到底在忙些什么啊，难道回老房子住去了？没听说啊…"
                                },
                                {
                                    "id": "741530114",
                                    "speaker": "Player",
                                    "text": "老房子？"
                                },
                                {
                                    "id": "741530115",
                                    "speaker": "皮普",
                                    "text": "对啊，他在灰河的老房子。"
                                },
                                {
                                    "id": "741530116",
                                    "speaker": "派蒙",
                                    "text": "伯努瓦以前是住在灰河的啊！"
                                },
                                {
                                    "id": "741530117",
                                    "speaker": "皮普",
                                    "text": "他是从灰河搬上来的你们都不知道，你们真是他的朋友吗？"
                                },
                                {
                                    "id": "741530118",
                                    "speaker": "派蒙",
                                    "text": "呃…我们…"
                                },
                                {
                                    "id": "741530119",
                                    "speaker": "皮普",
                                    "text": "行了行了，不用解释，你们跟他怎么回事我一点都不关心。"
                                },
                                {
                                    "id": "741530120",
                                    "speaker": "皮普",
                                    "text": "只要把报纸送到我就谢谢你们了，好了，你们拿着吧，我走了。"
                                },
                                {
                                    "id": "741530121",
                                    "speaker": "派蒙",
                                    "text": "感觉伯努瓦身上还有很多我们完全不了解的事，你觉得这会和我们要调查的事情有关吗？",
                                    "choices": [
                                        {
                                            "id": "741530122",
                                            "text": "很可能有关。",
                                            "response": [
                                                {
                                                    "id": "741530124",
                                                    "speaker": "派蒙",
                                                    "text": "好，那接下来我们在伯努瓦家附近稍微调查一下吧，说不定能了解更多关于伯努瓦的事。"
                                                },
                                                {
                                                    "id": "741530125",
                                                    "speaker": "派蒙",
                                                    "text": "不过我们的动静得小点儿，不然会引起那对夫妻的警觉。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741530123",
                                            "text": "信息越多越好。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741530110",
                            "text": "派蒙拿着吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7415302",
            "objective": "在伯努瓦家附近调查",
            "dialogues": []
        },
        {
            "id": "7415303",
            "objective": "(test)脏箱子$HIDDEN",
            "dialogues": [
                {
                    "id": "741530301",
                    "speaker": "奇怪的箱子",
                    "text": "（曾在伯努瓦家附近见过的箱子，从箱子上灰尘的痕迹来看，它们最近似乎被开启过。）"
                },
                {
                    "id": "741530302",
                    "speaker": "奇怪的箱子",
                    "text": "（走近后你能嗅到鱼腥味和水腥气，但这些天你路过时，箱子完全没有被挪动过。这气味是哪里来的？）"
                },
                {
                    "id": "741530303",
                    "speaker": "派蒙",
                    "text": "这股臭水沟一样的味道…呕…前几天过来的时候，明明没有这股气味，伯努瓦不是说这里只装了旧家具吗？"
                },
                {
                    "id": "741530304",
                    "speaker": "派蒙",
                    "text": "怎么会有这么难闻的气味，这里面又新装了些什么东西啊…欸，箱子开口露出来一张纸，让我看看。"
                },
                {
                    "id": "741530305",
                    "speaker": "派蒙",
                    "text": "这张收据被撕坏了，只有一半。唔，布莱卡利杂货店…这名字好像在哪里看过，总觉得有点熟悉。"
                }
            ]
        },
        {
            "id": "7415304",
            "objective": "(test)奇怪的痕迹$HIDDEN",
            "dialogues": [
                {
                    "id": "741530401",
                    "speaker": "奇怪的痕迹",
                    "text": "（抚摸起来有种光滑油润的触感，你确定这是蜡烛留下的痕迹。）"
                },
                {
                    "id": "741530402",
                    "speaker": "奇怪的痕迹",
                    "text": "（有谁持蜡烛在箱子附近逗留过，又是为了什么？）"
                }
            ]
        },
        {
            "id": "7415312",
            "objective": "",
            "dialogues": [
                {
                    "id": "741531201",
                    "speaker": "Player",
                    "text": "关于你们发现的收据…"
                },
                {
                    "id": "741531202",
                    "speaker": "布莱卡利",
                    "text": "最近卖出去的钳子、锯子、还有蜡烛？哎哟，真是奇怪的问题。"
                },
                {
                    "id": "741531203",
                    "speaker": "布莱卡利",
                    "text": "你要买点心调料我有的是，需要这种东西我可难办了，货不多。"
                },
                {
                    "id": "741531204",
                    "speaker": "派蒙",
                    "text": "不是我们想要买这些，奶奶，我们是想问这几天有没有人来找你买过这些东西。"
                },
                {
                    "id": "741531205",
                    "speaker": "布莱卡利",
                    "text": "我想想，嗯…还真有。"
                },
                {
                    "id": "741531206",
                    "speaker": "布莱卡利",
                    "text": "前些天正好有两个年轻人，一男一女，到我这儿买了这些东西。"
                },
                {
                    "id": "741531207",
                    "speaker": "布莱卡利",
                    "text": "说是家里要做木工活，缺点工具，怎么了吗？"
                },
                {
                    "id": "741531208",
                    "speaker": "派蒙",
                    "text": "没事没事，我、我们在做社会经济情况调研。"
                },
                {
                    "id": "741531209",
                    "speaker": "布莱卡利",
                    "text": "社会经济情况调研？呵呵，你们是来打听人的吧。"
                },
                {
                    "id": "741531210",
                    "speaker": "布莱卡利",
                    "text": "这种事我见得多了，小家伙，你也不用费劲想借口了。"
                },
                {
                    "id": "741531211",
                    "speaker": "布莱卡利",
                    "text": "他们两个去了伯努瓦的老房子，如果你们想知道的是这件事的话。"
                },
                {
                    "id": "741531212",
                    "speaker": "Player",
                    "text": "关于伯努瓦·勒鲁瓦…"
                },
                {
                    "id": "741531213",
                    "speaker": "布莱卡利",
                    "text": "原来你们是冲着伯努瓦来的，不意外。"
                },
                {
                    "id": "741531214",
                    "speaker": "布莱卡利",
                    "text": "人到了一定年纪，过去就会找上门来，不管搬到哪里都一样。"
                },
                {
                    "id": "741531215",
                    "speaker": "派蒙",
                    "text": "奶奶你知道些什么吗？"
                },
                {
                    "id": "741531216",
                    "speaker": "布莱卡利",
                    "text": "我？我和伯努瓦不熟，如果你们想打听伯努瓦家的事，应该找史诺德格拉斯问。"
                },
                {
                    "id": "741531217",
                    "speaker": "布莱卡利",
                    "text": "去吧，史诺德格拉斯这家伙游手好闲的，这会儿应该就在这附近闲逛。"
                }
            ]
        },
        {
            "id": "7415310",
            "objective": "(test)回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "741531001",
                    "speaker": "Player",
                    "text": "关于伯努瓦·勒鲁瓦…"
                },
                {
                    "id": "741531002",
                    "speaker": "阿蕾妲",
                    "text": "的确是听说过这个名字，不过他很久之前就搬走了，而且我们也很少打交道。"
                },
                {
                    "id": "741531003",
                    "speaker": "阿蕾妲",
                    "text": "我不太熟悉这个人，你找别人问问看？"
                }
            ]
        },
        {
            "id": "7415305",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "741530501",
                    "speaker": "派蒙",
                    "text": "那个箱子怎么看都不像是该在这里出现的东西，而且好臭…"
                },
                {
                    "id": "741530502",
                    "speaker": "Player",
                    "text": "恐怕是灰河来的东西。"
                },
                {
                    "id": "741530503",
                    "speaker": "派蒙",
                    "text": "也就是说，最近伯努瓦家有人去过灰河，而且伯努瓦又曾经住在灰河…"
                },
                {
                    "id": "741530504",
                    "speaker": "派蒙",
                    "text": "#所有的线索都和灰河有关，{NICKNAME}，我们要不要去灰河看看，应该能了解更多有用的信息。"
                },
                {
                    "id": "741530505",
                    "speaker": "Player",
                    "text": "走吧。"
                },
                {
                    "id": "741530506",
                    "speaker": "派蒙",
                    "text": "我们去灰河！"
                }
            ]
        },
        {
            "id": "7415306",
            "objective": "前往灰河",
            "dialogues": []
        },
        {
            "id": "7415311",
            "objective": "寻找鱼摊",
            "dialogues": [
                {
                    "id": "741531101",
                    "speaker": "Player",
                    "text": "关于伯努瓦·勒鲁瓦…"
                },
                {
                    "id": "741531102",
                    "speaker": "法斯捷",
                    "text": "听说过，不熟。"
                }
            ]
        },
        {
            "id": "7415307",
            "objective": "询问路人",
            "dialogues": [
                {
                    "id": "741530701",
                    "speaker": "史诺德格拉斯",
                    "text": "啊，好无聊啊…不想工作…我什么时候能暴富…"
                },
                {
                    "id": "741530702",
                    "speaker": "Player",
                    "text": "关于伯努瓦·勒鲁瓦…"
                },
                {
                    "id": "741530703",
                    "speaker": "史诺德格拉斯",
                    "text": "…勒鲁瓦？这名字似乎在哪儿听过，让我想想…"
                },
                {
                    "id": "741530704",
                    "speaker": "史诺德格拉斯",
                    "text": "哦，我想起来了，伯努瓦·勒鲁瓦，杂货摊的摊主大叔。"
                },
                {
                    "id": "741530705",
                    "speaker": "史诺德格拉斯",
                    "text": "怎么了？你们是谁？打听这个做什么？"
                },
                {
                    "id": "741530706",
                    "speaker": "派蒙",
                    "text": "其实我们只是…",
                    "choices": [
                        {
                            "id": "741530707",
                            "text": "他的情况比较复杂。",
                            "response": [
                                {
                                    "id": "741530709",
                                    "speaker": "史诺德格拉斯",
                                    "text": "啊，这…难道…他是不是犯什么事了？"
                                },
                                {
                                    "id": "741530710",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "741530711",
                                    "speaker": "史诺德格拉斯",
                                    "text": "懂了懂了…但我还是忍不住想多问一句，你们是刺玫会来的还是执律庭来的？"
                                },
                                {
                                    "id": "741530712",
                                    "speaker": "Player",
                                    "text": "你有权保持沉默…"
                                },
                                {
                                    "id": "741530713",
                                    "speaker": "Player",
                                    "text": "你的每句话将作为呈堂证供…"
                                },
                                {
                                    "id": "741530714",
                                    "speaker": "派蒙",
                                    "text": "#（{NICKNAME}也太会演了，不愧是你。）"
                                },
                                {
                                    "id": "741530715",
                                    "speaker": "史诺德格拉斯",
                                    "text": "好好好，明白了，我不问了。他发财的手段又不光彩，枫丹法条那么多，他肯定违反其中某一条了！"
                                },
                                {
                                    "id": "741530716",
                                    "speaker": "史诺德格拉斯",
                                    "text": "长官，你们找对了人。我告诉你们，这家人我再熟不过了，伯努瓦这个坏东西烂事没少干。"
                                },
                                {
                                    "id": "741530717",
                                    "speaker": "史诺德格拉斯",
                                    "text": "哦，我都到了结婚成家的年纪，他应该已经老了吧。"
                                },
                                {
                                    "id": "741530718",
                                    "speaker": "史诺德格拉斯",
                                    "text": "我记得他的女儿小秋很漂亮，嘿嘿，可惜他从来不让我们跟小秋说话。"
                                },
                                {
                                    "id": "741530719",
                                    "speaker": "Player",
                                    "text": "小秋？"
                                },
                                {
                                    "id": "741530720",
                                    "speaker": "史诺德格拉斯",
                                    "text": "没错，秋·勒鲁瓦，伯努瓦·勒鲁瓦的养女。"
                                },
                                {
                                    "id": "741530721",
                                    "speaker": "史诺德格拉斯",
                                    "text": "你仔细想一想，他本来只是一个卖杂货的，赚点小钱而已，怎么可能突然暴富，搬到上面住？"
                                },
                                {
                                    "id": "741530722",
                                    "speaker": "史诺德格拉斯",
                                    "text": "还不是靠他的女儿小秋，那么漂亮的年轻女孩，他硬是让她嫁给了一个有钱的老头。"
                                },
                                {
                                    "id": "741530723",
                                    "speaker": "史诺德格拉斯",
                                    "text": "才几年老头就死啦，老头的房子当然就归小秋了，小秋的就是他的，这下他不就一口气成为「上面人」了吗？"
                                },
                                {
                                    "id": "741530724",
                                    "speaker": "史诺德格拉斯",
                                    "text": "啧啧，这种一夜暴富的好事怎么就落在他头上了，啊呸，我是说这个老东西吸自己女儿的血，太坏了！"
                                },
                                {
                                    "id": "741530725",
                                    "speaker": "派蒙",
                                    "text": "（怎么还有这种事情？）"
                                },
                                {
                                    "id": "741530726",
                                    "speaker": "Player",
                                    "text": "（我们继续问他。）"
                                },
                                {
                                    "id": "741530727",
                                    "speaker": "史诺德格拉斯",
                                    "text": "长官，你们就是来打探这些事的吗？"
                                },
                                {
                                    "id": "741530728",
                                    "speaker": "史诺德格拉斯",
                                    "text": "我是说，要是这些破事对你们有用的话，我是不是也为枫丹的社会安全做出了贡献？"
                                },
                                {
                                    "id": "741530729",
                                    "speaker": "史诺德格拉斯",
                                    "text": "作为一个对社会有贡献的市民，执律庭会不会有嘉奖我的打算？",
                                    "choices": [
                                        {
                                            "id": "741530730",
                                            "text": "这些事我们已经知道了。",
                                            "response": [
                                                {
                                                    "id": "741530731",
                                                    "speaker": "史诺德格拉斯",
                                                    "text": "别急别急，我还有其他的事情可以说。毕竟住在灰河，要是不知道别人一两个秘密，睡觉都不安稳，嘿嘿。"
                                                },
                                                {
                                                    "id": "741530734",
                                                    "speaker": "史诺德格拉斯",
                                                    "text": "小秋的第二个丈夫，是的，她很快就再嫁了，这次嫁得比较远，我们都没有再见过她。"
                                                },
                                                {
                                                    "id": "741530735",
                                                    "speaker": "史诺德格拉斯",
                                                    "text": "等到我们再听说小秋的消息，她已经犯了那种事了。"
                                                },
                                                {
                                                    "id": "741530736",
                                                    "speaker": "派蒙",
                                                    "text": "那种事是哪种事？"
                                                },
                                                {
                                                    "id": "741530737",
                                                    "speaker": "史诺德格拉斯",
                                                    "text": "长官不知道吗？小秋杀了她的第二任丈夫，被判到梅洛彼得堡去了啊。你们来查伯努瓦却不知道这事吗？",
                                                    "choices": [
                                                        {
                                                            "id": "741530738",
                                                            "text": "这里有涉案人员记录，派蒙队员。",
                                                            "response": [
                                                                {
                                                                    "id": "741530740",
                                                                    "speaker": "派蒙",
                                                                    "text": "#啊…啊抱歉，{NICKNAME}队长，下次我不会再这样了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741530741",
                                                                            "text": "继续说。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741530743",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "对对，我正要说。我也是听别人说的，据说审判小秋的时候，小秋申请让伯努瓦出庭，但他拒绝了。"
                                                                                },
                                                                                {
                                                                                    "id": "741530744",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "伯努瓦没结婚，只有小秋这一个女儿，哦对了，我记得她是过继来的女儿，跟伯努瓦还算有那么点血缘的。"
                                                                                },
                                                                                {
                                                                                    "id": "741530745",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "反正唯一的父亲都没有出庭作证，小秋会直接被判梅洛彼得堡也很正常嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "741530746",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "这老坏蛋是为了独吞房产，还是因为跟女儿有什么冲突才没有出庭，我就不乱猜了，嘿嘿。"
                                                                                },
                                                                                {
                                                                                    "id": "741530747",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "他平时看起来很和善吧？我记得他还给过我点心吃，谁知道他私底下这么冷血。"
                                                                                },
                                                                                {
                                                                                    "id": "741530748",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "长官您真镇定，听这么半天眉头都不皱，这你们都不觉得冷血吗？我以为我还挺冷血的，你们比我厉害多了。"
                                                                                },
                                                                                {
                                                                                    "id": "741530749",
                                                                                    "speaker": "Player",
                                                                                    "text": "公事公办。"
                                                                                },
                                                                                {
                                                                                    "id": "741530750",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "太专业了，令人肃然起敬。所以长官们，伯努瓦犯的罪严重吗？"
                                                                                },
                                                                                {
                                                                                    "id": "741530751",
                                                                                    "speaker": "Player",
                                                                                    "text": "无可奉告。"
                                                                                },
                                                                                {
                                                                                    "id": "741530752",
                                                                                    "speaker": "史诺德格拉斯",
                                                                                    "text": "哈，严重到无可奉告…那他的房子会被收走吗？",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "741530753",
                                                                                            "text": "或许吧。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "741530755",
                                                                                                    "speaker": "史诺德格拉斯",
                                                                                                    "text": "啊哈，我就知道，老鼠就是老鼠，爬到上面还是老鼠。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "741530756",
                                                                                                    "speaker": "史诺德格拉斯",
                                                                                                    "text": "谢谢两位长官给我带来美好的一天，期待下次在灰河再看见两位，嘿嘿。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "741530757",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "怎么说呢…我现在心情有点复杂，本来我对伯努瓦的印象还挺好的…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "741530758",
                                                                                                            "text": "人不可貌相。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "741530759",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "唉，我是不是太笨了，完全没看出来他是这样的人。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "741530763",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "这些复杂的事情够我们消化一阵子了，我总感觉心里怪怪的，不想在灰河再呆下去了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "741530764",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "走吧。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "741530765",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "嗯，去晒晒太阳。"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "741530760",
                                                                                                            "text": "不用听信路人一面之词。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "741530761",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "你说的对，但我现在也没法完全相信伯努瓦了…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "741530762",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "好讨厌这种感觉，不过幸好我还能相信你。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "741530754",
                                                                                            "text": "有可能。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741530742",
                                                                            "text": "秘密呢？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741530739",
                                                            "text": "你没有仔细研究卷宗，我很失望。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741530732",
                                            "text": "要看你能提供些什么。",
                                            "response": [
                                                {
                                                    "id": "741530733",
                                                    "speaker": "史诺德格拉斯",
                                                    "text": "那我能说的可就太多了，毕竟住在灰河，要是不知道别人一两个秘密，睡觉都不安稳，嘿嘿。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741530708",
                            "text": "请配合我们工作。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7415308",
            "objective": "离开灰河",
            "dialogues": [
                {
                    "id": "741530801",
                    "speaker": "阿托斯",
                    "text": "灰河这一带的味道不太好闻，不像「上面」，连空气里都有一股香水味。"
                },
                {
                    "id": "741530802",
                    "speaker": "阿托斯",
                    "text": "怎么样？在灰河逛得开心吗？相信你们跟史诺德格拉斯聊得很愉快。"
                },
                {
                    "id": "741530803",
                    "speaker": "派蒙",
                    "text": "你、你跟踪我们？"
                },
                {
                    "id": "741530804",
                    "speaker": "Player",
                    "text": "什么时候？"
                },
                {
                    "id": "741530805",
                    "speaker": "阿托斯",
                    "text": "我没有闲心思跟多管闲事的孩子斗嘴。唉，就算让你们回家找父母去，你们应该也不会听。"
                },
                {
                    "id": "741530806",
                    "speaker": "阿托斯",
                    "text": "听我说，有时候眼睛看到的和耳朵听到的未必就是真的、对的。"
                },
                {
                    "id": "741530807",
                    "speaker": "阿托斯",
                    "text": "别人家的事情，你还没弄明白之前不要总想着乱掺和。"
                },
                {
                    "id": "741530808",
                    "speaker": "阿托斯",
                    "text": "对了，皮普说这段时间我家里订的报纸都在你们手上，请还给我们吧。"
                },
                {
                    "id": "741530809",
                    "speaker": "Black Screen",
                    "text": "你不得不将报纸交还给了阿托斯。"
                },
                {
                    "id": "741530810",
                    "speaker": "Black Screen",
                    "text": "他冷冷地看了你们一眼，转身离去。"
                },
                {
                    "id": "741530811",
                    "speaker": "派蒙",
                    "text": "这个家伙给我的感觉好不舒服…",
                    "choices": [
                        {
                            "id": "741530812",
                            "text": "我有同感。",
                            "response": [
                                {
                                    "id": "741530814",
                                    "speaker": "派蒙",
                                    "text": "啊，好讨厌，虽然发现了点什么，但完全串不起来。"
                                },
                                {
                                    "id": "741530815",
                                    "speaker": "派蒙",
                                    "text": "而且…而且我感觉有点混乱，伯努瓦是正受到威胁的好人，我们应该帮助他，是这样没错吧？",
                                    "choices": [
                                        {
                                            "id": "741530816",
                                            "text": "谨慎观察。",
                                            "response": [
                                                {
                                                    "id": "741530819",
                                                    "speaker": "派蒙",
                                                    "text": "是吗？这样就可以了吗？"
                                                },
                                                {
                                                    "id": "741530820",
                                                    "speaker": "派蒙",
                                                    "text": "这几天总是有推翻我想法的事情发生，脑子根本不够用。"
                                                },
                                                {
                                                    "id": "741530821",
                                                    "speaker": "派蒙",
                                                    "text": "但是你真的好冷静，一点都不慌张。我是不是其实有点笨，你不会嫌弃我吧？",
                                                    "choices": [
                                                        {
                                                            "id": "741530822",
                                                            "text": "不会嫌弃派蒙。",
                                                            "response": [
                                                                {
                                                                    "id": "741530823",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯，我就知道，你最好了。{NICKNAME}是天底下最最最可靠的人，幸好有你！"
                                                                },
                                                                {
                                                                    "id": "741530826",
                                                                    "speaker": "派蒙",
                                                                    "text": "这么一想，说不定我其实相当聪明，只是一时没有理解状况而已。哼哼，一定是这样！"
                                                                },
                                                                {
                                                                    "id": "741530827",
                                                                    "speaker": "派蒙",
                                                                    "text": "让聪明的派蒙来想想下一步该怎么办…嗯，我们是不是那个…打草惊蛇了？"
                                                                },
                                                                {
                                                                    "id": "741530828",
                                                                    "speaker": "派蒙",
                                                                    "text": "这样的话，我们就应该过一阵子再来看看伯努瓦家有没有什么新情况，对吧？"
                                                                },
                                                                {
                                                                    "id": "741530829",
                                                                    "speaker": "Player",
                                                                    "text": "只能这样了。"
                                                                },
                                                                {
                                                                    "id": "741530830",
                                                                    "speaker": "派蒙",
                                                                    "text": "好，我们过一阵子再来吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741530824",
                                                            "text": "派蒙不笨。",
                                                            "response": [
                                                                {
                                                                    "id": "741530825",
                                                                    "speaker": "派蒙",
                                                                    "text": "真的吗？连你都这么说，我肯定就是不笨。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741530817",
                                            "text": "小心行动。"
                                        },
                                        {
                                            "id": "741530818",
                                            "text": "先不要急着下判断。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741530813",
                            "text": "他们在计划着什么…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7415104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741510401",
                    "speaker": "门",
                    "text": "屋内静悄悄的没有声响，无人说话，也没有脚步声。"
                },
                {
                    "id": "741510402",
                    "speaker": "门",
                    "text": "伯努瓦一家安静得有些异常，这几乎像是所空房子。"
                }
            ]
        },
        {
            "id": "7415399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741539901",
                    "speaker": "派蒙",
                    "text": "我们只知道伯努瓦曾经在灰河居住过，连他住在哪间屋子都不知道…"
                },
                {
                    "id": "741539902",
                    "speaker": "派蒙",
                    "text": "要是有什么线索能帮我们缩小范围就好了…"
                }
            ]
        }
    ]
}