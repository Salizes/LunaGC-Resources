    "talks": [
        {
            "id": "7109901",
            "objective": "与刘苏对话",
            "dialogues": [
                {
                    "id": "710990101",
                    "speaker": "茶博士刘苏",
                    "text": "嘿呀，晦气！不讲了，我今天绝对不讲了。"
                },
                {
                    "id": "710990102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "710990103",
                    "speaker": "茶博士刘苏",
                    "text": "这个小戏台子太气人，几十年了都没修过，台上的人稍微一动弹，它就要嘎吱嘎吱响。"
                },
                {
                    "id": "710990104",
                    "speaker": "茶博士刘苏",
                    "text": "老早就跟我们东家范二爷说了这戏台得换新的，他总找借口说没有好木匠，不乐意换。"
                },
                {
                    "id": "710990105",
                    "speaker": "茶博士刘苏",
                    "text": "今天我正在台上讲《海山履云记》呢，我这摆个架势它就要嘎吱一声。"
                },
                {
                    "id": "710990106",
                    "speaker": "茶博士刘苏",
                    "text": "别提多破坏气氛了，台下观众都乐了，还有几个坏东西给我喝倒彩。"
                },
                {
                    "id": "710990107",
                    "speaker": "茶博士刘苏",
                    "text": "我今天不忍了，一定得找个好木匠，直接带到二爷跟前，看他还有什么理由不换。"
                },
                {
                    "id": "710990108",
                    "speaker": "茶博士刘苏",
                    "text": "我记得你是冒险家协会的对吧，我直接委托你也是一样的，你帮我找个木匠行不行？",
                    "choices": [
                        {
                            "id": "710990109",
                            "text": "怎么找？",
                            "response": [
                                {
                                    "id": "710990111",
                                    "speaker": "茶博士刘苏",
                                    "text": "也是，一看你就不是璃月人，你哪儿认识好木匠。"
                                },
                                {
                                    "id": "710990112",
                                    "speaker": "茶博士刘苏",
                                    "text": "这样吧，轻策庄「范木堂」路爷的手艺特别出名，请你代我问问他老人家愿不愿意来帮这个忙。"
                                },
                                {
                                    "id": "710990113",
                                    "speaker": "茶博士刘苏",
                                    "text": "要是他没有空，派个徒弟来也行。"
                                },
                                {
                                    "id": "710990114",
                                    "speaker": "茶博士刘苏",
                                    "text": "让范木堂的木匠给我们造戏台肯定是够了，要是造得好，以后云老板来登台我们也有面子。"
                                },
                                {
                                    "id": "710990115",
                                    "speaker": "茶博士刘苏",
                                    "text": "哎呀绝了，我这个理由想得可太好了，不由得二爷不答应哈哈。"
                                },
                                {
                                    "id": "710990116",
                                    "speaker": "茶博士刘苏",
                                    "text": "你放心，要是能把木匠带回来，酬金肯定不会拖欠你的。"
                                },
                                {
                                    "id": "710990117",
                                    "speaker": "Player",
                                    "text": "明白了。"
                                },
                                {
                                    "id": "710990118",
                                    "speaker": "茶博士刘苏",
                                    "text": "那就靠你了，我每天都在茶馆，有结果了回来找我就成。"
                                }
                            ]
                        },
                        {
                            "id": "710990110",
                            "text": "找哪个木匠？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7109902",
            "objective": "前往轻策庄寻找路爷",
            "dialogues": [
                {
                    "id": "710990201",
                    "speaker": "茶博士刘苏",
                    "text": "二爷哟，再不上点儿心，生意都要被三碗不过港全抢啦。"
                }
            ]
        },
        {
            "id": "7109903",
            "objective": "与路爷对话",
            "dialogues": [
                {
                    "id": "710990301",
                    "speaker": "路爷",
                    "text": "这年轻人，风尘仆仆的，急什么，坐下来喝杯茶嘛。",
                    "choices": [
                        {
                            "id": "710990302",
                            "text": "路爷…",
                            "response": [
                                {
                                    "id": "710990304",
                                    "speaker": "Black Screen",
                                    "text": "向路爷解释了刘苏的委托…"
                                },
                                {
                                    "id": "710990305",
                                    "speaker": "路爷",
                                    "text": "哦哦，造新戏台不难，但找我是找错人喽。"
                                },
                                {
                                    "id": "710990306",
                                    "speaker": "路爷",
                                    "text": "轻策庄到璃月港那么远呢，我去璃月港了谁来照看「范木堂」呀？"
                                },
                                {
                                    "id": "710990307",
                                    "speaker": "路爷",
                                    "text": "更何况我这老胳膊老腿，哪儿走得动那么远的路，年纪大啦，经不起折腾。",
                                    "choices": [
                                        {
                                            "id": "710990308",
                                            "text": "那不麻烦范木堂了。",
                                            "response": [
                                                {
                                                    "id": "710990310",
                                                    "speaker": "路爷",
                                                    "text": "哎别急啊，你都大老远来一趟了，我给你推荐个能干又利索的人吧。"
                                                },
                                                {
                                                    "id": "710990311",
                                                    "speaker": "路爷",
                                                    "text": "他虽然还不是我的徒弟，但我有心…"
                                                },
                                                {
                                                    "id": "710990312",
                                                    "speaker": "大雨",
                                                    "text": "路爷，村长要的椅子一套四只，除了最后一只木头不够，其他我都打好了。"
                                                },
                                                {
                                                    "id": "710990313",
                                                    "speaker": "若心",
                                                    "text": "辛苦大雨帮村子里干活了。"
                                                },
                                                {
                                                    "id": "710990314",
                                                    "speaker": "路爷",
                                                    "text": "正好，说到他他就到。我刚才是想说，你找大雨也是一样的。"
                                                },
                                                {
                                                    "id": "710990315",
                                                    "speaker": "大雨",
                                                    "text": "找我？路爷还没收我当徒弟呢，我可不能代表范木堂。"
                                                },
                                                {
                                                    "id": "710990316",
                                                    "speaker": "路爷",
                                                    "text": "就你话多，人家是代璃月港的和裕茶馆来的，要请我们上门去造个新戏台。"
                                                },
                                                {
                                                    "id": "710990317",
                                                    "speaker": "大雨",
                                                    "text": "哦，请「我们」去造戏台？我跟路爷合起来算是「我们」，村长奶奶您听见了吧？"
                                                },
                                                {
                                                    "id": "710990318",
                                                    "speaker": "若心",
                                                    "text": "听见了，呵呵老路啊，大雨这孩子放着别的木匠师傅不跟，跑到范木堂跟着你学。"
                                                },
                                                {
                                                    "id": "710990319",
                                                    "speaker": "若心",
                                                    "text": "他做事又快又好心还诚，你也差不多得了，收了人家当徒弟吧。"
                                                },
                                                {
                                                    "id": "710990320",
                                                    "speaker": "路爷",
                                                    "text": "知道了知道了，我都让他代我上门给人家干活了，我这什么意思你们还不明白吗？"
                                                },
                                                {
                                                    "id": "710990321",
                                                    "speaker": "大雨",
                                                    "text": "谢谢师父！"
                                                },
                                                {
                                                    "id": "710990322",
                                                    "speaker": "路爷",
                                                    "text": "大雨，师父给你派的第一件活就是给和裕茶馆造戏台，好好干，不要丢了我的脸。"
                                                },
                                                {
                                                    "id": "710990323",
                                                    "speaker": "大雨",
                                                    "text": "小意思，在群玉阁上建戏台的木匠我给他打过下手。"
                                                },
                                                {
                                                    "id": "710990324",
                                                    "speaker": "路爷",
                                                    "text": "少吹点牛吧，和裕茶馆的老戏台用了几十年都没换，你这次去也得给人家造一个结实的。"
                                                },
                                                {
                                                    "id": "710990325",
                                                    "speaker": "若心",
                                                    "text": "哦，闹了半天原来是范二哥要换戏台，他怎么拖到今天还在用那个小戏台…"
                                                },
                                                {
                                                    "id": "710990326",
                                                    "speaker": "大雨",
                                                    "text": "行，我把手上这最后一把椅子打完就出发。"
                                                },
                                                {
                                                    "id": "710990327",
                                                    "speaker": "大雨",
                                                    "text": "#这位{M#小哥}{F#姑娘}，不好意思你还要等等。"
                                                },
                                                {
                                                    "id": "710990328",
                                                    "speaker": "大雨",
                                                    "text": "这最后一把椅子还缺三根松木，我去砍点松木。",
                                                    "choices": [
                                                        {
                                                            "id": "710990329",
                                                            "text": "还要等等？",
                                                            "response": [
                                                                {
                                                                    "id": "710990331",
                                                                    "speaker": "大雨",
                                                                    "text": "那要不然您原地掏三根松木出来也行。"
                                                                },
                                                                {
                                                                    "id": "710990332",
                                                                    "speaker": "Player",
                                                                    "text": "明白了…"
                                                                },
                                                                {
                                                                    "id": "710990333",
                                                                    "speaker": "大雨",
                                                                    "text": "真掏啊？那要不然您受点累，再给一份红染料吧。"
                                                                },
                                                                {
                                                                    "id": "710990334",
                                                                    "speaker": "Player",
                                                                    "text": "你等着！"
                                                                },
                                                                {
                                                                    "id": "710990335",
                                                                    "speaker": "大雨",
                                                                    "text": "嘿嘿，您大人有大量，别跟我计较。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710990330",
                                                            "text": "等不了了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710990309",
                                            "text": "佣金只能给别人了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710990303",
                            "text": "有件事…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7109904",
            "objective": "收集家具材料",
            "dialogues": [
                {
                    "id": "710990401",
                    "speaker": "若心",
                    "text": "范二哥真是的，怎么拖到今天才想起来造新戏台啊…"
                },
                {
                    "id": "710990402",
                    "speaker": "若心",
                    "text": "他年轻时候就抠门，到老了这毛病是越来越严重了。",
                    "choices": [
                        {
                            "id": "710990403",
                            "text": "或许不是因为抠门。",
                            "response": [
                                {
                                    "id": "710990405",
                                    "speaker": "若心",
                                    "text": "哎呀我还不知道他啊，二哥都多大年纪了，还跟自己过不去…"
                                },
                                {
                                    "id": "710990406",
                                    "speaker": "若心",
                                    "text": "算了不提了，待会儿云家的小姑娘要来做客，我过会儿得回去收拾收拾。"
                                }
                            ]
                        },
                        {
                            "id": "710990404",
                            "text": "或许不只是因为抠门。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7109905",
            "objective": "与大雨对话",
            "dialogues": [
                {
                    "id": "710990601",
                    "speaker": "大雨",
                    "text": "您瞧好吧。"
                },
                {
                    "id": "710990602",
                    "speaker": "Black Screen",
                    "text": "大雨忙活了一阵。"
                },
                {
                    "id": "710990603",
                    "speaker": "大雨",
                    "text": "最后一把椅子也打好了，村长奶奶拿好，这下我该去和裕茶馆干活啦。"
                },
                {
                    "id": "710990604",
                    "speaker": "大雨",
                    "text": "师父您等着啊，我大概几天就回了。"
                },
                {
                    "id": "710990605",
                    "speaker": "路爷",
                    "text": "嗯，去吧去吧。"
                },
                {
                    "id": "710990606",
                    "speaker": "大雨",
                    "text": "成，那我现在出发，差不多明天晚上就能赶到了。"
                },
                {
                    "id": "710990607",
                    "speaker": "大雨",
                    "text": "我们和裕茶馆见。"
                }
            ]
        },
        {
            "id": "7109906",
            "objective": "等到第二天（18:00~21:00）",
            "dialogues": []
        },
        {
            "id": "7109907",
            "objective": "前往和裕茶馆",
            "dialogues": [
                {
                    "id": "710990701",
                    "speaker": "大雨",
                    "text": "怎么意思？闹了半天，你们没商量好啊？"
                },
                {
                    "id": "710990702",
                    "speaker": "大雨",
                    "text": "哦我懂了，刘苏刘先生想造新戏台，但他说话不算数，得听范二爷的，范二爷又不想造，得。"
                },
                {
                    "id": "710990703",
                    "speaker": "大雨",
                    "text": "你俩商量好了再给我个准话吧，我也赶了老久的路，先到边上候着去了。"
                },
                {
                    "id": "710990704",
                    "speaker": "大雨",
                    "text": "唉，这叫什么事儿啊…",
                    "choices": [
                        {
                            "id": "710990705",
                            "text": "所以我白跑了？",
                            "response": [
                                {
                                    "id": "710990707",
                                    "speaker": "茶博士刘苏",
                                    "text": "别急别急，我再说说。"
                                },
                                {
                                    "id": "710990708",
                                    "speaker": "茶博士刘苏",
                                    "text": "二爷啊，我们今天要是心疼造戏台这点小钱，以后就要亏大钱了。"
                                },
                                {
                                    "id": "710990709",
                                    "speaker": "茶博士刘苏",
                                    "text": "你想啊，每次云老板在我们这儿登台，人家耍花枪那么一亮相，还没等观众叫好，戏台子先响起来了。"
                                },
                                {
                                    "id": "710990710",
                                    "speaker": "茶博士刘苏",
                                    "text": "你说尴尬不尴尬？本来云翰社就是挂靠在我们这儿，到时候人家一不高兴去了别处，我们就亏大了。"
                                },
                                {
                                    "id": "710990711",
                                    "speaker": "范二爷",
                                    "text": "凭云老板跟我的交情，她是不会这么干的。"
                                },
                                {
                                    "id": "710990712",
                                    "speaker": "茶博士刘苏",
                                    "text": "您还以为我们高枕无忧呢？我可听说最近大家都爱去三碗不过港，不爱上我们这儿来。"
                                },
                                {
                                    "id": "710990713",
                                    "speaker": "茶博士刘苏",
                                    "text": "那田铁嘴名头都比我大了，您倒是有点忧患意识啊。"
                                },
                                {
                                    "id": "710990714",
                                    "speaker": "茶博士刘苏",
                                    "text": "云老板给茶馆挣了这么多钱，我们造个戏台这点钱出不起？"
                                },
                                {
                                    "id": "710990715",
                                    "speaker": "云堇",
                                    "text": "谁叫我呀？哦，是刘苏先生，今天是怎么了，生这么大气？"
                                },
                                {
                                    "id": "710990716",
                                    "speaker": "茶博士刘苏",
                                    "text": "没有没有，说不上生气。云老板今天过来，是安排了戏吗？"
                                },
                                {
                                    "id": "710990717",
                                    "speaker": "云堇",
                                    "text": "倒不是，只是想来茶馆喝喝茶，顺便来看望看望二爷和刘苏先生。"
                                },
                                {
                                    "id": "710990718",
                                    "speaker": "云堇",
                                    "text": "#啊，巧得很，原来{NICKNAME}也来了。",
                                    "choices": [
                                        {
                                            "id": "710990719",
                                            "text": "没想到你来了…",
                                            "response": [
                                                {
                                                    "id": "710990720",
                                                    "speaker": "云堇",
                                                    "text": "有缘自然能相会，我可不觉得意外呢。"
                                                },
                                                {
                                                    "id": "710990723",
                                                    "speaker": "范二爷",
                                                    "text": "哈哈哈，还是云老板说话中听，来来来，我托人从翘英庄捎了新茶，我们泡它一壶。"
                                                },
                                                {
                                                    "id": "710990724",
                                                    "speaker": "云堇",
                                                    "text": "二爷，我刚在楼下听到茶馆的戏台要修了，您终于肯动这个老物件了啊。"
                                                },
                                                {
                                                    "id": "710990725",
                                                    "speaker": "范二爷",
                                                    "text": "咳咳…这个不着急，我还要从长计议…"
                                                },
                                                {
                                                    "id": "710990726",
                                                    "speaker": "云堇",
                                                    "text": "哦？从长计议…"
                                                },
                                                {
                                                    "id": "710990727",
                                                    "speaker": "云堇",
                                                    "text": "说起来，您知道我去轻策庄，是在哪家吃的饭吗？"
                                                },
                                                {
                                                    "id": "710990728",
                                                    "speaker": "范二爷",
                                                    "text": "别卖关子了，你又去看若心了吧。"
                                                },
                                                {
                                                    "id": "710990729",
                                                    "speaker": "云堇",
                                                    "text": "您一猜就准！若心前辈还问起今天的和裕茶馆什么样呢，我说一切都跟她年轻时一样，然后她说…"
                                                },
                                                {
                                                    "id": "710990730",
                                                    "speaker": "范二爷",
                                                    "text": "她说什么？"
                                                },
                                                {
                                                    "id": "710990731",
                                                    "speaker": "云堇",
                                                    "text": "哎呀我忘了。"
                                                },
                                                {
                                                    "id": "710990732",
                                                    "speaker": "范二爷",
                                                    "text": "你这个云丫头，平时记性挺好，怎么今天这么重要的事还能忘了。"
                                                },
                                                {
                                                    "id": "710990733",
                                                    "speaker": "范二爷",
                                                    "text": "算了，一切保持原样，她也会开心的吧。"
                                                },
                                                {
                                                    "id": "710990734",
                                                    "speaker": "范二爷",
                                                    "text": "你们年轻人就喜欢新东西，一点不念旧，说多了你们也不懂，就知道催我，哼。"
                                                },
                                                {
                                                    "id": "710990735",
                                                    "speaker": "云堇",
                                                    "text": "#别生气嘛二爷，先喝茶先喝茶，我来给大家泡。{NICKNAME}和刘苏先生来帮我取点茶叶吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710990721",
                                            "text": "刚刚想到云堇…",
                                            "response": [
                                                {
                                                    "id": "710990722",
                                                    "speaker": "云堇",
                                                    "text": "你真是的，就爱开玩笑。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710990706",
                            "text": "说好的酬金呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7109908",
            "objective": "与云堇一同去「泡茶」",
            "dialogues": [
                {
                    "id": "710990801",
                    "speaker": "茶博士刘苏",
                    "text": "云先生，我还在想二爷怎么就不愿意造戏台呢，明明是百利无一害的事。"
                },
                {
                    "id": "710990802",
                    "speaker": "茶博士刘苏",
                    "text": "你一试探我才明白，还是你聪慧。"
                },
                {
                    "id": "710990803",
                    "speaker": "茶博士刘苏",
                    "text": "二爷念旧我是能明白，就是没想到，这都几十年了，他还惦记着以前的事。"
                },
                {
                    "id": "710990804",
                    "speaker": "云堇",
                    "text": "这下就都明白了。"
                },
                {
                    "id": "710990805",
                    "speaker": "Player",
                    "text": "我没明白。"
                },
                {
                    "id": "710990806",
                    "speaker": "云堇",
                    "text": "这是以前的旧事，既然你也被卷进来了，那告诉你也无妨。"
                },
                {
                    "id": "710990807",
                    "speaker": "云堇",
                    "text": "范二爷年轻的时候也能唱，和若心前辈常年搭戏，他们两个总在台上扮一对，大概二爷心里当了真吧。"
                },
                {
                    "id": "710990808",
                    "speaker": "云堇",
                    "text": "不过，若心前辈其实另有心上人，后来她逐渐厌倦了舞台生活，就和她那位一道去了轻策庄。"
                },
                {
                    "id": "710990809",
                    "speaker": "云堇",
                    "text": "不知道中间出了什么变故，那位没能和若心前辈在轻策庄团聚，她就孤身留在了那里，直到现在。"
                },
                {
                    "id": "710990810",
                    "speaker": "云堇",
                    "text": "二爷知道我常去轻策庄看望若心前辈，总跟我打听她的近况。"
                },
                {
                    "id": "710990811",
                    "speaker": "云堇",
                    "text": "可见他还是念着若心前辈，不愿意造新戏台也是想给过去留个念想。"
                },
                {
                    "id": "710990812",
                    "speaker": "茶博士刘苏",
                    "text": "唉，既然这个戏台对二爷这么重要，那新戏台肯定是修不了了，木匠也白请了…"
                },
                {
                    "id": "710990813",
                    "speaker": "云堇",
                    "text": "这也未必，我有办法，刘苏先生等着看吧。"
                },
                {
                    "id": "710990814",
                    "speaker": "茶博士刘苏",
                    "text": "你当真有好办法？只要能修成，我事后一定好好谢谢云老板。"
                },
                {
                    "id": "710990815",
                    "speaker": "云堇",
                    "text": "#多了我也不需要，刘苏先生单给我讲一场《裁雨声》吧，这回我想听完，{NICKNAME}也可以一起。"
                },
                {
                    "id": "710990816",
                    "speaker": "Player",
                    "text": "感觉云堇和平时不太一样。"
                },
                {
                    "id": "710990817",
                    "speaker": "茶博士刘苏",
                    "text": "我们茶馆和云翰社的交情多厚哪，云老板跟我们当然比跟别人亲近。"
                },
                {
                    "id": "710990818",
                    "speaker": "茶博士刘苏",
                    "text": "您放心，以后一定单独给你们开一场。"
                },
                {
                    "id": "710990819",
                    "speaker": "云堇",
                    "text": "好了，我们「茶」也喝完了，该去跟二爷说道说道了。"
                }
            ]
        },
        {
            "id": "7109909",
            "objective": "与范二爷对话",
            "dialogues": [
                {
                    "id": "710990901",
                    "speaker": "云堇",
                    "text": "二爷，我们刚刚正喝着茶，我突然想起来若心前辈跟我说什么了。"
                },
                {
                    "id": "710990902",
                    "speaker": "范二爷",
                    "text": "哦，她说什么呀？"
                },
                {
                    "id": "710990903",
                    "speaker": "云堇",
                    "text": "她说：「二哥总爱跟自己过不去，听着让人难过。」"
                },
                {
                    "id": "710990904",
                    "speaker": "范二爷",
                    "text": "唉，还是她明白我。"
                },
                {
                    "id": "710990905",
                    "speaker": "范二爷",
                    "text": "不过，她好像也不怎么怀念这个旧物件啊，只有我还在自己跟自己较劲。"
                },
                {
                    "id": "710990906",
                    "speaker": "范二爷",
                    "text": "我坚持不让别人动这个戏台不是自讨没趣吗？算了算了，你们修吧。"
                },
                {
                    "id": "710990907",
                    "speaker": "云堇",
                    "text": "二爷这是有情有义，怎么能说是自讨没趣呢？您这么说我可不爱听。"
                },
                {
                    "id": "710990908",
                    "speaker": "云堇",
                    "text": "戏台还是要修的，但也不能破坏了二爷的念想。"
                },
                {
                    "id": "710990909",
                    "speaker": "大雨",
                    "text": "你们终于肯动工了啊？好，我这就安排。"
                },
                {
                    "id": "710990910",
                    "speaker": "大雨",
                    "text": "我准备的图纸你们可以看看，群玉阁上那座大戏台就是照着这份图纸打造的。"
                },
                {
                    "id": "710990911",
                    "speaker": "大雨",
                    "text": "按照这个设计，这两边的墙都要打掉哈，还有…"
                },
                {
                    "id": "710990912",
                    "speaker": "云堇",
                    "text": "不着急，这个戏台我想还是得修旧如旧，既然是木地板响动影响演出，那就先修修地板。"
                },
                {
                    "id": "710990913",
                    "speaker": "云堇",
                    "text": "其余的往后再说，刘苏先生，这样可以吗？"
                },
                {
                    "id": "710990914",
                    "speaker": "茶博士刘苏",
                    "text": "只要这戏台修完了不再影响平时演出，具体怎么修都听云老板和二爷安排。"
                },
                {
                    "id": "710990915",
                    "speaker": "大雨",
                    "text": "啊，就这样？不造新戏台了？"
                },
                {
                    "id": "710990916",
                    "speaker": "范二爷",
                    "text": "我看这样好，还是云老板的主意妙。"
                },
                {
                    "id": "710990917",
                    "speaker": "范二爷",
                    "text": "正巧修戏台用的木板也不用额外采购，码头上就有现成的。"
                },
                {
                    "id": "710990918",
                    "speaker": "范二爷",
                    "text": "#这位…{NICKNAME}还得麻烦你走一遭，这次跑腿的酬金稍后一起给你结算好了。"
                },
                {
                    "id": "710990919",
                    "speaker": "Player",
                    "text": "可以。"
                },
                {
                    "id": "710990920",
                    "speaker": "大雨",
                    "text": "…好吧，一起交给我好了。"
                }
            ]
        },
        {
            "id": "7109910",
            "objective": "前往码头仓库获取木板",
            "dialogues": []
        },
        {
            "id": "7109911",
            "objective": "将木板交给大雨",
            "dialogues": [
                {
                    "id": "710991101",
                    "speaker": "大雨",
                    "text": "行吧，这几块木板应该够用了，我这就开工。"
                }
            ]
        },
        {
            "id": "7109905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710990501",
                    "speaker": "大雨",
                    "text": "您受累，三根松木和一份红染料有了没？"
                }
            ]
        },
        {
            "id": "7109950",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995001",
                    "speaker": "路爷",
                    "text": "#{M#小兄弟}{F#小姑娘}，老头我今天有徒弟啦，哈哈今天晚上炖一锅林猪肉庆祝一下！"
                }
            ]
        },
        {
            "id": "7109951",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995101",
                    "speaker": "范二爷",
                    "text": "好了好了，别念叨什么修戏台了，让我再想想。"
                }
            ]
        },
        {
            "id": "7109952",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995201",
                    "speaker": "大雨",
                    "text": "我还以为能接个大活呢，连当初群玉阁上的大戏台图纸都带了，结果雇主们自己没商量好，这不是拿人开心嘛。"
                }
            ]
        },
        {
            "id": "7109953",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995301",
                    "speaker": "范二爷",
                    "text": "还是云老板懂我的心思。"
                }
            ]
        },
        {
            "id": "7109954",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995401",
                    "speaker": "茶博士刘苏",
                    "text": "不就是单开一出《裁雨声》吗，没问题。"
                }
            ]
        },
        {
            "id": "7109955",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995501",
                    "speaker": "云堇",
                    "text": "这样就好解决了，皆大欢喜。",
                    "choices": [
                        {
                            "id": "710995502",
                            "text": "关于若心…",
                            "response": [
                                {
                                    "id": "710995503",
                                    "speaker": "云堇",
                                    "text": "其实我的确是刚从轻策庄回来，也的确是去探望若心前辈了，前辈说的话也是真的，只是…"
                                },
                                {
                                    "id": "710995504",
                                    "speaker": "Player",
                                    "text": "只是？"
                                },
                                {
                                    "id": "710995505",
                                    "speaker": "云堇",
                                    "text": "嘘！只是我啊，没说全。前辈那一整句话是："
                                },
                                {
                                    "id": "710995506",
                                    "speaker": "云堇",
                                    "text": "「二哥总爱跟自己过不去，抠抠搜搜的，周围人也跟着他受罪，听着让人难过。」"
                                },
                                {
                                    "id": "710995507",
                                    "speaker": "云堇",
                                    "text": "虽然是大实话，但要是全说了，二爷该不开心了，我才只说了半截。"
                                }
                            ]
                        },
                        {
                            "id": "710995508",
                            "text": "我先坐会儿。",
                            "response": [
                                {
                                    "id": "710995509",
                                    "speaker": "云堇",
                                    "text": "好啊，我第二喜欢的就是等个好天气，来茶馆里坐着。"
                                },
                                {
                                    "id": "710995510",
                                    "speaker": "云堇",
                                    "text": "刘苏先生不开讲的时候，就坐在这里听听市声，也很舒心。"
                                },
                                {
                                    "id": "710995511",
                                    "speaker": "Player",
                                    "text": "第一喜欢的呢？"
                                },
                                {
                                    "id": "710995512",
                                    "speaker": "云堇",
                                    "text": "当然是登台唱戏呀。"
                                },
                                {
                                    "id": "710995513",
                                    "speaker": "云堇",
                                    "text": "我确实还有很多话想跟你聊聊，但你看，刘苏先生还在一边等着你拿来木板修戏台呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7109956",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710995601",
                    "speaker": "大雨",
                    "text": "师父说得没错，城里老板不好伺候啊。"
                }
            ]
        }
    ]
}