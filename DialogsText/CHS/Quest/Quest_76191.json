    "talks": [
        {
            "id": "7619101",
            "objective": "（隐藏）点击手册按钮完成$HIDDEN",
            "dialogues": [
                {
                    "id": "761910101",
                    "speaker": "（test）莉奈娅",
                    "text": "蹲守了一段时间…"
                }
            ]
        },
        {
            "id": "7619102",
            "objective": "前往指定地点开启调查",
            "dialogues": []
        },
        {
            "id": "7619103",
            "objective": "制止盗宝团",
            "dialogues": [
                {
                    "id": "761910201",
                    "speaker": "艾霍玛",
                    "text": "三番五次提醒你，让你招子放亮点，这压箱底的尖货，可是至冬堡的熟客点名要的。"
                },
                {
                    "id": "761910202",
                    "speaker": "艾霍玛",
                    "text": "得，你倒好，到我手下改吃素了还是怎么？突然就善心大发，给它放生了？"
                },
                {
                    "id": "761910203",
                    "speaker": "耶洛",
                    "text": "大哥，你听我解释，这真怨不得我，是那丘丘人…"
                },
                {
                    "id": "761910204",
                    "speaker": "艾霍玛",
                    "text": "丘丘人？亏你还好意思说呢！咱们盗宝团的招牌都要砸你手里了！"
                },
                {
                    "id": "761910205",
                    "speaker": "耶洛",
                    "text": "打不过啊，大哥，真打不过！它们那一个蓝的一个绿的下手比债务处理人还狠…"
                },
                {
                    "id": "761910206",
                    "speaker": "莉奈娅",
                    "text": "（这两个家伙看起来就是走私贩了…）"
                },
                {
                    "id": "761910207",
                    "speaker": "艾霍玛",
                    "text": "…谁在那儿？！"
                },
                {
                    "id": "761910208",
                    "speaker": "莉奈娅",
                    "text": "哎呀露米！还没到出场的时候呢！"
                },
                {
                    "id": "761910209",
                    "speaker": "艾霍玛",
                    "text": "这是个什么玩意儿…看着挺稀罕。"
                },
                {
                    "id": "761910210",
                    "speaker": "艾霍玛",
                    "text": "喂，小姑娘你总应付得来了吧？我看这货也够尖，就拿它替了吧。"
                },
                {
                    "id": "761910211",
                    "speaker": "耶洛",
                    "text": "是。"
                },
                {
                    "id": "761910212",
                    "speaker": "莉奈娅",
                    "text": "居然还想打露米的主意！盗宝团的名声就是被你们这种人败坏的…"
                },
                {
                    "id": "761910213",
                    "speaker": "耶洛",
                    "text": "呃，盗宝团有什么名声？"
                },
                {
                    "id": "761910214",
                    "speaker": "艾霍玛",
                    "text": "少跟她废话！"
                }
            ]
        },
        {
            "id": "7619104",
            "objective": "击败敌人",
            "dialogues": [
                {
                    "id": "761910401",
                    "speaker": "Player",
                    "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
                }
            ]
        },
        {
            "id": "7619105",
            "objective": "调查笼子",
            "dialogues": [
                {
                    "id": "761910501",
                    "speaker": "莉奈娅",
                    "text": "落荒而逃了…真没出息啊。"
                },
                {
                    "id": "761910502",
                    "speaker": "莉奈娅",
                    "text": "（走私的豚兽看起来不在这里…和丘丘人有什么关系吗？）"
                },
                {
                    "id": "761910503",
                    "speaker": "莉奈娅",
                    "text": "（在附近找找看有没有线索吧。）"
                }
            ]
        },
        {
            "id": "7619106",
            "objective": "寻找豚兽",
            "dialogues": []
        },
        {
            "id": "7619107",
            "objective": "击败敌人",
            "dialogues": []
        },
        {
            "id": "7619108",
            "objective": "调查豚兽",
            "dialogues": [
                {
                    "id": "761910301",
                    "speaker": "莉奈娅",
                    "text": "真的是银色的豚兽，不是染色的也不是看错，太少见了，不可思议…"
                },
                {
                    "id": "761910302",
                    "speaker": "莉奈娅",
                    "text": "之前在纳塔费尽心思也没找到，原来是被走私贩给抓到了。"
                },
                {
                    "id": "761910303",
                    "speaker": "莉奈娅",
                    "text": "不过看起来好像没受伤…嘿嘿，银色的豚兽，真没想到能亲眼见到，让我摸摸看，银色的和普通的有没有区别…"
                },
                {
                    "id": "761910304",
                    "speaker": "莉奈娅",
                    "text": "…好烫！"
                },
                {
                    "id": "761910305",
                    "speaker": "豚兽",
                    "text": "？"
                },
                {
                    "id": "761910306",
                    "speaker": "莉奈娅",
                    "text": "差点忘了，你还在锅里呢！"
                },
                {
                    "id": "761910307",
                    "speaker": "莉奈娅",
                    "text": "难道是已经习惯了纳塔的液态燃素，所以这点温度不算什么吗？"
                },
                {
                    "id": "761910308",
                    "speaker": "莉奈娅",
                    "text": "不管怎么说，你先跟我回去吧！"
                },
                {
                    "id": "761910309",
                    "speaker": "豚兽",
                    "text": "♪～"
                }
            ]
        },
        {
            "id": "7619109",
            "objective": "调查豚兽",
            "dialogues": []
        },
        {
            "id": "7619110",
            "objective": "调查豚兽",
            "dialogues": []
        },
        {
            "id": "7619111",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7619199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761919901",
                    "speaker": "莉奈娅",
                    "text": "你们应该庆幸遇上的是我而不是海捷德奶奶！"
                },
                {
                    "id": "761919902",
                    "speaker": "莉奈娅",
                    "text": "居然真的有银色的豚兽！欸不对！怎么已经下锅了！"
                },
                {
                    "id": "761919903",
                    "speaker": "莉奈娅",
                    "text": "哼哼，送它回去之前，让米科他们也见识一下好了！"
                }
            ]
        }
    ]
