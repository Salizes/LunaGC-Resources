    "talks": [
        {
            "id": "1201401",
            "objective": "",
            "dialogues": [
                {
                    "id": "120140101",
                    "speaker": "宵宫",
                    "text": "我打算再待一会儿，我心中的烟花会还没有结束呢。"
                },
                {
                    "id": "120140102",
                    "speaker": "宵宫",
                    "text": "啊，不过如果想聊天的话，也没问题哦。",
                    "choices": [
                        {
                            "id": "120140103",
                            "text": "接下来打算去干什么？",
                            "response": [
                                {
                                    "id": "120140104",
                                    "speaker": "宵宫",
                                    "text": "松坂他们还在等我和他们一起去找「大貉妖」呢，宵宫姐姐可不能言而无信。"
                                },
                                {
                                    "id": "120140105",
                                    "speaker": "宵宫",
                                    "text": "还有各家各户放完烟花之后的感想，我也要去了解。"
                                },
                                {
                                    "id": "120140106",
                                    "speaker": "宵宫",
                                    "text": "接下来的日子，还要承蒙大家关照。"
                                },
                                {
                                    "id": "120140107",
                                    "speaker": "宵宫",
                                    "text": "你和派蒙的关照当然也少不了啦。"
                                }
                            ]
                        },
                        {
                            "id": "120140108",
                            "text": "定做烟花很贵吗？",
                            "response": [
                                {
                                    "id": "120140109",
                                    "speaker": "宵宫",
                                    "text": "你们的话…"
                                },
                                {
                                    "id": "120140110",
                                    "speaker": "宵宫",
                                    "text": "免费吧！"
                                },
                                {
                                    "id": "120140111",
                                    "speaker": "宵宫",
                                    "text": "毕竟是我硬要送给你们的，一路上还给你们添了很多麻烦，嘿嘿，再收费我会不好意思的。"
                                },
                                {
                                    "id": "120140112",
                                    "speaker": "Player",
                                    "text": "那有点过意不去。"
                                },
                                {
                                    "id": "120140113",
                                    "speaker": "宵宫",
                                    "text": "#别在意，不用这么客气。那这样吧，作为交换，等你找到了亲人，你要把「长野原烟花店」介绍给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}，这样我又能多一个客人了。"
                                },
                                {
                                    "id": "120140114",
                                    "speaker": "宵宫",
                                    "text": "#我也想见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}一面啊。"
                                }
                            ]
                        },
                        {
                            "id": "120140115",
                            "text": "天领奉行如果来找你的麻烦…",
                            "response": [
                                {
                                    "id": "120140116",
                                    "speaker": "宵宫",
                                    "text": "那就再打一顿！"
                                },
                                {
                                    "id": "120140117",
                                    "speaker": "宵宫",
                                    "text": "——哈哈哈，开玩笑，开玩笑啦。我不是说了，我家经常会和奉行众打交道。"
                                },
                                {
                                    "id": "120140118",
                                    "speaker": "宵宫",
                                    "text": "无非是认错，赔笑脸，交些罚款，要混过去很容易。"
                                },
                                {
                                    "id": "120140119",
                                    "speaker": "宵宫",
                                    "text": "倒是你们要更小心一点，遇到事情，可不要像我一样鲁莽，嘿嘿。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}