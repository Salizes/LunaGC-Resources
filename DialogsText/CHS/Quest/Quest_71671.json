    "talks": [
        {
            "id": "7167101",
            "objective": "与刻晴和夜兰对话",
            "dialogues": [
                {
                    "id": "716710101",
                    "speaker": "派蒙",
                    "text": "呃啊，不愧是夜兰都评价棘手的秘境，真的不一般呢…"
                },
                {
                    "id": "716710102",
                    "speaker": "派蒙",
                    "text": "也不知道这个地脉紊乱点记录的都是什么战局…一般士兵真的能应付过来吗！",
                    "choices": [
                        {
                            "id": "716710103",
                            "text": "魔神战争的局部交战？",
                            "response": [
                                {
                                    "id": "716710105",
                                    "speaker": "派蒙",
                                    "text": "唔…我猜，大概也没到…那么吓人的程度吧？"
                                },
                                {
                                    "id": "716710106",
                                    "speaker": "刻晴",
                                    "text": "你们回来了。"
                                },
                                {
                                    "id": "716710107",
                                    "speaker": "夜兰",
                                    "text": "嗯，神色从容，应该取得了不错的战果。"
                                },
                                {
                                    "id": "716710108",
                                    "speaker": "派蒙",
                                    "text": "也确实遇见了非常惊险的情况！"
                                },
                                {
                                    "id": "716710109",
                                    "speaker": "Black Screen",
                                    "text": "向刻晴和夜兰描述了其中的战况…"
                                },
                                {
                                    "id": "716710110",
                                    "speaker": "刻晴",
                                    "text": "原来如此…实在有劳你们了，干得漂亮！"
                                },
                                {
                                    "id": "716710111",
                                    "speaker": "夜兰",
                                    "text": "你们通过紊乱点造访秘境后，外溢的魔物显著减少了。"
                                },
                                {
                                    "id": "716710112",
                                    "speaker": "夜兰",
                                    "text": "虽然没能直接清除紊乱点，但的确有效削弱了它的活性。"
                                },
                                {
                                    "id": "716710113",
                                    "speaker": "刻晴",
                                    "text": "得益于此，魔物们的棘手程度大大降低，普通的千岩军战士也能将它们击退。",
                                    "choices": [
                                        {
                                            "id": "716710115",
                                            "text": "进去一次，就明白了凶险。",
                                            "response": [
                                                {
                                                    "id": "716710117",
                                                    "speaker": "派蒙",
                                                    "text": "#怎么感觉，{NICKNAME}的斗志燃烧起来了…你还摩拳擦掌呢！"
                                                },
                                                {
                                                    "id": "716710118",
                                                    "speaker": "刻晴",
                                                    "text": "#刚才，送往玉京台的加急信件得到了回复，天权星和开阳星一致同意，与{NICKNAME}达成长期合作。"
                                                },
                                                {
                                                    "id": "716710119",
                                                    "speaker": "刻晴",
                                                    "text": "#得益于{NICKNAME}的努力，这个地脉紊乱点甚至可被我们妥善利用。"
                                                },
                                                {
                                                    "id": "716710120",
                                                    "speaker": "刻晴",
                                                    "text": "#此后，{NICKNAME}将获得驻军的全力支持。"
                                                },
                                                {
                                                    "id": "716710121",
                                                    "speaker": "刻晴",
                                                    "text": "#紊乱点活跃期间，若是{NICKNAME}有意愿，便可攻入秘境。少量外溢的魔物则由千岩军处理，给战士们轮番练手。"
                                                },
                                                {
                                                    "id": "716710122",
                                                    "speaker": "夜兰",
                                                    "text": "算是转危为安，转祸为福了。",
                                                    "choices": [
                                                        {
                                                            "id": "716710123",
                                                            "text": "那从今以后，我定然全力以赴！",
                                                            "response": [
                                                                {
                                                                    "id": "716710125",
                                                                    "speaker": "派蒙",
                                                                    "text": "哎呀呀，可算松了口气…"
                                                                },
                                                                {
                                                                    "id": "716710126",
                                                                    "speaker": "派蒙",
                                                                    "text": "话又说回来了。"
                                                                },
                                                                {
                                                                    "id": "716710127",
                                                                    "speaker": "派蒙",
                                                                    "text": "地脉真是个奇妙的东西，总有一天，我们得想个办法，查出它更多的秘密才行…"
                                                                },
                                                                {
                                                                    "id": "716710128",
                                                                    "speaker": "派蒙",
                                                                    "text": "不知道能不能遇见什么聪明人，给我们翻出一本…《地脉百科全书》来！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716710124",
                                                            "text": "既然危险解除，我就酌情出勤！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716710116",
                                            "text": "难对付的家伙，要慢慢搞定。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716710104",
                            "text": "灾变之时的极端战况？"
                        }
                    ]
                }
            ]
        }
    ]
}