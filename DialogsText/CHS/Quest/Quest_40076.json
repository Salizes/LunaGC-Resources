        {
            "id": "4007609",
            "objective": "进入水下空间",
            "dialogues": [
                {
                    "id": "400760901",
                    "speaker": "莫娜",
                    "text": "哇啊！这、这…"
                },
                {
                    "id": "400760902",
                    "speaker": "枫原万叶",
                    "text": "又是蒙德的房屋？"
                },
                {
                    "id": "400760903",
                    "speaker": "莫娜",
                    "text": "怎么到我家了啊——！"
                },
                {
                    "id": "400760904",
                    "speaker": "菲谢尔",
                    "text": "你家？这是你家？"
                },
                {
                    "id": "400760905",
                    "speaker": "奥兹",
                    "text": "哦呀，这可真没想到…我似乎听说，梅姬斯图斯卿一直过着较为拮据的生活，可这栋住宅…"
                },
                {
                    "id": "400760906",
                    "speaker": "派蒙",
                    "text": "地上这几本书有标签呢，「孤品，仅售990000摩拉…」欸？！这么贵吗？！"
                },
                {
                    "id": "400760907",
                    "speaker": "辛焱",
                    "text": "这边也有许多一看就很贵的精装书本…这就是占星术士的房间吗…"
                },
                {
                    "id": "400760908",
                    "speaker": "枫原万叶",
                    "text": "房间布设得十分精巧…这里一定不便宜。",
                    "choices": [
                        {
                            "id": "400760909",
                            "text": "莫娜，原来这么有钱吗…",
                            "response": [
                                {
                                    "id": "400760911",
                                    "speaker": "莫娜",
                                    "text": "我说，我只是偶尔没有现金而已，又不真是穷光蛋。"
                                },
                                {
                                    "id": "400760912",
                                    "speaker": "菲谢尔",
                                    "text": "你不是吗？我还请你吃过饭，甚至带你去我家吃饭！"
                                },
                                {
                                    "id": "400760913",
                                    "speaker": "奥兹",
                                    "text": "小姐，措辞，措辞。"
                                },
                                {
                                    "id": "400760914",
                                    "speaker": "菲谢尔",
                                    "text": "啊咳咳！汝蒙受圣恩，随本皇女进入幽夜净土王城中拜谒断罪之皇帝皇后，如此大事，汝竟敢忘却？"
                                },
                                {
                                    "id": "400760915",
                                    "speaker": "莫娜",
                                    "text": "啊对，你妈妈做的炖肉和冷盘肉可好吃了！嗯，突然好想再吃一次…"
                                },
                                {
                                    "id": "400760916",
                                    "speaker": "奥兹",
                                    "text": "梅姬斯图斯卿，现在不是说这个的时候！"
                                },
                                {
                                    "id": "400760917",
                                    "speaker": "辛焱",
                                    "text": "是蒙德菜吗？我也想吃！听说蒙德有很多美食，尤其是肉菜。"
                                },
                                {
                                    "id": "400760918",
                                    "speaker": "菲谢尔",
                                    "text": "哼哼，那也赐汝荣光，下回，尔等可随本皇女一同面见父皇母后。"
                                },
                                {
                                    "id": "400760919",
                                    "speaker": "派蒙",
                                    "text": "#真的？喂{NICKNAME}，我们也去吧！"
                                },
                                {
                                    "id": "400760920",
                                    "speaker": "枫原万叶",
                                    "text": "这么说来，好久没去朋友家串门，我也恭敬不如从命了。"
                                },
                                {
                                    "id": "400760921",
                                    "speaker": "枫原万叶",
                                    "text": "唔，是不是应该提前准备伴手礼？"
                                },
                                {
                                    "id": "400760922",
                                    "speaker": "奥兹",
                                    "text": "那二位为人随和亲切，并不计较这些。诸位随意便好。"
                                },
                                {
                                    "id": "400760923",
                                    "speaker": "莫娜",
                                    "text": "去的话一定要吃那个冷盘肉，听说是她家的拿手好菜，非常美味！"
                                },
                                {
                                    "id": "400760924",
                                    "speaker": "奥兹",
                                    "text": "比起这些，是否应该先解决眼前的谜题呢？其实，从进屋到现在，我都很介意那个摆件…"
                                },
                                {
                                    "id": "400760925",
                                    "speaker": "莫娜",
                                    "text": "啊，对哦。"
                                }
                            ]
                        },
                        {
                            "id": "400760910",
                            "text": "一直以来是我有眼不识泰山…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4007610",
            "objective": "触碰奇异的摆件",
