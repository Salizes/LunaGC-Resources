    "talks": [
        {
            "id": "47001",
            "objective": "路过商业街旁$HIDDEN",
            "dialogues": [
                {
                    "id": "4700101",
                    "speaker": "派蒙",
                    "text": "啊！"
                },
                {
                    "id": "4700102",
                    "speaker": "派蒙",
                    "text": "是<color=#00E1FFFF>渔人吐司</color>的香气！"
                },
                {
                    "id": "4700103",
                    "speaker": "派蒙",
                    "text": "嗯…嗯。是从「猎鹿人」餐馆的方向飘来的…"
                },
                {
                    "id": "4700104",
                    "speaker": "派蒙",
                    "text": "松软的吐司面包切成厚片…"
                },
                {
                    "id": "4700105",
                    "speaker": "派蒙",
                    "text": "铺满洋葱，烤到微焦之后放进嘴里…"
                },
                {
                    "id": "4700106",
                    "speaker": "派蒙",
                    "text": "好，我决定了！"
                },
                {
                    "id": "4700107",
                    "speaker": "派蒙",
                    "text": "事不宜迟，就去<color=#00E1FFFF>「猎鹿人」</color>买一份<color=#00E1FFFF>渔人吐司</color>吧！"
                },
                {
                    "id": "4700108",
                    "speaker": "派蒙",
                    "text": "当然，是你请客。"
                }
            ]
        },
        {
            "id": "47002",
            "objective": "购买前对话派蒙$HIDDEN",
            "dialogues": []
        },
        {
            "id": "47003",
            "objective": "购买「渔人吐司」",
            "dialogues": []
        },
        {
            "id": "47004",
            "objective": "购买后对话派蒙$HIDDEN",
            "dialogues": [
                {
                    "id": "4700201",
                    "speaker": "派蒙",
                    "text": "哇啊，美味美味。"
                },
                {
                    "id": "4700202",
                    "speaker": "派蒙",
                    "text": "「猎鹿人」的渔人吐司真是太棒了。"
                },
                {
                    "id": "4700203",
                    "speaker": "派蒙",
                    "text": "不过，其实这在蒙德城也算是一道配方公开的经典传统菜。"
                },
                {
                    "id": "4700204",
                    "speaker": "派蒙",
                    "text": "有足够食材的话，以后你也可以试着自己做做看。"
                },
                {
                    "id": "4700205",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}的手艺，能不能超过「猎鹿人」的出品水准呢？"
                },
                {
                    "id": "4700206",
                    "speaker": "派蒙",
                    "text": "我会很乐意当你的专属品鉴师！"
                },
                {
                    "id": "4700207",
                    "speaker": "派蒙",
                    "text": "不要让我失望哦。"
                }
            ]
        }
    ]
