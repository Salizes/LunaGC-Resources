    "talks": [
        {
            "id": "7469101",
            "objective": "四处逛逛…",
            "dialogues": [
                {
                    "id": "746910101",
                    "speaker": "派蒙",
                    "text": "#…咦？{NICKNAME}，我、我是看错了吗？那边…是不是有一个嘟嘟可？",
                    "choices": [
                        {
                            "id": "746910102",
                            "text": "这里是枫丹。",
                            "response": [
                                {
                                    "id": "746910104",
                                    "speaker": "派蒙",
                                    "text": "不…不对！那边就是有一个嘟嘟可，看起来还是…那个…芭比洛斯女士的嘟嘟可！",
                                    "choices": [
                                        {
                                            "id": "746910105",
                                            "text": "太好了。",
                                            "response": [
                                                {
                                                    "id": "746910107",
                                                    "speaker": "芭比洛斯",
                                                    "text": "#哎呀，这可真是巧遇。{NICKNAME}，还有小派蒙。"
                                                },
                                                {
                                                    "id": "746910108",
                                                    "speaker": "派蒙",
                                                    "text": "从芭比洛斯女士这么厉害的占卜师嘴里听到「巧遇」两个字，总觉得有点微妙…"
                                                },
                                                {
                                                    "id": "746910109",
                                                    "speaker": "芭比洛斯",
                                                    "text": "真的是「巧遇」，我可没有开玩笑。"
                                                },
                                                {
                                                    "id": "746910110",
                                                    "speaker": "芭比洛斯",
                                                    "text": "#{NICKNAME}作为从世界之外而来的「降临者」，命运没有被锚定在提瓦特之中。"
                                                },
                                                {
                                                    "id": "746910111",
                                                    "speaker": "芭比洛斯",
                                                    "text": "#呵呵呵，包括我在内的许多占卜师，应该都无法预测{NICKNAME}的未来吧。"
                                                },
                                                {
                                                    "id": "746910112",
                                                    "speaker": "芭比洛斯",
                                                    "text": "不过，这次的「巧遇」还真是恰到好处。前不久，我偶然窥见了一缕奇异的预兆。"
                                                },
                                                {
                                                    "id": "746910113",
                                                    "speaker": "芭比洛斯",
                                                    "text": "因为正好闲来无事，所以我就对着这一缕预兆稍做占卜，又对着占卜的轨迹外出追寻…算是找点乐子，小小休一个假吧。"
                                                },
                                                {
                                                    "id": "746910114",
                                                    "speaker": "芭比洛斯",
                                                    "text": "哦对了，在追逐预兆的过程中，我也捉到了几根缥缈的命运之丝，也窥见了它们主人的样貌，就是这几位。"
                                                },
                                                {
                                                    "id": "746910115",
                                                    "speaker": "Player",
                                                    "text": "全都是…熟人…"
                                                },
                                                {
                                                    "id": "746910116",
                                                    "speaker": "芭比洛斯…？",
                                                    "text": "#你瞧，我就说嘛，{NICKNAME}的朋友可多了，一定认识他们！",
                                                    "choices": [
                                                        {
                                                            "id": "746910117",
                                                            "text": "这声音是…",
                                                            "response": [
                                                                {
                                                                    "id": "746910119",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "嗨，你们好呀，我们是不是好久没见了？这次芭比进行占卜的时候，我也有参与喔。"
                                                                },
                                                                {
                                                                    "id": "746910120",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "是的。要不是艾莉丝坚持，我就会将这些名字作为可忽略的变量，从占卜算式中去除。"
                                                                },
                                                                {
                                                                    "id": "746910121",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "那样的话，你不就没办法休假了吗？"
                                                                },
                                                                {
                                                                    "id": "746910122",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "而且！既然魔女得出了预言，那就绝对不能让和预言有关的小朋友们失望啊！"
                                                                },
                                                                {
                                                                    "id": "746910123",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "每一位小朋友都渴望着新奇的礼物，伟大的使命，还有神秘的预言…总之，绝对不能省略！"
                                                                },
                                                                {
                                                                    "id": "746910124",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "…真是服了你了。但是，如果能将这些微小的变量聚拢起来，应该也能稍微修正一下我的占卜算式。"
                                                                },
                                                                {
                                                                    "id": "746910125",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "所以我来了这里，打算见一见他们，如果可能的话，也为他们送上一次简单的占卜。"
                                                                },
                                                                {
                                                                    "id": "746910126",
                                                                    "speaker": "Player",
                                                                    "text": "呃…那他们什么时候会来？"
                                                                },
                                                                {
                                                                    "id": "746910127",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "我没有空详细占卜这些事，但总而言之——他们迟早会来。"
                                                                },
                                                                {
                                                                    "id": "746910128",
                                                                    "speaker": "派蒙",
                                                                    "text": "所以才在这里摆了个摊子，打算就这么一直等下去啊…"
                                                                },
                                                                {
                                                                    "id": "746910129",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "没关系，这个嘟嘟可只是一个替身，我本人还在继续做正经的研究呢，不算浪费时间。"
                                                                },
                                                                {
                                                                    "id": "746910130",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "没错！我还给芭比的嘟嘟可上装了自动感应系统，只要对应的人来到了摊位前，她就会得到提醒。"
                                                                },
                                                                {
                                                                    "id": "746910131",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "而且，嘟嘟可也会扭动得更加开心，保证来的人移不开目光！"
                                                                },
                                                                {
                                                                    "id": "746910132",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "你怎么又回来了？挪挪你的胳膊，你快把我的水占盘推到地上了。还有，拿稳杯子，别把热巧克力洒在我的稿纸上！"
                                                                },
                                                                {
                                                                    "id": "746910133",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "好嘛好嘛，你们稍等一下…这样就可以了，对了芭比，这杯是你的，真的只是微甜，我保证。"
                                                                },
                                                                {
                                                                    "id": "746910134",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "你所接受的微甜，和我所接受的微甜，绝对不是一个甜度。"
                                                                },
                                                                {
                                                                    "id": "746910135",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "咳，说正事！总之呢，在芭比占卜出结果后，我本来打算跑一趟，把那群人聚在一起，好好地办一个超棒的聚会呢。"
                                                                },
                                                                {
                                                                    "id": "746910136",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "我连送信的方式都想好了，还特意去找了好多帅气的鸟。"
                                                                },
                                                                {
                                                                    "id": "746910137",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "想想看，在寂静的深夜，纯白的巨鸟咬着一封神秘的信件来访，只要打开这封信，你就会面对一个全新的世界——"
                                                                },
                                                                {
                                                                    "id": "746910138",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "可是，艾莉丝这么做，只会扰乱命运的轨迹。而且，要处理一个这么小的预言非常麻烦，所以我阻止了她。"
                                                                },
                                                                {
                                                                    "id": "746910139",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "真遗憾，但聚会还是可以办的，等到了合适的时机，我会来邀请所有人的！"
                                                                },
                                                                {
                                                                    "id": "746910140",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "#为了让聚会快点举办，{NICKNAME}，小派蒙！把这些人带过来的任务，就交给你们了！"
                                                                },
                                                                {
                                                                    "id": "746910141",
                                                                    "speaker": "Player",
                                                                    "text": "可、可以吗？"
                                                                },
                                                                {
                                                                    "id": "746910142",
                                                                    "speaker": "派蒙",
                                                                    "text": "哈哈…这样应该也算是扰乱命运的轨迹吧…"
                                                                },
                                                                {
                                                                    "id": "746910143",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "#嗯…这群人本就和{NICKNAME}有所关联，从理论上来说，命运也已经纠缠在了一起…"
                                                                },
                                                                {
                                                                    "id": "746910144",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "#由{NICKNAME}出面，将他们请过来，倒是对占卜影响不大…"
                                                                },
                                                                {
                                                                    "id": "746910145",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "#不愧是{NICKNAME}，果然可靠，为了聚会，这件事就拜托你们啦，我保证给你们留两个离蛋糕最近的好位置！"
                                                                },
                                                                {
                                                                    "id": "746910146",
                                                                    "speaker": "艾莉丝",
                                                                    "text": "…芭比，你怎么开始撕纸了，要做什么？"
                                                                },
                                                                {
                                                                    "id": "746910147",
                                                                    "speaker": "芭比洛斯",
                                                                    "text": "我要塞住我的耳朵，你和尼可两个人一个吵耳朵，一个吵脑子。天哪，我真想念欧科塔维亚…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746910118",
                                                            "text": "艾莉丝？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746910106",
                                            "text": "世界终于被嘟嘟可占领了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746910103",
                            "text": "应该是之前看了太多的嘟嘟可吧。"
                        }
                    ]
                }
            ]
        }
    ]
}