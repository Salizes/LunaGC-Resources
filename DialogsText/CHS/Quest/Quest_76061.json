    "talks": [
        {
            "id": "7606101",
            "objective": "(test)(test)废弃$UNRELEASED",
            "dialogues": [
                {
                    "id": "760520101",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "760520102",
                    "speaker": "派蒙",
                    "text": "哥伦比娅，你还好吗？看上去有点没精打采呢。"
                },
                {
                    "id": "760520103",
                    "speaker": "「少女」",
                    "text": "是你们啊。我没事…"
                },
                {
                    "id": "760520104",
                    "speaker": "Player",
                    "text": "（是又在思考关于「月亮」的问题了吗…）"
                },
                {
                    "id": "760520105",
                    "speaker": "Player",
                    "text": "有什么能为你做的吗？"
                },
                {
                    "id": "760520106",
                    "speaker": "「少女」",
                    "text": "我…"
                },
                {
                    "id": "760520107",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "760520108",
                    "speaker": "派蒙",
                    "text": "没关系，就算只是些小烦恼，说出来也会好些哦。"
                },
                {
                    "id": "760520109",
                    "speaker": "「少女」",
                    "text": "我有点…想喝酒馆里的饮品。"
                },
                {
                    "id": "760520110",
                    "speaker": "派蒙",
                    "text": "欸？"
                },
                {
                    "id": "760520111",
                    "speaker": "「少女」",
                    "text": "…唔。"
                },
                {
                    "id": "760520112",
                    "speaker": "派蒙",
                    "text": "抱歉！刚才我有点惊讶。因为你很少会提你自己想要什么东西嘛…"
                },
                {
                    "id": "760520113",
                    "speaker": "派蒙",
                    "text": "而且，居然只是…饮品。"
                },
                {
                    "id": "760520114",
                    "speaker": "Player",
                    "text": "是觉得太简单了吗？"
                },
                {
                    "id": "760520115",
                    "speaker": "派蒙",
                    "text": "可能我以为至少也得是「为我摘下月亮吧」这种级别的愿望…"
                },
                {
                    "id": "760520116",
                    "speaker": "派蒙",
                    "text": "啊，不过我似乎可以理解。现在哥伦比娅无法随心所欲地行动，去酒馆说不定和摘月亮差不多难呢…"
                },
                {
                    "id": "760520117",
                    "speaker": "「少女」",
                    "text": "不只是现在。以前在「愚人众」的时候没人要抓我，但出门散步的时候，大家还是躲得远远的。"
                },
                {
                    "id": "760520118",
                    "speaker": "Player",
                    "text": "（执行官第三席…这个名号的确会让不了解她的人害怕吧…）"
                },
                {
                    "id": "760520119",
                    "speaker": "派蒙",
                    "text": "咦？不过…我突然觉得这愿望也不是那么难！"
                },
                {
                    "id": "760520120",
                    "speaker": "派蒙",
                    "text": "#只要求酒馆水平的饮品的话，{NICKNAME}，你不是就会做嘛！"
                },
                {
                    "id": "760520121",
                    "speaker": "「少女」",
                    "text": "…真的？"
                },
                {
                    "id": "760520122",
                    "speaker": "派蒙",
                    "text": "看你那么期待的样子，我反倒要紧张起来了…"
                },
                {
                    "id": "760520123",
                    "speaker": "Player",
                    "text": "口味上有要求吗？"
                },
                {
                    "id": "760520124",
                    "speaker": "「少女」",
                    "text": "口味…"
                },
                {
                    "id": "760520125",
                    "speaker": "「少女」",
                    "text": "我没怎么尝试过外面的饮品，反而给不出具体的方向…"
                },
                {
                    "id": "760520126",
                    "speaker": "「少女」",
                    "text": "不要太厚重的？"
                },
                {
                    "id": "760520127",
                    "speaker": "派蒙",
                    "text": "厚重是什么意思？"
                },
                {
                    "id": "760520128",
                    "speaker": "「少女」",
                    "text": "像「愚人众」的大衣一样。"
                },
                {
                    "id": "760520129",
                    "speaker": "派蒙",
                    "text": "怎么越比喻还越模糊了啊！",
                    "choices": [
                        {
                            "id": "760520130",
                            "text": "大概是想要清香淡雅的饮品…",
                            "response": [
                                {
                                    "id": "760520132",
                                    "speaker": "「少女」",
                                    "text": "好啊。交给你定。"
                                }
                            ]
                        },
                        {
                            "id": "760520131",
                            "text": "交给我吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7606102",
            "objective": "(test)前往调酒$UNRELEASED",
            "dialogues": [
                {
                    "id": "760520201",
                    "speaker": "「少女」",
                    "text": "嗯…"
                },
                {
                    "id": "760520202",
                    "speaker": "派蒙",
                    "text": "怎么样怎么样？"
                },
                {
                    "id": "760520203",
                    "speaker": "「少女」",
                    "text": "它让我回想起了非常久远的过去，那时我和「霜月之子」生活在一起…"
                },
                {
                    "id": "760520204",
                    "speaker": "「少女」",
                    "text": "他们习惯将新鲜的薄荷叶、香料和浆果干共同冲泡，制成具有混合风味的饮品。"
                },
                {
                    "id": "760520205",
                    "speaker": "「少女」",
                    "text": "每次经过窗边的时候，我总会闻见小屋里飘出淡淡的草木清香…"
                },
                {
                    "id": "760520206",
                    "speaker": "派蒙",
                    "text": "后来呢？你尝了吗？"
                },
                {
                    "id": "760520207",
                    "speaker": "「少女」",
                    "text": "试过，但没喝成。"
                },
                {
                    "id": "760520208",
                    "speaker": "派蒙",
                    "text": "欸？为什么…"
                },
                {
                    "id": "760520209",
                    "speaker": "「少女」",
                    "text": "「神明大人」突然说出「能尝尝你家的茶吗？」这种话之后…没人敢真的将家中的「粗茶」献上…"
                },
                {
                    "id": "760520210",
                    "speaker": "派蒙",
                    "text": "啊，也是呢…"
                },
                {
                    "id": "760520211",
                    "speaker": "「少女」",
                    "text": "最后到我手中，就变成了在华美包装下「献予神明」的「贡品」。"
                },
                {
                    "id": "760520212",
                    "speaker": "「少女」",
                    "text": "不是说它难喝。但…它少了某种我路过窗边时闻到的…温馨的味道。"
                },
                {
                    "id": "760520213",
                    "speaker": "Player",
                    "text": "现在可以喝个够了。"
                },
                {
                    "id": "760520214",
                    "speaker": "「少女」",
                    "text": "嗯…"
                },
                {
                    "id": "760520215",
                    "speaker": "「少女」",
                    "text": "很美味。"
                },
                {
                    "id": "760520216",
                    "speaker": "「少女」",
                    "text": "…不过，倒是很少见到加入牛奶的做法。"
                },
                {
                    "id": "760520217",
                    "speaker": "派蒙",
                    "text": "毕竟是从蒙德带来的配方嘛，他们喝茶还挺喜欢加牛奶、奶油和糖的。"
                },
                {
                    "id": "760520218",
                    "speaker": "「少女」",
                    "text": "很新奇，感觉还不错。"
                },
                {
                    "id": "760520219",
                    "speaker": "派蒙",
                    "text": "呼，你喜欢就好！"
                },
                {
                    "id": "760520220",
                    "speaker": "「少女」",
                    "text": "嗯，谢谢你们。"
                },
                {
                    "id": "760520221",
                    "speaker": "「少女」",
                    "text": "原来不止月光能映照往事，饮品的芳香，也能唤起深藏于过去的风景…"
                }
            ]
        },
        {
            "id": "7606103",
            "objective": "(test)喝完后评价$UNRELEASED",
            "dialogues": [
                {
                    "id": "760520301",
                    "speaker": "「少女」",
                    "text": "(test)调的还行吧，一般合我胃口"
                }
            ]
        }
    ]
}