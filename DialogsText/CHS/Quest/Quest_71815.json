    "talks": [
        {
            "id": "7181519",
            "objective": "（活动开启任务）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181501",
            "objective": "与望雅对话",
            "dialogues": [
                {
                    "id": "718150101",
                    "speaker": "望雅",
                    "text": "这下就准备得差不多了…"
                },
                {
                    "id": "718150102",
                    "speaker": "Player",
                    "text": "你要去做什么？"
                },
                {
                    "id": "718150103",
                    "speaker": "望雅",
                    "text": "咦？旅行者，你怎么来这里了…"
                },
                {
                    "id": "718150104",
                    "speaker": "望雅",
                    "text": "你还记得，上次我请了清昼和伯桓子同去轻策庄的事吧。"
                },
                {
                    "id": "718150105",
                    "speaker": "望雅",
                    "text": "清昼和伯桓子已经先去轻策庄了，如果你想去看看的话就过去吧。"
                },
                {
                    "id": "718150106",
                    "speaker": "望雅",
                    "text": "我还要在这里处理最后一件事，处理好了之后，我也会去轻策庄的。",
                    "choices": [
                        {
                            "id": "718150107",
                            "text": "总感觉，你有处理不完的事…",
                            "response": [
                                {
                                    "id": "718150109",
                                    "speaker": "望雅",
                                    "text": "啊…这也是没办法的事，海灯节期间，总务司要处理的事格外多。"
                                },
                                {
                                    "id": "718150110",
                                    "speaker": "望雅",
                                    "text": "今天是因为总务司要往另外一个地方发节日物资，要在望舒客栈做中转。"
                                },
                                {
                                    "id": "718150111",
                                    "speaker": "望雅",
                                    "text": "我正好在这里，就帮他们盯一会…"
                                },
                                {
                                    "id": "718150112",
                                    "speaker": "望雅",
                                    "text": "你先去轻策庄吧，等他们来了，我帮他们把物资清点一下就过来，应该花不了太多时间。"
                                }
                            ]
                        },
                        {
                            "id": "718150108",
                            "text": "总感觉，你海灯节忙个不停…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181502",
            "objective": "寻找伯桓子",
            "dialogues": [
                {
                    "id": "718150201",
                    "speaker": "若心",
                    "text": "嗯…不错，这字真不错，您这一手字，是我见过最好的了。"
                },
                {
                    "id": "718150202",
                    "speaker": "伯桓子",
                    "text": "哈哈哈，您客气了，我也只会这么一手而已…您还要写什么？"
                },
                {
                    "id": "718150203",
                    "speaker": "Player",
                    "text": "你已经在写了吗？"
                },
                {
                    "id": "718150204",
                    "speaker": "伯桓子",
                    "text": "是你啊，我才刚过来不久。要我帮忙写字的人还挺多的，我得抓紧点时间。"
                },
                {
                    "id": "718150205",
                    "speaker": "伯桓子",
                    "text": "清昼也过来了，你来的时候看见他了吗？",
                    "choices": [
                        {
                            "id": "718150206",
                            "text": "没有看见…",
                            "response": [
                                {
                                    "id": "718150208",
                                    "speaker": "伯桓子",
                                    "text": "唔…我们俩一起来的轻策庄，但他一直是一副发愁的样子。"
                                },
                                {
                                    "id": "718150209",
                                    "speaker": "伯桓子",
                                    "text": "我问他有什么烦心事，他只是说没有灵感，还一个劲地叹气。"
                                },
                                {
                                    "id": "718150210",
                                    "speaker": "伯桓子",
                                    "text": "进了轻策庄之后，我去帮人写字，他说想自己四处逛逛，我们两个就分开了。"
                                },
                                {
                                    "id": "718150211",
                                    "speaker": "伯桓子",
                                    "text": "你要是想找他的话，就去找其他人问问吧。"
                                },
                                {
                                    "id": "718150212",
                                    "speaker": "伯桓子",
                                    "text": "然后你再顺便帮我送几盏写好了字的霄灯吧，要送的人我给你标好…"
                                },
                                {
                                    "id": "718150213",
                                    "speaker": "伯桓子",
                                    "text": "我接着在这里写字，这些霄灯就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "718150207",
                            "text": "他没和你一起吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181503",
            "objective": "将霄灯送给鬼伯伯",
            "dialogues": [
                {
                    "id": "718150301",
                    "speaker": "鬼伯伯",
                    "text": "你好，年轻人，有什么事吗？"
                },
                {
                    "id": "718150302",
                    "speaker": "Player",
                    "text": "关于伯桓子写好字的霄灯…"
                },
                {
                    "id": "718150303",
                    "speaker": "鬼伯伯",
                    "text": "噢…对，我是拜托那位先生写了一盏霄灯，这就是吗？"
                },
                {
                    "id": "718150304",
                    "speaker": "鬼伯伯",
                    "text": "真不错…谢谢你帮忙拿过来，等会我也要去谢谢那位先生去。"
                },
                {
                    "id": "718150305",
                    "speaker": "Player",
                    "text": "请问你看见清昼了吗？"
                },
                {
                    "id": "718150306",
                    "speaker": "鬼伯伯",
                    "text": "清昼…你是说那大诗人吗？我看见了，他之前来过这里，皱着眉头，不知道在想什么呢。"
                },
                {
                    "id": "718150307",
                    "speaker": "鬼伯伯",
                    "text": "唔…再多我就不知道了，你再去找别人问问吧。"
                }
            ]
        },
        {
            "id": "7181505",
            "objective": "将霄灯送给路爷",
            "dialogues": [
                {
                    "id": "718150501",
                    "speaker": "路爷",
                    "text": "欢迎来到「范木堂」，有什么要定制的吗？"
                },
                {
                    "id": "718150502",
                    "speaker": "Player",
                    "text": "关于伯桓子写好字的霄灯…"
                },
                {
                    "id": "718150503",
                    "speaker": "路爷",
                    "text": "已经写好了？我看看…"
                },
                {
                    "id": "718150504",
                    "speaker": "路爷",
                    "text": "哎哟，真不错，这字写得真不错…"
                },
                {
                    "id": "718150505",
                    "speaker": "Player",
                    "text": "请问你看见清昼了吗？"
                },
                {
                    "id": "718150506",
                    "speaker": "路爷",
                    "text": "你说那个诗人啊，我之前遇见他了，我记得…他是和几个孩子出去了。"
                },
                {
                    "id": "718150507",
                    "speaker": "路爷",
                    "text": "再具体的事我就不清楚了，你要找他的话，再去问问别人吧。"
                }
            ]
        },
        {
            "id": "7181504",
            "objective": "将霄灯送给寒锋",
            "dialogues": [
                {
                    "id": "718150401",
                    "speaker": "寒锋",
                    "text": "你好，你找我有什么事吗？"
                },
                {
                    "id": "718150402",
                    "speaker": "Player",
                    "text": "关于伯桓子写好字的霄灯…"
                },
                {
                    "id": "718150403",
                    "speaker": "寒锋",
                    "text": "已经写好了？我看看…"
                },
                {
                    "id": "718150404",
                    "speaker": "寒锋",
                    "text": "哎，真好，那位先生写字可真有一手…"
                },
                {
                    "id": "718150405",
                    "speaker": "Player",
                    "text": "请问你看见清昼了吗？"
                },
                {
                    "id": "718150406",
                    "speaker": "寒锋",
                    "text": "清昼？我看见了，他刚才和几个孩子路过这里。"
                },
                {
                    "id": "718150407",
                    "speaker": "寒锋",
                    "text": "说是…要出去玩点什么，我还奇怪了，这个大诗人能和孩子们玩什么…"
                },
                {
                    "id": "718150408",
                    "speaker": "寒锋",
                    "text": "你往那边走走吧，应该很容易就能找到他。"
                }
            ]
        },
        {
            "id": "7181506",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "718150601",
                    "speaker": "清昼",
                    "text": "如此…不行，要再精巧点才是…"
                },
                {
                    "id": "718150602",
                    "speaker": "清昼",
                    "text": "不对…不对不对，太晦涩了些，只怕看着没有半点趣味…"
                },
                {
                    "id": "718150603",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "718150604",
                    "speaker": "清昼",
                    "text": "是你啊，我正在给这些孩子们想「灯谜」呢。"
                },
                {
                    "id": "718150605",
                    "speaker": "Player",
                    "text": "灯…什么？"
                },
                {
                    "id": "718150606",
                    "speaker": "清昼",
                    "text": "你不知道吗？唔，算是一个小游戏吧。"
                },
                {
                    "id": "718150607",
                    "speaker": "清昼",
                    "text": "就是在每盏霄灯上写一小段谜语，谁猜对了谜语，这盏霄灯就归谁。"
                },
                {
                    "id": "718150608",
                    "speaker": "清昼",
                    "text": "我正在想这三首灯谜，那些孩子们还非要给这些灯谜加点「彩头」…"
                },
                {
                    "id": "718150609",
                    "speaker": "清昼",
                    "text": "呵呵，「彩头」…也不知道这个词是谁教他们的。",
                    "choices": [
                        {
                            "id": "718150610",
                            "text": "那你和梵米尔的比试怎么办？",
                            "response": [
                                {
                                    "id": "718150612",
                                    "speaker": "清昼",
                                    "text": "比试…唉，说来惭愧，从约定好比试的那一天起，我就在不停思索…"
                                },
                                {
                                    "id": "718150613",
                                    "speaker": "清昼",
                                    "text": "到底什么样的诗，才能同时概括璃月港和海灯节，我无论如何都找不到一丝灵感…"
                                },
                                {
                                    "id": "718150614",
                                    "speaker": "清昼",
                                    "text": "我之所以接受了望雅的邀请，也是因为想要来这里再取取材，看看能不能找到灵感。",
                                    "choices": [
                                        {
                                            "id": "718150615",
                                            "text": "你要用猜灯谜来取材吗？",
                                            "response": [
                                                {
                                                    "id": "718150617",
                                                    "speaker": "清昼",
                                                    "text": "哈哈哈，不需为我担心，如果写不出来，那就是我诗才有限。"
                                                },
                                                {
                                                    "id": "718150618",
                                                    "speaker": "清昼",
                                                    "text": "不过，这些灯谜倒是和取材没有关系。"
                                                },
                                                {
                                                    "id": "718150619",
                                                    "speaker": "清昼",
                                                    "text": "我看这群孩子们没有亲人陪伴，也没有机会外出游玩，明明是海灯节，这里却始终缺了点节日气息…"
                                                },
                                                {
                                                    "id": "718150620",
                                                    "speaker": "清昼",
                                                    "text": "所以我就想要写几段灯谜，来陪他们玩玩，这样也算是有些过节的氛围。"
                                                },
                                                {
                                                    "id": "718150621",
                                                    "speaker": "清昼",
                                                    "text": "先不说这些了，我刚才已经想好了三首灯谜，现在要做三盏霄灯才好…"
                                                },
                                                {
                                                    "id": "718150622",
                                                    "speaker": "清昼",
                                                    "text": "旅行者，能拜托你帮我取三份做霄灯的材料来吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718150616",
                                            "text": "在这里真的能取到材吗…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718150611",
                            "text": "你还记得你和梵米尔约定的比试吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181508",
            "objective": "（test）判断交付完成$HIDDEN",
            "dialogues": [
                {
                    "id": "718150801",
                    "speaker": "清昼",
                    "text": "嗯，不错，稍等…我把霄灯做好，再把灯谜写上。"
                },
                {
                    "id": "718150806",
                    "speaker": "清昼",
                    "text": "好了，这样就可以了。",
                    "choices": [
                        {
                            "id": "718150802",
                            "text": "这霄灯…",
                            "response": [
                                {
                                    "id": "718150804",
                                    "speaker": "清昼",
                                    "text": "嗨…璃月人谁不会编个霄灯，我这编霄灯的手艺也只能算是一般水平…"
                                },
                                {
                                    "id": "718150805",
                                    "speaker": "清昼",
                                    "text": "那群孩子们已经过去猜灯谜了，你要有兴趣的话，也过去看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "718150803",
                            "text": "你还有这手艺…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181507",
            "objective": "将三份制作霄灯的材料交给清昼",
            "dialogues": []
        },
        {
            "id": "7181518",
            "objective": "刷出宵灯$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181509",
            "objective": "猜猜第一个灯谜",
            "dialogues": [
                {
                    "id": "718150901",
                    "speaker": "灯谜",
                    "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
                },
                {
                    "id": "718150902",
                    "speaker": "灯谜",
                    "text": "「莫道此生沉黑海，身中自有大光明。」"
                },
                {
                    "id": "718150903",
                    "speaker": "派蒙",
                    "text": "这、这就是灯谜吗？好难…你有什么头绪吗？"
                },
                {
                    "id": "718150904",
                    "speaker": "灯谜",
                    "text": "「竹骨石肌一身轻，不听菱歌听衡经。」"
                },
                {
                    "id": "718150905",
                    "speaker": "灯谜",
                    "text": "「莫道此生沉黑海，身中自有大光明。」",
                    "choices": [
                        {
                            "id": "718150906",
                            "text": "水煮鱼。",
                            "response": [
                                {
                                    "id": "718150909",
                                    "speaker": "清昼",
                                    "text": "唔…猜得不对，还是再想想吧。"
                                }
                            ]
                        },
                        {
                            "id": "718150907",
                            "text": "霄灯。",
                            "response": [
                                {
                                    "id": "718150910",
                                    "speaker": "清昼",
                                    "text": "不错，正确的谜底就是这个。"
                                },
                                {
                                    "id": "718150911",
                                    "speaker": "清昼",
                                    "text": "霄灯正是竹骨石肌所做，放飞后浮空而行，这衡经说的也正是「玑衡经」，正是「不听菱歌听衡经」。"
                                },
                                {
                                    "id": "718150913",
                                    "speaker": "清昼",
                                    "text": "霄灯放飞后，虽然浮生石不坏，但灯罩本身会坏，坏掉的灯罩坠入海中后，就是「此生沉黑海」了。"
                                },
                                {
                                    "id": "718150914",
                                    "speaker": "清昼",
                                    "text": "但即便如此，寄托在霄灯上的愿望也不会消逝…这就是「身中自有大光明」。"
                                },
                                {
                                    "id": "718150915",
                                    "speaker": "小六",
                                    "text": "欸…是这么解的吗？完全想不到…"
                                },
                                {
                                    "id": "718150916",
                                    "speaker": "小六",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好厉害，那…这个礼物给你！"
                                },
                                {
                                    "id": "718150917",
                                    "speaker": "小六",
                                    "text": "我听人家说，猜对了灯谜都要给「彩头」的…这个给你，就当做是「彩头」吧。"
                                }
                            ]
                        },
                        {
                            "id": "718150908",
                            "text": "派蒙。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181510",
            "objective": "猜猜第二个灯谜",
            "dialogues": [
                {
                    "id": "718151001",
                    "speaker": "灯谜",
                    "text": "「本由竹胎石胆造，登天照夜如日归。」"
                },
                {
                    "id": "718151002",
                    "speaker": "灯谜",
                    "text": "「一声震得人方恐，回首相看已化灰。」"
                },
                {
                    "id": "718151003",
                    "speaker": "派蒙",
                    "text": "咦？这个感觉还挺简单的，好好想想吧。"
                },
                {
                    "id": "718151004",
                    "speaker": "灯谜",
                    "text": "「本由竹胎石胆造，登天照夜如日归。」"
                },
                {
                    "id": "718151005",
                    "speaker": "灯谜",
                    "text": "「一声震得人方恐，回首相看已化灰。」",
                    "choices": [
                        {
                            "id": "718151006",
                            "text": "霄灯。",
                            "response": [
                                {
                                    "id": "718151009",
                                    "speaker": "清昼",
                                    "text": "唔…猜得不对，还是再想想吧。"
                                }
                            ]
                        },
                        {
                            "id": "718151007",
                            "text": "兔兔伯爵。"
                        },
                        {
                            "id": "718151008",
                            "text": "爆竹。",
                            "response": [
                                {
                                    "id": "718151010",
                                    "speaker": "清昼",
                                    "text": "不错，正确的谜底就是这个。哈哈哈，这个应该挺简单的，竹胎石胆，登天照夜…"
                                },
                                {
                                    "id": "718151011",
                                    "speaker": "清昼",
                                    "text": "还有「一声震得人方恐」，除了爆竹之外，也不会是别的了。"
                                },
                                {
                                    "id": "718151012",
                                    "speaker": "阿佐",
                                    "text": "啊…啊！对啊！我怎么没想到…"
                                },
                                {
                                    "id": "718151013",
                                    "speaker": "阿佐",
                                    "text": "既然你猜对了灯谜…那这个给你，收下吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181511",
            "objective": "猜猜第三个灯谜",
            "dialogues": [
                {
                    "id": "718151101",
                    "speaker": "灯谜",
                    "text": "「岩上万民仰能见，裹挟东风上云间。」"
                },
                {
                    "id": "718151102",
                    "speaker": "灯谜",
                    "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」"
                },
                {
                    "id": "718151103",
                    "speaker": "派蒙",
                    "text": "呃，这个该怎么解啊…"
                },
                {
                    "id": "718151104",
                    "speaker": "灯谜",
                    "text": "「岩上万民仰能见，裹挟东风上云间。」"
                },
                {
                    "id": "718151105",
                    "speaker": "灯谜",
                    "text": "「游丝一断浑无力，扑棱坠地懒拾捡。」",
                    "choices": [
                        {
                            "id": "718151106",
                            "text": "蒲公英。",
                            "response": [
                                {
                                    "id": "718151109",
                                    "speaker": "清昼",
                                    "text": "唔…猜得不对，还是再想想吧。"
                                }
                            ]
                        },
                        {
                            "id": "718151107",
                            "text": "正在用风之翼滑翔的冒险家…"
                        },
                        {
                            "id": "718151108",
                            "text": "风筝。",
                            "response": [
                                {
                                    "id": "718151110",
                                    "speaker": "清昼",
                                    "text": "不错，正确的谜底就是这个，要「裹挟东风」才能「上云间」…"
                                },
                                {
                                    "id": "718151111",
                                    "speaker": "清昼",
                                    "text": "而且，还牵着「游丝」的，自然就是「风筝」了。"
                                },
                                {
                                    "id": "718151112",
                                    "speaker": "阿佑",
                                    "text": "咦？为什么是这个，我想想…"
                                },
                                {
                                    "id": "718151113",
                                    "speaker": "阿佑",
                                    "text": "#好像还真是…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你是怎么想出来的？好厉害…"
                                },
                                {
                                    "id": "718151114",
                                    "speaker": "阿佑",
                                    "text": "既然你猜对了灯谜，那这个给你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181512",
            "objective": "与清昼对话",
            "dialogues": [
                {
                    "id": "718151201",
                    "speaker": "清昼",
                    "text": "你能把三个灯谜都猜对，看来你确实也算得上才思敏捷。"
                },
                {
                    "id": "718151202",
                    "speaker": "清昼",
                    "text": "啊…对了，虽然一般来说，要把霄灯送给猜对了灯谜的人，但这几盏霄灯我可不能送你…"
                },
                {
                    "id": "718151203",
                    "speaker": "清昼",
                    "text": "要是我再编三盏霄灯，手非得废了不可，咳…这些东西给你，收下吧。"
                },
                {
                    "id": "718151204",
                    "speaker": "清昼",
                    "text": "看那些孩子们意犹未尽的样子，看起来三个灯谜不够啊…我得再想几个灯谜才行。",
                    "choices": [
                        {
                            "id": "718151205",
                            "text": "那首诗的灵感…",
                            "response": [
                                {
                                    "id": "718151207",
                                    "speaker": "清昼",
                                    "text": "……"
                                },
                                {
                                    "id": "718151208",
                                    "speaker": "清昼",
                                    "text": "不需担心，那首诗…只能算是我心中一点小意气，虚无缥缈。"
                                },
                                {
                                    "id": "718151209",
                                    "speaker": "清昼",
                                    "text": "但是这群孩子们，可是实打实地在等着我给他们出灯谜。"
                                },
                                {
                                    "id": "718151210",
                                    "speaker": "清昼",
                                    "text": "我先陪着这群孩子们玩个够，等那个画家来了，我会和他说的。"
                                },
                                {
                                    "id": "718151211",
                                    "speaker": "清昼",
                                    "text": "哦对了，看看时间，望雅应该也快到了，请你帮我去接一下她吧，我接着在这里给这群孩子们出灯谜。"
                                }
                            ]
                        },
                        {
                            "id": "718151206",
                            "text": "梵米尔说不定已经…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181513",
            "objective": "与望雅对话",
            "dialogues": [
                {
                    "id": "718152001",
                    "speaker": "望雅",
                    "text": "总算是到了…旅行者？你看见清昼和伯桓子了吗？"
                },
                {
                    "id": "718152002",
                    "speaker": "Player",
                    "text": "关于清昼和伯桓子…"
                },
                {
                    "id": "718152003",
                    "speaker": "望雅",
                    "text": "这样啊…那太好了，我还担心我不来没人安排呢。"
                },
                {
                    "id": "718152004",
                    "speaker": "望雅",
                    "text": "总务司那边要转运的货物实在是有点多，我帮忙点了半天才点好。"
                },
                {
                    "id": "718152005",
                    "speaker": "望雅",
                    "text": "点好之后，我就马上往这边赶了，没想到还是到了这个时间才到…"
                },
                {
                    "id": "718152006",
                    "speaker": "望雅",
                    "text": "不过听你说的，好像也不需要我安排什么了。"
                },
                {
                    "id": "718152007",
                    "speaker": "望雅",
                    "text": "我等会再去找他们，我们先慢慢往上散会步吧。"
                }
            ]
        },
        {
            "id": "7181514",
            "objective": "跟随望雅",
            "dialogues": []
        },
        {
            "id": "7181515",
            "objective": "与望雅对话",
            "dialogues": [
                {
                    "id": "718152101",
                    "speaker": "望雅",
                    "text": "轻策庄…其实我小时候也来过几次。"
                },
                {
                    "id": "718152102",
                    "speaker": "望雅",
                    "text": "我还记得这里的豆腐很好吃，还有各种好玩的小木雕。"
                },
                {
                    "id": "718152103",
                    "speaker": "望雅",
                    "text": "这周围的景色也很不错，之前不少人都觉得，在这里生活是一件不错的事。"
                },
                {
                    "id": "718152104",
                    "speaker": "Player",
                    "text": "那为什么这里会…"
                },
                {
                    "id": "718152105",
                    "speaker": "望雅",
                    "text": "对于…老人们来说，轻策庄确实是一个很闲适的地方，周围都是认识的人和熟悉的事物，不会怎么改变。"
                },
                {
                    "id": "718152106",
                    "speaker": "望雅",
                    "text": "在这里呆着的时候，你有时候甚至会怀疑，时间是不是静止了。"
                },
                {
                    "id": "718152107",
                    "speaker": "望雅",
                    "text": "不过，这里也许不是那么适合年轻人吧…"
                },
                {
                    "id": "718152108",
                    "speaker": "望雅",
                    "text": "因为各种各样的原因，轻策庄里的年轻人大部分都去了璃月港里，只有老人和孩子们留在了这里。"
                },
                {
                    "id": "718152109",
                    "speaker": "Player",
                    "text": "这到底是因为…"
                },
                {
                    "id": "718152110",
                    "speaker": "望雅",
                    "text": "这件事的原因…可不是一两句话就能说清楚的。"
                },
                {
                    "id": "718152111",
                    "speaker": "望雅",
                    "text": "我们再往前走走吧。"
                }
            ]
        },
        {
            "id": "7181516",
            "objective": "跟随望雅",
            "dialogues": []
        },
        {
            "id": "7181517",
            "objective": "与望雅对话",
            "dialogues": [
                {
                    "id": "718152201",
                    "speaker": "望雅",
                    "text": "总之，不管原因是什么，轻策庄里逐渐只剩下了老人和孩子们。"
                },
                {
                    "id": "718152202",
                    "speaker": "望雅",
                    "text": "逢年过节的时候，他们也很难真正地置办起节日的氛围，虽然总务司年年都会派人送物资过来，但是…"
                },
                {
                    "id": "718152203",
                    "speaker": "望雅",
                    "text": "但是我们作为外人，能够为他们做的，也仅仅就到此为止了。"
                },
                {
                    "id": "718152204",
                    "speaker": "望雅",
                    "text": "我想，他们真正需要的…也许是家人的陪伴吧。"
                },
                {
                    "id": "718152205",
                    "speaker": "望雅",
                    "text": "如果没有亲人陪伴，那再多的娱乐和物资也…",
                    "choices": [
                        {
                            "id": "718152206",
                            "text": "……",
                            "response": [
                                {
                                    "id": "718152208",
                                    "speaker": "望雅",
                                    "text": "啊！抱歉，因为我一直在接触这方面的事，不由自主地就感慨了起来，说了这么多沉重的事！"
                                },
                                {
                                    "id": "718152209",
                                    "speaker": "望雅",
                                    "text": "不管怎么说，有清昼、伯桓子还有你帮忙，今年的轻策庄可是热闹了不少呢。"
                                },
                                {
                                    "id": "718152210",
                                    "speaker": "望雅",
                                    "text": "再次感谢你愿意帮忙，旅行者。",
                                    "choices": [
                                        {
                                            "id": "718152211",
                                            "text": "那你怎么不回家去？",
                                            "response": [
                                                {
                                                    "id": "718152213",
                                                    "speaker": "望雅",
                                                    "text": "我？我…我没办法啦，总务司在海灯节期间还要向很多地方分发物资，我还要再负责一部分…"
                                                },
                                                {
                                                    "id": "718152214",
                                                    "speaker": "望雅",
                                                    "text": "有些偏远地方的名字，说不定你都没有听过呢。"
                                                },
                                                {
                                                    "id": "718152215",
                                                    "speaker": "望雅",
                                                    "text": "而且不仅是我，我的很多同事现在也在「送霄灯」的路上呢。"
                                                },
                                                {
                                                    "id": "718152216",
                                                    "speaker": "望雅",
                                                    "text": "把「霄灯」送出去，让所有人都能够感受到节日的氛围，这就是我们的愿望和职责。"
                                                },
                                                {
                                                    "id": "718152217",
                                                    "speaker": "望雅",
                                                    "text": "至于我自己…哈哈哈，节日期间我是回不了家啦。"
                                                },
                                                {
                                                    "id": "718152218",
                                                    "speaker": "望雅",
                                                    "text": "顶多是在海灯节快要结束的时候，追着节日的尾巴请几天假，回去陪陪家里人。"
                                                },
                                                {
                                                    "id": "718152219",
                                                    "speaker": "望雅",
                                                    "text": "还好家里人都还算理解我，但这次回去，估计我妈妈又要唠叨我了…"
                                                },
                                                {
                                                    "id": "718152220",
                                                    "speaker": "望雅",
                                                    "text": "好啦旅行者，我等会还要接着去工作，请你好好享受海灯节吧。"
                                                },
                                                {
                                                    "id": "718152221",
                                                    "speaker": "望雅",
                                                    "text": "祝你海灯节玩得开心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718152212",
                                            "text": "那你家里的人…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718152207",
                            "text": "亲人…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181520",
            "objective": "废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181521",
            "objective": "废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181522",
            "objective": "废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181523",
            "objective": "废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7181507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718150701",
                    "speaker": "清昼",
                    "text": "你搜集好三份制作霄灯的材料了吗？"
                }
            ]
        },
        {
            "id": "7181582",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158201",
                    "speaker": "小六",
                    "text": "唔…好难啊…到底是什么呢…"
                }
            ]
        },
        {
            "id": "7181583",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158301",
                    "speaker": "小六",
                    "text": "原来是霄灯啊…可是「玑衡经」是什么呀…"
                }
            ]
        },
        {
            "id": "7181584",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158401",
                    "speaker": "阿佐",
                    "text": "竹胎…石胆…到底是什么意思呀…"
                }
            ]
        },
        {
            "id": "7181585",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158501",
                    "speaker": "阿佐",
                    "text": "原来是爆竹，我居然没想到…"
                }
            ]
        },
        {
            "id": "7181586",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158601",
                    "speaker": "阿佑",
                    "text": "游丝？游丝是什么呀…"
                }
            ]
        },
        {
            "id": "7181587",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718158701",
                    "speaker": "阿佑",
                    "text": "原来是风筝啊…"
                }
            ]
        },
        {
            "id": "7181591",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159101",
                    "speaker": "望雅",
                    "text": "唉，不知道清昼和伯桓子到没到轻策庄…"
                }
            ]
        },
        {
            "id": "7181592",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159201",
                    "speaker": "若心",
                    "text": "多谢您了啊，这些好字可是难得了…"
                },
                {
                    "id": "718159202",
                    "speaker": "伯桓子",
                    "text": "客气了，客气了，您稍等啊，我再写几盏…"
                }
            ]
        },
        {
            "id": "7181593",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159301",
                    "speaker": "小六",
                    "text": "唔…谜底是什么呢…猜不到…"
                },
                {
                    "id": "718159302",
                    "speaker": "阿佐",
                    "text": "哎呀，完全猜不出来…"
                },
                {
                    "id": "718159303",
                    "speaker": "阿佑",
                    "text": "头晕晕的…没什么头绪…"
                },
                {
                    "id": "718159304",
                    "speaker": "清昼",
                    "text": "呵呵，你们就好好想想吧，只要抓对了思路，一下子就能解开了。"
                }
            ]
        },
        {
            "id": "7181594",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159401",
                    "speaker": "小六",
                    "text": "叔叔！再出一个嘛，我绝对猜得出来！"
                },
                {
                    "id": "718159402",
                    "speaker": "阿佐",
                    "text": "这次我…我也能一下子就猜出来。"
                },
                {
                    "id": "718159403",
                    "speaker": "阿佑",
                    "text": "我…我也想再猜猜看…"
                },
                {
                    "id": "718159404",
                    "speaker": "清昼",
                    "text": "别急，别急，让我想想，嗯…"
                }
            ]
        },
        {
            "id": "7181595",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159501",
                    "speaker": "鬼伯伯",
                    "text": "哎呀，这字写得可真不错…"
                }
            ]
        },
        {
            "id": "7181596",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159601",
                    "speaker": "寒锋",
                    "text": "你要找清昼的话，就往外边走走吧，他和几个孩子出去玩了。"
                }
            ]
        },
        {
            "id": "7181597",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159701",
                    "speaker": "路爷",
                    "text": "这字写得真不错…"
                }
            ]
        },
        {
            "id": "7181598",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718159802",
                    "speaker": "小六",
                    "text": "不知道清昼叔叔会出什么样的灯谜…"
                },
                {
                    "id": "718159803",
                    "speaker": "阿佐",
                    "text": "我肯定能猜出来。"
                },
                {
                    "id": "718159804",
                    "speaker": "阿佑",
                    "text": "我…我努力猜一下好了…"
                }
            ]
        }
    ]
}