    "talks": [
        {
            "id": "2052001",
            "objective": "与汤米对话",
            "dialogues": [
                {
                    "id": "205200101",
                    "speaker": "汤米",
                    "text": "旅…旅行者…你…能…能不能帮帮我…"
                },
                {
                    "id": "205200102",
                    "speaker": "Player",
                    "text": "你这是怎么了…"
                },
                {
                    "id": "205200103",
                    "speaker": "汤米",
                    "text": "拜…拜托你，先帮我找个热源来…我…实在是太冷了…"
                },
                {
                    "id": "205200104",
                    "speaker": "汤米",
                    "text": "或，或者…你帮我找点热菜来也行。"
                },
                {
                    "id": "205200105",
                    "speaker": "汤米",
                    "text": "拜…拜托了，我真的冷得受不了了…"
                }
            ]
        },
        {
            "id": "2052002",
            "objective": "",
            "dialogues": [
                {
                    "id": "205200201",
                    "speaker": "Player",
                    "text": "我去帮你找个热源。"
                },
                {
                    "id": "205200202",
                    "speaker": "汤米",
                    "text": "那最好…那最好，拜托你，请快点…我感觉我马上就要被冻住了…"
                }
            ]
        },
        {
            "id": "2052003",
            "objective": "",
            "dialogues": [
                {
                    "id": "205200301",
                    "speaker": "Player",
                    "text": "我去帮你做点热菜。"
                },
                {
                    "id": "205200302",
                    "speaker": "汤米",
                    "text": "那…那也不错，那就拜托你了，请快一点…我感觉我马上就要被冻住了…"
                }
            ]
        },
        {
            "id": "2052004",
            "objective": "帮汤米寻找热源",
            "dialogues": [
                {
                    "id": "205200401",
                    "speaker": "汤米",
                    "text": "呼…这下暖和多了，谢谢你，旅行者。"
                },
                {
                    "id": "205200402",
                    "speaker": "Player",
                    "text": "你怎么会在这里？"
                },
                {
                    "id": "205200403",
                    "speaker": "汤米",
                    "text": "唉，还不是因为委托的事…我因为一件不那么容易的委托…一直呆在这个营地里。"
                },
                {
                    "id": "205200404",
                    "speaker": "汤米",
                    "text": "可老是这么待着也不是事，我就想找点事来做…"
                },
                {
                    "id": "205200405",
                    "speaker": "汤米",
                    "text": "营地的那位厨师哈里斯，说是想要拜托人去雪山里找什么「冷鲜肉」。"
                },
                {
                    "id": "205200406",
                    "speaker": "汤米",
                    "text": "他还说，只要去找那些被冰冻住的小猪就行了，不用太过深入雪山，没有任何危险…"
                },
                {
                    "id": "205200407",
                    "speaker": "汤米",
                    "text": "我觉得这件事很简单，就把这个委托接下来了。"
                },
                {
                    "id": "205200408",
                    "speaker": "汤米",
                    "text": "而且，我也是准备就这样慢慢锻炼自己，逐渐熟悉雪山的环境…"
                },
                {
                    "id": "205200409",
                    "speaker": "汤米",
                    "text": "然后再把那位…炼金术士小姐的委托给完成了。"
                },
                {
                    "id": "205200410",
                    "speaker": "汤米",
                    "text": "但没想到，我刚进雪山，没走几步就迷了路，差点被冻成冰块，还好遇见了你…"
                },
                {
                    "id": "205200411",
                    "speaker": "汤米",
                    "text": "我现在就是非常后悔…委托也没完成…"
                },
                {
                    "id": "205200412",
                    "speaker": "汤米",
                    "text": "旅行者…我感觉你好像相当熟悉雪山，能拜托你帮个忙吗？"
                },
                {
                    "id": "205200413",
                    "speaker": "汤米",
                    "text": "拜托你，只要帮我找到一份「冷鲜肉」就好，只要一份，我就能完成这个委托了。"
                },
                {
                    "id": "205200414",
                    "speaker": "Player",
                    "text": "我知道了。"
                },
                {
                    "id": "205200415",
                    "speaker": "汤米",
                    "text": "太好了，那让我把哈里斯说的冰冻住的小猪会出没的地点给你标在地图上。"
                },
                {
                    "id": "205200416",
                    "speaker": "汤米",
                    "text": "那么，我就先去山脚下的营地里等你的好消息了。"
                }
            ]
        },
        {
            "id": "2052005",
            "objective": "给汤米制作一份美味的萝卜时蔬汤",
            "dialogues": [
                {
                    "id": "205200501",
                    "speaker": "汤米",
                    "text": "你找到「冷鲜肉」了吗？"
                },
                {
                    "id": "205200502",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "205200503",
                    "speaker": "汤米",
                    "text": "太好了，这就是「冷鲜肉」吗？但是除了摸起来冷冰冰的，好像也没什么不同…"
                },
                {
                    "id": "205200504",
                    "speaker": "汤米",
                    "text": "算了，我只管完成委托就行…"
                },
                {
                    "id": "205200505",
                    "speaker": "汤米",
                    "text": "谢谢你旅行者，要不是你我就惨了。"
                },
                {
                    "id": "205200506",
                    "speaker": "汤米",
                    "text": "这些报酬请你一定要收下。"
                }
            ]
        },
        {
            "id": "2052006",
            "objective": "将美味的萝卜时蔬汤交给汤米",
            "dialogues": [
                {
                    "id": "205200601",
                    "speaker": "汤米",
                    "text": "(test)你来了，已经做好了呢，你快尝尝吧。"
                },
                {
                    "id": "205200602",
                    "speaker": "汤米",
                    "text": "(test)对了，这回多谢你的帮忙。"
                }
            ]
        },
        {
            "id": "2052007",
            "objective": "与汤米对话",
            "dialogues": []
        },
        {
            "id": "2052009",
            "objective": "寻找「冷鲜肉」",
            "dialogues": [
                {
                    "id": "205200901",
                    "speaker": "汤米",
                    "text": "已…已经找到热源了吗？我…我真的冷得受不了了…"
                }
            ]
        },
        {
            "id": "2052010",
            "objective": "将「冷鲜肉」交给汤米",
            "dialogues": []
        },
        {
            "id": "2052011",
            "objective": "（test）跟汤米一起回营地$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2052008",
            "objective": "获得「冷鲜肉」$HIDDEN",
            "dialogues": [
                {
                    "id": "205200801",
                    "speaker": "汤米",
                    "text": "这…这股热气，是萝卜时蔬汤！"
                },
                {
                    "id": "205200802",
                    "speaker": "汤米",
                    "text": "赶…赶快让我尝尝…"
                }
            ]
        },
        {
            "id": "2052010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "205201001",
                    "speaker": "汤米",
                    "text": "菜已经做…做好了吗？我…我真的冷得受不了了…"
                }
            ]
        },
        {
            "id": "2052011",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "205201101",
                    "speaker": "汤米",
                    "text": "费了这么大力气，为什么非要「冷鲜肉」不可…"
                }
            ]
        }
    ]
}