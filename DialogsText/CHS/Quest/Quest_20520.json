{
    "quest": {
        "id": "20520",
        "title": "中度冰寒",
        "description": "在雪山中，快被冻成冰块的冒险家汤米还在惦记着自己那份未完成的委托…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
