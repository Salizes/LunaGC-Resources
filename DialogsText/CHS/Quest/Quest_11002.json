        },
        {
            "id": "1100207",
            "objective": "与香菱交谈",
            "dialogues": [
                {
                    "id": "110020701",
                    "speaker": "香菱",
                    "text": "总觉得还缺点什么…",
                    "choices": [
                        {
                            "id": "110020702",
                            "text": "什么？",
                            "response": [
                                {
                                    "id": "110020704",
                                    "speaker": "香菱",
                                    "text": "嗯，少一种「噼咔」的感觉。"
                                },
                                {
                                    "id": "110020705",
                                    "speaker": "派蒙",
                                    "text": "这么一说确实不够「噼咔」呢。",
                                    "choices": [
                                        {
                                            "id": "110020706",
                                            "text": "「噼咔」？！",
                                            "response": [
                                                {
                                                    "id": "110020708",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼哼。"
                                                },
                                                {
                                                    "id": "110020709",
                                                    "speaker": "香菱",
                                                    "text": "布洛克虽然守规矩了点，但还是有很强的实力的。"
                                                },
                                                {
                                                    "id": "110020710",
                                                    "speaker": "香菱",
                                                    "text": "她一定会使用最得意的食材，想要取胜，就需要一道令人耳目一新的菜…"
                                                },
                                                {
                                                    "id": "110020711",
                                                    "speaker": "香菱",
                                                    "text": "比如凉拌海兽肉啊，干煸清心花啊，史莱姆滑野蘑菇之类的！"
                                                },
                                                {
                                                    "id": "110020712",
                                                    "speaker": "派蒙",
                                                    "text": "史、史莱姆滑野蘑菇？！"
                                                },
                                                {
                                                    "id": "110020713",
                                                    "speaker": "香菱",
                                                    "text": "哈哈，我知道听着有点奇怪，但味道绝对是一级棒！"
                                                },
                                                {
                                                    "id": "110020714",
                                                    "speaker": "香菱",
                                                    "text": "有机会做给你们尝尝吧！",
                                                    "choices": [
                                                        {
                                                            "id": "110020715",
                                                            "text": "好想吃。",
                                                            "response": [
                                                                {
                                                                    "id": "110020716",
                                                                    "speaker": "香菱",
                                                                    "text": "嘿嘿，味道不会让你失望的，就是卖相稍微有一点点奇怪。"
                                                                },
                                                                {
                                                                    "id": "110020719",
                                                                    "speaker": "香菱",
                                                                    "text": "先不说这个了，我想起来上次有个地方我还没去过。"
                                                                },
                                                                {
                                                                    "id": "110020720",
                                                                    "speaker": "香菱",
                                                                    "text": "我的直觉告诉我会有什么好东西，我们去找找看吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110020717",
                                                            "text": "不、不用了。",
                                                            "response": [
                                                                {
                                                                    "id": "110020718",
                                                                    "speaker": "香菱",
                                                                    "text": "欸？明明就很好吃的…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110020707",
                                            "text": "为什么派蒙能明白？！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110020703",
                            "text": "不够印象深刻吗？"
                        }
                    ]
                }
            ]
        }
    ]
