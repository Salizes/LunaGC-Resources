{
    "quest": {
        "id": "22102",
        "title": "花洲有客栈",
        "description": "因为望舒客栈周围时常有魔物侵扰，淮安正在为此发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 20,
        "total_speaker_counts": {
            "Player": 5,
            "淮安": 15
        }
    },
    "talks": [
        {
            "id": "2210201",
            "objective": "与淮安对话",
            "dialogues": [
                {
                    "id": "221020101",
                    "speaker": "淮安",
                    "text": "真是麻烦哪…"
                },
                {
                    "id": "221020102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221020103",
                    "speaker": "淮安",
                    "text": "您看我这黑眼圈，我已经多少天没睡过好觉了…"
                },
                {
                    "id": "221020104",
                    "speaker": "淮安",
                    "text": "您见过客栈里的客人吗？那真是，一个比一个会折腾，我们这客栈这么高，也真有人敢往下跳…"
                },
                {
                    "id": "221020105",
                    "speaker": "淮安",
                    "text": "算了，我刚从城里订了批菜，现在估计快要到了。"
                },
                {
                    "id": "221020106",
                    "speaker": "淮安",
                    "text": "这路上的怪物啊，肯定也不会乖乖休息，能劳烦您帮我去清一清路吗？",
                    "choices": [
                        {
                            "id": "221020107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221020109",
                                    "speaker": "淮安",
                                    "text": "那就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "221020108",
                            "text": "这家客栈…",
                            "response": [
                                {
                                    "id": "221020110",
                                    "speaker": "淮安",
                                    "text": "「广收天下客，遍听四海声」…我是这么想来着。"
                                },
                                {
                                    "id": "221020111",
                                    "speaker": "淮安",
                                    "text": "不过，其实也就是间客栈，就是地方偏了点，客人多了点，没什么了不起的。"
                                },
                                {
                                    "id": "221020112",
                                    "speaker": "淮安",
                                    "text": "那么，就万事拜托您了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210202",
            "objective": "清剿附近的魔物",
            "dialogues": [
                {
                    "id": "221020201",
                    "speaker": "淮安",
                    "text": "怎么样？周围的怪物都清干净了吗？"
                },
                {
                    "id": "221020202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "221020203",
                    "speaker": "淮安",
                    "text": "请您快些吧，这厨子快没菜下锅了。"
                },
                {
                    "id": "221020204",
                    "speaker": "淮安",
                    "text": "实在不行，我得自己出去一趟了…"
                }
            ]
        },
        {
            "id": "2210203",
            "objective": "向淮安回报",
            "dialogues": [
                {
                    "id": "221020301",
                    "speaker": "淮安",
                    "text": "怎么样？周围的怪物都清干净了吗？"
                },
                {
                    "id": "221020302",
                    "speaker": "Player",
                    "text": "已经清干净了。"
                },
                {
                    "id": "221020303",
                    "speaker": "淮安",
                    "text": "那就好，辛苦您了。"
                },
                {
                    "id": "221020304",
                    "speaker": "淮安",
                    "text": "这是报酬您拿好。要是以后路过，您记得过来光顾。"
                }
            ]
        }
    ]
}