    "talks": [
        {
            "id": "7321501",
            "objective": "",
            "dialogues": [
                {
                    "id": "732150101",
                    "speaker": "兰纳迦",
                    "text": "你好呀，朋友那菈！唔…好像要对你说什么，想不起了，可是…"
                },
                {
                    "id": "732150102",
                    "speaker": "派蒙",
                    "text": "没关系的，又看见你们就让我们很开心啦！"
                },
                {
                    "id": "732150103",
                    "speaker": "兰纳迦",
                    "text": "嗯，谢谢。",
                    "choices": [
                        {
                            "id": "732150104",
                            "text": "关于「无郁夷摩」…",
                            "response": [
                                {
                                    "id": "732150105",
                                    "speaker": "兰纳迦",
                                    "text": "她不再说话了，但是她很好。也正在恢复，森林…谢谢你们。"
                                }
                            ]
                        },
                        {
                            "id": "732150106",
                            "text": "关于遗忘…",
                            "response": [
                                {
                                    "id": "732150107",
                                    "speaker": "兰纳迦",
                                    "text": "遗忘…？嗯，因为力量耗尽了，「苦舍桓」。所以也会流走，记忆。一点一点，就像露珠一样…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321503",
            "objective": "",
            "dialogues": [
                {
                    "id": "732150301",
                    "speaker": "兰迦鲁",
                    "text": "你好，谢谢你们！金色的那菈和白飞飞！"
                },
                {
                    "id": "732150302",
                    "speaker": "兰迦鲁",
                    "text": "你们来做什么呀！"
                },
                {
                    "id": "732150303",
                    "speaker": "派蒙",
                    "text": "你说要记得回来一起玩呀！"
                },
                {
                    "id": "732150304",
                    "speaker": "兰迦鲁",
                    "text": "唔，我这么说过吗…？",
                    "choices": [
                        {
                            "id": "732150305",
                            "text": "你说过的。",
                            "response": [
                                {
                                    "id": "732150306",
                                    "speaker": "兰迦鲁",
                                    "text": "这样呀…"
                                },
                                {
                                    "id": "732150309",
                                    "speaker": "兰迦鲁",
                                    "text": "不管怎样，谢谢你们！"
                                }
                            ]
                        },
                        {
                            "id": "732150307",
                            "text": "怎么，不开心吗？",
                            "response": [
                                {
                                    "id": "732150308",
                                    "speaker": "兰迦鲁",
                                    "text": "唔…没有哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7321504",
            "objective": "",
            "dialogues": [
                {
                    "id": "732150401",
                    "speaker": "兰纳迦",
                    "text": "你好呀，金色的那菈和白飞飞！"
                },
                {
                    "id": "732150402",
                    "speaker": "派蒙",
                    "text": "你好！最近怎么样呀！"
                },
                {
                    "id": "732150403",
                    "speaker": "兰纳迦",
                    "text": "很好，不过为什么来这里，你们？"
                },
                {
                    "id": "732150404",
                    "speaker": "派蒙",
                    "text": "欸…？"
                },
                {
                    "id": "732150405",
                    "speaker": "兰纳迦",
                    "text": "唔…很困扰，我们。虽然一定有理由，但你们为什么来，不知道…"
                },
                {
                    "id": "732150406",
                    "speaker": "派蒙",
                    "text": "毕竟我们对这里很熟悉嘛，和你们一起经历了那么多冒险！"
                },
                {
                    "id": "732150407",
                    "speaker": "兰纳迦",
                    "text": "…？唔…是吗？"
                },
                {
                    "id": "732150408",
                    "speaker": "派蒙",
                    "text": "我们之前的经历，他不记得了呢…"
                }
            ]
        },
        {
            "id": "7321505",
            "objective": "",
            "dialogues": [
                {
                    "id": "732150501",
                    "speaker": "兰纳真",
                    "text": "你好！金色的那菈！还有你，小小白飞飞！"
                },
                {
                    "id": "732150502",
                    "speaker": "派蒙",
                    "text": "哼，我不小！也不看看你自己啦！"
                },
                {
                    "id": "732150503",
                    "speaker": "兰纳真",
                    "text": "哼哼，我也不小！唔…对了，你们来做什么呢？"
                },
                {
                    "id": "732150504",
                    "speaker": "Player",
                    "text": "只是回来看看你们。"
                },
                {
                    "id": "732150505",
                    "speaker": "派蒙",
                    "text": "对呀，毕竟我们之前打败了好多坏东西，一起唱歌，一起救了「呜咿呀」…"
                },
                {
                    "id": "732150506",
                    "speaker": "兰纳真",
                    "text": "「无郁夷摩」！"
                },
                {
                    "id": "732150507",
                    "speaker": "派蒙",
                    "text": "嗯！"
                },
                {
                    "id": "732150508",
                    "speaker": "兰纳真",
                    "text": "唔…对不起…你们说的应该是真的。但我不记得了…"
                },
                {
                    "id": "732150509",
                    "speaker": "派蒙",
                    "text": "唔…！没事，没事啦！请你不要伤心！"
                },
                {
                    "id": "732150510",
                    "speaker": "派蒙",
                    "text": "（他真的不记得了呢…）"
                }
            ]
        },
        {
            "id": "7321502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732150201",
                    "speaker": "兰纳真",
                    "text": "你好，你好！"
                },
                {
                    "id": "732150202",
                    "speaker": "派蒙",
                    "text": "你好呀，小不点！还记得我们吗！"
                },
                {
                    "id": "732150203",
                    "speaker": "兰纳真",
                    "text": "可恶的白飞飞，我不是小不点！你们还记得我教的歌吗！"
                },
                {
                    "id": "732150204",
                    "speaker": "Player",
                    "text": "当然。"
                },
                {
                    "id": "732150205",
                    "speaker": "兰纳真",
                    "text": "好哇！"
                },
                {
                    "id": "732150206",
                    "speaker": "兰纳真",
                    "text": "那你们要答应我，即使我忘记了自己的歌…你们也要记得！"
                }
            ]
        },
        {
            "id": "7321506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732150601",
                    "speaker": "兰迦鲁",
                    "text": "金色的那菈，白飞飞，你们来啦！"
                },
                {
                    "id": "732150602",
                    "speaker": "派蒙",
                    "text": "嗯！我们来啦！"
                },
                {
                    "id": "732150603",
                    "speaker": "兰迦鲁",
                    "text": "嘿嘿…我可能忘记了很多事情，所以还要你们多提醒啦…"
                },
                {
                    "id": "732150604",
                    "speaker": "Player",
                    "text": "是因为「苦舍桓」吗？"
                },
                {
                    "id": "732150605",
                    "speaker": "兰迦鲁",
                    "text": "嗯…兰纳迦应该和你们说过，力量在记忆里，没有记忆，没有力量…"
                },
                {
                    "id": "732150606",
                    "speaker": "兰迦鲁",
                    "text": "所以…我们之前一定经历过什么，但是我们不记得了…"
                },
                {
                    "id": "732150607",
                    "speaker": "兰迦鲁",
                    "text": "哈哈，不过对我来说没什么啦！我们还能重新开始新的记忆呀！对吧？"
                },
                {
                    "id": "732150608",
                    "speaker": "派蒙",
                    "text": "嗯嗯！就是这个精神没错！"
                }
            ]
        },
        {
            "id": "7321507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732150701",
                    "speaker": "兰纳迦",
                    "text": "#谢谢你们，那菈{NICKNAME}和白飞飞。不过现在，需要我们，「无郁夷摩」。"
                }
            ]
        },
        {
            "id": "7321508",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732150801",
                    "speaker": "兰纳真",
                    "text": "谢谢你们！别忘了找我们来玩呀！不过现在我们需要陪「无郁夷摩」才行，下次再来找我们吧！"
                }
            ]
        },
        {
            "id": "7321509",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732150901",
                    "speaker": "兰迦鲁",
                    "text": "#砰，砰！嘿！哈！那菈{NICKNAME}和白飞飞很强！和你们一起冒险很开心！谢谢！"
                }
            ]
        }
    ]
}