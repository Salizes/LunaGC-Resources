    },
    "talks": [
        {
            "id": "2401401",
            "objective": "与莉诺蕾娅对话",
            "dialogues": [
                {
                    "id": "240140301",
                    "speaker": "Player",
                    "text": "我去深水区。"
                },
                {
                    "id": "240140302",
                    "speaker": "莉诺蕾娅",
                    "text": "那就拜托你了。看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
                }
            ]
        },
        {
            "id": "2401402",
            "objective": "前往深水区投放鱼苗",
            "dialogues": [
                {
                    "id": "240140201",
                    "speaker": "莉诺蕾娅",
                    "text": "…这里的鱼群又减少了，难道机关鱼又开始活跃了吗？"
                },
                {
                    "id": "240140202",
                    "speaker": "莉诺蕾娅",
                    "text": "必须把鱼苗投入更深的水域才行，但潜水服怎么这个时候坏掉了…"
                },
                {
                    "id": "240140203",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "240140204",
                    "speaker": "莉诺蕾娅",
                    "text": "你好，初次见面，我叫莉诺蕾娅，是一名专职于报道环境问题的记者，正在这里…投放鱼苗。"
                },
                {
                    "id": "240140205",
                    "speaker": "派蒙",
                    "text": "欸？我们上次见到瑟米安的时候，莉诺蕾娅小姐是不是就在旁边呀？"
                },
                {
                    "id": "240140206",
                    "speaker": "Player",
                    "text": "你应该是瑟米安的…"
                },
                {
                    "id": "240140207",
                    "speaker": "莉诺蕾娅",
                    "text": "你们认识瑟米安？难道…上次就是你们帮瑟米安拿来了那些礼物？真是太感谢你们了。"
                },
                {
                    "id": "240140208",
                    "speaker": "莉诺蕾娅",
                    "text": "上次看完歌剧回家之后，瑟米安才告诉我这件事，我还一直想请你们来家里吃饭呢。"
                },
                {
                    "id": "240140209",
                    "speaker": "莉诺蕾娅",
                    "text": "没想到会在这里遇见你们，但…现在的时机可真不巧…"
                },
                {
                    "id": "240140210",
                    "speaker": "派蒙",
                    "text": "你刚才说，正在这里投放鱼苗？"
                },
                {
                    "id": "240140211",
                    "speaker": "Player",
                    "text": "为什么要投放鱼苗？"
                },
                {
                    "id": "240140212",
                    "speaker": "莉诺蕾娅",
                    "text": "…您知道有关「机关鱼」的事吗？",
                    "choices": [
                        {
                            "id": "240140213",
                            "text": "没听说过…"
                        },
                        {
                            "id": "240140214",
                            "text": "这是枫丹廷特有的鱼类吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401403",
            "objective": "前往浅水区投放鱼苗",
            "dialogues": []
        },
        {
            "id": "2401405",
            "objective": "前往浅水区投放鱼苗",
            "dialogues": [
                {
                    "id": "240140501",
                    "speaker": "莉诺蕾娅",
                    "text": "你帮我把鱼苗投入水里了吗？看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
                }
            ]
        },
        {
            "id": "2401406",
            "objective": "前往浅水区投放鱼苗",
            "dialogues": [
                {
                    "id": "240140601",
                    "speaker": "莉诺蕾娅",
                    "text": "你帮我把鱼苗投入水里了吗？"
                },
                {
                    "id": "240140602",
                    "speaker": "Player",
                    "text": "投放好了。"
                },
                {
                    "id": "240140603",
                    "speaker": "莉诺蕾娅",
                    "text": "太感谢您了。等我修好潜水服之后，就会回去继续工作。"
                },
                {
                    "id": "240140604",
                    "speaker": "Player",
                    "text": "希望那些鱼能好好长大。"
                },
                {
                    "id": "240140605",
                    "speaker": "莉诺蕾娅",
                    "text": "放心吧。针对每一片水域不同的生态环境，我们准备了许多不同种类的鱼苗。"
                },
                {
                    "id": "240140606",
                    "speaker": "莉诺蕾娅",
                    "text": "刚才你投下去的那一批鱼苗，就是专门针对这片水域的情况专门选出来的。"
                },
                {
                    "id": "240140607",
                    "speaker": "莉诺蕾娅",
                    "text": "我等一下会再投放几个批次的鱼苗，然后，我们雇佣的冒险家就会过来，扫除这片区域里的「机关鱼」。"
                },
                {
                    "id": "240140608",
                    "speaker": "莉诺蕾娅",
                    "text": "我相信这批鱼苗，一定能好好长大，让这片水域的生态环境重新恢复。"
                },
                {
                    "id": "240140609",
                    "speaker": "莉诺蕾娅",
                    "text": "等到有足够多的水域生态得到恢复。我就会写一份长篇报道。让大众知道「枫丹科学院」究竟对自然环境做了什么。"
                },
                {
                    "id": "240140610",
                    "speaker": "莉诺蕾娅",
                    "text": "等着吧，达梅婕。这次你一定不会再有机会搪塞我了！"
                }
            ]
        },
        {
            "id": "2401404",
            "objective": "向莉诺蕾娅回报",
            "dialogues": []
        },
        {
            "id": "2401401",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240140101",
                    "speaker": "莉诺蕾娅",
                    "text": "…这里的鱼群又减少了，难道机关鱼又开始活跃了吗？"
                },
                {
                    "id": "240140102",
                    "speaker": "莉诺蕾娅",
                    "text": "必须把鱼苗投入更深的水域才行，但潜水服怎么这个时候坏掉了…"
                },
                {
                    "id": "240140103",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "240140104",
                    "speaker": "莉诺蕾娅",
                    "text": "你好，初次见面，我叫莉诺蕾娅，是一名专职于报道环境问题的记者，正在这里…投放鱼苗。",
                    "choices": [
                        {
                            "id": "240140105",
                            "text": "记者？",
                            "response": [
                                {
                                    "id": "240140106",
                                    "speaker": "莉诺蕾娅",
                                    "text": "是的。就是你所理解的那种记者。但我和那些专注于公众人物花边新闻，或者是不断重复无聊消息的记者不同。"
                                },
                                {
                                    "id": "240140107",
                                    "speaker": "莉诺蕾娅",
                                    "text": "我所关注的问题，是一件枫丹廷内正在发生，危害着公众生活安全的严肃公共事件。"
                                },
                                {
                                    "id": "240140108",
                                    "speaker": "莉诺蕾娅",
                                    "text": "而这件事，也是我来这里投放鱼苗的原因。"
                                },
                                {
                                    "id": "240140110",
                                    "speaker": "莉诺蕾娅",
                                    "text": "…您知道有关「机关鱼」的事吗？",
                                    "choices": [
                                        {
                                            "id": "240140111",
                                            "text": "没听说过…"
                                        },
                                        {
                                            "id": "240140112",
                                            "text": "这是枫丹廷特有的鱼类吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240140109",
                            "text": "为什么要投放鱼苗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240140401",
                    "speaker": "Player",
                    "text": "我去浅水区。"
                },
                {
                    "id": "240140402",
                    "speaker": "莉诺蕾娅",
                    "text": "那就拜托你了。看这潜水服的状态，我暂时没法帮忙…只能看你的了。"
                }
            ]
        },
        {
            "id": "2401407",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240140701",
                    "speaker": "莉诺蕾娅",
                    "text": "哼，这种「机关鱼」是「枫丹科学院」所制造的机关产物。也是破坏枫丹廷水域生态环境的元凶！"
                },
                {
                    "id": "240140702",
                    "speaker": "莉诺蕾娅",
                    "text": "一片水域，往往有着一个平衡的生态环境，各种鱼类和生物有序地在其中生活。这种有序的生态环境，也有利于生物繁衍成长。"
                },
                {
                    "id": "240140703",
                    "speaker": "莉诺蕾娅",
                    "text": "虽然这片水域的秩序偶尔也会被打扰…比如有人来这片水域钓鱼，有外来的鱼类入侵…"
                },
                {
                    "id": "240140704",
                    "speaker": "莉诺蕾娅",
                    "text": "或者是天气变化，导致某些鱼类离开了这片水域…"
                },
                {
                    "id": "240140726",
                    "speaker": "莉诺蕾娅",
                    "text": "总体来说，这片水域里的生态环境总是保持着一个微妙的平衡。"
                },
                {
                    "id": "240140705",
                    "speaker": "莉诺蕾娅",
                    "text": "但是，自从「枫丹科学院」的那群白痴制造出了「机关鱼」之后！一切就变得一团糟！"
                },
                {
                    "id": "240140706",
                    "speaker": "莉诺蕾娅",
                    "text": "他们对外宣传，这种「机关鱼」的作用是清理水体里的垃圾和杂物，让水体保持清洁，除此之外，别无他用。"
                },
                {
                    "id": "240140707",
                    "speaker": "莉诺蕾娅",
                    "text": "最开始，这群「机关鱼」确实在清洁水体，我们所有人也都信了那群研究员的鬼话。"
                },
                {
                    "id": "240140708",
                    "speaker": "莉诺蕾娅",
                    "text": "过了一段时间之后，突然有人报告说，在投放了机关鱼的地区内，所有鱼群的数量都在不断下降！"
                },
                {
                    "id": "240140709",
                    "speaker": "莉诺蕾娅",
                    "text": "这时候我们才发现，那些「机关鱼」在清理完垃圾之后，把其他的鱼类也当做垃圾清理了！",
                    "choices": [
                        {
                            "id": "240140710",
                            "text": "原来是这种「清洁水体」吗…",
                            "response": [
                                {
                                    "id": "240140712",
                                    "speaker": "莉诺蕾娅",
                                    "text": "在我们的强烈抗议下，那群研究员才把「机关鱼」全部停机，准备收回研究。"
                                },
                                {
                                    "id": "240140713",
                                    "speaker": "莉诺蕾娅",
                                    "text": "但在他们准备回收的时候，整个「枫丹科学院」突然发生了一次巨大的爆炸…"
                                },
                                {
                                    "id": "240140714",
                                    "speaker": "莉诺蕾娅",
                                    "text": "然后，那群本来停机的「机关鱼」又有一部分开始活动了起来，开始更加猛烈地攻击同水域的鱼类。"
                                },
                                {
                                    "id": "240140715",
                                    "speaker": "莉诺蕾娅",
                                    "text": "我和几位同事认为不能再这么下去了，如果放任「机关鱼」继续肆虐，那枫丹廷内的水域生态将遭受灭顶之灾。"
                                },
                                {
                                    "id": "240140716",
                                    "speaker": "莉诺蕾娅",
                                    "text": "于是，我们在几位环境生态专家的帮助下，开始有计划地向各个水域投放合适的「鱼苗」，用人工的方式培育鱼群。"
                                },
                                {
                                    "id": "240140717",
                                    "speaker": "莉诺蕾娅",
                                    "text": "另一方面，则雇佣冒险家不断地破坏和回收「机关鱼」，用这种双管齐下的方式保护水域生态环境。",
                                    "choices": [
                                        {
                                            "id": "240140718",
                                            "text": "听起来很厉害。",
                                            "response": [
                                                {
                                                    "id": "240140720",
                                                    "speaker": "莉诺蕾娅",
                                                    "text": "谢谢夸奖。也许听起来这不是一位记者该做的事。"
                                                },
                                                {
                                                    "id": "240140721",
                                                    "speaker": "莉诺蕾娅",
                                                    "text": "但我认为，在写文章之前，记者更应该先冲去最前线，身体力行地做一些实在的事。"
                                                },
                                                {
                                                    "id": "240140727",
                                                    "speaker": "莉诺蕾娅",
                                                    "text": "从这些实在的事情里，才能获取到最真实，最有效的信息，才能写出优秀的报道。"
                                                },
                                                {
                                                    "id": "240140722",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇，好有气势的记者…"
                                                },
                                                {
                                                    "id": "240140723",
                                                    "speaker": "Player",
                                                    "text": "我能帮什么忙吗？"
                                                },
                                                {
                                                    "id": "240140724",
                                                    "speaker": "莉诺蕾娅",
                                                    "text": "欸？谢谢你的好意。我的潜水服刚好坏掉了，没法去水里投放鱼苗。"
                                                },
                                                {
                                                    "id": "240140725",
                                                    "speaker": "莉诺蕾娅",
                                                    "text": "如果你愿意的话，就请帮我去投放一下鱼苗吧…无论深水区或浅水区都行。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240140719",
                                            "text": "值得敬佩的事业。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240140711",
                            "text": "除了「水」之外，都是「垃圾」吗…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240140801",
                    "speaker": "莉诺蕾娅",
                    "text": "这些机关鱼…真见鬼！",
                    "choices": [
                        {
                            "id": "240140802",
                            "text": "发生什么了？",
                            "response": [
                                {
                                    "id": "240140804",
                                    "speaker": "莉诺蕾娅",
                                    "text": "修好过，但很快又坏了。"
                                },
                                {
                                    "id": "240140805",
                                    "speaker": "莉诺蕾娅",
                                    "text": "这片区域里的机关鱼不知道为什么，就像是发了疯一样。"
                                },
                                {
                                    "id": "240140806",
                                    "speaker": "莉诺蕾娅",
                                    "text": "我刚把鱼苗投放出去，它们就直接扑了过来，不停地吞吃着鱼苗。"
                                },
                                {
                                    "id": "240140807",
                                    "speaker": "莉诺蕾娅",
                                    "text": "因为有几只鱼苗挂在了潜水服上，所以有些机关鱼径直朝我扑了过来…"
                                },
                                {
                                    "id": "240140808",
                                    "speaker": "莉诺蕾娅",
                                    "text": "虽然我知道它们其实不会攻击我。但我…还是害怕了。"
                                },
                                {
                                    "id": "240140809",
                                    "speaker": "莉诺蕾娅",
                                    "text": "然后，我就在水里胡乱地挣扎，手脚乱挥…"
                                },
                                {
                                    "id": "240140810",
                                    "speaker": "莉诺蕾娅",
                                    "text": "不知道什么时候，又把潜水服撞出了一道大口子…还好当时离岸边不远，我用尽方法，总算是上了岸。"
                                },
                                {
                                    "id": "240140811",
                                    "speaker": "莉诺蕾娅",
                                    "text": "但看现在的情况，我暂时是无法下水继续投放鱼苗了。"
                                },
                                {
                                    "id": "240140812",
                                    "speaker": "莉诺蕾娅",
                                    "text": "旅行者，你还愿意再帮我去投放一下鱼苗吗？无论深水区或浅水区都行。"
                                }
                            ]
                        },
                        {
                            "id": "240140803",
                            "text": "你修好潜水服了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2401499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240149901",
                    "speaker": "派蒙",
                    "text": "这样应该就可以了…我们回去找莉诺蕾娅小姐吧。"
                },
                {
                    "id": "240149902",
                    "speaker": "派蒙",
                    "text": "这样应该就可以了…我们回去找莉诺蕾娅小姐吧。"
                }
            ]
        }
    ]
}