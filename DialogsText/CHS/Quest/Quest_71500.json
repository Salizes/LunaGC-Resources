    "talks": [
        {
            "id": "7150012",
            "objective": "(test)领取任务前置$HIDDEN",
            "dialogues": [
                {
                    "id": "715001201",
                    "speaker": "留云借风真君",
                    "text": "嗯，不错，这正是甘雨帮本仙置办的竹笋。"
                },
                {
                    "id": "715001202",
                    "speaker": "留云借风真君",
                    "text": "食材已经备齐了，那我们等一下就可以开始烹饪了。"
                }
            ]
        },
        {
            "id": "7150001",
            "objective": "与留云借风真君对话",
            "dialogues": [
                {
                    "id": "715000101",
                    "speaker": "留云借风真君",
                    "text": "唔…如此便好…"
                },
                {
                    "id": "715000102",
                    "speaker": "留云借风真君",
                    "text": "旅行者，你来得正巧，本仙刚把这机关给安置周全。",
                    "choices": [
                        {
                            "id": "715000103",
                            "text": "这就是…「机关烹饪神机」吗？",
                            "response": [
                                {
                                    "id": "715000104",
                                    "speaker": "留云借风真君",
                                    "text": "正是。这机关由本仙亲自设计安置，妙用无穷。"
                                },
                                {
                                    "id": "715000107",
                                    "speaker": "留云借风真君",
                                    "text": "为了制作这烹饪用机关，本仙查阅无数古籍。须知，在「烹饪」这一事中，有几件最重要的事。"
                                },
                                {
                                    "id": "715000108",
                                    "speaker": "留云借风真君",
                                    "text": "其一，寻觅食材。烹饪一事中，食材至关重要。为了搜罗珍奇的食材，无数厨师劳心劳力，四处奔波…"
                                },
                                {
                                    "id": "715000109",
                                    "speaker": "留云借风真君",
                                    "text": "本仙的机关，首先便能解决这一难题。"
                                },
                                {
                                    "id": "715000110",
                                    "speaker": "留云借风真君",
                                    "text": "只需启动这机关，它便会自动寻找周边最适合烹饪的食材，并且沿途标识出该食材的气息，厨师只需要循路前往即可。"
                                },
                                {
                                    "id": "715000111",
                                    "speaker": "Player",
                                    "text": "它不能自己去拿吗？"
                                },
                                {
                                    "id": "715000112",
                                    "speaker": "留云借风真君",
                                    "text": "咳，这个嘛…本仙研究时间尚短，暂时无法解决…锅怎么在崎岖山路上自动寻路这个问题。"
                                },
                                {
                                    "id": "715000113",
                                    "speaker": "留云借风真君",
                                    "text": "其二，即是烹煮一事。本仙在机关内设置了无数机巧物件，只需投入食材，它便会自动处理妥当。"
                                },
                                {
                                    "id": "715000114",
                                    "speaker": "Player",
                                    "text": "它怎么知道要怎样处理食材？"
                                },
                                {
                                    "id": "715000115",
                                    "speaker": "留云借风真君",
                                    "text": "这个嘛…自然是要按照对应的菜谱细细设置各项参数，将每种食材所需的处理方法都设置好。"
                                },
                                {
                                    "id": "715000116",
                                    "speaker": "留云借风真君",
                                    "text": "个中奥妙，三言两语难说清，本仙不作赘述，你们只要明白这事挺麻烦就行。"
                                },
                                {
                                    "id": "715000117",
                                    "speaker": "留云借风真君",
                                    "text": "此外，结合本仙心得，烹饪期间最令厨师们烦躁的杂事，乃是「清理锅灶」。"
                                },
                                {
                                    "id": "715000118",
                                    "speaker": "留云借风真君",
                                    "text": "否则，大快朵颐之后，还得清理锅中的残羹冷炙，实在有些煞风景…",
                                    "choices": [
                                        {
                                            "id": "715000119",
                                            "text": "这机关卖吗？",
                                            "response": [
                                                {
                                                    "id": "715000120",
                                                    "speaker": "留云借风真君",
                                                    "text": "哈哈哈，只怕你买不起本仙这玄机妙器。"
                                                },
                                                {
                                                    "id": "715000121",
                                                    "speaker": "留云借风真君",
                                                    "text": "况且，此机关目前仅能靠本仙的仙力驱动，你买回去也没什么用。"
                                                },
                                                {
                                                    "id": "715000125",
                                                    "speaker": "留云借风真君",
                                                    "text": "好了，闲话就说到这。本仙一边制作着机关，一边也研究着食谱。"
                                                },
                                                {
                                                    "id": "715000126",
                                                    "speaker": "留云借风真君",
                                                    "text": "如今机关制作完毕，本仙同时钻研出了几道世间未有之美食，用以测试「机关烹饪神机」。"
                                                },
                                                {
                                                    "id": "715000127",
                                                    "speaker": "留云借风真君",
                                                    "text": "本仙此次请你来，是想请你帮本仙几个小忙，搜罗些食材，按照这些食谱烹出菜肴。"
                                                },
                                                {
                                                    "id": "715000128",
                                                    "speaker": "留云借风真君",
                                                    "text": "第一道菜，本仙特此赐名：「文心豆腐」。"
                                                },
                                                {
                                                    "id": "715000129",
                                                    "speaker": "留云借风真君",
                                                    "text": "做这道菜需将豆腐切成纤丝…正好测试一下这机关的「刀工」。"
                                                },
                                                {
                                                    "id": "715000130",
                                                    "speaker": "留云借风真君",
                                                    "text": "至于食材么…要用到豆腐、火腿，竹笋与禽肉，本仙已托甘雨备好了食材，就在这…"
                                                },
                                                {
                                                    "id": "715000131",
                                                    "speaker": "留云借风真君",
                                                    "text": "咦？竹笋哪去了？之前明明摆在这里，难道是本仙安置机关时太过入神，被什么东西钻空子偷走了…"
                                                },
                                                {
                                                    "id": "715000132",
                                                    "speaker": "留云借风真君",
                                                    "text": "哼，不过…来吧，刚好让你们见识下「机关烹饪神机」搜寻食材的能力。"
                                                },
                                                {
                                                    "id": "715000133",
                                                    "speaker": "留云借风真君",
                                                    "text": "机关烹饪神机…启！"
                                                },
                                                {
                                                    "id": "715000134",
                                                    "speaker": "留云借风真君",
                                                    "text": "旅行者，本仙已启动机关，你且循着气息，去把本仙的竹笋拿回来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "715000122",
                                            "text": "为什么做这个机关？",
                                            "response": [
                                                {
                                                    "id": "715000123",
                                                    "speaker": "留云借风真君",
                                                    "text": "要说目的…自然是为了点拨这世间的机关之道了。"
                                                },
                                                {
                                                    "id": "715000124",
                                                    "speaker": "留云借风真君",
                                                    "text": "另一方面，有了这机关，本仙平时做菜也会方便些…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "715000105",
                            "text": "这机关有什么用？",
                            "response": [
                                {
                                    "id": "715000106",
                                    "speaker": "留云借风真君",
                                    "text": "哼，你倒是心急。稍安勿躁，待本仙慢慢为你道来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7150002",
            "objective": "跟随气息的踪迹，寻找食材",
            "dialogues": [
                {
                    "id": "715000201",
                    "speaker": "留云借风真君",
                    "text": "你们拿到竹笋了吗？"
                }
            ]
        },
        {
