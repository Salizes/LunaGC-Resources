        },
        {
            "id": "7150006",
            "objective": "协助留云借风真君完成烹饪",
            "dialogues": [
                {
                    "id": "715000601",
                    "speaker": "留云借风真君",
                    "text": "旅行者，本仙已启动机关，你且循着气息，去把本仙的竹笋拿回来吧。"
                }
            ]
        },
        {
            "id": "7150007",
            "objective": "向留云借风真君回报",
            "dialogues": []
        },
        {
            "id": "7150008",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "715000801",
                    "speaker": "留云借风真君",
                    "text": "旅行者，火候的掌控就交给你了。"
                }
            ]
        },
        {
            "id": "7150011",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "715001301",
                    "speaker": "留云借风真君",
                    "text": "嗯，不错，这机关的性能果然非比寻常！"
                },
                {
                    "id": "715001302",
                    "speaker": "留云借风真君",
                    "text": "看看这处理豆腐的机巧功夫…哈哈哈，果然不愧是本仙！"
                },
                {
                    "id": "715001303",
                    "speaker": "留云借风真君",
                    "text": "旅行者，此番辛苦你了，本仙将这「文心豆腐」的食谱抄写一份赠予你。"
                },
                {
                    "id": "715001304",
                    "speaker": "留云借风真君",
                    "text": "得闲时，你也可以亲自下厨尝试。"
                },
                {
                    "id": "715001305",
                    "speaker": "留云借风真君",
                    "text": "本仙还得再钻研钻研，调整一下机关的各项功能。"
                },
                {
                    "id": "715001306",
                    "speaker": "留云借风真君",
                    "text": "过段时日，或许要再请你来帮忙，届时，你可千万不要推辞啊。"
                }
            ]
        },
        {
            "id": "7150003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715000303",
                    "speaker": "留云借风真君",
                    "text": "其余的事就交给这机关，但是旅行者，还得请你帮忙照看一下火候。"
                },
                {
                    "id": "715000304",
                    "speaker": "Player",
                    "text": "这机关不能自动控制火候吗？"
                },
                {
                    "id": "715000305",
                    "speaker": "留云借风真君",
                    "text": "这个嘛…本仙之前也尝试过将灶火内置，想要以机关控制火候…"
                },
                {
                    "id": "715000306",
                    "speaker": "留云借风真君",
                    "text": "但「机关烹饪神机」所需的灶火不同寻常…必须得是本仙亲自操控仙力化出的火焰才行。"
                },
                {
                    "id": "715000307",
                    "speaker": "留云借风真君",
                    "text": "若是把这种等级的仙火内置，一些细小的机关部件可能会被烤得变形，导致机关失灵。因小失大，实不可取。"
                },
                {
                    "id": "715000308",
                    "speaker": "留云借风真君",
                    "text": "目前最好的解决方法，还是将仙火置于机关外部。只是如此一来，我需要一个人帮着控制火候…"
                },
                {
                    "id": "715000309",
                    "speaker": "留云借风真君",
                    "text": "兹事体大，旅行者，火候的掌控就交给你了。你准备好了之后，就来告诉本仙一声。"
                }
            ]
        },
        {
            "id": "7150007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "715000701",
                    "speaker": "留云借风真君",
                    "text": "怎么样？「文心豆腐」已经做好了吗？"
                }
            ]
        },
        {
            "id": "7150010",
            "objective": "Additional",
            "dialogues": [
                {
