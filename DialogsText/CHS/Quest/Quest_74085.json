        {
            "id": "7408520",
            "objective": "将水滴钥匙放入雕像",
            "dialogues": [
                {
                    "id": "740852001",
                    "speaker": "柯蕾特莉",
                    "text": "哥哥！快看！喷泉里好像出现了一个洞…是你在变魔术吗？！"
                },
                {
                    "id": "740852002",
                    "speaker": "勒莫迪埃",
                    "text": "…这…啊没错！小妹…就是哥哥在变魔术，哥哥是不是很厉害？"
                },
                {
                    "id": "740852003",
                    "speaker": "柯蕾特莉",
                    "text": "嗯！居然有这么厉害的招数，感觉一点也不比大魔术师林尼差耶！"
                },
                {
                    "id": "740852004",
                    "speaker": "勒莫迪埃",
                    "text": "咳咳…"
                }
            ]
        },
        {
            "id": "7408503",
