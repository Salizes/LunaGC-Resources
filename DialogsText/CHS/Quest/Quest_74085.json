    "talks": [
        {
            "id": "7408501",
            "objective": "前往广场",
            "dialogues": []
        },
        {
            "id": "7408502",
            "objective": "与美露莘对话",
            "dialogues": [
                {
                    "id": "740850201",
                    "speaker": "珀西芙",
                    "text": "钥匙，雕像，钥匙，雕像，钥匙，雕像。"
                },
                {
                    "id": "740850202",
                    "speaker": "派蒙",
                    "text": "嗯…你是说把钥匙放进雕像？这样倒是刚刚好，三把钥匙对三座雕像…"
                },
                {
                    "id": "740850203",
                    "speaker": "派蒙",
                    "text": "我们先试试吧？"
                },
                {
                    "id": "740850204",
                    "speaker": "Player",
                    "text": "放好钥匙后会发生什么？"
                },
                {
                    "id": "740850205",
                    "speaker": "珀西芙",
                    "text": "门开，开门…"
                },
                {
                    "id": "740850206",
                    "speaker": "派蒙",
                    "text": "门？哪儿呢？门后面有什么？"
                },
                {
                    "id": "740850207",
                    "speaker": "珀西芙",
                    "text": "根，伊黎耶，十分很深…"
                },
                {
                    "id": "740850208",
                    "speaker": "派蒙",
                    "text": "门通往伊黎耶岛的根？！珀西芙，你你…你知道的东西好多！"
                },
                {
                    "id": "740850209",
                    "speaker": "珀西芙",
                    "text": "珀西芙，守护！"
                },
                {
                    "id": "740850210",
                    "speaker": "Player",
                    "text": "还有什么需要我们知道的吗？"
                },
                {
                    "id": "740850211",
                    "speaker": "珀西芙",
                    "text": "…啊？"
                },
                {
                    "id": "740850212",
                    "speaker": "派蒙",
                    "text": "就是情报啦，信息啦，越多越好，知道的越多，我们就越有把握！"
                },
                {
                    "id": "740850213",
                    "speaker": "珀西芙",
                    "text": "信…息？信…息…珀西芙！信息，十分很多…"
                },
                {
                    "id": "740850214",
                    "speaker": "派蒙",
                    "text": "太好了！"
                },
                {
                    "id": "740850215",
                    "speaker": "珀西芙",
                    "text": "伊黎耶，信息，十分很多。"
                },
                {
                    "id": "740850216",
                    "speaker": "派蒙",
                    "text": "嗯…信息很多。"
                },
                {
                    "id": "740850217",
                    "speaker": "珀西芙",
                    "text": "信息，水脉，十分很多。"
                },
                {
                    "id": "740850218",
                    "speaker": "派蒙",
                    "text": "嗯…水脉很多。"
                },
                {
                    "id": "740850219",
                    "speaker": "珀西芙",
                    "text": "水脉，那位来客，十分很多。"
                },
                {
                    "id": "740850220",
                    "speaker": "派蒙",
                    "text": "嗯…嗯？！那位来客很多？！等等，我没懂…哪来的那么多位来客啊？那位来客会分身魔法？"
                },
                {
                    "id": "740850221",
                    "speaker": "珀西芙",
                    "text": "美露莘！"
                },
                {
                    "id": "740850222",
                    "speaker": "珀西芙",
                    "text": "水脉，那位来客，品尝。"
                },
                {
                    "id": "740850223",
                    "speaker": "珀西芙",
                    "text": "邪恶，那位来客，感知。"
                },
                {
                    "id": "740850224",
                    "speaker": "派蒙",
                    "text": "品尝水脉里的邪恶？这是什么奇怪的口味啊…"
                },
                {
                    "id": "740850225",
                    "speaker": "Player",
                    "text": "那位来客能感知水脉里的信息？"
                },
                {
                    "id": "740850226",
                    "speaker": "珀西芙",
                    "text": "珀西芙！"
                },
                {
                    "id": "740850227",
                    "speaker": "珀西芙",
                    "text": "垂柳，收集。雾道，处理。泉眼，发送。"
                },
                {
                    "id": "740850228",
                    "speaker": "珀西芙",
                    "text": "根，水脉，中心。"
                },
                {
                    "id": "740850229",
                    "speaker": "Player",
                    "text": "伊黎耶岛是信息中心？"
                },
                {
                    "id": "740850230",
                    "speaker": "派蒙",
                    "text": "你是说整个伊黎耶岛是那位来客的一个信息系统？他可以通过这个感知一些不好的东西？"
                },
                {
                    "id": "740850231",
                    "speaker": "珀西芙",
                    "text": "#聪明派蒙！聪明{NICKNAME}！珀西芙！"
                },
                {
                    "id": "740850232",
                    "speaker": "派蒙",
                    "text": "天呢，这个叫做那位来客的来客究竟是什么人物啊…"
                },
                {
                    "id": "740850233",
                    "speaker": "珀西芙",
                    "text": "枫丹，那位来客，守护。"
                },
                {
                    "id": "740850234",
                    "speaker": "珀西芙",
                    "text": "但是，那位来客，十分很忙。"
                },
                {
                    "id": "740850235",
                    "speaker": "珀西芙",
                    "text": "紫东西，偷偷往根去。紫东西，偷偷破坏根。"
                },
                {
                    "id": "740850236",
                    "speaker": "珀西芙",
                    "text": "珀西芙，偷偷偷看。珀西芙，偷偷磨石碑。"
                },
                {
                    "id": "740850237",
                    "speaker": "派蒙",
                    "text": "啊，原来是你把石碑上的字抹掉的！是为了阻止那个家伙吗？"
                },
                {
                    "id": "740850238",
                    "speaker": "珀西芙",
                    "text": "珀西芙！但是…"
                },
                {
                    "id": "740850239",
                    "speaker": "珀西芙",
                    "text": "紫东西，还往根去。紫东西，十分很厉害。"
                },
                {
                    "id": "740850240",
                    "speaker": "Player",
                    "text": "他找到了别的路？"
                },
                {
                    "id": "740850241",
                    "speaker": "珀西芙",
                    "text": "珀西芙！"
                },
                {
                    "id": "740850242",
                    "speaker": "派蒙",
                    "text": "看来这家伙真的有点难对付啊…破坏了根，信息系统就会失灵，那位来客的感知能力就会受到影响…"
                },
                {
                    "id": "740850243",
                    "speaker": "珀西芙",
                    "text": "珀西芙，责任！珀西芙，守护！"
                },
                {
                    "id": "740850244",
                    "speaker": "珀西芙",
                    "text": "#{NICKNAME}，邦邦。派蒙，邦邦。"
                },
                {
                    "id": "740850245",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，看来我们不能再等了！我们现在就要邦邦！"
                },
                {
                    "id": "740850246",
                    "speaker": "Player",
                    "text": "珀西芙！现在就开门吧。"
                },
                {
                    "id": "740850247",
                    "speaker": "派蒙",
                    "text": "太好了，我们出发！"
                }
            ]
        },
        {
