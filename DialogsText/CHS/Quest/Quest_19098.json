            "dialogues": [
                {
                    "id": "190981001",
                    "speaker": "「贡达法」",
                    "text": "这也不是第一次了，唉。"
                }
            ]
        },
        {
            "id": "1907309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190730902",
                    "speaker": "「卡布斯」",
                    "text": "你怎么擅自回来了？"
                },
                {
                    "id": "190730901",
                    "speaker": "「贡达法」",
                    "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"
                }
            ]
        },
        {
            "id": "1909814",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190981401",
                    "speaker": "艾依曼",
                    "text": "要不要上去跟这位先生搭话呢？"
                }
            ]
        },
        {
            "id": "1909815",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190981501",
                    "speaker": "奥乌兹",
                    "text": "演出不错，你们是不是专业的？"
                }
            ]
        },
        {
            "id": "1909819",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190981901",
                    "speaker": "娜斯米儿",
                    "text": "想要点餐请招呼我。"
                }
            ]
        },
        {
            "id": "1909820",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190982001",
                    "speaker": "娜斯米儿",
                    "text": "请稍等，菜品很快就好。"
                }
            ]
        },
        {
            "id": "1909821",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190982101",
                    "speaker": "娜斯米儿",
                    "text": "客人还有什么需要的话，招呼我就好。"
                }
            ]
        },
        {
            "id": "1909822",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190982201",
                    "speaker": "「卡布斯」",
                    "text": "你怎么擅自回来了？"
                },
                {
                    "id": "190982202",
                    "speaker": "「贡达法」",
                    "text": "带着王子的书信，我离开了前线回到王庭。我的王，贡达法求见。"
                }
            ]
        },
        {
            "id": "1909823",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190982301",
                    "speaker": "演出公告",
                    "text": "卡布斯剧团驻演中。购买酒水即可欣赏免费演出！"
                }
            ]
        },
        {
            "id": "1909899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190989901",
                    "speaker": "凯亚",
                    "text": "看戏…算是不错的娱乐吧，可惜故事我都已经知道了。"
                },
                {
                    "id": "190989902",
                    "speaker": "凯亚",
                    "text": "#不过有{NICKNAME}作陪应该不会无聊。离风暴的中心越近就越让人心跳加速，呵呵。"
                },
                {
                    "id": "190989903",
                    "speaker": "凯亚",
                    "text": "非如此不可…哈哈，非如此不可！"
                },
                {
                    "id": "190989904",
                    "speaker": "凯亚",
                    "text": "在事情变得更无聊之前，早点脱身为好。"
                },
                {
                    "id": "190989905",
                    "speaker": "「卡布斯」",
                    "text": "不管怎么说，演戏赚钱总比当佣兵稳定啊。"
                },
                {
                    "id": "190989906",
                    "speaker": "「贡达法」",
                    "text": "台词啊台词…平常哪有人是这么说话的，这就是教令院的智慧吗…"
                },
                {
                    "id": "190989907",
                    "speaker": "娜斯米儿",
                    "text": "好帅气的外国人呀。"
                },
                {
                    "id": "190989908",
                    "speaker": "罗莎娜",
                    "text": "居然是蒙德来的，我还以为是沙漠人呢。"
                },
                {
                    "id": "190989909",
                    "speaker": "艾依曼",
                    "text": "可惜达毕尔的剧团是流动的，过一阵子就要离开了。"
                },
                {
                    "id": "190989910",
                    "speaker": "奥乌兹",
                    "text": "我这算不算是工作期间溜号…"
                }
            ]
        }
    ]
