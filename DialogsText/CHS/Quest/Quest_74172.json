    },
    "talks": [
        {
            "id": "7417201",
            "objective": "（test）隐藏控制NPC$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7405389",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740538901",
                    "speaker": "雷蒙多",
                    "text": "我有什么能帮您的吗？",
                    "choices": [
                        {
                            "id": "740538902",
                            "text": "你为什么认为纳克没死？",
                            "response": [
                                {
                                    "id": "740538903",
                                    "speaker": "雷蒙多",
                                    "text": "如果考虑到科学院的利益，再从我个人角度出发…"
                                },
                                {
                                    "id": "740538904",
                                    "speaker": "雷蒙多",
                                    "text": "我真心希望，他和那枚「始基动能核心」一起彻底在爆炸中灰飞烟灭。"
                                },
                                {
                                    "id": "740538905",
                                    "speaker": "雷蒙多",
                                    "text": "这样的话，艾德温·伊斯丁豪斯在院内的最后一丝影响力也会彻底消失。"
                                },
                                {
                                    "id": "740538906",
                                    "speaker": "雷蒙多",
                                    "text": "但就像我之前所说。那场爆炸，实际上是小范围内的始基矿碎片共振。"
                                },
                                {
                                    "id": "740538907",
                                    "speaker": "雷蒙多",
                                    "text": "而且…爆炸区域内的始基矿碎片也大多是能量枯竭的废矿。"
                                },
                                {
                                    "id": "740538908",
                                    "speaker": "雷蒙多",
                                    "text": "按理来说，就算是大型始基矿失控，并让这些废矿发生共振，也不该发生如此剧烈的爆炸。"
                                },
                                {
                                    "id": "740538909",
                                    "speaker": "雷蒙多",
                                    "text": "唯一的可能性，就是有人专门搜集了其他区域内未枯竭的始基矿，堆放在这里。"
                                },
                                {
                                    "id": "740538910",
                                    "speaker": "雷蒙多",
                                    "text": "然后，再刻意让那颗大型始基矿过载，使那些始基矿开始共振并引发爆炸，从而掩盖某些痕迹。"
                                },
                                {
                                    "id": "740538911",
                                    "speaker": "雷蒙多",
                                    "text": "纳克之前一直跟随艾德温研究，对始基矿的性质十分了解。他做这些事并不会费太多功夫。"
                                },
                                {
                                    "id": "740538912",
                                    "speaker": "雷蒙多",
                                    "text": "但这些也只是我的初步推测，之后…就要等科学院进行更深入的调查了。"
                                },
                                {
                                    "id": "740538913",
                                    "speaker": "Player",
                                    "text": "但他为什么要偷走这颗核心？"
                                },
                                {
                                    "id": "740538914",
                                    "speaker": "雷蒙多",
                                    "text": "这颗「始基动能核心」是枫丹科学院到目前为止最为尖端的技术。"
                                },
                                {
                                    "id": "740538915",
                                    "speaker": "雷蒙多",
                                    "text": "无论是将它卖掉，或者是用来开发什么项目…哼，都是很不错的选择。"
                                },
                                {
                                    "id": "740538916",
                                    "speaker": "雷蒙多",
                                    "text": "不过，考虑到他的学术水平…我宁愿他把这颗「始基动能核心」卖个好价钱。"
                                }
                            ]
                        },
                        {
                            "id": "740538917",
                            "text": "关于「始基动能核心」…",
                            "response": [
                                {
                                    "id": "740538918",
                                    "speaker": "雷蒙多",
                                    "text": "在谈这件事之前，我想您应该听纳克，或者克洛妮艾小姐提到过。"
                                },
                                {
                                    "id": "740538919",
                                    "speaker": "雷蒙多",
                                    "text": "我和艾德温·伊斯丁豪斯的研究项目在某些方面有重合之处。"
                                },
                                {
                                    "id": "740538920",
                                    "speaker": "雷蒙多",
                                    "text": "这样的说法并不完全准确…事实上，这个「始基动能核心」正是我与艾德温共同的研究成果。"
                                },
                                {
                                    "id": "740538921",
                                    "speaker": "雷蒙多",
                                    "text": "在理论上，如果给这颗动能核心持续注入满额能量，它就可以轻松驱动「实验性场力发生装置」，让其以满功率运转…"
                                },
                                {
                                    "id": "740538922",
                                    "speaker": "雷蒙多",
                                    "text": "在制造出这个核心后，我们都意识到了一个问题，我们几乎找不到能够持续对其输入满额能量的方法。"
                                },
                                {
                                    "id": "740538923",
                                    "speaker": "雷蒙多",
                                    "text": "我和艾德温尝试过混合芒荒湮灭能和始基矿能量为其供能，或是将大量始基矿串联起来，形成一个超大能量组…但都不管用。"
                                },
                                {
                                    "id": "740538924",
                                    "speaker": "雷蒙多",
                                    "text": "直到我们找到了那颗巨型始基矿…虽然它始终处于惰性态，但我和艾德温很确定，这颗矿石具有前所未有的纯净度。"
                                },
                                {
                                    "id": "740538925",
                                    "speaker": "雷蒙多",
                                    "text": "只要将这枚矿石稍加处理，它就一定能输出我们所需的高额能量…"
                                },
                                {
                                    "id": "740538926",
                                    "speaker": "雷蒙多",
                                    "text": "然后，我和艾德温就产生了分歧。我提出了一个偏保守的方案，而他想要…更快速地解决这个问题。"
                                },
                                {
                                    "id": "740538929",
                                    "speaker": "雷蒙多",
                                    "text": "之后的故事，您应该已经知道了。"
                                }
                            ]
                        },
                        {
                            "id": "740538930",
                            "text": "关于艾德温…",
                            "response": [
                                {
                                    "id": "740538931",
                                    "speaker": "雷蒙多",
                                    "text": "他是科研领域的天才。毫不夸张地说，他的才华仅次于我们的第一任院长，阿兰·吉约丹。"
                                },
                                {
                                    "id": "740538932",
                                    "speaker": "雷蒙多",
                                    "text": "但他同时也是一个…不近人情的怪物。"
                                },
                                {
                                    "id": "740538933",
                                    "speaker": "雷蒙多",
                                    "text": "除了科学研究之外，其他的任何事物对他来说都毫无意义。"
                                },
                                {
                                    "id": "740538934",
                                    "speaker": "雷蒙多",
                                    "text": "只要能够推进研究的进度，艾德温愿意做任何事，或者是付出任何代价。"
                                },
                                {
                                    "id": "740538935",
                                    "speaker": "雷蒙多",
                                    "text": "除了研究成果之外，他也不会要求其余更多的报酬，他曾经这么说："
                                },
                                {
                                    "id": "740538936",
                                    "speaker": "雷蒙多",
                                    "text": "「我不需要任何报酬，对我来说，研究本身就是最好的奖励。」"
                                },
                                {
                                    "id": "740538937",
                                    "speaker": "雷蒙多",
                                    "text": "不过，虽然艾德温是一个纯粹的研究者，但他手下的那些人，哼…可是一个比一个会钻营。"
                                },
                                {
                                    "id": "740538938",
                                    "speaker": "雷蒙多",
                                    "text": "有的人偷偷贩卖研究资产，有的剽窃研究成果，还有的人打着艾德温的旗号在外面招摇撞骗。"
                                },
                                {
                                    "id": "740538939",
                                    "speaker": "雷蒙多",
                                    "text": "枫丹科学院的名声，就这样被他们一步步糟蹋了下去。"
                                },
                                {
                                    "id": "740538940",
                                    "speaker": "雷蒙多",
                                    "text": "但就像之前说的，只要研究能够推进，艾德温就什么也不会管。"
                                },
                                {
                                    "id": "740538941",
                                    "speaker": "雷蒙多",
                                    "text": "就这样，这群人就打着艾德温的旗号，逐渐蚕食着整个科学院的资源。"
                                },
                                {
                                    "id": "740538942",
                                    "speaker": "雷蒙多",
                                    "text": "院内只能不断地对艾德温项目组的人员和经费进行详细审查，舒瓦瑟尔先生就曾领导过多次审查行动。"
                                },
                                {
                                    "id": "740538943",
                                    "speaker": "雷蒙多",
                                    "text": "但在那群人的嘴里，这些行为被解读为了「官僚化的颐指气使」和「对研究员的不信任」。"
                                },
                                {
                                    "id": "740538944",
                                    "speaker": "雷蒙多",
                                    "text": "越来越多的矛盾在科学院里涌现…没人知道该如何解决。"
                                },
                                {
                                    "id": "740538945",
                                    "speaker": "雷蒙多",
                                    "text": "但现在…这些矛盾已经全部不存在了。"
                                }
                            ]
                        },
                        {
                            "id": "740538946",
                            "text": "关于科学院的现状…",
                            "response": [
                                {
                                    "id": "740538947",
                                    "speaker": "雷蒙多",
                                    "text": "呵呵，您这个问题并不是一个技术问题，而是一个行政问题。"
                                },
                                {
                                    "id": "740538948",
                                    "speaker": "雷蒙多",
                                    "text": "比起我，您更应该去问舒瓦瑟尔先生。"
                                }
                            ]
                        },
                        {
                            "id": "740538949",
                            "text": "你为什么认为是纳克偷走了核心？",
                            "response": [
                                {
                                    "id": "740538950",
                                    "speaker": "雷蒙多",
                                    "text": "您还记得，我在之前翻看了一下克洛妮艾小姐在废墟中拍摄的画片吗？"
                                },
                                {
                                    "id": "740538951",
                                    "speaker": "雷蒙多",
                                    "text": "里面有一张纳克正在抑制器前操作的画片，虽然非常模糊…但我很确定，那个动作绝对不在操作规范里。"
                                },
                                {
                                    "id": "740538952",
                                    "speaker": "派蒙",
                                    "text": "那也说明不了什么呀。说不定…说不定是有小偷从旁边的山头飞过来，然后把这个核心偷走了呢。"
                                },
                                {
                                    "id": "740538953",
                                    "speaker": "雷蒙多",
                                    "text": "呵呵，这绝对不可能。这片废墟里的始基矿能量流就是最好的防盗措施，一般人可受不了这玩意。"
                                },
                                {
                                    "id": "740538954",
                                    "speaker": "雷蒙多",
                                    "text": "而且，那台「实验性场力发生装置」的启动时机太巧了，绝不可能是刚好凑巧…"
                                },
                                {
                                    "id": "740538955",
                                    "speaker": "雷蒙多",
                                    "text": "我有一个不太成熟的揣测。纳克…或者说，「窃取核心的人」应该早就卸除了「始基动能核心」，启动了备用能源。"
                                },
                                {
                                    "id": "740538956",
                                    "speaker": "雷蒙多",
                                    "text": "但「芒荒湮灭能核心」是一种相对低效的能源，它必须要持续输出能量，才能达到这个大家伙的启动阈值。"
                                },
                                {
                                    "id": "740538957",
                                    "speaker": "雷蒙多",
                                    "text": "所以，这人刻意活化了那颗大型始基矿，引起了一场不大不小，但颇能吸引注意力的爆炸。"
                                },
                                {
                                    "id": "740538958",
                                    "speaker": "雷蒙多",
                                    "text": "这样，当院里派人上来的时候，一定会先维修始基矿抑制器。"
                                },
                                {
                                    "id": "740538959",
                                    "speaker": "雷蒙多",
                                    "text": "当他们意识到，必须去拿「实验性场力发生装置」内的备用能源时，「实验性场力发生装置」也充能完毕。"
                                },
                                {
                                    "id": "740538960",
                                    "speaker": "雷蒙多",
                                    "text": "从技术角度，这么做有极大的可行性。而在枫丹科学院内，能够做到这件事的，这样的人只有我、艾德温、还有纳克先生。"
                                },
                                {
                                    "id": "740538961",
                                    "speaker": "雷蒙多",
                                    "text": "艾德温应该没有机会来做这件事…剩下两个嫌疑人，只有我和纳克先生了。"
                                },
                                {
                                    "id": "740538962",
                                    "speaker": "Player",
                                    "text": "说不定就是你干的。"
                                },
                                {
                                    "id": "740538963",
                                    "speaker": "派蒙",
                                    "text": "对呀，你之前说纳克撒谎，可你也一直在撒谎。"
                                },
                                {
                                    "id": "740538964",
                                    "speaker": "派蒙",
                                    "text": "说不定就是自导自演，想骗我们保护你过来拿什么东西呢。"
                                },
                                {
                                    "id": "740538965",
                                    "speaker": "雷蒙多",
                                    "text": "你们的指控不完全是没有道理。我之后也会申请一次院内的可信度调查。"
                                },
                                {
                                    "id": "740538966",
                                    "speaker": "雷蒙多",
                                    "text": "但就我来看，犯下这次罪行的人，更可能是纳克先生。如果此事真是他所为，那在这次的事件中，他的获利最大。"
                                },
                                {
                                    "id": "740538967",
                                    "speaker": "雷蒙多",
                                    "text": "就算我和他一起并列为嫌疑犯…那他被定罪的概率肯定也远大于我。"
                                }
                            ]
                        },
                        {
                            "id": "740538968",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "740538969",
                                    "speaker": "雷蒙多",
                                    "text": "再见。祝您今天有个好心情。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7405391",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740539101",
                    "speaker": "舒瓦瑟尔",
                    "text": "瞧瞧是谁来了！「枫丹科学院荣誉高级研究员」，欢迎，欢迎啊！"
                },
                {
                    "id": "740539102",
                    "speaker": "舒瓦瑟尔",
                    "text": "我有什么能帮您的吗？或者，您又是来帮我们什么忙的？哈哈哈！",
                    "choices": [
                        {
                            "id": "740539103",
                            "text": "关于科学院的现状…",
                            "response": [
                                {
                                    "id": "740539104",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "一切正常！不能再好了，艾德温这个自大狂消失了，他手下的那群小偷也不复存在。"
                                },
                                {
                                    "id": "740539105",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "更重要的是，整个科学院获得了一次重生的机会！"
                                },
                                {
                                    "id": "740539106",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "抛开过去的束缚和重担，再次全心全意地抓住立院之本，即为枫丹廷全体民众之福祉而努力。"
                                },
                                {
                                    "id": "740539107",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "我正在组织人手，准备编纂一部详细的科学院行事守则。"
                                },
                                {
                                    "id": "740539108",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "其中包括经费的使用原则，研究资产的管理方法…还有科研与工作中应遵守之道德水准。"
                                },
                                {
                                    "id": "740539109",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "让科学院内任何与研究相关的行为，都有条文可依。"
                                },
                                {
                                    "id": "740539110",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "啊…真是美好的未来！太棒了！"
                                }
                            ]
                        },
                        {
                            "id": "740539111",
                            "text": "你是和雷蒙多一起领导科学院吗？",
                            "response": [
                                {
                                    "id": "740539112",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "不，准确地说，我们只是各自管理不同领域的事务。"
                                },
                                {
                                    "id": "740539113",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "雷蒙多负责让科研工作重回正轨，而我则负责科研工作之外的事务。"
                                },
                                {
                                    "id": "740539114",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "比如组织人手批发经费、分配新季度的财政预算、重新接待来访人员，还有和雷蒙多一起打发那些记者。"
                                },
                                {
                                    "id": "740539115",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "但我们的工作主旨是完全一样的，那就是重建枫丹科学院，为枫丹廷全体民众之福祉而努力。"
                                }
                            ]
                        },
                        {
                            "id": "740539116",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "740539117",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "请忙您自己的事去吧。枫丹科学院随时欢迎您的来访！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}