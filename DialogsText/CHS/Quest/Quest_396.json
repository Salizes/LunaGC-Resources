    "talks": [
        {
            "id": "39601",
            "objective": "(test)风魔龙的原谅$HIDDEN",
            "dialogues": [
                {
                    "id": "3960101",
                    "speaker": "派蒙",
                    "text": "这里马上要崩塌了！"
                }
            ]
        },
        {
            "id": "39602",
            "objective": "在教堂找到琴与温迪",
            "dialogues": [
                {
                    "id": "3960201",
                    "speaker": "琴",
                    "text": "这位就是教会方面负责回收天空之琴的专员，祈礼牧师芭芭拉。"
                },
                {
                    "id": "3960202",
                    "speaker": "芭芭拉",
                    "text": "愿风神护佑你们。"
                },
                {
                    "id": "3960203",
                    "speaker": "芭芭拉",
                    "text": "虽然比起代理团长，我可能没资格说这话…"
                },
                {
                    "id": "3960204",
                    "speaker": "芭芭拉",
                    "text": "但，我还是要替蒙德感谢各位的努力！"
                },
                {
                    "id": "3960205",
                    "speaker": "芭芭拉",
                    "text": "幸亏是和平解决！如果真的调动军力与龙开战，很难想象要怎样收场…"
                },
                {
                    "id": "3960206",
                    "speaker": "琴",
                    "text": "而且，「愚人众」那边也不能多说什么。"
                },
                {
                    "id": "3960207",
                    "speaker": "琴",
                    "text": "事情变成这样，他们一定在暗中气恼吧。"
                },
                {
                    "id": "3960208",
                    "speaker": "琴",
                    "text": "这一次，他们失去了向西风骑士团施压的最佳借口。"
                },
                {
                    "id": "3960209",
                    "speaker": "琴",
                    "text": "只印证了至冬国使臣蛮横无理的形象，却没有得到实际的外交进展呢。"
                },
                {
                    "id": "3960210",
                    "speaker": "芭芭拉",
                    "text": "好啦，所以你们把天空之琴带来了吗？"
                },
                {
                    "id": "3960211",
                    "speaker": "芭芭拉",
                    "text": "代理团长的担保也不是无限的，枢机大人已经催了一阵子了…"
                },
                {
                    "id": "3960212",
                    "speaker": "派蒙",
                    "text": "倒…倒是带来了，只不过…嗯…这个…稍微有点…"
                },
                {
                    "id": "3960213",
                    "speaker": "芭芭拉",
                    "text": "嗯？放心，不会收你们租金的，教会一直有专门的供奉拨款…"
                }
            ]
        },
        {
            "id": "39606",
            "objective": "(test)女士登场cs$HIDDEN",
            "dialogues": [
                {
                    "id": "3960601",
                    "speaker": "温迪",
                    "text": "树间的风很好，有我喜欢的气味…"
                },
                {
                    "id": "3960602",
                    "speaker": "温迪",
                    "text": "哈哈，上次我也是这么说的呢。唉，为什么每次说这句话，都是在运气不顺的时候呢？"
                },
                {
                    "id": "3960603",
                    "speaker": "Player",
                    "text": "所以…什么是「神之心」？"
                },
                {
                    "id": "3960604",
                    "speaker": "温迪",
                    "text": "…你注意到了啊。"
                },
                {
                    "id": "3960605",
                    "speaker": "温迪",
                    "text": "唉…这本来不是能和普通人谈论的话题。但，悄悄告诉你也没关系。"
                },
                {
                    "id": "3960606",
                    "speaker": "温迪",
                    "text": "你应该知道，「神之眼」是这世上极少数人才拥有的外置魔力器官。他们通过「神之眼」来引导元素力。"
                },
                {
                    "id": "3960607",
                    "speaker": "温迪",
                    "text": "其实，每一位「神之眼」的拥有者，都是有资格成神的人，因此被称作「原神」，拥有登上天空岛的资格。"
                },
                {
                    "id": "3960608",
                    "speaker": "派蒙",
                    "text": "「原神」？以前好像从来没听过这个词…"
                },
                {
                    "id": "3960609",
                    "speaker": "温迪",
                    "text": "哼哼，因为这是真正神灵才知道的秘密呀。总之，我们是不需要「神之眼」这种初级器官的——"
                },
                {
                    "id": "3960610",
                    "speaker": "温迪",
                    "text": "作为替代，神灵的魔力器官与天空岛共鸣相连…也就是「神之心」了。"
                },
                {
                    "id": "3960611",
                    "speaker": "Player",
                    "text": "那你腰上挂的这个是？"
                },
                {
                    "id": "3960612",
                    "speaker": "温迪",
                    "text": "欸嘿。只是发光的玻璃球而已，用来避免无谓的猜疑啦。",
                    "choices": [
                        {
                            "id": "3960613",
                            "text": "……",
                            "response": [
                                {
                                    "id": "3960615",
                                    "speaker": "派蒙",
                                    "text": "那么，刚才那个见面就把我吹飞、还抢走温迪「神之心」的坏女人，到底是谁…？"
                                },
                                {
                                    "id": "3960616",
                                    "speaker": "温迪",
                                    "text": "她是「女士」——愚人众十一执行官的第八席，代号「女士」。"
                                },
                                {
                                    "id": "3960617",
                                    "speaker": "温迪",
                                    "text": "愚人众的每一位执行官，都像她一样，被至冬国的女皇赐予了神灵般的权柄，获得超越了凡人的力量。"
                                },
                                {
                                    "id": "3960618",
                                    "speaker": "派蒙",
                                    "text": "至冬国的…女皇？那不就是…"
                                },
                                {
                                    "id": "3960619",
                                    "speaker": "温迪",
                                    "text": "嗯，七神之一，端坐于至冬宫的「冰之女皇」，全体愚人众执行官的唯一效忠对象。"
                                },
                                {
                                    "id": "3960620",
                                    "speaker": "温迪",
                                    "text": "虽然七神之间的关系，并不全都非常融洽，但我也没想到，她居然正在谋夺其他神灵的「神之心」…"
                                },
                                {
                                    "id": "3960621",
                                    "speaker": "Player",
                                    "text": "冰之女皇是怎样的神？"
                                },
                                {
                                    "id": "3960622",
                                    "speaker": "温迪",
                                    "text": "啊…该怎么说呢？"
                                },
                                {
                                    "id": "3960623",
                                    "speaker": "温迪",
                                    "text": "我认识「五百年前的她」，但对「现在的她」已经很陌生了。"
                                },
                                {
                                    "id": "3960624",
                                    "speaker": "温迪",
                                    "text": "五百年前的一场大灾之后，她就断绝了和我的一切交流…"
                                },
                                {
                                    "id": "3960625",
                                    "speaker": "温迪",
                                    "text": "不过，有关冰之神和愚人众的事，还是过一会再说吧。"
                                },
                                {
                                    "id": "3960626",
                                    "speaker": "温迪",
                                    "text": "#{NICKNAME}，你要寻找全部七神，旅途中恐怕还有许多艰难之处。"
                                },
                                {
                                    "id": "3960627",
                                    "speaker": "温迪",
                                    "text": "先往蒙德的邻国去吧——那里的「岩」之神与我不同，亲自治理着「璃月」全境。"
                                },
                                {
                                    "id": "3960628",
                                    "speaker": "温迪",
                                    "text": "他每年只会正式降临一次，赐下神谕，指引这一年里经营璃月的方向。"
                                },
                                {
                                    "id": "3960629",
                                    "speaker": "派蒙",
                                    "text": "即使是这样，听起来工作频率也比某位大人高多了呢。"
                                },
                                {
                                    "id": "3960630",
                                    "speaker": "温迪",
                                    "text": "欸嘿？"
                                },
                                {
                                    "id": "3960631",
                                    "speaker": "温迪",
                                    "text": "…总之，今年的「请仙典仪」好像就快开始了。嗯，错过的话，就要再等一整年咯。"
                                },
                                {
                                    "id": "3960632",
                                    "speaker": "派蒙",
                                    "text": "#哇？！这么重要的信息怎么不早说？那就再见了，{NICKNAME}，我们快走——"
                                },
                                {
                                    "id": "3960633",
                                    "speaker": "温迪",
                                    "text": "等一等，「捕风的异乡人」。",
                                    "choices": [
                                        {
                                            "id": "3960634",
                                            "text": "是在叫我吗？",
                                            "response": [
                                                {
                                                    "id": "3960635",
                                                    "speaker": "温迪",
                                                    "text": "没错。"
                                                },
                                                {
                                                    "id": "3960638",
                                                    "speaker": "温迪",
                                                    "text": "旅行者…当你重新踏上旅途之后，一定要记得旅途本身的意义。"
                                                },
                                                {
                                                    "id": "3960639",
                                                    "speaker": "温迪",
                                                    "text": "提瓦特的飞鸟、诗歌和城邦，女皇、愚人和怪物…都是你旅途的一部分。"
                                                },
                                                {
                                                    "id": "3960640",
                                                    "speaker": "温迪",
                                                    "text": "终点并不意味着一切。在抵达终点之前，用你的眼睛，多多观察这个世界吧…",
                                                    "choices": [
                                                        {
                                                            "id": "3960641",
                                                            "text": "温迪…",
                                                            "response": [
                                                                {
                                                                    "id": "3960643",
                                                                    "speaker": "温迪",
                                                                    "text": "嗯！风神的告诫到此为止！接下来是温迪时间。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3960642",
                                                            "text": "我明白了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3960636",
                                            "text": "不好意思，擅自借用了七天神像的风…",
                                            "response": [
                                                {
                                                    "id": "3960637",
                                                    "speaker": "温迪",
                                                    "text": "哈哈，心怀感激地用吧——能请我一杯蒲公英酒就更好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3960614",
                            "text": "又欺骗感情，但我已经习惯了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "39605",
            "objective": "与芭芭拉对话",
            "dialogues": [
                {
                    "id": "3960501",
                    "speaker": "芭芭拉",
                    "text": "呀！荣誉骑士，你醒啦？",
                    "choices": [
                        {
                            "id": "3960502",
                            "text": "温迪…他没事吧？！",
                            "response": [
                                {
                                    "id": "3960503",
                                    "speaker": "芭芭拉",
                                    "text": "唔…他的状态，说不上是「没事」吧。"
                                },
                                {
                                    "id": "3960504",
                                    "speaker": "芭芭拉",
                                    "text": "刚才我发现你们晕倒在教堂外，就用元素力为你们治疗…"
                                },
                                {
                                    "id": "3960510",
                                    "speaker": "芭芭拉",
                                    "text": "那位诗人是先醒的，但奇怪的是，我的治疗对他的伤几乎没有效果…"
                                },
                                {
                                    "id": "3960511",
                                    "speaker": "芭芭拉",
                                    "text": "这种病人，我还是第一次遇见。他自己却说着「这很正常」之类的话，想要离开教堂…"
                                },
                                {
                                    "id": "3960512",
                                    "speaker": "派蒙",
                                    "text": "离开？他去了哪里啊？"
                                },
                                {
                                    "id": "3960513",
                                    "speaker": "芭芭拉",
                                    "text": "<color=#00E1FFFF>「蒙德英雄的象征」</color>…他是这么说的。"
                                },
                                {
                                    "id": "3960514",
                                    "speaker": "芭芭拉",
                                    "text": "我想阻止他，但琴…琴团长却说，「让他去吧」。好奇怪。",
                                    "choices": [
                                        {
                                            "id": "3960515",
                                            "text": "（我大概明白为什么了…）",
                                            "response": [
                                                {
                                                    "id": "3960517",
                                                    "speaker": "派蒙",
                                                    "text": "我记得以前，温迪也在<color=#00E1FFFF>那棵树</color>下疗过伤…"
                                                },
                                                {
                                                    "id": "3960518",
                                                    "speaker": "派蒙",
                                                    "text": "（是因为风神和风起地之间的联系吧，琴团长应该也猜到了，但不能和芭芭拉说呢…）"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3960516",
                                            "text": "（琴大概也明白为什么了…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3960505",
                            "text": "这是…哪个星球…",
                            "response": [
                                {
                                    "id": "3960506",
                                    "speaker": "芭芭拉",
                                    "text": "星球？"
                                },
                                {
                                    "id": "3960507",
                                    "speaker": "派蒙",
                                    "text": "#啊！芭芭拉小姐不要听{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}说胡话！"
                                },
                                {
                                    "id": "3960508",
                                    "speaker": "芭芭拉",
                                    "text": "咦？嗯…好的，总之，刚才我发现你们晕倒在教堂外，就用元素力为你们治疗…"
                                },
                                {
                                    "id": "3960509",
                                    "speaker": "派蒙",
                                    "text": "看来她应该多给你浇点水，帮你激活一下脑子。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "39604",
            "objective": "在风起地寻找温迪",
            "dialogues": [
                {
                    "id": "3960701",
                    "speaker": "温迪",
                    "text": "想多聊些什么的话，就趁现在聊吧。因为吟游诗人，可不会总在一个地方驻唱的。",
                    "choices": [
                        {
                            "id": "3960702",
                            "text": "关于特瓦林…",
                            "response": [
                                {
                                    "id": "3960703",
                                    "speaker": "温迪",
                                    "text": "特瓦林…到最后也还记得「四风守护」的职责。"
                                },
                                {
                                    "id": "3960704",
                                    "speaker": "温迪",
                                    "text": "所以，我也并不打算强行卸下他身上的责任、把我理解的「自由」强塞给他。"
                                },
                                {
                                    "id": "3960705",
                                    "speaker": "温迪",
                                    "text": "——而是希望，特瓦林能自己选择、自己理解，何为自由。"
                                },
                                {
                                    "id": "3960706",
                                    "speaker": "温迪",
                                    "text": "因为我在成神之前，也是这样被一个朋友…教导了「何为自由」的。"
                                }
                            ]
                        },
                        {
                            "id": "3960707",
                            "text": "关于深渊教团…",
                            "response": [
                                {
                                    "id": "3960708",
                                    "speaker": "温迪",
                                    "text": "嗯？你说凯亚的情报…"
                                },
                                {
                                    "id": "3960709",
                                    "speaker": "温迪",
                                    "text": "#…原来如此，深渊教团里有一位「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，主导了腐化特瓦林的计划？"
                                },
                                {
                                    "id": "3960710",
                                    "speaker": "温迪",
                                    "text": "#看来是想把特瓦林改造成深渊的战争兵器吧。话说回来，我可从没听说过，深渊教团里有什么「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」…",
                                    "choices": [
                                        {
                                            "id": "3960711",
                                            "text": "看来那不是教团的古老传承。",
                                            "response": [
                                                {
                                                    "id": "3960713",
                                                    "speaker": "温迪",
                                                    "text": "我想也是。"
                                                },
                                                {
                                                    "id": "3960714",
                                                    "speaker": "温迪",
                                                    "text": "#但最近才出现的「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」，又为什么能走上统领深渊教团的位置呢…？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3960712",
                                            "text": "看来是最近才出现的…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3960715",
                            "text": "关于「女士」…",
                            "response": [
                                {
                                    "id": "3960716",
                                    "speaker": "派蒙",
                                    "text": "刚才的愚人众执行官，抢走「神之心」以后，马上就离开了呢。"
                                },
                                {
                                    "id": "3960717",
                                    "speaker": "温迪",
                                    "text": "这是为了避免出现「骑士团的目击证人」。"
                                },
                                {
                                    "id": "3960718",
                                    "speaker": "温迪",
                                    "text": "毕竟这种事要是留下把柄，就等于公开毁灭与西风骑士团的外交关系了吧。"
                                },
                                {
                                    "id": "3960719",
                                    "speaker": "派蒙",
                                    "text": "做出这种事来，却还好意思继续当蒙德的盟友吗？！"
                                },
                                {
                                    "id": "3960720",
                                    "speaker": "温迪",
                                    "text": "唉…面对深渊教团的威胁，人类的七国本该结成联盟。"
                                },
                                {
                                    "id": "3960721",
                                    "speaker": "温迪",
                                    "text": "「愚人众」拥有七国最强的武力，却用来盗窃天空之琴、觊觎神力、借龙灾对骑士团施压…"
                                },
                                {
                                    "id": "3960722",
                                    "speaker": "派蒙",
                                    "text": "啊，说到「天空之琴」…那时，好像听迪卢克提过这个名字。"
                                },
                                {
                                    "id": "3960723",
                                    "speaker": "派蒙",
                                    "text": "他说，「愚人众」能够横行七国、威胁西风骑士团，完全是由于这十一位执行官的存在。"
                                },
                                {
                                    "id": "3960724",
                                    "speaker": "温迪",
                                    "text": "是的，就像我刚才说的，他们被冰之神赐予了权柄，获得了超越凡人的力量。"
                                },
                                {
                                    "id": "3960725",
                                    "speaker": "温迪",
                                    "text": "「冰之女皇」…五百年没见了，她究竟在想什么呢？又在计划着什么呢？"
                                },
                                {
                                    "id": "3960726",
                                    "speaker": "温迪",
                                    "text": "这件事的答案，或许也会对你寻找七神的旅途，产生未知的影响吧…"
                                }
                            ]
                        },
                        {
                            "id": "3960727",
                            "text": "关于神灵…",
                            "response": [
                                {
                                    "id": "3960728",
                                    "speaker": "温迪",
                                    "text": "刚才说过，「神之眼」的拥有者，被世界称作「原神」，拥有登上天空岛的资格。"
                                },
                                {
                                    "id": "3960729",
                                    "speaker": "温迪",
                                    "text": "「神之心」是更高位的元素控制中枢，是七神之座的象征。"
                                },
                                {
                                    "id": "3960730",
                                    "speaker": "温迪",
                                    "text": "#对不起，我不知道是七神中的哪一位，带走了你的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}。"
                                },
                                {
                                    "id": "3960731",
                                    "speaker": "温迪",
                                    "text": "呀，话说回来，身为七神之一，我自己的嫌疑都还没洗清…！",
                                    "choices": [
                                        {
                                            "id": "3960732",
                                            "text": "你长得和那个神一点都不像。",
                                            "response": [
                                                {
                                                    "id": "3960733",
                                                    "speaker": "派蒙",
                                                    "text": "可是，「卖唱的」只是化身形象，不能作为判断依据——"
                                                },
                                                {
                                                    "id": "3960734",
                                                    "speaker": "Player",
                                                    "text": "相处这么久，不用继续怀疑了。"
                                                },
                                                {
                                                    "id": "3960735",
                                                    "speaker": "温迪",
                                                    "text": "#啊哈哈，我们确实是很好的搭档呢。等你找回{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}，有没有兴趣来当新的「四风守护」啊？"
                                                },
                                                {
                                                    "id": "3960736",
                                                    "speaker": "Player",
                                                    "text": "也许…"
                                                },
                                                {
                                                    "id": "3960737",
                                                    "speaker": "派蒙",
                                                    "text": "#嗯？{NICKNAME}，你好像不太热衷的样子？"
                                                },
                                                {
                                                    "id": "3960738",
                                                    "speaker": "派蒙",
                                                    "text": "那么卖唱的！如果当了「四风守护」就有民众供奉好吃的话，不如考虑一下…我？"
                                                },
                                                {
                                                    "id": "3960739",
                                                    "speaker": "温迪",
                                                    "text": "哈哈哈…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3960734",
                                            "text": "相处这么久，不用继续怀疑了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3960741",
                            "text": "没别的事了…",
                            "response": [
                                {
                                    "id": "3960742",
                                    "speaker": "温迪",
                                    "text": "那么，就往<color=#00E1FFFF>璃月</color>去吧。错过今年的「请仙典仪」的话，就要再等一整年咯。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "39607",
            "objective": "(test)控制温迪治疗的特效$HIDDEN",
            "dialogues": []
        },
        {
            "id": "39600",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3960001",
                    "speaker": "芭芭拉",
                    "text": "袭击你们的人…是「愚人众」？真过分…"
                },
                {
                    "id": "3960002",
                    "speaker": "芭芭拉",
                    "text": "琴团长刚才回骑士团总部了，说是要想办法找出证据。"
                },
                {
                    "id": "3960003",
                    "speaker": "芭芭拉",
                    "text": "但如果他们没有留下痕迹，骑士团可能也很难对他们提出指控吧…琴团长是这么说的。"
                }
            ]
        }
    ]
}