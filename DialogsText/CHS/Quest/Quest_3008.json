    "talks": [
        {
            "id": "300810",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "30081001",
                    "speaker": "齐米亚",
                    "text": "这就是神明的智慧啊…"
                }
            ]
        },
        {
            "id": "300811",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "30080901",
                    "speaker": "派蒙",
                    "text": "（哈欠）——都怪你赖床，我们要迟到了。"
                },
                {
                    "id": "30080902",
                    "speaker": "派蒙",
                    "text": "快去跟迪娜泽黛会合吧。"
                }
            ]
        },
        {
            "id": "300801",
            "objective": "到约定地点与迪娜泽黛对话",
            "dialogues": [
                {
                    "id": "30080101",
                    "speaker": "派蒙",
                    "text": "早上好，迪娜泽黛，不好意思我们迟到了，嘿嘿。"
                },
                {
                    "id": "30080102",
                    "speaker": "迪娜泽黛",
                    "text": "没有，是我来得太早了。"
                },
                {
                    "id": "30080103",
                    "speaker": "派蒙",
                    "text": "你好像有点没精神…是没睡好吗？"
                },
                {
                    "id": "30080104",
                    "speaker": "迪娜泽黛",
                    "text": "我很好，不用担心。我们走吧？先去那边的摊位上逛逛。"
                },
                {
                    "id": "30080105",
                    "speaker": "派蒙",
                    "text": "好啊…欸？旅行者，你在发什么呆呢，我们快走吧？"
                }
            ]
        },
        {
            "id": "300812",
            "objective": "跟随迪娜泽黛",
            "dialogues": []
        },
        {
            "id": "300802",
            "objective": "与迪娜泽黛对话",
            "dialogues": [
                {
                    "id": "30080201",
                    "speaker": "迪娜泽黛",
                    "text": "这里是卖「七鲜桌」菜品的摊位。"
                },
                {
                    "id": "30080202",
                    "speaker": "阿玛尔",
                    "text": "您可真有见识，小姐，我还以为现在没什么人知道了。"
                },
                {
                    "id": "30080203",
                    "speaker": "派蒙",
                    "text": "怎么好像都是些素的食物呀，唔，有点失望…"
                },
                {
                    "id": "30080204",
                    "speaker": "派蒙",
                    "text": "说起来，你刚才说的「七鲜桌」是什么呀？"
                },
                {
                    "id": "30080205",
                    "speaker": "迪娜泽黛",
                    "text": "是花神诞祭的一种习俗，人们在餐桌上摆满这些菜品，用来象征须弥神明的七种美德。",
                    "choices": [
                        {
                            "id": "30080206",
                            "text": "等等…从刚才开始…",
                            "response": [
                                {
                                    "id": "30080208",
                                    "speaker": "齐米亚",
                                    "text": "…从灰尘上看，应该是「月亮」。"
                                },
                                {
                                    "id": "30080209",
                                    "speaker": "派蒙",
                                    "text": "真的吗，我怎么觉得像是某种吃的。"
                                },
                                {
                                    "id": "30080210",
                                    "speaker": "齐米亚",
                                    "text": "嗯…「月亮」象征着…嗯…我有点忘了，稍等下…"
                                },
                                {
                                    "id": "30080211",
                                    "speaker": "派蒙",
                                    "text": "他在偷偷翻书吧？"
                                },
                                {
                                    "id": "30080212",
                                    "speaker": "齐米亚",
                                    "text": "哦，对了对了，意味着「虚幻」与「谎言」。"
                                },
                                {
                                    "id": "30080213",
                                    "speaker": "齐米亚",
                                    "text": "但只要相信自己的直觉，克服心中的恐惧，太阳就一定会升起来。",
                                    "choices": [
                                        {
                                            "id": "30080214",
                                            "text": "似乎听过这句话…",
                                            "response": [
                                                {
                                                    "id": "30080216",
                                                    "speaker": "迪娜泽黛",
                                                    "text": "明白了，我会参考的。"
                                                },
                                                {
                                                    "id": "30080217",
                                                    "speaker": "齐米亚",
                                                    "text": "啊…哪里哪里，我也不过是现学现卖而已，哈哈…哈哈…"
                                                },
                                                {
                                                    "id": "30080218",
                                                    "speaker": "派蒙",
                                                    "text": "好像也挺有趣的，走吧，我们去下一站。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30080215",
                                            "text": "是「既视感」吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30080207",
                            "text": "总有种熟悉的感觉…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "300803",
            "objective": "跟随迪娜泽黛",
            "dialogues": [
                {
                    "id": "30080301",
                    "speaker": "阿玛尔",
                    "text": "我昨天才去的森林里摘这些货，绝对新鲜，放心吧。"
                }
            ]
        },
        {
            "id": "300804",
            "objective": "与迪娜泽黛对话",
            "dialogues": [
                {
                    "id": "30080401",
                    "speaker": "孩子们",
                    "text": "法里斯！法里斯！"
                },
                {
                    "id": "30080402",
                    "speaker": "毗伽尔",
                    "text": "好了，兵士们，拿了雅尔达糖的奖赏，就要对小吉祥草王心怀忠诚，解散吧！"
                },
                {
                    "id": "30080403",
                    "speaker": "孩子们",
                    "text": "是！法里斯骑士！"
                },
                {
                    "id": "30080404",
                    "speaker": "派蒙",
                    "text": "这是什么情况，在演戏吗？"
                },
                {
                    "id": "30080405",
                    "speaker": "迪娜泽黛",
                    "text": "花之骑士法里斯也是花神诞祭的一种象征，很受孩子们欢迎。"
                },
                {
                    "id": "30080406",
                    "speaker": "毗伽尔",
                    "text": "要不是迪娜泽黛小姐的赞助，孩子们也没机会见到我这个花之骑士啊，哈哈。"
                },
                {
                    "id": "30080407",
                    "speaker": "毗伽尔",
                    "text": "哦对了，你们要不要也来点雅尔达糖果，都在这些盒子里，你们挑挑看吧。"
                },
                {
                    "id": "30080408",
                    "speaker": "派蒙",
                    "text": "挑？这些看上去不都一样吗？"
                },
                {
                    "id": "30080409",
                    "speaker": "毗伽尔",
                    "text": "哈哈，可没那么简单，每个盒子里都装着随机的一种口味，要看运气。糖果有堇瓜味，日落果味，香辛果味…"
                },
                {
                    "id": "30080410",
                    "speaker": "派蒙",
                    "text": "欸，确实很有意思。"
                },
                {
                    "id": "30080411",
                    "speaker": "毗伽尔",
                    "text": "…然后还有蜥蜴尾巴味和鬼兜虫味。"
                },
                {
                    "id": "30080412",
                    "speaker": "派蒙",
                    "text": "欸！怎么会有这种味道的糖啊！"
                },
                {
                    "id": "30080413",
                    "speaker": "派蒙",
                    "text": "唔…还是你来帮忙选吧，我要吃日落果味的！"
                },
                {
                    "id": "30080414",
                    "speaker": "毗伽尔",
                    "text": "好，这五个糖果盒，从左到右是一号到五号，你选几号呢？",
                    "choices": [
                        {
                            "id": "30080415",
                            "text": "一号。",
                            "response": [
                                {
                                    "id": "30080437",
                                    "speaker": "Player",
                                    "text": "确定选一号了。"
                                },
                                {
                                    "id": "30080425",
                                    "speaker": "毗伽尔",
                                    "text": "唔~！了不起啊，四号是吧，真的选到了日落果口味。"
                                },
                                {
                                    "id": "30080426",
                                    "speaker": "派蒙",
                                    "text": "哈哈，我就说你运气超级好，果然如此！",
                                    "choices": [
                                        {
                                            "id": "30080427",
                                            "text": "我刚才…原本是想选四号的吗？",
                                            "response": [
                                                {
                                                    "id": "30080429",
                                                    "speaker": "派蒙",
                                                    "text": "啊？你是说身体本能地选对了吗？"
                                                },
                                                {
                                                    "id": "30080430",
                                                    "speaker": "派蒙",
                                                    "text": "唔，不过说起来…我好像也冥冥之中知道你一定会选对…是类似的感觉吗？",
                                                    "choices": [
                                                        {
                                                            "id": "30080431",
                                                            "text": "「既视感」已经出现太多次了…",
                                                            "response": [
                                                                {
                                                                    "id": "30080433",
                                                                    "speaker": "派蒙",
                                                                    "text": "旅行者…？难道是我们昨晚睡得不太好吗，或者睡得太多了？"
                                                                },
                                                                {
                                                                    "id": "30080434",
                                                                    "speaker": "Player",
                                                                    "text": "不好意思，我失陪一下，迪娜泽黛。"
                                                                },
                                                                {
                                                                    "id": "30080435",
                                                                    "speaker": "迪娜泽黛",
                                                                    "text": "嗯，没关系。"
                                                                },
                                                                {
                                                                    "id": "30080436",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？你要去哪里呀，就这么走了吗？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "30080432",
                                                            "text": "这种感觉很奇怪…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30080428",
                                            "text": "好像…是身体下意识选择了四号？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30080416",
                            "text": "二号。",
                            "response": [
                                {
                                    "id": "30080438",
                                    "speaker": "Player",
                                    "text": "确定选二号了。"
                                }
                            ]
                        },
                        {
                            "id": "30080417",
                            "text": "三号。",
                            "response": [
                                {
                                    "id": "30080439",
                                    "speaker": "Player",
                                    "text": "确定选三号了。"
                                }
                            ]
                        },
                        {
                            "id": "30080418",
                            "text": "四号。",
                            "response": [
                                {
                                    "id": "30080440",
                                    "speaker": "Player",
                                    "text": "确定选四号了。"
                                },
                                {
                                    "id": "30080420",
                                    "speaker": "毗伽尔",
                                    "text": "唔~！了不起啊，四号是吧，真的选到了日落果口味。"
                                },
                                {
                                    "id": "30080421",
                                    "speaker": "派蒙",
                                    "text": "哈哈，我就说你运气超级好，果然如此！"
                                },
                                {
                                    "id": "30080422",
                                    "speaker": "Player",
                                    "text": "刚才…好像不是运气。"
                                },
                                {
                                    "id": "30080423",
                                    "speaker": "Player",
                                    "text": "不知为何，我知道一定是四号。"
                                },
                                {
                                    "id": "30080424",
                                    "speaker": "派蒙",
                                    "text": "啊？怎么会呢，明明是随机的呀…",
                                    "choices": [
                                        {
                                            "id": "30080431",
                                            "text": "「既视感」已经出现太多次了…"
                                        },
                                        {
                                            "id": "30080432",
                                            "text": "这种感觉很奇怪…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30080419",
                            "text": "五号。",
                            "response": [
                                {
                                    "id": "30080441",
                                    "speaker": "Player",
                                    "text": "确定选五号了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "300815",
            "objective": "(test)【隐藏】糖果选择$HIDDEN",
            "dialogues": []
        },
        {
            "id": "300805",
            "objective": "前往兰巴德酒馆",
            "dialogues": [
                {
                    "id": "30080501",
                    "speaker": "派蒙",
                    "text": "你说…「既视感」？"
                },
                {
                    "id": "30080502",
                    "speaker": "派蒙",
                    "text": "我好像也知道这种说法，就是对眼前正在发生的事有种以前好像经历过的错觉…"
                },
                {
                    "id": "30080503",
                    "speaker": "派蒙",
                    "text": "这么说来，我今天好像也隐约会感觉到一些…不过那终究是错觉吧？"
                },
                {
                    "id": "30080504",
                    "speaker": "派蒙",
                    "text": "所以你忽然跑来这边是为什么呀？",
                    "choices": [
                        {
                            "id": "30080505",
                            "text": "想做一些平时不会做的事情。",
                            "response": [
                                {
                                    "id": "30080507",
                                    "speaker": "派蒙",
                                    "text": "这样啊，也就是故意不按常理出牌，来看看还会不会有那种「曾经做过」的感觉吗…"
                                },
                                {
                                    "id": "30080508",
                                    "speaker": "兰巴德",
                                    "text": "欢迎二位，这个时间是来吃饭的吗？今天想来点儿什么？"
                                },
                                {
                                    "id": "30080509",
                                    "speaker": "Player",
                                    "text": "「椰炭饼」一份。"
                                },
                                {
                                    "id": "30080510",
                                    "speaker": "兰巴德",
                                    "text": "好嘞，客人虽然像是外地人，但还是挺有品味的嘛，我这就通知下厨。"
                                },
                                {
                                    "id": "30080511",
                                    "speaker": "派蒙",
                                    "text": "「椰炭饼」！那不是那个…那个黑黑的，感觉肯定不怎么好吃的东西吗？"
                                },
                                {
                                    "id": "30080512",
                                    "speaker": "派蒙",
                                    "text": "啊…我、我好像明白你要干什么了，的确一般来说，你是不可能点这道菜来吃的。"
                                },
                                {
                                    "id": "30080513",
                                    "speaker": "Black Screen",
                                    "text": "等了一段时间后，「椰炭饼」被端了上来…"
                                },
                                {
                                    "id": "30080514",
                                    "speaker": "派蒙",
                                    "text": "这个…你真的打算吃吗？"
                                },
                                {
                                    "id": "30080515",
                                    "speaker": "派蒙",
                                    "text": "会不会…牺牲太大了点…"
                                },
                                {
                                    "id": "30080516",
                                    "speaker": "Player",
                                    "text": "我开动了。"
                                },
                                {
                                    "id": "30080517",
                                    "speaker": "派蒙",
                                    "text": "怎、怎么样！看你的表情，好像的确很难吃…"
                                },
                                {
                                    "id": "30080518",
                                    "speaker": "Player",
                                    "text": "不…味道其实很好。"
                                },
                                {
                                    "id": "30080519",
                                    "speaker": "派蒙",
                                    "text": "那…难道说…",
                                    "choices": [
                                        {
                                            "id": "30080520",
                                            "text": "这个味道…",
                                            "response": [
                                                {
                                                    "id": "30080522",
                                                    "speaker": "派蒙",
                                                    "text": "理论上应该不可能啊，我们之前明明那么嫌弃这道菜…"
                                                },
                                                {
                                                    "id": "30080523",
                                                    "speaker": "派蒙",
                                                    "text": "…那看来这又是…味觉上的「既视感」？",
                                                    "choices": [
                                                        {
                                                            "id": "30080524",
                                                            "text": "果然还是无法摆脱。",
                                                            "response": [
                                                                {
                                                                    "id": "30080526",
                                                                    "speaker": "派蒙",
                                                                    "text": "我也总觉得，来过这家酒馆很多很多次了，但明明我们都不是常客。"
                                                                },
                                                                {
                                                                    "id": "30080527",
                                                                    "speaker": "派蒙",
                                                                    "text": "要不…我们再出去试试看？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "30080525",
                                                            "text": "看来这种尝试我也曾经做过。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "30080521",
                                            "text": "我绝对吃过。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "30080506",
                            "text": "试试看能不能摆脱既视感。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "300816",
            "objective": "(test)【隐藏】上菜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "300817",
            "objective": "(test)【隐藏】撤菜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "300813",
            "objective": "离开兰巴德酒馆",
            "dialogues": []
        },
        {
            "id": "300806",
            "objective": "与迪娜泽黛对话",
            "dialogues": [
                {
                    "id": "30080601",
                    "speaker": "派蒙",
                    "text": "欸，迪娜泽黛好像一个人在那边的长椅上…"
                },
                {
                    "id": "30080602",
                    "speaker": "派蒙",
                    "text": "好巧呀迪娜泽黛，我们又碰上了，你怎么一个人在这里休息呀？"
                },
                {
                    "id": "30080603",
                    "speaker": "迪娜泽黛",
                    "text": "哦，我刚才遇上了些歹徒，好在迪希雅帮我解了围。后来身体有点不舒服，就坐过来了。"
                },
                {
                    "id": "30080604",
                    "speaker": "派蒙",
                    "text": "歹徒？天呐，你没受伤吧？"
                },
                {
                    "id": "30080605",
                    "speaker": "迪娜泽黛",
                    "text": "我没事，迪希雅的手臂受了点擦伤，不过也没有大碍。"
                },
                {
                    "id": "30080606",
                    "speaker": "派蒙",
                    "text": "欸…那还好。不过我总感觉…今天的迪娜泽黛好像一直有些不开心呀，明明是你那么期待的花神诞祭。"
                },
                {
                    "id": "30080607",
                    "speaker": "迪娜泽黛",
                    "text": "没有啊，我一直都是这样的。过度运动和情绪高亢容易使病情恶化。"
                },
                {
                    "id": "30080608",
                    "speaker": "迪娜泽黛",
                    "text": "况且，不管今天再怎么特殊，也只是「一天」而已。再度过不知道几个「一天」，我的时间也就结束了。"
                },
                {
                    "id": "30080609",
                    "speaker": "派蒙",
                    "text": "你在说什么呀，迪娜泽黛，我好像有点听不懂…但总感觉现在的你很悲观…"
                },
                {
                    "id": "30080610",
                    "speaker": "Player",
                    "text": "之前忽然离开真是不好意思。"
                },
                {
                    "id": "30080611",
                    "speaker": "迪娜泽黛",
                    "text": "真的没关系，我没有在意。",
                    "choices": [
                        {
                            "id": "30080612",
                            "text": "我遇到了一些奇怪的情况…",
                            "response": [
                                {
                                    "id": "30080614",
                                    "speaker": "迪娜泽黛",
                                    "text": "嗯？发生什么了？"
                                },
                                {
                                    "id": "30080615",
                                    "speaker": "派蒙",
                                    "text": "就是…迪娜泽黛有没有感觉到「既视感」？就是眼前的事情好像都发生过的感觉…"
                                },
                                {
                                    "id": "30080616",
                                    "speaker": "迪娜泽黛",
                                    "text": "「既视感」？没有，不过前面这些年，我一直困在每天都差不多的人生里，就算有既视感也已经习惯了吧。"
                                },
                                {
                                    "id": "30080617",
                                    "speaker": "派蒙",
                                    "text": "这样吗…难道只有我和旅行者才有…"
                                },
                                {
                                    "id": "30080618",
                                    "speaker": "迪娜泽黛",
                                    "text": "时间差不多了。"
                                },
                                {
                                    "id": "30080619",
                                    "speaker": "派蒙",
                                    "text": "嗯？什么时间？"
                                },
                                {
                                    "id": "30080620",
                                    "speaker": "迪娜泽黛",
                                    "text": "妮露的花神之舞就要开场了，我们走吧。"
                                }
                            ]
                        },
                        {
                            "id": "30080613",
                            "text": "你有没有察觉到一些异样？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "300807",
            "objective": "前往大巴扎观看花神之舞",
            "dialogues": [
                {
                    "id": "30080701",
                    "speaker": "阿扎尔",
                    "text": "…以你的学识，我不认为你具备与我辩论的资格。你现在该做的，是尽快找人把这些可笑的布置撤掉。"
                },
                {
                    "id": "30080702",
                    "speaker": "阿扎尔",
                    "text": "回去之后，让书记官在下次「识藏日」前拟定好禁止公开艺术表演的法令，届时再通过虚空公布给民众。"
                },
                {
                    "id": "30080703",
                    "speaker": "塞塔蕾",
                    "text": "是，我回去就通知。"
                },
                {
                    "id": "30080704",
                    "speaker": "阿扎尔",
                    "text": "……"
                },
                {
                    "id": "30080705",
                    "speaker": "阿扎尔",
                    "text": "花神诞祭…你们就好好庆祝神明的诞生吧。"
                },
                {
                    "id": "30080706",
                    "speaker": "派蒙",
                    "text": "妮露，你还好吧？"
                },
                {
                    "id": "30080707",
                    "speaker": "妮露",
                    "text": "啊，迪娜泽黛，大贤者居然要求我们停止演出…"
                },
                {
                    "id": "30080708",
                    "speaker": "迪娜泽黛",
                    "text": "没关系的，这也是没办法的事。"
                },
                {
                    "id": "30080709",
                    "speaker": "妮露",
                    "text": "明明你一直那么期待的，我不想你留下遗憾…"
                },
                {
                    "id": "30080710",
                    "speaker": "迪娜泽黛",
                    "text": "的确很遗憾，但对我来说，不给大家添麻烦更加重要。大贤者已经说过可能会查办组织者了吧？"
                },
                {
                    "id": "30080711",
                    "speaker": "妮露",
                    "text": "话虽这么说…那好吧，下次花神诞祭我们一定想办法让它圆满！"
                },
                {
                    "id": "30080712",
                    "speaker": "迪娜泽黛",
                    "text": "下次吗，我应该…已经不在了吧。"
                },
                {
                    "id": "30080713",
                    "speaker": "妮露",
                    "text": "嗯？你刚刚说什么？"
                },
                {
                    "id": "30080714",
                    "speaker": "迪娜泽黛",
                    "text": "没什么，我要回去休息了，大家辛苦了。"
                },
                {
                    "id": "30080715",
                    "speaker": "派蒙",
                    "text": "那些不解风情的贤者们，居然会这样。",
                    "choices": [
                        {
                            "id": "30080716",
                            "text": "太可惜了。",
                            "response": [
                                {
                                    "id": "30080718",
                                    "speaker": "派蒙",
                                    "text": "欸，迪娜泽黛已经回去了吗？那我们也回去休息吧。"
                                },
                                {
                                    "id": "30080719",
                                    "speaker": "Black Screen",
                                    "text": "花神诞祭在遗憾的氛围中被迫中止了…"
                                }
                            ]
                        },
                        {
                            "id": "30080717",
                            "text": "不知为何感觉也是意料之中。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "300808",
            "objective": "返回住处休息",
            "dialogues": [
                {
                    "id": "30080801",
                    "speaker": "派蒙",
                    "text": "所以到头来，既视感的事还是没什么头绪吗？"
                },
                {
                    "id": "30080802",
                    "speaker": "派蒙",
                    "text": "会不会真的只是太累了…",
                    "choices": [
                        {
                            "id": "30080803",
                            "text": "好像脑袋确实昏沉沉的…",
                            "response": [
                                {
                                    "id": "30080805",
                                    "speaker": "派蒙",
                                    "text": "我也有这种感觉！所以我其实中午开始就放弃思考了，嘿嘿。"
                                },
                                {
                                    "id": "30080806",
                                    "speaker": "派蒙",
                                    "text": "既然如此，我们还是早点休息吧，就当是太累产生的幻觉…有什么事明天再想吧！"
                                },
                                {
                                    "id": "30080807",
                                    "speaker": "？？？",
                                    "text": "「嘀——」"
                                },
                                {
                                    "id": "30080808",
                                    "speaker": "？？？",
                                    "text": "…知能输出略有下降，但仍在正常阈值范围内。"
                                },
                                {
                                    "id": "30080809",
                                    "speaker": "？？？",
                                    "text": "继续留意数值变动，尽早查明原因。"
                                }
                            ]
                        },
                        {
                            "id": "30080804",
                            "text": "没有思考太多，但头脑却特别疲惫。"
                        }
                    ]
                }
            ]
        },
