    "talks": [
        {
            "id": "7223401",
            "objective": "(test)Start$HIDDEN",
            "dialogues": [
                {
                    "id": "722340101",
                    "speaker": "桦山",
                    "text": "怎么样，坐起来舒服吗？"
                },
                {
                    "id": "722340102",
                    "speaker": "Player",
                    "text": "突然出现，吓我一跳！"
                },
                {
                    "id": "722340103",
                    "speaker": "桦山",
                    "text": "抱歉抱歉，没打算这样的。"
                },
                {
                    "id": "722340104",
                    "speaker": "桦山",
                    "text": "我叫桦山，你现在坐的位置我也经常坐。很安静，适合思考人生。"
                },
                {
                    "id": "722340105",
                    "speaker": "Player",
                    "text": "那我让、让给你？"
                },
                {
                    "id": "722340106",
                    "speaker": "桦山",
                    "text": "唉，谢谢，可是不必了。话说，你是从别处来的？"
                },
                {
                    "id": "722340107",
                    "speaker": "Player",
                    "text": "是的。"
                },
                {
                    "id": "722340108",
                    "speaker": "桦山",
                    "text": "那你一定见识很广吧。我从来没出去过，虽然四处搬家的经历倒是很丰富。"
                },
                {
                    "id": "722340109",
                    "speaker": "桦山",
                    "text": "唉，说起这搬家的经历…"
                },
                {
                    "id": "722340110",
                    "speaker": "桦山",
                    "text": "因为年少时频频搬家，几乎没结识几个相熟的伙伴。独自四处游荡时发现了不错的景致也无人可分享…"
                },
                {
                    "id": "722340111",
                    "speaker": "桦山",
                    "text": "唉，如果能让你看看那些景致，那倒也好。你在旅途中经过这些地方，不妨坐下看看，要是能回来和我谈谈你的感受那就更好了。"
                },
                {
                    "id": "722340112",
                    "speaker": "桦山",
                    "text": "一处在狭间之街最高处的石门下，一处在常夜灵庙旁珊瑚环绕的空阔地，一处在蛇心之地的高耸残垣旁。"
                },
                {
                    "id": "722340113",
                    "speaker": "桦山",
                    "text": "我在这些地方都留下了标记，在高处挂了灯盏，给自己照亮。你应该能很容易找到。"
                }
            ]
        },
        {
            "id": "7223402",
            "objective": "(test)和NPC对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7223403",
            "objective": "(test)座点2$HIDDEN",
            "dialogues": [
                {
                    "id": "722340301",
                    "speaker": "桦山",
                    "text": "你回来了。"
                },
                {
                    "id": "722340302",
                    "speaker": "桦山",
                    "text": "你已经去过所有的地方了吗？见多识广的你或许会觉得这些地方的景色都不值一提吧。",
                    "choices": [
                        {
                            "id": "722340303",
                            "text": "我觉得挺不错的，很独特。",
                            "response": [
                                {
                                    "id": "722340305",
                                    "speaker": "桦山",
                                    "text": "唉，想想我还从来没跟人分享过这些。能知道你的感想就足够了。"
                                },
                                {
                                    "id": "722340306",
                                    "speaker": "桦山",
                                    "text": "也许别处有比这里好得多的地方吧。毕竟这里黑黢黢的，饭食也没什么选择的余地，还得提防龙蜥…"
                                },
                                {
                                    "id": "722340307",
                                    "speaker": "桦山",
                                    "text": "但是生活得久了，竟还是有些不舍的感觉。在那几处看过的风景，现在想起来，也还是觉得怀念。"
                                },
                                {
                                    "id": "722340308",
                                    "speaker": "桦山",
                                    "text": "你也会有这样的感觉吗？即使是这样的地方，住得久了，也会有家的感觉。",
                                    "choices": [
                                        {
                                            "id": "722340309",
                                            "text": "也许吧。",
                                            "response": [
                                                {
                                                    "id": "722340311",
                                                    "speaker": "桦山",
                                                    "text": "是这样吗…"
                                                },
                                                {
                                                    "id": "722340312",
                                                    "speaker": "桦山",
                                                    "text": "…总之谢谢你听我说这些无用的闲话。虽然不是什么贵重的东西，但我只有这些了，请你收下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722340310",
                                            "text": "不会。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722340304",
                            "text": "普普通通，我见过更壮丽的景色。"
                        }
                    ]
                }
            ]
        },
