        {
            "id": "60701",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "6070101",
                    "speaker": "帕斯里",
                    "text": "顶住！再拖个衣柜过来！呃…！"
                },
                {
                    "id": "6070102",
                    "speaker": "菲谢尔",
                    "text": "大胆魔物，幽夜净土不会容忍此等罪行…"
                },
                {
                    "id": "6070103",
                    "speaker": "Player",
                    "text": "是菲谢尔！"
                },
                {
                    "id": "6070104",
                    "speaker": "奥兹",
                    "text": "#噢，是{NICKNAME}的声音！"
                },
                {
                    "id": "6070105",
                    "speaker": "菲谢尔",
                    "text": "来得正是时候，吾之扈从啊，拔剑吧！"
                }
            ]
        },
        {
            "id": "60702",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "6070201",
                    "speaker": "菲谢尔",
                    "text": "汝等无需惊恐，魔物已被消灭。"
                },
                {
                    "id": "6070202",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，接下来也请不要随意外出，留在室内便好。我们会尽可能保证这一带居民的安全。"
                },
                {
                    "id": "6070203",
                    "speaker": "帕斯里",
                    "text": "非常感谢！非常感谢！"
                },
                {
                    "id": "6070204",
                    "speaker": "帕斯里",
                    "text": "不过，这只…这只大鸟竟然也会说话吗？哎呀…这…"
                },
                {
                    "id": "6070205",
                    "speaker": "奥兹",
                    "text": "噢，您不必多虑，我只是小姐的臣子，绝不是乡野魔物，更不会对各位造成任何威胁。"
                },
                {
                    "id": "6070206",
                    "speaker": "Player",
                    "text": "这两位都是好人，请放心。"
                },
                {
                    "id": "6070207",
                    "speaker": "帕斯里",
                    "text": "啊、啊当然，我不是那个意思！抱歉，抱歉，都怪我口不择言的…"
                },
                {
                    "id": "6070208",
                    "speaker": "菲谢尔",
                    "text": "嗯哼，无妨。"
                },
                {
                    "id": "6070209",
                    "speaker": "菲谢尔",
                    "text": "扈从，还有要事在身么？尽管去铲平余孽吧，光辉的皇女祝福你的前路。"
                }
            ]
        },
