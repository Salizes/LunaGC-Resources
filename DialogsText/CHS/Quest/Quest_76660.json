    "talks": [
        {
            "id": "7666001",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "766600101",
                    "speaker": "凯瑟琳",
                    "text": "欢迎你，冒险家，需要我为您查看今天的委托吗？",
                    "choices": [
                        {
                            "id": "766600102",
                            "text": "果然还是这样最习惯…",
                            "response": [
                                {
                                    "id": "766600104",
                                    "speaker": "凯瑟琳",
                                    "text": "咦，您是…急着办事么，我能为您做些什么？",
                                    "choices": [
                                        {
                                            "id": "766600105",
                                            "text": "没有没有。",
                                            "response": [
                                                {
                                                    "id": "766600107",
                                                    "speaker": "派蒙",
                                                    "text": "我们就是单纯地很高兴见到你！嘿嘿，还是凯瑟琳最好了。"
                                                },
                                                {
                                                    "id": "766600108",
                                                    "speaker": "凯瑟琳",
                                                    "text": "谢谢二位的热情…抱歉，可能我并没有理解您的幽默感…"
                                                },
                                                {
                                                    "id": "766600109",
                                                    "speaker": "凯瑟琳",
                                                    "text": "但无论如何，欢迎您来到挪德卡莱，这里是一片充满机遇的土地。"
                                                },
                                                {
                                                    "id": "766600110",
                                                    "speaker": "凯瑟琳",
                                                    "text": "我相信，您一定能在这里经历伟大的冒险，取得举世无双的宝物。"
                                                },
                                                {
                                                    "id": "766600111",
                                                    "speaker": "凯瑟琳",
                                                    "text": "祝福您，冒险家，继续冒险吧，向着星辰与深渊！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766600106",
                                            "text": "我们就是…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766600103",
                            "text": "还好是你，凯瑟琳。"
                        }
                    ]
                }
            ]
        }
    ]
