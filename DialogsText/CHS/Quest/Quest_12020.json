    "talks": [
        {
            "id": "1202001",
            "objective": "前往海祇岛约定地点",
            "dialogues": [
                {
                    "id": "120200101",
                    "speaker": "五郎",
                    "text": "幸亏你在这里，不然还真让他们给逃掉了。"
                },
                {
                    "id": "120200102",
                    "speaker": "派蒙",
                    "text": "你手里的就是心海的锦囊吗？"
                },
                {
                    "id": "120200103",
                    "speaker": "派蒙",
                    "text": "让我看看…哇！好厚！这么厚一本都是吗？"
                },
                {
                    "id": "120200104",
                    "speaker": "五郎",
                    "text": "其实…这只是一部分，我身上还有五本来着。"
                },
                {
                    "id": "120200105",
                    "speaker": "派蒙",
                    "text": "这么多！"
                },
                {
                    "id": "120200106",
                    "speaker": "五郎",
                    "text": "珊瑚宫大人向来算无遗策。这些又是「常备锦囊」，难免数量会多一些。"
                },
                {
                    "id": "120200107",
                    "speaker": "五郎",
                    "text": "不过也多亏了这些锦囊，我们才能够应对各种各样复杂的情况。"
                },
                {
                    "id": "120200108",
                    "speaker": "派蒙",
                    "text": "这么多锦囊，心海要写多久啊。每一种情况都要考虑，想想就让人头疼…"
                },
                {
                    "id": "120200109",
                    "speaker": "幸德",
                    "text": "队长！你这次回海祇岛，会重新接手剑鱼二番队吗？我们大家都很想你！",
                    "choices": [
                        {
                            "id": "120200110",
                            "text": "剑鱼二番队还在吗？",
                            "response": [
                                {
                                    "id": "120200112",
                                    "speaker": "幸德",
                                    "text": "珊瑚宫大人说，现在已经是和平时期，军队的数量需要适当减少，帮助民众恢复生产。"
                                },
                                {
                                    "id": "120200113",
                                    "speaker": "幸德",
                                    "text": "一半左右的士兵还维持着「别动队」的编制，支援各个小队。还有一半改为从事巡逻、建造、农耕之类的工作。"
                                },
                                {
                                    "id": "120200114",
                                    "speaker": "幸德",
                                    "text": "前两天还听以前的同伴抱怨说，自己不想被分去造房子，想留在前线继续战斗。"
                                },
                                {
                                    "id": "120200115",
                                    "speaker": "派蒙",
                                    "text": "反抗军的大家还是老样子呢…"
                                },
                                {
                                    "id": "120200116",
                                    "speaker": "派蒙",
                                    "text": "对了！说起来，是心海叫我们来参加庆功会的。五郎，你知道心海在哪里吗？"
                                },
                                {
                                    "id": "120200117",
                                    "speaker": "五郎",
                                    "text": "珊瑚宫大人的话，现在应该是在望泷村。"
                                },
                                {
                                    "id": "120200118",
                                    "speaker": "五郎",
                                    "text": "听说那边出了点事情，珊瑚宫大人应该会亲自过去处理。"
                                },
                                {
                                    "id": "120200119",
                                    "speaker": "五郎",
                                    "text": "#我们也该离开了…另外，{NICKNAME}，你可以关注一下路上的士兵们。"
                                },
                                {
                                    "id": "120200120",
                                    "speaker": "五郎",
                                    "text": "最近我感觉不少士兵都有些浮躁，不过我也不知道为什么，他们不想跟我说。"
                                },
                                {
                                    "id": "120200121",
                                    "speaker": "五郎",
                                    "text": "以前大家有什么烦恼都会告诉我，现在却躲躲藏藏的…我很担心他们会不会是遇到了什么麻烦。",
                                    "choices": [
                                        {
                                            "id": "120200122",
                                            "text": "我来试试。",
                                            "response": [
                                                {
                                                    "id": "120200124",
                                                    "speaker": "派蒙",
                                                    "text": "是呀，我们也想和反抗军的士兵们聊聊呢！"
                                                },
                                                {
                                                    "id": "120200125",
                                                    "speaker": "派蒙",
                                                    "text": "#我们出发吧，{NICKNAME}。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120200123",
                                            "text": "正好去见一见以前的同伴。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120200111",
                            "text": "现在大家怎么样了？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202009",
            "objective": "与五郎交谈",
            "dialogues": [
                {
                    "id": "120200601",
                    "speaker": "派蒙",
                    "text": "这里应该就是我们和心海相约见面的地方了。"
                },
                {
                    "id": "120200602",
                    "speaker": "派蒙",
                    "text": "旅行者，你还记得这里吗？"
                },
                {
                    "id": "120200603",
                    "speaker": "派蒙",
                    "text": "上次来海祇岛的时候，我们好像路过这里。"
                },
                {
                    "id": "120200604",
                    "speaker": "派蒙",
                    "text": "当时，你还当上了「剑鱼二番队」的队长。不知道过了这么久，反抗军的士兵们还记不记得你…"
                },
                {
                    "id": "120200605",
                    "speaker": "派蒙",
                    "text": "海祇岛上应该也有很多变化吧！不如我们先去附近转转如何？"
                },
                {
                    "id": "120200627",
                    "speaker": "派蒙",
                    "text": "欸，那不是五郎吗？我们过去看看吧！"
                },
                {
                    "id": "120200606",
                    "speaker": "五郎",
                    "text": "「敌众我寡，寻求突破；敌寡我众，务求全胜…」"
                },
                {
                    "id": "120200607",
                    "speaker": "五郎",
                    "text": "「临海之盗，必有运船；焚船而战，可得全功…」"
                },
                {
                    "id": "120200608",
                    "speaker": "利彦",
                    "text": "五郎大人，有结论了吗？"
                },
                {
                    "id": "120200609",
                    "speaker": "五郎",
                    "text": "嗯。根据珊瑚宫大人留下的锦囊，可以推断出愚人众必定有船停泊在附近，所以才如此嚣张。"
                },
                {
                    "id": "120200610",
                    "speaker": "五郎",
                    "text": "我们可以分成两队，一队吸引他们的注意，另一队绕后烧掉他们的船，这样他们就逃不掉了！"
                },
                {
                    "id": "120200611",
                    "speaker": "五郎",
                    "text": "但珊瑚宫大人也说，兵力不足的情况下，尽量不要分兵。否则很容易被各个击破，导致全线崩溃…"
                },
                {
                    "id": "120200612",
                    "speaker": "幸德",
                    "text": "要不我回去求援？"
                },
                {
                    "id": "120200613",
                    "speaker": "五郎",
                    "text": "恐怕来不及。看他们的动向，应该是准备离开了。"
                },
                {
                    "id": "120200614",
                    "speaker": "五郎",
                    "text": "珊瑚宫大人的锦囊里还写了，「设伏于野，不可妄动」。既然这次兵力不够，就只能暂时放弃了。"
                },
                {
                    "id": "120200615",
                    "speaker": "利彦",
                    "text": "难道要眼睁睁地看着这些家伙离开吗？我不甘心！"
                },
                {
                    "id": "120200616",
                    "speaker": "五郎",
                    "text": "其实，珊瑚宫大人的锦囊里还有一句「山穷水尽，或有援军」。不过我没懂，援军指的是…"
                },
                {
                    "id": "120200617",
                    "speaker": "派蒙",
                    "text": "五郎，你们怎么在这里呀？"
                },
                {
                    "id": "120200618",
                    "speaker": "幸德",
                    "text": "队长！你回海祇岛了？"
                },
                {
                    "id": "120200619",
                    "speaker": "Player",
                    "text": "来助你们一臂之力。"
                },
                {
                    "id": "120200620",
                    "speaker": "五郎",
                    "text": "#太好了！珊瑚宫大人的锦囊果然没错…{NICKNAME}，你来得正好。"
                },
                {
                    "id": "120200621",
                    "speaker": "五郎",
                    "text": "最近愚人众残党异常活跃，这次我们察觉到了他们的动向，提前埋伏在这里。"
                },
                {
                    "id": "120200622",
                    "speaker": "五郎",
                    "text": "可惜我们人数不够，无法做到兵分两路…能拜托你帮忙牵制一下吗？"
                },
                {
                    "id": "120200623",
                    "speaker": "派蒙",
                    "text": "好吧。说不定愚人众又要干什么坏事，我们也不能放任不管。"
                },
                {
                    "id": "120200624",
                    "speaker": "五郎",
                    "text": "好！事不宜迟，我带人绕后烧毁他们的船，之后回来与你会合。"
                },
                {
                    "id": "120200625",
                    "speaker": "五郎",
                    "text": "务必小心，我们很快就回来。"
                },
                {
                    "id": "120200626",
                    "speaker": "派蒙",
                    "text": "看来反抗军的大家都还记得我们呢！我们也帮他们好好解决一下眼前的麻烦吧！"
                }
            ]
        },
        {
            "id": "1202002",
            "objective": "击败游荡的愚人众",
            "dialogues": [
                {
                    "id": "120200201",
                    "speaker": "传次郎",
                    "text": "你是…剑鱼二番队的队长？"
                },
                {
                    "id": "120200202",
                    "speaker": "传次郎",
                    "text": "我认得你！多亏了你，海祇岛才有现在的和平。"
                },
                {
                    "id": "120200203",
                    "speaker": "传次郎",
                    "text": "我虽然不是剑鱼二番队的成员，但当初在踏鞴砂的时候，我就见过你了。"
                },
                {
                    "id": "120200204",
                    "speaker": "传次郎",
                    "text": "当时两军对垒，你在阵前比武中单挑好几个幕府武士，帅得不行！"
                },
                {
                    "id": "120200205",
                    "speaker": "传次郎",
                    "text": "有什么需要我帮忙的吗？我在所不辞！"
                },
                {
                    "id": "120200206",
                    "speaker": "Player",
                    "text": "关于最近发生的事…"
                },
                {
                    "id": "120200207",
                    "speaker": "传次郎",
                    "text": "大家很浮躁啊…确实，我也感觉到了。"
                },
                {
                    "id": "120200208",
                    "speaker": "传次郎",
                    "text": "可能是大家还没有从战争中走出来吧。那时候在战场上，随时都可能牺牲，每个人都很紧张。"
                },
                {
                    "id": "120200209",
                    "speaker": "传次郎",
                    "text": "突然战争结束了，才发现不知道要怎么回归正常的生活…哈哈，我觉得没关系，过段时间说不定就好啦。"
                },
                {
                    "id": "120200210",
                    "speaker": "传次郎",
                    "text": "别的我也不知道了。不过，有珊瑚宫大人在，海祇岛就不会有事，我们都深信这一点。"
                },
                {
                    "id": "120200211",
                    "speaker": "传次郎",
                    "text": "现在你也回来了，这里就更安全了！如果有什么需要，可以随时来找我！"
                },
                {
                    "id": "120200212",
                    "speaker": "派蒙",
                    "text": "感觉他很热情呢…我们再去问问下一个人吧。"
                }
            ]
        },
        {
            "id": "1202003",
            "objective": "回复五郎",
            "dialogues": []
        },
        {
            "id": "1202004",
            "objective": "向士兵们打听情报",
            "dialogues": []
        },
        {
            "id": "1202005",
            "objective": "向士兵们打听情报",
            "dialogues": [
                {
                    "id": "120200301",
                    "speaker": "有泽",
                    "text": "呵欠…和平…最棒了…"
                },
                {
                    "id": "120200302",
                    "speaker": "有泽",
                    "text": "嗯？你看上去有点眼熟…？"
                },
                {
                    "id": "120200303",
                    "speaker": "有泽",
                    "text": "我好像在哪见过你来着…想不起来了。但你应该不是敌人，有什么事吗？"
                },
                {
                    "id": "120200304",
                    "speaker": "Player",
                    "text": "关于最近发生的事…"
                },
                {
                    "id": "120200305",
                    "speaker": "有泽",
                    "text": "你说大家有些浮躁？有吗，我没感觉到啊。"
                },
                {
                    "id": "120200306",
                    "speaker": "有泽",
                    "text": "可能是因为我平时不喜欢跟别人聊天吧，在我眼里他们一直都很闹腾。"
                },
                {
                    "id": "120200307",
                    "speaker": "有泽",
                    "text": "来之不易的和平，必须要好好享受才行…在这里晒晒太阳，吹吹海风，就是我生命的全部了。"
                },
                {
                    "id": "120200308",
                    "speaker": "有泽",
                    "text": "抱歉啊，我也没办法回答你的问题。不过你可以问珊瑚宫大人，珊瑚宫大人什么都懂的。"
                },
                {
                    "id": "120200309",
                    "speaker": "派蒙",
                    "text": "呜哇…他快要睡着了。我们还是不要打扰他了，去问问下一个人吧！"
                }
            ]
        },
        {
            "id": "1202006",
            "objective": "向士兵们打听情报",
            "dialogues": [
                {
                    "id": "120200401",
                    "speaker": "嘉久",
                    "text": "唉，珊瑚宫大人到底是怎么想的，怎么能同意和谈呢？"
                },
                {
                    "id": "120200402",
                    "speaker": "恒雄",
                    "text": "是啊…天领奉行那些家伙根本不值得相信，我还听说天领奉行的人秘密勾结愚人众，打算继续对我们开战呢。"
                },
                {
                    "id": "120200403",
                    "speaker": "嘉久",
                    "text": "真的假的？消息可靠吗？"
                },
                {
                    "id": "120200404",
                    "speaker": "恒雄",
                    "text": "当然是真的，我们的人与愚人众交手，正好撞见了他们正在密谋这件事。"
                },
                {
                    "id": "120200405",
                    "speaker": "嘉久",
                    "text": "我就知道，天领奉行那帮家伙贼心不死…珊瑚宫大人还是有点天真，怎么能轻易相信他们呢？"
                },
                {
                    "id": "120200406",
                    "speaker": "恒雄",
                    "text": "嘘，小点声，有人来了。"
                },
                {
                    "id": "120200407",
                    "speaker": "派蒙",
                    "text": "你们在聊什么呢？"
                },
                {
                    "id": "120200408",
                    "speaker": "嘉久",
                    "text": "#{NICKNAME}队长？你回来了！",
                    "choices": [
                        {
                            "id": "120200409",
                            "text": "与你们一起开庆功会。",
                            "response": [
                                {
                                    "id": "120200411",
                                    "speaker": "嘉久",
                                    "text": "我说，刚刚的事情，能跟队长说吗？"
                                },
                                {
                                    "id": "120200412",
                                    "speaker": "恒雄",
                                    "text": "#还是不要吧。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也是珊瑚宫大人提拔起来的，说不定也主张和谈…"
                                },
                                {
                                    "id": "120200413",
                                    "speaker": "嘉久",
                                    "text": "队长应该理解我们吧？不过小心一点也有道理…"
                                },
                                {
                                    "id": "120200414",
                                    "speaker": "嘉久",
                                    "text": "那个，欢迎队长回海祇岛！我们这边没什么事，一切安好！"
                                },
                                {
                                    "id": "120200415",
                                    "speaker": "恒雄",
                                    "text": "珊瑚宫大人现在应该在村庄里，队长大人可以直接过去！"
                                },
                                {
                                    "id": "120200416",
                                    "speaker": "派蒙",
                                    "text": "唔…总觉得他们好像在聊什么秘密的事情。不过既然他们不肯说，我们还是先去村子里看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "120200410",
                            "text": "最近发生了什么事吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202007",
            "objective": "前往望泷村",
            "dialogues": []
        },
        {
            "id": "1202008",
            "objective": "调查士兵与商人的争执",
            "dialogues": [
                {
                    "id": "120200501",
                    "speaker": "松田",
                    "text": "说！你是不是偷偷把从海祇岛采购的货物，运送给天领奉行了？"
                },
                {
                    "id": "120200502",
                    "speaker": "松田",
                    "text": "我早就觉得你一个天领奉行的商人，来海祇岛做生意不正常。这一次你总没话说了吧？"
                },
                {
                    "id": "120200503",
                    "speaker": "成濑",
                    "text": "冤，冤枉啊…"
                },
                {
                    "id": "120200504",
                    "speaker": "内村",
                    "text": "还说冤枉？当时我们就不应该同意你来海祇岛做生意。"
                },
                {
                    "id": "120200505",
                    "speaker": "内村",
                    "text": "带走带走！"
                },
                {
                    "id": "120200506",
                    "speaker": "Player",
                    "text": "等等…"
                },
                {
                    "id": "120200507",
                    "speaker": "珊瑚宫心海",
                    "text": "请等一下！"
                },
                {
                    "id": "120200508",
                    "speaker": "派蒙",
                    "text": "心海！你来啦！"
                },
                {
                    "id": "120200509",
                    "speaker": "派蒙",
                    "text": "这里好像发生了什么事情，你快来看看吧！"
                },
                {
                    "id": "120200510",
                    "speaker": "松田",
                    "text": "报告珊瑚宫大人，这个商人形迹可疑，被我们抓到了。"
                },
                {
                    "id": "120200511",
                    "speaker": "松田",
                    "text": "据我们观察，他长期只买不卖，身边却一点货物都没有，很可能是偷偷运到天领奉行去了！"
                },
                {
                    "id": "120200512",
                    "speaker": "成濑",
                    "text": "我没有…我…"
                },
                {
                    "id": "120200513",
                    "speaker": "珊瑚宫心海",
                    "text": "好了。各位不要激动，放松放松。跟我一起做个深呼吸…呼…有好一些吗？"
                },
                {
                    "id": "120200514",
                    "speaker": "珊瑚宫心海",
                    "text": "松田、内村，我知道你们很担心海祇岛的安全。"
                },
                {
                    "id": "120200515",
                    "speaker": "珊瑚宫心海",
                    "text": "但是，先不管这位商人先生有没有犯错，我们至少要给他解释的权利。"
                },
                {
                    "id": "120200516",
                    "speaker": "珊瑚宫心海",
                    "text": "有错自然应该接受惩罚，无错也不应该被随意冤枉。海祇岛上，办事靠的是事实，而非主观判断。"
                },
                {
                    "id": "120200517",
                    "speaker": "珊瑚宫心海",
                    "text": "商人先生，既然我的部下提出了货物的问题，不妨请你解释一下，由我来做个评断如何？"
                },
                {
                    "id": "120200518",
                    "speaker": "成濑",
                    "text": "可以，当然可以！"
                },
                {
                    "id": "120200519",
                    "speaker": "成濑",
                    "text": "我在海祇岛经商，当然也积累下来了一批货物。本来想囤久一点，等下次涨价的时候卖出…咳。"
                },
                {
                    "id": "120200520",
                    "speaker": "成濑",
                    "text": "却没想到，被愚人众给打劫了！我容易吗？风里来雨里去的，货被抢了还要被你们盘问…"
                },
                {
                    "id": "120200521",
                    "speaker": "内村",
                    "text": "哼，谁知道你说的是不是真的？",
                    "choices": [
                        {
                            "id": "120200522",
                            "text": "我们来的路上…",
                            "response": [
                                {
                                    "id": "120200524",
                                    "speaker": "内村",
                                    "text": "那也不能证明他的货就是被愚人众拿走的啊！"
                                },
                                {
                                    "id": "120200525",
                                    "speaker": "内村",
                                    "text": "再说了，天领奉行和愚人众还有勾结呢！你的货给愚人众，和给天领奉行有什么区别？"
                                },
                                {
                                    "id": "120200526",
                                    "speaker": "成濑",
                                    "text": "啊？天领奉行勾结愚人众？这是哪来的消息，我完全不知道！"
                                },
                                {
                                    "id": "120200527",
                                    "speaker": "成濑",
                                    "text": "再说，就算他们有勾结，也不关我的事吧…"
                                },
                                {
                                    "id": "120200528",
                                    "speaker": "派蒙",
                                    "text": "战争都已经结束了，天领奉行还会继续勾结愚人众吗？嗯…我觉得不像呀。"
                                },
                                {
                                    "id": "120200529",
                                    "speaker": "派蒙",
                                    "text": "不久之前我们还见了九条家的名代，现在的他应该不会做这种事吧。"
                                },
                                {
                                    "id": "120200530",
                                    "speaker": "派蒙",
                                    "text": "不过刚刚来的路上，那些士兵好像也在讨论这件事…心海，你知道什么吗？"
                                },
                                {
                                    "id": "120200531",
                                    "speaker": "珊瑚宫心海",
                                    "text": "确实听到了这样的汇报。"
                                },
                                {
                                    "id": "120200532",
                                    "speaker": "珊瑚宫心海",
                                    "text": "再过不久，就是我们与天领奉行之间的和谈了。这次和谈是神里家组织的，选在一个中立地点举办。"
                                },
                                {
                                    "id": "120200533",
                                    "speaker": "珊瑚宫心海",
                                    "text": "我和九条裟罗会各带一些侍卫，好好商讨一下关于未来的计划。"
                                },
                                {
                                    "id": "120200534",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但是在这样一个重要的时刻，我却听到一些传闻，九条家与愚人众很可能还存在勾结，他们想彻底覆灭海祇岛。"
                                },
                                {
                                    "id": "120200535",
                                    "speaker": "珊瑚宫心海",
                                    "text": "如果是这样的话，和谈就可能是陷阱，甚至连神里家都可能参与其中…"
                                },
                                {
                                    "id": "120200536",
                                    "speaker": "珊瑚宫心海",
                                    "text": "这位商人先生，你确定你的货物，是被愚人众劫走的吗？"
                                },
                                {
                                    "id": "120200537",
                                    "speaker": "成濑",
                                    "text": "是真的，我没有骗你们！愚人众抢了我的货物就往那边跑了，他们很可能在那边有秘密基地！"
                                },
                                {
                                    "id": "120200538",
                                    "speaker": "珊瑚宫心海",
                                    "text": "那好，事关重大，不如我们帮你把货物找回来。如果一切顺利，自然可以还你清白。"
                                },
                                {
                                    "id": "120200539",
                                    "speaker": "珊瑚宫心海",
                                    "text": "但如果真的有什么情况，证明愚人众和天领奉行有所勾结的话，还希望你配合我们调查，这样如何？"
                                },
                                {
                                    "id": "120200540",
                                    "speaker": "成濑",
                                    "text": "我没意见，多谢珊瑚宫大人出手相帮。"
                                },
                                {
                                    "id": "120200541",
                                    "speaker": "珊瑚宫心海",
                                    "text": "松田、内村，你们呢？"
                                },
                                {
                                    "id": "120200542",
                                    "speaker": "松田",
                                    "text": "全听珊瑚宫大人吩咐。"
                                },
                                {
                                    "id": "120200543",
                                    "speaker": "珊瑚宫心海",
                                    "text": "#那就好。{NICKNAME}…不，剑鱼小队二番队队长，能请你和我一起调查此事吗？",
                                    "choices": [
                                        {
                                            "id": "120200544",
                                            "text": "当然可以。",
                                            "response": [
                                                {
                                                    "id": "120200545",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "呵呵…那就让我看看，这段时间你有没有新的成长。"
                                                },
                                                {
                                                    "id": "120200546",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "我也会教你一些我擅长的东西…跟我来吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120200547",
                                            "text": "遵命！",
                                            "response": [
                                                {
                                                    "id": "120200548",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "呵呵…不用这么严肃啦。不管以后如何，现在是和平时期。"
                                                },
                                                {
                                                    "id": "120200549",
                                                    "speaker": "珊瑚宫心海",
                                                    "text": "而且你也不会一直留在海祇岛…虽然还维持着这样的称呼，但我们像朋友一样就好啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120200523",
                            "text": "刚刚确实遇到了愚人众…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1202010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120201001",
                    "speaker": "传次郎",
                    "text": "有什么需要我帮忙的吗？"
                }
            ]
        },
        {
            "id": "1202012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120201201",
                    "speaker": "有泽",
                    "text": "呵欠…还有什么事吗？别打扰我休息…"
                }
            ]
        },
        {
            "id": "1202014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120201401",
                    "speaker": "嘉久",
                    "text": "报告队长！一切安好！"
                },
                {
                    "id": "120201402",
                    "speaker": "恒雄",
                    "text": "找珊瑚宫大人的话，她现在应该在村子里。"
                }
            ]
        },
        {
            "id": "1202099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120209901",
                    "speaker": "愚人众先遣队",
                    "text": "不好了兄弟们！咱们的船被人烧了！"
                },
                {
                    "id": "120209902",
                    "speaker": "愚人众先遣队",
                    "text": "还有这事？太卑鄙了！"
                },
                {
                    "id": "120209903",
                    "speaker": "愚人众先遣队",
                    "text": "兄弟们上！没有退路了，给他们点颜色瞧瞧！"
                },
                {
                    "id": "120209904",
                    "speaker": "派蒙",
                    "text": "如果能在愚人众手里找到货物的话，应该就能证明那位商人的清白了吧。"
                },
                {
                    "id": "120209905",
                    "speaker": "派蒙",
                    "text": "还有那个愚人众勾结天领奉行的传闻…我们也必须要好好地调查一下才行！"
                }
            ]
        }
    ]
}