            "dialogues": [
                {
                    "id": "730640301",
                    "speaker": "箱底的纸条",
                    "text": "「恭喜——随便是谁都行！」"
                },
                {
                    "id": "730640302",
                    "speaker": "箱底的纸条",
                    "text": "「哈哈，反正那个呆瓜肯定也找不到这个箱子。」"
                },
                {
                    "id": "730640303",
                    "speaker": "箱底的纸条",
                    "text": "「正在看这个纸条的，随便谁都好，再告诉你一个好消息吧。」"
                },
                {
                    "id": "730640304",
                    "speaker": "箱底的纸条",
                    "text": "「玻璃房子…就是禅什么园的地方附近，有月莲的水池，还有好东西。」"
                },
                {
                    "id": "730640305",
                    "speaker": "箱底的纸条",
                    "text": "「离得这么近，满脑子研究和论文的呆瓜却一无所知，嘿嘿。」"
                }
            ]
        }
    ]
