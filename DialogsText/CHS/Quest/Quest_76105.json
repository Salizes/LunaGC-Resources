        {
            "id": "7610501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761050101",
                    "speaker": "玛尔塔",
                    "text": "#{M#大哥哥}{F#大姐姐}，你看到那些岩居蟹了吗？好像在进行什么神秘的仪式。"
                },
                {
                    "id": "761050102",
                    "speaker": "Player",
                    "text": "这就是它们的生态吧。"
                },
                {
                    "id": "761050103",
                    "speaker": "玛尔塔",
                    "text": "是这样吗？哦…我好像懂了。"
                },
                {
                    "id": "761050104",
                    "speaker": "玛尔塔",
                    "text": "那夏镇也有很多人跟这些岩居蟹一样，有的会勾肩搭背走在一起，有的一见面就拳脚问候然后分开。"
                },
                {
                    "id": "761050105",
                    "speaker": "玛尔塔",
                    "text": "这就是那夏镇的生态吧。",
                    "choices": [
                        {
                            "id": "761050106",
                            "text": "没错，你理解得很快。",
                            "response": [
                                {
                                    "id": "761050108",
                                    "speaker": "玛尔塔",
                                    "text": "#那{M#大哥哥}{F#大姐姐}，你能让这些岩居蟹都进到小水潭里吗？"
                                },
                                {
                                    "id": "761050109",
                                    "speaker": "玛尔塔",
                                    "text": "唔…就像把所有的宝藏猎人都喊去「旗舰」？感觉会很有意思。"
                                },
                                {
                                    "id": "761051501",
                                    "speaker": "玛尔塔",
                                    "text": "#好想看看岩居蟹都聚在一起的时候会发生什么…{M#大哥哥}{F#大姐姐}，你现在有空吗？"
                                }
                            ]
                        },
                        {
                            "id": "761050107",
                            "text": "好像有点微妙的区别，不过算了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7610503",
            "objective": "Additional",
            "dialogues": [
