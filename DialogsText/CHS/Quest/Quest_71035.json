{
    "quest": {
        "id": "71035",
        "title": "身后事·铜雀之迹",
        "description": "当你们闻到「烤吃虎鱼」的香气时，不禁想起了一位曾经帮助过你们的人…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 89,
        "total_speaker_counts": {
            "Player": 14,
            "卯师傅": 3,
            "派蒙": 25,
            "王平安": 38,
            "魈": 8,
            "？？？": 1
        }
    },
    "talks": [
        {
            "id": "7103501",
            "objective": "前往万民堂$HIDDEN",
            "dialogues": [
                {
                    "id": "710350101",
                    "speaker": "卯师傅",
                    "text": "二位，要点什么？"
                },
                {
                    "id": "710350102",
                    "speaker": "Player",
                    "text": "三份烤吃虎鱼，打包。"
                },
                {
                    "id": "710350103",
                    "speaker": "卯师傅",
                    "text": "好嘞！您在这稍等一会。"
                },
                {
                    "id": "710350104",
                    "speaker": "派蒙",
                    "text": "三份？你一份，我一份…还有一份是…",
                    "choices": [
                        {
                            "id": "710350105",
                            "text": "想去看看铜雀。",
                            "response": [
                                {
                                    "id": "710350107",
                                    "speaker": "派蒙",
                                    "text": "你是说之前把七星灯和香炉给我们的那位铜雀先生吗？"
                                },
                                {
                                    "id": "710350108",
                                    "speaker": "派蒙",
                                    "text": "对喔，记得铜雀先生说过他很想念烤吃虎鱼…"
                                },
                                {
                                    "id": "710350109",
                                    "speaker": "派蒙",
                                    "text": "不过，铜雀先生应该已经走了…"
                                },
                                {
                                    "id": "710350110",
                                    "speaker": "Player",
                                    "text": "去看看也好。"
                                },
                                {
                                    "id": "710350111",
                                    "speaker": "派蒙",
                                    "text": "嗯，那我们就再去看看吧。"
                                },
                                {
                                    "id": "710350112",
                                    "speaker": "派蒙",
                                    "text": "之前在那边见到铜雀先生的时候，那间庙又破又旧，旁边好像还有盗宝团的踪迹…"
                                },
                                {
                                    "id": "710350113",
                                    "speaker": "派蒙",
                                    "text": "希望，铜雀先生的雕像别被人弄坏了…"
                                },
                                {
                                    "id": "710350114",
                                    "speaker": "卯师傅",
                                    "text": "二位，您要的三份烤吃虎鱼打包好了，您拿好。"
                                },
                                {
                                    "id": "710350115",
                                    "speaker": "派蒙",
                                    "text": "#好香啊！{NICKNAME}，那我们就快点出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "710350106",
                            "text": "铜雀喜欢吃烤吃虎鱼。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103502",
            "objective": "和卯师傅对话",
            "dialogues": []
        },
        {
            "id": "7103503",
            "objective": "前往拜祭铜雀",
            "dialogues": [
                {
                    "id": "710350301",
                    "speaker": "王平安",
                    "text": "谢谢仙师，谢谢英雄…真是巧了，又遇见您了。"
                },
                {
                    "id": "710350302",
                    "speaker": "派蒙",
                    "text": "你认识我们？"
                },
                {
                    "id": "710350303",
                    "speaker": "王平安",
                    "text": "我怎么敢忘了仙师的样子呢…"
                },
                {
                    "id": "710350304",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "710350305",
                    "speaker": "王平安",
                    "text": "哎呀，我叫王平安！您想起来了吗？",
                    "choices": [
                        {
                            "id": "710350306",
                            "text": "「掇星攫辰天君」？",
                            "response": [
                                {
                                    "id": "710350307",
                                    "speaker": "王平安",
                                    "text": "啊？！别别别千万别，什么「掇星攫辰」，您可别损我了，仙师还在这呢…"
                                },
                                {
                                    "id": "710350310",
                                    "speaker": "王平安",
                                    "text": "我正准备去山里的一座供奉着夜叉「铜雀」的庙看看呢。"
                                },
                                {
                                    "id": "710350311",
                                    "speaker": "王平安",
                                    "text": "但刚进山不久，就被那群盗宝团盯上了…多谢仙师相救。"
                                },
                                {
                                    "id": "710350312",
                                    "speaker": "派蒙",
                                    "text": "等一下，你去铜雀先生的庙做什么？"
                                },
                                {
                                    "id": "710350313",
                                    "speaker": "派蒙",
                                    "text": "难不成…你在打铜雀先生雕像的主意？"
                                },
                                {
                                    "id": "710350314",
                                    "speaker": "王平安",
                                    "text": "没有！我绝不会有这种想法！"
                                },
                                {
                                    "id": "710350315",
                                    "speaker": "Player",
                                    "text": "那你想做什么？"
                                },
                                {
                                    "id": "710350316",
                                    "speaker": "王平安",
                                    "text": "我是…想要重修一下那座庙。"
                                },
                                {
                                    "id": "710350317",
                                    "speaker": "王平安",
                                    "text": "我今天过来，本来是准备再仔细看看那座庙的情况，好回去购置材料。"
                                },
                                {
                                    "id": "710350318",
                                    "speaker": "王平安",
                                    "text": "没想到，半路上被盗宝团给盯上了，只能逃跑。"
                                },
                                {
                                    "id": "710350319",
                                    "speaker": "王平安",
                                    "text": "但我跑着跑着就…迷路了。后面的事，您都知道了。"
                                },
                                {
                                    "id": "710350320",
                                    "speaker": "Player",
                                    "text": "去庙那边详细说吧。"
                                },
                                {
                                    "id": "710350321",
                                    "speaker": "王平安",
                                    "text": "对，这里不是谈话的地方，我们先去庙那边。"
                                },
                                {
                                    "id": "710350322",
                                    "speaker": "王平安",
                                    "text": "有什么话，我们到那边再说。"
                                },
                                {
                                    "id": "710350323",
                                    "speaker": "魈",
                                    "text": "你们去吧，我还有事。"
                                },
                                {
                                    "id": "710350324",
                                    "speaker": "派蒙",
                                    "text": "欸！你要走吗？"
                                },
                                {
                                    "id": "710350325",
                                    "speaker": "派蒙",
                                    "text": "已经…走掉了啊…"
                                }
                            ]
                        },
                        {
                            "id": "710350308",
                            "text": "我记得你。",
                            "response": [
                                {
                                    "id": "710350309",
                                    "speaker": "王平安",
                                    "text": "多亏您还记着。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103504",
            "objective": "与魈对话",
            "dialogues": [
                {
                    "id": "710350201",
                    "speaker": "魈",
                    "text": "你怎么来了？"
                },
                {
                    "id": "710350202",
                    "speaker": "Player",
                    "text": "你也是来看铜雀的吗？"
                },
                {
                    "id": "710350203",
                    "speaker": "魈",
                    "text": "只是路过此处，驻足片刻罢了。"
                },
                {
                    "id": "710350204",
                    "speaker": "魈",
                    "text": "你们来，是有什么事吗？"
                },
                {
                    "id": "710350205",
                    "speaker": "派蒙",
                    "text": "我们是来看铜雀先生的！"
                },
                {
                    "id": "710350206",
                    "speaker": "派蒙",
                    "text": "不过，这周围还是和上次一样，简直是一团乱啊…"
                },
                {
                    "id": "710350207",
                    "speaker": "派蒙",
                    "text": "明明建了庙，也做了雕像…怎么没人过来维护一下呢？"
                },
                {
                    "id": "710350208",
                    "speaker": "Player",
                    "text": "也许是忘了吧。"
                },
                {
                    "id": "710350209",
                    "speaker": "派蒙",
                    "text": "这也能忘记吗？夜叉明明是保护了璃月港的大英雄…"
                },
                {
                    "id": "710350210",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "710350211",
                    "speaker": "派蒙",
                    "text": "魈…你、你是不高兴了吗？"
                },
                {
                    "id": "710350212",
                    "speaker": "魈",
                    "text": "没有，夜叉但行守护之责，本就无意寻求什么后人纪念。"
                },
                {
                    "id": "710350213",
                    "speaker": "派蒙",
                    "text": "不说这些了，我们快点来吃烤吃虎鱼吧！"
                },
                {
                    "id": "710350214",
                    "speaker": "派蒙",
                    "text": "唔…要是魈也想吃的话，我们可以各自把烤吃虎鱼切一半给你喔。"
                },
                {
                    "id": "710350215",
                    "speaker": "魈",
                    "text": "不必了…"
                },
                {
                    "id": "710350216",
                    "speaker": "？？？",
                    "text": "救命啊！救命啊！"
                },
                {
                    "id": "710350217",
                    "speaker": "派蒙",
                    "text": "咦？我好像听见了什么声音…"
                },
                {
                    "id": "710350218",
                    "speaker": "魈",
                    "text": "有人呼救，在那边！"
                },
                {
                    "id": "710350219",
                    "speaker": "Player",
                    "text": "快走！"
                },
                {
                    "id": "710350220",
                    "speaker": "派蒙",
                    "text": "欸？把烤吃虎鱼收好呀！我还没吃呢！"
                }
            ]
        },
        {
            "id": "7103505",
            "objective": "前往救援遇到危险的人",
            "dialogues": []
        },
        {
            "id": "7103506",
            "objective": "与王平安对话",
            "dialogues": []
        },
        {
            "id": "7103507",
            "objective": "回到铜雀雕像所在地",
            "dialogues": []
        },
        {
            "id": "7103508",
            "objective": "与王平安对话",
            "dialogues": [
                {
                    "id": "710350401",
                    "speaker": "王平安",
                    "text": "这座庙还是这么破败…"
                },
                {
                    "id": "710350402",
                    "speaker": "派蒙",
                    "text": "赶紧交代，你怎么突然想要来修庙的？"
                },
                {
                    "id": "710350403",
                    "speaker": "王平安",
                    "text": "咳，那就说来话长了…"
                },
                {
                    "id": "710350404",
                    "speaker": "王平安",
                    "text": "我之前为了假扮仙人，搜集了很多资料…"
                },
                {
                    "id": "710350405",
                    "speaker": "王平安",
                    "text": "那次受了仙师教诲之后，我不是立下了从善的誓吗？回去之后，我就准备把那些资料全部毁掉。"
                },
                {
                    "id": "710350406",
                    "speaker": "王平安",
                    "text": "但我转念一想…与其把这些资料毁掉，不如我把这些资料，还有我行骗时的手段编写成册，散发给其他人。"
                },
                {
                    "id": "710350407",
                    "speaker": "王平安",
                    "text": "这样，说不定能帮助大家识破一些骗子…"
                },
                {
                    "id": "710350408",
                    "speaker": "王平安",
                    "text": "没想到，我编写的这本册子还真帮不少人防了骗，连总务司的人都说我这个册子很有用。"
                },
                {
                    "id": "710350409",
                    "speaker": "王平安",
                    "text": "除了我自己写的那部分内容之外，他们还拜托我加入一些其他的防骗内容…"
                },
                {
                    "id": "710350410",
                    "speaker": "王平安",
                    "text": "为此，总务司还付了我不少钱呢。"
                },
                {
                    "id": "710350411",
                    "speaker": "王平安",
                    "text": "除了那本小册子之外，我还在编写另外一本有关「护法夜叉」的书。"
                },
                {
                    "id": "710350412",
                    "speaker": "王平安",
                    "text": "我想用这本书来向大家宣传一下「护法夜叉」的故事。"
                },
                {
                    "id": "710350413",
                    "speaker": "王平安",
                    "text": "这样做，我的那些民俗学知识也算是用在了正道上。"
                },
                {
                    "id": "710350414",
                    "speaker": "王平安",
                    "text": "这位「铜雀」的庙，我也是在编写有关「护法夜叉」的书的时候发现的。"
                },
                {
                    "id": "710350415",
                    "speaker": "王平安",
                    "text": "上面记载说，那座庙本来是先民们为了纪念夜叉「铜雀」所建。"
                },
                {
                    "id": "710350416",
                    "speaker": "王平安",
                    "text": "但我找到这座庙的时候，真没想到它居然如此破败…"
                },
                {
                    "id": "710350417",
                    "speaker": "王平安",
                    "text": "回去之后我左思右想，最后还是决定…自己出钱，把这座庙重修一遍。"
                },
                {
                    "id": "710350418",
                    "speaker": "王平安",
                    "text": "毕竟，我能重新走回正道，也是多亏了仙师教诲。"
                },
                {
                    "id": "710350419",
                    "speaker": "王平安",
                    "text": "重修这座庙，也算是为我之前做的那些错事赎一些罪了。"
                },
                {
                    "id": "710350420",
                    "speaker": "派蒙",
                    "text": "唔…听起来不像是假的…"
                },
                {
                    "id": "710350421",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你觉得呢？",
                    "choices": [
                        {
                            "id": "710350422",
                            "text": "感觉还挺真的。",
                            "response": [
                                {
                                    "id": "710350423",
                                    "speaker": "王平安",
                                    "text": "什么叫感觉挺真的，这就是真的，千真万确！"
                                },
                                {
                                    "id": "710350426",
                                    "speaker": "王平安",
                                    "text": "唉，算了，您爱怎么想就怎么想吧…"
                                },
                                {
                                    "id": "710350427",
                                    "speaker": "王平安",
                                    "text": "您要是真不信，就等正式开工之后自己过来看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "710350424",
                            "text": "你之前是骗子欸…",
                            "response": [
                                {
                                    "id": "710350425",
                                    "speaker": "王平安",
                                    "text": "我现在不是了啊！我现在可是个正经人，我不都在仙师面前立誓了吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103509",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710350901",
                    "speaker": "王平安",
                    "text": "唉，这庙真是够破的…柱子也坏了，梁也断了，还好这雕像没坏…"
                },
                {
                    "id": "710350902",
                    "speaker": "王平安",
                    "text": "真是的，怎么一直没人修呢…"
                }
            ]
        }
    ]
}