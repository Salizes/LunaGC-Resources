    "talks": [
        {
            "id": "7320608",
            "objective": "(test)73205与阿凡闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "732050501",
                    "speaker": "阿凡",
                    "text": "♪蔷薇啊蔷薇，实现我的愿望…"
                },
                {
                    "id": "732050502",
                    "speaker": "阿凡",
                    "text": "嗯？你们还在啊。",
                    "choices": [
                        {
                            "id": "732050503",
                            "text": "为什么住在这里？",
                            "response": [
                                {
                                    "id": "732050504",
                                    "speaker": "阿凡",
                                    "text": "呵呵，反正我是个怪老头，「怪老头做事哪有为什么」，很少有人像你这样问我。"
                                },
                                {
                                    "id": "732050505",
                                    "speaker": "阿凡",
                                    "text": "我啊，这一辈子总想出去闯荡，想抓住机会做点什么。"
                                },
                                {
                                    "id": "732050506",
                                    "speaker": "阿凡",
                                    "text": "刚结婚不久的时候差点儿跟着镀金旅团离开，但想想总觉得不能抛下老婆出去漂泊。"
                                },
                                {
                                    "id": "732050507",
                                    "speaker": "阿凡",
                                    "text": "后来遇到行脚商，我又想跟着出去跑生意，最终因为本钱不够没走成。"
                                },
                                {
                                    "id": "732050508",
                                    "speaker": "阿凡",
                                    "text": "再后来老太婆不在了，我没牵挂了，可是年纪已经太老，没法离开了。"
                                },
                                {
                                    "id": "732050509",
                                    "speaker": "阿凡",
                                    "text": "拖拖拉拉混到今天，我错过的事情太多。"
                                },
                                {
                                    "id": "732050510",
                                    "speaker": "阿凡",
                                    "text": "回过头发现自己不属于这个村子，也不属于其他任何地方。"
                                },
                                {
                                    "id": "732050511",
                                    "speaker": "阿凡",
                                    "text": "最后结果么，就是我一个人搬到村子边上生活才舒服。"
                                },
                                {
                                    "id": "732050512",
                                    "speaker": "阿凡",
                                    "text": "几十年也就这么回事，算了。"
                                },
                                {
                                    "id": "732050525",
                                    "speaker": "阿凡",
                                    "text": "这些花开了我就叫你们来看，明天或者后天，它们说不定就开了，你有空来看吧？"
                                },
                                {
                                    "id": "732050526",
                                    "speaker": "Player",
                                    "text": "没问题。"
                                },
                                {
                                    "id": "732050527",
                                    "speaker": "阿凡",
                                    "text": "好好好，我知道了…"
                                },
                                {
                                    "id": "732050528",
                                    "speaker": "阿凡",
                                    "text": "♪蔷薇啊蔷薇，实现我的愿望…"
                                }
                            ]
                        },
                        {
                            "id": "732050513",
                            "text": "关于鬼老头…",
                            "response": [
                                {
                                    "id": "732050514",
                                    "speaker": "阿凡",
                                    "text": "也就只有外来的人会打听鬼老头的事了，我们村里的小孩可都知道这个名字。"
                                },
                                {
                                    "id": "732050515",
                                    "speaker": "阿凡",
                                    "text": "哪家孩子不听话，孩子的父母就吓唬他：马上鬼老头要来把你抓走了。"
                                },
                                {
                                    "id": "732050516",
                                    "speaker": "阿凡",
                                    "text": "这些年轻人啊，一个都不认识鬼老头，倒挺会把他的名头搬出来吓人。"
                                },
                                {
                                    "id": "732050517",
                                    "speaker": "阿凡",
                                    "text": "我小的时候可是见过鬼老头本人的，他是讨厌小孩子没错，但长得也不恐怖。"
                                },
                                {
                                    "id": "732050518",
                                    "speaker": "阿凡",
                                    "text": "不知道怎么就被传成了鬼老头，我看都是一帮闲人在背后胡说八道。"
                                },
                                {
                                    "id": "732050519",
                                    "speaker": "Player",
                                    "text": "你们不是朋友吗？"
                                },
                                {
                                    "id": "732050520",
                                    "speaker": "阿凡",
                                    "text": "我还小的时候，经常溜到他的小花园附近玩，他一发现，就会挥着锄头把我赶走。"
                                },
                                {
                                    "id": "732050521",
                                    "speaker": "阿凡",
                                    "text": "他八成只把我当成去捣乱的调皮小子，哪里会记得我哟。"
                                },
                                {
                                    "id": "732050522",
                                    "speaker": "阿凡",
                                    "text": "虽然他不一定认识我，但我还是一直记得他和他的小花园。"
                                },
                                {
                                    "id": "732050523",
                                    "speaker": "阿凡",
                                    "text": "我说他是我的朋友，也不算错，不是吗？"
                                },
                                {
                                    "id": "732050524",
                                    "speaker": "阿凡",
                                    "text": "就当是为了还原我记忆里的小花园，我也会把这些花种出来的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320609",
            "objective": "(test)计时$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320611",
            "objective": "（test）回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7320601",
            "objective": "(test)第三次拜访阿凡$HIDDEN",
            "dialogues": [
                {
                    "id": "732060101",
                    "speaker": "阿凡",
                    "text": "你们来了啊。"
                },
                {
                    "id": "732060102",
                    "speaker": "Player",
                    "text": "种子怎么样了？"
                },
                {
                    "id": "732060103",
                    "speaker": "阿凡",
                    "text": "所有的种子都还没有抽芽…"
                },
                {
                    "id": "732060104",
                    "speaker": "阿凡",
                    "text": "我检查过种子表面了，连一点点发芽的迹象都没有。"
                },
                {
                    "id": "732060105",
                    "speaker": "阿凡",
                    "text": "这到底是为什么呢？"
                },
                {
                    "id": "732060106",
                    "speaker": "阿凡",
                    "text": "种子我肯定没认错，它们都是我照着鬼老头的手记从储藏室里翻出来的。"
                },
                {
                    "id": "732060107",
                    "speaker": "阿凡",
                    "text": "按照他的记录，种子的保存时间很长，只要保证干燥，它们就不会坏。"
                },
                {
                    "id": "732060108",
                    "speaker": "阿凡",
                    "text": "栽培方式也不该有问题，该浇的水和该施的肥料我都没有落下，到底为什么呢？"
                },
                {
                    "id": "732060109",
                    "speaker": "派蒙",
                    "text": "别着急呀，阿凡爷爷，再等等看呢？"
                },
                {
                    "id": "732060110",
                    "speaker": "派蒙",
                    "text": "#每次我和{NICKNAME}去野外摘果子摘花，摘完之后也要等好几天它们才能重新长出来。",
                    "choices": [
                        {
                            "id": "732060111",
                            "text": "耐心点。",
                            "response": [
                                {
                                    "id": "732060113",
                                    "speaker": "阿凡",
                                    "text": "唉，也只能等等看了，你们今天有空吗？能不能再帮我给它们浇点水？"
                                },
                                {
                                    "id": "732060114",
                                    "speaker": "阿凡",
                                    "text": "我刚给苗圃松土，忙活了好半天，实在没力气跑回去打水了。"
                                },
                                {
                                    "id": "732060115",
                                    "speaker": "Player",
                                    "text": "我明白了。"
                                },
                                {
                                    "id": "732060116",
                                    "speaker": "阿凡",
                                    "text": "谢谢你们了。"
                                }
                            ]
                        },
                        {
                            "id": "732060112",
                            "text": "继续浇水试试。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320602",
            "objective": "给花种浇水",
            "dialogues": []
        },
        {
            "id": "7320603",
            "objective": "和阿凡聊聊",
            "dialogues": [
                {
                    "id": "732060301",
                    "speaker": "阿凡",
                    "text": "水还是要浇，肥还是要施，有没有用…"
                },
                {
                    "id": "732060302",
                    "speaker": "阿凡",
                    "text": "我也不知道了，唉。"
                },
                {
                    "id": "732060303",
                    "speaker": "阿凡",
                    "text": "我糊里糊涂活到今天，终于下定决心要做一件事，结果还是做不成。"
                },
                {
                    "id": "732060304",
                    "speaker": "阿凡",
                    "text": "鬼老头，辜负了你的嘱托，对不起。"
                },
                {
                    "id": "732060305",
                    "speaker": "派蒙",
                    "text": "阿凡爷爷…"
                },
                {
                    "id": "732060306",
                    "speaker": "阿凡",
                    "text": "两个小娃娃，你们去忙吧。"
                }
            ]
        },
        {
            "id": "7320607",
            "objective": "(test)73206与阿凡闲聊$HIDDEN",
            "dialogues": [
                {
                    "id": "732060601",
                    "speaker": "阿凡",
                    "text": "沙法卡特叔叔，你最后的一点心愿我没法替你完成了…",
                    "choices": [
                        {
                            "id": "732060602",
                            "text": "沙法卡特是谁？",
                            "response": [
                                {
                                    "id": "732060603",
                                    "speaker": "阿凡",
                                    "text": "你们之前不是还缠着我问鬼老头的事吗，其实鬼老头原来也不叫鬼老头，毕竟哪有人真名就叫这个的。"
                                },
                                {
                                    "id": "732060604",
                                    "speaker": "阿凡",
                                    "text": "听我的长辈说，他原来叫沙法卡特，年轻的时候就从须弥城离开，到了我们村。"
                                },
                                {
                                    "id": "732060605",
                                    "speaker": "阿凡",
                                    "text": "他来之后盖了这间小屋一个人住，后来几十年里几乎都没离开。"
                                },
                                {
                                    "id": "732060606",
                                    "speaker": "阿凡",
                                    "text": "我是没见过他年轻时候的样子，不过据说他那会儿还不怎么讨厌小孩。"
                                },
                                {
                                    "id": "732060607",
                                    "speaker": "阿凡",
                                    "text": "他家的屋前屋后又种了很多花和树，很多孩子都喜欢往他那里跑，跟他要枣椰吃，听他说话。"
                                },
                                {
                                    "id": "732060608",
                                    "speaker": "阿凡",
                                    "text": "但我见到他的时候，他已经老了，被人叫作鬼老头，变得讨厌小孩子。"
                                },
                                {
                                    "id": "732060621",
                                    "speaker": "Player",
                                    "text": "一定还有办法。"
                                },
                                {
                                    "id": "732060622",
                                    "speaker": "阿凡",
                                    "text": "还能有什么办法呢？"
                                },
                                {
                                    "id": "732060623",
                                    "speaker": "阿凡",
                                    "text": "沙法卡特叔叔…也就是鬼老头，早就安安静静地离开了，要不是这样，我还能去问一问这蔷薇有什么栽种的特殊方法。"
                                },
                                {
                                    "id": "732060624",
                                    "speaker": "阿凡",
                                    "text": "现在我还能去问谁呢。"
                                },
                                {
                                    "id": "732060625",
                                    "speaker": "Player",
                                    "text": "我认识一位生论派的学者赛芭。"
                                },
                                {
                                    "id": "732060626",
                                    "speaker": "阿凡",
                                    "text": "哦，你是说那个外来的姑娘啊。她能帮上忙吗？"
                                },
                                {
                                    "id": "732060627",
                                    "speaker": "阿凡",
                                    "text": "再说，她之前路过我这里，被我说了几句给呛跑了。她还会愿意帮忙吗？"
                                },
                                {
                                    "id": "732060628",
                                    "speaker": "Player",
                                    "text": "我会试试。"
                                },
                                {
                                    "id": "732060629",
                                    "speaker": "阿凡",
                                    "text": "你是个很好的孩子，如果找不到能帮忙的人也没关系，有你这些心意就够了。"
                                }
                            ]
                        },
                        {
                            "id": "732060609",
                            "text": "为什么执着于种花呢？",
                            "response": [
                                {
                                    "id": "732060610",
                                    "speaker": "阿凡",
                                    "text": "我们村里，时不时就会有些外来的人迫不得己，在这里定居。"
                                },
                                {
                                    "id": "732060611",
                                    "speaker": "阿凡",
                                    "text": "有的人哪怕一直勉强自己，都始终不能习惯这里的生活，最后孤独一辈子。"
                                },
                                {
                                    "id": "732060612",
                                    "speaker": "阿凡",
                                    "text": "可能鬼老头…也就是沙法卡特叔叔，算其中之一吧，长期以来，大家都习惯这种事了。"
                                },
                                {
                                    "id": "732060613",
                                    "speaker": "阿凡",
                                    "text": "但不管多少年，我还是不愿意习惯这种事。他实在是太可惜了…"
                                },
                                {
                                    "id": "732060614",
                                    "speaker": "阿凡",
                                    "text": "他那座小花园你要是看到也会喜欢的，各种颜色的花，还有高高低低的树…"
                                },
                                {
                                    "id": "732060615",
                                    "speaker": "阿凡",
                                    "text": "打理出这么一座小花园的人就那么无声无息的不在了，关于他，大家只记得鬼老头会抓走调皮的小孩。"
                                },
                                {
                                    "id": "732060616",
                                    "speaker": "阿凡",
                                    "text": "我就是不乐意接受这种事，他留下的手记里写了他想让这些蔷薇到处长，我就是想实现他的心愿。"
                                },
                                {
                                    "id": "732060617",
                                    "speaker": "阿凡",
                                    "text": "反正我这一把年纪，别人怎么看我都无所谓，能做好这件事我就算没有白活。"
                                },
                                {
                                    "id": "732060618",
                                    "speaker": "阿凡",
                                    "text": "屋子我给他收拾好了，他留下来的一大堆小册子我也分类整理好了。"
                                },
                                {
                                    "id": "732060619",
                                    "speaker": "阿凡",
                                    "text": "你感兴趣的话，我可以拿一册出来给你瞧瞧。"
                                },
                                {
                                    "id": "732060620",
                                    "speaker": "阿凡",
                                    "text": "我就放在<color=#00E1FFFF>屋前</color>吧，让这手记里的他也见见太阳。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7320604",
            "objective": "(test)向赛芭寻求帮助$HIDDEN",
            "dialogues": [
                {
                    "id": "732060401",
                    "speaker": "赛芭",
                    "text": "来找我聊天了吗？我可攒了一肚子的话。"
                },
                {
                    "id": "732060402",
                    "speaker": "Player",
                    "text": "关于阿凡…"
                },
                {
                    "id": "732060403",
                    "speaker": "赛芭",
                    "text": "嗯？什么样的问题呢？"
                },
                {
                    "id": "732060404",
                    "speaker": "Black Screen",
                    "text": "把阿凡遇到的困难告诉了赛芭。"
                },
                {
                    "id": "732060405",
                    "speaker": "赛芭",
                    "text": "原来如此，所以你来向我求援了啊。"
                },
                {
                    "id": "732060406",
                    "speaker": "赛芭",
                    "text": "虽然在这种时候你能想起我，对我来说是很荣幸的事。"
                },
                {
                    "id": "732060407",
                    "speaker": "赛芭",
                    "text": "不过我毕竟不是专攻物种培育的学者，我的经验也很有限，不能保证一定帮上忙。"
                },
                {
                    "id": "732060408",
                    "speaker": "赛芭",
                    "text": "但我会努力试试的，更何况你说的那位培育出新品种蔷薇的先生也让人很感兴趣。"
                },
                {
                    "id": "732060409",
                    "speaker": "赛芭",
                    "text": "等我有空的时候就会去阿凡老先生的苗圃，之后去那里找我吧。"
                }
            ]
        },
        {
            "id": "7320605",
            "objective": "（test）给花种浇水",
            "dialogues": [
                {
                    "id": "732060501",
                    "speaker": "阿凡",
                    "text": "难道我真的是在种石头吗？"
                }
            ]
        },
        {
