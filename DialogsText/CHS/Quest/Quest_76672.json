    "talks": [
        {
            "id": "7667201",
            "objective": "与叶洛亚对话",
            "dialogues": [
                {
                    "id": "766720101",
                    "speaker": "派蒙",
                    "text": "这样就算是完成了吧，整个营地都焕然一新了呢。"
                },
                {
                    "id": "766720102",
                    "speaker": "叶洛亚",
                    "text": "嗯，营地周围工事的整修也已经完成，不管是魔物还是不怀好意的敌人，想要进攻这里都得费一番工夫了。"
                },
                {
                    "id": "766720103",
                    "speaker": "叶洛亚",
                    "text": "灯塔那边储备了足够供应半个月的燃料，这样就算是狂猎大军来了，也一定能支撑到援军到来了。"
                },
                {
                    "id": "766720104",
                    "speaker": "Player",
                    "text": "已经在考虑这种事了吗？"
                },
                {
                    "id": "766720105",
                    "speaker": "叶洛亚",
                    "text": "哈哈，不知不觉就…总要考虑到最坏的情况嘛。"
                },
                {
                    "id": "766720106",
                    "speaker": "派蒙",
                    "text": "不过总算建好了营垒，至少可以先休息一下吧。"
                },
                {
                    "id": "766720107",
                    "speaker": "叶洛亚",
                    "text": "嗯，所以我想先回家一趟，也有一段时间没见过老爹了。"
                },
                {
                    "id": "766720108",
                    "speaker": "派蒙",
                    "text": "回家？对哦，在这边待得太久，我都快忘了你的家是在皮拉米达了。"
                },
                {
                    "id": "766720109",
                    "speaker": "叶洛亚",
                    "text": "你们也跟我一起回去吧，为表感谢，我想好好招待你们一次。"
                },
                {
                    "id": "766720110",
                    "speaker": "叶洛亚",
                    "text": "虽然这边也按派蒙说的配置了餐车，不过做饭的话还是家里比较方便。"
                },
                {
                    "id": "766720111",
                    "speaker": "派蒙",
                    "text": "要做好吃的吗？嘿嘿，那我就不客气啦！"
                }
            ]
        },
        {
            "id": "7667202",
            "objective": "前往叶洛亚在皮拉米达城的家",
            "dialogues": [
                {
                    "id": "766720202",
                    "speaker": "派蒙",
                    "text": "白灵蛋卷、烟熏鱼排、浆果煎肉还有夜守暖汤…这么多菜，我都要吃不完啦。"
                },
                {
                    "id": "766720203",
                    "speaker": "叶洛亚",
                    "text": "嗯…我是按照给执灯士们准备晚餐的份量做的，对三个人来说可能确实有点多了。"
                },
                {
                    "id": "766720204",
                    "speaker": "叶洛亚",
                    "text": "不过没关系，你们慢慢吃。我一会还要去见老爹一趟，你们待到晚上都可以。",
                    "choices": [
                        {
                            "id": "766720205",
                            "text": "没想到你厨艺这么好。",
                            "response": [
                                {
                                    "id": "766720208",
                                    "speaker": "叶洛亚",
                                    "text": "其实在当队长以前，我可是经常给大家做饭的，只是最近都没有这样的空闲了。"
                                },
                                {
                                    "id": "766720209",
                                    "speaker": "叶洛亚",
                                    "text": "皮拉米达里的人来自天南海北，口味也各有不同。所以各种风味的料理都得掌握一点，才能让每一个人都尽兴。"
                                },
                                {
                                    "id": "766720210",
                                    "speaker": "叶洛亚",
                                    "text": "不过我不太知道你们的喜好，所以这次各种风格的都做了一点。有什么合你们口味的吗？请一定要告诉我。",
                                    "choices": [
                                        {
                                            "id": "766720211",
                                            "text": "派蒙爱吃的我也爱吃。",
                                            "response": [
                                                {
                                                    "id": "766720212",
                                                    "speaker": "派蒙",
                                                    "text": "什么意思啦！我先说，那盘浆果煎肉已经被我看中了，你可不要跟我抢呀。"
                                                },
                                                {
                                                    "id": "766720213",
                                                    "speaker": "叶洛亚",
                                                    "text": "哈哈，你们不用抢，我再多做点就好啦。怎么能让我的队员饿肚子呢！"
                                                },
                                                {
                                                    "id": "766720216",
                                                    "speaker": "叶洛亚",
                                                    "text": "不管大家嘴上怎么说，吃到爱吃的东西的时候，脸上幸福的表情可是不会骗人的。"
                                                },
                                                {
                                                    "id": "766720217",
                                                    "speaker": "叶洛亚",
                                                    "text": "对我来说，没有比看到大家幸福的笑容更开心的事了。"
                                                },
                                                {
                                                    "id": "766720218",
                                                    "speaker": "叶洛亚",
                                                    "text": "只要能让大家露出笑容，无论是履行执灯人的职责还是端上美味的料理，我都愿意去做。"
                                                },
                                                {
                                                    "id": "766720219",
                                                    "speaker": "叶洛亚",
                                                    "text": "在你们看来这些可能都是微不足道的小事吧，但这的确就是我最真实的愿望了…",
                                                    "choices": [
                                                        {
                                                            "id": "766720220",
                                                            "text": "不要妄自菲薄。",
                                                            "response": [
                                                                {
                                                                    "id": "766720222",
                                                                    "speaker": "派蒙",
                                                                    "text": "对呀！你为大家做了这么多，大家一定都很感谢你的。要是看你老是说自己不好，他们说不定还会生气呢！"
                                                                },
                                                                {
                                                                    "id": "766720223",
                                                                    "speaker": "派蒙",
                                                                    "text": "#至少在他们之前，我跟{NICKNAME}就会生气！"
                                                                },
                                                                {
                                                                    "id": "766720224",
                                                                    "speaker": "叶洛亚",
                                                                    "text": "嘿嘿，谢谢你们。好了，与饭桌无关的话题就不说啦，请好好享用料理吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766720221",
                                                            "text": "你能做到这些已经很厉害了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766720214",
                                            "text": "是你做的我都爱吃。",
                                            "response": [
                                                {
                                                    "id": "766720215",
                                                    "speaker": "叶洛亚",
                                                    "text": "恭维的话就不必啦。你这样说，我就更想要做出能最合你心意的料理了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766720206",
                            "text": "派蒙肯定能吃完。",
                            "response": [
                                {
                                    "id": "766720207",
                                    "speaker": "派蒙",
                                    "text": "那是当然啦，别人的心意就是要好好吃完才对吧！不过没想到叶洛亚你的厨艺这么好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7667299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "766729901",
                    "speaker": "Black Screen",
                    "text": "你们乘上月厢车，不多时就抵达了皮拉米达城…"
                }
            ]
        }
    ]
}