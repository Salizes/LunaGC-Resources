    "talks": [
        {
            "id": "2303701",
            "objective": "与马鲁夫对话",
            "dialogues": [
                {
                    "id": "230370101",
                    "speaker": "马鲁夫",
                    "text": "唉，这种病可不好治啊，看来还是得请扎卡里亚医生帮帮忙…"
                },
                {
                    "id": "230370102",
                    "speaker": "Player",
                    "text": "遇到什么重病患者了吗？"
                },
                {
                    "id": "230370103",
                    "speaker": "马鲁夫",
                    "text": "欸？是旅行者啊…倒也不是什么重病患者，就是有个病人头疼的有些厉害。"
                },
                {
                    "id": "230370104",
                    "speaker": "马鲁夫",
                    "text": "虽然我也给他开过药了，但药效却不怎么明显。"
                },
                {
                    "id": "230370105",
                    "speaker": "Player",
                    "text": "不能开其他的药吗？"
                },
                {
                    "id": "230370106",
                    "speaker": "马鲁夫",
                    "text": "咳…我哪会啊。现在我手头的药方，基本上都是我自己摸索出来的…"
                },
                {
                    "id": "230370107",
                    "speaker": "马鲁夫",
                    "text": "这些药方治疗一些小病小痛还可以，一遇见症状稍微重点的病症就很难起效了。"
                },
                {
                    "id": "230370108",
                    "speaker": "马鲁夫",
                    "text": "还好城里「健康之家」的扎卡里亚医生答应过我，可以帮我置办药方和药物…"
                },
                {
                    "id": "230370109",
                    "speaker": "马鲁夫",
                    "text": "旅行者，你能帮我个忙吗？"
                },
                {
                    "id": "230370110",
                    "speaker": "马鲁夫",
                    "text": "我现在还有一些患者要治疗，实在是走不开，你能帮我去城里找一下扎卡里亚医生，请他帮我开一个药方吗？",
                    "choices": [
                        {
                            "id": "230370111",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "230370112",
                                    "speaker": "马鲁夫",
                                    "text": "那就拜托你了，旅行者。"
                                }
                            ]
                        },
                        {
                            "id": "230370113",
                            "text": "扎卡里亚会来村里吗？",
                            "response": [
                                {
                                    "id": "230370114",
                                    "speaker": "马鲁夫",
                                    "text": "扎卡里亚医生偶尔会托人送点药过来，但他太忙了，实在是没什么空来村里。"
                                },
                                {
                                    "id": "230370115",
                                    "speaker": "马鲁夫",
                                    "text": "总之药方的事就拜托你了，旅行者。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303702",
            "objective": "与扎卡里亚对话",
            "dialogues": [
                {
                    "id": "230370501",
                    "speaker": "扎卡里亚",
                    "text": "最近的病人怎么越来越多了…"
                },
                {
                    "id": "230370502",
                    "speaker": "Player",
                    "text": "关于马鲁夫的事…"
                },
                {
                    "id": "230370503",
                    "speaker": "扎卡里亚",
                    "text": "马鲁夫？他又遇见什么疑难杂症了吗？"
                },
                {
                    "id": "230370504",
                    "speaker": "Black Screen",
                    "text": "叙述了马鲁夫所面对的病症…"
                },
                {
                    "id": "230370505",
                    "speaker": "扎卡里亚",
                    "text": "唉，我说了多少次了，这种小病以他的水平完全可以独立治疗，没必要来找我啊。"
                },
                {
                    "id": "230370506",
                    "speaker": "扎卡里亚",
                    "text": "估计又是那些病患觉得自己的病很重，不相信他这位「赤脚医生」…"
                },
                {
                    "id": "230370507",
                    "speaker": "扎卡里亚",
                    "text": "为了让病患安心，才来请我给他开个药方吧。"
                },
                {
                    "id": "230370508",
                    "speaker": "扎卡里亚",
                    "text": "这么多年一直待在那里治病，也是辛苦他了…我这就给他写个药方，请你记录一下吧，旅行者。"
                },
                {
                    "id": "230370509",
                    "speaker": "扎卡里亚",
                    "text": "唔，我记得马鲁夫这次要治的病是…"
                },
                {
                    "id": "230370510",
                    "speaker": "Player",
                    "text": "是个头疼的病患。"
                },
                {
                    "id": "230370511",
                    "speaker": "扎卡里亚",
                    "text": "嗯，治疗头疼…就用我之前给他开的那种方子就好。"
                },
                {
                    "id": "230370512",
                    "speaker": "扎卡里亚",
                    "text": "把那个方子里的药物煮成药汤，然后再加入三株<color=#00E1FFFF>薄荷</color>。"
                },
                {
                    "id": "230370513",
                    "speaker": "扎卡里亚",
                    "text": "最后把加入了薄荷的药汤用<color=#00E1FFFF>大火</color>继续煮，煮大概…算了…<color=#00E1FFFF>煮到药材都浮起来</color>就好了。"
                },
                {
                    "id": "230370514",
                    "speaker": "扎卡里亚",
                    "text": "唔…我还是写下来给你吧，免得你忘了…"
                },
                {
                    "id": "230370520",
                    "speaker": "Black Screen",
                    "text": "扎卡里亚将方子写在了纸上…"
                },
                {
                    "id": "230370515",
                    "speaker": "扎卡里亚",
                    "text": "那就麻烦你把这方子给马鲁夫送回去了。"
                },
                {
                    "id": "230370516",
                    "speaker": "扎卡里亚",
                    "text": "说实话，这药方名义上说是「药」，其实更接近一种…呃，怎么形容呢…"
                },
                {
                    "id": "230370517",
                    "speaker": "扎卡里亚",
                    "text": "一种…药效不怎么猛烈，以补充营养为主的补充剂吧。"
                },
                {
                    "id": "230370518",
                    "speaker": "扎卡里亚",
                    "text": "就算制作时没完全按照药方上来，也不会有什么严重后果，顶多就是喝下去没效果罢了。"
                },
                {
                    "id": "230370519",
                    "speaker": "扎卡里亚",
                    "text": "唉，所以说，马鲁夫自己调整一下药方就行了，他就不能自信点吗…"
                }
            ]
        },
