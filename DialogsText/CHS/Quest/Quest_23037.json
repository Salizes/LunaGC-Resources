        {
            "id": "2303706",
            "objective": "与马鲁夫对话",
            "dialogues": [
                {
                    "id": "230370801",
                    "speaker": "马鲁夫",
                    "text": "旅行者！你回来了，扎卡里亚医生怎么说？"
                },
                {
                    "id": "230370802",
                    "speaker": "Player",
                    "text": "关于扎卡里亚的药方…"
                },
                {
                    "id": "230370803",
                    "speaker": "马鲁夫",
                    "text": "就用他原来给我开的那种药汤做基底？这样啊…我再仔细看看药方。"
                },
                {
                    "id": "230370804",
                    "speaker": "马鲁夫",
                    "text": "咦？这药方…扎卡里亚医生开药方时的笔迹还是这么难读啊。"
                },
                {
                    "id": "230370805",
                    "speaker": "马鲁夫",
                    "text": "旅行者，扎卡里亚医生和你说过这种药方的制作方式和所需的药材吧？"
                },
                {
                    "id": "230370806",
                    "speaker": "马鲁夫",
                    "text": "你也帮我回忆一下吧，要是我制作的时候出错了，你可要提醒我啊。"
                },
                {
                    "id": "230370807",
                    "speaker": "马鲁夫",
                    "text": "这里写的药材是…呃…真是难读…",
                    "choices": [
                        {
                            "id": "230370808",
                            "text": "星蕈。",
                            "response": [
                                {
                                    "id": "230370811",
                                    "speaker": "马鲁夫",
                                    "text": "要用什么方式煮药汤来着？",
                                    "choices": [
                                        {
                                            "id": "230370812",
                                            "text": "全程大火。",
                                            "response": [
                                                {
                                                    "id": "230370815",
                                                    "speaker": "马鲁夫",
                                                    "text": "药汤要煮大概多长时间？",
                                                    "choices": [
                                                        {
                                                            "id": "230370816",
                                                            "text": "煮到药材浮起来。",
                                                            "response": [
                                                                {
                                                                    "id": "230370819",
                                                                    "speaker": "马鲁夫",
                                                                    "text": "嗯，我知道了。保险起见，我再看看药方…"
                                                                },
                                                                {
                                                                    "id": "230370820",
                                                                    "speaker": "Black Screen",
                                                                    "text": "马鲁夫开始煮起了药物…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230370817",
                                                            "text": "煮到药材软烂。"
                                                        },
                                                        {
                                                            "id": "230370818",
                                                            "text": "煮到药汤颜色变深。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230370813",
                                            "text": "全程小火。"
                                        },
                                        {
                                            "id": "230370814",
                                            "text": "先用大火，再用小火。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230370809",
                            "text": "赤念果。"
                        },
                        {
                            "id": "230370810",
                            "text": "薄荷。"
                        }
                    ]
                }
            ]
        },
