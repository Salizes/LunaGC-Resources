                            "text": "星蕈。",
                            "response": [
                                {
                                    "id": "230370911",
                                    "speaker": "马鲁夫",
                                    "text": "要用什么方式煮药汤来着？",
                                    "choices": [
                                        {
                                            "id": "230370912",
                                            "text": "全程大火。",
                                            "response": [
                                                {
                                                    "id": "230370915",
                                                    "speaker": "马鲁夫",
                                                    "text": "药汤要煮大概多长时间？",
                                                    "choices": [
                                                        {
                                                            "id": "230370916",
                                                            "text": "煮到药材浮起来。",
                                                            "response": [
                                                                {
                                                                    "id": "230370919",
                                                                    "speaker": "马鲁夫",
                                                                    "text": "嗯，我知道了。保险起见，我再看看药方…"
                                                                },
                                                                {
                                                                    "id": "230370920",
                                                                    "speaker": "Black Screen",
                                                                    "text": "马鲁夫开始煮起了药物…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230370917",
                                                            "text": "煮到药材软烂。"
                                                        },
                                                        {
                                                            "id": "230370918",
                                                            "text": "煮到药汤颜色变深。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230370913",
                                            "text": "全程小火。"
                                        },
                                        {
                                            "id": "230370914",
                                            "text": "先用大火，再用小火。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230370909",
                            "text": "赤念果。"
                        },
                        {
                            "id": "230370910",
                            "text": "薄荷。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303708",
            "objective": "与马鲁夫对话",
            "dialogues": [
                {
                    "id": "230371001",
                    "speaker": "马鲁夫",
                    "text": "旅行者！你回来了，扎卡里亚医生怎么说？"
                },
                {
                    "id": "230371002",
                    "speaker": "Player",
                    "text": "关于扎卡里亚的药方…"
                },
                {
                    "id": "230371003",
                    "speaker": "马鲁夫",
                    "text": "就用他原来给我开的那种药汤做基底？这样啊…我再仔细看看药方。"
                },
                {
                    "id": "230371004",
                    "speaker": "马鲁夫",
                    "text": "咦？这药方…扎卡里亚医生开药方时的笔迹还是这么难读啊。"
                },
                {
                    "id": "230371005",
                    "speaker": "马鲁夫",
                    "text": "旅行者，扎卡里亚医生和你说过这种药方的制作方式和所需的药材吧？"
                },
                {
                    "id": "230371006",
                    "speaker": "马鲁夫",
                    "text": "你也帮我回忆一下吧，要是我制作的时候出错了，你可要提醒我啊。"
                },
                {
                    "id": "230371007",
                    "speaker": "马鲁夫",
                    "text": "这里写的药材是…呃…真是难读…",
                    "choices": [
                        {
                            "id": "230371008",
                            "text": "星蕈。",
                            "response": [
                                {
                                    "id": "230371011",
                                    "speaker": "马鲁夫",
                                    "text": "要用什么方式煮药汤来着？",
                                    "choices": [
                                        {
