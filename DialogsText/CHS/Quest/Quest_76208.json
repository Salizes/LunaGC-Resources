    "talks": [
        {
            "id": "7620801",
            "objective": "与派蒙交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "762080101",
                    "speaker": "派蒙",
                    "text": "咦？周围好像有一道透明的幕升起来了…是那棵树干的吗？"
                },
                {
                    "id": "762080102",
                    "speaker": "派蒙",
                    "text": "感觉它像是在吐树脂呢，把这里变成了一块琥珀！"
                },
                {
                    "id": "762080103",
                    "speaker": "Player",
                    "text": "那我们就成了琥珀里的小虫。"
                },
                {
                    "id": "762080104",
                    "speaker": "派蒙",
                    "text": "装了你和我的琥珀，应该会在拍卖会上成为压轴的宝贝吧。"
                },
                {
                    "id": "762080105",
                    "speaker": "Player",
                    "text": "那最后压台的宝贝呢？"
                },
                {
                    "id": "762080106",
                    "speaker": "派蒙",
                    "text": "当然是这棵树啦，毕竟是它做的琥珀嘛，可惜看样子没法把它带走…"
                },
                {
                    "id": "762080107",
                    "speaker": "派蒙",
                    "text": "不知道附近有没有留下关于它的线索。"
                }
            ]
        }
    ]
