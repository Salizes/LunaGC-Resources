            "dialogues": [
                {
                    "id": "732500201",
                    "speaker": "Player",
                    "text": "好啊，我们玩什么？"
                },
                {
                    "id": "732500202",
                    "speaker": "兰陀尼什",
                    "text": "那菈朋友很懂兰那罗的想法，一定也懂兰陀尼什的想法，能在很多东西里找到兰陀尼什想要的那一个。"
                },
                {
                    "id": "732500203",
                    "speaker": "兰陀尼什",
                    "text": "这次，兰陀尼什想要的东西…是<color=#00E1FFFF>小只的木箱</color>！那菈朋友肯定能找到吧。"
                }
            ]
        },
        {
            "id": "7325005",
            "objective": "",
            "dialogues": [
                {
                    "id": "732500501",
                    "speaker": "兰陀尼什",
                    "text": "哈哈，不对不对，兰陀尼什不想要这个。那菈要再想想。"
                },
                {
                    "id": "732500502",
                    "speaker": "兰陀尼什",
                    "text": "兰陀尼什一直在，那菈还想玩游戏的话，随时都可以哦。"
                }
            ]
        },
        {
            "id": "7325003",
            "objective": "",
            "dialogues": [
                {
                    "id": "732500401",
                    "speaker": "兰陀尼什",
                    "text": "金色的那菈，果然像传闻里提到的那样「眼疾手快」！"
                },
                {
                    "id": "732500402",
                    "speaker": "兰陀尼什",
                    "text": "陪兰陀尼什玩游戏，是好那菈，这个送给那菈朋友！"
                }
            ]
        },
        {
            "id": "7325001",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732500101",
                    "speaker": "兰陀尼什",
                    "text": "那菈朋友来了！和兰陀尼什玩游戏吗？"
                }
            ]
        },
        {
            "id": "7325003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732500301",
                    "speaker": "Player",
                    "text": "现在没空。"
                },
                {
                    "id": "732500302",
                    "speaker": "兰陀尼什",
                    "text": "那兰陀尼什等，等到那菈「有空」。"
                }
            ]
        }
    ]
