    "talks": [
        {
            "id": "7182415",
            "objective": "(test)隐藏任务UI界面领取用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7182401",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "718240101",
                    "speaker": "言笑",
                    "text": "得再加紧点了…"
                },
                {
                    "id": "718240102",
                    "speaker": "Player",
                    "text": "生意这么好吗？"
                },
                {
                    "id": "718240103",
                    "speaker": "言笑",
                    "text": "没有。这不是正过节吗？客栈里一堆人回去过节了，干活的人少了一堆，活差不多都得我自己来做。"
                },
                {
                    "id": "718240104",
                    "speaker": "言笑",
                    "text": "还好，客人不算太多，我一个人还顶得住。"
                },
                {
                    "id": "718240105",
                    "speaker": "言笑",
                    "text": "咳，我还得谢谢你，上次帮我那个忙，要不是你，我现在估计都没法正常开工…",
                    "choices": [
                        {
                            "id": "718240106",
                            "text": "你最近还…",
                            "response": [
                                {
                                    "id": "718240108",
                                    "speaker": "言笑",
                                    "text": "没有！绝对没有，相信我，绝对没有！要再来一次，我绝对受不了了…"
                                },
                                {
                                    "id": "718240109",
                                    "speaker": "言笑",
                                    "text": "你要是真想打听那件事…她的话，就去问问老板吧，我是真…真不知道…"
                                }
                            ]
                        },
                        {
                            "id": "718240107",
                            "text": "那她最近…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182402",
            "objective": "与菲尔戈黛特对话",
            "dialogues": [
                {
                    "id": "718240201",
                    "speaker": "菲尔戈黛特",
                    "text": "旅行者，有什么事吗？"
                },
                {
                    "id": "718240202",
                    "speaker": "Player",
                    "text": "关于小冥…"
                },
                {
                    "id": "718240203",
                    "speaker": "菲尔戈黛特",
                    "text": "你说她啊，自从上次那件事之后，她就安稳很多了。"
                },
                {
                    "id": "718240204",
                    "speaker": "菲尔戈黛特",
                    "text": "不过，那孩子倒也可怜，之前逢年过节，客栈越是热闹，她就越落寞，所以才经常捣乱，吓坏了客人。"
                },
                {
                    "id": "718240205",
                    "speaker": "菲尔戈黛特",
                    "text": "但她应该也只是想有人陪着她玩吧，毕竟，她也只是个孩子而已…",
                    "choices": [
                        {
                            "id": "718240206",
                            "text": "能送盏霄灯给她吗？",
                            "response": [
                                {
                                    "id": "718240208",
                                    "speaker": "菲尔戈黛特",
                                    "text": "给她送霄灯？嗯…这个主意倒还不错，不过那孩子很难找…"
                                },
                                {
                                    "id": "718240209",
                                    "speaker": "菲尔戈黛特",
                                    "text": "如果想找她的话，你就在晚上去旁边的树林里，把霄灯挂在树梢上吧。"
                                },
                                {
                                    "id": "718240210",
                                    "speaker": "菲尔戈黛特",
                                    "text": "这样的话，她应该就能看到了。"
                                }
                            ]
                        },
                        {
                            "id": "718240207",
                            "text": "不知道她喜不喜欢霄灯…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7182403",
            "objective": "制作霄灯",
            "dialogues": [
                {
                    "id": "718240301",
                    "speaker": "菲尔戈黛特",
                    "text": "怎么样，你们把霄灯送过去了吗？"
                },
                {
                    "id": "718240302",
                    "speaker": "Player",
                    "text": "应该…算是送过去了。"
                },
                {
                    "id": "718240303",
                    "speaker": "菲尔戈黛特",
                    "text": "嗯，这样就最好了，这样那孩子应该也会高兴一些吧。"
                },
                {
                    "id": "718240304",
                    "speaker": "菲尔戈黛特",
                    "text": "不知道…那孩子会许什么愿望…"
                }
            ]
        },
        {
