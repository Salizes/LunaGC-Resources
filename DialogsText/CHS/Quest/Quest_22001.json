        }
    },
    "talks": [
        {
            "id": "2200101",
            "objective": "与璐璐、阿飞、小蒙对话",
            "dialogues": [
                {
                    "id": "220010101",
                    "speaker": "阿飞",
                    "text": "小蒙，今天总轮到我做船长了吧？"
                },
                {
                    "id": "220010102",
                    "speaker": "小蒙",
                    "text": "璐璐，我已经连着好几天做船长了，也该阿飞扮了…"
                },
                {
                    "id": "220010103",
                    "speaker": "璐璐",
                    "text": "可我觉得小蒙的船长扮得很好呀，我想你接着做船长。"
                },
                {
                    "id": "220010104",
                    "speaker": "Player",
                    "text": "你们在做什么？"
                },
                {
                    "id": "220010105",
                    "speaker": "阿飞",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们在玩游戏。本来说好了这次轮到我做船长…"
                },
                {
                    "id": "220010106",
                    "speaker": "阿飞",
                    "text": "可璐璐总是说，小蒙扮船长的时候更好玩。"
                },
                {
                    "id": "220010107",
                    "speaker": "阿飞",
                    "text": "唉，璐璐总是这样…不过，她觉得这样好的话，那就这样吧。"
                },
                {
                    "id": "220010108",
                    "speaker": "阿飞",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你有空再扮一次海盗吗？",
                    "choices": [
                        {
                            "id": "220010109",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "220010110",
                                    "speaker": "阿飞",
                                    "text": "结果，我这次还是个服务生。"
                                },
                                {
                                    "id": "220010113",
                                    "speaker": "阿飞",
                                    "text": "#就和上次一样，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了之后，就过来吧。"
                                }
                            ]
                        },
                        {
                            "id": "220010111",
                            "text": "我想做个好人。",
                            "response": [
                                {
                                    "id": "220010112",
                                    "speaker": "阿飞",
                                    "text": "哎呀，我还想做船长呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200102",
            "objective": "与「服务生」阿飞对话",
            "dialogues": [
                {
                    "id": "220010601",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "220010602",
                    "speaker": "阿飞",
                    "text": "行吧，那就开始。"
                },
                {
                    "id": "220010603",
                    "speaker": "阿飞",
                    "text": "真是的，当服务生有什么好玩的。"
                },
                {
                    "id": "220010604",
                    "speaker": "阿飞",
                    "text": "璐璐和小蒙就知道自己玩开心…"
                },
                {
                    "id": "220010605",
                    "speaker": "Player",
                    "text": "那个，抢劫…"
                },
                {
                    "id": "220010606",
                    "speaker": "阿飞",
                    "text": "海盗吗？对不起，我这个穷服务生没有什么东西给你抢。"
                },
                {
                    "id": "220010607",
                    "speaker": "阿飞",
                    "text": "哼，如果想抢的话，去找个更有钱的人…等等。"
                },
                {
                    "id": "220010608",
                    "speaker": "阿飞",
                    "text": "喂！你们是来抢劫的吧，船长很有钱，你们可以去抢他！"
                },
                {
                    "id": "220010609",
                    "speaker": "派蒙",
                    "text": "咦，咦？！你不是这艘船上的服务生吗？"
                },
                {
                    "id": "220010610",
                    "speaker": "阿飞",
                    "text": "是啊，所以我知道船长在哪。"
                },
                {
                    "id": "220010611",
                    "speaker": "阿飞",
                    "text": "哼，不就是个船长吗？有什么了不起的…"
                },
                {
                    "id": "220010612",
                    "speaker": "阿飞",
                    "text": "走，我带你们去找船长！"
                }
            ]
        },
        {
            "id": "2200103",
            "objective": "跟随阿飞找到船长",
            "dialogues": [
                {
                    "id": "220010301",
                    "speaker": "阿飞",
                    "text": "#就是这！船长在这了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
                },
                {
                    "id": "220010302",
                    "speaker": "小蒙",
                    "text": "你怎么把海盗带过来了啊！你不是应该带着海盗到处绕圈，然后我带着璐璐跑掉吗？"
                },
                {
                    "id": "220010303",
                    "speaker": "阿飞",
                    "text": "凭什么你陪着璐璐跑，我就要在这拖住海盗？"
                },
                {
                    "id": "220010304",
                    "speaker": "阿飞",
                    "text": "那我直接把你交给海盗，我不是一样可以带着璐璐跑吗？"
                },
                {
                    "id": "220010305",
                    "speaker": "小蒙",
                    "text": "你…北斗姐姐说了，不可以随便出卖朋友！"
                },
                {
                    "id": "220010306",
                    "speaker": "阿飞",
                    "text": "那北斗姐姐说船长就应该带着人跑吗？！"
                },
                {
                    "id": "220010307",
                    "speaker": "小蒙",
                    "text": "你…我再也不把莲蓬分给你吃了！"
                },
                {
                    "id": "220010308",
                    "speaker": "阿飞",
                    "text": "不吃就不吃！谁稀罕似的！"
                },
                {
                    "id": "220010309",
                    "speaker": "派蒙",
                    "text": "他们怎么就吵起来了…"
                },
                {
                    "id": "220010310",
                    "speaker": "璐璐",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，不用担心，我有办法。"
                },
                {
                    "id": "220010311",
                    "speaker": "璐璐",
                    "text": "他们最喜欢吃莲蓬了，有好吃的东西，他们绝对会安静下来的。"
                },
                {
                    "id": "220010312",
                    "speaker": "璐璐",
                    "text": "你能帮我去找点莲蓬回来吗？",
                    "choices": [
                        {
                            "id": "220010313",
                            "text": "好的。",
                            "response": [
                                {
                                    "id": "220010314",
                                    "speaker": "璐璐",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，请快去快回呀。"
                                }
                            ]
                        },
                        {
                            "id": "220010315",
                            "text": "他们最喜欢的应该不是莲蓬…",
                            "response": [
                                {
                                    "id": "220010316",
                                    "speaker": "璐璐",
                                    "text": "#唔…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}在说什么呢？那他们最喜欢什么呢？"
                                },
                                {
                                    "id": "220010317",
                                    "speaker": "璐璐",
                                    "text": "总之，请先找点莲蓬来吧，总不能让他们总是这么吵呀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200106",
            "objective": "与「船长」小蒙对话",
            "dialogues": []
        },
        {
            "id": "2200104",
            "objective": "找到莲蓬",
            "dialogues": [
                {
                    "id": "220010401",
                    "speaker": "璐璐",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到莲蓬了吗？"
                },
                {
                    "id": "220010402",
                    "speaker": "<UNKNOWN>",
                    "text": "找到了。"
                },
                {
                    "id": "220010403",
                    "speaker": "阿飞",
                    "text": "你…！"
                },
                {
                    "id": "220010404",
                    "speaker": "小蒙",
                    "text": "你…！"
                },
                {
                    "id": "220010405",
                    "speaker": "璐璐",
                    "text": "你们别吵了，吵了这么久不累吗？"
                },
                {
                    "id": "220010406",
                    "speaker": "璐璐",
                    "text": "只是玩个游戏，别这么生气，大家都是朋友呀。"
                },
                {
                    "id": "220010407",
                    "speaker": "璐璐",
                    "text": "喏，新摘的莲蓬，快点吃吧。"
                },
                {
                    "id": "220010408",
                    "speaker": "璐璐",
                    "text": "吃完了之后，我们再好好商量一下。"
                },
                {
                    "id": "220010409",
                    "speaker": "璐璐",
                    "text": "排好谁做船长，谁做服务员的顺序，不就好了吗？"
                },
                {
                    "id": "220010410",
                    "speaker": "小蒙",
                    "text": "好吧…"
                },
                {
                    "id": "220010411",
                    "speaker": "阿飞",
                    "text": "嗯…"
                },
                {
                    "id": "220010412",
                    "speaker": "派蒙",
                    "text": "真的安静下来了…"
                },
                {
                    "id": "220010413",
                    "speaker": "璐璐",
                    "text": "怎么样，我就说吧。",
                    "choices": [
                        {
                            "id": "220010414",
                            "text": "你怎么知道要这么做？",
                            "response": [
                                {
                                    "id": "220010415",
                                    "speaker": "璐璐",
                                    "text": "我们一起玩了很久，我当然知道啦。"
                                }
                            ]
                        },
                        {
                            "id": "220010416",
                            "text": "璐璐真厉害…",
                            "response": [
                                {
                                    "id": "220010417",
                                    "speaker": "璐璐",
                                    "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，北斗姐姐才厉害呢。"
                                },
                                {
                                    "id": "220010418",
                                    "speaker": "璐璐",
                                    "text": "我长大之后，也能成为她那样的人吗…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2200105",
            "objective": "安抚小蒙和阿飞",
            "dialogues": []
        },
        {
            "id": "2200102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220010201",
                    "speaker": "阿飞",
                    "text": "你准备好了吗？"
                }
            ]
        },
        {
            "id": "2200107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220010701",
                    "speaker": "小蒙",
                    "text": "真讨厌！叛徒！"
                },
                {
                    "id": "220010702",
                    "speaker": "阿飞",
                    "text": "哼，就只准你玩的开心吗？"
                },
                {
                    "id": "220010703",
                    "speaker": "小蒙",
                    "text": "我再也不分你莲蓬吃了！"
                },
                {
                    "id": "220010704",
                    "speaker": "阿飞",
                    "text": "不吃就不吃，谁稀罕似的！"
                },
                {
                    "id": "220010705",
                    "speaker": "派蒙",
                    "text": "哈哈…看来一时半会是停不下来了呢…"
                }
            ]
        },
        {
            "id": "2200108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220010801",
                    "speaker": "璐璐",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到莲蓬了吗？"
                },
                {
                    "id": "220010802",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "220010803",
                    "speaker": "璐璐",
                    "text": "请尽量快些吧，他们还在吵个不停呢。"
                }
            ]
        },
        {
            "id": "2200109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "220010901",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "220010902",
                    "speaker": "阿飞",
                    "text": "没关系，慢慢准备吧，反正我也没什么兴趣…"
                }
            ]
        }
    ]
}