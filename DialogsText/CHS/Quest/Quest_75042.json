    "talks": [
        {
            "id": "7504201",
            "objective": "(test)初见完成后，大木在前哨站闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "750420101",
                    "speaker": "曼科",
                    "text": "哦，您好，最近如何？"
                },
                {
                    "id": "750420102",
                    "speaker": "曼科",
                    "text": "或者，你来找我，是有什么想要确认的？",
                    "choices": [
                        {
                            "id": "750420103",
                            "text": "关于「焰主之祝」…",
                            "response": [
                                {
                                    "id": "750420104",
                                    "speaker": "曼科",
                                    "text": "「焰主之祝」…有人认为这是一种返祖的现象，因为大家一致认为这种力量拥有一种血脉上的更深邃的源头。"
                                },
                                {
                                    "id": "750420105",
                                    "speaker": "曼科",
                                    "text": "只是…据龙遗物研究协会的记载来看，这些身上有「焰主之祝」印记的幼龙大多数在成长过程中，受体内不可控的力量摆布…"
                                },
                                {
                                    "id": "750420106",
                                    "speaker": "曼科",
                                    "text": "那份力量会撕扯他们的身躯，让它们变成有别于正常龙众的东西…变得狂暴，失去理智。"
                                },
                                {
                                    "id": "750420107",
                                    "speaker": "曼科",
                                    "text": "名为「霍拉瓦伽」的绒翼龙暴君就是最好的例子…据说它从前就是一只被赐予「焰主之祝」的绒翼龙。"
                                }
                            ]
                        },
                        {
                            "id": "750420108",
                            "text": "关于部族的「处置」…",
                            "response": [
                                {
                                    "id": "750420109",
                                    "speaker": "曼科",
                                    "text": "就是让它回归夜神的国度，在它生时，或许无法被龙众或夜神之国接纳。"
                                },
                                {
                                    "id": "750420110",
                                    "speaker": "曼科",
                                    "text": "但在它离开此世之后，必然还是会回归夜晚的怀抱，这对于它来说，虽然冰冷，但是在那里它将与众生的灵魂汇合…"
                                },
                                {
                                    "id": "750420111",
                                    "speaker": "曼科",
                                    "text": "恕我冒昧，那或许也是一种温柔。"
                                },
                                {
                                    "id": "750420112",
                                    "speaker": "Player",
                                    "text": "有信物的线索了吗？"
                                },
                                {
                                    "id": "750420113",
                                    "speaker": "曼科",
                                    "text": "有一些，但是…我得找人确认，也许之后你能在帕加尔那里找到我，他是回声之子的领袖。"
                                },
                                {
                                    "id": "750420114",
                                    "speaker": "曼科",
                                    "text": "虽然他看上去有点…浮夸，但是恕我直言，他比最坚固的晶石还要可靠。"
                                }
                            ]
                        },
                        {
                            "id": "750420115",
                            "text": "没什么想问的，再见！",
                            "response": [
                                {
                                    "id": "750420116",
                                    "speaker": "曼科",
                                    "text": "随时欢迎您，朋友。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}