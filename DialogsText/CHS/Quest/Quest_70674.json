    "talks": [
        {
            "id": "7067401",
            "objective": "与宏朗对话",
            "dialogues": [
                {
                    "id": "706740101",
                    "speaker": "宏朗",
                    "text": "怎么这次跑到蒙德来了…",
                    "choices": [
                        {
                            "id": "706740102",
                            "text": "宏朗？",
                            "response": [
                                {
                                    "id": "706740104",
                                    "speaker": "宏朗",
                                    "text": "旅行者！真是太巧了，没想到会在这里遇见你。"
                                },
                                {
                                    "id": "706740105",
                                    "speaker": "宏朗",
                                    "text": "至于现在的情况…看看旁边这道门，你应该差不多明白了吧。",
                                    "choices": [
                                        {
                                            "id": "706740106",
                                            "text": "上次的那种秘境又出现了？",
                                            "response": [
                                                {
                                                    "id": "706740108",
                                                    "speaker": "宏朗",
                                                    "text": "没错。多亏了你上次帮忙探索了那处秘境，我们得到了很多宝贵的资料。"
                                                },
                                                {
                                                    "id": "706740109",
                                                    "speaker": "宏朗",
                                                    "text": "不过…虽然协会也已经帮忙四处调查，但几乎没有从外界找到更多有价值的信息。"
                                                },
                                                {
                                                    "id": "706740110",
                                                    "speaker": "宏朗",
                                                    "text": "我们正准备派出更多人手探索，甚至联系了其他协会的人来帮忙，这个秘境却突然消失了…"
                                                },
                                                {
                                                    "id": "706740111",
                                                    "speaker": "宏朗",
                                                    "text": "直到今天，它才突然出现在了蒙德…多亏了蒙德冒险家协会的兄弟传来了消息，我才能第一时间赶来。"
                                                },
                                                {
                                                    "id": "706740112",
                                                    "speaker": "Player",
                                                    "text": "你们开始探索了吗？"
                                                },
                                                {
                                                    "id": "706740113",
                                                    "speaker": "宏朗",
                                                    "text": "那是当然，秘境就摆在面前，我们可没有退缩的道理。"
                                                },
                                                {
                                                    "id": "706740114",
                                                    "speaker": "宏朗",
                                                    "text": "这个秘境的「规则」似乎没有变太多，依然是根据进入者的念头而拟想出某种物品。"
                                                },
                                                {
                                                    "id": "706740115",
                                                    "speaker": "宏朗",
                                                    "text": "但在探索过程中，我们发现…这处秘境居然可以变化出一些「敌人」了。"
                                                },
                                                {
                                                    "id": "706740116",
                                                    "speaker": "宏朗",
                                                    "text": "这些「敌人」会对我们发动攻击，被攻击到后，我们也会感受到真实的痛感。"
                                                },
                                                {
                                                    "id": "706740117",
                                                    "speaker": "宏朗",
                                                    "text": "怎么说呢…简直和真实的「战斗」没什么两样了，冒险家们对这件事也十分感兴趣。"
                                                },
                                                {
                                                    "id": "706740118",
                                                    "speaker": "宏朗",
                                                    "text": "但是，有些冒险家连自己拟想出的「敌人」都打不过，还要别人帮他搞定，真是…"
                                                },
                                                {
                                                    "id": "706740119",
                                                    "speaker": "宏朗",
                                                    "text": "咳！不说这些了，旅行者，如果你愿意的话，就再和我们一起探索这处秘境吧。",
                                                    "choices": [
                                                        {
                                                            "id": "706740120",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "706740121",
                                                                    "speaker": "宏朗",
                                                                    "text": "哈哈哈，那太好了！有你帮忙，我们的工作一定能事半功倍。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706740122",
                                                            "text": "我不会遇见啥危险吧…",
                                                            "response": [
                                                                {
                                                                    "id": "706740123",
                                                                    "speaker": "宏朗",
                                                                    "text": "呃…以你的身手，只要提高警惕，应该不会有问题的。"
                                                                },
                                                                {
                                                                    "id": "706740124",
                                                                    "speaker": "宏朗",
                                                                    "text": "总之，如果你愿意的话，就帮我们探索一下这处秘境吧，有你帮忙，我们的工作一定能事半功倍。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706740107",
                                            "text": "是你一直在研究的那种秘境？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706740103",
                            "text": "这是…"
                        }
                    ]
                }
            ]
        }
    ]
}